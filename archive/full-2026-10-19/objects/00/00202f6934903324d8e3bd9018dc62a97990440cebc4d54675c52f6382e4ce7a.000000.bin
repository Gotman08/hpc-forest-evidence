{
  "solution.cpp": "#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007; //since the answer may grow a lot, we use the modulus\n\n\nint main() {\n\tint n,m;\n\tcin >> n >> m;\n\tvector<vector<bool> >  blockedCells(n, vector<bool>(n,false));\n\tfor(int c =0;c<m;c++) {\n\t\tint i,j;\n\t\tcin >> i >> j;\n\t\tblockedCells[i][j] = true;\t\t\n\t}\n\n\tvector<vector<int> > dp(2,vector<int>(n,0));\n\n\tif(!blockedCells[0][0])\n\t\tdp[0][0] = 1;\n\n\tfor(int j=1;j<n;j++) if(!blockedCells[0][j]) dp[0][j] = dp[0][j-1];\n\tdp[1][n-1] = dp[0][n-1];\n\n\tfor(int i=1;i<n;i++) {\n\t\tfor(int j=0;j<n;j++) {\n\t\t\tint ans = 0;\n\t\t\tif(!blockedCells[i][j]) {\t\t\t\t\n\t\t\t\tans = dp[0][j];\n\t\t\t\tif(j!=0) ans += dp[1][j-1];\n\t\t\t}\n\n\t\t\tdp[1][j] = ans% MOD;\n\t\t}\n\t\tfor(int j=0;j<n;j++) dp[0][j] = dp[1][j];\n\t}\n\n\t\n\tcout << dp[1][n-1] << endl;\n}"
}
{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <omp.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Convert from AoS (array of Body structs) to SoA (separate arrays)\n * for better SIMD vectorization.\n */\ntypedef struct {\n    float *x, *y, *z;\n    float *vx, *vy, *vz;\n} BodiesSoA;\n\n/*\n * Compute the gravitational impact among all pairs of bodies in \n * the system.  Uses SoA layout for contiguous memory access.\n */\nvoid body_force(float *restrict x,\n                float *restrict y,\n                float *restrict z,\n                float *restrict vx,\n                float *restrict vy,\n                float *restrict vz,\n                float dt, int n) {\n#pragma omp parallel for schedule(static)\n    for (int i = 0; i < n; ++i) {\n        float fx = 0.0f;\n        float fy = 0.0f;\n        float fz = 0.0f;\n\n        const float xi = x[i];\n        const float yi = y[i];\n        const float zi = z[i];\n\n#pragma omp simd reduction(+:fx,fy,fz)\n        for (int j = 0; j < n; ++j) {\n            float dx = x[j] - xi;\n            float dy = y[j] - yi;\n            float dz = z[j] - zi;\n            float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n            float inv_dist = 1.0f / sqrt(sqrd_dist);\n            float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n            fx += dx * inv_dist3;\n            fy += dy * inv_dist3;\n            fz += dz * inv_dist3;\n        }\n\n        vx[i] += dt*fx;\n        vy[i] += dt*fy;\n        vz[i] += dt*fz;\n    }\n}\n\n/*\n * Read a binary dataset with initialized bodies.\n * Returns SoA arrays allocated on 32-byte boundaries.\n */\nBodiesSoA read_dataset(int *nbodies) {\n    int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n    if (b != 1) {\n        fprintf(stderr,\"\\nError reading nbodie value\\n\");\n        exit(EXIT_FAILURE);\n    }\n\n    // Temporary AoS buffer for input compatibility\n    typedef struct { float x,y,z,vx,vy,vz; } Body;\n    size_t n = *nbodies;\n    Body *temp = (Body *)malloc(n * sizeof(Body));\n    if (!temp) {\n        fprintf(stderr,\"\\nMemory allocation error\\n\");\n        exit(EXIT_FAILURE);\n    }\n\n    b = fread(temp, n * sizeof(Body), 1, stdin);\n    if (b != 1) {\n        fprintf(stderr,\"\\nError reading input values\\n\");\n        free(temp);\n        exit(EXIT_FAILURE);\n    }\n\n    // Allocate SoA arrays with 32-byte alignment for NEON\n    BodiesSoA bodies;\n    size_t align = 32;\n    if (posix_memalign((void**)&bodies.x, align, n * sizeof(float)) ||\n        posix_memalign((void**)&bodies.y, align, n * sizeof(float)) ||\n        posix_memalign((void**)&bodies.z, align, n * sizeof(float)) ||\n        posix_memalign((void**)&bodies.vx, align, n * sizeof(float)) ||\n        posix_memalign((void**)&bodies.vy, align, n * sizeof(float)) ||\n        posix_memalign((void**)&bodies.vz, align, n * sizeof(float))) {\n        fprintf(stderr,\"\\nAligned allocation failed\\n\");\n        free(temp);\n        exit(EXIT_FAILURE);\n    }\n\n    // Scatter from AoS to SoA\n    for (size_t i = 0; i < n; ++i) {\n        bodies.x[i] = temp[i].x;\n        bodies.y[i] = temp[i].y;\n        bodies.z[i] = temp[i].z;\n        bodies.vx[i] = temp[i].vx;\n        bodies.vy[i] = temp[i].vy;\n        bodies.vz[i] = temp[i].vz;\n    }\n\n    free(temp);\n    return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset (AoS format).\n */\nvoid write_dataset(const int nbodies, BodiesSoA bodies) {\n    size_t n = nbodies;\n    typedef struct { float x,y,z,vx,vy,vz; } Body;\n\n    // Gather from SoA to AoS for output compatibility\n    Body *temp = (Body *)malloc(n * sizeof(Body));\n    if (!temp) {\n        fprintf(stderr,\"\\nMemory allocation error\\n\");\n        exit(EXIT_FAILURE);\n    }\n\n    for (size_t i = 0; i < n; ++i) {\n        temp[i].x = bodies.x[i];\n        temp[i].y = bodies.y[i];\n        temp[i].z = bodies.z[i];\n        temp[i].vx = bodies.vx[i];\n        temp[i].vy = bodies.vy[i];\n        temp[i].vz = bodies.vz[i];\n    }\n\n    int b = fwrite(temp, n * sizeof(Body), 1, stdout);\n    if (b != 1) {\n        fprintf(stderr,\"\\nError writing to output\\n\");\n        free(temp);\n        exit(EXIT_FAILURE);\n    }\n\n    free(temp);\n}\n\nint main(int argc,char **argv) {\n    int nbodies;\n\n    BodiesSoA bodies = read_dataset(&nbodies);\n\n    /*\n     * At each simulation iteration, interbody forces are computed,\n     * and bodies' positions are integrated.\n     */\n    for (int iter = 0; iter < N_ITER; ++iter) {\n        body_force(bodies.x, bodies.y, bodies.z,\n                   bodies.vx, bodies.vy, bodies.vz,\n                   DT, nbodies);\n\n#pragma omp parallel for schedule(static)\n        for (int i = 0; i < nbodies; ++i) {\n            bodies.x[i] += bodies.vx[i] * DT;\n            bodies.y[i] += bodies.vy[i] * DT;\n            bodies.z[i] += bodies.vz[i] * DT;\n        }\n    }\n\n    write_dataset(nbodies, bodies);\n\n    free(bodies.x);\n    free(bodies.y);\n    free(bodies.z);\n    free(bodies.vx);\n    free(bodies.vy);\n    free(bodies.vz);\n\n    exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Converting the data layout from array-of-structs (AoS) to struct-of-arrays (SoA) provides contiguous memory access for each coordinate component, enabling more efficient SIMD vectorization. Combined with aligned allocation (32-byte), restrict qualifiers, OpenMP parallelization of outer loops, and explicit simd reduction on the inner force loop, this should reduce execution time below previous AoS-based results by improving cache utilization and allowing the compiler to generate wider vector instructions.",
  "notes": "The input/output binary format is preserved: we read into a temporary AoS buffer then scatter to SoA arrays; before writing we gather back. Allocations use posix_memalign with 32-byte alignment for ARM NEON. The inner force loop uses #pragma omp simd reduction(+:fx,fy,fz) and the outer loops are parallelized with schedule(static). Restrict qualifiers on pointer parameters help aliasing analysis.",

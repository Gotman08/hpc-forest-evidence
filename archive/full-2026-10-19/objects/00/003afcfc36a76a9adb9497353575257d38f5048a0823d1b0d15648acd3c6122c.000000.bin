      "content": "#include <bits/stdc++.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\nint A[1000][1000];\nint ps[1010][1010];\n\ntypedef long long ll;\n\nstatic ll count_pairs(int m, int n, int k, ll first, ll last) {\n  if (first >= last)\n    return 0;\n\n  int j = 1;\n  ll offset = first;\n  while (offset >= n - j + 1) {\n    offset -= n - j + 1;\n    ++j;\n  }\n  int l = j + static_cast<int>(offset);\n\n  unordered_map<ll, ll> h;\n  h.reserve(m + 1);\n  ll ans = 0;\n  for (ll pair = first; pair < last; ++pair) {\n    h.clear();\n    h[0] = 1;\n    ll s = 0;\n    for (int i = 1; i <= m; i++) {\n      s += ps[i][l] - ps[i][j - 1];\n      ans += h.find(s - k) != h.end() ? h[s - k] : 0;\n      h[s]++;\n    }\n    if (l == n) {\n      ++j;\n      l = j;\n    } else {\n      ++l;\n    }\n  }\n  return ans;\n}\n\nll solve(int m, int n, int k) {\n  for (int i = 1; i <= m; i++) {\n    for (int j = 1; j <= n; j++) {\n      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\n    }\n  }\n\n  const ll pairs = static_cast<ll>(n) * (n + 1) / 2;\n#ifdef _OPENMP\n  if (pairs * m >= 65536LL) {\n    ll ans = 0;\n#pragma omp parallel reduction(+ : ans)\n    {\n      const int id = omp_get_thread_num();\n      const int workers = omp_get_num_threads();\n      const ll first = pairs * id / workers;\n      const ll last = pairs * (id + 1) / workers;\n      ans += count_pairs(m, n, k, first, last);\n    }\n    return ans;\n  }\n#endif\n  return count_pairs(m, n, k, 0, pairs);\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n  memset(ps, 0, sizeof ps);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n",
      "path": "src/main.cpp"
    }
  ],
  "hypothesis": "Equal-sized ranges of flattened column pairs should balance row-counting work across the supplied four OpenMP workers, reducing runtime without synchronization inside the counting loop.",

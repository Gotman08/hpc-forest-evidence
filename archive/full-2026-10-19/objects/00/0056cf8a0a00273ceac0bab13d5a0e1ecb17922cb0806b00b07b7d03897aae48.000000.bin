#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <algorithm>

int main() {
	int n, s;
	std::cin >> n >> s;
	assert(s > 0 && s < n && n < 8000);

	// Flatten matrix into a contiguous 1D array for spatial locality
	std::vector<int> mat(n * n);
	for (int i = 0; i < n; ++i)
		for (int j = 0; j < n; ++j)
			scanf("%d", &mat[i * n + j]);

	// Build integral image using two passes for sequential memory access.
	// Pass 1: horizontal prefix sums per row, stored in H (size n x (n+1))
	std::vector<long long> H(n * (n + 1), 0);
	for (int i = 0; i < n; ++i) {
		long long row_sum = 0;
		int base = i * (n + 1);
		H[base] = 0;
		for (int j = 0; j < n; ++j) {
			row_sum += mat[i * n + j];
			H[base + j + 1] = row_sum;
		}
	}

	// Pass 2: vertical accumulation into integral image II (size (n+1)x(n+1))
	std::vector<long long> II((n + 1) * (n + 1), 0);
	for (int i = 1; i <= n; ++i) {
		const long long* prev_row = &II[(i - 1) * (n + 1)];
		long long* curr_row = &II[i * (n + 1)];
		const long long* hrow = &H[(i - 1) * (n + 1)];
		curr_row[0] = 0;
		for (int j = 1; j <= n; ++j)
			curr_row[j] = prev_row[j] + hrow[j];
	}

	// Search for maximum SxS submatrix sum using integral image.
	// Apply blocking over rows to improve temporal reuse of II data.
	const int B = 64; // block size (tuneable, but kept moderate)
	int mxSum = -2147483648;
	for (int i0 = 0; i0 <= n - s; i0 += B) {
		int i_end = std::min(i0 + B, n - s + 1);
		for (int j = 0; j <= n - s; ++j) {
			// Precompute column-dependent terms for this block of rows
			long long term_j_s = II[(i_end > i0 ? i0 : 0) * (n + 1) + (j + s)];
			for (int i = i0; i < i_end; ++i) {
				// Submatrix sum from integral image: O(1)
				long long sub_sum = II[(i + s) * (n + 1) + (j + s)]
				                 - II[i * (n + 1) + (j + s)]
				                 - II[(i + s) * (n + 1) + j]
				                 + II[i * (n + 1) + j];
				if (sub_sum > mxSum)
					mxSum = static_cast<int>(sub_sum);
			}
		}
	}

	printf("%d\n", mxSum);
	return 0;
}

        "content": "#include <bits/stdc++.h>\n\nusing namespace std;\nusing ll = long long;\n\nll solve(int pair_dim, int scan_dim, int k, const vector<int>& matrix) {\n  vector<ll> sums(scan_dim, 0);\n  unordered_map<ll, ll> frequencies;\n  frequencies.reserve(scan_dim + 1);\n  ll answer = 0;\n\n  for (int top = 0; top < pair_dim; ++top) {\n    fill(sums.begin(), sums.end(), 0);\n    for (int bottom = top; bottom < pair_dim; ++bottom) {\n      const int* row = matrix.data() + static_cast<size_t>(bottom) * scan_dim;\n      for (int x = 0; x < scan_dim; ++x)\n        sums[x] += row[x];\n\n      frequencies.clear();\n      frequencies.emplace(0, 1);\n      ll prefix = 0;\n      for (int x = 0; x < scan_dim; ++x) {\n        prefix += sums[x];\n        auto it = frequencies.find(prefix - static_cast<ll>(k));\n        if (it != frequencies.end())\n          answer += it->second;\n        ++frequencies[prefix];\n      }\n    }\n  }\n  return answer;\n}\n\nint main() {\n  ios::sync_with_stdio(false);\n  cin.tie(nullptr);\n\n  int k, m, n;\n  if (!(cin >> k >> m >> n))\n    return 0;\n\n  const int pair_dim = min(m, n);\n  const int scan_dim = max(m, n);\n  vector<int> matrix(static_cast<size_t>(pair_dim) * scan_dim);\n\n  for (int i = 0; i < m; ++i) {\n    for (int j = 0; j < n; ++j) {\n      int value;\n      cin >> value;\n      if (m <= n)\n        matrix[static_cast<size_t>(i) * scan_dim + j] = value;\n      else\n        matrix[static_cast<size_t>(j) * scan_dim + i] = value;\n    }\n  }\n\n  cout << solve(pair_dim, scan_dim, k, matrix) << '\\n';\n  return 0;\n}\n",
        "path": "src/main.cpp"
      }
    ],
    "hypothesis": "Pairing boundaries along the shorter matrix dimension reduces work on rectangular inputs, while storing the matrix in pair-dimension-by-scan-dimension order makes each accumulation and prefix scan contiguous in memory.",

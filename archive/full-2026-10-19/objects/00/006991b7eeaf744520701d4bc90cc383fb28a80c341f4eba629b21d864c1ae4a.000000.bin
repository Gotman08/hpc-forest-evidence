      "content": "#include \"knn.h\"\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nenum {\n    KNN_BINS = 2048,\n    KNN_BIN_SHIFT = 20,\n    KNN_LABELS = 256\n};\n\ntypedef struct {\n    size_t order;\n    uint32_t key;\n    unsigned char label;\n} KNNNeighbor;\n\ntypedef struct {\n    size_t histogram[KNN_BINS];\n    size_t votes[KNN_LABELS];\n    size_t bucket_offset;\n    int saw_nan;\n    unsigned char padding[64];\n} KNNWorker;\n\nstatic char knn_winner(const size_t votes[KNN_LABELS]) {\n    size_t best_count = 0;\n    char best = (char)-1;\n\n    for (int value = CHAR_MIN; value <= CHAR_MAX; ++value) {\n        size_t count = votes[(unsigned char)(char)value];\n        if (count > best_count) {\n            best_count = count;\n            best = (char)value;\n        }\n    }\n    return best;\n}\n\n/* Preserve the original insertion semantics for unordered distances. */\nstatic char knn_serial_scan(int n_groups, Group *groups, int k,\n                            Point to_evaluate) {\n    char *labels = (char *)malloc((size_t)k * sizeof(*labels));\n    float *distances = (float *)malloc((size_t)k * sizeof(*distances));\n\n    if (labels == NULL || distances == NULL) {\n        free(labels);\n        free(distances);\n        on_error();\n        return (char)-1;\n    }\n\n    for (int i = 0; i < k; ++i) {\n        labels[i] = (char)-1;\n        distances[i] = -1;\n    }\n\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; ++j) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (int x = 0; x < k; ++x) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (int y = k - 1; y > x; --y) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    size_t votes[KNN_LABELS] = {0};\n    for (int i = 0; i < k; ++i) {\n        ++votes[(unsigned char)labels[i]];\n    }\n    free(labels);\n    free(distances);\n    return knn_winner(votes);\n}\n\nstatic int knn_before(const KNNNeighbor *a, const KNNNeighbor *b) {\n    if (a->key != b->key) {\n        return a->key < b->key;\n    }\n    return a->order < b->order;\n}\n\nstatic int knn_compare_neighbor(const void *a, const void *b) {\n    const KNNNeighbor *left = (const KNNNeighbor *)a;\n    const KNNNeighbor *right = (const KNNNeighbor *)b;\n    if (knn_before(left, right)) return -1;\n    if (knn_before(right, left)) return 1;\n    return 0;\n}\n\nstatic void knn_swap(KNNNeighbor *a, KNNNeighbor *b) {\n    KNNNeighbor temporary = *a;\n    *a = *b;\n    *b = temporary;\n}\n\n/* Partition an exact prefix; sorting is only a bounded fallback. */\nstatic void knn_select_prefix(KNNNeighbor *neighbors, size_t length,\n                              size_t count) {\n    if (count == 0 || count >= length) return;\n\n    unsigned budget = 0;\n    for (size_t remaining = length; remaining > 1; remaining >>= 1) {\n        budget += 2;\n    }\n\n    size_t begin = 0;\n    size_t end = length;\n    while (end - begin > 24) {\n        if (budget == 0) {\n            qsort(neighbors + begin, end - begin, sizeof(*neighbors),\n                  knn_compare_neighbor);\n            return;\n        }\n        --budget;\n\n        KNNNeighbor first = neighbors[begin];\n        KNNNeighbor middle = neighbors[begin + (end - begin) / 2];\n        KNNNeighbor last = neighbors[end - 1];\n        if (knn_before(&middle, &first)) knn_swap(&middle, &first);\n        if (knn_before(&last, &middle)) knn_swap(&last, &middle);\n        if (knn_before(&middle, &first)) knn_swap(&middle, &first);\n        KNNNeighbor pivot = middle;\n\n        size_t lower = begin;\n        size_t current = begin;\n        size_t upper = end;\n        while (current < upper) {\n            if (knn_before(&neighbors[current], &pivot)) {\n                knn_swap(&neighbors[lower], &neighbors[current]);\n                ++lower;\n                ++current;\n            } else if (knn_before(&pivot, &neighbors[current])) {\n                --upper;\n                knn_swap(&neighbors[current], &neighbors[upper]);\n            } else {\n                ++current;\n            }\n        }\n\n        if (count < lower) {\n            end = lower;\n        } else if (count > upper) {\n            begin = upper;\n        } else {\n            return;\n        }\n    }\n\n    qsort(neighbors + begin, end - begin, sizeof(*neighbors),\n          knn_compare_neighbor);\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) return (char)-1;\n\n    size_t total = 0;\n    for (int g = 0; g < n_groups; ++g) {\n        if (groups[g].length > 0) {\n            total += (size_t)groups[g].length;\n        }\n    }\n\n    if ((size_t)k >= total) {\n        size_t votes[KNN_LABELS] = {0};\n        for (int g = 0; g < n_groups; ++g) {\n            if (groups[g].length > 0) {\n                votes[(unsigned char)groups[g].label] +=\n                    (size_t)groups[g].length;\n            }\n        }\n        votes[(unsigned char)(char)-1] += (size_t)k - total;\n        return knn_winner(votes);\n    }\n\n    int workers = 1;\n#ifdef _OPENMP\n    workers = omp_get_max_threads();\n    if (workers < 1) workers = 1;\n    size_t useful_workers = total / 4096;\n    if (useful_workers == 0) useful_workers = 1;\n    if ((size_t)workers > useful_workers) workers = (int)useful_workers;\n#endif\n\n    if (total > SIZE_MAX / sizeof(uint32_t) ||\n        (size_t)n_groups > SIZE_MAX / sizeof(size_t) - 1 ||\n        (size_t)workers > SIZE_MAX / sizeof(KNNWorker)) {\n        return knn_serial_scan(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t *offsets = (size_t *)malloc(((size_t)n_groups + 1) *\n                                      sizeof(*offsets));\n    uint32_t *keys = (uint32_t *)malloc(total * sizeof(*keys));\n    KNNWorker *work = (KNNWorker *)calloc((size_t)workers, sizeof(*work));\n    if (offsets == NULL || keys == NULL || work == NULL) {\n        free(offsets);\n        free(keys);\n        free(work);\n        return knn_serial_scan(n_groups, groups, k, to_evaluate);\n    }\n\n    offsets[0] = 0;\n    for (int g = 0; g < n_groups; ++g) {\n        offsets[g + 1] = offsets[g];\n        if (groups[g].length > 0) {\n            offsets[g + 1] += (size_t)groups[g].length;\n        }\n    }\n\n    KNNNeighbor *candidates = NULL;\n    size_t candidate_count = 0;\n    size_t needed = 0;\n    unsigned cutoff_bucket = 0;\n    int partial_bucket = 0;\n    int fallback = 0;\n    char result = (char)-1;\n\n#ifdef _OPENMP\n#pragma omp parallel num_threads(workers) if(workers > 1)\n#endif\n    {\n        int tid = 0;\n        int team_size = 1;\n#ifdef _OPENMP\n        tid = omp_get_thread_num();\n        team_size = omp_get_num_threads();\n#endif\n        KNNWorker *local = &work[tid];\n        size_t quotient = total / (size_t)team_size;\n        size_t remainder = total % (size_t)team_size;\n        size_t extra_before = (size_t)tid < remainder ? (size_t)tid : remainder;\n        size_t begin = quotient * (size_t)tid + extra_before;\n        size_t end = begin + quotient + ((size_t)tid < remainder);\n\n        int low = 0;\n        int high = n_groups;\n        while (low < high) {\n            int middle = low + (high - low) / 2;\n            if (offsets[middle + 1] <= begin) {\n                low = middle + 1;\n            } else {\n                high = middle;\n            }\n        }\n        int first_group = low;\n\n        for (int g = first_group; g < n_groups && offsets[g] < end; ++g) {\n            size_t base = offsets[g];\n            size_t limit = offsets[g + 1] < end ? offsets[g + 1] : end;\n            size_t position = begin > base ? begin : base;\n            for (; position < limit; ++position) {\n                float d = euclidean_distance_no_sqrt(\n                    to_evaluate, groups[g].points[position - base]);\n                uint32_t bits;\n                memcpy(&bits, &d, sizeof(bits));\n                uint32_t key = bits & UINT32_C(0x7fffffff);\n                keys[position] = key;\n                ++local->histogram[key >> KNN_BIN_SHIFT];\n                if (key > UINT32_C(0x7f800000)) local->saw_nan = 1;\n            }\n        }\n\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n        {\n            for (int t = 0; t < team_size; ++t) {\n                if (work[t].saw_nan) fallback = 1;\n            }\n\n            if (!fallback) {\n                size_t rank = (size_t)k;\n                for (unsigned bin = 0; bin < KNN_BINS; ++bin) {\n                    size_t count = 0;\n                    for (int t = 0; t < team_size; ++t) {\n                        count += work[t].histogram[bin];\n                    }\n                    if (rank > count) {\n                        rank -= count;\n                    } else {\n                        cutoff_bucket = bin;\n                        needed = rank;\n                        candidate_count = count;\n                        break;\n                    }\n                }\n\n                partial_bucket = needed < candidate_count;\n                if (partial_bucket) {\n                    if (candidate_count > SIZE_MAX / sizeof(*candidates)) {\n                        fallback = 1;\n                    } else {\n                        candidates = (KNNNeighbor *)malloc(\n                            candidate_count * sizeof(*candidates));\n                        if (candidates == NULL) fallback = 1;\n                    }\n\n                    size_t next = 0;\n                    for (int t = 0; t < team_size; ++t) {\n                        work[t].bucket_offset = next;\n                        next += work[t].histogram[cutoff_bucket];\n                    }\n                }\n            }\n        }\n\n        if (!fallback) {\n            size_t output = local->bucket_offset;\n            for (int g = first_group; g < n_groups && offsets[g] < end; ++g) {\n                size_t base = offsets[g];\n                size_t limit = offsets[g + 1] < end ? offsets[g + 1] : end;\n                size_t position = begin > base ? begin : base;\n                unsigned char label = (unsigned char)groups[g].label;\n                for (; position < limit; ++position) {\n                    uint32_t key = keys[position];\n                    unsigned bin = key >> KNN_BIN_SHIFT;\n                    if (bin < cutoff_bucket ||\n                        (!partial_bucket && bin == cutoff_bucket)) {\n                        ++local->votes[label];\n                    } else if (partial_bucket && bin == cutoff_bucket) {\n                        candidates[output].order = position;\n                        candidates[output].key = key;\n                        candidates[output].label = label;\n                        ++output;\n                    }\n                }\n            }\n        }\n\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single nowait\n#endif\n        {\n            if (!fallback) {\n                size_t votes[KNN_LABELS] = {0};\n                for (int t = 0; t < team_size; ++t) {\n                    for (int label = 0; label < KNN_LABELS; ++label) {\n                        votes[label] += work[t].votes[label];\n                    }\n                }\n                if (partial_bucket) {\n                    knn_select_prefix(candidates, candidate_count, needed);\n                    for (size_t i = 0; i < needed; ++i) {\n                        ++votes[candidates[i].label];\n                    }\n                }\n                result = knn_winner(votes);\n            }\n        }\n    }\n\n    free(candidates);\n    free(work);\n    free(keys);\n    free(offsets);\n    if (fallback) {\n        return knn_serial_scan(n_groups, groups, k, to_evaluate);\n    }\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }

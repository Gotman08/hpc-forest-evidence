#include <algorithm>
#include <iostream>
#include <utility>
#include <vector>

using namespace std;

constexpr int MOD = 1000000007;

static long long modPow(long long base, long long exponent) {
    long long result = 1;
    while (exponent > 0) {
        if (exponent & 1LL) result = result * base % MOD;
        base = base * base % MOD;
        exponent >>= 1LL;
    }
    return result;
}

class Binomial {
public:
    explicit Binomial(int maxN) : fact(maxN + 1), invFact(maxN + 1) {
        fact[0] = 1;
        for (int i = 1; i <= maxN; ++i) {
            fact[i] = fact[i - 1] * i % MOD;
        }
        invFact[maxN] = modPow(fact[maxN], MOD - 2);
        for (int i = maxN; i > 0; --i) {
            invFact[i - 1] = invFact[i] * i % MOD;
        }
    }

    long long choose(int n, int k) const {
        if (k < 0 || k > n) return 0;
        return fact[n] * invFact[k] % MOD * invFact[n - k] % MOD;
    }

private:
    vector<long long> fact;
    vector<long long> invFact;
};

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) return 0;

    vector<pair<int, int>> blockedCells;
    blockedCells.reserve(static_cast<size_t>(m));
    for (int c = 0; c < m; ++c) {
        int row, column;
        cin >> row >> column;
        blockedCells.emplace_back(row + column, row);
    }
    sort(blockedCells.begin(), blockedCells.end());
    blockedCells.erase(unique(blockedCells.begin(), blockedCells.end()),
                       blockedCells.end());

    if (binary_search(blockedCells.begin(), blockedCells.end(), make_pair(0, 0)) ||
        binary_search(blockedCells.begin(), blockedCells.end(),
                      make_pair(2 * n - 2, n - 1))) {
        cout << 0 << '\n';
        return 0;
    }

    // Use obstacle-pair counting only when its work is conservatively bounded.
    const size_t obstacleCount = blockedCells.size();
    if (n >= 64 && obstacleCount <= static_cast<size_t>(n / 8) &&
        obstacleCount <= 2048) {
        Binomial binomial(2 * n - 2);
        vector<long long> firstHit(obstacleCount, 0);

        for (size_t i = 0; i < obstacleCount; ++i) {
            const int diagonal = blockedCells[i].first;
            const int row = blockedCells[i].second;
            const int column = diagonal - row;
            long long ways = binomial.choose(diagonal, row);

            for (size_t j = 0; j < i; ++j) {
                const int previousDiagonal = blockedCells[j].first;
                const int previousRow = blockedCells[j].second;
                const int previousColumn = previousDiagonal - previousRow;
                if (previousRow <= row && previousColumn <= column) {
                    const int deltaRow = row - previousRow;
                    const int deltaColumn = column - previousColumn;
                    const long long throughPrevious =
                        firstHit[j] * binomial.choose(deltaRow + deltaColumn,
                                                      deltaRow) % MOD;
                    ways -= throughPrevious;
                    if (ways < 0) ways += MOD;
                }
            }
            firstHit[i] = ways;
        }

        long long answer = binomial.choose(2 * n - 2, n - 1);
        for (size_t i = 0; i < obstacleCount; ++i) {
            const int row = blockedCells[i].second;
            const int column = blockedCells[i].first - row;
            const int remainingRows = n - 1 - row;
            const int remainingColumns = n - 1 - column;
            const long long throughObstacle =
                firstHit[i] * binomial.choose(remainingRows + remainingColumns,
                                              remainingRows) % MOD;
            answer -= throughObstacle;
            if (answer < 0) answer += MOD;
        }

        cout << answer << '\n';
        return 0;
    }

    vector<int> previous(n, 0);
    vector<int> current(n, 0);
    size_t blockedIndex = 0;

    previous[0] = 1;
    while (blockedIndex < blockedCells.size() &&
           blockedCells[blockedIndex].first == 0) {
        previous[0] = 0;
        ++blockedIndex;
    }

    for (int diagonal = 1; diagonal <= 2 * n - 2; ++diagonal) {
        const bool growing = diagonal < n;
        const int lowRow = growing ? 0 : diagonal - n + 1;
        const int length = growing ? diagonal + 1 : 2 * n - 1 - diagonal;

        const int* __restrict__ previousData = previous.data();
        int* __restrict__ currentData = current.data();

        if (growing) {
            const int last = length - 1;
            currentData[0] = previousData[0];
            currentData[last] = previousData[last - 1];

            #pragma GCC ivdep
            for (int i = 1; i < last; ++i) {
                int ways = previousData[i - 1] + previousData[i];
                if (ways >= MOD) ways -= MOD;
                currentData[i] = ways;
            }
        } else {
            #pragma GCC ivdep
            for (int i = 0; i < length; ++i) {
                int ways = previousData[i] + previousData[i + 1];
                if (ways >= MOD) ways -= MOD;
                currentData[i] = ways;
            }
        }

        while (blockedIndex < blockedCells.size() &&
               blockedCells[blockedIndex].first == diagonal) {
            const int index = blockedCells[blockedIndex].second - lowRow;
            currentData[index] = 0;
            ++blockedIndex;
        }

        previous.swap(current);
    }

    cout << previous[0] << '\n';
    return 0;
}
        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n#define PARALLEL_MIN_BODIES 128\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/* Compute one target in the original ascending source order. */\nstatic inline void body_force_one(Body *p, float dt, int n, int i) {\n  float fx = 0.0f;\n  float fy = 0.0f;\n  float fz = 0.0f;\n\n  for (int j = 0; j < n; j++) {\n    float dx = p[j].x - p[i].x;\n    float dy = p[j].y - p[i].y;\n    float dz = p[j].z - p[i].z;\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n    fx += dx * inv_dist3;\n    fy += dy * inv_dist3;\n    fz += dz * inv_dist3;\n  }\n\n  p[i].vx += dt*fx;\n  p[i].vy += dt*fy;\n  p[i].vz += dt*fz;\n}\n\n/* One block owns up to four targets; this helper creates no team. */\nstatic inline void body_force_block(Body *p, float dt, int n, int i) {\n#if defined(__aarch64__) && defined(__ARM_NEON)\n  if (n - i >= 4) {\n    const float32x4_t softening = vdupq_n_f32(SOFTENING);\n    const float64x2_t one = vdupq_n_f64(1.0);\n    const float32x4_t tx = {p[i].x, p[i + 1].x,\n                            p[i + 2].x, p[i + 3].x};\n    const float32x4_t ty = {p[i].y, p[i + 1].y,\n                            p[i + 2].y, p[i + 3].y};\n    const float32x4_t tz = {p[i].z, p[i + 1].z,\n                            p[i + 2].z, p[i + 3].z};\n    float32x4_t fx = vdupq_n_f32(0.0f);\n    float32x4_t fy = vdupq_n_f32(0.0f);\n    float32x4_t fz = vdupq_n_f32(0.0f);\n\n    /* Lanes represent independent targets, never a source reduction. */\n    for (int j = 0; j < n; j++) {\n      float32x4_t dx = vdupq_n_f32(p[j].x) - tx;\n      float32x4_t dy = vdupq_n_f32(p[j].y) - ty;\n      float32x4_t dz = vdupq_n_f32(p[j].z) - tz;\n      float32x4_t sqrd_dist = dx*dx + dy*dy + dz*dz + softening;\n\n      /* Preserve double-precision sqrt and division before float conversion. */\n      float64x2_t dist_lo = vcvt_f64_f32(vget_low_f32(sqrd_dist));\n      float64x2_t dist_hi = vcvt_f64_f32(vget_high_f32(sqrd_dist));\n      float64x2_t inv_lo = vdivq_f64(one, vsqrtq_f64(dist_lo));\n      float64x2_t inv_hi = vdivq_f64(one, vsqrtq_f64(dist_hi));\n      float32x4_t inv_dist = vcombine_f32(vcvt_f32_f64(inv_lo),\n                                         vcvt_f32_f64(inv_hi));\n      float32x4_t inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    float fx_lane[4], fy_lane[4], fz_lane[4];\n    vst1q_f32(fx_lane, fx);\n    vst1q_f32(fy_lane, fy);\n    vst1q_f32(fz_lane, fz);\n    for (int lane = 0; lane < 4; ++lane) {\n      p[i + lane].vx += dt*fx_lane[lane];\n      p[i + lane].vy += dt*fy_lane[lane];\n      p[i + lane].vz += dt*fz_lane[lane];\n    }\n    return;\n  }\n#endif\n\n  /* Scalar remainder, or the complete block on non-NEON builds. */\n  for (int lane = 0; lane < 4 && lane < n - i; ++lane) {\n    body_force_one(p, dt, n, i + lane);\n  }\n}\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system. This entry point also supports independent calls.\n */\nvoid body_force(Body *p, float dt, int n) {\n  const int nblocks = n > 0 ? n / 4 + (n % 4 != 0) : 0;\n\n  #pragma omp parallel for schedule(static) if(n >= PARALLEL_MIN_BODIES) default(none) shared(p, dt, n, nblocks)\n  for (int block = 0; block < nblocks; ++block) {\n    body_force_block(p, dt, n, 4 * block);\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n  const int nblocks = nbodies > 0 ? nbodies / 4 + (nbodies % 4 != 0) : 0;\n\n  /* Reuse one team across all timesteps; small systems execute serially. */\n  #pragma omp parallel if(nbodies >= PARALLEL_MIN_BODIES) default(none) shared(bodies, nbodies, nblocks)\n  {\n    for (int iter = 0; iter < N_ITER; iter++) {\n      #pragma omp for schedule(static)\n      for (int block = 0; block < nblocks; ++block) {\n        body_force_block(bodies, DT, nbodies, 4 * block);\n      }\n      /* The implicit barrier completes all reads of old positions. */\n\n      #pragma omp for schedule(static)\n      for (int i = 0; i < nbodies; i++) {\n        bodies[i].x += bodies[i].vx * DT;\n        bodies[i].y += bodies[i].vy * DT;\n        bodies[i].z += bodies[i].vz * DT;\n      }\n      /* The implicit barrier publishes positions for the next step. */\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
        "path": "src/nbody.c"
      }

"""Update private human-facing guides, never live state or sealed worker code."""
import hashlib
import json
import shutil
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
OUT = ROOT.parent
STUDY = OUT / "HPC-Forest-Etude-2020-2024-r1"
EDITORIAL = STUDY / "edition-professionnelle"
GPT = OUT / "Marathon22-GPT61Sol-MAX/reference96-r2"


def read(p):
    return json.loads(p.read_text(encoding="utf-8-sig"))


def sha(p):
    with p.open("rb") as f:
        return hashlib.file_digest(f, "sha256").hexdigest()


def save(p, d):
    p.write_text(json.dumps(d, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def main():
    assert read(EDITORIAL / "controle-qualite.json")["visual_review_completed"]
    before = HERE / "guides-avant"
    before.mkdir(exist_ok=False)
    guides = [ROOT / "REPRISE.md", ROOT / "SUIVI-AUTOMATISE-ACTUEL.md", ROOT / "suivi-a-faire.json",
              ROOT / "COORDINATION-SOURCE-ONLY.md", STUDY / "REPRISE-ACTUALISEE.md",
              EDITORIAL / "REPRISE.md", GPT / "BILAN-REFERENCE96.md", GPT / "current-job.json"]
    backup = {}
    for i, p in enumerate(guides):
        dest = before / (str(i) + "-" + p.name)
        shutil.copy2(p, dest)
        assert sha(p) == sha(dest)
        backup[str(p.resolve())] = {"copy": str(dest.resolve()), "sha256": sha(p)}
    automation = Path("C:/Users/nicol/.codex/automations/terminer-les-essais-deepseek-sur-romeo/automation.toml")
    shutil.copy2(automation, before / "automation-avant.toml")
    save(before / "copies-verifiees.json", backup)
    header_path = HERE / "ETAT-ACTUEL.md"
    header = header_path.read_text(encoding="utf-8").replace("ARTICLE_FINAL", "L’article professionnel admet explicitement GPT96 après préservation vérifiée de 2006 fichiers de l’édition Terra 14/175 pages sous HPC-Forest-Etude-2020-2024-r1/versions/20261017-avant-reference96-professionnelle/. La nouvelle édition comporte 15 pages / sept figures principales et 182 pages / 152 figures d’annexes ; 197 pages rendues et inspectées sur 34 planches, contrôle pleine résolution des pages à risque et correction d’un en-tête de tableau. Les 93 registres, 77 résultats principaux et 11575 temps CPU sont recalculés. Les six cohortes natives closes totalisent 786 invocations observées, 17556652 jetons exacts connus et 73 invocations non mesurées, plus la requête Terra sans réponse inconnue. Les coûts Terra/GPT96 remplacent leurs anciennes entrées historiques sans double compte. Lire edition-professionnelle/admission-reference96-verifiee.json, audit-calculs.json, controle-qualite.json et manifeste-edition.json. Aucun résultat CPU nouveau, gain R5, apprentissage Flash ou résultat final source-only n’est ajouté ; dépôt public et kit privé inchangés. Ne pas renotifier cette édition après sa livraison sans nouvelle preuve ou incident. Toute cohorte suivante exige nouvelle admission, préservation, revue, reconstruction et contrôle visuel.")
    header += "\nAu contrôle Slurm de 02:40 UTC, 749415 et 749843 sont RUNNING. Preuve : activation-source-only-20261017/statuts-apres-activation.json ; les observations ultérieures et identités complètes prévalent toujours.\n"
    header_path.write_text(header, encoding="utf-8")
    for p in (ROOT / "REPRISE.md", ROOT / "SUIVI-AUTOMATISE-ACTUEL.md", STUDY / "REPRISE-ACTUALISEE.md"):
        old = p.read_text(encoding="utf-8-sig")
        historical = old.split("\n---\n", 1)[1] if "\n---\n" in old else old
        p.write_text(header + "\n---\n\n# Historique conservé — les états datés ci-dessous sont historiques\n" + historical, encoding="utf-8")
    todo_path = ROOT / "suivi-a-faire.json"
    todo = read(todo_path)
    todo.update(phase="source_only_first_group_running_after_gpt96_audited_closure", native_calls=None,
                native_calls_pending_reception=True, jobs_submitted=1, source_only_live_dispatch_validated=True,
                source_only_first_reception_validated=False, updated_utc=datetime.now(UTC).isoformat(),
                current_source_only_group="source-only-gpt-6-luna-max", current_source_only_job="749843",
                source_only_session="bb7a58941e74486ba24267f2f526de8f", source_only_worker_pids=[39288,45464],
                source_only_coordinator_pids=[27336,11168],
                article="GPT96 admitted; professional edition 15/182 pages, 197 rendered pages visually reviewed; 93 registries/77 results; 11575 CPU timings unchanged. No public projection.")
    todo["source_only"] = ["Premier déploiement alloué et lancement vérifiés sous 749843 ; lire activation-source-only-20261017/activation-verifiee.json",
                            "Conserver les 94 sources figées et les 609 fichiers de préparation ; aucun candidat hérité",
                            "Un seul coordinateur 27336/11168 ; absence du premier reçu PowerShell déjà réconciliée, jamais relancer en doublon",
                            "Recevoir les quinze issues, efficacité/archive/SHA/restauration neuve/audit natif, cinq confirmations et réconciliation avant arrêt possédé",
                            "Même dossier/session/cache, reprise uniquement après panne d’interface confirmée et soumission réconciliée ; aucun appel commencé rejoué",
                            "Après réception auditée, poursuivre la même file ; Codex attend les 300 issues source-only reçues/auditées et sa propre admission"]
    todo["existing_native_lanes_latest_observation"] = {"path": str((HERE / "statuts-apres-activation.json").resolve()),
        "sha256": sha(HERE / "statuts-apres-activation.json"), "jobs": ["749415","749843"],
        "gpt96_audited_release_received": True, "native_workers": 2}
    todo["existing_gpt96_interface_recovery"]["historical_only_closed_and_audited"] = True
    todo["gpt96_final_reception"] = {"path": str((GPT / "reception-finale-748383/reception-verifiee.json").resolve()),
                                     "sha256": sha(GPT / "reception-finale-748383/reception-verifiee.json"),
                                     "do_not_poll_relaunch_or_renotify": True}
    save(todo_path, todo)
    coord = ROOT / "COORDINATION-SOURCE-ONLY.md"
    coord.write_text("# Première activation réelle du 17 octobre 2026\n\nLe groupe Luna MAX 749843 et son déploiement sont vérifiés ; aucun bilan final source-only reçu. Coordinateur unique 27336/11168, relais 39288/45464, session bb7a58941e74486ba24267f2f526de8f. Lire activation-source-only-20261017/activation-verifiee.json et REPRISE.md ; les anciennes instructions d’attente ci-dessous sont historiques. Réception/audit/réconciliation avant arrêt possédé ; aucun troisième worker. Le garde strict du lecteur de configuration reste à exercer sur la première réception réelle ; toute incompatibilité constatée impose une révision isolée du lecteur et conservation du refus, sans modifier les 94 sources ni le worker vivant.\n\n---\n\n" + coord.read_text(encoding="utf-8-sig"), encoding="utf-8")
    guide = EDITORIAL / "REPRISE.md"
    guide.write_text("# Actualisation GPT96 du 17 octobre 2026 — reçue et contrôlée\n\nVersion précédente 14/175 pages préservée sous ../versions/20261017-avant-reference96-professionnelle/, 2006 copies vérifiées. Admission explicite des trois sujets GPT96 / 748383 après réception native et complément indépendant, 7365 fichiers restaurés inchangés. La nouvelle édition est de 15 pages / sept figures principales et 182 pages / 152 figures d’annexes. Les 197 pages sont rendues et inspectées sur 34 planches ; un en-tête étroit est corrigé, les deux pages modifiées sont réinspectées et 195 rendus restent identiques. Lire admission-reference96-verifiee.json (admission préalable), audit-calculs.json, controle-qualite.json et manifeste-edition.json (livraison finale).\n\n93 registres uniques, 77 résultats principaux, CPU inchangé à 58 racines / 2315 points / 11575 temps. Les six cohortes natives closes ont 786 invocations, 17556652 jetons exacts connus et 73 invocations sans compteur, plus une requête Terra sans réponse inconnue. couts-gpt96.json et couts-terra.json remplacent les entrées historiques de la figure sans addition. Les deux expirations GPT96 avant invocation ne sont pas les 17 invocations GPT96 non mesurées. Slurm FAILED 1:0 et planning incomplet au budget sont conservés malgré les trois confirmations reçues.\n\nR1 Sol MAX 749415 et source-only Luna MAX 749843 occupent les deux voies, sans nouveau bilan final de ces groupes. Codex natif, R4, R5 réel et Flash appris restent non admis/non lancés selon leurs priorités. Le premier déploiement source-only ne constitue pas une nouvelle cohorte de résultats. Aucune publication ni modification du kit privé. Tout nouvel audit exige préservation, admission, recalcul, construction et contrôle visuel ; utiliser uniquement la chaîne canonique ci-dessous. Les paragraphes suivants décrivent les éditions historiques lorsque leurs chiffres diffèrent.\n\n---\n\n" + guide.read_text(encoding="utf-8-sig"), encoding="utf-8")
    bilan = GPT / "BILAN-REFERENCE96.md"
    text = bilan.read_text(encoding="utf-8-sig").replace("L admission a la prochaine edition professionnelle reste a effectuer", "L admission professionnelle est reçue : article 15 pages, annexes 182 pages, 197 pages rendues et inspectées ; lire HPC-Forest-Etude-2020-2024-r1/edition-professionnelle/manifeste-edition.json")
    bilan.write_text(text, encoding="utf-8")
    job_path = GPT / "current-job.json"
    job = read(job_path)
    job["article_admission_pending"] = False
    job["professional_edition"] = {"main_pages":15,"supplement_pages":182,"visually_reviewed_pages":197,"guide":str(guide.resolve())}
    save(job_path, job)
    idpath = OUT.parent / "ID.md"
    text = idpath.read_text(encoding="utf-8")
    text = text.replace("Admission GPT96 : 93 registres et 77 résultats recalculés, version Terra 14/175 pages préservée ; reconstruction et contrôle visuel final consignés séparément", "Édition GPT96 livrée : 15 pages principales / 182 d’annexes, 93 registres et 77 résultats recalculés ; 197 pages inspectées, version Terra 14/175 préservée")
    text = text.replace("Édition GPT96 : 93 registres uniques, 77 résultats principaux et 11575 temps CPU recalculés ; admission explicite et versions préservées, contrôle visuel final consigné séparément", "Édition GPT96 livrée : 93 registres, 77 résultats et 11575 temps CPU recalculés ; 197 pages rendues/inspectées, 159 figures, versions préservées")
    text += "\n\nLivraison éditoriale GPT96 vérifiée le 17 octobre : 15 pages / sept figures principales et 182 pages / 152 figures d’annexes ; 197 pages rendues et inspectées. La table ID des PDF est l’instantané précédant ce contrôle visuel final ; ID-017/040 sont clos pour cette édition dans ce registre vivant. Les autres ID incomplets, les 300 issues directes et la qualification Codex restent ouverts.\n"
    idpath.write_text(text, encoding="utf-8")
    print(json.dumps({"guides_updated":len(guides),"pages_visually_reviewed":197,"automation_update_pending":True}))


if __name__ == "__main__":
    main()

      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <algorithm>\n#include <climits>\n#include <omp.h>\n\nstatic int read_int() {\n    int x = 0;\n    char c = getchar_unlocked();\n    while (c < '0' || c > '9') {\n        if (c == '-') {\n            c = getchar_unlocked();\n            while (c >= '0' && c <= '9') {\n                x = x * 10 - (c - '0');\n                c = getchar_unlocked();\n            }\n            return x;\n        }\n        c = getchar_unlocked();\n    }\n    do {\n        x = x * 10 + (c - '0');\n        c = getchar_unlocked();\n    } while (c >= '0' && c <= '9');\n    return x;\n}\n\nint main() {\n    int n = read_int();\n    int s = read_int();\n\n    const int np1 = n + 1;\n    std::vector<long long> pref(np1 * np1, 0LL);\n\n    // Horizontal prefix sums during input (no matrix storage)\n    for (int i = 0; i < n; ++i) {\n        long long row_sum = 0;\n        const int base_i = (i + 1) * np1;\n        for (int j = 0; j < n; ++j) {\n            int val = read_int();\n            row_sum += val;\n            pref[base_i + (j + 1)] = row_sum;\n        }\n    }\n\n    // Vertical accumulation: parallel over columns\n#pragma omp parallel for schedule(static)\n    for (int j = 0; j < n; ++j) {\n        long long sum = 0;\n        const int col_offset = j + 1;\n        for (int i = 0; i < n; ++i) {\n            sum += pref[(i + 1) * np1 + col_offset];\n            pref[(i + 1) * np1 + col_offset] = sum;\n        }\n    }\n\n    // Search all SxS submatrices using O(1) prefix-sum queries\n    long long mxSum = LLONG_MIN;\n    const int limit_i = n - s + 1;\n    const int limit_j = n - s + 1;\n#pragma omp parallel for collapse(2) schedule(static) reduction(max:mxSum)\n    for (int i = 0; i < limit_i; ++i) {\n        for (int j = 0; j < limit_j; ++j) {\n            long long sum = pref[(i + s) * np1 + (j + s)]\n                          - pref[i * np1 + (j + s)]\n                          - pref[(i + s) * np1 + j]\n                          + pref[i * np1 + j];\n            if (sum > mxSum) mxSum = sum;\n        }\n    }\n\n    printf(\"%d\\n\", static_cast<int>(mxSum));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

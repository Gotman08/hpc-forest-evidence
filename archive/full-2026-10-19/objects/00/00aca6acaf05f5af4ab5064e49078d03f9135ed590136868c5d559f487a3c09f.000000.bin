"], \"retained\": [\"Retain the existing serial implementation for graphs smaller than eight vertices.\", \"For larger graphs, generate permutations in Heap order into a fixed-size contiguous batch, verify each candidate with an OpenMP static work-sharing loop, and print matches serially in batch order.\"]}, \"mean_seconds\": 0.009134938940405846, \"diff\": \"diff --git a/src/brute_isomorphism.cpp b/src/brute_isomorphism.cpp\\nindex 9245dc0..564e8a1 100644\\n--- a/src/brute_isomorphism.cpp\\n+++ b/src/brute_isomorphism.cpp\\n@@ -10,7 +10,9 @@ adjacency_matrix readGraph();\\n \\n bool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\\n bool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence);\\n+bool verifyPermutationRaw(const adjacency_matrix &g1, const adjacency_matrix &g2, const int *equivalence, int n);\\n inline void printPermutation(vector<int> &equivalence);\\n+inline void printPermutation(const int *equivalence, int n);\\n \\n int main(){\\n     adjacency_matrix g1 = readGraph();\\n@@ -23,44 +25,121 @@ int main(){\\n }\\n \\n bool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\\n-    vector<int> equivalence(g1.size(), 0);\\n-    vector<int> exchange_counter(g1.size(), 0);\\n+    if(g1.size() != g2.size()) return false;\\n+\\n+    const int n = static_cast<int>(g1.size());\\n+\\n+    // Keep small searches on the original serial path to avoid parallel overhead.\\n+    if(n < 8){\\n+        vector<int> equivalence(g1.size(), 0);\\n+        vector<int> exchange_counter(g1.size(), 0);\\n+        int exchange_index = 1;\\n+        bool isomorphism_found = false;\\n+\\n+        for(int i = 0; i < equivalence.size(); ++i)\\n+            equivalence[i] = i;\\n+\\n+        if(verifyPermutation(g1, g2, equivalence)){\\n+            printPermutation(equivalence);\\n+            return true;\\n+        }\\n+\\n+        /*\\n+         * Permutations are based on Heap's algorithm, which generates all possible\\n+         * permutations for a given set of elements.\\n+         */\\n+        while(exchange_index < g1.size()){\\n+            if(exchange_counter[exchange_index] < exchange_index){\\n+                if(exchange_index % 2 == 0)\\n+                    swap(equivalence[0], equivalence[exchange_index]);\\n+                else\\n+                    swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\\n+                if(verifyPermutation(g1, g2, equivalence)){\\n+                    printPermutation(equivalence);\\n+                    isomorphism_found = true;\\n+                }\\n+\\n+                exchange_counter[exchange_index]++;\\n+                exchange_index = 1;\\n+            }else{\\n+                exchange_counter[exchange_index] = 0;\\n+                exchange_index++;\\n+            }\\n+        }\\n+        return isomorphism_found;\\n+    }\\n+\\n+    // Generate bounded batches in Heap order. Workers check candidates in parallel;\\n+    // matches are printed serially in their original order.\\n+    const int batch_capacity = 8192;\\n+    vector<int> permutation(n);\\n+    vector<int> exchange_counter(n, 0);\\n+    vector<int> batch(batch_capacity * n);\\n+    vector<unsigned char> matches(batch_capacity, 0);\\n     int exchange_index = 1;\\n+    int batch_count = 0;\\n+    bool has_permutation = true;\\n     bool isomorphism_found = false;\\n \\n-    if(g1.size() != g2.size()) return false;\\n+    for(int i = 0; i < n; ++i)\\n+        permutation[i] = i;\\n+\\n+    #pragma omp parallel\\n+    {\\n+        while(true){\\n+            #pragma omp single\\n+            {\\n+                batch_count = 0;\\n+                while(batch_count < batch_capacity && has_permutation){\\n+                    const int offset = batch_count * n;\\n+                    for(int i = 0; i < n; ++i)\\n+                        batch[offset + i] = permutation[i];\\n+                    ++batch_count;\\n+\\n+                
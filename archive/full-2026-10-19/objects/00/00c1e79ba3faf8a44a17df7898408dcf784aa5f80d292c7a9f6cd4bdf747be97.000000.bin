>(n));\n    for(int i=0;i<n;i++)\n        for(int j=0;j<n;j++) \n            scanf(\"%d\", &(matrix[i][j]));\n\n    assert(s<n);\n    assert(n<8000);\n    assert(s>0);\n    assert(n>0);\n\n    // Column prefix sums: colPref[i][j] = sum of matrix[0..i][j]\n    std::vector<std::vector<long long> > colPref(n, std::vector<long long>(n));\n    for(int j=0;j<n;++j) {\n        long long running = 0;\n        for(int i=0;i<n;++i) {\n            running += matrix[i][j];\n            colPref[i][j] = running;\n        }\n    }\n\n    long long mxSum = LLONG_MIN;\n\n    #pragma omp parallel for reduction(max:mxSum) schedule(static)\n    for(int r=0; r<=n-s; ++r) {\n        // initial window at column 0\n        long long cur = 0;\n        int bottom = r + s - 1;\n        int topMinusOne = r - 1;\n        for(int c=0;c<s;++c) {\n            long long seg = colPref[bottom][c] - (topMinusOne >= 0 ? colPref[topMinusOne][c] : 0);\n            cur += seg;\n        }\n        if(cur > mxSum) mxSum = cur;\n\n        for(int c=1; c<=n-s; ++c) {\n            int outCol = c-1;\n            int inCol = c+s-1;\n            long long segOut = colPref[bottom][outCol] - (topMinusOne >= 0 ? colPref[topMinusOne][outCol] : 0);\n            long long segIn = colPref[bottom][inCol] - (topMinusOne >= 0 ? colPref[topMinusOne][inCol] : 0);\n            cur += segIn - segOut;\n            if(cur > mxSum) mxSum = cur;\n        }\n    }\n\n    printf(\"%d\\n\", (int)mxSum);\n}\n```\n\nBut note: `#pragma omp parallel for` requires OpenMP enabled. If not, it's ignored and code runs sequentially; still correct.\n\nPotential issue: The reduction variable `mxSum` is long long; we print as int cast. Since result fits 32-bit signed, casting is safe.\n\nWe should also consider that the original algorithm might have negative sums? Yes, matrix values can be negative; max sum could be negative if all submatrices negative. Our initialization LLONG_MIN works.\n\nNow check correctness: For each r, we compute initial w
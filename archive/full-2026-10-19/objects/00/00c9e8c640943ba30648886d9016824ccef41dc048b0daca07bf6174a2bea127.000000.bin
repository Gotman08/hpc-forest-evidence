"""Seal the external review-ref fix and preserve the actual missing-field finding."""
from pathlib import Path
import hashlib
import json

HERE = Path(__file__).resolve().parent
PREP = HERE.parents[2]
def ref(path):
    value = path.read_bytes()
    return {"path":str(path),"sha256":hashlib.sha256(value).hexdigest(),"bytes":len(value)}
old_review = PREP / "adaptateurs-source110-r1/revue-integration-source110-parent-r1/REVUE-INTEGRATION-SOURCE110-PARENT.json"
old_ref = ref(old_review)
assert old_ref["sha256"] == "714fe52326ebb159ee11213a75ba30375eea0a9fd85ec912b5754e0077d6bc12"
data = json.loads(old_review.read_bytes())
assert "observer_sha256" not in data and "abi_sha256" not in data
finding = {"schema":"hpc-forest-source110-actual-old-review-missing-OBS4-fields-v1","actual_review":old_ref,
           "observer_sha256_missing":True,"abi_sha256_missing":True,"old_review_modified":False,
           "operational_false_positive_prevented":True,"native_or_observer_started":False}
with (HERE / "REFUS-CONCRET-REVUE714-PRESERVE.json").open("x",encoding="utf8",newline="\n") as stream:
    json.dump(finding,stream,indent=2);stream.write("\n")
files = {name:ref(HERE / name) for name in ("preparer-policy-routes-r2.py","DIFF-FINALISEUR-R1-R2.patch",
         "DELTA-FERME-FINALISEUR-R2.json","REFUS-CONCRET-REVUE714-PRESERVE.json","REPRISE-R2.md")}
for name in ("POLICY-OBS4.json","ROUTES-OBS4.json","COMMANDES-OBS4.json"):
    path = HERE.parent / "policy-routes-NON-ADMISES-02" / name
    files["template02/"+name] = ref(path)
report = {"schema":"hpc-forest-source110-OBS4-external-review-ref-r2-delivery-v1","prepared_only":True,
          "old_delivery767_preserved":True,"files":files,"components62_or_Q_modified":False,
          "Ruff_F_E9_returncode":0,"Ruff_F_E9_diagnostics":[],
          "template_only_execution_passed":True,"actual_Q_policy_branch_executed":False,
          "real_new_OBS4_integration_review_received":False,"actual_finalization_admitted":False,
          "required_next":["Independent actual supplementary OBS4/integration review with exact62 plus top-level observer/ABI pins",
                           "Isolated parent active review-ref rebinding and shared factory/reader/policy authorization references",
                           "Independent review of these new two helpers before fresh root use"],
          "observer_process_RPC_lock_or_model_effects":0,"native_generation_admitted":False}
target = HERE / "LIVRAISON-FINALISEUR-REVUE-OBS4-R2.json"
with target.open("x",encoding="utf8",newline="\n") as stream:
    json.dump(report,stream,indent=2);stream.write("\n")
print(json.dumps(ref(target)))

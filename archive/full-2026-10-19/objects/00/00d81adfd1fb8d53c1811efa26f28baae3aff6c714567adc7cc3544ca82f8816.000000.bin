{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"/*\\n    Solve Laplace's equation using synchronous Jacobi iteration.\\n    Two-sweep row pipelining keeps intermediate values in a small row cache.\\n*/\\n#include <stdio.h>\\n#include <stdlib.h>\\n\\n#define CONV_THRESHOLD 1.0e-5f\\n\\n// Contiguous current and destination grids.\\ndouble *grid;\\ndouble *new_grid;\\nstatic double *row_cache;\\n\\nint size;\\nint iter_max_num;\\n\\ndouble absolute(double num){\\n    if(num < 0)\\n        return -1.0 * num;\\n    return num;\\n}\\n\\nvoid allocate_memory(void){\\n    size_t n = (size_t)size;\\n    if(n != 0 && n > ((size_t)-1) / sizeof(*grid) / n)\\n        exit(EXIT_FAILURE);\\n\\n    grid = malloc(n * n * sizeof(*grid));\\n    new_grid = malloc(n * n * sizeof(*new_grid));\\n    row_cache = malloc(3 * n * sizeof(*row_cache));\\n    if(n != 0 && (!grid || !new_grid || !row_cache)){\\n        free(grid);\\n        free(new_grid);\\n        free(row_cache);\\n        exit(EXIT_FAILURE);\\n    }\\n}\\n\\nvoid initialize_grid(void){\\n    int center = size / 2;\\n    int linf = center - (size / 10);\\n    int lsup = center + (size / 10);\\n    size_t n = (size_t)size;\\n\\n    for(int i = 0; i < size; i++){\\n        for(int j = 0; j < size; j++){\\n            double value = 0.0;\\n            if(i >= linf && i <= lsup && j >= linf && j <= lsup)\\n                value = 100.0;\\n            grid[(size_t)i * n + j] = value;\\n            // Both buffers must retain the original frozen boundaries.\\n            new_grid[(size_t)i * n + j] = value;\\n        }\\n    }\\n}\\n\\nvoid save_grid(void){\\n    size_t n = (size_t)size;\\n    for(int i = 0; i < size; i++){\\n        const double *row = grid + (size_t)i * n;\\n        for(int j = 0; j < size; j++){\\n            fprintf(stdout, \\\"%lf \\\", row[j]);\\n        }\\n        fprintf(stdout, \\\"\\\\n\\\");\\n    }\\n}\\n\\nstatic inline int update_row(const double *restrict above,\\n                             const double *restrict current,\\n                             const double *restrict below,\\n                             double *restrict output,\\n                             int width){\\n    int changed = 0;\\n    for(int j = 1; j < width - 1; j++){\\n        double value = 0.25 * (current[j+1] + current[j-1] +\\n                              above[j] + below[j]);\\n        output[j] = value;\\n        changed |= absolute(value - current[j]) > CONV_THRESHOLD;\\n    }\\n    return changed;\\n}\\n\\nstatic int single_sweep(const double *restrict source,\\n                        double *restrict destination){\\n    size_t n = (size_t)size;\\n    int changed = 0;\\n    for(int i = 1; i < size - 1; i++){\\n        size_t offset = (size_t)i * n;\\n        const double *row = source + offset;\\n        changed |= update_row(row - n, row, row + n,\\n                              destination + offset, size);\\n    }\\n    return changed;\\n}\\n\\n// Bit zero records first-sweep changes; bit one records second-sweep changes.\\n// Called only for grids with an interior and at least two remaining sweeps.\\nstatic unsigned int two_sweeps(const double *restrict source,\\n                               double *restrict destination,\\n                               double *restrict cache){\\n    size_t n = (size_t)size;\\n    double *previous = cache;\\n    double *current = cache + n;\\n    double *next = cache + 2 * n;\\n\\n    // The first intermediate row is the unchanged top boundary.\\n    for(int j = 0; j < size; j++)\\n        previous[j] = source[j];\\n\\n    const double *first = source + n;\\n    current[0] = first[0];\\n    current[size-1] = first[size-1];\\n    unsigned int changed = (unsigned int)update_row(source, first,\\n                                                   first + n, current, size);\\n\\n    for(int i = 1; i < size - 2; i++){\\n        const double *row = source + (size_t)(i + 1) * n;\\n        next[0] = row[0];\\n        next[size-1] = row[size-1];\\n\\n        // Produce the next intermediate row, then immediately consume it.\\n        changed |= (unsigned int)update_row(row - n, row, row + n,\\n                                            next, size);\\n        changed |= (unsigned int)update_row(previous, current, next,\\n                                            destination + (size_t)i * n,\\n                                            size) << 1;\\n\\n        double *old_previous = previous;\\n        previous = current;\\n        current = next;\\n        next = old_previous;\\n    }\\n\\n    // The final intermediate neighbor is the unchanged bottom boundary.\\n    changed |= (unsigned int)update_row(previous, current,\\n                                        source + (n - 1) * n,\\n                                        destination + (n - 2) * n,\\n                                        size) << 1;\\n    return changed;\\n}\\n\\nint main(int argc, char *argv[]){\\n    fscanf(stdin, \\\"%d\\\", &size);\\n    fscanf(stdin, \\\"%d\\\", &iter_max_num);\\n\\n    allocate_memory();\\n    initialize_grid();\\n\\n    int hasError = 1;\\n    int iter = 0;\\n    while(hasError && iter < iter_max_num){\\n        if(size > 2 && iter_max_num - iter >= 2){\\n            unsigned int changed = two_sweeps(grid, new_grid, row_cache);\\n            if((changed & 1u) == 0){\\n                // The reference stops after the first converged sweep.\\n                // Its input is intact, so recover that exact first result.\\n                single_sweep(grid, new_grid);\\n                hasError = 0;\\n                iter++;\\n            } else {\\n                hasError = (changed & 2u) != 0;\\n                iter += 2;\\n            }\\n        } else {\\n            hasError = single_sweep(grid, new_grid);\\n            iter++;\\n        }\\n\\n        double *old_grid = grid;\\n        grid = new_grid;\\n        new_grid = old_grid;\\n    }\\n\\n    save_grid();\\n    free(row_cache);\\n    free(new_grid);\\n    free(grid);\\n    return 0;\\n}\\n\",\n      \"path\": \"src/laplace_seq.c\"\n    }\n  ],\n  \"hypothesis\": \"Pipelining two Jacobi sweeps through three cached intermediate rows should reduce full-grid memory traffic while preserving exact stopping behavior.\",\n  \"notes\": \"No commands executed. Floating-point addition order, convergence threshold, frozen boundaries and output formatting remain unchanged.\",\n  \"research\": {\n    \"queries\": [],\n    \"urls\": []\n  },\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Use contiguous grid buffers with identical frozen boundaries and pointer swapping.\",\n    \"Temporally block two sweeps using a rotating three-row intermediate cache.\",\n    \"Track convergence separately for both sweeps; recover the first result if it converges, and handle odd iteration limits with a single sweep.\",\n    \"Use a restrict-qualified row kernel with integer-OR convergence reduction.\"\n  ]\n}"}}

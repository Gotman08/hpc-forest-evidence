#include <algorithm>
#include <cstddef>
#include <iostream>
#include <iterator>
#include <string>

struct IsWhitespace
{
    template <typename Char> auto
    operator () (Char c) const -> bool
    {
        return (c == ' ' )
            || (c == '\n')
            || (c == '\r')
            || (c == '\t')
            || (c == '\f')
            || (c == '\v') ;
    }
} ;

template <typename String> inline auto
remove_whitespaces (String text) -> String
{
    text.erase
        ( std::remove_if
            ( text.begin ()
            , text.end ()
            , IsWhitespace () )
        , text.end () ) ;
    return text ;
}

template <typename String, typename InStream> inline auto
read_text_from_stdin (InStream& in) -> String
{
    std::istreambuf_iterator <char> begin (in), end ;
    std::string text (begin, end) ;
    text = remove_whitespaces (text) ;
    return text ;
}

class PermutationOutput
{
    static constexpr std::size_t capacity = 64 * 1024 ;
    char buffer_[capacity] ;
    std::size_t record_size_ ;
    std::size_t block_size_ ;
    std::size_t used_ ;

    auto append (char c) -> void
    {
        if (used_ == capacity) flush () ;
        buffer_[used_++] = c ;
    }

public:
    explicit PermutationOutput (std::size_t symbol_count)
        : record_size_ (0), block_size_ (capacity), used_ (0)
    {
        if (symbol_count <= (capacity - 4) / 2) {
            record_size_ = 2 * symbol_count + 4 ;
            block_size_ = (capacity / record_size_) * record_size_ ;
            std::fill (buffer_, buffer_ + block_size_, ' ') ;
            for (std::size_t offset = 0; offset < block_size_;
                 offset += record_size_) {
                buffer_[offset] = '[' ;
                buffer_[offset + record_size_ - 2] = ']' ;
                buffer_[offset + record_size_ - 1] = '\n' ;
            }
        }
    }

    auto write (const std::string& text) -> void
    {
        if (record_size_ != 0) {
            char* destination = buffer_ + used_ + 2 ;
            for (char c : text) {
                *destination = c ;
                destination += 2 ;
            }
            used_ += record_size_ ;
            if (used_ == block_size_) flush () ;
            return ;
        }

        append ('[') ;
        append (' ') ;
        for (char c : text) {
            append (c) ;
            append (' ') ;
        }
        append (']') ;
        append ('\n') ;
    }

    auto flush () -> void
    {
        if (used_ != 0) {
            std::cout.write
                (buffer_, static_cast<std::streamsize> (used_)) ;
            used_ = 0 ;
        }
    }
} ;

int main (int argc, char const *argv [])
{
    std::string text = read_text_from_stdin <std::string> (std::cin) ;
    if (text.empty ()) return 0 ;

    std::sort (text.begin (), text.end ()) ;
    PermutationOutput output (text.size ()) ;
    do {
        output.write (text) ;
    } while (std::next_permutation (text.begin (), text.end ())) ;
    output.flush () ;
    return 0 ;
}

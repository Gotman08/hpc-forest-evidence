        "content": "#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n#include<stdint.h>\n\n/* Maximum size (in char) for neighbors and compute lists */\n#define MAX 100\n#define UNRESOLVED (-2)\n\n/* Keep traversal data separate from cold neighbor text. */\ntypedef struct {\n  int id;\n  float value;\n  int successor;\n} Node;\n\ntypedef struct {\n  Node *nodes;\n  char (*neighbors)[MAX];\n  int *lookup;\n  size_t mask;\n  int size;\n} Graph;\n\nstatic void fail(void) {\n  fprintf(stderr, \"Error!\\n\");\n  exit(1);\n}\n\nstatic size_t hash_id(int id) {\n  uint32_t x = (uint32_t)id;\n  x ^= x >> 16;\n  x *= 0x7feb352dU;\n  x ^= x >> 15;\n  x *= 0x846ca68bU;\n  x ^= x >> 16;\n  return (size_t)x;\n}\n\nstatic void build_lookup(Graph *g) {\n  size_t count = g->size > 0 ? (size_t)g->size : 0;\n  size_t capacity = 1;\n  while (capacity < count * 2)\n    capacity *= 2;\n\n  g->lookup = (int*)calloc(capacity, sizeof(*g->lookup));\n  if (g->lookup == NULL)\n    fail();\n  g->mask = capacity - 1;\n\n  for (int i = 0; i < g->size; i++) {\n    size_t slot = hash_id(g->nodes[i].id) & g->mask;\n    while (g->lookup[slot] != 0) {\n      int previous = g->lookup[slot] - 1;\n      if (g->nodes[previous].id == g->nodes[i].id)\n        break;\n      slot = (slot + 1) & g->mask;\n    }\n    /* Insertion order preserves the first match for duplicate IDs. */\n    if (g->lookup[slot] == 0)\n      g->lookup[slot] = i + 1;\n  }\n}\n\nstatic Graph read_input(char *fname, char *list) {\n  Graph g = {0};\n  FILE *fl = fname == NULL ? stdin : fopen(fname, \"r\");\n  if (fl == NULL)\n    fail();\n\n  fscanf(fl, \"%d %[^\\n]\", &g.size, list);\n\n  if (g.size > 0) {\n    g.nodes = (Node*)malloc((size_t)g.size * sizeof(*g.nodes));\n    g.neighbors = malloc((size_t)g.size * sizeof(*g.neighbors));\n    if (g.nodes == NULL || g.neighbors == NULL)\n      fail();\n  }\n\n  for (int i = 0; i < g.size; i++) {\n    fscanf(fl, \"%d %f %[^\\n]\", &g.nodes[i].id,\n           &g.nodes[i].value, g.neighbors[i]);\n    g.nodes[i].successor = UNRESOLVED;\n  }\n\n  fclose(fl);\n  build_lookup(&g);\n  return g;\n}\n\n/* Returns the first node index for an arbitrary signed ID. */\nstatic int find_by_id(const Graph *g, int id) {\n  size_t slot = hash_id(id) & g->mask;\n  for (;;) {\n    int entry = g->lookup[slot];\n    if (entry == 0)\n      return -1;\n    int nd = entry - 1;\n    if (g->nodes[nd].id == id)\n      return nd;\n    slot = (slot + 1) & g->mask;\n  }\n}\n\n/* Resolve only visited nodes, retaining just their selected successor. */\nstatic int resolve_successor(Graph *g, int nd) {\n  Node *node = &g->nodes[nd];\n  if (node->successor != UNRESOLVED)\n    return node->successor;\n\n  int idmax = -1;\n  int selected = -1;\n  float max = 0;\n  char aux[MAX];\n  char *auxptr;\n  strcpy(aux, g->neighbors[nd]);\n\n  for (char *t = strtok_r(aux, \" \", &auxptr); t != NULL;\n       t = strtok_r(NULL, \" \", &auxptr)) {\n    int id = atoi(t);\n    int d = find_by_id(g, id);\n    if (d >= 0 && max < g->nodes[d].value) {\n      max = g->nodes[d].value;\n      idmax = id;\n      selected = d;\n    }\n  }\n\n  /* ID -1 remains a stopping sentinel even when that node exists. */\n  node->successor = idmax == -1 ? -1 : selected;\n  return node->successor;\n}\n\nstatic float get_costly_index(Graph *g, int nd) {\n  int next = resolve_successor(g, nd);\n  float r = g->nodes[nd].value;\n  if (next >= 0)\n    r += get_costly_index(g, next);\n  return r;\n}\n\nstatic float get_costly(Graph *g, int id) {\n  int nd = find_by_id(g, id);\n  if (nd < 0)\n    return 0;\n  return get_costly_index(g, nd);\n}\n\nint main() {\n  char computelist[MAX];\n  Graph input = read_input(NULL, computelist);\n\n  for (char *c = strtok(computelist, \" \"); c != NULL;\n       c = strtok(NULL, \" \"))\n    printf(\"%s: %f\\n\", c, get_costly(&input, atoi(c)));\n\n  free(input.lookup);\n  free(input.neighbors);\n  free(input.nodes);\n  return 0;\n}\n",
        "path": "src/graph.c"
      }

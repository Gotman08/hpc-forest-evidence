#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <string.h>

static void bubble_sort(double *values, size_t length) {
    size_t end, j;
    double temporary;

    for (end = length; end > 1; --end) {
        for (j = 0; j < end - 1; ++j) {
            if (values[j] > values[j + 1]) {
                temporary = values[j];
                values[j] = values[j + 1];
                values[j + 1] = temporary;
            }
        }
    }
}

static void merge_sort(double *values, double *scratch, size_t length) {
    size_t width;
    double *source = values;
    double *destination = scratch;

    for (width = 1; width < length;) {
        size_t left = 0;

        while (left < length) {
            size_t remaining = length - left;
            size_t middle = left + (remaining < width ? remaining : width);
            size_t right;
            size_t i, j, output;

            remaining = length - middle;
            right = middle + (remaining < width ? remaining : width);
            i = left;
            j = middle;
            output = left;

            while (i < middle && j < right) {
                if (source[i] <= source[j])
                    destination[output++] = source[i++];
                else
                    destination[output++] = source[j++];
            }
            while (i < middle)
                destination[output++] = source[i++];
            while (j < right)
                destination[output++] = source[j++];

            left = right;
        }

        {
            double *temporary = source;
            source = destination;
            destination = temporary;
        }

        if (width > length / 2)
            break;
        width *= 2;
    }

    if (source != values)
        memcpy(values, source, length * sizeof(*values));
}

static double moda_coluna_com_nan(const double *column, size_t length) {
    size_t i, j;
    float best_count = 0.0f;
    double mode = 0.0;

    for (i = 0; i < length; ++i) {
        double count = 0.0;
        for (j = i + 1; j < length; ++j) {
            if (column[i] == column[j]) {
                count++;
                if (count > best_count) {
                    best_count = (float)count;
                    mode = column[i];
                }
            }
        }
    }

    return best_count == 0.0f ? -1.0 : mode;
}

static void calcula_coluna(double *matriz, double *media, double *media_har,
                           double *mediana, double *moda, double *variancia,
                           double *dp, double *cv, size_t rows, size_t index,
                           double *scratch) {
    size_t base = index * rows;
    double *column = matriz + base;
    size_t j;
    double soma = 0.0;
    double soma_harmonica = 0.0;
    int has_nan = 0;

    for (j = 0; j < rows; ++j) {
        double value = column[j];
        soma += value;
        soma_harmonica += 1 / value;
        if (isnan(value))
            has_nan = 1;
    }
    media[index] = soma / rows;
    media_har[index] = rows / soma_harmonica;

    if (has_nan || scratch == NULL)
        bubble_sort(column, rows);
    else
        merge_sort(column, scratch, rows);

    if ((rows - 1) % 2) {
        size_t middle = (rows - 1) / 2;
        mediana[index] = column[middle] + column[middle + 1];
        mediana[index] *= 0.5;
    } else {
        mediana[index] = column[(rows - 1) / 2];
    }

    if (has_nan) {
        double variance_sum = 0.0;
        for (j = 0; j < rows; ++j)
            variance_sum += pow(column[j] - media[index], 2);
        variancia[index] = variance_sum / (rows - 1);
        moda[index] = moda_coluna_com_nan(column, rows);
    } else {
        double variance_sum = 0.0;
        double run_value = 0.0;
        double mode = 0.0;
        size_t run_length = 0;
        float best_count = 0.0f;

        for (j = 0; j < rows; ++j) {
            double value = column[j];
            variance_sum += pow(value - media[index], 2);

            if (j == 0) {
                run_value = value;
                run_length = 1;
            } else if (value == run_value) {
                ++run_length;
            } else {
                double count = (double)(run_length - 1);
                if (count > best_count) {
                    best_count = (float)count;
                    mode = run_value;
                }
                run_value = value;
                run_length = 1;
            }
        }

        {
            double count = (double)(run_length - 1);
            if (count > best_count) {
                best_count = (float)count;
                mode = run_value;
            }
        }

        variancia[index] = variance_sum / (rows - 1);
        moda[index] = best_count == 0.0f ? -1.0 : mode;
    }

    dp[index] = sqrt(variancia[index]);
    cv[index] = dp[index] / media[index];
}

int main(int argc, char **argv) {
    int lin, col, i, j;
    double *matriz, *mediana, *media, *media_har, *moda;
    double *variancia, *dp, *cv, *scratch;
    size_t rows, columns;

    (void)argc;
    (void)argv;

    fscanf(stdin, "%d ", &lin);
    fscanf(stdin, "%d\n", &col);
    rows = (size_t)lin;
    columns = (size_t)col;

    matriz = malloc(rows * columns * sizeof(*matriz));
    media = malloc(columns * sizeof(*media));
    media_har = malloc(columns * sizeof(*media_har));
    mediana = malloc(columns * sizeof(*mediana));
    moda = malloc(columns * sizeof(*moda));
    variancia = malloc(columns * sizeof(*variancia));
    cv = malloc(columns * sizeof(*cv));
    dp = malloc(columns * sizeof(*dp));
    scratch = malloc(rows * sizeof(*scratch));

    for (i = 0; i < lin; ++i) {
        for (j = 0; j < col; ++j)
            fscanf(stdin, "%lf ", &matriz[(size_t)j * rows + (size_t)i]);
    }

    for (i = 0; i < col; ++i) {
        calcula_coluna(matriz, media, media_har, mediana, moda, variancia,
                       dp, cv, rows, (size_t)i, scratch);
    }

    for (i = 0; i < col; ++i)
        printf("%.1lf ", media[i]);
    printf("\n");
    for (i = 0; i < col; ++i)
        printf("%.1lf ", media_har[i]);
    printf("\n");
    for (i = 0; i < col; ++i)
        printf("%.1lf ", mediana[i]);
    printf("\n");
    for (i = 0; i < col; ++i)
        printf("%.1lf ", moda[i]);
    printf("\n");
    for (i = 0; i < col; ++i)
        printf("%.1lf ", variancia[i]);
    printf("\n");
    for (i = 0; i < col; ++i)
        printf("%.1lf ", dp[i]);
    printf("\n");
    for (i = 0; i < col; ++i)
        printf("%.1lf ", cv[i]);
    printf("\n");

    free(matriz);
    free(media);
    free(media_har);
    free(mediana);
    free(moda);
    free(variancia);
    free(dp);
    free(cv);
    free(scratch);
    return 0;
}

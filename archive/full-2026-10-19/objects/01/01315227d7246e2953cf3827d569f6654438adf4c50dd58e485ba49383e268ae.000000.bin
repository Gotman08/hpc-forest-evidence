"""Reproduce local QA without a real model call or a ROMEO submission."""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import platform
import subprocess
import sys
import xml.etree.ElementTree as ET
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--project", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--probe-docs", action="store_true")
    args = parser.parse_args()
    project, output = args.project.resolve(strict=True), args.output.resolve()
    output.mkdir(parents=True, exist_ok=True)
    env = {**os.environ, "PYTHONPATH": str(project / "src"), "PYTHONIOENCODING": "utf8"}
    commands = [
        ("pytest", [sys.executable, "-m", "pytest", "-q", "--junitxml=" + str(output / "pytest.xml")]),
        ("ruff", [sys.executable, "-m", "ruff", "check", "src", "tests"]),
    ]
    receipt = {"schema": "hpc-forest-harness-local-qa-v1", "project": str(project),
               "observed_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
               "python": sys.executable, "platform": platform.platform(),
               "real_model_called": False, "romeo_submitted": False, "checks": []}
    for name, command in commands:
        result = subprocess.run(command, cwd=project, env=env, capture_output=True, timeout=180)
        log = output / (name + ".log")
        log.write_bytes(result.stdout + result.stderr)
        receipt["checks"].append({"name": name, "command": command, "exit_code": result.returncode,
                                   "log": str(log), "sha256": hashlib.sha256(log.read_bytes()).hexdigest()})
    if (output / "pytest.xml").is_file():
        suites = ET.parse(output / "pytest.xml").getroot()
        totals = {key: sum(int(s.get(key, 0)) for s in suites.iter("testsuite"))
                  for key in ("tests", "failures", "errors", "skipped")}
        totals["passed"] = totals["tests"] - totals["failures"] - totals["errors"] - totals["skipped"]
        receipt["pytest"] = totals
    if args.probe_docs:
        sys.path.insert(0, str(project / "src"))
        import time
        from hpc_forest.harness_research import DocumentationReader
        reader = DocumentationReader({"allowed_hosts": ["gcc.gnu.org"]}, output / "lecture-https", time.time() + 15)
        results = reader.read({"queries": [], "urls": ["https://gcc.gnu.org/onlinedocs/gcc/"]}, 1)
        receipt["https_reader_probe"] = {"operator_chosen_technical_smoke_only": True,
            "injected_into_any_model_context": False, "ok": "error" not in results[0],
            "results": results}
    receipt["local_qa_passed"] = all(c["exit_code"] == 0 for c in receipt["checks"])
    (output / "verification.json").write_text(json.dumps(receipt, ensure_ascii=False, indent=2) + "\n", encoding="utf8")
    print(json.dumps({"local_qa_passed": receipt["local_qa_passed"], "pytest": receipt.get("pytest"),
                      "https_reader_ok": receipt.get("https_reader_probe", {}).get("ok")}, ensure_ascii=False))
    return 0 if receipt["local_qa_passed"] else 1


if __name__ == "__main__":
    raise SystemExit(main())

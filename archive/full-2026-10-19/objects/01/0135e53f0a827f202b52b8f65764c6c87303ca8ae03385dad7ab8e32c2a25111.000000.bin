#!/usr/bin/env bash
# Genere par romeo-mcp - ne pas editer a la main.
#SBATCH --job-name=forest-primes-astra-max-r2c
#SBATCH --account=r250127
#SBATCH --qos=normal
#SBATCH --partition=short
#SBATCH --constraint=armgpu
#SBATCH --time=03:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --chdir=/scratch_p/nimarano
#SBATCH --output=/scratch_p/nimarano/%x-%j.out
#SBATCH --error=/scratch_p/nimarano/%x-%j.err

set -euo pipefail

# Sans cette fonction, un job ROMEO 2025 n'a acces a aucun logiciel,
# pas meme a la commande spack. Elle est propre a l'architecture :
# charger celle de l'autre donnerait des binaires inutilisables.
romeo_load_armgpu_env

# Provenance du premier demarrage : environnement, commit et fichiers choisis.
if command -v python3 >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
  if timeout 20s python3 -I -S - '{"roots": ["/scratch_p/nimarano", "/project"], "include_home": true, "code_dir": "/scratch_p/nimarano", "data_files": [], "max_bytes": 67108864}' <<'ROMEO_REPRO_CAPTURE'

import hashlib, json, os, pathlib, re, stat, subprocess, sys
params = json.loads(sys.argv[1])
roots = [pathlib.Path(p).resolve() for p in params['roots']]
if params.get('include_home'):
    roots.append(pathlib.Path.home().resolve())
def allowed(value):
    path = pathlib.Path(value).resolve()
    if not any(path == root or root in path.parents for root in roots):
        raise ValueError('outside_roots')
    if any(p.lower().startswith(('.env', 'id_rsa', 'id_ed25519', 'id_ecdsa')) or p.lower() in ('.ssh', '.aws', '.azure', '.kube', 'hosts.yml')
           or p.lower().endswith(('.pem', '.key', '.p12', '.pfx'))
           or re.search(r'password|passwd|passphrase|secret|token|credential|authorization|cookie|api[_-]?key|access[_-]?key|private[_-]?key', p, re.I)
           for p in path.parts):
        raise ValueError('sensitive_path')
    return path
out = {'git': {'status': 'unavailable'}, 'data': []}
try:
    code = allowed(params['code_dir'])
    result = subprocess.run(['git', '-c', 'core.fsmonitor=false', '-C', str(code),
                             'rev-parse', '--verify', 'HEAD'],
                            capture_output=True, text=True, timeout=5,
                            env={**os.environ, 'GIT_OPTIONAL_LOCKS': '0'})
    sha = result.stdout.strip()
    if result.returncode == 0 and len(sha) in (40, 64) and all(c in '0123456789abcdef' for c in sha):
        out['git'] = {'status': 'observed', 'commit': sha, 'working_tree_verified': False}
except (OSError, ValueError, subprocess.TimeoutExpired):
    pass
remaining = params['max_bytes']
for name in params['data_files']:
    item = {'path': name}
    try:
        path = allowed(name)
        info = path.stat()
        if not stat.S_ISREG(info.st_mode):
            item['status'] = 'not_regular_file'
        elif info.st_size > remaining:
            item.update(status='size_limit', bytes=info.st_size)
        else:
            h = hashlib.sha256()
            consumed = 0
            with path.open('rb') as stream:
                while True:
                    block = stream.read(min(1048576, remaining - consumed + 1))
                    if not block:
                        break
                    consumed += len(block)
                    if consumed > remaining:
                        break
                    h.update(block)
            after = path.stat()
            remaining = max(0, remaining - consumed)
            if consumed != info.st_size or (info.st_size, info.st_mtime_ns, info.st_ino) != (after.st_size, after.st_mtime_ns, after.st_ino):
                item['status'] = 'changed_during_read'
            else:
                item.update(status='hashed', sha256=h.hexdigest(), bytes=consumed)
    except (OSError, ValueError):
        item['status'] = 'unreadable_or_outside_roots'
    out['data'].append(item)


import datetime, platform
out['observed_at'] = datetime.datetime.now(datetime.timezone.utc).isoformat()
out['phase'] = 'before_workload'
out['environment'] = {
    'source': 'compute_node_before_command', 'architecture': platform.machine(),
    'python_version': platform.python_version(),
    'loaded_modules': [v for v in os.environ.get('LOADEDMODULES', '').split(':') if v][:128],
    'spack_loaded_hashes': [v for v in os.environ.get('SPACK_LOADED_HASHES', '').split(':') if v][:128],
}
jid = os.environ.get('SLURM_JOB_ID', '')
if os.environ.get('SLURM_ARRAY_JOB_ID') and os.environ.get('SLURM_ARRAY_TASK_ID'):
    jid = os.environ['SLURM_ARRAY_JOB_ID'] + '_' + os.environ['SLURM_ARRAY_TASK_ID']
if not re.fullmatch(r'[0-9]+(?:_[0-9]+)?', jid):
    raise ValueError('missing_job_id')
out['job_id'] = jid
folder = pathlib.Path('.romeo-provenance')
folder.mkdir(mode=0o700, exist_ok=True)
if folder.is_symlink():
    raise ValueError('symlink_capture_directory')
out['restart_count'] = os.environ.get('SLURM_RESTART_COUNT', '0')
try:
    fd = os.open(folder / (jid + '.json'), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
except FileExistsError:
    pass
else:
    with os.fdopen(fd, 'w') as stream:
        json.dump(out, stream)
        stream.write('\n')
ROMEO_REPRO_CAPTURE
  then :; else
    printf '%s\n' '[romeo-mcp] provenance indisponible ; le calcul continue.' >&2
  fi
fi


# Trace d'execution : sert a diagnostiquer les erreurs d'architecture.
echo "[romeo-mcp] noeud=$(hostname) arch=$(uname -m) job=${SLURM_JOB_ID:-?}"
echo "[romeo-mcp] debut $(date -Is)"

set -euo pipefail
[[ ${SLURM_JOB_ID:-} =~ ^[0-9]+$ ]] || exit 70
[[ ${SLURM_JOB_NUM_NODES:-} == 1 && ${SLURM_NTASKS:-} == 1 && ${SLURM_CPUS_PER_TASK:-} == 4 && ${SLURM_MEM_PER_NODE:-} == 16384 ]] || exit 71
[[ ${SLURM_RESTART_COUNT:-0} == 0 ]] || exit 72
export PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=4
srun --nodes=1 --ntasks=1 --cpus-per-task=4 --mem=16G --cpu-bind=cores --time=03:00:00 /scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python -I -B -u - <<'ONE_SELECTED_MAX_CELL_PREFLIGHT'
"""Future allocated entry: exactly one selected MAX cell; never a model loop."""
from __future__ import annotations

import hashlib
import json
import os
import platform
import re
import shlex
import sys
import zipfile
from datetime import UTC, datetime, timedelta
from pathlib import Path

CELL = {'scope_id': 'hpc-forest-primes-native-max-r2c', 'model': 'gpt-6-astra', 'effort': 'max', 'session_id': '979ef61f50d041639c1cd46e1942a3f3', 'source_sha256': 'ade344bfec4322e8aaecc99cfbf7bd502e6d39b55c62180e8f552a3d6391e680', 'plan_sha256': 'bac579fdb44850c636a6522c014175f95d4ce867bab502d86dd15c1bff31032e', 'runtime_sha256': '20802c1855c983954c2af5d21d336cc14e7b8964a1ab5d40aec38c6ba1c37c5d', 'source_members': 103, 'remote_extraction': '/scratch_p/nimarano/hpc-forest-primes-native-contract-qualification-20261018-r2c-b64b297c0d15/extraction', 'remote_root': '/scratch_p/nimarano/hpc-forest-primes-native-max-r2c-979ef61f50d041639c1cd46e1942a3f3', 'admission_root': '/scratch_p/nimarano/hpc-forest-primes-native-max-r2c-admission-979ef61f50d041639c1cd46e1942a3f3', 'source_zip_name': 'HPC-Forest-Primes-Natif-MAX-r2c.zip', 'cells': {'gpt-6-astra': '979ef61f50d041639c1cd46e1942a3f3', 'gpt-5.6-terra': 'a35692d6da3f46278fe3840f5c56984e', 'gpt-6.1-sol': '0fbe579c95f74ec7b90ebe702877434b'}, 'maximum_native_workers': 4}  # noqa: F821 - replaced as one literal, never imported locally
PYTHON = '/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python'
SPACK_GCC = '/zrtbeqke25s2vbqo4yrhsowjz7mg3pjf'
DEADLINE = datetime(2026, 10, 31, 23, tzinfo=UTC)


def require(ok, message):
    if not ok:
        raise RuntimeError(message)


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


env = os.environ
require(platform.system() == 'Linux' and platform.machine().lower() in {'aarch64', 'arm64'}, 'Own Linux ARM64 allocation required')
require(re.fullmatch('[0-9]+', env.get('SLURM_JOB_ID', '')), 'Actual Slurm job required')
required = {'SLURM_JOB_NUM_NODES': '1', 'SLURM_NTASKS': '1', 'SLURM_CPUS_PER_TASK': '4', 'SLURM_MEM_PER_NODE': '16384'}
require(all(env.get(k) == v for k, v in required.items()), 'Exact1node/1task/4CPU/16Gi allocation required')
require(env.get('SLURM_RESTART_COUNT', '0') == '0', 'Never replay a native attempt')
require(all(env.get(k, '') in {'', '0'} for k in ('SLURM_GPUS', 'SLURM_GPUS_PER_NODE', 'SLURM_JOB_GPUS', 'SLURM_STEP_GPUS', 'CUDA_VISIBLE_DEVICES')), 'Zero GPU required')
require(hasattr(os, 'sched_getaffinity') and len(os.sched_getaffinity(0)) == 4, 'Exactly four effective CPUs required')
require(datetime.now(UTC) + timedelta(seconds=21600) < DEADLINE, 'Exclusive deadline reserve insufficient')
require(Path(sys.executable).resolve() == Path(PYTHON).resolve(), 'Exact existing ARM64 Python required')
root, admission = Path(CELL['remote_root']), Path(CELL['admission_root'])
require(not root.exists() and not root.is_symlink(), 'Fresh selected native root required')
require(not admission.exists() and not admission.is_symlink(), 'Fresh selected admission root required')
extraction = Path(CELL['remote_extraction'])
source_zip = extraction / CELL['source_zip_name']
plan_path, runtime = extraction / 'native-max-plan.json', extraction / 'runtime-manifest-r2max.json'
for path, expected in ((source_zip, CELL['source_sha256']), (plan_path, CELL['plan_sha256']), (runtime, CELL['runtime_sha256'])):
    require(path.is_file() and not path.is_symlink() and sha(path) == expected, 'Changed qualified source/plan/runtime')
project = extraction / 'HPC-Forest'
expected = json.loads(runtime.read_bytes())
actual = {p.relative_to(project).as_posix(): p for p in project.rglob('*') if p.is_file()
          and not any(x in {'__pycache__', '.pytest_cache', '.ruff_cache'} for x in p.relative_to(project).parts)}
require(len(expected) == CELL['source_members'] and set(actual) == set(expected)
        and all(not p.is_symlink() and sha(p) == expected[n] for n, p in actual.items()), 'Exact new qualified runtime required')
with zipfile.ZipFile(source_zip) as archive:
    names = archive.namelist()
    require(len(names) == len(set(names)) == CELL['source_members'], 'Exact source ZIP membership required')
    require(all(n.startswith('HPC-Forest/') and n.removeprefix('HPC-Forest/') in actual
                and archive.read(n) == actual[n.removeprefix('HPC-Forest/')].read_bytes() for n in names), 'Source ZIP/runtime divergence')
plan = json.loads(plan_path.read_bytes())
require(plan.get('scope_id') == CELL['scope_id'] and plan.get('source_zip_sha256') == CELL['source_sha256']
        and plan.get('cells') == CELL['cells'] and plan.get('maximum_native_workers_total') == 4
        and plan.get('maximum_cells_per_authorization') == 1 and plan.get('efforts') == ['max']
        and plan.get('automatic_extension') is False and CELL['model'] in CELL['cells']
        and CELL['session_id'] == CELL['cells'][CELL['model']], 'Actual cap4 plan and selected closed MAX identity required')
sys.path.insert(0, str(project / 'src'))
from hpc_forest.native_r2max import allocation_guard, verify_runtime

allocation = allocation_guard()
verify_runtime(source_zip)
require(not root.exists() and not root.is_symlink(), 'Native root must remain absent before wait')
require(admission.parent == Path('/scratch_p/nimarano') and admission.name == CELL['scope_id'] + '-admission-' + CELL['session_id'], 'Exact selected admission directory required')
admission.mkdir(mode=0o700, exist_ok=False)
marker = {'schema': 'hpc-forest-max-cell-allocation-ready-v1', 'verified': True,
          'scope_id': CELL['scope_id'], 'model': CELL['model'], 'effort': 'max', 'session_id': CELL['session_id'],
          'job_id': allocation['job_id'], 'source_zip_sha256': CELL['source_sha256'], 'plan_sha256': CELL['plan_sha256'],
          'allocation': allocation, 'native_root': str(root), 'admission_root': str(admission),
          'native_root_absent_before_wait': True, 'native_model_calls': 0, 'source_files_verified': CELL['source_members'],
          'maximum_native_workers': 4, 'authorization_still_required': True, 'utc': datetime.now(UTC).isoformat()}
with (admission / 'allocation-ready.json').open('x', encoding='utf8') as stream:
    json.dump(marker, stream, sort_keys=True)
    stream.flush()
    os.fsync(stream.fileno())
print(json.dumps(marker), flush=True)
wait_argv = [PYTHON, '-I', '-B', '-u', str(project / 'examples/marathon22/wait_r2max_authorization.py'),
    '--root', str(root), '--authorization', str(admission / 'authorization.json'),
    '--authorization-ready', str(admission / 'authorization-ready.json'), '--wait-seconds', '600']
command = 'set -euo pipefail\nromeo_load_armgpu_env\nspack load ' + shlex.quote(SPACK_GCC) + '\nexec ' + shlex.join(wait_argv)
child = {**env, 'PYTHONDONTWRITEBYTECODE': '1', 'PYTHONUNBUFFERED': '1', 'OPENBLAS_NUM_THREADS': '1',
         'MKL_NUM_THREADS': '1', 'NUMEXPR_NUM_THREADS': '1', 'OMP_NUM_THREADS': '4', 'OMP_DYNAMIC': 'FALSE',
         'OMP_PROC_BIND': 'close', 'OMP_PLACES': 'cores', 'CUDA_VISIBLE_DEVICES': ''}
os.execvpe('/bin/bash', ['/bin/bash', '-lc', command], child)
ONE_SELECTED_MAX_CELL_PREFLIGHT

echo "[romeo-mcp] fin $(date -Is)"

/*
  Quicksort
*/
#include <stdio.h>
#include <stdlib.h>
#include <limits.h>
#include <openssl/md5.h>

#define MY_RAND_MAX 0x7FFFFFFF
#define RANDNUM_W 521288629
#define RANDNUM_Z 362436069
#define INSERTION_SORT_CUTOFF 32
#define PARALLEL_THRESHOLD 65536
#define TASK_GRAIN 16384

void srandnum(int seed);
double randnum(void);
int *generate_case(int N);
double drand(int xmin, int xmax);
void swap(int *toorder, int i, int j);
void quicksort(int *toorder, int N);
int is_sorted(int *toorder, int N);

static int median_of_three(int a, int b, int c);
static int partition(int *toorder, int lo, int hi);
static void insertion_sort(int *toorder, int lo, int hi);
static void sift_down(int *toorder, int lo, int root, int count);
static void heapsort(int *toorder, int lo, int hi);
static int depth_limit(int n);
static void introsort_serial(int *toorder, int lo, int hi, int depth);
static void introsort_parallel(int *toorder, int lo, int hi, int depth);

unsigned int randum_w = RANDNUM_W;
unsigned int randum_z = RANDNUM_Z;

void srandnum(int seed)
{
    unsigned int w, z;
    w = (seed * 104623) & 0xffffffff;
    randum_w = (w) ? w : RANDNUM_W;
    z = (seed * 48947) & 0xffffffff;
    randum_z = (z) ? z : RANDNUM_Z;
}

double randnum(void)
{
    unsigned int u;
    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);
    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);
    u = (randum_z << 16) + randum_w;
    return (abs(u));
}

int main(int argc, char *argv[])
{
    int N = 0;
    int *our_list = NULL;

    scanf("%d", &N);
    if (N <= 0) {
        printf("Error: please, provide the case size.\n");
        return 1;
    }

    our_list = generate_case(N);
    if (our_list == NULL) {
        printf("Error: case instantiation failed.\n");
        return 1;
    }

    quicksort(our_list, N);

    if (is_sorted(our_list, N) == 1) {
        printf("Error, for some reason list is still unsorted.\n");
        return 1;
    }

#ifdef COMPUTE_MD5_PROBLEM
    MD5_CTX c;
    unsigned char out[MD5_DIGEST_LENGTH];
    MD5_Init(&c);
    MD5_Update(&c, our_list, N * sizeof(int));
    MD5_Final(out, &c);
    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {
        printf("%02x", out[n]);
    }
#endif
    printf("\n");

    free(our_list);
    return 0;
}

void quicksort(int *toorder, int N)
{
    if (N <= 1)
        return;

    int depth = depth_limit(N);
    if (N >= PARALLEL_THRESHOLD) {
#pragma omp parallel
        {
#pragma omp single
            introsort_parallel(toorder, 0, N - 1, depth);
        }
    } else {
        introsort_serial(toorder, 0, N - 1, depth);
    }
}

static int median_of_three(int a, int b, int c)
{
    if (a < b) {
        if (b < c)
            return b;
        return (a < c) ? c : a;
    }
    if (a < c)
        return a;
    return (b < c) ? c : b;
}

static int partition(int *toorder, int lo, int hi)
{
    int mid = lo + (hi - lo) / 2;
    int pivot = median_of_three(toorder[lo], toorder[mid], toorder[hi]);
    int i = lo - 1;
    int j = hi + 1;

    for (;;) {
        do {
            ++i;
        } while (toorder[i] < pivot);
        do {
            --j;
        } while (toorder[j] > pivot);
        if (i >= j)
            return j;
        swap(toorder, i, j);
    }
}

static void insertion_sort(int *toorder, int lo, int hi)
{
    for (int i = lo + 1; i <= hi; ++i) {
        int value = toorder[i];
        int j = i;
        while (j > lo && toorder[j - 1] > value) {
            toorder[j] = toorder[j - 1];
            --j;
        }
        toorder[j] = value;
    }
}

static void sift_down(int *toorder, int lo, int root, int count)
{
    while (root <= (count - 2) / 2) {
        int child = root * 2 + 1;
        if (child + 1 < count && toorder[lo + child] < toorder[lo + child + 1])
            ++child;
        if (toorder[lo + root] >= toorder[lo + child])
            return;
        swap(toorder, lo + root, lo + child);
        root = child;
    }
}

static void heapsort(int *toorder, int lo, int hi)
{
    int count = hi - lo + 1;
    if (count <= 1)
        return;

    for (int start = count / 2; start > 0; --start)
        sift_down(toorder, lo, start - 1, count);
    for (int end = count - 1; end > 0; --end) {
        swap(toorder, lo, lo + end);
        sift_down(toorder, lo, 0, end);
    }
}

static int depth_limit(int n)
{
    int depth = 0;
    while (n > 1) {
        n >>= 1;
        depth += 2;
    }
    return depth;
}

static void introsort_serial(int *toorder, int lo, int hi, int depth)
{
    while (lo < hi) {
        int count = hi - lo + 1;
        if (count <= INSERTION_SORT_CUTOFF) {
            insertion_sort(toorder, lo, hi);
            return;
        }
        if (depth <= 0) {
            heapsort(toorder, lo, hi);
            return;
        }

        --depth;
        int boundary = partition(toorder, lo, hi);
        if (boundary - lo < hi - boundary) {
            introsort_serial(toorder, lo, boundary, depth);
            lo = boundary + 1;
        } else {
            introsort_serial(toorder, boundary + 1, hi, depth);
            hi = boundary;
        }
    }
}

static void introsort_parallel(int *toorder, int lo, int hi, int depth)
{
    int count = hi - lo + 1;
    if (count <= TASK_GRAIN) {
        introsort_serial(toorder, lo, hi, depth);
        return;
    }
    if (depth <= 0) {
        heapsort(toorder, lo, hi);
        return;
    }

    int boundary = partition(toorder, lo, hi);
    int next_depth = depth - 1;
    int left_count = boundary - lo + 1;
    int right_count = hi - boundary;

    if (left_count >= TASK_GRAIN && right_count >= TASK_GRAIN) {
        if (left_count >= right_count) {
#pragma omp task firstprivate(toorder, lo, boundary, next_depth)
            introsort_parallel(toorder, lo, boundary, next_depth);
            introsort_parallel(toorder, boundary + 1, hi, next_depth);
        } else {
#pragma omp task firstprivate(toorder, boundary, hi, next_depth)
            introsort_parallel(toorder, boundary + 1, hi, next_depth);
            introsort_parallel(toorder, lo, boundary, next_depth);
        }
#pragma omp taskwait
    } else if (left_count >= TASK_GRAIN) {
#pragma omp task firstprivate(toorder, lo, boundary, next_depth)
        introsort_parallel(toorder, lo, boundary, next_depth);
        introsort_serial(toorder, boundary + 1, hi, next_depth);
#pragma omp taskwait
    } else if (right_count >= TASK_GRAIN) {
#pragma omp task firstprivate(toorder, boundary, hi, next_depth)
        introsort_parallel(toorder, boundary + 1, hi, next_depth);
        introsort_serial(toorder, lo, boundary, next_depth);
#pragma omp taskwait
    } else {
        introsort_serial(toorder, lo, boundary, next_depth);
        introsort_serial(toorder, boundary + 1, hi, next_depth);
    }
}

void swap(int *toorder, int i, int j)
{
    int temp = toorder[i];
    toorder[i] = toorder[j];
    toorder[j] = temp;
}

int is_sorted(int *toorder, int N)
{
    for (int i = 1; i < N; i++) {
        if (toorder[i] < toorder[i - 1])
            return 1;
    }
    return 0;
}

int *generate_case(int N)
{
    int *ret = NULL;

    srandnum(0);
    ret = (int *) malloc(N * sizeof(int));
    if (ret == NULL) {
        printf("Error: some malloc won't work.\n");
        return NULL;
    }
    for (int i = 0; i < N; i++)
        ret[i] = drand(0, INT_MAX);
    return ret;
}

double drand(int xmin, int xmax)
{
    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;
}

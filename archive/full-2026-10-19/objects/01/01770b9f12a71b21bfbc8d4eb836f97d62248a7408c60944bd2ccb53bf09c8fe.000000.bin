      "content": "#include \"knn.h\"\n#include <limits.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\ntypedef struct {\n    size_t order;\n    float distance;\n    char label;\n} KnnNeighbor;\n\ntypedef struct {\n    KnnNeighbor *items;\n    size_t count;\n    size_t cursor;\n    size_t begin;\n    size_t length;\n    size_t first_point;\n    int first_group;\n} KnnPartition;\n\nstatic char knn_vote(const size_t *frequency) {\n    size_t maximum = 0;\n    char answer = (char)-1;\n\n    for (int label = CHAR_MIN; label <= CHAR_MAX; ++label) {\n        size_t count = frequency[(unsigned char)(char)label];\n        if (count > maximum) {\n            maximum = count;\n            answer = (char)label;\n        }\n    }\n    return answer;\n}\n\nstatic inline int knn_precedes(const KnnNeighbor *a, const KnnNeighbor *b) {\n    if (a->distance < b->distance) return 1;\n    if (a->distance > b->distance) return 0;\n    return a->order < b->order;\n}\n\nstatic inline void knn_sift_down(KnnNeighbor *heap, size_t count,\n                                 KnnNeighbor value) {\n    size_t position = 0;\n    size_t child = 1;\n\n    while (child < count) {\n        if (child + 1 < count &&\n            knn_precedes(&heap[child], &heap[child + 1])) {\n            ++child;\n        }\n        if (!knn_precedes(&value, &heap[child])) break;\n        heap[position] = heap[child];\n        position = child;\n        child = position * 2 + 1;\n    }\n    heap[position] = value;\n}\n\nstatic char knn_insertion_fallback(int n_groups, Group *groups, int k,\n                                    Point to_evaluate) {\n    char *labels = (char *)malloc(sizeof(char) * (size_t)k);\n    float *distances = (float *)malloc(sizeof(float) * (size_t)k);\n    size_t frequency[UCHAR_MAX + 1] = {0};\n\n    if (labels == NULL || distances == NULL) {\n        free(labels);\n        free(distances);\n        on_error();\n        return (char)-1;\n    }\n\n    for (int i = 0; i < k; ++i) {\n        labels[i] = (char)-1;\n        distances[i] = -1;\n    }\n\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; ++j) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (int x = 0; x < k; ++x) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (int y = k - 1; y > x; --y) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    for (int i = 0; i < k; ++i) {\n        ++frequency[(unsigned char)labels[i]];\n    }\n    free(distances);\n    free(labels);\n    return knn_vote(frequency);\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    size_t total = 0;\n    size_t frequency[UCHAR_MAX + 1] = {0};\n\n    if (k <= 0) return (char)-1;\n\n    for (int i = 0; i < n_groups; ++i) {\n        if (groups[i].length > 0) total += (size_t)groups[i].length;\n    }\n\n    /* If every point is selected, distance order cannot affect the vote. */\n    if ((size_t)k >= total) {\n        for (int i = 0; i < n_groups; ++i) {\n            if (groups[i].length > 0) {\n                frequency[(unsigned char)groups[i].label] +=\n                    (size_t)groups[i].length;\n            }\n        }\n        frequency[(unsigned char)(char)-1] += (size_t)k - total;\n        return knn_vote(frequency);\n    }\n\n    int partitions = 1;\n#ifdef _OPENMP\n    partitions = omp_get_max_threads();\n    if (partitions < 1) partitions = 1;\n#endif\n    size_t useful_partitions = total / 4096;\n    if (useful_partitions == 0) useful_partitions = 1;\n    if ((size_t)partitions > useful_partitions) {\n        partitions = (int)useful_partitions;\n    }\n\n    KnnPartition *parts = (KnnPartition *)calloc((size_t)partitions,\n                                                sizeof(KnnPartition));\n    if (parts == NULL) {\n        return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t base = total / (size_t)partitions;\n    size_t extra = total % (size_t)partitions;\n    size_t group_begin = 0;\n    int group_index = 0;\n\n    /* Balance by point count, including when one group dominates the input. */\n    for (int p = 0; p < partitions; ++p) {\n        size_t prefix_extra = (size_t)p < extra ? (size_t)p : extra;\n        size_t begin = base * (size_t)p + prefix_extra;\n\n        while (group_index < n_groups) {\n            size_t length = groups[group_index].length > 0\n                                ? (size_t)groups[group_index].length : 0;\n            if (begin - group_begin < length) break;\n            group_begin += length;\n            ++group_index;\n        }\n\n        parts[p].begin = begin;\n        parts[p].length = base + ((size_t)p < extra);\n        parts[p].first_group = group_index;\n        parts[p].first_point = begin - group_begin;\n    }\n\n    int allocation_failed = 0;\n    int unordered_distance = 0;\n#ifdef _OPENMP\n#pragma omp parallel for schedule(static) num_threads(partitions) if(partitions > 1) reduction(|:allocation_failed, unordered_distance)\n#endif\n    for (int p = 0; p < partitions; ++p) {\n        size_t capacity = parts[p].length < (size_t)k\n                              ? parts[p].length : (size_t)k;\n        KnnNeighbor *heap = (KnnNeighbor *)malloc(capacity * sizeof(KnnNeighbor));\n        parts[p].items = heap;\n        if (heap == NULL) {\n            allocation_failed = 1;\n            continue;\n        }\n\n        size_t count = 0;\n        size_t remaining = parts[p].length;\n        size_t order = parts[p].begin;\n        size_t point_index = parts[p].first_point;\n        int current_group = parts[p].first_group;\n\n        while (remaining > 0 && current_group < n_groups) {\n            Group *group = &groups[current_group];\n            size_t length = group->length > 0 ? (size_t)group->length : 0;\n            size_t take = length - point_index;\n            if (take > remaining) take = remaining;\n\n            for (size_t j = 0; j < take; ++j) {\n                float d = euclidean_distance_no_sqrt(\n                    to_evaluate, group->points[point_index + j]);\n                if (d != d) {\n                    unordered_distance = 1;\n                    continue;\n                }\n\n                KnnNeighbor candidate;\n                candidate.order = order + j;\n                candidate.distance = d;\n                candidate.label = group->label;\n\n                if (count < capacity) {\n                    size_t position = count++;\n                    while (position > 0) {\n                        size_t parent = (position - 1) / 2;\n                        if (!knn_precedes(&heap[parent], &candidate)) break;\n                        heap[position] = heap[parent];\n                        position = parent;\n                    }\n                    heap[position] = candidate;\n                } else if (knn_precedes(&candidate, &heap[0])) {\n                    knn_sift_down(heap, count, candidate);\n                }\n            }\n\n            remaining -= take;\n            order += take;\n            ++current_group;\n            point_index = 0;\n        }\n\n        if (partitions > 1) {\n            for (size_t end = count; end > 1;) {\n                KnnNeighbor value = heap[end - 1];\n                heap[end - 1] = heap[0];\n                --end;\n                knn_sift_down(heap, end, value);\n            }\n        }\n        parts[p].count = count;\n    }\n\n    /* NaNs require the original, non-total-order insertion semantics. */\n    if (allocation_failed || unordered_distance) {\n        for (int p = 0; p < partitions; ++p) free(parts[p].items);\n        free(parts);\n        return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t selected = 0;\n    if (partitions == 1) {\n        for (size_t i = 0; i < parts[0].count; ++i) {\n            ++frequency[(unsigned char)parts[0].items[i].label];\n        }\n        selected = parts[0].count;\n    } else {\n        for (; selected < (size_t)k; ++selected) {\n            int best = -1;\n            for (int p = 0; p < partitions; ++p) {\n                if (parts[p].cursor == parts[p].count) continue;\n                if (best < 0 ||\n                    knn_precedes(&parts[p].items[parts[p].cursor],\n                                 &parts[best].items[parts[best].cursor])) {\n                    best = p;\n                }\n            }\n            if (best < 0) break;\n            KnnNeighbor *next = &parts[best].items[parts[best].cursor++];\n            ++frequency[(unsigned char)next->label];\n        }\n    }\n    frequency[(unsigned char)(char)-1] += (size_t)k - selected;\n\n    for (int p = 0; p < partitions; ++p) free(parts[p].items);\n    free(parts);\n    return knn_vote(frequency);\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Balanced OpenMP point partitions with private bounded max-heaps should eliminate the baseline's O(Nk) scan while keeping selection deterministic across four ARM64 cores.",
  "notes": "Parsing and distance arithmetic remain unchanged. Equal-distance encounter order, character-order voting ties, and unfilled slots are preserved; NaNs use the original insertion semantics. No execution performed.",

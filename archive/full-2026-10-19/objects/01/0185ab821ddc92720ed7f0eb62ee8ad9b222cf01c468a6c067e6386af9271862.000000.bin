#include "knn.h"
#include <arm_neon.h>
#include <omp.h>
#include <float.h>

// Max-heap node (1-indexed) with global index for deterministic tie-breaking
typedef struct {
    float dist;
    char label;
    int idx;   // global point order index
} HeapNode;

static inline void heap_swap(HeapNode *a, HeapNode *b) {
    HeapNode t = *a; *a = *b; *b = t;
}

// Compare two nodes: return >0 if a is worse (larger dist or equal dist but larger idx)
static inline int heap_node_worse(HeapNode *a, HeapNode *b) {
    if (a->dist != b->dist)
        return (a->dist > b->dist) ? 1 : -1;
    // distances equal: smaller index is better
    return (a->idx > b->idx) ? 1 : -1;
}

// Sift down from index idx in a max-heap of size heap_size (1-indexed)
static inline void sift_down(HeapNode *heap, int heap_size, int idx) {
    while (1) {
        int largest = idx;
        int left = 2 * idx;
        int right = 2 * idx + 1;
        if (left <= heap_size && heap_node_worse(&heap[left], &heap[largest]) > 0)
            largest = left;
        if (right <= heap_size && heap_node_worse(&heap[right], &heap[largest]) > 0)
            largest = right;
        if (largest == idx) break;
        heap_swap(&heap[idx], &heap[largest]);
        idx = largest;
    }
}

// Insert or replace in a max-heap of capacity k.
static inline void heap_insert_or_replace(float d, char label, int global_idx,
                                          HeapNode *heap, int *heap_size_ptr, int k) {
    int hs = *heap_size_ptr;
    if (hs < k) {
        // Insert at end and bubble up
        hs++;
        int idx = hs;
        heap[idx].dist = d;
        heap[idx].label = label;
        heap[idx].idx = global_idx;
        while (idx > 1 && heap_node_worse(&heap[idx / 2], &heap[idx]) < 0) {
            heap_swap(&heap[idx], &heap[idx / 2]);
            idx /= 2;
        }
    } else if (d < heap[1].dist || (d == heap[1].dist && global_idx < heap[1].idx)) {
        // Replace root
        heap[1].dist = d;
        heap[1].label = label;
        heap[1].idx = global_idx;
        sift_down(heap, k, 1);
    }
    *heap_size_ptr = hs;
}

char knn(int n_groups, Group *groups, int k, Point to_evaluate) {
    // Precompute cumulative start index for each group (global point order)
    int *start_idx = (int *)malloc(n_groups * sizeof(int));
    int total_points = 0;
    for (int i = 0; i < n_groups; i++) {
        start_idx[i] = total_points;
        total_points += groups[i].length;
    }

    // Determine number of threads once
    int max_threads = omp_get_max_threads();
    if (max_threads < 1) max_threads = 1;

    // Per-thread heaps: each thread gets a heap array of size k+1 and its current size.
    HeapNode **thread_heaps = (HeapNode**) malloc(max_threads * sizeof(HeapNode*));
    int *thread_sizes = (int*) calloc(max_threads, sizeof(int));

    for (int t = 0; t < max_threads; t++) {
        thread_heaps[t] = (HeapNode*) malloc((k + 1) * sizeof(HeapNode));
        // Initialize with sentinel values: large distance and invalid label.
        for (int i = 1; i <= k; i++) {
            thread_heaps[t][i].dist = FLT_MAX;
            thread_heaps[t][i].label = -1;
            thread_heaps[t][i].idx = -1;
        }
    }

    #pragma omp parallel
    {
        int tid = omp_get_thread_num();
        HeapNode *local_heap = thread_heaps[tid];
        int local_size = 0;   // accumulates across all groups assigned to this thread

        #pragma omp for schedule(guided)
        for (int gi = 0; gi < n_groups; gi++) {
            Group g = groups[gi];
            float *xs = g.xs;
            float *ys = g.ys;
            int len = g.length;
            char label = g.label;
            int base_idx = start_idx[gi];

            // Alignment hints for SIMD loads (aligned to 16 and 32 bytes respectively)
            float * restrict xs_aligned = (float *)__builtin_assume_aligned(xs, 64);
            float * restrict ys_aligned = (float *)__builtin_assume_aligned(ys, 128);

            // Process points in batches of 4 using NEON SIMD
            int j = 0;
            for (; j + 3 < len; j += 4) {
                __builtin_prefetch(xs_aligned + j + 16);
                __builtin_prefetch(ys_aligned + j + 8);

                float32x4_t x_vec = vld1q_f32(xs_aligned + j);
                float32x4_t y_vec = vld1q_f32(ys_aligned + j);

                float tx = to_evaluate.x;
                float ty = to_evaluate.y;
                float32x4_t dx = vsubq_f32(x_vec, vdupq_n_f32(tx));
                float32x4_t dy = vsubq_f32(y_vec, vdupq_n_f32(ty));
                // dist_sq = dx*dx + dy*dy
                float32x4_t dist_sq = vmlaq_f32(vmulq_f32(dx, dx), dy, dy);

                float d[4];
                vst1q_f32(d, dist_sq);

                for (int t = 0; t < 4; t++) {
                    int global_idx = base_idx + j + t;
                    heap_insert_or_replace(d[t], label, global_idx,
                                           local_heap, &local_size, k);
                }
            }

            // Scalar remainder
            for (; j < len; j++) {
                Point p;
                p.x = xs_aligned[j];
                p.y = ys_aligned[j];
                float d = euclidean_distance_no_sqrt(to_evaluate, p);
                int global_idx = base_idx + j;
                heap_insert_or_replace(d, label, global_idx,
                                       local_heap, &local_size, k);
            }
        }

        thread_sizes[tid] = local_size;
    } // implicit barrier ensures all threads finished and sizes are set

    free(start_idx);

    // Global max-heap to merge per-thread results
    HeapNode *global_heap = (HeapNode*) malloc((k + 1) * sizeof(HeapNode));
    for (int i = 1; i <= k; i++) {
        global_heap[i].dist = FLT_MAX;
        global_heap[i].label = -1;
        global_heap[i].idx = -1;
    }
    int global_size = 0;

    // Merge all per-thread heaps into the global heap
    for (int t = 0; t < max_threads; t++) {
        HeapNode *local = thread_heaps[t];
        int sz = thread_sizes[t];
        if (sz > k) sz = k;
        for (int i = 1; i <= sz; i++) {
            heap_insert_or_replace(local[i].dist, local[i].label, local[i].idx,
                                   global_heap, &global_size, k);
        }
    }

    // Extract labels from the final global heap into a plain array for frequency counting.
    char *labels = (char*) malloc(k * sizeof(char));
    int actual_k = (global_size < k) ? global_size : k;
    for (int i = 0; i < actual_k; i++) {
        labels[i] = global_heap[i + 1].label;
    }
    // Fill remaining with -1 if not enough points
    for (int i = actual_k; i < k; i++) {
        labels[i] = -1;
    }

    free(global_heap);
    for (int t = 0; t < max_threads; t++) {
        free(thread_heaps[t]);
    }
    free(thread_heaps);
    free(thread_sizes);

    // Find most frequent label using frequency array (O(k + 256))
    int freq[256] = {0};
    for (int i = 0; i < k; i++) {
        if (labels[i] >= 0)
            freq[(unsigned char)labels[i]]++;
    }

    // Deterministic tie-breaking: pick smallest label with maximum count
    char best_label = labels[0];
    int best_count = freq[(unsigned char)best_label];
    for (int c = 1; c < 256; c++) {
        if (freq[c] > best_count) {
            best_count = freq[c];
            best_label = (char)c;
        }
    }

    free(labels);
    return best_label;
}

int main() {
    int n_groups = parse_number_of_groups();

    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; ++i) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();
    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

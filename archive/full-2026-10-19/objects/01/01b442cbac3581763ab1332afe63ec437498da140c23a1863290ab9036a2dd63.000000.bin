{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include <iostream>\\n#include <vector>\\n#include <utility>\\n#include <cstddef>\\n\\nusing namespace std;\\n\\nclass adjacency_matrix {\\n    size_t vertices_;\\n    vector<unsigned char> cells_;\\n\\npublic:\\n    explicit adjacency_matrix(size_t vertices)\\n        : vertices_(vertices), cells_(vertices * vertices, 0) {}\\n\\n    size_t size() const {\\n        return vertices_;\\n    }\\n\\n    unsigned char *operator[](size_t row) {\\n        return cells_.data() + row * vertices_;\\n    }\\n\\n    const unsigned char *operator[](size_t row) const {\\n        return cells_.data() + row * vertices_;\\n    }\\n};\\n\\nadjacency_matrix readGraph();\\n\\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence);\\ninline void printPermutation(vector<int> &equivalence);\\n\\nint main(){\\n    adjacency_matrix g1 = readGraph();\\n    adjacency_matrix g2 = readGraph();\\n\\n    if(!testIsomorphism(g1, g2))\\n        cout << \\\"The graphs are not isomorphic\\\" << endl;\\n\\n    return 0;\\n}\\n\\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\\n    vector<int> equivalence(g1.size(), 0);\\n    vector<int> exchange_counter(g1.size(), 0);\\n    int exchange_index = 1;\\n    bool isomorphism_found = false;\\n\\n    if(g1.size() != g2.size()) return false;\\n\\n    for(int i = 0; i < equivalence.size(); ++i)\\n        equivalence[i] = i;\\n\\n    if(verifyPermutation(g1, g2, equivalence)){\\n        printPermutation(equivalence);\\n        return true;\\n    }\\n    \\n    /*\\n     * Permutations are based on Heap's algorithm, which generates all possible\\n     * permutations for a given set of elements.\\n     */\\n    while(exchange_index < g1.size()){\\n        if(exchange_counter[exchange_index] < exchange_index){\\n            if(exchange_index % 2 == 0)\\n                swap(equivalence[0], equivalence[exchange_index]);\\n            else\\n                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\\n            if(verifyPermutation(g1, g2, equivalence)){\\n                printPermutation(equivalence);\\n                isomorphism_found = true;\\n            }\\n\\n            exchange_counter[exchange_index]++;\\n            exchange_index = 1;\\n        }else{\\n            exchange_counter[exchange_index] = 0;\\n            exchange_index++;\\n        }\\n    }\\n    return isomorphism_found;\\n}\\n\\nadjacency_matrix readGraph(){\\n    int vertices, edges, source, destination;\\n\\n    cin >> vertices;\\n    adjacency_matrix read(vertices);\\n\\n    cin >> edges;\\n    for (int i = 0; i < edges; i++) {\\n       cin >> source >> destination;\\n       read[destination][source] = read[source][destination] = true;\\n    }\\n\\n    return read;\\n}\\n\\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence){\\n    for (int i = 0; i < equivalence.size(); ++i) {\\n        const unsigned char *row1 = g1[i];\\n        const unsigned char *row2 = g2[equivalence[i]];\\n        for (int j = 0; j <= i; ++j) {\\n            if(row1[j] != row2[equivalence[j]]) return false;\\n        }\\n    }\\n    return true;\\n}\\n\\ninline void printPermutation(vector<int> &equivalence){\\n    for (auto i : equivalence)\\n        cout << i << \\\" \\\";\\n    cout << endl;\\n}\\n\",\n      \"path\": \"src/brute_isomorphism.cpp\"\n    }\n  ],\n  \"hypothesis\": \"Contiguous byte adjacency matrices should reduce allocation, pointer-chasing, and packed-bit extraction costs during permutation verification. For the specified sizes, both matrices occupy less than 20 KB.\",\n  \"notes\": \"Preserves the vertex-count check, identity fast path, complete Heap-order output, self-loops, and duplicate-edge collapse. No commands or measurements performed.\",\n  \"research\": {\n    \"queries\": [],\n    \"urls\": []\n  },\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Replace separately allocated vector<bool> rows with one contiguous row-major byte buffer per graph.\",\n    \"Cache both row pointers outside the inner verification loop, preserving comparison order and early rejection.\"\n  ]\n}"}}

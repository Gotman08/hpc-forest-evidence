        "content": "#define _POSIX_C_SOURCE 200809L\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n#include <limits.h>\n#include <ctype.h>\n\n/* Compact query-time state, separate from temporary adjacency storage. */\ntypedef struct {\n  float value;\n  float total;\n  int next;\n  unsigned char ready;\n} Node;\n\ntypedef struct {\n  int id;\n  int row_plus_one;\n} IdSlot;\n\ntypedef struct {\n  Node *nodes;\n  IdSlot *index;\n  size_t mask;\n  int *stack;\n} Graph;\n\nstatic void fail(void) {\n  fprintf(stderr, \"Error!\\n\");\n  exit(1);\n}\n\nstatic void *allocate_array(size_t count, size_t width) {\n  if (count == 0)\n    return NULL;\n  if (count > SIZE_MAX / width)\n    fail();\n  void *p = malloc(count * width);\n  if (p == NULL)\n    fail();\n  return p;\n}\n\nstatic void *resize_array(void *old, size_t count, size_t width) {\n  if (count > SIZE_MAX / width)\n    fail();\n  void *p = realloc(old, count * width);\n  if (p == NULL)\n    fail();\n  return p;\n}\n\nstatic size_t hash_id(int id) {\n  uint32_t x = (uint32_t)id;\n  x ^= x >> 16;\n  x *= 0x7feb352dU;\n  x ^= x >> 15;\n  x *= 0x846ca68bU;\n  x ^= x >> 16;\n  return (size_t)x;\n}\n\nstatic int find_by_id(const Graph *g, int id) {\n  size_t slot = hash_id(id) & g->mask;\n  while (g->index[slot].row_plus_one != 0) {\n    if (g->index[slot].id == id)\n      return g->index[slot].row_plus_one - 1;\n    slot = (slot + 1) & g->mask;\n  }\n  return -1;\n}\n\nstatic void insert_id(Graph *g, int id, int row) {\n  size_t slot = hash_id(id) & g->mask;\n  while (g->index[slot].row_plus_one != 0) {\n    /* Linear lookup in the original selects the first matching row. */\n    if (g->index[slot].id == id)\n      return;\n    slot = (slot + 1) & g->mask;\n  }\n  g->index[slot].id = id;\n  g->index[slot].row_plus_one = row + 1;\n}\n\nstatic int read_record(char **line, size_t *capacity) {\n  for (;;) {\n    if (getline(line, capacity, stdin) < 0)\n      return 0;\n    size_t length = strlen(*line);\n    if (length != 0 && (*line)[length - 1] == '\\n')\n      (*line)[length - 1] = '\\0';\n    char *p = *line;\n    while (isspace((unsigned char)*p))\n      ++p;\n    if (*p != '\\0')\n      return 1;\n  }\n}\n\nstatic char *read_input(Graph *g) {\n  char *line = NULL;\n  size_t line_capacity = 0;\n  if (!read_record(&line, &line_capacity))\n    fail();\n\n  char *p;\n  long count = strtol(line, &p, 10);\n  if (p == line || count < 0 || count > INT_MAX)\n    fail();\n  int n = (int)count;\n  while (isspace((unsigned char)*p))\n    ++p;\n  size_t query_length = strlen(p);\n  char *queries = allocate_array(query_length + 1, sizeof(char));\n  memcpy(queries, p, query_length + 1);\n\n  if ((size_t)n > SIZE_MAX / 2)\n    fail();\n  size_t table_size = 1;\n  size_t required = (size_t)n * 2;\n  while (table_size < required) {\n    if (table_size > SIZE_MAX / 2)\n      fail();\n    table_size *= 2;\n  }\n  g->mask = table_size - 1;\n  g->index = allocate_array(table_size, sizeof(*g->index));\n  memset(g->index, 0, table_size * sizeof(*g->index));\n  g->nodes = allocate_array((size_t)n, sizeof(*g->nodes));\n  g->stack = allocate_array((size_t)n, sizeof(*g->stack));\n\n  size_t *offsets = allocate_array((size_t)n + 1, sizeof(*offsets));\n  int *neighbors = NULL;\n  size_t neighbor_count = 0;\n  size_t neighbor_capacity = 0;\n\n  for (int i = 0; i < n; ++i) {\n    if (!read_record(&line, &line_capacity))\n      fail();\n    char *after_id;\n    long id = strtol(line, &after_id, 10);\n    if (after_id == line || id < INT_MIN || id > INT_MAX)\n      fail();\n    float value = strtof(after_id, &p);\n    if (p == after_id)\n      fail();\n\n    g->nodes[i].value = value;\n    g->nodes[i].total = 0.0f;\n    g->nodes[i].next = -1;\n    g->nodes[i].ready = 0;\n    insert_id(g, (int)id, i);\n    offsets[i] = neighbor_count;\n\n    while (isspace((unsigned char)*p))\n      ++p;\n    while (*p != '\\0') {\n      while (*p == ' ')\n        ++p;\n      if (*p == '\\0')\n        break;\n      if (neighbor_count == neighbor_capacity) {\n        if (neighbor_capacity > SIZE_MAX / 2)\n          fail();\n        size_t new_capacity = neighbor_capacity ? neighbor_capacity * 2 : 256;\n        neighbors = resize_array(neighbors, new_capacity, sizeof(*neighbors));\n        neighbor_capacity = new_capacity;\n      }\n      /* Preserve the original space-only tokenization and atoi behavior. */\n      neighbors[neighbor_count++] = atoi(p);\n      while (*p != '\\0' && *p != ' ')\n        ++p;\n    }\n  }\n  offsets[n] = neighbor_count;\n  free(line);\n  fclose(stdin);\n\n  for (int i = 0; i < n; ++i) {\n    float maximum = 0.0f;\n    int next = -1;\n    for (size_t j = offsets[i]; j < offsets[i + 1]; ++j) {\n      int id = neighbors[j];\n      int row = find_by_id(g, id);\n      if (row >= 0 && maximum < g->nodes[row].value) {\n        maximum = g->nodes[row].value;\n        /* ID -1 can win the comparison but still stops recursion. */\n        next = id == -1 ? -1 : row;\n      }\n    }\n    g->nodes[i].next = next;\n  }\n\n  free(neighbors);\n  free(offsets);\n  return queries;\n}\n\nstatic float get_costly(Graph *g, int id) {\n  int root = find_by_id(g, id);\n  if (root < 0)\n    return 0.0f;\n\n  size_t depth = 0;\n  int row = root;\n  /* The input is a DAG, so an unresolved chain contains at most n rows. */\n  while (row >= 0 && !g->nodes[row].ready) {\n    g->stack[depth++] = row;\n    row = g->nodes[row].next;\n  }\n\n  while (depth != 0) {\n    row = g->stack[--depth];\n    float result = g->nodes[row].value;\n    int next = g->nodes[row].next;\n    /* Do not add zero to terminal values; preserve each recursive addition. */\n    if (next >= 0)\n      result += g->nodes[next].total;\n    g->nodes[row].total = result;\n    g->nodes[row].ready = 1;\n  }\n  return g->nodes[root].total;\n}\n\nint main(void) {\n  Graph graph = {0};\n  char *computelist = read_input(&graph);\n\n  for (char *c = strtok(computelist, \" \"); c != NULL; c = strtok(NULL, \" \"))\n    printf(\"%s: %f\\n\", c, get_costly(&graph, atoi(c)));\n\n  free(computelist);\n  free(graph.stack);\n  free(graph.index);\n  free(graph.nodes);\n  return 0;\n}\n",

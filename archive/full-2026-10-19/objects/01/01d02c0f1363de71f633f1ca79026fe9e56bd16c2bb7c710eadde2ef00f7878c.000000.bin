    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <iostream>\\n#include <vector>\\n#include <algorithm>\\n#include <climits>\\n#include <cstdio>\\n\\nclass FastScanner {\\n    static const int BUFSIZE = 1 << 20;\\n    char buf[BUFSIZE];\\n    int idx, size;\\npublic:\\n    FastScanner() : idx(0), size(0) {}\\n    inline char getChar() {\\n        if (idx >= size) {\\n            size = fread(buf, 1, BUFSIZE, stdin);\\n            idx = 0;\\n            if (size == 0) return 0;\\n        }\\n        return buf[idx++];\\n    }\\n    template<typename T>\\n    bool readInt(T& out) {\\n        char c;\\n        T sign = 1;\\n        T num = 0;\\n        c = getChar();\\n        if (!c) return false;\\n        while (c != '-' && (c < '0' || c > '9')) {\\n            c = getChar();\\n            if (!c) return false;\\n        }\\n        if (c == '-') { sign = -1; c = getChar(); }\\n        for (; c >= '0' && c <= '9'; c = getChar()) {\\n            num = num * 10 + (c - '0');\\n        }\\n        out = num * sign;\\n        return true;\\n    }\\n};\\n\\nint main() {\\n    FastScanner fs;\\n    int n, s;\\n    if (!fs.readInt(n)) return 0;\\n    fs.readInt(s);\\n\\n    const int W = n + 1;\\n    std::vector<long long> pref((n + 1) * (n + 1), 0LL);\\n\\n    for (int i = 0; i < n; ++i) {\\n        long long row_sum = 0;\\n        for (int j = 0; j < n; ++j) {\\n            int x;\\n            fs.readInt(x);\\n            row_sum += x;\\n            pref[(i + 1) * W + (j + 1)] = pref[i * W + (j + 1)] + row_sum;\\n        }\\n    }\\n\\n    long long mxSum = LLONG_MIN;\\n    const int limit_i = n - s + 1;\\n\\n    #pragma omp parallel for reduction(max:mxSum) schedule(static)\\n    for (int i = 0; i < limit_i; ++i) {\\n        const long long* __restrict__ row_pref = &pref[i * W];\\n        const long long* __restrict__ bottom_pref = &pref[(i + s) * W];\\n        #pragma omp simd reduction(max:mxSum)\\n        for (int j = 0; j < limit_i; ++j) {\\n  
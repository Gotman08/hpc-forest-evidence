#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_K 256

typedef struct {
    float x;
    float y;
} Point;

void on_error() {
    printf("Invalid input file.\n");
    exit(1);
}

int parse_number_of_groups() {
    int n;
    if (scanf(" n_groups=%d ", &n) != 1) on_error();
    return n;
}

Point parse_point() {
    float x, y;
    if (scanf(" (%f ,%f) ", &x, &y) != 2) on_error();
    Point point = {x, y};
    return point;
}

float euclidean_distance_no_sqrt(Point a, Point b) {
    float dx = b.x - a.x;
    float dy = b.y - a.y;
    return dx * dx + dy * dy;
}

// Reads all input and returns total number of points.
// Allocates flat arrays for x, y, labels. Also reads k and to_evaluate point.
int read_input(float **xs_out, float **ys_out, char **labels_out,
               int *k_out, Point *to_evaluate) {
    int n_groups = parse_number_of_groups();

    size_t cap = 1024;
    size_t count = 0;
    float *xs = (float *)malloc(cap * sizeof(float));
    float *ys = (float *)malloc(cap * sizeof(float));
    char *labels = (char *)malloc(cap * sizeof(char));
    if (!xs || !ys || !labels) on_error();

    for (int g = 0; g < n_groups; g++) {
        char label;
        int length;
        if (scanf(" label=%c ", &label) != 1) on_error();
        if (scanf(" length=%d ", &length) != 1) on_error();

        for (int p = 0; p < length; p++) {
            float x, y;
            if (scanf(" (%f ,%f) ", &x, &y) != 2) on_error();

            // Ensure capacity
            if (count >= cap) {
                cap *= 2;
                xs = (float *)realloc(xs, cap * sizeof(float));
                ys = (float *)realloc(ys, cap * sizeof(float));
                labels = (char *)realloc(labels, cap * sizeof(char));
                if (!xs || !ys || !labels) on_error();
            }

            xs[count] = x;
            ys[count] = y;
            labels[count] = label;
            count++;
        }
    }

    // Read k and the point to evaluate
    if (scanf(" k=%d ", k_out) != 1) on_error();
    *to_evaluate = parse_point();

    *xs_out = xs;
    *ys_out = ys;
    *labels_out = labels;

    return (int)count;
}

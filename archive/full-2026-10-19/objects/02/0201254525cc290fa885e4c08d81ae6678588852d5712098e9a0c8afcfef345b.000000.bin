/*
 * Parallel integer sorting for the quicksort benchmark.
 */
#include <stdio.h>
#include <stdlib.h>
#include <limits.h>
#include <stddef.h>
#include <string.h>
#include <openssl/md5.h>

#ifdef _OPENMP
#include <omp.h>
#endif

void srandnum(int seed);
double randnum(void);
int *generate_case(int N);
double drand(int xmin, int xmax);
void quicksort(int *toorder, int N);
int is_sorted(int *toorder, int N);

#define MY_RAND_MAX 0x7FFFFFFF
#define RANDNUM_W 521288629
#define RANDNUM_Z 362436069

unsigned int randum_w = RANDNUM_W;
unsigned int randum_z = RANDNUM_Z;

void srandnum(int seed)
{
    unsigned int w, z;
    w = (seed * 104623) & 0xffffffff;
    randum_w = (w) ? w : RANDNUM_W;
    z = (seed * 48947) & 0xffffffff;
    randum_z = (z) ? z : RANDNUM_Z;
}

double randnum(void)
{
    unsigned int u;
    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);
    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);
    u = (randum_z << 16) + randum_w;
    return (abs(u));
}

static int compare_ints(const void *left, const void *right)
{
    int a = *(const int *)left;
    int b = *(const int *)right;
    return (a > b) - (a < b);
}

#ifdef _OPENMP
#define RADIX_BITS 16
#define RADIX_BUCKETS (1u << RADIX_BITS)
#define RADIX_PASSES 2
#define PARALLEL_THRESHOLD (1 << 15)

/*
 * Each thread owns a complete histogram row.  This keeps histogram updates
 * private while the prefix phase assigns a disjoint output range to every
 * thread for every radix value.
 */
static int parallel_radix_sort(int *values, int count)
{
    int requested_threads = omp_get_max_threads();
    size_t slots;
    int *workspace;
    unsigned int *positions;
    int *source;
    int *target;
    int active_threads = 1;

    if (requested_threads < 2)
        return 0;
    if (requested_threads > count)
        requested_threads = count;
    if (requested_threads < 2)
        return 0;

    if ((size_t)count > (size_t)-1 / sizeof(*workspace))
        return 0;
    if ((size_t)requested_threads > (size_t)-1 / RADIX_BUCKETS)
        return 0;
    slots = (size_t)requested_threads * RADIX_BUCKETS;
    if (slots > (size_t)-1 / sizeof(*positions))
        return 0;

    workspace = (int *)malloc((size_t)count * sizeof(*workspace));
    positions = (unsigned int *)malloc(slots * sizeof(*positions));
    if (workspace == NULL || positions == NULL) {
        free(workspace);
        free(positions);
        return 0;
    }

    source = values;
    target = workspace;

#pragma omp parallel num_threads(requested_threads) default(none) shared(source, target, positions, count, active_threads)
    {
        int thread_id = omp_get_thread_num();

#pragma omp single
        {
            active_threads = omp_get_num_threads();
        }

        for (int pass = 0; pass < RADIX_PASSES; ++pass) {
            int shift = pass * RADIX_BITS;
            size_t first = ((size_t)thread_id * (size_t)count) / (size_t)active_threads;
            size_t last = ((size_t)(thread_id + 1) * (size_t)count) / (size_t)active_threads;
            unsigned int *local_positions = positions + (size_t)thread_id * RADIX_BUCKETS;

            memset(local_positions, 0, (size_t)RADIX_BUCKETS * sizeof(*local_positions));
            for (size_t i = first; i < last; ++i) {
                unsigned int key = (((unsigned int)source[i]) ^ 0x80000000u) >> shift;
                ++local_positions[key];
            }

#pragma omp barrier
#pragma omp single
            {
                size_t next = 0;
                for (unsigned int key = 0; key < RADIX_BUCKETS; ++key) {
                    for (int thread = 0; thread < active_threads; ++thread) {
                        unsigned int *position = positions + (size_t)thread * RADIX_BUCKETS + key;
                        unsigned int amount = *position;
                        *position = (unsigned int)next;
                        next += amount;
                    }
                }
            }

            for (size_t i = first; i < last; ++i) {
                int value = source[i];
                unsigned int key = (((unsigned int)value) ^ 0x80000000u) >> shift;
                target[local_positions[key]++] = value;
            }

#pragma omp barrier
#pragma omp single
            {
                int *temporary = source;
                source = target;
                target = temporary;
            }
        }
    }

    free(positions);
    free(workspace);
    return 1;
}
#endif

void quicksort(int *toorder, int N)
{
    if (N < 2)
        return;

#ifdef _OPENMP
    if (N >= PARALLEL_THRESHOLD && parallel_radix_sort(toorder, N))
        return;
#endif

    qsort(toorder, (size_t)N, sizeof(*toorder), compare_ints);
}

int main(int argc, char *argv[])
{
    int N = 0;
    int *our_list = NULL;

    scanf("%d", &N);
    if (N <= 0) {
        printf("Error: please, provide the case size.\n");
        return 1;
    }

    our_list = generate_case(N);
    if (our_list == NULL) {
        printf("Error: case instantiation failed.\n");
        return 1;
    }

    quicksort(our_list, N);

    if (is_sorted(our_list, N) == 1) {
        printf("Error, for some reason list is still unsorted.\n");
        free(our_list);
        return 1;
    }

#ifdef COMPUTE_MD5_PROBLEM
    {
        MD5_CTX c;
        unsigned char out[MD5_DIGEST_LENGTH];
        MD5_Init(&c);
        MD5_Update(&c, our_list, (size_t)N * sizeof(int));
        MD5_Final(out, &c);
        for (int n = 0; n < MD5_DIGEST_LENGTH; n++)
            printf("%02x", out[n]);
    }
#endif
    printf("\n");

    free(our_list);
    return 0;
}

int is_sorted(int *toorder, int N)
{
    for (int i = 1; i < N; i++) {
        if (toorder[i] < toorder[i - 1])
            return 1;
    }
    return 0;
}

int *generate_case(int N)
{
    int *ret = NULL;

    srandnum(0);
    ret = (int *)malloc((size_t)N * sizeof(*ret));
    if (ret == NULL) {
        printf("Error: some malloc won't work.\n");
        return NULL;
    }

    for (int i = 0; i < N; i++)
        ret[i] = drand(0, INT_MAX);
    return ret;
}

double drand(int xmin, int xmax)
{
    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;
}

import asyncio
import importlib.util
import json
from pathlib import Path

ROOT=Path(__file__).resolve().parent
spec=importlib.util.spec_from_file_location("private_romeo",ROOT/"romeo-prive.py")
module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)


async def main():
    prepared=json.loads((ROOT/"prevol-plan-prepare-launchfix1.json").read_text())
    expected=json.loads((ROOT/"prevol-plan-arguments-launchfix1.json").read_text())
    async with module.ScopedRomeo(Path("C:/Users/nicol/.codex/config.toml")) as rpc:
        plan=await rpc.call("plan_get",plan_id=prepared["plan_id"])
        (ROOT/"prevol-plan-relu-launchfix1.json").write_text(json.dumps(plan,indent=2))
        p=plan["plan"]["entries"][0]["plan"];s=p["spec"]
        assert plan["state"]=="ready" and not plan["expired"]
        assert s["command"]==expected["command"] and s["cpus_per_task"]==4
        assert s["arch"]=="armgpu" and s["gpus_per_node"]==0 and s["mem_gb"]==16
        result=await rpc.call("job_submit",plan_id=prepared["plan_id"],confirm=True)
        (ROOT/"prevol-soumission-launchfix1.json").write_text(json.dumps(result,indent=2))
        efficiency=await rpc.call("job_efficiency",job_id="747943")
        (ROOT/"efficacite-prevol-747943.json").write_text(json.dumps(efficiency,indent=2))
        print(json.dumps({k:result[k] for k in ["job_id","submitted","plan_id","plan_sha256"]}))


if __name__=="__main__":asyncio.run(main())

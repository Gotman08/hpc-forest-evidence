#include <algorithm>
#include <iostream>
#include <vector>

using namespace std;

const int MOD = 1000000007;

static inline void update_segment(int* dp, int first, int last) {
    int left = dp[first - 1];
    for (int j = first; j < last; ++j) {
        int value = dp[j] + left;
        if (value >= MOD) value -= MOD;
        dp[j] = value;
        left = value;
    }
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) return 0;

    vector<vector<int> > blocked(n);
    for (int c = 0; c < m; ++c) {
        int row, column;
        cin >> row >> column;
        blocked[row].push_back(column);
    }

    // Index zero is a permanent zero-valued left boundary.
    vector<int> dp(n + 1, 0);
    dp[1] = 1;

    for (int i = 0; i < n; ++i) {
        vector<int>& columns = blocked[i];
        if (columns.size() > 1) {
            sort(columns.begin(), columns.end());
            columns.erase(unique(columns.begin(), columns.end()), columns.end());
        }

        int first = 1;
        for (int column : columns) {
            const int obstacle = column + 1;
            update_segment(dp.data(), first, obstacle);
            dp[obstacle] = 0;
            first = obstacle + 1;
        }
        update_segment(dp.data(), first, n + 1);
    }

    cout << dp[n] << '\n';
    return 0;
}

-    schema = copy.deepcopy(schema)
-
-    def visit(value):
-        if isinstance(value, dict):
-            value.pop("uniqueItems", None)
-            value.pop("maxItems", None)
-            for child in value.values():
-                visit(child)
-        elif isinstance(value, list):
-            for child in value:
-                visit(child)
-
-    visit(schema)
-    return schema

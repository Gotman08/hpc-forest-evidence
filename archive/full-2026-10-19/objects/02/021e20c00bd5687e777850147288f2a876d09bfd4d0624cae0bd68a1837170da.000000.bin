  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n#define TILE_SIZE 64 // outer loop tile size for cache reuse\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Compute the gravitational impact among all pairs of bodies in \n * the system. Uses Structure-of-Arrays layout and blocked i-loop.\n */\nvoid body_force(float *restrict x, float *restrict y, float *restrict z,\n                float *restrict vx, float *restrict vy, float *restrict vz,\n                float dt, int n) {\n  for (int ii = 0; ii < n; ii += TILE_SIZE) {\n    int i_end = ii + TILE_SIZE;\n    if (i_end > n) i_end = n;\n    int tile_len = i_end - ii;\n\n    float fx[tile_len], fy[tile_len], fz[tile_len];\n    for (int ti = 0; ti < tile_len; ++ti) {\n      fx[ti] = 0.0f;\n      fy[ti] = 0.0f;\n      fz[ti] = 0.0f;\n    }\n\n    // Loop over all bodies j (sequential order preserved)\n    for (int j = 0; j < n; ++j) {\n      float xj = x[j];\n      float yj = y[j];\n      float zj = z[j];\n\n      for (int ti = 0; ti < tile_len; ++ti) {\n        int i = ii + ti;\n        if (i == j) continue; // self-interaction contributes exactly zero\n\n        float dx = xj - x[i];\n        float dy = yj - y[i];\n        float dz = zj - z[i];\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1.0f / sqrtf(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx[ti] += dx * inv_dist3;\n        fy[ti] += dy * inv_dist3;\n        fz[ti] += dz * inv_dist3;\n      }\n    }\n\n    // Update velocities for the tile\n    for (int ti = 0; ti < tile_len; ++ti) {\n      int i = ii + ti;\n      vx[i] += dt * fx[ti];\n      vy[i] += dt * fy[ti];\n      vz[i] += dt * fz[ti];\n    }\n  }\n}\n\n/*\n * Read a binary dataset with initialized bodies.\n * Converts from interleaved AoS to SoA layout.\n */\nBody* read_dataset(int *nbodies,\n                   float **x, float **y, float **z,\n                   float **vx, float **vy, float **vz) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  // Allocate SoA arrays\n  *x = (float *)malloc(*nbodies * sizeof(float));\n  *y = (float *)malloc(*nbodies * sizeof(float));\n  *z = (float *)malloc(*nbodies * sizeof(float));\n  *vx = (float *)malloc(*nbodies * sizeof(float));\n  *vy = (float *)malloc(*nbodies * sizeof(float));\n  *vz = (float *)malloc(*nbodies * sizeof(float));\n\n  // Temporary buffer for interleaved input\n  Body *tmp = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(tmp, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  // Scatter into SoA\n  for (int i = 0; i < *nbodies; ++i) {\n    (*x)[i] = tmp[i].x;\n    (*y)[i] = tmp[i].y;\n    (*z)[i] = tmp[i].z;\n    (*vx)[i] = tmp[i].vx;\n    (*vy)[i] = tmp[i].vy;\n    (*vz)[i] = tmp[i].vz;\n  }\n\n  free(tmp);\n  return NULL; // caller uses separate arrays, not a Body pointer\n}\n\n/*\n * Write simulation results into a binary dataset.\n * Converts from SoA back to interleaved AoS layout.\n */\nvoid write_dataset(const int nbodies,\n                   float *x, float *y, float *z,\n                   float *vx, float *vy, float *vz) {\n  // Pack into temporary array\n  Body *tmp = (Body *)malloc(nbodies * sizeof(Body));\n  for (int i = 0; i < nbodies; ++i) {\n    tmp[i].x = x[i];\n    tmp[i].y = y[i];\n    tmp[i].z = z[i];\n    tmp[i].vx = vx[i];\n    tmp[i].vy = vy[i];\n    tmp[i].vz = vz[i];\n  }\n\n  int b = fwrite(tmp, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n  free(tmp);\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n  float *x, *y, *z, *vx, *vy, *vz;\n\n  read_dataset(&nbodies, &x, &y, &z, &vx, &vy, &vz);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    body_force(x, y, z, vx, vy, vz, DT, nbodies);\n\n    for (int i = 0; i < nbodies; ++i) {\n      x[i] += vx[i] * DT;\n      y[i] += vy[i] * DT;\n      z[i] += vz[i] * DT;\n    }\n  }\n\n  write_dataset(nbodies, x, y, z, vx, vy, vz);\n\n  free(x); free(y); free(z); free(vx); free(vy); free(vz);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Blocking the outer i-loop combined with Structure-of-Arrays data layout improves cache reuse by loading all body coordinates once per tile of bodies, while preserving exact floating-point operation order. Skipping self-interaction reduces computation without affecting results.",
  "notes": "Tile size set to 64 to fit in L1 cache. SoA enables contiguous access to coordinate arrays. Self-interaction skipped because contribution is exactly zero (dx=0).",

{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nstatic void body_force(const float *restrict px,\n                       const float *restrict py,\n                       const float *restrict pz,\n                       float *restrict vx,\n                       float *restrict vy,\n                       float *restrict vz,\n                       float dt, int n) {\n#pragma omp parallel for schedule(static)\n  for (int i = 0; i < n; ++i) {\n    const float xi = px[i];\n    const float yi = py[i];\n    const float zi = pz[i];\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; ++j) {\n      const float dx = px[j] - xi;\n      const float dy = py[j] - yi;\n      const float dz = pz[j] - zi;\n      const float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      const float inv_dist = 1 / sqrt(sqrd_dist);\n      const float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    vx[i] += dt*fx;\n    vy[i] += dt*fy;\n    vz[i] += dt*fz;\n  }\n}\n\nstatic Body* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) { fprintf(stderr,\"\\nError reading nbodie value\\n\"); exit(EXIT_FAILURE); }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) { fprintf(stderr,\"\\nError reading input values\\n\"); exit(EXIT_FAILURE); }\n  return bodies;\n}\n\nstatic void write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) { fprintf(stderr,\"\\nError writing to output\\n\"); exit(EXIT_FAILURE); }\n}\n\nint main(int argc, char **argv) {\n  int nbodies;\n  Body *bodies = read_dataset(&nbodies);\n\n  const size_t align = 64;\n  float *px, *py, *pz, *vx, *vy, *vz;\n  if (posix_memalign((void**)&px, align, nbodies * sizeof(float)) ||\n      posix_memalign((void**)&py, align, nbodies * sizeof(float)) ||\n      posix_memalign((void**)&pz, align, nbodies * sizeof(float)) ||\n      posix_memalign((void**)&vx, align, nbodies * sizeof(float)) ||\n      posix_memalign((void**)&vy, align, nbodies * sizeof(float)) ||\n      posix_memalign((void**)&vz, align, nbodies * sizeof(float))) {\n    fprintf(stderr,\"\\nError allocating aligned memory\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  for (int i = 0; i < nbodies; ++i) {\n    px[i] = bodies[i].x;\n    py[i] = bodies[i].y;\n    pz[i] = bodies[i].z;\n    vx[i] = bodies[i].vx;\n    vy[i] = bodies[i].vy;\n    vz[i] = bodies[i].vz;\n  }\n\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    body_force(px, py, pz, vx, vy, vz, DT, nbodies);\n\n#pragma omp parallel for schedule(static)\n    for (int i = 0; i < nbodies; ++i) {\n      px[i] += vx[i] * DT;\n      py[i] += vy[i] * DT;\n      pz[i] += vz[i] * DT;\n    }\n  }\n\n  for (int i = 0; i < nbodies; ++i) {\n    bodies[i].x = px[i];\n    bodies[i].y = py[i];\n    bodies[i].z = pz[i];\n    bodies[i].vx = vx[i];\n    bodies[i].vy = vy[i];\n    bodies[i].vz = vz[i];\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(px); free(py); free(pz); free(vx); free(vy); free(vz);\n  free(bodies);\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "A structure-of-arrays layout with cache-line-aligned allocations and OpenMP static scheduling over the outer body loop improves memory locality and parallel throughput while preserving the exact per-body j-summation order, yielding a speedup beyond the best observed SoA+OpenMP variant.",
  "notes": "The transformation keeps the original floating-point operation sequence (same sqrt call, same accumulation order) so output bytes remain identical. Aligned SoA arrays reduce cache misses and enable better prefetching; restrict pointers help the compiler generate tighter code. OpenMP parallelizes independent i iterations without altering any per-body reduction.",
  "sources_kept": [],
  "transformations": [
    "Convert AoS Body array to six separate float arrays (SoA)",
    "Allocate SoA arrays with posix_memalign for 64-byte cache-line alignment",
    "Add OpenMP parallel-for static scheduling on the outer i loop in body_force and position update",
    "Use restrict qualifiers on all pointer parameters to aid vectorization/optimization"
  ]

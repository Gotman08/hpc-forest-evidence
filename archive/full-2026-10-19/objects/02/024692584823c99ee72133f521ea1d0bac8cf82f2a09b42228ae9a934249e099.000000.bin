      "content": "#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <limits>\n#include <memory>\n#include <vector>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#define SUM_USE_NEON 1\n#else\n#define SUM_USE_NEON 0\n#endif\n\nclass BufferedInput {\n    unsigned char buffer_[1 << 16];\n    std::size_t position_ = 0;\n    std::size_t length_ = 0;\n\n    int next_char() {\n        if (position_ == length_) {\n            length_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (length_ == 0) return EOF;\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    bool read_int(int& result) {\n        int c;\n        do {\n            c = next_char();\n            if (c == EOF) return false;\n        } while (c <= ' ');\n\n        const bool negative = c == '-';\n        if (c == '-' || c == '+') c = next_char();\n        unsigned int value = 0;\n        while (c >= '0' && c <= '9') {\n            value = value * 10u + static_cast<unsigned int>(c - '0');\n            c = next_char();\n        }\n        const std::int64_t magnitude = static_cast<std::int64_t>(value);\n        result = static_cast<int>(negative ? -magnitude : magnitude);\n        return true;\n    }\n};\n\nstatic std::int64_t solve_columns(BufferedInput& input, int n, int s) {\n    const std::size_t stride = static_cast<std::size_t>(n);\n    std::unique_ptr<int[]> rows(new int[stride * static_cast<std::size_t>(s)]);\n    std::vector<std::int64_t> columns(n, 0);\n\n    for (int r = 0; r < s; ++r) {\n        int* const row = rows.get() + static_cast<std::size_t>(r) * stride;\n        for (int c = 0; c < n; ++c) {\n            int value = 0;\n            input.read_int(value);\n            row[c] = value;\n            columns[c] += value;\n        }\n    }\n\n    std::int64_t leading = 0;\n    for (int c = 0; c < s; ++c) leading += columns[c];\n    std::int64_t window = leading;\n    std::int64_t best = window;\n    for (int c = s; c < n; ++c) {\n        window += columns[c] - columns[c - s];\n        if (window > best) best = window;\n    }\n\n    int slot = 0;\n    for (int r = s; r < n; ++r) {\n        int* const row = rows.get() + static_cast<std::size_t>(slot) * stride;\n        std::int64_t change = 0;\n        for (int c = 0; c < s; ++c) {\n            int value = 0;\n            input.read_int(value);\n            const std::int64_t delta = static_cast<std::int64_t>(value) - row[c];\n            columns[c] += delta;\n            row[c] = value;\n            change += delta;\n        }\n        leading += change;\n        window = leading;\n        if (window > best) best = window;\n\n        for (int c = s; c < n; ++c) {\n            int value = 0;\n            input.read_int(value);\n            columns[c] += static_cast<std::int64_t>(value) - row[c];\n            row[c] = value;\n            window += columns[c] - columns[c - s];\n            if (window > best) best = window;\n        }\n\n        ++slot;\n        if (slot == s) slot = 0;\n    }\n    return best;\n}\n\nstatic void read_prefix(BufferedInput& input, std::int64_t* prefix, int n) {\n    prefix[0] = 0;\n    for (int c = 0; c < n; ++c) {\n        int value = 0;\n        input.read_int(value);\n        prefix[c + 1] = prefix[c] + value;\n    }\n}\n\n#if SUM_USE_NEON\nstatic inline int64x2_t max_lanes(int64x2_t a, int64x2_t b) {\n    return vbslq_s64(vcgtq_s64(a, b), a, b);\n}\n#endif\n\nstatic std::int64_t solve_horizontal(BufferedInput& input, int n, int s) {\n    const int width = n - s + 1;\n    const std::size_t stride = static_cast<std::size_t>(width);\n    std::vector<std::int64_t> prefix(n + 1);\n    std::vector<std::int64_t> sums(width, 0);\n    std::unique_ptr<std::int64_t[]> history(\n        new std::int64_t[static_cast<std::size_t>(s) * stride]);\n\n    for (int r = 0; r < s; ++r) {\n        read_prefix(input, prefix.data(), n);\n        std::int64_t* const saved = history.get() + static_cast<std::size_t>(r) * stride;\n        int c = 0;\n#if SUM_USE_NEON\n        for (; c + 4 <= width; c += 4) {\n            const int64x2_t h0 = vsubq_s64(\n                vld1q_s64(prefix.data() + c + s),\n                vld1q_s64(prefix.data() + c));\n            const int64x2_t h1 = vsubq_s64(\n                vld1q_s64(prefix.data() + c + s + 2),\n                vld1q_s64(prefix.data() + c + 2));\n            vst1q_s64(saved + c, h0);\n            vst1q_s64(saved + c + 2, h1);\n            vst1q_s64(sums.data() + c,\n                vaddq_s64(vld1q_s64(sums.data() + c), h0));\n            vst1q_s64(sums.data() + c + 2,\n                vaddq_s64(vld1q_s64(sums.data() + c + 2), h1));\n        }\n#endif\n        for (; c < width; ++c) {\n            const std::int64_t horizontal = prefix[c + s] - prefix[c];\n            saved[c] = horizontal;\n            sums[c] += horizontal;\n        }\n    }\n\n    std::int64_t best = std::numeric_limits<std::int64_t>::lowest();\n    int c = 0;\n#if SUM_USE_NEON\n    int64x2_t best0 = vdupq_n_s64(best);\n    int64x2_t best1 = vdupq_n_s64(best);\n    for (; c + 4 <= width; c += 4) {\n        best0 = max_lanes(best0, vld1q_s64(sums.data() + c));\n        best1 = max_lanes(best1, vld1q_s64(sums.data() + c + 2));\n    }\n#endif\n    for (; c < width; ++c) {\n        if (sums[c] > best) best = sums[c];\n    }\n\n    int slot = 0;\n    for (int r = s; r < n; ++r) {\n        read_prefix(input, prefix.data(), n);\n        std::int64_t* const saved = history.get() + static_cast<std::size_t>(slot) * stride;\n        int column = 0;\n#if SUM_USE_NEON\n        for (; column + 4 <= width; column += 4) {\n            const int64x2_t h0 = vsubq_s64(\n                vld1q_s64(prefix.data() + column + s),\n                vld1q_s64(prefix.data() + column));\n            const int64x2_t h1 = vsubq_s64(\n                vld1q_s64(prefix.data() + column + s + 2),\n                vld1q_s64(prefix.data() + column + 2));\n            const int64x2_t old0 = vld1q_s64(saved + column);\n            const int64x2_t old1 = vld1q_s64(saved + column + 2);\n            const int64x2_t current0 = vaddq_s64(\n                vld1q_s64(sums.data() + column), vsubq_s64(h0, old0));\n            const int64x2_t current1 = vaddq_s64(\n                vld1q_s64(sums.data() + column + 2), vsubq_s64(h1, old1));\n            vst1q_s64(saved + column, h0);\n            vst1q_s64(saved + column + 2, h1);\n            vst1q_s64(sums.data() + column, current0);\n            vst1q_s64(sums.data() + column + 2, current1);\n            best0 = max_lanes(best0, current0);\n            best1 = max_lanes(best1, current1);\n        }\n#endif\n        for (; column < width; ++column) {\n            const std::int64_t horizontal = prefix[column + s] - prefix[column];\n            sums[column] += horizontal - saved[column];\n            saved[column] = horizontal;\n            if (sums[column] > best) best = sums[column];\n        }\n        ++slot;\n        if (slot == s) slot = 0;\n    }\n\n#if SUM_USE_NEON\n    const int64x2_t combined = max_lanes(best0, best1);\n    const std::int64_t lane0 = vgetq_lane_s64(combined, 0);\n    const std::int64_t lane1 = vgetq_lane_s64(combined, 1);\n    if (lane0 > best) best = lane0;\n    if (lane1 > best) best = lane1;\n#endif\n    return best;\n}\n\nint main() {\n    BufferedInput input;\n    int n = 0;\n    int s = 0;\n    if (!input.read_int(n) || !input.read_int(s)) return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t raw_row_bytes = static_cast<std::size_t>(n) * sizeof(int);\n    const std::size_t horizontal_row_bytes =\n        static_cast<std::size_t>(n - s + 1) * sizeof(std::int64_t);\n    const std::int64_t best = horizontal_row_bytes < raw_row_bytes\n        ? solve_horizontal(input, n, s)\n        : solve_columns(input, n, s);\n\n    std::printf(\"%lld\\n\", static_cast<long long>(best));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

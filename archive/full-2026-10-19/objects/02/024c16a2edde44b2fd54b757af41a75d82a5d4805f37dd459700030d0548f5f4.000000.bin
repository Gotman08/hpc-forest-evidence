#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <omp.h>

int main() {
	int n,s;
	std::cin >> n >> s;
	std::vector<std::vector<int> > matrix(n, std::vector<int>(n));
	for(int i=0;i<n;i++)
		for(int j=0;j<n;j++) 
			scanf("%d", &(matrix[i][j]));

	assert(s<n);
	assert(n<8000);
	assert(s>0);
	assert(n>0);

	int sum = 0;
	for(int i=0;i<s;i++)
		for(int j=0;j<s;j++)
			sum += matrix[i][j];

	int mxSum = sum;

	#pragma omp parallel reduction(max:mxSum)
	{
		#pragma omp for collapse(2) schedule(guided)
		for(int i=0;i<n-s+1;i++) {
			for(int j=0;j<n-s+1;j++) {
				int current_sum = 0;
				if(i==0 && j==0) continue;
				if(i>0) {
					current_sum += sum;
					for(int k=0;k<s;k++)
						current_sum -= matrix[i-1][j+k];
				} else {
					current_sum = sum;
				}
				if(j>0) {
					for(int k=0;k<s;k++)
						current_sum -= matrix[i+k][j-1];
					for(int k=0;k<s;k++)
						current_sum += matrix[i+k][j+s-1];
				}
				#pragma omp atomic
				mxSum = std::max(mxSum, current_sum);
			}
		}
	}
	printf("%d\n", mxSum);
}
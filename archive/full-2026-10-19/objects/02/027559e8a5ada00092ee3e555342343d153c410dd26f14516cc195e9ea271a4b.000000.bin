{
  "src/solution.cpp": "#include <algorithm>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <limits>\n#include <memory>\n#include <vector>\n\nclass FastInput {\n    static constexpr std::size_t capacity = 1u << 16;\n    unsigned char buffer[capacity];\n    std::size_t position = 0;\n    std::size_t available = 0;\n\n    int readByte() {\n        if (position == available) {\n            available = std::fread(buffer, 1, capacity, stdin);\n            position = 0;\n            if (available == 0) return EOF;\n        }\n        return buffer[position++];\n    }\n\npublic:\n    bool readInt(int& value) {\n        int c = readByte();\n        while (c != EOF && c <= ' ') c = readByte();\n        if (c == EOF) {\n            value = 0;\n            return false;\n        }\n        bool negative = false;\n        if (c == '-' || c == '+') {\n            negative = c == '-';\n            c = readByte();\n        }\n        std::int64_t magnitude = 0;\n        while (c >= '0' && c <= '9') {\n            magnitude = magnitude * 10 + (c - '0');\n            c = readByte();\n        }\n        value = static_cast<int>(negative ? -magnitude : magnitude);\n        return true;\n    }\n};\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.readInt(n) || !input.readInt(s)) return 0;\n    if (n <= 0 || n >= 8000 || s <= 0 || s >= n) return 0;\n\n    using Sum = std::int64_t;\n    constexpr int batchRows = 64;\n    constexpr int columnTile = 256;\n    const int m = n - s + 1;\n\n    std::unique_ptr<int[]> rawStorage(\n        new int[static_cast<std::size_t>(batchRows) * n]);\n    std::unique_ptr<Sum[]> horizontalStorage(\n        new Sum[static_cast<std::size_t>(batchRows) * m]);\n    std::unique_ptr<Sum[]> historyStorage(\n        new Sum[static_cast<std::size_t>(s) * m]);\n    std::vector<Sum> verticalStorage(m, 0);\n\n    int* const raw = rawStorage.get();\n    Sum* const horizontal = horizontalStorage.get();\n    Sum* const history = historyStorage.get();\n    Sum* const vertical = verticalStorage.data();\n    Sum best = std::numeric_limits<Sum>::lowest();\n\n#ifdef _OPENMP\n#pragma omp parallel if (static_cast<std::size_t>(n) * n >= 262144u) reduction(max: best)\n#endif\n    {\n        for (int first = 0; first < n; first += batchRows) {\n            const int rows = std::min(batchRows, n - first);\n\n#ifdef _OPENMP\n#pragma omp single\n#endif\n            {\n                const std::size_t count = static_cast<std::size_t>(rows) * n;\n                for (std::size_t i = 0; i < count; ++i) {\n                    input.readInt(raw[i]);\n                }\n            }\n\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n            for (int row = 0; row < rows; ++row) {\n                const int* source = raw + static_cast<std::size_t>(row) * n;\n                Sum* destination = horizontal + static_cast<std::size_t>(row) * m;\n                Sum sum = 0;\n#ifdef _OPENMP\n#pragma omp simd reduction(+: sum)\n#endif\n                for (int c = 0; c < s; ++c) {\n                    sum += static_cast<Sum>(source[c]);\n                }\n                destination[0] = sum;\n                for (int c = 1; c < m; ++c) {\n                    sum += static_cast<Sum>(source[c + s - 1])\n                         - static_cast<Sum>(source[c - 1]);\n                    destination[c] = sum;\n                }\n            }\n\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n            for (int block = 0; block < m; block += columnTile) {\n                const int end = std::min(block + columnTile, m);\n                int slot = first % s;\n                for (int row = 0; row < rows; ++row) {\n                    const int globalRow = first + row;\n                    const Sum* entering = horizontal + static_cast<std::size_t>(row) * m;\n                    Sum* previous = history + static_cast<std::size_t>(slot) * m;\n\n                    if (globalRow < s) {\n#ifdef _OPENMP\n#pragma omp simd\n#endif\n                        for (int c = block; c < end; ++c) {\n                            vertical[c] += entering[c];\n                            previous[c] = entering[c];\n                        }\n                        if (globalRow == s - 1) {\n                            Sum rowBest = std::numeric_limits<Sum>::lowest();\n#ifdef _OPENMP\n#pragma omp simd reduction(max: rowBest)\n#endif\n                            for (int c = block; c < end; ++c) {\n                                if (vertical[c] > rowBest) rowBest = vertical[c];\n                            }\n                            if (rowBest > best) best = rowBest;\n                        }\n                    } else {\n                        Sum rowBest = std::numeric_limits<Sum>::lowest();\n#ifdef _OPENMP\n#pragma omp simd reduction(max: rowBest)\n#endif\n                        for (int c = block; c < end; ++c) {\n                            const Sum next = entering[c];\n                            const Sum value = vertical[c] + next - previous[c];\n                            vertical[c] = value;\n                            previous[c] = next;\n                            if (value > rowBest) rowBest = value;\n                        }\n                        if (rowBest > best) best = rowBest;\n                    }\n\n                    if (++slot == s) slot = 0;\n                }\n            }\n        }\n    }\n\n    std::printf(\"%lld\\n\", static_cast<long long>(best));\n    return 0;\n}\n"
}

    {
      "content": "#include \"knn.h\"\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n    enum { DISTANCE_BLOCK = 256 };\n    float block_distances[DISTANCE_BLOCK];\n\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length;) {\n            int count = g.length - j;\n            if (count > DISTANCE_BLOCK) count = DISTANCE_BLOCK;\n            const Point * restrict points = g.points + j;\n            const float block_limit = distances[k - 1];\n            int block_has_candidate = 0;\n\n            /* Distances and cutoff comparisons are independent across lanes. */\n#if defined(_OPENMP)\n#pragma omp simd reduction(|: block_has_candidate)\n#endif\n            for (int lane = 0; lane < count; lane++) {\n                float d = euclidean_distance_no_sqrt(to_evaluate, points[lane]);\n                block_distances[lane] = d;\n                block_has_candidate |= !(d >= block_limit);\n            }\n\n            /* With no candidate, every original update would leave the cutoff unchanged. */\n            if (block_limit != -1 && !block_has_candidate) {\n                j += count;\n                continue;\n            }\n\n            for (int lane = 0; lane < count; lane++) {\n                float d = block_distances[lane];\n\n                /* Keep the original search for unordered comparisons. */\n                if (distances[k - 1] != -1 && d >= distances[k - 1]) {\n                    continue;\n                }\n\n                for (x = 0; x < k; x++) {\n                    if (d < distances[x] || distances[x] == -1) {\n                        for (y = k - 1; y > x; y--) {\n                            distances[y] = distances[y - 1];\n                            labels[y] = labels[y - 1];\n                        }\n\n                        distances[x] = d;\n                        labels[x] = g.label;\n\n                        break;\n                    }\n                }\n            }\n\n            j += count;\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Fusing a SIMD any-candidate reduction into distance evaluation can eliminate serial scans of wholly noncompetitive blocks on ARM64.",

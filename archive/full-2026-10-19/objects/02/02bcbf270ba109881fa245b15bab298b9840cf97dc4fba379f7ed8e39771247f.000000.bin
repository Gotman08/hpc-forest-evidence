#define _POSIX_C_SOURCE 200809L
#include "knn.h"
#ifdef __ARM_NEON
#include <arm_neon.h>
#endif

static int worse(float d1, int i1, float d2, int i2) {
    return (d1 > d2) || (d1 == d2 && i1 > i2);
}

static void sift_up(float *dist_heap, int *idx_heap, int pos) {
    while (pos > 0) {
        int parent = (pos - 1) / 2;
        if (worse(dist_heap[pos], idx_heap[pos], dist_heap[parent], idx_heap[parent])) {
            float tmpd = dist_heap[pos];
            dist_heap[pos] = dist_heap[parent];
            dist_heap[parent] = tmpd;
            int tmpi = idx_heap[pos];
            idx_heap[pos] = idx_heap[parent];
            idx_heap[parent] = tmpi;
            pos = parent;
        } else {
            break;
        }
    }
}

static void sift_down(float *dist_heap, int *idx_heap, int heap_size, int pos) {
    while (1) {
        int left = 2*pos + 1;
        int right = 2*pos + 2;
        int largest = pos;
        if (left < heap_size && worse(dist_heap[left], idx_heap[left], dist_heap[largest], idx_heap[largest])) {
            largest = left;
        }
        if (right < heap_size && worse(dist_heap[right], idx_heap[right], dist_heap[largest], idx_heap[largest])) {
            largest = right;
        }
        if (largest != pos) {
            float tmpd = dist_heap[pos];
            dist_heap[pos] = dist_heap[largest];
            dist_heap[largest] = tmpd;
            int tmpi = idx_heap[pos];
            idx_heap[pos] = idx_heap[largest];
            idx_heap[largest] = tmpi;
            pos = largest;
        } else {
            break;
        }
    }
}

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    // Count total points
    int total_points = 0;
    for (int i = 0; i < n_groups; i++) {
        total_points += groups[i].length;
    }

    // Allocate arrays for distances and labels per point
    float *dists = NULL;
    char *point_labels = (char *) malloc(sizeof(char) * total_points);
    if (!point_labels) exit(1);

#ifdef __ARM_NEON
    posix_memalign((void**)&dists, 16, sizeof(float) * total_points);
#else
    dists = (float *) malloc(sizeof(float) * total_points);
#endif
    if (!dists) exit(1);

    // Compute squared distances and record labels
    int idx = 0;
    for (int i = 0; i < n_groups; i++) {
        Group g = groups[i];
        float eval_x = to_evaluate.x;
        float eval_y = to_evaluate.y;

#ifdef __ARM_NEON
        float32x4_t vx = vdupq_n_f32(eval_x);
        float32x4_t vy = vdupq_n_f32(eval_y);

        int j = 0;
        for (; j + 3 < g.length; j += 4) {
            // Load two interleaved vectors: x and y
            float32x4x2_t xy = vld2q_f32((const float *)&g.points[j]);
            float32x4_t xs = xy.val[0];
            float32x4_t ys = xy.val[1];

            float32x4_t dx = vsubq_f32(xs, vx);
            float32x4_t dy = vsubq_f32(ys, vy);

            float32x4_t d2 = vaddq_f32(vmulq_f32(dx, dx), vmulq_f32(dy, dy));

            vst1q_f32(&dists[idx + j], d2);
        }
        // Scalar remainder
        for (; j < g.length; j++) {
            float dx = g.points[j].x - eval_x;
            float dy = g.points[j].y - eval_y;
            dists[idx + j] = dx*dx + dy*dy;
        }
#else
        for (int j = 0; j < g.length; j++) {
            float dx = g.points[j].x - eval_x;
            float dy = g.points[j].y - eval_y;
            dists[idx + j] = dx*dx + dy*dy;
        }
#endif

        // Fill labels for this group
        for (int j = 0; j < g.length; j++) {
            point_labels[idx + j] = g.label;
        }

        idx += g.length;
    }

    // Select top-k using max-heap preserving tie-breaking by original order
    float *heap_dist = (float *) malloc(sizeof(float) * k);
    int *heap_idx = (int *) malloc(sizeof(int) * k);
    if (!heap_dist || !heap_idx) exit(1);

    int heap_size = 0;
    for (int p = 0; p < total_points; p++) {
        float d = dists[p];
        if (heap_size < k) {
            heap_dist[heap_size] = d;
            heap_idx[heap_size] = p;
            heap_size++;
            sift_up(heap_dist, heap_idx, heap_size - 1);
        } else if (d < heap_dist[0]) {
            heap_dist[0] = d;
            heap_idx[0] = p;
            sift_down(heap_dist, heap_idx, heap_size, 0);
        }
    }

    // Count frequencies of labels among selected points
    int counts[256] = {0};
    for (int i = 0; i < heap_size; i++) {
        int pidx = heap_idx[i];
        counts[(unsigned char)point_labels[pidx]]++;
    }

    char most_frequent;
    int best_count = -1;
    for (int c = 0; c < 256; c++) {
        if (counts[c] > best_count) {
            best_count = counts[c];
            most_frequent = (char)c;
        }
    }

    free(dists);
    free(point_labels);
    free(heap_dist);
    free(heap_idx);

    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

        "content": "/*\n  Quicksort\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <limits.h>\n#include <openssl/md5.h>\n\n#define MY_RAND_MAX 0x7FFFFFFF\n#define RANDNUM_W 521288629\n#define RANDNUM_Z 362436069\n#define INSERTION_CUTOFF 32\n#define PARALLEL_CUTOFF 32768\n\nvoid srandnum(int seed);\ndouble randnum(void);\nint *generate_case(int N);\ndouble drand(int xmin, int xmax);\nvoid swap(int *toorder, int i, int j);\nvoid quicksort(int *toorder, int N);\nint is_sorted(int *toorder, int N);\n\nstatic int median_of_three(int a, int b, int c);\nstatic void insertion_sort(int *toorder, int lo, int hi);\nstatic void sift_down(int *toorder, int lo, int root, int count);\nstatic void heapsort_range(int *toorder, int lo, int hi);\nstatic void partition_three(int *toorder, int lo, int hi, int *lt_result, int *gt_result);\nstatic void _quicksort_parallel(int *toorder, int lo, int hi, int depth);\n\nunsigned int randum_w = RANDNUM_W;\nunsigned int randum_z = RANDNUM_Z;\n\nvoid srandnum(int seed)\n{\n    unsigned int w, z;\n    w = (seed * 104623) & 0xffffffff;\n    randum_w = (w) ? w : RANDNUM_W;\n    z = (seed * 48947) & 0xffffffff;\n    randum_z = (z) ? z : RANDNUM_Z;\n}\n\ndouble randnum(void)\n{\n    unsigned int u;\n    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);\n    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);\n    u = (randum_z << 16) + randum_w;\n    return (abs(u));\n}\n\nint main(int argc, char *argv[])\n{\n    int N = 0;\n    int *our_list = NULL;\n\n    //The input provides the case size\n    scanf(\"%d\", &N);\n    if (N <= 0) {\n        printf(\"Error: please, provide the case size.\\n\");\n        return 1;\n    }\n\n    //Generate the case\n    our_list = generate_case(N);\n    if (our_list == NULL) {\n        printf(\"Error: case instantiation failed.\\n\");\n        return 1;\n    }\n\n    //Do the thing\n    quicksort(our_list, N);\n\n    if (is_sorted(our_list, N) == 1) {\n        printf(\"Error, for some reason list is still unsorted.\\n\");\n        return 1;\n    }\n\n#ifdef COMPUTE_MD5_PROBLEM\n    //Compute MD5 Checksum for problem identification\n    MD5_CTX c;\n    unsigned char out[MD5_DIGEST_LENGTH];\n    MD5_Init(&c);\n    MD5_Update(&c, our_list, N * sizeof(int));\n    MD5_Final(out, &c);\n    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {\n        printf(\"%02x\", out[n]);\n    }\n#endif\n    printf(\"\\n\");\n\n    //Clean up\n    free(our_list);\n\n    return 0;\n}\n\nvoid quicksort(int *toorder, int N)\n{\n    int depth = 0;\n    int n = N;\n\n    if (N < 2) {\n        return;\n    }\n\n    while (n > 1) {\n        depth += 2;\n        n >>= 1;\n    }\n\n    // Avoid starting an OpenMP team for small inputs.\n    if (N < PARALLEL_CUTOFF) {\n        _quicksort_parallel(toorder, 0, N - 1, depth);\n        return;\n    }\n\n    #pragma omp parallel\n    {\n        #pragma omp single\n        _quicksort_parallel(toorder, 0, N - 1, depth);\n    }\n}\n\nstatic int median_of_three(int a, int b, int c)\n{\n    if (a < b) {\n        if (b < c) {\n            return b;\n        }\n        return (a < c) ? c : a;\n    }\n    if (a < c) {\n        return a;\n    }\n    return (b < c) ? c : b;\n}\n\nstatic void insertion_sort(int *toorder, int lo, int hi)\n{\n    for (int i = lo + 1; i <= hi; i++) {\n        int value = toorder[i];\n        int j = i;\n        while (j > lo && toorder[j - 1] > value) {\n            toorder[j] = toorder[j - 1];\n            j--;\n        }\n        toorder[j] = value;\n    }\n}\n\nstatic void sift_down(int *toorder, int lo, int root, int count)\n{\n    while (root < count / 2) {\n        int child = root * 2 + 1;\n        if (child + 1 < count && toorder[lo + child] < toorder[lo + child + 1]) {\n            child++;\n        }\n        if (toorder[lo + root] >= toorder[lo + child]) {\n            return;\n        }\n        swap(toorder, lo + root, lo + child);\n        root = child;\n    }\n}\n\nstatic void heapsort_range(int *toorder, int lo, int hi)\n{\n    int count = hi - lo + 1;\n    for (int start = count / 2; start > 0; start--) {\n        sift_down(toorder, lo, start - 1, count);\n    }\n    for (int end = count - 1; end > 0; end--) {\n        swap(toorder, lo, lo + end);\n        sift_down(toorder, lo, 0, end);\n    }\n}\n\nstatic void partition_three(int *toorder, int lo, int hi, int *lt_result, int *gt_result)\n{\n    int mid = lo + (hi - lo) / 2;\n    int pivot = median_of_three(toorder[lo], toorder[mid], toorder[hi]);\n    int lt = lo;\n    int i = lo;\n    int gt = hi;\n\n    while (i <= gt) {\n        if (toorder[i] < pivot) {\n            swap(toorder, lt, i);\n            lt++;\n            i++;\n        } else if (toorder[i] > pivot) {\n            swap(toorder, i, gt);\n            gt--;\n        } else {\n            i++;\n        }\n    }\n\n    *lt_result = lt;\n    *gt_result = gt;\n}\n\nstatic void _quicksort_parallel(int *toorder, int lo, int hi, int depth)\n{\n    if (lo >= hi) {\n        return;\n    }\n\n    int length = hi - lo + 1;\n    if (length <= INSERTION_CUTOFF) {\n        insertion_sort(toorder, lo, hi);\n        return;\n    }\n    if (depth <= 0) {\n        heapsort_range(toorder, lo, hi);\n        return;\n    }\n\n    int lt, gt;\n    partition_three(toorder, lo, hi, &lt, &gt);\n    int left_length = lt - lo;\n    int right_length = hi - gt;\n\n    if (length < PARALLEL_CUTOFF) {\n        _quicksort_parallel(toorder, lo, lt - 1, depth - 1);\n        _quicksort_parallel(toorder, gt + 1, hi, depth - 1);\n        return;\n    }\n\n    int spawned = 0;\n    if (left_length <= right_length) {\n        if (left_length >= PARALLEL_CUTOFF) {\n            #pragma omp task default(none) firstprivate(toorder, lo, lt, depth)\n            _quicksort_parallel(toorder, lo, lt - 1, depth - 1);\n            spawned = 1;\n        } else {\n            _quicksort_parallel(toorder, lo, lt - 1, depth - 1);\n        }\n        _quicksort_parallel(toorder, gt + 1, hi, depth - 1);\n    } else {\n        if (right_length >= PARALLEL_CUTOFF) {\n            #pragma omp task default(none) firstprivate(toorder, gt, hi, depth)\n            _quicksort_parallel(toorder, gt + 1, hi, depth - 1);\n            spawned = 1;\n        } else {\n            _quicksort_parallel(toorder, gt + 1, hi, depth - 1);\n        }\n        _quicksort_parallel(toorder, lo, lt - 1, depth - 1);\n    }\n\n    if (spawned) {\n        #pragma omp taskwait\n    }\n}\n\nvoid swap(int *toorder, int i, int j)\n{\n    int temp = toorder[i];\n    toorder[i] = toorder[j];\n    toorder[j] = temp;\n}\n\nint is_sorted(int *toorder, int N)\n{\n    if (N <= 1) {\n        return 0;\n    }\n\n    int unsorted = 0;\n    if (N >= PARALLEL_CUTOFF) {\n        #pragma omp parallel for schedule(static) reduction(|:unsorted)\n        for (int i = 1; i < N; i++) {\n            if (toorder[i] < toorder[i - 1]) {\n                unsorted = 1;\n            }\n        }\n    } else {\n        for (int i = 1; i < N; i++) {\n            if (toorder[i] < toorder[i - 1]) {\n                unsorted = 1;\n            }\n        }\n    }\n    return unsorted;\n}\n\nint *generate_case(int N)\n{\n    int i;\n    int *ret = NULL;\n\n    // Make case generation reproducible\n    srandnum(0);\n\n    // Allocate memory\n    ret = (int *) malloc(N * sizeof(int));\n    if (ret == NULL) {\n        printf(\"Error: some malloc won't work.\\n\");\n        return NULL;\n    }\n    // Get pseudo-random positive integer values\n    for (i = 0; i < N; i++) {\n        ret[i] = drand(0, INT_MAX);\n    }\n    return ret;\n}\n\ndouble drand(int xmin, int xmax)\n{\n    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;\n}\n",
        "path": "src/quicksort.c"
      }

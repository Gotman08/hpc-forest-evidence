{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <algorithm>\\n#include <cstddef>\\n#include <cstdio>\\n#include <iostream>\\n#include <iterator>\\n#include <string>\\n\\nclass BufferedOutput\\n{\\n    enum { buffer_capacity = 64 * 1024 };\\n    char buffer_[buffer_capacity];\\n    std::size_t used_;\\n\\npublic:\\n    BufferedOutput () : used_ (0) {}\\n\\n    ~BufferedOutput ()\\n    {\\n        flush () ;\\n    }\\n\\n    void flush ()\\n    {\\n        if (used_ != 0) {\\n            std::fwrite (buffer_, 1, used_, stdout) ;\\n            used_ = 0;\\n        }\\n    }\\n\\n    void put (char c)\\n    {\\n        if (used_ == buffer_capacity) flush () ;\\n        buffer_[used_++] = c;\\n    }\\n\\n    void write_permutation (const std::string& text)\\n    {\\n        const std::size_t count = text.size () ;\\n        if (count <= static_cast <std::size_t> ((buffer_capacity - 4) / 2)) {\\n            const std::size_t line_size = 2 * count + 4;\\n            if (used_ + line_size > buffer_capacity) flush () ;\\n\\n            char* line = buffer_ + used_;\\n            line [0] = '[' ;\\n            line [1] = ' ' ;\\n#if defined(__GNUC__)\\n#pragma GCC ivdep\\n#endif\\n            for (std::size_t i = 0 ; i < count ; ++ i) {\\n                line [2 + 2 * i] = text [i] ;\\n                line [3 + 2 * i] = ' ' ;\\n            }\\n            line [2 + 2 * count] = ']' ;\\n            line [3 + 2 * count] = '\\\\n' ;\\n            used_ += line_size;\\n            return;\\n        }\\n\\n        put ('[') ;\\n        put (' ') ;\\n        for (std::string::const_iterator it = text.begin () ; it != text.end () ; ++it) {\\n            put (*it) ;\\n            put (' ') ;\\n        }\\n        put (']') ;\\n        put ('\\\\n') ;\\n    }\\n} ;\\n\\nstruct PrintPermutation\\n{\\n    BufferedOutput& output;\\n\\n    explicit PrintPermutation (BufferedOutput& out) : output (out) {}\\n\\n    auto operator () (const std::string& text) const -> void\\n    {\\n        output.write_permutation (text) ;\\n    }\\n} ;\\n\\nstruct IsWhitespace\\n{\\n    template <typename Char> auto\\n    operator () (Char c) const -> bool\\n    {\\n        return (c == ' ' )\\n            || (c == '\\\\n')\\n            || (c == '\\\\r')\\n            || (c == '\\\\t')\\n            || (c == '\\\\f')\\n            || (c == '\\\\v') ;\\n    }\\n} ;\\n\\ntemplate <typename String> inline auto\\nremove_whitespaces (String text) -> String\\n{\\n    text.erase\\n        ( std::remove_if\\n            ( text.begin ()\\n            , text.end ()\\n            , IsWhitespace () )\\n        , text.end () ) ;\\n    return text ;\\n}\\n\\ninline auto\\nnext_permutation (std::string& text) -> bool\\n{\\n    if (text.size () < 2) return false;\\n\\n    std::size_t suffix = text.size ();\\n    while ((suffix > 1) && (text [suffix - 2] >= text [suffix - 1])) {\\n        --suffix;\\n    }\\n    if (suffix == 1) return false;\\n\\n    const std::size_t pivot = suffix - 2;\\n    std::size_t successor = text.size () - 1;\\n    while (text [successor] <= text [pivot]) {\\n        --successor;\\n    }\\n    std::swap (text [pivot], text [successor]) ;\\n    std::reverse (text.begin () + (suffix - 1), text.end ()) ;\\n    return true;\\n}\\n\\ntemplate <typename String, typename Function> inline auto\\npermutations (String text, Function& driver) -> void\\n{\\n    if (text.empty ()) return;\\n    std::sort (text.begin (), text.end ()) ;\\n    do {\\n        driver (text) ;\\n    } while (::next_permutation (text)) ;\\n}\\n\\ntemplate <typename String, typename InStream> inline auto\\nread_text_from_stdin (InStream& in) -> String\\n{\\n    std::istreambuf_iterator <char> begin (in), end ;\\n    std::string text (begin, end) ;\\n    text = remove_whitespaces (text) ;\\n    return text ;\\n}\\n\\nint main (int argc, char const *argv [])\\n{\\n    std::ios::sync_with_stdio (false) ;\\n    std::cin.tie (nullptr) ;\\n    std::string text = read_text_from_stdin <std::string> (std::cin) ;\\n    BufferedOutput output;\\n    PrintPermutation printer (output);\\n    permutations (text, printer) ;\\n    return 0;\\n}\",\"path\":\"src/permutations.cc\"}],\"hypothesis\":\"Fusing indexed lexicographic succession with a bounded fwrite buffer and affine indexed row formatting may reduce successor and per-character output overhead while preserving the complete sorted permutation output.\",\"notes\":\"The affine formatter writes directly into the reusable output buffer for rows that fit; longer rows use a streaming fallback to avoid size overflow or oversized temporary allocations. No commands were run.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[\"420047be406141e0\",\"d6755543c395449e\",\"6e4d687a49214498\"],\"transformations\":[\"Replace generic iterator successor helpers with an in-place indexed lexicographic successor over the string; pass the stateful output driver by reference.\",\"Format rows using independent affine indexed stores directly in a reusable 64 KiB buffer, flushed through fwrite; stream rows larger than the buffer capacity.\",\"Use a GCC ivdep hint on the independent output stores and disable iostream synchronization and cin ties for input.\"]}"}}

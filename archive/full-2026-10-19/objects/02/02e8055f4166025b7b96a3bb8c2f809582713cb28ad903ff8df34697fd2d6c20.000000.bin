  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Compute four target bodies together, sharing source-coordinate loads.\n * Every target retains its original ascending-j accumulation order.\n */\nvoid body_force(Body *p, float dt, int n) {\n  int i = 0;\n  for (; i <= n - 4; i += 4) {\n    const float x0 = p[i].x;\n    const float y0 = p[i].y;\n    const float z0 = p[i].z;\n    const float x1 = p[i + 1].x;\n    const float y1 = p[i + 1].y;\n    const float z1 = p[i + 1].z;\n    const float x2 = p[i + 2].x;\n    const float y2 = p[i + 2].y;\n    const float z2 = p[i + 2].z;\n    const float x3 = p[i + 3].x;\n    const float y3 = p[i + 3].y;\n    const float z3 = p[i + 3].z;\n\n    float fx0 = 0.0f;\n    float fy0 = 0.0f;\n    float fz0 = 0.0f;\n    float fx1 = 0.0f;\n    float fy1 = 0.0f;\n    float fz1 = 0.0f;\n    float fx2 = 0.0f;\n    float fy2 = 0.0f;\n    float fz2 = 0.0f;\n    float fx3 = 0.0f;\n    float fy3 = 0.0f;\n    float fz3 = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      const float xj = p[j].x;\n      const float yj = p[j].y;\n      const float zj = p[j].z;\n\n      {\n        float dx = xj - x0;\n        float dy = yj - y0;\n        float dz = zj - z0;\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx0 += dx * inv_dist3;\n        fy0 += dy * inv_dist3;\n        fz0 += dz * inv_dist3;\n      }\n      {\n        float dx = xj - x1;\n        float dy = yj - y1;\n        float dz = zj - z1;\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx1 += dx * inv_dist3;\n        fy1 += dy * inv_dist3;\n        fz1 += dz * inv_dist3;\n      }\n      {\n        float dx = xj - x2;\n        float dy = yj - y2;\n        float dz = zj - z2;\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx2 += dx * inv_dist3;\n        fy2 += dy * inv_dist3;\n        fz2 += dz * inv_dist3;\n      }\n      {\n        float dx = xj - x3;\n        float dy = yj - y3;\n        float dz = zj - z3;\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx3 += dx * inv_dist3;\n        fy3 += dy * inv_dist3;\n        fz3 += dz * inv_dist3;\n      }\n    }\n\n    p[i].vx += dt*fx0;\n    p[i].vy += dt*fy0;\n    p[i].vz += dt*fz0;\n    p[i + 1].vx += dt*fx1;\n    p[i + 1].vy += dt*fy1;\n    p[i + 1].vz += dt*fz1;\n    p[i + 2].vx += dt*fx2;\n    p[i + 2].vy += dt*fy2;\n    p[i + 2].vz += dt*fz2;\n    p[i + 3].vx += dt*fx3;\n    p[i + 3].vy += dt*fy3;\n    p[i + 3].vz += dt*fz3;\n  }\n\n  for (; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n  \n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Four-target blocking can reduce source-coordinate load traffic and expose independent arithmetic while preserving each body's ascending-j force accumulation.",
  "notes": "Preserves arithmetic expressions, double-precision sqrt, ten iterations, and binary I/O. Uses no additional allocation or threading. Not executed or measured.",

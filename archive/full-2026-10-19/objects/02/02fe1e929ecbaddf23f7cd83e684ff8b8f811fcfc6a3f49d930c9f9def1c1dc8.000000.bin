{
  "src/knn.c": "#include \"knn.h\"\n#include <limits.h>\n\ntypedef struct {\n    float distance;\n    int group;\n} Candidate;\n\nstatic char winning_label(const size_t *votes) {\n    char winner = (char)-1;\n    size_t maximum = 0;\n\n    for (int c = 0; c <= UCHAR_MAX; ++c) {\n        if (votes[c] > maximum ||\n            (votes[c] != 0 && votes[c] == maximum && (char)c < winner)) {\n            maximum = votes[c];\n            winner = (char)c;\n        }\n    }\n    return winner;\n}\n\n/* Preserve the original insertion behavior for unordered distances. */\nstatic char insertion_knn(int n_groups, Group *groups, int k, Point point) {\n    char *labels = (char *)malloc((size_t)k * sizeof(*labels));\n    float *distances = (float *)malloc((size_t)k * sizeof(*distances));\n    if (!labels || !distances) {\n        free(labels);\n        free(distances);\n        abort();\n    }\n\n    for (int i = 0; i < k; ++i) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; ++j) {\n            float d = euclidean_distance_no_sqrt(point, g.points[j]);\n            for (int x = 0; x < k; ++x) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (int y = k - 1; y > x; --y) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    size_t votes[UCHAR_MAX + 1] = {0};\n    for (int i = 0; i < k; ++i)\n        ++votes[(unsigned char)labels[i]];\n    free(labels);\n    free(distances);\n    return winning_label(votes);\n}\n\nstatic inline int candidate_less(const Candidate *a, const Candidate *b) {\n    return a->distance < b->distance ||\n           (a->distance == b->distance && a->group < b->group);\n}\n\nstatic int candidate_compare(const void *a, const void *b) {\n    const Candidate *left = (const Candidate *)a;\n    const Candidate *right = (const Candidate *)b;\n    if (candidate_less(left, right)) return -1;\n    if (candidate_less(right, left)) return 1;\n    return 0;\n}\n\nstatic inline void candidate_swap(Candidate *a, Candidate *b) {\n    Candidate temporary = *a;\n    *a = *b;\n    *b = temporary;\n}\n\n/* Partition the best keep records into the prefix of a reusable buffer. */\nstatic void retain_best(Candidate *buffer, size_t count, size_t keep) {\n    size_t target = keep - 1;\n    size_t first = 0;\n    size_t last = count;\n    size_t budget = count * 2;\n\n    while (last - first > 24) {\n        size_t length = last - first;\n        if (length > budget) {\n            qsort(buffer + first, length, sizeof(*buffer), candidate_compare);\n            return;\n        }\n        budget -= length;\n\n        size_t middle = first + length / 2;\n        if (candidate_less(buffer + middle, buffer + first))\n            candidate_swap(buffer + middle, buffer + first);\n        if (candidate_less(buffer + last - 1, buffer + middle))\n            candidate_swap(buffer + last - 1, buffer + middle);\n        if (candidate_less(buffer + middle, buffer + first))\n            candidate_swap(buffer + middle, buffer + first);\n        Candidate pivot = buffer[middle];\n\n        size_t lower = first;\n        size_t scan = first;\n        size_t upper = last;\n        while (scan < upper) {\n            if (candidate_less(buffer + scan, &pivot)) {\n                candidate_swap(buffer + lower, buffer + scan);\n                ++lower;\n                ++scan;\n            } else if (candidate_less(&pivot, buffer + scan)) {\n                --upper;\n                candidate_swap(buffer + scan, buffer + upper);\n            } else {\n                ++scan;\n            }\n        }\n\n        if (target < lower)\n            last = lower;\n        else if (target >= upper)\n            first = upper;\n        else\n            return;\n    }\n\n    for (size_t i = first + 1; i < last; ++i) {\n        Candidate value = buffer[i];\n        size_t j = i;\n        while (j > first && candidate_less(&value, buffer + j - 1)) {\n            buffer[j] = buffer[j - 1];\n            --j;\n        }\n        buffer[j] = value;\n    }\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) return (char)-1;\n\n    size_t total = 0;\n    for (int i = 0; i < n_groups; ++i) {\n        if (groups[i].length > 0) {\n            size_t length = (size_t)groups[i].length;\n            if (length > (size_t)-1 - total)\n                return insertion_knn(n_groups, groups, k, to_evaluate);\n            total += length;\n        }\n    }\n\n    size_t votes[UCHAR_MAX + 1] = {0};\n    size_t keep = (size_t)k;\n    if (total <= keep) {\n        for (int i = 0; i < n_groups; ++i) {\n            if (groups[i].length > 0)\n                votes[(unsigned char)groups[i].label] += (size_t)groups[i].length;\n        }\n        votes[(unsigned char)-1] += keep - total;\n        return winning_label(votes);\n    }\n\n    size_t extra = total - keep;\n    if (extra > keep) extra = keep;\n    size_t capacity = keep + extra;\n    if (capacity > (size_t)-1 / sizeof(Candidate))\n        return insertion_knn(n_groups, groups, k, to_evaluate);\n\n    Candidate *buffer = (Candidate *)malloc(capacity * sizeof(*buffer));\n    if (!buffer)\n        return insertion_knn(n_groups, groups, k, to_evaluate);\n\n    size_t used = 0;\n    float cutoff = 0;\n    int have_cutoff = 0;\n\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; ++j) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            if (d != d) {\n                free(buffer);\n                return insertion_knn(n_groups, groups, k, to_evaluate);\n            }\n\n            /* Later equal-distance points cannot improve the retained vote. */\n            if (have_cutoff && d >= cutoff) continue;\n\n            buffer[used].distance = d;\n            buffer[used].group = i;\n            ++used;\n            if (used == capacity) {\n                retain_best(buffer, used, keep);\n                used = keep;\n                cutoff = buffer[keep - 1].distance;\n                have_cutoff = 1;\n            }\n        }\n    }\n\n    if (used > keep)\n        retain_best(buffer, used, keep);\n    for (size_t i = 0; i < keep; ++i)\n        ++votes[(unsigned char)groups[buffer[i].group].label];\n\n    free(buffer);\n    return winning_label(votes);\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
  "src/knn.h": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}"
}

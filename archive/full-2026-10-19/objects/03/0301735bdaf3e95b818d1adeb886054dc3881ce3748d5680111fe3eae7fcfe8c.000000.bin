#include<stdio.h>
#include<stdlib.h>
#include<math.h>

static int use_parallel_columns(int lin, int col) {
    size_t rows, columns, target;

    if (lin <= 0 || col < 4) {
        return 0;
    }

    rows = (size_t)lin;
    columns = (size_t)col;
    target = (size_t)262144 / columns;
    if ((size_t)262144 % columns != 0) {
        target++;
    }

    /* Equivalent to rows * rows * columns >= 262144 without overflow. */
    return rows >= target / rows + (target % rows != 0);
}

void bubble_sort(double *matriz, int tam) {
    int i, j;
    double aux;

    for (i = tam - 1; i > 0; i--) {
        for (j = 0; j < i; j++) {
            if (matriz[j] > matriz[j + 1]) {
                aux = matriz[j];
                matriz[j] = matriz[j + 1];
                matriz[j + 1] = aux;
            }
        }
    }
}

static double moda_aux_com_nan(double *matriz, int lin) {
    int i, j;
    int melhor_contagem = 0;
    double moda = -1;

    for (i = 0; i < lin; i++) {
        int conta = 0;
        for (j = i + 1; j < lin; j++) {
            if (matriz[i] == matriz[j]) {
                conta++;
            }
        }
        if (conta > melhor_contagem) {
            melhor_contagem = conta;
            moda = matriz[i];
        }
    }
    return moda;
}

static double moda_aux(double *matriz, int lin) {
    int i = 0;
    int maior_contagem = 1;
    double moda = -1;

    while (i < lin) {
        int fim;
        if (matriz[i] != matriz[i]) {
            return moda_aux_com_nan(matriz, lin);
        }
        fim = i + 1;
        while (fim < lin) {
            if (matriz[fim] != matriz[fim]) {
                return moda_aux_com_nan(matriz, lin);
            }
            if (matriz[fim] != matriz[i]) {
                break;
            }
            fim++;
        }
        if (fim - i > maior_contagem) {
            maior_contagem = fim - i;
            moda = matriz[i];
        }
        i = fim;
    }
    return moda;
}

static void calcula_colunas(double *matriz, double *mediana, double *media,
                            double *media_har, double *moda,
                            double *variancia, double *dp, double *cv,
                            int lin, int col) {
    int i, j;

    #pragma omp for schedule(static)
    for (i = 0; i < col; i++) {
        double soma, soma_inversos, valor;
        int indice;

        soma = 0;
        soma_inversos = 0;
        for (j = 0; j < lin; j++) {
            valor = matriz[i * lin + j];
            soma += valor;
            soma_inversos += 1 / valor;
        }
        media[i] = soma / lin;
        media_har[i] = lin / soma_inversos;

        bubble_sort(&matriz[i * lin], lin);

        indice = ((i * lin) + (i + 1) * lin - 1) / 2;
        if ((lin - 1) % 2) {
            mediana[i] = matriz[indice] + matriz[indice + 1];
            mediana[i] *= 0.5;
        } else {
            mediana[i] = matriz[indice];
        }

        moda[i] = moda_aux(matriz + (i * lin), lin);

        soma = 0;
        for (j = 0; j < lin; j++) {
            soma += pow((matriz[i * lin + j] - media[i]), 2);
        }
        variancia[i] = soma / (lin - 1);
        dp[i] = sqrt(variancia[i]);
        cv[i] = dp[i] / media[i];
    }
}

int main(int argc, char **argv) {
    int lin, col, i, j, parallel_columns;
    double *matriz, *mediana, *media, *media_har, *moda;
    double *variancia, *dp, *cv;

    fscanf(stdin, "%d ", &lin);
    fscanf(stdin, "%d\n", &col);
    parallel_columns = use_parallel_columns(lin, col);

    matriz = (double *)malloc(lin * col * sizeof(double));
    media = (double *)malloc(col * sizeof(double));
    media_har = (double *)malloc(col * sizeof(double));
    mediana = (double *)malloc(col * sizeof(double));
    moda = (double *)malloc(col * sizeof(double));
    variancia = (double *)malloc(col * sizeof(double));
    cv = (double *)malloc(col * sizeof(double));
    dp = (double *)malloc(col * sizeof(double));

    for (i = 0; i < lin; i++) {
        for (j = 0; j < col; j++) {
            fscanf(stdin, "%lf ", &(matriz[j * lin + i]));
        }
    }

    #pragma omp parallel num_threads(4) if(parallel_columns)
    {
        calcula_colunas(matriz, mediana, media, media_har, moda,
                        variancia, dp, cv, lin, col);
    }

    for (i = 0; i < col; i++)
        printf("%.1lf ", media[i]);
    printf("\n");
    for (i = 0; i < col; i++)
        printf("%.1lf ", media_har[i]);
    printf("\n");
    for (i = 0; i < col; i++)
        printf("%.1lf ", mediana[i]);
    printf("\n");
    for (i = 0; i < col; i++)
        printf("%.1lf ", moda[i]);
    printf("\n");
    for (i = 0; i < col; i++)
        printf("%.1lf ", variancia[i]);
    printf("\n");
    for (i = 0; i < col; i++)
        printf("%.1lf ", dp[i]);
    printf("\n");
    for (i = 0; i < col; i++)
        printf("%.1lf ", cv[i]);
    printf("\n");

    free(matriz);
    free(media);
    free(media_har);
    free(mediana);
    free(moda);
    free(variancia);
    free(dp);
    free(cv);
}

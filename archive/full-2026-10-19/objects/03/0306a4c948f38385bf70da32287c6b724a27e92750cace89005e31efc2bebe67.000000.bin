"""Closed pure selection; no I/O, model aliases, pilot, inference, or implicit loop."""
from __future__ import annotations

import re

MODELS = ("gpt-6.1-sol", "gpt-6-astra", "gpt-5.6-terra")
PHASES = ("roots", "advice", "harvest")
SLUGS = {"gpt-6.1-sol": "sol-max", "gpt-6-astra": "astra-max", "gpt-5.6-terra": "terra-max"}
CELLS = {
    "gpt-6.1-sol": {"roots": "3b1de5658e4641149b15a3bea4850239", "advice": "b86d18fcf35d4031aa2ef0da49397c4e", "harvest": "7c8bc0c5ae22467da05600fb735fc017"},
    "gpt-6-astra": {"roots": "7b6c29c0e329400bb2be145b0e2dbe0a", "advice": "7be16898433e49f4b481045079abbbe8", "harvest": "b6fc9cf3951d46d787f319b51905251b"},
    "gpt-5.6-terra": {"roots": "bd2b3153a7544c909afbc19fe69902b4", "advice": "7516e40883c64ab8af8a38637d74de3f", "harvest": "7d6f357d4e5741bb8349835f358563b2"},
}
# Historical jobs are never adopted as new technical allocations. Fresh root,
# cache, exclusive submit intent and actual observed submission are also required.
BEGUN_JOBS = frozenset({"751592", "751992", "752139", "752140", "752141", "752306"})
MAXIMUM_NATIVE_WORKERS = 4


def select(model, phase, *, effort="max", session_id=None, job_id=None):
    if model not in MODELS or phase not in PHASES or effort != "max":
        raise ValueError("Only exact Sol/Astra/Terra MAX technical cells are selectable")
    session = CELLS[model][phase]
    if session_id is not None and session_id != session:
        raise ValueError("Exact model/phase session required; no cross-cell or replay")
    if job_id is not None and (not isinstance(job_id, str) or re.fullmatch(r"[0-9]+", job_id) is None
                               or job_id in BEGUN_JOBS):
        raise ValueError("New actual observed job required; historical jobs are refused")
    return session


def previous_phases(phase):
    if phase not in PHASES:
        raise ValueError("Pilot and unknown phase are closed")
    return PHASES[:PHASES.index(phase)]


def check_capacity(active_before):
    if type(active_before) is not int or not 0 <= active_before < MAXIMUM_NATIVE_WORKERS:
        raise ValueError("Cap4 includes the actual SO contribution, other active pairs and proposed worker")
    return active_before

    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <math.h>\\n\\n#define N_ITER 10 // number of simulation iterations\\n#define DT 0.01f // time step\\n#define SOFTENING 1e-9f // to avoid zero divisors\\n\\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\\n\\n/*\\n * Compute gravitational forces using a structure-of-arrays layout.\\n * Each thread processes a small tile of bodies (TILE=4) so that the\\n * four independent force accumulators can be vectorized across i,\\n * while every body still accumulates over j in strictly increasing\\n * order, preserving bit-exact floating-point results.  The SoA layout\\n * improves cache-line utilization when streaming through all bodies.\\n */\\nstatic void body_force(float * restrict x, float * restrict y, float * restrict z,\\n                       float * restrict vx, float * restrict vy, float * restrict vz,\\n                       float dt, int n) {\\n  const int TILE = 4;\\n\\n  #pragma omp parallel for schedule(static)\\n  for (int ib = 0; ib < n; ib += TILE) {\\n    int imax = ib + TILE;\\n    if (imax > n) imax = n;\\n    const int ntile = imax - ib;\\n\\n    float fx[TILE], fy[TILE], fz[TILE];\\n    float xi[TILE], yi[TILE], zi[TILE];\\n\\n    for (int t = 0; t < ntile; ++t) {\\n      const int i = ib + t;\\n      xi[t] = x[i];\\n      yi[t] = y[i];\\n      zi[t] = z[i];\\n      fx[t] = fy[t] = fz[t] = 0.0f;\\n    }\\n\\n    for (int j = 0; j < n; ++j) {\\n      const float pjx = x[j];\\n      const float pjy = y[j];\\n      const float pjz = z[j];\\n\\n      #pragma omp simd\\n      for (int t = 0; t < ntile; ++t) {\\n        const float dx = pjx - xi[t];\\n        const float dy = pjy - yi[t];\\n        const float dz = pjz - zi[t];\\n        const float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n        const float inv_dist = 1.0f / sqrt(sqrd_dist);\\n        const float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n\\n        fx[t] += dx * inv_dist3;\\n        fy[t] += dy * inv_dist3;\\n        fz[t] += dz * inv_dist3;\\n      }\\n    }\\n\\n    for (int t = 0; t < ntile; ++t) {\\n      const int i = ib + t;\\n      vx[i] += dt*fx[t];\\n      vy[i] += dt*fy[t];\\n      vz[i] += dt*fz[t];\\n    }\\n  }\\n}\\n\\nstatic Body* read_dataset(int *nbodies) {\\n  if (fread(nbodies, sizeof(*nbodies), 1, stdin) != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading nbodie value\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n  Body *tmp = (Body *)malloc(*nbodies * sizeof(Body));\\n  if (!tmp || fread(tmp, *nbodies * sizeof(Body), 1, stdin) != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading input values\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n  return tmp;\\n}\\n\\nint main(int argc, char **argv) {\\n  int n;\\n  Body *bodies = read_dataset(&n);\\n\\n  float *x, *y, *z, *vx, *vy, *vz;\\n  if (posix_memalign((void**)&x, 64, n*sizeof(float)) != 0 ||\\n      posix_memalign((void**)&y, 64, n*sizeof(float)) != 0 ||\\n      posix_memalign((void**)&z, 64, n*sizeof(float)) != 0 ||\\n      posix_memalign((void**)&vx, 64, n*sizeof(float)) != 0 ||\\n      posix_memalign((void**)&vy, 64, n*sizeof(float)) != 0 ||\\n      posix_memalign((void**)&vz, 64, n*sizeof(float)) != 0) {\\n    fprintf(stderr,\\\"\\\\nMemory allocation failed\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n\\n  for (int i = 0; i < n; ++i) {\\n    x[i] = bodies[i].x;\\n    y[i] = bodies[i].y;\\n    z[i] = bodies[i].z;\\n    vx[i] = bodies[i].vx;\\n    vy[i] = bodies[i].vy;\\n    vz[i] = bodies[i].vz;\\n  }\\n\\n  for (int iter = 0; iter < N_ITER; ++iter) {\\n    body_force(x, y, z, vx, vy, vz, DT, n);\\n\\n    #pragma omp parallel for schedule(static)\\n    for (int i = 0; i < n; ++i) {\\n      x[i] += vx[i] * DT;\\n      y[i] += vy[i] * DT;\\n      z[i] += vz[i] * DT;\\n    }\\n  }\\n\\n  for (int i = 0; i < n; ++i) {\\n    bodies[i].x = x[i];\\n    bodies[i].y = y[i];\\n    bodies[i].z = z[i];\\n    bodies[i].vx = vx[i];\\n    bodies[i].vy = vy[i];\\n    bodies[i].vz = vz[i];\\n  }\\n\\n  if (fwrite(bodies, n * sizeof(Body), 1, stdout) != 1) {\\n    fprintf(stderr,\\\"\\\\nError writing to output\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n\\n  free(x); free(y); free(z); free(vx); free(vy); free(vz);\\n  free(bodies);\\n  return EXIT_SUCCESS;\\n}\\n\",\n      \"path\": \"src/nbody.c\"\n    }\n  ],\n  \"hypothesis\": \"A structure-of-arrays layout with a small i-tile (4 bodies) lets the compiler vectorize across independent force accumulators while each body still sums over j in strictly increasing order, preserving bit-exact output. The SoA streaming pattern improves cache-line utilization and OpenMP static scheduling provides near-linear speedup on 4 cores.\",\n  \"notes\": \"The per-body accumulation order is unchanged (j from 0 to n-1), so floating-point results match the reference exactly. Arrays are aligned to 64 bytes for efficient SIMD loads/stores. The tile size of 4 keeps register pressure low and allows vectorization across i without altering any individual body's summation sequence.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Converted Body array-of-structs into six separate float arrays (SoA layout)\",\n    \"Added OpenMP parallel-for over small tiles of 4 bodies with static scheduling\",\n    \"Preloaded tile positions and used #pragma omp simd on the inner t-loop to vectorize across independent force accumulators\",\n    \"Aligned all coordinate/velocity arrays to 64-byte boundaries via posix_memalign\"\n  ]\n}",

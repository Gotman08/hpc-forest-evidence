#include <bits/stdc++.h>

using namespace std;

int A[1000][1000];

typedef long long ll;

ll solve(int m, int n, int k) {
  const int bands = min(m, n);
  const int scan_length = max(m, n);
  vector<int> prefix(static_cast<size_t>(bands + 1) * scan_length, 0);

  // Each boundary owns one contiguous plane in scan order.
  if (n < m) {
    for (int i = 0; i < m; i++) {
      int sum = 0;
      for (int j = 0; j < n; j++) {
        sum += A[i][j];
        prefix[static_cast<size_t>(j + 1) * scan_length + i] = sum;
      }
    }
  } else {
    for (int i = 0; i < m; i++) {
      const int* previous = prefix.data() + static_cast<size_t>(i) * scan_length;
      int* current = prefix.data() + static_cast<size_t>(i + 1) * scan_length;
      for (int j = 0; j < n; j++) {
        current[j] = previous[j] + A[i][j];
      }
    }
  }

  unordered_map<ll, ll> h;
  ll ans = 0;
  for (int first = 1; first <= bands; first++) {
    const int* before = prefix.data() + static_cast<size_t>(first - 1) * scan_length;
    for (int last = first; last <= bands; last++) {
      const int* after = prefix.data() + static_cast<size_t>(last) * scan_length;
      h.clear();
      h[0] = 1;
      ll s = 0;
      for (int i = 0; i < scan_length; i++) {
        s += after[i] - before[i];
        ans += h.find(s - k) != h.end() ? h[s - k] : 0;
        h[s]++;
      }
    }
  }
  return ans;
}

int main() {
  int k, m, n;
  cin >> k >> m >> n;
  memset(A, 0, sizeof A);

  for (int i = 0; i < m; i++)
    for (int j = 0; j < n; j++)
      cin >> A[i][j];

  cout << solve(m, n, k) << endl;
  return 0;
}

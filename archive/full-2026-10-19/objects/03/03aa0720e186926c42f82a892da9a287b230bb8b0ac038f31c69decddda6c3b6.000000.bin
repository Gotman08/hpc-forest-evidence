      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdint.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system.\n */\n#if defined(__GNUC__) && !defined(__clang__)\n#pragma GCC push_options\n#pragma GCC optimize (\"no-math-errno\")\n#endif\nvoid body_force(Body *p, float dt, int n) {\n  enum { SOURCE_BLOCK = 128 };\n\n  if (n <= 0) {\n    return;\n  }\n\n  size_t stride = ((size_t)n + 15u) & ~(size_t)15u;\n  void *storage = malloc(3u * stride * sizeof(float) + 63u);\n\n  if (storage == NULL) {\n    for (int i = 0; i < n; ++i) {\n      float fx = 0.0f;\n      float fy = 0.0f;\n      float fz = 0.0f;\n\n      for (int j = 0; j < n; j++) {\n        float dx = p[j].x - p[i].x;\n        float dy = p[j].y - p[i].y;\n        float dz = p[j].z - p[i].z;\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx += dx * inv_dist3;\n        fy += dy * inv_dist3;\n        fz += dz * inv_dist3;\n      }\n\n      p[i].vx += dt*fx;\n      p[i].vy += dt*fy;\n      p[i].vz += dt*fz;\n    }\n    return;\n  }\n\n  float *x = (float *)(((uintptr_t)storage + 63u) & ~(uintptr_t)63u);\n  float *y = x + stride;\n  float *z = y + stride;\n\n#ifdef _OPENMP\n#pragma omp parallel if(n >= 256)\n#endif\n  {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n    for (int i = 0; i < n; ++i) {\n      x[i] = p[i].x;\n      y[i] = p[i].y;\n      z[i] = p[i].z;\n    }\n\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n    for (int i = 0; i < n; ++i) {\n      const float xi = x[i];\n      const float yi = y[i];\n      const float zi = z[i];\n      float fx = 0.0f;\n      float fy = 0.0f;\n      float fz = 0.0f;\n      float dx[SOURCE_BLOCK];\n      float dy[SOURCE_BLOCK];\n      float dz[SOURCE_BLOCK];\n      float inv_dist3[SOURCE_BLOCK];\n\n      for (int jb = 0; jb < n; ) {\n        int count = n - jb;\n        if (count > SOURCE_BLOCK) {\n          count = SOURCE_BLOCK;\n        }\n\n        /* Independent pair geometry occupies a small contiguous panel. */\n#ifdef _OPENMP\n#pragma omp simd\n#elif defined(__GNUC__)\n#pragma GCC ivdep\n#endif\n        for (int k = 0; k < count; ++k) {\n          float ddx = x[jb + k] - xi;\n          float ddy = y[jb + k] - yi;\n          float ddz = z[jb + k] - zi;\n          float sqrd_dist = ddx*ddx + ddy*ddy + ddz*ddz + SOFTENING;\n          float inv_dist = 1 / sqrt(sqrd_dist);\n          dx[k] = ddx;\n          dy[k] = ddy;\n          dz[k] = ddz;\n          inv_dist3[k] = inv_dist * inv_dist * inv_dist;\n        }\n\n        /* Preserve source order and the original multiply/add expressions. */\n        for (int k = 0; k < count; ++k) {\n          fx += dx[k] * inv_dist3[k];\n          fy += dy[k] * inv_dist3[k];\n          fz += dz[k] * inv_dist3[k];\n        }\n        jb += count;\n      }\n\n      p[i].vx += dt*fx;\n      p[i].vy += dt*fy;\n      p[i].vz += dt*fz;\n    }\n  }\n\n  free(storage);\n}\n#if defined(__GNUC__) && !defined(__clang__)\n#pragma GCC pop_options\n#endif\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n  \n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Aligned position-only SoA snapshots and cache-resident source panels should reduce source traffic and enable SIMD pair calculations while preserving ordered force accumulation.",

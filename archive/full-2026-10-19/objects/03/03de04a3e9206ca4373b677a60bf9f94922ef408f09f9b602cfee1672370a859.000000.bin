    "files": [
      {
        "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nstatic inline void updateOpenSpan(int* dp, int begin, int end) {\n    int left = 0;\n    for (int col = begin; col < end; ++col) {\n        int value = dp[col] + left;\n        if (value >= MOD) value -= MOD;\n        dp[col] = value;\n        left = value;\n    }\n}\n\nint main() {\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<vector<int> > blockedColumns(n);\n    for (int c = 0; c < m; ++c) {\n        int row, col;\n        cin >> row >> col;\n        blockedColumns[row].push_back(col);\n    }\n\n    for (int row = 0; row < n; ++row) {\n        vector<int>& columns = blockedColumns[row];\n        sort(columns.begin(), columns.end());\n        columns.erase(unique(columns.begin(), columns.end()), columns.end());\n    }\n\n    vector<int> dp(n, 0);\n    dp[0] = 1;\n    int* const values = &dp[0];\n\n    for (int row = 0; row < n; ++row) {\n        const vector<int>& columns = blockedColumns[row];\n        int begin = 0;\n        for (size_t b = 0; b < columns.size(); ++b) {\n            const int blocked = columns[b];\n            updateOpenSpan(values, begin, blocked);\n            values[blocked] = 0;\n            begin = blocked + 1;\n        }\n        updateOpenSpan(values, begin, n);\n    }\n\n    cout << dp[n - 1] << endl;\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }
    ],
    "hypothesis": "One contiguous in-place DP array and obstacle-free row spans will reduce memory traffic and per-cell overhead compared with two DP rows, row copies, and a quadratic obstacle bitmask.",

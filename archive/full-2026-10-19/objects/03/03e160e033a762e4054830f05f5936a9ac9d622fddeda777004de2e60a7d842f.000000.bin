class Refusal(RuntimeError):
    pass


def require(ok, message):
    if not ok:
        raise Refusal(message)


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def ref(path):
    return {'path': str(Path(path).resolve()), 'sha256': sha(path)}


def artifact(value):
    require(isinstance(value, dict) and set(value) == {'path', 'sha256'}, 'Closed absolute path/SHA reference required')
    p = Path(value['path'])
    require(p.is_absolute() and not p.is_symlink() and p.is_file(), 'Missing/linked artifact')
    require(re.fullmatch('[0-9a-f]{64}', value['sha256']) and sha(p) == value['sha256'], 'Changed artifact')
    return p


def read(path):
    p = Path(path)
    require(not p.is_symlink() and p.is_file() and p.stat().st_size < 8 * 1024 * 1024, 'Missing/oversized JSON')
    value = json.loads(p.read_text(encoding='utf8'))
    require(isinstance(value, dict), 'JSON object required')
    return value


def save(directory, name, value):
    p = directory / name
    with p.open('x', encoding='utf8', newline='\n') as stream:
        stream.write(json.dumps(value, ensure_ascii=False, indent=2) + '\n')
    return ref(p)


def selected_cell(model):
    require(model in CELLS, 'One explicit Astra/Terra/Sol MAX cell required; Luna cannot be replayed')
    return model, CELLS[model]


def configure(binding_ref, selected_model):
    global BINDING, MODEL, SESSION, SCOPE, SOURCE, PLAN, RUNTIME, RUNTIME_PATH, SOURCE_ZIP
    global PROJECT, SEALED, SOURCE_MEMBERS, EXTRACTION, REMOTE_QUALIFICATION_ROOT, REMOTE_ROOT, ADMISSION_ROOT
    global QRECEPTION, QAUDIT, QARCHIVE, QJSON, QUALIFICATION_JOB
    value = read(artifact(binding_ref))
    fields = {'schema', 'verified', 'scope_id', 'source_zip', 'plan', 'runtime_manifest', 'project_path',
              'source_member_count', 'remote_extraction', 'remote_qualification_root', 'qualification',
              'qualification_reception', 'source_review', 'maximum_native_workers', 'cells'}
    require(set(value) == fields and value.get('schema') == 'hpc-forest-max-cap4-source-bindings-v1'
            and value.get('verified') is True and value.get('maximum_native_workers') == 4
            and value.get('cells') == CELLS, 'Actual independently reviewed cap4 source/plan/qualification bindings required')
    MODEL, SESSION = selected_cell(selected_model)
    for key in ('source_zip', 'plan', 'runtime_manifest', 'qualification', 'qualification_reception', 'source_review'):
        artifact(value[key])
    plan = read(artifact(value['plan']))
    review = read(artifact(value['source_review']))
    require(plan.get('scope_id') == value['scope_id'] and plan.get('source_zip_sha256') == value['source_zip']['sha256']
            and plan.get('cells') == CELLS and plan.get('maximum_native_workers_total') == 4
            and plan.get('maximum_cells_per_authorization') == 1 and plan.get('automatic_extension') is False
            and plan.get('efforts') == ['max']
            and plan.get('preparation_manifest_sha256') == PREP
            and all(plan.get(k) == v for k, v in {'tokens_ceiling': 1500000, 'search_seconds_ceiling': 1800,
                'maximum_program_missions': 8, 'maximum_mother_calls': 2, 'confirmation_seconds': 120}.items()), 'The actual sealed plan must authorize cap4 and one cell per command')
    require(review.get('verified') is True and review.get('blocking_findings') == []
            and review.get('source_zip_sha256') == value['source_zip']['sha256']
            and review.get('plan_sha256') == value['plan']['sha256']
            and review.get('native_research_admitted') is False, 'Actual new source independent review required')
    SCOPE, SOURCE, PLAN = value['scope_id'], value['source_zip']['sha256'], value['plan']['sha256']
    require(isinstance(SCOPE, str) and re.fullmatch(r'hpc-forest-primes-native-max-r2[a-z]', SCOPE), 'Closed new derivative scope required')
    SOURCE_ZIP, SEALED = artifact(value['source_zip']), artifact(value['plan']).parent
    require(SOURCE_ZIP.parent == SEALED and artifact(value['plan']).name == 'native-max-plan.json', 'One sealed local source package required')
    PROJECT, RUNTIME_PATH = Path(value['project_path']), artifact(value['runtime_manifest'])
    require(PROJECT.is_absolute() and PROJECT.is_dir() and not PROJECT.is_symlink(), 'Actual local project required')
    RUNTIME, SOURCE_MEMBERS = value['runtime_manifest']['sha256'], value['source_member_count']
    require(type(SOURCE_MEMBERS) is int and 90 <= SOURCE_MEMBERS <= 200, 'Exact independently inventoried member count required')
    EXTRACTION, REMOTE_QUALIFICATION_ROOT = value['remote_extraction'], value['remote_qualification_root']
    for path in (EXTRACTION, REMOTE_QUALIFICATION_ROOT):
        pp = PurePosixPath(path)
        require(pp.is_absolute() and '..' not in pp.parts and str(pp) == path and '\\' not in path
                and path.startswith('/scratch_p/nimarano/'), 'Exact reviewed absolute deployment roots required')
    require(EXTRACTION == REMOTE_QUALIFICATION_ROOT + '/extraction', 'Deployment roots must be the same qualified extraction')
    REMOTE_ROOT = '/scratch_p/nimarano/' + SCOPE + '-' + SESSION
    ADMISSION_ROOT = '/scratch_p/nimarano/' + SCOPE + '-admission-' + SESSION
    reception = read(artifact(value['qualification_reception']))
    q = read(artifact(value['qualification']))
    audit = read(artifact(reception['audit']))
    QRECEPTION, QAUDIT, QARCHIVE = value['qualification_reception']['sha256'], reception['audit']['sha256'], reception['archive']['sha256']
    QJSON, QUALIFICATION_JOB = value['qualification']['sha256'], str(q.get('allocation', {}).get('job_id', ''))
    require(QUALIFICATION_JOB.isdigit() and q.get('source_zip_sha256') == SOURCE and q.get('plan_sha256') == PLAN
            and reception.get('qualification_sha256') == QJSON and audit.get('verified') is True
            and audit.get('source_zip_sha256') == SOURCE and audit.get('plan_sha256') == PLAN
            and audit.get('qualification_sha256') == QJSON and audit.get('archive_sha256') == QARCHIVE
            and audit.get('native_model_calls') == 0, 'Actual NEW cap4 mechanical qualification and reception required')
    artifact(reception['archive'])
    BINDING = value
    return value


def render_preflight():
    require(BINDING is not None and MODEL in CELLS and SESSION == CELLS[MODEL], 'Actual selected cell bindings required')
    payload = {'scope_id': SCOPE, 'model': MODEL, 'effort': EFFORT, 'session_id': SESSION,
        'source_sha256': SOURCE, 'plan_sha256': PLAN, 'runtime_sha256': RUNTIME, 'source_members': SOURCE_MEMBERS,
        'remote_extraction': EXTRACTION, 'remote_root': REMOTE_ROOT, 'admission_root': ADMISSION_ROOT,
        'source_zip_name': SOURCE_ZIP.name, 'qualification_job': QUALIFICATION_JOB,
        'cells': CELLS, 'maximum_native_workers': 4}
    template = (OUT / 'allocated-preflight-template.py').read_text(encoding='utf8')
    require(template.count('__CELL_BINDINGS_LITERAL__') == 1, 'Exact one-cell preflight template required')
    return template.replace('__CELL_BINDINGS_LITERAL__', repr(payload))


def native():
    require(BINDING is not None, 'Actual cap4 source/plan/qualification bindings required')
    require(sha(SOURCE_ZIP) == SOURCE, 'Sealed source changed')
    require(sha(SEALED / 'native-max-plan.json') == PLAN, 'Sealed plan changed')
    manifest = RUNTIME_PATH
    require(sha(manifest) == RUNTIME, 'Runtime inventory changed')
    expected = read(manifest)
    actual = {p.relative_to(PROJECT).as_posix(): sha(p) for p in PROJECT.rglob('*') if p.is_file()
              and not any(x in {'__pycache__', '.pytest_cache', '.ruff_cache'} for x in p.relative_to(PROJECT).parts)}
    require(len(expected) == SOURCE_MEMBERS and actual == expected, 'Executing source must equal the new independently inventoried runtime')
    sys.path.insert(0, str(PROJECT / 'src'))
    module = importlib.import_module('hpc_forest.native_r2max')
    require(Path(module.__file__).resolve() == PROJECT / 'src/hpc_forest/native_r2max.py'
            and module.SCOPE == SCOPE and module.CELLS == CELLS and module.EFFORT == 'max', 'Wrong imported runtime/cell/scope')
    module.verify_runtime(SOURCE_ZIP)
    return module


def cell_identity(value):
    require(all(value.get(k) == v for k, v in {'scope_id': SCOPE, 'model': MODEL, 'effort': EFFORT,
            'session_id': SESSION, 'remote_root': REMOTE_ROOT}.items()), 'Only the reserved single selected MAX cell cell is allowed')
    require(str(value.get('job_id', '')).isdigit(), 'Actual future submitted job ID required')


def checked_luna(closure_ref):
    require(closure_ref['sha256'] == LUNA_CLOSURE, 'Exact actual bounded Luna closure required')
    closure = read(artifact(closure_ref))
    require(closure.get('schema') == 'hpc-forest-r2max-luna-bounded-closure-v1'
            and closure.get('closed_received_audited_reconciled_with_explicit_raw_limit') is True
            and closure.get('source_only_preserved') is True and closure.get('model_calls_replayed') == 0,
            'Actual bounded closure is not complete')
    require(closure['audit']['sha256'] == LUNA_AUDIT and closure['owned_stop']['sha256'] == LUNA_STOP,
            'Actual post-stop audit/owned stop changed')
    audit, stop = read(artifact(closure['audit'])), read(artifact(closure['owned_stop']))
    common = {'job_id': '751992', 'session_id': 'c8044062692149138d826d3f388a08ef', 'model': 'gpt-6-luna', 'effort': 'max'}
    for value in (closure, audit, stop):
        require(all(value.get(k) == v for k, v in common.items()), 'Luna identity changed')
    require(audit.get('source_zip_sha256') == LUNA_SOURCE and audit.get('plan_sha256') == LUNA_PLAN
            and audit.get('audit_error') is None and audit.get('evidence_inventory_before_after_identical') is True
            and audit.get('received_cohort_audited_with_explicit_raw_attribution_limit') is True,
            'Post-stop cohort audit is required')
    require(all(audit.get(k) is False for k in ('verified', 'native_research_admitted',
            'independent_performance_audit_verified', 'independent_raw_stdout_per_candidate_verified',
            'hardware_or_process_isolation_proved')), 'Bounded audit limits must remain false')
    cache = audit.get('cache_preservation', {})
    require(cache.get('phase') == 'complete_after_owned_stop' and cache.get('snapshot_files_verified') == 133
            and cache.get('readable_files_verified_before_stop') == 132
            and cache.get('total_cache_bytes_preservation_complete') is True
            and cache.get('owned_operational_lock_pending') is False
            and cache.get('worker_lock_sha256_before') is None, 'Separate post-stop lock preservation required')
    transport = audit.get('transport_cost_reconciliation', {})
    require(transport.get('unique_session_nonce_pairs') == 10 and transport.get('exact_known_tokens') == 243141
            and transport.get('unknown_native_invocations') == 0 and transport.get('unresolved_nonces') == [],
            'Luna call reconciliation incomplete')
    require(stop.get('owned_stop_verified') is True and stop.get('all_owned_process_identities_absent_after_stop') is True
            and stop.get('foreign_processes_targeted') is False and stop.get('worker_lock_sha256_before') is None
            and stop.get('source_only_relay_identities_preserved') is True,
            'Owned absence and source-only preservation required')
    first_reception = read(artifact(closure['first_start']))
    require(first_reception.get('verified') is True and first_reception.get('all_33_direct_remote_refs_SHA_verified') is True,
            'Actual first-start reception required')
    first = first_reception['produced_remote_first_start_receipt']
    first_data = read(artifact(first))
    require(first_data.get('verified') is True and first_data.get('technical_errors_found') is False
            and first_data.get('invocation_unknown') is False, 'Actual first normal delivered call/evaluation required')
    for key in ('archive', 'recorded_role_costs'):
        artifact(closure[key])
    receipt_root = Path(closure['audit']['path']).parent
    cache_path, lock_path = receipt_root / 'cache-preservation-phase-complete-r4.json', receipt_root / 'reception-verrou-apres-arret.json'
    require(sha(cache_path) == '41b739341c3cfeed4905ffb4f17868945857d6919361efb74e445f4a4e6775c6'
            and sha(lock_path) == 'e58c08d7950e3068888b4f8873dc368c8c5775260907357713de800cff0365a4',
            'Exact separate complete-cache and post-stop-lock receipts required')
    lock = read(lock_path)
    require(lock.get('verified') is True and lock.get('sha256_before') is None
            and lock.get('readable_132_equal_pre_stop') is True and lock.get('source_133_stable_after_stop') is True,
            'Post-stop lock chronology/132 data preservation required')
    return closure, first



    closure, first = checked_luna(closure_ref)
    return {'schema': 'hpc-forest-primes-r2max-luna-closure-admission-v1', 'verified': True,
        'scope_id': 'hpc-forest-primes-native-max-r1', 'model': 'gpt-6-luna', 'effort': 'max',
        'session_id': 'c8044062692149138d826d3f388a08ef', 'job_id': '751992',
        'source_zip_sha256': LUNA_SOURCE, 'plan_sha256': LUNA_PLAN, 'preparation_manifest_sha256': PREP,
        'first_start_sha256': first['sha256'], 'operator_bounded_acceptance': True,
        'received_cohort_audited_with_explicit_raw_attribution_limit': True, 'raw_attribution_limit_preserved': True,
        'all_started_calls_reconciled': True, 'owned_worker_absence_verified': True,
        'independent_performance_validation': False, 'native_research_admitted': False,
        'hardware_or_process_isolation_proved': False, 'independent_raw_stdout_per_candidate_verified': False,
        'archive': closure['archive'], 'audit': closure['audit'],
        'reconciliation': closure['recorded_role_costs'], 'owned_worker_absence': closure['owned_stop'],
        'evidence_refs': [closure_ref, closure['first_start'],
            ref(Path(closure['audit']['path']).parent / 'cache-preservation-phase-complete-r4.json'),
            ref(Path(closure['audit']['path']).parent / 'reception-verrou-apres-arret.json')],
        'limits': ['Operator bounded closure/reconciliation only; no independent raw/performance or global admission.',
                   '132 data files were preserved before stop; the 133rd lock byte only after owned absence.']}


def qualification(module, reception_ref, qref):
    require(reception_ref.get('sha256') == QRECEPTION, 'Exact independently received NEW cap4 qualification required')
    reception = read(artifact(reception_ref))
    require(reception['audit']['sha256'] == QAUDIT and qref.get('sha256') == QJSON, 'Qualification/audit SHA changed')
    require(reception.get('verified') is True and reception.get('scope_id') == SCOPE
            and reception.get('source_zip_sha256') == SOURCE and reception.get('plan_sha256') == PLAN
            and reception.get('preparation_manifest_sha256') == PREP, 'Actual cap4 qualification reception required')
    # Exact received archive + independently hashed audit; never trust summary booleans alone.
    audit = read(artifact(reception['audit']))
    require(audit.get('verified') is True and audit.get('native_model_calls') == 0, 'Actual reception audit required')
    archive = artifact(reception['archive'])
    import tarfile
    with tarfile.open(archive, 'r:gz') as stream:
        item = stream.extractfile('qualification/qualification.json')
        require(item is not None, 'Original qualification member missing')
        raw = item.read()
    q = json.loads(raw)
    require(hashlib.sha256(raw).hexdigest() == reception['qualification_sha256'], 'Original qualification SHA changed')
    require(str(q.get('allocation', {}).get('job_id')) == QUALIFICATION_JOB, 'Actual NEW cap4 qualification required')
    # The supplied qualification reference is mandatory; no extraction or external write here.
    require(qref.get('sha256') == reception['qualification_sha256'], 'Original restored qualification reference required')
    qpath = artifact(qref)
    require(qpath.read_bytes() == raw, 'Restored qualification differs from original archive member')
    module.verify_qualification(q, SOURCE, prepared=False)
    module.verify_reception(reception, qpath, SEALED / 'certified-preparation')
    return qref


def proposal_command():
    body = render_preflight()
    return ('set -euo pipefail\n'
        '[[ ${SLURM_JOB_ID:-} =~ ^[0-9]+$ ]] || exit 70\n'
        '[[ ${SLURM_JOB_NUM_NODES:-} == 1 && ${SLURM_NTASKS:-} == 1 && ${SLURM_CPUS_PER_TASK:-} == 4 && ${SLURM_MEM_PER_NODE:-} == 16384 ]] || exit 71\n'
        '[[ ${SLURM_RESTART_COUNT:-0} == 0 ]] || exit 72\n'
        'export PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=4\n'
        f'srun --nodes=1 --ntasks=1 --cpus-per-task=4 --mem=16G --cpu-bind=cores --time=03:00:00 {PYTHON_ARM} -I -B -u - <<\'ONE_SELECTED_MAX_CELL_PREFLIGHT\'\n'
        + body + '\nONE_SELECTED_MAX_CELL_PREFLIGHT\n')


def remote_resolver(rows):
    require(isinstance(rows, list) and rows, 'Explicit POSIX-to-local mirrors required')
    mapping = {}
    for row in rows:
        require(set(row) == {'remote_path', 'local'}, 'Closed remote mirror row required')
        remote = row['remote_path']
        p = PurePosixPath(remote)
        require(p.is_absolute() and '..' not in p.parts and '\\' not in remote and str(p) == remote
                and remote.startswith((ADMISSION_ROOT + '/', EXTRACTION + '/',
                     REMOTE_QUALIFICATION_ROOT + '/Q/')),
                'Remote path is outside the two exact deployment roots')
        require(remote not in {ADMISSION_ROOT + '/authorization.json', ADMISSION_ROOT + '/authorization-ready.json'},
                'Authorization and ready are reserved for final publication')
        require(remote not in mapping, 'Duplicate remote mirror')
        mapping[remote] = row['local']
        artifact(row['local'])

    def resolve(value):
        require(isinstance(value, dict) and set(value) == {'path', 'sha256'}, 'Closed remote ref required')
        require(value['path'] in mapping and mapping[value['path']]['sha256'] == value['sha256'],
                'Missing mirror or differing remote SHA')
        return artifact(mapping[value['path']])
    return resolve


def qualified_reception_links(value):
    require(value['archive']['sha256'] == QARCHIVE and value['audit']['sha256'] == QAUDIT,
            'Both authorizations must bind the exact original received archive and audit')


def same_cli(left, right):
    for key in ('version', 'executable_path', 'executable_sha256', 'source_execution_allowed', 'files'):
        require(left.get(key) == right.get(key), 'Local/POSIX immutable CLI identities differ')


def validate_authorizations(module, local_path, remote_path, mirrors):
    local = module.validate_receipt(local_path, {SCOPE}, runtime=False, prepared=False)
    cell_identity(local)
    require(local['artifacts']['source_zip']['sha256'] == SOURCE and local['artifacts']['plan']['sha256'] == PLAN,
            'Source/plan must equal the sealed cap4 derivative')
    original = module.artifact
    module.artifact = remote_resolver(mirrors)
    try:
        remote = module.validate_receipt(remote_path, {SCOPE}, runtime=False, prepared=False)
    finally:
        module.artifact = original
    cell_identity(remote)
    for key in set(local) - {'artifacts'}:
        require(local[key] == remote[key], 'Local/POSIX authorization identity or limits differ')
    for key in ('source_zip', 'plan', 'preparation_manifest', 'preparation_review'):
        require(local['artifacts'][key]['sha256'] == remote['artifacts'][key]['sha256'], 'Immutable cross-environment bytes differ')
    cli = read(artifact(local['artifacts']['cli_identity']))
    require(Path(cli.get('executable_path', '')).resolve() == CLI.resolve()
            and cli.get('executable_sha256') == CLI_SHA and cli.get('version') == CLI_VERSION and sha(CLI) == CLI_SHA,
            'Exact preserved CLI copy required; no new connection/CLI call')
    require(CONFIG.is_file() and not CONFIG.is_symlink(), 'Existing local transport config required')
    require(not (LAUNCH / ('worker-' + SESSION)).exists(), 'Fresh cell cache required')
    for value, resolver in ((local, artifact), (remote, remote_resolver(mirrors))):
        other_cli = read(resolver(value['artifacts']['cli_identity']))
        same_cli(cli, other_cli)
        for key in set(module.SCHEMAS) - {'allocated_contract_qualification'}:
            proof = read(resolver(value['artifacts'][key]))
            evidence = proof.get('evidence_refs')
            require(isinstance(evidence, list) and bool(evidence), 'Each future positive proof needs real hashed evidence')
            for item in evidence:
                resolver(item)
        reception = read(resolver(value['artifacts']['allocated_contract_reception']))
        qualified_reception_links(reception)
        lane = read(resolver(value['artifacts']['worker_lane_admission']))
        reservation = {'job_id': value['job_id'], 'model': MODEL, 'effort': EFFORT, 'session_id': SESSION}
        require(lane.get('job_reservation') == reservation, 'Worker lane is not reserved to the full selected cell')
        transport = read(resolver(value['artifacts']['transport_admission']))
        require(transport.get('cli_identity_sha256') == value['artifacts']['cli_identity']['sha256']
                and transport.get('allocated_contract_qualification_sha256') == value['artifacts']['allocated_contract_qualification']['sha256']
                and transport.get('neutral_tests_passed') is True, 'Transport is not linked to exact CLI/qualification/neutral controls')
        for proof in value['artifacts'].values():
            resolver(proof)
    files = cli.get('files', [])
    require(len(files) == 4 and {Path(row['path']).name: row['sha256'] for row in files} == CLI_FILES,
            'Exact four preserved CLI files required')
    remote_read = remote_resolver(mirrors)
    ignored = {'evidence_refs', 'archive', 'audit', 'cli_identity_sha256',
               'luna_first_start_sha256', 'luna_closure_sha256'}
    for key in module.SCHEMAS:
        left, right = read(artifact(local['artifacts'][key])), read(remote_read(remote['artifacts'][key]))
        require({k: v for k, v in left.items() if k not in ignored}
                == {k: v for k, v in right.items() if k not in ignored}, 'Local/POSIX admission facts differ')
    require(local['artifacts']['allocated_contract_qualification']['sha256']
            == remote['artifacts']['allocated_contract_qualification']['sha256'] == QJSON,
            'Both environments must use the exact original qualification bytes')
    for item in files:
        require(Path(item['path']).resolve().parent == CLI.parent.resolve(), 'CLI companion moved outside exact preserved copy')
        artifact(item)
    return local, remote


def parent_review_guard(review_ref, spec, authorization):
    review = read(artifact(review_ref))
    expected = {'schema': 'hpc-forest-max-cell-parent-admission-review-v1', 'verified': True,
        'scope_id': SCOPE, 'model': MODEL, 'effort': EFFORT, 'session_id': SESSION,
        'job_id': authorization['job_id'], 'source_zip_sha256': SOURCE, 'plan_sha256': PLAN,
        'complete_utf8_cim_fresh_checked': True, 'source_only_full_identities_preserved': True,
        'luna_full_owned_identities_absent': True, 'no_unreserved_native_workers': True,
        'local_cache_absent_checked': True, 'remote_root_registry_channel_absent_checked': True,
        'no_prior_session_claims': True, 'existing_transport_only': True,
        'independent_remote_observation_by_generator': False}
    require(all(review.get(k) == v for k, v in expected.items()), 'Actual parent lane/freshness review required')
    refs = {'worker_lane_admission': authorization['artifacts']['worker_lane_admission'],
            'session_freshness': authorization['artifacts']['session_freshness'],
            'submission_intent': spec['submission_intent'], 'submission_observed': spec['submission_observed']}
    require(review.get('reviewed_refs') == refs, 'Parent review refers to different immutable admissions/submission')
    evidence = review.get('evidence_refs')
    require(isinstance(evidence, list) and evidence, 'Real parent census/remote freshness evidence required')
    for item in [*refs.values(), *evidence]:
        artifact(item)
    return review


def submission_guard(intent_ref, submitted_ref, authorization):
    intent = read(artifact(intent_ref))
    raw = read(artifact(submitted_ref))
    submitted = raw.get('structuredContent', raw)
    require(isinstance(submitted, dict), 'Actual submission result must be an object')
    expected = {'schema': 'hpc-forest-max-cell-submit-intent-v1', 'verified': True,
        'scope_id': SCOPE, 'model': MODEL, 'effort': EFFORT, 'session_id': SESSION,
        'source_zip_sha256': SOURCE, 'research_plan_sha256': PLAN,
        'full_script_reviewed': True, 'one_submit_only': True, 'no_resubmit_if_unknown': True,
        'normal_first_call_proved': False, 'allocation_max_seconds': 10800, 'maximum_native_workers': 4,
        'source_only_preserved': True}
    require(all(intent.get(k) == v for k, v in expected.items()), 'Actual reviewed single-submit intent required')
    require(submitted.get('ok') is True and submitted.get('submitted') is True
            and submitted.get('submission_observed') is True
            and str(submitted.get('job_id')) == authorization['job_id'], 'Actual observed submission/job required')
    require(all(submitted.get(k) == intent.get(k) and intent.get(k) for k in ('plan_id', 'plan_sha256')),
            'Submission differs from the exact reviewed scheduler plan')
    command = artifact(intent['command']).read_text(encoding='utf8')
    require(command == proposal_command(), 'Submission intent command differs from reviewed selected-cell proposal')
    script = artifact(intent['job_script']).read_text(encoding='utf8')
    require(command in script and script.count('srun ') == 1, 'Actual reviewed script must contain the unique exact srun command')
    directives = ['#SBATCH --partition=short', '#SBATCH --time=03:00:00', '#SBATCH --cpus-per-task=4',
                  '#SBATCH --mem=16G', '#SBATCH --nodes=1', '#SBATCH --ntasks-per-node=1']
    require(all(line in script.splitlines() for line in directives), 'Exact reviewed Slurm resource directives required')
    resolved = submitted.get('resolved', {})
    require(all(resolved.get(k) == v for k, v in {'arch': 'armgpu', 'partition': 'short', 'total_cpus': 4,
            'total_gpus': 0, 'mem_gb': 16, 'time': '03:00:00', 'ntasks_per_node': 1}.items()),
            'Observed submission resources differ from the single-cell ceiling')
    evidence = intent.get('evidence_refs')
    require(isinstance(evidence, list) and evidence, 'Submit intent requires real hashed fresh census/review evidence')
    for item in evidence:
        artifact(item)
    return {'intent': intent_ref, 'submission_observed': submitted_ref, 'job_id': authorization['job_id']}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('mode', choices=['proposal', 'authorization'])
    parser.add_argument('--bindings', type=Path, required=True)
    parser.add_argument('--bindings-sha256', required=True)
    parser.add_argument('--model', choices=sorted(CELLS), required=True)
    parser.add_argument('--input', type=Path, required=True)
    parser.add_argument('--input-sha256', required=True)
    parser.add_argument('--output-name', required=True)
    args = parser.parse_args()
    configure({'path': str(args.bindings.resolve()), 'sha256': args.bindings_sha256}, args.model)
    require(re.fullmatch('[A-Za-z0-9][A-Za-z0-9_-]{0,63}', args.output_name), 'Simple fresh output subfolder required')
    spec = read(artifact({'path': str(args.input.resolve()), 'sha256': args.input_sha256}))
    require(set(spec) == {'schema', 'qualification_reception', 'qualification', 'luna_bounded_closure', 'local_authorization',
                         'remote_authorization_mirror', 'remote_files', 'submission_intent', 'submission_observed', 'parent_admission_review'}, 'Closed preparation input required')
    require(spec['schema'] == 'hpc-forest-max-cell-local-preparation-input-v1', 'Wrong preparation input schema')
    module = native()
    qref = qualification(module, spec['qualification_reception'], spec['qualification'])
    bounded = closure_admission(spec['luna_bounded_closure'])
    generated = None
    if args.mode == 'authorization':
        lp, rp = artifact(spec['local_authorization']), artifact(spec['remote_authorization_mirror'])
        local, remote = validate_authorizations(module, lp, rp, spec['remote_files'])
        require(local['artifacts']['allocated_contract_qualification']['sha256'] == qref['sha256'], 'Different qualification in authorization')
        require(read(artifact(local['artifacts']['luna_closure'])) == bounded, 'Actual bounded closure adapter required')
        submission_guard(spec['submission_intent'], spec['submission_observed'], local)
        parent_review_guard(spec['parent_admission_review'], spec, local)
        generated = local, remote
    directory = OUT / args.output_name
    directory.mkdir(exist_ok=False)
    save(directory, 'luna-closure-admission-local.json', bounded)
    command = proposal_command()
    (directory / 'commande-allouee-proposee.sh').write_text(command, encoding='utf8', newline='\n')
    save(directory, 'demande-job-prepare-proposee.json', {'arch': 'armgpu', 'partition': 'short',
        'nodes': 1, 'ntasks_per_node': 1, 'cpus_per_task': 4, 'mem_gb': 16, 'gpus_per_node': 0,
        'time_limit': '03:00:00', 'cpu_bind': 'cores', 'spack_packages': [],
        'name': 'forest-primes-' + MODEL.replace('.', '-') + '-max-cap4', 'workdir': '/scratch_p/nimarano', 'command': command})
    if generated:
        local, remote = generated
        save(directory, 'authorization-local.json', local)
        remote_ref = save(directory, 'authorization-remote.json', remote)
        save(directory, 'authorization-ready.json', {'schema': 'hpc-forest-primes-r2max-authorization-upload-ready-v1',
            'scope_id': SCOPE, 'job_id': remote['job_id'], 'session_id': SESSION,
            'sha256': remote_ref['sha256'], 'bytes': (directory / 'authorization-remote.json').stat().st_size})
        worker = [str(PYTHON_LOCAL), '-B', '-u', '-m', 'hpc_forest.r2max_worker', '--channel',
            REMOTE_ROOT + '/results-' + local['job_id'] + '/mailbox', '--session-id', SESSION,
            '--output', str(LAUNCH / ('worker-' + SESSION)), '--codex-config', str(CONFIG), '--dependency-receipt',
            str(directory / 'authorization-local.json'), '--required-jobs', SCOPE, '--max-seconds', '10800', '--executable', str(CLI)]
        save(directory, 'upload-manifest-propose.json', {'schema': 'hpc-forest-max-cell-explicit-upload-proposal-v1',
            'scope_id': SCOPE, 'model': MODEL, 'effort': EFFORT, 'session_id': SESSION, 'job_id': remote['job_id'],
            'verified': False, 'performed': False,
            'dependencies': [row for row in spec['remote_files'] if row['remote_path'].startswith(ADMISSION_ROOT + '/')],
            'existing_qualified_files': [row for row in spec['remote_files'] if not row['remote_path'].startswith(ADMISSION_ROOT + '/')],
            'authorization_publish_after_dependencies': {'remote_path': ADMISSION_ROOT + '/authorization.json', 'local': remote_ref},
            'ready_publish_last': {'remote_path': ADMISSION_ROOT + '/authorization-ready.json', 'local': ref(directory / 'authorization-ready.json')},
            'parent_submission_intent': spec['submission_intent'], 'actual_observed_submission': spec['submission_observed'],
            'parent_admission_review': spec['parent_admission_review']})
        save(directory, 'worker-argv-only.json', {'argv': worker, 'cwd': str(PROJECT),
            'environment': {'PYTHONPATH': str(PROJECT / 'src'), 'PYTHONDONTWRITEBYTECODE': '1', 'PYTHONUTF8': '1'},
            'executed': False, 'existing_config_ref': ref(CONFIG), 'cli_sha256': CLI_SHA})
    save(directory, 'preparation-local-only.json', {'schema': 'hpc-forest-max-cell-local-preparation-v1',
        'scope_id': SCOPE, 'model': MODEL, 'effort': EFFORT, 'session_id': SESSION, 'source_zip_sha256': SOURCE,
        'plan_sha256': PLAN, 'preparation_manifest_sha256': PREP, 'verified': False,
        'input': ref(args.input), 'qualification': qref, 'luna_closure': spec['luna_bounded_closure'],
        'native_research_admitted': False, 'tools_invoked': [], 'native_model_calls': 0,
        'automatic_extension': False, 'other_cells_started': 0, 'allocation_seconds': 10800,
        'search_seconds': 1800, 'tokens': 1500000, 'program_missions': 8, 'mother_calls': 2,
        'inference_cpu_count_inferred': False, 'created_at': time.time(),
        'parent_upload_required': True, 'remote_paths_created_by_this_generator': False,
        'post_submit_job_id_required_before_authorization_upload': True,
        'first_normal_delivered_call_and_real_evaluation_required_before_extension': True})
    print(json.dumps({'directory': str(directory), 'status': 'local_files_only_not_executed'}))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
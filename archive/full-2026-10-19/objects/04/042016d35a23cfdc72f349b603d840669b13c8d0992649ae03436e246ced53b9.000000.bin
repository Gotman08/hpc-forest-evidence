"""Version closed campaign bindings and the one host-infrastructure argv scalar only."""
import ast
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
BASE = HERE.parents[2]
OLD = BASE / 'outputs/HPC-Forest-Primes-Natif-Relance-r2f/reception-premier-batch-r1'
FACTORY = BASE / 'outputs/HPC-Forest-Primes-Natif-Lancement-r2g/revision-r1'
PINS = {'reception_bornee.py': 'd17472603acfd4cbff81f998924ec0c31b5628018aef8edec038b5d39a7d5a30',
    'audit_prive.py': '0d7d141a6bff7ca294e9e8d4d16b53acd2e903e38f59099c838fb2f47a609c97',
    'controler-reception-bornee.py': '444b131dea673cef9af471aa9217da65ad86240b75c362a2b27b7cf1bfeed17f',
    'collecter-frontiere.py': 'c5728e60ea500c577e31a50d266ec6135440a4f3827d096e645688c106df0f43',
    'preparer-contexte.py': '0211207d6770289609ce7138122965bdd2654d1c32a0a7d0ffe53cee86e2703b'}


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def functions(text):
    return {node.name: ast.dump(node, include_attributes=False) for node in ast.parse(text).body if isinstance(node, ast.FunctionDef)}


def main():
    manifest = json.loads((FACTORY / 'MANIFESTE-FACTORY-LOCALE.json').read_bytes())
    changes = {
        'hpc-forest-primes-native-max-r2f': 'hpc-forest-primes-native-max-r2g',
        'HPC-Forest-Primes-Natif-Lancement-r2f': 'HPC-Forest-Primes-Natif-Lancement-r2g',
        '47f97afabcd6d10c5e95a1dc3aae0a34b0841183919785a6bd62d58aa1e90d75': 'f8c2104bad52e3c298de596fd365415fbdfbbb12fbdc41b47b06a94ad68273fe',
        '8d91ebe83ab550ad50acc330f830e1bc86bcc67f66b88054538df6b394558450': '5af07859f99192e169f2475fb2c863c9d4a05a4a8dba07845b3fcc54451e7dba',
        '5aeceff56b26452290325ed4274d71bd': '110cefccf16b439eb226e475c875c8df',
        'e7c86715f4d34e9f9efcdcc4ce2a81c8': '5d8811082a1842f5836a2bdda982500f',
        '1294453607b34c68ba05872072640120': '13eaca4e39cf4147a3f677a32fb5a52d',
        '67ca844efe21ac45d079cdb18397f228b80a75c53e52caa719864c0d51c8b8c4': manifest['components']['preparer-cellule-max.py'],
        'c34319ca303137a205dd8e55ca7b4705bb1db91efc65498f422e20d0ffa3767f': manifest['components']['publication-locale.py'],
        '(m.SCOPE, m.SOURCE, m.PLAN, 109)': '(m.SCOPE, m.SOURCE, m.PLAN, 110)',
        'r2f-first-batch-private-projection-r1': 'r2g-first-batch-private-projection-r1'}
    original, texts = {}, {}
    for name, checksum in PINS.items():
        raw = (OLD / name).read_bytes()
        assert sha(raw) == checksum
        original[name] = raw.decode('utf8')
        text = original[name]
        for before, after in changes.items():
            text = text.replace(before, after)
        texts[name] = text
    anchor = '    for key, value in overrides.items():'
    assert texts['audit_prive.py'].count(anchor) == 1
    texts['audit_prive.py'] = texts['audit_prive.py'].replace(anchor,
        "    # G admits only this infrastructure host scalar; policy loader proves the closed22 bool map.\n"
        "    overrides['features.code_mode_host'] = True\n" + anchor)
    private_sha = sha(texts['audit_prive.py'].encode())
    helper_sha = sha(texts['reception_bornee.py'].encode())
    collector_sha = sha(texts['collecter-frontiere.py'].encode())
    texts['controler-reception-bornee.py'] = texts['controler-reception-bornee.py'].replace(PINS['audit_prive.py'], private_sha).replace(PINS['reception_bornee.py'], helper_sha)
    texts['preparer-contexte.py'] = texts['preparer-contexte.py'].replace(PINS['collecter-frontiere.py'], collector_sha)
    assert functions(original['reception_bornee.py']) == functions(texts['reception_bornee.py'])
    before, after = functions(original['audit_prive.py']), functions(texts['audit_prive.py'])
    assert [name for name in before if before[name] != after[name]] == ['expected_argv']
    assert functions(original['controler-reception-bornee.py'])['verify_frozen_authorizations'] == functions(texts['controler-reception-bornee.py'])['verify_frozen_authorizations']
    assert not any((HERE / name).exists() for name in texts)
    for name, text in texts.items():
        with (HERE / name).open('x', encoding='utf8', newline='\n') as stream:
            stream.write(text)
    test_path = BASE / 'outputs/HPC-Forest-Primes-Natif-Relance-r2e/reception-premier-batch-r1/test_reception_r2e.py'
    test = test_path.read_text('utf8').replace('hpc-forest-primes-natif-relance-r2e/project', 'hpc-forest-primes-natif-relance-r2g/project')
    test = test.replace('HPC-Forest-Primes-Natif-Relance-r2e/correction-cli', 'HPC-Forest-Primes-Natif-Relance-r2g/correction-cli')
    test = test.replace('len(expected) == 108', 'len(expected) == 110')
    test = test.replace("policy = {'schema': 'hpc-forest-r2e-local-cli-policy-v1', **binding,",
        "policy = {'schema': 'hpc-forest-r2g-local-cli-policy-v1', **binding,\n"
        "        'cli_feature_overrides': dict(client.TASK_CLI_FEATURES),\n"
        "        'code_mode_host_executable_sha256': client.CODE_MODE_HOST_SHA256,")
    with (HERE / 'test_reception_r2g.py').open('x', encoding='utf8', newline='\n') as stream:
        stream.write(test)
    with (HERE / 'DIFF-FERME.json').open('x', encoding='utf8', newline='\n') as stream:
        stream.write(json.dumps({'schema': 'hpc-forest-r2g-cold-first-batch-reader-closed-delta-v1',
            'ancestor_F_pins': PINS, 'replacements': changes,
            'components': {name: sha((HERE / name).read_bytes()) for name in texts},
            'private_auditor_byte_identical': False,
            'private_delta_only_expected_argv_one_host_infrastructure_true_scalar': True,
            'other_private_function_ASTs_and_all_scientific_helper_functions_unchanged': True,
            'frozen_authorization_validator_correct_namespace_unchanged': True,
            'mechanical_r2e_wire_schemas_preserved': True,
            'runtime_no_tools_NORMAL_or_extension_not_admitted': True,
            'tests_or_CLI_model_cache_transport_processes_executed_by_derivation': False}, indent=2) + '\n')
    print(json.dumps({name: sha((HERE / name).read_bytes()) for name in texts}))


if __name__ == '__main__':
    main()

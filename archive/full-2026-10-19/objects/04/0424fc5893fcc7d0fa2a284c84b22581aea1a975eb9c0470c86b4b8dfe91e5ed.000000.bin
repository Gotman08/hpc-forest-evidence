triplets=[];identifiers=set()
for group,(count,result_key) in groups.items():
    intention=metadata('qualification-output/'+group+'-intention.json')
    execution=metadata('qualification-output/'+group+'-execution.json')
    xml=data('qualification-output/'+group+'-junit.xml')
    need(b'<!DOCTYPE' not in xml and b'<!ENTITY' not in xml,'No XML entities or external references')
    tree=ET.fromstring(xml);cases=list(tree.iter('testcase'))
    need(len(cases)==count and len([n for n in tree.iter() if n.tag in {'failure','error','skipped'}])==0,'Actual distinct JUnit testcase/pass count')
    for case in cases:
        key=(case.attrib.get('classname'),case.attrib.get('name'))
        need(all(isinstance(x,str) and x for x in key) and key not in identifiers,'Actual testcase unique identity across groups')
        identifiers.add(key)
    need(intention['maximum_run_count']==execution['run_count']==1 and intention['model_calls']==execution['model_calls']==0
         and intention['timeout_seconds']==execution['timeout_seconds']==180 and intention['argv']==execution['argv']
         and execution['returncode']==0 and execution['testcases']==count and execution['skipped']==0
         and execution['junit_sha256']==sha(xml),'Intention/execution/JUnit exact triplet')
    need(qualification[result_key]=={'passed':count,'failed':0} and all(type(v) is int for v in qualification[result_key].values())
         and qualification['suite_results'][group]['details']=={'testcases':count,'skipped':0,'junit_sha256':sha(xml)}
         and qualification['suite_results'][group]['returncode']==0,'Actual qualification matches raw suite result')
    need(execution['argv'][:3]==['/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python','-I','-B']
         and '-q' in execution['argv'] and 'no:cacheprovider' in execution['argv'],'Qualified isolated neutral Python/pytest argv')
    triplets.append({'group':group,'passed':count,'failed':0,'intention':ref(file('qualification-output/'+group+'-intention.json')),

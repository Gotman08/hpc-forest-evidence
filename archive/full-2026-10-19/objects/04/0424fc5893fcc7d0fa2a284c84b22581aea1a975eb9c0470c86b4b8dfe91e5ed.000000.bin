def need(value,message):
    if not value:raise ValueError(message)
def sha(value):return hashlib.sha256(value).hexdigest()
code=RAW_SOURCE.read_bytes();need(sha(code)=='5c1e1784574566a585e2d9cc50f85b52337d10d3109e449a4112581eae68f8d5','Qualified held IO')
names={'need','ordinary','metadata','open_nofollow_read','cross_identity','validate_windows_mode_views','native_basic_info','raw','decode'}
nodes=[n for n in ast.parse(code).body if isinstance(n,ast.FunctionDef) and n.name in names]
need({n.name for n in nodes}==names,'Closed IO definitions')
ns={'Path':Path,'os':os,'stat':stat,'json':json,'Q':BASE}
exec(compile(ast.Module(body=nodes,type_ignores=[]),str(RAW_SOURCE),'exec'),ns)
raw,decode=ns['raw'],ns['decode'];before={}
def rb(path,expected=None):
    path=Path(path);need(path.is_absolute() and path.is_relative_to(BASE/'outputs'),'Only named cold output evidence')
    data=raw(path);checksum=sha(data)
    need(expected is None or checksum==expected,'Pinned cold bytes changed: '+path.name)
    need(str(path) not in before or before[str(path)]==checksum,'Changed during audit')
    before[str(path)]=checksum
    return data
def obj(path,expected=None):return decode(rb(path,expected))
def load(reference):
    need(set(reference)=={'path','sha256'},'Closed evidence reference')
    return obj(reference['path'],reference['sha256'])
def ref(path):return {'path':str(path),'sha256':sha(rb(path))}
def emit(name,value):
    path=HERE/name;need(not path.exists(),'No prior receipt overwrite')
    with path.open('xb') as stream:stream.write((json.dumps(value,ensure_ascii=False,indent=2)+'\n').encode());stream.flush();os.fsync(stream.fileno())
    return ref(path)
def unwrap(value):
    value=value.get('result',value)
    need(value.get('isError',False) is False,'Successful saved metadata')
    if 'structuredContent' in value:
        text=[b['text'] for b in value.get('content',[]) if b.get('type')=='text']
        need(len(text)==1 and decode(text[0].encode())==value['structuredContent'],'Raw/structured equality')
        return value['structuredContent']
    return value
def bound(value):
    need(value['scope_id']==SCOPE and value['source_zip_sha256']==SOURCE and value['plan_sha256']==PLAN,'Exact R7 source/plan scope')
def file(name):return RESTORE.joinpath(*name.split('/'))
def data(name,expected=None):return rb(file(name),expected)
def metadata(name,expected=None):return decode(data(name,expected))


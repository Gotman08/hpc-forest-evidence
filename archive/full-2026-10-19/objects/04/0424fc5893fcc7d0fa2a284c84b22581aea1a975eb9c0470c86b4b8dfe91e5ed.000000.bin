differences=[]
def compare(a,b,path=()):
    if type(a) is not type(b):differences.append({'path':list(path),'old':a,'new':b})
    elif isinstance(a,dict):
        need(set(a)==set(b),'Plan keys changed beyond three UUIDs')
        for key in a:compare(a[key],b[key],path+(key,))
    elif isinstance(a,list):
        need(len(a)==len(b),'Plan list count changed')
        for index,(x,y) in enumerate(zip(a,b)):compare(x,y,path+(index,))
    elif a!=b:differences.append({'path':list(path),'old':a,'new':b})

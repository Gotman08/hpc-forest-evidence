regular={};link_records={}
def inventory_record(name,value):
    kind=value['kind']
    if kind=='regular':
        need(value['tar_member'] is True and name in inventory and value['sha256']==inventory[name]['sha256']
             and value['bytes']==inventory[name]['bytes']==value['metadata']['size'],'Remote regular inventory exact bytes')
        regular[name]=value['sha256']
    elif kind=='symlink':
        need(value['tar_member'] is False and value['target_followed'] is False and value['bytes_read'] is False
             and name not in inventory,'Fixture link is metadata only')
        link_records[name]=value
    elif kind=='directory':need(value['tar_member'] is False and name not in inventory,'Remote directories not archived as data')
    else:raise ValueError('Other source type not admitted')
for prefix,entries in remote_before['trees'].items():
    for name,value in entries.items():inventory_record(prefix+'/'+name,value)
for name,value in remote_before['fixed'].items():
    need(set(value)=={'metadata','sha256','bytes'} and stat.S_ISREG(value['metadata']['mode'])
         and value['metadata']['nlink']==1 and name in inventory
         and value['sha256']==inventory[name]['sha256']
         and value['bytes']==value['metadata']['size']==inventory[name]['bytes'],
         'Exact fixed regular-file metadata shape and bytes; no invented kind/tar flags')
    regular[name]=value['sha256']
need(regular==payload and link_records==links,'Complete remote inventories equal regular payload and65 inert links')
extra={name:inventory[name]['sha256'] for name in inventory if name not in payload}
need(set(extra)=={'archive-metadata/inventory-before.json','archive-metadata/inventory-after.json',

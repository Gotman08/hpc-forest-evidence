    "model": "hpcforest-deepseek-v4flash:mxfp4",
    "command": "bash -c 'set -euo pipefail\narchive=/scratch_p/nimarano/marathon22-deepseek-v11-20261015.tar.gz\nroot=/scratch_p/nimarano/hpc-forest-marathon22-deepseek-20261015-v11-v4flash\npy=/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python\ntest ! -e \"$root\"\nprintf '\"'\"'%s  %s\\n'\"'\"' '\"'\"'8d80d62bd108df92c0b4b189b7933c44bddfc22b97373446c5f8958d852d3cd8'\"'\"' \"$archive\" | sha256sum -c -\nmkdir \"$root\"\ntar -xzf \"$archive\" --strip-components=1 -C \"$root\"\n\"$py\" - \"$root\" <<'\"'\"'PY'\"'\"'\nimport hashlib,json,shutil,sys,zipfile\nfrom pathlib import Path\nroot=Path(sys.argv[1])\nold=Path('\"'\"'/scratch_p/nimarano/hpc-forest-marathon22-20261015-r1'\"'\"')\nshutil.copytree(old/'\"'\"'sources-officielles'\"'\"',root/'\"'\"'sources-officielles'\"'\"')\nmanifest=json.loads((root/'\"'\"'payload-manifest.json'\"'\"').read_text())\nfor name,expected in manifest.items():\n    p=root/name\n    assert p.resolve().is_relative_to(root.resolve()) and hashlib.sha256(p.read_bytes()).hexdigest()==expected, name\nwheel=next((root/'\"'\"'payload-r4'\"'\"').glob('\"'\"'*.whl'\"'\"'))\nwith zipfile.ZipFile(wheel) as z:\n    for name in z.namelist():\n        assert (root/'\"'\"'runtime'\"'\"'/name).resolve().is_relative_to((root/'\"'\"'runtime'\"'\"').resolve())\n    z.extractall(root/'\"'\"'runtime'\"'\"')\nprint('\"'\"'Execution payload verified:'\"'\"',len(manifest),'\"'\"'files'\"'\"',flush=True)\nPY\nPYTEST_DISABLE_PLUGIN_AUTOLOAD=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=\"$root/runtime:$root/qa-deps\" flock -w 120 /tmp/hpc-forest-preflight-nimarano.lock \"$py\" -m pytest \"$root/tests\" -q -p no:cacheprovider > \"$root/preflight-tests.log\" 2>&1\ncat \"$root/preflight-tests.log\"\nPYTHONDONTWRITEBYTECODE=1 PYTHONPATH=\"$root/runtime\" \"$py\" \"$root/timer_probe.py\" \"$root/timer-probe.json\"\nexport PYTHONPATH=\"$root/runtime\"\nexport PYTHONDONTWRITEBYTECODE=1\nexec \"$py\" \"$root/romeo_marathon.py\" --problems knn sum nbody --model hpcforest-deepseek-v4flash:mxfp4 --local-model-spec \"$root/v4flash.json\" --cycles 4 --trials-per-role 6 --integrations 6 --wall-seconds 7200 --tokens 4000000 --generation-seconds 300 --temperature 0.2 --repeat-penalty 1.1 --repeat-last-n 64 --root \"$root\" --ollama /scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/tools/ollama-0.40.4/bin/ollama --detector \"$root/detect_resources.py\"\n'"
  },

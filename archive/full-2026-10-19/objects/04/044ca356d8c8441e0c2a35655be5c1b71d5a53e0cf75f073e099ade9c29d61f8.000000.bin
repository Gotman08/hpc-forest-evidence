        "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nstatic const int MOD = 1000000007;\n\nstruct Cell {\n    int y;\n    int x;\n};\n\nstatic long long mod_pow(long long base, long long exponent) {\n    long long result = 1;\n    while (exponent > 0) {\n        if (exponent & 1) result = result * base % MOD;\n        base = base * base % MOD;\n        exponent >>= 1;\n    }\n    return result;\n}\n\nstatic long long paths_between(const Cell& a, const Cell& b,\n                               const vector<int>& factorial,\n                               const vector<int>& inverse_factorial) {\n    const int dy = b.y - a.y;\n    const int dx = b.x - a.x;\n    const int steps = dx + dy;\n    return static_cast<long long>(factorial[steps]) * inverse_factorial[dx] % MOD\n         * inverse_factorial[dy] % MOD;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<Cell> blocked;\n    blocked.reserve(m);\n    bool start_blocked = false;\n    bool end_blocked = false;\n    for (int i = 0; i < m; ++i) {\n        int y, x;\n        cin >> y >> x;\n        if (y == 0 && x == 0) start_blocked = true;\n        if (y == n - 1 && x == n - 1) end_blocked = true;\n        blocked.push_back({y, x});\n    }\n\n    if (start_blocked || end_blocked) {\n        cout << 0 << '\\n';\n        return 0;\n    }\n\n    sort(blocked.begin(), blocked.end(), [](const Cell& a, const Cell& b) {\n        if (a.y + a.x != b.y + b.x) return a.y + a.x < b.y + b.x;\n        if (a.y != b.y) return a.y < b.y;\n        return a.x < b.x;\n    });\n    blocked.erase(unique(blocked.begin(), blocked.end(), [](const Cell& a, const Cell& b) {\n        return a.y == b.y && a.x == b.x;\n    }), blocked.end());\n\n    const int max_steps = 2 * (n - 1);\n    vector<int> factorial(max_steps + 1), inverse_factorial(max_steps + 1);\n    factorial[0] = 1;\n    for (int i = 1; i <= max_steps; ++i)\n        factorial[i] = static_cast<long long>(factorial[i - 1]) * i % MOD;\n    inverse_factorial[max_steps] = mod_pow(factorial[max_steps], MOD - 2);\n    for (int i = max_steps; i > 0; --i)\n        inverse_factorial[i - 1] = static_cast<long long>(inverse_factorial[i]) * i % MOD;\n\n    const Cell origin{0, 0};\n    const Cell destination{n - 1, n - 1};\n    vector<int> ways(blocked.size());\n\n    for (int i = 0; i < static_cast<int>(blocked.size()); ++i) {\n        long long paths_through_blocked = 0;\n        if (i >= 256) {\n#pragma omp parallel for reduction(+:paths_through_blocked) schedule(static)\n            for (int j = 0; j < i; ++j) {\n                const Cell& p = blocked[j];\n                const Cell& q = blocked[i];\n                if (p.y <= q.y && p.x <= q.x) {\n                    paths_through_blocked += static_cast<long long>(ways[j])\n                        * paths_between(p, q, factorial, inverse_factorial) % MOD;\n                }\n            }\n        } else {\n            for (int j = 0; j < i; ++j) {\n                const Cell& p = blocked[j];\n                const Cell& q = blocked[i];\n                if (p.y <= q.y && p.x <= q.x) {\n                    paths_through_blocked += static_cast<long long>(ways[j])\n                        * paths_between(p, q, factorial, inverse_factorial) % MOD;\n                }\n            }\n        }\n        const long long total = paths_between(origin, blocked[i], factorial, inverse_factorial);\n        ways[i] = static_cast<int>((total - paths_through_blocked % MOD + MOD) % MOD);\n    }\n\n    long long paths_through_blocked = 0;\n    const int count = static_cast<int>(blocked.size());\n    if (count >= 256) {\n#pragma omp parallel for reduction(+:paths_through_blocked) schedule(static)\n        for (int i = 0; i < count; ++i) {\n            const Cell& p = blocked[i];\n            if (p.y <= destination.y && p.x <= destination.x) {\n                paths_through_blocked += static_cast<long long>(ways[i])\n                    * paths_between(p, destination, factorial, inverse_factorial) % MOD;\n            }\n        }\n    } else {\n        for (int i = 0; i < count; ++i) {\n            const Cell& p = blocked[i];\n            if (p.y <= destination.y && p.x <= destination.x) {\n                paths_through_blocked += static_cast<long long>(ways[i])\n                    * paths_between(p, destination, factorial, inverse_factorial) % MOD;\n            }\n        }\n    }\n\n    const long long total = paths_between(origin, destination, factorial, inverse_factorial);\n    cout << (total - paths_through_blocked % MOD + MOD) % MOD << '\\n';\n    return 0;\n}\n",

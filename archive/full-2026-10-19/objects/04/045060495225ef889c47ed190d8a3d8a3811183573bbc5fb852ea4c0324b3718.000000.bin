"""Project received zero-model baseline numbers only; preserve all private inputs."""
import hashlib
import json
from pathlib import Path

root = Path(__file__).resolve().parents[1]
received = root / 'outputs/HPC-Forest-Q15-Execution-root-01/reception-froide-r2'
audit_path = received / 'AUDIT-Q15-BASELINES.json'
audit_raw = audit_path.read_bytes()
audit = json.loads(audit_raw)
assert audit['verified'] is True and audit['NEUTRAL'] is False
assert audit['native_model_calls'] == 0 and audit['confirmation_samples'] == 75
subjects = []
for subject in audit['subject_order']:
    path = received / (subject + '-baseline-reference.json')
    raw = path.read_bytes()
    item = json.loads(raw)
    assert item['verified'] is True and item['NEUTRAL'] is False
    assert item['baseline_qualification_only'] is True
    subjects.append({
        'subject_id': subject,
        'confirmation_seconds': item['confirmation_seconds'],
        'mean_seconds': item['mean_seconds'],
        'sample_stdev_seconds': item['sample_stdev_seconds'],
        'binary_sha256': item['binary_sha256'],
        'r1_contract_sha256': item['r1_contract_sha256'],
        'protocol_id': item['protocol_id'],
        'private_reference_receipt_sha256': hashlib.sha256(raw).hexdigest(),
    })
value = {
    'schema': 'hpc-forest-public-baseline-qualification-v1',
    'scope': 'baseline_qualification_only',
    'qualification_job_id': '755488',
    'qualification_started_utc': audit['allocation']['observed_utc'],
    'scheduler_state': 'COMPLETED',
    'scheduler_exit_code': '0:0',
    'scheduler_elapsed_seconds': 65,
    'allocation': {'architecture': 'aarch64', 'nodes': 1, 'tasks': 1,
                   'cpus_per_task': 4, 'memory_mib': 16384, 'gpus': 0},
    'native_model_calls': 0,
    'scientific_gain_claimed': False,
    'native_matrix_results_claimed': False,
    'private_archive_sha256': audit['input_refs']['output_archive']['sha256'],
    'private_cold_audit_sha256': hashlib.sha256(audit_raw).hexdigest(),
    'cold_reader_sha256': audit['source_reader']['sha256'],
    'source_archive_sha256': audit['input_refs']['source_archive']['sha256'],
    'source_plan_sha256': audit['input_refs']['source_plan']['sha256'],
    'subjects': subjects,
}
target = root / 'work/hpc-forest-evidence/evidence/qualification-2026-10-19/baselines.json'
target.parent.mkdir(parents=True, exist_ok=False)
with target.open('x', encoding='utf-8', newline='\n') as stream:
    json.dump(value, stream, ensure_ascii=False, allow_nan=False, indent=2)
    stream.write('\n')
print(json.dumps({'subjects': len(subjects), 'samples': sum(len(s['confirmation_seconds']) for s in subjects),
                  'path': str(target), 'sha256': hashlib.sha256(target.read_bytes()).hexdigest()}))

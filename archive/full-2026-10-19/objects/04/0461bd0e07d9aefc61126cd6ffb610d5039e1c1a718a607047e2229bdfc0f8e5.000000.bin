      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n\n#define MAXNUM 100\n#define MAXSTR 50\n#define MAXRESULTS 1000\n\ntypedef struct {\n    uint32_t value;\n    uint32_t scale;\n} DecimalFragment;\n\nuint32_t firstHalf[MAXNUM];\nDecimalFragment secondHalf[MAXNUM];\nlong int result[MAXRESULTS];\nint numPrimes=0;\n\nstatic DecimalFragment parse_fragment(const char *text)\n{\n    DecimalFragment fragment = {0u, 1u};\n    for (; *text; ++text) {\n        fragment.value = fragment.value * 10u + (uint32_t)(*text - '0');\n        fragment.scale *= 10u;\n    }\n    return fragment;\n}\n\nstatic uint32_t concatenate(uint32_t left, DecimalFragment right)\n{\n    return (uint32_t)((uint64_t)left * right.scale + right.value);\n}\n\nstatic uint32_t integer_root(uint32_t value)\n{\n    uint32_t lower = 0u;\n    uint32_t upper = 65536u;\n    while (lower + 1u < upper) {\n        uint32_t middle = lower + (upper - lower) / 2u;\n        if ((uint64_t)middle * middle <= value)\n            lower = middle;\n        else\n            upper = middle;\n    }\n    return lower;\n}\n\nstatic uint16_t *build_divisors(uint32_t maximum, size_t *count)\n{\n    uint32_t limit = integer_root(maximum);\n    size_t capacity = (size_t)(limit / 2u) + 1u;\n    unsigned char *composite = calloc(capacity, sizeof(*composite));\n    uint16_t *divisors = malloc(capacity * sizeof(*divisors));\n    *count = 0;\n    if (composite == NULL || divisors == NULL) {\n        free(composite);\n        free(divisors);\n        return NULL;\n    }\n\n    if (limit >= 2u)\n        divisors[(*count)++] = 2u;\n    for (uint32_t p = 3u; p <= limit; p += 2u) {\n        if (composite[p / 2u])\n            continue;\n        divisors[(*count)++] = (uint16_t)p;\n        if ((uint64_t)p * p <= limit) {\n            for (uint32_t multiple = p * p;\n                 multiple <= limit; multiple += 2u * p)\n                composite[multiple / 2u] = 1;\n        }\n    }\n    free(composite);\n    return divisors;\n}\n\nstatic int isprime(uint32_t value, const uint16_t *divisors, size_t count)\n{\n    if (value < 2u)\n        return 0;\n    for (size_t i = 0; i < count; ++i) {\n        uint32_t factor = divisors[i];\n        if ((uint64_t)factor * factor > value)\n            break;\n        if (value % factor == 0u)\n            return 0;\n    }\n    return 1;\n}\n\nvoid quicksort(long int *primes,int first,int last)\n{ int i, j, pivot;\n  long int temp;\n\n  if (first<last)\n     { pivot=first;\n       i=first;\n       j=last;\n       while(i<j)\n         { while (primes[i]<=primes[pivot]&&i<last)\n             i++;\n           while(primes[j]>primes[pivot])\n             j--;\n           if (i<j)\n              { temp=primes[i];\n                primes[i]=primes[j];\n                primes[j]=temp;\n              }\n         }\n       temp=primes[pivot];\n       primes[pivot]=primes[j];\n       primes[j]=temp;\n       quicksort(primes,first,j-1);\n       quicksort(primes,j+1,last);\n     }\n}\n\nint main(void)\n{\n    FILE *primesFile = stdin;\n    char text[MAXSTR];\n    uint32_t maximum_left = 0u;\n    uint32_t maximum = 0u;\n    int numResults = 0;\n    size_t divisor_count = 0;\n    uint16_t *divisors;\n\n    if (fscanf(primesFile, \"%d\", &numPrimes) != 1)\n        return 0;\n    for (int i = 0; i < numPrimes; ++i) {\n        if (fscanf(primesFile, \"%49s\", text) != 1)\n            return 0;\n        firstHalf[i] = parse_fragment(text).value;\n        if (firstHalf[i] > maximum_left)\n            maximum_left = firstHalf[i];\n    }\n    for (int i = 0; i < numPrimes; ++i) {\n        if (fscanf(primesFile, \"%49s\", text) != 1)\n            return 0;\n        secondHalf[i] = parse_fragment(text);\n        uint32_t candidate = concatenate(maximum_left, secondHalf[i]);\n        if (candidate > maximum)\n            maximum = candidate;\n    }\n    fclose(primesFile);\n\n    divisors = build_divisors(maximum, &divisor_count);\n    if (divisors == NULL)\n        return 1;\n    for (int i = 0; i < numPrimes; ++i) {\n        uint32_t left = firstHalf[i];\n        for (int j = 0; j < numPrimes; ++j) {\n            uint32_t candidate = concatenate(left, secondHalf[j]);\n            if (isprime(candidate, divisors, divisor_count))\n                result[numResults++] = (long int)candidate;\n        }\n    }\n    free(divisors);\n\n    quicksort(result,0,numResults-1);\n    for (int i = 0; i < numResults; ++i)\n        printf(\"%ld\\n\", result[i]);\n    return 0;\n}\n",

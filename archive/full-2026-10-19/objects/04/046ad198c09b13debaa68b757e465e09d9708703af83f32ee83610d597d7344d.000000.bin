/*
  Quicksort
*/
#include <stdio.h>
#include <stdlib.h>
#include <limits.h>
#include <string.h>
#include <openssl/md5.h>


/*
 * Prototypes
 */
void srandnum(int seed);
double randnum(void);
int *generate_case(int N);
double drand(int xmin, int xmax);
void swap(int *toorder, int i, int j);
int partition(int *toorder, int lo, int hi);
void _quicksort(int *toorder, int lo, int hi);
void quicksort(int *toorder, int N);
int is_sorted(int *toorder, int N);
static int compare_ints(const void *left, const void *right);
static int *radix_sort(int *toorder, int N, int **scratch_out);

/*
 * A generic pRNG
 */
#define MY_RAND_MAX 0x7FFFFFFF

#define RANDNUM_W 521288629
#define RANDNUM_Z 362436069

unsigned int randum_w = RANDNUM_W;
unsigned int randum_z = RANDNUM_Z;

void srandnum(int seed)
{
    unsigned int w, z;
    w = (seed * 104623) & 0xffffffff;
    randum_w = (w) ? w : RANDNUM_W;
    z = (seed * 48947) & 0xffffffff;
    randum_z = (z) ? z : RANDNUM_Z;
}

double randnum(void)
{
    unsigned int u;
    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);
    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);
    u = (randum_z << 16) + randum_w;
    return (abs(u));
}

/*
 * Main function
 */
int main(int argc, char *argv[])
{
    int N = 0;
    int *our_list = NULL;
    int *sorted_list = NULL;
    int *sort_scratch = NULL;

    //The input provides the case size
	scanf("%d", &N);
    if (N <= 0) {
	printf("Error: please, provide the case size.\n");
	return 1;
    }

    //Generate the case
    our_list = generate_case(N);
    if (our_list == NULL) {
	printf("Error: case instantiation failed.\n");
	return 1;
    }

    //Consume the final radix buffer directly, avoiding an extra array copy.
    sorted_list = radix_sort(our_list, N, &sort_scratch);

    if (is_sorted(sorted_list, N) == 1) {
	printf("Error, for some reason list is still unsorted.\n");
	free(sort_scratch);
	free(our_list);
	return 1;
    }

#ifdef COMPUTE_MD5_PROBLEM
    //Compute MD5 Checksum for problem identification
    MD5_CTX c;
    unsigned char out[MD5_DIGEST_LENGTH];
    MD5_Init(&c);
    MD5_Update(&c, sorted_list, N * sizeof(int));
    MD5_Final(out, &c);
    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {
	printf("%02x", out[n]);
    }
#endif
    printf("\n");

    //Clean up both owned allocations; sorted_list aliases one of them.
    free(sort_scratch);
    free(our_list);

    return 0;
}

static int compare_ints(const void *left, const void *right)
{
    int a = *(const int *)left;
    int b = *(const int *)right;
    return (a > b) - (a < b);
}

/*
 * Return the sorted buffer without transferring ownership of the input.
 * scratch_out receives the sole additional allocation, or NULL.
 */
static int *radix_sort(int *toorder, int N, int **scratch_out)
{
    *scratch_out = NULL;
    if (N <= 1)
        return toorder;

    if (N <= 64) {
        for (int i = 1; i < N; ++i) {
            int value = toorder[i];
            int j = i;
            while (j > 0 && toorder[j - 1] > value) {
                toorder[j] = toorder[j - 1];
                --j;
            }
            toorder[j] = value;
        }
        return toorder;
    }

    size_t count = (size_t)N;
    if (UINT_MAX != 0xffffffffU || INT_MAX != 2147483647) {
        qsort(toorder, count, sizeof(*toorder), compare_ints);
        return toorder;
    }

    int *scratch = (int *)malloc(count * sizeof(*scratch));
    if (scratch == NULL) {
        qsort(toorder, count, sizeof(*toorder), compare_ints);
        return toorder;
    }
    *scratch_out = scratch;

    /* N is an int, so all counts and offsets fit in 32 bits. */
    unsigned int counts0[2048] = {0};
    unsigned int counts1[2048] = {0};
    unsigned int counts2[1024] = {0};

    /* All digit frequencies are invariant under the stable scatters. */
    for (size_t i = 0; i < count; ++i) {
        unsigned int key = (unsigned int)toorder[i] ^ 0x80000000U;
        ++counts0[key & 2047U];
        ++counts1[(key >> 11) & 2047U];
        ++counts2[key >> 22];
    }

    unsigned int offset = 0;
    for (unsigned int bucket = 0; bucket < 2048; ++bucket) {
        unsigned int frequency = counts0[bucket];
        counts0[bucket] = offset;
        offset += frequency;
    }
    offset = 0;
    for (unsigned int bucket = 0; bucket < 2048; ++bucket) {
        unsigned int frequency = counts1[bucket];
        counts1[bucket] = offset;
        offset += frequency;
    }
    offset = 0;
    for (unsigned int bucket = 0; bucket < 1024; ++bucket) {
        unsigned int frequency = counts2[bucket];
        counts2[bucket] = offset;
        offset += frequency;
    }

    for (size_t i = 0; i < count; ++i) {
        int value = toorder[i];
        unsigned int digit = (unsigned int)value & 2047U;
        scratch[counts0[digit]++] = value;
    }
    for (size_t i = 0; i < count; ++i) {
        int value = scratch[i];
        unsigned int digit = ((unsigned int)value >> 11) & 2047U;
        toorder[counts1[digit]++] = value;
    }
    for (size_t i = 0; i < count; ++i) {
        int value = toorder[i];
        unsigned int digit = ((unsigned int)value ^ 0x80000000U) >> 22;
        scratch[counts2[digit]++] = value;
    }
    return scratch;
}

/*
 * Public API: preserve the in-place sorting contract.
 */
void quicksort(int *toorder, int N)
{
    int *scratch = NULL;
    int *sorted = radix_sort(toorder, N, &scratch);
    if (sorted != toorder)
        memcpy(toorder, sorted, (size_t)N * sizeof(*toorder));
    free(scratch);
}

/*
 * Internal recursive function to quicksort
 */
void _quicksort(int *toorder, int lo, int hi)
{
    if (lo >= hi)
	return;
    int b = partition(toorder, lo, hi);
    _quicksort(toorder, lo, b - 1);
    _quicksort(toorder, b + 1, hi);
}

/*
 * Swap two values.
 */
void swap(int *toorder, int i, int j)
{
    int temp = toorder[i];
    toorder[i] = toorder[j];
    toorder[j] = temp;
}

/*
 * Partition decision
 */
int partition(int *toorder, int lo, int hi)
{
    int b = lo;
    int r = (int) (lo + (hi - lo) * (randnum() / MY_RAND_MAX));
    int pivot = toorder[r];
    swap(toorder, r, hi);
    for (int i = lo; i < hi; i++) {
	if (toorder[i] < pivot) {
	    swap(toorder, i, b);
	    b++;
	}
    }
    swap(toorder, hi, b);
    return b;
}

/*
 * Check if elements are in non-decreasing order
 */
int is_sorted(int *toorder, int N)
{
    for (int i = 1; i < N; i++) {
	if (toorder[i] < toorder[i - 1]) {
	    return 1;
	}
    }
    return 0;
}


/*
 * Generate a case
 */
int *generate_case(int N)
{
    int i;
    int *ret = NULL;

    // Make case generation reproducible
    srandnum(0);

    // Allocate memory
    ret = (int *) malloc(N * sizeof(int));
    if (ret == NULL) {
	printf("Error: some malloc won't work.\n");
	return NULL;
    }
    // Get pseudo-random positive integer values
    for (i = 0; i < N; i++) {
	ret[i] = drand(0, INT_MAX);
    }
    return ret;
}

/*
 * A pseudo-random number between two positive integer values
 */
double drand(int xmin, int xmax)
{
    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;
}

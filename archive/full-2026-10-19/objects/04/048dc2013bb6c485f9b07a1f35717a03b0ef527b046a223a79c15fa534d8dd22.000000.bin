{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include \\\"knn.h\\\"\\n\\n#include <stddef.h>\\n\\ntypedef struct {\\n    float distance;\\n    size_t encounter;\\n    char label;\\n} Candidate;\\n\\nstatic int candidate_is_worse(const Candidate *a, const Candidate *b) {\\n    if (a->distance > b->distance) return 1;\\n    if (a->distance < b->distance) return 0;\\n    return a->encounter > b->encounter;\\n}\\n\\nstatic void swap_candidates(Candidate *a, Candidate *b) {\\n    Candidate temporary = *a;\\n    *a = *b;\\n    *b = temporary;\\n}\\n\\nstatic void heap_sift_up(Candidate *heap, size_t child) {\\n    while (child > 0) {\\n        size_t parent = (child - 1) / 2;\\n        if (!candidate_is_worse(&heap[child], &heap[parent])) break;\\n        swap_candidates(&heap[child], &heap[parent]);\\n        child = parent;\\n    }\\n}\\n\\nstatic void heap_sift_down(Candidate *heap, size_t heap_size, size_t root) {\\n    while (root < heap_size / 2) {\\n        size_t worse_child = root * 2 + 1;\\n        size_t right_child = worse_child + 1;\\n        if (right_child < heap_size &&\\n            candidate_is_worse(&heap[right_child], &heap[worse_child])) {\\n            worse_child = right_child;\\n        }\\n        if (!candidate_is_worse(&heap[worse_child], &heap[root])) break;\\n        swap_candidates(&heap[worse_child], &heap[root]);\\n        root = worse_child;\\n    }\\n}\\n\\nstatic char classify_labels(char *labels, int k) {\\n    qsort(labels, (size_t)k, sizeof(char), compare_for_sort);\\n\\n    char most_frequent = labels[0];\\n    int most_frequent_count = 1;\\n    int current_frequency = 1;\\n\\n    for (int i = 1; i < k; i++) {\\n        if (labels[i] != labels[i - 1]) {\\n            if (current_frequency > most_frequent_count) {\\n                most_frequent = labels[i - 1];\\n                most_frequent_count = current_frequency;\\n            }\\n            current_frequency = 1;\\n        } else {\\n            current_frequency++;\\n        }\\n\\n        if (i == k - 1 && current_frequency > most_frequent_count) {\\n            most_frequent = labels[i - 1];\\n            most_frequent_count = current_frequency;\\n        }\\n    }\\n\\n    return most_frequent;\\n}\\n\\n/* Retain the original selection behavior for incomparable NaN distances. */\\nstatic char knn_original_selection(int n_groups, Group *groups, int k,\\n                                   Point to_evaluate) {\\n    char *labels = (char *)malloc(sizeof(char) * (size_t)k);\\n    float *distances = (float *)malloc(sizeof(float) * (size_t)k);\\n\\n    for (int i = 0; i < k; i++) {\\n        labels[i] = -1;\\n        distances[i] = -1;\\n    }\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        const Group *group = &groups[i];\\n\\n        for (int j = 0; j < group->length; j++) {\\n            Point point;\\n            point.x = group->coordinates[j];\\n            point.y = group->coordinates[(size_t)group->length + (size_t)j];\\n            float distance = euclidean_distance_no_sqrt(to_evaluate, point);\\n\\n            for (int x = 0; x < k; x++) {\\n                if (distance < distances[x] || distances[x] == -1) {\\n                    for (int y = k - 1; y > x; y--) {\\n                        distances[y] = distances[y - 1];\\n                        labels[y] = labels[y - 1];\\n                    }\\n                    distances[x] = distance;\\n                    labels[x] = group->label;\\n                    break;\\n                }\\n            }\\n        }\\n    }\\n\\n    char result = classify_labels(labels, k);\\n    free(distances);\\n    free(labels);\\n    return result;\\n}\\n\\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n    size_t capacity = (size_t)k;\\n    Candidate *heap = (Candidate *)malloc(sizeof(Candidate) * capacity);\\n    char *labels = (char *)malloc(sizeof(char) * capacity);\\n    size_t heap_size = 0;\\n    size_t encounter = 0;\\n\\n    for (size_t i = 0; i < capacity; i++) {\\n        labels[i] = -1;\\n    }\\n\\n    const float query_x = to_evaluate.x;\\n    const float query_y = to_evaluate.y;\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        const Group *group = &groups[i];\\n        const float *coordinates = group->coordinates;\\n        const size_t y_offset = (size_t)group->length;\\n        const char label = group->label;\\n\\n        for (int j = 0; j < group->length; j++) {\\n            const size_t index = (size_t)j;\\n            float dx = coordinates[index] - query_x;\\n            float dy = coordinates[y_offset + index] - query_y;\\n            float distance = dx * dx + dy * dy;\\n\\n            if (distance != distance) {\\n                free(heap);\\n                free(labels);\\n                return knn_original_selection(n_groups, groups, k, to_evaluate);\\n            }\\n\\n            Candidate candidate = { distance, encounter, label };\\n            if (heap_size < capacity) {\\n                size_t position = heap_size++;\\n                heap[position] = candidate;\\n                heap_sift_up(heap, position);\\n            } else if (candidate_is_worse(&heap[0], &candidate)) {\\n                heap[0] = candidate;\\n                heap_sift_down(heap, heap_size, 0);\\n            }\\n\\n            ++encounter;\\n        }\\n    }\\n\\n    for (size_t i = 0; i < heap_size; i++) {\\n        labels[i] = heap[i].label;\\n    }\\n\\n    char result = classify_labels(labels, k);\\n    free(heap);\\n    free(labels);\\n    return result;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    Group *groups = (Group *)malloc(sizeof(Group) * (size_t)n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n    Point to_evaluate = parse_point();\\n    char result = knn(n_groups, groups, k, to_evaluate);\\n    printf(\\\"%c\\\", result);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        free(groups[i].coordinates);\\n    }\\n    free(groups);\\n    return 0;\\n}\\n\",\"path\":\"src/knn.c\"},{\"content\":\"#include <stdio.h>\\n#include <stdlib.h>\\n\\n+typedef struct {\\n    float x;\\n    float y;\\n} Point;\\n\\ntypedef struct {\\n    char label;\\n    int length;\\n    float *coordinates;\\n} Group;\\n\\nvoid on_error() {\\n    printf(\\\"Invalid input file.\\\\n\\\");\\n    exit(1);\\n}\\n\\nint parse_number_of_groups() {\\n    int n;\\n    if (scanf(\\\" n_groups=%d \\\", &n) != 1) on_error();\\n\\n    return n;\\n}\\n\\nPoint parse_point() {\\n    float x, y;\\n    if (scanf(\\\" (%f ,%f) \\\", &x, &y) != 2) on_error();\\n\\n    Point point;\\n    point.x = x;\\n    point.y = y;\\n\\n    return point;\\n}\\n\\nGroup parse_next_group() {\\n    char label;\\n    int length;\\n\\n    if (scanf(\\\" label=%c \\\", &label) != 1) on_error();\\n    if (scanf(\\\" length=%d \\\", &length) != 1) on_error();\\n\\n    Group group;\\n    group.label = label;\\n    group.length = length;\\n    group.coordinates = (float *)malloc(sizeof(float) * (size_t)length * 2);\\n\\n    for (int i = 0; i < length; i++) {\\n        Point point = parse_point();\\n        group.coordinates[i] = point.x;\\n        group.coordinates[(size_t)length + (size_t)i] = point.y;\\n    }\\n\\n    return group;\\n}\\n\\nint parse_k() {\\n    int k;\\n    if (scanf(\\\" k=%d \\\", &k) != 1) on_error();\\n\\n    return k;\\n}\\n\\nfloat euclidean_distance_no_sqrt(Point a, Point b) {\\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\\n}\\n\\nint compare_for_sort(const void *a, const void *b) {\\n    return *(char *)a - *(char *)b;\\n}\\n\",\"path\":\"src/knn.h\"}],\"hypothesis\":\"A serial bounded max-heap paired with per-group x/y structure-of-arrays storage should reduce selection work and improve coordinate scanning on the ARM64 target. Falling back to the original selection logic on NaN distances preserves its behavior where a total heap ordering is unavailable; OpenMP is omitted because the archived parallel candidates were slower.\",\"notes\":\"Retains the SoA and heap ideas and the NaN fallback. No local commands or measurements were run; the controller evaluates correctness and speed.\",\"sources_kept\":[\"4e5248ae712349b9\",\"718bf7eca1eb4d80\"],\"transformations\":[\"Store each group's coordinates in one allocation with separate contiguous x and y planes; hoist query coordinates and scan those planes in the distance loop.\",\"Keep at most k candidates in a max-heap ordered by squared distance and original encounter index, preserving first-encounter ties and -1 padding for underfilled k.\",\"Use the baseline sorted-array selection path if a computed distance is NaN; retain the existing label sort and vote logic.\"]}"}}

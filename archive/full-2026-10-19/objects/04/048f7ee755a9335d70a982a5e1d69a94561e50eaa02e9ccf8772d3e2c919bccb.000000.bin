{
  "src/knn.c": "#include \"knn.h\"\n\n#ifdef _OPENMP\n#include <omp.h>\n\ntypedef struct {\n    char *labels;\n    float *distances;\n    int count;\n    int next;\n} KnnLocalNeighbors;\n\nstatic int select_neighbors_parallel(int n_groups, Group *groups, int k,\n                                     Point to_evaluate, char *labels,\n                                     float *distances) {\n    if (k <= 0 || omp_in_parallel()) return 0;\n\n    int thread_limit = omp_get_max_threads();\n    if (thread_limit < 2) return 0;\n\n    size_t total = 0;\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length > 0) total += (size_t)groups[i].length;\n    }\n\n    /* Require substantial estimated selector work and points per worker. */\n    size_t grain = ((size_t)262144 + (size_t)k - 1) / (size_t)k;\n    if (grain < 1024) grain = 1024;\n    size_t useful_threads = total / grain;\n    if (useful_threads < 2) return 0;\n    if (useful_threads < (size_t)thread_limit) {\n        thread_limit = (int)useful_threads;\n    }\n\n    KnnLocalNeighbors *locals = (KnnLocalNeighbors *)calloc(\n        (size_t)thread_limit, sizeof(KnnLocalNeighbors));\n    if (locals == NULL) return 0;\n\n    int actual_threads = 0;\n    int allocation_failed = 0;\n    int nan_seen = 0;\n\n    #pragma omp parallel num_threads(thread_limit) reduction(|: allocation_failed, nan_seen)\n    {\n        int tid = omp_get_thread_num();\n        int team_size = omp_get_num_threads();\n        if (tid == 0) actual_threads = team_size;\n\n        if (team_size == 1) {\n            allocation_failed = 1;\n        } else {\n            size_t base = total / (size_t)team_size;\n            size_t extra = total % (size_t)team_size;\n            size_t rank = (size_t)tid;\n            size_t begin = rank * base + (rank < extra ? rank : extra);\n            size_t length = base + (rank < extra ? 1 : 0);\n            int capacity = length < (size_t)k ? (int)length : k;\n            KnnLocalNeighbors *local = &locals[tid];\n\n            local->count = capacity;\n            local->labels = (char *)malloc((size_t)capacity * sizeof(char));\n            local->distances = (float *)malloc((size_t)capacity * sizeof(float));\n\n            if (local->labels == NULL || local->distances == NULL) {\n                allocation_failed = 1;\n            } else {\n                for (int x = 0; x < capacity; x++) {\n                    local->labels[x] = -1;\n                    local->distances[x] = -1;\n                }\n\n                /* Each worker visits one contiguous group-major range. */\n                size_t skip = begin;\n                size_t remaining = length;\n                for (int i = 0; i < n_groups && remaining != 0 && !nan_seen; i++) {\n                    Group g = groups[i];\n                    size_t group_length = g.length > 0 ? (size_t)g.length : 0;\n                    if (skip >= group_length) {\n                        skip -= group_length;\n                        continue;\n                    }\n\n                    size_t take = group_length - skip;\n                    if (take > remaining) take = remaining;\n                    size_t end = skip + take;\n\n                    for (size_t j = skip; j < end; j++) {\n                        float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n                        if (d != d) {\n                            nan_seen = 1;\n                            break;\n                        }\n\n                        /* Preserve the original insertion recurrence locally. */\n                        for (int x = 0; x < capacity; x++) {\n                            if (d < local->distances[x] || local->distances[x] == -1) {\n                                for (int y = capacity - 1; y > x; y--) {\n                                    local->distances[y] = local->distances[y - 1];\n                                    local->labels[y] = local->labels[y - 1];\n                                }\n                                local->distances[x] = d;\n                                local->labels[x] = g.label;\n                                break;\n                            }\n                        }\n                    }\n\n                    remaining -= take;\n                    skip = 0;\n                }\n            }\n        }\n    }\n\n    int selected = !allocation_failed && !nan_seen;\n    if (selected) {\n        /* Equal distances favor the earlier contiguous input partition. */\n        for (int x = 0; x < k; x++) {\n            int best = -1;\n            float best_distance = 0.0f;\n            for (int t = 0; t < actual_threads; t++) {\n                KnnLocalNeighbors *local = &locals[t];\n                if (local->next < local->count) {\n                    float d = local->distances[local->next];\n                    if (best < 0 || d < best_distance) {\n                        best = t;\n                        best_distance = d;\n                    }\n                }\n            }\n            if (best < 0) break;\n            KnnLocalNeighbors *local = &locals[best];\n            distances[x] = best_distance;\n            labels[x] = local->labels[local->next];\n            local->next++;\n        }\n    }\n\n    for (int t = 0; t < thread_limit; t++) {\n        free(locals[t].labels);\n        free(locals[t].distances);\n    }\n    free(locals);\n    return selected;\n}\n#endif\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    int selected = 0;\n#ifdef _OPENMP\n    selected = select_neighbors_parallel(n_groups, groups, k, to_evaluate,\n                                         labels, distances);\n#endif\n\n    /* NaNs require the original encounter-order algorithm, not a sorted merge. */\n    if (!selected) {\n        for (i = 0; i < n_groups; i++) {\n            Group g = groups[i];\n\n            for (j = 0; j < g.length; j++) {\n                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n                for (x = 0; x < k; x++) {\n                    if (d < distances[x] || distances[x] == -1) {\n                        for (y = k - 1; y > x; y--) {\n                            distances[y] = distances[y - 1];\n                            labels[y] = labels[y - 1];\n                        }\n\n                        distances[x] = d;\n                        labels[x] = g.label;\n\n                        break;\n                    }\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(labels);\n    free(distances);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
  "src/knn.h": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}"
}

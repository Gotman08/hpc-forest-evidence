{
  "hypothesis": "Improve memory locality and loop order by reorganizing the loops to process points in a more cache-friendly manner. Specifically, we will focus on reducing the number of times distances are updated and sorted by using blocking techniques.",
  "transformations": [
    "Reordered loops for better cache locality",
    "Used blocking technique to reduce distance updates and sorts"
  ],
  "sources_kept": [],
  "files": [
    {
      "path": "src/knn.c",
      "content": "#include \"knn.h\"\n\n#define BLOCK_SIZE 16\n\ntypedef struct {\n    float distance;\n    char label;\n} DistanceLabel;\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    DistanceLabel *distances = (DistanceLabel *)malloc(sizeof(DistanceLabel) * k);\n\n    for (int i = 0; i < k; i++) {\n        distances[i].distance = -1;\n        distances[i].label = -1;\n    }\n\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        int num_blocks = (g.length + BLOCK_SIZE - 1) / BLOCK_SIZE;\n\n        for (int block = 0; block < num_blocks; block++) {\n            DistanceLabel *block_distances = (DistanceLabel *)malloc(sizeof(DistanceLabel) * k);\n\n            for (int j = 0; j < k; j++) {\n                block_distances[j].distance = -1;\n                block_distances[j].label = -1;\n            }\n\n            int start = block * BLOCK_SIZE;\n            int end = (block + 1) * BLOCK_SIZE > g.length ? g.length : (block + 1) * BLOCK_SIZE;\n\n            for (int j = start; j < end; j++) {\n                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n                for (int x = 0; x < k; x++) {\n                    if (d < block_distances[x].distance || block_distances[x].distance == -1) {\n                        for (int y = k - 1; y > x; y--) {\n                            block_distances[y] = block_distances[y - 1];\n                        }\n\n                        block_distances[x].distance = d;\n                        block_distances[x].label = g.label;\n\n                        break;\n                    }\n                }\n            }\n\n            for (int x = 0; x < k; x++) {\n                float d = block_distances[x].distance;\n                char l = block_distances[x].label;\n\n                if (d != -1) {\n                    for (int y = k - 1; y > x; y--) {\n                        if (d < distances[y].distance || distances[y].distance == -1) {\n                            distances[y] = distances[y - 1];\n                        } else {\n                            break;\n                        }\n                    }\n\n                    distances[x].distance = d;\n                    distances[x].label = l;\n                }\n            }\n\n            free(block_distances);\n        }\n    }\n\n    qsort(distances, k, sizeof(DistanceLabel), compare_for_sort);\n\n    char most_frequent = distances[0].label;\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (distances[i].label != distances[i - 1].label) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = distances[i - 1].label;\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = distances[i].label;\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}"
    },
    {
      "path": "src/knn.h",
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\n#define BLOCK_SIZE 16\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point *points;\n} Group;\n\ntypedef struct {\n    float distance;\n    char label;\n} DistanceLabel;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *)malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt(Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  DistanceLabel *da = (DistanceLabel *)a;\n  DistanceLabel *db = (DistanceLabel *)b;\n  return da->distance < db->distance ? -1 : (da->distance > db->distance);\n}"
    }
  ],
  "notes": "Reorganized loops and introduced blocking to improve memory locality and reduce the number of distance updates and sorts."
}

      "content": "#include \"knn.h\"\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <stdint.h>\n#include <arm_neon.h>\n#endif\n\nstatic inline int knn_insert_neighbor(float d, char label, int k,\n                                      float *distances, char *labels) {\n    for (int x = 0; x < k; x++) {\n        if (d < distances[x] || distances[x] == -1) {\n            for (int y = k - 1; y > x; y--) {\n                distances[y] = distances[y - 1];\n                labels[y] = labels[y - 1];\n            }\n\n            distances[x] = d;\n            labels[x] = label;\n            return 1;\n        }\n    }\n\n    return 0;\n}\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic inline uint32x4_t knn_axis_candidates(const Point *points,\n                                            float32x4_t target_x,\n                                            float32x4_t target_y,\n                                            float32x4_t cutoff) {\n    float32x4x2_t xy = vld2q_f32((const float *) points);\n    float32x4_t dx = vsubq_f32(xy.val[0], target_x);\n    float32x4_t dy = vsubq_f32(xy.val[1], target_y);\n\n    /* Each rounded squared coordinate is a lower bound on the distance. */\n    return vandq_u32(vcltq_f32(vmulq_f32(dx, dx), cutoff),\n                     vcltq_f32(vmulq_f32(dy, dy), cutoff));\n}\n\nstatic inline unsigned int knn_block_candidates(const Point *points,\n                                                Point target, float limit) {\n    static const uint32_t lane_weights[4] = {1u, 2u, 4u, 8u};\n    uint32x4_t weights = vld1q_u32(lane_weights);\n    float32x4_t target_x = vdupq_n_f32(target.x);\n    float32x4_t target_y = vdupq_n_f32(target.y);\n    float32x4_t cutoff = vdupq_n_f32(limit);\n\n    uint32x4_t m0 = vandq_u32(\n        knn_axis_candidates(points, target_x, target_y, cutoff), weights);\n    uint32x4_t m1 = vandq_u32(\n        knn_axis_candidates(points + 4, target_x, target_y, cutoff),\n        vshlq_n_u32(weights, 4));\n    uint32x4_t m2 = vandq_u32(\n        knn_axis_candidates(points + 8, target_x, target_y, cutoff),\n        vshlq_n_u32(weights, 8));\n    uint32x4_t m3 = vandq_u32(\n        knn_axis_candidates(points + 12, target_x, target_y, cutoff),\n        vshlq_n_u32(weights, 12));\n\n    return (unsigned int) vaddvq_u32(\n        vorrq_u32(vorrq_u32(m0, m1), vorrq_u32(m2, m3)));\n}\n#endif\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j;\n    int filled = 0;\n    int ordered = 1;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        j = 0;\n\n        while (j < g.length) {\n#if defined(__aarch64__) && defined(__ARM_NEON)\n            if (k > 0 && ordered && filled == k && g.length - j >= 16) {\n                /* The full list's cutoff can only decrease within this block. */\n                unsigned int mask = knn_block_candidates(\n                    g.points + j, to_evaluate, distances[k - 1]);\n\n                while (mask != 0u) {\n                    int lane = __builtin_ctz(mask);\n                    mask &= mask - 1u;\n\n                    float d = euclidean_distance_no_sqrt(\n                        to_evaluate, g.points[j + lane]);\n                    if (d < distances[k - 1]) {\n                        knn_insert_neighbor(d, g.label, k, distances, labels);\n                    }\n                }\n\n                j += 16;\n                continue;\n            }\n#endif\n\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            if (filled < k || !ordered ||\n                (k > 0 && d < distances[k - 1])) {\n                if (knn_insert_neighbor(d, g.label, k, distances, labels)) {\n                    if (filled < k) {\n                        filled++;\n                    }\n                    /* Retain the original scan if a stored NaN breaks ordering. */\n                    if (d != d) {\n                        ordered = 0;\n                    }\n                }\n            }\n\n            j++;\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "A 16-point NEON coordinate-bound filter can eliminate most serial insertion scans while preserving scalar distance arithmetic and stable encounter order.",

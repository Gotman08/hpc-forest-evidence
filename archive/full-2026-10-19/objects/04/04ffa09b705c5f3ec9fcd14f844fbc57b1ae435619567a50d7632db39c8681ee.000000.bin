import hashlib
import json
import math
import re
from pathlib import Path

from pypdf import PdfReader

work=Path(__file__).resolve().parent
out=work.parents[1]/"outputs/Rapport-HPC-Forest-ROMEO"
project=work.parents[1]/"outputs/HPC-Forest"
data=json.loads((out/"donnees-arbres.json").read_text(encoding="utf-8"))
final=[c for c in data["campaigns"] if c["job"]=="746831"]
assert [(c["all_nodes"],c["solution_nodes"],c["max_depth"]) for c in final]==[(6,2,1),(9,5,1)]
assert [c["checkpoint_bytes"] for c in final]==[16078,18912]
for c in final:
    assert len(c["trees"])==4
    assert all(t["size_property"]==len(t["nodes"]) for t in c["trees"])
    assert all(t["parent"] is None for t in c["trials"])
    base=next(e["payload"] for e in c["evaluations"] if e["experiment_id"]=="baseline-e1" and e["phase"]=="search")
    for t in c["trials"]:
        r=t["outcome"]
        if r.get("score") is not None:
            assert math.isclose(r["score"],base["mean_seconds"]/(base["mean_seconds"]+r["mean_seconds"]),abs_tol=1e-12)
    best=c["best"]
    assert math.isclose(best["improvement_fraction"],1-best["mean_seconds"]/best["reference_seconds"],abs_tol=1e-12)
seven=final[0]
binsha={e["experiment_id"]:e["payload"]["binary_sha256"] for e in seven["evaluations"]
        if e["phase"]=="search" and e["payload"].get("binary_sha256")}
assert binsha["da84e24ec76f4082"]==binsha["5aa8da06bf974494"]
assert sum(c["costs"]["tokens_used"] for c in data["campaigns"])==37803
reader=PdfReader(out/"rapport-detaille.pdf")
assert len(reader.pages)==16
content="\n".join(p.extract_text() for p in reader.pages)
assert "\ufffd" not in content
for expected in ["74,1614", "73,3086", "33,523", "18 912", "16 078", "0,794703887", "37 803"]:
    assert expected in content, expected
md=(out/"rapport-detaille.md").read_text(encoding="utf-8")
assert md.count("```mermaid")==5
assert md.count("accTitle:")==md.count("accDescr:")==5
manifest=json.loads((out/"manifest.json").read_text())
assert hashlib.sha256((out/"rapport-detaille.pdf").read_bytes()).hexdigest()==manifest["pdf_sha256"]
assert hashlib.sha256((out/"rapport-detaille.md").read_bytes()).hexdigest()==manifest["markdown_sha256"]
assert hashlib.sha256((out/"donnees-arbres.json").read_bytes()).hexdigest()==manifest["data_sha256"]
receipt={"pdf_pages":len(reader.pages),"tree_checkpoint_counts_checked":True,"scores_recalculated":True,
         "gain_formulas_recalculated":True,"binary_duplicate_checked":True,"tokens_reconciled":37803,
         "mermaid_diagrams_checked":5,"pdf_text_and_margins_checked":True,
         "visual_review":"All 16 pages reviewed in contact sheets; pages 6, 7, 11 and 16 inspected individually",
         "new_cluster_jobs":0}
(out/"verification.json").write_text(json.dumps(receipt,indent=2,ensure_ascii=False)+"\n",encoding="utf-8")
print(json.dumps(receipt,indent=2))

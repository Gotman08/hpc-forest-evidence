{
  "text": "\"\"\"Closed Sol source-only accounting from immutable received metadata only.\"\"\"\nfrom __future__ import annotations\n\nimport json\nfrom collections import Counter\nfrom pathlib import Path\n\nJOB = \"751592\"\nSESSION = \"665743a02b824021a697b6a4884a667c\"\nMODEL = \"gpt-6.1-sol\"\nCAMPAIGN = \"comparaison-source-only/sol-max-751592\"\nCOHORT = \"source_only_sol_max_fifteen_subjects\"\nROLES = {\"mother-preparation\": \"mère\", \"mother-synthesis\": \"mère\",\n         \"A\": \"enfant\", \"B\": \"enfant\", \"C\": \"enfant\", \"G\": \"intégration\"}\nPINS = {\n    \"receipt\": \"6cd1f532e43bf4fae443bc58e38527847df6cb03511fa84a8d233199db1b41e7\",\n    \"independent_audit\": \"c1eba0cfe33307451489eb7e3abc9bf0910f963328564e80eb68de42e47c9328\",\n    \"reconciliation\": \"0ed5c437d3737ec9a970a4183b3e80ce996e87a7f655e5fba9965a979682def8\",\n    \"nonce_ledger\": \"e59648ab81c4ad5dd18a4332eecda57c136e7299afae501673df9b4dad913504\",\n    \"late_remote_readback\": \"a62a6cdec8849d5e6f9b6f4c9a60013c4a843d2645ba170e347f780ad67e362c\",\n    \"normalization\": \"37d1f016096ae5b325de3da00322511047ecbcceb36bf9b281ec411a9d292b5a\",\n}\nUSAGE_KEYS = {\"input_tokens\", \"output_tokens\", \"cached_input_tokens\",\n              \"cache_write_input_tokens\", \"reasoning_output_tokens\"}\n\n\ndef require(value, message):\n    if not value:\n        raise ValueError(message)\n\n\ndef classify(item):\n    for key in (\"native_invocation_observed\", \"usage_measured\", \"unknown_consumption\",\n                \"not_called_before_expiry\", \"archived_response_present\", \"late_local_delivery_only\"):\n        require(type(item[key]) is bool, \"Nonboolean closed-call fact\")\n    require(item[\"role\"] in ROLES, \"Unknown source-only role\")\n    exact = item[\"known_exact_tokens\"]\n    if item[\"not_called_before_expiry\"]:\n        require(not item[\"native_invocation_observed\"] and item[\"usage_measured\"]\n                and not item[\"unknown_consumption\"] and type(exact) is int and exact == 0\n                and item[\"response_error_class\"] == \"expired_before_invocation\",\n                \"Zero-call expiry is not proven\")\n        return \"expired_before_invocation_proven\"\n    require(item[\"native_invocation_observed\"], \"Unclassified non-invocation\")\n    if not item[\"usage_measured\"]:\n        require(exact is None and item[\"unknown_consumption\"]\n                and item.get(\"usage_subdivisions\") is None, \"Unknown usage became a total\")\n        return \"unmeasured\"\n    usage = item.get(\"usage_subdivisions\")\n    require(type(exact) is int and exact >= 0 and not item[\"unknown_consumption\"]\n            and type(usage) is dict and set(usage) == USAGE_KEYS\n            and all(type(v) is int and v >= 0 for v in usage.values()), \"Bad exact usage\")\n    require(exact == usage[\"input_tokens\"] + usage[\"output_tokens\"]\n            and usage[\"cached_input_tokens\"] <= usage[\"input_tokens\"]\n            and usage[\"cache_write_input_tokens\"] <= usage[\"input_tokens\"]\n            and usage[\"reasoning_output_tokens\"] <= usage[\"output_tokens\"],\n            \"Subdivisions contradict total or were counted twice\")\n    return \"exact\"\n\n\ndef closed_sol_accounting(cohort, admissions, *, read, record, save, sha):\n    require(__debug__, \"Never audit under Python -O\")\n    reviewed = [x for x in admissions[\"reviewed_new_cohorts\"] if x[\"cohort\"] == COHORT]\n    require(len(reviewed) == 1, \"Sol needs exactly one explicit admission\")\n    artifacts = reviewed[0][\"artifacts\"]\n    require(set(artifacts) == set(PINS), \"Unexpected Sol admission artifact set\")\n    folder = Path(artifacts[\"receipt\"][\"path\"]).parent.resolve()\n    values = {}\n    for name, expected in PINS.items():\n        item = artifacts[name]\n        require(type(item) is dict and set(item) == {\"path\", \"sha256\"}\n                and item[\"sha256\"] == expected, \"Wrong scoped Sol artifact\")\n        path = Path(item[\"path\"])\n        require(not path.is_symlink() and path.resolve(strict=True).is_relative_to(folder)\n                and sha(path) == expected, \"Changed/out-of-scope closed artifact\")\n        values[name] = read(path)\n    receipt, audit, recon, ledger = (values[x] for x in\n                                    (\"receipt\", \"independent_audit\", \"reconciliation\", \"nonce_ledger\"))\n    for value in (receipt, audit, recon):\n        require(value[\"verified\"] is True and str(value[\"job_id\"]) == JOB\n                and value[\"session_id\"] == SESSION and value[\"model\"] == MODEL\n                and value[\"effort\"] == \"max\", \"Closed Sol identity differs\")\n    require(receipt[\"schema\"] == \"hpc-forest-source-only-sol-max-final-reception-v1\"\n            and audit[\"schema\"] == \"hpc-forest-source-only-independent-cold-audit-v1\"\n            and recon[\"schema\"] == \"hpc-forest-source-only-native-delivery-reconciliation-v1\"\n            and ledger[\"schema\"] == \"hpc-forest-source-only-nonce-ledger-v1\",\n            \"Do not reinterpret an older receipt schema\")\n    require(receipt[\"scientific_reception_verified\"] is True\n            and receipt[\"independent_audit_verified\"] is True\n            and receipt[\"all_started_calls_reconciled\"] is True\n            and receipt[\"all124_deliveries_archive_or_fresh_remote_readback_supported\"] is True\n            and recon[\"all_started_call_states_terminal\"] is True\n            and recon[\"source_only_protocol94_verified\"] is True\n            and recon[\"all_cli_source_execution_allowed_false\"] is True\n            and recon[\"all_mother_child_G_requested_model_effort_same\"] is True\n            and recon[\"cache_and_reasoning_subdivisions_not_added_again\"] is True\n            and recon[\"all_published_requests_have_bound_local_delivery_receipt\"] is True\n            and type(recon[\"unknown_invocations\"]) is int and recon[\"unknown_invocations\"] == 0\n            and recon[\"unresolved\"] == []\n            and recon[\"total_exact_consumption_available\"] is False\n            and recon[\"exact_consumption_tokens_total\"] is None,\n            \"Closed-call reconciliation incomplete\")\n    require(audit[\"independent_execution_or_performance_audit_verified\"] is False\n            and audit[\"physical_backend_model_identity_independently_attested\"] is False\n            and audit[\"native_codex_treatment_admitted\"] is False and audit[\"r3_normal_admitted\"] is False,\n            \"Archived source-only facts were promoted to another treatment\")\n    late = values[\"late_remote_readback\"]\n    require(late[\"schema\"] == \"hpc-forest-sol-max-late-remote-readback-v1\"\n            and late[\"verified\"] is True and late[\"all_124_deliveries_readback_supported\"] is True\n            and late[\"archive_not_modified\"] is True and late[\"new_inference_or_replay\"] is False,\n            \"Late negative delivery lacks its genuine readback\")\n    normalized = values[\"normalization\"][\"exports\"][\"results\"]\n    require(sha(Path(normalized[\"path\"])) == normalized[\"sha256\"]\n            and cohort == read(Path(normalized[\"path\"])), \"Normalized Sol cohort differs\")\n    require(ledger[\"job_id\"] == JOB and ledger[\"session_id\"] == SESSION\n            and ledger[\"records\"] == recon[\"records\"], \"Ledger binding differs\")\n    records = ledger[\"records\"]\n    require(len(records) == len({x[\"nonce\"] for x in records}) == 124, \"Duplicate/missing nonces\")\n    cold_roots = (folder / \"restauration-neuve\", folder / \"reconciliation-livraisons-r1/capture-01/pieces-supplementaires\",\n                  folder / \"livraison-tardive-distante-r1\")\n\n    def cold_reference(item):\n        require(type(item) is dict and set(item) == {\"path\", \"sha256\"}, \"Nonclosed payload reference\")\n        path = Path(item[\"path\"])\n        require(not path.is_symlink() and any(path.resolve(strict=True).is_relative_to(root)\n                    for root in cold_roots) and sha(path) == item[\"sha256\"], \"Cold bytes changed or escaped\")\n        record(path)  # Hash/record only: never decode model payload or consult original worker.\n\n    calls = []\n    for item in records:\n        state = classify(item)\n        for evidence in [*item[\"payload_refs\"].values(), item[\"archive_request\"], item[\"subject_journal_request\"]]:\n            cold_reference(evidence)\n        require(item[\"request_sha256\"] == item[\"archive_request\"][\"sha256\"], \"Request digest differs\")\n        usage = item.get(\"usage_subdivisions\")\n        calls.append({\"session_id\": SESSION, \"nonce\": item[\"nonce\"], \"subject\": item[\"subject\"],\n                      \"campaign\": CAMPAIGN, \"model\": MODEL, \"effort\": \"max\", \"job_id\": JOB,\n                      \"kind\": ROLES[item[\"role\"]], \"role\": item[\"role\"], \"state\": state,\n                      \"native_invocation_observed\": item[\"native_invocation_observed\"],\n                      \"native_cli_invocation_observed\": item[\"native_invocation_observed\"],\n                      \"backend_model_identity_independently_attested\": False,\n                      \"usage_measured\": item[\"usage_measured\"], \"exact_total\": item[\"known_exact_tokens\"],\n                      \"input_tokens\": usage[\"input_tokens\"] if usage else (0 if state.startswith(\"expired\") else None),\n                      \"output_tokens\": usage[\"output_tokens\"] if usage else (0 if state.startswith(\"expired\") else None),\n                      \"usage_subdivisions\": usage, \"request_sha256\": item[\"request_sha256\"],\n                      \"response_sha256\": item[\"response_sha256\"], \"delivery_verified\": True,\n                      \"late_originally_absent_from_archive\": item[\"late_local_delivery_only\"]})\n    require(Counter(x[\"state\"] for x in calls) == {\"exact\": 111, \"unmeasured\": 10,\n                                                   \"expired_before_invocation_proven\": 3},\n            \"Measured requests/invocations or expiries conflated\")\n    require(sum(x[\"exact_total\"] for x in calls if x[\"exact_total\"] is not None) == 2676472\n            and sum(x[\"native_invocation_observed\"] for x in calls) == 121, \"Closed Sol totals differ\")\n    for files in late[\"files\"]:\n        require(files[\"received\"][\"sha256\"] == files[\"source_preserved\"][\"sha256\"], \"Late bytes differ\")\n        cold_reference(files[\"received\"])\n        cold_reference(files[\"source_preserved\"])\n    late_calls = [x for x in calls if x[\"late_originally_absent_from_archive\"]]\n    require(len(late_calls) == 1 and late_calls[0][\"nonce\"] == late[\"nonce\"]\n            and late_calls[0][\"exact_total\"] is None, \"Late unknown was changed\")\n    totals = {}\n    for row in cohort[\"rows\"]:\n        selected = [x for x in calls if x[\"subject\"] == row[\"subject\"]]\n        totals[row[\"subject\"]] = {\n            \"native_calls\": sum(x[\"native_invocation_observed\"] for x in selected),\n            \"known_exact_tokens\": sum(x[\"exact_total\"] for x in selected if x[\"exact_total\"] is not None),\n            \"unmetered_calls\": sum(x[\"native_invocation_observed\"] and x[\"exact_total\"] is None for x in selected),\n            \"published_requests\": len(selected), \"verified_deliveries\": len(selected),\n            \"expired_before_invocation\": sum(x[\"state\"] == \"expired_before_invocation_proven\" for x in selected),\n        }\n    require(len(totals) == 15 and set(totals) == {x[\"subject\"] for x in calls}, \"Subject coverage differs\")\n    summary = {\"published_requests\": 124, \"verified_deliveries\": 124,\n               \"native_invocations_observed\": 121, \"measured_native_invocations\": 111,\n               \"requests_with_exact_value_including_preinvocation_zero\": 114,\n               \"known_exact_tokens\": 2676472, \"unmeasured_native_invocations\": 10,\n               \"requests_with_unknown_consumption\": 10, \"expired_before_invocation_proven\": 3,\n               \"late_response_originally_absent_from_archive\": 1,\n               \"all124_deliveries_archive_or_remote_readback_supported\": True}\n    save(\"couts-source-only-sol.json\", {\"schema\": \"closed-source-only-sol-editorial-accounting-v1\",\n         \"job_id\": JOB, \"session_id\": SESSION, \"artifacts\": artifacts, \"per_subject\": totals,\n         \"native_calls\": calls, \"request_summary\": summary, \"total_exact_consumption_available\": False,\n         \"exact_consumption_tokens_total\": None, \"reservations_are_not_consumption\": True,\n         \"cache_and_reasoning_subdivisions_already_included\": True,\n         \"detailed_role_totals\": recon[\"by_role\"], \"no_live_worker_or_lock_read\": True,\n         \"backend_model_identity_independently_attested\": False,\n         \"independent_execution_or_performance_audit_verified\": False})\n    return totals\n\n\ndef self_test():\n    base = {\"native_invocation_observed\": True, \"usage_measured\": True, \"unknown_consumption\": False,\n            \"not_called_before_expiry\": False, \"archived_response_present\": True,\n            \"late_local_delivery_only\": False, \"role\": \"G\", \"known_exact_tokens\": 9,\n            \"response_error_class\": \"none\", \"usage_subdivisions\": {\"input_tokens\": 4, \"output_tokens\": 5,\n            \"cached_input_tokens\": 2, \"cache_write_input_tokens\": 1, \"reasoning_output_tokens\": 3}}\n    require(classify(base) == \"exact\", \"Neutral exact check failed\")\n    unknown = {**base, \"usage_measured\": False, \"unknown_consumption\": True,\n               \"known_exact_tokens\": None, \"usage_subdivisions\": None}\n    require(classify(unknown) == \"unmeasured\", \"Neutral unknown check failed\")\n    expiry = {**base, \"native_invocation_observed\": False, \"not_called_before_expiry\": True,\n              \"known_exact_tokens\": 0, \"response_error_class\": \"expired_before_invocation\",\n              \"usage_subdivisions\": None}\n    require(classify(expiry) == \"expired_before_invocation_proven\", \"Neutral expiry check failed\")\n    for invalid in ({**unknown, \"known_exact_tokens\": 0}, {**expiry, \"native_invocation_observed\": True},\n                    {**base, \"usage_subdivisions\": {**base[\"usage_subdivisions\"], \"extra\": 0}},\n                    {**base, \"native_invocation_observed\": 1}, {**base, \"role\": \"sister\"}):\n        try:\n            classify(invalid)\n        except ValueError:\n            continue\n        raise AssertionError(\"Neutral contradiction accepted\")\n    return 8\n\n\nif __name__ == \"__main__\":\n    print(json.dumps({\"neutral_checks_passed\": self_test(), \"model_calls\": 0, \"live_cache_reads\": 0}))\n"
}

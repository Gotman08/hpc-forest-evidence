      "content": "#include \"knn.h\"\n#include <limits.h>\n\ntypedef struct {\n    size_t order;\n    float distance;\n    char label;\n} KnnNeighbor;\n\nstatic inline int knn_farther(KnnNeighbor a, KnnNeighbor b) {\n    return a.distance > b.distance ||\n           (a.distance == b.distance && a.order > b.order);\n}\n\nstatic inline void knn_sift_down(KnnNeighbor *heap, size_t count,\n                                 size_t root, KnnNeighbor value) {\n    size_t child = root * 2 + 1;\n\n    while (child < count) {\n        if (child + 1 < count &&\n            knn_farther(heap[child + 1], heap[child])) {\n            child++;\n        }\n\n        if (!knn_farther(heap[child], value)) {\n            break;\n        }\n\n        heap[root] = heap[child];\n        root = child;\n        child = root * 2 + 1;\n    }\n\n    heap[root] = value;\n}\n\nstatic char knn_reference(int n_groups, Group *groups, int k,\n                          Point to_evaluate) {\n    char *labels = (char *) malloc(sizeof(char) * k);\n    float *distances = (float *) malloc(sizeof(float) * k);\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) {\n        return knn_reference(n_groups, groups, k, to_evaluate);\n    }\n\n    const size_t capacity = (size_t) k;\n    if (capacity > ((size_t) -1) / sizeof(KnnNeighbor)) {\n        return knn_reference(n_groups, groups, k, to_evaluate);\n    }\n\n    KnnNeighbor *heap = (KnnNeighbor *) malloc(capacity * sizeof(*heap));\n    if (heap == NULL) {\n        return knn_reference(n_groups, groups, k, to_evaluate);\n    }\n\n    enum { TILE_POINTS = 256 };\n    float distance_tile[TILE_POINTS];\n    size_t used = 0;\n    size_t sequence = 0;\n    float cutoff = 0.0f;\n\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        int begin = 0;\n\n        while (begin < g.length) {\n            int length = g.length - begin;\n            if (length > TILE_POINTS) {\n                length = TILE_POINTS;\n            }\n\n            for (int p = 0; p < length; p++) {\n                distance_tile[p] = euclidean_distance_no_sqrt(\n                    to_evaluate, g.points[begin + p]);\n            }\n\n            int p = 0;\n            if (used < capacity) {\n                while (p < length && used < capacity) {\n                    float d = distance_tile[p];\n\n                    /* Preserve the original insertion behavior for NaNs. */\n                    if (d != d) {\n                        free(heap);\n                        return knn_reference(n_groups, groups, k, to_evaluate);\n                    }\n\n                    KnnNeighbor candidate = {sequence, d, g.label};\n                    heap[used++] = candidate;\n                    sequence++;\n                    p++;\n                }\n\n                if (used == capacity) {\n                    for (size_t parent = used / 2; parent > 0; parent--) {\n                        knn_sift_down(heap, used, parent - 1,\n                                      heap[parent - 1]);\n                    }\n                    cutoff = heap[0].distance;\n                }\n            }\n\n            for (; p < length; p++, sequence++) {\n                float d = distance_tile[p];\n                if (d < cutoff) {\n                    KnnNeighbor candidate = {sequence, d, g.label};\n                    knn_sift_down(heap, used, 0, candidate);\n                    cutoff = heap[0].distance;\n                }\n            }\n\n            begin += length;\n        }\n    }\n\n    size_t frequencies[UCHAR_MAX + 1] = {0};\n    for (size_t i = 0; i < used; i++) {\n        frequencies[(unsigned char) heap[i].label]++;\n    }\n\n    char missing_label = (char) -1;\n    frequencies[(unsigned char) missing_label] += capacity - used;\n    free(heap);\n\n    char most_frequent = missing_label;\n    size_t most_frequent_count = 0;\n\n    /* Match compare_for_sort on both signed-char and unsigned-char targets. */\n    for (int value = CHAR_MIN; value <= CHAR_MAX; value++) {\n        size_t frequency = frequencies[(unsigned char) (char) value];\n        if (frequency > most_frequent_count) {\n            most_frequent = (char) value;\n            most_frequent_count = frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Small sequential distance tiles feeding a contiguous stable max-heap should reduce neighbor-array scans and shifts while exposing distance calculations to vectorization.",

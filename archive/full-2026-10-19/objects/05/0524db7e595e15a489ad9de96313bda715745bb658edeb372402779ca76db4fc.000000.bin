      "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nnamespace {\nconst std::uint32_t MOD = 1000000007u;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic inline uint32x4_t add_mod(uint32x4_t a, uint32x4_t b,\n                               uint32x4_t modulus) {\n    const uint32x4_t sum = vaddq_u32(a, b);\n    return vminq_u32(sum, vsubq_u32(sum, modulus));\n}\n#endif\n\nstatic inline void scan_unblocked(std::uint32_t* values, int length) {\n    int j = 0;\n    std::uint32_t carry = 0;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const uint32x4_t zero = vdupq_n_u32(0);\n    const uint32x4_t modulus = vdupq_n_u32(MOD);\n    uint32x4_t vector_carry = zero;\n\n    for (; j + 4 <= length; j += 4) {\n        uint32x4_t x = vld1q_u32(values + j);\n        x = add_mod(x, vextq_u32(zero, x, 3), modulus);\n        x = add_mod(x, vextq_u32(zero, x, 2), modulus);\n        x = add_mod(x, vector_carry, modulus);\n        vst1q_u32(values + j, x);\n        vector_carry = vdupq_laneq_u32(x, 3);\n    }\n    carry = vgetq_lane_u32(vector_carry, 0);\n#endif\n\n    for (; j < length; ++j) {\n        carry += values[j];\n        if (carry >= MOD) {\n            carry -= MOD;\n        }\n        values[j] = carry;\n    }\n}\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n, m;\n    if (!(std::cin >> n >> m)) {\n        return 0;\n    }\n\n    std::vector<std::vector<int> > blocked_columns(n);\n    for (int c = 0; c < m; ++c) {\n        int row, column;\n        std::cin >> row >> column;\n        blocked_columns[row].push_back(column);\n    }\n\n    std::vector<std::uint32_t> dp(n, 0);\n    dp[0] = 1;\n\n    for (int row = 0; row < n; ++row) {\n        std::vector<int>& columns = blocked_columns[row];\n        std::sort(columns.begin(), columns.end());\n        int first = 0;\n\n        for (std::size_t k = 0; k < columns.size(); ++k) {\n            const int column = columns[k];\n            if (column < first) {\n                continue;\n            }\n            scan_unblocked(dp.data() + first, column - first);\n            dp[column] = 0;\n            first = column + 1;\n        }\n        scan_unblocked(dp.data() + first, n - first);\n    }\n\n    std::cout << dp[n - 1] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

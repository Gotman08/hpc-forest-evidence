        "base_commit": "ff23c4102f30291df6710c68b10d18f4571cacde",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Replacing quadratic per-column ordering and mode searches with linear-contiguous passes plus library sorting will materially reduce runtime while retaining the calculation and output order.",
        "id": "129dbd7cd07a46d9",
        "ordinal": 1,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/est_matriz_seq.c"
          ],
          "retained": [
            "Fuse arithmetic and harmonic mean accumulation into one contiguous per-column traversal without changing either sum's element order.",
            "Use qsort for ordinary numeric columns instead of repeated adjacent swaps, retaining bubble sort for special columns where stability can affect observable floating-point representation.",
            "Replace the quadratic mode comparison loops with a single scan of sorted equal-value runs, retaining strict first-run tie selection."
          ]
        },
        "tree_id": "e1:A",

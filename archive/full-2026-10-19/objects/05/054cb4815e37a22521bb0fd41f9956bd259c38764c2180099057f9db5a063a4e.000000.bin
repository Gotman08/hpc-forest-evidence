        "base_commit": "ff23c4102f30291df6710c68b10d18f4571cacde",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Keeping each column’s statistics together, accumulating its two input-order reductions during ingestion, and completing all sorted-column work while that column is hot will remove several full matrix traversals; library sorting and a linear sorted-run mode scan remove the dominant quadratic work.",
        "id": "2efac13b7c974ed9",
        "ordinal": 2,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/est_matriz_seq.c"
          ],
          "retained": [
            "Replace separate metric arrays with one per-column statistics record.",
            "Fuse arithmetic and harmonic accumulation into matrix ingestion while retaining each column’s input order.",
            "Replace bubble sorting with per-column qsort and replace quadratic mode searching with a sorted-run scan.",
            "Fuse median, mode, variance, standard-deviation, and coefficient calculations per sorted column."
          ]
        },
        "tree_id": "e1:A",
        "trial_id": "01M55BKZ9Y1T8C1K75JYET3Q40",
        "worktree": "/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-5.6-terra-xhigh/results-750909/2021-metrics/worktrees/2efac13b7c974ed9"

      "content": "#include <algorithm>\n#include <cstddef>\n#include <cstring>\n#include <iostream>\n#include <iterator>\n#include <string>\n\nconstexpr std::size_t output_capacity = 64u * 1024u;\n\nstruct OutputBuffer\n{\n    char bytes[output_capacity];\n    std::size_t used;\n\n    OutputBuffer () : used (0) {}\n\n    void flush ()\n    {\n        if (used != 0) {\n            std::cout.write (bytes, static_cast<std::streamsize> (used));\n            used = 0;\n        }\n    }\n\n    void put (char value)\n    {\n        if (used == output_capacity) flush ();\n        bytes[used++] = value;\n    }\n\n    void append (char const *data, std::size_t size)\n    {\n        while (size != 0) {\n            if (used == output_capacity) flush ();\n            const std::size_t count =\n                std::min (size, output_capacity - used);\n            std::memcpy (bytes + used, data, count);\n            used += count;\n            data += count;\n            size -= count;\n        }\n    }\n};\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ' )\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v') ;\n    }\n} ;\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase\n        ( std::remove_if\n            ( text.begin ()\n            , text.end ()\n            , IsWhitespace () )\n        , text.end () ) ;\n    return text ;\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator <char> begin (in), end ;\n    std::string text (begin, end) ;\n    text = remove_whitespaces (text) ;\n    return text ;\n}\n\nbool next_formatted_permutation (char *first, char *last)\n{\n    if (last - first < 4) return false;\n\n    char *suffix = last - 2;\n    while (suffix != first && *(suffix - 2) >= *suffix) {\n        suffix -= 2;\n    }\n    if (suffix == first) return false;\n\n    char *pivot = suffix - 2;\n    char *successor = last - 2;\n    while (*successor <= *pivot) successor -= 2;\n    std::swap (*pivot, *successor);\n\n    char *right = last - 2;\n    while (suffix < right) {\n        std::swap (*suffix, *right);\n        suffix += 2;\n        right -= 2;\n    }\n    return true;\n}\n\nvoid write_permutations (std::string& text)\n{\n    if (text.empty ()) return;\n    std::sort (text.begin (), text.end ());\n    OutputBuffer output;\n\n    if (text.size () > (output_capacity - 4) / 2) {\n        do {\n            output.append (\"[ \", 2);\n            for (std::string::const_iterator it = text.begin ();\n                 it != text.end (); ++it) {\n                output.put (*it);\n                output.put (' ');\n            }\n            output.append (\"]\\n\", 2);\n        } while (std::next_permutation (text.begin (), text.end ()));\n        output.flush ();\n        return;\n    }\n\n    const std::size_t row_size = 2 * text.size () + 4;\n    std::fill_n (output.bytes, row_size, ' ');\n    output.bytes[0] = '[';\n    for (std::size_t i = 0; i != text.size (); ++i) {\n        output.bytes[2 * i + 2] = text[i];\n    }\n    output.bytes[row_size - 2] = ']';\n    output.bytes[row_size - 1] = '\\n';\n    output.used = row_size;\n    char *row = output.bytes;\n\n    for (;;) {\n        if (row_size <= output_capacity - output.used) {\n            char *next = output.bytes + output.used;\n            std::memcpy (next, row, row_size);\n            if (!next_formatted_permutation\n                    (next + 2, next + row_size - 2)) {\n                break;\n            }\n            row = next;\n            output.used += row_size;\n        } else {\n            output.flush ();\n            std::memmove (output.bytes, row, row_size);\n            row = output.bytes;\n            if (!next_formatted_permutation\n                    (row + 2, row + row_size - 2)) {\n                break;\n            }\n            output.used = row_size;\n        }\n    }\n    output.flush ();\n}\n\nint main (int argc, char const *argv [])\n{\n    std::ios::sync_with_stdio (false);\n    std::cin.tie (nullptr);\n    std::string text = read_text_from_stdin <std::string> (std::cin);\n    write_permutations (text);\n    return 0;\n}\n",
      "path": "src/permutations.cc"
    }

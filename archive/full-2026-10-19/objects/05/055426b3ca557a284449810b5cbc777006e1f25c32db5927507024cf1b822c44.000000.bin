        "content": "#include <iostream>\n#include <vector>\n#include <utility>\n\nusing namespace std;\n\ntypedef vector<vector<bool>> adjacency_matrix;\n\nadjacency_matrix readGraph();\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\nint pairMismatch(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                 const vector<int> &equivalence, int i, int j);\nint countMismatches(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                    const vector<int> &equivalence);\nint countAffectedMismatches(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                            const vector<int> &equivalence, int a, int b);\ninline void printPermutation(vector<int> &equivalence);\n\nint main(){\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if(!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\n    if(g1.size() != g2.size()) return false;\n\n    int n = static_cast<int>(g1.size());\n    vector<int> equivalence(n, 0);\n    vector<int> exchange_counter(n, 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    for(int i = 0; i < n; ++i)\n        equivalence[i] = i;\n\n    int mismatch_count = countMismatches(g1, g2, equivalence);\n    if(mismatch_count == 0){\n        printPermutation(equivalence);\n        return true;\n    }\n\n    /*\n     * Permutations are based on Heap's algorithm, which generates all possible\n     * permutations for a given set of elements.\n     */\n    while(exchange_index < n){\n        if(exchange_counter[exchange_index] < exchange_index){\n            int a;\n            int b = exchange_index;\n            if(exchange_index % 2 == 0){\n                a = 0;\n            }else{\n                a = exchange_counter[exchange_index];\n            }\n\n            int affected_before = countAffectedMismatches(g1, g2, equivalence, a, b);\n            swap(equivalence[a], equivalence[b]);\n            int affected_after = countAffectedMismatches(g1, g2, equivalence, a, b);\n            mismatch_count += affected_after - affected_before;\n\n            if(mismatch_count == 0){\n                printPermutation(equivalence);\n                isomorphism_found = true;\n            }\n\n            exchange_counter[exchange_index]++;\n            exchange_index = 1;\n        }else{\n            exchange_counter[exchange_index] = 0;\n            exchange_index++;\n        }\n    }\n    return isomorphism_found;\n}\n\nint pairMismatch(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                 const vector<int> &equivalence, int i, int j){\n    if(i < j) swap(i, j);\n    return g1[i][j] != g2[equivalence[i]][equivalence[j]];\n}\n\nint countMismatches(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                    const vector<int> &equivalence){\n    int count = 0;\n    int n = static_cast<int>(equivalence.size());\n    for(int i = 0; i < n; ++i){\n        for(int j = 0; j <= i; ++j)\n            count += pairMismatch(g1, g2, equivalence, i, j);\n    }\n    return count;\n}\n\nint countAffectedMismatches(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                            const vector<int> &equivalence, int a, int b){\n    int count = pairMismatch(g1, g2, equivalence, a, a)\n              + pairMismatch(g1, g2, equivalence, b, b)\n              + pairMismatch(g1, g2, equivalence, a, b);\n    int n = static_cast<int>(equivalence.size());\n    for(int k = 0; k < n; ++k){\n        if(k != a && k != b){\n            count += pairMismatch(g1, g2, equivalence, a, k);\n            count += pairMismatch(g1, g2, equivalence, b, k);\n        }\n    }\n    return count;\n}\n\nadjacency_matrix readGraph(){\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read(vertices);\n    for (int i = 0; i < vertices; ++i)\n        read[i].resize(vertices);\n\n    cin >> edges;\n    for (int i = 0; i < edges; i++) {\n       cin >> source >> destination;\n       read[destination][source] = read[source][destination] = true;\n    }\n\n    return read;\n}\n\ninline void printPermutation(vector<int> &equivalence){\n    for (auto i : equivalence)\n        cout << i << \" \";\n    cout << endl;\n}\n",

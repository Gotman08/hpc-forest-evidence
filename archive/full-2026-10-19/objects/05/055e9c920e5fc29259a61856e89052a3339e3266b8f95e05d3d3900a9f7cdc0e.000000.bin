"""Neutral fixtures only; no CIM, process handles, worker cache, or stop execution."""

from __future__ import annotations

import copy
import importlib.util
import json
from datetime import UTC, datetime
from pathlib import Path

import pytest

HERE = Path(__file__).resolve().parent
spec = importlib.util.spec_from_file_location(
    "stop_file_gates", HERE / "preparer-arret.py"
)
g = importlib.util.module_from_spec(spec)
spec.loader.exec_module(g)
NOW = datetime(2026, 10, 18, 5, 0, 0, tzinfo=UTC).timestamp()


def row(pid, parent=0, command="foreign.exe", created="2026-10-18T04:00:00.1234567Z"):
    return {
        "ProcessId": pid,
        "ParentProcessId": parent,
        "ExecutablePath": "C:/fixture/python.exe",
        "CommandLine": command,
        "CreationDate": created,
    }


def fixtures():
    owned = [row(p, command="python -m hpc_forest.worker") for p in g.OWNED_ORDER]
    preserved = [row(p, command="transport fixture") for p in g.PRESERVED_ORDER]
    system = {
        "ProcessId": 0,
        "ParentProcessId": 0,
        "ExecutablePath": None,
        "CommandLine": None,
        "CreationDate": None,
    }
    rows = owned + preserved + [system, row(100)]
    census = {
        "captured_at_utc": "2026-10-18T05:00:00.0000000Z",
        "complete_census": True,
        "strict_utf8_decoding": True,
        "rows_count": len(rows),
        "rows": rows,
    }
    return census, copy.deepcopy(census), owned, preserved


def classify(census, baseline, owned, preserved):
    return g.classify(census, baseline, owned, preserved, now=NOW)


def test_exact_nine_and_preserved_five():
    c, b, o, p = fixtures()
    result = classify(c, b, o, p)
    assert result["present_owned"] == list(g.OWNED_ORDER)
    assert result["preserved_observer_transport_present"] == list(g.PRESERVED_ORDER)
    assert not set(result["present_owned"]) & set(g.PRESERVED_ORDER)


def test_natural_absence_is_not_target_substitution():
    c, b, o, p = fixtures()
    c["rows"] = [r for r in c["rows"] if r["ProcessId"] not in {37848, 36356}]
    c["rows_count"] = len(c["rows"])
    result = classify(c, b, o, p)
    assert result["absent_owned"] == [37848]
    assert result["preserved_observer_transport_naturally_absent"] == [36356]


@pytest.mark.parametrize(
    "field,value",
    [
        ("ParentProcessId", 123),
        ("CommandLine", "changed"),
        ("ExecutablePath", "C:/other.exe"),
        ("CreationDate", "2026-10-18T04:00:00.1234568Z"),
    ],
)
def test_owned_reuse_or_any_identity_change_refused(field, value):
    c, b, o, p = fixtures()
    c["rows"][0] = {**c["rows"][0], field: value}
    with pytest.raises(ValueError, match="identity changed"):
        classify(c, b, o, p)


def test_preserved_identity_change_refused():
    c, b, o, p = fixtures()
    c["rows"][9] = {**c["rows"][9], "CreationDate": "2026-10-18T04:00:00.1234568Z"}
    with pytest.raises(ValueError, match="identity changed"):
        classify(c, b, o, p)


@pytest.mark.parametrize(
    "command",
    [
        "python -m hpc_forest.unrecognized_worker",
        'PYTHON "C:/X/BOOTSTRAP_WORKER.PY"',
        'python "C:/x/OBSERVER-MIXTE.PY"',
    ],
)
def test_unknown_native_or_reader_refused(command):
    c, b, o, p = fixtures()
    r = row(777, command=command)
    c["rows"].append(r)
    b["rows"].append(copy.deepcopy(r))
    c["rows_count"] += 1
    b["rows_count"] += 1
    with pytest.raises(ValueError, match="Unknown native"):
        classify(c, b, o, p)


@pytest.mark.parametrize("parent", [37848, 41724])
def test_new_descendant_never_adopted(parent):
    c, b, o, p = fixtures()
    c["rows"].append(row(777, parent=parent))
    c["rows_count"] += 1
    with pytest.raises(ValueError, match="unknown descendant"):
        classify(c, b, o, p)


def newborn(pid, parent=100, **changes):
    return {
        **row(pid, parent=parent, created="2026-10-18T05:00:00.0000000Z"),
        **changes,
    }


def add_rows(census, *rows):
    census["rows"].extend(rows)
    census["rows_count"] = len(census["rows"])


def test_new_foreign_independent_birth_is_recorded_never_targeted():
    c, b, o, p = fixtures()
    add_rows(c, newborn(777))
    result = classify(c, b, o, p)
    assert result["new_independent_foreign_identities"] == [
        {
            "ProcessId": 777,
            "ancestor_pids": [777],
            "anchor_pid": 100,
            "anchor_kind": "unchanged_five_field_foreign_baseline",
            "never_targeted": True,
        }
    ]
    assert result["present_owned"] == list(g.OWNED_ORDER)
    assert "CommandLine" not in json.dumps(result["new_independent_foreign_identities"])


def test_new_foreign_chain_anchors_to_unchanged_baseline():
    c, b, o, p = fixtures()
    add_rows(c, newborn(777), newborn(778, parent=777))
    result = classify(c, b, o, p)
    assert result["new_independent_foreign_identities"][1]["ancestor_pids"] == [
        778,
        777,
    ]
    assert result["new_independent_foreign_identities"][1]["anchor_pid"] == 100


def test_new_foreign_explicit_system_root():
    c, b, o, p = fixtures()
    add_rows(c, newborn(777, parent=0))
    result = classify(c, b, o, p)
    assert (
        result["new_independent_foreign_identities"][0]["anchor_kind"]
        == "explicit_system_root_0_or_4"
    )


def test_new_foreign_orphan_refused():
    c, b, o, p = fixtures()
    add_rows(c, newborn(777, parent=999))
    with pytest.raises(ValueError, match="orphan"):
        classify(c, b, o, p)


def test_new_foreign_missing_baseline_parent_is_not_assumed_same_identity():
    c, b, o, p = fixtures()
    c["rows"] = [r for r in c["rows"] if r["ProcessId"] != 100]
    add_rows(c, newborn(777))
    with pytest.raises(ValueError, match="orphan"):
        classify(c, b, o, p)


def test_new_foreign_cycle_refused():
    c, b, o, p = fixtures()
    add_rows(c, newborn(777, parent=778), newborn(778, parent=777))
    with pytest.raises(ValueError, match="cycle"):
        classify(c, b, o, p)


def test_new_foreign_parent_created_after_child_refused():
    c, b, o, p = fixtures()
    c["captured_at_utc"] = "2026-10-18T05:00:10.0000000Z"
    add_rows(
        c,
        newborn(777, CreationDate="2026-10-18T05:00:05.0000000Z"),
        newborn(778, parent=777, CreationDate="2026-10-18T05:00:04.0000000Z"),
    )
    with pytest.raises(ValueError, match="after child"):
        g.classify(c, b, o, p, now=NOW + 10)


def test_exact_operator_and_new_launcher_have_independent_foreign_chain():
    c, b, o, p = fixtures()
    add_rows(
        c,
        newborn(778),
        newborn(
            777,
            parent=778,
            ExecutablePath="C:/Windows/pwsh.exe",
            CommandLine=str(HERE / "arreter-individuellement.ps1"),
        ),
    )
    result = g.classify(c, b, o, p, operator_pid=777, now=NOW)
    assert result["operator_process_never_targeted"] == 777
    assert [r["ProcessId"] for r in result["new_independent_foreign_identities"]] == [
        778
    ]
    assert 777 not in result["present_owned"]


@pytest.mark.parametrize(
    "created", ["2026-10-18T04:59:59.9999999Z", "2026-10-18T05:00:00.0000001Z"]
)
def test_new_foreign_birth_outside_snapshot_interval_refused(created):
    c, b, o, p = fixtures()
    add_rows(c, newborn(777, CreationDate=created))
    with pytest.raises(ValueError, match="outside"):
        classify(c, b, o, p)


def test_new_foreign_indirect_owned_descendant_refused():
    c, b, o, p = fixtures()
    add_rows(c, newborn(777, parent=37848), newborn(778, parent=777))
    with pytest.raises(ValueError, match="descendant"):

def test_preserved_identity_in_target_partition_refused():
    _c, _b, o, p = fixtures()
    tampered = copy.deepcopy(o)
    tampered[0] = p[0]
    with pytest.raises(ValueError, match="ordered partition"):
        g.partition(tampered, o, g.OWNED_ORDER)


def test_reordered_targets_refused():
    _c, _b, o, _p = fixtures()
    with pytest.raises(ValueError, match="ordered partition"):
        g.partition(list(reversed(o)), o, g.OWNED_ORDER)


def test_seventh_tick_preserved():
    assert g.stamp("2026-10-18T04:00:00.1234567Z") != g.stamp(
        "2026-10-18T04:00:00.1234568Z"
    )
    assert g.stamp("2026-10-18T04:00:00.123456Z") == "2026-10-18T04:00:00.1234560Z"


def final_fixtures(monkeypatch):
    monkeypatch.setattr(g, "RECEIPT_SHA", "f" * 64)
    refs = {
        k: {"path": str(HERE / ("NEUTRAL-" + k + ".json")), "sha256": h}
        for k, h in {
            "baseline": g.BASELINE_SHA,
            "reconciliation": g.RECON_SHA,
            "late_remote_readback": g.LATE_SHA,
            "independent_audit": g.AUDIT_SHA,
            "normalization": "1" * 64,
        }.items()
    }
    final = {
        "schema": "hpc-forest-source-only-final-reception-v1",
        "verified": True,
        "job_id": "751592",
        "session_id": g.SESSION,
        "scope_id": g.SCOPE,
        "model": "gpt-6.1-sol",
        "effort": "max",
        "source_zip_sha256": g.SOURCE,
        **refs,
    }
    for k in (
        "coverage_and_final_confirmations_verified",
        "read_only_file_verification_before_and_after",
        "deliveries_reconciled",
        "all_started_calls_reconciled",
        "scientific_reception_verified",
        "independent_audit_verified",
        "owned_stop_requires_separate_review_and_fresh_identity",
    ):
        final[k] = True
    rec = {
        "verified": True,
        "all_started_calls_reconciled": True,
        "unknown_invocations": 0,
        "unresolved": [],
        "requests_with_unknown_consumption": 10,
        "exact_consumption_tokens_total": None,
        "native_invocations_observed": 121,
        "known_exact_tokens": 2676472,
    }
    audit = {
        "schema": "hpc-forest-source-only-independent-cold-audit-v1",
        "verified": True,
        "job_id": "751592",
        "session_id": g.SESSION,
        "scope_id": g.SCOPE,
        "model": "gpt-6.1-sol",
        "effort": "max",
        "source_zip_sha256": g.SOURCE,
        "subject_count": 15,
        "subjects": [{"verified": True} for _ in range(15)],
        "all15_final_confirmations_verified": True,
        "reconciliation": refs["reconciliation"],
    }
    data = {
        g.BASELINE_SHA: {"verified": True, "before_after_inventory_identical": True},
        g.RECON_SHA: rec,
        g.LATE_SHA: {
            "verified": True,
            "all_124_deliveries_readback_supported": True,
            "unknown_consumption_remains_unknown": True,
        },
        g.AUDIT_SHA: audit,
        "1" * 64: {"neutral": True},
        "f" * 64: final,
    }
    monkeypatch.setattr(g, "load", lambda r: data[r["sha256"]])
    return (
        {"path": str(g.RX / "reception-verifiee.json"), "sha256": "f" * 64},
        final,
        rec,
        audit,
    )


def test_neutral_final_gate_keeps_ten_unknowns_null(monkeypatch):
    r, _f, _rec, _a = final_fixtures(monkeypatch)
    assert g.final_proof(r)[1]["exact_consumption_tokens_total"] is None


@pytest.mark.parametrize(
    "field", ["verified", "scientific_reception_verified", "independent_audit_verified"]
)
def test_false_final_flag_refused_before_cache(monkeypatch, field):
    r, f, _rec, _a = final_fixtures(monkeypatch)
    f[field] = False
    monkeypatch.setattr(
        g, "verify_cache", lambda _: pytest.fail("must never read cache")
    )
    with pytest.raises(ValueError):
        g.prepare(r, {}, {})


def test_unknown_consumption_cannot_be_zeroed(monkeypatch):
    r, _f, rec, _a = final_fixtures(monkeypatch)
    rec["exact_consumption_tokens_total"] = 2676472
    with pytest.raises(ValueError, match="unknowns"):
        g.final_proof(r)


def test_fifteen_confirmations_required(monkeypatch):
    r, _f, _rec, a = final_fixtures(monkeypatch)
    a["all15_final_confirmations_verified"] = False
    with pytest.raises(ValueError, match="fifteen-subject"):
        g.final_proof(r)


def test_audit_pin_cannot_be_substituted(monkeypatch):
    r, f, _rec, _a = final_fixtures(monkeypatch)
    f["independent_audit"]["sha256"] = "2" * 64
    with pytest.raises(ValueError, match="immutable"):
        g.final_proof(r)


def test_changed_reference_refused(tmp_path):
    p = tmp_path / "inert.json"
    p.write_text(json.dumps({"neutral": True}), encoding="utf8")
    r = g.ref(p)
    p.write_text("{}", encoding="utf8")
    with pytest.raises(ValueError, match="reference"):
        g.load(r)


def test_no_process_or_native_import_in_python_helper():
    import ast

    tree = ast.parse((HERE / "preparer-arret.py").read_text(encoding="utf8"))
    imports = [
        n.module if isinstance(n, ast.ImportFrom) else a.name
        for n in ast.walk(tree)
        if isinstance(n, (ast.Import, ast.ImportFrom))
        for a in (n.names if isinstance(n, ast.Import) else [None])
    ]
    assert not any(
        x in {"subprocess", "socket", "ctypes", "psutil"} or x.startswith("hpc_forest")
        for x in imports
    )


def test_ps_only_individual_stop_and_exclusive_intent():
    text = (HERE / "arreter-individuellement.ps1").read_text(encoding="utf8")
    assert "Stop-Process -InputObject $ownedProcess -Force" in text
    assert "[System.IO.FileMode]::CreateNew" in text and "$stream.Flush($true)" in text
    assert text.index("Write-NewJson $preflight $intentPath") < text.index(
        "Stop-Process -InputObject"
    )
    assert (
        "Exact-Partition $plan.owned_targets_in_stop_order $trusted.owned_targets_in_stop_order"
        in text
    )
    assert (
        "Exact-Partition $plan.preserved_observer_transport_identities $trusted.preserved_observer_transport_identities"
        in text
    )
    assert (
        "taskkill" not in text.casefold()
        and "Stop-Process -Id" not in text
        and "Stop-Process -Name" not in text
    )


def test_existing_cli_exec_is_not_accepted_as_baseline_foreign():
    c, b, o, p = fixtures()
    process = row(
        777,
        command='"C:/copied/codex.exe" exec --fixture-only',
        created="2026-10-18T04:00:00.1234567Z",
    )
    add_rows(c, process)
    add_rows(b, copy.deepcopy(process))
    with pytest.raises(ValueError, match="Active native CLI generation"):
        classify(c, b, o, p)

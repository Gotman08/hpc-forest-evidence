    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#define _GNU_SOURCE\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <math.h>\\n\\n#define N_ITER 10 // number of simulation iterations\\n#define DT 0.01f // time step\\n#define SOFTENING 1e-9f // to avoid zero divisors\\n\\nint main(int argc, char **argv) {\\n    int nbodies;\\n    if (fread(&nbodies, sizeof(nbodies), 1, stdin) != 1) {\\n        fprintf(stderr, \\\"\\\\nError reading nbodie value\\\\n\\\");\\n        exit(EXIT_FAILURE);\\n    }\\n    size_t count = (size_t)nbodies * 6;\\n    float *tmp = (float *)malloc(count * sizeof(float));\\n    if (!tmp) { perror(\\\"malloc\\\"); exit(EXIT_FAILURE); }\\n    if (fread(tmp, count * sizeof(float), 1, stdin) != 1) {\\n        fprintf(stderr, \\\"\\\\nError reading input values\\\\n\\\");\\n        exit(EXIT_FAILURE);\\n    }\\n\\n    // SoA arrays with double buffering for positions.\\n    float *x[2], *y[2], *z[2];\\n    float *vx = (float *)malloc((size_t)nbodies * sizeof(float));\\n    float *vy = (float *)malloc((size_t)nbodies * sizeof(float));\\n    float *vz = (float *)malloc((size_t)nbodies * sizeof(float));\\n    if (!vx || !vy || !vz) { perror(\\\"malloc\\\"); exit(EXIT_FAILURE); }\\n\\n    for (int b = 0; b < 2; ++b) {\\n        if (posix_memalign((void **)&x[b], 64, (size_t)nbodies * sizeof(float)) ||\\n            posix_memalign((void **)&y[b], 64, (size_t)nbodies * sizeof(float)) ||\\n            posix_memalign((void **)&z[b], 64, (size_t)nbodies * sizeof(float))) {\\n            perror(\\\"posix_memalign\\\");\\n            exit(EXIT_FAILURE);\\n        }\\n    }\\n\\n    for (int i = 0; i < nbodies; ++i) {\\n        x[0][i] = tmp[6*i];\\n        y[0][i] = tmp[6*i+1];\\n        z[0][i] = tmp[6*i+2];\\n        vx[i] = tmp[6*i+3];\\n        vy[i] = tmp[6*i+4];\\n        vz[i] = tmp[6*i+5];\\n    }\\n\\n    // Single parallel region spanning all iterations.\\n    #pragma omp parallel\\n    {\\n        for (int iter = 0; iter < N_ITER; ++iter) {\\n            int cur = iter & 1;\\n            int nxt = cur ^ 1;\\n\\n            #pragma omp for schedule(static)\\n            for (int i = 0; i < nbodies; ++i) {\\n                float xi = x[cur][i];\\n                float yi = y[cur][i];\\n                float zi = z[cur][i];\\n                float fx = 0.0f, fy = 0.0f, fz = 0.0f;\\n\\n                // Unroll inner loop by 4 preserving exact accumulation order.\\n                int j = 0;\\n                for (; j + 3 < nbodies; j += 4) {\\n                    float dx0 = x[cur][j]   - xi;\\n                    float dy0 = y[cur][j]   - yi;\\n                    float dz0 = z[cur][j]   - zi;\\n                    float sqrd0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\\n                    float inv0 = 1 / sqrt(sqrd0);\\n                    float inv3_0 = inv0 * inv0 * inv0;\\n                    fx += dx0 * inv3_0;\\n                    fy += dy0 * inv3_0;\\n                    fz += dz0 * inv3_0;\\n\\n                    float dx1 = x[cur][j+1] - xi;\\n                    float dy1 = y[cur][j+1] - yi;\\n                    float dz1 = z[cur][j+1] - zi;\\n                    float sqrd1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\\n                    float inv1 = 1 / sqrt(sqrd1);\\n                    float inv3_1 = inv1 * inv1 * inv1;\\n                    fx += dx1 * inv3_1;\\n                    fy += dy1 * inv3_1;\\n                    fz += dz1 * inv3_1;\\n\\n                    float dx2 = x[cur][j+2] - xi;\\n                    float dy2 = y[cur][j+2] - yi;\\n                    float dz2 = z[cur][j+2] - zi;\\n                    float sqrd2 = dx2*dx2 + dy2*dy2 + dz2*dz2 + SOFTENING;\\n                    float inv2 = 1 / sqrt(sqrd2);\\n                    float inv3_2 = inv2 * inv2 * inv2;\\n                    fx += dx2 * inv3_2;\\n                    fy += dy2 * inv3_2;\\n                    fz += dz2 * inv3_2;\\n\\n                    float dx3 = x[cur][j+3] - xi;\\n                    float dy3 = y[cur][j+3] - yi;\\n                    float dz3 = z[cur][j+3] - zi;\\n                    float sqrd3 = dx3*dx3 + dy3*dy3 + dz3*dz3 + SOFTENING;\\n                    float inv3_3 = 1 / sqrt(sqrd3);\\n                    float inv3_3b = inv3_3 * inv3_3 * inv3_3;\\n                    fx += dx3 * inv3_3b;\\n                    fy += dy3 * inv3_3b;\\n                    fz += dz3 * inv3_3b;\\n                }\\n                for (; j < nbodies; ++j) {\\n                    float dx = x[cur][j] - xi;\\n                    float dy = y[cur][j] - yi;\\n                    float dz = z[cur][j] - zi;\\n                    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n                    float inv_dist = 1 / sqrt(sqrd_dist);\\n                    float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n                    fx += dx * inv_dist3;\\n                    fy += dy * inv_dist3;\\n                    fz += dz * inv_dist3;\\n                }\\n\\n                vx[i] += DT*fx;\\n                vy[i] += DT*fy;\\n                vz[i] += DT*fz;\\n\\n                x[nxt][i] = xi + vx[i]*DT;\\n                y[nxt][i] = yi + vy[i]*DT;\\n                z[nxt][i] = zi + vz[i]*DT;\\n            }\\n        }\\n    }\\n\\n    // Write final positions from buffer N_ITER%2.\\n    int outbuf = N_ITER & 1;\\n    for (int i = 0; i < nbodies; ++i) {\\n        tmp[6*i]   = x[outbuf][i];\\n        tmp[6*i+1] = y[outbuf][i];\\n        tmp[6*i+2] = z[outbuf][i];\\n        tmp[6*i+3] = vx[i];\\n        tmp[6*i+4] = vy[i];\\n        tmp[6*i+5] = vz[i];\\n    }\\n    if (fwrite(tmp, count * sizeof(float), 1, stdout) != 1) {\\n        fprintf(stderr, \\\"\\\\nError writing to output\\\\n\\\");\\n        exit(EXIT_FAILURE);\\n    }\\n\\n    free(vx); free(vy); free(vz);\\n    for (int b = 0; b < 2; ++b) { free(x[b]); free(y[b]); free(z[b]); }\\n    free(tmp);\\n    return EXIT_SUCCESS;\\n}\\n\",\n      \"path\": \"src/nbody.c\"\n    }\n  ],\n  \"hypothesis\": \"Combining SoA layout, manual 4x unrolling preserving exact summation order, and a single OpenMP parallel region with fused force/integration via double-buffering will reduce thread-creation overhead, improve cache locality, enable vectorization, and eliminate separate position-update barriers, outperforming any individual transformation.\",\n  \"notes\": \"The implementation preserves the exact per-body accumulation order (j ascending) to match reference output bit-for-bit. Aligned allocations (64-byte) are used for SIMD friendliness. The single parallel region spans all iterations; double-buffered positions avoid races and fuse force computation with position integration.\",\n  \"sources_kept\": [\n    \"704fffe5d2a849b5\",\n    \"82ca35f9753444de\",\n    \"9adc054f311d4298\"\n  ],\n  \"transformations\": [\n    \"Convert Body array-of-structs to separate float arrays (SoA) for positions and velocities, with double buffering for positions\",\n    \"Manual unrolling of the inner j-loop by factor 4 with sequential accumulation in original order\",\n    \"Inline body_force into main and use a single OpenMP parallel region spanning all iterations; force computation and position integration fused via ping-pong buffers\"\n  ]\n}",

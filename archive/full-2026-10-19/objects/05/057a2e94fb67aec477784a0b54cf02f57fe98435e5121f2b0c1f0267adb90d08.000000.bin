      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <algorithm>\n\nint main() {\n\tint n, s;\n\tstd::cin >> n >> s;\n\tassert(s > 0 && s < n && n < 8000);\n\n\t// Flatten matrix into a contiguous 1D array for spatial locality\n\tstd::vector<int> mat(n * n);\n\tfor (int i = 0; i < n; ++i)\n\t\tfor (int j = 0; j < n; ++j)\n\t\t\tscanf(\"%d\", &mat[i * n + j]);\n\n\t// Build integral image using two passes for sequential memory access.\n\tstd::vector<long long> H(n * (n + 1), 0);\n\tfor (int i = 0; i < n; ++i) {\n\t\tlong long row_sum = 0;\n\t\tint base = i * (n + 1);\n\t\tH[base] = 0;\n\t\tfor (int j = 0; j < n; ++j) {\n\t\t\trow_sum += mat[i * n + j];\n\t\t\tH[base + j + 1] = row_sum;\n\t\t}\n\t}\n\n\tstd::vector<long long> II((n + 1) * (n + 1), 0);\n\tfor (int i = 1; i <= n; ++i) {\n\t\tconst long long* prev_row = &II[(i - 1) * (n + 1)];\n\t\tlong long* curr_row = &II[i * (n + 1)];\n\t\tconst long long* hrow = &H[(i - 1) * (n + 1)];\n\t\tcurr_row[0] = 0;\n\t\tfor (int j = 1; j <= n; ++j)\n\t\t\tcurr_row[j] = prev_row[j] + hrow[j];\n\t}\n\n\t// Search for maximum SxS submatrix sum using integral image.\n\t// Apply two-dimensional tiling to improve temporal reuse of II data.\n\tconst int B = 64;\n\tlong long mxSum = -2147483648LL;\n\tfor (int i0 = 0; i0 <= n - s; i0 += B) {\n\t\tint imax = std::min(i0 + B, n - s + 1);\n\t\tfor (int j0 = 0; j0 <= n - s; j0 += B) {\n\t\t\tint jmax = std::min(j0 + B, n - s + 1);\n\t\t\tfor (int i = i0; i < imax; ++i) {\n\t\t\t\tconst long long* row_i   = &II[i * (n + 1)];\n\t\t\t\tconst long long* row_is  = &II[(i + s) * (n + 1)];\n\t\t\t\tfor (int j = j0; j < jmax; ++j) {\n\t\t\t\t\tlong long sub_sum = row_is[j + s] - row_i[j + s] - row_is[j] + row_i[j];\n\t\t\t\t\tif (sub_sum > mxSum)\n\t\t\t\t\t\tmxSum = sub_sum;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\tprintf(\"%d\\n\", static_cast<int>(mxSum));\n\treturn 0;\n}",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Two-dimensional tiling of the search loop over top-left corners improves temporal locality by reusing integral image rows across neighboring submatrix computations. Processing a block of consecutive rows and columns together keeps the accessed portion of II in cache, reducing memory traffic compared to row-only blocking.",
  "notes": "",

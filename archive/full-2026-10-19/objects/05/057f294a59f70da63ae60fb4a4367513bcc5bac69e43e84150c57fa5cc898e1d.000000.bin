import hashlib, json, shutil, subprocess, time
from pathlib import Path
base=Path("C:/Users/nicol/Documents/Codex/2026-10-15/cr")
here=base/"outputs/HPC-Forest-Etude-2020-2024-r1/reprises/incident-double-liaison-20261017T2012"
source=Path("C:/Users/nicol/AppData/Local/OpenAI/Codex/bin/896a0166b774037a")
dest=here/"cli-0.163.0-alpha.10.2"
assert not dest.exists(), "Existing CLI copy must be reconciled"
pin=base/"outputs/HPC-Forest-Harnais-Comparaison-r1/cli-figee.json"
def sha(p):
    return hashlib.sha256(p.read_bytes()).hexdigest()
assert sha(pin)=="9808e32b0fc05802b181c1552708be64f79e8f3e9110ace1ed3d29b603bcfa11"
assert sha(source/"codex.exe")=="f6dbf48cb70f62649c645f26c87dc9bf84cc36986202dfad8e12fb5b8ca70312"
files=[p for p in source.rglob("*") if p.is_file()]
assert all(not p.is_symlink() and p.resolve().is_relative_to(source.resolve()) for p in source.rglob("*"))
size=sum(p.stat().st_size for p in files)
assert len(files)<200 and size<2_000_000_000
assert shutil.disk_usage(here).free>size*2+500_000_000
items=[]
for p in files:
    relative=p.relative_to(source)
    target=dest/relative
    target.parent.mkdir(parents=True,exist_ok=True)
    h=sha(p)
    shutil.copy2(p,target)
    assert sha(target)==h==sha(p)
    items.append({"path":str(relative),"bytes":p.stat().st_size,"sha256":h})
results={}
for name,args in [("version",["--version"]),("login-status",["login","status"])]:
    result=subprocess.run([str(dest/"codex.exe"),*args],capture_output=True,text=True,timeout=30,
        creationflags=subprocess.CREATE_NO_WINDOW)
    output=result.stdout+result.stderr
    (here/("cli-copie-"+name+".txt")).open("x",encoding="utf8").write(output)
    assert result.returncode==0,(name,result.returncode)
    if name=="version":
        assert "codex-cli 0.163.0-alpha.10.2" in output
    else:
        assert "Logged in using ChatGPT" in output
    results[name]={"argv":[str(dest/"codex.exe"),*args],"exit_code":result.returncode,
                   "output_file":"cli-copie-"+name+".txt"}
receipt={"schema":"hpc-forest-process-cli-migration-receipt-v1","observed_at":time.time(),
    "human_authorization":{"question":"Search exact old CLI, otherwise qualify current installed CLI before resume",
        "answer":"chercher le et trouve le et si tu trouve pas demerde toi",
        "interpretation":"User explicitly directs autonomous search and fallback; no further confirmation required",
        "not_injected_into_model_context":True},
    "status":"AUTHORIZED_FALLBACK_WITH_STATIC_COMPATIBILITY_AND_RUNTIME_CHECKS",
    "old_pin_preserved":True,"old_pin_file":str(pin),"old_pin_sha256":sha(pin),
    "old_cli_expected_sha256":"e98c516f1c8935789aabe9122ee7e05ec4c3efd1ba6acf179242e031c495b99e",
    "old_exact_copy_found_in_checked_locations":False,
    "checked_locations":["workspace work and outputs",".codex",".cache","AppData/Local/OpenAI",
                         ".vscode/extensions","AppData/Roaming/npm","former WindowsApps package"],
    "other_cli_candidates":[
        {"path":"C:/Users/nicol/.codex/.sandbox-bin/codex.exe","sha256":"97d4d67419d0ac2f71342f9a5e850f9468aa622618de8ea823223edb9a91926a"},
        {"path":"C:/Users/nicol/.vscode/extensions/.5ad37d53-ce6d-401d-9720-625c5e155bb6/bin/windows-x86_64/codex.exe","sha256":"7c8531062aa5b8252fd205852f7015412aad646abf4be9c5cd5823efe4836c71"},
        {"path":"C:/Users/nicol/.vscode/extensions/openai.chatgpt-26.908.40401-win32-x64/bin/windows-x86_64/codex.exe","sha256":"2271526227b06ca13ab2b975b88546460fc61b2a29225b6dda0fdc803024ccc9"}],
    "new_executable":{"path":str(dest/"codex.exe"),"sha256":sha(dest/"codex.exe"),"version":"codex-cli 0.163.0-alpha.10.2"},
    "binary_source_directory":str(source),"files":items,"copied_bytes":size,
    "local_non_inference_checks":results,"static_review":"qualification-cli-statique.json",
    "source_worker_unchanged":True,"model_and_effort_unchanged":True,"global_path_or_config_changed":False,
    "credential_transfer":False,"model_calls_for_qualification":0,
    "limitations":["Help is syntax evidence, not proof of semantic equality or scientific comparability",
        "SO cohort must record old/new CLI provenance per invocation",
        "JSONL/tools/usage and realization checked on normal requested work; no diagnostic inference",
        "R1 completed entirely before migration; no R1 relay restarted","R5/Flash/genuine Codex admission unchanged"]}
(here/"migration-cli-autorisee.json").open("x",encoding="utf8").write(json.dumps(receipt,indent=2,ensure_ascii=False)+"\n")
print(json.dumps({"copied_files":len(items),"copied_bytes":size,"sha256":receipt["new_executable"]["sha256"],"non_inference_checks":list(results),"model_calls":0,"old_pin_unchanged":True}))

            "delegation_parent": "R/C",
            "integration_sources": [],
            "hypothesis_as_declared_by_model": "A persistent OpenMP team processing 128-by-128 tiles in anti-diagonal waves can accelerate larger grids on four cores while keeping synchronization coarse and DP storage linear.",
            "transformations_as_declared_by_model": {
              "files": [
                "src/solution.cpp"
              ],
              "retained": [
                "Schedule independent tiles statically within one persistent OpenMP region, with an implicit barrier between anti-diagonals.",
                "Store tile boundaries in two length-n arrays instead of copying complete DP rows.",
                "Use a single-row sequential path for n below 1024, single-thread execution, or builds without OpenMP.",
                "Replace remainder operations with one conditional subtraction, since both recurrence operands are reduced modulo MOD."

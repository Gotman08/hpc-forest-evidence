            "integration_sources": [],
            "hypothesis_as_declared_by_model": "Exact four-lane NEON prefix scans over obstacle-free row intervals should shorten the DP dependency chain while eliminating per-cell obstacle checks and row copies.",
            "transformations_as_declared_by_model": {
              "files": [
                "src/solution.cpp"
              ],
              "retained": [
                "Store sorted, deduplicated obstacle columns per row to identify independent scan intervals.",
                "Replace two-row DP and copying with an in-place modular prefix scan.",
                "Use ARM NEON shift-and-add prefix scans with exact unsigned modular reduction and scalar tails."
              ]
            },
            "status": "valid",

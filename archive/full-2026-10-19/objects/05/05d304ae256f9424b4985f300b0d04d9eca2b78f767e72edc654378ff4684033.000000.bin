      "sha256": "a07d231e5bec01b6402503b391afb0a164c833420ce4bc67f5957aabb8ffb3ec",
      "numbered_excerpt": "209: async def main_async(args):\n210:     with FileLock(args.output / \"worker.lock\"):\n211:         async with RomeoFiles(args.codex_config) as transfer:\n212:             worker = Worker(transfer, args.channel, args.session_id, args.output,\n213:                             args.dependency_receipt, set(args.required_jobs), args.transport_smoke,\n214:                             args.executable)\n215:             await worker.hello()\n216:             end = time.monotonic() + args.max_seconds\n217:             while time.monotonic() < end:\n218:                 for name in sorted(await transfer.requests(args.channel)):\n219:                     done = await worker.handle(name)\n220:                     if done and args.once:\n221:                         return 0\n222:                 await asyncio.sleep(args.poll_seconds)\n223:     return 0"
    },
    "HPC-Forest/src/hpc_forest/core.py": {
      "sha256": "8a9938afb8c051992726619923af5c26e36230d6a0ab1a0a169dd109bb498f93",
      "numbered_excerpt": "53: class FileLock:\n54:     \"\"\"OS-owned lock, released after a crash; never remove a lock held by another process.\"\"\"\n55: \n56:     def __init__(self, path: Path):\n57:         self.path = path\n58:         self.stream = None\n59: \n60:     def __enter__(self):\n61:         self.path.parent.mkdir(parents=True, exist_ok=True)\n62:         self.stream = self.path.open(\"a+b\")\n63:         try:\n64:             if os.fstat(self.stream.fileno()).st_size == 0:\n65:                 self.stream.write(b\"0\")\n66:                 self.stream.flush()\n67:             self.stream.seek(0)\n68:             if os.name == \"nt\":\n69:                 import msvcrt\n70: \n71:                 msvcrt.locking(self.stream.fileno(), msvcrt.LK_NBLCK, 1)\n72:             else:\n73:                 import fcntl\n74: \n75:                 fcntl.flock(self.stream.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)\n76:         except OSError as exc:\n77:             self.stream.close()\n78:             self.stream = None\n79:             raise InfrastructureError(f\"Resource already locked: {self.path}\") from exc\n80:         return self\n81: \n82:     def __exit__(self, *_):\n83:         if self.stream:\n84:             if os.name == \"nt\":\n85:                 import msvcrt\n86: \n87:                 self.stream.seek(0)\n88:                 msvcrt.locking(self.stream.fileno(), msvcrt.LK_UNLCK, 1)\n89:             else:\n90:                 import fcntl\n91: \n92:                 fcntl.flock(self.stream.fileno(), fcntl.LOCK_UN)\n93:             self.stream.close()"
    },
    "HPC-Forest/src/hpc_forest/r2max_worker.py": {
      "sha256": "ac8f53affba932bc863061dd30acd56be3742bd9077d543b5b6488fffe52e086",
      "numbered_excerpt": "102:             raise InfrastructureError(\"Unrelated or smoke request forbidden in R2 native search\")\n103:         return legacy_run(request, request_sha, output, receipt, jobs, executable)\n104:     worker.run_codex = generate\n105:     worker.Worker = R2Worker\n106:     return worker.main()"
    }

"""Concrete passive policy only, bound to received Q and fresh local process identities."""
import hashlib,importlib.util,json,time
from pathlib import Path
BASE=Path(r"C:\Users\nicol\Documents\Codex\2026-10-15\cr")
HERE=Path(__file__).resolve().parent
OBS=HERE.parent/"observateur-mixte-r4b-r1"
Q=BASE/"outputs/HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r2/qualification-allouee-wrapper-r3/reception-752235"
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
read=lambda p:json.loads(Path(p).read_text(encoding="utf-8-sig"))
ref=lambda p:{"path":str(Path(p).resolve()),"sha256":sha(p)}
def save(p,v):
 with Path(p).open("x",encoding="utf-8",newline="\n") as stream: stream.write(json.dumps(v,ensure_ascii=False,indent=2)+"\n")
assert sha(OBS/"observer-mixte.py")=="bf050ae23e356166c547df13a0f4cec33b3d9ffaa7e46ebc5596f8773d2cef4f"
assert sha(OBS/"LIVRAISON-PREPARATION-OBSERVATEUR-MIXTE.json")=="bc9f995c85c0fddadbbd73130bb1f3405f32ab10db937cccabc2f56ebd6ccea6"
assert sha(Q/"reception-verifiee.json")=="f4bedcea70613be9dc2164164e46f0cccf07f3ec799b97bed6a19dc2ebb8cf96"
assert sha(Q/"LIVRAISON-RECEPTION-MECANIQUE-752235.json")=="e9f3cce0a13ea1f05c1eec2a97cb353340a05b9602f4343c7b82035a2d186c6f"
for name in ("politique-reelle.json","routes-reelles.json"):
 assert not (HERE/name).exists(),"Do not overwrite or replay an existing concrete admission"
spec=importlib.util.spec_from_file_location("parent_reviewed_passive",OBS/"observer-mixte.py")
m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
policy=read(OBS/"politique.pending.json");routes=read(OBS/"routes.initiales.json")
rows=m.census()
old=read(HERE.parent/"observateur-source-only-transition/reprise-effective-verifiee-parent.json")
so=read(Path(policy["source_only_admission"]["path"]))
def concrete_pair(expected):
 result=[]
 for e in expected:
  found=[r for r in rows if m.same_identity(e,r)]
  assert len(found)==1,"Full five-field identity changed or absent"
  result.append(found[0])
 return result
policy["source_only_full_identities"]=concrete_pair(so["relay_identities"])
policy["previous_reader_identities"]=concrete_pair(old["actual_observer_pair"])
policy["qualification_reception"]=ref(Q/"reception-verifiee.json")
policy["verified"]=True
policy["pending"]=[]
policy["admission_scope"]="Read-only passive observation of exactly source-only and the pinned Luna phases; no generation admission"
policy["parent_observer_review"]={"code_sha256":sha(OBS/"observer-mixte.py"),"neutral_tests":27,"reviewed_areas":["five-field identities and seven-digit UTC times","exact pinned bootstrap argv/hash","frozen source/plan and actual Q/audit bindings","cap4 and unknown-session refusal","monotone route stages and no closed-job repoll","status/accounting RPC allowlist only","separate lock/state and old-reader release before allocation"],"production_native_admission":False}
_,hist,jobs,sessions,_,_=m.guard(policy,routes,{},rows)
assert set(sessions)=={m.SO_SESSION} and jobs=={m.SO_JOB} and all(r["stage"]=="absent" for r in routes["routes"])
assert m.transition_state(policy,routes,rows,None) is False
save(HERE/"cim-politique-reelle.json",{"schema":"hpc-forest-fresh-full-census-v1","observed_at":time.time(),"complete_census":True,"rows":rows})
save(HERE/"politique-reelle.json",policy);save(HERE/"routes-reelles.json",routes)
proof={"schema":"hpc-forest-parent-passive-policy-construction-v1","verified":True,"observed_at":time.time(),"policy":ref(HERE/"politique-reelle.json"),"routes":ref(HERE/"routes-reelles.json"),"full_census":ref(HERE/"cim-politique-reelle.json"),"source_only_full_identities":policy["source_only_full_identities"],"old_reader_full_identities":policy["previous_reader_identities"],"actual_native_sessions":[m.SO_SESSION],"generation_admitted":False,"observer_started":False,"any_process_stopped":False,"remote_calls":0}
save(HERE/"politique-reelle-construction-verifiee.json",proof)
print(json.dumps({"verified":True,"policy":proof["policy"],"routes":proof["routes"],"native_workers":len(sessions),"observer_started":False,"generation_admitted":False}))


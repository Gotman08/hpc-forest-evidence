  "files": [
    {
      "content": "/*\n    This program solves Laplace's equation on a regular 2D grid using simple Jacobi iteration.\n\n    The stencil calculation stops when  ( err >= CONV_THRESHOLD OR  iter > ITER_MAX )\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <time.h>\n#include <sys/time.h>\n\n#define CONV_THRESHOLD 1.0e-5f // threshold of convergence\n\n// matrices to be solved\ndouble *grid;\ndouble *new_grid;\n\n// size of each side of the grid\nint size;\nint iter_max_num;\n\n// return the absolute value of a number\ndouble absolute(double num){\n    if(num < 0)\n        return -1.0 * num;\n    return num;\n}\n\n\n// allocate memory for the grids\nvoid allocate_memory(){\n    size_t elements = (size_t) size * (size_t) size;\n\n    grid = (double *) malloc(elements * sizeof(*grid));\n    new_grid = (double *) malloc(elements * sizeof(*new_grid));\n}\n\n// initialize the grids\nvoid initialize_grid(){\n    int center = size / 2;\n    int linf = center - (size / 10);\n    int lsup = center + (size / 10);\n\n    for (int i = 0; i < size; i++){\n        double *grid_row = grid + (size_t) i * (size_t) size;\n        double *new_grid_row = new_grid + (size_t) i * (size_t) size;\n\n        for (int j = 0; j < size; j++){\n            double initial_value;\n\n            // inicializa região de calor no centro do grid\n            if ( i >= linf && i <= lsup && j >= linf && j <= lsup)\n                initial_value = 100;\n            else\n                initial_value = 0;\n\n            grid_row[j] = initial_value;\n            new_grid_row[j] = initial_value;\n        }\n    }\n}\n\n// save the grid in a file\nvoid save_grid(){\n\n    for(int i = 0; i < size; i++){\n        const double *grid_row = grid + (size_t) i * (size_t) size;\n\n        for(int j = 0; j < size; j++){\n            fprintf(stdout, \"%lf \", grid_row[j]);\n        }\n        fprintf(stdout, \"\\n\");\n    }\n}\n\nint main(int argc, char *argv[]){\n\n    fscanf(stdin, \"%d\", &size);\n    fscanf(stdin, \"%d\", &iter_max_num);\n    \n    int hasError = 1;\n    int iter = 0;\n\n    struct timeval time_start;\n    struct timeval time_end;\n\n    // allocate memory to the grid (matrix)\n    allocate_memory();\n\n    // set grid initial conditions\n    initialize_grid();\n\n    //printf(\"Jacobi relaxation calculation: %d x %d grid\\n\", size, size);\n\n    // get the start time\n    //gettimeofday(&time_start, NULL);\n\n    // Jacobi iteration\n    // This loop will end if either the maximum change reaches below a set threshold (convergence)\n    // or a fixed number of maximum iterations have completed\n    while ( hasError && iter < iter_max_num ) {\n        const double *restrict current = grid;\n        double *restrict next = new_grid;\n\n        hasError = 0;\n        // calculates the Laplace equation to determine each cell's next value\n        for( int i = 1; i < size-1; i++) {\n            const double *current_row = current + (size_t) i * (size_t) size;\n            const double *upper_row = current_row - (size_t) size;\n            const double *lower_row = current_row + (size_t) size;\n            double *next_row = next + (size_t) i * (size_t) size;\n\n#if defined(__GNUC__)\n#pragma GCC ivdep\n#endif\n            for(int j = 1; j < size-1; j++) {\n                next_row[j] = 0.25 * (current_row[j+1] + current_row[j-1] +\n                                      upper_row[j] + lower_row[j]);\n            }\n\n            for(int j = 1; j < size-1; j++) {\n                double errorCurrent = absolute(next_row[j] - current_row[j]);\n                if(errorCurrent > CONV_THRESHOLD ){\n                    hasError = 1;\n                }\n            }\n        }\n\n        // The two complete fields have identical fixed boundaries, so swapping\n        // retains the Jacobi result without an interior copy sweep.\n        double *temporary = grid;\n        grid = new_grid;\n        new_grid = temporary;\n        iter++;\n    }\n\n    // get the end time\n    //gettimeofday(&time_end, NULL);\n\n    //double exec_time = (double) (time_end.tv_sec - time_start.tv_sec) +\n    //                   (double) (time_end.tv_usec - time_start.tv_usec) / 1000000.0;\n\n    //save the final grid in file\n    save_grid();\n\n    //printf(\"\\nKernel executed in %lf seconds with %d iterations.\\n\", exec_time, iter);\n\n    return 0;\n}\n",
      "path": "src/laplace_seq.c"
    }
  ],
  "hypothesis": "Contiguous double buffering plus a no-alias pure stencil loop enables legal SIMD vectorization and removes the per-iteration interior copy while preserving Jacobi state.",
  "notes": "Both buffers are initialized from the complete initial field, so pointer swaps retain fixed boundaries and also match degenerate grids with no interior cells.",
  "sources_kept": [],
  "transformations": [
    "Replace per-row allocations with two contiguous field buffers.",
    "Split the independent stencil write from convergence inspection and mark the stencil loop as dependency-free for GCC vectorization.",
    "Swap fully initialized buffers after each iteration instead of copying interior values."
  ]
}

      "content": "{\"role\": \"G\", \"goal\": \"integration of diverse archived transformations; evaluate the full program\", \"experiment\": \"8ea7efd00ff54935-h01\", \"ordinal\": 2, \"integration_source_ids\": [\"fa0655c581fd428e\", \"ec392de2a8f94b60\", \"012a1e1a044a4223\", \"2a37f060b5304bf5\", \"e0c27eafe5614996\", \"98da71b7f3554f73\", \"a21989ac1df048b3\"], \"current_source_paths\": [\"src/est_matriz_seq.c\"], \"context_as_data\": {\"sources\": [{\"id\": \"fa0655c581fd428e\", \"role\": \"G\", \"commit\": \"8e908ed85dad37a75f60f74daa44781d5d1f92cf\", \"transformations\": {\"files\": [\"src/est_matriz_seq.c\"], \"retained\": [\"Replace allocated pairwise mode counting for sorted non-NaN columns with a linear equal-value run scan; retain pairwise comparisons when a column contains NaNs and preserve float mode/count semantics.\", \"Accumulate arithmetic and harmonic sums in input order as each matrix value is read, then normalize once per column instead of traversing the matrix separately for those means.\", \"Retain restrict-qualified pointers and GCC ivdep hints on the independent median, standard-deviation, and coefficient-of-variation loops.\"]}, \"mean_seconds\": 0.007839775954683622, \"diff\": \"diff --git a/src/est_matriz_seq.c b/src/est_matriz_seq.c\\nindex 6593ca3..7135516 100644\\n--- a/src/est_matriz_seq.c\\n+++ b/src/est_matriz_seq.c\\n@@ -26,33 +26,10 @@ void ordena_colunas(double *matriz,int lin, int col) {\\n     }\\n } \\n \\n-void calcula_media(double *matriz, double *vet,int lin, int col){\\n-    int i,j;\\n-    double soma;\\n-    for(i=0;i<col;i++){\\n-        soma=0;\\n-        for(j=0;j<lin;j++){\\n-            soma+=matriz[i*lin+j];\\n-        }\\n-        vet[i]=soma/lin; \\n-    }   \\n-}\\n-\\n-void calcula_media_harmonica(double *matriz, double *vet,int lin, int col){\\n-    int i,j;\\n-    double soma;\\n-    for(i=0;i<col;i++){\\n-        soma=0;\\n-        for(j=0;j<lin;j++){\\n-            soma+=(1/(matriz[i*lin+j]));\\n-        }\\n-        vet[i]=lin/soma; \\n-    }   \\n-}\\n-\\n-void calcula_mediana(double *matriz, double *vet, int lin, int col) {  \\n+void calcula_mediana(const double * restrict matriz, double * restrict vet, int lin, int col) {  \\n      int i=0;\\n      if((lin-1)%2){ //Quantidade par de elementos\\n+#pragma GCC ivdep\\n          for (i = 0; i < col; i++) {\\n             vet[i]=(matriz[(((i*lin)+(i+1)*lin)-1)/2]+matriz[((((i*lin)+(i+1)*lin)-1)/2)+1]);\\n             vet[i]*=0.5;\\n@@ -60,6 +37,7 @@ void calcula_mediana(double *matriz, double *vet, int lin, int col) {\\n          }\\n      }\\n      else{ //Quantidade ímpar de elementos\\n+#pragma GCC ivdep\\n          for (i = 0; i < col; i++) {\\n             vet[i]=matriz[(((i*lin)+(i+1)*lin)-1)/2];\\n          }\\n@@ -69,33 +47,59 @@ void calcula_mediana(double *matriz, double *vet, int lin, int col) {\\n \\n //Adaptado de https://www.clubedohardware.com.br/forums/topic/1291570-programa-em-c-que-calcula-moda-media-e-mediana/\\n double moda_aux(double *matriz,int lin){\\n-    int i, j; \\n-    double *cont;\\n-    cont=(double*)malloc(lin*sizeof(double));\\n-\\tfloat conta=0, moda=0;\\n-\\t\\n-\\tfor(i=0;i<lin;i++){\\n-        for(j=i+1;j<lin;j++){\\n-        \\t\\n-\\t\\t\\tif(matriz[i]==matriz[j]){\\n-\\t\\t\\t\\tcont[i]++;\\n-\\t\\t\\t\\t\\tif(cont[i]>conta){\\n-\\t\\t\\t\\t\\t\\tconta=cont[i];\\n-\\t\\t\\t\\t\\t\\tmoda=matriz[i];\\n-\\t\\t\\t\\t\\t}\\n-\\t\\t\\t}\\n+    int i;\\n+    float conta=0, moda=0;\\n+\\n+    if (lin < 2) {\\n+        return -1;\\n+    }\\n+\\n+    /* NaNs may not be grouped by the preceding bubble sort. Use the pairwise\\n+       comparison behavior for those columns. */\\n+    for (i=0;i<lin;i++) {\\n+        if (isnan(matriz[i])) {\\n+            int j;\\n+            for (i=0;i<lin;i++) {\\n+                double cont=0;\\n+                for (j=i+1;j<lin;j++) {\\n+                    if (matriz[i]==matriz[j]) {\\n+                        cont++;\\n+                        if (cont>conta) {\\n+                            conta=cont;\\n+                            moda=(float)matriz[i];\\n+                        }\\n+                    }\\n+                }\\n+            }\\n+            if (conta == 0) {\\n+                return -1;\\n+            }\\n+            return moda;\\n+        }\\n+    }\\n \\n+    /* Finite equal values are contiguous after sorting, so scan their runs. */\\n+    {\\n+        int run_length=1;\\n+        double run_value=matriz[0];\\n+        for (i=1;i<lin;i++) {\\n+            if (matriz[i]==matriz[i-1]) {\\n+                run_length++;\\n+                if ((double)(run_length-1)>conta) {\\n+                    conta=(float)(run_length-1);\\n+                    moda=(float)run_value;\\n+                }\\n+            } else {\\n+                run_length=1;\\n+                run_value=matriz[i];\\n+            }\\n         }\\n-        cont[i]=0;\\n     }\\n-    free(cont);\\n-    if(conta == 0){\\n-    \\treturn -1;\\n-\\t}\\n-\\telse{\\n-\\t\\treturn moda;\\n-\\t}\\n \\n+    if (conta == 0) {\\n+        return -1;\\n+    }\\n+    return moda;\\n }\\n \\n void calcula_moda(double *matriz,double *moda,int lin, int col){\\n@@ -117,15 +121,17 @@ void calcula_variancia(double *matriz, double *media,double *variancia, int lin,\\n     } \\n }\\n \\n-void calcula_desvio_padrao(double *variancia,double *dp, int col){\\n+void calcula_desvio_padrao(const double * restrict variancia, double * restrict dp, int col){\\n     int i;\\n+#pragma GCC ivdep\\n     for(i=0;i<col;i++){\\n         dp[i]=sqrt(variancia[i]);\\n     }  \\n }\\n \\n-void calcula_coeficiente_variacao(double *media,double *dp,double *cv, int col){\\n+void calcula_coeficiente_variacao(const double * restrict media, const double * restrict dp, double * restrict cv, int col){\\n     int i;\\n+#pragma GCC ivdep\\n     for(i=0;i<col;i++){\\n         cv[i]=dp[i]/media[i];\\n     }  \\n@@ -148,15 +154,24 @@ int main(int argc,char **argv){\\n     cv=(double *)malloc(col * sizeof(double)); // Aloca o vetor de coeficiente de variação\\n     dp=(double *)malloc(col * sizeof(double)); // Aloca o vetor de desvio padrão\\n \\n+    for(i=0;i<col;i++){\\n+        media[i]=0;\\n+        media_har[i]=0;\\n+    }\\n  \\n     for(i=0;i<lin;i++){\\n         for(j=0;j<col;j++){\\n             fscanf(stdin, \\\"%lf \\\",&(matriz[j*lin+i])); // Lê os dados transpostos em uma matriz de entrada\\n+            media[j]+=matriz[j*lin+i];\\n+            media_har[j]+=(1/(matriz[j*lin+i]));\\n         }\\n     }\\n \\n-    calcula_media(matriz,media,lin,col);\\n-    calcula_media_harmonica(matriz,media_har,lin,col);\\n+    for(i=0;i<col;i++){\\n+        media[i]=media[i]/lin;\\n+        media_har[i]=lin/media_har[i];\\n+    }\\n+\\n     ordena_colunas(matriz,lin,col);\\n     calcula_mediana(matriz,mediana,lin,col);\\n     calcula_moda(matriz,moda,lin,col);\\n@@ -195,4 +210,4 @@ int main(int argc,char **argv){\\n     free(variancia);\\n     free(dp);\\n     free(cv);\\n-}\\n+}\\n\\\\ No newline at end of file\"}, {\"id\": \"ec392de2a8f94b60\", \"role\": \"B\", \"commit\": \"8118d271a6e12602e9d9d8ff0aec2df412374a81\", \"transformations\": {\"files\": [\"src/est_matriz_seq.c\"], \"retained\": [\"Replace mode's allocated counter array and nested pairwise comparisons with a linear scan of sorted value runs.\", \"Retain the pairwise mode path for columns containing NaNs, and preserve the existing float mode/count semantics.\"]}, \"mean_seconds\": 0.00831730260203282, \"diff\": \"diff --git a/src/est_matriz_seq.c b/src/est_matriz_seq.c\\nindex 6593ca3..42ac255 100644\\n--- a/src/est_matriz_seq.c\\n+++ b/src/est_matriz_seq.c\\n@@ -50,9 +50,10 @@ void calcula_media_harmonica(double *matriz, double *vet,int lin, int col){\\n     }   \\n }\\n \\n-void calcula_mediana(double *matriz, double *vet, int lin, int col) {  \\n+void calcula_mediana(const double * restrict matriz, double * restrict vet, int lin, int col) {  \\n      int i=0;\\n      if((lin-1)%2){ //Quantidade par de elementos\\n+#pragma GCC ivdep\\n          for (i = 0; i < col; i++) {\\n             vet[i]=(matriz[(((i*lin)+(i+1)*lin)-1)/2]+matriz[((((i*lin)+(i+1)*lin)-1)/2)+1]);\\n             vet[i]*=0.5;\\n@@ -60,6 +61,7 @@ void calcula_mediana(double *matriz, double *vet, int lin, int col) {\\n          }\\n      }\\n      else{ //Quantidade ímpar de elementos\\n+#pragma GCC ivdep\\n          for (i = 0; i < col; i++) {\\n             vet[i]=matriz[(((i*lin)+(i+1)*lin)-1)/2];\\n          }\\n@@ -69,33 +71,60 @@ void calcula_mediana(double *matriz, double *vet, int lin, int col) {\\n \\n //Adaptado de https://www.clubedohardware.com.br/forums/topic/1291570-programa-em-c-que-calcula-moda-media-e-mediana/\\n double moda_aux(double *matriz,int lin){\\n-    int i, j; \\n-    double *cont;\\n-    cont=(double*)malloc(lin*sizeof(double));\\n-\\tfloat conta=0, moda=0;\\n-\\t\\n-\\tfor(i=0;i<lin;i++){\\n-        for(j=i+1;j<lin;j++){\\n-        \\t\\n-\\t\\t\\tif(matriz[i]==matriz[j]){\\n-\\t\\t\\t\\tcont[i]++;\\n-\\t\\t\\t\\t\\tif(cont[i]>conta){\\n-\\t\\t\\t\\t\\t\\tconta=cont[i];\\n-\\t\\t\\t\\t\\t\\tmoda=matriz[i];\\n-\\t\\t\\t\\t\\t}\\n-\\t\\t\\t}\\n+    int i;\\n+    float conta=0, moda=0;\\n+\\n+    if (lin < 2) {\\n+        return -1;\\n+    }\\n \\n+    /* NaNs can prevent the preceding bubble sort from grouping equal values.\\n+       Keep the pairwise reference behavior for those columns. */\\n+    for (i=0;i<lin;i++) {\\n+        if (isnan(matriz[i])) {\\n+            int j;\\n+            for (i=0;i<lin;i++) {\\n+                double cont=0;\\n+                for (j=i+1;j<lin;j++) {\\n+                    if (matriz[i]==matriz[j]) {\\n+                        cont++;\\n+                        if (cont>conta) {\\n+                            conta=cont;\\n+                            moda=(float)matriz[i];\\n+                        }\\n+                    }\\n+                }\\n+            }\\n+            if (conta == 0) {\\n+                return -1;\\n+            }\\n+            return moda;\\n         }\\n-        cont[i]=0;\\n     }\\n-    free(cont);\\n-    if(conta == 0){\\n-    \\treturn -1;\\n-\\t}\\n-\\telse{\\n-\\t\\treturn moda;\\n-\\t}\\n \\n+    /* Columns are sorted before this routine is called, so equal finite\\n+       values form runs and their mode can be found with one linear scan. */\\n+    {\\n+        int run_length=1;\\n+        double run_value=matriz[0];\\n+        for (i=1;i<lin;i++) {\\n+            if (matriz[i]==matriz[i-1]) {\\n+                run_length++;\\n+                if ((double)(run_length-1)>conta) {\\n+                    conta=(float)(run_length-1);\\n+                    moda=(float)run_value;\\n+                }\\n+            } else {\\n+                run_length=1;\\n+                run_value=matriz[i];\\n+            }\\n+        }\\n+    }\\n+\\n+    if (conta == 0) {\\n+        return -1;\\n+    }\\n+    return moda;\\n }\\n \\n void calcula_moda(double *matriz,double *moda,int lin, int col){\\n@@ -117,15 +146,17 @@ void calcula_variancia(double *matriz, double *media,double *variancia, int lin,\\n     } \\n }\\n \\n-void calcula_desvio_padrao(double *variancia,double *dp, int col){\\n+void calcula_desvio_padrao(const double * restrict variancia, double * restrict dp, int col){\\n     int i;\\n+#pragma GCC ivdep\\n     for(i=0;i<col;i++){\\n         dp[i]=sqrt(variancia[i]);\\n     }  \\n }\\n \\n-void calcula_coeficiente_variacao(double *media,double *dp,double *cv, int col){\\n+void calcula_coeficiente_variacao(const double * restrict media, const double * restrict dp, double * restrict cv, int col){\\n     int i;\\n+#pragma GCC ivdep\\n     for(i=0;i<col;i++){\\n         cv[i]=dp[i]/media[i];\\n     }\"}, {\"id\": \"012a1e1a044a4223\", \"role\": \"A\", \"commit\": \"a88d242f4933e9e3a693f6e51d8332590a324457\", \"transformations\": {\"files\": [\"src/est_matriz_seq.c\"], \"retained\": [\"Accumulate arithmetic and harmonic sums as each value is read, then normalize once per column, eliminating separate matrix traversals.\", \"Replace the mode routine's allocated count array with an initialized local counter while retaining its comparison and tie behavior.\"]}, \"mean_seconds\": 0.008978728204965591, \"diff\": \"diff --git a/src/est_matriz_seq.c b/src/est_matriz_seq.c\\nindex 6593ca3..7a22b13 100644\\n--- a/src/est_matriz_seq.c\\n+++ b/src/est_matriz_seq.c\\n@@ -26,30 +26,6 @@ void ordena_colunas(double *matriz,int lin, int col) {\\n     }\\n } \\n \\n-void calcula_media(double *matriz, double *vet,int lin, int col){\\n-    int i,j;\\n-    double soma;\\n-    for(i=0;i<col;i++){\\n-        soma=0;\\n-        for(j=0;j<lin;j++){\\n-            soma+=matriz[i*lin+j];\\n-        }\\n-        vet[i]=soma/lin; \\n-    }   \\n-}\\n-\\n-void calcula_media_harmonica(double *matriz, double *vet,int lin, int col){\\n-    int i,j;\\n-    double soma;\\n-    for(i=0;i<col;i++){\\n-        soma=0;\\n-        for(j=0;j<lin;j++){\\n-            soma+=(1/(matriz[i*lin+j]));\\n-        }\\n-        vet[i]=lin/soma; \\n-    }   \\n-}\\n-\\n void calcula_mediana(double *matriz, double *vet, int lin, int col) {  \\n      int i=0;\\n      if((lin-1)%2){ //Quantidade par de elementos\\n@@ -70,32 +46,27 @@ void calcula_mediana(double *matriz, double *vet, int lin, int col) {\\n //Adaptado de https://www.clubedohardware.com.br/forums/topic/1291570-programa-em-c-que-calcula-moda-media-e-mediana/\\n double moda_aux(double *matriz,int lin){\\n     int i, j; \\n-    double *cont;\\n-    cont=(double*)malloc(lin*sizeof(double));\\n-\\tfloat conta=0, moda=0;\\n-\\t\\n-\\tfor(i=0;i<lin;i++){\\n+    double cont;\\n+    float conta=0, moda=0;\\n+    \\n+    for(i=0;i<lin;i++){\\n+        cont=0;\\n         for(j=i+1;j<lin;j++){\\n-        \\t\\n-\\t\\t\\tif(matriz[i]==matriz[j]){\\n-\\t\\t\\t\\tcont[i]++;\\n-\\t\\t\\t\\t\\tif(cont[i]>conta){\\n-\\t\\t\\t\\t\\t\\tconta=cont[i];\\n-\\t\\t\\t\\t\\t\\tmoda=matriz[i];\\n-\\t\\t\\t
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"/*\\n * This code was based on Sokoban C available at\\n * http://www.rosettacode.org/wiki/Sokoban#C\\n * licenced under GNU Free Documentation License 1.2\\n */\\n\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <unistd.h>\\n#include <stdint.h>\\n#include <assert.h>\\n#include <stdbool.h>\\n\\nint w, h, n_boxes;\\nuint8_t * board, * goals, * live;\\n\\ntypedef uint16_t cidx_t;\\ntypedef uint32_t hash_t;\\n\\ntypedef struct {\\n    int up, down, left, right;\\n} neighbors_t;\\n\\nneighbors_t * neighbors;\\n\\n/* board configuration is represented by an array of cell indices\\n   of player and boxes */\\ntypedef struct state_t state_t;\\n\\nstruct state_t { // variable length\\n    hash_t h;\\n    state_t * prev, * next, * qnext;\\n    cidx_t c[];\\n};\\n\\nsize_t state_size, block_size = 32;\\nstate_t * block_root, * block_head;\\n\\ninline\\nstate_t * newstate(state_t * parent) {\\n    inline state_t * next_of(state_t * s) {\\n        return (void * )((uint8_t * ) s + state_size);\\n    }\\n\\n    state_t * ptr;\\n    if (!block_head) {\\n        block_size *= 2;\\n        state_t * p = malloc(block_size * state_size);\\n        assert(p);\\n        p -> next = block_root;\\n        block_root = p;\\n        ptr = (void * )((uint8_t * ) p + state_size * block_size);\\n        p = block_head = next_of(p);\\n        state_t * q;\\n        for (q = next_of(p); q < ptr; p = q, q = next_of(q))\\n            p -> next = q;\\n        p -> next = NULL;\\n    }\\n\\n    ptr = block_head;\\n    block_head = block_head -> next;\\n\\n    ptr -> prev = parent;\\n    ptr -> h = 0;\\n    return ptr;\\n}\\n\\ninline\\nvoid unnewstate(state_t * p) {\\n    p -> next = block_head;\\n    block_head = p;\\n}\\n\\nenum {\\n    space,\\n    wall,\\n    player,\\n    box\\n};\\n\\n// mark up positions where a box definitely should not be\\nvoid mark_live(const int c) {\\n    const int y = c / w,\\n        x = c % w;\\n    if (live[c]) return;\\n\\n    live[c] = 1;\\n    if (y > 1 && board[c - w] != wall && board[c - w * 2] != wall)\\n        mark_live(c - w);\\n    if (y < h - 2 && board[c + w] != wall && board[c + w * 2] != wall)\\n        mark_live(c + w);\\n    if (x > 1 && board[c - 1] != wall && board[c - 2] != wall)\\n        mark_live(c - 1);\\n    if (x < w - 2 && board[c + 1] != wall && board[c + 2] != wall)\\n        mark_live(c + 1);\\n}\\n\\nstate_t * parse_board(const char * s) {\\n    board = calloc(w * h, sizeof(uint8_t));\\n    assert(board);\\n    goals = calloc(w * h, sizeof(uint8_t));\\n    assert(goals);\\n    live = calloc(w * h, sizeof(uint8_t));\\n    assert(live);\\n    neighbors = malloc((size_t)w * h * sizeof(*neighbors));\\n    assert(neighbors);\\n\\n    for (int i = 0; i < w * h; i++) {\\n        const int y = i / w;\\n        const int x = i % w;\\n        neighbors[i].up = y > 0 ? i - w : -1;\\n        neighbors[i].down = y + 1 < h ? i + w : -1;\\n        neighbors[i].left = x > 0 ? i - 1 : -1;\\n        neighbors[i].right = x + 1 < w ? i + 1 : -1;\\n    }\\n\\n    n_boxes = 0;\\n    for (int i = 0; s[i]; i++) {\\n        switch (s[i]) {\\n        case '#':\\n            board[i] = wall;\\n            continue;\\n\\n        case '.': // fallthrough\\n        case '+':\\n            goals[i] = 1; // fallthrough\\n        case '@':\\n            continue;\\n\\n        case '*':\\n            goals[i] = 1; // fallthrough\\n        case '$':\\n            n_boxes++;\\n            continue;\\n        default:\\n            continue;\\n        }\\n    }\\n\\n    const int is = sizeof(int);\\n    state_size = (sizeof(state_t) + (1 + n_boxes) * sizeof(cidx_t) + is - 1) /\\n        is * is;\\n\\n    state_t * state = newstate(NULL);\\n\\n    for (int i = 0, j = 0; i < w * h; i++) {\\n        if (goals[i]) mark_live(i);\\n        if (s[i] == '$' || s[i] == '*')\\n            state -> c[++j] = i;\\n        else if (s[i] == '@' || s[i] == '+')\\n            state -> c[0] = i;\\n    }\\n\\n    return state;\\n}\\n\\n// K&R hash function\\ninline\\nvoid hash(state_t * s) {\\n    if (!s -> h) {\\n        register hash_t ha = 0;\\n        cidx_t * p = s -> c;\\n        for (int i = 0; i <= n_boxes; i++)\\n            ha = p[i] + 31 * ha;\\n        s -> h = ha;\\n    }\\n}\\n\\nstate_t ** buckets;\\nhash_t hash_size, fill_limit, filled;\\n\\n/* Grow the contiguous bucket array and reinsert its occupied entries. */\\nvoid extend_table() {\\n    const hash_t old_size = hash_size;\\n    state_t ** old_buckets = buckets;\\n\\n    if (!old_size) {\\n        hash_size = 1024;\\n        filled = 0;\\n    } else {\\n        hash_size *= 2;\\n    }\\n    fill_limit = hash_size * 3 / 4;\\n\\n    buckets = calloc(hash_size, sizeof(state_t *));\\n    assert(buckets);\\n\\n    const hash_t bits = hash_size - 1;\\n    for (hash_t i = 0; i < old_size; i++) {\\n        state_t * entry = old_buckets[i];\\n        if (!entry) continue;\\n\\n        hash_t j = entry -> h & bits;\\n        while (buckets[j])\\n            j = (j + 1) & bits;\\n        buckets[j] = entry;\\n    }\\n\\n    free(old_buckets);\\n}\\n\\nstate_t * lookup(state_t * s) {\\n    hash(s);\\n    hash_t i = s -> h & (hash_size - 1);\\n    while (buckets[i]) {\\n        state_t * f = buckets[i];\\n        if (f -> h == s -> h &&\\n            !memcmp(s -> c, f -> c, sizeof(cidx_t) * (1 + n_boxes)))\\n            return f;\\n        i = (i + 1) & (hash_size - 1);\\n    }\\n\\n    return NULL;\\n}\\n\\nbool add_to_table(state_t * s) {\\n    if (lookup(s)) {\\n        unnewstate(s);\\n        return false;\\n    }\\n\\n    if (filled++ >= fill_limit)\\n        extend_table();\\n\\n    hash_t i = s -> h & (hash_size - 1);\\n    while (buckets[i])\\n        i = (i + 1) & (hash_size - 1);\\n    buckets[i] = s;\\n    return true;\\n}\\n\\nbool success(const state_t * s) {\\n    for (int i = 1; i <= n_boxes; i++)\\n        if (!goals[s -> c[i]]) return false;\\n    return true;\\n}\\n\\nstatic inline int adjacent(const int cell, const int dy, const int dx) {\\n    const neighbors_t * n = &neighbors[cell];\\n    if (dy < 0) return n -> up;\\n    if (dy > 0) return n -> down;\\n    if (dx < 0) return n -> left;\\n    return n -> right;\\n}\\n\\nstatic inline int box_index(const state_t * s, const int cell) {\\n    for (int i = 1; i <= n_boxes; i++) {\\n        if (s -> c[i] == cell)\\n            return i;\\n        if (s -> c[i] > cell)\\n            break;\\n    }\\n    return 0;\\n}\\n\\nstate_t * move_me(state_t * s,\\n    const int dy,\\n        const int dx) {\\n    const int c1 = adjacent(s -> c[0], dy, dx);\\n    if (c1 < 0 || board[c1] == wall)\\n        return NULL;\\n\\n    const int at_box = box_index(s, c1);\\n\\n    int c2 = -1;\\n    if (at_box) {\\n        c2 = adjacent(c1, dy, dx);\\n        if (c2 < 0 || board[c2] == wall || !live[c2])\\n            return NULL;\\n        if (box_index(s, c2)) return NULL;\\n    }\\n\\n    state_t * n = newstate(s);\\n    memcpy(n -> c + 1, s -> c + 1, sizeof(cidx_t) * n_boxes);\\n\\n    cidx_t * p = n -> c;\\n    p[0] = c1;\\n\\n    if (at_box) {\\n        const cidx_t moved = c2;\\n        int j = at_box;\\n        if (moved < p[j]) {\\n            while (j > 1 && moved < p[j - 1]) {\\n                p[j] = p[j - 1];\\n                j--;\\n            }\\n        } else {\\n            while (j < n_boxes && moved > p[j + 1]) {\\n                p[j] = p[j + 1];\\n                j++;\\n            }\\n        }\\n        p[j] = moved;\\n    }\\n\\n    return n;\\n}\\n\\nstate_t * next_level, * done;\\n\\nbool queue_move(state_t * s) {\\n    if (!s || !add_to_table(s))\\n        return false;\\n\\n    if (success(s)) {\\n        done = s;\\n        return true;\\n    }\\n\\n    s -> qnext = next_level;\\n    next_level = s;\\n    return false;\\n}\\n\\nbool do_move(state_t * s) {\\n    return queue_move(move_me(s, 0, 1)) ||\\n        queue_move(move_me(s, 0, -1)) ||\\n        queue_move(move_me(s, -1, 0)) ||\\n        queue_move(move_me(s, 1, 0));\\n}\\n\\nvoid show_moves(const state_t * s, int nextPos) {\\n    if (s -> prev)\\n        show_moves(s -> prev, s -> c[0]);\\n    if (nextPos == -1) {\\n        printf(\\\"\\\\n\\\");\\n        return;\\n    }\\n    int cx = s -> c[0] % w;\\n    int cy = s -> c[0] / w;\\n    int nx = nextPos % w;\\n    int ny = nextPos / w;\\n    int box = 0;\\n    for (int i = 1; !box && i <= n_boxes; i++)\\n        box = s -> c[i] == nextPos;\\n    if (cx < nx) printf(box ? \\\"R\\\" : \\\"r\\\");\\n    else if (cx > nx) printf(box ? \\\"L\\\" : \\\"l\\\");\\n    else if (cy < ny) printf(box ? \\\"D\\\" : \\\"d\\\");\\n    else if (cy > ny) printf(box ? \\\"U\\\" : \\\"u\\\");\\n    else if (1) {\\n        printf(\\\"Invalid move\\\\n\\\");\\n        exit(1);\\n    }\\n}\\n\\nint main() {\\n    size_t sz = 1024;\\n    char * boardStr = malloc(sz * sizeof(char));\\n    char * pos = boardStr;\\n    w = -1;\\n    h = 0;\\n    while (1) {\\n        int read = getline( & pos, & sz, stdin);\\n        if (read == -1) break;\\n        if (read >= w) w = read;\\n        sz -= read;\\n        pos += read;\\n        h++;\\n    }\\n    state_t * s = parse_board(boardStr);\\n    free(boardStr);\\n\\n    extend_table();\\n    queue_move(s);\\n    while (!done) {\\n        state_t * head = next_level;\\n        for (next_level = NULL; head && !done; head = head -> qnext)\\n            do_move(head);\\n\\n        if (!next_level) {\\n            puts(\\\"no solution?\\\");\\n            return 1;\\n        }\\n    }\\n\\n    show_moves(done, -1);\\n\\n    free(buckets);\\n    free(board);\\n    free(goals);\\n    free(live);\\n    free(neighbors);\\n\\n    while (block_root) {\\n        void * tmp = block_root -> next;\\n        free(block_root);\\n        block_root = tmp;\\n    }\\n    return 0;\\n}\\n\",\"path\":\"src/sokoban.c\"}],\"hypothesis\":\"For states with a modest number of boxes, an early-exit linear occupancy scan may cost less than binary-search setup while preserving sorted-box invariants; retaining the existing neighbor table, insertion maintenance, and open-addressed state table lets the controller evaluate this full-program tradeoff across valid inputs.\",\"notes\":\"This is a bounded occupancy-lookup experiment only. The scan is correct for every box count because box positions remain sorted; no benchmark-specific sizes or paths are assumed.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[\"bfcb4c69d20a4116\",\"ed6069da17b6484d\",\"42a9a0e6163e4b0c\"],\"transformations\":[\"Replace binary search for box occupancy with a sorted-array linear scan that exits on equality or once positions exceed the target cell.\",\"Retain precomputed bounded neighbors and push-only sorted-box insertion.\",\"Retain cached-hash checks and the open-addressed state table.\" ]}"}}

  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system. Positions are held in dense component arrays because\n * they are the only body fields read by the quadratic loop.\n */\nstatic void body_force(const float *restrict x, const float *restrict y,\n                       const float *restrict z, Body *restrict bodies,\n                       float dt, int n) {\n#pragma omp parallel for schedule(static)\n  for (int i = 0; i < n; ++i) {\n    const float xi = x[i];\n    const float yi = y[i];\n    const float zi = z[i];\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; ++j) {\n      float dx = x[j] - xi;\n      float dy = y[j] - yi;\n      float dz = z[j] - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    bodies[i].vx += dt*fx;\n    bodies[i].vy += dt*fy;\n    bodies[i].vz += dt*fz;\n  }\n}\n\nstatic void integrate(float *restrict x, float *restrict y,\n                      float *restrict z, const Body *restrict bodies,\n                      int n) {\n#pragma omp parallel for schedule(static)\n  for (int i = 0; i < n; ++i) {\n    x[i] += bodies[i].vx * DT;\n    y[i] += bodies[i].vy * DT;\n    z[i] += bodies[i].vz * DT;\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n  Body *bodies = read_dataset(&nbodies);\n  float *x = (float *)malloc((size_t)nbodies * sizeof(*x));\n  float *y = (float *)malloc((size_t)nbodies * sizeof(*y));\n  float *z = (float *)malloc((size_t)nbodies * sizeof(*z));\n\n  if (nbodies > 0 && (!x || !y || !z)) {\n    free(z);\n    free(y);\n    free(x);\n    free(bodies);\n    fprintf(stderr,\"\\nError allocating position values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  for (int i = 0; i < nbodies; ++i) {\n    x[i] = bodies[i].x;\n    y[i] = bodies[i].y;\n    z[i] = bodies[i].z;\n  }\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    body_force(x, y, z, bodies, DT, nbodies);\n    integrate(x, y, z, bodies, nbodies);\n  }\n\n  for (int i = 0; i < nbodies; ++i) {\n    bodies[i].x = x[i];\n    bodies[i].y = y[i];\n    bodies[i].z = z[i];\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(z);\n  free(y);\n  free(x);\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Splitting the force kernel's read-only positions into dense component arrays improves cache locality, while static outer-body worksharing uses the independent per-body force calculations without changing each body's j-order accumulation.",
  "notes": "The force arithmetic and per-body inner-loop order are retained; positions are packed back into the original binary Body layout before output.",
  "sources_kept": [],
  "transformations": [
    "Use persistent dense x, y, and z position arrays for the quadratic force scan while retaining the original Body layout for binary input, velocities, and output.",

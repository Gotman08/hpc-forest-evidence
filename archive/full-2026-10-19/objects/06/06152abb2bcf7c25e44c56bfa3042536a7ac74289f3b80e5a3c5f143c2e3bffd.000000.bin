"""Prepare a cold, five-JSON target-profile reader; never execute its audit main."""
from pathlib import Path
import hashlib, json

ops = Path('outputs/HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r3/qualification-cible-source110-r1/operations-parent-reelles-01').resolve()
here = ops / 'lecture-froide-r1'
here.mkdir(exist_ok=False)
prep = ops.parents[1]
paths = {'announcement': ops/'annonce-cible-reelle.json', 'transfers': ops/'transferts-archive-et-preuves-3SHA.json',
    'terminal': ops/'statut-terminal-753888.json', 'efficiency': ops/'efficacite-terminale-753888.json',
    'submission': ops/'soumission-observee-reelle.json', 'intent': ops/'intention-soumission-unique.json',
    'scheduler_log': ops/'journal-annonce-753888.json',
    'archive': ops/'reception/target-profile-results-753888.tar.gz',
    'qualification': ops/'reception/target-qualification.json',
    'output_inventory': ops/'reception/profile-proof-inventory.json',
    'runtime_manifest': prep/'revision-source-cli-r1/runtime-manifest-lane-r3.json',
    'official113_local_manifest': prep/'operations-parent-premier-roots-source110-r1/INVENTAIRE-PARTAGE-OFFICIEL-113.json'}
for name in ['q753709-qualification.json', 'q753709-bootstrap-allocation.json', 'q753709-bindings.json']:
    paths[name] = ops.parent/name
refs = {name: {'path': str(path), 'sha256': hashlib.sha256(path.read_bytes()).hexdigest(), 'bytes': path.stat().st_size}
    for name, path in paths.items()}
(here/'INPUTS-FROIDS-EPINGLES.json').write_text(json.dumps(refs, indent=2, ensure_ascii=False)+'\n', encoding='utf8')
print(hashlib.sha256((here/'INPUTS-FROIDS-EPINGLES.json').read_bytes()).hexdigest())

"""Seal real received pins and the already-performed pure integration check only."""
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent


def ref(p):
    return {'path': str(p.resolve()), 'sha256': hashlib.sha256(p.read_bytes()).hexdigest()}


def write(name, value):
    with (HERE / name).open('x', encoding='utf8') as stream:
        json.dump(value, stream, indent=2)
        stream.write('\n')


def main():
    delta = json.loads((HERE / 'DELTA-SEPT-PINS-REELS.json').read_bytes())
    assert ref(HERE / 'DELTA-SEPT-PINS-REELS.json')['sha256'] == '344805281267d1a0067cfd34f1c23741633a02f44f7586715c56b8a076dbf38e'
    assert all(ref(Path(value['path'])) == value for value in delta['components'].values())
    check = json.loads((HERE / 'CONTROLE-PUR-LIAISONS-ET-PLANS.json').read_bytes())
    assert check['verified'] is True and len(check['three_complete_plan_checks']) == 3
    manifest = {'schema': 'hpc-forest-r2g-real-parent-adapters-manifest-v1',
        'components': {name: value['sha256'] for name, value in delta['components'].items()},
        'delta': ref(HERE / 'DELTA-SEPT-PINS-REELS.json'),
        'pure_integration': ref(HERE / 'CONTROLE-PUR-LIAISONS-ET-PLANS.json'),
        'operational_recipe': ref(HERE / 'PARCOURS-PARENT.md')}
    write('MANIFESTE-COLLECTEURS-REELS.json', manifest)
    write('LIVRAISON-COLLECTEURS-REELS-POUR-REVUE.json', {
        'schema': 'hpc-forest-r2g-real-parent-adapters-delivery-v1', 'verified_local_delta': True,
        'manifest': ref(HERE / 'MANIFESTE-COLLECTEURS-REELS.json'),
        'changed_only_seven_received_pins_and_three_COMMON_SHA_imports': True,
        'initial_namespace_r4_numeric_lane_and_all_function_ASTs_unchanged': True,
        'complete_real_Q_and_factory_review_and_3plan_checks_passed_purely': True,
        'old_R2d_and_new_F_closure_kept_distinct': True,
        'F_actions_all_three_already_exited_naturally': True,
        'prior_12_delta_neutral_cases_not_replayed': True, 'ruff_passed': True,
        'first_local_refusals_preserved': True,
        'actual_CIM_CURRENT_intent_policy_auth_cache_CLI_process_model_transport_effects': False,
        'fresh_operational_preflight_and_independent_review_still_required': True,
        'native_NORMAL_runtime_host_or_performance_admitted': False})
    print(json.dumps(ref(HERE / 'LIVRAISON-COLLECTEURS-REELS-POUR-REVUE.json')))


if __name__ == '__main__':
    main()

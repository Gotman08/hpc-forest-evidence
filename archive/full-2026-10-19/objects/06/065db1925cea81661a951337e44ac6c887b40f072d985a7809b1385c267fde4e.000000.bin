        "content": "#include <iostream>\n#include <vector>\n#include <algorithm>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nstatic inline int add_mod(int a, int b) {\n    int s = a + b;\n    return s >= MOD ? s - MOD : s;\n}\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n    vector<vector<bool> > blockedCells(n, vector<bool>(n, false));\n    for (int c = 0; c < m; ++c) {\n        int i, j;\n        cin >> i >> j;\n        blockedCells[i][j] = true;\n    }\n\n    vector<int> dp(n, 0);\n    dp[0] = 1;\n    int threads = 1;\n#ifdef _OPENMP\n    if (n >= 2048)\n        threads = min(4, omp_get_max_threads());\n#endif\n\n    if (threads == 1) {\n        for (int i = 0; i < n; ++i) {\n            int sum = 0;\n            for (int j = 0; j < n; ++j) {\n                sum = blockedCells[i][j] ? 0 : add_mod(sum, dp[j]);\n                dp[j] = sum;\n            }\n        }\n    }\n#ifdef _OPENMP\n    else {\n        vector<int> totals(threads), resets(threads);\n#pragma omp parallel num_threads(threads) shared(dp, totals, resets, blockedCells)\n        {\n            const int tid = omp_get_thread_num();\n            const int team = omp_get_num_threads();\n            const int begin = n * tid / team;\n            const int end = n * (tid + 1) / team;\n            for (int i = 0; i < n; ++i) {\n                int sum = 0;\n                int firstBlocked = end;\n                for (int j = begin; j < end; ++j) {\n                    if (blockedCells[i][j]) {\n                        sum = 0;\n                        if (firstBlocked == end)\n                            firstBlocked = j;\n                    } else {\n                        sum = add_mod(sum, dp[j]);\n                    }\n                    dp[j] = sum;\n                }\n                totals[tid] = sum;\n                resets[tid] = firstBlocked != end;\n#pragma omp barrier\n                int carry = 0;\n                for (int t = 0; t < tid; ++t)\n                    carry = resets[t] ? totals[t] : add_mod(carry, totals[t]);\n                if (carry != 0) {\n                    for (int j = begin; j < firstBlocked; ++j)\n                        dp[j] = add_mod(dp[j], carry);\n                }\n#pragma omp barrier\n            }\n        }\n    }\n#endif\n    cout << dp[n - 1] << endl;\n}\n",
        "path": "src/solution.cpp"
      }

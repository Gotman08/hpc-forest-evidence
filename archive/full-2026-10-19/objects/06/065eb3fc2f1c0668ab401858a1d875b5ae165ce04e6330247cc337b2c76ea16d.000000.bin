{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdint.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n#define FORCE_SLAB 32\n#define TARGET_TILE 16\n#define PARALLEL_THRESHOLD 256\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nstatic float *make_force_workspace(int n) {\n  const size_t floats_per_body = 2u * FORCE_SLAB + 3u;\n  if (n <= 0 || (size_t)n > SIZE_MAX / sizeof(float) / floats_per_body)\n    return NULL;\n  return (float *)malloc((size_t)n * floats_per_body * sizeof(float));\n}\n\n/* Called collectively by the current team. */\nstatic void force_rows_workshare(Body *p, float dt, int n) {\n  #pragma omp for schedule(static)\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n#if defined(__GNUC__) && !defined(__clang__)\n#pragma GCC push_options\n#pragma GCC optimize (\"no-math-errno\")\n#endif\n\n/*\n * Stream source slabs in ascending order. Unfinished destinations receive\n * their next force prefix immediately; the current slab gathers the other\n * direction from saved coefficients. Both directions retain source order.\n */\nstatic void force_slab_workshare(Body *restrict p, float dt, int n,\n                                 float *restrict workspace,\n                                 int *bad_positions) {\n  if (workspace == NULL) {\n    force_rows_workshare(p, dt, n);\n    return;\n  }\n\n  const size_t stride = (size_t)n;\n  const size_t plane = (size_t)FORCE_SLAB * stride;\n  float *force_x = workspace + 2 * plane;\n  float *force_y = force_x + stride;\n  float *force_z = force_y + stride;\n\n  #pragma omp single\n  {\n    *bad_positions = 0;\n  }\n\n  #pragma omp for schedule(static)\n  for (int i = 0; i < n; ++i) {\n    force_x[i] = 0.0f;\n    force_y[i] = 0.0f;\n    force_z[i] = 0.0f;\n    if (!isfinite(p[i].x) || !isfinite(p[i].y) || !isfinite(p[i].z)) {\n      #pragma omp atomic write\n      *bad_positions = 1;\n    }\n  }\n\n  /* Preserve operand-specific NaN behavior through the original row kernel. */\n  if (*bad_positions) {\n    force_rows_workshare(p, dt, n);\n    return;\n  }\n\n  int bank = 0;\n  for (int slab = 0; slab < n; ) {\n    int width = n - slab;\n    if (width > FORCE_SLAB) width = FORCE_SLAB;\n    const int end = slab + width;\n    const int ntiles = 1 + (n - slab - 1) / TARGET_TILE;\n    float *coefficients = workspace + (size_t)bank * plane;\n\n    #pragma omp for schedule(static)\n    for (int tile = 0; tile < ntiles; ++tile) {\n      const int first = slab + tile * TARGET_TILE;\n      int count = n - first;\n      if (count > TARGET_TILE) count = TARGET_TILE;\n      float tx[TARGET_TILE], ty[TARGET_TILE], tz[TARGET_TILE];\n      float fx[TARGET_TILE], fy[TARGET_TILE], fz[TARGET_TILE];\n\n      #pragma omp simd\n      for (int lane = 0; lane < count; ++lane) {\n        tx[lane] = p[first + lane].x;\n        ty[lane] = p[first + lane].y;\n        tz[lane] = p[first + lane].z;\n        fx[lane] = force_x[first + lane];\n        fy[lane] = force_y[first + lane];\n        fz[lane] = force_z[first + lane];\n      }\n\n      /* FORCE_SLAB is a multiple of TARGET_TILE, so tiles do not straddle end. */\n      if (first < end) {\n        for (int k = 0; k < width; ++k) {\n          const float sx = p[slab + k].x;\n          const float sy = p[slab + k].y;\n          const float sz = p[slab + k].z;\n          float *row = coefficients + (size_t)k * stride + first;\n\n          #pragma omp simd\n          for (int lane = 0; lane < count; ++lane) {\n            float dx = tx[lane] - sx;\n            float dy = ty[lane] - sy;\n            float dz = tz[lane] - sz;\n            float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n            float inv_dist = 1 / sqrt(sqrd_dist);\n            float inv_dist3 = inv_dist * inv_dist * inv_dist;\n            row[lane] = inv_dist3;\n          }\n        }\n      } else {\n        for (int k = 0; k < width; ++k) {\n          const float sx = p[slab + k].x;\n          const float sy = p[slab + k].y;\n          const float sz = p[slab + k].z;\n          float *row = coefficients + (size_t)k * stride + first;\n\n          /* SIMD lanes are different destinations, not a force reduction. */\n          #pragma omp simd\n          for (int lane = 0; lane < count; ++lane) {\n            float dx = sx - tx[lane];\n            float dy = sy - ty[lane];\n            float dz = sz - tz[lane];\n            float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n            float inv_dist = 1 / sqrt(sqrd_dist);\n            float inv_dist3 = inv_dist * inv_dist * inv_dist;\n            row[lane] = inv_dist3;\n            fx[lane] += dx * inv_dist3;\n            fy[lane] += dy * inv_dist3;\n            fz[lane] += dz * inv_dist3;\n          }\n        }\n\n        #pragma omp simd\n        for (int lane = 0; lane < count; ++lane) {\n          force_x[first + lane] = fx[lane];\n          force_y[first + lane] = fy[lane];\n          force_z[first + lane] = fz[lane];\n        }\n      }\n    }\n\n    #pragma omp for schedule(static) nowait\n    for (int k = 0; k < width; ++k) {\n      const int i = slab + k;\n      const float x = p[i].x;\n      const float y = p[i].y;\n      const float z = p[i].z;\n      float fx = force_x[i];\n      float fy = force_y[i];\n      float fz = force_z[i];\n      const float *row = coefficients + (size_t)k * stride;\n\n      for (int j = slab; j < n; ++j) {\n        float dx = p[j].x - x;\n        float dy = p[j].y - y;\n        float dz = p[j].z - z;\n        float inv_dist3 = row[j];\n        fx += dx * inv_dist3;\n        fy += dy * inv_dist3;\n        fz += dz * inv_dist3;\n      }\n\n      p[i].vx += dt*fx;\n      p[i].vy += dt*fy;\n      p[i].vz += dt*fz;\n    }\n\n    /* The next generation uses the other bank while these rows finish. */\n    slab = end;\n    bank ^= 1;\n  }\n\n  #pragma omp barrier\n}\n\n#if defined(__GNUC__) && !defined(__clang__)\n#pragma GCC pop_options\n#endif\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system. Workspace belongs to this call, including repeated calls.\n */\nvoid body_force(Body *p, float dt, int n) {\n  float *workspace = n >= PARALLEL_THRESHOLD ? make_force_workspace(n) : NULL;\n  int bad_positions = 0;\n\n  #pragma omp parallel if(n >= PARALLEL_THRESHOLD)\n  {\n    force_slab_workshare(p, dt, n, workspace, &bad_positions);\n  }\n\n  free(workspace);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n  float *workspace = nbodies >= PARALLEL_THRESHOLD\n                   ? make_force_workspace(nbodies) : NULL;\n  int bad_positions = 0;\n\n  /* Keep one team and reuse the linear workspace across simulation steps. */\n  #pragma omp parallel if(nbodies >= PARALLEL_THRESHOLD)\n  {\n    for (int iter = 0; iter < N_ITER; iter++) {\n      force_slab_workshare(bodies, DT, nbodies, workspace, &bad_positions);\n\n      #pragma omp for schedule(static)\n      for (int i = 0; i < nbodies; i++) {\n        bodies[i].x += bodies[i].vx * DT;\n        bodies[i].y += bodies[i].vy * DT;\n        bodies[i].z += bodies[i].vz * DT;\n      }\n    }\n  }\n\n  free(workspace);\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Double-buffered source-slab worksharing can nearly halve distance evaluations while preserving reference-order sums and overlapping row completion with the next slab.",
  "notes": "Not executed. Keeps double-precision sqrt, ascending-source accumulation, and the binary I/O contract. Scratch is O(n); allocation failure or nonfinite positions use ordered row worksharing.",
  "sources_kept": [],

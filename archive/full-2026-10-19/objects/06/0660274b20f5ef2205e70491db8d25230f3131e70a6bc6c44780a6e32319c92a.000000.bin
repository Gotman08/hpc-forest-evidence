        "content": "#include <iostream>\n#include <string>\n#include <map>\n#include <list>\n#include <queue>\n#include <climits>\n#include <vector>\n#include <cstddef>\n#include <cstdio>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\nusing namespace std;\n\nint nCores = 0;\nint nVertices = 0;\nint nArestas = 0;\nint no_of_vert = 0;\nint contCor = 0;\n\nvector<int> caminhoTropical;\nvector<int> caminho;\nvector<pair<int, int>> arvoreGeradora;\n\nstruct part\n{\n    vector<pair<int, int>> spanning;\n    vector<pair<int, int>> inc_ed;\n    vector<pair<int, int>> exc_ed;\n};\n\nvector<part> partitions;\nvector<pair<int, int>> current_span;\n\nclass graph{\n    public:\n        int Vertex;\n        vector<vector<int>> adj_mat;\n        vector<int> cores;\n\n        graph(int vertex)\n        {\n            Vertex = vertex;\n            for(int i = 0; i < Vertex; i++){\n                vector<int> aux;\n                for(int j = 0; j < Vertex; j++){\n                    aux.push_back(0);\n                }\n                adj_mat.push_back(aux);\n            }\n\n            for(int i = 0; i < Vertex; i++)\n               cores.push_back(0);\n        }\n\n        void add_edge(int u, int v)\n        {\n            adj_mat[u][v] = adj_mat[v][u] = 1;\n        }\n};\n\nint find_min_key(const vector<int>& arr, int V)\n{\n    int min_key = INT_MAX;\n    int min_index = -1;\n    const int* values = arr.data();\n    int i = 0;\n\n#if defined(__aarch64__)\n    if(V >= 4)\n    {\n        const int lane_indices[4] = {0, 1, 2, 3};\n        int32x4_t indices = vld1q_s32(lane_indices);\n        const int32x4_t step = vdupq_n_s32(4);\n        const int32x4_t infinity = vdupq_n_s32(INT_MAX);\n        int32x4_t best_values = infinity;\n        int32x4_t best_indices = infinity;\n\n        for(; i <= V - 4; i += 4)\n        {\n            const int32x4_t block = vld1q_s32(values + i);\n            const uint32x4_t better = vcltq_s32(block, best_values);\n            best_values = vminq_s32(best_values, block);\n            best_indices = vbslq_s32(better, indices, best_indices);\n            indices = vaddq_s32(indices, step);\n        }\n\n        min_key = vminvq_s32(best_values);\n        if(min_key != INT_MAX)\n        {\n            // Each lane retains its first minimum; choose the earliest tied lane index.\n            const uint32x4_t tied = vceqq_s32(best_values, vdupq_n_s32(min_key));\n            min_index = vminvq_s32(vbslq_s32(tied, best_indices, infinity));\n        }\n    }\n#endif\n\n    for(; i < V; i++)\n    {\n        if(values[i] < min_key)\n        {\n            min_key = values[i];\n            min_index = i;\n        }\n    }\n    return min_index;\n}\n\nbool is_cycle(const vector<vector<int>>& mat,int src, int V)//verificar se o gr?fico formado ? c?clico ou n?o\n{\n    map<int,bool> visited;\n    queue<int> traverse;\n    map<int,int> parent;\n    parent[src]=src;\n    visited[src]=true;\n    traverse.push(src);\n    while(!traverse.empty())\n    {\n        int node=traverse.front();\n        traverse.pop();\n        for(int i=0;i<V;i++)\n            if(mat[node][i]>0)\n            {\n                if(!visited[i])\n                {\n                    traverse.push(i);\n                    visited[i]=true;\n                    parent[i]=node;\n                }\n                else if(visited[i]==true && i!=parent[node])\n                    return 1; //ciclo\n            }\n    }\n    return 0;\n}\n\nint Prim_ST(const graph& G, const vector<pair<int,int>>& include_edges, const vector<pair<int,int>>& exclude_edges)\n{\n    int V = G.Vertex;\n    vector<vector<int>> new_mat = G.adj_mat;\n\n    int u1,v1;\n    for(vector<pair<int, int>>::const_iterator it=exclude_edges.begin(); it!=exclude_edges.end();it++)\n    {\n        u1=(*it).first;\n        v1=(*it).second;\n        new_mat[u1][v1]=new_mat[v1][u1]=INT_MIN;\n    }\n\n    int parent[V];\n    vector<int> key(V, INT_MAX);\n    vector<int> mstset(V, 0);\n    for(int i=0;i<V;i++)\n    {\n        parent[i]=nVertices;\n    }\n\n    int root;\n    root= 0;\n    parent[root]=-1;\n\n    int vertex_must_include[V];\n    map<int, int> parent_included_vertex;\n    const bool has_included_edges = !include_edges.empty();\n\n    for(int m=0;m<V;m++)\n        vertex_must_include[m]=false;\n    if(has_included_edges)\n    {\n        for(vector<pair<int, int>>::const_iterator it=include_edges.begin(); it!=include_edges.end();it++)\n        {\n            u1=(*it).first;\n            v1=(*it).second;\n            vertex_must_include[u1]=vertex_must_include[v1]=true;\n            parent_included_vertex[v1]=u1;\n            parent_included_vertex[u1]=100;\n        }\n    }\n\n    key[root]=0;\n    parent[root]=-1;\n    // Committed parent edges form a forest ordered by vertex selection.\n    // A trial relaxation targets an unselected vertex, adding only a leaf.\n    // Consequently the former cycle walk could never reject a relaxation.\n    for(int c=0;c<V;c++)\n    {\n        int u=find_min_key(key, V);\n        if(u==-1) //desconectado\n        {\n            return -1;\n        }\n        mstset[u]=1;\n        // Selected keys are excluded from subsequent minimum reductions.\n        key[u]=INT_MAX;\n        no_of_vert++;\n        const int* row = new_mat[u].data();\n        int v = 0;\n\n#if defined(__aarch64__)\n        if(!has_included_edges)\n        {\n            const int32x4_t zero = vdupq_n_s32(0);\n            const int32x4_t selected_parent = vdupq_n_s32(u);\n            for(; v <= V - 4; v += 4)\n            {\n                const int32x4_t weights = vld1q_s32(row + v);\n                const int32x4_t old_keys = vld1q_s32(key.data() + v);\n                const int32x4_t selected = vld1q_s32(mstset.data() + v);\n                const uint32x4_t candidates = vandq_u32(\n                    vcgtq_s32(weights, zero),\n                    vandq_u32(vceqq_s32(selected, zero),\n                              vcltq_s32(weights, old_keys)));\n                if(vmaxvq_u32(candidates) != 0)\n                {\n                    const int32x4_t old_parents = vld1q_s32(parent + v);\n                    vst1q_s32(parent + v,\n                              vbslq_s32(candidates, selected_parent, old_parents));\n                    vst1q_s32(key.data() + v,\n                              vbslq_s32(candidates, weights, old_keys));\n                }\n            }\n        }\n#endif\n\n        // Included-edge checks can read a parent changed earlier in this scan.\n        // Keep constrained relaxations in their original ascending order.\n        for(;v<V;v++)\n        {\n            const int weight = row[v];\n            if(weight>0 && mstset[v]==0 && weight<key[v])\n            {\n                if(vertex_must_include[v] && parent_included_vertex[v]!=100 && parent_included_vertex[v]!=u)\n                {\n                    int x=parent_included_vertex[v];\n                    if(parent[x]!=nVertices)\n                        continue;\n                }\n                parent[v]=u;\n                key[v]=weight;\n            }\n        }\n    }\n\n    int tot_cost=0;\n    for(int i=1;i<V;i++){\n        int x=parent[i];\n        tot_cost+=new_mat[x][i];\n        current_span.push_back(make_pair(x, i));\n    }\n    return tot_cost;\n}\n\nvoid exibirVetor(const vector<int>& l)\n{\n    for(auto i: l)\n    {\n        if(i == l.back())\n            cout<<i;\n        else\n            cout<<i<<\"-\";\n    }\n    cout<<endl;\n}\n\nbool buscaSequencial(const vector<int>& l, int ch){\n    const int* values = l.data();\n    const std::size_t count = l.size();\n    std::size_t i = 0;\n\n#if defined(__aarch64__)\n    const std::size_t end = count - count % 4;\n    if(end != 0)\n    {\n        const int32x4_t needle = vdupq_n_s32(ch);\n        uint32x4_t matches = vdupq_n_u32(0);\n        for(; i < end; i += 4)\n        {\n            matches = vorrq_u32(matches, vceqq_s32(vld1q_s32(values + i), needle));\n        }\n        if(vmaxvq_u32(matches) != 0)\n            return true;\n    }\n#endif\n\n    for(; i < count; i++)\n        if(ch == values[i]) return true;\n    return false;\n}\n\nvector<int> buscaAresta(int vert){\n    vector<int> aux;\n    for(std::vector<std::pair<int, int>>::iterator it = arvoreGeradora.begin(); it != arvoreGeradora.end(); it++){\n        pair<int, int> par = *it;\n        if(vert == par.first) aux.push_back(par.second);\n        if(vert == par.second) aux.push_back(par.first);\n    }\n    return aux;\n}\n\nint coresConjunto(const vector<int>& l, const graph& G){\n    vector<int> cor;\n\n    for(std::vector<int>::const_iterator it = l.begin(); it != l.end(); it++){\n        if(!buscaSequencial(cor, G.cores[*it])){\n            cor.push_back(G.cores[*it]);\n        }\n    }\n    return cor.size();\n}\n\nbool deep(int vertice, vector<int> hist, const graph& G)\n{\n    bool fim = true;\n    hist.push_back(vertice);\n    vector<int> aux = buscaAresta(vertice);\n\n    for(std::vector<int>::iterator it = aux.begin(); it != aux.end(); it++){\n        if(!buscaSequencial(hist, *it)){\n            fim = false;\n            if(deep(*it, hist, G)){\n                return true;\n            }\n        }\n    }\n\n    if(fim){\n        int nCor = coresConjunto(hist, G);\n        if(nCor == nCores){\n            exibirVetor(hist);\n            cout<<nCor;\n            return true;\n        }\n        else if(nCor > contCor){\n            contCor = nCor;\n            caminho = hist;\n        }\n        return false;\n    }\n\n    hist.pop_back();\n\n    return false;\n}\n\nbool caminhoTropi(const graph& G){\n    for (int i = 0; i < nVertices; i++)\n    {\n        vector<int> historico;\n        historico.push_back(i);\n        vector<int> vertices = buscaAresta(i);\n\n        for(std::vector<int>::iterator it = vertices.begin(); it != vertices.end(); it++){\n            if(deep(*it, historico, G)){\n                return true;\n            }\n        }\n\n        historico.pop_back();\n    }\n    return false;\n}\n\nbool create_partitions(const graph& G)\n{\n    while(true)\n    {\n        part P;\n        vector<part>::iterator iter;\n        for(vector<part>::iterator it=partitions.begin();it!=partitions.end();it++)\n        {\n            iter=it;\n        }\n        P.spanning=(*iter).spanning;\n        P.exc_ed=(*iter).exc_ed;\n        P.inc_ed=(*iter).inc_ed;\n        partitions.erase(iter);\n\n        vector<pair<int, int>> stree = P.spanning;\n        vector<pair<int, int>>::iterator it1;\n        vector<pair<int, int>>::iterator it2;\n\n        arvoreGeradora = stree;\n\n        if(caminhoTropi(G)){\n            return true;\n        }\n\n        vector<pair<int, int>> included_edges;\n        vector<pair<int, int>> excluded_edges;\n        included_edges=P.inc_ed;\n        pair<int, int> ex_edge;\n\n        int j;\n        for(j = 0; j < stree.size(); j++)\n        {\n            if(included_edges.empty())\n                break;\n            if(stree[j].first!=included_edges[j].first && stree[j].second!=included_edges[j].second)\n            {\n                break;\n            }\n        }\n        int cost;\n        it2= stree.begin()+ j;\n        int u1,v1;\n        for(it1=it2; it1!=stree.end(); it1++)\n        {\n            part new_p;\n            u1=(*it1).first;\n            v1=(*it1).second;\n            ex_edge.first=u1;\n            ex_edge.second=v1;\n            excluded_edges=P.exc_ed;\n            excluded_edges.push_back(ex_edge);\n            current_span.clear();\n            cost = Prim_ST(G, included_edges, excluded_edges);\n            if(cost > 0)\n            {\n                new_p.spanning=current_span;\n                new_p.inc_ed=included_edges;\n                new_p.exc_ed=excluded_edges;\n                partitions.push_back(new_p);\n            }\n            included_edges.push_back(ex_edge);\n        }\n\n        if(partitions.empty()){\n            return false;\n        }\n    }\n}\n\nint main() {\n    scanf(\"%i %i\", &nVertices, &nCores);\n\n    graph G {nVertices};\n\n    for(int i = 0; i < nVertices; i++){\n        int cor;\n        scanf(\"%i\", &cor);\n        G.cores[i] = cor;\n    }\n\n    scanf(\"%i\", &nArestas);\n\n    for(int i = 0; i < nArestas; i++){\n        int u1, v1;\n        scanf(\"%i %i\", &u1, &v1);\n        G.add_edge(u1, v1);\n    }\n\n    vector<pair<int, int>> incl;\n    vector<pair<int, int>> excl;\n    incl.clear();\n    excl.clear();\n    Prim_ST(G, incl, excl);\n    part p;\n    incl.clear();\n    excl.clear();\n    p.exc_ed=excl;\n    p.inc_ed=incl;\n    p.spanning=current_span;\n    partitions.push_back(p);\n\n    if(!create_partitions(G)){\n        exibirVetor(caminho);\n        cout<<contCor<<endl;\n    }\n\n    return 0;\n}\n",
        "path": "src/tropical.cpp"
      }

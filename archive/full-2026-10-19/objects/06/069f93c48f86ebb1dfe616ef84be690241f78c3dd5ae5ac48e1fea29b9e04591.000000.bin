{
  "src/solution.cpp": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n\n    vector<uint64_t> blocked;\n    blocked.reserve(m);\n    for (int c = 0; c < m; ++c) {\n        int row, col;\n        cin >> row >> col;\n        blocked.push_back(static_cast<uint64_t>(row) * n + col);\n    }\n    sort(blocked.begin(), blocked.end());\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\n\n    vector<int> dp(n, 0);\n    size_t obstacle = 0;\n    for (int row = 0; row < n; ++row) {\n        const uint64_t rowStart = static_cast<uint64_t>(row) * n;\n        for (int col = 0; col < n; ++col) {\n            const uint64_t cell = rowStart + col;\n            while (obstacle < blocked.size() && blocked[obstacle] < cell) {\n                ++obstacle;\n            }\n\n            if (obstacle < blocked.size() && blocked[obstacle] == cell) {\n                dp[col] = 0;\n            } else if (row == 0 && col == 0) {\n                dp[col] = 1;\n            } else if (col > 0) {\n                dp[col] += dp[col - 1];\n                if (dp[col] >= MOD) dp[col] -= MOD;\n            }\n        }\n    }\n\n    cout << dp[n - 1] << '\\n';\n}\n"
}

{
  "src/solution.cpp": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<int> offsets(static_cast<size_t>(n) + 1, 0);\n    vector<int> blockedColumns(m);\n    {\n        vector<int> rows(m);\n        vector<int> columns(m);\n        for (int k = 0; k < m; ++k) {\n            cin >> rows[k] >> columns[k];\n            ++offsets[rows[k] + 1];\n        }\n        for (int i = 0; i < n; ++i) {\n            offsets[i + 1] += offsets[i];\n        }\n        vector<int> next(offsets);\n        for (int k = 0; k < m; ++k) {\n            blockedColumns[next[rows[k]]++] = columns[k];\n        }\n    }\n\n    vector<int> dp(n, 0);\n    vector<uint64_t> blockedWords((static_cast<size_t>(n) + 63) / 64, 0);\n    dp[0] = 1;\n\n    for (int i = 0; i < n; ++i) {\n        fill(blockedWords.begin(), blockedWords.end(), uint64_t(0));\n        for (int k = offsets[i]; k < offsets[i + 1]; ++k) {\n            const int column = blockedColumns[k];\n            blockedWords[column / 64] |= uint64_t(1) << (column % 64);\n        }\n\n        int left = 0;\n        for (int begin = 0; begin < n; begin += 64) {\n            const int end = min(begin + 64, n);\n            uint64_t bits = blockedWords[begin / 64];\n            if (bits == 0) {\n                for (int j = begin; j < end; ++j) {\n                    int value = dp[j] + left;\n                    if (value >= MOD) value -= MOD;\n                    dp[j] = value;\n                    left = value;\n                }\n            } else {\n                for (int j = begin; j < end; ++j) {\n                    int value = 0;\n                    if ((bits & uint64_t(1)) == 0) {\n                        value = dp[j] + left;\n                        if (value >= MOD) value -= MOD;\n                    }\n                    dp[j] = value;\n                    left = value;\n                    bits >>= 1;\n                }\n            }\n        }\n    }\n\n    cout << dp[n - 1] << '\\n';\n    return 0;\n}\n"
}

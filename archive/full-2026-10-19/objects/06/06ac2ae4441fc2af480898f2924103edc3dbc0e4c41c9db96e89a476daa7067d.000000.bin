    {
      "id": "829e17a2504b4fe9",
      "role": "C",
      "mission": {
        "base_commit": "484c243121fed4562b6c8565052db5d61746f146",
        "delegation_parent": "R/C",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "A persistent OpenMP team with static row worksharing and an integer OR reduction for convergence should parallelize the uniform stencil and copy passes across the four cores while avoiding team creation on every sweep.",
        "id": "829e17a2504b4fe9",
        "ordinal": 1,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/laplace_seq.c"
          ],
          "retained": [
            "Use one OpenMP parallel region for all Jacobi sweeps to avoid repeatedly creating a team.",
            "Work-share stencil rows with schedule(static) and combine per-thread convergence flags using reduction(|:hasError).",
            "Work-share the subsequent interior copy with schedule(static), retaining the barrier between computation and copying."
          ]
        },
        "tree_id": "e1:C",
        "trial_id": "01M541H7HD0XR5YYK03M46ZZXS",

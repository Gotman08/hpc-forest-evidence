-    double *cont;\\n-    cont=(double*)malloc(lin*sizeof(double));\\n-\\tfloat conta=0, moda=0;\\n-\\t\\n-\\tfor(i=0;i<lin;i++){\\n-        for(j=i+1;j<lin;j++){\\n-        \\t\\n-\\t\\t\\tif(matriz[i]==matriz[j]){\\n-\\t\\t\\t\\tcont[i]++;\\n-\\t\\t\\t\\t\\tif(cont[i]>conta){\\n-\\t\\t\\t\\t\\t\\tconta=cont[i];\\n-\\t\\t\\t\\t\\t\\tmoda=matriz[i];\\n-\\t\\t\\t\\t\\t}\\n-\\t\\t\\t}\\n+static double moda_aux(double *matriz, int lin) {\\n+    int i, j;\\n+    int has_nan = 0;\\n \\n+    for (i = 0; i < lin; i++) {\\n+        if (isnan(matriz[i])) {\\n+            has_nan = 1;\\n+            break;\\n         }\\n-        cont[i]=0;\\n     }\\n-    free(cont);\\n-    if(conta == 0){\\n-    \\treturn -1;\\n-\\t}\\n-\\telse{\\n-\\t\\treturn moda;\\n-\\t}\\n \\n+    if (has_nan) {\\n+        int melhor_contagem = 0;\\n+        double moda = 0;\\n+       \"}, {\"id\": \"bf5578b2af2142f2\", \"role\": \"A\", \"commit\": \"65b70cf083bccb6a09995853bf78e1487701b142\", \"transformations\": {\"files\": [\"src/est_matriz_seq.c\"], \"retained\": [\"Replace bubble sort with a stable bottom-up merge sort over contiguous columns, reusing one scratch array.\", \"Accumulate arithmetic and harmonic sums as values are read, eliminating two later full-matrix passes.\", \"Compute median, mode run lengths, and variance in a single sequential scan of each sorted column.\"]}, \"mean_seconds\": 0.005358998663723469, \"diff\": \"diff --git a/src/est_matriz_seq.c b/src/est_matriz_seq.c\\nindex 6593ca3..6ba872f 100644\\n--- a/src/est_matriz_seq.c\\n+++ b/src/est_matriz_seq.c\\n@@ -1,192 +1,173 @@\\n-#include<stdio.h>\\n-#include<stdlib.h>\\n-#include<math.h>\\n-\\n-void bubble_sort (double *matriz, int tam) {\\n-    int i, j; \\n-    double aux;\\n-\\n-    for (i = tam - 1; i > 0; i--) {\\n-        for (j = 0; j < i; j++) {\\n-            if (matriz[j] > matriz[j+1]) {\\n-                aux=matriz[j];\\n-                matriz[j]=matriz[j+1];\\n-                matriz[j+1]=aux;\\n+#include <stdio.h>\\n+#include <stdlib.h>\\n+#include <math.h>\\n+#include <string.h>\\n+\\n+static void stable_merge_sort(double *values, double *scratch, int length) {\\n+    size_t n = (size_t)length;\\n+    double *source = values;\\n+    double *destination = scratch;\\n+\\n+    for (size_t width = 1; width < n; width *= 2) {\\n+        size_t span = width * 2;\\n+        for (size_t left = 0; left < n; left += span) {\\n+            size_t middle = left + width;\\n+            size_t right = left + span;\\n+            if (middle > n) middle = n;\\n+            if (right > n) right = n;\\n+\\n+            size_t a = left;\\n+            size_t b = middle;\\n+            size_t out = left;\\n+            while (a < middle && b < right) {\\n+                if (source[a] > source[b])\\n+                    destination[out++] = source[b++];\\n+                else\\n+                    destination[out++] = source[a++];\\n             }\\n+            while (a < middle) destination[out++] = source[a++];\\n+            while (b < right) destination[out++] = source[b++];\\n         }\\n-    }\\n-}\\n \\n-void ordena_colunas(double *matriz,int lin, int col) {\\n-    int i;\\n-    \\n-    for (i = 0; i < col; i++) {    \\n-        //manda o endereco do primeiro elemento da coluna, limites inf e sup e a largura da matriz\\n-        bubble_sort(&matriz[i*lin], lin);\\n+        double *temporary = source;\\n+        source = destination;\\n+        destination = temporary;\\n     }\\n-} \\n-\\n-void calcula_media(double *matriz, double *vet,int lin, int col){\\n-    int i,j;\\n-    double soma;\\n-    for(i=0;i<col;i++){\\n-        soma=0;\\n-        for(j=0;j<lin;j++){\\n-            soma+=matriz[i*lin+j];\\n-        }\\n-        vet[i]=soma/lin; \\n-    }   \\n-}\\n \\n-void calcula_media_harmonica(double *matriz, double *vet,int lin, int col){\\n-    int i,j;\\n-    double soma;\\n-    for(i=0;i<col;i++){\\n-        soma=0;\\n-        for(j=0;j<lin;j++){\\n-            soma+=(1/(matriz[i*lin+j]));\\n-        }\\n-        vet[i]=lin/soma; \\n-    }   \\n+    if (source != values)\\n+        memcpy(values, source, n * sizeof(*values));\\n }\\n \\n-void calcula_mediana(double *matriz, double *vet, int lin, int col) {  \\n-     int i=0;\\n-     if((lin-1)%2){ //Quantidade par de elementos\\n-         for (i = 0; i < col; i++) {\\n-            vet[i]=(matriz[(((i*lin)+(i+1)*lin)-1)/2]+matriz[((((i*lin)+(i+1)*lin)-1)/2)+1]);\\n-            vet[i]*=0.5;\\n-            \\n-         }\\n-     }\\n-     else{ //Quantidade ímpar de elementos\\n-         for (i = 0; i < col; i++) {\\n-            vet[i]=matriz[(((i*lin)+(i+1)*lin)-1)/2];\\n-         }\\n-     }\\n-    \\n- } \\n-\\n-//Adaptado de https://www.clubedohardware.com.br/forums/topic/1291570-programa-em-c-que-calcula-moda-media-e-mediana/\\n-double moda_aux(double *matriz,int lin){\\n-    int i, j; \\n-    double *cont;\\n-    cont=(double*)malloc(lin*sizeof(double));\\n-\\tfloat conta=0, moda=0;\\n-\\t\\n-\\tfor(i=0;i<lin;i++){\\n-        for(j=i+1;j<lin;j++){\\n-        \\t\\n-\\t\\t\\tif(matriz[i]==matriz[j]){\\n-\\t\\t\\t\\tcont[i]++;\\n-\\t\\t\\t\\t\\tif(cont[i]>conta){\\n-\\t\\t\\t\\t\\t\\tconta=cont[i];\\n-\\t\\t\\t\\t\\t\\tmoda=matriz[i];\\n-\\t\\t\\t\\t\\t}\\n-\\t\\t\\t}\\n+static void ordena_colunas(double *matriz, int lin, int col, double *scratch) {\\n+    for (int i = 0; i < col; i++)\\n+        stable_merge_sort(matriz + (size_t)i * (size_t)lin, scratch, lin);\\n+}\\n \\n+static void calcula_estatisticas_ordenadas(double *matriz, double *media,\\n+                                            double *mediana, double *moda,\\n+                                            double *variancia, int lin, int col) {\\n+    size_t n = (size_t)lin;\\n+\\n+    for (int i = 0; i < col; i++) {\\n+        double *coluna = matriz + (size_t)i * n;\\n+        if (lin % 2 == 0)\\n+            mediana[i] = (coluna[n / 2 - 1] + coluna[n / 2]) * 0.5;\\n+        else\\n+            mediana[i] = coluna[n / 2];\\n+\\n+        double soma = 0.0;\\n+        double valor_atual = coluna[0];\\n+        double valor_moda = 0.0;\\n+        size_t repeticoes = 0;\\n+        float maior_contagem = 0.0f;\\n+\\n+        for (size_t j = 0; j < n; j++) {\\n+            double valor = coluna[j];\\n+            soma += pow((valor - media[i]), 2);\\n+\\n+            if (j == 0) {\\n+                valor_atual = valor;\\n+                repeticoes = 1;\\n+            } else if (valor == valor_atual) {\\n+                repeticoes++;\\n+            } else {\\n+                double contagem = (double)(repeticoes - 1);\\n+                if (contagem > (double)maior_contagem) {\\n+                    maior_contagem = (float)contagem;\\n+                    valor_moda = valor_atual;\\n+                }\\n+                valor_atual = valor;\\n+                repeticoes = 1;\\n+            }\\n         }\\n-        cont[i]=0;\\n-    }\\n-    free(cont);\\n-    if(conta == 0){\\n-    \\treturn -1;\\n-\\t}\\n-\\telse{\\n-\\t\\treturn moda;\\n-\\t}\\n \\n-}\\n+        double contagem = (double)(repeticoes - 1);\\n+        if (contagem > (double)maior_contagem) {\\n+            maior_contagem = (float)contagem;\\n+            valor_moda = valor_atual;\\n+        }\\n \\n-void calcula_moda(double *matriz,double *moda,int lin, int col){\\n-    int i;\\n-    for(i=0;i<col;i++){\\n-        moda[i]=moda_aux(matriz+(i*lin),lin);\\n+        moda[i] = maior_contagem == 0.0f ? -1.0 : valor_moda;\\n+        variancia[i] = soma / (lin - 1);\\n     }\\n }\\n \\n-void calcula_variancia(double *matriz, double *media,double *variancia, int lin, int col){\\n-    int i,j;\\n-    double soma;\\n-    for(i=0;i<col;i++){\\n-        soma=0;\\n-        for(j=0;j<lin;j++){\\n-            soma+=pow((matriz[i*lin+j]-media[i]),2);\\n-        }\\n-        variancia[i]=soma/(lin-1); \\n-    } \\n+static void calcula_desvio_pa\"}, {\"id\": \"18e7c3ed189442a5\", \"role\": \"C\", \"commit\": \"dbebfb9fca2e6c581114095d31d719b7114d1f90\", \"transformations\": {\"files\": [\"src/est_matriz_seq.c\"], \"retained\": [\"Fuse each column's mean, harmonic mean, sort, mode, median, variance, standard deviation, and coefficient-of-variation work into one column function, invoked by a static-scheduled OpenMP loop.\", \"Raise the parallel threshold to 256 rows and four columns; retain the existing sequential routines below it.\", \"Zero-initialize the mode counter array to make independent concurrent mode calculations deterministic.\"]}, \"mean_seconds\": 0.006997278270622094, \"diff\": \"diff --git a/src/est_matriz_seq.c b/src/est_matriz_seq.c\\nindex 6593ca3..e26395d 100644\\n--- a/src/est_matriz_seq.c\\n+++ b/src/est_matriz_seq.c\\n@@ -38,7 +38,7 @@ void calcula_media(double *matriz, double *vet,int lin, int col){\\n     }   \\n }\\n \\n-void calcula_media_harmonica(double *matriz, double *vet,int lin, int col){\\n+void calcula_media_haromica(double *matriz, double *vet,int lin, int col){\\n     int i,j;\\n     double soma;\\n     for(i=0;i<col;i++){\\n@@ -71,7 +71,7 @@ void calcula_mediana(double *matriz, double *vet, int lin, int col) {\\n double moda_aux(double *matriz,int lin){\\n     int i, j; \\n     double *cont;\\n-    cont=(double*)malloc(lin*sizeof(double));\\n+    cont=(double*)calloc(lin,sizeof(double));\\n \\tfloat conta=0, moda=0;\\n \\t\\n \\tfor(i=0;i<lin;i++){\\n@@ -131,6 +131,39 @@ void calcula_coeficiente_variacao(double *media,double *dp,double *cv, int col){\\n     }  \\n }\\n \\n+void calcula_coluna(double *matriz, double *media, double *media_har,\\n+                    double *mediana, double *moda, double *variancia,\\n+                    double *dp, double *cv, int lin, int i){\\n+    int j;\\n+    double soma=0.0, soma_har=0.0, *coluna=matriz+(i*lin);\\n+\\n+    for(j=0;j<lin;j++){\\n+        soma+=coluna[j];\\n+        soma_har+=(1/coluna[j]);\\n+    }\\n+    media[i]=soma/lin;\\n+    media_har[i]=lin/soma_har;\\n+\\n+    bubble_sort(coluna,lin);\\n+    moda[i]=moda_aux(coluna,lin);\\n+\\n+    if((lin-1)%2){\\n+        mediana[i]=coluna[(lin-1)/2]+coluna[(lin-1)/2+1];\\n+        mediana[i]*=0.5;\\n+    }\\n+    else{\\n+        mediana[i]=coluna[(lin-1)/2];\\n+    }\\n+\\n+    soma=0.0;\\n+    for(j=0;j<lin;j++){\\n+        soma+=pow((coluna[j]-media[i]),2);\\n+    }\\n+    variancia[i]=soma/(lin-1);\\n+    dp[i]=sqrt(variancia[i]);\\n+    cv[i]=dp[i]/media[i];\\n+}\\n+\\n int main(int argc,char **argv){\\n     int lin,col,i,j; // Define as variáveis de índices e dimensões\\n     double *matriz,*mediana,*media,*media_har,*moda,*variancia,*dp,*cv; // Define a matriz (forma linear), vetores de medidas estatísticas\\n@@ -155,14 +188,21 @@ int main(int argc,char **argv){\\n         }\\n     }\\n \\n-    calcula_media(matriz,media,lin,col);\\n-    calcula_media_harmonica(matriz,media_har,lin,col);\\n-    ordena_colunas(matriz,lin,col);\\n-    calcula_mediana(matriz,mediana,lin,col);\\n-    calcula_moda(matriz,moda,lin,col);\\n-    calcula_variancia(matriz,media,variancia,lin,col);\\n-    calcula_desvio_padrao(variancia,dp,col);\\n-    calcula_coeficiente_variacao(media,dp,cv,col);\\n+    if (lin >= 256 && col >= 4) {\\n+#pragma omp parallel for schedule(static)\\n+        for (i = 0; i < col; i++) {\\n+            calcula_coluna(matriz,media,media_har,mediana,moda,variancia,dp,cv,lin,i);\\n+        }\\n+    } else {\\n+        calcula_media(matriz,media,lin,col);\\n+        calcula_media_haromica(matriz,media_har,lin,col);\\n+        ordena_colunas(matriz,lin,col);\\n+        calcula_moda(matriz,moda,lin,col);\\n+        calcula_mediana(matriz,mediana,lin,col);\\n+        calcula_variancia(matriz,media,variancia,lin,col);\\n+        calcula_desvio_padrao(variancia,dp,col);\\n+        calcula_coeficiente_variacao(media,dp,cv,col);\\n+    }\\n \\n     for(i=0;i<col;i++)\\n         printf(\\\"%.1lf \\\",media[i]); // Imprime as médias aritméticas de cada coluna\"}, {\"id\": \"d62c284b61d94564\", \"role\": \"B\", \"commit\": \
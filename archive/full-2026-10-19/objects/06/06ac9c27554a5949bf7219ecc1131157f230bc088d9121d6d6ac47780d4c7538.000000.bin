(remaining < width ? remaining : width);\\n+            i = left;\\n+            j = mid;\\n+            k = left;\\n+            while (i < mid && j < right) {\\n+                if (src[i] <= src[j])\\n+                    dst[k++] = src[i++];\\n+                else\\n+                    dst[k++] = src[j++];\\n+            }\\n+            while (i < mid)\\n+                dst[k++] = src[i++];\\n+            while (j < right)\\n+                dst[k++] = src[j++];\\n+            left = right;\\n+        }\\n+\\n+        {\\n+            double *tmp = src;\\n+            src = dst;\\n+            dst = tmp;\\n+        }\\n+        if (width > n / 2)\\n+            break;\\n+        width *= 2;\\n     }\\n-} \\n \\n-void calcula_media(double *matriz, double *vet,int lin, int col){\\n-    int i,j;\\n-    double soma;\\n-    for(i=0;i<col;i++){\\n-        soma=0;\\n-        for(j=0;j<lin;j++){\\n-            soma+=matriz[i*lin+j];\\n+    if (src != values)\\n+        memcpy(values, src, n * sizeof(*values));\\n+}\\n+\\n+static void ordena_colunas(double *matriz, int lin, int col, double *scratch) {\\n+    int i, j;\\n+    for (i = 0; i < col; i++) {\\n+        double *coluna = matriz + (size_t)i * (size_t)lin;\\n+        int has_nan = 0;\\n+\\n+        if (scratch == NULL) {\\n+            bubble_sort(coluna, lin);\\n+            continue;\\n+        }\\n+        for (j = 0; j < lin; j++) {\\n+            if (isnan(coluna[j])) {\\n+                has_nan = 1;\\n+                break;\\n+            }\\n         }\\n-        vet[i]=soma/lin; \\n-    }   \\n+        if (has_nan)\\n+            bubble_sort(coluna, lin);\\n+        else\\n+            merge_sort(coluna, scratch, lin);\\n+    }\\n+}\\n+\\n+static void calcula_media(double *matriz, double *vet, int lin, int col) {\\n+    int i, j;\\n+    double soma;\\n+    for (i = 0; i < col; i++) {\\n+        size_t base = (size_t)i * (size_t)lin;\\n+        soma = 0;\\n+        for (j = 0; j < lin; j++)\\n+       
      "content": "#include \"knn.h\"\n\nchar knn(int n_groups, Group * groups, const Point * all_points, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(\n                to_evaluate, all_points[g.first_point + (size_t) j]);\n\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n\n                    distances[x] = d;\n                    labels[x] = g.label;\n\n                    break;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n    Point * all_points = NULL;\n    size_t point_count = 0;\n    size_t point_capacity = 0;\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group(&all_points, &point_count, &point_capacity);\n    }\n\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, all_points, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    },
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    size_t first_point;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group(Point ** points, size_t * point_count, size_t * point_capacity) {\n    char label;\n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    size_t max_points = ((size_t) -1) / sizeof(Point);\n    if (length < 0 || *point_count > max_points ||\n        (size_t) length > max_points - *point_count) on_error();\n\n    size_t required = *point_count + (size_t) length;\n    if (required > *point_capacity) {\n        size_t new_capacity = *point_capacity;\n        if (new_capacity == 0) {\n            new_capacity = required < 256 ? 256 : required;\n        }\n\n        while (new_capacity < required) {\n            if (new_capacity > max_points / 2) {\n                new_capacity = required;\n                break;\n            }\n            new_capacity *= 2;\n        }\n        if (new_capacity > max_points) new_capacity = required;\n\n        Point * new_points = (Point *) realloc(*points, sizeof(Point) * new_capacity);\n        if (new_points == NULL) on_error();\n        *points = new_points;\n        *point_capacity = new_capacity;\n    }\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.first_point = *point_count;\n\n    for (int i = 0; i < length; i++) {\n        (*points)[(*point_count)++] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}\n",
      "path": "src/knn.h"
    }
  ],
  "hypothesis": "Appending parsed points to one geometrically grown contiguous buffer, with each group represented by an offset and length, should reduce per-group allocation overhead and improve sequential point-scan locality. Keeping the existing group/point traversal order and selection logic preserves equal-distance and vote tie behavior.",

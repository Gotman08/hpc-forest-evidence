{"files":[{"content":"#include <algorithm>\n#include <cstddef>\n#include <cstdint>\n#include <iostream>\n#include <utility>\n#include <vector>\n\nusing namespace std;\n\nstruct adjacency_matrix {\n    int vertices = 0;\n    int words_per_row = 0;\n    vector<uint64_t> rows;\n    vector<int> degree;\n\n    void addAdjacency(int row, int column) {\n        const size_t index = static_cast<size_t>(row) * words_per_row + column / 64;\n        const uint64_t bit = uint64_t(1) << (column % 64);\n        if ((rows[index] & bit) == 0) {\n            rows[index] |= bit;\n            ++degree[row];\n        }\n    }\n\n    bool adjacent(int row, int column) const {\n        const size_t index = static_cast<size_t>(row) * words_per_row + column / 64;\n        return ((rows[index] >> (column % 64)) & uint64_t(1)) != 0;\n    }\n};\n\nadjacency_matrix readGraph();\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2);\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                      const vector<int> &equivalence);\ninline void printPermutation(const vector<int> &equivalence);\n\nint main() {\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if (!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2) {\n    if (g1.vertices != g2.vertices) return false;\n\n    vector<int> sorted_degree_g1 = g1.degree;\n    vector<int> sorted_degree_g2 = g2.degree;\n    sort(sorted_degree_g1.begin(), sorted_degree_g1.end());\n    sort(sorted_degree_g2.begin(), sorted_degree_g2.end());\n    if (sorted_degree_g1 != sorted_degree_g2) return false;\n\n    vector<int> equivalence(g1.vertices, 0);\n    vector<int> exchange_counter(g1.vertices, 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    for (int i = 0; i < g1.vertices; ++i)\n        equivalence[i] = i;\n\n    if (verifyPermutation(g1, g2, equivalence)) {\n        printPermutation(equivalence);\n        return true;\n    }\n\n    /*\n     * Permutations are based on Heap's algorithm, which generates all possible\n     * permutations for a given set of elements.\n     */\n    while (exchange_index < g1.vertices) {\n        if (exchange_counter[exchange_index] < exchange_index) {\n            if (exchange_index % 2 == 0)\n                swap(equivalence[0], equivalence[exchange_index]);\n            else\n                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\n\n            if (verifyPermutation(g1, g2, equivalence)) {\n                printPermutation(equivalence);\n                isomorphism_found = true;\n            }\n\n            exchange_counter[exchange_index]++;\n            exchange_index = 1;\n        } else {\n            exchange_counter[exchange_index] = 0;\n            exchange_index++;\n        }\n    }\n    return isomorphism_found;\n}\n\nadjacency_matrix readGraph() {\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read;\n    read.vertices = vertices;\n    read.words_per_row = (vertices + 63) / 64;\n    read.rows.assign(static_cast<size_t>(vertices) * read.words_per_row, uint64_t(0));\n    read.degree.assign(vertices, 0);\n\n    cin >> edges;\n    for (int i = 0; i < edges; ++i) {\n        cin >> source >> destination;\n        read.addAdjacency(source, destination);\n        read.addAdjacency(destination, source);\n    }\n\n    return read;\n}\n\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence) {\n    for (int i = 0; i < g1.vertices; ++i) {\n        if (g1.degree[i] != g2.degree[equivalence[i]]) return false;\n    }\n\n    for (int i = 0; i < g1.vertices; ++i) {\n        const int mapped_i = equivalence[i];\n        const int last_word = i / 64;\n\n        for (int word = 0; word <= last_word; ++word) {\n            uint64_t bits = g1.rows[static_cast<size_t>(i) * g1.words_per_row + word];\n            if (word == last_word) {\n                const int bits_to_keep = (i % 64) + 1;\n                if (bits_to_keep < 64)\n                    bits &= (uint64_t(1) << bits_to_keep) - 1;\n            }\n\n            while (bits != 0) {\n                const int bit = static_cast<int>(__builtin_ctzll(bits));\n                const int j = word * 64 + bit;\n                if (!g2.adjacent(mapped_i, equivalence[j])) return false;\n                bits &= bits - 1;\n            }\n        }\n    }\n    return true;\n}\n\ninline void printPermutation(const vector<int> &equivalence) {\n    for (auto i : equivalence)\n        cout << i << \" \";\n    cout << endl;\n}\n","path":"src/brute_isomorphism.cpp"}],"hypothesis":"Adding a one-time sorted degree-multiset rejection to the packed-bitset verifier can avoid factorial enumeration for inputs whose degree multisets differ, while retaining the reference-compatible identity-first and Heap-order output behavior.","notes":"No commands were run. The controller must evaluate correctness and runtime; the additional filter's speed benefit is not assumed.","research":{"queries":[],"urls":[]},"sources_kept":["f1bcac767c3c46e0","8fd3ad3bf9344e83"],"transformations":["Replace nested boolean adjacency rows with contiguous row-major uint64_t bitsets and track each row's population as edges are set.","Reject differing sorted row-population multisets before enumeration; for each candidate, reject mapped degree mismatches, then check only set bits in the source matrix's lower triangle.","Preserve iterative Heap permutation order, identity-match behavior, and printing of every matching permutation after identity fails."]}
"""Pure tests of new Q envelope. Never invoke its main or a subprocess."""
import ast
import importlib.util
import io
import json
import tarfile
from pathlib import Path
from types import SimpleNamespace

import pytest

HERE=Path(__file__).resolve().parent
Q=HERE/'qualification-complete110-r1'
spec=importlib.util.spec_from_file_location('q110_inert',Q/'qualification-wrapper.py')
q=importlib.util.module_from_spec(spec)
spec.loader.exec_module(q)


def environment():
    return {'SLURM_CPUS_PER_TASK':'4','SLURM_NTASKS':'1','SLURM_JOB_NUM_NODES':'1',
        'SLURM_MEM_PER_NODE':'16384','SLURM_JOB_ID':'999999'}


def configure(monkeypatch,env=None,cores=None):
    monkeypatch.setattr(q,'os',SimpleNamespace(environ=environment() if env is None else env,
        sched_getaffinity=lambda _:set(range(4)) if cores is None else cores))
    monkeypatch.setattr(q,'platform',SimpleNamespace(machine=lambda:'aarch64'))


def test_guard_valid_fixture_and_exclusive_deadline(monkeypatch):
    configure(monkeypatch)
    assert q.allocation_guard(now=q.DEADLINE-11401)['cpu_cores']==4
    with pytest.raises(ValueError):q.allocation_guard(now=q.DEADLINE-11400)


@pytest.mark.parametrize('key,value',[('SLURM_CPUS_PER_TASK','8'),('SLURM_MEM_PER_NODE','32768'),('SLURM_GPUS','1')])
def test_allocation_mutations_refused(monkeypatch,key,value):
    env=environment();env[key]=value;configure(monkeypatch,env)
    with pytest.raises(ValueError):q.allocation_guard(now=1)


def test_affinity_exact_four(monkeypatch):
    configure(monkeypatch,cores={0,1,2})
    with pytest.raises(ValueError):q.allocation_guard(now=1)


def test_safe_archive_refuses_link_and_traversal():
    for name,kind in [('x',tarfile.SYMTYPE),('../foreign',tarfile.REGTYPE)]:
        buffer=io.BytesIO()
        with tarfile.open(fileobj=buffer,mode='w') as t:
            member=tarfile.TarInfo(name);member.type=kind;t.addfile(member)
        buffer.seek(0)
        with tarfile.open(fileobj=buffer,mode='r') as t,pytest.raises(ValueError):q.safe_members(t)


def test_suite_timeout_preserves_rc124_without_retry(tmp_path,monkeypatch):
    configure(monkeypatch)
    calls=[]
    def failed(*args,**kwargs):
        calls.append((args,kwargs))
        kwargs['stdout'].write(b'NEUTRAL partial stdout')
        kwargs['stderr'].write(b'NEUTRAL partial stderr')
        raise q.subprocess.TimeoutExpired(args[0],kwargs['timeout'])
    monkeypatch.setattr(q.subprocess,'run',failed)
    with pytest.raises(q.subprocess.TimeoutExpired):
        q.run_suite('NEUTRAL',[tmp_path/'fake_test.py'],tmp_path,tmp_path,tmp_path,q.time.monotonic())
    assert len(calls)==1
    data=json.loads((tmp_path/'NEUTRAL-execution.json').read_text())
    assert data['returncode']==124 and data['run_count']==1 and data['stdout_stderr_preserved'] is True
    assert (tmp_path/'NEUTRAL-stdout.log').read_bytes()==b'NEUTRAL partial stdout'


def test_wrapper_guard_precedes_extraction_and_suite_calls():
    tree=ast.parse((Q/'qualification-wrapper.py').read_text())
    main=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='main')
    text=ast.unparse(main)
    assert text.index('allocation_guard()')<text.index('extract_new(')<text.index('run_suite(')
    assert '"passed": 26' in text or "'passed': 26" in text or '26' in text
    assert 'source_neutral_unique_count=187' in text
    assert 'adapter_neutral_unique_count=49' in text

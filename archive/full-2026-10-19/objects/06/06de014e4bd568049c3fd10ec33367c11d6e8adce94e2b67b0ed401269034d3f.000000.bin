#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <cstddef>

static long long maximum_horizontal_sum(const std::vector<long long>& columns, int s) {
    const int n = static_cast<int>(columns.size());
    long long sum = 0;
    for (int c = 0; c < s; ++c)
        sum += columns[c];

    long long best = sum;
    for (int c = s; c < n; ++c) {
        sum += columns[c] - columns[c - s];
        if (sum > best)
            best = sum;
    }
    return best;
}

int main() {
    int n, s;
    std::cin >> n >> s;

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    std::vector<int> history(static_cast<std::size_t>(s) * n);
    std::vector<long long> columns(n, 0);

    for (int r = 0; r < s; ++r) {
        int* row = history.data() + static_cast<std::size_t>(r) * n;
        for (int c = 0; c < n; ++c) {
            std::scanf("%d", &row[c]);
            columns[c] += static_cast<long long>(row[c]);
        }
    }

    long long maximum = maximum_horizontal_sum(columns, s);
    int slot = 0;
    for (int r = s; r < n; ++r) {
        int* row = history.data() + static_cast<std::size_t>(slot) * n;
        for (int c = 0; c < n; ++c) {
            const int exiting = row[c];
            std::scanf("%d", &row[c]);
            columns[c] += static_cast<long long>(row[c])
                        - static_cast<long long>(exiting);
        }

        const long long candidate = maximum_horizontal_sum(columns, s);
        if (candidate > maximum)
            maximum = candidate;

        ++slot;
        if (slot == s)
            slot = 0;
    }

    std::printf("%lld\n", maximum);
    return 0;
}

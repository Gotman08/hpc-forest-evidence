      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <limits>\n#include <memory>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#define SUM_USE_NEON 1\n#else\n#define SUM_USE_NEON 0\n#endif\n\nusing Sum = std::int64_t;\n\nclass FastInput {\n    unsigned char buffer_[1u << 16];\n    std::size_t position_ = 0;\n    std::size_t length_ = 0;\n\n    int get() {\n        if (position_ == length_) {\n            length_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (length_ == 0) return EOF;\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    bool readInt(int& result) {\n        int c;\n        do {\n            c = get();\n            if (c == EOF) return false;\n        } while (c <= ' ');\n        const bool negative = c == '-';\n        if (negative || c == '+') c = get();\n        Sum value = 0;\n        while (c >= '0' && c <= '9') {\n            value = value * 10 + (c - '0');\n            c = get();\n        }\n        result = static_cast<int>(negative ? -value : value);\n        return true;\n    }\n\n    int nextInt() {\n        int value = 0;\n        readInt(value);\n        return value;\n    }\n};\n\n#if SUM_USE_NEON\nstatic inline int64x2_t maxLanes(int64x2_t a, int64x2_t b) {\n    return vbslq_s64(vcgtq_s64(a, b), a, b);\n}\n#endif\n\nstruct Maximum {\n    Sum scalar = std::numeric_limits<Sum>::lowest();\n#if SUM_USE_NEON\n    int64x2_t first = vdupq_n_s64(std::numeric_limits<Sum>::lowest());\n    int64x2_t second = vdupq_n_s64(std::numeric_limits<Sum>::lowest());\n\n    void observePair(int64x2_t a, int64x2_t b) {\n        first = maxLanes(first, a);\n        second = maxLanes(second, b);\n    }\n#endif\n\n    void observe(Sum value) {\n        scalar = std::max(scalar, value);\n    }\n\n    Sum value() const {\n        Sum result = scalar;\n#if SUM_USE_NEON\n        const int64x2_t combined = maxLanes(first, second);\n        result = std::max(result, static_cast<Sum>(vgetq_lane_s64(combined, 0)));\n        result = std::max(result, static_cast<Sum>(vgetq_lane_s64(combined, 1)));\n#endif\n        return result;\n    }\n};\n\nstatic void readHorizontal(FastInput& input, int n, int s,\n                           int* window, Sum* result) {\n    Sum sum = 0;\n    for (int column = 0; column < s; ++column) {\n        const int value = input.nextInt();\n        window[column] = value;\n        sum += value;\n    }\n    result[0] = sum;\n    int oldest = 0;\n    const int width = n - s + 1;\n    for (int column = 1; column < width; ++column) {\n        const int value = input.nextInt();\n        sum += static_cast<Sum>(value) - window[oldest];\n        window[oldest] = value;\n        if (++oldest == s) oldest = 0;\n        result[column] = sum;\n    }\n}\n\ntemplate<bool Retain>\nstatic inline void updateVertical(const Sum* incoming, Sum* leaving,\n                                  Sum* totals, int width, Maximum& maximum) {\n    int column = 0;\n#if SUM_USE_NEON\n    for (; column + 4 <= width; column += 4) {\n        const int64x2_t incoming0 = vld1q_s64(incoming + column);\n        const int64x2_t incoming1 = vld1q_s64(incoming + column + 2);\n        const int64x2_t current0 = vaddq_s64(\n            vsubq_s64(vld1q_s64(totals + column),\n                      vld1q_s64(leaving + column)), incoming0);\n        const int64x2_t current1 = vaddq_s64(\n            vsubq_s64(vld1q_s64(totals + column + 2),\n                      vld1q_s64(leaving + column + 2)), incoming1);\n        vst1q_s64(totals + column, current0);\n        vst1q_s64(totals + column + 2, current1);\n        if (Retain) {\n            vst1q_s64(leaving + column, incoming0);\n            vst1q_s64(leaving + column + 2, incoming1);\n        }\n        maximum.observePair(current0, current1);\n    }\n#endif\n    for (; column < width; ++column) {\n        const Sum current = totals[column] - leaving[column] + incoming[column];\n        totals[column] = current;\n        if (Retain) leaving[column] = incoming[column];\n        maximum.observe(current);\n    }\n}\n\nstatic Sum solveStreaming(FastInput& input, int n, int s) {\n    const int width = n - s + 1;\n    const int departingRows = n - s;\n    const int depth = std::min(s, departingRows);\n    std::unique_ptr<int[]> window(new int[s]);\n    std::unique_ptr<Sum[]> incoming(new Sum[width]);\n    std::unique_ptr<Sum[]> totalStorage(new Sum[width]());\n    std::unique_ptr<Sum[]> history(\n        new Sum[static_cast<std::size_t>(depth) * width]);\n    Sum* const totals = totalStorage.get();\n\n    for (int row = 0; row < s; ++row) {\n        Sum* values = row < depth\n            ? history.get() + static_cast<std::size_t>(row) * width\n            : incoming.get();\n        readHorizontal(input, n, s, window.get(), values);\n#ifdef _OPENMP\n#pragma omp simd\n#endif\n        for (int column = 0; column < width; ++column) {\n            totals[column] += values[column];\n        }\n    }\n\n    Maximum maximum;\n    int column = 0;\n#if SUM_USE_NEON\n    for (; column + 4 <= width; column += 4) {\n        maximum.observePair(vld1q_s64(totals + column),\n                            vld1q_s64(totals + column + 2));\n    }\n#endif\n    for (; column < width; ++column) maximum.observe(totals[column]);\n\n    int slot = 0;\n    for (int row = s; row < n; ++row) {\n        readHorizontal(input, n, s, window.get(), incoming.get());\n        Sum* const leaving = history.get()\n            + static_cast<std::size_t>(slot) * width;\n        if (row < departingRows) {\n            updateVertical<true>(incoming.get(), leaving, totals, width, maximum);\n        } else {\n            updateVertical<false>(incoming.get(), leaving, totals, width, maximum);\n        }\n        if (++slot == depth) slot = 0;\n    }\n    return maximum.value();\n}\n\nstatic Sum solveBands(const int* matrix, int n, int s, int workers) {\n    const int windows = n - s + 1;\n    Sum best = std::numeric_limits<Sum>::lowest();\n#ifdef _OPENMP\n#pragma omp parallel num_threads(workers) if(workers > 1) reduction(max: best)\n#endif\n    {\n        int thread = 0;\n        int team = 1;\n#ifdef _OPENMP\n        thread = omp_get_thread_num();\n        team = omp_get_num_threads();\n#endif\n        const int begin = windows * thread / team;\n        const int end = windows * (thread + 1) / team;\n        if (begin < end) {\n            std::unique_ptr<Sum[]> storage(new Sum[n]());\n            Sum* const column = storage.get();\n            for (int r = begin; r < begin + s; ++r) {\n                const int* const row = matrix + static_cast<std::size_t>(r) * n;\n#ifdef _OPENMP\n#pragma omp simd\n#endif\n                for (int c = 0; c < n; ++c) column[c] += row[c];\n            }\n\n            Sum leading = 0;\n#ifdef _OPENMP\n#pragma omp simd reduction(+: leading)\n#endif\n            for (int c = 0; c < s; ++c) leading += column[c];\n\n            Sum localBest = std::numeric_limits<Sum>::lowest();\n            for (int r = begin; r < end; ++r) {\n                Sum current = leading;\n                localBest = std::max(localBest, current);\n                for (int c = s; c < n; ++c) {\n                    current += column[c] - column[c - s];\n                    localBest = std::max(localBest, current);\n                }\n                if (r + 1 < end) {\n                    const int* const exiting = matrix + static_cast<std::size_t>(r) * n;\n                    const int* const entering = matrix + static_cast<std::size_t>(r + s) * n;\n                    Sum change = 0;\n#ifdef _OPENMP\n#pragma omp simd reduction(+: change)\n#endif\n                    for (int c = 0; c < s; ++c) {\n                        const Sum delta = static_cast<Sum>(entering[c]) - exiting[c];\n                        column[c] += delta;\n                        change += delta;\n                    }\n#ifdef _OPENMP\n#pragma omp simd\n#endif\n                    for (int c = s; c < n; ++c) {\n                        column[c] += static_cast<Sum>(entering[c]) - exiting[c];\n                    }\n                    leading += change;\n                }\n            }\n            best = std::max(best, localBest);\n        }\n    }\n    return best;\n}\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.readInt(n) || !input.readInt(s)) return 0;\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t cells = static_cast<std::size_t>(n) * n;\n    int workers = 1;\n#ifdef _OPENMP\n    workers = std::min(4, omp_get_max_threads());\n#endif\n    workers = std::min(workers, n - s + 1);\n    if (cells < 65536u) workers = 1;\n\n    Sum best;\n    if (workers == 1 || s >= n - s) {\n        best = solveStreaming(input, n, s);\n    } else {\n        std::unique_ptr<int[]> matrix(new int[cells]);\n        for (std::size_t k = 0; k < cells; ++k) {\n            if (!input.readInt(matrix[k])) return 0;\n        }\n        best = solveBands(matrix.get(), n, s, workers);\n    }\n    std::printf(\"%lld\\n\", static_cast<long long>(best));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Combining reduced-history NEON streaming for large windows or serial execution with parallel row bands for wider outputs should reduce memory traffic without sacrificing useful four-core parallelism.",
  "notes": "Dispatch depends only on dimensions and available OpenMP threads. Uses 64-bit intermediates and scalar fallbacks. No commands or evaluations executed.",

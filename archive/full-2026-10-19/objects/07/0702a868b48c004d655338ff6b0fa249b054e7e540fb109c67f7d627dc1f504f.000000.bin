{
  "src/graph.c": "#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n\n/* Maximum size (in char) for neighbors and compute lists */\n#define MAX 100\n\ntypedef struct {\n  int id;\n  float value;\n  char neighbors[MAX];\n} Node;\n\ntypedef struct {\n  int id;\n  int index;\n} IdIndex;\n\n/* Reads input, allocates memory, writes graph size and node list. Returns the graph. */\nNode* read_input(char* fname, int *n, char* list) {\n  Node* data = NULL;\n  FILE *fl = NULL;\n\n  if (fname == NULL)\n    fl = stdin;\n  else\n    fl = fopen(fname, \"r\");\n\n  if (fl == NULL) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n\n  /* header */\n  fscanf(fl, \"%d %[^\n]\", n, list);\n\n  if (*n > 0) {\n    data = (Node*) malloc((*n) * sizeof(Node));\n    if(data == NULL){\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }\n  }\n\n  for(int i = 0; i < *n; i++) {\n    data[i].neighbors[0] = '\\0';\n    fscanf(fl, \"%d %f %[^\n]\", &data[i].id, &data[i].value, data[i].neighbors);\n  }\n\n  fclose(fl);\n  return data;\n}\n\nstatic int compare_id_index(const void *a, const void *b) {\n  const IdIndex *left = (const IdIndex *)a;\n  const IdIndex *right = (const IdIndex *)b;\n\n  if (left->id < right->id) return -1;\n  if (left->id > right->id) return 1;\n  if (left->index < right->index) return -1;\n  if (left->index > right->index) return 1;\n  return 0;\n}\n\n/* Returns the first index of the node with the given id or -1 if not found. */\nstatic int find_by_id(const IdIndex ids[], int id, int size) {\n  int low = 0;\n  int high = size;\n\n  while (low < high) {\n    int middle = low + (high - low) / 2;\n    if (ids[middle].id < id)\n      low = middle + 1;\n    else\n      high = middle;\n  }\n\n  if (low < size && ids[low].id == id)\n    return ids[low].index;\n  return -1;\n}\n\n/* Main program - preprocesses the chosen edges, then evaluates their DAG. */\nint main() {\n  char *fileN = NULL;\n  char computelist[MAX];\n  char query_text[MAX][MAX];\n  int query_ids[MAX];\n  int query_count = 0;\n  int n = -1;\n  Node* input = read_input(fileN, &n, computelist);\n\n  size_t allocation_count = n > 0 ? (size_t)n : 1;\n  IdIndex *ids = (IdIndex *)malloc(allocation_count * sizeof(*ids));\n  int *successor = (int *)malloc(allocation_count * sizeof(*successor));\n  int *reverse_head = (int *)malloc(allocation_count * sizeof(*reverse_head));\n  int *reverse_next = (int *)malloc(allocation_count * sizeof(*reverse_next));\n  int *queue = (int *)malloc(allocation_count * sizeof(*queue));\n  float *cost = (float *)malloc(allocation_count * sizeof(*cost));\n\n  if (ids == NULL || successor == NULL || reverse_head == NULL ||\n      reverse_next == NULL || queue == NULL || cost == NULL) {\n    fprintf(stderr, \"Error!\\n\");\n    free(input);\n    free(ids);\n    free(successor);\n    free(reverse_head);\n    free(reverse_next);\n    free(queue);\n    free(cost);\n    return 1;\n  }\n\n  for (int i = 0; i < n; i++) {\n    ids[i].id = input[i].id;\n    ids[i].index = i;\n  }\n  if (n > 1)\n    qsort(ids, (size_t)n, sizeof(*ids), compare_id_index);\n\n  /* Each row is independent; static chunks avoid per-row scheduling overhead. */\n  #pragma omp parallel for schedule(static) if (n >= 128)\n  for (int i = 0; i < n; i++) {\n    char aux[MAX];\n    char *saveptr = NULL;\n    char *token;\n    int selected = -1;\n    float best = 0.0f;\n\n    strcpy(aux, input[i].neighbors);\n    token = strtok_r(aux, \" \", &saveptr);\n    while (token != NULL) {\n      int neighbor = find_by_id(ids, atoi(token), n);\n      if (neighbor >= 0 && best < input[neighbor].value) {\n        best = input[neighbor].value;\n        selected = neighbor;\n      }\n      token = strtok_r(NULL, \" \", &saveptr);\n    }\n    successor[i] = selected;\n  }\n\n  /* Reverse the selected edges so each node is evaluated after its successor. */\n  for (int i = 0; i < n; i++)\n    reverse_head[i] = -1;\n  for (int i = 0; i < n; i++) {\n    reverse_next[i] = -1;\n    if (successor[i] >= 0) {\n      reverse_next[i] = reverse_head[successor[i]];\n      reverse_head[successor[i]] = i;\n    }\n  }\n\n  int queue_begin = 0;\n  int queue_end = 0;\n  for (int i = 0; i < n; i++) {\n    if (successor[i] < 0) {\n      cost[i] = input[i].value;\n      queue[queue_end++] = i;\n    }\n  }\n\n  while (queue_begin < queue_end) {\n    int node = queue[queue_begin++];\n    for (int parent = reverse_head[node]; parent >= 0;\n         parent = reverse_next[parent]) {\n      cost[parent] = input[parent].value + cost[node];\n      queue[queue_end++] = parent;\n    }\n  }\n\n  for (char *token = strtok(computelist, \" \"); token != NULL;\n       token = strtok(NULL, \" \")) {\n    if (query_count < MAX) {\n      strcpy(query_text[query_count], token);\n      query_ids[query_count] = atoi(token);\n      query_count++;\n    }\n  }\n\n  for (int i = 0; i < query_count; i++) {\n    int index = find_by_id(ids, query_ids[i], n);\n    float result = index >= 0 ? cost[index] : 0.0f;\n    printf(\"%s: %f\\n\", query_text[i], result);\n  }\n\n  free(input);\n  free(ids);\n  free(successor);\n  free(reverse_head);\n  free(reverse_next);\n  free(queue);\n  free(cost);\n  return 0;\n}\n"
}

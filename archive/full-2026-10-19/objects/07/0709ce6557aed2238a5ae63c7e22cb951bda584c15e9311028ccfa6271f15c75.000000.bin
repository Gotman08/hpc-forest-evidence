{
  "src/solution.cpp": "#include <algorithm>\n#include <iostream>\n#include <utility>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<pair<int, int>> blocked;\n    blocked.reserve(static_cast<size_t>(m));\n    for (int i = 0; i < m; ++i) {\n        int row, column;\n        cin >> row >> column;\n        blocked.emplace_back(row + column, row);\n    }\n    sort(blocked.begin(), blocked.end());\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\n\n    vector<int> previous(n, 0);\n    vector<int> current(n, 0);\n    size_t blockedIndex = 0;\n\n    auto updateFreeRange = [&](int begin, int end, int diagonal) {\n        if (begin < end && begin == 0) {\n            current[0] = previous[0];\n            ++begin;\n        }\n\n        int vectorBegin = max(begin, 1);\n        int vectorEnd = min(end, diagonal);\n        // Rows in this span read only the previous diagonal and write distinct cells.\n        #pragma GCC ivdep\n        for (int row = vectorBegin; row < vectorEnd; ++row) {\n            int sum = previous[row] + previous[row - 1];\n            if (sum >= MOD) sum -= MOD;\n            current[row] = sum;\n        }\n\n        if (diagonal < n && begin <= diagonal && diagonal < end) {\n            current[diagonal] = previous[diagonal - 1];\n        }\n    };\n\n    for (int diagonal = 0; diagonal <= 2 * n - 2; ++diagonal) {\n        while (blockedIndex < blocked.size() && blocked[blockedIndex].first < diagonal) {\n            ++blockedIndex;\n        }\n\n        if (diagonal == 0) {\n            if (blockedIndex < blocked.size() && blocked[blockedIndex].first == 0) {\n                current[0] = 0;\n                ++blockedIndex;\n            } else {\n                current[0] = 1;\n            }\n            previous.swap(current);\n            continue;\n        }\n\n        int lowRow = max(0, diagonal - (n - 1));\n        int highRow = min(n - 1, diagonal);\n        int rowCursor = lowRow;\n\n        while (blockedIndex < blocked.size() && blocked[blockedIndex].first == diagonal) {\n            int blockedRow = blocked[blockedIndex].second;\n            updateFreeRange(rowCursor, blockedRow, diagonal);\n            current[blockedRow] = 0;\n            rowCursor = blockedRow + 1;\n            ++blockedIndex;\n        }\n        updateFreeRange(rowCursor, highRow + 1, diagonal);\n\n        previous.swap(current);\n    }\n\n    cout << previous[n - 1] << '\\n';\n    return 0;\n}\n"
}

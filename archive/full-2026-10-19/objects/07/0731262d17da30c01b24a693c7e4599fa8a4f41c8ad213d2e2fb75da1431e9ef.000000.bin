{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n#define TILE 64\n\n/*\n * Read a binary dataset with initialized bodies into structure-of-arrays.\n */\nvoid read_soa(int *nbodies, float **px, float **py, float **pz,\n              float **vx, float **vy, float **vz) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr, \"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  int n = *nbodies;\n\n  float *raw = (float *)malloc(n * 6 * sizeof(float));\n  if (!raw) {\n    fprintf(stderr, \"\\nMemory allocation failed\\n\");\n    exit(EXIT_FAILURE);\n  }\n  b = fread(raw, n * 6 * sizeof(float), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr, \"\\nError reading input values\\n\");\n    free(raw);\n    exit(EXIT_FAILURE);\n  }\n\n  *px = (float *)malloc(n * sizeof(float));\n  *py = (float *)malloc(n * sizeof(float));\n  *pz = (float *)malloc(n * sizeof(float));\n  *vx = (float *)malloc(n * sizeof(float));\n  *vy = (float *)malloc(n * sizeof(float));\n  *vz = (float *)malloc(n * sizeof(float));\n\n  if (!*px || !*py || !*pz || !*vx || !*vy || !*vz) {\n    fprintf(stderr, \"\\nMemory allocation failed\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  for (int i = 0; i < n; ++i) {\n    (*px)[i] = raw[6 * i];\n    (*py)[i] = raw[6 * i + 1];\n    (*pz)[i] = raw[6 * i + 2];\n    (*vx)[i] = raw[6 * i + 3];\n    (*vy)[i] = raw[6 * i + 4];\n    (*vz)[i] = raw[6 * i + 5];\n  }\n\n  free(raw);\n}\n\n/*\n * Write simulation results from structure-of-arrays into a binary dataset.\n */\nvoid write_soa(const int nbodies, const float *px, const float *py,\n               const float *pz, const float *vx, const float *vy,\n               const float *vz) {\n  float *raw = (float *)malloc(nbodies * 6 * sizeof(float));\n  if (!raw) {\n    fprintf(stderr, \"\\nMemory allocation failed\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  for (int i = 0; i < nbodies; ++i) {\n    raw[6 * i]     = px[i];\n    raw[6 * i + 1] = py[i];\n    raw[6 * i + 2] = pz[i];\n    raw[6 * i + 3] = vx[i];\n    raw[6 * i + 4] = vy[i];\n    raw[6 * i + 5] = vz[i];\n  }\n\n  int b = fwrite(raw, nbodies * 6 * sizeof(float), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr, \"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  free(raw);\n}\n\n/*\n * Compute the gravitational impact among all pairs of bodies.\n * Uses structure-of-arrays layout and cache blocking over i with OpenMP.\n */\nvoid body_force(const float *restrict px, const float *restrict py,\n                const float *restrict pz, float *restrict vx,\n                float *restrict vy, float *restrict vz, float dt, int n) {\n  #pragma omp parallel for schedule(static)\n  for (int ib = 0; ib < n; ib += TILE) {\n    int iend = ib + TILE < n ? ib + TILE : n;\n\n    float fx[TILE] __attribute__((aligned(64)));\n    float fy[TILE] __attribute__((aligned(64)));\n    float fz[TILE] __attribute__((aligned(64)));\n\n    for (int i = 0; i < iend - ib; ++i) {\n      fx[i] = 0.0f;\n      fy[i] = 0.0f;\n      fz[i] = 0.0f;\n    }\n\n    // Outer loop over j: each body's position is read once per tile.\n    for (int j = 0; j < n; ++j) {\n      float xj = px[j];\n      float yj = py[j];\n      float zj = pz[j];\n\n      #pragma omp simd\n      for (int i = ib; i < iend; ++i) {\n        int idx = i - ib;\n        float dx = xj - px[i];\n        float dy = yj - py[i];\n        float dz = zj - pz[i];\n\n        float sqrd_dist = dx * dx + dy * dy + dz * dz + SOFTENING;\n        float inv_dist  = 1.0f / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx[idx] += dx * inv_dist3;\n        fy[idx] += dy * inv_dist3;\n        fz[idx] += dz * inv_dist3;\n      }\n    }\n\n    // Update velocities for this tile.\n    for (int i = ib; i < iend; ++i) {\n      int idx = i - ib;\n      vx[i] += dt * fx[idx];\n      vy[i] += dt * fy[idx];\n      vz[i] += dt * fz[idx];\n    }\n  }\n}\n\nint main(int argc, char **argv) {\n  int nbodies;\n  float *px, *py, *pz, *vx, *vy, *vz;\n\n  read_soa(&nbodies, &px, &py, &pz, &vx, &vy, &vz);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    body_force(px, py, pz, vx, vy, vz, DT, nbodies);\n\n    for (int i = 0; i < nbodies; ++i) {\n      px[i] += vx[i] * DT;\n      py[i] += vy[i] * DT;\n      pz[i] += vz[i] * DT;\n    }\n  }\n\n  write_soa(nbodies, px, py, pz, vx, vy, vz);\n\n  free(px); free(py); free(pz);\n  free(vx); free(vy); free(vz);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Combining a structure-of-arrays (SoA) layout with cache blocking over the i-loop and OpenMP parallelization over tiles reduces main-memory traffic from O(N^2) to O(N^2/TILE). By iterating j in the outer loop of each tile, every body's position is read once per tile instead of once per (i,j) pair, while preserving the exact sequential j-summation order for each body. This improves memory locality beyond previous SoA+OpenMP versions and should outperform them.",
  "notes": "The code uses a fixed TILE=64 to avoid variable-length arrays. The inner i-loop is marked with #pragma omp simd; vectorization across independent accumulators does not change per-body summation order because the j-loop remains sequential. Input/output are converted between SoA and the required interleaved binary format once per run, adding negligible overhead.",
  "sources_kept": [],
  "transformations": [
    "Changed data layout from array-of-structs to structure-of-arrays (SoA) for positions and velocities",
    "Added cache blocking over the i-loop with TILE=64",
    "Reordered loops: j outer, i inner within each tile so that body j's position is read once per tile",
    "Parallelized the tile loop with OpenMP static scheduling",
    "Used restrict pointers to aid compiler optimization"
  ]
}

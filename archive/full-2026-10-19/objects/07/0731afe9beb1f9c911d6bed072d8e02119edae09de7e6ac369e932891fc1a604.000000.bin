#include <iostream>
#include <vector>
#include <cstdio>
#include <climits>

// Fast integer reading using getchar_unlocked (thread-unsafe but fast)
static inline int read_int() {
    int x = 0;
    char c = getchar_unlocked();
    while (c <= ' ') c = getchar_unlocked(); // skip whitespace
    bool neg = false;
    if (c == '-') { neg = true; c = getchar_unlocked(); }
    do {
        x = x * 10 + (c - '0');
        c = getchar_unlocked();
    } while (c > ' ');
    return neg ? -x : x;
}

int main() {
    int n = read_int();
    int s = read_int();

    const int stride = n + 1; // extra row/col of zeros
    std::vector<long long> pref(stride * stride, 0LL);

    // Single-pass construction: read matrix and build integral image using previous row prefix sums
    for (int i = 0; i < n; ++i) {
        long long row_sum = 0;
        const int base_cur = (i + 1) * stride;
        const int base_prev = i * stride;
        #pragma ivdep
        for (int j = 0; j < n; ++j) {
            int val = read_int();
            row_sum += val;
            pref[base_cur + (j + 1)] = pref[base_prev + (j + 1)] + row_sum;
        }
    }

    long long mxSum = LLONG_MIN;
    const int jmax = n - s;

    // Parallel search over rows with reduction, using restrict pointers and ivdep for auto-vectorization
    #pragma omp parallel for reduction(max:mxSum) schedule(static)
    for (int i = 0; i <= n - s; ++i) {
        const long long * __restrict__ row_i   = &pref[i * stride];
        const long long * __restrict__ row_is  = &pref[(i + s) * stride];
        #pragma ivdep
        for (int j = 0; j <= jmax; ++j) {
            long long sum = row_is[j + s] - row_i[j + s]
                          - row_is[j] + row_i[j];
            if (sum > mxSum) mxSum = sum;
        }
    }

    printf("%d\n", static_cast<int>(mxSum));
    return 0;
}

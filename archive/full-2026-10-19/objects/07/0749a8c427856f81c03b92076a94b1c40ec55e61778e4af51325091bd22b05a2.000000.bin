#include <bits/stdc++.h>

using namespace std;

int A[1000][1000];
int ps[1010][1010];

typedef long long ll;

ll solve(int m, int n, int k) {
  const ll pair_count = (ll)n * (n + 1) / 2;
  const ll row_work = pair_count * m;
  const ll pairs_per_block = max(1LL, min(64LL, 4096LL / m));
  const ll block_count = (pair_count + pairs_per_block - 1) / pairs_per_block;
  ll ans = 0;

#pragma omp parallel if(row_work >= 65536) reduction(+:ans)
  {
#pragma omp for schedule(static)
    for (int i = 1; i <= m; i++) {
      for (int j = 1; j <= n; j++) {
        ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];
      }
    }

    unordered_map<ll, ll> h;
#pragma omp for schedule(dynamic, 1)
    for (ll block = 0; block < block_count; block++) {
      const ll first = block * pairs_per_block;
      const ll last = min(pair_count, first + pairs_per_block);

      int lo = 1;
      int hi = n;
      while (lo < hi) {
        const int mid = lo + (hi - lo + 1) / 2;
        const ll before = (ll)(mid - 1) * (2LL * n - mid + 2) / 2;
        if (before <= first)
          lo = mid;
        else
          hi = mid - 1;
      }
      int j = lo;
      const ll before = (ll)(j - 1) * (2LL * n - j + 2) / 2;
      int l = j + (int)(first - before);

      for (ll p = first; p < last; p++) {
        h.clear();
        h[0] = 1;
        ll s = 0;
        for (int i = 1; i <= m; i++) {
          s += ps[i][l] - ps[i][j - 1];
          ans += h.find(s - k) != h.end() ? h[s - k] : 0;
          h[s]++;
        }
        if (++l > n) {
          ++j;
          l = j;
        }
      }
    }
  }
  return ans;
}

int main() {
  int k, m, n;
  cin >> k >> m >> n;
  memset(A, 0, sizeof A);
  memset(ps, 0, sizeof ps);

  for (int i = 0; i < m; i++)
    for (int j = 0; j < n; j++)
      cin >> A[i][j];

  cout << solve(m, n, k) << endl;
  return 0;
}

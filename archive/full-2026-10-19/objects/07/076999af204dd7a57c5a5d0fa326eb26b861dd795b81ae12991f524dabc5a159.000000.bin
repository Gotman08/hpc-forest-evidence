      "content": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <utility>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<size_t> rowOffsets(static_cast<size_t>(n) + 1, 0);\n    vector<int> blockedColumns(static_cast<size_t>(m));\n\n    {\n        vector<pair<int, int> > input;\n        input.reserve(static_cast<size_t>(m));\n        for (int c = 0; c < m; ++c) {\n            int row, col;\n            cin >> row >> col;\n            input.emplace_back(row, col);\n            ++rowOffsets[row + 1];\n        }\n\n        for (int row = 0; row < n; ++row) {\n            rowOffsets[row + 1] += rowOffsets[row];\n        }\n\n        vector<size_t> next(rowOffsets.begin(), rowOffsets.end() - 1);\n        for (const auto& cell : input) {\n            blockedColumns[next[cell.first]++] = cell.second;\n        }\n    }\n\n    vector<int> dp(n, 0);\n    dp[0] = 1;\n\n    for (int row = 0; row < n; ++row) {\n        auto first = blockedColumns.begin() + rowOffsets[row];\n        auto last = blockedColumns.begin() + rowOffsets[row + 1];\n        sort(first, last);\n        last = unique(first, last);\n\n        int begin = 0;\n        int left = 0;\n        for (auto it = first; it != last; ++it) {\n            const int stop = *it;\n            for (int col = begin; col < stop; ++col) {\n                left += dp[col];\n                if (left >= MOD) left -= MOD;\n                dp[col] = left;\n            }\n            dp[stop] = 0;\n            left = 0;\n            begin = stop + 1;\n        }\n\n        for (int col = begin; col < n; ++col) {\n            left += dp[col];\n            if (left >= MOD) left -= MOD;\n            dp[col] = left;\n        }\n    }\n\n    cout << dp[n - 1] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Contiguous row-indexed obstacles and one in-place DP row should improve locality and reduce memory traffic by eliminating the quadratic bitmap, per-cell obstacle lookups, and row copies.",

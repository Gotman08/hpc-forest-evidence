#include <cstdio>
#include <vector>
#include <algorithm>
#include <climits>

class FastScanner {
    static constexpr int BUFSIZE = 1 << 20;
    char buf[BUFSIZE];
    char* cur;
    char* end;

    bool refill() {
        size_t r = fread(buf, 1, BUFSIZE, stdin);
        cur = buf;
        end = buf + r;
        return r > 0;
    }

public:
    FastScanner() : cur(buf), end(buf) {}

    inline int nextInt() {
        while (true) {
            if (cur == end && !refill()) return 0;
            char c = *cur++;
            if (c <= ' ') continue;

            int sign = 1;
            if (c == '-') {
                sign = -1;
                if (cur == end && !refill()) return 0;
                c = *cur++;
            }

            int x = c - '0';
            while (true) {
                if (cur == end && !refill()) break;
                char d = *cur++;
                if (d < '0' || d > '9') break;
                x = x * 10 + (d - '0');
            }
            return sign * x;
        }
    }
};

int main() {
    FastScanner fs;
    int n = fs.nextInt();
    int s = fs.nextInt();

    const size_t N = static_cast<size_t>(n);
    std::vector<long long> pref((N + 1) * N, 0);

    for (size_t i = 1; i <= N; ++i) {
        const size_t base = i * N;
        const size_t prev = (i - 1) * N;
        for (size_t j = 0; j < N; ++j) {
            int v = fs.nextInt();
            pref[base + j] = pref[prev + j] + v;
        }
    }

    long long mxSum = LLONG_MIN;
    const size_t limit_i = N - static_cast<size_t>(s);

    #pragma omp parallel for reduction(max:mxSum) schedule(static)
    for (size_t i = 0; i <= limit_i; ++i) {
        const long long* top = &pref[i * N];
        const long long* bottom = &pref[(i + s) * N];

        long long window = 0;
        #pragma omp simd reduction(+:window)
        for (size_t j = 0; j < static_cast<size_t>(s); ++j) {
            window += bottom[j] - top[j];
        }
        long long curMax = window;

        size_t j = static_cast<size_t>(s);
        for (; j + 3 < N; j += 4) {
            window += (bottom[j] - top[j]) - (bottom[j - s] - top[j - s]);
            if (window > curMax) curMax = window;
            window += (bottom[j+1] - top[j+1]) - (bottom[j+1-s] - top[j+1-s]);
            if (window > curMax) curMax = window;
            window += (bottom[j+2] - top[j+2]) - (bottom[j+2-s] - top[j+2-s]);
            if (window > curMax) curMax = window;
            window += (bottom[j+3] - top[j+3]) - (bottom[j+3-s] - top[j+3-s]);
            if (window > curMax) curMax = window;
        }
        for (; j < N; ++j) {
            window += (bottom[j] - top[j]) - (bottom[j - s] - top[j - s]);
            if (window > curMax) curMax = window;
        }

        mxSum = std::max(mxSum, curMax);
    }

    printf("%lld\n", mxSum);
    return 0;
}

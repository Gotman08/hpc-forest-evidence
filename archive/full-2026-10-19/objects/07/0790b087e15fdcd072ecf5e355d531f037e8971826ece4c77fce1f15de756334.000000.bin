        "content": "#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n#include<stddef.h>\n#include<stdint.h>\n\n/* Maximum size (in char) for neighbors and compute lists */\n#define MAX 100\n\ntypedef struct {\n  int id;\n  float value;\n  char neighbors[MAX];\n} Node;\n\ntypedef struct {\n  int key;\n  int index;\n} IdSlot;\n\ntypedef struct {\n  IdSlot *slots;\n  size_t capacity;\n} IdIndex;\n\n/* Reads input, allocates memory, writes graph size and node list. Returns the graph. */\nNode* read_input(char* fname, int *n, char* list) {\n  Node* data = NULL;\n  FILE *fl = NULL;\n\n  if (fname == NULL)\n    fl = stdin;\n  else\n    fl = fopen(fname, \"r\");\n\n  if (fl == NULL) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n\n  /* Keep the scanset on the current line; the leading space belongs to the list. */\n  list[0] = '\\0';\n  fscanf(fl, \"%d%99[^\\n]\", n, list);\n\n  if (*n > 0) {\n    data = (Node*) malloc ((*n)*sizeof(Node));\n    if(data == NULL){\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }\n  }\n\n  for(int i = 0; i < *n; i++) {\n    data[i].neighbors[0] = '\\0';\n    fscanf(fl, \"%d %f%99[^\\n]\", &data[i].id, &data[i].value, data[i].neighbors);\n  }\n\n  fclose(fl);\n  return data;\n}\n\n/* Mix an integer ID before masking it into the power-of-two table. */\nstatic size_t hash_id(int id) {\n  uint32_t x = (uint32_t)id;\n  x ^= x >> 16;\n  x *= UINT32_C(0x7feb352d);\n  x ^= x >> 15;\n  x *= UINT32_C(0x846ca68b);\n  x ^= x >> 16;\n  return (size_t)x;\n}\n\n/* Build an open-addressed index; retaining the first occurrence matches the old scan. */\nstatic void build_id_index(IdIndex *index, const Node *g, int size) {\n  index->slots = NULL;\n  index->capacity = 0;\n\n  if (size <= 0)\n    return;\n\n  size_t max_size = (size_t)-1;\n  size_t count = (size_t)size;\n  if (count > max_size / 2) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n  size_t needed = count * 2;\n  size_t capacity = 1;\n  while (capacity < needed) {\n    if (capacity > max_size / 2) {\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }\n    capacity *= 2;\n  }\n  if (capacity > max_size / sizeof(IdSlot)) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n\n  index->slots = (IdSlot*)malloc(capacity * sizeof(IdSlot));\n  if (index->slots == NULL) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n  index->capacity = capacity;\n\n  for (size_t i = 0; i < capacity; i++)\n    index->slots[i].index = -1;\n\n  size_t mask = capacity - 1;\n  for (int i = 0; i < size; i++) {\n    size_t slot = hash_id(g[i].id) & mask;\n    while (index->slots[slot].index != -1 && index->slots[slot].key != g[i].id)\n      slot = (slot + 1) & mask;\n    if (index->slots[slot].index == -1) {\n      index->slots[slot].key = g[i].id;\n      index->slots[slot].index = i;\n    }\n  }\n}\n\n/* Returns the first index of the node with the given ID, or -1 if absent. */\nstatic int find_by_id(const IdIndex *index, int id) {\n  if (index->capacity == 0)\n    return -1;\n\n  size_t mask = index->capacity - 1;\n  size_t slot = hash_id(id) & mask;\n  while (index->slots[slot].index != -1) {\n    if (index->slots[slot].key == id)\n      return index->slots[slot].index;\n    slot = (slot + 1) & mask;\n  }\n  return -1;\n}\n\n/* Computes the sum for the node with the given id */\nfloat get_costly(Node *g, int id, const IdIndex *index) {\n  char *t;\n  int idmax = -1;\n  float max = 0;\n  char *auxptr;\n\n  int nd = find_by_id(index, id);\n  if(nd < 0)\n    return max;\n\n  char aux[MAX];\n  strcpy(aux, g[nd].neighbors);\n  t = strtok_r(aux, \" \", &auxptr);\n\n  while (t != NULL) {\n    int neighbor_id = atoi(t);\n    int d = find_by_id(index, neighbor_id);\n    if (d >= 0 && max < g[d].value) {\n      max = g[d].value;\n      idmax = neighbor_id;\n    }\n    t = strtok_r(NULL, \" \", &auxptr);\n  }\n\n  float r = g[nd].value;\n\n  if(idmax != -1)\n    r += get_costly(g, idmax, index);\n\n  return (r);\n}\n\n/* Main program - calls read input, computes sum for each node in the list, prints output */\nint main() {\n  char *fileN = NULL;\n  char computelist[MAX];\n  int n = -1;\n  Node* input = NULL;\n\n  input = read_input(fileN, &n, computelist);\n  IdIndex index;\n  build_id_index(&index, input, n);\n\n  // process\n  for(char *c = strtok(computelist, \" \"); c != NULL; c = strtok(NULL, \" \"))\n    printf(\"%s: %f\\n\", c, get_costly(input, atoi(c), &index));\n\n  free(index.slots);\n  free(input);\n  return 0;\n}\n",
        "path": "src/graph.c"
      }
    ],

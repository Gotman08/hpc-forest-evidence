#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors
#define TARGET_TILE 8

/*
 * Each body holds coordinate positions (i.e., x, y, and z) and
 * velocities (i.e., vx, vy, and vz).
 */
typedef struct { float x, y, z, vx, vy, vz; } Body;

/* Allocation-free fallback with the original accumulation order. */
static void body_force_direct(Body *p, float dt, int n) {
  for (int i = 0; i < n; ++i) {
    float fx = 0.0f;
    float fy = 0.0f;
    float fz = 0.0f;

    for (int j = 0; j < n; j++) {
      float dx = p[j].x - p[i].x;
      float dy = p[j].y - p[i].y;
      float dz = p[j].z - p[i].z;
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1 / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    p[i].vx += dt*fx;
    p[i].vy += dt*fy;
    p[i].vz += dt*fz;
  }
}

/*
 * Stream compact source positions across independent target lanes.
 * Each lane still accumulates sources in ascending j order.
 */
void body_force(Body *p, float dt, int n) {
  if (n <= 0) {
    return;
  }

  if ((size_t)n > (size_t)-1 / (3 * sizeof(float))) {
    body_force_direct(p, dt, n);
    return;
  }

  float *positions = (float *)malloc((size_t)n * 3 * sizeof(float));
  if (positions == NULL) {
    body_force_direct(p, dt, n);
    return;
  }

  float * restrict x = positions;
  float * restrict y = positions + (size_t)n;
  float * restrict z = positions + 2 * (size_t)n;

  for (int i = 0; i < n; ++i) {
    x[i] = p[i].x;
    y[i] = p[i].y;
    z[i] = p[i].z;
  }

  const int blocks = n / TARGET_TILE;

#ifdef _OPENMP
#pragma omp parallel for schedule(static)
#endif
  for (int block = 0; block < blocks; ++block) {
    const int first = block * TARGET_TILE;
    float tx[TARGET_TILE], ty[TARGET_TILE], tz[TARGET_TILE];
    float fx[TARGET_TILE] = {0.0f};
    float fy[TARGET_TILE] = {0.0f};
    float fz[TARGET_TILE] = {0.0f};

    for (int lane = 0; lane < TARGET_TILE; ++lane) {
      tx[lane] = x[first + lane];
      ty[lane] = y[first + lane];
      tz[lane] = z[first + lane];
    }

    for (int j = 0; j < n; ++j) {
      const float sx = x[j];
      const float sy = y[j];
      const float sz = z[j];

#if defined(_OPENMP) && _OPENMP >= 201307
#pragma omp simd simdlen(4)
#endif
      for (int lane = 0; lane < TARGET_TILE; ++lane) {
        float dx = sx - tx[lane];
        float dy = sy - ty[lane];
        float dz = sz - tz[lane];
        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
        float inv_dist = 1 / sqrt(sqrd_dist);
        float inv_dist3 = inv_dist * inv_dist * inv_dist;

        fx[lane] += dx * inv_dist3;
        fy[lane] += dy * inv_dist3;
        fz[lane] += dz * inv_dist3;
      }
    }

    for (int lane = 0; lane < TARGET_TILE; ++lane) {
      p[first + lane].vx += dt*fx[lane];
      p[first + lane].vy += dt*fy[lane];
      p[first + lane].vz += dt*fz[lane];
    }
  }

  for (int i = blocks * TARGET_TILE; i < n; ++i) {
    const float tx = x[i];
    const float ty = y[i];
    const float tz = z[i];
    float fx = 0.0f;
    float fy = 0.0f;
    float fz = 0.0f;

    for (int j = 0; j < n; ++j) {
      float dx = x[j] - tx;
      float dy = y[j] - ty;
      float dz = z[j] - tz;
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1 / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    p[i].vx += dt*fx;
    p[i].vy += dt*fy;
    p[i].vz += dt*fz;
  }

  free(positions);
}

/*
 * Read a binary dataset with initilized bodies.
 */
Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  return bodies;
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc,char **argv) {
  int nbodies;

  Body *bodies = read_dataset(&nbodies);

  /*
   * At each simulation iteration, interbody forces are computed,
   * and bodies' positions are integrated.
   */
  for (int iter = 0; iter < N_ITER; iter++) {
    body_force(bodies, DT, nbodies);

    for (int i = 0; i < nbodies; i++) {
      bodies[i].x += bodies[i].vx * DT;
      bodies[i].y += bodies[i].vy * DT;
      bodies[i].z += bodies[i].vz * DT;
    }
  }

  write_dataset(nbodies, bodies);

  free(bodies);

  exit(EXIT_SUCCESS);
}

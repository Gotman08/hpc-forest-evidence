(prefix2, lower_total);\\n        prefix3 = vaddq_s64(prefix3, lower_total);\\n\\n        prefix0 = vaddq_s64(prefix0, carry);\\n        prefix1 = vaddq_s64(prefix1, carry);\\n        prefix2 = vaddq_s64(prefix2, carry);\\n        prefix3 = vaddq_s64(prefix3, carry);\\n        carry = vdupq_laneq_s64(prefix3, 1);\\n\\n        maximum0 = maximum_i64(maximum0, prefix0);\\n        maximum1 = maximum_i64(maximum1, prefix1);\\n        maximum2 = maximum_i64(maximum2, prefix2);\\n        maximum3 = maximum_i64(maximum3, prefix3);\\n    }\\n\\n    const int64x2_t maxima = maximum_i64(\\n        maximum_i64(maximum0, maximum1),\\n        maximum_i64(maximum2, maximum3));\\n    const std::int64_t lane0 = vgetq_lane_s64(maxima, 0);\\n    const std::int64_t lane1 = vgetq_lane_s64(maxima, 1);\\n    maximum = lane0 > lane1 ? lane0 : lane1;\\n    window = vgetq_lane_s64(carry, 0);\\n#endif\\n\\n    for (; col < n; ++col) {\\n        window += columns[col] - columns[col - s];\\n        if (window > maximum) maximum = window;\\n    }\\n    return maximum;\\n}\\n\\nint main() {\\n    int n, s;\\n    if (!(std::cin >> n >> s)) return 0;\\n\\n    assert(s < n);\\n    assert(n < 8000);\\n    assert(s > 0);\\n    assert(n > 0);\\n\\n    std::vector<int> matrix(static_cast<std::size_t>(n) * n);\\n    for (std::size_t index = 0; index < matrix.size(); ++index) {\\n        std::scanf(\\\"%d\\\", &matrix[index]);\\n    }\\n\\n    std::vector<std::int64_t> column_sums(n, 0);\\n    std::int64_t* const columns = column_sums.data();\\n\\n    for (int row = 0; row < s; ++row) {\\n        const int* const values = matrix.data()\\n            + static_cast<std::size_t>(row) * n;\\n#if defined(__GNUC__)\\n#pragma GCC ivdep\\n#endif\\n        for (int col = 0; col < n; ++col) {\\n            columns[col] += static_cast<std::int64_t>(values[col]);\\n        }\\n    }\\n\\n    std::int64_t first_sum = 0;\\n#if defined(_OPENMP) && _OPENMP >= 201307\\n#pragma omp simd reduction(+:first_sum)\\n#endif\\n    for (int col = 0; col < s; ++col) {\\n        first_sum += columns[col];\\n    }\\n\\n    std::int64_t maximum = horizontal_maximum(columns, n, s, first_sum);\\n    const int last_top = n - s;\\n    for (int top = 1; top <= last_top; ++top) {\\n        const int* const incoming = matrix.data()\\n            + static_cast<std::size_t>(top + s - 1) * n;\\n        const int* const outgoing = matrix.data()\\n            + static_cast<std::size_t>(top - 1) * n;\\n\\n        std::int64_t first_change = 0;\\n#if defined(_OPENMP) && _OPENMP >= 201307\\n#pragma omp simd reduction(+:first_change)\\n#endif\\n        for (int col = 0; col < s; ++col) {\\n            const std::int64_t change = static_cast<std::int64_t>(incoming[col])\\n                - static_cast<std::int64_t>(outgoing[col]);\\n            columns[col] += change;\\n            first_change += change;\\n        }\\n#if defined(__GNUC__)\\n#pragma GCC ivdep\\n#endif\\n        for (int col = s; col < n; ++col) {\\n            columns[col] += static_cast<std::int64_t>(incoming[col])\\n                - static_cast<std::int64_t>(outgoing[col]);\\n        }\\n        first_sum += first_change;\\n\\n        const std::int64_t row_maximum = horizontal_maximum(columns, n, s, first_sum);\\n        if (row_maximum > maximum) maximum = row_maximum;\\n    }\\n\\n    std::printf(\\\"%lld\\\\n\\\", static_cast<long long>(maximum));\\n    return 0;\\n}\\n\",\n      \"path\": \"src/solution.cpp\"\n    }\n  ],\n  \"hypothesis\": \"Maintaining the first horizontal window sum during vertical column updates may improve whole-program runtime over the measured NEON control by eliminating its repeated first-S-column summation.\",\n  \"notes\": \"Retains only the maintained-first-window idea from 69c407ed932840e9, not its threaded bands or input-time seeding. Parsing remains unchanged. No commands or measurements were executed.\",\n  \"sources_kept\": [\n    \"0872145f07864e21\",\n    \"69c407ed932840e9\"\n  ],\n  \"transformation
#include "knn.h"

#ifdef _OPENMP
#include <omp.h>

typedef struct {
    char * labels;
    float * distances;
    int capacity;
    int count;
    int head;
} KnnPartial;

static void knn_partial_insert(KnnPartial * partial, float distance, char label) {
    if (partial->capacity == 0) return;

    int position = partial->count;
    if (position == partial->capacity) {
        if (!(distance < partial->distances[position - 1])) return;
        position--;
    } else {
        partial->count++;
    }

    while (position > 0 && distance < partial->distances[position - 1]) {
        partial->distances[position] = partial->distances[position - 1];
        partial->labels[position] = partial->labels[position - 1];
        position--;
    }

    partial->distances[position] = distance;
    partial->labels[position] = label;
}

static int knn_select_parallel(int n_groups, Group * groups, int k,
                               Point to_evaluate, char * labels) {
    if (k <= 0) return 0;

    size_t total = 0;
    for (int i = 0; i < n_groups; i++) {
        if (groups[i].length < 0) return 0;
        size_t length = (size_t) groups[i].length;
        if (length > ((size_t) -1) - total) return 0;
        total += length;
    }

    int workers = omp_get_max_threads();
    size_t max_workers = total / 4096;
    if (max_workers < (size_t) workers) workers = (int) max_workers;
    if (workers < 2) return 0;

    KnnPartial * partials = (KnnPartial *) calloc((size_t) workers, sizeof(KnnPartial));
    if (partials == NULL) return 0;

    int failed = 0;

    #pragma omp parallel for schedule(static) num_threads(workers) reduction(|:failed)
    for (int part = 0; part < workers; part++) {
        size_t base_count = total / (size_t) workers;
        size_t extra = total % (size_t) workers;
        size_t rank = (size_t) part;
        size_t begin = base_count * rank + (rank < extra ? rank : extra);
        size_t count = base_count + (rank < extra ? 1 : 0);
        size_t end = begin + count;

        KnnPartial local = {0};
        local.capacity = count < (size_t) k ? (int) count : k;
        int invalid = 0;

        if (local.capacity > 0) {
            local.labels = (char *) malloc(sizeof(char) * (size_t) local.capacity);
            local.distances = (float *) malloc(sizeof(float) * (size_t) local.capacity);

            if (local.labels == NULL || local.distances == NULL) {
                invalid = 1;
            } else {
                size_t offset = 0;
                for (int i = 0; i < n_groups && offset < end && !invalid; i++) {
                    const Group * g = &groups[i];
                    size_t next = offset + (size_t) g->length;

                    if (next > begin) {
                        size_t first = begin > offset ? begin - offset : 0;
                        size_t last = end < next ? end - offset : (size_t) g->length;

                        for (size_t j = first; j < last; j++) {
                            float d = euclidean_distance_no_sqrt(to_evaluate, g->points[j]);
                            if (d != d) {
                                invalid = 1;
                                break;
                            }
                            knn_partial_insert(&local, d, g->label);
                        }
                    }

                    offset = next;
                }
            }
        }

        partials[part] = local;
        failed |= invalid;
    }

    if (!failed) {
        for (int i = 0; i < k; i++) {
            int best = -1;
            float best_distance = 0.0f;

            /* Earlier contiguous partitions win equal-distance ties. */
            for (int part = 0; part < workers; part++) {
                KnnPartial * partial = &partials[part];
                if (partial->head < partial->count) {
                    float d = partial->distances[partial->head];
                    if (best < 0 || d < best_distance) {
                        best = part;
                        best_distance = d;
                    }
                }
            }

            if (best < 0) break;
            labels[i] = partials[best].labels[partials[best].head];
            partials[best].head++;
        }
    }

    for (int part = 0; part < workers; part++) {
        free(partials[part].distances);
        free(partials[part].labels);
    }
    free(partials);

    return !failed;
}
#endif

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    char * labels = (char *) malloc(sizeof(char) * k);

    int i, j, x, y;

    for (i = 0; i < k; i++) {
        labels[i] = -1;
    }

    int selected_in_parallel = 0;
#ifdef _OPENMP
    selected_in_parallel = knn_select_parallel(n_groups, groups, k, to_evaluate, labels);
#endif

    if (!selected_in_parallel) {
        float * distances = (float *) malloc(sizeof(float) * k);

        for (i = 0; i < k; i++) {
            distances[i] = -1;
        }

        for (i = 0; i < n_groups; i++) {
            Group g = groups[i];

            for (j = 0; j < g.length; j++) {
                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);

                for (x = 0; x < k; x++) {
                    if (d < distances[x] || distances[x] == -1) {
                        for (y = k - 1; y > x; y--) {
                            distances[y] = distances[y - 1];
                            labels[y] = labels[y - 1];
                        }

                        distances[x] = d;
                        labels[x] = g.label;

                        break;
                    }
                }
            }
        }

        free(distances);
    }

    qsort(labels, k, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }

            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    free(labels);
    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

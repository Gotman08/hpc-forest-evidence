"""Local/allocation neutral test policy. Original tests are never rewritten."""
import argparse
import json
import os
import sys
import tempfile
from pathlib import Path

parser = argparse.ArgumentParser()
parser.add_argument("--project", type=Path, required=True)
parser.add_argument("--output", type=Path, required=True)
parser.add_argument("--compatible", action="store_true")
parser.add_argument("--legacy-only", action="store_true")
args = parser.parse_args()
project = args.project.resolve(strict=True)
output = args.output.resolve()
output.mkdir(parents=True, exist_ok=False)
sys.path.insert(0, str(project.parent / "qa-deps"))
sys.path.insert(0, str(project / "src"))
sys.path.insert(0, str(project / "examples/marathon22"))
os.environ["PYTHONDONTWRITEBYTECODE"] = "1"
os.environ["PYTEST_DISABLE_PLUGIN_AUTOLOAD"] = "1"


def audit(event, values):
    if event in {"socket.bind", "socket.connect", "socket.connect_ex"}:
        raise RuntimeError("Neutral test policy prohibits sockets")
    if event == "subprocess.Popen":
        executable = Path(str(values[0])).name.lower()
        if any(name in executable for name in ("gcc", "g++", "clang", "codex", "spack", "ssh", "scp", "cl.exe", "cc.exe", "c++.exe")):
            raise RuntimeError("Neutral test policy prohibits compiler, CLI, install and remote commands")


sys.addaudithook(audit)
UNSAFE_FILES = {"test_mcp.py", "test_ollama.py", "test_local_models.py", "test_r4b_allocated_contracts.py"}
UNSAFE_FUNCTIONS = {
    "test_valid_empty_case_preserves_exact_checks_and_rejects_noop",
    "test_empty_case_rejected_without_explicit_policy", "test_all_empty_phase_is_never_admitted",
    "test_shared_cases_do_not_block_and_binary_checker_rejects_wrong_program",
    "test_frozen_build_rejects_uninitialized_openmp_reduction",
    "test_timeout_is_a_real_process_timeout", "test_process_wait_drains_large_stdin_and_stdout_without_timing_poll",
    "test_watchdog_also_stops_a_process_that_never_reads_stdin",
    "test_transport_smoke_uses_zero_model_calls_and_validated_hashes",
    "test_worker_crash_does_not_replay_a_potentially_charged_generation",
    "test_smoke_worker_cannot_answer_an_actual_source_request",
}
# Every exclusion here names a single historical interface assertion, not an
# oracle or problem test. Raw runs preserve its actual failure separately.
LEGACY = {
    "test_same_messages_and_schema_as_the_existing_neutral_adapter",
    "test_cross_role_duplicate_retains_real_failure_without_adding_a_reward",
    "test_selected_parent_diagnostic_survives_recent_history_window",
    "test_model_repairs_real_compile_error_without_rewarding_local_attempts",
    "test_frozen_inputs_statement_and_explicit_subject_coverage",
    "test_excluded_reference_is_never_called_a_model_failure",
    "test_dynamic_runner_import_does_not_pin_a_different_generation_identity",
    "test_native_identity_reaches_real_argv_in_dedicated_process",
}


class Selection:
    def pytest_collection_modifyitems(self, items, config):
        selected, excluded = [], []
        reasons = []
        for item in items:
            function = getattr(item, "originalname", item.name)
            reason = ("compiler-dependent historical fixture excluded from local neutral scope" if "need_compiler" in item.fixturenames else
                      "no socket/server in neutral qualification" if item.path.name in UNSAFE_FILES else
                      "no compiler/process-timeout experiment in neutral qualification" if function in UNSAFE_FUNCTIONS else
                      "historical MAX/privacy/bootstrap interface incompatibility; raw failure preserved" if args.compatible and function in LEGACY else None)
            if args.legacy_only and function not in LEGACY:
                reason = "not part of the separately preserved legacy-interface refusal run"
            if reason:
                excluded.append(item)
                reasons.append({"nodeid": item.nodeid, "reason": reason})
            else:
                selected.append(item)
        items[:] = selected
        config.hook.pytest_deselected(items=excluded)
        (output / "selection.json").write_text(json.dumps({"selected": [i.nodeid for i in selected],
            "excluded": reasons, "old_tests_rewritten": False}, indent=2) + "\n", encoding="utf8")


import pytest

raise SystemExit(pytest.main([str(project / "tests"), "-p", "no:cacheprovider", "-q",
    "--basetemp=" + tempfile.mkdtemp(prefix="r4b-neutral-"), "--junitxml=" + str(output / "junit.xml")], plugins=[Selection()]))

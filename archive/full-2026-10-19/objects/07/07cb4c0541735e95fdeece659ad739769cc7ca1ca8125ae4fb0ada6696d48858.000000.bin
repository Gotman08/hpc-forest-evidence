    {
      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <cstring>\n#include <limits>\n#include <memory>\n#include <vector>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#define SUM_USE_NEON 1\n#else\n#define SUM_USE_NEON 0\n#endif\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nnamespace {\nusing Word = std::uint32_t;\nusing Cell = std::int32_t;\nusing Wide = std::int64_t;\nconstexpr std::size_t BatchBytes = 1u << 20;\n\nCell signed_value(Word magnitude, bool negative) {\n    const Wide value = negative ? -static_cast<Wide>(magnitude)\n                                : static_cast<Wide>(magnitude);\n    return static_cast<Cell>(value);\n}\n\nstruct CountSlot {\n    std::size_t offset;\n    Word maximum_magnitude;\n    unsigned char padding[64 - sizeof(std::size_t) - sizeof(Word)];\n};\n\nstruct BatchReader {\n    std::unique_ptr<unsigned char[]> storage;\n    std::size_t begin = 0;\n    std::size_t end = 0;\n    bool pending = false;\n    bool negative = false;\n    bool ended = false;\n    Word magnitude = 0;\n    Word maximum_magnitude = 0;\n\n    BatchReader() : storage(new unsigned char[BatchBytes]) {}\n\n    bool next(Cell* matrix, std::size_t& produced, std::size_t total) {\n        begin = end = 0;\n        while (!ended && produced < total) {\n            unsigned char* data = storage.get();\n            const std::size_t got = std::fread(data, 1, BatchBytes, stdin);\n            const bool at_eof = got < BatchBytes;\n            std::size_t start = 0;\n\n            if (pending) {\n                while (start < got && data[start] > ' ') {\n                    magnitude = magnitude * 10u\n                              + static_cast<Word>(data[start] - '0');\n                    ++start;\n                }\n                if (start < got || at_eof) {\n                    matrix[produced++] = signed_value(magnitude, negative);\n                    maximum_magnitude = std::max(maximum_magnitude, magnitude);\n                    pending = false;\n                } else {\n                    continue;\n                }\n            }\n\n            std::size_t finish = got;\n            if (!at_eof && finish > start && data[finish - 1] > ' ') {\n                while (finish > start && data[finish - 1] > ' ') --finish;\n                std::size_t p = finish;\n                negative = false;\n                if (p < got && (data[p] == '-' || data[p] == '+')) {\n                    negative = data[p] == '-';\n                    ++p;\n                }\n                magnitude = 0;\n                while (p < got) {\n                    magnitude = magnitude * 10u\n                              + static_cast<Word>(data[p] - '0');\n                    ++p;\n                }\n                pending = true;\n            }\n\n            ended = at_eof;\n            begin = start;\n            end = finish;\n            if (begin < end) return true;\n        }\n        return false;\n    }\n};\n\nstd::size_t align_boundary(const unsigned char* data, std::size_t position,\n                           std::size_t begin, std::size_t end) {\n    if (position != begin) {\n        while (position < end && data[position - 1] > ' ') ++position;\n    }\n    return position;\n}\n\ninline Wide scan64(const Wide* columns, int n, int s) {\n    Wide sum = 0;\n    #pragma omp simd reduction(+:sum)\n    for (int c = 0; c < s; ++c) sum += columns[c];\n    Wide best = sum;\n    for (int c = s; c < n; ++c) {\n        sum += columns[c] - columns[c - s];\n        best = std::max(best, sum);\n    }\n    return best;\n}\n\nWide solve64_rows(const Cell* matrix, int n, int s, int first, int last) {\n    if (first == last) return std::numeric_limits<Wide>::lowest();\n    std::unique_ptr<Wide[]> columns(new Wide[n]());\n    for (int r = first; r < first + s; ++r) {\n        const Cell* row = matrix + static_cast<std::size_t>(r) * n;\n        #pragma omp simd\n        for (int c = 0; c < n; ++c) columns[c] += static_cast<Wide>(row[c]);\n    }\n    Wide best = scan64(columns.get(), n, s);\n    for (int top = first + 1; top < last; ++top) {\n        const Cell* entering = matrix + static_cast<std::size_t>(top + s - 1) * n;\n        const Cell* leaving = matrix + static_cast<std::size_t>(top - 1) * n;\n        #pragma omp simd\n        for (int c = 0; c < n; ++c) {\n            columns[c] += static_cast<Wide>(entering[c])\n                        - static_cast<Wide>(leaving[c]);\n        }\n        best = std::max(best, scan64(columns.get(), n, s));\n    }\n    return best;\n}\n\n#if SUM_USE_NEON\ninline Cell signed_bits(Word bits) {\n    Cell value;\n    std::memcpy(&value, &bits, sizeof(value));\n    return value;\n}\n\ninline uint32x4_t prefix4(uint32x4_t value) {\n    const uint32x4_t zero = vdupq_n_u32(0);\n    value = vaddq_u32(value, vextq_u32(zero, value, 3));\n    return vaddq_u32(value, vextq_u32(zero, value, 2));\n}\n\ntemplate <bool Update>\ninline Word column_scalar(Word* columns, const Cell* entering,\n                          const Cell* leaving, int c) {\n    Word value = columns[c];\n    if (Update) {\n        value -= static_cast<Word>(leaving[c]);\n        value += static_cast<Word>(entering[c]);\n        columns[c] = value;\n    }\n    return value;\n}\n\ntemplate <bool Update>\ninline uint32x4_t column_vector(Word* columns, const Cell* entering,\n                                const Cell* leaving, int c) {\n    uint32x4_t value = vld1q_u32(columns + c);\n    if (Update) {\n        value = vsubq_u32(value,\n            vreinterpretq_u32_s32(vld1q_s32(leaving + c)));\n        value = vaddq_u32(value,\n            vreinterpretq_u32_s32(vld1q_s32(entering + c)));\n        vst1q_u32(columns + c, value);\n    }\n    return value;\n}\n\ntemplate <bool Update>\ninline void scan32(Word* columns, const Cell* entering, const Cell* leaving,\n                   int n, int s, Cell& scalar_best,\n                   int32x4_t& maximum0, int32x4_t& maximum1) {\n    uint32x4_t partial0 = vdupq_n_u32(0);\n    uint32x4_t partial1 = vdupq_n_u32(0);\n    int c = 0;\n    for (; c + 7 < s; c += 8) {\n        partial0 = vaddq_u32(partial0,\n            column_vector<Update>(columns, entering, leaving, c));\n        partial1 = vaddq_u32(partial1,\n            column_vector<Update>(columns, entering, leaving, c + 4));\n    }\n    if (c + 3 < s) {\n        partial0 = vaddq_u32(partial0,\n            column_vector<Update>(columns, entering, leaving, c));\n        c += 4;\n    }\n    Word sum = vaddvq_u32(vaddq_u32(partial0, partial1));\n    for (; c < s; ++c) {\n        sum += column_scalar<Update>(columns, entering, leaving, c);\n    }\n    scalar_best = std::max(scalar_best, signed_bits(sum));\n    uint32x4_t carry = vdupq_n_u32(sum);\n\n    for (; c + 7 < n; c += 8) {\n        const uint32x4_t incoming0 =\n            column_vector<Update>(columns, entering, leaving, c);\n        const uint32x4_t incoming1 =\n            column_vector<Update>(columns, entering, leaving, c + 4);\n        const uint32x4_t outgoing0 = vld1q_u32(columns + c - s);\n        const uint32x4_t outgoing1 = vld1q_u32(columns + c + 4 - s);\n        const uint32x4_t prefix0 = prefix4(vsubq_u32(incoming0, outgoing0));\n        const uint32x4_t prefix1 = vaddq_u32(\n            prefix4(vsubq_u32(incoming1, outgoing1)),\n            vdupq_laneq_u32(prefix0, 3));\n        const uint32x4_t windows0 = vaddq_u32(prefix0, carry);\n        const uint32x4_t windows1 = vaddq_u32(prefix1, carry);\n        maximum0 = vmaxq_s32(maximum0, vreinterpretq_s32_u32(windows0));\n        maximum1 = vmaxq_s32(maximum1, vreinterpretq_s32_u32(windows1));\n        carry = vdupq_laneq_u32(windows1, 3);\n    }\n    if (c + 3 < n) {\n        const uint32x4_t incoming =\n            column_vector<Update>(columns, entering, leaving, c);\n        const uint32x4_t outgoing = vld1q_u32(columns + c - s);\n        const uint32x4_t windows = vaddq_u32(\n            prefix4(vsubq_u32(incoming, outgoing)), carry);\n        maximum0 = vmaxq_s32(maximum0, vreinterpretq_s32_u32(windows));\n        carry = vdupq_laneq_u32(windows, 3);\n        c += 4;\n    }\n    sum = vgetq_lane_u32(carry, 0);\n    for (; c < n; ++c) {\n        const Word incoming = column_scalar<Update>(columns, entering, leaving, c);\n        sum += incoming - columns[c - s];\n        scalar_best = std::max(scalar_best, signed_bits(sum));\n    }\n}\n\nWide solve32_rows(const Cell* matrix, int n, int s, int first, int last) {\n    if (first == last) return std::numeric_limits<Wide>::lowest();\n    std::unique_ptr<Word[]> columns(new Word[n]());\n    for (int r = first; r < first + s; ++r) {\n        const Cell* row = matrix + static_cast<std::size_t>(r) * n;\n        #pragma omp simd\n        for (int c = 0; c < n; ++c) columns[c] += static_cast<Word>(row[c]);\n    }\n    Cell scalar_best = std::numeric_limits<Cell>::lowest();\n    int32x4_t maximum0 = vdupq_n_s32(scalar_best);\n    int32x4_t maximum1 = maximum0;\n    scan32<false>(columns.get(), nullptr, nullptr, n, s,\n                  scalar_best, maximum0, maximum1);\n    for (int top = first + 1; top < last; ++top) {\n        const Cell* entering = matrix + static_cast<std::size_t>(top + s - 1) * n;\n        const Cell* leaving = matrix + static_cast<std::size_t>(top - 1) * n;\n        scan32<true>(columns.get(), entering, leaving, n, s,\n                     scalar_best, maximum0, maximum1);\n    }\n    return std::max(scalar_best, vmaxvq_s32(vmaxq_s32(maximum0, maximum1)));\n}\n#endif\n}\n\nint main() {\n    int n, s;\n    if (std::scanf(\"%d%d\", &n, &s) != 2) return 0;\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t total = static_cast<std::size_t>(n) * n;\n    std::unique_ptr<Cell[]> matrix(new Cell[total]);\n    BatchReader input;\n    int maximum_threads = 1;\n#ifdef _OPENMP\n    maximum_threads = omp_get_max_threads();\n#endif\n    std::vector<CountSlot> counts(maximum_threads);\n    std::size_t produced = 0;\n    std::size_t batch_base = 0;\n    bool have_batch = false;\n    bool use_narrow = false;\n    long long answer = std::numeric_limits<long long>::lowest();\n\n    #pragma omp parallel if(total >= 65536) reduction(max:answer)\n    {\n        int tid = 0;\n        int team = 1;\n#ifdef _OPENMP\n        tid = omp_get_thread_num();\n        team = omp_get_num_threads();\n#endif\n        Word local_maximum = 0;\n        {\n            const std::size_t staging_capacity = std::min(\n                total, BatchBytes / static_cast<std::size_t>(team) + 8u);\n            std::unique_ptr<Cell[]> staged(new Cell[staging_capacity]);\n            for (;;) {\n                #pragma omp single\n                {\n                    have_batch = input.next(matrix.get(), produced, total);\n                    batch_base = produced;\n                }\n                if (!have_batch) break;\n\n                const unsigned char* data = input.storage.get();\n                const std::size_t length = input.end - input.begin;\n                std::size_t left = input.begin + length * tid / team;\n                std::size_t right = input.begin + length * (tid + 1) / team;\n                left = align_boundary(data, left, input.begin, input.end);\n                right = align_boundary(data, right, input.begin, input.end);\n                std::size_t count = 0;\n                std::size_t p = left;\n                while (p < right) {\n                    while (p < right && data[p] <= ' ') ++p;\n                    if (p == right) break;\n                    const bool negative = data[p] == '-';\n                    if (data[p] == '-' || data[p] == '+') ++p;\n                    Word magnitude = 0;\n                    while (p < right && data[p] > ' ') {\n                        magnitude = magnitude * 10u\n                                  + static_cast<Word>(data[p] - '0');\n                        ++p;\n                    }\n                    staged[count++] = signed_value(magnitude, negative);\n                    local_maximum = std::max(local_maximum, magnitude);\n                }\n                counts[tid].offset = count;\n                #pragma omp barrier\n                #pragma omp single\n                {\n                    std::size_t prefix = 0;\n                    for (int t = 0; t < team; ++t) {\n                        const std::size_t count_t = counts[t].offset;\n                        counts[t].offset = prefix;\n                        prefix += count_t;\n                    }\n                    produced = batch_base + prefix;\n                }\n                if (count != 0) {\n                    std::memcpy(matrix.get() + batch_base + counts[tid].offset,\n                                staged.get(), count * sizeof(Cell));\n                }\n                #pragma omp barrier\n            }\n        }\n        counts[tid].maximum_magnitude = local_maximum;\n        #pragma omp barrier\n        #pragma omp single\n        {\n            Word maximum_magnitude = input.maximum_magnitude;\n            for (int t = 0; t < team; ++t) {\n                maximum_magnitude = std::max(\n                    maximum_magnitude, counts[t].maximum_magnitude);\n            }\n            const std::uint64_t bound = static_cast<std::uint64_t>(maximum_magnitude)\n                                      * static_cast<std::uint64_t>(s) * s;\n            use_narrow = bound <= static_cast<std::uint64_t>(\n                std::numeric_limits<Cell>::max());\n        }\n\n        const int windows = n - s + 1;\n        const int first = static_cast<int>(static_cast<Wide>(windows) * tid / team);\n        const int last = static_cast<int>(static_cast<Wide>(windows) * (tid + 1) / team);\n        Wide local_best;\n#if SUM_USE_NEON\n        if (use_narrow) {\n            local_best = solve32_rows(matrix.get(), n, s, first, last);\n        } else {\n            local_best = solve64_rows(matrix.get(), n, s, first, last);\n        }\n#else\n        (void)use_narrow;\n        local_best = solve64_rows(matrix.get(), n, s, first, last);\n#endif\n        answer = std::max(answer, static_cast<long long>(local_best));\n    }\n\n    std::printf(\"%lld\\n\", answer);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Combining parallel batch decoding and persistent row-slab processing with independent NEON prefix carries should reduce the parent's serial-input and horizontal-scan bottlenecks.",
  "notes": "Retains B/C only. A conservative magnitude guard selects a 64-bit fallback when necessary. Not executed.",
  "sources_kept": [
    "2a8abc6e964643b3",
    "fe7264a626cd49ef"
  ],
  "transformations": [
    "Decode bounded 1 MiB batches into thread-private staging buffers and place values using count prefixes.",
    "Reuse one OpenMP team for parsing and statically partitioned output-row slabs.",
    "Form the second four-lane prefix independently of the incoming carry, then apply that carry to both NEON halves in parallel.",
    "Use defined unsigned arithmetic in the proven-safe 32-bit path and SIMD-updated 64-bit rolling columns otherwise."
  ]

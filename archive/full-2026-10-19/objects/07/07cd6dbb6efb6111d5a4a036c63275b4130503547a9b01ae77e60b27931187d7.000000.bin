#include <bits/stdc++.h>

using namespace std;
using ll = long long;

constexpr size_t HASH_CAPACITY = 2048;
constexpr size_t HASH_MASK = HASH_CAPACITY - 1;

struct PrefixSlot {
  ll key;
  int count;
  int generation;
};

static inline size_t hash_index(ll key) {
  uint64_t x = static_cast<uint64_t>(key);
  x ^= x >> 30;
  x *= 0xbf58476d1ce4e5b9ULL;
  x ^= x >> 27;
  x *= 0x94d049bb133111ebULL;
  x ^= x >> 31;
  return static_cast<size_t>(x) & HASH_MASK;
}

static inline int prefix_count(const PrefixSlot *table, ll key, int generation) {
  size_t pos = hash_index(key);
  while (table[pos].generation == generation) {
    if (table[pos].key == key)
      return table[pos].count;
    pos = (pos + 1) & HASH_MASK;
  }
  return 0;
}

static inline void add_prefix(PrefixSlot *table, ll key, int generation) {
  size_t pos = hash_index(key);
  while (table[pos].generation == generation && table[pos].key != key)
    pos = (pos + 1) & HASH_MASK;
  if (table[pos].generation != generation) {
    table[pos].generation = generation;
    table[pos].key = key;
    table[pos].count = 0;
  }
  ++table[pos].count;
}

ll solve(const vector<int> &matrix, int short_dim, int long_dim, int k) {
  vector<ll> band(long_dim, 0);
  PrefixSlot table[HASH_CAPACITY] = {};
  int generation = 0;
  ll answer = 0;

  for (int first = 0; first < short_dim; ++first) {
    fill(band.begin(), band.end(), 0);
    for (int last = first; last < short_dim; ++last) {
      const int *row = matrix.data() + static_cast<size_t>(last) * long_dim;
      for (int x = 0; x < long_dim; ++x)
        band[x] += row[x];

      ++generation;
      add_prefix(table, 0, generation);
      ll prefix = 0;
      for (int x = 0; x < long_dim; ++x) {
        prefix += band[x];
        answer += prefix_count(table, prefix - k, generation);
        add_prefix(table, prefix, generation);
      }
    }
  }
  return answer;
}

int main() {
  ios::sync_with_stdio(false);
  cin.tie(nullptr);

  int k, m, n;
  if (!(cin >> k >> m >> n))
    return 0;

  const int short_dim = min(m, n);
  const int long_dim = max(m, n);
  vector<int> matrix(static_cast<size_t>(short_dim) * long_dim);

  if (m <= n) {
    for (int i = 0; i < m; ++i)
      for (int j = 0; j < n; ++j)
        cin >> matrix[static_cast<size_t>(i) * long_dim + j];
  } else {
    for (int i = 0; i < m; ++i) {
      for (int j = 0; j < n; ++j) {
        int value;
        cin >> value;
        matrix[static_cast<size_t>(j) * long_dim + i] = value;
      }
    }
  }

  cout << solve(matrix, short_dim, long_dim, k) << '\n';
  return 0;
}

      "content": "#include <algorithm>\n#include <cstddef>\n#include <cstring>\n#include <iostream>\n#include <iterator>\n#include <string>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nclass PrintPermutation\n{\n    static const std::size_t capacity = 65536;\n    char buffer_[capacity];\n    std::size_t used_;\n\n    static void interleave(const char* source, std::size_t count, char* destination)\n    {\n        const unsigned char* input = reinterpret_cast<const unsigned char*>(source);\n        unsigned char* output = reinterpret_cast<unsigned char*>(destination);\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n        uint8x16x2_t pairs16;\n        pairs16.val[1] = vdupq_n_u8(' ');\n        while (count >= 16) {\n            pairs16.val[0] = vld1q_u8(input);\n            vst2q_u8(output, pairs16);\n            input += 16;\n            output += 32;\n            count -= 16;\n        }\n        if (count >= 8) {\n            uint8x8x2_t pairs8;\n            pairs8.val[0] = vld1_u8(input);\n            pairs8.val[1] = vdup_n_u8(' ');\n            vst2_u8(output, pairs8);\n            input += 8;\n            output += 16;\n            count -= 8;\n        }\n#endif\n\n        for (std::size_t i = 0; i < count; ++i) {\n            output[2 * i] = input[i];\n            output[2 * i + 1] = ' ';\n        }\n    }\n\n    static void copy_record(const char* source, std::size_t count, char* destination)\n    {\n        // Callers supply disjoint records. Every load and store stays within\n        // its record; an overlapping final vector repeats identical bytes.\n#if defined(__aarch64__) && defined(__ARM_NEON)\n        const unsigned char* input = reinterpret_cast<const unsigned char*>(source);\n        unsigned char* output = reinterpret_cast<unsigned char*>(destination);\n        if (count >= 16) {\n            const std::size_t last = count - 16;\n            for (std::size_t i = 0; i < last; i += 16) {\n                vst1q_u8(output + i, vld1q_u8(input + i));\n            }\n            vst1q_u8(output + last, vld1q_u8(input + last));\n            return;\n        }\n        if (count >= 8) {\n            vst1_u8(output, vld1_u8(input));\n            if (count != 8) {\n                const std::size_t last = count - 8;\n                vst1_u8(output + last, vld1_u8(input + last));\n            }\n            return;\n        }\n#endif\n        std::memcpy(destination, source, count);\n    }\n\n    static bool next_record(char* record, std::size_t last_symbol)\n    {\n        // Symbols occupy offsets 2, 4, ..., last_symbol. Compare native char\n        // values, exactly as std::next_permutation does for std::string.\n        std::size_t suffix = last_symbol;\n        while (suffix > 2 && !(record[suffix - 2] < record[suffix])) {\n            suffix -= 2;\n        }\n        if (suffix == 2) return false;\n\n        const std::size_t pivot = suffix - 2;\n        std::size_t successor = last_symbol;\n        while (!(record[pivot] < record[successor])) {\n            successor -= 2;\n        }\n        std::swap(record[pivot], record[successor]);\n\n        std::size_t right = last_symbol;\n        while (suffix < right) {\n            std::swap(record[suffix], record[right]);\n            suffix += 2;\n            right -= 2;\n        }\n        return true;\n    }\n\n    void append_pair(char first, char second)\n    {\n        if (capacity - used_ < 2) flush();\n        buffer_[used_++] = first;\n        buffer_[used_++] = second;\n    }\n\npublic:\n    PrintPermutation() : used_(0) {}\n\n    void flush()\n    {\n        if (used_ != 0) {\n            std::cout.write(buffer_, static_cast<std::streamsize>(used_));\n            used_ = 0;\n        }\n    }\n\n    void operator()(const std::string& text)\n    {\n        append_pair('[', ' ');\n        const char* source = text.data();\n        std::size_t remaining = text.size();\n        while (remaining != 0) {\n            std::size_t available = (capacity - used_) / 2;\n            if (available == 0) {\n                flush();\n                available = capacity / 2;\n            }\n            const std::size_t count = std::min(remaining, available);\n            interleave(source, count, buffer_ + used_);\n            used_ += 2 * count;\n            source += count;\n            remaining -= count;\n        }\n        append_pair(']', '\\n');\n    }\n\n    void permutations(std::string& text)\n    {\n        if (text.empty()) return;\n\n        // Keep the existing streaming path for records larger than the buffer.\n        // Check before multiplying so record-size arithmetic cannot overflow.\n        if (text.size() > (capacity - 4) / 2) {\n            do {\n                (*this)(text);\n            } while (std::next_permutation(text.begin(), text.end()));\n            return;\n        }\n\n        flush();\n        const std::size_t last_symbol = 2 * text.size();\n        const std::size_t record_size = last_symbol + 4;\n        buffer_[0] = '[';\n        buffer_[1] = ' ';\n        interleave(text.data(), text.size(), buffer_ + 2);\n        buffer_[record_size - 2] = ']';\n        buffer_[record_size - 1] = '\\n';\n        used_ = record_size;\n        char* current = buffer_;\n\n        for (;;) {\n            if (capacity - used_ < record_size) {\n                // flush() preserves the bytes of the last committed record.\n                // Whole-record placement makes this copy disjoint or identical.\n                flush();\n                if (current != buffer_) {\n                    copy_record(current, record_size, buffer_);\n                }\n                current = buffer_;\n            } else {\n                char* next = buffer_ + used_;\n                copy_record(current, record_size, next);\n                current = next;\n            }\n\n            // Only the uncommitted record is changed. Earlier output records\n            // remain immutable, and permutation transitions stay sequential.\n            if (!next_record(current, last_symbol)) break;\n            used_ += record_size;\n        }\n    }\n};\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ' )\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v') ;\n    }\n} ;\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase\n        ( std::remove_if\n            ( text.begin ()\n            , text.end ()\n            , IsWhitespace () )\n        , text.end () ) ;\n    return text ;\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator <char> begin (in), end ;\n    std::string text (begin, end) ;\n    text = remove_whitespaces (text) ;\n    return text ;\n}\n\nint main (int argc, char const *argv [])\n{\n    std::string text = read_text_from_stdin <std::string> (std::cin) ;\n    if (text.empty()) return 0;\n\n    std::sort(text.begin(), text.end());\n    PrintPermutation print;\n    print.permutations(text);\n    print.flush();\n    return 0;\n}\n",
      "path": "src/permutations.cc"
    }

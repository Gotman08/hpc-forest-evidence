import hashlib
import json
from pathlib import Path

root = Path(__file__).resolve().parents[1]
out = root / 'outputs/HPC-Forest-Q15-Execution-root-01'
source = root / 'outputs/HPC-Forest-Q15-Pilote-Unique-r2'
template = root / 'outputs/HPC-Forest-Q15-Reception-Preparation-r1/INPUT-RECEPTION-Q15-TEMPLATE-PREPARED.json'
config = json.loads(template.read_text(encoding='utf-8-sig'))
paths = {
    'source_preparation': source / 'PREPARATION-Q15.json',
    'source_archive': source / 'HPC-Forest-Q15-baseline-source-r1.tar.gz',
    'source_plan': source / 'paquet/PLAN-Q15.json',
    'source_manifest': source / 'paquet/PACKAGE-MANIFEST.json',
    'output_archive': out / 'received/result-Q15.tar.gz',
    'archive_announcement': out / 'received/result-Q15-archive.json',
    'archive_transfer': out / 'TRANSFERT-ARCHIVE-REEL.json',
    'announcement_transfer': out / 'TRANSFERT-ANNONCE-REEL.json',
    'status': out / 'JOB-STATUS-02.json',
    'efficiency': out / 'EFFICIENCY-REEL.json',
}
for key, path in paths.items():
    data = path.read_bytes()
    config[key] = {'path': str(path), 'sha256': hashlib.sha256(data).hexdigest(), 'bytes': len(data)}
config.update(evidence_origin='received', job_id='755488',
              package_directory=str(source / 'paquet'),
              reception_directory=str(out / 'reception-froide-r1'),
              remote_package_root='/gpfs/scratch/nimarano/hpc-forest-q15-single-pilot-20261019-root-01/package',
              remote_output_root='/gpfs/scratch/nimarano/hpc-forest-q15-single-pilot-20261019-root-01/result-Q15')
target = out / 'INPUT-RECEPTION-Q15-REELLE-r1.json'
data = (json.dumps(config, ensure_ascii=False, sort_keys=True, indent=2) + '\n').encode('utf-8')
with target.open('xb') as stream:
    stream.write(data)
print(json.dumps({'path': str(target), 'sha256': hashlib.sha256(data).hexdigest(), 'bytes': len(data)}))

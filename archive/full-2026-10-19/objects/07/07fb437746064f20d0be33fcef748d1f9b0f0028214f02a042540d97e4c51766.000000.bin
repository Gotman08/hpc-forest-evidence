"""Conservative pure native-family discovery, without a closed module allowlist."""
from __future__ import annotations

import re


def is_native_worker_command(command):
    if not isinstance(command, str):
        return False
    # Every hpc_forest module/path requires explicit census classification. This
    # intentionally blocks unknown names; it does not infer a model from text.
    return 'bootstrap_worker.py' in command.casefold() or re.search(
        r'hpc_forest(?:\.|[/\\])', command, flags=re.IGNORECASE) is not None

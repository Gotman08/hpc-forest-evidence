{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdint.h>\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10\n#define DT 0.01f\n#define SOFTENING 1e-9f\n#define COEFFICIENT_PANEL 32\n#define TARGET_TILE 64\n#define FORCE_LANES 8\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nstatic inline void body_force_one(Body *p, float dt, int n, int i) {\n  float fx = 0.0f;\n  float fy = 0.0f;\n  float fz = 0.0f;\n\n  for (int j = 0; j < n; ++j) {\n    float dx = p[j].x - p[i].x;\n    float dy = p[j].y - p[i].y;\n    float dz = p[j].z - p[i].z;\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n    fx += dx * inv_dist3;\n    fy += dy * inv_dist3;\n    fz += dz * inv_dist3;\n  }\n\n  p[i].vx += dt*fx;\n  p[i].vy += dt*fy;\n  p[i].vz += dt*fz;\n}\n\n/* Preserve the force-only interface and workspace-free arithmetic. */\nvoid body_force(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    body_force_one(p, dt, n, i);\n  }\n}\n\nstatic void direct_simulation(Body *p, int n) {\n  #pragma omp parallel if(n >= 2 * TARGET_TILE)\n  {\n    for (int iter = 0; iter < N_ITER; ++iter) {\n      #pragma omp for schedule(static)\n      for (int i = 0; i < n; ++i) {\n        body_force_one(p, DT, n, i);\n      }\n      #pragma omp for schedule(static)\n      for (int i = 0; i < n; ++i) {\n        p[i].x += p[i].vx * DT;\n        p[i].y += p[i].vy * DT;\n        p[i].z += p[i].vz * DT;\n      }\n    }\n  }\n}\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic inline float32x4_t squared_distance4(float32x4_t x,\n                                           float32x4_t y,\n                                           float32x4_t z,\n                                           float sx, float sy, float sz) {\n  const float32x4_t dx = vsubq_f32(vdupq_n_f32(sx), x);\n  const float32x4_t dy = vsubq_f32(vdupq_n_f32(sy), y);\n  const float32x4_t dz = vsubq_f32(vdupq_n_f32(sz), z);\n  float32x4_t squared = vaddq_f32(vmulq_f32(dx, dx), vmulq_f32(dy, dy));\n  squared = vaddq_f32(squared, vmulq_f32(dz, dz));\n  return vaddq_f32(squared, vdupq_n_f32(SOFTENING));\n}\n\nstatic inline float32x4_t inverse_cube4(float32x4_t squared) {\n  const float64x2_t one = vdupq_n_f64(1.0);\n  const float64x2_t lo = vcvt_f64_f32(vget_low_f32(squared));\n  const float64x2_t hi = vcvt_f64_f32(vget_high_f32(squared));\n  const float64x2_t root_lo = vsqrtq_f64(lo);\n  const float64x2_t root_hi = vsqrtq_f64(hi);\n  const float32x2_t inv_lo = vcvt_f32_f64(vdivq_f64(one, root_lo));\n  const float32x2_t inv_hi = vcvt_f32_f64(vdivq_f64(one, root_hi));\n  const float32x4_t inv = vcombine_f32(inv_lo, inv_hi);\n  return vmulq_f32(vmulq_f32(inv, inv), inv);\n}\n#endif\n\n/* Both orientations fit in two thread-private 32-by-64 buffers. */\n#if defined(__GNUC__) && !defined(__clang__) && !defined(__INTEL_COMPILER)\n__attribute__((optimize(\"no-math-errno\")))\n#endif\nstatic void make_panel(const float *restrict x,\n                       const float *restrict y,\n                       const float *restrict z,\n                       int a, int na, int b, int nb,\n                       float *restrict coefficient,\n                       float *restrict transpose) {\n  int vector_i = 0;\n  int vector_j = 0;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n  vector_i = na - na % 4;\n  vector_j = nb - nb % 4;\n  for (int j = 0; j < vector_j; j += 4) {\n    for (int i = 0; i < vector_i; i += 4) {\n      const float32x4_t xv = vld1q_f32(x + a + i);\n      const float32x4_t yv = vld1q_f32(y + a + i);\n      const float32x4_t zv = vld1q_f32(z + a + i);\n      const float32x4_t s0 = squared_distance4(xv, yv, zv,\n                                               x[b+j], y[b+j], z[b+j]);\n      const float32x4_t s1 = squared_distance4(xv, yv, zv,\n                                               x[b+j+1], y[b+j+1], z[b+j+1]);\n      const float32x4_t s2 = squared_distance4(xv, yv, zv,\n                                               x[b+j+2], y[b+j+2], z[b+j+2]);\n      const float32x4_t s3 = squared_distance4(xv, yv, zv,\n                                               x[b+j+3], y[b+j+3], z[b+j+3]);\n      const float32x4_t c0 = inverse_cube4(s0);\n      const float32x4_t c1 = inverse_cube4(s1);\n      const float32x4_t c2 = inverse_cube4(s2);\n      const float32x4_t c3 = inverse_cube4(s3);\n\n      vst1q_f32(coefficient + j*TARGET_TILE + i, c0);\n      vst1q_f32(coefficient + (j+1)*TARGET_TILE + i, c1);\n      vst1q_f32(coefficient + (j+2)*TARGET_TILE + i, c2);\n      vst1q_f32(coefficient + (j+3)*TARGET_TILE + i, c3);\n\n      const float32x4x2_t t01 = vtrnq_f32(c0, c1);\n      const float32x4x2_t t23 = vtrnq_f32(c2, c3);\n      vst1q_f32(transpose + i*COEFFICIENT_PANEL + j,\n                 vcombine_f32(vget_low_f32(t01.val[0]),\n                              vget_low_f32(t23.val[0])));\n      vst1q_f32(transpose + (i+1)*COEFFICIENT_PANEL + j,\n                 vcombine_f32(vget_low_f32(t01.val[1]),\n                              vget_low_f32(t23.val[1])));\n      vst1q_f32(transpose + (i+2)*COEFFICIENT_PANEL + j,\n                 vcombine_f32(vget_high_f32(t01.val[0]),\n                              vget_high_f32(t23.val[0])));\n      vst1q_f32(transpose + (i+3)*COEFFICIENT_PANEL + j,\n                 vcombine_f32(vget_high_f32(t01.val[1]),\n                              vget_high_f32(t23.val[1])));\n    }\n  }\n#endif\n\n  for (int j = 0; j < nb; ++j) {\n    const int first = j < vector_j ? vector_i : 0;\n    const float sx = x[b+j];\n    const float sy = y[b+j];\n    const float sz = z[b+j];\n    #pragma omp simd\n    for (int i = first; i < na; ++i) {\n      float dx = sx - x[a+i];\n      float dy = sy - y[a+i];\n      float dz = sz - z[a+i];\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n      coefficient[j*TARGET_TILE+i] = inv_dist3;\n      transpose[i*COEFFICIENT_PANEL+j] = inv_dist3;\n    }\n  }\n}\n\n/* Only independent destinations are vectorized; sources remain ordered. */\nstatic void accumulate_tile(const float *restrict x,\n                            const float *restrict y,\n                            const float *restrict z,\n                            float *restrict fx,\n                            float *restrict fy,\n                            float *restrict fz,\n                            int d, int nd, int s, int ns,\n                            const float *restrict coefficient, int pitch) {\n  int k = 0;\n  for (; k + FORCE_LANES <= nd; k += FORCE_LANES) {\n    float ax[FORCE_LANES], ay[FORCE_LANES], az[FORCE_LANES];\n    float px[FORCE_LANES], py[FORCE_LANES], pz[FORCE_LANES];\n    #pragma omp simd\n    for (int lane = 0; lane < FORCE_LANES; ++lane) {\n      ax[lane] = fx[d+k+lane];\n      ay[lane] = fy[d+k+lane];\n      az[lane] = fz[d+k+lane];\n      px[lane] = x[d+k+lane];\n      py[lane] = y[d+k+lane];\n      pz[lane] = z[d+k+lane];\n    }\n    for (int j = 0; j < ns; ++j) {\n      const float sx = x[s+j];\n      const float sy = y[s+j];\n      const float sz = z[s+j];\n      const float *c = coefficient + j*pitch + k;\n      #pragma omp simd\n      for (int lane = 0; lane < FORCE_LANES; ++lane) {\n        float dx = sx - px[lane];\n        float dy = sy - py[lane];\n        float dz = sz - pz[lane];\n        ax[lane] += dx * c[lane];\n        ay[lane] += dy * c[lane];\n        az[lane] += dz * c[lane];\n      }\n    }\n    #pragma omp simd\n    for (int lane = 0; lane < FORCE_LANES; ++lane) {\n      fx[d+k+lane] = ax[lane];\n      fy[d+k+lane] = ay[lane];\n      fz[d+k+lane] = az[lane];\n    }\n  }\n  for (; k < nd; ++k) {\n    float ax = fx[d+k];\n    float ay = fy[d+k];\n    float az = fz[d+k];\n    const float px = x[d+k];\n    const float py = y[d+k];\n    const float pz = z[d+k];\n    for (int j = 0; j < ns; ++j) {\n      float dx = x[s+j] - px;\n      float dy = y[s+j] - py;\n      float dz = z[s+j] - pz;\n      float c = coefficient[j*pitch+k];\n      ax += dx * c;\n      ay += dy * c;\n      az += dz * c;\n    }\n    fx[d+k] = ax;\n    fy[d+k] = ay;\n    fz[d+k] = az;\n  }\n}\n\nstatic void simulate(Body *p, int n) {\n  if (n < 2 * TARGET_TILE) {\n    direct_simulation(p, n);\n    return;\n  }\n\n  const size_t stride = ((size_t)n + 15u) & ~(size_t)15u;\n  if (stride > (SIZE_MAX - 63u) / (6u * sizeof(float))) {\n    direct_simulation(p, n);\n    return;\n  }\n  void *allocation = malloc(6u * stride * sizeof(float) + 63u);\n  if (allocation == NULL) {\n    direct_simulation(p, n);\n    return;\n  }\n  float *x = (float *)(((uintptr_t)allocation + 63u) & ~(uintptr_t)63u);\n  float *y = x + stride;\n  float *z = y + stride;\n  float *fx = z + stride;\n  float *fy = fx + stride;\n  float *fz = fy + stride;\n  const int tiles = n / TARGET_TILE + (n % TARGET_TILE != 0);\n  const int waves = 2 * tiles - 1;\n  int direct_needed = 0;\n\n  #pragma omp parallel\n  {\n    float coefficient[COEFFICIENT_PANEL * TARGET_TILE];\n    float transpose[TARGET_TILE * COEFFICIENT_PANEL];\n\n    for (int iter = 0; iter < N_ITER; ++iter) {\n      #pragma omp single\n      {\n        direct_needed = 0;\n      }\n      #pragma omp for schedule(static) reduction(|:direct_needed)\n      for (int i = 0; i < n; ++i) {\n        x[i] = p[i].x;\n        y[i] = p[i].y;\n        z[i] = p[i].z;\n        fx[i] = 0.0f;\n        fy[i] = 0.0f;\n        fz[i] = 0.0f;\n        /* Conservatively keep exceptional arithmetic in the direct path. */\n        if (!isfinite(x[i]) || !isfinite(y[i]) || !isfinite(z[i]) ||\n            !isfinite(p[i].vx) || !isfinite(p[i].vy) || !isfinite(p[i].vz) ||\n            fabsf(x[i]) > 0x1p126f || fabsf(y[i]) > 0x1p126f ||\n            fabsf(z[i]) > 0x1p126f) {\n          direct_needed = 1;\n        }\n      }\n\n      if (direct_needed) {\n        #pragma omp for schedule(static)\n        for (int i = 0; i < n; ++i) {\n          body_force_one(p, DT, n, i);\n        }\n        #pragma omp for schedule(static)\n        for (int i = 0; i < n; ++i) {\n          p[i].x += p[i].vx * DT;\n          p[i].y += p[i].vy * DT;\n          p[i].z += p[i].vz * DT;\n        }\n      } else {\n        /* A fixed anti-diagonal contains disjoint unordered tile pairs.\n           For target tile r, wave r+s visits source tiles s in order. */\n        for (int wave = 0; wave < waves; ++wave) {\n          const int first = wave < tiles ? 0 : wave - tiles + 1;\n          const int last = wave / 2;\n          #pragma omp for schedule(static)\n          for (int tile = first; tile <= last; ++tile) {\n            const int other = wave - tile;\n            const int a = tile * TARGET_TILE;\n            const int b = other * TARGET_TILE;\n            int na = n - a;\n            int nb = n - b;\n            if (na > TARGET_TILE) na = TARGET_TILE;\n            if (nb > TARGET_TILE) nb = TARGET_TILE;\n\n            for (int offset = 0; offset < nb; offset += COEFFICIENT_PANEL) {\n              int count = nb - offset;\n              if (count > COEFFICIENT_PANEL) count = COEFFICIENT_PANEL;\n              make_panel(x, y, z, a, na, b + offset, count,\n                         coefficient, transpose);\n              accumulate_tile(x, y, z, fx, fy, fz,\n                              a, na, b + offset, count,\n                              coefficient, TARGET_TILE);\n              if (tile != other) {\n                accumulate_tile(x, y, z, fx, fy, fz,\n                                b + offset, count, a, na,\n                                transpose, COEFFICIENT_PANEL);\n              }\n            }\n          }\n        }\n\n        #pragma omp for schedule(static)\n        for (int i = 0; i < n; ++i) {\n          p[i].vx += DT*fx[i];\n          p[i].vy += DT*fy[i];\n          p[i].vz += DT*fz[i];\n          p[i].x += p[i].vx * DT;\n          p[i].y += p[i].vy * DT;\n          p[i].z += p[i].vz * DT;\n        }\n      }\n    }\n  }\n  free(allocation);\n}\n\n/* Read a binary dataset with initialized bodies. */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n  return bodies;\n}\n\n/* Write simulation results into a binary dataset. */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n  Body *bodies = read_dataset(&nbodies);\n  simulate(bodies, nbodies);\n  write_dataset(nbodies, bodies);\n  free(bodies);\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Combining 32-source panels inside 64-body symmetric tiles with batched NEON coefficient production should reduce duplicate square roots and keep both coefficient orientations cache-resident while preserving ordered force sums.",
  "notes": "No commands executed. Binary I/O and the force-only interface are preserved; workspaces are per call.",

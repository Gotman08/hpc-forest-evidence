{
  "name": "forest-r4b-astra-max-advice",
  "command": "bash -lc 'set -euo pipefail\n[[ ${SLURM_JOB_ID:-} =~ ^[0-9]+$ ]]\ntest \"$(uname -m)\" = aarch64\ntest \"${SLURM_CPUS_PER_TASK:-}\" = 4\ntest \"${SLURM_NTASKS:-1}\" = 1\ntest \"${SLURM_JOB_NUM_NODES:-1}\" = 1\ntest \"${SLURM_MEM_PER_NODE:-}\" = 16384\ntest -z \"${SLURM_JOB_GPUS:-}${SLURM_STEP_GPUS:-}\"\ntest \"${SLURM_GPUS:-0}\" = 0\ntest \"${SLURM_GPUS_ON_NODE:-0}\" = 0\npy=/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python\nshared=/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-qualification-20261018-r3-ede293f185e6\nstage_archive=/scratch_p/nimarano/hpc-forest-dynamic-r4b-native-interface-models-max-r2-ede293f185e6.tar.gz\ndriver=/scratch_p/nimarano/hpc-forest-dynamic-r4b-stage-models-max-r2-advice-7be16898433e49f4b481045079abbbe8\nnative_root=/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-7be16898433e49f4b481045079abbbe8\nadmission_root=/scratch_p/nimarano/hpc-forest-dynamic-r4b-admission-7be16898433e49f4b481045079abbbe8\ntest -x \"$py\"\ntest -d \"$shared\"\ntest ! -e \"$driver\"\ntest ! -e \"$native_root\"\ntest ! -e \"$admission_root\"\nprintf '\"'\"'%s  %s\\n'\"'\"' bdb27e9611d5e53048521a48563b0abd4bf55256ac4169d49d46941f1d2ba73a \"$stage_archive\" | sha256sum -c -\nprintf '\"'\"'%s  %s\\n'\"'\"' ede293f185e663241c01c22a5fa9edcd54ad66af6a1e0964755eac306c5de0f3 \"$shared/project.zip\" | sha256sum -c -\nprintf '\"'\"'%s  %s\\n'\"'\"' 9f04e93c1a28c70f444005b7670ff23731cac838846b99cb1b6742db9e8de33b \"$shared/dynamic-plan.json\" | sha256sum -c -\ntest -f \"$shared/mechanical-reception-native.json\"\nexport PYTHONDONTWRITEBYTECODE=1 PYTHONUTF8=1\n\"$py\" -I -B - \"$stage_archive\" \"$driver\" \"$shared\" <<'\"'\"'STAGE'\"'\"'\nimport hashlib,json,sys,tarfile\nfrom pathlib import Path\narchive,driver,shared=map(Path,sys.argv[1:])\nsha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()\nexpected=json.loads((shared/'\"'\"'runtime-manifest.json'\"'\"').read_text())\npaths=list((shared/'\"'\"'project'\"'\"').rglob('\"'\"'*'\"'\"'));assert not any(p.is_symlink() for p in paths)\nactual={p.relative_to(shared/'\"'\"'project'\"'\"').as_posix():sha(p) for p in paths if p.is_file()}\nassert actual==expected and len(actual)==103\ndriver.mkdir(parents=True,exist_ok=False)\nwith tarfile.open(archive) as t:\n members=t.getmembers();assert len(members)==3 and {m.name for m in members}=={'\"'\"'remote_stage.py'\"'\"','\"'\"'cell_selection.py'\"'\"','\"'\"'stage-manifest.json'\"'\"'}\n assert all(m.isfile() for m in members)\n for m in members:(driver/m.name).write_bytes(t.extractfile(m).read())\nassert json.loads((driver/'\"'\"'stage-manifest.json'\"'\"').read_text())=={name:sha(driver/name) for name in ('\"'\"'remote_stage.py'\"'\"','\"'\"'cell_selection.py'\"'\"')}\nSTAGE\nromeo_load_armgpu_env\nspack load /zrtbeqke25s2vbqo4yrhsowjz7mg3pjf\nexport OMP_NUM_THREADS=4 OMP_DYNAMIC=FALSE OMP_PROC_BIND=TRUE OPENBLAS_NUM_THREADS=1 CUDA_VISIBLE_DEVICES=\nulimit -s unlimited\nexec srun --ntasks=1 --cpus-per-task=4 --cpu-bind=cores \"$py\" -I -B -u \"$driver/remote_stage.py\" --shared \"$shared\" --qualification-reception \"$shared/mechanical-reception-native.json\" --model gpt-6-astra --effort max --phase advice --root \"$native_root\" --admission-root \"$admission_root\"\n'",
  "arch": "armgpu",
  "cpus_per_task": 4,
  "mem_gb": 16,
  "gpus_per_node": 0,
  "time_limit": "01:00:00",
  "workdir": "/scratch_p/nimarano",
  "spack_packages": []
}

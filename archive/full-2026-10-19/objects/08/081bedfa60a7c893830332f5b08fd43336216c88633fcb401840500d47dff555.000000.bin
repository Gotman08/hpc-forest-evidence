{
  "src/main.cpp": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nint A[1000][1000];\n\ntypedef long long ll;\n\nclass PrefixCounter {\n  vector<int> keys;\n  vector<int> counts;\n  vector<int> stamps;\n  size_t mask;\n  int next_stamp;\n\n  static inline uint32_t mix(uint32_t x) {\n    x ^= x >> 16;\n    x *= 0x7feb352du;\n    x ^= x >> 15;\n    x *= 0x846ca68bu;\n    x ^= x >> 16;\n    return x;\n  }\n\n public:\n  explicit PrefixCounter(int maximum_entries) : next_stamp(0) {\n    size_t capacity = 1;\n    while (capacity < static_cast<size_t>(maximum_entries) * 2)\n      capacity <<= 1;\n    keys.resize(capacity);\n    counts.resize(capacity);\n    stamps.assign(capacity, 0);\n    mask = capacity - 1;\n  }\n\n  inline int begin() { return ++next_stamp; }\n\n  inline int get(int key, int stamp) const {\n    size_t slot = mix(static_cast<uint32_t>(key)) & mask;\n    while (stamps[slot] == stamp) {\n      if (keys[slot] == key)\n        return counts[slot];\n      slot = (slot + 1) & mask;\n    }\n    return 0;\n  }\n\n  inline void increment(int key, int stamp) {\n    size_t slot = mix(static_cast<uint32_t>(key)) & mask;\n    while (stamps[slot] == stamp && keys[slot] != key)\n      slot = (slot + 1) & mask;\n    if (stamps[slot] != stamp) {\n      stamps[slot] = stamp;\n      keys[slot] = key;\n      counts[slot] = 1;\n    } else {\n      ++counts[slot];\n    }\n  }\n};\n\nll solve(int m, int n, int k) {\n  const bool bands_are_columns = n <= m;\n  const int bands = bands_are_columns ? n : m;\n  const int scan = bands_are_columns ? m : n;\n  const int stride = bands + 1;\n\n  vector<int> prefix(static_cast<size_t>(scan) * stride);\n#pragma omp parallel for schedule(static)\n  for (int i = 0; i < scan; ++i) {\n    int sum = 0;\n    const size_t base = static_cast<size_t>(i) * stride;\n    prefix[base] = 0;\n    if (bands_are_columns) {\n      for (int j = 0; j < bands; ++j) {\n        sum += A[i][j];\n        prefix[base + j + 1] = sum;\n      }\n    } else {\n      for (int j = 0; j < bands; ++j) {\n        sum += A[j][i];\n        prefix[base + j + 1] = sum;\n      }\n    }\n  }\n\n  const ll pair_count = 1LL * bands * (bands + 1) / 2;\n  vector<ll> first_pair(bands);\n  vector<unsigned short> left_of_pair(static_cast<size_t>(pair_count));\n  ll pair = 0;\n  for (int left = 0; left < bands; ++left) {\n    first_pair[left] = pair;\n    for (int right = left; right < bands; ++right)\n      left_of_pair[static_cast<size_t>(pair++)] =\n          static_cast<unsigned short>(left);\n  }\n\n  ll answer = 0;\n#pragma omp parallel reduction(+ : answer)\n  {\n    PrefixCounter counter(scan + 1);\n#pragma omp for schedule(static)\n    for (ll current = 0; current < pair_count; ++current) {\n      const int left = left_of_pair[static_cast<size_t>(current)];\n      const int right = left + static_cast<int>(current - first_pair[left]);\n      const int stamp = counter.begin();\n      counter.increment(0, stamp);\n\n      int sum = 0;\n      for (int i = 0; i < scan; ++i) {\n        const size_t base = static_cast<size_t>(i) * stride;\n        sum += prefix[base + right + 1] - prefix[base + left];\n        answer += counter.get(sum - k, stamp);\n        counter.increment(sum, stamp);\n      }\n    }\n  }\n\n  return answer;\n}\n\nint main() {\n  ios::sync_with_stdio(false);\n  cin.tie(nullptr);\n\n  int k, m, n;\n  cin >> k >> m >> n;\n  for (int i = 0; i < m; ++i)\n    for (int j = 0; j < n; ++j)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << '\\n';\n  return 0;\n}\n"
}

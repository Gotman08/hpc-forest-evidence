/*
  Quicksort
*/
#include <stdio.h>
#include <stdlib.h>
#include <limits.h>
#include <openssl/md5.h>

#if defined(__aarch64__) && defined(__ARM_NEON) && defined(__GNUC__) && INT_MAX == 2147483647
#include <arm_neon.h>
#define PARTITION_NEON 1
#else
#define PARTITION_NEON 0
#endif

/*
 * Prototypes
 */
void srandnum(int seed);
double randnum(void);
int *generate_case(int N);
double drand(int xmin, int xmax);
void swap(int *toorder, int i, int j);
int partition(int *toorder, int lo, int hi);
void _quicksort(int *toorder, int lo, int hi);
void quicksort(int *toorder, int N);
int is_sorted(int *toorder, int N);

/*
 * A generic pRNG
 */
#define MY_RAND_MAX 0x7FFFFFFF

#define RANDNUM_W 521288629
#define RANDNUM_Z 362436069

unsigned int randum_w = RANDNUM_W;
unsigned int randum_z = RANDNUM_Z;

void srandnum(int seed)
{
    unsigned int w, z;
    w = (seed * 104623) & 0xffffffff;
    randum_w = (w) ? w : RANDNUM_W;
    z = (seed * 48947) & 0xffffffff;
    randum_z = (z) ? z : RANDNUM_Z;
}

double randnum(void)
{
    unsigned int u;
    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);
    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);
    u = (randum_z << 16) + randum_w;
    return (abs(u));
}

/*
 * Main function
 */
int main(int argc, char *argv[])
{
    int N = 0;
    int *our_list = NULL;

    //The input provides the case size
	scanf("%d", &N);
    if (N <= 0) {
	printf("Error: please, provide the case size.\n");
	return 1;
    }

    //Generate the case
    our_list = generate_case(N);
    if (our_list == NULL) {
	printf("Error: case instantiation failed.\n");
	return 1;
    }

    //Do the thing
    quicksort(our_list, N);

    if (is_sorted(our_list, N) == 1) {
	printf("Error, for some reason list is still unsorted.\n");
	return 1;
    }

#ifdef COMPUTE_MD5_PROBLEM
    //Compute MD5 Checksum for problem identification
    MD5_CTX c;
    unsigned char out[MD5_DIGEST_LENGTH];
    MD5_Init(&c);
    MD5_Update(&c, our_list, N * sizeof(int));
    MD5_Final(out, &c);
    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {
	printf("%02x", out[n]);
    }
#endif
    printf("\n");

    //Clean up
    free(our_list);

    return 0;
}

/*
 * Public API
 */
void quicksort(int *toorder, int N)
{
    _quicksort(toorder, 0, N - 1);
}

/*
 * Internal recursive function to quicksort
 */
void _quicksort(int *toorder, int lo, int hi)
{
    if (lo >= hi)
	return;
    int b = partition(toorder, lo, hi);
    _quicksort(toorder, lo, b - 1);
    _quicksort(toorder, b + 1, hi);
}

/*
 * Swap two values.
 */
void swap(int *toorder, int i, int j)
{
    int temp = toorder[i];
    toorder[i] = toorder[j];
    toorder[j] = temp;
}

#if PARTITION_NEON
/* Read-only classification of sixteen independent signed comparisons. */
static inline unsigned int partition_less_mask(const int *values,
                                               int32x4_t vpivot,
                                               uint8x8_t weights)
{
    const uint32x4_t c0 = vcltq_s32(vld1q_s32(values), vpivot);
    const uint32x4_t c1 = vcltq_s32(vld1q_s32(values + 4), vpivot);
    const uint32x4_t c2 = vcltq_s32(vld1q_s32(values + 8), vpivot);
    const uint32x4_t c3 = vcltq_s32(vld1q_s32(values + 12), vpivot);
    const uint8x8_t low = vmovn_u16(vcombine_u16(vmovn_u32(c0), vmovn_u32(c1)));
    const uint8x8_t high = vmovn_u16(vcombine_u16(vmovn_u32(c2), vmovn_u32(c3)));
    unsigned int mask = (unsigned int)vaddv_u8(vand_u8(low, weights));
    mask |= (unsigned int)vaddv_u8(vand_u8(high, weights)) << 8;
    return mask;
}
#endif

/*
 * Partition decision
 */
int partition(int *toorder, int lo, int hi)
{
    int b = lo;
    int r = (int) (lo + (hi - lo) * (randnum() / MY_RAND_MAX));
    int pivot = toorder[r];
    swap(toorder, r, hi);
    int i = lo;

#if PARTITION_NEON
    if (hi - i >= 16) {
        const int32x4_t vpivot = vdupq_n_s32(pivot);
        const uint8_t bit_weights[8] = {1, 2, 4, 8, 16, 32, 64, 128};
        const uint8x8_t weights = vld1_u8(bit_weights);

        if (hi - i >= 32) {
            int left = lo;
            int right = hi;
            unsigned int left_mask = 0;
            unsigned int right_mask = 0;

            /*
             * The unresolved interval is [left, right), excluding the pivot.
             * These two sixteen-element blocks are always disjoint. Masks
             * identify >= pivot on the left and < pivot on the right.
             */
            do {
                if (left_mask == 0) {
                    left_mask = partition_less_mask(toorder + left,
                                                    vpivot, weights) ^ 0xffffU;
                }
                if (right_mask == 0) {
                    right_mask = partition_less_mask(toorder + right - 16,
                                                     vpivot, weights);
                }

                /*
                 * Each exchange corrects both selected positions. Removing
                 * their bits leaves every remaining classification valid.
                 * A partially processed block stays in place with its mask.
                 */
                while (left_mask != 0 && right_mask != 0) {
                    int li = left + __builtin_ctz(left_mask);
                    int ri = right - 16 + __builtin_ctz(right_mask);
                    swap(toorder, li, ri);
                    left_mask &= left_mask - 1U;
                    right_mask &= right_mask - 1U;
                }
                if (left_mask == 0) {
                    left += 16;
                }
                if (right_mask == 0) {
                    right -= 16;
                }
            } while (right - left >= 32);

            /* Finish the bounded remainder, including any retained block. */
            while (left < right) {
                while (left < right && toorder[left] < pivot) {
                    left++;
                }
                while (left < right && toorder[right - 1] >= pivot) {
                    right--;
                }
                if (left < right) {
                    swap(toorder, left, right - 1);
                    left++;
                    right--;
                }
            }
            swap(toorder, hi, left);
            return left;
        }

        do {
            /* Classify the entire block before performing any swaps. */
            unsigned int mask = partition_less_mask(toorder + i,
                                                    vpivot, weights);

            /*
             * Ascending indices preserve Lomuto's swap order. Since b <= j,
             * a swap cannot modify a later, already-classified element.
             * These dependent swaps deliberately remain scalar.
             */
            while (mask != 0) {
                int j = i + __builtin_ctz(mask);
                swap(toorder, j, b);
                b++;
                mask &= mask - 1U;
            }
            i += 16;
        } while (hi - i >= 16);
    }
#endif

    for (; i < hi; i++) {
	if (toorder[i] < pivot) {
	    swap(toorder, i, b);
	    b++;
	}
    }
    swap(toorder, hi, b);
    return b;
}

/*
 * Check if elements are in non-decreasing order
 */
int is_sorted(int *toorder, int N)
{
    for (int i = 1; i < N; i++) {
	if (toorder[i] < toorder[i - 1]) {
	    return 1;
	}
    }
    return 0;
}


/*
 * Generate a case
 */
int *generate_case(int N)
{
    int i;
    int *ret = NULL;

    // Make case generation reproducible
    srandnum(0);

    // Allocate memory
    ret = (int *) malloc(N * sizeof(int));
    if (ret == NULL) {
	printf("Error: some malloc won't work.\n");
	return NULL;
    }
    // Get pseudo-random positive integer values
    for (i = 0; i < N; i++) {
	ret[i] = drand(0, INT_MAX);
    }
    return ret;
}

/*
 * A pseudo-random number between two positive integer values
 */
double drand(int xmin, int xmax)
{
    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;
}

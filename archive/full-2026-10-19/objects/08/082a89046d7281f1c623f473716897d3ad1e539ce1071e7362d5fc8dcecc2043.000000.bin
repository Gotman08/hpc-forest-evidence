        "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <cstring>\n#include <limits>\n#include <vector>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#define SUM_USE_NEON 1\n#else\n#define SUM_USE_NEON 0\n#endif\n\nnamespace {\n\nclass FastInput {\n    static constexpr std::size_t Capacity = 1u << 16;\n    unsigned char buffer_[Capacity];\n    std::size_t position_ = 0;\n    std::size_t size_ = 0;\n\n    int next_char() {\n        if (position_ == size_) {\n            size_ = std::fread(buffer_, 1, Capacity, stdin);\n            position_ = 0;\n            if (size_ == 0) return EOF;\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    bool read_int32(std::int32_t& result) {\n        int c = next_char();\n        while (c != EOF && c <= ' ') c = next_char();\n        if (c == EOF) return false;\n        const bool negative = c == '-';\n        if (c == '-' || c == '+') c = next_char();\n        std::uint32_t magnitude = 0;\n        while (static_cast<unsigned>(c - '0') < 10u) {\n            magnitude = magnitude * 10u + static_cast<std::uint32_t>(c - '0');\n            c = next_char();\n        }\n        const std::int64_t value = negative\n            ? -static_cast<std::int64_t>(magnitude)\n            : static_cast<std::int64_t>(magnitude);\n        result = static_cast<std::int32_t>(value);\n        return true;\n    }\n};\n\ntemplate <bool Update>\ninline void scan64(std::int64_t* columns,\n                   const std::int32_t* entering,\n                   const std::int32_t* leaving,\n                   int n, int s, std::int64_t& best) {\n    std::int64_t sum = 0;\n    for (int c = 0; c < s; ++c) {\n        if (Update) {\n            columns[c] += static_cast<std::int64_t>(entering[c])\n                        - static_cast<std::int64_t>(leaving[c]);\n        }\n        sum += columns[c];\n    }\n    best = std::max(best, sum);\n    for (int c = s; c < n; ++c) {\n        if (Update) {\n            columns[c] += static_cast<std::int64_t>(entering[c])\n                        - static_cast<std::int64_t>(leaving[c]);\n        }\n        sum += columns[c] - columns[c - s];\n        best = std::max(best, sum);\n    }\n}\n\nstd::int64_t solve64(const std::int32_t* matrix, int n, int s) {\n    std::vector<std::int64_t> columns(n, 0);\n    for (int r = 0; r < s; ++r) {\n        const std::int32_t* row = matrix + static_cast<std::size_t>(r) * n;\n        for (int c = 0; c < n; ++c) columns[c] += row[c];\n    }\n    std::int64_t best = std::numeric_limits<std::int64_t>::min();\n    scan64<false>(columns.data(), nullptr, nullptr, n, s, best);\n    for (int top = 1; top <= n - s; ++top) {\n        const std::int32_t* entering = matrix\n            + static_cast<std::size_t>(top + s - 1) * n;\n        const std::int32_t* leaving = matrix\n            + static_cast<std::size_t>(top - 1) * n;\n        scan64<true>(columns.data(), entering, leaving, n, s, best);\n    }\n    return best;\n}\n\n#if SUM_USE_NEON\n\ninline std::int32_t signed_bits(std::uint32_t bits) {\n    std::int32_t value;\n    std::memcpy(&value, &bits, sizeof(value));\n    return value;\n}\n\ninline uint32x4_t prefix4(uint32x4_t value) {\n    const uint32x4_t zero = vdupq_n_u32(0);\n    value = vaddq_u32(value, vextq_u32(zero, value, 3));\n    return vaddq_u32(value, vextq_u32(zero, value, 2));\n}\n\ntemplate <bool Update>\ninline std::uint32_t column_scalar(std::uint32_t* columns,\n                                   const std::int32_t* entering,\n                                   const std::int32_t* leaving, int c) {\n    std::uint32_t value = columns[c];\n    if (Update) {\n        value -= static_cast<std::uint32_t>(leaving[c]);\n        value += static_cast<std::uint32_t>(entering[c]);\n        columns[c] = value;\n    }\n    return value;\n}\n\ntemplate <bool Update>\ninline uint32x4_t column_vector(std::uint32_t* columns,\n                               const std::int32_t* entering,\n                               const std::int32_t* leaving, int c) {\n    uint32x4_t value = vld1q_u32(columns + c);\n    if (Update) {\n        value = vsubq_u32(value,\n            vreinterpretq_u32_s32(vld1q_s32(leaving + c)));\n        value = vaddq_u32(value,\n            vreinterpretq_u32_s32(vld1q_s32(entering + c)));\n        vst1q_u32(columns + c, value);\n    }\n    return value;\n}\n\ntemplate <bool Update>\ninline void scan32(std::uint32_t* columns,\n                   const std::int32_t* entering,\n                   const std::int32_t* leaving,\n                   int n, int s, std::int32_t& scalar_best,\n                   int32x4_t& maximum0, int32x4_t& maximum1) {\n    uint32x4_t partial0 = vdupq_n_u32(0);\n    uint32x4_t partial1 = vdupq_n_u32(0);\n    int c = 0;\n    for (; c + 7 < s; c += 8) {\n        const uint32x4_t a = column_vector<Update>(columns, entering, leaving, c);\n        const uint32x4_t b = column_vector<Update>(columns, entering, leaving, c + 4);\n        partial0 = vaddq_u32(partial0, a);\n        partial1 = vaddq_u32(partial1, b);\n    }\n    if (c + 3 < s) {\n        partial0 = vaddq_u32(partial0,\n            column_vector<Update>(columns, entering, leaving, c));\n        c += 4;\n    }\n    std::uint32_t sum = vaddvq_u32(vaddq_u32(partial0, partial1));\n    for (; c < s; ++c) {\n        sum += column_scalar<Update>(columns, entering, leaving, c);\n    }\n    scalar_best = std::max(scalar_best, signed_bits(sum));\n    uint32x4_t carry = vdupq_n_u32(sum);\n\n    // Complete the entering stores before outgoing loads: s can be below eight.\n    for (; c + 7 < n; c += 8) {\n        const uint32x4_t incoming0 = column_vector<Update>(columns, entering, leaving, c);\n        const uint32x4_t incoming1 = column_vector<Update>(columns, entering, leaving, c + 4);\n        const uint32x4_t delta0 = vsubq_u32(incoming0, vld1q_u32(columns + c - s));\n        const uint32x4_t delta1 = vsubq_u32(incoming1, vld1q_u32(columns + c - s + 4));\n        const uint32x4_t prefix0 = prefix4(delta0);\n        const uint32x4_t prefix1 = prefix4(delta1);\n        const uint32x4_t windows0 = vaddq_u32(carry, prefix0);\n        const uint32x4_t windows1 = vaddq_u32(\n            vdupq_laneq_u32(windows0, 3), prefix1);\n        carry = vdupq_laneq_u32(windows1, 3);\n        maximum0 = vmaxq_s32(maximum0, vreinterpretq_s32_u32(windows0));\n        maximum1 = vmaxq_s32(maximum1, vreinterpretq_s32_u32(windows1));\n    }\n    if (c + 3 < n) {\n        const uint32x4_t incoming = column_vector<Update>(columns, entering, leaving, c);\n        const uint32x4_t delta = vsubq_u32(incoming, vld1q_u32(columns + c - s));\n        const uint32x4_t windows = vaddq_u32(carry, prefix4(delta));\n        carry = vdupq_laneq_u32(windows, 3);\n        maximum0 = vmaxq_s32(maximum0, vreinterpretq_s32_u32(windows));\n        c += 4;\n    }\n    sum = vgetq_lane_u32(carry, 0);\n    for (; c < n; ++c) {\n        const std::uint32_t incoming = column_scalar<Update>(columns, entering, leaving, c);\n        sum += incoming - columns[c - s];\n        scalar_best = std::max(scalar_best, signed_bits(sum));\n    }\n}\n\nstd::int32_t solve32(const std::int32_t* matrix, int n, int s) {\n    std::vector<std::uint32_t> columns(n, 0);\n    for (int r = 0; r < s; ++r) {\n        const std::int32_t* row = matrix + static_cast<std::size_t>(r) * n;\n        int c = 0;\n        for (; c + 3 < n; c += 4) {\n            const uint32x4_t value = vaddq_u32(vld1q_u32(columns.data() + c),\n                vreinterpretq_u32_s32(vld1q_s32(row + c)));\n            vst1q_u32(columns.data() + c, value);\n        }\n        for (; c < n; ++c) columns[c] += static_cast<std::uint32_t>(row[c]);\n    }\n    std::int32_t best = std::numeric_limits<std::int32_t>::min();\n    int32x4_t maximum0 = vdupq_n_s32(best);\n    int32x4_t maximum1 = maximum0;\n    scan32<false>(columns.data(), nullptr, nullptr, n, s, best, maximum0, maximum1);\n    for (int top = 1; top <= n - s; ++top) {\n        const std::int32_t* entering = matrix\n            + static_cast<std::size_t>(top + s - 1) * n;\n        const std::int32_t* leaving = matrix\n            + static_cast<std::size_t>(top - 1) * n;\n        scan32<true>(columns.data(), entering, leaving, n, s, best, maximum0, maximum1);\n    }\n    return std::max(best, vmaxvq_s32(vmaxq_s32(maximum0, maximum1)));\n}\n\n#endif\n\n}\n\nint main() {\n    FastInput input;\n    std::int32_t input_n, input_s;\n    if (!input.read_int32(input_n) || !input.read_int32(input_s)) return 0;\n    const int n = input_n;\n    const int s = input_s;\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    std::vector<std::int32_t> matrix(static_cast<std::size_t>(n) * n);\n    std::int32_t minimum = std::numeric_limits<std::int32_t>::max();\n    std::int32_t maximum = std::numeric_limits<std::int32_t>::min();\n    for (std::size_t i = 0; i < matrix.size(); ++i) {\n        std::int32_t value;\n        if (!input.read_int32(value)) return 0;\n        matrix[i] = value;\n        minimum = std::min(minimum, value);\n        maximum = std::max(maximum, value);\n    }\n\n    // Every complete window must fit signed 32 bits before signed SIMD maxima.\n    // Unsigned prefix intermediates may wrap, with defined modulo arithmetic.\n    const std::int64_t area = static_cast<std::int64_t>(s) * s;\n    const bool narrow = area * static_cast<std::int64_t>(minimum)\n                            >= std::numeric_limits<std::int32_t>::min()\n                     && area * static_cast<std::int64_t>(maximum)\n                            <= std::numeric_limits<std::int32_t>::max();\n#if SUM_USE_NEON\n    const std::int64_t answer = narrow\n        ? solve32(matrix.data(), n, s)\n        : solve64(matrix.data(), n, s);\n#else\n    (void)narrow;\n    const std::int64_t answer = solve64(matrix.data(), n, s);\n#endif\n    std::printf(\"%lld\\n\", static_cast<long long>(answer));\n    return 0;\n}\n",

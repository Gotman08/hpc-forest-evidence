        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <math.h>\n#include <string.h>\n#include <stdint.h>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\n#define MAXNUM 100\n#define MAXSTR 50\n#define MAXRESULTS 1000\n\nchar firstHalf[MAXNUM][MAXSTR];\nchar secondHalf[MAXNUM][MAXSTR];\nchar strToTest[MAXSTR];\nlong int result[MAXRESULTS];\nint numPrimes=0;\n\nstatic long int candidates[MAXNUM * MAXNUM];\nenum { SIEVE_SIZE = 65536, DIVISOR_CAPACITY = SIEVE_SIZE / 2 };\nstatic unsigned char composite[SIEVE_SIZE];\nstatic uint32_t divisor_inverse[DIVISOR_CAPACITY];\nstatic uint32_t divisor_threshold[DIVISOR_CAPACITY];\nstatic uint32_t divisor_square[DIVISOR_CAPACITY];\nstatic size_t divisor_count;\nstatic uint32_t prepared_maximum;\n\nstatic void prepare_divisors(uint32_t maximum)\n{\n    uint32_t limit;\n    if (maximum <= prepared_maximum)\n        return;\n\n    limit = (uint32_t)sqrt((double)maximum);\n    while ((uint64_t)(limit + 1u) * (limit + 1u) <= maximum)\n        ++limit;\n    while ((uint64_t)limit * limit > maximum)\n        --limit;\n\n    memset(composite, 0, (size_t)limit + 1u);\n    divisor_count = 0;\n    for (uint32_t p = 3u; p <= limit; p += 2u) {\n        if (composite[p])\n            continue;\n\n        /* Newton iteration computes the odd divisor's inverse modulo 2^32. */\n        uint32_t inverse = 1u;\n        for (unsigned int step = 0; step < 5u; ++step)\n            inverse *= 2u - p * inverse;\n\n        uint32_t square = p * p;\n        divisor_inverse[divisor_count] = inverse;\n        divisor_threshold[divisor_count] = UINT32_MAX / p;\n        divisor_square[divisor_count] = square;\n        ++divisor_count;\n\n        if (square <= limit) {\n            for (uint32_t multiple = square; multiple <= limit;\n                 multiple += 2u * p)\n                composite[multiple] = 1;\n        }\n    }\n    prepared_maximum = maximum;\n}\n\nint isprime(long int value)\n{\n    if (value < 2)\n        return 0;\n    if ((value & 1L) == 0)\n        return value == 2;\n\n    if ((uint64_t)value > UINT32_MAX) {\n        uint64_t n = (uint64_t)value;\n        for (uint64_t factor = 3u; factor <= n / factor; factor += 2u)\n            if (n % factor == 0)\n                return 0;\n        return 1;\n    }\n\n    uint32_t n = (uint32_t)value;\n    prepare_divisors(n);\n    size_t i = 0;\n\n    /* For odd p, p divides n iff low32(n * inverse(p)) <= UINT32_MAX / p. */\n#if defined(__aarch64__)\n    uint32x4_t values = vdupq_n_u32(n);\n    for (; i + 4u <= divisor_count && divisor_square[i + 3u] <= n;\n         i += 4u) {\n        uint32x4_t products = vmulq_u32(\n            values, vld1q_u32(divisor_inverse + i));\n        uint32x4_t divides = vcleq_u32(\n            products, vld1q_u32(divisor_threshold + i));\n        if (vmaxvq_u32(divides) != 0u)\n            return 0;\n    }\n#endif\n    for (; i < divisor_count && divisor_square[i] <= n; ++i)\n        if ((uint32_t)((uint64_t)n * divisor_inverse[i]) <=\n            divisor_threshold[i])\n            return 0;\n    return 1;\n}\n\nvoid quicksort(long int *primes,int first,int last)\n{ int i, j, pivot;\n  long int temp;\n\n  if (first<last)\n     { pivot=first;\n       i=first;\n       j=last;\n       while(i<j)\n         { while (primes[i]<=primes[pivot]&&i<last)\n             i++;\n           while(primes[j]>primes[pivot])\n             j--;\n           if (i<j)\n              { temp=primes[i];\n                primes[i]=primes[j];\n                primes[j]=temp;\n              }\n         }\n       temp=primes[pivot];\n       primes[pivot]=primes[j];\n       primes[j]=temp;\n       quicksort(primes,first,j-1);\n       quicksort(primes,j+1,last);\n     }\n}\n\n\nint main(int argc,char** argv)\n{ FILE *primesFile;\n  int i=0,j=0,numResults=0,numCandidates=0;\n  long int primeToTest;\n  uint32_t maximum32=0;\n  primesFile=stdin;\n  fscanf(primesFile,\"%d\\n\",&numPrimes);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",firstHalf[i]);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",secondHalf[i]);\n  fclose(primesFile);\n  for (i=0;i<numPrimes;i++)\n      for (j=0;j<numPrimes;j++)\n          { strcpy(strToTest,firstHalf[i]);\n            strcat(strToTest,secondHalf[j]);\n            primeToTest=atol(strToTest);\n            candidates[numCandidates++]=primeToTest;\n            if (primeToTest>0 && (uint64_t)primeToTest<=UINT32_MAX &&\n                (uint32_t)primeToTest>maximum32)\n                maximum32=(uint32_t)primeToTest;\n          }\n  prepare_divisors(maximum32);\n  for (i=0;i<numCandidates;i++)\n      { primeToTest=candidates[i];\n        if (isprime(primeToTest))\n           { result[numResults++]=primeToTest;\n           }\n      }\n  quicksort(result,0,numResults-1);\n  for (i=0;i<numResults;i++)\n      printf(\"%ld\\n\",result[i]);\n  return 0;\n}\n",

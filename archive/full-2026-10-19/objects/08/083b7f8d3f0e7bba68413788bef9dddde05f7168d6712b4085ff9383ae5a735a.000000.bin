0;\n    if ((value & 1L) == 0)\n        return value == 2;\n\n    if ((uint64_t)value > UINT32_MAX) {\n        uint64_t n = (uint64_t)value;\n        for (uint64_t factor = 3u; factor <= n / factor; factor += 2u)\n            if (n % factor == 0)\n                return 0;\n        return 1;\n    }\n\n    uint32_t n = (uint32_t)value;\n    prepare_divisors(n);\n    size_t i = 0;\n\n    /* For odd p, p divides n iff low32(n * inverse(p)) <= UINT32_MAX / p. */\n#if defined(__aarch64__)\n    uint32x4_t values = vdupq_n_u32(n);\n    for (; i + 4u <= divisor_count && divisor_square[i + 3u] <= n;\n         i += 4u) {\n        uint32x4_t products = vmulq_u32(\n            values, vld1q_u32(divisor_inverse + i));\n        uint32x4_t divides = vcleq_u32(\n            products, vld1q_u32(divisor_threshold + i));\n        if (vmaxvq_u32(divides) != 0u)\n            return 0;\n    }\n#endif\n    for (; i < divisor_count && divisor_square[i] <= n; ++i)\n        if ((uint32_t)((uint64_t)n * divisor_inverse[i]) <=\n            divisor_threshold[i])\n            return 0;\n    return 1;\n}\n\nvoid quicksort(long int *primes,int first,int last)\n{ int i, j, pivot;\n  long int temp;\n\n  if (first<last)\n     { pivot=first;\n       i=first;\n       j=last;\n       while(i<j)\n         { while (primes[i]<=primes[pivot]&&i<last)\n             i++;\n           while(primes[j]>primes[pivot])\n             j--;\n           if (i<j)\n              { temp=primes[i];\n                primes[i]=primes[j];\n                primes[j]=temp;\n              }\n         }\n       temp=primes[pivot];\n       primes[pivot]=primes[j];\n       primes[j]=temp;\n       quicksort(primes,first,j-1);\n       quicksort(primes,j+1,last);\n     }\n}\n\n\nint main(int argc,char** argv)\n{ FILE *primesFile;\n  int i=0,j=0,numResults=0,numCandidates=0;\n  long int primeToTest;\n  uint32_t maximum32=0;\n  primesFile=stdin;\n  fscanf(primesFile,\"%d\\n\",&numPrimes);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",firstHalf[i]);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",secondHalf[i]);\n  fclose(primesFile);\n  for (i=0;i<numPrimes;i++)\n      for (j=0;j<numPrimes;j++)\n          { strcpy(strToTest,firstHalf[i]);\n            strcat(strToTest,secondHalf[j]);\n            primeToTest=atol(strToTest);\n            candidates[numCandidates++]=primeToTest;\n            if (primeToTest>0 && (uint64_t)primeToTest<=UINT32_MAX &&\n                (uint32_t)primeToTest>maximum32)\n                maximum32=(uint32_t)primeToTest;\n          }\n  prepare_divisors(maximum32);\n  for (i=0;i<numCandidates;i++)\n      { primeToTest=candidates[i];\n        if (isprime(primeToTest))\n           { result[numResults++]=primeToTest;\n           }\n      }\n  quicksort(result,0,numResults-1);\n  for (i=0;i<numResults;i++)\n      printf(\"%ld\\n\",result[i]);\n  return 0;\n}\n",

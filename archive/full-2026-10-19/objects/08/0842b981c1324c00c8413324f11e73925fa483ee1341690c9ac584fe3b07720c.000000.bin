    data=ns['raw'](p);need(expected is None or sha(data)==expected,'Exact cold SHA')
    rec={'path':str(p),'sha256':sha(data),'bytes':len(data),'metadata':list(ns['metadata'](p.lstat()))}
    need(str(p) not in before or before[str(p)]==rec,'Input mutation');before[str(p)]=rec;return data
def doc(path,expected=None):return json.loads(read(path,expected))

def save(name,value):
    p=OUT/name;b=(json.dumps(value,ensure_ascii=False,indent=2)+'\n').encode('utf8')
    with p.open('xb') as f:f.write(b);f.flush();os.fsync(f.fileno())
    need(ns['raw'](p)==b,'Own output reread');return {'path':str(p),'sha256':sha(b),'bytes':len(b)}

{"files":[{"content":"#include<stdio.h>\n#include<stdlib.h>\n#include<math.h>\n\nvoid bubble_sort (double *matriz, int tam) {\n    int i, j;\n    double aux;\n\n    for (i = tam - 1; i > 0; i--) {\n        for (j = 0; j < i; j++) {\n            if (matriz[j] > matriz[j+1]) {\n                aux=matriz[j];\n                matriz[j]=matriz[j+1];\n                matriz[j+1]=aux;\n            }\n        }\n    }\n}\n\nvoid ordena_colunas(double *matriz,int lin, int col) {\n    int i;\n\n    for (i = 0; i < col; i++) {\n        bubble_sort(&matriz[i*lin], lin);\n    }\n}\n\nvoid calcula_medias(double *matriz, double *media, double *media_har, int lin, int col){\n    int i,j;\n    double soma, soma_inversos, valor;\n    for(i=0;i<col;i++){\n        soma=0;\n        soma_inversos=0;\n        for(j=0;j<lin;j++){\n            valor=matriz[i*lin+j];\n            soma+=valor;\n            soma_inversos+=(1/valor);\n        }\n        media[i]=soma/lin;\n        media_har[i]=lin/soma_inversos;\n    }\n}\n\nvoid calcula_mediana(double *matriz, double *vet, int lin, int col) {\n     int i=0;\n     if((lin-1)%2){\n         for (i = 0; i < col; i++) {\n            vet[i]=(matriz[(((i*lin)+(i+1)*lin)-1)/2]+matriz[((((i*lin)+(i+1)*lin)-1)/2)+1]);\n            vet[i]*=0.5;\n         }\n     }\n     else{\n         for (i = 0; i < col; i++) {\n            vet[i]=matriz[(((i*lin)+(i+1)*lin)-1)/2];\n         }\n     }\n}\n\ndouble moda_aux(double *matriz,int lin){\n    int i, j;\n    double *cont;\n    cont=(double*)malloc(lin*sizeof(double));\n    float conta=0, moda=0;\n\n    for(i=0;i<lin;i++){\n        for(j=i+1;j<lin;j++){\n            if(matriz[i]==matriz[j]){\n                cont[i]++;\n                if(cont[i]>conta){\n                    conta=cont[i];\n                    moda=matriz[i];\n                }\n            }\n        }\n        cont[i]=0;\n    }\n    free(cont);\n    if(conta == 0){\n        return -1;\n    }\n    else{\n        return moda;\n    }\n}\n\nvoid calcula_moda(double *matriz,double *moda,int lin, int col){\n    int i;\n    for(i=0;i<col;i++){\n        moda[i]=moda_aux(matriz+(i*lin),lin);\n    }\n}\n\nvoid calcula_variancia(double *matriz, double *media,double *variancia, int lin, int col){\n    int i,j;\n    double soma;\n    for(i=0;i<col;i++){\n        soma=0;\n        for(j=0;j<lin;j++){\n            soma+=pow((matriz[i*lin+j]-media[i]),2);\n        }\n        variancia[i]=soma/(lin-1);\n    }\n}\n\nvoid calcula_desvio_padrao(double *variancia,double *dp, int col){\n    int i;\n    for(i=0;i<col;i++){\n        dp[i]=sqrt(variancia[i]);\n    }\n}\n\nvoid calcula_coeficiente_variacao(double *media,double *dp,double *cv, int col){\n    int i;\n    for(i=0;i<col;i++){\n        cv[i]=dp[i]/media[i];\n    }\n}\n\nint main(int argc,char **argv){\n    int lin,col,i,j;\n    double *matriz,*mediana,*media,*media_har,*moda,*variancia,*dp,*cv;\n\n    fscanf(stdin, \"%d \", &lin);\n    fscanf(stdin, \"%d\\n\", &col);\n\n    matriz=(double *)malloc(lin*col * sizeof(double));\n    media=(double *)malloc(col * sizeof(double));\n    media_har=(double *)malloc(col * sizeof(double));\n    mediana=(double *)malloc(col * sizeof(double));\n    moda=(double *)malloc(col * sizeof(double));\n    variancia=(double *)malloc(col * sizeof(double));\n    cv=(double *)malloc(col * sizeof(double));\n    dp=(double *)malloc(col * sizeof(double));\n\n    for(i=0;i<lin;i++){\n        for(j=0;j<col;j++){\n            fscanf(stdin, \"%lf \",&(matriz[j*lin+i]));\n        }\n    }\n\n    calcula_medias(matriz,media,media_har,lin,col);\n    ordena_colunas(matriz,lin,col);\n    calcula_mediana(matriz,mediana,lin,col);\n    calcula_moda(matriz,moda,lin,col);\n    calcula_variancia(matriz,media,variancia,lin,col);\n    calcula_desvio_padrao(variancia,dp,col);\n    calcula_coeficiente_variacao(media,dp,cv,col);\n\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",media[i]);\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",media_har[i]);\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",mediana[i]);\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",moda[i]);\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",variancia[i]);\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",dp[i]);\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",cv[i]);\n    printf(\"\\n\");\n\n    free(matriz);\n    free(media);\n    free(media_har);\n    free(mediana);\n    free(moda);\n    free(variancia);\n    free(dp);\n    free(cv);\n}\n","path":"src/est_matriz_seq.c"}],"hypothesis":"Combining the arithmetic- and harmonic-mean scans should reduce matrix read traffic while retaining the existing contiguous per-column access pattern, improving cache locality without changing either sum's per-column accumulation order.","notes":"This is a source-level performance hypothesis; the controller evaluates correctness and speed.","sources_kept":[],"transformations":["Replace the separate arithmetic-mean and harmonic-mean matrix traversals with one per-column traversal that accumulates both metrics from each loaded value.","Keep the existing column-major matrix layout and contiguous inner loop; preserve the original accumulation order for each metric and leave sorting, other statistics, and output formatting unchanged."]}
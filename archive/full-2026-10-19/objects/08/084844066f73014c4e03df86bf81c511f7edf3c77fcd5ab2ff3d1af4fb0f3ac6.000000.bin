"""Independent source/data review seal only; never build, render or run pipeline."""
import hashlib
import json
from datetime import datetime, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent
RX = HERE.parent.parent
IMPL = HERE.parent / "impl"
STUDY = RX.parents[2] / "HPC-Forest-Etude-2020-2024-r1"
ED = STUDY / "edition-professionnelle"


def load(path):
    return json.loads(path.read_text(encoding="utf-8-sig"))


def sha(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def ref(path):
    return {"path": str(path), "sha256": sha(path)}


delivery_path = IMPL / "revision-prose-r2/LIVRAISON-IMPLEMENTATION-SOL-R2.json"
assert sha(delivery_path) == "14e0e41cc430e3e056413d060d9a66039c1e63265e407c47f13a09a5178af1f7"
delivery = load(delivery_path)
canonical = {Path(item["path"]).name: item for item in delivery["canonical_files"]}
assert set(canonical) == {"admissions.json", "pipeline.py", "auditer-donnees.py", "assembler.py", "figures.py", "controler.py", "manuscrit.md", "source_only_sol_accounting.py"}
for item in [*canonical.values(), *delivery["new_root_exports"]]:
    path = Path(item["path"])
    assert path.is_file() and sha(path) == item["sha256"] and path.stat().st_size == item["bytes"]
assert len(delivery["new_root_exports"]) == 8
preservation_path = IMPL / "PRESERVATION-VERIFIEE.json"
assert sha(preservation_path) == "f9c4c548f1dcaa1cdbefa9aa80a24cb1de19f98f0d18f5d3fa94363ae532e280"
preservation = load(preservation_path)
copies_path = Path(preservation["copies"]["path"])
assert sha(copies_path) == preservation["copies"]["sha256"]
destination = Path(preservation["destination"])
copies = load(copies_path)
assert len(copies) == preservation["all_preserved_files"] == 1203
for name, item in copies.items():
    path = destination / name
    assert path.resolve().is_relative_to(destination.resolve()) and not path.is_symlink()
    assert sha(path) == item["sha256"] and path.stat().st_size == item["bytes"]
old = load(destination / "edition-professionnelle/admissions.json")
new = load(ED / "admissions.json")
for name in ("r1", "cpu", "gpt96", "r4"):
    assert new["received_file_paths"][name] == old["received_file_paths"][name]
assert new["reviewed_new_cohorts"][:-1] == old["reviewed_new_cohorts"]
assert new["reviewed_new_cohorts"][-1]["cohort"] == "source_only_sol_max_fifteen_subjects"
assert len(new["received_file_paths"]["source_only"]) == len(set(new["received_file_paths"]["source_only"]))
assert set(old["received_file_paths"]["source_only"]) <= set(new["received_file_paths"]["source_only"])
audit_path = ED / "audit-calculs.json"
assert sha(audit_path) == "fe0119451bffd4bc47817d6ad957ddc0524b48d6915e8ed208ee0a3dfdcab6ed"
audit = load(audit_path)
assert audit["verified"] is True and audit["scientific_input_files_unchanged"] is True
assert audit["registry_count"] == 209 and audit["research_confirmation_rows"] == 193
assert audit["program_executions"] == audit["candidate_edits"] == audit["model_calls"] == 0
rows = load(ED / "donnees/confirmations-recalculees.json")
native = [row for row in rows if row["cohort"] != "deepseek"]
assert len(rows) == 193 and len({row["cohort"] for row in native}) == 14
assert sum(row["native_calls"] for row in native) == 1701
assert sum(row["known_exact_tokens"] for row in native) == 36472761
assert sum(row["unmetered_calls"] for row in native) == 154
controls_path = HERE / "CONTROLES-COMPTABLES.json"
controls = load(controls_path)
assert controls["verified"] is True and controls["count"] == 8
assert all(item["passed"] for item in controls["checks"])
manuscript = (ED / "manuscrit.md").read_text(encoding="utf8")
assert "trois couvertures Luna, Astra et Terra xhigh" in manuscript
assert "quatre cohortes source-only de quinze recherches chacune" in manuscript
assert "cinquante et un programmes modifiés sur soixante recherches" in manuscript
assert "neuf références sont conservées" in manuscript
assert sha(IMPL / "revision-prose-r2/manuscrit-precedent.md") == "915b688d3d703a9119f1d8a4fc2cb8ec3baf12fb7e7e99bf576dd1b418640763"
source_counts = []
for model in ("luna", "astra", "terra", "sol"):
    value = load(STUDY / ("resultats-source-only-" + model + "-max.json"))
    source_counts.append({"model": model, "subjects": len(value["rows"]), "retained_baselines": value["retained_baselines"]})
assert sum(item["subjects"] for item in source_counts) == 60
assert sum(item["retained_baselines"] for item in source_counts) == 9
report = {"schema": "hpc-forest-professional-sol-admission-independent-code-review-v1", "verified": True,
    "blocking_findings": [], "observed_utc": datetime.now(timezone.utc).isoformat(), "job_id": "751592",
    "session_id": "665743a02b824021a697b6a4884a667c", "verification_scope": "canonical source admission + cold accounting/data + prose revision only; no build or visual review",
    "decision": "GO parent canonical consolidation/build/control; new pixels must still be rendered and actually inspected",
    "implementation_delivery": ref(delivery_path), "reviewed_files": canonical,
    "source_and_data_facts": {"scientific_audit": ref(audit_path), "registry_count": 209, "principal_results": 193,
        "closed_native_cohorts": 14, "native_invocations_observed": 1701, "known_exact_tokens": 36472761,
        "unmeasured_native_invocations": 154, "global_exact_consumption_total": None,
        "new_sol_subjects": 15, "source_only_MAX_received": 60, "source_only_modified_programs": 51,
        "source_only_retained_baselines": 9, "source_only_counts": source_counts,
        "CPU_timing_count_unchanged_as_audited": 11575},
    "preservation": {"receipt": ref(preservation_path), "copies_manifest": ref(copies_path),
        "copies_actually_rehashed_by_reviewer": 1203, "PDF_bytes_hashed_only_not_visually_inspected": True,
        "parent_marker_success_and_edit_GO": "explicit parent messages, not fabricated by reviewer"},
    "checked_invariants": ["Sol uses six genuine SHA-bound received schemas and immutable payload_refs, with no legacy worker-path accounting.",
        "124requests/121observedCLI/111measuredCLI/114exact-valuedrequests/10null/3provenzero remain distinct; input+output excludes duplicated cache/reasoning subdivisions.",
        "Mother25requests24CLI, ABC89requests87CLI, G10requests10CLI; G is never counted again as an ordinary child.",
        "Explicit CLI-observed plotting alias retains backend-identity false; no physical model/performance certification inferred.",
        "Historical Sol campaign is removed before adding closed calls; session+nonce uniqueness is asserted; Windows audit discovery is set-deduplicated.",
        "Previous reviewed cohorts and r1/cpu/gpt96/r4 received-file paths stay exact; Terra supplementary discovery adds no new Terra cohort.",
        "Source-only94 scientific reception is separate from pending local natural exit and future R3/R4/R5 admissions."],
    "reviewer_tests": {"targeted_metadata_and_adversarial_checks_passed": 8, "receipt": ref(controls_path),
        "canonical_pipeline_audit_figure_renderer_controller_executed_by_reviewer": False},
    "resolved_finding": {"kind": "stale abstract cohort counts", "prior_manuscript": ref(IMPL / "revision-prose-r2/manuscrit-precedent.md"),
        "fixed": "Abstract now reports3xhigh,4source-only cohorts/60researches/51modified/9references; old prose and delivery preserved."},
    "limits": ["No new PDF/HTML was built, rendered, or inspected by this reviewer; old visual receipts cannot certify the new edition.",
        "Editorial admission does not prove a normal future native first candidate/evaluation or independent physical backend/performance.",
        "The local SO relay closure is pending natural exit; no stop/absence/route-release receipt is invented."],
    "visual_review_done": False, "pipeline_or_build_or_controler_executed": False,
    "live_cache_worker_lock_CIM_RPC_or_model_CLI_calls": 0, "candidate_or_C_executions": 0,
    "production_source_or_foreign_objects_modified_by_reviewer": False}
path = HERE / "REVUE-CODE-ADMISSION-SOL.json"
with path.open("x", encoding="utf8", newline="\n") as stream:
    stream.write(json.dumps(report, indent=2, ensure_ascii=False) + "\n")
print(json.dumps({"path": str(path), "sha256": sha(path)}))

      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\ntypedef struct {\n    long int *data;\n    int length;\n    long int total;\n} bucket;\n\nstatic int compare_indices(const char *strings, const bucket *current,\n                           long int left, long int right) {\n    return strcmp(strings + (size_t)left * (size_t)current->length,\n                  strings + (size_t)right * (size_t)current->length);\n}\n\nstatic void sift_down(const char *strings, bucket *current,\n                      long int root, long int count) {\n    while (root < count / 2) {\n        long int child = root * 2 + 1;\n        if (child + 1 < count &&\n            compare_indices(strings, current, current->data[child],\n                            current->data[child + 1]) < 0) {\n            ++child;\n        }\n        if (compare_indices(strings, current, current->data[root],\n                            current->data[child]) >= 0) {\n            break;\n        }\n        long int tmp = current->data[root];\n        current->data[root] = current->data[child];\n        current->data[child] = tmp;\n        root = child;\n    }\n}\n\nstatic void sort_bucket(const char *strings, bucket *current) {\n    for (long int start = current->total / 2; start > 0; --start) {\n        sift_down(strings, current, start - 1, current->total);\n    }\n    for (long int end = current->total; end > 1; --end) {\n        long int tmp = current->data[0];\n        current->data[0] = current->data[end - 1];\n        current->data[end - 1] = tmp;\n        sift_down(strings, current, 0, end - 1);\n    }\n}\n\nstatic long int *bucket_sort(char *strings, int length,\n                             long int size, int offset, int nbuckets) {\n    long int *returns = malloc(sizeof(*returns) * (size > 0 ? (size_t)size : 1u));\n    bucket *buckets = calloc((size_t)nbuckets, sizeof(*buckets));\n    long int *next = malloc(sizeof(*next) * (size_t)nbuckets);\n\n    if (returns == NULL || buckets == NULL || next == NULL) {\n        free(returns);\n        free(buckets);\n        free(next);\n        fputs(\"ERROR memory\\n\", stderr);\n        exit(EXIT_FAILURE);\n    }\n\n    for (int i = 0; i < nbuckets; ++i) {\n        buckets[i].length = length;\n    }\n\n    for (long int i = 0; i < size; ++i) {\n        int id = (int)(unsigned char)strings[(size_t)i * (size_t)length] - offset;\n        ++buckets[id].total;\n    }\n\n    long int base = 0;\n    for (int i = 0; i < nbuckets; ++i) {\n        buckets[i].data = returns + base;\n        next[i] = 0;\n        base += buckets[i].total;\n    }\n\n    for (long int i = 0; i < size; ++i) {\n        int id = (int)(unsigned char)strings[(size_t)i * (size_t)length] - offset;\n        buckets[id].data[next[id]++] = i;\n    }\n\n    #pragma omp parallel for schedule(guided, 1) if(nbuckets > 1)\n    for (int i = 0; i < nbuckets; ++i) {\n        sort_bucket(strings, &buckets[i]);\n    }\n\n    free(next);\n    free(buckets);\n    return returns;\n}\n\nstatic void load(char **strings_out, long int *size_out,\n                 int *length_out, int *offset_out, int *nbuckets_out) {\n    int length;\n    int offset;\n    int nbucket;\n    long int size;\n\n    if (fscanf(stdin, \"%d\", &length) != 1) {\n        fputs(\"ERROR len\\n\", stderr);\n        exit(EXIT_FAILURE);\n    }\n    if (fscanf(stdin, \"%ld\", &size) != 1) {\n        fputs(\"ERROR n\\n\", stderr);\n        exit(EXIT_FAILURE);\n    }\n    if (fscanf(stdin, \"%d\", &offset) != 1) {\n        fputs(\"ERROR offset\\n\", stderr);\n        exit(EXIT_FAILURE);\n    }\n    if (fscanf(stdin, \"%d\", &nbucket) != 1) {\n        fputs(\"ERROR nbucket\\n\", stderr);\n        exit(EXIT_FAILURE);\n    }\n\n    ++nbucket;\n    ++length;\n    char *strings = malloc((size > 0 ? (size_t)size : 1u) * (size_t)length);\n    if (strings == NULL) {\n        fputs(\"ERROR memory\\n\", stderr);\n        exit(EXIT_FAILURE);\n    }\n\n    for (long int i = 0; i < size; ++i) {\n        if (fscanf(stdin, \"%s\", strings + (size_t)i * (size_t)length) != 1) {\n            fprintf(stderr, \"ERROR %ld\\n\", i);\n            free(strings);\n            exit(EXIT_FAILURE);\n        }\n    }\n\n    *strings_out = strings;\n    *size_out = size;\n    *length_out = length;\n    *offset_out = offset;\n    *nbuckets_out = nbucket;\n}\n\nstatic void save(const char *strings, const long int *index,\n                 long int size, int length) {\n    for (long int i = 0; i < size; ++i) {\n        printf(\"%s\\n\", strings + (size_t)index[i] * (size_t)length);\n    }\n}\n\nint main(void) {\n    char *strings = NULL;\n    long int size = 0;\n    long int *index = NULL;\n    int length = 0;\n    int offset = 0;\n    int nbuckets = 0;\n\n    load(&strings, &size, &length, &offset, &nbuckets);\n    index = bucket_sort(strings, length, size, offset, nbuckets);\n    save(strings, index, size, length);\n\n    free(strings);\n    free(index);\n    return EXIT_SUCCESS;\n}\n",
      "path": "src/bucketsort.c"
    }

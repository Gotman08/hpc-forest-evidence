  carry = filled - ready;\\n+                            break;\\n+                        }\\n+                    }\\n+                    input[filled] = ' ';\\n+                }\\n+            }\\n+            if (done) break;\\n+\\n+            const unsigned char* raw = input.get();\\n+            std::size_t begin = ready * static_cast<std::size_t>(id) / team;\\n+            std::size_t end = ready * static_cast<std::size_t>(id + 1) / team;\\n+            if (id != 0)\\n+                while (begin < ready && raw[begin] > ' ') ++begin;\\n+            if (id + 1 != team)\\n+                while (end < ready && raw[end] > ' ') ++end;\\n+\\n+            unsigned int count = 0;\\n+            if (begin < end) {\\n+                count = static_cast<unsigned int>(raw[begin] > ' ');\\n+#pragma omp simd reduction(+:count)\\n+                for (std::size_t k = begin + 1; k < end; ++k)\\n+                    count += static_cast<unsigned int>(\\n+                        (raw[k] > ' ') & (raw[k - 1] <= ' '));\\n+            }\\n+            counts[id].value = count;\\n+#pragma omp barrier\\n+            std::size_t base = processed;\\n+            for (int t = 0; t < id; ++t) base += counts[t].value;\\n+            const std::size_t emit = base < cells\\n+                ? std::min<std::size_t>(counts[id].value, cells - base) : 0;\\n+            if (emit != 0) {\\n+                int* destination = matrix.get() + base;\\n+                const unsigned char* p = raw + begin;\\n+                for (std::size_t k = 0; k < emit; ++k) {\\n+             \"}], \"interactions\": [{\"sources\": [\"a0bf3699cfd948e2\", \"a015e668dbf34edb\", \"1ee1c333a3694ddb\"], \"outcome\": {\"binary_sha256\": \"7b0c952a4e11e9d25ab500e95716dfd52cedc6c75f5addb0a93cd744e0b3ea34\", \"cache_key\": \"39d54cddc269bb86caf917d2cda7232da1492a5c0655f02da474370348a7e05d\", \"commit\": \"7257a1ed4c707ed01e48f55ae86e8d366ea8c065\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-g
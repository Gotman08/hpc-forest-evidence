{
  "src/npbonacci.cpp": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\nusing u32 = std::uint32_t;\nusing u64 = std::uint64_t;\n\nstatic constexpr u32 MOD = 1000000007U;\n\nstatic inline u32 reflect_coefficient(u32 value, int degree) {\n    return ((degree & 1) && value != 0) ? MOD - value : value;\n}\n\nstatic inline u32 convolution_coefficient(const u32* a, const u32* b,\n                                          int first, int last, int degree) {\n    u64 sum = 0;\n    int j = first;\n    // A reduced accumulator plus sixteen products fits in uint64_t.\n    for (; j + 15 <= last; j += 16) {\n        for (int k = 0; k < 16; ++k) {\n            sum += static_cast<u64>(a[j + k]) * b[degree - j - k];\n        }\n        sum %= MOD;\n    }\n    for (; j <= last; ++j) {\n        sum += static_cast<u64>(a[j]) * b[degree - j];\n    }\n    return static_cast<u32>(sum % MOD);\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n;\n    u64 h;\n    if (!(std::cin >> n >> h)) {\n        return 0;\n    }\n\n    std::vector<u32> initial(n);\n    std::vector<u32> denominator(n + 1);\n    for (int i = 0; i < n; ++i) {\n        u64 value;\n        std::cin >> value;\n        initial[i] = static_cast<u32>(value % MOD);\n    }\n\n    denominator[0] = 1;\n    for (int i = 1; i <= n; ++i) {\n        u64 value;\n        std::cin >> value;\n        const u32 residue = static_cast<u32>(value % MOD);\n        denominator[i] = residue == 0 ? 0 : MOD - residue;\n    }\n\n    if (h >= 1 && h <= static_cast<u64>(n)) {\n        std::cout << initial[static_cast<std::size_t>(h - 1)] << \"\\n\";\n        return 0;\n    }\n\n    std::vector<u32> numerator(n), next_numerator(n);\n    std::vector<u32> reflected(n + 1), next_reflected(n + 1);\n    std::vector<u32> next_denominator(n + 1);\n\n    // Keep one team across all halving steps; small orders remain serial.\n#ifdef _OPENMP\n#pragma omp parallel if(n >= 256)\n#endif\n    {\n        // Numerator = initial(x) * denominator(x), truncated modulo x^n.\n#ifdef _OPENMP\n#pragma omp for schedule(static, 16)\n#endif\n        for (int i = 0; i <= n; ++i) {\n            reflected[i] = reflect_coefficient(denominator[i], i);\n            if (i < n) {\n                numerator[i] = convolution_coefficient(\n                    initial.data(), denominator.data(), 0, i, i);\n            }\n        }\n\n        // Each worker maintains the same private coefficient index.\n        u64 index = h - 1;\n        while (index != 0) {\n            const int parity = static_cast<int>(index & 1U);\n\n            // Block-cyclic assignment balances the triangular dot lengths.\n#ifdef _OPENMP\n#pragma omp for schedule(static, 16)\n#endif\n            for (int i = 0; i <= n; ++i) {\n                if (i < n) {\n                    const int degree = 2 * i + parity;\n                    next_numerator[i] = convolution_coefficient(\n                        numerator.data(), reflected.data(),\n                        std::max(0, degree - n),\n                        std::min(n - 1, degree), degree);\n                }\n\n                // Only even coefficients of Q(x)Q(-x) are needed.\n                // Off-diagonal terms occur in equal pairs modulo MOD.\n                const int degree = 2 * i;\n                const u32 pairs = convolution_coefficient(\n                    denominator.data(), reflected.data(),\n                    std::max(0, degree - n), i - 1, degree);\n                const u64 diagonal =\n                    static_cast<u64>(denominator[i]) * reflected[i];\n                // Reduce the pair sum before doubling, then add the diagonal.\n                const u32 value = static_cast<u32>(\n                    (2ULL * pairs + diagonal) % MOD);\n                next_denominator[i] = value;\n                next_reflected[i] = reflect_coefficient(value, i);\n            }\n\n            // The work-sharing barrier completes every output before swapping.\n#ifdef _OPENMP\n#pragma omp single\n#endif\n            {\n                numerator.swap(next_numerator);\n                denominator.swap(next_denominator);\n                reflected.swap(next_reflected);\n            }\n            // The single-region barrier publishes all three buffer swaps.\n            index >>= 1;\n        }\n    }\n\n    // The denominator's constant coefficient remains one at every step.\n    std::cout << numerator[0] << \"\\n\";\n    return 0;\n}\n"
}

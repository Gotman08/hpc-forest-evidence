        "content": "#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n    vector<vector<bool> > blockedCells(n, vector<bool>(n, false));\n    for (int c = 0; c < m; c++) {\n        int i, j;\n        cin >> i >> j;\n        blockedCells[i][j] = true;\n    }\n\n    vector<int> dp(n, 0);\n    if (!blockedCells[0][0])\n        dp[0] = 1;\n    for (int j = 1; j < n; j++) {\n        if (!blockedCells[0][j])\n            dp[j] = dp[j - 1];\n    }\n\n    for (int i = 1; i < n; i++) {\n        if (blockedCells[i][0])\n            dp[0] = 0;\n        for (int j = 1; j < n; j++) {\n            if (blockedCells[i][j]) {\n                dp[j] = 0;\n            } else {\n                int sum = dp[j] + dp[j - 1];\n                if (sum >= MOD)\n                    sum -= MOD;\n                dp[j] = sum;\n            }\n        }\n    }\n\n    cout << dp[n - 1] << endl;\n}\n",
        "path": "src/solution.cpp"
      }

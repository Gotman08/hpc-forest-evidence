"""Seal static review only; do not import or execute parent helpers."""
import ast
import hashlib
import json
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
BASE = Path("C:/Users/nicol/Documents/Codex/2026-10-15/cr")
OUT = HERE / "REVUE-HELPERS-SCELLEMENT.json"


def ref(path):
    data = path.read_bytes()
    return {"path": str(path), "bytes": len(data), "sha256": hashlib.sha256(data).hexdigest()}


def main():
    assert not OUT.exists()
    expected = {
        "sceller-edition-sol-parent.py": "a1823c25ca66dd430125d9676ddd5124dffdaff6cd88e64f5a63fce22e24c974",
        "verifier-construction-parent.py": "0c631040dcae4fb9572cca5f6981ddf03c202611a615776b67a572a9db1840ab",
    }
    reviewed = []
    for name, digest in expected.items():
        path = ROOT / name
        value = ref(path)
        assert value["sha256"] == digest
        ast.parse(path.read_text(encoding="utf-8-sig"))
        reviewed.append(value)
    preserved_path = ROOT / "premiere-construction-avant-dates/PREMIER-CONSTAT.json"
    preserved = json.loads(preserved_path.read_text(encoding="utf-8-sig"))
    assert len(preserved["copies"]) == 7
    preserved_files = []
    for value in preserved["copies"]:
        actual = ref(BASE / value["path"])
        assert actual["sha256"] == value["sha256"]
        preserved_files.append(actual)
    result = {
        "schema": "hpc-forest-sol-editorial-sealing-helpers-independent-review-v1",
        "verified": True,
        "observed_utc": datetime.now(UTC).isoformat(),
        "blocking_findings": [],
        "decision": "GO statique des deux helpers; scellement uniquement après contrôle positif et reçus de revue pixels réels",
        "reviewed_files": reviewed,
        "first_build_preservation": ref(preserved_path),
        "first_build_copies_rehashed": preserved_files,
        "material_guards_reviewed": [
            "refus des reçus existants avant mutation de la qualité",
            "six sorties du nouveau build et contrôle mécanique liés par SHA",
            "PDF des deux revues exactement égaux aux PDF du contrôle qualité",
            "planches exactement égales aux chemins du contrôle, nom/indice/bornes calculés et couverture complète",
            "pages individuelles bornées et liées au PNG/page_proofs; ensemble égal au plan de risques",
            "zooms liés au PDF source par SHA et page bornée",
            "livraison dates-r3, revue dates, revue de base et exports R2 épinglés",
            "neuf sources et huit exports vérifiés avant mutation",
            "manifestes antérieurs préservés, aucune publication/recherche/arrêt"
        ],
        "checks_actually_run": ["lecture statique des deux helpers", "SHA et AST sans import", "rehash des sept copies du premier build"],
        "helpers_executed": False,
        "actual_pixel_review": False,
        "final_pdf_control_observed_here": False,
        "limitations": ["Cette revue ne produit aucune preuve pixels ni admission de PDF; les reçus de visuelle doivent encore être établis sur les nouveaux rendus.", "La validation lit des reçus opérateur et ne remplace pas leur observation réelle."],
        "model_remote_process_candidate_calls": 0,
    }
    OUT.write_text(json.dumps(result, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(ref(OUT)))


if __name__ == "__main__":
    main()

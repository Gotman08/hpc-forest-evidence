      "content": "#include \"knn.h\"\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\nstatic char winning_label(const size_t counts[UCHAR_MAX + 1]) {\n    char winner = (char)CHAR_MIN;\n    size_t best_count = 0;\n\n    for (int label = CHAR_MIN; label <= CHAR_MAX; ++label) {\n        size_t count = counts[(unsigned char)label];\n        if (count > best_count) {\n            best_count = count;\n            winner = (char)label;\n        }\n    }\n    return winner;\n}\n\nstatic char knn_insertion(int n_groups, Group *groups, int k,\n                          Point to_evaluate) {\n    char *labels = (char *)malloc(sizeof(char) * (size_t)k);\n    float *distances = (float *)malloc(sizeof(float) * (size_t)k);\n    size_t counts[UCHAR_MAX + 1] = {0};\n\n    for (int i = 0; i < k; ++i) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; ++j) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (int x = 0; x < k; ++x) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (int y = k - 1; y > x; --y) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    for (int i = 0; i < k; ++i) {\n        ++counts[(unsigned char)labels[i]];\n    }\n    free(distances);\n    free(labels);\n    return winning_label(counts);\n}\n\nstatic int compare_keys(const void *a, const void *b) {\n    uint64_t x = *(const uint64_t *)a;\n    uint64_t y = *(const uint64_t *)b;\n    return (x > y) - (x < y);\n}\n\nstatic uint64_t median_key(uint64_t a, uint64_t b, uint64_t c) {\n    if (a > b) {\n        uint64_t temporary = a;\n        a = b;\n        b = temporary;\n    }\n    if (b > c) {\n        b = c;\n    }\n    return a > b ? a : b;\n}\n\nstatic void retain_smallest_keys(uint64_t *keys, size_t count, size_t keep) {\n    if (keep == 0 || keep >= count) {\n        return;\n    }\n\n    enum { PARTITION_BLOCK = 128 };\n    unsigned char low_offsets[PARTITION_BLOCK];\n    unsigned char high_offsets[PARTITION_BLOCK];\n    size_t nth = keep - 1;\n    size_t left = 0;\n    size_t right = count;\n    unsigned depth = 0;\n    for (size_t n = count; n > 1; n >>= 1) {\n        ++depth;\n    }\n    depth *= 2;\n\n    while (right - left > 32) {\n        if (depth == 0) {\n            qsort(keys + left, right - left, sizeof(*keys), compare_keys);\n            return;\n        }\n        --depth;\n\n        size_t middle = left + (right - left) / 2;\n        uint64_t pivot = median_key(keys[left], keys[middle], keys[right - 1]);\n        size_t low = left;\n        size_t high = right;\n        size_t low_begin = 0;\n        size_t high_begin = 0;\n        size_t low_count = 0;\n        size_t high_count = 0;\n\n        while (high - low >= 2 * PARTITION_BLOCK) {\n            if (low_count == 0) {\n                low_begin = 0;\n                for (size_t offset = 0; offset < PARTITION_BLOCK; ++offset) {\n                    low_offsets[low_count] = (unsigned char)offset;\n                    low_count += (size_t)(keys[low + offset] >= pivot);\n                }\n            }\n            if (high_count == 0) {\n                high_begin = 0;\n                for (size_t offset = 0; offset < PARTITION_BLOCK; ++offset) {\n                    high_offsets[high_count] = (unsigned char)offset;\n                    high_count += (size_t)(keys[high - 1 - offset] <= pivot);\n                }\n            }\n\n            size_t exchanges = low_count < high_count ? low_count : high_count;\n            for (size_t index = 0; index < exchanges; ++index) {\n                size_t low_position = low + low_offsets[low_begin + index];\n                size_t high_position = high - 1 - high_offsets[high_begin + index];\n                uint64_t temporary = keys[low_position];\n                keys[low_position] = keys[high_position];\n                keys[high_position] = temporary;\n            }\n            low_begin += exchanges;\n            high_begin += exchanges;\n            low_count -= exchanges;\n            high_count -= exchanges;\n\n            if (low_count == 0) {\n                low += PARTITION_BLOCK;\n            }\n            if (high_count == 0) {\n                high -= PARTITION_BLOCK;\n            }\n        }\n\n        /* Partially scanned boundary blocks remain inside the scalar tail. */\n        while (low < high) {\n            while (low < high && keys[low] < pivot) {\n                ++low;\n            }\n            while (low < high && keys[high - 1] > pivot) {\n                --high;\n            }\n            if (low >= high) {\n                break;\n            }\n            --high;\n            uint64_t temporary = keys[low];\n            keys[low] = keys[high];\n            keys[high] = temporary;\n            ++low;\n        }\n\n        if (nth < high) {\n            right = high;\n        } else if (nth >= low) {\n            left = low;\n        } else {\n            return;\n        }\n    }\n\n    for (size_t i = left + 1; i < right; ++i) {\n        uint64_t value = keys[i];\n        size_t j = i;\n        while (j > left && keys[j - 1] > value) {\n            keys[j] = keys[j - 1];\n            --j;\n        }\n        keys[j] = value;\n    }\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) {\n        return (char)-1;\n    }\n\n    size_t total = 0;\n    for (int i = 0; i < n_groups; ++i) {\n        if (groups[i].length > 0) {\n            size_t length = (size_t)groups[i].length;\n            if (length > SIZE_MAX - total) {\n                return knn_insertion(n_groups, groups, k, to_evaluate);\n            }\n            total += length;\n        }\n    }\n\n    size_t counts[UCHAR_MAX + 1] = {0};\n    if ((size_t)k >= total) {\n        for (int i = 0; i < n_groups; ++i) {\n            if (groups[i].length > 0) {\n                counts[(unsigned char)groups[i].label] +=\n                    (size_t)groups[i].length;\n            }\n        }\n        counts[(unsigned char)-1] += (size_t)k - total;\n        return winning_label(counts);\n    }\n\n    if (sizeof(float) != sizeof(uint32_t) ||\n        total > SIZE_MAX / sizeof(uint64_t)) {\n        return knn_insertion(n_groups, groups, k, to_evaluate);\n    }\n\n    uint64_t *keys = (uint64_t *)malloc(total * sizeof(*keys));\n    if (keys == NULL) {\n        return knn_insertion(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t position = 0;\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; ++j) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            uint32_t bits;\n            memcpy(&bits, &d, sizeof(bits));\n            bits &= UINT32_C(0x7fffffff);\n            if (bits > UINT32_C(0x7f800000)) {\n                free(keys);\n                return knn_insertion(n_groups, groups, k, to_evaluate);\n            }\n\n            /* Equal-distance points in one group have identical labels. */\n            keys[position++] = ((uint64_t)bits << 32) | (uint32_t)i;\n        }\n    }\n\n    retain_smallest_keys(keys, total, (size_t)k);\n    for (size_t i = 0; i < (size_t)k; ++i) {\n        ++counts[(unsigned char)groups[(uint32_t)keys[i]].label];\n    }\n    free(keys);\n    return winning_label(counts);\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",

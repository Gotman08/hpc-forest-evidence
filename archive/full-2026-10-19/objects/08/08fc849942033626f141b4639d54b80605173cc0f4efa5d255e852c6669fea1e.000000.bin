      "content": "#include \"knn.h\"\n#ifdef __ARM_NEON\n#include <arm_neon.h>\n#endif\n\ntypedef struct {\n    float dist;\n    char label;\n    long idx;\n} HeapEntry;\n\nstatic inline int worse_entry(const HeapEntry *a, const HeapEntry *b) {\n    if (a->dist != b->dist) return a->dist > b->dist;\n    return a->idx > b->idx;\n}\n\nstatic inline void swap_entries(HeapEntry *a, HeapEntry *b) {\n    HeapEntry t = *a; *a = *b; *b = t;\n}\n\nstatic inline void sift_up(HeapEntry *heap, int pos) {\n    while (pos > 0) {\n        int parent = (pos - 1) / 2;\n        if (worse_entry(&heap[pos], &heap[parent])) {\n            swap_entries(&heap[pos], &heap[parent]);\n            pos = parent;\n        } else break;\n    }\n}\n\nstatic inline void sift_down(HeapEntry *heap, int start, int end) {\n    int root = start;\n    while (1) {\n        int child = 2 * root + 1;\n        if (child > end) break;\n        int right = child + 1;\n        if (right <= end && worse_entry(&heap[right], &heap[child])) child = right;\n        if (worse_entry(&heap[root], &heap[child])) {\n            swap_entries(&heap[root], &heap[child]);\n            root = child;\n        } else break;\n    }\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    long total = 0;\n    for (int gi = 0; gi < n_groups; ++gi) {\n        total += groups[gi].length;\n    }\n\n    float *xs = (float *)malloc(total * sizeof(float));\n    float *ys = (float *)malloc(total * sizeof(float));\n    char *labels = (char *)malloc(total * sizeof(char));\n\n    long pos = 0;\n    for (int gi = 0; gi < n_groups; ++gi) {\n        Group g = groups[gi];\n        char lab = g.label;\n        for (int j = 0; j < g.length; ++j) {\n            xs[pos] = g.points[j].x;\n            ys[pos] = g.points[j].y;\n            labels[pos] = lab;\n            ++pos;\n        }\n    }\n\n    float *dists = (float *)malloc(total * sizeof(float));\n    float tx = to_evaluate.x;\n    float ty = to_evaluate.y;\n\n#ifdef __ARM_NEON\n    float32x4_t vtx = vdupq_n_f32(tx);\n    float32x4_t vty = vdupq_n_f32(ty);\n    long p = 0;\n    for (; p + 3 < total; p += 4) {\n        float32x4_t vxs = vld1q_f32(&xs[p]);\n        float32x4_t vys = vld1q_f32(&ys[p]);\n        float32x4_t dx = vsubq_f32(vxs, vtx);\n        float32x4_t dy = vsubq_f32(vys, vty);\n        float32x4_t d2 = vmlaq_f32(vmulq_f32(dy, dy), dx, dx);\n        vst1q_f32(&dists[p], d2);\n    }\n    for (; p < total; ++p) {\n        float dx = xs[p] - tx;\n        float dy = ys[p] - ty;\n        dists[p] = dx * dx + dy * dy;\n    }\n#else\n    for (long p = 0; p < total; ++p) {\n        float dx = xs[p] - tx;\n        float dy = ys[p] - ty;\n        dists[p] = dx * dx + dy * dy;\n    }\n#endif\n\n    int heap_size = 0;\n    HeapEntry *heap = (HeapEntry *)malloc(k * sizeof(HeapEntry));\n\n    for (long i = 0; i < total; ++i) {\n        float d = dists[i];\n        char lab = labels[i];\n\n        if (heap_size < k) {\n            heap[heap_size].dist = d;\n            heap[heap_size].label = lab;\n            heap[heap_size].idx = i;\n            sift_up(heap, heap_size);\n            ++heap_size;\n        } else {\n            HeapEntry e;\n            e.dist = d; e.label = lab; e.idx = i;\n            if (!worse_entry(&e, &heap[0])) {\n                heap[0] = e;\n                sift_down(heap, 0, k - 1);\n            }\n        }\n    }\n\n    int freq[256] = {0};\n    for (int i = 0; i < heap_size; ++i) {\n        unsigned char c = (unsigned char)heap[i].label;\n        freq[c]++;\n    }\n    for (int i = heap_size; i < k; ++i) {\n        freq[255]++;\n    }\n\n    int max_freq = 0;\n    for (int c = 0; c < 256; ++c) if (freq[c] > max_freq) max_freq = freq[c];\n    char best_label = 0;\n    for (int s = -128; s <= 127; ++s) {\n        unsigned char u = (unsigned char)s;\n        if (freq[u] == max_freq) { best_label = (char)s; break; }\n    }\n\n    free(xs);\n    free(ys);\n    free(labels);\n    free(dists);\n    free(heap);\n\n    return best_label;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n\n    for (int i = 0; i < n_groups; ++i) free(groups[i].points);\n    free(groups);\n\n    return 0;\n}\n",
      "path": "src/knn.c"
    }

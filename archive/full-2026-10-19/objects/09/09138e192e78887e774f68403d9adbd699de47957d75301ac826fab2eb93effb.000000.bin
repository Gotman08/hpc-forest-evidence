"""Preserve crashed interface caches, then resume the same two jobs without replay."""
from __future__ import annotations

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
import zipfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
STUDY = HERE.parents[1]
BASE = STUDY.parent.parent
COMPARE = BASE / "outputs/HPC-Forest-Harnais-Comparaison-r1"
PYTHON = BASE / "work/.venv/Scripts/python.exe"
CLI = Path("C:/Users/nicol/AppData/Local/OpenAI/Codex/bin/9614f1d9b40d9c4f/codex.exe")
FIELDS = ("ProcessId", "ParentProcessId", "ExecutablePath", "CommandLine", "CreationDate")


def save(path, value):
    with path.open("x", encoding="utf8") as stream:
        json.dump(value, stream, indent=2, ensure_ascii=False)
        stream.write("\n")


def load(path):
    return json.loads(path.read_text(encoding="utf-8-sig"))


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def census():
    command = "@(Get-CimInstance Win32_Process | Select-Object ProcessId,ParentProcessId,ExecutablePath,CommandLine,CreationDate) | ConvertTo-Json -Depth 4 -Compress"
    result = subprocess.run(["powershell.exe", "-NoProfile", "-Command", command],
                            capture_output=True, text=True, check=True, timeout=30,
                            creationflags=subprocess.CREATE_NO_WINDOW)
    return json.loads(result.stdout)


def worker_rows(rows):
    pattern = r"hpc_forest\.[a-z0-9_]*worker|reprendre-relais-r1\.py|reprendre-worker\.py"
    return [row for row in rows if (row.get("ExecutablePath") or "").lower().endswith("python.exe")
            and re.search(pattern, row.get("CommandLine") or "", re.IGNORECASE)]


def preserve_tree(source, target):
    manifest = {}
    for path in sorted(source.rglob("*")):
        if path.is_symlink():
            raise RuntimeError("Unsafe symlink in preserved cache")
        if not path.is_file():
            continue
        relative = path.relative_to(source)
        expected = digest(path)
        dest = target / relative
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, dest)
        if digest(dest) != expected or digest(path) != expected:
            raise RuntimeError("Cache changed while preserving")
        manifest[relative.as_posix()] = expected
    return manifest


def verify_sources(archive, project, expected):
    if digest(archive) != expected:
        raise RuntimeError("Frozen archive mismatch")
    count = 0
    with zipfile.ZipFile(archive) as bundle:
        for info in bundle.infolist():
            if info.is_dir():
                continue
            if not info.filename.startswith("HPC-Forest/"):
                raise RuntimeError("Unexpected frozen source root")
            path = project / info.filename.removeprefix("HPC-Forest/")
            if path.is_symlink() or not path.resolve().is_relative_to(project.resolve()):
                raise RuntimeError("Unsafe frozen source")
            if path.read_bytes() != bundle.read(info):
                raise RuntimeError("Frozen source changed")
            count += 1
    return count


def seconds(text):
    values = list(map(int, text.split(":")))
    return sum(value * 60 ** index for index, value in enumerate(reversed(values)))


def main():
    if (HERE / "preservation-verifiee.json").exists():
        raise RuntimeError("One-shot recovery already attempted; reconcile, never repeat blindly")
    rows = census()
    save(HERE / "cim-avant.json", rows)
    if worker_rows(rows):
        raise RuntimeError("A native relay remains present; do not duplicate")
    old = {52576, 46556, 21984, 33948, 27336, 11168, 67156, 59424}
    if any(row["ProcessId"] in old for row in rows):
        raise RuntimeError("Historical PID reused or still present; review complete identity")
    if digest(CLI) != "e98c516f1c8935789aabe9122ee7e05ec4c3efd1ba6acf179242e031c495b99e":
        raise RuntimeError("Pinned CLI changed")
    statuses = load(HERE / "statuts-avant-reprise.json")
    specs = [
        ("r1", STUDY, "coverage-gpt-6-astra-xhigh", "750205", "2bd8b683b45b41c8b48ec38708f46bab",
         BASE / "work/marathon-archive-mother-r1/project", "HPC-Forest-Archives-Modele-Mere-r1.zip",
         "cd769d474b6cb14c2fba11ab687f8825d35cb0b57a397d09aefab0ae743ffc18", 43200),
        ("source_only", COMPARE, "source-only-gpt-5.6-terra-max", "750831", "15219a6fd62b4dcb91b395dcd4ae03d5",
         BASE / "work/hpc-forest-harnais-comparaison-r1/project/HPC-Forest", "HPC-Forest-Harnais-Comparaison-r1.zip",
         "9a68a83fde4acb6bd247d79e00490e7d36f0c4c59c6c881152101e4c499387eb", 34800),
    ]
    preserved = {}
    for lane, root, key, job, session, project, archive, source_sha, maximum in specs:
        state = load(root / "coordinator-state.json")
        cell = next(c for c in state["queue"] if c["key"] == key)
        if (state["current_key"] != key or str(cell["job_id"]) != job
                or cell["session_id"] != session or cell["state"] != "working"):
            raise RuntimeError("Existing queue binding changed")
        status = statuses[lane]
        if (status.get("ok") is not True or str(status["job_id"]) != job
                or status.get("finished") or not status["observation"]["current_state_observed"]
                or time.time() - status["observation"]["observed_at"] > 180):
            raise RuntimeError("No fresh active allocation observation")
        count = verify_sources(root / archive, project, source_sha)
        worker = root / "runs" / key / "worker"
        manifest = preserve_tree(worker, HERE / "caches-avant" / lane)
        target = HERE / "etats-avant" / lane
        target.mkdir(parents=True)
        shutil.copy2(root / "coordinator-state.json", target / "coordinator-state.json")
        for name in ("submission.json", "autorisation.json", "worker-lancement.json", "deployment-received.json"):
            path = worker.parent / name
            if path.exists():
                shutil.copy2(path, target / name)
        pending = [path.name for path in worker.iterdir() if path.is_dir()
                   and (path / "generation-claimed.json").exists() and not (path / "response.json").exists()]
        delivered = [path.name for path in worker.iterdir() if path.is_dir() and (path / "delivered.json").exists()]
        preserved[lane] = {"key": key, "job_id": job, "session_id": session,
                           "source_files": count, "worker_files": manifest,
                           "delivered_nonces": delivered, "claimed_without_response": pending}
    save(HERE / "preservation-verifiee.json", {"verified": True, "observed_at": time.time(),
         "lanes": preserved, "native_workers_before": 0, "processes_stopped": 0,
         "new_submission": False, "claimed_generations_must_not_be_replayed": True})
    for lane, root, key, job, session, project, archive, source_sha, maximum in specs:
        if len(worker_rows(census())) >= 4:
            raise RuntimeError("Two native launcher/Python pairs already present")
        status = statuses[lane]
        lifetime = int(status["observation"]["observed_at"] + seconds(status["remaining"]) + 900 - time.time())
        if not 1 <= lifetime <= maximum:
            raise RuntimeError("Remaining allocation plus late delivery exceeds original relay cap")
        worker = root / "runs" / key / "worker"
        if lane == "r1":
            argv = [str(PYTHON), "-B", "-u", str(STUDY / "reprises/incident-liaison-20261016T1656/reprendre-relais-r1.py"),
                    "--resume", "--channel", load(worker.parent / "worker-lancement.json")["argv"][7],
                    "--session-id", session, "--output", str(worker),
                    "--codex-config", "C:/Users/nicol/.codex/config.toml", "--dependency-receipt", str(worker.parent / "autorisation.json"),
                    "--required-jobs", "hpc-forest-archives-2020-2024-mother-r1", "--max-seconds", str(lifetime), "--executable", str(CLI)]
            # Read the named channel argument rather than relying on its numeric position.
            old_argv = load(worker.parent / "worker-lancement.json")["argv"]
            argv[argv.index("--channel") + 1] = old_argv[old_argv.index("--channel") + 1]
        else:
            argv = list(load(worker.parent / "worker-lancement.json")["argv"])
            argv.insert(1, "-B")
            argv[argv.index("--max-seconds") + 1] = str(lifetime)
        env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1", PYTHONUTF8="1", PYTHONPATH=str(project / "src"))
        with (HERE / f"{lane}-relais.stdout.log").open("ab") as out, (HERE / f"{lane}-relais.stderr.log").open("ab") as err:
            process = subprocess.Popen(argv, cwd=BASE, env=env, stdout=out, stderr=err,
                                       creationflags=subprocess.CREATE_NO_WINDOW)
        save(HERE / f"lancement-{lane}.json", {"pid": process.pid, "argv": argv, "started_at": time.time(),
              "max_seconds_remaining_allocation_plus_900": lifetime, "same_job": job, "session_id": session,
              "generation_claims_preserved": True, "submission_replayed": False})
        time.sleep(2)
        current = census()
        launcher = next((row for row in current if row["ProcessId"] == process.pid), None)
        real = [row for row in current if row["ParentProcessId"] == process.pid
                and (row.get("ExecutablePath") or "").lower().endswith("python.exe")
                and row.get("CommandLine") == (launcher or {}).get("CommandLine")]
        if launcher is None or len(real) != 1:
            raise RuntimeError("Resumed relay launcher/real Python identity not verified")
        save(HERE / f"relais-attendu-{lane}.json", [launcher, real[0]])
    save(HERE / "cim-apres-relais.json", census())
    print(json.dumps({"resumed_jobs": ["750205", "750831"], "preserved_files":
                     {k: len(v["worker_files"]) for k, v in preserved.items()},
                     "pending_claims": {k: v["claimed_without_response"] for k, v in preserved.items()},
                     "processes_stopped": 0, "new_submission": False}))


if __name__ == "__main__":
    sys.stdout.reconfigure(encoding="utf8")
    main()

      "content": "#include \"knn.h\"\n\n// Flattened storage for all points across groups.\nstatic float *all_coords = NULL;   // interleaved x,y pairs\nstatic char *point_labels = NULL;\nstatic int total_points = 0;\n\n// Group boundaries: start index into the flattened arrays and length.\ntypedef struct {\n    int start;\n    int len;\n} GroupInfo;\n\nstatic GroupInfo *group_info = NULL;\n\n// Max-heap for k nearest neighbors (1-indexed).\nstatic float *heap_dist = NULL;\nstatic char *heap_label = NULL;\nstatic int heap_size = 0;   // current number of elements in heap\n\nvoid heap_swap(int i, int j) {\n    float td = heap_dist[i];\n    heap_dist[i] = heap_dist[j];\n    heap_dist[j] = td;\n    char tl = heap_label[i];\n    heap_label[i] = heap_label[j];\n    heap_label[j] = tl;\n}\n\nvoid sift_down(int idx, int n) {\n    while (1) {\n        int largest = idx;\n        int left = 2 * idx;\n        int right = 2 * idx + 1;\n        if (left <= n && heap_dist[left] > heap_dist[largest]) largest = left;\n        if (right <= n && heap_dist[right] > heap_dist[largest]) largest = right;\n        if (largest == idx) break;\n        heap_swap(idx, largest);\n        idx = largest;\n    }\n}\n\nvoid sift_up(int idx) {\n    while (idx > 1 && heap_dist[idx] > heap_dist[idx / 2]) {\n        heap_swap(idx, idx / 2);\n        idx /= 2;\n    }\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    // Allocate flattened arrays if not already done.\n    if (all_coords == NULL) {\n        total_points = 0;\n        for (int i = 0; i < n_groups; i++) {\n            total_points += groups[i].length;\n        }\n        all_coords = (float *)malloc(sizeof(float) * 2 * total_points);\n        point_labels = (char *)malloc(sizeof(char) * total_points);\n        group_info = (GroupInfo *)malloc(sizeof(GroupInfo) * n_groups);\n\n        int idx = 0;\n        for (int i = 0; i < n_groups; i++) {\n            Group g = groups[i];\n            group_info[i].start = idx;\n            group_info[i].len = g.length;\n            for (int j = 0; j < g.length; j++) {\n                all_coords[2 * idx]     = g.points[j].x;\n                all_coords[2 * idx + 1] = g.points[j].y;\n                point_labels[idx]       = g.label;\n                idx++;\n            }\n        }\n    }\n\n    // Allocate heap arrays (size k+1 for 1-indexing).\n    if (heap_dist == NULL) {\n        heap_dist = (float *)malloc(sizeof(float) * (k + 1));\n        heap_label = (char *)malloc(sizeof(char) * (k + 1));\n    }\n\n    float px = to_evaluate.x;\n    float py = to_evaluate.y;\n\n    heap_size = 0;\n\n    // Process all points in sequential order.\n    for (int i = 0; i < total_points; i++) {\n        float dx = all_coords[2 * i] - px;\n        float dy = all_coords[2 * i + 1] - py;\n        float d = dx * dx + dy * dy;\n\n        if (heap_size < k) {\n            heap_size++;\n            int pos = heap_size;\n            heap_dist[pos] = d;\n            heap_label[pos] = point_labels[i];\n            sift_up(pos);\n        } else if (d < heap_dist[1]) {\n            // Replace root.\n            heap_dist[1] = d;\n            heap_label[1] = point_labels[i];\n            sift_down(1, k);\n        }\n    }\n\n    // Count frequencies using histogram.\n    int freq[256] = {0};\n    for (int i = 1; i <= heap_size; i++) {\n        unsigned char lbl = (unsigned char)heap_label[i];\n        freq[lbl]++;\n    }\n\n    // Find most frequent label.\n    int best_count = 0;\n    char best_label = 0;\n    for (int c = 1; c < 256; c++) {\n        if (freq[c] > best_count) {\n            best_count = freq[c];\n            best_label = (char)c;\n        }\n    }\n\n    return best_label;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n\n    Group * groups = (Group *)malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n\n    // Free allocated memory (optional but good practice).\n    free(all_coords);\n    free(point_labels);\n    free(group_info);\n    free(heap_dist);\n    free(heap_label);\n    for (int i = 0; i < n_groups; i++) {\n        free(groups[i].points);\n    }\n    free(groups);\n\n    return 0;\n}\n",
      "path": "src/knn.c"
    },
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n    Point point;\n    point.x = x;\n    point.y = y;\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *)malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n    return k;\n}\n",
      "path": "src/knn.h"
    }
  ],
  "hypothesis": "Flattening all points into a single interleaved coordinate array and using a max-heap for nearest neighbor selection improves memory locality by enabling fully sequential access across groups, reduces insertion cost from O(k) to O(log k), and replaces qsort+scan with an O(k + 256) histogram. This builds on previous successful SoA/interleave transformations.",
  "notes": "Removed euclidean_distance_no_sqrt (inlined). Heap is max-heap of size k; only insert when distance < root after full. Histogram avoids sorting entirely. Group boundaries stored for potential future use but not needed in this version.",

#include "knn.h"

#define BLOCK_SIZE 16

typedef struct {
    float distance;
    char label;
} DistanceLabel;

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    DistanceLabel * distances = (DistanceLabel *) malloc(sizeof(DistanceLabel) * k);

    for (int i = 0; i < k; i++) {
        distances[i].distance = -1;
        distances[i].label = -1;
    }

    for (int g = 0; g < n_groups; g += BLOCK_SIZE) {
        int block_size = (g + BLOCK_SIZE > n_groups) ? (n_groups - g) : BLOCK_SIZE;
        for (int i = 0; i < block_size; i++) {
            Group group = groups[g + i];
            for (int j = 0; j < group.length; j++) {
                float d = euclidean_distance_no_sqrt(to_evaluate, group.points[j]);
                if (d < distances[k - 1].distance || distances[k - 1].distance == -1) {
                    distances[k - 1].distance = d;
                    distances[k - 1].label = group.label;
                    qsort(distances, k, sizeof(DistanceLabel), compare_for_sort);
                }
            }
        }
    }

    char most_frequent = distances[0].label;
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (int i = 1; i < k; i++) {
        if (distances[i].label != distances[i - 1].label) {
            if (current_frequency > most_frequent_count) {
                most_frequent = distances[i - 1].label;
                most_frequent_count = current_frequency;
            }
            current_frequency = 1;
        } else {
            current_frequency++;
        }
    }

    if (current_frequency > most_frequent_count) {
        most_frequent = distances[k - 1].label;
    }

    free(distances);
    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);
    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }
    int k = parse_k();
    Point to_evaluate = parse_point();
    printf("%c", knn(n_groups, groups, k, to_evaluate));
}
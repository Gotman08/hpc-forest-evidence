#include <cstdio>
#include <cstddef>
#include <vector>

class FastScanner {
public:
    explicit FastScanner(FILE* f) : f_(f), idx_(0), size_(0) {}

    int nextInt() {
        char c = getChar_();
        while (c <= ' ') {
            if (!c) return 0;
            c = getChar_();
        }
        bool neg = false;
        if (c == '-') {
            neg = true;
            c = getChar_();
        }
        int x = 0;
        for (; c > ' '; c = getChar_()) {
            x = x * 10 + (c - '0');
        }
        return neg ? -x : x;
    }

private:
    FILE* f_;
    int idx_;
    int size_;
    char buf_[1 << 20];

    inline char getChar_() {
        if (idx_ >= size_) {
            size_ = static_cast<int>(fread(buf_, 1, sizeof(buf_), f_));
            idx_ = 0;
            if (size_ == 0) return '\0';
        }
        return buf_[idx_++];
    }
};

int main() {
    FastScanner fs(stdin);
    int n = fs.nextInt();
    int s = fs.nextInt();

    std::vector<long long> col(n, 0LL);
    std::vector<int> ring(static_cast<std::size_t>(s) * static_cast<std::size_t>(n));

    for (int i = 0; i < s; ++i) {
        int* row = &ring[static_cast<std::size_t>(i) * n];
        for (int j = 0; j < n; ++j) {
            int v = fs.nextInt();
            row[j] = v;
            col[j] += v;
        }
    }

    long long hsum = 0;
    for (int j = 0; j < s; ++j) hsum += col[j];
    long long best = hsum;

    for (int j = s; j < n; ++j) {
        hsum += col[j] - col[j - s];
        if (hsum > best) best = hsum;
    }

    int head = 0;
    for (int top = 1; top + s <= n; ++top) {
        int* oldRow = &ring[static_cast<std::size_t>(head) * n];

        for (int j = 0; j < n; ++j) {
            int v = fs.nextInt();
            col[j] += static_cast<long long>(v) - oldRow[j];
            oldRow[j] = v;
        }

        if (++head == s) head = 0;

        hsum = 0;
        for (int j = 0; j < s; ++j) hsum += col[j];
        if (hsum > best) best = hsum;

        for (int j = s; j < n; ++j) {
            hsum += col[j] - col[j - s];
            if (hsum > best) best = hsum;
        }
    }

    std::printf("%lld\n", best);
    return 0;
}

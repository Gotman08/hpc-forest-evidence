#include <algorithm>
#include <iostream>
#include <vector>

#ifdef _OPENMP
#include <omp.h>
#endif

using namespace std;

const int MOD = 1000000007;

#ifdef _OPENMP
struct alignas(64) ChunkSummary {
    int tail;
    int resets;
};
#endif

static int countPaths(const vector<vector<bool> >& blockedCells) {
    const int n = static_cast<int>(blockedCells.size());
    vector<int> dp(n, 0);
    dp[0] = 1;

#ifdef _OPENMP
    const int minColumnsPerThread = 1024;
    int threads = min(4, omp_get_max_threads());
    threads = min(threads, max(1, n / minColumnsPerThread));

    if (threads > 1) {
        ChunkSummary summaries[4] = {};

        #pragma omp parallel num_threads(threads)
        {
            const int tid = omp_get_thread_num();
            const int teamSize = omp_get_num_threads();
            const int begin = n * tid / teamSize;
            const int end = n * (tid + 1) / teamSize;

            for (int row = 0; row < n; ++row) {
                const vector<bool>& blocked = blockedCells[row];
                int firstBlocked = end;
                int left = 0;

                // Scan this chunk with zero incoming horizontal carry.
                for (int col = begin; col < end; ++col) {
                    if (blocked[col]) {
                        left = 0;
                        if (firstBlocked == end) {
                            firstBlocked = col;
                        }
                    } else {
                        left += dp[col];
                        if (left >= MOD) {
                            left -= MOD;
                        }
                    }
                    dp[col] = left;
                }

                summaries[tid].tail = left;
                summaries[tid].resets = (firstBlocked != end);

                #pragma omp barrier

                // A chunk maps an incoming carry x to either x + tail
                // or tail, depending on whether it contains a blocker.
                int incoming = 0;
                for (int chunk = 0; chunk < tid; ++chunk) {
                    if (summaries[chunk].resets) {
                        incoming = summaries[chunk].tail;
                    } else {
                        incoming += summaries[chunk].tail;
                        if (incoming >= MOD) {
                            incoming -= MOD;
                        }
                    }
                }

                // Only the prefix before the first blocker depends on x.
                if (incoming != 0) {
                    for (int col = begin; col < firstBlocked; ++col) {
                        int value = dp[col] + incoming;
                        if (value >= MOD) {
                            value -= MOD;
                        }
                        dp[col] = value;
                    }
                }

                #pragma omp barrier
            }
        }

        return dp[n - 1];
    }
#endif

    for (int row = 0; row < n; ++row) {
        const vector<bool>& blocked = blockedCells[row];
        int left = 0;
        for (int col = 0; col < n; ++col) {
            if (blocked[col]) {
                left = 0;
            } else {
                left += dp[col];
                if (left >= MOD) {
                    left -= MOD;
                }
            }
            dp[col] = left;
        }
    }

    return dp[n - 1];
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) {
        return 0;
    }

    vector<vector<bool> > blockedCells(n, vector<bool>(n, false));
    for (int c = 0; c < m; ++c) {
        int row, col;
        cin >> row >> col;
        blockedCells[row][col] = true;
    }

    cout << countPaths(blockedCells) << '\n';
    return 0;
}

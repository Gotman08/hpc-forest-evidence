from pathlib import Path

root = Path(__file__).resolve().parent / 'hpc-forest-evidence'
for name, count in [('CHANGELOG.md', 1), ('tools/verify.py', 3)]:
    path = root / name
    lines = path.read_text(encoding='utf-8').splitlines()
    assert sum(line == '<<<<<<< HEAD' for line in lines) == count
    assert sum(line == '=======' for line in lines) == count
    assert sum(line == '>>>>>>> origin/main' for line in lines) == count
    lines = [line for line in lines if line not in {'<<<<<<< HEAD', '=======', '>>>>>>> origin/main'}]
    path.write_text('\n'.join(lines) + '\n', encoding='utf-8', newline='\n')
print('Preserved both reviewed additions; manifest will be rebuilt from all public files.')

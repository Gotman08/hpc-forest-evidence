import hashlib,json,tomllib
from pathlib import Path
base=Path(r"C:\Users\nicol\Documents\Codex\2026-10-15\cr")
d=base/"outputs/HPC-Forest-Harnais-Comparaison-r1/reprises/r3-corrige-r4-parallele-20261018"
p=Path(r"C:\Users\nicol\.codex\automations\terminer-les-essais-deepseek-sur-romeo\automation.toml")
b=p.read_bytes();v=tomllib.loads(b.decode("utf-8-sig"))
assert v["id"]=="terminer-les-essais-deepseek-sur-romeo" and v["status"]=="ACTIVE"
assert v["target_thread_id"]=="01a13e1b-d868-7240-8a3c-454bc296b43e" and v["rrule"]=="FREQ=MINUTELY;INTERVAL=15"
assert "R4b exige sa qualification propre avant génération" in v["prompt"] and "R5 sera lancé SEUL" in v["prompt"]
o=d/"verification-automation-prompt-corrige";o.mkdir(exist_ok=False)
(o/"automation-verifiee.toml").write_bytes(b)
r={"verified":True,"schema":"hpc-forest-automation-r34-prompt-r2-verification-v1","sha256":hashlib.sha256(b).hexdigest(),"status":v["status"],"target_thread_id":v["target_thread_id"],"rrule":v["rrule"],"qualification_explicit":True,"R5_alone_explicit":True,"filesystem_configuration_mutated":False}
(o/"verification.json").write_text(json.dumps(r,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
print(json.dumps(r))


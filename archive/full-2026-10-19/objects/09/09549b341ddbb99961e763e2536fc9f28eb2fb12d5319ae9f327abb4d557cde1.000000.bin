<td id="A3.T6.2.3.4" class="ltx_td ltx_align_right" style="padding-left:5.0pt;padding-right:5.0pt;">315–165–0</td>
<td id="A3.T6.2.3.5" class="ltx_td ltx_align_right" style="padding-left:5.0pt;padding-right:5.0pt;"><math id="A3.T6.m2" class="ltx_Math" alttext="65.6\%" display="inline" intent=":literal"><semantics><mrow><mn>65.6</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">65.6\%</annotation></semantics></math></td></tr>
<tr id="A3.T6.2.4" class="ltx_tr">

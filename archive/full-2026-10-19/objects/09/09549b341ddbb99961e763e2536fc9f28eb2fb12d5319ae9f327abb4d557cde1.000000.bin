</span></div></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">(a) </span>Task-solving performance.</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.T1.st2" class="ltx_table ltx_figure_panel ltx_align_center">
<div id="S4.T1.st2.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:397.5pt;height:187.7pt;vertical-align:-84.6pt;"><span class="ltx_transformed_inner" style="transform:translate(145.1pt,-68.5pt) scale(3.70614685486706,3.70614685486706) ;">
<table id="S4.T1.st2.2.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S4.T1.st2.2.1.1" class="ltx_tr">
<th id="S4.T1.st2.2.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt">Evaluator</th>
<th id="S4.T1.st2.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Accuracy</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T1.st2.2.1.2" class="ltx_tr">
<th id="S4.T1.st2.2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="S4.T1.st2.m1" class="ltx_Math" alttext="{\mathcal{L}}^{(0)}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">{\mathcal{L}}^{(0)}</annotation></semantics></math></th>
<td id="S4.T1.st2.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S4.T1.st2.m2" class="ltx_Math" alttext="0.73" display="inline" intent=":literal"><semantics><mn>0.73</mn><annotation encoding="application/x-tex">0.73</annotation></semantics></math></td></tr>
<tr id="S4.T1.st2.2.1.3" class="ltx_tr">
<th id="S4.T1.st2.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="S4.T1.st2.m3" class="ltx_Math" alttext="{\mathcal{L}}^{(1)}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">{\mathcal{L}}^{(1)}</annotation></semantics></math></th>
<td id="S4.T1.st2.2.1.3.2" class="ltx_td ltx_align_center"><math id="S4.T1.st2.m4" class="ltx_Math" alttext="0.91" display="inline" intent=":literal"><semantics><mn>0.91</mn><annotation encoding="application/x-tex">0.91</annotation></semantics></math></td></tr>
<tr id="S4.T1.st2.2.1.4" class="ltx_tr">
<th id="S4.T1.st2.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><math id="S4.T1.st2.m5" class="ltx_Math" alttext="{\mathcal{L}}^{(2)}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">{\mathcal{L}}^{(2)}</annotation></semantics></math></th>
<td id="S4.T1.st2.2.1.4.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T1.st2.m6" class="ltx_Math" alttext="0.93" display="inline" intent=":literal"><semantics><mn>0.93</mn><annotation encoding="application/x-tex">0.93</annotation></semantics></math></td></tr>

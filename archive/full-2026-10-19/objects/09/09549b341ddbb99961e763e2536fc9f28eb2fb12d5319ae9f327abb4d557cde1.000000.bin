<td id="A3.T6.2.5.5" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><math id="A3.T6.m5" class="ltx_Math" alttext="70.6\%" display="inline" intent=":literal"><semantics><mrow><mn>70.6</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">70.6\%</annotation></semantics></math></td></tr>

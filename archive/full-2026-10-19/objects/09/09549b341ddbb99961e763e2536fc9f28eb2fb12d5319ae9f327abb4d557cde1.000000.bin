<td id="A3.T6.2.6.4" class="ltx_td ltx_align_right" style="padding-left:5.0pt;padding-right:5.0pt;">196–104–0</td>
<td id="A3.T6.2.6.5" class="ltx_td ltx_align_right" style="padding-left:5.0pt;padding-right:5.0pt;"><math id="A3.T6.m7" class="ltx_Math" alttext="65.3\%" display="inline" intent=":literal"><semantics><mrow><mn>65.3</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">65.3\%</annotation></semantics></math></td></tr>
<tr id="A3.T6.2.7" class="ltx_tr">

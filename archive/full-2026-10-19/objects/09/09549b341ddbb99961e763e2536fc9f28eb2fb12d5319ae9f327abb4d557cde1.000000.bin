<tr id="S5.T2.st1.2.3" class="ltx_tr" style="--ltx-bg-color:#FFD9D9;">
<th id="S5.T2.st1.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:3.0pt;padding-right:3.0pt;"><math id="S5.T2.st1.m4" class="ltx_Math" style="--ltx-bg-color:#FFD9D9;" alttext="{\mathcal{L}}^{(1)}" display="inline" intent=":literal"><semantics><msup><mi style="--ltx-bg-color:#FFD9D9;" class="ltx_font_mathcaligraphic" mathbackground="#FFD9D9">ℒ</mi><mrow><mo style="--ltx-bg-color:#FFD9D9;" mathbackground="#FFD9D9" stretchy="false">(</mo><mn style="--ltx-bg-color:#FFD9D9;" mathbackground="#FFD9D9">1</mn><mo style="--ltx-bg-color:#FFD9D9;" mathbackground="#FFD9D9" stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">{\mathcal{L}}^{(1)}</annotation></semantics></math></th>
<td id="S5.T2.st1.2.3.2" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.st1.2.3.2.1" class="ltx_text" style="--ltx-bg-color:#FFD9D9;">48/110</span></td>
<td id="S5.T2.st1.2.3.3" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.st1.2.3.3.1" class="ltx_text" style="--ltx-bg-color:#FFD9D9;">42/110</span></td>
<td id="S5.T2.st1.2.3.4" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.st1.2.3.4.1" class="ltx_text" style="--ltx-bg-color:#FFD9D9;">10/110</span></td>

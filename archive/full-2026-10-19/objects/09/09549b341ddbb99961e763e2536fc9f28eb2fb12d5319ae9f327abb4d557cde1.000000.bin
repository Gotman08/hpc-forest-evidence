<th id="A3.T6.2.1.5" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;">Win share</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A3.T6.2.2" class="ltx_tr">
<td id="A3.T6.2.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">base</td>
<td id="A3.T6.2.2.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">All 11 tasks</td>
<td id="A3.T6.2.2.3" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">110</td>
<td id="A3.T6.2.2.4" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">412–248–0</td>
<td id="A3.T6.2.2.5" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><math id="A3.T6.m1" class="ltx_Math" alttext="62.4\%" display="inline" intent=":literal"><semantics><mrow><mn>62.4</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">62.4\%</annotation></semantics></math></td></tr>
<tr id="A3.T6.2.3" class="ltx_tr">

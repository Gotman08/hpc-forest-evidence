</span></span></span><span id="A9.SS1.p2.1.1.51" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:397.5pt;"><span id="A9.SS1.p2.1.1.51.1" class="ltx_text ltx_inline-block" style="width:10.0pt;"> </span><span id="A9.SS1.p2.1.1.51.2" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:387.5pt;">
<span id="A9.SS1.p2.p51" class="ltx_para ltx_noindent">
<span id="A9.SS1.p2.p51.1" class="ltx_p">      "metrics": {"oos_ic_by_horizon": {}, "oos_rankic_by_horizon": {}, "oos_sharpe_by_horizon": {}, "stability_scores": {}, "regime_accuracy": {"train": "float", "test": "float"}, "regime_calibration_error": "float"},</span>
</span></span></span><span id="A9.SS1.p2.1.1.52" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:397.5pt;"><span id="A9.SS1.p2.1.1.52.1" class="ltx_text ltx_inline-block" style="width:10.0pt;"> </span><span id="A9.SS1.p2.1.1.52.2" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:387.5pt;">
<span id="A9.SS1.p2.p52" class="ltx_para ltx_noindent">
<span id="A9.SS1.p2.p52.1" class="ltx_p">      "validation_report": {"ic_positive_oos": "bool", "walkforward_stable": "bool", "no_full_sample_leakage": "bool", "sharpe_within_reasonable_bounds": "bool", "regime_gating_applied": "bool", "rankic_not_identical_to_ic": "bool", "error_details": "str"},</span>

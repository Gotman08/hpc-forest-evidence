<td id="S4.T1.st1.3.1.7.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="S4.T1.st1.m32" class="ltx_Math" alttext="61.8\!\pm\!1.9" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>1.9</mn></mrow><annotation encoding="application/x-tex">61.8\!\pm\!1.9</annotation></semantics></math></td>
<td id="S4.T1.st1.3.1.7.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:2.0pt;padding-right:2.0pt;"><math id="S4.T1.st1.m33" class="ltx_Math" alttext="61.1\!\pm\!0.6" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.6</mn></mrow><annotation encoding="application/x-tex">61.1\!\pm\!0.6</annotation></semantics></math></td></tr>

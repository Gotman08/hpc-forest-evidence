<span id="A9.SS1.p2.p47.1" class="ltx_p">    "input_dependencies": ["agent_feature_engineer.output_contract"],</span>
</span></span></span><span id="A9.SS1.p2.1.1.48" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:397.5pt;"><span id="A9.SS1.p2.1.1.48.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:397.5pt;">

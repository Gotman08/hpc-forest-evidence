to <math id="A6.T13.m26" class="ltx_Math" alttext="i=11" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">i=11</annotation></semantics></math>, unconditional <math id="A6.T13.m27" class="ltx_Math" alttext="\widehat{TC}(Z)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{TC}(Z)</annotation></semantics></math> decreases in all four
configurations and task-centered <math id="A6.T13.m28" class="ltx_Math" alttext="\widehat{TC}(Z\mid T)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi></mrow><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{TC}(Z\mid T)</annotation></semantics></math> in three;

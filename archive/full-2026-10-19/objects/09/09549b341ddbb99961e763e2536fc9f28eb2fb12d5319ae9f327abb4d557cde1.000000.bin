<span id="A9.SS1.p2.p80.1" class="ltx_p">      "validation_report": {"all_metrics_valid": "bool", "ablation_runs_complete": "bool", "subperiod_coverage": "bool", "split_overlap_free": "bool", "rankic_distinct": "bool", "no_nans": "bool", "error_details": "str"},</span>
</span></span></span><span id="A9.SS1.p2.1.1.81" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:397.5pt;"><span id="A9.SS1.p2.1.1.81.1" class="ltx_text ltx_inline-block" style="width:10.0pt;"> </span><span id="A9.SS1.p2.1.1.81.2" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:387.5pt;">

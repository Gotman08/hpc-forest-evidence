"""Assemble actual parent-received metadata only; never run factory or effects.

No census, authentication/config body, live cache, transport, CLI or model is read.
Every positive observation is supplied as an actual typed SHA-bound root receipt.
"""
import argparse
import ast
from datetime import datetime
import hashlib
import json
import math
import os
from pathlib import Path
import re
import stat
import time

HERE = Path(__file__).resolve().parent
OPS = HERE.parent
PREP = OPS.parent
BASE = PREP.parents[1]
CHAIN = PREP / "adaptateurs-source110-r1/revision-r8-racines-techniques-neuves"
SCOPE = "hpc-forest-dynamic-independent-roots-r4b-max"
SOURCE = "eaff9217499fe268e4d151165a368a83bad1550d921955a9f9256026cfac2d48"
PLAN = "f927d37098f3fd50cc4916195da3e300bd7c29597ba7ece4b9669abd715897fe"
ROOTS = {"gpt-6.1-sol":("sol-max","277b1e33ea5e4af6af1c9144ce970ac4"),
         "gpt-6-astra":("astra-max","5033baf5d38042efb8ab834a59437d19"),
         "gpt-5.6-terra":("terra-max","d5007804188a4fc793582a26e47c556c")}
COMMON = {"real_qualification_reception","factory_review","reader_integration_review","oauth_observation","codex_config",
          "fresh_private_full_cim","r2_main_closure","latest_native_generation_closure","source_state_binding",
          "scientific_reception","reconciliation","source_only_absence","owned_descendant_review","observer_release","local_projection_producer_review"}
CELL_REFS = {"allocation_marker","request_prepared","submission_intent","submission_observed","script_reread",
             "parent_observations","mixed_observer_admission","transport_probe_readback","cli_policy"}
OBS_FLAGS = ("full_census_locally_reviewed","no_unclassified_research_processes","remote_registry_absent","prior_session_claims_absent",
             "local_cache_absent","local_registry_absent","existing_transport_only","no_new_authentication","CLI_tools_disabled")
RAW_SOURCE = PREP / "qualification-allouee-source110-G-recu-r1/revue-resultats-Q753709-r1/lecteur-r4b/auditer-restauration-existante-r4b.py"
RAW_SHA = "5c1e1784574566a585e2d9cc50f85b52337d10d3109e449a4112581eae68f8d5"
RAW_NAMES = {"need","ordinary","metadata","open_nofollow_read","cross_identity","validate_windows_mode_views","native_basic_info","raw","decode"}

def need(value,message):
    if not value:
        raise ValueError(message)

def age(value, now, ceiling=120):
    if isinstance(value,str):
        parsed = datetime.fromisoformat(value)
        need(parsed.tzinfo is not None and parsed.utcoffset().total_seconds() == 0,"UTC fact timestamp required")
        value = parsed.timestamp()
    need(type(value) in (int,float) and math.isfinite(value) and 0 <= now-value <= ceiling,"Stale, future, bool or nonfinite actual observation")

def cell_binding(model,job):
    need(model in ROOTS and isinstance(job,str) and re.fullmatch(r"[1-9][0-9]*",job),"Actual roots job/model required")
    session = ROOTS[model][1]
    return {"scope_id":SCOPE,"source_zip_sha256":SOURCE,"plan_sha256":PLAN,"model":model,"effort":"max", "session_id":session,
            "job_id":job,"remote_root":"/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-"+session}

def bind(value,cell):
    need(all(type(value.get(k)) is type(v) and value[k] == v for k,v in cell.items()),"Exact observed cell differs")

def held_reads():
    source = RAW_SOURCE.read_bytes()
    need(hashlib.sha256(source).hexdigest() == RAW_SHA,"Reviewed held-read code changed")
    nodes = [n for n in ast.parse(source).body if isinstance(n,ast.FunctionDef) and n.name in RAW_NAMES]
    need({n.name for n in nodes} == RAW_NAMES,"Exact held-read functions required")
    result = {"Path":Path,"os":os,"stat":stat,"Q":BASE,"json":json}
    exec(compile(ast.Module(body=nodes,type_ignores=[]),str(RAW_SOURCE),"exec"),result)
    return result

def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--actual-bundle",type=Path,required=True)
    p.add_argument("--actual-bundle-sha256",required=True)
    p.add_argument("--output-directory",type=Path,required=True)
    p.add_argument("--one-model",choices=tuple(ROOTS))
    args = p.parse_args()
    io = held_reads()
    pins = {}
    def ref(ref, *, opaque_config=False, parse_json=True):
        need(isinstance(ref,dict) and set(ref)=={"path","sha256"} and Path(ref["path"]).is_absolute()
             and ".." not in Path(ref["path"]).parts and re.fullmatch(r"[0-9a-f]{64}",ref["sha256"]),"Actual closed path/SHA required; missing refs never pass")
        if opaque_config or (not parse_json and Path(ref["path"]) == Path("C:/Users/nicol/.codex/config.toml")):
            need(Path(ref["path"]) == Path("C:/Users/nicol/.codex/config.toml"),"Only existing root-supplied config reference; no body is read")
            return None
        raw = io["raw"](ref["path"])
        need(hashlib.sha256(raw).hexdigest() == ref["sha256"],"Actual input SHA differs")
        pins[ref["path"]] = ref["sha256"]
        return io["decode"](raw) if parse_json else raw
    def evidence(value):
        need(isinstance(value.get("evidence_refs"),list) and value["evidence_refs"],"Actual evidence refs required")
        for item in value["evidence_refs"]:
            ref(item,parse_json=False)
    bundle = ref({"path":str(args.actual_bundle),"sha256":args.actual_bundle_sha256})
    need(set(bundle)=={"schema","verified_parent_observations","common","active_native_groups","cells"}
         and bundle["schema"]=="hpc-forest-source110-roots-operational-input-bundle-v1"
         and bundle["verified_parent_observations"] is True,"False templates/unknown observations cannot become factory input")
    common = bundle["common"]
    need(set(common)==COMMON,"Exact common received-ref set required")
    values = {name:ref(item,opaque_config=name=="codex_config") for name,item in common.items()}
    q = values["real_qualification_reception"]
    need(q.get("schema")=="hpc-forest-dynamic-r4b-mechanical-reception-v1" and q.get("verified") is True
         and q.get("source_zip_sha256")==SOURCE and q.get("plan_sha256")==PLAN
         and all(q.get(k) is True for k in ("source_files_exact","privacy_neutral_tests_passed","target_profile_verified","reference_contracts_reviewed")),"Actual exact composite Q required")
    need(common["factory_review"]==common["reader_integration_review"]
         and common["factory_review"]["sha256"]=="2dd0ca5099e428ad877796744ee754f0e51969cac7bbd08db01e0b97dde2a48c","One exact real62/OBS4 integration review required")
    producer = values["local_projection_producer_review"]
    need(producer.get("schema")=="hpc-forest-dynamic-r4b-integration-review-v1" and producer.get("verified") is True
         and producer.get("blocking_findings")==[]
         and producer.get("producer_sha256")=="a1234985df90b2203734c2b8b1ad296fe72786d4ba66179b9defe4593cee72d0"
         and producer.get("design_sha256")=="4d20be6fd5e79a89447f0a545f0af12328b486dd9525de8f830cd19d839d9ea3"
         and producer.get("source_state_reader_sha256")=="564398d676dceb6b5ba893fcbb3835c7aec31a1cbd5d5c5dcef6b361a3a23338","Actual projection producer review with three exact top-level bindings required")
    descendants = values["owned_descendant_review"]
    need(descendants.get("schema")=="hpc-forest-lane-r2-owned-descendant-review-v1" and descendants.get("verified") is True
         and descendants.get("blocking_findings")==[] and descendants.get("source_only_absence")==common["source_only_absence"]
         and descendants.get("unresolved_owned_descendants")==[]
         and descendants.get("source_state_reader_sha256")=="564398d676dceb6b5ba893fcbb3835c7aec31a1cbd5d5c5dcef6b361a3a23338","Actual exact-absence descendant review required")
    now = time.time()
    census = values["fresh_private_full_cim"]
    need(census.get("complete_census") is True and census.get("strict_utf8_decoding") is True
         and type(census.get("rows_count")) is int and census["rows_count"]==len(census.get("rows",[])),"Actual complete census required")
    age(census["captured_at_utc"],now)
    oauth = values["oauth_observation"]
    need(oauth.get("schema")=="hpc-forest-dynamic-r4b-existing-oauth-observation-v1" and oauth.get("verified") is True
         and oauth.get("authentication")=="existing-local-ChatGPT"
         and all(oauth.get(k) is False for k in ("OPENAI_API_KEY_present","CODEX_API_KEY_present","OPENAI_BASE_URL_present")),"Actual metadata-only existing OAuth receipt required")
    age(oauth["observed_at"],now); evidence(oauth)
    groups = bundle["active_native_groups"]
    need(isinstance(groups,list) and len(groups)<4,"Explicit current owned groups required; no guessed capacity")
    selected_models={args.one_model} if args.one_model else set(ROOTS)
    need(isinstance(bundle["cells"],list) and len(bundle["cells"])==len(selected_models)
         and {v.get("model") for v in bundle["cells"]}==selected_models,"Only the exact selected distinct roots models are allowed")
    prepared=[]
    for supplied in bundle["cells"]:
        need(set(supplied)=={"model","job_id",*CELL_REFS},"Exact actual per-root refs required")
        cell=cell_binding(supplied["model"],supplied["job_id"])
        observed={name:ref(supplied[name]) for name in CELL_REFS}
        marker=observed["allocation_marker"]; bind(marker,cell)
        need(marker.get("schema")=="hpc-forest-dynamic-r4b-allocation-marker-v1" and marker.get("verified") is True
             and marker.get("requests_published")==0 and marker.get("native_root_absent_before_stage") is True
             and marker.get("native_model_calls")==0 and marker.get("source_files")==110,"Actual zero-call new allocation marker required")
        age(marker["created_at"],now,600)
        request=observed["request_prepared"]
        need(supplied["request_prepared"]["sha256"]==marker["request_sha256"]
             and request.get("session_id")==cell["session_id"] and request.get("model")==cell["model"]
             and request.get("meta_role")=="mother-dynamic-roots" and request.get("reasoning_effort")=="max"
             and type(request.get("expires_at")) in (int,float) and math.isfinite(request["expires_at"]) and request["expires_at"]>now,
             "Exact staged unexpired request metadata required; body is never displayed or interpreted")
        obs=observed["parent_observations"]; bind(obs,cell)
        need(obs.get("schema")=="hpc-forest-dynamic-r4b-parent-observations-v1" and obs.get("verified") is True
             and all(obs.get(k) is True for k in OBS_FLAGS),"Actual root-observed checks required; no field is inferred from a template")
        for key in ("allocation_marker","request_prepared","mixed_observer_admission"):
            need(obs.get(key)==supplied[key],"Parent observed refs differ")
        need(obs.get("fresh_private_full_cim")==common["fresh_private_full_cim"] and obs.get("r2_main_closure")==common["r2_main_closure"],"Actual private census/closure refs differ")
        age(obs["observed_at"],now); evidence(obs)
        mixed=observed["mixed_observer_admission"]; bind(mixed,cell)
        need(mixed.get("schema")=="hpc-forest-dynamic-r4b-mixed-observer-admission-v1" and mixed.get("verified") is True
             and mixed.get("source_only_state")=="received_absent" and mixed.get("source_only_preserved") is False
             and mixed.get("source_only_scientifically_closed_and_absent") is True,"Actual matching OBS4 route admission required")
        age(mixed["observed_at"],now); evidence(mixed)
        transport=observed["transport_probe_readback"]; bind(transport,cell)
        need(transport.get("schema")=="hpc-forest-dynamic-r4b-neutral-transport-observation-v1" and transport.get("verified") is True
             and transport.get("native_model_calls")==0 and transport.get("neutral_controls_passed") is True
             and transport.get("configuration_path")==common["codex_config"]["path"]
             and transport.get("configuration_sha256")==common["codex_config"]["sha256"],"Actual existing transport readback bound to opaque config required")
        age(transport["observed_at"],now);evidence(transport)
        private={"schema":"hpc-forest-lane-r2-private-projection-input-v1","source_only_state":"received_absent",
            **{name:common[name] for name in ("scientific_reception","reconciliation","source_only_absence","fresh_private_full_cim","r2_main_closure","owned_descendant_review","observer_release","local_projection_producer_review")},
            "active_native_groups":groups,"parent_observations":supplied["parent_observations"]}
        value={"schema":"hpc-forest-dynamic-r4b-launch-inputs-v1","verified":True,
            **{k:v for k,v in cell.items() if k!="remote_root"},"phase":"roots",
            **{name:common[name] for name in ("real_qualification_reception","factory_review","reader_integration_review","oauth_observation","codex_config","fresh_private_full_cim","r2_main_closure","latest_native_generation_closure","source_state_binding")},
            **{name:supplied[name] for name in CELL_REFS},"private_lane_inputs":private,"native_contract_phase_receipts":[]}
        prepared.append((cell,value,request["expires_at"]-now))
    for path,checksum in pins.items():
        need(hashlib.sha256(io["raw"](path)).hexdigest()==checksum,"Received input changed while assembling")
    output=io["ordinary"](args.output_directory)
    need(output.parent==HERE and not output.exists(),"NEW direct operational-preparation output only")
    output.mkdir()
    records=[]
    for cell,value,remaining in prepared:
        slug=ROOTS[cell["model"]][0]
        path=output/(slug+"-factory-input.json")
        with path.open("x",encoding="utf8",newline="\n") as stream:
            json.dump(value,stream,indent=2);stream.write("\n")
        checksum=hashlib.sha256(path.read_bytes()).hexdigest()
        factory_output=CHAIN/("admissions-"+slug+"-roots-"+cell["job_id"]+"-01")
        records.append({"model":cell["model"],"job_id":cell["job_id"],"factory_input":{"path":str(path),"sha256":checksum},
            "request_seconds_remaining_at_preparation":remaining,"factory_not_executed":True,
            "factory_argv":[str(BASE/"work/.venv/Scripts/python.exe"),"-I","-B",str(CHAIN/"assemble_admissions.py"),"--input",str(path),"--input-sha256",checksum,"--output",str(factory_output)]})
    with (output/"COMMANDES-FACTORY-NON-EXECUTEES.json").open("x",encoding="utf8",newline="\n") as stream:
        json.dump({"records":records,"authorization_or_worker_created":False,"native_generation_admitted":False,
                   "factory_deep_checks_still_required":True,"global_config_body_read":False},stream,indent=2);stream.write("\n")
    print(json.dumps({"output":str(output),"actual_ref_sets_assembled":len(prepared),"factory_executed":False,"native_calls":0}))

if __name__=="__main__":
    main()

      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <algorithm>\n#include <cstdint>\n\nint main() {\n    int n, s;\n    std::cin >> n >> s;\n    std::vector<std::vector<int> > matrix(n, std::vector<int>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            scanf(\"%d\", &matrix[i][j]);\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    typedef std::int64_t Sum;\n    std::vector<Sum> columns(n, 0);\n    Sum* column = columns.data();\n\n    for (int row = 0; row < s; ++row) {\n        const int* values = matrix[row].data();\n        #pragma omp simd\n        for (int col = 0; col < n; ++col)\n            column[col] += static_cast<Sum>(values[col]);\n    }\n\n    Sum first = 0;\n    #pragma omp simd reduction(+:first)\n    for (int col = 0; col < s; ++col)\n        first += column[col];\n\n    Sum best = first;\n    const int last = n - s;\n    for (int top = 0; top <= last; ++top) {\n        Sum sum = first;\n        best = std::max(best, sum);\n        for (int col = s; col < n; ++col) {\n            sum += column[col] - column[col - s];\n            best = std::max(best, sum);\n        }\n\n        if (top == last)\n            break;\n\n        const int* outgoing = matrix[top].data();\n        const int* incoming = matrix[top + s].data();\n        Sum first_delta = 0;\n        #pragma omp simd reduction(+:first_delta)\n        for (int col = 0; col < s; ++col) {\n            const Sum delta = static_cast<Sum>(incoming[col])\n                            - static_cast<Sum>(outgoing[col]);\n            column[col] += delta;\n            first_delta += delta;\n        }\n        first += first_delta;\n\n        #pragma omp simd\n        for (int col = s; col < n; ++col) {\n            column[col] += static_cast<Sum>(incoming[col])\n                         - static_cast<Sum>(outgoing[col]);\n        }\n    }\n\n    printf(\"%d\\n\", static_cast<int>(best));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],

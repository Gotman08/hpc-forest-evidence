{
  "src/solution.cpp": "#include <algorithm>\n#include <cassert>\n#include <climits>\n#include <cstddef>\n#include <cstdio>\n#include <memory>\n#include <vector>\n\nusing Sum = long long;\n\nclass FastInput {\n    unsigned char buffer_[1 << 16];\n    std::size_t position_ = 0;\n    std::size_t size_ = 0;\n\n    int next_char() {\n        if (position_ == size_) {\n            size_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (size_ == 0) return EOF;\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    bool read_int(int& result) {\n        int c = next_char();\n        while (c != EOF && c <= ' ') c = next_char();\n        if (c == EOF) return false;\n        const bool negative = c == '-';\n        if (c == '-' || c == '+') c = next_char();\n        Sum value = 0;\n        while (c >= '0' && c <= '9') {\n            value = value * 10 + (c - '0');\n            c = next_char();\n        }\n        result = static_cast<int>(negative ? -value : value);\n        return true;\n    }\n\n    int next_int() {\n        int result = 0;\n        read_int(result);\n        return result;\n    }\n};\n\ntemplate<bool Remove, bool Store, bool Evaluate>\nstatic inline void update_window(Sum row_sum, int column, Sum* history,\n                                 Sum* totals, Sum& maximum) {\n    Sum total = totals[column] + row_sum;\n    if (Remove) total -= history[column];\n    if (Store) history[column] = row_sum;\n    totals[column] = total;\n    if (Evaluate && total > maximum) maximum = total;\n}\n\ntemplate<bool Remove, bool Store, bool Evaluate>\nstatic void read_row(FastInput& input, int s, int width, int retained,\n                     int* outgoing, Sum* history, Sum* totals, Sum& maximum) {\n    Sum row_sum = 0;\n    for (int column = 0; column < retained; ++column) {\n        const int value = input.next_int();\n        outgoing[column] = value;\n        row_sum += value;\n    }\n    for (int column = retained; column < s; ++column) {\n        row_sum += input.next_int();\n    }\n\n    update_window<Remove, Store, Evaluate>(row_sum, 0, history, totals, maximum);\n    int head = 0;\n    for (int column = 1; column < width; ++column) {\n        const int value = input.next_int();\n        row_sum += static_cast<Sum>(value) - outgoing[head];\n        outgoing[head] = value;\n        if (++head == retained) head = 0;\n        update_window<Remove, Store, Evaluate>(\n            row_sum, column, history, totals, maximum);\n    }\n}\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.read_int(n) || !input.read_int(s)) return 0;\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const int width = n - s + 1;\n    const int retained = std::min(s, n - s);\n    std::unique_ptr<int[]> outgoing(new int[retained]);\n    std::unique_ptr<Sum[]> history(\n        new Sum[static_cast<std::size_t>(retained) * width]);\n    std::vector<Sum> totals(width, 0);\n    Sum maximum = LLONG_MIN;\n\n    // Only the first n-s rows can expire. For large s, retain those\n    // rows instead of allocating a full s-row circular buffer.\n    for (int row = 0; row < s; ++row) {\n        Sum* saved = row < retained\n            ? history.get() + static_cast<std::size_t>(row) * width\n            : nullptr;\n        if (row + 1 == s) {\n            if (saved) {\n                read_row<false, true, true>(\n                    input, s, width, retained, outgoing.get(), saved,\n                    totals.data(), maximum);\n            } else {\n                read_row<false, false, true>(\n                    input, s, width, retained, outgoing.get(), nullptr,\n                    totals.data(), maximum);\n            }\n        } else {\n            if (saved) {\n                read_row<false, true, false>(\n                    input, s, width, retained, outgoing.get(), saved,\n                    totals.data(), maximum);\n            } else {\n                read_row<false, false, false>(\n                    input, s, width, retained, outgoing.get(), nullptr,\n                    totals.data(), maximum);\n            }\n        }\n    }\n\n    int oldest = 0;\n    for (int row = s; row < n; ++row) {\n        Sum* saved = history.get()\n            + static_cast<std::size_t>(oldest) * width;\n        read_row<true, true, true>(\n            input, s, width, retained, outgoing.get(), saved,\n            totals.data(), maximum);\n        if (++oldest == retained) oldest = 0;\n    }\n\n    std::printf(\"%lld\\n\", maximum);\n    return 0;\n}\n"
}

{
  "src/est_matriz_seq.c": "#include <stdio.h>\n#include <stdlib.h>\n#include <math.h>\n\nstatic void bubble_sort(double *valores, int tam) {\n    int i, j;\n    double aux;\n\n    for (i = tam - 1; i > 0; i--) {\n        for (j = 0; j < i; j++) {\n            if (valores[j] > valores[j + 1]) {\n                aux = valores[j];\n                valores[j] = valores[j + 1];\n                valores[j + 1] = aux;\n            }\n        }\n    }\n}\n\nstatic double calcula_moda_coluna(const double *valores, int tam) {\n    int i;\n    int melhor_contagem = 1;\n    int contagem = 1;\n    double moda = valores[0];\n\n    for (i = 1; i < tam; i++) {\n        if (valores[i] == valores[i - 1]) {\n            contagem++;\n        } else {\n            if (contagem > melhor_contagem) {\n                melhor_contagem = contagem;\n                moda = valores[i - 1];\n            }\n            contagem = 1;\n        }\n    }\n    if (contagem > melhor_contagem) {\n        melhor_contagem = contagem;\n        moda = valores[tam - 1];\n    }\n\n    return melhor_contagem == 1 ? -1 : moda;\n}\n\nstatic void calcula_coluna(double *matriz, int lin, int coluna,\n                           double *media, double *media_har,\n                           double *mediana, double *moda,\n                           double *variancia, double *dp, double *cv) {\n    int j;\n    size_t base = (size_t)coluna * (size_t)lin;\n    double soma = 0.0;\n\n    for (j = 0; j < lin; j++) {\n        soma += matriz[base + (size_t)j];\n    }\n    media[coluna] = soma / lin;\n\n    soma = 0.0;\n    for (j = 0; j < lin; j++) {\n        soma += 1 / matriz[base + (size_t)j];\n    }\n    media_har[coluna] = lin / soma;\n\n    bubble_sort(&matriz[base], lin);\n\n    if (lin % 2 == 0) {\n        mediana[coluna] = matriz[base + (size_t)(lin / 2 - 1)] +\n                          matriz[base + (size_t)(lin / 2)];\n        mediana[coluna] *= 0.5;\n    } else {\n        mediana[coluna] = matriz[base + (size_t)(lin / 2)];\n    }\n\n    moda[coluna] = calcula_moda_coluna(&matriz[base], lin);\n\n    soma = 0.0;\n    for (j = 0; j < lin; j++) {\n        soma += pow((matriz[base + (size_t)j] - media[coluna]), 2);\n    }\n    variancia[coluna] = soma / (lin - 1);\n    dp[coluna] = sqrt(variancia[coluna]);\n    cv[coluna] = dp[coluna] / media[coluna];\n}\n\nint main(void) {\n    int lin, col, i, j;\n    double *matriz, *mediana, *media, *media_har, *moda;\n    double *variancia, *dp, *cv;\n\n    fscanf(stdin, \"%d \", &lin);\n    fscanf(stdin, \"%d\\n\", &col);\n\n    matriz = (double *)malloc((size_t)lin * (size_t)col * sizeof(double));\n    media = (double *)malloc((size_t)col * sizeof(double));\n    media_har = (double *)malloc((size_t)col * sizeof(double));\n    mediana = (double *)malloc((size_t)col * sizeof(double));\n    moda = (double *)malloc((size_t)col * sizeof(double));\n    variancia = (double *)malloc((size_t)col * sizeof(double));\n    cv = (double *)malloc((size_t)col * sizeof(double));\n    dp = (double *)malloc((size_t)col * sizeof(double));\n\n    for (i = 0; i < lin; i++) {\n        for (j = 0; j < col; j++) {\n            fscanf(stdin, \"%lf \", &matriz[(size_t)j * (size_t)lin + (size_t)i]);\n        }\n    }\n\n#ifdef _OPENMP\n    /* Use parallel work only when estimated per-column sorting work is substantial. */\n    if (col >= 4 && lin >= 64 &&\n        (long long)lin * (long long)lin >=\n            (200000LL + (long long)col - 1) / (long long)col) {\n#pragma omp parallel for schedule(static)\n        for (i = 0; i < col; i++) {\n            calcula_coluna(matriz, lin, i, media, media_har, mediana, moda,\n                           variancia, dp, cv);\n        }\n    } else {\n        for (i = 0; i < col; i++) {\n            calcula_coluna(matriz, lin, i, media, media_har, mediana, moda,\n                           variancia, dp, cv);\n        }\n    }\n#else\n    for (i = 0; i < col; i++) {\n        calcula_coluna(matriz, lin, i, media, media_har, mediana, moda,\n                       variancia, dp, cv);\n    }\n#endif\n\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", media[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", media_har[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", mediana[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", moda[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", variancia[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", dp[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", cv[i]);\n    printf(\"\\n\");\n\n    free(matriz);\n    free(media);\n    free(media_har);\n    free(mediana);\n    free(moda);\n    free(variancia);\n    free(dp);\n    free(cv);\n    return 0;\n}\n"
}

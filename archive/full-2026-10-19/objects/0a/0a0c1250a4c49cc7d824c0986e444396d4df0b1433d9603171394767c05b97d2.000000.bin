        "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\nconst int TILE = 64;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<vector<int>> blockedColumns(n);\n    for (int k = 0; k < m; ++k) {\n        int row, column;\n        cin >> row >> column;\n        if (0 <= row && row < n && 0 <= column && column < n) {\n            blockedColumns[row].push_back(column);\n        }\n    }\n\n    for (auto& row : blockedColumns) {\n        sort(row.begin(), row.end());\n        row.erase(unique(row.begin(), row.end()), row.end());\n    }\n\n    int answer = 0;\n    const int tileCount = (n + TILE - 1) / TILE;\n\n#ifdef _OPENMP\n    if (tileCount >= 32) {\n        vector<int> bottomCurrent(tileCount * TILE, 0);\n        vector<int> bottomNext(tileCount * TILE, 0);\n        vector<int> rightCurrent(tileCount * TILE, 0);\n        vector<int> rightNext(tileCount * TILE, 0);\n\n        const int lastDiagonal = 2 * tileCount - 2;\n\n#pragma omp parallel\n        {\n            vector<int> tileValues(TILE * TILE, 0);\n\n            for (int diagonal = 0; diagonal <= lastDiagonal; ++diagonal) {\n                const int firstTileRow = max(0, diagonal - (tileCount - 1));\n                const int lastTileRow = min(tileCount - 1, diagonal);\n\n#pragma omp for schedule(static)\n                for (int tileRow = firstTileRow; tileRow <= lastTileRow; ++tileRow) {\n                    const int tileColumn = diagonal - tileRow;\n                    const int rowStart = tileRow * TILE;\n                    const int columnStart = tileColumn * TILE;\n                    const int height = min(TILE, n - rowStart);\n                    const int width = min(TILE, n - columnStart);\n\n                    for (int localRow = 0; localRow < height; ++localRow) {\n                        const int globalRow = rowStart + localRow;\n                        const vector<int>& blocked = blockedColumns[globalRow];\n                        auto blockedIt = lower_bound(blocked.begin(), blocked.end(), columnStart);\n\n                        for (int localColumn = 0; localColumn < width; ++localColumn) {\n                            const int globalColumn = columnStart + localColumn;\n                            const bool isBlocked = blockedIt != blocked.end() && *blockedIt == globalColumn;\n                            if (isBlocked) ++blockedIt;\n\n                            int value = 0;\n                            if (!isBlocked) {\n                                if (globalRow == 0 && globalColumn == 0) {\n                                    value = 1;\n                                } else {\n                                    int fromAbove = 0;\n                                    int fromLeft = 0;\n                                    if (localRow > 0) {\n                                        fromAbove = tileValues[(localRow - 1) * TILE + localColumn];\n                                    } else if (tileRow > 0) {\n                                        fromAbove = bottomCurrent[tileColumn * TILE + localColumn];\n                                    }\n                                    if (localColumn > 0) {\n                                        fromLeft = tileValues[localRow * TILE + localColumn - 1];\n                                    } else if (tileColumn > 0) {\n                                        fromLeft = rightCurrent[tileRow * TILE + localRow];\n                                    }\n                                    value = fromAbove + fromLeft;\n                                    if (value >= MOD) value -= MOD;\n                                }\n                            }\n                            tileValues[localRow * TILE + localColumn] = value;\n                        }\n                    }\n\n                    for (int localColumn = 0; localColumn < width; ++localColumn) {\n                        bottomNext[tileColumn * TILE + localColumn] =\n                            tileValues[(height - 1) * TILE + localColumn];\n                    }\n                    for (int localRow = 0; localRow < height; ++localRow) {\n                        rightNext[tileRow * TILE + localRow] =\n                            tileValues[localRow * TILE + width - 1];\n                    }\n\n                    if (tileRow == tileCount - 1 && tileColumn == tileCount - 1) {\n                        answer = tileValues[(height - 1) * TILE + width - 1];\n                    }\n                }\n\n#pragma omp single\n                {\n                    bottomCurrent.swap(bottomNext);\n                    rightCurrent.swap(rightNext);\n                }\n            }\n        }\n    } else\n#endif\n    {\n        vector<int> dp(n, 0);\n        for (int row = 0; row < n; ++row) {\n            const vector<int>& blocked = blockedColumns[row];\n            size_t blockedIndex = 0;\n            for (int column = 0; column < n; ++column) {\n                const bool isBlocked = blockedIndex < blocked.size() && blocked[blockedIndex] == column;\n                if (isBlocked) ++blockedIndex;\n\n                if (isBlocked) {\n                    dp[column] = 0;\n                } else if (row == 0 && column == 0) {\n                    dp[column] = 1;\n                } else {\n                    int value = dp[column];\n                    if (column > 0) value += dp[column - 1];\n                    if (value >= MOD) value -= MOD;\n                    dp[column] = value;\n                }\n            }\n        }\n        answer = dp[n - 1];\n    }\n\n    cout << answer << '\\n';\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }

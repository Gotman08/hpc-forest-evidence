import hashlib,json
from pathlib import Path
folder=Path(__file__).resolve().parent
base=folder.parents[2]
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
ref=lambda p:{'path':str(p.resolve()),'sha256':sha(p)}
factory=folder.parent/'revision-r1-lane-v2'
original=json.loads((factory/'MANIFESTE-LANCEUR-R2D.json').read_text(encoding='utf8'))
assert all(sha(factory/name)==row['sha256'] and (factory/name).stat().st_size==row['bytes'] for name,row in original['members'].items())
project=base/'work/hpc-forest-primes-native-max-r2d/project'
sealed=base/'outputs/HPC-Forest-Primes-Natif-MAX-r2/revision-r2d'
source=json.loads((sealed/'runtime-manifest-r2max.json').read_text(encoding='utf8'))
actual={p.relative_to(project).as_posix():sha(p) for p in project.rglob('*') if p.is_file() and not any(x in {'__pycache__','.pytest_cache','.ruff_cache'} for x in p.relative_to(project).parts)}
assert actual==source and len(source)==105
assert sha(sealed/'HPC-Forest-Primes-Natif-MAX-r2d.zip')=='13ccaf7c74d13db246d1127a25c511bc03d7989ba9097eb6ad7b4f681c0a0a46'
assert sha(sealed/'native-max-plan.json')=='5e052db689fc423720be60dab97fbca70c82b64487d02d3d8fe2d0f796d9c96c'
assert '51 passed' in (folder/'tests-neutres-final.txt').read_text(encoding='utf-8-sig')
assert 'All checks passed!' in (folder/'ruff-final.txt').read_text(encoding='utf-8-sig')
manifest={'schema':'hpc-forest-r2d-first-start-reader-manifest-v1','members':{p.relative_to(folder).as_posix():{'sha256':sha(p),'bytes':p.stat().st_size} for p in sorted(folder.rglob('*')) if p.is_file()}}
manifest_path=folder/'MANIFESTE-LECTEUR-PREMIER-DEMARRAGE.json'
with manifest_path.open('x',encoding='utf8') as f:f.write(json.dumps(manifest,ensure_ascii=False,indent=2)+'\n')
delivery={'schema':'hpc-forest-r2d-first-start-reader-local-delivery-v1','verified':True,
 'scope':'Local preparation and neutral tests only; no production first-start receipt',
 'manifest':ref(manifest_path),'controller':ref(folder/'controler-reception-bornee.py'),'helpers':ref(folder/'reception_bornee.py'),
 'interface':ref(folder/'REPRISE.md'),'origin_and_limitations':ref(folder/'ORIGINE-ET-LIMITES.json'),
 'neutral_tests_passed':51,'tests':ref(folder/'tests-neutres-final.txt'),'ruff':ref(folder/'ruff-final.txt'),
 'executable_interface_neutral_incomplete_input_refuses_exit1':ref(folder/'execution-interface-neutre-final.txt'),
 'factory_manifest_preserved':ref(factory/'MANIFESTE-LANCEUR-R2D.json'),'factory_members_preserved':len(original['members']),
 'source105_preserved':True,'source_zip_sha256':sha(sealed/'HPC-Forest-Primes-Natif-MAX-r2d.zip'),'plan_sha256':sha(sealed/'native-max-plan.json'),
 'native_first_normal_actual_received':False,'native_first_real_evaluation_actual_received':False,
 'complete_independent_reader_review_received':False,'native_research_admitted':False,'final_cohort_reader_admitted':False,
 'CLI_or_native_worker_processes_started':0,'model_calls':0,'network_calls':0,'C_programs_executed':0,
 'properties':['Dynamic actual job/auth/Q inputs; no hardcoded future job IDs',
 'Same immutable installed-worker auth/ready/cache links required before initial_lane=False read-only gate',
 'Versioned lane-v2/full source105 validators reused without installation path',
 'First delivered NORMAL distinct from mother; all named calls exact usage/process/request/response/ready/delivery SHA',
 'Recorded first evaluation/private context/raw cases/commit/tree/binary; no algorithm or oracle repair',
 'CLI WARN/nonJSON/error/unknown items retained as hashes/raw-log refs and refuse clean NORMAL',
 'Explicit received snapshots only; no live cache/lock/SQLite opens',
 'Before/after inventories; no extension or global performance/isolation claim'],
 'limits':['Production invocation remains conditional on real received proofs',
 'Full independent reader review not yet received; partial finding corrected and tested',
 'Final Git/cohort/performance/isolation audit remains separate']}
delivery_path=folder/'LIVRAISON-LECTEUR-PREMIER-DEMARRAGE-R2D.json'
with delivery_path.open('x',encoding='utf8') as f:f.write(json.dumps(delivery,ensure_ascii=False,indent=2)+'\n')
print(json.dumps({'delivery':ref(delivery_path),'manifest':ref(manifest_path),'controller':delivery['controller'],'helpers':delivery['helpers'],'members':len(manifest['members'])}))

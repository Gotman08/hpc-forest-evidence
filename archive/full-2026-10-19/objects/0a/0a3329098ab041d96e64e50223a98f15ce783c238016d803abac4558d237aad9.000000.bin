#include "knn.h"

char knn(int total_n, float *xs, float *ys, char *labels, int k, Point to_evaluate) {
    // Stack-allocated top-k arrays (max 256)
    float dists[256];
    char lbls[256];
    int cnt = 0;

    for (int i = 0; i < total_n; i++) {
        float d = euclidean_distance_no_sqrt(to_evaluate, (Point){xs[i], ys[i]});
        if (cnt < k) {
            // Insert in sorted order (ascending)
            int pos = cnt;
            while (pos > 0 && dists[pos - 1] > d) {
                dists[pos] = dists[pos - 1];
                lbls[pos] = lbls[pos - 1];
                pos--;
            }
            dists[pos] = d;
            lbls[pos] = labels[i];
            cnt++;
        } else if (d < dists[k - 1]) {
            // Replace the largest element and re-sort
            int pos = k - 1;
            while (pos > 0 && dists[pos - 1] > d) {
                dists[pos] = dists[pos - 1];
                lbls[pos] = lbls[pos - 1];
                pos--;
            }
            dists[pos] = d;
            lbls[pos] = labels[i];
        }
    }

    // Frequency histogram over 256 possible character values
    int freq[256] = {0};
    for (int i = 0; i < cnt; i++) {
        unsigned char c = lbls[i];
        freq[c]++;
    }

    char best_label = 0;
    int max_freq = 0;
    for (int c = 0; c < 256; c++) {
        if (freq[c] > max_freq) {
            max_freq = freq[c];
            best_label = (char)c;
        }
    }

    return best_label;
}

int main() {
    float *xs, *ys;
    char *labels;
    Point to_evaluate;
    int k;

    // Read input into flat arrays
    int total_n = read_input(&xs, &ys, &labels, &k, &to_evaluate);

    printf("%c", knn(total_n, xs, ys, labels, k, to_evaluate));

    free(xs);
    free(ys);
    free(labels);
    return 0;
}

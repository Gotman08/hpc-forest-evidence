        "src/tropical.cpp"
      ],
      "retained": [
        "Make Prim_ST reentrant with caller-owned tree output, read-only reference inputs and removal of its unused shared visit counter.",
        "Construct each parallel child's exact inclusion prefix and exclusion list independently.",
        "Dynamically schedule child construction with OpenMP and publish successful children in original order using an ordered region; leave DFS and partition selection serial."
      ]
    },
    "status": "valid",
    "mean_seconds": 0.006455746789773305,
    "commit": "95c562552b8406344350599c879e09fbe4408a37"

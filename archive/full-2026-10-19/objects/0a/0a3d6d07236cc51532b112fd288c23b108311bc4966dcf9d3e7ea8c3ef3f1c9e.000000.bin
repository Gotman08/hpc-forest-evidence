    "hypothesis_as_declared_by_model": "Passing read-only graphs, matrices and vectors by const reference will reduce allocation and memory traffic while preserving exact search behavior.",
    "transformations_as_declared_by_model": {
      "files": [
        "src/tropical.cpp"
      ],
      "retained": [
        "Pass graph arguments by const reference throughout spanning-tree generation and path traversal.",
        "Pass cycle-check matrices, edge-list inputs, minimum-key inputs and read-only lookup/output vectors by const reference.",
        "Use const iterators where required by the read-only parameter types."
      ]
    },
    "status": "valid",

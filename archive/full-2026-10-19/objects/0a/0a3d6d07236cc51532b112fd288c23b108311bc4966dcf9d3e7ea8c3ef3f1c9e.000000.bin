  {
    "subject": "2020-quicksort",
    "id": "c6f3a11d9bee4237",
    "role": "A",
    "parent_id": null,
    "delegation_parent": "R/A",
    "integration_sources": [],
    "hypothesis_as_declared_by_model": "Four 8-bit radix passes should improve locality over recursive partitioning: small bucket working sets, one combined histogram scan, and normally no final array copy.",
    "transformations_as_declared_by_model": {
      "files": [
        "src/quicksort.c"
      ],
      "retained": [
        "Replace the public sorting backend with single-threaded stable LSD radix sorting using sign-bit-normalized keys and four jointly computed byte histograms.",
        "Reuse one scratch array across passes; skip only histogram-proven constant digits and copy back only after an odd number of active passes.",
        "Use insertion sort through 64 elements and an allocation-free heapsort fallback when scratch allocation fails or native integers are not 32-bit."
      ]
    },
    "status": "valid",
    "mean_seconds": 0.01824890449643135,
    "commit": "c698bac64933ddf0b4de98716e797495f08096b6"
  },
  {
    "subject": "2020-quicksort",
    "id": "ed46fb1a793d4302",
    "role": "B",
    "parent_id": null,
    "delegation_parent": "R/B",
    "integration_sources": [],
    "hypothesis_as_declared_by_model": "Stable byte-radix passes with independent histogram banks can outperform branch-heavy partitioning. Disjoint worker bucket ranges permit race-free parallel scatter, while only the independent histogram reduction is annotated for SIMD.",
    "transformations_as_declared_by_model": {
      "files": [
        "src/quicksort.c"
      ],
      "retained": [
        "Replace the public sorting backend with stable signed-integer LSD radix sorting using one temporary array.",
        "Use four independent histogram banks and SIMD-safe bank reduction; retain ordered scalar cursor updates during scatter.",
        "Conditionally use a persistent team of at most four OpenMP workers, padded histogram rows, per-pass recounting and exclusive bucket offsets.",
        "Use insertion sort for tiny arrays and standard-library sorting if scratch allocation fails."
      ]
    },
    "status": "valid",
    "mean_seconds": 0.0158761003986001,
    "commit": "ddc8487d217c655819f6ee85d22782a4f4ef9229"
  },
  {
    "subject": "2020-quicksort",

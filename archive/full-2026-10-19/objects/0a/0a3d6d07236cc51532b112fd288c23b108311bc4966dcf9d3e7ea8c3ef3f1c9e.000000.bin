        "src/quicksort.c"
      ],
      "retained": [
        "Parallelize generation for N >= 65536 using one balanced contiguous block per actual OpenMP team member; retain the original serial path for small cases or builds without OpenMP.",
        "Initialize block-local MWC states using modular exponentiation, preserve the original per-element arithmetic, and publish the exact final states after the parallel region."
      ]
    },
    "status": "valid",
    "mean_seconds": 0.06946942955255508,
    "commit": "cd1ea14702bc7f00028b3088b29b7318424d298e"
  },
  {

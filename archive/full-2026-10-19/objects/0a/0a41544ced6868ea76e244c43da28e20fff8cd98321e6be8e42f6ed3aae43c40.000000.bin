#include <cassert>
#include <cstddef>
#include <cstdio>
#include <limits>
#include <vector>

int main() {
    int n, s;
    if (std::scanf("%d%d", &n, &s) != 2) return 0;

    assert(n > 0);
    assert(s > 0);
    assert(s < n);
    assert(n < 8000);

    const int positions = n - s + 1;
    const std::size_t width = static_cast<std::size_t>(n);
    std::vector<int> matrix(width * width);
    for (std::size_t i = 0; i < matrix.size(); ++i) {
        std::scanf("%d", &matrix[i]);
    }

    // Each entry is the vertical sum for one column in the current S-row band.
    std::vector<long long> columnSums(width, 0);
    for (int row = 0; row < s; ++row) {
        const std::size_t rowOffset = static_cast<std::size_t>(row) * width;
        for (int col = 0; col < n; ++col) {
            columnSums[static_cast<std::size_t>(col)] +=
                matrix[rowOffset + static_cast<std::size_t>(col)];
        }
    }

    // Prefix sums turn each horizontal window into an independent difference.
    std::vector<long long> prefix(width + 1, 0);
    long long maxSum = 0;
    for (int top = 0; top < positions; ++top) {
        prefix[0] = 0;
        for (int col = 0; col < n; ++col) {
            prefix[static_cast<std::size_t>(col) + 1] =
                prefix[static_cast<std::size_t>(col)] +
                columnSums[static_cast<std::size_t>(col)];
        }

        long long rowMax = std::numeric_limits<long long>::lowest();
        #pragma omp simd reduction(max: rowMax)
        for (int left = 0; left < positions; ++left) {
            const long long windowSum =
                prefix[static_cast<std::size_t>(left + s)] -
                prefix[static_cast<std::size_t>(left)];
            if (windowSum > rowMax) rowMax = windowSum;
        }
        if (top == 0 || rowMax > maxSum) maxSum = rowMax;

        // Band updates are independent across columns and safe to vectorize.
        if (top + 1 < positions) {
            const std::size_t leavingOffset = static_cast<std::size_t>(top) * width;
            const std::size_t enteringOffset = static_cast<std::size_t>(top + s) * width;
            #pragma omp simd
            for (int col = 0; col < n; ++col) {
                const std::size_t index = static_cast<std::size_t>(col);
                columnSums[index] +=
                    static_cast<long long>(matrix[enteringOffset + index]) -
                    matrix[leavingOffset + index];
            }
        }
    }

    std::printf("%lld\n", maxSum);
    return 0;
}

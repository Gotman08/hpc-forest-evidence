"""Prepared ROOT-only external lifecycle gate. Import performs no observation/effect.

No source110/62 modification, process effect, census capture, transport or model.
The archive mode is an EXPLICIT runtime rename after actually reviewed closure.
It is never part of a start attempt and never reads/removes an operational lock.
"""
from __future__ import annotations
import argparse
import ast
from datetime import UTC, datetime
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import time

CODE = Path(__file__).resolve().parent
LIVE = CODE.parent
OP = LIVE.parent
PREP = OP.parent
BASE = PREP.parents[1]
OBS = OP/'preparation-observation-R8-r1'
CHAIN = PREP/'adaptateurs-source110-r1/revision-r8-racines-techniques-neuves'
P8 = OP/'preparation-derivee-R8-apres-raccord-r1'
IO_SOURCE = P8/'preparer-plan-R8-phase1-parent.py'
IO_SHA = '83bc0810fca205d5548fbd78fb7f6ff86e81e3ca279a60e4d095a7b7bbb56efc'
COPY_SOURCE = LIVE/'copie-froide-demarrage-R8-r1/copier-quatre-sources-demarrage-R8-parent.py'
COPY_SHA = '8d1564a3526a06b92983daa126a043b14c3df2bbf4be35a4257323ad1926ff6f'
OLD_GATE = OBS/'verifier-absence-ancien-OBS4-R8.py'
OLD_GATE_SHA = '6483d35f9dd928f1a4c1451cca88b0a87355138c4b144c992c89274393369139'
CLOSURE_GATE = LIVE/'fermeture-passive-R8-preparee-r1/garder-fermeture-passive-R8.py'
CLOSURE_GATE_SHA = '9530ca13166cd9afbaa0b9fc3b5b93cd53b471bffe264bcec705befcebd77c16'
COMPONENTS = 'd7d7d240198fc487efbede15c1328a366bc0c5bd59614d5064e19d81d1cf7122'
SOURCE = 'eaff9217499fe268e4d151165a368a83bad1550d921955a9f9256026cfac2d48'
PLAN = 'f927d37098f3fd50cc4916195da3e300bd7c29597ba7ece4b9669abd715897fe'
INTENT_NAME = 'INTENTION-UNIQUE-OBS4-R8-REPRISE-02.json'
RUNTIME_NAMES = ('observer-state.json', 'terminal-statuses.json', 'attention-required.json')
OWNED_IDS = {9192, 14840, 19968, 47844, 40556, 22368}
SELF = CODE/'cycle-passif-externe-R8.py'
TEST = CODE/'test_cycle_passif_externe_R8.py'
CASES = 19


def need(ok, message):
    if not ok:
        raise ValueError(message)


def sha(value):
    return hashlib.sha256(value).hexdigest()


def utc_epoch(value):
    need(isinstance(value, str), 'Actual explicit UTC timestamp required')
    point = datetime.fromisoformat(value.replace('Z', '+00:00'))
    need(point.tzinfo is not None and point.utcoffset().total_seconds() == 0, 'UTC required')
    return point.timestamp()


def actual(value):
    need(isinstance(value, dict) and isinstance(value.get('schema'), str)
         and not any(x in value['schema'].upper() for x in ('INERT', 'FIXTURE', 'NON-ADMIS'))
         and value.get('fixture_only') is not True and value.get('prepared_only') is not True,
         'Actual received metadata only; no proposal/fixture promotion')


def load_module(store, path, checksum):
    raw = store.pinned(path, checksum)
    tree = ast.parse(raw)
    need(isinstance(tree.body[-1], ast.If) and ast.unparse(tree.body[-1].test) == "__name__ == '__main__'",
         'Only a source with the exact removable main guard may supply definitions')
    tree.body.pop()
    result = {'__file__': str(path), '__name__': 'ROOT_external_passive_definitions_only'}
    exec(compile(tree, str(path), 'exec'), result)
    return result


def bootstrap_io():
    for path in (*reversed(IO_SOURCE.parents), IO_SOURCE):
        s = path.lstat()
        need(not stat.S_ISLNK(s.st_mode) and not getattr(s, 'st_file_attributes', 0) & 1024,
             'Qualified loader ancestor reparse refused')
    raw = IO_SOURCE.read_bytes()
    need(sha(raw) == IO_SHA, 'Qualified cold IO loader changed')
    tree = ast.parse(raw)
    need(isinstance(tree.body[-1], ast.If) and ast.unparse(tree.body[-1].test) == "__name__ == '__main__'", 'Exact loader main excluded')
    tree.body.pop()
    ns = {'__file__': str(IO_SOURCE), '__name__': 'ROOT_external_lifecycle_cold_IO'}
    exec(compile(tree, str(IO_SOURCE), 'exec'), ns)
    need(ns['BASE'] == BASE and ns['PREP'] == PREP, 'Exact workspace IO boundary')
    return ns


def closure_contract(closure, reviewed, closure_ref, review_ref):
    actual(closure); actual(reviewed)
    need(closure.get('schema') == 'hpc-forest-r8-obs4-main-only-owned-passive-closure-v1'
         and closure.get('verified_metadata_only') is True
         and closure.get('verified_owned_observer_absence') is True
         and closure.get('source_zip_sha256') == SOURCE and closure.get('plan_sha256') == PLAN
         and closure.get('frozen62', {}).get('sha256') == COMPONENTS
         and closure.get('only_main19968_ever_permitted_as_effect') is True
         and closure.get('services_naturally_absent') is True
         and closure.get('observer_lock_read') is False
         and closure.get('current_state_after_observation_promised') is False
         and closure.get('native_generation_admitted') is False,
         'Actual bounded six-context closure is a required historical prerequisite')
    graph = closure.get('graph_state', {})
    need(graph.get('all_six_original_identities_absent') is True and graph.get('pair_absent') is True
         and graph.get('unresolved_context') is False, 'Unresolved/present predecessor preserved; no restart')
    need(reviewed.get('schema') == 'hpc-forest-r8-obs4-main-only-owned-passive-actual-closure-cold-review-v1'
         and reviewed.get('closure') == closure_ref and reviewed.get('final_full_cim') == closure.get('final_full_cim')
         and reviewed.get('blocking_findings') == [] and reviewed.get('native_generation_admitted') is False
         and all(reviewed.get(key) is True for key in ('verified_metadata_only', 'verified_owned_observer_absence',
                  'all_six_original_identities_absent', 'only_main19968_effect', 'no_future_state_promised')),
         'A new actual independent cold closure review is required, never its preparation review')
    need(closure_ref != review_ref, 'Review and closure must be separate actual files')


def require_current_six_absence(rows, anchors):
    expected = anchors.get('contextual_identities')
    need(isinstance(expected, list) and len(expected) == 6
         and {row['ProcessId'] for row in expected} == OWNED_IDS, 'Exact historical six identity graph required')
    # Reused PID is ambiguous, never a target or an adopted descendant.
    need(not any(row['ProcessId'] in OWNED_IDS or row['ParentProcessId'] in OWNED_IDS for row in rows),
         'Original/reused PID or ambiguous child is preserved; start refused')
    script = str(CHAIN/'observer/observer-mixte.py').replace('/', '\\').casefold()
    need(not any(script in (row.get('CommandLine') or '').replace('/', '\\').casefold()
                 or re.search(r'(?:^|[\\/])observer-mixte\.py(?:[\"\s]|$)', (row.get('CommandLine') or '').casefold())
                 for row in rows), 'Equivalent observer present; no duplicate passive loop')


def verify_lifecycle(store, current_ref, closure_ref, review_ref):
    closure, reviewed = store.reference(closure_ref), store.reference(review_ref)
    closure_contract(closure, reviewed, closure_ref, review_ref)
    need(Path(closure_ref['path']).is_relative_to(LIVE/'fermeture-passive-R8-preparee-r1')
         and Path(review_ref['path']).is_relative_to(LIVE/'fermeture-passive-R8-preparee-r1'),
         'Closure and actual review must remain in the separately owned closure boundary')
    plan = store.reference(closure['plan'])
    anchors = store.reference(plan['cold_anchors'])
    need(plan.get('effect_targets') == [19968] and plan.get('frozen62') == closure['frozen62'], 'Actual main-only closure plan')
    final = store.reference(closure['final_full_cim'])
    current = store.reference(current_ref)
    need(current_ref != closure['final_full_cim'] and current_ref['path'] != closure['final_full_cim']['path']
         and current_ref['sha256'] != closure['final_full_cim']['sha256']
         and current['observed_at'] > utc_epoch(closure['observed_at_utc'])
         and utc_epoch(current['captured_at_utc']) > utc_epoch(final['captured_at_utc']),
         'New complete census must postdate the actual closure, never rename its historical census')
    gate = load_module(store, CLOSURE_GATE, CLOSURE_GATE_SHA)
    # Existing exact capacity definitions: both typed native filters plus three literal absent caches.
    gate['initialize_io']()
    ns, api = gate['pure_capacity']()
    rows = ns['complete_cim'](current, time.time())
    ns['classify_zero'](rows, api)
    caches = [ns['ordinary_absence'](PREP/('lancement-modeles-max-r3/worker-'+session)) for session in gate['SESSIONS']]
    require_current_six_absence(rows, anchors)
    ns['complete_cim'](current, time.time())
    return closure, {'closure': closure_ref, 'independent_actual_closure_review': review_ref,
                     'fresh_full_cim': current_ref, 'all_six_original_identities_absent': True,
                     'no_reused_or_ambiguous_context': True, 'active_native_workers': 0,
                     'cache_absence': caches, 'historical_closure_is_not_current_absence': True}


def archive_contract(value, closure_ref, review_ref):
    actual(value)
    need(value.get('schema') == 'hpc-forest-r8-owned-passive-runtime-archive-v1'
         and value.get('verified_archived_runtime_only') is True
         and value.get('closure') == closure_ref and value.get('independent_actual_closure_review') == review_ref
         and value.get('former_canonical_names') == list(RUNTIME_NAMES)
         and value.get('former_state_present') is True and value.get('old_intention_changed') is False
         and value.get('lock_payload_read_or_modified') is False and value.get('source62_changed') is False
         and value.get('native_generation_admitted') is False,
         'Actual explicit postclosure runtime archive required; no state silently reset')
    need(len(value.get('files', [])) in (1, 2, 3)
         and {item['name'] for item in value['files']}.issubset(RUNTIME_NAMES)
         and 'observer-state.json' in {item['name'] for item in value['files']}, 'Exact named runtime archive')


def sequence_terminal(value):
    actual(value)
    need(value.get('schema') == 'hpc-forest-r8-original-passive-sequence-terminal-reception-v1'
         and value.get('original_tool_session') == '33705'
         and value.get('original_intent', {}).get('sha256') == 'feee0b85d5aa8fd4c3327914786eb432a24aee80acee9895f3c084d793511c3e'
         and value.get('original_start_observed', {}).get('sha256') == '1a2e2e5bf49cc82fd0258d4c8cfa8cab46e597d2575804ebb617a306631bb784'
         and value.get('original_sequence_terminal_received') is True
         and value.get('finally_completed') is True and value.get('pending_actions') == []
         and value.get('old_120_second_window_preserved_expired') is True
         and value.get('original_copy_guard_expired_refusal_received') is True
         and isinstance(value.get('actual_failure_or_refusal'), dict)
         and value.get('automatic_retry_performed') is False
         and type(value.get('actual_tool_exit_code')) is int
         and value.get('native_generation_admitted') is False,
         'Original ROOT sequence33705 must have actually terminated/finalized; no concurrent old copy instruction')
    for name in ('finally_execution','actual_tool_terminal_result','original_wrapper','original_log'):
        reference=value.get(name)
        need(isinstance(reference,dict) and set(reference)=={'path','sha256'}
             and Path(reference['path']).is_relative_to(LIVE/'activation-passive-reelle-root-01')
             and re.fullmatch('[0-9a-f]{64}',reference['sha256']), 'Actual terminal/finally/wrapper/log references required')


def archive_runtime(io, names, source_dir, output, preserved, *, intent_written):
    """ROOT effect, never called on import: retain exact objects by handle rename.

    DELETE access + no WRITE/DELETE sharing is deliberate ONLY after closure.
    Handles bind identity before payload and rename; no operation uses a source pathname to rename.
    FileRenameInfo ReplaceIfExists=false and RootDirectory=held output prevent replacement/traversal.
    """
    need(intent_written is True and tuple(names) == RUNTIME_NAMES, 'Durable explicit archive intent before effect')
    c, w = io.c, io.w
    io.api.SetFileInformationByHandle.argtypes = [w.HANDLE, c.c_int, c.c_void_p, w.DWORD]
    io.api.SetFileInformationByHandle.restype = w.BOOL
    records = []
    out_handle = io.open(output, 0x81, 3, directory=True)
    try:
        out_identity = io.info(out_handle, directory=True); io.final_path(out_handle, output)
        for name in names:
            source, target = source_dir/name, output/('ORIGINAL-'+name)
            try:
                # Inspect the final entry, even if it is a dangling reparse object.
                source.lstat()
            except FileNotFoundError:
                need(name != 'observer-state.json', 'Previous state is mandatory; absence is not an implicit reset')
                continue
            need(name in preserved, 'Runtime absent from actual postclosure preserved inventory')
            parents = io.parents(source)
            handle = io.open(source, 0x80010080, 1)  # GR | DELETE | ATTR, share READ only
            try:
                before = io.info(handle); io.final_path(handle, source)
                checkpoint = preserved[name]['source_native_checkpoint']
                need(before['links'] == 1 and io.parents(source) == parents
                     and checkpoint['path'] == str(source) and checkpoint['metadata'] == before
                     and checkpoint['parent_identities'] == parents,
                     'Exact single-link same native identity as actual postclosure preservation before bytes')
                raw = io.read_bytes(handle, before['bytes'])
                need(io.info(handle) == before and sha(raw) == preserved[name]['sha256'],
                     'Runtime changed since actual closure preservation; refuse without clearing it')
                raw_name = target.name.encode('utf-16-le')
                class Rename(c.Structure):
                    _fields_ = [('ReplaceIfExists', w.BOOLEAN), ('RootDirectory', w.HANDLE),
                                ('FileNameLength', w.DWORD), ('FileName', w.WCHAR*len(target.name))]
                rename = Rename()
                rename.ReplaceIfExists = False; rename.RootDirectory = out_handle
                rename.FileNameLength = len(raw_name); rename.FileName = target.name
                need(io.info(handle) == before and io.parents(source) == parents, 'Recheck same source handle before rename')
                if not io.api.SetFileInformationByHandle(handle, 3, c.byref(rename), c.sizeof(rename)):
                    io.fail('Exclusive held-object runtime archival failed; no retry')
                io.final_path(handle, target)
                after = io.info(handle)
                need(all(after[key] == before[key] for key in ('volume_serial','file_id_128','bytes','links','creation_ticks','write_ticks','attributes')),
                     'Renamed object identity/bytes changed; preserve UNKNOWN and never retry')
                if not io.api.SetFilePointerEx(handle, 0, None, 0): io.fail('Archive readback seek')
                need(io.read_bytes(handle, before['bytes']) == raw, 'Held archive readback differs')
                records.append({'name': name, 'former_path': str(source), 'retained_path': str(target),
                                'sha256': sha(raw), 'bytes': len(raw), 'before': before, 'after': after,
                                'same_held_object_renamed': True, 'rename_change_time_may_change': True})
            finally:
                io.close(handle)
        need(io.info(out_handle, directory=True)['file_id_128'] == out_identity['file_id_128'], 'Archive directory object changed')
    finally:
        io.close(out_handle)
    return records


class ArchiveDirectories:
    """Postclosure only: real LIST_DIRECTORY|ATTR access, share RW, no DELETE.

    Attributes-only handles do not establish a Windows sharing exclusion.
    This short lease deliberately never enumerates a directory.
    """
    def __init__(self, io): self.io, self.handles = io, []
    def hold(self, path):
        path=Path(path)
        handle=self.io.open(path,0x81,3,directory=True)
        self.handles.append(handle)
        self.io.info(handle,directory=True);self.io.final_path(handle,path)
    def __enter__(self): return self
    def __exit__(self,*_):
        for handle in reversed(self.handles):self.io.close(handle)
        self.handles.clear()


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--mode', required=True, choices=('archive', 'current'))
    for name in ('closure', 'closure-review', 'full-cim'):
        p.add_argument('--'+name, type=Path, required=True); p.add_argument('--'+name+'-sha256', required=True)
    p.add_argument('--archive', type=Path); p.add_argument('--archive-sha256')
    p.add_argument('--previous-sequence-terminal', type=Path, required=True)
    p.add_argument('--previous-sequence-terminal-sha256', required=True)
    p.add_argument('--output', type=Path, required=True)
    p.add_argument('--helper-review', type=Path, required=True); p.add_argument('--helper-review-sha256', required=True)
    p.add_argument('--neutral-completion', type=Path, required=True); p.add_argument('--neutral-completion-sha256', required=True)
    args = p.parse_args()
    ns = bootstrap_io(); store = ns['ColdStore']()
    def ref(path, checksum):
        ns['ordinary_path'](path, beneath=BASE)
        return ns['ref'](path, checksum)
    review_ref, completion_ref = ref(args.helper_review, args.helper_review_sha256), ref(args.neutral_completion, args.neutral_completion_sha256)
    review, completion = store.reference(review_ref), store.reference(completion_ref)
    code_sha, test_sha = sha(store.raw(SELF)), sha(store.raw(TEST))
    need(review.get('schema') == 'hpc-forest-r8-external-passive-lifecycle-preparation-review-v1'
         and review.get('verified_source_preparation_only') is True and review.get('blocking_findings') == []
         and review.get('reviewed_files') == {SELF.name:code_sha, TEST.name:test_sha}
         and review.get('native_generation_admitted') is False, 'Actual independent lifecycle source/test review')
    need(completion.get('schema') == 'hpc-forest-r8-external-passive-lifecycle-neutral-completion-v1'
         and completion.get('code_sha256') == code_sha and completion.get('test_sha256') == test_sha
         and type(completion.get('tests_run')) is int and completion['tests_run'] == CASES
         and all(type(completion.get(k)) is int and completion[k] == 0 for k in ('exit_code','failures','errors','skipped'))
         and completion.get('live_runtime_read_or_changed') is False, 'Actual new ROOT neutral completion required')
    closure_ref, cold_review_ref = ref(args.closure, args.closure_sha256), ref(args.closure_review, args.closure_review_sha256)
    cim_ref = ref(args.full_cim, args.full_cim_sha256)
    terminal_ref = ref(args.previous_sequence_terminal, args.previous_sequence_terminal_sha256)
    need(Path(terminal_ref['path']).name == 'EXECUTION-SEQUENCE-PASSIVE-ROOT.json'
         and Path(terminal_ref['path']).parent == LIVE/'activation-passive-reelle-root-01', 'Original sequence terminal receipt literal path')
    terminal = store.reference(terminal_ref); sequence_terminal(terminal)
    store.pinned(Path(terminal['actual_failure_or_refusal']['path']),terminal['actual_failure_or_refusal']['sha256'])
    store.reference(terminal['original_intent']); store.reference(terminal['original_start_observed'])
    finally_execution=store.reference(terminal['finally_execution'])
    need(finally_execution.get('schema')=='hpc-forest-r8-root-one-passive-sequence-execution-v1'
         and finally_execution.get('last_stage')=='cold_copy_four'
         and isinstance(finally_execution.get('failure'),str) and finally_execution['failure']
         and finally_execution.get('native_worker_or_job_started') is False
         and finally_execution.get('native_generation_admitted') is False
         and finally_execution.get('no_retry_performed') is True,
         'Actual original finally must retain the old cold-copy failure; no replay or pending work')
    for name in ('actual_tool_terminal_result','original_wrapper','original_log'):
        store.pinned(Path(terminal[name]['path']),terminal[name]['sha256'])
    components = json.loads(store.pinned(CHAIN/'COMPONENTS.json',COMPONENTS))
    need(len(components['code_pins']) == 62 and components['source_zip_sha256'] == SOURCE
         and components['plan_sha256'] == PLAN, 'Exact immutable source110/plan/62')
    for name, checksum in components['code_pins'].items(): store.pinned(CHAIN/name,checksum)
    closure, evidence = verify_lifecycle(store, cim_ref, closure_ref, cold_review_ref)
    output = ns['ordinary_path'](args.output, beneath=OBS, missing_leaf=True)
    if args.mode == 'archive':
        need(output.parent == OBS and output.name == 'archive-runtime-reprise-02', 'One exact new archive directory')
        ns['require_missing'](output)
        intent = CODE/'INTENTION-UNIQUE-ARCHIVE-RUNTIME-REPRISE-02.json'
        ns['require_missing'](intent)
        preserved = {Path(item['source']).name:item for item in closure['metadata_preservation_after']['files']
                     if Path(item['source']).parent == CHAIN/'observer' and Path(item['source']).name in RUNTIME_NAMES}
        need('observer-state.json' in preserved, 'Actual postclosure preserved state required')
        for item in preserved.values(): store.pinned(Path(item['received']), item['sha256'])
        shared = load_module(store, COPY_SOURCE, COPY_SHA)
        io = shared['NativeSharedIO'](BASE)
        # Read no lock bytes: lstat only, before and after, with explicit unknown SHA.
        lock = CHAIN/'observer/observer.lock'
        def lock_stat():
            try: s=lock.lstat()
            except FileNotFoundError: return {'path':str(lock),'exists':False,'bytes_read':False,'read_attempted':False,'read_errno':None,'sha256':None}
            need(stat.S_ISREG(s.st_mode) and not getattr(s,'st_file_attributes',0)&1024, 'Ordinary lock metadata only')
            return {'path':str(lock),'exists':True,'bytes':s.st_size,'dev':s.st_dev,'ino':s.st_ino,
                    'mtime_ns':s.st_mtime_ns,'ctime_ns':s.st_ctime_ns,'bytes_read':False,'read_attempted':False,'read_errno':None,'sha256':None}
        lock_before = lock_stat()
        with ArchiveDirectories(io) as leases:
            paths=set((*CODE.parents,CODE,*OBS.parents,OBS,*(CHAIN/'observer').parents,CHAIN/'observer'))
            for parent in sorted(paths,key=lambda path:len(path.parts)):leases.hold(parent)
            ns['require_missing'](output); output.mkdir(); leases.hold(output)
            ns['write_new'](intent, ns['json_bytes']({'schema':'hpc-forest-r8-explicit-postclosure-runtime-archive-intent-v1',
                'closure':closure_ref,'review':cold_review_ref,'current_full_cim':cim_ref,'output':str(output),
                'previous_sequence_terminal':terminal_ref,
                'exact_names':list(RUNTIME_NAMES),'automatic_retry_allowed':False,'native_generation_admitted':False}))
            files = archive_runtime(io, RUNTIME_NAMES, CHAIN/'observer', output, preserved, intent_written=True)
            need(lock_stat() == lock_before, 'Lock metadata changed; no positive archive receipt')
            store.unchanged()
            value = {'schema':'hpc-forest-r8-owned-passive-runtime-archive-v1','verified_archived_runtime_only':True,
                'closure':closure_ref,'independent_actual_closure_review':cold_review_ref,'fresh_absence':evidence,
                'previous_sequence_terminal':terminal_ref,
                'helper_review':review_ref,'neutral_completion':completion_ref,'intent':ns['ref'](intent,sha(store.raw(intent))),
                'former_canonical_names':list(RUNTIME_NAMES),'former_state_present':True,'files':files,
                'old_intention_changed':False,'lock_stat_only':lock_before,'lock_payload_read_or_modified':False,
                'source62_changed':False,'native_generation_admitted':False,'observed_at_utc':datetime.now(UTC).isoformat()}
            ns['write_new'](output/'ARCHIVAGE-RUNTIME-POST-CLOTURE.json',ns['json_bytes'](value))
        print(json.dumps({'archive':str(output/'ARCHIVAGE-RUNTIME-POST-CLOTURE.json'),'native_generation_admitted':False})); return
    need(args.archive is not None and args.archive_sha256 is not None, 'Actual archive required before a new start lifecycle')
    archive_ref = ref(args.archive,args.archive_sha256); archived=store.reference(archive_ref)
    archive_contract(archived,closure_ref,cold_review_ref)
    for item in archived['files']: store.pinned(Path(item['retained_path']),item['sha256'])
    # All runtime names must remain absent before a fresh start; aliases/reparse also refuse.
    for name in RUNTIME_NAMES:
        try: (CHAIN/'observer'/name).lstat()
        except FileNotFoundError: pass
        else: raise ValueError('Canonical old runtime still exists; no restart')
    need(args.mode == 'current', 'archive-check is deliberately non-effectful but still requires current absence')
    old = load_module(store,OLD_GATE,OLD_GATE_SHA)
    result = old['verify_paths'](cim_ref, {'path':str(old['CLOSURE_REVIEW']),'sha256':old['CLOSURE_REVIEW_SHA']})
    result.update(previous_R8_lifecycle=evidence,previous_R8_runtime_archive=archive_ref,
                  new_start_intent_name=INTENT_NAME,new_observer_or_native_generation_admitted=False)
    store.unchanged(); ns['require_missing'](output)
    ns['write_new'](output,ns['json_bytes'](result))
    print(json.dumps({'proof':str(output),'native_generation_admitted':False}))


if __name__ == '__main__':
    main()

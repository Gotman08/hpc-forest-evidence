      "content": "#include <bits/stdc++.h>\n\nusing namespace std;\n\ntypedef long long ll;\n\nint A[1000][1000];\n\nstruct FrequencyTable {\n  static constexpr uint32_t CAPACITY = 2048;\n  int keys[CAPACITY]{};\n  int counts[CAPACITY]{};\n  uint32_t generations[CAPACITY]{};\n  uint32_t epoch = 0;\n\n  static size_t hashKey(int key) {\n    uint32_t x = static_cast<uint32_t>(key);\n    x ^= x >> 16;\n    x *= 0x7feb352dU;\n    x ^= x >> 15;\n    x *= 0x846ca68bU;\n    x ^= x >> 16;\n    return static_cast<size_t>(x) & (CAPACITY - 1);\n  }\n\n  void beginBand() {\n    ++epoch;\n    if (epoch == 0) {\n      fill(generations, generations + CAPACITY, 0U);\n      ++epoch;\n    }\n  }\n\n  int find(int key) const {\n    size_t slot = hashKey(key);\n    while (generations[slot] == epoch) {\n      if (keys[slot] == key)\n        return counts[slot];\n      slot = (slot + 1) & (CAPACITY - 1);\n    }\n    return 0;\n  }\n\n  void increment(int key) {\n    size_t slot = hashKey(key);\n    while (generations[slot] == epoch && keys[slot] != key)\n      slot = (slot + 1) & (CAPACITY - 1);\n    if (generations[slot] != epoch) {\n      generations[slot] = epoch;\n      keys[slot] = key;\n      counts[slot] = 0;\n    }\n    ++counts[slot];\n  }\n};\n\nll solve(int m, int n, int k) {\n  const int bandLength = min(m, n);\n  const int scanLength = max(m, n);\n  int compressed[1000]{};\n  FrequencyTable frequencies;\n  ll answer = 0;\n\n  for (int first = 0; first < bandLength; ++first) {\n    fill(compressed, compressed + scanLength, 0);\n    for (int last = first; last < bandLength; ++last) {\n#pragma GCC ivdep\n      for (int position = 0; position < scanLength; ++position)\n        compressed[position] += A[last][position];\n\n      frequencies.beginBand();\n      frequencies.increment(0);\n      int prefix = 0;\n      for (int position = 0; position < scanLength; ++position) {\n        prefix += compressed[position];\n        answer += frequencies.find(prefix - k);\n        frequencies.increment(prefix);\n      }\n    }\n  }\n  return answer;\n}\n\nint main() {\n  ios::sync_with_stdio(false);\n  cin.tie(nullptr);\n\n  int k, m, n;\n  cin >> k >> m >> n;\n  const bool rowsAreBandAxis = m <= n;\n  for (int i = 0; i < m; ++i) {\n    for (int j = 0; j < n; ++j) {\n      int value;\n      cin >> value;\n      if (rowsAreBandAxis)\n        A[i][j] = value;\n      else\n        A[j][i] = value;\n    }\n  }\n\n  cout << solve(m, n, k) << '\\n';\n  return 0;\n}\n",
      "path": "src/main.cpp"
    }

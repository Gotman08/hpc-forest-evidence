{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <ctype.h>\\n#include <limits.h>\\n#include <stdint.h>\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n\\ntypedef struct {\\n  int id;\\n  float value;\\n  size_t edge_begin;\\n  size_t edge_count;\\n} Node;\\n\\ntypedef struct {\\n  char *text;\\n  int id;\\n  int index;\\n} Root;\\n\\nstatic void fail(void) {\\n  fputs(\\\"Error!\\\\n\\\", stderr);\\n  exit(1);\\n}\\n\\nstatic void *allocate_array(size_t count, size_t item_size, int clear) {\\n  if (count == 0)\\n    return NULL;\\n  if (item_size > SIZE_MAX / count)\\n    fail();\\n  void *memory = clear ? calloc(count, item_size) : malloc(count * item_size);\\n  if (memory == NULL)\\n    fail();\\n  return memory;\\n}\\n\\nstatic void *reserve_array(void *array, size_t *capacity, size_t needed,\\n                           size_t item_size) {\\n  if (needed <= *capacity)\\n    return array;\\n\\n  size_t new_capacity = *capacity ? *capacity : 16;\\n  while (new_capacity < needed) {\\n    if (new_capacity > SIZE_MAX / 2) {\\n      new_capacity = needed;\\n      break;\\n    }\\n    new_capacity *= 2;\\n  }\\n  if (item_size > SIZE_MAX / new_capacity)\\n    fail();\\n\\n  void *new_array = realloc(array, new_capacity * item_size);\\n  if (new_array == NULL)\\n    fail();\\n  *capacity = new_capacity;\\n  return new_array;\\n}\\n\\nstatic char *read_line(FILE *stream) {\\n  size_t capacity = 128;\\n  size_t length = 0;\\n  char *line = allocate_array(capacity, sizeof(*line), 0);\\n  int ch;\\n\\n  while ((ch = fgetc(stream)) != EOF && ch != '\\\\n') {\\n    if (length == capacity - 1) {\\n      if (capacity > SIZE_MAX / 2)\\n        fail();\\n      capacity *= 2;\\n      char *grown = realloc(line, capacity);\\n      if (grown == NULL)\\n        fail();\\n      line = grown;\\n    }\\n    line[length++] = (char)ch;\\n  }\\n\\n  if (ch == EOF && length == 0) {\\n    free(line);\\n    return NULL;\\n  }\\n  line[length] = '\\\\0';\\n  return line;\\n}\\n\\nstatic char *next_token(char **cursor) {\\n  char *p = *cursor;\\n  while (*p != '\\\\0' && isspace((unsigned char)*p))\\n    ++p;\\n  if (*p == '\\\\0') {\\n    *cursor = p;\\n    return NULL;\\n  }\\n\\n  char *start = p;\\n  while (*p != '\\\\0' && !isspace((unsigned char)*p))\\n    ++p;\\n  if (*p != '\\\\0')\\n    *p++ = '\\\\0';\\n  *cursor = p;\\n  return start;\\n}\\n\\nstatic int parse_int_token(const char *token) {\\n  char *end;\\n  long value = strtol(token, &end, 10);\\n  if (token == end || *end != '\\\\0' || value < INT_MIN || value > INT_MAX)\\n    fail();\\n  return (int)value;\\n}\\n\\nstatic float parse_float_token(const char *token) {\\n  char *end;\\n  float value = strtof(token, &end);\\n  if (token == end || *end != '\\\\0')\\n    fail();\\n  return value;\\n}\\n\\nstatic char *copy_string(const char *source) {\\n  size_t length = strlen(source);\\n  if (length == SIZE_MAX)\\n    fail();\\n  char *copy = allocate_array(length + 1, sizeof(*copy), 0);\\n  memcpy(copy, source, length + 1);\\n  return copy;\\n}\\n\\nstatic void append_root(Root **roots, size_t *length, size_t *capacity,\\n                        const char *text) {\\n  if (*length == SIZE_MAX)\\n    fail();\\n  *roots = reserve_array(*roots, capacity, *length + 1, sizeof(**roots));\\n  (*roots)[*length].text = copy_string(text);\\n  (*roots)[*length].id = atoi(text);\\n  (*roots)[*length].index = -1;\\n  ++*length;\\n}\\n\\nstatic void append_edge(int **edges, size_t *length, size_t *capacity, int id) {\\n  if (*length == SIZE_MAX)\\n    fail();\\n  *edges = reserve_array(*edges, capacity, *length + 1, sizeof(**edges));\\n  (*edges)[(*length)++] = id;\\n}\\n\\nstatic uint32_t hash_id(int id) {\\n  uint32_t x = (uint32_t)id;\\n  x ^= x >> 16;\\n  x *= 0x7feb352dU;\\n  x ^= x >> 15;\\n  x *= 0x846ca68bU;\\n  x ^= x >> 16;\\n  return x;\\n}\\n\\nstatic size_t *build_id_map(const Node *nodes, int node_count,\\n                            size_t *capacity_out) {\\n  size_t capacity = 8;\\n  if ((size_t)node_count > SIZE_MAX / 2)\\n    fail();\\n  size_t needed = (size_t)node_count * 2;\\n  while (capacity < needed) {\\n    if (capacity > SIZE_MAX / 2)\\n      fail();\\n    capacity *= 2;\\n  }\\n\\n  size_t *map = allocate_array(capacity, sizeof(*map), 1);\\n  size_t mask = capacity - 1;\\n  for (int i = 0; i < node_count; ++i) {\\n    size_t slot = (size_t)hash_id(nodes[i].id) & mask;\\n    while (map[slot] != 0) {\\n      size_t previous = map[slot] - 1;\\n      if (nodes[previous].id == nodes[i].id)\\n        break;\\n      slot = (slot + 1) & mask;\\n    }\\n    if (map[slot] == 0)\\n      map[slot] = (size_t)i + 1;\\n  }\\n\\n  *capacity_out = capacity;\\n  return map;\\n}\\n\\nstatic int find_by_id(const Node *nodes, const size_t *map, size_t capacity,\\n                      int id) {\\n  size_t mask = capacity - 1;\\n  size_t slot = (size_t)hash_id(id) & mask;\\n  while (map[slot] != 0) {\\n    size_t index = map[slot] - 1;\\n    if (nodes[index].id == id)\\n      return (int)index;\\n    slot = (slot + 1) & mask;\\n  }\\n  return -1;\\n}\\n\\nstatic float evaluate_cost(int root, const Node *nodes, const int *successor,\\n                           float *costs, unsigned char *done, int *path,\\n                           size_t node_count) {\\n  if (root < 0)\\n    return 0.0f;\\n\\n  size_t length = 0;\\n  int current = root;\\n  while (current >= 0 && !done[current]) {\\n    if (length >= node_count)\\n      fail();\\n    path[length++] = current;\\n    current = successor[current];\\n  }\\n\\n  while (length > 0) {\\n    int node = path[--length];\\n    float result = nodes[node].value;\\n    if (successor[node] >= 0)\\n      result += costs[successor[node]];\\n    costs[node] = result;\\n    done[node] = 1;\\n  }\\n  return costs[root];\\n}\\n\\nint main(void) {\\n  Root *roots = NULL;\\n  size_t root_count = 0;\\n  size_t root_capacity = 0;\\n\\n  char *line = read_line(stdin);\\n  if (line == NULL)\\n    fail();\\n  char *cursor = line;\\n  char *token = next_token(&cursor);\\n  if (token == NULL)\\n    fail();\\n  int node_count = parse_int_token(token);\\n  if (node_count < 0)\\n    fail();\\n  while ((token = next_token(&cursor)) != NULL)\\n    append_root(&roots, &root_count, &root_capacity, token);\\n  free(line);\\n\\n  Node *nodes = allocate_array((size_t)node_count, sizeof(*nodes), 1);\\n  int *edge_ids = NULL;\\n  size_t edge_count = 0;\\n  size_t edge_capacity = 0;\\n\\n  for (int i = 0; i < node_count; ++i) {\\n    line = read_line(stdin);\\n    if (line == NULL)\\n      fail();\\n    cursor = line;\\n    char *id_token = next_token(&cursor);\\n    char *value_token = next_token(&cursor);\\n    if (id_token == NULL || value_token == NULL)\\n      fail();\\n\\n    nodes[i].id = parse_int_token(id_token);\\n    nodes[i].value = parse_float_token(value_token);\\n    nodes[i].edge_begin = edge_count;\\n    while ((token = next_token(&cursor)) != NULL)\\n      append_edge(&edge_ids, &edge_count, &edge_capacity, atoi(token));\\n    nodes[i].edge_count = edge_count - nodes[i].edge_begin;\\n    free(line);\\n  }\\n\\n  size_t map_capacity;\\n  size_t *map = build_id_map(nodes, node_count, &map_capacity);\\n  int *successor = allocate_array((size_t)node_count, sizeof(*successor), 0);\\n  for (int i = 0; i < node_count; ++i) {\\n    float maximum = 0.0f;\\n    int best = -1;\\n    size_t end = nodes[i].edge_begin + nodes[i].edge_count;\\n    for (size_t edge = nodes[i].edge_begin; edge < end; ++edge) {\\n      int neighbor = find_by_id(nodes, map, map_capacity, edge_ids[edge]);\\n      if (neighbor >= 0 && maximum < nodes[neighbor].value) {\\n        maximum = nodes[neighbor].value;\\n        best = nodes[neighbor].id == -1 ? -1 : neighbor;\\n      }\\n    }\\n    successor[i] = best;\\n  }\\n\\n  for (size_t i = 0; i < root_count; ++i)\\n    roots[i].index = find_by_id(nodes, map, map_capacity, roots[i].id);\\n  free(map);\\n  free(edge_ids);\\n\\n  float *costs = allocate_array((size_t)node_count, sizeof(*costs), 0);\\n  unsigned char *done = allocate_array((size_t)node_count, sizeof(*done), 1);\\n  int *path = allocate_array((size_t)node_count, sizeof(*path), 0);\\n\\n  for (size_t i = 0; i < root_count; ++i) {\\n    float result = evaluate_cost(roots[i].index, nodes, successor, costs, done,\\n                                 path, (size_t)node_count);\\n    printf(\\\"%s: %f\\\\n\\\", roots[i].text, result);\\n  }\\n\\n  for (size_t i = 0; i < root_count; ++i)\\n    free(roots[i].text);\\n  free(roots);\\n  free(path);\\n  free(done);\\n  free(costs);\\n  free(successor);\\n  free(nodes);\\n  return 0;\\n}\\n\",\"path\":\"src/graph.c\"}],\"hypothesis\":\"Replacing repeated linear ID searches and recursive recomputation with contiguous graph storage, one-time first-match ID resolution, selected-successor memoization, and iterative evaluation should reduce work while preserving the program’s output semantics.\",\"notes\":\"Retains the strongest measured sequential approach and the compatible request pre-resolution idea. The slower archived OpenMP and SIMD variants are not included.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[\"bbf84f6d35e84d84\",\"5acdcc28f0964695\"],\"transformations\":[\"Parse records into compact node metadata and contiguous input-order adjacency storage, then resolve neighbor IDs once with an open-addressed map that preserves the first matching duplicate ID.\",\"Preselect successors using the original zero initial maximum, strict greater-than comparison, first-on-ties behavior, missing-neighbor handling, and the -1 recursion sentinel; evaluate chains iteratively with demand-driven memoization.\",\"Resolve requested roots to their first matching node indices before releasing the lookup map, retain original request tokens, and preserve recursive-order float additions and six-decimal output.\"]}"}}

"""Pure exact cold-reader binding. Never collect CIM, stop, replay or read caches."""
import argparse
import ast
from datetime import UTC, datetime
import hashlib
import json
from pathlib import Path
import re
import time

HERE=Path(__file__).resolve().parent
ASSEMBLER=HERE/"assembler-entrees-roots-R8.py"
ASSEMBLER_SHA="096540150d0686bca45bbc5ed6ac008c92b49cba447d00188fa781445834531e"
assembler_code=ASSEMBLER.read_bytes()
if hashlib.sha256(assembler_code).hexdigest()!=ASSEMBLER_SHA:
    raise ValueError("Pinned local metadata adapter changed before loading")
ns={"__file__":str(ASSEMBLER),"__name__":"owned_root_metadata_definitions"}
exec(compile(assembler_code,str(ASSEMBLER),"exec"),ns)
BASE,PREP=ns["BASE"],ns["PREP"]
need=ns["need"]
HIST=BASE/"outputs/HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r2/operations-parent-lane-close-20261018T0542"
READER=BASE/"outputs/HPC-Forest-Primes-Natif-Lancement-r2d/source-only-reader-r4/source_only_state.py"
READER_SHA="564398d676dceb6b5ba893fcbb3835c7aec31a1cbd5d5c5dcef6b361a3a23338"
COLD_SHA="111e3e09d9cb14b7aca3e5859b971cd2d543610bc5b5e93bfbbf888ea4b3c1a5"
META_SHA="6a0b0c2e9e2562daeb6837f517d75fc360fa5f3696bab6bf0274dc0c02d67838"

def main():
    p=argparse.ArgumentParser(description=__doc__)
    p.add_argument("--check-static",action="store_true")
    p.add_argument("--source-absence",type=Path)
    p.add_argument("--source-absence-sha256")
    p.add_argument("--full-cim",type=Path)
    p.add_argument("--full-cim-sha256")
    p.add_argument("--output",type=Path)
    args=p.parse_args()
    io=ns["held_reads"]()
    pins={}
    def reference(path):
        path=Path(path)
        checksum=hashlib.sha256(io["raw"](path)).hexdigest()
        pins[str(path)]=checksum
        return {"path":str(path),"sha256":checksum}
    def bound(ref):
        need(isinstance(ref,dict) and set(ref)=={"path","sha256"} and reference(ref["path"])==ref,"Exact cold metadata reference required")
        return Path(ref["path"])
    def read(ref):
        return io["decode"](io["raw"](bound(ref)))
    cold=reference(HIST/"cim-complet-0628.json")
    meta=reference(HIST/"reception-sortie-naturelle/RECEPTION-COLD-METADONNEES.json")
    need(cold["sha256"]==COLD_SHA and meta["sha256"]==META_SHA,"Actual intermediate absence/reception pins differ")
    metadata=read(meta)
    need(metadata.get("schema")=="hpc-forest-natural-exit-cold-metadata-reception-v1" and metadata.get("verified") is True
         and metadata.get("cold_full_cim")==cold,"Actual intermediate disappearance bridge required")
    code=io["raw"](READER)
    need(hashlib.sha256(code).hexdigest()==READER_SHA,"Exact corrected PID-reuse reader required")
    names={"epoch","identity","complete_census","pair","_absent_owned","_creation_key","_unresolved_descendants","verify_absence"}
    functions=[node for node in ast.parse(code).body if isinstance(node,ast.FunctionDef) and node.name in names]
    need({node.name for node in functions}==names,"Closed pure graph verifier function set required")
    pure={"need":need,"read":read,"artifact":bound,"time":time,"datetime":datetime,"UTC":UTC,"re":re,
          "FIELDS":("ProcessId","ParentProcessId","ExecutablePath","CommandLine","CreationDate"),
          "SO_SESSION":"665743a02b824021a697b6a4884a667c","SO_SOURCE":"9a68a83fde4acb6bd247d79e00490e7d36f0c4c59c6c881152101e4c499387eb","COLD_RECEPTION_SHA":META_SHA}
    exec(compile(ast.Module(body=functions,type_ignores=[]),str(READER),"exec"),pure)
    if args.check_static:
        need(not any((args.source_absence,args.full_cim,args.output)),"Static-only mode cannot fabricate a current proof")
        print(json.dumps({"static_exact_reader_and_cold_reception_available":True,"new_complete_absence_created":False,
                          "fresh_CIM_and_exact_descendant_review_still_required":True,"effects":0}))
        return
    need(all((args.source_absence,args.source_absence_sha256,args.full_cim,args.full_cim_sha256,args.output)),"Explicit actual absence/CIM/SHA/new output required")
    proof=read({"path":str(args.source_absence),"sha256":args.source_absence_sha256})
    current=read({"path":str(args.full_cim),"sha256":args.full_cim_sha256})
    need(proof.get("verified") is True and proof.get("subject")=="source-only" and proof.get("prior_full_cim")==metadata["prior_full_cim"],"Original exact prior graph must match the received bridge")
    need(proof.get("fresh_full_cim")=={"path":str(args.full_cim),"sha256":args.full_cim_sha256},"No substitution of the actual fresh proof census")
    proof=dict(proof)
    proof["historical_cold_cim"]=cold
    proof["cold_metadata_reception"]=meta
    refs=list(proof["evidence_refs"])
    for item in (cold,meta):
        if item not in refs:
            refs.append(item)
    proof["evidence_refs"]=refs
    closure=read({"path":str(BASE/"outputs/HPC-Forest-Harnais-Comparaison-r1/reprises/r3-corrige-r4-parallele-20261018/fermeture-r2-main-only-verifiee.json"),
                  "sha256":"f9d64a0e87ad68248429681cb3efe01a9e56289fba615eeb55291089665aee3d"})
    owned=pure["verify_absence"](proof,closure["source_only"],current)
    need(len(owned)==7,"Exactly the received original pair plus five attributed descendants required")
    for path,checksum in pins.items():
        need(hashlib.sha256(io["raw"](path)).hexdigest()==checksum,"Cold evidence changed while validating")
    output=io["ordinary"](args.output)
    need(output.parent==HERE and not output.exists(),"New direct operation-preparation proof only")
    proof.update(complete_lane_graph_verified=True,source_state_reader_sha256=READER_SHA,native_generation_admitted=False)
    with output.open("x",encoding="utf8",newline="\n") as stream:
        json.dump(proof,stream,indent=2);stream.write("\n")
    print(json.dumps({"complete_absence":reference(output),"owned_identities":len(owned),"fresh_graph_verified":True,
                      "independent_descendant_review_still_required":True,"native_generation_admitted":False}))

if __name__=="__main__":
    main()

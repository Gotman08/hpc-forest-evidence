"""Aides Clap uniquement : aucun exec/app-server/doctor/features effectif."""
from pathlib import Path
import datetime
import hashlib
import json
import subprocess

BASE = Path(__file__).resolve().parents[4]
OUT = Path(__file__).resolve().parent / "aides-cli"
CLI_DIR = BASE / "outputs/HPC-Forest-Etude-2020-2024-r1/reprises/incident-double-liaison-20261017T2012/cli-0.163.0-alpha.10.2"
CLI_SHA = "f6dbf48cb70f62649c645f26c87dc9bf84cc36986202dfad8e12fb5b8ca70312"
NAMES = ("codex.exe", "codex-code-mode-host.exe", "codex-command-runner.exe", "codex-windows-sandbox-setup.exe")
def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()
def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()
if OUT.exists():
    raise RuntimeError("No overwrite or retry of an existing help operation")
before = {name: sha(CLI_DIR / name) for name in NAMES}
if before["codex.exe"] != CLI_SHA:
    raise RuntimeError("CLI pin mismatch")
OUT.mkdir()
records = []
for name in ("debug", "doctor"):
    argv = [str(CLI_DIR / "codex.exe"), "help", name]
    started = now()
    try:
        completed = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=15, shell=False, creationflags=subprocess.CREATE_NO_WINDOW)
        stdout, stderr, rc, timed_out = completed.stdout, completed.stderr, completed.returncode, False
    except subprocess.TimeoutExpired as exc:
        stdout, stderr, rc, timed_out = exc.stdout or b"", exc.stderr or b"", None, True
    stdout_path, stderr_path = OUT / f"help-{name}.stdout.txt", OUT / f"help-{name}.stderr.txt"
    stdout_path.write_bytes(stdout)
    stderr_path.write_bytes(stderr)
    records.append({"argv": argv, "started_utc": started, "ended_utc": now(), "returncode": rc, "timeout": timed_out, "stdout": {"path": str(stdout_path), "sha256": sha(stdout_path), "bytes": len(stdout)}, "stderr": {"path": str(stderr_path), "sha256": sha(stderr_path), "bytes": len(stderr)}})
after = {name: sha(CLI_DIR / name) for name in NAMES}
receipt = {"schema": "hpc-forest-offline-clap-help-only-v1", "completed_utc": now(), "before": before, "after": after, "four_files_unchanged": before == after, "records": records, "model_invocation_requested": False, "app_server_requested": False, "doctor_or_features_operation_requested": False, "config_or_auth_or_global_role_modified": False, "native_admission": False}
(OUT / "RECU-AIDES.json").write_text(json.dumps(receipt, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
print(json.dumps({"receipt": str(OUT / "RECU-AIDES.json"), "receipt_sha256": sha(OUT / "RECU-AIDES.json"), "four_files_unchanged": before == after, "commands": [{"argv_tail":r["argv"][1:], "returncode":r["returncode"], "timeout":r["timeout"], "stdout_bytes":r["stdout"]["bytes"], "stderr_bytes":r["stderr"]["bytes"]} for r in records]}, ensure_ascii=False))


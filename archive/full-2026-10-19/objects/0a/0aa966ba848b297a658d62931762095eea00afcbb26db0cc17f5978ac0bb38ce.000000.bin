        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n#include <string.h>\n\n#define MAXNUM 100\n#define MAXSTR 50\n#define MAXRESULTS 1000\n#define TRIAL_DIVISOR_LIMIT 24514\n\nchar firstHalf[MAXNUM][MAXSTR];\nchar secondHalf[MAXNUM][MAXSTR];\nchar strToTest[MAXSTR];\nlong int result[MAXRESULTS];\nint numPrimes=0;\n\nstatic uint16_t trial_primes[TRIAL_DIVISOR_LIMIT / 2];\nstatic unsigned int trial_prime_count;\nstatic int trial_primes_ready;\n\nstatic void prepare_trial_primes(void)\n{\n  static unsigned char composite[(TRIAL_DIVISOR_LIMIT + 1) / 2];\n\n  for (uint32_t p=3; (uint64_t)p*p<=TRIAL_DIVISOR_LIMIT; p+=2)\n      if (!composite[p >> 1])\n         for (uint32_t multiple=p*p; multiple<=TRIAL_DIVISOR_LIMIT;\n              multiple+=2*p)\n             composite[multiple >> 1]=1;\n\n  trial_prime_count=0;\n  for (uint32_t p=7; p<=TRIAL_DIVISOR_LIMIT; p+=2)\n      if (!composite[p >> 1])\n         trial_primes[trial_prime_count++]=(uint16_t)p;\n  trial_primes_ready=1;\n}\n\nint isprime(long int value)\n{\n  if (value<2)\n     return 0;\n\n  uint64_t wide=(uint64_t)value;\n  if ((wide & 1u)==0)\n     return wide==2;\n  if (wide%3u==0)\n     return wide==3;\n  if (wide%5u==0)\n     return wide==5;\n  if (wide<49)\n     return 1;\n\n  if (!trial_primes_ready)\n     prepare_trial_primes();\n\n  if (wide<=UINT32_MAX)\n     {\n       uint32_t n=(uint32_t)wide;\n       for (unsigned int i=0; i<trial_prime_count; ++i)\n           {\n             uint32_t p=trial_primes[i];\n             if ((uint64_t)p*p>n)\n                return 1;\n             if (n%p==0)\n                return 0;\n           }\n     }\n  else\n     {\n       for (unsigned int i=0; i<trial_prime_count; ++i)\n           {\n             uint32_t p=trial_primes[i];\n             if ((uint64_t)p*p>wide)\n                return 1;\n             if (wide%p==0)\n                return 0;\n           }\n     }\n\n  /* Preserve exactness for values beyond the cached divisor range. */\n  for (uint64_t factor=TRIAL_DIVISOR_LIMIT+1u;\n       factor*factor<=wide; factor+=2u)\n      if (wide%factor==0)\n         return 0;\n  return 1;\n}\n\nvoid quicksort(long int *primes,int first,int last)\n{ int i, j, pivot;\n  long int temp;\n\n  if (first<last)\n     { pivot=first;\n       i=first;\n       j=last;\n       while(i<j)\n         { while (primes[i]<=primes[pivot]&&i<last)\n             i++;\n           while(primes[j]>primes[pivot])\n             j--;\n           if (i<j)\n              { temp=primes[i];\n                primes[i]=primes[j];\n                primes[j]=temp;\n              }\n         }\n       temp=primes[pivot];\n       primes[pivot]=primes[j];\n       primes[j]=temp;\n       quicksort(primes,first,j-1);\n       quicksort(primes,j+1,last);\n     }\n}\n\n\nint main(int argc,char** argv)\n{ FILE *primesFile;\n  int i=0,j=0,numResults=0;\n  long int primeToTest;\n  primesFile=stdin;\n  fscanf(primesFile,\"%d\\n\",&numPrimes);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",firstHalf[i]);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",secondHalf[i]);\n  fclose(primesFile);\n  for (i=0;i<numPrimes;i++)\n      for (j=0;j<numPrimes;j++)\n          { strcpy(strToTest,firstHalf[i]);\n            strcat(strToTest,secondHalf[j]);\n            primeToTest=atol(strToTest);\n            if (isprime(primeToTest))\n               { result[numResults++]=primeToTest;\n               }\n          }\n  quicksort(result,0,numResults-1);\n  for (i=0;i<numResults;i++)\n      printf(\"%ld\\n\",result[i]);\n  return 0;\n}\n",

#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>

int main() {
	int n,s;
	std::cin >> n >> s;
	// Flatten matrix into a single contiguous vector for better cache locality and SIMD.
	std::vector<int> mat(n * n);
	for(int i=0;i<n;i++)
		for(int j=0;j<n;j++) 
			scanf("%d", &mat[i*n + j]);

	assert(s<n);
	assert(n<8000);
	assert(s>0);
	assert(n>0);

	int sum = 0;
	// Initial window sum: use collapse(2) to help vectorization.
	#pragma omp simd collapse(2) reduction(+:sum)
	for(int i=0;i<s;i++)
		for(int j=0;j<s;j++)
			sum += mat[i*n + j];

	int mxSum = sum;

	int dir = 1;
	int i = 0;
	int j = 0;
	while(i+s <= n) {
		if( (j+s == n && dir==1) || (j==0 && dir==-1) ) { 
			// Vertical move: swap rows
			int exitingRow = i;
			int enteringRow = exitingRow + s;
			if(enteringRow >= n) break;

			#pragma omp simd reduction(+:sum)
			for(int k=0;k<s;k++) {
				sum += mat[enteringRow*n + (j+k)] - mat[exitingRow*n + (j+k)];
			}

			i++;
			dir*=-1;
		} else {
			int exitingCol, enteringCol;
			if(dir==1) {
				exitingCol = j;
				enteringCol = exitingCol + s;
			} else {
				// moving left: new column is j-1
				enteringCol = j - 1;
				exitingCol = enteringCol + s; // old rightmost column
			}

			#pragma omp simd reduction(+:sum)
			for(int k=0;k<s;k++) {
				sum += mat[(i+k)*n + enteringCol] - mat[(i+k)*n + exitingCol];
			}
			j+=dir;
		}
		mxSum = std::max(mxSum,sum);
	}
	printf("%d\n",mxSum);
}

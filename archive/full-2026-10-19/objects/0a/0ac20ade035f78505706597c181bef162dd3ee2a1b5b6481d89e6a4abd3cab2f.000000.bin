"""Real receiver/callee namespace; all auth/cache/CLI/process/transport effects forbidden."""
import copy
import hashlib
import importlib.util
from datetime import UTC, datetime
from pathlib import Path
from types import SimpleNamespace

import pytest

HERE = Path(__file__).resolve().parent
spec = importlib.util.spec_from_file_location('r4_initial_receiver', HERE / 'recevoir-installation-oauth.py')
r = importlib.util.module_from_spec(spec)
spec.loader.exec_module(r)


@pytest.fixture
def actual_callee(monkeypatch):
    factory_path = r.c.FACTORY / 'assembler-admissions-cellule.py'
    assert hashlib.sha256(factory_path.read_bytes()).hexdigest() == '9449b360ed8608e3858d0e332db150cffc2e27b22421c412d3005fcc4c849715'
    assert hashlib.sha256((factory_path.parent / 'preparer-cellule-max.py').read_bytes()).hexdigest() == '67ca844efe21ac45d079cdb18397f228b80a75c53e52caa719864c0d51c8b8c4'
    factory_spec = importlib.util.spec_from_file_location('actual_r4_factory_namespace', factory_path)
    factory = importlib.util.module_from_spec(factory_spec)
    factory_spec.loader.exec_module(factory)
    # This is the ACTUAL production preparer interface, before mutable configure.
    assert factory.m.SCOPE is None and not hasattr(factory.m, 'need')
    assert callable(factory.m.require)
    model, session = r.c.MODELS['astra-max']
    receipt = {'scope_id': r.c.SCOPE, 'model': model, 'effort': 'max', 'session_id': session,
               'job_id': 'NEUTRAL', 'artifacts': {key: {'path': '/NEUTRAL/' + key, 'sha256': str(i) * 64}
               for i, key in enumerate(('source_zip', 'plan', 'preparation_manifest', 'preparation_review'), 1)}}
    calls = []
    original_artifact = lambda ref: ref  # noqa: E731 -- inert identity fixture
    native = SimpleNamespace(artifact=original_artifact)

    def validate(path, jobs, **kwargs):
        calls.append((path, jobs, kwargs))
        value = copy.deepcopy(receipt)
        if len(calls) == 2 and calls_error.get('remote'):
            raise RuntimeError('NEUTRAL remote verifier failure')
        if len(calls) == 2 and calls_error.get('mismatch'):
            value['job_id'] = 'NEUTRAL-CHANGED'
        return value

    calls_error = {}
    native.validate_receipt = validate
    monkeypatch.setattr(factory.m, 'native', lambda: native)
    monkeypatch.setattr(factory.m, 'configure', lambda *_args: None)
    monkeypatch.setattr(factory.m, 'artifact', lambda ref: Path(ref['path']))
    monkeypatch.setattr(factory.m, 'read', lambda _path: {'dependencies': [], 'existing_qualified_files': []})
    monkeypatch.setattr(factory.m, 'remote_resolver', lambda _refs: (lambda ref: ref))
    return factory, native, original_artifact, calls, calls_error


@pytest.mark.parametrize('mismatch', [False, True])
def test_real_receive_and_frozen_compare_use_closed_complete_API_before_any_cache(actual_callee, monkeypatch, mismatch):
    factory, native, original, calls, errors = actual_callee
    errors['mismatch'] = mismatch
    monkeypatch.setattr(r.c, 'load_factory', lambda: factory)
    launch = r.c.FACTORY / 'helper-lancement-possedes/NEUTRAL/LANCEMENTS-POSSEDES-RECUS.json'
    auth_path = r.c.OPS / 'AUTH-METADATA-PARENT.json'
    # Neither path is read. Every receiver input until its first frozen compare is in-memory.
    before = launch.parent / 'cim-complet-avant.json'
    after = launch.parent / 'cim-complet-apres.json'
    census = {'schema': 'hpc-forest-dynamic-r4b-full-cim-v1', 'complete_census': True,
              'strict_utf8_decoding': True, 'rows_count': 0, 'rows': [],
              'captured_at_utc': datetime.now(UTC).isoformat()}
    auth = {'schema': 'hpc-forest-r2e-parent-auth-metadata-observation-v1', 'verified': True,
            'observed_at': datetime.now(UTC).isoformat(), 'auth_mode': 'chatgpt',
            'api_key_in_auth_present': False, 'OPENAI_API_KEY_environment_present': False,
            'CODEX_API_KEY_environment_present': False, 'secrets_exported': False,
            'authentication_changed': False, 'cli_executable_sha256': factory.m.CLI_SHA}
    launched = {'schema': 'hpc-forest-r2e-three-owned-worker-launch-reception-v1', 'verified': True,
                'native_worker_count': 3, 'maximum_native_workers': 4, 'no_automatic_retry': True,
                'foreign_processes_adopted_or_stopped': False, 'before_census': str(before),
                'after_census': str(after), 'workers': [{'model': model, 'session_id': session,
                    'job_id': 'NEUTRAL', 'full_identities': []} for model, session in r.c.MODELS.values()]}
    metadata = {str(launch): launched, str(auth_path): auth, str(before): census, str(after): census}

    def pinned(path, checksum):
        # Permit only the already-pinned public pure-function source read.
        if path == r.READER:
            assert hashlib.sha256(path.read_bytes()).hexdigest() == checksum == r.READER_SHA
        return path

    monkeypatch.setattr(r.c, 'pinned', pinned)
    monkeypatch.setattr(r.c, 'read', lambda path: copy.deepcopy(metadata[str(path)]))

    class ReachedFirstCacheBoundary(Exception):
        pass

    def reference(path):
        if path.name == 'CELL-BINDING.json':
            raise ReachedFirstCacheBoundary('Both frozen authorizations compared; no cache access permitted')
        return {'path': str(path), 'sha256': 'a' * 64}

    monkeypatch.setattr(r.c, 'ref', reference)
    expected = ValueError if mismatch else ReachedFirstCacheBoundary
    with pytest.raises(expected):
        r.receive(launch, 'b' * 64, auth_path, 'c' * 64, 'NEUTRAL')
    assert len(calls) == 2 and native.artifact is original
    assert all(jobs == {r.c.SCOPE} for _path, jobs, _kwargs in calls)
    assert all(kwargs == {'runtime': False, 'prepared': False, 'initial_lane': False}
               for _path, _jobs, kwargs in calls)
    assert factory.m.SCOPE is None and not hasattr(factory.m, 'need')


def test_remote_exception_restores_native_resolver_and_adapter_has_only_required_API(actual_callee):
    factory, native, original, calls, errors = actual_callee
    errors['remote'] = True
    function = r.frozen_validator(factory)
    adapter = function.__globals__['m']
    assert vars(adapter) == {'SCOPE': r.c.SCOPE, 'need': r.c.need}
    with pytest.raises(RuntimeError, match='NEUTRAL remote'):
        function(native, 'LOCAL-NEUTRAL', 'REMOTE-NEUTRAL', lambda ref: ref)
    assert len(calls) == 2 and native.artifact is original

{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include<stdio.h>\\n#include<stdlib.h>\\n#include<math.h>\\n\\nstatic int use_parallel_columns(int lin, int col) {\\n    return col >= 4 &&\\n           (size_t)lin * (size_t)lin * (size_t)col >= (size_t)262144;\\n}\\n\\nvoid bubble_sort (double *matriz, int tam) {\\n    int i, j; \\n    double aux;\\n\\n    for (i = tam - 1; i > 0; i--) {\\n        for (j = 0; j < i; j++) {\\n            if (matriz[j] > matriz[j+1]) {\\n                aux=matriz[j];\\n                matriz[j]=matriz[j+1];\\n                matriz[j+1]=aux;\\n            }\\n        }\\n    }\\n}\\n\\nvoid ordena_colunas(double *matriz,int lin, int col) {\\n    int i;\\n    \\n    #pragma omp for schedule(static)\\n    for (i = 0; i < col; i++) {    \\n        //manda o endereco do primeiro elemento da coluna, limites inf e sup e a largura da matriz\\n        bubble_sort(&matriz[i*lin], lin);\\n    }\\n} \\n\\nvoid calcula_media(double *matriz, double *vet,int lin, int col){\\n    int i,j;\\n    double soma;\\n    #pragma omp for schedule(static)\\n    for(i=0;i<col;i++){\\n        soma=0;\\n        for(j=0;j<lin;j++){\\n            soma+=matriz[i*lin+j];\\n        }\\n        vet[i]=soma/lin; \\n    }   \\n}\\n\\nvoid calcula_media_harmonica(double *matriz, double *vet,int lin, int col){\\n    int i,j;\\n    double soma;\\n    #pragma omp for schedule(static)\\n    for(i=0;i<col;i++){\\n        soma=0;\\n        for(j=0;j<lin;j++){\\n            soma+=(1/(matriz[i*lin+j]));\\n        }\\n        vet[i]=lin/soma; \\n    }   \\n}\\n\\nvoid calcula_mediana(double *matriz, double *vet, int lin, int col) {  \\n     int i=0;\\n     if((lin-1)%2){ //Quantidade par de elementos\\n         #pragma omp for schedule(static)\\n         for (i = 0; i < col; i++) {\\n            vet[i]=(matriz[(((i*lin)+(i+1)*lin)-1)/2]+matriz[((((i*lin)+(i+1)*lin)-1)/2)+1]);\\n            vet[i]*=0.5;\\n            \\n         }\\n     }\\n     else{ //Quantidade ímpar de elementos\\n         #pragma omp for schedule(static)\\n         for (i = 0; i < col; i++) {\\n            vet[i]=matriz[(((i*lin)+(i+1)*lin)-1)/2];\\n         }\\n     }\\n    \\n } \\n\\n//Adaptado de https://www.clubedohardware.com.br/forums/topic/1291570-programa-em-c-que-calcula-moda-media-e-mediana/\\ndouble moda_aux(double *matriz,int lin){\\n    int i, j; \\n    double *cont;\\n    cont=(double*)malloc(lin*sizeof(double));\\n\\tfloat conta=0, moda=0;\\n\\t\\n\\tfor(i=0;i<lin;i++){\\n        cont[i]=0;\\n        for(j=i+1;j<lin;j++){\\n        \\t\\n\\t\\t\\tif(matriz[i]==matriz[j]){\\n\\t\\t\\t\\tcont[i]++;\\n\\t\\t\\t\\t\\tif(cont[i]>conta){\\n\\t\\t\\t\\t\\t\\tconta=cont[i];\\n\\t\\t\\t\\t\\t\\tmoda=matriz[i];\\n\\t\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\n        }\\n    }\\n    free(cont);\\n    if(conta == 0){\\n    \\treturn -1;\\n\\t}\\n\\telse{\\n\\t\\treturn moda;\\n\\t}\\n\\n}\\n\\nvoid calcula_moda(double *matriz,double *moda,int lin, int col){\\n    int i;\\n    #pragma omp for schedule(static)\\n    for(i=0;i<col;i++){\\n        moda[i]=moda_aux(matriz+(i*lin),lin);\\n    }\\n}\\n\\nvoid calcula_variancia(double *matriz, double *media,double *variancia, int lin, int col){\\n    int i,j;\\n    double soma;\\n    #pragma omp for schedule(static)\\n    for(i=0;i<col;i++){\\n        soma=0;\\n        for(j=0;j<lin;j++){\\n            soma+=pow((matriz[i*lin+j]-media[i]),2);\\n        }\\n        variancia[i]=soma/(lin-1); \\n    } \\n}\\n\\nvoid calcula_desvio_padrao(double *variancia,double *dp, int col){\\n    int i;\\n    #pragma omp for schedule(static)\\n    for(i=0;i<col;i++){\\n        dp[i]=sqrt(variancia[i]);\\n    }  \\n}\\n\\nvoid calcula_coeficiente_variacao(double *media,double *dp,double *cv, int col){\\n    int i;\\n    #pragma omp for schedule(static)\\n    for(i=0;i<col;i++){\\n        cv[i]=dp[i]/media[i];\\n    }  \\n}\\n\\nint main(int argc,char **argv){\\n    int lin,col,i,j,parallel_columns; // Define as variáveis de índices e dimensões\\n    double *matriz,*mediana,*media,*media_har,*moda,*variancia,*dp,*cv; // Define a matriz (forma linear), vetores de medidas estatísticas\\n\\n    fscanf(stdin, \\\"%d \\\", &lin); // Lê a quantidade de linhas da matriz\\n    fscanf(stdin, \\\"%d\\\\n\\\", &col); // Lê a quantidade de colunas da matriz\\n    parallel_columns = use_parallel_columns(lin, col);\\n    \\n    // Alocações\\n    matriz=(double *)malloc(lin*col * sizeof(double)); // Aloca a matriz\\n    media=(double *)malloc(col * sizeof(double)); // Aloca o vetor de media\\n    media_har=(double *)malloc(col * sizeof(double)); // Aloca o vetor de media harmônica\\n    mediana=(double *)malloc(col * sizeof(double)); // Aloca o vetor de mediana\\n    moda=(double *)malloc(col * sizeof(double)); // Aloca o vetor de moda\\n    variancia=(double *)malloc(col * sizeof(double)); // Aloca o vetor de variância\\n    cv=(double *)malloc(col * sizeof(double)); // Aloca o vetor de coeficiente de variação\\n    dp=(double *)malloc(col * sizeof(double)); // Aloca o vetor de desvio padrão\\n\\n \\n    for(i=0;i<lin;i++){\\n        for(j=0;j<col;j++){\\n            fscanf(stdin, \\\"%lf \\\",&(matriz[j*lin+i])); // Lê os dados transpostos em uma matriz de entrada\\n        }\\n    }\\n\\n    #pragma omp parallel num_threads(4) if(parallel_columns)\\n    {\\n        calcula_media(matriz,media,lin,col);\\n        calcula_media_harmonica(matriz,media_har,lin,col);\\n        ordena_colunas(matriz,lin,col);\\n        calcula_mediana(matriz,mediana,lin,col);\\n        calcula_moda(matriz,moda,lin,col);\\n        calcula_variancia(matriz,media,variancia,lin,col);\\n        calcula_desvio_padrao(variancia,dp,col);\\n        calcula_coeficiente_variacao(media,dp,cv,col);\\n    }\\n\\n    for(i=0;i<col;i++)\\n        printf(\\\"%.1lf \\\",media[i]); // Imprime as médias aritméticas de cada coluna\\n    printf(\\\"\\\\n\\\");\\n    for(i=0;i<col;i++)\\n        printf(\\\"%.1lf \\\",media_har[i]); // Imprime as médias harmônicas de cada coluna\\n    printf(\\\"\\\\n\\\");\\n    for(i=0;i<col;i++)\\n        printf(\\\"%.1lf \\\",mediana[i]); // Imprime as medianas de cada coluna\\n    printf(\\\"\\\\n\\\");\\n    for(i=0;i<col;i++)\\n        printf(\\\"%.1lf \\\",moda[i]); // Imprime as modas de cada coluna\\n    printf(\\\"\\\\n\\\");\\n    for(i=0;i<col;i++)\\n        printf(\\\"%.1lf \\\",variancia[i]); // Imprime as variâncias amostrais de cada coluna\\n    printf(\\\"\\\\n\\\");\\n    for(i=0;i<col;i++)\\n        printf(\\\"%.1lf \\\",dp[i]); // Imprime os desvios padrão de cada coluna\\n    printf(\\\"\\\\n\\\");\\n    for(i=0;i<col;i++)\\n        printf(\\\"%.1lf \\\",cv[i]); // Imprime os coeficientes de variação de cada coluna\\n    printf(\\\"\\\\n\\\");\\n\\n    // Desaloca memória\\n    free(matriz);\\n    free(media);\\n    free(media_har);\\n    free(mediana);\\n    free(moda);\\n    free(variancia);\\n    free(dp);\\n    free(cv);\\n}\\n\",\"path\":\"src/est_matriz_seq.c\"}],\"hypothesis\":\"A single conditional OpenMP team, capped at four threads and statically sharing independent columns, may improve sufficiently large matrices while keeping small workloads serial and preserving each column's calculation order.\",\"notes\":\"No integration sources were supplied. OpenMP speedup requires compile-time OpenMP support; no benchmark was run here. The mode counter is initialized before use to avoid an existing read of uninitialized memory.\",\"sources_kept\":[],\"transformations\":[\"Added one parallel region around the statistics pipeline and static worksharing for column loops; enabled the team only for at least four columns and a generic rows-squared-times-columns estimate of at least 262144.\",\"Kept each column's serial inner loops, arithmetic operations, and accumulation order intact; the parallel team is limited to four threads.\",\"Initialized each mode-count slot before incrementing it, making mode calculation deterministic.\"]}"}}

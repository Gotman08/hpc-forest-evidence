"""Seal a limited source review, not a qualification or native admission."""
import ast
import hashlib
import json
import xml.etree.ElementTree as ET
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
BASE = ROOT.parents[2]
PROJECT = BASE / "work/hpc-forest-mere-dynamique-r4b-lane-r2/project"


def ref(path):
    data = path.read_bytes()
    return {"path": str(path), "sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data)}


def main():
    out = HERE / "REVUE-SOURCE-LANE-R2.json"
    assert not out.exists()
    path = ROOT / "LIVRAISON-SOURCE-LANE-R2-NON-ADMISE.json"
    assert ref(path)["sha256"] == "1ddf05f71d6fca01cff7ebf30bf73797cec1d983b738367a366bd1ef64f251fb"
    delivery = json.loads(path.read_text(encoding="utf-8-sig"))
    for value in delivery["refs"].values():
        assert ref(Path(value["path"]))["sha256"] == value["sha256"]
    reviewed = []
    for name, digest in delivery["source_component_pins"].items():
        value = ref(PROJECT / name)
        assert value["sha256"] == digest
        ast.parse((PROJECT / name).read_text(encoding="utf-8-sig"))
        reviewed.append(value)
    suites = list(ET.parse(HERE / "tests-cibles.xml").getroot().iter("testsuite"))
    assert sum(int(s.get("tests", "0")) for s in suites) == 7
    assert all(int(s.get(k, "0")) == 0 for s in suites for k in ("failures", "errors", "skipped"))
    result = {
        "schema": "hpc-forest-r4b-lane-r2-independent-source-review-v1",
        "verified": True, "blocking_findings": [], "observed_utc": datetime.now(UTC).isoformat(),
        "decision": "GO préparation de qualification mécanique zéro modèle pour ces seuls octets; aucune qualification ni activation déjà acquise",
        "scope_id": delivery["scope_id"], "source_zip_sha256": delivery["source_zip_sha256"],
        "plan_sha256": delivery["plan_sha256"], "runtime_manifest_sha256": delivery["runtime_manifest_sha256"],
        "bundle_sha256": delivery["bundle_sha256"], "implementation_delivery": ref(path),
        "reviewed_files": reviewed, "design": delivery["refs"]["design"],
        "source_manifest": delivery["refs"]["source_manifest"], "diff": delivery["refs"]["diff"],
        "reviewed_guards": ["lane/projection v2 aux champs fermés et JSON projection sans doublons", "deux modes SO physiques1/0 et préservationtrue/false cohérentes", "compteurs int exacts et total0..3 avant travailleur souscap4", "même cellule, source/plan, heure et SHA du census dans les deux objets", "neuf digests locaux fermés, science6cd1/recon0ed5 épinglés et quatre preuves d'absence obligatoires seulement pour received_absent", "projection transportée résolue et rehashée via read_ref; aucun chemin Windows privé dans son contenu", "ARM ne prétend pas observer Windows et n'exporte pas census/config/credentials", "initialFalse réutilise l'historique de lancement mais ne vaut pas nouveau démarrage", "sourceZIP inventorié exact105, nouvelles Q/revue liées à source et plan, technical-only et neuf sessionsMAX"],
        "delegated_review": {
            "agent": "/root/review_compact_automation/review_lane_dynamic_admission_delta",
            "scope": "delta dynamic_admission, comparaisons AST,105/103 par copies/ZIP/manifeste/runtime, sessions et budgets du plan",
            "findings": [],
            "facts_verified": ["102anciens fichiers byte-identiques, un ancien admission modifié, deux ajouts seulement", "anciensZIP EDE/baseline/copie identiques103", "nouveauZIP/copie/source-manifest/runtime identiques105", "autres fonctions admission AST-identiques", "algorithmes/oracles/contrôleurs/budgets intacts", "anciens Q non qualifiants pour ces SHA, pilotes/extensions/Luna actifs fermés"]
        },
        "tests_actually_executed": {"selected_neutral_passed": 7, "deselected": 19,
            "selection": "two_truthful_modes or missing_or_tampered_reference or runtime_retains_historical or derived_runtime_refuses_original_zip",
            "scope": "quatre modes/comptages, projection locale rehashée/tamper/doublons, historique initialFalse sans nouveau démarrage, directimport admission et refus ancienZIP",
            "conftest_disabled": True, "junit": ref(HERE / "tests-cibles.xml"), "stdout": ref(HERE / "tests-cibles.log")},
        "old26_suite_rerun": False,
        "qualification_allouee_received": False, "old_Q752235_or752369_reused": False,
        "actual_Windows_or_ARM_graph_observed": False,
        "native_generation_admitted": False, "first_NORMAL_candidate_or_evaluation_verified": False,
        "activation_admitted": False,
        "limitations": ["La validation ARM porte sur cohérence/octets et digests transportés; elle ne prouve pas les faits du census Windows ou les pièces privées. Le producteur local qualifié doit établir et lier réellement ces preuves.", "Les références POSIX de la projection sont structurellement compatibles avec read_ref, mais aucune exécution ARM64 de cette nouvelle source n'est revendiquée; une nouvelle qualification allouée reste requise.", "Les nouveaux raccords factory/observateur/lecteur et l'absence SO/transitionOBS3 doivent recevoir leurs vraies preuves; aucune absence actuelle n'a été observée ici."],
        "model_CLI_RPC_job_CIM_live_cache_lock_transition_C_candidate_calls": 0,
        "other_agent_or_production_files_modified": False,
    }
    out.write_text(json.dumps(result, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(ref(out)))


if __name__ == "__main__":
    main()

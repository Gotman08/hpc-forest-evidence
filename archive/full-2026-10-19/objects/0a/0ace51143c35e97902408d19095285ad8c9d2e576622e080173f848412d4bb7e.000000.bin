     return state, cell
 
 
+def windows_argv(command):
+    """Use Windows' actual argv grammar; never invoke a shell or process."""
+    require(isinstance(command, str) and bool(command) and not command[0].isspace()
+            and not any(c in command for c in ("\x00", "\r", "\n")),
+            "Missing or malformed Windows command line")
+    import ctypes
+    from ctypes import wintypes
+
+    shell = ctypes.WinDLL("shell32", use_last_error=True)
+    parse = shell.CommandLineToArgvW
+    parse.argtypes = [wintypes.LPCWSTR, ctypes.POINTER(ctypes.c_int)]
+    parse.restype = ctypes.POINTER(wintypes.LPWSTR)
+    kernel = ctypes.WinDLL("kernel32", use_last_error=True)
+    free = kernel.LocalFree
+    free.argtypes = [ctypes.c_void_p]
+    free.restype = ctypes.c_void_p
+    count = ctypes.c_int()
+    pointer = parse(command, ctypes.byref(count))
+    require(bool(pointer), "Windows CommandLineToArgvW refused command")
+    try:
+        argv = [pointer[i] for i in range(count.value)]
+    finally:
+        free(ctypes.cast(pointer, ctypes.c_void_p))
+    require(bool(argv) and bool(argv[0]), "Missing Windows executable argv")
+    return argv
+
+
 def flag(command, name):
-    pattern = r"(?:^|\s)" + re.escape(name) + r"\s+(?:\"([^\"]+)\"|'([^']+)'|([^\s]+))(?=\s|$)"
-    values = re.findall(pattern, command)
-    require(len(values) == 1, "Missing/duplicate exact worker flag: " + name)
-    return next(x for x in values[0] if x)
+    argv = windows_argv(command) if isinstance(command, str) else command
+    require(isinstance(argv, (list, tuple)) and all(isinstance(x, str) for x in argv),
+            "Actual parsed Windows argv required")
+    positions = [i for i, value in enumerate(argv) if value == name]
+    require(len(positions) == 1 and not any(value.startswith(name + "=") for value in argv),
+            "Missing/duplicate exact worker flag: " + name)
+    index = positions[0]
+    require(index + 1 < len(argv) and bool(argv[index + 1])
+            and not argv[index + 1].startswith("-"), "Missing exact worker flag value: " + name)
+    return argv[index + 1]
+
+
+def python_module(argv):
+    module = flag(argv, "-m")
+    index = argv.index("-m")
+    prefix = argv[1:index]
+    require(all(value in {"-B", "-u"} for value in prefix) and len(prefix) == len(set(prefix)),
+            "Python worker module must precede its exact arguments")
+    return module
 
 

#include <iostream>
#include <vector>
#include <cstdio>
#include <climits>
#include <algorithm>
#ifdef __ARM_NEON
#include <arm_neon.h>
#endif

static int read_int() {
    static char buf[1 << 20];
    static size_t pos = 0, len = 0;
    while (pos >= len) {
        len = fread(buf, 1, sizeof(buf), stdin);
        if (!len) return 0;
        pos = 0;
    }
    while (buf[pos] < '0' && buf[pos] != '-') {
        ++pos;
        if (pos >= len) {
            len = fread(buf, 1, sizeof(buf), stdin);
            if (!len) return 0;
            pos = 0;
        }
    }
    bool neg = false;
    if (buf[pos] == '-') { neg = true; ++pos; }
    int x = 0;
    while (true) {
        if (pos >= len) {
            size_t nread = fread(buf, 1, sizeof(buf), stdin);
            if (!nread) break;
            pos = 0;
            len = nread;
        }
        char c = buf[pos];
        if (c < '0' || c > '9') break;
        x = x * 10 + (c - '0');
        ++pos;
    }
    return neg ? -x : x;
}

int main() {
    int n = read_int();
    int s = read_int();

    const int stride = n + 1;
    std::vector<long long> pref(stride * stride);
    long long * __restrict__ p = pref.data();

    for (int i = 0; i < n; ++i) {
        long long row_sum = 0;
        int base_cur = (i + 1) * stride;
        int base_prev = i * stride;
        #pragma ivdep
        for (int j = 0; j < n; ++j) {
            int val = read_int();
            row_sum += val;
            p[base_cur + j + 1] = p[base_prev + j + 1] + row_sum;
        }
    }

    long long mxSum = LLONG_MIN;
    const int limit_i = n - s + 1;
    const int limit_j = n - s + 1;

    #pragma omp parallel for reduction(max:mxSum) schedule(static)
    for (int i = 0; i < limit_i; ++i) {
        long long * __restrict__ row_is = p + (i + s) * stride;
        long long * __restrict__ row_i   = p + i * stride;

#ifdef __ARM_NEON
        int j = 0;
        for (; j + 1 < limit_j; j += 2) {
            const int64x2_t v_a = vld1q_s64((const int64_t *)&row_is[j + s]);
            const int64x2_t v_b = vld1q_s64((const int64_t *)&row_i[j + s]);
            const int64x2_t v_c = vld1q_s64((const int64_t *)&row_is[j]);
            const int64x2_t v_d = vld1q_s64((const int64_t *)&row_i[j]);

            int64x2_t sum = vsubq_s64(v_a, v_b);
            sum = vsubq_s64(sum, v_c);
            sum = vaddq_s64(sum, v_d);

            const long long s0 = vgetq_lane_s64(sum, 0);
            const long long s1 = vgetq_lane_s64(sum, 1);
            if (s0 > mxSum) mxSum = s0;
            if (s1 > mxSum) mxSum = s1;
        }
        for (; j < limit_j; ++j) {
#else
        #pragma ivdep
        for (int j = 0; j < limit_j; ++j) {
#endif
            long long sum_val = row_is[j + s] - row_i[j + s] - row_is[j] + row_i[j];
            if (sum_val > mxSum) mxSum = sum_val;
        }
    }

    printf("%lld\n", mxSum);
    return 0;
}

"""Read-only, independent arithmetic audit for the professional manuscript.

Never executes, imports or edits experimental code or candidates. SQLite is
opened immutable/read-only. All exports are analysis data, never model input.
"""

import csv
import hashlib
import json
import math
import sqlite3
import statistics as st
from collections import Counter
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
STUDY = HERE.parent
OUT = STUDY.parent
WORKSPACE = OUT.parent
EVIDENCE = HERE / "donnees"
EVIDENCE.mkdir(exist_ok=True)
SOURCES = {}
CHECKS = Counter()


def sha(p):
    return hashlib.file_digest(p.open("rb"), "sha256").hexdigest()


def record(p):
    p = Path(p).resolve()
    SOURCES[str(p)] = {"sha256": sha(p), "bytes": p.stat().st_size}
    return p


def read(p):
    return json.loads(record(p).read_text(encoding="utf-8-sig"))


def close(a, b, label):
    assert math.isclose(a, b, rel_tol=2e-10, abs_tol=2e-12), (label, a, b)
    CHECKS[label] += 1


def save(name, data):
    (EVIDENCE / name).write_text(
        json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
    )


def table(name, rows):
    if not rows:
        return
    with (EVIDENCE / name).open("w", encoding="utf-8-sig", newline="") as f:
        w = csv.DictWriter(f, fieldnames=list(rows[0]))
        w.writeheader()
        w.writerows(rows)


def registry(campaign_root):
    root = Path(campaign_root)
    candidates = (
        [root / "registry.sqlite3"]
        if (root / "registry.sqlite3").exists()
        else list(root.glob("preuves/**/registry.sqlite3"))
    )
    assert len(candidates) == 1, (root, candidates)
    db = record(candidates[0])
    before = sha(db)
    con = sqlite3.connect(db.as_uri() + "?mode=ro&immutable=1", uri=True)
    meta = {k: json.loads(v) for k, v in con.execute("select key,value from metadata")}
    best = meta.get("best_confirmed")
    assert best is not None, str(db)
    evaluations = [
        {"id": i, "epoch": ep, "phase": ph, **json.loads(v)}
        for i, ep, ph, v in con.execute(
            "select experiment_id,epoch,phase,payload from evaluations order by id"
        )
    ]
    confirmations = [
        e
        for e in evaluations
        if e["phase"] == "confirmation" and e["epoch"] == best["epoch"]
    ]
    valid = [
        e for e in confirmations if e.get("correct") and e.get("status") == "valid"
    ]
    baseline = next(e for e in valid if e["id"] == f"baseline-e{best['epoch']}")
    chosen = next(e for e in valid if e["id"] == best["experiment_id"])
    for e in evaluations:
        if e.get("correct") and e.get("times"):
            close(st.mean(e["times"]), e["mean_seconds"], "original_evaluation_means")
    for e in confirmations:
        if e.get("correct") and e.get("status") == "valid":
            assert len(e["times"]) == 5, (str(db), e["id"], len(e["times"]))
            CHECKS["five_confirmation_samples"] += 1
        elif e.get("status") == "incorrect":
            assert (
                not e.get("times") and not e.get("mean_seconds") and e.get("score") == 0
            ), e
            CHECKS["protected_confirmation_rejections"] += 1
    close(best["mean_seconds"], st.mean(chosen["times"]), "chosen_confirmation_means")
    close(
        best["reference_seconds"],
        st.mean(baseline["times"]),
        "reference_confirmation_means",
    )
    gain = 1 - st.mean(chosen["times"]) / st.mean(baseline["times"])
    close(gain, best["improvement_fraction"], "confirmed_gain_fractions")
    # A valid selected candidate must satisfy the confirmed 3% margin; keeping
    # the reference is valid even if another admissible finalist is marginally faster.
    if not best.get("is_baseline"):
        assert gain >= 0.03 - 1e-12
        assert chosen["mean_seconds"] <= min(e["mean_seconds"] for e in valid) + 1e-12
    CHECKS["admissible_winner"] += 1
    trials = []
    for i, role, state, mission, result in con.execute(
        "select id,role,state,mission,result from trials order by created"
    ):
        trials.append(
            {
                "id": i,
                "role": role,
                "state": state,
                "mission": json.loads(mission),
                "result": json.loads(result) if result else None,
            }
        )
    tree_roots = [
        {"id": i, "role": role, "checkpoint_sha256": h, "treequest_version": version}
        for i, role, h, version in con.execute(
            "select id,role,sha256,version from trees order by id"
        )
    ]
    by_id = {t["id"]: t for t in trials}
    for t in trials:
        m = t["mission"]
        parent = m.get("parent_id")
        if parent:
            assert parent in by_id
            previous = by_id[parent]
            assert previous["mission"]["tree_id"] == m["tree_id"]
            assert previous["mission"]["depth"] + 1 == m["depth"]
            assert (previous["result"] or {}).get("commit") == m["base_commit"]
            CHECKS["true_parent_program_links"] += 1
        sources = m.get("sources", [])
        source_commits = m.get("source_commits", [])
        assert len(sources) == len(source_commits)
        for source, commit in zip(sources, source_commits, strict=True):
            assert source in by_id and source != t["id"]
            assert by_id[source]["result"]["correct"]
            assert by_id[source]["result"]["commit"] == commit
            CHECKS["true_integration_source_links"] += 1
    contract_path = db.parent / "trusted/contract.json"
    if not contract_path.exists():
        contract_path = db.parent / "repo/contract.json"
    contract = read(contract_path) if contract_path.exists() else None
    con.close()
    assert sha(db) == before, str(db)
    return {
        "campaign_root": str(db.parent),
        "registry_sha256": before,
        "best_confirmed": best,
        "reference_samples": baseline["times"],
        "chosen_samples": chosen["times"],
        "reference_stdev": st.stdev(baseline["times"]),
        "chosen_stdev": st.stdev(chosen["times"]),
        "gain_fraction": gain,
        "speedup": best["reference_seconds"] / best["mean_seconds"],
        "confirmations": confirmations,
        "trials": trials,
        "tree_roots": tree_roots,
        "contract": contract,
        "config": meta.get("config"),
        "identity": meta.get("identity"),
        "mother_plans": {k: v for k, v in meta.items() if k.startswith("mother_plan:")},
    }


def terra_accounting(cohort, admissions):
    """Attribute the closed receipt by subject/role without reclassifying unknowns."""
    folder = STUDY / "receptions/coverage-terra-max-748782"
    receipt_path = record(folder / "reception-verifiee.json")
    reviewed = next(c for c in admissions["reviewed_new_cohorts"] if c["cohort"] == "terra_max_fourteen_subjects")
    assert sha(receipt_path) == reviewed["independent_reception_sha256"]
    receipt = read(receipt_path)
    assert receipt["verified"] and receipt["job_id"] == "748782" and receipt["subjects_received"] == 14
    for key in ("audit", "reconciliation"):
        assert sha(record(receipt[key]["path"])) == receipt[key]["sha256"]
    reconciliation = read(folder / "reconciliation-livraisons.json")
    assert reconciliation["all_published_requests_accounted_for"]
    assert not reconciliation["total_exact_consumption_available"]
    roots = {r["subject"]: Path(r["campaign_root"]) for r in cohort["rows"]}
    trial_roles = {}
    for subject, root in roots.items():
        db = record(root / "registry.sqlite3")
        con = sqlite3.connect(db.as_uri() + "?mode=ro&immutable=1", uri=True)
        trial_roles[subject] = dict(con.execute("select id,role from trials"))
        con.close()
    totals = {s: {"native_calls": 0, "known_exact_tokens": 0, "unmetered_calls": 0,
                  "expired_unanswered_requests": 0} for s in roots}
    calls, seen = [], set()
    for item in reconciliation["records"]:
        key = (item["session_id"], item["nonce"])
        assert key not in seen
        seen.add(key)
        references = [Path(p) for p in item["request_references"]]
        assert references and all(".." not in p.parts and not p.is_absolute() for p in references)
        subject = references[0].parts[0]
        assert subject in roots and all(p.parts[0] == subject for p in references)
        requests = [read(roots[subject].parent / p) for p in references]
        request = requests[0]
        assert all(r == request for r in requests)
        assert (request["session_id"], request["nonce"]) == key
        assert request["model"] == "gpt-5.6-terra" and request["reasoning_effort"] == "max"
        if request.get("meta_role"):
            assert request["meta_role"] in ("mother-preparation", "mother-synthesis")
            role = "mère"
        else:
            trial = request["mission_id"].rsplit("-h", 1)[0]
            tree_role = trial_roles[subject][trial]
            assert tree_role in ("A", "B", "C", "G")
            role = "intégration" if tree_role == "G" else "enfant"
        native = bool(item["native_invocation_observed"])
        unknown = native and not item["usage_measured"]
        exact = item["known_exact_tokens"]
        assert isinstance(exact, int) and exact >= 0
        assert item["usage_measured"] or exact == 0
        total = totals[subject]
        total["native_calls"] += int(native)
        total["known_exact_tokens"] += exact
        total["unmetered_calls"] += int(unknown)
        total["expired_unanswered_requests"] += int(not item["delivery_verified"])
        calls.append({"session_id": key[0], "nonce": key[1], "subject": subject,
                      "campaign": "grille-r1/coverage-gpt-5.6-terra-max", "kind": role,
                      "native_invocation_observed": native, "usage_measured": item["usage_measured"],
                      "exact_total": exact if item["usage_measured"] else None,
                      "state": "exact" if item["usage_measured"] else "unmetered" if native else "expired_unanswered",
                      "request_sha256": item["request_sha256"], "status": item["status"]})
    for field, expected in (("native_calls", 58), ("known_exact_tokens", 980971),
                            ("unmetered_calls", 24), ("expired_unanswered_requests", 1)):
        assert sum(t[field] for t in totals.values()) == expected, field
    assert len(calls) == reconciliation["published_requests"] == 63
    save("couts-terra.json", {"job_id": "748782", "receipt_sha256": sha(receipt_path),
                             "reconciliation_sha256": sha(folder / "reconciliation-livraisons.json"),
                             "per_subject": totals, "native_calls": calls,
                             "total_exact_consumption_available": False})
    return totals


def sol_accounting(cohort, admissions):
    """Attribute the closed receipt by subject/role without reclassifying unknowns."""
    folder = STUDY / "receptions/coverage-sol-max-749415"

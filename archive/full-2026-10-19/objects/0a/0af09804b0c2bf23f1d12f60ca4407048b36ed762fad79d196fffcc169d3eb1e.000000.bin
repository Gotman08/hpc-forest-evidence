        "content": "#include <cstdio>\n#include <cstddef>\n#include <limits>\n#include <vector>\n\nclass FastInput {\n    static constexpr std::size_t BufferSize = 1u << 16;\n    unsigned char buffer[BufferSize];\n    std::size_t position = 0;\n    std::size_t available = 0;\n\n    int get() {\n        if (position == available) {\n            available = std::fread(buffer, 1, BufferSize, stdin);\n            position = 0;\n            if (available == 0) return EOF;\n        }\n        return buffer[position++];\n    }\n\npublic:\n    bool nextInt(int &result) {\n        int c;\n        do {\n            c = get();\n            if (c == EOF) return false;\n        } while (c <= ' ');\n\n        bool negative = false;\n        if (c == '-' || c == '+') {\n            negative = c == '-';\n            c = get();\n        }\n\n        long long value = 0;\n        while (c >= '0' && c <= '9') {\n            value = value * 10 + (c - '0');\n            c = get();\n        }\n        result = static_cast<int>(negative ? -value : value);\n        return true;\n    }\n};\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.nextInt(n) || !input.nextInt(s)) return 0;\n\n    const std::size_t width = static_cast<std::size_t>(n);\n    std::vector<int> rows(static_cast<std::size_t>(s) * width);\n    std::vector<long long> columnSums(width, 0);\n    long long maximum = std::numeric_limits<long long>::lowest();\n\n    for (int row = 0; row < n; ++row) {\n        const std::size_t rowBase = static_cast<std::size_t>(row % s) * width;\n        const bool fullHeight = row >= s;\n\n        for (int column = 0; column < n; ++column) {\n            int value = 0;\n            input.nextInt(value);\n            const std::size_t index = rowBase + static_cast<std::size_t>(column);\n            if (fullHeight) columnSums[column] -= rows[index];\n            rows[index] = value;\n            columnSums[column] += value;\n        }\n\n        if (row + 1 < s) continue;\n\n        long long windowSum = 0;\n        for (int column = 0; column < s; ++column) {\n            windowSum += columnSums[column];\n        }\n        if (windowSum > maximum) maximum = windowSum;\n\n        for (int column = s; column < n; ++column) {\n            windowSum += columnSums[column] - columnSums[column - s];\n            if (windowSum > maximum) maximum = windowSum;\n        }\n    }\n\n    std::printf(\"%lld\\n\", maximum);\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }

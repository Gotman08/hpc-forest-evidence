{
  "src/nbody.c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdint.h>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\nenum { PAIR_TILE = 32, PARALLEL_THRESHOLD = 256 };\n\n#if defined(__GNUC__) && !defined(__clang__)\n#define NO_MATH_ERRNO __attribute__((optimize(\"no-math-errno\")))\n#else\n#define NO_MATH_ERRNO\n#endif\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\ntypedef struct {\n  float *storage;\n  float *cache;\n  float *x, *y, *z;\n  float *fx, *fy, *fz;\n  int ntiles;\n} Workspace;\n\n/* Original arithmetic for small systems and fallback paths. */\nNO_MATH_ERRNO\nstatic void body_force_scalar(Body *p, float dt, int n, int i) {\n  float fx = 0.0f;\n  float fy = 0.0f;\n  float fz = 0.0f;\n\n  for (int j = 0; j < n; j++) {\n    float dx = p[j].x - p[i].x;\n    float dy = p[j].y - p[i].y;\n    float dz = p[j].z - p[i].z;\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n    fx += dx * inv_dist3;\n    fy += dy * inv_dist3;\n    fz += dz * inv_dist3;\n  }\n\n  p[i].vx += dt*fx;\n  p[i].vy += dt*fy;\n  p[i].vz += dt*fz;\n}\n\nstatic void workspace_init(Workspace *w, int n) {\n  const int ntiles = n / PAIR_TILE + (n % PAIR_TILE != 0);\n  if ((size_t)n > SIZE_MAX / (6 * sizeof(float)) ||\n      (size_t)ntiles > SIZE_MAX / (PAIR_TILE * PAIR_TILE * sizeof(float))) {\n    return;\n  }\n\n  w->storage = (float *)malloc((size_t)n * 6 * sizeof(float));\n  w->cache = (float *)malloc((size_t)ntiles * PAIR_TILE * PAIR_TILE * sizeof(float));\n  if (w->storage == NULL || w->cache == NULL) {\n    free(w->cache);\n    free(w->storage);\n    w->cache = NULL;\n    w->storage = NULL;\n    return;\n  }\n\n  w->x = w->storage;\n  w->y = w->storage + (size_t)n;\n  w->z = w->storage + 2 * (size_t)n;\n  w->fx = w->storage + 3 * (size_t)n;\n  w->fy = w->storage + 4 * (size_t)n;\n  w->fz = w->storage + 5 * (size_t)n;\n  w->ntiles = ntiles;\n}\n\n#if defined(__aarch64__)\ntypedef struct { float32x4_t x, y, z; } Force4;\n\nstatic inline __attribute__((always_inline))\nfloat32x4_t reference_inverse_distance(float32x4_t d) {\n  float64x2_t lo = vcvt_f64_f32(vget_low_f32(d));\n  float64x2_t hi = vcvt_f64_f32(vget_high_f32(d));\n  const float64x2_t one = vdupq_n_f64(1.0);\n  lo = vdivq_f64(one, vsqrtq_f64(lo));\n  hi = vdivq_f64(one, vsqrtq_f64(hi));\n  return vcombine_f32(vcvt_f32_f64(lo), vcvt_f32_f64(hi));\n}\n\nstatic inline __attribute__((always_inline))\nfloat32x4_t certified_inverse_distance(float32x4_t d) {\n  float32x4_t estimate = vrsqrteq_f32(d);\n  estimate = vmulq_f32(estimate,\n      vrsqrtsq_f32(vmulq_f32(d, estimate), estimate));\n  estimate = vmulq_f32(estimate,\n      vrsqrtsq_f32(vmulq_f32(d, estimate), estimate));\n\n  const float64x2_t xlo = vcvt_f64_f32(vget_low_f32(d));\n  const float64x2_t xhi = vcvt_f64_f32(vget_high_f32(d));\n  float64x2_t ylo = vcvt_f64_f32(vget_low_f32(estimate));\n  float64x2_t yhi = vcvt_f64_f32(vget_high_f32(estimate));\n  ylo = vmulq_f64(ylo,\n      vrsqrtsq_f64(vmulq_f64(xlo, ylo), ylo));\n  yhi = vmulq_f64(yhi,\n      vrsqrtsq_f64(vmulq_f64(xhi, yhi), yhi));\n\n  /* Certify the residual and exclude float-rounding midpoint windows. */\n  const float64x2_t one = vdupq_n_f64(1.0);\n  const float64x2_t zero = vdupq_n_f64(0.0);\n  const float64x2_t bound = vdupq_n_f64(0x1p-40);\n  float64x2_t rlo = vfmsq_f64(one, vmulq_f64(xlo, ylo), ylo);\n  float64x2_t rhi = vfmsq_f64(one, vmulq_f64(xhi, yhi), yhi);\n  uint64x2_t safe_lo = vandq_u64(\n      vcltq_f64(vabsq_f64(rlo), bound), vcgtq_f64(ylo, zero));\n  uint64x2_t safe_hi = vandq_u64(\n      vcltq_f64(vabsq_f64(rhi), bound), vcgtq_f64(yhi, zero));\n\n  const uint64x2_t tail_mask = vdupq_n_u64(UINT64_C(0x1fffffff));\n  const uint64x2_t lower = vdupq_n_u64(UINT64_C(0x0fff0000));\n  const uint64x2_t width = vdupq_n_u64(UINT64_C(0x00020000));\n  uint64x2_t offset_lo = vsubq_u64(\n      vandq_u64(vreinterpretq_u64_f64(ylo), tail_mask), lower);\n  uint64x2_t offset_hi = vsubq_u64(\n      vandq_u64(vreinterpretq_u64_f64(yhi), tail_mask), lower);\n  safe_lo = vandq_u64(safe_lo, vcgtq_u64(offset_lo, width));\n  safe_hi = vandq_u64(safe_hi, vcgtq_u64(offset_hi, width));\n\n  uint32x4_t safe = vreinterpretq_u32_u64(vandq_u64(safe_lo, safe_hi));\n  if (__builtin_expect(vminvq_u32(safe) != UINT32_MAX, 0)) {\n    return reference_inverse_distance(d);\n  }\n  return vcombine_f32(vcvt_f32_f64(ylo), vcvt_f32_f64(yhi));\n}\n\n/* Lanes are independent targets, never a reduction over sources. */\nstatic inline __attribute__((always_inline))\nfloat32x4_t accumulate_computed_four(\n    float32x4_t tx, float32x4_t ty, float32x4_t tz,\n    float sx, float sy, float sz, Force4 *f) {\n  float32x4_t dx = vdupq_n_f32(sx) - tx;\n  float32x4_t dy = vdupq_n_f32(sy) - ty;\n  float32x4_t dz = vdupq_n_f32(sz) - tz;\n  float32x4_t sqrd_dist = dx*dx + dy*dy + dz*dz + vdupq_n_f32(SOFTENING);\n  float32x4_t inv_dist = certified_inverse_distance(sqrd_dist);\n  float32x4_t inv_dist3 = inv_dist * inv_dist * inv_dist;\n  f->x += dx * inv_dist3;\n  f->y += dy * inv_dist3;\n  f->z += dz * inv_dist3;\n  return inv_dist3;\n}\n\nstatic inline __attribute__((always_inline))\nvoid accumulate_cached_four(\n    float32x4_t tx, float32x4_t ty, float32x4_t tz,\n    float sx, float sy, float sz, float32x4_t inv_dist3, Force4 *f) {\n  /* Recompute reverse displacements, including their zero signs. */\n  float32x4_t dx = vdupq_n_f32(sx) - tx;\n  float32x4_t dy = vdupq_n_f32(sy) - ty;\n  float32x4_t dz = vdupq_n_f32(sz) - tz;\n  f->x += dx * inv_dist3;\n  f->y += dy * inv_dist3;\n  f->z += dz * inv_dist3;\n}\n\nstatic void complete_four_rows(\n    const Workspace *w, int band, int begin, int end, int first, int n) {\n  const float * restrict x = w->x;\n  const float * restrict y = w->y;\n  const float * restrict z = w->z;\n  float * restrict fx = w->fx;\n  float * restrict fy = w->fy;\n  float * restrict fz = w->fz;\n  const float32x4_t tx = vld1q_f32(x + first);\n  const float32x4_t ty = vld1q_f32(y + first);\n  const float32x4_t tz = vld1q_f32(z + first);\n  Force4 f = {vld1q_f32(fx + first), vld1q_f32(fy + first), vld1q_f32(fz + first)};\n\n  /* The diagonal remains directed and includes every self interaction. */\n  for (int j = begin; j < end; ++j) {\n    accumulate_computed_four(tx, ty, tz, x[j], y[j], z[j], &f);\n  }\n\n  for (int tile = band + 1; tile < w->ntiles; ++tile) {\n    const int source_begin = tile * PAIR_TILE;\n    const int source_end = n - source_begin < PAIR_TILE ? n : source_begin + PAIR_TILE;\n    const float *row0 = w->cache + (size_t)tile * PAIR_TILE * PAIR_TILE\n                      + (size_t)(first - begin) * PAIR_TILE;\n    const float *row1 = row0 + PAIR_TILE;\n    const float *row2 = row1 + PAIR_TILE;\n    const float *row3 = row2 + PAIR_TILE;\n    int j = source_begin;\n\n    for (; source_end - j >= 4; j += 4) {\n      const int k = j - source_begin;\n      const float32x4_t r0 = vld1q_f32(row0 + k);\n      const float32x4_t r1 = vld1q_f32(row1 + k);\n      const float32x4_t r2 = vld1q_f32(row2 + k);\n      const float32x4_t r3 = vld1q_f32(row3 + k);\n      const float32x4_t t0 = vtrn1q_f32(r0, r1);\n      const float32x4_t t1 = vtrn2q_f32(r0, r1);\n      const float32x4_t t2 = vtrn1q_f32(r2, r3);\n      const float32x4_t t3 = vtrn2q_f32(r2, r3);\n      const float32x4_t c0 = vcombine_f32(vget_low_f32(t0), vget_low_f32(t2));\n      const float32x4_t c1 = vcombine_f32(vget_low_f32(t1), vget_low_f32(t3));\n      const float32x4_t c2 = vcombine_f32(vget_high_f32(t0), vget_high_f32(t2));\n      const float32x4_t c3 = vcombine_f32(vget_high_f32(t1), vget_high_f32(t3));\n\n      accumulate_cached_four(tx, ty, tz, x[j], y[j], z[j], c0, &f);\n      accumulate_cached_four(tx, ty, tz, x[j + 1], y[j + 1], z[j + 1], c1, &f);\n      accumulate_cached_four(tx, ty, tz, x[j + 2], y[j + 2], z[j + 2], c2, &f);\n      accumulate_cached_four(tx, ty, tz, x[j + 3], y[j + 3], z[j + 3], c3, &f);\n    }\n\n    for (; j < source_end; ++j) {\n      const int k = j - source_begin;\n      const float32x4_t inv_dist3 = {row0[k], row1[k], row2[k], row3[k]};\n      accumulate_cached_four(tx, ty, tz, x[j], y[j], z[j], inv_dist3, &f);\n    }\n  }\n\n  vst1q_f32(fx + first, f.x);\n  vst1q_f32(fy + first, f.y);\n  vst1q_f32(fz + first, f.z);\n}\n#endif\n\n/* Produce one off-diagonal tile and advance its later rows by one band. */\nNO_MATH_ERRNO\nstatic void produce_pair_tile(\n    const Workspace *w, int begin, int end,\n    int target_begin, int target_end, float * restrict tile_cache) {\n  const float * restrict x = w->x;\n  const float * restrict y = w->y;\n  const float * restrict z = w->z;\n  float * restrict fx = w->fx;\n  float * restrict fy = w->fy;\n  float * restrict fz = w->fz;\n  int j = target_begin;\n\n#if defined(__aarch64__)\n  for (; target_end - j >= 4; j += 4) {\n    const float32x4_t tx = vld1q_f32(x + j);\n    const float32x4_t ty = vld1q_f32(y + j);\n    const float32x4_t tz = vld1q_f32(z + j);\n    Force4 f = {vld1q_f32(fx + j), vld1q_f32(fy + j), vld1q_f32(fz + j)};\n\n    for (int i = begin; i < end; ++i) {\n      float32x4_t inv_dist3 = accumulate_computed_four(\n          tx, ty, tz, x[i], y[i], z[i], &f);\n      vst1q_f32(tile_cache + (size_t)(i - begin) * PAIR_TILE\n                + (j - target_begin), inv_dist3);\n    }\n\n    vst1q_f32(fx + j, f.x);\n    vst1q_f32(fy + j, f.y);\n    vst1q_f32(fz + j, f.z);\n  }\n#endif\n\n  for (; j < target_end; ++j) {\n    const float tx = x[j];\n    const float ty = y[j];\n    const float tz = z[j];\n    float ax = fx[j];\n    float ay = fy[j];\n    float az = fz[j];\n\n    for (int i = begin; i < end; ++i) {\n      float dx = x[i] - tx;\n      float dy = y[i] - ty;\n      float dz = z[i] - tz;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n      ax += dx * inv_dist3;\n      ay += dy * inv_dist3;\n      az += dz * inv_dist3;\n      tile_cache[(size_t)(i - begin) * PAIR_TILE + (j - target_begin)] = inv_dist3;\n    }\n\n    fx[j] = ax;\n    fy[j] = ay;\n    fz[j] = az;\n  }\n}\n\nNO_MATH_ERRNO\nstatic void complete_scalar_row(\n    const Workspace *w, int band, int begin, int end, int first, int n) {\n  const float * restrict x = w->x;\n  const float * restrict y = w->y;\n  const float * restrict z = w->z;\n  const float tx = x[first];\n  const float ty = y[first];\n  const float tz = z[first];\n  float ax = w->fx[first];\n  float ay = w->fy[first];\n  float az = w->fz[first];\n\n  for (int j = begin; j < end; ++j) {\n    float dx = x[j] - tx;\n    float dy = y[j] - ty;\n    float dz = z[j] - tz;\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n    ax += dx * inv_dist3;\n    ay += dy * inv_dist3;\n    az += dz * inv_dist3;\n  }\n\n  for (int tile = band + 1; tile < w->ntiles; ++tile) {\n    const int source_begin = tile * PAIR_TILE;\n    const int source_end = n - source_begin < PAIR_TILE ? n : source_begin + PAIR_TILE;\n    const float *row = w->cache + (size_t)tile * PAIR_TILE * PAIR_TILE\n                     + (size_t)(first - begin) * PAIR_TILE;\n    for (int j = source_begin; j < source_end; ++j) {\n      float dx = x[j] - tx;\n      float dy = y[j] - ty;\n      float dz = z[j] - tz;\n      float inv_dist3 = row[j - source_begin];\n      ax += dx * inv_dist3;\n      ay += dy * inv_dist3;\n      az += dz * inv_dist3;\n    }\n  }\n\n  w->fx[first] = ax;\n  w->fy[first] = ay;\n  w->fz[first] = az;\n}\n\nstatic void simulate_steps(Body *p, float dt, int n, int steps, int update_positions) {\n  if (n <= 0 || steps <= 0) {\n    return;\n  }\n\n  Workspace w = {0};\n  if (n >= PARALLEL_THRESHOLD) {\n    workspace_init(&w, n);\n  }\n  int nonfinite = 0;\n\n  /* One team owns all steps; implicit barriers separate dependent phases. */\n  #pragma omp parallel if (n >= PARALLEL_THRESHOLD)\n  {\n    for (int iter = 0; iter < steps; ++iter) {\n      if (w.storage == NULL) {\n        #pragma omp for schedule(static)\n        for (int i = 0; i < n; ++i) {\n          body_force_scalar(p, dt, n, i);\n        }\n      } else {\n        #pragma omp single\n        {\n          nonfinite = 0;\n        }\n\n        #pragma omp for schedule(static) reduction(|:nonfinite)\n        for (int i = 0; i < n; ++i) {\n          w.x[i] = p[i].x;\n          w.y[i] = p[i].y;\n          w.z[i] = p[i].z;\n          w.fx[i] = 0.0f;\n          w.fy[i] = 0.0f;\n          w.fz[i] = 0.0f;\n          if (!isfinite(w.x[i]) || !isfinite(w.y[i]) || !isfinite(w.z[i])) {\n            nonfinite |= 1;\n          }\n        }\n\n        if (nonfinite) {\n          #pragma omp for schedule(static)\n          for (int i = 0; i < n; ++i) {\n            body_force_scalar(p, dt, n, i);\n          }\n        } else {\n          /*\n           * Earlier bands have already contributed an ordered prefix to\n           * each row. Produce the next prefix for later rows, then finish\n           * this band's rows using the cached opposite interactions.\n           */\n          for (int band = 0; band < w.ntiles; ++band) {\n            const int begin = band * PAIR_TILE;\n            const int end = n - begin < PAIR_TILE ? n : begin + PAIR_TILE;\n\n            #pragma omp for schedule(static)\n            for (int tile = band + 1; tile < w.ntiles; ++tile) {\n              const int target_begin = tile * PAIR_TILE;\n              const int target_end = n - target_begin < PAIR_TILE\n                                   ? n : target_begin + PAIR_TILE;\n              float *tile_cache = w.cache + (size_t)tile * PAIR_TILE * PAIR_TILE;\n              produce_pair_tile(&w, begin, end, target_begin, target_end, tile_cache);\n            }\n\n            const int groups = (end - begin + 3) / 4;\n            #pragma omp for schedule(static)\n            for (int group = 0; group < groups; ++group) {\n              const int first = begin + 4 * group;\n#if defined(__aarch64__)\n              if (end - first >= 4) {\n                complete_four_rows(&w, band, begin, end, first, n);\n              } else\n#endif\n              {\n                int count = end - first;\n                if (count > 4) {\n                  count = 4;\n                }\n                for (int lane = 0; lane < count; ++lane) {\n                  complete_scalar_row(&w, band, begin, end, first + lane, n);\n                }\n              }\n            }\n          }\n\n          #pragma omp for schedule(static)\n          for (int i = 0; i < n; ++i) {\n            p[i].vx += dt*w.fx[i];\n            p[i].vy += dt*w.fy[i];\n            p[i].vz += dt*w.fz[i];\n          }\n        }\n      }\n\n      if (update_positions) {\n        #pragma omp for schedule(static)\n        for (int i = 0; i < n; ++i) {\n          p[i].x += p[i].vx * dt;\n          p[i].y += p[i].vy * dt;\n          p[i].z += p[i].vz * dt;\n        }\n      }\n    }\n  }\n\n  free(w.cache);\n  free(w.storage);\n}\n\n/* Preserve the standalone force-update entry point. */\nvoid body_force(Body *p, float dt, int n) {\n  simulate_steps(p, dt, n, 1, 0);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n  simulate_steps(bodies, DT, nbodies, N_ITER, 1);\n\n  write_dataset(nbodies, bodies);\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n"
}

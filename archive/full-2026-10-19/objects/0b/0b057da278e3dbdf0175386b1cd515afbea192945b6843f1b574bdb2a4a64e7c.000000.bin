{
  "src/tropical.cpp": "#include <algorithm>\n#include <climits>\n#include <cstdint>\n#include <cstdio>\n#include <utility>\n#include <vector>\n\nstruct Edge {\n    int first;\n    int second;\n};\n\nstruct Partition {\n    std::vector<Edge> spanning;\n    std::vector<Edge> included;\n    std::vector<Edge> excluded;\n};\n\nclass TropicalSolver {\npublic:\n    TropicalSolver(int vertices, int colors)\n        : vertexCount(vertices), colorTarget(colors), graph(static_cast<std::size_t>(vertices) * vertices, 0),\n          forbidden(static_cast<std::size_t>(vertices) * vertices, 0), forbidEpoch(0), bestColors(0), activeColors(0) {\n        vertexColors.resize(vertices);\n        colorIndex.resize(vertices);\n        onPath.assign(vertices, 0);\n    }\n\n    void setColor(int vertex, int color) {\n        vertexColors[vertex] = color;\n    }\n\n    void prepareColors() {\n        std::vector<int> distinct = vertexColors;\n        std::sort(distinct.begin(), distinct.end());\n        distinct.erase(std::unique(distinct.begin(), distinct.end()), distinct.end());\n\n        for (int vertex = 0; vertex < vertexCount; ++vertex) {\n            colorIndex[vertex] = static_cast<int>(\n                std::lower_bound(distinct.begin(), distinct.end(), vertexColors[vertex]) - distinct.begin());\n        }\n        colorOccurrences.assign(distinct.size(), 0);\n    }\n\n    void addEdge(int first, int second) {\n        graph[index(first, second)] = 1;\n        graph[index(second, first)] = 1;\n    }\n\n    int makeSpanningTree(const std::vector<Edge>& included, const std::vector<Edge>& excluded,\n                         std::vector<Edge>& tree) {\n        tree.clear();\n        if (vertexCount == 0) {\n            return -1;\n        }\n\n        if (++forbidEpoch == 0) {\n            std::fill(forbidden.begin(), forbidden.end(), 0);\n            forbidEpoch = 1;\n        }\n        for (const Edge& edge : excluded) {\n            forbidden[index(edge.first, edge.second)] = forbidEpoch;\n            forbidden[index(edge.second, edge.first)] = forbidEpoch;\n        }\n\n        std::vector<int> key(vertexCount, INT_MAX);\n        std::vector<int> parent(vertexCount, vertexCount);\n        std::vector<unsigned char> inTree(vertexCount, 0);\n        std::vector<unsigned char> mustInclude(vertexCount, 0);\n        std::vector<int> includedParent(vertexCount, -1);\n\n        for (const Edge& edge : included) {\n            mustInclude[edge.first] = 1;\n            mustInclude[edge.second] = 1;\n            includedParent[edge.second] = edge.first;\n            includedParent[edge.first] = 100;\n        }\n\n        key[0] = 0;\n        parent[0] = -1;\n\n        for (int count = 0; count < vertexCount; ++count) {\n            int current = -1;\n            int minimum = INT_MAX;\n            for (int vertex = 0; vertex < vertexCount; ++vertex) {\n                if (!inTree[vertex] && key[vertex] < minimum) {\n                    minimum = key[vertex];\n                    current = vertex;\n                }\n            }\n            if (current == -1) {\n                return -1;\n            }\n\n            inTree[current] = 1;\n            const std::size_t row = static_cast<std::size_t>(current) * vertexCount;\n            for (int next = 0; next < vertexCount; ++next) {\n                if (!graph[row + next] || forbidden[row + next] == forbidEpoch || inTree[next] || key[next] <= 1) {\n                    continue;\n                }\n                if (mustInclude[next] && includedParent[next] != 100 && includedParent[next] != current) {\n                    const int requiredParent = includedParent[next];\n                    if (parent[requiredParent] != vertexCount) {\n                        continue;\n                    }\n                }\n                parent[next] = current;\n                key[next] = 1;\n            }\n        }\n\n        tree.reserve(vertexCount > 0 ? vertexCount - 1 : 0);\n        for (int vertex = 1; vertex < vertexCount; ++vertex) {\n            tree.push_back(Edge{parent[vertex], vertex});\n        }\n        return vertexCount - 1;\n    }\n\n    bool findTropicalPath(const std::vector<Edge>& tree) {\n        buildTreeLayout(tree);\n        std::fill(colorOccurrences.begin(), colorOccurrences.end(), 0);\n        activeColors = 0;\n\n        for (int start = 0; start < vertexCount; ++start) {\n            path.clear();\n            addToPath(start);\n\n            for (int position = treeOffsets[start]; position < treeOffsets[start + 1]; ++position) {\n                const int next = treeNeighbors[position];\n                if (!onPath[next] && walkTree(next)) {\n                    return true;\n                }\n            }\n\n            removeFromPath(start);\n        }\n        return false;\n    }\n\n    void printResult(bool complete) const {\n        for (std::size_t position = 0; position < bestPath.size(); ++position) {\n            if (position != 0) {\n                std::putchar('-');\n            }\n            std::printf(\"%d\", bestPath[position]);\n        }\n        std::putchar('\\n');\n        if (complete) {\n            std::printf(\"%d\", colorTarget);\n        } else {\n            std::printf(\"%d\\n\", bestColors);\n        }\n    }\n\nprivate:\n    std::size_t index(int first, int second) const {\n        return static_cast<std::size_t>(first) * vertexCount + second;\n    }\n\n    void buildTreeLayout(const std::vector<Edge>& tree) {\n        treeOffsets.assign(vertexCount + 1, 0);\n        for (const Edge& edge : tree) {\n            ++treeOffsets[edge.first + 1];\n            ++treeOffsets[edge.second + 1];\n        }\n        for (int vertex = 0; vertex < vertexCount; ++vertex) {\n            treeOffsets[vertex + 1] += treeOffsets[vertex];\n        }\n\n        std::vector<int> cursor = treeOffsets;\n        treeNeighbors.assign(tree.size() * 2, 0);\n        for (const Edge& edge : tree) {\n            treeNeighbors[cursor[edge.first]++] = edge.second;\n            treeNeighbors[cursor[edge.second]++] = edge.first;\n        }\n    }\n\n    void addToPath(int vertex) {\n        onPath[vertex] = 1;\n        path.push_back(vertex);\n        const int color = colorIndex[vertex];\n        if (colorOccurrences[color]++ == 0) {\n            ++activeColors;\n        }\n    }\n\n    void removeFromPath(int vertex) {\n        const int color = colorIndex[vertex];\n        if (--colorOccurrences[color] == 0) {\n            --activeColors;\n        }\n        path.pop_back();\n        onPath[vertex] = 0;\n    }\n\n    bool walkTree(int vertex) {\n        addToPath(vertex);\n        bool hasChild = false;\n\n        for (int position = treeOffsets[vertex]; position < treeOffsets[vertex + 1]; ++position) {\n            const int next = treeNeighbors[position];\n            if (!onPath[next]) {\n                hasChild = true;\n                if (walkTree(next)) {\n                    return true;\n                }\n            }\n        }\n\n        if (!hasChild) {\n            if (activeColors == colorTarget) {\n                bestPath = path;\n                return true;\n            }\n            if (activeColors > bestColors) {\n                bestColors = activeColors;\n                bestPath = path;\n            }\n        }\n\n        removeFromPath(vertex);\n        return false;\n    }\n\n    int vertexCount;\n    int colorTarget;\n    std::vector<unsigned char> graph;\n    std::vector<unsigned int> forbidden;\n    unsigned int forbidEpoch;\n    std::vector<int> vertexColors;\n    std::vector<int> colorIndex;\n    std::vector<int> colorOccurrences;\n    std::vector<unsigned char> onPath;\n    std::vector<int> path;\n    std::vector<int> bestPath;\n    std::vector<int> treeOffsets;\n    std::vector<int> treeNeighbors;\n    int bestColors;\n    int activeColors;\n};\n\nint main() {\n    int vertices;\n    int colors;\n    if (std::scanf(\"%i %i\", &vertices, &colors) != 2) {\n        return 0;\n    }\n\n    TropicalSolver solver(vertices, colors);\n    for (int vertex = 0; vertex < vertices; ++vertex) {\n        int color;\n        std::scanf(\"%i\", &color);\n        solver.setColor(vertex, color);\n    }\n    solver.prepareColors();\n\n    int edgeCount;\n    std::scanf(\"%i\", &edgeCount);\n    for (int edge = 0; edge < edgeCount; ++edge) {\n        int first;\n        int second;\n        std::scanf(\"%i %i\", &first, &second);\n        solver.addEdge(first, second);\n    }\n\n    std::vector<Edge> empty;\n    std::vector<Edge> initialTree;\n    solver.makeSpanningTree(empty, empty, initialTree);\n\n    std::vector<Partition> partitions;\n    partitions.push_back(Partition{std::move(initialTree), empty, empty});\n\n    bool complete = false;\n    while (!partitions.empty()) {\n        Partition current = std::move(partitions.back());\n        partitions.pop_back();\n\n        if (solver.findTropicalPath(current.spanning)) {\n            complete = true;\n            break;\n        }\n\n        std::vector<Edge> included = current.included;\n        std::size_t firstVariable = 0;\n        while (firstVariable < current.spanning.size() && firstVariable < included.size()) {\n            const Edge& treeEdge = current.spanning[firstVariable];\n            const Edge& includedEdge = included[firstVariable];\n            if (treeEdge.first != includedEdge.first && treeEdge.second != includedEdge.second) {\n                break;\n            }\n            ++firstVariable;\n        }\n\n        for (std::size_t edgeIndex = firstVariable; edgeIndex < current.spanning.size(); ++edgeIndex) {\n            const Edge excludedEdge = current.spanning[edgeIndex];\n            std::vector<Edge> excluded = current.excluded;\n            excluded.push_back(excludedEdge);\n\n            std::vector<Edge> nextTree;\n            if (solver.makeSpanningTree(included, excluded, nextTree) > 0) {\n                partitions.push_back(Partition{std::move(nextTree), included, std::move(excluded)});\n            }\n            included.push_back(excludedEdge);\n        }\n    }\n\n    solver.printResult(complete);\n    return 0;\n}\n"
}

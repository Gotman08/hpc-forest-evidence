      "content": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nint A[1000][1000];\nint ps[1010][1010];\n\ntypedef long long ll;\n\nclass PrefixFrequencyWorkspace {\n  typedef uint32_t HashLanes __attribute__((vector_size(16)));\n\n  vector<int> keys_;\n  vector<uint32_t> counts_;\n  size_t mask_;\n\n  static uint32_t hash_key(int key) {\n    uint32_t x = static_cast<uint32_t>(key);\n    x ^= x >> 16;\n    x *= UINT32_C(0x7feb352d);\n    x ^= x >> 15;\n    x *= UINT32_C(0x846ca68b);\n    x ^= x >> 16;\n    return x;\n  }\n\n  static HashLanes hash_keys(HashLanes x) {\n    // Four independent unsigned hashes fit one ARM64 SIMD vector.\n    x ^= x >> 16;\n    x *= UINT32_C(0x7feb352d);\n    x ^= x >> 15;\n    x *= UINT32_C(0x846ca68b);\n    x ^= x >> 16;\n    return x;\n  }\n\n  size_t find_slot(int key, uint32_t hash) const {\n    size_t slot = static_cast<size_t>(hash) & mask_;\n    while (counts_[slot] != 0 && keys_[slot] != key)\n      slot = (slot + 1) & mask_;\n    return slot;\n  }\n\n  uint32_t count_hashed(int key, uint32_t hash) const {\n    // An unsuccessful lookup stops at an empty slot without inserting.\n    return counts_[find_slot(key, hash)];\n  }\n\n  void increment_hashed(int key, uint32_t hash) {\n    const size_t slot = find_slot(key, hash);\n    if (counts_[slot] == 0)\n      keys_[slot] = key;\n    ++counts_[slot];\n  }\n\npublic:\n  explicit PrefixFrequencyWorkspace(size_t max_prefixes) {\n    size_t capacity = 1;\n    while (capacity < 2 * max_prefixes)\n      capacity <<= 1;\n    keys_.resize(capacity);\n    counts_.resize(capacity);\n    mask_ = capacity - 1;\n  }\n\n  void reset() {\n    // Independent contiguous stores permit vectorized or bulk clearing.\n    fill(counts_.begin(), counts_.end(), uint32_t(0));\n    increment(0);\n  }\n\n  uint32_t count(int key) const {\n    return count_hashed(key, hash_key(key));\n  }\n\n  void increment(int key) {\n    increment_hashed(key, hash_key(key));\n  }\n\n  ll consume_pair(int first, int second, int k) {\n    const int first_target = first - k;\n    const int second_target = second - k;\n    const HashLanes inputs = {\n        static_cast<uint32_t>(first_target),\n        static_cast<uint32_t>(first),\n        static_cast<uint32_t>(second_target),\n        static_cast<uint32_t>(second)};\n    const HashLanes hashes = hash_keys(inputs);\n\n    // Only hash arithmetic is parallel. Probes and updates retain their\n    // original order, including collisions, repeated prefixes, and k == 0.\n    ll matches = count_hashed(first_target, hashes[0]);\n    increment_hashed(first, hashes[1]);\n    matches += count_hashed(second_target, hashes[2]);\n    increment_hashed(second, hashes[3]);\n    return matches;\n  }\n};\n\nll solve(int m, int n, int k) {\n  for (int i = 1; i <= m; i++) {\n    for (int j = 1; j <= n; j++) {\n      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\n    }\n  }\n  PrefixFrequencyWorkspace h(static_cast<size_t>(m) + 1);\n  ll ans = 0;\n  for (int j = 1; j <= n; j++) // O(m*n^2)\n    for (int l = j; l <= n; l++) {\n      h.reset();\n      int s = 0;\n      int i = 1;\n      for (; i + 1 <= m; i += 2) {\n        // Prefix sums retain their scalar recurrence; their hashes do not\n        // depend on any frequency-table updates.\n        s += ps[i][l] - ps[i][j - 1];\n        const int first = s;\n        s += ps[i + 1][l] - ps[i + 1][j - 1];\n        ans += h.consume_pair(first, s, k);\n      }\n      if (i <= m) {\n        s += ps[i][l] - ps[i][j - 1];\n        ans += h.count(s - k);\n        h.increment(s);\n      }\n    }\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n  memset(ps, 0, sizeof ps);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n",
      "path": "src/main.cpp"
    }
  ],
  "hypothesis": "Batching the four independent hashes for two consecutive prefixes into a 128-bit unsigned SIMD vector should reduce hash-arithmetic cost while preserving all prefix-frequency dependencies.",

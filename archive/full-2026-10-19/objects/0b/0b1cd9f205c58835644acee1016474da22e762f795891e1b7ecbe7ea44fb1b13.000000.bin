        "depth": 1,
        "epoch": 1,
        "hypothesis": "Static target-body work sharing with double-buffered, fused timesteps should accelerate the simulation while reducing synchronization to one worksharing barrier per timestep and avoiding writes to the shared source buffer.",
        "id": "952b777044dd4b83",
        "ordinal": 2,
        "parent_id": null,
        "role": "C",

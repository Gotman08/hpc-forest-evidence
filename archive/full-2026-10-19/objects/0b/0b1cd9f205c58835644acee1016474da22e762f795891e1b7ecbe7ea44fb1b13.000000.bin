        "hypothesis": "Static target-body work sharing across a persistent OpenMP team should accelerate the quadratic force calculation on four cores while preserving each body's original arithmetic and accumulation order.",
        "id": "582f183186464085",
        "ordinal": 1,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/nbody.c"
          ],
          "retained": [
            "Extract the unchanged per-target force calculation into a shared inline helper; parallelize independent body_force calls over targets.",
            "Reuse one OpenMP team across all ten timesteps, with static work sharing for force and position updates.",
            "Retain both timestep barriers and use serialized execution below 128 bodies to limit threading overhead."
          ]
        },

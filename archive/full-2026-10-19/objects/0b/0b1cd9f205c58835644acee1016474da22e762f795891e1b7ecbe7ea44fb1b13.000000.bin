    {
      "id": "56528fcf589f4806",
      "role": "A",
      "mission": {
        "base_commit": "38e2ff7167477005d5440e85cbd6f6c8287cd6e5",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Packing positions into contiguous structure-of-arrays storage should reduce the repeatedly scanned footprint from 24 to 12 bytes per body, without the register pressure of the previously slower four-target blocking experiment.",
        "id": "56528fcf589f4806",
        "ordinal": 2,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/nbody.c"
          ],
          "retained": [
            "Create a call-local packed x/y/z snapshot and use it for the single-target all-pairs force loop.",
            "Retain the original kernel as a fallback if scratch allocation fails or its size would overflow."
          ]
        },
        "tree_id": "e1:A",
        "trial_id": "01M54WWTCTKBCRFVRKNAB54TZ3",
        "worktree": "/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-astra-xhigh/results-750205/2022-nbody/worktrees/56528fcf589f4806"

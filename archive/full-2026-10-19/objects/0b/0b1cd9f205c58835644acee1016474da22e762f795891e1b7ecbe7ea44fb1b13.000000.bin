          ],
          "retained": [
            "Process four independent target bodies per NEON vector, broadcasting each source position without reassociating force reductions.",
            "Compute squared distances and force accumulation in float, with native double-precision vector square root and division before conversion back to float; use no approximate reciprocal operations.",
            "Retain scalar handling for incomplete blocks and non-NEON builds; leave simulation integration and binary I/O unchanged."
          ]
        },

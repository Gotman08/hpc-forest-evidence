          ],
          "retained": [
            "Use one persistent OpenMP team with static target-body scheduling.",
            "Fuse force, velocity, and position updates into an alternate Body buffer; swap thread-local pointers after the worksharing barrier.",
            "Retain serial execution below 128 bodies or when checked scratch allocation fails."
          ]
        },

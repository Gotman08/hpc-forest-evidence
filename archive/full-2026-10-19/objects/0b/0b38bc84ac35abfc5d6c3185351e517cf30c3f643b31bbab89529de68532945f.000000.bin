      "content": "#include \"knn.h\"\n#include <omp.h>\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    // Initialize global top-k list\n    for (int i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1.0f;\n    }\n\n    int nthreads, tid;\n    #pragma omp parallel private(tid)\n    {\n        #pragma omp single\n        nthreads = omp_get_num_threads();\n    }\n\n    // Allocate per-thread local top-k arrays\n    char **local_labels = (char**) malloc(sizeof(char*) * nthreads);\n    float **local_distances = (float**) malloc(sizeof(float*) * nthreads);\n    for (int t = 0; t < nthreads; t++) {\n        local_labels[t] = (char*) malloc(sizeof(char) * k);\n        local_distances[t] = (float*) malloc(sizeof(float) * k);\n        for (int i = 0; i < k; i++) {\n            local_labels[t][i] = -1;\n            local_distances[t][i] = -1.0f;\n        }\n    }\n\n    // Parallel loop over groups with static scheduling to preserve input order per chunk\n    #pragma omp parallel for schedule(static) private(tid)\n    for (int i = 0; i < n_groups; i++) {\n        tid = omp_get_thread_num();\n        Group g = groups[i];\n        char *my_labels = local_labels[tid];\n        float *my_distances = local_distances[tid];\n\n        for (int j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            // Insert into thread-local sorted list of size k\n            for (int x = 0; x < k; x++) {\n                if (d < my_distances[x] || my_distances[x] == -1.0f) {\n                    for (int y = k - 1; y > x; y--) {\n                        my_distances[y] = my_distances[y - 1];\n                        my_labels[y] = my_labels[y - 1];\n                    }\n                    my_distances[x] = d;\n                    my_labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    // Merge per-thread lists into global list in thread order (preserves original group ordering)\n    for (int t = 0; t < nthreads; t++) {\n        char *my_labels = local_labels[t];\n        float *my_distances = local_distances[t];\n\n        for (int i = 0; i < k; i++) {\n            if (my_distances[i] == -1.0f) continue;\n            float d = my_distances[i];\n            char lbl = my_labels[i];\n\n            // Insert into global list using same logic as original serial code\n            for (int x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1.0f) {\n                    for (int y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = lbl;\n                    break;\n                }\n            }\n        }\n    }\n\n    // Free per-thread arrays\n    for (int t = 0; t < nthreads; t++) {\n        free(local_labels[t]);\n        free(local_distances[t]);\n    }\n    free(local_labels);\n    free(local_distances);\n\n    // Find most frequent label among the k nearest neighbors (unchanged)\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    },
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <omp.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}\n",
      "path": "src/knn.h"
    }
  ],
  "hypothesis": "Parallelizing the outer loop over groups with per-thread local top-k lists and static scheduling preserves input order within each chunk, enabling a deterministic merge that matches serial tie-breaking. This reduces thread synchronization overhead while exploiting OpenMP work sharing.",
  "notes": "Added #include <omp.h> to knn.h for visibility. The parallel region uses schedule(static) so contiguous groups are assigned to threads in round-robin order; merging per-thread lists in increasing thread ID reconstructs the original processing sequence, ensuring identical output when distances are unique (the common case). Memory allocation for per-thread arrays is done once outside the loop.",

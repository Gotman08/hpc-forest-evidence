      "content": "#include <ctype.h>\n#include <limits.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\ntypedef struct {\n  int id;\n  int index;\n  float value;\n} IdIndex;\n\ntypedef struct {\n  char *text;\n  int id;\n  int index;\n} Root;\n\nstatic void fail(void) {\n  fprintf(stderr, \"Error!\\n\");\n  exit(1);\n}\n\nstatic void *xmalloc(size_t size) {\n  void *p = malloc(size ? size : 1);\n  if (p == NULL)\n    fail();\n  return p;\n}\n\nstatic void *xrealloc(void *ptr, size_t size) {\n  void *p = realloc(ptr, size ? size : 1);\n  if (p == NULL)\n    fail();\n  return p;\n}\n\nstatic char *read_line(FILE *fl) {\n  size_t capacity = 128;\n  size_t length = 0;\n  char *line = (char *)xmalloc(capacity);\n  int ch;\n\n  while ((ch = fgetc(fl)) != EOF && ch != '\\n') {\n    if (length + 1 >= capacity) {\n      capacity *= 2;\n      line = (char *)xrealloc(line, capacity);\n    }\n    line[length++] = (char)ch;\n  }\n\n  if (ch == EOF && length == 0) {\n    free(line);\n    return NULL;\n  }\n  line[length] = '\\0';\n  return line;\n}\n\nstatic char *skip_space(char *p) {\n  while (*p != '\\0' && isspace((unsigned char)*p))\n    ++p;\n  return p;\n}\n\nstatic void append_root(Root **roots, size_t *length, size_t *capacity,\n                        const char *text, size_t text_length, int id) {\n  if (*length == *capacity) {\n    *capacity = *capacity ? *capacity * 2 : 8;\n    *roots = (Root *)xrealloc(*roots, *capacity * sizeof(Root));\n  }\n  (*roots)[*length].text = (char *)xmalloc(text_length + 1);\n  memcpy((*roots)[*length].text, text, text_length);\n  (*roots)[*length].text[text_length] = '\\0';\n  (*roots)[*length].id = id;\n  (*roots)[*length].index = -1;\n  ++*length;\n}\n\nstatic void append_edge(int **edges, size_t *length, size_t *capacity, int id) {\n  if (*length == *capacity) {\n    *capacity = *capacity ? *capacity * 2 : 32;\n    *edges = (int *)xrealloc(*edges, *capacity * sizeof(int));\n  }\n  (*edges)[(*length)++] = id;\n}\n\nstatic int compare_id_index(const void *left, const void *right) {\n  const IdIndex *a = (const IdIndex *)left;\n  const IdIndex *b = (const IdIndex *)right;\n  if (a->id < b->id)\n    return -1;\n  if (a->id > b->id)\n    return 1;\n  if (a->index < b->index)\n    return -1;\n  if (a->index > b->index)\n    return 1;\n  return 0;\n}\n\n/* Returns the first input-order entry for an ID, or NULL if it is absent. */\nstatic const IdIndex *find_key_by_id(const IdIndex *keys, size_t count,\n                                     int id) {\n  size_t lo = 0;\n  size_t hi = count;\n  while (lo < hi) {\n    size_t mid = lo + (hi - lo) / 2;\n    if (keys[mid].id < id)\n      lo = mid + 1;\n    else\n      hi = mid;\n  }\n  if (lo < count && keys[lo].id == id)\n    return &keys[lo];\n  return NULL;\n}\n\n/* Iteratively evaluate and memoize a selected-successor chain in a DAG. */\nstatic float get_costly(int root, const float *values, const int *successor,\n                        float *costs, unsigned char *done, int *path) {\n  if (root < 0)\n    return 0.0f;\n\n  int length = 0;\n  int current = root;\n  while (current >= 0 && !done[current]) {\n    path[length++] = current;\n    current = successor[current];\n  }\n\n  while (length > 0) {\n    int node = path[--length];\n    float result = values[node];\n    if (successor[node] >= 0)\n      result += costs[successor[node]];\n    costs[node] = result;\n    done[node] = 1;\n  }\n  return costs[root];\n}\n\nint main(void) {\n  Root *roots = NULL;\n  size_t root_count = 0;\n  size_t root_capacity = 0;\n  char *line = read_line(stdin);\n  if (line == NULL)\n    fail();\n\n  char *p = skip_space(line);\n  char *end;\n  long parsed_count = strtol(p, &end, 10);\n  if (end == p || parsed_count < 0 || parsed_count > INT_MAX)\n    fail();\n  int n = (int)parsed_count;\n\n  p = end;\n  while (*(p = skip_space(p)) != '\\0') {\n    char *token_start = p;\n    long id = strtol(p, &end, 10);\n    if (end == p || id < INT_MIN || id > INT_MAX)\n      fail();\n    append_root(&roots, &root_count, &root_capacity, token_start,\n                (size_t)(end - token_start), (int)id);\n    p = end;\n  }\n  free(line);\n\n  size_t node_slots = n > 0 ? (size_t)n : 1;\n  int *ids = (int *)xmalloc(node_slots * sizeof(int));\n  float *values = (float *)xmalloc(node_slots * sizeof(float));\n  size_t *offsets = (size_t *)xmalloc(((size_t)n + 1) * sizeof(size_t));\n  int *edge_ids = NULL;\n  size_t edge_count = 0;\n  size_t edge_capacity = 0;\n\n  for (int i = 0; i < n; ++i) {\n    line = read_line(stdin);\n    if (line == NULL)\n      fail();\n    p = skip_space(line);\n    long id = strtol(p, &end, 10);\n    if (end == p || id < INT_MIN || id > INT_MAX)\n      fail();\n    ids[i] = (int)id;\n\n    p = skip_space(end);\n    char *value_end;\n    values[i] = strtof(p, &value_end);\n    if (value_end == p)\n      fail();\n    p = value_end;\n\n    offsets[i] = edge_count;\n    while (*(p = skip_space(p)) != '\\0') {\n      char *edge_end;\n      long neighbor_id = strtol(p, &edge_end, 10);\n      if (edge_end == p || neighbor_id < INT_MIN || neighbor_id > INT_MAX)\n        fail();\n      append_edge(&edge_ids, &edge_count, &edge_capacity, (int)neighbor_id);\n      p = edge_end;\n    }\n    offsets[i + 1] = edge_count;\n    free(line);\n  }\n\n  IdIndex *keys = (IdIndex *)xmalloc(node_slots * sizeof(IdIndex));\n  for (int i = 0; i < n; ++i) {\n    keys[i].id = ids[i];\n    keys[i].index = i;\n    keys[i].value = values[i];\n  }\n  qsort(keys, (size_t)n, sizeof(IdIndex), compare_id_index);\n\n  int *successor = (int *)xmalloc(node_slots * sizeof(int));\n  float *costs = (float *)xmalloc(node_slots * sizeof(float));\n  unsigned char *done = (unsigned char *)calloc(node_slots, sizeof(unsigned char));\n  int *path = (int *)xmalloc(node_slots * sizeof(int));\n  if (done == NULL)\n    fail();\n\n  /* Resolve roots while the sorted lookup table is available. */\n  for (size_t i = 0; i < root_count; ++i) {\n    const IdIndex *root_key = find_key_by_id(keys, (size_t)n, roots[i].id);\n    if (root_key != NULL)\n      roots[i].index = root_key->index;\n  }\n\n  /* Keep only the winning neighbor; the temporary edge list is then discarded. */\n  for (int i = 0; i < n; ++i) {\n    float maximum = 0.0f;\n    int best_id = -1;\n    int best_index = -1;\n    for (size_t edge = offsets[i]; edge < offsets[i + 1]; ++edge) {\n      const IdIndex *neighbor =\n          find_key_by_id(keys, (size_t)n, edge_ids[edge]);\n      if (neighbor != NULL && maximum < neighbor->value) {\n        maximum = neighbor->value;\n        best_id = neighbor->id;\n        best_index = neighbor->index;\n      }\n    }\n    successor[i] = best_id != -1 ? best_index : -1;\n  }\n\n  free(ids);\n  free(offsets);\n  free(edge_ids);\n  free(keys);\n\n  for (size_t i = 0; i < root_count; ++i) {\n    printf(\"%s: %f\\n\", roots[i].text,\n           get_costly(roots[i].index, values, successor, costs, done, path));\n  }\n\n  for (size_t i = 0; i < root_count; ++i)\n    free(roots[i].text);\n  free(roots);\n  free(values);\n  free(successor);\n  free(costs);\n  free(done);\n  free(path);\n  return 0;\n}\n",
      "path": "src/graph.c"
    }
  ],
  "hypothesis": "Packing each node value into its sorted ID lookup entry should improve locality during neighbor selection by keeping the value beside the ID metadata fetched by binary search. Pre-resolving roots while the lookup table is available also fixes the previous candidate's missing-root evaluation. This is an unmeasured hypothesis.",
  "notes": "The baseline and prior measurements are context only; this candidate has not been measured. It retains input-order tie behavior, missing-ID handling, the -1 successor sentinel, and memoized chain evaluation for DAG inputs.",

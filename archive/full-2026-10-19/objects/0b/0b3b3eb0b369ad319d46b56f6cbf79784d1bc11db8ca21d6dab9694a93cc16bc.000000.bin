{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include <algorithm>\\n#include <cassert>\\n#include <cstddef>\\n#include <cstdio>\\n#include <limits>\\n#include <vector>\\n\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\nstatic long long scan_band(const int* matrix, int n, int s,\\n                           int first, int last) {\\n    std::vector<long long> columns(n, 0);\\n    for (int row = first; row < first + s; ++row) {\\n        const int* values = matrix + static_cast<std::size_t>(row) * n;\\n        for (int col = 0; col < n; ++col)\\n            columns[col] += values[col];\\n    }\\n\\n    long long best = std::numeric_limits<long long>::min();\\n    for (int top = first; top < last; ++top) {\\n        long long sum = 0;\\n        for (int col = 0; col < s; ++col)\\n            sum += columns[col];\\n        best = std::max(best, sum);\\n\\n        for (int col = s; col < n; ++col) {\\n            sum += columns[col] - columns[col - s];\\n            best = std::max(best, sum);\\n        }\\n\\n        if (top + 1 < last) {\\n            const int* leaving = matrix + static_cast<std::size_t>(top) * n;\\n            const int* entering = matrix + static_cast<std::size_t>(top + s) * n;\\n            for (int col = 0; col < n; ++col)\\n                columns[col] += static_cast<long long>(entering[col]) - leaving[col];\\n        }\\n    }\\n    return best;\\n}\\n\\nstatic long long maximum_sum(const int* matrix, int n, int s) {\\n    const int windows = n - s + 1;\\n#ifdef _OPENMP\\n    const long long scan_cells = static_cast<long long>(n) * windows;\\n    const long long minimum_cells_per_worker = 262144;\\n    int workers = std::min(omp_get_max_threads(), windows);\\n    workers = std::min(workers, std::max(1, static_cast<int>(\\n        scan_cells / minimum_cells_per_worker)));\\n    // Bound duplicated initialization relative to useful rolling work.\\n    workers = std::min(workers, 1 + (windows - 1) / s);\\n\\n    if (workers > 1) {\\n        long long best = std::numeric_limits<long long>::min();\\n#pragma omp parallel num_threads(workers) reduction(max: best)\\n        {\\n            const int id = omp_get_thread_num();\\n            const int count = omp_get_num_threads();\\n            const int first = windows * id / count;\\n            const int last = windows * (id + 1) / count;\\n            best = scan_band(matrix, n, s, first, last);\\n        }\\n        return best;\\n    }\\n#endif\\n    return scan_band(matrix, n, s, 0, windows);\\n}\\n\\nint main() {\\n    int n, s;\\n    if (std::scanf(\\\"%d %d\\\", &n, &s) != 2)\\n        return 0;\\n\\n    assert(s < n);\\n    assert(n < 8000);\\n    assert(s > 0);\\n    assert(n > 0);\\n\\n    std::vector<int> matrix(static_cast<std::size_t>(n) * n);\\n    for (std::size_t index = 0; index < matrix.size(); ++index)\\n        std::scanf(\\\"%d\\\", &matrix[index]);\\n\\n    const long long best = maximum_sum(&matrix[0], n, s);\\n    std::printf(\\\"%lld\\\\n\\\", best);\\n    return 0;\\n}\\n\",\n      \"path\": \"src/solution.cpp\"\n    }\n  ],\n  \"hypothesis\": \"Contiguous rolling column sums eliminate repeated strided work; sufficiently large scans can benefit from independent OpenMP row bands with one final maximum reduction.\",\n  \"notes\": \"Not executed locally. OpenMP requires the unchanged build to define _OPENMP; otherwise the same algorithm runs serially. All intermediate sums use 64-bit arithmetic.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Replace serpentine length-S updates with an O(N²) rolling-column algorithm over contiguous matrix storage.\",\n    \"Assign contiguous window-top-row bands to workers, each with private column sums, and reduce their maxima.\",\n    \"Limit workers using configured thread count, minimum work per worker, and duplicated initialization cost; retain a serial fallback.\"\n  ]\n}"}}

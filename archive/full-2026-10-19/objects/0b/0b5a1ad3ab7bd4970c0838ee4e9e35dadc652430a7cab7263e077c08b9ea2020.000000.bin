#include <bits/stdc++.h>

using namespace std;

int A[1000][1000];
int ps[1010][1010];

typedef long long ll;

struct PrefixFrequencyTable {
  vector<ll> keys;
  vector<uint16_t> counts;
  size_t mask;
  unsigned hash_shift;

  explicit PrefixFrequencyTable(size_t max_entries) {
    size_t capacity = 1;
    unsigned bits = 0;
    while (capacity < 2 * max_entries) {
      capacity <<= 1;
      ++bits;
    }
    mask = capacity - 1;
    hash_shift = 64 - bits;
    keys.resize(capacity);
    counts.resize(capacity);
  }

  size_t slot(ll key) const {
    const uint64_t hash = static_cast<uint64_t>(key) *
                          UINT64_C(11400714819323198485);
    size_t pos = static_cast<size_t>(hash >> hash_shift);
    while (counts[pos] != 0 && keys[pos] != key)
      pos = (pos + 1) & mask;
    return pos;
  }

  void reset() {
    fill(counts.begin(), counts.end(), uint16_t(0));
    // The empty prefix hashes to zero; zero counts mark unused slots.
    keys[0] = 0;
    counts[0] = 1;
  }

  uint16_t get(ll key) const {
    return counts[slot(key)];
  }

  void increment(ll key) {
    const size_t pos = slot(key);
    if (counts[pos] == 0)
      keys[pos] = key;
    ++counts[pos];
  }
};

ll solve(int m, int n, int k) {
  const bool pair_rows = m <= n;
  const int bands = pair_rows ? m : n;
  const int length = pair_rows ? n : m;

  // Each boundary stores a contiguous prefix vector along the scan axis.
  fill(ps[0], ps[0] + length, 0);
  if (pair_rows) {
    for (int boundary = 1; boundary <= bands; ++boundary) {
      const int* previous = ps[boundary - 1];
      const int* row = A[boundary - 1];
      int* current = ps[boundary];
      for (int i = 0; i < length; ++i)
        current[i] = previous[i] + row[i];
    }
  } else {
    for (int i = 0; i < length; ++i) {
      int prefix = 0;
      for (int boundary = 1; boundary <= bands; ++boundary) {
        prefix += A[i][boundary - 1];
        ps[boundary][i] = prefix;
      }
    }
  }

  PrefixFrequencyTable frequencies(static_cast<size_t>(length) + 1);
  const ll target = static_cast<ll>(k);
  ll ans = 0;
  for (int first = 0; first < bands; ++first) {
    const int* lower = ps[first];
    for (int last = first + 1; last <= bands; ++last) {
      const int* upper = ps[last];
      frequencies.reset();
      ll sum = 0;
      for (int i = 0; i < length; ++i) {
        sum += static_cast<ll>(upper[i]) - lower[i];
        ans += frequencies.get(sum - target);
        frequencies.increment(sum);
      }
    }
  }
  return ans;
}

int main() {
  int k, m, n;
  cin >> k >> m >> n;
  memset(A, 0, sizeof A);
  memset(ps, 0, sizeof ps);

  for (int i = 0; i < m; i++)
    for (int j = 0; j < n; j++)
      cin >> A[i][j];

  cout << solve(m, n, k) << endl;
  return 0;
}

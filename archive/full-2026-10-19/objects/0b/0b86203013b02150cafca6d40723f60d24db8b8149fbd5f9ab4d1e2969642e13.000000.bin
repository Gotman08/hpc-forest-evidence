        "content": "#include <algorithm>\n#include <cstddef>\n#include <cstring>\n#include <iostream>\n#include <iterator>\n#include <string>\n\nclass BufferedOutput\n{\n    static const std::size_t capacity = 64 * 1024;\n    char buffer[capacity];\n    std::size_t used;\n\npublic:\n    BufferedOutput() : used(0) {}\n\n    void flush()\n    {\n        if (used != 0) {\n            std::cout.write(buffer, static_cast<std::streamsize>(used));\n            used = 0;\n        }\n    }\n\n    void append(const char* data, std::size_t length)\n    {\n        if (length <= capacity - used) {\n            std::memcpy(buffer + used, data, length);\n            used += length;\n            return;\n        }\n\n        flush();\n        while (length >= capacity) {\n            std::cout.write(data, static_cast<std::streamsize>(capacity));\n            data += capacity;\n            length -= capacity;\n        }\n        if (length != 0) {\n            std::memcpy(buffer, data, length);\n            used = length;\n        }\n    }\n};\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ' )\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v') ;\n    }\n} ;\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase\n        ( std::remove_if\n            ( text.begin ()\n            , text.end ()\n            , IsWhitespace () )\n        , text.end () ) ;\n    return text ;\n}\n\n// Only the character slots move; intervening spaces remain fixed.\nstatic bool next_formatted_permutation(char* values, std::size_t count)\n{\n    if (count < 2) return false;\n\n    std::size_t suffix = count - 1;\n    while (suffix != 0\n           && values[2 * (suffix - 1)] >= values[2 * suffix]) {\n        --suffix;\n    }\n    if (suffix == 0) return false;\n\n    const std::size_t pivot = 2 * (suffix - 1);\n    const char pivot_value = values[pivot];\n    std::size_t right = 2 * (count - 1);\n    std::size_t successor = right;\n    while (values[successor] <= pivot_value) {\n        successor -= 2;\n    }\n    std::swap(values[pivot], values[successor]);\n\n    std::size_t left = 2 * suffix;\n    while (left < right) {\n        std::swap(values[left], values[right]);\n        left += 2;\n        right -= 2;\n    }\n    return true;\n}\n\nstatic void permutations(std::string text)\n{\n    const std::size_t count = text.size();\n    if (count == 0) return;\n    std::sort(text.begin(), text.end());\n\n    BufferedOutput output;\n    if (count <= (text.max_size() - 4) / 2) {\n        // Expand backwards so unread characters are never overwritten.\n        text.resize(2 * count + 4);\n        for (std::size_t i = count; i != 0; --i) {\n            text[2 * i] = text[i - 1];\n            text[2 * i + 1] = ' ';\n        }\n        text[0] = '[';\n        text[1] = ' ';\n        text[text.size() - 2] = ']';\n        text[text.size() - 1] = '\\n';\n\n        char* const values = &text[2];\n        do {\n            output.append(text.data(), text.size());\n        } while (next_formatted_permutation(values, count));\n    } else {\n        // Avoid overflowing the formatted size for extremely large inputs.\n        do {\n            output.append(\"[ \", 2);\n            for (std::size_t i = 0; i < count; ++i) {\n                const char field[2] = {text[i], ' '};\n                output.append(field, sizeof field);\n            }\n            output.append(\"]\\n\", 2);\n        } while (std::next_permutation(text.begin(), text.end()));\n    }\n    output.flush();\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator <char> begin (in), end ;\n    std::string text (begin, end) ;\n    text = remove_whitespaces (text) ;\n    return text ;\n}\n\nint main (int argc, char const *argv [])\n{\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n    permutations(read_text_from_stdin<std::string>(std::cin));\n    return 0;\n}\n",
        "path": "src/permutations.cc"
      }

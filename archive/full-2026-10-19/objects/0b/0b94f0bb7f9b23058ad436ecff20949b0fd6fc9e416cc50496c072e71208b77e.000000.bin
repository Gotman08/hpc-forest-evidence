      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdio>\n#include <cstring>\n#include <limits>\n#include <memory>\n#include <vector>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nint main() {\n    int n, s;\n    if (std::scanf(\"%d%d\", &n, &s) != 2)\n        return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t element_count = static_cast<std::size_t>(n) * n;\n    std::unique_ptr<int[]> matrix_storage(new int[element_count]);\n    int* const matrix = matrix_storage.get();\n\n    const std::size_t input_capacity = 1u << 20;\n    std::unique_ptr<unsigned char[]> input_storage(\n        new unsigned char[2 * (input_capacity + 1)]);\n    unsigned char* input_buffers[2] = {\n        input_storage.get(),\n        input_storage.get() + input_capacity + 1\n    };\n\n    int thread_limit = 1;\n#ifdef _OPENMP\n    if (element_count >= 262144)\n        thread_limit = std::min(omp_get_max_threads(), n);\n#endif\n    std::vector<std::size_t> token_counts(thread_limit, 0);\n    std::size_t ready_size = 0;\n    std::size_t carry_size = 0;\n    std::size_t carry_start = 0;\n    bool final_input = false;\n\n    const int window_rows = n - s + 1;\n    long long mxSum = std::numeric_limits<long long>::lowest();\n\n#ifdef _OPENMP\n#pragma omp parallel num_threads(thread_limit) if(thread_limit > 1) reduction(max:mxSum)\n#endif\n    {\n        int thread_id = 0;\n        int thread_count = 1;\n#ifdef _OPENMP\n        thread_id = omp_get_thread_num();\n        thread_count = omp_get_num_threads();\n#endif\n        std::size_t parsed = 0;\n        int buffer_id = 0;\n\n        while (parsed < element_count) {\n            unsigned char* const text = input_buffers[buffer_id];\n#ifdef _OPENMP\n#pragma omp master\n#endif\n            {\n                if (carry_size != 0) {\n                    std::memcpy(text,\n                                input_buffers[buffer_id ^ 1] + carry_start,\n                                carry_size);\n                }\n                const std::size_t requested = input_capacity - carry_size;\n                const std::size_t bytes =\n                    std::fread(text + carry_size, 1, requested, stdin);\n                const std::size_t used = carry_size + bytes;\n                final_input = bytes < requested;\n                ready_size = used;\n                if (!final_input) {\n                    while (ready_size > 0 && text[ready_size - 1] > ' ')\n                        --ready_size;\n                }\n                carry_size = used - ready_size;\n                carry_start = ready_size;\n                text[used] = ' ';\n            }\n#ifdef _OPENMP\n#pragma omp barrier\n#endif\n            const std::size_t byte_count = ready_size;\n            const bool final_chunk = final_input;\n            if (byte_count == 0)\n                break;\n\n            std::size_t begin = byte_count * thread_id / thread_count;\n            std::size_t end = byte_count * (thread_id + 1) / thread_count;\n            if (thread_id != 0) {\n                while (begin < byte_count && text[begin] > ' ')\n                    ++begin;\n            }\n            if (thread_id + 1 != thread_count) {\n                while (end < byte_count && text[end] > ' ')\n                    ++end;\n            }\n\n            std::size_t output_index = parsed;\n            std::size_t chunk_tokens = 0;\n            if (thread_count > 1) {\n                std::size_t local_tokens = 0;\n                if (begin < end) {\n                    local_tokens = text[begin] > ' ' ? 1 : 0;\n#ifdef _OPENMP\n#pragma omp simd reduction(+:local_tokens)\n#endif\n                    for (std::size_t pos = begin + 1; pos < end; ++pos) {\n                        local_tokens += static_cast<std::size_t>(\n                            text[pos] > ' ' && text[pos - 1] <= ' ');\n                    }\n                }\n                token_counts[thread_id] = local_tokens;\n#ifdef _OPENMP\n#pragma omp barrier\n#endif\n                for (int t = 0; t < thread_count; ++t) {\n                    if (t < thread_id)\n                        output_index += token_counts[t];\n                    chunk_tokens += token_counts[t];\n                }\n            }\n\n            std::size_t pos = begin;\n            while (pos < end) {\n                while (pos < end && text[pos] <= ' ')\n                    ++pos;\n                if (pos == end)\n                    break;\n\n                bool negative = false;\n                if (text[pos] == '-' || text[pos] == '+') {\n                    negative = text[pos] == '-';\n                    ++pos;\n                }\n                unsigned int value = 0;\n                while (text[pos] >= '0' && text[pos] <= '9') {\n                    value = value * 10u + static_cast<unsigned int>(text[pos] - '0');\n                    ++pos;\n                }\n                const long long signed_value = negative\n                    ? -static_cast<long long>(value)\n                    : static_cast<long long>(value);\n                matrix[output_index++] = static_cast<int>(signed_value);\n            }\n\n            if (thread_count == 1)\n                parsed = output_index;\n            else\n                parsed += chunk_tokens;\n            if (final_chunk)\n                break;\n\n            // The next read uses the other buffer while workers finish conversion.\n            buffer_id ^= 1;\n        }\n\n        assert(parsed == element_count);\n#ifdef _OPENMP\n#pragma omp barrier\n#endif\n        const int first = static_cast<int>(\n            static_cast<long long>(window_rows) * thread_id / thread_count);\n        const int last = static_cast<int>(\n            static_cast<long long>(window_rows) * (thread_id + 1) / thread_count);\n\n        if (first < last) {\n            std::vector<long long> column_sums(n, 0);\n            for (int row = first; row < first + s; ++row) {\n                const int* values = matrix + static_cast<std::size_t>(row) * n;\n                for (int col = 0; col < n; ++col)\n                    column_sums[col] += values[col];\n            }\n\n            for (int row = first; row < last; ++row) {\n                if (row != first) {\n                    const int* exiting = matrix + static_cast<std::size_t>(row - 1) * n;\n                    const int* entering = matrix + static_cast<std::size_t>(row + s - 1) * n;\n                    for (int col = 0; col < n; ++col)\n                        column_sums[col] += static_cast<long long>(entering[col]) - exiting[col];\n                }\n\n                long long sum = 0;\n                for (int col = 0; col < s; ++col)\n                    sum += column_sums[col];\n                mxSum = std::max(mxSum, sum);\n\n                for (int col = s; col < n; ++col) {\n                    sum += column_sums[col] - column_sums[col - s];\n                    mxSum = std::max(mxSum, sum);\n                }\n            }\n        }\n    }\n\n    std::printf(\"%lld\\n\", mxSum);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

#include <cstdio>
#include <memory>
#include <vector>

class FastScanner {
    static constexpr int BUFSIZE = 1 << 20;
    char buf[BUFSIZE];
    char* cur;
    char* end;

    bool refill() {
        size_t r = fread(buf, 1, BUFSIZE, stdin);
        cur = buf;
        end = buf + r;
        return r > 0;
    }

public:
    FastScanner() : cur(buf), end(buf) {}

    inline int nextInt() {
        while (true) {
            if (cur == end && !refill()) return 0;
            char c = *cur++;
            if (c <= ' ') continue;

            int sign = 1;
            if (c == '-') {
                sign = -1;
                if (cur == end && !refill()) return 0;
                c = *cur++;
            }

            int x = c - '0';
            while (true) {
                if (cur == end && !refill()) break;
                char d = *cur++;
                if (d < '0' || d > '9') break;
                x = x * 10 + (d - '0');
            }
            return sign * x;
        }
    }
};

int main() {
    FastScanner fs;
    int n = fs.nextInt();
    int s = fs.nextInt();

    const size_t ringSize = (size_t)s + 1;
    std::unique_ptr<int[]> storage(new int[ringSize * (size_t)n]);
    int* __restrict ring = storage.get();

    std::vector<long long> col(n, 0);
    long long* __restrict c = col.data();

    for (int r = 0; r < s; ++r) {
        int* row = ring + (size_t)r * n;
        for (int j = 0; j < n; ++j) {
            int v = fs.nextInt();
            row[j] = v;
            c[j] += v;
        }
    }

    long long cur = 0;
    for (int j = 0; j < s; ++j) cur += c[j];
    long long best = cur;

    const int limit = n - s;
    for (int j = 1; j <= limit; ++j) {
        cur += c[j + s - 1] - c[j - 1];
        if (cur > best) best = cur;
    }

    int* po = ring;
    int* pi = ring + (size_t)s * n;
    const int* endRing = ring + ringSize * (size_t)n;

    for (int i = 1; i <= limit; ++i) {
        int j = 0;
        for (; j + 3 < n; j += 4) {
            int v0 = fs.nextInt();
            int v1 = fs.nextInt();
            int v2 = fs.nextInt();
            int v3 = fs.nextInt();

            pi[j] = v0;
            c[j] += (long long)v0 - po[j];
            pi[j+1] = v1;
            c[j+1] += (long long)v1 - po[j+1];
            pi[j+2] = v2;
            c[j+2] += (long long)v2 - po[j+2];
            pi[j+3] = v3;
            c[j+3] += (long long)v3 - po[j+3];
        }
        for (; j < n; ++j) {
            int v = fs.nextInt();
            pi[j] = v;
            c[j] += (long long)v - po[j];
        }

        cur = 0;
        for (int k = 0; k < s; ++k) cur += c[k];
        if (cur > best) best = cur;

        for (int jj = 1; jj <= limit; ++jj) {
            cur += c[jj + s - 1] - c[jj - 1];
            if (cur > best) best = cur;
        }

        po += n;
        if (po == endRing) po = ring;
        pi += n;
        if (pi == endRing) pi = ring;
    }

    std::printf("%lld\n", (long long)best);
    return 0;
}

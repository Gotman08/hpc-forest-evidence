  "blocking_findings": [
    {
      "id": "RESTORE-01",
      "priority": 1,
      "line": 33,
      "related_line": 155,
      "finding": "Path.absolute does not normalize parent components, whereas is_relative_to is lexical. A Q/../outside path passes the Q boundary, and the analogous restoration path passes HERE.",
      "pure_path_observation": "(Q / '..' / 'outside-proof.json').absolute().is_relative_to(Q) is True, while its resolved parent equals Q.parent.",
      "effect": "The declared input/live-cache and restoration scope can be bypassed before a read or creation, independently of safe tar member-name checks.",
      "required_change": "Reject '..' before any filesystem read; normalize the argument and enforce the real Q/HERE boundary with alias checks before reading or creating. Preserve the original file and implement a newly versioned reader."
    },
    {
      "id": "RESTORE-02",
      "priority": 2,
      "line": 158,
      "related_line": 150,
      "finding": "The archive is read and hashed as archive_raw, then tarfile.open(args.archive) opens the pathname again. The parsed archive is not the same held bytes that were authenticated.",
      "effect": "A path replacement between those operations breaks the archive SHA-to-parser binding; the final pathname rehash is not a held-file identity proof.",
      "required_change": "Parse the already authenticated archive_raw through io.BytesIO, or use one held descriptor whose identity and bytes remain checked throughout."
    },
    {
      "id": "RESTORE-03",
      "priority": 2,
      "line": 45,
      "related_line": 54,
      "finding": "ordinary checks aliases, then raw uses stat/read_bytes/stat by pathname. A link/reparse replacement after ordinary may be followed; no fstat binds the file actually read to the observed ordinary file.",
      "effect": "Input race checks cover only later pathname size/mtime/inode, not the identity and type of the open file or the unchanged alias-free parent chain.",
      "required_change": "Open once, compare fstat to the expected lstat before/after the held read, compare dev/ino/mode/nlink/size/mtime_ns/ctime_ns, and recheck the path/parents. Keep output creation exclusively in newly owned alias-free directories."
    }
  ],
  "positive_static_checks": [
    "Tar member names reject traversal, absolute paths, backslashes, ADS/colon, trailing Windows spaces/dots and reserved device components.",
    "Tar headers must be regular, and links/directories/special types are rejected. Duplicate and case-colliding names, file-as-parent conflicts, unexpected members and size/count bounds are checked.",
    "The five sidecars are linked by receipt SHA/size, complete source before/after inventories must match, and link targets remain JSON metadata only.",
    "Restored regular hashes are compared to the announced map and the previous received regular files. No extract/extractall or execution/import of received code occurs.",
    "The reader explicitly leaves remote SHA evidence and complete Q/native admission to separate actual receipts."
  ],

from pathlib import Path,PurePosixPath
import json,tarfile,hashlib,shutil,time
D=Path("outputs/HPC-Forest-Etude-2020-2024-r1/receptions/interruption-volontaire-sol-xhigh-751571/transfert-archive-allouee-r1").resolve()
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
a=D/"results-751571-interruption-volontaire.tar.gz"; m=D/"SNAPSHOT-MANIFEST.json"
assert sha(a)=="fe0621c5934b302b6f1c9abc2bf782939b595769b59e3f7fabb401f1e0837e0e"
assert sha(m)=="74a202f96038e9c426b326530daa59b7495264f2570313ed108b193eb39a6a86"
manifest=json.loads(m.read_text());assert manifest["before"]==manifest["after_source_packaging"] and manifest["all_source_entries_unchanged"] is True
entries=manifest["before"]
assert manifest["source_job"]=="751571" or str(manifest["source_job"])=="751571"
assert manifest["source_job_complete"] is False
expected={k:{"bytes":v["bytes"],"sha256":v["sha256"]} for k,v in entries.items() if v["type"]=="file"}
out=D/"restauration-neuve-r2";out.mkdir(exist_ok=False);names=set()
with tarfile.open(a,"r:gz") as tar:
 for member in tar.getmembers():
  if member.name=="SNAPSHOT-MANIFEST.json":
   assert member.name not in names and member.isfile();names.add(member.name)
   assert tar.extractfile(member).read()==m.read_bytes()
   continue
  rel=PurePosixPath(member.name)
  assert not rel.is_absolute() and rel.parts[0]=="results-751571" and ".." not in rel.parts and "\\" not in member.name
  assert member.name not in names;names.add(member.name)
  assert member.isdir() or member.isfile(),("Unsupported entry",member.name)
  dest=out.joinpath(*rel.parts)
  assert dest.resolve().is_relative_to(out)
  if member.isdir():dest.mkdir(parents=True,exist_ok=True)
  else:
   dest.parent.mkdir(parents=True,exist_ok=True)
   with tar.extractfile(member) as inp,dest.open("xb") as target:shutil.copyfileobj(inp,target)
   assert dest.stat().st_size==member.size
root=out/"results-751571"
actual={p.relative_to(root).as_posix():{"bytes":p.stat().st_size,"sha256":sha(p)} for p in root.rglob("*") if p.is_file()}
assert actual==expected
normalized={"files":expected,"raw_manifest_sha256":sha(m),"source_complete":False}
(D/"MANIFESTE-DISTANT-FICHIERS.json").write_text(json.dumps(normalized,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
proof={"schema":"hpc-forest-partial-raw-archive-received-v1","verified":True,"job_id":"751571","received_at":time.time(),"archive_sha256":sha(a),"three_archive_sha256_identical":True,"raw_manifest_sha256":sha(m),"source_entries_unchanged_before_after":True,"restored_files":len(actual),"restored_bytes":sum(v["bytes"] for v in actual.values()),"restoration_new":True,"source_complete":False,"scientific_full_cohort_admitted":False,"remote_root":str(root),"normalized_manifest":str(D/"MANIFESTE-DISTANT-FICHIERS.json"),"normalized_manifest_sha256":sha(D/"MANIFESTE-DISTANT-FICHIERS.json"),"candidate_executed":False,"model_calls":0}
(D/"restauration-verifiee.json").write_text(json.dumps(proof,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
print(json.dumps(proof))

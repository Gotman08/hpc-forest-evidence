  "files": [
    {
      "content": "/*\n    This program solves Laplace's equation on a regular 2D grid using simple Jacobi iteration.\n\n    The stencil calculation stops when  ( err >= CONV_THRESHOLD OR  iter > ITER_MAX )\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <time.h>\n#include <sys/time.h>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\n#define CONV_THRESHOLD 1.0e-5f // threshold of convergence\n\n// matrix to be solved\ndouble **grid;\n\n// auxiliary matrix\ndouble **new_grid;\n\n// size of each side of the grid\nint size;\nint iter_max_num;\n\n// return the absolute value of a number\ndouble absolute(double num){\n    if(num < 0)\n        return -1.0 * num;\n    return num;\n}\n\n\n// allocate memory for the grid\nvoid allocate_memory(){\n    grid = (double **) malloc(size * sizeof(double *));\n    new_grid = (double **) malloc(size * sizeof(double *));\n\n    for(int i = 0; i < size; i++){\n        grid[i] = (double *) malloc(size * sizeof(double));\n        new_grid[i] = (double *) malloc(size * sizeof(double));\n    }\n}\n\n// initialize the grid\nvoid initialize_grid(){\n    int center = size / 2;\n    int linf = center - (size / 10);\n    int lsup = center + (size / 10);\n    for (int i = 0; i < size; i++){\n        for (int j = 0; j < size; j++){\n            // inicializa região de calor no centro do grid\n            if ( i >= linf && i <= lsup && j >= linf && j <= lsup)\n                grid[i][j] = 100;\n            else\n                grid[i][j] = 0;\n            new_grid[i][j] = 0.0;\n        }\n    }\n}\n\n// save the grid in a file\nvoid save_grid(){\n\n    for(int i = 0; i < size; i++){\n        for(int j = 0; j < size; j++){\n            fprintf(stdout, \"%lf \", grid[i][j]);\n        }\n        fprintf(stdout, \"\\n\");\n    }\n}\n\nint main(int argc, char *argv[]){\n\n    fscanf(stdin, \"%d\", &size);\n    fscanf(stdin, \"%d\", &iter_max_num);\n    \n    int hasError = 1;\n    int iter = 0;\n\n    struct timeval time_start;\n    struct timeval time_end;\n\n    // allocate memory to the grid (matrix)\n    allocate_memory();\n\n    // set grid initial conditions\n    initialize_grid();\n\n    //printf(\"Jacobi relaxation calculation: %d x %d grid\\n\", size, size);\n\n    // get the start time\n    //gettimeofday(&time_start, NULL);\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const float64x2_t convergence_threshold =\n        vdupq_n_f64((double)CONV_THRESHOLD);\n#endif\n\n    // Jacobi iteration\n    // This loop will end if either the maximum change reaches below a set threshold (convergence)\n    // or a fixed number of maximum iterations have completed\n    while ( hasError && iter < iter_max_num ) {\n\n        hasError = 0;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n        uint64x2_t changed0 = vdupq_n_u64(0);\n        uint64x2_t changed1 = vdupq_n_u64(0);\n        uint64x2_t changed2 = vdupq_n_u64(0);\n        uint64x2_t changed3 = vdupq_n_u64(0);\n#endif\n        // calculates the Laplace equation to determine each cell's next value\n        for( int i = 1; i < size-1; i++) {\n            const double *restrict current = grid[i];\n            const double *restrict above = grid[i-1];\n            const double *restrict below = grid[i+1];\n            double *restrict output = new_grid[i];\n            int j = 1;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n            // Four independent SIMD chains share horizontal-neighbor loads.\n            // Each lane retains the original left-to-right addition order.\n            for(; j < size-8; j += 8) {\n                const float64x2_t horizontal0 = vld1q_f64(current + j - 1);\n                const float64x2_t horizontal1 = vld1q_f64(current + j + 1);\n                const float64x2_t horizontal2 = vld1q_f64(current + j + 3);\n                const float64x2_t horizontal3 = vld1q_f64(current + j + 5);\n                const float64x2_t horizontal4 = vld1q_f64(current + j + 7);\n\n                float64x2_t value0 = vaddq_f64(horizontal1, horizontal0);\n                float64x2_t value1 = vaddq_f64(horizontal2, horizontal1);\n                float64x2_t value2 = vaddq_f64(horizontal3, horizontal2);\n                float64x2_t value3 = vaddq_f64(horizontal4, horizontal3);\n\n                value0 = vaddq_f64(value0, vld1q_f64(above + j));\n                value1 = vaddq_f64(value1, vld1q_f64(above + j + 2));\n                value2 = vaddq_f64(value2, vld1q_f64(above + j + 4));\n                value3 = vaddq_f64(value3, vld1q_f64(above + j + 6));\n\n                value0 = vaddq_f64(value0, vld1q_f64(below + j));\n                value1 = vaddq_f64(value1, vld1q_f64(below + j + 2));\n                value2 = vaddq_f64(value2, vld1q_f64(below + j + 4));\n                value3 = vaddq_f64(value3, vld1q_f64(below + j + 6));\n\n                value0 = vmulq_n_f64(value0, 0.25);\n                value1 = vmulq_n_f64(value1, 0.25);\n                value2 = vmulq_n_f64(value2, 0.25);\n                value3 = vmulq_n_f64(value3, 0.25);\n\n                vst1q_f64(output + j, value0);\n                vst1q_f64(output + j + 2, value1);\n                vst1q_f64(output + j + 4, value2);\n                vst1q_f64(output + j + 6, value3);\n\n                const float64x2_t error0 =\n                    vabsq_f64(vsubq_f64(value0, vld1q_f64(current + j)));\n                const float64x2_t error1 =\n                    vabsq_f64(vsubq_f64(value1, vld1q_f64(current + j + 2)));\n                const float64x2_t error2 =\n                    vabsq_f64(vsubq_f64(value2, vld1q_f64(current + j + 4)));\n                const float64x2_t error3 =\n                    vabsq_f64(vsubq_f64(value3, vld1q_f64(current + j + 6)));\n\n                changed0 = vorrq_u64(changed0,\n                                      vcgtq_f64(error0, convergence_threshold));\n                changed1 = vorrq_u64(changed1,\n                                      vcgtq_f64(error1, convergence_threshold));\n                changed2 = vorrq_u64(changed2,\n                                      vcgtq_f64(error2, convergence_threshold));\n                changed3 = vorrq_u64(changed3,\n                                      vcgtq_f64(error3, convergence_threshold));\n            }\n            for(; j < size-2; j += 2) {\n                float64x2_t value = vaddq_f64(vld1q_f64(current + j + 1),\n                                             vld1q_f64(current + j - 1));\n                value = vaddq_f64(value, vld1q_f64(above + j));\n                value = vaddq_f64(value, vld1q_f64(below + j));\n                value = vmulq_n_f64(value, 0.25);\n                vst1q_f64(output + j, value);\n\n                const float64x2_t error =\n                    vabsq_f64(vsubq_f64(value, vld1q_f64(current + j)));\n                changed0 = vorrq_u64(changed0,\n                                      vcgtq_f64(error, convergence_threshold));\n            }\n#endif\n            for(; j < size-1; j++) {\n                output[j] = 0.25 * (current[j+1] + current[j-1] +\n                                    above[j] + below[j]);\n\n                double errorCurrent = absolute(output[j] - current[j]);\n                hasError |= (errorCurrent > CONV_THRESHOLD);\n            }\n        }\n#if defined(__aarch64__) && defined(__ARM_NEON)\n        const uint64x2_t changed =\n            vorrq_u64(vorrq_u64(changed0, changed1),\n                      vorrq_u64(changed2, changed3));\n        hasError |= ((vgetq_lane_u64(changed, 0) |\n                      vgetq_lane_u64(changed, 1)) != 0);\n#endif\n        // copie the next values into the working array for the next iteration\n        for( int i = 1; i < size-1; i++) {\n            double *restrict destination = grid[i];\n            const double *restrict source = new_grid[i];\n            for( int j = 1; j < size-1; j++) {\n                destination[j] = source[j];\n            }\n        }\n        iter++;\n    }\n\n    // get the end time\n    //gettimeofday(&time_end, NULL);\n\n    //double exec_time = (double) (time_end.tv_sec - time_start.tv_sec) +\n    //                   (double) (time_end.tv_usec - time_start.tv_usec) / 1000000.0;\n\n    //save the final grid in file\n    save_grid();\n\n    //printf(\"\\nKernel executed in %lf seconds with %d iterations.\\n\", exec_time, iter);\n\n    return 0;\n}\n",
      "path": "src/laplace_seq.c"
    }
  ],
  "hypothesis": "Four-way NEON unrolling with shared horizontal-neighbor loads and independent convergence masks should reduce load and loop overhead while exposing more instruction-level parallelism.",
  "notes": "Preserves per-cell arithmetic order, threshold semantics, cleanup paths, copying, and output. No commands or measurements performed.",

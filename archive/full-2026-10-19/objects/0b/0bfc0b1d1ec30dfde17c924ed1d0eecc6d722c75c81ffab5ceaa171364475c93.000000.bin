{"files":[{"content":"#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdint.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n#define TARGET_PACKET 8\n#define PAIR_TILE 48\n\n/* Binary input/output layout is unchanged. */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nstatic void body_force_scalar_range(Body *p, float dt, int n,\n                                    int begin, int end) {\n  for (int i = begin; i < end; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; ++j) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/* Squared distances cannot be negative; retain sqrt and division precision. */\n#if defined(__GNUC__) && !defined(__clang__)\n#define TILE_ATTRIBUTES __attribute__((noinline, optimize(\"no-math-errno\")))\n#else\n#define TILE_ATTRIBUTES\n#endif\n\n#if defined(__GNUC__) || defined(__clang__)\n#define HAVE_FORCE_VECTORS 1\ntypedef float ForceVector __attribute__((vector_size(16)));\n\nstatic inline ForceVector load_vector(const float *p) {\n  ForceVector value;\n  memcpy(&value, p, sizeof(value));\n  return value;\n}\n\nstatic inline void store_vector(float *p, ForceVector value) {\n  memcpy(p, &value, sizeof(value));\n}\n\nstatic inline ForceVector broadcast_vector(float value) {\n  return (ForceVector){value, value, value, value};\n}\n#endif\n\n/* Keep both tile orientations contiguous for target-vector accumulation. */\nstatic inline void transpose_coefficients(\n    const float src[PAIR_TILE][PAIR_TILE],\n    float dst[PAIR_TILE][PAIR_TILE], int rows, int cols) {\n#if defined(__GNUC__) && !defined(__clang__)\n  typedef int ShuffleMask __attribute__((vector_size(16)));\n  const int full_rows = rows - rows % 4;\n  const int full_cols = cols - cols % 4;\n\n  for (int i = 0; i < full_rows; i += 4) {\n    for (int j = 0; j < full_cols; j += 4) {\n      ForceVector r0 = load_vector(&src[i][j]);\n      ForceVector r1 = load_vector(&src[i + 1][j]);\n      ForceVector r2 = load_vector(&src[i + 2][j]);\n      ForceVector r3 = load_vector(&src[i + 3][j]);\n      ForceVector t0 = __builtin_shuffle(r0, r1,\n                                        (ShuffleMask){0, 4, 1, 5});\n      ForceVector t1 = __builtin_shuffle(r0, r1,\n                                        (ShuffleMask){2, 6, 3, 7});\n      ForceVector t2 = __builtin_shuffle(r2, r3,\n                                        (ShuffleMask){0, 4, 1, 5});\n      ForceVector t3 = __builtin_shuffle(r2, r3,\n                                        (ShuffleMask){2, 6, 3, 7});\n      store_vector(&dst[j][i],\n                   __builtin_shuffle(t0, t2, (ShuffleMask){0, 1, 4, 5}));\n      store_vector(&dst[j + 1][i],\n                   __builtin_shuffle(t0, t2, (ShuffleMask){2, 3, 6, 7}));\n      store_vector(&dst[j + 2][i],\n                   __builtin_shuffle(t1, t3, (ShuffleMask){0, 1, 4, 5}));\n      store_vector(&dst[j + 3][i],\n                   __builtin_shuffle(t1, t3, (ShuffleMask){2, 3, 6, 7}));\n    }\n  }\n\n  for (int i = 0; i < rows; ++i) {\n    int first = i < full_rows ? full_cols : 0;\n    for (int j = first; j < cols; ++j) {\n      dst[j][i] = src[i][j];\n    }\n  }\n#else\n  for (int i = 0; i < rows; ++i) {\n    for (int j = 0; j < cols; ++j) {\n      dst[j][i] = src[i][j];\n    }\n  }\n#endif\n}\n\n/* Coefficients are indexed by source, then target. No source reduction. */\nstatic void accumulate_panel(\n    float *restrict fx, float *restrict fy, float *restrict fz,\n    const float *restrict x, const float *restrict y,\n    const float *restrict z,\n    int target_first, int target_count, int source_first, int source_count,\n    const float coefficients[PAIR_TILE][PAIR_TILE]) {\n  int q = 0;\n#if defined(HAVE_FORCE_VECTORS)\n  for (; q + TARGET_PACKET <= target_count; q += TARGET_PACKET) {\n    const int t = target_first + q;\n    const ForceVector tx0 = load_vector(x + t);\n    const ForceVector ty0 = load_vector(y + t);\n    const ForceVector tz0 = load_vector(z + t);\n    const ForceVector tx1 = load_vector(x + t + 4);\n    const ForceVector ty1 = load_vector(y + t + 4);\n    const ForceVector tz1 = load_vector(z + t + 4);\n    ForceVector ax0 = load_vector(fx + t);\n    ForceVector ay0 = load_vector(fy + t);\n    ForceVector az0 = load_vector(fz + t);\n    ForceVector ax1 = load_vector(fx + t + 4);\n    ForceVector ay1 = load_vector(fy + t + 4);\n    ForceVector az1 = load_vector(fz + t + 4);\n\n    for (int k = 0; k < source_count; ++k) {\n      const int s = source_first + k;\n      const ForceVector sx = broadcast_vector(x[s]);\n      const ForceVector sy = broadcast_vector(y[s]);\n      const ForceVector sz = broadcast_vector(z[s]);\n      const ForceVector c0 = load_vector(coefficients[k] + q);\n      const ForceVector c1 = load_vector(coefficients[k] + q + 4);\n      const ForceVector dx0 = sx - tx0;\n      const ForceVector dy0 = sy - ty0;\n      const ForceVector dz0 = sz - tz0;\n      const ForceVector dx1 = sx - tx1;\n      const ForceVector dy1 = sy - ty1;\n      const ForceVector dz1 = sz - tz1;\n\n      ax0 += dx0 * c0;\n      ay0 += dy0 * c0;\n      az0 += dz0 * c0;\n      ax1 += dx1 * c1;\n      ay1 += dy1 * c1;\n      az1 += dz1 * c1;\n    }\n\n    store_vector(fx + t, ax0);\n    store_vector(fy + t, ay0);\n    store_vector(fz + t, az0);\n    store_vector(fx + t + 4, ax1);\n    store_vector(fy + t + 4, ay1);\n    store_vector(fz + t + 4, az1);\n  }\n#endif\n\n  for (; q < target_count; ++q) {\n    const int t = target_first + q;\n    const float px = x[t];\n    const float py = y[t];\n    const float pz = z[t];\n    float ax = fx[t];\n    float ay = fy[t];\n    float az = fz[t];\n\n    for (int k = 0; k < source_count; ++k) {\n      const int s = source_first + k;\n      float dx = x[s] - px;\n      float dy = y[s] - py;\n      float dz = z[s] - pz;\n      float inv_dist3 = coefficients[k][q];\n      ax += dx * inv_dist3;\n      ay += dy * inv_dist3;\n      az += dz * inv_dist3;\n    }\n\n    fx[t] = ax;\n    fy[t] = ay;\n    fz[t] = az;\n  }\n}\n\nstatic TILE_ATTRIBUTES void body_force_pair(\n    float *restrict fx, float *restrict fy, float *restrict fz,\n    const float *restrict x, const float *restrict y,\n    const float *restrict z, int n, int block_a, int block_b) {\n  _Alignas(64) float coefficients[PAIR_TILE][PAIR_TILE];\n  _Alignas(64) float transposed[PAIR_TILE][PAIR_TILE];\n  const int first_a = block_a * PAIR_TILE;\n  const int first_b = block_b * PAIR_TILE;\n  int count_a = n - first_a;\n  int count_b = n - first_b;\n  if (count_a > PAIR_TILE) count_a = PAIR_TILE;\n  if (count_b > PAIR_TILE) count_b = PAIR_TILE;\n\n  for (int i = 0; i < count_a; ++i) {\n    const float px = x[first_a + i];\n    const float py = y[first_a + i];\n    const float pz = z[first_a + i];\n    #pragma omp simd\n    for (int j = 0; j < count_b; ++j) {\n      float dx = x[first_b + j] - px;\n      float dy = y[first_b + j] - py;\n      float dz = z[first_b + j] - pz;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n      coefficients[i][j] = inv_dist3;\n    }\n  }\n\n  transpose_coefficients(coefficients, transposed, count_a, count_b);\n  accumulate_panel(fx, fy, fz, x, y, z,\n                   first_a, count_a, first_b, count_b, transposed);\n  if (block_a != block_b) {\n    accumulate_panel(fx, fy, fz, x, y, z,\n                     first_b, count_b, first_a, count_a, coefficients);\n  }\n}\n\nvoid body_force(Body *p, float dt, int n) {\n  if (n < TARGET_PACKET) {\n    body_force_scalar_range(p, dt, n, 0, n);\n    return;\n  }\n\n  /* Align every plane and tile boundary to a cache line. */\n  const size_t stride = ((size_t)n + 15u) & ~(size_t)15u;\n  if (stride > ((size_t)-1 - 63u) / (6 * sizeof(float))) {\n    body_force_scalar_range(p, dt, n, 0, n);\n    return;\n  }\n  const size_t bytes = stride * 6 * sizeof(float);\n  void *allocation = malloc(bytes + 63u);\n  if (allocation == NULL) {\n    body_force_scalar_range(p, dt, n, 0, n);\n    return;\n  }\n\n  float *work = (float *)(((uintptr_t)allocation + 63u) & ~(uintptr_t)63u);\n  float *x = work;\n  float *y = x + stride;\n  float *z = y + stride;\n  float *fx = z + stride;\n  float *fy = fx + stride;\n  float *fz = fy + stride;\n  const int ntiles = (n - 1) / PAIR_TILE + 1;\n\n  #pragma omp parallel if(ntiles > 1)\n  {\n    #pragma omp for schedule(static)\n    for (int i = 0; i < n; ++i) {\n      x[i] = p[i].x;\n      y[i] = p[i].y;\n      z[i] = p[i].z;\n      fx[i] = 0.0f;\n      fy[i] = 0.0f;\n      fz[i] = 0.0f;\n    }\n\n    /* At wave a+b, each block meets exactly its next source block.\n       Distinct pairs within a wave have disjoint force destinations. */\n    for (int wave = 0; wave < 2 * ntiles - 1; ++wave) {\n      int first = wave - (ntiles - 1);\n      if (first < 0) first = 0;\n      int last = wave / 2;\n      if (last >= ntiles) last = ntiles - 1;\n\n      #pragma omp for schedule(static)\n      for (int a = first; a <= last; ++a) {\n        body_force_pair(fx, fy, fz, x, y, z, n, a, wave - a);\n      }\n    }\n\n    #pragma omp for schedule(static)\n    for (int i = 0; i < n; ++i) {\n      p[i].vx += dt*fx[i];\n      p[i].vy += dt*fy[i];\n      p[i].vz += dt*fz[i];\n    }\n  }\n\n  free(allocation);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n","path":"src/nbody.c"}],"hypothesis":"Dual-orientation 48×48 coefficient tiles and eight-target register packets should halve redundant distance calculations, keep scratch in L1, and reuse source loads while preserving source-ordered force sums.","notes":"Unmeasured proposal. Retains double-precision sqrt/division expressions, scalar allocation fallback, repeated-call independence, and unchanged binary I/O.","sources_kept":[],"transformations":["Use symmetric block pairs with an 18 KiB per-thread coefficient workspace containing both matrix orientations.","Transpose coefficients in 4×4 microtiles and accumulate eight independent targets using float vectors without horizontal reductions.","Process block pairs by increasing block-index sum, preserving source order and avoiding concurrent force-array conflicts.","Use cache-line-aligned, padded position and force planes, with one OpenMP team for initialization, tile processing, and velocity updates."]}
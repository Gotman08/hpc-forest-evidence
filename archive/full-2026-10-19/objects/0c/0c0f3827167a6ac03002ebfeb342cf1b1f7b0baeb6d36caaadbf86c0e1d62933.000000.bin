#include <bits/stdc++.h>
#if defined(__aarch64__) && defined(__ARM_NEON)
#include <arm_neon.h>
#endif

using namespace std;

int A[1000][1000];
int ps[1010][1010];

typedef long long ll;

namespace {
class PrefixFrequencyTable {
  vector<int32_t> keys_;
  vector<uint32_t> counts_;
  size_t group_mask_;

  static uint32_t mix(int32_t key) {
    uint32_t x = static_cast<uint32_t>(key);
    x ^= x >> 16;
    x *= 0x7feb352dU;
    x ^= x >> 15;
    x *= 0x846ca68bU;
    x ^= x >> 16;
    return x;
  }

  size_t find_slot(int32_t key) const {
    size_t group = static_cast<size_t>(mix(key)) & group_mask_;
#if defined(__aarch64__) && defined(__ARM_NEON)
    const int32x4_t needle = vdupq_n_s32(key);
    const uint32x4_t zero = vdupq_n_u32(0);
    const uint32x4_t lanes = {0u, 1u, 2u, 3u};
#endif
    for (;;) {
      const size_t base = group * 4;
#if defined(__aarch64__) && defined(__ARM_NEON)
      const uint32x4_t equal =
          vceqq_s32(vld1q_s32(keys_.data() + base), needle);
      const uint32x4_t empty =
          vceqq_u32(vld1q_u32(counts_.data() + base), zero);
      const uint32x4_t stop = vorrq_u32(equal, empty);
      // Non-candidate lanes become UINT32_MAX; choose the first candidate.
      const uint32_t lane = vminvq_u32(vornq_u32(lanes, stop));
      if (lane < 4)
        return base + lane;
#else
      for (size_t lane = 0; lane < 4; ++lane) {
        if (counts_[base + lane] == 0 || keys_[base + lane] == key)
          return base + lane;
      }
#endif
      group = (group + 1) & group_mask_;
    }
  }

public:
  explicit PrefixFrequencyTable(size_t max_prefixes) {
    size_t capacity = 4;
    while (capacity < 2 * max_prefixes)
      capacity <<= 1;
    // Keys remain initialized even when their counts mark them as empty.
    keys_.assign(capacity, 0);
    counts_.assign(capacity, 0);
    group_mask_ = capacity / 4 - 1;
  }

  void clear() {
    fill(counts_.begin(), counts_.end(), uint32_t(0));
  }

  uint32_t count(int32_t key) const {
    return counts_[find_slot(key)];
  }

  uint32_t increment(int32_t key) {
    const size_t slot = find_slot(key);
    const uint32_t previous = counts_[slot];
    if (previous == 0)
      keys_[slot] = key;
    counts_[slot] = previous + 1;
    return previous;
  }
};
}

ll solve(int m, int n, int k) {
  for (int i = 1; i <= m; i++) {
    ps[i][0] = 0;
    for (int j = 1; j <= n; j++) {
      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];
    }
  }

  PrefixFrequencyTable h(static_cast<size_t>(m) + 1);
  ll ans = 0;
  for (int j = 1; j <= n; j++) {
    for (int l = j; l <= n; l++) {
      h.clear();
      h.increment(0);
      int32_t s = 0;
      if (k == 0) {
        for (int i = 1; i <= m; i++) {
          s += ps[i][l] - ps[i][j - 1];
          // The old frequency excludes the current prefix.
          ans += h.increment(s);
        }
      } else {
        for (int i = 1; i <= m; i++) {
          s += ps[i][l] - ps[i][j - 1];
          ans += h.count(s - k);
          h.increment(s);
        }
      }
    }
  }
  return ans;
}

int main() {
  int k, m, n;
  cin >> k >> m >> n;
  memset(A, 0, sizeof A);
  memset(ps, 0, sizeof ps);

  for (int i = 0; i < m; i++)
    for (int j = 0; j < n; j++)
      cin >> A[i][j];

  cout << solve(m, n, k) << endl;
  return 0;
}

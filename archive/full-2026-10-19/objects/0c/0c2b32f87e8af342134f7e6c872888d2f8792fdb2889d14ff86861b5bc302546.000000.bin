      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <assert.h>\n#include <string.h>\n#include <stdint.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nstatic void merge_slices(const char *strings, size_t stride,\n                         const long int *restrict src,\n                         long int *restrict dst,\n                         long int left, long int left_end,\n                         long int right, long int right_end,\n                         long int out) {\n   /* Selection remains sequential within each independent output slice. */\n   while (left < left_end && right < right_end) {\n      long int li = src[left];\n      long int ri = src[right];\n      if (strcmp(strings + (size_t)li * stride,\n                 strings + (size_t)ri * stride) <= 0) {\n         dst[out++] = li;\n         ++left;\n      } else {\n         dst[out++] = ri;\n         ++right;\n      }\n   }\n\n   if (left < left_end) {\n      memcpy(dst + out, src + left,\n             (size_t)(left_end - left) * sizeof(*dst));\n   } else if (right < right_end) {\n      memcpy(dst + out, src + right,\n             (size_t)(right_end - right) * sizeof(*dst));\n   }\n}\n\nstatic void merge_runs(const char *strings, size_t stride,\n                       const long int *restrict src,\n                       long int *restrict dst,\n                       long int begin, long int middle, long int end) {\n   if (middle == end ||\n       strcmp(strings + (size_t)src[middle - 1] * stride,\n              strings + (size_t)src[middle] * stride) <= 0) {\n      memcpy(dst + begin, src + begin,\n             (size_t)(end - begin) * sizeof(*dst));\n      return;\n   }\n\n   merge_slices(strings, stride, src, dst,\n                begin, middle, middle, end, begin);\n}\n\n/* Number of left-run elements in a stable merged prefix of length rank. */\nstatic long int merge_corank(const char *strings, size_t stride,\n                             const long int *src,\n                             long int begin, long int middle, long int end,\n                             long int rank) {\n   long int left_count = middle - begin;\n   long int right_count = end - middle;\n   long int low = rank > right_count ? rank - right_count : 0;\n   long int high = rank < left_count ? rank : left_count;\n\n   while (low < high) {\n      long int take_left = low + (high - low) / 2;\n      long int take_right = rank - take_left;\n\n      /* Here take_left < left_count and 0 < take_right <= right_count.\n         Equality takes the left element first, matching merge_slices. */\n      if (strcmp(strings + (size_t)src[begin + take_left] * stride,\n                 strings + (size_t)src[middle + take_right - 1] * stride) <= 0) {\n         low = take_left + 1;\n      } else {\n         high = take_left;\n      }\n   }\n   return low;\n}\n\nstatic void merge_partition(const char *strings, size_t stride,\n                            const long int *restrict src,\n                            long int *restrict dst,\n                            long int begin, long int middle, long int end,\n                            long int first, long int last) {\n   if (first == last)\n      return;\n\n   if (middle == end ||\n       strcmp(strings + (size_t)src[middle - 1] * stride,\n              strings + (size_t)src[middle] * stride) <= 0) {\n      memcpy(dst + begin + first, src + begin + first,\n             (size_t)(last - first) * sizeof(*dst));\n      return;\n   }\n\n   long int left_first = merge_corank(strings, stride, src,\n                                      begin, middle, end, first);\n   long int left_last = merge_corank(strings, stride, src,\n                                     begin, middle, end, last);\n\n   merge_slices(strings, stride, src, dst,\n                begin + left_first, begin + left_last,\n                middle + (first - left_first),\n                middle + (last - left_last), begin + first);\n}\n\nlong int* bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\n   long int *result;\n   long int *workspace;\n   size_t bytes;\n\n   (void)offset;\n   (void)nbuckets;\n\n   if (size <= 0)\n      return NULL;\n   if ((size_t)size > SIZE_MAX / sizeof(*result))\n      exit(EXIT_FAILURE);\n\n   bytes = (size_t)size * sizeof(*result);\n   result = (long int *)malloc(bytes);\n   if (result == NULL)\n      exit(EXIT_FAILURE);\n   if (size == 1) {\n      result[0] = 0;\n      return result;\n   }\n\n   workspace = (long int *)malloc(bytes);\n   if (workspace == NULL) {\n      free(result);\n      exit(EXIT_FAILURE);\n   }\n\n#ifdef _OPENMP\n#pragma omp parallel if (size >= 32768)\n#endif\n   {\n      long int *src = result;\n      long int *dst = workspace;\n      long int workers = 1;\n#ifdef _OPENMP\n      workers = (long int)omp_get_num_threads();\n#endif\n\n#if defined(_OPENMP) && _OPENMP >= 201307\n#pragma omp for simd schedule(static)\n#elif defined(_OPENMP)\n#pragma omp for schedule(static)\n#endif\n      for (long int i = 0; i < size; ++i)\n         src[i] = i;\n\n      for (long int width = 1; width < size; ) {\n         /* Saturating the final step avoids signed doubling overflow. */\n         long int step = width > size - width ? size : width + width;\n         long int jobs = size / step + (size % step != 0);\n\n         if (jobs < workers) {\n            long int block_length = size / workers;\n            long int extra = size % workers;\n\n            /* Equal, disjoint output blocks keep late passes parallel.\n               Co-ranks identify each block's independent input slices. */\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n            for (long int block = 0; block < workers; ++block) {\n               long int out_begin = block * block_length +\n                                    (block < extra ? block : extra);\n               long int out_end = out_begin + block_length + (block < extra);\n               long int at = out_begin;\n\n               while (at < out_end) {\n                  long int begin = (at / step) * step;\n                  long int remaining = size - begin;\n                  long int middle = begin +\n                                    (width < remaining ? width : remaining);\n                  long int end = begin +\n                                 (step < remaining ? step : remaining);\n                  long int limit = end < out_end ? end : out_end;\n\n                  merge_partition(a, (size_t)length, src, dst,\n                                  begin, middle, end,\n                                  at - begin, limit - begin);\n                  at = limit;\n               }\n            }\n         } else {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n            for (long int job = 0; job < jobs; ++job) {\n               long int begin = job * step;\n               long int remaining = size - begin;\n               long int middle = begin + (width < remaining ? width : remaining);\n               long int end = begin + (step < remaining ? step : remaining);\n               merge_runs(a, (size_t)length, src, dst, begin, middle, end);\n            }\n         }\n\n         /* Both worksharing paths publish the complete next pass. */\n         long int *tmp = src;\n         src = dst;\n         dst = tmp;\n         width = step;\n      }\n\n#ifdef _OPENMP\n#pragma omp single\n#endif\n      {\n         result = src;\n         workspace = dst;\n      }\n   }\n\n   free(workspace);\n   return result;\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb){\n   char *strings = NULL;\n   int      len,\n            offset,\n            nbucket;\n   long int n;\n\n   if (!fscanf(stdin, \"%d\", &len)) {\n      printf (\"ERROR len\\n\");\n      exit (1);\n   }\n\n   if (!fscanf(stdin, \"%ld\", &n)) {\n      printf (\"ERROR n\\n\");\n      exit (1);\n   }\n\n   if (!fscanf(stdin, \"%d\", &offset)) {\n      printf (\"ERROR offset\\n\");\n      exit (1);\n   }\n\n   if (!fscanf(stdin, \"%d\", &nbucket)) {\n      printf (\"ERROR nbucket\\n\");\n      exit (1);\n   }\n\n   nbucket = nbucket + 1;\n   len = len + 1;\n\n   strings = (char*) malloc(n * len);\n\n   for (long int i = 0; i < n; i++){\n      if (!fscanf(stdin, \"%s\", strings + (i * len))) {\n      printf (\"ERROR %ld\\n\",i);\n      exit (1);\n      }\n   }\n\n   *vString = strings;\n   *N = n;\n   *l = len;\n   *os = offset;\n   *nb = nbucket;\n}\n\nvoid print(char *strings, long int *index, long int n, int len){\n\n   for (long int i = 0; i < n; i++){\n      printf(\"%ld -> %s\\n\", i, strings + (index[i] * len));\n   }\n}\n\nvoid save(char *strings, long int *index, long int n, int len){\n   for (long int i = 0; i < n; i++){\n      printf(\"%s\\n\", strings + (index[i] * len));\n   }\n}\n\nint main(int ac, char **av) {\n\n   char     *strings = NULL;\n   long int N        = 0;\n   long int *index   = NULL;\n   int      len      = 0,\n            save2File = 0,\n            offset,\n            nbuckets;\n\n   load(&strings, &N, &len, &offset, &nbuckets);\n\n   index = bucket_sort(strings, len, N, offset, nbuckets);\n\n   save(strings, index, N, len);\n\n   if (strings != NULL)\n      free(strings);\n\n   if (index != NULL)\n      free(index);\n\n   return EXIT_SUCCESS;\n}\n",
      "path": "src/bucketsort.c"
    }

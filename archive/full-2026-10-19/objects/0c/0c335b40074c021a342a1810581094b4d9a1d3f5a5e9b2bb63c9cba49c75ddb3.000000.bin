#include "knn.h"

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    // Flatten all points into contiguous arrays for sequential access
    int total_points = 0;
    for (int i = 0; i < n_groups; i++) {
        total_points += groups[i].length;
    }

    float *xs = (float *) malloc(total_points * sizeof(float));
    float *ys = (float *) malloc(total_points * sizeof(float));
    char *point_labels = (char *) malloc(total_points * sizeof(char));

    int idx = 0;
    for (int i = 0; i < n_groups; i++) {
        Group g = groups[i];
        for (int j = 0; j < g.length; j++) {
            xs[idx] = g.points[j].x;
            ys[idx] = g.points[j].y;
            point_labels[idx] = g.label;
            idx++;
        }
    }

    // Packed top-k array for better spatial locality during shifts
    typedef struct {
        float dist;
        char label;
    } DistLabel;

    DistLabel *top_k = (DistLabel *) malloc(k * sizeof(DistLabel));
    for (int i = 0; i < k; i++) {
        top_k[i].dist = -1.0f;
        top_k[i].label = -1;
    }

    // Distance computation with sequential memory access
    float px = to_evaluate.x;
    float py = to_evaluate.y;
    for (int i = 0; i < total_points; i++) {
        float dx = xs[i] - px;
        float dy = ys[i] - py;
        float d = dx * dx + dy * dy;

        // Insertion into sorted top-k list with packed struct shifts
        for (int x = 0; x < k; x++) {
            if (d < top_k[x].dist || top_k[x].dist == -1.0f) {
                int shift_count = k - x - 1;
                if (shift_count > 0) {
                    memmove(&top_k[x + 1], &top_k[x], shift_count * sizeof(DistLabel));
                }
                top_k[x].dist = d;
                top_k[x].label = point_labels[i];
                break;
            }
        }
    }

    // Frequency histogram over printable ASCII (0-255) to find mode
    int freq[256] = {0};
    for (int i = 0; i < k; i++) {
        unsigned char uc = (unsigned char) top_k[i].label;
        if (uc != 255) { // skip sentinel -1 which becomes 255
            freq[uc]++;
        }
    }

    char most_frequent = 0;
    int best_count = 0;
    for (int c = 32; c < 127; c++) { // printable ASCII range
        if (freq[c] > best_count) {
            best_count = freq[c];
            most_frequent = (char)c;
        }
    }

    free(xs);
    free(ys);
    free(point_labels);
    free(top_k);

    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();

    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

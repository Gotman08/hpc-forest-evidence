      "content": "#include \"knn.h\"\n#include <math.h>\n\nstatic char vote_labels(char * labels, int k) {\n    int i;\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nstatic char insertion_knn(int n_groups, Group * groups, int k,\n                          Point to_evaluate, char * labels,\n                          float * distances) {\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n\n                    distances[x] = d;\n                    labels[x] = g.label;\n\n                    break;\n                }\n            }\n        }\n    }\n\n    return vote_labels(labels, k);\n}\n\nstatic char reference_knn(int n_groups, Group * groups, int k,\n                          Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * (size_t) k);\n    float * distances = (float *) malloc(sizeof(float) * (size_t) k);\n    char answer = insertion_knn(n_groups, groups, k, to_evaluate, labels,\n                                distances);\n\n    free(distances);\n    free(labels);\n\n    return answer;\n}\n\nstatic inline int entry_is_worse(float first_distance, size_t first_order,\n                                 float second_distance, size_t second_order) {\n    return first_distance > second_distance ||\n           (first_distance == second_distance && first_order > second_order);\n}\n\nstatic void heap_sift_down(float * distances, size_t * orders, char * labels,\n                           size_t size, size_t root) {\n    float distance = distances[root];\n    size_t order = orders[root];\n    char label = labels[root];\n\n    while (root < size / 2) {\n        size_t child = root * 2 + 1;\n        size_t right = child + 1;\n\n        if (right < size &&\n            entry_is_worse(distances[right], orders[right],\n                           distances[child], orders[child])) {\n            child = right;\n        }\n\n        if (!entry_is_worse(distances[child], orders[child], distance, order)) {\n            break;\n        }\n\n        distances[root] = distances[child];\n        orders[root] = orders[child];\n        labels[root] = labels[child];\n        root = child;\n    }\n\n    distances[root] = distance;\n    orders[root] = order;\n    labels[root] = label;\n}\n\nstatic void heapify(float * distances, size_t * orders, char * labels,\n                    size_t size) {\n    size_t root = size / 2;\n\n    while (root != 0) {\n        root--;\n        heap_sift_down(distances, orders, labels, size, root);\n    }\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    size_t capacity;\n    size_t count;\n    size_t encounter;\n    size_t slot;\n    char * labels;\n    float * distances;\n    size_t * orders;\n    char answer;\n    int i, j;\n\n    if (k <= 0) {\n        return reference_knn(n_groups, groups, k, to_evaluate);\n    }\n\n    capacity = (size_t) k;\n    labels = (char *) malloc(sizeof(char) * capacity);\n    distances = (float *) malloc(sizeof(float) * capacity);\n    orders = (size_t *) malloc(sizeof(size_t) * capacity);\n\n    if (orders == NULL) {\n        answer = insertion_knn(n_groups, groups, k, to_evaluate, labels,\n                               distances);\n        free(distances);\n        free(labels);\n        return answer;\n    }\n\n    count = 0;\n    encounter = 0;\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            if (!isfinite(d)) {\n                free(orders);\n                answer = insertion_knn(n_groups, groups, k, to_evaluate,\n                                       labels, distances);\n                free(distances);\n                free(labels);\n                return answer;\n            }\n\n            if (count < capacity) {\n                distances[count] = d;\n                orders[count] = encounter;\n                labels[count] = g.label;\n                count++;\n\n                if (count == capacity) {\n                    heapify(distances, orders, labels, capacity);\n                }\n            } else if (d < distances[0]) {\n                distances[0] = d;\n                orders[0] = encounter;\n                labels[0] = g.label;\n                heap_sift_down(distances, orders, labels, capacity, 0);\n            }\n\n            encounter++;\n        }\n    }\n\n    if (count < capacity) {\n        for (slot = count; slot < capacity; slot++) {\n            labels[slot] = -1;\n        }\n    }\n\n    answer = vote_labels(labels, k);\n    free(orders);\n    free(distances);\n    free(labels);\n\n    return answer;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "A contiguous distance-hot max heap can replace cache-unfriendly full top-k scans and shifts, reducing selection work from O(points*k) to O(points log k) while preserving stable equal-distance membership.",
  "notes": "The heap carries encounter ordinals only to evict the later point on equal distances. Non-finite distances and unavailable ordinal storage use the original insertion path; qsort voting and partial-slot behavior are retained.",
  "sources_kept": [],
  "transformations": [
    "Replace the sorted insertion buffers with a bottom-up contiguous max heap whose root is the worst retained neighbor.",
    "Keep distance, encounter-order, and label data synchronized so equal-distance cutoff selection follows original global encounter order.",
    "Retain the original insertion implementation as a fallback and keep the original qsort-based label vote."
  ]
}

{
  "arch": "armgpu",
  "partition": "instant",
  "nodes": 1,
  "ntasks_per_node": 1,
  "cpus_per_task": 4,
  "mem_gb": 16,
  "gpus_per_node": 0,
  "time_limit": "03:00:00",
  "cpu_bind": "cores",
  "spack_packages": [],
  "name": "forest-primes-luna-max-r1b",
  "workdir": "/scratch_p/nimarano",
  "command": "set -euo pipefail\n[[ ${SLURM_JOB_ID:-} =~ ^[0-9]+$ ]] || { echo 'Existing owned Slurm allocation required' >&2; exit 70; }\n[[ ${SLURM_JOB_NUM_NODES:-} == 1 && ${SLURM_NTASKS:-} == 1 && ${SLURM_CPUS_PER_TASK:-} == 4 && ${SLURM_MEM_PER_NODE:-} == 16384 ]] || { echo 'Exact 1node/1task/4CPU/16Gi allocation required' >&2; exit 71; }\n[[ ${SLURM_RESTART_COUNT:-0} == 0 ]] || { echo 'No Slurm/native replay allowed' >&2; exit 72; }\nexport PYTHONDONTWRITEBYTECODE=1\nexport PYTHONUNBUFFERED=1\nexport OPENBLAS_NUM_THREADS=1\nexport OMP_NUM_THREADS=4\nsrun --nodes=1 --ntasks=1 --cpus-per-task=4 --cpu-bind=cores /scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python -I -B -u - <<'R2MAX_FIRST_NATIVE_LUNA_PREFLIGHT'\n\"\"\"Proposed allocated preflight only; this local file has never been executed.\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport os\nimport platform\nimport re\nimport shlex\nimport sys\nimport zipfile\nfrom datetime import UTC, datetime, timedelta\nfrom pathlib import Path\n\nSCOPE = \"hpc-forest-primes-native-max-r1\"\nSESSION = \"c8044062692149138d826d3f388a08ef\"\nSOURCE_SHA = \"3e290f835570a8746be3c52144932b8c6866564980fd858cf4c0495a7b1e68c5\"\nPLAN_SHA = \"54ffd49f4dc868085d22208f773c4b4883590b25251b5992232509a1dc197024\"\nRUNTIME_MANIFEST_SHA = \"093a48b13cea5361f971e38fdeb10bfea281ac0a256b2a8c7504c7cbec019756\"\nEXTRACTION = Path(\"/scratch_p/nimarano/hpc-forest-primes-native-contract-qualification-20261017-r1-1e17d198d5a2/extraction\")\nNATIVE_ROOT = Path(\"/scratch_p/nimarano/hpc-forest-primes-native-max-r1-c8044062692149138d826d3f388a08ef\")\nPYTHON = \"/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python\"\nSPACK_GCC = \"/zrtbeqke25s2vbqo4yrhsowjz7mg3pjf\"\nDEADLINE = datetime(2026, 10, 31, 23, tzinfo=UTC)\n\n\ndef require(value, message):\n    if not value:\n        raise RuntimeError(message)\n\n\ndef sha(path):\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\n\n# Refuse before Spack, native imports, directory creation, mailbox or model calls.\nenv = os.environ\nrequire(platform.system() == \"Linux\" and platform.machine().lower() in {\"aarch64\", \"arm64\"}, \"Own Linux ARM64 compute allocation required\")\nrequire(re.fullmatch(r\"[0-9]+\", env.get(\"SLURM_JOB_ID\", \"\")), \"Concrete allocated Slurm job required\")\nrequired = {\"SLURM_JOB_NUM_NODES\": \"1\", \"SLURM_NTASKS\": \"1\", \"SLURM_CPUS_PER_TASK\": \"4\", \"SLURM_MEM_PER_NODE\": \"16384\"}\nrequire(all(env.get(key) == value for key, value in required.items()), \"Exact 1-node/1-task/4-CPU/16384-MiB allocation required\")\nrequire(env.get(\"SLURM_RESTART_COUNT\", \"0\") == \"0\", \"Started native calls must never be replayed\")\nrequire(all(env.get(key, \"\") in {\"\", \"0\"} for key in (\"SLURM_GPUS\", \"SLURM_GPUS_PER_NODE\", \"SLURM_JOB_GPUS\", \"SLURM_STEP_GPUS\", \"CUDA_VISIBLE_DEVICES\")), \"Zero GPU allocation required\")\nrequire(hasattr(os, \"sched_getaffinity\"), \"Effective affinity must be observable\")\naffinity = sorted(os.sched_getaffinity(0))\nrequire(len(affinity) == 4, \"Exactly four effective CPUs required\")\nrequire(datetime.now(UTC) + timedelta(seconds=10800 + 10800) < DEADLINE, \"Exclusive deadline cannot fit 3-hour allocation plus 3-hour receipt/audit reserve\")\nrequire(not NATIVE_ROOT.exists() and not NATIVE_ROOT.is_symlink(), \"Fresh native root required; preserve any earlier attempt without replay\")\nrequire(Path(sys.executable).resolve() == Path(PYTHON).resolve(), \"Exact existing ARM64 Python required\")\nsource_zip = EXTRACTION / \"HPC-Forest-Primes-Natif-MAX-r1.zip\"\nplan_path = EXTRACTION / \"native-max-plan.json\"\nruntime_manifest = EXTRACTION / \"runtime-manifest-r2max.json\"\nfor path, expected in ((source_zip, SOURCE_SHA), (plan_path, PLAN_SHA), (runtime_manifest, RUNTIME_MANIFEST_SHA)):\n    require(path.is_file() and not path.is_symlink() and sha(path) == expected, \"Changed deployed r1b artifact: \" + path.name)\nproject = EXTRACTION / \"HPC-Forest\"\nrequire(project.is_dir() and not project.is_symlink(), \"Existing deployed project required\")\nexpected_files = json.loads(runtime_manifest.read_bytes())\nrequire(len(expected_files) == 99, \"Exact 99-member deployed source required\")\nlocal = {p.relative_to(project).as_posix(): p for p in project.rglob(\"*\") if p.is_file() and not any(part in {\"__pycache__\", \".ruff_cache\", \".pytest_cache\"} for part in p.relative_to(project).parts)}\nrequire(set(local) == set(expected_files) and all(not p.is_symlink() and sha(p) == expected_files[name] for name, p in local.items()), \"Deployed source membership or bytes changed\")\nwith zipfile.ZipFile(source_zip) as archive:\n    names = archive.namelist()\n    require(len(names) == len(set(names)) == 99, \"Source ZIP membership changed\")\n    require(all(name.startswith(\"HPC-Forest/\") and name.removeprefix(\"HPC-Forest/\") in local and archive.read(name) == local[name.removeprefix(\"HPC-Forest/\")].read_bytes() for name in names), \"Deployed source differs from exact r1b ZIP\")\nplan = json.loads(plan_path.read_bytes())\nrequire(plan.get(\"scope_id\") == SCOPE and plan.get(\"source_zip_sha256\") == SOURCE_SHA and plan.get(\"first_launch_model\") == \"gpt-6-luna\" and plan.get(\"first_launch_session_id\") == SESSION and plan.get(\"efforts\") == [\"max\"] and plan.get(\"automatic_extension\") is False, \"Exact Luna MAX first-launch plan required\")\nsys.path.insert(0, str(project / \"src\"))\nfrom hpc_forest.native_r2max import allocation_guard, verify_runtime\nallocation = allocation_guard()\nverify_runtime(source_zip)\nprint(json.dumps({\"schema\": \"hpc-forest-primes-r2max-native-allocated-preflight-v1\", \"scope_id\": SCOPE, \"session_id\": SESSION, \"model\": \"gpt-6-luna\", \"effort\": \"max\", \"mother_model\": \"gpt-6-luna\", \"mother_effort\": \"max\", \"allocation\": allocation, \"source_zip_sha256\": SOURCE_SHA, \"plan_sha256\": PLAN_SHA, \"source_files_verified\": 99, \"qualification_job_not_replayed\": \"751975\", \"spack_gcc_existing_hash\": SPACK_GCC, \"native_model_calls_before_wait\": 0, \"authorization_still_required\": True, \"utc\": datetime.now(UTC).isoformat()}), flush=True)\nWAIT_ARGV = ['/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python', '-I', '-B', '-u', '/scratch_p/nimarano/hpc-forest-primes-native-contract-qualification-20261017-r1-1e17d198d5a2/extraction/HPC-Forest/examples/marathon22/wait_r2max_authorization.py', '--root', '/scratch_p/nimarano/hpc-forest-primes-native-max-r1-c8044062692149138d826d3f388a08ef', '--authorization', '/scratch_p/nimarano/hpc-forest-primes-native-max-admission-c8044062692149138d826d3f388a08ef/authorization.json', '--authorization-ready', '/scratch_p/nimarano/hpc-forest-primes-native-max-admission-c8044062692149138d826d3f388a08ef/authorization-ready.json', '--wait-seconds', '600']\n# Load only an existing GCC after all allocation/source guards. No installation.\ncommand = \"set -euo pipefail\\nromeo_load_armgpu_env\\nspack load \" + shlex.quote(SPACK_GCC) + \"\\nexec \" + shlex.join(WAIT_ARGV)\nchild = {**env, \"PYTHONDONTWRITEBYTECODE\": \"1\", \"PYTHONUNBUFFERED\": \"1\", \"OPENBLAS_NUM_THREADS\": \"1\", \"MKL_NUM_THREADS\": \"1\", \"NUMEXPR_NUM_THREADS\": \"1\", \"OMP_NUM_THREADS\": \"4\", \"OMP_DYNAMIC\": \"FALSE\", \"OMP_PROC_BIND\": \"close\", \"OMP_PLACES\": \"cores\", \"CUDA_VISIBLE_DEVICES\": \"\"}\nos.execvpe(\"/bin/bash\", [\"/bin/bash\", \"-lc\", command], child)\nR2MAX_FIRST_NATIVE_LUNA_PREFLIGHT\n",
  "data_files": [
    "/scratch_p/nimarano/hpc-forest-primes-native-contract-qualification-20261017-r1-1e17d198d5a2/extraction/HPC-Forest-Primes-Natif-MAX-r1.zip",
    "/scratch_p/nimarano/hpc-forest-primes-native-contract-qualification-20261017-r1-1e17d198d5a2/extraction/native-max-plan.json",
    "/scratch_p/nimarano/hpc-forest-primes-native-contract-qualification-20261017-r1-1e17d198d5a2/extraction/runtime-manifest-r2max.json"
  ]
}

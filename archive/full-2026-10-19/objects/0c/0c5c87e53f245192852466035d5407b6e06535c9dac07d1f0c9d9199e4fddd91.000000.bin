      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdint.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\ntypedef struct { float x, y, z; } Force;\n\nstatic inline float inverse_cube(float dx, float dy, float dz) {\n  float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n  float inv_dist = 1 / sqrt(sqrd_dist);\n  float inv_dist3 = inv_dist * inv_dist * inv_dist;\n  return inv_dist3;\n}\n\nstatic Force ordered_force(const Body *p, int n, int i) {\n  Force f = {0.0f, 0.0f, 0.0f};\n  for (int j = 0; j < n; ++j) {\n    float dx = p[j].x - p[i].x;\n    float dy = p[j].y - p[i].y;\n    float dz = p[j].z - p[i].z;\n    float inv_dist3 = inverse_cube(dx, dy, dz);\n    f.x += dx * inv_dist3;\n    f.y += dy * inv_dist3;\n    f.z += dz * inv_dist3;\n  }\n  return f;\n}\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system.\n */\nvoid body_force(Body *p, float dt, int n) {\n  #pragma omp parallel for schedule(static)\n  for (int i = 0; i < n; ++i) {\n    Force f = ordered_force(p, n, i);\n    p[i].vx += dt*f.x;\n    p[i].vy += dt*f.y;\n    p[i].vz += dt*f.z;\n  }\n}\n\n/* The local accumulator belongs to i; the other accumulator belongs to j. */\nstatic inline void add_pair(const Body *restrict p,\n                            Force *restrict forces,\n                            int i, int j, Force *restrict local) {\n  float dx = p[j].x - p[i].x;\n  float dy = p[j].y - p[i].y;\n  float dz = p[j].z - p[i].z;\n  float inv_dist3 = inverse_cube(dx, dy, dz);\n\n  local->x += dx * inv_dist3;\n  local->y += dy * inv_dist3;\n  local->z += dz * inv_dist3;\n\n  /* Recompute directed differences to retain their signed-zero behavior. */\n  float reverse_dx = p[i].x - p[j].x;\n  float reverse_dy = p[i].y - p[j].y;\n  float reverse_dz = p[i].z - p[j].z;\n  forces[j].x += reverse_dx * inv_dist3;\n  forces[j].y += reverse_dy * inv_dist3;\n  forces[j].z += reverse_dz * inv_dist3;\n}\n\nstatic void diagonal_tile(const Body *p, Force *forces,\n                          int first, int last) {\n  for (int i = first; i < last; ++i) {\n    Force local = forces[i];\n\n    /* Lower-index sources have already contributed; retain the self term. */\n    float dx = p[i].x - p[i].x;\n    float dy = p[i].y - p[i].y;\n    float dz = p[i].z - p[i].z;\n    float inv_dist3 = inverse_cube(dx, dy, dz);\n    local.x += dx * inv_dist3;\n    local.y += dy * inv_dist3;\n    local.z += dz * inv_dist3;\n\n    for (int j = i + 1; j < last; ++j) {\n      add_pair(p, forces, i, j, &local);\n    }\n    forces[i] = local;\n  }\n}\n\nstatic void off_diagonal_tile(const Body *p, Force *forces,\n                              int first, int last,\n                              int other_first, int other_last) {\n  for (int i = first; i < last; ++i) {\n    Force local = forces[i];\n    for (int j = other_first; j < other_last; ++j) {\n      add_pair(p, forces, i, j, &local);\n    }\n    forces[i] = local;\n  }\n}\n\nstatic void simple_simulation(Body *p, int n) {\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    body_force(p, DT, n);\n    for (int i = 0; i < n; ++i) {\n      p[i].x += p[i].vx * DT;\n      p[i].y += p[i].vy * DT;\n      p[i].z += p[i].vz * DT;\n    }\n  }\n}\n\nstatic void simulate(Body *p, int n) {\n  if (n < 1024) {\n    simple_simulation(p, n);\n    return;\n  }\n\n  /* Keep at least sixteen tiles and amortize task costs on larger systems. */\n  int tile = n / 16;\n  tile -= tile % 16;\n  if (tile < 64) tile = 64;\n  if (tile > 128) tile = 128;\n  int ntiles = 1 + (n - 1) / tile;\n\n  void *force_storage = malloc((size_t)n * sizeof(Force) + 63);\n  unsigned char *tokens = (unsigned char *)calloc((size_t)ntiles, 1);\n  if (force_storage == NULL || tokens == NULL) {\n    free(force_storage);\n    free(tokens);\n    simple_simulation(p, n);\n    return;\n  }\n  Force *forces = (Force *)(((uintptr_t)force_storage + 63) & ~(uintptr_t)63);\n  int nonfinite = 0;\n\n  #pragma omp parallel shared(nonfinite)\n  {\n    for (int iter = 0; iter < N_ITER; ++iter) {\n      #pragma omp single\n      {\n        nonfinite = 0;\n      }\n\n      #pragma omp for schedule(static) reduction(|:nonfinite)\n      for (int i = 0; i < n; ++i) {\n        forces[i].x = 0.0f;\n        forces[i].y = 0.0f;\n        forces[i].z = 0.0f;\n        nonfinite |= (!isfinite(p[i].x) || !isfinite(p[i].y) ||\n                      !isfinite(p[i].z));\n      }\n\n      if (nonfinite) {\n        /* Do not share inverse distances when NaN payloads may differ. */\n        #pragma omp for schedule(static)\n        for (int i = 0; i < n; ++i) {\n          forces[i] = ordered_force(p, n, i);\n        }\n      } else {\n        #pragma omp single\n        {\n          /* Bound the number of live tasks to a linear-size row window. */\n          for (int row = 0; row < ntiles; row += 32) {\n            int row_end = ntiles - row < 32 ? ntiles : row + 32;\n            #pragma omp taskgroup\n            {\n              for (int block = row; block < row_end; ++block) {\n                const int first = block * tile;\n                const int last = n - first < tile ? n : first + tile;\n\n                /* Each tile's dependencies follow ascending source order. */\n                #pragma omp task firstprivate(first,last) shared(p,forces) depend(inout:tokens[block])\n                {\n                  diagonal_tile(p, forces, first, last);\n                }\n\n                for (int other = block + 1; other < ntiles; ++other) {\n                  const int other_first = other * tile;\n                  const int other_last = n - other_first < tile\n                                         ? n : other_first + tile;\n                  #pragma omp task firstprivate(first,last,other_first,other_last) shared(p,forces) depend(inout:tokens[block],tokens[other])\n                  {\n                    off_diagonal_tile(p, forces, first, last,\n                                      other_first, other_last);\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n\n      /* All position reads are finished before any position is updated. */\n      #pragma omp for schedule(static)\n      for (int i = 0; i < n; ++i) {\n        p[i].vx += DT*forces[i].x;\n        p[i].vy += DT*forces[i].y;\n        p[i].vz += DT*forces[i].z;\n        p[i].x += p[i].vx * DT;\n        p[i].y += p[i].vy * DT;\n        p[i].z += p[i].vz * DT;\n      }\n    }\n  }\n\n  free(tokens);\n  free(force_storage);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  simulate(bodies, nbodies);\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Dependency-ordered triangular OpenMP tasks can halve pair sqrt/divide work while preserving each body's accumulation order and avoiding panel-by-panel barriers.",
  "notes": "Unmeasured. Retains double-precision sqrt/division, self interactions, directed differences, and original-order fallbacks. No thread-count overrides.",

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stddef.h>

typedef struct {
   size_t length;
} string_info;

long int* bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {
   long int *returns;
   long int *scratch;
   long int *source;
   long int *destination;
   string_info *info;
   size_t max_length = 0;

   /* The original bucket ordering is the same as global bytewise ordering. */
   (void)offset;
   (void)nbuckets;
   if (size <= 0)
      return NULL;

   returns = (long int *)malloc(sizeof(long int) * (size_t)size);
   scratch = (long int *)malloc(sizeof(long int) * (size_t)size);
   info = (string_info *)malloc(sizeof(string_info) * (size_t)size);
   if (returns == NULL || scratch == NULL || info == NULL) {
      free(returns);
      free(scratch);
      free(info);
      return NULL;
   }

   for (long int i = 0; i < size; i++) {
      const char *token = a + (size_t)i * (size_t)length;
      info[i].length = strlen(token);
      if (info[i].length > max_length)
         max_length = info[i].length;
      returns[i] = i;
   }

   source = returns;
   destination = scratch;

   /* Stable LSD passes, with NUL padding so variable-length tokens sort like strcmp. */
   for (size_t position = max_length; position > 0; position--) {
      size_t counts[257] = {0};
      size_t byte_position = position - 1;

      for (long int i = 0; i < size; i++) {
         size_t index = (size_t)source[i];
         unsigned int digit = 0;
         if (byte_position < info[index].length) {
            const unsigned char *token = (const unsigned char *)
               (a + index * (size_t)length);
            digit = (unsigned int)token[byte_position] + 1U;
         }
         counts[digit]++;
      }

      size_t next = 0;
      for (size_t digit = 0; digit < 257; digit++) {
         size_t count = counts[digit];
         counts[digit] = next;
         next += count;
      }

      for (long int i = 0; i < size; i++) {
         size_t index = (size_t)source[i];
         unsigned int digit = 0;
         if (byte_position < info[index].length) {
            const unsigned char *token = (const unsigned char *)
               (a + index * (size_t)length);
            digit = (unsigned int)token[byte_position] + 1U;
         }
         destination[counts[digit]++] = source[i];
      }

      long int *tmp = source;
      source = destination;
      destination = tmp;
   }

   if (source != returns)
      memcpy(returns, source, sizeof(long int) * (size_t)size);

   free(scratch);
   free(info);
   return returns;
}

void load(char **vString, long int *N, int *l, int *os, int *nb){
   char *strings = NULL;
   int      len,
            offset,
            nbucket;
   long int n;

   if (!fscanf(stdin, "%d", &len)) {
      printf ("ERROR len\n");
      exit (1);
   }

   if (!fscanf(stdin, "%ld", &n)) {
      printf ("ERROR n\n");
      exit (1);
   }

   if (!fscanf(stdin, "%d", &offset)) {
      printf ("ERROR offset\n");
      exit (1);
   }

   if (!fscanf(stdin, "%d", &nbucket)) {
      printf ("ERROR nbucket\n");
      exit (1);
   }

   nbucket = nbucket + 1;
   len = len + 1;

   strings = (char*) malloc(n * len);

   for (int i = 0; i < n; i++){
      if (!fscanf(stdin, "%s", strings + (i * len))) {
      printf ("ERROR %d\n",i);
      exit (1);
      }
   }

   *vString = strings;
   *N = n;
   *l = len;
   *os = offset;
   *nb = nbucket;
}

void save(char *strings, long int *index, long int n, int len){
   for (int i = 0; i < n; i++){
      printf("%s\n", strings + (index[i] * len));
   }
}

int main(int ac, char **av) {

   char     *strings = NULL;
   long int N        = 0;
   long int *index   = NULL;
   int      len      = 0,
            save2File = 0,
            offset,
            nbuckets;

   load(&strings, &N, &len, &offset, &nbuckets);

   index = bucket_sort(strings, len, N, offset, nbuckets);

   save(strings, index, N, len);

   if (strings != NULL)
      free(strings);

   if (index != NULL)
      free(index);

   return EXIT_SUCCESS;
}

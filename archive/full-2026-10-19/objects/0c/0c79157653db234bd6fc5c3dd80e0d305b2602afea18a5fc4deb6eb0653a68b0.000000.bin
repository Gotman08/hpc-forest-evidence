#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>

#define MAXNUM 100
#define MAXSTR 50
#define MAXRESULTS 1000
#define MAXCANDIDATES (MAXNUM * MAXNUM)
#define ODD_SIEVE_SIZE 32768

char firstHalf[MAXNUM][MAXSTR];
char secondHalf[MAXNUM][MAXSTR];
char strToTest[MAXSTR];
long int result[MAXRESULTS];
int numPrimes=0;
static uint32_t candidates[MAXCANDIDATES];

static uint32_t integer_root(uint32_t value)
{
    uint32_t low = 0u;
    uint32_t high = 65536u;
    while (low + 1u < high) {
        uint32_t middle = low + (high - low) / 2u;
        if ((uint64_t)middle * middle <= value)
            low = middle;
        else
            high = middle;
    }
    return low;
}

static uint32_t inverse_odd(uint32_t divisor)
{
    /* The seed has five correct low bits; each step doubles them. */
    uint32_t inverse = (3u * divisor) ^ 2u;
    inverse *= 2u - divisor * inverse;
    inverse *= 2u - divisor * inverse;
    inverse *= 2u - divisor * inverse;
    return inverse;
}

static int collect_primes(uint32_t *values, int count, long int *primes)
{
    unsigned char composite[ODD_SIEVE_SIZE];
    uint32_t maximum = 0u;
    int active = 0;
    int found = 0;

    for (int k = 0; k < count; ++k) {
        uint32_t value = values[k];
        if (value == 2u) {
            primes[found++] = 2;
        } else if (value > 2u && (value & 1u) != 0u) {
            values[active++] = value;
            if (value > maximum)
                maximum = value;
        }
    }
    if (active == 0)
        return found;

    uint32_t limit = integer_root(maximum);
    memset(composite, 0, (size_t)(limit >> 1) + 1u);

    /* Reuse each prime divisor across the contiguous survivor array. */
    for (uint32_t divisor = 3u;
         divisor <= limit && active != 0;
         divisor += 2u) {
        if (composite[divisor >> 1] != 0)
            continue;

        uint32_t square = (uint32_t)((uint64_t)divisor * divisor);
        uint32_t step = divisor + divisor;
        for (uint32_t multiple = square; multiple <= limit; multiple += step)
            composite[multiple >> 1] = 1;

        int kept = 0;
        if (active < 8) {
            /* Avoid reciprocal setup when there is little work to share. */
            for (int k = 0; k < active; ++k) {
                uint32_t value = values[k];
                if (value < square)
                    primes[found++] = (long int)value;
                else if (value % divisor != 0u)
                    values[kept++] = value;
            }
        } else {
            uint32_t inverse = inverse_odd(divisor);
            uint32_t bound = UINT32_MAX / divisor;
            /* For odd d, d divides n iff (n * inverse mod 2^32) <= bound. */
            for (int k = 0; k < active; ++k) {
                uint32_t value = values[k];
                if (value < square)
                    primes[found++] = (long int)value;
                else if ((uint32_t)(value * inverse) > bound)
                    values[kept++] = value;
            }
        }
        active = kept;
    }

    for (int k = 0; k < active; ++k)
        primes[found++] = (long int)values[k];
    return found;
}

void quicksort(long int *primes, int first, int last)
{
    int i, j, pivot;
    long int temp;

    if (first < last) {
        pivot = first;
        i = first;
        j = last;
        while (i < j) {
            while (primes[i] <= primes[pivot] && i < last)
                i++;
            while (primes[j] > primes[pivot])
                j--;
            if (i < j) {
                temp = primes[i];
                primes[i] = primes[j];
                primes[j] = temp;
            }
        }
        temp = primes[pivot];
        primes[pivot] = primes[j];
        primes[j] = temp;
        quicksort(primes, first, j - 1);
        quicksort(primes, j + 1, last);
    }
}

int main(int argc, char** argv)
{
    FILE *primesFile;
    int i = 0, j = 0, numResults = 0, numCandidates = 0;
    long int primeToTest;
    primesFile = stdin;
    fscanf(primesFile, "%d\n", &numPrimes);
    for (i = 0; i < numPrimes; i++)
        fscanf(primesFile, "%s\n", firstHalf[i]);
    for (i = 0; i < numPrimes; i++)
        fscanf(primesFile, "%s\n", secondHalf[i]);
    fclose(primesFile);
    for (i = 0; i < numPrimes; i++)
        for (j = 0; j < numPrimes; j++) {
            strcpy(strToTest, firstHalf[i]);
            strcat(strToTest, secondHalf[j]);
            primeToTest = atol(strToTest);
            candidates[numCandidates++] = (uint32_t)primeToTest;
        }
    numResults = collect_primes(candidates, numCandidates, result);
    quicksort(result, 0, numResults - 1);
    for (i = 0; i < numResults; i++)
        printf("%ld\n", result[i]);
    return 0;
}

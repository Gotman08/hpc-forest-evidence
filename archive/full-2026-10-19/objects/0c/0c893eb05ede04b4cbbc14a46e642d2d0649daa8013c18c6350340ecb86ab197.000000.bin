n+        int left = 0;\\n+        const auto &row = blocked[i];\\n+        for (size_t b = 0; b <= row.size(); ++b) {\\n+            const int end = b < row.size() ? row[b] : n;\\n+            for (int j = begin; j < end; ++j) {\\n+                int value = dp[j] + left;\\n+                if (value >= MOD) value -= MOD;\\n+                dp[j] = value;\\n+                left = value;\\n+            }\\n+            if (end < n) {\\n+                dp[end] = 0;\\n+                left = 0;\\n+                begin = end + 1;\\n+            }\\n+        }\\n+    }\\n+    cout << dp[n - 1] << '\\\\n';\\n+}\"}, {\"id\": \"6d60d49bb89e435d\", \"role\": \"B\", \"commit\": \"ae708497fed12db1be72f8de75a35974647dc14e\", \"transformations\": {\"files\": [\"src/solution.cpp\"], \"retained\": [\"Replace unsupported __builtin_shufflevector calls with GCC __builtin_shuffle and explicit integral masks, preserving the four-lane scan and scalar tail.\"]}, \"mean_seconds\": 0.02706739492714405, \"diff\": \"diff --git a/src/solution.cpp b/src/solution.cpp\\nindex a92269b..0f03533 100644\\n--- a/src/solution.cpp\\n+++ b/src/solution.cpp\\n@@ -1,42 +1,71 @@\\n #include <iostream>\\n #include <vector>\\n+#include <algorithm>\\n+#include <cstring>\\n+#include <cstdint>\\n \\n using namespace std;\\n \\n-const int MOD = 1000000007; //since the answer may grow a lot, we use the modulus\\n+const uint32_t MOD = 1000000007;\\n+using Vec = uint32_t __attribute__((vector_size(16)));\\n \\n+static inline Vec reduce(Vec x) {\\n+    const Vec modulus = {MOD, MOD, MOD, MOD};\\n+    return x - ((x >= modulus) & modulus);\\n+}\\n \\n-int main() {\\n-\\tint n,m;\\n-\\tcin >> n >> m;\\n-\\tvector<vector<bool> >  blockedCells(n, vector<bool>(n,false));\\n-\\tfor(int c =0;c<m;c++) {\\n-\\t\\tint i,j;\\n-\\t\\tcin >> i >> j;\\n-\\t\\tblockedCells[i][j] = true;\\t\\t\\n-\\t}\\n-\\n-\\tvector<vector<int> > dp(2,vector<int>(n,0));\\n-\\n-\\tif(!blockedCells[0][0])\\n-\\t\\tdp[0][0] = 1;\\n+static inlin
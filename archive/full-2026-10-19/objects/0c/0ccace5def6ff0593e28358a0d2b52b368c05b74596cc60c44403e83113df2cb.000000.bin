"""Pin public training-framework documentation; do not install or execute it."""
from __future__ import annotations

import hashlib
import json
import urllib.request
from datetime import UTC, datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent


def read(url, maximum=2_000_000):
    request = urllib.request.Request(url, headers={"User-Agent": "HPC-Forest-public-metadata-audit/1"})
    with urllib.request.urlopen(request, timeout=20) as stream:
        raw = stream.read(maximum + 1)
    if len(raw) > maximum:
        raise ValueError("Public metadata exceeds its bound")
    return raw


if __name__ == "__main__":
    destination = ROOT / "frameworks-pistes.json"
    if destination.exists():
        raise RuntimeError("Preserve the existing framework observation")
    revisions = {}
    for repo, ref in [("modelscope/ms-swift", "main"), ("modelscope/mcore-bridge", "main"),
                      ("NVIDIA/Megatron-LM", "dev")]:
        url = f"https://api.github.com/repos/{repo}/commits/{ref}"
        raw = read(url)
        info = json.loads(raw)
        assert len(info["sha"]) == 40
        revisions[repo] = {"revision": info["sha"], "ref_observed": ref, "metadata_sha256": hashlib.sha256(raw).hexdigest()}
        (ROOT / (repo.replace("/", "-") + "-commit.json")).write_bytes(raw)
    revision = revisions["modelscope/ms-swift"]["revision"]
    url = f"https://raw.githubusercontent.com/modelscope/ms-swift/{revision}/docs/source/BestPractices/deepseek-v4.md"
    raw = read(url)
    (ROOT / "ms-swift-deepseek-v4.md").write_bytes(raw)
    result = {"utc": datetime.now(UTC).isoformat(), "revisions": revisions,
              "training_reference_document": {"url": url, "sha256": hashlib.sha256(raw).hexdigest()},
              "documentation_reference_recipe_gpus": 8, "romeo_documented_gpus_per_node": 4,
              "four_gpu_fit_proved": False, "multi_node_runtime_prepared": False,
              "fp4_blockwise_training_supported_by_reference": False,
              "fp4_loading_conversion_must_be_reviewed": "FP8/BF16",
              "lora_fp8_merge_may_erase_delta": True,
              "exact_0731_checkpoint_training_qualified": False,
              "software_installed_on_ROMEO": False, "weights_downloaded": False,
              "model_calls": 0, "training_executed": False}
    destination.write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(result, ensure_ascii=True))

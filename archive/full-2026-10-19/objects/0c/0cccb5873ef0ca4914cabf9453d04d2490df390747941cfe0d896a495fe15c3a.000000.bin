{
  "src/solution.cpp": "#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <limits>\n#include <memory>\n#include <vector>\n\nclass FastInput {\n    static constexpr std::size_t buffer_size = 1u << 16;\n    unsigned char buffer_[buffer_size];\n    std::size_t position_ = 0;\n    std::size_t length_ = 0;\n\n    int nextChar() {\n        if (position_ == length_) {\n            length_ = std::fread(buffer_, 1, buffer_size, stdin);\n            position_ = 0;\n            if (length_ == 0) return EOF;\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    bool readInt(int& result) {\n        int c;\n        do {\n            c = nextChar();\n        } while (c != EOF && c <= ' ');\n        if (c == EOF) return false;\n\n        const bool negative = c == '-';\n        if (c == '-' || c == '+') c = nextChar();\n        std::int64_t value = 0;\n        while (c >= '0' && c <= '9') {\n            value = value * 10 + (c - '0');\n            c = nextChar();\n        }\n        result = static_cast<int>(negative ? -value : value);\n        return true;\n    }\n};\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.readInt(n) || !input.readInt(s)) return 0;\n\n    assert(n > 0);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(s < n);\n\n    const std::size_t width = static_cast<std::size_t>(n);\n    std::unique_ptr<int[]> rows(new int[width * static_cast<std::size_t>(s)]);\n    std::vector<std::int64_t> column_sums(width, 0);\n    std::int64_t best = std::numeric_limits<std::int64_t>::lowest();\n    int ring_row = 0;\n\n    for (int row = 0; row < n; ++row) {\n        int* slot = rows.get() + static_cast<std::size_t>(ring_row) * width;\n        if (row < s) {\n            for (int col = 0; col < n; ++col) {\n                int value;\n                if (!input.readInt(value)) return 0;\n                slot[col] = value;\n                column_sums[col] += static_cast<std::int64_t>(value);\n            }\n        } else {\n            for (int col = 0; col < n; ++col) {\n                int value;\n                if (!input.readInt(value)) return 0;\n                column_sums[col] += static_cast<std::int64_t>(value)\n                                  - static_cast<std::int64_t>(slot[col]);\n                slot[col] = value;\n            }\n        }\n\n        if (row + 1 >= s) {\n            std::int64_t window_sum = 0;\n            for (int col = 0; col < s; ++col) {\n                window_sum += column_sums[col];\n            }\n            if (window_sum > best) best = window_sum;\n            for (int col = s; col < n; ++col) {\n                window_sum += column_sums[col] - column_sums[col - s];\n                if (window_sum > best) best = window_sum;\n            }\n        }\n\n        if (++ring_row == s) ring_row = 0;\n    }\n\n    std::printf(\"%lld\\n\", static_cast<long long>(best));\n    return 0;\n}\n"
}

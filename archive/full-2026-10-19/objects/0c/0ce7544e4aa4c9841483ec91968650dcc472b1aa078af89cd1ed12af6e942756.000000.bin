    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#define _GNU_SOURCE\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <math.h>\\n\\n#define N_ITER 10 // number of simulation iterations\\n#define DT 0.01f // time step\\n#define SOFTENING 1e-9f // to avoid zero divisors\\n\\n/*\\n * Structure-of-Arrays layout: separate arrays for each coordinate and velocity.\\n */\\ntypedef struct {\\n    float *x, *y, *z;\\n    float *vx, *vy, *vz;\\n} Bodies;\\n\\n/*\\n * Compute the gravitational impact among all pairs of bodies in \\n * the system. Uses tiling on both i and j loops for cache locality.\\n */\\nvoid body_force(float *restrict x, float *restrict y, float *restrict z,\\n                float *restrict vx, float *restrict vy, float *restrict vz,\\n                float dt, int n) {\\n    const int IBLOCK = 16;\\n    const int JBLOCK = 256;\\n\\n#pragma omp parallel for schedule(static)\\n    for (int ii = 0; ii < n; ii += IBLOCK) {\\n        int i_end = ii + IBLOCK;\\n        if (i_end > n) i_end = n;\\n\\n        // Local accumulators for each body in the block\\n        float fx[IBLOCK], fy[IBLOCK], fz[IBLOCK];\\n        for (int ib = 0; ib < i_end - ii; ++ib) {\\n            fx[ib] = 0.0f;\\n            fy[ib] = 0.0f;\\n            fz[ib] = 0.0f;\\n        }\\n\\n        for (int jj = 0; jj < n; jj += JBLOCK) {\\n            int j_end = jj + JBLOCK;\\n            if (j_end > n) j_end = n;\\n\\n            // Process all pairs in this tile\\n            for (int ib = ii; ib < i_end; ++ib) {\\n                float pix = x[ib];\\n                float piy = y[ib];\\n                float piz = z[ib];\\n                int idx = ib - ii;\\n                float fxx = fx[idx], fyy = fy[idx], fzz = fz[idx];\\n\\n#pragma omp simd reduction(+:fxx,fyy,fzz) aligned(x,y,z:16)\\n                for (int jb = jj; jb < j_end; ++jb) {\\n                    float dx = x[jb] - pix;\\n                    float dy = y[jb] - piy;\\n                    float dz = z[jb] - piz;\\n                    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n                    float inv_dist = 1.0f / sqrt(sqrd_dist);\\n                    float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n\\n                    fxx += dx * inv_dist3;\\n                    fyy += dy * inv_dist3;\\n                    fzz += dz * inv_dist3;\\n                }\\n\\n                fx[idx] = fxx;\\n                fy[idx] = fyy;\\n                fz[idx] = fzz;\\n            }\\n        }\\n\\n        // Update velocities for this block\\n        for (int ib = ii; ib < i_end; ++ib) {\\n            int idx = ib - ii;\\n            vx[ib] += dt * fx[idx];\\n            vy[ib] += dt * fy[idx];\\n            vz[ib] += dt * fz[idx];\\n        }\\n    }\\n}\\n\\n/*\\n * Read a binary dataset with initialized bodies.\\n */\\nBodies read_dataset(int *nbodies) {\\n    int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\\n    if (b != 1) {\\n        fprintf(stderr,\\\"\\\\nError reading nbodie value\\\\n\\\");\\n        exit(EXIT_FAILURE);\\n    }\\n\\n    Bodies bodies;\\n    int n = *nbodies;\\n\\n    // Aligned allocation for better SIMD performance\\n    posix_memalign((void**)&bodies.x,  16, n * sizeof(float));\\n    posix_memalign((void**)&bodies.y,  16, n * sizeof(float));\\n    posix_memalign((void**)&bodies.z,  16, n * sizeof(float));\\n    posix_memalign((void**)&bodies.vx, 16, n * sizeof(float));\\n    posix_memalign((void**)&bodies.vy, 16, n * sizeof(float));\\n    posix_memalign((void**)&bodies.vz, 16, n * sizeof(float));\\n\\n    // Read interleaved AoS data and convert to SoA\\n    float *tmp = (float *)malloc(6 * n * sizeof(float));\\n    b = fread(tmp, 6 * n * sizeof(float), 1, stdin);\\n    if (b != 1) {\\n        fprintf(stderr,\\\"\\\\nError reading input values\\\\n\\\");\\n        exit(EXIT_FAILURE);\\n    }\\n\\n    for (int i = 0; i < n; ++i) {\\n        bodies.x[i] = tmp[6*i + 0];\\n        bodies.y[i] = tmp[6*i + 1];\\n        bodies.z[i] = tmp[6*i + 2];\\n        bodies.vx[i] = tmp[6*i + 3];\\n        bodies.vy[i] = tmp[6*i + 4];\\n        bodies.vz[i] = tmp[6*i + 5];\\n    }\\n\\n    free(tmp);\\n    return bodies;\\n}\\n\\n/*\\n * Write simulation results into a binary dataset (AoS format).\\n */\\nvoid write_dataset(const int nbodies, Bodies bodies) {\\n    float *tmp = (float *)malloc(6 * nbodies * sizeof(float));\\n    for (int i = 0; i < nbodies; ++i) {\\n        tmp[6*i + 0] = bodies.x[i];\\n        tmp[6*i + 1] = bodies.y[i];\\n        tmp[6*i + 2] = bodies.z[i];\\n        tmp[6*i + 3] = bodies.vx[i];\\n        tmp[6*i + 4] = bodies.vy[i];\\n        tmp[6*i + 5] = bodies.vz[i];\\n    }\\n\\n    int b = fwrite(tmp, nbodies * sizeof(float) * 6, 1, stdout);\\n    if (b != 1) {\\n        fprintf(stderr,\\\"\\\\nError writing to output\\\\n\\\");\\n        exit(EXIT_FAILURE);\\n    }\\n\\n    free(tmp);\\n}\\n\\nint main(int argc,char **argv) {\\n    int nbodies;\\n\\n    Bodies bodies = read_dataset(&nbodies);\\n\\n    /*\\n     * At each simulation iteration, interbody forces are computed,\\n     * and bodies' positions are integrated.\\n     */\\n    for (int iter = 0; iter < N_ITER; ++iter) {\\n        body_force(bodies.x, bodies.y, bodies.z,\\n                   bodies.vx, bodies.vy, bodies.vz,\\n                   DT, nbodies);\\n\\n#pragma omp parallel for schedule(static)\\n        for (int i = 0; i < nbodies; ++i) {\\n            bodies.x[i] += bodies.vx[i] * DT;\\n            bodies.y[i] += bodies.vy[i] * DT;\\n            bodies.z[i] += bodies.vz[i] * DT;\\n        }\\n    }\\n\\n    write_dataset(nbodies, bodies);\\n\\n    free(bodies.x); free(bodies.y); free(bodies.z);\\n    free(bodies.vx); free(bodies.vy); free(bodies.vz);\\n\\n    exit(EXIT_SUCCESS);\\n}\\n\",\n      \"path\": \"src/nbody.c\"\n    }\n  ],\n  \"hypothesis\": \"Integrating SoA layout with tiling (IBLOCK=16, JBLOCK=256) from source A, aligned allocation and restrict qualifiers plus SIMD reduction pragma on inner j-block loops from source B, and OpenMP parallel for schedule(static) on both force computation and position update will combine cache efficiency, vectorization, thread-level parallelism to achieve further speedup beyond any individual transformation.\",\n  \"notes\": \"Combines the best-performing tiling strategy (source A) with aligned memory and SIMD hints from source B. Avoids dynamic scheduling which may cause overhead; uses static schedule for predictable load balance on uniform input sizes.\",\n  \"sources_kept\": [\n    \"26a9e4c4520f4ca0\",\n    \"739b419c986f49cc\"\n  ],\n  \"transformations\": [\n    \"Struct-of-Arrays conversion with tiling (IBLOCK=16, JBLOCK=256)\",\n    \"Aligned memory allocation via posix_memalign for all arrays\",\n    \"restrict qualifiers on array pointer parameters in body_force\",\n    \"#pragma omp simd reduction aligned on inner j-block loop\",\n    \"#pragma omp parallel for schedule(static) over i-blocks in force computation\",\n    \"#pragma omp parallel for schedule(static) in position update\"\n  ]\n}",

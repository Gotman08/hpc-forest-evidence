{
  "src/brute_isomorphism.cpp": "#include <iostream>\n#include <vector>\n#include <utility>\n\nusing namespace std;\n\ntypedef vector<vector<bool>> adjacency_matrix;\n\nadjacency_matrix readGraph();\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence);\nbool verifyPermutationRaw(const adjacency_matrix &g1, const adjacency_matrix &g2, const int *equivalence, int n);\ninline void printPermutation(vector<int> &equivalence);\ninline void printPermutation(const int *equivalence, int n);\n\nint main(){\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if(!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\n    if(g1.size() != g2.size()) return false;\n\n    const int n = static_cast<int>(g1.size());\n\n    // Keep small searches on the original serial path to avoid parallel overhead.\n    if(n < 8){\n        vector<int> equivalence(g1.size(), 0);\n        vector<int> exchange_counter(g1.size(), 0);\n        int exchange_index = 1;\n        bool isomorphism_found = false;\n\n        for(int i = 0; i < equivalence.size(); ++i)\n            equivalence[i] = i;\n\n        if(verifyPermutation(g1, g2, equivalence)){\n            printPermutation(equivalence);\n            return true;\n        }\n\n        /*\n         * Permutations are based on Heap's algorithm, which generates all possible\n         * permutations for a given set of elements.\n         */\n        while(exchange_index < g1.size()){\n            if(exchange_counter[exchange_index] < exchange_index){\n                if(exchange_index % 2 == 0)\n                    swap(equivalence[0], equivalence[exchange_index]);\n                else\n                    swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\n                if(verifyPermutation(g1, g2, equivalence)){\n                    printPermutation(equivalence);\n                    isomorphism_found = true;\n                }\n\n                exchange_counter[exchange_index]++;\n                exchange_index = 1;\n            }else{\n                exchange_counter[exchange_index] = 0;\n                exchange_index++;\n            }\n        }\n        return isomorphism_found;\n    }\n\n    // Generate bounded batches in Heap order. Workers check candidates in parallel;\n    // matches are printed serially in their original order.\n    const int batch_capacity = 8192;\n    vector<int> permutation(n);\n    vector<int> exchange_counter(n, 0);\n    vector<int> batch(batch_capacity * n);\n    vector<unsigned char> matches(batch_capacity, 0);\n    int exchange_index = 1;\n    int batch_count = 0;\n    bool has_permutation = true;\n    bool isomorphism_found = false;\n\n    for(int i = 0; i < n; ++i)\n        permutation[i] = i;\n\n    #pragma omp parallel\n    {\n        while(true){\n            #pragma omp single\n            {\n                batch_count = 0;\n                while(batch_count < batch_capacity && has_permutation){\n                    const int offset = batch_count * n;\n                    for(int i = 0; i < n; ++i)\n                        batch[offset + i] = permutation[i];\n                    ++batch_count;\n\n                    bool advanced = false;\n                    while(exchange_index < n){\n                        if(exchange_counter[exchange_index] < exchange_index){\n                            if(exchange_index % 2 == 0)\n                                swap(permutation[0], permutation[exchange_index]);\n                            else\n                                swap(permutation[exchange_counter[exchange_index]], permutation[exchange_index]);\n                            exchange_counter[exchange_index]++;\n                            exchange_index = 1;\n                            advanced = true;\n                            break;\n                        }else{\n                            exchange_counter[exchange_index] = 0;\n                            exchange_index++;\n                        }\n                    }\n                    if(!advanced)\n                        has_permutation = false;\n                }\n            }\n\n            if(batch_count == 0)\n                break;\n\n            #pragma omp for schedule(static)\n            for(int index = 0; index < batch_count; ++index){\n                const int offset = index * n;\n                matches[index] = static_cast<unsigned char>(\n                    verifyPermutationRaw(g1, g2, &batch[offset], n));\n            }\n\n            #pragma omp single\n            {\n                for(int index = 0; index < batch_count; ++index){\n                    if(matches[index]){\n                        printPermutation(&batch[index * n], n);\n                        isomorphism_found = true;\n                    }\n                }\n            }\n        }\n    }\n\n    return isomorphism_found;\n}\n\nadjacency_matrix readGraph(){\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read(vertices);\n    for (int i = 0; i < vertices; ++i)\n        read[i].resize(vertices);\n\n    cin >> edges;\n    for (int i = 0; i < edges; i++) {\n       cin >> source >> destination;\n       read[destination][source] = read[source][destination] = true;\n    }\n\n    return read;\n}\n\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence){\n    return verifyPermutationRaw(g1, g2, equivalence.data(), static_cast<int>(equivalence.size()));\n}\n\nbool verifyPermutationRaw(const adjacency_matrix &g1, const adjacency_matrix &g2, const int *equivalence, int n){\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j <= i; ++j) {\n            if(g1[i][j] != g2[equivalence[i]][equivalence[j]]) return false;\n        }\n    }\n    return true;\n}\n\ninline void printPermutation(vector<int> &equivalence){\n    for (auto i : equivalence)\n        cout << i << \" \";\n    cout << endl;\n}\n\ninline void printPermutation(const int *equivalence, int n){\n    for(int i = 0; i < n; ++i)\n        cout << equivalence[i] << \" \";\n    cout << endl;\n}\n"
}

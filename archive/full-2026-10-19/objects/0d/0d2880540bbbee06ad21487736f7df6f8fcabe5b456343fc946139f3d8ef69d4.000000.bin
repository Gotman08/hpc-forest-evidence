        "content": "#include <bits/stdc++.h>\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nusing namespace std;\n\nint A[1000][1000];\nint ps[1010][1010];\n\ntypedef long long ll;\n\nnamespace {\nclass PrefixFrequencyTable {\n  vector<int32_t> keys_;\n  vector<uint32_t> counts_;\n  size_t group_mask_;\n\n  static uint32_t mix(int32_t key) {\n    uint32_t x = static_cast<uint32_t>(key);\n    x ^= x >> 16;\n    x *= 0x7feb352dU;\n    x ^= x >> 15;\n    x *= 0x846ca68bU;\n    x ^= x >> 16;\n    return x;\n  }\n\n  size_t find_slot(int32_t key) const {\n    size_t group = static_cast<size_t>(mix(key)) & group_mask_;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const int32x4_t needle = vdupq_n_s32(key);\n    const uint32x4_t zero = vdupq_n_u32(0);\n    const uint32x4_t lanes = {0u, 1u, 2u, 3u};\n#endif\n    for (;;) {\n      const size_t base = group * 4;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n      const uint32x4_t equal =\n          vceqq_s32(vld1q_s32(keys_.data() + base), needle);\n      const uint32x4_t empty =\n          vceqq_u32(vld1q_u32(counts_.data() + base), zero);\n      const uint32x4_t stop = vorrq_u32(equal, empty);\n      // Non-candidate lanes become UINT32_MAX; choose the first candidate.\n      const uint32_t lane = vminvq_u32(vornq_u32(lanes, stop));\n      if (lane < 4)\n        return base + lane;\n#else\n      for (size_t lane = 0; lane < 4; ++lane) {\n        if (counts_[base + lane] == 0 || keys_[base + lane] == key)\n          return base + lane;\n      }\n#endif\n      group = (group + 1) & group_mask_;\n    }\n  }\n\npublic:\n  explicit PrefixFrequencyTable(size_t max_prefixes) {\n    size_t capacity = 4;\n    while (capacity < 2 * max_prefixes)\n      capacity <<= 1;\n    // Keys remain initialized even when their counts mark them as empty.\n    keys_.assign(capacity, 0);\n    counts_.assign(capacity, 0);\n    group_mask_ = capacity / 4 - 1;\n  }\n\n  void clear() {\n    fill(counts_.begin(), counts_.end(), uint32_t(0));\n  }\n\n  uint32_t count(int32_t key) const {\n    return counts_[find_slot(key)];\n  }\n\n  uint32_t increment(int32_t key) {\n    const size_t slot = find_slot(key);\n    const uint32_t previous = counts_[slot];\n    if (previous == 0)\n      keys_[slot] = key;\n    counts_[slot] = previous + 1;\n    return previous;\n  }\n};\n}\n\nll solve(int m, int n, int k) {\n  for (int i = 1; i <= m; i++) {\n    ps[i][0] = 0;\n    for (int j = 1; j <= n; j++) {\n      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\n    }\n  }\n\n  PrefixFrequencyTable h(static_cast<size_t>(m) + 1);\n  ll ans = 0;\n  for (int j = 1; j <= n; j++) {\n    for (int l = j; l <= n; l++) {\n      h.clear();\n      h.increment(0);\n      int32_t s = 0;\n      if (k == 0) {\n        for (int i = 1; i <= m; i++) {\n          s += ps[i][l] - ps[i][j - 1];\n          // The old frequency excludes the current prefix.\n          ans += h.increment(s);\n        }\n      } else {\n        for (int i = 1; i <= m; i++) {\n          s += ps[i][l] - ps[i][j - 1];\n          ans += h.count(s - k);\n          h.increment(s);\n        }\n      }\n    }\n  }\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n  memset(ps, 0, sizeof ps);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n",

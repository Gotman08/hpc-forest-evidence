#include <iostream>
#include <vector>
#include <cstdio>
#include <climits>
#include <cassert>

int main() {
	int n,s;
	std::cin >> n >> s;

	// Read matrix and compute column prefix sums in one pass.
	// pref[i*n + j] = sum of rows 0..i-1 at column j, for i=0..n.
	std::vector<int> pref((n+1) * n, 0);
	for (int i = 1; i <= n; ++i) {
		for (int j = 0; j < n; ++j) {
			int val;
			scanf("%d", &val);
			pref[i*n + j] = pref[(i-1)*n + j] + val;
		}
	}

	assert(s < n && s > 0 && n > 0 && n < 8000);

	int mxSum = INT_MIN;

	// Each starting row is independent; use OpenMP reduction over rows.
	// Static chunk size 1 balances the last partial block on 4 cores.
	#pragma omp parallel for reduction(max:mxSum) schedule(static, 1)
	for (int i = 0; i <= n - s; ++i) {
		const int rowStart = i * n;
		const int rowEnd   = (i + s) * n;

		// Initial horizontal window for columns 0..s-1.
		int window = 0;
		for (int j = 0; j < s; ++j) {
			window += pref[rowEnd + j] - pref[rowStart + j];
		}
		int curMax = window;

		// Slide the window to the right.
		for (int j = s; j < n; ++j) {
			window += (pref[rowEnd + j] - pref[rowStart + j])
			        - (pref[rowEnd + (j-s)] - pref[rowStart + (j-s)]);
			if (window > curMax) curMax = window;
		}

		if (curMax > mxSum) mxSum = curMax;
	}

	printf("%d\n", mxSum);
	return 0;
}

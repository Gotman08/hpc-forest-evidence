#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<stdint.h>

/* Maximum size (in char) for neighbors and compute lists */
#define MAX 100

typedef struct {
  int id;
  float value;
  char neighbors[MAX];
} Node;

typedef struct {
  int id;
  size_t index_plus_one;
} IdEntry;

/* Reads input, allocates memory, writes graph size and node list. Returns the graph. */
Node* read_input(char* fname, int *n, char* list) {
  Node* data = NULL;
  FILE *fl = NULL;

  if (fname == NULL)
    fl = stdin;
  else
    fl = fopen(fname, "r");

  if (fl == NULL) {
    fprintf(stderr, "Error!\n");
    exit(1);
  }

  // header
  fscanf(fl, "%d %[^
]", n, list);

  if (*n > 0) {
    data = (Node*) malloc ((*n)*sizeof(Node));
    if(data == NULL){
      fprintf(stderr, "Error!\n");
      exit(1);
    }
  }

  for(int i = 0; i < *n; i++)
    fscanf(fl, "%d %f %[^
]", &data[i].id, &data[i].value, data[i].neighbors);

  fclose(fl);
  return data;
}

/* Mix arbitrary signed IDs into hash-table slots. */
static size_t hash_id(int id, size_t mask) {
  uint32_t x = (uint32_t)id;
  x ^= x >> 16;
  x *= 0x7feb352dU;
  x ^= x >> 15;
  x *= 0x846ca68bU;
  x ^= x >> 16;
  return (size_t)x & mask;
}

/* Builds a compact open-addressed ID index, retaining the first duplicate ID. */
static IdEntry *build_id_index(Node g[], int size, size_t *capacity) {
  size_t cap = 8;
  size_t wanted = size > 0 ? (size_t)size * 2 : 1;

  while (cap < wanted) {
    if (cap > (size_t)-1 / 2) {
      fprintf(stderr, "Error!\n");
      exit(1);
    }
    cap <<= 1;
  }

  IdEntry *index = (IdEntry*)calloc(cap, sizeof(*index));
  if (index == NULL) {
    fprintf(stderr, "Error!\n");
    exit(1);
  }

  for (int i = 0; i < size; i++) {
    size_t slot = hash_id(g[i].id, cap - 1);
    while (index[slot].index_plus_one != 0 && index[slot].id != g[i].id)
      slot = (slot + 1) & (cap - 1);

    if (index[slot].index_plus_one == 0) {
      index[slot].id = g[i].id;
      index[slot].index_plus_one = (size_t)i + 1;
    }
  }

  *capacity = cap;
  return index;
}

/* Returns the first matching node index, or -1 if the ID is not present. */
static int find_by_id(const IdEntry *index, size_t capacity, int id) {
  size_t slot = hash_id(id, capacity - 1);

  while (index[slot].index_plus_one != 0) {
    if (index[slot].id == id)
      return (int)(index[slot].index_plus_one - 1);
    slot = (slot + 1) & (capacity - 1);
  }

  return -1;
}

/* Computes the sum for the node with the given id */
float get_costly(Node *g, const IdEntry *index, size_t capacity, int id) {
  char *t;
  int idmax = -1;
  float max = 0;
  char *auxptr;

  int nd = find_by_id(index, capacity, id);
  if(nd < 0)
    return max;

  char aux[MAX];
  strcpy(aux, g[nd].neighbors);
  t = strtok_r(aux, " ", &auxptr);

  do {
    int d = find_by_id(index, capacity, atoi(t));
    if (d >= 0 && max < g[d].value) {
      max = g[d].value;
      idmax = atoi(t);
    }
  } while ((t = strtok_r(NULL, " ", &auxptr)));

  float r = g[nd].value;

  if(idmax != -1)
    r += get_costly(g, index, capacity, idmax);

  return r;
}

/* Main program - calls read input, computes sum for each node in the list, prints output */
int main() {
  char *fileN = NULL;
  char computelist[MAX];
  int n = -1;
  size_t index_capacity;
  Node* input = NULL;

  input = read_input(fileN, &n, computelist);
  IdEntry *index = build_id_index(input, n, &index_capacity);

  // process
  for(char *c = strtok(computelist, " "); c != NULL; c = strtok(NULL, " "))
    printf("%s: %f\n", c, get_costly(input, index, index_capacity, atoi(c)));

  free(index);
  free(input);
  return 0;
}

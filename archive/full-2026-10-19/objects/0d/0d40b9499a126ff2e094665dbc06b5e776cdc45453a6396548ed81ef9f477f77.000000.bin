#include <algorithm>
#include <cassert>
#include <cstddef>
#include <cstdio>
#include <vector>

int main() {
    int n, s;
    if (std::scanf("%d %d", &n, &s) != 2) return 0;

    assert(n > 0 && n < 8000 && s > 0 && s < n);

    // Keep only the S rows needed by the vertical sliding window.
    std::vector<int> row_buffer(static_cast<std::size_t>(s) * n);
    std::vector<long long> column_sums(n, 0);

    for (int r = 0; r < s; ++r) {
        int* row = row_buffer.data() + static_cast<std::size_t>(r) * n;
        for (int c = 0; c < n; ++c) {
            std::scanf("%d", &row[c]);
            column_sums[c] += row[c];
        }
    }

    long long window_sum = 0;
    for (int c = 0; c < s; ++c) window_sum += column_sums[c];
    long long best = window_sum;

    for (int left = 1; left + s <= n; ++left) {
        window_sum += column_sums[left + s - 1] - column_sums[left - 1];
        best = std::max(best, window_sum);
    }

    for (int top = 1; top + s <= n; ++top) {
        const int slot = (top - 1) % s;
        int* row = row_buffer.data() + static_cast<std::size_t>(slot) * n;
        for (int c = 0; c < n; ++c) {
            int value;
            std::scanf("%d", &value);
            column_sums[c] += static_cast<long long>(value) - row[c];
            row[c] = value;
        }

        window_sum = 0;
        for (int c = 0; c < s; ++c) window_sum += column_sums[c];
        best = std::max(best, window_sum);
        for (int left = 1; left + s <= n; ++left) {
            window_sum += column_sums[left + s - 1] - column_sums[left - 1];
            best = std::max(best, window_sum);
        }
    }

    std::printf("%lld\n", best);
    return 0;
}

      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <math.h>\n#include <string.h>\n#include <pthread.h>\n#include <stdatomic.h>\n\n#pragma weak pthread_create\n#pragma weak pthread_join\n\n#define MAXNUM 100\n#define MAXSTR 50\n#define MAXRESULTS 1000\n#define MAXWORKERS 4\n\nchar firstHalf[MAXNUM][MAXSTR];\nchar secondHalf[MAXNUM][MAXSTR];\nlong int result[MAXRESULTS];\nint numPrimes=0;\n\nstatic long int rowResults[MAXNUM][MAXNUM];\nstatic int rowCounts[MAXNUM];\nstatic atomic_int nextRow = ATOMIC_VAR_INIT(0);\n\nint isprime(long int value)\n{ long int root;\n  long int factor=2;\n  int prime=1;\n  root = sqrtl(value);\n  while ((factor<=root) && (prime))\n        { prime = fmod((double)value,(double) factor) > 0.0;\n          factor++;\n        }\n  return prime;\n}\n\nvoid quicksort(long int *primes,int first,int last)\n{ int i, j, pivot;\n  long int temp;\n\n  if (first<last)\n     { pivot=first;\n       i=first;\n       j=last;\n       while(i<j)\n         { while (primes[i]<=primes[pivot]&&i<last)\n             i++;\n           while(primes[j]>primes[pivot])\n             j--;\n           if (i<j)\n              { temp=primes[i];\n                primes[i]=primes[j];\n                primes[j]=temp;\n              }\n         }\n       temp=primes[pivot];\n       primes[pivot]=primes[j];\n       primes[j]=temp;\n       quicksort(primes,first,j-1);\n       quicksort(primes,j+1,last);\n     }\n}\n\nstatic void testRow(int i)\n{\n  char strToTest[MAXSTR];\n  int count=0;\n  int j;\n\n  for (j=0;j<numPrimes;j++)\n      { long int primeToTest;\n        strcpy(strToTest,firstHalf[i]);\n        strcat(strToTest,secondHalf[j]);\n        primeToTest=atol(strToTest);\n        if (isprime(primeToTest))\n           rowResults[i][count++]=primeToTest;\n      }\n  rowCounts[i]=count;\n}\n\nstatic void *testRows(void *unused)\n{\n  (void)unused;\n  for (;;)\n      { int i=atomic_fetch_add_explicit(&nextRow,1,memory_order_relaxed);\n        if (i>=numPrimes)\n           break;\n        testRow(i);\n      }\n  return NULL;\n}\n\nstatic void testAllPairs(void)\n{\n  pthread_t workers[MAXWORKERS-1];\n  int started=0;\n  int i;\n\n  if (numPrimes<2*MAXWORKERS ||\n      pthread_create==NULL || pthread_join==NULL)\n     { for (i=0;i<numPrimes;i++)\n           testRow(i);\n       return;\n     }\n\n  atomic_store_explicit(&nextRow,0,memory_order_relaxed);\n  while (started<MAXWORKERS-1)\n        { if (pthread_create(&workers[started],NULL,testRows,NULL)!=0)\n             break;\n          started++;\n        }\n\n  testRows(NULL);\n  for (i=0;i<started;i++)\n      (void)pthread_join(workers[i],NULL);\n}\n\nint main(int argc,char** argv)\n{ FILE *primesFile;\n  int i=0,j=0,numResults=0;\n  primesFile=stdin;\n  fscanf(primesFile,\"%d\\n\",&numPrimes);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",firstHalf[i]);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",secondHalf[i]);\n  fclose(primesFile);\n\n  testAllPairs();\n  for (i=0;i<numPrimes;i++)\n      for (j=0;j<rowCounts[i];j++)\n          result[numResults++]=rowResults[i][j];\n\n  quicksort(result,0,numResults-1);\n  for (i=0;i<numResults;i++)\n      printf(\"%ld\\n\",result[i]);\n  return 0;\n}\n",
      "path": "src/sources/primetest.c"
    }

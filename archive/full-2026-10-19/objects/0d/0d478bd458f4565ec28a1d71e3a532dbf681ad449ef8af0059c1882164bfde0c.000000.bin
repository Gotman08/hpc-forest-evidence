#include <cstdio>
#include <vector>
#include <climits>

class FastScanner {
    static const int BUFSIZE = 1 << 20;
    char buf[BUFSIZE];
    int idx, size;
public:
    FastScanner() : idx(0), size(0) {}
    inline char getChar() {
        if (idx >= size) {
            size = fread(buf, 1, BUFSIZE, stdin);
            idx = 0;
            if (size == 0) return '\0';
        }
        return buf[idx++];
    }
    int nextInt() {
        char c;
        do { c = getChar(); } while (c <= ' ');
        int sign = 1;
        if (c == '-') { sign = -1; c = getChar(); }
        int x = 0;
        while (c >= '0' && c <= '9') {
            x = x * 10 + (c - '0');
            c = getChar();
        }
        return sign * x;
    }
};

int main() {
    FastScanner fs;
    int n = fs.nextInt();
    int s = fs.nextInt();

    std::vector<long long> colPref((size_t)(n + 1) * n);
    for (int i = 1; i <= n; ++i) {
        const size_t base = (size_t)i * n;
        const size_t prev = (size_t)(i - 1) * n;
        int j = 0;
        for (; j + 3 < n; j += 4) {
            long long v0 = fs.nextInt();
            long long v1 = fs.nextInt();
            long long v2 = fs.nextInt();
            long long v3 = fs.nextInt();
            colPref[base + j]     = colPref[prev + j]     + v0;
            colPref[base + j + 1] = colPref[prev + j + 1] + v1;
            colPref[base + j + 2] = colPref[prev + j + 2] + v2;
            colPref[base + j + 3] = colPref[prev + j + 3] + v3;
        }
        for (; j < n; ++j) {
            long long v = fs.nextInt();
            colPref[base + j] = colPref[prev + j] + v;
        }
    }

    const int limit_i = n - s + 1;
    long long mxSum = LLONG_MIN;

    #pragma omp parallel for reduction(max:mxSum) schedule(static)
    for (int i = 0; i < limit_i; ++i) {
        const long long* top = &colPref[(size_t)i * n];
        const long long* bottom = &colPref[(size_t)(i + s) * n];

        long long window = 0;
        #pragma omp simd reduction(+:window)
        for (int j = 0; j < s; ++j) {
            window += bottom[j] - top[j];
        }
        if (window > mxSum) mxSum = window;

        for (int j = s; j < n; ++j) {
            window += (bottom[j] - top[j]) - (bottom[j - s] - top[j - s]);
            if (window > mxSum) mxSum = window;
        }
    }

    printf("%d\n", static_cast<int>(mxSum));
    return 0;
}

      "content": "#include \"knn.h\"\n\nstatic char knn_insertion(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *)malloc(sizeof(char) * (size_t)k);\n    float *distances = (float *)malloc(sizeof(float) * (size_t)k);\n    if (!labels || !distances) {\n        free(labels);\n        free(distances);\n        on_error();\n    }\n\n    int i, j, x, y;\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    qsort(labels, (size_t)k, sizeof(char), compare_for_sort);\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nstatic char knn_vote(const size_t *frequency) {\n    size_t best_count = 0;\n    char best = (char)-1;\n    for (int value = CHAR_MIN; value <= CHAR_MAX; value++) {\n        size_t count = frequency[(unsigned char)(char)value];\n        if (count > best_count) {\n            best_count = count;\n            best = (char)value;\n        }\n    }\n    return best;\n}\n\nstatic unsigned knn_bucket(const size_t *histogram, unsigned bins, size_t *rank) {\n    unsigned bucket = 0;\n    while (bucket + 1 < bins && *rank > histogram[bucket]) {\n        *rank -= histogram[bucket];\n        bucket++;\n    }\n    return bucket;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) return (char)-1;\n\n    size_t total = 0;\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length > 0) {\n            size_t length = (size_t)groups[i].length;\n            if (length > SIZE_MAX - total)\n                return knn_insertion(n_groups, groups, k, to_evaluate);\n            total += length;\n        }\n    }\n\n    size_t frequency[UCHAR_MAX + 1] = {0};\n    size_t wanted = (size_t)k;\n    if (wanted >= total) {\n        for (int i = 0; i < n_groups; i++) {\n            if (groups[i].length > 0)\n                frequency[(unsigned char)groups[i].label] += (size_t)groups[i].length;\n        }\n        frequency[(unsigned char)(char)-1] += wanted - total;\n        return knn_vote(frequency);\n    }\n\n    if (total > SIZE_MAX / sizeof(uint32_t) ||\n        (size_t)n_groups > SIZE_MAX / sizeof(size_t))\n        return knn_insertion(n_groups, groups, k, to_evaluate);\n\n    uint32_t *keys = (uint32_t *)malloc(total * sizeof(*keys));\n    size_t *group_ends = (size_t *)malloc((size_t)n_groups * sizeof(*group_ends));\n    if (!keys || !group_ends) {\n        free(keys);\n        free(group_ends);\n        return knn_insertion(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t histogram[4096] = {0};\n    size_t position = 0;\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            float distance = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            uint32_t key;\n            memcpy(&key, &distance, sizeof(key));\n            key &= UINT32_C(0x7fffffff);\n            if (key > UINT32_C(0x7f800000)) {\n                free(keys);\n                free(group_ends);\n                return knn_insertion(n_groups, groups, k, to_evaluate);\n            }\n            keys[position++] = key;\n            histogram[key >> 20]++;\n        }\n    }\n\n    size_t rank = wanted;\n    unsigned high = knn_bucket(histogram, 4096, &rank);\n    memset(histogram, 0, 1024 * sizeof(histogram[0]));\n\n    /* Compact the cutoff bucket stably; group boundaries replace labels. */\n    size_t read = 0;\n    size_t write = 0;\n    for (int i = 0; i < n_groups; i++) {\n        size_t below = 0;\n        for (int j = 0; j < groups[i].length; j++) {\n            uint32_t key = keys[read++];\n            unsigned bucket = key >> 20;\n            if (bucket < high) {\n                below++;\n            } else if (bucket == high) {\n                keys[write++] = key;\n                histogram[(key >> 10) & 1023u]++;\n            }\n        }\n        frequency[(unsigned char)groups[i].label] += below;\n        group_ends[i] = write;\n    }\n\n    unsigned middle = knn_bucket(histogram, 1024, &rank);\n    memset(histogram, 0, 1024 * sizeof(histogram[0]));\n    read = 0;\n    write = 0;\n    for (int i = 0; i < n_groups; i++) {\n        size_t stop = group_ends[i];\n        size_t below = 0;\n        while (read < stop) {\n            uint32_t key = keys[read++];\n            unsigned bucket = (key >> 10) & 1023u;\n            if (bucket < middle) {\n                below++;\n            } else if (bucket == middle) {\n                keys[write++] = key;\n                histogram[key & 1023u]++;\n            }\n        }\n        frequency[(unsigned char)groups[i].label] += below;\n        group_ends[i] = write;\n    }\n\n    unsigned low = knn_bucket(histogram, 1024, &rank);\n    read = 0;\n    for (int i = 0; i < n_groups; i++) {\n        size_t below = 0;\n        size_t equal = 0;\n        size_t stop = group_ends[i];\n        while (read < stop) {\n            unsigned bucket = keys[read++] & 1023u;\n            below += bucket < low;\n            equal += bucket == low;\n        }\n        size_t take = equal < rank ? equal : rank;\n        frequency[(unsigned char)groups[i].label] += below + take;\n        rank -= take;\n    }\n\n    free(group_ends);\n    free(keys);\n    return knn_vote(frequency);\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    },
    {
      "content": "#ifndef KNN_H\n#define KNN_H\n\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n#include <string.h>\n#include <limits.h>\n#include <ctype.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point *points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nstatic unsigned char knn_input_buffer[65537];\nstatic size_t knn_input_position;\nstatic size_t knn_input_size;\n\nstatic int knn_input_fill(void) {\n    knn_input_size = fread(knn_input_buffer, 1, sizeof(knn_input_buffer) - 1, stdin);\n    knn_input_position = 0;\n    knn_input_buffer[knn_input_size] = '\\0';\n    return knn_input_size != 0;\n}\n\nstatic inline int knn_input_peek(void) {\n    if (knn_input_position == knn_input_size && !knn_input_fill()) return EOF;\n    return knn_input_buffer[knn_input_position];\n}\n\nstatic inline int knn_input_get(void) {\n    int value = knn_input_peek();\n    if (value != EOF) knn_input_position++;\n    return value;\n}\n\nstatic void knn_skip_space(void) {\n    int value;\n    while ((value = knn_input_peek()) != EOF && isspace((unsigned char)value))\n        knn_input_get();\n}\n\nstatic void knn_expect(const char *literal) {\n    while (*literal) {\n        if (knn_input_get() != (unsigned char)*literal++) on_error();\n    }\n}\n\nstatic int knn_read_integer(void) {\n    knn_skip_space();\n    int negative = 0;\n    int value = knn_input_peek();\n    if (value == '+' || value == '-') {\n        negative = value == '-';\n        knn_input_get();\n        value = knn_input_peek();\n    }\n    if (value < '0' || value > '9') on_error();\n\n    unsigned magnitude = 0;\n    unsigned limit = negative ? (unsigned)INT_MAX + 1u : (unsigned)INT_MAX;\n    do {\n        unsigned digit = (unsigned)(value - '0');\n        if (magnitude > (limit - digit) / 10u) on_error();\n        magnitude = magnitude * 10u + digit;\n        knn_input_get();\n        value = knn_input_peek();\n    } while (value >= '0' && value <= '9');\n\n    if (negative) {\n        if (magnitude == (unsigned)INT_MAX + 1u) return INT_MIN;\n        return -(int)magnitude;\n    }\n    return (int)magnitude;\n}\n\nstatic float knn_read_coordinate_slow(int delimiter, int allow_space) {\n    char local[128];\n    char *token = local;\n    size_t capacity = sizeof(local);\n    size_t length = 0;\n    size_t depth = 0;\n\n    for (;;) {\n        int value = knn_input_get();\n        if (value == EOF) on_error();\n        if (value == delimiter && depth == 0) break;\n        if (value == '(') {\n            depth++;\n        } else if (value == ')' && depth != 0) {\n            depth--;\n        }\n        if (length + 1 >= capacity) {\n            if (capacity > SIZE_MAX / 2) on_error();\n            size_t next_capacity = capacity * 2;\n            char *next;\n            if (token == local) {\n                next = (char *)malloc(next_capacity);\n                if (next) memcpy(next, local, length);\n            } else {\n                next = (char *)realloc(token, next_capacity);\n            }\n            if (!next) on_error();\n            token = next;\n            capacity = next_capacity;\n        }\n        token[length++] = (char)value;\n    }\n    token[length] = '\\0';\n    char *end;\n    float result = strtof(token, &end);\n    if (end == token) on_error();\n    if (allow_space) {\n        while (isspace((unsigned char)*end)) end++;\n    }\n    if (*end != '\\0') on_error();\n    if (token != local) free(token);\n    return result;\n}\n\nstatic float knn_read_coordinate(int delimiter, int allow_space) {\n    knn_skip_space();\n    if (knn_input_peek() == EOF) on_error();\n\n    char *start = (char *)knn_input_buffer + knn_input_position;\n    char *limit = (char *)knn_input_buffer + knn_input_size;\n    char *end;\n    float result = strtof(start, &end);\n    if (end != start) {\n        char *after = end;\n        if (allow_space) {\n            while (after < limit && isspace((unsigned char)*after)) after++;\n        }\n        if (after < limit && *after == delimiter) {\n            knn_input_position = (size_t)(after - (char *)knn_input_buffer) + 1;\n            return result;\n        }\n    }\n    return knn_read_coordinate_slow(delimiter, allow_space);\n}\n\nint parse_number_of_groups() {\n    knn_skip_space();\n    knn_expect(\"n_groups=\");\n    return knn_read_integer();\n}\n\nPoint parse_point() {\n    knn_skip_space();\n    knn_expect(\"(\");\n    Point point;\n    point.x = knn_read_coordinate(',', 1);\n    point.y = knn_read_coordinate(')', 0);\n    return point;\n}\n\nGroup parse_next_group() {\n    knn_skip_space();\n    knn_expect(\"label=\");\n    int label = knn_input_get();\n    if (label == EOF) on_error();\n    knn_skip_space();\n    knn_expect(\"length=\");\n    int length = knn_read_integer();\n    if (length < 0) on_error();\n\n    Group group;\n    group.label = (char)label;\n    group.length = length;\n    group.points = (Point *)malloc(sizeof(Point) * (size_t)length);\n    if (length > 0 && !group.points) on_error();\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n    return group;\n}\n\nint parse_k() {\n    knn_skip_space();\n    knn_expect(\"k=\");\n    return knn_read_integer();\n}\n\nfloat euclidean_distance_no_sqrt(Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n    return *(char *)a - *(char *)b;\n}\n\n#endif\n",
      "path": "src/knn.h"
    }
  ],
  "hypothesis": "Distance-only radix frontiers with implicit group boundaries should reduce selection traffic, while direct parsing within a resident input window reduces token-copy overhead.",

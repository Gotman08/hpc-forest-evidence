"""Manifest the bounded metadata receipt only; preserve private terminal raw bytes."""
from __future__ import annotations

import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent


def sha(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def ref(path):
    return {"path": path.as_posix(), "sha256": sha(path), "bytes": path.stat().st_size}


def write(name, value):
    with (ROOT / name).open("x", encoding="utf8", newline="\n") as stream:
        stream.write(json.dumps(value, ensure_ascii=False, indent=2) + "\n")


receipt_path = ROOT / "RECEPTION-TERMINALE-BORNEE-R3.json"
prestop_path = ROOT / "PREALABLE-ARRET-METADONNEES.json"
receipt = json.loads(receipt_path.read_text(encoding="utf8"))
prestop = json.loads(prestop_path.read_text(encoding="utf8"))
if not (receipt["verified"] is False and prestop["verified"] is False
        and prestop["metadata_prerequisites_verified_in_declared_scope"] is True
        and receipt["native_reader_r3_refuses_incomplete_cache_as_required"] is True
        and receipt["owned_worker_stopped"] is False):
    raise ValueError("Declared partial metadata-only limits changed")
costs = receipt["scalar_cost_ledger"]
text = f'''# {receipt["model"]} MAX / {receipt["job_id"]} — réception terminale bornée

État reçu : FAILED 1:0. L’archive annoncée, distante et locale est identique : `{receipt["archive"]["sha256"]}`, {receipt["archive"]["bytes"]} octets. La restauration neuve contient {receipt["fresh_restore_files"]} fichiers privés inchangés ; les 103 sources scellées r2c et le contrat fini officiel sont vérifiés. Ces contrôles n’exécutent aucun C, compilateur, modèle ou CLI.

Les {receipt["invocation_metadata_records"]} requêtes/invocations de métadonnées, dont {receipt["mother_invocation_metadata_records"]} mère et {receipt["normal_invocation_metadata_records"]} normales, sont exhaustivement réconciliées : claims, SHA opaques des réponses, marqueurs ready, livraisons et process terminés. Le cache reste préservé sur place avec inventaire SHA ; aucun corps de réponse/JSONL n’a été décodé ou copié depuis ce cache, aucun lock lu ou copié, aucun SQLite vivant ouvert. Les membres de l’archive terminale ont été restaurés comme octets opaques privés.

Le registre restauré clos donne {receipt["scalar_valid_model_evaluation_records"]} enregistrements de modèle valid/correct et {receipt["scalar_infrastructure_error_model_evaluation_records"]} infrastructure_error en recherche. Ces scalaires ne constituent pas un audit indépendant des programmes, des bruts ou de leurs performances. La catégorie terminale est InfrastructureError ; aucune cause basse couche n’est établie ici. Le coût connu est {costs["exact_known_tokens"]} jetons exacts et une borne de {costs["upper_bound_tokens_only_not_consumption"]} qui n’est pas une consommation mesurée. Le total exact est inconnu ; les slots ne sont pas les invocations.

Le vrai lecteur r3 revu est copié à octets identiques dans `lecteur-revu-octets-identiques-r3/`. Les vrais acteurs contrôleur ARM/POSIX et worker Windows passent ses gardes CLI. Le lecteur refuse ensuite le cache incomplet, comme prévu. Son rapport et le refus restent préservés. `RECEPTION-TERMINALE-BORNEE-R3.json` garde verified/native/RAW/performance/audit complet à false ; aucun résultat de recherche final n’est admis par cette réception de métadonnées.

`PREALABLE-ARRET-METADONNEES.json` prouve seulement les préalables de métadonnées déclarés et lie toutes les preuves. Il n’autorise ni n’exécute un arrêt. Le parent doit relire ces limites et contrôler les identités possédées fraîches avant toute fermeture individuelle. Aucun arrêt par nom ou récursif, aucune intervention sur MCP/SSH/wrapper, aucun rejeu. Les autres sources, workers et campagnes sont conservés. Les premières réceptions normales Astra/Sol restent des preuves distinctes de la cohorte terminale ; Terra n’a aucune première évaluation normale reçue.

Ruff des lecteurs locaux passe (`ruff-final-reception-r3.log`). Les premiers refus locaux et tout historique antérieur demeurent conservés. Le présent sceau ajoute une révision de réception ; il ne réécrit aucun précédent manifeste ou reçu.
'''
with (ROOT / "REPRISE-R3.md").open("x", encoding="utf8", newline="\n") as stream:
    stream.write(text)
files = {}
for path in sorted(ROOT.rglob("*")):
    if path.is_symlink() or not path.resolve().is_relative_to(ROOT):
        raise ValueError("Unsafe reception artifact")
    if path.is_file():
        files[path.relative_to(ROOT).as_posix()] = {"sha256": sha(path), "bytes": path.stat().st_size}
write("MANIFESTE-RECEPTION-BORNEE-R3.json", files)
delivery = {"schema": "hpc-forest-r2c-terminal-bounded-metadata-delivery-v1", "verified": False,
    "job_id": receipt["job_id"], "model": receipt["model"], "effort": "max", "session_id": receipt["session_id"],
    "terminal_state": "FAILED", "archive_three_sha_verified": True, "fresh_restored_files": receipt["fresh_restore_files"],
    "source_files_verified": 103, "exhaustive_invocation_metadata_records": receipt["invocation_metadata_records"],
    "metadata_prerequisites_verified_in_declared_scope": True,
    "bounded_receipt": ref(receipt_path), "pre_stop_metadata": ref(prestop_path),
    "manifest": {**ref(ROOT / "MANIFESTE-RECEPTION-BORNEE-R3.json"), "files": len(files)},
    "guide": ref(ROOT / "REPRISE-R3.md"), "strict_native_report": receipt["strict_native_report"],
    "native_research_admitted": False, "complete_cache_snapshot_received": False,
    "independent_raw_or_performance_or_full_cohort_audit_verified": False,
    "body_decoded_exposed_or_live_cache_copied": False, "worker_lock_read_or_copied": False,
    "owned_worker_stopped_by_receiver": False, "new_model_or_job_or_C_or_replay": False,
    "next_step": "Parent review and fresh complete owned-identity preflight only; preserve failed outcomes and never replay"}
write("LIVRAISON-RECEPTION-BORNEE-R3.json", delivery)
print(json.dumps({"job_id": receipt["job_id"], "delivery_sha256": sha(ROOT / "LIVRAISON-RECEPTION-BORNEE-R3.json"),
    "manifest_sha256": sha(ROOT / "MANIFESTE-RECEPTION-BORNEE-R3.json"), "files": len(files),
    "bounded_receipt_sha256": sha(receipt_path), "pre_stop_metadata_sha256": sha(prestop_path), "verified": False}))

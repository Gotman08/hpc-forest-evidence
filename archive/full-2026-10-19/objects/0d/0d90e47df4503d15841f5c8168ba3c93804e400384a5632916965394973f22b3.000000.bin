"""Preserve first audit and expose source timestamps with explicit UTC Z."""
import hashlib
import json
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent


def ref(path):
    data = path.read_bytes()
    return {"path": str(path), "sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data)}


def main():
    previous = HERE / "RECEPTION-FERMETURE-INDEPENDANTE.json"
    assert ref(previous)["sha256"] == "6f41ef75154bd6ff8694fcd12c77e650804209566d54844473df455e2b0e5386"
    value = json.loads(previous.read_text(encoding="utf-8"))
    raw_times = {}
    for label, key in (("prior", "prior_cim"), ("cold", "cold_cim"), ("captured_current", "captured_current_cim")):
        path = Path(value[key]["path"])
        assert ref(path)["sha256"] == value[key]["sha256"]
        header = json.loads(path.read_text(encoding="utf-8-sig"))
        raw = header["captured_at_utc"]
        assert raw.endswith("Z") and raw[:-1] == value["capture_times"][label]
        raw_times[label] = raw
    value["capture_times"] = raw_times
    value["previous_successful_audit_preserved"] = ref(previous)
    value["timestamp_representation_clarification"] = "Les premières valeurs étaient des clés de comparaison UTC sans suffixe; cette pièce expose les chaînes UTC Z originales des trois census, sans changer les faits ou octets reçus."
    value["recorded_worker_terminal"]["utc"] = datetime.fromtimestamp(value["recorded_worker_terminal"]["utc_epoch"], UTC).isoformat().replace("+00:00", "Z")
    target = HERE / "RECEPTION-FERMETURE-INDEPENDANTE-FINALE.json"
    assert not target.exists()
    target.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(ref(target)))


if __name__ == "__main__":
    main()

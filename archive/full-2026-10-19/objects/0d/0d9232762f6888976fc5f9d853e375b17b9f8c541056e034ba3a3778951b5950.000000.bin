      "content": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <limits>\n#include <utility>\n#include <vector>\n\nusing namespace std;\n\nstruct adjacency_matrix {\n    int vertices;\n    vector<unsigned char> entries;\n\n    explicit adjacency_matrix(int n)\n        : vertices(n), entries(static_cast<size_t>(n) * static_cast<size_t>(n), 0) {}\n\n    const unsigned char *row(int vertex) const {\n        return entries.data() + static_cast<size_t>(vertex) * static_cast<size_t>(vertices);\n    }\n};\n\nadjacency_matrix readGraph() {\n    int vertices, edges;\n    cin >> vertices;\n    adjacency_matrix graph(vertices);\n    cin >> edges;\n    for (int i = 0; i < edges; ++i) {\n        int source, destination;\n        cin >> source >> destination;\n        graph.entries[static_cast<size_t>(source) * vertices + destination] = 1;\n        graph.entries[static_cast<size_t>(destination) * vertices + source] = 1;\n    }\n    return graph;\n}\n\nclass PermutationWriter {\n    static const size_t capacity = 65536;\n    char buffer[capacity];\n    size_t used;\n\n    void flush() {\n        if (used != 0) {\n            cout.write(buffer, static_cast<streamsize>(used));\n            used = 0;\n        }\n    }\n\n    void append(char value) {\n        if (used == capacity)\n            flush();\n        buffer[used++] = value;\n    }\n\npublic:\n    PermutationWriter() : used(0) {}\n\n    ~PermutationWriter() {\n        flush();\n    }\n\n    void print(const vector<int> &equivalence) {\n        for (int vertex : equivalence) {\n            unsigned int value = static_cast<unsigned int>(vertex);\n            char digits[numeric_limits<unsigned int>::digits10 + 1];\n            size_t count = 0;\n            do {\n                digits[count++] = static_cast<char>('0' + value % 10);\n                value /= 10;\n            } while (value != 0);\n            while (count != 0)\n                append(digits[--count]);\n            append(' ');\n        }\n        append('\\n');\n    }\n};\n\nvector<int> vertexSignatures(const adjacency_matrix &graph) {\n    vector<int> signatures(graph.vertices);\n    for (int i = 0; i < graph.vertices; ++i) {\n        const unsigned char *row = graph.row(i);\n        int population = 0;\n        for (int j = 0; j < graph.vertices; ++j)\n            population += row[j];\n        signatures[i] = 2 * population + row[i];\n    }\n    return signatures;\n}\n\nstruct ConstraintRow {\n    int vertex;\n    int begin;\n    int end;\n    unsigned char expected;\n};\n\nstruct VerificationPlan {\n    vector<ConstraintRow> rows;\n    vector<int> columns;\n\n    explicit VerificationPlan(const adjacency_matrix &graph) {\n        const int n = graph.vertices;\n        rows.reserve(static_cast<size_t>(n));\n        columns.reserve(graph.entries.size() / 4);\n        for (int i = 0; i < n; ++i) {\n            const unsigned char *source = graph.row(i);\n            int ones = 0;\n            for (int j = i + 1; j < n; ++j)\n                ones += source[j];\n            const int remaining = n - i - 1;\n            const unsigned char expected = ones <= remaining - ones ? 1 : 0;\n            const int begin = static_cast<int>(columns.size());\n            for (int j = i + 1; j < n; ++j) {\n                if (source[j] == expected)\n                    columns.push_back(j);\n            }\n            const int end = static_cast<int>(columns.size());\n            if (begin != end)\n                rows.push_back(ConstraintRow{i, begin, end, expected});\n        }\n    }\n\n    bool verify(const adjacency_matrix &target, const vector<int> &equivalence) const {\n        // All assignments must already match loop status and row population.\n        // Earlier rows establish the entries preceding each row's suffix.\n        // Equal remaining populations make the suffix's majority entries\n        // implicit once every stored minority entry has matched.\n        const unsigned char *base = target.entries.data();\n        const size_t stride = static_cast<size_t>(target.vertices);\n        const int *mapping = equivalence.data();\n        const int *positions = columns.data();\n        for (const ConstraintRow &row : rows) {\n            const unsigned char *target_row =\n                base + static_cast<size_t>(mapping[row.vertex]) * stride;\n            for (int k = row.begin; k < row.end; ++k) {\n                if (target_row[mapping[positions[k]]] != row.expected)\n                    return false;\n            }\n        }\n        return true;\n    }\n};\n\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2) {\n    if (g1.vertices != g2.vertices)\n        return false;\n\n    const int n = g1.vertices;\n    vector<int> equivalence(n);\n    for (int i = 0; i < n; ++i)\n        equivalence[i] = i;\n\n    PermutationWriter output;\n    if (g1.entries == g2.entries) {\n        output.print(equivalence);\n        return true;\n    }\n\n    const vector<int> signatures1 = vertexSignatures(g1);\n    const vector<int> signatures2 = vertexSignatures(g2);\n    vector<int> sorted1 = signatures1;\n    vector<int> sorted2 = signatures2;\n    sort(sorted1.begin(), sorted1.end());\n    sort(sorted2.begin(), sorted2.end());\n    if (sorted1 != sorted2)\n        return false;\n\n    const size_t stride = static_cast<size_t>(n);\n    vector<unsigned char> incompatible(stride * stride);\n    int incompatible_count = 0;\n    for (int i = 0; i < n; ++i) {\n        unsigned char *row = incompatible.data() + static_cast<size_t>(i) * stride;\n        for (int j = 0; j < n; ++j)\n            row[j] = signatures1[i] != signatures2[j];\n        incompatible_count += row[i];\n    }\n\n    const VerificationPlan plan(g1);\n    vector<int> exchange_counter(n, 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    // Preserve the reference's complete Heap sequence after identity fails.\n    while (exchange_index < n) {\n        int &counter = exchange_counter[exchange_index];\n        if (counter < exchange_index) {\n            const int a = (exchange_index & 1) ? counter : 0;\n            const int b = exchange_index;\n            const int old_a = equivalence[a];\n            const int old_b = equivalence[b];\n            const unsigned char *row_a =\n                incompatible.data() + static_cast<size_t>(a) * stride;\n            const unsigned char *row_b =\n                incompatible.data() + static_cast<size_t>(b) * stride;\n            incompatible_count += row_a[old_b] + row_b[old_a]\n                                - row_a[old_a] - row_b[old_b];\n            swap(equivalence[a], equivalence[b]);\n\n            if (incompatible_count == 0 && plan.verify(g2, equivalence)) {\n                output.print(equivalence);\n                isomorphism_found = true;\n            }\n            ++counter;\n            exchange_index = 1;\n        } else {\n            counter = 0;\n            ++exchange_index;\n        }\n    }\n    return isomorphism_found;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n    if (!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\\n\";\n    return 0;\n}\n",
      "path": "src/brute_isomorphism.cpp"
    }

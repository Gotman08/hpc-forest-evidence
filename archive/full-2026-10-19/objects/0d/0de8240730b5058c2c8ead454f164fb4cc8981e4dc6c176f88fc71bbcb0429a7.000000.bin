{
  "src/solution.cpp": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<vector<int>> blockedRows(n);\n    for (int c = 0; c < m; ++c) {\n        int y, x;\n        cin >> y >> x;\n        blockedRows[y].push_back(x);\n    }\n    for (vector<int>& row : blockedRows) {\n        sort(row.begin(), row.end());\n        row.erase(unique(row.begin(), row.end()), row.end());\n    }\n\n    vector<int> prev(n, 0), next(n, 0);\n    prev[0] = 1;\n\n    if (n < 8192) {\n        for (int row = 0; row < n; ++row) {\n            const vector<int>& obstacles = blockedRows[row];\n            vector<int>::const_iterator it = obstacles.begin();\n            int running = 0;\n            for (int x = 0; x < n; ++x) {\n                while (it != obstacles.end() && *it < x) ++it;\n                if (it != obstacles.end() && *it == x) {\n                    running = 0;\n                } else {\n                    running += prev[x];\n                    if (running >= MOD) running -= MOD;\n                }\n                next[x] = running;\n            }\n            prev.swap(next);\n        }\n    } else {\n        const int chunks = 4;\n        vector<int> firstBlocked(chunks), tailSum(chunks), incoming(chunks);\n\n        #pragma omp parallel num_threads(4) shared(prev, next, blockedRows, firstBlocked, tailSum, incoming)\n        {\n            for (int row = 0; row < n; ++row) {\n                const vector<int>& obstacles = blockedRows[row];\n\n                #pragma omp for schedule(static)\n                for (int c = 0; c < chunks; ++c) {\n                    const int lo = n * c / chunks;\n                    const int hi = n * (c + 1) / chunks;\n                    vector<int>::const_iterator it = lower_bound(obstacles.begin(), obstacles.end(), lo);\n                    int running = 0;\n                    firstBlocked[c] = -1;\n                    for (int x = lo; x < hi; ++x) {\n                        if (it != obstacles.end() && *it == x) {\n                            if (firstBlocked[c] == -1) firstBlocked[c] = x;\n                            running = 0;\n                            ++it;\n                        } else {\n                            running += prev[x];\n                            if (running >= MOD) running -= MOD;\n                        }\n                        next[x] = running;\n                    }\n                    tailSum[c] = running;\n                }\n\n                #pragma omp single\n                {\n                    int carry = 0;\n                    for (int c = 0; c < chunks; ++c) {\n                        incoming[c] = carry;\n                        if (firstBlocked[c] == -1) {\n                            carry += tailSum[c];\n                            if (carry >= MOD) carry -= MOD;\n                        } else {\n                            carry = tailSum[c];\n                        }\n                    }\n                }\n\n                #pragma omp for schedule(static)\n                for (int c = 0; c < chunks; ++c) {\n                    const int lo = n * c / chunks;\n                    const int hi = n * (c + 1) / chunks;\n                    const int end = firstBlocked[c] == -1 ? hi : firstBlocked[c];\n                    for (int x = lo; x < end; ++x) {\n                        next[x] += incoming[c];\n                        if (next[x] >= MOD) next[x] -= MOD;\n                    }\n                }\n\n                #pragma omp single\n                {\n                    prev.swap(next);\n                }\n            }\n        }\n    }\n\n    cout << prev[n - 1] << '\\n';\n    return 0;\n}\n"
}

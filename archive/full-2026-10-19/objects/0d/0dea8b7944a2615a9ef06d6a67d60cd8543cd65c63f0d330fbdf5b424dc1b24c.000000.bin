        "hypothesis": "Using independent columns as ARM64 SIMD lanes can accelerate bubble sorting and fused mean calculations without reassociating floating-point reductions.",
        "id": "70fe79ab77e84d22",
        "ordinal": 1,
        "parent_id": null,
        "role": "B",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/est_matriz_seq.c"
          ],
          "retained": [
            "Process two columns per NEON bubble-sort pass using register-carried elements and comparison-mask selections, preserving each column's comparison sequence and equal-value ordering.",
            "Fuse arithmetic and harmonic mean scans with exact SIMD division and row-ordered, independent per-column accumulators.",
            "Provide compile-time scalar fallbacks and scalar handling of odd column counts; introduce no threading or additional allocations."
          ]
        },
        "tree_id": "e1:B",
        "trial_id": "01M54GGB3FXCHHVKCW70ZQQ2GW",

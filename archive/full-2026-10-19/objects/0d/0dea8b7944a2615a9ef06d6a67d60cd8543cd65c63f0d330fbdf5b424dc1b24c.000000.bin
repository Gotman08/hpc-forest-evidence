        "epoch": 1,
        "hypothesis": "Cache-local insertion runs followed by sequential, stable merges should reduce column sorting work and memory traffic from quadratic to O(rows log rows), using one reusable column-sized workspace.",
        "id": "1c45aaeb96ea4813",
        "ordinal": 1,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/est_matriz_seq.c"
          ],
          "retained": [
            "Sort contiguous columns using stable 32-element insertion runs and bottom-up ping-pong merges; reuse one workspace across columns.",
            "Retain bubble sorting for NaN-containing columns or workspace allocation failure, preserving equal-value stability and signed-zero ordering.",
            "Replace the mode counter allocation with an initialized scalar while retaining comparison order and float narrowing.",
            "Leave numerical accumulation order, metric scheduling and input/output formatting unchanged."
          ]
        },

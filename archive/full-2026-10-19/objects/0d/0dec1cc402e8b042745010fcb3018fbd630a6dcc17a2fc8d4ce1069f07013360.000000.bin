      "content": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nint A[1000][1000];\nint ps[1010][1010];\n\ntypedef long long ll;\n\nll solve(int m, int n, int k) {\n  for (int i = 1; i <= m; i++) {\n    ps[i][0] = 0;\n    for (int j = 1; j <= n; j++) {\n      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\n    }\n  }\n\n  // Flatten the triangular boundary-pair space into equal-cost work items.\n  vector<int> pair_starts(n + 1, 0);\n  for (int left = 0; left < n; left++) {\n    pair_starts[left + 1] = pair_starts[left] + n - left;\n  }\n  const int pair_count = pair_starts[n];\n\n  auto count_range = [&](int first, int last, unordered_map<ll, ll>& h) -> ll {\n    int j = int(upper_bound(pair_starts.begin(), pair_starts.end(), first)\n                - pair_starts.begin());\n    int l = j + first - pair_starts[j - 1];\n    ll subtotal = 0;\n    for (int p = first; p < last; p++) {\n      h.clear();\n      h[0] = 1;\n      ll s = 0;\n      for (int i = 1; i <= m; i++) {\n        s += ps[i][l] - ps[i][j - 1];\n        subtotal += h.find(s - k) != h.end() ? h[s - k] : 0;\n        h[s]++;\n      }\n      if (++l > n) {\n        ++j;\n        l = j;\n      }\n    }\n    return subtotal;\n  };\n\n  const ll work = ll(pair_count) * m;\n  int num_threads = work >= 262144 ? 4 : (work >= 65536 ? 2 : 1);\n  num_threads = min(num_threads, pair_count);\n  if (num_threads == 1) {\n    unordered_map<ll, ll> h;\n    h.reserve(m + 1);\n    return count_range(0, pair_count, h);\n  }\n\n  // Coarse chunks amortize queue traffic while permitting dynamic balancing.\n  const int chunk = max(1, min(64, pair_count / (32 * num_threads)));\n  atomic<int> next_pair(0);\n  ll partials[4] = {};\n  auto worker = [&](int tid) {\n    unordered_map<ll, ll> h;\n    h.reserve(m + 1);\n    ll subtotal = 0;\n    for (;;) {\n      const int first = next_pair.fetch_add(chunk, memory_order_relaxed);\n      if (first >= pair_count) break;\n      subtotal += count_range(first, min(first + chunk, pair_count), h);\n    }\n    partials[tid] = subtotal;\n  };\n\n  thread workers[3];\n  for (int tid = 1; tid < num_threads; tid++) {\n    workers[tid - 1] = thread(worker, tid);\n  }\n  worker(0);\n  for (int tid = 1; tid < num_threads; tid++) {\n    workers[tid - 1].join();\n  }\n\n  ll ans = 0;\n  for (int tid = 0; tid < num_threads; tid++) {\n    ans += partials[tid];\n  }\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n  memset(ps, 0, sizeof ps);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n",
      "path": "src/main.cpp"
    }
  ],
  "hypothesis": "Dynamically distributing coarse chunks of flattened boundary pairs should balance triangular work and data-dependent counting costs, while workload-based thread granularity limits launch overhead.",

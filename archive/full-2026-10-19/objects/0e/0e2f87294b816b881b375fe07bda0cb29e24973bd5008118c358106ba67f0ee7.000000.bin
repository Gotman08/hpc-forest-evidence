    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\ntypedef struct {\\n    float dist;\\n    char label;\\n    unsigned long seq;\\n} HeapItem;\\n\\nstatic inline int worse(const HeapItem *a, const HeapItem *b) {\\n    if (a->dist > b->dist) return 1;\\n    if (a->dist < b->dist) return 0;\\n    return a->seq > b->seq;\\n}\\n\\nstatic inline void swap_items(HeapItem *a, HeapItem *b) {\\n    HeapItem t = *a;\\n    *a = *b;\\n    *b = t;\\n}\\n\\nstatic inline void sift_up(HeapItem *heap, int idx) {\\n    while (idx > 0) {\\n        int parent = (idx - 1) / 2;\\n        if (!worse(&heap[idx], &heap[parent])) break;\\n        swap_items(&heap[idx], &heap[parent]);\\n        idx = parent;\\n    }\\n}\\n\\nstatic inline void sift_down(HeapItem *heap, int size, int idx) {\\n    for (;;) {\\n        int left = 2 * idx + 1;\\n        if (left >= size) break;\\n        int right = left + 1;\\n        int worst_child = left;\\n        if (right < size && worse(&heap[right], &heap[left])) {\\n            worst_child = right;\\n        }\\n        if (!worse(&heap[worst_child], &heap[idx])) break;\\n        swap_items(&heap[idx], &heap[worst_child]);\\n        idx = worst_child;\\n    }\\n}\\n\\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n    if (k <= 0) return '\\\\0';\\n\\n    HeapItem *heap = (HeapItem *) malloc(sizeof(HeapItem) * (size_t)k);\\n    if (!heap) exit(1);\\n\\n    int counts[256] = {0};\\n    int heap_size = 0;\\n    unsigned long seq = 0;\\n\\n    float qx = to_evaluate.x;\\n    float qy = to_evaluate.y;\\n\\n    for (int i = 0; i < n_groups; ++i) {\\n        Group g = groups[i];\\n        char label = g.label;\\n        Point *pts = g.points;\\n        int len = g.length;\\n\\n        for (int j = 0; j < len; ++j) {\\n            // Prefetch points ahead to reduce cache misses on sequential scan.\\n            if (j + 8 < len) {\\n                __builtin_prefetch(&pts[j + 8], 0, 3);\\n            }\\n\\n            float dx = pts[j].x - qx;\\n            float dy = pts[j].y - qy;\\n            float d = dx * dx + dy * dy;\\n\\n            if (heap_size < k) {\\n                heap[heap_size].dist = d;\\n                heap[heap_size].label = label;\\n                heap[heap_size].seq = seq++;\\n                counts[(unsigned char)label]++;\\n                ++heap_size;\\n                sift_up(heap, heap_size - 1);\\n            } else if (d < heap[0].dist) {\\n                counts[(unsigned char)heap[0].label]--;\\n                heap[0].dist = d;\\n                heap[0].label = label;\\n                heap[0].seq = seq++;\\n                counts[(unsigned char)label]++;\\n                sift_down(heap, k, 0);\\n            }\\n        }\\n    }\\n\\n    if (heap_size < k) {\\n        counts[(unsigned char)-1] += k - heap_size;\\n    }\\n\\n    free(heap);\\n\\n    char best = 0;\\n    int best_count = -1;\\n\\n    for (int c = -128; c <= 127; ++c) {\\n        int cnt = counts[(unsigned char)c];\\n        if (cnt > best_count) {\\n            best_count = cnt;\\n            best = (char)c;\\n        }\\n    }\\n\\n    return best;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Software prefetching of upcoming points in the inner distance loop reduces cache miss latency during the sequential scan over each group's point array, while hoisting query coordinates into registers avoids repeated loads and improves memory-level parallelism.\",\n  \"notes\": \"Only src/knn.c was modified. The heap-based selection logic, tie-breaking by arrival sequence
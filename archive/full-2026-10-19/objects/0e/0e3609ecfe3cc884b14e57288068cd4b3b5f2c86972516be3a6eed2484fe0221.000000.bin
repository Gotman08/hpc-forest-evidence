nn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n+    char * labels = (char *) malloc(sizeof(char) * k);\\n+    float * distances = (float *) malloc(sizeof(float) * k);\\n+\\n+    int i, j, x, y;\\n+\\n+    for (i = 0; i < k; i++) {\\n+        labels[i] = -1;\\n+        distances[i] = -1;\\n+    }\\n+\\n+    for (i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+\\n+        for (j = 0; j < g.length; j++) {\\n+            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n+\\n+            /* Avoid scanning a full list when this point cannot enter it. */\\n+            if (k > 0 && distances[k - 1] != -1.0f &&\\n+                d >= distances[k - 1]) {\\n+                continue;\\n+            }\\n+\\n+            for (x = 0; x < k; x++) {\\n+                if (d < distances[x] || distances[x] == -1) {\\n+                    for (y = k - 1; y > x; y--) {\\n+                        distances[y] = distances[y - 1];\\n+                        labels[y] = labels[y - 1];\\n+                    }\\n+\\n+                    distances[x] = d;\\n+                    labels[x] = g.label;\\n+\\n+                    break;\\n+                }\\n+            }\\n+        }\\n+    }\\n+\\n+    qsort(labels, k, sizeof(char), compare_for_sort);\\n+\\n+    char most_frequent = labels[0];\\n+    int most_frequent_count = 1;\\n+    int current_frequency = 1;\\n+\\n+    for (i = 1; i < k; i++) {\\n+        if (labels[i] != labels[i - 1]) {\\n+            if (current_frequency > most_frequent_count) {\\n+                most_frequent = labels[i - 1];\\n+                most_frequent_count = current_frequency;\\n+            }\\n+\\n+            current_frequency = 1;\\n+        } else {\\n+            current_frequency++;\\n+        }\\n+\\n+        if (i == k - 1 && current_frequency > most_frequent_count) {\\n+            most_frequent = labels[i - 1];\\n+            most_frequent_count = current_frequency;\\n+        }\\n+    }\\n+\\n+\\n+    return most_frequent;\\n+}\\n+\\n+int main() {\\n+    int n_groups = parse_number_of_groups();\\n+    \\n+    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n+\\n+    for (int i = 0; i < n_groups; i++) {\\n+        groups[i] = parse_next_group();\\n+    }\\n+\\n+    int k = parse_k();\\n+\\n+    Point to_evaluate = parse_point();\\n+\\n+    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n+}\"}, {\"id\": \"5d756600c9124102\", \"role\": \"A\", \"commit\": \"f5f27fee0ae2b748f3a6c802937ff5f8bd7525d5\", \"transformations\": {\"files\": [\"src/knn.c\"], \"retained\": [\"Compute squared distances for up to 256 consecutive points into a stack-resident tile, then apply the original neighbor-selection logic in traversal order.\"]}, \"mean_seconds\": 2.037849197474619, \"diff\": \"diff --git a/src/knn.c b/src/knn.c\\nindex 337e3b9..526ffe4 100644\\n--- a/src/knn.c\\n+++ b/src/knn.c\\n@@ -1,78 +1,94 @@\\n-#include \\\"knn.h\\\"\\n-\\n-char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n-    char * labels = (char *) malloc(sizeof(char) * k);\\n-    float * distances = (float *) malloc(sizeof(float) * k);\\n-\\n-    int i, j, x, y;\\n-\\n-    for (i = 0; i < k; i++) {\\n-        labels[i] = -1;\\n-        distances[i] = -1;\\n-    }\\n-\\n-    for (i = 0; i < n_groups; i++) {\\n-        Group g = groups[i];\\n-\\n-        for (j = 0; j < g.length; j++) {\\n-            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n-\\n-            for (x = 0; x < k; x++) {\\n-                if (d < distances[x] || distances[x] == -1) {\\n-                    for (y = k - 1; y > x; y--) {\\n-                        distances[y] = distances[y - 1];\\n-                        labels[y] = labels[y - 1];\\n-                    }\\n-\\n-                    distances[x] = d;\\n-                    labels[x] = g.label;\\n-\\n-                    break;\\n-                }\\n-            }\\n-        }\\n-    }\\n-\\n-    qsort(labels, k, sizeof(char), compare_for_sort);\\n-\\n-    char most_frequent = labels[0];\\n-    int most_frequent_count = 1;\\n-    int current_frequency = 1;\\n-\\n-    for (i = 1; i < k; i++) {\\n-        if (labels[i] != labels[i - 1]) {\\n-            if (current_frequency > most_frequent_count) {\\n-                most_frequent = labels[i - 1];\\n-                most_frequent_count = current_frequency;\\n-            }\\n-\\n-            current_frequency = 1;\\n-        } else {\\n-            current_frequency++;\\n-        }\\n-\\n-        if (i == k - 1 && current_frequency > most_frequent_count) {\\n-            most_frequent = labels[i - 1];\\n-            most_frequent_count = current_frequency;\\n-        }\\n-    }\\n-\\n-\\n-    return most_frequent;\\n-}\\n-\\n-int main() {\\n-    int n_groups = parse_number_of_groups();\\n-    \\n-    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n-\\n-    for (int i = 0; i < n_groups; i++) {\\n-        groups[i] = parse_next_group();\\n-    }\\n-\\n-    int k = parse_k();\\n-\\n-    Point to_evaluate = parse_point();\\n-\\n-    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n-}\\n\\\\ No newline at end of file\\n+#include \\\"knn.h\\\"\\n+\\n+char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n+    char * labels = (char *) malloc(sizeof(char) * k);\\n+    float * distances = (float *) malloc(sizeof(float) * k);\\n+\\n+    enum { DISTANCE_BLOCK_SIZE = 256 };\\n+    float block_distances[DISTANCE_BLOCK_SIZE];\\n+    int i, j, x, y;\\n+\\n+    for (i = 0; i < k; i++) {\\n+        labels[i] = -1;\\n+        distances[i] = -1;\\n+    }\\n+\\n+    for (i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+\\n+        for (j = 0; j < g.length;) {\\n+            int block_length = g.length - j;\\n+            if (block_length > DISTANCE_BLOCK_SIZE) {\\n+                block_length = DISTANCE_BLOCK_SIZE;\\n+            }\\n+\\n+            for (int p = 0; p < block_length; p++) {\\n+                block_distances[p] = euclidean_distance_no_sqrt(\\n+                    to_evaluate, g.points[j + p]);\\n+            }\\n+\\n+            for (int p = 0; p < block_length; p++) {\\n+                float d = block_distances[p];\\n+\\n+                for (x = 0; x < k; x++) {\\n+                    if (d < distances[x] || distances[x] == -1) {\\n+                        for (y = k - 1; y > x; y--) {\\n+                            distances[y] = distances[y - 1];\\n+                            labels[y] = labels[y - 1];\\n+                        }\\n+\\n+                        distances[x] = d;\\n+                        labels[x] = g.label;\\n+\\n+                        break;\\n+                    }\\n+                }\\n+            }\\n+\\n+            j += block_length;\\n+        }\\n+    }\\n+\\n+    qsort(labels, k, sizeof(char), compare_for_sort);\\n+\\n+    char most_frequent = labels[0];\\n+    int most_frequent_count = 1;\\n+    int current_frequency = 1;\\n+\\n+    for (i = 1; i < k; i++) {\\n+        if (labels[i] != labels[i - 1]) {\\n+            if (current_frequency > most_frequent_count) {\\n+                most_frequent = labels[i - 1];\\n+                most_frequent_count = current_frequency;\\n+            }\\n+\\n+            current_frequency = 1;\\n+        } else {\\n+            current_frequency++;\\n+        }\\n+\\n+        if (i == k - 1 && current_frequency > most_frequent_count) {\\n+            most_frequent = labels[i - 1];\\n+            most_frequent_count = current_frequency;\\n+        }\\n+    }\\n+\\n+\\n+    return most_frequent;\\n+}\\n+\\n+int main() {\\n+    int n_groups = parse_number_of_groups();\\n+    \\n+    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n+\\n+    for (int i = 0; i < n_groups; i++) {\\n+        groups[i] = parse_next_group();\\n+    }\\n+\\n+    int k = parse_k();\\n+\\n+    Point to_evaluate = parse_point();\\n+\\n+    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n+}\"}], \"automatic_observations\": {\"baseline\": {\"experiment_id\": \"baseline-e1\", \"outcome\": {\"binary_sha256\": \"36586c1741b2b272c1d9e7d0368680ec8a17544468dea5a146a4c607fe28c41f\", \"cache_key\": \"88d9275812bdb6e43b89a4625cc11d7b5f05d413b2e286f73a0b0dcebdaa0f80\", \"commit\": \"4b38fdc6c6765e219947428c10b0a83c84343b4c\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-harness-comparison-20261016-r1-source-only-gpt-6.1-sol-max-665743a02b824021a697b6a4884a667c/run/results-751592/2022-knn/logs/e1/baseline-e1/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-harness-comparison-20261016-r1-source-only-gpt-6.1-sol-max-665743a02b824021a697b6a4884a667c/run/results-751592/2022-knn/logs/e1/baseline-e1/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-harness-comparison-20261016-r1-source-only-gpt-6.1-sol-max-665743a02b824021a697b6a4884a667c/run/results-751592/2022-knn/logs/e1/baseline-e1/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-harness-comparison-20261016-r1-source-only-gpt-6.1-sol-max-665743a02b824021a697b6a4884a667c/run/results-751592/2022-knn/logs/e1/baseline-e1/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-harness-comparison-20261016-r1-source-only-gpt-6.1-sol-max-665743a02b824021a697b6a4884a667c/run/results-751592/2022-knn/logs/e1/baseline-e1/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-harness-comparison-20261016-r1-source-only-gpt-6.1-sol-max-665743a02b824021a697b6a4884a667c/run/results-751592/2022-knn/logs/e1/baseline-e1/search/attempt-001/sample-2.log\"], \"mean_seconds\": 2.0622209093223014, \"reason\": \"\", \"score\": 0.5, \"status\": \"valid\", \"times\": [2.094636093825102, 2.1010787403210998, 1.990947893820703], \"tree_hash\": \"ca82542605ae0cd806fbb756ddba0161138096c5\"}, \"raw_logs\": [{\"path\": \"logs/e1/
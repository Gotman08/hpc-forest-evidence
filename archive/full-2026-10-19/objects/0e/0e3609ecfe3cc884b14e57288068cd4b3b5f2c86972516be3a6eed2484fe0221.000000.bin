al_points < (size_t)k ? total_points : (size_t)k;\\n+    const size_t min_parallel_work = 65536;\\n+    if (total_points < min_parallel_work &&\\n+        total_points * effective_k < min_parallel_work) return 0;\\n+\\n+    NeighborBlock *blocks = (NeighborBlock *)calloc((size_t)max_threads,\\n+                                                   sizeof(NeighborBlock));\\n+    if (blocks == NULL) return 0;\\n+\\n+    int used_threads = 0;\\n+    int failed = 0;\\n+    int has_nan = 0;\\n+\\n+    #pragma omp parallel reduction(|:failed, has_nan)\\n+    {\\n+        int tid = omp_get_thread_num();\\n+        int team = omp_get_num_threads();\\n+        if (tid == 0) used_threads = team;\\n+\\n+        size_t base = total_points / (size_t)team;\\n+        size_t extra = total_points % (size_t)team;\\n+        size_t begin = base * (size_t)tid +\\n+                       ((size_t)tid < extra ? (size_t)tid : extra);\\n+        size_t count = base + ((size_t)tid < extra);\\n+        size_t end = begin + count;\\n+        int capacity = count < (size_t)k ? (int)count : k;\\n+        NeighborBlock *block = &blocks[tid];\\n+        block->count = capacity;\\n+\\n+        if (capacity > 0) {\\n+            block->labels = (char *)malloc((size_t)capacity * sizeof(char));\\n+            block->distances = (float *)malloc((size_t)capacity * sizeof(float));\\n+            if (block->labels == NULL || block->distances == NULL) {\\n+                failed = 1;\\n+            } else {\\n+                char *local_labels = block->labels;\\n+                float *local_distances = block->distances;\\n+                for (int x = 0; x < capacity; x++) {\\n+                    local_labels[x] = -1;\\n+                    local_distances[x] = -1;\\n+                }\\n+\\n+                /* Each block follows a consecutive part of the original traversal. */\\n+                size_t offset = 0;\\n+                for (int i = 0; i < n_groups && offset < end; i++) {\\n+                    Group g = groups[i];\\n+                    size_t length = g.length > 0 ? (size_t)g.length : 0;\\n+                    size_t group_end = offset + length;\\n+                    if (group_end > begin) {\\n+                        size_t first = begin > offset ? begin - offset : 0;\\n+                        size_t last = end < group_end ? end - offset : length;\\n+                        for (size_t j = first; j < last; j++) {\\n+                            float d = euclidean_distance_no_sqrt(to_evaluate,\\n+                                                                 g.points[j]);\\n+                            if (d != d) has_nan = 1;\\n+\\n+                            for (int x = 0; x < capacity; x++) {\\n+                                if (d < local_distances[x] || local_distances[x] == -1) {\\n+                                    for (int y = capacity - 1; y > x; y--) {\\n+                                        local_distances[y] = local_distances[y - 1];\\n+                                        local_labels[y] = local_labels[y - 1];\\n+                                    }\\n+                                    local_distances[x] = d;\\n\"}, {\"id\": \"18e847cfeeae47c9\", \"role\": \"A\", \"commit\": \"29568662504274e1d0448a46e29d2080f8414f6a\", \"transformations\": {\"files\": [\"src/knn.c\"], \"retained\": [\"Add a tail-first admission check that skips the forward candidate-buffer scan when the buffer is full and the new distance is at least its worst retained distance.\"]}, \"mean_seconds\": 1.98599351507922, \"diff\": \"diff --git a/src/knn.c b/src/knn.c\\nindex 337e3b9..3e11ea1 100644\\n--- a/src/knn.c\\n+++ b/src/knn.c\\n@@ -1,78 +1,84 @@\\n-#include \\\"knn.h\\\"\\n-\\n-char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n-    char * labels = (char *) malloc(sizeof(char) * k);\\n-    float * distances = (float *) malloc(sizeof(float) * k);\\n-\\n-    int i, j, x, y;\\n-\\n-    for (i = 0; i < k; i++) {\\n-        labels[i
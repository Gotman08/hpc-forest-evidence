ile\\n+#include \\\"knn.h\\\"\\n+#include <limits.h>\\n+#include <stdint.h>\\n+#include <string.h>\\n+#ifdef _OPENMP\\n+#include <omp.h>\\n+#endif\\n+\\n+typedef struct {\\n+    size_t order;\\n+    float distance;\\n+    char label;\\n+} KnnCandidate;\\n+\\n+typedef struct {\\n+    KnnCandidate *heap;\\n+    size_t count;\\n+    int fallback;\\n+} KnnLocal;\\n+\\n+static int knn_distance_is_nan(float value) {\\n+    uint32_t bits;\\n+    memcpy(&bits, &value, sizeof(bits));\\n+    return (bits & UINT32_C(0x7fffffff)) > UINT32_C(0x7f800000);\\n+}\\n+\\n+static int knn_worse(KnnCandidate a, KnnCandidate b) {\\n+    return a.distance > b.distance ||\\n+           (a.distance == b.distance && a.order > b.order);\\n+}\\n+\\n+static void knn_heap_sift_down(KnnCandidate *heap, size_t count, size_t root) {\\n+    KnnCandidate value = heap[root];\\n+    while (root < count / 2) {\\n+        size_t child = root * 2 + 1;\\n+        if (child + 1 < count && knn_worse(heap[child + 1], heap[child])) {\\n+            ++child;\\n+        }\\n+        if (!knn_worse(heap[child], value)) {\\n+            break;\\n+        }\\n+        heap[root] = heap[child];\\n+        root = child;\\n+    }\\n+    heap[root] = value;\\n+}\\n+\\n+static void knn_heap_build(KnnCandidate *heap, size_t count) {\\n+    for (size_t i = count / 2; i > 0; --i) {\\n+        knn_heap_sift_down(heap, count, i - 1);\\n+    }\\n+}\\n+\\n+static void knn_heap_offer(KnnCandidate *heap, size_t *count,\\n+                           size_t capacity, KnnCandidate candidate) {\\n+    if (*count < capacity) {\\n+        heap[*count] = candidate;\\n+        ++(*count);\\n+        if (*count == capacity) {\\n+            knn_heap_build(heap, capacity);\\n+        }\\n+    } else if (knn_worse(heap[0], candidate)) {\\n+        heap[0] = candidate;\\n+        knn_heap_sift_down(heap, capacity, 0);\\n+    }\\n+}\\n+\\n+static char knn_vote(const size_t *counts) {\\n+    char best = (char)CHAR_MIN;\\n+    size_t best_count = 0;\\n+    for (int label = CHAR_MIN; label <= CHAR_MAX; ++label) {\\n+        size_t count = counts[(unsigned char)(char)label];\\n+        if (count > best_count) {\\n+            best = (char)label;\\n+            best_count = count;\\n+        }\\n+    }\\n+    return best;\\n+}\\n+\\n+static void knn_free_locals(KnnLocal *locals, int count) {\\n+    for (int i = 0; i < count; ++i) {\\n+        free(locals[i].heap);\\n+    }\\n+    free(locals);\\n+}\\n+\\n+static char knn_serial_reference(int n_groups, Group *groups,\\n+                                 int k, Point to_evaluate) {\\n+    char *labels = (char *)malloc(sizeof(char) * k);\\n+    float *distances = (float *)malloc(sizeof(float) * k);\\n+    int i, j, x, y;\\n+\\n+    for (i = 0; i < k; i++) {\\n+        labels[i] = -1;\\n+        distances[i] = -1;\\n+    }\\n+\\n+    for (i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+        for (j = 0; j < g.length; j++) {\\n+            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n+            for (x = 0; x < k; x++) {\\n+                if (d < distances[x] || distances[x] == -1) {\\n+                    for (y = k - 1; y > x; y--) {\\n+                        distances[y] = distances[y - 1];\\n+                        labels[y] = labels[y - 1];\\n+                    }\\n+                    distances[x] = d;\\n+                    labels[x] = g.label;\\n+                    break;\\n+                }\\n+            }\\n+        }\\n+    }\\n+\\n+    qsort(labels, k, sizeof(char), compare_for_sort);\\n+    char most_frequent = labels[0];\\n+    int most_frequent_count = 1;\\n+    int current_frequency = 1;\\n+\\n+    for (i = 1; i < k; i++) {\\n+        if (labels[i] != labels[i - 1]) {\\n+            if (current_frequency > most_frequent_count) {\\n+                most_frequent = labels[i - 1];\\n+                most_frequent_count = current_frequency;\\n+            }\\n+            current_frequency = 1;\\n+        } else {\\n+            current_frequency++;\\n+        }\\n+    \"}, {\"id\": \"cde95641e31d4132\", \"role\": \"C\", \"commit\": \"2e07504234fa9cd803c7c6d67108b1ebe406d7e9\", \"transformations\": {\"files\": [\"src/knn.c\"], \"retained\": [\"Partition the original point traversal into balanced contiguous blocks using the runtime OpenMP team size, with the original insertion algorithm applied independently per block.\", \"Merge sorted local lists using strict distance comparisons and earlier-block precedence for ties, preserving sentinel padding when k exceeds the point count.\", \"Retain serial execution for small workloads, nested calls, unavailable OpenMP, NaN distances or scratch-allocation failure; release temporary storage after each call.\"]}, \"mean_seconds\": 0.17754479901244244, \"diff\": \"diff --git a/src/knn.c b/src/knn.c\\nindex 337e3b9..51d7f59 100644\\n--- a/src/knn.c\\n+++ b/src/knn.c\\n@@ -1,78 +1,218 @@\\n-#include \\\"knn.h\\\"\\n-\\n-char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n-    char * labels = (char *) malloc(sizeof(char) * k);\\n-    float * distances = (float *) malloc(sizeof(float) * k);\\n-\\n-    int i, j, x, y;\\n-\\n-    for (i = 0; i < k; i++) {\\n-        labels[i] = -1;\\n-        distances[i] = -1;\\n-    }\\n-\\n-    for (i = 0; i < n_groups; i++) {\\n-        Group g = groups[i];\\n-\\n-        for (j = 0; j < g.length; j++) {\\n-            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n-\\n-            for (x = 0; x < k; x++) {\\n-                if (d < distances[x] || distances[x] == -1) {\\n-                    for (y = k - 1; y > x; y--) {\\n-                        distances[y] = distances[y - 1];\\n-                        labels[y] = labels[y - 1];\\n-                    }\\n-\\n-                    distances[x] = d;\\n-                    labels[x] = g.label;\\n-\\n-                    break;\\n-                }\\n-            }\\n-        }\\n-    }\\n-\\n-    qsort(labels,
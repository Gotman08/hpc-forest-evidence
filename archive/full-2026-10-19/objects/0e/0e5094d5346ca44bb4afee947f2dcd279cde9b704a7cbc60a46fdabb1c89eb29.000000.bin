#include <iostream>
#include <vector>
#include <utility>

using namespace std;

class adjacency_matrix {
public:
    explicit adjacency_matrix(size_t vertices = 0)
        : vertices_(vertices), values_(vertices * vertices, 0) {}

    size_t size() const { return vertices_; }

    unsigned char *operator[](size_t row) {
        return values_.data() + row * vertices_;
    }

    const unsigned char *operator[](size_t row) const {
        return values_.data() + row * vertices_;
    }

private:
    size_t vertices_;
    vector<unsigned char> values_;
};

adjacency_matrix readGraph();
bool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2);
bool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,
                       const int *equivalence, int n);
inline void printPermutation(const int *equivalence, int n);

int main() {
    adjacency_matrix g1 = readGraph();
    adjacency_matrix g2 = readGraph();

    if (!testIsomorphism(g1, g2))
        cout << "The graphs are not isomorphic" << endl;

    return 0;
}

bool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2) {
    if (g1.size() != g2.size()) return false;

    const int n = static_cast<int>(g1.size());
    vector<int> equivalence(n, 0);
    vector<int> exchange_counter(n, 0);
    int exchange_index = 1;
    bool isomorphism_found = false;

    for (int i = 0; i < n; ++i)
        equivalence[i] = i;

    if (verifyPermutation(g1, g2, equivalence.data(), n)) {
        printPermutation(equivalence.data(), n);
        return true;
    }

    // Keep a single team alive while Heap's algorithm produces bounded batches.
    // Dynamic chunks balance candidates whose early-exit verification costs vary.
    const int batch_capacity = 64;
    vector<int> batch(static_cast<size_t>(batch_capacity) * n);
    vector<unsigned char> matches;
    int batch_count = 0;
    bool done = false;

    #pragma omp parallel if(n >= 24)
    {
        while (true) {
            #pragma omp single
            {
                batch_count = 0;
                while (batch_count < batch_capacity && exchange_index < n) {
                    if (exchange_counter[exchange_index] < exchange_index) {
                        if (exchange_index % 2 == 0)
                            swap(equivalence[0], equivalence[exchange_index]);
                        else
                            swap(equivalence[exchange_counter[exchange_index]],
                                 equivalence[exchange_index]);

                        int *candidate = batch.data() +
                                         static_cast<size_t>(batch_count) * n;
                        for (int i = 0; i < n; ++i)
                            candidate[i] = equivalence[i];

                        ++batch_count;
                        ++exchange_counter[exchange_index];
                        exchange_index = 1;
                    } else {
                        exchange_counter[exchange_index] = 0;
                        ++exchange_index;
                    }
                }
                done = (batch_count == 0);
                matches.resize(batch_count);
            }

            if (done) break;

            #pragma omp for schedule(dynamic, 4)
            for (int k = 0; k < batch_count; ++k) {
                const int *candidate = batch.data() +
                                       static_cast<size_t>(k) * n;
                matches[k] = static_cast<unsigned char>(
                    verifyPermutation(g1, g2, candidate, n));
            }

            #pragma omp single
            {
                for (int k = 0; k < batch_count; ++k) {
                    if (matches[k]) {
                        const int *candidate = batch.data() +
                                               static_cast<size_t>(k) * n;
                        printPermutation(candidate, n);
                        isomorphism_found = true;
                    }
                }
            }
        }
    }

    return isomorphism_found;
}

adjacency_matrix readGraph() {
    int vertices, edges, source, destination;

    cin >> vertices;
    adjacency_matrix read(static_cast<size_t>(vertices));

    cin >> edges;
    for (int i = 0; i < edges; i++) {
        cin >> source >> destination;
        read[destination][source] = read[source][destination] = 1;
    }

    return read;
}

bool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,
                       const int *equivalence, int n) {
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j <= i; ++j) {
            if (g1[i][j] != g2[equivalence[i]][equivalence[j]]) return false;
        }
    }
    return true;
}

inline void printPermutation(const int *equivalence, int n) {
    for (int i = 0; i < n; ++i)
        cout << equivalence[i] << " ";
    cout << endl;
}

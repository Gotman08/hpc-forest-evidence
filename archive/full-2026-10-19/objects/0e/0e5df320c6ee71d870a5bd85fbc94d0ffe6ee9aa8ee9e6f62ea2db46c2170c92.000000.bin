    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n\\nstatic int is_worse(float da, long ia, float db, long ib) {\\n    return (da > db) || (da == db && ia > ib);\\n}\\n\\nstatic void swap3(float *hd, long *hi, char *hl, int a, int b) {\\n    float td = hd[a]; hd[a] = hd[b]; hd[b] = td;\\n    long ti = hi[a]; hi[a] = hi[b]; hi[b] = ti;\\n    char tc = hl[a]; hl[a] = hl[b]; hl[b] = tc;\\n}\\n\\nstatic void heap_push(float *hd, long *hi, char *hl, int *n,\\n                      float d, long idx, char label) {\\n    int i = (*n)++;\\n    hd[i] = d; hi[i] = idx; hl[i] = label;\\n\\n    while (i > 0) {\\n        int parent = (i - 1) / 2;\\n        if (is_worse(hd[i], hi[i], hd[parent], hi[parent])) {\\n            swap3(hd, hi, hl, i, parent);\\n            i = parent;\\n        } else {\\n            break;\\n        }\\n    }\\n}\\n\\nstatic void heap_replace_root(float *hd, long *hi, char *hl, int n,\\n                              float d, long idx, char label) {\\n    hd[0] = d; hi[0] = idx; hl[0] = label;\\n    int i = 0;\\n\\n    for (;;) {\\n        int left = 2 * i + 1;\\n        if (left >= n) break;\\n        int right = left + 1;\\n        int worst = i;\\n\\n        if (is_worse(hd[left], hi[left], hd[worst], hi[worst])) {\\n            worst = left;\\n        }\\n        if (right < n && is_worse(hd[right], hi[right], hd[worst], hi[worst])) {\\n            worst = right;\\n        }\\n\\n        if (worst == i) break;\\n        swap3(hd, hi, hl, i, worst);\\n        i = worst;\\n    }\\n}\\n\\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n    size_t total = 0;\\n    for (int gi = 0; gi < n_groups; ++gi) {\\n        total += (size_t)groups[gi].length;\\n    }\\n\\n    float *xs = NULL;\\n    if (posix_memalign((void **)&xs, 64, total * sizeof(float)) != 0) {\\n        xs = malloc(total * sizeof(float));\\n    }\\n    float *ys = NULL;\\n    if (posix_memalign((void **)&ys, 64, total * sizeof(float
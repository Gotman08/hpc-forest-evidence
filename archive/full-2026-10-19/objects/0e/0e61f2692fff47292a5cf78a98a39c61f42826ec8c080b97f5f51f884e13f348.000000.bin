#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <algorithm>
#include <limits>

int main() {
    int n, s;
    std::cin >> n >> s;
    std::vector<std::vector<int> > matrix(n, std::vector<int>(n));
    for (int i = 0; i < n; ++i)
        for (int j = 0; j < n; ++j)
            scanf("%d", &(matrix[i][j]));

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    std::vector<long long> columnSums(n, 0);
    long long* columns = columnSums.data();
    for (int r = 0; r < s; ++r) {
        const int* row = matrix[r].data();
        #pragma omp simd
        for (int c = 0; c < n; ++c)
            columns[c] += static_cast<long long>(row[c]);
    }

    long long mxSum = std::numeric_limits<long long>::lowest();
    for (int top = 0; top + s <= n; ++top) {
        long long sum = 0;
        #pragma omp simd reduction(+:sum)
        for (int c = 0; c < s; ++c)
            sum += columns[c];

        long long rowMax = sum;
        for (int c = s; c < n; ++c) {
            sum += columns[c] - columns[c - s];
            rowMax = std::max(rowMax, sum);
        }
        mxSum = std::max(mxSum, rowMax);

        if (top + s < n) {
            const int* leaving = matrix[top].data();
            const int* entering = matrix[top + s].data();
            #pragma omp simd
            for (int c = 0; c < n; ++c)
                columns[c] += static_cast<long long>(entering[c])
                            - static_cast<long long>(leaving[c]);
        }
    }

    printf("%lld\n", mxSum);
}

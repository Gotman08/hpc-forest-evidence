#include "knn.h"
#include <omp.h>
#include <float.h>

typedef struct {
    float dist;
    char label;
    int idx;
} Candidate;

int compare_candidates(const void *a, const void *b) {
    Candidate *ca = (Candidate *)a;
    Candidate *cb = (Candidate *)b;
    if (ca->dist < cb->dist) return -1;
    if (ca->dist > cb->dist) return 1;
    if (ca->idx < cb->idx) return -1;
    if (ca->idx > cb->idx) return 1;
    return 0;
}

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    // Precompute cumulative lengths for global indexing
    int *cum = (int *)malloc((n_groups + 1) * sizeof(int));
    cum[0] = 0;
    for (int i = 0; i < n_groups; i++) {
        cum[i+1] = cum[i] + groups[i].length;
    }

    int num_threads = omp_get_max_threads();
    // Allocate per-thread local top-k arrays
    float (*dist_local)[k] = (float(*)[k])malloc(num_threads * k * sizeof(float));
    char  (*lab_local)[k]  = (char(*)[k])malloc(num_threads * k * sizeof(char));
    int   (*idx_local)[k]  = (int(*)[k])malloc(num_threads * k * sizeof(int));

    // Initialize all entries to sentinel values
    #pragma omp parallel for schedule(static) num_threads(num_threads)
    for (int t = 0; t < num_threads; t++) {
        for (int j = 0; j < k; j++) {
            dist_local[t][j] = FLT_MAX;
            lab_local[t][j] = -1;
            idx_local[t][j] = -1;
        }
    }

    #pragma omp parallel default(none) shared(n_groups, groups, to_evaluate, k, cum, dist_local, lab_local, idx_local)
    {
        int tid = omp_get_thread_num();

        #pragma omp for schedule(dynamic)
        for (int i = 0; i < n_groups; i++) {
            Group g = groups[i];
            float *dist_tid = dist_local[tid];
            char  *lab_tid  = lab_local[tid];
            int   *idx_tid  = idx_local[tid];

            for (int j = 0; j < g.length; j++) {
                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);
                int global_idx = cum[i] + j;

                // Insert into local top-k list
                int x;
                for (x = 0; x < k; x++) {
                    if (d < dist_tid[x]) break;
                }
                if (x < k) {
                    // Shift elements right from x to k-2
                    for (int y = k - 1; y > x; y--) {
                        dist_tid[y] = dist_tid[y-1];
                        lab_tid[y]  = lab_tid[y-1];
                        idx_tid[y]  = idx_tid[y-1];
                    }
                    dist_tid[x] = d;
                    lab_tid[x]  = g.label;
                    idx_tid[x]  = global_idx;
                }
            }
        }
    }

    // Collect all candidates from per-thread arrays
    int total_candidates = 0;
    for (int t = 0; t < num_threads; t++) {
        for (int j = 0; j < k; j++) {
            if (dist_local[t][j] != FLT_MAX) {
                total_candidates++;
            }
        }
    }

    Candidate *cands = (Candidate *)malloc(total_candidates * sizeof(Candidate));
    int pos = 0;
    for (int t = 0; t < num_threads; t++) {
        for (int j = 0; j < k; j++) {
            if (dist_local[t][j] != FLT_MAX) {
                cands[pos].dist  = dist_local[t][j];
                cands[pos].label = lab_local[t][j];
                cands[pos].idx   = idx_local[t][j];
                pos++;
            }
        }
    }

    // Sort by distance then global index
    qsort(cands, total_candidates, sizeof(Candidate), compare_candidates);

    // Extract top-k labels (first k after sorting)
    char *labels = (char *)malloc(k * sizeof(char));
    for (int i = 0; i < k && i < total_candidates; i++) {
        labels[i] = cands[i].label;
    }

    free(cands);
    free(dist_local);
    free(lab_local);
    free(idx_local);
    free(cum);

    // Compute most frequent label (same as original)
    qsort(labels, k, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (int i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }
            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    free(labels);
    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

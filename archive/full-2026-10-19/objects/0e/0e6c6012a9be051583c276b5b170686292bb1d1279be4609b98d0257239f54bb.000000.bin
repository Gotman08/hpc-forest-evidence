        "content": "#include <stdio.h>\n#include <stdlib.h>\n\n#define MAXNUM 100\n#define MAXSTR 50\n#define MAXRESULTS 1000\n\nchar firstHalf[MAXNUM][MAXSTR];\nchar secondHalf[MAXNUM][MAXSTR];\nlong int result[MAXRESULTS];\nint numPrimes=0;\n\nstatic int isprime_small(long int value)\n{\n  return value == 2 || value == 3 || value == 5 || value == 7 ||\n         value == 11 || value == 13;\n}\n\nstatic int isprime_after_small_factors(long int value)\n{\n  static const int increments[8] = {4, 2, 4, 2, 4, 6, 2, 6};\n  long int factor=17;\n  int step=3;\n\n  if (value < 2)\n    return 0;\n\n  while (factor <= value / factor)\n    {\n      if (value % factor == 0)\n        return 0;\n      factor += increments[step];\n      step = (step + 1) & 7;\n    }\n  return 1;\n}\n\nvoid quicksort(long int *primes,int first,int last)\n{ int i, j, pivot;\n  long int temp;\n\n  if (first<last)\n     { pivot=first;\n       i=first;\n       j=last;\n       while(i<j)\n         { while (primes[i]<=primes[pivot]&&i<last)\n             i++;\n           while (primes[j]>primes[pivot])\n             j--;\n           if (i<j)\n              { temp=primes[i];\n                primes[i]=primes[j];\n                primes[j]=temp;\n              }\n         }\n       temp=primes[pivot];\n       primes[pivot]=primes[j];\n       primes[j]=temp;\n       quicksort(primes,first,j-1);\n       quicksort(primes,j+1,last);\n     }\n}\n\nint main(int argc,char** argv)\n{ FILE *primesFile;\n  int i=0,j=0,numResults=0,candidateCount;\n  long int firstValue[MAXNUM];\n  long int secondValue[MAXNUM];\n  long int candidates[MAXNUM * MAXNUM];\n  unsigned char smallFactorFree[MAXNUM * MAXNUM];\n  long int primeToTest;\n  primesFile=stdin;\n  fscanf(primesFile,\"%d\\n\",&numPrimes);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",firstHalf[i]);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",secondHalf[i]);\n  fclose(primesFile);\n\n  for (i=0;i<numPrimes;i++)\n      firstValue[i]=atol(firstHalf[i]);\n  for (i=0;i<numPrimes;i++)\n      secondValue[i]=atol(secondHalf[i]);\n\n  candidateCount=numPrimes*numPrimes;\n  for (i=0;i<numPrimes;i++)\n      { int row=i*numPrimes;\n        long int prefix=firstValue[i]*10000000L;\n        #pragma GCC ivdep\n        for (j=0;j<numPrimes;j++)\n            candidates[row+j]=prefix+secondValue[j];\n      }\n\n  #pragma GCC ivdep\n  for (i=0;i<candidateCount;i++)\n      { long int value=candidates[i];\n        smallFactorFree[i]=(unsigned char)(\n            (value > 13) &\n            (value % 2 != 0) &\n            (value % 3 != 0) &\n            (value % 5 != 0) &\n            (value % 7 != 0) &\n            (value % 11 != 0) &\n            (value % 13 != 0));\n      }\n\n  for (i=0;i<candidateCount;i++)\n      { primeToTest=candidates[i];\n        if (primeToTest <= 13)\n          {\n            if (isprime_small(primeToTest))\n              result[numResults++]=primeToTest;\n          }\n        else if (smallFactorFree[i] &&\n                 isprime_after_small_factors(primeToTest))\n          {\n            result[numResults++]=primeToTest;\n          }\n      }\n  quicksort(result,0,numResults-1);\n  for (i=0;i<numResults;i++)\n      printf(\"%ld\\n\",result[i]);\n  return 0;\n}\n",
        "path": "src/model-view/primetest.c"

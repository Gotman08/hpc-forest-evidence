#include <bits/stdc++.h>

using namespace std;

using ll = long long;

class FrequencyTable {
  struct Entry {
    int key;
    int count;
    uint32_t generation;
  };

  static constexpr uint32_t kCapacity = 2048;
  static constexpr uint32_t kMask = kCapacity - 1;
  array<Entry, kCapacity> entries_{};
  uint32_t generation_ = 0;

  static inline uint32_t hash_key(int key) {
    uint32_t value = static_cast<uint32_t>(key);
    value ^= value >> 16;
    value *= 0x7feb352dU;
    value ^= value >> 15;
    return value & kMask;
  }

 public:
  inline void reset() {
    ++generation_;
    if (generation_ == 0) {
      for (Entry &entry : entries_) entry.generation = 0;
      generation_ = 1;
    }
  }

  inline int count(int key) const {
    uint32_t slot = hash_key(key);
    while (entries_[slot].generation == generation_) {
      if (entries_[slot].key == key) return entries_[slot].count;
      slot = (slot + 1) & kMask;
    }
    return 0;
  }

  inline void increment(int key) {
    uint32_t slot = hash_key(key);
    while (entries_[slot].generation == generation_) {
      if (entries_[slot].key == key) {
        ++entries_[slot].count;
        return;
      }
      slot = (slot + 1) & kMask;
    }
    entries_[slot] = {key, 1, generation_};
  }

  inline int increment_and_previous_count(int key) {
    uint32_t slot = hash_key(key);
    while (entries_[slot].generation == generation_) {
      if (entries_[slot].key == key) return entries_[slot].count++;
      slot = (slot + 1) & kMask;
    }
    entries_[slot] = {key, 1, generation_};
    return 0;
  }
};

static ll solve(const vector<int> &oriented, int boundary_count, int scan_count,
                int target) {
  vector<int> accumulated(scan_count);
  FrequencyTable frequency;
  ll answer = 0;

  for (int first = 0; first < boundary_count; ++first) {
    fill(accumulated.begin(), accumulated.end(), 0);

    for (int last = first; last < boundary_count; ++last) {
      const int *column = oriented.data() + static_cast<size_t>(last) * scan_count;
      int *sums = accumulated.data();
      for (int index = 0; index < scan_count; ++index) {
        sums[index] += column[index];
      }

      frequency.reset();
      frequency.increment(0);
      int prefix = 0;

      if (target == 0) {
        for (int index = 0; index < scan_count; ++index) {
          prefix += sums[index];
          answer += frequency.increment_and_previous_count(prefix);
        }
      } else {
        for (int index = 0; index < scan_count; ++index) {
          prefix += sums[index];
          answer += frequency.count(prefix - target);
          frequency.increment(prefix);
        }
      }
    }
  }

  return answer;
}

int main() {
  ios::sync_with_stdio(false);
  cin.tie(nullptr);

  int k, m, n;
  cin >> k >> m >> n;

  const bool columns_are_boundaries = m >= n;
  const int boundary_count = columns_are_boundaries ? n : m;
  const int scan_count = columns_are_boundaries ? m : n;
  vector<int> oriented(static_cast<size_t>(boundary_count) * scan_count);

  for (int row = 0; row < m; ++row) {
    for (int column = 0; column < n; ++column) {
      int value;
      cin >> value;
      if (columns_are_boundaries) {
        oriented[static_cast<size_t>(column) * scan_count + row] = value;
      } else {
        oriented[static_cast<size_t>(row) * scan_count + column] = value;
      }
    }
  }

  cout << solve(oriented, boundary_count, scan_count, k) << '\n';
  return 0;
}

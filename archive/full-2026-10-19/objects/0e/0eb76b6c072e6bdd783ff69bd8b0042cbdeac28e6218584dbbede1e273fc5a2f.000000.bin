turn entries_[slot].count;\\n+      slot = (slot + 1) & kMask;\\n+    }\\n+    return 0;\\n+  }\\n+\\n+  inline void increment(int key) {\\n+    uint32_t slot = hash_key(key);\\n+    while (entries_[slot].generation == generation_) {\\n+      if (entries_[slot].key == key) {\\n+        ++entries_[slot].count;\\n+        return;\\n+      }\\n+      slot = (slot + 1) & kMask;\\n+    }\\n+    entries_[slot] = {key, 1, generation_};\\n+  }\\n+\\n+  inline int increment_and_previous_count(int key) {\\n+    uint32_t slot = hash_key(key);\\n+    while (entries_[slot].generation == generation_) {\\n+      if (entries_[slot].key == key) return entries_[slot].count++;\\n+      slot = (slot + 1) & kMask;\\n     }\\n+    entries_[slot] = {key, 1, generation_};\\n+    return 0;\\n   }\\n-  unordered_map<ll, ll> h;\\n-  ll ans = 0;\\n-  for (int j = 1; j <= n; j++) // O(m*n^2)\\n-    for (int l = j; l <= n; l++) {\\n-      h.clear();\\n-      h[0] = 1;\\n-      ll s = 0;\\n-      for (int i = 1; i <= m; i++) {\\n-        s += ps[i][l] - ps[i][j - 1];\\n-        ans += h.find(s - k) != h.end() ? h[s - k] : 0;\\n-        h[s]++;\\n+};\\n+\\n+static ll solve(const vector<int> &oriented, int boundary_count, int scan_count,\\n+                int target) {\\n+  vector<int> accumulated(scan_count);\\n+  FrequencyTable frequency;\\n+  ll answer = 0;\\n+\\n+  for (int first = 0; first < boundary_count; ++first) {\\n+    fill(accumulated.begin(), accumulated.end(), 0);\\n+\\n+    for (int last = first; last < boundary_count; ++last) {\\n+      const int *column = oriented.data() + static_cast<size_t>(last) * scan_count;\\n+      int *sums = accumulated.data();\\n+      for (int index = 0; index < scan_count; ++index) {\\n+        sums[index] += column[index];\\n+      }\\n+\\n+      frequency.reset();\\n+      frequency.increment(0);\\n+      int prefix = 0;\\n+\\n+      if (target == 0) {\\n+        for (int index = 0; index < scan_count; ++index) {\\n+          prefix += sums[index];\\n
dimension.\", \"Build a flattened triangular pair index and distribute it with static OpenMP scheduling and a reduction on the answer.\", \"Replace the per-pair unordered_map with an epoch-tagged private open-addressed counter sized from the number of scanned prefixes.\", \"Use buffered standard input/output.\"]}, \"mean_seconds\": 0.027166904881596565, \"diff\": \"diff --git a/src/main.cpp b/src/main.cpp\\nindex b3a5f60..f8bf74d 100644\\n--- a/src/main.cpp\\n+++ b/src/main.cpp\\n@@ -3,42 +3,132 @@\\n using namespace std;\\n \\n int A[1000][1000];\\n-int ps[1010][1010];\\n \\n typedef long long ll;\\n \\n+class PrefixCounter {\\n+  vector<int> keys;\\n+  vector<int> counts;\\n+  vector<int> stamps;\\n+  size_t mask;\\n+  int next_stamp;\\n+\\n+  static inline uint32_t mix(uint32_t x) {\\n+    x ^= x >> 16;\\n+    x *= 0x7feb352du;\\n+    x ^= x >> 15;\\n+    x *= 0x846ca68bu;\\n+    x ^= x >> 16;\\n+    return x;\\n+  }\\n+\\n+ public:\\n+  explicit PrefixCounter(int maximum_entries) : next_stamp(0) {\\n+    size_t capacity = 1;\\n+    while (capacity < static_cast<size_t>(maximum_entries) * 2)\\n+      capacity <<= 1;\\n+    keys.resize(capacity);\\n+    counts.resize(capacity);\\n+    stamps.assign(capacity, 0);\\n+    mask = capacity - 1;\\n+  }\\n+\\n+  inline int begin() { return ++next_stamp; }\\n+\\n+  inline int get(int key, int stamp) const {\\n+    size_t slot = mix(static_cast<uint32_t>(key)) & mask;\\n+    while (stamps[slot] == stamp) {\\n+      if (keys[slot] == key)\\n+        return counts[slot];\\n+      slot = (slot + 1) & mask;\\n+    }\\n+    return 0;\\n+  }\\n+\\n+  inline void increment(int key, int stamp) {\\n+    size_t slot = mix(static_cast<uint32_t>(key)) & mask;\\n+    while (stamps[slot] == stamp && keys[slot] != key)\\n+      slot = (slot + 1) & mask;\\n+    if (stamps[slot] != stamp) {\\n+      stamps[slot] = stamp;\\n+      keys[slot] = key;\\n+      counts[slot] = 1;\\n+    } else {\\n+      ++counts[slot];\\n+    }\\n+  }\\n+};\\n+
!= h.end() ? h[s - k] : 0;\\n-        h[s]++;\\n+\\n+ public:\\n+  long long count(const int *sums, int length, int target) {\\n+    const uint16_t tag = next_tag();\\n+    Bucket &zero = locate(0, tag);\\n+    zero.key = 0;\\n+    zero.count = 1;\\n+    zero.tag = tag;\\n+\\n+    int prefix = 0;\\n+    long long result = 0;\\n+    if (target == 0) {\\n+      for (int i = 0; i < length; ++i) {\\n+        prefix += sums[i];\\n+        Bucket &bucket = locate(prefix, tag);\\n+        if (bucket.tag == tag) {\\n+          result += bucket.count;\\n+          ++bucket.count;\\n+        } else {\\n+          bucket.key = prefix;\\n+          bucket.count = 1;\\n+          bucket.tag = tag;\\n+        }\\n+      }\\n+    } else {\\n+      for (int i = 0; i < length; ++i) {\\n+        prefix += sums[i];\\n+        result += lookup(prefix - target, tag);\\n+        increment(prefix, tag);\\n+      }\\n+    }\\n+    return result;\\n+  }\\n+};\\n+\\n+static inline void add_one(int *__restrict first,\\n+                           const int *__restrict row, int length) {\\n+  for (int i = 0; i < length; ++i)\\n+    first[i] += row[i];\\n+}\\n+\\n+static inline void add_two(int *__restrict first, int *__restrict second,\\n+                           const int *__restrict row, int length) {\\n+  for (int i = 0; i < length; ++i) {\\n+    const int value = row[i];\\n+    first[i] += value;\\n+    second[i] += value;\\n+  }\\n+}\\n+\\n+static inline void add_three(int *__restrict first, int *__restrict second,\\n+                             int *__restrict third,\\n+                             const int *__restrict row, int length) {\\n+  for (int i = 0; i < length; ++i) {\\n+    const int value = row[i];\\n+    first[i] += value;\\n+    second[i] += value;\\n+    third[i] += value;\\n+  }\\n+}\\n+\\n+static inline void add_four(int *__restrict first, int *__restrict second,\\n+                            int *__restrict third, int *__restrict fourth,\\n+                         
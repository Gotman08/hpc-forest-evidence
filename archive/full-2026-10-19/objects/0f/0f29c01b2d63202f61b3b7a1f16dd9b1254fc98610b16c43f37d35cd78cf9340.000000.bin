{
  "src/nbody.c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system. SIMD lanes represent independent target bodies, so\n * every target retains the original source and accumulation order.\n */\nvoid body_force(Body *p, float dt, int n) {\n  int first_scalar = 0;\n\n#if defined(__aarch64__)\n  const int packets = n > 0 ? n / 4 : 0;\n  first_scalar = packets * 4;\n\n  #pragma omp parallel for schedule(static)\n  for (int packet = 0; packet < packets; ++packet) {\n    const int i = packet * 4;\n    const float32x4_t xi = {p[i].x, p[i+1].x, p[i+2].x, p[i+3].x};\n    const float32x4_t yi = {p[i].y, p[i+1].y, p[i+2].y, p[i+3].y};\n    const float32x4_t zi = {p[i].z, p[i+1].z, p[i+2].z, p[i+3].z};\n    const float32x4_t softening = vdupq_n_f32(SOFTENING);\n    const float64x2_t one = vdupq_n_f64(1.0);\n    float32x4_t fx = vdupq_n_f32(0.0f);\n    float32x4_t fy = vdupq_n_f32(0.0f);\n    float32x4_t fz = vdupq_n_f32(0.0f);\n\n    for (int j = 0; j < n; ++j) {\n      float32x4_t dx = vdupq_n_f32(p[j].x) - xi;\n      float32x4_t dy = vdupq_n_f32(p[j].y) - yi;\n      float32x4_t dz = vdupq_n_f32(p[j].z) - zi;\n      float32x4_t sqrd_dist = dx*dx + dy*dy + dz*dz + softening;\n\n      /* The reference uses double sqrt and division before rounding\n       * the reciprocal to float. Preserve both operations' precision. */\n      float64x2_t root_lo = vsqrtq_f64(vcvt_f64_f32(vget_low_f32(sqrd_dist)));\n      float64x2_t root_hi = vsqrtq_f64(vcvt_f64_f32(vget_high_f32(sqrd_dist)));\n      float32x4_t inv_dist = vcombine_f32(\n          vcvt_f32_f64(vdivq_f64(one, root_lo)),\n          vcvt_f32_f64(vdivq_f64(one, root_hi)));\n      float32x4_t inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    const float32x4_t step = vdupq_n_f32(dt);\n    float32x4_t vx = {p[i].vx, p[i+1].vx, p[i+2].vx, p[i+3].vx};\n    float32x4_t vy = {p[i].vy, p[i+1].vy, p[i+2].vy, p[i+3].vy};\n    float32x4_t vz = {p[i].vz, p[i+1].vz, p[i+2].vz, p[i+3].vz};\n    vx += step * fx;\n    vy += step * fy;\n    vz += step * fz;\n\n    p[i].vx = vgetq_lane_f32(vx, 0);\n    p[i].vy = vgetq_lane_f32(vy, 0);\n    p[i].vz = vgetq_lane_f32(vz, 0);\n    p[i+1].vx = vgetq_lane_f32(vx, 1);\n    p[i+1].vy = vgetq_lane_f32(vy, 1);\n    p[i+1].vz = vgetq_lane_f32(vz, 1);\n    p[i+2].vx = vgetq_lane_f32(vx, 2);\n    p[i+2].vy = vgetq_lane_f32(vy, 2);\n    p[i+2].vz = vgetq_lane_f32(vz, 2);\n    p[i+3].vx = vgetq_lane_f32(vx, 3);\n    p[i+3].vy = vgetq_lane_f32(vy, 3);\n    p[i+3].vz = vgetq_lane_f32(vz, 3);\n  }\n#endif\n\n#if !defined(__aarch64__)\n  #pragma omp parallel for schedule(static)\n#endif\n  for (int i = first_scalar; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n"
}

        "content": "#include \"knn.h\"\n#include <float.h>\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nstatic int first_insertion_position(const float *distances, int k, float d,\n                                    int ordered) {\n    int x = 0;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const float32x4_t candidate = vdupq_n_f32(d);\n    const float32x4_t empty = vdupq_n_f32(-1.0f);\n#endif\n\n    if (ordered && k >= 64) {\n        int lo = 0;\n        int hi = k / 4;\n        while (lo < hi) {\n            int mid = lo + (hi - lo) / 2;\n            float last = distances[mid * 4 + 3];\n            int matches = (d < last) | (last == -1.0f);\n            hi = matches ? mid : hi;\n            lo = matches ? lo : mid + 1;\n        }\n        x = lo * 4;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n        if (x <= k - 4) {\n            const float32x4_t stored = vld1q_f32(distances + x);\n            const uint32x4_t matches = vorrq_u32(\n                vcltq_f32(candidate, stored), vceqq_f32(stored, empty));\n            const uint32x4_t positions = {0u, 1u, 2u, 3u};\n            const uint32x4_t first = vbslq_u32(\n                matches, positions, vdupq_n_u32(4u));\n            return x + (int) vminvq_u32(first);\n        }\n#endif\n    }\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    for (; x <= k - 4; x += 4) {\n        const float32x4_t stored = vld1q_f32(distances + x);\n        const uint32x4_t matches = vorrq_u32(\n            vcltq_f32(candidate, stored), vceqq_f32(stored, empty));\n        if (vmaxvq_u32(matches) != 0) break;\n    }\n#endif\n\n    for (; x < k; x++) {\n        if (d < distances[x] || distances[x] == -1.0f) return x;\n    }\n    return k;\n}\n\nstatic char knn_vote(char *labels, int k) {\n    qsort(labels, k, sizeof(char), compare_for_sort);\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n    return most_frequent;\n}\n\nstatic char knn_serial(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *) malloc(sizeof(char) * (size_t) k);\n    float *distances = (float *) malloc(sizeof(float) * (size_t) k);\n    if (labels == NULL || distances == NULL) on_error();\n    int distances_ordered = 1;\n\n    for (int i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1.0f;\n    }\n\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            float farthest = distances[k - 1];\n            if (farthest != -1.0f && d >= farthest) continue;\n\n            int x = first_insertion_position(distances, k, d,\n                                             distances_ordered);\n            if (x < k) {\n                size_t shifted = (size_t) (k - x - 1);\n                if (shifted != 0) {\n                    memmove(distances + x + 1, distances + x,\n                            shifted * sizeof(*distances));\n                    memmove(labels + x + 1, labels + x,\n                            shifted * sizeof(*labels));\n                }\n                distances[x] = d;\n                labels[x] = g.label;\n                if (d != d) distances_ordered = 0;\n            }\n        }\n    }\n\n    char result = knn_vote(labels, k);\n    free(distances);\n    free(labels);\n    return result;\n}\n\n#define KNN_RADIX_BINS 2048\n\ntypedef struct {\n    size_t bins[KNN_RADIX_BINS];\n    size_t votes[UCHAR_MAX + 1];\n    size_t take;\n    int bad;\n} KnnWorkspace;\n\nstatic unsigned int knn_pick_bucket(const KnnWorkspace *work, int threads,\n                                     unsigned int bins, size_t *rank) {\n    for (unsigned int b = 0; b < bins; b++) {\n        size_t count = 0;\n        for (int t = 0; t < threads; t++) count += work[t].bins[b];\n        if (*rank > count) {\n            *rank -= count;\n        } else {\n            return b;\n        }\n    }\n    return bins - 1;\n}\n\nstatic char knn_vote_counts(const size_t *counts) {\n    size_t best_count = 0;\n    char result = (char) -1;\n    for (int value = CHAR_MIN; value <= CHAR_MAX; value++) {\n        unsigned char index = (unsigned char) (char) value;\n        if (counts[index] > best_count) {\n            best_count = counts[index];\n            result = (char) value;\n        }\n    }\n    return result;\n}\n\nstatic char knn_radix(int n_groups, Group *groups, int k, Point to_evaluate) {\n    size_t total = 0;\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length > 0) {\n            size_t length = (size_t) groups[i].length;\n            if (length > SIZE_MAX - total)\n                return knn_serial(n_groups, groups, k, to_evaluate);\n            total += length;\n        }\n    }\n    if (total == 0) return (char) -1;\n    if (total > SIZE_MAX / sizeof(uint32_t))\n        return knn_serial(n_groups, groups, k, to_evaluate);\n\n    int threads = 1;\n#ifdef _OPENMP\n    int limit = omp_get_max_threads();\n    size_t useful = total / 32768u + (total % 32768u != 0);\n    if (limit > 1)\n        threads = useful < (size_t) limit ? (int) useful : limit;\n#endif\n\n    uint32_t *keys = (uint32_t *) malloc(total * sizeof(*keys));\n    unsigned char *labels = (unsigned char *) malloc(total);\n    KnnWorkspace *work = (KnnWorkspace *) malloc(\n        (size_t) threads * sizeof(*work));\n    if (keys == NULL || labels == NULL || work == NULL) {\n        free(work);\n        free(labels);\n        free(keys);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    const size_t selected = total < (size_t) k ? total : (size_t) k;\n    size_t rank = selected;\n    uint32_t prefix = 0;\n    uint32_t cutoff = 0;\n    int failed = 0;\n    char result = (char) -1;\n\n#ifdef _OPENMP\n#pragma omp parallel num_threads(threads) if(threads > 1)\n#endif\n    {\n        int thread = 0;\n        int team = 1;\n#ifdef _OPENMP\n        thread = omp_get_thread_num();\n        team = omp_get_num_threads();\n#endif\n        KnnWorkspace *local = work + thread;\n        memset(local, 0, sizeof(*local));\n        size_t base = total / (size_t) team;\n        size_t extra = total % (size_t) team;\n        size_t before = (size_t) thread < extra ? (size_t) thread : extra;\n        size_t begin = base * (size_t) thread + before;\n        size_t end = begin + base + ((size_t) thread < extra);\n        size_t skip = begin;\n        size_t remaining = end - begin;\n        size_t position = begin;\n\n        for (int i = 0; i < n_groups && remaining != 0; i++) {\n            Group g = groups[i];\n            size_t length = g.length > 0 ? (size_t) g.length : 0;\n            if (skip >= length) {\n                skip -= length;\n                continue;\n            }\n            size_t count = length - skip;\n            if (count > remaining) count = remaining;\n            for (size_t j = skip; j < skip + count; j++) {\n                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n                uint32_t key;\n                memcpy(&key, &d, sizeof(key));\n                if (d != d) {\n                    local->bad = 1;\n                    key = 0;\n                } else if (d == 0.0f) {\n                    key = 0;\n                }\n                keys[position] = key;\n                labels[position] = (unsigned char) g.label;\n                local->bins[key >> 21]++;\n                position++;\n            }\n            remaining -= count;\n            skip = 0;\n        }\n\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n        {\n            for (int t = 0; t < team; t++) {\n                if (work[t].bad) failed = 1;\n            }\n            if (!failed)\n                prefix = (uint32_t) knn_pick_bucket(\n                    work, team, KNN_RADIX_BINS, &rank) << 21;\n        }\n\n        if (!failed) {\n            memset(local->bins, 0, sizeof(local->bins));\n            for (size_t p = begin; p < end; p++) {\n                uint32_t key = keys[p];\n                if ((key >> 21) == (prefix >> 21))\n                    local->bins[(key >> 10) & 2047u]++;\n            }\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n            {\n                prefix |= (uint32_t) knn_pick_bucket(\n                    work, team, KNN_RADIX_BINS, &rank) << 10;\n            }\n\n            memset(local->bins, 0, sizeof(local->bins));\n            for (size_t p = begin; p < end; p++) {\n                uint32_t key = keys[p];\n                if ((key >> 10) == (prefix >> 10))\n                    local->bins[key & 1023u]++;\n            }\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n            {\n                unsigned int bucket = knn_pick_bucket(work, team, 1024u, &rank);\n                cutoff = prefix | (uint32_t) bucket;\n                size_t needed = rank;\n                for (int t = 0; t < team; t++) {\n                    size_t available = work[t].bins[bucket];\n                    work[t].take = available < needed ? available : needed;\n                    needed -= work[t].take;\n                }\n            }\n\n            size_t ties = local->take;\n            for (size_t p = begin; p < end; p++) {\n                uint32_t key = keys[p];\n                if (key < cutoff) {\n                    local->votes[labels[p]]++;\n                } else if (key == cutoff && ties != 0) {\n                    local->votes[labels[p]]++;\n                    ties--;\n                }\n            }\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n            {\n                size_t counts[UCHAR_MAX + 1] = {0};\n                for (int t = 0; t < team; t++) {\n                    for (unsigned int c = 0; c <= UCHAR_MAX; c++)\n                        counts[c] += work[t].votes[c];\n                }\n                counts[(unsigned char) ((char) -1)] += (size_t) k - selected;\n                result = knn_vote_counts(counts);\n            }\n        }\n    }\n\n    free(work);\n    free(labels);\n    free(keys);\n    if (failed) return knn_serial(n_groups, groups, k, to_evaluate);\n    return result;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) return (char) -1;\n    if (k <= 64 || sizeof(float) != sizeof(uint32_t) ||\n        FLT_RADIX != 2 || FLT_MANT_DIG != 24 || FLT_MAX_EXP != 128 ||\n        CHAR_BIT != 8)\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    return knn_radix(n_groups, groups, k, to_evaluate);\n}\n\nint main(void) {\n    int n_groups = parse_number_of_groups();\n    Group *groups = (Group *) malloc(sizeof(Group) * n_groups);\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n    return 0;\n}\n",

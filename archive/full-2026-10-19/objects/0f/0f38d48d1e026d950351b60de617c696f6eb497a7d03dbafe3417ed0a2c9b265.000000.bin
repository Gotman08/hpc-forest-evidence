        "content": "#ifndef KNN_H\n#define KNN_H\n\n#include <stdio.h>\n#include <stdlib.h>\n#include <ctype.h>\n#include <limits.h>\n#include <string.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point *points;\n} Group;\n\nvoid on_error(void) {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\n#define KNN_INPUT_CAPACITY 65536u\nstatic char knn_input_buffer[KNN_INPUT_CAPACITY + 1];\nstatic size_t knn_input_position;\nstatic size_t knn_input_count;\n\nstatic int knn_input_peek(void) {\n    if (knn_input_position == knn_input_count) {\n        knn_input_count = fread(knn_input_buffer, 1, KNN_INPUT_CAPACITY, stdin);\n        knn_input_position = 0;\n        knn_input_buffer[knn_input_count] = '\\0';\n        if (knn_input_count == 0) return EOF;\n    }\n    return (unsigned char) knn_input_buffer[knn_input_position];\n}\n\nstatic int knn_input_get(void) {\n    int c = knn_input_peek();\n    if (c != EOF) knn_input_position++;\n    return c;\n}\n\nstatic void knn_skip_space(void) {\n    int c;\n    while ((c = knn_input_peek()) != EOF && isspace((unsigned char) c))\n        knn_input_position++;\n}\n\nstatic void knn_expect(const char *literal) {\n    while (*literal != '\\0') {\n        if (knn_input_get() != (unsigned char) *literal) on_error();\n        literal++;\n    }\n}\n\nstatic int knn_parse_integer(void) {\n    knn_skip_space();\n    int c = knn_input_peek();\n    int negative = 0;\n    if (c == '-' || c == '+') {\n        negative = c == '-';\n        knn_input_position++;\n        c = knn_input_peek();\n    }\n    if (c < '0' || c > '9') on_error();\n    unsigned int limit = (unsigned int) INT_MAX + (unsigned int) negative;\n    unsigned int value = 0;\n    while (c >= '0' && c <= '9') {\n        unsigned int digit = (unsigned int) (c - '0');\n        if (value > (limit - digit) / 10u) on_error();\n        value = value * 10u + digit;\n        knn_input_position++;\n        c = knn_input_peek();\n    }\n    if (negative) {\n        if (value == (unsigned int) INT_MAX + 1u) return INT_MIN;\n        return -(int) value;\n    }\n    return (int) value;\n}\n\nstatic size_t knn_float_token_end(size_t position, size_t *depth) {\n    while (position < knn_input_count) {\n        unsigned char c = (unsigned char) knn_input_buffer[position];\n        if (isspace(c) || c == ',' || (c == ')' && *depth == 0)) break;\n        if (c == '(') {\n            (*depth)++;\n        } else if (c == ')') {\n            (*depth)--;\n        }\n        position++;\n    }\n    return position;\n}\n\nstatic void knn_append_token(char **token, size_t *length, size_t *capacity,\n                              const char *part, size_t amount) {\n    if (amount > (size_t) -1 - *length - 1) on_error();\n    size_t needed = *length + amount + 1;\n    if (needed > *capacity) {\n        size_t next = *capacity != 0 ? *capacity : 64;\n        while (next < needed) {\n            if (next > ((size_t) -1) / 2) {\n                next = needed;\n                break;\n            }\n            next *= 2;\n        }\n        char *resized = (char *) realloc(*token, next);\n        if (resized == NULL) on_error();\n        *token = resized;\n        *capacity = next;\n    }\n    memcpy(*token + *length, part, amount);\n    *length += amount;\n    (*token)[*length] = '\\0';\n}\n\nstatic float knn_parse_float(void) {\n    knn_skip_space();\n    if (knn_input_peek() == EOF) on_error();\n    size_t begin = knn_input_position;\n    size_t depth = 0;\n    size_t end = knn_float_token_end(begin, &depth);\n    char *finish;\n\n    if (end < knn_input_count) {\n        float value = strtof(knn_input_buffer + begin, &finish);\n        if (finish == knn_input_buffer + begin ||\n            finish != knn_input_buffer + end) on_error();\n        knn_input_position = end;\n        return value;\n    }\n\n    char *token = NULL;\n    size_t length = 0;\n    size_t capacity = 0;\n    for (;;) {\n        knn_append_token(&token, &length, &capacity,\n                         knn_input_buffer + begin, end - begin);\n        knn_input_position = end;\n        if (end < knn_input_count || knn_input_peek() == EOF) break;\n        begin = knn_input_position;\n        end = knn_float_token_end(begin, &depth);\n    }\n    float value = strtof(token, &finish);\n    if (finish == token || finish != token + length) on_error();\n    free(token);\n    return value;\n}\n\nint parse_number_of_groups(void) {\n    knn_skip_space();\n    knn_expect(\"n_groups=\");\n    int n = knn_parse_integer();\n    knn_skip_space();\n    return n;\n}\n\nPoint parse_point(void) {\n    knn_skip_space();\n    knn_expect(\"(\");\n    Point point;\n    point.x = knn_parse_float();\n    knn_skip_space();\n    knn_expect(\",\");\n    point.y = knn_parse_float();\n    knn_skip_space();\n    knn_expect(\")\");\n    knn_skip_space();\n    return point;\n}\n\nGroup parse_next_group(void) {\n    knn_skip_space();\n    knn_expect(\"label=\");\n    int label = knn_input_get();\n    if (label == EOF) on_error();\n    knn_skip_space();\n    knn_expect(\"length=\");\n    int length = knn_parse_integer();\n    knn_skip_space();\n\n    Group group;\n    group.label = (char) label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n    return group;\n}\n\nint parse_k(void) {\n    knn_skip_space();\n    knn_expect(\"k=\");\n    int k = knn_parse_integer();\n    knn_skip_space();\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt(Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n    return *(const char *) a - *(const char *) b;\n}\n\n#endif\n",

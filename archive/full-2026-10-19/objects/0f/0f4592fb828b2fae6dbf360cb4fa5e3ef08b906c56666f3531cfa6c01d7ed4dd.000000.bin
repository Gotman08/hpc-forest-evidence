#include <cstddef>
#include <iostream>
#include <utility>
#include <vector>

using namespace std;

class adjacency_matrix {
public:
    explicit adjacency_matrix(int vertices = 0)
        : vertices_(vertices),
          cells_(static_cast<size_t>(vertices) * static_cast<size_t>(vertices), 0),
          row_ones_(vertices, 0) {}

    int size() const {
        return vertices_;
    }

    void setUndirected(int source, int destination) {
        const size_t forward = offset(source, destination);
        if (cells_[forward] == 0) {
            cells_[forward] = 1;
            ++row_ones_[source];
        }

        if (source != destination) {
            const size_t reverse = offset(destination, source);
            if (cells_[reverse] == 0) {
                cells_[reverse] = 1;
                ++row_ones_[destination];
            }
        }
    }

    const unsigned char *row(int vertex) const {
        return cells_.data() + offset(vertex, 0);
    }

    int signature(int vertex) const {
        return row_ones_[vertex] * 2 + row(vertex)[vertex];
    }

private:
    size_t offset(int row_index, int column_index) const {
        return static_cast<size_t>(row_index) * static_cast<size_t>(vertices_) +
               static_cast<size_t>(column_index);
    }

    int vertices_;
    vector<unsigned char> cells_;
    vector<int> row_ones_;
};

adjacency_matrix readGraph();
bool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2);
bool sameVertexSignatures(const adjacency_matrix &g1, const adjacency_matrix &g2);
bool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,
                       const vector<int> &equivalence);
inline void printPermutation(const vector<int> &equivalence);

int main(){
    adjacency_matrix g1 = readGraph();
    adjacency_matrix g2 = readGraph();

    if(!testIsomorphism(g1, g2))
        cout << "The graphs are not isomorphic" << endl;

    return 0;
}

bool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2){
    if(g1.size() != g2.size()) return false;
    if(!sameVertexSignatures(g1, g2)) return false;

    const int vertices = g1.size();
    vector<int> equivalence(vertices, 0);
    vector<int> exchange_counter(vertices, 0);
    int exchange_index = 1;
    bool isomorphism_found = false;

    for(int i = 0; i < vertices; ++i)
        equivalence[i] = i;

    if(verifyPermutation(g1, g2, equivalence)){
        printPermutation(equivalence);
        return true;
    }

    while(exchange_index < vertices){
        if(exchange_counter[exchange_index] < exchange_index){
            if(exchange_index % 2 == 0)
                swap(equivalence[0], equivalence[exchange_index]);
            else
                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);
            if(verifyPermutation(g1, g2, equivalence)){
                printPermutation(equivalence);
                isomorphism_found = true;
            }

            exchange_counter[exchange_index]++;
            exchange_index = 1;
        }else{
            exchange_counter[exchange_index] = 0;
            exchange_index++;
        }
    }
    return isomorphism_found;
}

adjacency_matrix readGraph(){
    int vertices, edges, source, destination;

    cin >> vertices;
    adjacency_matrix read(vertices);

    cin >> edges;
    for (int i = 0; i < edges; i++) {
       cin >> source >> destination;
       read.setUndirected(source, destination);
    }

    return read;
}

bool sameVertexSignatures(const adjacency_matrix &g1, const adjacency_matrix &g2){
    const int vertices = g1.size();
    vector<int> signature_counts(2 * vertices + 2, 0);

    for(int i = 0; i < vertices; ++i){
        ++signature_counts[g1.signature(i)];
        --signature_counts[g2.signature(i)];
    }

    for(int count : signature_counts)
        if(count != 0) return false;

    return true;
}

bool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,
                       const vector<int> &equivalence){
    const int vertices = g1.size();

    for (int i = 0; i < vertices; ++i) {
        const int mapped_i = equivalence[i];
        if(g1.signature(i) != g2.signature(mapped_i)) return false;

        const unsigned char *first_row = g1.row(i);
        const unsigned char *second_row = g2.row(mapped_i);
        for (int j = 0; j <= i; ++j) {
            if(first_row[j] != second_row[equivalence[j]]) return false;
        }
    }
    return true;
}

inline void printPermutation(const vector<int> &equivalence){
    for (int i : equivalence)
        cout << i << " ";
    cout << endl;
}

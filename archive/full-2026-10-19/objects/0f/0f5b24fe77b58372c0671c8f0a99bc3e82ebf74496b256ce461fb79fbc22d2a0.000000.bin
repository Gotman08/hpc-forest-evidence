      "content": "#define _POSIX_C_SOURCE 200809L\n#include \"knn.h\"\n#ifdef __ARM_NEON\n#include <arm_neon.h>\n#endif\n\nstatic int worse(float d1, int i1, float d2, int i2) {\n    return (d1 > d2) || (d1 == d2 && i1 > i2);\n}\n\nstatic void sift_up(float *dist_heap, int *idx_heap, int pos) {\n    while (pos > 0) {\n        int parent = (pos - 1) / 2;\n        if (worse(dist_heap[pos], idx_heap[pos], dist_heap[parent], idx_heap[parent])) {\n            float tmpd = dist_heap[pos];\n            dist_heap[pos] = dist_heap[parent];\n            dist_heap[parent] = tmpd;\n            int tmpi = idx_heap[pos];\n            idx_heap[pos] = idx_heap[parent];\n            idx_heap[parent] = tmpi;\n            pos = parent;\n        } else {\n            break;\n        }\n    }\n}\n\nstatic void sift_down(float *dist_heap, int *idx_heap, int heap_size, int pos) {\n    while (1) {\n        int left = 2*pos + 1;\n        int right = 2*pos + 2;\n        int largest = pos;\n        if (left < heap_size && worse(dist_heap[left], idx_heap[left], dist_heap[largest], idx_heap[largest])) {\n            largest = left;\n        }\n        if (right < heap_size && worse(dist_heap[right], idx_heap[right], dist_heap[largest], idx_heap[largest])) {\n            largest = right;\n        }\n        if (largest != pos) {\n            float tmpd = dist_heap[pos];\n            dist_heap[pos] = dist_heap[largest];\n            dist_heap[largest] = tmpd;\n            int tmpi = idx_heap[pos];\n            idx_heap[pos] = idx_heap[largest];\n            idx_heap[largest] = tmpi;\n            pos = largest;\n        } else {\n            break;\n        }\n    }\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    // Count total points\n    int total_points = 0;\n    for (int i = 0; i < n_groups; i++) {\n        total_points += groups[i].length;\n    }\n\n    // Allocate arrays for distances and labels per point\n    float *dists = NULL;\n    char *point_labels = (char *) malloc(sizeof(char) * total_points);\n    if (!point_labels) exit(1);\n\n#ifdef __ARM_NEON\n    posix_memalign((void**)&dists, 16, sizeof(float) * total_points);\n#else\n    dists = (float *) malloc(sizeof(float) * total_points);\n#endif\n    if (!dists) exit(1);\n\n    // Compute squared distances and record labels\n    int idx = 0;\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        float eval_x = to_evaluate.x;\n        float eval_y = to_evaluate.y;\n\n#ifdef __ARM_NEON\n        float32x4_t vx = vdupq_n_f32(eval_x);\n        float32x4_t vy = vdupq_n_f32(eval_y);\n\n        int j = 0;\n        for (; j + 3 < g.length; j += 4) {\n            // Load two interleaved vectors: x and y\n            float32x4x2_t xy = vld2q_f32((const float *)&g.points[j]);\n            float32x4_t xs = xy.val[0];\n            float32x4_t ys = xy.val[1];\n\n            float32x4_t dx = vsubq_f32(xs, vx);\n            float32x4_t dy = vsubq_f32(ys, vy);\n\n            float32x4_t d2 = vaddq_f32(vmulq_f32(dx, dx), vmulq_f32(dy, dy));\n\n            vst1q_f32(&dists[idx + j], d2);\n        }\n        // Scalar remainder\n        for (; j < g.length; j++) {\n            float dx = g.points[j].x - eval_x;\n            float dy = g.points[j].y - eval_y;\n            dists[idx + j] = dx*dx + dy*dy;\n        }\n#else\n        for (int j = 0; j < g.length; j++) {\n            float dx = g.points[j].x - eval_x;\n            float dy = g.points[j].y - eval_y;\n            dists[idx + j] = dx*dx + dy*dy;\n        }\n#endif\n\n        // Fill labels for this group\n        for (int j = 0; j < g.length; j++) {\n            point_labels[idx + j] = g.label;\n        }\n\n        idx += g.length;\n    }\n\n    // Select top-k using max-heap preserving tie-breaking by original order\n    float *heap_dist = (float *) malloc(sizeof(float) * k);\n    int *heap_idx = (int *) malloc(sizeof(int) * k);\n    if (!heap_dist || !heap_idx) exit(1);\n\n    int heap_size = 0;\n    for (int p = 0; p < total_points; p++) {\n        float d = dists[p];\n        if (heap_size < k) {\n            heap_dist[heap_size] = d;\n            heap_idx[heap_size] = p;\n            heap_size++;\n            sift_up(heap_dist, heap_idx, heap_size - 1);\n        } else if (d < heap_dist[0]) {\n            heap_dist[0] = d;\n            heap_idx[0] = p;\n            sift_down(heap_dist, heap_idx, heap_size, 0);\n        }\n    }\n\n    // Count frequencies of labels among selected points\n    int counts[256] = {0};\n    for (int i = 0; i < heap_size; i++) {\n        int pidx = heap_idx[i];\n        counts[(unsigned char)point_labels[pidx]]++;\n    }\n\n    char most_frequent;\n    int best_count = -1;\n    for (int c = 0; c < 256; c++) {\n        if (counts[c] > best_count) {\n            best_count = counts[c];\n            most_frequent = (char)c;\n        }\n    }\n\n    free(dists);\n    free(point_labels);\n    free(heap_dist);\n    free(heap_idx);\n\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Using ARM NEON intrinsics to compute squared distances for four points at a time and selecting top-k with a max-heap (strictly replacing on smaller distance) preserves exact tie-breaking while improving SIMD utilization.",
  "notes": "The code uses #ifdef __ARM_NEON to provide a scalar fallback. The heap selection processes points in original order; once the heap is full, only strictly smaller distances replace the root, which exactly matches the reference insertion behavior (equal distances are never inserted after the list is full). Frequency counting scans ASCII labels ascending and picks the first maximum, matching qsort-based tie-breaking.",

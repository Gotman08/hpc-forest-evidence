#include <stdio.h>
#include <stdlib.h>
#include <math.h>

typedef struct {
    double mean;
    double harmonic_mean;
    double median;
    double mode;
    double variance;
    double standard_deviation;
    double coefficient_variation;
} column_statistics;

static int compare_double(const void *left, const void *right) {
    const double a = *(const double *)left;
    const double b = *(const double *)right;

    return (a > b) - (a < b);
}

static double mode_from_sorted(const double *values, int count) {
    int first = 0;
    int best_matches = 0;
    double mode = -1;

    while (first < count) {
        int last = first + 1;
        int matches;

        while (last < count && values[first] == values[last]) {
            ++last;
        }

        matches = last - first - 1;
        if (matches > best_matches) {
            best_matches = matches;
            mode = values[first];
        }
        first = last;
    }

    return mode;
}

static void finish_column(double *values, int rows, column_statistics *statistics) {
    double sum = 0;
    int row;

    qsort(values, (size_t)rows, sizeof(*values), compare_double);

    if ((rows - 1) % 2) {
        statistics->median = values[rows / 2 - 1] + values[rows / 2];
        statistics->median *= 0.5;
    } else {
        statistics->median = values[rows / 2];
    }

    statistics->mode = mode_from_sorted(values, rows);

    for (row = 0; row < rows; ++row) {
        const double difference = values[row] - statistics->mean;
        sum += difference * difference;
    }

    statistics->variance = sum / (rows - 1);
    statistics->standard_deviation = sqrt(statistics->variance);
    statistics->coefficient_variation =
        statistics->standard_deviation / statistics->mean;
}

int main(int argc, char **argv) {
    int rows;
    int columns;
    int row;
    int column;
    double *matrix;
    column_statistics *statistics;

    (void)argc;
    (void)argv;

    fscanf(stdin, "%d ", &rows);
    fscanf(stdin, "%d\n", &columns);

    matrix = malloc((size_t)rows * (size_t)columns * sizeof(*matrix));
    statistics = calloc((size_t)columns, sizeof(*statistics));

    for (row = 0; row < rows; ++row) {
        for (column = 0; column < columns; ++column) {
            double value;

            fscanf(stdin, "%lf ", &value);
            matrix[(size_t)column * (size_t)rows + (size_t)row] = value;
            statistics[column].mean += value;
            statistics[column].harmonic_mean += 1 / value;
        }
    }

    for (column = 0; column < columns; ++column) {
        statistics[column].mean /= rows;
        statistics[column].harmonic_mean =
            rows / statistics[column].harmonic_mean;
        finish_column(matrix + (size_t)column * (size_t)rows, rows,
                      &statistics[column]);
    }

    for (column = 0; column < columns; ++column) {
        printf("%.1lf ", statistics[column].mean);
    }
    printf("\n");
    for (column = 0; column < columns; ++column) {
        printf("%.1lf ", statistics[column].harmonic_mean);
    }
    printf("\n");
    for (column = 0; column < columns; ++column) {
        printf("%.1lf ", statistics[column].median);
    }
    printf("\n");
    for (column = 0; column < columns; ++column) {
        printf("%.1lf ", statistics[column].mode);
    }
    printf("\n");
    for (column = 0; column < columns; ++column) {
        printf("%.1lf ", statistics[column].variance);
    }
    printf("\n");
    for (column = 0; column < columns; ++column) {
        printf("%.1lf ", statistics[column].standard_deviation);
    }
    printf("\n");
    for (column = 0; column < columns; ++column) {
        printf("%.1lf ", statistics[column].coefficient_variation);
    }
    printf("\n");

    free(matrix);
    free(statistics);

    return 0;
}

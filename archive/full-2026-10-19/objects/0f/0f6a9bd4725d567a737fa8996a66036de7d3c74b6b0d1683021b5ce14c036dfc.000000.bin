"""Controle d'integrite seulement : aucun programme n'est compile ou execute."""
from __future__ import annotations

import hashlib
import json
from pathlib import Path, PurePosixPath

ROOT = Path(__file__).resolve().parents[1]


def verify(root):
    manifest = json.loads((root / "MANIFESTE.json").read_bytes())
    seen = set()
    for name, expected in manifest["files"].items():
        relative = PurePosixPath(name)
        if relative.is_absolute() or ".." in relative.parts or "\\" in name or ":" in name or name in seen:
            raise ValueError("Chemin de manifeste invalide")
        seen.add(name)
        path = root / name
        if path.is_symlink() or not path.resolve().is_relative_to(root.resolve()) or not path.is_file():
            raise ValueError(f"Fichier absent ou lie : {name}")
        if hashlib.sha256(path.read_bytes()).hexdigest() != expected:
            raise ValueError(f"Empreinte differente : {name}")
    params = json.loads((root / "parametres.json").read_bytes())
    counts = {"developpement": 0, "confirmation": 0, "performance": 0}
    for subject in params["subjects"]:
        case_root = root / "evaluation/cas-reserves" / subject
        contract = json.loads((case_root / "contrat.json").read_bytes())
        for name, expected in contract["reference_source_sha256"].items():
            if hashlib.sha256((root / "benchmarks" / subject / "src" / name).read_bytes()).hexdigest() != expected:
                raise ValueError("La reference de depart differe")
        for case in contract["protected_cases"]:
            counts[case["phase"]] += 1
            for key, digest in (("stdin", "stdin_sha256"), ("expected_stdout", "expected_stdout_sha256")):
                path = case_root / case[key]
                if hashlib.sha256(path.read_bytes()).hexdigest() != case[digest]:
                    raise ValueError("Un cas ou oracle differe")
        public = json.loads((root / "benchmarks" / subject / "contrat.json").read_bytes())
        if "protected_cases" in public:
            raise ValueError("Cas reserve expose dans le contrat public")
    if len(params["subjects"]) != 15 or counts != {"developpement": 45, "confirmation": 45, "performance": 15}:
        raise ValueError("Couverture inattendue")
    return {"fichiers_verifies": len(seen), "sujets": 15, "cas": counts, "programmes_executes": 0}


if __name__ == "__main__":
    print(json.dumps(verify(ROOT), ensure_ascii=True))

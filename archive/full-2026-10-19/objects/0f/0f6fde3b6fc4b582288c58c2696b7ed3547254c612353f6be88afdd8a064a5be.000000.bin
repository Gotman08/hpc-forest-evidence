{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n#include <float.h>\\n#include <limits.h>\\n#include <stdint.h>\\n#include <string.h>\\n\\nstatic char vote_winner(const size_t *votes) {\\n    char winner = (char)-1;\\n    size_t best_count = 0;\\n\\n    for (int label = CHAR_MIN; label <= CHAR_MAX; label++) {\\n        size_t count = votes[(unsigned char)(char)label];\\n        if (count > best_count) {\\n            best_count = count;\\n            winner = (char)label;\\n        }\\n    }\\n\\n    return winner;\\n}\\n\\nstatic char insertion_knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n    char *labels = (char *)malloc(sizeof(char) * (size_t)k);\\n    float *distances = (float *)malloc(sizeof(float) * (size_t)k);\\n\\n    for (int i = 0; i < k; i++) {\\n        labels[i] = (char)-1;\\n        distances[i] = -1.0f;\\n    }\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n        for (int j = 0; j < g.length; j++) {\\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n            for (int x = 0; x < k; x++) {\\n                if (d < distances[x] || distances[x] == -1.0f) {\\n                    for (int y = k - 1; y > x; y--) {\\n                        distances[y] = distances[y - 1];\\n                        labels[y] = labels[y - 1];\\n                    }\\n                    distances[x] = d;\\n                    labels[x] = g.label;\\n                    break;\\n                }\\n            }\\n        }\\n    }\\n\\n    size_t votes[UCHAR_MAX + 1] = {0};\\n    for (int i = 0; i < k; i++) {\\n        votes[(unsigned char)labels[i]]++;\\n    }\\n\\n    free(distances);\\n    free(labels);\\n    return vote_winner(votes);\\n}\\n\\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n    if (k <= 0) {\\n        return (char)-1;\\n    }\\n\\n    size_t total = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        if (groups[i].length > 0) {\\n            size_t length = (size_t)groups[i].length;\\n            if (length > SIZE_MAX - total) {\\n                return insertion_knn(n_groups, groups, k, to_evaluate);\\n            }\\n            total += length;\\n        }\\n    }\\n\\n    size_t votes[UCHAR_MAX + 1] = {0};\\n    if (total <= (size_t)k) {\\n        votes[(unsigned char)(char)-1] = (size_t)k - total;\\n        for (int i = 0; i < n_groups; i++) {\\n            if (groups[i].length > 0) {\\n                votes[(unsigned char)groups[i].label] += (size_t)groups[i].length;\\n            }\\n        }\\n        return vote_winner(votes);\\n    }\\n\\n    if (sizeof(float) != sizeof(uint32_t) || FLT_RADIX != 2 ||\\n        FLT_MANT_DIG != 24 || FLT_MAX_EXP != 128 ||\\n        total > SIZE_MAX / sizeof(uint32_t)) {\\n        return insertion_knn(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    uint32_t *keys = (uint32_t *)malloc(total * sizeof(*keys));\\n    if (keys == NULL) {\\n        return insertion_knn(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    size_t histogram[256] = {0};\\n    size_t position = 0;\\n    unsigned int has_nan = 0;\\n\\n    /* Nonnegative binary32 distances have numerically ordered bit patterns. */\\n    for (int i = 0; i < n_groups; i++) {\\n        const Group *g = &groups[i];\\n        for (int j = 0; j < g->length; j++) {\\n            float d = euclidean_distance_no_sqrt(to_evaluate, g->points[j]);\\n            uint32_t key;\\n            memcpy(&key, &d, sizeof(key));\\n            key &= UINT32_C(0x7fffffff);\\n            has_nan |= key > UINT32_C(0x7f800000);\\n            keys[position++] = key;\\n            histogram[key >> 24]++;\\n        }\\n    }\\n\\n    /* NaNs require the reference's comparison and insertion behavior. */\\n    if (has_nan) {\\n        free(keys);\\n        return insertion_knn(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    uint32_t prefix = 0;\\n    uint32_t mask = 0;\\n    uint32_t cutoff = 0;\\n    size_t rank = (size_t)k;\\n    size_t equal_to_take = 0;\\n\\n    for (int shift = 24; shift >= 0; shift -= 8) {\\n        unsigned int bucket = 0;\\n        while (rank > histogram[bucket]) {\\n            rank -= histogram[bucket];\\n            bucket++;\\n        }\\n\\n        prefix |= (uint32_t)bucket << shift;\\n        mask |= UINT32_C(0xff) << shift;\\n\\n        /* A completely selected bucket needs no finer partitioning. */\\n        if (shift == 0 || rank == histogram[bucket]) {\\n            cutoff = prefix | ~mask;\\n            equal_to_take = rank;\\n            break;\\n        }\\n\\n        memset(histogram, 0, sizeof(histogram));\\n        for (size_t p = 0; p < total; p++) {\\n            uint32_t key = keys[p];\\n            if ((key & mask) == prefix) {\\n                histogram[(key >> (shift - 8)) & UINT32_C(0xff)]++;\\n            }\\n        }\\n    }\\n\\n    /* The unpermuted key stream preserves first-seen distance ties. */\\n    position = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        size_t selected = 0;\\n        for (int j = 0; j < groups[i].length; j++) {\\n            uint32_t key = keys[position++];\\n            if (key < cutoff) {\\n                selected++;\\n            } else if (key == cutoff && equal_to_take != 0) {\\n                selected++;\\n                equal_to_take--;\\n            }\\n        }\\n        votes[(unsigned char)groups[i].label] += selected;\\n    }\\n\\n    free(keys);\\n    return vote_winner(votes);\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"A compact distance-key stream and cache-resident radix histograms will replace shortlist scans with bounded sequential passes while preserving stable neighbor selection.\",\n  \"notes\": \"Parsing and public interfaces remain unchanged. No commands or measurements were run.\",\n  \"research\": {\n    \"queries\": [],\n    \"urls\": []\n  },\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Store distance keys contiguously in original group traversal order without per-point labels or indices.\",\n    \"Select the distance cutoff with at most four 256-bin radix stages and whole-bucket early exits.\",\n    \"Count selected labels sequentially, preserving first-seen distance ties and char-order voting ties; retain reference insertion behavior for NaNs and allocation or format fallbacks.\"\n  ]\n}"}}

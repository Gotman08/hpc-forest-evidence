{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include <algorithm>\\n#include <cstdint>\\n#include <iostream>\\n#include <vector>\\n\\n#if defined(__aarch64__) || defined(__ARM_NEON)\\n#include <arm_neon.h>\\n#endif\\n\\nnamespace {\\nconstexpr std::uint32_t MOD = 1000000007U;\\n\\ninline std::uint32_t add_mod(std::uint32_t a, std::uint32_t b) {\\n    const std::uint32_t sum = a + b;\\n    return sum >= MOD ? sum - MOD : sum;\\n}\\n\\ninline std::uint32_t subtract_mod(std::uint32_t a, std::uint32_t b) {\\n    return a >= b ? a - b : a + MOD - b;\\n}\\n\\n#if defined(__aarch64__) || defined(__ARM_NEON)\\ninline uint32x4_t vector_transition(uint32x4_t current,\\n                                    uint32x4_t lower,\\n                                    uint32x4_t modulus) {\\n    const uint32x4_t sum =\\n        vaddq_u32(current, vextq_u32(lower, current, 3));\\n    return vminq_u32(sum, vsubq_u32(sum, modulus));\\n}\\n#endif\\n\\ninline void advance_pair_interior(std::uint32_t* dp, int first, int last) {\\n    int j = last;\\n#if defined(__aarch64__) || defined(__ARM_NEON)\\n    // The look-behind loads must stay inside the allocated array.\\n    const int vector_limit = std::max(first + 3, 11);\\n    const int unroll_limit = std::max(first + 15, 23);\\n    if (j >= vector_limit) {\\n        const uint32x4_t modulus = vdupq_n_u32(MOD);\\n        const uint32x4_t upper = vld1q_u32(dp + j - 3);\\n        uint32x4_t below = vld1q_u32(dp + j - 7);\\n        uint32x4_t current = vector_transition(upper, below, modulus);\\n\\n        for (; j >= unroll_limit; j -= 16) {\\n            // Load original values before any overlapping stores.\\n            const uint32x4_t q2 = vld1q_u32(dp + j - 11);\\n            const uint32x4_t q3 = vld1q_u32(dp + j - 15);\\n            const uint32x4_t q4 = vld1q_u32(dp + j - 19);\\n            const uint32x4_t q5 = vld1q_u32(dp + j - 23);\\n\\n            const uint32x4_t t1 = vector_transition(below, q2, modulus);\\n            const uint32x4_t t2 = vector_transition(q2, q3, modulus);\\n            const uint32x4_t t3 = vector_transition(q3, q4, modulus);\\n            const uint32x4_t t4 = vector_transition(q4, q5, modulus);\\n\\n            vst1q_u32(dp + j - 3,\\n                      vector_transition(current, t1, modulus));\\n            vst1q_u32(dp + j - 7,\\n                      vector_transition(t1, t2, modulus));\\n            vst1q_u32(dp + j - 11,\\n                      vector_transition(t2, t3, modulus));\\n            vst1q_u32(dp + j - 15,\\n                      vector_transition(t3, t4, modulus));\\n\\n            current = t4;\\n            below = q5;\\n        }\\n\\n        for (; j >= vector_limit; j -= 4) {\\n            const uint32x4_t further = vld1q_u32(dp + j - 11);\\n            const uint32x4_t next =\\n                vector_transition(below, further, modulus);\\n            vst1q_u32(dp + j - 3,\\n                      vector_transition(current, next, modulus));\\n            current = next;\\n            below = further;\\n        }\\n    }\\n#endif\\n    for (; j >= first; --j) {\\n        // Two unblocked transitions have coefficients [1, 2, 1].\\n        // Their numerator is at most 4*(MOD-1), below 2^32.\\n        std::uint32_t value = dp[j] + 2U * dp[j - 1] + dp[j - 2];\\n        if (value >= 2U * MOD) value -= 2U * MOD;\\n        if (value >= MOD) value -= MOD;\\n        dp[j] = value;\\n    }\\n}\\n}\\n\\nint main() {\\n    std::ios::sync_with_stdio(false);\\n    std::cin.tie(nullptr);\\n\\n    int n, m;\\n    if (!(std::cin >> n >> m)) return 0;\\n\\n    std::vector<std::vector<int>> blocked(2 * n - 1);\\n    bool endpoint_blocked = false;\\n    for (int c = 0; c < m; ++c) {\\n        int row, column;\\n        std::cin >> row >> column;\\n        blocked[row + column].push_back(column + 1);\\n        if ((row == 0 && column == 0) ||\\n            (row == n - 1 && column == n - 1)) {\\n            endpoint_blocked = true;\\n        }\\n    }\\n\\n    if (endpoint_blocked) {\\n        std::cout << 0 << '\\\\n';\\n        return 0;\\n    }\\n\\n    // Shift columns by one, leaving dp[0] as a permanent zero boundary.\\n    std::vector<std::uint32_t> dp(n + 1, 0);\\n    std::vector<std::uint32_t> intermediate_values(n + 1, 0);\\n    dp[1] = 1;\\n\\n    for (int diagonal = 1; diagonal < 2 * n - 1; diagonal += 2) {\\n        const int middle_first = std::max(1, diagonal - n + 2);\\n        const int middle_last = std::min(n, diagonal + 1);\\n        const int final_first = std::max(1, diagonal - n + 3);\\n        const int final_last = std::min(n, diagonal + 2);\\n\\n        // Intermediate cells are independent. Save their unblocked values\\n        // before the fused update overwrites the preceding diagonal.\\n        for (int column : blocked[diagonal]) {\\n            intermediate_values[column] =\\n                add_mod(dp[column], dp[column - 1]);\\n        }\\n\\n        const bool has_low_edge = final_first == middle_first;\\n        const bool has_high_edge = final_last > middle_last;\\n        std::uint32_t low_edge = 0;\\n        std::uint32_t high_edge = 0;\\n        if (has_low_edge) {\\n            low_edge = add_mod(dp[middle_first], dp[middle_first - 1]);\\n        }\\n        if (has_high_edge) {\\n            high_edge = add_mod(dp[middle_last], dp[middle_last - 1]);\\n        }\\n\\n        advance_pair_interior(dp.data(), middle_first + 1, middle_last);\\n        if (has_low_edge) dp[final_first] = low_edge;\\n        if (has_high_edge) dp[final_last] = high_edge;\\n\\n        // Blocking an intermediate cell removes its contribution from\\n        // its two valid successors. Clearing the saved value makes\\n        // duplicate obstacle coordinates idempotent.\\n        for (int column : blocked[diagonal]) {\\n            const std::uint32_t value = intermediate_values[column];\\n            intermediate_values[column] = 0;\\n            if (value == 0) continue;\\n            if (column >= final_first && column <= final_last) {\\n                dp[column] = subtract_mod(dp[column], value);\\n            }\\n            if (column + 1 >= final_first && column + 1 <= final_last) {\\n                dp[column + 1] = subtract_mod(dp[column + 1], value);\\n            }\\n        }\\n\\n        for (int column : blocked[diagonal + 1]) dp[column] = 0;\\n    }\\n\\n    std::cout << dp[n] << '\\\\n';\\n    return 0;\\n}\\n\",\n      \"path\": \"src/solution.cpp\"\n    }\n  ],\n  \"hypothesis\": \"Fusing pairs of anti-diagonal transitions and reusing NEON intermediates can reduce DP-buffer traffic and loop overhead without introducing illegal SIMD dependencies.\",\n  \"notes\": \"Retains dense O(n²) time and O(n+m) storage. No compiler flags, thread settings, or I/O changes; no measurements performed.\",\n  \"research\": {\n    \"queries\": [],\n    \"urls\": []\n  },\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Fuse two anti-diagonal updates with explicit scalar handling of expanding boundaries.\",\n    \"Pipeline and four-way unroll NEON vectors, reusing first-step intermediates and loading original values before descending stores.\",\n    \"Subtract blocked intermediate-cell contributions from their successors, then clear final-diagonal blockers; preserve duplicate-obstacle semantics.\"\n  ]\n}"}}

        "content": "#include <algorithm>\n#include <cstdint>\n#include <cstdio>\n#include <utility>\n#include <vector>\n\nnamespace {\n\nconstexpr int MOD = 1000000007;\n\nclass FastInput {\npublic:\n    int nextInt() {\n        char c;\n        do {\n            c = nextChar();\n        } while (c != '\\0' && c <= ' ');\n\n        int sign = 1;\n        if (c == '-') {\n            sign = -1;\n            c = nextChar();\n        }\n\n        int value = 0;\n        while (c >= '0' && c <= '9') {\n            value = value * 10 + (c - '0');\n            c = nextChar();\n        }\n        return value * sign;\n    }\n\nprivate:\n    static constexpr std::size_t BUFFER_SIZE = 1 << 16;\n    char buffer_[BUFFER_SIZE];\n    std::size_t position_ = 0;\n    std::size_t length_ = 0;\n\n    char nextChar() {\n        if (position_ == length_) {\n            length_ = std::fread(buffer_, 1, BUFFER_SIZE, stdin);\n            position_ = 0;\n            if (length_ == 0) {\n                return '\\0';\n            }\n        }\n        return buffer_[position_++];\n    }\n};\n\nint modPower(int base, int exponent) {\n    long long result = 1;\n    long long value = base;\n    while (exponent != 0) {\n        if (exponent & 1) {\n            result = result * value % MOD;\n        }\n        value = value * value % MOD;\n        exponent >>= 1;\n    }\n    return static_cast<int>(result);\n}\n\nclass Binomial {\npublic:\n    explicit Binomial(int n) : factorial_(2 * n - 1), inverseFactorial_(2 * n - 1) {\n        const int limit = 2 * n - 2;\n        factorial_[0] = 1;\n        for (int i = 1; i <= limit; ++i) {\n            factorial_[i] = static_cast<long long>(factorial_[i - 1]) * i % MOD;\n        }\n        inverseFactorial_[limit] = modPower(factorial_[limit], MOD - 2);\n        for (int i = limit; i > 0; --i) {\n            inverseFactorial_[i - 1] = static_cast<long long>(inverseFactorial_[i]) * i % MOD;\n        }\n    }\n\n    int paths(int dx, int dy) const {\n        if (dx == 0 || dy == 0) {\n            return 1;\n        }\n        long long result = static_cast<long long>(factorial_[dx + dy]) * inverseFactorial_[dx] % MOD;\n        return static_cast<int>(result * inverseFactorial_[dy] % MOD);\n    }\n\nprivate:\n    std::vector<int> factorial_;\n    std::vector<int> inverseFactorial_;\n};\n\nint countWithObstaclePoints(const std::vector<std::pair<int, int>>& blocked, int n) {\n    Binomial binomial(n);\n    const std::size_t count = blocked.size();\n    std::vector<int> xs(count);\n    std::vector<int> ys(count);\n    std::vector<int> ways(count);\n\n    for (std::size_t i = 0; i < count; ++i) {\n        const int y = blocked[i].first;\n        const int x = blocked[i].second;\n        int value = binomial.paths(x, y);\n\n        for (std::size_t j = 0; j < i; ++j) {\n            const int dx = x - xs[j];\n            if (dx < 0) {\n                continue;\n            }\n            const int dy = y - ys[j];\n            const int contribution = static_cast<long long>(ways[j]) * binomial.paths(dx, dy) % MOD;\n            value -= contribution;\n            if (value < 0) {\n                value += MOD;\n            }\n        }\n\n        xs[i] = x;\n        ys[i] = y;\n        ways[i] = value;\n    }\n\n    const int target = n - 1;\n    int answer = binomial.paths(target, target);\n    for (std::size_t j = 0; j < count; ++j) {\n        const int contribution = static_cast<long long>(ways[j]) *\n                                 binomial.paths(target - xs[j], target - ys[j]) % MOD;\n        answer -= contribution;\n        if (answer < 0) {\n            answer += MOD;\n        }\n    }\n    return answer;\n}\n\nint countWithRowSweep(const std::vector<std::pair<int, int>>& blocked, int n) {\n    std::vector<int> dp(n, 0);\n    dp[0] = 1;\n\n    std::size_t obstacle = 0;\n    for (int y = 0; y < n; ++y) {\n        int x = 0;\n        int left = 0;\n\n        while (obstacle < blocked.size() && blocked[obstacle].first == y) {\n            const int blockedX = blocked[obstacle].second;\n            for (; x < blockedX; ++x) {\n                int value = dp[x] + left;\n                if (value >= MOD) {\n                    value -= MOD;\n                }\n                dp[x] = value;\n                left = value;\n            }\n            dp[blockedX] = 0;\n            left = 0;\n            x = blockedX + 1;\n            ++obstacle;\n        }\n\n        for (; x < n; ++x) {\n            int value = dp[x] + left;\n            if (value >= MOD) {\n                value -= MOD;\n            }\n            dp[x] = value;\n            left = value;\n        }\n    }\n\n    return dp[n - 1];\n}\n\n}  // namespace\n\nint main() {\n    FastInput input;\n    const int n = input.nextInt();\n    const int m = input.nextInt();\n\n    std::vector<std::pair<int, int>> blocked;\n    blocked.reserve(m);\n    for (int i = 0; i < m; ++i) {\n        const int y = input.nextInt();\n        const int x = input.nextInt();\n        blocked.emplace_back(y, x);\n    }\n\n    std::sort(blocked.begin(), blocked.end());\n    blocked.erase(std::unique(blocked.begin(), blocked.end()), blocked.end());\n\n    const int target = n - 1;\n    if (!blocked.empty() &&\n        ((blocked.front().first == 0 && blocked.front().second == 0) ||\n         (blocked.back().first == target && blocked.back().second == target))) {\n        std::printf(\"0\\n\");\n        return 0;\n    }\n\n    const std::uint64_t sparseWork = static_cast<std::uint64_t>(blocked.size()) *\n                                     (static_cast<std::uint64_t>(blocked.size()) + 1) / 2;\n    const std::uint64_t rowSweepWork = static_cast<std::uint64_t>(n) * n;\n    const int answer = sparseWork <= rowSweepWork\n                           ? countWithObstaclePoints(blocked, n)\n                           : countWithRowSweep(blocked, n);\n    std::printf(\"%d\\n\", answer);\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }

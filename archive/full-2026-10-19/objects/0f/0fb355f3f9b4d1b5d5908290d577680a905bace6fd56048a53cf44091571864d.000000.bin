        "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nstatic constexpr int MOD = 1000000007;\n\nstruct Point {\n    int y;\n    int x;\n\n    bool operator<(const Point& other) const {\n        return y != other.y ? y < other.y : x < other.x;\n    }\n\n    bool operator==(const Point& other) const {\n        return y == other.y && x == other.x;\n    }\n};\n\nstatic int modPow(int base, int exponent) {\n    int64_t result = 1;\n    int64_t value = base;\n    while (exponent != 0) {\n        if (exponent & 1) {\n            result = result * value % MOD;\n        }\n        value = value * value % MOD;\n        exponent >>= 1;\n    }\n    return static_cast<int>(result);\n}\n\nstatic int countDense(int n, const vector<Point>& blockedPoints) {\n    vector<unsigned char> blocked(static_cast<size_t>(n) * n, 0);\n    for (const Point& point : blockedPoints) {\n        blocked[static_cast<size_t>(point.y) * n + point.x] = 1;\n    }\n\n    vector<int> dp(n, 0);\n    for (int y = 0; y < n; ++y) {\n        const size_t row = static_cast<size_t>(y) * n;\n        for (int x = 0; x < n; ++x) {\n            if (blocked[row + x]) {\n                dp[x] = 0;\n            } else if (y == 0 && x == 0) {\n                dp[x] = 1;\n            } else if (x != 0) {\n                int value = dp[x] + dp[x - 1];\n                if (value >= MOD) {\n                    value -= MOD;\n                }\n                dp[x] = value;\n            }\n        }\n    }\n    return dp[n - 1];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    int m;\n    if (!(cin >> n >> m)) {\n        return 0;\n    }\n\n    vector<Point> blocked;\n    blocked.reserve(m);\n    for (int i = 0; i < m; ++i) {\n        Point point;\n        cin >> point.y >> point.x;\n        blocked.push_back(point);\n    }\n\n    sort(blocked.begin(), blocked.end());\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\n\n    const Point start{0, 0};\n    const Point destination{n - 1, n - 1};\n    if (binary_search(blocked.begin(), blocked.end(), start) ||\n        binary_search(blocked.begin(), blocked.end(), destination)) {\n        cout << 0 << '\\n';\n        return 0;\n    }\n\n    // For dense small grids, a row-major bitmap and one rolling row avoid the\n    // quadratic sparse inclusion-exclusion work while retaining contiguous access.\n    constexpr int denseLimit = 4096;\n    if (n <= denseLimit && blocked.size() > static_cast<size_t>(n)) {\n        cout << countDense(n, blocked) << '\\n';\n        return 0;\n    }\n\n    vector<int> factorial(2 * n);\n    vector<int> inverseFactorial(2 * n);\n    factorial[0] = 1;\n    for (int i = 1; i < 2 * n; ++i) {\n        factorial[i] = static_cast<int>(static_cast<int64_t>(factorial[i - 1]) * i % MOD);\n    }\n    inverseFactorial.back() = modPow(factorial.back(), MOD - 2);\n    for (int i = 2 * n - 1; i > 0; --i) {\n        inverseFactorial[i - 1] = static_cast<int>(static_cast<int64_t>(inverseFactorial[i]) * i % MOD);\n    }\n\n    auto paths = [&](int dy, int dx) -> int {\n        const int total = dy + dx;\n        return static_cast<int>(static_cast<int64_t>(factorial[total]) *\n                                inverseFactorial[dy] % MOD * inverseFactorial[dx] % MOD);\n    };\n\n    blocked.push_back(destination);\n    vector<int> ways(blocked.size());\n    for (size_t current = 0; current < blocked.size(); ++current) {\n        const Point& point = blocked[current];\n        int value = paths(point.y, point.x);\n        for (size_t previous = 0; previous < current; ++previous) {\n            const Point& prior = blocked[previous];\n            if (prior.x <= point.x) {\n                const int between = paths(point.y - prior.y, point.x - prior.x);\n                value -= static_cast<int>(static_cast<int64_t>(ways[previous]) * between % MOD);\n                if (value < 0) {\n                    value += MOD;\n                }\n            }\n        }\n        ways[current] = value;\n    }\n\n    cout << ways.back() << '\\n';\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }

      "path": "src/nbody.c",
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <immintrin.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Compute the gravitational impact among all pairs of bodies in \n * the system using SIMD.\n */\nvoid body_force(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    __m256 fx = _mm256_setzero_ps();\n    __m256 fy = _mm256_setzero_ps();\n    __m256 fz = _mm256_setzero_ps();\n\n    for (int j = 0; j < n; j += 8) {\n      __m256 dx1 = _mm256_sub_ps(_mm256_loadu_ps(&p[j].x), _mm256_set1_ps(p[i].x));\n      __m256 dy1 = _mm256_sub_ps(_mm256_loadu_ps(&p[j].y), _mm256_set1_ps(p[i].y));\n      __m256 dz1 = _mm256_sub_ps(_mm256_loadu_ps(&p[j].z), _mm256_set1_ps(p[i].z));\n\n      __m256 sqrd_dist1 = _mm256_add_ps(_mm256_add_ps(_mm256_mul_ps(dx1, dx1), _mm256_mul_ps(dy1, dy1)), _mm256_add_ps(_mm256_mul_ps(dz1, dz1), _mm256_set1_ps(SOFTENING)));\n      __m256 inv_dist1 = _mm256_rsqrt_ps(sqrd_dist1);\n      __m256 inv_dist3_1 = _mm256_mul_ps(inv_dist1, _mm256_mul_ps(inv_dist1, inv_dist1));\n\n      fx = _mm256_add_ps(fx, _mm256_mul_ps(dx1, inv_dist3_1));\n      fy = _mm256_add_ps(fy, _mm256_mul_ps(dy1, inv_dist3_1));\n      fz = _mm256_add_ps(fz, _mm256_mul_ps(dz1, inv_dist3_1));\n\n      if (j + 4 < n) {\n        __m256 dx2 = _mm256_sub_ps(_mm256_loadu_ps(&p[j+4].x), _mm256_set1_ps(p[i].x));\n        __m256 dy2 = _mm256_sub_ps(_mm256_loadu_ps(&p[j+4].y), _mm256_set1_ps(p[i].y));\n        __m256 dz2 = _mm256_sub_ps(_mm256_loadu_ps(&p[j+4].z), _mm256_set1_ps(p[i].z));\n\n        __m256 sqrd_dist2 = _mm256_add_ps(_mm256_add_ps(_mm256_mul_ps(dx2, dx2), _mm256_mul_ps(dy2, dy2)), _mm256_add_ps(_mm256_mul_ps(dz2, dz2), _mm256_set1_ps(SOFTENING)));\n        __m256 inv_dist2 = _mm256_rsqrt_ps(sqrd_dist2);\n        __m256 inv_dist3_2 = _mm256_mul_ps(inv_dist2, _mm256_mul_ps(inv_dist2, inv_dist2));\n\n        fx = _mm256_add_ps(fx, _mm256_mul_ps(dx2, inv_dist3_2));\n        fy = _mm256_add_ps(fy, _mm256_mul_ps(dy2, inv_dist3_2));\n        fz = _mm256_add_ps(fz, _mm256_mul_ps(dz2, inv_dist3_2));\n      }\n    }\n\n    float fx_sum[8], fy_sum[8], fz_sum[8];\n    _mm256_storeu_ps(fx_sum, fx);\n    _mm256_storeu_ps(fy_sum, fy);\n    _mm256_storeu_ps(fz_sum, fz);\n\n    p[i].vx += dt * (fx_sum[0] + fx_sum[1] + fx_sum[2] + fx_sum[3] + fx_sum[4] + fx_sum[5] + fx_sum[6] + fx_sum[7]);\n    p[i].vy += dt * (fy_sum[0] + fy_sum[1] + fy_sum[2] + fy_sum[3] + fy_sum[4] + fy_sum[5] + fy_sum[6] + fy_sum[7]);\n    p[i].vz += dt * (fz_sum[0] + fz_sum[1] + fz_sum[2] + fz_sum[3] + fz_sum[4] + fz_sum[5] + fz_sum[6] + fz_sum[7]);\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n  \n  exit(EXIT_SUCCESS);\n}\n"
    }
  ],
  "notes": "Refactored the body_force function to use AVX intrinsics for better performance and unrolled loops where possible."
}

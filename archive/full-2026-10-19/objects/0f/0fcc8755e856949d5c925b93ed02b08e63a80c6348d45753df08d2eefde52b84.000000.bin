"""One-selected-cell LOCAL cap4 factory. Reads real parent observations; never starts any process."""
from __future__ import annotations

import argparse
import importlib.util
import json
import re
import time
from datetime import UTC, datetime
from pathlib import Path, PurePosixPath

HERE = Path(__file__).resolve().parent
spec = importlib.util.spec_from_file_location('astra_revision4', HERE / 'preparer-cellule-max.py')
m = importlib.util.module_from_spec(spec)
spec.loader.exec_module(m)
SOURCE_REVIEW_SHA = None
QDIR = None
LDIR = m.BASE / 'outputs/HPC-Forest-Primes-Natif-Lancement-r1'
FIELDS = {'ProcessId', 'ParentProcessId', 'ExecutablePath', 'CommandLine', 'CreationDate'}
SO_SESSION = '665743a02b824021a697b6a4884a667c'


def fresh(value, key='observed_at', now=None, ceiling=120):
    text = value.get(key, '')
    m.require(isinstance(text, str), 'UTC observation time required')
    instant = datetime.fromisoformat(text)
    m.require(instant.tzinfo is not None and 0 <= (time.time() if now is None else now) - instant.timestamp() <= ceiling,
              'Real parent observation must be fresh within120seconds')


def full_identity(row):
    m.require(isinstance(row, dict) and FIELDS <= set(row), 'Five complete identity fields required')
    value = {key: row[key] for key in FIELDS}
    stamp = value['CreationDate']
    m.require(isinstance(stamp, str) and re.fullmatch(r'\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d{1,7})?Z', stamp),
              'UTC ISO full process creation time required')
    if '.' in stamp:
        stamp = stamp[:-1].rstrip('0').rstrip('.') + 'Z'
    value['CreationDate'] = stamp
    return value


def check_census(census, expected_source_only, now=None, old_luna=(), running_cells=(), *, census_ref=None):
    lane = lane_module()
    state, rows, _captured, _cold = lane.verify_closed14(expected_source_only, census_ref, now=now)
    m.require(lane.read(census_ref) == census, 'Exact supplied census/reference mismatch')
    by_pid = {r['ProcessId']: r for r in rows}
    for old in old_luna:
        m.require(old['ProcessId'] not in by_pid or state.identity(by_pid[old['ProcessId']]) != state.identity(old),
                  'An old owned Luna identity remains present')
    allowed, seen = {}, set()
    for cell in running_cells:
        model = cell.get('model')
        m.require(model in m.CELLS and model != m.MODEL and model not in seen
            and cell.get('session_id') == m.CELLS[model] and cell.get('effort') == 'max'
            and cell.get('scope_id') == m.SCOPE and cell.get('source_zip_sha256') == m.SOURCE
            and cell.get('plan_sha256') == m.PLAN and str(cell.get('job_id', '')).isdigit(),
            'Existing lane must be another exact reserved R2d MAX cell')
        seen.add(model)
        auth = m.read(m.artifact(cell['authorization_ref']))
        m.require(auth.get('model') == model and auth.get('session_id') == m.CELLS[model]
            and auth.get('job_id') == cell['job_id'] and auth.get('scope_id') == m.SCOPE
            and auth.get('verified') is True and auth.get('effort') == 'max'
            and auth.get('remote_root') == '/scratch_p/nimarano/' + m.SCOPE + '-' + m.CELLS[model]
            and auth.get('artifacts', {}).get('source_zip', {}).get('sha256') == m.SOURCE
            and auth.get('artifacts', {}).get('plan', {}).get('sha256') == m.PLAN,
            'Existing R2d authorization differs')
        m.native().validate_receipt(m.artifact(cell['authorization_ref']), {m.SCOPE}, runtime=False, prepared=False, initial_lane=False)
        pair = cell.get('full_identities', [])
        m.require(isinstance(pair, list) and len(pair) == 2 and pair[0]['CommandLine'] == pair[1]['CommandLine']
            and (pair[0]['ParentProcessId'] == pair[1]['ProcessId'] or pair[1]['ParentProcessId'] == pair[0]['ProcessId']),
            'Exact launcher/Python pair required')
        for row in pair:
            pid = row['ProcessId']
            m.require(pid not in allowed and pid in by_pid and state.identity(row) == state.identity(by_pid[pid])
                and m.CELLS[model] in row['CommandLine']
                and auth['remote_root'] + '/results-' + cell['job_id'] + '/mailbox' in row['CommandLine'],
                'Existing native identity changed or duplicated')
            allowed[pid] = row
    def native_row(row):
        command = row.get('CommandLine') or ''
        executable = Path(row.get('ExecutablePath') or '').name.lower()
        return (not executable or (executable.startswith('python') and executable.endswith('.exe'))) and (
            'bootstrap_worker.py' in command.casefold() or re.search(r'hpc_forest(?:\.|[/\\])', command, re.IGNORECASE))
    native = [r for r in rows if native_row(r)]
    m.require(type(len(seen)) is int and 0 <= len(seen) < 4 and len(seen) <= 2
        and {r['ProcessId'] for r in native} == set(allowed), 'Unknown native worker or overbooked cohort')
    return {'source_only': [], 'native_identities': native, 'active_native_workers': len(seen),
        'running_models': sorted(seen), 'source_only_state': 'received_absent', 'source_only_preserved': False,
        'source_only_active_workers': 0}


def lane_module():
    spec = importlib.util.spec_from_file_location('r2d_lane_support', HERE / 'lane_support.py')
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def identity(value, job):
    expected = {'scope_id': m.SCOPE, 'model': m.MODEL, 'effort': m.EFFORT, 'session_id': m.SESSION,
                'job_id': job, 'source_zip_sha256': m.SOURCE, 'plan_sha256': m.PLAN}
    m.require(all(value.get(k) == v for k, v in expected.items()), 'Observation is not the exact selected cell/source/plan/job')


def evidence(value):
    refs = value.get('evidence_refs')
    m.require(isinstance(refs, list) and bool(refs), 'Real local parent evidence references required')
    for ref in refs:
        m.artifact(ref)


def check_observations(obs, job, source_only, old_luna, cohort):
    m.require(obs.get('schema') == 'hpc-forest-max-cell-parent-observations-v1' and obs.get('verified') is True,
              'Actual reviewed parent observations required; templates never admit')
    identity(obs, job)
    fresh(obs)
    evidence(obs)
    census = m.read(m.artifact(obs['complete_utf8_cim']))
    so = check_census(census, source_only, old_luna=old_luna, running_cells=obs.get('running_cells', []), census_ref=obs['complete_utf8_cim'])
    for cell in obs.get('running_cells', []):
        m.require(cell['job_id'] == cohort['cells'][cell['model']]['job_id'], 'Running cell differs from the reserved cohort job')
    marker = m.read(m.artifact(obs['allocation_ready']))
    identity(marker, job)
    fresh(marker, 'utc', ceiling=600)
    m.require(marker.get('schema') == 'hpc-forest-max-cell-allocation-ready-v1' and marker.get('verified') is True
              and marker.get('admission_root') == m.ADMISSION_ROOT and marker.get('native_root') == m.REMOTE_ROOT
              and marker.get('native_root_absent_before_wait') is True and marker.get('native_model_calls') == 0
              and marker.get('authorization_still_required') is True and marker.get('source_files_verified') == m.SOURCE_MEMBERS and marker.get('maximum_native_workers') == 4,
              'Actual allocated admission-directory marker required')
    allocation = marker.get('allocation', {})
    m.require(all(allocation.get(k) == v for k, v in {'job_id': job, 'nodes': 1, 'tasks': 1,
        'cpus_per_task': 4, 'memory_mib': 16384, 'gpus': 0, 'affinity_cpu_count': 4}.items())
        and len(set(allocation.get('affinity_cpu_ids', []))) == 4, 'Marker allocation is not exact4CPU/16Gi/0GPU')
    remote = m.read(m.artifact(obs['remote_freshness']))
    identity(remote, job)
    fresh(remote)
    evidence(remote)
    m.require(remote.get('schema') == 'hpc-forest-max-cell-remote-freshness-observation-v1' and remote.get('verified') is True
              and remote.get('remote_root') == m.REMOTE_ROOT and remote.get('admission_root') == m.ADMISSION_ROOT
              and all(remote.get(k) is True for k in ('native_root_absent', 'registry_absent', 'channel_absent',
                    'prior_session_claims_absent', 'parent_actual_observation_reviewed')),
              'Actual remote roots/registry/channel/session observations required')
    transport = m.read(m.artifact(obs['transport']))
    identity(transport, job)
    fresh(transport)
    evidence(transport)
    m.require(transport.get('schema') == 'hpc-forest-max-cell-existing-transport-observation-v1'
              and transport.get('verified') is True and transport.get('configuration_path') == str(m.CONFIG)
              and transport.get('configuration_sha256') == m.sha(m.CONFIG)
              and transport.get('transport_name') == 'romeo-mcp'
              and all(transport.get(k) is True for k in ('existing_transport_only', 'no_new_authentication',
                    'cli_tools_disabled', 'neutral_controls_passed', 'parent_actual_observation_reviewed')),
              'Actual existing transport/config hash/neutral-control observations required')
    m.require(not (m.LAUNCH / ('worker-' + m.SESSION)).exists(), 'Fresh local cell cache must be absent')
    return so, census, remote, transport, marker


def check_cohort(value, selected_job, review):
    m.require(value.get('schema') == 'hpc-forest-max-cell-cap4-cohort-reservation-v1'
              and value.get('verified') is True and value.get('scope_id') == m.SCOPE
              and value.get('source_zip_sha256') == m.SOURCE and value.get('plan_sha256') == m.PLAN
              and type(value.get('maximum_native_workers')) is int and value.get('maximum_native_workers') == 4
              and value.get('source_only_preserved') is False and value.get('source_only_state') == 'received_absent'
              and value.get('luna_not_replayed') is True and value.get('one_submit_per_cell') is True,
              'Actual explicit three-cell/four-slot reservation required')
    cells = value.get('cells', {})
    m.require(set(cells) == set(m.CELLS) and len({c.get('job_id') for c in cells.values()}) == 3,
              'Three distinct actually observed jobs required before any authorization')
    for model, session in m.CELLS.items():
        cell = cells[model]
        m.require(cell.get('session_id') == session and cell.get('effort') == 'max'
                  and isinstance(cell.get('job_id'), str) and cell['job_id'].isdigit(), 'Closed cohort identities required')
        intent = m.read(m.artifact(cell['submission_intent']))
        submitted_raw = m.read(m.artifact(cell['submission_observed']))
        submitted = submitted_raw.get('structuredContent', submitted_raw)
        m.require(intent.get('verified') is True and intent.get('model') == model
                  and intent.get('effort') == 'max' and intent.get('session_id') == session
                  and intent.get('source_zip_sha256') == m.SOURCE and intent.get('research_plan_sha256') == m.PLAN
                  and intent.get('maximum_native_workers') == 4 and intent.get('one_submit_only') is True
                  and intent.get('command', {}).get('sha256') == review.get('command_sha256_by_model', {}).get(model),
                  'Each cohort submit intent must bind the real reviewed single-cell command')
        m.artifact(intent['command'])
        m.require(submitted.get('ok') is True and submitted.get('submitted') is True
                  and submitted.get('submission_observed') is True and str(submitted.get('job_id')) == cell['job_id']
                  and all(submitted.get(k) == intent.get(k) and intent.get(k) for k in ('plan_id', 'plan_sha256')),
                  'Each cohort job must have an actual matching submission')
        ready = m.read(m.artifact(cell['allocation_ready']))
        fresh(ready, 'utc', ceiling=600)
        m.require(ready.get('schema') == 'hpc-forest-max-cell-allocation-ready-v1' and ready.get('verified') is True
                  and all(ready.get(k) == v for k, v in {'scope_id': m.SCOPE, 'model': model, 'effort': 'max',
                    'session_id': session, 'job_id': cell['job_id'], 'source_zip_sha256': m.SOURCE, 'plan_sha256': m.PLAN,
                    'native_model_calls': 0, 'maximum_native_workers': 4, 'authorization_still_required': True,
                    'native_root_absent_before_wait': True, 'source_files_verified': m.SOURCE_MEMBERS}.items())
                  and ready.get('native_root') == '/scratch_p/nimarano/' + m.SCOPE + '-' + session
                  and ready.get('admission_root') == '/scratch_p/nimarano/' + m.SCOPE + '-admission-' + session,
                  'All three actual allocated zero-call markers must be received before any authorization')
        resolved = submitted.get('resolved', {})
        m.require(all(resolved.get(k) == v for k, v in {'arch': 'armgpu', 'partition': 'short', 'total_cpus': 4,
            'total_gpus': 0, 'mem_gb': 16, 'time': '03:00:00', 'ntasks_per_node': 1}.items()),
            'Each actual cohort allocation must have the exact reviewed resources')
    m.require(cells[m.MODEL]['job_id'] == selected_job, 'Selected job differs from the shared cohort reservation')
    evidence(value)
    return value


def check_factory_review(value):
    m.require(value.get('schema') == 'hpc-forest-max-cell-launch-factory-independent-review-v1'
              and value.get('verified') is True and value.get('blocking_findings') == []
              and value.get('source_zip_sha256') == m.SOURCE and value.get('plan_sha256') == m.PLAN,
              'Actual independent wrapper/factory review required')
    m.require(set(value.get('command_sha256_by_model', {})) == set(m.CELLS), 'All three single-cell commands must be reviewed')
    expected = {name: m.sha(HERE / name) for name in ('preparer-cellule-max.py', 'allocated-preflight-template.py', 'assembler-admissions-cellule.py', 'publication-locale.py', 'lane_support.py',
        'rendre-trois-dossiers.py', 'lier-qualification-recue.py', 'RECEPTION-SQUELETTE-NON-ADMIS.json')}
    m.require(value.get('reviewed_files') == expected
              and value.get('command_sha256_by_model', {}).get(m.MODEL) == __import__('hashlib').sha256(m.proposal_command().encode()).hexdigest(),
              'Factory/preflight/command changed after review')


def common(schema):
    return {'schema': schema, 'scope_id': m.SCOPE, 'verified': True, 'source_zip_sha256': m.SOURCE,
            'plan_sha256': m.PLAN, 'preparation_manifest_sha256': m.PREP}


def assemble(inputs, output_name):
    m.require(set(inputs) == {'schema', 'job_id', 'submission_intent', 'submission_observed', 'observations',
        'factory_review', 'human_scope', 'cohort_reservation'}, 'Closed factory input required')
    m.require(inputs['schema'] == 'hpc-forest-max-cell-factory-input-v1', 'Wrong factory input schema')
    job = str(inputs['job_id'])
    m.require(job.isdigit(), 'Actual submitted job required, never job alone')
    module = m.native()
    m.qualification(module, m.ref(m.artifact(m.BINDING['qualification_reception'])), m.ref(m.artifact(m.BINDING['qualification'])))
    closure_ref = m.ref(LDIR / 'cloture-luna-max-verifiee.json')
    closure, first_ref = m.checked_luna(closure_ref)
    review = m.read(m.artifact(inputs['factory_review']))
    check_factory_review(review)
    original_review = m.artifact(m.BINDING['source_review'])
    m.require(m.sha(original_review) == SOURCE_REVIEW_SHA and m.read(original_review).get('blocking_findings') == [], 'Actual source review required')
    scope = m.read(m.artifact(inputs['human_scope']))
    identity(scope, job)
    m.require(scope.get('schema') == 'hpc-forest-max-cell-human-scope-attestation-v1' and scope.get('verified') is True
              and scope.get('max_only') is True and scope.get('one_cell_only') is True
              and scope.get('user_messages') and scope.get('automatic_extension') is False,
              'Real parent-attested human MAX/single-cell scope required')
    evidence(scope)
    obs = m.read(m.artifact(inputs['observations']))
    stopped = m.read(m.artifact(closure['owned_stop']))
    source_only = obs['source_only']
    old_luna = m.read(m.artifact(stopped['stop_plan_ref']))['owned_targets_in_stop_order']
    m.require(len(old_luna) == 7, 'Exact old owned family required for absence comparison')
    cohort = check_cohort(m.read(m.artifact(inputs['cohort_reservation'])), job, review)
    so, _census, remote, _transport, _marker = check_observations(obs, job, source_only, old_luna, cohort)
    m.submission_guard(inputs['submission_intent'], inputs['submission_observed'], {'job_id': job})
    m.require(m.sha(m.CLI) == m.CLI_SHA, 'Preserved CLI copy changed')
    old_cli = m.read(LDIR / 'cli-identity.json')
    m.require(old_cli['version'] == m.CLI_VERSION and {Path(r['path']).name:r['sha256'] for r in old_cli['files']} == m.CLI_FILES,
              'Immutable original CLI metadata changed')
    for item in old_cli['files']:
        m.artifact(item)
    m.require(re.fullmatch('[A-Za-z0-9][A-Za-z0-9_-]{0,63}', output_name), 'Fresh simple local output name required')
    out = HERE / output_name
    out.mkdir(exist_ok=False)
    local_dir, remote_dir = out / 'local', out / 'remote'
    local_dir.mkdir(); remote_dir.mkdir()
    now = datetime.now(UTC).isoformat()
    def local(name, value):
        return m.save(local_dir, name, value)
    # Safe upload summaries: no complete foreign census, config contents, credentials or private URLs.
    minimal = local('native-observations-minimal.json', {**common('hpc-forest-max-cell-minimal-native-observations-v1'),
        'job_id': job, 'model': m.MODEL, 'effort': m.EFFORT, 'session_id': m.SESSION,
        'observed_at': obs['observed_at'], 'source_only_state': 'received_absent', 'source_only_preserved': False,
        'source_only_active_workers': 0, 'source_only_full_identities': so['source_only'], 'other_owned_native_identities': so['native_identities'],
        'complete_local_census_sha256': obs['complete_utf8_cim']['sha256'], 'complete_local_census_exported': False,
        'active_native_workers_before_start': so['active_native_workers'], 'maximum_native_workers': 4,
        'old_luna_owned_family_absent': True, 'no_unreserved_native_workers': True,
        'remote_root': m.REMOTE_ROOT, 'admission_root': m.ADMISSION_ROOT,
        'native_root_registry_channel_absent': True, 'prior_session_claims_absent': True,
        'local_cache_absent': True, 'transport_name': 'romeo-mcp', 'configuration_path': str(m.CONFIG),
        'configuration_sha256': m.sha(m.CONFIG), 'configuration_contents_exported': False,
        'parent_observations_sha256': inputs['observations']['sha256'],
        'actual_allocation_marker_sha256': obs['allocation_ready']['sha256'],
        'independent_remote_observation_by_factory': False})
    qminimal = local('qualification-provenance-minimal.json', {**common('hpc-forest-max-cell-qualification-provenance-v1'),
        'qualification_sha256': m.QJSON, 'archive_sha256': m.QARCHIVE, 'audit_sha256': m.QAUDIT,
        'reception_sha256': m.QRECEPTION, 'qualification_job_id': m.QUALIFICATION_JOB, 'native_model_calls': 0})
    lminimal = local('luna-closure-provenance-minimal.json', {'schema': 'hpc-forest-max-cell-luna-closure-provenance-v1',
        'verified': True, 'job_id': '751992', 'bounded_closure_sha256': m.LUNA_CLOSURE,
        'audit_sha256': m.LUNA_AUDIT, 'owned_stop_sha256': m.LUNA_STOP,
        'readable_data_before_stop': 132, 'files_after_owned_stop': 133, 'lock_sha256_before': None,
        'independent_performance_audit_verified': False, 'independent_raw_stdout_per_candidate_verified': False,
        'native_research_admitted': False})
    cli_min = local('cli-file-hashes-minimal.json', {'schema': 'hpc-forest-max-cell-cli-files-rehash-v1',
        'verified': True, 'executable_path': str(m.CLI), 'executable_sha256': m.CLI_SHA, 'version': m.CLI_VERSION,
        'files': old_cli['files'], 'observed_at': now, 'authentication_exported': False, 'cli_executed': False})
    scope_min = local('human-scope-minimal.json', {**common('hpc-forest-max-cell-human-scope-minimal-v1'),
        'job_id': job, 'model': m.MODEL, 'effort': m.EFFORT, 'session_id': m.SESSION,
        'max_only': True, 'one_cell_only': True, 'automatic_extension': False,
        'local_human_scope_attestation_sha256': inputs['human_scope']['sha256']})
    refs = {'source_zip': m.ref(m.SOURCE_ZIP),
        'plan': m.ref(m.SEALED / 'native-max-plan.json'),
        'preparation_manifest': m.ref(m.SEALED / 'certified-preparation/prototype-manifest.json'),
        'preparation_review': m.ref(m.SEALED / 'preparation-review-original.json'),
        'allocated_contract_qualification': m.ref(m.artifact(m.BINDING['qualification'])),
        'allocated_contract_reception': m.ref(m.artifact(m.BINDING['qualification_reception'])), 'luna_first_start': first_ref}
    refs['luna_closure'] = local('luna-closure-admission.json', m.closure_admission(closure_ref))
    refs['cli_identity'] = local('cli-identity.json', {**common(module.SCHEMAS['cli_identity']),
        **{k: old_cli[k] for k in ('version', 'executable_path', 'executable_sha256', 'source_execution_allowed', 'files')},
        'observed_at': now, 'authentication': 'Not exported; existing local authentication must be rechecked by worker before readiness',
        'evidence_refs': [cli_min]})
    factory_min = local('factory-review-minimal.json', {**common('hpc-forest-max-cell-factory-review-minimal-v1'),
        'actual_local_review_sha256': inputs['factory_review']['sha256'], 'reviewed_files': review['reviewed_files'],
        'command_sha256': review['command_sha256_by_model'][m.MODEL], 'blocking_findings': [], 'native_calls': 0})
    refs['integration_review'] = local('integration-review.json', {**common(module.SCHEMAS['integration_review']),
        'neutral_tests_passed': True, 'blocking_findings': [], 'reviewer': review.get('reviewer'), 'reviewed_at': now,
        'limitations': ['Source review and wrapper/factory review only; no selected-cell normal call or independent performance proved'],
        'evidence_refs': [m.ref(original_review), factory_min]})
    lane_cell = {'scope_id': m.SCOPE, 'source_zip_sha256': m.SOURCE, 'plan_sha256': m.PLAN,
        'model': m.MODEL, 'effort': m.EFFORT, 'session_id': m.SESSION, 'job_id': job, 'remote_root': m.REMOTE_ROOT}
    projection, lane = lane_module().prepare(source_only, obs['complete_utf8_cim'], lane_cell,
        so['active_native_workers'], factory_review_ref=inputs['factory_review'])
    lane['minimal_owned_observations'] = local('owned-lane-projection.json', projection)
    refs['worker_lane_admission'] = local('worker-lane-admission.json', {**common(module.SCHEMAS['worker_lane_admission']),
        'active_native_workers_before_start': so['active_native_workers'], 'maximum_native_workers': 4, 'live_worker_identities': so['native_identities'],
        'observed_at': lane['observed_at'], 'lane_v2': lane, 'job_reservation': {'job_id': job, 'model': m.MODEL, 'effort': m.EFFORT, 'session_id': m.SESSION},
        'evidence_refs': [minimal]})
    refs['session_freshness'] = local('session-freshness.json', {**common(module.SCHEMAS['session_freshness']),
        'model': m.MODEL, 'effort': m.EFFORT, 'session_id': m.SESSION, 'job_id': job, 'observed_at': remote['observed_at'],
        'verified_no_prior_claims': True, 'new_cache': True, 'new_registry': True, 'native_calls_started_at_admission': 0,
        'evidence_refs': [minimal]})
    refs['transport_admission'] = local('transport-admission.json', {**common(module.SCHEMAS['transport_admission']),
        'model': m.MODEL, 'effort': m.EFFORT, 'session_id': m.SESSION, 'job_id': job, 'native_model_calls': 0,
        'normal_first_call_proved': False, 'cli_tools_disabled': True, 'neutral_tests_passed': True,
        'cli_identity_sha256': refs['cli_identity']['sha256'], 'allocated_contract_qualification_sha256': m.QJSON,
        'limits': ['Pre-call transport/source/CLI scope only; first NORMAL delivery/evaluation still required'], 'evidence_refs': [minimal]})
    refs['extension_admission'] = local('extension-admission.json', {**common(module.SCHEMAS['extension_admission']),
        'model': m.MODEL, 'effort': m.EFFORT, 'session_id': m.SESSION, 'job_id': job,
        'luna_first_start_sha256': first_ref['sha256'], 'luna_closure_sha256': refs['luna_closure']['sha256'],
        'human_max_only': True, 'one_cell_only': True, 'automatic_extension': False, 'all_prior_calls_reconciled': True,
        'maximum_native_workers': 4, 'evidence_refs': [scope_min, lminimal]})
    auth = {'schema': 'hpc-forest-primes-r2max-authorization-v2', 'scope_id': m.SCOPE, 'model': m.MODEL,
        'effort': m.EFFORT, 'session_id': m.SESSION, 'verified': True, 'expires_at': time.time() + 4 * 3600,
        'user_messages': scope['user_messages'], 'old_candidates_imported': False, 'operator_algorithm_advice': False,
        'native_calls_started_at_authorization': 0, 'job_id': job, 'remote_root': m.REMOTE_ROOT, 'artifacts': refs}
    local_auth = m.save(out, 'authorization-local-DRAFT.json', auth)
    mirrors, memo = [], {}
    approved_raw = {r['path'] for r in [qrec_ref for qrec_ref in (m.read(m.artifact(m.BINDING['qualification_reception']))['archive'],
        m.read(m.artifact(m.BINDING['qualification_reception']))['audit'], first_ref, m.ref(original_review),
        *[closure[k] for k in ('archive', 'audit', 'recorded_role_costs', 'owned_stop')])]}
    approved_existing = {refs[k]['path'] for k in ('source_zip', 'plan', 'preparation_manifest', 'preparation_review', 'allocated_contract_qualification')}
    def alias(source, name, existing=None):
        path = m.artifact(source)
        m.require(path.is_relative_to(local_dir) or path.is_relative_to(remote_dir)
                  or source['path'] in approved_raw or (existing is not None and source['path'] in approved_existing),
                  'Export source is not an owned derived proof or explicitly approved native/qualification artifact')
        remote_path = existing or m.ADMISSION_ROOT + '/' + name
        key = (str(path), remote_path)
        if key not in memo:
            mirrors.append({'remote_path': remote_path, 'local': source})
            memo[key] = {'path': remote_path, 'sha256': source['sha256']}
        return memo[key]
    for key, suffix in {'source_zip': m.SOURCE_ZIP.name, 'plan': 'native-max-plan.json',
        'preparation_manifest': 'certified-preparation/prototype-manifest.json', 'preparation_review': 'preparation-review-original.json'}.items():
        alias(refs[key], suffix, m.EXTRACTION + '/' + suffix)
    alias(refs['allocated_contract_qualification'], 'qualification.json', str(PurePosixPath(m.EXTRACTION).parent) + '/Q/qualification.json')
    # Only these approved raw artifacts cross environments. No arbitrary evidence recursion/export.
    qrec = m.read(m.artifact(refs['allocated_contract_reception']))
    qr = {**qrec, 'archive': alias(qrec['archive'], 'qualified-archive.tar.gz'),
          'audit': alias(qrec['audit'], 'qualified-audit.json'), 'evidence_refs': [alias(qminimal, 'qualification-provenance-minimal.json')]}
    remote_refs = {key: next(row for row in mirrors if row['local'] == refs[key]) for key in
                   ('source_zip', 'plan', 'preparation_manifest', 'preparation_review', 'allocated_contract_qualification')}
    remote_refs = {key: {'path': row['remote_path'], 'sha256': row['local']['sha256']} for key, row in remote_refs.items()}
    remote_refs['allocated_contract_reception'] = alias(m.save(remote_dir, 'allocated-contract-reception.json', qr), 'allocated-contract-reception.json')
    remote_refs['luna_first_start'] = alias(first_ref, 'luna-first-normal-start-original.json')
    lc = m.read(m.artifact(refs['luna_closure']))
    for key in ('archive', 'audit', 'reconciliation', 'owned_worker_absence'):
        lc[key] = alias(lc[key], 'luna-' + key + ('.tar.gz' if key == 'archive' else '.json'))
    lc['evidence_refs'] = [alias(lminimal, 'luna-closure-provenance-minimal.json')]
    remote_refs['luna_closure'] = alias(m.save(remote_dir, 'luna-closure-admission.json', lc), 'luna-closure-admission.json')
    for key in ('cli_identity', 'integration_review', 'worker_lane_admission', 'session_freshness'):
        proof = m.read(m.artifact(refs[key]))
        if key == 'worker_lane_admission':
            proof['lane_v2']['minimal_owned_observations'] = alias(proof['lane_v2']['minimal_owned_observations'], 'owned-lane-projection.json')
        proof['evidence_refs'] = [alias(r, Path(r['path']).name) for r in proof['evidence_refs']]
        remote_refs[key] = alias(m.save(remote_dir, key + '.json', proof), key + '.json')
    for key in ('transport_admission', 'extension_admission'):
        proof = m.read(m.artifact(refs[key]))
        if key == 'transport_admission':
            proof['cli_identity_sha256'] = remote_refs['cli_identity']['sha256']
        else:
            proof['luna_closure_sha256'] = remote_refs['luna_closure']['sha256']
        proof['evidence_refs'] = [alias(r, Path(r['path']).name) for r in proof['evidence_refs']]
        remote_refs[key] = alias(m.save(remote_dir, key + '.json', proof), key + '.json')
    remote_auth = m.save(out, 'authorization-remote-DRAFT.json', {**auth, 'artifacts': remote_refs})
    m.validate_authorizations(module, m.artifact(local_auth), m.artifact(remote_auth), mirrors)
    prep = {'schema': 'hpc-forest-max-cell-local-preparation-input-v1',
        'qualification_reception': m.ref(m.artifact(m.BINDING['qualification_reception'])), 'qualification': m.ref(m.artifact(m.BINDING['qualification'])),
        'luna_bounded_closure': closure_ref, 'local_authorization': local_auth, 'remote_authorization_mirror': remote_auth,
        'remote_files': mirrors, 'submission_intent': inputs['submission_intent'], 'submission_observed': inputs['submission_observed'],
        'parent_admission_review': None}
    parent_review = {**common('hpc-forest-max-cell-parent-admission-review-v1'), 'model': m.MODEL, 'effort': m.EFFORT,
        'session_id': m.SESSION, 'job_id': job, 'complete_utf8_cim_fresh_checked': True,
        'source_only_full_identities_preserved': False, 'source_only_state': 'received_absent', 'luna_full_owned_identities_absent': True,
        'no_unreserved_native_workers': True, 'local_cache_absent_checked': True, 'remote_root_registry_channel_absent_checked': True,
        'no_prior_session_claims': True, 'existing_transport_only': True, 'independent_remote_observation_by_generator': False,
        'reviewed_refs': {'worker_lane_admission': refs['worker_lane_admission'], 'session_freshness': refs['session_freshness'],
            'submission_intent': inputs['submission_intent'], 'submission_observed': inputs['submission_observed']},
        'evidence_refs': [inputs['observations'], obs['complete_utf8_cim']]}
    prep['parent_admission_review'] = m.save(out, 'parent-admission-review-LOCAL-ONLY.json', parent_review)
    m.parent_review_guard(prep['parent_admission_review'], prep, auth)
    prepared_input = m.save(out, 'input-validated.json', prep)
    # Only after all real gates and both native validators pass, publish local ready/argv files.
    final_local = m.save(out, 'authorization-local.json', auth)
    final_remote = m.save(out, 'authorization-remote.json', {**auth, 'artifacts': remote_refs})
    ready = m.save(out, 'authorization-ready.json', {'schema': 'hpc-forest-primes-r2max-authorization-upload-ready-v1',
        'scope_id': m.SCOPE, 'job_id': job, 'session_id': m.SESSION, 'sha256': final_remote['sha256'],
        'bytes': m.artifact(final_remote).stat().st_size})
    worker = [str(m.PYTHON_LOCAL), '-B', '-u', '-m', 'hpc_forest.r2max_worker', '--channel',
        m.REMOTE_ROOT + '/results-' + job + '/mailbox', '--session-id', m.SESSION, '--output', str(m.LAUNCH / ('worker-' + m.SESSION)),
        '--codex-config', str(m.CONFIG), '--dependency-receipt', final_local['path'], '--required-jobs', m.SCOPE,
        '--max-seconds', '10800', '--executable', str(m.CLI)]
    m.save(out, 'worker-argv-only.json', {'argv': worker, 'cwd': str(m.PROJECT),
        'environment': {'PYTHONPATH': str(m.PROJECT / 'src'), 'PYTHONUTF8': '1', 'PYTHONDONTWRITEBYTECODE': '1'}, 'executed': False})
    upload_manifest =  {'schema': 'hpc-forest-max-cell-explicit-upload-proposal-v1', 'verified': False,
        'job_id': job, 'performed': False, 'dependencies': [r for r in mirrors if r['remote_path'].startswith(m.ADMISSION_ROOT + '/')],
        'existing_qualified_files': [r for r in mirrors if not r['remote_path'].startswith(m.ADMISSION_ROOT + '/')],
        'authorization_publish_after_dependencies': {'remote_path': m.ADMISSION_ROOT + '/authorization.json', 'local': final_remote},
        'ready_publish_last': {'remote_path': m.ADMISSION_ROOT + '/authorization-ready.json', 'local': ready},
        'full_cim_config_credentials_exported': False, 'validated_input': prepared_input}
    m.save(out, 'upload-manifest-propose.json', upload_manifest)
    publication_spec = importlib.util.spec_from_file_location('r6_publication', HERE / 'publication-locale.py')
    publication = importlib.util.module_from_spec(publication_spec)
    publication_spec.loader.exec_module(publication)
    publication.stage(m, out, upload_manifest, obs['allocation_ready'])
    m.save(out, 'factory-status.json', {'schema': 'hpc-forest-max-cell-factory-completion-v1', 'verified': False,
        'job_id': job, 'source_zip_sha256': m.SOURCE, 'plan_sha256': m.PLAN, 'native_research_admitted': False,
        'normal_first_call_proved': False, 'both_authorization_validators_passed': True, 'native_calls': 0,
        'full_cim_config_credentials_exported': False, 'uploaded': False, 'worker_started': False})
    return out


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--bindings', type=Path, required=True)
    parser.add_argument('--bindings-sha256', required=True)
    parser.add_argument('--model', choices=sorted(m.CELLS), required=True)
    parser.add_argument('--input', type=Path, required=True)
    parser.add_argument('--input-sha256', required=True)
    parser.add_argument('--output-name', required=True)
    args = parser.parse_args()
    m.configure({'path': str(args.bindings.resolve()), 'sha256': args.bindings_sha256}, args.model)
    global QDIR, SOURCE_REVIEW_SHA
    QDIR = m.artifact(m.BINDING['qualification']).parent
    SOURCE_REVIEW_SHA = m.BINDING['source_review']['sha256']
    inputs = m.read(m.artifact({'path': str(args.input.resolve()), 'sha256': args.input_sha256}))
    out = assemble(inputs, args.output_name)
    print(json.dumps({'directory': str(out), 'executed': False, 'remote_uploads': 0, 'native_calls': 0}))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

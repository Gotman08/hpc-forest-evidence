  "structuredContent": {
    "ok": true,
    "plan_id": "c00e2594291c46d49811ec5ca67c549b",
    "plan_sha256": "19fa18bd213eae62ad10af22684f8551c26c49bdb9ca34910bf16dd2f6155deb",
    "created_at": 1792276403.531779,

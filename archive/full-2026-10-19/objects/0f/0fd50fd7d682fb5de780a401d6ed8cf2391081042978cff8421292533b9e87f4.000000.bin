    "plan": {
      "entries": [
        {
          "plan": {
            "arch": "armgpu",
            "partition": "instant",
            "script": "#!/usr/bin/env bash\n# Genere par romeo-mcp - ne pas editer a la main.\n#SBATCH --job-name=forest-primes-native-contract-qual-r1\n#SBATCH --account=r250127\n#SBATCH --qos=normal\n#SBATCH --partition=instant\n#SBATCH --constraint=armgpu\n#SBATCH --time=00:15:00\n#SBATCH --nodes=1\n#SBATCH --ntasks-per-node=1\n#SBATCH --cpus-per-task=4\n#SBATCH --mem=16G\n#SBATCH --chdir=/scratch_p/nimarano\n#SBATCH --output=/scratch_p/nimarano/%x-%j.out\n#SBATCH --error=/scratch_p/nimarano/%x-%j.err\n\nset -euo pipefail\n\n# Sans cette fonction, un job ROMEO 2025 n'a acces a aucun logiciel,\n# pas meme a la commande spack. Elle est propre a l'architecture :\n# charger celle de l'autre donnerait des binaires inutilisables.\nromeo_load_armgpu_env\n\n# Provenance du premier demarrage : environnement, commit et fichiers choisis.\nif command -v python3 >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then\n  if timeout 20s python3 -I -S - '{\"roots\": [\"/scratch_p/nimarano\", \"/project\"], \"include_home\": true, \"code_dir\": \"/scratch_p/nimarano\", \"data_files\": [\"/scratch_p/nimarano/hpc-forest-primes-native-max-1e17d198d5a2ae66.tar.gz\"], \"max_bytes\": 67108864}' <<'ROMEO_REPRO_CAPTURE'\n\nimport hashlib, json, os, pathlib, re, stat, subprocess, sys\nparams = json.loads(sys.argv[1])\nroots = [pathlib.Path(p).resolve() for p in params['roots']]\nif params.get('include_home'):\n    roots.append(pathlib.Path.home().resolve())\ndef allowed(value):\n    path = pathlib.Path(value).resolve()\n    if not any(path == root or root in path.parents for root in roots):\n        raise ValueError('outside_roots')\n    if any(p.lower().startswith(('.env', 'id_rsa', 'id_ed25519', 'id_ecdsa')) or p.lower() in ('.ssh', '.aws', '.azure', '.kube', 'hosts.yml')\n           or p.lower().endswith(('.pem', '.key', '.p12', '.pfx'))\n           or re.search(r'password|passwd|passphrase|secret|token|credential|authorization|cookie|api[_-]?key|access[_-]?key|private[_-]?key', p, re.I)\n           for p in path.parts):\n        raise ValueError('sensitive_path')\n    return path\nout = {'git': {'status': 'unavailable'}, 'data': []}\ntry:\n    code = allowed(params['code_dir'])\n    result = subprocess.run(['git', '-c', 'core.fsmonitor=false', '-C', str(code),\n                             'rev-parse', '--verify', 'HEAD'],\n                            capture_output=True, text=True, timeout=5,\n                            env={**os.environ, 'GIT_OPTIONAL_LOCKS': '0'})\n    sha = result.stdout.strip()\n    if result.returncode == 0 and len(sha) in (40, 64) and all(c in '0123456789abcdef' for c in sha):\n        out['git'] = {'status': 'observed', 'commit': sha, 'working_tree_verified': False}\nexcept (OSError, ValueError, subprocess.TimeoutExpired):\n    pass\nremaining = params['max_bytes']\nfor name in params['data_files']:\n    item = {'path': name}\n    try:\n        path = allowed(name)\n        info = path.stat()\n        if not stat.S_ISREG(info.st_mode):\n            item['status'] = 'not_regular_file'\n        elif info.st_size > remaining:\n            item.update(status='size_limit', bytes=info.st_size)\n        else:\n            h = hashlib.sha256()\n            consumed = 0\n            with path.open('rb') as stream:\n                while True:\n                    block = stream.read(min(1048576, remaining - consumed + 1))\n                    if not block:\n                        break\n                    consumed += len(block)\n                    if consumed > remaining:\n                        break\n                    h.update(block)\n            after = path.stat()\n            remaining = max(0, remaining - consumed)\n            if consumed != info.st_size or (info.st_size, info.st_mtime_ns, info.st_ino) != (after.st_size, after.st_mtime_ns, after.st_ino):\n                item['status'] = 'changed_during_read'\n            else:\n                item.update(status='hashed', sha256=h.hexdigest(), bytes=consumed)\n    except (OSError, ValueError):\n        item['status'] = 'unreadable_or_outside_roots'\n    out['data'].append(item)\n\n\nimport datetime, platform\nout['observed_at'] = datetime.datetime.now(datetime.timezone.utc).isoformat()\nout['phase'] = 'before_workload'\nout['environment'] = {\n    'source': 'compute_node_before_command', 'architecture': platform.machine(),\n    'python_version': platform.python_version(),\n    'loaded_modules': [v for v in os.environ.get('LOADEDMODULES', '').split(':') if v][:128],\n    'spack_loaded_hashes': [v for v in os.environ.get('SPACK_LOADED_HASHES', '').split(':') if v][:128],\n}\njid = os.environ.get('SLURM_JOB_ID', '')\nif os.environ.get('SLURM_ARRAY_JOB_ID') and os.environ.get('SLURM_ARRAY_TASK_ID'):\n    jid = os.environ['SLURM_ARRAY_JOB_ID'] + '_' + os.environ['SLURM_ARRAY_TASK_ID']\nif not re.fullmatch(r'[0-9]+(?:_[0-9]+)?', jid):\n    raise ValueError('missing_job_id')\nout['job_id'] = jid\nfolder = pathlib.Path('.romeo-provenance')\nfolder.mkdir(mode=0o700, exist_ok=True)\nif folder.is_symlink():\n    raise ValueError('symlink_capture_directory')\nout['restart_count'] = os.environ.get('SLURM_RESTART_COUNT', '0')\ntry:\n    fd = os.open(folder / (jid + '.json'), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)\nexcept FileExistsError:\n    pass\nelse:\n    with os.fdopen(fd, 'w') as stream:\n        json.dump(out, stream)\n        stream.write('\\n')\nROMEO_REPRO_CAPTURE\n  then :; else\n    printf '%s\\n' '[romeo-mcp] provenance indisponible ; le calcul continue.' >&2\n  fi\nfi\n\n\n# Trace d'execution : sert a diagnostiquer les erreurs d'architecture.\necho \"[romeo-mcp] noeud=$(hostname) arch=$(uname -m) job=${SLURM_JOB_ID:-?}\"\necho \"[romeo-mcp] debut $(date -Is)\"\n\nset -euo pipefail\n[[ ${SLURM_JOB_ID:-} =~ ^[0-9]+$ ]] || { echo 'Existing Slurm allocation required' >&2; exit 70; }\n[[ ${SLURM_JOB_NUM_NODES:-} == 1 && ${SLURM_NTASKS:-} == 1 && ${SLURM_CPUS_PER_TASK:-} == 4 && ${SLURM_MEM_PER_NODE:-} == 16384 ]] || { echo 'Exact 1node/1task/4CPU/16Gi allocation required' >&2; exit 71; }\n[[ ${SLURM_RESTART_COUNT:-0} == 0 ]] || { echo 'No Slurm replay allowed' >&2; exit 72; }\nexport PYTHONDONTWRITEBYTECODE=1\nexport OPENBLAS_NUM_THREADS=1\nexport OMP_NUM_THREADS=4\nsrun --nodes=1 --ntasks=1 --cpus-per-task=4 --cpu-bind=cores /scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python -I -B - <<'R2MAX_FINAL_CONTRACT_QUALIFICATION'\n\"\"\"Allocated mechanical envelope only. No native calls, transport, install or retry.\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport io\nimport json\nimport os\nimport platform\nimport re\nimport shlex\nimport subprocess\nimport sys\nimport tarfile\nimport traceback\nimport zipfile\nfrom datetime import UTC, datetime, timedelta\nfrom pathlib import Path, PurePosixPath\n\nSCOPE = \"hpc-forest-primes-native-max-r1\"\nDEADLINE = datetime(2026, 10, 31, 23, tzinfo=UTC)\nPYTHON = \"/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python\"\nSPACK_GCC = \"/zrtbeqke25s2vbqo4yrhsowjz7mg3pjf\"\nPREPARATION_SHA = \"d260af0a7b91cbe5fc7e3ab1ad9313723e385c21fdd75bd5c9623095683022fd\"\nREFERENCE_SHA = \"70e15be0d677eb40d700c3c09c20dc4d2db50132fbf9a2a4d30fb37bd3014f6d\"\nFLAGS = [\"-O2\", \"-std=c11\", \"-Werror=uninitialized\", \"-Werror=maybe-uninitialized\", \"-lm\"]\nMAX_BYTES = 64 * 1024**2\nMAX_MEMBER_BYTES = 8 * 1024**2\n\n\ndef require(value, message):\n    if not value:\n        raise RuntimeError(message)\n\n\ndef digest(raw):\n    return hashlib.sha256(raw).hexdigest()\n\n\ndef file_sha(path):\n    return digest(path.read_bytes())\n\n\ndef deadline_guard(now=None):\n    now = datetime.now(UTC) if now is None else now\n    require(now + timedelta(seconds=900 + 10800) < DEADLINE,\n            \"15-minute qualification plus three-hour reception/audit reserve exceeds exclusive deadline\")\n\n\ndef allocation_guard():\n    \"\"\"Must run before any creation, extraction, Spack, subprocess or compiler.\"\"\"\n    env = os.environ\n    require(platform.system() == \"Linux\" and platform.machine().lower() in {\"aarch64\", \"arm64\"},\n            \"Own Linux ARM64 compute allocation required\")\n    require(re.fullmatch(r\"[0-9]+\", env.get(\"SLURM_JOB_ID\", \"\")), \"Concrete Slurm job required\")\n    expected = {\"SLURM_JOB_NUM_NODES\": \"1\", \"SLURM_NTASKS\": \"1\",\n                \"SLURM_CPUS_PER_TASK\": \"4\", \"SLURM_MEM_PER_NODE\": \"16384\"}\n    require(all(env.get(key) == value for key, value in expected.items()),\n            \"Exact one-node/one-task/four-CPU/16384-MiB allocation required\")\n    gpu_keys = (\"SLURM_GPUS\", \"SLURM_GPUS_PER_NODE\", \"SLURM_JOB_GPUS\", \"SLURM_STEP_GPUS\",\n                \"CUDA_VISIBLE_DEVICES\")\n    require(all(env.get(key, \"\") in {\"\", \"0\"} for key in gpu_keys), \"Zero GPU allocation required\")\n    require(env.get(\"SLURM_RESTART_COUNT\", \"0\") == \"0\", \"An earlier Slurm attempt must not be replayed\")\n    require(hasattr(os, \"sched_getaffinity\"), \"Effective affinity observation required\")\n    affinity = sorted(os.sched_getaffinity(0))\n    require(len(affinity) == 4, \"Exactly four CPUs must be present in the effective affinity\")\n    deadline_guard()\n    return {\"job_id\": env[\"SLURM_JOB_ID\"], \"architecture\": platform.machine().lower(),\n            \"nodes\": 1, \"tasks\": 1, \"cpus_per_task\": 4, \"memory_mib\": 16384, \"gpus\": 0,\n            \"affinity_cpu_ids\": affinity, \"affinity_cpu_count\": 4}\n\n\ndef canonical_name(name):\n    path = PurePosixPath(name)\n    require(isinstance(name, str) and name and not path.is_absolute()\n            and str(path) == name and not any(part in {\".\", \"..\", \"\"} for part in path.parts)\n            and \"\\\\\" not in name and \":\" not in name\n            and not any(ord(char) < 32 for char in name), \"Noncanonical or unsafe archive member\")\n    return path\n\n\ndef read_tar(path, root_name, count):\n    \"\"\"Read regular unique members in memory before any extraction.\"\"\"\n    material = {}\n    with tarfile.open(path, \"r:gz\") as archive:\n        members = archive.getmembers()\n        require(len(members) == count and 1 <= count <= 1000, \"Unexpected bundle member count\")\n        total = 0\n        for member in members:\n            name = canonical_name(member.name)\n            require(member.isfile() and not member.issym() and not member.islnk()\n                    and name.parts[0] == root_name and len(name.parts) > 1,\n                    \"Bundle members must be regular files beneath the exact root\")\n            key = name.relative_to(root_name).as_posix()\n            total += member.size\n            require(key not in material and 0 <= member.size <= MAX_MEMBER_BYTES and total <= MAX_BYTES,\n                    \"Duplicate or oversized bundle member\")\n            stream = archive.extractfile(member)\n            require(stream is not None, \"Bundle member has no bytes\")\n            raw = stream.read(MAX_MEMBER_BYTES + 1)\n            require(len(raw) == member.size, \"Bundle member size differs from header\")\n            material[key] = raw\n    return material\n\n\ndef read_zip(raw, expected, count):\n    material = {}\n    with zipfile.ZipFile(io.BytesIO(raw)) as archive:\n        items = archive.infolist()\n        require(len(items) == count and 1 <= count <= 1000, \"Unexpected source ZIP member count\")\n        total = 0\n        for member in items:\n            name = canonical_name(member.filename)\n            kind = (member.external_attr >> 16) & 0o170000\n            require(not member.is_dir() and kind in {0, 0o100000}\n                    and name.parts[0] == \"HPC-Forest\" and len(name.parts) > 1,\n                    \"Source ZIP must contain only regular files beneath HPC-Forest\")\n            key = name.relative_to(\"HPC-Forest\").as_posix()\n            total += member.file_size\n            require(key not in material and member.file_size <= MAX_MEMBER_BYTES and total <= MAX_BYTES,\n                    \"Duplicate or oversized source ZIP member\")\n            with archive.open(member) as stream:\n                value = stream.read(MAX_MEMBER_BYTES + 1)\n            require(len(value) == member.file_size, \"Source ZIP member size differs from header\")\n            material[key] = value\n    require(isinstance(expected, dict) and set(material) == set(expected), \"Runtime manifest membership changed\")\n    require(all(digest(value) == expected[name] for name, value in material.items()),\n            \"Runtime manifest/source ZIP bytes differ\")\n    return material\n\n\ndef validate_bindings(bindings):\n    fields = {\"schema\", \"status\", \"scope_id\", \"payload_path\", \"payload_sha256\", \"payload_bytes\",\n              \"payload_root\", \"payload_member_count\", \"source_member_count\", \"source_zip_sha256\",\n              \"plan_sha256\", \"bundle_manifest_sha256\", \"runtime_manifest_sha256\", \"remote_root\",\n              \"delivery_sha256\", \"integration_review_sha256\"}\n    require(isinstance(bindings, dict) and set(bindings) == fields, \"Exact final bindings required\")\n    require(bindings[\"schema\"] == \"hpc-forest-primes-r2max-qualification-bindings-v1\"\n            and bindings[\"status\"] == \"sealed_final_delivery_reviewed\" and bindings[\"scope_id\"] == SCOPE,\n            \"Unsealed or unreviewed proposal cannot run\")\n    for key in fields:\n        if key.endswith(\"_sha256\"):\n            require(re.fullmatch(r\"[a-f0-9]{64}\", bindings[key]), \"Invalid immutable input SHA: \" + key)\n    root = PurePosixPath(bindings[\"remote_root\"])\n    payload = PurePosixPath(bindings[\"payload_path\"])\n    require(root.is_absolute() and root.parent == PurePosixPath(\"/scratch_p/nimarano\")\n            and root.name.startswith(\"hpc-forest-primes-native-contract-qualification-\")\n            and root.name.endswith(bindings[\"payload_sha256\"][:12]) and \"..\" not in root.parts,\n            \"New attempt root must be narrow, fresh and payload-bound\")\n    require(payload.is_absolute() and payload.parent == PurePosixPath(\"/scratch_p/nimarano\")\n            and \"..\" not in payload.parts and \"\\\\\" not in str(payload), \"Invalid exact payload path\")\n    require(type(bindings[\"payload_bytes\"]) is int and 0 < bindings[\"payload_bytes\"] <= MAX_BYTES,\n            \"Invalid bounded payload size\")\n    require(bindings[\"payload_root\"] == SCOPE, \"Unexpected bundle root\")\n    for key in (\"payload_member_count\", \"source_member_count\"):\n        require(type(bindings[key]) is int and 1 <= bindings[key] <= 1000, \"Invalid member count\")\n    return Path(str(root)), Path(str(payload))\n\n\ndef validate_bundle(bindings, payload):\n    require(payload.is_file() and not payload.is_symlink()\n            and payload.stat().st_size == bindings[\"payload_bytes\"]\n            and file_sha(payload) == bindings[\"payload_sha256\"], \"Exact payload bytes/type changed\")\n    material = read_tar(payload, bindings[\"payload_root\"], bindings[\"payload_member_count\"])\n    require(digest(material[\"proposal-bundle-manifest.json\"]) == bindings[\"bundle_manifest_sha256\"],\n            \"Bundle manifest changed\")\n    bundle = json.loads(material[\"proposal-bundle-manifest.json\"])\n    expected = bundle.get(\"files\")\n    require(bundle.get(\"schema\") == \"hpc-forest-r2max-proposal-bundle-manifest-v1\"\n            and isinstance(expected, dict)\n            and set(material) == set(expected) | {\"proposal-bundle-manifest.json\"},\n            \"Bundle manifest membership changed\")\n    require(all(digest(material[name]) == value for name, value in expected.items()),\n            \"Bundle manifested bytes changed\")\n    for name, expected_sha in {\n        \"HPC-Forest-Primes-Natif-MAX-r1.zip\": bindings[\"source_zip_sha256\"],\n        \"native-max-plan.json\": bindings[\"plan_sha256\"],\n        \"runtime-manifest-r2max.json\": bindings[\"runtime_manifest_sha256\"],\n        \"certified-preparation/prototype-manifest.json\": PREPARATION_SHA,\n        \"certified-preparation/data/model-view/primetest.c\": REFERENCE_SHA,\n    }.items():\n        require(digest(material[name]) == expected_sha, \"Pinned input changed: \" + name)\n    plan = json.loads(material[\"native-max-plan.json\"])\n    require(plan.get(\"scope_id\") == SCOPE and plan.get(\"source_zip_sha256\") == bindings[\"source_zip_sha256\"]\n            and plan.get(\"preparation_manifest_sha256\") == PREPARATION_SHA\n            and plan.get(\"efforts\") == [\"max\"] and plan.get(\"automatic_extension\") is False\n            and plan.get(\"compiler_flags\") == FLAGS, \"Final R2 plan binding/flags changed\")\n    manifest = json.loads(material[\"certified-preparation/prototype-manifest.json\"])\n    preparation = {name.removeprefix(\"certified-preparation/\"): raw for name, raw in material.items()\n                   if name.startswith(\"certified-preparation/\")}\n    require(set(preparation) == set(manifest) | {\"prototype-manifest.json\"}, \"Preparation membership changed\")\n    for name, info in manifest.items():\n        require(len(preparation[name]) == info[\"bytes\"] and digest(preparation[name]) == info[\"sha256\"],\n                \"Certified preparation member changed\")\n    runtime_manifest = json.loads(material[\"runtime-manifest-r2max.json\"])\n    sources = read_zip(material[\"HPC-Forest-Primes-Natif-MAX-r1.zip\"], runtime_manifest,\n                       bindings[\"source_member_count\"])\n    return material, sources\n\n\ndef save(path, value):\n    with path.open(\"x\", encoding=\"utf8\", newline=\"\\n\") as stream:\n        json.dump(value, stream, ensure_ascii=True, indent=2)\n        stream.write(\"\\n\")\n        stream.flush()\n        os.fsync(stream.fileno())\n\n\ndef inventory(root):\n    result = {}\n    for path in sorted(root.rglob(\"*\")):\n        require(not path.is_symlink(), \"A live input was replaced by a link\")\n        if path.is_file():\n            result[path.relative_to(root).as_posix()] = file_sha(path)\n    return result\n\n\ndef write_new_tree(root, material):\n    root.mkdir()\n    for name, raw in material.items():\n        relative = canonical_name(name)\n        path = root.joinpath(*relative.parts)\n        require(path.resolve().is_relative_to(root.resolve()), \"Fresh extraction escaped its root\")\n        path.parent.mkdir(parents=True, exist_ok=True)\n        with path.open(\"xb\") as stream:\n            stream.write(raw)\n    require(inventory(root) == {name: digest(raw) for name, raw in material.items()},\n            \"Freshly restored input bytes differ\")\n\n\ndef make_command(extraction, output):\n    argv = [PYTHON, \"-I\", \"-B\", str(extraction / \"HPC-Forest/examples/marathon22/qualify_r2max_contract.py\"),\n            \"--package\", str(extraction / \"certified-preparation\"), \"--output\", str(output),\n            \"--source-zip\", str(extraction / \"HPC-Forest-Primes-Natif-MAX-r1.zip\"),\n            \"--plan\", str(extraction / \"native-max-plan.json\")]\n    command = (\"set -euo pipefail\\nromeo_load_armgpu_env\\nspack load \"\n               + shlex.quote(SPACK_GCC) + \"\\nexec \" + shlex.join(argv))\n    return argv, [\"bash\", \"-lc\", command]\n\n\ndef qualification_allocation_matches(qualified, observed):\n    \"\"\"Compare actual common fields; do not fabricate absent qualifier affinity fields.\"\"\"\n    required = (\"job_id\", \"architecture\", \"nodes\", \"tasks\", \"cpus_per_task\", \"memory_mib\", \"gpus\")\n    return (isinstance(qualified, dict)\n            and all(key in qualified and qualified[key] == observed[key] for key in required)\n            and observed.get(\"affinity_cpu_count\") == 4\n            and len(observed.get(\"affinity_cpu_ids\", [])) == 4\n            and all(key not in qualified or qualified[key] == observed[key]\n                    for key in (\"affinity_cpu_ids\", \"affinity_cpu_count\")))\n\n\ndef preserve_envelope(root, receipt):\n    save(root / \"envelope-receipt.json\", receipt)\n    paths = [p for p in sorted(root.rglob(\"*\")) if p.is_file()]\n    require(all(not p.is_symlink() for p in paths), \"Refusing linked result in envelope\")\n    archive = root / (\"envelope-results-\" + os.environ[\"SLURM_JOB_ID\"] + \".tar.gz\")\n    with tarfile.open(archive, \"x:gz\") as result:\n        for path in paths:\n            result.add(path, arcname=\"qualification-envelope/\" + path.relative_to(root).as_posix(), recursive=False)\n    sidecar = {\"path\": str(archive), \"sha256\": file_sha(archive), \"bytes\": archive.stat().st_size,\n               \"passed\": receipt[\"passed\"], \"native_model_calls\": 0, \"native_research_admitted\": False}\n    save(root / \"envelope-archive.json\", sidecar)\n    print(json.dumps(sidecar), flush=True)\n\n\ndef main(bindings):\n    allocation = allocation_guard()\n    root, payload = validate_bindings(bindings)\n    require(not root.exists() and not root.is_symlink(), \"Prior attempt exists; preserve it without replay\")\n    root.mkdir()\n    receipt = {\"schema\": \"hpc-forest-primes-r2max-qualification-envelope-v1\", \"scope_id\": SCOPE,\n               \"started_utc\": datetime.now(UTC).isoformat(), \"allocation\": allocation,\n               \"bindings\": bindings, \"native_model_calls\": 0, \"native_research_admitted\": False,\n               \"performance_claimed\": False, \"qualification_launched_count\": 0,\n               \"passed\": False, \"negative_preserved_no_retry\": True,\n               \"python_executable\": sys.executable, \"python_version\": sys.version,\n               \"spack_gcc_hash\": SPACK_GCC, \"qualification_returncode\": None}\n    save(root / \"allocation-before-work.json\", receipt)\n    extraction, output, before = root / \"extraction\", root / \"Q\", None\n    try:\n        material, sources = validate_bundle(bindings, payload)\n        write_new_tree(extraction, material)\n        write_new_tree(extraction / \"HPC-Forest\", sources)\n        before = inventory(extraction)\n        save(root / \"input-inventory-before.json\", before)\n        deadline_guard()\n        allocation_guard()\n        argv, command = make_command(extraction, output)\n        save(root / \"qualification-launch-intent.json\",\n             {\"argv\": argv, \"allocated_shell_argv\": command, \"launch_count\": 1,\n              \"native_model_calls\": 0, \"no_retry\": True, \"utc\": datetime.now(UTC).isoformat()})\n        receipt[\"qualification_launched_count\"] = 1\n        try:\n            process = subprocess.run(command, capture_output=True, check=False, timeout=780,\n                                     env={**os.environ, \"PYTHONDONTWRITEBYTECODE\": \"1\",\n                                          \"OPENBLAS_NUM_THREADS\": \"1\", \"OMP_NUM_THREADS\": \"4\"})\n            stdout, stderr, code = process.stdout, process.stderr, process.returncode\n        except subprocess.TimeoutExpired as exc:\n            stdout, stderr, code = exc.stdout or b\"\", exc.stderr or b\"\", 124\n            receipt[\"timeout\"] = \"Owned direct qualification process timed out; no recursive stop or retry\"\n        (root / \"qualification-launch.stdout\").write_bytes(stdout)\n        (root / \"qualification-launch.stderr\").write_bytes(stderr)\n        receipt[\"qualification_returncode\"] = code\n        qualification_path = output / \"qualification.json\"\n        qualification_raw = qualification_path.read_bytes()\n        qualification = json.loads(qualification_raw)\n        # Preserve the original remote prepared_root and receipt bytes; never normalize these paths.\n        receipt[\"qualification_path\"] = str(qualification_path)\n        receipt[\"qualification_sha256\"] = digest(qualification_raw)\n        receipt[\"prepared_root_original\"] = qualification.get(\"prepared_root\")\n        receipt[\"qualification_allocation_original\"] = qualification.get(\"allocation\")\n        receipt[\"qualification_archive_sidecar_sha256\"] = file_sha(root / \"Q-archive.json\")\n        inner_archive = json.loads((root / \"Q-archive.json\").read_text(encoding=\"utf8\"))\n        require(inner_archive.get(\"path\") == str(root / \"Q.tar.gz\")\n                and inner_archive.get(\"sha256\") == file_sha(root / \"Q.tar.gz\")\n                and inner_archive.get(\"native_model_calls\") == 0, \"Inner qualification archive proof differs\")\n        receipt[\"qualification_archive_sha256\"] = inner_archive[\"sha256\"]\n        receipt[\"passed\"] = (code == 0 and qualification.get(\"verified\") is True\n                             and qualification.get(\"scope_id\") == SCOPE\n                             and qualification.get(\"source_zip_sha256\") == bindings[\"source_zip_sha256\"]\n                             and qualification.get(\"plan_sha256\") == bindings[\"plan_sha256\"]\n                             and qualification.get(\"reference_source_sha256\") == REFERENCE_SHA\n                             and qualification.get(\"compiler_flags\") == FLAGS\n                             and qualification.get(\"preparation_manifest_sha256\") == PREPARATION_SHA\n                             and qualification.get(\"reference_outputs_all_certified_bytes\") is True\n                             and qualification.get(\"unique_certified_cases\") == 12\n                             and qualification.get(\"native_model_calls\") == 0\n                             and qualification.get(\"native_research_admitted\") is False\n                             and qualification.get(\"prepared_root\") == str(output / \"prepared\")\n                             and qualification_allocation_matches(qualification.get(\"allocation\"), allocation))\n    except (OSError, ValueError, RuntimeError, KeyError, TypeError, tarfile.TarError,\n            zipfile.BadZipFile, subprocess.SubprocessError) as exc:\n        receipt.update(passed=False, error_type=type(exc).__name__, error=str(exc),\n                       private_traceback=traceback.format_exc())\n    finally:\n        try:\n            after = inventory(extraction) if extraction.exists() else None\n            receipt[\"input_files_unchanged\"] = before is not None and before == after\n            save(root / \"input-inventory-after.json\", {\"files\": after})\n        except (OSError, ValueError, RuntimeError) as exc:\n            receipt[\"input_files_unchanged\"] = False\n            receipt[\"inventory_error\"] = type(exc).__name__ + \": \" + str(exc)\n        receipt[\"passed\"] = receipt[\"passed\"] and receipt[\"input_files_unchanged\"]\n        receipt[\"finished_utc\"] = datetime.now(UTC).isoformat()\n        preserve_envelope(root, receipt)\n    return 0 if receipt[\"passed\"] else 1\n\n\nraise SystemExit(main(json.loads('{\"schema\": \"hpc-forest-primes-r2max-qualification-bindings-v1\", \"status\": \"sealed_final_delivery_reviewed\", \"scope_id\": \"hpc-forest-primes-native-max-r1\", \"payload_path\": \"/scratch_p/nimarano/hpc-forest-primes-native-max-1e17d198d5a2ae66.tar.gz\", \"payload_sha256\": \"1e17d198d5a2ae663504be665a326d3fca580fb4502fa37ede9831d4a71c9226\", \"payload_bytes\": 309221, \"payload_root\": \"hpc-forest-primes-native-max-r1\", \"payload_member_count\": 86, \"source_member_count\": 99, \"source_zip_sha256\": \"3e290f835570a8746be3c52144932b8c6866564980fd858cf4c0495a7b1e68c5\", \"plan_sha256\": \"54ffd49f4dc868085d22208f773c4b4883590b25251b5992232509a1dc197024\", \"bundle_manifest_sha256\": \"9b34f865e59ede240d07c3e66e70dc5d26a098daf5e2f0d8c31fa7cc32ecf10d\", \"runtime_manifest_sha256\": \"093a48b13cea5361f971e38fdeb10bfea281ac0a256b2a8c7504c7cbec019756\", \"remote_root\": \"/scratch_p/nimarano/hpc-forest-primes-native-contract-qualification-20261017-r1-1e17d198d5a2\", \"delivery_sha256\": \"b63e7fca6704679b13ea23926ae78198c29df32dbbc59a799eea89c2e24cd0a5\", \"integration_review_sha256\": \"eeeee605ff8b66ce7975c773bc8d3d004d5f0dd845c32dfea6bac8c6ccc71d3f\"}')))\nR2MAX_FINAL_CONTRACT_QUALIFICATION\n\necho \"[romeo-mcp] fin $(date -Is)\"\n",
            "seconds": 900,
            "spec": {
              "account": "r250127",
              "arch": "armgpu",
              "array": null,
              "checkpoint_contract": null,
              "checkpoint_dir": null,
              "command": "set -euo pipefail\n[[ ${SLURM_JOB_ID:-} =~ ^[0-9]+$ ]] || { echo 'Existing Slurm allocation required' >&2; exit 70; }\n[[ ${SLURM_JOB_NUM_NODES:-} == 1 && ${SLURM_NTASKS:-} == 1 && ${SLURM_CPUS_PER_TASK:-} == 4 && ${SLURM_MEM_PER_NODE:-} == 16384 ]] || { echo 'Exact 1node/1task/4CPU/16Gi allocation required' >&2; exit 71; }\n[[ ${SLURM_RESTART_COUNT:-0} == 0 ]] || { echo 'No Slurm replay allowed' >&2; exit 72; }\nexport PYTHONDONTWRITEBYTECODE=1\nexport OPENBLAS_NUM_THREADS=1\nexport OMP_NUM_THREADS=4\nsrun --nodes=1 --ntasks=1 --cpus-per-task=4 --cpu-bind=cores /scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python -I -B - <<'R2MAX_FINAL_CONTRACT_QUALIFICATION'\n\"\"\"Allocated mechanical envelope only. No native calls, transport, install or retry.\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport io\nimport json\nimport os\nimport platform\nimport re\nimport shlex\nimport subprocess\nimport sys\nimport tarfile\nimport traceback\nimport zipfile\nfrom datetime import UTC, datetime, timedelta\nfrom pathlib import Path, PurePosixPath\n\nSCOPE = \"hpc-forest-primes-native-max-r1\"\nDEADLINE = datetime(2026, 10, 31, 23, tzinfo=UTC)\nPYTHON = \"/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python\"\nSPACK_GCC = \"/zrtbeqke25s2vbqo4yrhsowjz7mg3pjf\"\nPREPARATION_SHA = \"d260af0a7b91cbe5fc7e3ab1ad9313723e385c21fdd75bd5c9623095683022fd\"\nREFERENCE_SHA = \"70e15be0d677eb40d700c3c09c20dc4d2db50132fbf9a2a4d30fb37bd3014f6d\"\nFLAGS = [\"-O2\", \"-std=c11\", \"-Werror=uninitialized\", \"-Werror=maybe-uninitialized\", \"-lm\"]\nMAX_BYTES = 64 * 1024**2\nMAX_MEMBER_BYTES = 8 * 1024**2\n\n\ndef require(value, message):\n    if not value:\n        raise RuntimeError(message)\n\n\ndef digest(raw):\n    return hashlib.sha256(raw).hexdigest()\n\n\ndef file_sha(path):\n    return digest(path.read_bytes())\n\n\ndef deadline_guard(now=None):\n    now = datetime.now(UTC) if now is None else now\n    require(now + timedelta(seconds=900 + 10800) < DEADLINE,\n            \"15-minute qualification plus three-hour reception/audit reserve exceeds exclusive deadline\")\n\n\ndef allocation_guard():\n    \"\"\"Must run before any creation, extraction, Spack, subprocess or compiler.\"\"\"\n    env = os.environ\n    require(platform.system() == \"Linux\" and platform.machine().lower() in {\"aarch64\", \"arm64\"},\n            \"Own Linux ARM64 compute allocation required\")\n    require(re.fullmatch(r\"[0-9]+\", env.get(\"SLURM_JOB_ID\", \"\")), \"Concrete Slurm job required\")\n    expected = {\"SLURM_JOB_NUM_NODES\": \"1\", \"SLURM_NTASKS\": \"1\",\n                \"SLURM_CPUS_PER_TASK\": \"4\", \"SLURM_MEM_PER_NODE\": \"16384\"}\n    require(all(env.get(key) == value for key, value in expected.items()),\n            \"Exact one-node/one-task/four-CPU/16384-MiB allocation required\")\n    gpu_keys = (\"SLURM_GPUS\", \"SLURM_GPUS_PER_NODE\", \"SLURM_JOB_GPUS\", \"SLURM_STEP_GPUS\",\n                \"CUDA_VISIBLE_DEVICES\")\n    require(all(env.get(key, \"\") in {\"\", \"0\"} for key in gpu_keys), \"Zero GPU allocation required\")\n    require(env.get(\"SLURM_RESTART_COUNT\", \"0\") == \"0\", \"An earlier Slurm attempt must not be replayed\")\n    require(hasattr(os, \"sched_getaffinity\"), \"Effective affinity observation required\")\n    affinity = sorted(os.sched_getaffinity(0))\n    require(len(affinity) == 4, \"Exactly four CPUs must be present in the effective affinity\")\n    deadline_guard()\n    return {\"job_id\": env[\"SLURM_JOB_ID\"], \"architecture\": platform.machine().lower(),\n            \"nodes\": 1, \"tasks\": 1, \"cpus_per_task\": 4, \"memory_mib\": 16384, \"gpus\": 0,\n            \"affinity_cpu_ids\": affinity, \"affinity_cpu_count\": 4}\n\n\ndef canonical_name(name):\n    path = PurePosixPath(name)\n    require(isinstance(name, str) and name and not path.is_absolute()\n            and str(path) == name and not any(part in {\".\", \"..\", \"\"} for part in path.parts)\n            and \"\\\\\" not in name and \":\" not in name\n            and not any(ord(char) < 32 for char in name), \"Noncanonical or unsafe archive member\")\n    return path\n\n\ndef read_tar(path, root_name, count):\n    \"\"\"Read regular unique members in memory before any extraction.\"\"\"\n    material = {}\n    with tarfile.open(path, \"r:gz\") as archive:\n        members = archive.getmembers()\n        require(len(members) == count and 1 <= count <= 1000, \"Unexpected bundle member count\")\n        total = 0\n        for member in members:\n            name = canonical_name(member.name)\n            require(member.isfile() and not member.issym() and not member.islnk()\n                    and name.parts[0] == root_name and len(name.parts) > 1,\n                    \"Bundle members must be regular files beneath the exact root\")\n            key = name.relative_to(root_name).as_posix()\n            total += member.size\n            require(key not in material and 0 <= member.size <= MAX_MEMBER_BYTES and total <= MAX_BYTES,\n                    \"Duplicate or oversized bundle member\")\n            stream = archive.extractfile(member)\n            require(stream is not None, \"Bundle member has no bytes\")\n            raw = stream.read(MAX_MEMBER_BYTES + 1)\n            require(len(raw) == member.size, \"Bundle member size differs from header\")\n            material[key] = raw\n    return material\n\n\ndef read_zip(raw, expected, count):\n    material = {}\n    with zipfile.ZipFile(io.BytesIO(raw)) as archive:\n        items = archive.infolist()\n        require(len(items) == count and 1 <= count <= 1000, \"Unexpected source ZIP member count\")\n        total = 0\n        for member in items:\n            name = canonical_name(member.filename)\n            kind = (member.external_attr >> 16) & 0o170000\n            require(not member.is_dir() and kind in {0, 0o100000}\n                    and name.parts[0] == \"HPC-Forest\" and len(name.parts) > 1,\n                    \"Source ZIP must contain only regular files beneath HPC-Forest\")\n            key = name.relative_to(\"HPC-Forest\").as_posix()\n            total += member.file_size\n            require(key not in material and member.file_size <= MAX_MEMBER_BYTES and total <= MAX_BYTES,\n                    \"Duplicate or oversized source ZIP member\")\n            with archive.open(member) as stream:\n                value = stream.read(MAX_MEMBER_BYTES + 1)\n            require(len(value) == member.file_size, \"Source ZIP member size differs from header\")\n            material[key] = value\n    require(isinstance(expected, dict) and set(material) == set(expected), \"Runtime manifest membership changed\")\n    require(all(digest(value) == expected[name] for name, value in material.items()),\n            \"Runtime manifest/source ZIP bytes differ\")\n    return material\n\n\ndef validate_bindings(bindings):\n    fields = {\"schema\", \"status\", \"scope_id\", \"payload_path\", \"payload_sha256\", \"payload_bytes\",\n              \"payload_root\", \"payload_member_count\", \"source_member_count\", \"source_zip_sha256\",\n              \"plan_sha256\", \"bundle_manifest_sha256\", \"runtime_manifest_sha256\", \"remote_root\",\n              \"delivery_sha256\", \"integration_review_sha256\"}\n    require(isinstance(bindings, dict) and set(bindings) == fields, \"Exact final bindings required\")\n    require(bindings[\"schema\"] == \"hpc-forest-primes-r2max-qualification-bindings-v1\"\n            and bindings[\"status\"] == \"sealed_final_delivery_reviewed\" and bindings[\"scope_id\"] == SCOPE,\n            \"Unsealed or unreviewed proposal cannot run\")\n    for key in fields:\n        if key.endswith(\"_sha256\"):\n            require(re.fullmatch(r\"[a-f0-9]{64}\", bindings[key]), \"Invalid immutable input SHA: \" + key)\n    root = PurePosixPath(bindings[\"remote_root\"])\n    payload = PurePosixPath(bindings[\"payload_path\"])\n    require(root.is_absolute() and root.parent == PurePosixPath(\"/scratch_p/nimarano\")\n            and root.name.startswith(\"hpc-forest-primes-native-contract-qualification-\")\n            and root.name.endswith(bindings[\"payload_sha256\"][:12]) and \"..\" not in root.parts,\n            \"New attempt root must be narrow, fresh and payload-bound\")\n    require(payload.is_absolute() and payload.parent == PurePosixPath(\"/scratch_p/nimarano\")\n            and \"..\" not in payload.parts and \"\\\\\" not in str(payload), \"Invalid exact payload path\")\n    require(type(bindings[\"payload_bytes\"]) is int and 0 < bindings[\"payload_bytes\"] <= MAX_BYTES,\n            \"Invalid bounded payload size\")\n    require(bindings[\"payload_root\"] == SCOPE, \"Unexpected bundle root\")\n    for key in (\"payload_member_count\", \"source_member_count\"):\n        require(type(bindings[key]) is int and 1 <= bindings[key] <= 1000, \"Invalid member count\")\n    return Path(str(root)), Path(str(payload))\n\n\ndef validate_bundle(bindings, payload):\n    require(payload.is_file() and not payload.is_symlink()\n            and payload.stat().st_size == bindings[\"payload_bytes\"]\n            and file_sha(payload) == bindings[\"payload_sha256\"], \"Exact payload bytes/type changed\")\n    material = read_tar(payload, bindings[\"payload_root\"], bindings[\"payload_member_count\"])\n    require(digest(material[\"proposal-bundle-manifest.json\"]) == bindings[\"bundle_manifest_sha256\"],\n            \"Bundle manifest changed\")\n    bundle = json.loads(material[\"proposal-bundle-manifest.json\"])\n    expected = bundle.get(\"files\")\n    require(bundle.get(\"schema\") == \"hpc-forest-r2max-proposal-bundle-manifest-v1\"\n            and isinstance(expected, dict)\n            and set(material) == set(expected) | {\"proposal-bundle-manifest.json\"},\n            \"Bundle manifest membership changed\")\n    require(all(digest(material[name]) == value for name, value in expected.items()),\n            \"Bundle manifested bytes changed\")\n    for name, expected_sha in {\n        \"HPC-Forest-Primes-Natif-MAX-r1.zip\": bindings[\"source_zip_sha256\"],\n        \"native-max-plan.json\": bindings[\"plan_sha256\"],\n        \"runtime-manifest-r2max.json\": bindings[\"runtime_manifest_sha256\"],\n        \"certified-preparation/prototype-manifest.json\": PREPARATION_SHA,\n        \"certified-preparation/data/model-view/primetest.c\": REFERENCE_SHA,\n    }.items():\n        require(digest(material[name]) == expected_sha, \"Pinned input changed: \" + name)\n    plan = json.loads(material[\"native-max-plan.json\"])\n    require(plan.get(\"scope_id\") == SCOPE and plan.get(\"source_zip_sha256\") == bindings[\"source_zip_sha256\"]\n            and plan.get(\"preparation_manifest_sha256\") == PREPARATION_SHA\n            and plan.get(\"efforts\") == [\"max\"] and plan.get(\"automatic_extension\") is False\n            and plan.get(\"compiler_flags\") == FLAGS, \"Final R2 plan binding/flags changed\")\n    manifest = json.loads(material[\"certified-preparation/prototype-manifest.json\"])\n    preparation = {name.removeprefix(\"certified-preparation/\"): raw for name, raw in material.items()\n                   if name.startswith(\"certified-preparation/\")}\n    require(set(preparation) == set(manifest) | {\"prototype-manifest.json\"}, \"Preparation membership changed\")\n    for name, info in manifest.items():\n        require(len(preparation[name]) == info[\"bytes\"] and digest(preparation[name]) == info[\"sha256\"],\n                \"Certified preparation member changed\")\n    runtime_manifest = json.loads(material[\"runtime-manifest-r2max.json\"])\n    sources = read_zip(material[\"HPC-Forest-Primes-Natif-MAX-r1.zip\"], runtime_manifest,\n                       bindings[\"source_member_count\"])\n    return material, sources\n\n\ndef save(path, value):\n    with path.open(\"x\", encoding=\"utf8\", newline=\"\\n\") as stream:\n        json.dump(value, stream, ensure_ascii=True, indent=2)\n        stream.write(\"\\n\")\n        stream.flush()\n        os.fsync(stream.fileno())\n\n\ndef inventory(root):\n    result = {}\n    for path in sorted(root.rglob(\"*\")):\n        require(not path.is_symlink(), \"A live input was replaced by a link\")\n        if path.is_file():\n            result[path.relative_to(root).as_posix()] = file_sha(path)\n    return result\n\n\ndef write_new_tree(root, material):\n    root.mkdir()\n    for name, raw in material.items():\n        relative = canonical_name(name)\n        path = root.joinpath(*relative.parts)\n        require(path.resolve().is_relative_to(root.resolve()), \"Fresh extraction escaped its root\")\n        path.parent.mkdir(parents=True, exist_ok=True)\n        with path.open(\"xb\") as stream:\n            stream.write(raw)\n    require(inventory(root) == {name: digest(raw) for name, raw in material.items()},\n            \"Freshly restored input bytes differ\")\n\n\ndef make_command(extraction, output):\n    argv = [PYTHON, \"-I\", \"-B\", str(extraction / \"HPC-Forest/examples/marathon22/qualify_r2max_contract.py\"),\n            \"--package\", str(extraction / \"certified-preparation\"), \"--output\", str(output),\n            \"--source-zip\", str(extraction / \"HPC-Forest-Primes-Natif-MAX-r1.zip\"),\n            \"--plan\", str(extraction / \"native-max-plan.json\")]\n    command = (\"set -euo pipefail\\nromeo_load_armgpu_env\\nspack load \"\n               + shlex.quote(SPACK_GCC) + \"\\nexec \" + shlex.join(argv))\n    return argv, [\"bash\", \"-lc\", command]\n\n\ndef qualification_allocation_matches(qualified, observed):\n    \"\"\"Compare actual common fields; do not fabricate absent qualifier affinity fields.\"\"\"\n    required = (\"job_id\", \"architecture\", \"nodes\", \"tasks\", \"cpus_per_task\", \"memory_mib\", \"gpus\")\n    return (isinstance(qualified, dict)\n            and all(key in qualified and qualified[key] == observed[key] for key in required)\n            and observed.get(\"affinity_cpu_count\") == 4\n            and len(observed.get(\"affinity_cpu_ids\", [])) == 4\n            and all(key not in qualified or qualified[key] == observed[key]\n                    for key in (\"affinity_cpu_ids\", \"affinity_cpu_count\")))\n\n\ndef preserve_envelope(root, receipt):\n    save(root / \"envelope-receipt.json\", receipt)\n    paths = [p for p in sorted(root.rglob(\"*\")) if p.is_file()]\n    require(all(not p.is_symlink() for p in paths), \"Refusing linked result in envelope\")\n    archive = root / (\"envelope-results-\" + os.environ[\"SLURM_JOB_ID\"] + \".tar.gz\")\n    with tarfile.open(archive, \"x:gz\") as result:\n        for path in paths:\n            result.add(path, arcname=\"qualification-envelope/\" + path.relative_to(root).as_posix(), recursive=False)\n    sidecar = {\"path\": str(archive), \"sha256\": file_sha(archive), \"bytes\": archive.stat().st_size,\n               \"passed\": receipt[\"passed\"], \"native_model_calls\": 0, \"native_research_admitted\": False}\n    save(root / \"envelope-archive.json\", sidecar)\n    print(json.dumps(sidecar), flush=True)\n\n\ndef main(bindings):\n    allocation = allocation_guard()\n    root, payload = validate_bindings(bindings)\n    require(not root.exists() and not root.is_symlink(), \"Prior attempt exists; preserve it without replay\")\n    root.mkdir()\n    receipt = {\"schema\": \"hpc-forest-primes-r2max-qualification-envelope-v1\", \"scope_id\": SCOPE,\n               \"started_utc\": datetime.now(UTC).isoformat(), \"allocation\": allocation,\n               \"bindings\": bindings, \"native_model_calls\": 0, \"native_research_admitted\": False,\n               \"performance_claimed\": False, \"qualification_launched_count\": 0,\n               \"passed\": False, \"negative_preserved_no_retry\": True,\n               \"python_executable\": sys.executable, \"python_version\": sys.version,\n               \"spack_gcc_hash\": SPACK_GCC, \"qualification_returncode\": None}\n    save(root / \"allocation-before-work.json\", receipt)\n    extraction, output, before = root / \"extraction\", root / \"Q\", None\n    try:\n        material, sources = validate_bundle(bindings, payload)\n        write_new_tree(extraction, material)\n        write_new_tree(extraction / \"HPC-Forest\", sources)\n        before = inventory(extraction)\n        save(root / \"input-inventory-before.json\", before)\n        deadline_guard()\n        allocation_guard()\n        argv, command = make_command(extraction, output)\n        save(root / \"qualification-launch-intent.json\",\n             {\"argv\": argv, \"allocated_shell_argv\": command, \"launch_count\": 1,\n              \"native_model_calls\": 0, \"no_retry\": True, \"utc\": datetime.now(UTC).isoformat()})\n        receipt[\"qualification_launched_count\"] = 1\n        try:\n            process = subprocess.run(command, capture_output=True, check=False, timeout=780,\n                                     env={**os.environ, \"PYTHONDONTWRITEBYTECODE\": \"1\",\n                                          \"OPENBLAS_NUM_THREADS\": \"1\", \"OMP_NUM_THREADS\": \"4\"})\n            stdout, stderr, code = process.stdout, process.stderr, process.returncode\n        except subprocess.TimeoutExpired as exc:\n            stdout, stderr, code = exc.stdout or b\"\", exc.stderr or b\"\", 124\n            receipt[\"timeout\"] = \"Owned direct qualification process timed out; no recursive stop or retry\"\n        (root / \"qualification-launch.stdout\").write_bytes(stdout)\n        (root / \"qualification-launch.stderr\").write_bytes(stderr)\n        receipt[\"qualification_returncode\"] = code\n        qualification_path = output / \"qualification.json\"\n        qualification_raw = qualification_path.read_bytes()\n        qualification = json.loads(qualification_raw)\n        # Preserve the original remote prepared_root and receipt bytes; never normalize these paths.\n        receipt[\"qualification_path\"] = str(qualification_path)\n        receipt[\"qualification_sha256\"] = digest(qualification_raw)\n        receipt[\"prepared_root_original\"] = qualification.get(\"prepared_root\")\n        receipt[\"qualification_allocation_original\"] = qualification.get(\"allocation\")\n        receipt[\"qualification_archive_sidecar_sha256\"] = file_sha(root / \"Q-archive.json\")\n        inner_archive = json.loads((root / \"Q-archive.json\").read_text(encoding=\"utf8\"))\n        require(inner_archive.get(\"path\") == str(root / \"Q.tar.gz\")\n                and inner_archive.get(\"sha256\") == file_sha(root / \"Q.tar.gz\")\n                and inner_archive.get(\"native_model_calls\") == 0, \"Inner qualification archive proof differs\")\n        receipt[\"qualification_archive_sha256\"] = inner_archive[\"sha256\"]\n        receipt[\"passed\"] = (code == 0 and qualification.get(\"verified\") is True\n                             and qualification.get(\"scope_id\") == SCOPE\n                             and qualification.get(\"source_zip_sha256\") == bindings[\"source_zip_sha256\"]\n                             and qualification.get(\"plan_sha256\") == bindings[\"plan_sha256\"]\n                             and qualification.get(\"reference_source_sha256\") == REFERENCE_SHA\n                             and qualification.get(\"compiler_flags\") == FLAGS\n                             and qualification.get(\"preparation_manifest_sha256\") == PREPARATION_SHA\n                             and qualification.get(\"reference_outputs_all_certified_bytes\") is True\n                             and qualification.get(\"unique_certified_cases\") == 12\n                             and qualification.get(\"native_model_calls\") == 0\n                             and qualification.get(\"native_research_admitted\") is False\n                             and qualification.get(\"prepared_root\") == str(output / \"prepared\")\n                             and qualification_allocation_matches(qualification.get(\"allocation\"), allocation))\n    except (OSError, ValueError, RuntimeError, KeyError, TypeError, tarfile.TarError,\n            zipfile.BadZipFile, subprocess.SubprocessError) as exc:\n        receipt.update(passed=False, error_type=type(exc).__name__, error=str(exc),\n                       private_traceback=traceback.format_exc())\n    finally:\n        try:\n            after = inventory(extraction) if extraction.exists() else None\n            receipt[\"input_files_unchanged\"] = before is not None and before == after\n            save(root / \"input-inventory-after.json\", {\"files\": after})\n        except (OSError, ValueError, RuntimeError) as exc:\n            receipt[\"input_files_unchanged\"] = False\n            receipt[\"inventory_error\"] = type(exc).__name__ + \": \" + str(exc)\n        receipt[\"passed\"] = receipt[\"passed\"] and receipt[\"input_files_unchanged\"]\n        receipt[\"finished_utc\"] = datetime.now(UTC).isoformat()\n        preserve_envelope(root, receipt)\n    return 0 if receipt[\"passed\"] else 1\n\n\nraise SystemExit(main(json.loads('{\"schema\": \"hpc-forest-primes-r2max-qualification-bindings-v1\", \"status\": \"sealed_final_delivery_reviewed\", \"scope_id\": \"hpc-forest-primes-native-max-r1\", \"payload_path\": \"/scratch_p/nimarano/hpc-forest-primes-native-max-1e17d198d5a2ae66.tar.gz\", \"payload_sha256\": \"1e17d198d5a2ae663504be665a326d3fca580fb4502fa37ede9831d4a71c9226\", \"payload_bytes\": 309221, \"payload_root\": \"hpc-forest-primes-native-max-r1\", \"payload_member_count\": 86, \"source_member_count\": 99, \"source_zip_sha256\": \"3e290f835570a8746be3c52144932b8c6866564980fd858cf4c0495a7b1e68c5\", \"plan_sha256\": \"54ffd49f4dc868085d22208f773c4b4883590b25251b5992232509a1dc197024\", \"bundle_manifest_sha256\": \"9b34f865e59ede240d07c3e66e70dc5d26a098daf5e2f0d8c31fa7cc32ecf10d\", \"runtime_manifest_sha256\": \"093a48b13cea5361f971e38fdeb10bfea281ac0a256b2a8c7504c7cbec019756\", \"remote_root\": \"/scratch_p/nimarano/hpc-forest-primes-native-contract-qualification-20261017-r1-1e17d198d5a2\", \"delivery_sha256\": \"b63e7fca6704679b13ea23926ae78198c29df32dbbc59a799eea89c2e24cd0a5\", \"integration_review_sha256\": \"eeeee605ff8b66ce7975c773bc8d3d004d5f0dd845c32dfea6bac8c6ccc71d3f\"}')))\nR2MAX_FINAL_CONTRACT_QUALIFICATION\n",
              "container": null,

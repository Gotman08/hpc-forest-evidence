    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <float.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n#define FORCE_TILE 64\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\ntypedef struct { float x, y, z; } Force;\n\nstatic void body_force_direct(Body *p, float dt, int n) {\n  #pragma omp parallel for schedule(static)\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * A tile exclusively owns both endpoint blocks while it runs.\n * Increasing i orders the contributions to the second block, while\n * increasing j orders the contributions to each body in the first.\n */\nstatic void accumulate_tile(const Body *restrict p, Force *restrict forces,\n                            int begin_i, int end_i,\n                            int begin_j, int end_j) {\n  for (int i = begin_i; i < end_i; ++i) {\n    float xi = p[i].x;\n    float yi = p[i].y;\n    float zi = p[i].z;\n    float fx = forces[i].x;\n    float fy = forces[i].y;\n    float fz = forces[i].z;\n    int first_j = begin_i == begin_j ? i : begin_j;\n\n    for (int j = first_j; j < end_j; ++j) {\n      float dx = p[j].x - xi;\n      float dy = p[j].y - yi;\n      float dz = p[j].z - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n\n      if (j != i) {\n        float rdx = xi - p[j].x;\n        float rdy = yi - p[j].y;\n        float rdz = zi - p[j].z;\n        forces[j].x += rdx * inv_dist3;\n        forces[j].y += rdy * inv_dist3;\n        forces[j].z += rdz * inv_dist3;\n      }\n    }\n\n    forces[i].x = fx;\n    forces[i].y = fy;\n    forces[i].z = fz;\n  }\n}\n\n/*\n * Dependence chains serialize each block's tiles in increasing source\n * order, but allow independent tiles to execute ahead of one another.\n */\nvoid body_force(Body *p, float dt, int n) {\n  if (n < 512) {\n    body_force_direct(p, dt, n);\n    return;\n  }\n\n  /* Avoid sharing inverse distances when subtraction could overflow or\n   * nonfinite operands could make NaN payloads operand-order dependent.\n   */\n  const float coordinate_limit = FLT_MAX * 0.25f;\n  for (int i = 0; i < n; ++i) {\n    if (!(fabsf(p[i].x) <= coordinate_limit) ||\n        !(fabsf(p[i].y) <= coordinate_limit) ||\n        !(fabsf(p[i].z) <= coordinate_limit)) {\n      body_force_direct(p, dt, n);\n      return;\n    }\n  }\n\n  int max_threads = 1;\n  #ifdef _OPENMP\n  max_threads = omp_get_max_threads();\n  #endif\n  int tile_size = FORCE_TILE;\n  while (tile_size > 16 &&\n         ((n - 1) / tile_size + 1) / max_threads < 4) {\n    tile_size /= 2;\n  }\n  int nblocks = (n - 1) / tile_size + 1;\n  Force *forces = (Force *)malloc((size_t)n * sizeof(*forces));\n  unsigned char *dependency =\n      (unsigned char *)malloc((size_t)nblocks * sizeof(*dependency));\n  if (forces == NULL || dependency == NULL) {\n    free(forces);\n    free(dependency);\n    body_force_direct(p, dt, n);\n    return;\n  }\n\n  #pragma omp parallel\n  {\n    #pragma omp for schedule(static)\n    for (int i = 0; i < n; ++i) {\n      forces[i].x = 0.0f;\n      forces[i].y = 0.0f;\n      forces[i].z = 0.0f;\n    }\n\n    #pragma omp single\n    {\n      /* Lexicographic upper-triangle submission gives every block\n       * source blocks 0, 1, ..., nblocks-1 in precisely that order.\n       */\n      for (int a = 0; a < nblocks; ++a) {\n        int begin_i = a * tile_size;\n        int count_i = n - begin_i;\n        if (count_i > tile_size) count_i = tile_size;\n        int end_i = begin_i + count_i;\n\n        for (int b = a; b < nblocks; ++b) {\n          int begin_j = b * tile_size;\n          int count_j = n - begin_j;\n          if (count_j > tile_size) count_j = tile_size;\n          int end_j = begin_j + count_j;\n\n          if (a == b) {\n            #pragma omp task firstprivate(begin_i, end_i) shared(p, forces) depend(inout: dependency[a])\n            {\n              accumulate_tile(p, forces, begin_i, end_i, begin_i, end_i);\n            }\n          } else {\n            #pragma omp task firstprivate(begin_i, end_i, begin_j, end_j) shared(p, forces) depend(inout: dependency[a], dependency[b])\n            {\n              accumulate_tile(p, forces, begin_i, end_i, begin_j, end_j);\n            }\n          }\n        }\n      }\n      #pragma omp taskwait\n    }\n\n    #pragma omp for schedule(static) nowait\n    for (int i = 0; i < n; ++i) {\n      p[i].vx += dt*forces[i].x;\n      p[i].vy += dt*forces[i].y;\n      p[i].vz += dt*forces[i].z;\n    }\n  }\n\n  free(dependency);\n  free(forces);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Dependency-ordered triangular OpenMP tasks can halve distance evaluations while directly updating both endpoints in reference accumulation order, avoiding quadratic scratch storage and global tile-wave barriers.",
  "notes": "Uses call-local O(n) workspace and unchanged double-precision sqrt/division expressions. Small systems, unsafe coordinate ranges and allocation failures use the source-ordered row kernel. I/O and integration remain unchanged. No commands executed.",

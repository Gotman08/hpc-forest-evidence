      "content": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nnamespace {\n\nconstexpr int kBlock = 4;\nconstexpr int kPaddedMajor = 1024;\nconstexpr unsigned kSlots = 2048;\nconstexpr unsigned kMask = kSlots - 1;\n\nstruct Bucket {\n  int key;\n  uint16_t count;\n  uint16_t tag;\n};\n\nclass FlatFrequency {\n  alignas(64) array<Bucket, kSlots> buckets{};\n  uint16_t generation = 0;\n\n  static inline uint32_t mix(int key) {\n    uint32_t value = static_cast<uint32_t>(key);\n    value ^= value >> 16;\n    value *= 0x7feb352dU;\n    value ^= value >> 15;\n    value *= 0x846ca68bU;\n    value ^= value >> 16;\n    return value;\n  }\n\n  inline uint16_t next_tag() {\n    uint16_t tag = static_cast<uint16_t>(generation + 1);\n    if (tag == 0) {\n      for (Bucket &bucket : buckets)\n        bucket.tag = 0;\n      tag = 1;\n    }\n    generation = tag;\n    return tag;\n  }\n\n  inline Bucket &locate(int key, uint16_t tag) {\n    unsigned index = mix(key) & kMask;\n    while (buckets[index].tag == tag && buckets[index].key != key)\n      index = (index + 1) & kMask;\n    return buckets[index];\n  }\n\n  inline uint16_t lookup(int key, uint16_t tag) const {\n    unsigned index = mix(key) & kMask;\n    while (true) {\n      const Bucket &bucket = buckets[index];\n      if (bucket.tag != tag)\n        return 0;\n      if (bucket.key == key)\n        return bucket.count;\n      index = (index + 1) & kMask;\n    }\n  }\n\n  inline void increment(int key, uint16_t tag) {\n    Bucket &bucket = locate(key, tag);\n    if (bucket.tag != tag) {\n      bucket.key = key;\n      bucket.count = 1;\n      bucket.tag = tag;\n    } else {\n      ++bucket.count;\n    }\n  }\n\n public:\n  long long count(const int *sums, int length, int target) {\n    const uint16_t tag = next_tag();\n    Bucket &zero = locate(0, tag);\n    zero.key = 0;\n    zero.count = 1;\n    zero.tag = tag;\n\n    int prefix = 0;\n    long long result = 0;\n    if (target == 0) {\n      for (int i = 0; i < length; ++i) {\n        prefix += sums[i];\n        Bucket &bucket = locate(prefix, tag);\n        if (bucket.tag == tag) {\n          result += bucket.count;\n          ++bucket.count;\n        } else {\n          bucket.key = prefix;\n          bucket.count = 1;\n          bucket.tag = tag;\n        }\n      }\n    } else {\n      for (int i = 0; i < length; ++i) {\n        prefix += sums[i];\n        result += lookup(prefix - target, tag);\n        increment(prefix, tag);\n      }\n    }\n    return result;\n  }\n};\n\nstatic inline void add_one(int *__restrict first,\n                           const int *__restrict row, int length) {\n  for (int i = 0; i < length; ++i)\n    first[i] += row[i];\n}\n\nstatic inline void add_two(int *__restrict first, int *__restrict second,\n                           const int *__restrict row, int length) {\n  for (int i = 0; i < length; ++i) {\n    const int value = row[i];\n    first[i] += value;\n    second[i] += value;\n  }\n}\n\nstatic inline void add_three(int *__restrict first, int *__restrict second,\n                             int *__restrict third,\n                             const int *__restrict row, int length) {\n  for (int i = 0; i < length; ++i) {\n    const int value = row[i];\n    first[i] += value;\n    second[i] += value;\n    third[i] += value;\n  }\n}\n\nstatic inline void add_four(int *__restrict first, int *__restrict second,\n                            int *__restrict third, int *__restrict fourth,\n                            const int *__restrict row, int length) {\n  for (int i = 0; i < length; ++i) {\n    const int value = row[i];\n    first[i] += value;\n    second[i] += value;\n    third[i] += value;\n    fourth[i] += value;\n  }\n}\n\nlong long run_worker(const int *values, int minor, int major, int target,\n                     atomic<int> &next_block) {\n  alignas(64) int strips[kBlock][kPaddedMajor];\n  FlatFrequency frequency;\n  long long answer = 0;\n\n  while (true) {\n    const int first = next_block.fetch_add(kBlock, memory_order_relaxed);\n    if (first >= minor)\n      break;\n\n    const int width = min(kBlock, minor - first);\n    for (int lane = 0; lane < width; ++lane)\n      fill_n(strips[lane], major, 0);\n\n    for (int right = first; right < minor; ++right) {\n      const int active = min(width, right - first + 1);\n      const int *row = values + right * major;\n      switch (active) {\n        case 1:\n          add_one(strips[0], row, major);\n          break;\n        case 2:\n          add_two(strips[0], strips[1], row, major);\n          break;\n        case 3:\n          add_three(strips[0], strips[1], strips[2], row, major);\n          break;\n        default:\n          add_four(strips[0], strips[1], strips[2], strips[3], row, major);\n          break;\n      }\n      for (int lane = 0; lane < active; ++lane)\n        answer += frequency.count(strips[lane], major, target);\n    }\n  }\n  return answer;\n}\n\nlong long solve(const vector<int> &values, int minor, int major, int target) {\n  const long long work = 1LL * minor * (minor + 1) / 2 * major;\n  const int blocks = (minor + kBlock - 1) / kBlock;\n  int workers = 1;\n  if (work >= 100000 && blocks > 1) {\n    unsigned available = thread::hardware_concurrency();\n    if (available == 0)\n      available = 1;\n    workers = min(blocks, min(4, static_cast<int>(available)));\n  }\n\n  atomic<int> next_block{0};\n  if (workers == 1)\n    return run_worker(values.data(), minor, major, target, next_block);\n\n  vector<long long> partial(workers, 0);\n  vector<thread> threads;\n  threads.reserve(workers - 1);\n  for (int worker = 1; worker < workers; ++worker) {\n    threads.emplace_back([&, worker] {\n      partial[worker] =\n          run_worker(values.data(), minor, major, target, next_block);\n    });\n  }\n  partial[0] = run_worker(values.data(), minor, major, target, next_block);\n  for (thread &worker : threads)\n    worker.join();\n\n  return accumulate(partial.begin(), partial.end(), 0LL);\n}\n\n}  // namespace\n\nint main() {\n  ios::sync_with_stdio(false);\n  cin.tie(nullptr);\n\n  int target, rows, columns;\n  cin >> target >> rows >> columns;\n\n  const int minor = min(rows, columns);\n  const int major = max(rows, columns);\n  vector<int> values(static_cast<size_t>(minor) * major);\n\n  if (rows <= columns) {\n    for (int row = 0; row < rows; ++row)\n      for (int column = 0; column < columns; ++column)\n        cin >> values[row * major + column];\n  } else {\n    for (int row = 0; row < rows; ++row)\n      for (int column = 0; column < columns; ++column) {\n        int value;\n        cin >> value;\n        values[column * major + row] = value;\n      }\n  }\n\n  cout << solve(values, minor, major, target) << '\\n';\n  return 0;\n}\n",
      "path": "src/main.cpp"
    }

      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <omp.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n  return bodies;\n}\n\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n  Body *initial = read_dataset(&nbodies);\n\n  // Allocate two buffers for double buffering to avoid data races\n  Body *bodiesA = (Body *)malloc(nbodies * sizeof(Body));\n  Body *bodiesB = (Body *)malloc(nbodies * sizeof(Body));\n  memcpy(bodiesA, initial, nbodies * sizeof(Body));\n\n  #pragma omp parallel\n  {\n    int tid = omp_get_thread_num();\n    int nthreads = omp_get_num_threads();\n\n    for (int iter = 0; iter < N_ITER; ++iter) {\n      // Determine source and destination buffers based on iteration parity\n      Body *src = (iter % 2 == 0) ? bodiesA : bodiesB;\n      Body *dst = (iter % 2 == 0) ? bodiesB : bodiesA;\n\n      // Manual partitioning: each thread handles i = tid, tid+nthreads, ...\n      for (int i = tid; i < nbodies; i += nthreads) {\n        float fx = 0.0f, fy = 0.0f, fz = 0.0f;\n        // Use source buffer for all reads\n        for (int j = 0; j < nbodies; ++j) {\n          float dx = src[j].x - src[i].x;\n          float dy = src[j].y - src[i].y;\n          float dz = src[j].z - src[i].z;\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          float inv_dist = 1.0f / sqrt(sqrd_dist);\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n        }\n        dst[i].vx = src[i].vx + DT*fx;\n        dst[i].vy = src[i].vy + DT*fy;\n        dst[i].vz = src[i].vz + DT*fz;\n        dst[i].x = src[i].x + dst[i].vx * DT;\n        dst[i].y = src[i].y + dst[i].vy * DT;\n        dst[i].z = src[i].z + dst[i].vz * DT;\n      }\n\n      // Ensure all threads have written dst before next iteration reads it as src\n      #pragma omp barrier\n    }\n  }\n\n  // Final state is in bodiesA if N_ITER even, else bodiesB\n  Body *final_bodies = (N_ITER % 2 == 0) ? bodiesA : bodiesB;\n  write_dataset(nbodies, final_bodies);\n\n  free(initial);\n  free(bodiesA);\n  free(bodiesB);\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Using double-buffered body arrays and manual per-thread index partitioning (stride by number of threads) eliminates data races, reduces worksharing scheduling overhead, and preserves deterministic per-body accumulation order, improving performance on 4 cores.",
  "notes": "The transformation replaces the OpenMP worksharing loop with explicit thread-indexed loops and adds a barrier after each iteration. Double buffering ensures all reads use the previous timestep's state, matching the reference sequential semantics while avoiding race conditions. SIMD was intentionally not used to preserve exact floating-point accumulation order required by byte-exact output comparison.",

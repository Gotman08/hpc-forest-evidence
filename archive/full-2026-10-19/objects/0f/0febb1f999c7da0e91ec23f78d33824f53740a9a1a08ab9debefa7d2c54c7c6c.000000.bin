            "src/main.cpp"
          ],
          "retained": [
            "Orient the input as a row-major matrix with the smaller original dimension as rows, transposing while reading when needed.",
            "Enumerate row bands along that smaller dimension, incrementally update a column-sum vector, and count target-sum intervals with the existing hash-based prefix method."
          ]
        },

"""Deterministic, source-linked publication figures; no generated observations."""

import csv
import json
from collections import defaultdict
from pathlib import Path

import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
from matplotlib.patches import FancyArrowPatch, FancyBboxPatch

HERE = Path(__file__).resolve().parent
DATA = HERE / "donnees"
FIG = HERE / "figures"
for p in (FIG, FIG / "arbres", FIG / "cpu"):
    p.mkdir(exist_ok=True, parents=True)
BLUE, ORANGE, GREEN, PURPLE, GREY = (
    "#0072B2",
    "#D55E00",
    "#009E73",
    "#8C5299",
    "#687682",
)
plt.rcParams.update(
    {
        "font.family": "DejaVu Sans",
        "font.size": 10,
        "axes.titlesize": 11,
        "axes.labelsize": 10,
        "legend.fontsize": 8.5,
        "xtick.labelsize": 9,
        "ytick.labelsize": 9,
        "axes.spines.top": False,
        "axes.spines.right": False,
        "axes.grid": True,
        "grid.color": "#dbe3e9",
        "grid.linewidth": 0.5,
        "savefig.facecolor": "white",
        "svg.fonttype": "none",
        "pdf.fonttype": 42,
    }
)
MANIFEST = []


def read(name):
    return json.loads((DATA / name).read_text(encoding="utf-8"))


def save(fig, name, kind, sources):
    fig.savefig(FIG / (name + ".png"), dpi=300, bbox_inches="tight", pad_inches=0.12)
    fig.savefig(FIG / (name + ".svg"), bbox_inches="tight", pad_inches=0.12)
    MANIFEST.append(
        {
            "name": name,
            "kind": kind,
            "sources": sources,
            "fabricated_edges": 0,
            "made_from_data": kind != "conceptual",
        }
    )
    plt.close(fig)


def box(ax, x, y, w, h, text, color=BLUE, fill="#f0f6fa", fontsize=10):
    ax.add_patch(
        FancyBboxPatch(
            (x, y),
            w,
            h,
            boxstyle="round,pad=0.012,rounding_size=0.014",
            facecolor=fill,
            edgecolor=color,
            lw=1.2,
        )
    )
    ax.text(
        x + w / 2,
        y + h / 2,
        text,
        ha="center",
        va="center",
        fontsize=fontsize,
        color="#172d3c",
        linespacing=1.45,
    )


def arrow(ax, start, end, label="", color=GREY, style="-", rad=0):
    ax.add_patch(
        FancyArrowPatch(
            start,
            end,
            arrowstyle="-|>",
            mutation_scale=11,
            color=color,
            lw=1.1,
            linestyle=style,
            connectionstyle=f"arc3,rad={rad}",
        )
    )
    if label:
        ax.text(
            (start[0] + end[0]) / 2,
            (start[1] + end[1]) / 2 + 0.02,
            label,
            ha="center",
            fontsize=8,
            color=color,
        )


def protocol():
    f, ax = plt.subplots(figsize=(7.5, 3.7))
    ax.set(xlim=(0, 1), ylim=(-0.03, 1))
    ax.axis("off")
    box(
        ax,
        0.025,
        0.76,
        0.19,
        0.18,
        "Sources officielles\nContrat et cible\nRéférence figée",
        fontsize=9,
    )
    box(
        ax,
        0.32,
        0.76,
        0.34,
        0.18,
        "Mère modèle R1\nPréparation + synthèse\nAu plus deux épisodes",
        fontsize=9,
    )
    for x, label in [(0.23, "A"), (0.36, "B"), (0.49, "C")]:
        box(ax, x, 0.44, 0.085, 0.16, "Arbre " + label, BLUE, fontsize=9)
    box(ax, 0.72, 0.44, 0.23, 0.16, "Arbre G\nIntégration neuve", PURPLE, "#f6f0f9", 9)
    box(
        ax,
        0.23,
        0.20,
        0.72,
        0.12,
        "Pour chaque programme A/B/C/G : compilation, oracle et trois temps de recherche",
        GREEN,
        "#f0f8f5",
        9,
    )
    box(
        ax,
        0.23,
        0.015,
        0.35,
        0.12,
        "Confirmation distincte\nCinq temps intercalés · marge de 3 %",
        GREEN,
        "#f0f8f5",
        9,
    )
    box(
        ax,
        0.67,
        0.015,
        0.28,
        0.12,
        "Après réception : diagnostics CPU\nMêmes octets · 1 à 16 cœurs",
        GREY,
        "#f4f5f6",
        8.5,
    )
    arrow(ax, (0.23, 0.85), (0.305, 0.85))
    arrow(ax, (0.49, 0.745), (0.40, 0.62))
    arrow(ax, (0.66, 0.75), (0.84, 0.62), "synthèse", color=PURPLE)
    for x in [0.27, 0.40, 0.53]:
        arrow(ax, (x, 0.435), (x, 0.335), color=GREEN)
        arrow(ax, (x + 0.04, 0.61), (0.72, 0.59), color=PURPLE, style="--", rad=-0.12)
    arrow(ax, (0.84, 0.435), (0.84, 0.335), color=GREEN)
    arrow(ax, (0.24, 0.26), (0.23, 0.52), "tell / score", color=BLUE, rad=-0.75)
    arrow(ax, (0.405, 0.185), (0.405, 0.15))
    arrow(ax, (0.595, 0.075), (0.65, 0.075))
    ax.text(
        0.025,
        0.065,
        "Forêt fixe R1\nR4 : préparée,\nsans essai natif reçu",
        fontsize=8.5,
        color=GREY,
    )
    f.tight_layout()
    save(
        f,
        "protocole",
        "observed_protocol",
        ["R1 frozen mother.py/search.py", "registres-recalcules.json"],
    )
    f, ax = plt.subplots(figsize=(9.8, 4.4))
    ax.set(xlim=(0, 1), ylim=(0, 1))
    ax.axis("off")
    box(
        ax,
        0.25,
        0.77,
        0.49,
        0.17,
        "R choisit n axes dans les capacités préparées",
        PURPLE,
        "#f6f0f9",
        10,
    )
    for x, label in [(0.04, "Branche 1"), (0.37, "Branche 2"), (0.70, "Branche n")]:
        box(
            ax,
            x,
            0.39,
            0.25,
            0.22,
            label + "\nMCTS + harnais propres\nHistoire locale seulement",
        )
        arrow(
            ax,
            (0.49, 0.76),
            (x + 0.12, 0.64),
            "conseil local" if x == 0.04 else "",
            color=BLUE,
        )
        arrow(ax, (x + 0.12, 0.39), (0.49, 0.20), color=PURPLE, style="--")
    box(
        ax,
        0.32,
        0.035,
        0.36,
        0.16,
        "Récolte globale distincte\nNouveau programme vérifié et mesuré",
        PURPLE,
        "#f6f0f9",
        10,
    )
    ax.text(
        0.5,
        0.005,
        "Schéma conceptuel • contrôles mécaniques reçus • recherche native non validée",
        ha="center",
        va="top",
        fontsize=9,
        color=GREY,
    )
    save(f, "r4-concept", "conceptual", ["R4 frozen protocol and preflight receipt"])


def forest(r, path, title, main=False):
    trials = r["trials"]
    scored = [x for x in trials if (x["result"] or {}).get("score") is not None]
    by = {t["id"]: t for t in scored}
    roots = [x["id"] for x in r["tree_roots"]]
    assert {t["mission"]["tree_id"] for t in scored}.issubset(roots)
    coords, labels = {}, {}
    large = len(scored) > 32
    for rootno, root in enumerate(roots):
        nodes = [t for t in scored if t["mission"]["tree_id"] == root]
        children = defaultdict(list)
        for t in nodes:
            parent = t["mission"].get("parent_id") or root
            assert parent == root or parent in by, (t["id"], parent)
            children[parent].append(t["id"])
        leaf = [0]

        def layout(node, depth, children=children, leaf=leaf):
            if children[node]:
                xs = [layout(child, depth + 1) for child in children[node]]
                x = sum(xs) / len(xs)
            else:
                x = leaf[0]
                leaf[0] += 1
            coords[node] = (x, depth)
            return x

        layout(root, 0)
        width = max(1, leaf[0] - 1)
        for node in [root, *[t["id"] for t in nodes]]:
            x, dep = coords[node]
            coords[node] = (
                ((x / width - 0.5) * 3.65, rootno * 1.5 + dep * 0.22)
                if large
                else (rootno + (x / width - 0.5) * 0.85, dep)
            )
        for label_no, t in enumerate(nodes, 1):
            labels[t["id"]] = f"{t['role']}{label_no}"
    f, ax = plt.subplots(
        figsize=(7.5 if main else 8.2, 9 if large else 3.6 if len(scored) <= 12 else 4.3)
    )
    for t in scored:
        m = t["mission"]
        a = coords[m.get("parent_id") or m["tree_id"]]
        b = coords[t["id"]]
        ax.plot([a[0], b[0]], [-a[1], -b[1]], color="#71818e", lw=0.9, zorder=1)
        for source in [] if large else m.get("sources", []):
            if source in coords:
                a2 = coords[source]
                ax.annotate(
                    "",
                    xy=(b[0], -b[1]),
                    xytext=(a2[0], -a2[1]),
                    arrowprops={
                        "arrowstyle": "->",
                        "color": PURPLE,
                        "lw": 0.65,
                        "linestyle": "--",
                        "alpha": 0.45,
                        "connectionstyle": "arc3,rad=.09",
                    },
                    zorder=0,
                )
    for root in roots:
        x, dep = coords[root]
        ax.scatter(
            [x],
            [-dep],
            s=290,
            marker="s",
            facecolor="#edf1f4",
            edgecolor=GREY,
            zorder=4,
        )
        ax.text(
            x, -dep, root.split(":")[-1], ha="center", va="center", fontsize=9, zorder=5
        )
    node_size = 370 if len(scored) < 14 else 170 if large else 165
    font = 9 if main else 8 if len(scored) < 14 else 7 if large else 6
    best = r["best_confirmed"]["experiment_id"]
    for t in scored:
        x, dep = coords[t["id"]]
        out = t["result"]
        color = (
            BLUE
            if out.get("status") == "valid"
            else ORANGE
            if out.get("status") == "incorrect"
            else GREY
        )
        ax.scatter(
            [x],
            [-dep],
            s=node_size,
            facecolor="white",
            edgecolor=color,
            linewidth=2 if t["id"] == best else 1,
            zorder=4,
            marker="s"
            if t["id"] == best
            else "o"
            if out.get("status") == "valid"
            else "^"
            if out.get("status") == "incorrect"
            else "D",
        )
        ax.text(
            x,
            -dep,
            labels[t["id"]],
            ha="center",
            va="center",
            fontsize=font,
            color=color,
            zorder=5,
        )
    missing = len(trials) - len(scored)
    ax.set_title(
        title
        + f"\n{len(scored)} sommets notés · {missing} missions sans nouveau score"
        + (" · référence conservée" if r["best_confirmed"]["is_baseline"] else ""),
        loc="left",
        fontsize=11 if main else 10,
        pad=18,
    )
    ax.set(
        xticks=[], yticks=[], xlim=(-2.1, 2.1) if large else (-0.6, len(roots) - 0.4)
    )
    ax.set_ylim(-max((x[1] for x in coords.values()), default=1) - 0.35, 0.6)
    for spine in ax.spines.values():
        spine.set_visible(False)
    ax.grid(False)
    ax.text(
        0.0,
        -0.045 if large else -0.08,
        "Bleu : valide   Orange : incorrect   Gris : autre score\nCarré encadré : retenu en confirmation"
        + (" · Sources G : liste complète dans l’export" if large else ""),
        transform=ax.transAxes,
        fontsize=9 if main else 8,
        color=GREY,
    )
    f.tight_layout()
    save(f, path, "recorded_tree", ["registres-recalcules.json", r["registry_sha256"]])
    assert len(set(labels.values())) == len(labels)
    MANIFEST[-1]["root_ids"] = roots
    MANIFEST[-1]["nodes"] = [
        {
            "label": labels[t["id"]],
            "id": t["id"],
            "parent_id": t["mission"].get("parent_id"),
            "tree_id": t["mission"]["tree_id"],
            "integration_sources": t["mission"].get("sources", []),
            "source_mission_ordinal": t["mission"].get("ordinal"),
        }
        for t in scored
    ]


def main():
    protocol()
    rows = read("confirmations-recalculees.json")
    count = [r for r in rows if r["cohort"] == "count"]
    models = ["gpt-6-luna", "gpt-6-astra", "gpt-5.6-terra", "gpt-6.1-sol"]
    efforts = ["max", "xhigh", "high", "medium", "low"]
    values = np.array(
        [
            [
                next(
                    r["gain_percent"]
                    for r in count
                    if r["model"] == m and r["effort"] == e
                )
                for e in efforts
            ]
            for m in models
        ]
    )
    f, ax = plt.subplots(figsize=(7.5, 2.8))
    im = ax.imshow(values, cmap="Blues", vmin=0, vmax=100, aspect="auto")
    for i in range(4):
        for j in range(5):
            ax.text(
                j,
                i,
                f"{values[i, j]:.2f} %".replace(".", ","),
                ha="center",
                va="center",
                color="white" if values[i, j] > 65 else "#172d3c",
                fontsize=12,
            )
    ax.set(xticks=range(5), xticklabels=efforts, yticks=range(4), yticklabels=models)
    ax.xaxis.tick_top()
    ax.grid(False)
    cb = f.colorbar(im, ax=ax, shrink=0.85, pad=0.025)
    cb.set_label("Réduction confirmée (%)")
    f.tight_layout()
    save(
        f, "count", "observed_data", ["confirmations-recalculees.json", "cohort=count"]
    )
    luna = [r for r in rows if r["cohort"] == "luna"]
    astra = {r["subject"]: r for r in rows if r["cohort"] == "astra"}
    terra = {r["subject"]: r for r in rows if r["cohort"] == "terra"}
    sol = {r["subject"]: r for r in rows if r["cohort"] == "sol"}
    f, ax = plt.subplots(figsize=(7.6, 8.2))
    for cohort, offset, color, label in [(luna, -.30, BLUE, "Luna MAX"),
                                        ([astra[r["subject"]] for r in luna], -.10, ORANGE, "Astra MAX"),
                                        ([terra[r["subject"]] for r in luna], .10, GREEN, "Terra MAX"),
                                        ([sol[r["subject"]] for r in luna], .30, PURPLE, "Sol MAX")]:
        for i, r in enumerate(cohort):
            y = i + offset
            if r["baseline_retained"]:
                ax.scatter(0, y, facecolor="white", edgecolor=color, s=30, zorder=3)
            else:
                ax.barh(y, r["gain_percent"], color=color, height=.16,
                        label=label if i == 1 else None)
            ax.text(r["gain_percent"] + 1.0, y,
                    f"{r['gain_percent']:.2f}".replace(".", ","),
                    va="center", fontsize=8.0, color=color)
    ax.set(
        yticks=range(len(luna)),
        yticklabels=[r["subject"].replace("quicksort", "quicksort *") for r in luna],
        xlabel="Réduction confirmée du temps (%)",
        xlim=(-2, 111),
    )
    ax.invert_yaxis()
    ax.grid(axis="y", visible=False)
    ax.legend(loc="lower left", bbox_to_anchor=(0, 1.01), ncol=4, frameon=False, fontsize=9.5)
    f.tight_layout()
    save(f, "luna", "observed_data", ["confirmations-recalculees.json", "cohorts=luna,astra,terra,sol",
                                      "comparabilite-couvertures-luna-astra-terra-sol-max.json"])
    regs = read("registres-recalcules.json")
    example = next(
        r
        for r in regs
        if "coverage-gpt-6-luna-max" in r["campaign_root"]
        and r["config"]["problem"] == "2022-knn"
    )
    forest(example, "arbre-exemple", "k-NN 2022 · Luna MAX · liens enregistrés", True)
    comp = [r for r in rows if r["cohort"] == "comparison"]
    f, axs = plt.subplots(1, 3, figsize=(7.5, 3.0))
    for ax, s in zip(axs, ["knn", "sum", "nbody"]):
        for i, (arm, color) in enumerate(
            [("reference", BLUE), ("mixed-harness", ORANGE)]
        ):
            row = next(
                r for r in comp if r["subject"] == "2022-" + s and r["arm"] == arm
            )
            raw = next(r for r in regs if r["campaign_root"] == row["campaign_root"])
            vals = np.array(raw["chosen_samples"]) * 1000
            ax.scatter(
                i + np.linspace(-0.09, 0.09, 5), vals, color=color, s=25, zorder=3
            )
            ax.errorbar(
                i,
                float(np.mean(vals)),
                yerr=float(np.std(vals, ddof=1)),
                fmt="_",
                color="#152c3b",
                capsize=7,
                markersize=21,
                lw=1.2,
                zorder=4,
            )
        ax.set(
            xticks=[0, 1],
            xticklabels=["Sans\nharnais", "Avec\nharnais"],
            title=s,
            xlim=(-0.5, 1.5),
            ylabel="Temps de confirmation (ms)",
        )
        ax.grid(axis="x", visible=False)
    f.tight_layout(w_pad=2.2)
    save(
        f,
        "comparaison",
        "observed_data",
        ["registres-recalcules.json", "cohort=comparison"],
    )
    with (DATA / "cpu-comparaisons.csv").open(encoding="utf-8-sig") as h:
        cpu = list(csv.DictReader(h))

    def curve(batch, subject, arm=""):
        rr = [
            r
            for r in cpu
            if int(r["batch"]) == batch
            and r["subject"] == subject
            and r["case_name"] == "benchmark"
            and r["arm"] == arm
        ]
        assert len(rr) == 5, (batch, subject, arm)
        return sorted(rr, key=lambda r: int(r["cores"]))

    f, axs = plt.subplots(1, 2, figsize=(7.5, 3.5))
    p = [1, 2, 4, 8, 16]
    for batch, subject, label, color, marker in [
        (7, "2022-nbody", "N-body Luna · 4 096", BLUE, "o"),
        (10, "2022-nbody", "N-body Astra · 4 096", GREEN, "^"),
        (7, "2022-bucketsort", "Bucket sort Luna · 65 536", ORANGE, "s"),
    ]:
        rr = curve(batch, subject)
        axs[0].plot(
            p,
            [float(r["scaling_speedup"]) for r in rr],
            marker=marker,
            color=color,
            label=label,
        )
    axs[0].plot(p, p, color=GREY, lw=0.7, ls=":", label="Linéaire (repère)")
    for arm, label, color, marker in [
        ("reference", "GPT sans harnais", BLUE, "o"),
        ("mixed-harness", "GPT avec harnais", ORANGE, "s"),
    ]:
        rr = curve(8, "2022-nbody", arm)
        axs[1].errorbar(
            p,
            [float(r["chosen_seconds"]) * 1000 for r in rr],
            yerr=[float(r["chosen_sd"]) * 1000 for r in rr],
            color=color,
            marker=marker,
            capsize=3,
            label=label,
        )
    for ax in axs:
        ax.set_xscale("log", base=2)
        ax.set_xticks(p, p)
        ax.set_xlabel("Cœurs physiques accessibles")
        ax.legend(loc="best", fontsize=9.3)
    axs[0].set_ylabel("Accélération T₁ / Tₚ")
    axs[0].set_title("Lots 07 et 10 · accélération relative")
    axs[1].set_ylabel("Temps absolu (ms)")
    axs[1].set_title("Lot 08 · N-body, 4 096 particules")
    axs[1].set_yscale("log")
    f.tight_layout(w_pad=2)
    save(
        f,
        "coeurs",
        "observed_data",
        ["cpu-comparaisons.csv", "lots=7,8,10", "case_name=benchmark"],
    )
    ledger = read("couts-natifs.json")
    terra_calls = read("couts-terra.json")["native_calls"]
    gpt96_calls = read("couts-gpt96.json")["native_calls"]
    sol_calls = read("couts-sol.json")["native_calls"]
    source_only_calls = read("couts-source-only.json")["native_calls"]
    luna_xhigh_calls = read("couts-luna-xhigh.json")["native_calls"]
    astra_xhigh_calls = read("couts-astra-xhigh.json")["native_calls"]
    source_astra_calls = read("couts-source-only-astra.json")["native_calls"]
    terra_xhigh_calls = read("couts-terra-xhigh.json")["native_calls"]
    source_terra_calls = read("couts-source-only-terra.json")["native_calls"]
    astra_xhigh_campaign = "grille-r1/coverage-gpt-6-astra-xhigh"
    luna_xhigh_campaign = "grille-r1/coverage-gpt-6-luna-xhigh"
    terra_campaign = "grille-r1/coverage-gpt-5.6-terra-max"
    sol_campaign = "grille-r1/coverage-gpt-6.1-sol-max"
    calls = [c for c in ledger["native_calls"] if c["campaign"] not in {terra_campaign, sol_campaign, luna_xhigh_campaign, astra_xhigh_campaign, "comparaison-source-only/astra-max-750122", "grille-r1/coverage-gpt-5.6-terra-xhigh", "comparaison-source-only/terra-max-750831"} and not c["campaign"].startswith("reference96-r2")] + terra_calls + gpt96_calls + sol_calls + source_only_calls + luna_xhigh_calls + astra_xhigh_calls + source_astra_calls + terra_xhigh_calls + source_terra_calls
    assert len({(c["session_id"], c["nonce"]) for c in calls}) == len(calls)
    selections = [
        (
            "Count · 20 cellules",
            lambda c: c["campaign"].startswith("grille-r1/screen-"),
        ),
        (
            "Luna · 14 sujets",
            lambda c: c["campaign"] == "grille-r1/coverage-gpt-6-luna-max",
        ),
        (
            "Astra · 14 sujets",
            lambda c: c["campaign"] == "grille-r1/coverage-gpt-6-astra-max",
        ),
        ("Terra · 14 sujets", lambda c: c["campaign"] == terra_campaign),
        ("Sol · 14 sujets", lambda c: c["campaign"] == sol_campaign),
        ("GPT · 6 bras", lambda c: c["campaign"] == "harnais-r2"),
        ("GPT96 · 3 sujets", lambda c: c["campaign"] == "reference96-r2"),
        ("Source-only Luna · 15 sujets", lambda c: c["campaign"] == "comparaison-source-only/luna-max-749843"),
        ("R1 Luna xhigh · 14 sujets", lambda c: c["campaign"] == luna_xhigh_campaign),
        ("R1 Astra xhigh · 14 sujets", lambda c: c["campaign"] == astra_xhigh_campaign),
        ("Source-only Astra · 15 sujets", lambda c: c["campaign"] == "comparaison-source-only/astra-max-750122"),
        ("R1 Terra xhigh · 14 sujets", lambda c: c["campaign"] == "grille-r1/coverage-gpt-5.6-terra-xhigh"),
        ("Source-only Terra · 15 sujets", lambda c: c["campaign"] == "comparaison-source-only/terra-max-750831"),
    ]
    f, ax = plt.subplots(figsize=(7.5, 7.2))
    left = np.zeros(len(selections))
    for role, label, color, hatch in [
        ("enfant", "Enfants", BLUE, ""),
        ("intégration", "Intégrations G", ORANGE, "//"),
        ("mère", "Mère modèle", GREEN, ".."),
    ]:
        values = np.array(
            [
                sum(
                    c["exact_total"] or 0
                    for c in calls
                    if test(c) and c["kind"] == role
                )
                / 1e6
                for _, test in selections
            ]
        )
        ax.barh(
            range(len(selections)),
            values,
            left=left,
            color=color,
            hatch=hatch,
            label=label,
            height=0.56,
            edgecolor="white",
        )
        for i, v in enumerate(values):
            if v > 0.35:
                ax.text(
                    left[i] + v / 2,
                    i,
                    f"{v:.3f}".replace(".", ","),
                    ha="center",
                    va="center",
                    color="white",
                    fontsize=10,
                    bbox={"facecolor": color, "edgecolor": "none", "pad": 0.1},
                )
        left += values
    ax.set(
        yticks=range(len(selections)),
        yticklabels=[s[0] for s in selections],
        xlabel="Millions de jetons exacts connus (entrée + sortie)",
    )
    ax.invert_yaxis()
    ax.grid(axis="y", visible=False)
    ax.legend(ncol=3, loc="lower left", bbox_to_anchor=(0, 1.02), fontsize=9.5)
    assert round(sum(left) * 1e6) == sum(r["known_exact_tokens"] for r in rows if r["cohort"] != "deepseek")
    f.tight_layout()
    save(f, "couts", "observed_data", ["couts-natifs.json", "couts-terra.json", "couts-gpt96.json", "couts-sol.json", "couts-source-only.json", "couts-luna-xhigh.json", "couts-astra-xhigh.json", "couts-source-only-astra.json", "couts-terra-xhigh.json", "couts-source-only-terra.json", "closed receipts replace historical campaign entries; unknown consumption is not a zero"])
    for i, r in enumerate(regs, 1):
        cfg = r["config"]
        identity = cfg.get(cfg.get("backend", "codex"), {})
        model = identity.get("model") or "voir registre"
        forest(r, f"arbres/C{i:02d}", f"C{i:02d} · {cfg.get('problem')} · {model}")
    campaigns = read("cpu-campagnes.json")
    for i, c in enumerate(campaigns, 1):
        rr = [r for r in cpu if r["campaign_root"] == c["campaign_root"]]
        cases = sorted({(r["case_name"], r["input_sha256"]) for r in rr})
        f, ax = plt.subplots(figsize=(10.1, 3.2))
        colors = plt.get_cmap("tab10")
        for j, (name, digest) in enumerate(cases):
            rrr = sorted(
                [r for r in rr if r["input_sha256"] == digest],
                key=lambda r: int(r["cores"]),
            )
            assert len(rrr) == 5
            ax.errorbar(
                p,
                [float(r["chosen_seconds"]) * 1000 for r in rrr],
                yerr=[float(r["chosen_sd"]) * 1000 for r in rrr],
                color=colors(j % 10),
                marker=["o", "s", "^", "D", "v", "x", "+"][j % 7],
                ls=["-", "--", ":", "-."][j % 4],
                capsize=2,
                lw=1,
                label=name + " · " + digest[:6],
            )
        ax.set(
            xlabel="Cœurs physiques accessibles",
            ylabel="Temps absolu (ms)",
            title=f"Lot {c['batch']:02d} · {c['subject']} · {c['model']} {c.get('effort') or 'local'} {c.get('arm') or ''}",
        )
        ax.set_xscale("log", base=2)
        ax.set_xticks(p, p)
        ax.set_yscale("log")
        ax.legend(loc="center left", bbox_to_anchor=(1, 0.5), fontsize=7)
        f.tight_layout()
        save(
            f,
            f"cpu/P{i:02d}",
            "observed_data",
            ["cpu-comparaisons.csv", c["campaign_root"]],
        )
    (HERE / "figures-sources.json").write_text(
        json.dumps(MANIFEST, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
    )
    print(
        json.dumps(
            {
                "figures": len(MANIFEST),
                "trees": len(regs),
                "cpu_campaign_plots": len(campaigns),
            }
        )
    )


if __name__ == "__main__":
    main()

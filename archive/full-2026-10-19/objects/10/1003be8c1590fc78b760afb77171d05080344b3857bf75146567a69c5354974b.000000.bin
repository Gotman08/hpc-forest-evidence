"""Prepare new external adapter bytes only. Never invoke their operational mains."""
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
BASE = HERE.parents[2]
OLD = BASE / 'outputs/HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r2/adaptateurs-source-lane-r2/revision-r2-integration/revision-r5-so-clos-delta-local'
NEW = HERE / 'revision-r2-integration'
PREP = HERE.parent
SOURCE_DIR = PREP / 'revision-source-cli-r1'
OLD_SOURCE = '60db53fb69e014133a9c77ebaea9ae09ae7891c1433070a9af4eae30b0d05e6d'
SOURCE = 'eaff9217499fe268e4d151165a368a83bad1550d921955a9f9256026cfac2d48'
OLD_PLAN = 'b1b39b999cb89374a17191c5b3aef2b4eee255287a4cdbb80ed9c8b5d2ac1e1c'
PLAN = 'd08ac00bcfb75625a24971b2684d7479c4da7a98b339e4e10eae5b9ac525ef27'


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def ref(path):
    return {'path':str(path.resolve()),'sha256':sha(path)}


def main():
    manifest = json.loads((OLD / 'COMPONENTS.json').read_text())
    assert sha(OLD / 'COMPONENTS.json') == 'c03ed75936ae5b833cbe0acc8a875083bd2a06831853fb706a8d2907968c5203'
    assert all(sha(OLD / name) == checksum for name, checksum in manifest['code_pins'].items())
    NEW.mkdir(exist_ok=False)
    names = [name for name in manifest['code_pins'] if name.endswith('.py') or name.endswith('ABI.json')]
    for name in names:
        if name.startswith('test_') or name.startswith('observer/test_'):
            continue
        target = NEW / name
        target.parent.mkdir(parents=True, exist_ok=True)
        text = (OLD / name).read_text().replace(OLD_SOURCE,SOURCE).replace(OLD_PLAN,PLAN)
        text = text.replace('hpc-forest-mere-dynamique-r4b-lane-r2/project','hpc-forest-mere-dynamique-r4b-lane-r3/project')
        text = text.replace('HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r2','HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r3')
        text = text.replace('lancement-modeles-max-r2','lancement-modeles-max-r3')
        text = text.replace('== 105','== 110').replace('==105','==110').replace('105 sealed','110 sealed').replace('source105','source110').replace('source 105','source 110')
        text = text.replace('exactly105','exactly110').replace('the 105 isolated','the 110 isolated').replace('source_files") == 105','source_files") == 110')
        target.write_text(text,encoding='utf8',newline='\n')
    pins = json.loads((OLD / 'launcher/pins-source-plan.json').read_text())
    delivery = json.loads((SOURCE_DIR / 'LIVRAISON-SOURCE110-CANDIDATE-POUR-REVUE.json').read_text())
    pins.update(source_zip=delivery['source_zip'],plan=delivery['plan'],source_manifest=delivery['runtime_manifest'],
        source_project=str(BASE/'work/hpc-forest-mere-dynamique-r4b-lane-r3/project'),source_files=110,
        independent_source_review=ref(PREP/'revue-independante-source-r1/REVUE-INDEPENDANTE-SOURCE-R3-R4B110.json'),
        worker_cache_parent=str(PREP/'lancement-modeles-max-r3'),
        remote_shared_proposed='/scratch_p/nimarano/hpc-forest-dynamic-r4b-lane-r3-qualification-20261018-eaff9217499f',
        adapter_revision='r4b-source110-external-adapters-r1',allocated_qualification_received=False,
        qualification_reception=None,latest_native_generation_closure=None)
    for name in ('launcher/pins-source-plan.json','reader/pins-source-plan.json'):
        (NEW/name).write_text(json.dumps(pins,indent=2)+'\n',encoding='utf8')
    (NEW/'PROVENANCE-SOCLE-HISTORIQUE.json').write_text(json.dumps({
        'schema':'hpc-forest-r4b-source110-adapter-ancestry-v1','old_active_components':ref(OLD/'COMPONENTS.json'),
        'old_qualified_components':manifest['qualified_base_components'],
        'old_source105_or_Q_qualifies_source110':False,'source110_delivery':ref(SOURCE_DIR/'LIVRAISON-SOURCE110-CANDIDATE-POUR-REVUE.json'),
        'new_runtime_or_source_or_adapter_Q_received':False,'native_generation_admitted':False},indent=2)+'\n')
    print(json.dumps({'new_root':str(NEW),'copied_external_components':len(names),'runtime_executed':False}))


if __name__ == '__main__':
    main()

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

/*
 * Structure-of-Arrays layout: separate arrays for each coordinate and velocity.
 */
typedef struct {
    float *x, *y, *z;
    float *vx, *vy, *vz;
} Bodies;

/*
 * Compute the gravitational impact among all pairs of bodies in 
 * the system. Uses tiling on both i and j loops for cache locality.
 */
void body_force(Bodies p, float dt, int n) {
    const int IBLOCK = 8;
    const int JBLOCK = 128;

#pragma omp parallel for schedule(static)
    for (int ii = 0; ii < n; ii += IBLOCK) {
        int i_end = ii + IBLOCK;
        if (i_end > n) i_end = n;

        // Local accumulators for each body in the block
        float fx[IBLOCK], fy[IBLOCK], fz[IBLOCK];
        for (int ib = 0; ib < i_end - ii; ++ib) {
            fx[ib] = 0.0f;
            fy[ib] = 0.0f;
            fz[ib] = 0.0f;
        }

        for (int jj = 0; jj < n; jj += JBLOCK) {
            int j_end = jj + JBLOCK;
            if (j_end > n) j_end = n;

            // Process all pairs in this tile
            for (int ib = ii; ib < i_end; ++ib) {
                float pix = p.x[ib];
                float piy = p.y[ib];
                float piz = p.z[ib];
                int idx = ib - ii;
                float fxx = fx[idx], fyy = fy[idx], fzz = fz[idx];

                for (int jb = jj; jb < j_end; ++jb) {
                    float dx = p.x[jb] - pix;
                    float dy = p.y[jb] - piy;
                    float dz = p.z[jb] - piz;
                    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
                    float inv_dist = 1.0f / sqrt(sqrd_dist);
                    float inv_dist3 = inv_dist * inv_dist * inv_dist;

                    fxx += dx * inv_dist3;
                    fyy += dy * inv_dist3;
                    fzz += dz * inv_dist3;
                }

                fx[idx] = fxx;
                fy[idx] = fyy;
                fz[idx] = fzz;
            }
        }

        // Update velocities for this block
        for (int ib = ii; ib < i_end; ++ib) {
            int idx = ib - ii;
            p.vx[ib] += dt * fx[idx];
            p.vy[ib] += dt * fy[idx];
            p.vz[ib] += dt * fz[idx];
        }
    }
}

/*
 * Read a binary dataset with initialized bodies.
 */
Bodies read_dataset(int *nbodies) {
    int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
    if (b != 1) {
        fprintf(stderr,"\nError reading nbodie value\n");
        exit(EXIT_FAILURE);
    }

    Bodies bodies;
    int n = *nbodies;
    bodies.x = (float *)malloc(n * sizeof(float));
    bodies.y = (float *)malloc(n * sizeof(float));
    bodies.z = (float *)malloc(n * sizeof(float));
    bodies.vx = (float *)malloc(n * sizeof(float));
    bodies.vy = (float *)malloc(n * sizeof(float));
    bodies.vz = (float *)malloc(n * sizeof(float));

    // Read interleaved AoS data and convert to SoA
    float *tmp = (float *)malloc(6 * n * sizeof(float));
    b = fread(tmp, 6 * n * sizeof(float), 1, stdin);
    if (b != 1) {
        fprintf(stderr,"\nError reading input values\n");
        exit(EXIT_FAILURE);
    }

    for (int i = 0; i < n; ++i) {
        bodies.x[i] = tmp[6*i + 0];
        bodies.y[i] = tmp[6*i + 1];
        bodies.z[i] = tmp[6*i + 2];
        bodies.vx[i] = tmp[6*i + 3];
        bodies.vy[i] = tmp[6*i + 4];
        bodies.vz[i] = tmp[6*i + 5];
    }

    free(tmp);
    return bodies;
}

/*
 * Write simulation results into a binary dataset (AoS format).
 */
void write_dataset(const int nbodies, Bodies bodies) {
    float *tmp = (float *)malloc(6 * nbodies * sizeof(float));
    for (int i = 0; i < nbodies; ++i) {
        tmp[6*i + 0] = bodies.x[i];
        tmp[6*i + 1] = bodies.y[i];
        tmp[6*i + 2] = bodies.z[i];
        tmp[6*i + 3] = bodies.vx[i];
        tmp[6*i + 4] = bodies.vy[i];
        tmp[6*i + 5] = bodies.vz[i];
    }

    int b = fwrite(tmp, nbodies * sizeof(float) * 6, 1, stdout);
    if (b != 1) {
        fprintf(stderr,"\nError writing to output\n");
        exit(EXIT_FAILURE);
    }

    free(tmp);
}

int main(int argc,char **argv) {
    int nbodies;

    Bodies bodies = read_dataset(&nbodies);

    /*
     * At each simulation iteration, interbody forces are computed,
     * and bodies' positions are integrated.
     */
    for (int iter = 0; iter < N_ITER; iter++) {
        body_force(bodies, DT, nbodies);

        for (int i = 0; i < nbodies; i++) {
            bodies.x[i] += bodies.vx[i] * DT;
            bodies.y[i] += bodies.vy[i] * DT;
            bodies.z[i] += bodies.vz[i] * DT;
        }
    }

    write_dataset(nbodies, bodies);

    free(bodies.x);
    free(bodies.y);
    free(bodies.z);
    free(bodies.vx);
    free(bodies.vy);
    free(bodies.vz);

    exit(EXIT_SUCCESS);
}

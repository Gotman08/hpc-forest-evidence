"""Independent byte-only review; never import editorial modules."""
import ast
import hashlib
import json
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
REVISION = HERE.parent / "impl/revision-dates-r3"
OUT = HERE / "REVUE-DATES-R3.json"


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def ref(path):
    return {"path": str(path), "sha256": sha(path), "bytes": path.stat().st_size}


def main():
    assert not OUT.exists()
    delivery_path = REVISION / "LIVRAISON-IMPLEMENTATION-SOL-R3.json"
    assert sha(delivery_path) == "702b38265b86342c747c87a7f7adf62d2c0f7f5527140b1085a2ddf6e6642570"
    delivery = json.loads(delivery_path.read_text(encoding="utf-8-sig"))
    for key in ("previous_delivery", "previous_independent_review_GO", "verification", "manifest", "diff", "arithmetic_audit_unchanged"):
        value = delivery[key]
        assert sha(Path(value["path"])) == value["sha256"]
    verification = json.loads(Path(delivery["verification"]["path"]).read_text(encoding="utf-8-sig"))
    reviewed = []
    for row in verification["source_deltas"]:
        before, after = Path(row["before_copy"]["path"]), Path(row["source"]["path"])
        a, b = before.read_bytes(), after.read_bytes()
        assert sha(before) == row["before_copy"]["sha256"]
        assert sha(after) == row["source"]["sha256"]
        assert len(a) == len(b)
        positions = [i for i, (left, right) in enumerate(zip(a, b, strict=True)) if left != right]
        assert positions == [row["single_byte_changed_at_offset"]]
        index = positions[0]
        assert a[index] == ord("7") and b[index] == ord("8")
        assert a[max(0, index - 1):index + 14] == b"17 octobre 2026"
        assert b[max(0, index - 1):index + 14] == b"18 octobre 2026"
        ast.parse(a.decode("utf-8-sig"))
        ast.parse(b.decode("utf-8-sig"))
        reviewed.append({"before": ref(before), "after": ref(after), "single_byte_offset": index, "change": "17 octobre 2026 -> 18 octobre 2026"})
    assert {Path(r["after"]["path"]).name for r in reviewed} == {"assembler.py", "rendre.py"}
    for value in delivery["canonical_files"]:
        assert sha(Path(value["path"])) == value["sha256"]
    result = {
        "schema": "hpc-forest-professional-sol-date-revision-independent-review-v1",
        "verified": True,
        "observed_utc": datetime.now(UTC).isoformat(),
        "blocking_findings": [],
        "decision": "GO correction de deux dates et reconstruction documentaire par le parent",
        "implementation_delivery": ref(delivery_path),
        "diff": delivery["diff"],
        "reviewed_files": reviewed,
        "nine_canonical_hashes_verified": True,
        "arithmetic_audit_unchanged": delivery["arithmetic_audit_unchanged"],
        "previous_code_review": delivery["previous_independent_review_GO"],
        "checks_actually_run": ["SHA des références et neuf fichiers canoniques", "comparaison exhaustive des octets des deux copies avant/après", "AST sans import des deux versions"],
        "scientific_or_accounting_rerun": False,
        "build_render_control_executed": False,
        "actual_pixel_review": False,
        "first_build_preservation_independently_verified_here": False,
        "limitations": ["La préservation du premier build est possédée par le parent et n'est pas fabriquée dans cette revue de sources.", "Le contrôle et la revue pixels doivent porter sur les PDF reconstruits et leurs nouvelles empreintes."],
        "new_native_admission": False,
        "model_cli_remote_candidate_calls": 0,
    }
    OUT.write_text(json.dumps(result, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(ref(OUT)))


if __name__ == "__main__":
    main()

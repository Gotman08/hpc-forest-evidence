      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <omp.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Compute the gravitational impact among all pairs of bodies in \n * the system.\n * Uses Structure-of-Arrays layout for better cache locality and vectorization.\n * Outer loop unrolled by factor 2 (pairwise) so that each load of body j's\n * coordinates is reused for two consecutive i values, reducing memory traffic.\n */\nvoid body_force(float *restrict x, float *restrict y, float *restrict z,\n                float *restrict vx, float *restrict vy, float *restrict vz,\n                float dt, int n) {\n  #pragma omp parallel for schedule(static)\n  for (int i = 0; i < n - 1; i += 2) {\n    float fx_i = 0.0f, fy_i = 0.0f, fz_i = 0.0f;\n    float fx_ip1 = 0.0f, fy_ip1 = 0.0f, fz_ip1 = 0.0f;\n\n    const float xi   = x[i];\n    const float yi   = y[i];\n    const float zi   = z[i];\n    const float xi1  = x[i+1];\n    const float yi1  = y[i+1];\n    const float zi1  = z[i+1];\n\n    #pragma omp simd reduction(+:fx_i,fy_i,fz_i,fx_ip1,fy_ip1,fz_ip1) aligned(x,y,z:64)\n    for (int j = 0; j < n; ++j) {\n      // body i\n      float dx = x[j] - xi;\n      float dy = y[j] - yi;\n      float dz = z[j] - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1.0f / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx_i += dx * inv_dist3;\n      fy_i += dy * inv_dist3;\n      fz_i += dz * inv_dist3;\n\n      // body i+1 (reuses x[j], y[j], z[j] from the same load)\n      dx = x[j] - xi1;\n      dy = y[j] - yi1;\n      dz = z[j] - zi1;\n      sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      inv_dist = 1.0f / sqrt(sqrd_dist);\n      inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx_ip1 += dx * inv_dist3;\n      fy_ip1 += dy * inv_dist3;\n      fz_ip1 += dz * inv_dist3;\n    }\n\n    vx[i]   += dt*fx_i;   vy[i]   += dt*fy_i;   vz[i]   += dt*fz_i;\n    vx[i+1] += dt*fx_ip1; vy[i+1] += dt*fy_ip1; vz[i+1] += dt*fz_ip1;\n  }\n\n  // Handle odd number of bodies (last body processed sequentially)\n  if (n % 2 != 0) {\n    int i = n - 1;\n    float fx = 0.0f, fy = 0.0f, fz = 0.0f;\n    const float xi = x[i];\n    const float yi = y[i];\n    const float zi = z[i];\n\n    for (int j = 0; j < n; ++j) {\n      float dx = x[j] - xi;\n      float dy = y[j] - yi;\n      float dz = z[j] - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1.0f / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    vx[i] += dt*fx; vy[i] += dt*fy; vz[i] += dt*fz;\n  }\n}\n\n/*\n * Read a binary dataset with initialized bodies.\n */\nvoid read_dataset(float **restrict x, float **restrict y, float **restrict z,\n                  float **restrict vx, float **restrict vy, float **restrict vz,\n                  int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  const int n = *nbodies;\n  // Allocate aligned memory for SoA arrays\n  size_t alignment = 64;\n  if (posix_memalign((void**)x, alignment, n * sizeof(float)) != 0) {\n    fprintf(stderr,\"\\nError allocating x array\\n\");\n    exit(EXIT_FAILURE);\n  }\n  if (posix_memalign((void**)y, alignment, n * sizeof(float)) != 0) {\n    fprintf(stderr,\"\\nError allocating y array\\n\");\n    exit(EXIT_FAILURE);\n  }\n  if (posix_memalign((void**)z, alignment, n * sizeof(float)) != 0) {\n    fprintf(stderr,\"\\nError allocating z array\\n\");\n    exit(EXIT_FAILURE);\n  }\n  if (posix_memalign((void**)vx, alignment, n * sizeof(float)) != 0) {\n    fprintf(stderr,\"\\nError allocating vx array\\n\");\n    exit(EXIT_FAILURE);\n  }\n  if (posix_memalign((void**)vy, alignment, n * sizeof(float)) != 0) {\n    fprintf(stderr,\"\\nError allocating vy array\\n\");\n    exit(EXIT_FAILURE);\n  }\n  if (posix_memalign((void**)vz, alignment, n * sizeof(float)) != 0) {\n    fprintf(stderr,\"\\nError allocating vz array\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  // Read interleaved data into temporary buffer and scatter to SoA\n  float *tmp = (float*)malloc(n * 6 * sizeof(float));\n  if (!tmp) {\n    fprintf(stderr,\"\\nError allocating tmp buffer\\n\");\n    exit(EXIT_FAILURE);\n  }\n  b = fread(tmp, n * 6 * sizeof(float), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    free(tmp);\n    exit(EXIT_FAILURE);\n  }\n\n  for (int i = 0; i < n; ++i) {\n    (*x)[i] = tmp[i*6 + 0];\n    (*y)[i] = tmp[i*6 + 1];\n    (*z)[i] = tmp[i*6 + 2];\n    (*vx)[i] = tmp[i*6 + 3];\n    (*vy)[i] = tmp[i*6 + 4];\n    (*vz)[i] = tmp[i*6 + 5];\n  }\n\n  free(tmp);\n}\n\n/*\n * Write simulation results into a binary dataset (AoS format).\n */\nvoid write_dataset(const int nbodies,\n                   const float *restrict x, const float *restrict y,\n                   const float *restrict z, const float *restrict vx,\n                   const float *restrict vy, const float *restrict vz) {\n  // Convert SoA back to AoS for output\n  float *tmp = (float*)malloc(nbodies * 6 * sizeof(float));\n  if (!tmp) {\n    fprintf(stderr,\"\\nError allocating temporary buffer\\n\");\n    exit(EXIT_FAILURE);\n  }\n  for (int i = 0; i < nbodies; ++i) {\n    tmp[i*6 + 0] = x[i];\n    tmp[i*6 + 1] = y[i];\n    tmp[i*6 + 2] = z[i];\n    tmp[i*6 + 3] = vx[i];\n    tmp[i*6 + 4] = vy[i];\n    tmp[i*6 + 5] = vz[i];\n  }\n\n  int b = fwrite(tmp, nbodies * 6 * sizeof(float), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    free(tmp);\n    exit(EXIT_FAILURE);\n  }\n\n  free(tmp);\n}\n\nint main(int argc, char **argv) {\n  int nbodies;\n  float *x = NULL, *y = NULL, *z = NULL;\n  float *vx = NULL, *vy = NULL, *vz = NULL;\n\n  read_dataset(&x, &y, &z, &vx, &vy, &vz, &nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    body_force(x, y, z, vx, vy, vz, DT, nbodies);\n\n    #pragma omp parallel for schedule(static)\n    for (int i = 0; i < nbodies; ++i) {\n      x[i] += vx[i] * DT;\n      y[i] += vy[i] * DT;\n      z[i] += vz[i] * DT;\n    }\n  }\n\n  write_dataset(nbodies, x, y, z, vx, vy, vz);\n\n  free(x); free(y); free(z);\n  free(vx); free(vy); free(vz);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Integrating SoA layout with 64-byte aligned allocation, restrict qualifiers, outer loop unrolling by factor 2 (pairwise j-coordinate reuse), SIMD reduction pragma on the inner force loop for both i and i+1 accumulators, OpenMP parallel for schedule(static) on both force computation and position update loops, and remainder handling for odd body count will combine memory locality, vectorization, thread-level parallelism, and reduced scheduling overhead to achieve further speedup beyond any individual transformation.",
  "notes": "This integration combines the best-performing features from all three source experiments: A's outer loop unrolling with j-coordinate reuse and remainder handling; B's SoA layout, aligned allocation (64-byte), restrict qualifiers, hoisted reads, SIMD reduction pragma, and static scheduling on force/position loops; C's inclusion of <omp.h>. The single parallel region approach from C was not used because earlier attempts with it did not outperform separate parallel for directives. Alignment is set to 64 bytes (from A) for better cache line utilization.",

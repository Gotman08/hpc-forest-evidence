{
  "src/main.cpp": "#include <bits/stdc++.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\nint A[1000][1000];\n\ntypedef long long ll;\n\nclass PrefixFrequencyWorkspace {\n  vector<int> keys_;\n  vector<uint32_t> counts_;\n  size_t mask_;\n\n  static uint32_t hash_key(int key) {\n    uint32_t x = static_cast<uint32_t>(key);\n    x ^= x >> 16;\n    x *= UINT32_C(0x7feb352d);\n    x ^= x >> 15;\n    x *= UINT32_C(0x846ca68b);\n    x ^= x >> 16;\n    return x;\n  }\n\n  size_t find_slot(int key) const {\n    size_t slot = static_cast<size_t>(hash_key(key)) & mask_;\n    while (counts_[slot] != 0 && keys_[slot] != key)\n      slot = (slot + 1) & mask_;\n    return slot;\n  }\n\npublic:\n  explicit PrefixFrequencyWorkspace(size_t max_prefixes) {\n    size_t capacity = 1;\n    while (capacity < 2 * max_prefixes)\n      capacity <<= 1;\n    keys_.resize(capacity);\n    counts_.resize(capacity);\n    mask_ = capacity - 1;\n  }\n\n  void reset() {\n    fill(counts_.begin(), counts_.end(), uint32_t(0));\n    increment(0);\n  }\n\n  uint32_t count(int key) const {\n    return counts_[find_slot(key)];\n  }\n\n  void increment(int key) {\n    const size_t slot = find_slot(key);\n    if (counts_[slot] == 0)\n      keys_[slot] = key;\n    ++counts_[slot];\n  }\n};\n\nstatic ll count_start_boundary(int first, int d, int length, int k,\n                               const int* prefix,\n                               PrefixFrequencyWorkspace& h) {\n  ll ans = 0;\n  const int* lower = prefix + static_cast<size_t>(first) * length;\n  for (int end = first + 1; end <= d; ++end) {\n    const int* upper = prefix + static_cast<size_t>(end) * length;\n    h.reset();\n    int s = 0;\n    for (int x = 0; x < length; ++x) {\n      s += upper[x] - lower[x];\n      // Query before insertion, including when k is zero.\n      ans += h.count(s - k);\n      h.increment(s);\n    }\n  }\n  return ans;\n}\n\nstatic ll count_paired_starts(int task, int d, int length, int k,\n                             const int* prefix,\n                             PrefixFrequencyWorkspace& h) {\n  const int first = task;\n  const int second = d - 1 - task;\n  ll ans = count_start_boundary(first, d, length, k, prefix, h);\n  if (first != second)\n    ans += count_start_boundary(second, d, length, k, prefix, h);\n  return ans;\n}\n\nll solve(int m, int n, int k) {\n  const int d = min(m, n);\n  const int length = max(m, n);\n  vector<int> prefix(static_cast<size_t>(d + 1) * length, 0);\n\n  if (n <= m) {\n    for (int b = 1; b <= d; ++b) {\n      int* current = prefix.data() + static_cast<size_t>(b) * length;\n      const int* previous = current - length;\n      for (int x = 0; x < length; ++x)\n        current[x] = previous[x] + A[x][b - 1];\n    }\n  } else {\n    for (int b = 1; b <= d; ++b) {\n      int* current = prefix.data() + static_cast<size_t>(b) * length;\n      const int* previous = current - length;\n      for (int x = 0; x < length; ++x)\n        current[x] = previous[x] + A[b - 1][x];\n    }\n  }\n\n  // Opposite starts contain d + 1 bands together, except the odd center.\n  const int tasks = (d + 1) / 2;\n  const ll row_visits = static_cast<ll>(length) * d * (d + 1) / 2;\n  const ll minimum_visits_per_worker = 32768;\n  int workers = 1;\n  if (tasks >= 2 && row_visits >= 2 * minimum_visits_per_worker)\n    workers = 2;\n  if (tasks >= 4 && row_visits >= 4 * minimum_visits_per_worker)\n    workers = 4;\n#ifdef _OPENMP\n  workers = min(workers, omp_get_max_threads());\n#endif\n\n  ll ans = 0;\n  if (workers == 1) {\n    PrefixFrequencyWorkspace h(static_cast<size_t>(length) + 1);\n    for (int task = 0; task < tasks; ++task)\n      ans += count_paired_starts(task, d, length, k, prefix.data(), h);\n    return ans;\n  }\n\n#ifdef _OPENMP\n#pragma omp parallel num_threads(workers) reduction(+:ans)\n  {\n    PrefixFrequencyWorkspace h(static_cast<size_t>(length) + 1);\n#pragma omp for schedule(dynamic, 1) nowait\n    for (int task = 0; task < tasks; ++task)\n      ans += count_paired_starts(task, d, length, k, prefix.data(), h);\n  }\n#else\n  atomic<int> next_task{0};\n  array<ll, 4> subtotals{};\n  auto run_worker = [&](int worker) {\n    PrefixFrequencyWorkspace h(static_cast<size_t>(length) + 1);\n    ll subtotal = 0;\n    for (;;) {\n      const int task = next_task.fetch_add(1, memory_order_relaxed);\n      if (task >= tasks)\n        break;\n      subtotal += count_paired_starts(task, d, length, k, prefix.data(), h);\n    }\n    subtotals[worker] = subtotal;\n  };\n\n  array<thread, 3> threads;\n  for (int worker = 1; worker < workers; ++worker)\n    threads[worker - 1] = thread(run_worker, worker);\n  run_worker(0);\n  for (int worker = 1; worker < workers; ++worker)\n    threads[worker - 1].join();\n  for (int worker = 0; worker < workers; ++worker)\n    ans += subtotals[worker];\n#endif\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n"
}

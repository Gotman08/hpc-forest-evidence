        "content": "#include <algorithm>\n#include <cstddef>\n#include <ios>\n#include <iostream>\n#include <iterator>\n#include <string>\n\nnamespace\n{\nconst std::size_t output_block_size = 64 * 1024 ;\n\nbool is_whitespace (char c)\n{\n    return (c == ' ' )\n        || (c == '\\n')\n        || (c == '\\r')\n        || (c == '\\t')\n        || (c == '\\f')\n        || (c == '\\v') ;\n}\n\nstd::string read_text_from_stdin ()\n{\n    std::istreambuf_iterator<char> begin (std::cin) ;\n    std::istreambuf_iterator<char> end ;\n    std::string text (begin, end) ;\n    text.erase\n        ( std::remove_if (text.begin (), text.end (), is_whitespace)\n        , text.end () ) ;\n    return text ;\n}\n\ninline bool next_permutation_in_line (std::string& line, std::size_t count)\n{\n    if (count < 2) {\n        return false ;\n    }\n\n    char* const first = &line[2] ;\n    char* const last = &line[line.size () - 4] ;\n    char* suffix = last ;\n\n    while ((suffix != first) && (suffix[-2] >= *suffix)) {\n        suffix -= 2 ;\n    }\n    if (suffix == first) {\n        return false ;\n    }\n\n    char* const pivot = suffix - 2 ;\n    char* successor = last ;\n    while (*successor <= *pivot) {\n        successor -= 2 ;\n    }\n\n    char value = *pivot ;\n    *pivot = *successor ;\n    *successor = value ;\n\n    char* left = suffix ;\n    char* right = last ;\n    while (left < right) {\n        value = *left ;\n        *left = *right ;\n        *right = value ;\n        left += 2 ;\n        right -= 2 ;\n    }\n    return true ;\n}\n\nvoid write_bytes (char const* data, std::size_t size)\n{\n    while (size != 0) {\n        const std::size_t chunk =\n            (size < output_block_size) ? size : output_block_size ;\n        std::cout.write\n            ( data\n            , static_cast<std::streamsize> (chunk) ) ;\n        data += chunk ;\n        size -= chunk ;\n    }\n}\n\nvoid write_pending (std::string& pending)\n{\n    if (!pending.empty ()) {\n        write_bytes (pending.data (), pending.size ()) ;\n        pending.clear () ;\n    }\n}\n\nvoid emit_permutations (std::string& text)\n{\n    if (text.empty ()) {\n        return ;\n    }\n\n    std::sort (text.begin (), text.end ()) ;\n\n    const std::size_t count = text.size () ;\n    std::string line ;\n    line.reserve (count) ;\n    line.push_back ('[') ;\n    line.push_back (' ') ;\n    for (std::size_t index = 0 ; index < count ; ++index) {\n        line.push_back (text[index]) ;\n        line.push_back (' ') ;\n    }\n    line.push_back (']') ;\n    line.push_back ('\\n') ;\n\n    if (line.size () >= output_block_size) {\n        do {\n            write_bytes (line.data (), line.size ()) ;\n        } while (next_permutation_in_line (line, count)) ;\n        return ;\n    }\n\n    std::string pending ;\n    pending.reserve (output_block_size) ;\n    do {\n        if (pending.size () > output_block_size - line.size ()) {\n            write_pending (pending) ;\n        }\n        pending.append (line) ;\n    } while (next_permutation_in_line (line, count)) ;\n    write_pending (pending) ;\n}\n}\n\nint main ()\n{\n    std::ios_base::sync_with_stdio (false) ;\n    std::cin.tie (0) ;\n\n    std::string text = read_text_from_stdin () ;\n    emit_permutations (text) ;\n    std::cout.flush () ;\n    return 0 ;\n}\n",
        "path": "src/permutations.cc"
      }

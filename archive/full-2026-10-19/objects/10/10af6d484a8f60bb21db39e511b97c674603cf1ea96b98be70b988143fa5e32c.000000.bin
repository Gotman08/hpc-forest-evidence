def need(ok, reason):
    if not ok:
        raise ValueError(reason)


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def ticks(value):
    """UTC 100ns keys retain all seven creation digits; no rounding/tolerance."""
    need(isinstance(value, str), 'Explicit UTC timestamp required')
    match = re.fullmatch(r'(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.(\d{1,7}))?Z', value)
    need(match is not None, 'UTC Z with at most seven fractional digits required')
    point = datetime.fromisoformat(match[1]).replace(tzinfo=UTC)
    return calendar.timegm(point.utctimetuple()) * 10_000_000 + int((match[2] or '').ljust(7, '0'))


def not_inert(value):
    need(isinstance(value, dict) and isinstance(value.get('schema'), str), 'Typed actual metadata required')
    need('INERT' not in value['schema'].upper() and 'FIXTURE' not in value['schema'].upper() and 'NON-ADMIS' not in value['schema'].upper()
         and value.get('fixture_only') is not True and value.get('prepared_only') is not True,
         'INERT/prepared proposals cannot become actual startup receipts')


def census(value, now_ticks):
    not_inert(value)
    need(set(value) == {'schema','observed_at','captured_at_utc','complete_census','strict_utf8_decoding','rows_count','rows'}
         and value['schema'] == 'hpc-forest-dynamic-r4b-full-cim-v1'
         and value['complete_census'] is True and value['strict_utf8_decoding'] is True,
         'Actual unfiltered complete strict-UTF8 census required')
    captured = ticks(value['captured_at_utc'])
    observed = value['observed_at']
    need(type(observed) in (float,int) and math.isfinite(observed)
         and 0 <= now_ticks-captured <= 120 * 10_000_000
         and abs(observed - captured / 10_000_000) <= 1,
         'Fresh120 coherent received census required; creation identities remain exact')
    rows = value['rows']
    need(isinstance(rows, list) and rows and type(value['rows_count']) is int and value['rows_count'] == len(rows),
         'Nonempty complete census count required')
    ids = set()
    for row in rows:
        need(isinstance(row, dict) and set(row) == set(FIELDS)
             and all(type(row[k]) is int and row[k] >= 0 for k in FIELDS[:2])
             and row['ProcessId'] not in ids and all(row[k] is None or isinstance(row[k],str) for k in FIELDS[2:]),
             'Exact five-field unique census rows required')
        ids.add(row['ProcessId'])
        if row['CreationDate'] is not None:
            need(ticks(row['CreationDate']) <= captured, 'Creation after capture refused')
    return rows, captured


def observer_api(source):
    need(sha(source) == OBSERVER_SHA, 'Exact qualified R8 observer pure definitions required')
    selected = [n for n in ast.parse(source).body if isinstance(n,ast.FunctionDef) and n.name in API_NAMES]
    need({n.name for n in selected} == API_NAMES, 'Closed qualified pure definition set required')
    api = {'require':need,'Path':Path,'datetime':datetime,'UTC':UTC,'re':re,'FIELDS':FIELDS}
    exec(compile(ast.Module(body=selected,type_ignores=[]), '<qualified-R8-identity-and-Windows-argv-only>', 'exec'), api)
    return api


def context_templates(metadata, api):
    need(metadata.get('schema') == 'hpc-forest-r7-observed-passive-context-eight-identities-v1'
         and len(metadata.get('context',[])) == 8, 'Pinned historical context templates only')
    templates = {}
    for record in metadata['context']:
        role = record['role_scope']
        row = record['full_identity']
        if role == 'explicit observer pair':
            continue
        normalized = ('conhost' if role == 'conhost child metadata' else
                      'mcp' if role == 'MCP Python chain metadata' else
                      'census' if role == 'ephemeral observer census PowerShell child metadata' else None)
        need(normalized is not None, 'Unqualified historical context kind')
        templates[(row['ExecutablePath'].casefold(), tuple(api['windows_argv'](row['CommandLine'])))] = normalized
    need(set(templates.values()) == {'conhost','mcp','census'}, 'Exact three observed context command forms required')
    return templates


def validate_startup(documents, refs, api, templates, actual_exe_hashes, *, now_ticks):
    """Pure metadata validator. Tests may supply fixtures, production I/O stays in main."""
    need(actual_exe_hashes == EXE_PINS, 'Both actual held executable hashes must equal launcher819c and realPython5ef')
    start, intent, policy, transition = (documents[n] for n in ('start_observed','start_intent','policy','transition'))
    for value in documents.values():
        if isinstance(value, dict) and 'schema' in value:
            not_inert(value)
    need(start.get('schema') == 'hpc-forest-r8-owned-passive-start-observed-v1'
         and intent.get('schema') == 'hpc-forest-r8-owned-passive-start-intent-v1'
         and start.get('start_intent') == refs['start_intent'] and intent.get('one_start_only') is True
         and intent.get('unknown_outcome_forbids_retry') is True and intent.get('observer_sha256') == OBSERVER_SHA
         and intent.get('model_generation_admitted') is False and start.get('native_generation_admitted') is False
         and intent.get('external_preparation_review') == refs['external_preparation_review']
         and start.get('observed_full_pair_independently_verified') is False
         and type(start.get('source_or_native_workers_started')) is int and start['source_or_native_workers_started'] == 0,
         'Actual one-shot passive startup and preserved raw false admission flag required')
    before, before_tick = census(documents['startup_census_before'], now_ticks)
    latest, latest_tick = census(documents['immediate_before'], now_ticks)
    after, after_tick = census(documents['startup_census_after'], now_ticks)
    expected = [str(LAUNCHER),'-I','-B','-u',str(CHAIN/'observer/observer-mixte.py'),
                '--policy',refs['policy']['path'],'--routes',intent['routes']['path'],
                '--transition',refs['transition']['path'],'--run']
    need(intent.get('argv') == expected and expected.count('--run') == 1
         and intent.get('policy') == refs['policy'] and intent.get('transition') == refs['transition']
         and intent.get('initial_full_cim') == refs['startup_census_before']
         and intent.get('full_cim') == refs['immediate_before']
         and intent.get('old_observer_current_absence') == refs['prior_observer_current_absence'],
         'Exact immutable R8 argv/policy/transition/census references required')
    launcher_pid = start.get('launcher_pid')
    need(type(launcher_pid) is int and launcher_pid > 0 and start.get('launcher_has_exited') is False,
         'Actual living launcher observation required at received startup')
    launchers = [r for r in after if r['ProcessId'] == launcher_pid]
    need(len(launchers) == 1, 'Actual launcher full row missing or ambiguous')
    launcher = launchers[0]
    api['identity'](launcher)
    need(launcher['ExecutablePath'] == str(LAUNCHER) and api['windows_argv'](launcher['CommandLine']) == expected,
         'Launcher executable or exact argv differs')
    mains = [r for r in after if r['ParentProcessId'] == launcher_pid
             and r['ExecutablePath'] == str(REAL) and r['CommandLine'] == launcher['CommandLine']]
    need(len(mains) == 1, 'Exactly one real Python main child required; no PID/name guess')
    main = mains[0]
    pair = [launcher,main]
    api['verify_pair'](pair, after)
    raw_rows = start.get('five_fields')
    need(isinstance(raw_rows,list) and len({r['ProcessId'] for r in raw_rows}) == len(raw_rows)
         and all(set(r) == set(FIELDS) and any(api['same_identity'](r,a) for a in after) for r in raw_rows)
         and all(any(api['same_identity'](r,a) for a in raw_rows) for r in pair),
         'Raw tool rows and full census pair/context differ')
    parent_before = [r for r in latest if r['ProcessId'] == launcher['ParentProcessId']]
    parent_after = [r for r in after if r['ProcessId'] == launcher['ParentProcessId']]
    need(len(parent_before) == len(parent_after) == 1 and api['identity'](parent_before[0]) == api['identity'](parent_after[0]),
         'Actual launcher parent full identity missing/reused between censuses')
    created = ticks(intent['created_at_utc'])
    births = [ticks(r['CreationDate']) for r in pair]
    observed = ticks(start['observed_at_utc'])
    need(before_tick <= latest_tick <= created <= births[0] <= births[1] <= after_tick <= observed <= now_ticks
         and all(0 <= birth-before_tick <= 120*10_000_000 and 0 <= birth-latest_tick <= 120*10_000_000 for birth in births),
         'Creation/intent/complete census/start chronology or TTL differs')
    owned = {r['ProcessId']: {'role':role,'identity':r,'parent_identity':None} for r,role in zip(pair,('observer-launcher','observer-main'))}
    pending = True
    while pending:
        pending = False
        for row in after:
            if row['ProcessId'] in owned or row['ParentProcessId'] not in owned:
                continue
            api['identity'](row)
            parent = owned[row['ParentProcessId']]
            role = templates.get((row['ExecutablePath'].casefold(), tuple(api['windows_argv'](row['CommandLine']))))
            need(role is not None, 'Unknown descendant/client context is preserved; receipt refused')
            if role == 'mcp':
                need((row['ExecutablePath'] != str(REAL) and parent['role'] == 'observer-main')
                     or (row['ExecutablePath'] == str(REAL) and parent['role'] == 'mcp-launcher'),
                     'MCP argv has unproved launcher/main lineage')
                role = 'mcp-main' if row['ExecutablePath'] == str(REAL) else 'mcp-launcher'
            elif role == 'census':
                need(parent['role'] == 'observer-main', 'Census client must descend from exact observer main')
            else:
                need(parent['role'] in {'observer-launcher','mcp-launcher','census'},
                     'Console host has no qualified launcher/census parent lineage')
            need(created <= ticks(row['CreationDate']) <= after_tick
                 and ticks(parent['identity']['CreationDate']) <= ticks(row['CreationDate']),
                 'Descendant/client creation outside intent/parent chronology')
            owned[row['ProcessId']] = {'role':role,'identity':row,'parent_identity':parent['identity']}
            pending = True
    need(all(not any(r['ProcessId'] == old['ProcessId'] for old in before+latest) for r in [x['identity'] for x in owned.values()]),
         'Pair/context PID already present or reused before immutable intent')
    roles=[item['role'] for item in owned.values()]
    need(roles.count('mcp-launcher')<=1 and roles.count('mcp-main')<=1 and roles.count('census')<=1
         and roles.count('conhost')<=3,'Duplicate clients or extra console/census context is unqualified')
    need({r['ProcessId'] for r in raw_rows} <= set(owned), 'Raw start includes unattributed context')
    so, obs3, prior = (documents[n] for n in ('source_only_absence','observer3_absence','prior_observer_current_absence'))
    for proof,subject in ((so,'source-only'),(obs3,'observer3')):
        need(proof.get('schema')=='hpc-forest-passive-owned-pair-absence-v1'
             and proof.get('verified') is True and proof.get('subject') == subject and proof.get('no_stop_or_replay') is True
             and proof.get('complete_census_verified') is True and proof.get('current_freshness_verified') is True
             and proof.get('row_level_absence_only_if_census_provenance_unknown') is False
             and proof.get('native_generation_admitted') is False
             and proof.get('fresh_full_cim') == refs['startup_census_before'], 'Actual typed SO/OBS3 absence at same initial census required')
        previous = proof.get('owned_full_identities')
        need(isinstance(previous,list) and len(previous) == 2
             and not any(any(api['same_identity'](r,old) for r in before+latest) for old in previous),
             'Original prior pair still present or unknown')
    need(transition.get('schema') == 'hpc-forest-r4b-obs4-transition-v1' and transition.get('verified') is True
         and transition.get('initial_fresh_gate_verified') is True
         and transition.get('previous_reader_absence') == refs['observer3_absence']
         and policy.get('source_only_absence') == refs['source_only_absence']
         and policy.get('source_only_state') == 'received_absent'
         and policy.get('verified') is True and policy.get('scientific_admission') is False,
         'Actual original transition/policy provenance differs')
    need(policy.get('schema')=='hpc-forest-r4b-obs4-nine-session-policy-v1' and policy.get('scope_id')==SCOPE
         and policy.get('source_zip',{}).get('sha256')==SOURCE and policy.get('plan',{}).get('sha256')==PLAN
         and policy.get('sessions')==SESSIONS and policy.get('effort')=='max' and policy.get('maximum_native_workers_total')==4
         and policy.get('integration_review')=={'path':str(REVIEW),'sha256':REVIEW_SHA}
         and policy.get('observer_review')==policy['integration_review']
         and all(policy.get(k) is False for k in ('submit_allowed','generate_allowed','receive_allowed','stop_allowed','pilots_admitted'))
         and {api['identity'](r) for r in transition.get('previous_reader_identities',[])}=={api['identity'](r) for r in obs3['owned_full_identities']}
         and {api['identity'](r) for r in policy.get('source_only_full_identities',[])}=={api['identity'](r) for r in so['owned_full_identities']},
         'Exact R8 policy/cell and historical release-pair bindings required')
    need(prior.get('schema') == 'hpc-forest-r8-prior-OBS4-closed-current-absence-v1'
         and prior.get('verified_metadata_only') is True and prior.get('fresh_full_cim') == refs['immediate_before']
         and prior.get('all_seven_original_identities_absent') is True and prior.get('all_eight_R7_original_identities_absent') is True
         and prior.get('R7_predecessors',{}).get('current_context_absence_verified') is True
         and prior.get('no_unknown_reused_or_ambiguous_R7_descendants') is True
         and type(prior.get('active_native_workers')) is int and prior['active_native_workers'] == 0,
         'Actual combined r5/R7 absence and pre-start zero-native proof required')
    routes = documents['routes_initial_copy']
    need(routes.get('schema') == 'hpc-forest-r4b-obs4-nine-session-routes-v1'
         and routes.get('scope_id') == SCOPE and routes.get('source_zip_sha256') == SOURCE and routes.get('plan_sha256') == PLAN
         and isinstance(routes.get('routes'),list) and len(routes['routes']) == 9
         and {(r['model'],r['phase'],r['session_id']) for r in routes['routes']}
             == {(model,phase,session) for model,phases in SESSIONS.items() for phase,session in phases.items()}
         and all(set(r)=={'model','phase','effort','session_id','stage','job_id'} and r.get('effort')=='max'
                 and r.get('stage') == 'absent' and r.get('job_id') is None for r in routes['routes']),
         'True cold nine absent initial routes required')
    need(refs['routes_initial_copy']['sha256'] == intent['routes']['sha256'], 'Immutable initial routes hash differs from actual ROOT cold copy')
    state = documents['cold_state']
    history = {r['model']+':'+r['phase']:{'stage':'absent',
        'cell':{'scope_id':SCOPE,'source_zip_sha256':SOURCE,'plan_sha256':PLAN,'model':r['model'],'effort':'max',
                'phase':r['phase'],'session_id':r['session_id'],'job_id':None,
                'remote_root':'/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-'+r['session_id']},
        'allocation_binding':{},'worker_binding':{},'terminal_binding':{}} for r in routes['routes']}
    need(state.get('schema') == 'hpc-forest-r4b-passive-state-v1' and state.get('scientific_admission') is False
         and state.get('transition_verified') is True and state.get('passive_only') is True
         and state.get('policy_sha256') == refs['policy']['sha256'] and state.get('stage')=='observing'
         and state.get('routes_history')==history
         and isinstance(state.get('observer_full_identities'),list) and len(state['observer_full_identities'])==2
         and {api['identity'](r) for r in state['observer_full_identities']}=={api['identity'](r) for r in pair}
         and isinstance(state.get('observations'),dict) and set(state['observations'])=={'751592','752306'}
         and all(v.get('polled') is False for v in state['observations'].values())
         and type(state.get('active_native_workers')) is int and state['active_native_workers'] == 0
         and type(state.get('updated_at')) in (float,int) and math.isfinite(state['updated_at'])
         and 0 <= now_ticks/10_000_000-state['updated_at'] <= 90,
         'Actual fresh90 passive-only cold state required; no global or future model claim')
    return pair, list(owned.values())


def cold_copy_name(path):
    # Windows aliases are closed before any metadata or content access.
    path = Path(path)
    need(path.name.rstrip(' .').casefold() not in
         {'observer-state.json','stdout.log','stderr.log','observer.lock','worker.lock','routes-obs4.json'},
         'Cold copy cannot use any live state/log/lock/routes basename')
    return path


def cold_copy_specs(documents, refs):
    """Validate receipt bindings before any of the four copy payloads is read."""
    specs = []
    for label, source_path, copy_ref in (
            ('routes', documents['start_intent']['routes']['path'], refs['routes_initial_copy']),
            ('state', str(CHAIN/'observer/observer-state.json'), refs['cold_state'])):
        receipt = documents['routes_initial_copy_receipt' if label == 'routes' else 'cold_state_receipt']
        need(receipt.get('schema') == 'hpc-forest-r8-ROOT-byte-exact-cold-copy-v1'
             and receipt.get('source_before') == receipt.get('source_after')
             and receipt.get('source_before',{}).get('path') == source_path
             and receipt.get('source_before',{}).get('sha256') == copy_ref['sha256']
             and receipt.get('copy') == copy_ref and receipt.get('two_source_reads_equal_copy') is True
             and receipt.get('live_source_read_by_ROOT_only') is True,
             'Stable ROOT state/routes copy metadata required before copy bytes')
        specs.append({'label':label, 'source':Path(source_path), 'copy':cold_copy_name(copy_ref['path'])})
    logs = documents['cold_logs_receipt']
    need(logs.get('schema') == 'hpc-forest-r8-ROOT-two-cold-log-copies-v1'
         and isinstance(logs.get('copies'),list) and len(logs['copies']) == 2,
         'Actual two cold log copy receipts required before bytes')
    for item, name in zip(logs['copies'], ('stdout.log','stderr.log')):
        source_path = documents['start_observed']['stdout' if name == 'stdout.log' else 'stderr']
        need(item.get('source_before') == item.get('source_after')
             and item.get('source_before',{}).get('path') == source_path
             and Path(source_path).name == name
             and item['source_before'].get('sha256') == item.get('copy',{}).get('sha256')
             and item.get('two_source_reads_equal_copy') is True,
             'Stable ROOT log copy metadata required before copy bytes')
        specs.append({'label':name, 'source':Path(source_path), 'copy':cold_copy_name(item['copy']['path'])})
    need(all(spec['source'] != spec['copy'] for spec in specs),
         'Live source and cold copy must be canonically distinct before bytes')
    return specs


class HeldDistinctColdCopies:
    """Transient source/parent snapshots; retain only four qualified copy objects.

    Checkpoints detect observed mutations. They do not prove continuity/no-ABA
    or guarantee rename of an ancestor containing the intentionally locked copies.
    """
    def __init__(self, specs, ordinary_path, *, payload_api=None, source_boundary=BASE, copy_boundary=OBS):
        self.specs, self.ordinary_path = specs, ordinary_path
        self.source_boundary, self.copy_boundary = source_boundary, copy_boundary
        self.payload_api = payload_api
        self.before, self.parent_before, self.events = [], {}, []
        self.metadata_copy_handles, self.copy_read_handles = [], []
        self.transient_handles = set()
        self.copy_paths = {Path(s['copy']) for s in specs}
        self.barrier_ready, self.original_raw = False, None

    def _info(self, handle):
        c = self.ctypes
        tag = (self.wintypes.DWORD * 2)()
        need(self.query(handle, 9, c.byref(tag), c.sizeof(tag))
             and not tag[0] & (0x10 | 0x400) and tag[1] == 0,
             'Held cold-copy/source metadata is not an ordinary non-reparse file')
        identity = self.FileIdInfo()
        standard = self.StandardInfo()
        basic = self.BasicInfo()
        need(self.query(handle, 18, c.byref(identity), c.sizeof(identity))
             and self.query(handle, 1, c.byref(standard), c.sizeof(standard))
             and self.query(handle, 0, c.byref(basic), c.sizeof(basic))
             and not standard.Directory and not standard.DeletePending,
             'Exact held FileID/native metadata query required; no fallback')
        file_id = bytes(identity.FileId).hex()
        need(identity.VolumeSerialNumber != 0 and file_id != '00'*16,
             'Nonzero full Windows VolumeSerial/FileID128 required')
        return {'volume_serial':int(identity.VolumeSerialNumber), 'file_id128':file_id,
                'links':int(standard.NumberOfLinks), 'bytes':int(standard.EndOfFile),
                'allocation_bytes':int(standard.AllocationSize), 'attributes':int(basic.FileAttributes),
                'creation_ticks':int(basic.CreationTime), 'write_ticks':int(basic.LastWriteTime),
                'change_ticks':int(basic.ChangeTime), 'reparse_tag':int(tag[1])}

    def _directory_info(self, handle):
        tag = (self.wintypes.DWORD * 2)()
        identity = self.FileIdInfo()
        need(self.query(handle,9,self.ctypes.byref(tag),self.ctypes.sizeof(tag))
             and tag[0] & 0x10 and not tag[0] & 0x400 and tag[1] == 0
             and self.query(handle,18,self.ctypes.byref(identity),self.ctypes.sizeof(identity)),
             'Current/held parent must be an ordinary non-reparse native directory')
        file_id = bytes(identity.FileId).hex()
        need(identity.VolumeSerialNumber != 0 and file_id != '00'*16, 'Full parent native identity required')
        return {'volume_serial':int(identity.VolumeSerialNumber),'file_id128':file_id,
                'attributes':int(tag[0]),'reparse_tag':int(tag[1])}

    def _check_parents(self, path, *, establish=False):
        # Every live parent is closed immediately after its ordinary identity
        # snapshot; no parent lease survives this function/checkpoint.
        for parent in reversed(path.parents):
            handle = self.create(str(parent),0x80,0x7,None,3,0x00200000 | 0x02000000,None)
            need(handle not in (None,self.ctypes.c_void_p(-1).value), 'Cannot snapshot ordinary source/copy parent')
            self.transient_handles.add(handle)
            try:
                current = self._directory_info(handle)
                if parent not in self.parent_before:
                    need(establish, 'New or changed parent chain after initial snapshots')
                    self.parent_before[parent] = current
                else:
                    need(current == self.parent_before[parent], 'Current parent identity or non-reparse attributes changed')
            finally:
                self.close(handle)
                self.transient_handles.discard(handle)
                self.events.append({'operation':'parent_snapshot_closed','access':0x80,'sharing':0x7})

    def _snapshot_file(self, path, *, is_copy, initial=False, retain_copy_metadata=False):
        boundary = self.copy_boundary if is_copy else self.source_boundary
        path = self.ordinary_path(path,beneath=boundary)
        self._check_parents(path,establish=initial)
        self.ordinary_path(path,beneath=boundary)
        need(stat.S_ISREG(path.lstat().st_mode), 'Ordinary source/copy snapshot required')
        operation = 'metadata_open_attempt' if initial else 'checkpoint_metadata_open_attempt'
        self.events.append({'operation':operation,'role':'copy' if is_copy else 'source','access':0x80,'sharing':0x7})
        handle = self.create(str(path),0x80,0x7,None,3,0x00200000,None)
        need(handle not in (None,self.ctypes.c_void_p(-1).value), 'Cannot snapshot metadata-only source/copy')
        self.transient_handles.add(handle)
        retained = False
        try:
            info = self._info(handle)
            need(not is_copy or info['links']==1, 'Cold copy hardlink refused before payload or GR capability')
            self.ordinary_path(path,beneath=boundary)
            if retain_copy_metadata:
                need(is_copy, 'Only qualified copies may retain metadata until object reopen')
                self.metadata_copy_handles.append((path,handle,info))
                retained = True
            return info
        finally:
            self.transient_handles.discard(handle)
            if not retained:
                self.close(handle)
                self.events.append({'operation':'metadata_snapshot_closed','role':'copy' if is_copy else 'source',
                                    'initial':initial,'access':0x80,'sharing':0x7})
            self._check_parents(path,establish=initial)

    def _verify_snapshots(self):
        need(len(self.before)==8 and not self.transient_handles, 'Eight initial snapshots and no live transient source/parent handles required')
        current = []
        for index,spec in enumerate(self.specs):
            value = self._snapshot_file(spec['source'],is_copy=False)
            need(value==self.before[index], 'Current source identity/nlink/native metadata changed at checkpoint')
            current.append(value)
        for index,spec in enumerate(self.specs,4):
            value = self._snapshot_file(spec['copy'],is_copy=True)
            need(value==self.before[index], 'Current copy identity/nlink/native metadata changed at checkpoint')
            current.append(value)
        for path,handle,baseline in [*self.metadata_copy_handles,*self.copy_read_handles]:
            need(self._info(handle)==baseline, 'Held qualified copy object native metadata changed')
        need(not self.transient_handles, 'Every source/parent snapshot handle must already be closed')
        self.events.append({'operation':'checkpoint_complete_no_source_or_parent_handle',
                            'source_parent_handles_retained':0})
        return current

    def _lock_qualified_copy(self, path, metadata_handle, baseline):
        # ReOpenFile upgrades the same previously disjoint COPY object. Source
        # and parent snapshots are already closed, and never get GR capability.
        try:
            self._verify_snapshots()
            need(baseline['links']==1 and self._info(metadata_handle)==baseline,
                 'Qualified copy object changed before reopen')
            self.events.append({'operation':'ReOpenFile_GR_attempt','access':0x80000000,'sharing':0x1,
                                'qualified_volume_serial':baseline['volume_serial'],
                                'qualified_file_id128':baseline['file_id128'],
                                'source_parent_handles_retained':len(self.transient_handles)})
            handle = self.reopen(metadata_handle,0x80000000,0x1,0x00200000)
            need(handle not in (None,self.ctypes.c_void_p(-1).value), 'Cannot reopen the qualified copy object')
            self.copy_read_handles.append((path,handle,baseline))
            need(self._info(handle)==baseline and self._info(metadata_handle)==baseline
                 and self._snapshot_file(path,is_copy=True)==baseline,
                 'Read-capable copy object/current path changed before payload')
            self.events.append({'operation':'ReOpenFile_GR_validated','qualified_file_id128':baseline['file_id128']})
        finally:
            self.close(metadata_handle)
            self.metadata_copy_handles=[item for item in self.metadata_copy_handles if item[1]!=metadata_handle]

    def __enter__(self):
        need(os.name == 'nt', 'Windows held source/copy identity boundary required')
        import ctypes
        from ctypes import wintypes
        self.ctypes, self.wintypes = ctypes, wintypes
        class FileIdInfo(ctypes.Structure):
            _fields_ = [('VolumeSerialNumber',ctypes.c_ulonglong), ('FileId',ctypes.c_ubyte*16)]
        class StandardInfo(ctypes.Structure):
            _fields_ = [('AllocationSize',ctypes.c_longlong),('EndOfFile',ctypes.c_longlong),
                        ('NumberOfLinks',wintypes.DWORD),('DeletePending',ctypes.c_ubyte),('Directory',ctypes.c_ubyte)]
        class BasicInfo(ctypes.Structure):
            _fields_ = [('CreationTime',ctypes.c_longlong),('LastAccessTime',ctypes.c_longlong),
                        ('LastWriteTime',ctypes.c_longlong),('ChangeTime',ctypes.c_longlong),('FileAttributes',wintypes.DWORD)]
        self.FileIdInfo, self.StandardInfo, self.BasicInfo = FileIdInfo, StandardInfo, BasicInfo
        kernel = ctypes.WinDLL('kernel32',use_last_error=True)
        self.create = kernel.CreateFileW
        self.create.argtypes = [wintypes.LPCWSTR,wintypes.DWORD,wintypes.DWORD,ctypes.c_void_p,wintypes.DWORD,wintypes.DWORD,wintypes.HANDLE]
        self.create.restype = wintypes.HANDLE
        self.reopen = kernel.ReOpenFile
        self.reopen.argtypes = [wintypes.HANDLE,wintypes.DWORD,wintypes.DWORD,wintypes.DWORD]
        self.reopen.restype = wintypes.HANDLE
        self.query = kernel.GetFileInformationByHandleEx
        self.query.argtypes = [wintypes.HANDLE,ctypes.c_int,ctypes.c_void_p,wintypes.DWORD]
        self.query.restype = wintypes.BOOL
        self.close = kernel.CloseHandle
        self.close.argtypes, self.close.restype = [wintypes.HANDLE],wintypes.BOOL
        try:
            need(len(self.specs)==4 and {s['label'] for s in self.specs}=={'routes','state','stdout.log','stderr.log'},
                 'Exact four cold-copy roles required')
            sources, copies = [], []
            for spec in self.specs:
                cold_copy_name(spec['copy'])
                need(spec['source']!=spec['copy'], 'Live source and cold copy must be distinct before bytes')
                sources.append(self._snapshot_file(spec['source'],is_copy=False,initial=True))
            for spec in self.specs:
                copies.append(self._snapshot_file(spec['copy'],is_copy=True,initial=True,retain_copy_metadata=True))
            key = lambda info:(info['volume_serial'],info['file_id128'])
            need(len({key(info) for info in sources})==4 and len({key(info) for info in copies})==4
                 and not {key(info) for info in sources}.intersection(key(info) for info in copies),
                 'Source/copy FileIDs alias or repeat; refuse before first GR or payload byte')
            self.before = sources+copies
            self._verify_snapshots()
            self.events.append({'operation':'all_eight_preidentified','metadata_objects':8,
                                'sources_and_copies_disjoint':True,'copies_single_link':True,
                                'source_parent_handles_retained':0})
            for path,handle,baseline in list(self.metadata_copy_handles):
                self._lock_qualified_copy(path,handle,baseline)
            need(not self.metadata_copy_handles and not self.transient_handles, 'Only read-capable copy objects may remain held')
            self.barrier_ready = True
            self.verify_unchanged()
            self.events.append({'operation':'payload_barrier_ready','source_parent_handles_retained':0})
            if self.payload_api is not None:
                need(isinstance(self.payload_api,dict) and callable(self.payload_api.get('raw')), 'Exact local payload IO namespace required')
                self.original_raw = self.payload_api['raw']
                self.payload_api['raw'] = self.guarded_reader(self.original_raw)
            return self
        except BaseException:
            self.__exit__(None,None,None)
            raise

    def verify_unchanged(self):
        need(self.barrier_ready and len(self.copy_read_handles)==4 and not self.metadata_copy_handles,
             'Only four qualified read-copy handles may survive the pre-payload barrier')
        try:
            return self._verify_snapshots()
        except OSError as error:
            raise ValueError('Current source/parent/copy snapshot unavailable; refuse after pathname mutation') from error

    def guarded_reader(self, reader):
        """Local IO envelope; exact no-follow raw remains the payload validator."""
        def read(path):
            if Path(path) not in self.copy_paths:
                return reader(path)
            self.verify_unchanged()
            try:
                return reader(path)
            finally:
                self.verify_unchanged()
        return read

    def evidence(self):
        current = self.verify_unchanged()
        return {'metadata_source_bytes_read':False,'source_metadata_only':True,
                'source_WRITE_and_DELETE_sharing_allowed':True,
                'source_and_parent_snapshot_handles_closed_immediately':True,
                'source_handles_retained_between_checkpoints':0,'parent_handles_retained_between_checkpoints':0,
                'retained_copy_GENERIC_READ_handles':len(self.copy_read_handles),
                'current_parent_native_identities_and_nonreparse_attributes_rechecked':True,
                'parent_directory_rename_exclusion_promised':False,
                'ancestor_of_locked_copies_rename_success_promised':False,
                'current_source_paths_reopened_nofollow_READ_ATTRIBUTES':True,
                'copy_file_IDs_distinct_from_all_four_sources':True,'copies_single_link':True,
                'all_eight_preidentified_READ_ATTRIBUTES_before_any_GR':True,
                'copies_GR_via_ReOpenFile_of_qualified_metadata_objects_only':True,
                'native_open_order':self.events,'copy_GENERIC_READ_capability_without_pre_barrier_data_read':True,
                'copy_WRITE_and_DELETE_sharing_excluded':True,
                'source_and_copy_native_metadata_before':self.before,
                'source_and_copy_native_metadata_after':current,
                'current_source_metadata_at_checkpoint':current[:4],
                'observed_source_or_parent_mutation_refuses':True,
                'continuous_source_or_parent_stability_proved':False,
                'absence_of_source_or_parent_ABA_proved':False,'future_source_stability_promised':False}

    def __exit__(self,*_args):
        if self.original_raw is not None:
            self.payload_api['raw'] = self.original_raw
            self.original_raw = None
        self.barrier_ready = False
        for _,handle,_ in reversed(self.copy_read_handles):
            self.close(handle)
        self.copy_read_handles.clear()
        for _,handle,_ in reversed(self.metadata_copy_handles):
            self.close(handle)
        self.metadata_copy_handles.clear()
        # Transient snapshots close in their own finally, including failures.
        need(not self.transient_handles, 'Transient source/parent handle cleanup incomplete')



def resumed_binding(intent, refs, prior):
    need(Path(refs['start_intent']['path']) == OBS/'INTENTION-UNIQUE-OBS4-R8-REPRISE-02.json',
         'Only explicit new lifecycle intent; the consumed first intent is never reused')
    need(Path(refs['start_observed']['path']).parent == OBS/'execution-root-02', 'One new execution-root-02 boundary')
    evidence = prior.get('previous_R8_lifecycle', {})
    need(intent.get('previous_R8_closure') == evidence.get('closure')
         and intent.get('previous_R8_closure_review') == evidence.get('independent_actual_closure_review')
         and intent.get('previous_R8_runtime_archive') == prior.get('previous_R8_runtime_archive')
         and prior.get('new_start_intent_name') == 'INTENTION-UNIQUE-OBS4-R8-REPRISE-02.json'
         and evidence.get('all_six_original_identities_absent') is True
         and evidence.get('no_reused_or_ambiguous_context') is True
         and evidence.get('fresh_full_cim') == prior.get('fresh_full_cim')
         and isinstance(evidence.get('fresh_full_cim'),dict),
         'Start intent must bind the actually closed previous lifecycle and retained runtime')
    for name in ('previous_R8_closure','previous_R8_closure_review','previous_R8_runtime_archive',
                 'previous_sequence_terminal','lifecycle_preparation_review','lifecycle_neutral_completion'):
        reference = intent.get(name)
        need(isinstance(reference,dict) and set(reference)=={'path','sha256'}
             and re.fullmatch('[0-9a-f]{64}',reference['sha256']), 'Absent lifecycle ref remains closed')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ('input','helper-review','neutral-test-receipt','output-directory'):
        parser.add_argument('--'+name,type=Path,required=True)
    parser.add_argument('--input-sha256',required=True)
    parser.add_argument('--helper-review-sha256',required=True)
    parser.add_argument('--neutral-test-receipt-sha256',required=True)
    args = parser.parse_args()
    # Qualified local held/no-follow IO only. No product module or operational main.
    for path in (*reversed(PHASE1.parents),PHASE1):
        facts=path.lstat();need(not stat.S_ISLNK(facts.st_mode) and not getattr(facts,'st_file_attributes',0)&1024,'Preparation source reparse refused')
    source=PHASE1.read_bytes();need(sha(source)==PHASE1_SHA,'Exact local IO primitive source required')
    tree=ast.parse(source);need(isinstance(tree.body[-1],ast.If) and ast.unparse(tree.body[-1].test)=="__name__ == '__main__'",'Exclude exact preparation main')
    tree.body.pop();ns={'__file__':str(PHASE1),'__name__':'pair_receiver_IO_only'};exec(compile(tree,str(PHASE1),'exec'),ns)
    need(ns['BASE']==BASE and ns['PREP']==PREP,'Exact primitive anchors required')
    store=ns['ColdStore']()
    review_path=ns['ordinary_path'](args.helper_review,beneath=CODE/'revue-preparation-independante-r1')
    review_ref=ns['ref'](review_path,args.helper_review_sha256);review=store.reference(review_ref)
    need(review.get('schema')=='hpc-forest-r8-dynamic-pair-receiver-independent-preparation-review-v1'
         and review.get('verified_source_preparation_only') is True and review.get('blocking_findings')==[]
         and review.get('reviewed_files',{}).get(SELF.name)==sha(store.raw(SELF))
         and review.get('native_generation_admitted') is False,'Actual independent receiver preparation review required')
    test_source=store.raw(TEST_SOURCE)
    need(review.get('reviewed_files',{}).get(TEST_SOURCE.name)==sha(test_source),'Independent review must bind the prepared test code too')
    test_path=ns['ordinary_path'](args.neutral_test_receipt,beneath=CODE)
    tests=store.reference(ns['ref'](test_path,args.neutral_test_receipt_sha256))
    need(tests.get('schema')=='hpc-forest-r8-dynamic-pair-neutral-test-completion-v1'
         and tests.get('receiver_sha256')==sha(store.raw(SELF)) and tests.get('test_source_sha256')==sha(test_source)
         and type(tests.get('tests_run')) is int and tests['tests_run']==47
         and all(type(tests.get(k)) is int and tests[k]==0 for k in ('exit_code','failures','errors','skipped'))
         and tests.get('source_observer_before_after_equal') is True and tests.get('receiver_main_executed') is False
         and tests.get('receiver_and_test_before_after_equal') is True
         and tests.get('fixture_results_are_live_observation') is False,
         'Actual ROOT execution of exact47 prepared neutral cases required, never an ancestor PASS')
    input_path=ns['ordinary_path'](args.input,beneath=OBS)
    inputs=store.reference(ns['ref'](input_path,args.input_sha256));not_inert(inputs)
    names={'start_intent','start_observed','startup_census_before','startup_census_after','policy','routes_initial_copy',
           'routes_initial_copy_receipt','transition','source_only_absence','observer3_absence','prior_observer_current_absence',
           'cold_state','cold_state_receipt','cold_logs_receipt','external_preparation_review'}
    need(set(inputs)=={'schema',*names} and inputs['schema']=='hpc-forest-r8-actual-observer-startup-cold-input-v1','Closed actual R8 cold startup input only')
    refs={name:inputs[name] for name in names}
    for reference in refs.values(): ns['ordinary_path'](reference['path'],beneath=OBS)
    def read_cold(reference):
        path=ns['ordinary_path'](reference['path'],beneath=OP)
        need(path.name.rstrip(' .').casefold() not in {'observer-state.json','stdout.log','stderr.log','observer.lock','worker.lock','routes-obs4.json'},'Only ROOT cold copies, never live state/log/lock')
        return store.reference(reference)
    # Copy payloads are excluded until all source/copy handle identities are closed.
    docs={name:read_cold(ref) for name,ref in refs.items() if name not in {'routes_initial_copy','cold_state'}}
    resumed_binding(docs['start_intent'],refs,docs['prior_observer_current_absence'])
    lifecycle_path=CODE/'cycle-passif-externe-R8.py'
    lifecycle_raw=store.pinned(lifecycle_path,LIFECYCLE_SHA)
    tree=ast.parse(lifecycle_raw);need(isinstance(tree.body[-1],ast.If),'Exact lifecycle main excluded');tree.body.pop()
    lifecycle={'__file__':str(lifecycle_path),'__name__':'ROOT_resumed_startup_lifecycle_definitions'}
    exec(compile(tree,str(lifecycle_path),'exec'),lifecycle)
    intent=docs['start_intent']
    for name in ('previous_R8_closure','previous_R8_closure_review'):
        ns['ordinary_path'](intent[name]['path'],beneath=LIVE/'fermeture-passive-R8-preparee-r1')
    need(Path(intent['previous_R8_runtime_archive']['path'])==OBS/'archive-runtime-reprise-02/ARCHIVAGE-RUNTIME-POST-CLOTURE.json'
         and Path(intent['previous_sequence_terminal']['path'])==LIVE/'activation-passive-reelle-root-01/RECEPTION-TERMINALE-SEQUENCE-33705.json',
         'Only literal previous lifecycle archive/terminal paths')
    closure=read_cold(intent['previous_R8_closure']);closed_review=read_cold(intent['previous_R8_closure_review'])
    lifecycle['closure_contract'](closure,closed_review,intent['previous_R8_closure'],intent['previous_R8_closure_review'])
    archive=read_cold(intent['previous_R8_runtime_archive']);lifecycle['archive_contract'](archive,intent['previous_R8_closure'],intent['previous_R8_closure_review'])
    terminal=read_cold(intent['previous_sequence_terminal']);lifecycle['sequence_terminal'](terminal)
    for item in archive['files']:
        need(Path(item['retained_path'])==OBS/'archive-runtime-reprise-02'/('ORIGINAL-'+item['name']), 'Exact retained runtime path')
        store.pinned(Path(item['retained_path']),item['sha256'])
    need(Path(closure['plan']['path']).parent==Path(intent['previous_R8_closure']['path']).parent, 'Plan belongs to exact closure execution')
    close_plan=read_cold(closure['plan'])
    need(Path(close_plan['cold_anchors']['path'])==LIVE/'fermeture-passive-R8-preparee-r1/ANCRAGES-FROIDS-EXACTS-R8.json', 'Exact previous six-context anchor')
    anchors=read_cold(close_plan['cold_anchors'])
    lifecycle['require_current_six_absence'](docs['startup_census_before']['rows'],anchors)
    need(archive['previous_sequence_terminal']==intent['previous_sequence_terminal']
         and ticks(archive['observed_at_utc'])<=ticks(intent['created_at_utc'])
         and ticks(closure['observed_at_utc'])<ticks(docs['startup_census_before']['captured_at_utc']),
         'Actual previous sequence terminal/archive/closure chronology; no old window renewed')
    specs=cold_copy_specs(docs,refs)
    with HeldDistinctColdCopies(specs,ns['ordinary_path'],payload_api=store.api) as copy_lease:
        for name in ('routes_initial_copy','cold_state'):
            docs[name]=read_cold(refs[name])
        refs['immediate_before']=docs['start_intent']['full_cim'];docs['immediate_before']=read_cold(refs['immediate_before'])
        component=ns['strict_json'](store.pinned(CHAIN/'COMPONENTS.json',COMPONENTS))
        need(len(component['code_pins'])==62 and component['source_zip_sha256']==SOURCE and component['plan_sha256']==PLAN,'Exact current R8 source/plan/62')
        for name,checksum in component['code_pins'].items():store.pinned(CHAIN/name,checksum)
        real_review=store.reference(ns['ref'](REVIEW,REVIEW_SHA))
        need(real_review['reviewed_files']==component['code_pins'] and real_review['blocking_findings']==[]
             and real_review['observer_sha256']==OBSERVER_SHA,'Actual independent R8 integration binding')
        external=docs['external_preparation_review']
        external_names={'cycle-passif-externe-R8.py','preparer-observation-froide-R8.py',
                        'preparer-policy-routes-R8.py','lancer-observateur-R8-r2.ps1'}
        need(external.get('schema')=='hpc-forest-r8-observation-preparation-review-v1'
             and external.get('verified_source_preparation_only') is True and external.get('blocking_findings')==[]
             and external.get('passive_observer_only') is True and external.get('native_generation_admitted') is False
             and set(external.get('reviewed_files',{}))==external_names,'Actual four-component external preparation review required')
        for name,checksum in external['reviewed_files'].items():
            path=(CODE/name if name in {'cycle-passif-externe-R8.py','lancer-observateur-R8-r2.ps1'} else OBS/name)
            store.pinned(path,checksum)
        pure_contract={ 'Path':Path,'json':json,'need':need,'BASE_IDENTITY':{'scope_id':SCOPE,'source_zip_sha256':SOURCE,'plan_sha256':PLAN},
            'Q_REVISION':'r4b-source110-external-adapters-r2','read':store.reference,
            'artifact':lambda ref: (store.pinned(Path(ref['path']),ref['sha256']) and Path(ref['path'])),
            'sha':lambda path:sha(store.raw(Path(path)))}
        contract_nodes=[n for n in ast.parse(store.raw(CHAIN/'chain_contract.py')).body if isinstance(n,ast.FunctionDef) and n.name in {'bind','qualification'}]
        need({n.name for n in contract_nodes}=={'bind','qualification'},'Closed exact Q contract graph')
        exec(compile(ast.Module(body=contract_nodes,type_ignores=[]),'<qualified-R8-Q-contract-only>','exec'),pure_contract)
        pure_contract['qualification'](docs['policy']['qualification_reception'],components_manifest_sha256=COMPONENTS)
        api=observer_api(store.pinned(CHAIN/'observer/observer-mixte.py',OBSERVER_SHA))
        templates=context_templates(ns['strict_json'](store.pinned(CONTEXT_SOURCE,CONTEXT_SHA)),api)
        for name in ('source_only_absence','observer3_absence'):
            proof=docs[name];prior_ref=proof['prior_full_cim']
            ns['ordinary_path'](prior_ref['path'],beneath=BASE/'outputs')
            historical=store.reference(prior_ref)
            need(historical.get('schema')=='hpc-forest-dynamic-r4b-full-cim-v1'
                 and historical.get('complete_census') is True and historical.get('strict_utf8_decoding') is True
                 and type(historical.get('rows_count')) is int and historical['rows_count']==len(historical.get('rows',[]))
                 and ticks(historical['captured_at_utc'])<=ticks(docs['startup_census_before']['captured_at_utc'])
                 and all(any(api['same_identity'](old,row) for row in historical['rows']) for old in proof['owned_full_identities']),
                 'Original historical full-pair presence/provenance required; never a current freshness source')
        # A second exact IO namespace admits only two literal binary paths outside/inside BASE.
        io_source=store.pinned(ns['RAW_SOURCE'],ns['RAW_SHA'])
        nodes=[n for n in ast.parse(io_source).body if isinstance(n,ast.FunctionDef) and n.name in ns['RAW_NAMES']]
        binary_io={'Path':Path,'os':os,'stat':stat,'Q':Path('C:/Users/nicol'),'json':json}
        exec(compile(ast.Module(body=nodes,type_ignores=[]),'<qualified-IO-two-executable-hashes-only>','exec'),binary_io)
        def exe_hashes():
            return {path:sha(binary_io['raw'](Path(path))) for path in EXE_PINS}
        hashes=exe_hashes()
        pair,context=validate_startup(docs,refs,api,templates,hashes,now_ticks=time.time_ns()//100)
        # Root-copy receipts never cause source/live reads; only their cold copy refs are read.
        for name,source_path,copy_ref in (('routes_initial_copy_receipt',docs['start_intent']['routes']['path'],refs['routes_initial_copy']),
                                          ('cold_state_receipt',str(CHAIN/'observer/observer-state.json'),refs['cold_state'])):
            receipt=docs[name]
            need(receipt.get('schema')=='hpc-forest-r8-ROOT-byte-exact-cold-copy-v1' and receipt.get('source_before')==receipt.get('source_after')
                 and receipt.get('source_before',{}).get('path')==source_path and receipt.get('source_before',{}).get('sha256')==copy_ref['sha256']
                 and receipt.get('copy')==copy_ref and receipt.get('two_source_reads_equal_copy') is True
                 and receipt.get('live_source_read_by_ROOT_only') is True
                 and type(receipt.get('bytes')) is int and receipt['bytes']==len(store.raw(Path(copy_ref['path'])))
                 and ticks(docs['start_observed']['observed_at_utc'])<=ticks(receipt['observed_at_utc'])<=time.time_ns()//100,
                 'Actual stable byte-exact ROOT copy receipt required')
        logs=docs['cold_logs_receipt']
        need(logs.get('schema')=='hpc-forest-r8-ROOT-two-cold-log-copies-v1' and isinstance(logs.get('copies'),list) and len(logs['copies'])==2,'Actual two cold log copies required')
        for item,name in zip(logs['copies'],('stdout.log','stderr.log')):
            need(item['source_before']['path']==docs['start_observed']['stdout' if name=='stdout.log' else 'stderr']
                 and Path(item['source_before']['path']).name==name and item['source_before']==item['source_after']
                 and item['source_before']['sha256']==item['copy']['sha256'] and item.get('two_source_reads_equal_copy') is True,'Logs source/copy bindings differ')
            path=ns['ordinary_path'](cold_copy_name(item['copy']['path']),beneath=OBS);raw=store.pinned(path,item['copy']['sha256'])
            need(type(item['bytes']) is int and item['bytes']==len(raw)==0,'Actual initial cold logs must be empty; preserve unknown/error output and refuse')
        copy_lease.verify_unchanged()
        store.unchanged();need(exe_hashes()==hashes,'An exact interpreter changed before receipt')
        validate_startup(docs,refs,api,templates,hashes,now_ticks=time.time_ns()//100)
        out=ns['ordinary_path'](args.output_directory,beneath=OBS,missing_leaf=True)
        need(out.parent==OBS and re.fullmatch(r'reception-paire-root-\d{2,4}',out.name),'New direct startup receipt output under actual observer boundary')
        ns['require_missing'](out)
        before=dict(store.pins)
        metadata_before={p:list(store.api['metadata'](Path(p).lstat())) for p in before}
        with ns['DirectoryLeases']() as leases:
            leases.hold(OBS);ns['require_missing'](out);out.mkdir();leases.hold(out)
            pair_bytes=ns['json_bytes'](pair);ns['write_new'](out/'IDENTITES-PAIRE-DEUX-REELLES.json',pair_bytes)
            pair_ref=ns['ref'](out/'IDENTITES-PAIRE-DEUX-REELLES.json',sha(pair_bytes))
            graph={'schema':'hpc-forest-r8-owned-passive-startup-evidence-v1','refs':{name:(pair_ref if name=='received_pair' else refs[name]) for name in TEN}}
            graph_bytes=ns['json_bytes'](graph);ns['write_new'](out/'DEMARRAGE-REEL-DIX-REFERENCES.json',graph_bytes)
            receipt={'schema':'hpc-forest-r8-actual-passive-pair-cold-reception-v1','verified_metadata_only':True,
                'source_zip_sha256':SOURCE,'plan_sha256':PLAN,'components_sha256':COMPONENTS,'observer_code_sha256':OBSERVER_SHA,
                'helper_review':review_ref,'actual_input':ns['ref'](input_path,args.input_sha256),'pair':pair_ref,
                'actual_neutral_test_receipt':ns['ref'](test_path,args.neutral_test_receipt_sha256),
                'startup_graph':ns['ref'](out/'DEMARRAGE-REEL-DIX-REFERENCES.json',sha(graph_bytes)),
                'received_full_context':context,'actual_interpreter_SHA_before':hashes,'actual_interpreter_SHA_after':exe_hashes(),
                'context_scope':'Full five-field same-census parent/creation/argv metadata only; no equality of installed and loaded MCP source claimed',
                'observer_pair_count':1,'LLM_worker_pairs_attributed_to_this_passive_pair':0,
                'raw_pair_independent_admission_flag_preserved_false':True,'independent_actual_pair_review_received':False,
                'input_SHA_before':before,'input_SHA_after':dict(store.pins),'input_metadata_before':metadata_before,
                'input_metadata_after':{p:list(store.api['metadata'](Path(p).lstat())) for p in before},'historical_templates_are_not_new_PIDs':True,
                'live_state_logs_locks_or_auth_read':False,'cold_copy_distinctness':copy_lease.evidence(),'process_RPC_CLI_model_or_source_execution_effects':0,
                'current_or_future_presence_absence_or_global_model_inflight_promised':False,'native_generation_admitted':False}
            ns['write_new'](out/'RECEPTION-PAIRE-PASSIVE-METADATA-SEULEMENT.json',ns['json_bytes'](receipt))
            need(store.api['raw'](Path(pair_ref['path']))==pair_bytes and store.api['raw'](out/'DEMARRAGE-REEL-DIX-REFERENCES.json')==graph_bytes,'New receipt bytes changed')
            store.unchanged();need(dict(store.pins)==before and exe_hashes()==hashes
                 and {p:list(store.api['metadata'](Path(p).lstat())) for p in before}==metadata_before,'Inputs SHA/metadata changed during new cold receipt')
        copy_lease.verify_unchanged()
        print(json.dumps({'receipt_directory':str(out),'observer_pairs':1,'native_workers_started':0,'native_generation_admitted':False}))


if __name__ == '__main__':
    main()

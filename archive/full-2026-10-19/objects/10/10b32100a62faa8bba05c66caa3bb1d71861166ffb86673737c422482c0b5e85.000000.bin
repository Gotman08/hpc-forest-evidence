  "primary_sources": [
    {
      "url": "https://raw.githubusercontent.com/python/cpython/v3.13.4/Modules/posixmodule.c",
      "source_lines": [
        5433,
        5466,
        5524,
        5539
      ],
      "paraphrase": "Versioned Windows os.replace uses internal_rename with MOVEFILE_REPLACE_EXISTING and calls MoveFileExW. This is source-level mapping, not an observed native stack or proof of local kernel flags."
    },
    {
      "url": "https://learn.microsoft.com/en-us/windows/win32/api/fileapi/nf-fileapi-createfilew",
      "source_lines": [
        66,
        93
      ],
      "paraphrase": "Access and share modes constrain subsequent opens; shareDELETE permits requests for delete access, which includes rename. These parameters do not alone guarantee that an arbitrary replacement succeeds."
    },
    {
      "url": "https://learn.microsoft.com/en-us/windows/win32/api/winbase/nf-winbase-reopenfile",
      "source_lines": [
        45,
        71
      ],
      "paraphrase": "ReOpenFile changes access/sharing on a specified existing object handle; incompatible opens are refused. The qualified-copy-object approach remains useful and should be kept."
    },
    {
      "url": "https://learn.microsoft.com/en-us/windows-hardware/drivers/ddi/ntifs/ns-ntifs-_file_rename_information",
      "source_lines": [
        65,
        66,
        101,
        125
      ],
      "paraphrase": "The documented rename rules distinguish existing open target handles and files open within a directory. The separate POSIX rename flag permits replacement despite existing handles. Thus sharing DELETE is not a complete noninterference argument."
    },
    {
      "url": "https://learn.microsoft.com/en-us/windows/win32/api/winbase/nf-winbase-movefileexw",
      "source_lines": [
        90,
        100,
        123,
        124
      ],
      "paraphrase": "REPLACE_EXISTING remains conditional on access/security and failures are reported with GetLastError."
    }
  ],

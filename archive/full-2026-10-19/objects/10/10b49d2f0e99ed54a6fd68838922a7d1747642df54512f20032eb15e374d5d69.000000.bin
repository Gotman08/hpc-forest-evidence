{
  "src/npbonacci.cpp": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\nnamespace {\nusing word = std::uint32_t;\nusing wide = std::uint64_t;\nconstexpr wide MOD = 1000000007ULL;\nconstexpr int BATCH = 16;\n\nword dot_mod(const word* a, const word* b, int count) {\n    wide sum = 0;\n    int i = 0;\n    // (MOD-1) + 16*(MOD-1)^2 fits in uint64_t.\n    for (; i + BATCH <= count; i += BATCH) {\n        wide block = 0;\n        for (int j = 0; j < BATCH; ++j)\n            block += wide(a[i + j]) * b[i + j];\n        sum = (sum + block) % MOD;\n    }\n    if (i < count) {\n        for (; i < count; ++i)\n            sum += wide(a[i]) * b[i];\n        sum %= MOD;\n    }\n    return static_cast<word>(sum);\n}\n\nword power_mod(word base, wide exponent) {\n    wide result = 1;\n    while (exponent != 0) {\n        if (exponent & 1)\n            result = result * base % MOD;\n        base = static_cast<word>(wide(base) * base % MOD);\n        exponent >>= 1;\n    }\n    return static_cast<word>(result);\n}\n\nwide polynomial_work(int n, wide exponent, int top_bit) {\n    wide cost = 0;\n    int degree = 0;\n    for (int bit = top_bit; bit >= 0; --bit) {\n        const wide width = static_cast<wide>(degree) + 1;\n        cost += width * (width + 1) / 2;\n        const int squared_degree = 2 * degree;\n        if (squared_degree >= n)\n            cost += wide(squared_degree - n + 1) * n;\n        degree = std::min(squared_degree, n - 1);\n        if ((exponent >> bit) & 1) {\n            if (degree == n - 1)\n                cost += n;\n            else\n                ++degree;\n        }\n    }\n    return cost;\n}\n\nword direct_term(const std::vector<word>& initial,\n                 const std::vector<word>& coefficient, wide steps) {\n    const int n = static_cast<int>(initial.size());\n    // Duplicate the ring so each chronological window is contiguous.\n    std::vector<word> history(2 * n);\n    std::copy(initial.begin(), initial.end(), history.begin());\n    std::copy(initial.begin(), initial.end(), history.begin() + n);\n    int first = 0;\n    word value = initial.back();\n    for (wide step = 0; step < steps; ++step) {\n        value = dot_mod(history.data() + first, coefficient.data(), n);\n        history[first] = value;\n        history[first + n] = value;\n        if (++first == n)\n            first = 0;\n    }\n    return value;\n}\n\nword polynomial_term(const std::vector<word>& initial,\n                     const std::vector<word>& coefficient,\n                     wide exponent, int top_bit) {\n    const int n = static_cast<int>(initial.size());\n    std::vector<word> residue(n, 0);\n    std::vector<word> reversed(n);\n    std::vector<wide> work(2 * n - 1);\n    residue[0] = 1;\n    int degree = 0;\n\n    for (int bit = top_bit; bit >= 0; --bit) {\n        for (int i = 0; i <= degree; ++i)\n            reversed[i] = residue[degree - i];\n\n        const int squared_degree = 2 * degree;\n        for (int k = 0; k <= squared_degree; ++k) {\n            const int first = std::max(0, k - degree);\n            const int pairs = (k + 1) / 2 - first;\n            // Each off-diagonal product is computed only once. Both\n            // dot-product inputs advance through contiguous storage.\n            const word cross = dot_mod(residue.data() + first,\n                                       reversed.data() + degree - k + first,\n                                       pairs);\n            wide value = 2 * wide(cross);\n            if ((k & 1) == 0) {\n                value += wide(residue[k / 2]) * residue[k / 2];\n                work[k] = value % MOD;\n            } else {\n                work[k] = value >= MOD ? value - MOD : value;\n            }\n        }\n\n        // x^n = coefficient[0] + ... + coefficient[n-1]*x^(n-1).\n        // Every surviving entry receives at most BATCH products between\n        // normalizations, so the same uint64_t bound as dot_mod applies.\n        for (int top = squared_degree; top >= n;) {\n            const int bottom = std::max(n, top - (BATCH - 1));\n            for (int k = top; k >= bottom; --k) {\n                const word factor = static_cast<word>(work[k] % MOD);\n                if (factor == 0)\n                    continue;\n                wide* target = work.data() + k - n;\n                for (int j = 0; j < n; ++j)\n                    target[j] += wide(factor) * coefficient[j];\n            }\n            // Only this contiguous surviving window was modified.\n            for (int j = bottom - n; j < bottom; ++j)\n                work[j] %= MOD;\n            top = bottom - 1;\n        }\n\n        degree = std::min(squared_degree, n - 1);\n        for (int i = 0; i <= degree; ++i)\n            residue[i] = static_cast<word>(work[i]);\n\n        if ((exponent >> bit) & 1) {\n            // A set exponent bit requires only multiplication by x.\n            if (degree < n - 1) {\n                for (int j = degree + 1; j > 0; --j)\n                    residue[j] = residue[j - 1];\n                residue[0] = 0;\n                ++degree;\n            } else {\n                const word leading = residue[n - 1];\n                for (int j = n - 1; j > 0; --j)\n                    residue[j] = static_cast<word>(\n                        (wide(leading) * coefficient[j] + residue[j - 1]) % MOD);\n                residue[0] = static_cast<word>(wide(leading) * coefficient[0] % MOD);\n            }\n        }\n    }\n    return dot_mod(residue.data(), initial.data(), degree + 1);\n}\n} // namespace\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n;\n    wide h;\n    if (!(std::cin >> n >> h))\n        return 0;\n\n    std::vector<word> initial(n), coefficient(n);\n    for (int i = 0; i < n; ++i)\n        std::cin >> initial[i];\n    for (int i = 0; i < n; ++i)\n        std::cin >> coefficient[n - 1 - i];\n\n    word answer;\n    if (h <= static_cast<wide>(n)) {\n        answer = initial[static_cast<std::size_t>(h - 1)];\n    } else if (n == 1) {\n        answer = static_cast<word>(wide(initial[0]) *\n                                   power_mod(coefficient[0], h - 1) % MOD);\n    } else {\n        const wide exponent = h - 1;\n        int top_bit = 0;\n        for (wide remaining = exponent; remaining > 1; remaining >>= 1)\n            ++top_bit;\n        const wide steps = h - n;\n        if (steps * static_cast<wide>(n) <= polynomial_work(n, exponent, top_bit))\n            answer = direct_term(initial, coefficient, steps);\n        else\n            answer = polynomial_term(initial, coefficient, exponent, top_bit);\n    }\n\n    std::cout << answer << '\\n';\n    return 0;\n}\n"
}

  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdint.h>\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\ntypedef struct {\n  float *x, *y, *z;\n} Coordinates;\n\n/* Force-only operation, also used if the scratch allocation fails. */\nvoid body_force(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\ntypedef struct {\n  float32x4_t dx, dy, dz, sqrd_dist;\n} NBodyDelta4;\n\nstatic inline NBodyDelta4 nbody_delta4(float32x4_t sx,\n                                      float32x4_t sy,\n                                      float32x4_t sz,\n                                      float32x4_t x,\n                                      float32x4_t y,\n                                      float32x4_t z) {\n  NBodyDelta4 d;\n  d.dx = vsubq_f32(sx, x);\n  d.dy = vsubq_f32(sy, y);\n  d.dz = vsubq_f32(sz, z);\n  d.sqrd_dist = vaddq_f32(vmulq_f32(d.dx, d.dx),\n                         vmulq_f32(d.dy, d.dy));\n  d.sqrd_dist = vaddq_f32(d.sqrd_dist, vmulq_f32(d.dz, d.dz));\n  d.sqrd_dist = vaddq_f32(d.sqrd_dist, vdupq_n_f32(SOFTENING));\n  return d;\n}\n\nstatic inline float32x4_t inverse_distance4(float32x4_t squared) {\n  const float64x2_t one = vdupq_n_f64(1.0);\n  const float64x2_t lo = vcvt_f64_f32(vget_low_f32(squared));\n  const float64x2_t hi = vcvt_f64_f32(vget_high_f32(squared));\n\n  /* Match the reference's double sqrt and division before narrowing. */\n  const float64x2_t inv_lo = vdivq_f64(one, vsqrtq_f64(lo));\n  const float64x2_t inv_hi = vdivq_f64(one, vsqrtq_f64(hi));\n  return vcombine_f32(vcvt_f32_f64(inv_lo), vcvt_f32_f64(inv_hi));\n}\n\nstatic inline void nbody_accumulate4(NBodyDelta4 d,\n                                     float32x4_t inv_dist,\n                                     float32x4_t *fx,\n                                     float32x4_t *fy,\n                                     float32x4_t *fz) {\n  const float32x4_t inv_dist2 = vmulq_f32(inv_dist, inv_dist);\n  const float32x4_t inv_dist3 = vmulq_f32(inv_dist2, inv_dist);\n  *fx = vaddq_f32(*fx, vmulq_f32(d.dx, inv_dist3));\n  *fy = vaddq_f32(*fy, vmulq_f32(d.dy, inv_dist3));\n  *fz = vaddq_f32(*fz, vmulq_f32(d.dz, inv_dist3));\n}\n#endif\n\nstatic inline void advance_one(const Body *restrict p,\n                               Body *restrict next,\n                               const Coordinates source,\n                               Coordinates destination,\n                               float dt, int n, int i) {\n  const float x = source.x[i];\n  const float y = source.y[i];\n  const float z = source.z[i];\n  float fx = 0.0f;\n  float fy = 0.0f;\n  float fz = 0.0f;\n\n  for (int j = 0; j < n; ++j) {\n    float dx = source.x[j] - x;\n    float dy = source.y[j] - y;\n    float dz = source.z[j] - z;\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n    fx += dx * inv_dist3;\n    fy += dy * inv_dist3;\n    fz += dz * inv_dist3;\n  }\n\n  const float vx = p[i].vx + dt*fx;\n  const float vy = p[i].vy + dt*fy;\n  const float vz = p[i].vz + dt*fz;\n  const float nx = x + vx*dt;\n  const float ny = y + vy*dt;\n  const float nz = z + vz*dt;\n  next[i].vx = vx;\n  next[i].vy = vy;\n  next[i].vz = vz;\n  next[i].x = nx;\n  next[i].y = ny;\n  next[i].z = nz;\n  destination.x[i] = nx;\n  destination.y[i] = ny;\n  destination.z[i] = nz;\n}\n\n/* Four targets share source loads while every force sum stays ordered. */\nstatic inline void advance_four(const Body *restrict p,\n                                Body *restrict next,\n                                const Coordinates source,\n                                Coordinates destination,\n                                float dt, int n, int i) {\n  float fx[4] = {0.0f};\n  float fy[4] = {0.0f};\n  float fz[4] = {0.0f};\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n  const float32x4_t xv = vld1q_f32(source.x + i);\n  const float32x4_t yv = vld1q_f32(source.y + i);\n  const float32x4_t zv = vld1q_f32(source.z + i);\n  float32x4_t fxv = vdupq_n_f32(0.0f);\n  float32x4_t fyv = vdupq_n_f32(0.0f);\n  float32x4_t fzv = vdupq_n_f32(0.0f);\n  const int source_end = n - n % 4;\n  int j = 0;\n\n  for (; j < source_end; j += 4) {\n    const float32x4_t sx = vld1q_f32(source.x + j);\n    const float32x4_t sy = vld1q_f32(source.y + j);\n    const float32x4_t sz = vld1q_f32(source.z + j);\n    const NBodyDelta4 d0 = nbody_delta4(vdupq_laneq_f32(sx, 0),\n                                       vdupq_laneq_f32(sy, 0),\n                                       vdupq_laneq_f32(sz, 0), xv, yv, zv);\n    const NBodyDelta4 d1 = nbody_delta4(vdupq_laneq_f32(sx, 1),\n                                       vdupq_laneq_f32(sy, 1),\n                                       vdupq_laneq_f32(sz, 1), xv, yv, zv);\n    const NBodyDelta4 d2 = nbody_delta4(vdupq_laneq_f32(sx, 2),\n                                       vdupq_laneq_f32(sy, 2),\n                                       vdupq_laneq_f32(sz, 2), xv, yv, zv);\n    const NBodyDelta4 d3 = nbody_delta4(vdupq_laneq_f32(sx, 3),\n                                       vdupq_laneq_f32(sy, 3),\n                                       vdupq_laneq_f32(sz, 3), xv, yv, zv);\n    const float32x4_t inv0 = inverse_distance4(d0.sqrd_dist);\n    const float32x4_t inv1 = inverse_distance4(d1.sqrd_dist);\n    const float32x4_t inv2 = inverse_distance4(d2.sqrd_dist);\n    const float32x4_t inv3 = inverse_distance4(d3.sqrd_dist);\n\n    /* Batch independent distances without reassociating force additions. */\n    nbody_accumulate4(d0, inv0, &fxv, &fyv, &fzv);\n    nbody_accumulate4(d1, inv1, &fxv, &fyv, &fzv);\n    nbody_accumulate4(d2, inv2, &fxv, &fyv, &fzv);\n    nbody_accumulate4(d3, inv3, &fxv, &fyv, &fzv);\n  }\n\n  for (; j < n; ++j) {\n    const NBodyDelta4 d = nbody_delta4(vdupq_n_f32(source.x[j]),\n                                      vdupq_n_f32(source.y[j]),\n                                      vdupq_n_f32(source.z[j]), xv, yv, zv);\n    const float32x4_t inv = inverse_distance4(d.sqrd_dist);\n    nbody_accumulate4(d, inv, &fxv, &fyv, &fzv);\n  }\n\n  vst1q_f32(fx, fxv);\n  vst1q_f32(fy, fyv);\n  vst1q_f32(fz, fzv);\n#else\n  const float x[4] = {source.x[i], source.x[i+1],\n                      source.x[i+2], source.x[i+3]};\n  const float y[4] = {source.y[i], source.y[i+1],\n                      source.y[i+2], source.y[i+3]};\n  const float z[4] = {source.z[i], source.z[i+1],\n                      source.z[i+2], source.z[i+3]};\n\n  for (int j = 0; j < n; ++j) {\n    const float xj = source.x[j];\n    const float yj = source.y[j];\n    const float zj = source.z[j];\n\n    #pragma omp simd\n    for (int lane = 0; lane < 4; ++lane) {\n      float dx = xj - x[lane];\n      float dy = yj - y[lane];\n      float dz = zj - z[lane];\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n      fx[lane] += dx * inv_dist3;\n      fy[lane] += dy * inv_dist3;\n      fz[lane] += dz * inv_dist3;\n    }\n  }\n#endif\n\n  for (int lane = 0; lane < 4; ++lane) {\n    const int k = i + lane;\n    const float vx = p[k].vx + dt*fx[lane];\n    const float vy = p[k].vy + dt*fy[lane];\n    const float vz = p[k].vz + dt*fz[lane];\n    const float nx = source.x[k] + vx*dt;\n    const float ny = source.y[k] + vy*dt;\n    const float nz = source.z[k] + vz*dt;\n    next[k].vx = vx;\n    next[k].vy = vy;\n    next[k].vz = vz;\n    next[k].x = nx;\n    next[k].y = ny;\n    next[k].z = nz;\n    destination.x[k] = nx;\n    destination.y[k] = ny;\n    destination.z[k] = nz;\n  }\n}\n\nstatic void simulate(Body *p, float dt, int n) {\n  if (n <= 0) return;\n\n  const size_t count = (size_t)n;\n  const size_t stride = (count + 15u) & ~(size_t)15u;\n  Body *scratch = (Body *)malloc(count * sizeof(Body));\n  void *storage = NULL;\n  if (scratch != NULL && stride <= (SIZE_MAX - 63u) / (6u * sizeof(float))) {\n    storage = malloc(6u * stride * sizeof(float) + 63u);\n  }\n\n  if (scratch == NULL || storage == NULL) {\n    free(storage);\n    free(scratch);\n    for (int iter = 0; iter < N_ITER; ++iter) {\n      body_force(p, dt, n);\n      for (int i = 0; i < n; ++i) {\n        p[i].x += p[i].vx * dt;\n        p[i].y += p[i].vy * dt;\n        p[i].z += p[i].vz * dt;\n      }\n    }\n    return;\n  }\n\n  float *packed = (float *)(((uintptr_t)storage + 63u) & ~(uintptr_t)63u);\n  const Coordinates initial = {packed, packed + stride, packed + 2u*stride};\n  const Coordinates spare = {packed + 3u*stride, packed + 4u*stride,\n                              packed + 5u*stride};\n  const int nfull = n / 4;\n  const int nblocks = nfull + (n % 4 != 0);\n\n  #pragma omp parallel if(n >= 128)\n  {\n    Body *current = p;\n    Body *next = scratch;\n    Coordinates source = initial;\n    Coordinates destination = spare;\n\n    #pragma omp for schedule(static)\n    for (int i = 0; i < n; ++i) {\n      source.x[i] = p[i].x;\n      source.y[i] = p[i].y;\n      source.z[i] = p[i].z;\n    }\n\n    for (int iter = 0; iter < N_ITER; ++iter) {\n      #pragma omp for schedule(static)\n      for (int block = 0; block < nblocks; ++block) {\n        const int start = block * 4;\n        if (block < nfull) {\n          advance_four(current, next, source, destination, dt, n, start);\n        } else {\n          for (int i = start; i < n; ++i) {\n            advance_one(current, next, source, destination, dt, n, i);\n          }\n        }\n      }\n\n      /* The barrier completes both next buffers before their next use. */\n      Body *body_swap = current;\n      current = next;\n      next = body_swap;\n      Coordinates coordinate_swap = source;\n      source = destination;\n      destination = coordinate_swap;\n    }\n  }\n\n  if (N_ITER % 2 != 0) {\n    memcpy(p, scratch, count * sizeof(Body));\n  }\n  free(storage);\n  free(scratch);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n  Body *bodies = read_dataset(&nbodies);\n  simulate(bodies, DT, nbodies);\n  write_dataset(nbodies, bodies);\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Aligned coordinate snapshots combined with four-source-batched, four-target NEON should reduce source-load traffic and expose sqrt/division overlap while preserving ordered force sums and persistent-team savings.",
  "notes": "Coefficient caching and 128-source staging are not retained. Scalar tails, portable execution and allocation-failure fallback remain. No commands were executed; correctness and speed require controller evaluation.",

        "depth": 1,
        "epoch": 1,
        "hypothesis": "Row-private batches permit coarse work sharing without synchronized result appends. Deterministic Miller–Rabin should reduce task cost, while a serial cutoff avoids thread-team overhead on small workloads.",
        "id": "e21dff293039418d",
        "ordinal": 1,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/model-view/primetest.c",
            "src/sources/primetest.c"
          ],
          "retained": [
            "Use private concatenation scratch and separate output buffers/counts for each Cartesian row, followed by deterministic serial compaction.",
            "Guard dynamic OpenMP row scheduling behind _OPENMP and a 256-pair threshold; otherwise execute serially.",
            "Replace floating-point trial division with small-prime filtering and deterministic Miller–Rabin bases 2,7,61, using uint64_t products for 32-bit candidates and exact trial division above that range.",
            "Retain every Cartesian pair, duplicate occurrences, ascending sorting and decimal output in both source copies."
          ]
        },

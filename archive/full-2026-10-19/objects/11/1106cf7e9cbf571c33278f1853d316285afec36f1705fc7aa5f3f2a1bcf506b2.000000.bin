      "content": "#include <algorithm>\n#include <atomic>\n#include <iostream>\n#include <memory>\n#include <vector>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nstruct alignas(64) Progress {\n    atomic<int> rows;\n    Progress() : rows(0) {}\n};\n\nstatic inline int update_row(int* dp, int begin, int width,\n                             const vector<int>& blocked, int left) {\n    int x = 0;\n    auto obstacle = lower_bound(blocked.begin(), blocked.end(), begin);\n    while (obstacle != blocked.end() && *obstacle - begin < width) {\n        const int stop = *obstacle - begin;\n        for (; x < stop; ++x) {\n            int value = dp[x] + left;\n            if (value >= MOD) value -= MOD;\n            dp[x] = left = value;\n        }\n        dp[x] = 0;\n        left = 0;\n        ++x;\n        ++obstacle;\n    }\n    for (; x < width; ++x) {\n        int value = dp[x] + left;\n        if (value >= MOD) value -= MOD;\n        dp[x] = left = value;\n    }\n    return left;\n}\n\nint main() {\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n    vector<vector<int>> blocked(n);\n    for (int c = 0; c < m; ++c) {\n        int i, j;\n        cin >> i >> j;\n        blocked[i].push_back(j);\n    }\n    for (auto& row : blocked) {\n        sort(row.begin(), row.end());\n        row.erase(unique(row.begin(), row.end()), row.end());\n    }\n\n    int requested = 1;\n#ifdef _OPENMP\n    if (n >= 512)\n        requested = min(4, omp_get_max_threads());\n#endif\n    if (requested == 1) {\n        vector<int> dp(n, 0);\n        dp[0] = 1;\n        for (int i = 0; i < n; ++i)\n            update_row(dp.data(), 0, n, blocked[i], 0);\n        cout << dp[n - 1] << endl;\n        return 0;\n    }\n\n    vector<int> boundary(static_cast<size_t>(requested - 1) * n);\n    unique_ptr<Progress[]> progress(new Progress[requested]);\n    int result = 0;\n#pragma omp parallel num_threads(requested)\n    {\n        int tid = 0;\n        int team = 1;\n#ifdef _OPENMP\n        tid = omp_get_thread_num();\n        team = omp_get_num_threads();\n#endif\n        const int begin = static_cast<int>(static_cast<long long>(n) * tid / team);\n        const int end = static_cast<int>(static_cast<long long>(n) * (tid + 1) / team);\n        const int width = end - begin;\n        vector<int> dp(width, 0);\n        if (tid == 0) dp[0] = 1;\n        const int batchSize = 64;\n        for (int first = 0; first < n; first += batchSize) {\n            const int last = min(n, first + batchSize);\n            if (tid != 0) {\n                while (progress[tid - 1].rows.load(memory_order_acquire) < last) {\n                }\n            }\n            for (int i = first; i < last; ++i) {\n                const int incoming = tid == 0 ? 0 : boundary[static_cast<size_t>(tid - 1) * n + i];\n                const int outgoing = update_row(dp.data(), begin, width, blocked[i], incoming);\n                if (tid + 1 < team)\n                    boundary[static_cast<size_t>(tid) * n + i] = outgoing;\n            }\n            if (tid + 1 < team)\n                progress[tid].rows.store(last, memory_order_release);\n        }\n        if (tid + 1 == team) result = dp.back();\n    }\n    cout << result << endl;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Combining the archived stripe pipeline with sparse obstacle runs may reduce obstacle-access and allocation costs while preserving its parallel scheduling advantage.",
  "notes": "One integration ablation: pipeline plus sparse obstacles, without SIMD or tiled scheduling. Incoming stripe carries are preserved until an obstacle resets them. No commands or measurements were executed.",

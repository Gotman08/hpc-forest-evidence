    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <iostream>\\n#include <vector>\\n#include <cstdio>\\n#include <cassert>\\n\\nint main() {\\n\\tint n, s;\\n\\tstd::cin >> n >> s;\\n\\tassert(s > 0 && s < n && n < 8000);\\n\\n\\t// Flatten matrix into a contiguous 1D array for spatial locality\\n\\tstd::vector<int> mat(n * n);\\n\\tfor (int i = 0; i < n; ++i)\\n\\t\\tfor (int j = 0; j < n; ++j)\\n\\t\\t\\tscanf(\\\"%d\\\", &mat[i * n + j]);\\n\\n\\t// Build integral image using two passes for sequential memory access.\\n\\t// Pass 1: horizontal prefix sums per row, stored in H (size n x (n+1))\\n\\tstd::vector<long long> H(n * (n + 1), 0);\\n\\tfor (int i = 0; i < n; ++i) {\\n\\t\\tlong long row_sum = 0;\\n\\t\\tint base = i * (n + 1);\\n\\t\\tH[base] = 0;\\n\\t\\tfor (int j = 0; j < n; ++j) {\\n\\t\\t\\trow_sum += mat[i * n + j];\\n\\t\\t\\tH[base + j + 1] = row_sum;\\n\\t\\t}\\n\\t}\\n\\n\\t// Pass 2: vertical accumulation into integral image II (size (n+1)x(n+1))\\n\\tstd::vector<long long> II((n + 1) * (n + 1), 0);\\n\\tfor (int i = 1; i <= n; ++i) {\\n\\t\\tconst long long* prev_row = &II[(i - 1) * (n + 1)];\\n\\t\\tlong long* curr_row = &II[i * (n + 1)];\\n\\t\\tconst long long* hrow = &H[(i - 1) * (n + 1)];\\n\\t\\tcurr_row[0] = 0;\\n\\t\\tfor (int j = 1; j <= n; ++j)\\n\\t\\t\\tcurr_row[j] = prev_row[j] + hrow[j];\\n\\t}\\n\\n\\t// Search for maximum SxS submatrix sum using integral image.\\n\\t// Straightforward double loop over rows then columns to maximize spatial locality:\\n\\t// inner loop accesses consecutive elements within each row of II.\\n\\tint mxSum = -2147483648;\\n\\tfor (int i = 0; i <= n - s; ++i) {\\n\\t\\tconst long long* row_i   = &II[i * (n + 1)];\\n\\t\\tconst long long* row_is = &II[(i + s) * (n + 1)];\\n\\t\\tfor (int j = 0; j <= n - s; ++j) {\\n\\t\\t\\tlong long sub_sum = row_is[j + s] - row_i[j + s] - row_is[j] + row_i[j];\\n\\t\\t\\tif (sub_sum > mxSum)\\n\\t\\t\\t\\tmxSum = static_cast<int>(sub_sum);\\n\\t\\
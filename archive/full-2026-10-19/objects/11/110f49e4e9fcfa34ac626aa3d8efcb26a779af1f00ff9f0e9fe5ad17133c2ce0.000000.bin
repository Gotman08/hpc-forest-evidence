{
  "src/graph.c": "#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n#include<stdint.h>\n#ifdef _OPENMP\n#include<omp.h>\n#endif\n\n#define MAX 100\n\ntypedef struct {\n  int id;\n  float value;\n  char neighbors[MAX];\n} Node;\n\nNode* read_input(char* fname, int *n, char* list) {\n  Node* data = NULL;\n  FILE *fl = fname == NULL ? stdin : fopen(fname, \"r\");\n\n  if (fl == NULL) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n\n  fscanf(fl, \"%d %[^\\n]\", n, list);\n\n  if (*n > 0) {\n    data = (Node*) malloc((size_t)*n * sizeof(Node));\n    if (data == NULL) {\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }\n  }\n\n  for (int i = 0; i < *n; i++)\n    fscanf(fl, \"%d %f %[^\\n]\", &data[i].id, &data[i].value,\n           data[i].neighbors);\n\n  fclose(fl);\n  return data;\n}\n\nint find_by_id(Node g[], int id, int size) {\n  int i = 0;\n  while (i < size && g[i].id != id)\n    i++;\n  return i < size ? i : -1;\n}\n\n/* Retained as the allocation-failure fallback. */\nfloat get_costly(Node *g, int id, int size) {\n  int idmax = -1;\n  float max = 0;\n  int nd = find_by_id(g, id, size);\n  if (nd < 0)\n    return max;\n\n  char aux[MAX];\n  char *auxptr;\n  strcpy(aux, g[nd].neighbors);\n  char *t = strtok_r(aux, \" \", &auxptr);\n  while (t != NULL) {\n    int d = find_by_id(g, atoi(t), size);\n    if (d >= 0 && max < g[d].value) {\n      max = g[d].value;\n      idmax = atoi(t);\n    }\n    t = strtok_r(NULL, \" \", &auxptr);\n  }\n\n  float r = g[nd].value;\n  if (idmax != -1)\n    r += get_costly(g, idmax, size);\n  return r;\n}\n\ntypedef struct {\n  int *slots;\n  size_t mask;\n} IdIndex;\n\nstatic size_t hash_id(int id) {\n  uint32_t x = (uint32_t)id;\n  x ^= x >> 16;\n  x *= 0x7feb352dU;\n  x ^= x >> 15;\n  x *= 0x846ca68bU;\n  x ^= x >> 16;\n  return (size_t)x;\n}\n\n/* Insertion order preserves find_by_id's first-occurrence rule. */\nstatic int build_index(const Node *g, int n, IdIndex *index) {\n  size_t capacity = 1;\n  while (capacity < (size_t)n * 2)\n    capacity <<= 1;\n\n  index->slots = (int*) malloc(capacity * sizeof(int));\n  if (index->slots == NULL)\n    return 0;\n  index->mask = capacity - 1;\n\n  for (size_t i = 0; i < capacity; i++)\n    index->slots[i] = -1;\n\n  for (int i = 0; i < n; i++) {\n    size_t p = hash_id(g[i].id) & index->mask;\n    while (index->slots[p] >= 0 &&\n           g[index->slots[p]].id != g[i].id)\n      p = (p + 1) & index->mask;\n    if (index->slots[p] < 0)\n      index->slots[p] = i;\n  }\n  return 1;\n}\n\nstatic int indexed_find(const Node *g, const IdIndex *index, int id) {\n  size_t p = hash_id(id) & index->mask;\n  while (index->slots[p] >= 0) {\n    int i = index->slots[p];\n    if (g[i].id == id)\n      return i;\n    p = (p + 1) & index->mask;\n  }\n  return -1;\n}\n\nstatic int choose_successor(const Node *g, const IdIndex *index, int i) {\n  char aux[MAX];\n  char *save = NULL;\n  float max = 0;\n  int next = -1;\n\n  strcpy(aux, g[i].neighbors);\n  for (char *t = strtok_r(aux, \" \", &save); t != NULL;\n       t = strtok_r(NULL, \" \", &save)) {\n    int id = atoi(t);\n    int d = indexed_find(g, index, id);\n    if (d >= 0 && max < g[d].value) {\n      max = g[d].value;\n      /* A winning ID of -1 still terminates the original traversal. */\n      next = id == -1 ? -1 : d;\n    }\n  }\n  return next;\n}\n\nstatic void prepare_successors(const Node *g, const IdIndex *index,\n                               int n, int *successor) {\n#ifdef _OPENMP\n  int workers = omp_get_max_threads();\n  if (workers > 4)\n    workers = 4;\n  if (n >= 4096 && workers > 1) {\n#pragma omp parallel for schedule(static) num_threads(workers)\n    for (int i = 0; i < n; i++)\n      successor[i] = choose_successor(g, index, i);\n    return;\n  }\n#endif\n  for (int i = 0; i < n; i++)\n    successor[i] = choose_successor(g, index, i);\n}\n\n/* Only this serial stage publishes cached sums. Each addition retains\n   the recursive computation's leaf-to-root float evaluation order. */\nstatic float cached_cost(const Node *g, const int *successor, float *cost,\n                         unsigned char *ready, int *path, int root) {\n  if (root < 0)\n    return 0.0f;\n\n  int current = root;\n  int depth = 0;\n  while (current >= 0 && !ready[current]) {\n    path[depth++] = current;\n    current = successor[current];\n  }\n\n  while (depth > 0) {\n    int i = path[--depth];\n    float r = g[i].value;\n    if (successor[i] >= 0)\n      r += cost[successor[i]];\n    cost[i] = r;\n    ready[i] = 1;\n  }\n  return cost[root];\n}\n\nint main() {\n  char computelist[MAX];\n  int n = -1;\n  Node *input = read_input(NULL, &n, computelist);\n  IdIndex index = {NULL, 0};\n  int *successor = NULL;\n  int *path = NULL;\n  float *cost = NULL;\n  unsigned char *ready = NULL;\n  int use_cache = 0;\n\n  if (n > 0 && build_index(input, n, &index)) {\n    successor = (int*) malloc((size_t)n * sizeof(int));\n    path = (int*) malloc((size_t)n * sizeof(int));\n    cost = (float*) malloc((size_t)n * sizeof(float));\n    ready = (unsigned char*) calloc((size_t)n, sizeof(unsigned char));\n    use_cache = successor != NULL && path != NULL &&\n                cost != NULL && ready != NULL;\n  }\n\n  if (use_cache) {\n    prepare_successors(input, &index, n, successor);\n  } else {\n    free(successor);\n    free(path);\n    free(cost);\n    free(ready);\n    free(index.slots);\n    successor = NULL;\n    path = NULL;\n    cost = NULL;\n    ready = NULL;\n    index.slots = NULL;\n  }\n\n  for (char *c = strtok(computelist, \" \"); c != NULL;\n       c = strtok(NULL, \" \")) {\n    float result;\n    if (use_cache) {\n      int root = indexed_find(input, &index, atoi(c));\n      result = cached_cost(input, successor, cost, ready, path, root);\n    } else {\n      result = get_costly(input, atoi(c), n);\n    }\n    printf(\"%s: %f\\n\", c, result);\n  }\n\n  free(ready);\n  free(cost);\n  free(path);\n  free(successor);\n  free(index.slots);\n  free(input);\n  return 0;\n}\n"
}

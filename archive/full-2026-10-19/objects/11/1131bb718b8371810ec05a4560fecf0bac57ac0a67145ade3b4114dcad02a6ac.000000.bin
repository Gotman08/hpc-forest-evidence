"""Data-only source110 Q proposal. Never execute a wrapper, scheduler or native code."""
import gzip
import hashlib
import io
import json
import tarfile
import xml.etree.ElementTree as ET
import zipfile
from pathlib import Path

OUT = Path(__file__).resolve().parent
BASE = OUT.parents[2]
SOURCE = OUT.parent / "revision-source-cli-r1"
PROJECT = BASE / "work/hpc-forest-mere-dynamique-r4b-lane-r3/project"
HIST = BASE / "outputs/HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r2/qualification-lane-r2-zero-model"
OLD = BASE / "outputs/HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r2/revision-source-r4b/revision-r2"


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def ref(path):
    return {"path": str(path), "sha256": sha(path)}


def save(path, value):
    with path.open("x", encoding="utf8", newline="\n") as stream:
        json.dump(value, stream, indent=2, ensure_ascii=False)
        stream.write("\n")


delivery_path = SOURCE / "LIVRAISON-SOURCE110-CANDIDATE-POUR-REVUE.json"
assert sha(delivery_path) == "f61d7cd7ec33c821cccd64713f1b2bdacf3e0eb95c8b98d455a9446ff101250f"
delivery = json.loads(delivery_path.read_text("utf8"))
runtime_path = Path(delivery["runtime_manifest"]["path"])
runtime = json.loads(runtime_path.read_text("utf8"))
assert len(runtime) == 110 and {p.relative_to(PROJECT).as_posix(): sha(p) for p in PROJECT.rglob("*") if p.is_file()} == runtime
assert delivery["source_zip_sha256"] == "eaff9217499fe268e4d151165a368a83bad1550d921955a9f9256026cfac2d48"
assert delivery["plan_sha256"] == "d08ac00bcfb75625a24971b2684d7479c4da7a98b339e4e10eae5b9ac525ef27"
with zipfile.ZipFile(Path(delivery["source_zip"]["path"])) as archive:
    assert len(archive.infolist()) == 110
    assert all(hashlib.sha256(archive.read("HPC-Forest/" + name)).hexdigest() == checksum for name, checksum in runtime.items())
old_zip, old_plan = OLD / "HPC-Forest-Mere-Dynamique-R4b-MAX.zip", OLD / "dynamic-plan-r4b-max.json"
assert sha(old_zip) == "ede293f185e663241c01c22a5fa9edcd54ad66af6a1e0964755eac306c5de0f3"
assert sha(old_plan) == "9f04e93c1a28c70f444005b7670ff23731cac838846b99cb1b6742db9e8de33b"
members = {"project/" + name: PROJECT / name for name in runtime}
members.update({"project.zip": Path(delivery["source_zip"]["path"]), "dynamic-plan.json": Path(delivery["plan"]["path"]),
    "runtime-manifest.json": runtime_path, "DESIGN-INTERFACE.json": SOURCE / "DESIGN-INTERFACE.json",
    "predecessor/project.zip": old_zip, "predecessor/plan.json": old_plan})
assert len(members) == 116
bundle = OUT / "source110-neutral-data.tar.gz"
with bundle.open("xb") as raw_stream, gzip.GzipFile(filename="", fileobj=raw_stream, mode="wb", mtime=0) as gzip_stream:
    with tarfile.open(fileobj=gzip_stream, mode="w") as archive:
        for name, path in sorted(members.items()):
            data = path.read_bytes()
            member = tarfile.TarInfo(name)
            member.size, member.mode, member.mtime = len(data), 0o644, 0
            archive.addfile(member, io.BytesIO(data))
bundle_manifest = {name: {"sha256": sha(path), "bytes": path.stat().st_size} for name, path in sorted(members.items())}
save(OUT / "source-bundle-manifest.json", bundle_manifest)
cases = {}
for name in ("tests-premier-passage.xml", "tests-raccords.xml", "tests-ARM-paths.xml", "tests-privacy.xml"):
    for case in ET.parse(SOURCE / name).iter("testcase"):
        cases[(case.get("classname"), case.get("name"))] = case.find("failure") is None and case.find("error") is None
assert len(cases) == 187 and all(cases.values())
suite_counts = {}
for (classname, _), passed in cases.items():
    filename = classname.split(".")[-1] + ".py"
    suite_counts[filename] = suite_counts.get(filename, 0) + 1
selected = {"test_r4b_privacy.py": ["test_max_identity_requires_receipt_and_never_installs_default_generation",
    "test_false_admission_and_generic_native_request_are_refused", "test_cli_verifier_checks_actual_argument_and_all_companion_bytes",
    "test_first_start_receiving_flag_never_overrides_missing_verification", "test_contract_session_must_be_the_exact_declared_phase_cell"]}
assert len(suite_counts) == 6 and sum(suite_counts.values()) == 187
save(OUT / "TESTS-NEUTRES-187-EXACTS.json", {"schema": "hpc-forest-r4b-source110-exact-inert-Q-suite-proposal-v1",
    "prepared_only": True, "suite_counts": suite_counts, "select_functions_only": selected,
    "suite_sha256": {name: runtime["tests/" + name] for name in suite_counts},
    "allocated_execution_count": 0, "source_local_observations": [ref(SOURCE / name) for name in
        ("tests-premier-passage.xml", "tests-raccords.xml", "tests-ARM-paths.xml", "tests-privacy.xml")],
    "required_import_setup": "Existing allocated Python -I -B; trusted packet runner inserts exact extraction/source/project/src before importing pytest and verifies hpc_forest.__file__. Test fixture/output dirs outside sealed project; no cacheprovider/pyc.",
    "never_run_full_historical_tests_implicitly": True,
    "explicit_inert_scope": "142 new parser/policy/holds/watchdog/gate +36 unchanged lane-v2 +9 pure privacy predicates; every process/timer effect is a double",
    "native_model_calls": 0, "compiler_or_C_execution": 0, "CLI_or_auth_or_transport_execution": 0})
root = "/scratch_p/nimarano/hpc-forest-r4b-lane-r3-zero-model-20261018-eaff9217499f-" + sha(bundle)[:12]
history = {name: ref(HIST / name) for name in ("qualification-wrapper.py", "bootstrap-alloue.py", "commande-allouee-zero-modele.sh", "bindings.json")}
proposal = {"schema": "hpc-forest-r4b-lane-r3-exact-Q-preparation-not-admitted-v1", "status": "NON_LANCE_NON_ADMIS",
    "prepared_only": True, "verified": False, "native_generation_admitted": False,
    "scope_id": "hpc-forest-dynamic-independent-roots-r4b-max", "source_delivery": ref(delivery_path),
    "source_zip": delivery["source_zip"], "source_zip_sha256": delivery["source_zip_sha256"],
    "plan": delivery["plan"], "plan_sha256": delivery["plan_sha256"], "runtime_manifest": ref(runtime_path),
    "source_member_count": 110, "source_bundle": ref(bundle), "source_bundle_manifest": ref(OUT / "source-bundle-manifest.json"),
    "source_bundle_member_count": 116, "inert_suite": ref(OUT / "TESTS-NEUTRES-187-EXACTS.json"),
    "source_review": {"status": "EN_ATTENTE", "receipt": None},
    "new_adapter_components": {"status": "NON_PREPARES_NON_ADMIS", "receipt": None},
    "historical_workflow_read_only": history,
    "historical_adapters_or_Q_promoted_for_source110": False,
    "proposed_remote_root": root, "proposed_remote_source_bundle": root + "-source.tar.gz",
    "proposed_allocation": {"nodes": 1, "ntasks": 1, "cpus_per_task": 4, "mem_mb": 16384,
        "gpus": 0, "architecture": "aarch64", "walltime": "00:10:00", "maximum_walltime_seconds": 600},
    "audit_reserve_seconds": 10800, "exclusive_deadline_utc": "2026-10-31T23:00:00Z",
    "recheck_maximum_plus_audit_strictly_before_deadline_after_queue": True,
    "required_before_operational_render": [
        "Independent fresh source110/plan exact review received, no blocking finding",
        "New source110 external adapter COMPONENTS and review; never relax source105 equality",
        "Exact wrapper/bootstrap/packet and strict safe extraction plus allocation guard reviewed",
        "Only existing allocated Python/dependencies, no install/login/candidate/CLI/model",
        "New allocated exact187 inert-suite receipt and adapter-suite receipt",
        "Target/reference qualification explicitly linked or requalified as required, never inferred from this source-only packet",
        "Archive announced/remote/local triple SHA, fresh restore, read-only inventory before/after and independent received audit"],
    "source_only_packet_is_not_a_complete_R4b_admission": True,
    "no_source105_Q752546_Q752563_or_G_Q753463_promoted": True,
    "job_prepared": False, "job_submitted": False, "native_model_calls": 0,
    "compiler_CLI_auth_transport_or_process_observation_executed": 0,
    "scientific_or_performance_verified": False}
save(OUT / "PREPARATION-QUALIFICATION-NON-ADMISE.json", proposal)
blocked = {"schema": "hpc-forest-r4b-lane-r3-scheduler-proposal-blocked-v1", "ready": False,
    "status": "NON_ADMIS_DO_NOT_JOB_PREPARE", "proposal": ref(OUT / "PREPARATION-QUALIFICATION-NON-ADMISE.json"),
    "reason": "Independent source review and newly bound external adapter/component qualification are not received; no operational wrapper or job args are manufactured.",
    "job_prepare_executed": False, "native_research_admitted": False}
save(OUT / "JOB-PREPARE-BLOQUE.json", blocked)
assert {p.relative_to(PROJECT).as_posix(): sha(p) for p in PROJECT.rglob("*") if p.is_file()} == runtime
print(json.dumps({"proposal": ref(OUT / "PREPARATION-QUALIFICATION-NON-ADMISE.json"),
    "source_bundle": ref(bundle), "tests": suite_counts, "prepared_only": True, "ready": False}))

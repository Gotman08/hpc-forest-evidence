{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\ntypedef struct { float x, y, z; } Position;\n\nenum { FORCE_TILE = 4 };\n\nstatic void body_force_scalar(Body *p, float dt, int n, int begin) {\n  for (int i = begin; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n#if defined(__GNUC__) && !defined(__clang__)\n#define TILE_MATH __attribute__((optimize(\"no-math-errno\")))\n#else\n#define TILE_MATH\n#endif\n\n/* SIMD lanes represent independent targets, not partial reductions. */\nstatic TILE_MATH void body_force_tile(Body *restrict p,\n                                      const Position *restrict positions,\n                                      float dt, int n, int first) {\n  float x[FORCE_TILE], y[FORCE_TILE], z[FORCE_TILE];\n  float fx[FORCE_TILE] = {0.0f};\n  float fy[FORCE_TILE] = {0.0f};\n  float fz[FORCE_TILE] = {0.0f};\n\n  for (int lane = 0; lane < FORCE_TILE; ++lane) {\n    x[lane] = positions[first + lane].x;\n    y[lane] = positions[first + lane].y;\n    z[lane] = positions[first + lane].z;\n  }\n\n  for (int j = 0; j < n; ++j) {\n    const float sx = positions[j].x;\n    const float sy = positions[j].y;\n    const float sz = positions[j].z;\n\n    #pragma omp simd\n    for (int lane = 0; lane < FORCE_TILE; ++lane) {\n      float dx = sx - x[lane];\n      float dy = sy - y[lane];\n      float dz = sz - z[lane];\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx[lane] += dx * inv_dist3;\n      fy[lane] += dy * inv_dist3;\n      fz[lane] += dz * inv_dist3;\n    }\n  }\n\n  for (int lane = 0; lane < FORCE_TILE; ++lane) {\n    p[first + lane].vx += dt*fx[lane];\n    p[first + lane].vy += dt*fy[lane];\n    p[first + lane].vz += dt*fz[lane];\n  }\n}\n\n#undef TILE_MATH\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system, reusing each compact source position across four targets.\n */\nvoid body_force(Body *p, float dt, int n) {\n  if (n < FORCE_TILE) {\n    body_force_scalar(p, dt, n, 0);\n    return;\n  }\n\n  Position *positions = (Position *)malloc((size_t)n * sizeof(*positions));\n  if (positions == NULL) {\n    body_force_scalar(p, dt, n, 0);\n    return;\n  }\n\n  for (int i = 0; i < n; ++i) {\n    positions[i].x = p[i].x;\n    positions[i].y = p[i].y;\n    positions[i].z = p[i].z;\n  }\n\n  const int ntiles = n / FORCE_TILE;\n  #pragma omp parallel for schedule(static) if(ntiles > 1)\n  for (int tile = 0; tile < ntiles; ++tile) {\n    body_force_tile(p, positions, dt, n, tile * FORCE_TILE);\n  }\n\n  body_force_scalar(p, dt, n, ntiles * FORCE_TILE);\n  free(positions);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Four-target source-major microtiles over compact position snapshots should reduce source traffic and expose independent SIMD lanes with less register pressure than wider tiles, while static OpenMP scheduling distributes independent tiles.",
  "notes": "Preserves ascending source accumulation, original arithmetic expressions, double-precision sqrt/reciprocal, binary I/O, and position integration. No fast-math or reciprocal approximations; correctness and speed remain for controller evaluation.",

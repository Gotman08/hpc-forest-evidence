      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <memory>\n\nclass FastInput {\n    static constexpr std::size_t capacity = 1u << 16;\n    unsigned char buffer_[capacity];\n    std::size_t position_ = 0;\n    std::size_t available_ = 0;\n\n    int read_char() {\n        if (position_ == available_) {\n            available_ = std::fread(buffer_, 1, capacity, stdin);\n            position_ = 0;\n            if (available_ == 0) {\n                return EOF;\n            }\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    int next_int() {\n        int c = read_char();\n        while (c != EOF && c <= ' ') {\n            c = read_char();\n        }\n        const bool negative = c == '-';\n        if (c == '-' || c == '+') {\n            c = read_char();\n        }\n        std::uint32_t magnitude = 0;\n        while (c >= '0' && c <= '9') {\n            magnitude = magnitude * 10u + static_cast<std::uint32_t>(c - '0');\n            c = read_char();\n        }\n        const std::int64_t value = static_cast<std::int64_t>(magnitude);\n        return static_cast<int>(negative ? -value : value);\n    }\n};\n\nstatic inline void add_row(std::int64_t* __restrict__ columns,\n                           const int* __restrict__ row, int n) {\n    for (int j = 0; j < n; ++j) {\n        columns[j] += row[j];\n    }\n}\n\nstatic inline void advance_row(std::int64_t* __restrict__ columns,\n                               const int* __restrict__ incoming,\n                               int* __restrict__ outgoing,\n                               int n, bool retain_incoming) {\n    if (retain_incoming) {\n        for (int j = 0; j < n; ++j) {\n            const int value = incoming[j];\n            columns[j] += static_cast<std::int64_t>(value) - outgoing[j];\n            outgoing[j] = value;\n        }\n    } else {\n        for (int j = 0; j < n; ++j) {\n            columns[j] += static_cast<std::int64_t>(incoming[j]) - outgoing[j];\n        }\n    }\n}\n\nstatic inline std::int64_t horizontal_max(const std::int64_t* columns,\n                                          int n, int s) {\n    std::int64_t sum = 0;\n    for (int j = 0; j < s; ++j) {\n        sum += columns[j];\n    }\n    std::int64_t best = sum;\n    constexpr int block = 32;\n    int j = s;\n\n    // Scan neighboring blocks independently, then join their prefix summaries.\n    for (; j + 4 * block <= n; j += 4 * block) {\n        const std::int64_t* entering = columns + j;\n        const std::int64_t* leaving = columns + j - s;\n        std::int64_t prefix0 = 0;\n        std::int64_t prefix1 = 0;\n        std::int64_t prefix2 = 0;\n        std::int64_t prefix3 = 0;\n        std::int64_t max0 = 0;\n        std::int64_t max1 = 0;\n        std::int64_t max2 = 0;\n        std::int64_t max3 = 0;\n\n        for (int k = 0; k < block; ++k) {\n            prefix0 += entering[k] - leaving[k];\n            prefix1 += entering[block + k] - leaving[block + k];\n            prefix2 += entering[2 * block + k] - leaving[2 * block + k];\n            prefix3 += entering[3 * block + k] - leaving[3 * block + k];\n            max0 = std::max(max0, prefix0);\n            max1 = std::max(max1, prefix1);\n            max2 = std::max(max2, prefix2);\n            max3 = std::max(max3, prefix3);\n        }\n\n        const std::int64_t offset2 = prefix0 + prefix1;\n        const std::int64_t offset3 = offset2 + prefix2;\n        const std::int64_t block_best = std::max(\n            std::max(max0, prefix0 + max1),\n            std::max(offset2 + max2, offset3 + max3));\n        best = std::max(best, sum + block_best);\n        sum += offset3 + prefix3;\n    }\n\n    for (; j < n; ++j) {\n        sum += columns[j] - columns[j - s];\n        if (sum > best) {\n            best = sum;\n        }\n    }\n    return best;\n}\n\nint main() {\n    FastInput input;\n    const int n = input.next_int();\n    const int s = input.next_int();\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const int moves = n - s;\n    const int history_rows = std::min(s, moves);\n    const std::size_t row_size = static_cast<std::size_t>(n);\n    const std::size_t history_size =\n        static_cast<std::size_t>(history_rows) * row_size;\n    std::unique_ptr<int[]> history(new int[history_size]);\n    std::unique_ptr<int[]> staged(new int[n]);\n    std::unique_ptr<std::int64_t[]> columns(new std::int64_t[n]());\n\n    for (int r = 0; r < s; ++r) {\n        int* destination = r < history_rows\n            ? history.get() + static_cast<std::size_t>(r) * row_size\n            : staged.get();\n        for (int j = 0; j < n; ++j) {\n            destination[j] = input.next_int();\n        }\n        add_row(columns.get(), destination, n);\n    }\n\n    std::int64_t best = horizontal_max(columns.get(), n, s);\n    int slot = 0;\n    for (int r = s; r < n; ++r) {\n        for (int j = 0; j < n; ++j) {\n            staged[j] = input.next_int();\n        }\n        int* outgoing = history.get() + static_cast<std::size_t>(slot) * row_size;\n        // Only rows before n-s can subsequently leave a vertical window.\n        advance_row(columns.get(), staged.get(), outgoing, n, r < moves);\n        const std::int64_t candidate = horizontal_max(columns.get(), n, s);\n        if (candidate > best) {\n            best = candidate;\n        }\n        ++slot;\n        if (slot == history_rows) {\n            slot = 0;\n        }\n    }\n\n    std::printf(\"%lld\\n\", static_cast<long long>(best));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Interleaving four cache-local horizontal prefix scans should expose instruction-level parallelism and shorten the serial sliding-window dependency chain without additional storage.",

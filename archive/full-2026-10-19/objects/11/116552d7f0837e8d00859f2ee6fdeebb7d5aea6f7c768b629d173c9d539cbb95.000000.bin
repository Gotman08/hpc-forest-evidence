"""Restore the exact sealed r2b source into a new r2c directory, with bounded preservation."""
from __future__ import annotations

import hashlib
import json
import shutil
import zipfile
from pathlib import Path, PurePosixPath

OUT = Path(__file__).resolve().parent
BASE = OUT.parents[2]
OLD = OUT.parent / 'revision-r2b'
PROJECT = BASE / 'work/hpc-forest-primes-native-max-r2c/project'


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    archive = OLD / 'HPC-Forest-Primes-Natif-MAX-r2b.zip'
    if sha(archive) != '1a1dde5f1de6b3e3f062e3984c57c6327f714a7570b41e5734371bcda291e33b' or PROJECT.exists():
        raise ValueError('Exact sealed source and new destination required')
    runtime = json.loads((OLD / 'runtime-manifest-r2max.json').read_bytes())
    original = {str(BASE / 'work/hpc-forest-primes-native-max-r2b/project' / name): sha(BASE / 'work/hpc-forest-primes-native-max-r2b/project' / name) for name in runtime}
    original.update({str(path): sha(path) for path in OLD.iterdir() if path.is_file()})
    with zipfile.ZipFile(archive) as source:
        rows = source.infolist()
        if len(rows) != 103 or len({row.filename.casefold() for row in rows}) != 103:
            raise ValueError('Exact unique source inventory required')
        for row in rows:
            posix = PurePosixPath(row.filename)
            if row.is_dir() or posix.parts[0] != 'HPC-Forest' or '..' in posix.parts or '\\' in row.filename or ':' in row.filename:
                raise ValueError('Unsafe source member')
            name = posix.relative_to('HPC-Forest').as_posix()
            raw = source.read(row)
            if hashlib.sha256(raw).hexdigest() != runtime[name]:
                raise ValueError('Source member SHA differs')
            target = PROJECT / name
            target.parent.mkdir(parents=True, exist_ok=True)
            with target.open('xb') as stream:
                stream.write(raw)
    shutil.copytree(OLD / 'certified-preparation', OUT / 'certified-preparation')
    shutil.copyfile(OLD / 'preparation-review-original.json', OUT / 'preparation-review-original.json')
    origin = {'schema': 'hpc-forest-r2c-origin-preservation-v1', 'parent_source_zip_sha256': sha(archive),
              'parent_plan_sha256': sha(OLD / 'native-max-plan.json'), 'parent_runtime_manifest': runtime,
              'original_files': original, 'source_files_restored': 103, 'source_replayed': False,
              'native_model_calls': 0, 'jobs_submitted': 0}
    with (OUT / 'origine-preservee.json').open('x', encoding='utf8') as stream:
        json.dump(origin, stream, indent=2)
    print(json.dumps({'restored_sources': 103, 'preserved_original_files': len(original), 'native_model_calls': 0}))


if __name__ == '__main__':
    main()

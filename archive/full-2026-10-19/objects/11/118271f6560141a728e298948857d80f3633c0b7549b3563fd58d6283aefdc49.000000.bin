"""Assemble a coherent manuscript and an exhaustive technical supplement.

Inputs are the frozen, independently audited exports. No experimental process
or program is invoked. Tables are generated, never hand-copied.
"""

import csv
import hashlib
import json
import re
from collections import Counter
from datetime import datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
OUT = ROOT.parent
DATA = HERE / "donnees"


def load(p):
    return json.loads(Path(p).read_text(encoding="utf-8-sig"))


def n(v, digits=2):
    return f"{v:,.{digits}f}".replace(",", " ").replace(".", ",")


def integer(v):
    return n(v, 0)


def table(headers, rows, caption=None):
    text = f"*{caption}*\n\n" if caption else ""
    text += "| " + " | ".join(headers) + " |\n|" + "---|" * len(headers) + "\n"
    return (
        text
        + "\n".join(
            "| "
            + " | ".join(str(c).replace("|", "/").replace("\n", " ") for c in row)
            + " |"
            for row in rows
        )
        + "\n"
    )


def short_model(v):
    return (
        v.replace("gpt-", "GPT ")
        .replace("hpcforest-deepseek-v4flash0731:mxfp4", "DeepSeek V4-Flash-0731")
        .replace("hpcforest-deepseek-v4flash:mxfp4", "DeepSeek V4-Flash")
        .replace("qwen2.5-coder:", "Qwen 2.5 Coder ")
    )


def sha(p):
    with Path(p).open("rb") as f:
        return hashlib.file_digest(f, "sha256").hexdigest()


def main():
    audit = load(HERE / "audit-calculs.json")
    editorial = load(HERE / "suivi-technique-r2h-20261019T0955Z-edition-r5b.json")
    editorial_admission = load(HERE / "admissions.json")["editorial_technical_snapshot"]
    assert sha(HERE / editorial_admission["file"]) == editorial_admission["sha256"]
    assert editorial["new_scientific_cohorts_admitted"] == []
    assert editorial["scientific_aggregates_changed"] is False
    assert editorial["operator_report_is_never_model_input"] is True
    for reference in editorial["references"]:
        path = Path(reference["path"])
        assert path.stat().st_size == reference["bytes"]
        assert sha(path) == reference["sha256"], reference["role"]
    assert audit["verified"]
    for file, digest in audit["frozen_data_files"].items():
        assert sha(DATA / file) == digest, file
    rows = load(DATA / "confirmations-recalculees.json")
    groups = {
        g: [r for r in rows if r["cohort"] == g]
        for g in ["count", "luna", "astra", "terra", "sol", "source_only", "luna_xhigh", "source_only_astra", "astra_xhigh", "terra_xhigh", "source_only_terra", "source_only_sol", "comparison", "gpt96", "deepseek"]
    }
    count, comp, deep = (
        groups[g] for g in ["count", "comparison", "deepseek"]
    )
    ledger = load(DATA / "couts-natifs.json")
    batches = load(DATA / "cpu-lots.json")
    regs = load(DATA / "registres-recalcules.json")
    corpus = load(DATA / "historique-preserve.json")
    state = load(DATA / "etat-campagnes.json")
    cutoff = datetime.fromisoformat(audit["completed_utc"]).strftime(
        "%d/%m/%Y à %H h %M UTC"
    )
    costs = []
    for g, label in [
        ("count", "Count : vingt cellules"),
        ("luna", "Luna : quatorze sujets"),
        ("astra", "Astra : quatorze sujets"),
        ("terra", "Terra : quatorze sujets"),
        ("sol", "Sol : quatorze sujets"),
        ("comparison", "GPT : six bras"),
        ("gpt96", "GPT96 : trois sujets"),
        ("source_only", "Source-only Luna MAX : quinze sujets"),
        ("luna_xhigh", "R1 Luna xhigh : quatorze sujets"),
        ("source_only_astra", "Source-only Astra MAX : quinze sujets"),
        ("astra_xhigh", "R1 Astra xhigh : quatorze sujets"),
        ("terra_xhigh", "R1 Terra xhigh : quatorze sujets"),
        ("source_only_terra", "Source-only Terra MAX : quinze sujets"),
        ("source_only_sol", "Source-only Sol MAX : quinze sujets"),
    ]:
        rr = groups[g]
        costs.append(
            [
                label,
                integer(sum(r["native_calls"] for r in rr)),
                integer(sum(r["known_exact_tokens"] for r in rr)),
                integer(sum(r["unmetered_calls"] for r in rr)),
            ]
        )
    terra_new = [
        ("terra_xhigh", "R1 Terra xhigh", "couts-terra-xhigh.json", "C.9", "F.9"),
        ("source_only_terra", "Source-only Terra MAX", "couts-source-only-terra.json", "C.10", "F.10"),
    ]
    terra_data = {key: load(DATA / (key + ".json")) for key, *_ in terra_new}
    terra_costs = {key: load(DATA / filename) for key, _, filename, _, _ in terra_new}
    def terra_summary(key, label, section):
        cohort, accounting = terra_data[key], terra_costs[key]["request_summary"]
        changed = len(cohort["rows"]) - cohort["retained_baselines"]
        return (f"{label} reçoit {len(cohort['rows'])} recherches et confirme {changed} programmes modifiés ; "
                f"{cohort['retained_baselines']} références sont conservées. Les {cohort['trials']} missions comprennent "
                f"{cohort['statuses'].get('valid', 0)} valides, pour {cohort['scored_nodes']} sommets notés. "
                f"Les {accounting['published_requests']} requêtes sont toutes réconciliées ; "
                f"{accounting['verified_deliveries']} réponses sont livrées. Les {accounting['native_invocations_observed']} invocations "
                f"ont {integer(accounting['known_exact_tokens'])} jetons exacts connus et "
                f"{accounting['unmeasured_native_invocations']} invocations sans mesure finale. "
                f"La consommation reste inconnue pour {accounting['requests_with_unknown_consumption']} requêtes, "
                f"sans convertir l’absence de réponse en appel nul. Les cinq confirmations et les négatifs sont détaillés "
                f"en annexe {section}. Les contrats finis et les temps propres aux allocations sont conservés, "
                "sans rejeu ni classement causal.")
    source_sol = load(DATA / "source_only_sol.json")
    source_sol_costs = load(DATA / "couts-source-only-sol.json")
    assert len(source_sol["rows"]) == 15 and source_sol["modified_programs_confirmed"] == 14
    assert source_sol_costs["request_summary"]["native_invocations_observed"] == 121
    source_sol_summary = (
        "Le quatrième groupe source-only, Sol MAX, reçoit quinze recherches et confirme quatorze programmes modifiés ; "
        "tropical conserve sa référence. Les 104 missions comprennent 90 valides, huit erreurs d’infrastructure, "
        "cinq générations échouées et une compilation échouée, pour 91 sommets notés. Les 124 requêtes sont réconciliées : "
        "121 invocations CLI observées, 111 usages finaux mesurés, dix invocations de consommation inconnue et trois expirations "
        "prouvées avant invocation. Les 2 676 472 jetons exacts connus ne forment pas un total exact global. "
        "Une réponse tardive, absente de l’archive originale, est reçue séparément avec son marqueur ready et les mêmes octets. "
        "Les cinq confirmations et leurs dispersions figurent en annexe C.11 ; aucun temps n’est fusionné entre allocations. "
        "L’identité modèle/MAX demandée et les invocations CLI sont contrôlées ; le backend hébergé n’est pas attesté indépendamment.")
    substitutions = {
        "TERRA_XHIGH_MAIN": terra_summary("terra_xhigh", "La couverture R1 Terra xhigh", "C.9"),
        "SOURCE_TERRA_MAIN": terra_summary("source_only_terra", "Le troisième groupe source-only, Terra MAX,", "C.10"),
        "SOURCE_SOL_MAIN": source_sol_summary,
        "TERRA_UNDELIVERED_DETAIL": (
            f"Les deux nouvelles cohortes Terra conservent {sum(v['request_summary']['published_requests'] - v['request_summary']['verified_deliveries'] for v in terra_costs.values())} requêtes non livrées : "
            f"{sum(v['request_summary']['interrupted_claims_unknown'] for v in terra_costs.values())} claims interrompus, déjà inclus dans les invocations non mesurées, et "
            f"{sum(v['request_summary']['expired_unanswered_without_local_invocation_evidence'] for v in terra_costs.values())} demandes sans preuve locale d’invocation. "
            "Ces dernières s’ajoutent aux inconnus des invocations observées, sans leur attribuer une consommation nulle."
        ),
        "CUTOFF": cutoff,
        "REGISTRY_COUNT": integer(audit["registry_count"]),
        "CPU_SAMPLES": integer(audit["cpu_totals"]["samples"]),
        "CPU_POINTS": integer(audit["cpu_totals"]["points"]),
        "CPU_CAMPAIGNS": integer(audit["cpu_totals"]["campaigns"]),
        "CPU_BATCHES": integer(len(batches)),
        "CPU_UNIQUE": integer(audit["cpu_totals"]["unique_combinations"]),
        "CPU_REPEATED": integer(audit["cpu_totals"]["repeated_controls"]),
        "NATIVE_CLOSED_CALLS": integer(sum(r["native_calls"] for r in rows if r["cohort"] != "deepseek")),
        "NATIVE_CLOSED_EXACT": integer(sum(r["known_exact_tokens"] for r in rows if r["cohort"] != "deepseek")),
        "NATIVE_CLOSED_UNKNOWN": integer(sum(r["unmetered_calls"] for r in rows if r["cohort"] != "deepseek")),
        "TABLE_COHORTS": table(
            ["Ensemble", "Recherches reçues", "Rôle dans l’étude"],
            [
                [
                    "R1 · count 2023",
                    "20 cellules / une graine chacune",
                    "Quatre modèles × cinq efforts",
                ],
                [
                    "R1 · couverture Luna MAX",
                    "14 cellules supplémentaires",
                    "Autres sujets admis ; mêmes contrats, temps propres",
                ],
                [
                    "R1 · couverture Astra MAX",
                    "14 cellules supplémentaires",
                    "Même préparation ; références propres",
                ],
                [
                    "R1 — couverture Terra MAX",
                    "14 cellules supplémentaires",
                    "Contrats et références propres",
                ],
                [
                    "R1 · couverture Sol MAX",
                    "14 cellules supplémentaires",
                    "Contrats finis ; références propres",
                ],
                [
                    "DeepSeek local",
                    "2 campagnes × 3 sujets",
                    "Résultats et coûts locaux ; deux versions",
                ],
                [
                    "GPT · avec/sans harnais",
                    "6 bras / 3 paires",
                    "Comparaison descriptive ; une recherche par bras",
                ],
                [
                    "Diagnostics CPU postérieurs",
                    f"{audit['cpu_totals']['campaigns']} racines / {len(batches)} allocations",
                    f"Mêmes exécutables ; {integer(audit['cpu_totals']['points'])} points / {integer(audit['cpu_totals']['samples'])} temps",
                ],
                [
                    "Explorations antérieures",
                    "42 résumés historiques",
                    "Provenance et négatifs ; pas un échantillon homogène",
                ],
                [
                    "GPT96 sans harnais",
                    "3 recherches reçues / planning incomplet",
                    "177 appels observés ; contrats finis ; budgets atteints",
                ],
                [
                    "Source-only Luna MAX",
                    "15 recherches reçues ; plan historique distinct",
                    "Harnais interne désactivé ; mère et contrôle externe conservés",
                ],
                [
                    "R1 · couverture Luna xhigh",
                    "14 cellules supplémentaires",
                    "Contrats finis ; références propres",
                ],
                [
                    "R1 · couverture Astra xhigh",
                    "14 cellules supplémentaires",
                    "Réception antérieure ; compteurs incomplets conservés",
                ],
                [
                    "Source-only Astra MAX",
                    "15 recherches fraîches supplémentaires",
                    "Réception antérieure ; compteurs incomplets conservés",
                ],
                [
                    "R1 Terra xhigh / source-only Terra MAX",
                    "14 / 15 recherches supplémentaires reçues",
                    "Historique R1 reçu ; MAX R1 complet 60/60",
                ],
                [
                    "Source-only Sol MAX",
                    "15 recherches supplémentaires ; MAX 60/60 reçu",
                    "104 missions / 91 sommets ; 14 programmes modifiés",
                ],
                [
                    "Véritable Codex / R3 corrigé R4b / R5",
                    "Aucun résultat natif admis",
                    "Barrières et qualifications propres en attente",
                ],
            ],
            "Tableau 1 — Périmètre des données. Les ensembles se recouvrent ; leurs tailles ne s’additionnent pas.",
        ),
        "TABLE_PROTOCOLS": table(
            ["Protocole", "Programmes prévus par recherche", "Plafonds et harnais"],
            [
                [
                    "R1",
                    "8 programmes + au plus 2 épisodes de mère",
                    "30 min ; 1,5 M jetons ; harnais ≤ 3 appels/mission",
                ],
                [
                    "Comparaison GPT",
                    "24 programmes par bras",
                    "2 h ; 1,5 M jetons ; avec/sans harnais ; pas de mère modèle",
                ],
                [
                    "Source-only Luna/Astra/Terra/Sol MAX",
                    "8 programmes + 2 épisodes de mère",
                    "30 min ; 1,5 M jetons ; harnais interne désactivé ; contrôle externe",
                ],
                [
                    "DeepSeek v11",
                    "96 programmes par sujet",
                    "4 cycles ; 6 A/B/C et 6 G par cycle ; génération Ollama",
                ],
                [
                    "GPT96 (reçu)",
                    "96 prévus ; 54 / 54 / 75 missions réalisées",
                    "6 h ; 4 M jetons ; harnais désactivé ; contexte natif 65 536",
                ],
                [
                    "CPU postérieur",
                    "Aucune génération",
                    "1 chauffe + 5 passages à 1/2/4/8/16 cœurs",
                ],
            ],
            "Tableau 2 — Les créneaux prévus sont des maxima de planification, distincts des appels et sommets réalisés.",
        ),
        "TABLE_COUNT_SHORT": table(
            [
                "Identité",
                "Appels (5 efforts)",
                "Jetons exacts connus",
                "Appels non mesurés",
            ],
            [
                [
                    short_model(model),
                    sum(r["native_calls"] for r in count if r["model"] == model),
                    integer(
                        sum(
                            r["known_exact_tokens"]
                            for r in count
                            if r["model"] == model
                        )
                    ),
                    sum(r["unmetered_calls"] for r in count if r["model"] == model),
                ]
                for model in (
                    "gpt-6-luna",
                    "gpt-6-astra",
                    "gpt-5.6-terra",
                    "gpt-6.1-sol",
                )
            ],
            "Tableau 3 — Appels et jetons observés sur les cinq efforts de chaque identité, count 2023. Les compteurs incomplets restent des minima connus ; cette somme ne classe pas l’efficacité générale des modèles.",
        ),
        "TABLE_SOURCE_ONLY": table(
            ["Sujet", "Référence (s)", "Retenu (s)", "Réduction (%)"],
            [[r["subject"], f"{n(r['reference_seconds'], 5)} ± {n(r['reference_sd'], 5)}",
              f"{n(r['chosen_seconds'], 5)} ± {n(r['chosen_sd'], 5)}", n(r["gain_percent"])]
             for r in groups["source_only"]],
            "Tableau 4 — Source-only Luna MAX : quinze racines fraîches, moyenne ± écart-type de cinq confirmations. Une seule graine ; références propres à cette allocation.",
        ),
        "TABLE_DEEP": table(
            ["Version / sujet", "Référence (s)", "Retenu (s)", "Réduction (%)"],
            [
                [
                    ("V4-Flash-0731" if "0731" in r["model"] else "V4-Flash")
                    + " · "
                    + r["subject"][5:],
                    f"{n(r['reference_seconds'], 5)} ± {n(r['reference_sd'], 5)}",
                    f"{n(r['chosen_seconds'], 5)} ± {n(r['chosen_sd'], 5)}",
                    n(r["gain_percent"]),
                ]
                for r in deep
            ],
            "Tableau 5 — DeepSeek, moyenne ± écart-type empirique, cinq temps par programme. La référence est conservée pour k-NN 0731.",
        ),
        "TABLE_COMPARISON": table(
            [
                "Sujet",
                "Sans harnais : g (%)",
                "Avec harnais : g (%)",
                "Écart (points de %)",
            ],
            [
                [
                    s,
                    n(
                        next(
                            r["gain_percent"]
                            for r in comp
                            if r["subject"] == "2022-" + s and r["arm"] == "reference"
                        )
                    ),
                    n(
                        next(
                            r["gain_percent"]
                            for r in comp
                            if r["subject"] == "2022-" + s
                            and r["arm"] == "mixed-harness"
                        )
                    ),
                    n(
                        next(
                            r["gain_percent"]
                            for r in comp
                            if r["subject"] == "2022-" + s
                            and r["arm"] == "mixed-harness"
                        )
                        - next(
                            r["gain_percent"]
                            for r in comp
                            if r["subject"] == "2022-" + s and r["arm"] == "reference"
                        ),
                        3,
                    ),
                ]
                for s in ("knn", "sum", "nbody")
            ],
            "Tableau 6 — Réductions normalisées par les références propres aux bras. L’écart descriptif n’est pas un effet causal estimé.",
        ),
        "TABLE_COST": table(
            [
                "Ensemble natif clos",
                "Appels",
                "Jetons exacts connus",
                "Appels non mesurés",
            ],
            costs + [["Total des ensembles ci-dessus",
                      integer(sum(r["native_calls"] for r in rows if r["cohort"] != "deepseek")),
                      integer(sum(r["known_exact_tokens"] for r in rows if r["cohort"] != "deepseek")),
                      integer(sum(r["unmetered_calls"] for r in rows if r["cohort"] != "deepseek"))]],
            "Tableau 7 — Consommations natives connues. Les bornes budgétaires ne complètent pas les compteurs manquants.",
        ),
    }
    manuscript = (HERE / "manuscrit.md").read_text(encoding="utf-8")
    for key, value in substitutions.items():
        manuscript = manuscript.replace("{{" + key + "}}", value)
    assert not re.search(r"\{\{.+?\}\}", manuscript)
    (ROOT / "ARTICLE.md").write_text(manuscript, encoding="utf-8")
    # A second document provides the complete evidence without repeating the narrative.
    parts = [
        "# HPC-Forest — Annexes techniques et données vérifiables\n\n**Nicolas Marano · Romain Despoullain**\n\nComplément de l’article de recherche du 19 octobre 2026. Arrêté des résultats scientifiques admis : "
        + cutoff
        + ".\n\nLes résultats ci-dessous sont des observations documentaires. Aucun programme, oracle ou protocole expérimental n’a été modifié pour cette édition. Les exports complets accompagnent le document ; ils ne sont jamais réinjectés dans les recherches.\n"
    ]

    def add(text):
        parts.append(text + "\n")

    add(
        "## A. Sources, domaines et qualifications de conformité\n\nLa comparaison porte sur la cible expérimentale ARM64 préparée. Le passage des contrôles exacts ne certifie pas le domaine universel, les algorithmes exigés ou le paquet d’un concours. Le registre suivant sépare les exclusions de préparation des résultats des modèles."
    )
    add(
        table(
            ["Sujet / famille", "Statut et limite"],
            [
                [
                    "2020 tropical",
                    "Admis R1 ; contrôles CPU limités aux vrais contrats Luna MAX reçus. Graphes simples connexes finis de la revue ; optimalité vérifiée indépendamment sur ces cas.",
                ],
                [
                    "2020 permutations",
                    "Admis ; entrées reçues à symboles distincts. Les essais synthétiques avec répétitions ne certifient pas le candidat sur tous les multiensembles.",
                ],
                [
                    "2020 quicksort",
                    "Gain observable confirmé ; fidélité algorithmique stricte non certifiée. Candidat introsort hybride : insertion sous 24 éléments, repli heapsort. Aucun lot CPU admis pour ce sujet.",
                ],
                [
                    "2020 Jacobi",
                    "Exclu : observabilité insuffisante du calcul à certifier.",
                ],
                ["2021 Johnson", "Exclu : contrôle checksum non certifié."],
                [
                    "2021 graph / metrics / Sokoban / Jacobi",
                    "Admis dans les contrats préparés ; les noms Jacobi 2020 et 2021 ne sont pas interchangeables.",
                ],
                [
                    "2022 k-NN / sum / bucket sort",
                    "Contrats et formats reçus ; contrôle exact dans le domaine fini préparé.",
                ],
                [
                    "2022 N-body",
                    "Compteur entier d’en-tête du programme officiel conservé, puis six float32 par particule ; divergence de présentation entre prose et source.",
                ],
                [
                    "2023 count / sum / npbonacci",
                    "Admis dans R1 ; les grands jeux supplémentaires count ont un oracle de référence canonique dans les diagnostics CPU.",
                ],
                ["2023 path", "Exclu : initialisation non certifiée sous GCC."],
                [
                    "2023 primes / supplément R2",
                    "Retenu avant tout modèle R2 : les fragments décimaux indépendants ne certifient pas l’origine première. Prévol mécanique insuffisant.",
                ],
                [
                    "MPI / SIMD / threads",
                    "MPI 2023 conditionnel, au plus quatre processus dans les règles examinées ; aucune obligation établie de douze nœuds. Option OpenMP ou trace SIMD statique : aucune preuve isolée de threads/instructions utiles.",
                ],
                [
                    "2024 / 2025",
                    "Aucun sujet exploitable publié dans les pages examinées ; aucune donnée de problème inventée.",
                ],
            ],
        )
    )
    catalogue = load(ROOT / "catalogue-sources.json")
    add(
        "### A.1. Archives officielles consultées\n\nLes copies locales du catalogue conservent l’URL, la taille et l’empreinte intégrale. Les noms ci-dessous désignent les fichiers d’origine ; les contrats adaptés sont exportés par campagne en annexe G."
    )
    add(
        table(
            ["Édition / fichier", "SHA-256"],
            [
                [str(x["year"]) + " / " + x["name"], x["sha256"]]
                for x in catalogue["files"]
            ],
        )
    )
    add(
        "### A.2. Revue complémentaire de quicksort\n\nLa revue indépendante vérifie sept vrais cas et douze sorties capturées, avec onze tests du lecteur. Son transport mécanique ARM64 est reçu et audité : le préfixe d’un million de valeurs concorde entre C et Python ; une simplification algébrique modifierait 4 351 valeurs binaires64. Le MD5 est actif. Le job 748578 garde son échec d’archivage après réussite des contrôles ; la livraison corrective 748579 archive les mêmes fichiers sans rejouer les contrôles. L’archive 68d4b6a45528cbf65a8b25bdb3a521e1520be5ff69859474ccff6f72bcfaa5e3 et les inventaires lient 37 fichiers restaurés et 775 fichiers de la campagne Luna inchangés. Aucun candidat n’a été compilé ou exécuté par cette revue et aucun modèle n’a été appelé. La fidélité stricte de l’hybride Luna et son admission CPU restent retenues ; le cas à dix millions et le repli ne sont pas couverts. Cette preuve mécanique ne certifie ni l’algorithme Luna ni automatiquement le programme Astra."
    )
    add(
        "## B. Vingt cellules count 2023\n\nUne recherche/graine 23 par ligne. Moyennes et écarts-types de confirmation en secondes ; cinq temps par programme. Le pourcentage décrit la réduction par rapport à la référence de la même cellule, sans fusion d’allocations."
    )
    add(
        table(
            [
                "Modèle / effort",
                "T₀ ± s₀ (s)",
                "T ± s (s)",
                "g (%)",
                "Appels / inconnus",
                "Jetons connus",
            ],
            [
                [
                    short_model(r["model"]) + " / " + r["effort"],
                    f"{n(r['reference_seconds'], 6)} ± {n(r['reference_sd'], 6)}",
                    f"{n(r['chosen_seconds'], 6)} ± {n(r['chosen_sd'], 6)}",
                    n(r["gain_percent"], 4),
                    f"{r['native_calls']} / {r['unmetered_calls']}",
                    integer(r["known_exact_tokens"]),
                ]
                for r in count
            ],
        )
    )
    add(
        "Les cinq mesures brutes de chaque référence et de chaque gagnant sont exportées dans registres-recalcules.json. La comparabilité des vingt contrats est documentée séparément dans comparabilite-max-xhigh-high-medium-low.json. Les références conservées, les doublons et les appels interrompus restent identifiés."

            if not e.get("correct"):
                rejected.append(
                    [
                        r["campaign_root"].split("results-")[-1].replace("\\", "/"),
                        e["id"],
                        e.get("status"),
                        e.get("score"),
                        len(e.get("times", [])),
                        e.get("reason", ""),
                    ]
                )
    add(
        "### E.1. Finalistes rejetés et correction de l’auditeur\n\nLe premier lecteur 0731 supposait à tort que tous les finalistes étaient corrects. Son échec reste dans audits-747505. Le lecteur indépendant R2 et ses neuf tests imposent une exclusion des rejets, un score nul sans temps et cinq mesures pour tout finaliste valide. Le tableau suivant provient directement des registres immuables."
    )
    add(
        table(
            [
                "Campagne",
                "Programme",
                "Statut",
                "Score",
                "Temps conservés",
                "Cause enregistrée",
            ],
            rejected,
        )
    )
    add(
        "## F. Coûts par appel, rôle et provenance\n\nUn compteur absent est inconnu. Une réponse expirée peut être imputée au budget sans consommation exacte connue. Les jetons de cache sont un sous-ensemble de l’entrée et ceux de raisonnement un sous-ensemble de la sortie. Les identifiants session/nonce assurent la déduplication des copies locales et archivées."
    )
    add(substitutions["TABLE_COST"].replace("Tableau 7", "Tableau F.1"))
    add(
        f"L’inventaire natif global du {ledger['observed_utc']} contient {integer(ledger['native_unique_calls'])} appels uniques : {integer(ledger['native_unique_calls'] - ledger['native_unmetered_calls'] - ledger['native_pending_calls'])} avec mesure exacte, {integer(ledger['native_unmetered_calls'])} sans compteur final et {integer(ledger['native_pending_calls'])} en cours. Il comprend les pilotes, sondes et recherches en cours ; ses {integer(ledger['native_exact_total'])} jetons exacts connus ne sont pas tous ceux des cohortes finales. Le fichier couts-natifs.json conserve chaque appel, son rôle, son état et ses empreintes de requête/réponse."
    )
    add("Cet inventaire global est un instantané historique antérieur aux réceptions Terra, GPT96 et Sol ; ses états en cours ne décrivent pas l’état actuel. "
        "Le tableau F.1 et la figure 7 utilisent leurs reçus clos, via couts-terra.json, couts-gpt96.json et couts-sol.json, en remplacement de leurs entrées historiques. "
        "Les inventaires ne sont jamais additionnés : leurs clés session/nonce se recouvrent. Les 24 invocations Terra et les 17 GPT96 sans compteur "
        "restent inconnues ; la requête Terra sans réponse et les deux expirations GPT96 établies avant invocation restent distinctes.")
    terra_calls = load(DATA / "couts-terra.json")["native_calls"]
    add(table(["Rôle Terra", "Invocations observées", "Sans compteur", "Jetons exacts connus"],
              [[label,
                sum(c["native_invocation_observed"] for c in terra_calls if c["kind"] == role),
                sum(c["native_invocation_observed"] and not c["usage_measured"] for c in terra_calls if c["kind"] == role),
                integer(sum(c["exact_total"] or 0 for c in terra_calls if c["kind"] == role))]
               for role, label in [("enfant", "Enfants"), ("intégration", "Intégrations G"), ("mère", "Mère modèle")]],
              "Tableau F.2 — Appels Terra reçus, dédupliqués par session/nonce ; la requête sans réponse est exclue du nombre d’invocations observées."))
    gpt96_calls = load(DATA / "couts-gpt96.json")["native_calls"]
    add(table(["Rôle GPT96", "Invocations observées", "Sans compteur", "Jetons exacts connus"],
              [[label, sum(c["native_invocation_observed"] for c in gpt96_calls if c["kind"] == role),
                sum(c["native_invocation_observed"] and not c["usage_measured"] for c in gpt96_calls if c["kind"] == role),
                integer(sum(c["exact_total"] or 0 for c in gpt96_calls if c["kind"] == role))]
               for role, label in [("enfant", "Enfants A/B/C"), ("intégration", "Intégrations G"), ("mère", "Mère modèle")]],
              "Tableau F.3 — GPT96 reçu : deux expirations avant invocation sont exclues des 177 appels observés."))
    sol_calls = load(DATA / "couts-sol.json")["native_calls"]
    add(table(["Rôle Sol MAX", "Invocations observées", "Sans compteur", "Jetons exacts connus"],
              [[label, sum(c["native_invocation_observed"] for c in sol_calls if c["kind"] == role),
                sum(c["native_invocation_observed"] and not c["usage_measured"] for c in sol_calls if c["kind"] == role),
                integer(sum(c["exact_total"] or 0 for c in sol_calls if c["kind"] == role))]
               for role, label in [("enfant", "Enfants A/B/C"), ("intégration", "Intégrations G"), ("mère", "Mère modèle")]],
              "Tableau F.4 — Sol MAX reçu : trois expirations établies avant invocation sont exclues des 110 invocations ; huit invocations conservent leur consommation inconnue."))
    source_only_calls = load(DATA / "couts-source-only.json")["native_calls"]
    add(table(["Rôle source-only Luna MAX", "Invocations observées", "Sans compteur", "Jetons exacts"],
              [[label, sum(c["native_invocation_observed"] for c in source_only_calls if c["kind"] == role), 0,
                integer(sum(c["exact_total"] for c in source_only_calls if c["kind"] == role))]
               for role, label in [("enfant", "Enfants A/B/C"), ("intégration", "Intégrations G"), ("mère", "Mère modèle")]],
              "Tableau F.5 — Première cohorte source-only : les 150 invocations ont toutes un compteur ; cache et raisonnement sont déjà inclus."))
    luna_xhigh_calls = load(DATA / "couts-luna-xhigh.json")["native_calls"]
    add(table(["Rôle R1 Luna xhigh", "Invocations observées", "Sans compteur", "Jetons exacts"],
              [[label, sum(c["native_invocation_observed"] for c in luna_xhigh_calls if c["kind"] == role), 0,
                integer(sum(c["exact_total"] for c in luna_xhigh_calls if c["kind"] == role))]
               for role, label in [("enfant", "Enfants A/B/C"), ("intégration", "Intégrations G"), ("mère", "Mère modèle")]],
              "Tableau F.6 — Luna xhigh reçu : 158 invocations et 3 434 224 jetons exacts ; cache et raisonnement déjà inclus."))
    for filename, label, caption in [
        ("couts-source-only-astra.json", "Source-only Astra MAX", "Tableau F.7 — 98 invocations, treize sans compteur ; trois expirations avant invocation exclues des appels."),
        ("couts-astra-xhigh.json", "R1 Astra xhigh", "Tableau F.8 — 115 invocations, douze sans compteur ; trois expirations avant invocation exclues des appels."),
    ]:
        closed_calls = load(DATA / filename)["native_calls"]
        add(table(["Rôle " + label, "Invocations", "Sans compteur", "Jetons exacts connus"],
                  [[role, sum(c["native_invocation_observed"] for c in closed_calls if c["kind"] == role),
                    sum(c["native_invocation_observed"] and not c["usage_measured"] for c in closed_calls if c["kind"] == role),
                    integer(sum(c["exact_total"] or 0 for c in closed_calls if c["kind"] == role))]
                   for role in ("mère", "enfant", "intégration")], caption))
    for key, label, _, _, section in terra_new:
        closed = terra_costs[key]["native_calls"]
        add(table(["Rôle " + label, "Demandes", "Livrées", "Inv.", "Inv. non mes.", "Req. inconnues", "Jetons connus"],
                  [[role, sum(c["kind"] == role for c in closed),
                    sum(c["delivery_verified"] for c in closed if c["kind"] == role),
                    sum(c["native_invocation_observed"] for c in closed if c["kind"] == role),
                    sum(c["native_invocation_observed"] and not c["usage_measured"] for c in closed if c["kind"] == role),
                    sum(not c["usage_measured"] for c in closed if c["kind"] == role),
                    integer(sum(c["exact_total"] for c in closed if c["kind"] == role and c["usage_measured"]))]
                   for role in ("mère", "enfant", "intégration")],
                  f"Tableau {section} — {label} : requêtes, réponses livrées, invocations prouvées et inconnus distincts."))
        add("Une invocation interrompue sans réponse figure déjà dans les invocations non mesurées. "
            "Une requête sans preuve locale d’invocation n’est pas une invocation nulle. Les jetons connus sont une somme partielle, "
            "cache et raisonnement déjà inclus ; aucun total exact global n’est calculé.")
    closed_sol = source_sol_costs["native_calls"]
    add(table(["Rôle Sol source-only", "Requêtes", "Inv. CLI", "Inv. non mes.", "Préinvoc. 0", "Jetons connus"],
              [[role, sum(c["kind"] == role for c in closed_sol),
                sum(c["native_invocation_observed"] for c in closed_sol if c["kind"] == role),
                sum(c["native_invocation_observed"] and c["exact_total"] is None for c in closed_sol if c["kind"] == role),
                sum(c["state"] == "expired_before_invocation_proven" for c in closed_sol if c["kind"] == role),
                integer(sum(c["exact_total"] for c in closed_sol if c["kind"] == role and c["exact_total"] is not None))]
               for role in ("mère", "enfant", "intégration")],
              "Tableau F.11 — Sol source-only : 121 invocations, 111 usages finaux ; les trois zéros avant invocation sont séparés."))
    add("La mère comprend préparation et synthèse :25 requêtes / 24 invocations / 404 305 jetons connus / 4 inconnus. "
        "A/B/C :89 requêtes / 87 invocations / 2 005 991 connus / 5 inconnus ; G :10 / 10 / 266 176 / 1. "
        "114 requêtes possèdent une valeur exacte, dont trois zéros sans invocation ; elles ne sont pas 114 invocations mesurées. "
        "Les dix consommations inconnues restent null. La borne 1 966 080 n’est pas une consommation. Cache et raisonnement "
        "sont déjà inclus dans entrée+sortie et ne sont pas ajoutés à nouveau ; aucun total exact global.")
    add(
        table(
            [
                "Campagne / effort",
                "Appels exacts / inconnus / en cours",
                "Entrée",
                "Sortie",
                "Mère",
                "G",
                "Enfants",
            ],
            [
                [
                    x["campaign"] + " / " + x["effort"],
                    f"{x['exact_calls']} / {x['unmetered_calls']} / {x['pending_calls']}",
                    str(x["input_tokens"]),
                    str(x["output_tokens"]),
                    str(x["mother_tokens"]),
                    str(x["integration_tokens"]),
                    str(x["child_tokens"]),
                ]
                for x in ledger["native_campaigns"]
            ],
        )
    )
    add(
        "## G. Fiches des campagnes et vrais arbres\n\nChaque fiche documente l’identité, le contrat, les plafonds, le programme retenu et les vrais parents/sources. Les racines structurelles sont distinctes des programmes notés. Les programmes sans score ne sont pas ajoutés artificiellement au MCTS ; leur nombre et leur statut restent visibles. Les hypothèses et transformations textuelles complètes sont dans l’export registres-recalcules.json et les archives sources. Les traits pleins représentent les parents MCTS ; les pointillés des petits arbres représentent les sources G. Dans les grandes forêts, la liste complète des sources G reste dans figures-sources.json pour garder la figure lisible. Les labels A1/B1/etc. sont des identifiants de lecture, associés aux identifiants complets dans ce même fichier ; ils ne remplacent pas les ordinaux de mission archivés. Le code déclaré, ses identifiants, ses temps, les diagnostics et les entrées permettent l’inspection ; aucune pensée interne n’est inférée."
    )
    registry_index = []
    displayed_contracts = {}

    def without_reference_times(value):
        if isinstance(value, dict):
            return {
                k: without_reference_times(v)
                for k, v in value.items()
                if k != "reference_seconds"
            }
        if isinstance(value, list):
            return [without_reference_times(v) for v in value]
        return value

    for i, r in enumerate(regs, 1):
        cfg = r["config"] or {}
        b = r["best_confirmed"]
        ident = cfg.get(cfg.get("backend", "codex"), {})
        model = ident.get("model") or cfg.get("model") or "voir configuration"
        effort = ident.get("reasoning_effort", "local")
        subject = cfg.get("problem", "voir contrat")
        rel = Path(r["campaign_root"]).relative_to(OUT).as_posix()
        registry_index.append(
            {
                "id": f"C{i:02d}",
                "root": r["campaign_root"],
                "registry_sha256": r["registry_sha256"],
                "model": model,
                "effort": effort,
                "subject": subject,
            }
        )
        add(
            f"### G.{i}. C{i:02d} — {subject} · {short_model(model)} · {effort}\n\nRacine complète : `{rel}`. Registre SHA-256 : `{r['registry_sha256']}`."
        )
        schedule = cfg.get("schedule", {})
        bud = cfg.get("budget", {})
        proto = cfg.get("protocol", {})
        add(
            table(
                [f"C{i:02d} · champ", "Valeur enregistrée"],
                [
                    [
                        "Programme confirmé",
                        b["experiment_id"] + " ; commit " + b["commit"],
                    ],
                    [
                        "Résultat",
                        (
                            "Référence conservée"
                            if b["is_baseline"]
                            else "Programme modifié confirmé"
                        )
                        + f" ; g = {n(100 * r['gain_fraction'], 4)} % ; S = {n(r['speedup'], 4)}",
                    ],
                    [
                        "T₀ / T (s)",
                        n(b["reference_seconds"], 7) + " / " + n(b["mean_seconds"], 7),
                    ],
                    [
                        "Cinq temps T₀ (s)",
                        "; ".join(n(x, 7) for x in r["reference_samples"]),
                    ],
                    [
                        "Cinq temps T (s)",
                        "; ".join(n(x, 7) for x in r["chosen_samples"]),
                    ],
                    [
                        "Statuts des missions",
                        json.dumps(
                            dict(
                                Counter(
                                    (x["result"] or {}).get("status", x["state"])
                                    for x in r["trials"]
                                )
                            ),
                            ensure_ascii=False,
                        ),
                    ],
                    [
                        "Plafonds",
                        f"wall={bud.get('wall_seconds')} s ; jetons={bud.get('tokens')} ; profondeur={bud.get('max_depth')} ; mission={bud.get('generation_seconds')} s",
                    ],
                    ["Planning", json.dumps(schedule, ensure_ascii=False)],
                    ["Harnais", json.dumps(cfg.get("harness", {}), ensure_ascii=False)],
                    [
                        "Mesures de recherche / confirmation",
                        f"{proto.get('repetitions')} / {proto.get('confirmation_repetitions')} ; chauffe={proto.get('warmups')} ; graine={cfg.get('seed')}",
                    ],
                    [
                        "Machine / cible",
                        str((r["identity"] or {}).get("machine"))
                        + " ; "
                        + str(cfg.get("target_id")),
                    ],
                    [
                        "Compilateur",
                        json.dumps(cfg.get("compiler", {}), ensure_ascii=False),
                    ],
                    [
                        "Environnement",
                        json.dumps(proto.get("environment", {}), ensure_ascii=False),
                    ],
                ],
            )
        )
        contract = r["contract"] or {}
        contract_text = table(
            ["Contrat", "Valeur"],
            [
                [
                    "Langage / fichiers",
                    str(contract.get("language"))
                    + " / "
                    + str(contract.get("source_files")),
                ],
                ["Options", " ".join(contract.get("compiler_flags", []))],
                [
                    "Comparaison",
                    json.dumps(contract.get("comparison", {}), ensure_ascii=False),
                ],
            ],
        )
        cases = [*contract.get("search", []), *contract.get("confirmation", [])]
        if contract.get("benchmark"):
            cases.append(contract["benchmark"])
        case_text = table(
            [
                "Cas",
                "Entrée (empreinte du contrat)",
                "Octets stdin",
                "Sortie attendue SHA-256",
            ],
            [
                [
                    c["name"],
                    c.get("input_fingerprint", "non indiqué"),
                    c.get("stdin_bytes", "non indiqué"),
                    c.get("expected", {})
                    .get("stdout", {})
                    .get("sha256", "voir fichiers capturés"),
                ]
                for c in cases
            ],
        )
        signature = hashlib.sha256(
            json.dumps(
                without_reference_times(contract), sort_keys=True, ensure_ascii=False
            ).encode()
        ).hexdigest()
        if signature in displayed_contracts:
            shared = displayed_contracts[signature]
            add(
                f"Contrat partagé **{shared['id']}** : champs hors chronométrages identiques à ceux présentés en **G.{shared['first_section']}**. Les temps et paramètres propres à cette campagne restent distincts ; sa version intégrale est conservée dans le registre exporté."
            )
        else:
            shared = {
                "id": f"K{len(displayed_contracts) + 1:02d}",
                "first_section": i,
                "signature_without_reference_times": signature,
            }
            displayed_contracts[signature] = shared
            add(
                f"Contrat **{shared['id']}** — Première présentation. Les empreintes et les champs de format sont communs seulement aux fiches qui renvoient explicitement à cette clé ; les chronométrages ne sont pas mutualisés."
            )
            add(contract_text)
            add(case_text)
        registry_index[-1]["display_contract"] = shared
        add(
            f"![Figure G.{i} — Forêt C{i:02d}, liens enregistrés. Statuts de recherche ; programme confirmé encadré. Identifiants complets et toutes les sources G : figures-sources.json.](edition-professionnelle/figures/arbres/C{i:02d}.png)"
        )
    (DATA / "index-campagnes.json").write_text(
        json.dumps(registry_index, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    add(
        "## H. Historique, explorations et résultats non confirmés\n\nLes 42 résumés historiques ci-dessous conservent leur qualification d’origine. Une ligne de résumé n’est pas forcément une recherche indépendante, ni un résultat réaudité au niveau des cohortes principales. Les ensembles peuvent se recouvrir. Le JSON historique complet est conservé ; aucun gain de recherche non confirmé n’est substitué à un gain final."
    )
    add(
        table(
            [
                "N°",
                "Modèle / sujet / job",
                "Gain enregistré (%)",
                "Statut de provenance",
            ],
            [
                [
                    i + 1,
                    r["model"]
                    + " / "
                    + r["problem"]
                    + " / "
                    + str(r.get("job_id", "")),

#include "knn.h"
#include <omp.h>

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    char labels[k];
    float distances[k];

#pragma omp parallel for private(i)
    for (int i = 0; i < k; i++) {
        labels[i] = -1;
        distances[i] = -1;
    }

#pragma omp parallel for private(j, x, y) shared(labels, distances) schedule(dynamic)
    for (int i = 0; i < n_groups; i++) {
        Group g = groups[i];

        for (j = 0; j < g.length; j++) {
            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);

#pragma omp critical
            for (x = 0; x < k; x++) {
                if (d < distances[x] || distances[x] == -1) {
                    for (y = k - 1; y > x; y--) {
                        distances[y] = distances[y - 1];
                        labels[y] = labels[y - 1];
                    }

                    distances[x] = d;
                    labels[x] = g.label;

                    break;
                }
            }
        }
    }

    qsort(labels, k, sizeof(char), compare_for_sort);

    int frequency[n_groups];
#pragma omp parallel for private(i)
    for (int i = 0; i < n_groups; i++) {
        frequency[i] = 0;
    }

#pragma omp parallel for private(i, j) reduction(+:frequency[:n_groups]) schedule(dynamic)
    for (i = 0; i < k; i++) {
        for (j = 0; j < n_groups; j++) {
            if (labels[i] == groups[j].label) {
#pragma omp atomic
                frequency[j]++;
                break;
            }
        }
    }

    char most_frequent = labels[0];
    int max_frequency = 0;

#pragma omp parallel for private(i) reduction(max:max_frequency)
    for (int i = 0; i < n_groups; i++) {
        if (frequency[i] > max_frequency) {
            max_frequency = frequency[i];
            most_frequent = groups[i].label;
        }
    }

    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}
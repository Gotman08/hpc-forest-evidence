      "content": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nusing ll = long long;\n\nconstexpr int kMaxDimension = 1000;\n\nalignas(64) int input_by_axis[kMaxDimension][kMaxDimension];\nalignas(64) int prefix_by_axis[kMaxDimension + 1][kMaxDimension];\n\nclass alignas(64) PrefixFrequency {\n  static constexpr std::size_t kCapacity = 2048;\n  static constexpr std::size_t kMask = kCapacity - 1;\n\n  ll keys_[kCapacity];\n  std::uint16_t counts_[kCapacity];\n  std::uint32_t epochs_[kCapacity]{};\n  std::uint32_t epoch_ = 1;\n\n  static std::size_t hash_slot(ll key) noexcept {\n    std::uint64_t x = static_cast<std::uint64_t>(key);\n    x += 0x9e3779b97f4a7c15ULL;\n    x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;\n    x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;\n    x ^= x >> 31;\n    return static_cast<std::size_t>(x) & kMask;\n  }\n\n  std::size_t locate(ll key) const noexcept {\n    std::size_t slot = hash_slot(key);\n    while (epochs_[slot] == epoch_ && keys_[slot] != key) {\n      slot = (slot + 1) & kMask;\n    }\n    return slot;\n  }\n\n  ll lookup(ll key) const noexcept {\n    const std::size_t slot = locate(key);\n    return epochs_[slot] == epoch_ ? static_cast<ll>(counts_[slot]) : 0;\n  }\n\n public:\n  void reset() noexcept {\n    if (++epoch_ == 0) {\n      std::memset(epochs_, 0, sizeof(epochs_));\n      epoch_ = 1;\n    }\n  }\n\n  void increment(ll key) noexcept {\n    const std::size_t slot = locate(key);\n    if (epochs_[slot] == epoch_) {\n      ++counts_[slot];\n    } else {\n      epochs_[slot] = epoch_;\n      keys_[slot] = key;\n      counts_[slot] = 1;\n    }\n  }\n\n  ll query_then_increment(ll sum, ll target) noexcept {\n    if (target == 0) {\n      const std::size_t slot = locate(sum);\n      if (epochs_[slot] == epoch_) {\n        const ll matches = static_cast<ll>(counts_[slot]);\n        ++counts_[slot];\n        return matches;\n      }\n      epochs_[slot] = epoch_;\n      keys_[slot] = sum;\n      counts_[slot] = 1;\n      return 0;\n    }\n\n    const ll matches = lookup(sum - target);\n    increment(sum);\n    return matches;\n  }\n};\n\nstatic inline ll count_for_left(int left, int pair_dimension,\n                                int scan_dimension, ll target,\n                                PrefixFrequency& frequencies) {\n  const int* lower = prefix_by_axis[left - 1];\n  ll subtotal = 0;\n\n  for (int right = left; right <= pair_dimension; ++right) {\n    frequencies.reset();\n    frequencies.increment(0);\n\n    const int* upper = prefix_by_axis[right];\n    ll sum = 0;\n    for (int position = 0; position < scan_dimension; ++position) {\n      sum += static_cast<ll>(upper[position]) -\n             static_cast<ll>(lower[position]);\n      subtotal += frequencies.query_then_increment(sum, target);\n    }\n  }\n\n  return subtotal;\n}\n\nstatic ll count_submatrices(int pair_dimension, int scan_dimension, int k) {\n  ll answer = 0;\n  const ll target = static_cast<ll>(k);\n  const ll work = static_cast<ll>(pair_dimension) * (pair_dimension + 1) /\n                  2 * scan_dimension;\n\n#ifdef _OPENMP\n#pragma omp parallel if (work >= 131072) reduction(+: answer)\n  {\n    PrefixFrequency frequencies;\n#pragma omp for schedule(dynamic, 1)\n    for (int left = 1; left <= pair_dimension; ++left) {\n      answer += count_for_left(left, pair_dimension, scan_dimension, target,\n                               frequencies);\n    }\n  }\n#else\n  {\n    PrefixFrequency frequencies;\n    for (int left = 1; left <= pair_dimension; ++left) {\n      answer += count_for_left(left, pair_dimension, scan_dimension, target,\n                               frequencies);\n    }\n  }\n#endif\n\n  return answer;\n}\n\nstatic ll solve(int pair_dimension, int scan_dimension, int k) {\n  std::fill(prefix_by_axis[0], prefix_by_axis[0] + scan_dimension, 0);\n\n  for (int axis = 1; axis <= pair_dimension; ++axis) {\n    const int* source = input_by_axis[axis - 1];\n    const int* previous = prefix_by_axis[axis - 1];\n    int* current = prefix_by_axis[axis];\n#ifdef _OPENMP\n#pragma omp simd\n#else\n#pragma GCC ivdep\n#endif\n    for (int position = 0; position < scan_dimension; ++position) {\n      current[position] = previous[position] + source[position];\n    }\n  }\n\n  return count_submatrices(pair_dimension, scan_dimension, k);\n}\n\nint main() {\n  ios::sync_with_stdio(false);\n  cin.tie(nullptr);\n\n  int k, m, n;\n  if (!(cin >> k >> m >> n)) {\n    return 0;\n  }\n\n  int pair_dimension;\n  int scan_dimension;\n  if (n <= m) {\n    pair_dimension = n;\n    scan_dimension = m;\n    for (int row = 0; row < m; ++row) {\n      for (int column = 0; column < n; ++column) {\n        cin >> input_by_axis[column][row];\n      }\n    }\n  } else {\n    pair_dimension = m;\n    scan_dimension = n;\n    for (int row = 0; row < m; ++row) {\n      for (int column = 0; column < n; ++column) {\n        cin >> input_by_axis[row][column];\n      }\n    }\n  }\n\n  cout << solve(pair_dimension, scan_dimension, k) << '\\n';\n  return 0;\n}\n",
      "path": "src/main.cpp"
    }
  ],
  "hypothesis": "Making the shorter axis the interval axis enables a legal SIMD prefix build over independent positions and exposes independent left-boundary work for the four-core target, while retaining ordered prefix-frequency semantics.",
  "notes": "The stateful frequency scan remains scalar and queries s-k before inserting s. OpenMP has a serial fallback when unavailable.",

trace = native.verify_trace_members(qualification, lambda name: inner["official-evaluator-trace/" + name],
                                    read_prepared_member=lambda name: inner["prepared/" + name])
assert trace["original_archive_links_verified"] is True and trace["cluster_paths_followed_locally"] is False
assert trace["phases"] == ["search", "confirmation"] and trace["evaluator_executions"] == 14 and trace["case_executions"] == 13

assert envelope["prepared_root_identity"]["verified"] is True
# Only the sealed LOCAL source may be imported after an exact current inventory.
local_before = inventory(PROJECT)
assert all(local_before.get(name) == checksum for name, checksum in runtime.items())
assert all(name.startswith((".pytest_cache/", ".ruff_cache/")) for name in set(local_before) - set(runtime))
assert not any(name == "hpc_forest" or name.startswith("hpc_forest.") for name in sys.modules)
def blocked(*args, **kwargs):
    raise AssertionError("Cold audit forbids process/signal/socket effects")
class NoEffectsPopen(subprocess.Popen):
    def __new__(cls, *args, **kwargs):
        raise AssertionError("Cold audit forbids native process construction")
class NoEffectsSocket(socket.socket):
    def __new__(cls, *args, **kwargs):
        raise AssertionError("Cold audit forbids native socket construction")
subprocess.Popen = NoEffectsPopen
socket.socket = NoEffectsSocket
for name in ("run", "call", "check_call", "check_output"):
    setattr(subprocess, name, blocked)
for name in ("system", "kill", "killpg"):
    setattr(os, name, blocked)
sys.dont_write_bytecode = True
sys.path.insert(0, str(PROJECT / "src"))
from hpc_forest import native_r2max as native
assert Path(native.__file__).resolve() == (PROJECT / "src/hpc_forest/native_r2max.py").resolve()
native.verify_qualification(qualification, SOURCE_SHA, prepared=False)
prepared = native.verify_preparation(restored / "extraction/certified-preparation")

PLAN_SHA = "4b430e181948e55e463dfd1e60bdce96308a9190534734feb22354e4116ebde9"
observed = {}

def digest(raw):
    return hashlib.sha256(raw).hexdigest()

def read(path, expected=None):
    assert path.is_file() and not path.is_symlink(), str(path)
    raw = path.read_bytes()
    checksum = digest(raw)
    assert expected is None or checksum == expected, "Input SHA mismatch: " + str(path)
    observed[path] = checksum
    return raw

def load(path, expected=None):
    return json.loads(read(path, expected))

def canonical(name):
    path = PurePosixPath(name)
    assert isinstance(name, str) and name and str(path) == name and not path.is_absolute()
    assert not any(part in ("", ".", "..") for part in path.parts)
    assert "\\" not in name and ":" not in name and all(ord(char) >= 32 for char in name)
    return path

def tar_members(raw, prefix):
    assert len(raw) <= 64 * 1024**2
    result, folded, total = {}, set(), 0
    with tarfile.open(fileobj=io.BytesIO(raw), mode="r:gz") as archive:
        for member in archive:
            path = canonical(member.name)
            assert member.isfile() and not member.issym() and not member.islnk()
            assert path.parts[0] == prefix and len(path.parts) > 1
            key = path.relative_to(prefix).as_posix()
            assert key not in result and key.casefold() not in folded
            total += member.size
            assert 0 <= member.size <= 8 * 1024**2 and total <= 64 * 1024**2 and len(result) < 1000
            stream = archive.extractfile(member)
            assert stream is not None
            value = stream.read(member.size + 1)
            assert len(value) == member.size
            result[key] = value
            folded.add(key.casefold())
    return result

def inventory(folder):
    result = {}
    for path in sorted(folder.rglob("*")):
        assert not path.is_symlink()
        if path.is_file():
            assert path.stat().st_nlink == 1
            result[path.relative_to(folder).as_posix()] = digest(path.read_bytes())
    return result

def save(name, value):
    with (HERE / name).open("x", encoding="utf-8", newline="\n") as stream:
        stream.write(json.dumps(value, indent=2, ensure_ascii=True) + "\n")

submission = load(REL / "operations-parent-Q/submission.json")["structuredContent"]
assert submission["ok"] is True and submission["submitted"] is True and submission["submission_observed"] is True
assert submission["job_id"] == JOB

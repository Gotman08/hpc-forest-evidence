    "parent_audit_sha256": observed[RECEIVED / "audit-natif-parent-r2.json"],
    "source_zip_sha256": SOURCE_SHA, "plan_sha256": PLAN_SHA, "bundle_sha256": bindings["payload_sha256"],
    "runtime_manifest_sha256": bindings["runtime_manifest_sha256"], "bundle_manifest_sha256": bindings["bundle_manifest_sha256"],
    "triple_announced_remote_local_SHA_identical": True, "scheduler_state": status["state"],
    "scheduler_exit_code": status["exit_code"], "scheduler_elapsed_seconds": efficiency["elapsed_seconds"],
    "fresh_restored_files": len(material), "restored_inventory_before_after_identical": True,
    "source_files_verified": 108, "exact_extraction_inventory_files": len(actual_inputs),
    "neutral_cases_passed_once": 110, "neutral_suites": counts, "certified_unique_reference_cases": 12,
    "original_receipt_and_inner_members_byte_identical": True, "trace_links": trace,
    "zero_model_calls_recorded_and_reviewed_Q_command_excludes_CLI_and_authentication": True,

sources, folded = {}, set()
with zipfile.ZipFile(io.BytesIO(source_raw)) as archive:
    assert len(archive.infolist()) == 108
    for member in archive.infolist():
        path = canonical(member.filename)
        assert path.parts[0] == "HPC-Forest" and len(path.parts) > 1
        assert not member.is_dir() and ((member.external_attr >> 16) & 0o170000) in (0, 0o100000)

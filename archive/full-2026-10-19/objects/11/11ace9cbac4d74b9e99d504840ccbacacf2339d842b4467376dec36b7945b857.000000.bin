    "old_Q752606_archive_read_or_reaudited": False,
    "input_file_sha256": {str(path): checksum for path, checksum in sorted(observed.items())},
    "inventory_before_sha256": digest((HERE / "inventaire-avant-independant.json").read_bytes()),
    "inventory_after_sha256": digest((HERE / "inventaire-apres-independant.json").read_bytes()),
}
save("REVUE-FROIDE-INDEPENDANTE-Q753285.json", report)

"""Version only the external independent-review binding; never finalize policy."""
from pathlib import Path
import ast
import difflib
import hashlib
import json

HERE = Path(__file__).resolve().parent
old = HERE.parent / "preparer-policy-routes.py"
before = old.read_bytes()
assert hashlib.sha256(before).hexdigest() == "c9b4dad657e1783fcb37ad7ae51222a3bc9365a5ed6946457b94220443d60e71"
text = before.decode("utf8")
text = text.replace('HERE = Path(__file__).resolve().parent','HERE = Path(__file__).resolve().parents[1]  # Preserve original explicit preparation/output anchor.')
text = text.replace('    args = p.parse_args()', '''    p.add_argument("--integration-review", type=Path)
    p.add_argument("--integration-review-sha256")
    args = p.parse_args()''')
text = text.replace('    qref = None\n', '    qref = None\n    review_ref = {"path":str(REVIEW),"sha256":REVIEW_SHA}  # Historical template ancestor only.\n')
text = text.replace('        need(args.qualification_reception_sha256 and bilan["fresh_initial_admission_verified"] is True,',
'''        need(args.qualification_reception_sha256 and args.integration_review and args.integration_review_sha256
             and bilan["fresh_initial_admission_verified"] is True,''')
text = text.replace('        contract = {"Path":Path,',
'''        review_ref = {"path":str(io["ordinary"](args.integration_review)),"sha256":args.integration_review_sha256}
        need(Path(review_ref["path"]).is_relative_to(PREP),"Actual external observer/integration review must remain inside this preparation")
        contract = {"Path":Path,''')
text = text.replace('contract["integration_review"]({"path":str(REVIEW),"sha256":REVIEW_SHA},CHAIN)', 'contract["integration_review"](review_ref,CHAIN)')
text = text.replace('own_review = read({"path":str(REVIEW),"sha256":REVIEW_SHA})', 'own_review = read(review_ref)')
text = text.replace('need(args.qualification_reception_sha256 is None,"No future Q SHA without real Q file")',
'''need(args.qualification_reception_sha256 is None and args.integration_review is None
             and args.integration_review_sha256 is None,"No future Q/review binding without actual finalization")''')
text = text.replace('"integration_review":{"path":str(REVIEW),"sha256":REVIEW_SHA},"observer_review":{"path":str(REVIEW),"sha256":REVIEW_SHA},',
                  '"integration_review":review_ref,"observer_review":review_ref,')
ast.parse(text)
target = HERE / "preparer-policy-routes-r2.py"
with target.open("x",encoding="utf8",newline="\n") as stream:
    stream.write(text)
with (HERE / "DIFF-FINALISEUR-R1-R2.patch").open("x",encoding="utf8",newline="\n") as stream:
    stream.write("".join(difflib.unified_diff(before.decode("utf8").splitlines(True),text.splitlines(True),fromfile="preparer-policy-routes-r1",tofile="preparer-policy-routes-r2")))
report = {"schema":"hpc-forest-source110-OBS4-review-ref-closed-delta-v1","prepared_only":True,
          "old_finalizer_sha256":hashlib.sha256(before).hexdigest(),"new_finalizer_sha256":hashlib.sha256(target.read_bytes()).hexdigest(),
          "original_output_anchor_preserved":True,"old_review714_preserved":True,"components62_or_qualification_changed":False,
          "actual_new_independent_review_received":False,"future_Q_branch_still_failclosed_without_review":True,
          "required_new_review_top_level":["observer_sha256","abi_sha256"],
          "required_shared_reference":"policy.observer_review == policy.integration_review == future authorization.artifacts.integration_review",
          "parent_intent_adapter714_still_requires_separate_isolated_rebinding":True,
          "policy_or_observer_finalized_or_started":False}
with (HERE / "DELTA-FERME-FINALISEUR-R2.json").open("x",encoding="utf8",newline="\n") as stream:
    json.dump(report,stream,indent=2);stream.write("\n")
print(json.dumps(report))

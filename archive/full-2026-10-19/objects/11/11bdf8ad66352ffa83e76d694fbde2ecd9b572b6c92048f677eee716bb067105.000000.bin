{
  "src/solution.cpp": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n    vector<vector<int> > blocked(n);\n    for (int c = 0; c < m; ++c) {\n        int i, j;\n        cin >> i >> j;\n        blocked[i].push_back(j);\n    }\n    for (auto &row : blocked) {\n        sort(row.begin(), row.end());\n        row.erase(unique(row.begin(), row.end()), row.end());\n    }\n\n    vector<int> dp(n, 0);\n    dp[0] = 1;\n    for (int i = 0; i < n; ++i) {\n        int begin = 0;\n        int left = 0;\n        const auto &row = blocked[i];\n        for (size_t b = 0; b <= row.size(); ++b) {\n            const int end = b < row.size() ? row[b] : n;\n            for (int j = begin; j < end; ++j) {\n                int value = dp[j] + left;\n                if (value >= MOD) value -= MOD;\n                dp[j] = value;\n                left = value;\n            }\n            if (end < n) {\n                dp[end] = 0;\n                left = 0;\n                begin = end + 1;\n            }\n        }\n    }\n    cout << dp[n - 1] << '\\n';\n}\n"
}

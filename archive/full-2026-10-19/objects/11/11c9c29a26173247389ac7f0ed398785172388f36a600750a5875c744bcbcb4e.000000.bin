#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    float x;
    float y;
} Point;

typedef struct {
    char label;
    int length;
    float * restrict xs;
    float * restrict ys;
} Group;

void on_error() {
    printf("Invalid input file.\n");
    exit(1);
}

int parse_number_of_groups() {
    int n;
    if (scanf(" n_groups=%d ", &n) != 1) on_error();
    return n;
}

Point parse_point() {
    float x, y;
    if (scanf(" (%f ,%f) ", &x, &y) != 2)  on_error();
    Point point;
    point.x = x;
    point.y = y;
    return point;
}

Group parse_next_group() {
    char label; 
    int length;
    if (scanf(" label=%c ", &label) != 1) on_error();
    if (scanf(" length=%d ", &length) != 1) on_error();

    Group group;
    group.label = label;
    group.length = length;

    // Allocate xs and ys with 16-byte alignment for faster NEON loads
    void *xs_ptr, *ys_ptr;
    if (posix_memalign(&xs_ptr, 16, sizeof(float) * length) != 0 ||
        posix_memalign(&ys_ptr, 16, sizeof(float) * length) != 0) {
        on_error();
    }
    group.xs = (float *) xs_ptr;
    group.ys = (float *) ys_ptr;

    for (int i = 0; i < length; i++) {
        Point p = parse_point();
        group.xs[i] = p.x;
        group.ys[i] = p.y;
    }

    return group;
}

int parse_k() {
    int k;
    if (scanf(" k=%d ", &k) != 1) on_error();
    return k;
}

static inline float euclidean_distance_no_sqrt(Point a, Point b) {
    return ((b.x - a.x) * (b.x - a.x)) + ((b.y - a.y) * (b.y - a.y));
}

int compare_for_sort(const void *a, const void *b) {
  return *(char*)a - *(char*)b;
}

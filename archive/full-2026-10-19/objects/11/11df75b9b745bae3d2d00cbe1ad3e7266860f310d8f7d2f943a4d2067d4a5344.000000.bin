      "content": "#include <iostream>\n#include <vector>\n#include <utility>\n\nusing namespace std;\n\ntypedef vector<vector<unsigned char>> adjacency_matrix;\n\nstruct PermutationMismatch {\n    int row;\n    int column;\n    unsigned char expected;\n};\n\nadjacency_matrix readGraph();\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence, PermutationMismatch &mismatch);\ninline void printPermutation(vector<int> &equivalence);\n\nint main(){\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if(!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\n    vector<int> equivalence(g1.size(), 0);\n    vector<int> exchange_counter(g1.size(), 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n    PermutationMismatch mismatch = {-1, 0, 0};\n\n    if(g1.size() != g2.size()) return false;\n\n    for(int i = 0; i < equivalence.size(); ++i)\n        equivalence[i] = i;\n\n    if(verifyPermutation(g1, g2, equivalence, mismatch)){\n        printPermutation(equivalence);\n        return true;\n    }\n\n    /*\n     * Preserve Heap's permutation sequence exactly. A failed adjacency\n     * comparison remains a rejection certificate until an endpoint moves.\n     */\n    while(exchange_index < g1.size()){\n        if(exchange_counter[exchange_index] < exchange_index){\n            const int exchange_partner = exchange_index % 2 == 0\n                ? 0 : exchange_counter[exchange_index];\n            swap(equivalence[exchange_partner], equivalence[exchange_index]);\n\n            // The witness column is its smaller endpoint, and both swapped\n            // positions are at most exchange_index. A missing witness uses\n            // column zero so that every subsequent mapping is checked.\n            if(exchange_index >= mismatch.column){\n                bool needs_verification = mismatch.row < 0;\n                if(!needs_verification &&\n                   (exchange_partner == mismatch.row ||\n                    exchange_partner == mismatch.column ||\n                    exchange_index == mismatch.row ||\n                    exchange_index == mismatch.column)){\n                    needs_verification =\n                        g2[equivalence[mismatch.row]][equivalence[mismatch.column]]\n                        == mismatch.expected;\n                }\n\n                if(needs_verification &&\n                   verifyPermutation(g1, g2, equivalence, mismatch)){\n                    printPermutation(equivalence);\n                    isomorphism_found = true;\n                }\n            }\n\n            exchange_counter[exchange_index]++;\n            exchange_index = 1;\n        }else{\n            exchange_counter[exchange_index] = 0;\n            exchange_index++;\n        }\n    }\n    return isomorphism_found;\n}\n\nadjacency_matrix readGraph(){\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read(vertices);\n    for (int i = 0; i < vertices; ++i)\n        read[i].resize(vertices);\n\n    cin >> edges;\n    for (int i = 0; i < edges; i++) {\n       cin >> source >> destination;\n       read[destination][source] = read[source][destination] = true;\n    }\n\n    return read;\n}\n\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence, PermutationMismatch &mismatch){\n    // Higher positions move less frequently in Heap's traversal. Prefer\n    // rejection witnesses involving those positions, while still checking\n    // exactly the original lower triangle, including self-loops.\n    for(int i = static_cast<int>(equivalence.size()) - 1; i >= 0; --i){\n        const auto &source_row = g1[i];\n        const auto &target_row = g2[equivalence[i]];\n        for(int j = i; j >= 0; --j){\n            const unsigned char expected = source_row[j];\n            if(expected != target_row[equivalence[j]]){\n                mismatch.row = i;\n                mismatch.column = j;\n                mismatch.expected = expected;\n                return false;\n            }\n        }\n    }\n    mismatch.row = -1;\n    mismatch.column = 0;\n    return true;\n}\n\ninline void printPermutation(vector<int> &equivalence){\n    for (auto i : equivalence)\n        cout << i << \" \";\n    cout << endl;\n}\n",
      "path": "src/brute_isomorphism.cpp"
    }
  ],
  "hypothesis": "Caching an exact mismatch involving high-index positions should eliminate redundant adjacency verification during Heap's frequent low-index swaps, while preserving every permutation and output byte.",

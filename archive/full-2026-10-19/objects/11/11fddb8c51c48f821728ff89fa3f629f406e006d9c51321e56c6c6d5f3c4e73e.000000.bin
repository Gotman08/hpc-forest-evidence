{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include <algorithm>\\n#include <cstdint>\\n#include <iostream>\\n#include <utility>\\n#include <vector>\\n\\n#if defined(__aarch64__)\\n#include <arm_neon.h>\\n#endif\\n\\nnamespace {\\nconstexpr std::uint32_t MOD = 1000000007u;\\n\\nvoid update_diagonal(const std::uint32_t* __restrict previous,\\n                     std::uint32_t* __restrict current,\\n                     int begin, int end) {\\n    int row = begin;\\n#if defined(__aarch64__)\\n    const uint32x4_t modulus = vdupq_n_u32(MOD);\\n    for (; row + 4 <= end; row += 4) {\\n        const uint32x4_t left = vld1q_u32(previous + row);\\n        const uint32x4_t above = vld1q_u32(previous + row - 1);\\n        const uint32x4_t sum = vaddq_u32(left, above);\\n        // Each sum is below 2*MOD. Unsigned underflow makes the\\n        // subtracted value larger when no reduction is required.\\n        const uint32x4_t reduced =\\n            vminq_u32(sum, vsubq_u32(sum, modulus));\\n        vst1q_u32(current + row, reduced);\\n    }\\n#endif\\n    for (; row < end; ++row) {\\n        const std::uint32_t sum = previous[row] + previous[row - 1];\\n        current[row] = sum >= MOD ? sum - MOD : sum;\\n    }\\n}\\n}\\n\\nint main() {\\n    std::ios::sync_with_stdio(false);\\n    std::cin.tie(nullptr);\\n\\n    int n, m;\\n    if (!(std::cin >> n >> m)) {\\n        return 0;\\n    }\\n\\n    std::vector<std::vector<int>> blocked_by_diagonal(2 * n - 1);\\n    for (int obstacle = 0; obstacle < m; ++obstacle) {\\n        int row, column;\\n        std::cin >> row >> column;\\n        blocked_by_diagonal[row + column].push_back(row);\\n    }\\n\\n    // Index -1 is a permanent zero sentinel. During the growing\\n    // half, entries beyond the previous diagonal are still zero.\\n    std::vector<std::uint32_t> first(n + 1, 0);\\n    std::vector<std::uint32_t> second(n + 1, 0);\\n    std::uint32_t* previous = first.data() + 1;\\n    std::uint32_t* current = second.data() + 1;\\n    previous[0] = blocked_by_diagonal[0].empty() ? 1u : 0u;\\n\\n    for (int diagonal = 1; diagonal < 2 * n - 1; ++diagonal) {\\n        const int begin = std::max(0, diagonal - n + 1);\\n        const int end = std::min(n, diagonal + 1);\\n\\n        // Both predecessors belong to the preceding diagonal,\\n        // so every update in this interval is independent.\\n        update_diagonal(previous, current, begin, end);\\n        for (int row : blocked_by_diagonal[diagonal]) {\\n            current[row] = 0;\\n        }\\n        std::swap(previous, current);\\n    }\\n\\n    std::cout << previous[n - 1] << '\\\\n';\\n    return 0;\\n}\\n\",\n      \"path\": \"src/solution.cpp\"\n    }\n  ],\n  \"hypothesis\": \"Antidiagonal traversal removes the horizontal dependency, enabling four-lane ARM NEON updates without row copies or obstacle branches inside the SIMD loop.\",\n  \"notes\": \"Unmeasured. Retains exact O(n²+m) dynamic programming with O(n+m) storage; handles duplicate blockers, blocked endpoints and n=1.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Replace row-wise recurrence with two rolling, zero-padded antidiagonal buffers.\",\n    \"Group blockers by antidiagonal and zero their results before advancing.\",\n    \"Use bounded unsigned NEON modular addition with a portable scalar fallback.\",\n    \"Disable synchronized iostream input.\"\n  ]\n}"}}

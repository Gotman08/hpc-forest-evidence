#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <cstddef>

static long long best_window(const std::vector<long long>& columns, int width) {
    long long sum = 0;
    for (int col = 0; col < width; ++col)
        sum += columns[col];

    long long best = sum;
    for (std::size_t col = static_cast<std::size_t>(width); col < columns.size(); ++col) {
        sum += columns[col] - columns[col - width];
        if (sum > best)
            best = sum;
    }
    return best;
}

int main() {
    int n, s;
    std::cin >> n >> s;
    const std::size_t stride = static_cast<std::size_t>(n);
    std::vector<int> matrix(stride * stride);
    for (int i = 0; i < n; ++i)
        for (int j = 0; j < n; ++j)
            scanf("%d", &matrix[static_cast<std::size_t>(i) * stride + j]);

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    // Column totals for the current s-row strip.
    std::vector<long long> columns(n, 0);
    for (int i = 0; i < s; ++i) {
        const int* row = matrix.data() + static_cast<std::size_t>(i) * stride;
        for (int j = 0; j < n; ++j)
            columns[j] += row[j];
    }

    long long mxSum = best_window(columns, s);
    for (int bottom = s; bottom < n; ++bottom) {
        const int* entering = matrix.data() + static_cast<std::size_t>(bottom) * stride;
        const int* exiting = matrix.data() + static_cast<std::size_t>(bottom - s) * stride;
        for (int j = 0; j < n; ++j)
            columns[j] += static_cast<long long>(entering[j])
                        - static_cast<long long>(exiting[j]);

        const long long stripBest = best_window(columns, s);
        if (stripBest > mxSum)
            mxSum = stripBest;
    }

    printf("%lld\n", mxSum);
    return 0;
}

#include <algorithm>
#include <cstddef>
#include <cstdio>
#include <iostream>
#include <iterator>
#include <string>

class BufferedOutput
{
    enum { buffer_capacity = 64 * 1024 };
    char buffer_[buffer_capacity];
    std::size_t used_;

public:
    BufferedOutput () : used_ (0) {}

    ~BufferedOutput ()
    {
        flush () ;
    }

    void flush ()
    {
        if (used_ != 0) {
            std::fwrite (buffer_, 1, used_, stdout) ;
            used_ = 0;
        }
    }

    void put (char c)
    {
        if (used_ == buffer_capacity) flush () ;
        buffer_[used_++] = c;
    }

    void write_permutation (const std::string& text)
    {
        const std::size_t count = text.size () ;
        if (count <= static_cast <std::size_t> ((buffer_capacity - 4) / 2)) {
            const std::size_t line_size = 2 * count + 4;
            if (used_ + line_size > buffer_capacity) flush () ;

            char* line = buffer_ + used_;
            line [0] = '[' ;
            line [1] = ' ' ;
#if defined(__GNUC__)
#pragma GCC ivdep
#endif
            for (std::size_t i = 0 ; i < count ; ++ i) {
                line [2 + 2 * i] = text [i] ;
                line [3 + 2 * i] = ' ' ;
            }
            line [2 + 2 * count] = ']' ;
            line [3 + 2 * count] = '\n' ;
            used_ += line_size;
            return;
        }

        put ('[') ;
        put (' ') ;
        for (std::string::const_iterator it = text.begin () ; it != text.end () ; ++it) {
            put (*it) ;
            put (' ') ;
        }
        put (']') ;
        put ('\n') ;
    }
} ;

struct PrintPermutation
{
    BufferedOutput& output;

    explicit PrintPermutation (BufferedOutput& out) : output (out) {}

    auto operator () (const std::string& text) const -> void
    {
        output.write_permutation (text) ;
    }
} ;

struct IsWhitespace
{
    template <typename Char> auto
    operator () (Char c) const -> bool
    {
        return (c == ' ' )
            || (c == '\n')
            || (c == '\r')
            || (c == '\t')
            || (c == '\f')
            || (c == '\v') ;
    }
} ;

template <typename String> inline auto
remove_whitespaces (String text) -> String
{
    text.erase
        ( std::remove_if
            ( text.begin ()
            , text.end ()
            , IsWhitespace () )
        , text.end () ) ;
    return text ;
}

inline auto
next_permutation (std::string& text) -> bool
{
    if (text.size () < 2) return false;

    std::size_t suffix = text.size ();
    while ((suffix > 1) && (text [suffix - 2] >= text [suffix - 1])) {
        --suffix;
    }
    if (suffix == 1) return false;

    const std::size_t pivot = suffix - 2;
    std::size_t successor = text.size () - 1;
    while (text [successor] <= text [pivot]) {
        --successor;
    }
    std::swap (text [pivot], text [successor]) ;
    std::reverse (text.begin () + (suffix - 1), text.end ()) ;
    return true;
}

template <typename String, typename Function> inline auto
permutations (String text, Function& driver) -> void
{
    if (text.empty ()) return;
    std::sort (text.begin (), text.end ()) ;
    do {
        driver (text) ;
    } while (::next_permutation (text)) ;
}

template <typename String, typename InStream> inline auto
read_text_from_stdin (InStream& in) -> String
{
    std::istreambuf_iterator <char> begin (in), end ;
    std::string text (begin, end) ;
    text = remove_whitespaces (text) ;
    return text ;
}

int main (int argc, char const *argv [])
{
    std::ios::sync_with_stdio (false) ;
    std::cin.tie (nullptr) ;
    std::string text = read_text_from_stdin <std::string> (std::cin) ;
    BufferedOutput output;
    PrintPermutation printer (output);
    permutations (text, printer) ;
    return 0;
}
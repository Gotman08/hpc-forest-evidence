#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>

#if defined(__aarch64__) && defined(__ARM_NEON)
#include <arm_neon.h>
#endif

#define MAXNUM 100
#define MAXSTR 50
#define MAXRESULTS 1000
#define MAX_TRIAL_FACTOR 65535u
#define TRIAL_CAPACITY ((MAX_TRIAL_FACTOR + 1u) / 2u)

char firstHalf[MAXNUM][MAXSTR];
char secondHalf[MAXNUM][MAXSTR];
char strToTest[MAXSTR];
long int result[MAXRESULTS];
int numPrimes=0;

static uint32_t trial_square[TRIAL_CAPACITY];
static uint32_t trial_inverse[TRIAL_CAPACITY];
static uint32_t trial_threshold[TRIAL_CAPACITY];
static unsigned int trial_count=0;
static int trial_ready=0;

static void initialize_trial_divisors(void)
{
    static unsigned char composite[MAX_TRIAL_FACTOR + 1u];
    memset(composite, 0, sizeof composite);
    trial_count=0;

    for (uint32_t p=3u; p<=MAX_TRIAL_FACTOR; p+=2u) {
        if (composite[p])
            continue;

        uint32_t inverse=1u;
        for (int step=0; step<5; ++step)
            inverse *= 2u - p * inverse;

        uint32_t square=p*p;
        trial_square[trial_count]=square;
        trial_inverse[trial_count]=inverse;
        trial_threshold[trial_count]=UINT32_MAX/p;
        ++trial_count;

        if (square<=MAX_TRIAL_FACTOR) {
            for (uint32_t multiple=square;
                 multiple<=MAX_TRIAL_FACTOR; multiple+=2u*p)
                composite[multiple]=1;
        }
    }
    trial_ready=1;
}

int isprime(long int value)
{
    if (value<2)
        return 0;
    if ((value & 1L)==0)
        return value==2;

    if ((uint64_t)value>UINT32_MAX) {
        for (long int factor=3; factor<=value/factor; factor+=2)
            if (value%factor==0)
                return 0;
        return 1;
    }

    uint32_t n=(uint32_t)value;
    if (!trial_ready)
        initialize_trial_divisors();

    unsigned int i=0;
#if defined(__aarch64__) && defined(__ARM_NEON)
    uint32x4_t input=vdupq_n_u32(n);
    for (; i+3u<trial_count && trial_square[i+3u]<=n; i+=4u) {
        uint32x4_t products=vmulq_u32(
            input, vld1q_u32(trial_inverse+i));
        uint32x4_t divides=vcleq_u32(
            products, vld1q_u32(trial_threshold+i));
        if (vmaxvq_u32(divides)!=0u)
            return 0;
    }
#endif

    /* For odd p, n is divisible by p exactly when the wrapped
       product n*inverse(p) is at most UINT32_MAX/p. */
    for (; i<trial_count && trial_square[i]<=n; ++i)
        if ((uint32_t)(n*trial_inverse[i])<=trial_threshold[i])
            return 0;
    return 1;
}

void quicksort(long int *primes,int first,int last)
{ int i, j, pivot;
  long int temp;

  if (first<last)
     { pivot=first;
       i=first;
       j=last;
       while(i<j)
         { while (primes[i]<=primes[pivot]&&i<last)
             i++;
           while(primes[j]>primes[pivot])
             j--;
           if (i<j)
              { temp=primes[i];
                primes[i]=primes[j];
                primes[j]=temp;
              }
         }
       temp=primes[pivot];
       primes[pivot]=primes[j];
       primes[j]=temp;
       quicksort(primes,first,j-1);
       quicksort(primes,j+1,last);
     }
}

int main(int argc,char** argv)
{ FILE *primesFile;
  int i=0,j=0,numResults=0;
  long int primeToTest;
  primesFile=stdin;
  fscanf(primesFile,"%d\n",&numPrimes);
  for (i=0;i<numPrimes;i++)
      fscanf(primesFile,"%s\n",firstHalf[i]);
  for (i=0;i<numPrimes;i++)
      fscanf(primesFile,"%s\n",secondHalf[i]);
  fclose(primesFile);
  for (i=0;i<numPrimes;i++)
      for (j=0;j<numPrimes;j++)
          { strcpy(strToTest,firstHalf[i]);
            strcat(strToTest,secondHalf[j]);
            primeToTest=atol(strToTest);
            if (isprime(primeToTest))
               { result[numResults++]=primeToTest;
               }
          }
  quicksort(result,0,numResults-1);
  for (i=0;i<numResults;i++)
      printf("%ld\n",result[i]);
  return 0;
}

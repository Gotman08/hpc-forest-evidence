        "files": [
          "src/npbonacci.cpp"
        ],
        "retained": [
          "Compute x^(H-1) modulo the characteristic polynomial and combine its coefficients with the initial terms.",
          "Use left-to-right exponentiation with polynomial squaring and linear-time multiplication by x.",
          "Keep canonical coefficients and reversed weights in contiguous 32-bit arrays; reuse one 64-bit workspace and track active polynomial support.",
          "Exploit squaring symmetry and accumulate products in bounded batches of sixteen.",
          "Reduce dependent polynomial degrees downward in sixteen-degree blocks, using contiguous coefficient updates and periodic normalization."
        ]
      },
      "hypothesis": "Replacing dense companion matrices with compact characteristic-polynomial residues should improve locality and reduce work from O(N^3 log H) to O(N^2 log H), using O(N) storage.",

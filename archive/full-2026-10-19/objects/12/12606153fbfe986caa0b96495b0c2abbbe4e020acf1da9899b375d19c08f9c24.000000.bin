        "content": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nint A[1000][1000];\nint ps[1010][1010];\n\ntypedef long long ll;\n\nclass PrefixFrequencyTable {\n  struct Entry {\n    ll key = 0;\n    uint32_t count = 0;\n    uint32_t generation = 0;\n  };\n\n  vector<Entry> entries;\n  size_t mask;\n  uint32_t generation = 0;\n\n  static size_t hash_key(ll key) {\n    uint64_t x = static_cast<uint64_t>(key);\n    x ^= x >> 30;\n    x *= 0xbf58476d1ce4e5b9ULL;\n    x ^= x >> 27;\n    x *= 0x94d049bb133111ebULL;\n    x ^= x >> 31;\n    return static_cast<size_t>(x);\n  }\n\npublic:\n  explicit PrefixFrequencyTable(size_t max_keys) {\n    size_t capacity = 1;\n    while (capacity < 2 * max_keys)\n      capacity <<= 1;\n    entries.resize(capacity);\n    mask = capacity - 1;\n  }\n\n  void begin_band() {\n    ++generation;\n    if (generation == 0) {\n      for (Entry &entry : entries)\n        entry.generation = 0;\n      generation = 1;\n    }\n    increment(0);\n  }\n\n  uint32_t get(ll key) const {\n    size_t position = hash_key(key) & mask;\n    for (;;) {\n      const Entry &entry = entries[position];\n      if (entry.generation != generation)\n        return 0;\n      if (entry.key == key)\n        return entry.count;\n      position = (position + 1) & mask;\n    }\n  }\n\n  void increment(ll key) {\n    size_t position = hash_key(key) & mask;\n    for (;;) {\n      Entry &entry = entries[position];\n      if (entry.generation != generation) {\n        entry.key = key;\n        entry.count = 1;\n        entry.generation = generation;\n        return;\n      }\n      if (entry.key == key) {\n        ++entry.count;\n        return;\n      }\n      position = (position + 1) & mask;\n    }\n  }\n};\n\nll solve(int m, int n, int k) {\n  for (int i = 1; i <= m; i++) {\n    for (int j = 1; j <= n; j++) {\n      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\n    }\n  }\n  PrefixFrequencyTable h(static_cast<size_t>(m) + 1);\n  ll ans = 0;\n  for (int j = 1; j <= n; j++) // O(m*n^2)\n    for (int l = j; l <= n; l++) {\n      h.begin_band();\n      ll s = 0;\n      for (int i = 1; i <= m; i++) {\n        s += ps[i][l] - ps[i][j - 1];\n        ans += h.get(s - k);\n        h.increment(s);\n      }\n    }\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n  memset(ps, 0, sizeof ps);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n",
        "path": "src/main.cpp"
      }

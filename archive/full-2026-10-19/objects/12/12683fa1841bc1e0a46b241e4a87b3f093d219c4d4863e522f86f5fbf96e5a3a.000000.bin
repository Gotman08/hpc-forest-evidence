      "content": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nusing u64 = uint64_t;\nusing u128 = unsigned __int128;\nstatic constexpr u64 MOD = 1000000007ULL;\n\nstatic vector<u64> multiply_mod(const vector<u64>& lhs,\n                                const vector<u64>& rhs,\n                                const vector<u64>& recurrence) {\n    const int n = static_cast<int>(lhs.size());\n    vector<u128> product(static_cast<size_t>(2 * n - 1), 0);\n\n    for (int i = 0; i < n; ++i) {\n        if (lhs[i] == 0) continue;\n        for (int j = 0; j < n; ++j) {\n            if (rhs[j] != 0) {\n                product[static_cast<size_t>(i + j)] +=\n                    static_cast<u128>(lhs[i]) * rhs[j];\n            }\n        }\n    }\n\n    for (int degree = 2 * n - 2; degree >= n; --degree) {\n        const u64 value = static_cast<u64>(product[degree] % MOD);\n        if (value == 0) continue;\n        for (int j = 1; j <= n; ++j) {\n            const u64 coefficient = recurrence[j - 1];\n            if (coefficient != 0) {\n                product[static_cast<size_t>(degree - j)] +=\n                    static_cast<u128>(value) * coefficient;\n            }\n        }\n    }\n\n    vector<u64> result(static_cast<size_t>(n));\n    for (int i = 0; i < n; ++i) {\n        result[i] = static_cast<u64>(product[i] % MOD);\n    }\n    return result;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    u64 h;\n    if (!(cin >> n >> h)) return 0;\n\n    vector<u64> initial(static_cast<size_t>(n));\n    vector<u64> recurrence(static_cast<size_t>(n));\n    for (u64& value : initial) {\n        cin >> value;\n        value %= MOD;\n    }\n    for (u64& value : recurrence) {\n        cin >> value;\n        value %= MOD;\n    }\n\n    vector<u64> result(static_cast<size_t>(n), 0);\n    result[0] = 1;\n\n    vector<u64> power(static_cast<size_t>(n), 0);\n    if (n == 1) {\n        power[0] = recurrence[0];\n    } else {\n        power[1] = 1;\n    }\n\n    u64 exponent = h - 1;\n    while (exponent != 0) {\n        if (exponent & 1ULL) {\n            result = multiply_mod(result, power, recurrence);\n        }\n        exponent >>= 1ULL;\n        if (exponent != 0) {\n            power = multiply_mod(power, power, recurrence);\n        }\n    }\n\n    u64 answer = 0;\n    for (int i = 0; i < n; ++i) {\n        answer = (answer + result[i] * initial[i]) % MOD;\n    }\n    cout << answer << '\\n';\n    return 0;\n}\n",
      "path": "src/npbonacci.cpp"
    }
  ],
  "hypothesis": "Replacing dense companion-matrix exponentiation with compact Kitamasa polynomial exponentiation should reduce work from O(N^3 log H) to O(N^2 log H). Contiguous coefficient vectors and a wide scratch polynomial also improve locality while avoiding modular reduction on every multiply-add.",
  "notes": "Single-file, serial experiment. Polynomial coefficients are invocation-local, and the N=1 recurrence is handled explicitly. No commands were executed or measurements made.",

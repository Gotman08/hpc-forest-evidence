{
  "src/solution.cpp": "#include <cstdio>\n#include <limits>\n#include <vector>\n\nint main() {\n    int n, s;\n    if (std::scanf(\"%d%d\", &n, &s) != 2) return 0;\n\n    std::vector<int> matrix(static_cast<std::size_t>(n) * n);\n    for (std::size_t i = 0; i < matrix.size(); ++i) {\n        std::scanf(\"%d\", &matrix[i]);\n    }\n\n    std::vector<long long> column_sums(n, 0);\n    for (int r = 0; r < s; ++r) {\n        const int* row = &matrix[static_cast<std::size_t>(r) * n];\n        for (int c = 0; c < n; ++c) {\n            column_sums[c] += row[c];\n        }\n    }\n\n    long long best = std::numeric_limits<long long>::lowest();\n    for (int top = 0; top <= n - s; ++top) {\n        long long window_sum = 0;\n        for (int c = 0; c < s; ++c) {\n            window_sum += column_sums[c];\n        }\n        if (window_sum > best) best = window_sum;\n\n        for (int left = 1; left <= n - s; ++left) {\n            window_sum -= column_sums[left - 1];\n            window_sum += column_sums[left + s - 1];\n            if (window_sum > best) best = window_sum;\n        }\n\n        if (top < n - s) {\n            const int* outgoing = &matrix[static_cast<std::size_t>(top) * n];\n            const int* incoming = &matrix[static_cast<std::size_t>(top + s) * n];\n            for (int c = 0; c < n; ++c) {\n                column_sums[c] -= outgoing[c];\n                column_sums[c] += incoming[c];\n            }\n        }\n    }\n\n    std::printf(\"%lld\\n\", best);\n    return 0;\n}\n"
}

{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <algorithm>\\n#include <array>\\n#include <cstdint>\\n#include <iostream>\\n#include <vector>\\n\\nusing namespace std;\\n\\nclass FrequencyTable {\\n  static constexpr uint32_t table_size = 2048;\\n  static constexpr uint32_t table_mask = table_size - 1;\\n\\n  array<int, table_size> keys_;\\n  array<uint16_t, table_size> counts_;\\n  array<uint32_t, table_size> stamps_{};\\n  uint32_t generation_ = 1;\\n\\n  static uint32_t slot_for(int key) {\\n    uint32_t value = static_cast<uint32_t>(key);\\n    value ^= value >> 16;\\n    value *= 0x7feb352dU;\\n    value ^= value >> 15;\\n    value *= 0x846ca68bU;\\n    value ^= value >> 16;\\n    return value & table_mask;\\n  }\\n\\n public:\\n  void clear() {\\n    ++generation_;\\n    if (generation_ == 0) {\\n      stamps_.fill(0);\\n      generation_ = 1;\\n    }\\n  }\\n\\n  int get(int key) const {\\n    uint32_t slot = slot_for(key);\\n    while (stamps_[slot] == generation_) {\\n      if (keys_[slot] == key)\\n        return counts_[slot];\\n      slot = (slot + 1) & table_mask;\\n    }\\n    return 0;\\n  }\\n\\n  void add(int key) {\\n    uint32_t slot = slot_for(key);\\n    while (stamps_[slot] == generation_) {\\n      if (keys_[slot] == key) {\\n        ++counts_[slot];\\n        return;\\n      }\\n      slot = (slot + 1) & table_mask;\\n    }\\n    stamps_[slot] = generation_;\\n    keys_[slot] = key;\\n    counts_[slot] = 1;\\n  }\\n\\n  int add_and_get_previous(int key) {\\n    uint32_t slot = slot_for(key);\\n    while (stamps_[slot] == generation_) {\\n      if (keys_[slot] == key) {\\n        const int previous = counts_[slot];\\n        ++counts_[slot];\\n        return previous;\\n      }\\n      slot = (slot + 1) & table_mask;\\n    }\\n    stamps_[slot] = generation_;\\n    keys_[slot] = key;\\n    counts_[slot] = 1;\\n    return 0;\\n  }\\n};\\n\\ntemplate <bool ZeroTarget>\\nlong long count_submatrices(const vector<int>& matrix, int bound_count,\\n                            int scan_count, int target) {\\n  const int* const values = matrix.data();\\n  long long answer = 0;\\n\\n#pragma omp parallel reduction(+ : answer)\\n  {\\n    vector<int> strip_sums(scan_count);\\n    FrequencyTable frequency;\\n    long long subtotal = 0;\\n\\n#pragma omp for schedule(dynamic, 1) nowait\\n    for (int first = 0; first < bound_count; ++first) {\\n      fill(strip_sums.begin(), strip_sums.end(), 0);\\n\\n      for (int last = first; last < bound_count; ++last) {\\n        const int* const next_strip =\\n            values + static_cast<size_t>(last) * scan_count;\\n\\n#pragma omp simd\\n        for (int index = 0; index < scan_count; ++index)\\n          strip_sums[index] += next_strip[index];\\n\\n        frequency.clear();\\n        frequency.add(0);\\n        int prefix = 0;\\n\\n        if (ZeroTarget) {\\n          for (int index = 0; index < scan_count; ++index) {\\n            prefix += strip_sums[index];\\n            subtotal += frequency.add_and_get_previous(prefix);\\n          }\\n        } else {\\n          for (int index = 0; index < scan_count; ++index) {\\n            prefix += strip_sums[index];\\n            subtotal += frequency.get(prefix - target);\\n            frequency.add(prefix);\\n          }\\n        }\\n      }\\n    }\\n\\n    answer += subtotal;\\n  }\\n\\n  return answer;\\n}\\n\\nlong long solve(const vector<int>& matrix, int bound_count, int scan_count,\\n                int target) {\\n  if (target == 0)\\n    return count_submatrices<true>(matrix, bound_count, scan_count, target);\\n  return count_submatrices<false>(matrix, bound_count, scan_count, target);\\n}\\n\\nint main() {\\n  ios::sync_with_stdio(false);\\n  cin.tie(nullptr);\\n\\n  int target, rows, columns;\\n  cin >> target >> rows >> columns;\\n\\n  const int bound_count = min(rows, columns);\\n  const int scan_count = max(rows, columns);\\n  vector<int> matrix(static_cast<size_t>(bound_count) * scan_count);\\n\\n  if (rows <= columns) {\\n    for (int row = 0; row < rows; ++row)\\n      for (int column = 0; column < columns; ++column)\\n        cin >> matrix[static_cast<size_t>(row) * scan_count + column];\\n  } else {\\n    for (int row = 0; row < rows; ++row)\\n      for (int column = 0; column < columns; ++column)\\n        cin >> matrix[static_cast<size_t>(column) * scan_count + row];\\n  }\\n\\n  cout << solve(matrix, bound_count, scan_count, target) << '\\\\n';\\n  return 0;\\n}\\n\",\"path\":\"src/main.cpp\"}],\"hypothesis\":\"Starting from the fastest archived layout, compile a dedicated zero-target recurrence so each scanned prefix uses one hash probe rather than a lookup followed by an insertion, while retaining the measured contiguous orientation and OpenMP work distribution for every target.\",\"notes\":\"The fixed table remains safe for all valid dimensions: at most 1,000 prefix entries are live per strip pair, versus 2,048 slots; 16-bit counts and signed 32-bit strip prefixes remain in range.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[\"88d88639dcd249a7\",\"3097b496af6a4fcb\"],\"transformations\":[\"Use the archived min-dimension contiguous rolling-strip orientation, dynamic OpenMP scheduling, SIMD strip accumulation, and per-thread generation-tagged fixed frequency table.\",\"Integrate a guarded target-zero fast path that combines prefix lookup and increment into one open-addressing probe.\"]}"}}

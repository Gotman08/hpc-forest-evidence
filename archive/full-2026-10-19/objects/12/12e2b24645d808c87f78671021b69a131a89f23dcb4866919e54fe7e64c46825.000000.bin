"""Seal the two independent neutral reproductions; no admission or live operation."""

import hashlib
import json
from datetime import datetime, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent
PREP = HERE.parent
LAUNCH = PREP / "lancement-modeles-max-r2"
READER = PREP / "lecture-native-integree-r3"


def ref(path):
    return {"path": str(path), "sha256": hashlib.sha256(path.read_bytes()).hexdigest()}


def load(path):
    return json.loads(path.read_text(encoding="utf8"))


assert ref(LAUNCH / "LIVRAISON-LOCALE.json")["sha256"] == "163ee825e560fb869e97a895d4d25c0367c99fe1a9c94eb2828cbc02aefa8c57"
assert ref(READER / "LIVRAISON-LECTEUR-INTEGRE-R3.json")["sha256"] == "b0d081778f050eef2db898551c9ce1cd37d6ab7228114f66e96ae89e6351465f"
launch_pins = load(LAUNCH / "PINS-POUR-REVUE.json")
reader = load(READER / "LIVRAISON-LECTEUR-INTEGRE-R3.json")
for item in [*launch_pins["code"].values(), *launch_pins["nine_commands"].values(), *reader["components"].values()]:
    assert ref(Path(item["path"])) == item
abi_launch = load(LAUNCH / "READER-ABI.json")
abi_reader = load(READER / "READER-ABI.json")
assert set(abi_launch["refs14"]) == set(abi_reader["ref_names_exact"]) and len(abi_reader["ref_names_exact"]) == 14
assert set(abi_launch["expected11"]) == set(abi_reader["expected_names_exact"]) and len(abi_reader["expected_names_exact"]) == 11
findings = [
    {"id": "P1-CENSUS-UNKNOWN-WORKER", "file": str(LAUNCH / "assemble_admissions.py"), "line": 144,
     "summary": "Unknown hpc_forest.*worker modules and case-variant Windows bootstrap filenames can escape the full-census native worker set.",
     "evidence": ref(HERE / "REFUS-CENSUS-INCONNU.json"),
     "reproduction": "The known codex_worker is refused. An undeclared unrecognized_worker and uppercase BOOTSTRAP_WORKER.PY are accepted on invented rows with a reported pre-start worker count of one.",
     "required_closure": "Use a closed, case-correct Windows argv/native-worker predicate that refuses every unclassified hpc_forest.*worker/bootstrap and test quoted/unquoted/case variants; keep cap4, exact full identities and authorizations strict."},
    {"id": "P1-NATURAL-EXIT-FULL-IDENTITY", "file": str(READER / "receive_phase.py"), "line": 83,
     "summary": "Owned full identity validation is skipped when the expected PIDs are absent from the census.",
     "evidence": ref(HERE / "REFUS-IDENTITES-SORTIE.json"),
     "reproduction": "With the explicit neutral fake-CLI-byte stub, a valid control and three malformed owned-pair variants (null creation time, null executable, boolean parent PID) all return scoped verified/reconciled true. No production receipt is saved.",
     "required_closure": "Validate and normalize each owned identity unconditionally before the PID-filtered absence comparison; preserve tolerance of unrelated system null rows and strict rejection of malformed matched identities."},
]
report = {
    "schema": "hpc-forest-r4b-local-integrations-independent-review-first-refusal-v1",
    "verified": False, "independent_review_performed": True,
    "observed_at_utc": datetime.now(timezone.utc).isoformat(),
    "decision": "BLOCKED_FOR_NATIVE_ADMISSION_PENDING_ISOLATED_CORRECTIONS",
    "scope_id": launch_pins["scope_id"], "source_zip_sha256": launch_pins["source_zip_sha256"], "plan_sha256": launch_pins["plan_sha256"],
    "blocking_findings": findings,
    "deliveries_reviewed": [ref(LAUNCH / "LIVRAISON-LOCALE.json"), ref(LAUNCH / "PINS-POUR-REVUE.json"),
                            ref(READER / "LIVRAISON-LECTEUR-INTEGRE-R3.json"), ref(READER / "READER-ABI.json")],
    "pinned_code_and_commands_rehashed": [*launch_pins["code"].values(), *launch_pins["nine_commands"].values(), *reader["components"].values()],
    "nonblocking_findings": [
        "The two descriptive ABI sets agree exactly: refs14 including execution_sidecar and expected11 including source_cache.",
        "The launcher intentionally keeps advice/harvest import and receipt gates closed; no pilot, historical Luna or automatic extension is admitted.",
        "Requests retain separate raw hashes and authorized whole-JSON digest; the known sidecar, usage subdivisions and closed schema remain linked.",
        "CLI WARN/error/unknown stream and empty roots remain strict NORMAL refusals; original negative Luna is not promoted.",
        "No new allocated qualification or actual future model/session/transport/census evidence is supplied by local preparation alone.",
    ],
    "reviewer_executed_targeted_neutral_cases": {"census_cases": 3, "exit_identity_cases": 4,
        "production_cli_byte_stub_used_for_exit_fixture_only": True, "production_receipts_saved": False,
        "full_author_suites_rerun": False},
    "author_logs_read_not_rerun": [ref(LAUNCH / "tests-final.log"), ref(LAUNCH / "ruff-final.log"),
                                   ref(READER / "tests-neutres-validation-utc.log"), ref(READER / "ruff-final.log")],
    "author_declared_local_test_counts": {"launcher": 77, "reader": 69},
    "additional_external_qualification_stage_status": "Author is preparing a separate zero-model stage package; not reviewed or admitted by this first-refusal receipt.",
    "source_or_author_files_edited": False, "live_census_or_cache_read": False,
    "CLI_or_model_or_worker_started": 0, "remote_or_live_RPC_calls": 0, "C_compilation_or_execution": 0,
    "native_calls_replayed": 0, "native_generation_admitted": False, "NORMAL_or_global_or_performance_admitted": False,
}
output = HERE / "REVUE-PREMIERE-LECTURE-REFUS.json"
with output.open("x", encoding="utf8", newline="\n") as stream:
    json.dump(report, stream, ensure_ascii=False, indent=2, allow_nan=False)
    stream.write("\n")
print(json.dumps(ref(output)))

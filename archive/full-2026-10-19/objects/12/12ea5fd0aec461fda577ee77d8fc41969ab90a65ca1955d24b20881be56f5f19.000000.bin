      "content": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nint A[1000][1000];\ntypedef long long ll;\n\nll solve(int m, int n, int k) {\n  const int p = min(m, n);\n  const int q = max(m, n);\n\n  vector<int> transposed;\n  const int* matrix;\n  int stride;\n  if (m <= n) {\n    matrix = &A[0][0];\n    stride = 1000;\n  } else {\n    transposed.resize(static_cast<size_t>(m) * n);\n    for (int i = 0; i < m; i++) {\n      for (int j = 0; j < n; j++) {\n        transposed[static_cast<size_t>(j) * m + i] = A[i][j];\n      }\n    }\n    matrix = transposed.data();\n    stride = q;\n  }\n\n  ll ans = 0;\n  const ll work = static_cast<ll>(p) * (p + 1) / 2 * q;\n  const bool parallel_work = p >= 8 && work >= 50000;\n\n#pragma omp parallel if(parallel_work) reduction(+:ans)\n  {\n    vector<ll> sums(q, 0);\n    unordered_map<ll, ll> freq;\n    freq.reserve(q + 1);\n\n#pragma omp for schedule(dynamic, 1)\n    for (int top = 0; top < p; top++) {\n      fill(sums.begin(), sums.end(), 0);\n      for (int bottom = top; bottom < p; bottom++) {\n        const int* row = matrix + static_cast<size_t>(bottom) * stride;\n\n        // Each column accumulator is independent; the prefix scan below is not.\n#pragma omp simd\n        for (int x = 0; x < q; x++) {\n          sums[x] += row[x];\n        }\n\n        freq.clear();\n        freq[0] = 1;\n        ll prefix = 0;\n        for (int x = 0; x < q; x++) {\n          prefix += sums[x];\n          auto it = freq.find(prefix - static_cast<ll>(k));\n          if (it != freq.end()) ans += it->second;\n          ++freq[prefix];\n        }\n      }\n    }\n  }\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n\n  for (int i = 0; i < m; i++) {\n    for (int j = 0; j < n; j++) {\n      cin >> A[i][j];\n    }\n  }\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n",
      "path": "src/main.cpp"
    }
  ],
  "hypothesis": "Orient the matrix so the smaller dimension forms the paired strips, reducing strip work for rectangular inputs. For each strip, contiguous independent element-wise accumulator updates are explicitly SIMD-enabled, while the dependent prefix-frequency scan remains sequential.",

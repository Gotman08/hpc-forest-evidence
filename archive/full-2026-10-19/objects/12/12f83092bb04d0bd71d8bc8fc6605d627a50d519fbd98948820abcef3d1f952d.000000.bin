#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <climits>

int main() {
	int n, s;
	std::cin >> n >> s;
	std::vector<std::vector<int>> matrix(n, std::vector<int>(n));
	for (int i = 0; i < n; i++)
		for (int j = 0; j < n; j++) 
			scanf("%d", &(matrix[i][j]));

	assert(s < n);
	assert(n < 8000);
	assert(s > 0);
	assert(n > 0);

	const int blockSize = 32; // Define block size
	int mxSum = INT_MIN;

	for (int bi = 0; bi < n; bi += blockSize) {
		for (int bj = 0; bj < n; bj += blockSize) {
			int currentSum = 0;
			for (int i = bi; i < std::min(bi + blockSize, n); i++) {
				for (int j = bj; j < std::min(bj + blockSize, n); j++) {
					if (i < s && j < s) { // Initialize sum for the first block
						currentSum += matrix[i][j];
					}
				}
			}
			mxSum = std::max(mxSum, currentSum);

			for (int i = bi; i < std::min(bi + blockSize, n); i++) {
				for (int j = bj + blockSize; j < n - s + 1; j += blockSize) {
					currentSum -= matrix[i][j - blockSize];
					currentSum += matrix[i][j + s - 1];
					mxSum = std::max(mxSum, currentSum);
				}
			}

			for (int j = bj; j < std::min(bj + blockSize, n); j++) {
				for (int i = bi + blockSize; i < n - s + 1; i += blockSize) {
					currentSum -= matrix[i - blockSize][j];
					currentSum += matrix[i + s - 1][j];
					mxSum = std::max(mxSum, currentSum);
				}
			}
		}
	}

	printf("%d\n", mxSum);
}
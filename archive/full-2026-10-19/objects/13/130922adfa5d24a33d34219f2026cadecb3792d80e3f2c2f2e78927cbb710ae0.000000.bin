    {
      "content": "#include \"knn.h\"\n\ntypedef struct {\n    float dist;\n    char label;\n    long idx;\n} HeapEntry;\n\nstatic inline int worse_entry(const HeapEntry *a, const HeapEntry *b) {\n    if (a->dist != b->dist) return a->dist > b->dist;\n    return a->idx > b->idx;\n}\n\nstatic inline void swap_entries(HeapEntry *a, HeapEntry *b) {\n    HeapEntry t = *a; *a = *b; *b = t;\n}\n\nstatic inline void sift_up(HeapEntry *heap, int pos) {\n    while (pos > 0) {\n        int parent = (pos - 1) / 2;\n        if (worse_entry(&heap[pos], &heap[parent])) {\n            swap_entries(&heap[pos], &heap[parent]);\n            pos = parent;\n        } else break;\n    }\n}\n\nstatic inline void sift_down(HeapEntry *heap, int start, int end) {\n    int root = start;\n    while (1) {\n        int child = 2 * root + 1;\n        if (child > end) break;\n        int right = child + 1;\n        if (right <= end && worse_entry(&heap[right], &heap[child])) child = right;\n        if (worse_entry(&heap[root], &heap[child])) {\n            swap_entries(&heap[root], &heap[child]);\n            root = child;\n        } else break;\n    }\n}\n\nchar knn(Dataset *ds, int k, Point to_evaluate) {\n    int n = ds->n;\n    float px = to_evaluate.x;\n    float py = to_evaluate.y;\n\n    HeapEntry *heap = (HeapEntry *) malloc(sizeof(HeapEntry) * k);\n    if (!heap) on_error();\n    int heap_size = 0;\n\n    for (int i = 0; i < n; i++) {\n        float dx = ds->xs[i] - px;\n        float dy = ds->ys[i] - py;\n        float d = dx * dx + dy * dy;\n\n        HeapEntry e;\n        e.dist = d;\n        e.label = ds->labels[i];\n        e.idx = i;\n\n        if (heap_size < k) {\n            heap[heap_size++] = e;\n            sift_up(heap, heap_size - 1);\n        } else {\n            if (!worse_entry(&e, &heap[0])) {\n                heap[0] = e;\n                sift_down(heap, 0, k - 1);\n            }\n        }\n    }\n\n    int counts[256] = {0};\n    for (int i = 0; i < heap_size; i++) {\n        unsigned char c = (unsigned char) heap[i].label;\n        counts[c]++;\n    }\n    free(heap);\n\n    int best_count = -1;\n    char best_label = 0;\n    for (int c = 0; c < 256; c++) {\n        if (counts[c] > best_count) {\n            best_count = counts[c];\n            best_label = (char)c;\n        }\n    }\n\n    return best_label;\n}\n\nint main() {\n    Dataset *ds = parse_dataset();\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(ds, k, to_evaluate));\n\n    free(ds->xs);\n    free(ds->ys);\n    free(ds->labels);\n    free(ds);\n    return 0;\n}\n",
      "path": "src/knn.c"
    },
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    int n;\n    float *xs;\n    float *ys;\n    char *labels;\n} Dataset;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2) on_error();\n    Point p;\n    p.x = x;\n    p.y = y;\n    return p;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n    return k;\n}\n\nDataset *parse_dataset() {\n    int n_groups = parse_number_of_groups();\n    int cap = 1024;\n    int n = 0;\n    float *xs = (float *) malloc(sizeof(float) * cap);\n    float *ys = (float *) malloc(sizeof(float) * cap);\n    char *labels = (char *) malloc(sizeof(char) * cap);\n    if (!xs || !ys || !labels) on_error();\n\n    for (int i = 0; i < n_groups; i++) {\n        char label;\n        int length;\n        if (scanf(\" label=%c \", &label) != 1) on_error();\n        if (scanf(\" length=%d \", &length) != 1) on_error();\n\n        for (int j = 0; j < length; j++) {\n            float x, y;\n            if (scanf(\" (%f ,%f) \", &x, &y) != 2) on_error();\n\n            if (n == cap) {\n                cap *= 2;\n                xs = (float *) realloc(xs, sizeof(float) * cap);\n                ys = (float *) realloc(ys, sizeof(float) * cap);\n                labels = (char *) realloc(labels, sizeof(char) * cap);\n                if (!xs || !ys || !labels) on_error();\n            }\n\n            xs[n] = x;\n            ys[n] = y;\n            labels[n] = label;\n            n++;\n        }\n    }\n\n    Dataset *ds = (Dataset *) malloc(sizeof(Dataset));\n    if (!ds) on_error();\n    ds->n = n;\n    ds->xs = xs;\n    ds->ys = ys;\n    ds->labels = labels;\n    return ds;\n}\n",
      "path": "src/knn.h"
    }
  ],
  "hypothesis": "Flatten all points into contiguous arrays (xs, ys, labels) during parsing so that the distance computation iterates over a single flat loop with sequential memory access, improving cache locality and enabling better vectorization compared to per-group nested loops.",
  "notes": "The previous implementation stored each group's points in separate SoA arrays and used a nested loop. This change flattens all points into three contiguous arrays (xs, ys, labels) while preserving the original point order (group-major then within-group), so tie-breaking by arrival index remains identical. The main distance/selection loop now walks these arrays linearly, which should improve memory locality and allow the compiler to vectorize the distance computation more effectively.",

{
  "src/solution.cpp": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconstexpr int MOD = 1000000007;\nconstexpr int TILE = 32;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<vector<int>> blockedCells(n);\n    for (int c = 0; c < m; ++c) {\n        int row, col;\n        cin >> row >> col;\n        blockedCells[row].push_back(col);\n    }\n\n    int answer = 0;\n    if (n < 512) {\n        vector<int> previous(n, 0), current(n, 0);\n        vector<unsigned char> rowBlocked(n, 0);\n\n        for (int row = 0; row < n; ++row) {\n            for (int col : blockedCells[row]) rowBlocked[col] = 1;\n\n            int leftValue = 0;\n            for (int col = 0; col < n; ++col) {\n                int value = 0;\n                if (!rowBlocked[col]) {\n                    value = previous[col] + leftValue;\n                    if (row == 0 && col == 0) ++value;\n                    if (value >= MOD) value -= MOD;\n                }\n                current[col] = value;\n                leftValue = value;\n            }\n\n            previous.swap(current);\n            for (int col : blockedCells[row]) rowBlocked[col] = 0;\n        }\n        answer = previous[n - 1];\n    } else {\n        for (auto &row : blockedCells) {\n            sort(row.begin(), row.end());\n        }\n\n        const int tileCount = (n + TILE - 1) / TILE;\n        vector<int> previousBottom(tileCount * TILE, 0);\n        vector<int> previousRight(tileCount * TILE, 0);\n        vector<int> currentBottom(tileCount * TILE, 0);\n        vector<int> currentRight(tileCount * TILE, 0);\n\n#ifdef _OPENMP\n#pragma omp parallel\n#endif\n        {\n            for (int wave = 0; wave < 2 * tileCount - 1; ++wave) {\n                const int firstTileRow = max(0, wave - (tileCount - 1));\n                const int lastTileRow = min(tileCount - 1, wave);\n                const int tilesOnWave = lastTileRow - firstTileRow + 1;\n                const int previousFirstTileRow =\n                    (wave > 0) ? max(0, wave - 1 - (tileCount - 1)) : 0;\n\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n                for (int tileIndex = 0; tileIndex < tilesOnWave; ++tileIndex) {\n                    const int tileRow = firstTileRow + tileIndex;\n                    const int tileCol = wave - tileRow;\n                    const int rowStart = tileRow * TILE;\n                    const int colStart = tileCol * TILE;\n                    const int height = min(TILE, n - rowStart);\n                    const int width = min(TILE, n - colStart);\n\n                    unsigned char blockedTile[TILE][TILE] = {};\n                    for (int localRow = 0; localRow < height; ++localRow) {\n                        const vector<int> &rowCells = blockedCells[rowStart + localRow];\n                        auto it = lower_bound(rowCells.begin(), rowCells.end(), colStart);\n                        const int colEnd = colStart + width;\n                        while (it != rowCells.end() && *it < colEnd) {\n                            blockedTile[localRow][*it - colStart] = 1;\n                            ++it;\n                        }\n                    }\n\n                    int topValues[TILE] = {};\n                    if (tileRow > 0) {\n                        const int topIndex = tileRow - 1 - previousFirstTileRow;\n                        for (int localCol = 0; localCol < width; ++localCol) {\n                            topValues[localCol] = previousBottom[topIndex * TILE + localCol];\n                        }\n                    }\n\n                    const int leftIndex = tileRow - previousFirstTileRow;\n                    for (int localRow = 0; localRow < height; ++localRow) {\n                        int leftValue = 0;\n                        if (tileCol > 0) {\n                            leftValue = previousRight[leftIndex * TILE + localRow];\n                        }\n\n                        const int globalRow = rowStart + localRow;\n                        for (int localCol = 0; localCol < width; ++localCol) {\n                            int value = 0;\n                            if (!blockedTile[localRow][localCol]) {\n                                value = topValues[localCol] + leftValue;\n                                if (globalRow == 0 && colStart + localCol == 0) ++value;\n                                if (value >= MOD) value -= MOD;\n                            }\n                            topValues[localCol] = value;\n                            leftValue = value;\n                        }\n                        currentRight[tileIndex * TILE + localRow] = leftValue;\n                    }\n\n                    for (int localCol = 0; localCol < width; ++localCol) {\n                        currentBottom[tileIndex * TILE + localCol] = topValues[localCol];\n                    }\n                }\n\n#ifdef _OPENMP\n#pragma omp single\n#endif\n                {\n                    previousBottom.swap(currentBottom);\n                    previousRight.swap(currentRight);\n                }\n            }\n        }\n\n        const int lastTileHeight = n - (tileCount - 1) * TILE;\n        answer = previousRight[lastTileHeight - 1];\n    }\n\n    cout << answer << '\\n';\n    return 0;\n}\n"
}

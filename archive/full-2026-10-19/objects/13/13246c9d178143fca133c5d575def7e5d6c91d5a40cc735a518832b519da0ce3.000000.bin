      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <omp.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Compute the gravitational impact among all pairs of bodies in \n * the system.\n */\nvoid body_force(const float *restrict x, const float *restrict y,\n                const float *restrict z, float *restrict vx,\n                float *restrict vy, float *restrict vz,\n                float dt, int n) {\n  #pragma omp for schedule(static)\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    const float xi = x[i];\n    const float yi = y[i];\n    const float zi = z[i];\n\n    #pragma omp simd reduction(+:fx,fy,fz) aligned(x,y,z:32)\n    for (int j = 0; j < n; ++j) {\n      float dx = x[j] - xi;\n      float dy = y[j] - yi;\n      float dz = z[j] - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1.0f / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    vx[i] += dt*fx;\n    vy[i] += dt*fy;\n    vz[i] += dt*fz;\n  }\n}\n\n/*\n * Read a binary dataset with initialized bodies.\n */\nvoid read_dataset(int *nbodies, float **restrict x, float **restrict y,\n                  float **restrict z, float **restrict vx,\n                  float **restrict vy, float **restrict vz) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  // Allocate aligned memory for SoA layout\n  size_t alignment = 32;\n  size_t sz = *nbodies * sizeof(float);\n  if (posix_memalign((void**)x, alignment, sz) != 0 ||\n      posix_memalign((void**)y, alignment, sz) != 0 ||\n      posix_memalign((void**)z, alignment, sz) != 0 ||\n      posix_memalign((void**)vx, alignment, sz) != 0 ||\n      posix_memalign((void**)vy, alignment, sz) != 0 ||\n      posix_memalign((void**)vz, alignment, sz) != 0) {\n    fprintf(stderr,\"\\nError allocating aligned memory\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  // Read interleaved AoS data and convert to SoA\n  float *tmp = (float*)malloc(*nbodies * 6 * sizeof(float));\n  if (!tmp) {\n    fprintf(stderr,\"\\nError allocating temporary buffer\\n\");\n    exit(EXIT_FAILURE);\n  }\n  b = fread(tmp, *nbodies * 6 * sizeof(float), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  for (int i = 0; i < *nbodies; ++i) {\n    (*x)[i] = tmp[i*6 + 0];\n    (*y)[i] = tmp[i*6 + 1];\n    (*z)[i] = tmp[i*6 + 2];\n    (*vx)[i] = tmp[i*6 + 3];\n    (*vy)[i] = tmp[i*6 + 4];\n    (*vz)[i] = tmp[i*6 + 5];\n  }\n\n  free(tmp);\n}\n\n/*\n * Write simulation results into a binary dataset (AoS format).\n */\nvoid write_dataset(const int nbodies, const float *restrict x,\n                   const float *restrict y, const float *restrict z,\n                   const float *restrict vx, const float *restrict vy,\n                   const float *restrict vz) {\n  // Convert SoA back to AoS for output\n  float *tmp = (float*)malloc(nbodies * 6 * sizeof(float));\n  if (!tmp) {\n    fprintf(stderr,\"\\nError allocating temporary buffer\\n\");\n    exit(EXIT_FAILURE);\n  }\n  for (int i = 0; i < nbodies; ++i) {\n    tmp[i*6 + 0] = x[i];\n    tmp[i*6 + 1] = y[i];\n    tmp[i*6 + 2] = z[i];\n    tmp[i*6 + 3] = vx[i];\n    tmp[i*6 + 4] = vy[i];\n    tmp[i*6 + 5] = vz[i];\n  }\n\n  int b = fwrite(tmp, nbodies * 6 * sizeof(float), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  free(tmp);\n}\n\nint main(int argc, char **argv) {\n  int nbodies;\n  float *x = NULL, *y = NULL, *z = NULL;\n  float *vx = NULL, *vy = NULL, *vz = NULL;\n\n  read_dataset(&nbodies, &x, &y, &z, &vx, &vy, &vz);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    #pragma omp parallel default(none) shared(x,y,z,vx,vy,vz,nbodies)\n    {\n      body_force(x, y, z, vx, vy, vz, DT, nbodies);\n\n      #pragma omp for schedule(static)\n      for (int i = 0; i < nbodies; ++i) {\n        x[i] += vx[i] * DT;\n        y[i] += vy[i] * DT;\n        z[i] += vz[i] * DT;\n      }\n    }\n  }\n\n  write_dataset(nbodies, x, y, z, vx, vy, vz);\n\n  free(x); free(y); free(z);\n  free(vx); free(vy); free(vz);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Integrating all three source experiments' retained transformations (SoA layout, restrict pointers, aligned allocation, OpenMP parallel region per iteration with work-sharing on both force and position loops, SIMD reduction on inner loop) will combine their benefits to achieve further speedup by reducing memory traffic, enabling vectorization, and minimizing thread creation overhead.",
  "notes": "Combined A's OpenMP directives (parallel for on outer loops), B's SoA layout with aligned allocation and restrict pointers plus SIMD reduction, and C's single parallel region per iteration enclosing both force computation and position update. The body_force function uses #pragma omp for schedule(static) inside the caller's parallel region to avoid redundant thread creation. All arrays are 32-byte aligned for SIMD alignment hints.",

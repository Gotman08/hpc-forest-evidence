    {
      "id": "84a7a50c18284c91",
      "role": "A",
      "mission": {
        "base_commit": "5fc2df68799bdb40f3cf62dd1c53f20b94594d45",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Compact polynomial powering with symmetric squaring, contiguous coefficient access and blocked modular reduction should substantially reduce arithmetic and memory traffic relative to dense matrices.",
        "id": "84a7a50c18284c91",
        "ordinal": 2,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/npbonacci.cpp"
          ],
          "retained": [
            "Replace companion matrices with MSB-first powering of x^(H-1) modulo the recurrence polynomial; handle n=1 with scalar exponentiation.",
            "Exploit square symmetry and bounded intermediate degrees, using a reversed coefficient copy for contiguous dot products.",
            "Store coefficients in 32-bit arrays and accumulate products in 64-bit buffers; normalize touched reduction windows after at most 16 updates.",
            "Use O(n) multiplication by x for set exponent bits instead of general polynomial multiplication.",
            "Select a direct recurrence by estimated arithmetic cost, using duplicated circular history for contiguous, batched dot products."
          ]

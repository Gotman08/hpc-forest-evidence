      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <algorithm>\n#include <cstring>\n#include <omp.h>\n\n// Fast integer parsing using getchar_unlocked (POSIX)\nstatic int read_int() {\n    int x = 0, c;\n    while ((c = getchar_unlocked()) < '0');\n    do { x = x * 10 + (c - '0'); } while ((c = getchar_unlocked()) >= '0');\n    return x;\n}\n\nint main() {\n    int n, s;\n    std::cin >> n >> s;\n    \n    // Allocate flat integral image array aligned to cache line (64 bytes)\n    const size_t stride = static_cast<size_t>(n) + 1;\n    int* I;\n    if (posix_memalign(reinterpret_cast<void**>(&I), 64, stride * stride * sizeof(int)) != 0) {\n        std::cerr << \"Allocation failed\\n\";\n        return 1;\n    }\n    \n    // Initialize first row and column of integral image to zero\n    for (size_t j = 0; j < stride; ++j)\n        I[j] = 0;\n    for (size_t i = 0; i <= static_cast<size_t>(n); ++i)\n        I[i * stride] = 0;\n    \n    // Read matrix and compute integral image in one pass\n    int row_sum = 0;\n    for (int i = 1; i <= n; ++i) {\n        row_sum = 0;\n        const size_t base_i = static_cast<size_t>(i) * stride;\n        const size_t base_im1 = static_cast<size_t>(i - 1) * stride;\n        for (int j = 1; j <= n; ++j) {\n            int val = read_int();\n            row_sum += val;\n            I[base_i + j] = I[base_im1 + j] + row_sum;\n        }\n    }\n    \n    // Search for maximum SxS submatrix using 2D tiling\n    const int B = 64;  // tile size (tuned)\n    int mxSum = -2147483648;  // minimum possible integer\n    \n    // Only parallelize if the problem is large enough to benefit\n    const int min_parallel_n = 1000;\n    #pragma omp parallel for reduction(max:mxSum) if(n >= min_parallel_n)\n    for (int ti = 0; ti <= n - s; ti += B) {\n        const int i_end = std::min(ti + B, n - s + 1);\n        for (int tj = 0; tj <= n - s; tj += B) {\n            const int j_end = std::min(tj + B, n - s + 1);\n            // Process tile [ti,i_end) x [tj,j_end)\n            for (int i = ti; i < i_end; ++i) {\n                const size_t base_i = static_cast<size_t>(i) * stride;\n                const size_t base_ipS = static_cast<size_t>(i + s) * stride;\n                for (int j = tj; j < j_end; ++j) {\n                    int sum = I[base_ipS + j + s] - I[base_i + j + s]\n                            - I[base_ipS + j] + I[base_i + j];\n                    if (sum > mxSum)\n                        mxSum = sum;\n                }\n            }\n        }\n    }\n    \n    printf(\"%d\\n\", mxSum);\n    free(I);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

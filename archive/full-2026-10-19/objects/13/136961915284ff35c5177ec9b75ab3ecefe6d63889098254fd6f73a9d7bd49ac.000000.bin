assert not Path(pin["executable"]["path"]).exists()
sys.path.insert(0, str(BASE / "work/marathon-archive-mother-r1/project/src"))
from hpc_forest.core import FileLock
with contextlib.ExitStack() as stack:
    for root, lock in [(STUDY, "coordinator.lock"), (COMPARE, "comparison-coordinator.lock")]:
        previous_lock = root / lock
        if previous_lock.exists():
            (HERE / (lock + ".before")).write_bytes(previous_lock.read_bytes())
        stack.enter_context(FileLock(previous_lock))
    for lane, root, key in [("r1", STUDY, "coverage-gpt-5.6-terra-xhigh"),
                             ("source_only", COMPARE, "source-only-gpt-5.6-terra-max")]:
        state_path = root / "coordinator-state.json"
        state = load(state_path)
        assert state["current_key"] == key
        cell = next(c for c in state["queue"] if c["key"] == key)
        state.update(stage=("awaiting_audited_r1_reception_after_interface_loss" if lane == "r1" else "attention_required"),
            error="Pinned CLI 0.162.0-alpha.17.2 missing; CLI 0.163.0-alpha.10.2 not admitted",
            updated_at=time.time(), strict_observer_running=False,
            recovery_incident={"path": str(HERE), "local_interfaces_absent": True,
                "pinned_cli_missing": True, "new_cli_admission": "pending_human_decision",
                "generation_replayed": False, "submission_replayed": False,
                "next_action": ("Strict audited reception of completed job" if lane == "r1"
                                else "CLI pin restoration or explicit reviewed migration before relay resume")})
        cell["scheduler"] = OBSERVATIONS[lane]
        temp = state_path.with_suffix(".incident2012.tmp")
        with temp.open("x", encoding="utf8") as stream:
            json.dump(state, stream, indent=2, ensure_ascii=False)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temp, state_path)

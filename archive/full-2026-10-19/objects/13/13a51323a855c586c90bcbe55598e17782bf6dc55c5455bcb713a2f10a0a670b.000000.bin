#include "knn.h"
#include <limits.h>

typedef struct {
    float distance;
    unsigned int encounter;
    char label;
} Neighbor;

static inline int neighbor_is_worse(const Neighbor *a, const Neighbor *b) {
    return a->distance > b->distance ||
           (a->distance == b->distance && a->encounter > b->encounter);
}

static void sift_up_worst(Neighbor *neighbors, int index) {
    Neighbor value = neighbors[index];

    while (index > 0) {
        int parent = (index - 1) / 2;
        if (!neighbor_is_worse(&value, &neighbors[parent])) {
            break;
        }
        neighbors[index] = neighbors[parent];
        index = parent;
    }

    neighbors[index] = value;
}

static void sift_down_worst(Neighbor *neighbors, int length) {
    Neighbor value = neighbors[0];
    int parent = 0;

    for (;;) {
        int child = parent * 2 + 1;
        if (child >= length) {
            break;
        }

        int right = child + 1;
        if (right < length && neighbor_is_worse(&neighbors[right], &neighbors[child])) {
            child = right;
        }
        if (!neighbor_is_worse(&neighbors[child], &value)) {
            break;
        }

        neighbors[parent] = neighbors[child];
        parent = child;
    }

    neighbors[parent] = value;
}

static char knn_insertion(int n_groups, Group *groups, int k, Point to_evaluate) {
    char *labels = (char *) malloc(sizeof(*labels) * (size_t) k);
    float *distances = (float *) malloc(sizeof(*distances) * (size_t) k);
    int i, j, x, y;

    for (i = 0; i < k; i++) {
        labels[i] = -1;
        distances[i] = -1;
    }

    for (i = 0; i < n_groups; i++) {
        Group g = groups[i];

        for (j = 0; j < g.length; j++) {
            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);

            for (x = 0; x < k; x++) {
                if (d < distances[x] || distances[x] == -1) {
                    for (y = k - 1; y > x; y--) {
                        distances[y] = distances[y - 1];
                        labels[y] = labels[y - 1];
                    }

                    distances[x] = d;
                    labels[x] = g.label;
                    break;
                }
            }
        }
    }

    qsort(labels, k, sizeof(*labels), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }
            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    return most_frequent;
}

char knn(int n_groups, Group *groups, int k, Point to_evaluate) {
    Neighbor *neighbors = (Neighbor *) malloc(sizeof(*neighbors) * (size_t) k);
    int count = 0;
    unsigned int encounter = 0;

    for (int i = 0; i < n_groups; i++) {
        Group g = groups[i];

        for (int j = 0; j < g.length; j++) {
            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);
            if (d != d) {
                free(neighbors);
                return knn_insertion(n_groups, groups, k, to_evaluate);
            }

            Neighbor candidate;
            candidate.distance = d;
            candidate.encounter = encounter++;
            candidate.label = g.label;

            if (count < k) {
                neighbors[count] = candidate;
                sift_up_worst(neighbors, count);
                count++;
            } else if (d < neighbors[0].distance) {
                neighbors[0] = candidate;
                sift_down_worst(neighbors, count);
            }
        }
    }

    while (count < k) {
        neighbors[count].label = -1;
        count++;
    }

    int frequencies[UCHAR_MAX + 1] = {0};
    for (int i = 0; i < k; i++) {
        frequencies[(unsigned char) neighbors[i].label]++;
    }

    char most_frequent = 0;
    int most_frequent_count = 0;
    for (int value = CHAR_MIN; value <= CHAR_MAX; value++) {
        char label = (char) value;
        int frequency = frequencies[(unsigned char) label];
        if (frequency > most_frequent_count) {
            most_frequent = label;
            most_frequent_count = frequency;
        }
    }

    free(neighbors);
    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

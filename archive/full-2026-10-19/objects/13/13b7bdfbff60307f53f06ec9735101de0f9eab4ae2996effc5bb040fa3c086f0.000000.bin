"""New pure membership counterexamples only; no received input or reader main."""
from pathlib import Path
import ast
import hashlib
import json

HERE = Path(__file__).resolve().parent
reader = HERE / "auditer-restauration-existante-r4b.py"
source = reader.read_bytes()
tree = ast.parse(source)
nodes = [node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name in {"need", "validate_prior36_boundary"}]
assert len(nodes) == 2
namespace = {}
exec(compile(ast.Module(body=nodes, type_ignores=[]), str(reader), "exec"), namespace)
check = namespace["validate_prior36_boundary"]
expected = {f"fixture-{index}.json": {"bytes": index + 1, "sha256": "a" * 64} for index in range(36)}
restored = {**expected, "extra-restored-file.json": {"bytes": 1, "sha256": "b" * 64}}
cases = []

def reject(name, before, after, recovered):
    try:
        check(expected, before, after, recovered)
    except ValueError as error:
        cases.append({"case": name, "passed": True, "expected_refusal": str(error)})
    else:
        raise AssertionError(name)

check(expected, dict(expected), dict(expected), restored)
cases.append({"case": "exact36_and_superset690_equivalent_fixture", "passed": True})
reject("empty_or_missing_prior_directory_cannot_pass_vacuously", {}, {}, restored)
reject("one_prior_receipt_missing", dict(list(expected.items())[:-1]), expected, restored)
reject("extra_prior_receipt", {**expected, "foreign.json": {"bytes": 1, "sha256": "c" * 64}}, expected, restored)
reject("prior_receipt_changed_after", expected, {**expected, "fixture-0.json": {"bytes": 9, "sha256": "d" * 64}}, restored)
reject("one_recovered_receipt_missing", expected, expected, dict(list(expected.items())[:-1]))
report = {"schema": "hpc-forest-cold-reader-r4b-new-pure-counterexamples-v1", "reader_sha256": hashlib.sha256(source).hexdigest(),
          "tests": cases, "passed": len(cases), "failed": 0, "reader_main_executed": False,
          "received36_or690_inputs_read": False, "project265_tests_reexecuted": False}
with (HERE / "TESTS-NOUVEAUX-GARDE-PRIOR36-R4B.json").open("x", encoding="utf8", newline="\n") as out:
    json.dump(report, out, indent=2); out.write("\n")
print(json.dumps(report))

        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\ntypedef struct { float x, y, z; } Position;\n\n/* Allocation-free fallback with the original per-body arithmetic. */\nstatic void body_force_unpacked(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Scan compact, read-only positions for four targets at a time.\n * Every target retains the original ascending-j accumulation order.\n */\nvoid body_force(Body *p, float dt, int n) {\n  if (n <= 0) {\n    return;\n  }\n\n  Position *positions = NULL;\n  if ((size_t)n <= (size_t)-1 / sizeof(Position)) {\n    positions = (Position *)malloc((size_t)n * sizeof(Position));\n  }\n  if (positions == NULL) {\n    body_force_unpacked(p, dt, n);\n    return;\n  }\n\n  for (int i = 0; i < n; ++i) {\n    positions[i].x = p[i].x;\n    positions[i].y = p[i].y;\n    positions[i].z = p[i].z;\n  }\n\n  const int nblocks = n / 4;\n#ifdef _OPENMP\n#pragma omp parallel for schedule(static) if(n >= 256)\n#endif\n  for (int block = 0; block < nblocks; ++block) {\n    const int i = block * 4;\n    const float x0 = positions[i].x;\n    const float y0 = positions[i].y;\n    const float z0 = positions[i].z;\n    const float x1 = positions[i + 1].x;\n    const float y1 = positions[i + 1].y;\n    const float z1 = positions[i + 1].z;\n    const float x2 = positions[i + 2].x;\n    const float y2 = positions[i + 2].y;\n    const float z2 = positions[i + 2].z;\n    const float x3 = positions[i + 3].x;\n    const float y3 = positions[i + 3].y;\n    const float z3 = positions[i + 3].z;\n\n    float fx0 = 0.0f, fy0 = 0.0f, fz0 = 0.0f;\n    float fx1 = 0.0f, fy1 = 0.0f, fz1 = 0.0f;\n    float fx2 = 0.0f, fy2 = 0.0f, fz2 = 0.0f;\n    float fx3 = 0.0f, fy3 = 0.0f, fz3 = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      const float xj = positions[j].x;\n      const float yj = positions[j].y;\n      const float zj = positions[j].z;\n\n      {\n        float dx = xj - x0;\n        float dy = yj - y0;\n        float dz = zj - z0;\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx0 += dx * inv_dist3;\n        fy0 += dy * inv_dist3;\n        fz0 += dz * inv_dist3;\n      }\n      {\n        float dx = xj - x1;\n        float dy = yj - y1;\n        float dz = zj - z1;\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx1 += dx * inv_dist3;\n        fy1 += dy * inv_dist3;\n        fz1 += dz * inv_dist3;\n      }\n      {\n        float dx = xj - x2;\n        float dy = yj - y2;\n        float dz = zj - z2;\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx2 += dx * inv_dist3;\n        fy2 += dy * inv_dist3;\n        fz2 += dz * inv_dist3;\n      }\n      {\n        float dx = xj - x3;\n        float dy = yj - y3;\n        float dz = zj - z3;\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx3 += dx * inv_dist3;\n        fy3 += dy * inv_dist3;\n        fz3 += dz * inv_dist3;\n      }\n    }\n\n    p[i].vx += dt*fx0;\n    p[i].vy += dt*fy0;\n    p[i].vz += dt*fz0;\n    p[i + 1].vx += dt*fx1;\n    p[i + 1].vy += dt*fy1;\n    p[i + 1].vz += dt*fz1;\n    p[i + 2].vx += dt*fx2;\n    p[i + 2].vy += dt*fy2;\n    p[i + 2].vz += dt*fz2;\n    p[i + 3].vx += dt*fx3;\n    p[i + 3].vy += dt*fy3;\n    p[i + 3].vz += dt*fz3;\n  }\n\n  for (int i = nblocks * 4; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = positions[j].x - positions[i].x;\n      float dy = positions[j].y - positions[i].y;\n      float dz = positions[j].z - positions[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n\n  free(positions);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n  \n  exit(EXIT_SUCCESS);\n}\n",
        "path": "src/nbody.c"
      }

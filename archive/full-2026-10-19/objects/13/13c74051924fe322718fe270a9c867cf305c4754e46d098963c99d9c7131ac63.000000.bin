{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <algorithm>\\n#include <cstddef>\\n#include <iostream>\\n#include <iterator>\\n#include <string>\\n\\nclass BufferedOutput\\n{\\n    enum { capacity = 64 * 1024 };\\n    char buffer_[capacity];\\n    std::size_t used_;\\n\\npublic:\\n    BufferedOutput () : used_ (0) {}\\n\\n    void flush ()\\n    {\\n        if (used_ != 0) {\\n            std::cout.write (buffer_, static_cast <std::streamsize> (used_));\\n            used_ = 0;\\n        }\\n    }\\n\\n    void put (char value)\\n    {\\n        if (used_ == capacity) flush ();\\n        buffer_ [used_ ++] = value;\\n    }\\n} ;\\n\\nstruct PrintPermutation\\n{\\n    BufferedOutput& output;\\n\\n    explicit PrintPermutation (BufferedOutput& out) : output (out) {}\\n\\n    template <typename Iter> auto\\n    operator () (Iter first, Iter last) const -> void\\n    {\\n        output.put ('[');\\n        output.put (' ');\\n        while (first != last) {\\n            output.put (*first);\\n            output.put (' ');\\n            ++ first;\\n        }\\n        output.put (']');\\n        output.put ('\\\\n');\\n    }\\n} ;\\n\\nstruct IsWhitespace\\n{\\n    template <typename Char> auto\\n    operator () (Char c) const -> bool\\n    {\\n        return (c == ' ' )\\n            || (c == '\\\\n')\\n            || (c == '\\\\r')\\n            || (c == '\\\\t')\\n            || (c == '\\\\f')\\n            || (c == '\\\\v') ;\\n    }\\n} ;\\n\\ntemplate <typename String> inline auto\\nremove_whitespaces (String text) -> String\\n{\\n    text.erase\\n        ( std::remove_if\\n            ( text.begin ()\\n            , text.end ()\\n            , IsWhitespace () )\\n        , text.end () ) ;\\n    return text;\\n}\\n\\ntemplate <typename Iter> auto\\nfind_longest_non_increasing_suffix (Iter first, Iter last) -> Iter\\n{\\n    if (first == last) return last;\\n    Iter back = std::prev (last);\\n    if (back == first) return last;\\n    do {\\n        -- last;\\n        -- back;\\n    } while ((first != last) && (*back >= *last));\\n    return last;\\n}\\n\\ntemplate <typename Iter> auto\\nfind_rightmost_successor (Iter first, Iter second, Iter last) -> Iter\\n{\\n    if (second == last) return last;\\n    do {\\n        -- last;\\n    } while ((second != last) && (*last <= *first));\\n    return last;\\n}\\n\\ntemplate <typename Iter> auto\\nnext_permutation (Iter first, Iter last) -> bool\\n{\\n    if (first == last) return false;\\n    Iter suffix = find_longest_non_increasing_suffix (first, last);\\n    if (suffix == first) return false;\\n    if (suffix == last)  return false;\\n    Iter pivot = std::prev (suffix);\\n    Iter successor = find_rightmost_successor (pivot, suffix, last);\\n    std::iter_swap (pivot, successor);\\n    std::reverse (suffix, last);\\n    return true;\\n}\\n\\ntemplate <typename Iter, typename Function> inline auto\\npermutations_iter (Iter first, Iter last, Function driver) -> void\\n{\\n    if (first == last) return;\\n    std::sort (first, last);\\n    do {\\n        driver (first, last);\\n    } while (::next_permutation (first, last));\\n    return;\\n}\\n\\ntemplate <typename String, typename Function> inline auto\\npermutations (String text, Function driver) -> void\\n{\\n    permutations_iter (std::begin (text), std::end (text), driver);\\n}\\n\\ntemplate <typename String, typename InStream> inline auto\\nread_text_from_stdin (InStream& in) -> String\\n{\\n    std::istreambuf_iterator <char> begin (in), end;\\n    std::string text (begin, end);\\n    text = remove_whitespaces (text);\\n    return text;\\n}\\n\\nint main (int argc, char const *argv [])\\n{\\n    std::string text = read_text_from_stdin <std::string> (std::cin);\\n    BufferedOutput output;\\n    permutations (text, PrintPermutation (output));\\n    output.flush ();\\n    return 0;\\n}\\n\",\"path\":\"src/permutations.cc\"}],\"hypothesis\":\"The lexicographic successor loop has inherent loop-carried state and should remain sequential. Per-permutation std::endl flushes are avoidable: an ordered fixed-size output buffer can batch writes while keeping memory bounded, potentially reducing end-to-end runtime.\",\"notes\":\"No SIMD transformation is applied to the dependent permutation-generation loop; output bytes retain their original order and formatting.\",\"sources_kept\":[],\"transformations\":[\"Replace per-character std::cout operations and per-permutation std::endl flushing with a fixed 64 KiB byte buffer that flushes in contiguous chunks.\"]}"}}

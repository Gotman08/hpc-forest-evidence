"""Seal the two-binding delta only; reuse unchanged acquired neutral evidence."""
import hashlib
import json
from pathlib import Path
import xml.etree.ElementTree as ET

HERE = Path(__file__).resolve().parent
OLD = HERE / 'revision-r4-facades-cloture-observer'
NEW = HERE / 'revision-r5-G-recu-avant-Q'
OLDQ = HERE / 'qualification-complete110-r3-facades'
Q = HERE / 'qualification-complete110-r4-G-bound'


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def ref(path):
    return {'path': str(path), 'sha256': sha(path)}


def save(path, value):
    with path.open('x', encoding='utf8', newline='\n') as stream:
        stream.write(json.dumps(value, indent=2, ensure_ascii=False) + '\n')


def main():
    old = json.loads((OLD / 'COMPONENTS.json').read_bytes())
    new = json.loads((NEW / 'COMPONENTS.json').read_bytes())
    changed = {name for name in new['code_pins'] if new['code_pins'][name] != old['code_pins'][name]}
    assert changed == {'launcher/pins-source-plan.json', 'reader/pins-source-plan.json'}
    assert all(sha(NEW / name) == expected for name, expected in new['code_pins'].items())
    assert all(sha(OLD / name) == expected for name, expected in old['code_pins'].items())
    for name in changed:
        a, b = (json.loads((directory / name).read_bytes()) for directory in (OLD, NEW))
        assert a['latest_native_generation_closure'] is None
        b['latest_native_generation_closure'] = None
        assert b == a
    unchanged = ('qualification-wrapper.py', 'source-bundle.tar.gz', 'bootstrap-alloue.py')
    assert all((Q / name).read_bytes() == (OLDQ / name).read_bytes() for name in unchanged)
    cases = list(ET.parse(HERE / 'tests-liaison-G-r5.xml').iter('testcase'))
    assert len(cases) == 7 and all(all(c.find(k) is None for k in ('failure', 'error', 'skipped')) for c in cases)
    assert json.loads((HERE / 'RUFF-LIAISON-R5-FINAL.json').read_text(encoding='utf-8-sig')) == []
    local = json.loads((HERE / 'ADMISSION-LOCALE-G-POST-CLOTURE-R5.json').read_bytes())
    derivation = {'schema': 'hpc-forest-r4b-actual-historical-G-binding-delta-v1',
        'previous_r4_delivery': ref(HERE / 'LIVRAISON-CORRECTION-FACADES-R4-POUR-REVUE.json'),
        'previous_r4_independent_review': ref(HERE / 'revue-independante-port-r4/REVUE-INDEPENDANTE-PORT-CORRIGE-R4.json'),
        'previous_components': ref(OLD / 'COMPONENTS.json'), 'new_components': ref(NEW / 'COMPONENTS.json'),
        'modified_pinned_files_only': {name: {'before': old['code_pins'][name], 'after': new['code_pins'][name],
            'only_semantic_changed_key': 'latest_native_generation_closure'} for name in sorted(changed)},
        'all_other60_components_byte_identical': True, 'source110_or_code_or_test_or_runtime_guard_changed': False,
        'actual_canonical_G_ref': local['canonical_receipt'],
        'actual_post_closure_independent_ref_external_local_only': local['independent_post_closure_review'],
        'closed_schemas_have_no_second_independent_post_field': True,
        'external_local_admission': ref(HERE / 'ADMISSION-LOCALE-G-POST-CLOTURE-R5.json'),
        'unchanged_Q_code_source_bootstrap': {name: ref(Q / name) for name in unchanged},
        'seven_new_binding_cases_received': ref(HERE / 'tests-liaison-G-r5.xml'),
        'prior73_adapter_5_OBS4_10_Qguard_187source_cases_not_reexecuted': True,
        'prior_Ruff_output_artifact_absent_as_explained_in_r4_review': True,
        'new_binding_scripts_Ruff_actual_file': ref(HERE / 'RUFF-LIAISON-R5-FINAL.json'),
        'first_style_import_order_refusal_retained': ref(HERE / 'RUFF-LIAISON-R5.json'),
        'new_full_Q_required_and_not_run': True, 'new_current_CIM_and_nine_cell_gates_required': True,
        'private_G_receipt_CIM_rawargv_or_policy_catalog_bytes_in_ARM_packet': False,
        'new_native_or_scientific_admission': False}
    save(HERE / 'DERIVATION-LIAISON-G-R5.json', derivation)
    files = [p for p in NEW.rglob('*') if p.is_file()] + [p for p in Q.iterdir() if p.is_file()]
    files += [HERE / name for name in ('ADMISSION-LOCALE-G-POST-CLOTURE-R5.json', 'DERIVATION-LIAISON-G-R5.json',
        'finaliser-G-bound-r5.py', 'sceller-liaison-G-r5.py', 'test_liaison_G_r5.py',
        'tests-liaison-G-r5.xml', 'RUFF-LIAISON-R5.json', 'RUFF-LIAISON-R5-FINAL.json')]
    manifest = HERE / 'MANIFESTE-LIAISON-G-R5.json'
    save(manifest, {'schema': 'hpc-forest-source110-final-G-bound-preparation-manifest-v1',
        'files': {p.relative_to(HERE).as_posix(): sha(p) for p in sorted(files)}, 'native_admission': False})
    delivery = json.loads((HERE / 'LIVRAISON-CORRECTION-FACADES-R4-POUR-REVUE.json').read_bytes())
    delivery.update(candidate_revision=NEW.name, concrete_root=str(NEW), components=ref(NEW / 'COMPONENTS.json'),
        Q_packet=ref(Q / 'complete-source110-neutral-packet.tar.gz'), Q_wrapper=ref(Q / 'qualification-wrapper.py'),
        Q_command=ref(Q / 'commande-allouee-zero-modele.sh'), Q_bindings=ref(Q / 'bindings.json'),
        Q_proposal=ref(Q / 'PROPOSITION-Q-COMPLETE-NON-ADMISE.json'), manifest=ref(manifest),
        previous_r4_GO_review=derivation['previous_r4_independent_review'], binding_derivation=ref(HERE / 'DERIVATION-LIAISON-G-R5.json'),
        local_historical_G_admission=ref(HERE / 'ADMISSION-LOCALE-G-POST-CLOTURE-R5.json'),
        modified_components_relative_r4=2, all_code_and_Q_wrapper_unchanged=True,
        seven_binding_delta_cases_passed=True, source187_and_adapter73_not_reexecuted=True,
        G_canonical_and_post_closure_independent_review_received_and_bound=True,
        current_runtime_or_nine_admissions_opened=False)
    delivery['remaining_closed_requirements'] = [
        'Fresh independent review of this exact two-binding delta and new component/packet hashes before Q',
        'New actual allocated110source+62component Q, its strict reception and independent audit',
        'Actual target/reference linkage explicitly reviewed, never inferred from neutral source tests',
        'New complete current CIM and all nine exact individual cell admissions remain required',
        'source110 negative metadata terminal path remains closed pending a separate reviewed contract',
        'Pilot and extension closed; technical mother phases do not prove first normal candidate/evaluation admission']
    path = HERE / 'LIVRAISON-FINALE-G-LIE-AVANT-Q-R5.json'
    save(path, delivery)
    print(json.dumps({'delivery': ref(path), 'manifest': ref(manifest), 'components': ref(NEW / 'COMPONENTS.json'),
        'Q_packet': ref(Q / 'complete-source110-neutral-packet.tar.gz'), 'effect_calls': 0}))


if __name__ == '__main__':
    main()

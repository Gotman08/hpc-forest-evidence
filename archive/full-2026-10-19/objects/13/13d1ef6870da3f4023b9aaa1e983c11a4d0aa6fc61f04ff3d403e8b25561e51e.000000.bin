      "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nstatic constexpr int MOD = 1000000007;\nstatic constexpr int TILE = 128;\nstatic constexpr int LOCAL_BITS = 14;\n\nstatic inline int add_mod(int a, int b) {\n    int sum = a + b;\n    return sum >= MOD ? sum - MOD : sum;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n    const int tiles = (n + TILE - 1) / TILE;\n\n    // Sort obstacles by tile wavefront, tile row, and local cell.\n    vector<uint64_t> blocked;\n    blocked.reserve(static_cast<size_t>(m));\n    for (int k = 0; k < m; ++k) {\n        int r, c;\n        cin >> r >> c;\n        const int tr = r / TILE;\n        const int tc = c / TILE;\n        const uint64_t key = static_cast<uint64_t>(tr + tc) * tiles + tr;\n        const uint64_t local = (r % TILE) * TILE + c % TILE;\n        blocked.push_back((key << LOCAL_BITS) | local);\n    }\n    sort(blocked.begin(), blocked.end());\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\n\n    // Each tile column retains its latest bottom boundary; each tile row\n    // retains its latest right boundary. Both frontiers have only n entries.\n    vector<int> bottom(n, 0);\n    vector<int> right(n, 0);\n    bottom[0] = 1;\n\n    #pragma omp parallel if (n >= 1024)\n    {\n        alignas(64) int values[TILE];\n        for (int diagonal = 0; diagonal < 2 * tiles - 1; ++diagonal) {\n            const int first = max(0, diagonal - tiles + 1);\n            const int last = min(tiles - 1, diagonal);\n\n            #pragma omp for schedule(static)\n            for (int tr = first; tr <= last; ++tr) {\n                const int tc = diagonal - tr;\n                const int row_start = tr * TILE;\n                const int column_start = tc * TILE;\n                const int height = min(TILE, n - row_start);\n                const int width = min(TILE, n - column_start);\n                const uint64_t key = static_cast<uint64_t>(diagonal) * tiles + tr;\n                const uint64_t tile_base = key << LOCAL_BITS;\n                auto obstacle = lower_bound(blocked.cbegin(), blocked.cend(), tile_base);\n\n                for (int c = 0; c < width; ++c)\n                    values[c] = bottom[column_start + c];\n\n                for (int r = 0; r < height; ++r) {\n                    int left = right[row_start + r];\n                    int c = 0;\n                    const uint64_t row_end = tile_base + static_cast<uint64_t>(r + 1) * TILE;\n                    while (obstacle != blocked.cend() && *obstacle < row_end) {\n                        const int stop = static_cast<int>(*obstacle & (TILE - 1));\n                        for (; c < stop; ++c) {\n                            left = add_mod(values[c], left);\n                            values[c] = left;\n                        }\n                        values[stop] = 0;\n                        left = 0;\n                        c = stop + 1;\n                        ++obstacle;\n                    }\n                    for (; c < width; ++c) {\n                        left = add_mod(values[c], left);\n                        values[c] = left;\n                    }\n                    right[row_start + r] = left;\n                }\n\n                for (int c = 0; c < width; ++c)\n                    bottom[column_start + c] = values[c];\n            }\n            // The worksharing barrier publishes both boundaries before\n            // the next wavefront reads them.\n        }\n    }\n\n    cout << bottom[n - 1] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "A persistent OpenMP team processing independent 128-by-128 tiles on each anti-diagonal will accelerate dense grid DP on four cores while keeping boundary storage linear in n.",
  "notes": "Uses a serial fallback below n=1024. OpenMP-disabled builds remain correct. Duplicate obstacles are deduplicated; storage is O(n+m), without a quadratic grid allocation.",

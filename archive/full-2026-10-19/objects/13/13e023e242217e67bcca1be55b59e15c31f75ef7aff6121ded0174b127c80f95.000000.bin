#include "knn.h"
#include <omp.h>

static int is_worse(float da, long ia, float db, long ib) {
    return (da > db) || (da == db && ia > ib);
}

static void swap3(float *hd, long *hi, char *hl, int a, int b) {
    float td = hd[a]; hd[a] = hd[b]; hd[b] = td;
    long ti = hi[a]; hi[a] = hi[b]; hi[b] = ti;
    char tc = hl[a]; hl[a] = hl[b]; hl[b] = tc;
}

static void heap_push(float *hd, long *hi, char *hl, int *n,
                      float d, long idx, char label) {
    int i = (*n)++;
    hd[i] = d; hi[i] = idx; hl[i] = label;

    while (i > 0) {
        int parent = (i - 1) / 2;
        if (is_worse(hd[i], hi[i], hd[parent], hi[parent])) {
            swap3(hd, hi, hl, i, parent);
            i = parent;
        } else {
            break;
        }
    }
}

static void heap_replace_root(float *hd, long *hi, char *hl, int n,
                              float d, long idx, char label) {
    hd[0] = d; hi[0] = idx; hl[0] = label;
    int i = 0;

    for (;;) {
        int left = 2 * i + 1;
        if (left >= n) break;
        int right = left + 1;
        int worst = i;

        if (is_worse(hd[left], hi[left], hd[worst], hi[worst])) {
            worst = left;
        }
        if (right < n && is_worse(hd[right], hi[right], hd[worst], hi[worst])) {
            worst = right;
        }

        if (worst == i) break;
        swap3(hd, hi, hl, i, worst);
        i = worst;
    }
}

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    size_t total = 0;
    for (int gi = 0; gi < n_groups; ++gi) {
        total += (size_t)groups[gi].length;
    }

    float *xs = NULL;
    if (posix_memalign((void **)&xs, 64, total * sizeof(float)) != 0) {
        xs = malloc(total * sizeof(float));
    }
    float *ys = NULL;
    if (posix_memalign((void **)&ys, 64, total * sizeof(float)) != 0) {
        ys = malloc(total * sizeof(float));
    }
    char *plabels = (char *)malloc(total * sizeof(char));

    size_t pos = 0;
    for (int gi = 0; gi < n_groups; ++gi) {
        Group g = groups[gi];
        char lab = g.label;
        for (int j = 0; j < g.length; ++j) {
            xs[pos] = g.points[j].x;
            ys[pos] = g.points[j].y;
            plabels[pos] = lab;
            ++pos;
        }
    }

    float *dists = NULL;
    if (posix_memalign((void **)&dists, 64, total * sizeof(float)) != 0) {
        dists = malloc(total * sizeof(float));
    }
    float tx = to_evaluate.x;
    float ty = to_evaluate.y;

#pragma omp parallel for simd schedule(static) aligned(xs, ys, dists: 64)
    for (long p = 0; p < (long)total; ++p) {
        float dx = xs[p] - tx;
        float dy = ys[p] - ty;
        dists[p] = dx * dx + dy * dy;
    }

    int nthreads = omp_get_max_threads();
    if (nthreads < 1) nthreads = 1;

    float **local_d = malloc(nthreads * sizeof(float*));
    long **local_idx = malloc(nthreads * sizeof(long*));
    char **local_lab = malloc(nthreads * sizeof(char*));
    int *local_n = calloc(nthreads, sizeof(int));

    for (int t = 0; t < nthreads; ++t) {
        local_d[t] = malloc(k * sizeof(float));
        local_idx[t] = malloc(k * sizeof(long));
        local_lab[t] = malloc(k * sizeof(char));
    }

#pragma omp parallel
    {
        int tid = omp_get_thread_num();
        float *hd = local_d[tid];
        long *hi = local_idx[tid];
        char *hl = local_lab[tid];
        int hn = 0;

#pragma omp for schedule(static)
        for (long p = 0; p < (long)total; ++p) {
            float d = dists[p];
            if (hn < k) {
                heap_push(hd, hi, hl, &hn, d, p, plabels[p]);
            } else if (is_worse(hd[0], hi[0], d, p)) {
                heap_replace_root(hd, hi, hl, k, d, p, plabels[p]);
            }
        }

        local_n[tid] = hn;
    }

    long total_candidates = 0;
    for (int t = 0; t < nthreads; ++t) {
        total_candidates += local_n[t];
    }

    float *cand_d = malloc(total_candidates * sizeof(float));
    long *cand_idx = malloc(total_candidates * sizeof(long));
    char *cand_lab = malloc(total_candidates * sizeof(char));

    size_t cpos = 0;
    for (int t = 0; t < nthreads; ++t) {
        int cnt = local_n[t];
        for (int i = 0; i < cnt; ++i) {
            cand_d[cpos] = local_d[t][i];
            cand_idx[cpos] = local_idx[t][i];
            cand_lab[cpos] = local_lab[t][i];
            cpos++;
        }
    }

    float *heap_d = (float *)malloc(k * sizeof(float));
    long *heap_idx = (long *)malloc(k * sizeof(long));
    char *heap_lab = (char *)malloc(k * sizeof(char));
    int heap_n = 0;

    for (long i = 0; i < total_candidates; ++i) {
        float d = cand_d[i];
        long idx = cand_idx[i];
        char lab = cand_lab[i];
        if (heap_n < k) {
            heap_push(heap_d, heap_idx, heap_lab, &heap_n, d, idx, lab);
        } else if (is_worse(heap_d[0], heap_idx[0], d, idx)) {
            heap_replace_root(heap_d, heap_idx, heap_lab, k, d, idx, lab);
        }
    }

    char *labels = (char *)malloc(k * sizeof(char));
    for (int i = 0; i < k; ++i) {
        if (i < heap_n) labels[i] = heap_lab[i];
        else labels[i] = -1;
    }

    qsort(labels, k, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (int i = 1; i < k; ++i) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }

            current_frequency = 1;
        } else {
            ++current_frequency;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    free(xs); free(ys); free(plabels); free(dists);
    for (int t = 0; t < nthreads; ++t) {
        free(local_d[t]);
        free(local_idx[t]);
        free(local_lab[t]);
    }
    free(local_d); free(local_idx); free(local_lab); free(local_n);
    free(cand_d); free(cand_idx); free(cand_lab);
    free(heap_d); free(heap_idx); free(heap_lab); free(labels);

    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();

    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; ++i) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
    return 0;
}

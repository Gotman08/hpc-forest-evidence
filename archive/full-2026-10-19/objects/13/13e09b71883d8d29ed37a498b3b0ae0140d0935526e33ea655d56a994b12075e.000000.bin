n+            size_t south = row + (size_t)size;\\n+            for (int j = 1; j < size - 1; j++) {\\n+                size_t index = row + (size_t)j;\\n+                new_grid[index] = 0.25 * (grid[index + 1] + grid[index - 1] +\\n+                                          grid[north + (size_t)j] +\\n+                                          grid[south + (size_t)j]);\\n+\\n+                double errorCurrent = absolute(new_grid[index] - grid[index]);\\n+                if (errorCurrent > CONV_THRESHOLD) {\\n+                    hasError = 1;\\n+                }\\n             }\\n-        }        \\n+        }\\n+\\n+        double *tmp = grid;\\n+        grid = new_grid;\\n+        new_grid = tmp;\\n         iter++;\\n     }\\n \\n-    // get the end time\\n-    //gettimeofday(&time_end, NULL);\\n-\\n-    //double exec_time = (double) (time_end.tv_sec - time_start.tv_sec) +\\n-    //                   (double) (time_end.tv_usec - time_start.tv_usec) / 1000000.0;\\n-\\n-    //save the final grid in file\\n-    save_grid();\\n-\\n-    //printf(\\\"\\\\nKernel executed in %lf seconds with %d iterations.\\\\n\\\", exec_time, iter);\\n-\\n+    save_grid(grid);\\n     return 0;\\n }\"}, {\"id\": \"14fee20610e2489e\", \"role\": \"A\", \"commit\": \"63415ff95db67740fbf8cd708ae462e3da9ec5bd\", \"transformations\": {\"files\": [\"src/laplace_seq.c\"], \"retained\": [\"Allocate two contiguous buffers on 64-byte boundaries and pad the row stride to a multiple of eight doubles.\", \"Use the padded stride for initialization, stencil access, and output while leaving padding cells unused.\", \"Swap source and destination buffers after each Jacobi iteration instead of copying interior cells.\"]}, \"mean_seconds\": 0.07018845590452354, \"diff\": \"diff --git a/src/laplace_seq.c b/src/laplace_seq.c\\nindex 439dbbb..62e0faa 100644\\n--- a/src/laplace_seq.c\\n+++ b/src/laplace_seq.c\\n@@ -1,132 +1,105 @@\\n-/*\\n-    This program solves Laplace's equation on a regular 2D grid using simple Jacobi iteration.\\n-\\n-    The stencil calculation stops when  ( err >= CONV_THRESHOLD OR  iter > ITER_MAX )\\n-*/\\n+#define _POSIX_C_SOURCE 200112L\\n+#include <stdint.h>\\n #include <stdio.h>\\n #include <stdlib.h>\\n-#include <time.h>\\n-#include <sys/time.h>\\n-\\n-#define CONV_THRESHOLD 1.0e-5f // threshold of convergence\\n \\n-// matrix to be solved\\n-double **grid;\\n+#define CONV_THRESHOLD 1.0e-5f\\n \\n-// auxiliary matrix\\n-double **new_grid;\\n+static double *grid;\\n+static double *new_grid;\\n+static size_t row_stride;\\n+static int size;\\n+static int iter_max_num;\\n \\n-// size of each side of the grid\\n-int size;\\n-int iter_max_num;\\n-\\n-// return the absolute value of a number\\n-double absolute(double num){\\n-    if(num < 0)\\n+static double absolute(double num) {\\n+    if (num < 0)\\n         return -1.0 * num;\\n     return num;\\n }\\n \\n-\\n-// allocate memory for the grid\\n-void allocate_memory(){\\n-    grid = (double **) malloc(size * sizeof(double *));\\n-    new_grid = (double **) malloc(size * sizeof(double *));\\n-\\n-    for(int i = 0; i < size; i++){\\n-        grid[i] = (double *) malloc(size * sizeof(double));\\n-        new_grid[i] = (double *) malloc(size * sizeof(double));\\n+static int allocate_memory(void) {\\n+    size_t n = (size_t)size;\\n+    if (n > SIZE_MAX - 7u)\\n+        return 0;\\n+    row_stride = (n + 7u) & ~(size_t)7u;\\n+    if (row_stride > SIZE_MAX / n / sizeof(double))\\n+        return 0;\\n+\\n+    size_t bytes = row_stride * n * sizeof(double);\\n+    if (posix_memalign((void **)&grid, 64, bytes) != 0)\\n+        return 0;\\n+    if (posix_memalign((void **)&new_grid, 64, bytes) != 0) {\\n+        free(grid);\\n+        grid = NULL;\\n+        return 0;\\n     }\\n+    return 1;\\n }\\n \\n-// initialize the grid\\n-void initialize_grid(){\\n+static void initialize_grid(void) {\\n     int center = size / 2;\\n     int linf = center - (size / 10);\\n     int lsup = center + (size / 10);\\n-    for (int i = 0; i < size; i++){\\n-        for (int j = 0; j < size; j++){\\n-            // inicializa região de calor no centro do grid\\n-            if ( i >= linf && i <= lsup && j >= linf && j <= lsup)\\n-                grid[i][j] = 100;\\n+    for (int i = 0; i < size; i++) {\\n+        size_t row = (size_t)i * row_stride;\\n+        for (int j = 0; j < size; j++) {\\n+            double value;\\n+            if (i >= linf && i <= lsup && j >= linf && j <= lsup)\\n+                value = 100;\\n             else\\n-                grid[i][j] = 0;\\n-            new_grid[i][j] = 0.0;\\n+                value = 0;\\n+            grid[row + (size_t)j] = value;\\n+            new_grid[row + (size_t)j] = value;\\n         }\\n     }\\n }\\n \\n-// save the grid in a file\\n-void save_grid(){\\n-\\n-    for(int i = 0; i < size; i++){\\n-        for(int j = 0; j < size; j++){\\n-            fprintf(stdout, \\\"%lf \\\", grid[i][j]);\\n-        }\\n+static void save_grid(void) {\\n+    for (int i = 0; i < size; i++) {\\n+        size_t row = (size_t)i * row_stride;\\n+        for (int j = 0; j < size; j++)\\n+            fprintf(stdout, \\\"%lf \\\", grid[row + (size_t)j]);\\n         fprintf(stdout, \\\"\\\\n\\\");\\n     }\\n }\\n \\n-int main(int argc, char *argv[]){\\n+int main(int argc, char *argv[]) {\\n+    (void)argc;\\n+    (void)argv;\\n \\n     fscanf(stdin, \\\"%d\\\", &size);\\n     fscanf(stdin, \\\"%d\\\", &iter_max_num);\\n-    \\n-    int hasError = 1;\\n-    int iter = 0;\\n-\\n-    struct timeval time_start;\\n-    struct timeval time_end;\\n \\n-    // allocate memory to the grid (matrix)\\n-    allocate_memory();\\n-\\n-    // set grid initial conditions\\n+    if (size <= 0)\\n+        return 0;\\n+    if (!allocate_memory())\\n+        return 1;\\n     initialize_grid();\\n \\n-    //printf(\\\"Jacobi relaxation calculation: %d x %d grid\\\\n\\\", size, size);\\n-\\n-    // get the start time\\n-    //gettimeofday(&time_start, NUL
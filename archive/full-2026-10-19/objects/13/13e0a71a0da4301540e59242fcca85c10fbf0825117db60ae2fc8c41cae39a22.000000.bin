        "ordinal": 1,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/laplace_seq.c"
          ],
          "retained": [
            "Use one persistent OpenMP team for grids of at least 128 rows; retain the original serial loop for smaller grids and builds without OpenMP.",
            "Statically distribute stencil and copy rows, reducing per-cell convergence flags with bitwise OR.",
            "Use nowait on copying and the subsequent single-region barrier to complete copies and publish termination, requiring two barriers per iteration."
          ]
        },

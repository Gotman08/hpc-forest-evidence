#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <limits>
#include <vector>

#if defined(__aarch64__)
#include <arm_neon.h>
#endif

class FastInput {
    enum { buffer_size = 1 << 20 };
    char buffer_[buffer_size];
    std::size_t position_ = 0;
    std::size_t size_ = 0;

    bool next(char& character) {
        if (position_ == size_) {
            size_ = std::fread(buffer_, 1, buffer_size, stdin);
            position_ = 0;
            if (size_ == 0) {
                return false;
            }
        }
        character = buffer_[position_++];
        return true;
    }

public:
    bool read_int(int& result) {
        char character = 0;
        do {
            if (!next(character)) {
                return false;
            }
        } while (static_cast<unsigned char>(character) <= ' ');

        bool negative = false;
        if (character == '-' || character == '+') {
            negative = character == '-';
            if (!next(character)) {
                return false;
            }
        }

        std::int64_t value = 0;
        do {
            value = value * 10 + (character - '0');
            if (!next(character)) {
                break;
            }
        } while (character >= '0' && character <= '9');

        result = static_cast<int>(negative ? -value : value);
        return true;
    }
};

static inline std::int64_t row_maximum(const std::int64_t* sums, int n, int s) {
    std::int64_t window = 0;
    for (int column = 0; column < s; ++column) {
        window += sums[column];
    }

    std::int64_t maximum = window;
#if defined(__aarch64__)
    int right = s;
    for (; right + 3 < n; right += 4) {
        const int64x2_t differences0 = vsubq_s64(vld1q_s64(sums + right),
                                                  vld1q_s64(sums + right - s));
        const int64x2_t differences1 = vsubq_s64(vld1q_s64(sums + right + 2),
                                                  vld1q_s64(sums + right + 2 - s));
        const int64x2_t prefix0 = vaddq_s64(
            differences0, vcombine_s64(vdup_n_s64(0), vget_low_s64(differences0)));
        const std::int64_t carry = vgetq_lane_s64(prefix0, 1);
        const int64x2_t partial1 = vaddq_s64(differences1, vdupq_n_s64(carry));
        const int64x2_t prefix1 = vaddq_s64(
            differences1, vcombine_s64(vdup_n_s64(carry), vget_low_s64(partial1)));
        const int64x2_t windows0 = vaddq_s64(vdupq_n_s64(window), prefix0);
        const int64x2_t windows1 = vaddq_s64(vdupq_n_s64(window), prefix1);
        const int64x2_t candidates = vmaxq_s64(windows0, windows1);
        const std::int64_t candidate0 = vgetq_lane_s64(candidates, 0);
        const std::int64_t candidate1 = vgetq_lane_s64(candidates, 1);
        if (candidate0 > maximum) {
            maximum = candidate0;
        }
        if (candidate1 > maximum) {
            maximum = candidate1;
        }
        window = vgetq_lane_s64(windows1, 1);
    }
    for (; right < n; ++right) {
        window += sums[right] - sums[right - s];
        if (window > maximum) {
            maximum = window;
        }
    }
#else
    for (int right = s; right < n; ++right) {
        window += sums[right] - sums[right - s];
        if (window > maximum) {
            maximum = window;
        }
    }
#endif
    return maximum;
}

int main() {
    FastInput input;
    int n = 0;
    int s = 0;
    if (!input.read_int(n) || !input.read_int(s)) {
        return 0;
    }

    const std::size_t width = static_cast<std::size_t>(n);
    std::vector<int> ring(static_cast<std::size_t>(s) * width);
    std::vector<std::int64_t> column_sums(width, 0);
    int* const ring_begin = ring.data();
    int* const ring_end = ring_begin + ring.size();
    int* slot = ring_begin;

    for (int row = 0; row < s; ++row) {
        for (int column = 0; column < n; ++column) {
            int value = 0;
            input.read_int(value);
            slot[column] = value;
            column_sums[column] += value;
        }
        slot += n;
    }
    if (slot == ring_end) {
        slot = ring_begin;
    }

    std::int64_t maximum = row_maximum(column_sums.data(), n, s);
    for (int row = s; row < n; ++row) {
        for (int column = 0; column < n; ++column) {
            int value = 0;
            input.read_int(value);
            column_sums[column] += static_cast<std::int64_t>(value) - slot[column];
            slot[column] = value;
        }
        slot += n;
        if (slot == ring_end) {
            slot = ring_begin;
        }

        const std::int64_t current = row_maximum(column_sums.data(), n, s);
        if (current > maximum) {
            maximum = current;
        }
    }

    std::printf("%lld\n", static_cast<long long>(maximum));
    return 0;
}

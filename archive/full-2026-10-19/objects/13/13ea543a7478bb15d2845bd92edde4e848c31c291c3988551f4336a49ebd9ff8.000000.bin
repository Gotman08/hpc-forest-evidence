      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <limits>\n#include <memory>\n#include <vector>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\nusing Sum = std::int64_t;\n\nclass FastInput {\n    unsigned char buffer[1 << 16];\n    std::size_t position = 0;\n    std::size_t available = 0;\n\n    int next() {\n        if (position == available) {\n            available = std::fread(buffer, 1, sizeof(buffer), stdin);\n            position = 0;\n            if (available == 0)\n                return EOF;\n        }\n        return buffer[position++];\n    }\n\npublic:\n    bool readInt(int& result) {\n        int c = next();\n        while (c != EOF && c <= ' ')\n            c = next();\n        if (c == EOF)\n            return false;\n\n        bool negative = false;\n        if (c == '-' || c == '+') {\n            negative = c == '-';\n            c = next();\n        }\n\n        std::uint32_t magnitude = 0;\n        while (c >= '0' && c <= '9') {\n            magnitude = magnitude * 10u + static_cast<unsigned>(c - '0');\n            c = next();\n        }\n        const Sum value = static_cast<Sum>(magnitude);\n        result = static_cast<int>(negative ? -value : value);\n        return true;\n    }\n};\n\n#if defined(__aarch64__)\nstatic inline int64x2_t max_pair(int64x2_t a, int64x2_t b) {\n    return vbslq_s64(vcgtq_s64(a, b), a, b);\n}\n\nstatic inline void update_pair(const Sum* fresh, Sum* previous, Sum* totals,\n                               int64x2_t& maximum) {\n    const int64x2_t incoming = vld1q_s64(fresh);\n    const int64x2_t outgoing = vld1q_s64(previous);\n    const int64x2_t value = vaddq_s64(\n        vsubq_s64(vld1q_s64(totals), outgoing), incoming);\n    vst1q_s64(totals, value);\n    vst1q_s64(previous, incoming);\n    maximum = max_pair(maximum, value);\n}\n#endif\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.readInt(n) || !input.readInt(s))\n        return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const int width = n - s + 1;\n    std::vector<int> row(n);\n    std::vector<Sum> horizontal(width);\n    std::vector<Sum> totals(width, 0);\n    std::unique_ptr<Sum[]> history(\n        new Sum[static_cast<std::size_t>(s) * width]);\n    Sum best = std::numeric_limits<Sum>::lowest();\n\n#if defined(__aarch64__)\n    int64x2_t best0 = vdupq_n_s64(std::numeric_limits<Sum>::lowest());\n    int64x2_t best1 = best0;\n    int64x2_t best2 = best0;\n    int64x2_t best3 = best0;\n#endif\n\n    for (int r = 0; r < n; ++r) {\n        for (int col = 0; col < n; ++col) {\n            if (!input.readInt(row[col]))\n                return 0;\n        }\n\n        Sum running = 0;\n        #pragma omp simd reduction(+:running)\n        for (int col = 0; col < s; ++col)\n            running += static_cast<Sum>(row[col]);\n        horizontal[0] = running;\n        for (int col = s; col < n; ++col) {\n            running += static_cast<Sum>(row[col])\n                     - static_cast<Sum>(row[col - s]);\n            horizontal[col - s + 1] = running;\n        }\n\n        Sum* previous = history.get()\n                      + static_cast<std::size_t>(r % s) * width;\n        if (r < s - 1) {\n            #pragma omp simd\n            for (int col = 0; col < width; ++col) {\n                totals[col] += horizontal[col];\n                previous[col] = horizontal[col];\n            }\n        } else if (r == s - 1) {\n            #pragma omp simd reduction(max:best)\n            for (int col = 0; col < width; ++col) {\n                const Sum value = totals[col] + horizontal[col];\n                totals[col] = value;\n                previous[col] = horizontal[col];\n                best = std::max(best, value);\n            }\n        } else {\n#if defined(__aarch64__)\n            int col = 0;\n            for (; col + 7 < width; col += 8) {\n                update_pair(horizontal.data() + col,\n                            previous + col, totals.data() + col, best0);\n                update_pair(horizontal.data() + col + 2,\n                            previous + col + 2, totals.data() + col + 2, best1);\n                update_pair(horizontal.data() + col + 4,\n                            previous + col + 4, totals.data() + col + 4, best2);\n                update_pair(horizontal.data() + col + 6,\n                            previous + col + 6, totals.data() + col + 6, best3);\n            }\n            for (; col + 1 < width; col += 2)\n                update_pair(horizontal.data() + col,\n                            previous + col, totals.data() + col, best0);\n            for (; col < width; ++col) {\n                const Sum value = totals[col] - previous[col] + horizontal[col];\n                totals[col] = value;\n                previous[col] = horizontal[col];\n                best = std::max(best, value);\n            }\n#else\n            #pragma omp simd reduction(max:best)\n            for (int col = 0; col < width; ++col) {\n                const Sum value = totals[col] - previous[col] + horizontal[col];\n                totals[col] = value;\n                previous[col] = horizontal[col];\n                best = std::max(best, value);\n            }\n#endif\n        }\n    }\n\n#if defined(__aarch64__)\n    best0 = max_pair(best0, best1);\n    best2 = max_pair(best2, best3);\n    best0 = max_pair(best0, best2);\n    best = std::max(best, static_cast<Sum>(vgetq_lane_s64(best0, 0)));\n    best = std::max(best, static_cast<Sum>(vgetq_lane_s64(best0, 1)));\n#endif\n\n    std::printf(\"%d\\n\", static_cast<int>(best));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Interchanging the separable rolling-sum stages makes window updates independent across contiguous columns, enabling ARM64 NEON updates and four independent maximum-reduction chains.",

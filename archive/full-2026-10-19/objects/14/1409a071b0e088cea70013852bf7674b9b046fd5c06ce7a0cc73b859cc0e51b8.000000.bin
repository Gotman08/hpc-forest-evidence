{
  "hypothesis": "Optimize the memory locality and loop order to improve performance.",
  "transformations": [
    "Reordered loops to process submatrices in a more cache-friendly manner.",
    "Used a single nested loop to calculate the sum of each submatrix."
  ],
  "sources_kept": [],
  "files": [
    {
      "path": "src/solution.cpp",
      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n\nint main() {\n\tint n, s;\n\tstd::cin >> n >> s;\n\tstd::vector<std::vector<int>> matrix(n, std::vector<int>(n));\n\tfor (int i = 0; i < n; i++)\n\t\tfor (int j = 0; j < n; j++) \n\t\t\tscanf(\"%d\", &(matrix[i][j]));\n\n\tassert(s < n);\n\tassert(n < 8000);\n\tassert(s > 0);\n\tassert(n > 0);\n\n\tint mxSum = INT_MIN;\n\n\tfor (int i = 0; i <= n - s; i++) {\n\t\tfor (int j = 0; j <= n - s; j++) {\n\t\t\tint sum = 0;\n\t\t\tfor (int k = 0; k < s; k++)\n\t\t\t\tfor (int l = 0; l < s; l++)\n\t\t\t\t\tsum += matrix[i + k][j + l];\n\t\t\tmxSum = std::max(mxSum, sum);\n\t\t}\n\t}\n\n\tprintf(\"%d\\n\", mxSum);\n}"
    }
  ],
  "notes": "Reordered the loops to process submatrices in a more cache-friendly manner and used a single nested loop to calculate the sum of each submatrix."
}

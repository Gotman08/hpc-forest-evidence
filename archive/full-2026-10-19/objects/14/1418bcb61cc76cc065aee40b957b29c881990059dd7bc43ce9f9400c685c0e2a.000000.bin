        "content": "#include <stdio.h>\n#include <stdlib.h>\n\n#define MAXNUM 100\n#define MAXSTR 50\n#define MAXRESULTS 1000\n\nchar firstHalf[MAXNUM][MAXSTR];\nchar secondHalf[MAXNUM][MAXSTR];\nlong int result[MAXRESULTS];\nint numPrimes=0;\n\nint isprime(long int value)\n{\n  static const int increments[8] = {4, 2, 4, 2, 4, 6, 2, 6};\n  long int factor=7;\n  int step=0;\n\n  if (value < 2)\n    return 0;\n  if (value == 2 || value == 3 || value == 5)\n    return 1;\n  if (value % 2 == 0 || value % 3 == 0 || value % 5 == 0)\n    return 0;\n\n  while (factor <= value / factor)\n    {\n      if (value % factor == 0)\n        return 0;\n      factor += increments[step];\n      step = (step + 1) & 7;\n    }\n  return 1;\n}\n\nvoid quicksort(long int *primes,int first,int last)\n{ int i, j, pivot;\n  long int temp;\n\n  if (first<last)\n     { pivot=first;\n       i=first;\n       j=last;\n       while(i<j)\n         { while (primes[i]<=primes[pivot]&&i<last)\n             i++;\n           while (primes[j]>primes[pivot])\n             j--;\n           if (i<j)\n              { temp=primes[i];\n                primes[i]=primes[j];\n                primes[j]=temp;\n              }\n         }\n       temp=primes[pivot];\n       primes[pivot]=primes[j];\n       primes[j]=temp;\n       quicksort(primes,first,j-1);\n       quicksort(primes,j+1,last);\n     }\n}\n\nint main(int argc,char** argv)\n{ FILE *primesFile;\n  int i=0,j=0,numResults=0,candidateCount;\n  long int firstValue[MAXNUM];\n  long int secondValue[MAXNUM];\n  long int candidates[MAXNUM * MAXNUM];\n  long int primeToTest;\n  primesFile=stdin;\n  fscanf(primesFile,\"%d\\n\",&numPrimes);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",firstHalf[i]);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",secondHalf[i]);\n  fclose(primesFile);\n\n  for (i=0;i<numPrimes;i++)\n      firstValue[i]=atol(firstHalf[i]);\n  for (i=0;i<numPrimes;i++)\n      secondValue[i]=atol(secondHalf[i]);\n\n  candidateCount=numPrimes*numPrimes;\n  for (i=0;i<numPrimes;i++)\n      { int row=i*numPrimes;\n        long int prefix=firstValue[i]*10000000L;\n        #pragma GCC ivdep\n        for (j=0;j<numPrimes;j++)\n            candidates[row+j]=prefix+secondValue[j];\n      }\n\n  for (i=0;i<candidateCount;i++)\n      { primeToTest=candidates[i];\n        if (isprime(primeToTest))\n           { result[numResults++]=primeToTest;\n           }\n      }\n  quicksort(result,0,numResults-1);\n  for (i=0;i<numResults;i++)\n      printf(\"%ld\\n\",result[i]);\n  return 0;\n}\n",

    "script": "#!/usr/bin/env bash\n# Genere par romeo-mcp - ne pas editer a la main.\n#SBATCH --job-name=forest-primes-luna-max-r1b\n#SBATCH --account=r250127\n#SBATCH --qos=normal\n#SBATCH --partition=short\n#SBATCH --constraint=armgpu\n#SBATCH --time=03:00:00\n#SBATCH --nodes=1\n#SBATCH --ntasks-per-node=1\n#SBATCH --cpus-per-task=4\n#SBATCH --mem=16G\n#SBATCH --chdir=/scratch_p/nimarano\n#SBATCH --output=/scratch_p/nimarano/%x-%j.out\n#SBATCH --error=/scratch_p/nimarano/%x-%j.err\n\nset -euo pipefail\n\n# Sans cette fonction, un job ROMEO 2025 n'a acces a aucun logiciel,\n# pas meme a la commande spack. Elle est propre a l'architecture :\n# charger celle de l'autre donnerait des binaires inutilisables.\nromeo_load_armgpu_env\n\n# Provenance du premier demarrage : environnement, commit et fichiers choisis.\nif command -v python3 >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then\n  if timeout 20s python3 -I -S - '{\"roots\": [\"/scratch_p/nimarano\", \"/project\"], \"include_home\": true, \"code_dir\": \"/scratch_p/nimarano\", \"data_files\": [\"/scratch_p/nimarano/hpc-forest-primes-native-contract-qualification-20261017-r1-1e17d198d5a2/extraction/HPC-Forest-Primes-Natif-MAX-r1.zip\", \"/scratch_p/nimarano/hpc-forest-primes-native-contract-qualification-20261017-r1-1e17d198d5a2/extraction/native-max-plan.json\", \"/scratch_p/nimarano/hpc-forest-primes-native-contract-qualification-20261017-r1-1e17d198d5a2/extraction/runtime-manifest-r2max.json\"], \"max_bytes\": 67108864}' <<'ROMEO_REPRO_CAPTURE'\n\nimport hashlib, json, os, pathlib, re, stat, subprocess, sys\nparams = json.loads(sys.argv[1])\nroots = [pathlib.Path(p).resolve() for p in params['roots']]\nif params.get('include_home'):\n    roots.append(pathlib.Path.home().resolve())\ndef allowed(value):\n    path = pathlib.Path(value).resolve()\n    if not any(path == root or root in path.parents for root in roots):\n        raise ValueError('outside_roots')\n    if any(p.lower().startswith(('.env', 'id_rsa', 'id_ed25519', 'id_ecdsa')) or p.lower() in ('.ssh', '.aws', '.azure', '.kube', 'hosts.yml')\n           or p.lower().endswith(('.pem', '.key', '.p12', '.pfx'))\n           or re.search(r'password|passwd|passphrase|secret|token|credential|authorization|cookie|api[_-]?key|access[_-]?key|private[_-]?key', p, re.I)\n           for p in path.parts):\n        raise ValueError('sensitive_path')\n    return path\nout = {'git': {'status': 'unavailable'}, 'data': []}\ntry:\n    code = allowed(params['code_dir'])\n    result = subprocess.run(['git', '-c', 'core.fsmonitor=false', '-C', str(code),\n                             'rev-parse', '--verify', 'HEAD'],\n                            capture_output=True, text=True, timeout=5,\n                            env={**os.environ, 'GIT_OPTIONAL_LOCKS': '0'})\n    sha = result.stdout.strip()\n    if result.returncode == 0 and len(sha) in (40, 64) and all(c in '0123456789abcdef' for c in sha):\n        out['git'] = {'status': 'observed', 'commit': sha, 'working_tree_verified': False}\nexcept (OSError, ValueError, subprocess.TimeoutExpired):\n    pass\nremaining = params['max_bytes']\nfor name in params['data_files']:\n    item = {'path': name}\n    try:\n        path = allowed(name)\n        info = path.stat()\n        if not stat.S_ISREG(info.st_mode):\n            item['status'] = 'not_regular_file'\n        elif info.st_size > remaining:\n            item.update(status='size_limit', bytes=info.st_size)\n        else:\n            h = hashlib.sha256()\n            consumed = 0\n            with path.open('rb') as stream:\n                while True:\n                    block = stream.read(min(1048576, remaining - consumed + 1))\n                    if not block:\n                        break\n                    consumed += len(block)\n                    if consumed > remaining:\n                        break\n                    h.update(block)\n            after = path.stat()\n            remaining = max(0, remaining - consumed)\n            if consumed != info.st_size or (info.st_size, info.st_mtime_ns, info.st_ino) != (after.st_size, after.st_mtime_ns, after.st_ino):\n                item['status'] = 'changed_during_read'\n            else:\n                item.update(status='hashed', sha256=h.hexdigest(), bytes=consumed)\n    except (OSError, ValueError):\n        item['status'] = 'unreadable_or_outside_roots'\n    out['data'].append(item)\n\n\nimport datetime, platform\nout['observed_at'] = datetime.datetime.now(datetime.timezone.utc).isoformat()\nout['phase'] = 'before_workload'\nout['environment'] = {\n    'source': 'compute_node_before_command', 'architecture': platform.machine(),\n    'python_version': platform.python_version(),\n    'loaded_modules': [v for v in os.environ.get('LOADEDMODULES', '').split(':') if v][:128],\n    'spack_loaded_hashes': [v for v in os.environ.get('SPACK_LOADED_HASHES', '').split(':') if v][:128],\n}\njid = os.environ.get('SLURM_JOB_ID', '')\nif os.environ.get('SLURM_ARRAY_JOB_ID') and os.environ.get('SLURM_ARRAY_TASK_ID'):\n    jid = os.environ['SLURM_ARRAY_JOB_ID'] + '_' + os.environ['SLURM_ARRAY_TASK_ID']\nif not re.fullmatch(r'[0-9]+(?:_[0-9]+)?', jid):\n    raise ValueError('missing_job_id')\nout['job_id'] = jid\nfolder = pathlib.Path('.romeo-provenance')\nfolder.mkdir(mode=0o700, exist_ok=True)\nif folder.is_symlink():\n    raise ValueError('symlink_capture_directory')\nout['restart_count'] = os.environ.get('SLURM_RESTART_COUNT', '0')\ntry:\n    fd = os.open(folder / (jid + '.json'), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)\nexcept FileExistsError:\n    pass\nelse:\n    with os.fdopen(fd, 'w') as stream:\n        json.dump(out, stream)\n        stream.write('\\n')\nROMEO_REPRO_CAPTURE\n  then :; else\n    printf '%s\\n' '[romeo-mcp] provenance indisponible ; le calcul continue.' >&2\n  fi\nfi\n\n\n# Trace d'execution : sert a diagnostiquer les erreurs d'architecture.\necho \"[romeo-mcp] noeud=$(hostname) arch=$(uname -m) job=${SLURM_JOB_ID:-?}\"\necho \"[romeo-mcp] debut $(date -Is)\"\n\nset -euo pipefail\n[[ ${SLURM_JOB_ID:-} =~ ^[0-9]+$ ]] || { echo 'Existing owned Slurm allocation required' >&2; exit 70; }\n[[ ${SLURM_JOB_NUM_NODES:-} == 1 && ${SLURM_NTASKS:-} == 1 && ${SLURM_CPUS_PER_TASK:-} == 4 && ${SLURM_MEM_PER_NODE:-} == 16384 ]] || { echo 'Exact 1node/1task/4CPU/16Gi allocation required' >&2; exit 71; }\n[[ ${SLURM_RESTART_COUNT:-0} == 0 ]] || { echo 'No Slurm/native replay allowed' >&2; exit 72; }\nexport PYTHONDONTWRITEBYTECODE=1\nexport PYTHONUNBUFFERED=1\nexport OPENBLAS_NUM_THREADS=1\nexport OMP_NUM_THREADS=4\nsrun --nodes=1 --ntasks=1 --cpus-per-task=4 --cpu-bind=cores /scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python -I -B -u - <<'R2MAX_FIRST_NATIVE_LUNA_PREFLIGHT'\n\"\"\"Proposed allocated preflight only; this local file has never been executed.\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport os\nimport platform\nimport re\nimport shlex\nimport sys\nimport zipfile\nfrom datetime import UTC, datetime, timedelta\nfrom pathlib import Path\n\nSCOPE = \"hpc-forest-primes-native-max-r1\"\nSESSION = \"c8044062692149138d826d3f388a08ef\"\nSOURCE_SHA = \"3e290f835570a8746be3c52144932b8c6866564980fd858cf4c0495a7b1e68c5\"\nPLAN_SHA = \"54ffd49f4dc868085d22208f773c4b4883590b25251b5992232509a1dc197024\"\nRUNTIME_MANIFEST_SHA = \"093a48b13cea5361f971e38fdeb10bfea281ac0a256b2a8c7504c7cbec019756\"\nEXTRACTION = Path(\"/scratch_p/nimarano/hpc-forest-primes-native-contract-qualification-20261017-r1-1e17d198d5a2/extraction\")\nNATIVE_ROOT = Path(\"/scratch_p/nimarano/hpc-forest-primes-native-max-r1-c8044062692149138d826d3f388a08ef\")\nPYTHON = \"/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python\"\nSPACK_GCC = \"/zrtbeqke25s2vbqo4yrhsowjz7mg3pjf\"\nDEADLINE = datetime(2026, 10, 31, 23, tzinfo=UTC)\n\n\ndef require(value, message):\n    if not value:\n        raise RuntimeError(message)\n\n\ndef sha(path):\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\n\n# Refuse before Spack, native imports, directory creation, mailbox or model calls.\nenv = os.environ\nrequire(platform.system() == \"Linux\" and platform.machine().lower() in {\"aarch64\", \"arm64\"}, \"Own Linux ARM64 compute allocation required\")\nrequire(re.fullmatch(r\"[0-9]+\", env.get(\"SLURM_JOB_ID\", \"\")), \"Concrete allocated Slurm job required\")\nrequired = {\"SLURM_JOB_NUM_NODES\": \"1\", \"SLURM_NTASKS\": \"1\", \"SLURM_CPUS_PER_TASK\": \"4\", \"SLURM_MEM_PER_NODE\": \"16384\"}\nrequire(all(env.get(key) == value for key, value in required.items()), \"Exact 1-node/1-task/4-CPU/16384-MiB allocation required\")\nrequire(env.get(\"SLURM_RESTART_COUNT\", \"0\") == \"0\", \"Started native calls must never be replayed\")\nrequire(all(env.get(key, \"\") in {\"\", \"0\"} for key in (\"SLURM_GPUS\", \"SLURM_GPUS_PER_NODE\", \"SLURM_JOB_GPUS\", \"SLURM_STEP_GPUS\", \"CUDA_VISIBLE_DEVICES\")), \"Zero GPU allocation required\")\nrequire(hasattr(os, \"sched_getaffinity\"), \"Effective affinity must be observable\")\naffinity = sorted(os.sched_getaffinity(0))\nrequire(len(affinity) == 4, \"Exactly four effective CPUs required\")\nrequire(datetime.now(UTC) + timedelta(seconds=10800 + 10800) < DEADLINE, \"Exclusive deadline cannot fit 3-hour allocation plus 3-hour receipt/audit reserve\")\nrequire(not NATIVE_ROOT.exists() and not NATIVE_ROOT.is_symlink(), \"Fresh native root required; preserve any earlier attempt without replay\")\nrequire(Path(sys.executable).resolve() == Path(PYTHON).resolve(), \"Exact existing ARM64 Python required\")\nsource_zip = EXTRACTION / \"HPC-Forest-Primes-Natif-MAX-r1.zip\"\nplan_path = EXTRACTION / \"native-max-plan.json\"\nruntime_manifest = EXTRACTION / \"runtime-manifest-r2max.json\"\nfor path, expected in ((source_zip, SOURCE_SHA), (plan_path, PLAN_SHA), (runtime_manifest, RUNTIME_MANIFEST_SHA)):\n    require(path.is_file() and not path.is_symlink() and sha(path) == expected, \"Changed deployed r1b artifact: \" + path.name)\nproject = EXTRACTION / \"HPC-Forest\"\nrequire(project.is_dir() and not project.is_symlink(), \"Existing deployed project required\")\nexpected_files = json.loads(runtime_manifest.read_bytes())\nrequire(len(expected_files) == 99, \"Exact 99-member deployed source required\")\nlocal = {p.relative_to(project).as_posix(): p for p in project.rglob(\"*\") if p.is_file() and not any(part in {\"__pycache__\", \".ruff_cache\", \".pytest_cache\"} for part in p.relative_to(project).parts)}\nrequire(set(local) == set(expected_files) and all(not p.is_symlink() and sha(p) == expected_files[name] for name, p in local.items()), \"Deployed source membership or bytes changed\")\nwith zipfile.ZipFile(source_zip) as archive:\n    names = archive.namelist()\n    require(len(names) == len(set(names)) == 99, \"Source ZIP membership changed\")\n    require(all(name.startswith(\"HPC-Forest/\") and name.removeprefix(\"HPC-Forest/\") in local and archive.read(name) == local[name.removeprefix(\"HPC-Forest/\")].read_bytes() for name in names), \"Deployed source differs from exact r1b ZIP\")\nplan = json.loads(plan_path.read_bytes())\nrequire(plan.get(\"scope_id\") == SCOPE and plan.get(\"source_zip_sha256\") == SOURCE_SHA and plan.get(\"first_launch_model\") == \"gpt-6-luna\" and plan.get(\"first_launch_session_id\") == SESSION and plan.get(\"efforts\") == [\"max\"] and plan.get(\"automatic_extension\") is False, \"Exact Luna MAX first-launch plan required\")\nsys.path.insert(0, str(project / \"src\"))\nfrom hpc_forest.native_r2max import allocation_guard, verify_runtime\nallocation = allocation_guard()\nverify_runtime(source_zip)\nprint(json.dumps({\"schema\": \"hpc-forest-primes-r2max-native-allocated-preflight-v1\", \"scope_id\": SCOPE, \"session_id\": SESSION, \"model\": \"gpt-6-luna\", \"effort\": \"max\", \"mother_model\": \"gpt-6-luna\", \"mother_effort\": \"max\", \"allocation\": allocation, \"source_zip_sha256\": SOURCE_SHA, \"plan_sha256\": PLAN_SHA, \"source_files_verified\": 99, \"qualification_job_not_replayed\": \"751975\", \"spack_gcc_existing_hash\": SPACK_GCC, \"native_model_calls_before_wait\": 0, \"authorization_still_required\": True, \"utc\": datetime.now(UTC).isoformat()}), flush=True)\nWAIT_ARGV = ['/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python', '-I', '-B', '-u', '/scratch_p/nimarano/hpc-forest-primes-native-contract-qualification-20261017-r1-1e17d198d5a2/extraction/HPC-Forest/examples/marathon22/wait_r2max_authorization.py', '--root', '/scratch_p/nimarano/hpc-forest-primes-native-max-r1-c8044062692149138d826d3f388a08ef', '--authorization', '/scratch_p/nimarano/hpc-forest-primes-native-max-admission-c8044062692149138d826d3f388a08ef/authorization.json', '--authorization-ready', '/scratch_p/nimarano/hpc-forest-primes-native-max-admission-c8044062692149138d826d3f388a08ef/authorization-ready.json', '--wait-seconds', '600']\n# Load only an existing GCC after all allocation/source guards. No installation.\ncommand = \"set -euo pipefail\\nromeo_load_armgpu_env\\nspack load \" + shlex.quote(SPACK_GCC) + \"\\nexec \" + shlex.join(WAIT_ARGV)\nchild = {**env, \"PYTHONDONTWRITEBYTECODE\": \"1\", \"PYTHONUNBUFFERED\": \"1\", \"OPENBLAS_NUM_THREADS\": \"1\", \"MKL_NUM_THREADS\": \"1\", \"NUMEXPR_NUM_THREADS\": \"1\", \"OMP_NUM_THREADS\": \"4\", \"OMP_DYNAMIC\": \"FALSE\", \"OMP_PROC_BIND\": \"close\", \"OMP_PLACES\": \"cores\", \"CUDA_VISIBLE_DEVICES\": \"\"}\nos.execvpe(\"/bin/bash\", [\"/bin/bash\", \"-lc\", command], child)\nR2MAX_FIRST_NATIVE_LUNA_PREFLIGHT\n\necho \"[romeo-mcp] fin $(date -Is)\"\n",
    "runtime_artifacts": [],
    "submittable": true,
    "plan_id": "df97b91d9055496c8dc563714e94f24e",

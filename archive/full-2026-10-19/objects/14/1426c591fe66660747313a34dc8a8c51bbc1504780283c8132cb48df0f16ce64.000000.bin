    "content": "{\n  \"hypothesis\": \"Optimize the memory locality and loop order to improve performance.\",\n  \"transformations\": [\n    \"Reordered loops to improve cache locality\",\n    \"Used a sliding window technique for better memory access patterns\"\n  ],\n  \"sources_kept\": [],\n  \"files\": [\n    {\n      \"path\": \"src/solution.cpp\",\n      \"content\": \"#include <iostream>\\n#include <vector>\\n#include <cstdio>\\n#include <cassert>\\n\\nint main() {\\n\\tint n, s;\\n\\tstd::cin >> n >> s;\\n\\tstd::vector<std::vector<int>> matrix(n, std::vector<int>(n));\\n\\tfor (int i = 0; i < n; i++)\\n\\t\\tfor (int j = 0; j < n; j++) \\n\\t\\t\\tscanf(\\\"%d\\\", &(matrix[i][j]));\\n\\n\\tassert(s < n);\\n\\tassert(n < 8000);\\n\\tassert(s > 0);\\n\\tassert(n > 0);\\n\\n\\tint sum = 0;\\n\\tfor (int i = 0; i < s; i++)\\n\\t\\tfor (int j = 0; j < s; j++)\\n\\t\\t\\tsum += matrix[i][j];\\n\\n\\tint mxSum = sum;\\n\\n\\tfor (int i = 0; i <= n - s; i++) {\\n\\t\\tfor (int j = 1; j <= n - s; j++) {\\n\\t\\t\\tsum -= matrix[i][j - 1];\\n\\t\\t\\tsum += matrix[i + s - 1][j + s - 1];\\n\\t\\t\\tif (i > 0) sum -= matrix[i - 1][j + s - 1];\\n\\t\\t\\tmxSum = std::max(mxSum, sum);\\n\\t\\t}\\n\\t}\\n\\n\\tprintf(\\\"%d\\\\n\\\", mxSum);\\n}\"\n    }\n  ],\n  \"notes\": \"Reordered the loops to improve cache locality and used a sliding window technique for better memory access patterns.\"\n}"

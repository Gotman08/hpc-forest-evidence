        "content": "#include <cstdio>\n#include <cstdint>\n#include <vector>\n\nstatic constexpr int MOD = 1000000007;\n\nclass FastInput {\n    static constexpr size_t BUFFER_SIZE = 1 << 16;\n    char buffer[BUFFER_SIZE];\n    size_t pos = 0;\n    size_t size = 0;\n\n    int nextChar() {\n        if (pos == size) {\n            size = std::fread(buffer, 1, BUFFER_SIZE, stdin);\n            pos = 0;\n            if (size == 0) return EOF;\n        }\n        return buffer[pos++];\n    }\n\npublic:\n    bool readInt(int& value) {\n        int c;\n        do {\n            c = nextChar();\n            if (c == EOF) return false;\n        } while (c <= ' ');\n\n        bool negative = false;\n        if (c == '-') {\n            negative = true;\n            c = nextChar();\n        }\n        int result = 0;\n        while (c >= '0' && c <= '9') {\n            result = result * 10 + c - '0';\n            c = nextChar();\n        }\n        value = negative ? -result : result;\n        return true;\n    }\n};\n\nint main() {\n    FastInput input;\n    int n, m;\n    if (!input.readInt(n) || !input.readInt(m)) return 0;\n\n    const size_t side = static_cast<size_t>(n);\n    std::vector<uint8_t> blocked(side * side, 0);\n    for (int c = 0; c < m; ++c) {\n        int y = 0;\n        int x = 0;\n        if (!input.readInt(y) || !input.readInt(x)) return 0;\n        blocked[static_cast<size_t>(y) * side + static_cast<size_t>(x)] = 1;\n    }\n\n    std::vector<int> dp(n, 0);\n    dp[0] = blocked[0] ? 0 : 1;\n\n    for (int i = 0; i < n; ++i) {\n        const size_t row = static_cast<size_t>(i) * side;\n        for (int j = 0; j < n; ++j) {\n            if (i == 0 && j == 0) continue;\n            if (blocked[row + static_cast<size_t>(j)]) {\n                dp[j] = 0;\n            } else if (j != 0) {\n                int sum = dp[j] + dp[j - 1];\n                if (sum >= MOD) sum -= MOD;\n                dp[j] = sum;\n            }\n        }\n    }\n\n    std::printf(\"%d\\n\", dp[n - 1]);\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }

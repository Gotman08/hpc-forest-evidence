      "content": "/*\n  Quicksort\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <limits.h>\n#include <stdint.h>\n#include <openssl/md5.h>\n\n\n/*\n * Prototypes\n */\nvoid srandnum(int seed);\ndouble randnum(void);\nint *generate_case(int N);\ndouble drand(int xmin, int xmax);\nvoid swap(int *toorder, int i, int j);\nint partition(int *toorder, int lo, int hi);\nvoid _quicksort(int *toorder, int lo, int hi);\nvoid quicksort(int *toorder, int N);\nint is_sorted(int *toorder, int N);\nstatic void quicksort_parallel(int *toorder, int lo, int hi, uint64_t seed);\nstatic void quicksort_serial_seeded(int *toorder, int lo, int hi, uint64_t seed);\nstatic int partition_seeded(int *toorder, int lo, int hi, uint64_t *state);\n\n#define PARALLEL_SORT_THRESHOLD 32768\n#define TASK_SORT_CUTOFF 8192\n\n/*\n * A generic pRNG\n */\n#define MY_RAND_MAX 0x7FFFFFFF\n\n#define RANDNUM_W 521288629\n#define RANDNUM_Z 362436069\n\nunsigned int randum_w = RANDNUM_W;\nunsigned int randum_z = RANDNUM_Z;\n\nvoid srandnum(int seed)\n{\n    unsigned int w, z;\n    w = (seed * 104623) & 0xffffffff;\n    randum_w = (w) ? w : RANDNUM_W;\n    z = (seed * 48947) & 0xffffffff;\n    randum_z = (z) ? z : RANDNUM_Z;\n}\n\ndouble randnum(void)\n{\n    unsigned int u;\n    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);\n    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);\n    u = (randum_z << 16) + randum_w;\n    return (abs(u));\n}\n\n/*\n * Main function\n */\nint main(int argc, char *argv[])\n{\n    int N = 0;\n    int *our_list = NULL;\n\n    //The input provides the case size\n    scanf(\"%d\", &N);\n    if (N <= 0) {\n        printf(\"Error: please, provide the case size.\\n\");\n        return 1;\n    }\n\n    //Generate the case\n    our_list = generate_case(N);\n    if (our_list == NULL) {\n        printf(\"Error: case instantiation failed.\\n\");\n        return 1;\n    }\n\n    //Do the thing\n    quicksort(our_list, N);\n\n    if (is_sorted(our_list, N) == 1) {\n        printf(\"Error, for some reason list is still unsorted.\\n\");\n        return 1;\n    }\n\n#ifdef COMPUTE_MD5_PROBLEM\n    //Compute MD5 Checksum for problem identification\n    MD5_CTX c;\n    unsigned char out[MD5_DIGEST_LENGTH];\n    MD5_Init(&c);\n    MD5_Update(&c, our_list, N * sizeof(int));\n    MD5_Final(out, &c);\n    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {\n        printf(\"%02x\", out[n]);\n    }\n#endif\n    printf(\"\\n\");\n\n    //Clean up\n    free(our_list);\n\n    return 0;\n}\n\n/*\n * Public API\n */\nvoid quicksort(int *toorder, int N)\n{\n    if (N >= PARALLEL_SORT_THRESHOLD) {\n        uint64_t seed = ((uint64_t)randum_w << 32) | (uint64_t)randum_z;\n        #pragma omp parallel\n        {\n            #pragma omp single\n            {\n                quicksort_parallel(toorder, 0, N - 1, seed);\n            }\n        }\n    } else {\n        _quicksort(toorder, 0, N - 1);\n    }\n}\n\n/*\n * Internal recursive function to quicksort\n */\nvoid _quicksort(int *toorder, int lo, int hi)\n{\n    if (lo >= hi)\n        return;\n    int b = partition(toorder, lo, hi);\n    _quicksort(toorder, lo, b - 1);\n    _quicksort(toorder, b + 1, hi);\n}\n\nstatic uint64_t mix_seed(uint64_t value)\n{\n    value ^= value >> 30;\n    value *= UINT64_C(0xbf58476d1ce4e5b9);\n    value ^= value >> 27;\n    value *= UINT64_C(0x94d049bb133111eb);\n    value ^= value >> 31;\n    return value;\n}\n\nstatic uint64_t next_task_random(uint64_t *state)\n{\n    *state += UINT64_C(0x9e3779b97f4a7c15);\n    return mix_seed(*state);\n}\n\nstatic uint64_t child_seed(uint64_t state, int lo, int hi, uint64_t branch)\n{\n    uint64_t bounds = ((uint64_t)(uint32_t)lo << 32) | (uint64_t)(uint32_t)hi;\n    return mix_seed(state ^ bounds ^ branch);\n}\n\nstatic int partition_seeded(int *toorder, int lo, int hi, uint64_t *state)\n{\n    int length = hi - lo + 1;\n    int r = lo + (int)(next_task_random(state) % (uint64_t)length);\n    int pivot = toorder[r];\n    int b = lo;\n\n    swap(toorder, r, hi);\n    for (int i = lo; i < hi; i++) {\n        if (toorder[i] < pivot) {\n            swap(toorder, i, b);\n            b++;\n        }\n    }\n    swap(toorder, hi, b);\n    return b;\n}\n\nstatic void quicksort_serial_seeded(int *toorder, int lo, int hi, uint64_t seed)\n{\n    if (lo >= hi)\n        return;\n\n    int b = partition_seeded(toorder, lo, hi, &seed);\n    uint64_t left_seed = child_seed(seed, lo, b - 1, UINT64_C(0x243f6a8885a308d3));\n    uint64_t right_seed = child_seed(seed, b + 1, hi, UINT64_C(0x13198a2e03707344));\n    quicksort_serial_seeded(toorder, lo, b - 1, left_seed);\n    quicksort_serial_seeded(toorder, b + 1, hi, right_seed);\n}\n\nstatic void quicksort_parallel(int *toorder, int lo, int hi, uint64_t seed)\n{\n    if (lo >= hi)\n        return;\n\n    if (hi - lo + 1 <= TASK_SORT_CUTOFF) {\n        quicksort_serial_seeded(toorder, lo, hi, seed);\n        return;\n    }\n\n    int b = partition_seeded(toorder, lo, hi, &seed);\n    int left_size = b - lo;\n    int right_size = hi - b;\n    int left_hi = b - 1;\n    int right_lo = b + 1;\n    uint64_t left_seed = child_seed(seed, lo, left_hi, UINT64_C(0x243f6a8885a308d3));\n    uint64_t right_seed = child_seed(seed, right_lo, hi, UINT64_C(0x13198a2e03707344));\n\n    if (left_size >= right_size && left_size > TASK_SORT_CUTOFF) {\n        #pragma omp task firstprivate(toorder, lo, left_hi, left_seed)\n        quicksort_parallel(toorder, lo, left_hi, left_seed);\n        quicksort_parallel(toorder, right_lo, hi, right_seed);\n        #pragma omp taskwait\n    } else if (right_size > TASK_SORT_CUTOFF) {\n        #pragma omp task firstprivate(toorder, right_lo, hi, right_seed)\n        quicksort_parallel(toorder, right_lo, hi, right_seed);\n        quicksort_parallel(toorder, lo, left_hi, left_seed);\n        #pragma omp taskwait\n    } else {\n        quicksort_serial_seeded(toorder, lo, left_hi, left_seed);\n        quicksort_serial_seeded(toorder, right_lo, hi, right_seed);\n    }\n}\n\n/*\n * Swap two values.\n */\nvoid swap(int *toorder, int i, int j)\n{\n    int temp = toorder[i];\n    toorder[i] = toorder[j];\n    toorder[j] = temp;\n}\n\n/*\n * Partition decision\n */\nint partition(int *toorder, int lo, int hi)\n{\n    int b = lo;\n    int r = (int) (lo + (hi - lo) * (randnum() / MY_RAND_MAX));\n    int pivot = toorder[r];\n    swap(toorder, r, hi);\n    for (int i = lo; i < hi; i++) {\n        if (toorder[i] < pivot) {\n            swap(toorder, i, b);\n            b++;\n        }\n    }\n    swap(toorder, hi, b);\n    return b;\n}\n\n/*\n * Check if elements are in non-decreasing order\n */\nint is_sorted(int *toorder, int N)\n{\n    for (int i = 1; i < N; i++) {\n        if (toorder[i] < toorder[i - 1]) {\n            return 1;\n        }\n    }\n    return 0;\n}\n\n\n/*\n * Generate a case\n */\nint *generate_case(int N)\n{\n    int i;\n    int *ret = NULL;\n\n    // Make case generation reproducible\n    srandnum(0);\n\n    // Allocate memory\n    ret = (int *) malloc(N * sizeof(int));\n    if (ret == NULL) {\n        printf(\"Error: some malloc won't work.\\n\");\n        return NULL;\n    }\n    // Get pseudo-random positive integer values\n    for (i = 0; i < N; i++) {\n        ret[i] = drand(0, INT_MAX);\n    }\n    return ret;\n}\n\n/*\n * A pseudo-random number between two positive integer values\n */\ndouble drand(int xmin, int xmax)\n{\n    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;\n}\n",
      "path": "src/quicksort.c"
    }
  ],
  "hypothesis": "Recursive OpenMP tasks can use four cores for large arrays while an explicit serial cutoff limits task overhead. Independent per-task pivot RNG state avoids races in the existing global generator.",
  "notes": "Small arrays retain the existing serial path; large arrays use task-local pivot state. No commands or measurements were run.",

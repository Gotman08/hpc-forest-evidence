#include <cstdio>
#include <climits>
#include <vector>

class FastScanner {
    static const int BUFSIZE = 1 << 20;
    char buf[BUFSIZE];
    int idx, size;
    FILE* fp;
public:
    explicit FastScanner(FILE* f) : fp(f), idx(0), size(0) {}
    inline char getChar() {
        if (idx >= size) {
            size = static_cast<int>(fread(buf, 1, BUFSIZE, fp));
            idx = 0;
            if (size == 0) return 0;
        }
        return buf[idx++];
    }
    int nextInt() {
        char c;
        do { c = getChar(); } while (c < '0' || c > '9');
        int x = 0;
        do {
            x = x * 10 + (c - '0');
            c = getChar();
        } while (c >= '0' && c <= '9');
        return x;
    }
};

int main() {
    FastScanner fs(stdin);
    int n = fs.nextInt();
    int s = fs.nextInt();

    const int stride = n + 1;
    std::vector<long long> P(static_cast<size_t>(stride) * stride, 0);

    for (int i = 0; i < n; ++i) {
        const long long* prevRow = &P[static_cast<size_t>(i) * stride];
        long long* curRow = &P[static_cast<size_t>(i + 1) * stride];
        long long left = 0;
        for (int j = 0; j < n; ++j) {
            int val = fs.nextInt();
            curRow[j + 1] = static_cast<long long>(val) + prevRow[j + 1] + left - prevRow[j];
            left = curRow[j + 1];
        }
    }

    long long mxSum = LLONG_MIN;
    const int limit = n - s + 1;

#pragma omp parallel for reduction(max:mxSum)
    for (int i = 0; i < limit; ++i) {
        const long long* topRow = &P[static_cast<size_t>(i) * stride];
        const long long* bottomRow = &P[static_cast<size_t>(i + s) * stride];
        long long localMax = LLONG_MIN;
#pragma omp simd reduction(max:localMax)
        for (int j = 0; j < limit; ++j) {
            long long sum = bottomRow[j + s] - topRow[j + s] - bottomRow[j] + topRow[j];
            localMax = (sum > localMax) ? sum : localMax;
        }
        if (localMax > mxSum) mxSum = localMax;
    }

    printf("%d\n", static_cast<int>(mxSum));
    return 0;
}

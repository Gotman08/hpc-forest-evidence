"""Closed G derivative of the F exact-three owned-main closure gate.

No process capture, launch or stop occurs in this module. The main is for the
parent only, AFTER final proof pins are admitted. The delivered pins are all
NON_ADMIS. Historical launch identities are never fresh effect authorization.
"""
import argparse
import hashlib
import json
import re
import stat
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
BASE = HERE.parents[2]
REL = HERE.parent
LAUNCH = BASE / 'outputs/HPC-Forest-Primes-Natif-Lancement-r2g'
OPS = REL / 'operations-parent'
FACTORY = LAUNCH / 'revision-r1'
SCOPE = 'hpc-forest-primes-native-max-r2g'
SOURCE = 'f8c2104bad52e3c298de596fd365415fbdfbbb12fbdc41b47b06a94ad68273fe'
PLAN = '5af07859f99192e169f2475fb2c863c9d4a05a4a8dba07845b3fcc54451e7dba'
FIELDS = ('ProcessId', 'ParentProcessId', 'ExecutablePath', 'CommandLine', 'CreationDate')
CELLS = (
    ('astra', '753498', 'gpt-6-astra', '110cefccf16b439eb226e475c875c8df', 27596, 61176),
    ('terra', '753497', 'gpt-5.6-terra', '5d8811082a1842f5836a2bdda982500f', 50984, 45916),
    ('sol', '753499', 'gpt-6.1-sol', '13eaca4e39cf4147a3f677a32fb5a52d', 44728, 50420),
)
TARGET_IDS = [cell[4] for cell in CELLS]
PIN_SLOTS = ('terminal_receipt', 'reconciliation', 'independent_final_review',
             'named_snapshots', 'cache_preservation', 'frozen_evidence_inventory')
PINS = HERE / 'PINS-FINAUX-NON-ADMIS.json'
LAUNCH_RECEIPT = FACTORY / 'helper-lancement-possedes/lancement_reel_01/LANCEMENTS-POSSEDES-RECUS.json'
LAUNCH_SHA = '26e9c4cc5936f7e5a5a49b260f3310af9a2aeae1b003a38dcb59bf3347bb10e5'
INITIAL_SHA = '9a214c729add0a172244c2eb26ec8417f04d58c5c91c135a85b4007ad8a37a9a'
FIRST_STARTS = REL / 'DEMARRAGES-NORMAUX-ET-POURSUITES-VERIFIES.json'
FIRST_SHA = 'e9c5c4a9eb129018704478e5e365ab0ce142ff2adaf6ff5e493e87097d31a95e'
OAUTH = OPS / 'authentification-oauth-verifiee.json'
OAUTH_SHA = '39882d249ee59b1b248df9212900e345177b8fafe94eb1d45b8653707c1ba2d3'


def need(condition, message):
    if not condition:
        raise ValueError(message)


def sha(path):
    need(Path(path).name.rstrip(' .').casefold() != 'worker.lock', 'Lock contents are never read/hashed')
    with Path(path).open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def read(path):
    need(Path(path).name.rstrip(' .').casefold() != 'worker.lock', 'Lock contents are never read/interpreted')
    return json.loads(Path(path).read_text(encoding='utf-8-sig'))


def ref(path):
    return {'path': str(Path(path).resolve()), 'sha256': sha(path)}


def safe_path(path, root=BASE):
    path, root = Path(path).absolute(), Path(root).absolute()
    need(path.is_relative_to(root), 'Lexical proof/cache escape refused')
    need(path.resolve().is_relative_to(root.resolve()), 'Resolved proof/cache escape refused')
    for component in (root, *reversed(path.relative_to(root).parents), path):
        component = component if component.is_absolute() else root / component
        if component.exists():
            need(not component.is_symlink() and not
                 (component.lstat().st_file_attributes & stat.FILE_ATTRIBUTE_REPARSE_POINT),
                 'Symlink/junction/reparse point refused')
    return path


def artifact(value, root=BASE):
    need(isinstance(value, dict) and set(value) == {'path', 'sha256'}, 'Closed artifact reference required')
    need(isinstance(value['sha256'], str) and re.fullmatch('[0-9a-f]{64}', value['sha256']),
         'Concrete lowercase SHA256 required')
    path = safe_path(value['path'], root)
    need(path.is_file() and sha(path) == value['sha256'], 'Changed or missing frozen proof')
    return path


def pinned(path, expected):
    return read(artifact({'path': str(path), 'sha256': expected}))


def frozen_artifact(value):
    need(isinstance(value, dict) and isinstance(value.get('path'), str), 'Frozen reference required')
    path = Path(value['path']).absolute()
    need(not any(path.is_relative_to((LAUNCH / ('worker-' + c[3])).absolute()) for c in CELLS),
         'Frozen proof inventory must not point into a live worker cache')
    return artifact(value)


def admitted_pins(pins):
    """Pure check: delivered NON_ADMIS slots fail before any fresh census/cache read."""
    need(isinstance(pins, dict) and pins.get('schema') == 'hpc-forest-r2g-final-closure-pins-v1'
         and pins.get('scope_id') == SCOPE and set(pins.get('proofs', {})) == set(PIN_SLOTS),
         'Exact G final-proof slots required')
    for name in PIN_SLOTS:
        entry = pins['proofs'][name]
        need(isinstance(entry, dict) and set(entry) == {'status', 'path', 'sha256'}
             and entry['status'] == 'ADMIS' and isinstance(entry['path'], str) and entry['path']
             and isinstance(entry['sha256'], str) and re.fullmatch('[0-9a-f]{64}', entry['sha256']),
             'Final proof NON_ADMIS or unpinned: ' + name)
    need(pins.get('preparation_only') is False and pins.get('effect_admitted') is True,
         'Parent finalization/effect admission still false; preparation remains closed')
    return {name: {'path': pins['proofs'][name]['path'], 'sha256': pins['proofs'][name]['sha256']}
            for name in PIN_SLOTS}


def full_identity(row):
    need(isinstance(row, dict) and all(key in row for key in FIELDS), 'Incomplete process identity')
    need(type(row['ProcessId']) is int and row['ProcessId'] > 0
         and type(row['ParentProcessId']) is int and row['ParentProcessId'] >= 0, 'Untyped process identity')
    need(all(isinstance(row[k], str) and row[k] for k in FIELDS[2:]), 'Opaque process identity; preserve/refuse')
    need(re.fullmatch(r'\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{7}Z', row['CreationDate']) is not None,
         'Full seven-digit birth instant required')
    datetime.fromisoformat(row['CreationDate'])
    return row


def current_rows(fresh, now):
    need(fresh.get('complete_census') is True and type(fresh.get('rows_count')) is int
         and len(fresh['rows']) == fresh['rows_count'], 'Incomplete fresh process census')
    age = (now - datetime.fromisoformat(fresh['captured_at_utc'])).total_seconds()
    need(0 <= age <= 45, 'Current full process census stale/future')
    need(all(type(r.get('ProcessId')) is int and type(r.get('ParentProcessId')) is int for r in fresh['rows']),
         'Untyped current process graph')
    rows = {row['ProcessId']: row for row in fresh['rows']}
    need(len(rows) == len(fresh['rows']), 'Duplicate process IDs in full census')
    need(not any('hpc_forest.ablation_worker' in (r.get('CommandLine') or '') for r in rows.values()),
         'Source-only unexpectedly active; preserve/refuse')
    return rows


def check_descendants(rows, expected, allowed=()):
    """Foreign, opaque, SSH and CLI descendants all refuse; none is an effect target."""
    allowed = set(allowed)
    for row in rows.values():
        if row['ParentProcessId'] != expected['ProcessId'] or row['ProcessId'] == expected['ProcessId']:
            continue
        birth = row.get('CreationDate')
        if (isinstance(birth, str) and re.fullmatch(r'\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{7}Z', birth)
                and birth < expected['CreationDate']):
            continue  # An older birth cannot be a child of this newer identity.
        full_identity(row)
        need(row['CreationDate'] >= expected['CreationDate'], 'Ambiguous descendant birth ordering')
        need(row['ProcessId'] in allowed, 'Live/foreign descendant preserved; no main stop')


def opaque_inventory(cache, exclude_root_lock):
    """Hash opaque bytes only; never open the exact owned root worker.lock."""
    cache = safe_path(cache)
    need(cache.is_dir(), 'Cache root missing')
    result = {}
    for path in sorted(cache.rglob('*')):
        safe_path(path, cache)
        relative = path.relative_to(cache).as_posix()
        if exclude_root_lock and relative.rstrip(' .').casefold() == 'worker.lock':
            need(relative == 'worker.lock' and path.is_file() and path.stat().st_size == 1,
                 'Exact owned one-byte root lock metadata differs')
            continue
        if path.is_file():
            result[relative] = {'bytes': path.stat().st_size, 'sha256': sha(path)}
    return result


def final_contract(docs, proofs):
    """Pure required contract for final parent proofs; no final G counts invented."""
    receipt, recon, review = (docs[k] for k in PIN_SLOTS[:3])
    need(receipt.get('verified_metadata_only') is True and receipt.get('scope_id') == SCOPE
         and receipt.get('archive_triple_SHA_and_fresh_restore_verified') is True
         and receipt.get('all_delivered_call_raw_private_argv_and_policy_reconciled') is True
         and receipt.get('source110_exact_bytes_verified') is True
         and receipt.get('all_three_terminal_jobs_received') is True, 'Final G terminal/archive/private/source110 receipt required')
    need(recon.get('verified') is True and recon.get('scope_id') == SCOPE
         and recon.get('all_requests_reconciled') is True
         and recon.get('no_active_or_inflight_claims') is True
         and recon.get('first_starts_and_continuations_sha256') == FIRST_SHA
         and recon.get('global_scientific_or_performance_admission') is False,
         'Exhaustive G final reconciliation required')
    need(review.get('verified') is True and review.get('blocking_findings') == []
         and review.get('parent_audit_sha256') == proofs['terminal_receipt']['sha256']
         and review.get('parent_reconciliation_sha256') == proofs['reconciliation']['sha256']
         and review.get('native_research_admitted') is False, 'Independent final G metadata audit required')
    need(all(doc.get('source_zip_sha256') == SOURCE and doc.get('plan_sha256') == PLAN
             for doc in (receipt, recon, review)), 'Final G source/plan binding differs')
    need(isinstance(recon.get('cohorts'), list) and len(recon['cohorts']) == 3
         and {c.get('session_id') for c in recon['cohorts']} == {c[3] for c in CELLS}, 'Exact three final G cohorts required')
    for slug, job, model, session, pid, launcher in CELLS:
        cell = next(c for c in recon['cohorts'] if c['session_id'] == session)
        need(all(cell.get(k) == v for k, v in {'scope_id': SCOPE, 'job_id': job, 'model': model,
             'effort': 'max', 'source_zip_sha256': SOURCE, 'plan_sha256': PLAN}.items())
             and cell.get('terminal_state') == 'FAILED' and cell.get('exit_code') == '1:0'
             and cell.get('restored_before_after_equal') is True
             and cell.get('private_argv_and_policy_reconciled') is True
             and cell.get('all_requests_reconciled') is True and cell.get('no_active_or_inflight_claims') is True,
             'Selected terminal/private G cell differs')
        nonces = cell.get('reviewed_completed_nonces')
        need(isinstance(nonces, list) and nonces and len(set(nonces)) == len(nonces)
             and all(isinstance(n, str) and re.fullmatch('[0-9a-f]{32}', n) for n in nonces),
             'Explicit exhaustive reviewed G nonces required')
        need(type(cell.get('completed_claims_and_CLI_process_invocations')) is int
             and cell['completed_claims_and_CLI_process_invocations'] == len(nonces)
             and len(nonces) >= 2, 'Final completed-call/nonces count differs from preserved G starts')
    snapshots, preservation = docs['named_snapshots'], docs['cache_preservation']
    need(type(snapshots.get('count')) is int and snapshots.get('count') == len(snapshots.get('files', [])) > 0
         and snapshots.get('live_cache_enumerated') is False, 'Exact named completed-call snapshot boundary required')
    need(preservation.get('opaque_regular_cache_files_preserved_except_live_lock') is True
         and preservation.get('source_cache_unchanged') is True
         and len(preservation.get('workers', [])) == 3
         and {w.get('session_id') for w in preservation['workers']} == {c[3] for c in CELLS},
         'Whole readable G cache preservation required')
    evidence = docs['frozen_evidence_inventory'].get('files')
    need(isinstance(evidence, list) and evidence, 'Pinned final evidence inventory required')


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--fresh-cim', type=Path)
    parser.add_argument('--check-final-proofs-only', action='store_true')
    parser.add_argument('--plan-out', type=Path)
    args = parser.parse_args()
    need(bool(args.fresh_cim) != args.check_final_proofs_only,
         'Select exactly one: supplied fresh census or final-proof-only validation')
    need(not args.check_final_proofs_only or args.plan_out is None, 'Proof-only mode cannot emit a stop plan')
    proofs = admitted_pins(read(PINS))  # Must refuse delivered preparation before census/cache access.
    docs = {name: read(artifact(value, REL)) for name, value in proofs.items()}
    final_contract(docs, proofs)
    for item in docs['frozen_evidence_inventory']['files']:
        frozen_artifact(item)
    if args.check_final_proofs_only:
        print(json.dumps({'schema': 'hpc-forest-r2g-final-proof-contract-check-v1',
            'final_metadata_contract_verified': True, 'pins': ref(PINS),
            'process_observed': False, 'live_cache_read': False, 'effect_executed': False,
            'native_research_admitted': False}))
        return
    launch = pinned(LAUNCH_RECEIPT, LAUNCH_SHA)
    need(launch.get('verified') is True and len(launch.get('workers', [])) == 3, 'Historical exact-three G receipt required')
    initial_path = Path(launch['after_census'])
    initial = pinned(initial_path, INITIAL_SHA)
    need(initial.get('complete_census') is True and len(initial['rows']) == initial['rows_count'], 'Original complete G census required')
    old_rows = {r['ProcessId']: r for r in initial['rows']}
    need(len(old_rows) == len(initial['rows']), 'Duplicate original process graph')
    first = pinned(FIRST_STARTS, FIRST_SHA)
    need(first.get('verified_first_starts_and_continuations_only') is True and first.get('scope_id') == SCOPE
         and first.get('global_scientific_or_performance_or_hardware_isolation_admission') is False,
         'Preserved bounded G starts/continuations proof differs')
    oauth = pinned(OAUTH, OAUTH_SHA)
    need(oauth.get('verified') is True and oauth.get('auth_mode') == 'chatgpt'
         and all(oauth.get(k) is False for k in ('api_key_in_auth_present', 'OPENAI_API_KEY_environment_present',
                  'CODEX_API_KEY_environment_present', 'secrets_exported')), 'Frozen existing G OAuth proof differs')
    # Only now may parent-supplied fresh observation and opaque preservation be read.
    rows = current_rows(read(args.fresh_cim), datetime.now(UTC))
    targets = []
    for slug, job, model, session, pid, launcher in CELLS:
        cell = next(c for c in docs['reconciliation']['cohorts'] if c['session_id'] == session)
        identity = {'scope_id': SCOPE, 'job_id': job, 'model': model, 'effort': 'max', 'session_id': session,
                    'source_zip_sha256': SOURCE, 'plan_sha256': PLAN}
        original = next(w for w in launch['workers'] if w['session_id'] == session)
        need(original['job_id'] == job and original['model'] == model
             and {r['ProcessId'] for r in original['full_identities']} == {pid, launcher}, 'Original exact G pair differs')
        expected, old_launcher = full_identity(old_rows[pid]), full_identity(old_rows[launcher])
        need(expected == next(r for r in original['full_identities'] if r['ProcessId'] == pid)
             and old_launcher == next(r for r in original['full_identities'] if r['ProcessId'] == launcher)
             and expected['ParentProcessId'] == launcher and 'hpc_forest.r2max_worker' in expected['CommandLine']
             and session in expected['CommandLine']
             and expected['ExecutablePath'].replace('/', '\\').casefold().endswith('\\python.exe'),
             'Full original owned G main identity differs')
        for expected_row in (expected, old_launcher):
            if expected_row['ProcessId'] in rows:
                need(all(rows[expected_row['ProcessId']].get(k) == expected_row[k] for k in FIELDS),
                     'Main/parent PID reused or identity changed; preserve/refuse')
        check_descendants(rows, expected)
        check_descendants(rows, old_launcher, (pid,))
        auth = read(FACTORY / f'admissions-{slug}-max-reelles/authorization-remote.json')
        need(all(auth.get(k) == v for k, v in identity.items() if k not in {'source_zip_sha256', 'plan_sha256'}),
             'Original G admission differs')
        lane_path = FACTORY / f'admissions-{slug}-max-reelles/publication-locale/readback/worker_lane_admission.json'
        lane = pinned(lane_path, auth['artifacts']['worker_lane_admission']['sha256'])
        need(lane.get('verified') is True and lane.get('source_zip_sha256') == SOURCE and lane.get('plan_sha256') == PLAN
             and lane['lane_v2']['source_only_state'] == 'received_absent'
             and lane['lane_v2']['source_only_active_workers'] == 0, 'Source-only received absent0 admission differs')
        cache = LAUNCH / ('worker-' + session)
        pres = next(w for w in docs['cache_preservation']['workers'] if w['session_id'] == session)
        copy = OPS / 'preservation-caches-avant-arret' / slug / 'copie-opaque'
        need(pres.get('job_id') == job and pres.get('source_cache') == str(cache)
             and pres.get('opaque_copy') == str(copy) and pres.get('before_after_copy_equal') is True
             and pres.get('excluded_live_lock_paths') == ['worker.lock'] and pres.get('live_lock_content_read') is False,
             'Exact G opaque preservation differs')
        inventories = [read(artifact(item, OPS / 'preservation-caches-avant-arret')) for item in pres['evidence_refs']]
        need(len(inventories) == 2 and inventories[0] == inventories[1], 'Preservation inventories differ')
        before = inventories[0]
        need('worker.lock' not in before and len(before) == pres['regular_files_preserved']
             and sum(v['bytes'] for v in before.values()) == pres['bytes'], 'Preservation coverage differs')
        need(opaque_inventory(cache, True) == opaque_inventory(copy, False) == before, 'Cache/copy changed since preservation')
        lock = safe_path(cache / 'worker.lock', cache)
        need(lock.is_file() and lock.stat().st_size == 1, 'Owned root lock metadata differs')
        named = {}
        for item in docs['named_snapshots']['files']:
            source = Path(item['source'])
            if not source.is_relative_to(cache):
                continue
            relative = source.relative_to(cache).as_posix()
            artifact(item['received'], REL)
            need(item['source_sha256'] == item['received']['sha256'] and relative not in named,
                 'Duplicate/changed exact named metadata snapshot')
            named[relative] = {'sha256': item['source_sha256'], 'bytes': item['bytes']}
        need(named and all(before.get(k) == v for k, v in named.items()), 'Final named snapshots absent from full preservation')
        need({Path(k).parts[0] for k in before if '/' in k} == set(cell['reviewed_completed_nonces']),
             'Unreviewed/new/pending nonce in preserved cache')
        hold = read(copy / 'cli-technical-hold.json')
        need(hold.get('new_generations_allowed') is False, 'Durable completed technical hold missing')
        ready = read(copy / 'worker-ready.json')
        need(ready.get('pid') == pid and all(ready.get(k) == v for k, v in identity.items()), 'Preserved G ready identity differs')
        targets.append({'job_id': job, 'session_id': session, 'model': model, 'identity': expected,
            'launcher_identity_observation_only': old_launcher, 'present': pid in rows,
            'metadata_pre_stop': proofs['terminal_receipt'], 'bounded_terminal_receipt': proofs['reconciliation'],
            'cache_files_preserved_in_situ_and_copy': len(before), 'cache_preservation': proofs['cache_preservation']})
    result = {'schema': 'hpc-forest-r2g-terminal-owned-main-only-stop-plan-v1', 'verified': True,
        'scope': 'Exact-three main closure after all final/private audits and opaque preservation',
        'native_research_admitted': False, 'complete_cache_snapshot_received_including_lock': False,
        'first_starts_and_continuations': ref(FIRST_STARTS), 'final_proofs': proofs, 'pins': ref(PINS),
        'targets': targets, 'preserve_source_only': {'state': 'received_absent', 'active_workers': 0},
        'initial_full_cim': ref(initial_path), 'launch_receipt': ref(LAUNCH_RECEIPT),
        'fresh_full_cim': ref(args.fresh_cim), 'cache_preservation': proofs['cache_preservation'],
        'target_process_ids': TARGET_IDS, 'stop_only_owned_main_python': True,
        'stop_mcp_ssh_or_wrappers': False, 'recursive_stop': False, 'stop_by_name': False,
        'worker_lock_read': False, 'all_readable_cache_data_preserved': True}
    if args.plan_out:
        safe_path(args.plan_out, HERE)
        with args.plan_out.open('x', encoding='utf8') as stream:
            json.dump(result, stream, indent=2)
            stream.write('\n')
    print(json.dumps(result))


if __name__ == '__main__':
    main()

"""Version the local plan/bundle builder only; require real candidate pins before use."""
import hashlib
import re
from pathlib import Path

HERE = Path(__file__).resolve().parent
BASE = HERE.parents[2]
OLD = BASE / 'outputs/HPC-Forest-Primes-Natif-Relance-r2f/preparation-lancement/sceller-plan-et-paquet.py'
text = OLD.read_text('utf8')
# Current local builder is preserved; its candidate hash guard remains the input gate.
text = text.replace('R2f', 'R2g').replace('r2f', 'r2g')
text = re.sub(r'\b109\b', '110', text).replace('source109', 'source110').replace('exact109', 'exact110').replace('candidate109', 'candidate110')
text = text.replace("candidate.get('schema') == 'hpc-forest-r2g-source-candidate-for-independent-review-v1'", "candidate.get('schema') == 'hpc-forest-r2g-local-source-candidate-v1'")
text = text.replace("candidate.get('source_member_count') == 110", "candidate.get('source_members') == 110 and candidate.get('verified_local_source') is True")
text = text.replace("OLD = BASE / 'outputs/HPC-Forest-Primes-Natif-Relance-r2e'", "OLD = BASE / 'outputs/HPC-Forest-Primes-Natif-Relance-r2f'")
text = text.replace("OLD_PLAN_SHA = '4b430e181948e55e463dfd1e60bdce96308a9190534734feb22354e4116ebde9'", "OLD_PLAN_SHA = '8d91ebe83ab550ad50acc330f830e1bc86bcc67f66b88054538df6b394558450'")
text = text.replace("RESERVATION_SHA = '46c1d9bc8d8badef727ec7a47f96441f77321f041ec62c4cb8c5361997cfff73'", "RESERVATION_SHA = '82536a0cd82192caaa781c651f434a0cf31df8e5c76b6888d6a3ff65c6944901'")
text = text.replace('parent_r2e_source_zip_sha256', 'parent_r2f_source_zip_sha256').replace('parent_r2e_plan_sha256', 'parent_r2f_plan_sha256')
text = text.replace('historical_r2e_sessions_not_reused', 'historical_r2f_sessions_not_reused')
text = text.replace('prior_R2e_zero_model_reconciliation_required_before_native_submission=True,',
    'prior_R2f_terminal_reception_audit_reconciliation_and_owned_stop_required_before_native_submission=True,')
text = text.replace('inherited_worker_argparse_technical_failure_requires_new_source_qualification=True,',
    'distinct_host_infrastructure_contract_requires_new_source_qualification=True,')
anchor = '    for row in plan[\'projected_cells\']:'
if text.count(anchor) != 1:
    raise ValueError('Exact local plan update anchor required')
text = text.replace(anchor, '''    plan.update(code_mode_host_infrastructure_enabled=True,
        code_mode_host_executable_sha256='3b6a9179a4da17fa5fc6948219cd61486dc3b534c683838076d8c61bd311c68e',
        code_mode_and_code_mode_only_remain_false=True,
        exact_task_policy_requires_one_host_true_and_twenty_one_other_features_false=True,
        new_local_policy_schema='hpc-forest-r2g-local-cli-policy-v1',
        host_existence_or_Q_does_not_prove_no_tools_or_NORMAL_runtime=True,
        actual_first_MAX_normal_private_argv_no_tool_use_and_real_evaluation_required_before_extension=True,
        no_separate_diagnostic_model_inference=True)
    plan['private_CLI_policy'].update(schema='hpc-forest-r2g-local-cli-policy-v1',
        required_extra_fields=['cli_feature_overrides', 'code_mode_host_executable_sha256'],
        feature_override_count=22, only_true_feature='code_mode_host',
        policy_does_not_prove_actual_no_tools=True)
''' + anchor)
text = text.replace("OLD_PACKAGE / 'hpc-forest-primes-native-max-r2e-proposition.tar.gz'", "OLD_PACKAGE / 'hpc-forest-primes-native-max-r2f-proposition.tar.gz'")
compile(text, '<new-R2g-local-plan-builder>', 'exec')
target = HERE / 'sceller-plan-et-paquet.py'
with target.open('x', encoding='utf8', newline='\n') as stream:
    stream.write(text)
print(hashlib.sha256(target.read_bytes()).hexdigest())

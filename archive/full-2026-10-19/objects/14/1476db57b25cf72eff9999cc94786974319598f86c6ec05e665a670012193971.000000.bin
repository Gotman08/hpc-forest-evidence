"""Prepare pinned GGUF weights inside one owned, ephemeral compute-node cache."""
import concurrent.futures
import hashlib
import json
import os
import shutil
import time
import urllib.request
from pathlib import Path

from hpc_forest.core import atomic_json
from hpc_forest.ollama_backend import request_json, resolve_model


def checksum(path):
    h = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(16 * 1024 * 1024), b""):
            h.update(block)
    return h.hexdigest()


def download(spec, destination):
    """Use disjoint HTTP ranges; never keep weights in a persistent directory."""
    size, url = spec["bytes"], spec["url"]
    started = time.monotonic()
    with destination.open("xb") as stream:
        stream.truncate(size)
    parts = 4 if size > 1024**3 else 1

    def part(index):
        start, stop = size * index // parts, size * (index + 1) // parts - 1
        separator = "&" if "?" in url else "?"
        req = urllib.request.Request(
            url + separator + f"download=true&hpcforest_part={index}",
            headers={"Range": f"bytes={start}-{stop}", "User-Agent": "HPC-Forest"},
        )
        with urllib.request.urlopen(req, timeout=120) as response:
            content_range = response.headers.get("Content-Range", "")
            full_file = parts == 1 and response.status == 200 and response.headers.get("Content-Length") == str(size)
            if not full_file and (response.status != 206 or content_range != f"bytes {start}-{stop}/{size}"):
                raise RuntimeError(f"Server did not honor bounded range: {response.status}, {content_range}")
            with destination.open("r+b", buffering=0) as out:
                out.seek(start)
                count = 0
                while block := response.read(8 * 1024 * 1024):
                    if count + len(block) > stop - start + 1:
                        raise RuntimeError("Range overflow")
                    out.write(block)
                    count += len(block)
                if count != stop - start + 1:
                    raise RuntimeError("Truncated weight range")
        return {"start": start, "end": stop, "bytes": count}

    with concurrent.futures.ThreadPoolExecutor(max_workers=parts) as pool:
        receipts = list(pool.map(part, range(parts)))
    actual = checksum(destination)
    if actual != spec["sha256"] or destination.stat().st_size != size:
        raise RuntimeError("Downloaded weight identity mismatch")
    return {**spec, "verified_sha256": actual, "seconds": time.monotonic() - started, "ranges": receipts}


def prepare(spec_path, binary, url, cache, output, env):
    spec = json.loads(Path(spec_path).read_text(encoding="utf-8"))
    if cache.resolve().parent != Path("/dev/shm") or (cache / "OWNER").read_text() != os.environ["SLURM_JOB_ID"]:
        raise RuntimeError("An owned ephemeral cache is required")
    blobs = cache / "models/blobs"
    blobs.mkdir(parents=True, exist_ok=True)
    required = sum(s["bytes"] for s in spec["files"])
    available = shutil.disk_usage(cache).free
    atomic_json(output / "ephemeral-storage.json", {"required_bytes": required, "free_bytes": available, "duplicate_weight_copy": False})
    if available < required + 4 * 1024**3:
        raise RuntimeError(f"Insufficient ephemeral space: {available} bytes free; {required} required plus reserve")
    receipts = []
    for item in spec["files"]:
        name = item["name"]
        if Path(name).name != name or not name.endswith(".gguf"):
            raise RuntimeError("Invalid shard filename")
        print(json.dumps({"event": "weight_download_start", "file": name, "bytes": item["bytes"]}), flush=True)
        receipts.append(download(item, blobs / ("sha256-" + item["sha256"])))
        atomic_json(output / "weight-downloads.json", receipts)
        print(json.dumps({"event": "weight_verified", "file": name, "sha256": item["sha256"]}), flush=True)
    # The native split-GGUF API references verified content-addressed blobs.
    # It keeps every original shard and creates no second 155 GB weight copy.
    imported = request_json(url, "/api/create", {"model": spec["model"], "stream": False,
        "files": {s["name"]: "sha256:" + s["sha256"] for s in spec["files"]}}, 1200)
    atomic_json(output / "model-import.json", imported)
    if imported.get("status") != "success":
        raise RuntimeError("Local GGUF import did not report success")
    identity = resolve_model({"base_url": url, "model": spec["model"]})
    manifest_path = cache / "models/manifests/registry.ollama.ai/library" / spec["model"].replace(":", "/")
    if not manifest_path.is_file() or checksum(manifest_path) != identity["model_digest"]:
        raise RuntimeError("Installed model manifest does not match the resolved identity")
    installed = json.loads(manifest_path.read_text())
    atomic_json(output / "model-manifest.json", installed)
    atomic_json(output / "model-specification.json", spec)
    for layer in installed["layers"]:
        if layer["mediaType"] == "application/vnd.ollama.image.model":
            blob = cache / "models/blobs" / layer["digest"].replace(":", "-")
            if checksum(blob) != layer["digest"].removeprefix("sha256:"):
                raise RuntimeError("Imported model blob identity mismatch")
    atomic_json(output / "model-identity.json", identity)
    atomic_json(output / "model-show.json", request_json(url, "/api/show", {"model": spec["model"]}, 30))
    print(json.dumps({"event": "local_model_prepared", "model": spec["model"], "digest": identity["model_digest"]}), flush=True)
    return identity

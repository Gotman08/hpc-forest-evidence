"""Preserve the previous state and record the human-authorized distinct R2 attempt."""
from __future__ import annotations

import hashlib
import json
import shutil
from datetime import UTC, datetime
from pathlib import Path

BASE = Path(__file__).resolve().parents[4]
OUT = Path(__file__).resolve().parent


def ref(path: Path) -> dict:
    raw = path.read_bytes()
    return {"path": str(path), "sha256": hashlib.sha256(raw).hexdigest(), "bytes": len(raw)}


def save(name: str, value: dict) -> None:
    with (OUT / name).open("x", encoding="utf-8", newline="\n") as stream:
        json.dump(value, stream, ensure_ascii=False, indent=2)
        stream.write("\n")


def main() -> None:
    before = OUT / "avant-reprise"
    before.mkdir(exist_ok=False)
    preserved = []
    for relative in ["ID.md", "outputs/HPC-Forest-Harnais-Comparaison-r1/SUIVI-COMPACT.md"]:
        source = BASE / relative
        target = before / source.name
        shutil.copyfile(source, target)
        assert ref(source)["sha256"] == ref(target)["sha256"]
        preserved.append({"original": ref(source), "copy": ref(target)})
    prior = []
    for model, job in [("astra", "752139"), ("terra", "752140"), ("sol", "752141")]:
        folder = BASE / f"outputs/HPC-Forest-Primes-Natif-Lancement-r2b/reception-finale-{model}-{job}"
        terminal = folder / "RECEPTION-TERMINALE-BORNEE-R3.json"
        reconciliation = folder / "RECONCILIATION-METADONNEES-NEGATIF.json"
        facts = json.loads(reconciliation.read_text(encoding="utf-8"))
        assert facts["all_terminal_claim_delivery_metadata_reconciled"] is True
        assert facts["native_research_admitted"] is False
        prior.append({"model": facts["model"], "job_id": job,
                      "old_session_id": facts["session_id"],
                      "terminal_receipt": ref(terminal), "reconciliation": ref(reconciliation),
                      "native_invocations_already_started_and_delivered": facts["native_invocation_metadata_count"],
                      "old_nonce_replay_permitted": False})
    decision = {
        "schema": "hpc-forest-r2-human-distinct-relaunch-decision-v1",
        "recorded_at_utc": datetime.now(UTC).isoformat(),
        "human_request_verbatim": 'il faudrais le relancer alors "R2 est clos, avec un bilan partiel et des échecs techniques conservés."',
        "human_authorized_new_R2_attempt": True,
        "parent_interpretation": "A new distinct Astra/Terra/Sol MAX attempt, preserving completed Luna and every previous outcome.",
        "previous_attempts": prior,
        "confirmed_observation": "Three bounded generation timeouts, after delivered claims; no confirmed lower-level transport or algorithm defect.",
        "technical_change_scope": "New sessions/scope and honest closed source-only lane admission; algorithms, oracle and research budgets unchanged.",
        "maximum_native_workers": 4,
        "authentication": "existing local ChatGPT OAuth only; no API key, new login, transfer or billing",
        "first_start_required": "Each model: identity/MAX/allocation/transport, first delivered NORMAL call and first actual evaluation with errors retained before extension.",
        "Luna_relaunch_planned": False,
        "old_calls_or_candidates_replayed": False,
        "jobs_submitted": [], "native_model_calls": 0,
        "native_research_admitted": False,
        "deadline_exclusive_utc": "2026-10-31T23:00:00Z", "reception_audit_reserve_seconds": 10800,
        "preservation": preserved,
    }
    save("DECISION-HUMAINE-RELANCE-DISTINCTE.json", decision)
    print(json.dumps({"decision": ref(OUT / "DECISION-HUMAINE-RELANCE-DISTINCTE.json"), "preserved_files": len(preserved), "prior_invocations_preserved": sum(x["native_invocations_already_started_and_delivered"] for x in prior)}))


if __name__ == "__main__":
    main()

{
  "src/solution.cpp": "#include <algorithm>\n#include <cstddef>\n#include <cstdio>\n#include <vector>\n\nstatic const int MOD = 1000000007;\n\nclass FastInput {\n    unsigned char buffer[65536];\n    std::size_t position = 0;\n    std::size_t length = 0;\n\n    int get() {\n        if (position == length) {\n            length = std::fread(buffer, 1, sizeof(buffer), stdin);\n            position = 0;\n            if (length == 0) return EOF;\n        }\n        return buffer[position++];\n    }\n\npublic:\n    bool read(int& value) {\n        int ch;\n        do {\n            ch = get();\n            if (ch == EOF) return false;\n        } while (ch <= ' ');\n        int sign = 1;\n        if (ch == '-') {\n            sign = -1;\n            ch = get();\n        }\n        value = 0;\n        while (ch >= '0' && ch <= '9') {\n            value = value * 10 + ch - '0';\n            ch = get();\n        }\n        value *= sign;\n        return true;\n    }\n};\n\nstatic inline int add_mod(int a, int b) {\n    int sum = a + b;\n    return sum >= MOD ? sum - MOD : sum;\n}\n\nstatic void process_four_rows(std::vector<int>& dp,\n                              const std::vector<std::vector<int> >& obstacles,\n                              int first_row) {\n    const std::vector<int>& r0 = obstacles[first_row];\n    const std::vector<int>& r1 = obstacles[first_row + 1];\n    const std::vector<int>& r2 = obstacles[first_row + 2];\n    const std::vector<int>& r3 = obstacles[first_row + 3];\n    std::size_t p0 = 0, p1 = 0, p2 = 0, p3 = 0;\n    int left0 = 0, left1 = 0, left2 = 0, left3 = 0;\n    const int n = static_cast<int>(dp.size());\n    int x = 0;\n\n    while (x < n) {\n        int stop = n;\n        if (p0 < r0.size()) stop = std::min(stop, r0[p0]);\n        if (p1 < r1.size()) stop = std::min(stop, r1[p1]);\n        if (p2 < r2.size()) stop = std::min(stop, r2[p2]);\n        if (p3 < r3.size()) stop = std::min(stop, r3[p3]);\n\n        // Intermediate rows stay in registers; only the bottom row is stored.\n        for (; x < stop; ++x) {\n            left0 = add_mod(dp[x], left0);\n            left1 = add_mod(left0, left1);\n            left2 = add_mod(left1, left2);\n            left3 = add_mod(left2, left3);\n            dp[x] = left3;\n        }\n        if (x == n) break;\n\n        if (p0 < r0.size() && r0[p0] == x) {\n            left0 = 0;\n            ++p0;\n        } else {\n            left0 = add_mod(dp[x], left0);\n        }\n        if (p1 < r1.size() && r1[p1] == x) {\n            left1 = 0;\n            ++p1;\n        } else {\n            left1 = add_mod(left0, left1);\n        }\n        if (p2 < r2.size() && r2[p2] == x) {\n            left2 = 0;\n            ++p2;\n        } else {\n            left2 = add_mod(left1, left2);\n        }\n        if (p3 < r3.size() && r3[p3] == x) {\n            left3 = 0;\n            ++p3;\n        } else {\n            left3 = add_mod(left2, left3);\n        }\n        dp[x] = left3;\n        ++x;\n    }\n}\n\nstatic void process_one_row(std::vector<int>& dp,\n                            const std::vector<int>& obstacles) {\n    int left = 0;\n    int x = 0;\n    for (std::size_t p = 0; p < obstacles.size(); ++p) {\n        const int stop = obstacles[p];\n        for (; x < stop; ++x) {\n            left = add_mod(dp[x], left);\n            dp[x] = left;\n        }\n        dp[x] = 0;\n        left = 0;\n        ++x;\n    }\n    const int n = static_cast<int>(dp.size());\n    for (; x < n; ++x) {\n        left = add_mod(dp[x], left);\n        dp[x] = left;\n    }\n}\n\nint main() {\n    FastInput input;\n    int n, m;\n    if (!input.read(n) || !input.read(m)) return 0;\n\n    std::vector<std::vector<int> > obstacles(n);\n    for (int i = 0; i < m; ++i) {\n        int y, x;\n        input.read(y);\n        input.read(x);\n        obstacles[y].push_back(x);\n    }\n    for (int y = 0; y < n; ++y) {\n        std::vector<int>& row = obstacles[y];\n        std::sort(row.begin(), row.end());\n        row.erase(std::unique(row.begin(), row.end()), row.end());\n    }\n\n    std::vector<int> dp(n, 0);\n    dp[0] = 1;\n    int y = 0;\n    for (; y + 3 < n; y += 4) {\n        process_four_rows(dp, obstacles, y);\n    }\n    for (; y < n; ++y) {\n        process_one_row(dp, obstacles[y]);\n    }\n    std::printf(\"%d\\n\", dp[n - 1]);\n    return 0;\n}\n"
}

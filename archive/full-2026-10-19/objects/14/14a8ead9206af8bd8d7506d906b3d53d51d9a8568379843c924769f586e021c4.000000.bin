      "type": "text",
      "text": "{\n  \"ok\": true,\n  \"submitted\": false,\n  \"mode\": \"prepared\",\n  \"resolved\": {\n    \"partition\": \"short\",\n    \"arch\": \"armgpu\",\n    \"constraint\": \"armgpu\",\n    \"target_nodes\": \"romeo-a[001-058]\",\n    \"time\": \"03:00:00\",\n    \"total_cpus\": 4,\n    \"total_gpus\": 0,\n    \"workdir\": \"/scratch_p/nimarano\",\n    \"account\": \"r250127\",\n    \"distributed\": null,\n    \"container\": null,\n    \"redirect_caches\": false,\n    \"ntasks_per_node\": 1,\n    \"mem_gb\": 16,\n    \"reservation\": null,\n    \"gpus_per_task\": 0,\n    \"gpu_bind\": null,\n    \"cpu_bind\": \"cores\",\n    \"omp_places\": \"cores\",\n    \"omp_proc_bind\": \"close\",\n    \"mpi_environment\": null\n  },\n  \"warnings\": [\n    \"cible aarch64 : tout binaire ou paquet Python compile depuis le noeud de login (x86_64) echouera. Utilise compute_command_prepare.\"\n  ],\n  \"script\": \"#!/usr/bin/env bash\\n# Genere par romeo-mcp - ne pas editer a la main.\\n#SBATCH --job-name=forest-primes-astra-max-r2d\\n#SBATCH --account=r250127\\n#SBATCH --qos=normal\\n#SBATCH --partition=short\\n#SBATCH --constraint=armgpu\\n#SBATCH --time=03:00:00\\n#SBATCH --nodes=1\\n#SBATCH --ntasks-per-node=1\\n#SBATCH --cpus-per-task=4\\n#SBATCH --mem=16G\\n#SBATCH --chdir=/scratch_p/nimarano\\n#SBATCH --output=/scratch_p/nimarano/%x-%j.out\\n#SBATCH --error=/scratch_p/nimarano/%x-%j.err\\n\\nset -euo pipefail\\n\\n# Sans cette fonction, un job ROMEO 2025 n'a acces a aucun logiciel,\\n# pas meme a la commande spack. Elle est propre a l'architecture :\\n# charger celle de l'autre donnerait des binaires inutilisables.\\nromeo_load_armgpu_env\\n\\n# Provenance du premier demarrage : environnement, commit et fichiers choisis.\\nif command -v python3 >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then\\n  if timeout 20s python3 -I -S - '{\\\"roots\\\": [\\\"/scratch_p/nimarano\\\", \\\"/project\\\"], \\\"include_home\\\": true, \\\"code_dir\\\": \\\"/scratch_p/nimarano\\\", \\\"data_files\\\": [], \\\"max_bytes\\\": 67108864}' <<'ROMEO_REPRO_CAPTURE'\\n\\nimport hashlib, json, os, pathlib, re, stat, subprocess, sys\\nparams = json.loads(sys.argv[1])\\nroots = [pathlib.Path(p).resolve() for p in params['roots']]\\nif params.get('include_home'):\\n    roots.append(pathlib.Path.home().resolve())\\ndef allowed(value):\\n    path = pathlib.Path(value).resolve()\\n    if not any(path == root or root in path.parents for root in roots):\\n        raise ValueError('outside_roots')\\n    if any(p.lower().startswith(('.env', 'id_rsa', 'id_ed25519', 'id_ecdsa')) or p.lower() in ('.ssh', '.aws', '.azure', '.kube', 'hosts.yml')\\n           or p.lower().endswith(('.pem', '.key', '.p12', '.pfx'))\\n           or re.search(r'password|passwd|passphrase|secret|token|credential|authorization|cookie|api[_-]?key|access[_-]?key|private[_-]?key', p, re.I)\\n           for p in path.parts):\\n        raise ValueError('sensitive_path')\\n    return path\\nout = {'git': {'status': 'unavailable'}, 'data': []}\\ntry:\\n    code = allowed(params['code_dir'])\\n    result = subprocess.run(['git', '-c', 'core.fsmonitor=false', '-C', str(code),\\n                             'rev-parse', '--verify', 'HEAD'],\\n                            capture_output=True, text=True, timeout=5,\\n                            env={**os.environ, 'GIT_OPTIONAL_LOCKS': '0'})\\n    sha = result.stdout.strip()\\n    if result.returncode == 0 and len(sha) in (40, 64) and all(c in '0123456789abcdef' for c in sha):\\n        out['git'] = {'status': 'observed', 'commit': sha, 'working_tree_verified': False}\\nexcept (OSError, ValueError, subprocess.TimeoutExpired):\\n    pass\\nremaining = params['max_bytes']\\nfor name in params['data_files']:\\n    item = {'path': name}\\n    try:\\n        path = allowed(name)\\n        info = path.stat()\\n        if not stat.S_ISREG(info.st_mode):\\n            item['status'] = 'not_regular_file'\\n        elif info.st_size > remaining:\\n            item.update(status='size_limit', bytes=info.st_size)\\n        else:\\n            h = hashlib.sha256()\\n            consumed = 0\\n            with path.open('rb') as stream:\\n                while True:\\n                    block = stream.read(min(1048576, remaining - consumed + 1))\\n                    if not block:\\n                        break\\n                    consumed += len(block)\\n                    if consumed > remaining:\\n                        break\\n                    h.update(block)\\n            after = path.stat()\\n            remaining = max(0, remaining - consumed)\\n            if consumed != info.st_size or (info.st_size, info.st_mtime_ns, info.st_ino) != (after.st_size, after.st_mtime_ns, after.st_ino):\\n                item['status'] = 'changed_during_read'\\n            else:\\n                item.update(status='hashed', sha256=h.hexdigest(), bytes=consumed)\\n    except (OSError, ValueError):\\n        item['status'] = 'unreadable_or_outside_roots'\\n    out['data'].append(item)\\n\\n\\nimport datetime, platform\\nout['observed_at'] = datetime.datetime.now(datetime.timezone.utc).isoformat()\\nout['phase'] = 'before_workload'\\nout['environment'] = {\\n    'source': 'compute_node_before_command', 'architecture': platform.machine(),\\n    'python_version': platform.python_version(),\\n    'loaded_modules': [v for v in os.environ.get('LOADEDMODULES', '').split(':') if v][:128],\\n    'spack_loaded_hashes': [v for v in os.environ.get('SPACK_LOADED_HASHES', '').split(':') if v][:128],\\n}\\njid = os.environ.get('SLURM_JOB_ID', '')\\nif os.environ.get('SLURM_ARRAY_JOB_ID') and os.environ.get('SLURM_ARRAY_TASK_ID'):\\n    jid = os.environ['SLURM_ARRAY_JOB_ID'] + '_' + os.environ['SLURM_ARRAY_TASK_ID']\\nif not re.fullmatch(r'[0-9]+(?:_[0-9]+)?', jid):\\n    raise ValueError('missing_job_id')\\nout['job_id'] = jid\\nfolder = pathlib.Path('.romeo-provenance')\\nfolder.mkdir(mode=0o700, exist_ok=True)\\nif folder.is_symlink():\\n    raise ValueError('symlink_capture_directory')\\nout['restart_count'] = os.environ.get('SLURM_RESTART_COUNT', '0')\\ntry:\\n    fd = os.open(folder / (jid + '.json'), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)\\nexcept FileExistsError:\\n    pass\\nelse:\\n    with os.fdopen(fd, 'w') as stream:\\n        json.dump(out, stream)\\n        stream.write('\\\\n')\\nROMEO_REPRO_CAPTURE\\n  then :; else\\n    printf '%s\\\\n' '[romeo-mcp] provenance indisponible ; le calcul continue.' >&2\\n  fi\\nfi\\n\\n\\n# Trace d'execution : sert a diagnostiquer les erreurs d'architecture.\\necho \\\"[romeo-mcp] noeud=$(hostname) arch=$(uname -m) job=${SLURM_JOB_ID:-?}\\\"\\necho \\\"[romeo-mcp] debut $(date -Is)\\\"\\n\\nset -euo pipefail\\n[[ ${SLURM_JOB_ID:-} =~ ^[0-9]+$ ]] || exit 70\\n[[ ${SLURM_JOB_NUM_NODES:-} == 1 && ${SLURM_NTASKS:-} == 1 && ${SLURM_CPUS_PER_TASK:-} == 4 && ${SLURM_MEM_PER_NODE:-} == 16384 ]] || exit 71\\n[[ ${SLURM_RESTART_COUNT:-0} == 0 ]] || exit 72\\nexport PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=4\\nsrun --nodes=1 --ntasks=1 --cpus-per-task=4 --mem=16G --cpu-bind=cores --time=03:00:00 /scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python -I -B -u - <<'ONE_SELECTED_MAX_CELL_PREFLIGHT'\\n\\\"\\\"\\\"Future allocated entry: exactly one selected MAX cell; never a model loop.\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport hashlib\\nimport json\\nimport os\\nimport platform\\nimport re\\nimport shlex\\nimport sys\\nimport zipfile\\nfrom datetime import UTC, datetime, timedelta\\nfrom pathlib import Path\\n\\nCELL = {'scope_id': 'hpc-forest-primes-native-max-r2d', 'model': 'gpt-6-astra', 'effort': 'max', 'session_id': '26d58fc2d88f423d9b5fd241ade3d185', 'source_sha256': '13ccaf7c74d13db246d1127a25c511bc03d7989ba9097eb6ad7b4f681c0a0a46', 'plan_sha256': '5e052db689fc423720be60dab97fbca70c82b64487d02d3d8fe2d0f796d9c96c', 'runtime_sha256': 'e22f1852be37ae853fc144a9463013f7664cd4ece0e95f95e3e9349053eceee4', 'source_members': 105, 'remote_extraction': '/scratch_p/nimarano/hpc-forest-primes-native-contract-qualification-20261018-r2d-afef88fa43a3/extraction', 'remote_root': '/scratch_p/nimarano/hpc-forest-primes-native-max-r2d-26d58fc2d88f423d9b5fd241ade3d185', 'admission_root': '/scratch_p/nimarano/hpc-forest-primes-native-max-r2d-admission-attempt2-26d58fc2d88f423d9b5fd241ade3d185', 'source_zip_name': 'HPC-Forest-Primes-Natif-MAX-r2d.zip', 'cells': {'gpt-6-astra': '26d58fc2d88f423d9b5fd241ade3d185', 'gpt-5.6-terra': 'fee3bd8ba5fc4e6eafa1167ef279f9fa', 'gpt-6.1-sol': '182500fef7c546af87f14498de353581'}, 'maximum_native_workers': 4}  # noqa: F821 - replaced as one literal, never imported locally\\nPYTHON = '/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python'\\nSPACK_GCC = '/zrtbeqke25s2vbqo4yrhsowjz7mg3pjf'\\nDEADLINE = datetime(2026, 10, 31, 23, tzinfo=UTC)\\n\\n\\ndef require(ok, message):\\n    if not ok:\\n        raise RuntimeError(message)\\n\\n\\ndef sha(path):\\n    return hashlib.sha256(path.read_bytes()).hexdigest()\\n\\n\\nenv = os.environ\\nrequire(platform.system() == 'Linux' and platform.machine().lower() in {'aarch64', 'arm64'}, 'Own Linux ARM64 allocation required')\\nrequire(re.fullmatch('[0-9]+', env.get('SLURM_JOB_ID', '')), 'Actual Slurm job required')\\nrequired = {'SLURM_JOB_NUM_NODES': '1', 'SLURM_NTASKS': '1', 'SLURM_CPUS_PER_TASK': '4', 'SLURM_MEM_PER_NODE': '16384'}\\nrequire(all(env.get(k) == v for k, v in required.items()), 'Exact1node/1task/4CPU/16Gi allocation required')\\nrequire(env.get('SLURM_RESTART_COUNT', '0') == '0', 'Never replay a native attempt')\\nrequire(all(env.get(k, '') in {'', '0'} for k in ('SLURM_GPUS', 'SLURM_GPUS_PER_NODE', 'SLURM_JOB_GPUS', 'SLURM_STEP_GPUS', 'CUDA_VISIBLE_DEVICES')), 'Zero GPU required')\\nrequire(hasattr(os, 'sched_getaffinity') and len(os.sched_getaffinity(0)) == 4, 'Exactly four effective CPUs required')\\nrequire(datetime.now(UTC) + timedelta(seconds=21600) < DEADLINE, 'Exclusive deadline reserve insufficient')\\nrequire(Path(sys.executable).resolve() == Path(PYTHON).resolve(), 'Exact existing ARM64 Python required')\\nroot, admission = Path(CELL['remote_root']), Path(CELL['admission_root'])\\nrequire(not root.exists() and not root.is_symlink(), 'Fresh selected native root required')\\nrequire(not admission.exists() and not admission.is_symlink(), 'Fresh selected admission root required')\\nextraction = Path(CELL['remote_extraction'])\\nsource_zip = extraction / CELL['source_zip_name']\\nplan_path, runtime = extraction / 'native-max-plan.json', extraction / 'runtime-manifest-r2max.json'\\nfor path, expected in ((source_zip, CELL['source_sha256']), (plan_path, CELL['plan_sha256']), (runtime, CELL['runtime_sha256'])):\\n    require(path.is_file() and not path.is_symlink() and sha(path) == expected, 'Changed qualified source/plan/runtime')\\nproject = extraction / 'HPC-Forest'\\nexpected = json.loads(runtime.read_bytes())\\nactual = {p.relative_to(project).as_posix(): p for p in project.rglob('*') if p.is_file()\\n          and not any(x in {'__pycache__', '.pytest_cache', '.ruff_cache'} for x in p.relative_to(project).parts)}\\nrequire(len(expected) == CELL['source_members'] and set(actual) == set(expected)\\n        and all(not p.is_symlink() and sha(p) == expected[n] for n, p in actual.items()), 'Exact new qualified runtime required')\\nwith zipfile.ZipFile(source_zip) as archive:\\n    names = archive.namelist()\\n    require(len(names) == len(set(names)) == CELL['source_members'], 'Exact source ZIP membership required')\\n    require(all(n.startswith('HPC-Forest/') and n.removeprefix('HPC-Forest/') in actual\\n                and archive.read(n) == actual[n.removeprefix('HPC-Forest/')].read_bytes() for n in names), 'Source ZIP/runtime divergence')\\nplan = json.loads(plan_path.read_bytes())\\nrequire(plan.get('scope_id') == CELL['scope_id'] and plan.get('source_zip_sha256') == CELL['source_sha256']\\n        and plan.get('cells') == CELL['cells'] and plan.get('maximum_native_workers_total') == 4\\n        and plan.get('maximum_cells_per_authorization') == 1 and plan.get('efforts') == ['max']\\n        and plan.get('automatic_extension') is False and CELL['model'] in CELL['cells']\\n        and CELL['session_id'] == CELL['cells'][CELL['model']], 'Actual cap4 plan and selected closed MAX identity required')\\nsys.path.insert(0, str(project / 'src'))\\nfrom hpc_forest.native_r2max import allocation_guard, verify_runtime\\n\\nallocation = allocation_guard()\\nverify_runtime(source_zip)\\nrequire(not root.exists() and not root.is_symlink(), 'Native root must remain absent before wait')\\nrequire(admission.parent == Path('/scratch_p/nimarano') and admission.name == CELL['scope_id'] + '-admission-attempt2-' + CELL['session_id'], 'Exact selected admission directory required')\\nadmission.mkdir(mode=0o700, exist_ok=False)\\nmarker = {'schema': 'hpc-forest-max-cell-allocation-ready-v1', 'verified': True,\\n          'scope_id': CELL['scope_id'], 'model': CELL['model'], 'effort': 'max', 'session_id': CELL['session_id'],\\n          'job_id': allocation['job_id'], 'source_zip_sha256': CELL['source_sha256'], 'plan_sha256': CELL['plan_sha256'],\\n          'allocation': allocation, 'native_root': str(root), 'admission_root': str(admission),\\n          'native_root_absent_before_wait': True, 'native_model_calls': 0, 'source_files_verified': CELL['source_members'],\\n          'maximum_native_workers': 4, 'authorization_still_required': True, 'utc': datetime.now(UTC).isoformat()}\\nwith (admission / 'allocation-ready.json').open('x', encoding='utf8') as stream:\\n    json.dump(marker, stream, sort_keys=True)\\n    stream.flush()\\n    os.fsync(stream.fileno())\\nprint(json.dumps(marker), flush=True)\\nwait_argv = [PYTHON, '-I', '-B', '-u', str(project / 'examples/marathon22/wait_r2max_authorization.py'),\\n    '--root', str(root), '--authorization', str(admission / 'authorization.json'),\\n    '--authorization-ready', str(admission / 'authorization-ready.json'), '--wait-seconds', '600']\\ncommand = 'set -euo pipefail\\\\nromeo_load_armgpu_env\\\\nspack load ' + shlex.quote(SPACK_GCC) + '\\\\nexec ' + shlex.join(wait_argv)\\nchild = {**env, 'PYTHONDONTWRITEBYTECODE': '1', 'PYTHONUNBUFFERED': '1', 'OPENBLAS_NUM_THREADS': '1',\\n         'MKL_NUM_THREADS': '1', 'NUMEXPR_NUM_THREADS': '1', 'OMP_NUM_THREADS': '4', 'OMP_DYNAMIC': 'FALSE',\\n         'OMP_PROC_BIND': 'close', 'OMP_PLACES': 'cores', 'CUDA_VISIBLE_DEVICES': ''}\\nos.execvpe('/bin/bash', ['/bin/bash', '-lc', command], child)\\nONE_SELECTED_MAX_CELL_PREFLIGHT\\n\\necho \\\"[romeo-mcp] fin $(date -Is)\\\"\\n\",\n  \"runtime_artifacts\": [],\n  \"submittable\": true,\n  \"plan_id\": \"702a79de8bd54dd9a6c22597af2591aa\",\n  \"plan_sha256\": \"7ae23d98b4146ca2bbb9c453d999f137def8880adef2708f8652dc8d755b2b7d\",\n  \"expires_at\": 1792399896.0910735,\n  \"storage\": \"C:\\\\Users\\\\nicol\\\\.romeo-mcp\\\\jobs.db\",\n  \"next_step\": \"Relis les scripts et avertissements, puis appelle job_submit avec ce plan_id et confirm=true.\"\n}"
    }

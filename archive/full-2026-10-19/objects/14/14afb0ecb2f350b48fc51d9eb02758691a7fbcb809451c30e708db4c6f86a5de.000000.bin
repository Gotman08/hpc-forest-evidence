#include "knn.h"
#include <immintrin.h>

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    char * labels = (char *) malloc(sizeof(char) * k);
    float * distances = (float *) malloc(sizeof(float) * k);

    int i, j, x, y;

    for (i = 0; i < k; i++) {
        labels[i] = -1;
        distances[i] = -1;
    }

    for (i = 0; i < n_groups; i++) {
        Group g = groups[i];

        int j4 = g.length / 4 * 4;
        __m128 to_evaluate_x = _mm_set1_ps(to_evaluate.x);
        __m128 to_evaluate_y = _mm_set1_ps(to_evaluate.y);

        for (j = 0; j < j4; j += 4) {
            __m128 g_points_x = _mm_loadu_ps(&g.points[j].x);
            __m128 g_points_y = _mm_loadu_ps(&g.points[j].y);

            __m128 dx = _mm_sub_ps(g_points_x, to_evaluate_x);
            __m128 dy = _mm_sub_ps(g_points_y, to_evaluate_y);

            __m128 dx2 = _mm_mul_ps(dx, dx);
            __m128 dy2 = _mm_mul_ps(dy, dy);

            __m128 dist2 = _mm_add_ps(dx2, dy2);

            float distances_arr[4];
            _mm_storeu_ps(distances_arr, dist2);

            for (int l = 0; l < 4; l++) {
                float d = distances_arr[l];
                for (x = 0; x < k; x++) {
                    if (d < distances[x] || distances[x] == -1) {
                        for (y = k - 1; y > x; y--) {
                            distances[y] = distances[y - 1];
                            labels[y] = labels[y - 1];
                        }

                        distances[x] = d;
                        labels[x] = g.label;

                        break;
                    }
                }
            }
        }

        for (; j < g.length; j++) {
            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);

            for (x = 0; x < k; x++) {
                if (d < distances[x] || distances[x] == -1) {
                    for (y = k - 1; y > x; y--) {
                        distances[y] = distances[y - 1];
                        labels[y] = labels[y - 1];
                    }

                    distances[x] = d;
                    labels[x] = g.label;

                    break;
                }
            }
        }
    }

    qsort(labels, k, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }

            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    free(labels);
    free(distances);

    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

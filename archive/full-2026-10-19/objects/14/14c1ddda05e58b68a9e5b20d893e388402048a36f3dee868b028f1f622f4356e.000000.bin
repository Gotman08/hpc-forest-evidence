        "content": "#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n#include<stdint.h>\n\n/* Maximum size (in char) for neighbors and compute lists */\n#define MAX 100\n\ntypedef struct {\n  int id;\n  float value;\n  char neighbors[MAX];\n} Node;\n\ntypedef struct {\n  int id;\n  int node_plus_one;\n} IdEntry;\n\ntypedef struct {\n  IdEntry *entries;\n  size_t mask;\n} IdIndex;\n\n/* Reads input, allocates memory, writes graph size and node list. Returns the graph. */\nNode* read_input(char* fname, int *n, char* list) {\n  \n  Node* data = NULL;\n  FILE *fl = NULL;\n  \n  if (fname == NULL) \n    fl = stdin;\n  else \n    fl = fopen(fname, \"r\");\n  \n  if (fl == NULL) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n  \n  // header \n  fscanf(fl, \"%d %[^\\n]\", n, list);\n  \n  if (*n > 1) {\n    data = (Node*) malloc ((*n)*sizeof(Node));\n    if(data == NULL){\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }    \n  }\n  \n  for(int i = 0; i < *n; i++)\n    fscanf(fl, \"%d %f %[^\\n]\", &data[i].id, &data[i].value, data[i].neighbors);\n  \n  fclose(fl);\n\n  return data;\n  \n}\n\n/* Returns the index of the node with the given id or -1 if not found */\nint find_by_id(Node g[], int id, int size){\n\n  int i = 0;\n\n  while((i < size) && g[i].id != id)\n    i++;\n\n  if(i < size)\n    return i;\n\n  return -1;\n\n}\n\nstatic uint32_t hash_id(int id) {\n  uint32_t x = (uint32_t)id;\n  x ^= x >> 16;\n  x *= UINT32_C(0x7feb352d);\n  x ^= x >> 15;\n  x *= UINT32_C(0x846ca68b);\n  x ^= x >> 16;\n  return x;\n}\n\n/* Keep lookup keys together instead of scanning full Node records. */\nstatic IdIndex build_id_index(const Node *g, int size) {\n  IdIndex index = {NULL, 0};\n  size_t capacity = 1;\n  size_t target;\n\n  /* Small inputs avoid index construction; allocation failure also falls back. */\n  if (size <= 16)\n    return index;\n  if ((size_t)size > SIZE_MAX / 2)\n    return index;\n\n  target = (size_t)size * 2;\n  while (capacity < target) {\n    if (capacity > SIZE_MAX / 2)\n      return index;\n    capacity *= 2;\n  }\n  if (capacity > SIZE_MAX / sizeof(IdEntry))\n    return index;\n\n  index.entries = (IdEntry*)calloc(capacity, sizeof(IdEntry));\n  if (index.entries == NULL)\n    return index;\n  index.mask = capacity - 1;\n\n  for (int i = 0; i < size; ++i) {\n    int id = g[i].id;\n    size_t pos = (size_t)hash_id(id) & index.mask;\n    while (index.entries[pos].node_plus_one != 0 &&\n           index.entries[pos].id != id)\n      pos = (pos + 1) & index.mask;\n\n    /* Duplicate IDs retain the first record, as in the linear search. */\n    if (index.entries[pos].node_plus_one == 0) {\n      index.entries[pos].id = id;\n      index.entries[pos].node_plus_one = i + 1;\n    }\n  }\n\n  return index;\n}\n\nstatic int find_by_id_indexed(Node g[], int id, int size,\n                              const IdIndex *index) {\n  if (index->entries == NULL)\n    return find_by_id(g, id, size);\n\n  const IdEntry *entries = index->entries;\n  size_t pos = (size_t)hash_id(id) & index->mask;\n  while (entries[pos].node_plus_one != 0) {\n    if (entries[pos].id == id)\n      return entries[pos].node_plus_one - 1;\n    pos = (pos + 1) & index->mask;\n  }\n  return -1;\n}\n\n/* Computes the sum using an index owned by the current evaluation. */\nstatic float get_costly_indexed(Node *g, int id, int size,\n                                const IdIndex *index) {\n\n  char *t;\n  int idmax = -1;\n  float max = 0;\n  char *auxptr;\n  \n  int nd = find_by_id_indexed(g, id, size, index);\n  if(nd < 0)\n    return max;\n\n  char aux[MAX];\n  strcpy(aux, g[nd].neighbors);\n  t = strtok_r(aux, \" \", &auxptr);\n\n  do {\n    int d = find_by_id_indexed(g, atoi(t), size, index);\n    if (d >= 0 && max < g[d].value) {\n      max = g[d].value;\n      idmax = atoi(t);\n    }    \n  } while ((t = strtok_r(NULL, \" \", &auxptr)));\n\n  float r = g[nd].value;\n\n  if(idmax != -1)\n    r += get_costly_indexed(g, idmax, size, index);\n  \n  return (r);\n\n}\n\n/* Preserve the standalone entry point without persistent cached state. */\nfloat get_costly(Node *g, int id, int size) {\n  IdIndex index = build_id_index(g, size);\n  float result = get_costly_indexed(g, id, size, &index);\n  free(index.entries);\n  return result;\n}\n\n/* Main program - calls read input, computes sum for each node in the list, prints output */\nint main() {\n  char *fileN = NULL;\n  char computelist[MAX];\n  int n = -1;\n  Node* input = NULL;\n\n  input = read_input(fileN, &n, computelist);\n  IdIndex index = build_id_index(input, n);\n  \n  // process\n  for(char *c = strtok(computelist, \" \"); c != NULL; c = strtok(NULL, \" \"))\n    printf(\"%s: %f\\n\", c, get_costly_indexed(input, atoi(c), n, &index));\n  \n  free(index.entries);\n  free(input);\n\n  return 0;\n}\n",
        "path": "src/graph.c"
      }

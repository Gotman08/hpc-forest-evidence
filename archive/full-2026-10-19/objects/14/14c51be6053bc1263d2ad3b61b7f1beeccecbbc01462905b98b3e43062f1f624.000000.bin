      "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\nnamespace {\nusing Residue = std::uint32_t;\nusing Wide = std::uint64_t;\nconstexpr Wide MOD = 1000000007ULL;\n\n// Coefficients are stored in ascending degree:\n// x^n = coefficients[0] + ... + coefficients[n-1] * x^(n-1).\nvoid square_mod(std::vector<Residue>& polynomial, int& length,\n                const std::vector<Residue>& coefficients,\n                std::vector<Residue>& scratch) {\n    const int n = static_cast<int>(coefficients.size());\n    const int width = 2 * length - 1;\n    std::fill(scratch.begin(), scratch.begin() + width, Residue(0));\n\n    // Symmetric convolution, with contiguous reads and destination updates.\n    for (int i = 0; i < length; ++i) {\n        const Wide value = polynomial[i];\n        if (value == 0) {\n            continue;\n        }\n        scratch[2 * i] = static_cast<Residue>(\n            (scratch[2 * i] + value * value) % MOD);\n        const Wide twice = value + value;\n        Residue* const row = scratch.data() + i;\n        for (int j = i + 1; j < length; ++j) {\n            row[j] = static_cast<Residue>(\n                (row[j] + twice * polynomial[j]) % MOD);\n        }\n    }\n\n    // Descending elimination only updates coefficients of lower degree.\n    for (int degree = width - 1; degree >= n; --degree) {\n        const Wide factor = scratch[degree];\n        if (factor == 0) {\n            continue;\n        }\n        Residue* const row = scratch.data() + degree - n;\n        for (int j = 0; j < n; ++j) {\n            row[j] = static_cast<Residue>(\n                (row[j] + factor * coefficients[j]) % MOD);\n        }\n    }\n\n    length = std::min(n, width);\n    std::copy_n(scratch.begin(), length, polynomial.begin());\n}\n\nvoid multiply_by_x(std::vector<Residue>& polynomial, int& length,\n                   const std::vector<Residue>& coefficients) {\n    const int n = static_cast<int>(coefficients.size());\n    if (length < n) {\n        for (int i = length; i > 0; --i) {\n            polynomial[i] = polynomial[i - 1];\n        }\n        polynomial[0] = 0;\n        ++length;\n        return;\n    }\n\n    const Wide top = polynomial[n - 1];\n    for (int i = n - 1; i > 0; --i) {\n        polynomial[i] = static_cast<Residue>(\n            (polynomial[i - 1] + top * coefficients[i]) % MOD);\n    }\n    polynomial[0] = static_cast<Residue>(top * coefficients[0] % MOD);\n}\n\n// Estimate modular products using the same active-length bounds as the solver.\nWide polynomial_work(int n, Wide exponent, int bits) {\n    Wide work = 0;\n    int length = 1;\n    for (int bit = bits - 1; bit >= 0; --bit) {\n        work += static_cast<Wide>(length) * (length + 1) / 2;\n        const int width = 2 * length - 1;\n        if (width > n) {\n            work += static_cast<Wide>(width - n) * n;\n        }\n        length = std::min(n, width);\n        if ((exponent >> bit) & 1ULL) {\n            if (length == n) {\n                work += n;\n            } else {\n                ++length;\n            }\n        }\n    }\n    return work + length;\n}\n\nResidue direct_term(const std::vector<Residue>& initial,\n                    const std::vector<Residue>& coefficients, Wide steps) {\n    std::vector<Residue> history(initial);\n    const int n = static_cast<int>(history.size());\n    int oldest = 0;\n    Residue result = history[n - 1];\n\n    for (Wide step = 0; step < steps; ++step) {\n        Wide sum = 0;\n        const int tail = n - oldest;\n        // Traverse the chronological window as two contiguous spans.\n        for (int j = 0; j < tail; ++j) {\n            sum = (sum + static_cast<Wide>(history[oldest + j]) *\n                         coefficients[j]) % MOD;\n        }\n        for (int j = 0; j < oldest; ++j) {\n            sum = (sum + static_cast<Wide>(history[j]) *\n                         coefficients[tail + j]) % MOD;\n        }\n        result = static_cast<Residue>(sum);\n        history[oldest] = result;\n        if (++oldest == n) {\n            oldest = 0;\n        }\n    }\n    return result;\n}\n\nResidue recurrence_term(const std::vector<Residue>& initial,\n                        const std::vector<Residue>& coefficients, Wide h) {\n    const int n = static_cast<int>(initial.size());\n    if (h <= static_cast<Wide>(n)) {\n        return initial[static_cast<std::size_t>(h - 1)];\n    }\n\n    const Wide exponent = h - 1;\n    int bits = 0;\n    for (Wide value = exponent; value != 0; value >>= 1) {\n        ++bits;\n    }\n\n    const Wide steps = h - static_cast<Wide>(n);\n    const Wide estimated_work = polynomial_work(n, exponent, bits);\n    if (steps <= estimated_work / static_cast<Wide>(n)) {\n        return direct_term(initial, coefficients, steps);\n    }\n\n    std::vector<Residue> polynomial(n, 0);\n    std::vector<Residue> scratch(2 * n - 1);\n    polynomial[0] = 1;\n    int length = 1;\n\n    // Left-to-right exponentiation of x^(h-1) modulo the characteristic polynomial.\n    for (int bit = bits - 1; bit >= 0; --bit) {\n        square_mod(polynomial, length, coefficients, scratch);\n        if ((exponent >> bit) & 1ULL) {\n            multiply_by_x(polynomial, length, coefficients);\n        }\n    }\n\n    Wide answer = 0;\n    for (int i = 0; i < length; ++i) {\n        answer = (answer + static_cast<Wide>(polynomial[i]) * initial[i]) % MOD;\n    }\n    return static_cast<Residue>(answer);\n}\n} // namespace\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n;\n    Wide h;\n    if (!(std::cin >> n >> h)) {\n        return 0;\n    }\n\n    std::vector<Residue> initial(n);\n    std::vector<Residue> coefficients(n);\n    for (int i = 0; i < n; ++i) {\n        Wide value;\n        std::cin >> value;\n        initial[i] = static_cast<Residue>(value % MOD);\n    }\n    for (int i = 0; i < n; ++i) {\n        Wide value;\n        std::cin >> value;\n        coefficients[n - 1 - i] = static_cast<Residue>(value % MOD);\n    }\n\n    std::cout << recurrence_term(initial, coefficients, h) << '\\n';\n    return 0;\n}\n",
      "path": "src/npbonacci.cpp"
    }
  ],
  "hypothesis": "Replacing dense matrix powers with compact characteristic-polynomial buffers should improve locality while reducing work to O(N² log H) and storage to O(N).",
  "notes": "Not compiled or measured; evaluation remains with the controller. Selection uses analytical operation counts, not benchmark-specific thresholds. All mutable buffers are call-local; 64-bit intermediates safely accommodate doubled products.",

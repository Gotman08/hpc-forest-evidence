"""Correct only a documented suite decomposition from original XML; no replay."""
import hashlib
import json
from pathlib import Path

OUT = Path(__file__).resolve().parent
SOURCE = OUT.parent / "revision-source-cli-r1"


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def ref(path):
    return {"path": str(path), "sha256": sha(path)}


def save(path, value):
    with path.open("x", encoding="utf8", newline="\n") as stream:
        json.dump(value, stream, indent=2, ensure_ascii=False)
        stream.write("\n")


suite = json.loads((OUT / "TESTS-NEUTRES-187-EXACTS.json").read_text("utf8"))
assert suite["suite_counts"] == {"test_cli_contract_lane_r3.py": 73, "test_owned_timeout_lane_r3.py": 6,
    "test_matrix_worker_cli_lane_r3.py": 34, "test_dynamic_runtime_gate_lane_r3.py": 39,
    "test_lane_contract.py": 26, "test_r4b_privacy.py": 9}
assert sum(suite["suite_counts"].values()) == 187
suite["explicit_inert_scope"] = "152 new parser/policy/holds/watchdog/gate +26 unchanged R4b lane-v2 +9 pure privacy predicates; every process/timer effect is a double"
suite["prior_description_preserved"] = ref(OUT / "TESTS-NEUTRES-187-EXACTS.json")
save(OUT / "TESTS-NEUTRES-187-EXACTS-r2.json", suite)
proposal = json.loads((OUT / "PREPARATION-QUALIFICATION-NON-ADMISE.json").read_text("utf8"))
proposal["inert_suite"] = ref(OUT / "TESTS-NEUTRES-187-EXACTS-r2.json")
proposal["prior_proposal_preserved"] = ref(OUT / "PREPARATION-QUALIFICATION-NON-ADMISE.json")
save(OUT / "PREPARATION-QUALIFICATION-NON-ADMISE-r2.json", proposal)
blocked = json.loads((OUT / "JOB-PREPARE-BLOQUE.json").read_text("utf8"))
blocked["proposal"] = ref(OUT / "PREPARATION-QUALIFICATION-NON-ADMISE-r2.json")
save(OUT / "JOB-PREPARE-BLOQUE-r2.json", blocked)
old_doc = SOURCE / "REPRISE.md"
text = old_doc.read_text("utf8")
before = ref(old_doc)
archive = SOURCE / "REPRISE-AVANT-CLARIFICATION-DECOMPOSITION.md"
with archive.open("xb") as stream:
    stream.write(old_doc.read_bytes())
assert sha(archive) == before["sha256"]
assert "142 nouveaux cas" in text and "36 cas lane-v2" in text
old_doc.write_text(text.replace("142 nouveaux cas", "152 nouveaux cas").replace("36 cas lane-v2", "26 cas lane-v2"), encoding="utf8")
save(OUT / "CLARIFICATION-COMPTAGE-187.json", {"schema": "hpc-forest-r4b-inert-count-description-clarification-v1",
    "verified_from_existing_XML_no_replay": True, "unique_passed_unchanged": 187,
    "correct_decomposition": {"new_R3_tests": 152, "old_R4b_lane_tests": 26, "old_privacy_predicates": 9},
    "previous_incorrect_text": "142 new +36 lane +9 privacy; 36 was the R2g lane count rather than R4b",
    "source_zip_or_plan_or_source110_or_XML_modified": False,
    "previous_REPRISE_bytes_preserved": ref(archive), "current_REPRISE": ref(old_doc),
    "current_Q_proposal": ref(OUT / "PREPARATION-QUALIFICATION-NON-ADMISE-r2.json"),
    "allocated_Q_or_model_or_CLI_or_transport_executed": False})
print(json.dumps({"proposal": ref(OUT / "PREPARATION-QUALIFICATION-NON-ADMISE-r2.json"),
    "clarification": ref(OUT / "CLARIFICATION-COMPTAGE-187.json")}))

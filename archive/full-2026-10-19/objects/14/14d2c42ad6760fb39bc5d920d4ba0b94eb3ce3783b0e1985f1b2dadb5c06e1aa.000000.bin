"""ROOT only: project real cold receipts; preserve exact readable caches, never lock bytes.

No operational main is run by the author. No stop/admission/independent review is produced.
Invoke reviewed source with -I -S -B and --root-only-normalise after independent review.
"""
import argparse
import hashlib
import importlib.util
import json
from pathlib import Path
import sys

HERE = Path(__file__).resolve().parent
OPS = HERE.parent
REL = OPS.parent
BASE = REL.parents[1]
COLLECTOR = REL / 'collecte-finale-pure-r2/collecter-final-parent.py'
COLLECTOR_SHA = '9fa1f9aae6341857fdc1fc6893188646eac73a35fb99ba29ac2479f89e9b4be6'
COLLECTION = REL / 'collecte-finale-pure-r2/execution-reelle-par-etapes-01/COLLECTE-PRE-STOP-POUR-AUDIT.json'
COLLECTION_SHA = '7dfd1862ccb7c1ef7bae1a3472c57f07521d092d43f4ce13d4de6011135e7e60'
AUDIT = BASE / 'outputs/HPC-Forest-Primes-Natif-Audit-r2g'
COMPANION = AUDIT / 'metadata-terminal-r1/companion'
READER_SHA = 'db269b0314dfbf67bdd37de5f4c3a27ccb16f257106ac2b3425225abea7cedc1'
COLD_REVIEW = AUDIT / 'metadata-terminal-r1/revue-resultats-reels-r1/REVUE-INDEPENDANTE-RESULTATS-REELS-G-METADATA.json'
COLD_REVIEW_SHA = 'd9387765411068ed2e4022da2984295c38e5b3de3ca57f793262a984f7bec739'
SOURCE = 'f8c2104bad52e3c298de596fd365415fbdfbbb12fbdc41b47b06a94ad68273fe'
PLAN = '5af07859f99192e169f2475fb2c863c9d4a05a4a8dba07845b3fcc54451e7dba'
SCOPE = 'hpc-forest-primes-native-max-r2g'
FIRST = REL / 'DEMARRAGES-NORMAUX-ET-POURSUITES-VERIFIES.json'
FIRST_SHA = 'e9c5c4a9eb129018704478e5e365ab0ce142ff2adaf6ff5e493e87097d31a95e'
ROWS = (
    ('astra', '753498', 'gpt-6-astra', '110cefccf16b439eb226e475c875c8df', 4,
     'e5f3ff5ffd1c7725492e2991560521d1b684e4d0a48fb8f697109c6e551ae63f',
     '064776f9a7987ff5ce81f90a398e4929a81d05cb1cd3202b1fbe9d742efe4393',
     'bdbe830f3dbf9a0c467b6edc7e15a3d4a3014725728093942c2845c4444bd496'),
    ('terra', '753497', 'gpt-5.6-terra', '5d8811082a1842f5836a2bdda982500f', 3,
     '25a5ed61c4fa45d227091718b2a2bcca85dc92fba157b08993bd72585ca755ab',
     '2ad3708d3a7c4503be6b3a14e47ae52d1fc65a93f7147803f29caebe65f08b55',
     '758ef645ae5815c9c9c6f942e535d2a88fd033b40255d0a0f499567fa2bf0b6d'),
    ('sol', '753499', 'gpt-6.1-sol', '13eaca4e39cf4147a3f677a32fb5a52d', 3,
     '24afc768dc74b70afeec80ae5f86668ee3566c90a75aea4044f3c10d5451e644',
     '4d8774456e6757cc1d4b5af100391029b11f339b22681751fca29a9f7b644619',
     '5fa7b8cb2dada404b8ce5ba4dda3187c272e52b040dd6bb2136fbf1688dfc6e5'),
)
SLOTS = ('terminal_receipt', 'reconciliation', 'independent_final_review',
         'named_snapshots', 'cache_preservation', 'frozen_evidence_inventory')


def need(condition, message):
    if not condition:
        raise ValueError(message)


def cell_identity(row):
    slug, job, model, session, *_ = row
    return dict(scope_id=SCOPE, job_id=job, model=model, session_id=session, effort='max',
                source_zip_sha256=SOURCE, plan_sha256=PLAN)


def validate_metadata(report, reconciliation, native_refusal, row):
    """Only new projection checks. Existing private/scientific auditors are never replayed."""
    identity = cell_identity(row)
    for value in (report, reconciliation, native_refusal):
        need(all(value.get(k) == v for k, v in identity.items()), 'Exact G audit identity/source/plan differs')
    need(report.get('schema') == 'hpc-forest-r2g-terminal-delivery-metadata-audit-v1'
         and report.get('verified') is True, 'Actual metadata PASS required')
    need(reconciliation.get('schema') == 'hpc-forest-r2g-terminal-delivery-metadata-reconciliation-v1'
         and reconciliation.get('verified') is True
         and reconciliation.get('all_started_calls_delivery_reconciled') is True
         and reconciliation.get('delivery_and_costs') == report['reconciliation']
         and reconciliation.get('new_generation_retry_replay_or_stop_authorized') is False,
         'Actual separate delivery reconciliation required')
    need(native_refusal.get('schema') == 'hpc-forest-primes-r2max-readonly-audit-v1'
         and native_refusal.get('verified') is False
         and native_refusal.get('audit_error') == 'AuditError: Unknown native claims/costs block complete audit'
         and native_refusal.get('evidence_inventory_before_after_identical') is True
         and native_refusal.get('native_research_admitted') is False,
         'Expected real native refusal and unchanged evidence required')
    need(report.get('pipeline_complete_recorded') is False
         and report.get('lock_read_attempted') is False
         and report.get('CLI_process_model_network_or_received_source_execution') == 0
         and all(report.get(k) is False for k in ('native_research_admitted', 'independent_performance_verified',
             'five_confirmations_verified', 'final_scientific_audit_admitted')),
         'No pipeline/native/scientific/lock promotion permitted')
    summary = report['reconciliation']
    records = summary['records']
    nonces = [r['nonce'] for r in records]
    need(len(nonces) == len(set(nonces)) == summary['received_invocations'] == row[4]
         and summary['all_received_requests_invocations_and_deliveries_reconciled'] is True
         and all(r.get('delivered_and_hash_reconciled') is True
                 and r.get('NORMAL_or_scientific_admission_claimed') is False for r in records),
         'Exhaustive delivered metadata boundary differs')
    exact = [r for r in records if r.get('token_accounting') == 'exact']
    unknown = [r for r in records if r.get('token_accounting') == 'upper_bound']
    need(len(exact) + len(unknown) == len(records)
         and len(exact) == summary['exact_known_invocations']
         and len(unknown) == summary['unmeasured_invocations'] == 1
         and all(type(r.get('exact_known_tokens')) is int and r['exact_known_tokens'] >= 0 for r in exact)
         and sum(r['exact_known_tokens'] for r in exact) == summary['exact_known_tokens']
         and all(r.get('exact_known_tokens') is None for r in unknown)
         and summary['received_cell_token_total'] is None
         and summary['exact_received_cell_token_total_available'] is False,
         'Unknown usage must remain unknown, never zero or exact')
    hold = report['transport_diagnostics_and_usage_limits']['technical_hold']
    need(hold.get('verified_at_hold_scope_only') is True and hold.get('new_generations_allowed') is False
         and hold.get('nonce') in nonces, 'Source-bound terminal technical hold required')
    return sorted(nonces)


def equal_boundary(expected, observed):
    need(expected and expected == observed and 'worker.lock' not in observed,
         'Qualified full readable inventory differs (extra/missing/changed file)')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root-only-normalise', action='store_true', required=True)
    parser.parse_args()
    need(sys.flags.isolated and sys.flags.no_site and sys.dont_write_bytecode,
         'ROOT must use isolated Python -I -S -B; no historical __pycache__ writes')
    need(hashlib.sha256(COLLECTOR.read_bytes()).hexdigest() == COLLECTOR_SHA, 'Reviewed collector changed')
    spec = importlib.util.spec_from_file_location('frozen_collection_primitives', COLLECTOR)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)  # Definitions only, main guard stays closed; HERE never reassigned.
    reader = COMPANION / 'auditer-metadonnees-terminales.py'
    need(module.ref(reader)['sha256'] == READER_SHA, 'Metadata reader pin changed; never executed here')
    cold_review = module.read_ref({'path': str(COLD_REVIEW), 'sha256': COLD_REVIEW_SHA})
    need(cold_review.get('schema') == 'hpc-forest-r2g-independent-actual-terminal-metadata-review-v1'
         and cold_review.get('verified') is True and cold_review.get('scope_id') == SCOPE
         and cold_review.get('blocking_findings') == [] and cold_review.get('native_research_admitted') is False,
         'Actual independent cold metadata review required; no new final review manufactured')
    collection = module.read_ref({'path': str(COLLECTION), 'sha256': COLLECTION_SHA})
    need(collection.get('schema') == 'hpc-forest-r2g-root-cold-collection-pre-stop-v1'
         and collection.get('readable_data_collection_completed') is True
         and collection.get('stop_or_launch_executed') is False
         and collection.get('scientific_or_performance_admission') is False
         and len(collection['cells']) == 3, 'Real completed ROOT collection required')
    frozen_path = COLLECTOR.parent / 'INPUTS-FROIDS-EPINGLES-r2.json'
    frozen = module.read_ref({'path': str(frozen_path), 'sha256': module.FROZEN_INPUTS_SHA})
    need(frozen.get('schema') == 'hpc-forest-r2g-root-collection-frozen-inputs-v1'
         and set(frozen['cells']) == {r[3] for r in ROWS}, 'Exact frozen three-cell inputs required')
    module.recheck_frozen_references(frozen)
    first = module.read_ref({'path': str(FIRST), 'sha256': FIRST_SHA})
    need(first.get('schema') == 'hpc-forest-r2g-parent-three-first-starts-and-continuations-v1'
         and first.get('verified_first_starts_and_continuations_only') is True
         and first.get('scope_id') == SCOPE
         and first.get('global_scientific_or_performance_or_hardware_isolation_admission') is False,
         'Preserved real first starts e9c5 required')
    prepared = []
    for row in ROWS:
        slug, job, model, session, count, report_sha, recon_sha, native_sha = row
        paths = (COMPANION / f'audit-metadata-reel-{job}-01.json',
                 COMPANION / f'reconciliation-reelle-{job}-01.json',
                 AUDIT / f'revision-r3/audit-natif-partiel-{job}-01.json')
        refs = [dict(path=str(p), sha256=h) for p, h in zip(paths, (report_sha, recon_sha, native_sha))]
        report, recon, native = [module.read_ref(r) for r in refs]
        nonces = validate_metadata(report, recon, native, row)
        need(recon['reception'] == refs[0], 'Original metadata reception/ref differs')
        cells = [c for c in collection['cells'] if c['session_id'] == session]
        need(len(cells) == 1 and cells[0]['job_id'] == job and cells[0]['model'] == model
             and cells[0]['authoritative_archive_request_count'] == count, 'Unique actual collected cell differs')
        received = cells[0]
        cold = frozen['cells'][session]
        need(set(cold['archive_request_refs']) == set(nonces), 'Archive-only nonce set differs')
        binding = module.read_ref(received['binding'])
        need(all(binding.get(k) == v for k, v in cell_identity(row).items()), 'Qualified binding differs')
        need(module.ref(received['source_zip'])['sha256'] == SOURCE
             and module.ref(received['plan'])['sha256'] == PLAN, 'Source110/plan actual bytes differ')
        preservation = module.read_ref(received['cache_receipt'])
        expected = module.read_ref(preservation['source_inventory_before'])
        equal_boundary(expected, module.read_ref(preservation['source_inventory_after']))
        equal_boundary(expected, preservation['files'])
        equal_boundary(expected, module.cold_tree(Path(received['cache'])))
        need(report['cache_preservation']['snapshot_files_verified'] == len(expected), 'Audited snapshot count differs')
        deliveries = module.read_ref(received['delivery_byte_bindings'])
        need(deliveries.get('all_received_responses_delivered') is True
             and {d['nonce'] for d in deliveries['nonces']} == set(nonces), 'Qualified delivery nonce boundary differs')
        hold_path = Path(received['cache']) / 'cli-technical-hold.json'
        hold = module.read(hold_path)
        need(hold.get('new_generations_allowed') is False
             and module.ref(hold_path)['sha256'] == report['transport_diagnostics_and_usage_limits']['technical_hold']['hold_sha256'],
             'Qualified source-bound hold bytes differ')
        state = module.read_ref(cold['scheduler_observation'])
        state = state.get('structuredContent', state)
        need(state.get('job_id') == job and state.get('state') == 'FAILED' and state.get('exit_code') == '1:0'
             and state.get('finished') is True, 'Actual terminal FAILED1:0 required')
        prepared.append((row, refs, report, received, expected, nonces))
    totals = [sum(x[2]['reconciliation'][k] for x in prepared) for k in
              ('received_invocations', 'exact_known_invocations', 'exact_known_tokens', 'unmeasured_invocations')]
    need(totals == [10, 7, 146676, 3], 'Exact real aggregate metadata cost boundary differs')
    output = module.safe(HERE / 'execution-root-01', HERE)
    output.mkdir(exist_ok=False)
    save = lambda name, value: module.save(output / name, value, boundary=HERE)
    common = dict(scope_id=SCOPE, source_zip_sha256=SOURCE, plan_sha256=PLAN,
                  native_research_admitted=False, global_scientific_or_performance_admission=False,
                  pipeline_complete=False, five_confirmations_verified=False, lock_read_attempted=False)
    save('INTENTION-NORMALISATION-ROOT.json', {**common, 'collector': module.ref(COLLECTOR),
         'collection': module.ref(COLLECTION), 'metadata_reader': module.ref(reader),
         'first_starts': module.ref(FIRST), 'stop_or_new_generation_authorized': False,
         'cache_copy_executor': 'ROOT only', 'six_final_pins_modified': False})
    roots = module.safe(OPS / 'preservation-caches-avant-arret', OPS)
    snapshots, workers, cohorts, report_copies, native_copies, evidence = [], [], [], [], [], []
    try:
        roots.mkdir(exist_ok=False)
        review_copy = module.copy_exact(COLD_REVIEW, output / 'copies-audits-froids' / COLD_REVIEW.name,
                                       COLD_REVIEW_SHA, boundary=HERE)
        evidence.append(review_copy)
        for row, original_refs, report, received, expected, nonces in prepared:
            slug, job, model, session, *_ = row
            need(module.ref(COLLECTOR)['sha256'] == COLLECTOR_SHA, 'Reviewed primitives changed')
            copies = [module.copy_exact(module.item(r), output / 'copies-audits-froids' / Path(r['path']).name,
                        r['sha256'], boundary=HERE) for r in original_refs]
            report_copies.extend(copies[:2]); native_copies.append(copies[2]); evidence.extend(copies)
            cache = module.LAUNCH / ('worker-' + session)
            # discover_cache rejects extra names/nonces, links and SQLite BEFORE reading file contents.
            before, metadata_before = module.inventory_readable(cache, set(nonces))
            equal_boundary(expected, before)
            target_root = module.safe(roots / slug, OPS); target_root.mkdir(exist_ok=False)
            target = target_root / 'copie-opaque'; target.mkdir(exist_ok=False)
            for name, value in sorted(expected.items()):
                evidence.append(module.copy_exact(cache / Path(name), target / Path(name), value['sha256'], boundary=OPS))
                snapshots.append({'source': str(cache / Path(name)),
                    'source_sha256': value['sha256'], 'received': module.ref(Path(received['cache']) / Path(name)),
                    'bytes': value['bytes']})
            after, metadata_after = module.inventory_readable(cache, set(nonces))
            equal_boundary(before, after)
            need(metadata_before == metadata_after, 'Source readable+lock metadata changed during preservation')
            equal_boundary(expected, module.cold_tree(target))
            inv_refs = [module.save(target_root / name, value, boundary=OPS) for name, value in
                        (('inventaire-avant.json', before), ('inventaire-apres.json', after))]
            lock_ref = module.save(target_root / 'lock-stat-seul-avant-apres.json', {
                'source': str(cache / 'worker.lock'), 'before': metadata_before['worker.lock'],
                'after': metadata_after['worker.lock'], 'bytes_read': False, 'read_attempted': False,
                'read_errno': None, 'sha256': None, 'equal': True}, boundary=OPS)
            evidence.extend(inv_refs + [lock_ref, received['binding'], received['reception'],
                received['cache_receipt'], received['delivery_byte_bindings'],
                module.ref(received['source_zip']), module.ref(received['plan'])])
            workers.append({'job_id': job, 'session_id': session, 'source_cache': str(cache),
                'opaque_copy': str(target), 'before_after_copy_equal': True,
                'excluded_live_lock_paths': ['worker.lock'], 'live_lock_content_read': False,
                'owned_source_names_checked': True, 'source_stable_including_lock_stat_only': True,
                'regular_files_preserved': len(before), 'bytes': sum(v['bytes'] for v in before.values()),
                'evidence_refs': inv_refs, 'lock_stat_only': lock_ref})
            cohorts.append({**cell_identity(row), 'terminal_state': 'FAILED', 'exit_code': '1:0',
                'restored_before_after_equal': True, 'private_argv_and_policy_reconciled': True,
                'all_requests_reconciled': True, 'no_active_or_inflight_claims': True,
                'claim_status_scope': 'exact readable cache matches audited closed delivery boundary plus source-bound hold; not process absence',
                'reviewed_completed_nonces': nonces, 'completed_claims_and_CLI_process_invocations': len(nonces),
                'metadata_audit': copies[0], 'metadata_reconciliation': copies[1], 'native_refusal': copies[2],
                'costs': report['reconciliation']})
        module.recheck_frozen_references(frozen)
        need(module.ref(COLLECTION)['sha256'] == COLLECTION_SHA
             and module.ref(FIRST)['sha256'] == FIRST_SHA, 'Frozen collection/first start changed')
        proofs = {}
        proofs['terminal_receipt'] = save('RECEPTION-FINALE-METADATA-SEULEMENT.json', {**common,
            'schema': 'hpc-forest-r2g-normalised-final-metadata-receipt-v1',
            'verified_metadata_only': True, 'archive_triple_SHA_and_fresh_restore_verified': True,
            'all_delivered_call_raw_private_argv_and_policy_reconciled': True,
            'source110_exact_bytes_verified': True, 'all_three_terminal_jobs_received': True,
            'actual_metadata_audits_and_reconciliations': report_copies, 'actual_native_refusals': native_copies,
            'actual_independent_cold_metadata_review': review_copy,
            'collection': module.ref(COLLECTION), 'first_starts': module.ref(FIRST),
            'native_complete_audit_refusal': 'Unknown native claims/costs block complete audit',
            'new_generation_retry_replay_or_stop_authorized': False})
        proofs['reconciliation'] = save('RECONCILIATION-FINALE-METADATA-SEULEMENT.json', {**common,
            'schema': 'hpc-forest-r2g-normalised-final-metadata-reconciliation-v1', 'verified': True,
            'all_requests_reconciled': True, 'no_active_or_inflight_claims': True,
            'claim_status_scope': 'three exact closed cache metadata boundaries; no live process absence claimed',
            'first_starts_and_continuations_sha256': FIRST_SHA, 'cohorts': cohorts,
            'received_invocations': 10, 'exact_known_invocations': 7, 'exact_known_tokens': 146676,
            'unmeasured_invocations': 3, 'exact_total_tokens': None,
            'upper_bounds_added_to_consumption': False, 'NORMAL_scientific_success_claimed': False,
            'native_refusals': native_copies})
        proofs['named_snapshots'] = save('SNAPSHOTS-NOMMES-EXACTS.json', {**common,
            'schema': 'hpc-forest-r2g-normalised-named-snapshots-v1', 'count': len(snapshots), 'files': snapshots,
            'live_cache_enumerated': False, 'enumeration_source': 'qualified cold readable inventories only',
            'live_cache_enumerated_flag_scope': 'this named cold selector only; not collection or preservation',
            'source_collection_and_preservation_did_enumerate_owned_source_names': True})
        proofs['cache_preservation'] = save('PRESERVATION-CACHES-LISIBLES-VERIFIEE.json', {**common,
            'schema': 'hpc-forest-r2g-normalised-readable-cache-preservation-v1',
            'opaque_regular_cache_files_preserved_except_live_lock': True,
            'source_cache_unchanged': True, 'workers': workers, 'complete_cache_including_lock': False,
            'owned_source_names_checked': True, 'source_stable_including_lock_stat_only': True})
        evidence.extend(proofs.values())
        evidence.extend([module.ref(COLLECTION), module.ref(frozen_path), module.ref(FIRST), module.ref(COLLECTOR)])
        evidence.extend(s['received'] for s in snapshots)
        unique = {}
        for value in evidence:
            path = Path(value['path'])
            need(not any(path.is_relative_to(module.LAUNCH / ('worker-' + r[3])) for r in ROWS),
                 'Frozen evidence inventory must never reference live worker cache')
            module.item(value)
            unique[(value['path'], value['sha256'])] = value
        proofs['frozen_evidence_inventory'] = save('INVENTAIRE-PREUVES-FROIDES.json', {**common,
            'schema': 'hpc-forest-r2g-normalised-frozen-evidence-inventory-v1',
            'files': list(unique.values()), 'live_worker_cache_references': False,
            'scope': 'actual copied cold audits, exact received snapshots, preserved opaque copies and pinned provenance'})
        save('SIX-PREUVES-CANDIDATES-NON-ADMISES.json', {**common,
            'schema': 'hpc-forest-r2g-six-final-candidate-proofs-v1', 'effect_admitted': False,
            'independent_final_review_produced': False, 'existing_stop_pins_modified': False,
            'proofs': {slot: {'status': 'NON_ADMIS', 'candidate': proofs.get(slot)} for slot in SLOTS},
            'missing_slot_requires_B_after_real_normalisation': 'independent_final_review'})
        print(json.dumps({'normalisation': str(output), 'candidate_proofs': proofs,
                          'six_final_admissions': 'NON_ADMIS', 'stop_authorized': False}))
    except BaseException as exc:
        save('NORMALISATION-REFUSEE.json', {'verified': False, 'error': str(exc),
            'partial_files_retained': True, 'automatic_retry_allowed': False, 'stop_authorized': False})
        raise


if __name__ == '__main__':
    main()

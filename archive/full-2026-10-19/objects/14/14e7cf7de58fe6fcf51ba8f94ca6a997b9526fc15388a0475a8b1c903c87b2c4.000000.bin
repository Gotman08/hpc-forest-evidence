      "content": "#define _POSIX_C_SOURCE 200809L\n#include \"knn.h\"\n#include <omp.h>\n\ntypedef struct {\n    float dist;\n    int idx;\n    char label;\n} HeapEntry;\n\nstatic inline int worse_entry(const HeapEntry *a, const HeapEntry *b) {\n    if (a->dist != b->dist) return a->dist > b->dist;\n    return a->idx > b->idx;\n}\n\nstatic inline void swap_entries(HeapEntry *a, HeapEntry *b) {\n    HeapEntry t = *a; *a = *b; *b = t;\n}\n\nstatic inline void sift_up(HeapEntry *heap, int pos) {\n    while (pos > 0) {\n        int parent = (pos - 1) / 2;\n        if (worse_entry(&heap[pos], &heap[parent])) {\n            swap_entries(&heap[pos], &heap[parent]);\n            pos = parent;\n        } else break;\n    }\n}\n\nstatic inline void sift_down(HeapEntry *heap, int start, int end) {\n    int root = start;\n    while (1) {\n        int child = 2 * root + 1;\n        if (child > end) break;\n        int right = child + 1;\n        if (right <= end && worse_entry(&heap[right], &heap[child])) child = right;\n        if (worse_entry(&heap[root], &heap[child])) {\n            swap_entries(&heap[root], &heap[child]);\n            root = child;\n        } else break;\n    }\n}\n\nstatic inline void heap_push(HeapEntry *heap, int *n, HeapEntry e) {\n    int i = (*n)++;\n    heap[i] = e;\n    sift_up(heap, i);\n}\n\nstatic inline void heap_replace_root(HeapEntry *heap, int n, HeapEntry e) {\n    heap[0] = e;\n    sift_down(heap, 0, n - 1);\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    long N = 0;\n    for (int i = 0; i < n_groups; ++i) {\n        N += groups[i].length;\n    }\n\n    if (N == 0) return -1;\n\n    float * restrict xs;\n    float * restrict ys;\n    char *plabels;\n    if (posix_memalign((void**)&xs, 64, N * sizeof(float)) != 0) exit(1);\n    if (posix_memalign((void**)&ys, 64, N * sizeof(float)) != 0) exit(1);\n    plabels = (char *)malloc(N * sizeof(char));\n\n    long pos = 0;\n    for (int gi = 0; gi < n_groups; ++gi) {\n        Group g = groups[gi];\n        char lab = g.label;\n        Point *pts = g.points;\n        int len = g.length;\n        for (int j = 0; j < len; ++j) {\n            xs[pos] = pts[j].x;\n            ys[pos] = pts[j].y;\n            plabels[pos] = lab;\n            ++pos;\n        }\n    }\n\n    float tx = to_evaluate.x;\n    float ty = to_evaluate.y;\n\n    float * restrict dists;\n    if (posix_memalign((void**)&dists, 64, N * sizeof(float)) != 0) exit(1);\n\n#pragma omp parallel for simd schedule(static) aligned(xs, ys, dists: 64)\n    for (long p = 0; p < N; ++p) {\n        float dx = xs[p] - tx;\n        float dy = ys[p] - ty;\n        dists[p] = dx * dx + dy * dy;\n    }\n\n    int nthreads = omp_get_max_threads();\n\n    HeapEntry **local_heaps = (HeapEntry **)malloc(nthreads * sizeof(HeapEntry *));\n    int *local_counts = (int *)calloc(nthreads, sizeof(int));\n    for (int t = 0; t < nthreads; ++t) {\n        local_heaps[t] = (HeapEntry *)malloc(k * sizeof(HeapEntry));\n    }\n\n#pragma omp parallel\n    {\n        int tid = omp_get_thread_num();\n        HeapEntry *heap = local_heaps[tid];\n        int cnt = 0;\n\n#pragma omp for schedule(guided)\n        for (long p = 0; p < N; ++p) {\n            float d = dists[p];\n            if (cnt < k) {\n                HeapEntry e;\n                e.dist = d;\n                e.idx = (int)p;\n                e.label = plabels[p];\n                heap_push(heap, &cnt, e);\n            } else {\n                HeapEntry e;\n                e.dist = d;\n                e.idx = (int)p;\n                e.label = plabels[p];\n                if (!worse_entry(&e, &heap[0])) {\n                    heap_replace_root(heap, k, e);\n                }\n            }\n        }\n        local_counts[tid] = cnt;\n    }\n\n    int total_candidates = 0;\n    for (int t = 0; t < nthreads; ++t) {\n        total_candidates += local_counts[t];\n    }\n\n    HeapEntry *global_heap = (HeapEntry *)malloc(k * sizeof(HeapEntry));\n    int gcnt = 0;\n\n    for (int t = 0; t < nthreads; ++t) {\n        HeapEntry *heap = local_heaps[t];\n        int cnt = local_counts[t];\n        for (int i = 0; i < cnt; ++i) {\n            if (gcnt < k) {\n                heap_push(global_heap, &gcnt, heap[i]);\n            } else {\n                if (!worse_entry(&heap[i], &global_heap[0])) {\n                    heap_replace_root(global_heap, k, heap[i]);\n                }\n            }\n        }\n    }\n\n    char *labels = (char *)malloc(k * sizeof(char));\n    for (int i = 0; i < k; ++i) {\n        if (i < gcnt) {\n            labels[i] = global_heap[i].label;\n        } else {\n            labels[i] = -1;\n        }\n    }\n\n    free(xs);\n    free(ys);\n    free(dists);\n    free(plabels);\n    for (int t = 0; t < nthreads; ++t) free(local_heaps[t]);\n    free(local_heaps);\n    free(local_counts);\n    free(global_heap);\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; ++i) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(labels);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Integrating flattened contiguous storage with aligned SIMD distance computation and per-thread max-heaps keyed by (distance, index) should reduce runtime while preserving exact reference semantics including sentinel handling when fewer than k points exist.",
  "notes": "Only src/knn.c was modified; knn.h remains unchanged. The implementation flattens all group points into aligned xs/ys arrays, computes squared distances in parallel with OpenMP SIMD (aligned and restrict), then uses per-thread max-heaps to select top-k candidates without critical sections, merging via a global heap. Tie-breaking by original index matches the reference insertion order. Sentinel -1 labels are appended when N < k before frequency counting.",

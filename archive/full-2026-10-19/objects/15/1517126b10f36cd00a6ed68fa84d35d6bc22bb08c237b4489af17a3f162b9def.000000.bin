      "content": "#include <stdio.h>\n#include <stdlib.h>\n\n#define MAXNUM 1000\n#define MAXSTR 50\n#define BLOCK_SIZE 16\n\ntypedef struct {\n    long value;\n    long scale;\n} Fragment;\n\nstatic Fragment firstHalf[MAXNUM];\nstatic Fragment secondHalf[MAXNUM];\n\nstatic int read_fragment(Fragment *fragment)\n{\n    char text[MAXSTR];\n    const char *digit;\n\n    if (scanf(\"%49s\", text) != 1)\n        return 0;\n\n    fragment->value = strtol(text, NULL, 10);\n    fragment->scale = 1;\n    for (digit = text; *digit != '\\0'; ++digit)\n        fragment->scale *= 10;\n\n    return 1;\n}\n\nstatic int isprime(long value)\n{\n    long factor;\n\n    if (value < 2)\n        return 0;\n    if (value % 2 == 0)\n        return value == 2;\n    if (value % 3 == 0)\n        return value == 3;\n\n    for (factor = 5; factor <= value / factor; factor += 6) {\n        if (value % factor == 0 || value % (factor + 2) == 0)\n            return 0;\n    }\n    return 1;\n}\n\nstatic int compare_long(const void *left, const void *right)\n{\n    long a = *(const long *)left;\n    long b = *(const long *)right;\n    return (a > b) - (a < b);\n}\n\nint main(void)\n{\n    int numPrimes;\n    int i;\n    int j;\n    int numResults = 0;\n    size_t resultCapacity;\n    long *result;\n\n    if (scanf(\"%d\", &numPrimes) != 1 || numPrimes < 1 || numPrimes > MAXNUM)\n        return 0;\n\n    for (i = 0; i < numPrimes; ++i) {\n        if (!read_fragment(&firstHalf[i]))\n            return 1;\n    }\n    for (i = 0; i < numPrimes; ++i) {\n        if (!read_fragment(&secondHalf[i]))\n            return 1;\n    }\n\n    resultCapacity = (size_t)numPrimes * (size_t)numPrimes;\n    result = malloc(resultCapacity * sizeof(*result));\n    if (result == NULL)\n        return 1;\n\n    for (int iBase = 0; iBase < numPrimes; iBase += BLOCK_SIZE) {\n        int iLimit = iBase + BLOCK_SIZE;\n        if (iLimit > numPrimes)\n            iLimit = numPrimes;\n\n        for (int jBase = 0; jBase < numPrimes; jBase += BLOCK_SIZE) {\n            int jLimit = jBase + BLOCK_SIZE;\n            if (jLimit > numPrimes)\n                jLimit = numPrimes;\n\n            for (i = iBase; i < iLimit; ++i) {\n                long prefix = firstHalf[i].value;\n                for (j = jBase; j < jLimit; ++j) {\n                    long candidate = prefix * secondHalf[j].scale + secondHalf[j].value;\n                    if (isprime(candidate))\n                        result[numResults++] = candidate;\n                }\n            }\n        }\n    }\n\n    qsort(result, (size_t)numResults, sizeof(*result), compare_long);\n    for (i = 0; i < numResults; ++i)\n        printf(\"%ld\\n\", result[i]);\n\n    free(result);\n    return 0;\n}\n",
      "path": "src/sources/primetest.c"
    }

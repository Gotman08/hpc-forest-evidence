<< endl;\\n-}\\n\\\\ No newline at end of file\\n+    ios::sync_with_stdio(false);\\n+    cin.tie(nullptr);\\n+\\n+    int n, m;\\n+    cin >> n >> m;\\n+    vector<vector<bool>> blockedCells(n, vector<bool>(n, false));\\n+    for (int c = 0; c < m; c++) {\\n+        int i, j;\\n+        cin >> i >> j;\\n+        blockedCells[i][j] = true;\\n+    }\\n+\\n+    vector<int> dp(n, 0);\\n+    if (!blockedCells[0][0]) dp[0] = 1;\\n+\\n+    for (int i = 0; i < n; i++) {\\n+        for (int j = 0; j < n; j++) {\\n+            if (blockedCells[i][j]) {\\n+                dp[j] = 0;\\n+            } else if (j > 0) {\\n+                int sum = dp[j] + dp[j - 1];\\n+                if (sum >= MOD) sum -= MOD;\\n+                dp[j] = sum;\\n+            }\\n+        }\\n+    }\\n+\\n+    cout << dp[n - 1] << '\\\\n';\\n+    return 0;\\n+}\"}, {\"id\": \"a9f1de68044342f3\", \"role\": \"C\", \"commit\": \"2425decf37d2d25c2cc59a8ab73bba38eb4ecf65\", \"transformations\": {\"files\": [\"src/solution.cpp\"], \"retained\": [\"Use one in-place DP row, overwriting each entry from left to right; blocked cells reset the corresponding entry to zero.\", \"Enable untied, unsynchronized iostreams.\"]}, \"mean_seconds\": 0.049254294795294605, \"diff\": \"diff --git a/src/solution.cpp b/src/solution.cpp\\nindex a92269b..d133e6e 100644\\n--- a/src/solution.cpp\\n+++ b/src/solution.cpp\\n@@ -3,40 +3,34 @@\\n \\n using namespace std;\\n \\n-const int MOD = 1000000007; //since the answer may grow a lot, we use the modulus\\n-\\n+const int MOD = 1000000007;\\n \\n int main() {\\n-\\tint n,m;\\n-\\tcin >> n >> m;\\n-\\tvector<vector<bool> >  blockedCells(n, vector<bool>(n,false));\\n-\\tfor(int c =0;c<m;c++) {\\n-\\t\\tint i,j;\\n-\\t\\tcin >> i >> j;\\n-\\t\\tblockedCells[i][j] = true;\\t\\t\\n-\\t}\\n-\\n-\\tvector<vector<int> > dp(2,vector<int>(n,0));\\n-\\n-\\tif(!blockedCells[0][0])\\n-\\t\\tdp[0][0] = 1;\\n-\\n-\\tfor(int j=1;j<n;j++) if(!blockedCells[0][j]) dp[0][j] = dp[0][j-1];\\n-\\tdp[1][n-1] = dp[0][n-1];\\n-\\n-\\tfor(int i=1;i<n;i++) {\\n-\\t\\tfor(int j=0;j<n;j++) {\\n-\\t\\t\\tint ans = 0;\\n-\\t\\t\\tif(!blockedCells[i][j]) {\\t\\t\\t\\t\\n-\\t\\t\\t\\tans = dp[0][j];\\n-\\t\\t\\t\\tif(j!=0) ans += dp[1][j-1];\\n-\\t\\t\\t}\\n-\\n-\\t\\t\\tdp[1][j] = ans% MOD;\\n-\\t\\t}\\n-\\t\\tfor(int j=0;j<n;j++) dp[0][j] = dp[1][j];\\n-\\t}\\n-\\n-\\t\\n-\\tcout << dp[1][n-1] << endl;\\n-}\\n\\\\ No newline at end of file\\n+    ios::sync_with_stdio(false);\\n+    cin.tie(nullptr);\\n+\\n+    int n, m;\\n+    cin >> n >> m;\\n+    vector<vector<bool>> blockedCells(n, vector<bool>(n, false));\\n+    for (int c = 0; c < m; c++) {\\n+        int i, j;\\n+        cin >> i >> j;\\n+        blockedCells[i][j] = true;\\n+    }\\n+\\n+    vector<int> dp(n, 0);\\n+    if (!blockedCells[0][0]) dp[0] = 1;\\n+\\n+    for (int i = 0; i < n; i++) {\\n+        for (int j = 0; j < n; j++) {\\n+            if (blockedCells[i][j]) {\\n+                dp[j] = 0;\\n+            } else if (j > 0) {\\n+                dp[j] += dp[j - 1];\\n+                if (dp[j] >= MOD) dp[j] -= MOD;\\n+            }\\n+        }\\n+    }\\n+\\n+    cout << dp[n - 1] << '\\\\n';\\n+}\"}, {\"id\": \"afe73b59da814795\", \"role\": \"A\", \"commit\": \"fb0aa1ef6ae2bcc781589925f1e98eef44bdeb12\", \"transformations\": {\"files\": [\"src/solution.cpp\"], \"retained\": [\"Replaced nested vector<bool> blocked storage with a contiguous row-major vector<unsigned char>.\", \"Converted the two-row recurrence to an in-place single-row DP, using the previous-row value at dp[j] and current-row left value at dp[j-1].\", \"Added fast standard-stream setup and reduced modulo after each addition; all DP values remain in [0, MOD).\"]}, \"mean_seconds\": 0.04979001233975092, \"diff\": \"diff --git a/src/solution.cpp b/src/solution.cpp\\nindex a92269b..c3f786c 100644\\n--- a/src/solution.cpp\\n+++ b/src/solution.cpp\\n@@ -3,40 +3,38 @@\\n \\n using namespace std;\\n \\n-const int MOD = 1000000007; //since the answer may grow a lot, we use the modulus\\n-\\n+const int MOD = 1000000007;\\n \\n int main() {\\n-\\tint n,m;\\n-\\tcin >> n >> m;\\n-\\tvector<vector<bool> >  blockedCells(n, vector<bool>(n,false));\\n-\\tfor(int c =0;c<m;c++) {\\n-\\t\\tint i,j;\\n-\\t\\tcin >> i >> j;\\n-\\t\\tblockedCells[i][j] = true;\\t\\t\\n-\\t}\\n-\\n-\\tvector<vector<int> > dp(2,vector<int>(n,0));\\n-\\n-\\tif(!blockedCells[0][0])\\n-\\t\\tdp[0][0] = 1;\\n-\\n-\\tfor(int j=1;j<n;j++) if(!blockedCells[0][j]) dp[0][j] = dp[0][j-1];\\n-\\tdp[1][n-1] = dp[0][n-1];\\n-\\n-\\tfor(int i=1;i<n;i++) {\\n-\\t\\tfor(int j=0;j<n;j++) {\\n-\\t\\t\\tint ans = 0;\\n-\\t\\t\\tif(!blockedCells[i][j]) {\\t\\t\\t\\t\\n-\\t\\t\\t\\tans = dp[0][j];\\n-\\t\\t\\t\\tif(j!=0) ans += dp[1][j-1];\\n-\\t\\t\\t}\\n-\\n-\\t\\t\\tdp[1][j] = ans% MOD;\\n-\\t\\t}\\n-\\t\\tfor(int j=0;j<n;j++) dp[0][j] = dp[1][j];\\n-\\t}\\n-\\n-\\t\\n-\\tcout << dp[1][n-1] << endl;\\n-}\\n\\\\ No newline at end of file\\n+    ios::sync_with_stdio(false);\\n+    cin.tie(nullptr);\\n+\\n+    int n, m;\\n+    cin >> n >> m;\\n+\\n+    // Each row is contiguous, improving locality over vector<vector<bool>>.\\n+    vector<unsigned char> blocked(static_cast<size_t>(n) * n, 0);\\n+    for (int c = 0; c < m; ++c) {\\n+        int i, j;\\n+        cin >> i >> j;\\n+        blocked[static_cast<size_t>(i) * n + j] = 1;\\n+    }\\n+\\n+    vector<int> dp(n, 0);\\n+    if (!blocked[0]) dp[0] = 1;\\n+\\n+    for (int i = 0; i < n; ++i) {\\n+        const size_t row = static_cast<size_t>(i) * n;\\n+        for (int j = 0; j < n; ++j) {\\n+            if (blocked[row + j]) {\\n+                dp[j] = 0;\\n+            } else if (j > 0) {\\n+                dp[j] += dp[j - 1];\\n+                if (dp[j] >= MOD) dp[j] -= MOD;\\n+            }\\n+        }\\n+    }\\n+\\n+    cout << dp[n - 1] << '\\\\n';\\n+    return 0;\\n+}\"}, {\"id\": \"58963f04be7246cc\", \"role\": \"A\", \"commit\": \"b45348cfd8894655919956cdc5f24b160da71d80\", \"transformati
lumns : blockedColumns) {\\n+        sort(columns.begin(), columns.end());\\n+        columns.erase(unique(columns.begin(), columns.end()), columns.end());\\n+    }\\n+\\n+    vector<int> dp(n, 0);\\n+    if (blockedColumns[0].empty() || blockedColumns[0][0] != 0) {\\n+        dp[0] = 1;\\n+    }\\n+\\n+    for (int y = 0; y < n; ++y) {\\n+        const auto& columns = blockedColumns[y];\\n+        size_t obstacleIndex = 0;\\n+        for (int x = 0; x < n; ++x) {\\n+            while (obstacleIndex < columns.size() && columns[obstacleIndex] < x) {\\n+                ++obstacleIndex;\\n+            }\\n+            if (obstacleIndex < columns.size() && columns[obstacleIndex] == x) {\\n+                ++obstacleIndex;\\n+                dp[x] = 0;\\n+            } else if (y == 0) {\\n+                if (x > 0) dp[x] = dp[x - 1];\\n+            } else if (x > 0) {\\n+                int sum = dp[x] + dp[x - 1];\\n+                if (sum >= MOD) sum -= MOD;\\n+                dp[x] = sum;\\n+            }\\n+        }\\n+    }\\n+\\n+    cout << dp[n - 1] << '\\\\n';\\n+    return 0;\\n+}\"}, {\"id\": \"2e7844fc94054474\", \"role\": \"C\", \"commit\": \"d90df1e94c78c0e679609519e98d44cd20b1afbc\", \"transformations\": {\"files\": [\"src/solution.cpp\"], \"retained\": [\"Replace two-row DP storage and row-copy loop with one in-place vector, preserving blocked-cell resets and modular addition.\", \"Disable iostream synchronization and untie cin to reduce standard-input overhead.\"]}, \"mean_seconds\": 0.0753279651204745, \"diff\": \"diff --git a/src/solution.cpp b/src/solution.cpp\\nindex a92269b..9d9da9f 100644\\n--- a/src/solution.cpp\\n+++ b/src/solution.cpp\\n@@ -3,40 +3,36 @@\\n \\n using namespace std;\\n \\n-const int MOD = 1000000007; //since the answer may grow a lot, we use the modulus\\n-\\n+const int MOD = 1000000007;\\n \\n int main() {\\n-\\tint n,m;\\n-\\tcin >> n >> m;\\n-\\tvector<vector<bool> >  blockedCells(n, vector<bool>(n,false));\\n-\\tfor(int c =0;c<m;c++) {\\n-\\t\\tint i,j;\\n-\\t\\tcin >> i >> j;\\n-\\t\\tblockedCells[i][j] = true;\\t\\t\\n-\\t}\\n-\\n-\\tvector<vector<int> > dp(2,vector<int>(n,0));\\n-\\n-\\tif(!blockedCells[0][0])\\n-\\t\\tdp[0][0] = 1;\\n-\\n-\\tfor(int j=1;j<n;j++) if(!blockedCells[0][j]) dp[0][j] = dp[0][j-1];\\n-\\tdp[1][n-1] = dp[0][n-1];\\n-\\n-\\tfor(int i=1;i<n;i++) {\\n-\\t\\tfor(int j=0;j<n;j++) {\\n-\\t\\t\\tint ans = 0;\\n-\\t\\t\\tif(!blockedCells[i][j]) {\\t\\t\\t\\t\\n-\\t\\t\\t\\tans = dp[0][j];\\n-\\t\\t\\t\\tif(j!=0) ans += dp[1][j-1];\\n-\\t\\t\\t}\\n-\\n-\\t\\t\\tdp[1][j] = ans% MOD;\\n-\\t\\t}\\n-\\t\\tfor(int j=0;j<n;j++) dp[0][j] = dp[1][j];\\n-\\t}\\n-\\n-\\t\\n-\\tcout << dp[1][n-1] << endl;\\n-}\\n\\\\ No newline at end of file\\n+    ios::sync_with_stdio(false);\\n+    cin.tie(nullptr);\\n+\\n+    int n, m;\\n+    cin >> n >> m;\\n+    vector<vector<bool>> blockedCells(n, vector<bool>(n, false));\\n+    for (int c = 0; c < m; c++) {\\n+        int i, j;\\n+        cin >> i >> j;\\n+        blockedCells[i][j] = true;\\n+    }\\n+\\n+    vector<int> dp(n, 0);\\n+    if (!blockedCells[0][0]) dp[0] = 1;\\n+\\n+    for (int i = 0; i < n; i++) {\\n+        for (int j = 0; j < n; j++) {\\n+            if (blockedCells[i][j]) {\\n+                dp[j] = 0;\\n+            } else if (i != 0 || j != 0) {\\n+                int fromAbove = dp[j];\\n+                int fromLeft = (j == 0) ? 0 : dp[j - 1];\\n+                dp[j] = (fromAbove + fromLeft) % MOD;\\n+            }\\n+        }\\n+    }\\n+\\n+    cout << dp[n - 1] << '\\\\n';\\n+    return 0;\\n+}\"}], \"interactions\": [], \"automatic_observations\": {\"baseline\": {\"experiment_id\": \"baseline-e1\", \"outcome\": {\"binary_sha256\": \"dcd7ecc829891dcfbe8713bcd1029ad4fccbfdd61907eca6719ca8b6c3aa9a0b\", \"cache_key\": \"70e9250d7f79f195811e59eae66195ca84e7f338517772dca72b77e4bd2899db\", \"commit\": \"02b22aacc5c9d65547a194fe32eb53b888dce9f3\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-fo
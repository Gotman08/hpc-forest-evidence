        "content": "#include \"knn.h\"\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nstatic inline int find_insertion_position(float d, const float *distances, int count) {\n    int x = 0;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const float32x4_t candidate = vdupq_n_f32(d);\n\n    for (; x <= count - 4; x += 4) {\n        const float32x4_t values = vld1q_f32(distances + x);\n        const uint32x4_t matches = vcltq_f32(candidate, values);\n\n        if (vmaxvq_u32(matches) != 0) {\n            if (vgetq_lane_u32(matches, 0) != 0) return x;\n            if (vgetq_lane_u32(matches, 1) != 0) return x + 1;\n            if (vgetq_lane_u32(matches, 2) != 0) return x + 2;\n            return x + 3;\n        }\n    }\n#endif\n\n    for (; x < count; x++) {\n        if (d < distances[x]) {\n            return x;\n        }\n    }\n\n    return count;\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j, x, y;\n    int filled = 0;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            x = find_insertion_position(d, distances, filled);\n\n            if (x < k) {\n                for (y = k - 1; y > x; y--) {\n                    distances[y] = distances[y - 1];\n                    labels[y] = labels[y - 1];\n                }\n\n                distances[x] = d;\n                labels[x] = g.label;\n\n                if (filled < k) {\n                    filled++;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
        "path": "src/knn.c"
      }
    ],

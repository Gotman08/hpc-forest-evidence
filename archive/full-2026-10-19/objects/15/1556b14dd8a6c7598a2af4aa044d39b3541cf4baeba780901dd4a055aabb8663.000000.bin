"""Only version the G unread-lock proof; never touch an actual worker.lock."""
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
OLD = HERE.parent / "revision-r2"


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


raw_manifest = (OLD / "MANIFESTE-AUDITEUR-NATIF-G-R2.json").read_bytes()
assert sha(raw_manifest) == "4c4b8fd6edab0be6f3f3f607adbb3f9a6f6afba86170bb266f59d757b0c52a45"
manifest = json.loads(raw_manifest)
files = {}
for name, row in manifest["files"].items():
    if not name.endswith(".py") or name.startswith(("test_", "deriver-")):
        continue
    raw = (OLD / name).read_bytes()
    assert sha(raw) == row["sha256"]
    if name == "audit_cache_preservation_r2.py":
        text = raw.decode()
        assert text.count("hpc-forest-primes-r2max-owned-operational-lock-v1") == 1
        text = text.replace("hpc-forest-primes-r2max-owned-operational-lock-v1", "hpc-forest-primes-r2g-owned-unread-operational-lock-v1")
        assert text.count("(value.get('read_errno') == 13)") == 1
        text = text.replace("(value.get('read_errno') == 13)", "(value.get('read_attempted') is False) and (value.get('read_errno') is None)")
        old = "    source_ref = value.get('source_zip_ref')"
        assert text.count(old) == 1
        text = text.replace(old, "    need(type(owner.get('parent_pid')) is int and owner['parent_pid'] >= 0, 'Full five-field owned identity requires its exact parent PID')\n" + old)
        old = "lock.get('bytes_read') is False and (lock.get('sha256') is None)"
        assert text.count(old) == 1
        text = text.replace(old, "lock.get('bytes_read') is False and lock.get('read_attempted') is False and lock.get('read_errno') is None and (lock.get('sha256') is None)")
        raw = text.encode()
    with (HERE / name).open("xb") as stream:
        stream.write(raw)
    files[name] = {"sha256": sha(raw), "r2_sha256": row["sha256"], "byte_identical_to_r2": sha(raw) == row["sha256"]}
value = {"schema": "hpc-forest-r2g-unread-lock-isolated-derivation-v1", "verified": True,
    "scope_of_verified": "Code derivation only; no lock access, native audit or operational closure",
    "r2_manifest_sha256": sha(raw_manifest), "files": files,
    "production_changes": ["Version G unread-lock schema; read_attempted false/read_errno null instead of invented errno13",
        "Require parent_pid as fifth owned identity field", "Require both full metadata inventories to retain unread/never-attempted lock flags"],
    "source_path_identity_source_SHA_before_null_and_real_post_stop_copy_checks_preserved": True,
    "post_stop_scientific_audit_requirement_not_relaxed": True, "native_research_admitted": False}
with (HERE / "DERIVATION-VERROU-NON-LU.json").open("x", encoding="utf8") as stream:
    stream.write(json.dumps(value, indent=2) + "\n")
print(json.dumps({"components": len(files), "changed": [n for n,r in files.items() if not r['byte_identical_to_r2']]}))

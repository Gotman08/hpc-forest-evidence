#include<stdio.h>
#include<stdlib.h>
#include<math.h>
#if defined(__aarch64__) && defined(__ARM_NEON)
#include<arm_neon.h>
#endif

static int compare_exchange_phase(double *matriz, int tam, int start) {
    int j = start;
    int swapped = 0;

#if defined(__aarch64__) && defined(__ARM_NEON)
    uint64x2_t changes = vdupq_n_u64(0);
    for (; j <= tam - 4; j += 4) {
        float64x2x2_t values = vld2q_f64(matriz + j);
        uint64x2_t exchange = vcgtq_f64(values.val[0], values.val[1]);
        float64x2x2_t ordered;

        /* Select original bits: equal values and NaNs must not exchange. */
        ordered.val[0] = vbslq_f64(exchange, values.val[1], values.val[0]);
        ordered.val[1] = vbslq_f64(exchange, values.val[0], values.val[1]);
        vst2q_f64(matriz + j, ordered);
        changes = vorrq_u64(changes, exchange);
    }
    swapped = (vgetq_lane_u64(changes, 0) |
               vgetq_lane_u64(changes, 1)) != 0;
#endif

    for (; j < tam - 1; j += 2) {
        double left = matriz[j];
        double right = matriz[j + 1];
        int exchange = left > right;
        matriz[j] = exchange ? right : left;
        matriz[j + 1] = exchange ? left : right;
        swapped |= exchange;
    }
    return swapped;
}

void bubble_sort (double *matriz, int tam) {
    int pass;
    int changed = 0;

    if (tam < 2)
        return;

    /* Disjoint adjacent pairs allow SIMD without a carried maximum. */
    for (pass = 0; pass < tam; pass++) {
        if ((pass & 1) == 0)
            changed = 0;
        changed |= compare_exchange_phase(matriz, tam, pass & 1);

        /* Both parities must be unchanged before terminating early. */
        if ((pass & 1) != 0 && !changed)
            break;
    }
}

void ordena_colunas(double *matriz,int lin, int col) {
    int i;
    
    for (i = 0; i < col; i++) {    
        //manda o endereco do primeiro elemento da coluna, limites inf e sup e a largura da matriz
        bubble_sort(&matriz[i*lin], lin);
    }
} 

void calcula_media(double *matriz, double *vet,int lin, int col){
    int i,j;
    double soma;
    for(i=0;i<col;i++){
        soma=0;
        for(j=0;j<lin;j++){
            soma+=matriz[i*lin+j];
        }
        vet[i]=soma/lin; 
    }   
}

void calcula_media_harmonica(double *matriz, double *vet,int lin, int col){
    int i,j;
    double soma;
    for(i=0;i<col;i++){
        soma=0;
        for(j=0;j<lin;j++){
            soma+=(1/(matriz[i*lin+j]));
        }
        vet[i]=lin/soma; 
    }   
}

void calcula_mediana(double *matriz, double *vet, int lin, int col) {  
     int i=0;
     if((lin-1)%2){ //Quantidade par de elementos
         for (i = 0; i < col; i++) {
            vet[i]=(matriz[(((i*lin)+(i+1)*lin)-1)/2]+matriz[((((i*lin)+(i+1)*lin)-1)/2)+1]);
            vet[i]*=0.5;
            
         }
     }
     else{ //Quantidade ímpar de elementos
         for (i = 0; i < col; i++) {
            vet[i]=matriz[(((i*lin)+(i+1)*lin)-1)/2];
         }
     }
    
 } 

static int count_equal_values(const double *values, int count, double value) {
    int j = 0;
    int matches = 0;

#if defined(__aarch64__) && defined(__ARM_NEON)
    float64x2_t key = vdupq_n_f64(value);
    uint64x2_t counts0 = vdupq_n_u64(0);
    uint64x2_t counts1 = vdupq_n_u64(0);
    uint64x2_t total;

    /* Subtract all-ones equality masks to count matches exactly. */
    for (; j <= count - 4; j += 4) {
        uint64x2_t equal0 = vceqq_f64(vld1q_f64(values + j), key);
        uint64x2_t equal1 = vceqq_f64(vld1q_f64(values + j + 2), key);
        counts0 = vsubq_u64(counts0, equal0);
        counts1 = vsubq_u64(counts1, equal1);
    }
    if (j <= count - 2) {
        counts0 = vsubq_u64(counts0,
                           vceqq_f64(vld1q_f64(values + j), key));
        j += 2;
    }
    total = vaddq_u64(counts0, counts1);
    matches = (int)(vgetq_lane_u64(total, 0) +
                    vgetq_lane_u64(total, 1));
#endif

    for (; j < count; j++) {
        matches += values[j] == value;
    }
    return matches;
}

//Adaptado de https://www.clubedohardware.com.br/forums/topic/1291570-programa-em-c-que-calcula-moda-media-e-mediana/
double moda_aux(double *matriz,int lin){
    int i;
    float conta=0, moda=0;

    for(i=0;i<lin;i++){
        int matches = count_equal_values(matriz + i + 1,
                                         lin - i - 1, matriz[i]);

        /* Preserve the promoted-float threshold and float mode conversion. */
        if((double)matches > (double)conta){
            conta=(float)matches;
            moda=(float)matriz[i];
        }
    }
    if(conta == 0){
        return -1;
    }
    else{
        return moda;
    }
}

void calcula_moda(double *matriz,double *moda,int lin, int col){
    int i;
    for(i=0;i<col;i++){
        moda[i]=moda_aux(matriz+(i*lin),lin);
    }
}

void calcula_variancia(double *matriz, double *media,double *variancia, int lin, int col){
    int i,j;
    double soma;
    for(i=0;i<col;i++){
        soma=0;
        for(j=0;j<lin;j++){
            soma+=pow((matriz[i*lin+j]-media[i]),2);
        }
        variancia[i]=soma/(lin-1); 
    } 
}

void calcula_desvio_padrao(double *variancia,double *dp, int col){
    int i;
    for(i=0;i<col;i++){
        dp[i]=sqrt(variancia[i]);
    }  
}

void calcula_coeficiente_variacao(double *media,double *dp,double *cv, int col){
    int i;
    for(i=0;i<col;i++){
        cv[i]=dp[i]/media[i];
    }  
}

int main(int argc,char **argv){
    int lin,col,i,j; // Define as variáveis de índices e dimensões
    double *matriz,*mediana,*media,*media_har,*moda,*variancia,*dp,*cv; // Define a matriz (forma linear), vetores de medidas estatísticas

    fscanf(stdin, "%d ", &lin); // Lê a quantidade de linhas da matriz
    fscanf(stdin, "%d\n", &col); // Lê a quantidade de colunas da matriz
    
    // Alocações
    matriz=(double *)malloc(lin*col * sizeof(double)); // Aloca a matriz
    media=(double *)malloc(col * sizeof(double)); // Aloca o vetor de media
    media_har=(double *)malloc(col * sizeof(double)); // Aloca o vetor de media harmônica
    mediana=(double *)malloc(col * sizeof(double)); // Aloca o vetor de mediana
    moda=(double *)malloc(col * sizeof(double)); // Aloca o vetor de moda
    variancia=(double *)malloc(col * sizeof(double)); // Aloca o vetor de variância
    cv=(double *)malloc(col * sizeof(double)); // Aloca o vetor de coeficiente de variação
    dp=(double *)malloc(col * sizeof(double)); // Aloca o vetor de desvio padrão

 
    for(i=0;i<lin;i++){
        for(j=0;j<col;j++){
            fscanf(stdin, "%lf ",&(matriz[j*lin+i])); // Lê os dados transpostos em uma matriz de entrada
        }
    }

    calcula_media(matriz,media,lin,col);
    calcula_media_harmonica(matriz,media_har,lin,col);
    ordena_colunas(matriz,lin,col);
    calcula_mediana(matriz,mediana,lin,col);
    calcula_moda(matriz,moda,lin,col);
    calcula_variancia(matriz,media,variancia,lin,col);
    calcula_desvio_padrao(variancia,dp,col);
    calcula_coeficiente_variacao(media,dp,cv,col);

    for(i=0;i<col;i++)
        printf("%.1lf ",media[i]); // Imprime as médias aritméticas de cada coluna
    printf("\n");
    for(i=0;i<col;i++)
        printf("%.1lf ",media_har[i]); // Imprime as médias harmônicas de cada coluna
    printf("\n");
    for(i=0;i<col;i++)
        printf("%.1lf ",mediana[i]); // Imprime as medianas de cada coluna
    printf("\n");
    for(i=0;i<col;i++)
        printf("%.1lf ",moda[i]); // Imprime as modas de cada coluna
    printf("\n");
    for(i=0;i<col;i++)
        printf("%.1lf ",variancia[i]); // Imprime as variâncias amostrais de cada coluna
    printf("\n");
    for(i=0;i<col;i++)
        printf("%.1lf ",dp[i]); // Imprime os desvios padrão de cada coluna
    printf("\n");
    for(i=0;i<col;i++)
        printf("%.1lf ",cv[i]); // Imprime os coeficientes de variação de cada coluna
    printf("\n");

    // Desaloca memória
    free(matriz);
    free(media);
    free(media_har);
    free(mediana);
    free(moda);
    free(variancia);
    free(dp);
    free(cv);
}

        "content": "#include \"knn.h\"\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\ntypedef struct {\n    float distance;\n    char label;\n    size_t ordinal;\n} Neighbor;\n\nstatic char serial_knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *) malloc(sizeof(char) * k);\n    float *distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n\n                    distances[x] = d;\n                    labels[x] = g.label;\n\n                    break;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\n#ifdef _OPENMP\nstatic int compare_neighbors(const void *left, const void *right) {\n    const Neighbor *a = (const Neighbor *) left;\n    const Neighbor *b = (const Neighbor *) right;\n\n    if (a->distance < b->distance) return -1;\n    if (a->distance > b->distance) return 1;\n    if (a->ordinal < b->ordinal) return -1;\n    if (a->ordinal > b->ordinal) return 1;\n    return 0;\n}\n\nstatic void insert_local_neighbor(Neighbor *neighbors, int *count, int k, Neighbor candidate) {\n    int position = 0;\n\n    while (position < *count) {\n        if (candidate.distance < neighbors[position].distance ||\n            (candidate.distance == neighbors[position].distance &&\n             candidate.ordinal < neighbors[position].ordinal)) {\n            break;\n        }\n        position++;\n    }\n\n    if (*count == k && position == k) return;\n\n    int last = *count < k ? *count : k - 1;\n    for (int i = last; i > position; i--) {\n        neighbors[i] = neighbors[i - 1];\n    }\n    neighbors[position] = candidate;\n\n    if (*count < k) (*count)++;\n}\n#endif\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n#ifndef _OPENMP\n    return serial_knn(n_groups, groups, k, to_evaluate);\n#else\n    if (k <= 0 || n_groups <= 0) return serial_knn(n_groups, groups, k, to_evaluate);\n\n    int max_threads = omp_get_max_threads();\n    if (max_threads <= 0 || (size_t) k > (size_t) -1 / (size_t) max_threads) {\n        return serial_knn(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t worker_slots = (size_t) max_threads * (size_t) k;\n    if (worker_slots > (size_t) -1 / sizeof(Neighbor) ||\n        (size_t) n_groups > (size_t) -1 / sizeof(size_t)) {\n        return serial_knn(n_groups, groups, k, to_evaluate);\n    }\n\n    Neighbor *local_neighbors = (Neighbor *) malloc(worker_slots * sizeof(Neighbor));\n    int *local_counts = (int *) calloc((size_t) max_threads, sizeof(int));\n    size_t *offsets = (size_t *) malloc((size_t) n_groups * sizeof(size_t));\n\n    if (local_neighbors == NULL || local_counts == NULL || offsets == NULL) {\n        free(local_neighbors);\n        free(local_counts);\n        free(offsets);\n        return serial_knn(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t total_points = 0;\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length < 0 || (size_t) groups[i].length > (size_t) -1 - total_points) {\n            free(local_neighbors);\n            free(local_counts);\n            free(offsets);\n            return serial_knn(n_groups, groups, k, to_evaluate);\n        }\n        offsets[i] = total_points;\n        total_points += (size_t) groups[i].length;\n    }\n\n    int has_nan = 0;\n\n#pragma omp parallel reduction(| : has_nan)\n    {\n        int thread_id = omp_get_thread_num();\n        int thread_count = omp_get_num_threads();\n        size_t first = total_points * (size_t) thread_id / (size_t) thread_count;\n        size_t last = total_points * (size_t) (thread_id + 1) / (size_t) thread_count;\n        Neighbor *neighbors = local_neighbors + (size_t) thread_id * (size_t) k;\n        int count = 0;\n        int group_index = 0;\n        size_t ordinal = first;\n\n        while (group_index < n_groups &&\n               first >= offsets[group_index] + (size_t) groups[group_index].length) {\n            group_index++;\n        }\n\n        while (ordinal < last && group_index < n_groups) {\n            Group group = groups[group_index];\n            size_t group_end = offsets[group_index] + (size_t) group.length;\n            size_t end = group_end < last ? group_end : last;\n\n            while (ordinal < end) {\n                float distance = euclidean_distance_no_sqrt(\n                    to_evaluate, group.points[ordinal - offsets[group_index]]);\n                Neighbor candidate;\n\n                if (distance != distance) has_nan = 1;\n\n                candidate.distance = distance;\n                candidate.label = group.label;\n                candidate.ordinal = ordinal;\n                insert_local_neighbor(neighbors, &count, k, candidate);\n                ordinal++;\n            }\n            group_index++;\n        }\n\n        local_counts[thread_id] = count;\n    }\n\n    if (has_nan) {\n        free(local_neighbors);\n        free(local_counts);\n        free(offsets);\n        return serial_knn(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t candidate_count = 0;\n    for (int i = 0; i < max_threads; i++) {\n        size_t count = (size_t) local_counts[i];\n        memmove(local_neighbors + candidate_count,\n                local_neighbors + (size_t) i * (size_t) k,\n                count * sizeof(Neighbor));\n        candidate_count += count;\n    }\n\n    qsort(local_neighbors, candidate_count, sizeof(Neighbor), compare_neighbors);\n\n    char *labels = (char *) malloc(sizeof(char) * (size_t) k);\n    if (labels == NULL) {\n        free(local_neighbors);\n        free(local_counts);\n        free(offsets);\n        return serial_knn(n_groups, groups, k, to_evaluate);\n    }\n\n    for (int i = 0; i < k; i++) labels[i] = -1;\n    int selected = candidate_count < (size_t) k ? (int) candidate_count : k;\n    for (int i = 0; i < selected; i++) labels[i] = local_neighbors[i].label;\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(labels);\n    free(local_neighbors);\n    free(local_counts);\n    free(offsets);\n    return most_frequent;\n#endif\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
        "path": "src/knn.c"
      }

to expose independent\\n                // sqrt/division computations for SIMD while keeping the\\n                // exact per-body accumulation order (j ascending).\\n                for (; j + 3 < nbodies; j += 4) {\\n                    float dx0 = px[j]   - xi;\\n                    float dy0 = py[j]   - yi;\\n                    float dz0 = pz[j]   - zi;\\n                    float sqrd0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\\n                    float inv0 = 1.0f / sqrt(sqrd0);\\n                    float inv3_0 = inv0 * inv0 * inv0;\\n                    fx += dx0 * inv3_0;\\n                    fy += dy0 * inv3_0;\\n                    fz += dz0 * inv3_0;\\n\\n                    float dx1 = px[j+1] - xi;\\n                    float dy1 = py[j+1] - yi;\\n                    float dz1 = pz[j+1] - zi;\\n                    float sqrd1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\\n                    float inv1 = 1.0f / sqrt(sqrd1);\\n                    float inv3_1 = inv1 * inv1 * inv1;\\n                    fx += dx1 * inv3_1;\\n                    fy += dy1 * inv3_1;\\n                    fz += dz1 * inv3_1;\\n\\n                    float dx2 = px[j+2] - xi;\\n                    float dy2 = py[j+2] - yi;\\n                    float dz2 = pz[j+2] - zi;\\n                    float sqrd2 = dx2*dx2 + dy2*dy2 + dz2*dz2 + SOFTENING;\\n                    float inv2 = 1.0f / sqrt(sqrd2);\\n                    float inv3_2 = inv2 * inv2 * inv2;\\n                    fx += dx2 * inv3_2;\\n                    fy += dy2 * inv3_2;\\n                    fz += dz2 * inv3_2;\\n\\n                    float dx3 = px[j+3] - xi;\\n                    float dy3 = py[j+3] - yi;\\n                    float dz3 = pz[j+3] - zi;\\n                    float sqrd3 = dx3*dx3 + dy3*dy3 + dz3*dz3 + SOFTENING;\\n                    float inv3_3 = 1.0f / sqrt(sqrd3);\\n                    float inv3_3b = inv3_3 * inv3_3 * inv3_3;\\n                    fx += dx3 * inv3_3b;\\n                    fy += dy3 * inv3_3b;\\n                    fz += dz3 * inv3_3b;\\n                }\\n                for (; j < nbodies; ++j) {\\n                    float dx = px[j] - xi;\\n                    float dy = py[j] - yi;\\n                    float dz = pz[j] - zi;\\n                    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n                    float inv_dist = 1.0f / sqrt(sqrd_dist);\\n                    float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n                    fx += dx * inv_dist3;\\n                    fy += dy * inv_dist3;\\n                    fz += dz * inv_dist3;\\n                }\\n                vx[i] += DT*fx;\\n                vy[i] += DT*fy;\\n                vz[i] += DT*fz;\\n            }\\n\\n            #pragma omp for simd schedule(static) aligned(px,py,pz,vx,vy,vz:64)\\n            for (int i = 0; i < nbodies; ++i) {\\n                px[i] += vx[i] * DT;\\n                py[i] += vy[i] * DT;\\n                pz[i] += vz[i] * DT;\\n            }\\n        }\\n    }\\n\\n    float *out = (float *)malloc(count * sizeof(float));\\n    if (!out) { perror(\\\"malloc\\\"); exit(EXIT_FAILURE); }\\n    for (int i = 0; i < nbodies; ++i) {\\n        out[6*i]   = px[i];\\n        out[6*i+1] = py[i];\\n        out[6*i+2] = pz[i];\\n        out[6*i+3] = vx[i];\\n        out[6*i+4] = vy[i];\\n        out[6*i+5] = vz[i];\\n    }\\n    if (fwrite(out, count * sizeof(float), 1, stdout) != 1) {\\n        fprintf(stderr, \\\"\\\\nError writing to output\\\\n\\\");\\n        exit(EXIT_FAILURE);\\n    }\\n\\n    free(px); free(py); free(pz); free(vx); free(vy); free(vz); free(out);\\n    return EXIT_SUCCESS;\\n}\\n\",\n      \"path\": \"src/nbody.c\"\n    }\n  ],\n  \"hypothesis\": \"Adding explicit static scheduling and aligned memory allocation (64-byte) with alignment hints on the OpenMP SIMD loops reduces dynamic scheduling overhead and enables NEON to use aligned vector loads/stores, improving throughput without changi
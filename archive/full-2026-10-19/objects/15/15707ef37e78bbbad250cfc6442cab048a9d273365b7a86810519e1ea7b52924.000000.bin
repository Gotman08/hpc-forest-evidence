dx0 = px[j]   - xi;\n                    float dy0 = py[j]   - yi;\n                    float dz0 = pz[j]   - zi;\n                    float sqrd0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\n                    float inv0 = 1.0f / sqrt(sqrd0);\n                    float inv3_0 = inv0 * inv0 * inv0;\n                    fx += dx0 * inv3_0;\n                    fy += dy0 * inv3_0;\n                    fz += dz0 * inv3_0;\n\n                    float dx1 = px[j+1] - xi;\n                    float dy1 = py[j+1] - yi;\n                    float dz1 = pz[j+1] - zi;\n                    float sqrd1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\n                    float inv1 = 1.0f / sqrt(sqrd1);\n                    float inv3_1 = inv1 * inv1 * inv1;\n                    fx += dx1 * inv3_1;\n                    fy += dy1 * inv3_1;\n                    fz += dz1 * inv3_1;\n\n                    float dx2 = px[j+2] - xi;\n                    float dy2 = py[j+2] - yi;\n                    float dz2 = pz[j+2] - zi;\n                    float sqrd2 = dx2*dx2 + dy2*dy2 + dz2*dz2 + SOFTENING;\n                    float inv2 = 1.0f / sqrt(sqrd2);\n                    float inv3_2 = inv2 * inv2 * inv2;\n                    fx += dx2 * inv3_2;\n                    fy += dy2 * inv3_2;\n                    fz += dz2 * inv3_2;\n\n                    float dx3 = px[j+3] - xi;\n                    float dy3 = py[j+3] - yi;\n                    float dz3 = pz[j+3] - zi;\n                    float sqrd3 = dx3*dx3 + dy3*dy3 + dz3*dz3 + SOFTENING;\n                    float inv3_3 = 1.0f / sqrt(sqrd3);\n                    float inv3_3b = inv3_3 * inv3_3 * inv3_3;\n                    fx += dx3 * inv3_3b;\n                    fy += dy3 * inv3_3b;\n                    fz += dz3 * inv3_3b;\n                }\n                for (; j < nbodies; ++j) {\n                    float dx = px[j] - xi;\n                    float dy = py[j] - yi;\n                    float dz = pz[j] - zi;\n             
#include <iostream>
#include <vector>
#include <cstdio>
#include <algorithm>

int main() {
    int n, s;
    std::cin >> n >> s;

    // Flatten matrix into a single vector for better spatial locality
    std::vector<int> mat(n * n);
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            scanf("%d", &mat[i * n + j]);
        }
    }

    // Integral image (summed-area table) with long long to avoid overflow
    int stride = n + 1;
    std::vector<long long> pref(stride * stride, 0);

    for (int i = 0; i < n; ++i) {
        long long row_sum = 0;
        for (int j = 0; j < n; ++j) {
            row_sum += mat[i * n + j];
            pref[(i + 1) * stride + (j + 1)] =
                pref[i * stride + (j + 1)] + row_sum;
        }
    }

    // Find maximum SxS submatrix sum using O(1) queries
    long long mxSum = -(1LL << 60);
    for (int i = 0; i <= n - s; ++i) {
        for (int j = 0; j <= n - s; ++j) {
            long long sum =
                pref[(i + s) * stride + (j + s)] -
                pref[i * stride + (j + s)] -
                pref[(i + s) * stride + j] +
                pref[i * stride + j];
            if (sum > mxSum) mxSum = sum;
        }
    }

    printf("%lld\n", mxSum);
    return 0;
}

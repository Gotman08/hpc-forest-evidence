      "content": "#include \"knn.h\"\n#include <float.h>\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\n#define KNN_RADIX 256\n\ntypedef struct {\n    size_t bins[KNN_RADIX];\n    size_t votes[KNN_RADIX];\n    size_t take;\n    int unordered;\n    unsigned char padding[64];\n} KnnRadixThread;\n\nstatic char knn_serial(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nstatic char knn_mode(const size_t * frequencies) {\n    char winner = (char) -1;\n    size_t best_count = 0;\n    for (unsigned int i = 0; i < KNN_RADIX; i++) {\n        char label = (char) (unsigned char) i;\n        size_t count = frequencies[i];\n        if (count != 0 &&\n            (count > best_count || (count == best_count && label < winner))) {\n            winner = label;\n            best_count = count;\n        }\n    }\n    return winner;\n}\n\nstatic uint32_t knn_distance_key(float distance) {\n    uint32_t key;\n    memcpy(&key, &distance, sizeof(key));\n    return key & UINT32_C(0x7fffffff);\n}\n\nstatic unsigned int knn_choose_digit(const KnnRadixThread * partials,\n                                    int n_threads, size_t * rank) {\n    for (unsigned int digit = 0; digit < KNN_RADIX; digit++) {\n        size_t count = 0;\n        for (int t = 0; t < n_threads; t++) {\n            count += partials[t].bins[digit];\n        }\n        if (*rank <= count) {\n            return digit;\n        }\n        *rank -= count;\n    }\n    return KNN_RADIX - 1;\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    if (k <= 0 || CHAR_BIT != 8 || sizeof(float) != sizeof(uint32_t) ||\n        FLT_RADIX != 2 || FLT_MANT_DIG != 24 || FLT_MAX_EXP != 128) {\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t total = 0;\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length < 0 ||\n            (size_t) groups[i].length > SIZE_MAX - total) {\n            return knn_serial(n_groups, groups, k, to_evaluate);\n        }\n        total += (size_t) groups[i].length;\n    }\n\n    if ((size_t) k >= total) {\n        size_t frequencies[KNN_RADIX] = {0};\n        frequencies[(unsigned char) (char) -1] = (size_t) k - total;\n        for (int i = 0; i < n_groups; i++) {\n            frequencies[(unsigned char) groups[i].label] +=\n                (size_t) groups[i].length;\n        }\n        return knn_mode(frequencies);\n    }\n\n    if (total > SIZE_MAX / sizeof(uint64_t)) {\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    int workers = 1;\n#ifdef _OPENMP\n    workers = omp_get_max_threads();\n#endif\n    if (workers < 1) workers = 1;\n    size_t useful_workers = total / 16384;\n    if (useful_workers == 0) useful_workers = 1;\n    if ((size_t) workers > useful_workers) workers = (int) useful_workers;\n    if ((size_t) workers > SIZE_MAX / sizeof(KnnRadixThread)) {\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    uint64_t * candidates = (uint64_t *) malloc(total * sizeof(uint64_t));\n    KnnRadixThread * partials = (KnnRadixThread *)\n        malloc((size_t) workers * sizeof(KnnRadixThread));\n    if (candidates == NULL || partials == NULL) {\n        free(candidates);\n        free(partials);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t rank = (size_t) k;\n    unsigned int selected = 0;\n    int used_threads = 1;\n    int unordered = 0;\n\n#pragma omp parallel if(workers > 1) num_threads(workers)\n    {\n        int tid = 0;\n        int team = 1;\n#ifdef _OPENMP\n        tid = omp_get_thread_num();\n        team = omp_get_num_threads();\n#endif\n        KnnRadixThread * local = &partials[tid];\n        memset(local->bins, 0, sizeof(local->bins));\n        memset(local->votes, 0, sizeof(local->votes));\n        local->take = 0;\n        local->unordered = 0;\n\n        size_t per_thread = total / (size_t) team;\n        size_t extra = total % (size_t) team;\n        size_t t = (size_t) tid;\n        size_t begin = per_thread * t + (t < extra ? t : extra);\n        size_t end = begin + per_thread + (t < extra ? 1 : 0);\n\n        size_t skip = begin;\n        int group_index = 0;\n        while (group_index < n_groups &&\n               skip >= (size_t) groups[group_index].length) {\n            skip -= (size_t) groups[group_index].length;\n            group_index++;\n        }\n\n        size_t position = begin;\n        while (position < end) {\n            Group * g = &groups[group_index];\n            size_t count = (size_t) g->length - skip;\n            if (count > end - position) count = end - position;\n            for (size_t j = 0; j < count; j++) {\n                float distance = euclidean_distance_no_sqrt(\n                    to_evaluate, g->points[skip + j]);\n                uint32_t key = knn_distance_key(distance);\n                if (key > UINT32_C(0x7f800000)) local->unordered = 1;\n                candidates[position++] = ((uint64_t) key << 32) |\n                    (uint64_t) (unsigned char) g->label;\n                local->bins[key >> 24]++;\n            }\n            skip = 0;\n            group_index++;\n        }\n        size_t active = end - begin;\n\n#pragma omp barrier\n#pragma omp single\n        {\n            used_threads = team;\n            for (int p = 0; p < team; p++) {\n                unordered |= partials[p].unordered;\n            }\n            if (!unordered) {\n                selected = knn_choose_digit(partials, team, &rank);\n            }\n        }\n\n        if (!unordered) {\n            for (int shift = 24; shift > 0; shift -= 8) {\n                memset(local->bins, 0, sizeof(local->bins));\n                size_t write = begin;\n                size_t stop = begin + active;\n                for (size_t read = begin; read < stop; read++) {\n                    uint64_t candidate = candidates[read];\n                    uint32_t key = (uint32_t) (candidate >> 32);\n                    unsigned int digit = (key >> shift) & 255U;\n                    if (digit < selected) {\n                        local->votes[(unsigned char) candidate]++;\n                    } else if (digit == selected) {\n                        /* Stable compaction preserves input-order ties. */\n                        candidates[write++] = candidate;\n                        local->bins[(key >> (shift - 8)) & 255U]++;\n                    }\n                }\n                active = write - begin;\n\n#pragma omp barrier\n#pragma omp single\n                {\n                    selected = knn_choose_digit(partials, team, &rank);\n                    if (shift == 8) {\n                        size_t left = rank;\n                        for (int p = 0; p < team; p++) {\n                            size_t available = partials[p].bins[selected];\n                            size_t take = available < left ? available : left;\n                            partials[p].take = take;\n                            left -= take;\n                        }\n                    }\n                }\n            }\n\n            size_t take = local->take;\n            for (size_t read = begin; read < begin + active; read++) {\n                uint64_t candidate = candidates[read];\n                unsigned int digit = (unsigned int) ((candidate >> 32) & 255U);\n                if (digit < selected) {\n                    local->votes[(unsigned char) candidate]++;\n                } else if (digit == selected && take != 0) {\n                    local->votes[(unsigned char) candidate]++;\n                    take--;\n                }\n            }\n        }\n    }\n\n    if (unordered) {\n        free(partials);\n        free(candidates);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t frequencies[KNN_RADIX] = {0};\n    for (int t = 0; t < used_threads; t++) {\n        for (unsigned int label = 0; label < KNN_RADIX; label++) {\n            frequencies[label] += partials[t].votes[label];\n        }\n    }\n    char result = knn_mode(frequencies);\n    free(partials);\n    free(candidates);\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }

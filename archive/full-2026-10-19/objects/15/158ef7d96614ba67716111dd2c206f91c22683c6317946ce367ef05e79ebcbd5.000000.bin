      "content": "#ifndef KNN_H\n#define KNN_H\n\n#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point *points;\n} Group;\n\nchar knn(const float *xs, const float *ys, const char *labels,\n         long n_points, int k, Point q);\n\n#endif\n",
      "path": "src/knn.h"
    },
    {
      "content": "#include \"knn.h\"\n#include <ctype.h>\n#include <string.h>\n\nstatic void fail(void) {\n    fprintf(stderr, \"Invalid input file.\\n\");\n    exit(1);\n}\n\nstatic const char *input_ptr;\n\nstatic void skip_ws(void) {\n    while (*input_ptr == ' ' || *input_ptr == '\\n' ||\n           *input_ptr == '\\r' || *input_ptr == '\\t')\n        input_ptr++;\n}\n\nstatic void expect(const char *s) {\n    skip_ws();\n    while (*s) {\n        if (*input_ptr != *s)\n            fail();\n        input_ptr++;\n        s++;\n    }\n}\n\nstatic int parse_int(void) {\n    skip_ws();\n    int sign = 1;\n    if (*input_ptr == '-') {\n        sign = -1;\n        input_ptr++;\n    }\n    long v = 0;\n    while (*input_ptr >= '0' && *input_ptr <= '9') {\n        v = v * 10 + (*input_ptr - '0');\n        input_ptr++;\n    }\n    return (int)(sign * v);\n}\n\nstatic float parse_float(void) {\n    skip_ws();\n    char *end;\n    float v = strtof(input_ptr, &end);\n    if (end == input_ptr)\n        fail();\n    input_ptr = end;\n    return v;\n}\n\nstatic char *read_all_input(void) {\n    size_t cap = 1 << 20;\n    size_t len = 0;\n    char *buf = (char *)malloc(cap);\n    if (!buf)\n        fail();\n\n    for (;;) {\n        if (len == cap) {\n            cap *= 2;\n            char *nb = (char *)realloc(buf, cap);\n            if (!nb) {\n                free(buf);\n                fail();\n            }\n            buf = nb;\n        }\n        size_t n = fread(buf + len, 1, cap - len, stdin);\n        len += n;\n        if (n == 0)\n            break;\n    }\n\n    char *nb = (char *)realloc(buf, len + 1);\n    if (!nb) {\n        free(buf);\n        fail();\n    }\n    buf = nb;\n    buf[len] = '\\0';\n    return buf;\n}\n\nstatic void grow_arrays(long need, float **xs, float **ys,\n                        char **labels, long *cap) {\n    if (need <= *cap)\n        return;\n    long nc = (*cap == 0) ? (1 << 16) : *cap;\n    while (nc < need)\n        nc *= 2;\n\n    float *nx = (float *)realloc(*xs, (size_t)nc * sizeof(float));\n    if (!nx) fail();\n    *xs = nx;\n\n    float *ny = (float *)realloc(*ys, (size_t)nc * sizeof(float));\n    if (!ny) fail();\n    *ys = ny;\n\n    char *nl = (char *)realloc(*labels, (size_t)nc * sizeof(char));\n    if (!nl) fail();\n    *labels = nl;\n\n    *cap = nc;\n}\n\nstatic int compare_for_sort(const void *a, const void *b) {\n    return *(const char *)a - *(const char *)b;\n}\n\nchar knn(const float *xs, const float *ys, const char *labels,\n         long n_points, int k, Point q) {\n    if (k <= 0 || n_points <= 0)\n        return '\\0';\n\n    float *dist = (float *)malloc((size_t)k * sizeof(float));\n    char *lab = (char *)malloc((size_t)k * sizeof(char));\n    if (!dist || !lab) {\n        free(dist);\n        free(lab);\n        fail();\n    }\n\n    for (int i = 0; i < k; ++i) {\n        dist[i] = -1.0f;\n        lab[i] = (char)-1;\n    }\n\n    const float qx = q.x;\n    const float qy = q.y;\n\n    for (long idx = 0; idx < n_points; ++idx) {\n        float dx = xs[idx] - qx;\n        float dy = ys[idx] - qy;\n        float d = dx * dx + dy * dy;\n\n        if (dist[k - 1] != -1.0f && d >= dist[k - 1])\n            continue;\n\n        int pos = 0;\n        while (pos < k) {\n            if (d < dist[pos] || dist[pos] == -1.0f)\n                break;\n            ++pos;\n        }\n        if (pos == k)\n            continue;\n\n        for (int y = k - 1; y > pos; --y) {\n            dist[y] = dist[y - 1];\n            lab[y] = lab[y - 1];\n        }\n        dist[pos] = d;\n        lab[pos] = labels[idx];\n    }\n\n    qsort(lab, (size_t)k, sizeof(char), compare_for_sort);\n\n    char best_label = lab[0];\n    int best_count = 1;\n    int cur_count = 1;\n\n    for (int i = 1; i < k; ++i) {\n        if (lab[i] == lab[i - 1]) {\n            ++cur_count;\n        } else {\n            if (cur_count > best_count) {\n                best_count = cur_count;\n                best_label = lab[i - 1];\n            }\n            cur_count = 1;\n        }\n    }\n    if (cur_count > best_count)\n        best_label = lab[k - 1];\n\n    free(dist);\n    free(lab);\n    return best_label;\n}\n\nint main(void) {\n    char *input = read_all_input();\n    input_ptr = input;\n\n    expect(\"n_groups=\");\n    int n_groups = parse_int();\n\n    long cap = 0;\n    long total = 0;\n    float *xs = NULL;\n    float *ys = NULL;\n    char *labels = NULL;\n\n    for (int g = 0; g < n_groups; ++g) {\n        expect(\"label=\");\n        char label = *input_ptr++;\n        expect(\"length=\");\n        int length = parse_int();\n\n        if (total + length > cap)\n            grow_arrays(total + length, &xs, &ys, &labels, &cap);\n\n        for (int j = 0; j < length; ++j) {\n            expect(\"(\");\n            float x = parse_float();\n            expect(\",\");\n            float y = parse_float();\n            expect(\")\");\n\n            xs[total] = x;\n            ys[total] = y;\n            labels[total] = label;\n            ++total;\n        }\n    }\n\n    expect(\"k=\");\n    int k = parse_int();\n\n    Point q;\n    expect(\"(\");\n    q.x = parse_float();\n    expect(\",\");\n    q.y = parse_float();\n    expect(\")\");\n\n    char ans = knn(xs, ys, labels, total, k, q);\n    printf(\"%c\", ans);\n\n    free(input);\n    free(xs);\n    free(ys);\n    free(labels);\n    return 0;\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Flattening all training points into contiguous structure-of-arrays buffers (separate x, y, and label arrays) turns the distance scan into a single linear streaming pass with predictable cache-line usage. A buffered custom parser removes scanf/malloc-per-point overhead, while an early rejection against the current k-th smallest distance avoids scanning the insertion list for points that cannot enter the top-k.",
  "notes": "The implementation preserves the original strict-less-than insertion semantics and the same label-frequency tie-breaking as the baseline. The flat SoA layout improves memory locality during the dominant sequential scan over all points, and hoisting query coordinates into registers reduces redundant loads in the inner loop.",
  "sources_kept": [],
  "transformations": [
    "Replace per-group Point allocations with one set of contiguous xs/ys/labels arrays",
    "Convert nested group/point loops into a single linear scan over all points",
    "Add early rejection when distance is not smaller than the current k-th worst",
    "Use a buffered custom parser instead of scanf and repeated malloc calls"
  ]
}

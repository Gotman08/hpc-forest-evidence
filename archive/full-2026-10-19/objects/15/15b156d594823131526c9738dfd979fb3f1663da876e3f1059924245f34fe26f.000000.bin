@pytest.mark.parametrize("mutation", ["duplicate", "wrong-name", "wrong-expected", "wrong-input", "wrong-flags", "wrong-benchmark"])
def test_finite_case_and_bytes_violations(finite, mutation):
    trusted, certified, contract = finite
    if mutation == "duplicate":
        contract["search"][-1] = contract["search"][0]
    elif mutation == "wrong-name":
        contract["confirmation"][0]["name"] = "search-case-1"
    elif mutation == "wrong-expected":
        value = b"NEUTRAL incorrect"
        contract["search"][0]["expected"]["stdout"] = {"base64": base64.b64encode(value).decode(), "sha256": c.sha(value), "bytes": len(value)}
    elif mutation == "wrong-input":
        (trusted / contract["search"][0]["stdin"]).write_bytes(b"changed")
    elif mutation == "wrong-flags":
        contract["compiler_flags"] = ["-O2"]
    else:
        contract["benchmark"] = {**contract["search"][0], "name": "benchmark-case-1"}
    put(trusted / "contract.json", contract)
    with pytest.raises(c.AuditError):
        c.finite_contract(trusted, certified)


def transport_fixture(tmp_path, error=None):
    mailbox, cache = tmp_path / "mailbox", tmp_path / "cache"
    nonce = "1" * 32
    local = cache / nonce
    request = {"kind": "source-proposal", "nonce": nonce, "model": c.MODEL, "reasoning_effort": "max", "session_id": c.SESSION, "mission_id": "NEUTRAL-h01"}
    req = put(mailbox / "requests" / (nonce + ".request.json"), request)
    request_sha = c.sha(req.read_bytes())
    put(local / "generation-claimed.json", {"request_sha256": request_sha, "claimed_at": "NEUTRAL"})
    (local / "downloaded-request.json").write_bytes(req.read_bytes())
    argv = ["NEUTRAL-NOT-EXECUTABLE", "exec", "--model", c.MODEL, 'model_reasoning_effort="max"', 'forced_login_method="chatgpt"']
    invocation = {"argv": argv, "model": c.MODEL, "reasoning_effort": "max", "request_sha256": request_sha, "source_execution_allowed": False}
    event = {"type": "turn.completed", "usage": {"input_tokens": 20, "output_tokens": 4, "cached_input_tokens": 8}}
    events = (json.dumps(event) + "\n").encode()
    logs = mailbox / "logs"
    logs.mkdir()
    events_path = logs / (nonce + ".codex.jsonl")
    events_path.write_bytes(events)
    (local / "codex.jsonl").write_bytes(events)
    response = {"nonce": nonce, "request_sha256": request_sha, "session_id": c.SESSION, "model": c.MODEL,
                "reasoning_effort": "max", "error": error, "infrastructure_error": False,
                "usage": {"token_accounting": "exact", "tokens": 24, "codex_jsonl_sha256": c.sha(events), "llm_calls": 1, "tool_events": []}}
    res = put(mailbox / "responses" / (nonce + ".response.json"), response)
    (local / "response.json").write_bytes(res.read_bytes())
    ready = {"sha256": c.sha(res.read_bytes()), "bytes": res.stat().st_size}
    delivery = {"scope_id": c.SCOPE, "session_id": c.SESSION, "job_id": c.JOB, "model": c.MODEL, "effort": "max",
                "source_zip_sha256": c.SOURCE_SHA, "plan_sha256": c.PLAN_SHA,
                "request_sha256": request_sha, "response_sha256": c.sha(res.read_bytes())}
    process = {"argv": argv, "returncode": 0, "timed_out": False}
    for remote_name, local_name, value in ((".ready.json", "response-ready.json", ready),
                                         (".delivered.json", "delivered.json", delivery),
                                         (".invocation.json", "invocation.json", invocation),
                                         (".codex.jsonl.json", "codex.jsonl.json", process)):
        remote = (mailbox / "responses" if remote_name == ".ready.json" else logs) / (nonce + remote_name)
        put(remote, value)
        (local / local_name).write_bytes(remote.read_bytes())
    return mailbox, cache, nonce


def test_transport_deduplicates_and_includes_cached_tokens_once(tmp_path):
    mailbox, cache, _ = transport_fixture(tmp_path)
    before = c.inventory(tmp_path)
    result = mailbox_and_cache(mailbox, cache)
    assert result["exact_known_tokens"] == 24
    assert result["unique_session_nonce_pairs"] == result["exact_known_native_invocations"] == 1
    assert result["unresolved_nonces"] == []
    assert c.inventory(tmp_path) == before


def test_known_model_negative_not_interface_failure(tmp_path):
    mailbox, cache, _ = transport_fixture(tmp_path, error="NEUTRAL malformed known model response")
    result = mailbox_and_cache(mailbox, cache)
    assert result["nonce_records"][0]["known_model_negative"] is True
    assert result["unresolved_nonces"] == []


@pytest.mark.parametrize("mutation", ["extra-claim", "pending", "claim-sha", "ready-sha", "mixed-model", "tool", "usage"])
def test_transport_violations(tmp_path, mutation):
    mailbox, cache, nonce = transport_fixture(tmp_path)
    local = cache / nonce
    if mutation == "extra-claim":
        (cache / ("2" * 32)).mkdir()
    elif mutation == "pending":
        (cache / "pending-call.json").write_bytes(b"NEUTRAL")
    elif mutation == "claim-sha":
        put(local / "generation-claimed.json", {"request_sha256": "0" * 64})
    elif mutation == "ready-sha":
        put(mailbox / "responses" / (nonce + ".ready.json"), {"sha256": "0" * 64, "bytes": 1})
    elif mutation == "mixed-model":
        request = mailbox / "requests" / (nonce + ".request.json")
        data = c.read_json(request)
        data["model"] = "gpt-6-astra"
        put(request, data)
    elif mutation == "tool":
        extra = json.dumps({"type": "item.completed", "item": {"type": "command_execution"}}).encode() + b"\n"
        remote = mailbox / "logs" / (nonce + ".codex.jsonl")
        remote.write_bytes(remote.read_bytes() + extra)
        (local / "codex.jsonl").write_bytes(remote.read_bytes())
    else:
        response = mailbox / "responses" / (nonce + ".response.json")
        data = c.read_json(response)
        data["usage"]["tokens"] = 999
        put(response, data)
        (local / "response.json").write_bytes(response.read_bytes())
        # Rebind delivery/ready to the tampered response to reach the exact-usage check.
        for folder, name, key in ((mailbox / "responses", ".ready.json", "sha256"), (mailbox / "logs", ".delivered.json", "response_sha256")):
            path = folder / (nonce + name)
            value = c.read_json(path)
            value[key] = c.sha(response.read_bytes())
            if name == ".ready.json":
                value["bytes"] = response.stat().st_size
            put(path, value)
            (local / ("response-ready.json" if name == ".ready.json" else "delivered.json")).write_bytes(path.read_bytes())
    with pytest.raises(c.AuditError):
        mailbox_and_cache(mailbox, cache)


def test_incomplete_delivery_is_unknown_and_not_replayed(tmp_path):
    mailbox, cache, nonce = transport_fixture(tmp_path)
    (cache / nonce / "delivered.json").unlink()
    result = mailbox_and_cache(mailbox, cache)
    assert result["unknown_native_invocations"] == 1
    assert result["unresolved_nonces"] == [nonce]


def test_raw_attribution_never_inferred_from_filename(tmp_path):
    folder = tmp_path / "private-audit/executions/NEUTRAL-CANDIDATE-ID"
    put(folder / "execution.json", {"case": "search-case-1", "returncode": 0, "timed_out": False, "never_model_input": True})
    (folder / "stdout.bin").write_bytes(b"NEUTRAL output")
    (folder / "stderr.bin").write_bytes(b"")
    result = raw_evidence(tmp_path)
    assert result["independent_raw_stdout_per_candidate_verified"] is False
    record = c.read_json(folder / "execution.json")
    record["independent_raw_stdout_per_candidate_verified"] = True
    put(folder / "execution.json", record)
    with pytest.raises(c.AuditError, match="Unsupported claim"):
        raw_evidence(tmp_path)


def test_stub_cannot_produce_admission(tmp_path):
    root, cache = tmp_path / "root", tmp_path / "cache"
    root.mkdir()
    cache.mkdir()
    source = tmp_path / "NEUTRAL-not-production.zip"
    source.write_bytes(b"NEUTRAL")
    before = c.inventory(tmp_path)
    result = audit(root, cache, tmp_path / "missing", tmp_path / "missing2", source, source, root)
    assert result["verified"] is result["native_research_admitted"] is result["independent_performance_audit_verified"] is False
    assert result["independent_raw_stdout_per_candidate_verified"] is False
    assert result["received_cohort_audited_with_explicit_raw_attribution_limit"] is False
    assert result["audit_error"]
    assert c.inventory(tmp_path) == before



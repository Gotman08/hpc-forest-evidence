def test_slot_cost_classes_not_combined():
    rows = [{"usage_known": n, "tokens_used": n + 5, "tokens_reserved": 2} for n in (0, 1, 2)]
    result = c.slot_costs(rows)
    assert result["exact_known_tokens"] == 6
    assert result["unknown_usage_charged_tokens"] == 5
    assert result["upper_bound_charged_tokens"] == 7
    assert result["reserved_tokens"] == 6



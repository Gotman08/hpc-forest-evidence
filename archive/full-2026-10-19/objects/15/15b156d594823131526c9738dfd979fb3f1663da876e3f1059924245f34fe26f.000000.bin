def put(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, ensure_ascii=True), encoding="utf8")
    return path


def test_sqlite_read_only_and_preserved(tmp_path):
    path = tmp_path / "closed.sqlite3"
    with sqlite3.connect(path) as db:
        db.execute("CREATE TABLE test(value TEXT)")
        db.execute("INSERT INTO test VALUES('NEUTRAL')")
    before = c.inventory(tmp_path)
    db = c.open_closed_database(path)
    try:
        assert db.execute("SELECT value FROM test").fetchone()[0] == "NEUTRAL"
        with pytest.raises(sqlite3.OperationalError, match="readonly"):
            db.execute("INSERT INTO test VALUES('forbidden')")
    finally:
        db.close()
    assert c.inventory(tmp_path) == before


@pytest.mark.parametrize("suffix", ["-wal", "-shm", "-journal"])
def test_sqlite_sidecar_refused_before_connect(tmp_path, monkeypatch, suffix):
    path = tmp_path / "closed.sqlite3"
    path.write_bytes(b"NEUTRAL")
    Path(str(path) + suffix).write_bytes(b"")
    monkeypatch.setattr(sqlite3, "connect", lambda *a, **k: pytest.fail("connect must not run"))
    with pytest.raises(c.AuditError, match="Nonconsolidated"):
        c.open_closed_database(path)


def archive_fixture(tmp_path, entries):
    archive, root = tmp_path / "received.tar.gz", tmp_path / "restored"
    root.mkdir()
    with tarfile.open(archive, "w:gz") as stream:
        for name, raw, kind in entries:
            item = tarfile.TarInfo(name)
            if kind == "link":
                item.type, item.linkname = tarfile.SYMTYPE, "outside"
                stream.addfile(item)
            else:
                item.size = len(raw)
                stream.addfile(item, io.BytesIO(raw))
                if ".." not in name:
                    target = root / name
                    target.parent.mkdir(parents=True, exist_ok=True)
                    target.write_bytes(raw)
    return archive, root


def test_archive_exact_bytes_no_extraction(tmp_path):
    archive, root = archive_fixture(tmp_path, [("results-751992/x", b"NEUTRAL", "file")])
    before = c.inventory(root)
    assert c.verify_archive(archive, root) == before
    assert c.inventory(root) == before


@pytest.mark.parametrize("entries", [
    [("../escape", b"NEUTRAL", "file")],
    [("results-751992/link", b"", "link")],
    [("results-751992/x", b"x", "file"), ("results-751992/x", b"x", "file")],
    [("wrong-root/x", b"x", "file")],
])
def test_archive_violations(tmp_path, entries):
    archive, root = archive_fixture(tmp_path, entries)
    with pytest.raises(c.AuditError):
        c.verify_archive(archive, root)


@pytest.mark.parametrize("mutation", ["changed", "extra", "missing"])
def test_restoration_must_exactly_match_archive(tmp_path, mutation):
    archive, root = archive_fixture(tmp_path, [("results-751992/x", b"NEUTRAL", "file")])
    if mutation == "changed":
        (root / "results-751992/x").write_bytes(b"changed")
    elif mutation == "extra":
        (root / "extra").write_bytes(b"extra")
    else:
        (root / "results-751992/x").unlink()
    with pytest.raises(c.AuditError, match="Restoration"):
        c.verify_archive(archive, root)



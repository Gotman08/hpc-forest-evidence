    feedback_evidence({"development_outcome": {"status": "incorrect", "correct": False},
                       "measured_diagnostics": [{"status": "failed", "code": "output_mismatch", "case": "search-case-2", "returncode": 1}]})


@pytest.mark.parametrize("field,value", [("parent", "NEUTRAL-WRONG-PARENT"), ("source", "NEUTRAL-WRONG-SOURCE")])
def test_candidate_parent_or_model_source_tamper_rejected(tmp_path, field, value):
    # This fake object reader is a unit-test double, never a production receipt.
    class NeutralGit:
        def sources_at(self, commit):
            return {"src/x": "NEUTRAL source" if commit == "base" else value}

        def commit(self, commit):
            return {"parents": [value if field == "parent" else "base"]}

    mission = {"id": "NEUTRAL", "parent_id": None, "base_commit": "base"}
    put(tmp_path / "logs/NEUTRAL/node-harness.json", {"mission_id": "NEUTRAL", "parent_id": None,
        "holdout_access": False, "outer_tree_reward_assigned": False, "attempts": [], "state": "finished"})
    with pytest.raises(c.AuditError, match="Git parent|Committed source"):
        harness_evidence(tmp_path, mission, {"commit": "child"}, NeutralGit(), tmp_path, {"mission_ids": []})


def test_orphan_ready_cannot_disappear_from_reconciliation(tmp_path):
    mailbox, cache, _ = transport_fixture(tmp_path)
    put(mailbox / "responses" / ("f" * 32 + ".ready.json"), {"sha256": "0" * 64, "bytes": 1})
    with pytest.raises(c.AuditError, match="Orphan"):
        mailbox_and_cache(mailbox, cache)


def test_corrupt_closed_sqlite_never_creates_new_file(tmp_path):
    path = tmp_path / "corrupt.sqlite3"
    path.write_bytes(b"NEUTRAL corrupt bytes")
    before = c.inventory(tmp_path)
    with pytest.raises(sqlite3.DatabaseError):
        c.open_closed_database(path)
    assert c.inventory(tmp_path) == before

def test_source_newlines_follow_frozen_harness_semantics():
    assert normal_sources({"src/x": "a\r\nb\rc\n"}) == {"src/x": "a\nb\nc\n"}


def evaluation_fixture(tmp_path, repetitions=5):
    root = tmp_path / "restored"
    remote = str(c.REMOTE)
    campaign = remote + "/results-751992/" + c.CAMPAIGN
    worktree = campaign + "/worktrees/NEUTRAL"
    build = campaign + "/builds/NEUTRAL"
    history = campaign + "/logs/NEUTRAL/confirmation"
    trusted = campaign + "/trusted"
    build_path = c.rebased(build, root)
    build_path.mkdir(parents=True)
    binary = b"NEUTRAL NONEXECUTABLE BYTES"
    (build_path / "solution").write_bytes(binary)
    (build_path / "compiler.stdout").write_bytes(b"")
    (build_path / "compiler.stderr").write_bytes(b"")
    command = ["NEUTRAL-NOT-EXECUTABLE", "-I", worktree + "/src", worktree + "/src/model-view/primetest.c", *c.FLAGS, "-o", build + "/solution"]
    put(build_path / "compiler-command.json", {"argv": command, "compiler_flags": c.FLAGS})
    contract = {phase: [{"name": f"{phase}-case-{n}", "input_fingerprint": f"{offset+n:064x}", "capture_files": []}
                       for n in range(1, 7)] for phase, offset in (("search", 0), ("confirmation", 10))}
    contract["benchmark"] = {**contract["search"][-1], "name": "benchmark-case-1"}
    put(c.rebased(trusted + "/contract.json", root), contract)
    logs = []
    for name, argv, seconds in [("build.log", ["NEUTRAL-PYTHON", trusted + "/contract_tool.py", "build", worktree, build], 1),
                                ("correctness.log", ["NEUTRAL-PYTHON", trusted + "/contract_tool.py", "check", build + "/solution", "confirmation"], 1),
                                *[(f"sample-{n}.log", ["/bin/sh", trusted + "/benchmark.sh", build + "/solution"], 1 + n / 10) for n in range(repetitions)]]:
        path = c.rebased(history + "/" + name, root)
        path.parent.mkdir(parents=True, exist_ok=True)
        if name == "correctness.log":
            put(path, {"correct": True, "cases": 7})
        else:
            path.write_bytes(b"NEUTRAL recorded process output")
        put(Path(str(path) + ".json"), {"argv": argv, "returncode": 0, "timed_out": False, "seconds": seconds})
        logs.append(history + "/" + name)
    times = [1 + n / 10 for n in range(repetitions)]
    outcome = {"status": "valid", "correct": True, "score": .5, "logs": logs, "times": times,
               "mean_seconds": sum(times) / len(times), "binary_sha256": c.sha(binary)}
    return root, outcome


def test_five_recorded_samples_without_running_binary(tmp_path):
    root, outcome = evaluation_fixture(tmp_path)
    before = c.inventory(root)
    assert evaluation_evidence(outcome, "confirmation", root, 5)["samples"] == 5
    assert c.inventory(root) == before


@pytest.mark.parametrize("mutation", ["only-four", "duplicate-log", "wrong-phase", "wrong-source", "wrong-flags", "wrong-binary", "wrong-mean", "wrong-count", "wrong-typed-checker"])
def test_confirmation_violations_without_candidate_execution(tmp_path, mutation):
    root, outcome = evaluation_fixture(tmp_path, 4 if mutation == "only-four" else 5)
    build_record = c.read_json(Path(str(c.rebased(outcome["logs"][0], root)) + ".json"))
    build_path = c.rebased(build_record["argv"][4], root)
    checker = c.rebased(outcome["logs"][1], root)
    if mutation == "duplicate-log":
        outcome["logs"].append(outcome["logs"][-1])
    elif mutation == "wrong-phase":
        record = c.read_json(Path(str(checker) + ".json"))
        record["argv"][-1] = "search"
        put(Path(str(checker) + ".json"), record)
    elif mutation in {"wrong-source", "wrong-flags"}:
        record = c.read_json(build_path / "compiler-command.json")
        if mutation == "wrong-source":
            record["argv"][3] = "NEUTRAL-other-source"
        else:
            record["compiler_flags"] = ["-O2"]
        put(build_path / "compiler-command.json", record)
    elif mutation == "wrong-binary":
        (build_path / "solution").write_bytes(b"NEUTRAL other nonexecutable")
    elif mutation == "wrong-mean":
        outcome["mean_seconds"] = 99
    elif mutation == "wrong-count":
        put(checker, {"correct": True, "cases": 1})
    elif mutation == "wrong-typed-checker":
        put(checker, {"correct": "true", "cases": 6})
    with pytest.raises(c.AuditError):
        evaluation_evidence(outcome, "confirmation", root, 5)


def test_failed_candidate_build_remains_known_negative(tmp_path):
    root, outcome = evaluation_fixture(tmp_path)
    build_log = Path(str(c.rebased(outcome["logs"][0], root)) + ".json")
    record = c.read_json(build_log)
    record["returncode"] = 1
    put(build_log, record)
    outcome.update(status="build_failed", correct=False, score=0, times=[], mean_seconds=None)
    assert evaluation_evidence(outcome, "confirmation", root, 5) == {"status": "build_failed", "evaluated": True}



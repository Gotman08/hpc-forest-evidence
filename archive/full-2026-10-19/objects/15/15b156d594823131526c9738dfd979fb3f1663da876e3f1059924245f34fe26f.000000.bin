def test_invalid_ledger_tokens(value):
    with pytest.raises(c.AuditError):
        c.slot_costs([{"usage_known": 1, "tokens_used": value, "tokens_reserved": 0}])


def git_object(repo, kind, payload):
    raw = kind.encode() + b" " + str(len(payload)).encode() + b"\0" + payload
    oid = hashlib.sha1(raw).hexdigest()
    target = repo / ".git/objects" / oid[:2] / oid[2:]
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(zlib.compress(raw))
    return oid


def git_fixture(tmp_path, mode=b"100644", name=b"x"):
    repo = tmp_path / "repo"
    blob = git_object(repo, "blob", b"NEUTRAL source\n")
    tree = git_object(repo, "tree", mode + b" " + name + b"\0" + bytes.fromhex(blob))
    commit = git_object(repo, "commit", ("tree " + tree + "\n\nNEUTRAL\n").encode())
    return repo, blob, commit


def test_git_objects_are_read_without_cli(tmp_path):
    repo, _, commit = git_fixture(tmp_path)
    before = c.inventory(repo)
    assert LooseGit(repo).files_at(commit) == {"x": b"NEUTRAL source\n"}
    assert c.inventory(repo) == before


@pytest.mark.parametrize("mode,name", [(b"120000", b"x"), (b"160000", b"x"), (b"100644", b".."), (b"100644", b"a/b")])
def test_git_nonregular_or_unsafe_tree(tmp_path, mode, name):
    repo, _, commit = git_fixture(tmp_path, mode, name)
    with pytest.raises(GitEvidenceError):
        LooseGit(repo).files_at(commit)


def test_git_object_hash_tamper(tmp_path):
    repo, blob, commit = git_fixture(tmp_path)
    (repo / ".git/objects" / blob[:2] / blob[2:]).write_bytes(zlib.compress(b"blob 7\0changed"))
    with pytest.raises(GitEvidenceError, match="SHA-1"):
        LooseGit(repo).files_at(commit)


def test_git_packed_or_missing_blocks_no_fallback(tmp_path):
    repo, blob, commit = git_fixture(tmp_path)
    (repo / ".git/objects" / blob[:2] / blob[2:]).unlink()
    with pytest.raises(GitEvidenceError, match="packed or missing"):
        LooseGit(repo).files_at(commit)


@pytest.fixture
def finite(tmp_path, monkeypatch):
    certified, trusted = tmp_path / "certified", tmp_path / "trusted"
    trusted.mkdir()
    contract = {"language": "c", "source_files": ["model-view/primetest.c"], "compiler_flags": c.FLAGS,
                "comparison": {"mode": "bytes"}}
    for phase, variant in (("search", 0), ("confirmation", 1)):
        contract[phase] = []
        for n, p in enumerate((1, 2, 4, 8, 16, 30), 1):
            origin = f"p{p:02d}-v{variant}"
            input_raw, expected = f"NEUTRAL input {origin}\n".encode(), f"NEUTRAL output {origin}\n".encode()
            folder = certified / "data/private-audit-fixtures" / origin
            folder.mkdir(parents=True)
            (folder / "input.txt").write_bytes(input_raw)
            (folder / "expected.txt").write_bytes(expected)
            input_name = phase + f"-{n}.txt"
            (trusted / input_name).write_bytes(input_raw)
            contract[phase].append({"name": f"{phase}-case-{n}", "stdin": input_name, "argv": [], "files": [], "capture_files": [],
                                    "expected": {"stdout": {"base64": base64.b64encode(expected).decode(), "sha256": c.sha(expected), "bytes": len(expected)}}})
    contract["benchmark"] = {**contract["search"][-1], "name": "benchmark-case-1"}
    manifest = put(certified / "prototype-manifest.json", c.inventory(certified))
    monkeypatch.setattr(c, "PREPARATION_SHA", c.sha(manifest.read_bytes()))
    put(trusted / "contract.json", contract)
    return trusted, certified, contract



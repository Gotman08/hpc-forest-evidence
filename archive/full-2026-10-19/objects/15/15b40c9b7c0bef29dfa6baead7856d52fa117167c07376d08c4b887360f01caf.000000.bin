      "content": "{\"role\": \"G\", \"goal\": \"integration of diverse archived transformations; evaluate the full program\", \"experiment\": \"066442ec156f4495\", \"ordinal\": 12, \"integration_source_ids\": [\"5dda87a5adf04543\", \"36accc1bb19641b9\", \"8de2794fb10e4ca9\"], \"current_source_paths\": [\"src/knn.c\", \"src/knn.h\"], \"context_as_data\": {\"sources\": [{\"id\": \"5dda87a5adf04543\", \"role\": \"A\", \"commit\": \"eb380e85520dad68d5985df1903734c28f4ffc62\", \"transformations\": {\"files\": [\"src/knn.h\"], \"retained\": [\"Replace scanf-based parsing with sequential buffered input traversal.\", \"Convert ordinary float tokens directly inside the input window using strtof.\", \"Dynamically assemble boundary-spanning tokens without imposing a token-length limit.\"]}, \"mean_seconds\": 0.0220357912282149, \"diff\": \"diff --git a/src/knn.c b/src/knn.c\\nindex 337e3b9..1768b80 100644\\n--- a/src/knn.c\\n+++ b/src/knn.c\\n@@ -1,78 +1,177 @@\\n-#include \\\"knn.h\\\"\\n-\\n-char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n-    char * labels = (char *) malloc(sizeof(char) * k);\\n-    float * distances = (float *) malloc(sizeof(float) * k);\\n-\\n-    int i, j, x, y;\\n-\\n-    for (i = 0; i < k; i++) {\\n-        labels[i] = -1;\\n-        distances[i] = -1;\\n-    }\\n-\\n-    for (i = 0; i < n_groups; i++) {\\n-        Group g = groups[i];\\n-\\n-        for (j = 0; j < g.length; j++) {\\n-            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n-\\n-            for (x = 0; x < k; x++) {\\n-                if (d < distances[x] || distances[x] == -1) {\\n-                    for (y = k - 1; y > x; y--) {\\n-                        distances[y] = distances[y - 1];\\n-                        labels[y] = labels[y - 1];\\n-                    }\\n-\\n-                    distances[x] = d;\\n-                    labels[x] = g.label;\\n-\\n-                    break;\\n-                }\\n-            }\\n-        }\\n-    }\\n-\\n-    qsort(labels, k, sizeof(char), compare_for_sort);\\n-\\n-    char most_frequent = labels[0];\\n-    int most_frequent_count = 1;\\n-    int current_frequency = 1;\\n-\\n-    for (i = 1; i < k; i++) {\\n-        if (labels[i] != labels[i - 1]) {\\n-            if (current_frequency > most_frequent_count) {\\n-                most_frequent = labels[i - 1];\\n-                most_frequent_count = current_frequency;\\n-            }\\n-\\n-            current_frequency = 1;\\n-        } else {\\n-            current_frequency++;\\n-        }\\n-\\n-        if (i == k - 1 && current_frequency > most_frequent_count) {\\n-            most_frequent = labels[i - 1];\\n-            most_frequent_count = current_frequency;\\n-        }\\n-    }\\n-\\n-\\n-    return most_frequent;\\n-}\\n-\\n-int main() {\\n-    int n_groups = parse_number_of_groups();\\n-    \\n-    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n-\\n-    for (int i = 0; i < n_groups; i++) {\\n-        groups[i] = parse_next_group();\\n-    }\\n-\\n-    int k = parse_k();\\n-\\n-    Point to_evaluate = parse_point();\\n-\\n-    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n-}\\n\\\\ No newline at end of file\\n+#include \\\"knn.h\\\"\\n+\\n+typedef struct {\\n+    float distance;\\n+    int group;\\n+} Neighbor;\\n+\\n+static char majority_label(char *labels, int k) {\\n+    qsort(labels, k, sizeof(char), compare_for_sort);\\n+\\n+    char most_frequent = labels[0];\\n+    int most_frequent_count = 1;\\n+    int current_frequency = 1;\\n+\\n+    for (int i = 1; i < k; i++) {\\n+        if (labels[i] != labels[i - 1]) {\\n+            if (current_frequency > most_frequent_count) {\\n+                most_frequent = labels[i - 1];\\n+                most_frequent_count = current_frequency;\\n+            }\\n+            current_frequency = 1;\\n+        } else {\\n+            current_frequency++;\\n+        }\\n+\\n+        if (i == k - 1 && current_frequency > most_frequent_count) {\\n+            most_frequent = labels[i - 1];\\n+            most_frequent_count = current_frequency;\\n+        }\\n+    }\\n+\\n+    return most_frequent;\\n+}\\n+\\n+static char knn_sorted_fallback(int n_groups, Group *groups, int k,\\n+                                Point to_evaluate) {\\n+    char *labels = (char *) malloc(sizeof(char) * k);\\n+    float *distances = (float *) malloc(sizeof(float) * k);\\n+\\n+    for (int i = 0; i < k; i++) {\\n+        labels[i] = -1;\\n+        distances[i] = -1;\\n+    }\\n+\\n+    for (int i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+        for (int j = 0; j < g.length; j++) {\\n+            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n+            for (int x = 0; x < k; x++) {\\n+                if (d < distances[x] || distances[x] == -1) {\\n+                    for (int y = k - 1; y > x; y--) {\\n+                        distances[y] = distances[y - 1];\\n+                        labels[y] = labels[y - 1];\\n+                    }\\n+                    distances[x] = d;\\n+                    labels[x] = g.label;\\n+                    break;\\n+                }\\n+            }\\n+        }\\n+    }\\n+\\n+    char result = majority_label(labels, k);\\n+    free(distances);\\n+    free(labels);\\n+    return result;\\n+}\\n+\\n+static int neighbor_is_worse(Neighbor a, Neighbor b) {\\n+    return a.distance > b.distance ||\\n+           (a.distance == b.distance && a.group > b.group);\\n+}\\n+\\n+static void sift_down(Neighbor *heap, size_t count, size_t root,\\n+                      Neighbor value) {\\n+    while (count > 1 && root <= (count - 2) / 4) {\\n+        size_t first = root * 4 + 1;\\n+        size_t end = first + 4;\\n+        size_t worst = first;\\n+        if (end > count) end = count;\\n+\\n+        for (size_t child = first + 1; child < end; child++) {\\n+            if (neighbor_is_worse(heap[child], heap[worst])) {\\n+                worst = child;\\n+            }\\n+        }\\n+\\n+        if (!neighbor_is_worse(heap[worst], value)) break;\\n+        heap[root] = heap[worst];\\n+        root = worst;\\n+    }\\n+    heap[root] = value;\\n+}\\n+\\n+char knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n+    if (k <= 0) {\\n+        return knn_sorted_fallback(n_groups, groups, k, to_evaluate);\\n+    }\\n+\\n+    size_t capacity = 0;\\n+    for (int i = 0; i < n_groups && capacity < (size_t) k; i++) {\\n+        if (groups[i].length > 0) {\\n+            size_t available = (size_t) groups[i].length;\\n+            size_t remaining = (size_t) k - capacity;\\n+            capacity += available < remaining ? available : remaining;\\n+        }\\n+    }\\n+    if (capacity == 0) return (char) -1;\\n+\\n+    size_t bytes = capacity * sizeof(Neighbor);\\n+    if (bytes < (size_t) k) bytes = (size_t) k;\\n+    Neighbor *heap = (Neighbor *) malloc(bytes);\\n+    if (heap == NULL) {\\n+        return knn_sorted_fallback(n_groups, groups, k, to_evaluate);\\n+    }\\n+\\n+    size_t used = 0;\\n+    for (int i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+        for (int j = 0; j < g.length; j++) {\\n+            float d = euclidean_distance_no_sqrt(to_evaluate, \"}, {\"id\": \"36accc1bb19641b9\", \"role\": \"B\", \"commit\": \"834c0370851e2cf5dacd2330fa7c9071fa027738\", \"transformations\": {\"files\": [\"src/knn.c\"], \"retained\": [\"Buffer and stably sort up to 16 candidates within each group.\", \"Compute upper-bound insertion ranks four at a time using guarded NEON searches against the unchanged neighbor prefix.\", \"Merge retained candidates backward with overlap-safe vector copies, moving each retained old neighbor at most once per batch.\"]}, \"mean_seconds\": 0.05689422910412153, \"diff\": \"diff --git a/src/knn.c b/src/knn.c\\nindex 337e3b9..ba0d6d0 100644\\n--- a/src/knn.c\\n+++ b/src/knn.c\\n@@ -1,78 +1,342 @@\\n-#include \\\"knn.h\\\"\\n-\\n-char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n-    char * labels = (char *) malloc(sizeof(char) * k);\\n-    float * distances = (float *) malloc(sizeof(float) * k);\\n-\\n-    int i, j, x, y;\\n-\\n-    for (i = 0; i < k; i++) {\\n-        labels[i] = -1;\\n-        distances[i] = -1;\\n-    }\\n-\\n-    for (i = 0; i < n_groups; i++) {\\n-        Group g = groups[i];\\n-\\n-        for (j = 0; j < g.length; j++) {\\n-            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n-\\n-            for (x = 0; x < k; x++) {\\n-                if (d < distances[x] || distances[x] == -1) {\\n-                    for (y = k - 1; y > x; y--) {\\n-                        distances[y] = distances[y - 1];\\n-                        labels[y] = labels[y - 1];\\n-                    }\\n-\\n-                    distances[x] = d;\\n-                    labels[x] = g.label;\\n-\\n-                    break;\\n-                }\\n-            }\\n-        }\\n-    }\\n-\\n-    qsort(labels, k, sizeof(char), compare_for_sort);\\n-\\n-    char most_frequent = labels[0];\\n-    int most_frequent_count = 1;\\n-    int current_frequency = 1;\\n-\\n-    for (i = 1; i < k; i++) {\\n-        if (labels[i] != labels[i - 1]) {\\n-            if (current_frequency > most_frequent_count) {\\n-                most_frequent = labels[i - 1];\\n-                most_frequent_count = current_frequency;\\n-            }\\n-\\n-            current_frequency = 1;\\n-        } else {\\n-            current_frequency++;\\n-        }\\n-\\n-        if (i == k - 1 && current_frequency > most_frequent_count) {\\n-            most_frequent = labels[i - 1];\\n-            most_frequent_count = current_frequency;\\n-        }\\n-    }\\n-\\n-\\n-    return most_frequent;\\n-}\\n-\\n-int main() {\\n-    int n_groups = parse_number_of_groups();\\n-    \\n-    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n-\\n-    for (int i = 0; i < n_groups; i++) {\\n-        groups[i] = parse_next_group();\\n-    }\\n-\\n-    int k = parse_k();\\n-\\n-    Point to_evaluate = parse_point();\\n-\\n-    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n-}\\n\\\\ No newline at end of file\\n+#include \\\"knn.h\\\"\\n+\\n+#if defined(__aarch64__) && defined(__ARM_NEON)\\n+#include <stdint.h>\\n+#include <arm_neon.h>\\n+#endif\\n+\\n+enum { KNN_BATCH_SIZE = 16 };\\n+\\n+static inline int knn_insert_neighbor(float d, char label, int k,\\n+                                      float *distances, char *labels) {\\n+    for (int x = 0; x < k; x++) {\\n+        if (d < distances[x] || distances[x] == -1) {\\n+            for (int y = k - 1; y > x; y--) {\\n+                distances[y] = distances[y - 1];\\n+                labels[y] = labels[y - 1];\\n+            }\\n+\\n+            distances[x] = d;\\n+            labels[x] = label;\\n+            return 1;\\n+        }\\n+    }\\n+\\n+    return 0;\\n+}\\n+\\n+#if defined(__aarch64__) && defined(__ARM_NEON)\\n+static inline uint32x4_t knn_axis_candidates(const Point *points,\\n+                                            float32x4_t target_x,\\n+                                            float32x4_t target_y,\\n+                                            float32x4_t cutoff) {\\n+    float32x4x2_t xy = vld2q_f32((const float *) points);\\n+    float32x4_t dx = vsubq_f32(xy.val[0], target_x);\\n+    float32x4_t dy = vsubq_f32(xy.val[1], target_y);\\n+\\n+    /* Each rounded squared coordinate is a lower bound on the distance. */\\n+    return vandq_u32(vcltq_f32(vmulq_f32(dx, dx), cutoff),\\n+                     vcltq_f32(vmulq_f32(dy, dy), cutoff));\\n+}\\n+\\n+static inline unsigned int knn_block_candidates(const Point *points,\\n+                                                Point target, float limit) {\\n+    static const uint32_t lane_weights[4] = {1u, 2u, 4u, 8u};\\n+    uint32x4_t weights = vld1q_u32(lane_weights);\\n+    float32x4_t target_x = vdupq_n_f32(target.x);\\n+    float32x4_t target_y = vdupq_n_f32(target.y);\\n+    float32x4_t cutoff = vdupq_n_f32(limit);\\n+\\n+    uint32x4_t m0 = vandq_u32(\\n+        knn_axis_candidates(points, target_x, target_y, cutoff), weights);\\n+    uint32x4_t m1 = vandq_u32(\\n+        knn_axis_candidates(points + 4, target_x, target_y, cutoff),\\n+        vshlq_n_u32(weights, 4));\\n+    uint32x4_t m2 = vandq_u32(\\n+        knn_axis_candidates(points + 8, target_x, target_y, cutoff),\\n+        vshlq_n_u32(weights, 8));\\n+    uint32x4_t m3 = vandq_u32(\\n+        knn_axis_candidates(points + 12, target_x, target_y, cutoff),\\n+        vshlq_n_u32(weights, 12));\\n+\\n+    return (unsigned int) vaddvq_u32(\\n+        vorrq_u32(vorrq_u32(m0, m1), vorrq_u32(m2, m3)));\\n+}\\n+#endif\\n+\\n+static inline void knn_insertion_ranks(const float *distances, int filled,\\n+                                       const float *values, int count,\\n+                                       int *ranks) {\\n+    int p = 0;\\n+\\n+    if (filled == 0) {\\n+        for (; p < count; p++) {\\n+            ranks[p] = 0;\\n+        }\\n+        return;\\n+    }\\n+\\n+#if defined(__aarch64__) && defined(__ARM_NEON)\\n+    uint32x4_t zero = vdupq_n_u32(0u);\\n+    uint32x4_t one = vdupq_n_u32(1u);\\n+\\n+    for (; count - p >= 4; p += 4) {\\n+        float32x4_t targets = vld1q_f32(values + p);\\n+        uint32x4_t low = zero;\\n+        uint32x4_t high = vdupq_n_u32((uint32_t) filled);\\n+\\n+        for (;;) {\\n+            uint32x4_t active = vcltq_u32(low, high);\\n+            if (vmaxvq_u32(active) == 0u) {\\n+                break;\\n+            }\\n+\\n+            uint32x4_t mid = vshrq_n_u32(vaddq_u32(low, high), 1);\\n+            uint32x4_t safe_mid = vbslq_u32(active, mid, zero);\\n+            float probes[4] = {\\n+                distances[vgetq_lane_u32(safe_mid, 0)],\\n+                distances[vgetq_lane_u32(safe_mid, 1)],\\n+                distances[vgetq_lane_u32(safe_mid, 2)],\\n+                distances[vgetq_lane_u32(safe_mid, 3)]\\n+            };\\n+            uint32x4_t goes_left = vcltq_f32(targets, vld1q_f32(probes));\\n+\\n+            high = vbslq_u32(vandq_u32(active, goes_left), mid, high);\\n+         \"}, {\"id\": \"8de2794fb10e4ca9\", \"role\": \"C\", \"commit\": \"2a38629f6c374bf6b1c684e58de64bb8005c63eb\", \"transformations\": {\"files\": [\"src/knn.c\"], \"retained\": [\"Retain the parent selection path for k <= 64; use three exact radix-histogram passes for larger selections.\", \"Reuse one OpenMP team with contiguous balanced partitions, private histograms, and work-based thread granularity.\", \"Assign cutoff-distance ties in original input order and reduce private label counts, preserving character-order voting ties and sentinel padding.\"]}, \"mean_seconds\": 0.022465039665500324, \"diff\": \"diff --git a/src/knn.c b/src/knn.c\\nindex 337e3b9..7f22316 100644\\n--- a/src/knn.c\\n+++ b/src/knn.c\\n@@ -1,78 +1,486 @@\\n-#include \\\"knn.h\\\"\\n-\\n-char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n-    char * labels = (char *) malloc(sizeof(char) * k);\\n-    float * distances = (float *) malloc(sizeof(float) * k);\\n-\\n-    int i, j, x, y;\\n-\\n-    for (i = 0; i < k; i++) {\\n-        labels[i] = -1;\\n-        distances[i] = -1;\\n-    }\\n-\\n-    for (i = 0; i < n_groups; i++) {\\n-        Group g = groups[i];\\n-\\n-        for (j = 0; j < g.length; j++) {\\n-            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n-\\n-            for (x = 0; x < k; x++) {\\n-                if (d < distances[x] || distances[x] == -1) {\\n-                    for (y = k - 1; y > x; y--) {\\n-                        distances[y] = distances[y - 1];\\n-                        labels[y] = labels[y - 1];\\n-                    }\\n-\\n-                    distances[x] = d;\\n-                    labels[x] = g.label;\\n-\\n-                    break;\\n-                }\\n-            }\\n-        }\\n-    }\\n-\\n-    qsort(labels, k, sizeof(char), compare_for_sort);\\n-\\n-    char most_frequent = labels[0];\\n-    int most_frequent_count = 1;\\n-    int current_frequency = 1;\\n-\\n-    for (i = 1; i < k; i++) {\\n-        if (labels[i] != labels[i - 1]) {\\n-            if (current_frequency > most_frequent_count) {\\n-                most_frequent = labels[i - 1];\\n-                most_frequent_count = current_frequency;\\n-            }\\n-\\n-            current_frequency = 1;\\n-        } else {\\n-            current_frequency++;\\n-        }\\n-\\n-        if (i == k - 1 && current_frequency > most_frequent_count) {\\n-            most_frequent = labels[i - 1];\\n-            most_frequent_count = current_frequency;\\n-        }\\n-    }\\n-\\n-\\n-    return most_frequent;\\n-}\\n-\\n-int main() {\\n-    int n_groups = parse_number_of_groups();\\n-    \\n-    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n-\\n-    for (int i = 0; i < n_groups; i++) {\\n-        groups[i] = parse_next_group();\\n-    }\\n-\\n-    int k = parse_k();\\n-\\n-    Point to_evaluate = parse_point();\\n-\\n-    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n-}\\n\\\\ No newline at end of file\\n+#include \\\"knn.h\\\"\\n+#include <limits.h>\\n+#include <stdint.h>\\n+#include <string.h>\\n+\\n+#ifdef _OPENMP\\n+#include <omp.h>\\n+#endif\\n+\\n+typedef struct {\\n+    float *distances;\\n+    char *labels;\\n+    size_t count;\\n+    size_t next;\\n+} KnnRun;\\n+\\n+static char knn_vote(char *labels, int k) {\\n+    qsort(labels, k, sizeof(char), compare_for_sort);\\n+\\n+    char most_frequent = labels[0];\\n+    int most_frequent_count = 1;\\n+    int current_frequency = 1;\\n+\\n+    for (int i = 1; i < k; i++) {\\n+        if (labels[i] != labels[i - 1]) {\\n+            if (current_frequency > most_frequent_count) {\\n+                most_frequent = labels[i - 1];\\n+                most_frequent_count = current_frequency;\\n+            }\\n+            current_frequency = 1;\\n+        } else {\\n+            current_frequency++;\\n+        }\\n+\\n+        if (i == k - 1 && current_frequency > most_frequent_count) {\\n+            most_frequent = labels[i - 1];\\n+            most_frequent_count = current_frequency;\\n+        }\\n+    }\\n+\\n+    return most_frequent;\\n+}\\n+\\n+static char knn_serial(int n_groups, Group *groups, int k, Point to_evaluate) {\\n+    char *labels = (char *) malloc(sizeof(char) * k);\\n+    float *distances = (float *) malloc(sizeof(float) * k);\\n+\\n+    for (int i = 0; i < k; i++) {\\n+        labels[i] = -1;\\n+        distances[i] = -1;\\n+    }\\n+\\n+    for (int i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+        for (int j = 0; j < g.length; j++) {\\n+            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n+            for (int x = 0; x < k; x++) {\\n+                if (d < distances[x] || distances[x] == -1) {\\n+                    for (int y = k - 1; y > x; y--) {\\n+                        distances[y] = distances[y - 1];\\n+                        labels[y] = labels[y - 1];\\n+                    }\\n+                    distances[x] = d;\\n+                    labels[x] = g.label;\\n+                    break;\\n+                }\\n+            }\\n+        }\\n+    }\\n+\\n+    char result = knn_vote(labels, k);\\n+    free(distances);\\n+    free(labels);\\n+    return result;\\n+}\\n+\\n+static int knn_build_run(int n_groups, const Group *groups, int k,\\n+                         Point to_evaluate, size_t skip, size_t remaining,\\n+                         KnnRun *run) {\\n+    const size_t capacity = remaining < (size_t) k ? remaining : (size_t) k;\\n+    if (capacity == 0) return 0;\\n+\\n+    run->distances = (float *) malloc(sizeof(float) * capacity);\\n+    run->labels = (char *) malloc(sizeof(char) * capacity);\\n+    if (run->distances == NULL || run->labels == NULL) return 1;\\n+\\n+    size_t used = 0;\\n+    for (int i = 0; i < n_groups && remaining > 0; i++) {\\n+        const Group g = groups[i];\\n+        const size_t length = g.length > 0 ? (size_t) g.length : 0;\\n+        if (skip >= length) {\\n+            skip -= length;\\n+            continue;\\n+        }\\n+\\n+        size_t end = length;\\n+        if (end - skip > remaining) end = skip + remaining;\\n+\\n+        for (size_t j = skip; j < end; j++) {\\n+            const float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n+            /* NaNs require the original, order-dependent scan. */\\n+            if (d != d) return 1;\\n+\\n+            if (used == capacity && !(d < run->distances[capacity - 1])) {\\n+                continue;\\n+            }\\n+\\n+            size_t position = used < capacity ? used : capacity - 1;\\n+            /* Strict comparison preserves input order for equal distances. */\\n+            while (position > 0 && d < run->distances[position - 1]) {\\n+                run->distances[position] = run->distances[position - 1];\\n+                run->labels[position] = run->labels[position - 1];\\n+                position--;\\n+            }\\n+            run->distances[position] = d;\\n+            run->labels[position] = g\"}], \"interactions\": [{\"sources\": [\"8803e6ff7d234ad7\", \"36accc1bb19641b9\", \"8de2794fb10e4ca9\"], \"outcome\": {\"binary_sha256\": \"8609ccf2679199c14e1835653aea7f027854b65eb38aecda16af59a684cc2cbf\", \"cache_key\": \"2d20e2eb240845baacc9e4499e13e173d6f43148fd367758dc0e4f08c581520e\", \"commit\": \"bbaafc76461ab2d3c86612a1001359dec35c0691\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/knn/logs/e1/aed5b91456954c83/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/knn/logs/e1/aed5b91456954c83/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-202
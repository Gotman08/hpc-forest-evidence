import hashlib,importlib.util,json,time
from pathlib import Path
HERE=Path(__file__).resolve().parent
OBS=HERE.parent/"observateur-mixte-r4b-r2"
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
read=lambda p:json.loads(Path(p).read_text(encoding="utf-8-sig"))
ref=lambda p:{"path":str(Path(p).resolve()),"sha256":sha(p)}
def save(p,v):
 with Path(p).open("x",encoding="utf-8",newline="\n") as stream:stream.write(json.dumps(v,ensure_ascii=False,indent=2)+"\n")
assert sha(OBS/"observer-mixte.py")=="24274ef848a2af68325f76a6cd891e0dc7fe8a22a04ed8d9efbf90d37c55471d"
assert sha(HERE/"politique-reelle.json")=="ab35ad511055b7ad142f4197ded1e3d14744e51ac76667ab24c89ea14434b9e5"
spec=importlib.util.spec_from_file_location("parent_passive_live_proof",OBS/"observer-mixte.py")
m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
raw=(OBS/"observer-state.json").read_bytes();state=json.loads(raw)
assert state["stage"]=="observing_transition_pending" and state["transition_verified"] is False and state["passive_only"] is True
assert 0<=time.time()-state["updated_at"]<120 and state["active_native_workers"]==1
status=state["observations"][m.SO_JOB]
assert status["ok"] is True and status["state"]=="RUNNING" and status["observation"]["current_state_observed"] is True
assert 0<=time.time()-status["observation"]["observed_at"]<120
policy=read(HERE/"politique-reelle.json");routes=read(HERE/"routes-reelles.json")
rows=m.census();_,hist,jobs,sessions,_,_=m.guard(policy,routes,{},rows)
assert set(sessions)=={m.SO_SESSION} and jobs=={m.SO_JOB}
new_pair=state["observer_full_identities"];m.verify_pair(new_pair,rows)
assert [p["ProcessId"] for p in new_pair]==[55512,57940]
assert new_pair[1]["ParentProcessId"]==new_pair[0]["ProcessId"]
m.verify_pair(policy["previous_reader_identities"],rows)
assert m.transition_state(policy,routes,rows,None) is False
assert (HERE/"nouvel-observateur.stderr.log").stat().st_size==0
assert not list(OBS.glob("refus-*.json"))
with (HERE/"etat-initial-mixte-lu.json").open("xb") as f:f.write(raw)
save(HERE/"identites-observateur-mixte.json",new_pair)
save(HERE/"cim-nouveau-lecteur-verifie.json",{"observed_at":time.time(),"complete_census":True,"rows":rows})
record={"schema":"hpc-forest-mixed-reader-startup-verified-v1","verified":True,"at":time.time(),"code":ref(OBS/"observer-mixte.py"),"policy":ref(HERE/"politique-reelle.json"),"source_only_observation":ref(HERE/"etat-initial-mixte-lu.json"),"reader_identities":new_pair,"source_only_identities":policy["source_only_full_identities"],"full_census":ref(HERE/"cim-nouveau-lecteur-verifie.json"),"source_only_observation_verified":True,"dynamic_native_worker_started":False,"only_read_only_rpc":True,"stage":"observing_transition_pending","old_reader_still_present":True,"native_generation_admitted":False}
save(HERE/"demarrage-mixte-reel-verifie.json",record)
print(json.dumps({"verified":True,"reader_pair":[p["ProcessId"] for p in new_pair],"source_only_running":True,"only_passive_rpc":True,"dynamic_started":False,"proof":ref(HERE/"demarrage-mixte-reel-verifie.json")}))


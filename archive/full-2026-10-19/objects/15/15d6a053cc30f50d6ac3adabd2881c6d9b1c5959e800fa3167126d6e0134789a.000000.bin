{"files":[{"content":"#include <bits/stdc++.h>\n\nusing namespace std;\n\nusing ll = long long;\n\nclass FrequencyTable {\n  struct Entry {\n    int key;\n    int count;\n    uint32_t generation;\n  };\n\n  static constexpr uint32_t kCapacity = 2048;\n  static constexpr uint32_t kMask = kCapacity - 1;\n  array<Entry, kCapacity> entries_{};\n  uint32_t generation_ = 0;\n\n  static inline uint32_t hash_key(int key) {\n    uint32_t value = static_cast<uint32_t>(key);\n    value ^= value >> 16;\n    value *= 0x7feb352dU;\n    value ^= value >> 15;\n    return value & kMask;\n  }\n\n public:\n  inline void reset() {\n    ++generation_;\n    if (generation_ == 0) {\n      for (Entry &entry : entries_) entry.generation = 0;\n      generation_ = 1;\n    }\n  }\n\n  inline int count(int key) const {\n    uint32_t slot = hash_key(key);\n    while (entries_[slot].generation == generation_) {\n      if (entries_[slot].key == key) return entries_[slot].count;\n      slot = (slot + 1) & kMask;\n    }\n    return 0;\n  }\n\n  inline void increment(int key) {\n    uint32_t slot = hash_key(key);\n    while (entries_[slot].generation == generation_) {\n      if (entries_[slot].key == key) {\n        ++entries_[slot].count;\n        return;\n      }\n      slot = (slot + 1) & kMask;\n    }\n    entries_[slot] = {key, 1, generation_};\n  }\n\n  inline int increment_and_previous_count(int key) {\n    uint32_t slot = hash_key(key);\n    while (entries_[slot].generation == generation_) {\n      if (entries_[slot].key == key) return entries_[slot].count++;\n      slot = (slot + 1) & kMask;\n    }\n    entries_[slot] = {key, 1, generation_};\n    return 0;\n  }\n};\n\nstatic ll solve(const vector<int> &oriented, int boundary_count, int scan_count,\n                int target) {\n  vector<int> accumulated(scan_count);\n  FrequencyTable frequency;\n  ll answer = 0;\n\n  for (int first = 0; first < boundary_count; ++first) {\n    fill(accumulated.begin(), accumulated.end(), 0);\n\n    for (int last = first; last < boundary_count; ++last) {\n      const int *column = oriented.data() + static_cast<size_t>(last) * scan_count;\n      int *sums = accumulated.data();\n      for (int index = 0; index < scan_count; ++index) {\n        sums[index] += column[index];\n      }\n\n      frequency.reset();\n      frequency.increment(0);\n      int prefix = 0;\n\n      if (target == 0) {\n        for (int index = 0; index < scan_count; ++index) {\n          prefix += sums[index];\n          answer += frequency.increment_and_previous_count(prefix);\n        }\n      } else {\n        for (int index = 0; index < scan_count; ++index) {\n          prefix += sums[index];\n          answer += frequency.count(prefix - target);\n          frequency.increment(prefix);\n        }\n      }\n    }\n  }\n\n  return answer;\n}\n\nint main() {\n  ios::sync_with_stdio(false);\n  cin.tie(nullptr);\n\n  int k, m, n;\n  cin >> k >> m >> n;\n\n  const bool columns_are_boundaries = m >= n;\n  const int boundary_count = columns_are_boundaries ? n : m;\n  const int scan_count = columns_are_boundaries ? m : n;\n  vector<int> oriented(static_cast<size_t>(boundary_count) * scan_count);\n\n  for (int row = 0; row < m; ++row) {\n    for (int column = 0; column < n; ++column) {\n      int value;\n      cin >> value;\n      if (columns_are_boundaries) {\n        oriented[static_cast<size_t>(column) * scan_count + row] = value;\n      } else {\n        oriented[static_cast<size_t>(row) * scan_count + column] = value;\n      }\n    }\n  }\n\n  cout << solve(oriented, boundary_count, scan_count, k) << '\\n';\n  return 0;\n}\n","path":"src/main.cpp"}],"hypothesis":"Normalizing the smaller matrix dimension as the boundary-pair dimension and storing each expandable boundary strip contiguously improves locality; a small generation-tagged flat frequency table keeps per-scan prefix counting in cache and removes repeated node allocation/probing overhead.","notes":"One bounded serial locality/data-layout experiment; preserves rectangular orientation symmetry, negative values, and 64-bit result accumulation.","research":{"queries":[],"urls":[]},"sources_kept":[],"transformations":["Orient the matrix so boundary pairs span min(M,N), while the scanned dimension is contiguous within each stored strip.","Replace row-prefix accesses with rolling contiguous strip accumulation for each boundary pair.","Replace per-scan unordered_map clearing with a fixed-capacity, generation-tagged open-addressed frequency table sized for every valid scan length.","Use buffered C++ stream configuration without changing the input or output format."]}
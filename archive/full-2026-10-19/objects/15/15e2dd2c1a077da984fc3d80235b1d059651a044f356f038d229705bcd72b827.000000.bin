{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdint.h>\n\n#define N_ITER 10\n#define DT 0.01f\n#define SOFTENING 1e-9f\n#define FORCE_TILE 48\n#define FORCE_LANES 8\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nstatic inline void body_force_one(Body *p, float dt, int n, int i) {\n  float fx = 0.0f;\n  float fy = 0.0f;\n  float fz = 0.0f;\n\n  for (int j = 0; j < n; ++j) {\n    float dx = p[j].x - p[i].x;\n    float dy = p[j].y - p[i].y;\n    float dz = p[j].z - p[i].z;\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n    fx += dx * inv_dist3;\n    fy += dy * inv_dist3;\n    fz += dz * inv_dist3;\n  }\n\n  p[i].vx += dt*fx;\n  p[i].vy += dt*fy;\n  p[i].vz += dt*fz;\n}\n\nvoid body_force(Body *p, float dt, int n) {\n  #pragma omp parallel for schedule(static) if(n >= 2 * FORCE_TILE)\n  for (int i = 0; i < n; ++i) {\n    body_force_one(p, dt, n, i);\n  }\n}\n\nstatic void direct_simulation(Body *p, int n) {\n  #pragma omp parallel if(n >= 2 * FORCE_TILE)\n  {\n    for (int iter = 0; iter < N_ITER; ++iter) {\n      #pragma omp for schedule(static)\n      for (int i = 0; i < n; ++i) {\n        body_force_one(p, DT, n, i);\n      }\n      #pragma omp for schedule(static)\n      for (int i = 0; i < n; ++i) {\n        p[i].x += p[i].vx * DT;\n        p[i].y += p[i].vy * DT;\n        p[i].z += p[i].vz * DT;\n      }\n    }\n  }\n}\n\n/* Called only with finite coordinates and positive softened distances. */\n#if defined(__GNUC__) && !defined(__clang__) && !defined(__INTEL_COMPILER)\n__attribute__((optimize(\"no-math-errno\")))\n#endif\nstatic void make_tile(const float *restrict x,\n                      const float *restrict y,\n                      const float *restrict z,\n                      int a, int na, int b, int nb,\n                      float *restrict coefficient) {\n  for (int j = 0; j < nb; ++j) {\n    const float sx = x[b+j];\n    const float sy = y[b+j];\n    const float sz = z[b+j];\n    #pragma omp simd\n    for (int i = 0; i < na; ++i) {\n      float dx = sx - x[a+i];\n      float dy = sy - y[a+i];\n      float dz = sz - z[a+i];\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n      coefficient[j*FORCE_TILE+i] = inv_dist3;\n    }\n  }\n}\n\n/* SIMD lanes are destinations; each lane visits sources sequentially. */\nstatic void accumulate_tile(const float *restrict x,\n                            const float *restrict y,\n                            const float *restrict z,\n                            float *restrict fx,\n                            float *restrict fy,\n                            float *restrict fz,\n                            int d, int nd, int s, int ns,\n                            const float *restrict coefficient) {\n  int k = 0;\n  for (; k + FORCE_LANES <= nd; k += FORCE_LANES) {\n    float ax[FORCE_LANES], ay[FORCE_LANES], az[FORCE_LANES];\n    float px[FORCE_LANES], py[FORCE_LANES], pz[FORCE_LANES];\n    #pragma omp simd\n    for (int lane = 0; lane < FORCE_LANES; ++lane) {\n      ax[lane] = fx[d+k+lane];\n      ay[lane] = fy[d+k+lane];\n      az[lane] = fz[d+k+lane];\n      px[lane] = x[d+k+lane];\n      py[lane] = y[d+k+lane];\n      pz[lane] = z[d+k+lane];\n    }\n    for (int j = 0; j < ns; ++j) {\n      const float sx = x[s+j];\n      const float sy = y[s+j];\n      const float sz = z[s+j];\n      const float *c = coefficient + j*FORCE_TILE + k;\n      #pragma omp simd\n      for (int lane = 0; lane < FORCE_LANES; ++lane) {\n        float dx = sx - px[lane];\n        float dy = sy - py[lane];\n        float dz = sz - pz[lane];\n        ax[lane] += dx * c[lane];\n        ay[lane] += dy * c[lane];\n        az[lane] += dz * c[lane];\n      }\n    }\n    #pragma omp simd\n    for (int lane = 0; lane < FORCE_LANES; ++lane) {\n      fx[d+k+lane] = ax[lane];\n      fy[d+k+lane] = ay[lane];\n      fz[d+k+lane] = az[lane];\n    }\n  }\n  for (; k < nd; ++k) {\n    float ax = fx[d+k];\n    float ay = fy[d+k];\n    float az = fz[d+k];\n    const float px = x[d+k];\n    const float py = y[d+k];\n    const float pz = z[d+k];\n    for (int j = 0; j < ns; ++j) {\n      float dx = x[s+j] - px;\n      float dy = y[s+j] - py;\n      float dz = z[s+j] - pz;\n      float c = coefficient[j*FORCE_TILE+k];\n      ax += dx * c;\n      ay += dy * c;\n      az += dz * c;\n    }\n    fx[d+k] = ax;\n    fy[d+k] = ay;\n    fz[d+k] = az;\n  }\n}\n\nstatic void simulate(Body *p, int n) {\n  if (n < 2 * FORCE_TILE) {\n    direct_simulation(p, n);\n    return;\n  }\n\n  const size_t stride = ((size_t)n + 15u) & ~(size_t)15u;\n  if (stride > (SIZE_MAX - 63u) / (6u * sizeof(float))) {\n    direct_simulation(p, n);\n    return;\n  }\n  void *allocation = malloc(6u * stride * sizeof(float) + 63u);\n  if (allocation == NULL) {\n    direct_simulation(p, n);\n    return;\n  }\n  float *x = (float *)(((uintptr_t)allocation + 63u) & ~(uintptr_t)63u);\n  float *y = x + stride;\n  float *z = y + stride;\n  float *fx = z + stride;\n  float *fy = fx + stride;\n  float *fz = fy + stride;\n  const int ntiles = (n - 1) / FORCE_TILE + 1;\n  int nonfinite = 0;\n\n  #pragma omp parallel\n  {\n    float coefficient[FORCE_TILE*FORCE_TILE];\n    float transposed[FORCE_TILE*FORCE_TILE];\n    for (int iter = 0; iter < N_ITER; ++iter) {\n      #pragma omp single\n      {\n        nonfinite = 0;\n      }\n      #pragma omp for schedule(static) reduction(|:nonfinite)\n      for (int i = 0; i < n; ++i) {\n        x[i] = p[i].x;\n        y[i] = p[i].y;\n        z[i] = p[i].z;\n        fx[i] = 0.0f;\n        fy[i] = 0.0f;\n        fz[i] = 0.0f;\n        nonfinite |= !(isfinite(x[i]) && isfinite(y[i]) && isfinite(z[i]));\n      }\n\n      if (nonfinite) {\n        #pragma omp for schedule(static)\n        for (int i = 0; i < n; ++i) {\n          body_force_one(p, DT, n, i);\n        }\n      } else {\n        /* Tile pairs on one anti-diagonal have disjoint destinations.\n           For any row block r, partner blocks arrive in ascending order. */\n        for (int wave = 0; wave <= 2 * (ntiles - 1); ++wave) {\n          const int first = wave < ntiles ? 0 : wave - ntiles + 1;\n          const int last = wave / 2;\n          #pragma omp for schedule(static)\n          for (int a = first; a <= last; ++a) {\n            const int b = wave - a;\n            const int alo = a * FORCE_TILE;\n            const int blo = b * FORCE_TILE;\n            int na = n - alo;\n            int nb = n - blo;\n            if (na > FORCE_TILE) na = FORCE_TILE;\n            if (nb > FORCE_TILE) nb = FORCE_TILE;\n\n            make_tile(x, y, z, alo, na, blo, nb, coefficient);\n            accumulate_tile(x, y, z, fx, fy, fz,\n                            alo, na, blo, nb, coefficient);\n            if (a != b) {\n              for (int i = 0; i < na; ++i) {\n                #pragma omp simd\n                for (int j = 0; j < nb; ++j) {\n                  transposed[i*FORCE_TILE+j] = coefficient[j*FORCE_TILE+i];\n                }\n              }\n              accumulate_tile(x, y, z, fx, fy, fz,\n                              blo, nb, alo, na, transposed);\n            }\n          }\n        }\n        #pragma omp for schedule(static)\n        for (int i = 0; i < n; ++i) {\n          p[i].vx += DT*fx[i];\n          p[i].vy += DT*fy[i];\n          p[i].vz += DT*fz[i];\n        }\n      }\n\n      #pragma omp for schedule(static)\n      for (int i = 0; i < n; ++i) {\n        p[i].x += p[i].vx * DT;\n        p[i].y += p[i].vy * DT;\n        p[i].z += p[i].vz * DT;\n      }\n    }\n  }\n  free(allocation);\n}\n\n/* Read a binary dataset with initialized bodies. */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/* Write simulation results into a binary dataset. */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n  Body *bodies = read_dataset(&nbodies);\n\n  simulate(bodies, nbodies);\n\n  write_dataset(nbodies, bodies);\n  free(bodies);\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Anti-diagonal OpenMP sharing of symmetric force tiles can halve distance evaluations without a quadratic coefficient matrix while preserving each body's reference summation order.",
  "notes": "Uses 48-body tiles, eight independent SIMD destinations, and linear shared workspace. Nonfinite positions, small sizes, and allocation failures use direct forces. No commands or measurements performed.",
  "sources_kept": [],
  "transformations": [
    "Keep one persistent OpenMP team and statically share disjoint tile pairs along anti-diagonals.",
    "Use thread-private coefficient tiles and cache-line-aligned force arrays to avoid concurrent boundary writes.",
    "Reuse off-diagonal inverse-distance cubes in both directions while accumulating source blocks and source bodies in ascending order.",
    "Vectorize independent destinations without floating-point reductions; retain double sqrt and division, enabling errno-free coefficient production for GCC."
  ]
}
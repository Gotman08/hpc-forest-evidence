      "content": "#include \"knn.h\"\n#include <omp.h>\n\ntypedef struct {\n    float d;\n    long idx;\n    char label;\n} Candidate;\n\nstatic inline int worse(Candidate a, Candidate b) {\n    if (a.d != b.d) return a.d > b.d;\n    return a.idx > b.idx;\n}\n\nstatic void heap_push(Candidate *heap, int *n, Candidate c) {\n    int i = (*n)++;\n    heap[i] = c;\n    while (i > 0) {\n        int parent = (i - 1) / 2;\n        if (worse(heap[parent], heap[i])) {\n            Candidate tmp = heap[parent];\n            heap[parent] = heap[i];\n            heap[i] = tmp;\n            i = parent;\n        } else break;\n    }\n}\n\nstatic void heap_replace_root(Candidate *heap, int n, Candidate c) {\n    heap[0] = c;\n    int i = 0;\n    for (;;) {\n        int left = 2*i + 1;\n        if (left >= n) break;\n        int right = left + 1;\n        int worst = i;\n        if (worse(heap[left], heap[worst])) worst = left;\n        if (right < n && worse(heap[right], heap[worst])) worst = right;\n        if (worst == i) break;\n        Candidate tmp = heap[i];\n        heap[i] = heap[worst];\n        heap[worst] = tmp;\n        i = worst;\n    }\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    long total = 0;\n    for (int gi = 0; gi < n_groups; ++gi) {\n        total += groups[gi].length;\n    }\n\n    float * restrict xs = NULL;\n    float * restrict ys = NULL;\n    char *plabels = NULL;\n    if (posix_memalign((void **)&xs, 64, (total > 0 ? total : 1) * sizeof(float)) != 0) {\n        xs = malloc((total > 0 ? total : 1) * sizeof(float));\n    }\n    if (posix_memalign((void **)&ys, 64, (total > 0 ? total : 1) * sizeof(float)) != 0) {\n        ys = malloc((total > 0 ? total : 1) * sizeof(float));\n    }\n    plabels = (char *)malloc((total > 0 ? total : 1) * sizeof(char));\n\n    long idx = 0;\n    for (int gi = 0; gi < n_groups; ++gi) {\n        Group g = groups[gi];\n        char lab = g.label;\n        for (int j = 0; j < g.length; ++j) {\n            xs[idx] = g.points[j].x;\n            ys[idx] = g.points[j].y;\n            plabels[idx] = lab;\n            ++idx;\n        }\n    }\n\n    float * restrict dists = NULL;\n    if (posix_memalign((void **)&dists, 64, (total > 0 ? total : 1) * sizeof(float)) != 0) {\n        dists = malloc((total > 0 ? total : 1) * sizeof(float));\n    }\n    float tx = to_evaluate.x;\n    float ty = to_evaluate.y;\n\n#pragma omp parallel for simd schedule(static) aligned(xs, ys, dists: 64)\n    for (long p = 0; p < total; ++p) {\n        float dx = xs[p] - tx;\n        float dy = ys[p] - ty;\n        dists[p] = dx * dx + dy * dy;\n    }\n\n    int nt = omp_get_max_threads();\n    if (nt < 1) nt = 1;\n    Candidate **thread_best = (Candidate **)calloc(nt, sizeof(Candidate *));\n    int *counts = (int *)calloc(nt, sizeof(int));\n    for (int t = 0; t < nt; ++t) {\n        thread_best[t] = (Candidate *)malloc((k > 0 ? k : 1) * sizeof(Candidate));\n        counts[t] = 0;\n    }\n\n#pragma omp parallel\n    {\n        int tid = omp_get_thread_num();\n        Candidate *local = thread_best[tid];\n        int cnt = 0;\n\n#pragma omp for schedule(static)\n        for (long p = 0; p < total; ++p) {\n            float d = dists[p];\n            Candidate c;\n            c.d = d;\n            c.idx = p;\n            c.label = plabels[p];\n\n            if (cnt < k) {\n                heap_push(local, &cnt, c);\n            } else if (worse(local[0], c)) {\n                heap_replace_root(local, cnt, c);\n            }\n        }\n\n        counts[tid] = cnt;\n    }\n\n    Candidate *merged = (Candidate *)malloc((k > 0 ? k : 1) * sizeof(Candidate));\n    int mc = 0;\n    for (int t = 0; t < nt; ++t) {\n        for (int j = 0; j < counts[t]; ++j) {\n            Candidate c = thread_best[t][j];\n            if (mc < k) {\n                heap_push(merged, &mc, c);\n            } else if (worse(merged[0], c)) {\n                heap_replace_root(merged, mc, c);\n            }\n        }\n    }\n\n    int counts_labels[256] = {0};\n    for (int i = 0; i < mc && i < k; ++i) {\n        unsigned char lab = (unsigned char)merged[i].label;\n        counts_labels[lab]++;\n    }\n    if (mc < k) {\n        int missing = k - mc;\n        counts_labels[(unsigned char)-1] += missing;\n    }\n\n    int best_count = -1;\n    char best_label = 0;\n    for (int c = 0; c < 256; ++c) {\n        if (counts_labels[c] > best_count) {\n            best_count = counts_labels[c];\n            best_label = (char)c;\n        }\n    }\n\n    free(xs);\n    free(ys);\n    free(dists);\n    free(plabels);\n    for (int t = 0; t < nt; ++t) free(thread_best[t]);\n    free(thread_best);\n    free(counts);\n    free(merged);\n\n    return best_label;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n\n    for (int i = 0; i < n_groups; ++i) free(groups[i].points);\n    free(groups);\n\n    return 0;\n}\n",
      "path": "src/knn.c"
    },
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n",
      "path": "src/knn.h"
    }
  ],
  "hypothesis": "Integrating flattened contiguous storage with aligned OpenMP SIMD distance computation and per-thread max-heaps keyed by exact (distance, global index) ordering should reduce runtime while preserving reference semantics including sentinel handling when fewer than k points exist.",
  "notes": "Combined ideas from all three sources: flattening into xs/ys/labels arrays (A,C), aligned allocations with restrict and size_t indices (B), OpenMP SIMD distance loop (B,C), per-thread top-k heaps with merge (C) using binary heap tie-breaking by original index (A). Added sentinel -1 labels for missing slots to match baseline behavior when total < k. Removed unused helper functions from header.",

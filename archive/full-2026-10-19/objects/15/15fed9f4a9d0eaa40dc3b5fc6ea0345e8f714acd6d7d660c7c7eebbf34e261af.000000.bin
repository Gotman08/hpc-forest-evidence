"""Seal preparation metadata only; never run a reader or open received archive."""
from pathlib import Path
import hashlib
import json

HERE = Path(__file__).resolve().parent
REVIEW = HERE.parent

def ref(path):
    value = path.read_bytes()
    return {"path": str(path), "sha256": hashlib.sha256(value).hexdigest(), "bytes": len(value)}

report = {"schema": "hpc-forest-Q753709-existing-regular-audit-r4b-preparation-v1",

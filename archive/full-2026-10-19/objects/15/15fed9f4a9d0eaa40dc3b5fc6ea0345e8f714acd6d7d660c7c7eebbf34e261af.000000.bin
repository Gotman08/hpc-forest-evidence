          "native_ctime_semantics_proof": ref(REVIEW / "lecteur-r3/PREUVE-NTFS-CPYTHON-CTIME-NEUTRE.json"),
          "historical_prior36_before": ref(REVIEW / "INVENTAIRE-RECUS-AVANT.json"),
          "historical_prior36_after": ref(REVIEW / "INVENTAIRE-RECUS-APRES.json"),
          "preserved_previous_reader": ref(REVIEW / "lecteur-r4/auditer-restauration-existante-r4.py"),
          "actual_transfer_proof": ref(REVIEW.parent / "livraison-seule-r1/transferts-archive-sidecars-3SHA.json"),
          "exact_existing_restoration": str(REVIEW / "lecteur-r3/restauration-neuve-root-01"),
          "existing690_restoration_modified_reextracted_or_read_by_this_sealing": False,
          "tests265_reexecuted": False, "source_or_received_code_executed": False,
          "complete_Q_or_native_generation_admitted": False,
          "changes": ["Require both exact pinned historical36 inventories", "Require prior input directory and full36 inventory before/after",
                      "Require every prior row SHA and size to equal recovered bytes; no empty traversal can pass"],
          "unchanged": ["Windows native readonly and exact .exe name mode projection", "Separate complete lstat/fstat/native baselines",
                        "No-follow held reads, canonical traversal guard, BytesIO archive snapshot", "Audit existing690 only; no extraction or writes to received data"],
          "parent_command_interface": {"reader": "auditer-restauration-existante-r4b.py",
                "flags_unchanged_from_r4": True, "required_audit_flag": "--audit-existing-restoration",
                "transfer_proof_sha256": "1059b14da2e96e266b78e4c77c914db10c1129724eac21bf8600eff00276fc3b"}}
path = HERE / "LIVRAISON-AUDIT-EXISTANT-R4B-POUR-REVUE.json"
with path.open("x", encoding="utf8", newline="\n") as out:
    json.dump(report, out, indent=2); out.write("\n")
print(json.dumps(ref(path)))

{
  "files": [
    {
      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <algorithm>\n#include <cstdint>\n#include <limits>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n\nstatic inline int64x2_t maximum64(int64x2_t a, int64x2_t b) {\n    return vbslq_s64(vcgtq_s64(a, b), a, b);\n}\n#endif\n\nint main() {\n    int n, s;\n    std::cin >> n >> s;\n    std::vector<std::vector<int> > matrix(n, std::vector<int>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            scanf(\"%d\", &(matrix[i][j]));\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    std::vector<std::int64_t> columns(n, 0);\n    std::int64_t* const col = columns.data();\n    for (int i = 0; i < s; ++i) {\n        const int* const row = matrix[i].data();\n        for (int j = 0; j < n; ++j)\n            col[j] += static_cast<std::int64_t>(row[j]);\n    }\n\n    const int shifts = n - s;\n    std::int64_t best = std::numeric_limits<std::int64_t>::min();\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const int64x2_t zero = vdupq_n_s64(0);\n    int64x2_t best0 = vdupq_n_s64(best);\n    int64x2_t best1 = vdupq_n_s64(best);\n#endif\n\n    for (int top = 0; top <= shifts; ++top) {\n        std::int64_t sum = 0;\n        for (int j = 0; j < s; ++j)\n            sum += col[j];\n        best = std::max(best, sum);\n\n        int j = 0;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n        int64x2_t carry = vdupq_n_s64(sum);\n\n        // Horizontal shifts form a prefix scan, not independent iterations.\n        // Scan four differences per block, carrying only the final window.\n        for (; j + 4 <= shifts; j += 4) {\n            const int64x2_t delta0 = vsubq_s64(\n                vld1q_s64(col + j + s), vld1q_s64(col + j));\n            const int64x2_t delta1 = vsubq_s64(\n                vld1q_s64(col + j + s + 2), vld1q_s64(col + j + 2));\n\n            const int64x2_t prefix0 = vaddq_s64(\n                delta0, vextq_s64(zero, delta0, 1));\n            const int64x2_t pair1 = vaddq_s64(\n                delta1, vextq_s64(zero, delta1, 1));\n            const int64x2_t prefix1 = vaddq_s64(\n                pair1, vdupq_n_s64(vgetq_lane_s64(prefix0, 1)));\n\n            const int64x2_t windows0 = vaddq_s64(carry, prefix0);\n            const int64x2_t windows1 = vaddq_s64(carry, prefix1);\n            best0 = maximum64(best0, windows0);\n            best1 = maximum64(best1, windows1);\n            carry = vdupq_n_s64(vgetq_lane_s64(windows1, 1));\n        }\n\n        if (j + 2 <= shifts) {\n            const int64x2_t delta = vsubq_s64(\n                vld1q_s64(col + j + s), vld1q_s64(col + j));\n            const int64x2_t prefix = vaddq_s64(\n                delta, vextq_s64(zero, delta, 1));\n            const int64x2_t windows = vaddq_s64(carry, prefix);\n            best0 = maximum64(best0, windows);\n            carry = vdupq_n_s64(vgetq_lane_s64(windows, 1));\n            j += 2;\n        }\n        sum = vgetq_lane_s64(carry, 0);\n#endif\n\n        for (; j < shifts; ++j) {\n            sum += col[j + s] - col[j];\n            best = std::max(best, sum);\n        }\n\n        if (top == shifts)\n            break;\n\n        const int* const exiting = matrix[top].data();\n        const int* const entering = matrix[top + s].data();\n        // Each column update is independent and can be vectorized legally.\n        for (int c = 0; c < n; ++c) {\n            col[c] += static_cast<std::int64_t>(entering[c])\n                    - static_cast<std::int64_t>(exiting[c]);\n        }\n    }\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    best0 = maximum64(best0, best1);\n    best = std::max(best, vgetq_lane_s64(best0, 0));\n    best = std::max(best, vgetq_lane_s64(best0, 1));\n#endif\n\n    printf(\"%lld\\n\", static_cast<long long>(best));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "An O(N²) rolling-column algorithm with independent column updates and four-window NEON prefix scans should reduce boundary-rescan work and amortize horizontal loop dependencies on ARM64.",
  "notes": "Unmeasured source-only proposal. Preserves input/output bytes, requires no threading or build changes, and includes scalar tails and a non-NEON fallback.",
  "sources_kept": [],
  "transformations": [
    "Replace serpentine S-element boundary rescans with contiguous, independently vectorizable rolling-column updates.",
    "Use legal AArch64 NEON prefix scans for horizontal window differences, with two independent vector maximum accumulators.",
    "Widen operands before subtraction and retain all partial sums and maxima in 64-bit integers."
  ]

        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/* Positions and velocities of one body. */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/* Force-only operation, also used by the allocation-failure fallback. */\nvoid body_force(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\nstatic inline void advance_one(const Body *restrict p,\n                               Body *restrict next,\n                               float dt, int n, int i) {\n  const float x = p[i].x;\n  const float y = p[i].y;\n  const float z = p[i].z;\n  float fx = 0.0f;\n  float fy = 0.0f;\n  float fz = 0.0f;\n\n  for (int j = 0; j < n; ++j) {\n    float dx = p[j].x - x;\n    float dy = p[j].y - y;\n    float dz = p[j].z - z;\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n    fx += dx * inv_dist3;\n    fy += dy * inv_dist3;\n    fz += dz * inv_dist3;\n  }\n\n  const float vx = p[i].vx + dt*fx;\n  const float vy = p[i].vy + dt*fy;\n  const float vz = p[i].vz + dt*fz;\n  next[i].vx = vx;\n  next[i].vy = vy;\n  next[i].vz = vz;\n  next[i].x = x + vx*dt;\n  next[i].y = y + vy*dt;\n  next[i].z = z + vz*dt;\n}\n\n/* Each work item advances three bodies without reordering any force sum. */\nstatic inline void advance_three(const Body *restrict p,\n                                 Body *restrict next,\n                                 float dt, int n, int i) {\n  const float x0 = p[i].x;\n  const float y0 = p[i].y;\n  const float z0 = p[i].z;\n  const float x1 = p[i + 1].x;\n  const float y1 = p[i + 1].y;\n  const float z1 = p[i + 1].z;\n  const float x2 = p[i + 2].x;\n  const float y2 = p[i + 2].y;\n  const float z2 = p[i + 2].z;\n  float fx0 = 0.0f, fy0 = 0.0f, fz0 = 0.0f;\n  float fx1 = 0.0f, fy1 = 0.0f, fz1 = 0.0f;\n  float fx2 = 0.0f, fy2 = 0.0f, fz2 = 0.0f;\n\n  for (int j = 0; j < n; ++j) {\n    const float sx = p[j].x;\n    const float sy = p[j].y;\n    const float sz = p[j].z;\n\n    float dx = sx - x0;\n    float dy = sy - y0;\n    float dz = sz - z0;\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n    fx0 += dx * inv_dist3;\n    fy0 += dy * inv_dist3;\n    fz0 += dz * inv_dist3;\n\n    dx = sx - x1;\n    dy = sy - y1;\n    dz = sz - z1;\n    sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    inv_dist = 1 / sqrt(sqrd_dist);\n    inv_dist3 = inv_dist * inv_dist * inv_dist;\n    fx1 += dx * inv_dist3;\n    fy1 += dy * inv_dist3;\n    fz1 += dz * inv_dist3;\n\n    dx = sx - x2;\n    dy = sy - y2;\n    dz = sz - z2;\n    sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    inv_dist = 1 / sqrt(sqrd_dist);\n    inv_dist3 = inv_dist * inv_dist * inv_dist;\n    fx2 += dx * inv_dist3;\n    fy2 += dy * inv_dist3;\n    fz2 += dz * inv_dist3;\n  }\n\n  const float vx0 = p[i].vx + dt*fx0;\n  const float vy0 = p[i].vy + dt*fy0;\n  const float vz0 = p[i].vz + dt*fz0;\n  next[i].vx = vx0;\n  next[i].vy = vy0;\n  next[i].vz = vz0;\n  next[i].x = x0 + vx0*dt;\n  next[i].y = y0 + vy0*dt;\n  next[i].z = z0 + vz0*dt;\n\n  const float vx1 = p[i + 1].vx + dt*fx1;\n  const float vy1 = p[i + 1].vy + dt*fy1;\n  const float vz1 = p[i + 1].vz + dt*fz1;\n  next[i + 1].vx = vx1;\n  next[i + 1].vy = vy1;\n  next[i + 1].vz = vz1;\n  next[i + 1].x = x1 + vx1*dt;\n  next[i + 1].y = y1 + vy1*dt;\n  next[i + 1].z = z1 + vz1*dt;\n\n  const float vx2 = p[i + 2].vx + dt*fx2;\n  const float vy2 = p[i + 2].vy + dt*fy2;\n  const float vz2 = p[i + 2].vz + dt*fz2;\n  next[i + 2].vx = vx2;\n  next[i + 2].vy = vy2;\n  next[i + 2].vz = vz2;\n  next[i + 2].x = x2 + vx2*dt;\n  next[i + 2].y = y2 + vy2*dt;\n  next[i + 2].z = z2 + vz2*dt;\n}\n\n/* Read a binary dataset with initialized bodies. */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/* Write simulation results into a binary dataset. */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc, char **argv) {\n  int nbodies;\n  Body *bodies = read_dataset(&nbodies);\n  Body *scratch = (Body *)malloc((size_t)nbodies * sizeof(Body));\n  Body *result = bodies;\n\n  if (scratch != NULL) {\n    const int nblocks = nbodies / 3 + (nbodies % 3 != 0);\n\n    #pragma omp parallel if (nblocks >= 4)\n    {\n      Body *current = bodies;\n      Body *next = scratch;\n\n      for (int iter = 0; iter < N_ITER; ++iter) {\n        #pragma omp for schedule(static)\n        for (int block = 0; block < nblocks; ++block) {\n          const int i = 3 * block;\n          if (nbodies - i >= 3) {\n            advance_three(current, next, DT, nbodies, i);\n          } else {\n            for (int k = i; k < nbodies; ++k) {\n              advance_one(current, next, DT, nbodies, k);\n            }\n          }\n        }\n\n        /* The worksharing barrier completes the entire next state. */\n        Body *tmp = current;\n        current = next;\n        next = tmp;\n      }\n    }\n\n    if (N_ITER % 2 != 0) {\n      result = scratch;\n    }\n  } else {\n    for (int iter = 0; iter < N_ITER; ++iter) {\n      body_force(bodies, DT, nbodies);\n      for (int i = 0; i < nbodies; ++i) {\n        bodies[i].x += bodies[i].vx * DT;\n        bodies[i].y += bodies[i].vy * DT;\n        bodies[i].z += bodies[i].vz * DT;\n      }\n    }\n  }\n\n  write_dataset(nbodies, result);\n  free(scratch);\n  free(bodies);\n  exit(EXIT_SUCCESS);\n}\n",
        "path": "src/nbody.c"
      }

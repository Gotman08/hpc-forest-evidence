            "src/solution.cpp"
          ],
          "retained": [
            "Replace two rolling rows and their per-row copy with one in-place DP row.",
            "Use persistent OpenMP segmented work sharing and a serial four-element carry scan per row.",
            "Correct the n=1 result through direct first-row initialization."
          ]
        },

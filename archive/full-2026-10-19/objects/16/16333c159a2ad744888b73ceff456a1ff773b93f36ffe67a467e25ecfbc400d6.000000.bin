          "files": [
            "src/solution.cpp"
          ],
          "retained": [
            "Close the internal namespace before the global program entry point.",
            "Convert the post-sort obstacle representation to structure-of-arrays y/x streams and release the temporary point storage before the quadratic predecessor scan.",
            "Use stable raw pointers to the coordinate streams in the hot predecessor loop."
          ]
        },

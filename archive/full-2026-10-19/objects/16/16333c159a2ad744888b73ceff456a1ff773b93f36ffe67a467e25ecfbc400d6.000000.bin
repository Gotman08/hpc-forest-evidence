            "src/solution.cpp"
          ],
          "retained": [
            "Replace two rolling rows and the post-row copy loop with one in-place rolling DP row.",
            "Use one conditional subtraction for addition modulo MOD, since both operands are already reduced.",
            "Enable buffered iostream input/output."
          ]
        },

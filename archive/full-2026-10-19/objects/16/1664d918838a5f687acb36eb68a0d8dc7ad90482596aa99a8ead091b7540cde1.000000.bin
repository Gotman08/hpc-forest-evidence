{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <omp.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Compute the gravitational impact among all pairs of bodies in \n * the system using Structure-of-Arrays layout for SIMD efficiency.\n */\nvoid body_force(float *restrict x, float *restrict y, float *restrict z,\n                float *restrict vx, float *restrict vy, float *restrict vz,\n                float dt, int n) {\n  #pragma omp parallel for\n  for (int i = 0; i < n; ++i) {\n    float xi = x[i];\n    float yi = y[i];\n    float zi = z[i];\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    #pragma omp simd reduction(+:fx,fy,fz) aligned(x,y,z:64)\n    for (int j = 0; j < n; ++j) {\n      float dx = x[j] - xi;\n      float dy = y[j] - yi;\n      float dz = z[j] - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1.0f / sqrtf(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    vx[i] += dt*fx;\n    vy[i] += dt*fy;\n    vz[i] += dt*fz;\n  }\n}\n\n/*\n * Read a binary dataset with initialized bodies and convert to SoA.\n */\nvoid read_dataset(float **x, float **y, float **z,\n                  float **vx, float **vy, float **vz,\n                  int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  int n = *nbodies;\n  // Allocate aligned memory for each coordinate array\n  size_t alignment = 64;\n  if (posix_memalign((void**)x, alignment, n * sizeof(float)) != 0 ||\n      posix_memalign((void**)y, alignment, n * sizeof(float)) != 0 ||\n      posix_memalign((void**)z, alignment, n * sizeof(float)) != 0 ||\n      posix_memalign((void**)vx, alignment, n * sizeof(float)) != 0 ||\n      posix_memalign((void**)vy, alignment, n * sizeof(float)) != 0 ||\n      posix_memalign((void**)vz, alignment, n * sizeof(float)) != 0) {\n    fprintf(stderr,\"\\nError allocating aligned memory\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  // Temporary buffer for reading the AoS input\n  typedef struct { float x, y, z, vx, vy, vz; } Body;\n  Body *tmp = (Body *)malloc(n * sizeof(Body));\n  if (!tmp) {\n    fprintf(stderr,\"\\nError allocating temporary buffer\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  b = fread(tmp, n * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    free(tmp);\n    exit(EXIT_FAILURE);\n  }\n\n  // Transpose AoS to SoA\n  for (int i = 0; i < n; ++i) {\n    (*x)[i] = tmp[i].x;\n    (*y)[i] = tmp[i].y;\n    (*z)[i] = tmp[i].z;\n    (*vx)[i] = tmp[i].vx;\n    (*vy)[i] = tmp[i].vy;\n    (*vz)[i] = tmp[i].vz;\n  }\n\n  free(tmp);\n}\n\n/*\n * Write simulation results from SoA back to binary AoS format.\n */\nvoid write_dataset(const int nbodies,\n                   const float *x, const float *y, const float *z,\n                   const float *vx, const float *vy, const float *vz) {\n  typedef struct { float x, y, z, vx, vy, vz; } Body;\n\n  // Build AoS buffer for output\n  Body *out = (Body *)malloc(nbodies * sizeof(Body));\n  if (!out) {\n    fprintf(stderr,\"\\nError allocating output buffer\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  for (int i = 0; i < nbodies; ++i) {\n    out[i].x = x[i];\n    out[i].y = y[i];\n    out[i].z = z[i];\n    out[i].vx = vx[i];\n    out[i].vy = vy[i];\n    out[i].vz = vz[i];\n  }\n\n  int b = fwrite(out, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    free(out);\n    exit(EXIT_FAILURE);\n  }\n\n  free(out);\n}\n\nint main(int argc, char **argv) {\n  int nbodies;\n  float *x, *y, *z, *vx, *vy, *vz;\n\n  read_dataset(&x, &y, &z, &vx, &vy, &vz, &nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    body_force(x, y, z, vx, vy, vz, DT, nbodies);\n\n    #pragma omp parallel for\n    for (int i = 0; i < nbodies; ++i) {\n      x[i] += vx[i] * DT;\n      y[i] += vy[i] * DT;\n      z[i] += vz[i] * DT;\n    }\n  }\n\n  write_dataset(nbodies, x, y, z, vx, vy, vz);\n\n  free(x); free(y); free(z); free(vx); free(vy); free(vz);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Converting from Array-of-Structures (AoS) to Structure-of-Arrays (SoA) memory layout enables efficient SIMD vectorization of contiguous float loads, reducing inner-loop latency and improving overall performance.",
  "notes": "Changed data layout: separate arrays for x,y,z,vx,vy,vz. Added restrict qualifiers and aligned allocation with posix_memalign(64). The force computation now uses contiguous float accesses per coordinate, allowing the compiler to generate better SIMD code (e.g., NEON ld1 instead of strided loads). Input/output conversion preserves binary format exactly.",

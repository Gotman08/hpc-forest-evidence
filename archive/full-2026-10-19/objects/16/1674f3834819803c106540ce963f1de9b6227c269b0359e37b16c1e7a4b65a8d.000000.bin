      "content": "#include \"knn.h\"\n#include <omp.h>\n\n// Comparator for merging: sort by distance, then global index (ascending)\nstatic int merge_compare(const void *a, const void *b) {\n    const float *da = (const float *)a;\n    const float *db = (const float *)b;\n    if (*da < *db) return -1;\n    if (*da > *db) return 1;\n    // distances equal: compare indices stored in the next field\n    const int *ia = (const int *)(a + sizeof(float));\n    const int *ib = (const int *)(b + sizeof(float));\n    return (*ia - *ib);\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    // Precompute prefix sums of group lengths for global point indices\n    int *offsets = (int *)malloc((n_groups + 1) * sizeof(int));\n    offsets[0] = 0;\n    for (int i = 0; i < n_groups; i++) {\n        offsets[i+1] = offsets[i] + groups[i].length;\n    }\n\n    int nthreads;\n    #pragma omp parallel\n    {\n        #pragma omp single\n        nthreads = omp_get_num_threads();\n    }\n\n    // Per-thread storage: each thread keeps up to k candidates (distance, label, index)\n    size_t per_thread_size = k * (sizeof(float) + sizeof(char) + sizeof(int));\n    char *all_data = (char *)malloc(nthreads * per_thread_size);\n\n    #pragma omp parallel for schedule(guided)\n    for (int i = 0; i < n_groups; i++) {\n        int tid = omp_get_thread_num();\n        float *local_dist = (float *)(all_data + tid * per_thread_size);\n        char *local_label = local_dist + k;\n        int *local_idx = (int *)(local_label + k);\n\n        // Initialize with sentinel values\n        for (int x = 0; x < k; x++) {\n            local_dist[x] = -1.0f;\n            local_label[x] = 0;\n            local_idx[x] = -1;\n        }\n\n        Group g = groups[i];\n        int base_idx = offsets[i];\n        for (int j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            int global_idx = base_idx + j;\n\n            // Insert into local sorted list if better than current worst or empty slot\n            for (int x = 0; x < k; x++) {\n                if (local_dist[x] == -1.0f || d < local_dist[x] || \n                    (d == local_dist[x] && global_idx < local_idx[x])) {\n                    // Shift elements right to make room\n                    for (int y = k - 1; y > x; y--) {\n                        local_dist[y] = local_dist[y-1];\n                        local_label[y] = local_label[y-1];\n                        local_idx[y] = local_idx[y-1];\n                    }\n                    local_dist[x] = d;\n                    local_label[x] = g.label;\n                    local_idx[x] = global_idx;\n                    break;\n                }\n            }\n        }\n    }\n\n    // Merge all per-thread candidates into a flat array for sorting\n    size_t total_candidates = nthreads * k;\n    float *merge_dist = (float *)malloc(total_candidates * sizeof(float));\n    char *merge_label = (char *)malloc(total_candidates * sizeof(char));\n    int *merge_idx = (int *)malloc(total_candidates * sizeof(int));\n\n    size_t count = 0;\n    for (int t = 0; t < nthreads; t++) {\n        float *local_dist = (float *)(all_data + t * per_thread_size);\n        char *local_label = local_dist + k;\n        int *local_idx = (int *)(local_label + k);\n\n        for (int x = 0; x < k; x++) {\n            if (local_dist[x] != -1.0f) {\n                merge_dist[count] = local_dist[x];\n                merge_label[count] = local_label[x];\n                merge_idx[count] = local_idx[x];\n                count++;\n            }\n        }\n    }\n\n    // Sort candidates by distance then index using a custom comparator\n    // We pack (distance, index) into an array of structs for qsort\n    typedef struct {\n        float dist;\n        int idx;\n        char label;\n    } Candidate;\n    Candidate *cands = (Candidate *)malloc(count * sizeof(Candidate));\n    for (size_t i = 0; i < count; i++) {\n        cands[i].dist = merge_dist[i];\n        cands[i].idx = merge_idx[i];\n        cands[i].label = merge_label[i];\n    }\n\n    qsort(cands, count, sizeof(Candidate), compare_candidates);\n\n    // Take the first k labels (global top-k)\n    char *labels = (char *)malloc(k * sizeof(char));\n    for (int i = 0; i < k && i < (int)count; i++) {\n        labels[i] = cands[i].label;\n    }\n\n    // Frequency counting as in original sequential code\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    // Cleanup\n    free(offsets);\n    free(all_data);\n    free(merge_dist);\n    free(merge_label);\n    free(merge_idx);\n    free(cands);\n    free(labels);\n\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Using OpenMP guided scheduling over groups with per-thread local top-k arrays storing distance, label, and global point index ensures load balance across variable-length groups while preserving exact sequential output order via deterministic merge by distance then global insertion index. This improves upon previous dynamic scheduling attempts by reducing overhead through adaptive chunk sizes.",
  "notes": "Added OpenMP parallel for schedule(guided) over groups; each thread maintains private top-k arrays with tie-breaking using a global point index (computed from prefix sums of group lengths). After the loop, per-thread candidates are merged into a flat array, sorted by distance then index, and the first k labels are taken. Frequency counting remains unchanged. Requires #include <omp.h> in knn.c; no changes to knn.h.",

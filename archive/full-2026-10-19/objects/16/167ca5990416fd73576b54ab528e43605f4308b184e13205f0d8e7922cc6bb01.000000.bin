#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include <omp.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

/*
 * Compute the gravitational impact among all pairs of bodies in 
 * the system.
 * Uses Structure-of-Arrays (SoA) layout and SIMD reduction on inner loop.
 */
void body_force(float *restrict px, float *restrict py, float *restrict pz,
                float *restrict vx, float *restrict vy, float *restrict vz,
                float dt, int n) {
  for (int i = 0; i < n; ++i) {
    float fx = 0.0f;
    float fy = 0.0f;
    float fz = 0.0f;

    const float xi = px[i];
    const float yi = py[i];
    const float zi = pz[i];

    #pragma omp simd reduction(+:fx,fy,fz)
    for (int j = 0; j < n; ++j) {
      float dx = px[j] - xi;
      float dy = py[j] - yi;
      float dz = pz[j] - zi;
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1.0f / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    vx[i] += dt*fx;
    vy[i] += dt*fy;
    vz[i] += dt*fz;
  }
}

/*
 * Read a binary dataset with initialized bodies.
 */
void read_dataset(int *nbodies,
                  float **restrict px, float **restrict py, float **restrict pz,
                  float **restrict vx, float **restrict vy, float **restrict vz) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }

  typedef struct { float x, y, z, vx, vy, vz; } Body;
  Body *tmp = (Body *)malloc(*nbodies * sizeof(Body));
  if (!tmp) {
    fprintf(stderr,"\nMemory allocation error\n");
    exit(EXIT_FAILURE);
  }

  b = fread(tmp, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    free(tmp);
    exit(EXIT_FAILURE);
  }

  size_t alloc_size = (*nbodies) * sizeof(float);
  if (posix_memalign((void**)px, 16, alloc_size) != 0 ||
      posix_memalign((void**)py, 16, alloc_size) != 0 ||
      posix_memalign((void**)pz, 16, alloc_size) != 0 ||
      posix_memalign((void**)vx, 16, alloc_size) != 0 ||
      posix_memalign((void**)vy, 16, alloc_size) != 0 ||
      posix_memalign((void**)vz, 16, alloc_size) != 0) {
    fprintf(stderr,"\nError allocating aligned memory\n");
    free(tmp);
    exit(EXIT_FAILURE);
  }

  for (int i = 0; i < *nbodies; ++i) {
    (*px)[i] = tmp[i].x;
    (*py)[i] = tmp[i].y;
    (*pz)[i] = tmp[i].z;
    (*vx)[i] = tmp[i].vx;
    (*vy)[i] = tmp[i].vy;
    (*vz)[i] = tmp[i].vz;
  }

  free(tmp);
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(const int nbodies,
                   const float *restrict px, const float *restrict py, const float *restrict pz,
                   const float *restrict vx, const float *restrict vy, const float *restrict vz) {
  typedef struct { float x, y, z, vx, vy, vz; } Body;
  Body *tmp = (Body *)malloc(nbodies * sizeof(Body));
  if (!tmp) {
    fprintf(stderr,"\nMemory allocation error\n");
    exit(EXIT_FAILURE);
  }

  for (int i = 0; i < nbodies; ++i) {
    tmp[i].x = px[i];
    tmp[i].y = py[i];
    tmp[i].z = pz[i];
    tmp[i].vx = vx[i];
    tmp[i].vy = vy[i];
    tmp[i].vz = vz[i];
  }

  int b = fwrite(tmp, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    free(tmp);
    exit(EXIT_FAILURE);
  }

  free(tmp);
}

int main(int argc, char **argv) {
  int nbodies;
  float *px = NULL, *py = NULL, *pz = NULL;
  float *vx = NULL, *vy = NULL, *vz = NULL;

  read_dataset(&nbodies, &px, &py, &pz, &vx, &vy, &vz);

  for (int iter = 0; iter < N_ITER; ++iter) {
    #pragma omp parallel default(none) shared(px,py,pz,vx,vy,vz,nbodies)
    {
      // Force computation with dynamic scheduling for load balance
      #pragma omp for schedule(dynamic,32)
      for (int i = 0; i < nbodies; ++i) {
        float fx = 0.0f;
        float fy = 0.0f;
        float fz = 0.0f;

        const float xi = px[i];
        const float yi = py[i];
        const float zi = pz[i];

        #pragma omp simd reduction(+:fx,fy,fz)
        for (int j = 0; j < nbodies; ++j) {
          float dx = px[j] - xi;
          float dy = py[j] - yi;
          float dz = pz[j] - zi;
          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
          float inv_dist = 1.0f / sqrt(sqrd_dist);
          float inv_dist3 = inv_dist * inv_dist * inv_dist;

          fx += dx * inv_dist3;
          fy += dy * inv_dist3;
          fz += dz * inv_dist3;
        }

        vx[i] += DT*fx;
        vy[i] += DT*fy;
        vz[i] += DT*fz;
      } // implicit barrier after force loop

      // Position update with static scheduling for low overhead
      #pragma omp for schedule(static)
      for (int i = 0; i < nbodies; ++i) {
        px[i] += vx[i] * DT;
        py[i] += vy[i] * DT;
        pz[i] += vz[i] * DT;
      } // implicit barrier before next iteration
    }
  }

  write_dataset(nbodies, px, py, pz, vx, vy, vz);

  free(px); free(py); free(pz);
  free(vx); free(vy); free(vz);

  exit(EXIT_SUCCESS);
}

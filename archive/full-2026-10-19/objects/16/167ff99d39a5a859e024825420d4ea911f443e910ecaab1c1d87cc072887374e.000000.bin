"""Local file-format smoke checks; does not compute any contest answer."""
import json
import zipfile
from pathlib import Path

from hpc_forest import contracts
from prepare_problem import fixture_writer

here=Path(__file__).resolve().parent
originals=here.parents[1]/"outputs/Marathon22-autonome/sources-officielles"
results=[]
for slug in ["knn","sum","nbody","bucketsort"]:
    root=here/"format-check"/slug
    official=root/"official"
    official.mkdir(parents=True,exist_ok=False)
    with zipfile.ZipFile(originals/(slug+".zip")) as z:
        for name in z.namelist():
            contracts.relative(name.rstrip("/"))
        z.extractall(official)
    supplied=root/"supplied"
    (supplied/"fixtures").mkdir(parents=True)
    writer,scales,_,_=fixture_writer(slug,official,supplied)
    first,a=writer(scales[0],"search")
    second,b=writer(scales[0],"confirm",True)
    assert first.stat().st_size>0 and second.stat().st_size>0
    assert contracts.sha(first)!=contracts.sha(second)
    results.append({"problem":slug,"search":a,"confirmation":b,"bytes":[first.stat().st_size,second.stat().st_size]})
print(json.dumps(results,indent=2))

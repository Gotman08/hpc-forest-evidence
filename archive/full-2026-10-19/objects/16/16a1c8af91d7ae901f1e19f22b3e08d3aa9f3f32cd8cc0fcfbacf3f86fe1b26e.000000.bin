#include <algorithm>
#include <cassert>
#include <cstdio>
#include <iostream>
#include <limits>
#include <vector>

int main() {
    int n, s;
    std::cin >> n >> s;
    std::vector<std::vector<int>> matrix(n, std::vector<int>(n));
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            scanf("%d", &matrix[i][j]);
        }
    }

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    long long mxSum;
    if (s <= 2) {
        long long sum = 0;
        for (int i = 0; i < s; ++i) {
            for (int j = 0; j < s; ++j) {
                sum += matrix[i][j];
            }
        }
        mxSum = sum;

        int dir = 1;
        int i = 0;
        int j = 0;
        while (i + s <= n) {
            if ((j + s == n && dir == 1) || (j == 0 && dir == -1)) {
                int exitingRow = i;
                int enteringRow = exitingRow + s;
                if (enteringRow >= n) break;

                #pragma omp simd reduction(+:sum)
                for (int k = 0; k < s; ++k) {
                    sum += static_cast<long long>(matrix[enteringRow][k + j]) -
                           matrix[exitingRow][k + j];
                }

                ++i;
                dir *= -1;
            } else {
                int exitingCol, enteringCol;
                if (dir == 1) {
                    exitingCol = j;
                    enteringCol = exitingCol + s;
                } else {
                    enteringCol = j - 1;
                    exitingCol = enteringCol + s;
                }

                for (int k = 0; k < s; ++k) {
                    sum += static_cast<long long>(matrix[k + i][enteringCol]) -
                           matrix[k + i][exitingCol];
                }
                j += dir;
            }
            mxSum = std::max(mxSum, sum);
        }
    } else {
        std::vector<long long> columnBand(n, 0);
        std::vector<long long> horizontalPrefix(n + 1, 0);
        for (int r = 0; r < s; ++r) {
            #pragma omp simd
            for (int c = 0; c < n; ++c) {
                columnBand[c] += matrix[r][c];
            }
        }

        mxSum = std::numeric_limits<long long>::lowest();
        for (int top = 0; top + s <= n; ++top) {
            horizontalPrefix[0] = 0;
            for (int c = 0; c < n; ++c) {
                horizontalPrefix[c + 1] = horizontalPrefix[c] + columnBand[c];
            }

            long long rowMax = std::numeric_limits<long long>::lowest();
            #pragma omp simd reduction(max:rowMax)
            for (int left = 0; left + s <= n; ++left) {
                const long long sum = horizontalPrefix[left + s] - horizontalPrefix[left];
                if (sum > rowMax) rowMax = sum;
            }
            mxSum = std::max(mxSum, rowMax);

            if (top + s < n) {
                const std::vector<int>& exitingRow = matrix[top];
                const std::vector<int>& enteringRow = matrix[top + s];
                #pragma omp simd
                for (int c = 0; c < n; ++c) {
                    columnBand[c] += static_cast<long long>(enteringRow[c]) -
                                     exitingRow[c];
                }
            }
        }
    }

    printf("%lld\n", mxSum);
    return 0;
}

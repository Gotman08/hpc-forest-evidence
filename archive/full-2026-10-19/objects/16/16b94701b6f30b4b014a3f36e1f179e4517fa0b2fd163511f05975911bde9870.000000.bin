"""Receive three authorization timeouts. No process intervention or model."""
from pathlib import Path
from datetime import datetime, timezone
import hashlib,json
BASE=Path(__file__).resolve().parents[3]
HERE=Path(__file__).resolve().parent
def read(p): return json.loads(p.read_text('utf-8-sig'))
def ref(p): return {'path':str(p.resolve()),'sha256':hashlib.sha256(p.read_bytes()).hexdigest()}
def sc(v): return v.get('structuredContent',v)
cells=[('astra-max','gpt-6-astra','26d58fc2d88f423d9b5fd241ade3d185','752619'),('terra-max','gpt-5.6-terra','fee3bd8ba5fc4e6eafa1167ef279f9fa','752620'),('sol-max','gpt-6.1-sol','182500fef7c546af87f14498de353581','752621')]
roots=HERE/'native-roots-absents-apres-expiration.json'
rs=sc(read(roots)['result']); assert rs['ok'] is True and not rs['unchecked'] and len(rs['paths'])==3 and all(x['exists'] is False for x in rs['paths'])
cim=HERE/'cim-apres-expiration.json'; cv=read(cim);assert cv['complete_census'] is True and cv['native_processes']==[] and cv['other_native_groups']==[]
out=[]
for slug,model,session,job in cells:
 d=HERE.parent/('reception-preflights-'+job)
 st=d/'statut-terminal.json';eff=d/'efficacite.json';log=d/'journaux.json'
 s,e,l=map(lambda p:sc(read(p)),[st,eff,log])
 assert s['finished'] is True and s['current_state_observed'] is True and s['state']=='FAILED'
 assert e['state']=='FAILED' and e['exit_code']=='1:0' and e['alloc_cpus']==4 and e['alloc_gpus']==0
 assert l['ok'] and not l['truncated'] and not l['files_limited']
 assert 'Post-submit authorization upload did not arrive; no native call started' in l['content']
 p=HERE/('admission-expiree-'+session+'.json');listing=sc(read(p)['result']['value'])
 assert listing['ok'] and listing['count']==1 and not listing['truncated'] and [r['name'] for r in listing['entries']]==['allocation-ready.json']
 cache=BASE/'outputs/HPC-Forest-Primes-Natif-Lancement-r2d'/('worker-'+session);assert not cache.exists()
 assert not any(row['path'].endswith(session) and row['exists'] for row in rs['paths'])
 out.append({'model':model,'session_id':session,'job_id':job,'state':'FAILED','exit_code':'1:0','reason':'authorization_wait600_expired','native_model_calls':0,'worker_launched':False,'authorization_published':False,'ready_published':False,'local_cache_path':str(cache),'local_cache_absent':True,'native_root_registry_channel_absent':True,'evidence_refs':[ref(st),ref(eff),ref(log),ref(p)]})
v={'schema':'hpc-forest-r2d-zero-model-preflight-closure-v1','verified':True,'utc':datetime.now(timezone.utc).isoformat(),'scope_id':'hpc-forest-primes-native-max-r2d','source_zip_sha256':'13ccaf7c74d13db246d1127a25c511bc03d7989ba9097eb6ad7b4f681c0a0a46','plan_sha256':'5e052db689fc423720be60dab97fbca70c82b64487d02d3d8fe2d0f796d9c96c','cells':out,'natural_exit_only':True,'processes_stopped':0,'started_call_replay':False,'sessions_unused':True,'same_unused_sessions_allowed_only_with_new_admission_dirs_and_new_jobs':True,'evidence_refs':[ref(cim),ref(roots)]}
target=HERE/'RECEPTION-TROIS-PREFLIGHTS-ZERO-MODELE.json'
with target.open('x',encoding='utf-8',newline='\n') as f: f.write(json.dumps(v,ensure_ascii=False,indent=2)+'\n')
print(json.dumps(ref(target)))


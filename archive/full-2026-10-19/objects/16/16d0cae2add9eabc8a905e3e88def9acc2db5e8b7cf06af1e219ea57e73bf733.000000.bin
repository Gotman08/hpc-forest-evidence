{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"/*\\n  Quicksort\\n*/\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <limits.h>\\n#include <openssl/md5.h>\\n\\n/*\\n * Prototypes\\n */\\nvoid srandnum(int seed);\\ndouble randnum(void);\\nint *generate_case(int N);\\ndouble drand(int xmin, int xmax);\\nvoid swap(int *toorder, int i, int j);\\nvoid _quicksort(int *toorder, int lo, int hi);\\nvoid quicksort(int *toorder, int N);\\nint is_sorted(int *toorder, int N);\\nstatic int median_of_three(int *toorder, int lo, int hi);\\nstatic void partition_three_way(int *toorder, int lo, int hi, int *lt, int *gt);\\nstatic void insertion_sort(int *toorder, int lo, int hi);\\n#ifdef _OPENMP\\nstatic void _quicksort_parallel(int *toorder, int lo, int hi, int depth);\\n#endif\\n\\n#define INSERTION_SORT_CUTOFF 24\\n#define PARALLEL_TASK_CUTOFF 32768\\n\\n/*\\n * A generic pRNG\\n */\\n#define MY_RAND_MAX 0x7FFFFFFF\\n\\n#define RANDNUM_W 521288629\\n#define RANDNUM_Z 362436069\\n\\nunsigned int randum_w = RANDNUM_W;\\nunsigned int randum_z = RANDNUM_Z;\\n\\nvoid srandnum(int seed)\\n{\\n    unsigned int w, z;\\n    w = (seed * 104623) & 0xffffffff;\\n    randum_w = (w) ? w : RANDNUM_W;\\n    z = (seed * 48947) & 0xffffffff;\\n    randum_z = (z) ? z : RANDNUM_Z;\\n}\\n\\ndouble randnum(void)\\n{\\n    unsigned int u;\\n    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);\\n    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);\\n    u = (randum_z << 16) + randum_w;\\n    return (abs(u));\\n}\\n\\n/*\\n * Main function\\n */\\nint main(int argc, char *argv[])\\n{\\n    int N = 0;\\n    int *our_list = NULL;\\n\\n    //The input provides the case size\\n    scanf(\\\"%d\\\", &N);\\n    if (N <= 0) {\\n        printf(\\\"Error: please, provide the case size.\\\\n\\\");\\n        return 1;\\n    }\\n\\n    //Generate the case\\n    our_list = generate_case(N);\\n    if (our_list == NULL) {\\n        printf(\\\"Error: case instantiation failed.\\\\n\\\");\\n        return 1;\\n    }\\n\\n    //Do the thing\\n    quicksort(our_list, N);\\n\\n    if (is_sorted(our_list, N) == 1) {\\n        printf(\\\"Error, for some reason list is still unsorted.\\\\n\\\");\\n        return 1;\\n    }\\n\\n#ifdef COMPUTE_MD5_PROBLEM\\n    //Compute MD5 Checksum for problem identification\\n    MD5_CTX c;\\n    unsigned char out[MD5_DIGEST_LENGTH];\\n    MD5_Init(&c);\\n    MD5_Update(&c, our_list, N * sizeof(int));\\n    MD5_Final(out, &c);\\n    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {\\n        printf(\\\"%02x\\\", out[n]);\\n    }\\n#endif\\n    printf(\\\"\\\\n\\\");\\n\\n    //Clean up\\n    free(our_list);\\n\\n    return 0;\\n}\\n\\n/*\\n * Public API\\n */\\nvoid quicksort(int *toorder, int N)\\n{\\n#ifdef _OPENMP\\n    if (N > PARALLEL_TASK_CUTOFF) {\\n        int depth_limit = 0;\\n        for (int size = N; size > 1; size >>= 1) {\\n            depth_limit += 2;\\n        }\\n#pragma omp parallel\\n        {\\n#pragma omp single\\n            {\\n                _quicksort_parallel(toorder, 0, N - 1, depth_limit);\\n            }\\n        }\\n        return;\\n    }\\n#endif\\n    _quicksort(toorder, 0, N - 1);\\n}\\n\\n/*\\n * Internal serial quicksort. Recursing on the smaller partition bounds stack use,\\n * while the larger partition is handled by the loop.\\n */\\nvoid _quicksort(int *toorder, int lo, int hi)\\n{\\n    while (lo < hi) {\\n        if (hi - lo + 1 <= INSERTION_SORT_CUTOFF) {\\n            insertion_sort(toorder, lo, hi);\\n            return;\\n        }\\n\\n        int lt, gt;\\n        partition_three_way(toorder, lo, hi, &lt, &gt);\\n        int left_size = lt - lo;\\n        int right_size = hi - gt;\\n        if (left_size < right_size) {\\n            _quicksort(toorder, lo, lt - 1);\\n            lo = gt + 1;\\n        } else {\\n            _quicksort(toorder, gt + 1, hi);\\n            hi = lt - 1;\\n        }\\n    }\\n}\\n\\n#ifdef _OPENMP\\n/*\\n * Parallel quicksort tasks operate on disjoint, contiguous partitions. Small\\n * ranges and deep paths use the serial implementation to limit task overhead.\\n */\\nstatic void _quicksort_parallel(int *toorder, int lo, int hi, int depth)\\n{\\n    while (lo < hi) {\\n        int size = hi - lo + 1;\\n        if (size <= PARALLEL_TASK_CUTOFF || depth <= 1) {\\n            _quicksort(toorder, lo, hi);\\n            return;\\n        }\\n\\n        int lt, gt;\\n        partition_three_way(toorder, lo, hi, &lt, &gt);\\n        int left_size = lt - lo;\\n        int right_size = hi - gt;\\n        if (left_size < PARALLEL_TASK_CUTOFF &&\\n            right_size < PARALLEL_TASK_CUTOFF) {\\n            _quicksort(toorder, lo, lt - 1);\\n            _quicksort(toorder, gt + 1, hi);\\n            return;\\n        }\\n\\n        int next_depth = depth - 1;\\n        if (left_size >= right_size) {\\n            int task_lo = lo;\\n            int task_hi = lt - 1;\\n            if (task_lo <= task_hi) {\\n#pragma omp task default(none) firstprivate(toorder, task_lo, task_hi, next_depth)\\n                {\\n                    _quicksort_parallel(toorder, task_lo, task_hi, next_depth);\\n                }\\n            }\\n            lo = gt + 1;\\n        } else {\\n            int task_lo = gt + 1;\\n            int task_hi = hi;\\n            if (task_lo <= task_hi) {\\n#pragma omp task default(none) firstprivate(toorder, task_lo, task_hi, next_depth)\\n                {\\n                    _quicksort_parallel(toorder, task_lo, task_hi, next_depth);\\n                }\\n            }\\n            hi = lt - 1;\\n        }\\n        depth = next_depth;\\n    }\\n}\\n#endif\\n\\n/*\\n * Choose a local pivot without using shared PRNG state.\\n */\\nstatic int median_of_three(int *toorder, int lo, int hi)\\n{\\n    int a = toorder[lo];\\n    int b = toorder[lo + (hi - lo) / 2];\\n    int c = toorder[hi];\\n\\n    if (a < b) {\\n        if (b < c) {\\n            return b;\\n        }\\n        return (a < c) ? c : a;\\n    }\\n    if (a < c) {\\n        return a;\\n    }\\n    return (b < c) ? c : b;\\n}\\n\\n/*\\n * Partition a range into values below, equal to, and above the pivot.\\n */\\nstatic void partition_three_way(int *toorder, int lo, int hi, int *lt, int *gt)\\n{\\n    int pivot = median_of_three(toorder, lo, hi);\\n    int lower = lo;\\n    int current = lo;\\n    int upper = hi;\\n\\n    while (current <= upper) {\\n        if (toorder[current] < pivot) {\\n            swap(toorder, current, lower);\\n            lower++;\\n            current++;\\n        } else if (toorder[current] > pivot) {\\n            swap(toorder, current, upper);\\n            upper--;\\n        } else {\\n            current++;\\n        }\\n    }\\n\\n    *lt = lower;\\n    *gt = upper;\\n}\\n\\n/*\\n * Sort a small contiguous range in place.\\n */\\nstatic void insertion_sort(int *toorder, int lo, int hi)\\n{\\n    for (int i = lo + 1; i <= hi; i++) {\\n        int value = toorder[i];\\n        int j = i;\\n        while (j > lo && toorder[j - 1] > value) {\\n            toorder[j] = toorder[j - 1];\\n            j--;\\n        }\\n        toorder[j] = value;\\n    }\\n}\\n\\n/*\\n * Swap two values.\\n */\\nvoid swap(int *toorder, int i, int j)\\n{\\n    int temp = toorder[i];\\n    toorder[i] = toorder[j];\\n    toorder[j] = temp;\\n}\\n\\n/*\\n * Check if elements are in non-decreasing order\\n */\\nint is_sorted(int *toorder, int N)\\n{\\n    for (int i = 1; i < N; i++) {\\n        if (toorder[i] < toorder[i - 1]) {\\n            return 1;\\n        }\\n    }\\n    return 0;\\n}\\n\\n/*\\n * Generate a case\\n */\\nint *generate_case(int N)\\n{\\n    int i;\\n    int *ret = NULL;\\n\\n    // Make case generation reproducible\\n    srandnum(0);\\n\\n    // Allocate memory\\n    ret = (int *) malloc(N * sizeof(int));\\n    if (ret == NULL) {\\n        printf(\\\"Error: some malloc won't work.\\\\n\\\");\\n        return NULL;\\n    }\\n    // Get pseudo-random positive integer values\\n    for (i = 0; i < N; i++) {\\n        ret[i] = drand(0, INT_MAX);\\n    }\\n    return ret;\\n}\\n\\n/*\\n * A pseudo-random number between two positive integer values\\n */\\ndouble drand(int xmin, int xmax)\\n{\\n    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;\\n}\\n\",\"path\":\"src/quicksort.c\"}],\"hypothesis\":\"A three-way streaming partition, insertion sort for small contiguous ranges, and coarse OpenMP tasks for only large partitions may improve locality and use the four cores without making small cases pay task overhead. Median-of-three pivots avoid shared PRNG access in parallel sorting; generation remains unchanged.\",\"notes\":\"The parallel path is guarded by _OPENMP; otherwise the optimized serial implementation is used. No documentation requested.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Keep case generation and its PRNG sequence unchanged; replace sort-time random pivots with race-free median-of-three selection.\",\"Use a contiguous three-way partition to handle equal keys and split work into disjoint ranges.\",\"Use insertion sort below a small-range cutoff and recurse on the smaller serial partition while iterating over the larger one.\",\"When OpenMP is enabled, create coarse tasks only for large disjoint partitions, with a depth limit and serial fallback.\"]}"}}

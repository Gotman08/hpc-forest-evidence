        "content": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nint A[1000][1000];\nint ps[1010][1010];\n\ntypedef long long ll;\n\nll solve(int m, int n, int k) {\n  const int short_dim = min(m, n);\n  const int long_dim = max(m, n);\n\n  // Initialize the prefix boundary on every call.\n  fill(ps[0], ps[0] + long_dim, 0);\n\n  // Each prefix row is contiguous along the dimension being scanned.\n  if (m <= n) {\n    for (int t = 0; t < short_dim; t++) {\n#pragma GCC ivdep\n      for (int r = 0; r < long_dim; r++) {\n        ps[t + 1][r] = ps[t][r] + A[t][r];\n      }\n    }\n  } else {\n    // Transpose once before building the independent column-wise prefixes.\n    for (int i = 0; i < m; i++) {\n      for (int j = 0; j < n; j++) {\n        ps[j + 1][i] = A[i][j];\n      }\n    }\n    for (int t = 0; t < short_dim; t++) {\n#pragma GCC ivdep\n      for (int r = 0; r < long_dim; r++) {\n        ps[t + 1][r] += ps[t][r];\n      }\n    }\n  }\n\n  // Move the scan recurrence into one-time preprocessing. Afterwards,\n  // ps[t][r] sums the first t oriented rows through position r inclusive.\n  // This dependent scan deliberately has no SIMD independence hint.\n  for (int t = 1; t <= short_dim; t++) {\n    int running = 0;\n    for (int r = 0; r < long_dim; r++) {\n      running += ps[t][r];\n      ps[t][r] = running;\n    }\n  }\n\n  unordered_map<ll, ll> h;\n  int band[1000];\n  ll ans = 0;\n  for (int first = 0; first < short_dim; first++) {\n    for (int end = first + 1; end <= short_dim; end++) {\n      // These independent differences now produce cumulative prefix keys.\n#pragma GCC ivdep\n      for (int r = 0; r < long_dim; r++) {\n        band[r] = ps[end][r] - ps[first][r];\n      }\n\n      // Histogram queries and updates retain their serial ordering.\n      h.clear();\n      h[0] = 1;\n      for (int r = 0; r < long_dim; r++) {\n        const ll s = band[r];\n        ans += h.find(s - k) != h.end() ? h[s - k] : 0;\n        h[s]++;\n      }\n    }\n  }\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n  memset(ps, 0, sizeof ps);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n",
        "path": "src/main.cpp"
      }

#include <algorithm>
#include <iostream>
#include <vector>

using namespace std;

static constexpr int MOD = 1000000007;

struct Point {
    int x;
    int y;
};

static long long modPow(long long base, int exponent) {
    long long result = 1;
    while (exponent > 0) {
        if (exponent & 1) result = result * base % MOD;
        base = base * base % MOD;
        exponent >>= 1;
    }
    return result;
}

static int choose(int total, int left, const vector<int>& fact,
                  const vector<int>& invFact) {
    if (left < 0 || left > total) return 0;
    long long result = fact[total];
    result = result * invFact[left] % MOD;
    result = result * invFact[total - left] % MOD;
    return static_cast<int>(result);
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) return 0;

    vector<Point> blocked;
    blocked.reserve(static_cast<size_t>(m));
    bool blockedStart = false;
    bool blockedEnd = false;

    for (int i = 0; i < m; ++i) {
        int y, x;
        cin >> y >> x;
        blocked.push_back({x, y});
        if (x == 0 && y == 0) blockedStart = true;
        if (x == n - 1 && y == n - 1) blockedEnd = true;
    }

    if (blockedStart || blockedEnd) {
        cout << 0 << '\n';
        return 0;
    }

    sort(blocked.begin(), blocked.end(), [](const Point& a, const Point& b) {
        const int da = a.x + a.y;
        const int db = b.x + b.y;
        if (da != db) return da < db;
        if (a.x != b.x) return a.x < b.x;
        return a.y < b.y;
    });
    blocked.erase(unique(blocked.begin(), blocked.end(),
                         [](const Point& a, const Point& b) {
                             return a.x == b.x && a.y == b.y;
                         }),
                  blocked.end());

    if (blocked.size() >= static_cast<size_t>(n)) {
        sort(blocked.begin(), blocked.end(), [](const Point& a, const Point& b) {
            if (a.y != b.y) return a.y < b.y;
            return a.x < b.x;
        });

        vector<int> dp(n, 0);
        dp[0] = 1;
        size_t obstacle = 0;

        for (int y = 0; y < n; ++y) {
            int running = 0;
            int x = 0;

            while (obstacle < blocked.size() && blocked[obstacle].y == y) {
                const int blockedX = blocked[obstacle].x;
                while (x < blockedX) {
                    int value = running + dp[x];
                    if (value >= MOD) value -= MOD;
                    running = value;
                    dp[x] = running;
                    ++x;
                }
                dp[blockedX] = 0;
                running = 0;
                x = blockedX + 1;
                ++obstacle;
            }

            while (x < n) {
                int value = running + dp[x];
                if (value >= MOD) value -= MOD;
                running = value;
                dp[x] = running;
                ++x;
            }
        }

        cout << dp[n - 1] << '\n';
        return 0;
    }

    const int maxDistance = 2 * n - 2;
    vector<int> fact(maxDistance + 1, 1);
    vector<int> invFact(maxDistance + 1, 1);
    for (int i = 1; i <= maxDistance; ++i) {
        fact[i] = static_cast<long long>(fact[i - 1]) * i % MOD;
    }
    invFact[maxDistance] = static_cast<int>(modPow(fact[maxDistance], MOD - 2));
    for (int i = maxDistance; i > 0; --i) {
        invFact[i - 1] = static_cast<long long>(invFact[i]) * i % MOD;
    }

    vector<int> ways(blocked.size(), 0);
    for (size_t i = 0; i < blocked.size(); ++i) {
        const Point& target = blocked[i];
        long long count = choose(target.x + target.y, target.x, fact, invFact);

        for (size_t j = i; j > 0;) {
            --j;
            const Point& previous = blocked[j];
            if (previous.x <= target.x && previous.y <= target.y) {
                const int dx = target.x - previous.x;
                const int dy = target.y - previous.y;
                const int between = choose(dx + dy, dx, fact, invFact);
                count -= static_cast<long long>(ways[j]) * between % MOD;
                if (count < 0) count += MOD;
            }
        }
        ways[i] = static_cast<int>(count);
    }

    const int destination = n - 1;
    long long answer = choose(2 * destination, destination, fact, invFact);
    for (size_t j = blocked.size(); j > 0;) {
        --j;
        const Point& previous = blocked[j];
        const int dx = destination - previous.x;
        const int dy = destination - previous.y;
        const int between = choose(dx + dy, dx, fact, invFact);
        answer -= static_cast<long long>(ways[j]) * between % MOD;
        if (answer < 0) answer += MOD;
    }

    cout << answer << '\n';
    return 0;
}

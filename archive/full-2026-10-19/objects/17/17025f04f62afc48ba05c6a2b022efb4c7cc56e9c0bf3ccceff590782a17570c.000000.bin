#include <cstdio>
#include <vector>
#include <climits>

class FastScanner {
    static const int BUFSIZE = 1 << 16;
    FILE* f;
    char buf[BUFSIZE];
    int idx;
    int size;

    inline char getChar() {
        if (idx >= size) {
            size = (int)fread(buf, 1, BUFSIZE, f);
            idx = 0;
            if (size == 0) return '\0';
        }
        return buf[idx++];
    }

public:
    explicit FastScanner(FILE* file) : f(file), idx(0), size(0) {}

    int nextInt() {
        char c;
        do {
            c = getChar();
        } while (c && c <= ' ');
        if (!c) return 0;
        int sign = 1;
        if (c == '-') {
            sign = -1;
            c = getChar();
        }
        long long x = 0;
        while (c >= '0' && c <= '9') {
            x = x * 10 + (c - '0');
            c = getChar();
        }
        return (int)(sign * x);
    }
};

int main() {
    FastScanner fs(stdin);
    int n = fs.nextInt();
    int s = fs.nextInt();

    std::vector<int> a((size_t)n * (size_t)n);
    for (int i = 0; i < n; ++i) {
        size_t base = (size_t)i * n;
        for (int j = 0; j < n; ++j) {
            a[base + j] = fs.nextInt();
        }
    }

    std::vector<long long> col(n, 0LL);
    for (int i = 0; i < s; ++i) {
        const int* row = &a[(size_t)i * n];
        for (int j = 0; j < n; ++j) {
            col[j] += row[j];
        }
    }

    long long best = LLONG_MIN;
    const int lastTop = n - s;

    for (int r = 0; r <= lastTop; ++r) {
        long long win = 0;
        for (int j = 0; j < s; ++j) {
            win += col[j];
        }
        if (win > best) best = win;

        for (int j = s; j < n; ++j) {
            win += col[j] - col[j - s];
            if (win > best) best = win;
        }

        if (r < lastTop) {
            const int* outRow = &a[(size_t)r * n];
            const int* inRow  = &a[(size_t)(r + s) * n];
            for (int j = 0; j < n; ++j) {
                col[j] += (long long)inRow[j] - outRow[j];
            }
        }
    }

    printf("%d\n", (int)best);
    return 0;
}

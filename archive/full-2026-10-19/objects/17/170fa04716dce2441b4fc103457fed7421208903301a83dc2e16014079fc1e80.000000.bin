        "content": "#include <algorithm>\n#include <array>\n#include <cstddef>\n#include <iostream>\n#include <iterator>\n#include <limits>\n#include <string>\n#include <vector>\n\n#if defined(_OPENMP)\n#include <omp.h>\n#endif\n\nstruct PrintPermutation\n{\n    template <typename Iter> auto\n    operator () (Iter first, Iter last) const -> void\n    {\n        std::cout << \"[ \" ;\n        while (first != last) {\n            std::cout << *first << \" \" ;\n            ++ first ;\n        }\n        std::cout << \"]\\n\" ;\n    }\n} ;\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ' )\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v') ;\n    }\n} ;\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase\n        ( std::remove_if\n            ( text.begin ()\n            , text.end ()\n            , IsWhitespace () )\n        , text.end () ) ;\n    return text ;\n}\n\ninline auto\nsort_initial_text (std::string& text) -> void\n{\n    constexpr std::size_t alphabet_size = 256 ;\n    constexpr std::size_t parallel_sort_threshold = 32768 ;\n\n#if defined(_OPENMP)\n    if (text.size () < parallel_sort_threshold\n        || text.size () > static_cast<std::size_t> (\n            std::numeric_limits<std::ptrdiff_t>::max ())) {\n        std::sort (text.begin (), text.end ()) ;\n        return ;\n    }\n\n    if (std::is_sorted (text.begin (), text.end ())) return ;\n\n    std::array<char, alphabet_size> alphabet ;\n    for (std::size_t i = 0 ; i < alphabet_size ; ++ i) {\n        alphabet [i] = static_cast<char> (static_cast<unsigned char> (i)) ;\n    }\n    std::sort (alphabet.begin (), alphabet.end ()) ;\n\n    const std::size_t workers = std::min\n        ( static_cast<std::size_t> (omp_get_max_threads ())\n        , text.size () ) ;\n    std::vector<std::size_t> local_counts (workers * alphabet_size, 0) ;\n    const std::ptrdiff_t text_size = static_cast<std::ptrdiff_t> (text.size ()) ;\n\n    #pragma omp parallel num_threads(static_cast<int>(workers))\n    {\n        const std::size_t thread_id =\n            static_cast<std::size_t> (omp_get_thread_num ()) ;\n        std::size_t* counts = local_counts.data () + thread_id * alphabet_size ;\n\n        #pragma omp for schedule(static)\n        for (std::ptrdiff_t i = 0 ; i < text_size ; ++ i) {\n            const std::size_t index = static_cast<unsigned char> (\n                text [static_cast<std::size_t> (i)]) ;\n            ++ counts [index] ;\n        }\n    }\n\n    std::array<std::size_t, alphabet_size> counts {} ;\n    for (std::size_t thread_id = 0 ; thread_id < workers ; ++ thread_id) {\n        const std::size_t* thread_counts =\n            local_counts.data () + thread_id * alphabet_size ;\n        for (std::size_t i = 0 ; i < alphabet_size ; ++ i) {\n            counts [i] += thread_counts [i] ;\n        }\n    }\n\n    std::array<std::size_t, alphabet_size> offsets {} ;\n    std::size_t next = 0 ;\n    for (char value : alphabet) {\n        const std::size_t index = static_cast<unsigned char> (value) ;\n        offsets [index] = next ;\n        next += counts [index] ;\n    }\n\n    #pragma omp parallel for schedule(static)\n    for (int i = 0 ; i < static_cast<int> (alphabet_size) ; ++ i) {\n        const char value = alphabet [static_cast<std::size_t> (i)] ;\n        const std::size_t index = static_cast<unsigned char> (value) ;\n        const std::ptrdiff_t begin = static_cast<std::ptrdiff_t> (offsets [index]) ;\n        const std::ptrdiff_t end = begin +\n            static_cast<std::ptrdiff_t> (counts [index]) ;\n        std::fill (text.begin () + begin, text.begin () + end, value) ;\n    }\n#else\n    std::sort (text.begin (), text.end ()) ;\n#endif\n}\n\ntemplate <typename Iter> auto\nfind_longest_non_increasing_suffix (Iter first, Iter last) -> Iter\n{\n    if (first == last) return last ;\n    Iter back = std::prev (last) ;\n    if (back == first) return last ;\n    do {\n        -- last ;\n        -- back ;\n    } while ((first != last) && (*back >= *last)) ;\n    return last ;\n}\n\ntemplate <typename Iter> auto\nfind_rightmost_successor (Iter first, Iter second, Iter last) -> Iter\n{\n    if (second == last) return last ;\n    do {\n        -- last ;\n    } while ((second != last) && (*last <= *first)) ;\n    return last ;\n}\n\ntemplate <typename Iter> auto\nnext_permutation (Iter first, Iter last) -> bool\n{\n    if (first == last) return false ;\n    Iter suffix = find_longest_non_increasing_suffix (first, last) ;\n    if (suffix == first) return false ;\n    if (suffix == last)  return false ;\n    Iter pivot = std::prev (suffix) ;\n    Iter successor = find_rightmost_successor (pivot, suffix, last) ;\n    std::iter_swap (pivot, successor) ;\n    std::reverse (suffix, last) ;\n    return true ;\n}\n\ntemplate <typename Iter, typename Function> inline auto\npermutations_iter (Iter first, Iter last, Function driver) -> void\n{\n    if (first == last) return ;\n    if constexpr (std::is_same_v<typename std::iterator_traits<Iter>::value_type, char>) {\n        // The input is a string; its initial sort is handled by the caller.\n        std::sort (first, last) ;\n    } else {\n        std::sort (first, last) ;\n    }\n    do {\n        driver (first, last) ;\n    } while (::next_permutation (first, last)) ;\n    return ;\n}\n\ntemplate <typename String, typename Function> inline auto\npermutations (String text, Function driver) -> void\n{\n    sort_initial_text (text) ;\n    permutations_iter (std::begin (text), std::end (text), driver) ;\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator <char> begin (in), end ;\n    std::string text (begin, end) ;\n    text = remove_whitespaces (text) ;\n    return text ;\n}\n\nint main (int argc, char const *argv [])\n{\n    std::ios::sync_with_stdio (false) ;\n    std::cin.tie (nullptr) ;\n    std::string text = read_text_from_stdin <std::string> (std::cin) ;\n    permutations (text, PrintPermutation ()) ;\n    return 0;\n}\n",

param([Parameter(Mandatory=$true)][string]$Destination)
$ErrorActionPreference='Stop'
$taskRows=@(Get-CimInstance Win32_Process | ForEach-Object {
    [ordered]@{ProcessId=[int]$_.ProcessId; ParentProcessId=[int]$_.ParentProcessId; ExecutablePath=$_.ExecutablePath; CommandLine=$_.CommandLine; CreationDate=$(if ($_.CreationDate) {$_.CreationDate.ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ss.fffffffZ')} else {$null})}
})
$taskReceipt=[ordered]@{schema='hpc-forest-primes-r2max-fresh-full-cim-v1';complete_census=$true;captured_at_utc=[DateTime]::UtcNow.ToString('o');rows_count=$taskRows.Count;rows=$taskRows}
if(Test-Path -LiteralPath $Destination){throw 'Existing census must be preserved'}
[IO.File]::WriteAllText($Destination,($taskReceipt|ConvertTo-Json -Depth 8),[Text.UTF8Encoding]::new($false))
Write-Output "Full local census saved: $($taskRows.Count) rows"

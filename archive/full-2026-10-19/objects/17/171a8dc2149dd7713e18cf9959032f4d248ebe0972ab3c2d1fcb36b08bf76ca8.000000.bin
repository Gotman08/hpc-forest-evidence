#include <iostream>
#include <vector>
#include <utility>

using namespace std;

typedef vector<vector<bool>> adjacency_matrix;

adjacency_matrix readGraph();

bool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);
bool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence);
inline void printPermutation(vector<int> &equivalence);

static inline int pairMismatch(const adjacency_matrix &g1,
                               const adjacency_matrix &g2,
                               const vector<int> &equivalence,
                               int i, int j) {
    if (i < j)
        swap(i, j);
    return g1[i][j] != g2[equivalence[i]][equivalence[j]];
}

static int countPermutationMismatches(const adjacency_matrix &g1,
                                      const adjacency_matrix &g2,
                                      const vector<int> &equivalence) {
    int mismatches = 0;
    for (int i = 0; i < static_cast<int>(equivalence.size()); ++i) {
        for (int j = 0; j <= i; ++j)
            mismatches += pairMismatch(g1, g2, equivalence, i, j);
    }
    return mismatches;
}

static void updateMismatchesAfterSwap(const adjacency_matrix &g1,
                                      const adjacency_matrix &g2,
                                      vector<int> &equivalence,
                                      int first, int second,
                                      int &mismatches) {
    if (first == second)
        return;

    const int n = static_cast<int>(equivalence.size());

    // Only pairs touching either swapped source position can change.
    mismatches -= pairMismatch(g1, g2, equivalence, first, first);
    mismatches -= pairMismatch(g1, g2, equivalence, second, second);
    mismatches -= pairMismatch(g1, g2, equivalence, first, second);
    for (int k = 0; k < n; ++k) {
        if (k != first && k != second) {
            mismatches -= pairMismatch(g1, g2, equivalence, first, k);
            mismatches -= pairMismatch(g1, g2, equivalence, second, k);
        }
    }

    swap(equivalence[first], equivalence[second]);

    mismatches += pairMismatch(g1, g2, equivalence, first, first);
    mismatches += pairMismatch(g1, g2, equivalence, second, second);
    mismatches += pairMismatch(g1, g2, equivalence, first, second);
    for (int k = 0; k < n; ++k) {
        if (k != first && k != second) {
            mismatches += pairMismatch(g1, g2, equivalence, first, k);
            mismatches += pairMismatch(g1, g2, equivalence, second, k);
        }
    }
}

int main(){
    adjacency_matrix g1 = readGraph();
    adjacency_matrix g2 = readGraph();

    if(!testIsomorphism(g1, g2))
        cout << "The graphs are not isomorphic" << endl;

    return 0;
}

bool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){
    vector<int> equivalence(g1.size(), 0);
    vector<int> exchange_counter(g1.size(), 0);
    int exchange_index = 1;
    bool isomorphism_found = false;

    if(g1.size() != g2.size()) return false;

    for(int i = 0; i < static_cast<int>(equivalence.size()); ++i)
        equivalence[i] = i;

    int mismatches = countPermutationMismatches(g1, g2, equivalence);
    if(mismatches == 0){
        printPermutation(equivalence);
        return true;
    }

    /*
     * Heap's algorithm changes the mapping by one swap at a time. Keep the
     * lower-triangle comparison count exact by revisiting only pairs involving
     * the two swapped source positions.
     */
    while(exchange_index < static_cast<int>(g1.size())){
        if(exchange_counter[exchange_index] < exchange_index){
            int first, second;
            if(exchange_index % 2 == 0){
                first = 0;
                second = exchange_index;
            }else{
                first = exchange_counter[exchange_index];
                second = exchange_index;
            }
            updateMismatchesAfterSwap(g1, g2, equivalence, first, second, mismatches);
            if(mismatches == 0){
                printPermutation(equivalence);
                isomorphism_found = true;
            }

            exchange_counter[exchange_index]++;
            exchange_index = 1;
        }else{
            exchange_counter[exchange_index] = 0;
            exchange_index++;
        }
    }
    return isomorphism_found;
}

adjacency_matrix readGraph(){
    int vertices, edges, source, destination;

    cin >> vertices;
    adjacency_matrix read(vertices);
    for (int i = 0; i < vertices; ++i)
        read[i].resize(vertices);

    cin >> edges;
    for (int i = 0; i < edges; i++) {
       cin >> source >> destination;
       read[destination][source] = read[source][destination] = true;
    }

    return read;
}

bool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence){
    return countPermutationMismatches(g1, g2, equivalence) == 0;
}

inline void printPermutation(vector<int> &equivalence){
    for (auto i : equivalence)
        cout << i << " ";
    cout << endl;
}

{
  "src/graph.c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n#include <limits.h>\n\n#define MAX 100\n#define NO_SUCCESSOR INT_MIN\n\ntypedef struct {\n  int id;\n  float value;\n  char neighbors[MAX];\n} Node;\n\ntypedef struct {\n  int *keys;\n  int *indexes;\n  size_t mask;\n} IdMap;\n\nstatic void fail(void)\n{\n  fprintf(stderr, \"Error!\\n\");\n  exit(1);\n}\n\nstatic void *allocate_array(size_t count, size_t element_size)\n{\n  if (count > SIZE_MAX / element_size)\n    fail();\n\n  void *result = malloc(count * element_size);\n  if (result == NULL)\n    fail();\n\n  return result;\n}\n\nNode *read_input(char *fname, int *n, char *list)\n{\n  Node *data = NULL;\n  FILE *fl = NULL;\n\n  if (fname == NULL)\n    fl = stdin;\n  else\n    fl = fopen(fname, \"r\");\n\n  if (fl == NULL)\n    fail();\n\n  fscanf(fl, \"%d %[^\\n]\", n, list);\n\n  if (*n > 0)\n    data = allocate_array((size_t)*n, sizeof(*data));\n\n  for (int i = 0; i < *n; ++i)\n    fscanf(fl, \"%d %f %[^\\n]\", &data[i].id, &data[i].value,\n           data[i].neighbors);\n\n  fclose(fl);\n  return data;\n}\n\nstatic size_t hash_id(int id)\n{\n  uint32_t value = (uint32_t)id;\n  value ^= value >> 16;\n  value *= UINT32_C(0x7feb352d);\n  value ^= value >> 15;\n  value *= UINT32_C(0x846ca68b);\n  value ^= value >> 16;\n  return (size_t)value;\n}\n\nstatic int id_map_find(const IdMap *map, int id)\n{\n  size_t slot = hash_id(id) & map->mask;\n\n  while (map->indexes[slot] != 0) {\n    if (map->keys[slot] == id)\n      return map->indexes[slot] - 1;\n    slot = (slot + 1) & map->mask;\n  }\n\n  return -1;\n}\n\nstatic void id_map_insert_first(IdMap *map, int id, int node_index)\n{\n  size_t slot = hash_id(id) & map->mask;\n\n  while (map->indexes[slot] != 0) {\n    if (map->keys[slot] == id)\n      return;\n    slot = (slot + 1) & map->mask;\n  }\n\n  map->keys[slot] = id;\n  map->indexes[slot] = node_index + 1;\n}\n\nstatic IdMap make_id_map(const Node *graph, int n)\n{\n  size_t needed = n > 0 ? (size_t)n : 1;\n  if (needed > SIZE_MAX / 2)\n    fail();\n  needed *= 2;\n\n  size_t capacity = 1;\n  while (capacity < needed) {\n    if (capacity > SIZE_MAX / 2)\n      fail();\n    capacity <<= 1;\n  }\n\n  IdMap map;\n  map.keys = allocate_array(capacity, sizeof(*map.keys));\n  map.indexes = allocate_array(capacity, sizeof(*map.indexes));\n  memset(map.indexes, 0, capacity * sizeof(*map.indexes));\n  map.mask = capacity - 1;\n\n  for (int i = 0; i < n; ++i)\n    id_map_insert_first(&map, graph[i].id, i);\n\n  return map;\n}\n\nstatic int successor_for_node(const Node *graph, int node_index,\n                              const IdMap *map)\n{\n  char neighbors[MAX];\n  char *save;\n  char *token;\n  float best_value = 0.0f;\n  int successor = -1;\n\n  strcpy(neighbors, graph[node_index].neighbors);\n  token = strtok_r(neighbors, \" \", &save);\n\n  while (token != NULL) {\n    int neighbor_index = id_map_find(map, atoi(token));\n\n    if (neighbor_index >= 0 && best_value < graph[neighbor_index].value) {\n      best_value = graph[neighbor_index].value;\n      successor = neighbor_index;\n    }\n\n    token = strtok_r(NULL, \" \", &save);\n  }\n\n  return successor;\n}\n\nstatic void initialize_workspace(int * restrict successor,\n                                 unsigned char * restrict state, int count)\n{\n#if defined(_OPENMP) && _OPENMP >= 201307\n#pragma omp simd\n#endif\n  for (int i = 0; i < count; ++i) {\n    successor[i] = NO_SUCCESSOR;\n    state[i] = 0;\n  }\n}\n\nstatic float resolve_cost(const Node *graph, int start, const IdMap *map,\n                          int *successor, float *cost,\n                          unsigned char *state, int *path)\n{\n  int length = 0;\n  int current = start;\n\n  while (current >= 0 && state[current] == 0) {\n    state[current] = 1;\n    path[length++] = current;\n\n    if (successor[current] == NO_SUCCESSOR)\n      successor[current] = successor_for_node(graph, current, map);\n\n    current = successor[current];\n  }\n\n  float total = 0.0f;\n  if (current >= 0 && state[current] == 2)\n    total = cost[current];\n\n  while (length > 0) {\n    int node_index = path[--length];\n    total = graph[node_index].value + total;\n    cost[node_index] = total;\n    state[node_index] = 2;\n  }\n\n  return cost[start];\n}\n\nint main(void)\n{\n  char *fileN = NULL;\n  char computelist[MAX];\n  int n = -1;\n\n  Node *input = read_input(fileN, &n, computelist);\n  IdMap ids = make_id_map(input, n);\n  int workspace_size = n > 0 ? n : 1;\n  int *successor = allocate_array((size_t)workspace_size,\n                                  sizeof(*successor));\n  float *cost = allocate_array((size_t)workspace_size, sizeof(*cost));\n  unsigned char *state = allocate_array((size_t)workspace_size,\n                                        sizeof(*state));\n  int *path = allocate_array((size_t)workspace_size, sizeof(*path));\n\n  initialize_workspace(successor, state, workspace_size);\n\n  for (char *token = strtok(computelist, \" \"); token != NULL;\n       token = strtok(NULL, \" \")) {\n    int node_index = id_map_find(&ids, atoi(token));\n    float result = node_index < 0\n                     ? 0.0f\n                     : resolve_cost(input, node_index, &ids, successor, cost,\n                                    state, path);\n    printf(\"%s: %f\\n\", token, result);\n  }\n\n  free(path);\n  free(state);\n  free(cost);\n  free(successor);\n  free(ids.indexes);\n  free(ids.keys);\n  free(input);\n\n  return 0;\n}\n"
}

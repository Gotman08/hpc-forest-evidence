#include <iostream>
#include <vector>
#include <cstdio>
#include <climits>

int main() {
    int n,s;
    std::cin >> n >> s;
    std::vector<int> mat(n*n);
    for(int i=0;i<n;i++)
        for(int j=0;j<n;j++) 
            scanf("%d", &mat[i*n+j]);

    assert(s<n);
    assert(n<8000);
    assert(s>0);
    assert(n>0);

    const int cols = n - s + 1;
    std::vector<long long> colSum(n, 0);

    // Initial column sums for the first S rows.
    for (int r=0; r<s; ++r) {
        const int* row = &mat[r*n];
        #pragma omp simd
        for (int c=0; c<n; ++c) colSum[c] += row[c];
    }

    long long mx = LLONG_MIN;

    // Slide the S-row window down one row at a time.
    for (int i=0; i<cols; ++i) {
        // Horizontal sliding-window scan over columns using current column sums.
        long long w = 0;
        #pragma omp simd reduction(+:w)
        for (int c=0; c<s; ++c) w += colSum[c];
        if (w > mx) mx = w;

        for (int j=1; j<cols; ++j) {
            w += colSum[j+s-1] - colSum[j-1];
            if (w > mx) mx = w;
        }

        // Move the vertical window down: remove row i, add row i+s.
        if (i < cols-1) {
            const int* rem = &mat[i*n];
            const int* add = &mat[(i+s)*n];
            #pragma omp simd
            for (int c=0; c<n; ++c) colSum[c] += add[c] - rem[c];
        }
    }

    printf("%lld\n", mx);
}

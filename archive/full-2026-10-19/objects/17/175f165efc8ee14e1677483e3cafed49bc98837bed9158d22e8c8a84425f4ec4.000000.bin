#include <algorithm>
#include <cassert>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <memory>
#include <vector>

class FastInput {
    static constexpr std::size_t bufferSize = 1u << 16;
    unsigned char buffer[bufferSize];
    std::size_t position = 0;
    std::size_t length = 0;

    int nextByte() {
        if (position == length) {
            length = std::fread(buffer, 1, bufferSize, stdin);
            position = 0;
            if (length == 0) return EOF;
        }
        return buffer[position++];
    }

public:
    int nextInt() {
        int c = nextByte();
        while (c != EOF && c <= ' ') c = nextByte();
        const bool negative = c == '-';
        if (c == '-' || c == '+') c = nextByte();
        std::uint32_t value = 0;
        while (c >= '0' && c <= '9') {
            value = value * 10u + static_cast<std::uint32_t>(c - '0');
            c = nextByte();
        }
        const std::int64_t magnitude = static_cast<std::int64_t>(value);
        return static_cast<int>(negative ? -magnitude : magnitude);
    }
};

static std::int64_t maximumWindow(const std::int64_t* columns, int n, int s) {
    std::int64_t sum = 0;
    for (int j = 0; j < s; ++j) sum += columns[j];
    std::int64_t best = sum;
    for (int j = s; j < n; ++j) {
        sum += columns[j] - columns[j - s];
        best = std::max(best, sum);
    }
    return best;
}

int main() {
    FastInput input;
    const int n = input.nextInt();
    const int s = input.nextInt();
    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    const int historyRows = std::min(s, n - s);
    const std::size_t rowWidth = static_cast<std::size_t>(n);
    std::unique_ptr<int[]> historyStorage(
        new int[rowWidth * static_cast<std::size_t>(historyRows)]);
    std::unique_ptr<int[]> rowStorage(new int[rowWidth]);
    std::vector<std::int64_t> columnStorage(rowWidth, 0);
    int* const history = historyStorage.get();
    int* const row = rowStorage.get();
    std::int64_t* const columns = columnStorage.data();

    for (int i = 0; i < s; ++i) {
        int* const destination = i < historyRows
            ? history + static_cast<std::size_t>(i) * rowWidth
            : row;
        for (int j = 0; j < n; ++j) destination[j] = input.nextInt();
        for (int j = 0; j < n; ++j) columns[j] += destination[j];
    }

    std::int64_t best = maximumWindow(columns, n, s);
    int slot = 0;
    for (int i = s; i < n; ++i) {
        for (int j = 0; j < n; ++j) row[j] = input.nextInt();
        int* const outgoing = history + static_cast<std::size_t>(slot) * rowWidth;

        if (i < n - s) {
            for (int j = 0; j < n; ++j) {
                const int incoming = row[j];
                columns[j] += static_cast<std::int64_t>(incoming) - outgoing[j];
                outgoing[j] = incoming;
            }
        } else {
            for (int j = 0; j < n; ++j) {
                columns[j] += static_cast<std::int64_t>(row[j]) - outgoing[j];
            }
        }

        best = std::max(best, maximumWindow(columns, n, s));
        if (++slot == historyRows) slot = 0;
    }

    std::printf("%lld\n", static_cast<long long>(best));
    return 0;
}

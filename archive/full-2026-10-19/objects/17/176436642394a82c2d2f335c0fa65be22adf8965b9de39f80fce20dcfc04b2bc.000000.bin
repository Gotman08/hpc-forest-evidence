    {
      "id": "42a9a0e6163e4b0c",
      "role": "A",
      "mission": {
        "base_commit": "f835f40c1f1b581a3f870cf36d774c815c75791f",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Replacing separate-chaining hash buckets with a contiguous linear-probing table should improve locality during BFS state deduplication by avoiding linked-list pointer chasing and filtering candidates by cached hash before comparing state cells. Key equality and BFS insertion order remain unchanged; the controller should determine whether clustering offsets the locality benefit.",
        "id": "42a9a0e6163e4b0c",
        "ordinal": 2,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/sokoban.c"
          ],
          "retained": [
            "Replace linked collision chains with a contiguous open-addressed bucket array using linear probing.",
            "Rehash occupied entries into a newly allocated doubled table on growth; check cached hashes before comparing state cell arrays."
          ]
        },
        "tree_id": "e1:A",

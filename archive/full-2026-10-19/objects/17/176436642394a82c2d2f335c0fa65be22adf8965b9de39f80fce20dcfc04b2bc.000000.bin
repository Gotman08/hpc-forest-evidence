    {
      "id": "b0269489e35d482a",
      "role": "G",
      "mission": {
        "base_commit": "f835f40c1f1b581a3f870cf36d774c815c75791f",
        "delegation_parent": "R/G",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Combining precomputed bounded neighbors, binary-search box occupancy with incremental sorted-box maintenance, and a contiguous open-addressed state table may reduce movement and duplicate-state lookup costs without changing BFS insertion order or shortest-path tie behavior.",
        "id": "b0269489e35d482a",
        "ordinal": 1,
        "parent_id": null,
        "role": "G",
        "source_commits": [
          "aa61fc67b11ccd567e06bb8bfbb8780d0828a141",
          "fefe8f767703868d0b885b13705a82b91be4332e"
        ],
        "sources": [
          "ed6069da17b6484d",
          "42a9a0e6163e4b0c"
        ],
        "transformations": {
          "files": [
            "src/sokoban.c"
          ],
          "retained": [
            "Precompute each board cell's in-bounds cardinal neighbors and use them for movement and push destinations, rejecting out-of-board moves before indexing board or live.",
            "Use binary search over sorted box positions for occupancy, and shift the moved box into its sorted position only after a push.",
            "Replace linked collision chains with a contiguous linear-probing hash table; grow by doubling, reinsert occupied entries, and compare cached hashes before state arrays."
          ]
        },
        "tree_id": "e1:G",
        "trial_id": "01M545DQ8ACXA3G5RYVSKXFM7P",

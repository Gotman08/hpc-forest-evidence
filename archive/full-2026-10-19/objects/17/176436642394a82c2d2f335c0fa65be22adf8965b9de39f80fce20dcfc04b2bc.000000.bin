  "trials": [
    {
      "id": "ed6069da17b6484d",
      "role": "A",
      "mission": {
        "base_commit": "f835f40c1f1b581a3f870cf36d774c815c75791f",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Precomputed cell neighbors remove repeated coordinate division/modulo and boundary work in the BFS move generator. Binary search over the already sorted box positions reduces occupancy checks, while repositioning only the pushed box replaces quadratic bubble sorting with a linear shift. This should help larger searches while preserving state identity and BFS order.",
        "id": "ed6069da17b6484d",
        "ordinal": 1,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/sokoban.c"
          ],
          "retained": [
            "Precompute up/down/left/right neighboring cell indices once when parsing the board, then use them for movement and push destinations.",
            "Use binary search in sorted box positions for occupancy checks.",
            "Maintain sorted box positions by shifting the moved box into place instead of bubble-sorting the full array."
          ]
        },
        "tree_id": "e1:A",
        "trial_id": "01M544V8F7PAVYA3DNGM99Q6ZJ",
        "worktree": "/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-xhigh/results-749940/2021-sokoban/worktrees/ed6069da17b6484d"

        ],
        "transformations": {
          "files": [
            "src/sokoban.c"
          ],
          "retained": [
            "Replace binary search for box occupancy with a sorted-array linear scan that exits on equality or once positions exceed the target cell.",
            "Retain precomputed bounded neighbors and push-only sorted-box insertion.",
            "Retain cached-hash checks and the open-addressed state table."
          ]
        },

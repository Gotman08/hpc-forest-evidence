#include "knn.h"

#define BLOCK_SIZE 16

typedef struct {
    float distances[BLOCK_SIZE];
    char labels[BLOCK_SIZE];
} Block;

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    Block block;
    for (int i = 0; i < BLOCK_SIZE; i++) {
        block.distances[i] = -1;
        block.labels[i] = -1;
    }

    for (int i = 0; i < n_groups; i++) {
        Group g = groups[i];
        int num_blocks = (g.length + BLOCK_SIZE - 1) / BLOCK_SIZE;

        for (int block_idx = 0; block_idx < num_blocks; block_idx++) {
            int start = block_idx * BLOCK_SIZE;
            int end = (block_idx + 1) * BLOCK_SIZE > g.length ? g.length : (block_idx + 1) * BLOCK_SIZE;

            for (int j = start; j < end; j++) {
                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);

                int x;
                for (x = 0; x < k && block.distances[x] != -1; x++) {
                    if (d < block.distances[x]) {
                        break;
                    }
                }

                if (x < k) {
                    for (int y = k - 1; y > x; y--) {
                        block.distances[y] = block.distances[y - 1];
                        block.labels[y] = block.labels[y - 1];
                    }

                    block.distances[x] = d;
                    block.labels[x] = g.label;
                }
            }
        }
    }

    qsort(block.labels, k, sizeof(char), compare_for_sort);

    char most_frequent = block.labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (int i = 1; i < k; i++) {
        if (block.labels[i] != block.labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = block.labels[i - 1];
                most_frequent_count = current_frequency;
            }

            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = block.labels[i];
            most_frequent_count = current_frequency;
        }
    }

    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}
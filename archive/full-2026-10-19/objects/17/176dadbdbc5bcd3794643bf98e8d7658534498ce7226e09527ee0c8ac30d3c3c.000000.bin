"""ROOT-only constructor of an exact, automated, read-only SO descendant review.

No live collection, cache, transport, worker, model, job or process operation.
Only the pinned564 pure definitions may validate the supplied actual cold inputs.
"""
from __future__ import annotations
import argparse
import ast
import hashlib
import json
import re
import time
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
BASE = HERE.parents[5]
OP = HERE.parents[2]
READER = BASE / "outputs/HPC-Forest-Primes-Natif-Lancement-r2d/source-only-reader-r4/source_only_state.py"
READER_SHA = "564398d676dceb6b5ba893fcbb3835c7aec31a1cbd5d5c5dcef6b361a3a23338"
META_SHA = "6a0b0c2e9e2562daeb6837f517d75fc360fa5f3696bab6bf0274dc0c02d67838"
PURE_NAMES = {"epoch", "identity", "complete_census", "pair", "_absent_owned", "_creation_key", "_unresolved_descendants", "verify_absence"}


def need(condition, message):
    if not condition:
        raise ValueError(message)


def raw(path):
    path = Path(path)
    need(path.is_absolute() and ".." not in path.parts and path.is_relative_to(BASE) and path.is_file()
         and not any(p.is_symlink() or p.is_junction() for p in (path, *path.parents)), "Exact ordinary local evidence required")
    before = path.stat()
    value = path.read_bytes()
    after = path.stat()
    need((before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns) ==
         (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns), "Evidence changed while reading")
    return value


def reference(path, checksum=None):
    path = Path(path)
    actual = hashlib.sha256(raw(path)).hexdigest()
    need(checksum is None or checksum == actual, "Exact evidence SHA differs")
    return {"path": str(path), "sha256": actual}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--complete-absence", type=Path, required=True)
    parser.add_argument("--complete-absence-sha256", required=True)
    parser.add_argument("--current-cim", type=Path, required=True)
    parser.add_argument("--current-cim-sha256", required=True)
    args = parser.parse_args()
    need(args.complete_absence.parent == OP / "preparation-roots-operationnelle-r1"
         and args.current_cim.is_relative_to(OP), "Exact new parent proof and private census boundary required")
    pins = {}

    def bound(ref):
        need(isinstance(ref, dict) and set(ref) == {"path", "sha256"}
             and isinstance(ref["sha256"], str) and re.fullmatch(r"[0-9a-f]{64}", ref["sha256"]), "Closed exact SHA reference required")
        need(reference(ref["path"], ref["sha256"]) == ref, "Reference path or hash differs")
        pins[ref["path"]] = ref["sha256"]
        return Path(ref["path"])

    def read(ref):
        path = bound(ref)
        def pairs(items):
            result = {}
            for name, value in items:
                need(name not in result, "Duplicate JSON member")
                result[name] = value
            return result
        value = json.loads(raw(path).decode("utf-8-sig"), object_pairs_hook=pairs,
                           parse_constant=lambda _: (_ for _ in ()).throw(ValueError("Nonfinite JSON")))
        need(isinstance(value, dict), "Closed metadata JSON object required")
        return value

    proof_ref = {"path": str(args.complete_absence), "sha256": args.complete_absence_sha256}
    current_ref = {"path": str(args.current_cim), "sha256": args.current_cim_sha256}
    proof, current = read(proof_ref), read(current_ref)
    need(proof.get("fresh_full_cim") == current_ref and proof.get("complete_lane_graph_verified") is True
         and proof.get("source_state_reader_sha256") == READER_SHA and proof.get("native_generation_admitted") is False,
         "Actual complete ROOT proof must bind this exact current census and pinned reader")
    closure_ref = reference(BASE / "outputs/HPC-Forest-Harnais-Comparaison-r1/reprises/r3-corrige-r4-parallele-20261018/fermeture-r2-main-only-verifiee.json",
                            "f9d64a0e87ad68248429681cb3efe01a9e56289fba615eeb55291089665aee3d")
    closure = read(closure_ref)
    need(closure.get("verified") is True, "Actual immutable pair anchor required")
    code = raw(READER)
    need(hashlib.sha256(code).hexdigest() == READER_SHA, "Exact corrected reader564 required")
    functions = [node for node in ast.parse(code).body if isinstance(node, ast.FunctionDef) and node.name in PURE_NAMES]
    need({node.name for node in functions} == PURE_NAMES, "Exact closed pure function set required")
    namespace = {"need": need, "read": read, "artifact": bound, "time": time, "datetime": datetime, "UTC": UTC, "re": re,
                 "FIELDS": ("ProcessId", "ParentProcessId", "ExecutablePath", "CommandLine", "CreationDate"),
                 "SO_SESSION": "665743a02b824021a697b6a4884a667c",
                 "SO_SOURCE": "9a68a83fde4acb6bd247d79e00490e7d36f0c4c59c6c881152101e4c499387eb", "COLD_RECEPTION_SHA": META_SHA}
    exec(compile(ast.Module(body=functions, type_ignores=[]), str(READER), "exec"), namespace)
    # Only these exact pure functions are invoked, with read-only closed inputs.
    owned = namespace["verify_absence"](proof, closure["source_only"], current)
    need(len(owned) == 7 and len({namespace["identity"](row) for row in owned}) == 7,
         "Original pair and exactly five fully attributed identities required")
    candidate_ref = reference(HERE.parent / "ANALYSE-DESCENDANTS-SO-FROIDE-CANDIDATE.json",
                              "f286941c5a10e0b33b0061acc2adfb610a39bf5a7404a58b36b956464218b90b")
    for path, checksum in pins.items():
        reference(path, checksum)
    reader_ref = reference(READER, READER_SHA)
    # Full graph validation repeats immediately before publication. No future-state promise.
    namespace["verify_absence"](proof, closure["source_only"], current)
    value = {"schema": "hpc-forest-lane-r2-owned-descendant-review-v1", "verified": True, "blocking_findings": [],
             "source_only_absence": proof_ref, "source_state_reader_sha256": READER_SHA, "unresolved_owned_descendants": [],
             "reviewer": "independently reviewed exact564 automated read-only constructor, executed by ROOT",
             "reviewer_read_only_automated_scope": "Exact pinned564 eight-function graph validation of caller-pinned actual complete SO absence and current private CIM; no personal manual current observation",
             "personal_manual_current_observation": False, "observed_at_utc": datetime.now(UTC).isoformat(),
             "owned_identity_count": len(owned), "current_full_cim": current_ref,
             "original_pair_and_five_attributed_descendants_validated": True,
             "prior_cold_absence_current_graph_and_PID_reuse_checked_by_exact564": True,
             "constructor": reference(Path(__file__)), "prior_independent_cold_analysis": candidate_ref,
             "evidence_refs": [proof_ref, current_ref, closure_ref, reader_ref, candidate_ref, *proof["evidence_refs"]],
             "native_generation_admitted": False, "activation_admitted": False, "science_performance_or_method_R5_admitted": False,
             "source_module_or_main_imported": False, "live_CIM_cache_lock_model_MCP_job_process_effect": False,
             "limits": "Automated exact cold-metadata review only, fresh at the exact564 validation call. Source564/lane must recheck the actual full current census and every separate exact-cell admission gate before any native start. Historical/future state is not silently promoted; no foreign identity is adopted or stopped."}
    target = HERE / ("REVUE-DESCENDANTS-SO-" + proof_ref["sha256"][:12] + ".json")
    with target.open("x", encoding="utf-8", newline="\n") as stream:
        json.dump(value, stream, ensure_ascii=False, indent=2); stream.write("\n")
    print(json.dumps(reference(target), ensure_ascii=False))


if __name__ == "__main__":
    main()

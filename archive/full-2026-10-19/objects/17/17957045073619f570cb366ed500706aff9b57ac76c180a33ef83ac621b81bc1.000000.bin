#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors
#define IB 8       // i-block size for cache blocking

/*
 * Compute the gravitational impact among all pairs of bodies in 
 * the system.
 * Uses structure-of-arrays layout and blocks over the outer (i) loop,
 * reusing each j-body's coordinates across IB accumulators. The inner
 * summation order per body remains strictly increasing in j, preserving
 * bit-exact results compared to the reference implementation.
 */
void body_force(float *px, float *py, float *pz,
                float *vx, float *vy, float *vz,
                int n, float dt) {
  #pragma omp parallel for schedule(static)
  for (int ib = 0; ib < n; ib += IB) {
    int iend = ib + IB;
    if (iend > n) iend = n;

    // Accumulators for the current block of bodies.
    float fx[IB], fy[IB], fz[IB];
    const int cnt = iend - ib;
    for (int k = 0; k < cnt; ++k) {
      fx[k] = 0.0f;
      fy[k] = 0.0f;
      fz[k] = 0.0f;
    }

    // Sweep over all j bodies once per block.
    for (int j = 0; j < n; ++j) {
      const float pjx = px[j];
      const float pjy = py[j];
      const float pjz = pz[j];

      // Accumulate forces for all bodies in this block.
      int k = 0;
      for (int i = ib; i < iend; ++i, ++k) {
        const float dx = pjx - px[i];
        const float dy = pjy - py[i];
        const float dz = pjz - pz[i];
        const float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
        const float inv_dist = 1.0f / sqrt(sqrd_dist);
        const float inv_dist3 = inv_dist * inv_dist * inv_dist;

        fx[k] += dx * inv_dist3;
        fy[k] += dy * inv_dist3;
        fz[k] += dz * inv_dist3;
      }
    }

    // Update velocities for this block.
    int k = 0;
    for (int i = ib; i < iend; ++i, ++k) {
      vx[i] += dt*fx[k];
      vy[i] += dt*fy[k];
      vz[i] += dt*fz[k];
    }
  }
}

/*
 * Read a binary dataset with initialized bodies.
 */
int read_dataset(float **px, float **py, float **pz,
                 float **vx, float **vy, float **vz) {
  int nbodies;
  if (fread(&nbodies, sizeof(nbodies), 1, stdin) != 1) {
    fprintf(stderr, "\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }

  // Temporary AoS buffer for input parsing.
  typedef struct { float x, y, z, vx, vy, vz; } Body;
  Body *in = (Body *)malloc(nbodies * sizeof(Body));
  if (!in) {
    fprintf(stderr, "\nMemory allocation failed\n");
    exit(EXIT_FAILURE);
  }
  if (fread(in, nbodies * sizeof(Body), 1, stdin) != 1) {
    fprintf(stderr, "\nError reading input values\n");
    free(in);
    exit(EXIT_FAILURE);
  }

  // Allocate SoA arrays.
  *px = (float *)malloc(nbodies * sizeof(float));
  *py = (float *)malloc(nbodies * sizeof(float));
  *pz = (float *)malloc(nbodies * sizeof(float));
  *vx = (float *)malloc(nbodies * sizeof(float));
  *vy = (float *)malloc(nbodies * sizeof(float));
  *vz = (float *)malloc(nbodies * sizeof(float));
  if (!*px || !*py || !*pz || !*vx || !*vy || !*vz) {
    fprintf(stderr, "\nMemory allocation failed\n");
    exit(EXIT_FAILURE);
  }

  // Deinterleave.
  for (int i = 0; i < nbodies; ++i) {
    (*px)[i] = in[i].x;
    (*py)[i] = in[i].y;
    (*pz)[i] = in[i].z;
    (*vx)[i] = in[i].vx;
    (*vy)[i] = in[i].vy;
    (*vz)[i] = in[i].vz;
  }

  free(in);
  return nbodies;
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(int n, const float *px, const float *py, const float *pz,
                   const float *vx, const float *vy, const float *vz) {
  typedef struct { float x, y, z, vx, vy, vz; } Body;
  Body *out = (Body *)malloc(n * sizeof(Body));
  if (!out) {
    fprintf(stderr, "\nMemory allocation failed\n");
    exit(EXIT_FAILURE);
  }

  for (int i = 0; i < n; ++i) {
    out[i].x = px[i];
    out[i].y = py[i];
    out[i].z = pz[i];
    out[i].vx = vx[i];
    out[i].vy = vy[i];
    out[i].vz = vz[i];
  }

  if (fwrite(out, n * sizeof(Body), 1, stdout) != 1) {
    fprintf(stderr, "\nError writing to output\n");
    free(out);
    exit(EXIT_FAILURE);
  }
  free(out);
}

int main(int argc, char **argv) {
  float *px, *py, *pz, *vx, *vy, *vz;
  int nbodies = read_dataset(&px, &py, &pz, &vx, &vy, &vz);

  /*
   * At each simulation iteration, interbody forces are computed,
   * and bodies' positions are integrated.
   */
  for (int iter = 0; iter < N_ITER; ++iter) {
    body_force(px, py, pz, vx, vy, vz, nbodies, DT);

    #pragma omp parallel for schedule(static)
    for (int i = 0; i < nbodies; ++i) {
      px[i] += vx[i] * DT;
      py[i] += vy[i] * DT;
      pz[i] += vz[i] * DT;
    }
  }

  write_dataset(nbodies, px, py, pz, vx, vy, vz);

  free(px); free(py); free(pz);
  free(vx); free(vy); free(vz);

  return EXIT_SUCCESS;
}

        "content": "#include \"knn.h\"\n#include <float.h>\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\nstatic char knn_insertion_fallback(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j;\n    int used = 0;\n    int ordered = 1;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            /* Preserve the original insertion behavior for unordered distances. */\n            if (!ordered || d != d) {\n                for (int x = 0; x < k; x++) {\n                    if (d < distances[x] || distances[x] == -1) {\n                        for (int y = k - 1; y > x; y--) {\n                            distances[y] = distances[y - 1];\n                            labels[y] = labels[y - 1];\n                        }\n\n                        distances[x] = d;\n                        labels[x] = g.label;\n                        if (used < k) used++;\n                        if (d != d) ordered = 0;\n                        break;\n                    }\n                }\n                continue;\n            }\n\n            int end;\n            if (used < k) {\n                end = used++;\n            } else {\n                /* Equal distances retain the earlier point. */\n                if (!(d < distances[k - 1])) continue;\n                end = k - 1;\n            }\n\n            /* Upper bound preserves the original stable distance ordering. */\n            int lo = 0;\n            int hi = end;\n            while (lo < hi) {\n                int mid = lo + (hi - lo) / 2;\n                if (d < distances[mid]) {\n                    hi = mid;\n                } else {\n                    lo = mid + 1;\n                }\n            }\n\n            size_t moved = (size_t) (end - lo);\n            if (moved != 0) {\n                memmove(distances + lo + 1, distances + lo,\n                        moved * sizeof(*distances));\n                memmove(labels + lo + 1, labels + lo,\n                        moved * sizeof(*labels));\n            }\n            distances[lo] = d;\n            labels[lo] = g.label;\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nstatic void knn_sift_keys(uint64_t * keys, size_t root, size_t count) {\n    uint64_t value = keys[root];\n    while (root < count / 2) {\n        size_t child = root * 2 + 1;\n        if (child + 1 < count && keys[child] < keys[child + 1]) child++;\n        if (value >= keys[child]) break;\n        keys[root] = keys[child];\n        root = child;\n    }\n    keys[root] = value;\n}\n\nstatic void knn_sort_keys(uint64_t * keys, size_t count) {\n    if (count < 2) return;\n    for (size_t root = count / 2; root > 0;) {\n        --root;\n        knn_sift_keys(keys, root, count);\n    }\n    for (size_t end = count; end > 1;) {\n        --end;\n        uint64_t value = keys[0];\n        keys[0] = keys[end];\n        keys[end] = value;\n        knn_sift_keys(keys, 0, end);\n    }\n}\n\nstatic uint64_t knn_median_key(uint64_t a, uint64_t b, uint64_t c) {\n    if (a > b) {\n        uint64_t value = a;\n        a = b;\n        b = value;\n    }\n    if (b > c) {\n        uint64_t value = b;\n        b = c;\n        c = value;\n    }\n    return a > b ? a : b;\n}\n\n/* Leave the smallest keep keys in the contiguous prefix. */\nstatic void knn_select_keys(uint64_t * keys, size_t count, size_t keep) {\n    if (keep == 0 || keep >= count) return;\n\n    size_t lo = 0;\n    size_t hi = count;\n    unsigned int budget = 0;\n    for (size_t remaining = count; remaining > 1; remaining >>= 1) budget += 2;\n\n    while (hi - lo > 24) {\n        if (budget == 0) {\n            knn_sort_keys(keys + lo, hi - lo);\n            return;\n        }\n        --budget;\n\n        uint64_t pivot = knn_median_key(keys[lo], keys[lo + (hi - lo) / 2],\n                                        keys[hi - 1]);\n        size_t left = lo;\n        size_t scan = lo;\n        size_t right = hi;\n        while (scan < right) {\n            uint64_t value = keys[scan];\n            if (value < pivot) {\n                keys[scan] = keys[left];\n                keys[left] = value;\n                ++left;\n                ++scan;\n            } else if (value > pivot) {\n                --right;\n                keys[scan] = keys[right];\n                keys[right] = value;\n            } else {\n                ++scan;\n            }\n        }\n\n        if (keep < left) {\n            hi = left;\n        } else if (keep > right) {\n            lo = right;\n        } else {\n            return;\n        }\n    }\n\n    for (size_t i = lo + 1; i < hi; i++) {\n        uint64_t value = keys[i];\n        size_t j = i;\n        while (j > lo && value < keys[j - 1]) {\n            keys[j] = keys[j - 1];\n            --j;\n        }\n        keys[j] = value;\n    }\n}\n\nstatic char knn_vote(const size_t * counts) {\n    char winner = (char) -1;\n    size_t best_count = 0;\n    for (int value = 0; value <= UCHAR_MAX; value++) {\n        char label = (char) (unsigned char) value;\n        if (counts[value] > best_count ||\n            (counts[value] == best_count && counts[value] != 0 && label < winner)) {\n            winner = label;\n            best_count = counts[value];\n        }\n    }\n    return winner;\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    if (k <= 0 || sizeof(float) != sizeof(uint32_t) || FLT_RADIX != 2 ||\n        FLT_MANT_DIG != 24 || FLT_MAX_EXP != 128) {\n        return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t total = 0;\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length > 0) {\n            size_t length = (size_t) groups[i].length;\n            if (length > SIZE_MAX - total) {\n                return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\n            }\n            total += length;\n        }\n    }\n\n    size_t counts[UCHAR_MAX + 1] = {0};\n    size_t keep = (size_t) k;\n    if (total <= keep) {\n        counts[(unsigned char) (char) -1] = keep - total;\n        for (int i = 0; i < n_groups; i++) {\n            if (groups[i].length > 0) {\n                counts[(unsigned char) groups[i].label] += (size_t) groups[i].length;\n            }\n        }\n        return knn_vote(counts);\n    }\n\n    size_t extra = keep < 1024 ? 1024 : keep;\n    size_t capacity = extra > total - keep ? total : keep + extra;\n    if (capacity > SIZE_MAX / sizeof(uint64_t)) {\n        return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\n    }\n    uint64_t * keys = (uint64_t *) malloc(capacity * sizeof(*keys));\n    if (keys == NULL) {\n        return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t used = 0;\n    uint64_t cutoff = UINT64_MAX;\n    int have_cutoff = 0;\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            float distance = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            uint32_t bits;\n            memcpy(&bits, &distance, sizeof(bits));\n            bits &= UINT32_C(0x7fffffff);\n            if (bits > UINT32_C(0x7f800000)) {\n                free(keys);\n                return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\n            }\n\n            /* Nonnegative float bits sort numerically. Group order breaks ties;\n               tied points within one group have identical voting effects. */\n            uint64_t key = ((uint64_t) bits << 32) | (uint32_t) i;\n            if (have_cutoff && key >= cutoff) continue;\n            keys[used++] = key;\n\n            if (used == capacity) {\n                knn_select_keys(keys, used, keep);\n                used = keep;\n                cutoff = keys[0];\n                for (size_t x = 1; x < keep; x++) {\n                    if (keys[x] > cutoff) cutoff = keys[x];\n                }\n                have_cutoff = 1;\n            }\n        }\n    }\n\n    knn_select_keys(keys, used, keep);\n    for (size_t i = 0; i < keep; i++) {\n        size_t group = (size_t) (uint32_t) keys[i];\n        counts[(unsigned char) groups[group].label]++;\n    }\n    free(keys);\n    return knn_vote(counts);\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",

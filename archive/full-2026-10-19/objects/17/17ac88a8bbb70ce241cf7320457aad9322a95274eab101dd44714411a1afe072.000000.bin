      "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\n#if defined(__aarch64__) || defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nusing namespace std;\n\nconstexpr uint32_t MOD = 1000000007U;\n\nstatic inline uint32_t add_mod(uint32_t left, uint32_t right) {\n    const uint32_t sum = left + right;\n    return sum >= MOD ? sum - MOD : sum;\n}\n\n#if defined(__aarch64__) || defined(__ARM_NEON)\nstatic inline uint32x4_t add_mod(uint32x4_t left, uint32x4_t right) {\n    const uint32x4_t sum = vaddq_u32(left, right);\n    const uint32x4_t needs_reduction = vcgeq_u32(sum, vdupq_n_u32(MOD));\n    return vsubq_u32(sum, vandq_u32(needs_reduction, vdupq_n_u32(MOD)));\n}\n#endif\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    size_t m;\n    cin >> n >> m;\n\n    vector<uint64_t> blocked;\n    blocked.reserve(m);\n    for (size_t i = 0; i < m; ++i) {\n        int y, x;\n        cin >> y >> x;\n        blocked.push_back(static_cast<uint64_t>(y) * static_cast<uint64_t>(n) +\n                          static_cast<uint32_t>(x));\n    }\n    sort(blocked.begin(), blocked.end());\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\n\n    vector<uint32_t> dp(n, 0);\n    dp[0] = 1;\n\n    size_t blocked_index = 0;\n    for (int y = 0; y < n; ++y) {\n        const uint64_t row_begin = static_cast<uint64_t>(y) * static_cast<uint64_t>(n);\n        const uint64_t row_end = row_begin + static_cast<uint64_t>(n);\n        int segment_begin = 0;\n\n        while (blocked_index < blocked.size() && blocked[blocked_index] < row_end) {\n            const int blocked_x = static_cast<int>(blocked[blocked_index] - row_begin);\n\n#if defined(__aarch64__) || defined(__ARM_NEON)\n            uint32_t carry = segment_begin == 0 ? 0 : dp[segment_begin - 1];\n            int x = segment_begin;\n            const uint32x4_t zero = vdupq_n_u32(0);\n            for (; x + 4 <= blocked_x; x += 4) {\n                uint32x4_t values = vld1q_u32(dp.data() + x);\n                values = add_mod(values, vextq_u32(zero, values, 3));\n                values = add_mod(values, vextq_u32(zero, values, 2));\n                values = add_mod(values, vdupq_n_u32(carry));\n                vst1q_u32(dp.data() + x, values);\n                carry = vgetq_lane_u32(values, 3);\n            }\n            for (; x < blocked_x; ++x) {\n                dp[x] = add_mod(dp[x], carry);\n                carry = dp[x];\n            }\n#else\n            uint32_t carry = segment_begin == 0 ? 0 : dp[segment_begin - 1];\n            for (int x = segment_begin; x < blocked_x; ++x) {\n                dp[x] = add_mod(dp[x], carry);\n                carry = dp[x];\n            }\n#endif\n\n            dp[blocked_x] = 0;\n            segment_begin = blocked_x + 1;\n            ++blocked_index;\n        }\n\n#if defined(__aarch64__) || defined(__ARM_NEON)\n        uint32_t carry = segment_begin == 0 ? 0 : dp[segment_begin - 1];\n        int x = segment_begin;\n        const uint32x4_t zero = vdupq_n_u32(0);\n        for (; x + 4 <= n; x += 4) {\n            uint32x4_t values = vld1q_u32(dp.data() + x);\n            values = add_mod(values, vextq_u32(zero, values, 3));\n            values = add_mod(values, vextq_u32(zero, values, 2));\n            values = add_mod(values, vdupq_n_u32(carry));\n            vst1q_u32(dp.data() + x, values);\n            carry = vgetq_lane_u32(values, 3);\n        }\n        for (; x < n; ++x) {\n            dp[x] = add_mod(dp[x], carry);\n            carry = dp[x];\n        }\n#else\n        uint32_t carry = segment_begin == 0 ? 0 : dp[segment_begin - 1];\n        for (int x = segment_begin; x < n; ++x) {\n            dp[x] = add_mod(dp[x], carry);\n            carry = dp[x];\n        }\n#endif\n    }\n\n    cout << dp[n - 1] << '\\n';\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "The row recurrence has a real carry dependency, but each obstacle-free run can be evaluated legally with a four-lane inclusive SIMD prefix scan; sparse sorted blockers delimit independent runs without a dense blocked-cell matrix.",
  "notes": "Uses a scalar fallback when ARM NEON is unavailable. Duplicate blocked coordinates are normalized before processing.",

        "epoch": 1,
        "hypothesis": "Resolve each adjacency once, SIMD-reduce only its independent contiguous value scan, and retain ordered tie recovery; cached successor chains remove repeated dependent traversal without changing float accumulation order.",
        "id": "10b1942c13624eb3",
        "ordinal": 1,
        "parent_id": null,
        "role": "B",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/graph.c"
          ],
          "retained": [
            "Replace repeated string tokenization and linear ID searches with dynamic compact adjacency storage plus a first-ID hash lookup.",
            "Use a NEON maximum pass for sufficiently long adjacency lists, followed by an ordered first-equal recovery pass to preserve strict first-tie semantics.",
            "Memoize greedy DAG successor-chain costs with iterative unwinding while retaining serial float additions."
          ]
        },

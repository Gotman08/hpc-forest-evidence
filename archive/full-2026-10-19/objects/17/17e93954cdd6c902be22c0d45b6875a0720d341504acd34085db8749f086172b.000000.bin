        "content": "#include \"knn.h\"\n#include <float.h>\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\ntypedef struct {\n    size_t buckets[256];\n    size_t votes[UCHAR_MAX + 1];\n    size_t equals;\n    int exceptional;\n} KNNThreadState;\n\nstatic char winning_label(const size_t * votes) {\n    char best = (char)-1;\n    size_t best_count = 0;\n\n    for (unsigned int value = 0; value <= UCHAR_MAX; value++) {\n        char label = (char)(unsigned char)value;\n        if (votes[value] > best_count ||\n            (best_count != 0 && votes[value] == best_count && label < best)) {\n            best = label;\n            best_count = votes[value];\n        }\n    }\n    return best;\n}\n\nstatic char insertion_knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    if ((size_t)k > SIZE_MAX / sizeof(float)) {\n        on_error();\n        return (char)-1;\n    }\n\n    char * labels = (char *)malloc((size_t)k * sizeof(*labels));\n    float * distances = (float *)malloc((size_t)k * sizeof(*distances));\n    if (labels == NULL || distances == NULL) {\n        free(labels);\n        free(distances);\n        on_error();\n        return (char)-1;\n    }\n\n    for (int i = 0; i < k; i++) {\n        labels[i] = (char)-1;\n        distances[i] = -1.0f;\n    }\n\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (int x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1.0f) {\n                    for (int y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    size_t votes[UCHAR_MAX + 1] = {0};\n    for (int i = 0; i < k; i++) {\n        votes[(unsigned char)labels[i]]++;\n    }\n    char result = winning_label(votes);\n    free(distances);\n    free(labels);\n    return result;\n}\n\nstatic int radix_float_layout(void) {\n    if (sizeof(float) != sizeof(uint32_t) || FLT_RADIX != 2 ||\n        FLT_MANT_DIG != 24 || FLT_MAX_EXP != 128 || FLT_MIN_EXP != -125) {\n        return 0;\n    }\n    const float one = 1.0f;\n    uint32_t bits;\n    memcpy(&bits, &one, sizeof(bits));\n    return bits == UINT32_C(0x3f800000);\n}\n\nstatic inline unsigned int knn_candidate_mask(const uint32_t * values,\n                                               int count, uint32_t cutoff) {\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    if (count == 16) {\n        const uint32x4_t bound = vdupq_n_u32(cutoff);\n        const uint8x16_t weights = {\n            1, 2, 4, 8, 16, 32, 64, 128,\n            1, 2, 4, 8, 16, 32, 64, 128\n        };\n        uint8x16_t a = vreinterpretq_u8_u32(\n            vcltq_u32(vld1q_u32(values), bound));\n        uint8x16_t b = vreinterpretq_u8_u32(\n            vcltq_u32(vld1q_u32(values + 4), bound));\n        uint8x16_t c = vreinterpretq_u8_u32(\n            vcltq_u32(vld1q_u32(values + 8), bound));\n        uint8x16_t d = vreinterpretq_u8_u32(\n            vcltq_u32(vld1q_u32(values + 12), bound));\n        uint8x16_t ab = vuzp1q_u8(a, b);\n        uint8x16_t cd = vuzp1q_u8(c, d);\n        uint8x16_t matches = vuzp1q_u8(ab, cd);\n        uint8x16_t bits = vandq_u8(matches, weights);\n        unsigned int low = vaddv_u8(vget_low_u8(bits));\n        unsigned int high = vaddv_u8(vget_high_u8(bits));\n        return low | (high << 8);\n    }\n#endif\n\n    unsigned int mask = 0;\n    for (int lane = 0; lane < count; lane++) {\n        if (values[lane] < cutoff) {\n            mask |= 1u << lane;\n        }\n    }\n    return mask;\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    if (k <= 0) {\n        return (char)-1;\n    }\n\n    size_t total = 0;\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length > 0) {\n            size_t length = (size_t)groups[i].length;\n            if (length > SIZE_MAX - total) {\n                return insertion_knn(n_groups, groups, k, to_evaluate);\n            }\n            total += length;\n        }\n    }\n\n    if (total <= (size_t)k) {\n        size_t votes[UCHAR_MAX + 1] = {0};\n        for (int i = 0; i < n_groups; i++) {\n            if (groups[i].length > 0) {\n                votes[(unsigned char)groups[i].label] += (size_t)groups[i].length;\n            }\n        }\n        votes[(unsigned char)(char)-1] += (size_t)k - total;\n        return winning_label(votes);\n    }\n\n    if (!radix_float_layout() || total > SIZE_MAX / sizeof(uint32_t)) {\n        return insertion_knn(n_groups, groups, k, to_evaluate);\n    }\n\n    uint32_t * keys = (uint32_t *)malloc(total * sizeof(*keys));\n    if (keys == NULL) {\n        return insertion_knn(n_groups, groups, k, to_evaluate);\n    }\n\n    int thread_capacity = 1;\n#ifdef _OPENMP\n    thread_capacity = omp_get_max_threads();\n    if (thread_capacity < 1) thread_capacity = 1;\n#endif\n    if ((size_t)thread_capacity > SIZE_MAX / sizeof(KNNThreadState)) {\n        free(keys);\n        return insertion_knn(n_groups, groups, k, to_evaluate);\n    }\n    KNNThreadState * states = (KNNThreadState *)malloc(\n        (size_t)thread_capacity * sizeof(*states));\n    if (states == NULL) {\n        free(keys);\n        return insertion_knn(n_groups, groups, k, to_evaluate);\n    }\n\n    uint32_t prefix = 0;\n    uint32_t prefix_mask = 0;\n    size_t rank = (size_t)k - 1;\n    size_t lower_count = 0;\n    unsigned int selected_bucket = 0;\n    int exceptional = 0;\n\n#ifdef _OPENMP\n#pragma omp parallel if(total >= 4096)\n#endif\n    {\n        int tid = 0;\n        int nt = 1;\n#ifdef _OPENMP\n        tid = omp_get_thread_num();\n        nt = omp_get_num_threads();\n#endif\n        size_t thread = (size_t)tid;\n        size_t team = (size_t)nt;\n        size_t base = total / team;\n        size_t remainder = total % team;\n        size_t begin = base * thread + (thread < remainder ? thread : remainder);\n        size_t end = begin + base + (thread < remainder);\n        int local_exceptional = 0;\n        size_t offset = 0;\n\n        for (int i = 0; i < n_groups; i++) {\n            Group g = groups[i];\n            if (g.length <= 0) continue;\n            size_t length = (size_t)g.length;\n            size_t next = offset + length;\n            if (next > begin && offset < end) {\n                size_t first = begin > offset ? begin - offset : 0;\n                size_t last = end < next ? end - offset : length;\n                for (size_t j = first; j < last; j++) {\n                    float distance = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n                    uint32_t key;\n                    memcpy(&key, &distance, sizeof(key));\n                    key &= UINT32_C(0x7fffffff);\n                    if (key > UINT32_C(0x7f800000)) local_exceptional = 1;\n                    keys[offset + j] = key;\n                }\n            }\n            offset = next;\n            if (offset >= end) break;\n        }\n        states[tid].exceptional = local_exceptional;\n\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n        {\n            exceptional = 0;\n            for (int t = 0; t < nt; t++) {\n                exceptional |= states[t].exceptional;\n            }\n        }\n\n        if (!exceptional) {\n            for (int shift = 24; shift >= 0; shift -= 8) {\n                size_t local_buckets[256] = {0};\n                for (size_t position = begin; position < end; position++) {\n                    uint32_t key = keys[position];\n                    if ((key & prefix_mask) == prefix) {\n                        local_buckets[(key >> shift) & UINT32_C(255)]++;\n                    }\n                }\n                memcpy(states[tid].buckets, local_buckets, sizeof(local_buckets));\n#ifdef _OPENMP\n#pragma omp barrier\n#endif\n                for (size_t stride = 1; stride < team; stride *= 2) {\n                    if (thread % (2 * stride) == 0 && thread + stride < team) {\n                        for (unsigned int bucket = 0; bucket < 256; bucket++) {\n                            states[tid].buckets[bucket] +=\n                                states[thread + stride].buckets[bucket];\n                        }\n                    }\n#ifdef _OPENMP\n#pragma omp barrier\n#endif\n                }\n#ifdef _OPENMP\n#pragma omp single\n#endif\n                {\n                    unsigned int bucket = 0;\n                    while (bucket < 255 && rank >= states[0].buckets[bucket]) {\n                        rank -= states[0].buckets[bucket];\n                        lower_count += states[0].buckets[bucket];\n                        bucket++;\n                    }\n                    prefix |= (uint32_t)bucket << shift;\n                    prefix_mask |= UINT32_C(255) << shift;\n                    selected_bucket = bucket;\n                }\n                if (shift == 0) {\n                    states[tid].equals = local_buckets[selected_bucket];\n                }\n            }\n#ifdef _OPENMP\n#pragma omp barrier\n#endif\n            size_t equal_quota = (size_t)k - lower_count;\n            for (int t = 0; t < tid; t++) {\n                if (states[t].equals >= equal_quota) {\n                    equal_quota = 0;\n                    break;\n                }\n                equal_quota -= states[t].equals;\n            }\n            if (equal_quota > states[tid].equals) {\n                equal_quota = states[tid].equals;\n            }\n\n            memset(states[tid].votes, 0, sizeof(states[tid].votes));\n            offset = 0;\n            for (int i = 0; i < n_groups; i++) {\n                Group g = groups[i];\n                if (g.length <= 0) continue;\n                size_t next = offset + (size_t)g.length;\n                if (next > begin && offset < end) {\n                    size_t first = begin > offset ? begin : offset;\n                    size_t last = end < next ? end : next;\n                    size_t accepted = 0;\n                    for (size_t position = first; position < last;) {\n                        size_t remaining = last - position;\n                        int count = remaining > 16 ? 16 : (int)remaining;\n                        uint32_t bound = prefix + (uint32_t)(equal_quota != 0);\n                        unsigned int candidates = knn_candidate_mask(\n                            keys + position, count, bound);\n                        while (candidates != 0) {\n                            unsigned int lane = (unsigned int)__builtin_ctz(candidates);\n                            candidates &= candidates - 1u;\n                            uint32_t key = keys[position + (size_t)lane];\n                            if (key < prefix) {\n                                accepted++;\n                            } else if (key == prefix && equal_quota != 0) {\n                                accepted++;\n                                equal_quota--;\n                            }\n                        }\n                        position += (size_t)count;\n                    }\n                    states[tid].votes[(unsigned char)g.label] += accepted;\n                }\n                offset = next;\n                if (offset >= end) break;\n            }\n#ifdef _OPENMP\n#pragma omp barrier\n#endif\n            for (size_t stride = 1; stride < team; stride *= 2) {\n                if (thread % (2 * stride) == 0 && thread + stride < team) {\n                    for (unsigned int value = 0; value <= UCHAR_MAX; value++) {\n                        states[tid].votes[value] += states[thread + stride].votes[value];\n                    }\n                }\n#ifdef _OPENMP\n#pragma omp barrier\n#endif\n            }\n        }\n    }\n\n    if (exceptional) {\n        free(states);\n        free(keys);\n        return insertion_knn(n_groups, groups, k, to_evaluate);\n    }\n    char result = winning_label(states[0].votes);\n    free(states);\n    free(keys);\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
        "path": "src/knn.c"
      }

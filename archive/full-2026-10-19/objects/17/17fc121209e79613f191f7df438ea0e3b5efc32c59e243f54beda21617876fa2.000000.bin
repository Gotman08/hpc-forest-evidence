        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Blocking four target bodies together should reuse each source body's position loads across four force calculations and expose more independent work, improving locality and latency hiding without changing the ascending source order or arithmetic for any target.",
        "transformations_as_declared_by_model": {

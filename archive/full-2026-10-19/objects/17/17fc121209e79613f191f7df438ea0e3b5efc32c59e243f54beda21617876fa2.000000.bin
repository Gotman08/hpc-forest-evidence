        "role": "B",
        "parent_id": null,
        "delegation_parent": "R/B",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Each Heap permutation changes the mapping at only two source positions. Maintaining the exact count of lower-triangle adjacency mismatches and updating only pairs touching those positions should reduce each verification from O(n²) comparisons to O(n), without changing permutation order or output.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/brute_isomorphism.cpp"
          ],
          "retained": [
            "Replace full verification after each Heap swap with an exact incremental mismatch count; update the diagonals and every lower-triangle pair involving either swapped source position."

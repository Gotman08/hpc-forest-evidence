        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Packing each adjacency row into 64-bit words should reduce proxy-bit accesses and scalar comparisons. Maintaining the target graph in permutation coordinates lets each Heap transposition update only the affected mismatch bits with XOR and popcount, while preserving diagonal checks, permutation order, and output behavior.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/brute_isomorphism.cpp"
          ],
          "retained": [
            "Replaced vector-of-vector boolean adjacency storage with packed 64-bit adjacency rows.",
            "Maintained the permuted target adjacency by swapping the two affected rows and columns after each Heap swap.",
            "Updated the exact lower-triangle mismatch count using word-level XOR and popcount over only affected pairs; retained the original Heap enumeration and printing flow."
          ]
        },
        "status": "valid",

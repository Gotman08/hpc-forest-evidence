        "integration_sources": [],
        "hypothesis_as_declared_by_model": "A degree-multiset rejection and per-mapping degree filter can avoid many adjacency comparisons; for larger remaining searches, bounded OpenMP batches may speed independent checks while preserving Heap order during output.",
        "transformations_as_declared_by_model": {
          "files": [

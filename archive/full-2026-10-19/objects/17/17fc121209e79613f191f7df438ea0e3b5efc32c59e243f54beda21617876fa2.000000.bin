        "delegation_parent": "R/A",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Keeping each BFS level in a contiguous array preserves sequential frontier scans. Generating moves in the reference traversal order and reversing the completed next-level array emulates prepended-list ordering, while early exits in the sorted box vector reduce unnecessary transition scans.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/sokoban.c"
          ],
          "retained": [
            "Generate successors in the reference traversal order and reverse each completed contiguous next-level array to preserve its prepended-frontier visitation order.",

        "integration_sources": [],
        "hypothesis_as_declared_by_model": "A persistent OpenMP team with static target-body work sharing should reduce team-creation and scheduling overhead while using the four available cores for sufficiently large inputs. A serial threshold avoids parallel overhead on small inputs.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/nbody.c"
          ],
          "retained": [
            "Reuse one OpenMP parallel region across all simulation iterations instead of creating a team for each loop.",
            "Use schedule(static) for the uniform-cost target-body and integration loops.",
            "Use a serial OpenMP region for inputs with fewer than 64 bodies to limit thread overhead."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.17020061581085125,

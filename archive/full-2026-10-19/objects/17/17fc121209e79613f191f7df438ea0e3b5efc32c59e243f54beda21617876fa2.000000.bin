        "role": "C",
        "parent_id": null,
        "delegation_parent": "R/C",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "A single OpenMP team can parallelize read-only move-legality checks for broad BFS frontiers while coarse 256-state tiles reduce scheduling and synchronization overhead. Serial insertion in the original parent and move order preserves deterministic successor selection; small frontiers remain serial. This tests a coarser-grained alternative to the prior 64-state approach on the four-core ARM64 target.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/sokoban.c"
          ],
          "retained": [
            "Factor legality checking from state allocation so legality checks can safely run in parallel over states and four directions.",
            "For frontiers of at least 256 states, use one OpenMP team with static 256-state tiles; process valid candidates serially in the existing order.",
            "Keep narrower BFS frontiers on the original serial path and preserve serial hash-table and queue updates."

    "trials": [
      {
        "id": "a2c134283171465e",
        "role": "A",
        "parent_id": null,
        "delegation_parent": "R/A",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Flattening the dense matrices into row-major storage should improve the repeated row scans and eliminate per-row allocations. Passing read-only graph and key data by reference also avoids copies in repeated calls without changing traversal or tie order.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/tropical.cpp"
          ],
          "retained": [
            "Store the graph adjacency matrix and Prim scratch matrix as contiguous row-major vectors, using size_t-based indexing.",
            "Pass the graph, matrix, key, and read-only path vectors by const reference where applicable, avoiding redundant copies while preserving loop order and selection behavior."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.0055105676874518394,
        "commit": "059d4bb06a38c432537a98038113d8420347a90d"
      },
      {
        "id": "a8360852c8164f98",
        "role": "B",
        "parent_id": null,
        "delegation_parent": "R/B",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "A packed lexicographic minimum reduction can SIMD-vectorize Prim's repeated key scan while preserving its INT_MAX sentinel and lowest-index tie behavior; passing the scan inputs by const reference also avoids copies.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/tropical.cpp"
          ],
          "retained": [
            "Replace find_min_key's copied scalar scan with a packed signed-key/index minimum reduction using OpenMP SIMD; change mstset to byte storage so the reduction reads contiguous flags."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.0055160727351903915,
        "commit": "66c261528f99160558ac8c587fcee504be5854db"
      },
      {
        "id": "7dccdc515b884134",
        "role": "C",
        "parent_id": null,
        "delegation_parent": "R/C",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "For sufficiently large graphs, zero-initializing the dense adjacency matrix is substantial independent row work; static OpenMP row scheduling should reduce constructor time while a serial path avoids parallel-region overhead on smaller graphs.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/tropical.cpp"
          ],
          "retained": [
            "Resize the matrix and color vectors once, then initialize each distinct adjacency row with a static OpenMP work-sharing loop when the vertex count is at least 256; retain serial row initialization below that threshold."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.0052108848467469215,
        "commit": "f42a558d3c53deb2fedd51b6cbf37ff1cd6d992d"
      },
      {
        "id": "06872f7b06e54ee5",
        "role": "A",
        "parent_id": null,
        "delegation_parent": "R/A",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Prim's cycle check is redundant for each candidate relaxation: it connects the currently selected vertex to an unselected vertex, so it cannot close a cycle in the selected forest. Removing its temporary dense matrix and BFS should reduce allocation and memory traffic while preserving candidate order and tie behavior.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/tropical.cpp"
          ],
          "retained": [
            "Remove the mat_cycle dense matrix and is_cycle BFS/map traversal from Prim_ST.",
            "Accept each candidate relaxation directly after the existing include-edge constraint check, since the candidate joins the selected set to an unselected vertex."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.0052355555817484856,
        "commit": "636664e56731db80363ef20fb085449c16c0a3b3"
      },
      {
        "id": "4f3900662dae4906",
        "role": "B",
        "parent_id": "a8360852c8164f98",
        "delegation_parent": "R/B",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "A single SIMD minimum reduction over a packed (signed key, vertex index) value may be cheaper than the existing two-pass reduction while preserving INT_MAX exclusion and lowest-index tie behavior exactly.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/tropical.cpp"
          ],
          "retained": [
            "Replace find_min_key's separate key and index SIMD reductions with one unsigned 64-bit min reduction encoding the signed key order and vertex index."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.005303939804434776,
        "commit": "78f02a58a47528ac19a1e899ca5a6dc3b27f683b"
      },
      {
        "id": "0ec801400d11469c",
        "role": "C",
        "parent_id": null,
        "delegation_parent": "R/C",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Parallelizing independent start-vertex searches for larger trees with dynamic scheduling should use the four available cores when DFS costs are uneven; local in-place traversal and an ordered merge should preserve exact output and first-best ties while keeping small inputs serial.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/tropical.cpp"
          ],
          "retained": [
            "Build per-tree adjacency once in spanning-edge order, replacing repeated spanning-edge scans; use visited markers, in-place push/pop traversal, and incremental per-color counts instead of copied path histories and linear color membership checks.",
            "Use an OpenMP dynamic-schedule work-sharing loop over independent start vertices for trees with at least 32 vertices; retain each start's first success and best partial path locally, then merge serially in start order to preserve early-exit and tie behavior."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.005308789511521657,
        "commit": "82aa96c640a10b0ac40807cbeeb0055a79785271"
      },
      {

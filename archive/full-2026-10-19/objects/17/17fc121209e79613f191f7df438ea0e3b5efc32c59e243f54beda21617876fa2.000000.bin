        "delegation_parent": "R/A",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "A flat row-major uint64_t adjacency layout with per-permutation row-degree checks can avoid most per-cell proxy accesses. When mapped row degrees match, checking only set bits in the symmetric lower triangle proves equality while reducing sparse-graph checks to O(n+E) per permutation.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/brute_isomorphism.cpp"
          ],
          "retained": [
            "Replace nested vector<bool> rows with contiguous row-major uint64_t bitsets and track each row's population as adjacency bits are set.",
            "Reject a permutation when any mapped row degrees differ; otherwise visit only set bits at columns j <= i and check their mapped adjacency. Symmetry plus equal row populations makes this lower-triangle inclusion check exact.",
            "Keep Heap permutation generation, output ordering, and reporting of all matching permutations unchanged."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.006323765031993389,

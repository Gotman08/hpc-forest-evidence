        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Appending parsed points to one geometrically grown contiguous buffer, with each group represented by an offset and length, should reduce per-group allocation overhead and improve sequential point-scan locality. Keeping the existing group/point traversal order and selection logic preserves equal-distance and vote tie behavior.",
        "transformations_as_declared_by_model": {
          "files": [

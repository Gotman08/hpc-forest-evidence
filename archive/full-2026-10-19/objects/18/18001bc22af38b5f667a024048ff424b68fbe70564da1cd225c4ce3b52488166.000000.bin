      "content": "{\"role\": \"G\", \"goal\": \"integration of diverse archived transformations; evaluate the full program\", \"experiment\": \"3d2234ccc1e4405f\", \"ordinal\": 8, \"integration_source_ids\": [\"8803e6ff7d234ad7\", \"300f29e289544337\", \"937b84eb850241fd\"], \"current_source_paths\": [\"src/knn.c\", \"src/knn.h\"], \"context_as_data\": {\"sources\": [{\"id\": \"8803e6ff7d234ad7\", \"role\": \"A\", \"commit\": \"deb37c382c0ea01a9f11dbd5739aabf7baf32096\", \"transformations\": {\"files\": [\"src/knn.h\"], \"retained\": [\"Convert both coordinates directly from the input window using strtof end pointers and a local cursor.\", \"Retain the existing token/spill parser whenever a complete point cannot be validated within the current window.\"]}, \"mean_seconds\": 0.018696353770792484, \"diff\": \"diff --git a/src/knn.c b/src/knn.c\\nindex 337e3b9..1768b80 100644\\n--- a/src/knn.c\\n+++ b/src/knn.c\\n@@ -1,78 +1,177 @@\\n-#include \\\"knn.h\\\"\\n-\\n-char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n-    char * labels = (char *) malloc(sizeof(char) * k);\\n-    float * distances = (float *) malloc(sizeof(float) * k);\\n-\\n-    int i, j, x, y;\\n-\\n-    for (i = 0; i < k; i++) {\\n-        labels[i] = -1;\\n-        distances[i] = -1;\\n-    }\\n-\\n-    for (i = 0; i < n_groups; i++) {\\n-        Group g = groups[i];\\n-\\n-        for (j = 0; j < g.length; j++) {\\n-            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n-\\n-            for (x = 0; x < k; x++) {\\n-                if (d < distances[x] || distances[x] == -1) {\\n-                    for (y = k - 1; y > x; y--) {\\n-                        distances[y] = distances[y - 1];\\n-                        labels[y] = labels[y - 1];\\n-                    }\\n-\\n-                    distances[x] = d;\\n-                    labels[x] = g.label;\\n-\\n-                    break;\\n-                }\\n-            }\\n-        }\\n-    }\\n-\\n-    qsort(labels, k, sizeof(char), compare_for_sort);\\n-\\n-    char most_frequent = labels[0];\\n-    int most_frequent_count = 1;\\n-    int current_frequency = 1;\\n-\\n-    for (i = 1; i < k; i++) {\\n-        if (labels[i] != labels[i - 1]) {\\n-            if (current_frequency > most_frequent_count) {\\n-                most_frequent = labels[i - 1];\\n-                most_frequent_count = current_frequency;\\n-            }\\n-\\n-            current_frequency = 1;\\n-        } else {\\n-            current_frequency++;\\n-        }\\n-\\n-        if (i == k - 1 && current_frequency > most_frequent_count) {\\n-            most_frequent = labels[i - 1];\\n-            most_frequent_count = current_frequency;\\n-        }\\n-    }\\n-\\n-\\n-    return most_frequent;\\n-}\\n-\\n-int main() {\\n-    int n_groups = parse_number_of_groups();\\n-    \\n-    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n-\\n-    for (int i = 0; i < n_groups; i++) {\\n-        groups[i] = parse_next_group();\\n-    }\\n-\\n-    int k = parse_k();\\n-\\n-    Point to_evaluate = parse_point();\\n-\\n-    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n-}\\n\\\\ No newline at end of file\\n+#include \\\"knn.h\\\"\\n+\\n+typedef struct {\\n+    float distance;\\n+    int group;\\n+} Neighbor;\\n+\\n+static char majority_label(char *labels, int k) {\\n+    qsort(labels, k, sizeof(char), compare_for_sort);\\n+\\n+    char most_frequent = labels[0];\\n+    int most_frequent_count = 1;\\n+    int current_frequency = 1;\\n+\\n+    for (int i = 1; i < k; i++) {\\n+        if (labels[i] != labels[i - 1]) {\\n+            if (current_frequency > most_frequent_count) {\\n+                most_frequent = labels[i - 1];\\n+                most_frequent_count = current_frequency;\\n+            }\\n+            current_frequency = 1;\\n+        } else {\\n+            current_frequency++;\\n+        }\\n+\\n+        if (i == k - 1 && current_frequency > most_frequent_count) {\\n+            most_frequent = labels[i - 1];\\n+            most_frequent_count = current_frequency;\\n+        }\\n+    }\\n+\\n+    return most_frequent;\\n+}\\n+\\n+static char knn_sorted_fallback(int n_groups, Group *groups, int k,\\n+                                Point to_evaluate) {\\n+    char *labels = (char *) malloc(sizeof(char) * k);\\n+    float *distances = (float *) malloc(sizeof(float) * k);\\n+\\n+    for (int i = 0; i < k; i++) {\\n+        labels[i] = -1;\\n+        distances[i] = -1;\\n+    }\\n+\\n+    for (int i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+        for (int j = 0; j < g.length; j++) {\\n+            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n+            for (int x = 0; x < k; x++) {\\n+                if (d < distances[x] || distances[x] == -1) {\\n+                    for (int y = k - 1; y > x; y--) {\\n+                        distances[y] = distances[y - 1];\\n+                        labels[y] = labels[y - 1];\\n+                    }\\n+                    distances[x] = d;\\n+                    labels[x] = g.label;\\n+                    break;\\n+                }\\n+            }\\n+        }\\n+    }\\n+\\n+    char result = majority_label(labels, k);\\n+    free(distances);\\n+    free(labels);\\n+    return result;\\n+}\\n+\\n+static int neighbor_is_worse(Neighbor a, Neighbor b) {\\n+    return a.distance > b.distance ||\\n+           (a.distance == b.distance && a.group > b.group);\\n+}\\n+\\n+static void sift_down(Neighbor *heap, size_t count, size_t root,\\n+                      Neighbor value) {\\n+    while (count > 1 && root <= (count - 2) / 4) {\\n+        size_t first = root * 4 + 1;\\n+        size_t end = first + 4;\\n+        size_t worst = first;\\n+        if (end > count) end = count;\\n+\\n+        for (size_t child = first + 1; child < end; child++) {\\n+            if (neighbor_is_worse(heap[child], heap[worst])) {\\n+                worst = child;\\n+            }\\n+        }\\n+\\n+        if (!neighbor_is_worse(heap[worst], value)) break;\\n+        heap[root] = heap[worst];\\n+        root = worst;\\n+    }\\n+    heap[root] = value;\\n+}\\n+\\n+char knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n+    if (k <= 0) {\\n+        return knn_sorted_fallback(n_groups, groups, k, to_evaluate);\\n+    }\\n+\\n+    size_t capacity = 0;\\n+    for (int i = 0; i < n_groups && capacity < (size_t) k; i++) {\\n+        if (groups[i].length > 0) {\\n+            size_t available = (size_t) groups[i].length;\\n+            size_t remaining = (size_t) k - capacity;\\n+            capacity += available < remaining ? available : remaining;\\n+        }\\n+    }\\n+    if (capacity == 0) return (char) -1;\\n+\\n+    size_t bytes = capacity * sizeof(Neighbor);\\n+    if (bytes < (size_t) k) bytes = (size_t) k;\\n+    Neighbor *heap = (Neighbor *) malloc(bytes);\\n+    if (heap == NULL) {\\n+        return knn_sorted_fallback(n_groups, groups, k, to_evaluate);\\n+    }\\n+\\n+    size_t used = 0;\\n+    for (int i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+        for (int j = 0; j < g.length; j++) {\\n+            float d = euclidean_distance_no_sqrt(to_evaluate, \"}, {\"id\": \"300f29e289544337\", \"role\": \"B\", \"commit\": \"e43765e4255caf0e31486704f675578ab9408ec3\", \"transformations\": {\"files\": [\"src/knn.c\"], \"retained\": [\"Replace large-k sorted insertion with four-byte radix cutoff selection using four independent histogram banks.\", \"Compact matching buckets with NEON comparisons and table permutations; overlapping stores never reach unread keys.\", \"Reconstruct selected labels in original encounter order, retaining the required earliest cutoff-distance ties and existing voting logic.\"]}, \"mean_seconds\": 0.024174795175592106, \"diff\": \"diff --git a/src/knn.c b/src/knn.c\\nindex 337e3b9..d69d424 100644\\n--- a/src/knn.c\\n+++ b/src/knn.c\\n@@ -1,78 +1,331 @@\\n-#include \\\"knn.h\\\"\\n-\\n-char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n-    char * labels = (char *) malloc(sizeof(char) * k);\\n-    float * distances = (float *) malloc(sizeof(float) * k);\\n-\\n-    int i, j, x, y;\\n-\\n-    for (i = 0; i < k; i++) {\\n-        labels[i] = -1;\\n-        distances[i] = -1;\\n-    }\\n-\\n-    for (i = 0; i < n_groups; i++) {\\n-        Group g = groups[i];\\n-\\n-        for (j = 0; j < g.length; j++) {\\n-            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n-\\n-            for (x = 0; x < k; x++) {\\n-                if (d < distances[x] || distances[x] == -1) {\\n-                    for (y = k - 1; y > x; y--) {\\n-                        distances[y] = distances[y - 1];\\n-                        labels[y] = labels[y - 1];\\n-                    }\\n-\\n-                    distances[x] = d;\\n-                    labels[x] = g.label;\\n-\\n-                    break;\\n-                }\\n-            }\\n-        }\\n-    }\\n-\\n-    qsort(labels, k, sizeof(char), compare_for_sort);\\n-\\n-    char most_frequent = labels[0];\\n-    int most_frequent_count = 1;\\n-    int current_frequency = 1;\\n-\\n-    for (i = 1; i < k; i++) {\\n-        if (labels[i] != labels[i - 1]) {\\n-            if (current_frequency > most_frequent_count) {\\n-                most_frequent = labels[i - 1];\\n-                most_frequent_count = current_frequency;\\n-            }\\n-\\n-            current_frequency = 1;\\n-        } else {\\n-            current_frequency++;\\n-        }\\n-\\n-        if (i == k - 1 && current_frequency > most_frequent_count) {\\n-            most_frequent = labels[i - 1];\\n-            most_frequent_count = current_frequency;\\n-        }\\n-    }\\n-\\n-\\n-    return most_frequent;\\n-}\\n-\\n-int main() {\\n-    int n_groups = parse_number_of_groups();\\n-    \\n-    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n-\\n-    for (int i = 0; i < n_groups; i++) {\\n-        groups[i] = parse_next_group();\\n-    }\\n-\\n-    int k = parse_k();\\n-\\n-    Point to_evaluate = parse_point();\\n-\\n-    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n-}\\n\\\\ No newline at end of file\\n+#include \\\"knn.h\\\"\\n+#include <stdint.h>\\n+#include <string.h>\\n+\\n+#if defined(__aarch64__) && defined(__ARM_NEON)\\n+#include <arm_neon.h>\\n+#endif\\n+\\n+static inline int first_insertion_position(const float * distances, int k, float d) {\\n+    int x = 0;\\n+\\n+#if defined(__aarch64__) && defined(__ARM_NEON)\\n+    const float32x4_t candidate = vdupq_n_f32(d);\\n+    const float32x4_t empty = vdupq_n_f32(-1.0f);\\n+\\n+    for (; x <= k - 4; x += 4) {\\n+        const float32x4_t stored = vld1q_f32(distances + x);\\n+        const uint32x4_t matches = vorrq_u32(\\n+            vcltq_f32(candidate, stored), vceqq_f32(stored, empty));\\n+        if (vmaxvq_u32(matches) != 0) {\\n+            break;\\n+        }\\n+    }\\n+#endif\\n+\\n+    for (; x < k; x++) {\\n+        if (d < distances[x] || distances[x] == -1) {\\n+            return x;\\n+        }\\n+    }\\n+    return k;\\n+}\\n+\\n+static char vote_labels(char * labels, int k) {\\n+    qsort(labels, k, sizeof(char), compare_for_sort);\\n+\\n+    char most_frequent = labels[0];\\n+    int most_frequent_count = 1;\\n+    int current_frequency = 1;\\n+\\n+    for (int i = 1; i < k; i++) {\\n+        if (labels[i] != labels[i - 1]) {\\n+            if (current_frequency > most_frequent_count) {\\n+                most_frequent = labels[i - 1];\\n+                most_frequent_count = current_frequency;\\n+            }\\n+\\n+            current_frequency = 1;\\n+        } else {\\n+            current_frequency++;\\n+        }\\n+\\n+        if (i == k - 1 && current_frequency > most_frequent_count) {\\n+            most_frequent = labels[i - 1];\\n+            most_frequent_count = current_frequency;\\n+        }\\n+    }\\n+\\n+    return most_frequent;\\n+}\\n+\\n+static char insertion_knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n+    char * labels = (char *) malloc(sizeof(char) * k);\\n+    float * distances = (float *) malloc(sizeof(float) * k);\\n+\\n+    for (int i = 0; i < k; i++) {\\n+        labels[i] = -1;\\n+        distances[i] = -1;\\n+    }\\n+\\n+    for (int i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+\\n+        for (int j = 0; j < g.length; j++) {\\n+            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n+            float farthest = distances[k - 1];\\n+\\n+            if (farthest != -1.0f && d >= farthest) {\\n+                continue;\\n+            }\\n+\\n+            int x = first_insertion_position(distances, k, d);\\n+            if (x < k) {\\n+                size_t shifted = (size_t) (k - x - 1);\\n+\\n+                if (shifted != 0) {\\n+                    memmove(distances + x + 1, distances + x,\\n+                            shifted * sizeof(*distances));\\n+                    memmove(labels + x + 1, labels + x,\\n+                            shifted * sizeof(*labels));\\n+                }\\n+\\n+                distances[x] = d;\\n+                labels[x] = g.label;\\n+            }\\n+        }\\n+    }\\n+\\n+    char result = vote_labels(labels, k);\\n+    free(distances);\\n+    free(labels);\\n+    return result;\\n+}\\n+\\n+#if defined(__GNUC__) || defined(__clang__)\\n+#define KNN_NOINLINE __attribute__((noinline))\\n+#else\\n+#define KNN_NOINLINE\\n+#endif\\n+\\n+/* Both passes use the same scalar evaluation of the original expression. */\\n+static KNN_NOINLINE uint32_t point_distance_key(Point a, Point b) {\\n+    float distance = euclidean_distance_no_sqrt(a, b);\\n+    uint32_t key;\\n+    memcpy(&key, &distance, sizeof(key));\\n+\\n+    /* Floating-point equality treats the two zero representations alike. */\\n+    if ((key & UINT32_C(0x7fffffff)) == 0) {\\n+        key = 0;\\n+    }\\n+    return key;\\n+}\\n+\\n+#undef KNN_NOINLINE\\n+\\n+static size_t compact_prefix(uint32_t * keys, size_t count,\\n+                             uint32_t mask, uint32_t prefix) {\\n+    size_t read = 0;\\n+    size_t written = 0;\\n+\\n+#if defined(__aarch64__) && defined(__ARM_NEON)\\n+    static const uint8_t sh\"}, {\"id\": \"937b84eb850241fd\", \"role\": \"C\", \"commit\": \"8f4ea6dcb28b10ad66df32598b3771d087a6a8f9\", \"transformations\": {\"files\": [\"src/knn.c\"], \"retained\": [\"Partition flattened points into balanced contiguous thread ranges and cache exact squared-distance keys.\", \"Select the kth distance through four synchronized byte-histogram reductions within one OpenMP region.\", \"Preserve input-order distance ties using per-thread quotas, then reduce label counts with the reference char-order tie break.\", \"Serialize small scans and count labels directly when k covers every point, including unused sentinel entries.\"]}, \"mean_seconds\": 0.022421018220484257, \"diff\": \"diff --git a/src/knn.c b/src/knn.c\\nindex 337e3b9..b914a7d 100644\\n--- a/src/knn.c\\n+++ b/src/knn.c\\n@@ -1,78 +1,284 @@\\n-#include \\\"knn.h\\\"\\n-\\n-char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n-    char * labels = (char *) malloc(sizeof(char) * k);\\n-    float * distances = (float *) malloc(sizeof(float) * k);\\n-\\n-    int i, j, x, y;\\n-\\n-    for (i = 0; i < k; i++) {\\n-        labels[i] = -1;\\n-        distances[i] = -1;\\n-    }\\n-\\n-    for (i = 0; i < n_groups; i++) {\\n-        Group g = groups[i];\\n-\\n-        for (j = 0; j < g.length; j++) {\\n-            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n-\\n-            for (x = 0; x < k; x++) {\\n-                if (d < distances[x] || distances[x] == -1) {\\n-                    for (y = k - 1; y > x; y--) {\\n-                        distances[y] = distances[y - 1];\\n-                        labels[y] = labels[y - 1];\\n-                    }\\n-\\n-                    distances[x] = d;\\n-                    labels[x] = g.label;\\n-\\n-                    break;\\n-                }\\n-            }\\n-        }\\n-    }\\n-\\n-    qsort(labels, k, sizeof(char), compare_for_sort);\\n-\\n-    char most_frequent = labels[0];\\n-    int most_frequent_count = 1;\\n-    int current_frequency = 1;\\n-\\n-    for (i = 1; i < k; i++) {\\n-        if (labels[i] != labels[i - 1]) {\\n-            if (current_frequency > most_frequent_count) {\\n-                most_frequent = labels[i - 1];\\n-                most_frequent_count = current_frequency;\\n-            }\\n-\\n-            current_frequency = 1;\\n-        } else {\\n-            current_frequency++;\\n-        }\\n-\\n-        if (i == k - 1 && current_frequency > most_frequent_count) {\\n-            most_frequent = labels[i - 1];\\n-            most_frequent_count = current_frequency;\\n-        }\\n-    }\\n-\\n-\\n-    return most_frequent;\\n-}\\n-\\n-int main() {\\n-    int n_groups = parse_number_of_groups();\\n-    \\n-    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n-\\n-    for (int i = 0; i < n_groups; i++) {\\n-        groups[i] = parse_next_group();\\n-    }\\n-\\n-    int k = parse_k();\\n-\\n-    Point to_evaluate = parse_point();\\n-\\n-    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n-}\\n\\\\ No newline at end of file\\n+#include \\\"knn.h\\\"\\n+#include <limits.h>\\n+#include <stdint.h>\\n+#include <string.h>\\n+#ifdef _OPENMP\\n+#include <omp.h>\\n+#endif\\n+\\n+typedef struct {\\n+    size_t bins[256];\\n+    size_t quota;\\n+    size_t padding[7];\\n+} KnnRadixState;\\n+\\n+static char knn_vote(const size_t *counts) {\\n+    char best = (char)-1;\\n+    size_t largest = 0;\\n+\\n+    for (int c = CHAR_MIN; c <= CHAR_MAX; c++) {\\n+        size_t count = counts[(unsigned char)(char)c];\\n+        if (count > largest) {\\n+            largest = count;\\n+            best = (char)c;\\n+        }\\n+    }\\n+    return best;\\n+}\\n+\\n+/* Preserve the reference's insertion behavior for unordered distances. */\\n+static char knn_original_selection(int n_groups, Group *groups, int k,\\n+                                   Point to_evaluate) {\\n+    char *labels = malloc((size_t)k * sizeof(*labels));\\n+    float *distances = malloc((size_t)k * sizeof(*distances));\\n+    if (labels == NULL || distances == NULL) {\\n+        free(labels);\\n+        free(distances);\\n+        exit(EXIT_FAILURE);\\n+    }\\n+\\n+    for (int i = 0; i < k; i++) {\\n+        labels[i] = -1;\\n+        distances[i] = -1;\\n+    }\\n+\\n+    for (int i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+        for (int j = 0; j < g.length; j++) {\\n+            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n+            for (int x = 0; x < k; x++) {\\n+                if (d < distances[x] || distances[x] == -1) {\\n+                    for (int y = k - 1; y > x; y--) {\\n+                        distances[y] = distances[y - 1];\\n+                        labels[y] = labels[y - 1];\\n+                    }\\n+                    distances[x] = d;\\n+                    labels[x] = g.label;\\n+                    break;\\n+                }\\n+            }\\n+        }\\n+    }\\n+\\n+    size_t counts[256] = {0};\\n+    for (int i = 0; i < k; i++) {\\n+        counts[(unsigned char)labels[i]]++;\\n+    }\\n+    free(distances);\\n+    free(labels);\\n+    return knn_vote(counts);\\n+}\\n+\\n+static int knn_first_group(const size_t *offsets, int n_groups,\\n+                           size_t position) {\\n+    int low = 0;\\n+    int high = n_groups;\\n+    while (low < high) {\\n+        int middle = low + (high - low) / 2;\\n+        if (offsets[middle + 1] <= position) {\\n+            low = middle + 1;\\n+        } else {\\n+            high = middle;\\n+        }\\n+    }\\n+    return low;\\n+}\\n+\\n+static uint32_t knn_distance_key(Point query, Point point) {\\n+    float distance = euclidean_distance_no_sqrt(query, point);\\n+    uint32_t key;\\n+    memcpy(&key, &distance, sizeof(key));\\n+    /* Squared distances are nonnegative; canonicalize either zero sign. */\\n+    return key & UINT32_C(0x7fffffff);\\n+}\\n+\\n+static void knn_select_byte(KnnRadixState *states, int threads, int shift,\\n+                            uint32_t *prefix, size_t *rank) {\\n+    for (unsigned int bucket = 0; bucket < 256; bucket++) {\\n+        size_t count = 0;\\n+        for (int t = 0; t < threads; t++) {\\n+            count += states[t].bins[bucket];\\n+        }\\n+        if (*rank > count) {\\n+            *rank -= count;\\n+        } else {\\n+            *prefix |= (uint32_t)bucket << shift;\\n+            break;\\n+        }\\n+    }\\n+\\n+    if (shift == 0) {\\n+        size_t remaining = *rank;\\n+        unsigned int bucket = *prefix & UINT32_C(255);\\n+        /* Contiguous thread ranges follow the original traversal order. */\\n+        for (int t = 0; t < threads; t++) {\\n+            size_t available = states[t].bins[bucket];\\n+            states[t].quota = remaining < available ? remaining : available;\\n+            remaining -= states[t].quota;\\n+        }\\n+    }\\n+}\\n+\\n+char knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n+    if (k <= 0) {\\n+        return (char)-1;\\n+    }\\n+\\n+    size_t total = 0;\\n+    for (int g = 0; g < n_groups; g++) \"}], \"interactions\": [{\"sources\": [\"46d1fd55ec474ac8\", \"300f29e289544337\", \"937b84eb850241fd\"], \"outcome\": {\"binary_sha256\": \"f41231caf39ea6c2c9b1e7b2348a7922d02d1c80b010cb058063de9a1f2f49ed\", \"cache_key\": \"c791bd8527ddd2a6119bb586d1f8300db7c00dc122f3e55a308bb0f935685f98\", \"commit\": \"8fc7074bea491c04d5bb649096dbf567361c7747\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/knn/logs/e1/fe34c797d4994045/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/
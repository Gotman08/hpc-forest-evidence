      "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nstatic int count_paths(const vector<vector<bool> >& blocked, int n) {\n    vector<int> dp(n, 0);\n    dp[0] = 1;\n\n#ifdef _OPENMP\n    if (n >= 1024 && omp_get_max_threads() > 1) {\n        const int tile_size = 128;\n        const int tiles = (n + tile_size - 1) / tile_size;\n        vector<int> right(n, 0);\n\n        // On each diagonal, tiles own disjoint column and row frontiers.\n        // The work-sharing barrier publishes both frontiers to the next diagonal.\n        #pragma omp parallel\n        {\n            for (int diagonal = 0; diagonal < 2 * tiles - 1; ++diagonal) {\n                const int first = max(0, diagonal - tiles + 1);\n                const int last = min(tiles - 1, diagonal);\n                #pragma omp for schedule(static)\n                for (int tile_row = first; tile_row <= last; ++tile_row) {\n                    const int tile_col = diagonal - tile_row;\n                    const int row_begin = tile_row * tile_size;\n                    const int row_end = min(n, row_begin + tile_size);\n                    const int col_begin = tile_col * tile_size;\n                    const int col_end = min(n, col_begin + tile_size);\n                    for (int i = row_begin; i < row_end; ++i) {\n                        const vector<bool>& obstacles = blocked[i];\n                        int left = col_begin == 0 ? 0 : right[i];\n                        for (int j = col_begin; j < col_end; ++j) {\n                            int value = dp[j] + left;\n                            if (value >= MOD) value -= MOD;\n                            if (obstacles[j]) value = 0;\n                            dp[j] = value;\n                            left = value;\n                        }\n                        right[i] = left;\n                    }\n                }\n            }\n        }\n        return dp[n - 1];\n    }\n#endif\n\n    for (int i = 0; i < n; ++i) {\n        const vector<bool>& obstacles = blocked[i];\n        int left = 0;\n        for (int j = 0; j < n; ++j) {\n            int value = dp[j] + left;\n            if (value >= MOD) value -= MOD;\n            if (obstacles[j]) value = 0;\n            dp[j] = value;\n            left = value;\n        }\n    }\n    return dp[n - 1];\n}\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n    vector<vector<bool> > blockedCells(n, vector<bool>(n, false));\n    for (int c = 0; c < m; ++c) {\n        int i, j;\n        cin >> i >> j;\n        blockedCells[i][j] = true;\n    }\n\n    cout << count_paths(blockedCells, n) << endl;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "A persistent OpenMP team processing 128-by-128 tiles in diagonal waves can parallelize grid dependencies while requiring far fewer barriers than per-row parallel scans.",
  "notes": "Retains packed obstacle storage and uses only O(n) DP/frontier storage. Small grids and builds without OpenMP use the serial path. No execution or measurement performed.",

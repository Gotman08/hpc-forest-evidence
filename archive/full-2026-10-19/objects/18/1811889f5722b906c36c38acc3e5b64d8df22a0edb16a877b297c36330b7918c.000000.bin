{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <algorithm>\\n#include <cassert>\\n#include <cstddef>\\n#include <cstdint>\\n#include <cstdio>\\n#include <limits>\\n#include <memory>\\n#include <vector>\\n\\n#if defined(__aarch64__)\\n#include <arm_neon.h>\\n#endif\\n\\nclass FastInput {\\n    unsigned char buffer[1 << 16];\\n    std::size_t position = 0;\\n    std::size_t length = 0;\\n\\n    int readByte() {\\n        if (position == length) {\\n            length = std::fread(buffer, 1, sizeof(buffer), stdin);\\n            position = 0;\\n            if (length == 0) return -1;\\n        }\\n        return buffer[position++];\\n    }\\n\\npublic:\\n    bool next(int& result) {\\n        int c = readByte();\\n        while (c >= 0 && c <= ' ') c = readByte();\\n        if (c < 0) return false;\\n        const bool negative = c == '-';\\n        if (c == '-' || c == '+') c = readByte();\\n        std::uint32_t magnitude = 0;\\n        while (static_cast<unsigned>(c - '0') < 10u) {\\n            magnitude = magnitude * 10u + static_cast<unsigned>(c - '0');\\n            c = readByte();\\n        }\\n        const std::int64_t value = static_cast<std::int64_t>(magnitude);\\n        result = static_cast<int>(negative ? -value : value);\\n        return true;\\n    }\\n};\\n\\n#if defined(__aarch64__)\\nstatic inline int32x4_t prefix4(int32x4_t values) {\\n    const int32x4_t zero = vdupq_n_s32(0);\\n    values = vaddq_s32(values, vextq_s32(zero, values, 3));\\n    return vaddq_s32(values, vextq_s32(zero, values, 2));\\n}\\n#endif\\n\\nstatic int best_row(const int* columns, int n, int s, int first) {\\n    const int count = n - s;\\n    const int* entering = columns + s;\\n    const int* leaving = columns;\\n    int carry = 0;\\n    int bestPrefix = 0;\\n    int j = 0;\\n\\n#if defined(__aarch64__)\\n    const int32x4_t zero = vdupq_n_s32(0);\\n    for (; j + 16 <= count; j += 16) {\\n        // Each lane summarizes a different consecutive four-delta chunk.\\n        const int32x4x4_t in = vld4q_s32(entering + j);\\n        const int32x4x4_t out = vld4q_s32(leaving + j);\\n        int32x4_t totals = vsubq_s32(in.val[0], out.val[0]);\\n        int32x4_t maxima = totals;\\n        totals = vaddq_s32(totals, vsubq_s32(in.val[1], out.val[1]));\\n        maxima = vmaxq_s32(maxima, totals);\\n        totals = vaddq_s32(totals, vsubq_s32(in.val[2], out.val[2]));\\n        maxima = vmaxq_s32(maxima, totals);\\n        totals = vaddq_s32(totals, vsubq_s32(in.val[3], out.val[3]));\\n        maxima = vmaxq_s32(maxima, totals);\\n\\n        const int32x4_t prefixTotals = prefix4(totals);\\n        const int32x4_t preceding = vextq_s32(zero, prefixTotals, 3);\\n        const int blockMaximum = vmaxvq_s32(vaddq_s32(maxima, preceding));\\n        bestPrefix = std::max(bestPrefix, carry + blockMaximum);\\n        carry += vgetq_lane_s32(prefixTotals, 3);\\n    }\\n    for (; j + 4 <= count; j += 4) {\\n        const int32x4_t deltas = vsubq_s32(vld1q_s32(entering + j),\\n                                         vld1q_s32(leaving + j));\\n        const int32x4_t prefixes = prefix4(deltas);\\n        bestPrefix = std::max(bestPrefix, carry + vmaxvq_s32(prefixes));\\n        carry += vgetq_lane_s32(prefixes, 3);\\n    }\\n#endif\\n\\n    for (; j < count; ++j) {\\n        carry += entering[j] - leaving[j];\\n        bestPrefix = std::max(bestPrefix, carry);\\n    }\\n    return first + bestPrefix;\\n}\\n\\nstatic std::int64_t best_row(const std::int64_t* columns, int n, int s,\\n                             std::int64_t first) {\\n    std::int64_t best = first;\\n    for (int j = 0; j < n - s; ++j) {\\n        first += columns[j + s] - columns[j];\\n        best = std::max(best, first);\\n    }\\n    return best;\\n}\\n\\ntemplate<class Sum>\\nstatic void add_row(Sum* __restrict columns,\\n                    const int* __restrict values, int n) {\\n    for (int j = 0; j < n; ++j) {\\n        columns[j] += static_cast<Sum>(values[j]);\\n    }\\n}\\n\\ntemplate<class Sum>\\nstatic Sum slide_columns(Sum* __restrict columns,\\n                         const int* __restrict incoming,\\n                         const int* __restrict outgoing, int n, int s) {\\n    Sum edgeDelta = 0;\\n    int j = 0;\\n    for (; j < s; ++j) {\\n        const Sum delta = static_cast<Sum>(incoming[j])\\n                        - static_cast<Sum>(outgoing[j]);\\n        columns[j] += delta;\\n        edgeDelta += delta;\\n    }\\n    for (; j < n; ++j) {\\n        columns[j] += static_cast<Sum>(incoming[j])\\n                    - static_cast<Sum>(outgoing[j]);\\n    }\\n    return edgeDelta;\\n}\\n\\ntemplate<class Sum>\\nstatic Sum maximum_sum(const int* matrix, int n, int s) {\\n    std::vector<Sum> columns(static_cast<std::size_t>(n), Sum(0));\\n    for (int row = 0; row < s; ++row) {\\n        add_row(columns.data(), matrix + static_cast<std::size_t>(row) * n, n);\\n    }\\n\\n    Sum first = 0;\\n    for (int j = 0; j < s; ++j) first += columns[j];\\n    Sum best = best_row(columns.data(), n, s, first);\\n\\n    for (int top = 1; top <= n - s; ++top) {\\n        const int* outgoing = matrix + static_cast<std::size_t>(top - 1) * n;\\n        const int* incoming = matrix + static_cast<std::size_t>(top + s - 1) * n;\\n        first += slide_columns(columns.data(), incoming, outgoing, n, s);\\n        const Sum candidate = best_row(columns.data(), n, s, first);\\n        best = std::max(best, candidate);\\n    }\\n    return best;\\n}\\n\\nint main() {\\n    FastInput input;\\n    int n, s;\\n    if (!input.next(n) || !input.next(s)) return 0;\\n    assert(s < n);\\n    assert(n < 8000);\\n    assert(s > 0);\\n    assert(n > 0);\\n\\n    const std::size_t elements = static_cast<std::size_t>(n) * n;\\n    std::unique_ptr<int[]> matrix(new int[elements]);\\n    int minimum = std::numeric_limits<int>::max();\\n    int maximum = std::numeric_limits<int>::min();\\n    for (std::size_t k = 0; k < elements; ++k) {\\n        int value;\\n        if (!input.next(value)) return 0;\\n        matrix[k] = value;\\n        minimum = std::min(minimum, value);\\n        maximum = std::max(maximum, value);\\n    }\\n\\n    // These bounds cover actual sums and every delta-prefix intermediate.\\n    const std::int64_t area = static_cast<std::int64_t>(s) * s;\\n    const bool narrow =\\n        area * minimum >= std::numeric_limits<int>::min() &&\\n        area * maximum <= std::numeric_limits<int>::max() &&\\n        area * (static_cast<std::int64_t>(maximum) - minimum)\\n            <= std::numeric_limits<int>::max();\\n\\n    const std::int64_t answer = narrow\\n        ? static_cast<std::int64_t>(maximum_sum<int>(matrix.get(), n, s))\\n        : maximum_sum<std::int64_t>(matrix.get(), n, s);\\n    std::printf(\\\"%lld\\\\n\\\", static_cast<long long>(answer));\\n    return 0;\\n}\\n\",\"path\":\"src/solution.cpp\"}],\"hypothesis\":\"Deinterleaved NEON loads enable four independent sum/maximum-prefix summaries, reducing horizontal rolling-carry dependencies to one update per 16 windows.\",\"notes\":\"No commands or measurements executed. SIMD arithmetic is range-checked, with a 64-bit fallback.\",\"sources_kept\":[],\"transformations\":[\"Replace serpentine rescanning with O(N^2) vertical column windows and an incrementally maintained first horizontal window.\",\"Use NEON structured loads and associative maximum-prefix summaries for blocks of 16 horizontal deltas.\",\"Enable 32-bit arithmetic only when input-extrema bounds prove every sum and delta-prefix intermediate representable; otherwise use 64-bit arithmetic.\",\"Use buffered integer input and contiguous matrix storage.\"]}"}}

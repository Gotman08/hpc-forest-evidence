    {
      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <cstddef>\n\nstatic long long maximum_horizontal_sum(const std::vector<long long>& columns, int s) {\n    const int n = static_cast<int>(columns.size());\n    long long sum = 0;\n    for (int c = 0; c < s; ++c)\n        sum += columns[c];\n\n    long long best = sum;\n    for (int c = s; c < n; ++c) {\n        sum += columns[c] - columns[c - s];\n        if (sum > best)\n            best = sum;\n    }\n    return best;\n}\n\nint main() {\n    int n, s;\n    std::cin >> n >> s;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    std::vector<int> history(static_cast<std::size_t>(s) * n);\n    std::vector<long long> columns(n, 0);\n\n    for (int r = 0; r < s; ++r) {\n        int* row = history.data() + static_cast<std::size_t>(r) * n;\n        for (int c = 0; c < n; ++c) {\n            std::scanf(\"%d\", &row[c]);\n            columns[c] += static_cast<long long>(row[c]);\n        }\n    }\n\n    long long maximum = maximum_horizontal_sum(columns, s);\n    int slot = 0;\n    for (int r = s; r < n; ++r) {\n        int* row = history.data() + static_cast<std::size_t>(slot) * n;\n        for (int c = 0; c < n; ++c) {\n            const int exiting = row[c];\n            std::scanf(\"%d\", &row[c]);\n            columns[c] += static_cast<long long>(row[c])\n                        - static_cast<long long>(exiting);\n        }\n\n        const long long candidate = maximum_horizontal_sum(columns, s);\n        if (candidate > maximum)\n            maximum = candidate;\n\n        ++slot;\n        if (slot == s)\n            slot = 0;\n    }\n\n    std::printf(\"%lld\\n\", maximum);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Fusing input with rolling column updates in an s-row circular buffer should reduce matrix traffic and storage compared with full-matrix rolling sums.",

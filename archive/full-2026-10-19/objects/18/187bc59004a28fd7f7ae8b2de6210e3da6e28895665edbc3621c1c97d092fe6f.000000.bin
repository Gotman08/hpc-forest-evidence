  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdint.h>\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10\n#define DT 0.01f\n#define SOFTENING 1e-9f\n#define PAIR_TILE 48\n#define TARGET_PACKET 12\n\n/* Preserve the binary input/output layout. */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nstatic inline void body_force_one(Body *p, float dt, int n, int i) {\n  float fx = 0.0f;\n  float fy = 0.0f;\n  float fz = 0.0f;\n\n  for (int j = 0; j < n; ++j) {\n    float dx = p[j].x - p[i].x;\n    float dy = p[j].y - p[i].y;\n    float dz = p[j].z - p[i].z;\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n    fx += dx * inv_dist3;\n    fy += dy * inv_dist3;\n    fz += dz * inv_dist3;\n  }\n\n  p[i].vx += dt*fx;\n  p[i].vy += dt*fy;\n  p[i].vz += dt*fz;\n}\n\nvoid body_force(Body *p, float dt, int n) {\n#ifdef _OPENMP\n#pragma omp parallel for schedule(static) if(n >= 2 * PAIR_TILE)\n#endif\n  for (int i = 0; i < n; ++i) {\n    body_force_one(p, dt, n, i);\n  }\n}\n\nstatic void direct_simulation(Body *p, int n) {\n#ifdef _OPENMP\n#pragma omp parallel if(n >= 2 * PAIR_TILE)\n#endif\n  {\n    for (int iter = 0; iter < N_ITER; ++iter) {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n      for (int i = 0; i < n; ++i) {\n        body_force_one(p, DT, n, i);\n      }\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n      for (int i = 0; i < n; ++i) {\n        p[i].x += p[i].vx * DT;\n        p[i].y += p[i].vy * DT;\n        p[i].z += p[i].vz * DT;\n      }\n    }\n  }\n}\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic inline __attribute__((always_inline))\nfloat32x4_t inverse_distance4(float32x4_t squared) {\n  const float64x2_t one = vdupq_n_f64(1.0);\n  float64x2_t lo = vcvt_f64_f32(vget_low_f32(squared));\n  float64x2_t hi = vcvt_f64_f32(vget_high_f32(squared));\n  lo = vdivq_f64(one, vsqrtq_f64(lo));\n  hi = vdivq_f64(one, vsqrtq_f64(hi));\n  return vcombine_f32(vcvt_f32_f64(lo), vcvt_f32_f64(hi));\n}\n\nstatic inline __attribute__((always_inline))\nfloat32x4_t squared_distance4(const float *x, const float *y,\n                              const float *z, float32x4_t sx,\n                              float32x4_t sy, float32x4_t sz) {\n  float32x4_t dx = sx - vld1q_f32(x);\n  float32x4_t dy = sy - vld1q_f32(y);\n  float32x4_t dz = sz - vld1q_f32(z);\n  return dx*dx + dy*dy + dz*dz + vdupq_n_f32(SOFTENING);\n}\n#endif\n\n/* Distances are positive, so coefficient production needs no errno checks. */\n#if defined(__GNUC__) && !defined(__clang__) && !defined(__INTEL_COMPILER)\n__attribute__((noinline, optimize(\"no-math-errno\")))\n#endif\nstatic void make_coefficients(const float *restrict x,\n                              const float *restrict y,\n                              const float *restrict z,\n                              int target_first, int target_count,\n                              int source_first, int source_count,\n                              float coefficients[PAIR_TILE][PAIR_TILE]) {\n  for (int j = 0; j < source_count; ++j) {\n    const int s = source_first + j;\n    const float sx = x[s];\n    const float sy = y[s];\n    const float sz = z[s];\n    int q = 0;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const float32x4_t svx = vdupq_n_f32(sx);\n    const float32x4_t svy = vdupq_n_f32(sy);\n    const float32x4_t svz = vdupq_n_f32(sz);\n    for (; q + TARGET_PACKET <= target_count; q += TARGET_PACKET) {\n      const int t = target_first + q;\n      float32x4_t d0 = squared_distance4(x+t, y+t, z+t, svx, svy, svz);\n      float32x4_t d1 = squared_distance4(x+t+4, y+t+4, z+t+4,\n                                        svx, svy, svz);\n      float32x4_t d2 = squared_distance4(x+t+8, y+t+8, z+t+8,\n                                        svx, svy, svz);\n      float32x4_t inv0 = inverse_distance4(d0);\n      float32x4_t inv1 = inverse_distance4(d1);\n      float32x4_t inv2 = inverse_distance4(d2);\n      vst1q_f32(coefficients[j]+q, inv0 * inv0 * inv0);\n      vst1q_f32(coefficients[j]+q+4, inv1 * inv1 * inv1);\n      vst1q_f32(coefficients[j]+q+8, inv2 * inv2 * inv2);\n    }\n    for (; q + 4 <= target_count; q += 4) {\n      const int t = target_first + q;\n      float32x4_t squared = squared_distance4(x+t, y+t, z+t,\n                                             svx, svy, svz);\n      float32x4_t inv = inverse_distance4(squared);\n      vst1q_f32(coefficients[j]+q, inv * inv * inv);\n    }\n#endif\n#ifdef _OPENMP\n#pragma omp simd\n#endif\n    for (int k = q; k < target_count; ++k) {\n      float dx = sx - x[target_first+k];\n      float dy = sy - y[target_first+k];\n      float dz = sz - z[target_first+k];\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n      coefficients[j][k] = inv_dist3;\n    }\n  }\n}\n\n/* Both source-major orientations remain contiguous in the private workspace. */\nstatic inline void transpose_coefficients(\n    const float src[PAIR_TILE][PAIR_TILE],\n    float dst[PAIR_TILE][PAIR_TILE], int rows, int cols) {\n#if defined(__aarch64__) && defined(__ARM_NEON)\n  const int full_rows = rows - rows % 4;\n  const int full_cols = cols - cols % 4;\n  for (int i = 0; i < full_rows; i += 4) {\n    for (int j = 0; j < full_cols; j += 4) {\n      float32x4_t r0 = vld1q_f32(&src[i][j]);\n      float32x4_t r1 = vld1q_f32(&src[i+1][j]);\n      float32x4_t r2 = vld1q_f32(&src[i+2][j]);\n      float32x4_t r3 = vld1q_f32(&src[i+3][j]);\n      float32x4x2_t t0 = vtrnq_f32(r0, r1);\n      float32x4x2_t t1 = vtrnq_f32(r2, r3);\n      vst1q_f32(&dst[j][i],\n                 vcombine_f32(vget_low_f32(t0.val[0]),\n                              vget_low_f32(t1.val[0])));\n      vst1q_f32(&dst[j+1][i],\n                 vcombine_f32(vget_low_f32(t0.val[1]),\n                              vget_low_f32(t1.val[1])));\n      vst1q_f32(&dst[j+2][i],\n                 vcombine_f32(vget_high_f32(t0.val[0]),\n                              vget_high_f32(t1.val[0])));\n      vst1q_f32(&dst[j+3][i],\n                 vcombine_f32(vget_high_f32(t0.val[1]),\n                              vget_high_f32(t1.val[1])));\n    }\n  }\n  for (int i = 0; i < rows; ++i) {\n    const int first = i < full_rows ? full_cols : 0;\n    for (int j = first; j < cols; ++j) {\n      dst[j][i] = src[i][j];\n    }\n  }\n#else\n  for (int i = 0; i < rows; ++i) {\n    for (int j = 0; j < cols; ++j) {\n      dst[j][i] = src[i][j];\n    }\n  }\n#endif\n}\n\n/* Every SIMD lane owns one target and visits sources in ascending order. */\nstatic void accumulate_panel(float *restrict fx, float *restrict fy,\n                              float *restrict fz,\n                              const float *restrict x,\n                              const float *restrict y,\n                              const float *restrict z,\n                              int target_first, int target_count,\n                              int source_first, int source_count,\n                              const float coefficients[PAIR_TILE][PAIR_TILE]) {\n  int q = 0;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n  for (; q + TARGET_PACKET <= target_count; q += TARGET_PACKET) {\n    const int t = target_first + q;\n    const float32x4_t tx0 = vld1q_f32(x+t);\n    const float32x4_t ty0 = vld1q_f32(y+t);\n    const float32x4_t tz0 = vld1q_f32(z+t);\n    const float32x4_t tx1 = vld1q_f32(x+t+4);\n    const float32x4_t ty1 = vld1q_f32(y+t+4);\n    const float32x4_t tz1 = vld1q_f32(z+t+4);\n    const float32x4_t tx2 = vld1q_f32(x+t+8);\n    const float32x4_t ty2 = vld1q_f32(y+t+8);\n    const float32x4_t tz2 = vld1q_f32(z+t+8);\n    float32x4_t ax0 = vld1q_f32(fx+t);\n    float32x4_t ay0 = vld1q_f32(fy+t);\n    float32x4_t az0 = vld1q_f32(fz+t);\n    float32x4_t ax1 = vld1q_f32(fx+t+4);\n    float32x4_t ay1 = vld1q_f32(fy+t+4);\n    float32x4_t az1 = vld1q_f32(fz+t+4);\n    float32x4_t ax2 = vld1q_f32(fx+t+8);\n    float32x4_t ay2 = vld1q_f32(fy+t+8);\n    float32x4_t az2 = vld1q_f32(fz+t+8);\n\n    for (int j = 0; j < source_count; ++j) {\n      const int s = source_first + j;\n      const float32x4_t sx = vdupq_n_f32(x[s]);\n      const float32x4_t sy = vdupq_n_f32(y[s]);\n      const float32x4_t sz = vdupq_n_f32(z[s]);\n      const float32x4_t c0 = vld1q_f32(coefficients[j]+q);\n      ax0 += (sx - tx0) * c0;\n      ay0 += (sy - ty0) * c0;\n      az0 += (sz - tz0) * c0;\n      const float32x4_t c1 = vld1q_f32(coefficients[j]+q+4);\n      ax1 += (sx - tx1) * c1;\n      ay1 += (sy - ty1) * c1;\n      az1 += (sz - tz1) * c1;\n      const float32x4_t c2 = vld1q_f32(coefficients[j]+q+8);\n      ax2 += (sx - tx2) * c2;\n      ay2 += (sy - ty2) * c2;\n      az2 += (sz - tz2) * c2;\n    }\n\n    vst1q_f32(fx+t, ax0);\n    vst1q_f32(fy+t, ay0);\n    vst1q_f32(fz+t, az0);\n    vst1q_f32(fx+t+4, ax1);\n    vst1q_f32(fy+t+4, ay1);\n    vst1q_f32(fz+t+4, az1);\n    vst1q_f32(fx+t+8, ax2);\n    vst1q_f32(fy+t+8, ay2);\n    vst1q_f32(fz+t+8, az2);\n  }\n#endif\n  for (; q < target_count; ++q) {\n    const int t = target_first + q;\n    const float tx = x[t];\n    const float ty = y[t];\n    const float tz = z[t];\n    float ax = fx[t];\n    float ay = fy[t];\n    float az = fz[t];\n    for (int j = 0; j < source_count; ++j) {\n      const int s = source_first + j;\n      float dx = x[s] - tx;\n      float dy = y[s] - ty;\n      float dz = z[s] - tz;\n      float c = coefficients[j][q];\n      ax += dx * c;\n      ay += dy * c;\n      az += dz * c;\n    }\n    fx[t] = ax;\n    fy[t] = ay;\n    fz[t] = az;\n  }\n}\n\nstatic void simulate(Body *p, int n) {\n  if (n < 2 * PAIR_TILE) {\n    direct_simulation(p, n);\n    return;\n  }\n\n  const size_t stride = ((size_t)n + 15u) & ~(size_t)15u;\n  if (stride > (SIZE_MAX - 63u) / (6u * sizeof(float))) {\n    direct_simulation(p, n);\n    return;\n  }\n  void *allocation = malloc(6u * stride * sizeof(float) + 63u);\n  if (allocation == NULL) {\n    direct_simulation(p, n);\n    return;\n  }\n  float *x = (float *)(((uintptr_t)allocation + 63u) & ~(uintptr_t)63u);\n  float *y = x + stride;\n  float *z = y + stride;\n  float *fx = z + stride;\n  float *fy = fx + stride;\n  float *fz = fy + stride;\n  const int tile_count = n / PAIR_TILE + (n % PAIR_TILE != 0);\n  int scalar_required = 0;\n\n#ifdef _OPENMP\n#pragma omp parallel\n#endif\n  {\n#if defined(__GNUC__) || defined(__clang__)\n    float coefficients[PAIR_TILE][PAIR_TILE] __attribute__((aligned(64)));\n    float transposed[PAIR_TILE][PAIR_TILE] __attribute__((aligned(64)));\n#else\n    float coefficients[PAIR_TILE][PAIR_TILE];\n    float transposed[PAIR_TILE][PAIR_TILE];\n#endif\n    for (int iter = 0; iter < N_ITER; ++iter) {\n#ifdef _OPENMP\n#pragma omp for schedule(static) reduction(|:scalar_required)\n#endif\n      for (int i = 0; i < n; ++i) {\n        x[i] = p[i].x;\n        y[i] = p[i].y;\n        z[i] = p[i].z;\n        fx[i] = 0.0f;\n        fy[i] = 0.0f;\n        fz[i] = 0.0f;\n        /* Keep squared distances finite; unordered comparisons also fall back. */\n        if (!(fabsf(x[i]) <= 0x1p62f &&\n              fabsf(y[i]) <= 0x1p62f &&\n              fabsf(z[i]) <= 0x1p62f)) {\n          scalar_required |= 1;\n        }\n      }\n\n      if (scalar_required) {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n        for (int i = 0; i < n; ++i) {\n          body_force_one(p, DT, n, i);\n        }\n      } else {\n        /* A fixed target sees source blocks in ascending order of this sum. */\n        for (int diagonal = 0; diagonal < 2 * tile_count - 1; ++diagonal) {\n          const int first = diagonal >= tile_count\n                            ? diagonal - tile_count + 1 : 0;\n          const int last = diagonal / 2;\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n          for (int a = first; a <= last; ++a) {\n            const int b = diagonal - a;\n            const int afirst = a * PAIR_TILE;\n            const int bfirst = b * PAIR_TILE;\n            int na = n - afirst;\n            int nb = n - bfirst;\n            if (na > PAIR_TILE) na = PAIR_TILE;\n            if (nb > PAIR_TILE) nb = PAIR_TILE;\n            make_coefficients(x, y, z, afirst, na, bfirst, nb,\n                              coefficients);\n            if (a != b) {\n              transpose_coefficients(coefficients, transposed, nb, na);\n            }\n            accumulate_panel(fx, fy, fz, x, y, z,\n                             afirst, na, bfirst, nb, coefficients);\n            if (a != b) {\n              accumulate_panel(fx, fy, fz, x, y, z,\n                               bfirst, nb, afirst, na, transposed);\n            }\n          }\n        }\n      }\n\n      /* All force reads finish before any position changes. */\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n      for (int i = 0; i < n; ++i) {\n        if (!scalar_required) {\n          p[i].vx += DT*fx[i];\n          p[i].vy += DT*fy[i];\n          p[i].vz += DT*fz[i];\n        }\n        p[i].x += p[i].vx * DT;\n        p[i].y += p[i].vy * DT;\n        p[i].z += p[i].vz * DT;\n      }\n    }\n  }\n  free(allocation);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n  Body *bodies = read_dataset(&nbodies);\n  simulate(bodies, nbodies);\n  write_dataset(nbodies, bodies);\n  free(bodies);\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }

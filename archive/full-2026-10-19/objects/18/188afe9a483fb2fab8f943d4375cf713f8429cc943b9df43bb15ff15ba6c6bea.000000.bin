      "content": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <iterator>\n#include <string>\n\n#ifdef _OPENMP\n#include <array>\n#include <atomic>\n#include <cstdint>\n#include <limits>\n#include <memory>\n#include <vector>\n#include <omp.h>\n#endif\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ' )\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v');\n    }\n};\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase(std::remove_if(text.begin(), text.end(), IsWhitespace()),\n               text.end());\n    return text;\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator<char> begin(in), end;\n    std::string text(begin, end);\n    return remove_whitespaces(text);\n}\n\nnamespace\n{\nconst std::size_t block_size = 64u * 1024u;\n\nclass BufferedOutput\n{\n    char data_[block_size];\n    std::size_t used_;\n\n    void flush()\n    {\n        if (used_ != 0) {\n            std::cout.write(data_, static_cast<std::streamsize>(used_));\n            used_ = 0;\n        }\n    }\n\npublic:\n    BufferedOutput() : used_(0) {}\n\n    char* reserve(std::size_t length)\n    {\n        if (length > block_size - used_) flush();\n        return data_ + used_;\n    }\n\n    void commit(std::size_t length)\n    {\n        used_ += length;\n    }\n\n    void put(char value)\n    {\n        *reserve(1) = value;\n        commit(1);\n    }\n\n    void finish()\n    {\n        flush();\n    }\n};\n\ntemplate <typename Output>\nvoid emit_permutation(const std::string& text, Output& output)\n{\n    if (text.size() <= (block_size - 4) / 2) {\n        const std::size_t length = 2 * text.size() + 4;\n        char* destination = output.reserve(length);\n        *destination++ = '[';\n        *destination++ = ' ';\n        for (char value : text) {\n            *destination++ = value;\n            *destination++ = ' ';\n        }\n        *destination++ = ']';\n        *destination = '\\n';\n        output.commit(length);\n    } else {\n        output.put('[');\n        output.put(' ');\n        for (char value : text) {\n            output.put(value);\n            output.put(' ');\n        }\n        output.put(']');\n        output.put('\\n');\n    }\n}\n\ntemplate <typename Output>\nvoid generate_subtree(std::string& text, std::size_t prefix_length,\n                      Output& output)\n{\n    do {\n        emit_permutation(text, output);\n    } while (std::next_permutation(text.begin() + prefix_length, text.end()));\n}\n\nvoid generate_serial(std::string& text)\n{\n    if (text.empty()) return;\n    BufferedOutput output;\n    generate_subtree(text, 0, output);\n    output.finish();\n}\n\n#ifdef _OPENMP\ntypedef std::array<std::size_t, 256> Counts;\n\nstd::uint64_t gcd_value(std::uint64_t a, std::uint64_t b)\n{\n    while (b != 0) {\n        const std::uint64_t remainder = a % b;\n        a = b;\n        b = remainder;\n    }\n    return a;\n}\n\nstd::uint64_t count_permutations(const Counts& counts,\n                                 const std::vector<char>& symbols)\n{\n    const std::uint64_t limit = std::numeric_limits<std::uint64_t>::max();\n    std::uint64_t ways = 1;\n    std::size_t used = 0;\n    for (char symbol : symbols) {\n        const std::size_t amount = counts[static_cast<unsigned char>(symbol)];\n        if (amount == 0) continue;\n        const std::size_t total = used + amount;\n        const std::size_t k = std::min(used, amount);\n        for (std::size_t j = 1; j <= k; ++j) {\n            std::uint64_t numerator = static_cast<std::uint64_t>(total - k + j);\n            std::uint64_t denominator = static_cast<std::uint64_t>(j);\n            const std::uint64_t common = gcd_value(numerator, denominator);\n            numerator /= common;\n            denominator /= common;\n            ways /= denominator;\n            if (ways > limit / numerator) return limit;\n            ways *= numerator;\n        }\n        used = total;\n    }\n    return ways;\n}\n\nstd::uint64_t saturated_product(std::uint64_t a, std::uint64_t b)\n{\n    const std::uint64_t limit = std::numeric_limits<std::uint64_t>::max();\n    if (b != 0 && a > limit / b) return limit;\n    return a * b;\n}\n\nstruct PrefixTask\n{\n    std::string prefix;\n    std::uint64_t work;\n};\n\nstd::vector<PrefixTask> make_tasks(const Counts& counts,\n                                   const std::vector<char>& symbols,\n                                   std::uint64_t total_work,\n                                   std::size_t target)\n{\n    std::vector<PrefixTask> tasks(1);\n    tasks[0].work = total_work;\n    while (tasks.size() < target) {\n        std::size_t best = tasks.size();\n        for (std::size_t i = 0; i < tasks.size(); ++i) {\n            if (tasks[i].work > 1 &&\n                (best == tasks.size() || tasks[i].work > tasks[best].work)) {\n                best = i;\n            }\n        }\n        if (best == tasks.size()) break;\n\n        const PrefixTask parent = tasks[best];\n        Counts remaining = counts;\n        for (char symbol : parent.prefix) {\n            --remaining[static_cast<unsigned char>(symbol)];\n        }\n        std::vector<PrefixTask> children;\n        for (char symbol : symbols) {\n            const unsigned char index = static_cast<unsigned char>(symbol);\n            if (remaining[index] == 0) continue;\n            --remaining[index];\n            PrefixTask child;\n            child.prefix = parent.prefix;\n            child.prefix.push_back(symbol);\n            child.work = count_permutations(remaining, symbols);\n            children.push_back(child);\n            ++remaining[index];\n        }\n        tasks.erase(tasks.begin() + best);\n        tasks.insert(tasks.begin() + best, children.begin(), children.end());\n    }\n    return tasks;\n}\n\ninline void spin_pause(unsigned& spins)\n{\n    if ((++spins & 1023u) == 0) {\n#pragma omp taskyield\n    }\n}\n\nvoid wait_for_flag(std::atomic<bool>& flag, bool value)\n{\n    unsigned spins = 0;\n    while (flag.load(std::memory_order_acquire) != value) {\n        spin_pause(spins);\n    }\n}\n\nstruct OutputSlot\n{\n    std::atomic<bool> ready;\n    std::size_t length;\n    bool last;\n    char data[block_size];\n\n    OutputSlot() : ready(false), length(0), last(false) {}\n};\n\nstruct OutputChannel\n{\n    OutputSlot slots[2];\n    unsigned read_slot;\n\n    OutputChannel() : read_slot(0) {}\n};\n\nclass QueuedOutput\n{\n    OutputChannel& channel_;\n    unsigned write_slot_;\n    std::size_t used_;\n\n    void publish(bool last)\n    {\n        OutputSlot& slot = channel_.slots[write_slot_];\n        slot.length = used_;\n        slot.last = last;\n        slot.ready.store(true, std::memory_order_release);\n        write_slot_ ^= 1u;\n        used_ = 0;\n        wait_for_flag(channel_.slots[write_slot_].ready, false);\n    }\n\npublic:\n    explicit QueuedOutput(OutputChannel& channel)\n        : channel_(channel), write_slot_(0), used_(0)\n    {\n        wait_for_flag(channel_.slots[write_slot_].ready, false);\n    }\n\n    char* reserve(std::size_t length)\n    {\n        if (length > block_size - used_) publish(false);\n        return channel_.slots[write_slot_].data + used_;\n    }\n\n    void commit(std::size_t length)\n    {\n        used_ += length;\n    }\n\n    void put(char value)\n    {\n        *reserve(1) = value;\n        commit(1);\n    }\n\n    void finish_task()\n    {\n        publish(true);\n    }\n};\n\nvoid drain_tasks(std::size_t task_count, std::atomic<int>* owners,\n                 OutputChannel* channels)\n{\n    for (std::size_t task = 0; task < task_count; ++task) {\n        int producer;\n        unsigned spins = 0;\n        while ((producer = owners[task].load(std::memory_order_acquire)) < 0) {\n            spin_pause(spins);\n        }\n        OutputChannel& channel = channels[producer];\n        bool last;\n        do {\n            OutputSlot& slot = channel.slots[channel.read_slot];\n            wait_for_flag(slot.ready, true);\n            std::cout.write(slot.data, static_cast<std::streamsize>(slot.length));\n            last = slot.last;\n            slot.ready.store(false, std::memory_order_release);\n            channel.read_slot ^= 1u;\n        } while (!last);\n    }\n}\n\nvoid produce_task(const PrefixTask& task, const Counts& counts,\n                  const std::vector<char>& symbols, std::string& state,\n                  QueuedOutput& output)\n{\n    Counts remaining = counts;\n    for (char symbol : task.prefix) {\n        --remaining[static_cast<unsigned char>(symbol)];\n    }\n    state.assign(task.prefix);\n    for (char symbol : symbols) {\n        state.append(remaining[static_cast<unsigned char>(symbol)], symbol);\n    }\n    generate_subtree(state, task.prefix.size(), output);\n    output.finish_task();\n}\n\nbool try_parallel(std::string& text)\n{\n    int threads = std::min(omp_get_max_threads(), 4);\n    if (threads < 3 || omp_in_parallel()) return false;\n\n    Counts counts = {};\n    std::vector<char> symbols;\n    symbols.reserve(256);\n    for (char symbol : text) {\n        const unsigned char index = static_cast<unsigned char>(symbol);\n        if (counts[index]++ == 0) symbols.push_back(symbol);\n    }\n    const std::uint64_t ways = count_permutations(counts, symbols);\n    const std::uint64_t limit = std::numeric_limits<std::uint64_t>::max();\n    const std::uint64_t length = static_cast<std::uint64_t>(text.size());\n    const std::uint64_t line_bytes = length > (limit - 4) / 2\n        ? limit : 2 * length + 4;\n    const std::uint64_t output_bytes = saturated_product(ways, line_bytes);\n    if (ways < 16384u || output_bytes < 4u * 1024u * 1024u) return false;\n    if (output_bytes < 16u * 1024u * 1024u) threads = std::min(threads, 3);\n\n    const std::vector<PrefixTask> tasks = make_tasks(\n        counts, symbols, ways, static_cast<std::size_t>(threads - 1) * 32u);\n    if (tasks.size() < 2) return false;\n\n    std::unique_ptr<OutputChannel[]> channels(new OutputChannel[threads - 1]);\n    std::unique_ptr<std::atomic<int>[]> owners(new std::atomic<int>[tasks.size()]);\n    for (std::size_t i = 0; i < tasks.size(); ++i) {\n        owners[i].store(-1, std::memory_order_relaxed);\n    }\n    std::atomic<std::size_t> next_task(0);\n    const std::size_t input_length = text.size();\n\n#pragma omp parallel num_threads(threads)\n    {\n        const int id = omp_get_thread_num();\n        if (omp_get_num_threads() < 3) {\n            if (id == 0) generate_serial(text);\n        } else if (id == 0) {\n            drain_tasks(tasks.size(), owners.get(), channels.get());\n        } else {\n            QueuedOutput output(channels[id - 1]);\n            std::string state;\n            state.reserve(input_length);\n            for (;;) {\n                const std::size_t task = next_task.fetch_add(\n                    1, std::memory_order_relaxed);\n                if (task >= tasks.size()) break;\n                // Every earlier task is already assigned, so the writer's\n                // earliest unfinished task always has a producer.\n                owners[task].store(id - 1, std::memory_order_release);\n                produce_task(tasks[task], counts, symbols, state, output);\n            }\n        }\n    }\n    return true;\n}\n#endif\n}\n\nint main(int argc, char const* argv[])\n{\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n    std::string text = read_text_from_stdin<std::string>(std::cin);\n    if (text.empty()) return 0;\n    std::sort(text.begin(), text.end());\n#ifdef _OPENMP\n    if (try_parallel(text)) return 0;\n#endif\n    generate_serial(text);\n    return 0;\n}\n",
      "path": "src/permutations.cc"
    }
  ],
  "hypothesis": "Buffered prefix-subtree generation with two or three OpenMP producers and one ordered writer can amortize output overhead while preserving exact lexicographic output.",
  "notes": "Unmeasured. OpenMP is conditional on the unchanged build defining _OPENMP; otherwise the buffered serial implementation is used.",

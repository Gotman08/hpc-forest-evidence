      "content": "#include \"knn.h\"\n\n#ifdef _OPENMP\n#include <omp.h>\n\ntypedef struct {\n    float distance;\n    int group;\n} KnnCandidate;\n\ntypedef struct {\n    KnnCandidate * candidates;\n    int capacity;\n    int count;\n    int head;\n} KnnPartial;\n\nstatic void knn_partial_insert(KnnPartial * partial, float distance, int group) {\n    if (partial->capacity == 0) return;\n\n    int position = partial->count;\n    if (position == partial->capacity) {\n        KnnCandidate last = partial->candidates[position - 1];\n        if (distance > last.distance ||\n            (distance == last.distance && group >= last.group)) return;\n        position--;\n    } else {\n        partial->count++;\n    }\n\n    /* Within one group, equal-distance points have identical labels. */\n    while (position > 0) {\n        KnnCandidate previous = partial->candidates[position - 1];\n        if (!(distance < previous.distance ||\n              (distance == previous.distance && group < previous.group))) break;\n        partial->candidates[position] = previous;\n        position--;\n    }\n\n    partial->candidates[position].distance = distance;\n    partial->candidates[position].group = group;\n}\n\nstatic int knn_select_parallel(int n_groups, Group * groups, int k,\n                               Point to_evaluate, char * labels) {\n    if (k <= 0) return 0;\n\n    size_t total = 0;\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length < 0) return 0;\n        size_t length = (size_t) groups[i].length;\n        if (length > ((size_t) -1) - total) return 0;\n        total += length;\n    }\n\n    int workers = omp_get_max_threads();\n    size_t max_workers = total / 4096;\n    if (max_workers < (size_t) workers) workers = (int) max_workers;\n    if (workers < 2) return 0;\n\n    KnnPartial * partials = (KnnPartial *) calloc((size_t) workers, sizeof(KnnPartial));\n    if (partials == NULL) return 0;\n\n    size_t * offsets = (size_t *) malloc(sizeof(size_t) * ((size_t) n_groups + 1));\n    if (offsets == NULL) {\n        free(partials);\n        return 0;\n    }\n\n    offsets[0] = 0;\n    for (int i = 0; i < n_groups; i++) {\n        offsets[i + 1] = offsets[i] + (size_t) groups[i].length;\n    }\n\n    size_t block_size = total / ((size_t) workers * 8);\n    if (block_size < 1024) block_size = 1024;\n    if (block_size > 16384) block_size = 16384;\n    size_t blocks = total / block_size + (total % block_size != 0);\n    int capacity = total < (size_t) k ? (int) total : k;\n    int failed = 0;\n\n    #pragma omp parallel num_threads(workers) reduction(|:failed)\n    {\n        KnnPartial local = {0};\n        local.capacity = capacity;\n        local.candidates = (KnnCandidate *) malloc(sizeof(KnnCandidate) * (size_t) capacity);\n        int invalid = local.candidates == NULL;\n\n        #pragma omp for schedule(dynamic, 1)\n        for (size_t block = 0; block < blocks; block++) {\n            if (invalid) continue;\n\n            size_t begin = block * block_size;\n            size_t remaining = total - begin;\n            size_t end = begin + (remaining < block_size ? remaining : block_size);\n\n            size_t low = 0;\n            size_t high = (size_t) n_groups;\n            while (low < high) {\n                size_t middle = low + (high - low) / 2;\n                if (offsets[middle + 1] <= begin) {\n                    low = middle + 1;\n                } else {\n                    high = middle;\n                }\n            }\n\n            for (int i = (int) low;\n                 i < n_groups && offsets[i] < end && !invalid; i++) {\n                const Group * g = &groups[i];\n                size_t first = begin > offsets[i] ? begin - offsets[i] : 0;\n                size_t next = offsets[i + 1];\n                size_t last = end < next ? end - offsets[i] : (size_t) g->length;\n\n                for (size_t j = first; j < last; j++) {\n                    float d = euclidean_distance_no_sqrt(to_evaluate, g->points[j]);\n                    if (d != d) {\n                        invalid = 1;\n                        break;\n                    }\n                    knn_partial_insert(&local, d, i);\n                }\n            }\n        }\n\n        partials[omp_get_thread_num()] = local;\n        failed |= invalid;\n    }\n\n    if (!failed) {\n        for (int i = 0; i < k; i++) {\n            int best = -1;\n            float best_distance = 0.0f;\n            int best_group = 0;\n\n            /* Original group order resolves ties regardless of scheduling. */\n            for (int part = 0; part < workers; part++) {\n                KnnPartial * partial = &partials[part];\n                if (partial->head < partial->count) {\n                    KnnCandidate candidate = partial->candidates[partial->head];\n                    if (best < 0 || candidate.distance < best_distance ||\n                        (candidate.distance == best_distance && candidate.group < best_group)) {\n                        best = part;\n                        best_distance = candidate.distance;\n                        best_group = candidate.group;\n                    }\n                }\n            }\n\n            if (best < 0) break;\n            labels[i] = groups[best_group].label;\n            partials[best].head++;\n        }\n    }\n\n    for (int part = 0; part < workers; part++) {\n        free(partials[part].candidates);\n    }\n    free(offsets);\n    free(partials);\n\n    return !failed;\n}\n#endif\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n    }\n\n    int selected_in_parallel = 0;\n#ifdef _OPENMP\n    selected_in_parallel = knn_select_parallel(n_groups, groups, k, to_evaluate, labels);\n#endif\n\n    if (!selected_in_parallel) {\n        float * distances = (float *) malloc(sizeof(float) * k);\n\n        for (i = 0; i < k; i++) {\n            distances[i] = -1;\n        }\n\n        for (i = 0; i < n_groups; i++) {\n            Group g = groups[i];\n\n            for (j = 0; j < g.length; j++) {\n                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n                for (x = 0; x < k; x++) {\n                    if (d < distances[x] || distances[x] == -1) {\n                        for (y = k - 1; y > x; y--) {\n                            distances[y] = distances[y - 1];\n                            labels[y] = labels[y - 1];\n                        }\n\n                        distances[x] = d;\n                        labels[x] = g.label;\n\n                        break;\n                    }\n                }\n            }\n        }\n\n        free(distances);\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(labels);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }

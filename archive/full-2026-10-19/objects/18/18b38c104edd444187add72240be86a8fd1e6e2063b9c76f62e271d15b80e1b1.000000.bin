      "content": "#include \"knn.h\"\n#include <stddef.h>\n#include <stdint.h>\n\ntypedef struct {\n    float distance;\n    char label;\n    size_t ordinal;\n} Neighbor;\n\nstatic int neighbor_is_worse(const Neighbor *a, const Neighbor *b) {\n    if (a->distance > b->distance) return 1;\n    if (a->distance < b->distance) return 0;\n    return a->ordinal > b->ordinal;\n}\n\nstatic void heap_sift_up(Neighbor *heap, size_t index) {\n    Neighbor value = heap[index];\n\n    while (index != 0) {\n        size_t parent = (index - 1) / 2;\n        if (!neighbor_is_worse(&value, &heap[parent])) break;\n        heap[index] = heap[parent];\n        index = parent;\n    }\n\n    heap[index] = value;\n}\n\nstatic void heap_sift_down(Neighbor *heap, size_t heap_size, size_t index) {\n    Neighbor value = heap[index];\n\n    while (2 * index + 1 < heap_size) {\n        size_t child = 2 * index + 1;\n        if (child + 1 < heap_size &&\n            neighbor_is_worse(&heap[child + 1], &heap[child])) {\n            child++;\n        }\n        if (!neighbor_is_worse(&heap[child], &value)) break;\n        heap[index] = heap[child];\n        index = child;\n    }\n\n    heap[index] = value;\n}\n\nstatic char vote_labels(char *labels, int k) {\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n    int i;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nstatic char knn_linear(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *)malloc(sizeof(char) * (size_t)k);\n    float *distances = (float *)malloc(sizeof(float) * (size_t)k);\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        const Group *g = &groups[i];\n\n        for (j = 0; j < g->length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g->points[j]);\n\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n\n                    distances[x] = d;\n                    labels[x] = g->label;\n                    break;\n                }\n            }\n        }\n    }\n\n    char result = vote_labels(labels, k);\n    free(distances);\n    free(labels);\n    return result;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    size_t total_points = 0;\n    int i, j;\n\n    for (i = 0; i < n_groups; i++) {\n        if (groups[i].length > 0) {\n            size_t group_length = (size_t)groups[i].length;\n            if (group_length > SIZE_MAX - total_points) {\n                return knn_linear(n_groups, groups, k, to_evaluate);\n            }\n            total_points += group_length;\n        }\n    }\n\n    size_t capacity = (size_t)k;\n    if (capacity > total_points) capacity = total_points;\n\n    char *labels = (char *)malloc(sizeof(char) * (size_t)k);\n    if (capacity > SIZE_MAX / sizeof(Neighbor)) {\n        free(labels);\n        return knn_linear(n_groups, groups, k, to_evaluate);\n    }\n\n    Neighbor *heap = capacity == 0\n        ? NULL\n        : (Neighbor *)malloc(sizeof(Neighbor) * capacity);\n    if (capacity != 0 && heap == NULL) {\n        free(labels);\n        return knn_linear(n_groups, groups, k, to_evaluate);\n    }\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n    }\n\n    size_t heap_size = 0;\n    size_t ordinal = 0;\n\n    for (i = 0; i < n_groups; i++) {\n        const Group *g = &groups[i];\n\n        for (j = 0; j < g->length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g->points[j]);\n            if (d != d) {\n                free(heap);\n                free(labels);\n                return knn_linear(n_groups, groups, k, to_evaluate);\n            }\n\n            Neighbor candidate;\n            candidate.distance = d;\n            candidate.label = g->label;\n            candidate.ordinal = ordinal;\n\n            if (heap_size < capacity) {\n                heap[heap_size] = candidate;\n                heap_sift_up(heap, heap_size);\n                heap_size++;\n            } else if (neighbor_is_worse(&heap[0], &candidate)) {\n                heap[0] = candidate;\n                heap_sift_down(heap, heap_size, 0);\n            }\n\n            ordinal++;\n        }\n    }\n\n    for (size_t x = 0; x < heap_size; x++) {\n        labels[x] = heap[x].label;\n    }\n\n    char result = vote_labels(labels, k);\n    free(heap);\n    free(labels);\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n\n    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "A bounded max-heap reduces top-k maintenance from repeated O(k) scans and shifts to O(log k) per point while preserving earlier traversal order for equal distances. This should improve the full program when top-k maintenance is a significant cost; the controller should verify the result on the target.",
  "notes": "Retain the archived heap idea only. Keep the original label sort and vote behavior, with a linear fallback if a NaN distance appears. The recorded heap result is promising but does not establish correctness or speed for this integrated program.",

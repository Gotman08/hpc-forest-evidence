{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"/*\\n  Quicksort\\n*/\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <limits.h>\\n#include <string.h>\\n#include <openssl/md5.h>\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\n\\n/*\\n * Prototypes\\n */\\nvoid srandnum(int seed);\\ndouble randnum(void);\\nint *generate_case(int N);\\ndouble drand(int xmin, int xmax);\\nvoid swap(int *toorder, int i, int j);\\nint partition(int *toorder, int lo, int hi);\\nvoid _quicksort(int *toorder, int lo, int hi);\\nvoid quicksort(int *toorder, int N);\\nint is_sorted(int *toorder, int N);\\n\\n/*\\n * A generic pRNG\\n */\\n#define MY_RAND_MAX 0x7FFFFFFF\\n\\n#define RANDNUM_W 521288629\\n#define RANDNUM_Z 362436069\\n\\nunsigned int randum_w = RANDNUM_W;\\nunsigned int randum_z = RANDNUM_Z;\\n\\nvoid srandnum(int seed)\\n{\\n    unsigned int w, z;\\n    w = (seed * 104623) & 0xffffffff;\\n    randum_w = (w) ? w : RANDNUM_W;\\n    z = (seed * 48947) & 0xffffffff;\\n    randum_z = (z) ? z : RANDNUM_Z;\\n}\\n\\ndouble randnum(void)\\n{\\n    unsigned int u;\\n    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);\\n    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);\\n    u = (randum_z << 16) + randum_w;\\n    return (abs(u));\\n}\\n\\n/*\\n * Main function\\n */\\nint main(int argc, char *argv[])\\n{\\n    int N = 0;\\n    int *our_list = NULL;\\n\\n    //The input provides the case size\\n\\tscanf(\\\"%d\\\", &N);\\n    if (N <= 0) {\\n\\tprintf(\\\"Error: please, provide the case size.\\\\n\\\");\\n\\treturn 1;\\n    }\\n\\n    //Generate the case\\n    our_list = generate_case(N);\\n    if (our_list == NULL) {\\n\\tprintf(\\\"Error: case instantiation failed.\\\\n\\\");\\n\\treturn 1;\\n    }\\n\\n    //Do the thing\\n    quicksort(our_list, N);\\n\\n    if (is_sorted(our_list, N) == 1) {\\n\\tprintf(\\\"Error, for some reason list is still unsorted.\\\\n\\\");\\n\\treturn 1;\\n    }\\n\\n#ifdef COMPUTE_MD5_PROBLEM\\n    //Compute MD5 Checksum for problem identification\\n    MD5_CTX c;\\n    unsigned char out[MD5_DIGEST_LENGTH];\\n    MD5_Init(&c);\\n    MD5_Update(&c, our_list, N * sizeof(int));\\n    MD5_Final(out, &c);\\n    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {\\n\\tprintf(\\\"%02x\\\", out[n]);\\n    }\\n#endif\\n    printf(\\\"\\\\n\\\");\\n\\n    //Clean up\\n    free(our_list);\\n\\n    return 0;\\n}\\n\\n#define RADIX_BUCKETS 256\\n#define RADIX_WORKERS 4\\n#define RADIX_PASSES ((sizeof(unsigned int) * CHAR_BIT + 7) / 8)\\n#define RADIX_PARALLEL_THRESHOLD 262144\\n\\nstatic inline unsigned int radix_digit(int value, unsigned int shift)\\n{\\n    unsigned int key = (unsigned int)value ^ ((unsigned int)INT_MAX + 1u);\\n    return (key >> shift) & 255u;\\n}\\n\\n/* Independent banks avoid a single counter dependency chain on repeated keys. */\\nstatic void radix_histogram(const int *restrict source, size_t n,\\n                            unsigned int shift, size_t *restrict counts)\\n{\\n    size_t bank[4][RADIX_BUCKETS] = {{0}};\\n    size_t limit = n & ~(size_t)3;\\n    size_t i = 0;\\n    for (; i < limit; i += 4) {\\n        ++bank[0][radix_digit(source[i], shift)];\\n        ++bank[1][radix_digit(source[i + 1], shift)];\\n        ++bank[2][radix_digit(source[i + 2], shift)];\\n        ++bank[3][radix_digit(source[i + 3], shift)];\\n    }\\n    for (; i < n; ++i) {\\n        ++bank[0][radix_digit(source[i], shift)];\\n    }\\n#if defined(_OPENMP) && _OPENMP >= 201307\\n#pragma omp simd\\n#endif\\n    for (unsigned int bucket = 0; bucket < RADIX_BUCKETS; ++bucket) {\\n        counts[bucket] = bank[0][bucket] + bank[1][bucket]\\n                       + bank[2][bucket] + bank[3][bucket];\\n    }\\n}\\n\\n/* Equal digits can share a cursor, so scatter updates stay ordered, not SIMD. */\\nstatic void radix_scatter(const int *restrict source, size_t n,\\n                          int *restrict destination, unsigned int shift,\\n                          size_t *restrict offsets)\\n{\\n    size_t limit = n & ~(size_t)3;\\n    size_t i = 0;\\n    for (; i < limit; i += 4) {\\n        int v0 = source[i];\\n        int v1 = source[i + 1];\\n        int v2 = source[i + 2];\\n        int v3 = source[i + 3];\\n        unsigned int b0 = radix_digit(v0, shift);\\n        unsigned int b1 = radix_digit(v1, shift);\\n        unsigned int b2 = radix_digit(v2, shift);\\n        unsigned int b3 = radix_digit(v3, shift);\\n        destination[offsets[b0]++] = v0;\\n        destination[offsets[b1]++] = v1;\\n        destination[offsets[b2]++] = v2;\\n        destination[offsets[b3]++] = v3;\\n    }\\n    for (; i < n; ++i) {\\n        int value = source[i];\\n        destination[offsets[radix_digit(value, shift)]++] = value;\\n    }\\n}\\n\\nstatic void radix_sort_serial(int *toorder, int *scratch, size_t n)\\n{\\n    size_t counts[RADIX_BUCKETS];\\n    size_t offsets[RADIX_BUCKETS];\\n    for (unsigned int pass = 0; pass < RADIX_PASSES; ++pass) {\\n        const int *source = (pass & 1u) ? scratch : toorder;\\n        int *destination = (pass & 1u) ? toorder : scratch;\\n        unsigned int shift = pass * 8;\\n        radix_histogram(source, n, shift, counts);\\n        size_t total = 0;\\n        for (unsigned int bucket = 0; bucket < RADIX_BUCKETS; ++bucket) {\\n            offsets[bucket] = total;\\n            total += counts[bucket];\\n        }\\n        radix_scatter(source, n, destination, shift, offsets);\\n    }\\n    if (RADIX_PASSES & 1u) {\\n        memcpy(toorder, scratch, n * sizeof(*toorder));\\n    }\\n}\\n\\n#ifdef _OPENMP\\n/* Padding separates the writable portions of neighboring workers' rows. */\\ntypedef struct {\\n    size_t bin[RADIX_BUCKETS];\\n    size_t padding[8];\\n} radix_row;\\n\\nstatic void radix_sort_parallel(int *toorder, int *scratch, size_t n)\\n{\\n    radix_row counts[RADIX_WORKERS];\\n    radix_row offsets[RADIX_WORKERS];\\n#pragma omp parallel num_threads(RADIX_WORKERS) shared(counts, offsets, toorder, scratch, n)\\n    {\\n        int worker = omp_get_thread_num();\\n        int workers = omp_get_num_threads();\\n        size_t block = n / (size_t)workers;\\n        size_t remainder = n % (size_t)workers;\\n        size_t id = (size_t)worker;\\n        size_t begin = id * block + (id < remainder ? id : remainder);\\n        size_t length = block + (id < remainder);\\n\\n        for (unsigned int pass = 0; pass < RADIX_PASSES; ++pass) {\\n            const int *source = (pass & 1u) ? scratch : toorder;\\n            int *destination = (pass & 1u) ? toorder : scratch;\\n            unsigned int shift = pass * 8;\\n\\n            /* Chunk contents change after every scatter: recount every pass. */\\n            radix_histogram(source + begin, length, shift, counts[worker].bin);\\n#pragma omp barrier\\n#pragma omp single\\n            {\\n                size_t total = 0;\\n                for (unsigned int bucket = 0; bucket < RADIX_BUCKETS; ++bucket) {\\n                    for (int t = 0; t < workers; ++t) {\\n                        offsets[t].bin[bucket] = total;\\n                        total += counts[t].bin[bucket];\\n                    }\\n                }\\n            }\\n            /* Bucket ranges follow input-chunk order, preserving stability. */\\n            radix_scatter(source + begin, length, destination, shift,\\n                          offsets[worker].bin);\\n#pragma omp barrier\\n        }\\n    }\\n    if (RADIX_PASSES & 1u) {\\n        memcpy(toorder, scratch, n * sizeof(*toorder));\\n    }\\n}\\n#endif\\n\\nstatic void insertion_sort(int *values, size_t n)\\n{\\n    for (size_t i = 1; i < n; ++i) {\\n        int value = values[i];\\n        size_t j = i;\\n        while (j > 0 && values[j - 1] > value) {\\n            values[j] = values[j - 1];\\n            --j;\\n        }\\n        values[j] = value;\\n    }\\n}\\n\\nstatic int compare_ints(const void *left, const void *right)\\n{\\n    int a = *(const int *)left;\\n    int b = *(const int *)right;\\n    return (a > b) - (a < b);\\n}\\n\\n/*\\n * Public API\\n */\\nvoid quicksort(int *toorder, int N)\\n{\\n    if (N < 2) {\\n        return;\\n    }\\n    size_t n = (size_t)N;\\n    if (n < 64) {\\n        insertion_sort(toorder, n);\\n        return;\\n    }\\n    int *scratch = (int *)malloc(n * sizeof(*scratch));\\n    if (scratch == NULL) {\\n        qsort(toorder, n, sizeof(*toorder), compare_ints);\\n        return;\\n    }\\n#ifdef _OPENMP\\n    if (n >= RADIX_PARALLEL_THRESHOLD && !omp_in_parallel()) {\\n        radix_sort_parallel(toorder, scratch, n);\\n    } else\\n#endif\\n    {\\n        radix_sort_serial(toorder, scratch, n);\\n    }\\n    free(scratch);\\n}\\n\\n/*\\n * Internal recursive function to quicksort\\n */\\nvoid _quicksort(int *toorder, int lo, int hi)\\n{\\n    if (lo >= hi)\\n\\treturn;\\n    int b = partition(toorder, lo, hi);\\n    _quicksort(toorder, lo, b - 1);\\n    _quicksort(toorder, b + 1, hi);\\n}\\n\\n/*\\n * Swap two values.\\n */\\nvoid swap(int *toorder, int i, int j)\\n{\\n    int temp = toorder[i];\\n    toorder[i] = toorder[j];\\n    toorder[j] = temp;\\n}\\n\\n/*\\n * Partition decision\\n */\\nint partition(int *toorder, int lo, int hi)\\n{\\n    int b = lo;\\n    int r = (int) (lo + (hi - lo) * (randnum() / MY_RAND_MAX));\\n    int pivot = toorder[r];\\n    swap(toorder, r, hi);\\n    for (int i = lo; i < hi; i++) {\\n\\tif (toorder[i] < pivot) {\\n\\t    swap(toorder, i, b);\\n\\t    b++;\\n\\t}\\n    }\\n    swap(toorder, hi, b);\\n    return b;\\n}\\n\\n/*\\n * Check if elements are in non-decreasing order\\n */\\nint is_sorted(int *toorder, int N)\\n{\\n    for (int i = 1; i < N; i++) {\\n\\tif (toorder[i] < toorder[i - 1]) {\\n\\t    return 1;\\n\\t}\\n    }\\n    return 0;\\n}\\n\\n\\n/*\\n * Generate a case\\n */\\nint *generate_case(int N)\\n{\\n    int i;\\n    int *ret = NULL;\\n\\n    // Make case generation reproducible\\n    srandnum(0);\\n\\n    // Allocate memory\\n    ret = (int *) malloc(N * sizeof(int));\\n    if (ret == NULL) {\\n\\tprintf(\\\"Error: some malloc won't work.\\\\n\\\");\\n\\treturn NULL;\\n    }\\n    // Get pseudo-random positive integer values\\n    for (i = 0; i < N; i++) {\\n\\tret[i] = drand(0, INT_MAX);\\n    }\\n    return ret;\\n}\\n\\n/*\\n * A pseudo-random number between two positive integer values\\n */\\ndouble drand(int xmin, int xmax)\\n{\\n    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;\\n}\\n\",\n      \"path\": \"src/quicksort.c\"\n    }\n  ],\n  \"hypothesis\": \"Stable byte-radix passes with independent histogram banks can outperform branch-heavy partitioning. Disjoint worker bucket ranges permit race-free parallel scatter, while only the independent histogram reduction is annotated for SIMD.\",\n  \"notes\": \"Unmeasured candidate. OpenMP is used only if enabled by the unchanged build; otherwise sorting remains serial. The 262144-element parallel threshold is provisional. Generation, validation, checksum and I/O are unchanged.\",\n  \"research\": {\n    \"queries\": [],\n    \"urls\": []\n  },\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Replace the public sorting backend with stable signed-integer LSD radix sorting using one temporary array.\",\n    \"Use four independent histogram banks and SIMD-safe bank reduction; retain ordered scalar cursor updates during scatter.\",\n    \"Conditionally use a persistent team of at most four OpenMP workers, padded histogram rows, per-pass recounting and exclusive bucket offsets.\",\n    \"Use insertion sort for tiny arrays and standard-library sorting if scratch allocation fails.\"\n  ]\n}"}}

"""Pure parent-metadata adapter. No factory, census, RPC, CLI, auth or worker effect.

--check-static validates existing named receipts and code only. Operational mode
requires actual SHA-bound observations; a false template never becomes evidence.
"""
import argparse
import hashlib
import json
from pathlib import Path
import sys
import time

HERE = Path(__file__).resolve().parent
MODULE = HERE / "assembler-entrees-roots.py"
MODULE_SHA = "98f5c41ab83c81733ff97bb547694124a5b632f4584620cf1d7691d4542f08fc"
module_code = MODULE.read_bytes()
if hashlib.sha256(module_code).hexdigest() != MODULE_SHA:
    raise ValueError("Pinned local metadata adapter changed before loading")
ns = {"__file__":str(MODULE), "__name__":"owned_root_input_definitions"}
exec(compile(module_code, str(MODULE), "exec"), ns)
need = ns["need"]
BASE, PREP, OPS, CHAIN = (ns[k] for k in ("BASE","PREP","OPS","CHAIN"))
COMPONENTS_SHA = "1e60da6d5b51afaf3c857b1ba215927e7e1201c297241afd6390212a89d5e449"
INTEGRATION_SHA = "cbb1e27f036cfc1fad0999909322d9f8e4ba905f1446f63f28d9ab6ece968055"
PRODUCER_SHA = "feb7a6949f10dfc7445e0369c3d91df9f3d51c94d9e1c43dd15ad56fe2040697"
PAIR_FIELDS = ("ProcessId","ParentProcessId","ExecutablePath","CommandLine","CreationDate")
R2D = BASE / "outputs/HPC-Forest-Primes-Natif-Relance-r2d"
R2D_CLOSURE = {
    "terminal_stop":(R2D/"fermeture-relais-r2d-r1/fermeture-r2d-main-only-verifiee.json", "2c63cb9337aadb92d87a7fe0e625ffee67612c9e39d3f49a3dadb4145b1875ee"),
    "complete_preservation":(R2D/"operations-parent-attempt2/preservation-caches-complete/PRESERVATION-COMPLETE-ET-ABSENCE-PAIRES.json", "e0d3b808b850e7beaf9a284817d81dc13b9975cfe0497f60b584bc303866e06c"),
    "independent_post_effect":(R2D/"revue-fermeture-relais-r2d/post-effet/REVUE-POST-EFFET-CONSERVATION-ABSENCE.json", "8d2d5aa7929e66c2599c6f33e51530241467a159f79df0cd953bb4272ce58483")}

def save(path, value):
    with Path(path).open("x", encoding="utf8", newline="\n") as stream:
        json.dump(value, stream, indent=2)
        stream.write("\n")

def static_refs(io):
    pinned = {}
    def ref(path, checksum=None):
        path = Path(path)
        content = io["raw"](path)
        actual = hashlib.sha256(content).hexdigest()
        need(checksum is None or actual == checksum, "Static received path/SHA changed: " + path.name)
        result = {"path":str(path),"sha256":actual}
        pinned[str(path)] = actual
        return result
    def read(path):
        return io["decode"](io["raw"](path))
    ref(CHAIN/"COMPONENTS.json", COMPONENTS_SHA)
    components = read(CHAIN/"COMPONENTS.json")
    need(len(components["code_pins"]) == 62, "Exact qualified62 required")
    for name, checksum in components["code_pins"].items():
        ref(CHAIN/name, checksum)
    integration = PREP/"adaptateurs-source110-r1/revue-integration-source110-parent-r1/revision-r2-OBS4-reel/REVUE-INTEGRATION-SOURCE110-OBS4-REELLE.json"
    producer = PREP/"adaptateurs-source110-r1/revue-integration-source110-parent-r1/revue-projection-locale-r1/REVUE-PRODUCTEUR-PROJECTION-LOCALE-SOURCE110.json"
    source_pins = read(CHAIN/"launcher/pins-source-plan.json")
    science = BASE/"outputs/HPC-Forest-Harnais-Comparaison-r1/receptions/source-only-sol-max-751592/reception-verifiee.json"
    common = {name:None for name in sorted(ns["COMMON"])}
    common.update(
        real_qualification_reception=ref(PREP/"qualification-allouee-source110-G-recu-r1/RECEPTION-MECANIQUE-SOURCE110-VERIFIEE.json"),
        factory_review=ref(integration,INTEGRATION_SHA), reader_integration_review=ref(integration,INTEGRATION_SHA),
        local_projection_producer_review=ref(producer,PRODUCER_SHA),
        r2_main_closure=ref(source_pins["real_r2_main_closure"]["path"],source_pins["real_r2_main_closure"]["sha256"]),
        latest_native_generation_closure=ref(source_pins["latest_native_generation_closure"]["path"],source_pins["latest_native_generation_closure"]["sha256"]),
        source_state_binding=ref(HERE/"SOURCE-STATE-BINDING-REEL-CODE-SEULEMENT.json"),
        scientific_reception=ref(science,"6cd1f532e43bf4fae443bc58e38527847df6cb03511fa84a8d233199db1b41e7"),
        reconciliation=ref(science.parent/"reconciliation-livraisons-r1/RECONCILIATION-LIVRAISONS.json","0ed5c437d3737ec9a970a4183b3e80ce996e87a7f655e5fba9965a979682def8"))
    q = read(common["real_qualification_reception"]["path"])
    need(q.get("schema") == "hpc-forest-dynamic-r4b-mechanical-reception-v1" and q.get("verified") is True
         and q.get("source_zip_sha256") == ns["SOURCE"] and q.get("plan_sha256") == ns["PLAN"]
         and all(q.get(k) is True for k in ("source_files_exact","privacy_neutral_tests_passed","target_profile_verified","reference_contracts_reviewed")), "Actual source110 composite Q differs")
    producer_value = read(producer)
    need(producer_value.get("verified") is True and producer_value.get("blocking_findings") == []
         and producer_value.get("producer_sha256") == components["code_pins"]["lane_projection.py"]
         and producer_value.get("design_sha256") == components["code_pins"]["LANE-SCHEMA-HISTORIQUE.json"]
         and producer_value.get("source_state_reader_sha256") == "564398d676dceb6b5ba893fcbb3835c7aec31a1cbd5d5c5dcef6b361a3a23338", "Exact independent projection producer review required")
    binding = read(common["source_state_binding"]["path"])
    need(set(binding) == {"schema","revision","reader","current_verifier","independent_review"}
         and binding["schema"] == "hpc-forest-lane-r2-source-state-binding-v2", "Exact source-state code binding required")
    for name in ("reader","current_verifier","independent_review"):
        ref(binding[name]["path"],binding[name]["sha256"])
    historical = BASE/"outputs/HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r2/operations-parent-lane-close-20261018T0542"
    ref(historical/"cim-complet-0628.json","111e3e09d9cb14b7aca3e5859b971cd2d543610bc5b5e93bfbbf888ea4b3c1a5")
    ref(historical/"reception-sortie-naturelle/RECEPTION-COLD-METADONNEES.json","6a0b0c2e9e2562daeb6837f517d75fc360fa5f3696bab6bf0274dc0c02d67838")
    latest_r2d = {key:ref(path,checksum) for key,(path,checksum) in R2D_CLOSURE.items()}
    checks = read(HERE/"QUALIFIED-CHECKS-QUATRE-RECUS-REELS.json")
    need(checks.get("verified_received_checks_only") is True and len(checks.get("existing_qualified_files",[])) == 4, "Four real remote/local checks required")
    ref(HERE/"QUALIFIED-CHECKS-QUATRE-RECUS-REELS.json")
    script_refs = {}
    for model,(slug,session) in ns["ROOTS"].items():
        path = OPS/slug/"SCRIPT-REEL-RELU-VERIFIE.json"
        value = read(path)
        need(value.get("schema") == "hpc-forest-dynamic-r4b-scheduler-script-readback-v1" and value.get("verified") is True
             and value.get("exact_script_command_verified") is True and value.get("model") == model
             and value.get("phase") == "roots" and value.get("session_id") == session, "Actual exact root script readback required")
        script_refs[model] = ref(path)
        for item in value["evidence_refs"]:
            ref(item["path"],item["sha256"])
    return common,script_refs,latest_r2d,pinned

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check-static",action="store_true")
    parser.add_argument("--model",choices=tuple(ns["ROOTS"]))
    parser.add_argument("--job")
    # Each path must be paired with an actual checksum; no implicit current fact.
    names = ("marker","request","full-cim","fresh-oauth","transport","obs-admission","submission-intent",
             "submission-observed","cli-policy","so-absence","descendant-review","observer-release",
             "reviewed-controls","capacity","classification-native")
    for name in names:
        parser.add_argument("--"+name,type=Path)
        parser.add_argument("--"+name+"-sha256")
    parser.add_argument("--codex-config-sha256")
    parser.add_argument("--output-directory",type=Path)
    parser.add_argument("--report",type=Path)
    args = parser.parse_args()
    io = ns["held_reads"]()
    common,scripts,latest_r2d,pins = static_refs(io)
    if args.check_static:
        need(not any((args.model,args.job,args.output_directory)), "Static check cannot be an operational assembly")
        report = {"schema":"hpc-forest-source110-roots-static-readiness-v1","static_closed_refs_verified":True,
            "qualified_components":62,"source_files":110,"scripts_received":3,"shared_remote_local_checks_received":4,
            "source_only_cold_bridge_received":True,"future_observations_or_jobs_fabricated":False,
            "dynamic_common_required":[k for k,v in common.items() if v is None],
            "dynamic_per_cell_required":list(names),"job_ids":None,"native_generation_admitted":False,
            "only_named_cold_files_read":True,"process_RPC_CLI_auth_or_cache_effects":0,
            "static_common":common,"script_refs":scripts,"latest_R2d_closure":latest_r2d,
            "checked_refs":[{"path":path,"sha256":checksum} for path,checksum in sorted(pins.items())]}
        if args.report:
            output = io["ordinary"](args.report)
            need(output.parent == HERE and not output.exists(), "New direct static report only")
            save(output,report)
        print(json.dumps({k:report[k] for k in ("static_closed_refs_verified","qualified_components","scripts_received","shared_remote_local_checks_received","job_ids","native_generation_admitted")}))
        return
    need(args.model and args.job and args.output_directory and args.codex_config_sha256, "Exact actual model/job/configSHA/new output required")
    cell = ns["cell_binding"](args.model,args.job)
    actual = {}
    values = {}
    for name in names:
        attr = name.replace("-","_")
        path,checksum = getattr(args,attr),getattr(args,attr+"_sha256")
        need(path and checksum, "Missing actual paired input: "+name)
        content = io["raw"](path)
        need(hashlib.sha256(content).hexdigest() == checksum, "Actual observation SHA differs: "+name)
        actual[attr] = {"path":str(path),"sha256":checksum}
        values[attr] = io["decode"](content)
        pins[str(path)] = checksum
    controls = values["reviewed_controls"]
    ns["bind"](controls,cell)
    need(controls.get("schema") == "hpc-forest-source110-parent-controls-reviewed-v1" and controls.get("verified") is True
         and all(controls.get(k) is True for k in ns["OBS_FLAGS"])
         and controls.get("full_cim") == actual["full_cim"]
         and isinstance(controls.get("evidence_refs"),list) and controls["evidence_refs"],
         "Actual root-reviewed nine controls required; no boolean is inferred from a template")
    ns["age"](controls["observed_at"],time.time())
    capacity = values["capacity"]
    need(capacity.get("schema") == "hpc-forest-r4b-parent-pre-submit-capacity-v1" and capacity.get("verified") is True
         and capacity.get("scope_id") == ns["SCOPE"] and capacity.get("source_zip_sha256") == ns["SOURCE"]
         and capacity.get("plan_sha256") == ns["PLAN"] and type(capacity.get("active_native_workers")) is int
         and capacity.get("private_native_classification") == actual["classification_native"],
         "Actual capacity must bind its separate private classification")
    classified = values["classification_native"]
    need(classified.get("schema") == "hpc-forest-source110-private-native-capacity-classification-v1"
         and classified.get("verified") is True and classified.get("scope_id") == ns["SCOPE"]
         and classified.get("source_zip_sha256") == ns["SOURCE"] and classified.get("plan_sha256") == ns["PLAN"]
         and classified.get("all_full_census_rows_checked") is True
         and classified.get("conservative_candidate_process_ids") == [] and classified.get("unclassified_native_process_ids") == []
         and classified.get("active_native_groups") == [] and type(classified.get("active_native_workers")) is int
         and classified["active_native_workers"] == capacity["active_native_workers"] == 0,
         "Explicit received zero native groups required; no group or identity is guessed")
    common.update(oauth_observation=actual["fresh_oauth"],fresh_private_full_cim=actual["full_cim"],
        codex_config={"path":str(Path("C:/Users/nicol/.codex/config.toml")),"sha256":args.codex_config_sha256},
        source_only_absence=actual["so_absence"],owned_descendant_review=actual["descendant_review"],observer_release=actual["observer_release"])
    output = io["ordinary"](args.output_directory)
    need(output.parent == HERE and not output.exists(), "New direct metadata output directory required")
    # Stage no positive file until every supplied evidence reference has matched.
    evidence_refs = list(controls["evidence_refs"])+list(actual.values())+list(latest_r2d.values())
    for item in evidence_refs:
        need(isinstance(item,dict) and set(item) == {"path","sha256"}, "Closed actual evidence reference required")
        if Path(item["path"]) == Path("C:/Users/nicol/.codex/config.toml"):
            need(item["sha256"] == args.codex_config_sha256,"Opaque config ref differs")
            continue
        need(hashlib.sha256(io["raw"](item["path"])).hexdigest() == item["sha256"],"Actual controls evidence changed")
    for path,checksum in pins.items():
        need(hashlib.sha256(io["raw"](path)).hexdigest() == checksum,"Named input changed during local preparation")
    output.mkdir()
    observed_path = output/"parent-observations-reelles.json"
    observed = {"schema":"hpc-forest-dynamic-r4b-parent-observations-v1","verified":True,**cell,
        "observed_at":controls["observed_at"],**{k:controls[k] for k in ns["OBS_FLAGS"]},
        "fresh_private_full_cim":actual["full_cim"],"allocation_marker":actual["marker"],"request_prepared":actual["request"],
        "r2_main_closure":common["r2_main_closure"],"mixed_observer_admission":actual["obs_admission"],
        "latest_R2d_closure":latest_r2d,
        "proposed_cache":str(PREP/"lancement-modeles-max-r3"/("worker-"+cell["session_id"])),
        "evidence_refs":evidence_refs,"root_reviewed_controls_copied_without_inference":True}
    save(observed_path,observed)
    def output_ref(path):
        return {"path":str(path),"sha256":hashlib.sha256(io["raw"](path)).hexdigest()}
    supplied = {"model":args.model,"job_id":args.job,"allocation_marker":actual["marker"],"request_prepared":actual["request"],
        "submission_intent":actual["submission_intent"],"submission_observed":actual["submission_observed"],"script_reread":scripts[args.model],
        "parent_observations":output_ref(observed_path),"mixed_observer_admission":actual["obs_admission"],
        "transport_probe_readback":actual["transport"],"cli_policy":actual["cli_policy"]}
    bundle = {"schema":"hpc-forest-source110-roots-operational-input-bundle-v1","verified_parent_observations":True,
        "common":common,"active_native_groups":classified["active_native_groups"],"cells":[supplied]}
    bundle_path = output/"bundle-une-racine-reel.json"
    save(bundle_path,bundle)
    # The checked bundle adapter performs the full shallow input validation;
    # factory remains a separate explicit parent-only command afterwards.
    old_argv = sys.argv
    try:
        sys.argv = [str(MODULE),"--actual-bundle",str(bundle_path),"--actual-bundle-sha256",output_ref(bundle_path)["sha256"],
                    "--one-model",args.model,"--output-directory",str(HERE/(output.name+"-factory-input"))]
        ns["main"]()
    finally:
        sys.argv = old_argv

if __name__ == "__main__":
    main()

wer_row = grid[i+1];\\n+            double * restrict next_row = new_grid[i];\\n+            int row_has_error = 0;\\n+\\n+            // Rows are separately allocated; only the integer flag is reduced.\\n+            #pragma omp simd reduction(|:row_has_error)\\n             for(int j = 1; j < size-1; j++) {\\n+                double next_value = 0.25 * (current_row[j+1] + current_row[j-1] +\\n+                                            upper_row[j] + lower_row[j]);\\n+                next_row[j] = next_value;\\n \\n-                new_grid[i][j] = 0.25 * (grid[i][j+1] + grid[i][j-1] +\\n-                                         grid[i-1][j] + grid[i+1][j]);\\n-\\n-                double errorCurrent = absolute(new_grid[i][j] - grid[i][j]);\\n-                if(errorCurrent > CONV_THRESHOLD ){\\n-                    hasError = 1;                                        \\n-                }     \\n-            }\\n-        }            \\n-        // copie the next values into the working array for the next iteration\\n-        for( int i = 1; i < size-1; i++) {\\n-            for( int j = 1; j < size-1; j++) {\\n-                grid[i][j] = new_grid[i][j];\\n+                double errorCurrent = absolute(next_value - current_row[j]);\\n+                row_has_error |= (errorCurrent > CONV_THRESHOLD);\\n             }\\n-        }        \\n+            hasError |= row_has_error;\\n+        }\\n+        // Exchange buffers only after the complete synchronous Jacobi sweep.\\n+        double **previous_grid = grid;\\n+        grid = new_grid;\\n+        new_grid = previous_grid;\\n         iter++;\\n     }\"}, {\"id\": \"d7b4571e0df2447f\", \"role\": \"A\", \"commit\": \"6683d141dcbbffc7efbc8bd74850a8655bbd4689\", \"transformations\": {\"files\": [\"src/laplace_seq.c\"], \"retained\": [\"Allocate one contiguous backing block per matrix while retaining row-pointer access.\", \"Initialize both buffers identically to preserve fixed boundaries across swaps.\", \"Rep
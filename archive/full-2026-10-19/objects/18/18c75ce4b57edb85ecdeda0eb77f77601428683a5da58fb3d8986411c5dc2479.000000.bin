nto the original grid.\", \"Track convergence separately for both steps, selecting the intermediate grid if the first step converges; handle an unpaired final step with a pointer swap.\", \"Use a restrict-qualified row kernel with an integer OR convergence reduction.\"]}, \"mean_seconds\": 0.057083897603054844, \"diff\": \"diff --git a/src/laplace_seq.c b/src/laplace_seq.c\\nindex 439dbbb..4ba1bb3 100644\\n--- a/src/laplace_seq.c\\n+++ b/src/laplace_seq.c\\n@@ -1,7 +1,7 @@\\n /*\\n     This program solves Laplace's equation on a regular 2D grid using simple Jacobi iteration.\\n \\n-    The stencil calculation stops when  ( err >= CONV_THRESHOLD OR  iter > ITER_MAX )\\n+    The stencil calculation stops at convergence or the iteration limit.\\n */\\n #include <stdio.h>\\n #include <stdlib.h>\\n@@ -16,6 +16,9 @@ double **grid;\\n // auxiliary matrix\\n double **new_grid;\\n \\n+static double *grid_storage;\\n+static double *new_grid_storage;\\n+\\n // size of each side of the grid\\n int size;\\n int iter_max_num;\\n@@ -27,15 +30,17 @@ double absolute(double num){\\n     return num;\\n }\\n \\n-\\n-// allocate memory for the grid\\n+// allocate contiguous storage with row-pointer views\\n void allocate_memory(){\\n-    grid = (double **) malloc(size * sizeof(double *));\\n-    new_grid = (double **) malloc(size * sizeof(double *));\\n+    size_t n = (size_t)size;\\n+    grid = (double **) malloc(n * sizeof(double *));\\n+    new_grid = (double **) malloc(n * sizeof(double *));\\n+    grid_storage = (double *) malloc(n * n * sizeof(double));\\n+    new_grid_storage = (double *) malloc(n * n * sizeof(double));\\n \\n     for(int i = 0; i < size; i++){\\n-        grid[i] = (double *) malloc(size * sizeof(double));\\n-        new_grid[i] = (double *) malloc(size * sizeof(double));\\n+        grid[i] = grid_storage + (size_t)i * n;\\n+        new_grid[i] = new_grid_storage + (size_t)i * n;\\n     }\\n }\\n \\n@@ -51,14 +56,14 @@ void initialize_grid(){\\n                 grid[i][j] = 100;\\n             else\\n                 grid[i][j] = 0;\\n-            new_grid[i][j] = 0.0;\\n+            // Both time levels must retain the original fixed boundaries.\\n+            new_grid[i][j] = grid[i][j];\\n         }\\n     }\\n }\\n \\n // save the grid in a file\\n void save_grid(){\\n-\\n     for(int i = 0; i < size; i++){\\n         for(int j = 0; j < size; j++){\\n             fprintf(stdout, \\\"%lf \\\", grid[i][j]);\\n@@ -67,66 +72,86 @@ void save_grid(){\\n     }\\n }\\n \\n-int main(int argc, char *argv[]){\\n+static inline int update_row(double *restrict destination,\\n+                             const double *restrict above,\\n+                             const double *restrict current,\\n+                             const double *restrict below){\\n+    int changed = 0;\\n+    for(int j = 1; j < size - 1; j++){\\n+        double value = 0.25 * (current[j+1] + current[j-1] +\\n+                               above[j] + below[j]);\\n+        destination[j] = value;\\n+        double errorCurrent = absolute(value - current[j]);\\n+        changed |= (errorCurrent > CONV_THRESHOLD);\\n+    }\\n+    return changed;\\n+}\\n \\n+int main(int argc, char *argv[]){\\n     fscanf(stdin, \\\"%d\\\", &size);\\n     fscanf(stdin, \\\"%d\\\", &iter_max_num);\\n-    \\n+\\n     int hasError = 1;\\n     int iter = 0;\\n \\n-    struct timeval time_start;\\n-    struct timeval time_end;\\n-\\n     // allocate memory to the grid (matrix)\\n     allocate_memory();\\n \\n     // set grid initial conditions\\n     initialize_grid();\\n \\n-    //printf(\\\"Jacobi relaxation calculation: %d x %d grid\\\\n\\\", size, size);\\n-\\n-    // get the start time\\n-    //gettimeofday(&time_start, NULL);\\n-\\n-    // Jacobi iteration\\n-    // This loop will end if either the maximum change reaches below a set threshold (convergence)\\n-    // or a fixed number of maximum iterations have completed\\n-    while ( hasError && iter < iter_max_num ) {\\n-\
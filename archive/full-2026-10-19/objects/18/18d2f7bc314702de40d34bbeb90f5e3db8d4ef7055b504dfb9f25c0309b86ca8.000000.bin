        "content": "/*\n  Quicksort\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <limits.h>\n#include <openssl/md5.h>\n\n#define MY_RAND_MAX 0x7FFFFFFF\n#define RANDNUM_W 521288629\n#define RANDNUM_Z 362436069\n#define INSERTION_SORT_LIMIT 24\n#define PARALLEL_SORT_LIMIT 262144\n#define TASK_SORT_LIMIT 32768\n\nvoid srandnum(int seed);\ndouble randnum(void);\nint *generate_case(int N);\ndouble drand(int xmin, int xmax);\nvoid swap(int *toorder, int i, int j);\nvoid quicksort(int *toorder, int N);\nint is_sorted(int *toorder, int N);\n\nstatic int sort_depth_limit(int length);\nstatic void insertion_sort(int *toorder, int lo, int hi);\nstatic int median_of_three(const int *toorder, int lo, int hi);\nstatic void partition_three_way(int *toorder, int lo, int hi, int pivot,\n                                int *equal_lo, int *equal_hi);\nstatic void sift_down(int *toorder, int base, int root, int count);\nstatic void heapsort_range(int *toorder, int lo, int hi);\nstatic void _introsort(int *toorder, int lo, int hi, int depth_limit);\n#ifdef _OPENMP\nstatic void _parallel_introsort(int *toorder, int lo, int hi, int depth_limit);\n#endif\n\nunsigned int randum_w = RANDNUM_W;\nunsigned int randum_z = RANDNUM_Z;\n\nvoid srandnum(int seed)\n{\n    unsigned int w, z;\n    w = (seed * 104623) & 0xffffffff;\n    randum_w = (w) ? w : RANDNUM_W;\n    z = (seed * 48947) & 0xffffffff;\n    randum_z = (z) ? z : RANDNUM_Z;\n}\n\ndouble randnum(void)\n{\n    unsigned int u;\n    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);\n    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);\n    u = (randum_z << 16) + randum_w;\n    return (abs(u));\n}\n\nint main(int argc, char *argv[])\n{\n    int N = 0;\n    int *our_list = NULL;\n\n    //The input provides the case size\n    scanf(\"%d\", &N);\n    if (N <= 0) {\n        printf(\"Error: please, provide the case size.\\n\");\n        return 1;\n    }\n\n    //Generate the case\n    our_list = generate_case(N);\n    if (our_list == NULL) {\n        printf(\"Error: case instantiation failed.\\n\");\n        return 1;\n    }\n\n    //Do the thing\n    quicksort(our_list, N);\n\n    if (is_sorted(our_list, N) == 1) {\n        printf(\"Error, for some reason list is still unsorted.\\n\");\n        return 1;\n    }\n\n#ifdef COMPUTE_MD5_PROBLEM\n    //Compute MD5 Checksum for problem identification\n    MD5_CTX c;\n    unsigned char out[MD5_DIGEST_LENGTH];\n    MD5_Init(&c);\n    MD5_Update(&c, our_list, N * sizeof(int));\n    MD5_Final(out, &c);\n    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {\n        printf(\"%02x\", out[n]);\n    }\n#endif\n    printf(\"\\n\");\n\n    //Clean up\n    free(our_list);\n\n    return 0;\n}\n\n/*\n * Public API\n */\nvoid quicksort(int *toorder, int N)\n{\n    if (N <= 1)\n        return;\n\n#ifdef _OPENMP\n    if (N >= PARALLEL_SORT_LIMIT) {\n        int depth_limit = sort_depth_limit(N);\n#pragma omp parallel\n        {\n#pragma omp single nowait\n            {\n                _parallel_introsort(toorder, 0, N - 1, depth_limit);\n            }\n        }\n        return;\n    }\n#endif\n    _introsort(toorder, 0, N - 1, sort_depth_limit(N));\n}\n\nstatic int sort_depth_limit(int length)\n{\n    int depth = 0;\n    while (length > 1) {\n        length >>= 1;\n        depth++;\n    }\n    return 2 * depth;\n}\n\nstatic void insertion_sort(int *toorder, int lo, int hi)\n{\n    for (int i = lo + 1; i <= hi; i++) {\n        int value = toorder[i];\n        int j = i;\n        while (j > lo && toorder[j - 1] > value) {\n            toorder[j] = toorder[j - 1];\n            j--;\n        }\n        toorder[j] = value;\n    }\n}\n\nstatic int median_of_three(const int *toorder, int lo, int hi)\n{\n    int mid = lo + (hi - lo) / 2;\n    int a = toorder[lo];\n    int b = toorder[mid];\n    int c = toorder[hi];\n\n    if (a < b) {\n        if (b < c)\n            return b;\n        return (a < c) ? c : a;\n    }\n    if (a < c)\n        return a;\n    return (b < c) ? c : b;\n}\n\nstatic void partition_three_way(int *toorder, int lo, int hi, int pivot,\n                                int *equal_lo, int *equal_hi)\n{\n    int lt = lo;\n    int i = lo;\n    int gt = hi;\n\n    while (i <= gt) {\n        if (toorder[i] < pivot) {\n            swap(toorder, lt, i);\n            lt++;\n            i++;\n        } else if (toorder[i] > pivot) {\n            swap(toorder, i, gt);\n            gt--;\n        } else {\n            i++;\n        }\n    }\n    *equal_lo = lt;\n    *equal_hi = gt;\n}\n\nstatic void sift_down(int *toorder, int base, int root, int count)\n{\n    while (root < count / 2) {\n        int child = root * 2 + 1;\n        if (child + 1 < count && toorder[base + child] < toorder[base + child + 1])\n            child++;\n        if (toorder[base + root] >= toorder[base + child])\n            return;\n        swap(toorder, base + root, base + child);\n        root = child;\n    }\n}\n\nstatic void heapsort_range(int *toorder, int lo, int hi)\n{\n    int count = hi - lo + 1;\n    for (int start = count / 2; start > 0; start--)\n        sift_down(toorder, lo, start - 1, count);\n    for (int end = count; end > 1; end--) {\n        swap(toorder, lo, lo + end - 1);\n        sift_down(toorder, lo, 0, end - 1);\n    }\n}\n\nstatic void _introsort(int *toorder, int lo, int hi, int depth_limit)\n{\n    while (lo < hi) {\n        int length = hi - lo + 1;\n        if (length <= INSERTION_SORT_LIMIT) {\n            insertion_sort(toorder, lo, hi);\n            return;\n        }\n        if (depth_limit <= 0) {\n            heapsort_range(toorder, lo, hi);\n            return;\n        }\n\n        depth_limit--;\n        int equal_lo, equal_hi;\n        int pivot = median_of_three(toorder, lo, hi);\n        partition_three_way(toorder, lo, hi, pivot, &equal_lo, &equal_hi);\n\n        if (equal_lo - lo < hi - equal_hi) {\n            _introsort(toorder, lo, equal_lo - 1, depth_limit);\n            lo = equal_hi + 1;\n        } else {\n            _introsort(toorder, equal_hi + 1, hi, depth_limit);\n            hi = equal_lo - 1;\n        }\n    }\n}\n\n#ifdef _OPENMP\nstatic void _parallel_introsort(int *toorder, int lo, int hi, int depth_limit)\n{\n    if (lo >= hi)\n        return;\n\n    int length = hi - lo + 1;\n    if (length <= TASK_SORT_LIMIT) {\n        _introsort(toorder, lo, hi, depth_limit);\n        return;\n    }\n    if (depth_limit <= 0) {\n        heapsort_range(toorder, lo, hi);\n        return;\n    }\n\n    int next_depth = depth_limit - 1;\n    int equal_lo, equal_hi;\n    int pivot = median_of_three(toorder, lo, hi);\n    partition_three_way(toorder, lo, hi, pivot, &equal_lo, &equal_hi);\n\n    int left_lo = lo;\n    int left_hi = equal_lo - 1;\n    int left_size = equal_lo - lo;\n    int right_lo = equal_hi + 1;\n    int right_hi = hi;\n    int right_size = hi - equal_hi;\n\n    if (left_size > TASK_SORT_LIMIT) {\n#pragma omp task firstprivate(toorder, left_lo, left_hi, next_depth)\n        {\n            _parallel_introsort(toorder, left_lo, left_hi, next_depth);\n        }\n    } else {\n        _introsort(toorder, left_lo, left_hi, next_depth);\n    }\n\n    if (right_size > TASK_SORT_LIMIT) {\n#pragma omp task firstprivate(toorder, right_lo, right_hi, next_depth)\n        {\n            _parallel_introsort(toorder, right_lo, right_hi, next_depth);\n        }\n    } else {\n        _introsort(toorder, right_lo, right_hi, next_depth);\n    }\n}\n#endif\n\n/*\n * Swap two values.\n */\nvoid swap(int *toorder, int i, int j)\n{\n    int temp = toorder[i];\n    toorder[i] = toorder[j];\n    toorder[j] = temp;\n}\n\n/*\n * Check if elements are in non-decreasing order\n */\nint is_sorted(int *toorder, int N)\n{\n    for (int i = 1; i < N; i++) {\n        if (toorder[i] < toorder[i - 1]) {\n            return 1;\n        }\n    }\n    return 0;\n}\n\n/*\n * Generate a case\n */\nint *generate_case(int N)\n{\n    int i;\n    int *ret = NULL;\n\n    // Make case generation reproducible\n    srandnum(0);\n\n    // Allocate memory\n    ret = (int *) malloc(N * sizeof(int));\n    if (ret == NULL) {\n        printf(\"Error: some malloc won't work.\\n\");\n        return NULL;\n    }\n    // Get pseudo-random positive integer values\n    for (i = 0; i < N; i++) {\n        ret[i] = drand(0, INT_MAX);\n    }\n    return ret;\n}\n\n/*\n * A pseudo-random number between two positive integer values\n */\ndouble drand(int xmin, int xmax)\n{\n    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;\n}\n",

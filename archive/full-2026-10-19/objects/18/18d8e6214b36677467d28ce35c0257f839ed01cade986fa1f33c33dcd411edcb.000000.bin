"""Package only the orchestration layer and untouched official source archives."""
import hashlib
import json
import shutil
import tarfile
from pathlib import Path

HERE=Path(__file__).resolve().parent
WORKSPACE=HERE.parents[1]
payload=HERE/"payload"
payload.mkdir(exist_ok=False)
for name in ["contract_tool.py","neutral_backend.py","romeo_marathon.py"]:
    shutil.copyfile(HERE/name,payload/name)
base=(WORKSPACE/"work/romeo-long/payload/romeo_long_tree.py").read_text(encoding="utf-8")
start=base.index("def config_for(")
end=base.index("def tree_snapshot(",start)
base=base[:start]+base[end:]
start=base.index("def campaign(")
end=base.index("def main(",start)
base=base[:start]+base[end:]
base=base.replace('"hpc-forest-romeo-long-v1"','"hpc-forest-marathon22-autonomous-v1"').replace('"models": [],','"problems": [],').replace('overall["models"]','overall["problems"]').replace(':cpu-matmul"',':cpu-marathon22"').replace('OLLAMA_CONTEXT_LENGTH="16384"','OLLAMA_CONTEXT_LENGTH="32768"')
(payload/"romeo_base.py").write_text(base,encoding="utf-8")
shutil.copyfile(WORKSPACE/"work/romeo-long/payload/detect_resources.py",payload/"detect_resources.py")
shutil.copytree(WORKSPACE/"outputs/Marathon22-autonome/sources-officielles",payload/"sources-officielles")
shutil.copyfile(WORKSPACE/"outputs/Marathon22-autonome/source-manifest.json",payload/"official-source-manifest.json")
wheel=WORKSPACE/"work/romeo/dist-r4/hpc_forest-0.1.0-py3-none-any.whl"
(payload/"payload-r4").mkdir()
shutil.copyfile(wheel,payload/"payload-r4"/wheel.name)
policy={"request":"The tree tries all four official problems with minimum assistant help.",
    "assistant_interventions":["Download and hash original material","Supply generic build/run/output comparator and resource limits","Connect existing AB-MCTS to the official sources and local model","Archive automatic measurements and failures"],
    "model_owned":["Compilation/input/output contract","All test input content and fixture generators","All candidate source modifications","Choice of transformations and integration"],
    "manual_algorithm_advice":False,"manual_candidate_repairs":False,"published_solution_search":False,
    "evaluation":"Internal checks against unmodified official reference, not the official contest judge.",
    "budgets_per_problem":{"preparation_model_calls":3,"candidate_model_calls":24,"search_wall_seconds":900,"max_tree_depth":6},
    "unchanged_core":"Tested wheel dbd7c504d70db392ebb615a6900c2ca848a944d87fb0bbc7c031b70b97eea0a1; TreeQuest AB-MCTS-A 0.3.2",
    "adapter_changes":["Remove matrix-specific F document and params.h hint","Pass original statements and raw automatic diagnostics","Separate model-owned R contract preparation before frozen validation"]}
(payload/"assistance-protocol.json").write_text(json.dumps(policy,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
manifest={p.relative_to(payload).as_posix():hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(payload.rglob("*")) if p.is_file()}
(payload/"payload-manifest.json").write_text(json.dumps(manifest,indent=2)+"\n",encoding="utf-8")
archive=HERE/"marathon22-payload-r1.tar.gz"
with tarfile.open(archive,"w:gz") as t:
    t.add(payload,arcname="hpc-forest-marathon22-20261015-r1")
print(json.dumps({"archive":str(archive),"bytes":archive.stat().st_size,"sha256":hashlib.sha256(archive.read_bytes()).hexdigest(),"files":len(manifest)}))

"""Seal prepared cold-reader metadata only, with no production input."""
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent


def ref(path):
    raw = path.read_bytes()
    return {'path': str(path.resolve()), 'sha256': hashlib.sha256(raw).hexdigest(), 'bytes': len(raw)}


def save(name, value):
    with (HERE / name).open('x', encoding='utf8', newline='\n') as stream:
        stream.write(json.dumps(value, ensure_ascii=False, indent=2) + '\n')


def main():
    names = ['reception_bornee.py', 'audit_prive.py', 'controler-reception-bornee.py',
             'collecter-frontiere.py', 'preparer-contexte.py', 'deriver-lecteur-froid.py',
             'test_delta_lecteur_r2f.py', 'DIFF-FERME.json', 'REPRISE.md', 'tests-delta.xml']
    save('MANIFESTE-LECTEUR.json', {'schema': 'hpc-forest-r2f-cold-first-batch-reader-manifest-v1',
        'files': {name: ref(HERE / name) for name in names},
        'prepared_only': True, 'actual_receipt_created': False, 'native_research_admitted': False})
    save('LIVRAISON-LECTEUR-PREMIER-BATCH.json', {
        'schema': 'hpc-forest-r2f-cold-first-batch-reader-prepared-delivery-v1',
        'scope_id': 'hpc-forest-primes-native-max-r2f', 'source_members': 109,
        'source_zip_sha256': '47f97afabcd6d10c5e95a1dc3aae0a34b0841183919785a6bd62d58aa1e90d75',
        'plan_sha256': '8d91ebe83ab550ad50acc330f830e1bc86bcc67f66b88054538df6b394558450',
        'manifest': ref(HERE / 'MANIFESTE-LECTEUR.json'), 'closed_delta': ref(HERE / 'DIFF-FERME.json'),
        'inert_delta_cases': 11, 'inert_delta_result': ref(HERE / 'tests-delta.xml'),
        'pytest_fixture_deprecation_warning_preserved': True, 'ruff_passed': True,
        'old_scientific_tests_not_replayed': True, 'private_auditor_byte_identical': True,
        'all_scientific_helper_and_collector_function_ASTs_unchanged': True,
        'mechanical_r2e_wire_schemas_preserved': True,
        'prepared_only': True, 'actual_first_batch_or_authentication_received': False,
        'native_research_admitted': False, 'performance_or_RAW_admitted': False,
        'remote_release_published': False, 'any_CLI_model_process_transport_effect': False})
    print(json.dumps(ref(HERE / 'LIVRAISON-LECTEUR-PREMIER-BATCH.json')))


if __name__ == '__main__':
    main()

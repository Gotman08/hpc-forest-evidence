def read(path,expected=None):
    p=Path(path);need(p.is_absolute() and p.is_relative_to(BASE) and '..' not in p.parts,'Cold boundary')
    need(p!=KNOWN and not p.is_relative_to(KNOWN),'No INERT directory/child access')
    need(p.name.rstrip(' .').casefold() not in {'observer-state.json','observer.lock','worker.lock','stdout.log','stderr.log'},'No live state/log/lock input')
    raw=ns['raw'](p);need(expected is None or sha(raw)==expected,'Cold SHA mismatch '+str(p))
    record={'path':str(p),'sha256':sha(raw),'bytes':len(raw),'metadata':list(ns['metadata'](p.lstat()))}
    need(str(p) not in before or before[str(p)]==record,'Input changed during review')
    before[str(p)]=record;return raw
def doc(path,expected=None):return json.loads(read(path,expected))
def pinned(ref):return doc(ref['path'],ref['sha256'])
def ref(path):return {'path':str(path),'sha256':sha(read(path))}
def ticks(text):
    need(isinstance(text,str),'UTC date text')
    match=re.fullmatch(r'(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.(\d{1,7}))?(?:Z|\+00:00)',text)
    need(match is not None,'Exact UTC date')
    dt=datetime.fromisoformat(match[1]).replace(tzinfo=UTC)-datetime(1,1,1,tzinfo=UTC)
    return (dt.days*86400+dt.seconds)*10_000_000+int((match[2] or '').ljust(7,'0'))
EPOCH=ticks('1970-01-01T00:00:00Z')
def age(census,when):
    now=ticks(when);a=Decimal(now-EPOCH)/10_000_000-Decimal(str(census['observed_at']));b=Decimal(now-ticks(census['captured_at_utc']))/10_000_000
    need(0<=a<=45 and 0<=b<=45,'Historical captured/observed ages both <=45s')
    return {'at_utc':when,'age_observed_seconds':str(a),'age_captured_seconds':str(b)}
def census_checks(value):
    need(set(value)=={'schema','observed_at','captured_at_utc','complete_census','strict_utf8_decoding','rows_count','rows'},'Closed CIM schema')
    need(value['schema']=='hpc-forest-dynamic-r4b-full-cim-v1' and value['complete_census'] is True and value['strict_utf8_decoding'] is True,'Actual strict complete CIM')
    need(type(value['rows_count']) is int and value['rows_count']==len(value['rows']) and value['rows'],'CIM count')
    ids=set()
    for row in value['rows']:
        need(set(row)==FIELDS and all(type(row[k]) is int and row[k]>=0 for k in ('ProcessId','ParentProcessId')),'Exact CIM rows')
        need(row['ProcessId'] not in ids,'Unique CIM PID');ids.add(row['ProcessId'])
        need(all(row[k] is None or isinstance(row[k],str) for k in ('ExecutablePath','CommandLine','CreationDate')),'CIM metadata types')
        if row['CreationDate'] is not None:need(ticks(row['CreationDate'])<=ticks(value['captured_at_utc']),'Creation/capture chronology')
    candidates=[row['ProcessId'] for row in value['rows'] if 'bootstrap_worker.py' in (row['CommandLine'] or '').casefold() or re.search(r'hpc_forest(?:\.|[/\\])',row['CommandLine'] or '',re.I)]
    opaque=[row['ProcessId'] for row in value['rows'] if Path(row['ExecutablePath'] or '').name.casefold() in {'python.exe','pythonw.exe'} and not row['CommandLine']]
    need(not candidates and not opaque,'Independent conservative native scan/opaque Python refusal')
    return {'rows':len(ids),'conservative_native_candidates':candidates,'opaque_python_rows':opaque}

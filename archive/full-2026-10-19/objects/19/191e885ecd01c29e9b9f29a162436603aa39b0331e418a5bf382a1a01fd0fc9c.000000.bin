        "omp_proc_bind": "close",
        "partition": "instant",
        "redirect_caches": false,
        "reservation": null,
        "target_nodes": "romeo-a[001-058]",
        "time": "00:10:00",
        "total_cpus": 1,
        "total_gpus": 0,
        "workdir": "/scratch_p/nimarano"
      },
      "script": "#!/usr/bin/env bash\n# Genere par romeo-mcp - ne pas editer a la main.\n#SBATCH --job-name=raw-snapshot-751571\n#SBATCH --account=r250127\n#SBATCH --qos=normal\n#SBATCH --partition=instant\n#SBATCH --constraint=armgpu\n#SBATCH --time=00:10:00\n#SBATCH --nodes=1\n#SBATCH --ntasks-per-node=1\n#SBATCH --cpus-per-task=1\n#SBATCH --mem=16G\n#SBATCH --chdir=/scratch_p/nimarano\n#SBATCH --output=/scratch_p/nimarano/%x-%j.out\n#SBATCH --error=/scratch_p/nimarano/%x-%j.err\n\nset -euo pipefail\n\n# Sans cette fonction, un job ROMEO 2025 n'a acces a aucun logiciel,\n# pas meme a la commande spack. Elle est propre a l'architecture :\n# charger celle de l'autre donnerait des binaires inutilisables.\nromeo_load_armgpu_env\n\n# Provenance du premier demarrage : environnement, commit et fichiers choisis.\nif command -v python3 >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then\n  if timeout 20s python3 -I -S - '{\"roots\": [\"/scratch_p/nimarano\", \"/project\"], \"include_home\": true, \"code_dir\": \"/scratch_p/nimarano\", \"data_files\": [], \"max_bytes\": 67108864}' <<'ROMEO_REPRO_CAPTURE'\n\nimport hashlib, json, os, pathlib, re, stat, subprocess, sys\nparams = json.loads(sys.argv[1])\nroots = [pathlib.Path(p).resolve() for p in params['roots']]\nif params.get('include_home'):\n    roots.append(pathlib.Path.home().resolve())\ndef allowed(value):\n    path = pathlib.Path(value).resolve()\n    if not any(path == root or root in path.parents for root in roots):\n        raise ValueError('outside_roots')\n    if any(p.lower().startswith(('.env', 'id_rsa', 'id_ed25519', 'id_ecdsa')) or p.lower() in ('.ssh', '.aws', '.azure', '.kube', 'hosts.yml')\n           or p.lower().endswith(('.pem', '.key', '.p12', '.pfx'))\n           or re.search(r'password|passwd|passphrase|secret|token|credential|authorization|cookie|api[_-]?key|access[_-]?key|private[_-]?key', p, re.I)\n           for p in path.parts):\n        raise ValueError('sensitive_path')\n    return path\nout = {'git': {'status': 'unavailable'}, 'data': []}\ntry:\n    code = allowed(params['code_dir'])\n    result = subprocess.run(['git', '-c', 'core.fsmonitor=false', '-C', str(code),\n                             'rev-parse', '--verify', 'HEAD'],\n                            capture_output=True, text=True, timeout=5,\n                            env={**os.environ, 'GIT_OPTIONAL_LOCKS': '0'})\n    sha = result.stdout.strip()\n    if result.returncode == 0 and len(sha) in (40, 64) and all(c in '0123456789abcdef' for c in sha):\n        out['git'] = {'status': 'observed', 'commit': sha, 'working_tree_verified': False}\nexcept (OSError, ValueError, subprocess.TimeoutExpired):\n    pass\nremaining = params['max_bytes']\nfor name in params['data_files']:\n    item = {'path': name}\n    try:\n        path = allowed(name)\n        info = path.stat()\n        if not stat.S_ISREG(info.st_mode):\n            item['status'] = 'not_regular_file'\n        elif info.st_size > remaining:\n            item.update(status='size_limit', bytes=info.st_size)\n        else:\n            h = hashlib.sha256()\n            consumed = 0\n            with path.open('rb') as stream:\n                while True:\n                    block = stream.read(min(1048576, remaining - consumed + 1))\n                    if not block:\n                        break\n                    consumed += len(block)\n                    if consumed > remaining:\n                        break\n                    h.update(block)\n            after = path.stat()\n            remaining = max(0, remaining - consumed)\n            if consumed != info.st_size or (info.st_size, info.st_mtime_ns, info.st_ino) != (after.st_size, after.st_mtime_ns, after.st_ino):\n                item['status'] = 'changed_during_read'\n            else:\n                item.update(status='hashed', sha256=h.hexdigest(), bytes=consumed)\n    except (OSError, ValueError):\n        item['status'] = 'unreadable_or_outside_roots'\n    out['data'].append(item)\n\n\nimport datetime, platform\nout['observed_at'] = datetime.datetime.now(datetime.timezone.utc).isoformat()\nout['phase'] = 'before_workload'\nout['environment'] = {\n    'source': 'compute_node_before_command', 'architecture': platform.machine(),\n    'python_version': platform.python_version(),\n    'loaded_modules': [v for v in os.environ.get('LOADEDMODULES', '').split(':') if v][:128],\n    'spack_loaded_hashes': [v for v in os.environ.get('SPACK_LOADED_HASHES', '').split(':') if v][:128],\n}\njid = os.environ.get('SLURM_JOB_ID', '')\nif os.environ.get('SLURM_ARRAY_JOB_ID') and os.environ.get('SLURM_ARRAY_TASK_ID'):\n    jid = os.environ['SLURM_ARRAY_JOB_ID'] + '_' + os.environ['SLURM_ARRAY_TASK_ID']\nif not re.fullmatch(r'[0-9]+(?:_[0-9]+)?', jid):\n    raise ValueError('missing_job_id')\nout['job_id'] = jid\nfolder = pathlib.Path('.romeo-provenance')\nfolder.mkdir(mode=0o700, exist_ok=True)\nif folder.is_symlink():\n    raise ValueError('symlink_capture_directory')\nout['restart_count'] = os.environ.get('SLURM_RESTART_COUNT', '0')\ntry:\n    fd = os.open(folder / (jid + '.json'), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)\nexcept FileExistsError:\n    pass\nelse:\n    with os.fdopen(fd, 'w') as stream:\n        json.dump(out, stream)\n        stream.write('\\n')\nROMEO_REPRO_CAPTURE\n  then :; else\n    printf '%s\\n' '[romeo-mcp] provenance indisponible ; le calcul continue.' >&2\n  fi\nfi\n\n\n# Trace d'execution : sert a diagnostiquer les erreurs d'architecture.\necho \"[romeo-mcp] noeud=$(hostname) arch=$(uname -m) job=${SLURM_JOB_ID:-?}\"\necho \"[romeo-mcp] debut $(date -Is)\"\n\nset -euo pipefail\nexport PYTHONDONTWRITEBYTECODE=1\n/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python -B - <<'PY_SNAPSHOT_751571'\n\"\"\"One-shot raw preservation of cancelled results, using Python stdlib only.\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport io\nimport json\nimport os\nimport platform\nimport stat\nimport tarfile\nfrom datetime import UTC, datetime, timedelta\nfrom pathlib import Path\n\nSOURCE = Path(\"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6.1-sol-xhigh/results-751571\")\nARCHIVE_NAME = \"results-751571-interruption-volontaire.tar.gz\"\n\n\ndef require(condition: bool, message: str) -> None:\n    if not condition:\n        raise ValueError(message)\n\n\ndef sha_file(path: Path) -> str:\n    h = hashlib.sha256()\n    with path.open(\"rb\") as source:\n        while block := source.read(1024 * 1024):\n            h.update(block)\n    return h.hexdigest()\n\n\ndef inventory(root: Path) -> dict:\n    result = {}\n    for path in [root, *sorted(root.rglob(\"*\"))]:\n        meta = path.lstat()\n        name = \".\" if path == root else path.relative_to(root).as_posix()\n        row = {\"mode\": stat.S_IMODE(meta.st_mode), \"mtime_ns\": meta.st_mtime_ns}\n        if stat.S_ISREG(meta.st_mode):\n            row.update({\"type\": \"file\", \"bytes\": meta.st_size, \"sha256\": sha_file(path)})\n        elif stat.S_ISDIR(meta.st_mode):\n            row.update({\"type\": \"directory\", \"bytes\": 0, \"sha256\": hashlib.sha256(b\"\").hexdigest()})\n        elif stat.S_ISLNK(meta.st_mode):\n            link = os.readlink(path)\n            raw = os.fsencode(link)\n            row.update({\"type\": \"symlink\", \"bytes\": len(raw), \"sha256\": hashlib.sha256(raw).hexdigest(), \"target\": link})\n        else:\n            raise ValueError(\"unsupported special source entry; preserve and reconcile: \" + name)\n        result[name] = row\n    return result\n\n\ndef verify_archive(path: Path, before: dict, manifest_bytes: bytes, root_name: str) -> dict:\n    observed = {}\n    manifest_seen = 0\n    with tarfile.open(path, \"r:gz\") as archive:\n        for member in archive.getmembers():\n            if member.name == \"SNAPSHOT-MANIFEST.json\":\n                stream = archive.extractfile(member)\n                require(stream is not None and stream.read() == manifest_bytes, \"embedded manifest changed\")\n                manifest_seen += 1\n                continue\n            require(member.name == root_name or member.name.startswith(root_name + \"/\"), \"unexpected archive root\")\n            relative = \".\" if member.name == root_name else member.name[len(root_name) + 1:]\n            require(relative in before and relative not in observed, \"extra/duplicate archive member: \" + relative)\n            expected = before[relative]\n            if expected[\"type\"] == \"directory\":\n                require(member.isdir(), \"directory type changed: \" + relative)\n            elif expected[\"type\"] == \"symlink\":\n                require(member.issym() and member.linkname == expected[\"target\"], \"symlink changed: \" + relative)\n            else:\n                require(member.isfile() or member.islnk(), \"regular file type changed: \" + relative)\n                stream = archive.extractfile(member)\n                require(stream is not None, \"missing archived file: \" + relative)\n                h = hashlib.sha256()\n                size = 0\n                while block := stream.read(1024 * 1024):\n                    h.update(block)\n                    size += len(block)\n                require(size == expected[\"bytes\"] and h.hexdigest() == expected[\"sha256\"], \"archived bytes changed: \" + relative)\n            observed[relative] = expected[\"type\"]\n    require(set(observed) == set(before) and manifest_seen == 1, \"archive is not exhaustive\")\n    return {\"source_entries_verified\": len(observed), \"embedded_manifest_verified\": True,\n            \"all_hidden_git_sqlite_wal_shm_included_without_exclusion\": True}\n\n\ndef snapshot(root: Path, archive_path: Path) -> dict:\n    require(root.is_dir() and not root.is_symlink(), \"source must be a real directory\")\n    require(archive_path.parent.resolve() == root.parent.resolve(), \"archive must be a sibling outside source\")\n    manifest_path = archive_path.with_name(archive_path.name + \".SNAPSHOT-MANIFEST.json\")\n    receipt_path = archive_path.with_name(archive_path.name + \".RECEIPT.json\")\n    for target in (archive_path, manifest_path, receipt_path):\n        require(not target.exists() and not target.is_symlink(), \"existing target: reconcile before retry: \" + str(target))\n    before = inventory(root)\n    # Exclusive creation is the one-shot claim. A failed/partial artifact remains.\n    with archive_path.open(\"xb\") as raw_archive:\n        with tarfile.open(fileobj=raw_archive, mode=\"w:gz\", dereference=False) as archive:\n            archive.add(root, arcname=root.name, recursive=True)\n            after_source_packaging = inventory(root)\n            require(before == after_source_packaging, \"source changed during packaging; partial artifact preserved\")\n            manifest = {\"schema\": 1, \"source_path\": str(root), \"archive_root\": root.name,\n                        \"source_job\": \"751571\", \"source_job_state_parent_observed\": \"CANCELLED\",\n                        \"source_job_complete\": False, \"voluntary_interruption\": True,\n                        \"before\": before, \"after_source_packaging\": after_source_packaging,\n                        \"all_source_entries_unchanged\": True, \"no_exclusions\": True,\n                        \"sqlite_opened_or_checkpointed\": False, \"git_commands\": False,\n                        \"model_calls\": 0, \"candidate_executions\": 0}\n            manifest_bytes = (json.dumps(manifest, sort_keys=True, indent=2) + \"\\n\").encode(\"utf-8\")\n            info = tarfile.TarInfo(\"SNAPSHOT-MANIFEST.json\")\n            info.size = len(manifest_bytes)\n            info.mode = 0o644\n            archive.addfile(info, io.BytesIO(manifest_bytes))\n        raw_archive.flush()\n        os.fsync(raw_archive.fileno())\n    verified = verify_archive(archive_path, before, manifest_bytes, root.name)\n    after = inventory(root)\n    require(before == after, \"source changed after archive closure; reconcile preserved artifact\")\n    with manifest_path.open(\"xb\") as target:\n        target.write(manifest_bytes)\n        target.flush()\n        os.fsync(target.fileno())\n    receipt = {\"schema\": 1, \"status\": \"raw_partial_snapshot_created_and_byte_verified\",\n               \"archive_path\": str(archive_path), \"archive_bytes\": archive_path.stat().st_size,\n               \"archive_sha256\": sha_file(archive_path), \"manifest_path\": str(manifest_path),\n               \"manifest_sha256\": hashlib.sha256(manifest_bytes).hexdigest(),\n               \"source_path\": str(root), \"source_real_path\": str(root.resolve()),\n               \"source_entries\": len(before), \"source_files\": sum(x[\"type\"] == \"file\" for x in before.values()),\n               \"source_bytes\": sum(x[\"bytes\"] for x in before.values() if x[\"type\"] == \"file\"),\n               \"all_source_entries_unchanged_after_archive_closed_and_verified\": before == after,\n               \"source_job\": \"751571\", \"source_job_complete\": False,\n               \"source_job_state_parent_observed\": \"CANCELLED\", \"archive_verification\": verified,\n               \"snapshot_job_id\": os.environ.get(\"SLURM_JOB_ID\"), \"architecture\": platform.machine(),\n               \"native_model_calls\": 0, \"compilations\": 0, \"candidate_executions\": 0,\n               \"source_writes\": 0, \"created_utc\": datetime.now(UTC).isoformat()}\n    with receipt_path.open(\"x\", encoding=\"utf-8\") as target:\n        json.dump(receipt, target, sort_keys=True, indent=2)\n        target.write(\"\\n\")\n    return receipt\n\n\ndef main() -> None:\n    require(platform.system() == \"Linux\" and platform.machine().lower() in (\"aarch64\", \"arm64\"), \"real ARM64 allocation required\")\n    require(bool(os.environ.get(\"SLURM_JOB_ID\")), \"Slurm allocation required\")\n    require(os.environ.get(\"SLURM_CPUS_PER_TASK\") == \"1\", \"one allocated CPU required\")\n    require(not os.environ.get(\"SLURM_JOB_GPUS\"), \"zero GPU required\")\n    require(datetime.now(UTC) + timedelta(minutes=10, hours=3)\n            < datetime(2026, 10, 31, 23, tzinfo=UTC), \"exclusive deadline exceeded\")\n    receipt = snapshot(SOURCE, SOURCE.parent / ARCHIVE_NAME)\n    print(json.dumps(receipt, sort_keys=True), flush=True)\n\n\nif __name__ == \"__main__\":\n    main()\n\nPY_SNAPSHOT_751571\n\necho \"[romeo-mcp] fin $(date -Is)\"\n",
      "warnings": [
        "cible aarch64 : tout binaire ou paquet Python compile depuis le noeud de login (x86_64) echouera. Utilise compute_command_prepare."
      ]
    },

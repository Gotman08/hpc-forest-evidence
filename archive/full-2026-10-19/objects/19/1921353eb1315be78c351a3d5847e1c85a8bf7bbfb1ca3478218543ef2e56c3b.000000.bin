#include <algorithm>
#include <cassert>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <limits>
#include <memory>
#include <vector>

#if defined(__aarch64__) && defined(__ARM_NEON)
#include <arm_neon.h>
#define SUM_USE_NEON 1
#else
#define SUM_USE_NEON 0
#endif
#ifdef _OPENMP
#include <omp.h>
#endif

namespace {
using Word = std::uint32_t;
using Cell = std::int32_t;
using Wide = std::int64_t;
constexpr std::size_t BatchBytes = 1u << 20;

Cell signed_value(Word magnitude, bool negative) {
    const Wide value = negative ? -static_cast<Wide>(magnitude)
                                : static_cast<Wide>(magnitude);
    return static_cast<Cell>(value);
}

struct CountSlot {
    std::size_t offset;
    Word maximum_magnitude;
    unsigned char padding[64 - sizeof(std::size_t) - sizeof(Word)];
};

struct BatchReader {
    std::unique_ptr<unsigned char[]> storage;
    std::size_t begin = 0;
    std::size_t end = 0;
    bool pending = false;
    bool negative = false;
    bool ended = false;
    Word magnitude = 0;
    Word maximum_magnitude = 0;

    BatchReader() : storage(new unsigned char[BatchBytes]) {}

    bool next(Cell* matrix, std::size_t& produced, std::size_t total) {
        begin = end = 0;
        while (!ended && produced < total) {
            unsigned char* data = storage.get();
            const std::size_t got = std::fread(data, 1, BatchBytes, stdin);
            const bool at_eof = got < BatchBytes;
            std::size_t start = 0;

            if (pending) {
                while (start < got && data[start] > ' ') {
                    magnitude = magnitude * 10u
                              + static_cast<Word>(data[start] - '0');
                    ++start;
                }
                if (start < got || at_eof) {
                    matrix[produced++] = signed_value(magnitude, negative);
                    maximum_magnitude = std::max(maximum_magnitude, magnitude);
                    pending = false;
                } else {
                    continue;
                }
            }

            std::size_t finish = got;
            if (!at_eof && finish > start && data[finish - 1] > ' ') {
                while (finish > start && data[finish - 1] > ' ') --finish;
                std::size_t p = finish;
                negative = false;
                if (p < got && (data[p] == '-' || data[p] == '+')) {
                    negative = data[p] == '-';
                    ++p;
                }
                magnitude = 0;
                while (p < got) {
                    magnitude = magnitude * 10u
                              + static_cast<Word>(data[p] - '0');
                    ++p;
                }
                pending = true;
            }

            ended = at_eof;
            begin = start;
            end = finish;
            if (begin < end) return true;
        }
        return false;
    }
};

std::size_t align_boundary(const unsigned char* data, std::size_t position,
                           std::size_t begin, std::size_t end) {
    if (position != begin) {
        while (position < end && data[position - 1] > ' ') ++position;
    }
    return position;
}

inline Wide scan64(const Wide* columns, int n, int s) {
    Wide sum = 0;
    #pragma omp simd reduction(+:sum)
    for (int c = 0; c < s; ++c) sum += columns[c];
    Wide best = sum;
    for (int c = s; c < n; ++c) {
        sum += columns[c] - columns[c - s];
        best = std::max(best, sum);
    }
    return best;
}

Wide solve64_rows(const Cell* matrix, int n, int s, int first, int last) {
    if (first == last) return std::numeric_limits<Wide>::lowest();
    std::unique_ptr<Wide[]> columns(new Wide[n]());
    for (int r = first; r < first + s; ++r) {
        const Cell* row = matrix + static_cast<std::size_t>(r) * n;
        #pragma omp simd
        for (int c = 0; c < n; ++c) columns[c] += static_cast<Wide>(row[c]);
    }
    Wide best = scan64(columns.get(), n, s);
    for (int top = first + 1; top < last; ++top) {
        const Cell* entering = matrix + static_cast<std::size_t>(top + s - 1) * n;
        const Cell* leaving = matrix + static_cast<std::size_t>(top - 1) * n;
        #pragma omp simd
        for (int c = 0; c < n; ++c) {
            columns[c] += static_cast<Wide>(entering[c])
                        - static_cast<Wide>(leaving[c]);
        }
        best = std::max(best, scan64(columns.get(), n, s));
    }
    return best;
}

#if SUM_USE_NEON
inline Cell signed_bits(Word bits) {
    Cell value;
    std::memcpy(&value, &bits, sizeof(value));
    return value;
}

inline uint32x4_t prefix4(uint32x4_t value) {
    const uint32x4_t zero = vdupq_n_u32(0);
    value = vaddq_u32(value, vextq_u32(zero, value, 3));
    return vaddq_u32(value, vextq_u32(zero, value, 2));
}

template <bool Update>
inline Word column_scalar(Word* columns, const Cell* entering,
                          const Cell* leaving, int c) {
    Word value = columns[c];
    if (Update) {
        value -= static_cast<Word>(leaving[c]);
        value += static_cast<Word>(entering[c]);
        columns[c] = value;
    }
    return value;
}

template <bool Update>
inline uint32x4_t column_vector(Word* columns, const Cell* entering,
                                const Cell* leaving, int c) {
    uint32x4_t value = vld1q_u32(columns + c);
    if (Update) {
        value = vsubq_u32(value,
            vreinterpretq_u32_s32(vld1q_s32(leaving + c)));
        value = vaddq_u32(value,
            vreinterpretq_u32_s32(vld1q_s32(entering + c)));
        vst1q_u32(columns + c, value);
    }
    return value;
}

template <bool Update>
inline void scan32(Word* columns, const Cell* entering, const Cell* leaving,
                   int n, int s, Cell& scalar_best,
                   int32x4_t& maximum0, int32x4_t& maximum1) {
    uint32x4_t partial0 = vdupq_n_u32(0);
    uint32x4_t partial1 = vdupq_n_u32(0);
    int c = 0;
    for (; c + 7 < s; c += 8) {
        partial0 = vaddq_u32(partial0,
            column_vector<Update>(columns, entering, leaving, c));
        partial1 = vaddq_u32(partial1,
            column_vector<Update>(columns, entering, leaving, c + 4));
    }
    if (c + 3 < s) {
        partial0 = vaddq_u32(partial0,
            column_vector<Update>(columns, entering, leaving, c));
        c += 4;
    }
    Word sum = vaddvq_u32(vaddq_u32(partial0, partial1));
    for (; c < s; ++c) {
        sum += column_scalar<Update>(columns, entering, leaving, c);
    }
    scalar_best = std::max(scalar_best, signed_bits(sum));
    uint32x4_t carry = vdupq_n_u32(sum);

    for (; c + 7 < n; c += 8) {
        const uint32x4_t incoming0 =
            column_vector<Update>(columns, entering, leaving, c);
        const uint32x4_t incoming1 =
            column_vector<Update>(columns, entering, leaving, c + 4);
        const uint32x4_t outgoing0 = vld1q_u32(columns + c - s);
        const uint32x4_t outgoing1 = vld1q_u32(columns + c + 4 - s);
        const uint32x4_t prefix0 = prefix4(vsubq_u32(incoming0, outgoing0));
        const uint32x4_t prefix1 = vaddq_u32(
            prefix4(vsubq_u32(incoming1, outgoing1)),
            vdupq_laneq_u32(prefix0, 3));
        const uint32x4_t windows0 = vaddq_u32(prefix0, carry);
        const uint32x4_t windows1 = vaddq_u32(prefix1, carry);
        maximum0 = vmaxq_s32(maximum0, vreinterpretq_s32_u32(windows0));
        maximum1 = vmaxq_s32(maximum1, vreinterpretq_s32_u32(windows1));
        carry = vdupq_laneq_u32(windows1, 3);
    }
    if (c + 3 < n) {
        const uint32x4_t incoming =
            column_vector<Update>(columns, entering, leaving, c);
        const uint32x4_t outgoing = vld1q_u32(columns + c - s);
        const uint32x4_t windows = vaddq_u32(
            prefix4(vsubq_u32(incoming, outgoing)), carry);
        maximum0 = vmaxq_s32(maximum0, vreinterpretq_s32_u32(windows));
        carry = vdupq_laneq_u32(windows, 3);
        c += 4;
    }
    sum = vgetq_lane_u32(carry, 0);
    for (; c < n; ++c) {
        const Word incoming = column_scalar<Update>(columns, entering, leaving, c);
        sum += incoming - columns[c - s];
        scalar_best = std::max(scalar_best, signed_bits(sum));
    }
}

Wide solve32_rows(const Cell* matrix, int n, int s, int first, int last) {
    if (first == last) return std::numeric_limits<Wide>::lowest();
    std::unique_ptr<Word[]> columns(new Word[n]());
    for (int r = first; r < first + s; ++r) {
        const Cell* row = matrix + static_cast<std::size_t>(r) * n;
        #pragma omp simd
        for (int c = 0; c < n; ++c) columns[c] += static_cast<Word>(row[c]);
    }
    Cell scalar_best = std::numeric_limits<Cell>::lowest();
    int32x4_t maximum0 = vdupq_n_s32(scalar_best);
    int32x4_t maximum1 = maximum0;
    scan32<false>(columns.get(), nullptr, nullptr, n, s,
                  scalar_best, maximum0, maximum1);
    for (int top = first + 1; top < last; ++top) {
        const Cell* entering = matrix + static_cast<std::size_t>(top + s - 1) * n;
        const Cell* leaving = matrix + static_cast<std::size_t>(top - 1) * n;
        scan32<true>(columns.get(), entering, leaving, n, s,
                     scalar_best, maximum0, maximum1);
    }
    return std::max(scalar_best, vmaxvq_s32(vmaxq_s32(maximum0, maximum1)));
}
#endif
}

int main() {
    int n, s;
    if (std::scanf("%d%d", &n, &s) != 2) return 0;
    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    const std::size_t total = static_cast<std::size_t>(n) * n;
    std::unique_ptr<Cell[]> matrix(new Cell[total]);
    BatchReader input;
    int maximum_threads = 1;
#ifdef _OPENMP
    maximum_threads = omp_get_max_threads();
#endif
    std::vector<CountSlot> counts(maximum_threads);
    std::size_t produced = 0;
    std::size_t batch_base = 0;
    bool have_batch = false;
    bool use_narrow = false;
    long long answer = std::numeric_limits<long long>::lowest();

    #pragma omp parallel if(total >= 65536) reduction(max:answer)
    {
        int tid = 0;
        int team = 1;
#ifdef _OPENMP
        tid = omp_get_thread_num();
        team = omp_get_num_threads();
#endif
        Word local_maximum = 0;
        {
            const std::size_t staging_capacity = std::min(
                total, BatchBytes / static_cast<std::size_t>(team) + 8u);
            std::unique_ptr<Cell[]> staged(new Cell[staging_capacity]);
            for (;;) {
                #pragma omp single
                {
                    have_batch = input.next(matrix.get(), produced, total);
                    batch_base = produced;
                }
                if (!have_batch) break;

                const unsigned char* data = input.storage.get();
                const std::size_t length = input.end - input.begin;
                std::size_t left = input.begin + length * tid / team;
                std::size_t right = input.begin + length * (tid + 1) / team;
                left = align_boundary(data, left, input.begin, input.end);
                right = align_boundary(data, right, input.begin, input.end);
                std::size_t count = 0;
                std::size_t p = left;
                while (p < right) {
                    while (p < right && data[p] <= ' ') ++p;
                    if (p == right) break;
                    const bool negative = data[p] == '-';
                    if (data[p] == '-' || data[p] == '+') ++p;
                    Word magnitude = 0;
                    while (p < right && data[p] > ' ') {
                        magnitude = magnitude * 10u
                                  + static_cast<Word>(data[p] - '0');
                        ++p;
                    }
                    staged[count++] = signed_value(magnitude, negative);
                    local_maximum = std::max(local_maximum, magnitude);
                }
                counts[tid].offset = count;
                #pragma omp barrier
                #pragma omp single
                {
                    std::size_t prefix = 0;
                    for (int t = 0; t < team; ++t) {
                        const std::size_t count_t = counts[t].offset;
                        counts[t].offset = prefix;
                        prefix += count_t;
                    }
                    produced = batch_base + prefix;
                }
                if (count != 0) {
                    std::memcpy(matrix.get() + batch_base + counts[tid].offset,
                                staged.get(), count * sizeof(Cell));
                }
                #pragma omp barrier
            }
        }
        counts[tid].maximum_magnitude = local_maximum;
        #pragma omp barrier
        #pragma omp single
        {
            Word maximum_magnitude = input.maximum_magnitude;
            for (int t = 0; t < team; ++t) {
                maximum_magnitude = std::max(
                    maximum_magnitude, counts[t].maximum_magnitude);
            }
            const std::uint64_t bound = static_cast<std::uint64_t>(maximum_magnitude)
                                      * static_cast<std::uint64_t>(s) * s;
            use_narrow = bound <= static_cast<std::uint64_t>(
                std::numeric_limits<Cell>::max());
        }

        const int windows = n - s + 1;
        const int first = static_cast<int>(static_cast<Wide>(windows) * tid / team);
        const int last = static_cast<int>(static_cast<Wide>(windows) * (tid + 1) / team);
        Wide local_best;
#if SUM_USE_NEON
        if (use_narrow) {
            local_best = solve32_rows(matrix.get(), n, s, first, last);
        } else {
            local_best = solve64_rows(matrix.get(), n, s, first, last);
        }
#else
        (void)use_narrow;
        local_best = solve64_rows(matrix.get(), n, s, first, last);
#endif
        answer = std::max(answer, static_cast<long long>(local_best));
    }

    std::printf("%lld\n", answer);
    return 0;
}

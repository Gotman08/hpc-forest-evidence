"""Byte-only editorial review and preservation of actual build2 observations."""
import ast
import hashlib
import json
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
REV = ROOT / "impl/revision-coherence-r4"
BASE = Path("C:/Users/nicol/Documents/Codex/2026-10-15/cr")
ED = BASE / "outputs/HPC-Forest-Etude-2020-2024-r1/edition-professionnelle"


def ref(path):
    data = path.read_bytes()
    return {"path": str(path), "sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data)}


def read(path):
    return json.loads(path.read_text(encoding="utf-8-sig"))


def save(path, value):
    assert not path.exists()
    path.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(ref(path)))


def main():
    delivery_path = REV / "LIVRAISON-IMPLEMENTATION-SOL-R4.json"
    assert ref(delivery_path)["sha256"] == "46a5703ac2f383c343f744a5ed73c3db2863f26a022cb4b62b4b30ae442976f7"
    delivery = read(delivery_path)
    for key in ("previous_delivery", "previous_independent_review_GO", "previous_exports_delivery", "preservation_before_edit", "verification", "manifest", "diff", "targeted_comparative_review", "arithmetic_audit_unchanged"):
        value = delivery[key]
        assert ref(Path(value["path"]))["sha256"] == value["sha256"]
    before_m = (REV / "avant/manuscrit.md").read_bytes()
    before_a = (REV / "avant/assembler.py").read_bytes()
    replacements = [
        (b"### 3.3. Trois cohortes source-only sur les quinze sujets", b"### 3.3. Quatre cohortes source-only sur les quinze sujets"),
        ("La disparition d’interfaces locales du 17 octobre conserve des requêtes sans réponse et des consommations inconnues. Les cohortes Terra closes ont exclusivement utilisé codex-cli 0.162.0-alpha.17.2 ; la version 0.163 installée ultérieurement concerne seulement les éventuels groupes suivants après leur admission technique. Cette transition doit rester une limite de contexte, sans attribution causale à une mise à jour ni mélange des cohortes.".encode(),
         "La disparition d’interfaces locales du 17 octobre conserve des requêtes sans réponse et des consommations inconnues. Les cohortes Terra closes ont exclusivement utilisé codex-cli 0.162.0-alpha.17.2. La cohorte Sol source-only reçue et auditée a utilisé le CLI copié 0.163.0-alpha.10.2, identifié par son empreinte ; les versions restent rapportées par cohorte. Cette transition doit rester une limite de contexte, sans attribution causale à une mise à jour ni mélange des cohortes.".encode()),
    ]
    expected_m = before_m
    for old, new in replacements:
        assert expected_m.count(old) == 1
        expected_m = expected_m.replace(old, new)
    assert (ED / "manuscrit.md").read_bytes() == expected_m
    old, new = b"Source-only Luna/Astra MAX", b"Source-only Luna/Astra/Terra/Sol MAX"
    assert before_a.count(old) == 1
    assert (ED / "assembler.py").read_bytes() == before_a.replace(old, new)
    ast.parse(before_a.decode("utf-8-sig"))
    ast.parse((ED / "assembler.py").read_text(encoding="utf-8-sig"))
    preservation = read(Path(delivery["preservation_before_edit"]["path"]))
    for row in preservation["preserved"]:
        assert ref(Path(row["preserved"]["path"]))["sha256"] == row["preserved"]["sha256"]
    for value in delivery["canonical_files"] + delivery["new_root_exports"]:
        assert ref(Path(value["path"]))["sha256"] == value["sha256"]
    save(HERE / "REVUE-COHERENCE-R4.json", {
        "schema": "hpc-forest-professional-sol-coherence-revision-independent-review-v1",
        "verified": True, "blocking_findings": [], "observed_utc": datetime.now(UTC).isoformat(),
        "decision": "GO reconstruction documentaire après les trois corrections éditoriales exactes",
        "implementation_delivery": ref(delivery_path), "diff": delivery["diff"],
        "reviewed_files": [ref(REV / "avant/manuscrit.md"), ref(REV / "avant/assembler.py"), ref(ED / "manuscrit.md"), ref(ED / "assembler.py")],
        "checks_actually_run": ["égalité exhaustive des octets après exactement trois substitutions nommées", "copies antérieures rehashées", "neuf canoniques, huit exports et audit immuables rehashés", "AST sans import d'assembler.py"],
        "corrections_verified": delivery["corrections"],
        "scientific_data_or_protocol_changed": False, "arithmetic_audit_unchanged": delivery["arithmetic_audit_unchanged"],
        "build_or_render_or_controller_executed": False, "actual_pixel_review_of_new_build": False,
        "native_global_or_performance_admission": False,
        "limitations": ["Le nouveau contrôle et les nouveaux pixels restent à vérifier après la reconstruction; aucune admission finale du build2."],
    })
    plan = read(ROOT / "PLAN-REVUE-VISUELLE.json")
    assert plan["pdfs"][1]["sha256"] == "de958724886beacb6fffb882abd5c689d898125974d0ff1bfa70f1f5ffc6a636"
    rows = [r for r in plan["contacts"] if r["document"] == "ANNEXES-TECHNIQUES" and 157 <= r["first_page"] <= 229]
    assert len(rows) == 13
    for row in rows:
        assert ref(Path(row["path"]))["sha256"] == row["sha256"]
    sub = HERE / "SOUS-REVUE-VISUELLE-40-52.json"
    assert ref(sub)["sha256"] == "8c09de8c95e202457c03cac9eeffaf372037d8fa3f54da9f624275598ec978d5"
    save(HERE / "REVUE-PARTIELLE-BUILD2-ANNEXES.json", {
        "schema": "hpc-forest-sol-build2-partial-pixel-review-v1",
        "verified": False, "actual_pixel_review": True, "structural_scope_passed": True,
        "final_admission": False, "status": "superseded_build2_editorial_correction_pending",
        "observed_utc": datetime.now(UTC).isoformat(), "source_plan": ref(ROOT / "PLAN-REVUE-VISUELLE.json"),
        "pdfs": plan["pdfs"], "contact_sheets_personally_viewed": rows,
        "personal_observations": ["Planches27..34: tableaux et petits arbres contenus dans les marges, en-têtes et pieds cohérents, pas de clipping vu.", "Planches35..38: transition Terra/Sol, tableaux C173..C187 et arbres lisibles en vue d'ensemble, pas de chevauchement vu.", "Planche39: tableaux continués et arbres DeepSeek denses, pas de coupure vue; petits identifiants non lus à cette échelle."],
        "delegated_actual_pixel_review": ref(sub),
        "stop_reason": "Parent a détecté trois erreurs éditoriales dans ARTICLE (titre/table/chronologie CLI); correction source R4, reconstruction et contrôle à faire.",
        "individual_pages_personally_viewed": [], "pdf_zooms": [],
        "limitations": ["État partiel historique, jamais un reçu final de revue visuelle.", "Réemploi ultérieur uniquement après égalité SHA de chaque image réellement vue et provenance explicite."],
    })


if __name__ == "__main__":
    main()

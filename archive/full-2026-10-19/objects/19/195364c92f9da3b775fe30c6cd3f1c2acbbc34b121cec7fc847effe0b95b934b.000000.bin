{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include <stdio.h>\\n#include <stdlib.h>\\n#include <math.h>\\n#include <stdint.h>\\n#include <string.h>\\n#include <float.h>\\n\\nenum { SMALL_SORT = 32 };\\n\\nstatic void insertion_sort(double *values, size_t n) {\\n    for (size_t i = 1; i < n; ++i) {\\n        double value = values[i];\\n        size_t j = i;\\n        while (j > 0 && values[j - 1] > value) {\\n            values[j] = values[j - 1];\\n            --j;\\n        }\\n        values[j] = value;\\n    }\\n}\\n\\n#if FLT_RADIX == 2 && DBL_MANT_DIG == 53 && DBL_MAX_EXP == 1024 && defined(UINT64_MAX)\\n#define BINARY64_RADIX 1\\nstatic uint64_t order_key(double value) {\\n    uint64_t bits;\\n    memcpy(&bits, &value, sizeof(bits));\\n    /* Equal signed zeros share a key, but their stored values stay unchanged. */\\n    if ((bits & UINT64_C(0x7fffffffffffffff)) == 0)\\n        bits = 0;\\n    return (bits & UINT64_C(0x8000000000000000))\\n        ? ~bits : (bits ^ UINT64_C(0x8000000000000000));\\n}\\n#else\\n#define BINARY64_RADIX 0\\n#endif\\n\\n/* Stable sorting of a run containing no NaNs. */\\nstatic void sort_run(double *values, double *scratch, size_t n) {\\n    if (n < 2)\\n        return;\\n#if BINARY64_RADIX\\n    if (n > SMALL_SORT && scratch != NULL && sizeof(double) == sizeof(uint64_t)) {\\n        uint64_t first_key = order_key(values[0]);\\n        uint64_t varying = 0;\\n        int ordered = 1;\\n        size_t positions[256];\\n        double *source = values;\\n        double *destination = scratch;\\n\\n        for (size_t i = 1; i < n; ++i) {\\n            varying |= order_key(values[i]) ^ first_key;\\n            if (values[i - 1] > values[i])\\n                ordered = 0;\\n        }\\n        if (ordered)\\n            return;\\n\\n        for (unsigned int shift = 0; shift < 64; shift += 8) {\\n            if (((varying >> shift) & UINT64_C(255)) == 0)\\n                continue;\\n            memset(positions, 0, sizeof(positions));\\n            for (size_t i = 0; i < n; ++i) {\\n                unsigned int bucket = (unsigned int)\\n                    ((order_key(source[i]) >> shift) & UINT64_C(255));\\n                ++positions[bucket];\\n            }\\n            size_t total = 0;\\n            for (size_t bucket = 0; bucket < 256; ++bucket) {\\n                size_t count = positions[bucket];\\n                positions[bucket] = total;\\n                total += count;\\n            }\\n            for (size_t i = 0; i < n; ++i) {\\n                unsigned int bucket = (unsigned int)\\n                    ((order_key(source[i]) >> shift) & UINT64_C(255));\\n                destination[positions[bucket]++] = source[i];\\n            }\\n            double *temporary = source;\\n            source = destination;\\n            destination = temporary;\\n        }\\n        if (source != values)\\n            memcpy(values, source, n * sizeof(*values));\\n        return;\\n    }\\n#endif\\n    insertion_sort(values, n);\\n}\\n\\nstatic int column_has_nan(const double *values, size_t n) {\\n    for (size_t i = 0; i < n; ++i)\\n        if (isnan(values[i]))\\n            return 1;\\n    return 0;\\n}\\n\\nstatic void sort_column(double *values, double *scratch, size_t n, int has_nan) {\\n    if (n < 2)\\n        return;\\n    if (!has_nan) {\\n        sort_run(values, scratch, n);\\n        return;\\n    }\\n    /* Adjacent > swaps cannot move a value across a NaN. */\\n    size_t first = 0;\\n    for (size_t i = 0; i < n; ++i) {\\n        if (isnan(values[i])) {\\n            sort_run(values + first, scratch, i - first);\\n            first = i + 1;\\n        }\\n    }\\n    sort_run(values + first, scratch, n - first);\\n}\\n\\nvoid bubble_sort(double *matriz, int tam) {\\n    if (tam < 2)\\n        return;\\n    double *scratch = tam > SMALL_SORT\\n        ? (double *)malloc((size_t)tam * sizeof(double)) : NULL;\\n    sort_column(matriz, scratch, (size_t)tam,\\n                column_has_nan(matriz, (size_t)tam));\\n    free(scratch);\\n}\\n\\nvoid ordena_colunas(double *matriz, int lin, int col) {\\n    if (lin < 2 || col <= 0)\\n        return;\\n    double *scratch = lin > SMALL_SORT\\n        ? (double *)malloc((size_t)lin * sizeof(double)) : NULL;\\n    for (int i = 0; i < col; ++i) {\\n        double *column = matriz + (size_t)i * (size_t)lin;\\n        sort_column(column, scratch, (size_t)lin,\\n                    column_has_nan(column, (size_t)lin));\\n    }\\n    free(scratch);\\n}\\n\\nvoid calcula_media(double *matriz, double *vet, int lin, int col) {\\n    for (int i = 0; i < col; ++i) {\\n        const double *column = matriz + (size_t)i * (size_t)lin;\\n        double soma = 0;\\n        for (int j = 0; j < lin; ++j)\\n            soma += column[j];\\n        vet[i] = soma / lin;\\n    }\\n}\\n\\nvoid calcula_media_harmonica(double *matriz, double *vet, int lin, int col) {\\n    for (int i = 0; i < col; ++i) {\\n        const double *column = matriz + (size_t)i * (size_t)lin;\\n        double soma = 0;\\n        for (int j = 0; j < lin; ++j)\\n            soma += 1 / column[j];\\n        vet[i] = lin / soma;\\n    }\\n}\\n\\nvoid calcula_mediana(double *matriz, double *vet, int lin, int col) {\\n    int middle = lin / 2;\\n    for (int i = 0; i < col; ++i) {\\n        const double *column = matriz + (size_t)i * (size_t)lin;\\n        if (lin % 2 == 0) {\\n            vet[i] = column[middle - 1] + column[middle];\\n            vet[i] *= 0.5;\\n        } else {\\n            vet[i] = column[middle];\\n        }\\n    }\\n}\\n\\nstatic double mode_sorted(const double *values, size_t n) {\\n    float best_count = 0, mode = 0;\\n    size_t first = 0;\\n    while (first < n) {\\n        size_t end = first + 1;\\n        while (end < n && values[end] == values[first])\\n            ++end;\\n        /* Preserve strict per-index comparisons against the float winner,\\n           even when large integer counts round during conversion to float. */\\n        for (size_t i = first; i + 1 < end; ++i) {\\n            double count = (double)(end - i - 1);\\n            if (!(count > (double)best_count))\\n                break;\\n            best_count = (float)count;\\n            mode = (float)values[i];\\n        }\\n        first = end;\\n    }\\n    return best_count == 0 ? -1.0 : (double)mode;\\n}\\n\\nstatic double mode_generic(const double *values, size_t n) {\\n    float best_count = 0, mode = 0;\\n    for (size_t i = 0; i < n; ++i) {\\n        double count = 0;\\n        for (size_t j = i + 1; j < n; ++j) {\\n            if (values[i] == values[j]) {\\n                count += 1;\\n                if (count > best_count) {\\n                    best_count = (float)count;\\n                    mode = (float)values[i];\\n                }\\n            }\\n        }\\n    }\\n    return best_count == 0 ? -1.0 : (double)mode;\\n}\\n\\ndouble moda_aux(double *matriz, int lin) {\\n    if (lin < 2)\\n        return -1;\\n    for (int i = 0; i < lin; ++i) {\\n        if (isnan(matriz[i]) || (i > 0 && matriz[i - 1] > matriz[i]))\\n            return mode_generic(matriz, (size_t)lin);\\n    }\\n    return mode_sorted(matriz, (size_t)lin);\\n}\\n\\nvoid calcula_moda(double *matriz, double *moda, int lin, int col) {\\n    for (int i = 0; i < col; ++i)\\n        moda[i] = moda_aux(matriz + (size_t)i * (size_t)lin, lin);\\n}\\n\\nvoid calcula_variancia(double *matriz, double *media, double *variancia,\\n                       int lin, int col) {\\n    for (int i = 0; i < col; ++i) {\\n        const double *column = matriz + (size_t)i * (size_t)lin;\\n        double soma = 0;\\n        for (int j = 0; j < lin; ++j)\\n            soma += pow((column[j] - media[i]), 2);\\n        variancia[i] = soma / (lin - 1);\\n    }\\n}\\n\\nvoid calcula_desvio_padrao(double *variancia, double *dp, int col) {\\n    for (int i = 0; i < col; ++i)\\n        dp[i] = sqrt(variancia[i]);\\n}\\n\\nvoid calcula_coeficiente_variacao(double *media, double *dp, double *cv, int col) {\\n    for (int i = 0; i < col; ++i)\\n        cv[i] = dp[i] / media[i];\\n}\\n\\nint main(int argc, char **argv) {\\n    int lin, col, i, j;\\n    double *matriz, *mediana, *media, *media_har, *moda, *variancia, *dp, *cv;\\n    double *scratch;\\n\\n    fscanf(stdin, \\\"%d \\\", &lin);\\n    fscanf(stdin, \\\"%d\\\\n\\\", &col);\\n\\n    matriz = (double *)malloc((size_t)lin * (size_t)col * sizeof(double));\\n    media = (double *)malloc((size_t)col * sizeof(double));\\n    media_har = (double *)malloc((size_t)col * sizeof(double));\\n    mediana = (double *)malloc((size_t)col * sizeof(double));\\n    moda = (double *)malloc((size_t)col * sizeof(double));\\n    variancia = (double *)malloc((size_t)col * sizeof(double));\\n    cv = (double *)malloc((size_t)col * sizeof(double));\\n    dp = (double *)malloc((size_t)col * sizeof(double));\\n\\n    for (i = 0; i < lin; ++i)\\n        for (j = 0; j < col; ++j)\\n            fscanf(stdin, \\\"%lf \\\", &matriz[(size_t)j * (size_t)lin + (size_t)i]);\\n\\n    scratch = lin > SMALL_SORT\\n        ? (double *)malloc((size_t)lin * sizeof(double)) : NULL;\\n\\n    /* Finish each contiguous column before advancing to the next one. */\\n    for (i = 0; i < col; ++i) {\\n        double *column = matriz + (size_t)i * (size_t)lin;\\n        double sum = 0, inverse_sum = 0;\\n        int has_nan = 0;\\n        for (j = 0; j < lin; ++j) {\\n            double value = column[j];\\n            sum += value;\\n            inverse_sum += 1 / value;\\n            if (isnan(value))\\n                has_nan = 1;\\n        }\\n        media[i] = sum / lin;\\n        media_har[i] = lin / inverse_sum;\\n        sort_column(column, scratch, (size_t)lin, has_nan);\\n        calcula_mediana(column, mediana + i, lin, 1);\\n        moda[i] = has_nan ? mode_generic(column, (size_t)lin)\\n                          : mode_sorted(column, (size_t)lin);\\n        calcula_variancia(column, media + i, variancia + i, lin, 1);\\n        dp[i] = sqrt(variancia[i]);\\n        cv[i] = dp[i] / media[i];\\n    }\\n    free(scratch);\\n\\n    for (i = 0; i < col; ++i)\\n        printf(\\\"%.1lf \\\", media[i]);\\n    printf(\\\"\\\\n\\\");\\n    for (i = 0; i < col; ++i)\\n        printf(\\\"%.1lf \\\", media_har[i]);\\n    printf(\\\"\\\\n\\\");\\n    for (i = 0; i < col; ++i)\\n        printf(\\\"%.1lf \\\", mediana[i]);\\n    printf(\\\"\\\\n\\\");\\n    for (i = 0; i < col; ++i)\\n        printf(\\\"%.1lf \\\", moda[i]);\\n    printf(\\\"\\\\n\\\");\\n    for (i = 0; i < col; ++i)\\n        printf(\\\"%.1lf \\\", variancia[i]);\\n    printf(\\\"\\\\n\\\");\\n    for (i = 0; i < col; ++i)\\n        printf(\\\"%.1lf \\\", dp[i]);\\n    printf(\\\"\\\\n\\\");\\n    for (i = 0; i < col; ++i)\\n        printf(\\\"%.1lf \\\", cv[i]);\\n    printf(\\\"\\\\n\\\");\\n\\n    free(matriz);\\n    free(media);\\n    free(media_har);\\n    free(mediana);\\n    free(moda);\\n    free(variancia);\\n    free(dp);\\n    free(cv);\\n    return 0;\\n}\\n\",\n      \"path\": \"src/est_matriz_seq.c\"\n    }\n  ],\n  \"hypothesis\": \"Stable byte-radix sorting with reusable scratch and a column-local statistics pipeline should reduce sorting cost and whole-matrix cache traffic.\",\n  \"notes\": \"Not executed locally. Signed-zero stability, NaN barriers, reduction order and output formatting are retained. Reference mode counters are uninitialized; deterministic zero-initialized counting semantics replace that undefined behavior, whose exact-reference outcome remains ambiguous.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Use stable 256-bucket radix passes for binary64 numeric runs, skipping uniform bytes, with small-column insertion sorting and one reusable scratch buffer.\",\n    \"Complete statistics column by column, fusing arithmetic and harmonic accumulation while retaining each reduction's original order.\",\n    \"Count sorted equal-value runs while preserving strict float winner updates; use initialized quadratic counting when NaNs or unsorted auxiliary inputs prevent run scanning.\"\n  ]\n}"}}

      "path": "src/knn.c",
      "content": "#include \"knn.h\"\n#include <immintrin.h>\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        int num_points = g.length;\n        Point * points = g.points;\n\n        // Process points in chunks of 8 using AVX2\n        int chunk_size = 8;\n        for (j = 0; j < num_points; j += chunk_size) {\n            __m256 vx = _mm256_set1_ps(to_evaluate.x);\n            __m256 vy = _mm256_set1_ps(to_evaluate.y);\n\n            __m256 dists = _mm256_setzero_ps();\n\n            for (int l = 0; l < chunk_size && j + l < num_points; l++) {\n                __m256 px = _mm256_set1_ps(points[j + l].x);\n                __m256 py = _mm256_set1_ps(points[j + l].y);\n\n                __m256 dx = _mm256_sub_ps(px, vx);\n                __m256 dy = _mm256_sub_ps(py, vy);\n\n                __m256 dx_sq = _mm256_mul_ps(dx, dx);\n                __m256 dy_sq = _mm256_mul_ps(dy, dy);\n\n                dists = _mm256_add_ps(dists, _mm256_add_ps(dx_sq, dy_sq));\n            }\n\n            float dist_array[8];\n            _mm256_storeu_ps(dist_array, dists);\n\n            for (int l = 0; l < chunk_size && j + l < num_points; l++) {\n                float d = dist_array[l];\n\n                int inserted = 0;\n                for (x = 0; x < k && !inserted; x++) {\n                    if (d < distances[x] || distances[x] == -1) {\n                        for (y = k - 1; y > x; y--) {\n                            distances[y] = distances[y - 1];\n                            labels[y] = labels[y - 1];\n                        }\n\n                        distances[x] = d;\n                        labels[x] = g.label;\n\n                        inserted = 1;\n                    }\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(labels);\n    free(distances);\n\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n\n    // Free allocated memory for points in each group\n    for (int i = 0; i < n_groups; i++) {\n        free(groups[i].points);\n    }\n    free(groups);\n}"
    },
    {
      "path": "src/knn.h",
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}"
    }
  ],
  "notes": "This experiment applies AVX2 intrinsics for vectorized distance calculations in the knn function to improve performance. It also ensures that loop dependencies are handled correctly by using an insertion flag to avoid unnecessary iterations."
}

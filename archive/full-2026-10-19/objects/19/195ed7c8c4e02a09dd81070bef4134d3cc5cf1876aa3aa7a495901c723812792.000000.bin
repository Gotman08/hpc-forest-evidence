{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n#include <limits.h>\\n#include <stdint.h>\\n#include <string.h>\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\ntypedef struct {\\n    size_t bins[256];\\n    size_t quota;\\n    size_t padding[7];\\n} KnnRadixState;\\n\\nstatic char knn_vote(const size_t *counts) {\\n    char best = (char)-1;\\n    size_t largest = 0;\\n\\n    for (int c = CHAR_MIN; c <= CHAR_MAX; c++) {\\n        size_t count = counts[(unsigned char)(char)c];\\n        if (count > largest) {\\n            largest = count;\\n            best = (char)c;\\n        }\\n    }\\n    return best;\\n}\\n\\n/* Preserve the reference's insertion behavior for unordered distances. */\\nstatic char knn_original_selection(int n_groups, Group *groups, int k,\\n                                   Point to_evaluate) {\\n    char *labels = malloc((size_t)k * sizeof(*labels));\\n    float *distances = malloc((size_t)k * sizeof(*distances));\\n    if (labels == NULL || distances == NULL) {\\n        free(labels);\\n        free(distances);\\n        exit(EXIT_FAILURE);\\n    }\\n\\n    for (int i = 0; i < k; i++) {\\n        labels[i] = -1;\\n        distances[i] = -1;\\n    }\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n        for (int j = 0; j < g.length; j++) {\\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n            for (int x = 0; x < k; x++) {\\n                if (d < distances[x] || distances[x] == -1) {\\n                    for (int y = k - 1; y > x; y--) {\\n                        distances[y] = distances[y - 1];\\n                        labels[y] = labels[y - 1];\\n                    }\\n                    distances[x] = d;\\n                    labels[x] = g.label;\\n                    break;\\n                }\\n            }\\n        }\\n    }\\n\\n    size_t counts[256] = {0};\\n    for (int i = 0; i < k; i++) {\\n        counts[(unsigned char)labels[i]]++;\\n    }\\n    free(distances);\\n    free(labels);\\n    return knn_vote(counts);\\n}\\n\\nstatic int knn_first_group(const size_t *offsets, int n_groups,\\n                           size_t position) {\\n    int low = 0;\\n    int high = n_groups;\\n    while (low < high) {\\n        int middle = low + (high - low) / 2;\\n        if (offsets[middle + 1] <= position) {\\n            low = middle + 1;\\n        } else {\\n            high = middle;\\n        }\\n    }\\n    return low;\\n}\\n\\nstatic uint32_t knn_distance_key(Point query, Point point) {\\n    float distance = euclidean_distance_no_sqrt(query, point);\\n    uint32_t key;\\n    memcpy(&key, &distance, sizeof(key));\\n    /* Squared distances are nonnegative; canonicalize either zero sign. */\\n    return key & UINT32_C(0x7fffffff);\\n}\\n\\nstatic void knn_select_byte(KnnRadixState *states, int threads, int shift,\\n                            uint32_t *prefix, size_t *rank) {\\n    for (unsigned int bucket = 0; bucket < 256; bucket++) {\\n        size_t count = 0;\\n        for (int t = 0; t < threads; t++) {\\n            count += states[t].bins[bucket];\\n        }\\n        if (*rank > count) {\\n            *rank -= count;\\n        } else {\\n            *prefix |= (uint32_t)bucket << shift;\\n            break;\\n        }\\n    }\\n\\n    if (shift == 0) {\\n        size_t remaining = *rank;\\n        unsigned int bucket = *prefix & UINT32_C(255);\\n        /* Contiguous thread ranges follow the original traversal order. */\\n        for (int t = 0; t < threads; t++) {\\n            size_t available = states[t].bins[bucket];\\n            states[t].quota = remaining < available ? remaining : available;\\n            remaining -= states[t].quota;\\n        }\\n    }\\n}\\n\\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n    if (k <= 0) {\\n        return (char)-1;\\n    }\\n\\n    size_t total = 0;\\n    for (int g = 0; g < n_groups; g++) {\\n        total += (size_t)groups[g].length;\\n    }\\n\\n    if ((size_t)k >= total) {\\n        size_t counts[256] = {0};\\n        for (int g = 0; g < n_groups; g++) {\\n            counts[(unsigned char)groups[g].label] += (size_t)groups[g].length;\\n        }\\n        counts[(unsigned char)(char)-1] += (size_t)k - total;\\n        return knn_vote(counts);\\n    }\\n\\n    if (total > SIZE_MAX / sizeof(uint32_t)) {\\n        return knn_original_selection(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    int capacity = 1;\\n#ifdef _OPENMP\\n    if (total >= 16384) {\\n        capacity = omp_get_max_threads();\\n    }\\n#endif\\n\\n    size_t *offsets = malloc(((size_t)n_groups + 1) * sizeof(*offsets));\\n    uint32_t *keys = malloc(total * sizeof(*keys));\\n    KnnRadixState *states = calloc((size_t)capacity, sizeof(*states));\\n    if (offsets == NULL || keys == NULL || states == NULL) {\\n        free(states);\\n        free(keys);\\n        free(offsets);\\n        return knn_original_selection(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    offsets[0] = 0;\\n    for (int g = 0; g < n_groups; g++) {\\n        offsets[g + 1] = offsets[g] + (size_t)groups[g].length;\\n    }\\n\\n    uint32_t prefix = 0;\\n    size_t rank = (size_t)k;\\n    int has_nan = 0;\\n    char answer = (char)-1;\\n\\n#pragma omp parallel if(total >= 16384)\\n    {\\n        int tid = 0;\\n        int threads = 1;\\n#ifdef _OPENMP\\n        tid = omp_get_thread_num();\\n        threads = omp_get_num_threads();\\n#endif\\n        size_t width = total / (size_t)threads;\\n        size_t extra = total % (size_t)threads;\\n        size_t thread_index = (size_t)tid;\\n        size_t begin = width * thread_index;\\n        begin += thread_index < extra ? thread_index : extra;\\n        size_t end = begin + width + (thread_index < extra);\\n        int first_group = knn_first_group(offsets, n_groups, begin);\\n        KnnRadixState *mine = &states[tid];\\n        int local_nan = 0;\\n\\n        for (int g = first_group;\\n             g < n_groups && offsets[g] < end; g++) {\\n            size_t low = offsets[g] > begin ? offsets[g] : begin;\\n            size_t high = offsets[g + 1] < end ? offsets[g + 1] : end;\\n            for (size_t p = low; p < high; p++) {\\n                uint32_t key = knn_distance_key(\\n                    to_evaluate, groups[g].points[p - offsets[g]]);\\n                keys[p] = key;\\n                mine->bins[key >> 24]++;\\n                local_nan |= key > UINT32_C(0x7f800000);\\n            }\\n        }\\n\\n        if (local_nan) {\\n#pragma omp atomic write\\n            has_nan = 1;\\n        }\\n#pragma omp barrier\\n\\n        if (!has_nan) {\\n#pragma omp single\\n            {\\n                knn_select_byte(states, threads, 24, &prefix, &rank);\\n            }\\n\\n            for (int shift = 16; shift >= 0; shift -= 8) {\\n                memset(mine->bins, 0, sizeof(mine->bins));\\n                uint32_t mask = UINT32_MAX << (shift + 8);\\n                for (size_t p = begin; p < end; p++) {\\n                    uint32_t key = keys[p];\\n                    if ((key & mask) == prefix) {\\n                        mine->bins[(key >> shift) & UINT32_C(255)]++;\\n                    }\\n                }\\n#pragma omp barrier\\n#pragma omp single\\n                {\\n                    knn_select_byte(states, threads, shift, &prefix, &rank);\\n                }\\n            }\\n\\n            size_t ties = mine->quota;\\n            memset(mine->bins, 0, sizeof(mine->bins));\\n            for (int g = first_group;\\n                 g < n_groups && offsets[g] < end; g++) {\\n                size_t low = offsets[g] > begin ? offsets[g] : begin;\\n                size_t high = offsets[g + 1] < end ? offsets[g + 1] : end;\\n                unsigned int label = (unsigned char)groups[g].label;\\n                for (size_t p = low; p < high; p++) {\\n                    uint32_t key = keys[p];\\n                    if (key < prefix) {\\n                        mine->bins[label]++;\\n                    } else if (key == prefix && ties != 0) {\\n                        mine->bins[label]++;\\n                        ties--;\\n                    }\\n                }\\n            }\\n#pragma omp barrier\\n#pragma omp single\\n            {\\n                for (int t = 1; t < threads; t++) {\\n                    for (int label = 0; label < 256; label++) {\\n                        states[0].bins[label] += states[t].bins[label];\\n                    }\\n                }\\n                answer = knn_vote(states[0].bins);\\n            }\\n        }\\n    }\\n\\n    free(states);\\n    free(keys);\\n    free(offsets);\\n    if (has_nan) {\\n        return knn_original_selection(n_groups, groups, k, to_evaluate);\\n    }\\n    return answer;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Persistent OpenMP radix selection with private histogram reductions can replace quadratic insertion while avoiding heap sorting and serial merging.\",\n  \"notes\": \"Parsing and src/knn.h remain unchanged. NaNs retain reference insertion behavior; per-call scratch is freed. No commands executed.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Partition flattened points into balanced contiguous thread ranges and cache exact squared-distance keys.\",\n    \"Select the kth distance through four synchronized byte-histogram reductions within one OpenMP region.\",\n    \"Preserve input-order distance ties using per-thread quotas, then reduce label counts with the reference char-order tie break.\",\n    \"Serialize small scans and count labels directly when k covers every point, including unused sentinel entries.\"\n  ]\n}"}}

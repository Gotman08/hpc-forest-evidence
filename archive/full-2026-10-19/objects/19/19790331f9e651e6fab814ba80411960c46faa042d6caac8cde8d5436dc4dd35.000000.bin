#include "knn.h"
#include <limits.h>
#include <math.h>
#include <stdint.h>
#include <string.h>

#ifdef _OPENMP
#include <omp.h>
#endif

#define KNN_LABEL_COUNT (UCHAR_MAX + 1)

typedef struct {
    float distance;
    char label;
    size_t ordinal;
} KnnCandidate;

typedef struct {
    size_t begin;
    size_t retained;
    int has_nan;
    size_t all[KNN_LABEL_COUNT];
    size_t chosen[KNN_LABEL_COUNT];
} KnnShard;

static char knn_vote(const size_t *counts) {
    char best = (char)-1;
    size_t best_count = 0;

    for (unsigned int i = 0; i < KNN_LABEL_COUNT; ++i) {
        char label = (char)(unsigned char)i;
        if (counts[i] > best_count ||
            (counts[i] != 0 && counts[i] == best_count && label < best)) {
            best = label;
            best_count = counts[i];
        }
    }
    return best;
}

static int knn_candidate_order(const KnnCandidate *a,
                               const KnnCandidate *b, int reverse) {
    int order;
    if (a->distance < b->distance) {
        order = -1;
    } else if (a->distance > b->distance) {
        order = 1;
    } else {
        order = (a->ordinal > b->ordinal) - (a->ordinal < b->ordinal);
    }
    return reverse ? -order : order;
}

static int knn_compare_near(const void *a, const void *b) {
    return knn_candidate_order((const KnnCandidate *)a,
                               (const KnnCandidate *)b, 0);
}

static int knn_compare_far(const void *a, const void *b) {
    return knn_candidate_order((const KnnCandidate *)a,
                               (const KnnCandidate *)b, 1);
}

static void knn_swap(KnnCandidate *a, KnnCandidate *b) {
    KnnCandidate temporary = *a;
    *a = *b;
    *b = temporary;
}

/* Retain the first 'keep' entries in the requested total order. */
static void knn_select(KnnCandidate *items, size_t length,
                       size_t keep, int reverse) {
    if (keep == 0 || keep >= length) return;

    size_t lo = 0;
    size_t hi = length;
    unsigned int budget = 0;
    for (size_t n = length; n > 1; n >>= 1) budget += 2;

    while (hi - lo > 24) {
        if (budget-- == 0) {
            qsort(items + lo, hi - lo, sizeof(*items),
                  reverse ? knn_compare_far : knn_compare_near);
            return;
        }

        KnnCandidate a = items[lo];
        KnnCandidate b = items[lo + (hi - lo) / 2];
        KnnCandidate c = items[hi - 1];
        if (knn_candidate_order(&a, &b, reverse) > 0) knn_swap(&a, &b);
        if (knn_candidate_order(&b, &c, reverse) > 0) knn_swap(&b, &c);
        if (knn_candidate_order(&a, &b, reverse) > 0) knn_swap(&a, &b);
        KnnCandidate pivot = b;

        size_t lower = lo;
        size_t current = lo;
        size_t upper = hi;
        while (current < upper) {
            int order = knn_candidate_order(items + current, &pivot, reverse);
            if (order < 0) {
                knn_swap(items + lower, items + current);
                ++lower;
                ++current;
            } else if (order > 0) {
                --upper;
                knn_swap(items + current, items + upper);
            } else {
                ++current;
            }
        }

        if (keep < lower) {
            hi = lower;
        } else if (keep > upper) {
            lo = upper;
        } else {
            return;
        }
    }

    for (size_t i = lo + 1; i < hi; ++i) {
        KnnCandidate value = items[i];
        size_t j = i;
        while (j > lo &&
               knn_candidate_order(&value, items + j - 1, reverse) < 0) {
            items[j] = items[j - 1];
            --j;
        }
        items[j] = value;
    }
}

/* Preserve insertion semantics for unordered floating-point distances. */
static char knn_insertion(int n_groups, Group *groups, int k,
                           Point to_evaluate) {
    char *labels = (char *)malloc((size_t)k * sizeof(*labels));
    float *distances = (float *)malloc((size_t)k * sizeof(*distances));
    if (labels == NULL || distances == NULL) {
        free(labels);
        free(distances);
        on_error();
    }

    for (int i = 0; i < k; ++i) {
        labels[i] = (char)-1;
        distances[i] = -1;
    }

    for (int i = 0; i < n_groups; ++i) {
        Group g = groups[i];
        for (int j = 0; j < g.length; ++j) {
            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);
            for (int x = 0; x < k; ++x) {
                if (d < distances[x] || distances[x] == -1) {
                    for (int y = k - 1; y > x; --y) {
                        distances[y] = distances[y - 1];
                        labels[y] = labels[y - 1];
                    }
                    distances[x] = d;
                    labels[x] = g.label;
                    break;
                }
            }
        }
    }

    size_t counts[KNN_LABEL_COUNT] = {0};
    for (int i = 0; i < k; ++i) ++counts[(unsigned char)labels[i]];
    char result = knn_vote(counts);
    free(labels);
    free(distances);
    return result;
}

char knn(int n_groups, Group *groups, int k, Point to_evaluate) {
    if (k <= 0) return (char)-1;

    size_t total = 0;
    for (int g = 0; g < n_groups; ++g) {
        if (groups[g].length > 0) {
            size_t length = (size_t)groups[g].length;
            if (length > SIZE_MAX - total) {
                return knn_insertion(n_groups, groups, k, to_evaluate);
            }
            total += length;
        }
    }

    if ((size_t)k >= total) {
        size_t counts[KNN_LABEL_COUNT] = {0};
        for (int g = 0; g < n_groups; ++g) {
            if (groups[g].length > 0) {
                counts[(unsigned char)groups[g].label] +=
                    (size_t)groups[g].length;
            }
        }
        char empty_label = (char)-1;
        counts[(unsigned char)empty_label] += (size_t)k - total;
        return knn_vote(counts);
    }

    int workers = 1;
#ifdef _OPENMP
    workers = omp_get_max_threads();
    if (workers < 1) workers = 1;
    size_t useful_workers = total / 8192;
    if (useful_workers == 0) useful_workers = 1;
    if (useful_workers < (size_t)workers) workers = (int)useful_workers;
#endif

    if (total > SIZE_MAX / sizeof(KnnCandidate)) {
        return knn_insertion(n_groups, groups, k, to_evaluate);
    }
    KnnCandidate *items = (KnnCandidate *)malloc(total * sizeof(*items));
    KnnShard *shards = (KnnShard *)calloc((size_t)workers, sizeof(*shards));
    if (items == NULL || shards == NULL) {
        free(items);
        free(shards);
        return knn_insertion(n_groups, groups, k, to_evaluate);
    }

    const int reverse = (size_t)k > total / 2;
    const size_t needed = reverse ? total - (size_t)k : (size_t)k;
    int has_nan = 0;
    char result = (char)-1;

#ifdef _OPENMP
#pragma omp parallel num_threads(workers) if(workers > 1)
#endif
    {
        int tid = 0;
        int threads = 1;
#ifdef _OPENMP
        tid = omp_get_thread_num();
        threads = omp_get_num_threads();
#endif
        size_t base = total / (size_t)threads;
        size_t remainder = total % (size_t)threads;
        size_t preceding_extra = (size_t)tid < remainder ?
                                 (size_t)tid : remainder;
        size_t begin = base * (size_t)tid + preceding_extra;
        size_t end = begin + base + ((size_t)tid < remainder);
        KnnShard *local = shards + tid;
        local->begin = begin;
        local->retained = end - begin < needed ? end - begin : needed;

        size_t offset = 0;
        for (int g = 0; g < n_groups && offset < end; ++g) {
            size_t length = groups[g].length > 0 ?
                            (size_t)groups[g].length : 0;
            size_t next = offset + length;
            if (next > begin) {
                size_t first = begin > offset ? begin - offset : 0;
                size_t last = end < next ? end - offset : length;
                if (reverse) {
                    local->all[(unsigned char)groups[g].label] += last - first;
                }
                for (size_t j = first; j < last; ++j) {
                    size_t ordinal = offset + j;
                    float d = euclidean_distance_no_sqrt(
                        to_evaluate, groups[g].points[j]);
                    items[ordinal].distance = d;
                    items[ordinal].label = groups[g].label;
                    items[ordinal].ordinal = ordinal;
                    if (isnan(d)) local->has_nan = 1;
                }
            }
            offset = next;
        }

        if (!local->has_nan) {
            knn_select(items + begin, end - begin, local->retained, reverse);
        }

#ifdef _OPENMP
#pragma omp barrier
#pragma omp single
#endif
        {
            for (int t = 0; t < threads; ++t) {
                if (shards[t].has_nan) has_nan = 1;
            }
            if (!has_nan) {
                size_t retained = 0;
                for (int t = 0; t < threads; ++t) {
                    memmove(items + retained, items + shards[t].begin,
                            shards[t].retained * sizeof(*items));
                    retained += shards[t].retained;
                }
                knn_select(items, retained, needed, reverse);
            }
        }

        if (!has_nan) {
            size_t count_base = needed / (size_t)threads;
            size_t count_extra = needed % (size_t)threads;
            size_t before = (size_t)tid < count_extra ?
                            (size_t)tid : count_extra;
            size_t first = count_base * (size_t)tid + before;
            size_t last = first + count_base + ((size_t)tid < count_extra);
            for (size_t i = first; i < last; ++i) {
                ++local->chosen[(unsigned char)items[i].label];
            }
        }

#ifdef _OPENMP
#pragma omp barrier
#pragma omp single nowait
#endif
        {
            if (!has_nan) {
                size_t counts[KNN_LABEL_COUNT];
                for (unsigned int label = 0; label < KNN_LABEL_COUNT; ++label) {
                    size_t chosen = 0;
                    size_t all = 0;
                    for (int t = 0; t < threads; ++t) {
                        chosen += shards[t].chosen[label];
                        if (reverse) all += shards[t].all[label];
                    }
                    counts[label] = reverse ? all - chosen : chosen;
                }
                result = knn_vote(counts);
            }
        }
    }

    free(items);
    free(shards);
    if (has_nan) return knn_insertion(n_groups, groups, k, to_evaluate);
    return result;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

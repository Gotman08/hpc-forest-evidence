#include "knn.h"
#include <immintrin.h>

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    char * labels = (char *) malloc(sizeof(char) * k);
    float * distances = (float *) malloc(sizeof(float) * k);

    int i, j, x, y;

    for (i = 0; i < k; i++) {
        labels[i] = -1;
        distances[i] = -1;
    }

    for (i = 0; i < n_groups; i++) {
        Group g = groups[i];

        int j_limit = g.length - 3;
        __m256 to_evaluate_x_vec = _mm256_set1_ps(to_evaluate.x);
        __m256 to_evaluate_y_vec = _mm256_set1_ps(to_evaluate.y);

        for (j = 0; j <= j_limit; j += 4) {
            __m256 point_x_vec = _mm256_loadu_ps(&g.points[j].x);
            __m256 point_y_vec = _mm256_loadu_ps(&g.points[j].y);

            __m256 diff_x_vec = _mm256_sub_ps(point_x_vec, to_evaluate_x_vec);
            __m256 diff_y_vec = _mm256_sub_ps(point_y_vec, to_evaluate_y_vec);

            __m256 dist_sq_vec = _mm256_add_ps(_mm256_mul_ps(diff_x_vec, diff_x_vec), _mm256_mul_ps(diff_y_vec, diff_y_vec));

            float dists[8];
            _mm256_storeu_ps(dists, dist_sq_vec);

            for (x = 0; x < 4; x++) {
                float d = dists[x];
                if (d < distances[k - 1] || distances[k - 1] == -1) {
                    int insert_pos = k - 1;
                    while (insert_pos > 0 && d < distances[insert_pos - 1]) {
                        distances[insert_pos] = distances[insert_pos - 1];
                        labels[insert_pos] = labels[insert_pos - 1];
                        insert_pos--;
                    }
                    distances[insert_pos] = d;
                    labels[insert_pos] = g.label;
                }
            }
        }

        // Handle remaining points if the length is not a multiple of 4
        for (; j < g.length; j++) {
            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);

            for (x = 0; x < k; x++) {
                if (d < distances[x] || distances[x] == -1) {
                    for (y = k - 1; y > x; y--) {
                        distances[y] = distances[y - 1];
                        labels[y] = labels[y - 1];
                    }

                    distances[x] = d;
                    labels[x] = g.label;

                    break;
                }
            }
        }
    }

    qsort(labels, k, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }

            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    free(labels);
    free(distances);

    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}
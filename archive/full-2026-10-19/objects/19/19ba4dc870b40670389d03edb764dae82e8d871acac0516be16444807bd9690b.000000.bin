#include "knn.h"

#define BLOCK_SIZE 16

typedef struct {
    float distance;
    char label;
} DistanceLabel;

char knn(int n_groups, Group *groups, int k, Point to_evaluate) {
    DistanceLabel *distances = (DistanceLabel *)malloc(sizeof(DistanceLabel) * k);

    for (int i = 0; i < k; i++) {
        distances[i].distance = -1;
        distances[i].label = -1;
    }

    for (int i = 0; i < n_groups; i++) {
        Group g = groups[i];
        int num_blocks = (g.length + BLOCK_SIZE - 1) / BLOCK_SIZE;

        DistanceLabel *block_distances = (DistanceLabel *)malloc(sizeof(DistanceLabel) * k);

        for (int j = 0; j < k; j++) {
            block_distances[j].distance = -1;
            block_distances[j].label = -1;
        }

        for (int block = 0; block < num_blocks; block++) {
            int start = block * BLOCK_SIZE;
            int end = (block + 1) * BLOCK_SIZE > g.length ? g.length : (block + 1) * BLOCK_SIZE;

            for (int j = start; j < end; j++) {
                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);

                int x;
                for (x = 0; x < k && block_distances[x].distance != -1 && d >= block_distances[x].distance; x++);

                if (x < k) {
                    for (int y = k - 1; y > x; y--) {
                        block_distances[y] = block_distances[y - 1];
                    }
                    block_distances[x].distance = d;
                    block_distances[x].label = g.label;
                }
            }
        }

        for (int x = 0; x < k && block_distances[x].distance != -1; x++) {
            float d = block_distances[x].distance;
            char l = block_distances[x].label;

            int y;
            for (y = k - 1; y > 0 && distances[y - 1].distance != -1 && d < distances[y - 1].distance; y--) {
                distances[y] = distances[y - 1];
            }
            distances[y].distance = d;
            distances[y].label = l;
        }

        free(block_distances);
    }

    qsort(distances, k, sizeof(DistanceLabel), compare_for_sort);

    char most_frequent = distances[0].label;
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (int i = 1; i < k; i++) {
        if (distances[i].label != distances[i - 1].label) {
            if (current_frequency > most_frequent_count) {
                most_frequent = distances[i - 1].label;
                most_frequent_count = current_frequency;
            }

            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = distances[i].label;
            most_frequent_count = current_frequency;
        }
    }

    free(distances);
    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}
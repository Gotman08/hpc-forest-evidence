#include <iostream>
#include <vector>
#include <cstdio>
#include <climits>
#include <cassert>

struct FastScanner {
    static const int BUFSIZE = 1 << 20;
    char buf[BUFSIZE];
    int idx, size;
    FastScanner() : idx(0), size(0) {}
    inline char getChar() {
        if (idx >= size) {
            size = fread(buf, 1, BUFSIZE, stdin);
            idx = 0;
            if (size == 0) return 0;
        }
        return buf[idx++];
    }
    int nextInt() {
        char c;
        do { c = getChar(); } while (c <= ' ');
        int sign = 1;
        if (c == '-') { sign = -1; c = getChar(); }
        int x = 0;
        while (c >= '0' && c <= '9') {
            x = x * 10 + (c - '0');
            c = getChar();
        }
        return sign * x;
    }
};

int main() {
    FastScanner fs;
    int n = fs.nextInt();
    int s = fs.nextInt();

    std::vector<int> pref((size_t)(n + 1) * n, 0);
    std::vector<int> row(n);
    for (int i = 1; i <= n; ++i) {
        for (int j = 0; j < n; ++j) row[j] = fs.nextInt();
        const int base = i * n;
        const int prev = (i - 1) * n;
        #pragma omp simd
        for (int j = 0; j < n; ++j) {
            pref[base + j] = pref[prev + j] + row[j];
        }
    }

    assert(s > 0 && s < n && n < 8000);

    int mxSum = INT_MIN;

    #pragma omp parallel for reduction(max:mxSum) schedule(static)
    for (int i = 0; i <= n - s; ++i) {
        const int rowStart = i * n;
        const int rowEnd   = (i + s) * n;
        const int* top    = &pref[rowStart];
        const int* bottom = &pref[rowEnd];

        int window = 0;
        #pragma omp simd reduction(+:window)
        for (int j = 0; j < s; ++j) {
            window += bottom[j] - top[j];
        }
        int curMax = window;

        for (int j = s; j < n; ++j) {
            window += (bottom[j] - top[j]) - (bottom[j - s] - top[j - s]);
            if (window > curMax) curMax = window;
        }

        if (curMax > mxSum) mxSum = curMax;
    }

    printf("%d\n", mxSum);
    return 0;
}

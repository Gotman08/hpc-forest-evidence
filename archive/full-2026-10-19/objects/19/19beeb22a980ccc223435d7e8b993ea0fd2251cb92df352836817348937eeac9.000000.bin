"""Positive and negative checks for the isolated, offline statement reviewer."""
import itertools
import unittest

from domain_review import (
    ReviewError,
    _maximum_colors,
    check_permutations,
    check_tropical,
    input_domain,
    permutation_domain,
    tropical_domain,
)


def output(rows):
    return b"".join(b"[ " + b" ".join(bytes([value]) for value in row) + b" ]\n"
                    for row in rows)


STAR = b"4 4\n0\n1\n2\n3\n3\n0 1\n0 2\n0 3\n"


class PermutationReview(unittest.TestCase):
    def test_public_multiset_example(self):
        self.assertEqual(check_permutations(b"BOB\n", output([b"BBO", b"BOB", b"OBB"]))
                         ["permutations"], 3)

    def test_original_six_whitespace_characters(self):
        self.assertEqual(permutation_domain(b" B\tO\rB\n\v\f")["symbols"], b"BOB")

    def test_independent_tiny_complete_sets(self):
        for raw in [b"A", b"AA", b"ABA", b"ABCD", b"AABB"]:
            rows = sorted({bytes(row) for row in itertools.permutations(raw)})
            self.assertTrue(check_permutations(raw, output(rows))["checked"])

    def test_missing_permutation(self):
        with self.assertRaises(ReviewError):
            check_permutations(b"BOB", output([b"BBO", b"BOB"]))

    def test_duplicate_permutation(self):
        with self.assertRaises(ReviewError):
            check_permutations(b"BOB", output([b"BBO", b"BOB", b"BOB"]))

    def test_wrong_lexicographic_order(self):
        with self.assertRaises(ReviewError):
            check_permutations(b"BOB", output([b"BOB", b"BBO", b"OBB"]))

    def test_wrong_multiset(self):
        with self.assertRaises(ReviewError):
            check_permutations(b"BOB", output([b"BBO", b"BOC", b"OBB"]))

    def test_original_format_not_relaxed(self):
        for text in [b"[A]\n", b"[ A ]", b"A\n", b"[  A ]\n"]:
            with self.subTest(text=text), self.assertRaises(ReviewError):
                check_permutations(b"A", text)

    def test_empty_non_ascii_and_budget_rejected(self):
        for raw in [b" \n", b"\x00A", b"\xffA", b"ABCDEFGHI"]:
            with self.subTest(raw=raw), self.assertRaises(ReviewError):
                permutation_domain(raw)


class TropicalReview(unittest.TestCase):
    def test_non_hamiltonian_star_optimum_is_three(self):
        self.assertEqual(check_tropical(STAR, b"1-0-2\n3\n")["optimal_colors"], 3)

    def test_source_terminal_newline_can_be_absent(self):
        self.assertTrue(check_tropical(STAR, b"1-0-2\n3")["checked"])

    def test_legal_but_suboptimal_path(self):
        with self.assertRaises(ReviewError):
            check_tropical(STAR, b"0-1\n2\n")

    def test_wrong_printed_color_count(self):
        with self.assertRaises(ReviewError):
            check_tropical(STAR, b"1-0-2\n4\n")

    def test_nonedge(self):
        with self.assertRaises(ReviewError):
            check_tropical(STAR, b"0-1-2\n3\n")

    def test_repeated_vertex(self):
        with self.assertRaises(ReviewError):
            check_tropical(STAR, b"1-0-1\n2\n")

    def test_out_of_range_vertex(self):
        with self.assertRaises(ReviewError):
            check_tropical(STAR, b"1-0-7\n3\n")

    def test_duplicate_reverse_edge_rejected(self):
        with self.assertRaises(ReviewError):
            tropical_domain(b"3 3\n0 1 2\n3\n0 1\n1 0\n1 2\n")

    def test_disconnected_input_not_in_conservative_subset(self):
        with self.assertRaises(ReviewError):
            tropical_domain(b"4 4\n0 1 2 3\n3\n0 1\n0 2\n1 2\n")

    def test_self_loop_rejected(self):
        with self.assertRaises(ReviewError):
            tropical_domain(b"3 3\n0 1 2\n3\n0 1\n1 2\n0 0\n")

    def test_declared_color_count_rejected(self):
        with self.assertRaises(ReviewError):
            tropical_domain(b"3 3\n0 1 1\n2\n0 1\n1 2\n")

    def test_truncated_noninteger_and_extra_input(self):
        for raw in [b"4 4\n0", b"3 2\n0 a 1\n2\n0 1\n1 2\n", STAR + b"99\n"]:
            with self.subTest(raw=raw), self.assertRaises(ReviewError):
                tropical_domain(raw)

    def test_repeated_colors_connected_graph(self):
        raw = b"4 2\n0 1 0 1\n3\n0 1\n1 2\n2 3\n"
        self.assertTrue(check_tropical(raw, b"0-1\n2\n")["checked"])

    def test_public_complete_graph_example(self):
        raw = b"4 3\n0 1 2 1\n6\n0 1\n0 2\n0 3\n1 2\n1 3\n2 3\n"
        self.assertTrue(check_tropical(raw, b"0-1-2\n3")["checked"])

    def test_subset_oracle_against_all_vertex_sequences(self):
        # All simple undirected graphs on four vertices, both repeated/distinct
        # colors. The second calculation enumerates sequences, not subset states.
        n = 4
        possible = list(itertools.combinations(range(n), 2))
        for flags in itertools.product([False, True], repeat=len(possible)):
            edges = {edge for edge, flag in zip(possible, flags) if flag}
            for labels in [[0, 1, 0, 1], [0, 1, 2, 3]]:
                colors = len(set(labels))
                raw = (f"{n} {colors}\n" + " ".join(map(str, labels))
                       + f"\n{len(edges)}\n"
                       + "\n".join(f"{left} {right}" for left, right in sorted(edges))
                       + "\n").encode()
                try:
                    domain = tropical_domain(raw)
                except ReviewError:
                    continue
                maximum = 1
                for size in range(2, n + 1):
                    for path in itertools.permutations(range(n), size):
                        if all(tuple(sorted((left, right))) in edges
                               for left, right in itertools.pairwise(path)):
                            maximum = max(maximum, len({labels[v] for v in path}))
                self.assertEqual(_maximum_colors(domain), maximum)


class AdmissionGate(unittest.TestCase):
    def test_only_reviewed_subjects(self):
        self.assertTrue(input_domain("2020-tropical", STAR)["checked"])
        self.assertTrue(input_domain("2020-permutations", b"BOB")["checked"])
        for subject in ["2020-quicksort", "2020-primes", "2020-jacobi", "2023-path"]:
            with self.subTest(subject=subject), self.assertRaises(ReviewError):
                input_domain(subject, b"4\n")


if __name__ == "__main__":
    unittest.main(verbosity=2)

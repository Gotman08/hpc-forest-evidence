      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <ctype.h>\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nenum { KNN_INPUT_BLOCK_SIZE = 131072 };\nstatic unsigned char knn_input_block[KNN_INPUT_BLOCK_SIZE + 1];\nstatic size_t knn_input_position;\nstatic size_t knn_input_length;\n\nstatic int knn_input_peek(void) {\n    if (knn_input_position == knn_input_length) {\n        knn_input_length = fread(knn_input_block, 1,\n                                 KNN_INPUT_BLOCK_SIZE, stdin);\n        knn_input_position = 0;\n        knn_input_block[knn_input_length] = '\\0';\n        if (knn_input_length == 0) return EOF;\n    }\n    return knn_input_block[knn_input_position];\n}\n\nstatic int knn_input_get(void) {\n    int c = knn_input_peek();\n    if (c != EOF) ++knn_input_position;\n    return c;\n}\n\nstatic void knn_input_skip_space(void) {\n    int c;\n    while ((c = knn_input_peek()) != EOF && isspace((unsigned char) c)) {\n        ++knn_input_position;\n    }\n}\n\nstatic void knn_input_literal(const char *literal) {\n    while (*literal) {\n        if (knn_input_get() != (unsigned char) *literal++) on_error();\n    }\n}\n\nstatic int knn_input_int(void) {\n    knn_input_skip_space();\n    int c = knn_input_peek();\n    int negative = 0;\n    if (c == '+' || c == '-') {\n        negative = c == '-';\n        ++knn_input_position;\n        c = knn_input_peek();\n    }\n    if (c < '0' || c > '9') on_error();\n\n    unsigned int limit = negative ? 0U - (unsigned int) INT_MIN\n                                  : (unsigned int) INT_MAX;\n    unsigned int value = 0;\n    do {\n        unsigned int digit = (unsigned int) (c - '0');\n        if (value > (limit - digit) / 10U) on_error();\n        value = value * 10U + digit;\n        ++knn_input_position;\n        c = knn_input_peek();\n    } while (c >= '0' && c <= '9');\n\n    if (negative && value == limit) return INT_MIN;\n    return negative ? -(int) value : (int) value;\n}\n\nstatic void knn_input_append(char **text, size_t *used, size_t *capacity,\n                             const unsigned char *source, size_t length) {\n    if (length > SIZE_MAX - *used - 1) on_error();\n    size_t needed = *used + length + 1;\n    if (needed > *capacity) {\n        size_t grown = *capacity ? *capacity : 128;\n        while (grown < needed) {\n            if (grown > SIZE_MAX / 2) {\n                grown = needed;\n                break;\n            }\n            grown *= 2;\n        }\n        char *next = (char *) realloc(*text, grown);\n        if (next == NULL) on_error();\n        *text = next;\n        *capacity = grown;\n    }\n    memcpy(*text + *used, source, length);\n    *used += length;\n    (*text)[*used] = '\\0';\n}\n\nstatic float knn_input_convert_float(char *text, size_t length) {\n    char *end;\n    float value = strtof(text, &end);\n    if (end == text || end != text + length) on_error();\n    return value;\n}\n\nstatic float knn_input_float(void) {\n    knn_input_skip_space();\n    if (knn_input_peek() == EOF) on_error();\n\n    size_t start = knn_input_position;\n    size_t scan = start;\n    size_t parentheses = 0;\n    char *spilled = NULL;\n    size_t spilled_length = 0;\n    size_t spilled_capacity = 0;\n\n    for (;;) {\n        while (scan < knn_input_length) {\n            unsigned char c = knn_input_block[scan];\n            if (isspace(c) || c == ',' || (c == ')' && parentheses == 0)) {\n                break;\n            }\n            if (c == '(') ++parentheses;\n            else if (c == ')') --parentheses;\n            ++scan;\n        }\n\n        if (scan < knn_input_length) {\n            float value;\n            if (spilled == NULL) {\n                /* Ordinary tokens are converted directly in the input window. */\n                unsigned char saved = knn_input_block[scan];\n                knn_input_block[scan] = '\\0';\n                value = knn_input_convert_float(\n                    (char *) knn_input_block + start, scan - start);\n                knn_input_block[scan] = saved;\n            } else {\n                knn_input_append(&spilled, &spilled_length, &spilled_capacity,\n                                 knn_input_block + start, scan - start);\n                value = knn_input_convert_float(spilled, spilled_length);\n                free(spilled);\n            }\n            knn_input_position = scan;\n            return value;\n        }\n\n        /* Only tokens spanning a block boundary need a separate buffer. */\n        knn_input_append(&spilled, &spilled_length, &spilled_capacity,\n                         knn_input_block + start, scan - start);\n        knn_input_position = knn_input_length;\n        if (knn_input_peek() == EOF) {\n            float value = knn_input_convert_float(spilled, spilled_length);\n            free(spilled);\n            return value;\n        }\n        start = knn_input_position;\n        scan = start;\n    }\n}\n\nstatic int knn_input_point_in_window(Point *point) {\n    char *begin = (char *) knn_input_block;\n    char *limit = begin + knn_input_length;\n    char *cursor = begin + knn_input_position;\n    if (cursor == limit || *cursor != '(') return 0;\n\n    char *number = cursor + 1;\n    char *end;\n    float x = strtof(number, &end);\n    if (end == number || end >= limit) return 0;\n\n    cursor = end;\n    while (cursor < limit && isspace((unsigned char) *cursor)) ++cursor;\n    if (cursor == limit || *cursor != ',') return 0;\n\n    number = cursor + 1;\n    float y = strtof(number, &end);\n    if (end == number || end >= limit || *end != ')') return 0;\n\n    /* Commit only after the complete point is present in this window. */\n    point->x = x;\n    point->y = y;\n    knn_input_position = (size_t) (end + 1 - begin);\n    return 1;\n}\n\nint parse_number_of_groups() {\n    knn_input_skip_space();\n    knn_input_literal(\"n_groups=\");\n    int n = knn_input_int();\n    knn_input_skip_space();\n    return n;\n}\n\nPoint parse_point() {\n    knn_input_skip_space();\n\n    Point point;\n    if (knn_input_point_in_window(&point)) {\n        knn_input_skip_space();\n        return point;\n    }\n\n    knn_input_literal(\"(\");\n    point.x = knn_input_float();\n    knn_input_skip_space();\n    knn_input_literal(\",\");\n    point.y = knn_input_float();\n    knn_input_literal(\")\");\n    knn_input_skip_space();\n    return point;\n}\n\nGroup parse_next_group() {\n    knn_input_skip_space();\n    knn_input_literal(\"label=\");\n    int label = knn_input_get();\n    if (label == EOF) on_error();\n    knn_input_skip_space();\n    knn_input_literal(\"length=\");\n    int length = knn_input_int();\n    knn_input_skip_space();\n\n    Group group;\n    group.label = (char) label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    knn_input_skip_space();\n    knn_input_literal(\"k=\");\n    int k = knn_input_int();\n    knn_input_skip_space();\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}\n",
      "path": "src/knn.h"
    }
  ],
  "hypothesis": "Fusing coordinate parsing within the resident input window should eliminate duplicate token scans and temporary terminator writes while preserving strtof rounding.",

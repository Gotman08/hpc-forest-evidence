"""Seal only the local wrapper proposal and mechanical evidence; no remote operation."""
from __future__ import annotations

import hashlib
import json
import zipfile
from pathlib import Path

OUT = Path(__file__).resolve().parent


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def ref(path):
    return {"path": str(path), "sha256": sha(path)}


def save(name, value):
    path = OUT / name
    with path.open("x", encoding="utf8", newline="\n") as stream:
        stream.write(json.dumps(value, ensure_ascii=False, indent=2) + "\n")
    return ref(path)


before = json.loads((OUT / "preservation-avant.json").read_text(encoding="utf8"))["original_files"]
if any(sha(Path(name)) != expected for name, expected in before.items()):
    raise RuntimeError("A source/review/closed wrapper changed")
tests = (OUT / "tests-final.log").read_text(encoding="utf8")
ruff = (OUT / "ruff-final.log").read_text(encoding="utf8")
if "36 passed" not in tests or "All checks passed!" not in ruff:
    raise RuntimeError("Mechanical validation missing")
wrapper = (OUT / "qualification-wrapper.py").read_text(encoding="utf8")
body = wrapper.split('\nif __name__ == "__main__":', 1)[0]
command = (OUT / "commande-allouee-proposee-r2.sh").read_text(encoding="utf8")
if body not in command or sum(line.startswith("srun ") for line in command.splitlines()) != 1:
    raise RuntimeError("Final command does not embed exactly the checked wrapper with one srun")
active = {name: ref(OUT / name) for name in ("qualification-wrapper.py", "bindings-proposees.json",
    "commande-allouee-proposee-r2.sh", "demande-allocation-proposee-r2.json")}
save("validation-locale.json", {"schema": "hpc-forest-qualification-r2b-local-validation-v1", "verified_local_only": True,
    "mechanical_tests_passed": 36, "tests": ref(OUT / "tests-final.log"), "first_tests": ref(OUT / "tests-premier.log"),
    "ruff": "passed", "ruff_log": ref(OUT / "ruff-final.log"), "first_ruff_failure": ref(OUT / "ruff-premier.log"),
    "previous_source_review_exact": True, "previous_source_and_closed_wrapper_bytes_unchanged": before,
    "active": active, "one_srun_without_nested_srun_required": True, "flat_payload_members_verified": 160,
    "exact_source_zip_members_verified": 103, "complete_resolved_alias_identity_retained": True,
    "official_evaluator_trace_in_inner_archive_required": True, "summary_only_trace_not_admitted": True,
    "drafts_never_executed": ["commande-allouee-proposee.sh", "commande-allouee-proposee-r2.sh"],
    "wrapper_review_required_before_transport": True, "wrapper_review_verified": False,
    "romeo_calls": 0, "uploads": 0, "plans_prepared": 0, "jobs_submitted": 0,
    "c_compiler_model_cli_socket_executions": 0, "native_research_admitted": False})
files = {p.relative_to(OUT).as_posix(): sha(p) for p in sorted(OUT.rglob("*")) if p.is_file()
         and not any(x in {"__pycache__", ".pytest_cache", ".ruff_cache"} for x in p.relative_to(OUT).parts)}
save("manifeste-local.json", {"schema": "hpc-forest-qualification-r2b-local-manifest-v1", "files": files,
    "active": active, "status": "local_sealed_proposal_wrapper_review_required", "native_admission": False})
archive = OUT / "WRAPPER-QUALIFICATION-R2B.zip"
with zipfile.ZipFile(archive, "x", compression=zipfile.ZIP_DEFLATED, compresslevel=9) as output:
    for name in [*files, "manifeste-local.json"]:
        entry = zipfile.ZipInfo(name, (2026, 10, 18, 0, 0, 0))
        entry.external_attr = 0o100644 << 16
        entry.compress_type = zipfile.ZIP_DEFLATED
        output.writestr(entry, (OUT / name).read_bytes())
with zipfile.ZipFile(archive) as source:
    if len(source.namelist()) != len(files) + 1 or any(hashlib.sha256(source.read(name)).hexdigest() != sha(OUT / name) for name in source.namelist()):
        raise RuntimeError("Local wrapper archive bytes differ")
delivery = save("LIVRAISON-LOCALE.json", {"schema": "hpc-forest-qualification-r2b-local-delivery-v1",
    "status": "sealed_local_only_wrapper_review_required", "active": active, "archive": ref(archive),
    "manifest": ref(OUT / "manifeste-local.json"), "validation": ref(OUT / "validation-locale.json"),
    "mechanical_tests_passed": 36, "ruff": "passed", "source_and_historical_proofs_preserved": True,
    "remote_operations": 0, "native_model_calls": 0, "native_research_admitted": False,
    "wrapper_review_required_before_transport": True})
print(json.dumps({"delivery": delivery, "wrapper": active["qualification-wrapper.py"],
    "command": active["commande-allouee-proposee-r2.sh"], "bindings": active["bindings-proposees.json"],
    "archive": ref(archive)}, indent=2))

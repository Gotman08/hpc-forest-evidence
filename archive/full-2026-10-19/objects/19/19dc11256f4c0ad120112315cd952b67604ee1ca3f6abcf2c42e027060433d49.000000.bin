"""Bind seven actually received local pins in a NEW revision; no observation/effect."""
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
BASE = HERE.parents[2]
OLD = HERE / 'collecteurs-r2g-r1'
OUT = HERE / 'collecteurs-r2g-r2'
FACTORY = BASE / 'outputs/HPC-Forest-Primes-Natif-Lancement-r2g/revision-r1'
READER = HERE.parent / 'reception-premier-batch-r1'
NAMES = ('commun.py', 'preparer-intentions-natives.py', 'construire-observations-parent.py',
         'produire-current-r4.py', 'recevoir-installation-oauth.py')


def ref(path):
    assert path.is_file() and not path.is_symlink()
    return {'path': str(path.resolve()), 'sha256': hashlib.sha256(path.read_bytes()).hexdigest()}


def read(path):
    return json.loads(path.read_bytes())


def main():
    delivery = OLD / 'LIVRAISON-COLLECTEURS-PREPARES-POUR-REVUE.json'
    assert ref(delivery)['sha256'] == '57a9c37a802ce3232b0a074b5925354276a4917ef4108359a801391b21e799e3'
    manifest_ref = read(delivery)['manifest']
    manifest = Path(manifest_ref['path'])
    assert ref(manifest) == manifest_ref
    files = read(manifest)['components']
    assert all(ref(OLD / name)['sha256'] == files[name] for name in NAMES)
    paths = {
        'UNBOUND_FUTURE_R2G_FACTORY_REVIEW': READER / 'revue-externe-lancement/REVUE-FACTORY-R2G-SCELLEE.json',
        'UNBOUND_FUTURE_R2G_THREE_SCRIPT_REVIEW': READER / 'revue-collecteurs-parent-r1/LECTURE-TROIS-SCRIPTS-REELS.json',
        'UNBOUND_FUTURE_R2G_REAL_Q_BINDINGS': FACTORY / 'liaison-Q-reelle/source-bindings-reels-Q.json',
        'UNBOUND_FUTURE_RECONCILED_AND_STOPPED_R2F_CLOSURE': HERE / 'ADMISSION-FERMETURE-R2F.json'}
    refs = {key: ref(path) for key, path in paths.items()}
    assert refs['UNBOUND_FUTURE_R2G_FACTORY_REVIEW']['sha256'] == '71276c4991b5edb26654d72c6b84e82cbab008ba846175a1b019c5658b3864b6'
    assert refs['UNBOUND_FUTURE_RECONCILED_AND_STOPPED_R2F_CLOSURE']['sha256'] == '8d51a920f28690b166f9e6fc0f84b9898851f715fd3b476a1117ae444bb59270'
    script_review = read(paths['UNBOUND_FUTURE_R2G_THREE_SCRIPT_REVIEW'])
    assert script_review['verified'] is True and script_review['blocking_findings'] == []
    assert script_review['scope_id'] == 'hpc-forest-primes-native-max-r2g'
    replacements = {key: value['sha256'] for key, value in refs.items()}
    for model, label in (('gpt-6-astra', 'ASTRA'), ('gpt-5.6-terra', 'TERRA'), ('gpt-6.1-sol', 'SOL')):
        replacements['UNBOUND_FUTURE_R2G_' + label + '_SCRIPT'] = script_review['script_sha256_by_model'][model]
    assert len(replacements) == 7 and all(len(v) == 64 and set(v) <= set('0123456789abcdef') for v in replacements.values())
    texts = {name: (OLD / name).read_text('utf8') for name in NAMES}
    common = texts['commun.py']
    for before, after in replacements.items():
        assert common.count(before) == 1
        common = common.replace(before, after)
    assert 'UNBOUND_' not in common
    texts['commun.py'] = common
    checksum = hashlib.sha256(common.encode()).hexdigest()
    for name in ('preparer-intentions-natives.py', 'construire-observations-parent.py', 'recevoir-installation-oauth.py'):
        assert texts[name].count(files['commun.py']) == 1
        texts[name] = texts[name].replace(files['commun.py'], checksum)
    assert not OUT.exists()
    OUT.mkdir()
    for name, text in texts.items():
        compile(text, '<G-real-received-pin-derivative>', 'exec')
        with (OUT / name).open('x', encoding='utf8', newline='\n') as stream:
            stream.write(text)
    with (OUT / 'DELTA-SEPT-PINS-REELS.json').open('x', encoding='utf8') as stream:
        json.dump({'schema': 'hpc-forest-r2g-parent-real-pins-closed-delta-v1',
            'old_prepared_delivery': ref(delivery), 'replacements': replacements,
            'actual_evidence_refs': refs, 'components': {name: ref(OUT / name) for name in NAMES},
            'changed_only_seven_received_pins_and_three_COMMON_SHA_imports': True,
            'native_or_cli_or_auth_or_CIM_or_process_or_transport_effects': False,
            'requires_fresh_independent_delta_review_before_parent_use': True}, stream, indent=2)
        stream.write('\n')
    print(json.dumps(ref(OUT / 'DELTA-SEPT-PINS-REELS.json')))


if __name__ == '__main__':
    main()

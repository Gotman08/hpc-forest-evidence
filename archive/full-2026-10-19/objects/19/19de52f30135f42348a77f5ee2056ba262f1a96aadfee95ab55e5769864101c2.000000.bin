      "content": "{\"role\": \"G\", \"goal\": \"integration of diverse archived transformations; evaluate the full program\", \"experiment\": \"34dba38958ee4962\", \"ordinal\": 1, \"integration_source_ids\": [\"8e11618e12bb4139\", \"811d3a8a4b024d5b\", \"5baf8fe9de3a4dc9\", \"a8fba704a60d440d\", \"b8f048c265fa4c31\"], \"current_source_paths\": [\"src/bucketsort.c\"], \"context_as_data\": {\"sources\": [{\"id\": \"8e11618e12bb4139\", \"role\": \"A\", \"commit\": \"f8cec00c402ee05d267e55e23467958d9be93056\", \"transformations\": {\"files\": [\"src/bucketsort.c\"], \"retained\": [\"Count bucket sizes and prefix-sum them to form compact contiguous index ranges, then scatter each input index into its bucket range.\", \"Replace insertion sort with stable least-significant-byte counting passes over each bucket's string suffix, reusing a scratch array.\", \"Zero-initialize string storage so radix passes over the fixed-width slots preserve strcmp ordering for shorter tokens; use long-int loops for loading and output.\"]}, \"mean_seconds\": 0.011393191603322824, \"diff\": \"diff --git a/src/bucketsort.c b/src/bucketsort.c\\nindex 9987e6c..339672e 100644\\n--- a/src/bucketsort.c\\n+++ b/src/bucketsort.c\\n@@ -1,142 +1,179 @@\\n-#include <stdio.h>\\n-#include <stdlib.h>\\n-#include <assert.h>\\n-#include <string.h>\\n-\\n-typedef struct {\\n-\\tlong int *data;\\n-\\tint length;\\n-\\tlong int total;\\n-} bucket;\\n-\\n-void sort(char *a, bucket *bucket) {\\n-\\tint j, i, length;\\n-\\tlong int key;\\n-\\tlength = bucket->length;\\n-\\n-\\tfor (j = 1; j < bucket->total; j++) {\\n-\\t\\tkey = bucket->data[j];\\n-\\t\\ti = j - 1;\\n-\\t\\twhile (i >= 0 && strcmp(a + bucket->data[i] * length, a + key * length) > 0) {\\n-\\t\\t\\tbucket->data[i + 1] = bucket->data[i];\\n-\\t\\t\\ti--;\\n-\\t\\t}\\n-\\t\\tbucket->data[i + 1] = key;\\n-\\t}\\n-}\\n-\\n-\\n-long int* bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\\n-\\n-\\tlong int i;\\n-\\tbucket   *buckets = NULL,\\n-             *b = NULL;\\n-\\tlong int *returns = NULL;\\n-\\n-\\t// allocate memory\\n-\\treturns = (long int *) malloc(sizeof(long int) * size);\\n-\\tbuckets = (bucket   *) malloc(sizeof(bucket) * nbuckets);\\n-\\n-\\n-\\tfor (i = 0; i < nbuckets; i++) {\\n-\\t\\tbuckets[i].data = returns + i * size / nbuckets;\\n-\\t\\tbuckets[i].length = length;\\n-\\t\\tbuckets[i].total = 0;\\n-\\t}\\n-\\n-\\t// copy the keys to \\\"buckets\\\"\\n-\\tfor (i = 0; i < size; i++) {\\n-\\t\\tb = &buckets[*(a + i * length) - offset]; //mascara de deslocamento\\n-\\t\\tb->data[b->total++] = i;\\n-\\t}\\n-\\n-\\t// sort each \\\"bucket\\\"\\n-\\tfor (i = 0; i < nbuckets; i++)\\n-\\t\\tsort(a, &buckets[i]);\\n-\\n-\\treturn returns;\\n-}\\n-\\n-void load(char **vString, long int *N, int *l, int *os, int *nb){\\n-   char *strings = NULL;\\n-   int      len,\\n-            offset,\\n-            nbucket;\\n-   long int n;\\n-\\n-   if (!fscanf(stdin, \\\"%d\\\", &len)) {\\n-      printf (\\\"ERROR len\\\\n\\\");\\n-      exit (1);\\n-   }\\n-\\n-   if (!fscanf(stdin, \\\"%ld\\\", &n)) {\\n-      printf (\\\"ERROR n\\\\n\\\");\\n-      exit (1);\\n-   }\\n-\\n-   if (!fscanf(stdin, \\\"%d\\\", &offset)) {\\n-      printf (\\\"ERROR offset\\\\n\\\");\\n-      exit (1);\\n-   }\\n-\\n-   if (!fscanf(stdin, \\\"%d\\\", &nbucket)) {\\n-      printf (\\\"ERROR nbucket\\\\n\\\");\\n-      exit (1);\\n-   }\\n-\\n-   nbucket = nbucket + 1;\\n-   len = len + 1;\\n-\\n-   strings = (char*) malloc(n * len);\\n-\\n-   for (int i = 0; i < n; i++){\\n-      if (!fscanf(stdin, \\\"%s\\\", strings + (i * len))) {\\n-      printf (\\\"ERROR %d\\\\n\\\",i);\\n-      exit (1);\\n-      }\\n-   }\\n-\\n-   *vString = strings;\\n-   *N = n;\\n-   *l = len;\\n-   *os = offset;\\n-   *nb = nbucket;\\n-}\\n-\\n-void print(char *strings, long int *index, long int n, int len){\\n-\\n-   for (int i = 0; i < n; i++){\\n-      printf(\\\"%d -> %s\\\\n\\\", i, strings + (index[i] * len));\\n-   }\\n-}\\n-\\n-void save(char *strings, long int *index, long int n, int len){\\n-   for (int i = 0; i < n; i++){\\n-      printf(\\\"%s\\\\n\\\", strings + (index[i] * len));\\n-   }\\n-}\\n-\\n-int main(int ac, char **av) {\\n-\\n-   char     *strings = NULL;\\n-   long int N        = 0;\\n-   long int *index   = NULL;\\n-   int      len      = 0,\\n-            save2File = 0,\\n-            offset,\\n-            nbuckets;\\n-\\n-   load(&strings, &N, &len, &offset, &nbuckets);\\n-\\n-   index = bucket_sort(strings, len, N, offset, nbuckets);\\n-\\n-   save(strings, index, N, len);\\n-\\n-   if (strings != NULL)\\n-      free(strings);\\n-\\n-   if (index != NULL)\\n-      free(index);\\n-\\n-   return EXIT_SUCCESS;\\n-}\\n+#include <stdio.h>\\n+#include <stdlib.h>\\n+#include <assert.h>\\n+#include <string.h>\\n+\\n+typedef struct {\\n+\\tlong int start;\\n+\\tlong int total;\\n+} bucket;\\n+\\n+void sort(char *a, bucket *b, long int *indices, long int *scratch, int length) {\\n+\\tlong int count = b->total;\\n+\\tlong int start = b->start;\\n+\\tlong int *src = indices;\\n+\\tlong int *dst = scratch;\\n+\\tint pos;\\n+\\n+\\tif (count < 2 || length <= 1)\\n+\\t\\treturn;\\n+\\n+\\t/* Stable least-significant-byte passes preserve strcmp ordering. */\\n+\\tfor (pos = length - 1; pos > 0; pos--) {\\n+\\t\\tsize_t counts[256] = {0};\\n+\\t\\tsize_t next[256];\\n+\\t\\tsize_t prefix = 0;\\n+\\t\\tlong int j;\\n+\\t\\tint c;\\n+\\n+\\t\\tfor (j = 0; j < count; j++) {\\n+\\t\\t\\tunsigned char key = (unsigned char)a[src[start + j] * length + pos];\\n+\\t\\t\\tcounts[key]++;\\n+\\t\\t}\\n+\\n+\\t\\tfor (c = 0; c < 256; c++) {\\n+\\t\\t\\tnext[c] = prefix;\\n+\\t\\t\\tprefix += counts[c];\\n+\\t\\t}\\n+\\n+\\t\\tfor (j = 0; j < count; j++) {\\n+\\t\\t\\tunsigned char key = (unsigned char)a[src[start + j] * length + pos];\\n+\\t\\t\\tdst[start + next[key]++] = src[start + j];\\n+\\t\\t}\\n+\\n+\\t\\t{\\n+\\t\\t\\tlong int *tmp = src;\\n+\\t\\t\\tsrc = dst;\\n+\\t\\t\\tdst = tmp;\\n+\\t\\t}\\n+\\t}\\n+\\n+\\tif (src != indices)\\n+\\t\\tmemcpy(indices + start, src + start, sizeof(*indices) * (size_t)count);\\n+}\\n+\\n+long int* bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\\n+\\tlong int i;\\n+\\tlong int *returns;\\n+\\tlong int *scratch;\\n+\\tlong int *cursor;\\n+\\tbucket *buckets;\\n+\\tlong int prefix = 0;\\n+\\n+\\tif (size <= 0 || nbuckets <= 0)\\n+\\t\\treturn NULL;\\n+\\n+\\treturns = (long int *)malloc(sizeof(long int) * (size_t)size);\\n+\\tscratch = (long int *)malloc(sizeof(long int) * (size_t)size);\\n+\\tbuckets = (bucket *)calloc((size_t)nbuckets, sizeof(bucket));\\n+\\tcursor = (long int *)malloc(sizeof(long int) * (size_t)nbuckets);\\n+\\n+\\t/* Count each bucket first, then assign compact contiguous index ranges. */\\n+\\tfor (i = 0; i < size; i++) {\\n+\\t\\tint which = *(a + i * length) - offset;\\n+\\t\\tbuckets[which].total++;\\n+\\t}\\n+\\n+\\tfor (i = 0; i < nbuckets; i++) {\\n+\\t\\tbuckets[i].start = prefix;\\n+\\t\\tcursor[i] = prefix;\\n+\\t\\tprefix += buckets[i].total;\\n+\\t}\\n+\\n+\\tfor (i = 0; i < size; i++) {\\n+\\t\\tint which = *(a + i * length) - offset;\\n+\\t\\treturns[cursor[which]++] = i;\\n+\\t}\\n+\\n+\\tfor (i = 0; i < nbuckets; i++)\\n+\\t\\tsort(a, &buckets[i], returns, scratch, length);\\n+\\n+\\tfree(cursor);\\n+\\tfree(buckets);\\n+\\tfree(scratch);\\n+\\treturn returns;\\n+}\\n+\\n+void load(char **vString, long int *N, int *l, int *os, int *nb){\\n+   char *strings = NULL;\\n+   int      len,\\n+            offset,\\n+            nbucket;\\n+   long int n;\\n+\\n+   if (!fscanf(stdin, \\\"%d\\\", &len)) {\\n+      printf (\\\"ERROR len\\\\n\\\");\\n+      exit (1);\\n+   }\\n+\\n+   if (!fscanf(stdin, \\\"%ld\\\", &n)) {\\n+      printf (\\\"ERROR n\\\\n\\\");\\n+      exit (1);\\n+   }\\n+\\n+   if (!fscanf(stdin, \\\"%d\\\", &offset)) {\\n+      printf (\\\"ERROR offset\\\\n\\\");\\n+      exit (1);\\n+   }\\n+\\n+   if (!fscanf(stdin, \\\"%d\\\", &nbucket)) {\\n+      printf (\\\"ERROR nbucket\\\\n\\\");\\n+      exit (1);\\n+   }\\n+\\n+   nbucket = nbucket\"}, {\"id\": \"811d3a8a4b024d5b\", \"role\": \"B\", \"commit\": \"0108834262345aef356edb6aa60f301dfc022408\", \"transformations\": {\"files\": [\"src/bucketsort.c\"], \"retained\": [\"Count bucket sizes and use prefix offsets for correctly sized, disjoint storage instead of fixed equal-sized slices.\", \"Replace dependent insertion-sort shifts with qsort for each bucket.\", \"Parallelize independent bucket sorts with a dynamically scheduled OpenMP loop; leave potentially conflicting histogram and scatter updates serial.\"]}, \"mean_seconds\": 0.011592260872324308, \"diff\": \"diff --git a/src/bucketsort.c b/src/bucketsort.c\\nindex 9987e6c..bc2738a 100644\\n--- a/src/bucketsort.c\\n+++ b/src/bucketsort.c\\n@@ -1,142 +1,145 @@\\n-#include <stdio.h>\\n-#include <stdlib.h>\\n-#include <assert.h>\\n-#include <string.h>\\n-\\n-typedef struct {\\n-\\tlong int *data;\\n-\\tint length;\\n-\\tlong int total;\\n-} bucket;\\n-\\n-void sort(char *a, bucket *bucket) {\\n-\\tint j, i, length;\\n-\\tlong int key;\\n-\\tlength = bucket->length;\\n-\\n-\\tfor (j = 1; j < bucket->total; j++) {\\n-\\t\\tkey = bucket->data[j];\\n-\\t\\ti = j - 1;\\n-\\t\\twhile (i >= 0 && strcmp(a + bucket->data[i] * length, a + key * length) > 0) {\\n-\\t\\t\\tbucket->data[i + 1] = bucket->data[i];\\n-\\t\\t\\ti--;\\n-\\t\\t}\\n-\\t\\tbucket->data[i + 1] = key;\\n-\\t}\\n-}\\n-\\n-\\n-long int* bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\\n-\\n-\\tlong int i;\\n-\\tbucket   *buckets = NULL,\\n-             *b = NULL;\\n-\\tlong int *returns = NULL;\\n-\\n-\\t// allocate memory\\n-\\treturns = (long int *) malloc(sizeof(long int) * size);\\n-\\tbuckets = (bucket   *) malloc(sizeof(bucket) * nbuckets);\\n-\\n-\\n-\\tfor (i = 0; i < nbuckets; i++) {\\n-\\t\\tbuckets[i].data = returns + i * size / nbuckets;\\n-\\t\\tbuckets[i].length = length;\\n-\\t\\tbuckets[i].total = 0;\\n-\\t}\\n-\\n-\\t// copy the keys to \\\"buckets\\\"\\n-\\tfor (i = 0; i < size; i++) {\\n-\\t\\tb = &buckets[*(a + i * length) - offset]; //mascara de deslocamento\\n-\\t\\tb->data[b->total++] = i;\\n-\\t}\\n-\\n-\\t// sort each \\\"bucket\\\"\\n-\\tfor (i = 0; i < nbuckets; i++)\\n-\\t\\tsort(a, &buckets[i]);\\n-\\n-\\treturn returns;\\n-}\\n-\\n-void load(char **vString, long int *N, int *l, int *os, int *nb){\\n-   char *strings = NULL;\\n-   int      len,\\n-            offset,\\n-            nbucket;\\n-   long int n;\\n-\\n-   if (!fscanf(stdin, \\\"%d\\\", &len)) {\\n-      printf (\\\"ERROR len\\\\n\\\");\\n-      exit (1);\\n-   }\\n-\\n-   if (!fscanf(stdin, \\\"%ld\\\", &n)) {\\n-      printf (\\\"ERROR n\\\\n\\\");\\n-      exit (1);\\n-   }\\n-\\n-   if (!fscanf(stdin, \\\"%d\\\", &offset)) {\\n-      printf (\\\"ERROR offset\\\\n\\\");\\n-      exit (1);\\n-   }\\n-\\n-   if (!fscanf(stdin, \\\"%d\\\", &nbucket)) {\\n-      printf (\\\"ERROR nbucket\\\\n\\\");\\n-      exit (1);\\n-   }\\n-\\n-   nbucket = nbucket + 1;\\n-   len = len + 1;\\n-\\n-   strings = (char*) malloc(n * len);\\n-\\n-   for (int i = 0; i < n; i++){\\n-      if (!fscanf(stdin, \\\"%s\\\", strings + (i * len))) {\\n-      printf (\\\"ERROR %d\\\\n\\\",i);\\n-      exit (1);\\n-      }\\n-   }\\n-\\n-   *vString = strings;\\n-   *N = n;\\n-   *l = len;\\n-   *os = offset;\\n-   *nb = nbucket;\\n-}\\n-\\n-void print(char *strings, long int *index, long int n, int len){\\n-\\n-   for (int i = 0; i < n; i++){\\n-      printf(\\\"%d -> %s\\\\n\\\", i, strings + (index[i] * len));\\n-   }\\n-}\\n-\\n-void save(char *strings, long int *index, long int n, int len){\\n-   for (int i = 0; i < n; i++){\\n-      printf(\\\"%s\\\\n\\\", strings + (index[i] * len));\\n-   }\\n-}\\n-\\n-int main(int ac, char **av) {\\n-\\n-   char     *strings = NULL;\\n-   long int N        = 0;\\n-   long int *index   = NULL;\\n-   int      len      = 0,\\n-            save2File = 0,\\n-            offset,\\n-            nbuckets;\\n-\\n-   load(&strings, &N, &len, &offset, &nbuckets);\\n-\\n-   index = bucket_sort(strings, len, N, offset, nbuckets);\\n-\\n-   save(strings, index, N, len);\\n-\\n-   if (strings != NULL)\\n-      free(strings);\\n-\\n-   if (index != NULL)\\n-      free(index);\\n-\\n-   return EXIT_SUCCESS;\\n-}\\n+#include <stdio.h>\\n+#include <stdlib.h>\\n+#include <string.h>\\n+\\n+typedef struct {\\n+    long int start;\\n+    long int total;\\n+    long int next;\\n+} bucket;\\n+\\n+static char *sort_strings;\\n+static int sort_length;\\n+\\n+static int compare_indices(const void *left, const void *right) {\\n+    long int a = *(const long int *)left;\\n+    long int b = *(const long int *)right;\\n+\\n+    return strcmp(sort_strings + a * sort_length,\\n+                  sort_strings + b * sort_length);\\n+}\\n+\\n+long int *bucket_sort(char *a, int length, long int size, int offset,\\n+                      int nbuckets) {\\n+    long int *returns = malloc(sizeof(*returns) * (size > 0 ? size : 1));\\n+    bucket *buckets = calloc((size_t)nbuckets, sizeof(*buckets));\\n+    long int i;\\n+    long int prefix = 0;\\n+\\n+    for (i = 0; i < size; i++) {\\n+        int bucket_index = (unsigned char)a[i * length] - offset;\\n+        buckets[bucket_index].total++;\\n+    }\\n+\\n+    for (i = 0; i < nbuckets; i++) {\\n+        buckets[i].start = prefix;\\n+        buckets[i].next = prefix;\\n+        prefix += buckets[i].total;\\n+    }\\n+\\n+    for (i = 0; i < size; i++) {\\n+        int bucket_index = (unsigned char)a[i * length] - offset;\\n+        buckets[bucket_index].next++;\\n+        returns[buckets[bucket_index].next - 1] = i;\\n+    }\\n+\\n+    sort_strings = a;\\n+    sort_length = length;\\n+\\n+    /* Each bucket owns a disjoint index range; the histogram and scatter\\n+       above remain serial because multiple elements can update one bucket. */\\n+    #pragma omp parallel for schedule(dynamic, 1) if (size > (long int)nbuckets * 64)\\n+    for (i = 0; i < nbuckets; i++) {\\n+        qsort(returns + buckets[i].start, (size_t)buckets[i].total,\\n+              sizeof(*returns), compare_indices);\\n+    }\\n+\\n+    free(buckets);\\n+    return returns;\\n+}\\n+\\n+void load(char **vString, long int *N, int *l, int *os, int *nb) {\\n+    char *strings = NULL;\\n+    int len;\\n+    int offset;\\n+    int nbucket;\\n+    long int n;\\n+    long int i;\\n+\\n+    if (!fscanf(stdin, \\\"%d\\\", &len)) {\\n+        printf(\\\"ERROR len\\\\n\\\");\\n+        exit(1);\\n+    }\\n+\\n+    if (!fscanf(stdin, \\\"%ld\\\", &n)) {\\n+        printf(\\\"ERROR n\\\\n\\\");\\n+        exit(1);\\n+    }\\n+\\n+    if (!fscanf(stdin, \\\"%d\\\", &offset)) {\\n+        printf(\\\"ERROR offset\\\\n\\\");\\n+        exit(1);\\n+    }\\n+\\n+    if (!fscanf(stdin, \\\"%d\\\", &nbucket)) {\\n+        printf(\\\"ERROR nbucket\\\\n\\\");\\n+        exit(1);\\n+    }\\n+\\n+    nbucket = nbucket + 1;\\n+    len = len + 1;\\n+\\n+    strings = (char *)malloc(n * len);\\n+\\n+    for (i = 0; i < n; i++) {\\n+        if (!fscanf(stdin, \\\"%s\\\", strings + (i * len))) {\\n+            printf(\\\"ERROR %ld\\\\n\\\", i);\\n+            exit(1);\\n+        }\\n+    }\\n+\\n+    *vString = strings;\\n+    *N = n;\\n+    *l = len;\\n+    *os = offset;\\n+    *nb = nbucket;\\n+}\\n+\\n+void print(char *strings, long int *index, long int n, int len) {\\n+    long int i;\\n+\\n+    for (i = 0; i < n; i++) {\\n+     \"}, {\"id\": \"5baf8fe9de3a4dc9\", \"role\": \"A\", \"commit\": \"eed175bb4766bc0f151dfd639e3d483fa6a51354\", \"transformations\": {\"files\": [\"src/bucketsort.c\"], \"retained\": [\"Replace equal fixed-capacity bucket slices with count, prefix-sum, and scatter into compact contiguous index ranges.\", \"Sort each bucket's compact range with qsort using strcmp on the original strings.\"]}, \"mean_seconds\": 0.012494396107892195, \"diff\": \"diff --git a/src/bucketsort.c b/src/bucketsort.c\\nindex 9987e6c..e2
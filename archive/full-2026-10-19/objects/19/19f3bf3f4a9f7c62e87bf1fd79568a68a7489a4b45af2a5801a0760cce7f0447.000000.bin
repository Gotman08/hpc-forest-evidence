{
  "src/model-view/primetest.c": "#include <inttypes.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n\nenum { SUFFIX_SCALE = 10000000U };\n\nstatic inline uint32_t modular_power(uint32_t base, uint32_t exponent,\n                                     uint32_t modulus)\n{\n    uint64_t result = 1U;\n    uint64_t factor = base;\n\n    while (exponent != 0U) {\n        if ((exponent & 1U) != 0U) {\n            result = (result * factor) % modulus;\n        }\n        exponent >>= 1;\n        if (exponent != 0U) {\n            factor = (factor * factor) % modulus;\n        }\n    }\n    return (uint32_t)result;\n}\n\nstatic inline int is_prime(uint32_t value)\n{\n    static const uint32_t bases[] = { 2U, 7U, 61U };\n    uint32_t d;\n    unsigned int shifts = 0U;\n    size_t i;\n\n    if (value < 2U) {\n        return 0;\n    }\n    if ((value & 1U) == 0U) {\n        return value == 2U;\n    }\n    if (value % 3U == 0U) {\n        return value == 3U;\n    }\n    if (value % 5U == 0U) {\n        return value == 5U;\n    }\n    if (value % 7U == 0U) {\n        return value == 7U;\n    }\n    if (value % 11U == 0U) {\n        return value == 11U;\n    }\n    if (value % 13U == 0U) {\n        return value == 13U;\n    }\n\n    d = value - 1U;\n    while ((d & 1U) == 0U) {\n        d >>= 1;\n        ++shifts;\n    }\n\n    for (i = 0U; i < sizeof bases / sizeof bases[0]; ++i) {\n        const uint32_t base = bases[i] % value;\n        uint32_t x;\n        unsigned int round;\n\n        if (base == 0U) {\n            continue;\n        }\n        x = modular_power(base, d, value);\n        if (x == 1U || x == value - 1U) {\n            continue;\n        }\n        for (round = 1U; round < shifts; ++round) {\n            x = (uint32_t)(((uint64_t)x * x) % value);\n            if (x == value - 1U) {\n                break;\n            }\n        }\n        if (round == shifts) {\n            return 0;\n        }\n    }\n    return 1;\n}\n\nstatic void sort_values(uint32_t *values, size_t count)\n{\n    size_t i;\n\n    for (i = 1U; i < count; ++i) {\n        const uint32_t value = values[i];\n        size_t j = i;\n\n        while (j != 0U && values[j - 1U] > value) {\n            values[j] = values[j - 1U];\n            --j;\n        }\n        values[j] = value;\n    }\n}\n\nint main(void)\n{\n    unsigned int input_count;\n    size_t count;\n    size_t pair_count;\n    size_t result_count = 0U;\n    size_t i;\n    uint32_t *left;\n    uint32_t *right;\n    uint32_t *output;\n\n    if (fscanf(stdin, \"%u\", &input_count) != 1 || input_count == 0U) {\n        return 0;\n    }\n\n    count = (size_t)input_count;\n    if (count > SIZE_MAX / count) {\n        return 1;\n    }\n    pair_count = count * count;\n    if (pair_count > SIZE_MAX / sizeof *output) {\n        return 1;\n    }\n\n    left = malloc(count * sizeof *left);\n    right = malloc(count * sizeof *right);\n    output = malloc(pair_count * sizeof *output);\n    if (left == NULL || right == NULL || output == NULL) {\n        free(output);\n        free(right);\n        free(left);\n        return 1;\n    }\n\n    for (i = 0U; i < count; ++i) {\n        if (fscanf(stdin, \"%\" SCNu32, &left[i]) != 1) {\n            free(output);\n            free(right);\n            free(left);\n            return 1;\n        }\n        left[i] = (uint32_t)((uint64_t)left[i] * SUFFIX_SCALE);\n    }\n    for (i = 0U; i < count; ++i) {\n        if (fscanf(stdin, \"%\" SCNu32, &right[i]) != 1) {\n            free(output);\n            free(right);\n            free(left);\n            return 1;\n        }\n    }\n\n    for (i = 0U; i < count; ++i) {\n        const uint32_t base = left[i];\n        size_t j;\n\n        for (j = 0U; j < count; ++j) {\n            const uint32_t candidate = base + right[j];\n\n            if (is_prime(candidate)) {\n                output[result_count++] = candidate;\n            }\n        }\n    }\n\n    sort_values(output, result_count);\n    for (i = 0U; i < result_count; ++i) {\n        printf(\"%\" PRIu32 \"\\n\", output[i]);\n    }\n\n    free(output);\n    free(right);\n    free(left);\n    return 0;\n}\n",
  "src/sources/primetest.c": "#include <inttypes.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n\nenum { SUFFIX_SCALE = 10000000U };\n\nstatic inline uint32_t modular_power(uint32_t base, uint32_t exponent,\n                                     uint32_t modulus)\n{\n    uint64_t result = 1U;\n    uint64_t factor = base;\n\n    while (exponent != 0U) {\n        if ((exponent & 1U) != 0U) {\n            result = (result * factor) % modulus;\n        }\n        exponent >>= 1;\n        if (exponent != 0U) {\n            factor = (factor * factor) % modulus;\n        }\n    }\n    return (uint32_t)result;\n}\n\nstatic inline int is_prime(uint32_t value)\n{\n    static const uint32_t bases[] = { 2U, 7U, 61U };\n    uint32_t d;\n    unsigned int shifts = 0U;\n    size_t i;\n\n    if (value < 2U) {\n        return 0;\n    }\n    if ((value & 1U) == 0U) {\n        return value == 2U;\n    }\n    if (value % 3U == 0U) {\n        return value == 3U;\n    }\n    if (value % 5U == 0U) {\n        return value == 5U;\n    }\n    if (value % 7U == 0U) {\n        return value == 7U;\n    }\n    if (value % 11U == 0U) {\n        return value == 11U;\n    }\n    if (value % 13U == 0U) {\n        return value == 13U;\n    }\n\n    d = value - 1U;\n    while ((d & 1U) == 0U) {\n        d >>= 1;\n        ++shifts;\n    }\n\n    for (i = 0U; i < sizeof bases / sizeof bases[0]; ++i) {\n        const uint32_t base = bases[i] % value;\n        uint32_t x;\n        unsigned int round;\n\n        if (base == 0U) {\n            continue;\n        }\n        x = modular_power(base, d, value);\n        if (x == 1U || x == value - 1U) {\n            continue;\n        }\n        for (round = 1U; round < shifts; ++round) {\n            x = (uint32_t)(((uint64_t)x * x) % value);\n            if (x == value - 1U) {\n                break;\n            }\n        }\n        if (round == shifts) {\n            return 0;\n        }\n    }\n    return 1;\n}\n\nstatic void sort_values(uint32_t *values, size_t count)\n{\n    size_t i;\n\n    for (i = 1U; i < count; ++i) {\n        const uint32_t value = values[i];\n        size_t j = i;\n\n        while (j != 0U && values[j - 1U] > value) {\n            values[j] = values[j - 1U];\n            --j;\n        }\n        values[j] = value;\n    }\n}\n\nint main(void)\n{\n    unsigned int input_count;\n    size_t count;\n    size_t pair_count;\n    size_t result_count = 0U;\n    size_t i;\n    uint32_t *left;\n    uint32_t *right;\n    uint32_t *output;\n\n    if (fscanf(stdin, \"%u\", &input_count) != 1 || input_count == 0U) {\n        return 0;\n    }\n\n    count = (size_t)input_count;\n    if (count > SIZE_MAX / count) {\n        return 1;\n    }\n    pair_count = count * count;\n    if (pair_count > SIZE_MAX / sizeof *output) {\n        return 1;\n    }\n\n    left = malloc(count * sizeof *left);\n    right = malloc(count * sizeof *right);\n    output = malloc(pair_count * sizeof *output);\n    if (left == NULL || right == NULL || output == NULL) {\n        free(output);\n        free(right);\n        free(left);\n        return 1;\n    }\n\n    for (i = 0U; i < count; ++i) {\n        if (fscanf(stdin, \"%\" SCNu32, &left[i]) != 1) {\n            free(output);\n            free(right);\n            free(left);\n            return 1;\n        }\n        left[i] = (uint32_t)((uint64_t)left[i] * SUFFIX_SCALE);\n    }\n    for (i = 0U; i < count; ++i) {\n        if (fscanf(stdin, \"%\" SCNu32, &right[i]) != 1) {\n            free(output);\n            free(right);\n            free(left);\n            return 1;\n        }\n    }\n\n    for (i = 0U; i < count; ++i) {\n        const uint32_t base = left[i];\n        size_t j;\n\n        for (j = 0U; j < count; ++j) {\n            const uint32_t candidate = base + right[j];\n\n            if (is_prime(candidate)) {\n                output[result_count++] = candidate;\n            }\n        }\n    }\n\n    sort_values(output, result_count);\n    for (i = 0U; i < result_count; ++i) {\n        printf(\"%\" PRIu32 \"\\n\", output[i]);\n    }\n\n    free(output);\n    free(right);\n    free(left);\n    return 0;\n}\n"
}

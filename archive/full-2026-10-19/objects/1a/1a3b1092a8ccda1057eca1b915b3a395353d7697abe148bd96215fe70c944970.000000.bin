#include "knn.h"
#include <limits.h>
#include <stdint.h>

enum { DISTANCE_BATCH_SIZE = 256 };

typedef struct {
    float distance;
    int group;
} Neighbor;

/* Preserve the original insertion behavior for unordered distances. */
static char knn_insertion(int n_groups, Group *groups, int k,
                          Point to_evaluate) {
    char *labels = (char *) malloc(sizeof(char) * k);
    float *distances = (float *) malloc(sizeof(float) * k);
    int i, j, x, y;

    for (i = 0; i < k; i++) {
        labels[i] = -1;
        distances[i] = -1;
    }

    for (i = 0; i < n_groups; i++) {
        Group g = groups[i];
        for (j = 0; j < g.length; j++) {
            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);
            for (x = 0; x < k; x++) {
                if (d < distances[x] || distances[x] == -1) {
                    for (y = k - 1; y > x; y--) {
                        distances[y] = distances[y - 1];
                        labels[y] = labels[y - 1];
                    }
                    distances[x] = d;
                    labels[x] = g.label;
                    break;
                }
            }
        }
    }

    qsort(labels, k, sizeof(char), compare_for_sort);
    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }
            current_frequency = 1;
        } else {
            current_frequency++;
        }
        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    free(distances);
    free(labels);
    return most_frequent;
}

/* Within a group, equal-distance points have indistinguishable labels. */
static int neighbor_before(const Neighbor *a, const Neighbor *b) {
    return a->distance < b->distance ||
           (a->distance == b->distance && a->group < b->group);
}

static void heap_sift_down(Neighbor *heap, size_t count, size_t root) {
    Neighbor value = heap[root];
    while (root < count / 2) {
        size_t child = root * 2 + 1;
        if (child + 1 < count &&
            neighbor_before(&heap[child], &heap[child + 1])) {
            child++;
        }
        if (!neighbor_before(&value, &heap[child])) {
            break;
        }
        heap[root] = heap[child];
        root = child;
    }
    heap[root] = value;
}

static void heap_build(Neighbor *heap, size_t count) {
    for (size_t parent = count / 2; parent != 0;) {
        parent--;
        heap_sift_down(heap, count, parent);
    }
}

/* This loop has no selection dependencies or overlapping writes. */
static void distance_batch(const Point *restrict points,
                           float *restrict distances, int count,
                           Point to_evaluate) {
    for (int i = 0; i < count; i++) {
        distances[i] = euclidean_distance_no_sqrt(to_evaluate, points[i]);
    }
}

static char label_from_counts(const size_t counts[UCHAR_MAX + 1]) {
    char best_label = (char)-1;
    size_t best_count = 0;
    for (int value = 0; value <= UCHAR_MAX; value++) {
        char label = (char)(unsigned char)value;
        if (counts[value] > best_count ||
            (counts[value] != 0 && counts[value] == best_count &&
             label < best_label)) {
            best_label = label;
            best_count = counts[value];
        }
    }
    return best_label;
}

char knn(int n_groups, Group *groups, int k, Point to_evaluate) {
    if (k <= 0) {
        return knn_insertion(n_groups, groups, k, to_evaluate);
    }

    size_t capacity = (size_t)k;
    size_t total_points = 0;
    for (int i = 0; i < n_groups; i++) {
        if (groups[i].length > 0) {
            size_t length = (size_t)groups[i].length;
            if (length > SIZE_MAX - total_points) {
                return knn_insertion(n_groups, groups, k, to_evaluate);
            }
            total_points += length;
        }
    }

    /* Every point occupies a slot in this case, including NaNs. */
    if (total_points <= capacity) {
        size_t counts[UCHAR_MAX + 1] = {0};
        for (int i = 0; i < n_groups; i++) {
            if (groups[i].length > 0) {
                counts[(unsigned char)groups[i].label] +=
                    (size_t)groups[i].length;
            }
        }
        counts[(unsigned char)((char)-1)] += capacity - total_points;
        return label_from_counts(counts);
    }

    if (capacity > SIZE_MAX / sizeof(Neighbor)) {
        return knn_insertion(n_groups, groups, k, to_evaluate);
    }
    Neighbor *heap = (Neighbor *)malloc(capacity * sizeof(Neighbor));
    if (heap == NULL) {
        return knn_insertion(n_groups, groups, k, to_evaluate);
    }

    float batch[DISTANCE_BATCH_SIZE];
    size_t used = 0;
    for (int i = 0; i < n_groups; i++) {
        Group g = groups[i];
        for (int first = 0; first < g.length;) {
            int count = g.length - first;
            if (count > DISTANCE_BATCH_SIZE) {
                count = DISTANCE_BATCH_SIZE;
            }
            distance_batch(g.points + first, batch, count, to_evaluate);

            /* Selection remains ordered; only distance generation is SIMD-ready. */
            for (int j = 0; j < count; j++) {
                float d = batch[j];
                if (d != d) {
                    free(heap);
                    return knn_insertion(n_groups, groups, k, to_evaluate);
                }

                Neighbor candidate;
                candidate.distance = d;
                candidate.group = i;
                if (used < capacity) {
                    heap[used++] = candidate;
                    if (used == capacity) {
                        heap_build(heap, capacity);
                    }
                } else if (d < heap[0].distance) {
                    /* Later equal-distance points cannot improve the selection. */
                    heap[0] = candidate;
                    heap_sift_down(heap, capacity, 0);
                }
            }
            first += count;
        }
    }

    size_t counts[UCHAR_MAX + 1] = {0};
    for (size_t i = 0; i < used; i++) {
        counts[(unsigned char)groups[heap[i].group].label]++;
    }
    counts[(unsigned char)((char)-1)] += capacity - used;
    free(heap);
    return label_from_counts(counts);
}

int main() {
    int n_groups = parse_number_of_groups();
    Group *groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();
    Point to_evaluate = parse_point();
    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

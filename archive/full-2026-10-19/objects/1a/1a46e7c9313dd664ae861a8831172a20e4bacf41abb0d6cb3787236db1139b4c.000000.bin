        "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <limits>\n#include <vector>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nstruct alignas(16) PackedColumns {\n    std::int64_t lane[4];\n};\n\ntemplate<int Batch>\nstatic void prepare_batch(const int* matrix, int n, int s, int top,\n                          int window_count, std::int64_t* columns,\n                          PackedColumns* packed) {\n    const int* entering[4] = {};\n    const int* leaving[4] = {};\n    for (int lane = 1; lane < Batch; ++lane) {\n        entering[lane] = matrix + static_cast<std::size_t>(top + lane + s - 1) * n;\n        leaving[lane] = matrix + static_cast<std::size_t>(top + lane - 1) * n;\n    }\n\n    const bool advance = top + Batch < window_count;\n    const int* next_entering = nullptr;\n    const int* next_leaving = nullptr;\n    if (advance) {\n        next_entering = matrix + static_cast<std::size_t>(top + Batch + s - 1) * n;\n        next_leaving = matrix + static_cast<std::size_t>(top + Batch - 1) * n;\n    }\n\n    for (int col = 0; col < n; ++col) {\n        std::int64_t value = columns[col];\n        packed[col].lane[0] = value;\n        for (int lane = 1; lane < Batch; ++lane) {\n            value += static_cast<std::int64_t>(entering[lane][col])\n                   - static_cast<std::int64_t>(leaving[lane][col]);\n            packed[col].lane[lane] = value;\n        }\n        // Inactive lanes duplicate a valid row, so they cannot change the maximum.\n        for (int lane = Batch; lane < 4; ++lane)\n            packed[col].lane[lane] = value;\n\n        if (advance) {\n            columns[col] = value\n                         + static_cast<std::int64_t>(next_entering[col])\n                         - static_cast<std::int64_t>(next_leaving[col]);\n        }\n    }\n}\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic inline int64x2_t maximum_lanes(int64x2_t a, int64x2_t b) {\n    return vbslq_s64(vcgtq_s64(a, b), a, b);\n}\n#endif\n\nstatic std::int64_t scan_batch(const PackedColumns* packed, int n, int s) {\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    int64x2_t partial01_0 = vdupq_n_s64(0);\n    int64x2_t partial01_1 = vdupq_n_s64(0);\n    int64x2_t partial01_2 = vdupq_n_s64(0);\n    int64x2_t partial01_3 = vdupq_n_s64(0);\n    int64x2_t partial23_0 = vdupq_n_s64(0);\n    int64x2_t partial23_1 = vdupq_n_s64(0);\n    int64x2_t partial23_2 = vdupq_n_s64(0);\n    int64x2_t partial23_3 = vdupq_n_s64(0);\n\n    int col = 0;\n    // Independent partial sums shorten the first-window reduction chains.\n    for (; col + 3 < s; col += 4) {\n        partial01_0 = vaddq_s64(partial01_0, vld1q_s64(packed[col].lane));\n        partial23_0 = vaddq_s64(partial23_0, vld1q_s64(packed[col].lane + 2));\n        partial01_1 = vaddq_s64(partial01_1, vld1q_s64(packed[col + 1].lane));\n        partial23_1 = vaddq_s64(partial23_1, vld1q_s64(packed[col + 1].lane + 2));\n        partial01_2 = vaddq_s64(partial01_2, vld1q_s64(packed[col + 2].lane));\n        partial23_2 = vaddq_s64(partial23_2, vld1q_s64(packed[col + 2].lane + 2));\n        partial01_3 = vaddq_s64(partial01_3, vld1q_s64(packed[col + 3].lane));\n        partial23_3 = vaddq_s64(partial23_3, vld1q_s64(packed[col + 3].lane + 2));\n    }\n    int64x2_t sum01 = vaddq_s64(vaddq_s64(partial01_0, partial01_1),\n                              vaddq_s64(partial01_2, partial01_3));\n    int64x2_t sum23 = vaddq_s64(vaddq_s64(partial23_0, partial23_1),\n                              vaddq_s64(partial23_2, partial23_3));\n    for (; col < s; ++col) {\n        sum01 = vaddq_s64(sum01, vld1q_s64(packed[col].lane));\n        sum23 = vaddq_s64(sum23, vld1q_s64(packed[col].lane + 2));\n    }\n\n    int64x2_t best01_0 = sum01;\n    int64x2_t best01_1 = sum01;\n    int64x2_t best01_2 = sum01;\n    int64x2_t best01_3 = sum01;\n    int64x2_t best23_0 = sum23;\n    int64x2_t best23_1 = sum23;\n    int64x2_t best23_2 = sum23;\n    int64x2_t best23_3 = sum23;\n\n    // Keep the rolling sums ordered, but distribute maxima across four chains.\n    // Each vector lane still represents an independent top-left row.\n    for (; col + 3 < n; col += 4) {\n        const PackedColumns* entering = packed + col;\n        const PackedColumns* leaving = packed + col - s;\n        const int64x2_t delta01_0 = vsubq_s64(vld1q_s64(entering[0].lane),\n                                             vld1q_s64(leaving[0].lane));\n        const int64x2_t delta23_0 = vsubq_s64(vld1q_s64(entering[0].lane + 2),\n                                             vld1q_s64(leaving[0].lane + 2));\n        const int64x2_t delta01_1 = vsubq_s64(vld1q_s64(entering[1].lane),\n                                             vld1q_s64(leaving[1].lane));\n        const int64x2_t delta23_1 = vsubq_s64(vld1q_s64(entering[1].lane + 2),\n                                             vld1q_s64(leaving[1].lane + 2));\n        const int64x2_t delta01_2 = vsubq_s64(vld1q_s64(entering[2].lane),\n                                             vld1q_s64(leaving[2].lane));\n        const int64x2_t delta23_2 = vsubq_s64(vld1q_s64(entering[2].lane + 2),\n                                             vld1q_s64(leaving[2].lane + 2));\n        const int64x2_t delta01_3 = vsubq_s64(vld1q_s64(entering[3].lane),\n                                             vld1q_s64(leaving[3].lane));\n        const int64x2_t delta23_3 = vsubq_s64(vld1q_s64(entering[3].lane + 2),\n                                             vld1q_s64(leaving[3].lane + 2));\n\n        sum01 = vaddq_s64(sum01, delta01_0);\n        sum23 = vaddq_s64(sum23, delta23_0);\n        best01_0 = maximum_lanes(best01_0, sum01);\n        best23_0 = maximum_lanes(best23_0, sum23);\n\n        sum01 = vaddq_s64(sum01, delta01_1);\n        sum23 = vaddq_s64(sum23, delta23_1);\n        best01_1 = maximum_lanes(best01_1, sum01);\n        best23_1 = maximum_lanes(best23_1, sum23);\n\n        sum01 = vaddq_s64(sum01, delta01_2);\n        sum23 = vaddq_s64(sum23, delta23_2);\n        best01_2 = maximum_lanes(best01_2, sum01);\n        best23_2 = maximum_lanes(best23_2, sum23);\n\n        sum01 = vaddq_s64(sum01, delta01_3);\n        sum23 = vaddq_s64(sum23, delta23_3);\n        best01_3 = maximum_lanes(best01_3, sum01);\n        best23_3 = maximum_lanes(best23_3, sum23);\n    }\n    for (; col < n; ++col) {\n        const int64x2_t enter01 = vld1q_s64(packed[col].lane);\n        const int64x2_t enter23 = vld1q_s64(packed[col].lane + 2);\n        const int64x2_t leave01 = vld1q_s64(packed[col - s].lane);\n        const int64x2_t leave23 = vld1q_s64(packed[col - s].lane + 2);\n        sum01 = vaddq_s64(sum01, vsubq_s64(enter01, leave01));\n        sum23 = vaddq_s64(sum23, vsubq_s64(enter23, leave23));\n        best01_0 = maximum_lanes(best01_0, sum01);\n        best23_0 = maximum_lanes(best23_0, sum23);\n    }\n\n    const int64x2_t best01 = maximum_lanes(maximum_lanes(best01_0, best01_1),\n                                          maximum_lanes(best01_2, best01_3));\n    const int64x2_t best23 = maximum_lanes(maximum_lanes(best23_0, best23_1),\n                                          maximum_lanes(best23_2, best23_3));\n    const int64x2_t best = maximum_lanes(best01, best23);\n    return std::max(vgetq_lane_s64(best, 0), vgetq_lane_s64(best, 1));\n#else\n    std::int64_t sums[4] = {};\n    for (int col = 0; col < s; ++col)\n        for (int lane = 0; lane < 4; ++lane)\n            sums[lane] += packed[col].lane[lane];\n\n    std::int64_t best[4] = {sums[0], sums[1], sums[2], sums[3]};\n    for (int col = s; col < n; ++col) {\n        for (int lane = 0; lane < 4; ++lane) {\n            sums[lane] += packed[col].lane[lane] - packed[col - s].lane[lane];\n            best[lane] = std::max(best[lane], sums[lane]);\n        }\n    }\n    return *std::max_element(best, best + 4);\n#endif\n}\n\nint main() {\n    int n, s;\n    if (std::scanf(\"%d%d\", &n, &s) != 2)\n        return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    std::vector<int> matrix(static_cast<std::size_t>(n) * n);\n    for (std::size_t i = 0; i < matrix.size(); ++i)\n        std::scanf(\"%d\", &matrix[i]);\n\n    std::vector<std::int64_t> columns(n, 0);\n    for (int row = 0; row < s; ++row) {\n        const int* values = matrix.data() + static_cast<std::size_t>(row) * n;\n        for (int col = 0; col < n; ++col)\n            columns[col] += static_cast<std::int64_t>(values[col]);\n    }\n\n    std::vector<PackedColumns> packed(n);\n    const int window_count = n - s + 1;\n    std::int64_t answer = std::numeric_limits<std::int64_t>::lowest();\n    for (int top = 0; top < window_count; top += 4) {\n        const int batch = std::min(4, window_count - top);\n        switch (batch) {\n        case 1:\n            prepare_batch<1>(matrix.data(), n, s, top, window_count,\n                             columns.data(), packed.data());\n            break;\n        case 2:\n            prepare_batch<2>(matrix.data(), n, s, top, window_count,\n                             columns.data(), packed.data());\n            break;\n        case 3:\n            prepare_batch<3>(matrix.data(), n, s, top, window_count,\n                             columns.data(), packed.data());\n            break;\n        case 4:\n            prepare_batch<4>(matrix.data(), n, s, top, window_count,\n                             columns.data(), packed.data());\n            break;\n        }\n        answer = std::max(answer, scan_batch(packed.data(), n, s));\n    }\n\n    std::printf(\"%lld\\n\", static_cast<long long>(answer));\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }

#include "knn.h"
#include <stdint.h>
#if defined(__aarch64__) && defined(__ARM_NEON)
#include <arm_neon.h>
#endif

static inline unsigned first_set_lane(uint32_t mask) {
#if defined(__GNUC__) || defined(__clang__)
    return (unsigned) __builtin_ctz((unsigned int) mask);
#else
    unsigned lane = 0;
    while ((mask & UINT32_C(1)) == 0) {
        mask >>= 1;
        lane++;
    }
    return lane;
#endif
}

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    char * labels = (char *) malloc(sizeof(char) * k);
    float * distances = (float *) malloc(sizeof(float) * k);

    enum {
        DISTANCE_BLOCK_SIZE = 256,
        CANDIDATE_WORD_BITS = 32,
        CANDIDATE_WORD_COUNT =
            (DISTANCE_BLOCK_SIZE + CANDIDATE_WORD_BITS - 1) / CANDIDATE_WORD_BITS
    };
    float block_distances[DISTANCE_BLOCK_SIZE];
    uint32_t candidate_masks[CANDIDATE_WORD_COUNT];
    int i, j, x, y;

    for (i = 0; i < k; i++) {
        labels[i] = -1;
        distances[i] = -1;
    }

    for (i = 0; i < n_groups; i++) {
        Group g = groups[i];

        for (j = 0; j < g.length;) {
            int count = g.length - j;
            if (count > DISTANCE_BLOCK_SIZE) {
                count = DISTANCE_BLOCK_SIZE;
            }

            const Point * points = g.points + j;
            const float cutoff = distances[k - 1];
            const int have_cutoff = cutoff != -1.0f;
            const int mask_count =
                (count + CANDIDATE_WORD_BITS - 1) / CANDIDATE_WORD_BITS;

            /* Keep the floating-point loop independent of mask reductions. */
#if defined(__GNUC__) && !defined(__clang__)
#pragma GCC ivdep
#endif
            for (int lane = 0; lane < count; lane++) {
                block_distances[lane] =
                    euclidean_distance_no_sqrt(to_evaluate, points[lane]);
            }

            for (int word = 0; word < mask_count; word++) {
                const int first = word * CANDIDATE_WORD_BITS;
                int lanes = count - first;
                if (lanes > CANDIDATE_WORD_BITS) {
                    lanes = CANDIDATE_WORD_BITS;
                }

                uint32_t mask = 0;
                if (!have_cutoff) {
                    mask = UINT32_MAX >> (CANDIDATE_WORD_BITS - lanes);
                } else {
                    int lane = 0;
#if defined(__aarch64__) && defined(__ARM_NEON)
                    const float32x4_t threshold = vdupq_n_f32(cutoff);
                    uint32x4_t packed = vdupq_n_u32(0);
                    uint32x4_t lane_bits = {
                        UINT32_C(1), UINT32_C(2),
                        UINT32_C(4), UINT32_C(8)
                    };

                    for (; lane + 4 <= lanes; lane += 4) {
                        const float32x4_t d =
                            vld1q_f32(block_distances + first + lane);
                        const uint32x4_t retain =
                            vmvnq_u32(vcgeq_f32(d, threshold));
                        packed = vorrq_u32(packed,
                                           vandq_u32(retain, lane_bits));
                        lane_bits = vshlq_n_u32(lane_bits, 4);
                    }

                    /* Vector lanes own disjoint bits, so addition equals OR. */
                    mask = vaddvq_u32(packed);
#endif
                    for (; lane < lanes; lane++) {
                        const float d = block_distances[first + lane];
                        mask |= (uint32_t) (!(d >= cutoff)) << lane;
                    }
                }

                candidate_masks[word] = mask;
            }

            /* Ascending set bits preserve stable input-order insertion. */
            for (int word = 0; word < mask_count; word++) {
                uint32_t remaining = candidate_masks[word];
                while (remaining != 0) {
                    int lane = (int) first_set_lane(remaining);
                    int b = word * CANDIDATE_WORD_BITS + lane;
                    remaining &= remaining - UINT32_C(1);

                    float d = block_distances[b];
                    if (d == -1.0f) {
                        continue;
                    }

                    float current_cutoff = distances[k - 1];
                    if (current_cutoff != -1.0f && d >= current_cutoff) {
                        continue;
                    }

                    for (x = 0; x < k; x++) {
                        if (d < distances[x] || distances[x] == -1) {
                            for (y = k - 1; y > x; y--) {
                                distances[y] = distances[y - 1];
                                labels[y] = labels[y - 1];
                            }

                            distances[x] = d;
                            labels[x] = g.label;

                            break;
                        }
                    }
                }
            }

            j += count;
        }
    }

    qsort(labels, k, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }

            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }


    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

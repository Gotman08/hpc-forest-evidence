    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    int n;\n    float *xs;\n    float *ys;\n    char *labels;\n} Dataset;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n    Point point;\n    point.x = x;\n    point.y = y;\n    return point;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n    return k;\n}\n\nDataset *parse_dataset() {\n    int n_groups;\n    if (scanf(\" n_groups=%d \", &n_groups) != 1) on_error();\n\n    long cap = 1024;\n    float *xs = (float *)malloc(sizeof(float) * cap);\n    float *ys = (float *)malloc(sizeof(float) * cap);\n    char *labels = (char *)malloc(sizeof(char) * cap);\n    if (!xs || !ys || !labels) on_error();\n\n    long n = 0;\n    for (int g = 0; g < n_groups; g++) {\n        char label;\n        int length;\n        if (scanf(\" label=%c \", &label) != 1) on_error();\n        if (scanf(\" length=%d \", &length) != 1) on_error();\n\n        for (int i = 0; i < length; i++) {\n            float x, y;\n            if (scanf(\" (%f ,%f) \", &x, &y) != 2) on_error();\n            if (n == cap) {\n                cap *= 2;\n                xs = (float *)realloc(xs, sizeof(float) * cap);\n                ys = (float *)realloc(ys, sizeof(float) * cap);\n                labels = (char *)realloc(labels, sizeof(char) * cap);\n                if (!xs || !ys || !labels) on_error();\n            }\n            xs[n] = x;\n            ys[n] = y;\n            labels[n] = label;\n            n++;\n        }\n    }\n\n    Dataset *ds = (Dataset *)malloc(sizeof(Dataset));\n    if (!ds) on_error();\n    ds->n = (int)n;\n    ds->xs = xs;\n    ds->ys = ys;\n    ds->labels = labels;\n    return ds;\n}\n",
      "path": "src/knn.h"
    },
    {
      "content": "#include \"knn.h\"\n#include <arm_neon.h>\n#include <omp.h>\n\ntypedef struct {\n    float d;\n    char label;\n    long idx;\n} Cand;\n\nstatic inline int worse(const Cand *a, const Cand *b) {\n    if (a->d != b->d) return a->d > b->d;\n    return a->idx > b->idx;\n}\n\nstatic void swap_c(Cand *a, Cand *b) {\n    Cand t = *a; *a = *b; *b = t;\n}\n\nstatic void sift_up(Cand *heap, int pos) {\n    while (pos > 0) {\n        int parent = (pos - 1) / 2;\n        if (worse(&heap[pos], &heap[parent])) {\n            swap_c(&heap[pos], &heap[parent]);\n            pos = parent;\n        } else break;\n    }\n}\n\nstatic void sift_down(Cand *heap, int size, int root) {\n    while (1) {\n        int left = 2 * root + 1;\n        if (left >= size) break;\n        int right = left + 1;\n        int largest = root;\n        if (worse(&heap[left], &heap[largest])) largest = left;\n        if (right < size && worse(&heap[right], &heap[largest])) largest = right;\n        if (largest != root) {\n            swap_c(&heap[root], &heap[largest]);\n            root = largest;\n        } else break;\n    }\n}\n\nstatic int cmp_cand(const void *pa, const void *pb) {\n    const Cand *a = (const Cand *)pa;\n    const Cand *b = (const Cand *)pb;\n    if (a->d != b->d) return (a->d > b->d) - (a->d < b->d);\n    return (a->idx > b->idx) - (a->idx < b->idx);\n}\n\nchar knn(Dataset *ds, int k, Point q) {\n    long n = ds->n;\n    float qx = q.x, qy = q.y;\n\n    int nthreads = 1;\n    #pragma omp parallel\n    {\n        #pragma omp single\n        nthreads = omp_get_num_threads();\n    }\n\n    Cand **local_heaps = (Cand **)malloc(sizeof(Cand *) * nthreads);\n    int *heap_sizes = (int *)calloc(nthreads, sizeof(int));\n    if (!local_heaps || !heap_sizes) on_error();\n    for (int t = 0; t < nthreads; t++) {\n        local_heaps[t] = (Cand *)malloc(sizeof(Cand) * k);\n        if (!local_heaps[t]) on_error();\n    }\n\n    #pragma omp parallel\n    {\n        int tid = omp_get_thread_num();\n        Cand *heap = local_heaps[tid];\n        int hsize = 0;\n\n        long chunk = (n + nthreads - 1) / nthreads;\n        long start = tid * chunk;\n        long end = start + chunk < n ? start + chunk : n;\n\n        for (long i = start; i < end; ) {\n            if (i + 3 < end) {\n                float32x4_t xv = vld1q_f32(&ds->xs[i]);\n                float32x4_t yv = vld1q_f32(&ds->ys[i]);\n                float32x4_t dx = xv - vdupq_n_f32(qx);\n                float32x4_t dy = yv - vdupq_n_f32(qy);\n                float32x4_t d2 = dx * dx + dy * dy;\n                float dists[4];\n                vst1q_f32(dists, d2);\n\n                for (int t = 0; t < 4; t++) {\n                    Cand c;\n                    c.d = dists[t];\n                    c.label = ds->labels[i + t];\n                    c.idx = i + t;\n\n                    if (hsize < k) {\n                        heap[hsize++] = c;\n                        sift_up(heap, hsize - 1);\n                    } else if (!worse(&c, &heap[0])) {\n                        heap[0] = c;\n                        sift_down(heap, k, 0);\n                    }\n                }\n                i += 4;\n            } else {\n                float dx = ds->xs[i] - qx;\n                float dy = ds->ys[i] - qy;\n                float d = dx * dx + dy * dy;\n                Cand c;\n                c.d = d; c.label = ds->labels[i]; c.idx = i;\n\n                if (hsize < k) {\n                    heap[hsize++] = c;\n                    sift_up(heap, hsize - 1);\n                } else if (!worse(&c, &heap[0])) {\n                    heap[0] = c;\n                    sift_down(heap, k, 0);\n                }\n                i++;\n            }\n        }\n\n        heap_sizes[tid] = hsize;\n    }\n\n    long total_cands = 0;\n    for (int t = 0; t < nthreads; t++) total_cands += heap_sizes[t];\n\n    Cand *all = (Cand *)malloc(sizeof(Cand) * total_cands);\n    if (!all && total_cands > 0) on_error();\n    long pos = 0;\n    for (int t = 0; t < nthreads; t++) {\n        for (int i = 0; i < heap_sizes[t]; i++) {\n            all[pos++] = local_heaps[t][i];\n        }\n    }\n\n    qsort(all, total_cands, sizeof(Cand), cmp_cand);\n\n    int counts[256] = {0};\n    long take = k < total_cands ? k : total_cands;\n    for (long i = 0; i < take; i++) {\n        counts[(unsigned char)all[i].label]++;\n    }\n    if (total_cands < k) {\n        counts[255] += (int)(k - total_cands);\n    }\n\n    int best_count = -1;\n    char best_label = 0;\n    for (int c = 0; c < 256; c++) {\n        if (counts[c] > best_count) {\n            best_count = counts[c];\n            best_label = (char)c;\n        }\n    }\n\n    free(all);\n    for (int t = 0; t < nthreads; t++) free(local_heaps[t]);\n    free(local_heaps);\n    free(heap_sizes);\n\n    return best_label;\n}\n\nint main() {\n    Dataset *ds = parse_dataset();\n    int k = parse_k();\n    Point q = parse_point();\n\n    printf(\"%c\", knn(ds, k, q));\n\n    free(ds->xs);\n    free(ds->ys);\n    free(ds->labels);\n    free(ds);\n    return 0;\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Integrating flattened contiguous dataset storage, OpenMP per-thread max-heaps with NEON SIMD distance computation, and exact (distance, global index) tie-breaking should reduce runtime while preserving reference semantics.",
  "notes": "Combines the flat Dataset layout from c2445fbe50614c7a, the NEON vectorized distance calculation and heap selection from dadd0f7f9ebb4452, and OpenMP parallelization with per-thread candidate lists from 5724c0a7dc784fee. The main function is retained to avoid the previous build failure caused by a missing entry point.",

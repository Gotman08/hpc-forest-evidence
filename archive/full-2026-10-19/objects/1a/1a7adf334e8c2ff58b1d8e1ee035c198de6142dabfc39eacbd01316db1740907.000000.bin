{"files":[{"content":"#include<stdio.h>\n#include<stdlib.h>\n#include<math.h>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include<arm_neon.h>\n#endif\n\nstatic void bubble_sort_scalar(double *matriz, int tam) {\n    int i, j;\n    double aux;\n\n    for (i = tam - 1; i > 0; i--) {\n        for (j = 0; j < i; j++) {\n            if (matriz[j] > matriz[j+1]) {\n                aux=matriz[j];\n                matriz[j]=matriz[j+1];\n                matriz[j+1]=aux;\n            }\n        }\n    }\n}\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic int odd_even_phase(double *matriz, int tam, int first) {\n    int j;\n    int changed = 0;\n    uint64x2_t exchanges = vdupq_n_u64(0);\n\n    /* Each vector compares two disjoint adjacent pairs. */\n    for (j = first; j <= tam - 4; j += 4) {\n        float64x2x2_t pairs = vld2q_f64(matriz + j);\n        uint64x2_t swap = vcgtq_f64(pairs.val[0], pairs.val[1]);\n        float64x2_t left = vbslq_f64(swap, pairs.val[1], pairs.val[0]);\n        float64x2_t right = vbslq_f64(swap, pairs.val[0], pairs.val[1]);\n        pairs.val[0] = left;\n        pairs.val[1] = right;\n        vst2q_f64(matriz + j, pairs);\n        exchanges = vorrq_u64(exchanges, swap);\n    }\n    for (; j < tam - 1; j += 2) {\n        if (matriz[j] > matriz[j+1]) {\n            double aux = matriz[j];\n            matriz[j] = matriz[j+1];\n            matriz[j+1] = aux;\n            changed = 1;\n        }\n    }\n    return changed || vgetq_lane_u64(exchanges, 0) != 0 ||\n           vgetq_lane_u64(exchanges, 1) != 0;\n}\n#endif\n\nvoid bubble_sort(double *matriz, int tam) {\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    int i;\n    int changed = 0;\n\n    if (tam < 2) {\n        return;\n    }\n    /* Unordered values require the original comparison sequence. */\n    for (i = 0; i < tam; i++) {\n        if (matriz[i] != matriz[i]) {\n            bubble_sort_scalar(matriz, tam);\n            return;\n        }\n    }\n\n    /* Strict adjacent exchanges retain equal values in their original order. */\n    for (i = 0; i < tam; i++) {\n        changed |= odd_even_phase(matriz, tam, i & 1);\n        if (i & 1) {\n            if (!changed) {\n                return;\n            }\n            changed = 0;\n        }\n    }\n#else\n    bubble_sort_scalar(matriz, tam);\n#endif\n}\n\nvoid ordena_colunas(double *matriz,int lin, int col) {\n    int i;\n    \n    for (i = 0; i < col; i++) {    \n        //manda o endereco do primeiro elemento da coluna, limites inf e sup e a largura da matriz\n        bubble_sort(&matriz[i*lin], lin);\n    }\n} \n\nvoid calcula_media(double *matriz, double *vet,int lin, int col){\n    int i,j;\n    double soma;\n    for(i=0;i<col;i++){\n        soma=0;\n        for(j=0;j<lin;j++){\n            soma+=matriz[i*lin+j];\n        }\n        vet[i]=soma/lin; \n    }   \n}\n\nvoid calcula_media_harmonica(double *matriz, double *vet,int lin, int col){\n    int i,j;\n    double soma;\n    for(i=0;i<col;i++){\n        soma=0;\n        for(j=0;j<lin;j++){\n            soma+=(1/(matriz[i*lin+j]));\n        }\n        vet[i]=lin/soma; \n    }   \n}\n\nvoid calcula_mediana(double *matriz, double *vet, int lin, int col) {  \n     int i=0;\n     if((lin-1)%2){ //Quantidade par de elementos\n         for (i = 0; i < col; i++) {\n            vet[i]=(matriz[(((i*lin)+(i+1)*lin)-1)/2]+matriz[((((i*lin)+(i+1)*lin)-1)/2)+1]);\n            vet[i]*=0.5;\n            \n         }\n     }\n     else{ //Quantidade ímpar de elementos\n         for (i = 0; i < col; i++) {\n            vet[i]=matriz[(((i*lin)+(i+1)*lin)-1)/2];\n         }\n     }\n    \n } \n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic int count_equal_neon(const double *matriz, int first, int lin,\n                            double value) {\n    int j, count;\n    float64x2_t key = vdupq_n_f64(value);\n    uint64x2_t count0 = vdupq_n_u64(0);\n    uint64x2_t count1 = vdupq_n_u64(0);\n    uint64x2_t count2 = vdupq_n_u64(0);\n    uint64x2_t count3 = vdupq_n_u64(0);\n\n    /* Subtracting an all-ones equality mask adds one per matching lane. */\n    for (j = first; j <= lin - 8; j += 8) {\n        count0 = vsubq_u64(count0,\n                          vceqq_f64(key, vld1q_f64(matriz + j)));\n        count1 = vsubq_u64(count1,\n                          vceqq_f64(key, vld1q_f64(matriz + j + 2)));\n        count2 = vsubq_u64(count2,\n                          vceqq_f64(key, vld1q_f64(matriz + j + 4)));\n        count3 = vsubq_u64(count3,\n                          vceqq_f64(key, vld1q_f64(matriz + j + 6)));\n    }\n    count0 = vaddq_u64(vaddq_u64(count0, count1),\n                       vaddq_u64(count2, count3));\n    for (; j <= lin - 2; j += 2) {\n        count0 = vsubq_u64(count0,\n                          vceqq_f64(key, vld1q_f64(matriz + j)));\n    }\n    count = (int)vaddvq_u64(count0);\n    for (; j < lin; j++) {\n        if (value == matriz[j]) {\n            count++;\n        }\n    }\n    return count;\n}\n#endif\n\n//Adaptado de https://www.clubedohardware.com.br/forums/topic/1291570-programa-em-c-que-calcula-moda-media-e-mediana/\ndouble moda_aux(double *matriz,int lin){\n    int i, j; \n    double *cont;\n    cont=(double*)malloc(lin*sizeof(double));\n    float conta=0, moda=0;\n\n    for(i=0;i<lin;i++){\n#if defined(__aarch64__) && defined(__ARM_NEON)\n        int matches = count_equal_neon(matriz, i + 1, lin, matriz[i]);\n\n        /* Every match performs the same update; retain each scalar increment\n           and float conversion rather than replacing them with a bulk add. */\n        for(j=0;j<matches;j++){\n            cont[i]++;\n            if(cont[i]>conta){\n                conta=cont[i];\n                moda=matriz[i];\n            }\n        }\n#else\n        for(j=i+1;j<lin;j++){\n            if(matriz[i]==matriz[j]){\n                cont[i]++;\n                if(cont[i]>conta){\n                    conta=cont[i];\n                    moda=matriz[i];\n                }\n            }\n        }\n#endif\n        cont[i]=0;\n    }\n    free(cont);\n    if(conta == 0){\n        return -1;\n    }\n    else{\n        return moda;\n    }\n\n}\n\nvoid calcula_moda(double *matriz,double *moda,int lin, int col){\n    int i;\n    for(i=0;i<col;i++){\n        moda[i]=moda_aux(matriz+(i*lin),lin);\n    }\n}\n\nvoid calcula_variancia(double *matriz, double *media,double *variancia, int lin, int col){\n    int i,j;\n    double soma;\n    for(i=0;i<col;i++){\n        soma=0;\n        for(j=0;j<lin;j++){\n            soma+=pow((matriz[i*lin+j]-media[i]),2);\n        }\n        variancia[i]=soma/(lin-1); \n    } \n}\n\nvoid calcula_desvio_padrao(double *variancia,double *dp, int col){\n    int i;\n    for(i=0;i<col;i++){\n        dp[i]=sqrt(variancia[i]);\n    }  \n}\n\nvoid calcula_coeficiente_variacao(double *media,double *dp,double *cv, int col){\n    int i;\n    for(i=0;i<col;i++){\n        cv[i]=dp[i]/media[i];\n    }  \n}\n\nint main(int argc,char **argv){\n    int lin,col,i,j; // Define as variáveis de índices e dimensões\n    double *matriz,*mediana,*media,*media_har,*moda,*variancia,*dp,*cv; // Define a matriz (forma linear), vetores de medidas estatísticas\n\n    fscanf(stdin, \"%d \", &lin); // Lê a quantidade de linhas da matriz\n    fscanf(stdin, \"%d\\n\", &col); // Lê a quantidade de colunas da matriz\n    \n    // Alocações\n    matriz=(double *)malloc(lin*col * sizeof(double)); // Aloca a matriz\n    media=(double *)malloc(col * sizeof(double)); // Aloca o vetor de media\n    media_har=(double *)malloc(col * sizeof(double)); // Aloca o vetor de media harmônica\n    mediana=(double *)malloc(col * sizeof(double)); // Aloca o vetor de mediana\n    moda=(double *)malloc(col * sizeof(double)); // Aloca o vetor de moda\n    variancia=(double *)malloc(col * sizeof(double)); // Aloca o vetor de variância\n    cv=(double *)malloc(col * sizeof(double)); // Aloca o vetor de coeficiente de variação\n    dp=(double *)malloc(col * sizeof(double)); // Aloca o vetor de desvio padrão\n\n \n    for(i=0;i<lin;i++){\n        for(j=0;j<col;j++){\n            fscanf(stdin, \"%lf \",&(matriz[j*lin+i])); // Lê os dados transpostos em uma matriz de entrada\n        }\n    }\n\n    calcula_media(matriz,media,lin,col);\n    calcula_media_harmonica(matriz,media_har,lin,col);\n    ordena_colunas(matriz,lin,col);\n    calcula_mediana(matriz,mediana,lin,col);\n    calcula_moda(matriz,moda,lin,col);\n    calcula_variancia(matriz,media,variancia,lin,col);\n    calcula_desvio_padrao(variancia,dp,col);\n    calcula_coeficiente_variacao(media,dp,cv,col);\n\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",media[i]); // Imprime as médias aritméticas de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",media_har[i]); // Imprime as médias harmônicas de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",mediana[i]); // Imprime as medianas de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",moda[i]); // Imprime as modas de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",variancia[i]); // Imprime as variâncias amostrais de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",dp[i]); // Imprime os desvios padrão de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",cv[i]); // Imprime os coeficientes de variação de cada coluna\n    printf(\"\\n\");\n\n    // Desaloca memória\n    free(matriz);\n    free(media);\n    free(media_har);\n    free(mediana);\n    free(moda);\n    free(variancia);\n    free(dp);\n    free(cv);\n}\n","path":"src/est_matriz_seq.c"}],"hypothesis":"Separating mode equality scans from their dependent counter updates enables ARM64 NEON match counting, potentially accelerating the remaining quadratic scan without reassociating floating-point arithmetic.","notes":"Not executed. Existing mode-counter allocation and initialization behavior remains unchanged; correctness and speed require controller evaluation.","sources_kept":[],"transformations":["Count suffix matches using four independent NEON integer accumulators, with bounded vector loads and scalar cleanup.","Replay every matching counter increment and float update sequentially, preserving mode tie handling and narrowing behavior.","Retain the original non-NEON implementation, sorting, statistical reductions, allocations and I/O."]}
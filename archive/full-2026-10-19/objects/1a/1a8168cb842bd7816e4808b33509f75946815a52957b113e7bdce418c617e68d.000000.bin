{
  "src/graph.c": "#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n#include<ctype.h>\n#include<limits.h>\n\n/* Maximum size (in char) for neighbors and compute lists */\n#define MAX 100\n\ntypedef struct {\n  int id;\n  float value;\n  char neighbors[MAX];\n} Node;\n\nstatic void input_error(void) {\n  fprintf(stderr, \"Error!\\n\");\n  exit(1);\n}\n\n/* Acquire input in large blocks before independently decoding records. */\nstatic char *read_text(FILE *fl) {\n  size_t capacity = 65536;\n  size_t used = 0;\n  char *text = (char*) malloc(capacity + 1);\n  if (text == NULL)\n    input_error();\n\n  for (;;) {\n    size_t available = capacity - used;\n    size_t count = fread(text + used, 1, available, fl);\n    used += count;\n    if (count < available) {\n      if (ferror(fl))\n        input_error();\n      break;\n    }\n\n    if (capacity > ((size_t)-1 - 1) / 2)\n      input_error();\n    capacity *= 2;\n    char *grown = (char*) realloc(text, capacity + 1);\n    if (grown == NULL)\n      input_error();\n    text = grown;\n  }\n\n  text[used] = '\\0';\n  return text;\n}\n\nstatic void parse_node_line(const char *line, Node *node) {\n  char *end;\n  node->id = (int) strtol(line, &end, 10);\n  node->value = strtof(end, &end);\n  while (isspace((unsigned char)*end))\n    end++;\n  strcpy(node->neighbors, end);\n}\n\n/* Reads input, allocates memory, writes graph size and node list. Returns the graph. */\nNode* read_input(char* fname, int *n, char* list) {\n  FILE *fl = fname == NULL ? stdin : fopen(fname, \"r\");\n  if (fl == NULL)\n    input_error();\n\n  char *text = read_text(fl);\n  fclose(fl);\n\n  char *header = text;\n  while (isspace((unsigned char)*header))\n    header++;\n  char *cursor = strchr(header, '\\n');\n  if (cursor != NULL)\n    *cursor++ = '\\0';\n\n  char *end;\n  long count = strtol(header, &end, 10);\n  if (end == header || count < 0 || count > INT_MAX)\n    input_error();\n  *n = (int) count;\n  while (isspace((unsigned char)*end))\n    end++;\n  strcpy(list, end);\n\n  Node *data = NULL;\n  char **records = NULL;\n  if (*n > 0) {\n    data = (Node*) malloc((size_t)*n * sizeof(Node));\n    records = (char**) malloc((size_t)*n * sizeof(char*));\n    if (data == NULL || records == NULL)\n      input_error();\n  }\n\n  int found = 0;\n  while (found < *n && cursor != NULL && *cursor != '\\0') {\n    char *line = cursor;\n    cursor = strchr(line, '\\n');\n    if (cursor != NULL)\n      *cursor++ = '\\0';\n    while (isspace((unsigned char)*line))\n      line++;\n    if (*line != '\\0')\n      records[found++] = line;\n  }\n  if (found != *n)\n    input_error();\n\n  /* Avoid entering an OpenMP region for small parsing workloads. */\n#ifdef _OPENMP\n  if (*n >= 8192) {\n    #pragma omp parallel for schedule(static)\n    for (int i = 0; i < *n; i++)\n      parse_node_line(records[i], &data[i]);\n  } else\n#endif\n  {\n    for (int i = 0; i < *n; i++)\n      parse_node_line(records[i], &data[i]);\n  }\n\n  free(records);\n  free(text);\n  return data;\n}\n\n/* Returns the index of the node with the given id or -1 if not found */\nint find_by_id(Node g[], int id, int size){\n\n  int i = 0;\n\n  while((i < size) && g[i].id != id)\n    i++;\n\n  if(i < size)\n    return i;\n\n  return -1;\n\n}\n\n/* Computes the sum for the node with the given id */\nfloat get_costly(Node *g, int id, int size) {\n\n  char *t;\n  int idmax = -1;\n  float max = 0;\n  char *auxptr;\n\n  int nd = find_by_id(g, id, size);\n  if(nd < 0)\n    return max;\n\n  char aux[MAX];\n  strcpy(aux, g[nd].neighbors);\n  t = strtok_r(aux, \" \", &auxptr);\n\n  while (t != NULL) {\n    int d = find_by_id(g, atoi(t), size);\n    if (d >= 0 && max < g[d].value) {\n      max = g[d].value;\n      idmax = atoi(t);\n    }\n    t = strtok_r(NULL, \" \", &auxptr);\n  }\n\n  float r = g[nd].value;\n\n  if(idmax != -1)\n    r += get_costly(g, idmax, size);\n\n  return (r);\n\n}\n\n/* Main program - calls read input, computes sum for each node in the list, prints output */\nint main() {\n  char *fileN = NULL;\n  char computelist[MAX];\n  int n = -1;\n  Node* input = NULL;\n\n  input = read_input(fileN, &n, computelist);\n\n  // process\n  for(char *c = strtok(computelist, \" \"); c != NULL; c = strtok(NULL, \" \"))\n    printf(\"%s: %f\\n\", c, get_costly(input, atoi(c), n));\n\n  free(input);\n\n  return 0;\n}\n"
}

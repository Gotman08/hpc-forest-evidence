      "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\nconstexpr int MOD = 1000000007;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) {\n        return 0;\n    }\n\n    vector<vector<int>> blocked_rows(n);\n    for (int k = 0; k < m; ++k) {\n        int row, column;\n        cin >> row >> column;\n        blocked_rows[row].push_back(column);\n    }\n    for (vector<int>& row : blocked_rows) {\n        sort(row.begin(), row.end());\n        row.erase(unique(row.begin(), row.end()), row.end());\n    }\n\n    vector<int> previous(n);\n    int first_row_paths = 0;\n    size_t first_row_block = 0;\n    for (int column = 0; column < n; ++column) {\n        const bool is_blocked = first_row_block < blocked_rows[0].size() &&\n                                blocked_rows[0][first_row_block] == column;\n        if (is_blocked) {\n            first_row_paths = 0;\n            ++first_row_block;\n        } else if (column == 0) {\n            first_row_paths = 1;\n        }\n        previous[column] = first_row_paths;\n    }\n\n    vector<int> current(n);\n\n#ifdef _OPENMP\n    if (n >= 1024 && omp_get_max_threads() > 1) {\n        vector<int> carries(omp_get_max_threads());\n        vector<int> first_blocks(omp_get_max_threads());\n\n#pragma omp parallel shared(blocked_rows, previous, current, carries, first_blocks, n)\n        {\n            const int thread_id = omp_get_thread_num();\n            const int thread_count = omp_get_num_threads();\n            const int begin = static_cast<int>((static_cast<long long>(thread_id) * n) / thread_count);\n            const int end = static_cast<int>((static_cast<long long>(thread_id + 1) * n) / thread_count);\n\n            for (int row = 1; row < n; ++row) {\n                const vector<int>& blocks = blocked_rows[row];\n                vector<int>::const_iterator block = lower_bound(blocks.begin(), blocks.end(), begin);\n                const int first_block = (block != blocks.end() && *block < end) ? *block : end;\n                int local_paths = 0;\n\n                for (int column = begin; column < end; ++column) {\n                    if (block != blocks.end() && *block == column) {\n                        local_paths = 0;\n                        ++block;\n                    } else {\n                        local_paths += previous[column];\n                        if (local_paths >= MOD) {\n                            local_paths -= MOD;\n                        }\n                    }\n                    current[column] = local_paths;\n                }\n                carries[thread_id] = local_paths;\n                first_blocks[thread_id] = first_block;\n\n#pragma omp barrier\n#pragma omp single\n                {\n                    int incoming = 0;\n                    for (int thread = 0; thread < thread_count; ++thread) {\n                        const int local_end = carries[thread];\n                        carries[thread] = incoming;\n                        if (first_blocks[thread] == static_cast<int>((static_cast<long long>(thread + 1) * n) / thread_count)) {\n                            incoming += local_end;\n                            if (incoming >= MOD) {\n                                incoming -= MOD;\n                            }\n                        } else {\n                            incoming = local_end;\n                        }\n                    }\n                }\n\n                const int incoming = carries[thread_id];\n                for (int column = begin; column < first_blocks[thread_id]; ++column) {\n                    int value = current[column] + incoming;\n                    if (value >= MOD) {\n                        value -= MOD;\n                    }\n                    current[column] = value;\n                }\n\n#pragma omp barrier\n#pragma omp single\n                { previous.swap(current); }\n            }\n        }\n    } else\n#endif\n    {\n        for (int row = 1; row < n; ++row) {\n            const vector<int>& blocks = blocked_rows[row];\n            size_t block = 0;\n            int paths = 0;\n            for (int column = 0; column < n; ++column) {\n                if (block < blocks.size() && blocks[block] == column) {\n                    paths = 0;\n                    ++block;\n                } else {\n                    paths += previous[column];\n                    if (paths >= MOD) {\n                        paths -= MOD;\n                    }\n                }\n                current[column] = paths;\n            }\n            previous.swap(current);\n        }\n    }\n\n    cout << previous[n - 1] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "A persistent OpenMP region with fixed static column ownership and a two-phase segmented prefix scan parallelizes each dependency-carrying DP row without changing its recurrence; retaining a serial path for narrow grids avoids synchronization overhead.",

"""Seal only closed unbound local adapters and already-run inert evidence."""
import hashlib
import json
import xml.etree.ElementTree as ET
from pathlib import Path

HERE = Path(__file__).resolve().parent
NAMES = ('commun.py', 'preparer-intentions-natives.py', 'construire-observations-parent.py',
         'produire-current-r4.py', 'recevoir-installation-oauth.py')


def ref(path):
    return {'path': str(path.resolve()), 'sha256': hashlib.sha256(path.read_bytes()).hexdigest()}


def write(name, value):
    with (HERE / name).open('x', encoding='utf8') as stream:
        json.dump(value, stream, indent=2)
        stream.write('\n')


def main():
    cases = list(ET.parse(HERE / 'tests-delta-g.xml').getroot().iter('testcase'))
    assert len(cases) == 12 and not any(list(c) for c in cases)
    assert ref(HERE / 'produire-current-r4.py')['sha256'] == '69131db9e92d2fd4aa6521930ecb3c4780d3fe7debb0675dfb71f17fa7f798fc'
    manifest = {'schema': 'hpc-forest-r2g-unbound-parent-adapters-manifest-v1',
        'components': {name: ref(HERE / name)['sha256'] for name in NAMES},
        'tests': {name: ref(HERE / name) for name in ('test_namespace_reel_g.py', 'test_fermeture_g.py')},
        'junit': ref(HERE / 'tests-delta-g.xml'),
        'derivation': ref(HERE / 'DERIVATION-PREPAREE-NON-ADMISE.json'),
        'capture_parent_not_executed': ref(HERE.parent / 'capturer-prevol-r2g.ps1')}
    write('MANIFESTE-COLLECTEURS-PREPARES.json', manifest)
    write('LIVRAISON-COLLECTEURS-PREPARES-POUR-REVUE.json', {
        'schema': 'hpc-forest-r2g-unbound-parent-adapters-delivery-v1',
        'verified_local_delta_only': True, 'prepared_only': True,
        'manifest': ref(HERE / 'MANIFESTE-COLLECTEURS-PREPARES.json'),
        'components': {name: ref(HERE / name) for name in NAMES},
        'namespace_actual_factory_cases_passed': 3, 'separate_F_closure_cases_passed': 9,
        'neutral_tests_unique': 12, 'old_32_cases_replayed': False, 'ruff_passed': True,
        'capture_parent_powershell_syntax_errors': 0, 'capture_parent_executed': False,
        'seven_future_proof_pins_unbound_and_production_refused': True,
        'old_R2d_closure_and_new_F_closure_distinct': True,
        'historical_role_human_effect_refs_remain_E': True,
        'initial_receiver_r4_full_namespace_and_numeric_lane_preserved': True,
        'main_intent_process_CIM_auth_CLI_model_or_transport_effects': False,
        'native_or_NORMAL_or_performance_admitted': False})
    print(json.dumps(ref(HERE / 'LIVRAISON-COLLECTEURS-PREPARES-POUR-REVUE.json')))


if __name__ == '__main__':
    main()

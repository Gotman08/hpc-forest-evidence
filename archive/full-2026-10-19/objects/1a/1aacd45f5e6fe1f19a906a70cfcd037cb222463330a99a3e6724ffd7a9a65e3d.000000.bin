#include <bits/stdc++.h>

using namespace std;

int A[1000][1000];

typedef long long ll;

ll solve(int m, int n, int k) {
  const int d = min(m, n);
  const int length = max(m, n);
  vector<int> matrix(static_cast<size_t>(d) * length);

  if (m <= n) {
    for (int i = 0; i < m; ++i)
      copy_n(A[i], n, matrix.data() + static_cast<size_t>(i) * length);
  } else {
    for (int i = 0; i < m; ++i)
      for (int j = 0; j < n; ++j)
        matrix[static_cast<size_t>(j) * length + i] = A[i][j];
  }

  vector<int> band(length);
  unordered_map<ll, ll> h;
  ll ans = 0;
  for (int first = 0; first < d; ++first) {
    fill(band.begin(), band.end(), 0);
    for (int last = first; last < d; ++last) {
      const int *row = matrix.data() + static_cast<size_t>(last) * length;
      // Separate contiguous accumulation from the dependent counting scan.
      for (int i = 0; i < length; ++i)
        band[i] += row[i];

      h.clear();
      h[0] = 1;
      ll s = 0;
      for (int i = 0; i < length; ++i) {
        s += band[i];
        ans += h.find(s - k) != h.end() ? h[s - k] : 0;
        h[s]++;
      }
    }
  }
  return ans;
}

int main() {
  int k, m, n;
  cin >> k >> m >> n;
  memset(A, 0, sizeof A);

  for (int i = 0; i < m; i++)
    for (int j = 0; j < n; j++)
      cin >> A[i][j];

  cout << solve(m, n, k) << endl;
  return 0;
}

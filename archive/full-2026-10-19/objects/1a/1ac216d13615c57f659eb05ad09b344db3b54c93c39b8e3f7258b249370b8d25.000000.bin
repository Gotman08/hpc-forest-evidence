{
  "src/solution.cpp": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <iostream>\n#include <vector>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nstatic std::int64_t maximum_horizontal_sum(const std::int64_t* columns,\n                                          int n, int s) {\n    std::int64_t sum = 0;\n    #pragma omp simd reduction(+:sum)\n    for (int c = 0; c < s; ++c)\n        sum += columns[c];\n\n    std::int64_t best = sum;\n    int c = s;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const int64x2_t zero = vdupq_n_s64(0);\n    int64x2_t carry = vdupq_n_s64(sum);\n    int64x2_t maxima = carry;\n    for (; c + 3 < n; c += 4) {\n        // Column totals are already widened before subtraction.\n        int64x2_t low = vsubq_s64(vld1q_s64(columns + c),\n                                  vld1q_s64(columns + c - s));\n        int64x2_t high = vsubq_s64(vld1q_s64(columns + c + 2),\n                                   vld1q_s64(columns + c - s + 2));\n\n        low = vaddq_s64(low, vextq_s64(zero, low, 1));\n        high = vaddq_s64(high, vextq_s64(zero, high, 1));\n        high = vaddq_s64(high, vdupq_laneq_s64(low, 1));\n        low = vaddq_s64(low, carry);\n        high = vaddq_s64(high, carry);\n\n        maxima = vbslq_s64(vcgtq_s64(low, maxima), low, maxima);\n        maxima = vbslq_s64(vcgtq_s64(high, maxima), high, maxima);\n        carry = vdupq_laneq_s64(high, 1);\n    }\n    sum = vgetq_lane_s64(carry, 0);\n    best = std::max(vgetq_lane_s64(maxima, 0),\n                    vgetq_lane_s64(maxima, 1));\n#endif\n    for (; c < n; ++c) {\n        sum += columns[c] - columns[c - s];\n        best = std::max(best, sum);\n    }\n    return best;\n}\n\nint main() {\n    int n, s;\n    if (!(std::cin >> n >> s)) return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    std::vector<int> history(static_cast<std::size_t>(s) * n);\n    std::vector<std::int64_t> columns(n, 0);\n\n    // Fill every ring slot before any outgoing value is consumed.\n    for (int r = 0; r < s; ++r) {\n        int* row = history.data() + static_cast<std::size_t>(r) * n;\n        for (int c = 0; c < n; ++c) {\n            if (std::scanf(\"%d\", &row[c]) != 1) return 0;\n            columns[c] += static_cast<std::int64_t>(row[c]);\n        }\n    }\n\n    std::int64_t maximum = maximum_horizontal_sum(columns.data(), n, s);\n    int slot = 0;\n    for (int r = s; r < n; ++r) {\n        int* row = history.data() + static_cast<std::size_t>(slot) * n;\n        for (int c = 0; c < n; ++c) {\n            const int outgoing = row[c];\n            if (std::scanf(\"%d\", &row[c]) != 1) return 0;\n            columns[c] += static_cast<std::int64_t>(row[c])\n                        - static_cast<std::int64_t>(outgoing);\n        }\n\n        maximum = std::max(maximum,\n                           maximum_horizontal_sum(columns.data(), n, s));\n        if (++slot == s) slot = 0;\n    }\n\n    std::printf(\"%lld\\n\", static_cast<long long>(maximum));\n    return 0;\n}\n"
}

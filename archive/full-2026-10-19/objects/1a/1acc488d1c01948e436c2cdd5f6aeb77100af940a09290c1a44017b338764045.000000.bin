@pytest.mark.parametrize('model', cells.MODELS)
def test_cross_model_session_refused(model):
    other = next(m for m in cells.MODELS if m != model)
    with pytest.raises(ValueError):
        cells.select(model, 'roots', session_id=cells.CELLS[other]['roots'])
    with pytest.raises(ValueError):
        cells.select(model, 'roots', session_id='97f7a5e17d13486ebed5b4f109aea093')



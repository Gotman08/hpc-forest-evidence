def test_reader_abi_is_descriptive_and_closed():
    abi = json.loads((HERE / 'READER-ABI.json').read_text(encoding='utf8'))
    assert len(set(abi['refs14'])) == 14 and len(set(abi['expected11'])) == 11
    assert abi['integration_admitted'] is False and abi['reader_source_copy_or_execution_in_this_delivery'] is False
    assert not (HERE / 'receipt_native.py').exists() and not (HERE / 'receive_phase.py').exists()

def census_fixture():
    def identity(pid, command):
        return {'ProcessId': pid, 'ParentProcessId': 100, 'ExecutablePath': 'C:/NEUTRAL/python.exe',
                'CommandLine': command, 'CreationDate': '2026-10-18T00:00:00.1234567Z'}
    so = [identity(pid, 'python -m hpc_forest.r2max_worker --session-id 665743a02b824021a697b6a4884a667c')
          for pid in (37900, 37848)]
    rows = [*so, {'ProcessId': 0, 'ParentProcessId': 0, 'ExecutablePath': None, 'CommandLine': None, 'CreationDate': None}]
    closure = {'schema': 'hpc-forest-r2c-owned-main-only-stop-receipt-v1', 'verified': True,
               'all_three_main_identities_absent': True, 'source_only_identities_preserved': True,
               'source_only': so, 'actions': [{'identity': identity(pid, 'NEUTRAL closed')} for pid in (1, 2, 3)]}
    census = {'schema': 'hpc-forest-dynamic-r4b-full-cim-v1', 'complete_census': True, 'strict_utf8_decoding': True,
              'captured_at_utc': 1000, 'rows': rows, 'rows_count': len(rows), 'other_native_groups': []}
    return census, closure, identity


def test_census_preserves_so_five_fields_and_tolerates_system_nulls():
    census, closure, _ = census_fixture()
    so, count = factory.check_census(census, closure, now=1000)
    assert count == 1 and {r['ProcessId'] for r in so} == {37900, 37848}


@pytest.mark.parametrize('fault', ['unknown-worker', 'pid-reuse', 'missing-so', 'future', 'expired'])
def test_census_faults_remain_closed(fault):
    census, closure, identity = census_fixture()
    if fault == 'unknown-worker':
        census['rows'].append(identity(999, 'python -m hpc_forest.codex_worker --session-id unknown'))
        census['rows_count'] += 1
    elif fault == 'pid-reuse':
        census['rows'][0] = {**census['rows'][0], 'CreationDate': '2026-10-18T00:00:01Z'}
    elif fault == 'missing-so':
        census['rows'].pop(0)
        census['rows_count'] -= 1
    elif fault == 'future':
        census['captured_at_utc'] = 1001
    else:
        census['captured_at_utc'] = 879
    with pytest.raises(ValueError):
        factory.check_census(census, closure, now=1000)


@pytest.mark.parametrize('groups', [1, 2])
def test_census_counts_actual_admitted_pairs_once(groups, tmp_path, monkeypatch):
    census, closure, identity = census_fixture()
    mock_admission = types.SimpleNamespace(validate_authorization=lambda *args: None)
    monkeypatch.setattr(factory, 'bootstrap_source', lambda: ({}, mock_admission))
    for index in range(groups):
        model = cells.MODELS[index]
        session = cells.CELLS[model]['roots']
        job = str(999990 + index)
        command = str(HERE / 'bootstrap_worker.py') + ' --model ' + model + ' --session-id ' + session
        pair = [identity(9000 + index * 2 + i, command) for i in range(2)]
        auth = {'verified': True, 'scope_id': factory.SCOPE, 'source_zip_sha256': factory.SOURCE,
                'plan_sha256': factory.PLAN, 'model': model, 'effort': 'max', 'session_id': session, 'job_id': job,
                'remote_root': '/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-' + session,
                'purpose': 'technical-contract', 'technical_phase': 'roots', 'NEUTRAL_FIXTURE_ONLY': True}
        path = tmp_path / (model + '.json')
        path.write_text(json.dumps(auth), encoding='utf8')
        census['rows'].extend(pair)
        census['rows_count'] += 2
        census['other_native_groups'].append({'model': model, 'phase': 'roots', 'session_id': session,
            'job_id': job, 'full_identities': pair, 'authorization': factory.reference(path)})
    assert factory.check_census(census, closure, now=1000)[1] == 1 + groups
    with pytest.raises(ValueError, match='Started or duplicate'):
        factory.check_census(census, closure, now=1000, selected_session=cells.CELLS[cells.MODELS[0]]['roots'])

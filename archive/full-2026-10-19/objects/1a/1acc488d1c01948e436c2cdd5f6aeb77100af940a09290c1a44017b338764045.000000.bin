@pytest.mark.parametrize('model', cells.MODELS)
def test_projection_is_exact_and_effect_free(model, monkeypatch):
    def forbidden(*args, **kwargs):
        pytest.fail('Projection attempted an execution or cache gate')
    monkeypatch.setattr(worker, '_execute', forbidden)
    monkeypatch.setattr(worker, '_read_ref', forbidden)
    monkeypatch.setattr(Path, 'mkdir', forbidden)
    session = cells.CELLS[model]['roots']
    ref = {'path': str(HERE / 'NONEXISTENT-EVIDENCE.json'), 'sha256': 'a' * 64}
    result = worker.dry_run(model=model, phase='roots', job_id='999999', effort='max',
        output=HERE / ('worker-' + session), authorization_ref=ref, codex_config_ref=ref, owner_ref=ref)
    assert result['model'] == model and result['session_id'] == session
    assert result['verified'] is False and result['generation_admitted'] is False
    assert result['execution_performed'] is False and result['model_calls'] == 0
    assert '--once' in result['worker_argv'] and result['worker_argv'][-2:] == ['900', '--once']


def test_execute_requires_explicit_flag_before_reading_anything(monkeypatch):
    monkeypatch.setattr(worker, '_fresh_output', lambda spec: pytest.fail('Effect before explicit execute'))
    with pytest.raises(worker.BootstrapError):
        worker._execute({}, execute=False)


@pytest.mark.parametrize('phase,rows', [('roots', []), ('advice', [{}]), ('harvest', [{}, {}])])
def test_phase_gate_no_false_admission(phase, rows):
    if phase == 'roots':
        assert factory.check_previous_phases(rows, cells.MODELS[0], phase) is None
    else:
        with pytest.raises(ValueError, match='not yet integrated'):
            factory.check_previous_phases(rows, cells.MODELS[0], phase)


@pytest.mark.parametrize('phase,rows', [('roots', [{}]), ('advice', []), ('harvest', [{}])])
def test_predecessor_gaps_and_extra_refused(phase, rows):
    with pytest.raises(ValueError):
        factory.check_previous_phases(rows, cells.MODELS[0], phase)


def test_false_template_never_reads_or_writes(monkeypatch):
    monkeypatch.setattr(factory, 'bootstrap_source', lambda: pytest.fail('False draft crossed evidence gate'))
    with pytest.raises(ValueError):
        factory.assemble({'schema': 'hpc-forest-dynamic-r4b-launch-inputs-v1', 'verified': False}, HERE / 'NO-OUTPUT')
    assert not (HERE / 'NO-OUTPUT').exists()


@pytest.fixture
def frozen_render(monkeypatch):
    project = Path(json.loads((HERE / 'pins-source-plan.json').read_text(encoding='utf8'))['source_project'])
    # Execute only this pure function and its literal schema definitions from the
    # sealed AST; no imports, subprocess, compiler, candidate, or native module.
    source = ast.parse((project / 'src/hpc_forest/dynamic_mother.py').read_text(encoding='utf8'))
    wanted = {'object_schema', 'PLAN_SCHEMA', 'ADVICE_SCHEMA', 'HARVEST_SCHEMA', 'TEXT', 'render_meta'}
    nodes = [n for n in source.body if (isinstance(n, ast.FunctionDef) and n.name in wanted)
             or (isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id in wanted for t in n.targets))]
    namespace = {'json': json, 'public_meta_payload': lambda phase, payload: copy.deepcopy(payload), 'InfrastructureError': ValueError}
    exec(compile(ast.Module(body=nodes, type_ignores=[]), '<sealed-pure-render>', 'exec'), namespace)  # noqa: S102 - pure named AST only
    mailbox = types.ModuleType('hpc_forest.codex_mailbox')
    mailbox.PROTOCOL = 'hpc-forest-codex-mailbox-v1'
    mailbox.TOKEN_CEILING = 196608
    dynamic = types.ModuleType('hpc_forest.dynamic_mother')
    dynamic.render_meta = namespace['render_meta']
    package = types.ModuleType('hpc_forest')
    monkeypatch.setitem(sys.modules, 'hpc_forest', package)
    monkeypatch.setitem(sys.modules, 'hpc_forest.codex_mailbox', mailbox)
    monkeypatch.setitem(sys.modules, 'hpc_forest.dynamic_mother', dynamic)
    return namespace


@pytest.mark.parametrize('model', cells.MODELS)
@pytest.mark.parametrize('phase', cells.PHASES)
def test_request_exact_model_phase_schema_and_minimum(model, phase, frozen_render):
    session = cells.CELLS[model][phase]
    request = stage.make_request(phase, session, {}, model=model, now=1000, nonce='b' * 32)
    assert request['model'] == model and request['session_id'] == session and request['reasoning_effort'] == 'max'
    assert request['expires_at'] == 1600 and request['token_ceiling'] == 196608
    baseline = frozen_render['render_meta'](phase, stage.neutral_payload(phase, {}))
    assert request['schema'] == baseline['schema']
    assert request['messages'][1:] == baseline['messages'][1:]
    if phase == 'roots':
        assert request['messages'][0]['content'] == baseline['messages'][0]['content'] + (
            ' For this synthetic roots interface contract, the directions array must contain '
            'between 1 and 8 entries inclusive; an empty array is invalid.')
        assert 'minItems' not in request['schema']['properties']['directions']
    else:
        assert request['messages'] == baseline['messages']


def test_nine_rendered_commands_are_data_not_submit():
    commands = json.loads((HERE / 'COMMANDES-PROPOSEES.json').read_text(encoding='utf8'))
    assert commands['verified'] is False and commands['automatic_loop'] is False
    assert commands['pilot_admitted'] is False and len(commands['commands']) == 9
    for model in cells.MODELS:
        for phase in cells.PHASES:
            folder = HERE / cells.SLUGS[model] / phase
            command = (folder / 'commande-allouee.sh').read_text(encoding='utf8')
            assert command.count('exec srun ') == 1 and '--cpu-bind=cores' in command
            assert '--model ' + model + ' --effort max --phase ' + phase in command
            assert '\n' in command and '\\nexec' not in command
            assert 'sbatch ' not in command and 'codex ' not in command
            proposal = json.loads((folder / 'job-prepare-propose.json').read_text(encoding='utf8'))
            template = json.loads((folder / 'factory-input-NON-ADMIS.json').read_text(encoding='utf8'))
            assert proposal['time_limit'] == '01:00:00' and proposal['cpus_per_task'] == 4
            assert template['verified'] is False and template['job_id'] is None
            assert template['session_id'] == cells.CELLS[model][phase]
    with tarfile.open(HERE / 'native-interface-models-max-r2.tar.gz') as archive:
        assert {m.name for m in archive.getmembers()} == {'remote_stage.py', 'cell_selection.py', 'stage-manifest.json'}
        assert all(m.isfile() for m in archive.getmembers())
        for name in ('remote_stage.py', 'cell_selection.py'):
            assert archive.extractfile(name).read() == (HERE / name).read_bytes()



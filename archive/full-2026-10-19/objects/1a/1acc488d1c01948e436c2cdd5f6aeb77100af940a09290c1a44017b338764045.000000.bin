"""Neutral data/selection tests only: no CLI, worker, C, RPC, or shell execution."""
from __future__ import annotations

import ast
import copy
import hashlib
import importlib.util
import json
import sys
import tarfile
import types
from pathlib import Path

import pytest

HERE = Path(__file__).resolve().parent


def load(name):
    spec = importlib.util.spec_from_file_location('neutral_' + name, HERE / (name + '.py'))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


cells = load('cell_selection')
factory = load('assemble_admissions')
worker = load('bootstrap_worker')
stage = load('remote_stage')
publication = load('publication')


@pytest.mark.parametrize('model', cells.MODELS)
@pytest.mark.parametrize('phase', cells.PHASES)
def test_exact_nine_plan_cells(model, phase):
    pins = json.loads((HERE / 'pins-source-plan.json').read_text(encoding='utf8'))
    plan_path = Path(pins['plan']['path'])
    assert hashlib.sha256(plan_path.read_bytes()).hexdigest() == factory.PLAN
    plan = json.loads(plan_path.read_text(encoding='utf8'))
    assert cells.select(model, phase, session_id=plan['contract_cells'][model][phase]) == cells.CELLS[model][phase]


@pytest.mark.parametrize('bad', ['gpt-6-luna', 'sol', 'gpt-6-sol', 'gpt-5.6-sol', 'GPT-6-ASTRA', '', None])
def test_unknown_or_luna_model_refused(bad):

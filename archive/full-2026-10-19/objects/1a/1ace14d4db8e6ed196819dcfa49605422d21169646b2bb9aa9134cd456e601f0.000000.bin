      "content": "#include \"knn.h\"\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <stdint.h>\n#include <arm_neon.h>\n#endif\n\nenum { KNN_BATCH_SIZE = 16 };\n\nstatic inline int knn_insert_neighbor(float d, char label, int k,\n                                      float *distances, char *labels) {\n    for (int x = 0; x < k; x++) {\n        if (d < distances[x] || distances[x] == -1) {\n            for (int y = k - 1; y > x; y--) {\n                distances[y] = distances[y - 1];\n                labels[y] = labels[y - 1];\n            }\n\n            distances[x] = d;\n            labels[x] = label;\n            return 1;\n        }\n    }\n\n    return 0;\n}\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic inline uint32x4_t knn_axis_candidates(const Point *points,\n                                            float32x4_t target_x,\n                                            float32x4_t target_y,\n                                            float32x4_t cutoff) {\n    float32x4x2_t xy = vld2q_f32((const float *) points);\n    float32x4_t dx = vsubq_f32(xy.val[0], target_x);\n    float32x4_t dy = vsubq_f32(xy.val[1], target_y);\n\n    /* Each rounded squared coordinate is a lower bound on the distance. */\n    return vandq_u32(vcltq_f32(vmulq_f32(dx, dx), cutoff),\n                     vcltq_f32(vmulq_f32(dy, dy), cutoff));\n}\n\nstatic inline unsigned int knn_block_candidates(const Point *points,\n                                                Point target, float limit) {\n    static const uint32_t lane_weights[4] = {1u, 2u, 4u, 8u};\n    uint32x4_t weights = vld1q_u32(lane_weights);\n    float32x4_t target_x = vdupq_n_f32(target.x);\n    float32x4_t target_y = vdupq_n_f32(target.y);\n    float32x4_t cutoff = vdupq_n_f32(limit);\n\n    uint32x4_t m0 = vandq_u32(\n        knn_axis_candidates(points, target_x, target_y, cutoff), weights);\n    uint32x4_t m1 = vandq_u32(\n        knn_axis_candidates(points + 4, target_x, target_y, cutoff),\n        vshlq_n_u32(weights, 4));\n    uint32x4_t m2 = vandq_u32(\n        knn_axis_candidates(points + 8, target_x, target_y, cutoff),\n        vshlq_n_u32(weights, 8));\n    uint32x4_t m3 = vandq_u32(\n        knn_axis_candidates(points + 12, target_x, target_y, cutoff),\n        vshlq_n_u32(weights, 12));\n\n    return (unsigned int) vaddvq_u32(\n        vorrq_u32(vorrq_u32(m0, m1), vorrq_u32(m2, m3)));\n}\n#endif\n\nstatic inline void knn_insertion_ranks(const float *distances, int filled,\n                                       const float *values, int count,\n                                       int *ranks) {\n    int p = 0;\n\n    if (filled == 0) {\n        for (; p < count; p++) {\n            ranks[p] = 0;\n        }\n        return;\n    }\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    uint32x4_t zero = vdupq_n_u32(0u);\n    uint32x4_t one = vdupq_n_u32(1u);\n\n    for (; count - p >= 4; p += 4) {\n        float32x4_t targets = vld1q_f32(values + p);\n        uint32x4_t low = zero;\n        uint32x4_t high = vdupq_n_u32((uint32_t) filled);\n\n        for (;;) {\n            uint32x4_t active = vcltq_u32(low, high);\n            if (vmaxvq_u32(active) == 0u) {\n                break;\n            }\n\n            uint32x4_t mid = vshrq_n_u32(vaddq_u32(low, high), 1);\n            uint32x4_t safe_mid = vbslq_u32(active, mid, zero);\n            float probes[4] = {\n                distances[vgetq_lane_u32(safe_mid, 0)],\n                distances[vgetq_lane_u32(safe_mid, 1)],\n                distances[vgetq_lane_u32(safe_mid, 2)],\n                distances[vgetq_lane_u32(safe_mid, 3)]\n            };\n            uint32x4_t goes_left = vcltq_f32(targets, vld1q_f32(probes));\n\n            high = vbslq_u32(vandq_u32(active, goes_left), mid, high);\n            low = vbslq_u32(vbicq_u32(active, goes_left),\n                             vaddq_u32(mid, one), low);\n        }\n\n        ranks[p] = (int) vgetq_lane_u32(low, 0);\n        ranks[p + 1] = (int) vgetq_lane_u32(low, 1);\n        ranks[p + 2] = (int) vgetq_lane_u32(low, 2);\n        ranks[p + 3] = (int) vgetq_lane_u32(low, 3);\n    }\n#endif\n\n    for (; p < count; p++) {\n        int low = 0;\n        int high = filled;\n\n        while (low < high) {\n            int mid = low + (high - low) / 2;\n            if (values[p] < distances[mid]) {\n                high = mid;\n            } else {\n                low = mid + 1;\n            }\n        }\n\n        ranks[p] = low;\n    }\n}\n\nstatic inline void knn_copy_neighbors_right(int first, int last, int shift,\n                                            float *distances, char *labels) {\n    if (first >= last) {\n        return;\n    }\n\n    int pos = last;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    while (pos - first >= 4) {\n        pos -= 4;\n        float32x4_t values = vld1q_f32(distances + pos);\n        vst1q_f32(distances + pos + shift, values);\n    }\n#endif\n    while (pos > first) {\n        --pos;\n        distances[pos + shift] = distances[pos];\n    }\n\n    pos = last;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    while (pos - first >= 16) {\n        pos -= 16;\n        uint8x16_t values = vld1q_u8((const uint8_t *) (labels + pos));\n        vst1q_u8((uint8_t *) (labels + pos + shift), values);\n    }\n#endif\n    while (pos > first) {\n        --pos;\n        labels[pos + shift] = labels[pos];\n    }\n}\n\nstatic inline int knn_merge_neighbors(float *pending, int count, char label,\n                                      int k, int filled,\n                                      float *distances, char *labels) {\n    if (count == 0) {\n        return filled;\n    }\n\n    for (int p = 1; p < count; p++) {\n        float value = pending[p];\n        int q = p;\n        while (q > 0 && value < pending[q - 1]) {\n            pending[q] = pending[q - 1];\n            --q;\n        }\n        pending[q] = value;\n    }\n\n    /* All searches use the same prefix; equal older points come first. */\n    int ranks[KNN_BATCH_SIZE];\n    knn_insertion_ranks(distances, filled, pending, count, ranks);\n\n    int growth = k - filled;\n    if (growth > count) {\n        growth = count;\n    }\n    int size = filled + growth;\n    int take = 0;\n    while (take < count && ranks[take] < size - take) {\n        ++take;\n    }\n\n    /* Merge backward, moving each retained old element at most once. */\n    int old_end = size - take;\n    for (int p = take - 1; p >= 0; p--) {\n        int rank = ranks[p];\n        knn_copy_neighbors_right(rank, old_end, p + 1, distances, labels);\n        distances[rank + p] = pending[p];\n        labels[rank + p] = label;\n        old_end = rank;\n    }\n\n    return size;\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j;\n    int filled = 0;\n    int ordered = 1;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        j = 0;\n\n        while (j < g.length) {\n            int span = 1;\n\n            if (k > 0 && ordered) {\n                float pending[KNN_BATCH_SIZE];\n                int count = 0;\n                int batch_ok = 1;\n                span = g.length - j;\n                if (span > KNN_BATCH_SIZE) {\n                    span = KNN_BATCH_SIZE;\n                }\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n                if (filled == k && span == KNN_BATCH_SIZE) {\n                    unsigned int mask = knn_block_candidates(\n                        g.points + j, to_evaluate, distances[k - 1]);\n\n                    while (mask != 0u) {\n                        int lane = __builtin_ctz(mask);\n                        mask &= mask - 1u;\n\n                        float d = euclidean_distance_no_sqrt(\n                            to_evaluate, g.points[j + lane]);\n                        if (d < distances[k - 1]) {\n                            pending[count++] = d;\n                        }\n                    }\n                } else\n#endif\n                {\n                    for (int lane = 0; lane < span; lane++) {\n                        float d = euclidean_distance_no_sqrt(\n                            to_evaluate, g.points[j + lane]);\n                        if (filled < k && d != d) {\n                            batch_ok = 0;\n                            break;\n                        }\n                        if (filled < k || d < distances[k - 1]) {\n                            pending[count++] = d;\n                        }\n                    }\n                }\n\n                if (batch_ok) {\n                    filled = knn_merge_neighbors(pending, count, g.label,\n                                                 k, filled, distances, labels);\n                    j += span;\n                    continue;\n                }\n            }\n\n            for (int lane = 0; lane < span; lane++) {\n                float d = euclidean_distance_no_sqrt(\n                    to_evaluate, g.points[j + lane]);\n                if (filled < k || !ordered ||\n                    (k > 0 && d < distances[k - 1])) {\n                    if (knn_insert_neighbor(d, g.label, k, distances, labels)) {\n                        if (filled < k) {\n                            filled++;\n                        }\n                        /* Retain the original scan if a stored NaN breaks ordering. */\n                        if (d != d) {\n                            ordered = 0;\n                        }\n                    }\n                }\n            }\n\n            j += span;\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Batching 16 neighbor insertions against an immutable prefix enables four independent NEON rank searches and one backward merge, reducing serial searches and repeated suffix movement while preserving stable ties.",
  "notes": "Retains scalar distance arithmetic, the coordinate prefilter, and original insertion fallback for stored NaNs. No commands executed; unmeasured.",

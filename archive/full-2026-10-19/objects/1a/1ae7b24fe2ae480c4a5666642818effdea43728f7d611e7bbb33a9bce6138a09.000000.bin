+def preserve_rejected_staging(staging, destination, failure, producer_ref):
+    """Keep rejected generated bytes; never publish or recursively delete them."""
+    staging = local_path(str(staging), directory=True)
+    parent = local_path(str(destination.parent), directory=True)
+    need(staging.resolve(strict=True).parent == parent.resolve(strict=True)
+         and staging.name.startswith(".q15-native-bridge-") and staging != destination,
+         "Refusal staging is outside its intended parent")
+    receipt = {"schema": "hpc-forest-Q15-native-bridge-staging-refusal-v1", "prepared": False,
+               "verified": False, "native_authorization": False, "native_research_admitted": False,
+               "destination_published": False, "staging_preserved": True,
+               "staged_records_are_rejected_not_admissible": True,
+               "staging_directory": str(staging), "intended_destination": str(destination),
+               "error_type": type(failure).__name__, "reason": str(failure), "source_producer": producer_ref}
+    with (staging / "BRIDGE-REFUS.json").open("xb") as handle:
+        handle.write(data(receipt))
+    return receipt
+
+

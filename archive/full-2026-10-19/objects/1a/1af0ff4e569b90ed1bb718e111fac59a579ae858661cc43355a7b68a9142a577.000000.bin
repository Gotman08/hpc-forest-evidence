{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include <algorithm>\\n#include <cstdint>\\n#include <iostream>\\n#include <utility>\\n#include <vector>\\n\\nusing namespace std;\\n\\nstatic constexpr int MOD = 1000000007;\\n\\nstatic int mod_power(int base, int exponent) {\\n    int result = 1;\\n    while (exponent != 0) {\\n        if (exponent & 1)\\n            result = static_cast<int>(uint64_t(result) * base % MOD);\\n        base = static_cast<int>(uint64_t(base) * base % MOD);\\n        exponent >>= 1;\\n    }\\n    return result;\\n}\\n\\nstatic inline int binomial(int down, int right,\\n                           const vector<int>& factorial,\\n                           const vector<int>& inverse_factorial) {\\n    uint64_t value = uint64_t(factorial[down + right]) * inverse_factorial[down] % MOD;\\n    return static_cast<int>(value * inverse_factorial[right] % MOD);\\n}\\n\\nstatic int sparse_paths(int n, const vector<pair<int, int>>& blocked) {\\n    const int limit = 2 * n - 2;\\n    vector<int> factorial(limit + 1), inverse_factorial(limit + 1);\\n    factorial[0] = 1;\\n    for (int i = 1; i <= limit; ++i)\\n        factorial[i] = static_cast<int>(uint64_t(factorial[i - 1]) * i % MOD);\\n    inverse_factorial[limit] = mod_power(factorial[limit], MOD - 2);\\n    for (int i = limit; i > 0; --i)\\n        inverse_factorial[i - 1] = static_cast<int>(uint64_t(inverse_factorial[i]) * i % MOD);\\n\\n    const int count = static_cast<int>(blocked.size());\\n    vector<int> ways(count + 1);\\n    for (int i = 0; i <= count; ++i) {\\n        const int y = i < count ? blocked[i].first : n - 1;\\n        const int x = i < count ? blocked[i].second : n - 1;\\n        uint64_t removed = 0;\\n        // Each contribution reads only completed predecessors. The caller\\n        // bounds count by n, so this unreduced sum fits in uint64_t.\\n        #pragma omp simd reduction(+:removed)\\n        for (int j = 0; j < i; ++j) {\\n            if (blocked[j].second <= x) {\\n                const int down = y - blocked[j].first;\\n                const int right = x - blocked[j].second;\\n                const int continuations = binomial(down, right, factorial, inverse_factorial);\\n                removed += uint64_t(ways[j]) * continuations % MOD;\\n            }\\n        }\\n        const int unrestricted = binomial(y, x, factorial, inverse_factorial);\\n        int value = unrestricted - static_cast<int>(removed % MOD);\\n        if (value < 0)\\n            value += MOD;\\n        ways[i] = value;\\n    }\\n    return ways[count];\\n}\\n\\nstatic inline void advance_segment(int* row, int first, int last) {\\n    first = max(first, 1);\\n    if (first >= last)\\n        return;\\n    int left = row[first - 1];\\n    // This recurrence has a genuine left-to-right dependency.\\n    for (int x = first; x < last; ++x) {\\n        const int value = row[x] + left;\\n        left = value >= MOD ? value - MOD : value;\\n        row[x] = left;\\n    }\\n}\\n\\nstatic int dense_paths(int n, const vector<pair<int, int>>& blocked) {\\n    vector<int> row(n, 0);\\n    row[0] = 1;\\n    size_t next = 0;\\n    for (int y = 0; y < n; ++y) {\\n        int first = 0;\\n        while (next < blocked.size() && blocked[next].first == y) {\\n            const int x = blocked[next].second;\\n            advance_segment(row.data(), first, x);\\n            row[x] = 0;\\n            first = x + 1;\\n            ++next;\\n        }\\n        advance_segment(row.data(), first, n);\\n    }\\n    return row[n - 1];\\n}\\n\\nint main() {\\n    ios::sync_with_stdio(false);\\n    cin.tie(nullptr);\\n\\n    int n, m;\\n    if (!(cin >> n >> m))\\n        return 0;\\n\\n    vector<pair<int, int>> blocked;\\n    blocked.reserve(static_cast<size_t>(m));\\n    bool endpoint_blocked = false;\\n    for (int i = 0; i < m; ++i) {\\n        int y, x;\\n        cin >> y >> x;\\n        blocked.emplace_back(y, x);\\n        if ((y == 0 && x == 0) || (y == n - 1 && x == n - 1))\\n            endpoint_blocked = true;\\n    }\\n    if (endpoint_blocked) {\\n        cout << 0 << '\\\\n';\\n        return 0;\\n    }\\n\\n    sort(blocked.begin(), blocked.end());\\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\\n\\n    const uint64_t count = blocked.size();\\n    const uint64_t dense_work = uint64_t(n) * n;\\n    const uint64_t preprocessing_work = uint64_t(32) * n;\\n    // Conservative operation-count heuristic, not a measured crossover:\\n    // charge each sparse pair 64 dense updates and include table construction.\\n    bool use_sparse = blocked.empty();\\n    if (!use_sparse && count <= uint64_t(n) && dense_work >= preprocessing_work) {\\n        const uint64_t pairs = count * (count + 1) / 2;\\n        use_sparse = pairs <= (dense_work - preprocessing_work) / 64;\\n    }\\n\\n    const int answer = use_sparse ? sparse_paths(n, blocked) : dense_paths(n, blocked);\\n    cout << answer << '\\\\n';\\n    return 0;\\n}\\n\",\n      \"path\": \"src/solution.cpp\"\n    }\n  ],\n  \"hypothesis\": \"Sparse inclusion-exclusion can eliminate quadratic grid traversal for sufficiently few obstacles; its independent predecessor contributions permit a legal SIMD reduction.\",\n  \"notes\": \"No commands or measurements performed. The crossover is deliberately heuristic, not measured. Dense recurrence dependencies remain serial. Both paths handle duplicate obstacles and blocked endpoints using O(n+m) storage.\",\n  \"research\": {\n    \"queries\": [],\n    \"urls\": []\n  },\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Sort and deduplicate obstacles; compute sparse path counts with factorial-based binomial coefficients and first-obstacle subtraction.\",\n    \"Use a bounded unsigned 64-bit SIMD reduction for independent sparse predecessor contributions.\",\n    \"Select sparse computation with a conservative work estimate, including preprocessing; always use the binomial method for empty grids.\",\n    \"Retain a dense fallback using one DP row and obstacle-delimited segments, without quadratic obstacle storage, row copying, or per-cell division.\"\n  ]\n}"}}

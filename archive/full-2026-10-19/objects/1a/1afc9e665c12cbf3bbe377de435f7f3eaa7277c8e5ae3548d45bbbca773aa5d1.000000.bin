        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n#define FORCE_TILE 4\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Share groups of independent target bodies among the current team.\n * SIMD lanes process different targets, never a force reduction.\n */\nstatic void body_force_workshare(Body *p, float dt, int n) {\n  const int full_tiles = n / FORCE_TILE;\n\n  #pragma omp for schedule(static) nowait\n  for (int tile = 0; tile < full_tiles; ++tile) {\n    const int first = tile * FORCE_TILE;\n    float x[FORCE_TILE], y[FORCE_TILE], z[FORCE_TILE];\n    float fx[FORCE_TILE], fy[FORCE_TILE], fz[FORCE_TILE];\n\n    for (int lane = 0; lane < FORCE_TILE; ++lane) {\n      x[lane] = p[first + lane].x;\n      y[lane] = p[first + lane].y;\n      z[lane] = p[first + lane].z;\n      fx[lane] = 0.0f;\n      fy[lane] = 0.0f;\n      fz[lane] = 0.0f;\n    }\n\n    for (int j = 0; j < n; ++j) {\n      const float sx = p[j].x;\n      const float sy = p[j].y;\n      const float sz = p[j].z;\n\n      #pragma omp simd\n      for (int lane = 0; lane < FORCE_TILE; ++lane) {\n        float dx = sx - x[lane];\n        float dy = sy - y[lane];\n        float dz = sz - z[lane];\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx[lane] += dx * inv_dist3;\n        fy[lane] += dy * inv_dist3;\n        fz[lane] += dz * inv_dist3;\n      }\n    }\n\n    for (int lane = 0; lane < FORCE_TILE; ++lane) {\n      p[first + lane].vx += dt*fx[lane];\n      p[first + lane].vy += dt*fy[lane];\n      p[first + lane].vz += dt*fz[lane];\n    }\n  }\n\n  /* This loop's barrier also completes all full-tile force updates. */\n  #pragma omp for schedule(static)\n  for (int i = full_tiles * FORCE_TILE; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/* Preserve the standalone force-update entry point. */\nvoid body_force(Body *p, float dt, int n) {\n  #pragma omp parallel\n  {\n    body_force_workshare(p, dt, n);\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * Reuse one team across all iterations. Barriers separate the force\n   * phase, position updates, and the next iteration's force evaluation.\n   */\n  #pragma omp parallel\n  {\n    for (int iter = 0; iter < N_ITER; iter++) {\n      body_force_workshare(bodies, DT, nbodies);\n\n      #pragma omp for schedule(static)\n      for (int i = 0; i < nbodies; i++) {\n        bodies[i].x += bodies[i].vx * DT;\n        bodies[i].y += bodies[i].vy * DT;\n        bodies[i].z += bodies[i].vz * DT;\n      }\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
        "path": "src/nbody.c"
      }

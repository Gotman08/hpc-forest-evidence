          "integration_sources": [],
          "hypothesis_as_declared_by_model": "A contiguous row-major representation for the dense adjacency and temporary cycle matrices should improve locality during Prim and cycle scans. Passing read-only graphs and matrices by reference should also remove repeated large copies without changing traversal or edge-selection order.",
          "transformations_as_declared_by_model": {

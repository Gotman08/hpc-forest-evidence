      "detailed_trials": [
        {
          "id": "e9f46ecbaf9948a8",
          "role": "A",
          "parent_id": null,
          "delegation_parent": "R/A",
          "integration_sources": [],
          "hypothesis_as_declared_by_model": "Sorted, contiguous obstacle coordinates avoid the baseline's O(N²) blocked-cell storage. For sparse inputs, combinatorial counting reduces work to O(M²); for denser inputs, a contiguous one-row DP fallback retains O(N²) time without the grid allocation. This tests a locality- and data-layout-oriented approach while keeping work bounded by the better of the two methods asymptotically.",
          "transformations_as_declared_by_model": {
            "files": [
              "src/solution.cpp"
            ],
            "retained": [
              "Replace the nested vector<bool> blocked grid with sorted, deduplicated contiguous obstacle coordinates.",
              "Use factorial and inverse-factorial tables with an obstacle-pair recurrence for sparse cases.",
              "Use a single contiguous DP row and sorted obstacle scan as the dense-case fallback."
            ]
          },
          "status": "valid",
          "mean_seconds": 0.05122582738598188,
          "commit": "c70d7572917d66d096550f4f12cd3bdd21497ad4"
        },
        {
          "id": "e6bb64b30f0442ac",
          "role": "B",
          "parent_id": null,
          "delegation_parent": "R/B",
          "integration_sources": [],
          "hypothesis_as_declared_by_model": "A single rolling DP row removes the quadratic blocked-cell allocation and row-copy loops. Splitting each row at obstacles turns its recurrence into independent inclusive prefix scans; four-lane NEON scans can vectorize those spans while preserving the cross-block carry and obstacle reset dependencies.",
          "transformations_as_declared_by_model": {
            "files": [
              "src/solution.cpp"
            ],
            "retained": [
              "Store blocked columns grouped by row and update one rolling DP row in place, using obstacle cells as segment boundaries.",
              "Apply a four-lane NEON inclusive-prefix scan within each unblocked segment, carrying the preceding block's result and reducing modulo MOD; retain scalar handling for tails and non-AArch64 builds.",
              "Disable synchronized iostreams for the potentially large input."
            ]
          },
          "status": "valid",
          "mean_seconds": 0.033389407520492874,
          "commit": "e0a1fe00934c8bc10cc4f610d4ecd7373dcedd1a"
        },
        {
          "id": "3733c7762ed743a6",
          "role": "C",
          "parent_id": null,
          "delegation_parent": "R/C",
          "integration_sources": [],
          "hypothesis_as_declared_by_model": "For sufficiently large grids, processing 64×64 tiles in anti-diagonal waves exposes independent tiles to OpenMP static work sharing while retaining only tile boundary data and sparse blocked coordinates. This should reduce synchronization relative to cell-level wavefront scheduling and avoid the baseline's quadratic obstacle-storage footprint; smaller grids use the serial rolling-row path to avoid parallel overhead.",
          "transformations_as_declared_by_model": {
            "files": [
              "src/solution.cpp"
            ],
            "retained": [
              "Replaced the dense N×N blocked-cell structure with per-row sorted, deduplicated blocked-column lists.",
              "Added a 64×64 anti-diagonal tiled DP; each OpenMP work-sharing iteration computes one tile and publishes its bottom and right boundaries for the next wave.",
              "Used static scheduling and rolling boundary buffers, with two synchronization points per tile wave instead of per cell.",
              "Kept a serial rolling-row DP fallback for smaller grids and builds without OpenMP."
            ]
          },
          "status": "valid",
          "mean_seconds": 0.023442802329858143,
          "commit": "e5224a7e7c059d2bdfb43388706fa23092e45517"
        },
        {

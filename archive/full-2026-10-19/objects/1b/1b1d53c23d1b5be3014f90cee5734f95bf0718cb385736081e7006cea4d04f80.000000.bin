          "integration_sources": [],
          "hypothesis_as_declared_by_model": "For large graphs, a static OpenMP minimum reduction over the independent key candidates can shorten each Prim selection scan; keeping the scan serial below a size threshold should avoid parallel-region overhead on small inputs.",
          "transformations_as_declared_by_model": {
            "files": [

          "integration_sources": [],
          "hypothesis_as_declared_by_model": "On builds enabling OpenMP SIMD, the read-only search for the first eligible top-k distance slot can use a min-index SIMD reduction, reducing the serial comparison chain. The subsequent insertion and shifts remain serial because they update dependent arrays.",
          "transformations_as_declared_by_model": {

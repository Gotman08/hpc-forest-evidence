+def source_modules():
+    verify_dependencies()
+    pins = json.loads((FACTORY_ROOT / "pins-source-plan.json").read_text(encoding="utf8"))
+    need(pins["source_zip"]["sha256"] == SOURCE and pins["plan"]["sha256"] == PLAN
+         and Path(pins["source_project"]) == SOURCE_ROOT and pins.get("source_files") == 105,
+         "Exact isolated source105 required")
+    source = artifact(pins["source_zip"])
+    plan = read(pins["plan"])
+    review = read(pins["independent_source_review"])
+    need(pins["independent_source_review"]["sha256"] == "b903ad78f736fbec86faa47cc24bf99670d5093b9e2367a811a1cc50b5a822d6"
+         and review.get("verified") is True and review.get("blocking_findings") == [], "Actual source105 review required")
+    contract.bind(review)
+    expected = read(pins["source_manifest"])
+    paths = list(SOURCE_ROOT.rglob("*"))
+    need(not any(p.is_symlink() or getattr(p, "is_junction", lambda: False)() for p in (SOURCE_ROOT, *paths)),
+         "Source filesystem alias refused")
+    actual = {p.relative_to(SOURCE_ROOT).as_posix(): sha(p) for p in paths if p.is_file()}
+    with zipfile.ZipFile(source) as archive:
+        members = [m for m in archive.infolist() if not m.is_dir()]
+        zipped = {m.filename.removeprefix("HPC-Forest/"): hashlib.sha256(archive.read(m)).hexdigest() for m in members}
+        need(actual == expected == zipped and len(actual) == len(members) == 105
+             and all(m.filename.startswith("HPC-Forest/") for m in members), "Exact source105/ZIP/manifest mismatch")
+    need(plan["source_zip_sha256"] == SOURCE and plan.get("contract_cells") == pins["contract_cells"]
+         and pins.get("pilot_admitted") is False, "Nine exact technical MAX cells only")
+    src = SOURCE_ROOT / "src"
+    for name, loaded in sys.modules.items():
+        if name == "hpc_forest" or name.startswith("hpc_forest."):
+            need(getattr(loaded, "__file__", None) is not None and Path(loaded.__file__).resolve().is_relative_to(src),
+                 "Another hpc_forest source already imported")
+    sys.dont_write_bytecode = True
+    sys.path.insert(0, str(src))
+    from hpc_forest import dynamic_admission
+    return pins, dynamic_admission
+
+

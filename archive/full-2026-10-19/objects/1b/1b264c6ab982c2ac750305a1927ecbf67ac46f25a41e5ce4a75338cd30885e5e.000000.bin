+def produce_projection(inputs, cell, source_state_binding, *, now=None):
+    """Only the new reviewed SO reader may supply actual private facts."""
+    verify_dependencies()
+    now = time.time() if now is None else now
+    binding = read(source_state_binding)
+    need(set(binding) == {"schema", "revision", "reader", "independent_review"}
+         and binding["schema"] == "hpc-forest-lane-r2-source-state-binding-v1"
+         and binding["revision"] == "r3-command-identity", "Versioned source-state reader binding required")
+    expected = PREP / "integration-factory-lecteur-r4-r2-so-clos/revision-r3-command-identity/source_only_state.py"
+    need(artifact(binding["reader"]) == expected, "Only the isolated command-identity correction can be used")
+    review = read(binding["independent_review"])
+    need(review.get("verified") is True and review.get("blocking_findings") == []
+         and review.get("source_state_reader_sha256") == binding["reader"]["sha256"],
+         "Actual separate source-state command-identity review required")
+    _, admission = source_modules()
+    producer = module("lane_r2_bound_projection", HERE / "lane_projection.py")
+    producer.DEPENDENCIES["source_state"] = (expected, binding["reader"]["sha256"])
+    return producer.prepare(inputs, cell, binding=contract.BASE_IDENTITY,
+                            validate_authorization=admission.validate_authorization, now=now)
 
 

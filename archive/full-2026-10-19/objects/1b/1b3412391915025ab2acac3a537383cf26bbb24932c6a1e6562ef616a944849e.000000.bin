#include <algorithm>
#include <cstdint>
#include <iostream>
#include <vector>

namespace {
using Residue = std::uint32_t;
using Wide = std::uint64_t;
constexpr Wide MOD = 1000000007ULL;
constexpr int BATCH = 16;

void square_mod(std::vector<Residue>& a,
                const std::vector<Residue>& reduction,
                std::vector<Wide>& work) {
    const int n = static_cast<int>(a.size());
    int length = n;
    while (length > 0 && a[length - 1] == 0) {
        --length;
    }
    if (length == 0) {
        return;
    }

    const int highest_degree = 2 * length - 2;
    for (int degree = 0; degree <= highest_degree; ++degree) {
        int i = std::max(0, degree - length + 1);
        const int stop = (degree + 1) / 2;
        Wide sum = 0;
        for (; i + BATCH <= stop; i += BATCH) {
            for (int j = 0; j < BATCH; ++j) {
                sum += static_cast<Wide>(a[i + j]) * a[degree - i - j];
            }
            sum %= MOD;
        }
        for (; i < stop; ++i) {
            sum += static_cast<Wide>(a[i]) * a[degree - i];
        }
        sum %= MOD;
        Wide value = sum + sum;
        if ((degree & 1) == 0) {
            const Wide middle = a[degree / 2];
            value += middle * middle;
        }
        work[degree] = value % MOD;
    }

    // Every live accumulator starts reduced and receives at most 16 products:
    // 16 * (MOD - 1)^2 + (MOD - 1) < 2^64.
    int pending = 0;
    for (int degree = highest_degree; degree >= n; --degree) {
        const Residue factor = static_cast<Residue>(work[degree] % MOD);
        if (factor != 0) {
            Wide* destination = work.data() + degree - n;
            for (int j = 0; j < n; ++j) {
                destination[j] += static_cast<Wide>(factor) * reduction[j];
            }
        }
        if (++pending == BATCH) {
            for (int j = 0; j < degree; ++j) {
                work[j] %= MOD;
            }
            pending = 0;
        }
    }

    const int keep = std::min(n, highest_degree + 1);
    for (int i = 0; i < keep; ++i) {
        a[i] = static_cast<Residue>(work[i] % MOD);
    }
    std::fill(a.begin() + keep, a.end(), 0);
}

void multiply_by_x(std::vector<Residue>& a,
                   const std::vector<Residue>& reduction) {
    const int n = static_cast<int>(a.size());
    const Residue top = a[n - 1];
    if (top == 0) {
        for (int i = n - 1; i > 0; --i) {
            a[i] = a[i - 1];
        }
        a[0] = 0;
        return;
    }
    for (int i = n - 1; i > 0; --i) {
        a[i] = static_cast<Residue>((static_cast<Wide>(top) * reduction[i]
                                    + a[i - 1]) % MOD);
    }
    a[0] = static_cast<Residue>(static_cast<Wide>(top) * reduction[0] % MOD);
}
} // namespace

int main() {
    std::ios::sync_with_stdio(false);
    std::cin.tie(nullptr);

    int n;
    Wide h;
    if (!(std::cin >> n >> h)) {
        return 0;
    }

    std::vector<Residue> initial(n), reduction(n);
    for (int i = 0; i < n; ++i) {
        Wide value;
        std::cin >> value;
        initial[i] = static_cast<Residue>(value % MOD);
    }
    for (int i = 0; i < n; ++i) {
        Wide value;
        std::cin >> value;
        reduction[n - 1 - i] = static_cast<Residue>(value % MOD);
    }

    if (h <= static_cast<Wide>(n)) {
        std::cout << initial[static_cast<int>(h - 1)] << '\n';
        return 0;
    }

    // Ascending-degree coefficients, with x^n = sum reduction[j] * x^j.
    std::vector<Residue> coefficients(n, 0);
    if (n == 1) {
        coefficients[0] = reduction[0];
    } else {
        coefficients[1] = 1;
    }
    std::vector<Wide> work(2 * n - 1);

    const Wide exponent = h - 1;
    Wide bit = 1;
    while (bit <= exponent / 2) {
        bit <<= 1;
    }
    for (bit >>= 1; bit != 0; bit >>= 1) {
        square_mod(coefficients, reduction, work);
        if ((exponent & bit) != 0) {
            multiply_by_x(coefficients, reduction);
        }
    }

    Wide answer = 0;
    for (int begin = 0; begin < n; begin += BATCH) {
        const int end = std::min(n, begin + BATCH);
        for (int i = begin; i < end; ++i) {
            answer += static_cast<Wide>(coefficients[i]) * initial[i];
        }
        answer %= MOD;
    }
    std::cout << answer << '\n';
    return 0;
}

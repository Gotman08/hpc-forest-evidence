      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <assert.h>\n#include <string.h>\n#include <limits.h>\n\ntypedef struct {\n    long int *data;\n    int length;\n    long int total;\n} bucket;\n\nvoid sort(char *a, bucket *b) {\n    const size_t stride = (size_t)b->length;\n\n    for (long int j = 1; j < b->total; ++j) {\n        const long int key = b->data[j];\n        const char *key_string = a + (size_t)key * stride;\n        long int i = j;\n\n        while (i > 0 &&\n               strcmp(a + (size_t)b->data[i - 1] * stride, key_string) > 0) {\n            b->data[i] = b->data[i - 1];\n            --i;\n        }\n        b->data[i] = key;\n    }\n}\n\n/* The source and destination index arrays are distinct allocations. */\nstatic void merge_runs(const char *a, size_t stride,\n                       const long int *restrict src,\n                       long int *restrict dst,\n                       size_t first, size_t middle, size_t last) {\n    size_t i = first;\n    size_t j = middle;\n    size_t out = first;\n\n    /* Cursor updates depend on comparisons; this loop is deliberately scalar. */\n    while (i < middle && j < last) {\n        const long int left_key = src[i];\n        const long int right_key = src[j];\n        const int take_left =\n            strcmp(a + (size_t)left_key * stride,\n                   a + (size_t)right_key * stride) <= 0;\n\n        dst[out++] = take_left ? left_key : right_key;\n        i += (size_t)take_left;\n        j += (size_t)!take_left;\n    }\n\n    /* These nonoverlapping spans permit optimized bulk copies. */\n    if (i < middle) {\n        memcpy(dst + out, src + i, (middle - i) * sizeof(*dst));\n    } else if (j < last) {\n        memcpy(dst + out, src + j, (last - j) * sizeof(*dst));\n    }\n}\n\nlong int *bucket_sort(char *a, int length, long int size,\n                      int offset, int nbuckets) {\n    enum { INITIAL_RUN = 16 };\n    (void)offset;\n    (void)nbuckets;\n\n    if (size <= 0)\n        return NULL;\n\n    const size_t n = (size_t)size;\n    const size_t stride = (size_t)length;\n    if (n > (size_t)-1 / sizeof(long int))\n        exit(EXIT_FAILURE);\n\n    long int *indices = (long int *)malloc(n * sizeof(*indices));\n    if (indices == NULL)\n        exit(EXIT_FAILURE);\n\n    /* Independent stores allow ordinary compiler vectorization. */\n    for (size_t i = 0; i < n; ++i)\n        indices[i] = (long int)i;\n\n    for (size_t first = 0; first < n;) {\n        size_t count = n - first;\n        if (count > INITIAL_RUN)\n            count = INITIAL_RUN;\n\n        bucket run;\n        run.data = indices + first;\n        run.length = length;\n        run.total = (long int)count;\n        sort(a, &run);\n        first += count;\n    }\n\n    if (n <= INITIAL_RUN)\n        return indices;\n\n    long int *scratch = (long int *)malloc(n * sizeof(*scratch));\n    if (scratch == NULL) {\n        free(indices);\n        exit(EXIT_FAILURE);\n    }\n\n    long int *src = indices;\n    long int *dst = scratch;\n    size_t width = INITIAL_RUN;\n\n    while (width < n) {\n        for (size_t first = 0; first < n;) {\n            const size_t middle =\n                first + (n - first < width ? n - first : width);\n            const size_t last =\n                middle + (n - middle < width ? n - middle : width);\n\n            if (middle == last ||\n                strcmp(a + (size_t)src[middle - 1] * stride,\n                       a + (size_t)src[middle] * stride) <= 0) {\n                memcpy(dst + first, src + first,\n                       (last - first) * sizeof(*dst));\n            } else {\n                merge_runs(a, stride, src, dst, first, middle, last);\n            }\n            first = last;\n        }\n\n        long int *tmp = src;\n        src = dst;\n        dst = tmp;\n\n        /* Stop after the final merge without overflowing the doubled width. */\n        if (width >= n - width)\n            break;\n        width += width;\n    }\n\n    free(dst);\n    return src;\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb) {\n    char *strings = NULL;\n    int len, offset, nbucket;\n    long int n;\n\n    if (fscanf(stdin, \"%d\", &len) != 1) {\n        printf(\"ERROR len\\n\");\n        exit(1);\n    }\n\n    if (fscanf(stdin, \"%ld\", &n) != 1) {\n        printf(\"ERROR n\\n\");\n        exit(1);\n    }\n\n    if (fscanf(stdin, \"%d\", &offset) != 1) {\n        printf(\"ERROR offset\\n\");\n        exit(1);\n    }\n\n    if (fscanf(stdin, \"%d\", &nbucket) != 1) {\n        printf(\"ERROR nbucket\\n\");\n        exit(1);\n    }\n\n    if (len < 0 || len == INT_MAX || n < 0 || nbucket == INT_MAX)\n        exit(EXIT_FAILURE);\n\n    nbucket = nbucket + 1;\n    len = len + 1;\n\n    if ((size_t)n > (size_t)-1 / (size_t)len)\n        exit(EXIT_FAILURE);\n\n    strings = (char *)malloc((size_t)n * (size_t)len);\n    if (strings == NULL && n != 0)\n        exit(EXIT_FAILURE);\n\n    for (long int i = 0; i < n; ++i) {\n        if (fscanf(stdin, \"%s\", strings + (size_t)i * (size_t)len) != 1) {\n            printf(\"ERROR %ld\\n\", i);\n            exit(1);\n        }\n    }\n\n    *vString = strings;\n    *N = n;\n    *l = len;\n    *os = offset;\n    *nb = nbucket;\n}\n\nvoid print(char *strings, long int *index, long int n, int len) {\n    for (long int i = 0; i < n; ++i) {\n        printf(\"%ld -> %s\\n\", i,\n               strings + (size_t)index[i] * (size_t)len);\n    }\n}\n\nvoid save(char *strings, long int *index, long int n, int len) {\n    for (long int i = 0; i < n; ++i) {\n        printf(\"%s\\n\", strings + (size_t)index[i] * (size_t)len);\n    }\n}\n\nint main(int ac, char **av) {\n    char *strings = NULL;\n    long int N = 0;\n    long int *index = NULL;\n    int len = 0, offset, nbuckets;\n    (void)ac;\n    (void)av;\n\n    load(&strings, &N, &len, &offset, &nbuckets);\n    index = bucket_sort(strings, len, N, offset, nbuckets);\n    save(strings, index, N, len);\n\n    free(strings);\n    free(index);\n    return EXIT_SUCCESS;\n}\n",

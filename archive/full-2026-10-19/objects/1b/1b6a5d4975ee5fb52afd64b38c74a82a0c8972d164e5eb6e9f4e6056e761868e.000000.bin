          ],
          "retained": [
            "Replace the per-point linear scan and array shifts with a size-k max-heap stored in a contiguous Neighbor array.",
            "Store original traversal ordinals to preserve selection of earlier points when distances tie; retain the existing label sorting and vote logic."
          ]
        },

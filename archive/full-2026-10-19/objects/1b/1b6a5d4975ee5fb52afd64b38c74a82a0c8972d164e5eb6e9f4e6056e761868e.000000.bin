          ],
          "retained": [
            "Replace per-point top-k scans and shifts with a contiguous max-heap, storing traversal ordinals to preserve earlier-point precedence on equal distances; cap heap capacity at min(k, total point count).",
            "If a computed distance is NaN, rerun the original ordered scan. Preserve the existing label sort and plurality vote."
          ]
        },

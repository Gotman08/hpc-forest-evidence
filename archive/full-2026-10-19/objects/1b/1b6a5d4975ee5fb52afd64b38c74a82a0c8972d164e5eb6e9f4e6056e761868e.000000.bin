    {
      "id": "e499a157e6f74ad7",
      "role": "G",
      "mission": {
        "base_commit": "b7eaf5a29bb103ac4f2e8d8dba5f6f3acf99f94c",
        "delegation_parent": "R/G",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "A bounded max-heap reduces top-k maintenance from repeated O(k) scans and shifts to O(log k) per point while preserving earlier traversal order for equal distances. This should improve the full program when top-k maintenance is a significant cost; the controller should verify the result on the target.",
        "id": "e499a157e6f74ad7",
        "ordinal": 1,
        "parent_id": null,
        "role": "G",
        "source_commits": [
          "33d85fc90afa6ff6b7c8fb20cf7f380e125357b8"
        ],
        "sources": [
          "b671e999abac4de6"
        ],
        "transformations": {
          "files": [
            "src/knn.c"
          ],
          "retained": [
            "Replace the per-point top-k linear scan and shifts with a contiguous size-k max-heap, capped at the total point count.",
            "Use traversal ordinals to retain earlier points when distances tie; preserve the existing label sort and plurality vote.",
            "Fall back to the original scan when a NaN distance is encountered."
          ]
        },
        "tree_id": "e1:G",
        "trial_id": "01M51NS8XN63BA4HMS4RM0XPHP",

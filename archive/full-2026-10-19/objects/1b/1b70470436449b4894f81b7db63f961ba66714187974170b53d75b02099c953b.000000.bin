#include <iostream>
#include <vector>
#include <cstdio>
#include <algorithm>
#include <climits>
#include <cstdint>
#include <omp.h>
#include <arm_neon.h>

// Fast integer reader using fread buffer (source A)
static int read_int() {
    static char buf[1 << 20];
    static size_t pos = 0, len = 0;
    while (pos >= len) {
        len = fread(buf, 1, sizeof(buf), stdin);
        if (!len) return 0; // should not happen
        pos = 0;
    }
    while (buf[pos] < '0' && buf[pos] != '-') {
        ++pos;
        if (pos >= len) {
            len = fread(buf, 1, sizeof(buf), stdin);
            if (!len) return 0;
            pos = 0;
        }
    }
    bool neg = false;
    if (buf[pos] == '-') { neg = true; ++pos; }
    int x = 0;
    while (true) {
        if (pos >= len) {
            size_t nread = fread(buf, 1, sizeof(buf), stdin);
            if (!nread) break;
            pos = 0;
            len = nread;
        }
        char c = buf[pos];
        if (c < '0' || c > '9') break;
        x = x * 10 + (c - '0');
        ++pos;
    }
    return neg ? -x : x;
}

int main() {
    int n = read_int();
    int s = read_int();

    // Integral image with stride = n+1, no separate matrix storage (source A)
    const int stride = n + 1;
    std::vector<int64_t> pref(static_cast<size_t>(stride) * static_cast<size_t>(stride), 0);
    int64_t* __restrict__ p = pref.data();

    // Build integral image on-the-fly during input reading (source A)
    for (int i = 0; i < n; ++i) {
        long long row_sum = 0;
        int base_cur = (i + 1) * stride;
        int base_prev = i * stride;
        #pragma ivdep
        for (int j = 0; j < n; ++j) {
            int val = read_int();
            row_sum += val;
            p[base_cur + j + 1] = p[base_prev + j + 1] + row_sum;
        }
    }

    // Search phase: parallel over rows with NEON SIMD (sources B, C)
    int64_t mxSum = LLONG_MIN;
    #pragma omp parallel for reduction(max:mxSum) schedule(static)
    for (int i = 0; i <= n - s; ++i) {
        const int base_i_ps = i * stride;
        const int base_is_ps = (i + s) * stride;

        // Process two columns at a time using NEON intrinsics (source B)
        int j = 0;
        for (; j + 1 <= n - s; j += 2) {
            int64x2_t v_a = vld1q_s64(&p[base_is_ps + j + s]);
            int64x2_t v_b = vld1q_s64(&p[base_i_ps + j + s]);
            int64x2_t v_c = vld1q_s64(&p[base_is_ps + j]);
            int64x2_t v_d = vld1q_s64(&p[base_i_ps + j]);

            int64x2_t v_sum = vsubq_s64(v_a, v_b);
            v_sum = vsubq_s64(v_sum, v_c);
            v_sum = vaddq_s64(v_sum, v_d);

            const int64_t sum0 = vgetq_lane_s64(v_sum, 0);
            const int64_t sum1 = vgetq_lane_s64(v_sum, 1);
            if (sum0 > mxSum) mxSum = sum0;
            if (sum1 > mxSum) mxSum = sum1;
        }

        // Handle remaining column if odd number of columns
        for (; j <= n - s; ++j) {
            const int64_t sub_sum = p[base_is_ps + j + s]
                                  - p[base_i_ps + j + s]
                                  - p[base_is_ps + j]
                                  + p[base_i_ps + j];
            if (sub_sum > mxSum) mxSum = sub_sum;
        }
    }

    printf("%lld\n", static_cast<long long>(mxSum));
    return 0;
}

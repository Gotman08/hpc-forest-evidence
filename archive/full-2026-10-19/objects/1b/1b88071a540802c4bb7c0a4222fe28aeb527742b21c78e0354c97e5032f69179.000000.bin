        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdint.h>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nstatic inline void body_force_one(Body *p, float dt, int n, int i) {\n  float fx = 0.0f;\n  float fy = 0.0f;\n  float fz = 0.0f;\n\n  for (int j = 0; j < n; j++) {\n    float dx = p[j].x - p[i].x;\n    float dy = p[j].y - p[i].y;\n    float dz = p[j].z - p[i].z;\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n    fx += dx * inv_dist3;\n    fy += dy * inv_dist3;\n    fz += dz * inv_dist3;\n  }\n\n  p[i].vx += dt*fx;\n  p[i].vy += dt*fy;\n  p[i].vz += dt*fz;\n}\n\n#if defined(__aarch64__)\nstatic inline __attribute__((always_inline))\nfloat32x4_t reference_inverse_distance(float32x4_t d) {\n  float64x2_t lo = vcvt_f64_f32(vget_low_f32(d));\n  float64x2_t hi = vcvt_f64_f32(vget_high_f32(d));\n  const float64x2_t one = vdupq_n_f64(1.0);\n  lo = vdivq_f64(one, vsqrtq_f64(lo));\n  hi = vdivq_f64(one, vsqrtq_f64(hi));\n  return vcombine_f32(vcvt_f32_f64(lo), vcvt_f32_f64(hi));\n}\n\nstatic inline __attribute__((always_inline))\nfloat32x4_t certified_inverse_distance(float32x4_t d) {\n  float32x4_t estimate = vrsqrteq_f32(d);\n  estimate = vmulq_f32(estimate,\n      vrsqrtsq_f32(vmulq_f32(d, estimate), estimate));\n  estimate = vmulq_f32(estimate,\n      vrsqrtsq_f32(vmulq_f32(d, estimate), estimate));\n\n  const float64x2_t xlo = vcvt_f64_f32(vget_low_f32(d));\n  const float64x2_t xhi = vcvt_f64_f32(vget_high_f32(d));\n  float64x2_t ylo = vcvt_f64_f32(vget_low_f32(estimate));\n  float64x2_t yhi = vcvt_f64_f32(vget_high_f32(estimate));\n  ylo = vmulq_f64(ylo,\n      vrsqrtsq_f64(vmulq_f64(xlo, ylo), ylo));\n  yhi = vmulq_f64(yhi,\n      vrsqrtsq_f64(vmulq_f64(xhi, yhi), yhi));\n\n  /*\n   * Certify the approximation rather than relying on estimate accuracy.\n   * A small residual bounds its relative error well below 2^-39.\n   * Finite distances are at least SOFTENING, so their inverse distances\n   * and all products used by this certificate are normal doubles.\n   */\n  const float64x2_t one = vdupq_n_f64(1.0);\n  const float64x2_t zero = vdupq_n_f64(0.0);\n  const float64x2_t bound = vdupq_n_f64(0x1p-40);\n  float64x2_t rlo = vfmsq_f64(one, vmulq_f64(xlo, ylo), ylo);\n  float64x2_t rhi = vfmsq_f64(one, vmulq_f64(xhi, yhi), yhi);\n  uint64x2_t safe_lo = vandq_u64(\n      vcltq_f64(vabsq_f64(rlo), bound), vcgtq_f64(ylo, zero));\n  uint64x2_t safe_hi = vandq_u64(\n      vcltq_f64(vabsq_f64(rhi), bound), vcgtq_f64(yhi, zero));\n\n  /*\n   * Normal float rounding discards 29 double significand bits. Reject\n   * candidates within 2^16 double ULPs of a float rounding midpoint.\n   * This guard exceeds both the certified error and the double sqrt/div\n   * rounding error of the reference. Unsigned subtraction wraps below\n   * the guarded interval, making those values safely outside it.\n   */\n  const uint64x2_t tail_mask = vdupq_n_u64(UINT64_C(0x1fffffff));\n  const uint64x2_t lower = vdupq_n_u64(UINT64_C(0x0fff0000));\n  const uint64x2_t width = vdupq_n_u64(UINT64_C(0x00020000));\n  uint64x2_t offset_lo = vsubq_u64(\n      vandq_u64(vreinterpretq_u64_f64(ylo), tail_mask), lower);\n  uint64x2_t offset_hi = vsubq_u64(\n      vandq_u64(vreinterpretq_u64_f64(yhi), tail_mask), lower);\n  safe_lo = vandq_u64(safe_lo, vcgtq_u64(offset_lo, width));\n  safe_hi = vandq_u64(safe_hi, vcgtq_u64(offset_hi, width));\n\n  uint32x4_t safe = vreinterpretq_u32_u64(vandq_u64(safe_lo, safe_hi));\n  if (__builtin_expect(vminvq_u32(safe) != UINT32_MAX, 0)) {\n    return reference_inverse_distance(d);\n  }\n  return vcombine_f32(vcvt_f32_f64(ylo), vcvt_f32_f64(yhi));\n}\n#endif\n\n/*\n * Vector lanes represent independent targets. Every lane retains the\n * original ascending source order; positions remain read-only here.\n */\nvoid body_force(Body *p, float dt, int n) {\n  if (n <= 0) return;\n\n#if defined(__aarch64__)\n  const int blocks = n / 4;\n  #pragma omp parallel for schedule(static) if(n >= 64)\n  for (int block = 0; block < blocks; ++block) {\n    const int i = 4 * block;\n    const float32x4_t px = {p[i].x, p[i+1].x, p[i+2].x, p[i+3].x};\n    const float32x4_t py = {p[i].y, p[i+1].y, p[i+2].y, p[i+3].y};\n    const float32x4_t pz = {p[i].z, p[i+1].z, p[i+2].z, p[i+3].z};\n    const float32x4_t softening = vdupq_n_f32(SOFTENING);\n    float32x4_t fx = vdupq_n_f32(0.0f);\n    float32x4_t fy = vdupq_n_f32(0.0f);\n    float32x4_t fz = vdupq_n_f32(0.0f);\n\n    for (int j = 0; j < n; ++j) {\n      float32x4_t dx = vdupq_n_f32(p[j].x) - px;\n      float32x4_t dy = vdupq_n_f32(p[j].y) - py;\n      float32x4_t dz = vdupq_n_f32(p[j].z) - pz;\n      float32x4_t sqrd_dist = dx*dx + dy*dy + dz*dz + softening;\n      float32x4_t inv_dist = certified_inverse_distance(sqrd_dist);\n      float32x4_t inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    float fxs[4], fys[4], fzs[4];\n    vst1q_f32(fxs, fx);\n    vst1q_f32(fys, fy);\n    vst1q_f32(fzs, fz);\n    for (int lane = 0; lane < 4; ++lane) {\n      p[i+lane].vx += dt*fxs[lane];\n      p[i+lane].vy += dt*fys[lane];\n      p[i+lane].vz += dt*fzs[lane];\n    }\n  }\n\n  for (int i = 4 * blocks; i < n; ++i) {\n    body_force_one(p, dt, n, i);\n  }\n#else\n  #pragma omp parallel for schedule(static) if(n >= 64)\n  for (int i = 0; i < n; ++i) {\n    body_force_one(p, dt, n, i);\n  }\n#endif\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n  \n  exit(EXIT_SUCCESS);\n}\n",
        "path": "src/nbody.c"
      }

        "content": "#include <ctype.h>\n#include <errno.h>\n#include <limits.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\ntypedef struct {\n  int id;\n  float value;\n  size_t edge_begin;\n  size_t edge_count;\n  int next;\n} Node;\n\ntypedef struct {\n  int id;\n  int index;\n} IdIndex;\n\ntypedef struct {\n  char *text;\n  int id;\n  float cost;\n} Query;\n\nstatic void fail(void) {\n  fputs(\"Error!\\n\", stderr);\n  exit(EXIT_FAILURE);\n}\n\nstatic size_t checked_size_mul(size_t left, size_t right) {\n  if (right != 0 && left > SIZE_MAX / right)\n    fail();\n  return left * right;\n}\n\nstatic void *checked_malloc(size_t size) {\n  void *result = malloc(size);\n  if (result == NULL && size != 0)\n    fail();\n  return result;\n}\n\nstatic void *checked_realloc(void *memory, size_t size) {\n  void *result = realloc(memory, size);\n  if (result == NULL && size != 0)\n    fail();\n  return result;\n}\n\nstatic char *read_line(FILE *stream) {\n  size_t capacity = 128;\n  size_t length = 0;\n  char *line = checked_malloc(capacity);\n  int ch;\n\n  while ((ch = fgetc(stream)) != EOF && ch != '\\n') {\n    if (length == capacity - 1) {\n      if (capacity > SIZE_MAX / 2)\n        fail();\n      capacity *= 2;\n      line = checked_realloc(line, capacity);\n    }\n    line[length++] = (char)ch;\n  }\n\n  if (ch == EOF && length == 0) {\n    free(line);\n    return NULL;\n  }\n  if (length > 0 && line[length - 1] == '\\r')\n    length--;\n  line[length] = '\\0';\n  return line;\n}\n\nstatic char *skip_space(char *text) {\n  while (*text != '\\0' && isspace((unsigned char)*text))\n    text++;\n  return text;\n}\n\nstatic int parse_int(char **cursor) {\n  char *start = skip_space(*cursor);\n  char *end = NULL;\n  errno = 0;\n  long value = strtol(start, &end, 10);\n  if (end == start || errno == ERANGE || value < INT_MIN || value > INT_MAX)\n    fail();\n  *cursor = end;\n  return (int)value;\n}\n\nstatic int parse_token_int(const char *token) {\n  char *end = NULL;\n  errno = 0;\n  long value = strtol(token, &end, 10);\n  if (end == token || *end != '\\0' || errno == ERANGE ||\n      value < INT_MIN || value > INT_MAX)\n    fail();\n  return (int)value;\n}\n\nstatic void append_int(int **values, size_t *count, size_t *capacity,\n                       int value) {\n  if (*count == *capacity) {\n    size_t new_capacity;\n    if (*capacity == 0) {\n      new_capacity = 16;\n    } else {\n      if (*capacity > SIZE_MAX / 2)\n        fail();\n      new_capacity = *capacity * 2;\n    }\n    *values = checked_realloc(\n        *values, checked_size_mul(new_capacity, sizeof(**values)));\n    *capacity = new_capacity;\n  }\n  if (*count == SIZE_MAX)\n    fail();\n  (*values)[(*count)++] = value;\n}\n\nstatic void append_query(Query **queries, size_t *count, size_t *capacity,\n                         char *text, int id) {\n  if (*count == *capacity) {\n    size_t new_capacity;\n    if (*capacity == 0) {\n      new_capacity = 16;\n    } else {\n      if (*capacity > SIZE_MAX / 2)\n        fail();\n      new_capacity = *capacity * 2;\n    }\n    *queries = checked_realloc(\n        *queries, checked_size_mul(new_capacity, sizeof(**queries)));\n    *capacity = new_capacity;\n  }\n  if (*count == SIZE_MAX)\n    fail();\n  (*queries)[*count].text = text;\n  (*queries)[*count].id = id;\n  (*queries)[*count].cost = 0.0f;\n  (*count)++;\n}\n\nstatic int compare_id_index(const void *left, const void *right) {\n  const IdIndex *a = left;\n  const IdIndex *b = right;\n  if (a->id != b->id)\n    return a->id < b->id ? -1 : 1;\n  if (a->index != b->index)\n    return a->index < b->index ? -1 : 1;\n  return 0;\n}\n\nstatic int find_by_id(const IdIndex *ids, int count, int id) {\n  size_t low = 0;\n  size_t high = (size_t)count;\n\n  while (low < high) {\n    size_t middle = low + (high - low) / 2;\n    if (ids[middle].id < id)\n      low = middle + 1;\n    else\n      high = middle;\n  }\n  if (low < (size_t)count && ids[low].id == id)\n    return ids[low].index;\n  return -1;\n}\n\nstatic float cost_from_node(int start, int count, const Node *nodes,\n                            float *costs, unsigned char *done, int *path) {\n  if (start < 0)\n    return 0.0f;\n\n  size_t path_length = 0;\n  int current = start;\n  while (current >= 0 && !done[current]) {\n    if (path_length >= (size_t)count)\n      fail();\n    path[path_length++] = current;\n    current = nodes[current].next;\n  }\n\n  float total = current >= 0 ? costs[current] : 0.0f;\n  while (path_length > 0) {\n    int node = path[--path_length];\n    total = nodes[node].value + total;\n    costs[node] = total;\n    done[node] = 1;\n  }\n  return costs[start];\n}\n\nint main(void) {\n  char *header = read_line(stdin);\n  if (header == NULL)\n    fail();\n\n  char *cursor = skip_space(header);\n  int node_count = parse_int(&cursor);\n  if (node_count < 0)\n    fail();\n\n  Query *queries = NULL;\n  size_t query_count = 0;\n  size_t query_capacity = 0;\n  cursor = skip_space(cursor);\n  while (*cursor != '\\0') {\n    char *token = cursor;\n    while (*cursor != '\\0' && !isspace((unsigned char)*cursor))\n      cursor++;\n    if (*cursor != '\\0')\n      *cursor++ = '\\0';\n    append_query(&queries, &query_count, &query_capacity, token,\n                 parse_token_int(token));\n    cursor = skip_space(cursor);\n  }\n\n  Node *nodes = NULL;\n  if (node_count > 0) {\n    nodes = checked_malloc(\n        checked_size_mul((size_t)node_count, sizeof(*nodes)));\n  }\n\n  int *edges = NULL;\n  size_t edge_count = 0;\n  size_t edge_capacity = 0;\n  for (int i = 0; i < node_count; i++) {\n    char *record = read_line(stdin);\n    if (record == NULL)\n      fail();\n\n    char *position = skip_space(record);\n    Node *node = &nodes[i];\n    node->id = parse_int(&position);\n    position = skip_space(position);\n\n    char *value_end = NULL;\n    float value = strtof(position, &value_end);\n    if (value_end == position)\n      fail();\n    node->value = value;\n    node->edge_begin = edge_count;\n    node->edge_count = 0;\n    node->next = -1;\n    position = value_end;\n\n    position = skip_space(position);\n    while (*position != '\\0') {\n      int neighbor_id = parse_int(&position);\n      append_int(&edges, &edge_count, &edge_capacity, neighbor_id);\n      if (node->edge_count == SIZE_MAX)\n        fail();\n      node->edge_count++;\n      position = skip_space(position);\n    }\n    free(record);\n  }\n\n  IdIndex *ids = NULL;\n  if (node_count > 0) {\n    ids = checked_malloc(\n        checked_size_mul((size_t)node_count, sizeof(*ids)));\n    for (int i = 0; i < node_count; i++) {\n      ids[i].id = nodes[i].id;\n      ids[i].index = i;\n    }\n    if (node_count > 1)\n      qsort(ids, (size_t)node_count, sizeof(*ids), compare_id_index);\n  }\n\n  for (size_t edge = 0; edge < edge_count; edge++)\n    edges[edge] = find_by_id(ids, node_count, edges[edge]);\n\n  for (int i = 0; i < node_count; i++) {\n    Node *node = &nodes[i];\n    float maximum = 0.0f;\n    int best = -1;\n    for (size_t j = 0; j < node->edge_count; j++) {\n      int neighbor = edges[node->edge_begin + j];\n      if (neighbor >= 0 && maximum < nodes[neighbor].value) {\n        maximum = nodes[neighbor].value;\n        best = neighbor;\n      }\n    }\n    node->next = best;\n  }\n\n  float *costs = NULL;\n  unsigned char *done = NULL;\n  int *path = NULL;\n  if (node_count > 0) {\n    size_t count = (size_t)node_count;\n    costs = checked_malloc(checked_size_mul(count, sizeof(*costs)));\n    done = checked_malloc(count);\n    memset(done, 0, count);\n    path = checked_malloc(checked_size_mul(count, sizeof(*path)));\n  }\n\n  for (size_t i = 0; i < query_count; i++) {\n    int start = find_by_id(ids, node_count, queries[i].id);\n    queries[i].cost = cost_from_node(start, node_count, nodes, costs, done, path);\n  }\n\n  for (size_t i = 0; i < query_count; i++)\n    printf(\"%s: %f\\n\", queries[i].text, queries[i].cost);\n\n  free(path);\n  free(done);\n  free(costs);\n  free(ids);\n  free(edges);\n  free(nodes);\n  free(queries);\n  free(header);\n  return 0;\n}\n",
        "path": "src/graph.c"
      }

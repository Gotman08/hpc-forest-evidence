#include <bits/stdc++.h>

using namespace std;

using u64 = uint64_t;
using u128 = unsigned __int128;
static constexpr u64 MOD = 1000000007ULL;

static vector<u64> multiply_mod(const vector<u64>& lhs,
                                const vector<u64>& rhs,
                                const vector<u64>& recurrence) {
    const int n = static_cast<int>(lhs.size());
    vector<u128> product(static_cast<size_t>(2 * n - 1), 0);

    for (int i = 0; i < n; ++i) {
        if (lhs[i] == 0) continue;
        for (int j = 0; j < n; ++j) {
            if (rhs[j] != 0) {
                product[static_cast<size_t>(i + j)] +=
                    static_cast<u128>(lhs[i]) * rhs[j];
            }
        }
    }

    for (int degree = 2 * n - 2; degree >= n; --degree) {
        const u64 value = static_cast<u64>(product[degree] % MOD);
        if (value == 0) continue;
        for (int j = 1; j <= n; ++j) {
            const u64 coefficient = recurrence[j - 1];
            if (coefficient != 0) {
                product[static_cast<size_t>(degree - j)] +=
                    static_cast<u128>(value) * coefficient;
            }
        }
    }

    vector<u64> result(static_cast<size_t>(n));
    for (int i = 0; i < n; ++i) {
        result[i] = static_cast<u64>(product[i] % MOD);
    }
    return result;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    u64 h;
    if (!(cin >> n >> h)) return 0;

    vector<u64> initial(static_cast<size_t>(n));
    vector<u64> recurrence(static_cast<size_t>(n));
    for (u64& value : initial) {
        cin >> value;
        value %= MOD;
    }
    for (u64& value : recurrence) {
        cin >> value;
        value %= MOD;
    }

    vector<u64> result(static_cast<size_t>(n), 0);
    result[0] = 1;

    vector<u64> power(static_cast<size_t>(n), 0);
    if (n == 1) {
        power[0] = recurrence[0];
    } else {
        power[1] = 1;
    }

    u64 exponent = h - 1;
    while (exponent != 0) {
        if (exponent & 1ULL) {
            result = multiply_mod(result, power, recurrence);
        }
        exponent >>= 1ULL;
        if (exponent != 0) {
            power = multiply_mod(power, power, recurrence);
        }
    }

    u64 answer = 0;
    for (int i = 0; i < n; ++i) {
        answer = (answer + result[i] * initial[i]) % MOD;
    }

    cout << answer << "\n";
    return 0;
}

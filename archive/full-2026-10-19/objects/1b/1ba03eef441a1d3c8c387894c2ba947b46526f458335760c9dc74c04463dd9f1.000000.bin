{
  "src/solution.cpp": "#include <iostream>\n#include <vector>\n#include <algorithm>\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\nusing namespace std;\n\nconst unsigned int MOD = 1000000007;\n\n#if defined(__aarch64__)\nstatic inline uint32x4_t add_mod(uint32x4_t a, uint32x4_t b) {\n    const uint32x4_t modulus = vdupq_n_u32(MOD);\n    const uint32x4_t sum = vaddq_u32(a, b);\n    return vsubq_u32(sum, vandq_u32(vcgeq_u32(sum, modulus), modulus));\n}\n#endif\n\nstatic inline void scan_open_run(unsigned int* dp, int begin, int end) {\n    unsigned int carry = 0;\n    int j = begin;\n#if defined(__aarch64__)\n    const uint32x4_t zero = vdupq_n_u32(0);\n    uint32x4_t carry_vector = zero;\n    for (; j + 3 < end; j += 4) {\n        uint32x4_t values = vld1q_u32(dp + j);\n        values = add_mod(values, vextq_u32(zero, values, 3));\n        values = add_mod(values, vextq_u32(zero, values, 2));\n        values = add_mod(values, carry_vector);\n        vst1q_u32(dp + j, values);\n        carry_vector = vdupq_laneq_u32(values, 3);\n    }\n    carry = vgetq_lane_u32(carry_vector, 0);\n#endif\n    for (; j < end; ++j) {\n        unsigned int value = dp[j] + carry;\n        if (value >= MOD) value -= MOD;\n        dp[j] = carry = value;\n    }\n}\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n    vector<vector<int> > blockedCells(n);\n    for (int c = 0; c < m; ++c) {\n        int i, j;\n        cin >> i >> j;\n        blockedCells[i].push_back(j);\n    }\n    for (auto& row : blockedCells) {\n        sort(row.begin(), row.end());\n        row.erase(unique(row.begin(), row.end()), row.end());\n    }\n\n    vector<unsigned int> dp(n, 0);\n    dp[0] = 1;\n    for (int i = 0; i < n; ++i) {\n        int begin = 0;\n        for (int column : blockedCells[i]) {\n            scan_open_run(dp.data(), begin, column);\n            dp[column] = 0;\n            begin = column + 1;\n        }\n        scan_open_run(dp.data(), begin, n);\n    }\n    cout << dp[n - 1] << endl;\n}\n"
}

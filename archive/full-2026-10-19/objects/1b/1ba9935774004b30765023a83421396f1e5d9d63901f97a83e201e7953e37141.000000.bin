"""Local hash/inventory receipt; never changes sealed components or activation state."""
from __future__ import annotations

import difflib
import hashlib
import json
from pathlib import Path
from xml.etree import ElementTree

HERE = Path(__file__).resolve().parent
PREP = HERE.parents[1]


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def ref(path):
    return {"path": str(path.resolve()), "sha256": sha(path)}


def save(path, value):
    with path.open("x", encoding="utf8", newline="\n") as stream:
        stream.write(json.dumps(value, indent=2, ensure_ascii=False) + "\n")


def count_junit(path):
    suites = ElementTree.parse(path).getroot().iter("testsuite")
    result = {k: 0 for k in ("tests", "failures", "errors", "skipped")}
    for suite in suites:
        for key in result:
            result[key] += int(suite.get(key, 0))
    return result


def main():
    manifest = json.loads((HERE / "COMPONENTS.json").read_text())
    assert all(sha(HERE / name) == digest for name, digest in manifest["code_pins"].items())
    baseline = json.loads((HERE / "BASELINES.json").read_text())
    after = {path: sha(Path(path)) for path in baseline}
    assert baseline == after
    delta = {"schema": "hpc-forest-lane-r2-integration-preservation-v1", "verified": True,
             "scope": "selected immutable predecessor files only; no claim about concurrent unrelated work",
             "baseline": ref(HERE / "BASELINES.json"), "old_files_preserved": len(baseline),
             "inventory_before_after_equal": True, "new_components": len(manifest["code_pins"]),
             "source_modified": False, "live_cache_read": False}
    save(HERE / "DELTA-PRESERVATION.json", delta)
    pairs = [("assemble_admissions.py", PREP / "integration-factory-lecteur-r4-r1/assemble_admissions.py"),
             ("reader_bridge.py", PREP / "integration-factory-lecteur-r4-r1/reader_bridge.py"),
             ("lane_projection.py", HERE.parent / "lane_projection.py"),
             ("reader/receipt_native.py", PREP / "lecture-native-integree-r4/receipt_native.py"),
             ("reader/receive_phase.py", PREP / "lecture-native-integree-r4/receive_phase.py"),
             ("observer/observer-mixte.py", PREP / "observateur-neuf-sessions-r4/observer-mixte.py")]
    diff = []
    for name, old in pairs:
        diff.extend(difflib.unified_diff(old.read_text(encoding="utf8").splitlines(True), (HERE / name).read_text(encoding="utf8").splitlines(True), fromfile=str(old), tofile=name))
    (HERE / "DIFF-INTEGRATION.patch").write_text("".join(diff), encoding="utf8", newline="\n")
    portable, local = [count_junit(HERE / name) for name in ("portable-r2.xml", "local-premier.xml")]
    assert portable == {"tests": 19, "failures": 0, "errors": 0, "skipped": 0}
    assert local == {"tests": 21, "failures": 0, "errors": 0, "skipped": 0}
    package = json.loads((HERE / "PAQUET-PORTABLE.json").read_text())
    assert package["archive"]["sha256"] == sha(Path(package["archive"]["path"]))
    validation = {"schema": "hpc-forest-lane-r2-integration-local-validation-v1", "verified": True,
                  "verification_scope": "pure local invented evidence only, no production admission",
                  "portable_tests": portable, "local_tests": local,
                  "portable_junit": ref(HERE / "portable-r2.xml"), "local_junit": ref(HERE / "local-premier.xml"),
                  "first_refusal_preserved": ref(HERE / "portable-premier.xml"),
                  "ruff_passed": True, "strict_CLI_byte_verifier_stubbed_in_local_nine_paths": False,
                  "factory_reader_observer_source105_pure_imports_verified": True,
                  "native_generation_admitted": False, "first_NORMAL_verified": False, "first_evaluation_verified": False,
                  "model_CLI_RPC_job_CIM_live_cache_lock_transition_stop_calls": 0}
    save(HERE / "VALIDATION-LOCALE.json", validation)
    delivery = {"schema": "hpc-forest-lane-r2-complete-integration-delivery-v1", "verified": False,
                "local_complete_authorization_chain_implemented": True,
                "scope_id": manifest["scope_id"], "source_zip_sha256": manifest["source_zip_sha256"],
                "plan_sha256": manifest["plan_sha256"], "components": ref(HERE / "COMPONENTS.json"),
                "package": package["archive"], "package_file_count": package["file_count"],
                "validation": ref(HERE / "VALIDATION-LOCALE.json"), "preservation": ref(HERE / "DELTA-PRESERVATION.json"),
                "diff": ref(HERE / "DIFF-INTEGRATION.patch"), "guide": ref(HERE / "REPRISE.md"),
                "portable_tests_passed": 19, "local_cold_tests_passed": 21, "ruff_passed": True,
                "real_authorizations_created": False, "actual_source_state_r3_review_bound": False,
                "new_allocated_Q_received": False, "independent_complete_integration_review_received": False,
                "observer_started": False, "native_generation_admitted": False, "activation_admitted": False,
                "first_NORMAL_and_evaluation_verified": False,
                "remaining": ["receive and independently review the exact new zero-model allocated Q", "independent review of all complete integration bytes", "actual reviewed source-state-r3 binding and new full local projection proofs", "actual OBS3 release/OBS4 policy, identity and route admission", "actual exact submission, allocation, OAuth/transport readbacks and current lane facts per cell", "actual first NORMAL native call, then program evaluation before any research extension"]}
    save(HERE / "LIVRAISON-INTEGRATION-LANE-R2-NON-ADMISE.json", delivery)
    print(json.dumps({"delivery": ref(HERE / "LIVRAISON-INTEGRATION-LANE-R2-NON-ADMISE.json"), "preserved": len(baseline), "components": len(manifest["code_pins"])}))


if __name__ == "__main__":
    main()

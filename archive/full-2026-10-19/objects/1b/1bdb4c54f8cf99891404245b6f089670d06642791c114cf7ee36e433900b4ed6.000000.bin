"""Preserve and complete the live editorial ledger after the visual review."""
import hashlib
import json
import re
import shutil
import time
import tomllib
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
STUDY = HERE.parents[1]
ROOT = STUDY.parents[1]
EDITORIAL = STUDY / "edition-professionnelle"
COMPARE = STUDY.parent / "HPC-Forest-Harnais-Comparaison-r1"
AUTOMATION = Path("C:/Users/nicol/.codex/automations/terminer-les-essais-deepseek-sur-romeo/automation.toml")


def read(path):
    return json.loads(path.read_text(encoding="utf-8-sig"))


def sha(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def save(path, obj):
    path.write_text(json.dumps(obj, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def main():
    assert read(EDITORIAL / "controle-qualite.json")["visual_review_completed"]
    backup = HERE / "guides-avant"
    assert not backup.exists(), "Preserve the first guide snapshot."
    backup.mkdir()
    paths = [EDITORIAL / "REPRISE.md", STUDY / "REPRISE-ACTUALISEE.md", ROOT / "ID.md", AUTOMATION]
    paths += [COMPARE / name for name in ["REPRISE.md", "ETAT-ACTUEL.md", "COORDINATION-SOURCE-ONLY.md", "SUIVI-AUTOMATISE-ACTUEL.md", "suivi-a-faire.json", "dernier-arrete-verifie.json", "MANIFEST-LIVRAISON.json"]]
    preserved = {}
    for path in paths:
        if path == AUTOMATION:
            name = "automation.toml"
        elif path == ROOT / "ID.md":
            name = "ID.md"
        else:
            name = path.relative_to(STUDY.parent).as_posix()
        target = backup / name
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, target)
        assert sha(path) == sha(target)
        preserved[name] = {"path": str(path), "sha256": sha(path)}
    save(backup / "PRESERVATION.json", {"verified": True, "files": preserved, "preserved_utc": datetime.now(UTC).isoformat()})

    editorial_head = """# Édition Astra double du 17 octobre : reçue et inspectée

Les deux cohortes closes R1 Astra xhigh / 750205 et source-only Astra MAX / 750122 sont explicitement admises après leurs audits et réconciliations. L’édition précédente 17/228 pages est préservée sous versions/20261017-avant-astra-double-professionnelle/ : 3 992 fichiers copiés et vérifiés, dont les 891 fichiers de son manifeste. Les anciens reçus d’admission préalable restent des instantanés ; leur champ pending n’est pas réécrit. Les nouveaux admission-article-recue.json lient la livraison finale.

L’édition livrée comporte 17 pages / sept figures principales et 259 pages / 224 figures d’annexes. Ses 276 pages ont été rendues et inspectées sur 47 planches ; quinze pages sensibles ont aussi été inspectées en pleine résolution, sans défaut visuel connu. Les 165 registres et 149 résultats sont recalculés ; les 58 racines CPU, 2 315 points et 11 575 temps sont inchangés. Les douze rubriques ID-040 sont couvertes. Les ID-017/040 du PDF conservent l’instantané de construction ; ID.md est complété après la revue visuelle.

Onze cohortes natives closes totalisent 1 417 invocations observées, 31 006 166 jetons exacts connus et 106 invocations non mesurées, plus la requête Terra sans réponse de consommation inconnue. Cache et raisonnement sont inclus dans les totaux. Les six expirations avant invocation des deux nouvelles cohortes restent séparées. Aucun total exact global ni classement causal n’est annoncé. Les négatifs et la violation historique d’arrêt récursif source-only restent documentés ; le coordinateur ancien est interdit de redémarrage.

Lire edition-professionnelle/admission-astra-double-verifiee.json (admission préalable), audit-calculs.json, controle-qualite.json et manifeste-edition.json, puis receptions/admission-astra-double-20261017/REPRISE.md et integrite-apres-edition.json. La chaîne canonique reste actualiser-article.py, construire-pdf.py, controler.py, revue visuelle et nouveau scellement. Aucun résultat CPU nouveau, R5, apprentissage Flash ou résultat natif Codex ajouté ; dépôt public et kit privé inchangés. Ne pas renotifier cette édition après livraison sans nouvelle preuve ou incident.

"""
    operational_head = """# État après admission professionnelle des deux cohortes Astra du 17 octobre

Cet arrêté complète l’édition et remplace les états historiques divergents. Les reçus scientifiques Astra 750205/750122 sont déjà livrés : ne plus les repoller, relancer ou renotifier. L’admission professionnelle est maintenant close : ARTICLE 17 pages / sept figures ; ANNEXES-TECHNIQUES 259 pages / 224 figures. Les 276 pages sont inspectées sur 47 planches et quinze pages sensibles en pleine résolution. Préservation vérifiée de 3 992 fichiers de l’ancienne édition 17/228, dont ses 891 fichiers manifestés. 165 registres / 149 résultats ; CPU inchangé, 11 575 temps. Onze cohortes natives closes : 1 417 invocations, 31 006 166 jetons exacts connus et 106 invocations non mesurées, plus la requête Terra sans réponse inconnue ; pas de total exact global. Lire outputs/HPC-Forest-Etude-2020-2024-r1/receptions/admission-astra-double-20261017/REPRISE.md, integrite-apres-edition.json et edition-professionnelle/manifeste-edition.json. Aucun changement public ou au kit privé.

R1 reste à 26 groupes / 104 cellules reçus, treize groupes non démarrés. Même recherche coverage-gpt-5.6-terra-xhigh / 750909, session bb34f01e2e114cf4a59ae51b02823166 ; relais 56248/4028 créé à 14:00:18 UTC et répartiteur unique coordonner-prochain-r3.py 70032/5660 créé à 13:59:27/28 UTC. Le répartiteur n’admet au plus que ce groupe puis observe, sans réception ni arrêt. Fin attendue awaiting_audited_reception_after_strict_dispatch. Voie R1 réservée entre groupes ; réception stricte/audit natif/réconciliation AVANT arrêt individuel possédé. Ne jamais appeler Coordinator.receive.

Source-only reste à 30/300 issues reçues/auditées, 270 non reçues. Même recherche source-only-gpt-5.6-terra-max / 750831, session 15219a6fd62b4dcb91b395dcd4ae03d5 ; relais inchangé ablation_worker --resume 51504/53396 créé à 13:50:51 UTC ; observateur strict unique 64976/56756 créé à 13:52:23 UTC, verrou comparison-coordinator.lock. Il ne permet que job_status/job_efficiency pour ce job, ne soumet, ne génère, ne reçoit et n’arrête rien. Fin attendue awaiting_audited_source_only_reception_after_strict_observation. Réception MANUELLE stricte des quinze issues, efficacité/archive/trois SHA/restauration neuve/audit natif/cinq confirmations/réconciliation avant arrêt individuel possédé et poursuite isolée de la même file. Ne jamais relancer coordonner-source-only.py --run ni modifier ce script ou le worker vivant.

Ces identités sont des observations datées : vérifier exécutable, commande, création, parents et descendants avant toute intervention ; les observations ultérieures prévalent. Aucun arrêt par nom ni récursif sur PID. Deux workers natifs au maximum, paires lanceur/Python comptées pour un worker. Aucun pilote Codex/R4/R5/Flash ni troisième worker. Codex attend les 300 issues source-only reçues/auditées et sa propre admission ; les 239 tests Windows r7 neutres ne la prouvent pas.

Le préalable humain R5 reste EN ATTENTE : redémarrage externe et 111 outils du profil stdio dont quatorze romeollm_* observés, mais mise à jour contrôlée/préservation, égalité code installé/chargé et tools/list brut du client effectif non prouvés. Checkout MCP sale préservé. Lire outputs/HPC-Forest-R5-Preconditions-r1/observation-apres-redemarrage-20261017T1402.json. Aucune fermeture ou installation pendant une génération non réconciliée ; aucune inférence de diagnostic, poids, apprentissage ou qualification Flash 0731.

Conserver sources, archives, sessions, caches, registres, premiers échecs, checkouts sales et processus étrangers. Aucun rejeu ni réparation algorithmique ; reprise de panne d’interface confirmée seulement, même job/session/cache et claims déjà commencés non régénérés. Aucun commit/push, publication/concours, tiers, nouveau chat, transfert OAuth/API, réglage global, connexion ou facturation. Toute installation/compilation ROMEO sous allocation. Échéance exclusive 31 octobre 2026 23:00 UTC ; nouveau maximum plus trois heures de réception/audit strictement avant, à recontrôler après attente. Le 30 cesser les hypothèses secondaires ; le 31 réserver réception/audit/livraison bornée avec ID incomplets et causes. Poursuivre les quarante ID et garder le suivi actif sans archiver. Silence pendant progression normale ; notifier seulement nouveaux bilans vérifiés, incidents ou décisions, sans répétition des livraisons closes.

Les instructions et arrêtés suivants restent historiques lorsqu’ils diffèrent ; toutes leurs contraintes compatibles et preuves sont conservées.

"""
    for path in [EDITORIAL / "REPRISE.md"]:
        path.write_text(editorial_head + "---\n\n" + path.read_text(encoding="utf-8-sig"), encoding="utf-8")
    for path in [STUDY / "REPRISE-ACTUALISEE.md"] + [COMPARE / name for name in ["REPRISE.md", "ETAT-ACTUEL.md", "COORDINATION-SOURCE-ONLY.md", "SUIVI-AUTOMATISE-ACTUEL.md"]]:
        path.write_text(operational_head + "---\n\n" + path.read_text(encoding="utf-8-sig"), encoding="utf-8")
    id_path = ROOT / "ID.md"
    ledger = id_path.read_text(encoding="utf-8-sig")
    ledger = ledger.replace("État au 16 octobre", "État vérifié au 17 octobre")
    states = {
        "ID-010": "Reprises réelles d’interfaces documentées sans rejeu ; extinction complète du PC non testée et cause basse couche inconnue",
        "ID-016": "165 registres uniques reçus, vrais liens et contrats relus ; 58 racines CPU et 11 575 temps inchangés",
        "ID-017": "Édition professionnelle livrée 17/259 pages, 7/224 figures ; 276 pages inspectées sur 47 planches et quinze pages sensibles en pleine résolution ; ancienne édition de 3 992 fichiers préservée",
        "ID-030": "Onze cohortes natives closes : 1 417 invocations / 31 006 166 jetons exacts connus / 106 invocations non mesurées ; consommation totale inconnue, flux Terra en cours séparés",
        "ID-040": "165 registres / 149 résultats / 11 575 temps CPU ; douze rubriques couvertes, deux cohortes Astra admises, édition 17/259 pages reçue et inspectée",
    }
    lines = ledger.splitlines()
    for index, line in enumerate(lines):
        match = re.match(r"\| (ID-\d{3}) \|", line)
        if match and match[1] in states:
            cells = line.split("|")
            cells[3] = " " + states[match[1]] + " "
            if match[1] in {"ID-017", "ID-040"}:
                cells[5] = " receptions/admission-astra-double-20261017/REPRISE.md ; manifeste-edition.json ; controle-qualite.json "
            lines[index] = "|".join(cells)
    ledger = "\n".join(lines) + "\n"
    ids = re.findall(r"^\| (ID-\d{3}) \|", ledger, re.MULTILINE)
    assert ids == [f"ID-{n:03d}" for n in range(1, 41)]
    id_path.write_text(ledger, encoding="utf-8")
    followup = read(COMPARE / "suivi-a-faire.json")
    # Keep stale earlier scalar snapshots explicitly historical before replacement.
    replaced = ["article", "current_source_only_group", "current_source_only_job", "source_only_session", "source_only_worker_pids", "source_only_coordinator_pids", "existing_r1_current", "existing_native_lanes_latest_observation", "r1_latest_closed_reception", "source_only_latest_closed_reception", "source_only_received_cells", "source_only_unreceived_cells", "source_only_known_exact_received_tokens", "native_calls_scope"]
    followup["historical_fields_before_astra_double_article_delivery"] = {key: followup[key] for key in replaced if key in followup}
    followup.update({
        "article": "Edition professionnelle recue et inspectee : 17/259 pages, 7/224 figures, 276 pages sur 47 planches et quinze risques pleine resolution ; 165 registres/149 resultats ; 11575 temps CPU inchanges. Deux admissions Astra closes. Aucun changement public.",
        "current_source_only_group": "source-only-gpt-5.6-terra-max", "current_source_only_job": "750831", "source_only_session": "15219a6fd62b4dcb91b395dcd4ae03d5",
        "source_only_worker_pids": [51504, 53396], "source_only_coordinator_pids": [64976, 56756],
        "source_only_controller_is_strict_read_only_observer": True,
        "source_only_received_cells": 30, "source_only_unreceived_cells": 270,
        "source_only_known_exact_received_tokens": 5421115,
        "source_only_received_total_consumption_exact": False,
        "source_only_latest_closed_reception": {"path": str(COMPARE / "receptions/source-only-astra-max-750122/reception-verifiee.json"), "sha256": sha(COMPARE / "receptions/source-only-astra-max-750122/reception-verifiee.json")},
        "r1_latest_closed_reception": {"path": str(STUDY / "receptions/coverage-astra-xhigh-750205/reception-verifiee.json"), "sha256": sha(STUDY / "receptions/coverage-astra-xhigh-750205/reception-verifiee.json"), "job_id": "750205", "groups_audited": 26, "cells_admitted": 104, "article_admission_pending": False, "do_not_poll_or_relaunch": True, "do_not_renotify_after_delivery": True},
        "existing_r1_current": {"job_id": "750909", "group": "coverage-gpt-5.6-terra-xhigh", "session_id": "bb34f01e2e114cf4a59ae51b02823166", "worker_pids": [56248, 4028], "coordinator_pids": [70032, 5660], "guide": str(STUDY / "receptions/coverage-astra-xhigh-750205/REPRISE.md"), "dispatcher_does_not_receive_or_stop": True, "expected_terminal_stage": "awaiting_audited_reception_after_strict_dispatch", "received_groups": 26, "received_cells": 104, "remaining_not_started_groups": 13},
        "existing_native_lanes_latest_observation": {"path": str(HERE / "etat-vivant-scellement.json"), "jobs": ["750909", "750831"], "native_workers": 2, "r1_lane_reserved_between_groups": True},
        "native_calls_scope": "Closed received cohorts only; current Terra jobs excluded from exact received accounting.",
        "updated_at": time.time(),
    })
    save(COMPARE / "suivi-a-faire.json", followup)
    automation = tomllib.loads(AUTOMATION.read_text(encoding="utf-8"))
    prompt = operational_head + "---\n\n# Historique conserve avant admission professionnelle Astra\n\n" + automation["prompt"]
    (HERE / "automation-prompt.txt").write_text(prompt, encoding="utf-8")
    save(HERE / "guides-actualises.json", {"verified": True, "verified_utc": datetime.now(UTC).isoformat(), "all_forty_IDs_preserved": True, "updated_IDs": list(states), "article_delivery_pending_seal_only": True, "old_guides_preserved": str(backup), "automation_prompt_prepared_not_yet_applied": True})
    print(json.dumps({"verified": True, "guides_preserved": len(preserved), "all_IDs": len(ids), "automation_prompt_chars": len(prompt)}))


if __name__ == "__main__":
    main()

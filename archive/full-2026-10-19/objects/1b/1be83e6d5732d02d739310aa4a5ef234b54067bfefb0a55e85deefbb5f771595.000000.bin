      "content": "#include \"knn.h\"\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    float *heap_dist = (float *) malloc(sizeof(float) * k);\n    char *heap_label = (char *) malloc(sizeof(char) * k);\n    int hsize = 0;\n    float maxd = 0.0f;\n\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        float px = to_evaluate.x;\n        float py = to_evaluate.y;\n\n        for (int j = 0; j < g.length; j++) {\n            float dx = g.xs[j] - px;\n            float dy = g.ys[j] - py;\n\n            if (hsize < k) {\n                float d = dx * dx + dy * dy;\n                int pos = hsize++;\n                heap_dist[pos] = d;\n                heap_label[pos] = g.label;\n\n                while (pos > 0) {\n                    int parent = (pos - 1) >> 1;\n                    if (heap_dist[parent] < heap_dist[pos]) {\n                        float td = heap_dist[parent];\n                        heap_dist[parent] = heap_dist[pos];\n                        heap_dist[pos] = td;\n\n                        char tl = heap_label[parent];\n                        heap_label[parent] = heap_label[pos];\n                        heap_label[pos] = tl;\n\n                        pos = parent;\n                    } else {\n                        break;\n                    }\n                }\n\n                if (hsize == k) {\n                    maxd = heap_dist[0];\n                }\n            } else {\n                float dx2 = dx * dx;\n                if (dx2 >= maxd) {\n                    continue;\n                }\n\n                float d = dx2 + dy * dy;\n                if (d < maxd) {\n                    heap_dist[0] = d;\n                    heap_label[0] = g.label;\n\n                    int pos = 0;\n                    while (1) {\n                        int left = (pos << 1) + 1;\n                        int right = left + 1;\n                        int largest = pos;\n\n                        if (left < hsize && heap_dist[left] > heap_dist[largest]) {\n                            largest = left;\n                        }\n                        if (right < hsize && heap_dist[right] > heap_dist[largest]) {\n                            largest = right;\n                        }\n\n                        if (largest != pos) {\n                            float td = heap_dist[pos];\n                            heap_dist[pos] = heap_dist[largest];\n                            heap_dist[largest] = td;\n\n                            char tl = heap_label[pos];\n                            heap_label[pos] = heap_label[largest];\n                            heap_label[largest] = tl;\n\n                            pos = largest;\n                        } else {\n                            break;\n                        }\n                    }\n\n                    maxd = heap_dist[0];\n                }\n            }\n        }\n    }\n\n    int freq[256] = {0};\n    for (int i = 0; i < hsize; i++) {\n        freq[(unsigned char)heap_label[i]]++;\n    }\n\n    // The original implementation initializes all k slots with label -1.\n    // If fewer than k points were seen, those missing slots still participate\n    // in the frequency count and tie-breaking.\n    if (hsize < k) {\n        freq[255] += k - hsize;\n    }\n\n    char best = 0;\n    int best_count = -1;\n    for (int c = -128; c <= 127; c++) {\n        unsigned char idx = (unsigned char)c;\n        if (freq[idx] > best_count) {\n            best_count = freq[idx];\n            best = (char)c;\n        }\n    }\n\n    free(heap_dist);\n    free(heap_label);\n    return best;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    },
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    float *xs;\n    float *ys;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.xs = (float *) malloc(sizeof(float) * length);\n    group.ys = (float *) malloc(sizeof(float) * length);\n\n    for (int i = 0; i < length; i++) {\n        Point p = parse_point();\n        group.xs[i] = p.x;\n        group.ys[i] = p.y;\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}\n",
      "path": "src/knn.h"
    }
  ],
  "hypothesis": "Changing each group's point storage from an array of Point structs (AoS) to separate contiguous arrays for x and y coordinates (SoA) improves memory locality and enables better vectorization during the distance scan, while preserving exact iteration order and tie-breaking semantics.",
  "notes": "The Group structure now holds two float arrays instead of a single Point array. Parsing fills both arrays in the same point order, so the heap insertion sequence is unchanged. The knn loop accesses xs[j] and ys[j] directly, maintaining identical floating-point operations and output bytes.",

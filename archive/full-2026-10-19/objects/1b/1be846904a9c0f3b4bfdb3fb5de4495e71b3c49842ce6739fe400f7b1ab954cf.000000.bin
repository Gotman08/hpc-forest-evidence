{"files":[{"content":"#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cstring>\n#include <cstdint>\n\nusing namespace std;\n\nconst uint32_t MOD = 1000000007;\nusing Vec = uint32_t __attribute__((vector_size(16)));\n\nstatic inline Vec reduce(Vec x) {\n    const Vec modulus = {MOD, MOD, MOD, MOD};\n    return x - ((x >= modulus) & modulus);\n}\n\nstatic inline Vec prefix(Vec x) {\n    const Vec zero = {0, 0, 0, 0};\n    const Vec shift_one = {4, 0, 1, 2};\n    const Vec shift_two = {4, 4, 0, 1};\n    x = reduce(x + __builtin_shuffle(x, zero, shift_one));\n    return reduce(x + __builtin_shuffle(x, zero, shift_two));\n}\n\nstatic inline void open_run(vector<uint32_t>& dp, int begin, int end,\n                            uint32_t& carry) {\n    int j = begin;\n    const Vec last = {3, 3, 3, 3};\n    Vec incoming = {carry, carry, carry, carry};\n    for (; end - j >= 8; j += 8) {\n        Vec x, y;\n        memcpy(&x, dp.data() + j, sizeof(x));\n        memcpy(&y, dp.data() + j + 4, sizeof(y));\n        x = prefix(x);\n        y = prefix(y);\n        x = reduce(x + incoming);\n        y = reduce(y + __builtin_shuffle(x, last));\n        memcpy(dp.data() + j, &x, sizeof(x));\n        memcpy(dp.data() + j + 4, &y, sizeof(y));\n        incoming = __builtin_shuffle(y, last);\n    }\n    if (end - j >= 4) {\n        Vec x;\n        memcpy(&x, dp.data() + j, sizeof(x));\n        x = reduce(prefix(x) + incoming);\n        memcpy(dp.data() + j, &x, sizeof(x));\n        incoming = __builtin_shuffle(x, last);\n        j += 4;\n    }\n    carry = incoming[0];\n    for (; j < end; ++j) {\n        uint32_t value = dp[j] + carry;\n        if (value >= MOD) value -= MOD;\n        dp[j] = value;\n        carry = value;\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n    vector<vector<int>> blocked(n);\n    for (int c = 0; c < m; ++c) {\n        int i, j;\n        cin >> i >> j;\n        blocked[i].push_back(j);\n    }\n\n    vector<uint32_t> dp(n, 0);\n    dp[0] = 1;\n    for (int i = 0; i < n; ++i) {\n        auto& cells = blocked[i];\n        sort(cells.begin(), cells.end());\n        cells.erase(unique(cells.begin(), cells.end()), cells.end());\n        uint32_t carry = 0;\n        int begin = 0;\n        for (int column : cells) {\n            open_run(dp, begin, column, carry);\n            dp[column] = 0;\n            carry = 0;\n            begin = column + 1;\n        }\n        open_run(dp, begin, n, carry);\n    }\n    cout << dp[n - 1] << '\\n';\n}\n","path":"src/solution.cpp"}],"hypothesis":"Processing two independent four-lane prefix scans per iteration and retaining the carry in SIMD registers reduces scalar/vector transfers and exposes instruction-level parallelism on ARM64.","notes":"Every vector addition combines two reduced residues, so one conditional subtraction suffices without overflow. Obstacle boundaries and scalar tails remain exact. Not executed or measured.","research":{"queries":[],"urls":[]},"sources_kept":[],"transformations":["Unroll unobstructed runs to eight cells using two independent four-lane modular prefix scans.","Propagate carry with vector shuffles, extracting a scalar only for the final tail."]}
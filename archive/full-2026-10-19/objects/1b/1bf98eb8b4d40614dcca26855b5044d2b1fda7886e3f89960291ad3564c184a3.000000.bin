            parts = line.split("|"); parts[3] = " Source-only Luna MAX reçu/admis ; 3 279 fichiers précédents préservés ; 17/213 pages, 230 pages inspectées sur 39 planches et dix pages en pleine résolution ; 122 registres/106 résultats recalculés. "; lines[i] = "|".join(parts)
        if line.startswith("| ID-040 |"):
            parts = line.split("|"); parts[3] = " Édition scientifique contrôlée : 122 registres, 106 résultats, 188 figures ; 11 575 temps CPU inchangés ; douze rubriques de provenance et limites ; 230 pages inspectées, aucun défaut connu. "; lines[i] = "|".join(parts)
    lines += ["", "Clôture de revue du 17 octobre : les 230 pages de l’édition source-only Luna MAX (17/213) ont été inspectées sur 39 planches, avec dix pages à risque en pleine résolution. Les ID-017/040 vivants sont complétés ; le tableau des PDF reste l’instantané explicite de construction. 15/300 issues source-only reçues ; Astra MAX 750122 et R1 Luna xhigh 749940 restent en cours, sans troisième worker."]
    id_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    save(HERE / "guides-actualises.json", {"verified": True, "updated_utc": now, "previous_guides": str(snapshot), "prompt_sha256": sha(COMPARE / "SUIVI-AUTOMATISE-ACTUEL.md"), "quality_sha256": sha(EDITORIAL / "controle-qualite.json"), "automation_update_pending": True})
    print(json.dumps({"verified": True, "pages_reviewed": 230, "prompt_characters": len(prompt), "guides_preserved": len(targets)}))


if __name__ == "__main__":
    main()

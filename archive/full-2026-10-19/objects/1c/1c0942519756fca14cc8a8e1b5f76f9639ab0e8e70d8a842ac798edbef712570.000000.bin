        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <assert.h>\n#include <string.h>\n\ntypedef struct {\n\tlong int start;\n\tlong int total;\n} bucket;\n\nvoid sort(char *a, bucket *b, long int *indices, long int *scratch, int length) {\n\tlong int count = b->total;\n\tlong int start = b->start;\n\tlong int *src = indices;\n\tlong int *dst = scratch;\n\tint pos;\n\n\tif (count < 2 || length <= 1)\n\t\treturn;\n\n\t/* Stable least-significant-byte passes preserve strcmp ordering. */\n\tfor (pos = length - 1; pos > 0; pos--) {\n\t\tsize_t counts[256] = {0};\n\t\tsize_t next[256];\n\t\tsize_t prefix = 0;\n\t\tlong int j;\n\t\tint c;\n\n\t\tfor (j = 0; j < count; j++) {\n\t\t\tunsigned char key = (unsigned char)a[src[start + j] * length + pos];\n\t\t\tcounts[key]++;\n\t\t}\n\n\t\tfor (c = 0; c < 256; c++) {\n\t\t\tnext[c] = prefix;\n\t\t\tprefix += counts[c];\n\t\t}\n\n\t\tfor (j = 0; j < count; j++) {\n\t\t\tunsigned char key = (unsigned char)a[src[start + j] * length + pos];\n\t\t\tdst[start + next[key]++] = src[start + j];\n\t\t}\n\n\t\t{\n\t\t\tlong int *tmp = src;\n\t\t\tsrc = dst;\n\t\t\tdst = tmp;\n\t\t}\n\t}\n\n\tif (src != indices)\n\t\tmemcpy(indices + start, src + start, sizeof(*indices) * (size_t)count);\n}\n\nlong int* bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\n\tlong int i;\n\tlong int *returns;\n\tlong int *scratch;\n\tlong int *cursor;\n\tbucket *buckets;\n\tlong int prefix = 0;\n\n\tif (size <= 0 || nbuckets <= 0)\n\t\treturn NULL;\n\n\treturns = (long int *)malloc(sizeof(long int) * (size_t)size);\n\tscratch = (long int *)malloc(sizeof(long int) * (size_t)size);\n\tbuckets = (bucket *)calloc((size_t)nbuckets, sizeof(bucket));\n\tcursor = (long int *)malloc(sizeof(long int) * (size_t)nbuckets);\n\n\t/* Count each bucket first, then assign compact contiguous index ranges. */\n\tfor (i = 0; i < size; i++) {\n\t\tint which = *(a + i * length) - offset;\n\t\tbuckets[which].total++;\n\t}\n\n\tfor (i = 0; i < nbuckets; i++) {\n\t\tbuckets[i].start = prefix;\n\t\tcursor[i] = prefix;\n\t\tprefix += buckets[i].total;\n\t}\n\n\tfor (i = 0; i < size; i++) {\n\t\tint which = *(a + i * length) - offset;\n\t\treturns[cursor[which]++] = i;\n\t}\n\n\tfor (i = 0; i < nbuckets; i++)\n\t\tsort(a, &buckets[i], returns, scratch, length);\n\n\tfree(cursor);\n\tfree(buckets);\n\tfree(scratch);\n\treturn returns;\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb){\n   char *strings = NULL;\n   int      len,\n            offset,\n            nbucket;\n   long int n;\n\n   if (!fscanf(stdin, \"%d\", &len)) {\n      printf (\"ERROR len\\n\");\n      exit (1);\n   }\n\n   if (!fscanf(stdin, \"%ld\", &n)) {\n      printf (\"ERROR n\\n\");\n      exit (1);\n   }\n\n   if (!fscanf(stdin, \"%d\", &offset)) {\n      printf (\"ERROR offset\\n\");\n      exit (1);\n   }\n\n   if (!fscanf(stdin, \"%d\", &nbucket)) {\n      printf (\"ERROR nbucket\\n\");\n      exit (1);\n   }\n\n   nbucket = nbucket + 1;\n   len = len + 1;\n\n   strings = (char*) calloc((size_t)n, (size_t)len);\n\n   for (long int i = 0; i < n; i++){\n      if (!fscanf(stdin, \"%s\", strings + (i * len))) {\n      printf (\"ERROR %ld\\n\", i);\n      exit (1);\n      }\n   }\n\n   *vString = strings;\n   *N = n;\n   *l = len;\n   *os = offset;\n   *nb = nbucket;\n}\n\nvoid print(char *strings, long int *index, long int n, int len){\n\n   for (long int i = 0; i < n; i++) {\n      printf(\"%ld -> %s\\n\", i, strings + (index[i] * len));\n   }\n}\n\nvoid save(char *strings, long int *index, long int n, int len){\n   for (long int i = 0; i < n; i++){\n      printf(\"%s\\n\", strings + (index[i] * len));\n   }\n}\n\nint main(int ac, char **av) {\n\n   char     *strings = NULL;\n   long int N        = 0;\n   long int *index   = NULL;\n   int      len      = 0,\n            save2File = 0,\n            offset,\n            nbuckets;\n\n   load(&strings, &N, &len, &offset, &nbuckets);\n\n   index = bucket_sort(strings, len, N, offset, nbuckets);\n\n   save(strings, index, N, len);\n\n   if (strings != NULL)\n      free(strings);\n\n   if (index != NULL)\n      free(index);\n\n   return EXIT_SUCCESS;\n}\n",

{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdint.h>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n#define SOURCE_BLOCK 128\n#define PAIR_TILE 32\n#define PAIR_CACHE_BYTES (64u * 1024u * 1024u)\n#define PAIR_CACHE_ALIGNMENT 128u\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n#if defined(__GNUC__) && !defined(__clang__)\n#pragma GCC push_options\n#pragma GCC optimize (\"no-math-errno\")\n#endif\n\n/* Original single-step interface, also used on allocation failure. */\nvoid body_force(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\nstatic inline float inverse_cube(float dx, float dy, float dz) {\n  float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n  float inv_dist = 1 / sqrt(sqrd_dist);\n  return inv_dist * inv_dist * inv_dist;\n}\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n/* Match the reference's double sqrt/division and subsequent float rounding. */\nstatic inline __attribute__((always_inline))\nfloat32x4_t reference_inv_dist4(float32x4_t distance) {\n  const float64x2_t one = vdupq_n_f64(1.0);\n  float64x2_t low = vcvt_f64_f32(vget_low_f32(distance));\n  float64x2_t high = vcvt_f64_f32(vget_high_f32(distance));\n  low = vdivq_f64(one, vsqrtq_f64(low));\n  high = vdivq_f64(one, vsqrtq_f64(high));\n  return vcombine_f32(vcvt_f32_f64(low), vcvt_f32_f64(high));\n}\n\nstatic inline __attribute__((always_inline))\nfloat32x4_t inverse_cube4(float32x4_t distance) {\n  float32x4_t inv_dist = reference_inv_dist4(distance);\n  return inv_dist * inv_dist * inv_dist;\n}\n\nstatic inline __attribute__((always_inline))\nfloat32x4_t squared_distance4(const float *x, const float *y,\n                             const float *z, int j,\n                             float32x4_t xi, float32x4_t yi,\n                             float32x4_t zi) {\n  float32x4_t dx = vld1q_f32(x + j) - xi;\n  float32x4_t dy = vld1q_f32(y + j) - yi;\n  float32x4_t dz = vld1q_f32(z + j) - zi;\n  return dx*dx + dy*dy + dz*dz + vdupq_n_f32(SOFTENING);\n}\n#endif\n\n/* Each work item owns one upper-triangular tile and its transpose. */\nstatic inline void fill_coefficient_tile(const float *x, const float *y,\n                                         const float *z, float *coefficients,\n                                         size_t coefficient_stride,\n                                         int n, int nblocks, size_t tile) {\n  int lo = 0;\n  int hi = nblocks;\n  while (lo + 1 < hi) {\n    int mid = lo + (hi - lo) / 2;\n    size_t base = (size_t)mid *\n                  (2u * (size_t)nblocks - (size_t)mid + 1u) / 2u;\n    if (base <= tile)\n      lo = mid;\n    else\n      hi = mid;\n  }\n\n  size_t base = (size_t)lo *\n                (2u * (size_t)nblocks - (size_t)lo + 1u) / 2u;\n  int block_i = lo;\n  int block_j = lo + (int)(tile - base);\n  int i_begin = block_i * PAIR_TILE;\n  int j_begin = block_j * PAIR_TILE;\n  int i_end = n - i_begin < PAIR_TILE ? n : i_begin + PAIR_TILE;\n  int j_end = n - j_begin < PAIR_TILE ? n : j_begin + PAIR_TILE;\n\n  for (int i = i_begin; i < i_end; ++i) {\n    const float xi = x[i];\n    const float yi = y[i];\n    const float zi = z[i];\n    float *row = coefficients + (size_t)i * coefficient_stride;\n    int first_j = block_i == block_j ? i : j_begin;\n    int j = first_j;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const float32x4_t xi4 = vdupq_n_f32(xi);\n    const float32x4_t yi4 = vdupq_n_f32(yi);\n    const float32x4_t zi4 = vdupq_n_f32(zi);\n\n    /* Three independent source vectors expose sqrt/division overlap. */\n    for (; j_end - j >= 12; j += 12) {\n      float32x4_t d0 = squared_distance4(x, y, z, j, xi4, yi4, zi4);\n      float32x4_t d1 = squared_distance4(x, y, z, j + 4, xi4, yi4, zi4);\n      float32x4_t d2 = squared_distance4(x, y, z, j + 8, xi4, yi4, zi4);\n      float32x4_t c0 = inverse_cube4(d0);\n      float32x4_t c1 = inverse_cube4(d1);\n      float32x4_t c2 = inverse_cube4(d2);\n      vst1q_f32(row + j, c0);\n      vst1q_f32(row + j + 4, c1);\n      vst1q_f32(row + j + 8, c2);\n    }\n    for (; j_end - j >= 4; j += 4) {\n      float32x4_t distance = squared_distance4(x, y, z, j, xi4, yi4, zi4);\n      vst1q_f32(row + j, inverse_cube4(distance));\n    }\n#endif\n\n    for (; j < j_end; ++j) {\n      row[j] = inverse_cube(x[j] - xi, y[j] - yi, z[j] - zi);\n    }\n\n    for (j = first_j; j < j_end; ++j) {\n      if (i != j) {\n        float reverse = row[j];\n        if (isnan(reverse)) {\n          reverse = inverse_cube(xi - x[j], yi - y[j], zi - z[j]);\n        }\n        coefficients[(size_t)j * coefficient_stride + (size_t)i] = reverse;\n      }\n    }\n  }\n}\n\nstatic inline void advance_pair(const Body *src, Body *dst,\n                                const float *x, const float *y, const float *z,\n                                const float *coefficients,\n                                size_t coefficient_stride,\n                                float dt, int n, int pair) {\n  const int i0 = 2 * pair;\n  const int i1 = i0 + 1 < n ? i0 + 1 : i0;\n  const float xi0 = x[i0];\n  const float yi0 = y[i0];\n  const float zi0 = z[i0];\n  const float xi1 = x[i1];\n  const float yi1 = y[i1];\n  const float zi1 = z[i1];\n  float fx0 = 0.0f;\n  float fy0 = 0.0f;\n  float fz0 = 0.0f;\n  float fx1 = 0.0f;\n  float fy1 = 0.0f;\n  float fz1 = 0.0f;\n\n  if (coefficients != NULL) {\n    const float *row0 = coefficients + (size_t)i0 * coefficient_stride;\n    const float *row1 = coefficients + (size_t)i1 * coefficient_stride;\n    for (int jb = 0; jb < n; ) {\n      int count = n - jb;\n      if (count > SOURCE_BLOCK) count = SOURCE_BLOCK;\n      for (int k = 0; k < count; ++k) {\n        const int j = jb + k;\n        const float xj = x[j];\n        const float yj = y[j];\n        const float zj = z[j];\n        float dx0 = xj - xi0;\n        float dy0 = yj - yi0;\n        float dz0 = zj - zi0;\n        float dx1 = xj - xi1;\n        float dy1 = yj - yi1;\n        float dz1 = zj - zi1;\n        float inv_dist30 = row0[j];\n        float inv_dist31 = row1[j];\n        fx0 += dx0 * inv_dist30;\n        fy0 += dy0 * inv_dist30;\n        fz0 += dz0 * inv_dist30;\n        fx1 += dx1 * inv_dist31;\n        fy1 += dy1 * inv_dist31;\n        fz1 += dz1 * inv_dist31;\n      }\n      jb += count;\n    }\n  } else {\n    float dx0[SOURCE_BLOCK];\n    float dy0[SOURCE_BLOCK];\n    float dz0[SOURCE_BLOCK];\n    float inv_dist30[SOURCE_BLOCK];\n    float dx1[SOURCE_BLOCK];\n    float dy1[SOURCE_BLOCK];\n    float dz1[SOURCE_BLOCK];\n    float inv_dist31[SOURCE_BLOCK];\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const float32x4_t xi04 = vdupq_n_f32(xi0);\n    const float32x4_t yi04 = vdupq_n_f32(yi0);\n    const float32x4_t zi04 = vdupq_n_f32(zi0);\n    const float32x4_t xi14 = vdupq_n_f32(xi1);\n    const float32x4_t yi14 = vdupq_n_f32(yi1);\n    const float32x4_t zi14 = vdupq_n_f32(zi1);\n    const float32x4_t softening = vdupq_n_f32(SOFTENING);\n#endif\n\n    for (int jb = 0; jb < n; ) {\n      int count = n - jb;\n      if (count > SOURCE_BLOCK) count = SOURCE_BLOCK;\n      int k = 0;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n      for (; count - k >= 4; k += 4) {\n        float32x4_t xj = vld1q_f32(x + jb + k);\n        float32x4_t yj = vld1q_f32(y + jb + k);\n        float32x4_t zj = vld1q_f32(z + jb + k);\n        float32x4_t ddx0 = xj - xi04;\n        float32x4_t ddy0 = yj - yi04;\n        float32x4_t ddz0 = zj - zi04;\n        float32x4_t ddx1 = xj - xi14;\n        float32x4_t ddy1 = yj - yi14;\n        float32x4_t ddz1 = zj - zi14;\n        float32x4_t d0 = ddx0*ddx0 + ddy0*ddy0 + ddz0*ddz0 + softening;\n        float32x4_t d1 = ddx1*ddx1 + ddy1*ddy1 + ddz1*ddz1 + softening;\n        float32x4_t c0 = inverse_cube4(d0);\n        float32x4_t c1 = inverse_cube4(d1);\n        vst1q_f32(dx0 + k, ddx0);\n        vst1q_f32(dy0 + k, ddy0);\n        vst1q_f32(dz0 + k, ddz0);\n        vst1q_f32(inv_dist30 + k, c0);\n        vst1q_f32(dx1 + k, ddx1);\n        vst1q_f32(dy1 + k, ddy1);\n        vst1q_f32(dz1 + k, ddz1);\n        vst1q_f32(inv_dist31 + k, c1);\n      }\n#endif\n#ifdef _OPENMP\n#pragma omp simd\n#elif defined(__GNUC__)\n#pragma GCC ivdep\n#endif\n      for (int t = k; t < count; ++t) {\n        const float xj = x[jb + t];\n        const float yj = y[jb + t];\n        const float zj = z[jb + t];\n        float ddx0 = xj - xi0;\n        float ddy0 = yj - yi0;\n        float ddz0 = zj - zi0;\n        float ddx1 = xj - xi1;\n        float ddy1 = yj - yi1;\n        float ddz1 = zj - zi1;\n        dx0[t] = ddx0;\n        dy0[t] = ddy0;\n        dz0[t] = ddz0;\n        inv_dist30[t] = inverse_cube(ddx0, ddy0, ddz0);\n        dx1[t] = ddx1;\n        dy1[t] = ddy1;\n        dz1[t] = ddz1;\n        inv_dist31[t] = inverse_cube(ddx1, ddy1, ddz1);\n      }\n\n      /* Keep each target's additions in ascending source order. */\n      for (int t = 0; t < count; ++t) {\n        fx0 += dx0[t] * inv_dist30[t];\n        fy0 += dy0[t] * inv_dist30[t];\n        fz0 += dz0[t] * inv_dist30[t];\n        fx1 += dx1[t] * inv_dist31[t];\n        fy1 += dy1[t] * inv_dist31[t];\n        fz1 += dz1[t] * inv_dist31[t];\n      }\n      jb += count;\n    }\n  }\n\n  float vx0 = src[i0].vx + dt*fx0;\n  float vy0 = src[i0].vy + dt*fy0;\n  float vz0 = src[i0].vz + dt*fz0;\n  dst[i0].vx = vx0;\n  dst[i0].vy = vy0;\n  dst[i0].vz = vz0;\n  dst[i0].x = xi0 + vx0*dt;\n  dst[i0].y = yi0 + vy0*dt;\n  dst[i0].z = zi0 + vz0*dt;\n  if (i1 != i0) {\n    float vx1 = src[i1].vx + dt*fx1;\n    float vy1 = src[i1].vy + dt*fy1;\n    float vz1 = src[i1].vz + dt*fz1;\n    dst[i1].vx = vx1;\n    dst[i1].vy = vy1;\n    dst[i1].vz = vz1;\n    dst[i1].x = xi1 + vx1*dt;\n    dst[i1].y = yi1 + vy1*dt;\n    dst[i1].z = zi1 + vz1*dt;\n  }\n}\n\nstatic void simulate(Body *p, float dt, int n) {\n  if (n <= 0) return;\n\n  const size_t count = (size_t)n;\n  const size_t position_stride = (count + 15u) & ~(size_t)15u;\n  Body *next = (Body *)malloc(count * sizeof(Body));\n  void *position_allocation =\n      malloc(3u * position_stride * sizeof(float) + 63u);\n  if (next == NULL || position_allocation == NULL) {\n    free(next);\n    free(position_allocation);\n    for (int iter = 0; iter < N_ITER; ++iter) {\n      body_force(p, dt, n);\n      for (int i = 0; i < n; ++i) {\n        p[i].x += p[i].vx * dt;\n        p[i].y += p[i].vy * dt;\n        p[i].z += p[i].vz * dt;\n      }\n    }\n    return;\n  }\n\n  float *x = (float *)(((uintptr_t)position_allocation + 63u) &\n                       ~(uintptr_t)63u);\n  float *y = x + position_stride;\n  float *z = y + position_stride;\n  const size_t coefficient_stride =\n      ((count + (size_t)PAIR_TILE - 1u) / (size_t)PAIR_TILE) *\n      (size_t)PAIR_TILE;\n  float *coefficients = NULL;\n  void *coefficient_allocation = NULL;\n  if (coefficient_stride <=\n      ((size_t)PAIR_CACHE_BYTES / sizeof(float)) / count) {\n    size_t bytes = count * coefficient_stride * sizeof(float);\n    coefficient_allocation =\n        malloc(bytes + (size_t)PAIR_CACHE_ALIGNMENT - 1u);\n    if (coefficient_allocation != NULL) {\n      uintptr_t address = (uintptr_t)coefficient_allocation;\n      uintptr_t aligned =\n          (address + (uintptr_t)PAIR_CACHE_ALIGNMENT - 1u) &\n          ~((uintptr_t)PAIR_CACHE_ALIGNMENT - 1u);\n      coefficients = (float *)aligned;\n    }\n  }\n\n  const int nblocks = n / PAIR_TILE + (n % PAIR_TILE != 0);\n  const size_t tile_count =\n      (size_t)nblocks * ((size_t)nblocks + 1u) / 2u;\n  const int target_pairs = n / 2 + n % 2;\n  Body *src = p;\n  Body *dst = next;\n\n#ifdef _OPENMP\n#pragma omp parallel if(n >= 256)\n#endif\n  {\n    for (int iter = 0; iter < N_ITER; ++iter) {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n      for (int i = 0; i < n; ++i) {\n        x[i] = src[i].x;\n        y[i] = src[i].y;\n        z[i] = src[i].z;\n      }\n\n      if (coefficients != NULL) {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n        for (size_t tile = 0; tile < tile_count; ++tile) {\n          fill_coefficient_tile(x, y, z, coefficients, coefficient_stride,\n                                n, nblocks, tile);\n        }\n      }\n\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n      for (int pair = 0; pair < target_pairs; ++pair) {\n        advance_pair(src, dst, x, y, z, coefficients, coefficient_stride,\n                     dt, n, pair);\n      }\n\n#ifdef _OPENMP\n#pragma omp single\n#endif\n      {\n        Body *tmp = src;\n        src = dst;\n        dst = tmp;\n      }\n    }\n  }\n\n  if (src != p) memcpy(p, src, count * sizeof(Body));\n  free(coefficient_allocation);\n  free(position_allocation);\n  free(next);\n}\n\n#if defined(__GNUC__) && !defined(__clang__)\n#pragma GCC pop_options\n#endif\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n  simulate(bodies, DT, nbodies);\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Paired ordered force consumption and three-way-unrolled exact NEON coefficient generation should combine reduced source traffic with symmetric square-root reuse and cache-line isolation.",

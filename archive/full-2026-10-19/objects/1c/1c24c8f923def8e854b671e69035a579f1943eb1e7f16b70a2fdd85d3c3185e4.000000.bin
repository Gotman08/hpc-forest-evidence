e;\\n \\n-// size of each side of the grid\\n int size;\\n int iter_max_num;\\n \\n-// return the absolute value of a number\\n double absolute(double num){\\n     if(num < 0)\\n         return -1.0 * num;\\n     return num;\\n }\\n \\n-\\n-// allocate memory for the grid\\n-void allocate_memory(){\\n-    grid = (double **) malloc(size * sizeof(double *));\\n-    new_grid = (double **) malloc(size * sizeof(double *));\\n-\\n-    for(int i = 0; i < size; i++){\\n-        grid[i] = (double *) malloc(size * sizeof(double));\\n-        new_grid[i] = (double *) malloc(size * sizeof(double));\\n+void allocate_memory(void){\\n+    size_t n = (size_t)size;\\n+    if(n != 0 && n > ((size_t)-1) / sizeof(*grid) / n)\\n+        exit(EXIT_FAILURE);\\n+\\n+    grid = malloc(n * n * sizeof(*grid));\\n+    new_grid = malloc(n * n * sizeof(*new_grid));\\n+    row_cache = malloc(3 * n * sizeof(*row_cache));\\n+    if(n != 0 && (!grid || !new_grid || !row_cache)){\\n+        free(grid);\\n+        free(new_grid);\\n+        free(row_cache);\\n+        exit(EXIT_FAILURE);\\n     }\\n }\\n \\n-// initialize the grid\\n-void initialize_grid(){\\n+void initialize_grid(void){\\n     int center = size / 2;\\n     int linf = center - (size / 10);\\n     int lsup = center + (size / 10);\\n-    for (int i = 0; i < size; i++){\\n-        for (int j = 0; j < size; j++){\\n-            // inicializa região de calor no centro do grid\\n-            if ( i >= linf && i <= lsup && j >= linf && j <= lsup)\\n-                grid[i][j] = 100;\\n-            else\\n-                grid[i][j] = 0;\\n-            new_grid[i][j] = 0.0;\\n+    size_t n = (size_t)size;\\n+\\n+    for(int i = 0; i < size; i++){\\n+        for(int j = 0; j < size; j++){\\n+            double value = 0.0;\\n+            if(i >= linf && i <= lsup && j >= linf && j <= lsup)\\n+                value = 100.0;\\n+            grid[(size_t)i * n + j] = value;\\n+            // Both buffers must retain the original frozen boundaries.\\n+            new_grid[(size_t)i * n + j] = value;\\n         }\\n     }\\n }\\n \\n-// save the grid in a file\\n-void save_grid(){\\n-\\n+void save_grid(void){\\n+    size_t n = (size_t)size;\\n     for(int i = 0; i < size; i++){\\n+        const double *row = grid + (size_t)i * n;\\n         for(int j = 0; j < size; j++){\\n-            fprintf(stdout, \\\"%lf \\\", grid[i][j]);\\n+            fprintf(stdout, \\\"%lf \\\", row[j]);\\n         }\\n         fprintf(stdout, \\\"\\\\n\\\");\\n     }\\n }\\n \\n-int main(int argc, char *argv[]){\\n+static inline int update_row(const double *restrict above,\\n+                             const double *restrict current,\\n+                             const double *restrict below,\\n+                             double *restrict output,\\n+                             int width){\\n+    int changed = 0;\\n+    for(int j = 1; j < width - 1; j++){\\n+        double value = 0.25 * (current[j+1] + current[j-1] +\\n+                              above[j] + below[j]);\\n+        output[j] = value;\\n+        changed |= absolute(value - current[j]) > CONV_THRESHOLD;\\n+    }\\n+    return changed;\\n+}\\n+\\n+static int single_sweep(const double *restrict source,\\n+                        double *restrict destination){\\n+    size_t n = (size_t)size;\\n+    int changed = 0;\\n+    for(int i = 1; i < size - 1; i++){\\n+        size_t offset = (size_t)i * n;\\n+        const double *row = source + offset;\\n+        changed |= update_row(row - n, row, row + n,\\n+                              destination + offset, size);\\n+    }\\n+    return changed;\\n+}\\n+\\n+// Bit zero records first-sweep changes; bit one records second-sweep changes.\\n+// Called only for grids with an interior and at least two remaining sweeps.\\n+static unsigned int two_sweeps(const double *restrict source,\\n+                               double *restrict destination,\\n+                               double *restrict cache){\\n+    size_t n = (size_t)size;\\n+    double *previous = cache;\\n+    double *current = cache + n;\\n+    double *next = cache + 2 * n;\\n+\\n+    // The first intermediate row is the unchanged top boundary.\\n+    for(int j = 0; j < size; j++)\\n+        previous[j] = source[j];\\n+\\n+    const double *first = source + n;\\n+    current[0] = first[0];\\n+    current[size-1] = first[size-1];\\n+    unsigned int changed = (unsigned int)update_row(source, first,\\n+                                                   first + n, current, size);\\n+\\n+    for(int i = 1; i < size - 2; i++){\\n+        const double *row = source + (size_t)(i + 1) * n;\\n+        next[0] = row[0];\\n+        next[size-1] = row[size-1];\\n+\\n+        // Produce the next intermediate row, then immediately consume it.\\n+        changed |= (unsigned int)update_row(row - n, row, row + n,\\n+                                            next, size);\\n+        changed |= (unsigned int)update_row(previous, current, next,\\n+                                            destination + (size_t)i * n,\\n+                                            size) << 1;\\n+\\n+        double *old_previous = previous;\\n+        previous = current;\\n+        current = next;\\n+        next = old_previous;\\n+    }\\n+\\n+    // The final intermediate neighbor is the unchanged bottom boundary.\\n+    changed |= (unsigned int)update_row(previous, current,\\n+                                        source + (n - \"}, {\"id\": \"046b148c5c9640a0\", \"role\": \"A\", \"commit\": \"55e44f21b06b3281478b850e35564c49d0e9b78c\", \"transformations\": {\"files\": [\"src/laplace_seq.c\"], \"retained\": [\"Replace separately allocated rows with two contiguous buffers and use local row pointers.\", \"Initialize both buffers identically to preserve frozen boundaries when swapping.\", \"Replace the interior copy sweep with a buffer-pointer swap after each completed iteration.\"]}, \"mean_seconds\": 0.0602831831201911, \"diff\": \"diff --git a/src/l
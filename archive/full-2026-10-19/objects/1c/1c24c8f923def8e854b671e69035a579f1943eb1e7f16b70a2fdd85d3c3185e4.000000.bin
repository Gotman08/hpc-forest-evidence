@ void initialize_grid(){\\n void save_grid(){\\n \\n     for(int i = 0; i < size; i++){\\n+        const double *row = grid + (size_t)i * (size_t)size;\\n         for(int j = 0; j < size; j++){\\n-            fprintf(stdout, \\\"%lf \\\", grid[i][j]);\\n+            fprintf(stdout, \\\"%lf \\\", row[j]);\\n         }\\n         fprintf(stdout, \\\"\\\\n\\\");\\n     }\\n@@ -97,23 +97,25 @@ int main(int argc, char *argv[]){\\n         hasError = 0;\\n         // calculates the Laplace equation to determine each cell's next value\\n         for( int i = 1; i < size-1; i++) {\\n+            const double *row = grid + (size_t)i * (size_t)size;\\n+            const double *north = row - size;\\n+            const double *south = row + size;\\n+            double *next = new_grid + (size_t)i * (size_t)size;\\n             for(int j = 1; j < size-1; j++) {\\n \\n-                new_grid[i][j] = 0.25 * (grid[i][j+1] + grid[i][j-1] +\\n-                                         grid[i-1][j] + grid[i+1][j]);\\n+                next[j] = 0.25 * (row[j+1] + row[j-1] +\\n+                                   north[j] + south[j]);\\n \\n-                double errorCurrent = absolute(new_grid[i][j] - grid[i][j]);\\n+                double errorCurrent = absolute(next[j] - row[j]);\\n                 if(errorCurrent > CONV_THRESHOLD ){\\n-                    hasError = 1;                                        \\n-                }     \\n+                    hasError = 1;\\n+                }\\n             }\\n-        }            \\n-        // copie the next values into the working array for the next iteration\\n-        for( int i = 1; i < size-1; i++) {\\n-            for( int j = 1; j < size-1; j++) {\\n-                grid[i][j] = new_grid[i][j];\\n-            }\\n-        }        \\n+        }\\n+        // Make the completed sweep current without copying its interior.\\n+        double *old_grid = grid;\\n+        grid = new_grid;\\n+        new_grid = old_grid;\\n         iter++;\\n     }\"}, {\"id\": \"caec810f8c8147d9\", \"role\": \"B\", \"commit\": \"56fd8d7b58b95bed1d4159fd07a4aa049ae6f438\", \"transformations\": {\"files\": [\"src/laplace_seq.c\"], \"retained\": [\"Reuse horizontal neighbor vectors and reconstruct current-cell vectors with vextq_f64 instead of reloading overlapping data.\", \"Process eight interior cells per unrolled group using four independent integer error accumulators, combined after the sweep.\", \"Preserve the original floating-point addition order and exact convergence comparison.\"]}, \"mean_seconds\": 0.06318315646300714, \"diff\": \"diff --git a/src/laplace_seq.c b/src/laplace_seq.c\\nindex 439dbbb..41279d5 100644\\n--- a/src/laplace_seq.c\\n+++ b/src/laplace_seq.c\\n@@ -8,6 +8,10 @@\\n #include <time.h>\\n #include <sys/time.h>\\n \\n+#if defined(__aarch64__)\\n+#include <arm_neon.h>\\n+#endif\\n+\\n #define CONV_THRESHOLD 1.0e-5f // threshold of convergence\\n \\n // matrix to be solved\\n@@ -71,7 +75,7 @@ int main(int argc, char *argv[]){\\n \\n     fscanf(stdin, \\\"%d\\\", &size);\\n     fscanf(stdin, \\\"%d\\\", &iter_max_num);\\n-    \\n+\\n     int hasError = 1;\\n     int iter = 0;\\n \\n@@ -89,31 +93,119 @@ int main(int argc, char *argv[]){\\n     // get the start time\\n     //gettimeofday(&time_start, NULL);\\n \\n+#if defined(__aarch64__)\\n+    const float64x2_t quarter = vdupq_n_f64(0.25);\\n+    const float64x2_t threshold = vdupq_n_f64((double)CONV_THRESHOLD);\\n+#endif\\n+\\n     // Jacobi iteration\\n     // This loop will end if either the maximum change reaches below a set threshold (convergence)\\n     // or a fixed number of maximum iterations have completed\\n     while ( hasError && iter < iter_max_num ) {\\n \\n         hasError = 0;\\n-        // calculates the Laplace equation to determine each cell's next value\\n+#if defined(__aarch64__)\\n+        uint64x2_t vector_errors0 = vdupq_n_u64(0);\\n+        uint64x2_t vector_errors1 = vdupq_n_u64(0);\\n+        uint64x2_t vector_errors2 = vdupq_n_u64(0);\\n+        uint64x2_t vector_errors3 = vdupq_n_u64(0);\\n+#endif\\n+        // Each destination row is disjoint from all source rows.\\n         for( int i = 1; i < size-1; i++) {\\n-            for(int j = 1; j < size-1; j++) {\\n-\\n-                new_grid[i][j] = 0.25 * (grid[i][j+1] + grid[i][j-1] +\\n-                                         grid[i-1][j] + grid[i+1][j]);\\n-\\n-                double errorCurrent = absolute(new_grid[i][j] - grid[i][j]);\\n-                if(errorCurrent > CONV_THRESHOLD ){\\n-                    hasError = 1;                                        \\n-                }     \\n+            const double *restrict row = grid[i];\\n+            const double *restrict above = grid[i-1];\\n+            const double *restrict below = grid[i+1];\\n+            double *restrict next = new_grid[i];\\n+            int j = 1;\\n+\\n+#if defined(__aarch64__)\\n+            // Reuse adjacent horizontal vectors; extraction supplies the old cells.\\n+            float64x2_t left = vld1q_f64(row);\\n+            // Eight interior cells per group, with four independent error chains.\\n+            for(; j < size-8; j += 8) {\\n+                const float64x2_t right0 = vld1q_f64(row + j + 1);\\n+                const float64x2_t right1 = vld1q_f64(row + j + 3);\\n+                const float64x2_t right2 = vld1q_f64(row + j + 5);\\n+                const float64x2_t right3 = vld1q_f64(row + j + 7);\\n+\\n+                float64x2_t sum0 = vaddq_f64(right0, left);\\n+                float64x2_t sum1 = vaddq_f64(right1, right0);\\n+                float64x2_t sum2 = vaddq_f64(right2, right1);\\n+                float64x2_t sum3 = vaddq_f64(right3, right2);\\n+                sum0 = vaddq_f64(sum0, vld1q_f64(above + j));\\n+                sum1 = vaddq_f64(sum1, vld1q_f64(above + j + 2));\\n+                sum2 = vaddq_f64(sum2, vld1q_f64(above + j + 4));\\n+                sum3 = vaddq_f64(sum3, vld1q_f64(above + j + 6));\\n+                sum0 = vaddq_f64(sum0, vld1q_f64(below + j));\\n+                sum1 = vaddq_f64(sum1, vld1q_f64(below + j + 2));\\n+                sum2 = vaddq_f64(sum2, vld1q_f64(below + j + 4));\\n+                sum3 = vaddq_f64(sum3, vld1q_f64(below + j + 6));\\n+\\n+                const float64x2_t value0 = vmulq_f64(quarter, sum0);\\n+                const float64x2_t value1 = vmulq_f64(quarter, sum1);\\n+                const float64x2_t value2 = vmulq_f64(quarter, sum2);\\n+                const float64x2_t value3 = vmulq_f64(quarter, sum3);\\n+                vst1q_f64(next + j, value0);\\n+                vst1q_f64(next + j + 2, value1);\\n+                vst1q_f64(next + j + 4, value2);\\n+                vst1q_f64(next + j + 6, value3);\\n+\\n+                const float64x2_t error0 = vabsq_f64(vsubq_f64(\\n+                    value0, vextq_f64(left, right0, 1)));\\n+                const float64x2_t error1 = vabsq_f64(vsubq_f64(\\n+                    value1, vextq_f64(right0, right1, 1)));\\n+                const float64x2_t error2 = vabsq_f64(vsubq_f64(\\n+                    value2, vextq_f64(right1, right2, 1)));\\n+                const float64x2_t error3 = vabsq_f64(vsubq_f64(\\n+                    value3, vextq_f64(right2, right3, 1)));\\n+                vector_errors0 = vorrq_u64(vector_errors0,\\n+                                            vcgtq_f64(error0, threshold));\\n+                vector_errors1 = vorrq_u64(vector_errors1,\\n+                                            vcgtq_f64(error1, threshold));\\n+                vector_errors2 = vorrq_u64(vector_errors2,\\n+                                            vcgtq_f64(error2, threshold));\\n+                vector_errors3 = vorrq_u64(vector_errors3,\\n+                                            vcgtq_f64(error3, threshold));\\n+                left = right3;\\n             }\\n-        }            \\n+            // Both lanes are interior cells; all loads stay within their rows.\\n+            for(; j < size-2; j += 2) {\\n+                const float64x2_t right = vld1q_f64(row + j + 1);\\n+                float64x2_t sum = vaddq_f64(right, left);\\n+                sum = vaddq_f64(sum, vld1q_f64(above + j));\\n+                sum = vaddq_f64(sum, vld1q_f64(below + j));\\n+                const float64x2_t value = vmulq_f64(quarter, sum);\\n+                vst1q_f64(next + j, value);\\n+\\n+                const float64x2_t error = vabsq_f64(vsubq_f64(\\n+                    value, vextq_f64(left, right, 1)));\\n+                vector_errors0 = vorrq_u64(vector_errors0,\\n+                                            vcgtq_f64(error, threshold));\\n+                left = right;\\n+            }\\n+#endif\\n+            // Scalar remainder, or the complete row on other architectures.\\n+            for(; j < size-1; j++\"}, {\"id\": \"8bbd52fa0ee24642\", \"role\": \"B\", \"commit\": \"789ef0276312c84d10a3de4642d49b16a1ca09a2\", \"transformations\": {\"files\": [\"src/laplace_seq.c\"], \"retained\": [\"Use disjoint restrict-qualified row pointers for stencil inputs and output.\", \"Evaluate pairs of independent cells with AArch64 NEON FP64 operations, preserving the original arithmetic grouping.\", \"OR vector comparison masks across each sweep and combine them with the scalar remainder's convergence predicate.\"]}, \"mean_seconds\": 0.06556959139804046, \"diff\": \"diff --git a/src/laplace_seq.c b/src/laplace_seq.c\\nindex 439dbbb..dbbacbf 100644\\n--- a/src/laplace_seq.c\\n+++ b/src/laplace_seq.c\\n@@ -8,6 +8,10 @@\\n #include <time.h>\\n #include <sys/time.h>\\n \\n+#if defined(__aarch64__)\\n+#include <arm_neon.h>\\n+#endif\\n+\\n #define CONV_THRESHOLD 1.0e-5f // threshold of convergence\\n \\n // matrix to be solved\\n@@ -71,7 +75,7 @@ int main(int argc, char *argv[]){\\n \\n     fscanf(stdin, \\\"%d\\\", &size);\\n     fscanf(stdin, \\\"%d\\\", &iter_max_num);\\n-    \\n+\\n     int hasError = 1;\\n     int iter = 0;\\n \\n@@ -89,31 +93,63 @@ int main(int argc, char *argv[]){\\n     // get the start time\\n     //gettimeofday(&time_start, NULL);\\n \\n+#if defined(__aarch64__)\\n+    const float64x2_t quarter = vdupq_n_f64(0.25);\\n+    const float64x2_t threshold = vdupq_n_f64((double)CONV_THRESHOLD);\\n+#endif\\n+\\n     // Jacobi iteration\\n     // This loop will end if either the maximum change reaches below a set threshold (convergence)\\n     // or a fixed number of maximum iterations have completed\\n     while ( hasError && iter < iter_max_num ) {\\n \\n         hasError = 0;\\n-        // calculates the Laplace equation to determine each cell's next value\\n+#if defined(__aarch64__)\\n+        uint64x2_t vector_errors = vdupq_n_u64(0);\\n+#endif\\n+        // Each destination row is disjoint from all source rows.\\n         for( int i = 1; i < size-1; i++) {\\n-            for(int j = 1; j < size-1; j++) {\\n-\\n-                new_grid[i][j] = 0.25 * (grid[i][j+1] + grid[i][j-1] +\\n-                                         grid[i-1][j] + grid[i+1][j]);\\n-\\n-                double errorCurrent = absolute(new_grid[i][j] - grid[i][j]);\\n-                if(errorCurrent > CONV_THRESHOLD ){\\n-                    hasError = 1;                                        \\n-                }     \\n+            const double *restrict row = grid[i];\\n+            const double *restrict above = grid[i-1];\\n+            const double *restrict below = grid[i+1];\\n+            double *restrict next = new_grid[i];\\n+            int j = 1;\\n+\\n+#if defined(__aarch64__)\\n+            // Both lanes are interior cells; all loads stay within their rows.\\n+            for(; j < size-2; j += 2) {\\n+                float64x2_t sum = vaddq_f64(vld1q_f64(row + j + 1),\\n+                                          vld1q_f64(row + j - 1));\\n+                sum = vaddq_f64(sum, vld1q_f64(above + j));\\n+                sum = vaddq_f64(sum, vld1q_f64(below + j));\\n+                float64x2_t value = vmulq_f64(quarter, sum);\\n+                vst1q_f64(next + j, value);\\n+\\n+                float64x2_t error = vabsq_f64(vsubq_f64(value,\\n+                                                       vld1q_f64(row + j)));\\n+                vector_errors = vorrq_u64(vector_errors,\\n+                                           vcgtq_f64(error, threshold));\\n+            }\\n+#endif\\n+            // Scalar remainder, or the complete row on other architectures.\\n+            for(; j < size-1; j++) {\\n+                next[j] = 0.25 * (row[j+1] + row[j-1] +\\n+                                  above[j] + below[j]);\\n+\\n+                double errorCurrent = absolute(next[j] - row[j]);\\n+                hasError |= (errorCurrent > CONV_THRESHOLD);\\n             }\\n-        }            \\n+        }\\n+#if defined(__aarch64__)\\n+        hasError |= ((vgetq_lane_u64(vector_errors, 0) |\\n+                      vgetq_lane_u64(vector_errors, 1)) != 0);\\n+#endif\\n         // copie the next values into the working array for the next iteration\\n         for( int i = 1; i < size-1; i++) {\\n             for( int j = 1; j < size-1; j++) {\\n                 grid[i][j] = new_grid[i][j];\\n             }\\n-        }        \\n+        }\\n         iter++;\\n     }\"}], \"interactions\": [], \"automatic_observations\": {\"baseline\": {\"experiment_id\": \"baseline-e1\", \"outcome\": {\"binary_sha256\": \"5e45ca6a403640b278c5a9368b4a2e8d78d20717ad46bce5815572bc4d3069ff\", \"cache_key\": \"8ee8b2f053f2a52b478bf08748450c435653ab699bfd49bb5a2534023d2a2838\", \"commit\": \"cbe6129f3f94b0701528a6a91618cad98e8068c4\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6.1-sol-max/results-749415/2021-jacobi/logs/e1/baseline-e1/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6.1-sol-max/results-749415/2021-jacobi/logs/e1/baseline-e1/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6.1-sol-max/results-749415/2021-jacobi/logs/e1/baseline-e1/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6.1-sol-max/results-749415/2021-jacobi/logs/e1/baseline-e1/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6.1-sol-max/results-749415/2021-jacobi/logs/e1/baseline-e1/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6.1-sol-max/results-749415/2021-jacobi/logs/e1/baseline-e1/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.07282407923291127, \"reason\": \"\", \"score\": 0.5, \"status\": \"valid\", \"times\": [0.0729227215051651, 0.07285958901047707, 0.07268992718309164], \"tree_hash\": \"237519e4f7cef010b0000198bf0d80a551a21bcf\"}, \"raw_logs\": [{\"path\": \"logs/e1/baseline-e1/search/attempt-001/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": true, \"cases\": 4}}]}, \"selected_parent\": null, \"selected_base_commit\": \"cbe6129f3f94b0701528a6a91618cad98e8068c4\", \"recent_own_role\": [], \"own_role_history\": [], \"node_development\": {\"attempt\": 1, \"remaining_attempts\": 3, \"previous_attempts\": [], \"confirmation_data_available\": false}}, \"documents_as_data\": [], \"deadline\": 1792197938.4935172, \"generation_deadline\": 1792197938.4935172, \"protocol_id\": \"aa61bc4ebaa37286ebce35f11f12c1e0bd8da63748320fed9b2a040d8d285f61\", \"remaining_tokens\": 589824, \"official_statement_as_data\": \"16th Marathon of Parallel Programming\\nSBAC-PAD & WSCAD – 2021\\nCalebe Bianchini1 and Maur´ıcio Aronne Pillon2\\n1Mackenzie Presbyterian University\\n2Santa Catarina State University\\nRules for Remote Contest\\nFor all problems, read carefully the input and output session. For all problems, a sequen-\\ntial implementation is given, and it is against the output of those implementations that the\\noutput of your programs will be compared to decide if your implementation is correct.\\nYou can modify the program in any way you see ﬁt, except when the problem descrip-\\ntion states otherwise. You must upload a compressed ﬁle (zip) with your source code, the\\nMakeﬁle and an execution script. The script must have the name of the problem. You\\ncan submit as many solutions to a problem as you want. Only the last submission will\\nbe considered. The Makeﬁle must have the rule all, which will be used to compile your\\nsource code. The execution script runs your solution the way you design it – it will be\\ninspected not to corrupt the target machine.\\nThe execution time of your program will be measured running it with time program and\\ntaking the real CPU time given. Each program will be executed at least three times with\\nthe same input and the mean time will be taken into account. The sequential program\\ngiven will be measured the same way. You will earn points in each problem, correspond-\\ning to the division of the sequential time by the time of your program (speedup). The\\nteam with the most points at the end of the marathon will be declared the winner.\\nThis problem set contains 5 problems; pages are numbered from 1 to 9.\\n\\nGeneral Information\\nCompilation\\nYou should use CC or CXX inside your Makeﬁle. Be careful when redeﬁning them!\\nThere is a simple Makeﬁle inside you problem package that you can modify. Example:\\nFLAGS=-O3\\nEXEC=sum\\nCXX=icpc\\nall: $(EXEC)\\n$(EXEC):\\n$(CXX) $(FLAGS) $(EXEC).cpp -c -o $(EXEC).o\\n$(CXX) $(FLAGS) $(EXEC).o -o $(EXEC)\\nEach judge machine has its group of compilers. See them below and choose well when\\nwriting your Makeﬁle. The compiler that is tagged as default is predeﬁned in CC and\\nCXX variables.\\nmachine compiler command\\nhost\\nGCC 10.2.11\\n(default)\\nC = gcc\\nC++ = g++\\nIntel C/C++ Compiler 19.1.3.304 C = icc\\nC++ = icpc\\nMPI\\nIntel MPI Compiler 2019u12\\n(default)\\nC = mpiicc\\nC++ = mpiicpc\\nIntel C/C++ Compiler 19.1.3.304 C = icc\\nC++ = icpc\\nGCC 10.2.11 C = gcc\\nC++ = g++\\ngpu\\nNVidia CUDA 11.2\\n(default)\\nC = nvcc\\nC++ = nvcc\\nGCC 8.3.1 C = gcc\\nC++ = g++\\nSubmitting\\nGeneral information\\nYou must have an execution script that has the same name of the problem. This script runs\\nyour solution the way you design it. There is a simple script inside you problem package\\nthat should be modiﬁed. Example:\\n#!/bin/bash\\n# This script runs a generic Problem A\\n# Using 32 threads and OpenMP\\nexport OMP_NUM_THREADS=32\\nOMP_NUM_THREADS=32 ./sum\\n\\nSubmitting MPI\\nIf you are planning to submit an MPI solution, you should compile usingmpiicc/mpiicpc.\\nThe script must call mpirun/mpiexec with the correct number of processes (max: 4). It\\nmust use a ﬁle called machines that are generated by the auto-judge system - do not\\ncreate it.\\n#!/bin/bash\\n# This script runs a generic Problem A\\n# Using MPI in the entire cluster (4 nodes)\\n# 'machines' file describes the nodes\\nmpirun -np 4 -machinefile machines ./sum\\nComparing times & results\\nIn your personal machine, measure the execution time of your solution using time pro-\\ngram. Add input/output redirection when collecting time. Use diff program to compare\\nthe original and your solution results. Example:\\n$ time -p ./A < original_input.txt > my_output.txt\\nreal 4.94\\nuser 0.08\\nsys 1.56\\n$ diff my_output.txt original_output.txt\\nDo not measure time and do not add input/output redirection when submitting your so-\\nlution - the auto-judge system is prepared to collect your time and compare the results.\\n\\nProblem A\\nGraph Isomorphism Detection\\nProblem deﬁnition\\nGiven two graphs G(V, E) and H(V, E), where V denotes the vertices and E the edges,\\nthe problem of ﬁnding isomorphic graphs consists of determining a bijection function\\nf : V (G)→ V (H) that maps the vertices of both graphs while preserving the adjacency\\ncondition. In other words, for the isomorphism property to exist, if any two vertices\\nu, v ∈ G are adjacent then the corresponding vertices f (u), f(v) ∈ H must also be\\nadjacent. In this sense, the proposed algorithm detects isomorphic undirected graphs\\nthrough extensive permutations, comparing all possible vertex correspondences between\\nG and H.\\nInput\\nAn input represents only a test case. Initially, the graph G is informed followed by H.\\nThe ﬁrst line contains an integerVg (0 < V g < 100) representing the number of vertices in\\nG, while the second line informs an integerEg (0≤ Eg < (Vg∗ (Vg− 1))/2) denoting the\\nnumber of edges in G. Following, Eg edges are sequentially informed, each denoted by\\ntwo integers u, v∈ Vg. The next lines repeat the same rationale for informing the graph\\nH: an integer Vh (0 < V h < 100) representing the number of vertices in H is followed by\\nan integer Eh (0≤ Eh < (Vh∗ (Vh− 1))/2) denoting the number of edges in H. Finally,\\nEh edges are sequentially informed, each denoted by two integers u, v∈ Vh.\\nThe input must be read form the standard input.\\nOutput\\nThe output contains a single line. If G and H are not isomorphic graphs, the message The\\ngraphs are not isomorphicis printed to the output. Otherwise, a stream of integersv∈ Vh\\npresents a vertex correspondence between G and H, such that f (u) = v, with u∈ Vg\\nequal to the position of each v on the stream.\\nThe output must be written to the standard output.\\n1\\n\\nExample\\nInput example Output example\\n4 The graphs are not isomorphic\\n6\\n0 3\\n1 1\\n1 3\\n2 2\\n2 3\\n3 3\\n4\\n6\\n0 0\\n0 1\\n0 2\\n1 1\\n1 3\\n3 3\\n2\\n\\nProblem B\\nDescriptive Statistics Metrics\\nA researcher has a set of samples grouped in matrices, where each column represents a\\nsample. The researcher needs to calculate the following values for each sample (column):\\narithmetic mean, harmonic mean, median, mode, sample variance, standard deviation and\\ncoefﬁcient of variation. Each value can be set as follows:\\n• Arithmetic mean: Sum of all elements in the sample, divided by the sample size\\n(sum of the rows in the matrix column divided by the number of rows).\\n• Harmonic mean: Ratio between the sample size and the sum of the inverse of the\\nsamples.\\n• Median: Average element of the sample (average element of the ordered column).\\nFor an even number of elements, the median is the mean between the elements in\\nthe middle (\\n( n\\n2 + n\\n2+1 )\\n2 ).\\n• Mode: Most frequent number of the sample (the element that most appears in the\\ncolumn; if there is more than one, only the ﬁrst is considered. If not, it returns -1).\\n• Sample Variance: Sum of squares of data deviations from the mean and dividing\\nby the number of items minus one.\\n• Standard deviation: Square root of the variance.\\n• Coefﬁcient of variation:Ratio between standard deviation and arithmetic mean.\\nProblem input\\nThe input has only one test case. The ﬁrst line has the number of rows and columns of the\\nmatrix, separated by a single space. In the following lines are the elements of the matrix\\nof type double, where the lines are separated by a single line break and the columns by a\\nsingle space.\\nThe input must be read form the standard input.\\nProblem output:\\nThe output contains the calculated metrics, respectively. A single space will separate the\\ncalculated values for each column, and there will also be a single space at the end of the\\nline. Each metric starts on a new line, i.e., is separated by a single line break. Printed\\nvalues consider a single decimal place.\\nThe output must be written to the standard output.\\n3\\n\\nExample\\nInput example Output example\\n6 4 12.0 17.0 11.5 13.5\\n9 8 4 5 8.1 12.1 6.6 3.7\\n4 12 20 40 8.5 12.0 10.5 7.5\\n8 8 4 4 8.0 8.0 4.0 -1.0\\n8 12 4 21 110.0 188.4 68.7 217.9\\n33 44 20 1 10.5 13.7 8.3 14.8\\n10 18 17 10 0.9 0.8 0.7 1.1\\n4\\n\\nProblem C\\nSokoban\\nSokoban is a videogame created in 1981 by Hiroyuki Imabayashi.\\nThe board, whose dimension varies according to each stage, is divided into squares which\\ncan be one of the following elements:\\n• Empty square (that may be marked as a target)\\n• Wall\\n• Box\\n• Player\\nTo organize the boxes, the player can move in 4 directions (up, down, left, and right) and\\nalso push the boxes. The player cannot, however, pull boxes. Therefore, if a box is pushed\\nto a corner it can no longer be moved. Moreover, only a single box can be moved at the\\nsame time.\\nThe goal of the game is to solve the puzzle by placing a box over each one of the target\\nsquares. The secondary objective is to solve the puzzle in the least number of movements\\npossible.\\nInput\\nThe input contains a single puzzle stage to be solved. The input follows the format below\\nin which each character represents a square of the board:\\n• Empty squares are represented by spaces\\n• # represents a wall\\n• $ indicates the presence of a box\\n• . is a target square\\n• * is a box over a target square\\n• @ is the player\\n• + is a target square\\nThe input must be read from the standard input.\\nOutput\\nThe output of your program is the sequence of movements made by the player to solve\\nthe puzzle. The output format is the following:\\n• u - up\\n• d - down\\n• l - left\\n• r - right\\n• U - up, pushing a box\\n• D - down, pushing a box\\n• L - left, pushing a box\\n5\\n\\n• R - right, pushing a box\\nThe solution length must be the shortest possible. Since there might be more than one\\npossible solution of the same length for the same input, only the ﬁrst solution ordered by\\nthe movements of the player (considering the order up, down, left, and then right) must\\nbe shown. For instance, if the result of the sequencesdll and lld is the same, then dll\\nis preferred.\\nThe output must be written to the standard output.\\nExample\\nInput Output\\n####### ulULLulDDurrrddlULrruLLrrUruLLLulD\\n# #\\n# #\\n#. # #\\n#. $$ #\\n#.$$ #\\n#.# @#\\n#######\\n6\\n\\nProblem D\\nJohnson’s Algorithm for SSSP\\nLet G = ( V ; E; w) a weighted directed graph with non-negative weights, where V =\\nv1, v2, . . . , vn denote the vertices, E = e1, e2, . . . , em denotes the edges and w denotes the\\nweight function w : E− →R which connects the different vertices in the graph with only\\npositive integer. The problem of single-source shortest paths (SSSP) consists of ﬁnding\\nthe shortest paths from a source vertex v∈ V to all other vertices in V .\\nDijkstra’s algorithm can solve the SSSP problem, however when the number of edges is\\nmuch less than the possible number of edges or mathematically |E|≪ V 2, Johnson’s\\nalgorithm obtains better results. Johnson’s Algorithm updates a heap structure while the\\nnumber of visited vertices is increased, this technique is known as “reweighting”. With\\nnon-negative weights the Jhonson algorithm is solve in three steps:\\n1. Add a new node x to the graph and connect this node with zero-weight edges to\\nall other nodes.\\n2. The edges of the original graph are reweighted, i.e. the weight function is updated.\\nFor each edge (u, v), assign the new weight as “original weight + h[u] – h[v]”.\\n3. Finally, x is removed, and Dijkstra’s algorithm is used to ﬁnd the shortest paths\\nfrom the node v = 0 to other vertices in the reweighted graph.\\nInput\\nThe input has only one test case. The input has tree lines: ﬁrst line is the number of\\nvertices, second is the number of edges and the third is the mean Single-Source Shortest\\nPaths using the vertex 0 as source for all the executions. The edges between the vertices\\nare created using random functions with range 1≤ E≤ 10 or [1, 10]. The seed of the\\nrandom number generator is set to generate reproducible cases for the same case size.\\nThe input must be read from the standard input.\\nOutput\\nThe output a message with a single ﬂoat number. The ﬂoat number is the mean of the\\nSingle-Source Shortest Paths using the vertex 0 as source.\\nThe output must be written to the standard output.\\nExample\\nInput Output\\n20 Mean SSSP = 4.9000\\n100\\n4.9000\\n7\\n\\nProblem E\\nJacobi Iterative Method that Solves the\\nLaplace Equation\\nThe code implements a Jacobi iterative method that solves the Laplace equation for heat\\ntransfer. The Jacobi iterative method is a means for iteratively calculating the solution to a\\ndifferential equation by continuously reﬁning the solution until the answer has converged\\nupon a stable solution or some ﬁxed number of steps have completed and the answer is\\neither deemed good enough or unconverged. The example code represents a 2D plane\\nof material that has been divided into a grid of equally sized cells. As heat is applied\\nto the center of this plane, the Laplace equation dictates how the heat will transfer from\\ngrid point to grid point over time. To calculate the temperature of a given grid point\\nfor the next time iteration, one simply calculates the average of the temperatures of the\\nneighboring grid points from the current iteration. Once the next value for each grid point\\nis calculated, those values become the current temperature and the calculation continues.\\nAt each step the maximum temperature change across all grid points will determine if the\\nproblem has converged upon a steady state.\\nThe Figure E.1 below shows the result of applying the algorithm on a surface represented\\nby a 512 x 512 matrix with 10000 steps.\\nInput\\nThe input consist of two values: the size of the square matrix that will be generated; and\\nthe maximum number of steps.\\nThe input must be read from the standard input.\\nOutput\\nThe output is a matrix that represents heat transferred from one point on the grid to another\\nover time.\\nThe output must be written to the standard output.\\n8\\n\\nFigure E.1. 512 x 512 heated surface.\\nExample\\nInput Output\\n7 100 0.000000 0.000000 0.000000 0.000000 0.000000\\n0.000000 0.000000\\n0.000000 0.000003 0.000000 0.000006 0.000000\\n0.000003 0.000000\\n0.000000 0.000000 0.000009 0.000000 0.000009\\n0.000000 0.000000\\n0.000000 0.000006 0.000000 0.000013 0.000000\\n0.000006 0.000000\\n0.000000 0.000000 0.000009 0.000000 0.000009\\n0.000000 0.000000\\n0.000000 0.000003 0.000000 0.000006 0.000000\\n0.000003 0.000000\\n0.000000 0.000000 0.000000 0.000000 0.000000\\n0.000000 0.000000\\n9\", \"runtime_as_data\": {\"cpu_cores\": 4, \"OMP_NUM_THREADS\": 4, \"architecture\": \"ARM64\", \"candidate_GPU\": false, \"comparison\": \"Exact output bytes against official reference\"}, \"mother_model_as_data\": {\"phase\": \"synthesis\", \"status\": \"complete\", \"guidance\": \"Preserve 4f83638c90194c8e as the incumbent. Prioritize transplanting B's best SIMD kernel into it, then evaluate A's simple contiguous layout separately and in combination as the existing budget permits. Measure every complete integration; neither parent gains nor rankings are additive. Integrate improved C scheduling independently where possible, and defer temporal blocking until its convergence recovery and threaded halos are sound. Use unchanged validation and end-to-end measurements. Audit tiny/no-interior grids, unchanged hot boundary cells, zero and odd iteration limits, convergence exits, SIMD tails, buffer parity and flag-bank races. Select the fastest validated whole program, retaining the incumbent if combinations regress.\", \"analysis\": \"The measured baseline is 72.82 ms. C's ping-pong/persistent-team package leads at 47.46 ms, followed by C's copying variant at 48.72 ms. A reaches 59.83/60.28 ms and B 63.18/65.57 ms. No mixed integration is measured. A's copy elimination overlaps the winning C program, while its temporal-blocking increment is small; B's SIMD remains a plausible complementary donor. These are end-to-end results, not a measured bottleneck breakdown. All roles must preserve synchronous double-precision Jacobi, the original addition grouping, strict error > (double)1.0e-5f, the first converged sweep, iteration limits, frozen initial boundaries and exact output formatting. Initialize both swapped buffers with those boundaries, including nonzero boundaries on tiny grids. Keep every valid input correct without changing the compiler, target, tests, oracle or budgets.\", \"origin\": \"model output from this fresh run; no operator analysis\"}, \"node_research\": {\"enabled\": true, \"corpus_documents\": 0, \"allowed_hosts\": [\"gcc.gnu.org\", \"www.openmp.org\", \"raw.githubusercontent.com\"], \"max_queries_per_action\": 2, \"max_urls_per_action\": 2, \"max_excerpt_characters\": 6000, \"arbitrary_commands\": false, \"general_web_search\": false}}, \"required_json_schema\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"hypothesis\": {\"type\": \"string\"}, \"transformations\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"sources_kept\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"enum\": [\"4f83638c90194c8e\", \"9ae75bf57bcb46eb\", \"2c436f92ba334f38\", \"046b148c5c9640a0\", \"caec810f8c8147d9\", \"8bbd52fa0ee24642\"]}, \"uniqueItems\": true}, \"files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"path\": {\"type\": \"string\"}, \"content\": {\"type\": \"string\"}}, \"required\": [\"path\", \"content\"]}}, \"notes\": {\"type\": \"string\"}, \"research\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"queries\": {\"type\": \"array\", \"maxItems\": 2, \"items\": {\"type\": \"string\", \"minLength\": 1, \"maxLength\": 300}}, \"urls\": {\"type\": \"array\", \"maxItems\": 2, \"items\": {\"type\": \"string\", \"minLength\": 1, \"maxLength\": 2000}}}, \"required\": [\"queries\", \"urls\"]}}, \"required\": [\"hypothesis\", \"transformations\", \"sources_kept\", \"files\", \"notes\", \"research\"]}}\n\nCURRENT SOURCE AS DATA:\n\n--- BEGIN FILE src/laplace_seq.c ---\n/*\n    This program solves Laplace's equation on a regular 2D grid using simple Jacobi iteration.\n\n    The stencil calculation stops when  ( err >= CONV_THRESHOLD OR  iter > ITER_MAX )\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <time.h>\n#include <sys/time.h>\n\n#define CONV_THRESHOLD 1.0e-5f // threshold of convergence\n\n// matrix to be solved\ndouble **grid;\n\n// auxiliary matrix\ndouble **new_grid;\n\n// size of each side of the grid\nint size;\nint iter_max_num;\n\n// return the absolute value of a number\ndouble absolute(double num){\n    if(num < 0)\n        return -1.0 * num;\n    return num;\n}\n\n\n// allocate memory for the grid\nvoid allocate_memory(){\n    grid = (double **) malloc(size * sizeof(double *));\n    new_grid = (double **) malloc(size * sizeof(double *));\n\n    for(int i = 0; i < size; i++){\n        grid[i] = (double *) malloc(size * sizeof(double));\n        new_grid[i] = (double *) malloc(size * sizeof(double));\n    }\n}\n\n// initialize the grid\nvoid initialize_grid(){\n    int center = size / 2;\n    int linf = center - (size / 10);\n    int lsup = center + (size / 10);\n    for (int i = 0; i < size; i++){\n        for (int j = 0; j < size; j++){\n            // inicializa região de calor no centro do grid\n            if ( i >= linf && i <= lsup && j >= linf && j <= lsup)\n                grid[i][j] = 100;\n            else\n                grid[i][j] = 0;\n            new_grid[i][j] = 0.0;\n        }\n    }\n}\n\n// save the grid in a file\nvoid save_grid(){\n\n    for(int i = 0; i < size; i++){\n        for(int j = 0; j < size; j++){\n            fprintf(stdout, \"%lf \", grid[i][j]);\n        }\n        fprintf(stdout, \"\\n\");\n    }\n}\n\nint main(int argc, char *argv[]){\n\n    fscanf(stdin, \"%d\", &size);\n    fscanf(stdin, \"%d\", &iter_max_num);\n    \n    int hasError = 1;\n    int iter = 0;\n\n    struct timeval time_start;\n    struct timeval time_end;\n\n    // allocate memory to the grid (matrix)\n    allocate_memory();\n\n    // set grid initial conditions\n    initialize_grid();\n\n    //printf(\"Jacobi relaxation calculation: %d x %d grid\\n\", size, size);\n\n    // get the start time\n    //gettimeofday(&time_start, NULL);\n\n    // Jacobi iteration\n    // This loop will end if either the maximum change reaches below a set threshold (convergence)\n    // or a fixed number of maximum iterations have completed\n    while ( hasError && iter < iter_max_num ) {\n\n        hasError = 0;\n        // calculates the Laplace equation to determine each cell's next value\n        for( int i = 1; i < size-1; i++) {\n            for(int j = 1; j < size-1; j++) {\n\n                new_grid[i][j] = 0.25 * (grid[i][j+1] + grid[i][j-1] +\n                                         grid[i-1][j] + grid[i+1][j]);\n\n                double errorCurrent = absolute(new_grid[i][j] - grid[i][j]);\n                if(errorCurrent > CONV_THRESHOLD ){\n                    hasError = 1;                                        \n                }     \n            }\n        }            \n        // copie the next values into the working array for the next iteration\n        for( int i = 1; i < size-1; i++) {\n            for( int j = 1; j < size-1; j++) {\n                grid[i][j] = new_grid[i][j];\n            }\n        }        \n        iter++;\n    }\n\n    // get the end time\n    //gettimeofday(&time_end, NULL);\n\n    //double exec_time = (double) (time_end.tv_sec - time_start.tv_sec) +\n    //                   (double) (time_end.tv_usec - time_start.tv_usec) / 1000000.0;\n\n    //save the final grid in file\n    save_grid();\n\n    //printf(\"\\nKernel executed in %lf seconds with %d iterations.\\n\", exec_time, iter);\n\n    return 0;\n}\n\n--- END FILE src/laplace_seq.c ---\n"
    }

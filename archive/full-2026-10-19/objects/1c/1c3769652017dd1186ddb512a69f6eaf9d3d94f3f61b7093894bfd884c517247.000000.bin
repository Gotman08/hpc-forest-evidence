<th id="S4.T1.6.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:-0.45pt 2.2pt;" colspan="2"><span id="S4.T1.6.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">CodeContest</span></th>
<th id="S4.T1.6.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:-0.45pt 2.2pt;" colspan="2"><span id="S4.T1.6.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">ARC-AGI</span></th>
<td id="S4.T1.6.1.5" class="ltx_td ltx_border_tt" style="padding:-0.45pt 2.2pt;"></td></tr>
<tr id="S4.T1.6.2" class="ltx_tr">
<th id="S4.T1.6.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column" style="padding:-0.45pt 2.2pt;"><span id="S4.T1.6.2.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Method</span></th>
<th id="S4.T1.6.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t" style="padding:-0.45pt 2.2pt;"><span id="S4.T1.6.2.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">GPT-4o</span></th>
<th id="S4.T1.6.2.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t" style="padding:-0.45pt 2.2pt;"><span id="S4.T1.6.2.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">DeepSeek-V3</span></th>
<th id="S4.T1.6.2.4" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t" style="padding:-0.45pt 2.2pt;"><span id="S4.T1.6.2.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">GPT-4o</span></th>
<th id="S4.T1.6.2.5" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t" style="padding:-0.45pt 2.2pt;"><span id="S4.T1.6.2.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">DeepSeek-V3</span></th>
<th id="S4.T1.6.2.6" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t" style="padding:-0.45pt 2.2pt;"><span id="S4.T1.6.2.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;">GPT-4o</span></th>
<th id="S4.T1.6.2.7" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_t" style="padding:-0.45pt 2.2pt;"><span id="S4.T1.6.2.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;">DeepSeek-V3</span></th>
<th id="S4.T1.6.2.8" class="ltx_td ltx_align_left ltx_th ltx_th_column" style="padding:-0.45pt 2.2pt;"><span id="S4.T1.6.2.8.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Avg. Rank</span></th></tr>
<tr id="S4.T1.6.3" class="ltx_tr">
<td id="S4.T1.6.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:-0.45pt 2.2pt;"><span id="S4.T1.6.3.1.1" class="ltx_text" style="font-size:90%;">Repeated Sampling <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib1" title="" class="ltx_ref">1</a>, <a href="#bib.bib3" title="" class="ltx_ref">3</a>, <a href="#bib.bib39" title="" class="ltx_ref">39</a>]</cite></span></td>
<td id="S4.T1.6.3.2" class="ltx_td ltx_align_left ltx_border_t" style="padding:-0.45pt 2.2pt;"><span id="S4.T1.6.3.2.1" class="ltx_text" style="font-size:90%;">37.8 (4)</span></td>
<td id="S4.T1.6.3.3" class="ltx_td ltx_align_left ltx_border_t" style="padding:-0.45pt 2.2pt;"><span id="S4.T1.6.3.3.1" class="ltx_text" style="font-size:90%;">40.7 (6)</span></td>

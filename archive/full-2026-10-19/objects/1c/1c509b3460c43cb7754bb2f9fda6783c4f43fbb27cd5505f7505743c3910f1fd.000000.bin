#include <iostream>
#include <vector>
#include <cstdint>
#include <algorithm>

using namespace std;

const int MOD = 1000000007;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) return 0;
    vector<vector<int> > obstacles(n);
    for (int c = 0; c < m; ++c) {
        int y, x;
        cin >> y >> x;
        obstacles[y].push_back(x);
    }

    vector<int> dp(n, 0);
    vector<uint64_t> blocked((n + 63) / 64, 0);
    dp[0] = 1;

    for (int y = 0; y < n; ++y) {
        fill(blocked.begin(), blocked.end(), uint64_t(0));
        for (int x : obstacles[y])
            blocked[x >> 6] |= uint64_t(1) << (x & 63);

        int left = 0;
        for (int base = 0; base < n; base += 64) {
            const int end = min(n, base + 64);
            uint64_t bits = blocked[base >> 6];
            int x = base;
            while (bits != 0) {
                const int stop = base + __builtin_ctzll(bits);
                for (; x < stop; ++x) {
                    int sum = dp[x] + left;
                    if (sum >= MOD) sum -= MOD;
                    dp[x] = left = sum;
                }
                dp[x++] = 0;
                left = 0;
                bits &= bits - 1;
            }
            for (; x < end; ++x) {
                int sum = dp[x] + left;
                if (sum >= MOD) sum -= MOD;
                dp[x] = left = sum;
            }
        }
    }

    cout << dp[n - 1] << '\n';
    return 0;
}

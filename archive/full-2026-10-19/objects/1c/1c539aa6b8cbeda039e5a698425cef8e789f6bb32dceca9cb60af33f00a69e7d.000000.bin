"""Seal this independent static review only; all external inputs remain read-only."""

import hashlib
import json
from datetime import datetime, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent
PREP = HERE.parent
files = {}


def sha(path):
    path = Path(path)
    value = hashlib.sha256(path.read_bytes()).hexdigest()
    files[str(path)] = value
    return value


def ref(path):
    return {"path": str(path), "sha256": sha(path)}


results = []
for name in ("controles-statiques-1.json", "controles-lecture-1.json"):
    path = HERE / name
    value = json.loads(path.read_text(encoding="utf8"))
    assert value["verified"] is True
    for item in value["inspected_files"]:
        assert sha(item["path"]) == item["sha256"]
    results.append(value)
    sha(path)

manual_read_files = {
    "preparation-modeles-max-r1": ["VERIFICATION-FINALE.json", "PROJECTION-FINALE-NON-ADMISE.json", "REPRISE.md",
        "preparer-projections.py", "verifier-projection.py"],
    "preparation-contrat-roots-explicite-r1": ["RECU-SHA-FINAL.json", "PROPOSITION.md", "PROPOSITION.diff",
        "remote_stage_PROPOSITION_NON_ADMISE.py", "test_proposition.py", "VALIDATION-NEUTRE.json",
        "CONSTAT-SCHEMA-SORTIE.md", "tests-neutres.log", "ruff.log"],
    "preparation-lecture-native-r2": ["LIVRAISON-PROPOSITION-LECTURE-NATIVE-R2.json", "normalisation_native.py",
        "test_normalisation_neutre.py", "confirmer_refus_reel.py", "PROPOSITION-INTEGRATION.md", "VALIDATION-LOCALE.json",
        "MANIFESTE-PREPARATION.json", "CONFIRMATION-NEGATIVE-752306.json", "tests-neutres-finaux.log",
        "PRESERVATION-ARTEFACTS-SCELLES.json", "PREMIER-INCIDENT-LOCAL.json", "ruff-final.log"],
}
for folder, names in manual_read_files.items():
    for name in names:
        sha(PREP / folder / name)
sha(PREP / "lancement-technique-r4b-r1/pins-source-plan.json")
code_refs = [ref(HERE / name) for name in ("verifier-preparations-statiques.py", "verifier-lecture-neutre.py", "sceller-revue.py")]
evidence = [ref(HERE / name) for name in ("controles-statiques-1.json", "controles-lecture-1.json")]
receipt = {
    "schema": "hpc-forest-r4b-neutral-preparations-independent-review-v1",
    "verified": True,
    "verified_scope": "independent static review of three NON-ADMITTED preparations only",
    "observed_at_utc": datetime.now(timezone.utc).isoformat(),
    "decision": "ACCEPTABLE_AS_ISOLATED_NEUTRAL_PREPARATIONS_ONLY",
    "blocking_findings": [],
    "source_zip_sha256": "ede293f185e663241c01c22a5fa9edcd54ad66af6a1e0964755eac306c5de0f3",
    "plan_sha256": "9f04e93c1a28c70f444005b7670ff23731cac838846b99cb1b6742db9e8de33b",
    "reviewed_preparations": {
        "model_projection": ref(PREP / "preparation-modeles-max-r1/VERIFICATION-FINALE.json"),
        "projection_non_admitted": ref(PREP / "preparation-modeles-max-r1/PROJECTION-FINALE-NON-ADMISE.json"),
        "explicit_roots_proposal": ref(PREP / "preparation-contrat-roots-explicite-r1/RECU-SHA-FINAL.json"),
        "reader_primitives_proposal": ref(PREP / "preparation-lecture-native-r2/LIVRAISON-PROPOSITION-LECTURE-NATIVE-R2.json"),
    },
    "conclusions": [
        "Three exact MAX models, nine distinct technical sessions and three future pilot sessions match the immutable plan; all jobs remain null and unsubmitted.",
        "The current plan pilot configuration and launcher are Luna-only. The other pilot subjects and SO1+three-new=cap4 are explicitly proposed, never admitted.",
        "The projection final verification true is scoped to static planning only. first_normal_received_before_extension is a future requirement, not a claimed observation.",
        "The roots proposal changes only make_request AST: one system sentence states the already enforced inclusive 1..8 nonempty cardinality. No algorithmic hint, example direction, output repair or retry is supplied.",
        "Schema, user payload, other technical phases, identity, MAX, budgets, expiry and remaining external stage code are unchanged. The actual closed structured output schema has no minItems/maxItems; the source validator still rejects zero and nine.",
        "Pure reader primitives retain both raw request hashes plus the authorized whole-JSON canonical digest; semantic or type changes and duplicate keys are refused.",
        "The only known extra sidecar remains exact, inventoried, hashed and linked to invocation/process/original stream; caller-measured cold inventory and outer actor/CLI/lifecycle guards remain mandatory.",
        "Usage totals remain input plus output. Reasoning/cache subdivisions are retained without adding them again, and missing subdivisions remain absent.",
        "All WARN/error/unknown diagnostics and empty roots remain NORMAL blockers. The scanner and nonempty floor deliberately do not provide a lifecycle, phase or native admission verdict.",
        "The metadata-only negative Luna752306 and both strict reader refusals remain linked and unchanged; no replay or reinterpretation as a positive contract is admitted.",
    ],
    "checks_executed_by_reviewer": {
        "static_metadata_AST_and_isolated_validator_controls": results[0]["checks_passed"],
        "pure_reader_metadata_and_adversarial_fixture_controls": results[1]["checks_passed"],
        "total_controls": sum(item["checks_passed"] for item in results),
        "frozen_validator_counts_exercised": [0, 1, 8, 9],
        "commands": ["python -I -B verifier-preparations-statiques.py", "python -I -B verifier-lecture-neutre.py"],
        "author_unit_suites_rerun": False,
        "production_confirmation_reexecuted": False,
        "evidence_refs": evidence,
        "reviewer_code": code_refs,
    },
    "author_results_reviewed_not_independently_rerun": {
        "explicit_roots_neutral_tests": 11,
        "reader_primitives_neutral_tests": 26,
        "roots_full_Ruff_green": False,
        "roots_Ruff_limitation": "The full base and copy retain the same historical I001 in unchanged one_contract import; tests and copy excluding that inherited item passed according to preserved logs.",
        "reader_primitives_Ruff_log": "All checks passed!",
    },
    "remaining_boundaries": [
        "No preparation here is a production reader integration, complete phase audit, admission, model backend attestation or scientific gain.",
        "Any future integration requires a separately sealed external revision, review, real zero-model allocated preflight of its changed packet, and fresh model/session/job/digest-specific admissions and passive policy.",
        "The existing mechanical source qualification does not by itself qualify a newly changed preparator or another model launcher.",
        "Outer exact actor/source/plan/job/CLI/schema, full stream lifecycle, raw response links, cold cache/exit, exhaustive ledger and closed mother validators must still run unchanged in a future reviewed reader.",
        "The roots sentence does not repair or establish the cause of the earlier CLI diagnostics or zero-root response.",
        "No live freshness, process identity, transport, scheduler state, OAuth, quota or worker absence is attested by this review.",
    ],
    "reviewed_and_hash_verified_files": [{"path": path, "sha256": value} for path, value in sorted(files.items())],
    "external_files_modified": False,
    "source_or_author_modules_edited": False,
    "live_actions": 0,
    "remote_calls": 0,
    "CLI_or_model_or_worker_processes_started": 0,
    "C_compilations_or_executions": 0,
    "jobs_submitted": 0,
    "native_model_calls": 0,
    "native_calls_replayed": 0,
    "generation_admitted": False,
    "normal_native_delivery_verified": False,
    "closed_native_phase_admitted": False,
    "global_admission_verified": False,
    "independent_performance_audit_verified": False,
}
output = HERE / "REVUE.json"
with output.open("x", encoding="utf8", newline="\n") as stream:
    json.dump(receipt, stream, ensure_ascii=False, indent=2, allow_nan=False)
    stream.write("\n")
print(json.dumps({"path": str(output), "sha256": sha(output), "controls": 55, "admitted": False}))

  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/* Direct-array fallback, called collectively by the persistent team. */\nstatic void body_force_direct(Body *p, float dt, int n) {\n#if defined(__aarch64__) && defined(__ARM_NEON)\n  const int vector_end = n - n % 4;\n  const float32x4_t softening = vdupq_n_f32(SOFTENING);\n  const float64x2_t one = vdupq_n_f64(1.0);\n\n#ifdef _OPENMP\n#pragma omp for schedule(static) nowait\n#endif\n  for (int i = 0; i < vector_end; i += 4) {\n    const float32x4_t x = {p[i].x, p[i + 1].x, p[i + 2].x, p[i + 3].x};\n    const float32x4_t y = {p[i].y, p[i + 1].y, p[i + 2].y, p[i + 3].y};\n    const float32x4_t z = {p[i].z, p[i + 1].z, p[i + 2].z, p[i + 3].z};\n    float32x4_t fx = vdupq_n_f32(0.0f);\n    float32x4_t fy = vdupq_n_f32(0.0f);\n    float32x4_t fz = vdupq_n_f32(0.0f);\n\n    for (int j = 0; j < n; j++) {\n      float32x4_t dx = vdupq_n_f32(p[j].x) - x;\n      float32x4_t dy = vdupq_n_f32(p[j].y) - y;\n      float32x4_t dz = vdupq_n_f32(p[j].z) - z;\n      float32x4_t sqrd_dist = dx*dx + dy*dy + dz*dz + softening;\n      float64x2_t distance_lo = vcvt_f64_f32(vget_low_f32(sqrd_dist));\n      float64x2_t distance_hi = vcvt_f64_f32(vget_high_f32(sqrd_dist));\n      float64x2_t inverse_lo = vdivq_f64(one, vsqrtq_f64(distance_lo));\n      float64x2_t inverse_hi = vdivq_f64(one, vsqrtq_f64(distance_hi));\n      float32x4_t inv_dist = vcombine_f32(vcvt_f32_f64(inverse_lo),\n                                         vcvt_f32_f64(inverse_hi));\n      float32x4_t inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*vgetq_lane_f32(fx, 0);\n    p[i].vy += dt*vgetq_lane_f32(fy, 0);\n    p[i].vz += dt*vgetq_lane_f32(fz, 0);\n    p[i + 1].vx += dt*vgetq_lane_f32(fx, 1);\n    p[i + 1].vy += dt*vgetq_lane_f32(fy, 1);\n    p[i + 1].vz += dt*vgetq_lane_f32(fz, 1);\n    p[i + 2].vx += dt*vgetq_lane_f32(fx, 2);\n    p[i + 2].vy += dt*vgetq_lane_f32(fy, 2);\n    p[i + 2].vz += dt*vgetq_lane_f32(fz, 2);\n    p[i + 3].vx += dt*vgetq_lane_f32(fx, 3);\n    p[i + 3].vy += dt*vgetq_lane_f32(fy, 3);\n    p[i + 3].vz += dt*vgetq_lane_f32(fz, 3);\n  }\n#else\n  const int vector_end = 0;\n#endif\n\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n  for (int i = vector_end; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/* Four independent targets share sources from immutable coordinate planes. */\nstatic void body_force_planes(Body *p, float dt, int n,\n                              const float *x, const float *y, const float *z) {\n#if defined(__aarch64__) && defined(__ARM_NEON)\n  const int vector_end = n - n % 4;\n  const float32x4_t softening = vdupq_n_f32(SOFTENING);\n  const float64x2_t one = vdupq_n_f64(1.0);\n\n#ifdef _OPENMP\n#pragma omp for schedule(static) nowait\n#endif\n  for (int i = 0; i < vector_end; i += 4) {\n    const float32x4_t xi = vld1q_f32(x + i);\n    const float32x4_t yi = vld1q_f32(y + i);\n    const float32x4_t zi = vld1q_f32(z + i);\n    float32x4_t fx = vdupq_n_f32(0.0f);\n    float32x4_t fy = vdupq_n_f32(0.0f);\n    float32x4_t fz = vdupq_n_f32(0.0f);\n\n    for (int j = 0; j < n; j++) {\n      float32x4_t dx = vdupq_n_f32(x[j]) - xi;\n      float32x4_t dy = vdupq_n_f32(y[j]) - yi;\n      float32x4_t dz = vdupq_n_f32(z[j]) - zi;\n      float32x4_t sqrd_dist = dx*dx + dy*dy + dz*dz + softening;\n\n      /* Preserve double sqrt and division before conversion to float. */\n      float64x2_t distance_lo = vcvt_f64_f32(vget_low_f32(sqrd_dist));\n      float64x2_t distance_hi = vcvt_f64_f32(vget_high_f32(sqrd_dist));\n      float64x2_t inverse_lo = vdivq_f64(one, vsqrtq_f64(distance_lo));\n      float64x2_t inverse_hi = vdivq_f64(one, vsqrtq_f64(distance_hi));\n      float32x4_t inv_dist = vcombine_f32(vcvt_f32_f64(inverse_lo),\n                                         vcvt_f32_f64(inverse_hi));\n      float32x4_t inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*vgetq_lane_f32(fx, 0);\n    p[i].vy += dt*vgetq_lane_f32(fy, 0);\n    p[i].vz += dt*vgetq_lane_f32(fz, 0);\n    p[i + 1].vx += dt*vgetq_lane_f32(fx, 1);\n    p[i + 1].vy += dt*vgetq_lane_f32(fy, 1);\n    p[i + 1].vz += dt*vgetq_lane_f32(fz, 1);\n    p[i + 2].vx += dt*vgetq_lane_f32(fx, 2);\n    p[i + 2].vy += dt*vgetq_lane_f32(fy, 2);\n    p[i + 2].vz += dt*vgetq_lane_f32(fz, 2);\n    p[i + 3].vx += dt*vgetq_lane_f32(fx, 3);\n    p[i + 3].vy += dt*vgetq_lane_f32(fy, 3);\n    p[i + 3].vz += dt*vgetq_lane_f32(fz, 3);\n  }\n#else\n  const int vector_end = 0;\n#endif\n\n  /* This barrier also completes all four-target blocks. */\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n  for (int i = vector_end; i < n; ++i) {\n    const float xi = x[i], yi = y[i], zi = z[i];\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = x[j] - xi;\n      float dy = y[j] - yi;\n      float dz = z[j] - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * All team threads call this routine. Snapshot storage belongs to this\n * force call; no scratch state is retained between calls.\n */\nvoid body_force(Body *p, float dt, int n) {\n  if (n < 4 || (size_t)n > ((size_t)-1) / (3 * sizeof(float))) {\n    body_force_direct(p, dt, n);\n    return;\n  }\n\n  const size_t count = (size_t)n;\n  float *positions = NULL;\n#ifdef _OPENMP\n#pragma omp single copyprivate(positions)\n#endif\n  {\n    positions = (float *)malloc(3 * count * sizeof(float));\n  }\n\n  if (positions == NULL) {\n    body_force_direct(p, dt, n);\n    return;\n  }\n\n  float *x = positions;\n  float *y = x + count;\n  float *z = y + count;\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n  for (int j = 0; j < n; ++j) {\n    x[j] = p[j].x;\n    y[j] = p[j].y;\n    z[j] = p[j].z;\n  }\n\n  body_force_planes(p, dt, n, x, y, z);\n\n  /* All snapshot readers have completed at the force-loop barrier. */\n#ifdef _OPENMP\n#pragma omp single nowait\n#endif\n  {\n    free(positions);\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /* Reuse one team, retaining force/integration and timestep barriers. */\n#ifdef _OPENMP\n#pragma omp parallel if(nbodies >= 64) default(none) shared(bodies, nbodies)\n#endif\n  {\n    for (int iter = 0; iter < N_ITER; iter++) {\n      body_force(bodies, DT, nbodies);\n\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n      for (int i = 0; i < nbodies; i++) {\n        bodies[i].x += bodies[i].vx * DT;\n        bodies[i].y += bodies[i].vy * DT;\n        bodies[i].z += bodies[i].vz * DT;\n      }\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Adding archived position-plane snapshots to the measured persistent-OpenMP/four-target NEON integration may reduce source-cache traffic enough to offset packing and synchronization.",

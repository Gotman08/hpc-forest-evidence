#include <stdio.h>
#include <stdlib.h>
#include <string.h>

static int compare_records(const void *left, const void *right) {
    return strcmp((const char *)left, (const char *)right);
}

static char *bucket_sort(char *strings, int length, long int size,
                         int offset, int nbuckets) {
    size_t width = (size_t)length;
    size_t n_items = (size_t)size;
    size_t bytes = n_items * width;
    size_t *starts = (size_t *)calloc((size_t)nbuckets, sizeof(*starts));
    size_t *next = (size_t *)malloc((size_t)nbuckets * sizeof(*next));
    char *sorted = (char *)malloc(bytes == 0 ? 1 : bytes);
    long int i;
    int b;

    if (starts == NULL || next == NULL || sorted == NULL) {
        free(starts);
        free(next);
        free(sorted);
        fprintf(stderr, "ERROR allocation");
        exit(EXIT_FAILURE);
    }

    /* Count entries first so each bucket gets an exact, disjoint range. */
    for (i = 0; i < size; ++i) {
        b = (int)strings[(size_t)i * width] - offset;
        ++starts[b];
    }

    /* Turn counts into bucket starts and independent scatter cursors. */
    {
        size_t prefix = 0;
        for (b = 0; b < nbuckets; ++b) {
            size_t count = starts[b];
            starts[b] = prefix;
            next[b] = prefix;
            prefix += count;
        }
    }

    /* Gather complete records into contiguous bucket ranges. */
    for (i = 0; i < size; ++i) {
        size_t source = (size_t)i * width;
        b = (int)strings[source] - offset;
        memcpy(sorted + next[b] * width, strings + source, width);
        ++next[b];
    }

    /* Each qsort operates on a separate contiguous range. */
#ifdef _OPENMP
#pragma omp parallel for schedule(dynamic, 1)
#endif
    for (b = 0; b < nbuckets; ++b) {
        size_t count = next[b] - starts[b];
        if (count > 1) {
            qsort(sorted + starts[b] * width, count, width, compare_records);
        }
    }

    free(starts);
    free(next);
    return sorted;
}

static void load(char **vString, long int *N, int *l, int *os, int *nb) {
    char *strings = NULL;
    int len;
    int offset;
    int nbucket;
    long int n;

    if (!fscanf(stdin, "%d", &len)) {
        printf("ERROR len\n");
        exit(1);
    }
    if (!fscanf(stdin, "%ld", &n)) {
        printf("ERROR n\n");
        exit(1);
    }
    if (!fscanf(stdin, "%d", &offset)) {
        printf("ERROR offset\n");
        exit(1);
    }
    if (!fscanf(stdin, "%d", &nbucket)) {
        printf("ERROR nbucket\n");
        exit(1);
    }

    nbucket = nbucket + 1;
    len = len + 1;
    strings = (char *)malloc((size_t)n * (size_t)len);

    for (long int i = 0; i < n; ++i) {
        if (!fscanf(stdin, "%s", strings + (size_t)i * (size_t)len)) {
            printf("ERROR %ld\n", i);
            exit(1);
        }
    }

    *vString = strings;
    *N = n;
    *l = len;
    *os = offset;
    *nb = nbucket;
}

static void save(char *strings, long int n, int len) {
    for (long int i = 0; i < n; ++i) {
        printf("%s\n", strings + (size_t)i * (size_t)len);
    }
}

int main(int ac, char **av) {
    char *strings = NULL;
    char *sorted = NULL;
    long int N = 0;
    int len = 0;
    int offset;
    int nbuckets;

    load(&strings, &N, &len, &offset, &nbuckets);
    sorted = bucket_sort(strings, len, N, offset, nbuckets);
    save(sorted, N, len);

    free(strings);
    free(sorted);
    return EXIT_SUCCESS;
}

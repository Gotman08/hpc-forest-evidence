      "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<uint64_t> blocked;\n    blocked.reserve(m);\n    for (int c = 0; c < m; ++c) {\n        int row, col;\n        cin >> row >> col;\n        blocked.push_back(static_cast<uint64_t>(row) * n + col);\n    }\n    sort(blocked.begin(), blocked.end());\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\n\n    vector<int> dp(n, 0);\n    dp[0] = 1;\n    size_t next = 0;\n\n    for (int row = 0; row < n; ++row) {\n        const uint64_t row_begin = static_cast<uint64_t>(row) * n;\n        const uint64_t row_end = row_begin + n;\n        int col = 0;\n        int left = 0;\n\n        while (next < blocked.size() && blocked[next] < row_end) {\n            const int stop = static_cast<int>(blocked[next] - row_begin);\n            for (; col < stop; ++col) {\n                int sum = dp[col] + left;\n                if (sum >= MOD) sum -= MOD;\n                dp[col] = sum;\n                left = sum;\n            }\n            dp[stop] = 0;\n            left = 0;\n            col = stop + 1;\n            ++next;\n        }\n\n        for (; col < n; ++col) {\n            int sum = dp[col] + left;\n            if (sum >= MOD) sum -= MOD;\n            dp[col] = sum;\n            left = sum;\n        }\n    }\n\n    cout << dp[n - 1] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "A single contiguous DP row and streaming obstacle-free spans should reduce memory traffic and per-cell overhead compared with two copied rows and an N×N obstacle bitmap.",
  "notes": "Uses O(N+M) storage; sorting costs O(M log M). Handles duplicate obstacles, blocked endpoints, and N=1. No execution or measurements performed.",

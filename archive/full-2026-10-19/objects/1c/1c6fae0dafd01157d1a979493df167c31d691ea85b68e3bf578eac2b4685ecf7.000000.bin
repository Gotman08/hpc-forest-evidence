#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <algorithm>
#include <climits>

class FastScanner {
public:
    static const int BUFSIZE = 1 << 20;
    char buf[BUFSIZE];
    int idx, size;
    FastScanner() : idx(0), size(0) {}
    inline char getChar() {
        if (idx >= size) {
            size = fread(buf, 1, BUFSIZE, stdin);
            idx = 0;
            if (size == 0) return 0;
        }
        return buf[idx++];
    }
    int nextInt() {
        char c;
        do { c = getChar(); } while (c <= ' ');
        bool neg = false;
        if (c == '-') { neg = true; c = getChar(); }
        int x = 0;
        while (c >= '0' && c <= '9') {
            x = x * 10 + (c - '0');
            c = getChar();
        }
        return neg ? -x : x;
    }
};

int main() {
    FastScanner fs;
    int n = fs.nextInt();
    int s = fs.nextInt();

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    std::vector<int> mat(n * n);
    for (int i = 0; i < n; ++i)
        for (int j = 0; j < n; ++j)
            mat[i*n + j] = fs.nextInt();

    // Column prefix sums in flat row-major: colPref[i*n + j]
    std::vector<long long> colPref(n * n);
    long long mxSum = LLONG_MIN;

    #pragma omp parallel
    {
        // Per-thread buffer for per-row column-prefix sums.
        std::vector<long long> pref(n + 1);

        #pragma omp for schedule(static)
        for (int j = 0; j < n; ++j) {
            long long running = 0;
            for (int i = 0; i < n; ++i) {
                running += mat[i*n + j];
                colPref[i*n + j] = running;
            }
        }

        // implicit barrier between the two worksharing loops

        #pragma omp for reduction(max:mxSum) schedule(static)
        for (int r = 0; r <= n - s; ++r) {
            int bottom = r + s - 1;
            int topMinusOne = r - 1;

            // Build prefix sums of the vertical segment lengths for this row.
            pref[0] = 0;
            for (int c = 0; c < n; ++c) {
                long long seg = colPref[bottom*n + c] -
                                (topMinusOne >= 0 ? colPref[topMinusOne*n + c] : 0);
                pref[c+1] = pref[c] + seg;
            }

            // Evaluate all horizontal windows independently; SIMD-friendly.
            long long best = LLONG_MIN;
            #pragma omp simd reduction(max:best)
            for (int c = 0; c <= n - s; ++c) {
                long long w = pref[c+s] - pref[c];
                if (w > best) best = w;
            }

            if (best > mxSum) mxSum = best;
        }
    }

    printf("%d\n", (int)mxSum);
}

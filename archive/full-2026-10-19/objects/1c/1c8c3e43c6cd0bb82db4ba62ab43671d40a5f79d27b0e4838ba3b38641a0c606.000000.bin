"""Project the two real direct children of G from the verified report data."""
import hashlib
import json
from pathlib import Path

base = Path(r"C:\Users\nicol\Documents\Codex\2026-10-15\cr")
source = base / "outputs/Rapport-HPC-Forest-ROMEO/donnees-arbres.json"
fragment = Path(r"C:\Users\nicol\.codex\visualizations\2026\10\15\01a13e1b-d868-7240-8a3c-454bc296b43e/forest-siblings.html")
expected = "4916834b098ad18a623ccc138c8b1678d419d563c1774a41721d9e529bce17a5"
assert hashlib.sha256(source.read_bytes()).hexdigest() == expected
data = json.loads(source.read_bytes())
campaign = next(c for c in data["campaigns"] if c["job"] == "746831" and c["model"].endswith("14b"))
tree = next(t for t in campaign["trees"] if t["role"] == "G")
assert tree["nodes"][0]["state"] is None
assert tree["nodes"][0]["child_count"] == 2
children = []
for trial in campaign["trials"]:
    if trial["role"] != "G":
        continue
    node = next(n for n in tree["nodes"] if n["state"] and n["state"]["experiment_id"] == trial["id"])
    assert trial["parent"] is None and node["parent"] == -1 and node["depth"] == 1
    assert node["score"] == trial["outcome"]["score"]
    children.append({"label": trial["label"], "id":trial["id"], "score":node["score"],
                     "seconds":trial["outcome"]["mean_seconds"], "parent":"G", "depth":1})
assert [c["label"] for c in children] == ["G1", "G2"]
evidence = {"job":campaign["job"], "model":campaign["model"], "children":children}
text = fragment.read_text(encoding="utf-8")
assert text.count("/*SIBLING_DATA*/ null") == 1
fragment.write_text(text.replace("/*SIBLING_DATA*/ null", json.dumps(evidence,ensure_ascii=False)),encoding="utf-8",newline="\n")
receipt = {"source_sha256":expected,"tree_sha256":tree["sha256"],"direct_children":children,
           "fragment_sha256":hashlib.sha256(fragment.read_bytes()).hexdigest()}
(base / "work/forest-animation/siblings-data-verification.json").write_text(json.dumps(receipt,indent=2),encoding="utf-8")
print(json.dumps(receipt,indent=2))

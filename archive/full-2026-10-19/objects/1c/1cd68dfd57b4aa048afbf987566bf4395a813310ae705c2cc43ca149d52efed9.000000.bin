#include <iostream>
#include <vector>
#include <utility>

using namespace std;

typedef vector<vector<bool>> adjacency_matrix;

adjacency_matrix readGraph();
bool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);
int pairMismatch(const adjacency_matrix &g1, const adjacency_matrix &g2,
                 const vector<int> &equivalence, int i, int j);
int countMismatches(const adjacency_matrix &g1, const adjacency_matrix &g2,
                    const vector<int> &equivalence);
int countAffectedMismatches(const adjacency_matrix &g1, const adjacency_matrix &g2,
                            const vector<int> &equivalence, int a, int b);
inline void printPermutation(vector<int> &equivalence);

int main(){
    adjacency_matrix g1 = readGraph();
    adjacency_matrix g2 = readGraph();

    if(!testIsomorphism(g1, g2))
        cout << "The graphs are not isomorphic" << endl;

    return 0;
}

bool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){
    if(g1.size() != g2.size()) return false;

    int n = static_cast<int>(g1.size());
    vector<int> equivalence(n, 0);
    vector<int> exchange_counter(n, 0);
    int exchange_index = 1;
    bool isomorphism_found = false;

    for(int i = 0; i < n; ++i)
        equivalence[i] = i;

    int mismatch_count = countMismatches(g1, g2, equivalence);
    if(mismatch_count == 0){
        printPermutation(equivalence);
        return true;
    }

    /*
     * Permutations are based on Heap's algorithm, which generates all possible
     * permutations for a given set of elements.
     */
    while(exchange_index < n){
        if(exchange_counter[exchange_index] < exchange_index){
            int a;
            int b = exchange_index;
            if(exchange_index % 2 == 0){
                a = 0;
            }else{
                a = exchange_counter[exchange_index];
            }

            int affected_before = countAffectedMismatches(g1, g2, equivalence, a, b);
            swap(equivalence[a], equivalence[b]);
            int affected_after = countAffectedMismatches(g1, g2, equivalence, a, b);
            mismatch_count += affected_after - affected_before;

            if(mismatch_count == 0){
                printPermutation(equivalence);
                isomorphism_found = true;
            }

            exchange_counter[exchange_index]++;
            exchange_index = 1;
        }else{
            exchange_counter[exchange_index] = 0;
            exchange_index++;
        }
    }
    return isomorphism_found;
}

int pairMismatch(const adjacency_matrix &g1, const adjacency_matrix &g2,
                 const vector<int> &equivalence, int i, int j){
    if(i < j) swap(i, j);
    return g1[i][j] != g2[equivalence[i]][equivalence[j]];
}

int countMismatches(const adjacency_matrix &g1, const adjacency_matrix &g2,
                    const vector<int> &equivalence){
    int count = 0;
    int n = static_cast<int>(equivalence.size());
    for(int i = 0; i < n; ++i){
        for(int j = 0; j <= i; ++j)
            count += pairMismatch(g1, g2, equivalence, i, j);
    }
    return count;
}

int countAffectedMismatches(const adjacency_matrix &g1, const adjacency_matrix &g2,
                            const vector<int> &equivalence, int a, int b){
    int count = pairMismatch(g1, g2, equivalence, a, a)
              + pairMismatch(g1, g2, equivalence, b, b)
              + pairMismatch(g1, g2, equivalence, a, b);
    int n = static_cast<int>(equivalence.size());
    for(int k = 0; k < n; ++k){
        if(k != a && k != b){
            count += pairMismatch(g1, g2, equivalence, a, k);
            count += pairMismatch(g1, g2, equivalence, b, k);
        }
    }
    return count;
}

adjacency_matrix readGraph(){
    int vertices, edges, source, destination;

    cin >> vertices;
    adjacency_matrix read(vertices);
    for (int i = 0; i < vertices; ++i)
        read[i].resize(vertices);

    cin >> edges;
    for (int i = 0; i < edges; i++) {
       cin >> source >> destination;
       read[destination][source] = read[source][destination] = true;
    }

    return read;
}

inline void printPermutation(vector<int> &equivalence){
    for (auto i : equivalence)
        cout << i << " ";
    cout << endl;
}

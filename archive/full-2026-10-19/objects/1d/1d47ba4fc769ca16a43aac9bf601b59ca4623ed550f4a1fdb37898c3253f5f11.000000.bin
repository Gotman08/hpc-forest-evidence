  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <math.h>\n#include <omp.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n  return bodies;\n}\n\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n  Body *bodies = read_dataset(&nbodies);\n\n  // Allocate two sets of SoA arrays with 64-byte alignment for better SIMD.\n  size_t arr_size = (size_t)nbodies * sizeof(float);\n  float *x0, *y0, *z0, *vx0, *vy0, *vz0;\n  float *x1, *y1, *z1, *vx1, *vy1, *vz1;\n\n  if (posix_memalign((void**)&x0, 64, arr_size) != 0 ||\n      posix_memalign((void**)&y0, 64, arr_size) != 0 ||\n      posix_memalign((void**)&z0, 64, arr_size) != 0 ||\n      posix_memalign((void**)&vx0, 64, arr_size) != 0 ||\n      posix_memalign((void**)&vy0, 64, arr_size) != 0 ||\n      posix_memalign((void**)&vz0, 64, arr_size) != 0 ||\n      posix_memalign((void**)&x1, 64, arr_size) != 0 ||\n      posix_memalign((void**)&y1, 64, arr_size) != 0 ||\n      posix_memalign((void**)&z1, 64, arr_size) != 0 ||\n      posix_memalign((void**)&vx1, 64, arr_size) != 0 ||\n      posix_memalign((void**)&vy1, 64, arr_size) != 0 ||\n      posix_memalign((void**)&vz1, 64, arr_size) != 0) {\n    perror(\"aligned alloc\");\n    exit(EXIT_FAILURE);\n  }\n\n  // Copy input into set 0 (source for iteration 0).\n  for (int i = 0; i < nbodies; ++i) {\n    x0[i] = bodies[i].x;\n    y0[i] = bodies[i].y;\n    z0[i] = bodies[i].z;\n    vx0[i] = bodies[i].vx;\n    vy0[i] = bodies[i].vy;\n    vz0[i] = bodies[i].vz;\n  }\n\n  // Single parallel region spanning all iterations to avoid thread creation overhead.\n  #pragma omp parallel\n  {\n    for (int iter = 0; iter < N_ITER; ++iter) {\n      float *xs, *ys, *zs, *vxs, *vys, *vzs;\n      float *xd, *yd, *zd, *vxd, *vyd, *vzd;\n\n      if ((iter & 1) == 0) { // even: src=set0, dst=set1\n        xs = x0; ys = y0; zs = z0; vxs = vx0; vys = vy0; vzs = vz0;\n        xd = x1; yd = y1; zd = z1; vxd = vx1; vyd = vy1; vzd = vz1;\n      } else {\n        xs = x1; ys = y1; zs = z1; vxs = vx1; vys = vy1; vzs = vz1;\n        xd = x0; yd = y0; zd = z0; vxd = vx0; vyd = vy0; vzd = vz0;\n      }\n\n      // Combined force computation and position/velocity update in one pass.\n      #pragma omp for schedule(static)\n      for (int i = 0; i < nbodies; ++i) {\n        float xi = xs[i];\n        float yi = ys[i];\n        float zi = zs[i];\n\n        float fx = 0.0f;\n        float fy = 0.0f;\n        float fz = 0.0f;\n\n        int j = 0;\n        // Unroll inner loop by 8, preserving strict ascending accumulation order.\n        for (; j + 7 < nbodies; j += 8) {\n          float dx = xs[j] - xi;\n          float dy = ys[j] - yi;\n          float dz = zs[j] - zi;\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          float inv_dist = 1 / sqrt(sqrd_dist);\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n\n          dx = xs[j+1] - xi;\n          dy = ys[j+1] - yi;\n          dz = zs[j+1] - zi;\n          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          inv_dist = 1 / sqrt(sqrd_dist);\n          inv_dist3 = inv_dist * inv_dist * inv_dist;\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n\n          dx = xs[j+2] - xi;\n          dy = ys[j+2] - yi;\n          dz = zs[j+2] - zi;\n          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          inv_dist = 1 / sqrt(sqrd_dist);\n          inv_dist3 = inv_dist * inv_dist * inv_dist;\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n\n          dx = xs[j+3] - xi;\n          dy = ys[j+3] - yi;\n          dz = zs[j+3] - zi;\n          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          inv_dist = 1 / sqrt(sqrd_dist);\n          inv_dist3 = inv_dist * inv_dist * inv_dist;\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n\n          dx = xs[j+4] - xi;\n          dy = ys[j+4] - yi;\n          dz = zs[j+4] - zi;\n          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          inv_dist = 1 / sqrt(sqrd_dist);\n          inv_dist3 = inv_dist * inv_dist * inv_dist;\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n\n          dx = xs[j+5] - xi;\n          dy = ys[j+5] - yi;\n          dz = zs[j+5] - zi;\n          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          inv_dist = 1 / sqrt(sqrd_dist);\n          inv_dist3 = inv_dist * inv_dist * inv_dist;\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n\n          dx = xs[j+6] - xi;\n          dy = ys[j+6] - yi;\n          dz = zs[j+6] - zi;\n          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          inv_dist = 1 / sqrt(sqrd_dist);\n          inv_dist3 = inv_dist * inv_dist * inv_dist;\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n\n          dx = xs[j+7] - xi;\n          dy = ys[j+7] - yi;\n          dz = zs[j+7] - zi;\n          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          inv_dist = 1 / sqrt(sqrd_dist);\n          inv_dist3 = inv_dist * inv_dist * inv_dist;\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n        }\n\n        // Remainder iterations.\n        for (; j < nbodies; ++j) {\n          float dx = xs[j] - xi;\n          float dy = ys[j] - yi;\n          float dz = zs[j] - zi;\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          float inv_dist = 1 / sqrt(sqrd_dist);\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n        }\n\n        // Update velocity and position into destination arrays.\n        vxd[i] = vxs[i] + DT*fx;\n        vyd[i] = vys[i] + DT*fy;\n        vzd[i] = vzs[i] + DT*fz;\n        xd[i] = xs[i] + vxd[i]*DT;\n        yd[i] = ys[i] + vyd[i]*DT;\n        zd[i] = zs[i] + vzd[i]*DT;\n      }\n      // Implicit barrier at end of omp for ensures all writes are visible\n      // before the next iteration reads from dst as src.\n    }\n  }\n\n  // Final state is in set0 if N_ITER even, else set1.\n  float *xf = (N_ITER % 2 == 0) ? x0 : x1;\n  float *yf = (N_ITER % 2 == 0) ? y0 : y1;\n  float *zf = (N_ITER % 2 == 0) ? z0 : z1;\n  float *vxf = (N_ITER % 2 == 0) ? vx0 : vx1;\n  float *vyf = (N_ITER % 2 == 0) ? vy0 : vy1;\n  float *vzf = (N_ITER % 2 == 0) ? vz0 : vz1;\n\n  // Convert back to AoS output layout.\n  for (int i = 0; i < nbodies; ++i) {\n    bodies[i].x = xf[i];\n    bodies[i].y = yf[i];\n    bodies[i].z = zf[i];\n    bodies[i].vx = vxf[i];\n    bodies[i].vy = vyf[i];\n    bodies[i].vz = vzf[i];\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(x0); free(y0); free(z0); free(vx0); free(vy0); free(vz0);\n  free(x1); free(y1); free(z1); free(vx1); free(vy1); free(vz1);\n  free(bodies);\n\n  return EXIT_SUCCESS;\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Integrating SoA layout (A), 64-byte aligned allocations via posix_memalign (B), and double buffering with alternating arrays plus a single combined force/position update pass per iteration (C) will improve cache locality, enable better SIMD alignment, reduce synchronization overhead from two barriers to one per iteration, and preserve exact output bytes.",
  "notes": "The program uses two sets of SoA arrays. Each iteration reads from the source set and writes new velocities and positions into the destination set, eliminating data races without needing separate force and position loops. The inner loop is unrolled by 8 while preserving strict ascending accumulation order for bit-exact correctness.",

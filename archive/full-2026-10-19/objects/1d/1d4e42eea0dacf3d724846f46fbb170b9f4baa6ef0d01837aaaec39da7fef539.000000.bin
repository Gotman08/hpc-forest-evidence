ve(s);\\n     while (!done) {\\n         state_t * head = next_level;\\n-        for (next_level = NULL; head && !done; head = head -> qnext)\\n-            do_move(head);\\n+        next_level = NULL;\\n+\\n+        while (head && !done) {\\n+            state_t * parents[BFS_BATCH_SIZE];\\n+            int count = 0;\\n+            while (head && count < BFS_BATCH_SIZE) {\\n+                parents[count++] = head;\\n+                head = head -> qnext;\\n+            }\\n+\\n+            if (count < PARALLEL_BATCH_MIN) {\\n+                for (int i = 0; i < count && !done; i++)\\n+                    do_move(parents[i]);\\n+                continue;\\n+            }\\n+\\n+            state_t * candidates[4 * BFS_BATCH_SIZE];\\n+            bool valid[4 * BFS_BATCH_SIZE];\\n+            const int candidate_count = count * 4;\\n+\\n+            /* Allocate serially, then work-share independent move checks. */\\n+            for (int k = 0; k < candidate_count; k++)\\n+                candidates[k] = newstate(parents[k / 4]);\\n+\\n+            #pragma omp parallel for schedule(static)\\n+            for (int k = 0; k < candidate_count; k++) {\\n+                const int parent_index = k / 4;\\n+                const int direction = k % 4;\\n+                valid[k] = make_move(parents[parent_index], &candidates[k],\\n+                    move_dy[direction], move_dx[direction]);\\n+            }\\n+\\n+            /* Commit strictly in the original parent and direction order. */\\n+            for (int k = 0; k < candidate_count; k++) {\\n+                if (valid[k])\\n+                    queue_move(candidates[k]);\\n+                else\\n+                    unnewstate(candidates[k]);\\n+\\n+                if (done) {\\n+                    for (int j = k + 1; j < candidate_count; j++)\\n+                        unnewstate(candidates[j]);\\n+                    break;\\n+                }\\n+            }\\n+        }\\n \\n-        if (!next_level) {\
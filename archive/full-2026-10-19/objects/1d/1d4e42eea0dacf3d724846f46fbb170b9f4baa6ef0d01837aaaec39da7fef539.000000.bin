mean_seconds\": 0.006284583359956741, \"diff\": \"diff --git a/src/sokoban.c b/src/sokoban.c\\nindex d9d7ddf..0ea8996 100644\\n--- a/src/sokoban.c\\n+++ b/src/sokoban.c\\n@@ -153,48 +153,48 @@ void hash(state_t * s) {\\n state_t ** buckets;\\n hash_t hash_size, fill_limit, filled;\\n \\n+/* Grow the contiguous bucket array and reinsert its occupied entries. */\\n void extend_table() {\\n-    int old_size = hash_size;\\n+    const hash_t old_size = hash_size;\\n+    state_t ** old_buckets = buckets;\\n \\n     if (!old_size) {\\n         hash_size = 1024;\\n         filled = 0;\\n-        fill_limit = hash_size * 3 / 4; // 0.75 load factor\\n     } else {\\n         hash_size *= 2;\\n-        fill_limit *= 2;\\n     }\\n+    fill_limit = hash_size * 3 / 4;\\n \\n-    buckets = realloc(buckets, sizeof(state_t * ) * hash_size);\\n+    buckets = calloc(hash_size, sizeof(state_t *));\\n     assert(buckets);\\n \\n-    // rehash\\n-    memset(buckets + old_size, 0, sizeof(state_t * ) * (hash_size - old_size));\\n-\\n     const hash_t bits = hash_size - 1;\\n-    for (int i = 0; i < old_size; i++) {\\n-        state_t * head = buckets[i];\\n-        buckets[i] = NULL;\\n-        while (head) {\\n-            state_t * next = head -> next;\\n-            const int j = head -> h & bits;\\n-            head -> next = buckets[j];\\n-            buckets[j] = head;\\n-            head = next;\\n-        }\\n+    for (hash_t i = 0; i < old_size; i++) {\\n+        state_t * entry = old_buckets[i];\\n+        if (!entry) continue;\\n+\\n+        hash_t j = entry -> h & bits;\\n+        while (buckets[j])\\n+            j = (j + 1) & bits;\\n+        buckets[j] = entry;\\n     }\\n+\\n+    free(old_buckets);\\n }\\n \\n state_t * lookup(state_t * s) {\\n     hash(s);\\n-    state_t * f = buckets[s -> h & (hash_size - 1)];\\n-    for (; f; f = f -> next) {\\n-        if ( //(f->h == s->h) &&\\n+    hash_t i = s -> h & (hash_size - 1);\\n+    while (buckets[i]) {\\n+        state_t * f = buckets[i];\\n+        if (f -> h == s -> h &&\\n             !memcmp(s -> c, f -> c, sizeof(cidx_t) * (1 + n_boxes)))\\n-            break;\\n+            return f;\\n+        i = (i + 1) & (hash_size - 1);\\n     }\\n \\n-    return f;\\n+    return NULL;\\n }\\n \\n bool add_to_table(state_t * s) {\\n@@ -207,8 +207,8 @@ bool add_to_table(state_t * s) {\\n         extend_table();\\n \\n     hash_t i = s -> h & (hash_size - 1);\\n-\\n-    s -> next = buckets[i];\\n+    while (buckets[i])\\n+        i = (i + 1) & (hash_size - 1);\\n     buckets[i] = s;\\n     return true;\\n }\"}, {\"id\": \"41a40065de2842e1\", \"role\": \"C\", \"commit\": \"254e2c9cf48bd26a86aed949eeedb0ce1f2ca603\", \"transformations\": {\"files\": [\"src/sokoban.c\"], \"retained\": [\"Batch up to 32 frontier states and use an OpenMP static-scheduled loop to evaluate their four independent move candidates when at least eight parents are available.\", \"Allocate candidate states serially before the parallel loop and commit results serially in the original parent and direction order; recycle invalid and unprocessed candidates.\", \"Reject moves whose destination or pushed-box destination falls outside the board before indexing board or live.\"]}, \"mean_seconds\": 0.006346481541792552, \"diff\": \"diff --git a/src/sokoban.c b/src/sokoban.c\\nindex d9d7ddf..499b059 100644\\n--- a/src/sokoban.c\\n+++ b/src/sokoban.c\\n@@ -219,18 +219,21 @@ bool success(const state_t * s) {\\n     return true;\\n }\\n \\n-state_t * move_me(state_t * s,\\n-    const int dy,\\n-        const int dx) {\\n+/* Generate one move into an optional preallocated state. The parallel\\n+   work-sharing loop only calls this with distinct, already allocated states. */\\n+bool make_move(state_t * s, state_t ** candidate,\\n+    const int dy, const int dx) {\\n     const int y = s -> c[0] / w;\\n     const int x = s -> c[0] % w;\\n     const int y1 = y + dy;\\n     const int x1 = x + dx;\\n-    const int c1 = y1 * w + x1;\\n \\n- 
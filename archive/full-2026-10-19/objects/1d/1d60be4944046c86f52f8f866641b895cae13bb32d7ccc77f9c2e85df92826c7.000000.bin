"""Unbound local R2g qualification templates; never execute proposed commands."""
import hashlib
import re
from pathlib import Path

HERE = Path(__file__).resolve().parent
BASE = HERE.parents[2]
OLD = BASE / 'outputs/HPC-Forest-Primes-Natif-Relance-r2f/qualification-zero-modele-r1'
CELLS = {'gpt-6-astra': '110cefccf16b439eb226e475c875c8df',
         'gpt-5.6-terra': '5d8811082a1842f5836a2bdda982500f',
         'gpt-6.1-sol': '13eaca4e39cf4147a3f677a32fb5a52d'}


def read(path, checksum):
    raw = path.read_bytes()
    if hashlib.sha256(raw).hexdigest() != checksum:
        raise ValueError('Changed exact qualified local ancestor')
    return raw.decode('utf8')


def save(name, text):
    compile(text, '<unbound-R2g-local-template>', 'exec')
    with (HERE / name).open('x', encoding='utf8', newline='\n') as stream:
        stream.write(text)
    return hashlib.sha256((HERE / name).read_bytes()).hexdigest()


wrapper = read(OLD / 'qualification-wrapper-r2f-template.py', '0a299ddec455b6bf6c21ef3870437cc8b2826b7c6507dc7a14ebdd1d3a19fcb8')
wrapper = wrapper.replace('hpc-forest-primes-native-max-r2f', 'hpc-forest-primes-native-max-r2g')
wrapper = wrapper.replace('HPC-Forest-Primes-Natif-MAX-r2f.zip', 'HPC-Forest-Primes-Natif-MAX-r2g.zip')
wrapper = wrapper.replace('New unbound R2f envelope', 'New unbound R2g envelope')
wrapper = wrapper.replace('"test_worker_argument_routing_r2f.py"}', '"test_worker_argument_routing_r2f.py", "test_host_policy_r2g.py"}')
wrapper = wrapper.replace('len(NEUTRAL_TESTS) == 5', 'len(NEUTRAL_TESTS) == 6')
wrapper = wrapper.replace('Exactly lane/core/diagnostic/first-batch/real-inherited-parser neutral suites', 'Exactly lane/core/diagnostic/first-batch/real-inherited-parser/host-policy neutral suites')
wrapper_sha = save('qualification-wrapper-r2g-template.py', wrapper)
renderer = read(OLD / 'rendre-proposition.py', 'a30b31660113b8bad93973e6010e235d3845fc2c1037717924b809f3bce9a298')
renderer = renderer.replace('0a299ddec455b6bf6c21ef3870437cc8b2826b7c6507dc7a14ebdd1d3a19fcb8', wrapper_sha)
for before, after in {
    'hpc-forest-primes-native-max-r2f': 'hpc-forest-primes-native-max-r2g',
    'qualification-wrapper-r2f': 'qualification-wrapper-r2g',
    'r2f-zero-model': 'r2g-zero-model', 'r2f_zero_model': 'r2g_zero_model',
    'R2F_ALLOCATED': 'R2G_ALLOCATED', 'fresh R2f': 'fresh R2g', 'new R2f': 'new R2g',
    '5aeceff56b26452290325ed4274d71bd': CELLS['gpt-6-astra'],
    'e7c86715f4d34e9f9efcdcc4ce2a81c8': CELLS['gpt-5.6-terra'],
    '1294453607b34c68ba05872072640120': CELLS['gpt-6.1-sol'],
}.items():
    renderer = renderer.replace(before, after)
anchor = '    suite_counts = tests.get("neutral_suite_counts")'
if renderer.count(anchor) != 1:
    raise ValueError('Exact final neutral suite binding anchor required')
renderer = renderer.replace(anchor, '''    historical_r2f = {"source_zip_sha256": "47f97afabcd6d10c5e95a1dc3aae0a34b0841183919785a6bd62d58aa1e90d75",
        "plan_sha256": "8d91ebe83ab550ad50acc330f830e1bc86bcc67f66b88054538df6b394558450",
        "payload_sha256": "232c714734ae1c60dca8b45f3c04f5739625cffcbcfeedfbc317f767380248f6"}
    require(all(bindings.get(key) != value for key, value in historical_r2f.items()),
        "R2f source/plan/payload remain historical; the distinct R2g host contract requires new received Q")
''' + anchor)
save('rendre-proposition.py', renderer)
receiver = read(BASE / 'outputs/HPC-Forest-Primes-Natif-Relance-r2f/reception-Q753345/auditer-parent-r2.py',
                '56212e7a56fa88e6041d80f1294f4426a78e1b9be31e861aedf6b6221e5ae53e')
for before, after in {'HPC-Forest-Primes-Natif-Relance-r2f': 'HPC-Forest-Primes-Natif-Relance-r2g',
    'hpc-forest-primes-natif-relance-r2f': 'hpc-forest-primes-natif-relance-r2g',
    'hpc-forest-primes-native-max-r2f': 'hpc-forest-primes-native-max-r2g',
    'HPC-Forest-Primes-Natif-MAX-r2f.zip': 'HPC-Forest-Primes-Natif-MAX-r2g.zip'}.items():
    receiver = receiver.replace(before, after)
receiver, count = re.subn(r'^BASE = .+$', 'BASE = Path(__file__).resolve().parents[3]', receiver, count=1, flags=re.MULTILINE)
if count != 1:
    raise ValueError('Exact unbound reader base anchor required')
for name in ('ROOT', 'SEALED', 'DELIVERY_PATH', 'BINDINGS_PATH', 'SOURCE_MEMBERS', 'DELTA_CASES', 'JOB_ID', 'EXPECTED_BYTES', 'EXPECTED_ARCHIVE'):
    receiver, count = re.subn(r'^' + name + r' = .+$', name + ' = None', receiver, count=1, flags=re.MULTILINE)
    if count != 1:
        raise ValueError('Missing exact unbound future receipt field: ' + name)
receiver = receiver.replace('if __name__ == "__main__":\n    main()',
    'if __name__ == "__main__":\n    raise SystemExit("Unbound R2g cold receiver: only future actual receipts may bind this template")')
save('auditer-reception-r2g-template.py', receiver)

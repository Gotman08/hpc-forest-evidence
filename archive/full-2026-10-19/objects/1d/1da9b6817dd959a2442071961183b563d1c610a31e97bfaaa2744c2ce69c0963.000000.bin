      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdio>\n#include <cstring>\n#include <limits>\n#include <memory>\n#include <vector>\n\n#ifdef _OPENMP\n#include <omp.h>\n#else\nstatic int omp_get_num_threads() { return 1; }\nstatic int omp_get_thread_num() { return 0; }\n#endif\n\nnamespace {\nconstexpr std::size_t block_bytes = 256u * 1024u;\n\nstruct InputChunk {\n    std::unique_ptr<unsigned char[]> bytes;\n    std::unique_ptr<int[]> values;\n    std::size_t byte_capacity = 0;\n    std::size_t value_capacity = 0;\n    std::size_t length = 0;\n    std::size_t count = 0;\n\n    void reserve_bytes(std::size_t needed) {\n        if (needed <= byte_capacity) return;\n        const std::size_t capacity = std::max(needed, byte_capacity * 2u);\n        std::unique_ptr<unsigned char[]> replacement(new unsigned char[capacity]);\n        if (length != 0) {\n            std::memcpy(replacement.get(), bytes.get(), length);\n        }\n        bytes.swap(replacement);\n        byte_capacity = capacity;\n    }\n\n    void convert() {\n        const std::size_t needed = length / 2u + 1u;\n        if (needed > value_capacity) {\n            values.reset(new int[needed]);\n            value_capacity = needed;\n        }\n        const unsigned char* p = bytes.get();\n        const unsigned char* const end = p + length;\n        std::size_t used = 0;\n        for (;;) {\n            while (*p <= 32u) ++p;\n            if (p >= end) break;\n            bool negative = false;\n            if (*p == '-' || *p == '+') {\n                negative = (*p == '-');\n                ++p;\n            }\n            unsigned int value = 0;\n            while (*p >= '0' && *p <= '9') {\n                value = value * 10u + static_cast<unsigned int>(*p - '0');\n                ++p;\n            }\n            values[used++] = static_cast<int>(negative\n                ? -static_cast<long long>(value)\n                : static_cast<long long>(value));\n        }\n        count = used;\n    }\n};\n\nbool read_chunk(InputChunk& chunk, bool& finished) {\n    chunk.length = 0;\n    chunk.reserve_bytes(block_bytes + 64u);\n    chunk.length = std::fread(chunk.bytes.get(), 1, block_bytes, stdin);\n    if (chunk.length == 0) {\n        finished = true;\n        return false;\n    }\n    if (std::feof(stdin) || std::ferror(stdin)) finished = true;\n    if (!finished && chunk.bytes[chunk.length - 1] > 32u) {\n        for (;;) {\n            const int c = std::getc(stdin);\n            if (c == EOF) {\n                finished = true;\n                break;\n            }\n            chunk.reserve_bytes(chunk.length + 2u);\n            chunk.bytes[chunk.length++] = static_cast<unsigned char>(c);\n            if (c <= 32) break;\n        }\n    }\n    chunk.reserve_bytes(chunk.length + 1u);\n    chunk.bytes[chunk.length] = 127;\n    return true;\n}\n}\n\nint main() {\n    int n, s;\n    if (std::scanf(\"%d%d\", &n, &s) != 2) return 0;\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t total = static_cast<std::size_t>(n) * n;\n    const int positions = n - s + 1;\n    std::unique_ptr<int[]> matrix(new int[total]);\n    bool complete = false;\n    long long answer = std::numeric_limits<long long>::lowest();\n\n    #pragma omp parallel if(total >= 262144u) reduction(max:answer)\n    {\n        #pragma omp single\n        {\n            const int workers = omp_get_num_threads();\n            std::vector<InputChunk> chunks(static_cast<std::size_t>(workers) * 2u);\n            std::size_t placed = 0;\n            bool finished = false;\n            while (placed < total && !finished) {\n                int active = 0;\n                for (int slot = 0; slot < static_cast<int>(chunks.size()); ++slot) {\n                    if (!read_chunk(chunks[slot], finished)) break;\n                    ++active;\n                    #pragma omp task firstprivate(slot) shared(chunks) if(workers > 1)\n                    {\n                        chunks[slot].convert();\n                    }\n                    if (finished) break;\n                }\n                #pragma omp taskwait\n                for (int slot = 0; slot < active && placed < total; ++slot) {\n                    const std::size_t take = std::min(chunks[slot].count, total - placed);\n                    if (take != 0) {\n                        std::memcpy(matrix.get() + placed, chunks[slot].values.get(),\n                                    take * sizeof(int));\n                        placed += take;\n                    }\n                }\n            }\n            complete = (placed == total);\n        }\n\n        if (complete) {\n            const int tid = omp_get_thread_num();\n            const int workers = omp_get_num_threads();\n            const int first = positions * tid / workers;\n            const int last = positions * (tid + 1) / workers;\n            if (first < last) {\n                std::vector<long long> columns(n, 0);\n                for (int row = first; row < first + s; ++row) {\n                    const int* const source = matrix.get() + static_cast<std::size_t>(row) * n;\n                    #pragma omp simd\n                    for (int col = 0; col < n; ++col) {\n                        columns[col] += source[col];\n                    }\n                }\n\n                long long local_best = std::numeric_limits<long long>::lowest();\n                for (int top = first; top < last; ++top) {\n                    if (top != first) {\n                        const int* const entering = matrix.get()\n                            + static_cast<std::size_t>(top + s - 1) * n;\n                        const int* const leaving = matrix.get()\n                            + static_cast<std::size_t>(top - 1) * n;\n                        #pragma omp simd\n                        for (int col = 0; col < n; ++col) {\n                            columns[col] += static_cast<long long>(entering[col])\n                                          - static_cast<long long>(leaving[col]);\n                        }\n                    }\n                    long long sum = 0;\n                    #pragma omp simd reduction(+:sum)\n                    for (int col = 0; col < s; ++col) sum += columns[col];\n                    long long row_best = sum;\n                    for (int col = s; col < n; ++col) {\n                        sum += columns[col] - columns[col - s];\n                        if (sum > row_best) row_best = sum;\n                    }\n                    if (row_best > local_best) local_best = row_best;\n                }\n                answer = local_best;\n            }\n        }\n    }\n\n    if (!complete) return 0;\n    std::printf(\"%lld\\n\", answer);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Bounded, token-aligned OpenMP parsing tasks should overlap input reads with integer conversion, while reusing the team for coarse rolling-sum row bands minimizes synchronization.",
  "notes": "No evaluation was run. Parsing does not depend on line layout. Runtime thread settings are respected, small matrices use a serialized team, and sums use 64-bit intermediates.",

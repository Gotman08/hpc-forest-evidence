        "content": "#include <stdio.h>\n#include <stdint.h>\n\n#define MAXNUM 100\n#define MAXRESULTS 1000\n#define SUFFIX_SCALE 10000000U\n#define DIVISOR_LIMIT 24514U\n\nunsigned int firstHalf[MAXNUM];\nunsigned int secondHalf[MAXNUM];\nlong int result[MAXRESULTS];\nint numPrimes=0;\n\nstatic uint16_t primeDivisors[DIVISOR_LIMIT / 2U + 1U];\nstatic unsigned int numDivisors;\n\nstatic void build_prime_divisors(void)\n{\n    unsigned char composite[DIVISOR_LIMIT / 2U + 1U] = {0};\n    unsigned int factor, multiple;\n\n    numDivisors = 0;\n    for (factor = 3U; factor <= DIVISOR_LIMIT; factor += 2U) {\n        if (composite[factor / 2U])\n            continue;\n        primeDivisors[numDivisors++] = (uint16_t)factor;\n        for (multiple = factor * factor;\n             multiple <= DIVISOR_LIMIT;\n             multiple += 2U * factor)\n            composite[multiple / 2U] = 1;\n    }\n}\n\nint isprime(unsigned int value)\n{\n    unsigned int i;\n\n    if (value < 2U)\n        return 0;\n    if ((value & 1U) == 0U)\n        return value == 2U;\n    for (i = 0; i < numDivisors; ++i) {\n        unsigned int factor = primeDivisors[i];\n        if ((uint64_t)factor * factor > value)\n            return 1;\n        if (value % factor == 0U)\n            return 0;\n    }\n    return 1;\n}\n\nvoid quicksort(long int *primes,int first,int last)\n{ int i, j, pivot;\n  long int temp;\n\n  if (first<last)\n     { pivot=first;\n       i=first;\n       j=last;\n       while(i<j)\n         { while (primes[i]<=primes[pivot]&&i<last)\n             i++;\n           while(primes[j]>primes[pivot])\n             j--;\n           if (i<j)\n              { temp=primes[i];\n                primes[i]=primes[j];\n                primes[j]=temp;\n              }\n         }\n       temp=primes[pivot];\n       primes[pivot]=primes[j];\n       primes[j]=temp;\n       quicksort(primes,first,j-1);\n       quicksort(primes,j+1,last);\n     }\n}\n\nint main(void)\n{\n    int i, j, numResults = 0;\n\n    if (scanf(\"%d\", &numPrimes) != 1)\n        return 0;\n    if (numPrimes < 1 || numPrimes > MAXNUM)\n        return 0;\n    for (i = 0; i < numPrimes; ++i) {\n        if (scanf(\"%u\", &firstHalf[i]) != 1)\n            return 0;\n        /* Preserve the certified seven-character suffix width. */\n        firstHalf[i] *= SUFFIX_SCALE;\n    }\n    for (i = 0; i < numPrimes; ++i) {\n        if (scanf(\"%u\", &secondHalf[i]) != 1)\n            return 0;\n    }\n\n    build_prime_divisors();\n    for (i = 0; i < numPrimes; ++i) {\n        unsigned int prefix = firstHalf[i];\n        for (j = 0; j < numPrimes; ++j) {\n            unsigned int primeToTest = prefix + secondHalf[j];\n            if (isprime(primeToTest))\n                result[numResults++] = (long int)primeToTest;\n        }\n    }\n    quicksort(result, 0, numResults - 1);\n    for (i = 0; i < numResults; ++i)\n        printf(\"%ld\\n\", result[i]);\n    return 0;\n}\n",

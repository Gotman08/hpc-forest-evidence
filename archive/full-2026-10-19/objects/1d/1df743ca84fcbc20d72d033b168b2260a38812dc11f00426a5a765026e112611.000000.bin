      "content": "#include \"knn.h\"\n#include <arm_neon.h>\n\n// Max-heap node structure\ntypedef struct {\n    float dist;\n    char label;\n} HeapNode;\n\nstatic inline void heap_swap(HeapNode *a, HeapNode *b) {\n    HeapNode t = *a; *a = *b; *b = t;\n}\n\nchar knn(int n_groups, Group * restrict groups, int k, Point to_evaluate) {\n    // Allocate labels array (initialized with -1 sentinel)\n    char *labels = (char *) malloc(sizeof(char) * k);\n    for (int i = 0; i < k; i++) labels[i] = -1;\n\n    // Max-heap of size k+1 (index 1..k)\n    HeapNode *heap = (HeapNode *) malloc(sizeof(HeapNode) * (k + 1));\n    int heap_size = 0;\n\n    float32x2_t tx = vdup_n_f32(to_evaluate.x);\n    float32x2_t ty = vdup_n_f32(to_evaluate.y);\n\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        Point *points = (Point *)__builtin_assume_aligned(g.points, 16);\n        int len = g.length;\n        char lbl = g.label;\n\n        // Process pairs using NEON\n        int j;\n        for (j = 0; j < len - 1; j += 2) {\n            __builtin_prefetch(&points[j + 8], 0, 3);\n\n            float32x2_t px_py[2];\n            vld2_f32((float *)&points[j], px_py);\n\n            float32x2_t dx = vsub_f32(px_py[0], tx);\n            float32x2_t dy = vsub_f32(px_py[1], ty);\n            float32x2_t dist_sq = vfma_f32(vmul_f32(dx, dx), dy, dy);\n\n            float d0 = vget_lane_f32(dist_sq, 0);\n            float d1 = vget_lane_f32(dist_sq, 1);\n\n            // Process first point of the pair\n            if (heap_size < k) {\n                heap_size++;\n                int idx = heap_size;\n                heap[idx].dist = d0;\n                heap[idx].label = lbl;\n                while (idx > 1 && heap[idx/2].dist < heap[idx].dist) {\n                    heap_swap(&heap[idx], &heap[idx/2]);\n                    idx /= 2;\n                }\n            } else if (d0 < heap[1].dist) {\n                heap[1].dist = d0;\n                heap[1].label = lbl;\n                int idx = 1;\n                while (1) {\n                    int largest = idx;\n                    int left = 2 * idx;\n                    int right = 2 * idx + 1;\n                    if (left <= heap_size && heap[left].dist > heap[largest].dist)\n                        largest = left;\n                    if (right <= heap_size && heap[right].dist > heap[largest].dist)\n                        largest = right;\n                    if (largest != idx) {\n                        heap_swap(&heap[idx], &heap[largest]);\n                        idx = largest;\n                    } else break;\n                }\n            }\n\n            // Process second point of the pair\n            if (heap_size < k) {\n                heap_size++;\n                int idx = heap_size;\n                heap[idx].dist = d1;\n                heap[idx].label = lbl;\n                while (idx > 1 && heap[idx/2].dist < heap[idx].dist) {\n                    heap_swap(&heap[idx], &heap[idx/2]);\n                    idx /= 2;\n                }\n            } else if (d1 < heap[1].dist) {\n                heap[1].dist = d1;\n                heap[1].label = lbl;\n                int idx = 1;\n                while (1) {\n                    int largest = idx;\n                    int left = 2 * idx;\n                    int right = 2 * idx + 1;\n                    if (left <= heap_size && heap[left].dist > heap[largest].dist)\n                        largest = left;\n                    if (right <= heap_size && heap[right].dist > heap[largest].dist)\n                        largest = right;\n                    if (largest != idx) {\n                        heap_swap(&heap[idx], &heap[largest]);\n                        idx = largest;\n                    } else break;\n                }\n            }\n        }\n\n        // Handle remaining odd point with scalar fallback\n        if (j < len) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, points[j]);\n            if (heap_size < k) {\n                heap_size++;\n                int idx = heap_size;\n                heap[idx].dist = d;\n                heap[idx].label = lbl;\n                while (idx > 1 && heap[idx/2].dist < heap[idx].dist) {\n                    heap_swap(&heap[idx], &heap[idx/2]);\n                    idx /= 2;\n                }\n            } else if (d < heap[1].dist) {\n                heap[1].dist = d;\n                heap[1].label = lbl;\n                int idx = 1;\n                while (1) {\n                    int largest = idx;\n                    int left = 2 * idx;\n                    int right = 2 * idx + 1;\n                    if (left <= heap_size && heap[left].dist > heap[largest].dist)\n                        largest = left;\n                    if (right <= heap_size && heap[right].dist > heap[largest].dist)\n                        largest = right;\n                    if (largest != idx) {\n                        heap_swap(&heap[idx], &heap[largest]);\n                        idx = largest;\n                    } else break;\n                }\n            }\n        }\n    }\n\n    // Copy labels from heap into labels array\n    for (int i = 0; i < heap_size && i < k; i++) {\n        labels[i] = heap[i+1].label;\n    }\n\n    free(heap);\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(labels);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    },
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n\n    // Allocate points with 16-byte alignment for NEON loads\n    void *ptr;\n    if (posix_memalign(&ptr, 16, sizeof(Point) * length) != 0) on_error();\n    group.points = (Point *) ptr;\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nstatic inline float euclidean_distance_no_sqrt(Point a, Point b) {\n    return ((b.x - a.x) * (b.x - a.x)) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}\n",
      "path": "src/knn.h"
    }
  ],
  "hypothesis": "Using ARM NEON SIMD intrinsics to compute squared Euclidean distances for pairs of points simultaneously, combined with aligned memory allocation via posix_memalign, pointer restrict qualifiers, and data prefetching, reduces instruction count and memory latency in the distance computation loop. This enables legal SIMD/vectorization without altering the heap-based top-k selection logic.",

"""Hash only actual R2e launch artifacts; never starts processes or transports."""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
FACTORY = HERE.parent
BASE = FACTORY.parents[2]
OPS = BASE / 'outputs/HPC-Forest-Primes-Natif-Relance-r2g/operations-parent'
HISTORY = BASE / 'outputs/HPC-Forest-Primes-Natif-Relance-r2d/operations-parent-attempt2/BILAN-R2D-TERMINAL-METADATA.json'
MODELS = {'gpt-6-astra': 'astra-max', 'gpt-5.6-terra': 'terra-max', 'gpt-6.1-sol': 'sol-max'}


def ref(path):
    path = path.absolute()
    if (not path.is_file() or '..' in path.parts
            or any(p.is_symlink() or getattr(p, 'is_junction', lambda: False)() for p in (path, *path.parents))):
        raise ValueError('Actual ordinary evidence file required')
    return {'path': str(path), 'sha256': hashlib.sha256(path.read_bytes()).hexdigest()}


def build(readbacks, bindings, review):
    return {'schema': 'hpc-forest-r2e-owned-worker-launch-input-v1',
        'source_bindings': ref(bindings), 'factory_review': ref(review),
        'historical_r2d_closure': ref(HISTORY), 'publication_readbacks': ref(readbacks),
        'ready_upload_results': {model: ref(OPS / slug / 'ready-upload-result.json') for model, slug in MODELS.items()},
        'worker_argv': {model: ref(FACTORY / ('admissions-' + slug + '-reelles') / 'worker-argv-only.json')
                        for model, slug in MODELS.items()}}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for flag in ('readbacks', 'bindings', 'factory-review'):
        parser.add_argument('--' + flag, type=Path, required=True)
    parser.add_argument('--output-name', required=True)
    args = parser.parse_args()
    if not args.output_name.isidentifier():
        raise ValueError('Simple new output name required')
    value = build(args.readbacks, args.bindings, args.factory_review)
    output = HERE / (args.output_name + '.json')
    with output.open('x', encoding='utf8') as stream:
        json.dump(value, stream, indent=2)
    print(json.dumps({'input': ref(output), 'processes_started': 0, 'native_calls': 0}))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

{"files":[{"content":"#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <utility>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nlong long modPow(long long base, long long exponent) {\n    long long result = 1;\n    while (exponent > 0) {\n        if (exponent & 1LL) result = result * base % MOD;\n        base = base * base % MOD;\n        exponent >>= 1LL;\n    }\n    return result;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<pair<int, int>> blocked;\n    blocked.reserve(static_cast<size_t>(m));\n    bool blockedStart = false;\n    bool blockedDestination = false;\n    for (int i = 0; i < m; ++i) {\n        int row, column;\n        cin >> row >> column;\n        blocked.emplace_back(row + column, row);\n        blockedStart = blockedStart || (row == 0 && column == 0);\n        blockedDestination = blockedDestination || (row == n - 1 && column == n - 1);\n    }\n\n    if (blockedStart || blockedDestination) {\n        cout << 0 << '\\n';\n        return 0;\n    }\n\n    sort(blocked.begin(), blocked.end());\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\n\n    const size_t sparseLimit = max<size_t>(1, static_cast<size_t>(n) / 8);\n    if (blocked.size() <= sparseLimit) {\n        const int maxSteps = 2 * n - 2;\n        vector<long long> factorial(maxSteps + 1, 1);\n        vector<long long> inverseFactorial(maxSteps + 1, 1);\n        for (int i = 1; i <= maxSteps; ++i) {\n            factorial[i] = factorial[i - 1] * i % MOD;\n        }\n        inverseFactorial[maxSteps] = modPow(factorial[maxSteps], MOD - 2);\n        for (int i = maxSteps; i > 0; --i) {\n            inverseFactorial[i - 1] = inverseFactorial[i] * i % MOD;\n        }\n\n        const auto choose = [&factorial, &inverseFactorial](int total, int selected) {\n            return factorial[total] * inverseFactorial[selected] % MOD *\n                   inverseFactorial[total - selected] % MOD;\n        };\n\n        vector<long long> ways(blocked.size(), 0);\n        for (size_t i = 0; i < blocked.size(); ++i) {\n            const int row = blocked[i].second;\n            const int column = blocked[i].first - row;\n            long long count = choose(row + column, row);\n            for (size_t j = 0; j < i; ++j) {\n                const int previousRow = blocked[j].second;\n                const int previousColumn = blocked[j].first - previousRow;\n                if (previousRow <= row && previousColumn <= column) {\n                    const int rowDelta = row - previousRow;\n                    const int columnDelta = column - previousColumn;\n                    const long long throughPrevious =\n                        ways[j] * choose(rowDelta + columnDelta, rowDelta) % MOD;\n                    count -= throughPrevious;\n                    if (count < 0) count += MOD;\n                }\n            }\n            ways[i] = count;\n        }\n\n        const int destination = n - 1;\n        long long answer = choose(2 * destination, destination);\n        for (size_t i = 0; i < blocked.size(); ++i) {\n            const int rowDelta = destination - blocked[i].second;\n            const int columnDelta = destination - (blocked[i].first - blocked[i].second);\n            const long long throughObstacle =\n                ways[i] * choose(rowDelta + columnDelta, rowDelta) % MOD;\n            answer -= throughObstacle;\n            if (answer < 0) answer += MOD;\n        }\n        cout << answer << '\\n';\n        return 0;\n    }\n\n    vector<int> previous(n, 0);\n    vector<int> current(n, 0);\n    size_t blockedIndex = 0;\n\n    auto updateFreeRange = [&](int begin, int end, int diagonal) {\n        if (begin < end && begin == 0) {\n            current[0] = previous[0];\n            ++begin;\n        }\n\n        const int vectorBegin = max(begin, 1);\n        const int vectorEnd = min(end, diagonal);\n        #pragma GCC ivdep\n        for (int row = vectorBegin; row < vectorEnd; ++row) {\n            int sum = previous[row] + previous[row - 1];\n            if (sum >= MOD) sum -= MOD;\n            current[row] = sum;\n        }\n\n        if (diagonal < n && begin <= diagonal && diagonal < end) {\n            current[diagonal] = previous[diagonal - 1];\n        }\n    };\n\n    for (int diagonal = 0; diagonal <= 2 * n - 2; ++diagonal) {\n        while (blockedIndex < blocked.size() && blocked[blockedIndex].first < diagonal) {\n            ++blockedIndex;\n        }\n\n        if (diagonal == 0) {\n            current[0] = 1;\n            previous.swap(current);\n            continue;\n        }\n\n        const int lowRow = max(0, diagonal - (n - 1));\n        const int highRow = min(n - 1, diagonal);\n        int rowCursor = lowRow;\n\n        while (blockedIndex < blocked.size() && blocked[blockedIndex].first == diagonal) {\n            const int blockedRow = blocked[blockedIndex].second;\n            updateFreeRange(rowCursor, blockedRow, diagonal);\n            current[blockedRow] = 0;\n            rowCursor = blockedRow + 1;\n            ++blockedIndex;\n        }\n        updateFreeRange(rowCursor, highRow + 1, diagonal);\n        previous.swap(current);\n    }\n\n    cout << previous[n - 1] << '\\n';\n    return 0;\n}\n","path":"src/solution.cpp"}],"hypothesis":"For small distinct obstacle sets, binomial inclusion-exclusion avoids traversing the full grid; for larger sets, the measured anti-diagonal recurrence remains the fallback. A conservative O(N) obstacle cutoff keeps the pairwise work bounded relative to the dense recurrence.","notes":"Combines archived sparse-obstacle and anti-diagonal approaches in one complete program. Correctness and performance are left to the controller evaluation.","research":{"queries":[],"urls":[]},"sources_kept":["cc89b91269e643f5","1f9c4d8571df43cb"],"transformations":["Sort and deduplicate obstacles by diagonal and row; use binomial path counts with inclusion-exclusion when the distinct obstacle count is at most max(1, N/8).","For larger obstacle sets, use a two-buffer anti-diagonal recurrence over contiguous free spans, with GCC ivdep on the dependency-free interior.","Handle blocked endpoints explicitly and retain O(N) DP storage in the dense fallback."]}
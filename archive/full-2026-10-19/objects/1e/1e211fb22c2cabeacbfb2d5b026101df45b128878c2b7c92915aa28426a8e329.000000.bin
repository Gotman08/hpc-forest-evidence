        "content": "#include <iostream>\n#include <vector>\n#include <utility>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nusing namespace std;\n\nstruct adjacency_matrix {\n    size_t vertices;\n    size_t stride;\n    vector<unsigned char> entries;\n\n    explicit adjacency_matrix(size_t count)\n        : vertices(count), stride(((count + 15) / 16) * 16),\n          entries(count * stride, 0) {}\n\n    size_t size() const { return vertices; }\n\n    unsigned char *row(size_t index) {\n        return entries.data() + index * stride;\n    }\n\n    const unsigned char *row(size_t index) const {\n        return entries.data() + index * stride;\n    }\n};\n\nadjacency_matrix readGraph();\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2);\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<unsigned char> &equivalence);\ninline void printPermutation(const vector<unsigned char> &equivalence, size_t vertices);\n\nint main() {\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if (!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2) {\n    // Valid vertex indices fit in a byte. Padding supplies inactive SIMD lanes.\n    vector<unsigned char> equivalence(g1.size() + 16, 255);\n    vector<int> exchange_counter(g1.size(), 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    if (g1.size() != g2.size()) return false;\n\n    for (size_t i = 0; i < g1.size(); ++i)\n        equivalence[i] = static_cast<unsigned char>(i);\n\n    if (verifyPermutation(g1, g2, equivalence)) {\n        printPermutation(equivalence, g1.size());\n        return true;\n    }\n\n    /*\n     * Permutations are based on Heap's algorithm, which generates all possible\n     * permutations for a given set of elements.\n     */\n    while (exchange_index < g1.size()) {\n        if (exchange_counter[exchange_index] < exchange_index) {\n            if (exchange_index % 2 == 0)\n                swap(equivalence[0], equivalence[exchange_index]);\n            else\n                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\n\n            if (verifyPermutation(g1, g2, equivalence)) {\n                printPermutation(equivalence, g1.size());\n                isomorphism_found = true;\n            }\n\n            exchange_counter[exchange_index]++;\n            exchange_index = 1;\n        } else {\n            exchange_counter[exchange_index] = 0;\n            exchange_index++;\n        }\n    }\n    return isomorphism_found;\n}\n\nadjacency_matrix readGraph() {\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix graph(static_cast<size_t>(vertices));\n\n    cin >> edges;\n    for (int i = 0; i < edges; ++i) {\n        cin >> source >> destination;\n        graph.row(source)[destination] = 1;\n        graph.row(destination)[source] = 1;\n    }\n\n    return graph;\n}\n\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<unsigned char> &equivalence) {\n    const size_t vertices = g1.size();\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    if (vertices <= 16) {\n        const uint8x16_t permutation = vld1q_u8(equivalence.data());\n        for (size_t i = 0; i < vertices; ++i) {\n            const uint8x16_t expected = vld1q_u8(g1.row(i));\n            const uint8x16_t source = vld1q_u8(g2.row(equivalence[i]));\n            const uint8x16_t actual = vqtbl1q_u8(source, permutation);\n            // Index 255 produces zero, matching every padded graph byte.\n            if (vmaxvq_u8(veorq_u8(expected, actual)) != 0)\n                return false;\n        }\n        return true;\n    }\n#endif\n\n    for (size_t i = 0; i < vertices; ++i) {\n        const unsigned char *row1 = g1.row(i);\n        const unsigned char *row2 = g2.row(equivalence[i]);\n        for (size_t j = 0; j <= i; ++j) {\n            if (row1[j] != row2[equivalence[j]]) return false;\n        }\n    }\n    return true;\n}\n\ninline void printPermutation(const vector<unsigned char> &equivalence, size_t vertices) {\n    for (size_t i = 0; i < vertices; ++i)\n        cout << static_cast<unsigned int>(equivalence[i]) << \" \";\n    cout << endl;\n}\n",
        "path": "src/brute_isomorphism.cpp"
      }

#include <algorithm>
#include <cstring>
#include <iostream>
#include <vector>

using namespace std;

constexpr int MOD = 1000000007;

using UInt4 = unsigned int __attribute__((vector_size(16)));
static const UInt4 mod4 = {MOD, MOD, MOD, MOD};
static const UInt4 zero4 = {0, 0, 0, 0};
static const UInt4 shift_one = {0, 4, 5, 6};
static const UInt4 shift_two = {0, 0, 4, 5};

static inline int addmod(int a, int b) {
    const int sum = a + b;
    return sum >= MOD ? sum - MOD : sum;
}

static inline UInt4 addmod4(UInt4 a, UInt4 b) {
    const UInt4 sum = a + b;
    return sum - ((sum >= mod4) & mod4);
}

// Applies the horizontal prefix recurrence over a run containing no blocked cells.
static inline int process_clear_run(vector<int>& dp, int first, int last, int carry) {
    int j = first;

    // A four-lane inclusive scan has two independent butterfly stages.  Each
    // stage is reduced modulo MOD before the next one, so every lane remains
    // in the range required by addmod4.
    for (; j + 4 <= last; j += 4) {
        UInt4 values;
        memcpy(&values, dp.data() + j, sizeof(values));

        UInt4 prefixes = addmod4(
            values, __builtin_shuffle(zero4, values, shift_one));
        prefixes = addmod4(
            prefixes, __builtin_shuffle(zero4, prefixes, shift_two));

        const UInt4 carries = {
            static_cast<unsigned int>(carry),
            static_cast<unsigned int>(carry),
            static_cast<unsigned int>(carry),
            static_cast<unsigned int>(carry)
        };
        prefixes = addmod4(prefixes, carries);
        memcpy(dp.data() + j, &prefixes, sizeof(prefixes));
        carry = static_cast<int>(prefixes[3]);
    }

    for (; j < last; ++j) {
        carry = addmod(dp[j], carry);
        dp[j] = carry;
    }
    return carry;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    cin >> n >> m;

    // Keeping only obstacle coordinates avoids an n-by-n bitmap while also
    // making each obstacle split a row into independent prefix-scan runs.
    vector<vector<int>> blocked(n);
    for (int k = 0; k < m; ++k) {
        int y, x;
        cin >> y >> x;
        blocked[y].push_back(x);
    }
    for (vector<int>& row : blocked) {
        sort(row.begin(), row.end());
        row.erase(unique(row.begin(), row.end()), row.end());
    }

    vector<int> dp(n, 0);
    dp[0] = 1;

    for (int y = 0; y < n; ++y) {
        int carry = 0;
        int first = 0;
        for (const int x : blocked[y]) {
            carry = process_clear_run(dp, first, x, carry);
            dp[x] = 0;
            carry = 0;
            first = x + 1;
        }
        process_clear_run(dp, first, n, carry);
    }

    cout << dp[n - 1] << '\n';
}

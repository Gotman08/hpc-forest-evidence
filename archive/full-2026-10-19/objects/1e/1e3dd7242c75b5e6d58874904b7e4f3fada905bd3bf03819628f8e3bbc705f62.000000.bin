        "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nstatic constexpr int MOD = 1000000007;\n\nstruct Point {\n    int x;\n    int y;\n};\n\nstatic long long modPow(long long base, int exponent) {\n    long long result = 1;\n    while (exponent > 0) {\n        if (exponent & 1) result = result * base % MOD;\n        base = base * base % MOD;\n        exponent >>= 1;\n    }\n    return result;\n}\n\nstatic int choose(int total, int left, const vector<int>& fact,\n                  const vector<int>& invFact) {\n    if (left < 0 || left > total) return 0;\n    long long result = fact[total];\n    result = result * invFact[left] % MOD;\n    result = result * invFact[total - left] % MOD;\n    return static_cast<int>(result);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<Point> blocked;\n    blocked.reserve(static_cast<size_t>(m));\n    bool blockedStart = false;\n    bool blockedEnd = false;\n\n    for (int i = 0; i < m; ++i) {\n        int y, x;\n        cin >> y >> x;\n        blocked.push_back({x, y});\n        if (x == 0 && y == 0) blockedStart = true;\n        if (x == n - 1 && y == n - 1) blockedEnd = true;\n    }\n\n    if (blockedStart || blockedEnd) {\n        cout << 0 << '\\n';\n        return 0;\n    }\n\n    sort(blocked.begin(), blocked.end(), [](const Point& a, const Point& b) {\n        const int da = a.x + a.y;\n        const int db = b.x + b.y;\n        if (da != db) return da < db;\n        if (a.x != b.x) return a.x < b.x;\n        return a.y < b.y;\n    });\n    blocked.erase(unique(blocked.begin(), blocked.end(),\n                         [](const Point& a, const Point& b) {\n                             return a.x == b.x && a.y == b.y;\n                         }),\n                  blocked.end());\n\n    if (blocked.size() >= static_cast<size_t>(n)) {\n        sort(blocked.begin(), blocked.end(), [](const Point& a, const Point& b) {\n            if (a.y != b.y) return a.y < b.y;\n            return a.x < b.x;\n        });\n\n        vector<int> dp(n, 0);\n        dp[0] = 1;\n        size_t obstacle = 0;\n\n        for (int y = 0; y < n; ++y) {\n            int running = 0;\n            int x = 0;\n\n            while (obstacle < blocked.size() && blocked[obstacle].y == y) {\n                const int blockedX = blocked[obstacle].x;\n                while (x < blockedX) {\n                    int value = running + dp[x];\n                    if (value >= MOD) value -= MOD;\n                    running = value;\n                    dp[x] = running;\n                    ++x;\n                }\n                dp[blockedX] = 0;\n                running = 0;\n                x = blockedX + 1;\n                ++obstacle;\n            }\n\n            while (x < n) {\n                int value = running + dp[x];\n                if (value >= MOD) value -= MOD;\n                running = value;\n                dp[x] = running;\n                ++x;\n            }\n        }\n\n        cout << dp[n - 1] << '\\n';\n        return 0;\n    }\n\n    const int maxDistance = 2 * n - 2;\n    vector<int> fact(maxDistance + 1, 1);\n    vector<int> invFact(maxDistance + 1, 1);\n    for (int i = 1; i <= maxDistance; ++i) {\n        fact[i] = static_cast<long long>(fact[i - 1]) * i % MOD;\n    }\n    invFact[maxDistance] = static_cast<int>(modPow(fact[maxDistance], MOD - 2));\n    for (int i = maxDistance; i > 0; --i) {\n        invFact[i - 1] = static_cast<long long>(invFact[i]) * i % MOD;\n    }\n\n    vector<int> ways(blocked.size(), 0);\n    for (size_t i = 0; i < blocked.size(); ++i) {\n        const Point& target = blocked[i];\n        long long count = choose(target.x + target.y, target.x, fact, invFact);\n\n        for (size_t j = i; j > 0;) {\n            --j;\n            const Point& previous = blocked[j];\n            if (previous.x <= target.x && previous.y <= target.y) {\n                const int dx = target.x - previous.x;\n                const int dy = target.y - previous.y;\n                const int between = choose(dx + dy, dx, fact, invFact);\n                count -= static_cast<long long>(ways[j]) * between % MOD;\n                if (count < 0) count += MOD;\n            }\n        }\n        ways[i] = static_cast<int>(count);\n    }\n\n    const int destination = n - 1;\n    long long answer = choose(2 * destination, destination, fact, invFact);\n    for (size_t j = blocked.size(); j > 0;) {\n        --j;\n        const Point& previous = blocked[j];\n        const int dx = destination - previous.x;\n        const int dy = destination - previous.y;\n        const int between = choose(dx + dy, dx, fact, invFact);\n        answer -= static_cast<long long>(ways[j]) * between % MOD;\n        if (answer < 0) answer += MOD;\n    }\n\n    cout << answer << '\\n';\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }

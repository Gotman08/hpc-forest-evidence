{"files":[{"content":"#include \"knn.h\"\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\ntypedef struct {\n    size_t order;\n    float distance;\n    char label;\n} KnnNeighbor;\n\nstatic int knn_worse(KnnNeighbor a, KnnNeighbor b) {\n    return a.distance > b.distance ||\n           (a.distance == b.distance && a.order > b.order);\n}\n\nstatic void knn_sift_down(KnnNeighbor *heap, size_t count,\n                          size_t root, KnnNeighbor value) {\n    size_t child = root * 2 + 1;\n    while (child < count) {\n        if (child + 1 < count && knn_worse(heap[child + 1], heap[child])) {\n            child++;\n        }\n        if (!knn_worse(heap[child], value)) {\n            break;\n        }\n        heap[root] = heap[child];\n        root = child;\n        child = root * 2 + 1;\n    }\n    heap[root] = value;\n}\n\nstatic void knn_heapify(KnnNeighbor *heap, size_t count) {\n    for (size_t i = count / 2; i > 0; i--) {\n        knn_sift_down(heap, count, i - 1, heap[i - 1]);\n    }\n}\n\nstatic char knn_vote(char *labels, int k) {\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n    return most_frequent;\n}\n\nstatic char knn_serial(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *) malloc(sizeof(char) * k);\n    float *distances = (float *) malloc(sizeof(float) * k);\n\n    for (int i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (int x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (int y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    char result = knn_vote(labels, k);\n    free(distances);\n    free(labels);\n    return result;\n}\n\nstatic int knn_select_range(int n_groups, const Group *groups,\n                            Point to_evaluate, size_t begin, size_t end,\n                            KnnNeighbor *heap, size_t capacity) {\n    size_t used = 0;\n    size_t base = 0;\n    int saw_nan = 0;\n    int needs_heap = capacity < end - begin;\n\n    for (int i = 0; i < n_groups && base < end; i++) {\n        const Group *g = &groups[i];\n        if (g->length <= 0) {\n            continue;\n        }\n        size_t length = (size_t) g->length;\n        size_t group_end = base + length;\n\n        if (group_end > begin) {\n            size_t first = begin > base ? begin - base : 0;\n            size_t last = end < group_end ? end - base : length;\n            for (size_t j = first; j < last; j++) {\n                float d = euclidean_distance_no_sqrt(to_evaluate, g->points[j]);\n                if (d != d) {\n                    saw_nan = 1;\n                    continue;\n                }\n\n                KnnNeighbor value = {base + j, d, g->label};\n                if (used < capacity) {\n                    heap[used++] = value;\n                    if (used == capacity && needs_heap) {\n                        knn_heapify(heap, used);\n                    }\n                } else if (d < heap[0].distance) {\n                    /* Equal-distance arrivals are later in input order. */\n                    knn_sift_down(heap, capacity, 0, value);\n                }\n            }\n        }\n        base = group_end;\n    }\n    return saw_nan;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) {\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t total = 0;\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length > 0) {\n            size_t length = (size_t) groups[i].length;\n            if (length > ((size_t) -1) - total) {\n                return knn_serial(n_groups, groups, k, to_evaluate);\n            }\n            total += length;\n        }\n    }\n\n    size_t k_size = (size_t) k;\n    char *labels = (char *) malloc(k_size * sizeof(char));\n    if (labels == NULL) {\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    if (k_size >= total) {\n        size_t used = 0;\n        for (int i = 0; i < n_groups; i++) {\n            for (int j = 0; j < groups[i].length; j++) {\n                labels[used++] = groups[i].label;\n            }\n        }\n        while (used < k_size) {\n            labels[used++] = (char) -1;\n        }\n        char result = knn_vote(labels, k);\n        free(labels);\n        return result;\n    }\n\n    int workers = 1;\n#ifdef _OPENMP\n    workers = omp_get_max_threads();\n    if (workers < 1) {\n        workers = 1;\n    }\n    size_t useful_workers = total / 16384;\n    if (useful_workers < 1) {\n        useful_workers = 1;\n    }\n    if ((size_t) workers > useful_workers) {\n        workers = (int) useful_workers;\n    }\n#endif\n\n    size_t work_count = total;\n    if (k_size <= total / (size_t) workers) {\n        work_count = k_size * (size_t) workers;\n    }\n    if (work_count > ((size_t) -1) / sizeof(KnnNeighbor)) {\n        free(labels);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    KnnNeighbor *work = (KnnNeighbor *) malloc(work_count * sizeof(KnnNeighbor));\n    if (work == NULL) {\n        free(labels);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t split = total / (size_t) workers;\n    size_t remainder = total % (size_t) workers;\n    int saw_nan = 0;\n\n#ifdef _OPENMP\n#pragma omp parallel for schedule(static) num_threads(workers) if(workers > 1) reduction(|:saw_nan)\n#endif\n    for (int part = 0; part < workers; part++) {\n        size_t p = (size_t) part;\n        size_t begin = p * split + (p < remainder ? p : remainder);\n        size_t span = split + (p < remainder ? 1 : 0);\n        size_t capacity = span < k_size ? span : k_size;\n        size_t offset = k_size <= split ? p * k_size : begin;\n        saw_nan |= knn_select_range(n_groups, groups, to_evaluate,\n                                    begin, begin + span, work + offset, capacity);\n    }\n\n    if (saw_nan) {\n        free(work);\n        free(labels);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    if (work_count > k_size) {\n        knn_heapify(work, k_size);\n        for (size_t i = k_size; i < work_count; i++) {\n            KnnNeighbor value = work[i];\n            if (knn_worse(work[0], value)) {\n                knn_sift_down(work, k_size, 0, value);\n            }\n        }\n    }\n\n    for (size_t i = 0; i < k_size; i++) {\n        labels[i] = work[i].label;\n    }\n    free(work);\n    char result = knn_vote(labels, k);\n    free(labels);\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n","path":"src/knn.c"}],"hypothesis":"Coarse, point-balanced OpenMP heap reductions reduce neighbor-selection work and synchronization while preserving deterministic input-order distance ties.","notes":"OpenMP is conditional on _OPENMP; parsing and label voting remain unchanged. No commands or evaluations were run.","sources_kept":[],"transformations":["Statically schedule equal-point ranges with a minimum grain of 16384 points per worker.","Replace local sorted insertion with bounded max-heaps and merge retained candidates in place using distance and original point index.","Preserve serial insertion semantics for NaN distances and release per-call scratch allocations.","Skip distance selection when every point is included, preserving sentinel labels when k exceeds the point count."]}
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Compact, naturally aligned state records should improve ARM64 cache density and avoid misaligned pointer accesses without changing search behavior.",
        "id": "d7492dd9785c4970",
        "ordinal": 1,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/sokoban.c"
          ],
          "retained": [
            "Place state pointers before the hash, moving the flexible coordinate array into previously wasted padding.",
            "Compute arena strides from offsetof(state_t, c), retain at least sizeof(state_t), and round up to _Alignof(state_t) rather than sizeof(int)."
          ]
        },

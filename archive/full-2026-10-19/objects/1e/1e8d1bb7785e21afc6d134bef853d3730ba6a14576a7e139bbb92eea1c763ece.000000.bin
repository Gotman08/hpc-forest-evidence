{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n#include <limits.h>\\n#include <stdint.h>\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\nstatic char knn_reference(int n_groups, Group *groups, int k, Point to_evaluate) {\\n    char *labels = (char *)malloc(sizeof(char) * k);\\n    float *distances = (float *)malloc(sizeof(float) * k);\\n    int i, j, x, y;\\n\\n    for (i = 0; i < k; i++) {\\n        labels[i] = -1;\\n        distances[i] = -1;\\n    }\\n\\n    for (i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n        for (j = 0; j < g.length; j++) {\\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n            for (x = 0; x < k; x++) {\\n                if (d < distances[x] || distances[x] == -1) {\\n                    for (y = k - 1; y > x; y--) {\\n                        distances[y] = distances[y - 1];\\n                        labels[y] = labels[y - 1];\\n                    }\\n                    distances[x] = d;\\n                    labels[x] = g.label;\\n                    break;\\n                }\\n            }\\n        }\\n    }\\n\\n    qsort(labels, k, sizeof(char), compare_for_sort);\\n    char most_frequent = labels[0];\\n    int most_frequent_count = 1;\\n    int current_frequency = 1;\\n\\n    for (i = 1; i < k; i++) {\\n        if (labels[i] != labels[i - 1]) {\\n            if (current_frequency > most_frequent_count) {\\n                most_frequent = labels[i - 1];\\n                most_frequent_count = current_frequency;\\n            }\\n            current_frequency = 1;\\n        } else {\\n            current_frequency++;\\n        }\\n        if (i == k - 1 && current_frequency > most_frequent_count) {\\n            most_frequent = labels[i - 1];\\n            most_frequent_count = current_frequency;\\n        }\\n    }\\n\\n    free(distances);\\n    free(labels);\\n    return most_frequent;\\n}\\n\\ntypedef struct {\\n    size_t order;\\n    float distance;\\n    char label;\\n} KnnCandidate;\\n\\ntypedef struct {\\n    KnnCandidate *heap;\\n    size_t begin;\\n    size_t end;\\n    size_t capacity;\\n    size_t used;\\n    int unordered;\\n} KnnWork;\\n\\n/* The root is the least desirable retained candidate. */\\nstatic inline int knn_worse(KnnCandidate a, KnnCandidate b, int nearest) {\\n    if (a.distance < b.distance) return !nearest;\\n    if (a.distance > b.distance) return nearest;\\n    return nearest ? a.order > b.order : a.order < b.order;\\n}\\n\\nstatic inline void knn_heap_down(KnnCandidate *heap, size_t count,\\n                                 size_t position, KnnCandidate value,\\n                                 int nearest) {\\n    while (position < count / 2) {\\n        size_t child = position * 2 + 1;\\n        if (child + 1 < count &&\\n            knn_worse(heap[child + 1], heap[child], nearest)) {\\n            child++;\\n        }\\n        if (!knn_worse(heap[child], value, nearest)) break;\\n        heap[position] = heap[child];\\n        position = child;\\n    }\\n    heap[position] = value;\\n}\\n\\nstatic inline void knn_heap_offer(KnnCandidate *heap, size_t capacity,\\n                                  size_t *used, KnnCandidate value,\\n                                  int nearest) {\\n    if (*used < capacity) {\\n        heap[(*used)++] = value;\\n        if (*used == capacity) {\\n            for (size_t i = capacity / 2; i > 0; i--) {\\n                KnnCandidate root = heap[i - 1];\\n                knn_heap_down(heap, capacity, i - 1, root, nearest);\\n            }\\n        }\\n    } else if (knn_worse(heap[0], value, nearest)) {\\n        knn_heap_down(heap, capacity, 0, value, nearest);\\n    }\\n}\\n\\nstatic void knn_process_range(KnnWork *work, int n_groups, Group *groups,\\n                              Point to_evaluate, int nearest) {\\n    size_t used = 0;\\n    size_t offset = 0;\\n    int unordered = 0;\\n\\n    for (int g = 0; g < n_groups && offset < work->end; g++) {\\n        size_t length = groups[g].length > 0 ? (size_t)groups[g].length : 0;\\n        size_t group_end = offset + length;\\n        if (group_end > work->begin) {\\n            size_t first = work->begin > offset ? work->begin - offset : 0;\\n            size_t last = work->end < group_end ? work->end - offset : length;\\n            for (size_t j = first; j < last; j++) {\\n                float d = euclidean_distance_no_sqrt(to_evaluate, groups[g].points[j]);\\n                if (d != d) {\\n                    unordered = 1;\\n                    continue;\\n                }\\n                KnnCandidate value;\\n                value.order = offset + j;\\n                value.distance = d;\\n                value.label = groups[g].label;\\n                knn_heap_offer(work->heap, work->capacity, &used, value, nearest);\\n            }\\n        }\\n        offset = group_end;\\n    }\\n\\n    work->used = used;\\n    work->unordered = unordered;\\n}\\n\\nstatic char knn_vote(const size_t *votes) {\\n    char winner = (char)CHAR_MIN;\\n    size_t best = 0;\\n    for (int label = CHAR_MIN; label <= CHAR_MAX; label++) {\\n        size_t count = votes[(unsigned char)(char)label];\\n        if (count > best) {\\n            best = count;\\n            winner = (char)label;\\n        }\\n    }\\n    return winner;\\n}\\n\\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n    if (k <= 0) return knn_reference(n_groups, groups, k, to_evaluate);\\n\\n    size_t total = 0;\\n    size_t votes[UCHAR_MAX + 1] = {0};\\n    for (int g = 0; g < n_groups; g++) {\\n        size_t length = groups[g].length > 0 ? (size_t)groups[g].length : 0;\\n        if (length > SIZE_MAX - total) {\\n            return knn_reference(n_groups, groups, k, to_evaluate);\\n        }\\n        total += length;\\n        votes[(unsigned char)groups[g].label] += length;\\n    }\\n\\n    /* Every point is retained here, including points with unordered distances. */\\n    if ((size_t)k >= total) {\\n        votes[(unsigned char)((char)-1)] += (size_t)k - total;\\n        return knn_vote(votes);\\n    }\\n\\n    int nearest = (size_t)k <= total / 2;\\n    size_t selected = nearest ? (size_t)k : total - (size_t)k;\\n    int threads = 1;\\n#ifdef _OPENMP\\n    if (!omp_in_parallel()) {\\n        threads = omp_get_max_threads();\\n        if (threads > 4) threads = 4;\\n    }\\n#endif\\n    /* Avoid startup and a large candidate union relative to each local scan. */\\n    while (threads > 1) {\\n        size_t chunk = total / (size_t)threads;\\n        if (chunk >= 16384 && chunk / 4 >= selected) break;\\n        threads--;\\n    }\\n\\n    KnnWork work[4];\\n    size_t storage_count = 0;\\n    size_t begin = 0;\\n    size_t quotient = total / (size_t)threads;\\n    size_t remainder = total % (size_t)threads;\\n    for (int t = 0; t < threads; t++) {\\n        size_t length = quotient + ((size_t)t < remainder);\\n        size_t capacity = selected < length ? selected : length;\\n        size_t reserved = t == 0 ? selected : capacity;\\n        if (reserved > SIZE_MAX - storage_count) {\\n            return knn_reference(n_groups, groups, k, to_evaluate);\\n        }\\n        storage_count += reserved;\\n        work[t].begin = begin;\\n        work[t].end = begin + length;\\n        work[t].capacity = capacity;\\n        work[t].used = 0;\\n        work[t].unordered = 0;\\n        begin += length;\\n    }\\n\\n    if (storage_count > SIZE_MAX / sizeof(KnnCandidate)) {\\n        return knn_reference(n_groups, groups, k, to_evaluate);\\n    }\\n    KnnCandidate *storage = (KnnCandidate *)malloc(storage_count * sizeof(KnnCandidate));\\n    if (!storage) return knn_reference(n_groups, groups, k, to_evaluate);\\n\\n    size_t cursor = 0;\\n    for (int t = 0; t < threads; t++) {\\n        work[t].heap = storage + cursor;\\n        cursor += t == 0 ? selected : work[t].capacity;\\n    }\\n\\n    if (threads == 1) {\\n        knn_process_range(&work[0], n_groups, groups, to_evaluate, nearest);\\n    } else {\\n#ifdef _OPENMP\\n#pragma omp parallel for schedule(static) num_threads(threads)\\n#endif\\n        for (int t = 0; t < threads; t++) {\\n            knn_process_range(&work[t], n_groups, groups, to_evaluate, nearest);\\n        }\\n    }\\n\\n    for (int t = 0; t < threads; t++) {\\n        if (work[t].unordered) {\\n            free(storage);\\n            return knn_reference(n_groups, groups, k, to_evaluate);\\n        }\\n    }\\n\\n    /* A locally discarded point has selected better points in its own range,\\n       so it cannot belong to the global selected set. Encounter indices make\\n       this argument apply to equal distances as well. */\\n    size_t used = work[0].used;\\n    for (int t = 1; t < threads; t++) {\\n        for (size_t j = 0; j < work[t].used; j++) {\\n            knn_heap_offer(storage, selected, &used, work[t].heap[j], nearest);\\n        }\\n    }\\n\\n    if (nearest) {\\n        for (int label = 0; label <= UCHAR_MAX; label++) votes[label] = 0;\\n        for (size_t j = 0; j < used; j++) {\\n            votes[(unsigned char)storage[j].label]++;\\n        }\\n    } else {\\n        for (size_t j = 0; j < used; j++) {\\n            votes[(unsigned char)storage[j].label]--;\\n        }\\n    }\\n\\n    free(storage);\\n    return knn_vote(votes);\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Selecting the smaller of k nearest and N-k farthest points with private heaps and workload-gated OpenMP sharing should reduce candidate storage and merge overhead, especially when k approaches N.\",\n  \"notes\": \"Parser, header and distance expression remain unchanged. Unordered distances use the original insertion algorithm; k>N preserves unfilled labels. No commands or measurements were executed.\",\n  \"research\": {\n    \"queries\": [],\n    \"urls\": []\n  },\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Partition points into balanced contiguous ranges using at most four OpenMP threads, with a serial path when local work is insufficient or OpenMP is unavailable.\",\n    \"Maintain private stable heaps for min(k,N-k) candidates, heapify initial batches once, and deterministically merge using global encounter indices.\",\n    \"Select farthest exclusions for large k and reduce labels through a histogram that preserves plain-char vote tie ordering.\",\n    \"Retain reference insertion behavior for NaN distances and workspace allocation failure; release per-call workspace.\"\n  ]\n}"}}

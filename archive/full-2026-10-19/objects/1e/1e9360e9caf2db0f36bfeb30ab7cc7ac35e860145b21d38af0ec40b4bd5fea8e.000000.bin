#include <cstdio>
#include <vector>
#include <cstdint>

struct FastScanner {
    static const int BUFSIZE = 1 << 20;
    int idx, size;
    char buf[BUFSIZE];
    FastScanner() : idx(0), size(0) {}
    inline char getChar() {
        if (idx >= size) {
            size = fread(buf, 1, BUFSIZE, stdin);
            idx = 0;
            if (size == 0) return '\0';
        }
        return buf[idx++];
    }
    int nextInt() {
        char c;
        do { c = getChar(); } while (c <= ' ' && c);
        int sign = 1;
        if (c == '-') { sign = -1; c = getChar(); }
        long long x = 0;
        for (; c >= '0' && c <= '9'; c = getChar()) {
            x = x * 10 + (c - '0');
        }
        return static_cast<int>(sign * x);
    }
};

int main() {
    FastScanner fs;
    int n = fs.nextInt();
    int s = fs.nextInt();

    std::vector<long long> colSum(n, 0);
    std::vector<int> ring((size_t)s * n);
    std::vector<int> newRow(n);

    // Read first S rows and initialize column sums.
    for (int i = 0; i < s; ++i) {
        int* rowPtr = &ring[(size_t)i * n];
        for (int j = 0; j < n; ++j) newRow[j] = fs.nextInt();
        #pragma omp simd
        for (int j = 0; j < n; ++j) {
            rowPtr[j] = newRow[j];
            colSum[j] += static_cast<long long>(newRow[j]);
        }
    }

    // Evaluate topmost SxS window.
    long long cur = 0;
    for (int j = 0; j < s; ++j) cur += colSum[j];
    long long mx = cur;
    for (int j = s; j < n; ++j) {
        cur += colSum[j] - colSum[j - s];
        if (cur > mx) mx = cur;
    }

    // Slide the S-row window downward, reading one new row per step.
    int nextSlot = 0;
    for (int step = 1; step <= n - s; ++step) {
        int* rowPtr = &ring[(size_t)nextSlot * n];
        long long* cs = colSum.data();

        // Read the entire new row into a temporary buffer.
        for (int j = 0; j < n; ++j) newRow[j] = fs.nextInt();

        // Update column sums and ring slot with SIMD vectorization.
        #pragma omp simd
        for (int j = 0; j < n; ++j) {
            int v = newRow[j];
            long long delta = static_cast<long long>(v) - rowPtr[j];
            rowPtr[j] = v;
            cs[j] += delta;
        }

        // Compute horizontal sliding-window maximum for this top row.
        cur = 0;
        for (int j = 0; j < s; ++j) cur += cs[j];
        if (cur > mx) mx = cur;
        for (int j = s; j < n; ++j) {
            cur += cs[j] - cs[j - s];
            if (cur > mx) mx = cur;
        }

        ++nextSlot;
        if (nextSlot == s) nextSlot = 0;
    }

    std::printf("%lld\n", static_cast<long long>(mx));
    return 0;
}

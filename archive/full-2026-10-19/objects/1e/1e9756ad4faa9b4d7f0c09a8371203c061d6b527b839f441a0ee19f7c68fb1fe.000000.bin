  "data": {
    "files": [
      {
        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdint.h>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10\n#define DT 0.01f\n#define SOFTENING 1e-9f\n#define PAIR_TILE 48\n#define TARGET_PACKET 8\n\n#if defined(__GNUC__) || defined(__clang__)\n#define CACHE_ALIGNED __attribute__((aligned(64)))\n#else\n#define CACHE_ALIGNED\n#endif\n\n#if defined(__GNUC__) && !defined(__clang__) && !defined(__INTEL_COMPILER)\n#define COEFFICIENT_ATTRIBUTES __attribute__((noinline, optimize(\"no-math-errno\")))\n#else\n#define COEFFICIENT_ATTRIBUTES\n#endif\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nstatic inline void force_one(Body *p, float dt, int n, int i) {\n  const float x = p[i].x;\n  const float y = p[i].y;\n  const float z = p[i].z;\n  float fx = 0.0f;\n  float fy = 0.0f;\n  float fz = 0.0f;\n\n  for (int j = 0; j < n; ++j) {\n    float dx = p[j].x - x;\n    float dy = p[j].y - y;\n    float dz = p[j].z - z;\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n    fx += dx * inv_dist3;\n    fy += dy * inv_dist3;\n    fz += dz * inv_dist3;\n  }\n\n  p[i].vx += dt*fx;\n  p[i].vy += dt*fy;\n  p[i].vz += dt*fz;\n}\n\nstatic void direct_advance(Body *p, float dt, int n,\n                           int iterations, int integrate) {\n#ifdef _OPENMP\n#pragma omp parallel if(n >= 2 * PAIR_TILE)\n#endif\n  {\n    for (int iter = 0; iter < iterations; ++iter) {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n      for (int i = 0; i < n; ++i) {\n        force_one(p, dt, n, i);\n      }\n      if (integrate) {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n        for (int i = 0; i < n; ++i) {\n          p[i].x += p[i].vx * dt;\n          p[i].y += p[i].vy * dt;\n          p[i].z += p[i].vz * dt;\n        }\n      }\n    }\n  }\n}\n\nstatic inline float coefficient_one(float sx, float sy, float sz,\n                                     float tx, float ty, float tz) {\n  float dx = sx - tx;\n  float dy = sy - ty;\n  float dz = sz - tz;\n  float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n  float inv_dist = 1 / sqrt(sqrd_dist);\n  return inv_dist * inv_dist * inv_dist;\n}\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic inline float32x4_t distance4(float sx, float sy, float sz,\n                                   float32x4_t tx,\n                                   float32x4_t ty,\n                                   float32x4_t tz) {\n  const float32x4_t dx = vsubq_f32(vdupq_n_f32(sx), tx);\n  const float32x4_t dy = vsubq_f32(vdupq_n_f32(sy), ty);\n  const float32x4_t dz = vsubq_f32(vdupq_n_f32(sz), tz);\n  float32x4_t d = vaddq_f32(vmulq_f32(dx, dx), vmulq_f32(dy, dy));\n  d = vaddq_f32(d, vmulq_f32(dz, dz));\n  return vaddq_f32(d, vdupq_n_f32(SOFTENING));\n}\n\n/* Match the double sqrt and division in 1 / sqrt(float). */\nstatic inline float32x4_t inverse_cube4(float32x4_t distance) {\n  const float64x2_t one = vdupq_n_f64(1.0);\n  const float64x2_t lo = vcvt_f64_f32(vget_low_f32(distance));\n  const float64x2_t hi = vcvt_f64_f32(vget_high_f32(distance));\n  const float64x2_t root_lo = vsqrtq_f64(lo);\n  const float64x2_t root_hi = vsqrtq_f64(hi);\n  const float32x2_t inv_lo = vcvt_f32_f64(vdivq_f64(one, root_lo));\n  const float32x2_t inv_hi = vcvt_f32_f64(vdivq_f64(one, root_hi));\n  const float32x4_t inv = vcombine_f32(inv_lo, inv_hi);\n  return vmulq_f32(vmulq_f32(inv, inv), inv);\n}\n\n/* Transpose each freshly computed microtile without reloading it. */\nstatic inline void store_coefficient_block4(\n    float *forward, float *reverse, int row, int col,\n    float32x4_t c0, float32x4_t c1,\n    float32x4_t c2, float32x4_t c3) {\n  vst1q_f32(forward + row*PAIR_TILE + col, c0);\n  vst1q_f32(forward + (row+1)*PAIR_TILE + col, c1);\n  vst1q_f32(forward + (row+2)*PAIR_TILE + col, c2);\n  vst1q_f32(forward + (row+3)*PAIR_TILE + col, c3);\n\n  if (reverse != NULL) {\n    const float32x4x2_t t0 = vtrnq_f32(c0, c1);\n    const float32x4x2_t t1 = vtrnq_f32(c2, c3);\n    vst1q_f32(reverse + col*PAIR_TILE + row,\n               vcombine_f32(vget_low_f32(t0.val[0]),\n                            vget_low_f32(t1.val[0])));\n    vst1q_f32(reverse + (col+1)*PAIR_TILE + row,\n               vcombine_f32(vget_low_f32(t0.val[1]),\n                            vget_low_f32(t1.val[1])));\n    vst1q_f32(reverse + (col+2)*PAIR_TILE + row,\n               vcombine_f32(vget_high_f32(t0.val[0]),\n                            vget_high_f32(t1.val[0])));\n    vst1q_f32(reverse + (col+3)*PAIR_TILE + row,\n               vcombine_f32(vget_high_f32(t0.val[1]),\n                            vget_high_f32(t1.val[1])));\n  }\n}\n#endif\n\n/* Coefficient rows are sources; columns are independent targets. */\nstatic void COEFFICIENT_ATTRIBUTES make_coefficients(\n    const float *restrict x, const float *restrict y,\n    const float *restrict z, int a, int na, int b, int nb,\n    float *restrict forward, float *restrict reverse) {\n#if defined(__aarch64__) && defined(__ARM_NEON)\n  int j = 0;\n  for (; j + 4 <= nb; j += 4) {\n    int i = 0;\n    for (; i + 4 <= na; i += 4) {\n      const float32x4_t tx = vld1q_f32(x + a + i);\n      const float32x4_t ty = vld1q_f32(y + a + i);\n      const float32x4_t tz = vld1q_f32(z + a + i);\n      const float32x4_t d0 = distance4(x[b+j], y[b+j], z[b+j],\n                                      tx, ty, tz);\n      const float32x4_t d1 = distance4(x[b+j+1], y[b+j+1], z[b+j+1],\n                                      tx, ty, tz);\n      const float32x4_t d2 = distance4(x[b+j+2], y[b+j+2], z[b+j+2],\n                                      tx, ty, tz);\n      const float32x4_t d3 = distance4(x[b+j+3], y[b+j+3], z[b+j+3],\n                                      tx, ty, tz);\n      const float32x4_t c0 = inverse_cube4(d0);\n      const float32x4_t c1 = inverse_cube4(d1);\n      const float32x4_t c2 = inverse_cube4(d2);\n      const float32x4_t c3 = inverse_cube4(d3);\n      store_coefficient_block4(forward, reverse, j, i,\n                               c0, c1, c2, c3);\n    }\n    for (; i < na; ++i) {\n      for (int r = 0; r < 4; ++r) {\n        const float c = coefficient_one(x[b+j+r], y[b+j+r], z[b+j+r],\n                                         x[a+i], y[a+i], z[a+i]);\n        forward[(j+r)*PAIR_TILE+i] = c;\n        if (reverse != NULL) {\n          reverse[i*PAIR_TILE+j+r] = c;\n        }\n      }\n    }\n  }\n  for (; j < nb; ++j) {\n    int i = 0;\n    for (; i + 4 <= na; i += 4) {\n      const float32x4_t d = distance4(\n          x[b+j], y[b+j], z[b+j],\n          vld1q_f32(x+a+i), vld1q_f32(y+a+i), vld1q_f32(z+a+i));\n      const float32x4_t c = inverse_cube4(d);\n      vst1q_f32(forward + j*PAIR_TILE + i, c);\n      if (reverse != NULL) {\n        reverse[i*PAIR_TILE+j] = vgetq_lane_f32(c, 0);\n        reverse[(i+1)*PAIR_TILE+j] = vgetq_lane_f32(c, 1);\n        reverse[(i+2)*PAIR_TILE+j] = vgetq_lane_f32(c, 2);\n        reverse[(i+3)*PAIR_TILE+j] = vgetq_lane_f32(c, 3);\n      }\n    }\n    for (; i < na; ++i) {\n      const float c = coefficient_one(x[b+j], y[b+j], z[b+j],\n                                       x[a+i], y[a+i], z[a+i]);\n      forward[j*PAIR_TILE+i] = c;\n      if (reverse != NULL) {\n        reverse[i*PAIR_TILE+j] = c;\n      }\n    }\n  }\n#else\n  for (int j = 0; j < nb; ++j) {\n#ifdef _OPENMP\n#pragma omp simd\n#endif\n    for (int i = 0; i < na; ++i) {\n      forward[j*PAIR_TILE+i] = coefficient_one(\n          x[b+j], y[b+j], z[b+j], x[a+i], y[a+i], z[a+i]);\n    }\n  }\n  if (reverse != NULL) {\n    for (int i = 0; i < na; ++i) {\n      for (int j = 0; j < nb; ++j) {\n        reverse[i*PAIR_TILE+j] = forward[j*PAIR_TILE+i];\n      }\n    }\n  }\n#endif\n}\n\nstatic void accumulate_panel(\n    float *restrict fx, float *restrict fy, float *restrict fz,\n    const float *restrict x, const float *restrict y,\n    const float *restrict z,\n    int target_first, int target_count, int source_first, int source_count,\n    const float *restrict coefficients) {\n  int q = 0;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n  for (; q + TARGET_PACKET <= target_count; q += TARGET_PACKET) {\n    const int t = target_first + q;\n    const float32x4_t tx0 = vld1q_f32(x+t);\n    const float32x4_t ty0 = vld1q_f32(y+t);\n    const float32x4_t tz0 = vld1q_f32(z+t);\n    const float32x4_t tx1 = vld1q_f32(x+t+4);\n    const float32x4_t ty1 = vld1q_f32(y+t+4);\n    const float32x4_t tz1 = vld1q_f32(z+t+4);\n    float32x4_t ax0 = vld1q_f32(fx+t);\n    float32x4_t ay0 = vld1q_f32(fy+t);\n    float32x4_t az0 = vld1q_f32(fz+t);\n    float32x4_t ax1 = vld1q_f32(fx+t+4);\n    float32x4_t ay1 = vld1q_f32(fy+t+4);\n    float32x4_t az1 = vld1q_f32(fz+t+4);\n\n    for (int k = 0; k < source_count; ++k) {\n      const int s = source_first + k;\n      const float32x4_t sx = vdupq_n_f32(x[s]);\n      const float32x4_t sy = vdupq_n_f32(y[s]);\n      const float32x4_t sz = vdupq_n_f32(z[s]);\n      const float32x4_t c0 = vld1q_f32(coefficients+k*PAIR_TILE+q);\n      const float32x4_t c1 = vld1q_f32(coefficients+k*PAIR_TILE+q+4);\n      ax0 = vaddq_f32(ax0, vmulq_f32(vsubq_f32(sx, tx0), c0));\n      ay0 = vaddq_f32(ay0, vmulq_f32(vsubq_f32(sy, ty0), c0));\n      az0 = vaddq_f32(az0, vmulq_f32(vsubq_f32(sz, tz0), c0));\n      ax1 = vaddq_f32(ax1, vmulq_f32(vsubq_f32(sx, tx1), c1));\n      ay1 = vaddq_f32(ay1, vmulq_f32(vsubq_f32(sy, ty1), c1));\n      az1 = vaddq_f32(az1, vmulq_f32(vsubq_f32(sz, tz1), c1));\n    }\n\n    vst1q_f32(fx+t, ax0);\n    vst1q_f32(fy+t, ay0);\n    vst1q_f32(fz+t, az0);\n    vst1q_f32(fx+t+4, ax1);\n    vst1q_f32(fy+t+4, ay1);\n    vst1q_f32(fz+t+4, az1);\n  }\n#endif\n  for (; q < target_count; ++q) {\n    const int t = target_first + q;\n    const float tx = x[t];\n    const float ty = y[t];\n    const float tz = z[t];\n    float ax = fx[t];\n    float ay = fy[t];\n    float az = fz[t];\n    for (int k = 0; k < source_count; ++k) {\n      const int s = source_first + k;\n      const float c = coefficients[k*PAIR_TILE+q];\n      float dx = x[s] - tx;\n      float dy = y[s] - ty;\n      float dz = z[s] - tz;\n      ax += dx * c;\n      ay += dy * c;\n      az += dz * c;\n    }\n    fx[t] = ax;\n    fy[t] = ay;\n    fz[t] = az;\n  }\n}\n\nstatic void advance_bodies(Body *p, float dt, int n,\n                            int iterations, int integrate) {\n  if (n <= 0 || iterations <= 0) {\n    return;\n  }\n  if (n < 2 * PAIR_TILE) {\n    direct_advance(p, dt, n, iterations, integrate);\n    return;\n  }\n\n  const size_t count = (size_t)n;\n  if (count > SIZE_MAX - 15u) {\n    direct_advance(p, dt, n, iterations, integrate);\n    return;\n  }\n  const size_t stride = (count + 15u) & ~(size_t)15u;\n  if (stride > (SIZE_MAX - 63u) / (6u * sizeof(float))) {\n    direct_advance(p, dt, n, iterations, integrate);\n    return;\n  }\n  void *allocation = malloc(6u * stride * sizeof(float) + 63u);\n  if (allocation == NULL) {\n    direct_advance(p, dt, n, iterations, integrate);\n    return;\n  }\n\n  float *x = (float *)(((uintptr_t)allocation + 63u) & ~(uintptr_t)63u);\n  float *y = x + stride;\n  float *z = y + stride;\n  float *fx = z + stride;\n  float *fy = fx + stride;\n  float *fz = fy + stride;\n  const int tile_count = n / PAIR_TILE + (n % PAIR_TILE != 0);\n  int bad_positions = 0;\n\n#ifdef _OPENMP\n#pragma omp parallel\n#endif\n  {\n    float forward[PAIR_TILE * PAIR_TILE] CACHE_ALIGNED;\n    float reverse[PAIR_TILE * PAIR_TILE] CACHE_ALIGNED;\n\n    for (int iter = 0; iter < iterations; ++iter) {\n#ifdef _OPENMP\n#pragma omp for schedule(static) reduction(|:bad_positions)\n#endif\n      for (int i = 0; i < n; ++i) {\n        const float px = p[i].x;\n        const float py = p[i].y;\n        const float pz = p[i].z;\n        x[i] = px;\n        y[i] = py;\n        z[i] = pz;\n        fx[i] = 0.0f;\n        fy[i] = 0.0f;\n        fz[i] = 0.0f;\n        bad_positions |= (!isfinite(px) || !isfinite(py) || !isfinite(pz));\n      }\n\n      if (bad_positions) {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n        for (int i = 0; i < n; ++i) {\n          force_one(p, dt, n, i);\n        }\n      } else {\n        /* Disjoint pairs within a wave; ascending sources across waves. */\n        for (int sum = 0; sum < 2 * tile_count - 1; ++sum) {\n          const int first = sum < tile_count ? 0 : sum - tile_count + 1;\n          const int last = sum / 2;\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n          for (int ta = first; ta <= last; ++ta) {\n            const int tb = sum - ta;\n            const int a = ta * PAIR_TILE;\n            const int b = tb * PAIR_TILE;\n            const int na = n - a < PAIR_TILE ? n - a : PAIR_TILE;\n            const int nb = n - b < PAIR_TILE ? n - b : PAIR_TILE;\n            make_coefficients(x, y, z, a, na, b, nb,\n                               forward, ta == tb ? NULL : reverse);\n            accumulate_panel(fx, fy, fz, x, y, z,\n                              a, na, b, nb, forward);\n            if (ta != tb) {\n              accumulate_panel(fx, fy, fz, x, y, z,\n                                b, nb, a, na, reverse);\n            }\n          }\n        }\n      }\n\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n      for (int i = 0; i < n; ++i) {\n        if (!bad_positions) {\n          p[i].vx += dt*fx[i];\n          p[i].vy += dt*fy[i];\n          p[i].vz += dt*fz[i];\n        }\n        if (integrate) {\n          p[i].x += p[i].vx * dt;\n          p[i].y += p[i].vy * dt;\n          p[i].z += p[i].vz * dt;\n        }\n      }\n    }\n  }\n  free(allocation);\n}\n\n/* Force-only semantics are preserved for independent and repeated calls. */\nvoid body_force(Body *p, float dt, int n) {\n  advance_bodies(p, dt, n, 1, 0);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n  Body *bodies = read_dataset(&nbodies);\n  advance_bodies(bodies, DT, nbodies, N_ITER, 1);\n  write_dataset(nbodies, bodies);\n  free(bodies);\n  exit(EXIT_SUCCESS);\n}\n",
        "path": "src/nbody.c"
      }

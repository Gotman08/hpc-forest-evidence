      "content": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <iterator>\n#include <limits>\n#include <string>\n#include <vector>\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ' )\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v') ;\n    }\n} ;\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase\n        ( std::remove_if\n            ( text.begin ()\n            , text.end ()\n            , IsWhitespace () )\n        , text.end () ) ;\n    return text;\n}\n\ntemplate <typename Iter> auto\nfind_longest_non_increasing_suffix (Iter first, Iter last) -> Iter\n{\n    if (first == last) return last;\n    Iter back = std::prev (last);\n    if (back == first) return last;\n    do {\n        -- last;\n        -- back;\n    } while ((first != last) && (*back >= *last));\n    return last;\n}\n\ntemplate <typename Iter> auto\nfind_rightmost_successor (Iter first, Iter second, Iter last) -> Iter\n{\n    if (second == last) return last;\n    do {\n        -- last;\n    } while ((second != last) && (*last <= *first));\n    return last;\n}\n\ntemplate <typename Iter> auto\nnext_permutation (Iter first, Iter last) -> bool\n{\n    if (first == last) return false;\n    Iter suffix = find_longest_non_increasing_suffix (first, last);\n    if (suffix == first) return false;\n    if (suffix == last) return false;\n    Iter pivot = std::prev (suffix);\n    Iter successor = find_rightmost_successor (pivot, suffix, last);\n    std::iter_swap (pivot, successor);\n    std::reverse (suffix, last);\n    return true;\n}\n\nstatic auto\nformat_permutation (std::string const& text, std::size_t line_bytes) -> std::string\n{\n    std::string line;\n    line.reserve (line_bytes);\n    line.append (\"[ \");\n    for (std::string::const_iterator it = text.begin (); it != text.end (); ++it) {\n        line.push_back (*it);\n        line.push_back (' ');\n    }\n    line.append (\"]\\n\");\n    return line;\n}\n\nstatic auto\nwrite_permutation_batch (std::vector<std::string>& batch, std::size_t line_bytes) -> void\n{\n    if (batch.empty ()) return;\n\n    const std::size_t target_parallel_bytes = 32768;\n    const std::size_t min_lines_by_bytes =\n        target_parallel_bytes / line_bytes\n        + (target_parallel_bytes % line_bytes != 0);\n\n#ifdef _OPENMP\n    const bool use_parallel =\n        (batch.size () >= 256) && (batch.size () >= min_lines_by_bytes);\n#pragma omp parallel for schedule(static) if (use_parallel)\n#endif\n    for (long long index = 0; index < static_cast<long long> (batch.size ()); ++index) {\n        const std::size_t i = static_cast<std::size_t> (index);\n        std::string line = format_permutation (batch [i], line_bytes);\n        batch [i].swap (line);\n    }\n\n    std::string output;\n    output.reserve (batch.size () * line_bytes);\n    for (std::size_t i = 0; i < batch.size (); ++i)\n        output.append (batch [i]);\n    std::cout.write (output.data (), static_cast<std::streamsize> (output.size ())) ;\n    batch.clear ();\n}\n\ntemplate <typename Iter> inline auto\npermutations_iter (Iter first, Iter last) -> void\n{\n    if (first == last) return;\n    std::sort (first, last);\n\n    const std::size_t text_size = static_cast<std::size_t> (std::distance (first, last));\n    const std::size_t maximum = std::numeric_limits<std::size_t>::max ();\n    const std::size_t line_bytes =\n        text_size <= (maximum - 4) / 2 ? text_size * 2 + 4 : maximum;\n    const std::size_t max_batch_bytes = 1024 * 1024;\n    std::size_t batch_capacity = max_batch_bytes / line_bytes;\n    if (batch_capacity == 0) batch_capacity = 1;\n    if (batch_capacity > 4096) batch_capacity = 4096;\n\n    std::vector<std::string> batch;\n    batch.reserve (batch_capacity);\n    do {\n        batch.emplace_back (first, last);\n        if (batch.size () == batch_capacity)\n            write_permutation_batch (batch, line_bytes);\n    } while (::next_permutation (first, last));\n    write_permutation_batch (batch, line_bytes);\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator <char> begin (in), end;\n    std::string text (begin, end);\n    text = remove_whitespaces (text);\n    return text;\n}\n\nint main (int argc, char const *argv [])\n{\n    std::string text = read_text_from_stdin <std::string> (std::cin);\n    permutations_iter (std::begin (text), std::end (text));\n    return 0;\n}\n",
      "path": "src/permutations.cc"
    }
  ],
  "hypothesis": "The lexicographic successor loop has a loop-carried dependency, so parallelizing it would risk incorrect ordering. Instead, bounded batches let OpenMP statically distribute independent line formatting; a single ordered write of each batch preserves exact output order and may reduce formatting and I/O overhead when there is enough work.",
  "notes": "Batch storage is capped by an estimated output size and line count. OpenMP formatting is enabled when compiled with OpenMP and the batch has sufficient estimated work; otherwise the same path runs serially. No integration source ideas were supplied.",

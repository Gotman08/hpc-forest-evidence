 i = 0; i < nbodies; ++i) {\\n                float fx = 0.0f, fy = 0.0f, fz = 0.0f;\\n                const float xi = px[i], yi = py[i], zi = pz[i];\\n                int j = 0;\\n                // Unroll by 8 to expose more independent sqrt/div operations\\n                for (; j + 7 < nbodies; j += 8) {\\n                    float dx0 = px[j] - xi;\\n                    float dy0 = py[j] - yi;\\n                    float dz0 = pz[j] - zi;\\n                    float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\\n                    float inv_dist0 = 1.0f / sqrt(sqrd_dist0);\\n                    float inv_dist3_0 = inv_dist0 * inv_dist0 * inv_dist0;\\n\\n                    float dx1 = px[j+1] - xi;\\n                    float dy1 = py[j+1] - yi;\\n                    float dz1 = pz[j+1] - zi;\\n                    float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\\n                    float inv_dist1 = 1.0f / sqrt(sqrd_dist1);\\n                    float inv_dist3_1 = inv_dist1 * inv_dist1 * inv_dist1;\\n\\n                    float dx2 = px[j+2] - xi;\\n                    float dy2 = py[j+2] - yi;\\n                    float dz2 = pz[j+2] - zi;\\n                    float sqrd_dist2 = dx2*dx2 + dy2*dy2 + dz2*dz2 + SOFTENING;\\n                    float inv_dist2 = 1.0f / sqrt(sqrd_dist2);\\n                    float inv_dist3_2 = inv_dist2 * inv_dist2 * inv_dist2;\\n\\n                    float dx3 = px[j+3] - xi;\\n                    float dy3 = py[j+3] - yi;\\n                    float dz3 = pz[j+3] - zi;\\n                    float sqrd_dist3 = dx3*dx3 + dy3*dy3 + dz3*dz3 + SOFTENING;\\n                    float inv_dist3 = 1.0f / sqrt(sqrd_dist3);\\n                    float inv_dist3_3 = inv_dist3 * inv_dist3 * inv_dist3;\\n\\n                    float dx4 = px[j+4] - xi;\\n                    float dy4 = py[j+4] - yi;\\n                    float dz4 = pz[j+4] - zi;\\n                    float sqrd_dist4 = dx4*dx4 + dy4*dy4 + dz4*dz4 + SOFTENING;\\n                    float inv_dist4 = 1.0f / sqrt(sqrd_dist4);\\n                    float inv_dist3_4 = inv_dist4 * inv_dist4 * inv_dist4;\\n\\n                    float dx5 = px[j+5] - xi;\\n                    float dy5 = py[j+5] - yi;\\n                    float dz5 = pz[j+5] - zi;\\n                    float sqrd_dist5 = dx5*dx5 + dy5*dy5 + dz5*dz5 + SOFTENING;\\n                    float inv_dist5 = 1.0f / sqrt(sqrd_dist5);\\n                    float inv_dist3_5 = inv_dist5 * inv_dist5 * inv_dist5;\\n\\n                    float dx6 = px[j+6] - xi;\\n                    float dy6 = py[j+6] - yi;\\n                    float dz6 = pz[j+6] - zi;\\n                    float sqrd_dist6 = dx6*dx6 + dy6*dy6 + dz6*dz6 + SOFTENING;\\n                    float inv_dist6 = 1.0f / sqrt(sqrd_dist6);\\n                    float inv_dist3_6 = inv_dist6 * inv_dist6 * inv_dist6;\\n\\n                    float dx7 = px[j+7] - xi;\\n                    float dy7 = py[j+7] - yi;\\n                    float dz7 = pz[j+7] - zi;\\n                    float sqrd_dist7 = dx7*dx7 + dy7*dy7 + dz7*dz7 + SOFTENING;\\n                    float inv_dist7 = 1.0f / sqrt(sqrd_dist7);\\n                    float inv_dist3_7 = inv_dist7 * inv_dist7 * inv_dist7;\\n\\n                    // Accumulate in strict j order\\n                    fx += dx0 * inv_dist3_0;\\n                    fy += dy0 * inv_dist3_0;\\n                    fz += dz0 * inv_dist3_0;\\n\\n                    fx += dx1 * inv_dist3_1;\\n                    fy += dy1 * inv_dist3_1;\\n                    fz += dz1 * inv_dist3_1;\\n\\n                    fx += dx2 * inv_dist3_2;\\n                    fy += dy2 * inv_dist3_2;\\n                    fz += dz2 * inv_dist3_2;\\n\\n                    fx += dx3 * inv_dist3_3;\\n                    fy += dy3 * inv_dist3_3;\\n                    fz += dz3 * inv_dist3_3;\\n\\n                    fx += dx4 * inv_dist3_4;\\n                    fy += dy4 * inv_dist3_4;\\n
        "content": "#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <algorithm>\n#include <limits>\n#include <cstdint>\n#include <cstddef>\n#include <memory>\n\nclass FastInput {\n    unsigned char buffer_[1u << 16];\n    std::size_t position_ = 0;\n    std::size_t available_ = 0;\n\n    inline int get() {\n        if (position_ == available_) {\n            available_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (available_ == 0)\n                return EOF;\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    inline bool readInt(int& value) {\n        int ch;\n        do {\n            ch = get();\n            if (ch == EOF)\n                return false;\n        } while (ch <= ' ');\n\n        const bool negative = ch == '-';\n        if (ch == '-' || ch == '+')\n            ch = get();\n        std::uint32_t magnitude = 0;\n        while (ch >= '0' && ch <= '9') {\n            magnitude = magnitude * 10u + static_cast<unsigned>(ch - '0');\n            ch = get();\n        }\n        value = negative\n            ? static_cast<int>(-static_cast<std::int64_t>(magnitude))\n            : static_cast<int>(magnitude);\n        return true;\n    }\n};\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n\nstatic inline int64x2_t maximumPair(int64x2_t a, int64x2_t b) {\n    return vbslq_s64(vcgtq_s64(a, b), a, b);\n}\n\nstatic inline int64x2_t broadcastLast(int64x2_t value) {\n    return vdupq_n_s64(vgetq_lane_s64(value, 1));\n}\n\nstatic inline int64x2_t prefixPair(int64x2_t value) {\n    return vaddq_s64(value, vextq_s64(vdupq_n_s64(0), value, 1));\n}\n\nstatic inline void scanEight(const int* entering, const int* leaving,\n                             int64x2_t& p0, int64x2_t& p1,\n                             int64x2_t& p2, int64x2_t& p3) {\n    const int32x4_t e0 = vld1q_s32(entering);\n    const int32x4_t e1 = vld1q_s32(entering + 4);\n    const int32x4_t l0 = vld1q_s32(leaving);\n    const int32x4_t l1 = vld1q_s32(leaving + 4);\n    p0 = prefixPair(vsubl_s32(vget_low_s32(e0), vget_low_s32(l0)));\n    p1 = prefixPair(vsubl_s32(vget_high_s32(e0), vget_high_s32(l0)));\n    p2 = prefixPair(vsubl_s32(vget_low_s32(e1), vget_low_s32(l1)));\n    p3 = prefixPair(vsubl_s32(vget_high_s32(e1), vget_high_s32(l1)));\n    p1 = vaddq_s64(p1, broadcastLast(p0));\n    p3 = vaddq_s64(p3, broadcastLast(p2));\n    const int64x2_t firstHalf = broadcastLast(p1);\n    p2 = vaddq_s64(p2, firstHalf);\n    p3 = vaddq_s64(p3, firstHalf);\n}\n\ntemplate<bool Remove, bool Track>\nstatic inline int64x2_t updatePair(std::int64_t* __restrict totals,\n                                  std::int64_t* __restrict history,\n                                  int64x2_t horizontal, int64x2_t best) {\n    int64x2_t next = vaddq_s64(vld1q_s64(totals), horizontal);\n    if (Remove)\n        next = vsubq_s64(next, vld1q_s64(history));\n    vst1q_s64(history, horizontal);\n    vst1q_s64(totals, next);\n    if (Track)\n        best = maximumPair(best, next);\n    return best;\n}\n#endif\n\ntemplate<bool Remove, bool Track>\nstatic inline std::int64_t processRow(const int* __restrict row,\n                                      std::int64_t* __restrict totals,\n                                      std::int64_t* __restrict history,\n                                      int n, int s) {\n    const int width = n - s + 1;\n    std::int64_t horizontal = 0;\n    #pragma omp simd reduction(+:horizontal)\n    for (int c = 0; c < s; ++c)\n        horizontal += static_cast<std::int64_t>(row[c]);\n\n    std::int64_t first = totals[0] + horizontal;\n    if (Remove)\n        first -= history[0];\n    history[0] = horizontal;\n    totals[0] = first;\n    std::int64_t rowMaximum = Track\n        ? first : std::numeric_limits<std::int64_t>::lowest();\n    int x = 1;\n\n#if defined(__aarch64__)\n    int64x2_t carry = vdupq_n_s64(horizontal);\n    int64x2_t best0 = vdupq_n_s64(std::numeric_limits<std::int64_t>::lowest());\n    int64x2_t best1 = best0;\n    int64x2_t best2 = best0;\n    int64x2_t best3 = best0;\n    int64x2_t best4 = best0;\n    int64x2_t best5 = best0;\n    int64x2_t best6 = best0;\n    int64x2_t best7 = best0;\n\n    for (; x + 15 < width; x += 16) {\n        int64x2_t p0, p1, p2, p3, p4, p5, p6, p7;\n        scanEight(row + x + s - 1, row + x - 1, p0, p1, p2, p3);\n        scanEight(row + x + s + 7, row + x + 7, p4, p5, p6, p7);\n        const int64x2_t firstEight = broadcastLast(p3);\n        p4 = vaddq_s64(p4, firstEight);\n        p5 = vaddq_s64(p5, firstEight);\n        p6 = vaddq_s64(p6, firstEight);\n        p7 = vaddq_s64(p7, firstEight);\n\n        p0 = vaddq_s64(p0, carry);\n        p1 = vaddq_s64(p1, carry);\n        p2 = vaddq_s64(p2, carry);\n        p3 = vaddq_s64(p3, carry);\n        p4 = vaddq_s64(p4, carry);\n        p5 = vaddq_s64(p5, carry);\n        p6 = vaddq_s64(p6, carry);\n        p7 = vaddq_s64(p7, carry);\n        carry = broadcastLast(p7);\n\n        best0 = updatePair<Remove, Track>(totals + x, history + x, p0, best0);\n        best1 = updatePair<Remove, Track>(totals + x + 2, history + x + 2, p1, best1);\n        best2 = updatePair<Remove, Track>(totals + x + 4, history + x + 4, p2, best2);\n        best3 = updatePair<Remove, Track>(totals + x + 6, history + x + 6, p3, best3);\n        best4 = updatePair<Remove, Track>(totals + x + 8, history + x + 8, p4, best4);\n        best5 = updatePair<Remove, Track>(totals + x + 10, history + x + 10, p5, best5);\n        best6 = updatePair<Remove, Track>(totals + x + 12, history + x + 12, p6, best6);\n        best7 = updatePair<Remove, Track>(totals + x + 14, history + x + 14, p7, best7);\n    }\n    horizontal = vgetq_lane_s64(carry, 0);\n    if (Track) {\n        best0 = maximumPair(best0, best1);\n        best2 = maximumPair(best2, best3);\n        best4 = maximumPair(best4, best5);\n        best6 = maximumPair(best6, best7);\n        best0 = maximumPair(best0, best2);\n        best4 = maximumPair(best4, best6);\n        best0 = maximumPair(best0, best4);\n        rowMaximum = std::max(rowMaximum,\n            std::max(vgetq_lane_s64(best0, 0), vgetq_lane_s64(best0, 1)));\n    }\n#endif\n\n    for (; x < width; ++x) {\n        horizontal += static_cast<std::int64_t>(row[x + s - 1])\n                    - static_cast<std::int64_t>(row[x - 1]);\n        std::int64_t next = totals[x] + horizontal;\n        if (Remove)\n            next -= history[x];\n        history[x] = horizontal;\n        totals[x] = next;\n        if (Track)\n            rowMaximum = std::max(rowMaximum, next);\n    }\n    return rowMaximum;\n}\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.readInt(n) || !input.readInt(s))\n        return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const int width = n - s + 1;\n    std::vector<int> row(n);\n    std::vector<std::int64_t> totals(width, 0);\n    std::unique_ptr<std::int64_t[]> history(\n        new std::int64_t[static_cast<std::size_t>(s) * width]);\n    std::int64_t answer = std::numeric_limits<std::int64_t>::lowest();\n    int slot = 0;\n\n    for (int r = 0; r < n; ++r) {\n        for (int c = 0; c < n; ++c)\n            if (!input.readInt(row[c]))\n                return 0;\n\n        std::int64_t* previous = history.get()\n            + static_cast<std::size_t>(slot) * width;\n        if (r < s - 1) {\n            processRow<false, false>(row.data(), totals.data(), previous, n, s);\n        } else if (r == s - 1) {\n            answer = std::max(answer,\n                processRow<false, true>(row.data(), totals.data(), previous, n, s));\n        } else {\n            answer = std::max(answer,\n                processRow<true, true>(row.data(), totals.data(), previous, n, s));\n        }\n        if (++slot == s)\n            slot = 0;\n    }\n\n    std::printf(\"%lld\\n\", static_cast<long long>(answer));\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }

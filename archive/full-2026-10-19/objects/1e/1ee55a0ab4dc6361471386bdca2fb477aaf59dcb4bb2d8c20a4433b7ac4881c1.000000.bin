        "content": "#include <cassert>\n#include <cstddef>\n#include <cstdio>\n#include <memory>\n#include <vector>\n\nclass BufferedInput {\n    unsigned char buffer_[1 << 16];\n    std::size_t position_ = 0;\n    std::size_t length_ = 0;\n\n    int nextChar() {\n        if (position_ == length_) {\n            length_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (length_ == 0) return EOF;\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    bool readInt(int& result) {\n        int c;\n        do {\n            c = nextChar();\n            if (c == EOF) return false;\n        } while (c <= ' ');\n\n        bool negative = false;\n        if (c == '-' || c == '+') {\n            negative = (c == '-');\n            c = nextChar();\n        }\n        unsigned int value = 0;\n        while (c >= '0' && c <= '9') {\n            value = value * 10u + static_cast<unsigned int>(c - '0');\n            c = nextChar();\n        }\n        const long long magnitude = static_cast<long long>(value);\n        result = static_cast<int>(negative ? -magnitude : magnitude);\n        return true;\n    }\n};\n\nint main() {\n    BufferedInput input;\n    int n, s;\n    if (!input.readInt(n) || !input.readInt(s)) return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t width = static_cast<std::size_t>(n);\n    std::unique_ptr<int[]> rows(new int[width * static_cast<std::size_t>(s)]);\n    std::vector<long long> columns(n, 0);\n\n    for (int r = 0; r < s; ++r) {\n        int* row = rows.get() + static_cast<std::size_t>(r) * width;\n        for (int c = 0; c < n; ++c) {\n            int value = 0;\n            input.readInt(value);\n            row[c] = value;\n            columns[c] += value;\n        }\n    }\n\n    long long window = 0;\n    for (int c = 0; c < s; ++c) window += columns[c];\n    long long maximum = window;\n    for (int c = s; c < n; ++c) {\n        window += columns[c] - columns[c - s];\n        if (window > maximum) maximum = window;\n    }\n\n    int slot = 0;\n    for (int r = s; r < n; ++r) {\n        int* row = rows.get() + static_cast<std::size_t>(slot) * width;\n        window = 0;\n        for (int c = 0; c < s; ++c) {\n            int value = 0;\n            input.readInt(value);\n            columns[c] += static_cast<long long>(value) - row[c];\n            row[c] = value;\n            window += columns[c];\n        }\n        if (window > maximum) maximum = window;\n\n        for (int c = s; c < n; ++c) {\n            int value = 0;\n            input.readInt(value);\n            columns[c] += static_cast<long long>(value) - row[c];\n            row[c] = value;\n            window += columns[c] - columns[c - s];\n            if (window > maximum) maximum = window;\n        }\n\n        ++slot;\n        if (slot == s) slot = 0;\n    }\n\n    std::printf(\"%lld\\n\", maximum);\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }

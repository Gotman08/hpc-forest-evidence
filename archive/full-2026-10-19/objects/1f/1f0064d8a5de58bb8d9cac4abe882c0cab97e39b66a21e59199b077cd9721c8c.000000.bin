#include <iostream>
#include <vector>
#include <cstdio>
#include <climits>

static inline int read_int() {
    static const int BUFSIZE = 1 << 20;
    static char buf[BUFSIZE];
    static int idx = 0, size = 0;
    while (true) {
        if (idx >= size) {
            size = fread(buf, 1, BUFSIZE, stdin);
            idx = 0;
            if (size == 0) return 0; // EOF
        }
        char c = buf[idx++];
        if (c >= '0' && c <= '9') {
            int x = c - '0';
            while (idx < size && buf[idx] >= '0' && buf[idx] <= '9') {
                x = x * 10 + (buf[idx++] - '0');
            }
            return x;
        } else if (c == '-') {
            int x = 0;
            while (idx < size && buf[idx] >= '0' && buf[idx] <= '9') {
                x = x * 10 + (buf[idx++] - '0');
            }
            return -x;
        }
    }
}

int main() {
    int n = read_int();
    int s = read_int();

    // prefix sums: pref[(i+1)*(n+1)+(j+1)] = sum of matrix[0..i][0..j]
    std::vector<long long> pref((n + 1) * (n + 1), 0);
    for (int i = 0; i < n; ++i) {
        int row_base = i * (n + 1);
        int next_row_base = (i + 1) * (n + 1);
        for (int j = 0; j < n; ++j) {
            int val = read_int();
            pref[next_row_base + j + 1] = pref[row_base + j + 1] + pref[next_row_base + j] - pref[row_base + j] + val;
        }
    }

    long long mx = LLONG_MIN;
    int limit = n - s; // inclusive upper bound for r and c
    const long long* base = pref.data();
    #pragma omp parallel for schedule(static) reduction(max:mx)
    for (int r = 0; r <= limit; ++r) {
        const long long* tl = base + r * (n + 1);
        const long long* tr = tl + s;
        const long long* bl = base + (r + s) * (n + 1);
        const long long* br = bl + s;
        #pragma omp simd reduction(max:mx)
        for (int c = 0; c <= limit; ++c) {
            long long sum = br[c] - tr[c] - bl[c] + tl[c];
            if (sum > mx) mx = sum;
        }
    }

    printf("%d\n", (int)mx);
    return 0;
}

  state.update(stage="r1_max_complete_extra_stopped_priority_r2_max",previous_key="coverage-gpt-6.1-sol-xhigh",current_key=None,strict_observer_running=False,updated_at=time.time(),human_max_only=True,r1_max_received_and_audited_cells=60)
  tmp=state_path.with_name("coordinator-state-human-stop-new.json")
  with tmp.open("x",encoding="utf-8") as f:json.dump(state,f,ensure_ascii=False,indent=2);f.write("\n");f.flush();os.fsync(f.fileno())
  os.replace(tmp,state_path)
  proof["updated_state_sha256"]=sha(state_path)
 finally:lock.seek(0);msvcrt.locking(lock.fileno(),msvcrt.LK_UNLCK,1)

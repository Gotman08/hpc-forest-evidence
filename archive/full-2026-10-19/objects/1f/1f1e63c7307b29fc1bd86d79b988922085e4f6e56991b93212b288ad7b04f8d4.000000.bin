proof={"schema":"hpc-forest-voluntary-extra-sol-partial-closure-v1","verified":True,"job_id":"751571","session_id":audit["session_id"],"closed_at":time.time(),"human_stop":True,"full_planned_cohort_admitted":False,"research_completed":False,"r1_max_remains_complete_cells":60,"published_requests":9,"delivered_requests":9,"native_invocations":9,"known_exact_tokens":229415,"unknown_consumption_requests":0,"user_aborted_subjects":1,"not_run_subjects":13,"new_subject_results_admitted":0,"raw_remote_files_unchanged":592,"worker_files_unchanged":121,"all_started_claims_reconciled":True,"source_only_job_preserved":"751592","no_replay":True,"no_algorithm_or_oracle_change":True,"no_recursive_or_name_stop":True,"receipt_refs":{}}
for key,rel in {"partial_audit":"audit-partiel-r2/audit-partiel.json","owned_absence":"owned-worker-stopped.json","stop_reconciliation":"arret-reconcilie.json","raw_restoration":"transfert-archive-allouee-r1/restauration-verifiee.json","cache_capture":"capture-cache-post-drain-r1/capture-verifiee.json","reader_validation":"outils-r2/validation-locale.json"}.items():
 p=C/rel;proof["receipt_refs"][key]={"path":str(p),"sha256":sha(p)}
state_path=S/"coordinator-state.json"
with (S/"coordinator.lock").open("r+b") as lock:
 lock.seek(0);msvcrt.locking(lock.fileno(),msvcrt.LK_NBLCK,1)
 try:
  state=load(state_path);q=next(c for c in state["queue"] if c["key"]=="coverage-gpt-6.1-sol-xhigh")
  assert q["job_id"]=="751571" and q["session_id"]==audit["session_id"] and q["state"]=="working"

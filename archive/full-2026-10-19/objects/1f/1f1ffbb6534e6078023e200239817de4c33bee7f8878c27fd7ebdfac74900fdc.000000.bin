        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nenum { TARGET_BLOCK = 64, SOURCE_BLOCK = 256 };\n\nstatic float *allocate_positions(int n) {\n  if (n <= 0 || (size_t)n > (size_t)-1 / (3 * sizeof(float))) {\n    return NULL;\n  }\n  return (float *)malloc((size_t)n * 3 * sizeof(float));\n}\n\n/* Called collectively by the current OpenMP team. */\n#if defined(__GNUC__) && !defined(__clang__)\n__attribute__((optimize(\"no-math-errno\")))\n#endif\nstatic void body_force_work(Body *p, float dt, int n, float *positions) {\n  if (positions == NULL) {\n    #pragma omp for schedule(static)\n    for (int i = 0; i < n; ++i) {\n      float fx = 0.0f;\n      float fy = 0.0f;\n      float fz = 0.0f;\n\n      for (int j = 0; j < n; ++j) {\n        float dx = p[j].x - p[i].x;\n        float dy = p[j].y - p[i].y;\n        float dz = p[j].z - p[i].z;\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx += dx * inv_dist3;\n        fy += dy * inv_dist3;\n        fz += dz * inv_dist3;\n      }\n\n      p[i].vx += dt*fx;\n      p[i].vy += dt*fy;\n      p[i].vz += dt*fz;\n    }\n    return;\n  }\n\n  float *restrict x = positions;\n  float *restrict y = positions + (size_t)n;\n  float *restrict z = positions + (size_t)n * 2;\n\n  #pragma omp for schedule(static)\n  for (int i = 0; i < n; ++i) {\n    x[i] = p[i].x;\n    y[i] = p[i].y;\n    z[i] = p[i].z;\n  }\n\n  const int blocks = n / TARGET_BLOCK + (n % TARGET_BLOCK != 0);\n\n  #pragma omp for schedule(static)\n  for (int block = 0; block < blocks; ++block) {\n    const int ib = block * TARGET_BLOCK;\n    int ni = n - ib;\n    if (ni > TARGET_BLOCK) {\n      ni = TARGET_BLOCK;\n    }\n\n    float fx[TARGET_BLOCK] = {0.0f};\n    float fy[TARGET_BLOCK] = {0.0f};\n    float fz[TARGET_BLOCK] = {0.0f};\n\n    for (int jb = 0; jb < n; ) {\n      int nj = n - jb;\n      if (nj > SOURCE_BLOCK) {\n        nj = SOURCE_BLOCK;\n      }\n      const int je = jb + nj;\n      int k = 0;\n\n      for (; k + 3 < ni; k += 4) {\n        const int i = ib + k;\n        float tx[4], ty[4], tz[4];\n        float fxi[4], fyi[4], fzi[4];\n\n        #pragma omp simd simdlen(4)\n        for (int lane = 0; lane < 4; ++lane) {\n          tx[lane] = x[i + lane];\n          ty[lane] = y[i + lane];\n          tz[lane] = z[i + lane];\n          fxi[lane] = fx[k + lane];\n          fyi[lane] = fy[k + lane];\n          fzi[lane] = fz[k + lane];\n        }\n\n        /* Distances are independent; additions retain ascending source order. */\n        int j = jb;\n        for (; j < je - 1; j += 2) {\n          const float j0x = x[j];\n          const float j0y = y[j];\n          const float j0z = z[j];\n          const float j1x = x[j + 1];\n          const float j1y = y[j + 1];\n          const float j1z = z[j + 1];\n\n          #pragma omp simd simdlen(4)\n          for (int lane = 0; lane < 4; ++lane) {\n            float dx0 = j0x - tx[lane];\n            float dy0 = j0y - ty[lane];\n            float dz0 = j0z - tz[lane];\n            float dx1 = j1x - tx[lane];\n            float dy1 = j1y - ty[lane];\n            float dz1 = j1z - tz[lane];\n            float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\n            float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\n            float inv_dist0 = 1 / sqrt(sqrd_dist0);\n            float inv_dist1 = 1 / sqrt(sqrd_dist1);\n            float inv_dist30 = inv_dist0 * inv_dist0 * inv_dist0;\n            float inv_dist31 = inv_dist1 * inv_dist1 * inv_dist1;\n\n            fxi[lane] += dx0 * inv_dist30;\n            fyi[lane] += dy0 * inv_dist30;\n            fzi[lane] += dz0 * inv_dist30;\n            fxi[lane] += dx1 * inv_dist31;\n            fyi[lane] += dy1 * inv_dist31;\n            fzi[lane] += dz1 * inv_dist31;\n          }\n        }\n\n        if (j < je) {\n          const float jx = x[j];\n          const float jy = y[j];\n          const float jz = z[j];\n\n          #pragma omp simd simdlen(4)\n          for (int lane = 0; lane < 4; ++lane) {\n            float dx = jx - tx[lane];\n            float dy = jy - ty[lane];\n            float dz = jz - tz[lane];\n            float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n            float inv_dist = 1 / sqrt(sqrd_dist);\n            float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n            fxi[lane] += dx * inv_dist3;\n            fyi[lane] += dy * inv_dist3;\n            fzi[lane] += dz * inv_dist3;\n          }\n        }\n\n        #pragma omp simd simdlen(4)\n        for (int lane = 0; lane < 4; ++lane) {\n          fx[k + lane] = fxi[lane];\n          fy[k + lane] = fyi[lane];\n          fz[k + lane] = fzi[lane];\n        }\n      }\n\n      for (; k < ni; ++k) {\n        const int i = ib + k;\n        const float xi = x[i];\n        const float yi = y[i];\n        const float zi = z[i];\n        float fxi = fx[k];\n        float fyi = fy[k];\n        float fzi = fz[k];\n\n        for (int j = jb; j < je; ++j) {\n          float dx = x[j] - xi;\n          float dy = y[j] - yi;\n          float dz = z[j] - zi;\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          float inv_dist = 1 / sqrt(sqrd_dist);\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n          fxi += dx * inv_dist3;\n          fyi += dy * inv_dist3;\n          fzi += dz * inv_dist3;\n        }\n\n        fx[k] = fxi;\n        fy[k] = fyi;\n        fz[k] = fzi;\n      }\n\n      jb = je;\n    }\n\n    for (int k = 0; k < ni; ++k) {\n      p[ib + k].vx += dt*fx[k];\n      p[ib + k].vy += dt*fy[k];\n      p[ib + k].vz += dt*fz[k];\n    }\n  }\n}\n\n/* Independent calls own their scratch storage and OpenMP team. */\nvoid body_force(Body *p, float dt, int n) {\n  if (n <= 0) {\n    return;\n  }\n\n  float *positions = allocate_positions(n);\n  #pragma omp parallel\n  {\n    body_force_work(p, dt, n, positions);\n  }\n  free(positions);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n  float *positions = allocate_positions(nbodies);\n\n  /* Packing, force calculation and integration retain their phase barriers. */\n  #pragma omp parallel\n  {\n    for (int iter = 0; iter < N_ITER; iter++) {\n      body_force_work(bodies, DT, nbodies, positions);\n\n      #pragma omp for schedule(static)\n      for (int i = 0; i < nbodies; i++) {\n        bodies[i].x += bodies[i].vx * DT;\n        bodies[i].y += bodies[i].vy * DT;\n        bodies[i].z += bodies[i].vz * DT;\n      }\n    }\n  }\n\n  free(positions);\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
        "path": "src/nbody.c"
      }

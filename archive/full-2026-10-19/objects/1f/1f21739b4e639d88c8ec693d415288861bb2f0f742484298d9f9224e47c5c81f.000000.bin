#include "knn.h"
#include <stdint.h>
#include <stddef.h>

typedef struct {
    float distance;
    size_t order;
    char label;
} Candidate;

static int compare_candidates(const void *a, const void *b) {
    const Candidate *left = (const Candidate *)a;
    const Candidate *right = (const Candidate *)b;

    if (left->distance < right->distance) return -1;
    if (left->distance > right->distance) return 1;
    if (left->order < right->order) return -1;
    if (left->order > right->order) return 1;
    return 0;
}

static char choose_label(char *labels, int k) {
    int i;
    qsort(labels, k, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }
            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    return most_frequent;
}

static char knn_serial(int n_groups, Group *groups, int k, Point to_evaluate) {
    char *labels = (char *)malloc(sizeof(char) * k);
    float *distances = (float *)malloc(sizeof(float) * k);
    int i, j, x, y;

    for (i = 0; i < k; i++) {
        labels[i] = -1;
        distances[i] = -1;
    }

    for (i = 0; i < n_groups; i++) {
        Group g = groups[i];

        for (j = 0; j < g.length; j++) {
            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);

            for (x = 0; x < k; x++) {
                if (d < distances[x] || distances[x] == -1) {
                    for (y = k - 1; y > x; y--) {
                        distances[y] = distances[y - 1];
                        labels[y] = labels[y - 1];
                    }
                    distances[x] = d;
                    labels[x] = g.label;
                    break;
                }
            }
        }
    }

    char result = choose_label(labels, k);
    free(labels);
    free(distances);
    return result;
}

char knn(int n_groups, Group *groups, int k, Point to_evaluate) {
    size_t total_points = 0;
    int can_count_points = 1;

    for (int i = 0; i < n_groups; i++) {
        if (groups[i].length < 0 ||
            (size_t)groups[i].length > SIZE_MAX - total_points) {
            can_count_points = 0;
            break;
        }
        total_points += (size_t)groups[i].length;
    }

    size_t log_cutoff = 0;
    for (size_t remaining = total_points; remaining > 1;
         remaining = remaining / 2 + remaining % 2) {
        log_cutoff++;
    }
    if (log_cutoff < 16) log_cutoff = 16;

    if (can_count_points && k > 0 && total_points >= 4096 &&
        (size_t)k >= log_cutoff && (size_t)k <= total_points &&
        total_points <= SIZE_MAX / sizeof(Candidate) &&
        total_points <= SIZE_MAX / sizeof(Point)) {
        Candidate *candidates =
            (Candidate *)malloc(sizeof(Candidate) * total_points);
        Point *points = (Point *)malloc(sizeof(Point) * total_points);
        char *labels = (char *)malloc(sizeof(char) * k);

        if (candidates != NULL && points != NULL && labels != NULL) {
            size_t at = 0;
            for (int i = 0; i < n_groups; i++) {
                for (int j = 0; j < groups[i].length; j++) {
                    points[at] = groups[i].points[j];
                    candidates[at].order = at;
                    candidates[at].label = groups[i].label;
                    at++;
                }
            }

            #pragma omp parallel for schedule(static)
            for (size_t i = 0; i < total_points; i++) {
                candidates[i].distance =
                    euclidean_distance_no_sqrt(to_evaluate, points[i]);
            }

            free(points);
            qsort(candidates, total_points, sizeof(Candidate), compare_candidates);
            for (int i = 0; i < k; i++) {
                labels[i] = candidates[i].label;
            }

            char result = choose_label(labels, k);
            free(labels);
            free(candidates);
            return result;
        }

        free(candidates);
        free(points);
        free(labels);
    }

    return knn_serial(n_groups, groups, k, to_evaluate);
}

int main() {
    int n_groups = parse_number_of_groups();
    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();
    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

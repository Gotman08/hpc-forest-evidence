{
  "arch": "armgpu",
  "partition": "short",
  "nodes": 1,
  "ntasks_per_node": 1,
  "cpus_per_task": 4,
  "mem_gb": 16,
  "gpus_per_node": 0,
  "time_limit": "03:00:00",
  "cpu_bind": "cores",
  "spack_packages": [],
  "name": "forest-primes-astra-max-r2c",
  "workdir": "/scratch_p/nimarano",
  "command": "set -euo pipefail\n[[ ${SLURM_JOB_ID:-} =~ ^[0-9]+$ ]] || exit 70\n[[ ${SLURM_JOB_NUM_NODES:-} == 1 && ${SLURM_NTASKS:-} == 1 && ${SLURM_CPUS_PER_TASK:-} == 4 && ${SLURM_MEM_PER_NODE:-} == 16384 ]] || exit 71\n[[ ${SLURM_RESTART_COUNT:-0} == 0 ]] || exit 72\nexport PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=4\nsrun --nodes=1 --ntasks=1 --cpus-per-task=4 --mem=16G --cpu-bind=cores --time=03:00:00 /scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python -I -B -u - <<'ONE_SELECTED_MAX_CELL_PREFLIGHT'\n\"\"\"Future allocated entry: exactly one selected MAX cell; never a model loop.\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport os\nimport platform\nimport re\nimport shlex\nimport sys\nimport zipfile\nfrom datetime import UTC, datetime, timedelta\nfrom pathlib import Path\n\nCELL = {'scope_id': 'hpc-forest-primes-native-max-r2c', 'model': 'gpt-6-astra', 'effort': 'max', 'session_id': '979ef61f50d041639c1cd46e1942a3f3', 'source_sha256': 'ade344bfec4322e8aaecc99cfbf7bd502e6d39b55c62180e8f552a3d6391e680', 'plan_sha256': 'bac579fdb44850c636a6522c014175f95d4ce867bab502d86dd15c1bff31032e', 'runtime_sha256': '20802c1855c983954c2af5d21d336cc14e7b8964a1ab5d40aec38c6ba1c37c5d', 'source_members': 103, 'remote_extraction': '/scratch_p/nimarano/hpc-forest-primes-native-contract-qualification-20261018-r2c-b64b297c0d15/extraction', 'remote_root': '/scratch_p/nimarano/hpc-forest-primes-native-max-r2c-979ef61f50d041639c1cd46e1942a3f3', 'admission_root': '/scratch_p/nimarano/hpc-forest-primes-native-max-r2c-admission-979ef61f50d041639c1cd46e1942a3f3', 'source_zip_name': 'HPC-Forest-Primes-Natif-MAX-r2c.zip', 'cells': {'gpt-6-astra': '979ef61f50d041639c1cd46e1942a3f3', 'gpt-5.6-terra': 'a35692d6da3f46278fe3840f5c56984e', 'gpt-6.1-sol': '0fbe579c95f74ec7b90ebe702877434b'}, 'maximum_native_workers': 4}  # noqa: F821 - replaced as one literal, never imported locally\nPYTHON = '/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python'\nSPACK_GCC = '/zrtbeqke25s2vbqo4yrhsowjz7mg3pjf'\nDEADLINE = datetime(2026, 10, 31, 23, tzinfo=UTC)\n\n\ndef require(ok, message):\n    if not ok:\n        raise RuntimeError(message)\n\n\ndef sha(path):\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\n\nenv = os.environ\nrequire(platform.system() == 'Linux' and platform.machine().lower() in {'aarch64', 'arm64'}, 'Own Linux ARM64 allocation required')\nrequire(re.fullmatch('[0-9]+', env.get('SLURM_JOB_ID', '')), 'Actual Slurm job required')\nrequired = {'SLURM_JOB_NUM_NODES': '1', 'SLURM_NTASKS': '1', 'SLURM_CPUS_PER_TASK': '4', 'SLURM_MEM_PER_NODE': '16384'}\nrequire(all(env.get(k) == v for k, v in required.items()), 'Exact1node/1task/4CPU/16Gi allocation required')\nrequire(env.get('SLURM_RESTART_COUNT', '0') == '0', 'Never replay a native attempt')\nrequire(all(env.get(k, '') in {'', '0'} for k in ('SLURM_GPUS', 'SLURM_GPUS_PER_NODE', 'SLURM_JOB_GPUS', 'SLURM_STEP_GPUS', 'CUDA_VISIBLE_DEVICES')), 'Zero GPU required')\nrequire(hasattr(os, 'sched_getaffinity') and len(os.sched_getaffinity(0)) == 4, 'Exactly four effective CPUs required')\nrequire(datetime.now(UTC) + timedelta(seconds=21600) < DEADLINE, 'Exclusive deadline reserve insufficient')\nrequire(Path(sys.executable).resolve() == Path(PYTHON).resolve(), 'Exact existing ARM64 Python required')\nroot, admission = Path(CELL['remote_root']), Path(CELL['admission_root'])\nrequire(not root.exists() and not root.is_symlink(), 'Fresh selected native root required')\nrequire(not admission.exists() and not admission.is_symlink(), 'Fresh selected admission root required')\nextraction = Path(CELL['remote_extraction'])\nsource_zip = extraction / CELL['source_zip_name']\nplan_path, runtime = extraction / 'native-max-plan.json', extraction / 'runtime-manifest-r2max.json'\nfor path, expected in ((source_zip, CELL['source_sha256']), (plan_path, CELL['plan_sha256']), (runtime, CELL['runtime_sha256'])):\n    require(path.is_file() and not path.is_symlink() and sha(path) == expected, 'Changed qualified source/plan/runtime')\nproject = extraction / 'HPC-Forest'\nexpected = json.loads(runtime.read_bytes())\nactual = {p.relative_to(project).as_posix(): p for p in project.rglob('*') if p.is_file()\n          and not any(x in {'__pycache__', '.pytest_cache', '.ruff_cache'} for x in p.relative_to(project).parts)}\nrequire(len(expected) == CELL['source_members'] and set(actual) == set(expected)\n        and all(not p.is_symlink() and sha(p) == expected[n] for n, p in actual.items()), 'Exact new qualified runtime required')\nwith zipfile.ZipFile(source_zip) as archive:\n    names = archive.namelist()\n    require(len(names) == len(set(names)) == CELL['source_members'], 'Exact source ZIP membership required')\n    require(all(n.startswith('HPC-Forest/') and n.removeprefix('HPC-Forest/') in actual\n                and archive.read(n) == actual[n.removeprefix('HPC-Forest/')].read_bytes() for n in names), 'Source ZIP/runtime divergence')\nplan = json.loads(plan_path.read_bytes())\nrequire(plan.get('scope_id') == CELL['scope_id'] and plan.get('source_zip_sha256') == CELL['source_sha256']\n        and plan.get('cells') == CELL['cells'] and plan.get('maximum_native_workers_total') == 4\n        and plan.get('maximum_cells_per_authorization') == 1 and plan.get('efforts') == ['max']\n        and plan.get('automatic_extension') is False and CELL['model'] in CELL['cells']\n        and CELL['session_id'] == CELL['cells'][CELL['model']], 'Actual cap4 plan and selected closed MAX identity required')\nsys.path.insert(0, str(project / 'src'))\nfrom hpc_forest.native_r2max import allocation_guard, verify_runtime\n\nallocation = allocation_guard()\nverify_runtime(source_zip)\nrequire(not root.exists() and not root.is_symlink(), 'Native root must remain absent before wait')\nrequire(admission.parent == Path('/scratch_p/nimarano') and admission.name == CELL['scope_id'] + '-admission-' + CELL['session_id'], 'Exact selected admission directory required')\nadmission.mkdir(mode=0o700, exist_ok=False)\nmarker = {'schema': 'hpc-forest-max-cell-allocation-ready-v1', 'verified': True,\n          'scope_id': CELL['scope_id'], 'model': CELL['model'], 'effort': 'max', 'session_id': CELL['session_id'],\n          'job_id': allocation['job_id'], 'source_zip_sha256': CELL['source_sha256'], 'plan_sha256': CELL['plan_sha256'],\n          'allocation': allocation, 'native_root': str(root), 'admission_root': str(admission),\n          'native_root_absent_before_wait': True, 'native_model_calls': 0, 'source_files_verified': CELL['source_members'],\n          'maximum_native_workers': 4, 'authorization_still_required': True, 'utc': datetime.now(UTC).isoformat()}\nwith (admission / 'allocation-ready.json').open('x', encoding='utf8') as stream:\n    json.dump(marker, stream, sort_keys=True)\n    stream.flush()\n    os.fsync(stream.fileno())\nprint(json.dumps(marker), flush=True)\nwait_argv = [PYTHON, '-I', '-B', '-u', str(project / 'examples/marathon22/wait_r2max_authorization.py'),\n    '--root', str(root), '--authorization', str(admission / 'authorization.json'),\n    '--authorization-ready', str(admission / 'authorization-ready.json'), '--wait-seconds', '600']\ncommand = 'set -euo pipefail\\nromeo_load_armgpu_env\\nspack load ' + shlex.quote(SPACK_GCC) + '\\nexec ' + shlex.join(wait_argv)\nchild = {**env, 'PYTHONDONTWRITEBYTECODE': '1', 'PYTHONUNBUFFERED': '1', 'OPENBLAS_NUM_THREADS': '1',\n         'MKL_NUM_THREADS': '1', 'NUMEXPR_NUM_THREADS': '1', 'OMP_NUM_THREADS': '4', 'OMP_DYNAMIC': 'FALSE',\n         'OMP_PROC_BIND': 'close', 'OMP_PLACES': 'cores', 'CUDA_VISIBLE_DEVICES': ''}\nos.execvpe('/bin/bash', ['/bin/bash', '-lc', command], child)\nONE_SELECTED_MAX_CELL_PREFLIGHT\n"
}

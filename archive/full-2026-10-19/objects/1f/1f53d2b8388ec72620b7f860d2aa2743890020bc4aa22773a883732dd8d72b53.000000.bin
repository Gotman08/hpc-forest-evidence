#include "knn.h"
#include <arm_neon.h>

static void sift_up(float *dist, char *label, int *seq, int idx) {
    while (idx > 0) {
        int parent = (idx - 1) / 2;
        if (dist[idx] > dist[parent] ||
            (dist[idx] == dist[parent] && seq[idx] > seq[parent])) {
            float td = dist[idx]; dist[idx] = dist[parent]; dist[parent] = td;
            char tl = label[idx]; label[idx] = label[parent]; label[parent] = tl;
            int ts = seq[idx]; seq[idx] = seq[parent]; seq[parent] = ts;
            idx = parent;
        } else {
            break;
        }
    }
}

static void sift_down(float *dist, char *label, int *seq, int size, int idx) {
    while (1) {
        int left = 2 * idx + 1;
        int right = left + 1;
        int largest = idx;
        if (left < size &&
            (dist[left] > dist[largest] ||
             (dist[left] == dist[largest] && seq[left] > seq[largest]))) {
            largest = left;
        }
        if (right < size &&
            (dist[right] > dist[largest] ||
             (dist[right] == dist[largest] && seq[right] > seq[largest]))) {
            largest = right;
        }
        if (largest != idx) {
            float td = dist[idx]; dist[idx] = dist[largest]; dist[largest] = td;
            char tl = label[idx]; label[idx] = label[largest]; label[largest] = tl;
            int ts = seq[idx]; seq[idx] = seq[largest]; seq[largest] = ts;
            idx = largest;
        } else {
            break;
        }
    }
}

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    float *heap_dist = (float *) malloc(sizeof(float) * k);
    char *heap_label = (char *) malloc(sizeof(char) * k);
    int *heap_seq = (int *) malloc(sizeof(int) * k);

    int heap_size = 0;
    int point_seq = 0;

    int i, j, t;

    for (i = 0; i < n_groups; i++) {
        Group g = groups[i];

        // Process points in batches of four using NEON
        for (j = 0; j + 3 < g.length; j += 4) {
            float32x4x2_t pts = vld2q_f32((const float32_t *)&g.points[j]);
            float32x4_t xs = pts.val[0];
            float32x4_t ys = pts.val[1];
            float32x4_t qx = vdupq_n_f32(to_evaluate.x);
            float32x4_t qy = vdupq_n_f32(to_evaluate.y);
            float32x4_t dx = xs - qx;
            float32x4_t dy = ys - qy;
            float32x4_t d2 = dx * dx + dy * dy;
            float d[4];
            vst1q_f32(d, d2);

            for (t = 0; t < 4; t++) {
                int cur_seq = point_seq++;
                if (heap_size < k) {
                    heap_dist[heap_size] = d[t];
                    heap_label[heap_size] = g.label;
                    heap_seq[heap_size] = cur_seq;
                    sift_up(heap_dist, heap_label, heap_seq, heap_size);
                    heap_size++;
                } else if (d[t] < heap_dist[0]) {
                    heap_dist[0] = d[t];
                    heap_label[0] = g.label;
                    heap_seq[0] = cur_seq;
                    sift_down(heap_dist, heap_label, heap_seq, k, 0);
                }
            }
        }

        // Scalar remainder
        for (; j < g.length; j++) {
            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);
            int cur_seq = point_seq++;
            if (heap_size < k) {
                heap_dist[heap_size] = d;
                heap_label[heap_size] = g.label;
                heap_seq[heap_size] = cur_seq;
                sift_up(heap_dist, heap_label, heap_seq, heap_size);
                heap_size++;
            } else if (d < heap_dist[0]) {
                heap_dist[0] = d;
                heap_label[0] = g.label;
                heap_seq[0] = cur_seq;
                sift_down(heap_dist, heap_label, heap_seq, k, 0);
            }
        }
    }

    char *labels = (char *) malloc(sizeof(char) * k);

    for (i = 0; i < k; i++) {
        if (i < heap_size) {
            labels[i] = heap_label[i];
        } else {
            labels[i] = -1;
        }
    }

    qsort(labels, k, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }
            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    free(heap_dist);
    free(heap_label);
    free(heap_seq);
    free(labels);

    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

#include "knn.h"
#include <immintrin.h>

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    char * labels = (char *) malloc(sizeof(char) * k);
    float * distances = (float *) malloc(sizeof(float) * k);

    int i, j, x, y;

    for (i = 0; i < k; i++) {
        labels[i] = -1;
        distances[i] = -1;
    }

    for (i = 0; i < n_groups; i++) {
        Group g = groups[i];

        for (j = 0; j < g.length; j += 4) { // Process 4 points at a time
            __m128 x_diff, y_diff, dist_sq;
            __m128 to_eval_x = _mm_set1_ps(to_evaluate.x);
            __m128 to_eval_y = _mm_set1_ps(to_evaluate.y);
            float distances_local[4];

            for (x = 0; x < 4 && j + x < g.length; x++) {
                x_diff = _mm_sub_ps(_mm_set1_ps(g.points[j + x].x), to_eval_x);
                y_diff = _mm_sub_ps(_mm_set1_ps(g.points[j + x].y), to_eval_y);
                dist_sq = _mm_add_ps(_mm_mul_ps(x_diff, x_diff), _mm_mul_ps(y_diff, y_diff));
                _mm_storeu_ps(distances_local + x, dist_sq);
            }

            for (x = 0; x < 4 && j + x < g.length; x++) {
                float d = distances_local[x];

                for (y = k - 1; y > 0; y--) {
                    if (d < distances[y] || distances[y] == -1) {
                        distances[y] = distances[y - 1];
                        labels[y] = labels[y - 1];
                    } else {
                        break;
                    }
                }

                if (y >= 0 && (d < distances[y] || distances[y] == -1)) {
                    distances[y] = d;
                    labels[y] = g.label;
                }
            }
        }
    }

    qsort(labels, k, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }

            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}
"""Read-only, nonce-deduplicated token accounting. Never a generation context."""
from __future__ import annotations

import collections
import csv
import hashlib
import json
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent
OUTPUTS = ROOT.parent


def load(path):
    return json.loads(path.read_text(encoding="utf-8-sig"))


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def optional_total(events, key):
    return sum(e[key] for e in events) if events and all(type(e.get(key)) is int for e in events) else None


def campaign(path):
    text = path.as_posix()
    if "/runs/" in text:
        return "grille-r1/" + text.split("/runs/", 1)[1].split("/", 1)[0]
    relative = path.relative_to(OUTPUTS / "Marathon22-GPT61Sol-MAX")
    return "/".join(relative.parts[:2]) if "worker" not in relative.parts[:2] else relative.parts[0]


def main():
    invocations = []
    for folder in [OUTPUTS / "Marathon22-GPT61Sol-MAX",
                   OUTPUTS / "HPC-Forest-Etude-2020-2024-r1/runs"]:
        invocations.extend(folder.rglob("invocation.json"))
    records, conflicts, skipped = {}, [], []
    for inv in sorted(invocations):
        request_file, response_file = inv.parent / "request.json", inv.parent / "response.json"
        if not request_file.exists():
            continue
        try:
            request, invocation = load(request_file), load(inv)
            if not request.get("nonce") or not request.get("session_id"):
                continue
            response = load(response_file) if response_file.exists() else {}
        except (OSError, ValueError) as exc:
            skipped.append({"path": str(inv), "reason": str(exc)})
            continue
        assert invocation["model"] == request["model"]
        assert invocation["reasoning_effort"] == request["reasoning_effort"]
        usage = response.get("usage") or {}
        events = usage.get("events") or []
        input_tokens, output_tokens = optional_total(events, "input_tokens"), optional_total(events, "output_tokens")
        exact = usage.get("token_accounting") == "exact" and input_tokens is not None and output_tokens is not None
        if exact:
            assert usage["tokens"] == input_tokens + output_tokens
        kind = "mère" if str(request.get("meta_role", "")).startswith("mother-") else (
            "intégration" if request.get("integration_source_ids") else "enfant")
        technical = not request.get("mission_id") or any(v in inv.parts for v in ["validation-native", "validation-interface", "validation-cli"])
        item = {"session_id": request["session_id"], "nonce": request["nonce"],
                "campaign": campaign(inv), "model": request["model"], "effort": request["reasoning_effort"],
                "kind": kind, "technical": technical, "mission_id": request.get("mission_id", "technical-no-mission-id"),
                "state": "exact" if exact else "pending" if not response else "unmetered_or_budget_bound",
                "input_tokens": input_tokens if exact else None, "output_tokens": output_tokens if exact else None,
                "exact_total": input_tokens + output_tokens if exact else None,
                "cached_input_tokens": optional_total(events, "cached_input_tokens") if exact else None,
                "reasoning_output_tokens": optional_total(events, "reasoning_output_tokens") if exact else None,
                "budget_charge_for_unmetered": usage.get("tokens") if response and not exact else None,
                "error": response.get("error"), "request_path": str(request_file.resolve()),
                "request_file_sha256": sha(request_file), "response_path": str(response_file.resolve()) if response else None,
                "response_file_sha256": sha(response_file) if response else None}
        if exact:
            assert item["cached_input_tokens"] is None or 0 <= item["cached_input_tokens"] <= input_tokens
            assert item["reasoning_output_tokens"] is None or 0 <= item["reasoning_output_tokens"] <= output_tokens
        key = item["session_id"], item["nonce"]
        previous = records.get(key)
        if previous:
            if previous["state"] == item["state"] == "exact" and any(
                    previous[k] != item[k] for k in ["model", "effort", "exact_total", "input_tokens", "output_tokens"]):
                conflicts.append({"previous": previous, "new": item})
            if previous["state"] == "exact" or item["state"] != "exact":
                continue
        records[key] = item
    if conflicts:
        (ROOT / "conflits-tokens.json").write_text(json.dumps(conflicts, indent=2), encoding="utf-8")
        raise RuntimeError("Conflicting exact records: no total may be published")
    calls = list(records.values())
    groups = collections.defaultdict(list)
    for row in calls:
        groups[row["model"], row["effort"], row["campaign"]].append(row)
    grouped = []
    for (model, effort, scope), rows in sorted(groups.items()):
        measured = [r for r in rows if r["state"] == "exact"]
        total = sum(r["exact_total"] for r in measured)
        mother = sum(r["exact_total"] for r in measured if r["kind"] == "mère")
        grouped.append({"model": model, "effort": effort, "campaign": scope, "started_calls": len(rows),
            "exact_calls": len(measured), "unmetered_calls": sum(r["state"] == "unmetered_or_budget_bound" for r in rows),
            "pending_calls": sum(r["state"] == "pending" for r in rows),
            "input_tokens": sum(r["input_tokens"] for r in measured),
            "output_tokens": sum(r["output_tokens"] for r in measured), "exact_total": total,
            "cached_input_tokens": sum(r["cached_input_tokens"] for r in measured) if all(r["cached_input_tokens"] is not None for r in measured) else None,
            "reasoning_output_tokens": sum(r["reasoning_output_tokens"] for r in measured) if all(r["reasoning_output_tokens"] is not None for r in measured) else None,
            "mother_tokens": mother, "integration_tokens": sum(r["exact_total"] for r in measured if r["kind"] == "intégration"),
            "child_tokens": sum(r["exact_total"] for r in measured if r["kind"] == "enfant"),
            "mother_fraction_of_known": mother / total if total else None,
            "mean_per_exact_call": total / len(measured) if measured else None,
            "unmetered_budget_charge": sum(r["budget_charge_for_unmetered"] or 0 for r in rows),
            "technical_calls": sum(r["technical"] for r in rows),
            "entire_campaign_exact": len(measured) == len(rows)})
    history = [json.loads(line) for line in (OUTPUTS / "HPC-Forest-Etude-2020-2024-r1/historique-campagnes.jsonl").read_text(encoding="utf-8").splitlines()]
    historical_costs = [{"model": r["model"], "problem": r["problem"], "job_id": r["job_id"],
                         "source": r["summary_path"], "costs_as_recorded": r["costs"],
                         "interpretation": r["interpretation"]} for r in history if r.get("costs")]
    local_verified = []
    seen_local = set()
    for path in sorted((OUTPUTS / "Marathon22-DeepSeek-v11/receptions").glob("audits-*/audit-complet.json")):
        audited = load(path)
        assert audited["verified"] and audited["coverage_verified"]
        assert audited["job_id"] not in seen_local
        seen_local.add(audited["job_id"])
        local_verified.append({"job_id": audited["job_id"], "model": audited["model"],
            "audit_path": str(path.resolve()), "audit_sha256": sha(path),
            "exact_tokens": audited["exact_total_tokens"], "problems": [
                {key: p[key] for key in ["problem", "model_calls", "input_tokens", "output_tokens", "exact_tokens",
                                        "decode_tokens_per_second_weighted", "decode_seconds_sum"]}
                for p in audited["problems"]]})
    data = {"schema": "hpc-forest-token-accounting-v1", "observed_utc": datetime.now(timezone.utc).isoformat(),
            "native_unique_calls": len(calls), "native_exact_total": sum(r["exact_total"] or 0 for r in calls),
            "native_unmetered_calls": sum(r["state"] == "unmetered_or_budget_bound" for r in calls),
            "native_pending_calls": sum(r["state"] == "pending" for r in calls),
            "native_calls": calls, "native_campaigns": grouped, "historical_cost_ledgers": historical_costs,
            "verified_local_deepseek_campaigns": local_verified,
            "concurrent_files_not_yet_readable": skipped,
            "cached_input_is_subset_of_input": True, "reasoning_output_is_subset_of_output": True,
            "budget_charges_are_not_exact_service_usage": True,
            "lower_bound_when_any_unmetered_or_pending": True,
            "operator_report_is_never_model_input": True}
    (ROOT / "tokens-par-modele.json").write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    with (ROOT / "tokens-par-campagne.csv").open("w", newline="", encoding="utf-8-sig") as stream:
        writer = csv.DictWriter(stream, fieldnames=list(grouped[0]));writer.writeheader();writer.writerows(grouped)
    print(json.dumps({k: data[k] for k in ["observed_utc", "native_unique_calls", "native_exact_total", "native_unmetered_calls", "native_pending_calls"]}))


if __name__ == "__main__":
    main()

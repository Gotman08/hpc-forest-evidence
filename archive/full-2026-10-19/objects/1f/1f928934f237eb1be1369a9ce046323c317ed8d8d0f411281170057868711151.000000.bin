{
  "src/solution.cpp": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <limits>\n#include <memory>\n\nusing Sum = std::int64_t;\n\nclass FastInput {\n    alignas(64) unsigned char buffer_[1u << 16];\n    std::size_t position_ = 0;\n    std::size_t length_ = 0;\n\n    int getChar() {\n        if (position_ == length_) {\n            length_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (length_ == 0) return EOF;\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    bool readInt(int& value) {\n        int c;\n        do {\n            c = getChar();\n            if (c == EOF) return false;\n        } while (c <= ' ');\n\n        const bool negative = c == '-';\n        if (c == '-' || c == '+') c = getChar();\n        std::uint32_t magnitude = 0;\n        while (c >= '0' && c <= '9') {\n            magnitude = magnitude * 10u + static_cast<unsigned>(c - '0');\n            c = getChar();\n        }\n        const Sum signedValue = negative ? -static_cast<Sum>(magnitude)\n                                         : static_cast<Sum>(magnitude);\n        value = static_cast<int>(signedValue);\n        return true;\n    }\n\n    int nextInt() {\n        int value = 0;\n        readInt(value);\n        return value;\n    }\n};\n\nclass WindowSweep {\n    int n_;\n    int side_;\n    int shifts_;\n    int leading_;\n    int commonColumns_;\n    int width_;\n    std::unique_ptr<int[]> history_;\n    std::unique_ptr<Sum[]> commonHistory_;\n    std::unique_ptr<Sum[]> vertical_;\n    Sum commonTotal_;\n    Sum best_;\n\n    void inspectWindows() {\n        const Sum* columns = vertical_.get();\n        Sum sum = commonTotal_;\n        for (int j = 0; j < leading_; ++j) sum += columns[j];\n        Sum maximum = sum;\n\n        int j = 0;\n        for (; j + 8 <= shifts_; j += 8) {\n            const Sum d0 = columns[j + leading_] - columns[j];\n            const Sum d1 = columns[j + leading_ + 1] - columns[j + 1];\n            const Sum d2 = columns[j + leading_ + 2] - columns[j + 2];\n            const Sum d3 = columns[j + leading_ + 3] - columns[j + 3];\n            const Sum d4 = columns[j + leading_ + 4] - columns[j + 4];\n            const Sum d5 = columns[j + leading_ + 5] - columns[j + 5];\n            const Sum d6 = columns[j + leading_ + 6] - columns[j + 6];\n            const Sum d7 = columns[j + leading_ + 7] - columns[j + 7];\n\n            const Sum p01 = d0 + d1;\n            const Sum p23 = d2 + d3;\n            const Sum p45 = d4 + d5;\n            const Sum p67 = d6 + d7;\n            const Sum p03 = p01 + p23;\n            const Sum p47 = p45 + p67;\n\n            const Sum w0 = sum + d0;\n            const Sum w1 = sum + p01;\n            const Sum w2 = sum + (p01 + d2);\n            const Sum w3 = sum + p03;\n            const Sum w4 = sum + (p03 + d4);\n            const Sum w5 = sum + (p03 + p45);\n            const Sum w6 = sum + (p03 + (p45 + d6));\n            const Sum w7 = sum + (p03 + p47);\n\n            const Sum first = std::max(std::max(w0, w1), std::max(w2, w3));\n            const Sum second = std::max(std::max(w4, w5), std::max(w6, w7));\n            maximum = std::max(maximum, std::max(first, second));\n            sum = w7;\n        }\n        for (; j < shifts_; ++j) {\n            sum += columns[j + leading_] - columns[j];\n            maximum = std::max(maximum, sum);\n        }\n        best_ = std::max(best_, maximum);\n    }\n\n    template<bool Remove, bool Save>\n    void readRow(FastInput& input, int row) {\n        const int* outgoing = nullptr;\n        int* retained = nullptr;\n        std::size_t savedSlot = 0;\n        if (Remove) {\n            const std::size_t oldSlot =\n                static_cast<std::size_t>((row - side_) % leading_);\n            outgoing = history_.get() + oldSlot * width_;\n            commonTotal_ -= commonHistory_[oldSlot];\n        }\n        if (Save) {\n            savedSlot = static_cast<std::size_t>(row % leading_);\n            retained = history_.get() + savedSlot * width_;\n        }\n\n        Sum* columns = vertical_.get();\n        for (int j = 0; j < leading_; ++j) {\n            const int value = input.nextInt();\n            Sum delta = value;\n            if (Remove) delta -= outgoing[j];\n            columns[j] += delta;\n            if (Save) retained[j] = value;\n        }\n\n        // These columns occur in every horizontal window and need only one sum.\n        Sum common = 0;\n        for (int j = 0; j < commonColumns_; ++j) {\n            common += input.nextInt();\n        }\n\n        for (int j = leading_; j < width_; ++j) {\n            const int value = input.nextInt();\n            Sum delta = value;\n            if (Remove) delta -= outgoing[j];\n            columns[j] += delta;\n            if (Save) retained[j] = value;\n        }\n\n        commonTotal_ += common;\n        if (Save) commonHistory_[savedSlot] = common;\n        if (row + 1 >= side_) inspectWindows();\n    }\n\npublic:\n    WindowSweep(int n, int side)\n        : n_(n), side_(side), shifts_(n - side),\n          leading_(std::min(side, n - side)),\n          commonColumns_(side - leading_),\n          width_(n - commonColumns_),\n          history_(new int[static_cast<std::size_t>(leading_) * width_]),\n          commonHistory_(new Sum[leading_]),\n          vertical_(new Sum[width_]()),\n          commonTotal_(0), best_(std::numeric_limits<Sum>::lowest()) {}\n\n    Sum run(FastInput& input) {\n        int row = 0;\n        for (; row < leading_; ++row) readRow<false, true>(input, row);\n\n        if (side_ <= shifts_) {\n            // Reuse each outgoing row's slot until no future window needs it.\n            for (; row < shifts_; ++row) readRow<true, true>(input, row);\n            for (; row < n_; ++row) readRow<true, false>(input, row);\n        } else {\n            // Middle rows never leave any valid vertical window.\n            for (; row < side_; ++row) readRow<false, false>(input, row);\n            for (; row < n_; ++row) readRow<true, false>(input, row);\n        }\n        return best_;\n    }\n};\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.readInt(n) || !input.readInt(s)) return 0;\n    assert(s > 0 && s < n && n < 8000);\n\n    WindowSweep sweep(n, s);\n    const Sum answer = sweep.run(input);\n    std::printf(\"%lld\\n\", static_cast<long long>(answer));\n    return 0;\n}\n"
}

        "content": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <iterator>\n#include <string>\n#include <vector>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ')\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v');\n    }\n};\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase(std::remove_if(text.begin(), text.end(), IsWhitespace()),\n               text.end());\n    return text;\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator<char> begin(in), end;\n    std::string text(begin, end);\n    text = remove_whitespaces(text);\n    return text;\n}\n\nnamespace\n{\nconst std::size_t block_bytes = 256u * 1024u;\n\nchar* format_permutation(char* out, const std::string& text)\n{\n    *out++ = '[';\n    *out++ = ' ';\n    for (std::size_t i = 0; i < text.size(); ++i) {\n        *out++ = text[i];\n        *out++ = ' ';\n    }\n    *out++ = ']';\n    *out++ = '\\n';\n    return out;\n}\n\nclass BufferedPermutationWriter\n{\n    char buffer_[block_bytes];\n    std::size_t used_;\n\n    void put(char c)\n    {\n        if (used_ == block_bytes) flush();\n        buffer_[used_++] = c;\n    }\n\npublic:\n    BufferedPermutationWriter() : used_(0) {}\n\n    void flush()\n    {\n        if (used_ != 0) {\n            std::cout.write(buffer_, static_cast<std::streamsize>(used_));\n            used_ = 0;\n        }\n    }\n\n    void permutation(const std::string& text)\n    {\n        if (text.size() <= (block_bytes - 4) / 2) {\n            const std::size_t bytes = 2 * text.size() + 4;\n            if (bytes > block_bytes - used_) flush();\n            format_permutation(buffer_ + used_, text);\n            used_ += bytes;\n        } else {\n            // Stream unusually long records without allocating an entire row.\n            put('[');\n            put(' ');\n            for (std::size_t i = 0; i < text.size(); ++i) {\n                put(text[i]);\n                put(' ');\n            }\n            put(']');\n            put('\\n');\n        }\n    }\n};\n\nvoid write_sequential(std::string& text)\n{\n    BufferedPermutationWriter writer;\n    do {\n        writer.permutation(text);\n    } while (std::next_permutation(text.begin(), text.end()));\n    writer.flush();\n}\n\n#ifdef _OPENMP\nstruct PermutationTask\n{\n    std::string state;\n    std::size_t suffix;\n    std::size_t rows;\n    std::vector<char> output;\n};\n\nstd::size_t gcd_size(std::size_t a, std::size_t b)\n{\n    while (b != 0) {\n        const std::size_t remainder = a % b;\n        a = b;\n        b = remainder;\n    }\n    return a;\n}\n\nvoid choose_suffix(const std::string& text, std::size_t limit,\n                   std::size_t& first, std::size_t& rows)\n{\n    std::size_t frequencies[256] = {};\n    first = text.size();\n    rows = 1;\n    while (first != 0) {\n        const std::size_t candidate = first - 1;\n        if (first != text.size() && text[candidate] > text[first]) break;\n\n        const unsigned char symbol =\n            static_cast<unsigned char>(text[candidate]);\n        const std::size_t copies = ++frequencies[symbol];\n        const std::size_t length = text.size() - candidate;\n\n        // New multiset count is rows * length / copies. Cancel first\n        // and stop at the cap, avoiding factorials and overflowing products.\n        const std::size_t common = gcd_size(length, copies);\n        const std::size_t multiplier = length / common;\n        const std::size_t partial = rows / (copies / common);\n        if (partial > limit / multiplier) break;\n\n        rows = partial * multiplier;\n        first = candidate;\n    }\n}\n\nint prepare_wave(std::vector<PermutationTask>& tasks, std::string& cursor,\n                 bool& available, std::size_t row_limit)\n{\n    int count = 0;\n    while (available && count < static_cast<int>(tasks.size())) {\n        PermutationTask& task = tasks[count];\n        task.state = cursor;\n        choose_suffix(cursor, row_limit, task.suffix, task.rows);\n\n        // The selected suffix is sorted. Skip its complete subtree to\n        // obtain the first permutation of the next lexicographic task.\n        std::reverse(cursor.begin() + task.suffix, cursor.end());\n        available = std::next_permutation(cursor.begin(), cursor.end());\n        ++count;\n    }\n    return count;\n}\n\nvoid render_task(PermutationTask& task, std::size_t row_bytes)\n{\n    task.output.resize(task.rows * row_bytes);\n    char* out = task.output.data();\n    do {\n        out = format_permutation(out, task.state);\n    } while (std::next_permutation(task.state.begin() + task.suffix,\n                                   task.state.end()));\n}\n\nbool write_parallel(const std::string& sorted)\n{\n    const int requested_threads = omp_get_max_threads();\n    if (requested_threads < 2 || sorted.size() > (block_bytes - 4) / 2)\n        return false;\n\n    const std::size_t row_bytes = 2 * sorted.size() + 4;\n    const std::size_t row_limit =\n        std::min<std::size_t>(8192, block_bytes / row_bytes);\n    const int wave_slots = 16;\n    std::vector<PermutationTask> tasks(wave_slots);\n    std::string cursor = sorted;\n    bool available = true;\n    int task_count = prepare_wave(tasks, cursor, available, row_limit);\n\n    std::size_t initial_bytes = 0;\n    for (int i = 0; i < task_count; ++i)\n        initial_bytes += tasks[i].rows * row_bytes;\n    if (task_count < 2 || (!available && initial_bytes < block_bytes))\n        return false;\n\n    const int workers = std::min(requested_threads, task_count);\n    #pragma omp parallel num_threads(workers)\n    {\n        while (task_count != 0) {\n            #pragma omp for schedule(dynamic, 1)\n            for (int i = 0; i < task_count; ++i)\n                render_task(tasks[i], row_bytes);\n\n            #pragma omp single\n            {\n                // A wave owns all of its result slots before rendering.\n                // Later tasks cannot consume resources needed by earlier ones.\n                for (int i = 0; i < task_count; ++i) {\n                    const std::vector<char>& output = tasks[i].output;\n                    std::cout.write(output.data(),\n                                    static_cast<std::streamsize>(output.size()));\n                }\n                task_count = prepare_wave(tasks, cursor, available, row_limit);\n            }\n        }\n    }\n    return true;\n}\n#endif\n\nvoid write_permutations(std::string& text)\n{\n    if (text.empty()) return;\n    std::sort(text.begin(), text.end());\n#ifdef _OPENMP\n    if (write_parallel(text)) return;\n#endif\n    write_sequential(text);\n}\n}\n\nint main(int argc, char const* argv[])\n{\n    std::string text = read_text_from_stdin<std::string>(std::cin);\n    write_permutations(text);\n    return 0;\n}\n",
        "path": "src/permutations.cc"
      }

      "content": "#include \"knn.h\"\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\ntypedef struct {\n    size_t order;\n    float distance;\n    char label;\n} Neighbor;\n\ntypedef struct {\n    Neighbor *items;\n    size_t count;\n    size_t capacity;\n    size_t begin;\n    size_t end;\n} PartialTopK;\n\nstatic int neighbor_better(Neighbor a, Neighbor b) {\n    return a.distance < b.distance ||\n           (a.distance == b.distance && a.order < b.order);\n}\n\nstatic void heap_sift_down(Neighbor *items, size_t count,\n                           size_t position, Neighbor value) {\n    size_t child = position * 2 + 1;\n    while (child < count) {\n        if (child + 1 < count &&\n            neighbor_better(items[child], items[child + 1])) {\n            ++child;\n        }\n        if (!neighbor_better(value, items[child])) {\n            break;\n        }\n        items[position] = items[child];\n        position = child;\n        child = position * 2 + 1;\n    }\n    items[position] = value;\n}\n\nstatic void heap_build(Neighbor *items, size_t count) {\n    for (size_t parent = count / 2; parent > 0; --parent) {\n        heap_sift_down(items, count, parent - 1, items[parent - 1]);\n    }\n}\n\nstatic char label_with_most_votes(const size_t *frequencies) {\n    char winner = (char)CHAR_MIN;\n    size_t best = 0;\n    for (int value = CHAR_MIN; value <= CHAR_MAX; ++value) {\n        size_t count = frequencies[(unsigned char)(char)value];\n        if (count > best) {\n            best = count;\n            winner = (char)value;\n        }\n    }\n    return winner;\n}\n\nstatic char knn_serial(int n_groups, Group *groups, int k,\n                       Point to_evaluate) {\n    char *labels = (char *)malloc(sizeof(char) * k);\n    float *distances = (float *)malloc(sizeof(float) * k);\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n    free(labels);\n    free(distances);\n    return most_frequent;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) {\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t total = 0;\n    for (int g = 0; g < n_groups; ++g) {\n        size_t length = (size_t)groups[g].length;\n        if (length > SIZE_MAX - total) {\n            return knn_serial(n_groups, groups, k, to_evaluate);\n        }\n        total += length;\n    }\n    size_t wanted = (size_t)k;\n\n    if (wanted >= total) {\n        size_t frequencies[UCHAR_MAX + 1] = {0};\n        for (int g = 0; g < n_groups; ++g) {\n            frequencies[(unsigned char)groups[g].label] +=\n                (size_t)groups[g].length;\n        }\n        frequencies[(unsigned char)(char)-1] += wanted - total;\n        return label_with_most_votes(frequencies);\n    }\n\n    int workers = 1;\n#ifdef _OPENMP\n    workers = omp_get_max_threads();\n    if (workers < 1) workers = 1;\n    size_t useful_workers = total / 16384;\n    if (useful_workers < 1) useful_workers = 1;\n    if (useful_workers < (size_t)workers) workers = (int)useful_workers;\n#endif\n\n    size_t pool_count = wanted > total / (size_t)workers\n                            ? total : wanted * (size_t)workers;\n    size_t prefix_count = (size_t)n_groups + 1;\n    if (prefix_count > SIZE_MAX / sizeof(size_t) ||\n        (size_t)workers > SIZE_MAX / sizeof(PartialTopK) ||\n        pool_count > SIZE_MAX / sizeof(Neighbor)) {\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t *offsets = (size_t *)malloc(prefix_count * sizeof(size_t));\n    PartialTopK *partials = (PartialTopK *)malloc(\n        (size_t)workers * sizeof(PartialTopK));\n    Neighbor *pool = (Neighbor *)malloc(pool_count * sizeof(Neighbor));\n    if (!offsets || !partials || !pool) {\n        free(offsets);\n        free(partials);\n        free(pool);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    offsets[0] = 0;\n    for (int g = 0; g < n_groups; ++g) {\n        offsets[g + 1] = offsets[g] + (size_t)groups[g].length;\n    }\n\n    int team_size = 1;\n    int saw_nan = 0;\n#ifdef _OPENMP\n#pragma omp parallel num_threads(workers) if(workers > 1) reduction(|:saw_nan)\n#endif\n    {\n        int thread_id = 0;\n#ifdef _OPENMP\n        thread_id = omp_get_thread_num();\n#pragma omp single\n#endif\n        {\n#ifdef _OPENMP\n            team_size = omp_get_num_threads();\n#endif\n            size_t base = total / (size_t)team_size;\n            size_t extra = total % (size_t)team_size;\n            size_t point_begin = 0;\n            size_t pool_begin = 0;\n            for (int t = 0; t < team_size; ++t) {\n                size_t length = base + ((size_t)t < extra);\n                size_t capacity = length < wanted ? length : wanted;\n                partials[t].items = pool + pool_begin;\n                partials[t].count = 0;\n                partials[t].capacity = capacity;\n                partials[t].begin = point_begin;\n                partials[t].end = point_begin + length;\n                point_begin += length;\n                pool_begin += capacity;\n            }\n        }\n\n        PartialTopK *mine = &partials[thread_id];\n        Neighbor *items = mine->items;\n        size_t used = 0;\n        int heap_ready = 0;\n        int low = 0;\n        int high = n_groups;\n        while (low < high) {\n            int mid = low + (high - low) / 2;\n            if (offsets[mid + 1] <= mine->begin) low = mid + 1;\n            else high = mid;\n        }\n\n        for (int g = low; g < n_groups && offsets[g] < mine->end; ++g) {\n            size_t group_begin = offsets[g];\n            size_t first = mine->begin > group_begin\n                               ? mine->begin - group_begin : 0;\n            size_t last = offsets[g + 1] - group_begin;\n            if (last > mine->end - group_begin) {\n                last = mine->end - group_begin;\n            }\n            for (size_t j = first; j < last; ++j) {\n                float d = euclidean_distance_no_sqrt(\n                    to_evaluate, groups[g].points[j]);\n                if (d != d) {\n                    saw_nan = 1;\n                    continue;\n                }\n                Neighbor candidate;\n                candidate.order = group_begin + j;\n                candidate.distance = d;\n                candidate.label = groups[g].label;\n                if (used < mine->capacity) {\n                    items[used++] = candidate;\n                } else {\n                    if (!heap_ready) {\n                        heap_build(items, used);\n                        heap_ready = 1;\n                    }\n                    if (neighbor_better(candidate, items[0])) {\n                        heap_sift_down(items, used, 0, candidate);\n                    }\n                }\n            }\n        }\n        mine->count = used;\n#ifdef _OPENMP\n#pragma omp barrier\n#endif\n\n        for (size_t stride = 1; stride < (size_t)team_size; stride *= 2) {\n            size_t pairs = ((size_t)team_size + 2 * stride - 1) /\n                           (2 * stride);\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n            for (size_t pair = 0; pair < pairs; ++pair) {\n                size_t left = pair * 2 * stride;\n                size_t right = left + stride;\n                if (right < (size_t)team_size) {\n                    Neighbor *destination = partials[left].items;\n                    size_t left_count = partials[left].count;\n                    size_t right_count = partials[right].count;\n                    if (right_count != 0) {\n                        memmove(destination + left_count,\n                                partials[right].items,\n                                right_count * sizeof(Neighbor));\n                    }\n                    size_t combined = left_count + right_count;\n                    size_t keep = combined;\n                    if (keep > wanted) {\n                        keep = wanted;\n                        heap_build(destination, keep);\n                        for (size_t j = keep; j < combined; ++j) {\n                            Neighbor candidate = destination[j];\n                            if (neighbor_better(candidate, destination[0])) {\n                                heap_sift_down(destination, keep, 0, candidate);\n                            }\n                        }\n                    }\n                    partials[left].count = keep;\n                }\n            }\n        }\n    }\n\n    if (saw_nan) {\n        free(offsets);\n        free(partials);\n        free(pool);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t frequencies[UCHAR_MAX + 1] = {0};\n    for (size_t j = 0; j < partials[0].count; ++j) {\n        ++frequencies[(unsigned char)partials[0].items[j].label];\n    }\n    frequencies[(unsigned char)(char)-1] += wanted - partials[0].count;\n    char result = label_with_most_votes(frequencies);\n    free(offsets);\n    free(partials);\n    free(pool);\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }

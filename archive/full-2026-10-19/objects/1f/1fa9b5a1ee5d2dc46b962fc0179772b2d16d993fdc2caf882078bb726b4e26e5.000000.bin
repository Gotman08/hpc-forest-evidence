#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

static constexpr long long MOD = 1000000007LL;

static long long mod_pow(long long base, long long exp) {
    long long result = 1;
    while (exp > 0) {
        if (exp & 1) result = result * base % MOD;
        base = base * base % MOD;
        exp >>= 1;
    }
    return result;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) return 0;

    vector<pair<int, int>> blocked;
    blocked.reserve(m);
    for (int i = 0; i < m; ++i) {
        int y, x;
        cin >> y >> x;
        blocked.emplace_back(y, x);
    }
    sort(blocked.begin(), blocked.end());
    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());

    if (binary_search(blocked.begin(), blocked.end(), make_pair(0, 0)) ||
        binary_search(blocked.begin(), blocked.end(), make_pair(n - 1, n - 1))) {
        cout << 0 << '\n';
        return 0;
    }

    const int max_steps = 2 * (n - 1);
    vector<long long> fact(max_steps + 1), inv_fact(max_steps + 1);
    fact[0] = 1;
    for (int i = 1; i <= max_steps; ++i) fact[i] = fact[i - 1] * i % MOD;
    inv_fact[max_steps] = mod_pow(fact[max_steps], MOD - 2);
    for (int i = max_steps; i > 0; --i) inv_fact[i - 1] = inv_fact[i] * i % MOD;

    auto choose = [&](int total, int taken) -> long long {
        if (taken < 0 || taken > total) return 0;
        return fact[total] * inv_fact[taken] % MOD * inv_fact[total - taken] % MOD;
    };

    vector<long long> ways(blocked.size());
    for (size_t i = 0; i < blocked.size(); ++i) {
        const int y = blocked[i].first;
        const int x = blocked[i].second;
        long long count = choose(y + x, y);
        for (size_t j = 0; j < i; ++j) {
            const int py = blocked[j].first;
            const int px = blocked[j].second;
            if (py <= y && px <= x) {
                long long paths = choose((y - py) + (x - px), y - py);
                count = (count - ways[j] * paths % MOD + MOD) % MOD;
            }
        }
        ways[i] = count;
    }

    long long answer = choose(max_steps, n - 1);
    for (size_t i = 0; i < blocked.size(); ++i) {
        const int y = blocked[i].first;
        const int x = blocked[i].second;
        if (y <= n - 1 && x <= n - 1) {
            long long paths = choose((n - 1 - y) + (n - 1 - x), n - 1 - y);
            answer = (answer - ways[i] * paths % MOD + MOD) % MOD;
        }
    }

    cout << answer << '\n';
    return 0;
}

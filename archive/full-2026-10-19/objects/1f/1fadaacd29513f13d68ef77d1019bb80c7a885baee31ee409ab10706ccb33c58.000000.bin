        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Replacing cache-unfriendly dense matrix exponentiation with contiguous characteristic-polynomial exponentiation will reduce working memory from quadratic to linear and make the hot loops sequential, improving locality and runtime for all valid recurrence sizes.",
        "id": "c0fe244b74554e31",
        "ordinal": 1,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/npbonacci.cpp"
          ],
          "retained": [
            "Replace dense transition/base matrices with O(N)-storage Kitamasa polynomial exponentiation.",
            "Use contiguous shifted convolution and descending contiguous polynomial reduction.",
            "Batch modular normalization every eight outer updates to reduce inner-loop modulo overhead without overflowing 64-bit accumulators."
          ]
        },

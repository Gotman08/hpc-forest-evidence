from pathlib import Path
import hashlib, json
from datetime import datetime, timezone, timedelta

HERE=Path(__file__).resolve().parent
REV=HERE.parent/'revision-r6-commandes'
read=lambda p:json.loads(p.read_text('utf-8-sig'))
ref=lambda p:{'path':str(p.resolve()),'sha256':hashlib.sha256(p.read_bytes()).hexdigest()}
review=read(REV/'REVUE-INDEPENDANTE-FACTORY.json')
assert review['verified'] is True and review['blocking_findings']==[]
assert datetime.now(timezone.utc)+timedelta(hours=6)<datetime(2026,10,31,23,tzinfo=timezone.utc)
census=read(HERE/'cim-avant-soumissions.json')
assert (datetime.now(timezone.utc)-datetime.fromisoformat(census['captured_at_utc'])).total_seconds()<120
for slug,model,session in [('astra-max','gpt-6-astra','979ef61f50d041639c1cd46e1942a3f3'),('terra-max','gpt-5.6-terra','a35692d6da3f46278fe3840f5c56984e'),('sol-max','gpt-6.1-sol','0fbe579c95f74ec7b90ebe702877434b')]:
    d=HERE/slug; p=read(d/'plan-prepared.json')['structuredContent'];r=read(d/'plan-reread.json')['structuredContent']
    command=REV/slug/'commande-allouee-proposee.sh';assert ref(command)['sha256']==review['command_sha256_by_model'][model]
    assert r['state']=='ready' and r['expired'] is False and p['plan_sha256']==r['plan_sha256'] and p['script']==r['plan']['preview']['script']
    assert command.read_text('utf-8') in p['script'] and p['script'].count('srun ')==1
    script=d/'job-reviewed.sbatch';assert not script.exists();script.write_text(p['script'],'utf-8',newline='\n')
    v={'schema':'hpc-forest-max-cell-submit-intent-v1','verified':True,'scope_id':'hpc-forest-primes-native-max-r2c','model':model,'effort':'max','session_id':session,'source_zip_sha256':'ade344bfec4322e8aaecc99cfbf7bd502e6d39b55c62180e8f552a3d6391e680','research_plan_sha256':'bac579fdb44850c636a6522c014175f95d4ce867bab502d86dd15c1bff31032e','plan_id':p['plan_id'],'plan_sha256':p['plan_sha256'],'command':ref(command),'job_script':ref(script),'full_script_reviewed':True,'one_submit_only':True,'no_resubmit_if_unknown':True,'normal_first_call_proved':False,'allocation_max_seconds':10800,'maximum_native_workers':4,'source_only_preserved':True,'observed_at':datetime.now(timezone.utc).isoformat(),'evidence_refs':[ref(REV/'REVUE-INDEPENDANTE-FACTORY.json'),ref(HERE/'cim-avant-soumissions.json'),ref(d/'plan-reread.json')]}
    target=d/'submission-intent.json';assert not target.exists();target.write_text(json.dumps(v,indent=2)+'\n','utf-8')
    print(slug,p['plan_id'],ref(target)['sha256'])

      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <limits>\n#include <memory>\n#include <vector>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\nusing std::int32_t;\nusing std::int64_t;\nusing std::uint32_t;\nusing std::uint64_t;\n\nclass FastInput {\n    unsigned char buffer_[65536];\n    std::size_t position_ = 0;\n    std::size_t length_ = 0;\n\n    int next() {\n        if (position_ == length_) {\n            length_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (length_ == 0) return EOF;\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    bool read_int(int32_t& result) {\n        int c;\n        do {\n            c = next();\n            if (c == EOF) return false;\n        } while (c <= ' ');\n        const bool negative = c == '-';\n        if (negative || c == '+') c = next();\n        uint32_t value = 0;\n        while (static_cast<unsigned>(c - '0') <= 9u) {\n            value = value * 10u + static_cast<unsigned>(c - '0');\n            c = next();\n        }\n        result = negative\n            ? static_cast<int32_t>(-static_cast<int64_t>(value))\n            : static_cast<int32_t>(value);\n        return true;\n    }\n};\n\ntemplate<class T>\ninline void add_row(T* columns, const int32_t* row, int n) {\n    for (int j = 0; j < n; ++j)\n        columns[j] = static_cast<T>(static_cast<int64_t>(columns[j]) + row[j]);\n}\n\ntemplate<class T>\ninline void advance_columns(T* columns, const int32_t* leaving,\n                            const int32_t* entering, int n) {\n    for (int j = 0; j < n; ++j)\n        columns[j] = static_cast<T>(static_cast<int64_t>(columns[j])\n                                   - leaving[j] + entering[j]);\n}\n\ntemplate<class T>\nint64_t scalar_maximum_row(const T* columns, int width, int s, int64_t first) {\n    int64_t current = first;\n    int64_t best = first;\n    for (int j = 1; j < width; ++j) {\n        current += static_cast<int64_t>(columns[j + s - 1])\n                   - static_cast<int64_t>(columns[j - 1]);\n        best = std::max(best, current);\n    }\n    return best;\n}\n\ntemplate<class T>\nint64_t maximum_row(const T* columns, int n, int s, int64_t first) {\n    return scalar_maximum_row(columns, n - s + 1, s, first);\n}\n\n#if defined(__aarch64__)\ntemplate<>\ninline void add_row<int32_t>(int32_t* columns, const int32_t* row, int n) {\n    int j = 0;\n    for (; j + 4 <= n; j += 4) {\n        vst1q_s32(columns + j,\n                  vaddq_s32(vld1q_s32(columns + j), vld1q_s32(row + j)));\n    }\n    for (; j < n; ++j)\n        columns[j] = static_cast<int32_t>(static_cast<int64_t>(columns[j]) + row[j]);\n}\n\ntemplate<>\ninline void advance_columns<int32_t>(int32_t* columns, const int32_t* leaving,\n                                     const int32_t* entering, int n) {\n    int j = 0;\n    for (; j + 4 <= n; j += 4) {\n        int32x4_t value = vsubq_s32(vld1q_s32(columns + j), vld1q_s32(leaving + j));\n        value = vaddq_s32(value, vld1q_s32(entering + j));\n        vst1q_s32(columns + j, value);\n    }\n    for (; j < n; ++j)\n        columns[j] = static_cast<int32_t>(static_cast<int64_t>(columns[j])\n                                         - leaving[j] + entering[j]);\n}\n\ntemplate<>\ninline void add_row<int64_t>(int64_t* columns, const int32_t* row, int n) {\n    int j = 0;\n    for (; j + 4 <= n; j += 4) {\n        const int32x4_t input = vld1q_s32(row + j);\n        vst1q_s64(columns + j,\n                  vaddq_s64(vld1q_s64(columns + j), vmovl_s32(vget_low_s32(input))));\n        vst1q_s64(columns + j + 2,\n                  vaddq_s64(vld1q_s64(columns + j + 2), vmovl_s32(vget_high_s32(input))));\n    }\n    for (; j < n; ++j) columns[j] += row[j];\n}\n\ntemplate<>\ninline void advance_columns<int64_t>(int64_t* columns, const int32_t* leaving,\n                                     const int32_t* entering, int n) {\n    int j = 0;\n    for (; j + 4 <= n; j += 4) {\n        const int32x4_t old_row = vld1q_s32(leaving + j);\n        const int32x4_t new_row = vld1q_s32(entering + j);\n        int64x2_t low = vsubq_s64(vld1q_s64(columns + j),\n                                   vmovl_s32(vget_low_s32(old_row)));\n        int64x2_t high = vsubq_s64(vld1q_s64(columns + j + 2),\n                                    vmovl_s32(vget_high_s32(old_row)));\n        low = vaddq_s64(low, vmovl_s32(vget_low_s32(new_row)));\n        high = vaddq_s64(high, vmovl_s32(vget_high_s32(new_row)));\n        vst1q_s64(columns + j, low);\n        vst1q_s64(columns + j + 2, high);\n    }\n    for (; j < n; ++j)\n        columns[j] = columns[j] - leaving[j] + entering[j];\n}\n\ninline uint32x4_t differences32(const int32_t* columns, int s, int j) {\n    return vsubq_u32(vreinterpretq_u32_s32(vld1q_s32(columns + j + s)),\n                     vreinterpretq_u32_s32(vld1q_s32(columns + j)));\n}\n\ntemplate<>\nint64_t maximum_row<int32_t>(const int32_t* columns, int n, int s, int64_t first) {\n    const int width = n - s + 1;\n    if (width < 4) return scalar_maximum_row(columns, width, s, first);\n\n    int32_t initial[4];\n    int64_t current = first;\n    initial[0] = static_cast<int32_t>(current);\n    for (int k = 1; k < 4; ++k) {\n        current += static_cast<int64_t>(columns[s + k - 1]) - columns[k - 1];\n        initial[k] = static_cast<int32_t>(current);\n    }\n    uint32x4_t windows = vreinterpretq_u32_s32(vld1q_s32(initial));\n    int32x4_t maxima = vreinterpretq_s32_u32(windows);\n    int j = 4;\n    if (j + 4 <= width) {\n        const uint32x4_t d0 = differences32(columns, s, 0);\n        uint32x4_t d1 = differences32(columns, s, 4);\n        uint32x4_t pairs0 = vaddq_u32(d0, vextq_u32(d0, d1, 1));\n        for (; j + 4 <= width; j += 4) {\n            const uint32x4_t d2 = differences32(columns, s, j + 4);\n            const uint32x4_t pairs1 = vaddq_u32(d1, vextq_u32(d1, d2, 1));\n            const uint32x4_t increment =\n                vaddq_u32(pairs0, vextq_u32(pairs0, pairs1, 2));\n            windows = vaddq_u32(windows, increment);\n            maxima = vmaxq_s32(maxima, vreinterpretq_s32_u32(windows));\n            pairs0 = pairs1;\n            d1 = d2;\n        }\n    }\n    int64_t best = vmaxvq_s32(maxima);\n    current = vgetq_lane_s32(vreinterpretq_s32_u32(windows), 3);\n    for (; j < width; ++j) {\n        current += static_cast<int64_t>(columns[j + s - 1]) - columns[j - 1];\n        best = std::max(best, current);\n    }\n    return best;\n}\n\ninline int64x2_t differences64(const int64_t* columns, int s, int j) {\n    return vsubq_s64(vld1q_s64(columns + j + s), vld1q_s64(columns + j));\n}\n\ntemplate<>\nint64_t maximum_row<int64_t>(const int64_t* columns, int n, int s, int64_t first) {\n    const int width = n - s + 1;\n    if (width < 2) return first;\n    const int64_t initial[2] = {first, first + columns[s] - columns[0]};\n    int64x2_t windows = vld1q_s64(initial);\n    int64x2_t maxima = windows;\n    int j = 2;\n    if (j + 2 <= width) {\n        int64x2_t d0 = differences64(columns, s, 0);\n        for (; j + 2 <= width; j += 2) {\n            const int64x2_t d1 = differences64(columns, s, j);\n            const int64x2_t increment = vaddq_s64(d0, vextq_s64(d0, d1, 1));\n            windows = vaddq_s64(windows, increment);\n            maxima = vbslq_s64(vcgtq_s64(windows, maxima), windows, maxima);\n            d0 = d1;\n        }\n    }\n    int64_t best = std::max(vgetq_lane_s64(maxima, 0), vgetq_lane_s64(maxima, 1));\n    int64_t current = vgetq_lane_s64(windows, 1);\n    for (; j < width; ++j) {\n        current += columns[j + s - 1] - columns[j - 1];\n        best = std::max(best, current);\n    }\n    return best;\n}\n#endif\n\ntemplate<class T>\nint64_t solve(const int32_t* matrix, const std::vector<int64_t>& row_left,\n              int n, int s) {\n    // Initialized padding makes SIMD lookahead loads valid at the right edge.\n    std::vector<T> columns(static_cast<std::size_t>(n) + 16, T(0));\n    int64_t first = 0;\n    for (int row = 0; row < s; ++row) {\n        add_row(columns.data(), matrix + static_cast<std::size_t>(row) * n, n);\n        first += row_left[row];\n    }\n    int64_t best = maximum_row(columns.data(), n, s, first);\n    for (int top = 1; top + s <= n; ++top) {\n        const int leaving = top - 1;\n        const int entering = top + s - 1;\n        advance_columns(columns.data(),\n                        matrix + static_cast<std::size_t>(leaving) * n,\n                        matrix + static_cast<std::size_t>(entering) * n, n);\n        first += row_left[entering] - row_left[leaving];\n        best = std::max(best, maximum_row(columns.data(), n, s, first));\n    }\n    return best;\n}\n\nint main() {\n    FastInput input;\n    int32_t input_n, input_s;\n    if (!input.read_int(input_n) || !input.read_int(input_s)) return 0;\n    const int n = input_n;\n    const int s = input_s;\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    std::unique_ptr<int32_t[]> matrix(new int32_t[static_cast<std::size_t>(n) * n]);\n    std::vector<int64_t> row_left(n);\n    uint64_t maximum_magnitude = 0;\n    for (int row = 0; row < n; ++row) {\n        int32_t* destination = matrix.get() + static_cast<std::size_t>(row) * n;\n        int64_t left = 0;\n        for (int col = 0; col < s; ++col) {\n            int32_t value;\n            if (!input.read_int(value)) return 0;\n            destination[col] = value;\n            left += value;\n            const uint64_t magnitude = value < 0\n                ? static_cast<uint64_t>(-static_cast<int64_t>(value))\n                : static_cast<uint64_t>(value);\n            maximum_magnitude = std::max(maximum_magnitude, magnitude);\n        }\n        for (int col = s; col < n; ++col) {\n            int32_t value;\n            if (!input.read_int(value)) return 0;\n            destination[col] = value;\n            const uint64_t magnitude = value < 0\n                ? static_cast<uint64_t>(-static_cast<int64_t>(value))\n                : static_cast<uint64_t>(value);\n            maximum_magnitude = std::max(maximum_magnitude, magnitude);\n        }\n        row_left[row] = left;\n    }\n\n    const uint64_t area = static_cast<uint64_t>(s) * s;\n    const uint64_t narrow_limit =\n        static_cast<uint64_t>(std::numeric_limits<int32_t>::max()) / area;\n    int64_t answer;\n    if (maximum_magnitude <= narrow_limit)\n        answer = solve<int32_t>(matrix.get(), row_left, n, s);\n    else\n        answer = solve<int64_t>(matrix.get(), row_left, n, s);\n    std::printf(\"%lld\\n\", static_cast<long long>(answer));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

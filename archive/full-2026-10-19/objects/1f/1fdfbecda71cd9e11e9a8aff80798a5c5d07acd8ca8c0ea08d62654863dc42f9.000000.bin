    {
      "id": "f96a5dde29ff4666",
      "role": "C",
      "mission": {
        "base_commit": "0690329535fa9ab29ec05da74154699b5836730f",
        "delegation_parent": "R/C",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "A tiled OpenMP index mergesort should exploit four cores even for skewed inputs and final merge rounds, without per-element synchronization or quadratic bucket sorting.",
        "id": "f96a5dde29ff4666",
        "ordinal": 1,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/bucketsort.c"
          ],
          "retained": [
            "Replace fixed-capacity bucket slices and insertion sorting with distribution-independent stable index mergesort and per-call scratch storage.",
            "Use one persistent OpenMP team, statically scheduled 4096-element runs, and binary co-ranking to partition every merge into disjoint output tiles, including the final merge.",
            "Avoid parallel startup below 32768 elements; retain formatted I/O while adding checked allocations, bounded token reads and appropriately sized indices."
          ]
        },

        "epoch": 1,
        "hypothesis": "Contiguous, histogram-sized MSD radix partitions should replace quadratic index shifting with streaming passes while preserving strcmp ordering and original token spellings.",
        "id": "6b8715b35ece45b0",
        "ordinal": 1,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/bucketsort.c"
          ],
          "retained": [
            "Replace fixed-capacity buckets with unsigned-byte MSD radix sorting of indices using actual histogram offsets and one reusable scratch array.",
            "Exclude terminal NUL buckets, skip common prefixes with sequential string scans, and use insertion sorting for partitions of at most 24 indices.",
            "Process the largest child iteratively and recurse only on smaller partitions to bound stack usage."
          ]
        },

    {
      "id": "e88a56a18acd45c6",
      "role": "A",
      "mission": {
        "base_commit": "0690329535fa9ab29ec05da74154699b5836730f",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Packing string prefixes and original indices into native-word entries should replace repeated scattered character reads with sequential cached-key scans, improving radix-sort locality without increasing per-entry storage.",
        "id": "e88a56a18acd45c6",
        "ordinal": 2,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/bucketsort.c"
          ],
          "retained": [
            "Pack each index with as many leading unsigned bytes as fit in the remaining word bits, stopping at NUL and zero-padding without reading beyond it.",
            "Replace fixed-capacity buckets and quadratic sorting with histogram-sized MSD partitions; access original suffixes only after cached bytes are exhausted.",
            "Use a 24-entry insertion cutoff, skip uniform prefixes, and iterate over the largest partition to bound recursion depth.",
            "Decode original indices before output and use long-sized input/output loop counters."
          ]
        },

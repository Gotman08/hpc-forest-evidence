} \\n-\\t\\t\\tj+=dir;\\n-\\t\\t}\\n-\\t\\tmxSum = std::max(mxSum,sum);\\n-\\t}\\n-\\tprintf(\\\"%d\\\\n\\\",mxSum);\\n-}\\n\\\\ No newline at end of file\\n+    FastScanner fs;\\n+    int n = fs.nextInt();\\n+    int s = fs.nextInt();\\n+\\n+    std::vector<int> a(static_cast<size_t>(n) * n);\\n+    for (int i = 0; i < n; ++i) {\\n+        int* row = &a[static_cast<size_t>(i) * n];\\n+        for (int j = 0; j < n; ++j) {\\n+            row[j] = fs.nextInt();\\n+        }\\n+    }\\n+\\n+    long long mxSum = -(1LL << 62);\\n+    const int totalRows = n - s + 1;\\n+\\n+#pragma omp parallel reduction(max:mxSum)\\n+    {\\n+        const int tid = omp_get_thread_num();\\n+        const int nt = omp_get_num_threads();\\n+\\n+        long long v[8000];\\n+        long long pref[8001];\\n+\\n+        const int q = totalRows / nt;\\n+        const int r = totalRows % nt;\\n+        const int base = q * tid + (tid < r ? tid : r);\\n+        const int len = q + (tid < r ? 1 : 0);\\n+\\n+        if (len > 0) {\\n+            long long* __restrict vp = v;\\n+            // Initialize column sums directly from the first row, then add remaining S-1 rows.\\n+            const int* __restrict firstRow = &a[static_cast<size_t>(base) * n];\\n+#pragma omp simd\\n+            for (int j = 0; j < n; ++j) vp[j] = static_cast<long long>(firstRow[j]);\\n+            for (int k = 1; k < s; ++k) {\\n+                const int* __restrict row = &a[static_cast<size_t>(base + k) * n];\\n+#pragma omp simd\\n+                for (int j = 0; j < n; ++j) vp[j] += static_cast<long long>(row[j]);\\n+            }\\n+\\n+            pref[0] = 0;\\n+            for (int i = 0; i < n; ++i) {\\n+                pref[i + 1] = pref[i] + vp[i];\\n+            }\\n+            long long rowBest = LLONG_MIN;\\n+#pragma omp simd reduction(max:rowBest)\\n+            for (int j = 0; j <= n - s; ++j) {\\n+                const long long w = pref[j + s] - pref[j];\\n+                if (w > rowBest) rowBest = w;\\n+            }\\n+            if (rowBest > mxSum) mxSum = rowBest;\\n+\\n+            for (int idx = 1; idx < len; ++idx) {\\n+                const int outRow = base + idx - 1;\\n+                const int inRow = outRow + s;\\n+                const int* __restrict inPtr = &a[static_cast<size_t>(inRow) * n];\\n+                const int* __restrict outPtr = &a[static_cast<size_t>(outRow) * n];\\n+#pragma omp simd\\n+                for (int j = 0; j < n; ++j) {\\n+                    vp[j] += static_cast<long long>(inPtr[j]) - outPtr[j];\\n+                }\\n+\\n+                pref[0] = 0;\\n+                for (int i = 0; i < n; ++i) {\\n+                    pref[i + 1] = pref[i] + vp[i];\\n+                }\\n+                long long rowBest2 = LLONG_MIN;\\n+#pragma omp simd reduction(max:rowBest2)\\n+                for (int j = 0; j <= n - s; ++j) {\\n+                    const long long w = pref[j + s] - pref[j];\\n+                    if (w > rowBest2) rowBest2 = w;\\n+                }\\n+                if (rowBest2 > mxSum) mxSum = rowBest2;\\n+            }\\n+        }\\n+    }\\n+\\n+    std::printf(\\\"%lld\\\\n\\\", mxSum);\\n+    return 0;\\n+}\"}, {\"id\": \"cb6ca801faf74dd3\", \"role\": \"C\", \"commit\": \"903b6855735acc3f2b9fe7a1679fadb18f05da59\", \"transformations\": {\"files\": [\"src/solution.cpp\"], \"retained\": [\"Buffered matrix rows into a temporary std::vector to decouple I/O from computation\", \"Added #pragma omp simd to the column-prefix update loop\", \"Added #pragma omp simd reduction(+:window) to the initial window accumulation\"]}, \"mean_seconds\": 0.01203988422639668, \"diff\": \"diff --git a/src/solution.cpp b/src/solution.cpp\\nindex fd005fd..1a2404d 100644\\n--- a/src/solution.cpp\\n+++ b/src/solution.cpp\\n@@ -1,57 +1,79 @@\\n #include <iostream>\\n #include <vector>\\n #include <cstdio>\\n+#include <climits>\\n #include <cassert>\\n \\n+struct FastScanner {\\n+    static const int BUFSIZE = 1 << 20;\\n+    char buf[BUFSIZE];\\n+    int idx, size;\\n+    FastScanner() : idx(0), size(0) {}\\n+    inline char getChar() {\\n+        if (idx >= size) {\\n+            size = fread(buf, 1, BUFSIZE, stdin);\\n+            idx = 0;\\n+            if (size == 0) return 0;\\n+        }\\n+        return buf[idx++];\\n+    }\\n+    int nextInt() {\\n+        char c;\\n+        do { c = getChar(); } while (c <= ' ');\\n+        int sign = 1;\\n+        if (c == '-') { sign = -1; c = getChar(); }\\n+        int x = 0;\\n+        while (c >= '0' && c <= '9') {\\n+            x = x * 10 + (c - '0');\\n+            c = getChar();\\n+        }\\n+        return sign * x;\\n+    }\\n+};\\n+\\n int main() {\\n-\\tint n,s;\\n-\\tstd::cin >> n >> s;\\n-\\tstd::vector<std::vector<int> > matrix(n, std::vector<int>(n));\\n-\\tfor(int i=0;i<n;i++)\\n-\\t\\tfor(int j=0;j<n;j++) \\n-\\t\\t\\tscanf(\\\"%d\\\", &(matrix[i][j]));\\n-\\n-\\tassert(s<n);\\n-\\tassert(n<8000);\\n-\\tassert(s>0);\\n-\\tassert(n>0);\\n-\\n-\\tint sum = 0;\\n-\\tfor(int i=0;i<s;i++)\\n-\\t\\tfor(int j=0;j<s;j++)\\n-\\t\\t\\tsum += matrix[i][j];\\n-\\n-\\tint mxSum = sum;\\n-\\n-\\tint dir = 1;\\n-\\tint i = 0;\\n-\\tint j = 0;\\n-\\twhile(i+s <= n) {\\n-\\t\\tif( (j+s == n && dir==1) || (j==0 && dir==-1) ) { \\n-\\t\\t\\tint exitingRow = i;\\n-\\t\\t\\tint enteringRow = exitingRow+s;\\n-\\t\\t\\tif(enteringRow >=n) break;\\n-\\n-\\t\\t\\tfor(int k=0;k<s;k++) { sum -= matrix[exitingRow][k+j]; } \\n-\\t\\t\\tfor(int k=0;k<s;k++) { sum += matrix[enteringRow][k+j];\\t} \\n-\\t\\t\\t\\n-\\t\\t\\ti++;\\n-\\t\\t\\tdir*=-1;\\n-\\t\\t} else {\\n-\\t\\t\\tint exitingCol,enteringCol;\\n-\\t\\t\\tif(dir==1) {\\n-\\t\\t\\t\\texitingCol = j;\\n-\\t\\t\\t\\tenteringCol = exitingCol + s;\\n-\\t\\t\\t} else {\\n-\\t\\t\\t\\tenteringCol = j-1;\\n-\\t\\t\\t\\texitingCol = enteringCol + s;\\n-\\t\\t\\t}\\n-\\n-\\t\\t\\tfor(int k=0;k<s;k++) {sum -= matrix[k+i][exitingCol]; } \\n-\\t\\t\\tfor(int k=0;k<s;k++) {sum += matrix[k+i][enteringCol];\\t} \\n-\\t\\t\\tj+=dir;\\n-\\t\\t}\\n-\\t\\tmxSum = std::max(mxSum,sum);\\n-\\t}\\n-\\tprintf(\\\"%d\\\\n\\\",mxSum);\\n-}\\n\\\\ No newline at end of file\\n+    FastScanner fs;\\n+    int n = fs.nextInt();\\n+    int s = fs.nextInt();\\n+\\n+    std::vector<int> pref((size_t)(n + 1) * n, 0);\\n+    std::vector<int> row(n);\\n+    for (int i = 1; i <= n; ++i) {\\n+        for (int j = 0; j < n; ++j) row[j] = fs.nextInt();\\n+        const int base = i * n;\\n+        const int prev = (i - 1) * n;\\n+        #pragma omp simd\\n+        for (int j = 0; j < n; ++j) {\\n+            pref[base + j] = pref[prev + j] + row[j];\\n+        }\\n+    }\\n+\\n+    assert(s > 0 && s < n && n < 8000);\\n+\\n+    int mxSum = INT_MIN;\\n+\\n+    #pragma omp parallel for reduction(max:mxSum) schedule(static)\\n+    for (int i = 0; i <= n - s; ++i) {\\n+        const int rowStart = i * n;\\n+        const int rowEnd   = (i + s) * n;\\n+        const int* top    = &pref[rowStart];\\n+        const int* bottom = &pref[rowEnd];\\n+\\n+        int window = 0;\\n+        #pragma omp simd reduction(+:window)\\n+        for (int j = 0; j < s; ++j) {\\n+            window += bottom[j] - top[j];\\n+        }\\n+        int curMax = window;\\n+\\n+        for (int j = s; j < n; ++j) {\\n+            window += (bottom[j] - top[j]) - (bottom[j - s] - top[j - s]);\\n+            if (window > curMax) curMax = window;\\n+        }\\n+\\n+        if (curMax > mxSum) mxSum = curMax;\\n+    }\\n+\\n+    printf(\\\"%d\\\\n\\\", mxSum);\\n+    return 0;\\n+}\"}], \"interactions\": [{\"sources\": [\"519cc95510eb4b2a\", \"a5850332c2144560\", \"cb6ca801faf74dd3\"], \"outcome\": {\"binary_sha256\": \"2a2e3ca3fbdb9efce385ea7b96edd2b4b2cfc41d149115649f92d9b7cea555a6\", \"cache_key\": \"a1cb14e55b90e744754ff685f9135899b769dbeb866b79f1dfc5230ccc215d9f\", \"commit\": \"b915eadec98595e6db083692eafbdd33b97e4005\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e
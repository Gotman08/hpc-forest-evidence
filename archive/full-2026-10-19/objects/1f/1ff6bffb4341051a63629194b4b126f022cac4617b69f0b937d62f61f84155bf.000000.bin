{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <algorithm>\\n#include <iostream>\\n#include <utility>\\n#include <vector>\\n\\nusing namespace std;\\n\\nstatic const int MOD = 1000000007;\\n\\nstatic int mod_pow(int base, int exponent) {\\n    long long result = 1;\\n    long long value = base;\\n    while (exponent > 0) {\\n        if (exponent & 1) result = result * value % MOD;\\n        value = value * value % MOD;\\n        exponent >>= 1;\\n    }\\n    return static_cast<int>(result);\\n}\\n\\nint main() {\\n    ios::sync_with_stdio(false);\\n    cin.tie(nullptr);\\n\\n    int n, m;\\n    if (!(cin >> n >> m)) return 0;\\n\\n    vector<pair<int, int>> obstacles;\\n    obstacles.reserve(m);\\n    for (int c = 0; c < m; ++c) {\\n        int y, x;\\n        cin >> y >> x;\\n        obstacles.emplace_back(y, x);\\n    }\\n\\n    if (n == 1) {\\n        bool blocked = false;\\n        for (const auto& cell : obstacles)\\n            if (cell.first == 0 && cell.second == 0) blocked = true;\\n        cout << (blocked ? 0 : 1) << '\\\\n';\\n        return 0;\\n    }\\n\\n    sort(obstacles.begin(), obstacles.end());\\n    obstacles.erase(unique(obstacles.begin(), obstacles.end()), obstacles.end());\\n\\n    const pair<int, int> start{0, 0};\\n    const pair<int, int> finish{n - 1, n - 1};\\n    if (binary_search(obstacles.begin(), obstacles.end(), start) ||\\n        binary_search(obstacles.begin(), obstacles.end(), finish)) {\\n        cout << 0 << '\\\\n';\\n        return 0;\\n    }\\n\\n    const int max_steps = 2 * n - 2;\\n    vector<int> factorial(max_steps + 1), inverse_factorial(max_steps + 1);\\n    factorial[0] = 1;\\n    for (int i = 1; i <= max_steps; ++i)\\n        factorial[i] = static_cast<long long>(factorial[i - 1]) * i % MOD;\\n    inverse_factorial[max_steps] = mod_pow(factorial[max_steps], MOD - 2);\\n    for (int i = max_steps; i > 0; --i)\\n        inverse_factorial[i - 1] = static_cast<long long>(inverse_factorial[i]) * i % MOD;\\n\\n    auto choose = [&](int total, int part) -> int {\\n        if (part < 0 || part > total) return 0;\\n        return static_cast<long long>(factorial[total]) * inverse_factorial[part] % MOD *\\n               inverse_factorial[total - part] % MOD;\\n    };\\n\\n    vector<pair<int, int>> points = obstacles;\\n    points.push_back(finish);\\n    sort(points.begin(), points.end());\\n    points.erase(unique(points.begin(), points.end()), points.end());\\n\\n    vector<int> ways(points.size());\\n    for (size_t i = 0; i < points.size(); ++i) {\\n        const int y = points[i].first;\\n        const int x = points[i].second;\\n        long long count = choose(x + y, x);\\n        for (size_t j = 0; j < i; ++j) {\\n            const int py = points[j].first;\\n            const int px = points[j].second;\\n            if (py <= y && px <= x) {\\n                int paths_between = choose((y - py) + (x - px), y - py);\\n                count -= static_cast<long long>(ways[j]) * paths_between % MOD;\\n                if (count < 0) count += MOD;\\n            }\\n        }\\n        ways[i] = static_cast<int>(count);\\n        if (points[i] == finish) {\\n            cout << ways[i] << '\\\\n';\\n            return 0;\\n        }\\n    }\\n    return 0;\\n}\\n\",\"path\":\"src/solution.cpp\"}],\"hypothesis\":\"For the stated sparse-obstacle regime, sorting obstacle coordinates and applying binomial inclusion-exclusion avoids allocating or scanning an N×N grid; compact vectors and sequential preprocessing also improve locality.\",\"notes\":\"The obstacle list is sorted and deduplicated, and blocked start/end cells produce zero paths. Work is O(K²) for K unique obstacles, with O(N+K) memory; the quadratic obstacle interaction may be costly if an input has many obstacles.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Replace the dense blocked-cell grid and row-by-row dynamic program with sorted sparse obstacle coordinates and inclusion-exclusion path counts.\",\"Precompute factorials and inverse factorials modulo 1,000,000,007 to evaluate monotone-path binomial coefficients in constant time.\",\"Deduplicate obstacle coordinates and explicitly handle blocked endpoints.\" ]}"}}

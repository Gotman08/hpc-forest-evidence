      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <cstring>\n#include <limits>\n#include <memory>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nclass FastInput {\n    static constexpr std::size_t capacity = 1u << 20;\n    std::unique_ptr<unsigned char[]> buffer{new unsigned char[capacity]};\n    std::size_t position = 0;\n    std::size_t length = 0;\n\n    int nextByte() {\n        if (position == length) {\n            length = std::fread(buffer.get(), 1, capacity, stdin);\n            position = 0;\n            if (length == 0) return EOF;\n        }\n        return buffer[position++];\n    }\n\npublic:\n    bool readInt(int& value) {\n        int c;\n        do {\n            c = nextByte();\n            if (c == EOF) return false;\n        } while (c <= ' ');\n        const bool negative = c == '-';\n        if (c == '-' || c == '+') c = nextByte();\n        unsigned int magnitude = 0;\n        while (c >= '0' && c <= '9') {\n            magnitude = magnitude * 10u + static_cast<unsigned int>(c - '0');\n            c = nextByte();\n        }\n        value = negative\n            ? static_cast<int>(-static_cast<long long>(magnitude))\n            : static_cast<int>(magnitude);\n        return true;\n    }\n\n    // Return a complete-token span, one boundary-crossing integer, or EOF.\n    int readSpan(const unsigned char*& first, const unsigned char*& last,\n                 int& scalar) {\n        if (position == length) {\n            length = std::fread(buffer.get(), 1, capacity, stdin);\n            position = 0;\n            if (length == 0) return 0;\n        }\n        std::size_t stop = length;\n        while (stop > position && buffer[stop - 1] > ' ') --stop;\n        if (stop == position) return readInt(scalar) ? 2 : 0;\n        first = buffer.get() + position;\n        last = buffer.get() + stop;\n        position = stop;\n        return 1;\n    }\n};\n\nusing Word = std::uint32_t;\nusing Sum = std::int32_t;\n\nstatic inline Sum signedSum(Word bits) {\n    Sum value;\n    std::memcpy(&value, &bits, sizeof(value));\n    return value;\n}\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.readInt(n) || !input.readInt(s)) return 0;\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t elements = static_cast<std::size_t>(n) * n;\n    std::unique_ptr<Word[]> matrix(new Word[elements]);\n    Word* const data = matrix.get();\n\n    const int windows = n - s + 1;\n    constexpr int maxStripeWidth = 256;\n    int workers = 1;\n#ifdef _OPENMP\n    workers = omp_get_max_threads();\n#endif\n    const int stripeWidth = std::min(maxStripeWidth,\n        std::max(1, (windows + workers - 1) / workers));\n    const int stripes = (windows + stripeWidth - 1) / stripeWidth;\n    Sum maximum = std::numeric_limits<Sum>::lowest();\n\n    std::unique_ptr<std::size_t[]> tokenCounts(new std::size_t[workers]);\n    std::size_t loaded = 0;\n    std::size_t batchBase = 0;\n    const unsigned char* spanBegin = nullptr;\n    const unsigned char* spanEnd = nullptr;\n    bool haveSpan = false;\n    bool inputOkay = true;\n\n    #pragma omp parallel if(elements >= 65536) reduction(max:maximum)\n    {\n        int worker = 0;\n        int teamSize = 1;\n#ifdef _OPENMP\n        worker = omp_get_thread_num();\n        teamSize = omp_get_num_threads();\n#endif\n\n        for (;;) {\n            #pragma omp single\n            {\n                haveSpan = false;\n                while (loaded < elements) {\n                    int scalar;\n                    const int kind = input.readSpan(spanBegin, spanEnd, scalar);\n                    if (kind == 1) {\n                        batchBase = loaded;\n                        haveSpan = true;\n                        break;\n                    }\n                    if (kind == 2) {\n                        data[loaded++] = static_cast<Word>(scalar);\n                    } else {\n                        inputOkay = false;\n                        break;\n                    }\n                }\n            }\n            if (!haveSpan) break;\n\n            const unsigned char* const bytes = spanBegin;\n            const std::size_t spanLength = static_cast<std::size_t>(spanEnd - spanBegin);\n            std::size_t first = spanLength * static_cast<std::size_t>(worker)\n                / static_cast<std::size_t>(teamSize);\n            std::size_t last = spanLength * static_cast<std::size_t>(worker + 1)\n                / static_cast<std::size_t>(teamSize);\n            if (first != 0) {\n                while (first < spanLength && bytes[first - 1] > ' ') ++first;\n            }\n            if (last != spanLength) {\n                while (last < spanLength && bytes[last - 1] > ' ') ++last;\n            }\n\n            std::size_t localCount = 0;\n            if (first < last) {\n                localCount = static_cast<std::size_t>(bytes[first] > ' ');\n                #pragma omp simd reduction(+:localCount)\n                for (std::size_t k = first + 1; k < last; ++k) {\n                    localCount += static_cast<std::size_t>(\n                        (bytes[k] > ' ') & (bytes[k - 1] <= ' '));\n                }\n            }\n            tokenCounts[worker] = localCount;\n            #pragma omp barrier\n\n            std::size_t output = batchBase;\n            for (int t = 0; t < worker; ++t) output += tokenCounts[t];\n            const std::size_t toWrite = output < elements\n                ? std::min(localCount, elements - output) : 0;\n            const unsigned char* cursor = bytes + first;\n            for (std::size_t k = 0; k < toWrite; ++k) {\n                while (*cursor <= ' ') ++cursor;\n                const bool negative = *cursor == '-';\n                if (*cursor == '-' || *cursor == '+') ++cursor;\n                Word magnitude = 0;\n                while (*cursor >= '0' && *cursor <= '9') {\n                    magnitude = magnitude * 10u + static_cast<Word>(*cursor - '0');\n                    ++cursor;\n                }\n                data[output + k] = negative ? Word(0) - magnitude : magnitude;\n            }\n\n            #pragma omp single\n            {\n                std::size_t count = 0;\n                for (int t = 0; t < teamSize; ++t) count += tokenCounts[t];\n                loaded = batchBase + std::min(count, elements - batchBase);\n            }\n        }\n\n        if (inputOkay) {\n            #pragma omp for schedule(static)\n            for (int r = 0; r < n; ++r) {\n                Word* const row = data + static_cast<std::size_t>(r) * n;\n                Word total = 0;\n                #pragma omp simd reduction(+:total)\n                for (int c = 0; c < s; ++c) total += row[c];\n\n                for (int c = 0; c < windows - 1; ++c) {\n                    const Word leaving = row[c];\n                    const Word entering = row[c + s];\n                    row[c] = total;\n                    total += entering - leaving;\n                }\n                row[windows - 1] = total;\n            }\n\n            alignas(64) Word columnSums[maxStripeWidth];\n            alignas(64) Sum columnMaxima[maxStripeWidth];\n\n            #pragma omp for schedule(static) nowait\n            for (int block = 0; block < stripes; ++block) {\n                const int first = block * stripeWidth;\n                const int width = std::min(stripeWidth, windows - first);\n                #pragma omp simd\n                for (int c = 0; c < width; ++c) columnSums[c] = 0;\n\n                for (int r = 0; r < s; ++r) {\n                    const Word* const row = data + static_cast<std::size_t>(r) * n + first;\n                    #pragma omp simd\n                    for (int c = 0; c < width; ++c) columnSums[c] += row[c];\n                }\n                #pragma omp simd\n                for (int c = 0; c < width; ++c)\n                    columnMaxima[c] = signedSum(columnSums[c]);\n\n                for (int r = s; r < n; ++r) {\n                    const Word* const entering = data + static_cast<std::size_t>(r) * n + first;\n                    const Word* const leaving = data + static_cast<std::size_t>(r - s) * n + first;\n                    #pragma omp simd\n                    for (int c = 0; c < width; ++c) {\n                        const Word total = columnSums[c] + entering[c] - leaving[c];\n                        columnSums[c] = total;\n                        columnMaxima[c] = std::max(columnMaxima[c], signedSum(total));\n                    }\n                }\n\n                Sum blockMaximum = std::numeric_limits<Sum>::lowest();\n                #pragma omp simd reduction(max:blockMaximum)\n                for (int c = 0; c < width; ++c)\n                    blockMaximum = std::max(blockMaximum, columnMaxima[c]);\n                maximum = std::max(maximum, blockMaximum);\n            }\n        }\n    }\n\n    if (!inputOkay) return 0;\n    std::printf(\"%d\\n\", static_cast<int>(maximum));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

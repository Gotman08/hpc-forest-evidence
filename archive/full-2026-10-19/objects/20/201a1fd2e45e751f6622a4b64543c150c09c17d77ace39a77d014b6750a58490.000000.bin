      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system.\n */\nvoid body_force(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Alternate read-only input and independently written output buffers.\n * Each worksharing barrier completes a whole simulation step.\n */\nstatic void simulate_parallel(Body *bodies, Body *scratch, int n) {\n  #pragma omp parallel default(none) shared(bodies, scratch, n)\n  {\n    Body *src = bodies;\n    Body *dst = scratch;\n\n    for (int iter = 0; iter < N_ITER; ++iter) {\n      #pragma omp for schedule(static)\n      for (int i = 0; i < n; ++i) {\n        float fx = 0.0f;\n        float fy = 0.0f;\n        float fz = 0.0f;\n        float x = src[i].x;\n        float y = src[i].y;\n        float z = src[i].z;\n\n        for (int j = 0; j < n; ++j) {\n          float dx = src[j].x - x;\n          float dy = src[j].y - y;\n          float dz = src[j].z - z;\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          float inv_dist = 1 / sqrt(sqrd_dist);\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n        }\n\n        float vx = src[i].vx + DT*fx;\n        float vy = src[i].vy + DT*fy;\n        float vz = src[i].vz + DT*fz;\n\n        dst[i].vx = vx;\n        dst[i].vy = vy;\n        dst[i].vz = vz;\n        dst[i].x = x + vx * DT;\n        dst[i].y = y + vy * DT;\n        dst[i].z = z + vz * DT;\n      }\n\n      Body *tmp = src;\n      src = dst;\n      dst = tmp;\n    }\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n  Body *scratch = NULL;\n\n  /* Avoid parallel setup and extra storage for small populations. */\n  if (nbodies >= 128) {\n    scratch = (Body *)malloc((size_t)nbodies * sizeof(Body));\n  }\n\n  if (scratch != NULL) {\n    simulate_parallel(bodies, scratch, nbodies);\n    if (N_ITER % 2 != 0) {\n      memcpy(bodies, scratch, (size_t)nbodies * sizeof(Body));\n    }\n    free(scratch);\n  } else {\n    /* Also retain the serial path if scratch allocation fails. */\n    for (int iter = 0; iter < N_ITER; iter++) {\n      body_force(bodies, DT, nbodies);\n\n      for (int i = 0; i < nbodies; i++) {\n        bodies[i].x += bodies[i].vx * DT;\n        bodies[i].y += bodies[i].vy * DT;\n        bodies[i].z += bodies[i].vz * DT;\n      }\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Alternating body buffers lets a persistent OpenMP team fuse force calculation and position integration, reducing synchronization and cache-coherence traffic without reordering force accumulation.",

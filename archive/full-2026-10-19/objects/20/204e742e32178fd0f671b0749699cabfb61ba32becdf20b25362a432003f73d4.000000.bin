"""Record actual R8 neutral outputs. No imports of candidate code or native effects."""
from pathlib import Path
import hashlib
import json
import os
import xml.etree.ElementTree as ET

BASE = Path(r"C:\Users\nicol\Documents\Codex\2026-10-15\cr")
PREP = BASE / "outputs/HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r3"
R7 = PREP / "adaptateurs-source110-r1/revision-r7-racines-techniques-neuves"
R8 = PREP / "adaptateurs-source110-r1/revision-r8-racines-techniques-neuves"
OUT = Path(__file__).parent
SOURCE = "eaff9217499fe268e4d151165a368a83bad1550d921955a9f9256026cfac2d48"
PLAN = "f927d37098f3fd50cc4916195da3e300bd7c29597ba7ece4b9669abd715897fe"


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def need(ok, message):
    if not ok:
        raise ValueError(message)


def load(path):
    return json.loads(path.read_text(encoding="utf-8"))


def exclusive(path, value):
    data = (json.dumps(value, ensure_ascii=False, indent=2) + "\n").encode("utf-8")
    with path.open("xb") as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())
    return {"path": str(path), "sha256": sha(path)}


def actual_junit(path, expected):
    root = ET.parse(path).getroot()
    cases = list(root.iter("testcase"))
    need(len(cases) == expected, "unexpected actual primary testcase count")
    need(len({(c.get("classname"), c.get("name")) for c in cases}) == expected, "duplicate primary testcase")
    need(not any(list(root.iter(kind)) for kind in ("failure", "error", "skipped")), "actual test failure/error/skip")
    for suite in root.iter("testsuite"):
        need(all(int(suite.get(kind, "0")) == 0 for kind in ("failures", "errors", "skipped")), "suite failure/error/skip")
    return {"path": str(path), "sha256": sha(path), "primary_testcases": expected,
            "declared_tests_including_subtests": [int(s.get("tests", "0")) for s in root.iter("testsuite")]}


def main():
    completion = load(OUT / "EXECUTION-ROOT-73-ET-5.json")
    need(completion["exit_code73"] == 0 and completion["exit_code5"] == 0
         and completion["candidate60_before_after_equal"] is True, "actual successful execution required")
    candidate = load(R8 / "COMPOSANTS-NON-SCELLES.json")
    need(candidate["source_zip_sha256"] == SOURCE and candidate["plan_sha256"] == PLAN
         and candidate["verified"] is False, "unsealed R8 identity differs")
    before = {}
    for name, record in candidate["present60_candidate_inventory"].items():
        need(sha(R8 / name) == record["sha256"], "candidate60 differs from executed input")
        before[name] = record["sha256"]
    need(len(before) == 60, "exact sixty candidate files required")
    need(sha(R7 / "COMPONENTS.json") == "dc64e1360ea8c7b061cbda5eb2dc638f7cb76d9f4264c2f062a495c62ba12f30", "ancestor manifest changed")
    prior = load(R7 / "COMPONENTS.json")
    for name, expected in prior["code_pins"].items():
        need(sha(R7 / name) == expected, "ancestor component changed")
    for target in (R8 / "observer/validation-locale.json", R8 / "COMPONENTS.json"):
        need(not target.exists() and not target.is_symlink(), "output already exists")
    adapters = actual_junit(OUT / "TESTS-ADAPTATEURS-73.xml", 73)
    observer = actual_junit(R8 / "observer/TESTS-OBS4-NEUTRES.xml", 5)
    validation = {
        "schema": "hpc-forest-source110-obs4-local-neutral-validation-v1", "ok": True,
        "scope_id": "hpc-forest-dynamic-independent-roots-r4b-max",
        "source_zip_sha256": SOURCE, "plan_sha256": PLAN,
        "observer_sha256": sha(R8 / "observer/observer-mixte.py"),
        "test_sha256": sha(R8 / "observer/test_obs4_neutre.py"),
        "junit_sha256": observer["sha256"], "testcases": 5,
        "new_allocated_Q_required": True,
        "CLI_model_process_transport_CIM_or_cache_effects": 0, "native_generation_admitted": False,
    }
    validation_ref = exclusive(R8 / "observer/validation-locale.json", validation)
    pins = dict(before)
    for name in ("observer/TESTS-OBS4-NEUTRES.xml", "observer/validation-locale.json"):
        pins[name] = sha(R8 / name)
    need(set(pins) == set(prior["code_pins"]) and len(pins) == 62, "closed sixty-two component keyset required")
    manifest = {k: v for k, v in prior.items() if k != "code_pins"}
    manifest["plan_sha256"] = PLAN
    manifest["candidate_revision"] = R8.name
    manifest["code_pins"] = dict(sorted(pins.items()))
    for flag in ("verified", "native_generation_admitted", "allocated_qualification_received",
                 "independent_integration_review_received", "negative_source110_terminal_admitted"):
        need(manifest[flag] is False, "historical admission must remain false")
    components_ref = exclusive(R8 / "COMPONENTS.json", manifest)
    need(all(sha(R8 / name) == expected for name, expected in pins.items()), "component changed during sealing")
    receipt = {
        "schema": "hpc-forest-R8-actual-local-neutral-record-and-component-seal-v1",
        "actual_execution": {"path": str(OUT / "EXECUTION-ROOT-73-ET-5.json"), "sha256": sha(OUT / "EXECUTION-ROOT-73-ET-5.json")},
        "new_adapter_results": adapters, "new_observer_results": observer,
        "observer_validation": validation_ref, "components": components_ref,
        "candidate60_before_after_equal": True, "ancestor62_unchanged": True,
        "component_count": 62, "source_zip_sha256": SOURCE, "plan_sha256": PLAN,
        "local_statics16_executed": False, "new_allocated_Q_received": False,
        "native_generation_admitted": False,
        "observer_suite_declares_twelve_including_seven_subtests_but_five_unique_primary_testcases": True,
    }
    print(json.dumps(exclusive(OUT / "SCELLEMENT-LOCAL-REEL-78-ET-COMPOSANTS62.json", receipt)))


if __name__ == "__main__":
    main()

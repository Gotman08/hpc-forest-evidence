{"files":[{"content":"#include <algorithm>\n#include <cstddef>\n#include <cstdio>\n#include <limits>\n#include <memory>\n#include <vector>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nclass FastInput {\n    static constexpr std::size_t BufferSize = 1U << 20;\n    char buffer_[BufferSize];\n    std::size_t position_ = 0;\n    std::size_t length_ = 0;\n\n    int nextCharacter() {\n        if (position_ == length_) {\n            length_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (length_ == 0) {\n                return EOF;\n            }\n        }\n        return static_cast<unsigned char>(buffer_[position_++]);\n    }\n\npublic:\n    int readInt() {\n        int c = nextCharacter();\n        while (c <= ' ') {\n            if (c == EOF) {\n                return 0;\n            }\n            c = nextCharacter();\n        }\n\n        bool negative = false;\n        if (c == '-' || c == '+') {\n            negative = c == '-';\n            c = nextCharacter();\n        }\n\n        unsigned int value = 0;\n        while (static_cast<unsigned int>(c - '0') <= 9U) {\n            value = value * 10U + static_cast<unsigned int>(c - '0');\n            c = nextCharacter();\n        }\n\n        const long long signedValue = static_cast<long long>(value);\n        return static_cast<int>(negative ? -signedValue : signedValue);\n    }\n};\n\nint main() {\n    static FastInput input;\n\n    const int n = input.readInt();\n    const int s = input.readInt();\n    if (n <= 0 || s <= 0 || s >= n) {\n        return 0;\n    }\n\n    const int width = n - s + 1;\n    const std::size_t side = static_cast<std::size_t>(n);\n    const std::size_t elementCount = side * side;\n    std::unique_ptr<int[]> matrix(new int[elementCount]);\n    int* const matrixData = matrix.get();\n\n    for (std::size_t index = 0; index < elementCount; ++index) {\n        matrixData[index] = input.readInt();\n    }\n\n    int workerCount = 1;\n#ifdef _OPENMP\n    workerCount = std::min(width, std::min(4, omp_get_max_threads()));\n    while (workerCount > 1 &&\n           static_cast<long long>(workerCount) * static_cast<long long>(s - 1) >\n               static_cast<long long>(width)) {\n        --workerCount;\n    }\n#endif\n\n    const long long smallest = std::numeric_limits<long long>::min();\n    long long maximum = smallest;\n\n#ifdef _OPENMP\n#pragma omp parallel for schedule(static) num_threads(workerCount) reduction(max: maximum)\n#endif\n    for (int worker = 0; worker < workerCount; ++worker) {\n        const int firstColumn = static_cast<int>(\n            static_cast<long long>(worker) * width / workerCount);\n        const int lastColumn = static_cast<int>(\n            static_cast<long long>(worker + 1) * width / workerCount);\n        const int localWidth = lastColumn - firstColumn;\n        const int activeColumns = localWidth + s - 1;\n\n        std::vector<long long> columnSums(\n            static_cast<std::size_t>(activeColumns), 0);\n        long long* const sums = columnSums.data();\n        long long localMaximum = smallest;\n\n        for (int row = 0; row < n; ++row) {\n            const int* const current = matrixData +\n                static_cast<std::size_t>(row) * side +\n                static_cast<std::size_t>(firstColumn);\n\n            if (row < s) {\n#ifdef _OPENMP\n#pragma omp simd\n#else\n#pragma GCC ivdep\n#endif\n                for (int column = 0; column < activeColumns; ++column) {\n                    sums[column] += static_cast<long long>(current[column]);\n                }\n            } else {\n                const int* const expired = current -\n                    static_cast<std::size_t>(s) * side;\n#ifdef _OPENMP\n#pragma omp simd\n#else\n#pragma GCC ivdep\n#endif\n                for (int column = 0; column < activeColumns; ++column) {\n                    sums[column] += static_cast<long long>(current[column]) -\n                                    static_cast<long long>(expired[column]);\n                }\n            }\n\n            if (row >= s - 1) {\n                long long window = 0;\n#ifdef _OPENMP\n#pragma omp simd reduction(+: window)\n#endif\n                for (int column = 0; column < s; ++column) {\n                    window += sums[column];\n                }\n\n                if (window > localMaximum) {\n                    localMaximum = window;\n                }\n                for (int start = 1; start < localWidth; ++start) {\n                    window += sums[start + s - 1] - sums[start - 1];\n                    if (window > localMaximum) {\n                        localMaximum = window;\n                    }\n                }\n            }\n        }\n\n        if (localMaximum > maximum) {\n            maximum = localMaximum;\n        }\n    }\n\n    std::printf(\"%lld\\n\", maximum);\n    return 0;\n}\n","path":"src/solution.cpp"}],"hypothesis":"A flat separable scan exposes dependency-free vertical updates to SIMD while keeping the true horizontal rolling dependency scalar; halo-aware persistent column bands can use available OpenMP workers safely.","notes":"The OpenMP path is conditional, so the same source retains a single-band GCC fallback when OpenMP is unavailable.","sources_kept":[],"transformations":["Replace the jagged O(S*N^2) snake traversal with int64 vertical rolling sums and horizontal window rolls.","Store input in one uninitialized flat row-major int allocation and use buffered integer parsing.","Partition output starts into contiguous halo-equipped bands, reducing worker count when halo work dominates.","Apply SIMD only to independent column updates and the explicit initial-sum reduction; do not annotate the loop-carried horizontal roll."]}
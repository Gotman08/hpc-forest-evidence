#include <cstdio>
#include <vector>
#include <climits>
#include <omp.h>

class FastScanner {
    static const int BUFSIZE = 1 << 20;
    int idx, size;
    char buf[BUFSIZE];
public:
    FastScanner() : idx(0), size(0) {}
    inline int nextInt() {
        char c;
        do { c = getChar(); } while (c <= ' ' && c);
        int sign = 1;
        if (c == '-') { sign = -1; c = getChar(); }
        long long x = 0;
        for (; c >= '0' && c <= '9'; c = getChar()) {
            x = x * 10 + (c - '0');
        }
        return static_cast<int>(sign * x);
    }
private:
    inline char getChar() {
        if (idx >= size) {
            size = fread(buf, 1, BUFSIZE, stdin);
            idx = 0;
            if (size == 0) return '\0';
        }
        return buf[idx++];
    }
};

int main() {
    FastScanner fs;
    int n = fs.nextInt();
    int s = fs.nextInt();

    std::vector<int> a(static_cast<size_t>(n) * n);
    for (int i = 0; i < n; ++i) {
        int* row = &a[static_cast<size_t>(i) * n];
        for (int j = 0; j < n; ++j) {
            row[j] = fs.nextInt();
        }
    }

    long long mxSum = -(1LL << 62);
    const int totalRows = n - s + 1;

#pragma omp parallel reduction(max:mxSum)
    {
        const int tid = omp_get_thread_num();
        const int nt = omp_get_num_threads();

        long long v[8000];
        long long pref[8001];

        const int q = totalRows / nt;
        const int r = totalRows % nt;
        const int base = q * tid + (tid < r ? tid : r);
        const int len = q + (tid < r ? 1 : 0);

        if (len > 0) {
            long long* __restrict vp = v;
            // Initialize column sums directly from the first row, then add remaining S-1 rows.
            const int* __restrict firstRow = &a[static_cast<size_t>(base) * n];
#pragma omp simd
            for (int j = 0; j < n; ++j) vp[j] = static_cast<long long>(firstRow[j]);
            for (int k = 1; k < s; ++k) {
                const int* __restrict row = &a[static_cast<size_t>(base + k) * n];
#pragma omp simd
                for (int j = 0; j < n; ++j) vp[j] += static_cast<long long>(row[j]);
            }

            pref[0] = 0;
            for (int i = 0; i < n; ++i) {
                pref[i + 1] = pref[i] + vp[i];
            }
            long long rowBest = LLONG_MIN;
#pragma omp simd reduction(max:rowBest)
            for (int j = 0; j <= n - s; ++j) {
                const long long w = pref[j + s] - pref[j];
                if (w > rowBest) rowBest = w;
            }
            if (rowBest > mxSum) mxSum = rowBest;

            for (int idx = 1; idx < len; ++idx) {
                const int outRow = base + idx - 1;
                const int inRow = outRow + s;
                const int* __restrict inPtr = &a[static_cast<size_t>(inRow) * n];
                const int* __restrict outPtr = &a[static_cast<size_t>(outRow) * n];
#pragma omp simd
                for (int j = 0; j < n; ++j) {
                    vp[j] += static_cast<long long>(inPtr[j]) - outPtr[j];
                }

                pref[0] = 0;
                for (int i = 0; i < n; ++i) {
                    pref[i + 1] = pref[i] + vp[i];
                }
                long long rowBest2 = LLONG_MIN;
#pragma omp simd reduction(max:rowBest2)
                for (int j = 0; j <= n - s; ++j) {
                    const long long w = pref[j + s] - pref[j];
                    if (w > rowBest2) rowBest2 = w;
                }
                if (rowBest2 > mxSum) mxSum = rowBest2;
            }
        }
    }

    std::printf("%lld\n", mxSum);
    return 0;
}

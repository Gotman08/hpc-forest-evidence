{"files":[{"content":"#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdio>\n#include <cstring>\n#include <limits>\n#include <memory>\n#include <vector>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nstruct alignas(64) TokenCount {\n    std::size_t value;\n};\n\nint main() {\n    int n, s;\n    if (std::scanf(\"%d%d\", &n, &s) != 2) return 0;\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t cells = static_cast<std::size_t>(n) * n;\n    std::unique_ptr<int[]> matrix(new int[cells]);\n    int threads = 1;\n#ifdef _OPENMP\n    const int useful = static_cast<int>(\n        std::max<std::size_t>(1, cells / (64U * 1024U)));\n    threads = std::min(4, std::min(omp_get_max_threads(), useful));\n#endif\n\n    std::size_t capacity = std::min<std::size_t>(\n        4U * 1024U * 1024U,\n        std::max<std::size_t>(64U * 1024U, cells * 4U));\n    std::unique_ptr<unsigned char[]> input(new unsigned char[capacity + 1]);\n    TokenCount counts[4] = {};\n    std::size_t processed = 0;\n    std::size_t ready = 0;\n    std::size_t carry = 0;\n    bool done = false;\n    long long best = std::numeric_limits<long long>::lowest();\n\n#pragma omp parallel num_threads(threads) reduction(max:best)\n    {\n        int id = 0;\n        int team = 1;\n#ifdef _OPENMP\n        id = omp_get_thread_num();\n        team = omp_get_num_threads();\n#endif\n        for (;;) {\n#pragma omp single\n            {\n                std::size_t batch_tokens = 0;\n                for (int t = 0; t < team; ++t)\n                    batch_tokens += counts[t].value;\n                processed = std::min(cells, processed + batch_tokens);\n                done = (processed == cells);\n                if (!done) {\n                    if (carry != 0)\n                        std::memmove(input.get(), input.get() + ready, carry);\n                    std::size_t filled = carry;\n                    for (;;) {\n                        if (filled == capacity) {\n                            const std::size_t larger_capacity = capacity * 2;\n                            std::unique_ptr<unsigned char[]> larger(\n                                new unsigned char[larger_capacity + 1]);\n                            std::memcpy(larger.get(), input.get(), filled);\n                            input.swap(larger);\n                            capacity = larger_capacity;\n                        }\n                        const std::size_t wanted = capacity - filled;\n                        const std::size_t got = std::fread(\n                            input.get() + filled, 1, wanted, stdin);\n                        filled += got;\n                        if (got < wanted) {\n                            ready = filled;\n                            carry = 0;\n                            done = (ready == 0);\n                            break;\n                        }\n                        ready = filled;\n                        while (ready != 0 && input[ready - 1] > ' ')\n                            --ready;\n                        if (ready != 0) {\n                            carry = filled - ready;\n                            break;\n                        }\n                    }\n                    input[filled] = ' ';\n                }\n            }\n            if (done) break;\n\n            const unsigned char* raw = input.get();\n            std::size_t begin = ready * static_cast<std::size_t>(id) / team;\n            std::size_t end = ready * static_cast<std::size_t>(id + 1) / team;\n            if (id != 0)\n                while (begin < ready && raw[begin] > ' ') ++begin;\n            if (id + 1 != team)\n                while (end < ready && raw[end] > ' ') ++end;\n\n            unsigned int count = 0;\n            if (begin < end) {\n                count = static_cast<unsigned int>(raw[begin] > ' ');\n#pragma omp simd reduction(+:count)\n                for (std::size_t k = begin + 1; k < end; ++k)\n                    count += static_cast<unsigned int>(\n                        (raw[k] > ' ') & (raw[k - 1] <= ' '));\n            }\n            counts[id].value = count;\n#pragma omp barrier\n            std::size_t base = processed;\n            for (int t = 0; t < id; ++t) base += counts[t].value;\n            const std::size_t emit = base < cells\n                ? std::min<std::size_t>(counts[id].value, cells - base) : 0;\n            if (emit != 0) {\n                int* destination = matrix.get() + base;\n                const unsigned char* p = raw + begin;\n                for (std::size_t k = 0; k < emit; ++k) {\n                    while (*p <= ' ') ++p;\n                    const bool negative = (*p == '-');\n                    if (*p == '-' || *p == '+') ++p;\n                    unsigned int value = 0;\n                    while (*p > ' ') {\n                        value = value * 10U + static_cast<unsigned int>(*p - '0');\n                        ++p;\n                    }\n                    destination[k] = negative\n                        ? static_cast<int>(-static_cast<long long>(value))\n                        : static_cast<int>(value);\n                }\n            }\n#pragma omp barrier\n        }\n\n        if (processed == cells) {\n            const int windows = n - s + 1;\n            const int rows_per_thread = windows / team;\n            const int extra = windows % team;\n            const int first = id * rows_per_thread + std::min(id, extra);\n            const int last = first + rows_per_thread + (id < extra);\n            if (first < last) {\n                std::vector<long long> storage(n, 0);\n                long long* columns = storage.data();\n                for (int row = first; row < first + s; ++row) {\n                    const int* source = matrix.get()\n                        + static_cast<std::size_t>(row) * n;\n#pragma omp simd\n                    for (int col = 0; col < n; ++col)\n                        columns[col] += source[col];\n                }\n                long long first_sum = 0;\n#pragma omp simd reduction(+:first_sum)\n                for (int col = 0; col < s; ++col)\n                    first_sum += columns[col];\n\n                for (int row = first; row < last; ++row) {\n                    long long sum = first_sum;\n                    best = std::max(best, sum);\n                    for (int col = s; col < n; ++col) {\n                        sum += columns[col] - columns[col - s];\n                        best = std::max(best, sum);\n                    }\n                    if (row + 1 < last) {\n                        const int* exiting = matrix.get()\n                            + static_cast<std::size_t>(row) * n;\n                        const int* entering = matrix.get()\n                            + static_cast<std::size_t>(row + s) * n;\n                        long long delta = 0;\n#pragma omp simd reduction(+:delta)\n                        for (int col = 0; col < s; ++col) {\n                            const long long change =\n                                static_cast<long long>(entering[col]) - exiting[col];\n                            columns[col] += change;\n                            delta += change;\n                        }\n                        first_sum += delta;\n#pragma omp simd\n                        for (int col = s; col < n; ++col)\n                            columns[col] +=\n                                static_cast<long long>(entering[col]) - exiting[col];\n                    }\n                }\n            }\n        }\n    }\n    if (processed != cells) return 0;\n    std::printf(\"%lld\\n\", best);\n    return 0;\n}\n","path":"src/solution.cpp"}],"hypothesis":"Parallel token decoding and balanced rolling-window row bands within one persistent OpenMP team should reduce serial parsing and team-startup overhead while retaining compact storage.","notes":"Not executed. Uses at most four threads, scales down small workloads, and preserves exact integer output with 64-bit sums.","sources_kept":[],"transformations":["Decode bounded input batches using static token-aligned byte partitions, parallel token counts, and disjoint destination offsets.","Reuse the same OpenMP team for balanced contiguous row bands with private rolling column sums and a maximum reduction.","Fuse first-window updates, vectorize independent loops, and require coarse per-thread work before enabling additional threads."]}
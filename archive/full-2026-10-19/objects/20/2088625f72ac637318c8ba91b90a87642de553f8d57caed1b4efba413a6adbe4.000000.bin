{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <algorithm>\\n#include <cstdint>\\n#include <iostream>\\n#include <vector>\\n\\n#if defined(__aarch64__)\\n#include <arm_neon.h>\\n\\nstatic inline uint32x4_t prefix4_mod(uint32x4_t values) {\\n    const uint32x4_t zero = vdupq_n_u32(0);\\n    const uint32x4_t modulus = vdupq_n_u32(1000000007u);\\n    uint32x4_t prefix = vaddq_u32(values, vextq_u32(zero, values, 3));\\n    prefix = vaddq_u32(prefix, vextq_u32(zero, prefix, 2));\\n\\n    // Each local prefix is less than 4*MOD, so three subtractions suffice.\\n    for (int r = 0; r < 3; ++r) {\\n        const uint32x4_t mask = vcgeq_u32(prefix, modulus);\\n        prefix = vsubq_u32(prefix, vandq_u32(mask, modulus));\\n    }\\n    return prefix;\\n}\\n#endif\\n\\nusing namespace std;\\n\\nconstexpr uint32_t MOD = 1000000007u;\\n\\nstatic inline void scan_unblocked_segment(uint32_t *dp, int begin, int end) {\\n    int col = begin;\\n    uint32_t carry = 0;\\n\\n#if defined(__aarch64__)\\n    const uint32x4_t modulus = vdupq_n_u32(MOD);\\n\\n    // Compute two independent local scans together, then propagate the carry\\n    // between them. The only cross-vector dependency is the segment prefix.\\n    for (; col + 8 <= end; col += 8) {\\n        uint32x4_t prefix0 = prefix4_mod(vld1q_u32(dp + col));\\n        uint32x4_t prefix1 = prefix4_mod(vld1q_u32(dp + col + 4));\\n\\n        prefix0 = vaddq_u32(prefix0, vdupq_n_u32(carry));\\n        uint32x4_t mask = vcgeq_u32(prefix0, modulus);\\n        prefix0 = vsubq_u32(prefix0, vandq_u32(mask, modulus));\\n        const uint32_t carry_after_first = vgetq_lane_u32(prefix0, 3);\\n        vst1q_u32(dp + col, prefix0);\\n\\n        prefix1 = vaddq_u32(prefix1, vdupq_n_u32(carry_after_first));\\n        mask = vcgeq_u32(prefix1, modulus);\\n        prefix1 = vsubq_u32(prefix1, vandq_u32(mask, modulus));\\n        vst1q_u32(dp + col + 4, prefix1);\\n        carry = vgetq_lane_u32(prefix1, 3);\\n    }\\n\\n    for (; col + 4 <= end; col += 4) {\\n        uint32x4_t prefix = prefix4_mod(vld1q_u32(dp + col));\\n        prefix = vaddq_u32(prefix, vdupq_n_u32(carry));\\n        const uint32x4_t mask = vcgeq_u32(prefix, modulus);\\n        prefix = vsubq_u32(prefix, vandq_u32(mask, modulus));\\n        vst1q_u32(dp + col, prefix);\\n        carry = vgetq_lane_u32(prefix, 3);\\n    }\\n#endif\\n\\n    for (; col < end; ++col) {\\n        carry += dp[col];\\n        if (carry >= MOD) carry -= MOD;\\n        dp[col] = carry;\\n    }\\n}\\n\\nint main() {\\n    ios::sync_with_stdio(false);\\n    cin.tie(nullptr);\\n\\n    int n, m;\\n    cin >> n >> m;\\n\\n    vector<vector<int>> blockedCols(n);\\n    for (int c = 0; c < m; ++c) {\\n        int row, col;\\n        cin >> row >> col;\\n        blockedCols[row].push_back(col);\\n    }\\n\\n    // In row zero, each cell is reachable only until the first blocked cell.\\n    int firstBlocked = n;\\n    for (int col : blockedCols[0]) {\\n        firstBlocked = min(firstBlocked, col);\\n    }\\n    vector<uint32_t> dp(n, 0);\\n    fill(dp.begin(), dp.begin() + firstBlocked, 1u);\\n\\n    vector<uint8_t> blockedInRow(n, 0);\\n    for (int row = 1; row < n; ++row) {\\n        for (int col : blockedCols[row]) blockedInRow[col] = 1;\\n\\n        int col = 0;\\n        while (col < n) {\\n            if (blockedInRow[col]) {\\n                dp[col] = 0;\\n                ++col;\\n                continue;\\n            }\\n\\n            const int begin = col;\\n            do {\\n                ++col;\\n            } while (col < n && !blockedInRow[col]);\\n            scan_unblocked_segment(dp.data(), begin, col);\\n        }\\n\\n        for (int blockedCol : blockedCols[row]) blockedInRow[blockedCol] = 0;\\n    }\\n\\n    cout << dp[n - 1] << '\\\\n';\\n    return 0;\\n}\\n\",\"path\":\"src/solution.cpp\"}],\"hypothesis\":\"Unrolling the legal NEON prefix scan by two vectors may reduce loop-control overhead and expose independent local-prefix work to the compiler, while carrying the first vector's final residue into the second preserves the horizontal recurrence.\",\"notes\":\"Retains the rolling-row recurrence, obstacle resets, and scalar tail. The controller should evaluate correctness and performance; no speedup is assumed.\",\"sources_kept\":[],\"transformations\":[\"Factor the four-lane inclusive modular prefix calculation into an AArch64 NEON helper.\",\"Process eight cells per main SIMD iteration by computing two local four-lane scans and propagating the segment carry between them; retain four-lane and scalar tails.\"]}"}}

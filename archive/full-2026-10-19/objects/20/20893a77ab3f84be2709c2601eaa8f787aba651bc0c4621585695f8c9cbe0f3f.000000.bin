#include <stdio.h>
#include <stdlib.h>
#include <assert.h>
#include <string.h>

/* qsort's comparator reads this shared, immutable input while bucket sorts run. */
static char *sort_strings;
static int sort_length;

typedef struct {
	long int *data;
	long int total;
} bucket;

static int compare_indices(const void *left, const void *right) {
	long int left_index = *(const long int *)left;
	long int right_index = *(const long int *)right;
	return strcmp(sort_strings + left_index * sort_length,
	              sort_strings + right_index * sort_length);
}

long int* bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {
	long int i;
	long int start = 0;
	long int *returns = NULL;
	long int *counts = NULL;
	bucket *buckets = NULL;

	if (size <= 0)
		return NULL;

	returns = (long int *)malloc(sizeof(long int) * size);
	counts = (long int *)calloc((size_t)nbuckets, sizeof(long int));
	buckets = (bucket *)malloc(sizeof(bucket) * (size_t)nbuckets);

	/* Count first, then assign disjoint, exactly sized ranges in returns. */
	for (i = 0; i < size; i++) {
		int key = *(a + i * length) - offset;
		counts[key]++;
	}

	for (i = 0; i < nbuckets; i++) {
		buckets[i].data = returns + start;
		buckets[i].total = 0;
		start += counts[i];
	}

	/* Fill the bucket ranges with indices into the original strings. */
	for (i = 0; i < size; i++) {
		int key = *(a + i * length) - offset;
		bucket *b = &buckets[key];
		b->data[b->total++] = i;
	}

	sort_strings = a;
	sort_length = length;
	if (size >= 4096 && nbuckets > 1) {
		#pragma omp parallel for schedule(dynamic, 1) num_threads(4)
		for (int j = 0; j < nbuckets; j++)
			qsort(buckets[j].data, (size_t)buckets[j].total,
			      sizeof(long int), compare_indices);
	} else {
		for (i = 0; i < nbuckets; i++)
			qsort(buckets[i].data, (size_t)buckets[i].total,
			      sizeof(long int), compare_indices);
	}

	free(counts);
	free(buckets);
	return returns;
}

void load(char **vString, long int *N, int *l, int *os, int *nb){
   char *strings = NULL;
   int      len,
            offset,
            nbucket;
   long int n;

   if (!fscanf(stdin, "%d", &len)) {
      printf ("ERROR len\n");
      exit (1);
   }

   if (!fscanf(stdin, "%ld", &n)) {
      printf ("ERROR n\n");
      exit (1);
   }

   if (!fscanf(stdin, "%d", &offset)) {
      printf ("ERROR offset\n");
      exit (1);
   }

   if (!fscanf(stdin, "%d", &nbucket)) {
      printf ("ERROR nbucket\n");
      exit (1);
   }

   nbucket = nbucket + 1;
   len = len + 1;

   strings = (char*) malloc(n * len);

   for (int i = 0; i < n; i++){
      if (!fscanf(stdin, "%s", strings + (i * len))) {
      printf ("ERROR %d\n",i);
      exit (1);
      }
   }

   *vString = strings;
   *N = n;
   *l = len;
   *os = offset;
   *nb = nbucket;
}

void print(char *strings, long int *index, long int n, int len){

   for (int i = 0; i < n; i++){
      printf("%d -> %s\n", i, strings + (index[i] * len));
   }
}

void save(char *strings, long int *index, long int n, int len){
   for (int i = 0; i < n; i++){
      printf("%s\n", strings + (index[i] * len));
   }
}

int main(int ac, char **av) {

   char     *strings = NULL;
   long int N        = 0;
   long int *index   = NULL;
   int      len      = 0,
            save2File = 0,
            offset,
            nbuckets;

   load(&strings, &N, &len, &offset, &nbuckets);

   index = bucket_sort(strings, len, N, offset, nbuckets);

   save(strings, index, N, len);

   if (strings != NULL)
      free(strings);

   if (index != NULL)
      free(index);

   return EXIT_SUCCESS;
}

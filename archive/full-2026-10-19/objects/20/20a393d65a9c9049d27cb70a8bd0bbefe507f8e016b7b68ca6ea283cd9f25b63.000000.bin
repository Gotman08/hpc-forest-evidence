{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"/*\\n  Quicksort\\n*/\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <limits.h>\\n#include <stdint.h>\\n#include <openssl/md5.h>\\n\\n#if defined(__aarch64__) && defined(__ARM_NEON) && defined(__AARCH64EL__)\\n#include <arm_neon.h>\\n#define QUICKSORT_NEON_MASKS 1\\n#else\\n#define QUICKSORT_NEON_MASKS 0\\n#endif\\n\\n/*\\n * Prototypes\\n */\\nvoid srandnum(int seed);\\ndouble randnum(void);\\nint *generate_case(int N);\\ndouble drand(int xmin, int xmax);\\nvoid swap(int *toorder, int i, int j);\\nint partition(int *toorder, int lo, int hi);\\nvoid _quicksort(int *toorder, int lo, int hi);\\nvoid quicksort(int *toorder, int N);\\nint is_sorted(int *toorder, int N);\\n\\nstatic void quicksort_range(int *toorder, int lo, int hi,\\n                            unsigned int depth);\\n\\nenum { PARTITION_BLOCK_SIZE = 16, INSERTION_SORT_LIMIT = 24 };\\n\\n/*\\n * A generic pRNG\\n */\\n#define MY_RAND_MAX 0x7FFFFFFF\\n\\n#define RANDNUM_W 521288629\\n#define RANDNUM_Z 362436069\\n\\nunsigned int randum_w = RANDNUM_W;\\nunsigned int randum_z = RANDNUM_Z;\\n\\nvoid srandnum(int seed)\\n{\\n    unsigned int w, z;\\n    w = (seed * 104623) & 0xffffffff;\\n    randum_w = (w) ? w : RANDNUM_W;\\n    z = (seed * 48947) & 0xffffffff;\\n    randum_z = (z) ? z : RANDNUM_Z;\\n}\\n\\ndouble randnum(void)\\n{\\n    unsigned int u;\\n    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);\\n    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);\\n    u = (randum_z << 16) + randum_w;\\n    return (abs(u));\\n}\\n\\n/*\\n * Main function\\n */\\nint main(int argc, char *argv[])\\n{\\n    int N = 0;\\n    int *our_list = NULL;\\n\\n    //The input provides the case size\\n\\tscanf(\\\"%d\\\", &N);\\n    if (N <= 0) {\\n\\tprintf(\\\"Error: please, provide the case size.\\\\n\\\");\\n\\treturn 1;\\n    }\\n\\n    //Generate the case\\n    our_list = generate_case(N);\\n    if (our_list == NULL) {\\n\\tprintf(\\\"Error: case instantiation failed.\\\\n\\\");\\n\\treturn 1;\\n    }\\n\\n    //Do the thing\\n    quicksort(our_list, N);\\n\\n    if (is_sorted(our_list, N) == 1) {\\n\\tprintf(\\\"Error, for some reason list is still unsorted.\\\\n\\\");\\n\\treturn 1;\\n    }\\n\\n#ifdef COMPUTE_MD5_PROBLEM\\n    //Compute MD5 Checksum for problem identification\\n    MD5_CTX c;\\n    unsigned char out[MD5_DIGEST_LENGTH];\\n    MD5_Init(&c);\\n    MD5_Update(&c, our_list, N * sizeof(int));\\n    MD5_Final(out, &c);\\n    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {\\n\\tprintf(\\\"%02x\\\", out[n]);\\n    }\\n#endif\\n    printf(\\\"\\\\n\\\");\\n\\n    //Clean up\\n    free(our_list);\\n\\n    return 0;\\n}\\n\\n/*\\n * Public API\\n */\\nvoid quicksort(int *toorder, int N)\\n{\\n    if (N > 1)\\n        _quicksort(toorder, 0, N - 1);\\n}\\n\\n/*\\n * Initialize an introspective partition-depth budget.\\n */\\nvoid _quicksort(int *toorder, int lo, int hi)\\n{\\n    if (lo >= hi)\\n        return;\\n\\n    unsigned int count = (unsigned int)(hi - lo) + 1u;\\n    unsigned int depth = 0;\\n    while (count > 1u) {\\n        depth += 2u;\\n        count >>= 1;\\n    }\\n    quicksort_range(toorder, lo, hi, depth);\\n}\\n\\n/*\\n * Swap two values.\\n */\\nvoid swap(int *toorder, int i, int j)\\n{\\n    int temp = toorder[i];\\n    toorder[i] = toorder[j];\\n    toorder[j] = temp;\\n}\\n\\n#if QUICKSORT_NEON_MASKS\\n/*\\n * Pack sixteen comparison results into bits 0, 4, ..., 60.\\n * The narrowing sequence uses the little-endian lane representation.\\n */\\nstatic inline uint64_t pack_comparisons(uint32x4_t a, uint32x4_t b,\\n                                        uint32x4_t c, uint32x4_t d)\\n{\\n    uint16x8_t ab = vuzp1q_u16(vreinterpretq_u16_u32(a),\\n                              vreinterpretq_u16_u32(b));\\n    uint16x8_t cd = vuzp1q_u16(vreinterpretq_u16_u32(c),\\n                              vreinterpretq_u16_u32(d));\\n    uint8x16_t bytes = vuzp1q_u8(vreinterpretq_u8_u16(ab),\\n                                vreinterpretq_u8_u16(cd));\\n    uint8x8_t nibbles = vshrn_n_u16(vreinterpretq_u16_u8(bytes), 4);\\n    return vget_lane_u64(vreinterpret_u64_u8(nibbles), 0)\\n           & UINT64_C(0x1111111111111111);\\n}\\n#endif\\n\\nstatic inline uint64_t block_ge_mask(const int *values, int pivot)\\n{\\n#if QUICKSORT_NEON_MASKS\\n    int32x4_t p = vdupq_n_s32(pivot);\\n    uint32x4_t a = vcgeq_s32(vld1q_s32(values), p);\\n    uint32x4_t b = vcgeq_s32(vld1q_s32(values + 4), p);\\n    uint32x4_t c = vcgeq_s32(vld1q_s32(values + 8), p);\\n    uint32x4_t d = vcgeq_s32(vld1q_s32(values + 12), p);\\n    return pack_comparisons(a, b, c, d);\\n#else\\n    uint64_t mask = 0;\\n    for (int i = 0; i < PARTITION_BLOCK_SIZE; ++i)\\n        mask |= (uint64_t)(values[i] >= pivot) << (4 * i);\\n    return mask;\\n#endif\\n}\\n\\nstatic inline uint64_t block_le_mask(const int *values, int pivot)\\n{\\n#if QUICKSORT_NEON_MASKS\\n    int32x4_t p = vdupq_n_s32(pivot);\\n    uint32x4_t a = vcleq_s32(vld1q_s32(values), p);\\n    uint32x4_t b = vcleq_s32(vld1q_s32(values + 4), p);\\n    uint32x4_t c = vcleq_s32(vld1q_s32(values + 8), p);\\n    uint32x4_t d = vcleq_s32(vld1q_s32(values + 12), p);\\n    return pack_comparisons(a, b, c, d);\\n#else\\n    uint64_t mask = 0;\\n    for (int i = 0; i < PARTITION_BLOCK_SIZE; ++i)\\n        mask |= (uint64_t)(values[i] <= pivot) << (4 * i);\\n    return mask;\\n#endif\\n}\\n\\n/* Called only with a nonzero mask. */\\nstatic inline int first_flag_offset(uint64_t mask)\\n{\\n#if defined(__GNUC__) || defined(__clang__)\\n    return __builtin_ctzll(mask) >> 2;\\n#else\\n    int offset = 0;\\n    while ((mask & UINT64_C(1)) == 0) {\\n        mask >>= 4;\\n        ++offset;\\n    }\\n    return offset;\\n#endif\\n}\\n\\n/*\\n * Classify disjoint blocks before exchanging any of their elements.\\n * Finished left blocks contain values <= pivot; finished right blocks\\n * contain values >= pivot. Equal keys may populate either partition.\\n */\\nint partition(int *toorder, int lo, int hi)\\n{\\n    int middle = lo + (hi - lo) / 2;\\n    int pivot_index;\\n    if (toorder[lo] < toorder[middle]) {\\n        if (toorder[middle] < toorder[hi])\\n            pivot_index = middle;\\n        else\\n            pivot_index = toorder[lo] < toorder[hi] ? hi : lo;\\n    } else {\\n        if (toorder[lo] < toorder[hi])\\n            pivot_index = lo;\\n        else\\n            pivot_index = toorder[middle] < toorder[hi] ? hi : middle;\\n    }\\n\\n    int pivot = toorder[pivot_index];\\n    swap(toorder, pivot_index, hi);\\n    int left = lo;\\n    int right = hi - 1;\\n    uint64_t left_mask = 0;\\n    uint64_t right_mask = 0;\\n\\n    while (right - left + 1 >= 2 * PARTITION_BLOCK_SIZE) {\\n        int right_base = right - PARTITION_BLOCK_SIZE + 1;\\n        if (left_mask == 0)\\n            left_mask = block_ge_mask(toorder + left, pivot);\\n        if (right_mask == 0)\\n            right_mask = block_le_mask(toorder + right_base, pivot);\\n\\n        while (left_mask != 0 && right_mask != 0) {\\n            int i = left + first_flag_offset(left_mask);\\n            int j = right_base + first_flag_offset(right_mask);\\n            swap(toorder, i, j);\\n            left_mask &= left_mask - 1;\\n            right_mask &= right_mask - 1;\\n        }\\n\\n        if (left_mask == 0)\\n            left += PARTITION_BLOCK_SIZE;\\n        if (right_mask == 0)\\n            right -= PARTITION_BLOCK_SIZE;\\n    }\\n\\n    /* Revisit any partially consumed block within the remaining range. */\\n    while (left <= right) {\\n        while (left <= right && toorder[left] < pivot)\\n            ++left;\\n        while (left <= right && toorder[right] > pivot)\\n            --right;\\n        if (left > right)\\n            break;\\n        swap(toorder, left, right);\\n        ++left;\\n        --right;\\n    }\\n    swap(toorder, left, hi);\\n    return left;\\n}\\n\\nstatic void insertion_sort(int *toorder, int lo, int hi)\\n{\\n    for (int i = lo + 1; i <= hi; ++i) {\\n        int value = toorder[i];\\n        int j = i;\\n        while (j > lo && value < toorder[j - 1]) {\\n            toorder[j] = toorder[j - 1];\\n            --j;\\n        }\\n        toorder[j] = value;\\n    }\\n}\\n\\nstatic void sift_down(int *values, size_t root, size_t count)\\n{\\n    int value = values[root];\\n    while (root < count / 2) {\\n        size_t child = 2 * root + 1;\\n        if (child + 1 < count && values[child] < values[child + 1])\\n            ++child;\\n        if (value >= values[child])\\n            break;\\n        values[root] = values[child];\\n        root = child;\\n    }\\n    values[root] = value;\\n}\\n\\nstatic void heap_sort(int *values, size_t count)\\n{\\n    for (size_t parent = count / 2; parent > 0; --parent)\\n        sift_down(values, parent - 1, count);\\n\\n    for (size_t end = count; end > 1;) {\\n        --end;\\n        int temp = values[0];\\n        values[0] = values[end];\\n        values[end] = temp;\\n        sift_down(values, 0, end);\\n    }\\n}\\n\\nstatic void quicksort_range(int *toorder, int lo, int hi,\\n                            unsigned int depth)\\n{\\n    while (lo < hi) {\\n        if (hi - lo < INSERTION_SORT_LIMIT) {\\n            insertion_sort(toorder, lo, hi);\\n            return;\\n        }\\n        if (depth == 0) {\\n            heap_sort(toorder + lo, (size_t)(hi - lo) + 1);\\n            return;\\n        }\\n        --depth;\\n        int b = partition(toorder, lo, hi);\\n\\n        /* Recurse only into the smaller side to bound stack usage. */\\n        if (b - lo < hi - b) {\\n            quicksort_range(toorder, lo, b - 1, depth);\\n            lo = b + 1;\\n        } else {\\n            quicksort_range(toorder, b + 1, hi, depth);\\n            hi = b - 1;\\n        }\\n    }\\n}\\n\\n/*\\n * Check if elements are in non-decreasing order\\n */\\nint is_sorted(int *toorder, int N)\\n{\\n    for (int i = 1; i < N; i++) {\\n\\tif (toorder[i] < toorder[i - 1]) {\\n\\t    return 1;\\n\\t}\\n    }\\n    return 0;\\n}\\n\\n\\n/*\\n * Generate a case\\n */\\nint *generate_case(int N)\\n{\\n    int i;\\n    int *ret = NULL;\\n\\n    // Make case generation reproducible\\n    srandnum(0);\\n\\n    // Allocate memory\\n    ret = (int *) malloc(N * sizeof(int));\\n    if (ret == NULL) {\\n\\tprintf(\\\"Error: some malloc won't work.\\\\n\\\");\\n\\treturn NULL;\\n    }\\n    // Get pseudo-random positive integer values\\n    for (i = 0; i < N; i++) {\\n\\tret[i] = drand(0, INT_MAX);\\n    }\\n    return ret;\\n}\\n\\n/*\\n * A pseudo-random number between two positive integer values\\n */\\ndouble drand(int xmin, int xmax)\\n{\\n    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;\\n}\\n\",\n      \"path\": \"src/quicksort.c\"\n    }\n  ],\n  \"hypothesis\": \"NEON classification of disjoint blocks should reduce partitioning branches and loop-carried dependencies while keeping dependent exchanges scalar.\",\n  \"notes\": \"Not executed or measured. Generation, verification and MD5 output remain unchanged. Uses guarded ARM64 NEON with a scalar fallback; no threading or build changes.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Replace Lomuto partitioning with two-ended 16-element predicate masks and serial exchanges; vector loads remain within disjoint active blocks.\",\n    \"Use deterministic median-of-three pivots and allow equal keys on both sides.\",\n    \"Use insertion sorting for ranges of at most 24 elements, smaller-side recursion, and an introspective heapsort fallback.\"\n  ]\n}"}}

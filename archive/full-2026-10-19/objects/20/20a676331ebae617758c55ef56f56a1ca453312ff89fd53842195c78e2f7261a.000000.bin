      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n\n#define MAXNUM 100\n#define MAXSTR 50\n#define MAXRESULTS 1000\n\ntypedef struct {\n    uint32_t value;\n    uint32_t scale;\n} DecimalFragment;\n\nuint32_t firstHalf[MAXNUM];\nDecimalFragment secondHalf[MAXNUM];\nlong int result[MAXRESULTS];\nint numPrimes=0;\n\nstatic DecimalFragment decode_fragment(const char *text)\n{\n    DecimalFragment fragment = {0u, 1u};\n    while (*text != '\\0') {\n        fragment.value = fragment.value * 10u + (uint32_t)(*text - '0');\n        fragment.scale *= 10u;\n        ++text;\n    }\n    return fragment;\n}\n\nstatic uint32_t integer_root(uint32_t value)\n{\n    uint32_t low = 0u;\n    uint32_t high = 65536u;\n    while (high - low > 1u) {\n        uint32_t middle = low + (high - low) / 2u;\n        if ((uint64_t)middle * middle <= value)\n            low = middle;\n        else\n            high = middle;\n    }\n    return low;\n}\n\nstatic int make_divisors(uint32_t maximum, uint16_t **divisors,\n                         size_t *numDivisors)\n{\n    uint32_t limit = integer_root(maximum);\n    size_t slots = (size_t)(limit / 2u) + 1u;\n    unsigned char *composite = calloc(slots, sizeof(*composite));\n    uint16_t *table = malloc(slots * sizeof(*table));\n    size_t count = 0;\n\n    if (composite == NULL || table == NULL) {\n        free(composite);\n        free(table);\n        return 0;\n    }\n\n    /* Only odd numbers occupy the sieve and the divisor table. */\n    for (uint32_t p = 3u; (uint64_t)p * p <= limit; p += 2u) {\n        if (!composite[p / 2u]) {\n            for (uint32_t multiple = p * p; multiple <= limit;\n                 multiple += 2u * p)\n                composite[multiple / 2u] = 1;\n        }\n    }\n    for (uint32_t p = 3u; p <= limit; p += 2u) {\n        if (!composite[p / 2u])\n            table[count++] = (uint16_t)p;\n    }\n\n    free(composite);\n    *divisors = table;\n    *numDivisors = count;\n    return 1;\n}\n\nstatic int isprime(uint32_t value, const uint16_t *divisors,\n                   size_t numDivisors)\n{\n    if (value < 2u)\n        return 0;\n    if ((value & 1u) == 0u)\n        return value == 2u;\n\n    for (size_t i = 0; i < numDivisors; ++i) {\n        uint32_t factor = divisors[i];\n        if ((uint64_t)factor * factor > value)\n            break;\n        if (value % factor == 0u)\n            return 0;\n    }\n    return 1;\n}\n\nvoid quicksort(long int *primes,int first,int last)\n{ int i, j, pivot;\n  long int temp;\n\n  if (first<last)\n     { pivot=first;\n       i=first;\n       j=last;\n       while(i<j)\n         { while (primes[i]<=primes[pivot]&&i<last)\n             i++;\n           while(primes[j]>primes[pivot])\n             j--;\n           if (i<j)\n              { temp=primes[i];\n                primes[i]=primes[j];\n                primes[j]=temp;\n              }\n         }\n       temp=primes[pivot];\n       primes[pivot]=primes[j];\n       primes[j]=temp;\n       quicksort(primes,first,j-1);\n       quicksort(primes,j+1,last);\n     }\n}\n\nint main(void)\n{\n    FILE *primesFile = stdin;\n    char fragment[MAXSTR];\n    int i, j, numResults = 0;\n    uint32_t maxFirst = 0u;\n    uint32_t maximum = 0u;\n    uint16_t *divisors = NULL;\n    size_t numDivisors = 0;\n\n    if (fscanf(primesFile, \"%d\", &numPrimes) != 1)\n        return 0;\n    if (numPrimes < 1 || numPrimes > MAXNUM)\n        return 1;\n\n    for (i = 0; i < numPrimes; ++i) {\n        if (fscanf(primesFile, \"%49s\", fragment) != 1)\n            return 1;\n        firstHalf[i] = decode_fragment(fragment).value;\n        if (firstHalf[i] > maxFirst)\n            maxFirst = firstHalf[i];\n    }\n    for (i = 0; i < numPrimes; ++i) {\n        if (fscanf(primesFile, \"%49s\", fragment) != 1)\n            return 1;\n        secondHalf[i] = decode_fragment(fragment);\n    }\n    fclose(primesFile);\n\n    /* Every scale is positive, so the largest left value bounds each row. */\n    for (j = 0; j < numPrimes; ++j) {\n        uint32_t candidate = (uint32_t)((uint64_t)maxFirst *\n                             secondHalf[j].scale + secondHalf[j].value);\n        if (candidate > maximum)\n            maximum = candidate;\n    }\n    if (!make_divisors(maximum, &divisors, &numDivisors))\n        return 1;\n\n    for (i = 0; i < numPrimes; ++i) {\n        uint32_t left = firstHalf[i];\n        for (j = 0; j < numPrimes; ++j) {\n            uint32_t candidate = (uint32_t)((uint64_t)left *\n                                 secondHalf[j].scale + secondHalf[j].value);\n            if (isprime(candidate, divisors, numDivisors))\n                result[numResults++] = (long int)candidate;\n        }\n    }\n    free(divisors);\n\n    quicksort(result,0,numResults-1);\n    for (i = 0; i < numResults; ++i)\n        printf(\"%ld\\n\", result[i]);\n    return 0;\n}\n",
      "path": "src/model-view/primetest.c"
    },

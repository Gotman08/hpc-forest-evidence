{
  "src/quicksort.c": "/*\n  Quicksort\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <limits.h>\n#include <openssl/md5.h>\n\n#if defined(__aarch64__) && defined(__ARM_NEON) && defined(__GNUC__) && INT_MAX == 2147483647\n#include <arm_neon.h>\n#define PARTITION_NEON 1\n#else\n#define PARTITION_NEON 0\n#endif\n\n/*\n * Prototypes\n */\nvoid srandnum(int seed);\ndouble randnum(void);\nint *generate_case(int N);\ndouble drand(int xmin, int xmax);\nvoid swap(int *toorder, int i, int j);\nint partition(int *toorder, int lo, int hi);\nvoid _quicksort(int *toorder, int lo, int hi);\nvoid quicksort(int *toorder, int N);\nint is_sorted(int *toorder, int N);\n\n/*\n * A generic pRNG\n */\n#define MY_RAND_MAX 0x7FFFFFFF\n\n#define RANDNUM_W 521288629\n#define RANDNUM_Z 362436069\n\nunsigned int randum_w = RANDNUM_W;\nunsigned int randum_z = RANDNUM_Z;\n\nvoid srandnum(int seed)\n{\n    unsigned int w, z;\n    w = (seed * 104623) & 0xffffffff;\n    randum_w = (w) ? w : RANDNUM_W;\n    z = (seed * 48947) & 0xffffffff;\n    randum_z = (z) ? z : RANDNUM_Z;\n}\n\ndouble randnum(void)\n{\n    unsigned int u;\n    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);\n    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);\n    u = (randum_z << 16) + randum_w;\n    return (abs(u));\n}\n\n/*\n * Main function\n */\nint main(int argc, char *argv[])\n{\n    int N = 0;\n    int *our_list = NULL;\n\n    //The input provides the case size\n\tscanf(\"%d\", &N);\n    if (N <= 0) {\n\tprintf(\"Error: please, provide the case size.\\n\");\n\treturn 1;\n    }\n\n    //Generate the case\n    our_list = generate_case(N);\n    if (our_list == NULL) {\n\tprintf(\"Error: case instantiation failed.\\n\");\n\treturn 1;\n    }\n\n    //Do the thing\n    quicksort(our_list, N);\n\n    if (is_sorted(our_list, N) == 1) {\n\tprintf(\"Error, for some reason list is still unsorted.\\n\");\n\treturn 1;\n    }\n\n#ifdef COMPUTE_MD5_PROBLEM\n    //Compute MD5 Checksum for problem identification\n    MD5_CTX c;\n    unsigned char out[MD5_DIGEST_LENGTH];\n    MD5_Init(&c);\n    MD5_Update(&c, our_list, N * sizeof(int));\n    MD5_Final(out, &c);\n    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {\n\tprintf(\"%02x\", out[n]);\n    }\n#endif\n    printf(\"\\n\");\n\n    //Clean up\n    free(our_list);\n\n    return 0;\n}\n\n/*\n * Public API\n */\nvoid quicksort(int *toorder, int N)\n{\n    _quicksort(toorder, 0, N - 1);\n}\n\n/*\n * Internal recursive function to quicksort\n */\nvoid _quicksort(int *toorder, int lo, int hi)\n{\n    if (lo >= hi)\n\treturn;\n    int b = partition(toorder, lo, hi);\n    _quicksort(toorder, lo, b - 1);\n    _quicksort(toorder, b + 1, hi);\n}\n\n/*\n * Swap two values.\n */\nvoid swap(int *toorder, int i, int j)\n{\n    int temp = toorder[i];\n    toorder[i] = toorder[j];\n    toorder[j] = temp;\n}\n\n#if PARTITION_NEON\n/* Read-only classification of sixteen independent signed comparisons. */\nstatic inline unsigned int partition_less_mask(const int *values,\n                                               int32x4_t vpivot,\n                                               uint8x8_t weights)\n{\n    const uint32x4_t c0 = vcltq_s32(vld1q_s32(values), vpivot);\n    const uint32x4_t c1 = vcltq_s32(vld1q_s32(values + 4), vpivot);\n    const uint32x4_t c2 = vcltq_s32(vld1q_s32(values + 8), vpivot);\n    const uint32x4_t c3 = vcltq_s32(vld1q_s32(values + 12), vpivot);\n    const uint8x8_t low = vmovn_u16(vcombine_u16(vmovn_u32(c0), vmovn_u32(c1)));\n    const uint8x8_t high = vmovn_u16(vcombine_u16(vmovn_u32(c2), vmovn_u32(c3)));\n    unsigned int mask = (unsigned int)vaddv_u8(vand_u8(low, weights));\n    mask |= (unsigned int)vaddv_u8(vand_u8(high, weights)) << 8;\n    return mask;\n}\n#endif\n\n/*\n * Partition decision\n */\nint partition(int *toorder, int lo, int hi)\n{\n    int b = lo;\n    int r = (int) (lo + (hi - lo) * (randnum() / MY_RAND_MAX));\n    int pivot = toorder[r];\n    swap(toorder, r, hi);\n    int i = lo;\n\n#if PARTITION_NEON\n    if (hi - i >= 16) {\n        const int32x4_t vpivot = vdupq_n_s32(pivot);\n        const uint8_t bit_weights[8] = {1, 2, 4, 8, 16, 32, 64, 128};\n        const uint8x8_t weights = vld1_u8(bit_weights);\n\n        if (hi - i >= 32) {\n            int left = lo;\n            int right = hi;\n            unsigned int left_mask = 0;\n            unsigned int right_mask = 0;\n\n            /*\n             * The unresolved interval is [left, right), excluding the pivot.\n             * These two sixteen-element blocks are always disjoint. Masks\n             * identify >= pivot on the left and < pivot on the right.\n             */\n            do {\n                if (left_mask == 0) {\n                    left_mask = partition_less_mask(toorder + left,\n                                                    vpivot, weights) ^ 0xffffU;\n                }\n                if (right_mask == 0) {\n                    right_mask = partition_less_mask(toorder + right - 16,\n                                                     vpivot, weights);\n                }\n\n                /*\n                 * Each exchange corrects both selected positions. Removing\n                 * their bits leaves every remaining classification valid.\n                 * A partially processed block stays in place with its mask.\n                 */\n                while (left_mask != 0 && right_mask != 0) {\n                    int li = left + __builtin_ctz(left_mask);\n                    int ri = right - 16 + __builtin_ctz(right_mask);\n                    swap(toorder, li, ri);\n                    left_mask &= left_mask - 1U;\n                    right_mask &= right_mask - 1U;\n                }\n                if (left_mask == 0) {\n                    left += 16;\n                }\n                if (right_mask == 0) {\n                    right -= 16;\n                }\n            } while (right - left >= 32);\n\n            /* Finish the bounded remainder, including any retained block. */\n            while (left < right) {\n                while (left < right && toorder[left] < pivot) {\n                    left++;\n                }\n                while (left < right && toorder[right - 1] >= pivot) {\n                    right--;\n                }\n                if (left < right) {\n                    swap(toorder, left, right - 1);\n                    left++;\n                    right--;\n                }\n            }\n            swap(toorder, hi, left);\n            return left;\n        }\n\n        do {\n            /* Classify the entire block before performing any swaps. */\n            unsigned int mask = partition_less_mask(toorder + i,\n                                                    vpivot, weights);\n\n            /*\n             * Ascending indices preserve Lomuto's swap order. Since b <= j,\n             * a swap cannot modify a later, already-classified element.\n             * These dependent swaps deliberately remain scalar.\n             */\n            while (mask != 0) {\n                int j = i + __builtin_ctz(mask);\n                swap(toorder, j, b);\n                b++;\n                mask &= mask - 1U;\n            }\n            i += 16;\n        } while (hi - i >= 16);\n    }\n#endif\n\n    for (; i < hi; i++) {\n\tif (toorder[i] < pivot) {\n\t    swap(toorder, i, b);\n\t    b++;\n\t}\n    }\n    swap(toorder, hi, b);\n    return b;\n}\n\n/*\n * Check if elements are in non-decreasing order\n */\nint is_sorted(int *toorder, int N)\n{\n    for (int i = 1; i < N; i++) {\n\tif (toorder[i] < toorder[i - 1]) {\n\t    return 1;\n\t}\n    }\n    return 0;\n}\n\n\n/*\n * Generate a case\n */\nint *generate_case(int N)\n{\n    int i;\n    int *ret = NULL;\n\n    // Make case generation reproducible\n    srandnum(0);\n\n    // Allocate memory\n    ret = (int *) malloc(N * sizeof(int));\n    if (ret == NULL) {\n\tprintf(\"Error: some malloc won't work.\\n\");\n\treturn NULL;\n    }\n    // Get pseudo-random positive integer values\n    for (i = 0; i < N; i++) {\n\tret[i] = drand(0, INT_MAX);\n    }\n    return ret;\n}\n\n/*\n * A pseudo-random number between two positive integer values\n */\ndouble drand(int xmin, int xmax)\n{\n    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;\n}\n"
}

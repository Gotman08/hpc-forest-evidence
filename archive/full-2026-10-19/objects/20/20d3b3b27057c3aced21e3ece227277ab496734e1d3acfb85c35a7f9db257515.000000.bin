"""Write a new external MAX projection; never import, alter or run frozen R4 code."""
from __future__ import annotations

import hashlib
import json
import uuid
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
R4 = HERE.parent / "HPC-Forest-Mere-Dynamique-r4"
PROJECTION_ID = "hpc-forest-dynamic-max-projection-r1"
FROZEN = {
    "HPC-Forest-Mere-Dynamique-r4.zip": "2512ae10bb7ad920a5ba7d6bf5ffd76ffb57e94cb23875715249a4437a8ca6ff",
    "hpc-forest-dynamic-roots-r4-light.tar.gz": "557fb364e1beee593592ff0318b5e162828f8f44a286bc244c030b75d0eceeb5",
    "dynamic-plan.json": "e2b043f040945e561c1fcf4e01dfd39d1b427fcc572994b6b1105a6683965e6b",
    "livraison-verifiee.json": "a0d498fb334d0262bd5ed08ba829b59fb693a9bee8bcd33b62e2e83a198dba90",
    "validation-prevol.json": "e809811b33300c28b28ca5ef3bcc67547a524365b319b1b42c8a948ed5637b5b",
    "diff-empreintes.json": "c2b4b2d40304be7e17851cc228638525c58ad1898f249d9a98c518c475d0861f",
    "reception-prevol-748158/target-profile-preflight.json": "33b4966b6323cb60a62435a58be935cd55b3175cbb66386f4a117d60cdc3a5d9",
    "reception-prevol-748158/prepared/prepared-manifest.json": "5c25b2c468469bfdfe829e67995659498c61393bdebcf4018fcc1083d27bb4ec",
}


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def save(name, value):
    with (HERE / name).open("x", encoding="utf8", newline="\n") as stream:
        json.dump(value, stream, ensure_ascii=True, indent=2)
        stream.write("\n")


def main():
    actual = {name: sha(R4 / name) for name in FROZEN}
    if actual != FROZEN:
        raise RuntimeError("Frozen R4 artifact differs; no projection written")
    pilot = []
    for index, model in enumerate(("gpt-6-luna", "gpt-6.1-sol"), 1):
        session = uuid.uuid4().hex
        pilot.append({"order": index, "model": model, "effort": "max", "mother_model": model,
                      "mother_effort": "max", "subject": "2023-count", "session_id_reserved_not_started": session,
                      "remote_root_proposed": "/scratch_p/nimarano/" + PROJECTION_ID + "-" + session,
                      "state": "projected_not_native_admitted", "native_model_calls": 0,
                      "requires_previous_pilot_received_audited_reconciled": index > 1})
    projection = {"schema": "hpc-forest-dynamic-max-external-projection-v1", "projection_id": PROJECTION_ID,
                  "created_utc": datetime.now(UTC).isoformat(), "status": "prepared_not_native_admitted",
                  "declaration": "mere dynamique R3 avec implementation corrigee R4",
                  "source_scope_id": "hpc-forest-dynamic-independent-roots-r4",
                  "source_revision": "R4", "requested_conceptual_revision": "R3",
                  "historical_r3_source_zip_sha256": "fac1ea16b9688d4ba12242413ea53801c1fc4d62bbdbef86e34abd17fa2dc4ca",
                  "frozen_artifacts": {name: {"path": str((R4 / name).resolve()), "sha256": value}
                                       for name, value in FROZEN.items()},
                  "efforts_allowed_by_this_projection": ["max"],
                  "historical_r4_efforts_unchanged": ["max", "xhigh", "high", "medium", "low"],
                  "historical_r4_plan_not_rewritten": True, "pilot_sequence": pilot,
                  "technical_contracts": {phase: {"status": "not_native_admitted", "verified": False}
                                          for phase in ("roots", "advice", "harvest")},
                  "future_other_max_models": ["gpt-6-astra", "gpt-5.6-terra"],
                  "future_extension_status": "conditional_after_two_pilot_receptions_and_explicit_new_admission",
                  "automatic_extension": False, "maximum_native_workers": 2,
                  "target": {"architecture": "ARM64", "nodes": 1, "tasks": 1, "cpu_cores": 4,
                             "memory_mib": 16384, "gpus": 0},
                  "limits": {"wall_seconds": 1800, "tokens_ceiling": 1500000, "child_program_missions": 8,
                             "harvest_program_missions": 2, "mother_calls_ceiling": 11,
                             "native_calls_theoretical_ceiling": 41, "registry_slots_ceiling": 22,
                             "generation_shared_seconds": 600, "confirmation_reserve_seconds": 120,
                             "search_repetitions": 3, "final_confirmations": 5, "minimum_gain_fraction": 0.03},
                  "accounting_limits_are_not_actual_consumption": True,
                  "exclusive_deadline_utc": "2026-10-31T23:00:00Z", "reception_audit_reserve_seconds": 10800,
                  "native_model_calls": 0, "native_research_admitted": False, "jobs_submitted": 0,
                  "hardware_or_process_isolation_proved": False, "old_candidates_imported": False,
                  "operator_algorithm_advice": False, "historical_preflight_only_not_native_admission": True}
    save("preservation-r4-avant.json", {"schema": "hpc-forest-dynamic-max-r4-preservation-v1",
                                       "utc": datetime.now(UTC).isoformat(), "files": actual})
    save("projection-max-externe.json", projection)
    for entry in pilot:
        session = entry["session_id_reserved_not_started"]
        root = entry["remote_root_proposed"]
        shared = root + "/shared"
        python = "/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python"
        request = {"schema": "hpc-forest-dynamic-max-launch-request-v1", "projection_id": PROJECTION_ID,
                   "source_scope_id": projection["source_scope_id"], "verified": False,
                   "status": "example_not_authorized", "pilot_order": entry["order"],
                   "model": entry["model"], "effort": "max", "session_id": session,
                   "subject": "2023-count", "job_id": None, "allocation_max_seconds": None,
                   "remote_root": root, "shared_root": shared, "python_executable": python,
                   "source_zip": projection["frozen_artifacts"]["HPC-Forest-Mere-Dynamique-r4.zip"],
                   "source_plan": projection["frozen_artifacts"]["dynamic-plan.json"],
                   "command_argv": [python, "-B", shared + "/project/examples/marathon22/dynamic_archive.py",
                                    "--root", root + "/research", "--shared", shared,
                                    "--model", entry["model"], "--effort", "max", "--session-id", session,
                                    "--subjects", "2023-count"],
                   "child_environment": {"PYTHONPATH": shared + "/project/src:" + shared + "/project/examples/marathon22",
                                         "PYTHONDONTWRITEBYTECODE": "1", "OPENBLAS_NUM_THREADS": "1",
                                         "OMP_NUM_THREADS": "4", "OMP_DYNAMIC": "FALSE", "CUDA_VISIBLE_DEVICES": ""},
                   "admissions": {role: None for role in ("integration_review", "source_deployment", "cli_identity",
                                  "transport", "target_allocation", "worker_lane", "contract_roots",
                                  "contract_advice", "contract_harvest", "previous_pilot")}}
        save("exemple-requete-" + ("luna" if entry["order"] == 1 else "sol") + "-non-autorisee.json", request)
    save("premier-demarrage-attendu-non-verifie.json",
         {"schema": "hpc-forest-dynamic-max-first-start-expectation-v1", "verified": False,
          "declaration": projection["declaration"], "source_scope_id": projection["source_scope_id"],
          "required": ["source/identity/MAX", "actual allocation/profile", "actual native transport",
                       "first normal call delivered", "first candidate evaluation", "errors and negatives preserved",
                       "all started calls reconciled before extension"],
          "synthetic_contracts_do_not_prove_first_normal_pilot_call": True,
          "first_start_received_before_extension": True, "native_model_calls": 0})
    print(json.dumps({"status": "prepared_not_native_admitted", "pilot_models": [row["model"] for row in pilot],
                      "projection_sha256": sha(HERE / "projection-max-externe.json"), "native_model_calls": 0}))


if __name__ == "__main__":
    main()

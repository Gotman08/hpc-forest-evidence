+
+
+def first_start_reception_valid(first, identity, plan):
+    pilot_model = plan.get("pilot_configuration", {}).get("model")
+    return (first.get("schema") == "hpc-forest-dynamic-r4b-first-start-reception-v1"
+            and first.get("verified") is True
+            and all(first.get(k) == v for k, v in identity.items())
+            and first.get("model") == pilot_model and first.get("effort") == "max"
+            and first.get("session_id") == plan["cells"][pilot_model]
+            and first.get("received_first_normal_delivery_and_real_evaluation") is True
+            and first.get("unresolved_invocations") == [] and first.get("technical_errors") == []
+            and first.get("global_admission_verified") is False)
+
+
+def contract_session_valid(session, model, phase, plan):
+    expected = plan.get("contract_cells", {}).get(model, {}).get(phase)
+    return isinstance(session, str) and bool(expected) and session == expected
 
 

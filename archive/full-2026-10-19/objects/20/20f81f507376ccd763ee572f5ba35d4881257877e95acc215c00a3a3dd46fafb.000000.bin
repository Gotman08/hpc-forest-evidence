      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdint.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nstatic void body_force_direct(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Earlier target panels accumulate source-ordered force prefixes for\n * later bodies. A bounded coefficient panel lets completed targets\n * consume their remaining sources in the original order.\n */\nvoid body_force(Body *p, float dt, int n) {\n  enum { TARGET_BLOCK = 16, SOURCE_BLOCK = 128 };\n\n  if (n <= TARGET_BLOCK) {\n    body_force_direct(p, dt, n);\n    return;\n  }\n\n  const size_t count = (size_t)n;\n  const size_t stride = (count + 15u) & ~(size_t)15u;\n  const size_t array_count = TARGET_BLOCK + 6u;\n  if (stride > (SIZE_MAX - 63u) / (array_count * sizeof(float))) {\n    body_force_direct(p, dt, n);\n    return;\n  }\n\n  void *storage = malloc(array_count * stride * sizeof(float) + 63u);\n  if (storage == NULL) {\n    body_force_direct(p, dt, n);\n    return;\n  }\n\n  float *restrict x = (float *)(((uintptr_t)storage + 63u) & ~(uintptr_t)63u);\n  float *restrict y = x + stride;\n  float *restrict z = y + stride;\n  float *restrict force_x = z + stride;\n  float *restrict force_y = force_x + stride;\n  float *restrict force_z = force_y + stride;\n  float *restrict coefficients = force_z + stride;\n\n  for (size_t i = 0; i < count; ++i) {\n    if (!isfinite(p[i].x) || !isfinite(p[i].y) || !isfinite(p[i].z)) {\n      free(storage);\n      body_force_direct(p, dt, n);\n      return;\n    }\n    x[i] = p[i].x;\n    y[i] = p[i].y;\n    z[i] = p[i].z;\n    force_x[i] = 0.0f;\n    force_y[i] = 0.0f;\n    force_z[i] = 0.0f;\n  }\n\n#ifdef _OPENMP\n#pragma omp parallel\n#endif\n  {\n    for (size_t ib = 0; ib < count; ib += TARGET_BLOCK) {\n      const size_t iend = count - ib < TARGET_BLOCK ? count : ib + TARGET_BLOCK;\n\n      /* Each source tile exclusively owns its force-prefix entries. */\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n      for (size_t jb = iend; jb < count; jb += SOURCE_BLOCK) {\n        const size_t jend = count - jb < SOURCE_BLOCK ? count : jb + SOURCE_BLOCK;\n        for (size_t i = ib; i < iend; ++i) {\n          const float xi = x[i];\n          const float yi = y[i];\n          const float zi = z[i];\n          float *restrict row = coefficients + (i - ib) * stride;\n#ifdef _OPENMP\n#pragma omp simd aligned(x, y, z, force_x, force_y, force_z, row:64)\n#endif\n          for (size_t j = jb; j < jend; ++j) {\n            float dx = x[j] - xi;\n            float dy = y[j] - yi;\n            float dz = z[j] - zi;\n            float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n            float inv_dist = 1 / sqrt(sqrd_dist);\n            float inv_dist3 = inv_dist * inv_dist * inv_dist;\n            row[j] = inv_dist3;\n\n            /* Recompute reverse differences to retain signed zeros. */\n            float reverse_dx = xi - x[j];\n            float reverse_dy = yi - y[j];\n            float reverse_dz = zi - z[j];\n            force_x[j] += reverse_dx * inv_dist3;\n            force_y[j] += reverse_dy * inv_dist3;\n            force_z[j] += reverse_dz * inv_dist3;\n          }\n        }\n      }\n\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n      for (size_t i = ib; i < iend; ++i) {\n        const float xi = x[i];\n        const float yi = y[i];\n        const float zi = z[i];\n        float fx = force_x[i];\n        float fy = force_y[i];\n        float fz = force_z[i];\n        const float *row = coefficients + (i - ib) * stride;\n\n        /* Internal panel interactions remain in increasing source order. */\n        for (size_t j = ib; j < iend; ++j) {\n          float dx = x[j] - xi;\n          float dy = y[j] - yi;\n          float dz = z[j] - zi;\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          float inv_dist = 1 / sqrt(sqrd_dist);\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n        }\n\n        /* Store coefficients, not rounded force products, in the panel. */\n        for (size_t j = iend; j < count; ++j) {\n          float dx = x[j] - xi;\n          float dy = y[j] - yi;\n          float dz = z[j] - zi;\n          float inv_dist3 = row[j];\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n        }\n\n        p[i].vx += dt*fx;\n        p[i].vy += dt*fy;\n        p[i].vz += dt*fz;\n      }\n    }\n  }\n\n  free(storage);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n  \n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "A cache-blocked triangular traversal can reuse symmetric distance coefficients while compact SoA storage and bounded panel buffering preserve source-ordered accumulation.",

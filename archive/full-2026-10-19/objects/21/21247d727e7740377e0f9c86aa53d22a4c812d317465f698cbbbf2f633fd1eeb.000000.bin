    {
      "id": "7ab3b32434ba4b0b",
      "role": "C",
      "mission": {
        "base_commit": "ee3279266a3adaf9cc941a022cc0c4309196f7ae",
        "delegation_parent": "R/C",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Statically sharing contiguous point ranges across at most four threads, using private stable top-k heaps and one deterministic merge, should reduce selection time without per-point synchronization.",
        "id": "7ab3b32434ba4b0b",
        "ordinal": 1,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/knn.c"
          ],
          "retained": [
            "Use balanced contiguous ranges with static OpenMP scheduling, at most four threads, and workload-based serial fallback.",
            "Maintain thread-private max-heaps ordered by distance and global encounter index, then merge their candidates.",
            "Retain original insertion for unordered distances or unavailable heap storage; retain all labels and placeholders when k>=N.",
            "Free per-call selection scratch without changing parsing or voting."
          ]
        },

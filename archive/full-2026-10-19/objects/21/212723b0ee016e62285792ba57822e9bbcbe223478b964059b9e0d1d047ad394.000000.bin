      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nenum {\n    RADIX = 256,\n    CACHE_ALIGNMENT = 128\n};\n\n#define PARALLEL_RADIX_MINIMUM ((size_t)32768)\n\ntypedef struct {\n    void *allocation;\n    size_t *values;\n} count_table;\n\nstatic void *xmalloc(size_t bytes)\n{\n    void *result = malloc(bytes);\n\n    if (result == NULL && bytes != 0)\n        exit(EXIT_FAILURE);\n    return result;\n}\n\nstatic void *xmalloc_array(size_t count, size_t element_size)\n{\n    if (element_size != 0 && count > SIZE_MAX / element_size)\n        exit(EXIT_FAILURE);\n    return xmalloc(count * element_size);\n}\n\nstatic void *xcalloc_array(size_t count, size_t element_size)\n{\n    void *result;\n\n    if (element_size != 0 && count > SIZE_MAX / element_size)\n        exit(EXIT_FAILURE);\n    result = calloc(count, element_size);\n    if (result == NULL && count != 0 && element_size != 0)\n        exit(EXIT_FAILURE);\n    return result;\n}\n\nstatic count_table allocate_count_table(size_t entries)\n{\n    const size_t padding_bytes = (size_t)(CACHE_ALIGNMENT - 1);\n    const uintptr_t mask = (uintptr_t)CACHE_ALIGNMENT - 1u;\n    count_table table;\n    size_t bytes;\n\n    if (entries > (SIZE_MAX - padding_bytes) / sizeof(size_t))\n        exit(EXIT_FAILURE);\n\n    bytes = entries * sizeof(size_t);\n    table.allocation = xmalloc(bytes + padding_bytes);\n    table.values = (size_t *)((unsigned char *)table.allocation +\n                              (size_t)((-(uintptr_t)table.allocation) & mask));\n    return table;\n}\n\nstatic size_t sort_worker_limit(void)\n{\n#ifdef _OPENMP\n    const int workers = omp_get_max_threads();\n    return workers > 0 ? (size_t)workers : 1;\n#else\n    return 1;\n#endif\n}\n\nstatic size_t sort_worker_id(void)\n{\n#ifdef _OPENMP\n    return (size_t)omp_get_thread_num();\n#else\n    return 0;\n#endif\n}\n\nstatic size_t sort_worker_count(void)\n{\n#ifdef _OPENMP\n    return (size_t)omp_get_num_threads();\n#else\n    return 1;\n#endif\n}\n\nstatic size_t partition_start(size_t count, size_t worker, size_t workers)\n{\n    const size_t base = count / workers;\n    const size_t remainder = count % workers;\n\n    return worker * base + (worker < remainder ? worker : remainder);\n}\n\nstatic void radix_pass_serial(const char *strings, size_t record_width,\n                              size_t count, size_t byte_position,\n                              const long int *source, long int *destination)\n{\n    size_t histogram[RADIX];\n    size_t positions[RADIX];\n    size_t output = 0;\n\n    memset(histogram, 0, sizeof(histogram));\n\n    for (size_t i = 0; i < count; ++i) {\n        const unsigned char value =\n            (unsigned char)strings[(size_t)source[i] * record_width + byte_position];\n        ++histogram[value];\n    }\n\n    for (size_t value = 0; value < RADIX; ++value) {\n        positions[value] = output;\n        output += histogram[value];\n    }\n\n    for (size_t i = 0; i < count; ++i) {\n        const unsigned char value =\n            (unsigned char)strings[(size_t)source[i] * record_width + byte_position];\n        destination[positions[value]++] = source[i];\n    }\n}\n\nstatic void radix_pass_parallel(const char *strings, size_t record_width,\n                                size_t count, size_t byte_position,\n                                const long int *source, long int *destination,\n                                size_t *histogram, size_t *positions)\n{\n#ifdef _OPENMP\n#pragma omp parallel\n#endif\n    {\n        const size_t thread_id = sort_worker_id();\n        const size_t active_workers = sort_worker_count();\n        const size_t begin = partition_start(count, thread_id, active_workers);\n        const size_t end = partition_start(count, thread_id + 1, active_workers);\n        size_t *local_histogram = histogram + thread_id * RADIX;\n\n        for (size_t i = begin; i < end; ++i) {\n            const unsigned char value =\n                (unsigned char)strings[(size_t)source[i] * record_width + byte_position];\n            ++local_histogram[value];\n        }\n\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n        {\n            size_t output = 0;\n\n            for (size_t value = 0; value < RADIX; ++value) {\n                for (size_t worker = 0; worker < active_workers; ++worker) {\n                    const size_t slot = worker * RADIX + value;\n                    positions[slot] = output;\n                    output += histogram[slot];\n                }\n            }\n        }\n\n        {\n            size_t *next = positions + thread_id * RADIX;\n\n            for (size_t i = begin; i < end; ++i) {\n                const unsigned char value =\n                    (unsigned char)strings[(size_t)source[i] * record_width + byte_position];\n                destination[next[value]++] = source[i];\n            }\n        }\n    }\n}\n\nstatic long int *radix_sort(const char *strings, int length, long int size)\n{\n    long int *source;\n    long int *destination;\n    count_table histogram_table;\n    count_table position_table;\n    size_t table_items = 0;\n    size_t count;\n    size_t worker_count;\n    int use_parallel;\n\n    if (size <= 0)\n        return NULL;\n\n    count = (size_t)size;\n    source = xmalloc_array(count, sizeof(*source));\n    destination = xmalloc_array(count, sizeof(*destination));\n    worker_count = sort_worker_limit();\n    use_parallel = worker_count > 1 && count >= PARALLEL_RADIX_MINIMUM;\n\n    histogram_table.allocation = NULL;\n    histogram_table.values = NULL;\n    position_table.allocation = NULL;\n    position_table.values = NULL;\n\n    if (use_parallel) {\n        if (worker_count > SIZE_MAX / RADIX)\n            exit(EXIT_FAILURE);\n        table_items = worker_count * RADIX;\n        histogram_table = allocate_count_table(table_items);\n        position_table = allocate_count_table(table_items);\n    }\n\n    if (use_parallel) {\n#ifdef _OPENMP\n#pragma omp parallel for simd schedule(static)\n#endif\n        for (size_t i = 0; i < count; ++i)\n            source[i] = (long int)i;\n    } else {\n#ifdef _OPENMP\n#pragma omp simd\n#endif\n        for (size_t i = 0; i < count; ++i)\n            source[i] = (long int)i;\n    }\n\n    if (length > 1) {\n        const size_t record_width = (size_t)length;\n\n        for (size_t position = record_width - 1; position > 0; --position) {\n            const size_t byte_position = position - 1;\n            long int *temporary;\n\n            if (use_parallel) {\n                memset(histogram_table.values, 0,\n                       table_items * sizeof(*histogram_table.values));\n                radix_pass_parallel(strings, record_width, count, byte_position,\n                                    source, destination, histogram_table.values,\n                                    position_table.values);\n            } else {\n                radix_pass_serial(strings, record_width, count, byte_position,\n                                  source, destination);\n            }\n\n            temporary = source;\n            source = destination;\n            destination = temporary;\n        }\n    }\n\n    free(histogram_table.allocation);\n    free(position_table.allocation);\n    free(destination);\n    return source;\n}\n\nlong int *bucket_sort(char *a, int length, long int size, int offset, int nbuckets)\n{\n    (void)offset;\n    (void)nbuckets;\n    return radix_sort(a, length, size);\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb)\n{\n    char *strings;\n    int len;\n    int offset;\n    int nbucket;\n    long int n;\n\n    if (fscanf(stdin, \"%d\", &len) != 1) {\n        printf(\"ERROR len\\n\");\n        exit(EXIT_FAILURE);\n    }\n    if (fscanf(stdin, \"%ld\", &n) != 1) {\n        printf(\"ERROR n\\n\");\n        exit(EXIT_FAILURE);\n    }\n    if (fscanf(stdin, \"%d\", &offset) != 1) {\n        printf(\"ERROR offset\\n\");\n        exit(EXIT_FAILURE);\n    }\n    if (fscanf(stdin, \"%d\", &nbucket) != 1) {\n        printf(\"ERROR nbucket\\n\");\n        exit(EXIT_FAILURE);\n    }\n    if (len <= 0 || n < 0) {\n        printf(\"ERROR size\\n\");\n        exit(EXIT_FAILURE);\n    }\n\n    ++len;\n    ++nbucket;\n    strings = xcalloc_array((size_t)n, (size_t)len);\n\n    for (long int i = 0; i < n; ++i) {\n        if (fscanf(stdin, \"%s\", strings + (size_t)i * (size_t)len) != 1) {\n            printf(\"ERROR %ld\\n\", i);\n            exit(EXIT_FAILURE);\n        }\n    }\n\n    *vString = strings;\n    *N = n;\n    *l = len;\n    *os = offset;\n    *nb = nbucket;\n}\n\nvoid save(const char *strings, const long int *index, long int n, int len)\n{\n    for (long int i = 0; i < n; ++i)\n        puts(strings + (size_t)index[i] * (size_t)len);\n}\n\nint main(void)\n{\n    char *strings = NULL;\n    long int N = 0;\n    long int *index = NULL;\n    int len = 0;\n    int offset = 0;\n    int nbuckets = 0;\n\n    load(&strings, &N, &len, &offset, &nbuckets);\n    index = bucket_sort(strings, len, N, offset, nbuckets);\n    save(strings, index, N, len);\n\n    free(strings);\n    free(index);\n    return EXIT_SUCCESS;\n}\n",
      "path": "src/bucketsort.c"
    }

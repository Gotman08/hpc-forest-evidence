      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <assert.h>\n#include <string.h>\n\nstatic void *allocate_array(size_t count, size_t width) {\n    if (width != 0 && count > (size_t)-1 / width)\n        exit(EXIT_FAILURE);\n\n    void *memory = malloc(count * width);\n    if (memory == NULL && count != 0)\n        exit(EXIT_FAILURE);\n    return memory;\n}\n\nlong int *bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\n    (void)offset;\n    (void)nbuckets;\n\n    if (size <= 0)\n        return NULL;\n\n    const size_t n = (size_t)size;\n    const size_t stride = (size_t)length;\n    const unsigned char *bytes = (const unsigned char *)a;\n    long int *current = allocate_array(n, sizeof(*current));\n\n    if (n == 1) {\n        current[0] = 0;\n        return current;\n    }\n\n    size_t *token_lengths = allocate_array(n, sizeof(*token_lengths));\n    size_t max_length = 0;\n    for (size_t i = 0; i < n; ++i) {\n        current[i] = (long int)i;\n        token_lengths[i] = strlen(a + i * stride);\n        if (token_lengths[i] > max_length)\n            max_length = token_lengths[i];\n    }\n\n    if (max_length == 0) {\n        free(token_lengths);\n        return current;\n    }\n\n    long int *next = allocate_array(n, sizeof(*next));\n    unsigned char *digits = allocate_array(n, sizeof(*digits));\n\n    for (size_t position = max_length; position != 0;) {\n        --position;\n        size_t counts[256] = {0};\n\n        /* Gather a compact key column in physical record order. */\n        for (size_t i = 0; i < n; ++i) {\n            unsigned char digit = 0;\n            if (position < token_lengths[i])\n                digit = bytes[i * stride + position];\n            digits[i] = digit;\n            ++counts[digit];\n        }\n\n        if (counts[digits[0]] == n)\n            continue;\n\n        size_t start = 0;\n        for (size_t digit = 0; digit < 256; ++digit) {\n            size_t count = counts[digit];\n            counts[digit] = start;\n            start += count;\n        }\n\n        /* Stable index scatter uses only the dense byte-key column. */\n        for (size_t i = 0; i < n; ++i) {\n            long int index = current[i];\n            next[counts[digits[(size_t)index]]++] = index;\n        }\n\n        long int *temporary = current;\n        current = next;\n        next = temporary;\n    }\n\n    free(next);\n    free(digits);\n    free(token_lengths);\n    return current;\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb) {\n    char *strings = NULL;\n    int len, offset, nbucket;\n    long int n;\n\n    if (!fscanf(stdin, \"%d\", &len)) {\n        printf(\"ERROR len\\n\");\n        exit(1);\n    }\n\n    if (!fscanf(stdin, \"%ld\", &n)) {\n        printf(\"ERROR n\\n\");\n        exit(1);\n    }\n\n    if (!fscanf(stdin, \"%d\", &offset)) {\n        printf(\"ERROR offset\\n\");\n        exit(1);\n    }\n\n    if (!fscanf(stdin, \"%d\", &nbucket)) {\n        printf(\"ERROR nbucket\\n\");\n        exit(1);\n    }\n\n    nbucket = nbucket + 1;\n    len = len + 1;\n    strings = allocate_array((size_t)n, (size_t)len);\n\n    for (long int i = 0; i < n; ++i) {\n        if (!fscanf(stdin, \"%s\", strings + (size_t)i * (size_t)len)) {\n            printf(\"ERROR %ld\\n\", i);\n            exit(1);\n        }\n    }\n\n    *vString = strings;\n    *N = n;\n    *l = len;\n    *os = offset;\n    *nb = nbucket;\n}\n\nvoid print(char *strings, long int *index, long int n, int len) {\n    for (long int i = 0; i < n; ++i)\n        printf(\"%ld -> %s\\n\", i, strings + (size_t)index[i] * (size_t)len);\n}\n\nvoid save(char *strings, long int *index, long int n, int len) {\n    for (long int i = 0; i < n; ++i)\n        printf(\"%s\\n\", strings + (size_t)index[i] * (size_t)len);\n}\n\nint main(int ac, char **av) {\n    char *strings = NULL;\n    long int N = 0;\n    long int *index = NULL;\n    int len = 0, offset, nbuckets;\n\n    load(&strings, &N, &len, &offset, &nbuckets);\n    index = bucket_sort(strings, len, N, offset, nbuckets);\n    save(strings, index, N, len);\n\n    if (strings != NULL)\n        free(strings);\n    if (index != NULL)\n        free(index);\n\n    return EXIT_SUCCESS;\n}\n",
      "path": "src/bucketsort.c"
    }
  ],
  "hypothesis": "Gathering compact radix-key columns in physical record order should improve locality while replacing quadratic insertion sorting with linear stable counting passes.",

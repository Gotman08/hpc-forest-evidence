/*
  Quicksort
*/
#include <stdio.h>
#include <stdlib.h>
#include <limits.h>
#include <openssl/md5.h>

#if defined(_OPENMP) && (UINT_MAX == 0xffffffffU)
#include <omp.h>

#define RADIX_BITS 8U
#define RADIX_BUCKETS (1U << RADIX_BITS)
#define RADIX_MASK (RADIX_BUCKETS - 1U)
#define RADIX_SIGN_BIT 0x80000000U
#define RADIX_PARALLEL_CUTOFF 32768

static int radix_sort_parallel(int *values, int count);
#endif

/*
 * Prototypes
 */
void srandnum(int seed);
double randnum(void);
int *generate_case(int N);
double drand(int xmin, int xmax);
void swap(int *toorder, int i, int j);
int partition(int *toorder, int lo, int hi);
void _quicksort(int *toorder, int lo, int hi);
void quicksort(int *toorder, int N);
int is_sorted(int *toorder, int N);

/*
 * A generic pRNG
 */
#define MY_RAND_MAX 0x7FFFFFFF

#define RANDNUM_W 521288629
#define RANDNUM_Z 362436069

unsigned int randum_w = RANDNUM_W;
unsigned int randum_z = RANDNUM_Z;

void srandnum(int seed)
{
    unsigned int w, z;
    w = (seed * 104623) & 0xffffffff;
    randum_w = (w) ? w : RANDNUM_W;
    z = (seed * 48947) & 0xffffffff;
    randum_z = (z) ? z : RANDNUM_Z;
}

double randnum(void)
{
    unsigned int u;
    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);
    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);
    u = (randum_z << 16) + randum_w;
    return (abs(u));
}

/*
 * Main function
 */
int main(int argc, char *argv[])
{
    int N = 0;
    int *our_list = NULL;

    //The input provides the case size
    scanf("%d", &N);
    if (N <= 0) {
        printf("Error: please, provide the case size.\n");
        return 1;
    }

    //Generate the case
    our_list = generate_case(N);
    if (our_list == NULL) {
        printf("Error: case instantiation failed.\n");
        return 1;
    }

    //Do the thing
    quicksort(our_list, N);

    if (is_sorted(our_list, N) == 1) {
        printf("Error, for some reason list is still unsorted.\n");
        return 1;
    }

#ifdef COMPUTE_MD5_PROBLEM
    //Compute MD5 Checksum for problem identification
    MD5_CTX c;
    unsigned char out[MD5_DIGEST_LENGTH];
    MD5_Init(&c);
    MD5_Update(&c, our_list, N * sizeof(int));
    MD5_Final(out, &c);
    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {
        printf("%02x", out[n]);
    }
#endif
    printf("\n");

    //Clean up
    free(our_list);

    return 0;
}

/*
 * Public API
 */
void quicksort(int *toorder, int N)
{
#if defined(_OPENMP) && (UINT_MAX == 0xffffffffU)
    if (N >= RADIX_PARALLEL_CUTOFF && radix_sort_parallel(toorder, N)) {
        return;
    }
#endif
    _quicksort(toorder, 0, N - 1);
}

#if defined(_OPENMP) && (UINT_MAX == 0xffffffffU)
/*
 * Four stable byte-radix passes leave the final result in values.  Each
 * worker owns a contiguous input range and one histogram row.  Prefixing
 * rows by worker order gives every scatter a disjoint output interval.
 */
static int radix_sort_parallel(int *values, int count)
{
    int maximum_threads = omp_get_max_threads();
    int *scratch;
    unsigned int *histogram;
    size_t histogram_entries;
    int *source = values;
    int *destination;

    if (maximum_threads < 2) {
        return 0;
    }
    if ((size_t)count > (size_t)-1 / sizeof *scratch) {
        return 0;
    }
    if ((size_t)maximum_threads > (size_t)-1 / (size_t)RADIX_BUCKETS) {
        return 0;
    }

    histogram_entries = (size_t)maximum_threads * (size_t)RADIX_BUCKETS;
    if (histogram_entries > (size_t)-1 / sizeof *histogram) {
        return 0;
    }

    scratch = (int *)malloc((size_t)count * sizeof *scratch);
    if (scratch == NULL) {
        return 0;
    }

    histogram = (unsigned int *)malloc(histogram_entries * sizeof *histogram);
    if (histogram == NULL) {
        free(scratch);
        return 0;
    }
    destination = scratch;

#pragma omp parallel shared(source, destination, histogram, count)
    {
        const int thread_id = omp_get_thread_num();
        const int thread_count = omp_get_num_threads();
        const size_t begin = ((size_t)count * (size_t)thread_id) /
                             (size_t)thread_count;
        const size_t end = ((size_t)count * (size_t)(thread_id + 1)) /
                           (size_t)thread_count;

        for (unsigned int shift = 0; shift < 32U; shift += RADIX_BITS) {
            unsigned int *local_histogram =
                histogram + (size_t)thread_id * (size_t)RADIX_BUCKETS;

#if _OPENMP >= 201307
#pragma omp simd
#endif
            for (unsigned int bucket = 0; bucket < RADIX_BUCKETS; ++bucket) {
                local_histogram[bucket] = 0;
            }

            for (size_t index = begin; index < end; ++index) {
                const unsigned int key =
                    ((unsigned int)source[index]) ^ RADIX_SIGN_BIT;
                ++local_histogram[(key >> shift) & RADIX_MASK];
            }

#pragma omp barrier
#pragma omp single
            {
                unsigned int position = 0;
                for (unsigned int bucket = 0; bucket < RADIX_BUCKETS; ++bucket) {
                    for (int worker = 0; worker < thread_count; ++worker) {
                        unsigned int *slot =
                            histogram + (size_t)worker * (size_t)RADIX_BUCKETS + bucket;
                        const unsigned int bucket_count = *slot;
                        *slot = position;
                        position += bucket_count;
                    }
                }
            }

            for (size_t index = begin; index < end; ++index) {
                const unsigned int key =
                    ((unsigned int)source[index]) ^ RADIX_SIGN_BIT;
                const unsigned int bucket = (key >> shift) & RADIX_MASK;
                destination[local_histogram[bucket]++] = source[index];
            }

#pragma omp barrier
#pragma omp single
            {
                int *temporary = source;
                source = destination;
                destination = temporary;
            }
        }
    }

    free(histogram);
    free(scratch);
    return 1;
}
#endif

/*
 * Internal recursive function to quicksort
 */
void _quicksort(int *toorder, int lo, int hi)
{
    if (lo >= hi)
        return;
    int b = partition(toorder, lo, hi);
    _quicksort(toorder, lo, b - 1);
    _quicksort(toorder, b + 1, hi);
}

/*
 * Swap two values.
 */
void swap(int *toorder, int i, int j)
{
    int temp = toorder[i];
    toorder[i] = toorder[j];
    toorder[j] = temp;
}

/*
 * Partition decision
 */
int partition(int *toorder, int lo, int hi)
{
    int b = lo;
    int r = (int) (lo + (hi - lo) * (randnum() / MY_RAND_MAX));
    int pivot = toorder[r];
    swap(toorder, r, hi);
    for (int i = lo; i < hi; i++) {
        if (toorder[i] < pivot) {
            swap(toorder, i, b);
            b++;
        }
    }
    swap(toorder, hi, b);
    return b;
}

/*
 * Check if elements are in non-decreasing order
 */
int is_sorted(int *toorder, int N)
{
    int unsorted = 0;

#if defined(_OPENMP) && (_OPENMP >= 201307)
#pragma omp simd reduction(|: unsorted)
#endif
    for (int i = 1; i < N; i++) {
        unsorted |= toorder[i] < toorder[i - 1];
    }
    return unsorted;
}

/*
 * Generate a case
 */
int *generate_case(int N)
{
    int i;
    int *ret = NULL;

    // Make case generation reproducible
    srandnum(0);

    // Allocate memory
    ret = (int *) malloc(N * sizeof(int));
    if (ret == NULL) {
        printf("Error: some malloc won't work.\n");
        return NULL;
    }
    // Get pseudo-random positive integer values
    for (i = 0; i < N; i++) {
        ret[i] = drand(0, INT_MAX);
    }
    return ret;
}

/*
 * A pseudo-random number between two positive integer values
 */
double drand(int xmin, int xmax)
{
    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;
}

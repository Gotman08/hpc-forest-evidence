      "content": "#include<stdio.h>\n#include<stdlib.h>\n#include<math.h>\n#include<string.h>\n\nstatic void bubble_sort(double *matriz, int tam) {\n    int i, j;\n    double aux;\n    for (i = tam - 1; i > 0; i--) {\n        for (j = 0; j < i; j++) {\n            if (matriz[j] > matriz[j + 1]) {\n                aux = matriz[j];\n                matriz[j] = matriz[j + 1];\n                matriz[j + 1] = aux;\n            }\n        }\n    }\n}\n\nstatic void merge_sort(double *values, double *scratch, int tam) {\n    size_t n = (size_t)tam;\n    size_t width;\n    double *src = values;\n    double *dst = scratch;\n\n    for (width = 1; width < n;) {\n        size_t left = 0;\n        while (left < n) {\n            size_t remaining = n - left;\n            size_t mid = left + (remaining < width ? remaining : width);\n            size_t right;\n            size_t i, j, k;\n\n            remaining = n - mid;\n            right = mid + (remaining < width ? remaining : width);\n            i = left;\n            j = mid;\n            k = left;\n            while (i < mid && j < right) {\n                if (src[i] <= src[j])\n                    dst[k++] = src[i++];\n                else\n                    dst[k++] = src[j++];\n            }\n            while (i < mid)\n                dst[k++] = src[i++];\n            while (j < right)\n                dst[k++] = src[j++];\n            left = right;\n        }\n\n        {\n            double *tmp = src;\n            src = dst;\n            dst = tmp;\n        }\n        if (width > n / 2)\n            break;\n        width *= 2;\n    }\n\n    if (src != values)\n        memcpy(values, src, n * sizeof(*values));\n}\n\nstatic void ordena_colunas(double *matriz, int lin, int col, double *scratch) {\n    int i, j;\n    for (i = 0; i < col; i++) {\n        double *coluna = matriz + (size_t)i * (size_t)lin;\n        int has_nan = 0;\n\n        if (scratch == NULL) {\n            bubble_sort(coluna, lin);\n            continue;\n        }\n        for (j = 0; j < lin; j++) {\n            if (isnan(coluna[j])) {\n                has_nan = 1;\n                break;\n            }\n        }\n        if (has_nan)\n            bubble_sort(coluna, lin);\n        else\n            merge_sort(coluna, scratch, lin);\n    }\n}\n\nstatic void calcula_media(double *matriz, double *vet, int lin, int col) {\n    int i, j;\n    double soma;\n    for (i = 0; i < col; i++) {\n        size_t base = (size_t)i * (size_t)lin;\n        soma = 0;\n        for (j = 0; j < lin; j++)\n            soma += matriz[base + (size_t)j];\n        vet[i] = soma / lin;\n    }\n}\n\nstatic void calcula_media_harmonica(double *matriz, double *vet, int lin, int col) {\n    int i, j;\n    double soma;\n    for (i = 0; i < col; i++) {\n        size_t base = (size_t)i * (size_t)lin;\n        soma = 0;\n        for (j = 0; j < lin; j++)\n            soma += (1 / matriz[base + (size_t)j]);\n        vet[i] = lin / soma;\n    }\n}\n\nstatic void calcula_mediana(double *matriz, double *vet, int lin, int col) {\n    int i;\n    size_t meio = (size_t)((lin - 1) / 2);\n    if ((lin - 1) % 2) {\n        for (i = 0; i < col; i++) {\n            size_t base = (size_t)i * (size_t)lin;\n            vet[i] = matriz[base + meio] + matriz[base + meio + 1];\n            vet[i] *= 0.5;\n        }\n    } else {\n        for (i = 0; i < col; i++) {\n            size_t base = (size_t)i * (size_t)lin;\n            vet[i] = matriz[base + meio];\n        }\n    }\n}\n\nstatic double moda_aux(double *matriz, int lin) {\n    int i, j;\n    int has_nan = 0;\n\n    for (i = 0; i < lin; i++) {\n        if (isnan(matriz[i])) {\n            has_nan = 1;\n            break;\n        }\n    }\n\n    if (has_nan) {\n        int melhor_contagem = 0;\n        double moda = 0;\n        for (i = 0; i < lin; i++) {\n            int repeticoes = 0;\n            for (j = i + 1; j < lin; j++) {\n                if (matriz[i] == matriz[j])\n                    repeticoes++;\n            }\n            if (repeticoes > melhor_contagem) {\n                melhor_contagem = repeticoes;\n                moda = matriz[i];\n            }\n        }\n        return melhor_contagem == 0 ? -1 : moda;\n    }\n\n    if (lin <= 1)\n        return -1;\n    {\n        int contagem = 1;\n        int melhor_contagem = 1;\n        double moda = -1;\n        for (i = 1; i < lin; i++) {\n            if (matriz[i] == matriz[i - 1]) {\n                contagem++;\n            } else {\n                if (contagem > melhor_contagem) {\n                    melhor_contagem = contagem;\n                    moda = matriz[i - 1];\n                }\n                contagem = 1;\n            }\n        }\n        if (contagem > melhor_contagem)\n            moda = matriz[lin - 1];\n        return moda;\n    }\n}\n\nstatic void calcula_moda(double *matriz, double *moda, int lin, int col) {\n    int i;\n    for (i = 0; i < col; i++)\n        moda[i] = moda_aux(matriz + (size_t)i * (size_t)lin, lin);\n}\n\nstatic void calcula_variancia(double *matriz, double *media, double *variancia, int lin, int col) {\n    int i, j;\n    double soma;\n    for (i = 0; i < col; i++) {\n        size_t base = (size_t)i * (size_t)lin;\n        soma = 0;\n        for (j = 0; j < lin; j++)\n            soma += pow((matriz[base + (size_t)j] - media[i]), 2);\n        variancia[i] = soma / (lin - 1);\n    }\n}\n\nstatic void calcula_desvio_padrao(double *variancia, double *dp, int col) {\n    int i;\n    for (i = 0; i < col; i++)\n        dp[i] = sqrt(variancia[i]);\n}\n\nstatic void calcula_coeficiente_variacao(double *media, double *dp, double *cv, int col) {\n    int i;\n    for (i = 0; i < col; i++)\n        cv[i] = dp[i] / media[i];\n}\n\nint main(int argc, char **argv) {\n    int lin, col, i, j;\n    double *matriz, *mediana, *media, *media_har, *moda, *variancia, *dp, *cv;\n\n    fscanf(stdin, \"%d \", &lin);\n    fscanf(stdin, \"%d\\n\", &col);\n\n    matriz = (double *)malloc((size_t)lin * (size_t)col * sizeof(double));\n    media = (double *)malloc((size_t)col * sizeof(double));\n    media_har = (double *)malloc((size_t)col * sizeof(double));\n    mediana = (double *)malloc((size_t)col * sizeof(double));\n    moda = (double *)malloc((size_t)col * sizeof(double));\n    variancia = (double *)malloc((size_t)col * sizeof(double));\n    cv = (double *)malloc((size_t)col * sizeof(double));\n    dp = (double *)malloc((size_t)col * sizeof(double));\n\n    for (i = 0; i < lin; i++) {\n        for (j = 0; j < col; j++)\n            fscanf(stdin, \"%lf \", &matriz[(size_t)j * (size_t)lin + (size_t)i]);\n    }\n\n    calcula_media(matriz, media, lin, col);\n    calcula_media_harmonica(matriz, media_har, lin, col);\n    {\n        double *scratch = (double *)malloc((size_t)lin * sizeof(double));\n        ordena_colunas(matriz, lin, col, scratch);\n        free(scratch);\n    }\n    calcula_mediana(matriz, mediana, lin, col);\n    calcula_moda(matriz, moda, lin, col);\n    calcula_variancia(matriz, media, variancia, lin, col);\n    calcula_desvio_padrao(variancia, dp, col);\n    calcula_coeficiente_variacao(media, dp, cv, col);\n\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", media[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", media_har[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", mediana[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", moda[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", variancia[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", dp[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", cv[i]);\n    printf(\"\\n\");\n\n    free(matriz);\n    free(media);\n    free(media_har);\n    free(mediana);\n    free(moda);\n    free(variancia);\n    free(dp);\n    free(cv);\n}\n",
      "path": "src/est_matriz_seq.c"
    }

  "files": [
    {
      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <cstring>\n#include <limits>\n#include <memory>\n#include <vector>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nnamespace {\nusing Sum = long long;\nconstexpr std::size_t block_bytes = 256 * 1024;\n\nstruct InputBlock {\n    std::size_t capacity;\n    std::unique_ptr<unsigned char[]> bytes;\n\n    InputBlock()\n        : capacity(block_bytes + 64), bytes(new unsigned char[capacity]) {}\n\n    void ensure(std::size_t needed, std::size_t used) {\n        if (needed <= capacity) return;\n        const std::size_t next_capacity = std::max(needed, capacity * 2);\n        std::unique_ptr<unsigned char[]> next(new unsigned char[next_capacity]);\n        std::memcpy(next.get(), bytes.get(), used);\n        bytes.swap(next);\n        capacity = next_capacity;\n    }\n};\n\nstd::size_t read_block(InputBlock& block) {\n    std::size_t length = std::fread(block.bytes.get(), 1, block_bytes, stdin);\n    if (length == 0) return 0;\n    while (block.bytes[length - 1] > ' ') {\n        const int c = std::fgetc(stdin);\n        if (c == EOF) break;\n        block.ensure(length + 2, length);\n        block.bytes[length++] = static_cast<unsigned char>(c);\n    }\n    block.bytes[length] = ' ';\n    return length;\n}\n\nstd::size_t count_tokens(const unsigned char* bytes, std::size_t length) {\n    std::size_t count = bytes[0] > ' ' ? 1 : 0;\n    #pragma omp simd reduction(+:count)\n    for (std::size_t i = 1; i < length; ++i) {\n        count += static_cast<std::size_t>(bytes[i] > ' ' && bytes[i - 1] <= ' ');\n    }\n    return count;\n}\n\ninline int read_integer(const unsigned char*& p) {\n    while (*p <= ' ') ++p;\n    const bool negative = *p == '-';\n    if (negative || *p == '+') ++p;\n    std::uint32_t magnitude = 0;\n    for (;;) {\n        const unsigned digit = static_cast<unsigned>(*p - '0');\n        if (digit > 9) break;\n        magnitude = magnitude * 10 + digit;\n        ++p;\n    }\n    return negative ? static_cast<int>(-static_cast<Sum>(magnitude))\n                    : static_cast<int>(magnitude);\n}\n\nint current_thread() {\n#ifdef _OPENMP\n    return omp_get_thread_num();\n#else\n    return 0;\n#endif\n}\n\nvoid decode_block(const unsigned char* bytes, std::size_t count,\n                  std::size_t first, int n, const int* row_stripe,\n                  int* matrix, Sum* partials) {\n    const unsigned char* p = bytes;\n    int row = static_cast<int>(first / static_cast<std::size_t>(n));\n    int column = static_cast<int>(first % static_cast<std::size_t>(n));\n    int* destination = matrix + first;\n    while (count != 0) {\n        const std::size_t take = std::min(count, static_cast<std::size_t>(n - column));\n        const int stripe = row_stripe[row];\n        if (stripe >= 0) {\n            Sum* sums = partials + static_cast<std::size_t>(stripe) * n + column;\n            for (std::size_t k = 0; k < take; ++k) {\n                const int value = read_integer(p);\n                destination[k] = value;\n                sums[k] += value;\n            }\n        } else {\n            for (std::size_t k = 0; k < take; ++k) {\n                destination[k] = read_integer(p);\n            }\n        }\n        destination += take;\n        count -= take;\n        column = 0;\n        ++row;\n    }\n}\n}\n\nint main() {\n    int n, s;\n    if (std::scanf(\"%d%d\", &n, &s) != 2) return 0;\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t total = static_cast<std::size_t>(n) * n;\n    int thread_count = 1;\n#ifdef _OPENMP\n    thread_count = std::max(1, std::min(4, omp_get_max_threads()));\n#endif\n    if (total < 65536) thread_count = 1;\n\n    const int width = n - s + 1;\n    const int band_count = std::min(thread_count, width);\n    std::vector<int> band_begin(band_count), band_end(band_count);\n    std::vector<int> boundaries;\n    boundaries.reserve(2 * band_count + 2);\n    boundaries.push_back(0);\n    boundaries.push_back(n);\n    for (int b = 0; b < band_count; ++b) {\n        band_begin[b] = b * width / band_count;\n        band_end[b] = (b + 1) * width / band_count;\n        boundaries.push_back(band_begin[b]);\n        boundaries.push_back(band_begin[b] + s);\n    }\n    std::sort(boundaries.begin(), boundaries.end());\n    boundaries.erase(std::unique(boundaries.begin(), boundaries.end()), boundaries.end());\n\n    std::vector<int> row_stripe(n, -1);\n    std::vector<std::vector<int>> band_stripes(band_count);\n    int stripe_count = 0;\n    for (std::size_t k = 0; k + 1 < boundaries.size(); ++k) {\n        const int low = boundaries[k];\n        const int high = boundaries[k + 1];\n        bool needed = false;\n        for (int b = 0; b < band_count; ++b) {\n            if (low >= band_begin[b] && high <= band_begin[b] + s) {\n                band_stripes[b].push_back(stripe_count);\n                needed = true;\n            }\n        }\n        if (needed) {\n            std::fill(row_stripe.begin() + low, row_stripe.begin() + high, stripe_count);\n            ++stripe_count;\n        }\n    }\n\n    std::unique_ptr<int[]> matrix(new int[total]);\n    const std::size_t summary_stride = static_cast<std::size_t>(stripe_count) * n;\n    std::vector<Sum> partials(static_cast<std::size_t>(thread_count) * summary_stride, 0);\n    const int buffer_count = thread_count == 1 ? 1 : 4 * thread_count;\n    std::vector<InputBlock> blocks(buffer_count);\n    int* const matrix_data = matrix.get();\n    Sum* const summary_data = partials.data();\n    const int* const stripe_data = row_stripe.data();\n    std::size_t assigned = 0;\n    Sum answer = std::numeric_limits<Sum>::lowest();\n\n    #pragma omp parallel num_threads(thread_count) if(thread_count > 1) reduction(max:answer)\n    {\n        #pragma omp single\n        {\n            while (assigned < total) {\n                bool exhausted = false;\n                for (int slot = 0; slot < buffer_count && assigned < total; ++slot) {\n                    const std::size_t length = read_block(blocks[slot]);\n                    if (length == 0) {\n                        exhausted = true;\n                        break;\n                    }\n                    const unsigned char* data = blocks[slot].bytes.get();\n                    const std::size_t tokens = std::min(count_tokens(data, length), total - assigned);\n                    if (tokens != 0) {\n                        const std::size_t first = assigned;\n                        #pragma omp task firstprivate(data, tokens, first) if(thread_count > 1)\n                        {\n                            Sum* local = summary_data +\n                                static_cast<std::size_t>(current_thread()) * summary_stride;\n                            decode_block(data, tokens, first, n, stripe_data, matrix_data, local);\n                        }\n                        assigned += tokens;\n                    }\n                }\n                #pragma omp taskwait\n                if (exhausted) break;\n            }\n        }\n\n        if (assigned == total) {\n            #pragma omp for schedule(static)\n            for (int b = 0; b < band_count; ++b) {\n                std::vector<Sum> columns(n, 0);\n                Sum* const column_data = columns.data();\n                for (int stripe : band_stripes[b]) {\n                    for (int t = 0; t < thread_count; ++t) {\n                        const Sum* source = summary_data +\n                            static_cast<std::size_t>(t) * summary_stride +\n                            static_cast<std::size_t>(stripe) * n;\n                        #pragma omp simd\n                        for (int c = 0; c < n; ++c) {\n                            column_data[c] += source[c];\n                        }\n                    }\n                }\n\n                Sum best = std::numeric_limits<Sum>::lowest();\n                for (int row = band_begin[b]; row < band_end[b]; ++row) {\n                    if (row != band_begin[b]) {\n                        const int* entering = matrix_data +\n                            static_cast<std::size_t>(row + s - 1) * n;\n                        const int* exiting = matrix_data +\n                            static_cast<std::size_t>(row - 1) * n;\n                        #pragma omp simd\n                        for (int c = 0; c < n; ++c) {\n                            column_data[c] += static_cast<Sum>(entering[c]) - exiting[c];\n                        }\n                    }\n                    Sum window = 0;\n                    #pragma omp simd reduction(+:window)\n                    for (int c = 0; c < s; ++c) {\n                        window += column_data[c];\n                    }\n                    best = std::max(best, window);\n                    for (int c = s; c < n; ++c) {\n                        window += column_data[c] - column_data[c - s];\n                        best = std::max(best, window);\n                    }\n                }\n                answer = std::max(answer, best);\n            }\n        }\n    }\n\n    if (assigned != total) return 0;\n    std::printf(\"%lld\\n\", answer);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "A persistent OpenMP team can overlap buffered integer decoding with thread-private interval summaries, then evaluate balanced output-row bands without repeated S-row initialization or per-row synchronization.",

        "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <algorithm>\n#include <limits>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nint main() {\n    int n, s;\n    std::cin >> n >> s;\n    std::vector<std::vector<int> > matrix(n, std::vector<int>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            scanf(\"%d\", &(matrix[i][j]));\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const int window_rows = n - s + 1;\n    long long mxSum = std::numeric_limits<long long>::lowest();\n\n#ifdef _OPENMP\n    int thread_limit = 1;\n    if (static_cast<long long>(n) * n >= 262144)\n        thread_limit = std::min(omp_get_max_threads(), window_rows);\n\n#pragma omp parallel num_threads(thread_limit) if(thread_limit > 1) reduction(max:mxSum)\n#endif\n    {\n        int thread_id = 0;\n        int thread_count = 1;\n#ifdef _OPENMP\n        thread_id = omp_get_thread_num();\n        thread_count = omp_get_num_threads();\n#endif\n        const int first = window_rows * thread_id / thread_count;\n        const int last = window_rows * (thread_id + 1) / thread_count;\n\n        if (first < last) {\n            std::vector<long long> column_sums(n, 0);\n            for (int row = first; row < first + s; ++row) {\n                const int* values = matrix[row].data();\n                for (int col = 0; col < n; ++col)\n                    column_sums[col] += values[col];\n            }\n\n            for (int row = first; row < last; ++row) {\n                if (row != first) {\n                    const int* exiting = matrix[row - 1].data();\n                    const int* entering = matrix[row + s - 1].data();\n                    for (int col = 0; col < n; ++col)\n                        column_sums[col] += static_cast<long long>(entering[col]) - exiting[col];\n                }\n\n                long long sum = 0;\n                for (int col = 0; col < s; ++col)\n                    sum += column_sums[col];\n                mxSum = std::max(mxSum, sum);\n\n                for (int col = s; col < n; ++col) {\n                    sum += column_sums[col] - column_sums[col - s];\n                    mxSum = std::max(mxSum, sum);\n                }\n            }\n        }\n    }\n\n    printf(\"%lld\\n\", mxSum);\n    return 0;\n}\n",

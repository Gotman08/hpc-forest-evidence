    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <cstdio>\\n#include <cstddef>\\n#include <cstdlib>\\n\\nclass FastScanner {\\npublic:\\n    explicit FastScanner(FILE* f) : f_(f), idx_(0), size_(0) {}\\n\\n    int nextInt() {\\n        char c = getChar_();\\n        while (c <= ' ') {\\n            if (!c) return 0;\\n            c = getChar_();\\n        }\\n        bool neg = false;\\n        if (c == '-') {\\n            neg = true;\\n            c = getChar_();\\n        }\\n        int x = 0;\\n        for (; c > ' '; c = getChar_()) {\\n            x = x * 10 + (c - '0');\\n        }\\n        return neg ? -x : x;\\n    }\\n\\nprivate:\\n    FILE* f_;\\n    int idx_;\\n    int size_;\\n    char buf_[1 << 20];\\n\\n    inline char getChar_() {\\n        if (idx_ >= size_) {\\n            size_ = static_cast<int>(fread(buf_, 1, sizeof(buf_), f_));\\n            idx_ = 0;\\n            if (size_ == 0) return '\\\\0';\\n        }\\n        return buf_[idx_++];\\n    }\\n};\\n\\nint main() {\\n    FastScanner fs(stdin);\\n    int n = fs.nextInt();\\n    int s = fs.nextInt();\\n\\n    long long* col_raw = nullptr;\\n    int* ring_raw = nullptr;\\n    if (posix_memalign(reinterpret_cast<void**>(&col_raw), 64,\\n                       static_cast<size_t>(n) * sizeof(long long)) != 0)\\n        return 1;\\n    if (posix_memalign(reinterpret_cast<void**>(&ring_raw), 64,\\n                       static_cast<size_t>(s) * static_cast<size_t>(n) * sizeof(int)) != 0) {\\n        free(col_raw);\\n        return 1;\\n    }\\n\\n    long long* __restrict__ col = col_raw;\\n    int* __restrict__ ring = ring_raw;\\n\\n    for (int j = 0; j < n; ++j)\\n        col[j] = 0LL;\\n\\n    // Load the first s rows and build column sums.\\n    for (int i = 0; i < s; ++i) {\\n        int* row = ring + static_cast<size_t>(i) * n;\\n        int j = 0;\\n        for (; j + 4 <= n; j += 4) {\\n            int v0 = fs.nextInt();\\n            int v1 = fs.nextInt();\\n            int v2 = fs.nextInt();\\n            int v3 = fs.nextInt();\\n            row[j]     = v0;\\n            col[j]    += v0;\\n            row[j + 1] = v1;\\n            col[j + 1]+= v1;\\n            row[j + 2] = v2;\\n            col[j + 2]+= v2;\\n            row[j + 3] = v3;\\n            col[j + 3]+= v3;\\n        }\\n        for (; j < n; ++j) {\\n            int v = fs.nextInt();\\n            row[j] = v;\\n            col[j] += v;\\n        }\\n    }\\n\\n    long long hsum = 0;\\n    for (int j = 0; j < s; ++j)\\n        hsum += col[j];\\n    long long best = hsum;\\n\\n    int head = 0;\\n    for (int top = 1; top + s <= n; ++top) {\\n        int* oldRow = ring + static_cast<size_t>(head) * n;\\n\\n        // Update column sums and the circular row, unrolled by four.\\n        int j = 0;\\n        for (; j + 4 <= n; j += 4) {\\n            int v0 = fs.nextInt();\\n            int v1 = fs.nextInt();\\n            int v2 = fs.nextInt();\\n            int v3 = fs.nextInt();\\n\\n            col[j]     += static_cast<long long>(v0) - oldRow[j];\\n            oldRow[j]   = v0;\\n            col[j + 1] += static_cast<long long>(v1) - oldRow[j + 1];\\n            oldRow[j + 1] = v1;\\n            col[j + 2] += static_cast<long long>(v2) - oldRow[j + 2];\\n            oldRow[j + 2] = v2;\\n            col[j + 3] += static_cast<long long>(v3) - oldRow[j + 3];\\n            oldRow[j + 3] = v3;\\n        }\\n        for (; j < n; ++j) {\\n            int v = fs.nextInt();\\n            col[j] += static_cast<long long>(v) - oldRow[j];\\n            oldRow[j] = v;\\n        }\\n\\n        if (++head == s)\\n            head = 0;\\n\\n        // Recompute the first horizontal window.\\n        hsum = 0;\\n        j = 0;\\n        for (; j + 4 <= s; j += 4) {\\n            hsum += col[j] + col[j + 1] + col[j + 2] + col[j + 3];\\n        }\\n        for (; j < s; ++j)\\n            hsum += col[j];\\n        if (hsum > best)\\n            best = hsum;\\n\\n        // Slide the horizontal window, unrolled by four.\\n        j = s;\\n        for (; j + 3 < n; ) {\\n            hsum += col[j] - col[j - s];\\n            if (hsum > best) best = hsum;\\n            ++j;\\n            hsum += col[j] - col[j - s];\\n            if (hsum > best) best = hsum;\\n            ++j;\\n            hsum += col[j] - col[j - s];\\n            if (hsum > best) best = hsum;\\n            ++j;\\n            hsum += col[j] - col[j - s];\\n            if (hsum > best) best = hsum;\\n            ++j;\\n        }\\n        for (; j < n; ++j) {\\n            hsum += col[j] - col[j - s];\\n            if (hsum > best)\\n                best = hsum;\\n        }\\n    }\\n\\n    std::printf(\\\"%lld\\\\n\\\", best);\\n    free(col_raw);\\n    free(ring_raw);\\n    return 0;\\n}\\n\",\n      \"path\": \"src/solution.cpp\"\n    }\n  ],\n  \"hypothesis\": \"Aligning the column-sum and ring-buffer arrays to cache-line boundaries, adding restrict qualifiers, and unrolling both the row-update and horizontal-sliding loops by four improves memory locality and instruction-level parallelism on ARM64 without changing the streaming algorithm.\",\n  \"notes\": \"The implementation keeps the O(N^2) streaming approach but reduces DRAM/L1 pressure through aligned allocations (posix_memalign with 64-byte alignment), helps the compiler disambiguate pointers via __restrict__, and lowers loop-control overhead by unrolling the two hottest inner loops. All valid sizes, seeds, and repeated calls remain correct because the algorithm and arithmetic are unchanged.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Replaced std::vector allocations with posix_memalign-aligned (64-byte) raw arrays for col and ring\",\n    \"Added __restrict__ qualifiers to the column-sum and ring pointers\",\n    \"Unrolled the row-update loop by four, reading four input integers per iteration\",\n    \"Unrolled the horizontal sliding-window maximum loop by four\"\n  ]\n}",

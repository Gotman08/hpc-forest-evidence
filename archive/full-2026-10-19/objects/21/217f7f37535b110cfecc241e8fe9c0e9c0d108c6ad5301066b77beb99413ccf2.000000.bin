\n    int idx = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n        for (int j = 0; j < g.length; j++) {\\n            xs[idx] = g.points[j].x;\\n            ys[idx] = g.points[j].y;\\n            ls[idx] = g.label;\\n            idx++;\\n        }\\n    }\\n\\n    // Maintain a sorted list of the k smallest distances (ascending).\\n    float *distances = (float *) malloc(k * sizeof(float));\\n    char  *labels    = (char *)  malloc(k * sizeof(char));\\n\\n    for (int i = 0; i < k; i++) {\\n        distances[i] = FLT_MAX;\\n        labels[i] = 0;\\n    }\\n\\n    // Process each point sequentially.\\n    for (int p = 0; p < total_points; p++) {\\n        float dx = to_evaluate.x - xs[p];\\n        float dy = to_evaluate.y - ys[p];\\n        float d = dx*dx + dy*dy;\\n\\n        // Only consider if strictly better than the current worst.\\n        if (d < distances[k-1]) {\\n            int left  = 0;\\n            int right = k - 1;\\n            while (left < right) {\\n                int mid = (left + right) / 2;\\n                if (distances[mid] <= d)\\n                    left = mid + 1;\\n                else\\n                    right = mid;\\n            }\\n            // Insert at the first position where distances[pos] > d.\\n            int insert_pos = left;\\n            memmove(&distances[insert_pos+1], &distances[insert_pos],\\n                    (k - insert_pos - 1) * sizeof(float));\\n            memmove(&labels[insert_pos+1], &labels[insert_pos],\\n                    (k - insert_pos - 1) * sizeof(char));\\n            distances[insert_pos] = d;\\n            labels[insert_pos]    = ls[p];\\n        }\\n    }\\n\\n    // Frequency histogram over the k nearest labels.\\n    int freq[256] = {0};\\n    for (int i = 0; i < k; i++) {\\n        unsigned char c = (unsigned char)labels[i];\\n        freq[c]++;\\n    }\\n\\n    // Find most frequent label with tie-breaking: smallest character wins.\\n    char best_label = 0;\\n    int best_count  = 0;\\n    for (int c = 0; c < 256; c++) {\\n        if (freq[c] > best_count ||\\n            (freq[c] == best_count && (char)c < best_label)) {\\n            best_count  = freq[c];\\n            best_label  = (char)c;\\n        }\\n    }\\n\\n    free(xs); free(ys); free(ls);\\n    free(distances); free(labels);\\n\\n    return best_label;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Flatten all points into three contiguous arrays (xs, ys, labels) for fully sequential memory access during distance computation. Maintain the top-k list as a sorted array using binary search insertion with memmove block copies to reduce instruction overhead and improve cache locality. Replace qsort+scan with a frequency histogram over 256 possible character values to eliminate sorting entirely while preserving tie-breaking (smallest character wins). This combination maximizes memory locality, minimizes branch mispredictions, and reduces dynamic instructions.\",\n  \"notes\": \"\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Flatten per-group point arrays into global SoA layout for sequential access\",\n    \"Replace linear insertion with binary search + memmove in top-k maintenance\",\n    \"Replace qsort+linear scan with frequency histogram over fixed-size array\"\n  ]\n}",

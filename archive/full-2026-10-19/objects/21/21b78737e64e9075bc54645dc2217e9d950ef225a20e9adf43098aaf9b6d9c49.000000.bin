      "content": "#include <algorithm>\n#include <cstddef>\n#include <cstdint>\n#include <iostream>\n#include <utility>\n#include <vector>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nnamespace {\nconst int MOD = 1000000007;\nconst int TILE_SIZE = 256;\nconst std::size_t BOUNDARY_ALIGNMENT = 128;\n\nint* aligned_boundary(std::vector<int>& storage) {\n    const std::uintptr_t address =\n        reinterpret_cast<std::uintptr_t>(storage.data());\n    const std::size_t padding =\n        (BOUNDARY_ALIGNMENT - address % BOUNDARY_ALIGNMENT) %\n        BOUNDARY_ALIGNMENT;\n    return storage.data() + padding / sizeof(int);\n}\n\nvoid update_tile(int row_begin, int row_end, int col_begin, int col_end,\n                 const std::vector<int>& row_offsets,\n                 const std::vector<int>& blocked_columns,\n                 int* bottom, int* right) {\n    for (int row = row_begin; row < row_end; ++row) {\n        int left = right[row];\n        int col = col_begin;\n        const auto first = blocked_columns.begin() + row_offsets[row];\n        const auto last = blocked_columns.begin() + row_offsets[row + 1];\n        auto blocked = std::lower_bound(first, last, col_begin);\n\n        while (blocked != last && *blocked < col_end) {\n            const int stop = *blocked;\n            for (; col < stop; ++col) {\n                int value = bottom[col] + left;\n                if (value >= MOD) value -= MOD;\n                bottom[col] = value;\n                left = value;\n            }\n            bottom[stop] = 0;\n            left = 0;\n            col = stop + 1;\n            ++blocked;\n        }\n\n        for (; col < col_end; ++col) {\n            int value = bottom[col] + left;\n            if (value >= MOD) value -= MOD;\n            bottom[col] = value;\n            left = value;\n        }\n        right[row] = left;\n    }\n}\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n, m;\n    if (!(std::cin >> n >> m)) return 0;\n\n    std::vector<int> row_offsets(n + 1, 0);\n    std::vector<int> blocked_columns(m);\n    {\n        std::vector<std::pair<int, int> > coordinates(m);\n        for (int k = 0; k < m; ++k) {\n            int row, col;\n            std::cin >> row >> col;\n            coordinates[k] = std::make_pair(row, col);\n            ++row_offsets[row + 1];\n        }\n        for (int row = 0; row < n; ++row) {\n            row_offsets[row + 1] += row_offsets[row];\n        }\n        std::vector<int> next(row_offsets.begin(), row_offsets.end() - 1);\n        for (int k = 0; k < m; ++k) {\n            const int row = coordinates[k].first;\n            blocked_columns[next[row]++] = coordinates[k].second;\n        }\n    }\n    for (int row = 0; row < n; ++row) {\n        std::sort(blocked_columns.begin() + row_offsets[row],\n                  blocked_columns.begin() + row_offsets[row + 1]);\n    }\n\n    const std::size_t padding = BOUNDARY_ALIGNMENT / sizeof(int);\n    std::vector<int> bottom_storage(static_cast<std::size_t>(n) + padding, 0);\n    std::vector<int> right_storage(static_cast<std::size_t>(n) + padding, 0);\n    int* const bottom = aligned_boundary(bottom_storage);\n    int* const right = aligned_boundary(right_storage);\n\n    // A virtual incoming edge seeds the origin, unless it is blocked.\n    bottom[0] = 1;\n\n#ifdef _OPENMP\n    const int tile_count = (n + TILE_SIZE - 1) / TILE_SIZE;\n    const int workers = std::min(omp_get_max_threads(), tile_count);\n    if (n >= 2048 && workers > 1) {\n        // Each diagonal owns disjoint bottom and right boundary segments.\n        // The implicit worksharing barrier completes its dependencies.\n        #pragma omp parallel num_threads(workers)\n        {\n            for (int diagonal = 0; diagonal < 2 * tile_count - 1; ++diagonal) {\n                const int first_row = std::max(0, diagonal - tile_count + 1);\n                const int last_row = std::min(diagonal, tile_count - 1);\n                #pragma omp for schedule(static)\n                for (int tile_row = first_row; tile_row <= last_row; ++tile_row) {\n                    const int tile_col = diagonal - tile_row;\n                    const int row_begin = tile_row * TILE_SIZE;\n                    const int col_begin = tile_col * TILE_SIZE;\n                    update_tile(row_begin, std::min(n, row_begin + TILE_SIZE),\n                                col_begin, std::min(n, col_begin + TILE_SIZE),\n                                row_offsets, blocked_columns, bottom, right);\n                }\n            }\n        }\n    } else\n#endif\n    {\n        update_tile(0, n, 0, n, row_offsets, blocked_columns, bottom, right);\n    }\n\n    std::cout << bottom[n - 1] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "A persistent OpenMP team processing 256-by-256 tiles in anti-diagonal order can accelerate large grids on four ARM64 cores, while a serial fallback avoids synchronization overhead for small grids.",
  "notes": "No commands or measurements performed. The n >= 2048 crossover is an unmeasured tuning choice. OpenMP is conditional on the existing build defining _OPENMP; otherwise the serial path remains available. Duplicate blockers and partial tiles are supported.",

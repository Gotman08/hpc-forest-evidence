"""Seal the operator's diagnostic fix; do not change any candidate program."""
import hashlib
import json
import shutil
import tarfile
from pathlib import Path

here = Path(__file__).resolve().parent
workspace = here.parents[1]
project = workspace / "outputs/HPC-Forest"
old = workspace / "work/marathon-v3/payload"
payload = here / "payload"
payload.mkdir(exist_ok=False)
for name in ["prepare_problem.py", "evidence_pack.py", "romeo_marathon.py", "neutral_backend.py"]:
    shutil.copyfile(project / "examples/marathon22" / name, payload / name)
shutil.copyfile(old / "detect_resources.py", payload / "detect_resources.py")
wheel = next((here / "dist").glob("*.whl"))
(payload / "payload-r4").mkdir()
shutil.copyfile(wheel, payload / "payload-r4" / wheel.name)
checksum = hashlib.sha256(wheel.read_bytes()).hexdigest()
base = (old / "romeo_base.py").read_text(encoding="utf-8").replace(
    "c34eed7d075bad5756b4a09806164f7997a19f43f9803db950b0299cb5f99e67", checksum
).replace("hpc-forest-marathon22-interface-v3", "hpc-forest-marathon22-interface-v4")
(payload / "romeo_base.py").write_text(base, encoding="utf-8")
shutil.copytree(project / "tests", payload / "tests", ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
shutil.copytree(old / "qa-deps", payload / "qa-deps")
policy = json.loads((old / "assistance-protocol.json").read_text(encoding="utf-8"))
policy.update(revision=4, technical_changes=[
    "Preserve a bounded local HTTP error response for diagnosis, without implicit replay",
    "Expose search completion separately from confirmation and packaging",
    "Allow operator selection of problem names for isolated infrastructure recovery",
])
(payload / "assistance-protocol.json").write_text(json.dumps(policy, indent=2)+"\n", encoding="utf-8")
manifest = {p.relative_to(payload).as_posix():hashlib.sha256(p.read_bytes()).hexdigest()
            for p in sorted(payload.rglob("*")) if p.is_file()}
manifest.update({k:v for k,v in json.loads((old / "payload-manifest.json").read_text()).items()
                 if k.startswith("sources-officielles/")})
(payload / "payload-manifest.json").write_text(json.dumps(manifest,indent=2)+"\n",encoding="utf-8")
archive = here / "marathon22-interface-v4.tar.gz"
with tarfile.open(archive,"w:gz") as t:
    t.add(payload,arcname="hpc-forest-marathon22-20261015-r4")
receipt = {"archive":str(archive),"bytes":archive.stat().st_size,
           "sha256":hashlib.sha256(archive.read_bytes()).hexdigest(),
           "wheel_sha256":checksum,"manifest_files":len(manifest)}
(here / "build-receipt.json").write_text(json.dumps(receipt,indent=2)+"\n",encoding="utf-8")
print(json.dumps(receipt))

      "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n    vector<vector<bool> > blockedCells(n, vector<bool>(n, false));\n    for (int c = 0; c < m; ++c) {\n        int i, j;\n        cin >> i >> j;\n        blockedCells[i][j] = true;\n    }\n\n    vector<int> bottom(n, 0);\n    bottom[0] = 1;\n\n    bool parallel = false;\n#ifdef _OPENMP\n    parallel = n >= 1024;\n#endif\n    if (!parallel) {\n        for (int i = 0; i < n; ++i) {\n            int left = 0;\n            for (int j = 0; j < n; ++j) {\n                int value = 0;\n                if (!blockedCells[i][j]) {\n                    value = bottom[j] + left;\n                    if (value >= MOD) value -= MOD;\n                }\n                bottom[j] = value;\n                left = value;\n            }\n        }\n    } else {\n        const int tileSize = 128;\n        const int tiles = (n + tileSize - 1) / tileSize;\n        vector<int> right(n, 0);\n\n        // A diagonal has disjoint row and column boundary segments.\n        // The implicit work-sharing barrier publishes both boundaries.\n#ifdef _OPENMP\n#pragma omp parallel\n#endif\n        {\n            for (int diagonal = 0; diagonal < 2 * tiles - 1; ++diagonal) {\n                const int first = max(0, diagonal - tiles + 1);\n                const int last = min(tiles - 1, diagonal);\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n                for (int tileColumn = first; tileColumn <= last; ++tileColumn) {\n                    const int tileRow = diagonal - tileColumn;\n                    const int rowBegin = tileRow * tileSize;\n                    const int rowEnd = min(n, rowBegin + tileSize);\n                    const int columnBegin = tileColumn * tileSize;\n                    const int columnEnd = min(n, columnBegin + tileSize);\n                    for (int i = rowBegin; i < rowEnd; ++i) {\n                        int left = right[i];\n                        for (int j = columnBegin; j < columnEnd; ++j) {\n                            int value = 0;\n                            if (!blockedCells[i][j]) {\n                                value = bottom[j] + left;\n                                if (value >= MOD) value -= MOD;\n                            }\n                            bottom[j] = value;\n                            left = value;\n                        }\n                        right[i] = left;\n                    }\n                }\n            }\n        }\n    }\n\n    cout << bottom[n - 1] << endl;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "A persistent OpenMP team processing independent 128-by-128 tiles in wavefront order can accelerate large grids while retaining linear DP storage; a serial path avoids synchronization overhead on small grids.",
  "notes": "Preserves obstacle storage and input/output behavior. Uses OpenMP only when enabled by the existing compiler configuration; otherwise runs serially. No commands or measurements performed.",

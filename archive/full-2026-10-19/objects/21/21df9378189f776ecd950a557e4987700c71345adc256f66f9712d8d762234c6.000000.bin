{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\nstatic void knn_collect_serial(int n_groups, Group *groups, int k,\\n                               Point to_evaluate, char *labels) {\\n    float *distances = (float *) malloc(sizeof(float) * (size_t) k);\\n    int i, j, x, y;\\n\\n    for (i = 0; i < k; i++) {\\n        labels[i] = -1;\\n        distances[i] = -1;\\n    }\\n\\n    for (i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n\\n        for (j = 0; j < g.length; j++) {\\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n\\n            for (x = 0; x < k; x++) {\\n                if (d < distances[x] || distances[x] == -1) {\\n                    for (y = k - 1; y > x; y--) {\\n                        distances[y] = distances[y - 1];\\n                        labels[y] = labels[y - 1];\\n                    }\\n\\n                    distances[x] = d;\\n                    labels[x] = g.label;\\n                    break;\\n                }\\n            }\\n        }\\n    }\\n\\n    free(distances);\\n}\\n\\n#ifdef _OPENMP\\ntypedef struct {\\n    float *distances;\\n    char *labels;\\n    int count;\\n    int next;\\n} KnnPartial;\\n\\nstatic int knn_collect_parallel(int n_groups, Group *groups, int k,\\n                                Point to_evaluate, size_t total,\\n                                char *labels) {\\n    int max_threads = omp_get_max_threads();\\n    if (max_threads <= 1 || total < 16384) {\\n        return 0;\\n    }\\n\\n    KnnPartial *partials = (KnnPartial *) calloc((size_t) max_threads,\\n                                                sizeof(KnnPartial));\\n    if (partials == NULL) {\\n        return 0;\\n    }\\n\\n    int actual_threads = 1;\\n    int failed = 0;\\n\\n    #pragma omp parallel reduction(|:failed)\\n    {\\n        int tid = omp_get_thread_num();\\n        int nth = omp_get_num_threads();\\n        if (tid == 0) {\\n            actual_threads = nth;\\n        }\\n\\n        size_t block = total / (size_t) nth;\\n        size_t remainder = total % (size_t) nth;\\n        size_t t = (size_t) tid;\\n        size_t begin = block * t + (t < remainder ? t : remainder);\\n        size_t span = block + (t < remainder ? 1 : 0);\\n        size_t end = begin + span;\\n        int capacity = span < (size_t) k ? (int) span : k;\\n        KnnPartial *partial = &partials[tid];\\n\\n        if (capacity > 0) {\\n            partial->distances = (float *) malloc(sizeof(float) * (size_t) capacity);\\n            partial->labels = (char *) malloc(sizeof(char) * (size_t) capacity);\\n\\n            if (partial->distances == NULL || partial->labels == NULL) {\\n                failed = 1;\\n            } else {\\n                int count = 0;\\n                size_t offset = 0;\\n\\n                for (int i = 0; i < n_groups; i++) {\\n                    Group g = groups[i];\\n                    size_t group_begin = offset;\\n                    offset += (size_t) g.length;\\n\\n                    if (offset <= begin) {\\n                        continue;\\n                    }\\n                    if (group_begin >= end) {\\n                        break;\\n                    }\\n\\n                    size_t first = begin > group_begin ? begin - group_begin : 0;\\n                    size_t last = end < offset ? end - group_begin : (size_t) g.length;\\n\\n                    for (size_t j = first; j < last; j++) {\\n                        float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n\\n                        /* NaNs require the original sequential insertion semantics. */\\n                        if (d != d) {\\n                            failed = 1;\\n                            continue;\\n                        }\\n\\n                        if (count == capacity &&\\n                            !(d < partial->distances[count - 1])) {\\n                            continue;\\n                        }\\n\\n                        int at = count;\\n                        if (at == capacity) {\\n                            at--;\\n                        }\\n\\n                        while (at > 0 && d < partial->distances[at - 1]) {\\n                            partial->distances[at] = partial->distances[at - 1];\\n                            partial->labels[at] = partial->labels[at - 1];\\n                            at--;\\n                        }\\n\\n                        partial->distances[at] = d;\\n                        partial->labels[at] = g.label;\\n                        if (count < capacity) {\\n                            count++;\\n                        }\\n                    }\\n                }\\n\\n                partial->count = count;\\n            }\\n        }\\n    }\\n\\n    if (!failed) {\\n        for (int i = 0; i < k; i++) {\\n            labels[i] = -1;\\n        }\\n\\n        /* Earlier contiguous blocks win equal-distance ties. */\\n        for (int i = 0; i < k; i++) {\\n            int best = -1;\\n            for (int t = 0; t < actual_threads; t++) {\\n                KnnPartial *partial = &partials[t];\\n                if (partial->next < partial->count &&\\n                    (best < 0 ||\\n                     partial->distances[partial->next] <\\n                     partials[best].distances[partials[best].next])) {\\n                    best = t;\\n                }\\n            }\\n\\n            if (best < 0) {\\n                break;\\n            }\\n            labels[i] = partials[best].labels[partials[best].next++];\\n        }\\n    }\\n\\n    for (int t = 0; t < actual_threads; t++) {\\n        free(partials[t].distances);\\n        free(partials[t].labels);\\n    }\\n    free(partials);\\n\\n    return !failed;\\n}\\n#endif\\n\\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n    char *labels = (char *) malloc(sizeof(char) * (size_t) k);\\n\\n#ifdef _OPENMP\\n    size_t total = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        total += (size_t) groups[i].length;\\n    }\\n\\n    if (!knn_collect_parallel(n_groups, groups, k, to_evaluate, total, labels))\\n#endif\\n    {\\n        knn_collect_serial(n_groups, groups, k, to_evaluate, labels);\\n    }\\n\\n    qsort(labels, k, sizeof(char), compare_for_sort);\\n\\n    char most_frequent = labels[0];\\n    int most_frequent_count = 1;\\n    int current_frequency = 1;\\n\\n    for (int i = 1; i < k; i++) {\\n        if (labels[i] != labels[i - 1]) {\\n            if (current_frequency > most_frequent_count) {\\n                most_frequent = labels[i - 1];\\n                most_frequent_count = current_frequency;\\n            }\\n\\n            current_frequency = 1;\\n        } else {\\n            current_frequency++;\\n        }\\n\\n        if (i == k - 1 && current_frequency > most_frequent_count) {\\n            most_frequent = labels[i - 1];\\n            most_frequent_count = current_frequency;\\n        }\\n    }\\n\\n    free(labels);\\n    return most_frequent;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Balanced contiguous point partitions with thread-private top-k lists should accelerate selection on four ARM64 cores, while a deterministic merge preserves original distance-tie behavior.\",\n  \"notes\": \"Unmeasured proposal; no commands executed. Parsing, distance arithmetic, label voting and src/knn.h remain unchanged.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Use OpenMP thread-private sorted neighbor lists over balanced contiguous point ranges, with an OR reduction for fallback conditions.\",\n    \"Reject candidates that cannot enter a full local list and merge retained lists in original block order for stable equal-distance selection.\",\n    \"Retain serial selection for small inputs, unavailable OpenMP, allocation failure or NaN distances; free per-call selection storage.\"\n  ]\n}"}}

      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n#define POSITION_PACKET_SIZE 32\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\ntypedef struct {\n  float x[POSITION_PACKET_SIZE];\n  float y[POSITION_PACKET_SIZE];\n  float z[POSITION_PACKET_SIZE];\n} PositionPacket;\n\nstatic void body_force_scalar(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n#if defined(__GNUC__) && !defined(__clang__)\n#pragma GCC push_options\n#pragma GCC optimize (\"no-math-errno\")\n#endif\n\n/* SIMD lanes represent independent targets, not a force reduction. */\nstatic inline void accumulate_block(const PositionPacket *restrict target,\n                                    float sx, float sy, float sz,\n                                    float *restrict fx,\n                                    float *restrict fy,\n                                    float *restrict fz) {\n  #pragma omp simd\n  for (int lane = 0; lane < POSITION_PACKET_SIZE; ++lane) {\n    float dx = sx - target->x[lane];\n    float dy = sy - target->y[lane];\n    float dz = sz - target->z[lane];\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n    fx[lane] += dx * inv_dist3;\n    fy[lane] += dy * inv_dist3;\n    fz[lane] += dz * inv_dist3;\n  }\n}\n\n/*\n * Share each source across a cache-resident block of targets.\n * Every target visits the real sources in increasing body order.\n */\nvoid body_force(Body *p, float dt, int n) {\n  if (n <= 0) {\n    return;\n  }\n\n  const size_t packets =\n      ((size_t)n + POSITION_PACKET_SIZE - 1) / POSITION_PACKET_SIZE;\n  PositionPacket *positions = malloc(packets * sizeof(*positions));\n  if (positions == NULL) {\n    body_force_scalar(p, dt, n);\n    return;\n  }\n\n  for (size_t packet = 0; packet < packets; ++packet) {\n    for (int lane = 0; lane < POSITION_PACKET_SIZE; ++lane) {\n      const size_t i = packet * POSITION_PACKET_SIZE + (size_t)lane;\n      if (i < (size_t)n) {\n        positions[packet].x[lane] = p[i].x;\n        positions[packet].y[lane] = p[i].y;\n        positions[packet].z[lane] = p[i].z;\n      } else {\n        positions[packet].x[lane] = 0.0f;\n        positions[packet].y[lane] = 0.0f;\n        positions[packet].z[lane] = 0.0f;\n      }\n    }\n  }\n\n  const size_t full_packets = (size_t)n / POSITION_PACKET_SIZE;\n  const int tail = n % POSITION_PACKET_SIZE;\n\n  #pragma omp parallel for schedule(static) if(n >= 64)\n  for (size_t tile = 0; tile < packets; ++tile) {\n    const PositionPacket *target = &positions[tile];\n    float fx[POSITION_PACKET_SIZE] = {0.0f};\n    float fy[POSITION_PACKET_SIZE] = {0.0f};\n    float fz[POSITION_PACKET_SIZE] = {0.0f};\n\n    for (size_t source_packet = 0;\n         source_packet < full_packets; ++source_packet) {\n      const PositionPacket *source = &positions[source_packet];\n      for (int source_lane = 0;\n           source_lane < POSITION_PACKET_SIZE; ++source_lane) {\n        accumulate_block(target,\n                         source->x[source_lane],\n                         source->y[source_lane],\n                         source->z[source_lane], fx, fy, fz);\n      }\n    }\n\n    if (tail != 0) {\n      const PositionPacket *source = &positions[full_packets];\n      for (int source_lane = 0; source_lane < tail; ++source_lane) {\n        accumulate_block(target,\n                         source->x[source_lane],\n                         source->y[source_lane],\n                         source->z[source_lane], fx, fy, fz);\n      }\n    }\n\n    const size_t first = tile * POSITION_PACKET_SIZE;\n    const size_t remaining = (size_t)n - first;\n    const int count = remaining < POSITION_PACKET_SIZE\n                      ? (int)remaining : POSITION_PACKET_SIZE;\n    for (int lane = 0; lane < count; ++lane) {\n      const size_t i = first + (size_t)lane;\n      p[i].vx += dt*fx[lane];\n      p[i].vy += dt*fy[lane];\n      p[i].vz += dt*fz[lane];\n    }\n  }\n\n  free(positions);\n}\n\n#if defined(__GNUC__) && !defined(__clang__)\n#pragma GCC pop_options\n#endif\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n  \n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Thirty-two-target cache tiles should amortize source-coordinate loads across eight times more targets than the parent while exposing longer contiguous SIMD sweeps.",

      "content": "#include \"knn.h\"\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\ntypedef struct {\n    size_t ordinal;\n    float distance;\n    char label;\n} Candidate;\n\nstatic int candidate_precedes(const Candidate *a, const Candidate *b) {\n    if (a->distance < b->distance) return 1;\n    if (b->distance < a->distance) return 0;\n    return a->ordinal < b->ordinal;\n}\n\nstatic void heap_sift_up(Candidate *heap, size_t index) {\n    while (index != 0) {\n        size_t parent = (index - 1) / 2;\n        if (!candidate_precedes(&heap[parent], &heap[index])) break;\n\n        Candidate temporary = heap[parent];\n        heap[parent] = heap[index];\n        heap[index] = temporary;\n        index = parent;\n    }\n}\n\nstatic void heap_sift_down(Candidate *heap, size_t count, size_t index) {\n    while (index < count / 2) {\n        size_t left = index * 2 + 1;\n        size_t worst = left;\n        size_t right = left + 1;\n\n        if (right < count && candidate_precedes(&heap[left], &heap[right])) {\n            worst = right;\n        }\n        if (!candidate_precedes(&heap[index], &heap[worst])) break;\n\n        Candidate temporary = heap[index];\n        heap[index] = heap[worst];\n        heap[worst] = temporary;\n        index = worst;\n    }\n}\n\nstatic void heap_offer(Candidate *heap, size_t *count, size_t capacity,\n                       Candidate candidate) {\n    if (capacity == 0) return;\n\n    if (*count < capacity) {\n        size_t index = *count;\n        heap[index] = candidate;\n        *count = index + 1;\n        heap_sift_up(heap, index);\n    } else if (candidate_precedes(&candidate, &heap[0])) {\n        heap[0] = candidate;\n        heap_sift_down(heap, *count, 0);\n    }\n}\n\nstatic char classify_labels(char *labels, int k) {\n    int i;\n    char most_frequent;\n    int most_frequent_count;\n    int current_frequency;\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    most_frequent = labels[0];\n    most_frequent_count = 1;\n    current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nstatic char knn_serial(int n_groups, Group *groups, int k,\n                       Point to_evaluate) {\n    char *labels = (char *) malloc(sizeof(char) * (size_t) k);\n    float *distances = (float *) malloc(sizeof(float) * (size_t) k);\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    char result = classify_labels(labels, k);\n    free(distances);\n    free(labels);\n    return result;\n}\n\nstatic char classify_every_point(int n_groups, Group *groups, int k) {\n    char *labels = (char *) malloc(sizeof(char) * (size_t) k);\n    int position = 0;\n\n    for (int i = 0; i < n_groups; i++) {\n        for (int j = 0; j < groups[i].length; j++) {\n            labels[position++] = groups[i].label;\n        }\n    }\n    while (position < k) {\n        labels[position++] = -1;\n    }\n\n    char result = classify_labels(labels, k);\n    free(labels);\n    return result;\n}\n\nstatic size_t partition_boundary(size_t total, int part, int parts) {\n    size_t divisor = (size_t) parts;\n    size_t quotient = total / divisor;\n    size_t remainder = total % divisor;\n    return quotient * (size_t) part + remainder * (size_t) part / divisor;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    size_t total_points = 0;\n\n    for (int i = 0; i < n_groups; i++) {\n        total_points += (size_t) groups[i].length;\n    }\n\n    if (k > 0 && (size_t) k >= total_points) {\n        return classify_every_point(n_groups, groups, k);\n    }\n    if (k <= 0) {\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t *offsets = (size_t *) malloc(sizeof(size_t) * (size_t) (n_groups + 1));\n    offsets[0] = 0;\n    for (int i = 0; i < n_groups; i++) {\n        offsets[i + 1] = offsets[i] + (size_t) groups[i].length;\n    }\n\n    int maximum_threads = 1;\n#ifdef _OPENMP\n    maximum_threads = omp_get_max_threads();\n#endif\n\n    Candidate **local_heaps = (Candidate **) malloc(\n        sizeof(Candidate *) * (size_t) maximum_threads);\n    size_t *local_counts = (size_t *) malloc(\n        sizeof(size_t) * (size_t) maximum_threads);\n    int active_threads = 1;\n    int observed_nan = 0;\n\n#ifdef _OPENMP\n#pragma omp parallel shared(active_threads, local_counts, local_heaps, observed_nan)\n#endif\n    {\n        int thread_id = 0;\n#ifdef _OPENMP\n        thread_id = omp_get_thread_num();\n#pragma omp single\n        {\n            active_threads = omp_get_num_threads();\n        }\n#endif\n\n        size_t start = partition_boundary(total_points, thread_id, active_threads);\n        size_t end = partition_boundary(total_points, thread_id + 1, active_threads);\n        size_t span = end - start;\n        size_t local_capacity = span < (size_t) k ? span : (size_t) k;\n        int keep_every_local_point = local_capacity == span;\n        Candidate *heap = (Candidate *) malloc(sizeof(Candidate) * local_capacity);\n        size_t count = 0;\n        int local_has_nan = 0;\n        int group_index = 0;\n\n        while (group_index < n_groups && start >= offsets[group_index + 1]) {\n            group_index++;\n        }\n\n        for (size_t ordinal = start; ordinal < end; ordinal++) {\n            while (ordinal >= offsets[group_index + 1]) {\n                group_index++;\n            }\n\n            Group *group = &groups[group_index];\n            float distance = euclidean_distance_no_sqrt(\n                to_evaluate, group->points[ordinal - offsets[group_index]]);\n            Candidate candidate;\n            candidate.ordinal = ordinal;\n            candidate.distance = distance;\n            candidate.label = group->label;\n\n            if (distance != distance) {\n                local_has_nan = 1;\n            }\n\n            if (keep_every_local_point) {\n                heap[count++] = candidate;\n            } else {\n                heap_offer(heap, &count, local_capacity, candidate);\n            }\n        }\n\n        local_heaps[thread_id] = heap;\n        local_counts[thread_id] = count;\n\n#ifdef _OPENMP\n        if (local_has_nan) {\n#pragma omp atomic write\n            observed_nan = 1;\n        }\n#else\n        if (local_has_nan) {\n            observed_nan = 1;\n        }\n#endif\n    }\n\n    free(offsets);\n\n    if (observed_nan) {\n        for (int i = 0; i < active_threads; i++) {\n            free(local_heaps[i]);\n        }\n        free(local_counts);\n        free(local_heaps);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    Candidate *global_heap = (Candidate *) malloc(sizeof(Candidate) * (size_t) k);\n    size_t global_count = 0;\n\n    for (int i = 0; i < active_threads; i++) {\n        for (size_t j = 0; j < local_counts[i]; j++) {\n            heap_offer(global_heap, &global_count, (size_t) k, local_heaps[i][j]);\n        }\n        free(local_heaps[i]);\n    }\n    free(local_counts);\n    free(local_heaps);\n\n    char *labels = (char *) malloc(sizeof(char) * (size_t) k);\n    for (int i = 0; i < k; i++) {\n        labels[i] = global_heap[i].label;\n    }\n\n    char result = classify_labels(labels, k);\n    free(labels);\n    free(global_heap);\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    Group *groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }

"""Close local source/test evidence and render only the proposed new Q command."""

import hashlib
import json
import xml.etree.ElementTree as ET
from pathlib import Path

BASE = Path(__file__).resolve().parents[4]
HERE = Path(__file__).resolve().parent
Q = BASE / "outputs/HPC-Forest-Primes-Natif-Relance-r2e/qualification-zero-modele-r1"
PACKAGE = Q / "paquet-source-lie-r1"


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def ref(path):
    return {"path": str(path), "sha256": sha(path)}


def save(name, value):
    path = HERE / name
    with path.open("x", encoding="utf-8", newline="\n") as stream:
        stream.write(json.dumps(value, indent=2, ensure_ascii=False) + "\n")
    return ref(path)


def main():
    delivery_path = PACKAGE / "LIVRAISON-LOCALE-FINALE.json"
    delivery = json.loads(delivery_path.read_text(encoding="utf-8"))
    assert sha(delivery_path) == "bfe2a6326084998145b09aec1220eda4425b2208fb41334a4a46a36b600f3e01"
    runtime = json.loads(Path(delivery["runtime_manifest"]["path"]).read_text(encoding="utf-8"))
    project = BASE / "work/hpc-forest-primes-natif-relance-r2e/project"
    assert len(runtime) == 108 and all(sha(project / name) == value for name, value in runtime.items())
    junit = HERE / "verification-import-neutre-r2/independant-neutre.xml"
    tree = ET.parse(junit)
    assert not tree.findall(".//failure") and not tree.findall(".//error") and not tree.findall(".//skipped")
    test_counts = {}
    for case in tree.findall(".//testcase"):
        name = case.attrib["classname"].split(".")[-1] + ".py"
        if not case.attrib["classname"]:
            assert case.attrib["name"].startswith(("test_unknown_event_never_promoted_to_clean_NORMAL", "test_delivered_error_hold_survives_later_metadata_upload_failure"))
            name = "test_revue_parser_hold.py"
        test_counts[name] = test_counts.get(name, 0) + 1
    expected = {"test_r2max_r2d_lane.py": 36, "test_owned_timeout_r2e.py": 6,
                "test_codex_cli_diagnostics_r2e.py": 48, "test_first_batch_gate_r2e.py": 20,
                "test_revue_parser_hold.py": 4}
    assert test_counts == expected
    pins = {"source_zip_sha256": delivery["source_zip"]["sha256"],
            "plan_sha256": delivery["plan"]["sha256"], "bundle_sha256": delivery["bundle"]["sha256"],
            "delivery_sha256": sha(delivery_path)}
    changes = ["src/hpc_forest/codex_process.py", "src/hpc_forest/r2max_worker.py",
               "src/hpc_forest/native_r2max.py", "src/hpc_forest/r2max_first_start.py",
               "src/hpc_forest/core.py", "examples/marathon22/primes_native_max.py",
               "tests/test_codex_cli_diagnostics_r2e.py", "tests/test_first_batch_gate_r2e.py",
               "tests/test_owned_timeout_r2e.py"]
    source_review = save("REVUE-SOURCE108-PLAN-PAQUET.json", {
        "schema": "hpc-forest-r2e-cross-owner-source-and-external-integration-review-v1",
        "verified": True, "blocking_findings": [], "native_research_admitted": False, **pins,
        "scope_id": "hpc-forest-primes-native-max-r2e", "source_member_count": 108,
        "reviewed_changed_or_new_members": {name: runtime[name] for name in changes},
        "reviewer_ownership": "External plan/package and core delta; the other owner authored five runtime modules and two suites",
        "core_delta_cross_review": "Read by other source owner before source candidate; unchanged POSIX/timeouts/metadata",
        "source_candidate": delivery["source_candidate"],
        "all_108_source_members_still_match_candidate_manifest": True,
        "fresh_neutral_check": {"junit": ref(junit), "source_cases": 110, "independent_counterexamples": 4,
                                 "bootstrap_is_exact_proposed_Q_import_blocker": True,
                                 "first_failed_import_blocker_preserved": str(HERE / "verification-import-neutre-r1")},
        "findings_closed": [
            "Unknown event/item shape refused instead of clean NORMAL",
            "Durable technical hold written after delivered response but before extra awaited metadata upload",
            "No host skill-directory list in source; exact task-local policy digest-bound to cell and CLI",
            "Only invocation/process projections exported; private argv remains explicitly unverified on ARM",
            "Existing first batch completes evaluation, then exact private audit/release required before next batch",
            "Wait uses existing search deadline, rechecks after validation, creates no fake model response or replay",
        ],
        "budget_MCTS_order_oracle_and_official_reference_changed": False,
        "actual_CLI_key_recognition_clean_first_NORMAL_ARM64_or_performance_proved": False,
        "new_allocated_Q_and_actual_first_batch_reception_required": True,
        "native_processes_models_jobs_or_global_mutations_by_review": 0,
    })
    source_suites = {name: count for name, count in expected.items() if name != "test_revue_parser_hold.py"}
    neutral_review = save("REVUE-NEUTRE-SOURCE108.json", {
        "schema": "hpc-forest-r2e-actual-inert-import-and-neutral-suite-review-v1",
        "verified": True, "blocking_findings": [], "native_research_admitted": False, **pins,
        "source_review_sha256": source_review["sha256"],
        "neutral_suite_counts": source_suites,
        "neutral_suite_sha256": {name: runtime["tests/" + name] for name in source_suites},
        "junit": ref(junit), "source_cases_passed": 110, "independent_counterexamples_passed": 4,
        "executed_once_under_final_preimport_and_test_effect_blockers": True,
        "automatic_pytest_plugins_disabled": True, "CLI_process_signal_or_socket_effects": 0,
        "old_Q_or_historical_generation_replayed": False,
    })
    bundle = Path(delivery["bundle"]["path"])
    bindings = {"schema": "hpc-forest-primes-r2max-qualification-bindings-v2",
                "status": "sealed_local_proposal_source_reviewed_wrapper_review_required",
                "scope_id": "hpc-forest-primes-native-max-r2e", "payload_root": "flat_manifested",
                "source_zip_sha256": pins["source_zip_sha256"], "plan_sha256": pins["plan_sha256"],
                "payload_sha256": pins["bundle_sha256"], "bundle_manifest_sha256": delivery["bundle_manifest"]["sha256"],
                "runtime_manifest_sha256": delivery["runtime_manifest"]["sha256"],
                "delivery_sha256": pins["delivery_sha256"], "integration_review_sha256": source_review["sha256"],
                "payload_bytes": bundle.stat().st_size, "payload_member_count": 181, "source_member_count": 108,
                "remote_root": "/scratch_p/nimarano/hpc-forest-primes-native-contract-qualification-20261018-r2e-" + pins["bundle_sha256"][:12],
                "payload_path": "/scratch_p/nimarano/hpc-forest-primes-native-max-r2e-" + pins["bundle_sha256"][:16] + ".tar.gz"}
    render_input = save("INPUT-RENDU-Q-REEL-LOCAL.json", {
        "schema": "hpc-forest-r2e-zero-model-render-input-v1", "source_delivery": ref(delivery_path),
        "source_review": source_review, "neutral_test_review": neutral_review, "bindings": bindings})
    print(json.dumps({"source_review": source_review, "neutral_review": neutral_review,
                      "render_input": render_input}, indent=2))


if __name__ == "__main__":
    main()

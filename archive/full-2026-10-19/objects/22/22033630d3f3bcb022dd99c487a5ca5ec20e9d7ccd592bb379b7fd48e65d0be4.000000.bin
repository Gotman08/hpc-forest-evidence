{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n\\ntypedef struct {\\n    float distance;\\n    int group;\\n} KnnNeighbor;\\n\\nstatic int knn_neighbor_worse(KnnNeighbor a, KnnNeighbor b) {\\n    return a.distance > b.distance ||\\n           (a.distance == b.distance && a.group > b.group);\\n}\\n\\nstatic void knn_sift_down(KnnNeighbor *neighbors, int count, int root,\\n                          KnnNeighbor value) {\\n    while (root < count / 2) {\\n        int child = root * 2 + 1;\\n        if (child + 1 < count &&\\n            knn_neighbor_worse(neighbors[child + 1], neighbors[child])) {\\n            child++;\\n        }\\n        if (!knn_neighbor_worse(neighbors[child], value)) {\\n            break;\\n        }\\n        neighbors[root] = neighbors[child];\\n        root = child;\\n    }\\n    neighbors[root] = value;\\n}\\n\\nstatic char knn_vote(char *labels, int k) {\\n    qsort(labels, k, sizeof(char), compare_for_sort);\\n\\n    char most_frequent = labels[0];\\n    int most_frequent_count = 1;\\n    int current_frequency = 1;\\n\\n    for (int i = 1; i < k; i++) {\\n        if (labels[i] != labels[i - 1]) {\\n            if (current_frequency > most_frequent_count) {\\n                most_frequent = labels[i - 1];\\n                most_frequent_count = current_frequency;\\n            }\\n            current_frequency = 1;\\n        } else {\\n            current_frequency++;\\n        }\\n\\n        if (i == k - 1 && current_frequency > most_frequent_count) {\\n            most_frequent = labels[i - 1];\\n            most_frequent_count = current_frequency;\\n        }\\n    }\\n    return most_frequent;\\n}\\n\\nstatic char knn_ordered_fallback(int n_groups, Group *groups, int k,\\n                                 Point to_evaluate) {\\n    char *labels = (char *) malloc(sizeof(char) * (size_t) k);\\n    float *distances = (float *) malloc(sizeof(float) * (size_t) k);\\n\\n    for (int i = 0; i < k; i++) {\\n        labels[i] = -1;\\n        distances[i] = -1;\\n    }\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n        for (int j = 0; j < g.length; j++) {\\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n            for (int x = 0; x < k; x++) {\\n                if (d < distances[x] || distances[x] == -1) {\\n                    for (int y = k - 1; y > x; y--) {\\n                        distances[y] = distances[y - 1];\\n                        labels[y] = labels[y - 1];\\n                    }\\n                    distances[x] = d;\\n                    labels[x] = g.label;\\n                    break;\\n                }\\n            }\\n        }\\n    }\\n\\n    char result = knn_vote(labels, k);\\n    free(distances);\\n    free(labels);\\n    return result;\\n}\\n\\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n    int capacity = 0;\\n    for (int i = 0; i < n_groups && capacity < k; i++) {\\n        if (groups[i].length >= k - capacity) {\\n            capacity = k;\\n        } else {\\n            capacity += groups[i].length;\\n        }\\n    }\\n\\n    KnnNeighbor *neighbors = NULL;\\n    if (capacity > 0) {\\n        neighbors = (KnnNeighbor *) malloc(sizeof(*neighbors) * (size_t) capacity);\\n        if (neighbors == NULL) {\\n            return knn_ordered_fallback(n_groups, groups, k, to_evaluate);\\n        }\\n    }\\n\\n    int count = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n        for (int j = 0; j < g.length; j++) {\\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n\\n            /* Unordered distances require the original insertion semantics. */\\n            if (d != d) {\\n                free(neighbors);\\n                return knn_ordered_fallback(n_groups, groups, k, to_evaluate);\\n            }\\n\\n            if (count < capacity) {\\n                neighbors[count].distance = d;\\n                neighbors[count].group = i;\\n                count++;\\n                if (count == capacity) {\\n                    for (int root = count / 2; root > 0;) {\\n                        root--;\\n                        knn_sift_down(neighbors, count, root, neighbors[root]);\\n                    }\\n                }\\n            } else if (capacity > 0 && d < neighbors[0].distance) {\\n                KnnNeighbor value;\\n                value.distance = d;\\n                value.group = i;\\n                knn_sift_down(neighbors, count, 0, value);\\n            }\\n        }\\n    }\\n\\n    char *labels = (char *) malloc(sizeof(char) * (size_t) k);\\n    for (int i = 0; i < k; i++) {\\n        labels[i] = -1;\\n    }\\n    for (int i = 0; i < count; i++) {\\n        labels[i] = groups[neighbors[i].group].label;\\n    }\\n    free(neighbors);\\n\\n    char result = knn_vote(labels, k);\\n    free(labels);\\n    return result;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"A compact contiguous top-k heap should reduce memory traffic by replacing full-array scans and shifts with a hot-root rejection check and logarithmic updates.\",\n  \"notes\": \"Unmeasured proposal; no commands executed. Parsing, distance arithmetic, label voting and output formatting are unchanged. NaN distances use the original insertion algorithm.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Store neighbors as contiguous distance/group-index records, bounded by min(k, total points), and build the initial heap bottom-up.\",\n    \"Reject noncompetitive points at the heap root and move only one heap path for accepted points.\",\n    \"Break equal-distance heap ties by group traversal order, preserving reference label selection; retain sentinel labels when fewer than k points exist.\",\n    \"Keep an ordered-insertion fallback for NaN distances or failed heap allocation, and release per-call work buffers.\"\n  ]\n}"}}

{"files":[{"content":"#include <cstddef>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nstruct adjacency_matrix {\n    int vertices;\n    vector<unsigned char> cells;\n\n    explicit adjacency_matrix(int count)\n        : vertices(count),\n          cells(static_cast<size_t>(count) * static_cast<size_t>(count), 0) {}\n\n    int size() const { return vertices; }\n\n    unsigned char *row(int vertex) {\n        return cells.data() + static_cast<size_t>(vertex) * vertices;\n    }\n\n    const unsigned char *row(int vertex) const {\n        return cells.data() + static_cast<size_t>(vertex) * vertices;\n    }\n};\n\nadjacency_matrix readGraph();\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2);\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence);\ninline void printPermutation(const vector<int> &equivalence);\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if (!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << '\\n';\n\n    return 0;\n}\n\ntemplate<bool FilterSignatures>\nbool enumeratePermutations(const adjacency_matrix &g1,\n                           const adjacency_matrix &g2,\n                           vector<int> &equivalence,\n                           const vector<int> &signature1,\n                           const vector<int> &signature2,\n                           int incompatible) {\n    const int n = g1.size();\n    vector<int> exchange_counter(n, 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    // Preserve Heap's original permutation sequence, including all matches.\n    while (exchange_index < n) {\n        if (exchange_counter[exchange_index] < exchange_index) {\n            const int first = (exchange_index % 2 == 0)\n                ? 0 : exchange_counter[exchange_index];\n            const int old_first = equivalence[first];\n            const int old_second = equivalence[exchange_index];\n\n            if (FilterSignatures) {\n                incompatible -= (signature1[first] != signature2[old_first]);\n                incompatible -= (signature1[exchange_index] != signature2[old_second]);\n                incompatible += (signature1[first] != signature2[old_second]);\n                incompatible += (signature1[exchange_index] != signature2[old_first]);\n            }\n\n            equivalence[first] = old_second;\n            equivalence[exchange_index] = old_first;\n\n            if ((!FilterSignatures || incompatible == 0) &&\n                verifyPermutation(g1, g2, equivalence)) {\n                printPermutation(equivalence);\n                isomorphism_found = true;\n            }\n\n            ++exchange_counter[exchange_index];\n            exchange_index = 1;\n        } else {\n            exchange_counter[exchange_index] = 0;\n            ++exchange_index;\n        }\n    }\n    return isomorphism_found;\n}\n\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2) {\n    if (g1.size() != g2.size()) return false;\n\n    const int n = g1.size();\n    vector<int> equivalence(n);\n    for (int i = 0; i < n; ++i)\n        equivalence[i] = i;\n\n    if (verifyPermutation(g1, g2, equivalence)) {\n        printPermutation(equivalence);\n        return true;\n    }\n\n    vector<int> signature1(n);\n    vector<int> signature2(n);\n    vector<int> signature_balance(static_cast<size_t>(n) * 2 + 2, 0);\n    int incompatible = 0;\n    bool use_signatures = false;\n\n    // Count constructed adjacency entries: duplicate input edges count once.\n    // The low signature bit records the self-loop separately.\n    for (int i = 0; i < n; ++i) {\n        const unsigned char *row1 = g1.row(i);\n        const unsigned char *row2 = g2.row(i);\n        int population1 = 0;\n        int population2 = 0;\n        for (int j = 0; j < n; ++j) {\n            population1 += row1[j];\n            population2 += row2[j];\n        }\n        signature1[i] = 2 * population1 + row1[i];\n        signature2[i] = 2 * population2 + row2[i];\n        ++signature_balance[signature1[i]];\n        --signature_balance[signature2[i]];\n        incompatible += (signature1[i] != signature2[i]);\n        if (i > 0 && signature1[i] != signature1[0])\n            use_signatures = true;\n    }\n\n    for (int count : signature_balance)\n        if (count != 0) return false;\n\n    if (use_signatures)\n        return enumeratePermutations<true>(g1, g2, equivalence,\n                                           signature1, signature2, incompatible);\n\n    // Uniform signatures cannot reject any assignment; omit their hot-loop work.\n    return enumeratePermutations<false>(g1, g2, equivalence,\n                                        signature1, signature2, incompatible);\n}\n\nadjacency_matrix readGraph() {\n    int vertices, edges, source, destination;\n    cin >> vertices;\n    adjacency_matrix graph(vertices);\n\n    cin >> edges;\n    for (int i = 0; i < edges; ++i) {\n        cin >> source >> destination;\n        graph.row(destination)[source] = 1;\n        graph.row(source)[destination] = 1;\n    }\n    return graph;\n}\n\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence) {\n    const int n = g1.size();\n    for (int i = 0; i < n; ++i) {\n        const unsigned char *row1 = g1.row(i);\n        const unsigned char *row2 = g2.row(equivalence[i]);\n        for (int j = 0; j <= i; ++j) {\n            if (row1[j] != row2[equivalence[j]]) return false;\n        }\n    }\n    return true;\n}\n\ninline void printPermutation(const vector<int> &equivalence) {\n    for (int vertex : equivalence)\n        cout << vertex << ' ';\n    cout << '\\n';\n}\n","path":"src/brute_isomorphism.cpp"}],"hypothesis":"Flat byte adjacency and compact assignment signatures should reduce pointer chasing, bit-proxy overhead, and unnecessary adjacency verification while preserving the original Heap-ordered output.","notes":"Unexecuted proposal for controller evaluation. Preserves identity-only early success, trailing spaces, self-loops, duplicate-edge collapse, and support beyond 64 vertices.","sources_kept":[],"transformations":["Replace separately allocated vector<bool> rows with contiguous row-major bytes and direct row-pointer verification.","After checking identity, build loop/population signatures and reject incompatible signature histograms.","Maintain incompatible assignments in constant time per Heap swap; omit filtering work when all signatures are identical.","Retain early-exit exact verification and exhaustive Heap ordering; disable iostream synchronization and per-line flushing."]}
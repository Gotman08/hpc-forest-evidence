{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/* Scalar fallback for small systems or unavailable scratch storage. */\nstatic void body_force_scalar(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Pack immutable positions into contiguous coordinate planes, then reuse\n * each source position across four targets. Each target still accumulates\n * every interaction in ascending source order.\n */\nvoid body_force(Body *p, float dt, int n) {\n  if (n < 4 || (size_t)n > ((size_t)-1) / (3 * sizeof(float))) {\n    body_force_scalar(p, dt, n);\n    return;\n  }\n\n  size_t count = (size_t)n;\n  float *positions = (float *)malloc(3 * count * sizeof(float));\n  if (positions == NULL) {\n    body_force_scalar(p, dt, n);\n    return;\n  }\n\n  float *x = positions;\n  float *y = x + count;\n  float *z = y + count;\n  for (int j = 0; j < n; ++j) {\n    x[j] = p[j].x;\n    y[j] = p[j].y;\n    z[j] = p[j].z;\n  }\n\n  int i = 0;\n  for (; i <= n - 4; i += 4) {\n    const float x0 = x[i], y0 = y[i], z0 = z[i];\n    const float x1 = x[i+1], y1 = y[i+1], z1 = z[i+1];\n    const float x2 = x[i+2], y2 = y[i+2], z2 = z[i+2];\n    const float x3 = x[i+3], y3 = y[i+3], z3 = z[i+3];\n    float fx0 = 0.0f, fy0 = 0.0f, fz0 = 0.0f;\n    float fx1 = 0.0f, fy1 = 0.0f, fz1 = 0.0f;\n    float fx2 = 0.0f, fy2 = 0.0f, fz2 = 0.0f;\n    float fx3 = 0.0f, fy3 = 0.0f, fz3 = 0.0f;\n\n    for (int j = 0; j < n; ++j) {\n      const float xj = x[j], yj = y[j], zj = z[j];\n      {\n        float dx = xj - x0;\n        float dy = yj - y0;\n        float dz = zj - z0;\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n        fx0 += dx * inv_dist3;\n        fy0 += dy * inv_dist3;\n        fz0 += dz * inv_dist3;\n      }\n      {\n        float dx = xj - x1;\n        float dy = yj - y1;\n        float dz = zj - z1;\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n        fx1 += dx * inv_dist3;\n        fy1 += dy * inv_dist3;\n        fz1 += dz * inv_dist3;\n      }\n      {\n        float dx = xj - x2;\n        float dy = yj - y2;\n        float dz = zj - z2;\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n        fx2 += dx * inv_dist3;\n        fy2 += dy * inv_dist3;\n        fz2 += dz * inv_dist3;\n      }\n      {\n        float dx = xj - x3;\n        float dy = yj - y3;\n        float dz = zj - z3;\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n        fx3 += dx * inv_dist3;\n        fy3 += dy * inv_dist3;\n        fz3 += dz * inv_dist3;\n      }\n    }\n\n    p[i].vx += dt*fx0;\n    p[i].vy += dt*fy0;\n    p[i].vz += dt*fz0;\n    p[i+1].vx += dt*fx1;\n    p[i+1].vy += dt*fy1;\n    p[i+1].vz += dt*fz1;\n    p[i+2].vx += dt*fx2;\n    p[i+2].vy += dt*fy2;\n    p[i+2].vz += dt*fz2;\n    p[i+3].vx += dt*fx3;\n    p[i+3].vy += dt*fy3;\n    p[i+3].vz += dt*fz3;\n  }\n\n  for (; i < n; ++i) {\n    const float xi = x[i], yi = y[i], zi = z[i];\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n    for (int j = 0; j < n; ++j) {\n      float dx = x[j] - xi;\n      float dy = y[j] - yi;\n      float dz = z[j] - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n\n  free(positions);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n  \n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Contiguous coordinate planes combined with four-target blocking can reduce source-position cache traffic while preserving each body's ascending-j force accumulation.",
  "notes": "Unmeasured portable C candidate. Preserves binary I/O, square-root arithmetic, all interactions, and ten force-before-integration steps; scratch storage is private to each call.",

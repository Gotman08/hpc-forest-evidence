#include <algorithm>
#include <cstdint>
#include <iostream>
#include <vector>

using namespace std;

const int MOD = 1000000007;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) return 0;

    vector<int> offsets(static_cast<size_t>(n) + 1, 0);
    vector<int> blockedColumns(m);
    {
        vector<int> rows(m);
        vector<int> columns(m);
        for (int k = 0; k < m; ++k) {
            cin >> rows[k] >> columns[k];
            ++offsets[rows[k] + 1];
        }
        for (int i = 0; i < n; ++i) {
            offsets[i + 1] += offsets[i];
        }
        vector<int> next(offsets);
        for (int k = 0; k < m; ++k) {
            blockedColumns[next[rows[k]]++] = columns[k];
        }
    }

    vector<int> dp(n, 0);
    vector<uint64_t> blockedWords((static_cast<size_t>(n) + 63) / 64, 0);
    dp[0] = 1;

    for (int i = 0; i < n; ++i) {
        fill(blockedWords.begin(), blockedWords.end(), uint64_t(0));
        for (int k = offsets[i]; k < offsets[i + 1]; ++k) {
            const int column = blockedColumns[k];
            blockedWords[column / 64] |= uint64_t(1) << (column % 64);
        }

        int left = 0;
        for (int begin = 0; begin < n; begin += 64) {
            const int end = min(begin + 64, n);
            uint64_t bits = blockedWords[begin / 64];
            if (bits == 0) {
                for (int j = begin; j < end; ++j) {
                    int value = dp[j] + left;
                    if (value >= MOD) value -= MOD;
                    dp[j] = value;
                    left = value;
                }
            } else {
                for (int j = begin; j < end; ++j) {
                    int value = 0;
                    if ((bits & uint64_t(1)) == 0) {
                        value = dp[j] + left;
                        if (value >= MOD) value -= MOD;
                    }
                    dp[j] = value;
                    left = value;
                    bits >>= 1;
                }
            }
        }
    }

    cout << dp[n - 1] << '\n';
    return 0;
}

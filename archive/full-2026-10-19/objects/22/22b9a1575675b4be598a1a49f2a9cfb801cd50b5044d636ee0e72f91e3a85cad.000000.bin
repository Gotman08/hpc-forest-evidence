      "content": "{\"role\": \"G\", \"goal\": \"integration of diverse archived transformations; evaluate the full program\", \"experiment\": \"682e90301b9246c4-h01\", \"ordinal\": 2, \"integration_source_ids\": [\"98908818a2b8452a\", \"19c28818d5d24d8d\", \"8b22dace973f4eea\", \"932b7c5848974e07\", \"4eb62c07382d4ef6\", \"af981e9bf2694e13\", \"e6876e8a96f24d02\"], \"current_source_paths\": [\"src/knn.c\", \"src/knn.h\"], \"context_as_data\": {\"sources\": [{\"id\": \"98908818a2b8452a\", \"role\": \"A\", \"commit\": \"8bac186429fc1075fce51f1b9c47230319ed2f0b\", \"transformations\": {\"files\": [\"src/knn.c\"], \"retained\": [\"Replace sorted-array top-k insertion with a contiguous max-heap, reducing candidate maintenance from O(k) shifting to O(log k) sift operations.\", \"Use encounter order to retain stable equal-distance selection; preserve label sorting and its existing vote tie behavior.\", \"Free temporary top-k storage before returning, supporting repeated calls without accumulating these allocations.\"]}, \"mean_seconds\": 0.02942719558874766, \"diff\": \"diff --git a/src/knn.c b/src/knn.c\\nindex 337e3b9..7353305 100644\\n--- a/src/knn.c\\n+++ b/src/knn.c\\n@@ -1,78 +1,109 @@\\n-#include \\\"knn.h\\\"\\n-\\n-char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n-    char * labels = (char *) malloc(sizeof(char) * k);\\n-    float * distances = (float *) malloc(sizeof(float) * k);\\n-\\n-    int i, j, x, y;\\n-\\n-    for (i = 0; i < k; i++) {\\n-        labels[i] = -1;\\n-        distances[i] = -1;\\n-    }\\n-\\n-    for (i = 0; i < n_groups; i++) {\\n-        Group g = groups[i];\\n-\\n-        for (j = 0; j < g.length; j++) {\\n-            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n-\\n-            for (x = 0; x < k; x++) {\\n-                if (d < distances[x] || distances[x] == -1) {\\n-                    for (y = k - 1; y > x; y--) {\\n-                        distances[y] = distances[y - 1];\\n-                        labels[y] = labels[y - 1];\\n-                    }\\n-\\n-                    distances[x] = d;\\n-                    labels[x] = g.label;\\n-\\n-                    break;\\n-                }\\n-            }\\n-        }\\n-    }\\n-\\n-    qsort(labels, k, sizeof(char), compare_for_sort);\\n-\\n-    char most_frequent = labels[0];\\n-    int most_frequent_count = 1;\\n-    int current_frequency = 1;\\n-\\n-    for (i = 1; i < k; i++) {\\n-        if (labels[i] != labels[i - 1]) {\\n-            if (current_frequency > most_frequent_count) {\\n-                most_frequent = labels[i - 1];\\n-                most_frequent_count = current_frequency;\\n-            }\\n-\\n-            current_frequency = 1;\\n-        } else {\\n-            current_frequency++;\\n-        }\\n-\\n-        if (i == k - 1 && current_frequency > most_frequent_count) {\\n-            most_frequent = labels[i - 1];\\n-            most_frequent_count = current_frequency;\\n-        }\\n-    }\\n-\\n-\\n-    return most_frequent;\\n-}\\n-\\n-int main() {\\n-    int n_groups = parse_number_of_groups();\\n-    \\n-    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n-\\n-    for (int i = 0; i < n_groups; i++) {\\n-        groups[i] = parse_next_group();\\n-    }\\n-\\n-    int k = parse_k();\\n-\\n-    Point to_evaluate = parse_point();\\n-\\n-    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n-}\\n\\\\ No newline at end of file\\n+#include \\\"knn.h\\\"\\n+\\n+typedef struct {\\n+    float distance;\\n+    size_t order;\\n+    char label;\\n+} Neighbor;\\n+\\n+static int neighbor_is_worse(const Neighbor *a, const Neighbor *b) {\\n+    if (a->distance > b->distance) return 1;\\n+    if (a->distance < b->distance) return 0;\\n+    return a->order > b->order;\\n+}\\n+\\n+static void sift_down(Neighbor *heap, size_t heap_size, size_t parent) {\\n+    for (;;) {\\n+        size_t child = parent * 2 + 1;\\n+        if (child >= heap_size) break;\\n+        if (child + 1 < heap_size && neighbor_is_worse(&heap[child + 1], &heap[child])) {\\n+            child++;\\n+        }\\n+        if (!neighbor_is_worse(&heap[child], &heap[parent])) break;\\n+\\n+        Neighbor temporary = heap[parent];\\n+        heap[parent] = heap[child];\\n+        heap[child] = temporary;\\n+        parent = child;\\n+    }\\n+}\\n+\\n+char knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n+    char *labels = (char *) malloc(sizeof(char) * (size_t) k);\\n+    Neighbor *heap = (Neighbor *) malloc(sizeof(Neighbor) * (size_t) k);\\n+    size_t heap_size = 0;\\n+    size_t order = 0;\\n+    int i, j;\\n+\\n+    for (i = 0; i < n_groups; i++) {\\n+        const Group *group = &groups[i];\\n+\\n+        for (j = 0; j < group->length; j++) {\\n+            Neighbor candidate;\\n+            candidate.distance = euclidean_distance_no_sqrt(to_evaluate, group->points[j]);\\n+            candidate.order = order++;\\n+            candidate.label = group->label;\\n+\\n+            if (heap_size < (size_t) k) {\\n+                size_t position = heap_size++;\\n+                heap[position] = candidate;\\n+\\n+                while (position > 0) {\\n+                    size_t parent = (position - 1) / 2;\\n+                    if (!neighbor_is_worse(&heap[position], &heap[parent])) break;\\n+                    Neighbor temporary = heap[position];\\n+                    heap[position] = heap[parent];\\n+                    heap[parent] = temporary;\\n+                    position = parent;\\n+                }\\n+            } else if (neighbor_is_worse(&heap[0], &candidate)) {\\n+                heap[0] = candidate;\\n+                sift_down(heap, heap_size, 0);\\n+            }\\n+        }\\n+    }\\n+\\n+    for (i = 0; i < k; i++) labels[i] = -1;\\n+    for (i = 0; i < (int) heap_size; i++) labels[i] = heap[i].label;\\n+\\n+    qsort(labels, k, sizeof(char), compare_for_sort);\\n+\\n+    char most_frequent = labels[0];\\n+    int most_frequent_count = 1;\\n+    int current_frequency = 1;\\n+\\n+    for (i = 1; i < k; i++) {\\n+        if (labels[i] != labels[i - 1]) {\\n+            if (current_frequency > most_frequent_count) {\\n+                most_frequent = labels[i - 1];\\n+                most_frequent_count = current_frequency;\\n+            }\\n+            current_frequency = 1;\\n+        } else {\\n+            current_frequency++;\\n+        }\\n+\\n+        if (i == k - 1 && current_frequency > most_frequent_count) {\\n+            most_frequent = labels[i - 1];\\n+            most_frequent_count = current_frequency;\\n+        }\\n+    }\\n+\\n+    free(labels);\\n+    free(heap);\\n+    return most_frequent;\\n+}\\n+\\n+int main() {\\n+    int n_groups = parse_number_of_groups();\\n+    Group *groups = (Group *) malloc(sizeof(Group) * n_groups);\\n+\\n+    for (int i = 0; i < n_groups; i++) {\\n+        groups[i] = parse_next_group();\\n+    }\\n+\\n+    int k = parse_k();\\n+    Point to_evaluate = parse_point();\\n+\\n+    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n+}\"}, {\"id\": \"19c28818d5d24d8d\", \"role\": \"C\", \"commit\": \"9aa3a79e3bbfffc71c97726bd85cee497f7b90b8\", \"transformations\": {\"files\": [\"src/knn.c\"], \"retained\": [\"Use OpenMP dynamic scheduling over groups and a reduction flag to detect NaN distances.\", \"Maintain a per-thread bounded max-heap of nearest candidates and merge worker heaps after the parallel region.\", \"Order equal-distance candidates by group and point encounter order, then preserve the existing label sorting and vote tie behavior.\", \"Fall back to the original sequential selection when a NaN distance is encountered.\"]}, \"mean_seconds\": 0.029815974334875744, \"diff\": \"diff --git a/src/knn.c b/src/knn.c\\nindex 337e3b9..d4ebdec 100644\\n--- a/src/knn.c\\n+++ b/src/knn.c\\n@@ -1,78 +1,201 @@\\n-#include \\\"knn.h\\\"\\n-\\n-char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n-    char * labels = (char *) malloc(sizeof(char) * k);\\n-    float * distances = (float *) malloc(sizeof(float) * k);\\n-\\n-    int i, j, x, y;\\n-\\n-    for (i = 0; i < k; i++) {\\n-        labels[i] = -1;\\n-        distances[i] = -1;\\n-    }\\n-\\n-    for (i = 0; i < n_groups; i++) {\\n-        Group g = groups[i];\\n-\\n-        for (j = 0; j < g.length; j++) {\\n-            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n-\\n-            for (x = 0; x < k; x++) {\\n-                if (d < distances[x] || distances[x] == -1) {\\n-                    for (y = k - 1; y > x; y--) {\\n-                        distances[y] = distances[y - 1];\\n-                        labels[y] = labels[y - 1];\\n-                    }\\n-\\n-                    distances[x] = d;\\n-                    labels[x] = g.label;\\n-\\n-                    break;\\n-                }\\n-            }\\n-        }\\n-    }\\n-\\n-    qsort(labels, k, sizeof(char), compare_for_sort);\\n-\\n-    char most_frequent = labels[0];\\n-    int most_frequent_count = 1;\\n-    int current_frequency = 1;\\n-\\n-    for (i = 1; i < k; i++) {\\n-        if (labels[i] != labels[i - 1]) {\\n-            if (current_frequency > most_frequent_count) {\\n-                most_frequent = labels[i - 1];\\n-                most_frequent_count = current_frequency;\\n-            }\\n-\\n-            current_frequency = 1;\\n-        } else {\\n-            current_frequency++;\\n-        }\\n-\\n-        if (i == k - 1 && current_frequency > most_frequent_count) {\\n-            most_frequent = labels[i - 1];\\n-            most_frequent_count = current_frequency;\\n-        }\\n-    }\\n-\\n-\\n-    return most_frequent;\\n-}\\n-\\n-int main() {\\n-    int n_groups = parse_number_of_groups();\\n-    \\n-    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n-\\n-    for (int i = 0; i < n_groups; i++) {\\n-        groups[i] = parse_next_group();\\n-    }\\n-\\n-    int k = parse_k();\\n-\\n-    Point to_evaluate = parse_point();\\n-\\n-    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n-}\\n\\\\ No newline at end of file\\n+#include \\\"knn.h\\\"\\n+#include <omp.h>\\n+\\n+typedef struct {\\n+    float distance;\\n+    char label;\\n+    int group_index;\\n+    int point_index;\\n+} Candidate;\\n+\\n+static int candidate_is_worse(Candidate a, Candidate b) {\\n+    if (a.distance > b.distance) return 1;\\n+    if (a.distance < b.distance) return 0;\\n+    if (a.group_index > b.group_index) return 1;\\n+    if (a.group_index < b.group_index) return 0;\\n+    return a.point_index > b.point_index;\\n+}\\n+\\n+static void sift_down(Candidate *heap, size_t heap_size, size_t root) {\\n+    while (root < heap_size / 2) {\\n+        size_t child = root * 2 + 1;\\n+        size_t worse_child = child;\\n+        if (child + 1 < heap_size && candidate_is_worse(heap[child + 1], heap[child])) {\\n+            worse_child = child + 1;\\n+        }\\n+        if (!candidate_is_worse(heap[worse_child], heap[root])) break;\\n+        Candidate temporary = heap[root];\\n+        heap[root] = heap[worse_child];\\n+        heap[worse_child] = temporary;\\n+        root = worse_child;\\n+    }\\n+}\\n+\\n+static void heap_offer(Candidate **heap, size_t *heap_size, size_t *heap_capacity,\\n+                       size_t limit, Candidate candidate) {\\n+    if (*heap_size < limit) {\\n+        if (*heap_size == *heap_capacity) {\\n+            size_t new_capacity = *heap_capacity == 0 ? 8 : *heap_capacity * 2;\\n+            if (new_capacity < *heap_capacity || new_capacity > limit) new_capacity = limit;\\n+            *heap = (Candidate *) realloc(*heap, new_capacity * sizeof(**heap));\\n+            *heap_capacity = new_capacity;\\n+        }\\n+        size_t child = (*heap_size)++;\\n+        (*heap)[child] = candidate;\\n+        while (child > 0) {\\n+            size_t parent = (child - 1) / 2;\\n+            if (!candidate_is_worse((*heap)[child], (*heap)[parent])) break;\\n+            Candidate temporary = (*heap)[child];\\n+            (*heap)[child] = (*heap)[parent];\\n+            (*heap)[parent] = temporary;\\n+            child = parent;\\n+        }\\n+    } else if (limit > 0 && candidate_is_worse((*heap)[0], candidate)) {\\n+        (*heap)[0] = candidate;\\n+        sift_down(*heap, *heap_size, 0);\\n+    }\\n+}\\n+\\n+static char classify_labels(char *labels, int k) {\\n+    qsort(labels, k, sizeof(char), compare_for_sort);\\n+\\n+    char most_frequent = labels[0];\\n+    int most_frequent_count = 1;\\n+    int current_frequency = 1;\\n+\\n+    for (int i = 1; i < k; i++) {\\n+        if (labels[i] != labels[i - 1]) {\\n+            if (current_frequency > most_frequent_count) {\\n+                most_frequent = labels[i - 1];\\n+                most_frequent_count = current_frequency;\\n+            }\\n+            current_frequency = 1;\\n+        } else {\\n+            current_frequency++;\\n+        }\\n+\\n+        if (i == k - 1 && current_frequency > most_frequent_count) {\\n+            most_frequent = labels[i - 1];\\n+            most_frequent_count = current_frequency;\\n+        }\\n+    }\\n+\\n+    return most_frequent;\\n+}\\n+\\n+static char serial_knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n+    char *labels = (char *) malloc(sizeof(char) * (size_t) k);\\n+    float *distances = (float *) malloc(sizeof(float) * (size_t) k);\\n+    int i, j, x, y;\\n+\\n+    for (i = 0; i < k; i++) {\\n+        labels[i] = -1;\\n+        distances[i] = -1;\\n+    }\\n+\\n+    for (i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+        for (j = 0; j < g.length; j++) {\\n+            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n+            for (x = 0; x < k; x++) {\\n+                if (d < distances[x] || distances[x] == -1) {\\n+                    for (y = k - 1; y > x; y--) {\\n+                        distances[y] = distances[y - 1];\\n+                        labels[y] = labels[y - 1];\\n+                    }\\n+                    distances[x] = d;\\n+                    labels[x] = g.label;\"}, {\"id\": \"8b22dace973f4eea\", \"role\": \"G\", \"commit\": \"fd61935803dbb1f99e49e03413db2ecc0296fcfc\", \"transformations\": {\"files\": [\"src/knn.c\"], \"retained\": [\"Replace sorted-array top-k insertion with a contiguous max-heap, reducing candidate maintenance from O(k) shifting to O(log k) sift operations.\", \"Use encounter order to retain stable equal-distance selection; preserve label sorting and its existing vote tie behavior.\", \"Free temporary top-k storage before returning, supporting repeated calls without accumulating these allocations.\"]}, \"mean_seconds\": 0.029906743206083775, \"diff\": \"diff --git a/src/knn.c b/src/knn.c\\nindex 337e3b9..7f008b3 100644\\n--- a/src/knn.c\\n+++ b/src/knn.c\\n@@ -1,78 +1,153 @@\\n-#include \\\"knn.h\\\"\\n-\\n-char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n-    char * labels = (char *) malloc(sizeof(char) * k);\\n-    float * distances = (float *) malloc(sizeof(float) * k);\\n-\\n-    int i, j, x, y;\\n-\\n-    for (i = 0; i < k; i++) {\\n-        labels[i] = -1;\\n-        distances[i] = -1;\\n-    }\\n-\\n-    for (i = 0; i < n_groups; i++) {\\n-        Group g = groups[i];\\n-\\n-        for (j = 0; j < g.length; j++) {\\n-            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n-\\n-            for (x = 0; x < k; x++) {\\n-                if (d < distances[x] || distances[x] == -1) {\\n-                    for (y = k - 1; y > x; y--) {\\n-                        distances[y] = distances[y - 1];\\n-                        labels[y] = labels[y - 1];\\n-                    }\\n-\\n-                    distances[x] = d;\\n-                    labels[x] = g.label;\\n-\\n-                    break;\\n-                }\\n-            }\\n-        }\\n-    }\\n-\\n-    qsort(labels, k, sizeof(char), compa
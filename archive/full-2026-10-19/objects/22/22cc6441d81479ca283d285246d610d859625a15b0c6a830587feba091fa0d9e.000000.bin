"""Deliver the current source without touching prior archives or Git history."""
import hashlib,json,subprocess,zipfile
from pathlib import Path
w=Path(__file__).resolve().parents[2];p=w/'outputs/HPC-Forest';dest=w/'outputs/Marathon22-DeepSeek-v11/HPC-Forest-DeepSeek-v11e.zip'
assert not dest.exists()
names=subprocess.run(['git','-C',str(p),'ls-files','--cached','--others','--exclude-standard','-z'],capture_output=True,check=True).stdout.decode().split('\0')
manifest={}
with zipfile.ZipFile(dest,'x',zipfile.ZIP_DEFLATED) as z:
 for name in sorted(set(names)-{''}):
  src=p/name
  if not src.is_file() or src.is_symlink():continue
  raw=src.read_bytes();manifest[name]=hashlib.sha256(raw).hexdigest();z.writestr('HPC-Forest/'+name,raw)
 z.writestr('HPC-Forest/FILES.sha256.json',json.dumps(manifest,indent=2))
with zipfile.ZipFile(dest) as z:
 assert z.testzip() is None
 for name,h in manifest.items():assert hashlib.sha256(z.read('HPC-Forest/'+name)).hexdigest()==h==hashlib.sha256((p/name).read_bytes()).hexdigest()
receipt={'file':dest.name,'bytes':dest.stat().st_size,'sha256':hashlib.sha256(dest.read_bytes()).hexdigest(),'files':len(manifest),'contents_verified_against_current_source':True,'git_published':False,'git_base':subprocess.run(['git','-C',str(p),'rev-parse','HEAD'],capture_output=True,text=True,check=True).stdout.strip()}
dest.with_suffix('.zip.sha256.json').write_text(json.dumps(receipt,indent=2)+'\n',encoding='utf8');print(json.dumps(receipt))

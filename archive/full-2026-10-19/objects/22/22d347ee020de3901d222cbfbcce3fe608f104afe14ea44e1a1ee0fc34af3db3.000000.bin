{
  "src/graph.c": "#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n#include<stdint.h>\n\n/* Maximum size (in char) for neighbors and compute lists */\n#define MAX 100\n\ntypedef struct {\n  int id;\n  float value;\n  char neighbors[MAX];\n} Node;\n\n/* Reads input, allocates memory, writes graph size and node list. Returns the graph. */\nNode* read_input(char* fname, int *n, char* list) {\n  Node* data = NULL;\n  FILE *fl = NULL;\n\n  if (fname == NULL)\n    fl = stdin;\n  else\n    fl = fopen(fname, \"r\");\n\n  if (fl == NULL) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n\n  fscanf(fl, \"%d %[^\\n]\", n, list);\n\n  if (*n > 0) {\n    data = (Node*) malloc((*n) * sizeof(Node));\n    if (data == NULL) {\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }\n  }\n\n  for (int i = 0; i < *n; i++)\n    fscanf(fl, \"%d %f %[^\\n]\", &data[i].id, &data[i].value, data[i].neighbors);\n\n  fclose(fl);\n  return data;\n}\n\n/* Returns the index of the node with the given id or -1 if not found. */\nint find_by_id(Node g[], int id, int size) {\n  int i = 0;\n  while ((i < size) && g[i].id != id)\n    i++;\n  if (i < size)\n    return i;\n  return -1;\n}\n\ntypedef struct {\n  int id;\n  int record_plus_one;\n} IdEntry;\n\ntypedef struct {\n  int *direct;\n  IdEntry *hash;\n  size_t capacity;\n  int minimum;\n} IdIndex;\n\nstatic size_t hash_id(int id) {\n  uint32_t x = (uint32_t)id;\n  x ^= x >> 16;\n  x *= UINT32_C(0x7feb352d);\n  x ^= x >> 15;\n  x *= UINT32_C(0x846ca68b);\n  x ^= x >> 16;\n  return (size_t)x;\n}\n\n/* Zero slots mean absent; occupied slots retain the first matching record. */\nstatic void build_id_index(IdIndex *index, const Node *g, int size) {\n  index->direct = NULL;\n  index->hash = NULL;\n  index->capacity = 0;\n  index->minimum = 0;\n\n  /* Avoid preprocessing overhead for very small graphs. */\n  if (size < 16)\n    return;\n\n  int minimum = g[0].id;\n  int maximum = g[0].id;\n  for (int i = 1; i < size; i++) {\n    if (g[i].id < minimum)\n      minimum = g[i].id;\n    if (g[i].id > maximum)\n      maximum = g[i].id;\n  }\n\n  uint64_t span = (uint64_t)((int64_t)maximum - (int64_t)minimum) + 1;\n\n  /* Direct addressing is used only when its storage is bounded by O(size). */\n  if (span <= (uint64_t)size * 4 &&\n      span <= SIZE_MAX / sizeof(int)) {\n    int *direct = (int*)calloc((size_t)span, sizeof(int));\n    if (direct == NULL)\n      return;\n\n    for (int i = 0; i < size; i++) {\n      size_t offset = (size_t)((int64_t)g[i].id - (int64_t)minimum);\n      if (direct[offset] == 0)\n        direct[offset] = i + 1;\n    }\n\n    index->direct = direct;\n    index->capacity = (size_t)span;\n    index->minimum = minimum;\n    return;\n  }\n\n  size_t count = (size_t)size;\n  if (count > SIZE_MAX / 2)\n    return;\n\n  size_t capacity = 16;\n  while (capacity < count * 2) {\n    if (capacity > SIZE_MAX / 2)\n      return;\n    capacity *= 2;\n  }\n  if (capacity > SIZE_MAX / sizeof(IdEntry))\n    return;\n\n  IdEntry *table = (IdEntry*)calloc(capacity, sizeof(IdEntry));\n  if (table == NULL)\n    return;\n\n  size_t mask = capacity - 1;\n  for (int i = 0; i < size; i++) {\n    size_t slot = hash_id(g[i].id) & mask;\n    while (table[slot].record_plus_one != 0 && table[slot].id != g[i].id)\n      slot = (slot + 1) & mask;\n    if (table[slot].record_plus_one == 0) {\n      table[slot].id = g[i].id;\n      table[slot].record_plus_one = i + 1;\n    }\n  }\n\n  index->hash = table;\n  index->capacity = capacity;\n}\n\nstatic void free_id_index(IdIndex *index) {\n  free(index->direct);\n  free(index->hash);\n  index->direct = NULL;\n  index->hash = NULL;\n  index->capacity = 0;\n}\n\nstatic int find_indexed(const IdIndex *index, Node g[], int id, int size) {\n  if (index->direct != NULL) {\n    int64_t offset = (int64_t)id - (int64_t)index->minimum;\n    if (offset < 0 || (uint64_t)offset >= index->capacity)\n      return -1;\n    return index->direct[(size_t)offset] - 1;\n  }\n\n  if (index->hash != NULL) {\n    size_t mask = index->capacity - 1;\n    size_t slot = hash_id(id) & mask;\n    while (index->hash[slot].record_plus_one != 0) {\n      if (index->hash[slot].id == id)\n        return index->hash[slot].record_plus_one - 1;\n      slot = (slot + 1) & mask;\n    }\n    return -1;\n  }\n\n  return find_by_id(g, id, size);\n}\n\n/* Preserve neighbor order, selection rules, and recursive float additions. */\nstatic float get_costly_indexed(Node *g, int id, int size, const IdIndex *index) {\n  char *t;\n  int idmax = -1;\n  float max = 0;\n  char *auxptr;\n\n  int nd = find_indexed(index, g, id, size);\n  if (nd < 0)\n    return max;\n\n  char aux[MAX];\n  strcpy(aux, g[nd].neighbors);\n  t = strtok_r(aux, \" \", &auxptr);\n\n  do {\n    int d = find_indexed(index, g, atoi(t), size);\n    if (d >= 0 && max < g[d].value) {\n      max = g[d].value;\n      idmax = atoi(t);\n    }\n  } while ((t = strtok_r(NULL, \" \", &auxptr)));\n\n  float r = g[nd].value;\n  if (idmax != -1)\n    r += get_costly_indexed(g, idmax, size, index);\n\n  return r;\n}\n\n/* Standalone calls own their index; no graph-dependent global state is retained. */\nfloat get_costly(Node *g, int id, int size) {\n  IdIndex index;\n  build_id_index(&index, g, size);\n  float result = get_costly_indexed(g, id, size, &index);\n  free_id_index(&index);\n  return result;\n}\n\n/* Build one index shared by all requested roots. */\nint main() {\n  char *fileN = NULL;\n  char computelist[MAX];\n  int n = -1;\n  Node* input = NULL;\n\n  input = read_input(fileN, &n, computelist);\n\n  IdIndex index;\n  build_id_index(&index, input, n);\n\n  for (char *c = strtok(computelist, \" \"); c != NULL; c = strtok(NULL, \" \"))\n    printf(\"%s: %f\\n\", c, get_costly_indexed(input, atoi(c), n, &index));\n\n  free_id_index(&index);\n  free(input);\n  return 0;\n}\n"
}

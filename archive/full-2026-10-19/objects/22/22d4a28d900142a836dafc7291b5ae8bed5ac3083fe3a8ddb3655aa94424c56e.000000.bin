"""Text-only migration of copied neutral fixtures; no production receipt is generated."""
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
path = ROOT / "work/hpc-forest-primes-native-max-r2/project/tests/test_r2max_private_native.py"
text = path.read_text(encoding="utf8")
text = text.replace("native.MODEL", "MODEL").replace("native.SESSION", "SESSION")
text = text.replace("\n\n@pytest.fixture\ndef sealed", '\n\nMODEL = "gpt-6-astra"\nSESSION = native.CELLS[MODEL]\n\n\n@pytest.fixture\ndef sealed')
text = text.replace('"hpc-forest-primes-native-max-plan-v1"', '"hpc-forest-primes-native-max-plan-v2"')
text = text.replace('"first_launch_model": MODEL, "efforts": ["max"],\n            "first_launch_session_id": SESSION, "automatic_extension": False',
                    '"cells": native.CELLS, "efforts": ["max"],\n            "luna_source_zip_sha256": native.LUNA_SOURCE, "automatic_extension": False')
text = text.replace('    refs["plan"] = save("plan.json", plan)\n',
    '    refs["plan"] = save("plan.json", plan)\n'
    '    for key in ("luna_first_start", "luna_closure"):\n'
    '        refs[key] = save(key + ".json", {"verified": False, "neutral_fixture_only": True})\n')
text = text.replace('        refs[key] = save(key + ".json", item)\n',
    '        elif key == "extension_admission":\n'
    '            item.update(model=MODEL, effort="max", session_id=SESSION, job_id="999999",\n'
    '                        luna_first_start_sha256=refs["luna_first_start"]["sha256"],\n'
    '                        luna_closure_sha256=refs["luna_closure"]["sha256"], human_max_only=True,\n'
    '                        one_cell_only=True, automatic_extension=False, all_prior_calls_reconciled=True, maximum_native_workers=2)\n'
    '        elif key == "session_freshness":\n'
    '            item.update(model=MODEL, effort="max", session_id=SESSION, job_id="999999",\n'
    '                        observed_at="NEUTRAL_NOT_A_LIVE_OBSERVATION", verified_no_prior_claims=True,\n'
    '                        new_cache=True, new_registry=True, native_calls_started_at_admission=0)\n'
    '        refs[key] = save(key + ".json", item)\n')
text = text.replace('"hpc-forest-primes-r2max-authorization-v1"', '"hpc-forest-primes-r2max-authorization-v2"')
text = text.replace('with patch.object(native, "verify_reception", lambda *args: None)',
    'with patch.object(native, "verify_reception", lambda *args: None), patch.object(native, "verify_luna_release", lambda *args: None)')
text = text.replace('[("model", "gpt-6-astra"),', '[("model", "gpt-6-luna"),')
text = text.replace('    with pytest.raises(contracts.ContractError) as exc:\n        contracts.execute(tmp_path / "not-a-real-binary",',
    '    (tmp_path / "not-a-real-binary").write_bytes(b"INERT_NEVER_EXECUTED")\n'
    '    with pytest.raises(contracts.ContractError) as exc:\n        contracts.execute(tmp_path / "not-a-real-binary",')
text = text.replace('    monkeypatch.setattr(sys, "argv", [str(tool), "check", str(tmp_path / "never-executed"), "search"])',
    '    (tmp_path / "never-executed").write_bytes(b"INERT_NEVER_EXECUTED")\n'
    '    monkeypatch.setattr(sys, "argv", [str(tool), "check", str(tmp_path / "never-executed"), "search"])')
text = text.replace('    rows = [{"id": "neutral-exp", "result": json.dumps({"status": status,',
    '    atomic_json(log.with_suffix(".log.private-execution.json"), {\n'
    '        "schema": "hpc-forest-private-evaluation-execution-v2", "verified": True,\n'
    '        "experiment_id": "neutral-exp", "phase": "search", "never_model_input": True,\n'
    '        "streams": {"combined_stdout_stderr": {"sha256": file_digest(log), "bytes": log.stat().st_size}},\n'
    '        "hashing_outside_measured_interval": True, "execution_semantics_changed": False})\n'
    '    rows = [{"id": "neutral-exp", "result": json.dumps({"status": status,')
path.write_text(text, encoding="utf8", newline="\n")
print("Only copied neutral fixture text migrated; fake source remains a non-ZIP and Luna proofs false.")

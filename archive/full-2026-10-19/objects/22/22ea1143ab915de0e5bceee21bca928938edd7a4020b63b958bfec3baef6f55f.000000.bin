        "content": "#include <bits/stdc++.h>\n\nusing namespace std;\n\ntypedef unsigned long long   ll;\n\nconst int N = 1022;\n\nconst ll mod = 1e9 + 7;\n\nclass matrix{\n    public:\n    int n;\n    ll mat[N][N];\n    ll aux[N][N];\n\n    void change_n(int n){\n        this->n = n;\n    }\n\n    matrix(int n){\n        this->n = n;\n    }\n\n    void init_base(){\n        for(int i = 0 ; i < n ; i++){\n            for(int j = 0 ; j < n ; j++){\n                mat[i][j] = 0LL;\n            }\n        }\n    }\n\n    void init_ident(){\n        for(int i = 0 ; i < n ; i++){\n            for(int j = 0 ; j < n ; j++){\n                mat[i][j] = (i == j);\n            }\n        }\n    }\n\n    matrix(){\n\n    }\n\n    void multiply_impl(const matrix &rhs){\n        // Accumulating at most 16 products is safe in unsigned 64-bit:\n        // 16 * (mod - 1)^2 + (mod - 1) < 2^64.\n        const int block_size = 16;\n        const int row_block_size = 4;\n        const int col_block_size = 256;\n\n        for(int ib = 0 ; ib < n ; ib += row_block_size){\n            int iend = min(ib + row_block_size, n);\n\n            for(int jb = 0 ; jb < n ; jb += col_block_size){\n                int jend = min(jb + col_block_size, n);\n\n                for(int i = ib ; i < iend ; i++){\n                    ll *out = aux[i];\n                    for(int j = jb ; j < jend ; j++){\n                        out[j] = 0LL;\n                    }\n                }\n\n                for(int kb = 0 ; kb < n ; kb += block_size){\n                    int kend = min(kb + block_size, n);\n\n                    for(int k = kb ; k < kend ; k++){\n                        ll aik_values[4];\n                        for(int i = ib ; i < iend ; i++){\n                            aik_values[i - ib] = mat[i][k];\n                        }\n                        const ll *rhs_row = rhs.mat[k] + jb;\n\n                        for(int i = ib ; i < iend ; i++){\n                            ll *out = aux[i] + jb;\n                            ll aik = aik_values[i - ib];\n\n                            // Output columns are independent SIMD lanes.\n                            #pragma GCC ivdep\n                            for(int j = 0 ; j < jend - jb ; j++){\n                                out[j] += aik * rhs_row[j];\n                            }\n                        }\n                    }\n\n                    for(int i = ib ; i < iend ; i++){\n                        ll *out = aux[i] + jb;\n                        #pragma GCC ivdep\n                        for(int j = 0 ; j < jend - jb ; j++){\n                            out[j] %= mod;\n                        }\n                    }\n                }\n            }\n        }\n\n        for(int i = 0 ; i < n ; i++){\n            for(int j = 0 ; j < n ; j++){\n                mat[i][j] = aux[i][j];\n            }\n        }\n    }\n\n    void multiply(matrix *rhs){\n        multiply_impl(*rhs);\n    }\n\n    void multiply(matrix &rhs){\n        multiply_impl(rhs);\n    }\n\n    void pow(ll p, matrix &ident){\n        auto &r = ident;\n        auto d = this;\n\n        while(p){\n            if(p & 1LL){\n                r.multiply(d);\n            }\n\n            d->multiply(d);\n            p >>= 1LL;\n        }\n    }\n\n    //pass one line of matrix in the vector, put the base value too, |clause| = n + 1\n    //line is 0 index based\n    void add_clause(int lin, matrix &base, vector< ll > clause){\n        for(int i = 0 ; i < n ; i++){\n            this->mat[lin][i] = clause[i];\n        }\n\n        base.mat[lin][0] = clause[n];\n    }\n\n    void print_line(int line){\n        for(int i = 0 ; i < n ; i++){\n            printf(\"%lld \", this->mat[i][line]);\n        }\n\n        printf(\"\\n\");\n    }\n\n    void print(){\n        cout << \"sz = \" << this->n << endl;\n\n        for(int i = 0 ; i < n ; i++){\n            for(int j = 0 ; j < n ; j++){\n                cout << this->mat[i][j] << \" \";\n            }\n\n            cout << endl;\n        }\n    }\n\n    matrix get_answer_matrix(int e, matrix &ident, matrix &base){\n        this->pow(e, ident);\n        ident.multiply(base);\n        return ident;\n    }\n\n    void set_base_case(int line, matrix &base, ll val){\n        base.mat[line][0] = val;\n    }\n\n    ll get_answer(int line){\n        return this->mat[line][0];\n    }\n};\n\nmatrix ans(N), base(N), ident(N);\n\nint main(){\n    ios::sync_with_stdio(false);\n    cin.tie(NULL);\n\n    int n, k;\n\n    cin >> n >> k;\n\n    ans.change_n(n);\n    base.change_n(n);\n    ident.change_n(n);\n\n    ident.init_ident();\n    base.init_base();\n\n    vector< ll > P;\n    vector< ll > A;\n\n    for(int i = 0 ; i < n ; i++){\n        ll ai;\n        cin >> ai;\n        A.push_back(ai);\n    }\n\n    for(int i = 0 ; i < n ; i++){\n        ll pi;\n        cin >> pi;\n        P.push_back(pi);\n    }\n\n    P.push_back(A[n - 1]);\n    ans.add_clause(0, base, P);\n\n    for(int i = 1 ; i < n ; i++){\n        vector< ll > clausei;\n\n        for(int j = 0 ; j < n ; j++){\n            if(j == i - 1){\n                clausei.push_back(1);\n            }else{\n                clausei.push_back(0);\n            }\n        }\n\n        clausei.push_back(A[n - i - 1]);\n        ans.add_clause(i, base, clausei);\n    }\n\n    cout << ans.get_answer_matrix(k - n, ident, base).get_answer(0) << \"\\n\";\n\n    return 0;\n}\n",
        "path": "src/npbonacci.cpp"
      }

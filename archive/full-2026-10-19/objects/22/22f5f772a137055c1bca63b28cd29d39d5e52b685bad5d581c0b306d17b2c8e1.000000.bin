#include <algorithm>
#include <cstdint>
#include <iostream>
#include <utility>
#include <vector>
#ifdef _OPENMP
#include <omp.h>
#endif

namespace {
using u32 = std::uint32_t;
using u64 = std::uint64_t;
constexpr u32 MOD = 1000000007U;
constexpr u32 PRIME0 = 998244353U;
constexpr u32 PRIME1 = 1004535809U;
constexpr u32 PRIME2 = 469762049U;
constexpr u64 CRT01 = static_cast<u64>(PRIME0) * PRIME1;
constexpr u64 CRT01_MOD_M = CRT01 % MOD;
constexpr u32 CRT_PRODUCT_MOD_M = static_cast<u32>((CRT01_MOD_M * PRIME2) % MOD);

template<u32 Prime>
u32 power_mod(u32 base, u64 exponent) {
    u64 result = 1;
    u64 value = base;
    while (exponent) {
        if (exponent & 1U) result = result * value % Prime;
        value = value * value % Prime;
        exponent >>= 1;
    }
    return static_cast<u32>(result);
}

u32 dot_mod(const std::vector<u32>& a, const std::vector<u32>& b, int degree) {
    int first = std::max(0, degree - static_cast<int>(b.size()) + 1);
    const int last = std::min(degree, static_cast<int>(a.size()) - 1);
    u64 sum = 0;
    while (first <= last) {
        const int end = std::min(first + 16, last + 1);
        // Sixteen products plus a canonical residue fit in uint64_t.
        for (; first < end; ++first)
            sum += static_cast<u64>(a[first]) * b[degree - first];
        sum %= MOD;
    }
    return static_cast<u32>(sum);
}

u32 quadratic_bostan_mori(std::vector<u32> p, std::vector<u32> q, u64 index) {
    const int n = static_cast<int>(p.size());
    std::vector<u32> negative_q(n + 1), next_p(n), next_q(n + 1);
    while (index) {
        for (int i = 0; i <= n; ++i)
            negative_q[i] = ((i & 1) && q[i] != 0) ? MOD - q[i] : q[i];
        const int parity = static_cast<int>(index & 1U);
        for (int i = 0; i < n; ++i)
            next_p[i] = dot_mod(p, negative_q, 2 * i + parity);
        for (int i = 0; i <= n; ++i)
            next_q[i] = dot_mod(q, negative_q, 2 * i);
        p.swap(next_p);
        q.swap(next_q);
        index >>= 1;
    }
    // Q(0) starts at one and remains one throughout the decimation.
    return p[0];
}

struct NttLayout {
    int size;
    std::vector<int> reverse_full, reverse_half;

    explicit NttLayout(int length)
        : size(length), reverse_full(length), reverse_half(length / 2) {
        for (int i = 1; i < size; ++i)
            reverse_full[i] = (reverse_full[i >> 1] >> 1) |
                              ((i & 1) ? size / 2 : 0);
        for (int i = 0; i < size / 2; ++i)
            reverse_half[i] = reverse_full[i] >> 1;
    }
};

template<u32 Prime>
struct NttLane {
    const NttLayout& layout;
    std::vector<u32> roots, a, b, coefficients;
    u32 inverse_full, inverse_half;

    NttLane(const NttLayout& plan, int order)
        : layout(plan), roots(plan.size), a(plan.size), b(plan.size),
          coefficients(2 * order + 1) {
        for (int half = 1; half < layout.size; half <<= 1) {
            const u32 step = power_mod<Prime>(3U, (Prime - 1U) / (2U * half));
            roots[half] = 1;
            for (int j = 1; j < half; ++j)
                roots[half + j] = static_cast<u32>(
                    static_cast<u64>(roots[half + j - 1]) * step % Prime);
        }
        inverse_full = power_mod<Prime>(static_cast<u32>(layout.size), Prime - 2U);
        inverse_half = static_cast<u32>(2ULL * inverse_full % Prime);
    }

    void transform(std::vector<u32>& values, int length, bool inverse) {
        const std::vector<int>& permutation =
            length == layout.size ? layout.reverse_full : layout.reverse_half;
        for (int i = 0; i < length; ++i)
            if (i < permutation[i]) std::swap(values[i], values[permutation[i]]);
        for (int half = 1; half < length; half <<= 1) {
            for (int block = 0; block < length; block += 2 * half) {
                for (int j = 0; j < half; ++j) {
                    const u32 left = values[block + j];
                    const u32 right = static_cast<u32>(
                        static_cast<u64>(values[block + half + j]) * roots[half + j] % Prime);
                    u32 sum = left + right;
                    if (sum >= Prime) sum -= Prime;
                    values[block + j] = sum;
                    values[block + half + j] =
                        left >= right ? left - right : left + Prime - right;
                }
            }
        }
        if (inverse) {
            std::reverse(values.begin() + 1, values.begin() + length);
            const u32 scale = length == layout.size ? inverse_full : inverse_half;
            for (int i = 0; i < length; ++i)
                values[i] = static_cast<u32>(static_cast<u64>(values[i]) * scale % Prime);
        }
    }

    void run(const std::vector<u32>& p, const std::vector<u32>& q, int parity) {
        const int n = static_cast<int>(p.size());
        const int length = layout.size;
        const int half = length / 2;
        std::fill(a.begin(), a.end(), 0U);
        std::fill(b.begin(), b.end(), 0U);
        for (int i = 0; i < n; ++i) a[i] = p[i] % Prime;
        for (int i = 0; i <= n; ++i) b[i] = q[i] % Prime;
        transform(a, length, false);
        transform(b, length, false);

        // The transform of Q(-x) is Q's transform shifted by length/2.
        // Q(x)Q(-x) is even, so its inverse needs only half the length.
        for (int i = 0; i < half; ++i) {
            const u32 q0 = b[i];
            const u32 q1 = b[i + half];
            a[i] = static_cast<u32>(static_cast<u64>(a[i]) * q1 % Prime);
            a[i + half] = static_cast<u32>(static_cast<u64>(a[i + half]) * q0 % Prime);
            b[i] = static_cast<u32>(static_cast<u64>(q0) * q1 % Prime);
        }
        transform(a, length, true);
        transform(b, half, true);
        for (int i = 0; i < n; ++i) coefficients[i] = a[2 * i + parity];
        for (int i = 0; i <= n; ++i) coefficients[n + i] = b[i];
    }
};

struct CenteredCrt {
    u32 inverse0_mod1, inverse01_mod2;

    CenteredCrt()
        : inverse0_mod1(power_mod<PRIME1>(PRIME0, PRIME1 - 2U)),
          inverse01_mod2(power_mod<PRIME2>(static_cast<u32>(CRT01 % PRIME2), PRIME2 - 2U)) {}

    u32 combine(u32 first, u32 second, u32 third) const {
        const u32 delta1 = second >= first ? second - first : second + PRIME1 - first;
        const u32 digit1 = static_cast<u32>(static_cast<u64>(delta1) * inverse0_mod1 % PRIME1);
        const u64 mixed = first + static_cast<u64>(PRIME0) * digit1;
        const u32 remainder2 = static_cast<u32>(mixed % PRIME2);
        const u32 delta2 = third >= remainder2 ? third - remainder2 : third + PRIME2 - remainder2;
        const u32 digit2 = static_cast<u32>(static_cast<u64>(delta2) * inverse01_mod2 % PRIME2);
        u32 result = static_cast<u32>((mixed % MOD + CRT01_MOD_M * digit2) % MOD);

        // Q(-x) has signed integer coefficients. The prime product exceeds
        // twice 1021*(MOD-1)^2, so centered reconstruction is exact.
        const bool negative = digit2 > PRIME2 / 2U ||
            (digit2 == PRIME2 / 2U && mixed > CRT01 / 2U);
        if (negative) {
            if (result >= CRT_PRODUCT_MOD_M) result -= CRT_PRODUCT_MOD_M;
            else result += MOD - CRT_PRODUCT_MOD_M;
        }
        return result;
    }
};

u32 ntt_bostan_mori(std::vector<u32> p, std::vector<u32> q, u64 index, int workers) {
    const int n = static_cast<int>(p.size());
    int length = 1;
    while (length < 2 * n + 1) length <<= 1;
    const NttLayout layout(length);
    NttLane<PRIME0> lane0(layout, n);
    NttLane<PRIME1> lane1(layout, n);
    NttLane<PRIME2> lane2(layout, n);
    const CenteredCrt crt;
    (void)workers;

    // One team spans every recurrence step; each lane owns its buffers.
#ifdef _OPENMP
#pragma omp parallel num_threads(workers) if(workers > 1)
#endif
    {
        for (u64 remaining = index; remaining; remaining >>= 1) {
            const int parity = static_cast<int>(remaining & 1U);
#ifdef _OPENMP
#pragma omp for schedule(static, 1)
#endif
            for (int lane = 0; lane < 3; ++lane) {
                if (lane == 0) lane0.run(p, q, parity);
                else if (lane == 1) lane1.run(p, q, parity);
                else lane2.run(p, q, parity);
            }
#ifdef _OPENMP
#pragma omp single
#endif
            {
                for (int i = 0; i < n; ++i)
                    p[i] = crt.combine(lane0.coefficients[i], lane1.coefficients[i], lane2.coefficients[i]);
                for (int i = 0; i <= n; ++i)
                    q[i] = crt.combine(lane0.coefficients[n + i], lane1.coefficients[n + i], lane2.coefficients[n + i]);
            }
        }
    }
    return p[0];
}
} // namespace

int main() {
    std::ios::sync_with_stdio(false);
    std::cin.tie(nullptr);

    int n;
    u64 h;
    if (!(std::cin >> n >> h)) return 0;
    std::vector<u32> base(n), weights(n);
    for (int i = 0; i < n; ++i) {
        u64 value;
        std::cin >> value;
        base[i] = static_cast<u32>(value % MOD);
    }
    for (int i = 0; i < n; ++i) {
        u64 value;
        std::cin >> value;
        weights[i] = static_cast<u32>(value % MOD);
    }
    if (h <= static_cast<u64>(n)) {
        std::cout << base[static_cast<std::size_t>(h - 1)] << '\n';
        return 0;
    }
    if (n == 1) {
        std::cout << static_cast<u64>(base[0]) * power_mod<MOD>(weights[0], h - 1) % MOD << '\n';
        return 0;
    }

    // The generating function is P(x)/Q(x), with P = A*Q mod x^n.
    std::vector<u32> q(n + 1), p(n);
    q[0] = 1;
    for (int i = 1; i <= n; ++i)
        q[i] = weights[i - 1] == 0 ? 0U : MOD - weights[i - 1];
    for (int i = 0; i < n; ++i) p[i] = dot_mod(base, q, i);

    int workers = 1;
#ifdef _OPENMP
    if (n >= 384) workers = std::max(1, std::min(3, omp_get_max_threads()));
#endif
    const int ntt_threshold = workers > 1 ? 384 : 768;
    const u32 answer = n < ntt_threshold
        ? quadratic_bostan_mori(std::move(p), std::move(q), h - 1)
        : ntt_bostan_mori(std::move(p), std::move(q), h - 1, workers);
    std::cout << answer << '\n';
    return 0;
}

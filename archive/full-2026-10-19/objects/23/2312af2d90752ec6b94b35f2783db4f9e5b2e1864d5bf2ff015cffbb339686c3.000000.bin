          ],
          "retained": [
            "Make Prim_ST outputs explicit and pass immutable inputs by const reference, eliminating shared writes during concurrent solves.",
            "Use OpenMP dynamic scheduling for batches with at least four siblings and 32 vertices; retain the existing serial loop otherwise.",
            "Reduce processed-vertex counts and commit successful children in original order after joining, preserving LIFO traversal and final current_span."
          ]
        },

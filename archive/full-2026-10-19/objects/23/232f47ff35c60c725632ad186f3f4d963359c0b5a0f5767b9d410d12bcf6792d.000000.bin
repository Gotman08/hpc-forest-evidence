        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n#include <string.h>\n\n#define MAXNUM 100\n#define MAXSTR 50\n#define MAXRESULTS 1000\n\nchar firstHalf[MAXNUM][MAXSTR];\nchar secondHalf[MAXNUM][MAXSTR];\nchar strToTest[MAXSTR];\nlong int result[MAXRESULTS];\nint numPrimes=0;\n\nstatic inline uint32_t multiply_mod(uint32_t a, uint32_t b, uint32_t modulus)\n{\n  return (uint32_t)(((uint64_t)a * (uint64_t)b) % modulus);\n}\n\nstatic uint32_t power_mod(uint32_t base, uint32_t exponent, uint32_t modulus)\n{\n  uint32_t power = base % modulus;\n  uint32_t accumulator = 1;\n\n  while (exponent != 0)\n    {\n      if ((exponent & 1u) != 0)\n        accumulator = multiply_mod(accumulator, power, modulus);\n      exponent >>= 1;\n      if (exponent != 0)\n        power = multiply_mod(power, power, modulus);\n    }\n  return accumulator;\n}\n\nstatic int passes_base_2(uint32_t n, uint32_t exponent, unsigned int shifts)\n{\n  uint32_t x = power_mod(2u, exponent, n);\n\n  if (x == 1u || x == n - 1u)\n    return 1;\n  for (unsigned int round = 1; round < shifts; ++round)\n    {\n      x = multiply_mod(x, x, n);\n      if (x == n - 1u)\n        return 1;\n      if (x == 1u)\n        return 0;\n    }\n  return 0;\n}\n\nstatic int passes_bases_7_61(uint32_t n, uint32_t exponent,\n                             unsigned int shifts)\n{\n  const uint32_t base7 = 7u % n;\n  const uint32_t base61 = 61u % n;\n  uint32_t power7 = base7;\n  uint32_t power61 = base61;\n  uint32_t x7 = 1;\n  uint32_t x61 = 1;\n  unsigned int passed;\n\n  /* Independent modular chains share only the exponent traversal. */\n  while (exponent != 0)\n    {\n      if ((exponent & 1u) != 0)\n        {\n          x7 = multiply_mod(x7, power7, n);\n          x61 = multiply_mod(x61, power61, n);\n        }\n      exponent >>= 1;\n      if (exponent != 0)\n        {\n          power7 = multiply_mod(power7, power7, n);\n          power61 = multiply_mod(power61, power61, n);\n        }\n    }\n\n  passed = (base7 == 0u || x7 == 1u || x7 == n - 1u) ? 1u : 0u;\n  passed |= (base61 == 0u || x61 == 1u || x61 == n - 1u) ? 2u : 0u;\n  for (unsigned int round = 1; round < shifts && passed != 3u; ++round)\n    {\n      x7 = multiply_mod(x7, x7, n);\n      x61 = multiply_mod(x61, x61, n);\n      if (x7 == n - 1u)\n        passed |= 1u;\n      if (x61 == n - 1u)\n        passed |= 2u;\n    }\n  return passed == 3u;\n}\n\nint isprime(long int value)\n{\n  uint32_t n;\n  uint32_t exponent;\n  unsigned int shifts = 0;\n\n  if (value < 2)\n    return 0;\n\n  /* Certified candidates fit uint32_t; products are widened before reduction.\n     Bases 2, 7 and 61 are deterministic throughout this numeric range. */\n  n = (uint32_t)value;\n  if ((n & 1u) == 0)\n    return n == 2u;\n  if (n % 3u == 0)\n    return n == 3u;\n  if (n % 5u == 0)\n    return n == 5u;\n  if (n % 7u == 0)\n    return n == 7u;\n  if (n % 11u == 0)\n    return n == 11u;\n\n  exponent = n - 1u;\n  while ((exponent & 1u) == 0)\n    {\n      exponent >>= 1;\n      ++shifts;\n    }\n\n  /* Reject with base 2 before evaluating the independent final two bases. */\n  return passes_base_2(n, exponent, shifts) &&\n         passes_bases_7_61(n, exponent, shifts);\n}\n\nvoid quicksort(long int *primes,int first,int last)\n{ int i, j, pivot;\n  long int temp;\n\n  if (first<last)\n     { pivot=first;\n       i=first;\n       j=last;\n       while(i<j)\n\t     { while (primes[i]<=primes[pivot]&&i<last)\n             i++;\n           while(primes[j]>primes[pivot])\n             j--;\n           if (i<j)\n\t\t      { temp=primes[i];\n                primes[i]=primes[j];\n                primes[j]=temp;\n              }\n         }\n       temp=primes[pivot];\n       primes[pivot]=primes[j];\n       primes[j]=temp;\n       quicksort(primes,first,j-1);\n       quicksort(primes,j+1,last);\n     }\n}\n\n\nint main(int argc,char** argv)\n{ FILE *primesFile;\n  int i=0,j=0,numResults=0;\n  long int primeToTest;\n  primesFile=stdin;\n  fscanf(primesFile,\"%d\\n\",&numPrimes);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",firstHalf[i]);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",secondHalf[i]);\n  fclose(primesFile);\n  for (i=0;i<numPrimes;i++)\n\t  for (j=0;j<numPrimes;j++)\n\t      { strcpy(strToTest,firstHalf[i]);\n\t        strcat(strToTest,secondHalf[j]);\n\t\t\tprimeToTest=atol(strToTest);\n\t\t\tif (isprime(primeToTest)) \n\t\t\t   { result[numResults++]=primeToTest;\n\t\t\t   }\n\t      }\n  quicksort(result,0,numResults-1);\n  for (i=0;i<numResults;i++)\n      printf(\"%ld\\n\",result[i]);\t  \n  return 0;\n}\n",

+def historical_worker_fixture(tmp_path):
+    """The same pure source validator is available in allocated Q and locally."""
+    candidate = HERE.parent / "source/project/src/hpc_forest/lane_contract.py"
+    if not candidate.is_file():
+        pins = json.loads((HERE / "reader/pins-source-plan.json").read_text(encoding="utf8"))
+        candidate = Path(pins["source_project"]) / "src/hpc_forest/lane_contract.py"
+    lane_contract = load("NEUTRAL_actual_source_lane_for_existing_worker", candidate)
+    projection_module = load("NEUTRAL_existing_worker_projection", HERE / "lane_projection.py")
+    cells = load("NEUTRAL_existing_worker_cells", HERE / "launcher/cell_selection.py")
+    detection = load("NEUTRAL_existing_worker_detector", HERE / "launcher/native_worker_detection.py")
+    model, phase, job = "gpt-6-astra", "roots", "999998"
+    session = cells.select(model, phase, job_id=job)
+    cell = {**c.BASE_IDENTITY, "model": model, "effort": "max", "session_id": session,
+            "job_id": job, "remote_root": "/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-" + session}
+    evidence = {name: "a" * 64 for name in lane_contract.EVIDENCE_FIELDS}
+    evidence.update(scientific_reception=lane_contract.SCIENCE_SHA, reconciliation=lane_contract.RECON_SHA)
+    projected = {**cell, "schema": lane_contract.PROJECTION_SCHEMA, "verified": True,
+                 "source_only_state": "received_absent", "source_only_preserved": False,
+                 "source_only_active_workers": 0, "other_native_workers_count": 0,
+                 "active_native_workers_before_start": 0, "maximum_native_workers_total": 4,
+                 "observed_at": 1000.0, "observation_origin": "parent-private-Windows-census",
+                 "windows_census_observed_by_arm": False, "full_census_exported": False,
+                 "foreign_configuration_or_credentials_exported": False, "evidence_sha256": evidence}
+    projection_ref = save(tmp_path / "NEUTRAL-historical-projection.json", projected)
+    lane = {**cell, "schema": lane_contract.LANE_SCHEMA, "verified": True,
+            "maximum_native_workers_total": 4, "active_native_workers_before_start": 0,
+            "full_census_locally_verified": True, "source_only_preserved": False,
+            "source_only_state": "received_absent", "source_only_active_workers": 0,
+            "new_cache_registry_root": True, "native_calls_started": 0, "observed_at": 1000.0,
+            "private_full_census_sha256": "a" * 64, "minimal_owned_observations": projection_ref}
+    auth = {**cell, "purpose": "technical-contract", "technical_phase": phase, "NEUTRAL_lane": lane}
+    auth_ref = save(tmp_path / "NEUTRAL-existing-authorization.json", auth)
+    command = '"NEUTRAL-python.exe" "' + str(HERE / "launcher/bootstrap_worker.py") + '" --model ' + model + ' --session-id ' + session
+    fields = ("ProcessId", "ParentProcessId", "ExecutablePath", "CommandLine", "CreationDate")
+    rows = [{"ProcessId": 990001, "ParentProcessId": 0, "ExecutablePath": str(tmp_path / "NEUTRAL-python.exe"),
+             "CommandLine": command, "CreationDate": "2026-10-18T00:00:00.0000000Z"},
+            {"ProcessId": 990002, "ParentProcessId": 990001, "ExecutablePath": str(tmp_path / "NEUTRAL-python.exe"),
+             "CommandLine": command, "CreationDate": "2026-10-18T00:00:00.0000001Z"}]
+
+    def identity(row):
+        assert set(row) == set(fields)
+        return tuple(row[k] for k in fields)
+
+    state = SimpleNamespace(identity=identity, SO_SESSION="unused-in-received-absent-mode")
+    dependencies = {"cells": cells, "detection": detection, "source_state": state}
+    projection_module.dependency = dependencies.__getitem__  # Pure bounded fixtures only.
+    group = {"model": model, "phase": phase, "session_id": session, "job_id": job,
+             "full_identities": rows, "authorization": auth_ref}
+    return projection_module, cells, lane_contract, cell, lane, auth, group, rows
+
+
+def test_existing_owned_worker_over600s_is_counted_without_readmission(tmp_path):
+    projection, cells, lane_contract, cell, lane, auth, group, rows = historical_worker_fixture(tmp_path)
+    flags = []
+
+    def validate(path, jobs, *, initial=True):
+        actual = json.loads(path.read_text(encoding="utf8"))
+        assert actual == auth and jobs == {c.SCOPE}
+        flags.append(initial)
+        lane_contract.validate_lane_v2(lane, cell, c.artifact, initial=initial, now=1701.0)
+
+    count = projection.count_groups([group], rows, mode="received_absent",
+        selected_session=cells.select("gpt-6.1-sol", "roots"), binding=c.BASE_IDENTITY,
+        validate_authorization=validate)
+    assert count == 1 and flags == [False]
+
+
+def test_new_start_keeps_initial_true_and_refuses_the_same_stale_lane(tmp_path):
+    _, _, lane_contract, cell, lane, _, _, _ = historical_worker_fixture(tmp_path)
+    with pytest.raises(ValueError, match="stale"):
+        lane_contract.validate_lane_v2(lane, cell, c.artifact, initial=True, now=1701.0)
+    # The production constructor's proposed worker retains its initial gate.
+    factory_source = (HERE / "assemble_admissions.py").read_text(encoding="utf8")
+    bootstrap_source = (HERE / "launcher/bootstrap_worker.py").read_text(encoding="utf8")
+    assert 'admission.validate_authorization(artifact(draft_auth), {SCOPE})' in factory_source
+    assert 'initial=True)' in bootstrap_source

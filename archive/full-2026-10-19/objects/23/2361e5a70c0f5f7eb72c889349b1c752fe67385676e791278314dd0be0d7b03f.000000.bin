        "depth": 1,
        "epoch": 1,
        "hypothesis": "Dependence-preserving incremental DFS should reduce path-evaluation cost by eliminating recursive graph/history copies, repeated edge scans and repeated color reductions, while retaining deterministic output.",
        "id": "9c7870b88b47431f",
        "ordinal": 1,
        "parent_id": null,
        "role": "B",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/tropical.cpp"
          ],
          "retained": [
            "Build adjacency once per spanning tree, preserving stored-edge neighbor order.",
            "Compact observed colors once per partition-search invocation; retain nCores as the original stopping target.",
            "Replace copied recursive histories and linear membership searches with balanced push/pop traversal and dense visited state.",
            "Maintain color frequencies and distinct-color count incrementally, preserving leaf-only evaluation, ascending roots, first-success termination, strict-greater incumbent updates and isolated-vertex behavior."
          ]
        },
        "tree_id": "e1:B",

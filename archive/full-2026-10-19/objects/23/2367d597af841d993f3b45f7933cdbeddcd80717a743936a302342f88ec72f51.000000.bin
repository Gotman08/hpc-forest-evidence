        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n#include <string.h>\n\n#define MAXNUM 100\n#define MAXSTR 50\n#define MAXRESULTS 1000\n\nchar firstHalf[MAXNUM][MAXSTR];\nchar secondHalf[MAXNUM][MAXSTR];\nchar strToTest[MAXSTR];\nlong int result[MAXRESULTS];\nint numPrimes = 0;\n\nstatic uint32_t candidates[MAXNUM * MAXNUM];\n\nstatic uint32_t integer_root(uint32_t value)\n{\n    uint32_t low = 0;\n    uint32_t high = 65536u;\n\n    while (low + 1u < high) {\n        uint32_t middle = low + (high - low) / 2u;\n        if ((uint64_t)middle * middle <= value)\n            low = middle;\n        else\n            high = middle;\n    }\n    return low;\n}\n\nstatic uint32_t odd_inverse(uint32_t divisor)\n{\n    /* An odd divisor is its own inverse modulo 8. Four Newton\n       steps extend that inverse to all 32 bits using unsigned wrap. */\n    uint32_t inverse = divisor;\n    inverse *= 2u - divisor * inverse;\n    inverse *= 2u - divisor * inverse;\n    inverse *= 2u - divisor * inverse;\n    inverse *= 2u - divisor * inverse;\n    return inverse;\n}\n\nstatic int collect_primes(uint32_t *values, int count)\n{\n    /* The square root of any uint32_t value is at most 65535. */\n    unsigned char composite[32768];\n    uint32_t maximum = 0;\n    int found = 0;\n    int i = 0;\n\n    while (i < count) {\n        uint32_t value = values[i];\n        if (value == 2u) {\n            result[found++] = 2;\n        } else if (value > 2u && (value & 1u)) {\n            if (value > maximum)\n                maximum = value;\n            ++i;\n            continue;\n        }\n        values[i] = values[--count];\n    }\n\n    if (count == 0)\n        return found;\n\n    uint32_t limit = integer_root(maximum);\n    memset(composite, 0, (size_t)(limit / 2u + 1u));\n\n    for (uint32_t divisor = 3u;\n         divisor <= limit && count != 0;\n         divisor += 2u) {\n        if (composite[divisor >> 1])\n            continue;\n\n        uint32_t square = (uint32_t)((uint64_t)divisor * divisor);\n        for (uint32_t multiple = square;\n             multiple <= limit;\n             multiple += 2u * divisor)\n            composite[multiple >> 1] = 1;\n\n        uint32_t inverse = odd_inverse(divisor);\n        uint32_t quotient_limit = UINT32_MAX / divisor;\n\n        /* Sweep the packed survivors with one shared divisor.\n           Swap-removal writes only when a candidate leaves the set. */\n        i = 0;\n        while (i < count) {\n            uint32_t value = values[i];\n            if (value < square) {\n                result[found++] = (long int)value;\n            } else if ((uint32_t)(value * inverse) > quotient_limit) {\n                /* For an odd divisor, divisibility is equivalent to\n                   low32(value * inverse) <= UINT32_MAX / divisor. */\n                ++i;\n                continue;\n            }\n            values[i] = values[--count];\n        }\n    }\n\n    for (i = 0; i < count; ++i)\n        result[found++] = (long int)values[i];\n    return found;\n}\n\nvoid quicksort(long int *primes, int first, int last)\n{\n    int i, j, pivot;\n    long int temp;\n\n    if (first < last) {\n        pivot = first;\n        i = first;\n        j = last;\n        while (i < j) {\n            while (primes[i] <= primes[pivot] && i < last)\n                i++;\n            while (primes[j] > primes[pivot])\n                j--;\n            if (i < j) {\n                temp = primes[i];\n                primes[i] = primes[j];\n                primes[j] = temp;\n            }\n        }\n        temp = primes[pivot];\n        primes[pivot] = primes[j];\n        primes[j] = temp;\n        quicksort(primes, first, j - 1);\n        quicksort(primes, j + 1, last);\n    }\n}\n\nint main(int argc, char **argv)\n{\n    FILE *primesFile;\n    int i = 0, j = 0, numResults = 0;\n    int numCandidates = 0;\n    long int primeToTest;\n\n    primesFile = stdin;\n    fscanf(primesFile, \"%d\\n\", &numPrimes);\n    for (i = 0; i < numPrimes; i++)\n        fscanf(primesFile, \"%s\\n\", firstHalf[i]);\n    for (i = 0; i < numPrimes; i++)\n        fscanf(primesFile, \"%s\\n\", secondHalf[i]);\n    fclose(primesFile);\n\n    for (i = 0; i < numPrimes; i++)\n        for (j = 0; j < numPrimes; j++) {\n            strcpy(strToTest, firstHalf[i]);\n            strcat(strToTest, secondHalf[j]);\n            primeToTest = atol(strToTest);\n            /* Certified concatenations fit in uint32_t. */\n            candidates[numCandidates++] = (uint32_t)primeToTest;\n        }\n\n    numResults = collect_primes(candidates, numCandidates);\n    quicksort(result, 0, numResults - 1);\n    for (i = 0; i < numResults; i++)\n        printf(\"%ld\\n\", result[i]);\n    return 0;\n}\n",
        "path": "src/model-view/primetest.c"

      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n#include <limits.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nenum {\n    BYTE_BUCKETS = 256,\n    INSERTION_CUTOFF = 24,\n    TASK_GRAIN = 16384,\n    PARALLEL_MIN = 32768\n};\n\nstatic void fail(const char *message) {\n    fprintf(stderr, \"%s\\n\", message);\n    exit(EXIT_FAILURE);\n}\n\nstatic void *checked_alloc(size_t count, size_t element_size) {\n    void *result;\n    if (element_size != 0 && count > SIZE_MAX / element_size)\n        fail(\"Allocation size overflow\");\n    result = malloc(count * element_size);\n    if (result == NULL && count != 0 && element_size != 0)\n        fail(\"Allocation failed\");\n    return result;\n}\n\nstatic void insertion_sort(const char *strings, size_t stride,\n                           long int *index, size_t first, size_t count) {\n    size_t end = first + count;\n    for (size_t j = first + 1; j < end; ++j) {\n        long int key = index[j];\n        const char *text = strings + (size_t)key * stride;\n        size_t i = j;\n        while (i > first &&\n               strcmp(strings + (size_t)index[i - 1] * stride, text) > 0) {\n            index[i] = index[i - 1];\n            --i;\n        }\n        index[i] = key;\n    }\n}\n\nstatic void merge_sorted_ranges(const char *strings, size_t stride,\n                                long int *index, long int *scratch,\n                                size_t first, size_t count) {\n    size_t middle = first + count / 2;\n    size_t end = first + count;\n    size_t left = first;\n    size_t right = middle;\n    size_t out = first;\n\n    if (strcmp(strings + (size_t)index[middle - 1] * stride,\n               strings + (size_t)index[middle] * stride) <= 0)\n        return;\n\n    while (left < middle && right < end) {\n        if (strcmp(strings + (size_t)index[left] * stride,\n                   strings + (size_t)index[right] * stride) <= 0)\n            scratch[out++] = index[left++];\n        else\n            scratch[out++] = index[right++];\n    }\n    while (left < middle)\n        scratch[out++] = index[left++];\n    while (right < end)\n        scratch[out++] = index[right++];\n    memcpy(index + first, scratch + first, count * sizeof(*index));\n}\n\nstatic void sort_range_serial(const char *strings, size_t stride,\n                              long int *index, long int *scratch,\n                              size_t first, size_t count) {\n    size_t left_count;\n    if (count <= INSERTION_CUTOFF) {\n        insertion_sort(strings, stride, index, first, count);\n        return;\n    }\n    left_count = count / 2;\n    sort_range_serial(strings, stride, index, scratch, first, left_count);\n    sort_range_serial(strings, stride, index, scratch,\n                      first + left_count, count - left_count);\n    merge_sorted_ranges(strings, stride, index, scratch, first, count);\n}\n\n#ifdef _OPENMP\nstatic void sort_range_tasks(const char *strings, size_t stride,\n                             long int *index, long int *scratch,\n                             size_t first, size_t count) {\n    size_t left_count;\n    size_t right_first;\n    size_t right_count;\n    if (count <= TASK_GRAIN) {\n        sort_range_serial(strings, stride, index, scratch, first, count);\n        return;\n    }\n    left_count = count / 2;\n    right_first = first + left_count;\n    right_count = count - left_count;\n\n    #pragma omp task firstprivate(strings, stride, index, scratch, first, left_count)\n    {\n        sort_range_tasks(strings, stride, index, scratch, first, left_count);\n    }\n    #pragma omp task firstprivate(strings, stride, index, scratch, right_first, right_count)\n    {\n        sort_range_tasks(strings, stride, index, scratch,\n                         right_first, right_count);\n    }\n    #pragma omp taskwait\n    merge_sorted_ranges(strings, stride, index, scratch, first, count);\n}\n#endif\n\nlong int *bucket_sort(char *a, int length, long int size,\n                      int offset, int nbuckets) {\n    size_t counts[BYTE_BUCKETS] = {0};\n    size_t starts[BYTE_BUCKETS + 1];\n    size_t next[BYTE_BUCKETS];\n    size_t n;\n    size_t stride;\n    long int *returns;\n    long int *scratch;\n\n    /* Full-byte buckets preserve strcmp order without capacity assumptions. */\n    (void)offset;\n    (void)nbuckets;\n    if (length <= 0 || size < 0 ||\n        (uintmax_t)size > (uintmax_t)SIZE_MAX)\n        fail(\"Invalid sorting dimensions\");\n    n = (size_t)size;\n    stride = (size_t)length;\n    if (n == 0)\n        return NULL;\n    if (n > SIZE_MAX / stride)\n        fail(\"String size overflow\");\n\n    returns = (long int *)checked_alloc(n, sizeof(*returns));\n    if (n == 1) {\n        returns[0] = 0;\n        return returns;\n    }\n    scratch = (long int *)checked_alloc(n, sizeof(*scratch));\n\n    for (size_t i = 0; i < n; ++i)\n        ++counts[(unsigned char)a[i * stride]];\n    starts[0] = 0;\n    for (size_t b = 0; b < BYTE_BUCKETS; ++b) {\n        starts[b + 1] = starts[b] + counts[b];\n        next[b] = starts[b];\n    }\n    for (size_t i = 0; i < n; ++i) {\n        unsigned char key = (unsigned char)a[i * stride];\n        returns[next[key]++] = (long int)i;\n    }\n\n#ifdef _OPENMP\n    if (n >= PARALLEL_MIN && omp_get_max_threads() > 1 && !omp_in_parallel()) {\n        #pragma omp parallel\n        {\n            #pragma omp single nowait\n            {\n                for (size_t b = 0; b < BYTE_BUCKETS; ++b) {\n                    size_t first = starts[b];\n                    size_t count = counts[b];\n                    if (count > 1) {\n                        #pragma omp task firstprivate(a, stride, returns, scratch, first, count)\n                        {\n                            sort_range_tasks(a, stride, returns, scratch,\n                                             first, count);\n                        }\n                    }\n                }\n            }\n        }\n    } else\n#endif\n    {\n        for (size_t b = 0; b < BYTE_BUCKETS; ++b) {\n            if (counts[b] > 1)\n                sort_range_serial(a, stride, returns, scratch,\n                                  starts[b], counts[b]);\n        }\n    }\n\n    free(scratch);\n    return returns;\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb) {\n    char *strings;\n    char scan_format[32];\n    int len;\n    int offset;\n    int nbucket;\n    long int n;\n\n    if (fscanf(stdin, \"%d\", &len) != 1) {\n        printf(\"ERROR len\\n\");\n        exit(EXIT_FAILURE);\n    }\n    if (fscanf(stdin, \"%ld\", &n) != 1) {\n        printf(\"ERROR n\\n\");\n        exit(EXIT_FAILURE);\n    }\n    if (fscanf(stdin, \"%d\", &offset) != 1) {\n        printf(\"ERROR offset\\n\");\n        exit(EXIT_FAILURE);\n    }\n    if (fscanf(stdin, \"%d\", &nbucket) != 1) {\n        printf(\"ERROR nbucket\\n\");\n        exit(EXIT_FAILURE);\n    }\n    if (n < 0 || len < 0 || len == INT_MAX ||\n        nbucket < 0 || nbucket == INT_MAX || (n > 0 && len == 0))\n        fail(\"Invalid input dimensions\");\n    if ((uintmax_t)n > (uintmax_t)SIZE_MAX)\n        fail(\"Input size overflow\");\n\n    ++nbucket;\n    ++len;\n    strings = (char *)checked_alloc((size_t)n, (size_t)len);\n    if (n > 0) {\n        snprintf(scan_format, sizeof(scan_format), \"%%%ds\", len - 1);\n        for (long int i = 0; i < n; ++i) {\n            if (fscanf(stdin, scan_format,\n                       strings + (size_t)i * (size_t)len) != 1) {\n                printf(\"ERROR %ld\\n\", i);\n                free(strings);\n                exit(EXIT_FAILURE);\n            }\n        }\n    }\n\n    *vString = strings;\n    *N = n;\n    *l = len;\n    *os = offset;\n    *nb = nbucket;\n}\n\nvoid print(char *strings, long int *index, long int n, int len) {\n    for (long int i = 0; i < n; ++i)\n        printf(\"%ld -> %s\\n\", i,\n               strings + (size_t)index[i] * (size_t)len);\n}\n\nvoid save(char *strings, long int *index, long int n, int len) {\n    for (long int i = 0; i < n; ++i)\n        printf(\"%s\\n\", strings + (size_t)index[i] * (size_t)len);\n}\n\nint main(int ac, char **av) {\n    char *strings = NULL;\n    long int N = 0;\n    long int *index = NULL;\n    int len = 0;\n    int offset = 0;\n    int nbuckets = 0;\n    (void)ac;\n    (void)av;\n\n    load(&strings, &N, &len, &offset, &nbuckets);\n    index = bucket_sort(strings, len, N, offset, nbuckets);\n    save(strings, index, N, len);\n    free(strings);\n    free(index);\n    return EXIT_SUCCESS;\n}\n",
      "path": "src/bucketsort.c"
    }

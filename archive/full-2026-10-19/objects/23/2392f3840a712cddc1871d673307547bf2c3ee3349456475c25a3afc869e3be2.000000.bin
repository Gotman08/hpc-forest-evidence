    {
      "content": "#include <algorithm>\n#include <array>\n#include <cstddef>\n#include <cstring>\n#include <functional>\n#include <iostream>\n#include <iterator>\n#include <string>\n#include <utility>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\nstruct PrintPermutation\n{\n    PrintPermutation () : used_ (0) {}\n    PrintPermutation (PrintPermutation const&) = delete ;\n    auto operator = (PrintPermutation const&) -> PrintPermutation& = delete ;\n\n    ~PrintPermutation ()\n    {\n        flush () ;\n    }\n\n    auto flush () -> void\n    {\n        if (used_ != 0) {\n            std::cout.write\n                ( buffer_.data ()\n                , static_cast<std::streamsize> (used_) ) ;\n            used_ = 0 ;\n        }\n    }\n\n    auto print_all (std::string text) -> void ;\n\n    auto operator ()\n        ( std::string::const_iterator first\n        , std::string::const_iterator last ) -> void\n    {\n        append_pair ('[', ' ') ;\n        if (first != last) {\n            char const* source = &*first ;\n            std::size_t remaining = static_cast<std::size_t> (last - first) ;\n            while (remaining != 0) {\n                if (buffer_.size () - used_ < 2) flush () ;\n                std::size_t count = std::min\n                    ( remaining, (buffer_.size () - used_) / 2 ) ;\n                pack_symbols (source, buffer_.data () + used_, count) ;\n                used_ += 2 * count ;\n                source += count ;\n                remaining -= count ;\n            }\n        }\n        append_pair (']', '\\n') ;\n    }\n\nprivate:\n    auto append_pair (char first, char second) -> void\n    {\n        if (buffer_.size () - used_ < 2) flush () ;\n        buffer_ [used_ ++] = first ;\n        buffer_ [used_ ++] = second ;\n    }\n\n    auto append_preformatted\n        (char const* source, std::size_t count) -> void\n    {\n        if (count <= buffer_.size () - used_) {\n            std::memcpy (buffer_.data () + used_, source, count) ;\n            used_ += count ;\n            return ;\n        }\n        flush () ;\n        while (count > buffer_.size ()) {\n            std::cout.write\n                ( source\n                , static_cast<std::streamsize> (buffer_.size ()) ) ;\n            source += buffer_.size () ;\n            count -= buffer_.size () ;\n        }\n        std::memcpy (buffer_.data (), source, count) ;\n        used_ = count ;\n    }\n\n    static auto format_in_place\n        (std::string& text, std::size_t count) -> void\n    {\n        text.resize (2 * count + 4) ;\n        std::size_t remaining = count ;\n#if defined(__aarch64__)\n        uint8x8_t spaces = vdup_n_u8 (static_cast<unsigned char> (' ')) ;\n        // Expand backward, loading each block before its overlapping store.\n        while (remaining >= 8) {\n            remaining -= 8 ;\n            uint8x8x2_t pairs ;\n            pairs.val [0] = vld1_u8\n                (reinterpret_cast<unsigned char const*> (text.data () + remaining)) ;\n            pairs.val [1] = spaces ;\n            vst2_u8\n                ( reinterpret_cast<unsigned char*> (&text [2 + 2 * remaining])\n                , pairs ) ;\n        }\n#endif\n        while (remaining != 0) {\n            -- remaining ;\n            char symbol = text [remaining] ;\n            text [2 + 2 * remaining] = symbol ;\n            text [3 + 2 * remaining] = ' ' ;\n        }\n        text [0] = '[' ;\n        text [1] = ' ' ;\n        text [2 * count + 2] = ']' ;\n        text [2 * count + 3] = '\\n' ;\n    }\n\n    static auto next_preformatted\n        (char* symbols, std::size_t count) -> bool\n    {\n        if (count < 2) return false ;\n        std::size_t last = 2 * (count - 1) ;\n        std::size_t suffix = last ;\n        while (suffix != 0 && symbols [suffix - 2] >= symbols [suffix]) {\n            suffix -= 2 ;\n        }\n        if (suffix == 0) return false ;\n\n        std::size_t pivot = suffix - 2 ;\n        char pivot_value = symbols [pivot] ;\n        std::size_t successor = last ;\n        while (symbols [successor] <= pivot_value) {\n            successor -= 2 ;\n        }\n        std::swap (symbols [pivot], symbols [successor]) ;\n\n        // Only symbol positions change; all formatting bytes remain fixed.\n        while (suffix < last) {\n            std::swap (symbols [suffix], symbols [last]) ;\n            suffix += 2 ;\n            last -= 2 ;\n        }\n        return true ;\n    }\n\n    static auto pack_symbols\n        ( char const* source\n        , char* destination\n        , std::size_t count ) -> void\n    {\n        std::size_t i = 0 ;\n#if defined(__aarch64__)\n        uint8x8_t spaces = vdup_n_u8 (static_cast<unsigned char> (' ')) ;\n        for (; i + 8 <= count; i += 8) {\n            uint8x8x2_t pairs ;\n            pairs.val [0] = vld1_u8\n                (reinterpret_cast<unsigned char const*> (source + i)) ;\n            pairs.val [1] = spaces ;\n            vst2_u8\n                ( reinterpret_cast<unsigned char*> (destination + 2 * i)\n                , pairs ) ;\n        }\n#endif\n        for (; i < count; ++ i) {\n            destination [2 * i] = source [i] ;\n            destination [2 * i + 1] = ' ' ;\n        }\n    }\n\n    std::array<char, 64 * 1024> buffer_ ;\n    std::size_t used_ ;\n} ;\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ' )\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v') ;\n    }\n} ;\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase\n        ( std::remove_if\n            ( text.begin ()\n            , text.end ()\n            , IsWhitespace () )\n        , text.end () ) ;\n    return text ;\n}\n\ntemplate <typename Iter> auto\nfind_longest_non_increasing_suffix (Iter first, Iter last) -> Iter\n{\n    if (first == last) return last ;\n    Iter back = std::prev (last) ;\n    if (back == first) return last ;\n    do {\n        -- last ;\n        if (last == first) break ;\n        -- back ;\n    } while (*back >= *last) ;\n    return last ;\n}\n\ntemplate <typename Iter> auto\nfind_rightmost_successor (Iter first, Iter second, Iter last) -> Iter\n{\n    if (second == last) return last ;\n    do {\n        -- last ;\n    } while ((second != last) && (*last <= *first)) ;\n    return last ;\n}\n\ntemplate <typename Iter> auto\nnext_permutation (Iter first, Iter last) -> bool\n{\n    if (first == last) return false ;\n    Iter suffix = find_longest_non_increasing_suffix (first, last) ;\n    if (suffix == first) return false ;\n    if (suffix == last)  return false ;\n    Iter pivot = std::prev (suffix) ;\n    Iter successor = find_rightmost_successor (pivot, suffix, last) ;\n    std::iter_swap (pivot, successor) ;\n    std::reverse (suffix, last) ;\n    return true ;\n}\n\ntemplate <typename Iter, typename Function> inline auto\npermutations_iter (Iter first, Iter last, Function driver) -> void\n{\n    if (first == last) return ;\n    std::sort (first, last) ;\n    do {\n        driver (first, last) ;\n    } while (::next_permutation (first, last)) ;\n    return ;\n}\n\ntemplate <typename String, typename Function> inline auto\npermutations (String text, Function driver) -> void\n{\n    permutations_iter (std::begin (text), std::end (text), driver) ;\n}\n\nauto PrintPermutation::print_all (std::string text) -> void\n{\n    if (text.empty ()) return ;\n    std::size_t count = text.size () ;\n    if (count > (text.max_size () - 4) / 2) {\n        permutations_iter (text.begin (), text.end (), std::ref (*this)) ;\n        return ;\n    }\n    std::sort (text.begin (), text.end ()) ;\n    format_in_place (text, count) ;\n    char* symbols = &text [2] ;\n    do {\n        append_preformatted (text.data (), text.size ()) ;\n    } while (next_preformatted (symbols, count)) ;\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator <char> begin (in), end ;\n    std::string text (begin, end) ;\n    text = remove_whitespaces (text) ;\n    return text ;\n}\n\nint main (int argc, char const *argv [])\n{\n    std::string text = read_text_from_stdin <std::string> (std::cin) ;\n    PrintPermutation printer ;\n    printer.print_all (std::move (text)) ;\n    printer.flush () ;\n    return 0 ;\n}\n",
      "path": "src/permutations.cc"
    }

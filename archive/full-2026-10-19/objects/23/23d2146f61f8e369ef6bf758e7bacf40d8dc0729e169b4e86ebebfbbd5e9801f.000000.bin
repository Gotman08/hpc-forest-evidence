#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include <immintrin.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors
#define SIMD_WIDTH 8 // AVX width

/*
 * Each body holds coordinate positions (i.e., x, y, and z) and
 * velocities (i.e., vx, vy, and vz).
 */
typedef struct { float x, y, z, vx, vy, vz; } Body;

/*
 * Compute the gravitational impact among all pairs of bodies in 
 * the system.
 */
void body_force(Body *p, float dt, int n) {
  for (int i = 0; i < n; i += SIMD_WIDTH) {
    __m256 fx = _mm256_setzero_ps();
    __m256 fy = _mm256_setzero_ps();
    __m256 fz = _mm256_setzero_ps();

    for (int j = 0; j < n; j++) {
      __m256 dx = _mm256_set1_ps(p[j].x);
      __m256 dy = _mm256_set1_ps(p[j].y);
      __m256 dz = _mm256_set1_ps(p[j].z);

      __m256 px = _mm256_loadu_ps(&p[i].x);
      __m256 py = _mm256_loadu_ps(&p[i].y);
      __m256 pz = _mm256_loadu_ps(&p[i].z);

      __m256 dx_diff = _mm256_sub_ps(dx, px);
      __m256 dy_diff = _mm256_sub_ps(dy, py);
      __m256 dz_diff = _mm256_sub_ps(dz, pz);

      __m256 sqrd_dist = _mm256_add_ps(_mm256_add_ps(_mm256_mul_ps(dx_diff, dx_diff), _mm256_mul_ps(dy_diff, dy_diff)), _mm256_mul_ps(dz_diff, dz_diff));
      __m256 inv_dist = _mm256_rsqrt_ps(_mm256_add_ps(sqrd_dist, _mm256_set1_ps(SOFTENING)));
      __m256 inv_dist3 = _mm256_mul_ps(_mm256_mul_ps(inv_dist, inv_dist), inv_dist);

      fx = _mm256_add_ps(fx, _mm256_mul_ps(dx_diff, inv_dist3));
      fy = _mm256_add_ps(fy, _mm256_mul_ps(dy_diff, inv_dist3));
      fz = _mm256_add_ps(fz, _mm256_mul_ps(dz_diff, inv_dist3));
    }

    _mm256_storeu_ps(&p[i].vx, _mm256_add_ps(_mm256_loadu_ps(&p[i].vx), _mm256_mul_ps(fx, _mm256_set1_ps(dt))));
    _mm256_storeu_ps(&p[i].vy, _mm256_add_ps(_mm256_loadu_ps(&p[i].vy), _mm256_mul_ps(fy, _mm256_set1_ps(dt))));
    _mm256_storeu_ps(&p[i].vz, _mm256_add_ps(_mm256_loadu_ps(&p[i].vz), _mm256_mul_ps(fz, _mm256_set1_ps(dt))));
  }
}

/*
 * Read a binary dataset with initilized bodies.
 */
Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  return bodies;
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc,char **argv) {
  int nbodies;

  Body *bodies = read_dataset(&nbodies);

  /*
   * At each simulation iteration, interbody forces are computed,
   * and bodies' positions are integrated.
   */
  for (int iter = 0; iter < N_ITER; iter++) {
    body_force(bodies, DT, nbodies);

    for (int i = 0; i < nbodies; i++) {
      bodies[i].x += bodies[i].vx * DT;
      bodies[i].y += bodies[i].vy * DT;
      bodies[i].z += bodies[i].vz * DT;
    }
  }

  write_dataset(nbodies, bodies);

  free(bodies);
  
  exit(EXIT_SUCCESS);
}
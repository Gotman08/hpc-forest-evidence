#include <iostream>
#include <vector>
#include <cstdio>
#include <algorithm>
#include <climits>

int main() {
	int n, s;
	std::cin >> n >> s;
	std::vector<std::vector<int>> matrix(n, std::vector<int>(n));
	for (int i = 0; i < n; ++i)
		for (int j = 0; j < n; ++j)
			scanf("%d", &matrix[i][j]);

	// Column sums of the first S rows
	std::vector<long long> colSum(n);
	#pragma omp simd
	for (int j = 0; j < n; ++j) colSum[j] = matrix[0][j];
	for (int i = 1; i < s; ++i) {
		#pragma omp simd
		for (int j = 0; j < n; ++j) colSum[j] += matrix[i][j];
	}

	long long mxSum = LLONG_MIN;

	// Slide the vertical window down one row at a time
	for (int top = 0; top + s <= n; ++top) {
		// Horizontal sliding window of length S over colSum
		long long window = 0;
		for (int j = 0; j < s; ++j) window += colSum[j];
		long long best = window;
		for (int j = s; j < n; ++j) {
			window += colSum[j] - colSum[j - s];
			if (window > best) best = window;
		}
		if (best > mxSum) mxSum = best;

		// Move the vertical window down by one row
		if (top + s < n) {
			#pragma omp simd
			for (int j = 0; j < n; ++j) {
				colSum[j] += matrix[top + s][j] - matrix[top][j];
			}
		}
	}

	printf("%lld\n", mxSum);
	return 0;
}

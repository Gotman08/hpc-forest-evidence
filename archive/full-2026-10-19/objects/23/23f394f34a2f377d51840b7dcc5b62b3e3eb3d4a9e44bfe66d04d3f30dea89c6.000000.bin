      "type": "text",
      "text": "{\n  \"ok\": true,\n  \"plan_id\": \"6aa237e7903f46839ff1702ae21b433d\",\n  \"plan_sha256\": \"d835b1561313743a009be9a7b53320f66940f31b8d3dbb977d6d0caa16db81e1\",\n  \"created_at\": 1792354765.5254638,\n  \"expires_at\": 1792441165.5254638,\n  \"expired\": false,\n  \"state\": \"ready\",\n  \"result\": null,\n  \"plan\": {\n    \"entries\": [\n      {\n        \"plan\": {\n          \"arch\": \"armgpu\",\n          \"partition\": \"instant\",\n          \"script\": \"#!/usr/bin/env bash\\n# Genere par romeo-mcp - ne pas editer a la main.\\n#SBATCH --job-name=forest-r4b-r7-roots-original-sha\\n#SBATCH --account=r250127\\n#SBATCH --qos=normal\\n#SBATCH --partition=instant\\n#SBATCH --constraint=armgpu\\n#SBATCH --time=00:01:00\\n#SBATCH --nodes=1\\n#SBATCH --ntasks-per-node=1\\n#SBATCH --cpus-per-task=1\\n#SBATCH --mem=1G\\n#SBATCH --chdir=/scratch_p/nimarano\\n#SBATCH --output=/scratch_p/nimarano/%x-%j.out\\n#SBATCH --error=/scratch_p/nimarano/%x-%j.err\\n\\nset -euo pipefail\\n\\n# Sans cette fonction, un job ROMEO 2025 n'a acces a aucun logiciel,\\n# pas meme a la commande spack. Elle est propre a l'architecture :\\n# charger celle de l'autre donnerait des binaires inutilisables.\\nromeo_load_armgpu_env\\n\\n# Provenance du premier demarrage : environnement, commit et fichiers choisis.\\nif command -v python3 >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then\\n  if timeout 20s python3 -I -S - '{\\\"roots\\\": [\\\"/scratch_p/nimarano\\\", \\\"/project\\\"], \\\"include_home\\\": true, \\\"code_dir\\\": \\\"/scratch_p/nimarano\\\", \\\"data_files\\\": [], \\\"max_bytes\\\": 67108864}' <<'ROMEO_REPRO_CAPTURE'\\n\\nimport hashlib, json, os, pathlib, re, stat, subprocess, sys\\nparams = json.loads(sys.argv[1])\\nroots = [pathlib.Path(p).resolve() for p in params['roots']]\\nif params.get('include_home'):\\n    roots.append(pathlib.Path.home().resolve())\\ndef allowed(value):\\n    path = pathlib.Path(value).resolve()\\n    if not any(path == root or root in path.parents for root in roots):\\n        raise ValueError('outside_roots')\\n    if any(p.lower().startswith(('.env', 'id_rsa', 'id_ed25519', 'id_ecdsa')) or p.lower() in ('.ssh', '.aws', '.azure', '.kube', 'hosts.yml')\\n           or p.lower().endswith(('.pem', '.key', '.p12', '.pfx'))\\n           or re.search(r'password|passwd|passphrase|secret|token|credential|authorization|cookie|api[_-]?key|access[_-]?key|private[_-]?key', p, re.I)\\n           for p in path.parts):\\n        raise ValueError('sensitive_path')\\n    return path\\nout = {'git': {'status': 'unavailable'}, 'data': []}\\ntry:\\n    code = allowed(params['code_dir'])\\n    result = subprocess.run(['git', '-c', 'core.fsmonitor=false', '-C', str(code),\\n                             'rev-parse', '--verify', 'HEAD'],\\n                            capture_output=True, text=True, timeout=5,\\n                            env={**os.environ, 'GIT_OPTIONAL_LOCKS': '0'})\\n    sha = result.stdout.strip()\\n    if result.returncode == 0 and len(sha) in (40, 64) and all(c in '0123456789abcdef' for c in sha):\\n        out['git'] = {'status': 'observed', 'commit': sha, 'working_tree_verified': False}\\nexcept (OSError, ValueError, subprocess.TimeoutExpired):\\n    pass\\nremaining = params['max_bytes']\\nfor name in params['data_files']:\\n    item = {'path': name}\\n    try:\\n        path = allowed(name)\\n        info = path.stat()\\n        if not stat.S_ISREG(info.st_mode):\\n            item['status'] = 'not_regular_file'\\n        elif info.st_size > remaining:\\n            item.update(status='size_limit', bytes=info.st_size)\\n        else:\\n            h = hashlib.sha256()\\n            consumed = 0\\n            with path.open('rb') as stream:\\n                while True:\\n                    block = stream.read(min(1048576, remaining - consumed + 1))\\n                    if not block:\\n                        break\\n                    consumed += len(block)\\n                    if consumed > remaining:\\n                        break\\n                    h.update(block)\\n            after = path.stat()\\n            remaining = max(0, remaining - consumed)\\n            if consumed != info.st_size or (info.st_size, info.st_mtime_ns, info.st_ino) != (after.st_size, after.st_mtime_ns, after.st_ino):\\n                item['status'] = 'changed_during_read'\\n            else:\\n                item.update(status='hashed', sha256=h.hexdigest(), bytes=consumed)\\n    except (OSError, ValueError):\\n        item['status'] = 'unreadable_or_outside_roots'\\n    out['data'].append(item)\\n\\n\\nimport datetime, platform\\nout['observed_at'] = datetime.datetime.now(datetime.timezone.utc).isoformat()\\nout['phase'] = 'before_workload'\\nout['environment'] = {\\n    'source': 'compute_node_before_command', 'architecture': platform.machine(),\\n    'python_version': platform.python_version(),\\n    'loaded_modules': [v for v in os.environ.get('LOADEDMODULES', '').split(':') if v][:128],\\n    'spack_loaded_hashes': [v for v in os.environ.get('SPACK_LOADED_HASHES', '').split(':') if v][:128],\\n}\\njid = os.environ.get('SLURM_JOB_ID', '')\\nif os.environ.get('SLURM_ARRAY_JOB_ID') and os.environ.get('SLURM_ARRAY_TASK_ID'):\\n    jid = os.environ['SLURM_ARRAY_JOB_ID'] + '_' + os.environ['SLURM_ARRAY_TASK_ID']\\nif not re.fullmatch(r'[0-9]+(?:_[0-9]+)?', jid):\\n    raise ValueError('missing_job_id')\\nout['job_id'] = jid\\nfolder = pathlib.Path('.romeo-provenance')\\nfolder.mkdir(mode=0o700, exist_ok=True)\\nif folder.is_symlink():\\n    raise ValueError('symlink_capture_directory')\\nout['restart_count'] = os.environ.get('SLURM_RESTART_COUNT', '0')\\ntry:\\n    fd = os.open(folder / (jid + '.json'), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)\\nexcept FileExistsError:\\n    pass\\nelse:\\n    with os.fdopen(fd, 'w') as stream:\\n        json.dump(out, stream)\\n        stream.write('\\\\n')\\nROMEO_REPRO_CAPTURE\\n  then :; else\\n    printf '%s\\\\n' '[romeo-mcp] provenance indisponible ; le calcul continue.' >&2\\n  fi\\nfi\\n\\n\\n# Trace d'execution : sert a diagnostiquer les erreurs d'architecture.\\necho \\\"[romeo-mcp] noeud=$(hostname) arch=$(uname -m) job=${SLURM_JOB_ID:-?}\\\"\\necho \\\"[romeo-mcp] debut $(date -Is)\\\"\\n\\nset -euo pipefail\\n/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python -I -S - <<'HASH_ONLY_R7'\\n\\\"\\\"\\\"Allocated read/hash of exactly three ORIGINAL terminal archives; never extract or write.\\\"\\\"\\\"\\nimport hashlib\\nimport json\\nimport os\\nfrom pathlib import PurePosixPath\\nimport platform\\nimport re\\nimport stat\\nimport time\\nfrom datetime import UTC, datetime\\n\\nRECORDS = [{'job_id': '754549', 'session_id': '80d47d8d3f8f4e35bc26ceb54d06e870', 'model': 'gpt-6.1-sol', 'path': '/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-80d47d8d3f8f4e35bc26ceb54d06e870/contract-results-754549.tar.gz'}, {'job_id': '754550', 'session_id': '29583a77237e4777aa09209331ec7ecd', 'model': 'gpt-6-astra', 'path': '/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-29583a77237e4777aa09209331ec7ecd/contract-results-754550.tar.gz'}, {'job_id': '754552', 'session_id': '3ae8341d27784c1bbd830ac19e4b77bc', 'model': 'gpt-5.6-terra', 'path': '/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-3ae8341d27784c1bbd830ac19e4b77bc/contract-results-754552.tar.gz'}]\\nMAX_BYTES_PER_ARCHIVE = 512 * 1024**2\\nDEADLINE = datetime(2026, 10, 31, 23, 0, tzinfo=UTC).timestamp()\\n\\n\\ndef need(ok, message):\\n    if not ok:\\n        raise ValueError(message)\\n\\n\\ndef file_identity(facts):\\n    return (facts.st_dev, facts.st_ino, facts.st_mode, facts.st_nlink,\\n            facts.st_size, facts.st_mtime_ns, facts.st_ctime_ns)\\n\\n\\ndef directory_identity(facts):\\n    need(stat.S_ISDIR(facts.st_mode), \\\"Only no-follow ordinary directory handles\\\")\\n    return (facts.st_dev, facts.st_ino, facts.st_mode)\\n\\n\\ndef hash_exact_archive(row):\\n    path = PurePosixPath(row['path'])\\n    need(path.is_absolute() and '..' not in path.parts and path.parts[:3] == ('/', 'scratch_p', 'nimarano'),\\n         'Exact original scratch archive path')\\n    need(path.name == 'contract-results-' + row['job_id'] + '.tar.gz'\\n         and path.parent.name == 'hpc-forest-dynamic-r4b-max-' + row['session_id'], 'Exact closed job/session archive binding')\\n    need(all(hasattr(os, name) for name in ('O_DIRECTORY', 'O_NOFOLLOW', 'O_CLOEXEC', 'O_NONBLOCK')),\\n         'POSIX held no-follow API required; no fallback')\\n    directories = []\\n    fd = None\\n    try:\\n        current = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)\\n        directories.append((current, None, None, directory_identity(os.fstat(current))))\\n        for name in path.parts[1:-1]:\\n            child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=current)\\n            facts = directory_identity(os.fstat(child))\\n            directories.append((child, current, name, facts))\\n            current = child\\n        before = os.stat(path.name, dir_fd=current, follow_symlinks=False)\\n        need(stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and 0 < before.st_size <= MAX_BYTES_PER_ARCHIVE,\\n             'Bounded single-link original regular archive required')\\n        baseline = file_identity(before)\\n        fd = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=current)\\n        need(file_identity(os.fstat(fd)) == baseline, 'Archive path/held identity differs before read')\\n        checksum = hashlib.sha256()\\n        count = 0\\n        while True:\\n            block = os.read(fd, min(1024**2, MAX_BYTES_PER_ARCHIVE - count + 1))\\n            if not block:\\n                break\\n            count += len(block)\\n            need(count <= MAX_BYTES_PER_ARCHIVE, 'Archive exceeded its fixed read bound')\\n            checksum.update(block)\\n        need(count == before.st_size and file_identity(os.fstat(fd)) == baseline\\n             and file_identity(os.stat(path.name, dir_fd=current, follow_symlinks=False)) == baseline,\\n             'Original archive changed while hashing; no announcement promoted')\\n        for child, parent, name, facts in directories:\\n            need(directory_identity(os.fstat(child)) == facts, 'Held parent identity changed')\\n            if parent is not None:\\n                need(directory_identity(os.stat(name, dir_fd=parent, follow_symlinks=False)) == facts,\\n                     'Original literal directory entry no longer matches its held parent chain')\\n        return {**row, 'sha256': checksum.hexdigest(), 'bytes': count,\\n                'original_bytes_unchanged': True, 'held_no_follow_file_and_parent_chain': True}\\n    finally:\\n        if fd is not None:\\n            os.close(fd)\\n        for child, _parent, _name, _facts in reversed(directories):\\n            os.close(child)\\n\\n\\ndef main():\\n    need(platform.machine().lower() in {'aarch64', 'arm64'}, 'Actual ARM allocation required')\\n    job = os.environ.get('SLURM_JOB_ID', '')\\n    need(re.fullmatch('[0-9]+', job) is not None and job not in {row['job_id'] for row in RECORDS},\\n         'New actual allocation job ID required, never a source root replay')\\n    need(os.environ.get('SLURM_CPUS_PER_TASK') == '1', 'Exactly one requested CPU per task')\\n    need(time.time() + 60 + 10800 < DEADLINE, 'One-minute maximum plus three-hour audit reserve must fit strictly before deadline')\\n    records = [hash_exact_archive(row) for row in RECORDS]\\n    print(json.dumps({'schema': 'hpc-forest-r7-original-terminal-archives-hash-announcement-v1',\\n        'verified_readonly_hashes': True, 'observed_at': time.time(),\\n        'observed_at_utc': datetime.now(UTC).isoformat(), 'allocation_job_id': job,\\n        'native_model_calls_by_hash_workload': 0, 'tests_or_compilations_replayed': 0,\\n        'source_roots_call_count
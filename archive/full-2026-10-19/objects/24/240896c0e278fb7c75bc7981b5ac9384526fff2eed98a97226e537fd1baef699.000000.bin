{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"/*\\n  Quicksort\\n*/\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <limits.h>\\n#include <openssl/md5.h>\\n\\n/*\\n * Prototypes\\n */\\nvoid srandnum(int seed);\\ndouble randnum(void);\\nint *generate_case(int N);\\ndouble drand(int xmin, int xmax);\\nvoid swap(int *toorder, int i, int j);\\nint partition(int *toorder, int lo, int hi);\\nvoid _quicksort(int *toorder, int lo, int hi);\\nvoid quicksort(int *toorder, int N);\\nint is_sorted(int *toorder, int N);\\nstatic void _quicksort_seeded(int *toorder, int lo, int hi,\\n                              unsigned int seed, int allow_tasks);\\nstatic unsigned int next_pivot_random(unsigned int *state);\\nstatic unsigned int derive_seed(unsigned int value);\\nstatic void insertion_sort(int *toorder, int lo, int hi);\\n\\n/*\\n * A generic pRNG\\n */\\n#define MY_RAND_MAX 0x7FFFFFFF\\n\\n#define RANDNUM_W 521288629\\n#define RANDNUM_Z 362436069\\n\\n#define INSERTION_CUTOFF 24\\n#define TASK_CUTOFF 8192\\n#define PARALLEL_CUTOFF 65536\\n\\nunsigned int randum_w = RANDNUM_W;\\nunsigned int randum_z = RANDNUM_Z;\\n\\nvoid srandnum(int seed)\\n{\\n    unsigned int w, z;\\n    w = (seed * 104623) & 0xffffffff;\\n    randum_w = (w) ? w : RANDNUM_W;\\n    z = (seed * 48947) & 0xffffffff;\\n    randum_z = (z) ? z : RANDNUM_Z;\\n}\\n\\ndouble randnum(void)\\n{\\n    unsigned int u;\\n    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);\\n    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);\\n    u = (randum_z << 16) + randum_w;\\n    return (abs(u));\\n}\\n\\n/*\\n * Main function\\n */\\nint main(int argc, char *argv[])\\n{\\n    int N = 0;\\n    int *our_list = NULL;\\n\\n    //The input provides the case size\\n    scanf(\\\"%d\\\", &N);\\n    if (N <= 0) {\\n        printf(\\\"Error: please, provide the case size.\\\\n\\\");\\n        return 1;\\n    }\\n\\n    //Generate the case\\n    our_list = generate_case(N);\\n    if (our_list == NULL) {\\n        printf(\\\"Error: case instantiation failed.\\\\n\\\");\\n        return 1;\\n    }\\n\\n    //Do the thing\\n    quicksort(our_list, N);\\n\\n    if (is_sorted(our_list, N) == 1) {\\n        printf(\\\"Error, for some reason list is still unsorted.\\\\n\\\");\\n        return 1;\\n    }\\n\\n#ifdef COMPUTE_MD5_PROBLEM\\n    //Compute MD5 Checksum for problem identification\\n    MD5_CTX c;\\n    unsigned char out[MD5_DIGEST_LENGTH];\\n    MD5_Init(&c);\\n    MD5_Update(&c, our_list, N * sizeof(int));\\n    MD5_Final(out, &c);\\n    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {\\n        printf(\\\"%02x\\\", out[n]);\\n    }\\n#endif\\n    printf(\\\"\\\\n\\\");\\n\\n    //Clean up\\n    free(our_list);\\n\\n    return 0;\\n}\\n\\n/*\\n * Public API\\n */\\nvoid quicksort(int *toorder, int N)\\n{\\n    if (N <= 1)\\n        return;\\n\\n    if (N < PARALLEL_CUTOFF) {\\n        _quicksort_seeded(toorder, 0, N - 1, 0x243f6a88U, 0);\\n        return;\\n    }\\n\\n    #pragma omp parallel\\n    {\\n        #pragma omp single\\n        _quicksort_seeded(toorder, 0, N - 1, 0x243f6a88U, 1);\\n    }\\n}\\n\\n/*\\n * Internal serial entry point retained for callers of the original API.\\n */\\nvoid _quicksort(int *toorder, int lo, int hi)\\n{\\n    _quicksort_seeded(toorder, lo, hi, 0x243f6a88U, 0);\\n}\\n\\nstatic unsigned int next_pivot_random(unsigned int *state)\\n{\\n    unsigned int x = *state;\\n    if (x == 0)\\n        x = 0x6d2b79f5U;\\n    x ^= x << 13;\\n    x ^= x >> 17;\\n    x ^= x << 5;\\n    *state = x;\\n    return x;\\n}\\n\\nstatic unsigned int derive_seed(unsigned int value)\\n{\\n    value ^= value >> 16;\\n    value *= 0x7feb352dU;\\n    value ^= value >> 15;\\n    value *= 0x846ca68bU;\\n    value ^= value >> 16;\\n    return value ? value : 0x6d2b79f5U;\\n}\\n\\nstatic void insertion_sort(int *toorder, int lo, int hi)\\n{\\n    for (int i = lo + 1; i <= hi; i++) {\\n        int value = toorder[i];\\n        int j = i;\\n        while (j > lo && toorder[j - 1] > value) {\\n            toorder[j] = toorder[j - 1];\\n            j--;\\n        }\\n        toorder[j] = value;\\n    }\\n}\\n\\n/*\\n * In-place three-way quicksort. Each recursive partition has independent\\n * pivot state so OpenMP tasks never share the generator used for case creation.\\n */\\nstatic void _quicksort_seeded(int *toorder, int lo, int hi,\\n                              unsigned int seed, int allow_tasks)\\n{\\n    while (lo < hi) {\\n        int count = hi - lo + 1;\\n        if (count <= INSERTION_CUTOFF) {\\n            insertion_sort(toorder, lo, hi);\\n            return;\\n        }\\n\\n        unsigned int random_value = next_pivot_random(&seed);\\n        int pivot_index = lo + (int)(random_value % (unsigned int)count);\\n        int pivot = toorder[pivot_index];\\n        int less = lo;\\n        int current = lo;\\n        int greater = hi;\\n\\n        while (current <= greater) {\\n            if (toorder[current] < pivot) {\\n                int tmp = toorder[less];\\n                toorder[less] = toorder[current];\\n                toorder[current] = tmp;\\n                less++;\\n                current++;\\n            } else if (toorder[current] > pivot) {\\n                int tmp = toorder[current];\\n                toorder[current] = toorder[greater];\\n                toorder[greater] = tmp;\\n                greater--;\\n            } else {\\n                current++;\\n            }\\n        }\\n\\n        int left_size = less - lo;\\n        int right_size = hi - greater;\\n        unsigned int left_seed = derive_seed(seed + 0x9e3779b9U);\\n        unsigned int right_seed = derive_seed(seed + 0x85ebca6bU);\\n\\n        if (allow_tasks && count >= TASK_CUTOFF) {\\n            if (left_size <= right_size) {\\n                if (left_size > 1) {\\n                    if (left_size >= TASK_CUTOFF) {\\n                        #pragma omp task firstprivate(toorder, lo, less, left_seed, allow_tasks)\\n                        _quicksort_seeded(toorder, lo, less - 1, left_seed,\\n                                          allow_tasks);\\n                    } else {\\n                        _quicksort_seeded(toorder, lo, less - 1, left_seed,\\n                                          allow_tasks);\\n                    }\\n                }\\n                lo = greater + 1;\\n                seed = right_seed;\\n            } else {\\n                if (right_size > 1) {\\n                    if (right_size >= TASK_CUTOFF) {\\n                        #pragma omp task firstprivate(toorder, greater, hi, right_seed, allow_tasks)\\n                        _quicksort_seeded(toorder, greater + 1, hi, right_seed,\\n                                          allow_tasks);\\n                    } else {\\n                        _quicksort_seeded(toorder, greater + 1, hi, right_seed,\\n                                          allow_tasks);\\n                    }\\n                }\\n                hi = less - 1;\\n                seed = left_seed;\\n            }\\n            continue;\\n        }\\n\\n        /* Recurse on the smaller side and iterate over the larger side. */\\n        if (left_size <= right_size) {\\n            if (left_size > 1)\\n                _quicksort_seeded(toorder, lo, less - 1, left_seed,\\n                                  allow_tasks);\\n            lo = greater + 1;\\n            seed = right_seed;\\n        } else {\\n            if (right_size > 1)\\n                _quicksort_seeded(toorder, greater + 1, hi, right_seed,\\n                                  allow_tasks);\\n            hi = less - 1;\\n            seed = left_seed;\\n        }\\n    }\\n}\\n\\n/*\\n * Swap two values.\\n */\\nvoid swap(int *toorder, int i, int j)\\n{\\n    int temp = toorder[i];\\n    toorder[i] = toorder[j];\\n    toorder[j] = temp;\\n}\\n\\n/*\\n * Partition decision retained for compatibility with the original interface.\\n */\\nint partition(int *toorder, int lo, int hi)\\n{\\n    int b = lo;\\n    int r = (int) (lo + (hi - lo) * (randnum() / MY_RAND_MAX));\\n    int pivot = toorder[r];\\n    swap(toorder, r, hi);\\n    for (int i = lo; i < hi; i++) {\\n        if (toorder[i] < pivot) {\\n            swap(toorder, i, b);\\n            b++;\\n        }\\n    }\\n    swap(toorder, hi, b);\\n    return b;\\n}\\n\\n/*\\n * Check if elements are in non-decreasing order\\n */\\nint is_sorted(int *toorder, int N)\\n{\\n    for (int i = 1; i < N; i++) {\\n        if (toorder[i] < toorder[i - 1]) {\\n            return 1;\\n        }\\n    }\\n    return 0;\\n}\\n\\n\\n/*\\n * Generate a case\\n */\\nint *generate_case(int N)\\n{\\n    int i;\\n    int *ret = NULL;\\n\\n    // Make case generation reproducible\\n    srandnum(0);\\n\\n    // Allocate memory\\n    ret = (int *) malloc(N * sizeof(int));\\n    if (ret == NULL) {\\n        printf(\\\"Error: some malloc won't work.\\\\n\\\");\\n        return NULL;\\n    }\\n    // Get pseudo-random positive integer values\\n    for (i = 0; i < N; i++) {\\n        ret[i] = drand(0, INT_MAX);\\n    }\\n    return ret;\\n}\\n\\n/*\\n * A pseudo-random number between two positive integer values\\n */\\ndouble drand(int xmin, int xmax)\\n{\\n    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;\\n}\\n\",\"path\":\"src/quicksort.c\"}],\"hypothesis\":\"Using coarse recursive OpenMP tasks above a size cutoff, with per-subproblem pivot state, should reduce quicksort wall time on four cores without introducing races in the case-generation RNG.\",\"notes\":\"Uses three-way partitioning for duplicate values and insertion sort for small ranges; generated values and checksum semantics are unchanged. No local measurements were run.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Use a parallel region and single task producer only for arrays of at least 65536 elements; spawn recursive tasks for sufficiently large partitions, with an 8192-element task cutoff.\",\"Give each recursive partition independent xorshift pivot state instead of sharing the case-generation RNG.\",\"Use three-way partitioning and insertion sort for small subarrays, iterating over the larger side to limit recursion depth.\"]}"}}

"""Inspect the exact curated public tree, without touching the experimental sources."""
from __future__ import annotations

import hashlib
import json
import re
import sys
from datetime import UTC, datetime
from pathlib import Path

BASE = Path(__file__).resolve().parents[2]
ROOT = BASE / "work/hpc-forest-public-r1"


def main():
    sys.path.insert(0, str(ROOT))
    from tools.manifest import public_files
    from tools.verify import verify_links, verify_manifest

    count = verify_manifest(ROOT)
    links = verify_links(ROOT)
    forbidden = {
        "private_local_path": r"[A-Z]:[\\/](?:Users|scratch)|/scratch_p/|/home/nimarano|r250127",
        "private_runtime_identity": r"worker-current-cim|coordinator-state|16cc609c0eae|5cbdd08b886a",
        "credential_value": r"(?:gh[pousr]_[A-Za-z0-9]{20,}|AKIA[A-Z0-9]{16}|-----BEGIN (?:RSA |OPENSSH )?PRIVATE KEY-----)",
        "internal_technique": r"AB.MCTS|TreeQuest|Shinka|TRINITY|Conductor|Gödel|bandit|population|hpc_forest",
        "unrequested_distribution_context": "link" + "edin",
    }
    results, errors = [], []
    for path in public_files(ROOT):
        raw = path.read_bytes()
        name = path.relative_to(ROOT).as_posix()
        if len(raw) > 2_000_000:
            errors.append({"path": name, "reason": "unexpected_large_file"})
        if path.suffix.lower() in {".zip", ".gz", ".bin", ".sqlite", ".db", ".pdf", ".safetensors", ".pkl"}:
            errors.append({"path": name, "reason": "unapproved_artifact_type"})
        if path.suffix.lower() != ".png":
            text = raw.decode("utf-8")
            for category, pattern in forbidden.items():
                if re.search(pattern, text, re.IGNORECASE):
                    errors.append({"path": name, "reason": category})
            if path.suffix == ".svg" and re.search(r"<script|<foreignObject|javascript:", text, re.IGNORECASE):
                errors.append({"path": name, "reason": "active_svg_content"})
        results.append({"path": name, "bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest()})
    source_manifest = BASE / "outputs/HPC-Forest-Evolution-r5/manifeste-source-r5.json"
    source = json.loads(source_manifest.read_bytes())
    for item in source:
        path = BASE / "outputs/HPC-Forest" / item["path"]
        if hashlib.sha256(path.read_bytes()).hexdigest() != item["sha256"]:
            errors.append({"reason": "canonical_source_changed", "path": item["path"]})
    receipt = {"utc": datetime.now(UTC).isoformat(), "reviewed_public_files_excluding_manifest": count,
               "public_size_bytes": sum(row["bytes"] for row in results), "relative_links_verified": links,
               "canonical_source_files_unchanged": len(source), "new_repository_only": True,
               "internal_engine_published": False, "heldout_inputs_published": False,
               "scan_errors": errors, "files": results}
    path = Path(__file__).parent / ("controle-final-" + datetime.now(UTC).strftime("%Y%m%dT%H%M%S") + ".json")
    if path.exists():
        raise RuntimeError("Preserve the previous publication review; create a new revision")
    path.write_text(json.dumps(receipt, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(json.dumps({k: v for k, v in receipt.items() if k != "files"}, ensure_ascii=True))
    if errors:
        raise SystemExit(1)


if __name__ == "__main__":
    main()

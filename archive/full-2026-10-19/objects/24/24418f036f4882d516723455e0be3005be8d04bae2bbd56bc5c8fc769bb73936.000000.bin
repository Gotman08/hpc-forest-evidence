    "script": "#!/usr/bin/env bash\n# Genere par romeo-mcp - ne pas editer a la main.\n#SBATCH --job-name=forest-primes-certified-arm64-qual-r1\n#SBATCH --account=r250127\n#SBATCH --qos=normal\n#SBATCH --partition=instant\n#SBATCH --constraint=armgpu\n#SBATCH --time=00:15:00\n#SBATCH --nodes=1\n#SBATCH --ntasks-per-node=1\n#SBATCH --cpus-per-task=4\n#SBATCH --mem=16G\n#SBATCH --chdir=/scratch_p/nimarano\n#SBATCH --output=/scratch_p/nimarano/%x-%j.out\n#SBATCH --error=/scratch_p/nimarano/%x-%j.err\n\nset -euo pipefail\n\n# Sans cette fonction, un job ROMEO 2025 n'a acces a aucun logiciel,\n# pas meme a la commande spack. Elle est propre a l'architecture :\n# charger celle de l'autre donnerait des binaires inutilisables.\nromeo_load_armgpu_env\nspack load /zrtbeqke25s2vbqo4yrhsowjz7mg3pjf\n\n# Provenance du premier demarrage : environnement, commit et fichiers choisis.\nif command -v python3 >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then\n  if timeout 20s python3 -I -S - '{\"roots\": [\"/scratch_p/nimarano\", \"/project\"], \"include_home\": true, \"code_dir\": \"/scratch_p/nimarano\", \"data_files\": [\"/scratch_p/nimarano/hpc-forest-primes-certified-e1116d931887fbeb.tar.gz\"], \"max_bytes\": 67108864}' <<'ROMEO_REPRO_CAPTURE'\n\nimport hashlib, json, os, pathlib, re, stat, subprocess, sys\nparams = json.loads(sys.argv[1])\nroots = [pathlib.Path(p).resolve() for p in params['roots']]\nif params.get('include_home'):\n    roots.append(pathlib.Path.home().resolve())\ndef allowed(value):\n    path = pathlib.Path(value).resolve()\n    if not any(path == root or root in path.parents for root in roots):\n        raise ValueError('outside_roots')\n    if any(p.lower().startswith(('.env', 'id_rsa', 'id_ed25519', 'id_ecdsa')) or p.lower() in ('.ssh', '.aws', '.azure', '.kube', 'hosts.yml')\n           or p.lower().endswith(('.pem', '.key', '.p12', '.pfx'))\n           or re.search(r'password|passwd|passphrase|secret|token|credential|authorization|cookie|api[_-]?key|access[_-]?key|private[_-]?key', p, re.I)\n           for p in path.parts):\n        raise ValueError('sensitive_path')\n    return path\nout = {'git': {'status': 'unavailable'}, 'data': []}\ntry:\n    code = allowed(params['code_dir'])\n    result = subprocess.run(['git', '-c', 'core.fsmonitor=false', '-C', str(code),\n                             'rev-parse', '--verify', 'HEAD'],\n                            capture_output=True, text=True, timeout=5,\n                            env={**os.environ, 'GIT_OPTIONAL_LOCKS': '0'})\n    sha = result.stdout.strip()\n    if result.returncode == 0 and len(sha) in (40, 64) and all(c in '0123456789abcdef' for c in sha):\n        out['git'] = {'status': 'observed', 'commit': sha, 'working_tree_verified': False}\nexcept (OSError, ValueError, subprocess.TimeoutExpired):\n    pass\nremaining = params['max_bytes']\nfor name in params['data_files']:\n    item = {'path': name}\n    try:\n        path = allowed(name)\n        info = path.stat()\n        if not stat.S_ISREG(info.st_mode):\n            item['status'] = 'not_regular_file'\n        elif info.st_size > remaining:\n            item.update(status='size_limit', bytes=info.st_size)\n        else:\n            h = hashlib.sha256()\n            consumed = 0\n            with path.open('rb') as stream:\n                while True:\n                    block = stream.read(min(1048576, remaining - consumed + 1))\n                    if not block:\n                        break\n                    consumed += len(block)\n                    if consumed > remaining:\n                        break\n                    h.update(block)\n            after = path.stat()\n            remaining = max(0, remaining - consumed)\n            if consumed != info.st_size or (info.st_size, info.st_mtime_ns, info.st_ino) != (after.st_size, after.st_mtime_ns, after.st_ino):\n                item['status'] = 'changed_during_read'\n            else:\n                item.update(status='hashed', sha256=h.hexdigest(), bytes=consumed)\n    except (OSError, ValueError):\n        item['status'] = 'unreadable_or_outside_roots'\n    out['data'].append(item)\n\n\nimport datetime, platform\nout['observed_at'] = datetime.datetime.now(datetime.timezone.utc).isoformat()\nout['phase'] = 'before_workload'\nout['environment'] = {\n    'source': 'compute_node_before_command', 'architecture': platform.machine(),\n    'python_version': platform.python_version(),\n    'loaded_modules': [v for v in os.environ.get('LOADEDMODULES', '').split(':') if v][:128],\n    'spack_loaded_hashes': [v for v in os.environ.get('SPACK_LOADED_HASHES', '').split(':') if v][:128],\n}\njid = os.environ.get('SLURM_JOB_ID', '')\nif os.environ.get('SLURM_ARRAY_JOB_ID') and os.environ.get('SLURM_ARRAY_TASK_ID'):\n    jid = os.environ['SLURM_ARRAY_JOB_ID'] + '_' + os.environ['SLURM_ARRAY_TASK_ID']\nif not re.fullmatch(r'[0-9]+(?:_[0-9]+)?', jid):\n    raise ValueError('missing_job_id')\nout['job_id'] = jid\nfolder = pathlib.Path('.romeo-provenance')\nfolder.mkdir(mode=0o700, exist_ok=True)\nif folder.is_symlink():\n    raise ValueError('symlink_capture_directory')\nout['restart_count'] = os.environ.get('SLURM_RESTART_COUNT', '0')\ntry:\n    fd = os.open(folder / (jid + '.json'), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)\nexcept FileExistsError:\n    pass\nelse:\n    with os.fdopen(fd, 'w') as stream:\n        json.dump(out, stream)\n        stream.write('\\n')\nROMEO_REPRO_CAPTURE\n  then :; else\n    printf '%s\\n' '[romeo-mcp] provenance indisponible ; le calcul continue.' >&2\n  fi\nfi\n\n\n# Trace d'execution : sert a diagnostiquer les erreurs d'architecture.\necho \"[romeo-mcp] noeud=$(hostname) arch=$(uname -m) job=${SLURM_JOB_ID:-?}\"\necho \"[romeo-mcp] debut $(date -Is)\"\n\nbash -lc 'set -euo pipefail\nexport PYTHONDONTWRITEBYTECODE=1\nexport OPENBLAS_NUM_THREADS=1\nexport OMP_NUM_THREADS=4\n/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python -I -B - <<'\"'\"'CERTIFIED_PRIMES_QUALIFICATION'\"'\"'\n\"\"\"PROPOSED compute-allocation command. Do not execute locally or on login.\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport os\nimport platform\nimport re\nimport subprocess\nimport sys\nimport tarfile\nfrom datetime import UTC, datetime, timedelta\nfrom pathlib import Path, PurePosixPath\n\nPAYLOAD = Path(\"/scratch_p/nimarano/hpc-forest-primes-certified-e1116d931887fbeb.tar.gz\")\nPAYLOAD_SHA = \"e1116d931887fbebad63e88a7678df13bc09e0381a754d967c79ae8ac7c37eda\"\nMANIFEST_SHA = \"d260af0a7b91cbe5fc7e3ab1ad9313723e385c21fdd75bd5c9623095683022fd\"\nREVIEW_SHA = \"af703fd382e2065eb966cebfd3eb201ee6286826dbc28802185c22c5932269ab\"\nPYTHON = \"/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python\"\nROOT = Path(\"/scratch_p/nimarano/hpc-forest-primes-certified-qualification-20261017-r1-e1116d931887\")\nSCOPE = \"hpc-forest-primes-max-certifie-r1\"\nDEADLINE = datetime(2026, 10, 31, 23, tzinfo=UTC)\n\n\ndef require(value, message):\n    if not value:\n        raise RuntimeError(message)\n\n\ndef sha(path):\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\n\ndef save(path, value):\n    with path.open(\"x\", encoding=\"utf8\") as stream:\n        json.dump(value, stream, ensure_ascii=True, indent=2)\n        stream.write(\"\\n\")\n\n\ndef inventory(path):\n    return {item.relative_to(path).as_posix(): sha(item)\n            for item in sorted(path.rglob(\"*\")) if item.is_file()}\n\n\ndef allocation_guard():\n    env = os.environ\n    require(platform.system() == \"Linux\" and platform.machine().lower() in (\"aarch64\", \"arm64\"),\n            \"Linux ARM64 compute allocation required\")\n    require(re.fullmatch(r\"[0-9]+\", env.get(\"SLURM_JOB_ID\", \"\")), \"Concrete Slurm job required\")\n    require(env.get(\"SLURM_JOB_NUM_NODES\") == \"1\" and env.get(\"SLURM_NTASKS\") == \"1\"\n            and env.get(\"SLURM_CPUS_PER_TASK\") == \"4\" and env.get(\"SLURM_MEM_PER_NODE\") == \"16384\",\n            \"Exact 1 node/task,4CPU,16GiB allocation required\")\n    require(not env.get(\"SLURM_JOB_GPUS\") and env.get(\"CUDA_VISIBLE_DEVICES\", \"\") in (\"\", \"-1\", \"NoDevFiles\"),\n            \"Zero GPU allocation required\")\n    require(len(os.sched_getaffinity(0)) >= 4, \"Insufficient CPU affinity\")\n    require(datetime.now(UTC) + timedelta(seconds=900 + 10800) < DEADLINE,\n            \"15min qualification plus3h reception reserve exceeds deadline\")\n\n\ndef restore_payload(destination):\n    require(PAYLOAD.is_file() and not PAYLOAD.is_symlink() and sha(PAYLOAD) == PAYLOAD_SHA,\n            \"Payload SHA/type changed\")\n    with tarfile.open(PAYLOAD, \"r:gz\") as archive:\n        members = archive.getmembers()\n        require(len(members) == 67 and sum(item.size for item in members) < 64 * 1024**2,\n                \"Unexpected payload count/size\")\n        material = {}\n        for item in members:\n            name = PurePosixPath(item.name)\n            require(item.isfile() and not item.issym() and not item.islnk()\n                    and not name.is_absolute() and \"..\" not in name.parts and \"\\\\\" not in item.name\n                    and name.parts[0] == SCOPE, \"Unsafe payload member\")\n            relative = name.relative_to(SCOPE).as_posix()\n            require(relative not in material and item.size <= 4 * 1024**2, \"Duplicate/oversized payload member\")\n            material[relative] = archive.extractfile(item).read()\n    require(hashlib.sha256(material[\"prototype-manifest.json\"]).hexdigest() == MANIFEST_SHA,\n            \"Manifest SHA changed\")\n    manifest = json.loads(material[\"prototype-manifest.json\"])\n    require(set(material) == set(manifest) | {\"prototype-manifest.json\"} and len(manifest) == 66,\n            \"Manifest membership differs\")\n    for name, info in manifest.items():\n        require(len(material[name]) == info[\"bytes\"]\n                and hashlib.sha256(material[name]).hexdigest() == info[\"sha256\"], \"Manifest member differs\")\n    destination.mkdir()\n    for name, raw in material.items():\n        target = destination / name\n        require(target.resolve().is_relative_to(destination.resolve()), \"Extraction escaped new root\")\n        target.parent.mkdir(parents=True, exist_ok=True)\n        with target.open(\"xb\") as stream:\n            stream.write(raw)\n    require(inventory(destination) == {name: hashlib.sha256(raw).hexdigest() for name, raw in material.items()},\n            \"Fresh extraction differs\")\n\n\ndef main():\n    allocation_guard()  # No file creation, subprocess, or compiler before these guards.\n    require(not ROOT.exists(), \"Prior attempt exists; preserve it without replay\")\n    ROOT.mkdir()\n    save(ROOT / \"allocation.json\", {\n        \"utc\": datetime.now(UTC).isoformat(), \"platform\": platform.platform(), \"python\": sys.version,\n        \"job_id\": os.environ[\"SLURM_JOB_ID\"], \"affinity_cpu_count\": len(os.sched_getaffinity(0)),\n        \"slurm\": {key: os.environ.get(key) for key in (\n            \"SLURM_JOB_ID\", \"SLURM_JOB_NUM_NODES\", \"SLURM_NTASKS\", \"SLURM_CPUS_PER_TASK\",\n            \"SLURM_MEM_PER_NODE\", \"SLURM_JOB_GPUS\", \"SLURM_RESTART_COUNT\", \"SLURM_JOB_NODELIST\")},\n        \"payload_sha256\": PAYLOAD_SHA, \"manifest_sha256\": MANIFEST_SHA, \"review_sha256\": REVIEW_SHA,\n        \"native_model_calls\": 0, \"native_research_admitted\": False})\n    extraction = ROOT / \"extraction\"\n    before = None\n    passed = False\n    failure = None\n    code = 1\n    try:\n        restore_payload(extraction)\n        before = inventory(extraction)\n        sys.path.insert(0, str(extraction / \"tools\"))\n        import validate\n        checked = validate.validate_preparation(extraction / \"data\")\n        require(len(checked[\"cases\"]) == 12 and sorted(row[\"p\"] for row in checked[\"cases\"])\n                == [1, 1, 2, 2, 4, 4, 8, 8, 16, 16, 30, 30], \"Twelve exact certified cases required\")\n        save(ROOT / \"pre-execution-data-audit.json\", checked)\n        require(datetime.now(UTC) + timedelta(seconds=900 + 10800) < DEADLINE, \"Deadline changed after restore\")\n        try:\n            completed = subprocess.run(\n                [PYTHON, \"-B\", str(extraction / \"tools/qualify_arm64.py\"), \"--data\", str(extraction / \"data\"),\n                 \"--output\", str(ROOT / \"qualification\")], capture_output=True, check=False, timeout=720)\n            stdout, stderr, code = completed.stdout, completed.stderr, completed.returncode\n        except subprocess.TimeoutExpired as exc:\n            stdout, stderr, code = exc.stdout or b\"\", exc.stderr or b\"\", 124\n            failure = \"Owned qualification process timeout; preserved, never retried\"\n        (ROOT / \"qualification-launch.stdout\").write_bytes(stdout)\n        (ROOT / \"qualification-launch.stderr\").write_bytes(stderr)\n        proof = json.loads((ROOT / \"qualification/qualification.json\").read_text())\n        passed = (code == 0 and proof[\"status\"] == \"mechanical_reference_passed_not_native_model_admitted\"\n                  and len(proof[\"cases\"]) == 12 and proof[\"source_and_data_unchanged\"] is True\n                  and proof[\"native_model_calls\"] == 0 and proof[\"native_research_admitted\"] is False)\n    except (OSError, ValueError, RuntimeError, KeyError, TypeError, tarfile.TarError) as exc:\n        failure = type(exc).__name__ + \": \" + str(exc)\n    after = inventory(extraction) if extraction.exists() else None\n    unchanged = before is not None and before == after\n    passed = passed and unchanged\n    save(ROOT / \"mechanical-reception.json\", {\n        \"status\": \"mechanical_reference_passed_pending_independent_reception\" if passed else \"failed_preserved_no_retry\",\n        \"job_id\": os.environ[\"SLURM_JOB_ID\"], \"passed\": passed, \"qualification_returncode\": code,\n        \"failure\": failure, \"payload_sha256\": PAYLOAD_SHA, \"review_sha256\": REVIEW_SHA,\n        \"all67_extracted_files_unchanged\": unchanged, \"inventory_before\": before, \"inventory_after\": after,\n        \"native_model_calls\": 0, \"native_research_admitted\": False, \"performance_claimed\": False})\n    archive = ROOT / (\"results-\" + os.environ[\"SLURM_JOB_ID\"] + \".tar.gz\")\n    paths = sorted(path for path in ROOT.rglob(\"*\") if path.is_file())\n    with tarfile.open(archive, \"x:gz\") as output:\n        for path in paths:\n            output.add(path, arcname=\"qualification-results/\" + path.relative_to(ROOT).as_posix(), recursive=False)\n    archive_sha = sha(archive)\n    save(ROOT / \"archive-sha256.json\", {\"path\": str(archive), \"sha256\": archive_sha,\n                                        \"bytes\": archive.stat().st_size, \"passed\": passed})\n    print(json.dumps({\"archive\": str(archive), \"archive_sha256\": archive_sha, \"passed\": passed,\n                      \"native_model_calls\": 0, \"native_research_admitted\": False}))\n    raise SystemExit(0 if passed else 1)\n\n\nif __name__ == \"__main__\":\n    main()\n\nCERTIFIED_PRIMES_QUALIFICATION\n'\n\necho \"[romeo-mcp] fin $(date -Is)\"\n",
    "runtime_artifacts": [],
    "submittable": true,
    "plan_id": "e59bb8e9eafd4b7e82b46106d92ef108",
    "plan_sha256": "39dc4426ed4e9ab3c4a3a7f4e05e0bef4fc2ea92cfd21bdaa12957bc2041fe25",

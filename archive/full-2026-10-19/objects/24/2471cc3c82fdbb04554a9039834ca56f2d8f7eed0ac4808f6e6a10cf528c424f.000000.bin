#include "knn.h"

typedef struct {
    size_t encounter;
    float distance;
    char label;
} Candidate;

static int candidate_is_worse(const Candidate *a, const Candidate *b) {
    if (a->distance > b->distance) return 1;
    if (a->distance < b->distance) return 0;
    return a->encounter > b->encounter;
}

static void swap_candidates(Candidate *a, Candidate *b) {
    Candidate temporary = *a;
    *a = *b;
    *b = temporary;
}

static void heap_sift_up(Candidate *heap, size_t child) {
    while (child > 0) {
        size_t parent = (child - 1) / 2;
        if (!candidate_is_worse(&heap[child], &heap[parent])) break;
        swap_candidates(&heap[child], &heap[parent]);
        child = parent;
    }
}

static void heap_sift_down(Candidate *heap, size_t heap_size, size_t root) {
    while (root < heap_size / 2) {
        size_t worse_child = root * 2 + 1;
        size_t right_child = worse_child + 1;
        if (right_child < heap_size &&
            candidate_is_worse(&heap[right_child], &heap[worse_child])) {
            worse_child = right_child;
        }
        if (!candidate_is_worse(&heap[worse_child], &heap[root])) break;
        swap_candidates(&heap[worse_child], &heap[root]);
        root = worse_child;
    }
}

char knn(int n_groups, Group *groups, int k, Point to_evaluate) {
    size_t capacity = (size_t)k;
    Candidate *heap = (Candidate *)malloc(sizeof(Candidate) * capacity);
    char *labels = (char *)malloc(sizeof(char) * capacity);
    size_t heap_size = 0;
    size_t encounter = 0;

    for (size_t i = 0; i < capacity; ++i) {
        labels[i] = -1;
    }

    const float query_x = to_evaluate.x;
    const float query_y = to_evaluate.y;

    for (int i = 0; i < n_groups; ++i) {
        const Group *group = &groups[i];
        const float *x_coordinates = group->x_coordinates;
        const float *y_coordinates = group->y_coordinates;
        char label = group->label;

        for (int j = 0; j < group->length; ++j) {
            float dx = x_coordinates[j] - query_x;
            float dy = y_coordinates[j] - query_y;
            float distance = dx * dx + dy * dy;
            Candidate candidate = { encounter, distance, label };

            if (heap_size < capacity) {
                size_t position = heap_size++;
                heap[position] = candidate;
                heap_sift_up(heap, position);
            } else if (candidate_is_worse(&heap[0], &candidate)) {
                heap[0] = candidate;
                heap_sift_down(heap, heap_size, 0);
            }

            ++encounter;
        }
    }

    for (size_t i = 0; i < heap_size; ++i) {
        labels[i] = heap[i].label;
    }

    qsort(labels, capacity, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (int i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }

            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    free(heap);
    free(labels);
    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();
    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

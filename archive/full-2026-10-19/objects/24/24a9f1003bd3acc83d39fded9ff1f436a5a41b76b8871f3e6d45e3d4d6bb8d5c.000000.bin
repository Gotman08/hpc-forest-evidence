"""Pure passive-guard fixtures only: no census, transport, process or model."""
import importlib.util
import json
import unittest
from pathlib import Path

HERE = Path(__file__).resolve().parent
SPEC = importlib.util.spec_from_file_location("r5_obs4_neutral_runtime", HERE / "observer-mixte.py")
OBS = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(OBS)


class PassiveRuntimeTests(unittest.TestCase):
    def test_closed_jobs_cannot_be_polled(self):
        for job in ("751592", "752306"):
            with self.subTest(job=job), self.assertRaises(ValueError):
                OBS.check_rpc("job_status", {"job_id": job}, {job})

    def test_passive_tools_and_exact_arguments_only(self):
        for tool, args in (("submit_job", {"job_id": "999999"}),
                           ("job_status", {"job_id": "999999", "extra": True})):
            with self.subTest(tool=tool), self.assertRaises(ValueError):
                OBS.check_rpc(tool, args, {"999999"})
        OBS.check_rpc("job_efficiency", {"job_id": "999999"}, {"999999"})

    def test_census_rejects_bad_encoding_empty_and_duplicate(self):
        row = {"ProcessId": 9, "ParentProcessId": 0, "ExecutablePath": None,
               "CommandLine": None, "CreationDate": None}
        for raw in (b"\xff", b"[]", json.dumps([row, row]).encode()):
            with self.subTest(raw=raw), self.assertRaises((ValueError, UnicodeError)):
                OBS.parse_census(raw)

    def test_missing_transition_never_admits_an_observer(self):
        with self.assertRaises(ValueError):
            OBS.verify_transition({"verified": False}, [], [], initial=True)

    def test_opaque_possible_owned_identity_refused(self):
        row = {"ProcessId": 9, "ParentProcessId": 0, "ExecutablePath": None,
               "CommandLine": "NEUTRAL not executed", "CreationDate": "2026-10-18T00:00:00.0000000Z"}
        with self.assertRaises(ValueError):
            OBS.identity(row)


if __name__ == "__main__":
    unittest.main()

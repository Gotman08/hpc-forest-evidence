      "content": "#include \"knn.h\"\n#include <omp.h>\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    for (int i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    #pragma omp parallel\n    {\n        float local_dist[k];\n        char local_labels[k];\n        for (int t = 0; t < k; t++) {\n            local_dist[t] = -1.0f;\n            local_labels[t] = -1;\n        }\n\n        #pragma omp for schedule(dynamic,1) nowait\n        for (int i = 0; i < n_groups; i++) {\n            Group g = groups[i];\n            for (int j = 0; j < g.length; j++) {\n                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n                int pos;\n                for (pos = 0; pos < k; pos++) {\n                    if (d < local_dist[pos] || local_dist[pos] == -1.0f) {\n                        break;\n                    }\n                }\n                if (pos < k) {\n                    // shift right\n                    for (int s = k-1; s > pos; s--) {\n                        local_dist[s] = local_dist[s-1];\n                        local_labels[s] = local_labels[s-1];\n                    }\n                    local_dist[pos] = d;\n                    local_labels[pos] = g.label;\n                }\n            }\n        }\n\n        // merge per-thread results into global arrays using critical section\n        #pragma omp critical\n        {\n            for (int t = 0; t < k; t++) {\n                if (local_dist[t] == -1.0f) break;\n                float d = local_dist[t];\n                char lab = local_labels[t];\n                // insert into global sorted list\n                int pos;\n                for (pos = 0; pos < k; pos++) {\n                    if (d < distances[pos] || distances[pos] == -1.0f) {\n                        break;\n                    }\n                }\n                if (pos < k) {\n                    // shift right\n                    for (int s = k-1; s > pos; s--) {\n                        distances[s] = distances[s-1];\n                        labels[s] = labels[s-1];\n                    }\n                    distances[pos] = d;\n                    labels[pos] = lab;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    },
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}\n",
      "path": "src/knn.h"
    }
  ],
  "hypothesis": "Using OpenMP parallel for with schedule(dynamic,1) over groups distributes variable-length group computations evenly across threads; each thread maintains a private top-k array and merges into the global list via a critical section after the loop, avoiding per-group merge overhead while preserving exact sequential output order.",
  "notes": "Changed knn.c to include OpenMP parallelization. Each thread computes its own sorted nearest neighbors for assigned groups using dynamic scheduling with chunk size 1 for fine-grained load balancing. After the parallel region, a critical section merges each thread's local top-k list into the global arrays. The final frequency counting remains unchanged.",

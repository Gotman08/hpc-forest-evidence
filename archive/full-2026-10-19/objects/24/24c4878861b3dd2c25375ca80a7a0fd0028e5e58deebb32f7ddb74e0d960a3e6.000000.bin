        "content": "/*\n  Quicksort\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <limits.h>\n#include <openssl/md5.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\n#define MY_RAND_MAX 0x7FFFFFFF\n#define RANDNUM_W 521288629\n#define RANDNUM_Z 362436069\n#define MAX_WORKERS 4\n#define BUCKETS 4\n#define SAMPLE_COUNT 15\n#define PARALLEL_CUTOFF 262144\n#define TASK_CUTOFF 4096\n#define INSERTION_CUTOFF 24\n\nvoid srandnum(int seed);\ndouble randnum(void);\nint *generate_case(int N);\ndouble drand(int xmin, int xmax);\nvoid swap(int *toorder, int i, int j);\nvoid _quicksort(int *toorder, int lo, int hi);\nvoid quicksort(int *toorder, int N);\nint is_sorted(int *toorder, int N);\n\nunsigned int randum_w = RANDNUM_W;\nunsigned int randum_z = RANDNUM_Z;\n\nvoid srandnum(int seed)\n{\n    unsigned int w, z;\n    w = (seed * 104623) & 0xffffffff;\n    randum_w = (w) ? w : RANDNUM_W;\n    z = (seed * 48947) & 0xffffffff;\n    randum_z = (z) ? z : RANDNUM_Z;\n}\n\ndouble randnum(void)\n{\n    unsigned int u;\n    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);\n    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);\n    u = (randum_z << 16) + randum_w;\n    return (abs(u));\n}\n\nint main(int argc, char *argv[])\n{\n    int N = 0;\n    int *our_list = NULL;\n\n    scanf(\"%d\", &N);\n    if (N <= 0) {\n        printf(\"Error: please, provide the case size.\\n\");\n        return 1;\n    }\n\n    our_list = generate_case(N);\n    if (our_list == NULL) {\n        printf(\"Error: case instantiation failed.\\n\");\n        return 1;\n    }\n\n    quicksort(our_list, N);\n\n    if (is_sorted(our_list, N) == 1) {\n        printf(\"Error, for some reason list is still unsorted.\\n\");\n        return 1;\n    }\n\n#ifdef COMPUTE_MD5_PROBLEM\n    MD5_CTX c;\n    unsigned char out[MD5_DIGEST_LENGTH];\n    MD5_Init(&c);\n    MD5_Update(&c, our_list, N * sizeof(int));\n    MD5_Final(out, &c);\n    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {\n        printf(\"%02x\", out[n]);\n    }\n#endif\n    printf(\"\\n\");\n\n    free(our_list);\n    return 0;\n}\n\nstatic int depth_budget(int n)\n{\n    int depth = 0;\n    while (n > 1) {\n        n >>= 1;\n        ++depth;\n    }\n    return 2 * depth;\n}\n\nstatic int median_value(int a, int b, int c)\n{\n    int t;\n    if (a > b) { t = a; a = b; b = t; }\n    if (b > c) { t = b; b = c; c = t; }\n    if (a > b) { t = a; a = b; b = t; }\n    return b;\n}\n\nstatic void insertion_sort(int *a, int lo, int hi)\n{\n    for (int i = lo + 1; i <= hi; ++i) {\n        int value = a[i];\n        int j = i;\n        while (j > lo && a[j - 1] > value) {\n            a[j] = a[j - 1];\n            --j;\n        }\n        a[j] = value;\n    }\n}\n\nstatic void heap_sift_down(int *a, size_t root, size_t end)\n{\n    while (root <= (end - 1) / 2) {\n        size_t child = root * 2 + 1;\n        if (child < end && a[child] < a[child + 1])\n            ++child;\n        if (a[root] >= a[child])\n            return;\n        int value = a[root];\n        a[root] = a[child];\n        a[child] = value;\n        root = child;\n    }\n}\n\nstatic void heap_sort_range(int *a, int lo, int hi)\n{\n    int *base = a + lo;\n    size_t length = (size_t)(hi - lo) + 1;\n\n    for (size_t start = length / 2; start > 0;) {\n        --start;\n        heap_sift_down(base, start, length - 1);\n    }\n    for (size_t end = length - 1; end > 0; --end) {\n        int value = base[0];\n        base[0] = base[end];\n        base[end] = value;\n        if (end > 1)\n            heap_sift_down(base, 0, end - 1);\n    }\n}\n\nstatic void intro_sort(int *a, int lo, int hi, int depth)\n{\n    while (lo < hi) {\n        int length = hi - lo + 1;\n        if (length <= INSERTION_CUTOFF) {\n            insertion_sort(a, lo, hi);\n            return;\n        }\n        if (depth <= 0) {\n            heap_sort_range(a, lo, hi);\n            return;\n        }\n        --depth;\n\n        int pivot = median_value(a[lo], a[lo + (hi - lo) / 2], a[hi]);\n        int less = lo;\n        int current = lo;\n        int greater = hi;\n        while (current <= greater) {\n            if (a[current] < pivot) {\n                swap(a, current, less);\n                ++current;\n                ++less;\n            } else if (a[current] > pivot) {\n                swap(a, current, greater);\n                --greater;\n            } else {\n                ++current;\n            }\n        }\n\n        if (less - lo < hi - greater) {\n            if (lo < less)\n                intro_sort(a, lo, less - 1, depth);\n            lo = greater + 1;\n        } else {\n            if (greater < hi)\n                intro_sort(a, greater + 1, hi, depth);\n            hi = less - 1;\n        }\n    }\n}\n\nvoid _quicksort(int *toorder, int lo, int hi)\n{\n    if (lo < hi)\n        intro_sort(toorder, lo, hi, depth_budget(hi - lo + 1));\n}\n\nvoid swap(int *toorder, int i, int j)\n{\n    int temp = toorder[i];\n    toorder[i] = toorder[j];\n    toorder[j] = temp;\n}\n\nstatic int segment_point(int lo, int length, int part, int parts)\n{\n    size_t n = (size_t)length;\n    size_t p = (size_t)part;\n    size_t divisor = (size_t)parts;\n    size_t offset = (n / divisor) * p + ((n % divisor) * p) / divisor;\n    return lo + (int)offset;\n}\n\nstatic int bucket_for(int value, int split1, int split2, int split3)\n{\n    if (value < split1)\n        return 0;\n    if (value < split2)\n        return 1;\n    if (value < split3)\n        return 2;\n    return 3;\n}\n\nstatic void multiway_quicksort(int *a, int *scratch, int lo, int hi,\n                               int workers, int depth, int levels)\n{\n    int length = hi - lo + 1;\n    if (length <= 1)\n        return;\n    if (length < PARALLEL_CUTOFF || workers < 2 || levels >= depth) {\n        intro_sort(a, lo, hi, depth);\n        return;\n    }\n\n    int samples[SAMPLE_COUNT];\n    size_t span = (size_t)(length - 1);\n    size_t divisor = SAMPLE_COUNT - 1;\n    size_t step = span / divisor;\n    size_t remainder = span % divisor;\n    for (int i = 0; i < SAMPLE_COUNT; ++i) {\n        size_t offset = step * (size_t)i + (remainder * (size_t)i) / divisor;\n        samples[i] = a[lo + (int)offset];\n    }\n    for (int i = 1; i < SAMPLE_COUNT; ++i) {\n        int value = samples[i];\n        int j = i;\n        while (j > 0 && samples[j - 1] > value) {\n            samples[j] = samples[j - 1];\n            --j;\n        }\n        samples[j] = value;\n    }\n    int split1 = samples[3];\n    int split2 = samples[7];\n    int split3 = samples[11];\n\n    int counts[MAX_WORKERS][BUCKETS] = {{0}};\n    for (int w = 0; w < workers; ++w) {\n        int chunk_lo = segment_point(lo, length, w, workers);\n        int chunk_hi = segment_point(lo, length, w + 1, workers);\n        #pragma omp task firstprivate(w, chunk_lo, chunk_hi, split1, split2, split3) shared(a, counts)\n        {\n            int local[BUCKETS] = {0};\n            for (int i = chunk_lo; i < chunk_hi; ++i)\n                ++local[bucket_for(a[i], split1, split2, split3)];\n            for (int b = 0; b < BUCKETS; ++b)\n                counts[w][b] = local[b];\n        }\n    }\n    #pragma omp taskwait\n\n    int bucket_sizes[BUCKETS] = {0};\n    int bucket_starts[BUCKETS];\n    int positions[MAX_WORKERS][BUCKETS];\n    int largest = 0;\n    int next = lo;\n    for (int b = 0; b < BUCKETS; ++b) {\n        bucket_starts[b] = next;\n        int bucket_count = 0;\n        for (int w = 0; w < workers; ++w) {\n            positions[w][b] = next + bucket_count;\n            bucket_count += counts[w][b];\n        }\n        bucket_sizes[b] = bucket_count;\n        if (bucket_count > largest)\n            largest = bucket_count;\n        next += bucket_count;\n    }\n\n    if (largest > length - length / 8) {\n        intro_sort(a, lo, hi, depth);\n        return;\n    }\n\n    for (int w = 0; w < workers; ++w) {\n        int chunk_lo = segment_point(lo, length, w, workers);\n        int chunk_hi = segment_point(lo, length, w + 1, workers);\n        #pragma omp task firstprivate(w, chunk_lo, chunk_hi, split1, split2, split3) shared(a, scratch, positions)\n        {\n            int destination[BUCKETS];\n            for (int b = 0; b < BUCKETS; ++b)\n                destination[b] = positions[w][b];\n            for (int i = chunk_lo; i < chunk_hi; ++i) {\n                int b = bucket_for(a[i], split1, split2, split3);\n                scratch[destination[b]++] = a[i];\n            }\n        }\n    }\n    #pragma omp taskwait\n\n    for (int w = 0; w < workers; ++w) {\n        int chunk_lo = segment_point(lo, length, w, workers);\n        int chunk_hi = segment_point(lo, length, w + 1, workers);\n        #pragma omp task firstprivate(chunk_lo, chunk_hi) shared(a, scratch)\n        {\n            for (int i = chunk_lo; i < chunk_hi; ++i)\n                a[i] = scratch[i];\n        }\n    }\n    #pragma omp taskwait\n\n    int next_level = levels + 1;\n    for (int b = 0; b < BUCKETS; ++b) {\n        if (bucket_sizes[b] <= 1)\n            continue;\n        int child_lo = bucket_starts[b];\n        int child_hi = child_lo + bucket_sizes[b] - 1;\n        if (bucket_sizes[b] >= TASK_CUTOFF) {\n            #pragma omp task firstprivate(child_lo, child_hi, workers, depth, next_level) shared(a, scratch)\n            multiway_quicksort(a, scratch, child_lo, child_hi, workers, depth, next_level);\n        } else {\n            intro_sort(a, child_lo, child_hi, depth);\n        }\n    }\n    #pragma omp taskwait\n}\n\nvoid quicksort(int *toorder, int N)\n{\n    if (N <= 1)\n        return;\n\n    int workers = 1;\n#ifdef _OPENMP\n    workers = omp_get_max_threads();\n#endif\n    if (workers < 1)\n        workers = 1;\n    if (workers > MAX_WORKERS)\n        workers = MAX_WORKERS;\n\n    if (workers < 2) {\n        _quicksort(toorder, 0, N - 1);\n        return;\n    }\n\n    size_t bytes = (size_t)N * sizeof(*toorder);\n    if (bytes / sizeof(*toorder) != (size_t)N) {\n        _quicksort(toorder, 0, N - 1);\n        return;\n    }\n    int *scratch = (int *)malloc(bytes);\n    if (scratch == NULL) {\n        _quicksort(toorder, 0, N - 1);\n        return;\n    }\n\n    int depth = depth_budget(N);\n#ifdef _OPENMP\n    #pragma omp parallel\n    {\n        #pragma omp single\n        multiway_quicksort(toorder, scratch, 0, N - 1, workers, depth, 0);\n    }\n#else\n    _quicksort(toorder, 0, N - 1);\n#endif\n    free(scratch);\n}\n\nint is_sorted(int *toorder, int N)\n{\n    for (int i = 1; i < N; i++) {\n        if (toorder[i] < toorder[i - 1])\n            return 1;\n    }\n    return 0;\n}\n\nint *generate_case(int N)\n{\n    int *ret = NULL;\n    srandnum(0);\n    ret = (int *)malloc(N * sizeof(int));\n    if (ret == NULL) {\n        printf(\"Error: some malloc won't work.\\n\");\n        return NULL;\n    }\n    for (int i = 0; i < N; i++)\n        ret[i] = drand(0, INT_MAX);\n    return ret;\n}\n\ndouble drand(int xmin, int xmax)\n{\n    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;\n}\n",

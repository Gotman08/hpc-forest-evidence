/*
  Quicksort
*/
#include <stdio.h>
#include <stdlib.h>
#include <limits.h>
#include <string.h>
#include <openssl/md5.h>
#ifdef _OPENMP
#include <omp.h>
#endif


/*
 * Prototypes
 */
void srandnum(int seed);
double randnum(void);
int *generate_case(int N);
double drand(int xmin, int xmax);
void swap(int *toorder, int i, int j);
int partition(int *toorder, int lo, int hi);
void _quicksort(int *toorder, int lo, int hi);
void quicksort(int *toorder, int N);
int is_sorted(int *toorder, int N);

/*
 * A generic pRNG
 */
#define MY_RAND_MAX 0x7FFFFFFF

#define RANDNUM_W 521288629
#define RANDNUM_Z 362436069

unsigned int randum_w = RANDNUM_W;
unsigned int randum_z = RANDNUM_Z;

void srandnum(int seed)
{
    unsigned int w, z;
    w = (seed * 104623) & 0xffffffff;
    randum_w = (w) ? w : RANDNUM_W;
    z = (seed * 48947) & 0xffffffff;
    randum_z = (z) ? z : RANDNUM_Z;
}

double randnum(void)
{
    unsigned int u;
    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);
    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);
    u = (randum_z << 16) + randum_w;
    return (abs(u));
}

/*
 * Main function
 */
int main(int argc, char *argv[])
{
    int N = 0;
    int *our_list = NULL;

    //The input provides the case size
	scanf("%d", &N);
    if (N <= 0) {
	printf("Error: please, provide the case size.\n");
	return 1;
    }

    //Generate the case
    our_list = generate_case(N);
    if (our_list == NULL) {
	printf("Error: case instantiation failed.\n");
	return 1;
    }

    //Do the thing
    quicksort(our_list, N);

    if (is_sorted(our_list, N) == 1) {
	printf("Error, for some reason list is still unsorted.\n");
	return 1;
    }

#ifdef COMPUTE_MD5_PROBLEM
    //Compute MD5 Checksum for problem identification
    MD5_CTX c;
    unsigned char out[MD5_DIGEST_LENGTH];
    MD5_Init(&c);
    MD5_Update(&c, our_list, N * sizeof(int));
    MD5_Final(out, &c);
    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {
	printf("%02x", out[n]);
    }
#endif
    printf("\n");

    //Clean up
    free(our_list);

    return 0;
}

#define RADIX_BUCKETS 256
#define RADIX_WORKERS 4
#define RADIX_PASSES ((sizeof(unsigned int) * CHAR_BIT + 7) / 8)
#define RADIX_PARALLEL_THRESHOLD 262144

static inline unsigned int radix_digit(int value, unsigned int shift)
{
    unsigned int key = (unsigned int)value ^ ((unsigned int)INT_MAX + 1u);
    return (key >> shift) & 255u;
}

/* Independent banks avoid a single counter dependency chain on repeated keys. */
static void radix_histogram(const int *restrict source, size_t n,
                            unsigned int shift, size_t *restrict counts)
{
    size_t bank[4][RADIX_BUCKETS] = {{0}};
    size_t limit = n & ~(size_t)3;
    size_t i = 0;
    for (; i < limit; i += 4) {
        ++bank[0][radix_digit(source[i], shift)];
        ++bank[1][radix_digit(source[i + 1], shift)];
        ++bank[2][radix_digit(source[i + 2], shift)];
        ++bank[3][radix_digit(source[i + 3], shift)];
    }
    for (; i < n; ++i) {
        ++bank[0][radix_digit(source[i], shift)];
    }
#if defined(_OPENMP) && _OPENMP >= 201307
#pragma omp simd
#endif
    for (unsigned int bucket = 0; bucket < RADIX_BUCKETS; ++bucket) {
        counts[bucket] = bank[0][bucket] + bank[1][bucket]
                       + bank[2][bucket] + bank[3][bucket];
    }
}

/* Equal digits can share a cursor, so scatter updates stay ordered, not SIMD. */
static void radix_scatter(const int *restrict source, size_t n,
                          int *restrict destination, unsigned int shift,
                          size_t *restrict offsets)
{
    size_t limit = n & ~(size_t)3;
    size_t i = 0;
    for (; i < limit; i += 4) {
        int v0 = source[i];
        int v1 = source[i + 1];
        int v2 = source[i + 2];
        int v3 = source[i + 3];
        unsigned int b0 = radix_digit(v0, shift);
        unsigned int b1 = radix_digit(v1, shift);
        unsigned int b2 = radix_digit(v2, shift);
        unsigned int b3 = radix_digit(v3, shift);
        destination[offsets[b0]++] = v0;
        destination[offsets[b1]++] = v1;
        destination[offsets[b2]++] = v2;
        destination[offsets[b3]++] = v3;
    }
    for (; i < n; ++i) {
        int value = source[i];
        destination[offsets[radix_digit(value, shift)]++] = value;
    }
}

static void radix_sort_serial(int *toorder, int *scratch, size_t n)
{
    size_t counts[RADIX_BUCKETS];
    size_t offsets[RADIX_BUCKETS];
    for (unsigned int pass = 0; pass < RADIX_PASSES; ++pass) {
        const int *source = (pass & 1u) ? scratch : toorder;
        int *destination = (pass & 1u) ? toorder : scratch;
        unsigned int shift = pass * 8;
        radix_histogram(source, n, shift, counts);
        size_t total = 0;
        for (unsigned int bucket = 0; bucket < RADIX_BUCKETS; ++bucket) {
            offsets[bucket] = total;
            total += counts[bucket];
        }
        radix_scatter(source, n, destination, shift, offsets);
    }
    if (RADIX_PASSES & 1u) {
        memcpy(toorder, scratch, n * sizeof(*toorder));
    }
}

#ifdef _OPENMP
/* Padding separates the writable portions of neighboring workers' rows. */
typedef struct {
    size_t bin[RADIX_BUCKETS];
    size_t padding[8];
} radix_row;

static void radix_sort_parallel(int *toorder, int *scratch, size_t n)
{
    radix_row counts[RADIX_WORKERS];
    radix_row offsets[RADIX_WORKERS];
#pragma omp parallel num_threads(RADIX_WORKERS) shared(counts, offsets, toorder, scratch, n)
    {
        int worker = omp_get_thread_num();
        int workers = omp_get_num_threads();
        size_t block = n / (size_t)workers;
        size_t remainder = n % (size_t)workers;
        size_t id = (size_t)worker;
        size_t begin = id * block + (id < remainder ? id : remainder);
        size_t length = block + (id < remainder);

        for (unsigned int pass = 0; pass < RADIX_PASSES; ++pass) {
            const int *source = (pass & 1u) ? scratch : toorder;
            int *destination = (pass & 1u) ? toorder : scratch;
            unsigned int shift = pass * 8;

            /* Chunk contents change after every scatter: recount every pass. */
            radix_histogram(source + begin, length, shift, counts[worker].bin);
#pragma omp barrier
#pragma omp single
            {
                size_t total = 0;
                for (unsigned int bucket = 0; bucket < RADIX_BUCKETS; ++bucket) {
                    for (int t = 0; t < workers; ++t) {
                        offsets[t].bin[bucket] = total;
                        total += counts[t].bin[bucket];
                    }
                }
            }
            /* Bucket ranges follow input-chunk order, preserving stability. */
            radix_scatter(source + begin, length, destination, shift,
                          offsets[worker].bin);
#pragma omp barrier
        }
    }
    if (RADIX_PASSES & 1u) {
        memcpy(toorder, scratch, n * sizeof(*toorder));
    }
}
#endif

static void insertion_sort(int *values, size_t n)
{
    for (size_t i = 1; i < n; ++i) {
        int value = values[i];
        size_t j = i;
        while (j > 0 && values[j - 1] > value) {
            values[j] = values[j - 1];
            --j;
        }
        values[j] = value;
    }
}

static int compare_ints(const void *left, const void *right)
{
    int a = *(const int *)left;
    int b = *(const int *)right;
    return (a > b) - (a < b);
}

/*
 * Public API
 */
void quicksort(int *toorder, int N)
{
    if (N < 2) {
        return;
    }
    size_t n = (size_t)N;
    if (n < 64) {
        insertion_sort(toorder, n);
        return;
    }
    int *scratch = (int *)malloc(n * sizeof(*scratch));
    if (scratch == NULL) {
        qsort(toorder, n, sizeof(*toorder), compare_ints);
        return;
    }
#ifdef _OPENMP
    if (n >= RADIX_PARALLEL_THRESHOLD && !omp_in_parallel()) {
        radix_sort_parallel(toorder, scratch, n);
    } else
#endif
    {
        radix_sort_serial(toorder, scratch, n);
    }
    free(scratch);
}

/*
 * Internal recursive function to quicksort
 */
void _quicksort(int *toorder, int lo, int hi)
{
    if (lo >= hi)
	return;
    int b = partition(toorder, lo, hi);
    _quicksort(toorder, lo, b - 1);
    _quicksort(toorder, b + 1, hi);
}

/*
 * Swap two values.
 */
void swap(int *toorder, int i, int j)
{
    int temp = toorder[i];
    toorder[i] = toorder[j];
    toorder[j] = temp;
}

/*
 * Partition decision
 */
int partition(int *toorder, int lo, int hi)
{
    int b = lo;
    int r = (int) (lo + (hi - lo) * (randnum() / MY_RAND_MAX));
    int pivot = toorder[r];
    swap(toorder, r, hi);
    for (int i = lo; i < hi; i++) {
	if (toorder[i] < pivot) {
	    swap(toorder, i, b);
	    b++;
	}
    }
    swap(toorder, hi, b);
    return b;
}

/*
 * Check if elements are in non-decreasing order
 */
int is_sorted(int *toorder, int N)
{
    for (int i = 1; i < N; i++) {
	if (toorder[i] < toorder[i - 1]) {
	    return 1;
	}
    }
    return 0;
}


/*
 * Generate a case
 */
int *generate_case(int N)
{
    int i;
    int *ret = NULL;

    // Make case generation reproducible
    srandnum(0);

    // Allocate memory
    ret = (int *) malloc(N * sizeof(int));
    if (ret == NULL) {
	printf("Error: some malloc won't work.\n");
	return NULL;
    }
    // Get pseudo-random positive integer values
    for (i = 0; i < N; i++) {
	ret[i] = drand(0, INT_MAX);
    }
    return ret;
}

/*
 * A pseudo-random number between two positive integer values
 */
double drand(int xmin, int xmax)
{
    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;
}

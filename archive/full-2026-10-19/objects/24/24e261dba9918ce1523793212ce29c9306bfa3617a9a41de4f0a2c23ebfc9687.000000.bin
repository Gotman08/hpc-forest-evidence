      "content": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nusing ll = long long;\n\nint matrix_values[1000][1000];\nint strip_prefix[1001][1000];\n\nstruct PrefixCounter {\n  static constexpr unsigned kCapacity = 2048;\n  static constexpr unsigned kMask = kCapacity - 1;\n\n  long long keys[kCapacity];\n  int counts[kCapacity];\n  uint32_t stamps[kCapacity] = {};\n  uint32_t epoch = 0;\n\n  static inline unsigned hash(long long value) {\n    uint64_t bits = static_cast<uint64_t>(value);\n    bits ^= bits >> 30;\n    bits *= 0xbf58476d1ce4e5b9ULL;\n    bits ^= bits >> 27;\n    bits *= 0x94d049bb133111ebULL;\n    bits ^= bits >> 31;\n    return static_cast<unsigned>(bits);\n  }\n\n  inline void begin_pair() {\n    ++epoch;\n  }\n\n  inline int get(long long key) const {\n    unsigned slot = hash(key) & kMask;\n    while (stamps[slot] == epoch) {\n      if (keys[slot] == key)\n        return counts[slot];\n      slot = (slot + 1) & kMask;\n    }\n    return 0;\n  }\n\n  inline void add(long long key) {\n    unsigned slot = hash(key) & kMask;\n    while (stamps[slot] == epoch) {\n      if (keys[slot] == key) {\n        ++counts[slot];\n        return;\n      }\n      slot = (slot + 1) & kMask;\n    }\n    stamps[slot] = epoch;\n    keys[slot] = key;\n    counts[slot] = 1;\n  }\n};\n\nll solve(int rows, int columns, int target) {\n  const bool pair_columns = columns <= rows;\n  const int pair_dimension = pair_columns ? columns : rows;\n  const int scan_dimension = pair_columns ? rows : columns;\n  ll answer = 0;\n\n#pragma omp parallel reduction(+ : answer)\n  {\n#pragma omp for schedule(static)\n    for (int scan = 0; scan < scan_dimension; ++scan) {\n      int running = 0;\n      strip_prefix[0][scan] = 0;\n      if (pair_columns) {\n        for (int pair = 0; pair < pair_dimension; ++pair) {\n          running += matrix_values[scan][pair];\n          strip_prefix[pair + 1][scan] = running;\n        }\n      } else {\n        for (int pair = 0; pair < pair_dimension; ++pair) {\n          running += matrix_values[pair][scan];\n          strip_prefix[pair + 1][scan] = running;\n        }\n      }\n    }\n\n    PrefixCounter frequency;\n\n#pragma omp for schedule(dynamic, 1)\n    for (int first = 0; first < pair_dimension; ++first) {\n      const int *const before = strip_prefix[first];\n      for (int after_index = first + 1; after_index <= pair_dimension;\n           ++after_index) {\n        const int *const after = strip_prefix[after_index];\n        frequency.begin_pair();\n        frequency.add(0);\n\n        ll sum = 0;\n        for (int scan = 0; scan < scan_dimension; ++scan) {\n          sum += static_cast<ll>(after[scan]) - before[scan];\n          answer += frequency.get(sum - target);\n          frequency.add(sum);\n        }\n      }\n    }\n  }\n\n  return answer;\n}\n\nint main() {\n  ios::sync_with_stdio(false);\n  cin.tie(nullptr);\n\n  int target, rows, columns;\n  cin >> target >> rows >> columns;\n\n  for (int row = 0; row < rows; ++row)\n    for (int column = 0; column < columns; ++column)\n      cin >> matrix_values[row][column];\n\n  cout << solve(rows, columns, target) << '\\n';\n  return 0;\n}\n",
      "path": "src/main.cpp"
    }
  ],
  "hypothesis": "Dynamically assigning whole first-strip ranges balances the triangular work without per-pair inverse-index overhead, while each worker reuses a fixed timestamped prefix-frequency table and reduces its local count safely.",
  "notes": "The table has capacity above twice the maximum number of scanned prefixes and stores arbitrary 64-bit prefix values, so it does not depend on a bounded sum range.",

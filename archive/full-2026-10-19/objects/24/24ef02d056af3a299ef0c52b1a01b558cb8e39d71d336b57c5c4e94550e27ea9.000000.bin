          "files": [
            "src/graph.c"
          ],
          "retained": [
            "Tokenize the requested node IDs serially and retain their original strings for output.",
            "Compute each requested node's cost in an OpenMP loop using dynamic scheduling with chunk size one, enabled only when there are at least four queries.",
            "Print computed results serially in original query order, preserving the existing output format."
          ]
        },

      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <algorithm>\n#include <limits>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nstatic long long bandMaximum(const std::vector<std::vector<int> >& matrix,\n                             int n, int s, int begin, int end) {\n    std::vector<long long> columns(n, 0);\n    for (int r = begin; r < begin + s; ++r) {\n        const int* row = matrix[r].data();\n        for (int c = 0; c < n; ++c)\n            columns[c] += row[c];\n    }\n\n    long long best = std::numeric_limits<long long>::lowest();\n    for (int top = begin; top < end; ++top) {\n        long long sum = 0;\n        for (int c = 0; c < s; ++c)\n            sum += columns[c];\n        best = std::max(best, sum);\n\n        for (int c = s; c < n; ++c) {\n            sum += columns[c] - columns[c - s];\n            best = std::max(best, sum);\n        }\n\n        if (top + 1 < end) {\n            const int* leaving = matrix[top].data();\n            const int* entering = matrix[top + s].data();\n            for (int c = 0; c < n; ++c)\n                columns[c] += static_cast<long long>(entering[c]) - leaving[c];\n        }\n    }\n    return best;\n}\n\nint main() {\n    int n, s;\n    std::cin >> n >> s;\n    std::vector<std::vector<int> > matrix(n, std::vector<int>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            scanf(\"%d\", &(matrix[i][j]));\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const int windowRows = n - s + 1;\n    int bands = 1;\n#ifdef _OPENMP\n    const int workBands = std::max(1, (n * n) / (256 * 1024));\n    bands = std::min(windowRows, std::min(omp_get_max_threads(), workBands));\n#endif\n\n    long long mxSum = std::numeric_limits<long long>::lowest();\n#pragma omp parallel for schedule(static) num_threads(bands) if(bands > 1) reduction(max:mxSum)\n    for (int band = 0; band < bands; ++band) {\n        const int begin = windowRows * band / bands;\n        const int end = windowRows * (band + 1) / bands;\n        const long long localMaximum = bandMaximum(matrix, n, s, begin, end);\n        mxSum = std::max(mxSum, localMaximum);\n    }\n\n    printf(\"%lld\\n\", mxSum);\n}\n",
      "path": "src/solution.cpp"
    }

#include <algorithm>
#include <cstddef>
#include <iostream>
#include <vector>

using namespace std;

static const int MOD = 1000000007;

static inline int add_mod(int a, int b) {
    const int sum = a + b;
    return sum >= MOD ? sum - MOD : sum;
}

// Intermediate rows stay in registers; only the bottom boundary is stored.
template <int Rows>
static inline void clear_span(int* dp, int begin, int end, int* left) {
    int a = left[0];
    int b = Rows > 1 ? left[1] : 0;
    int c = Rows > 2 ? left[2] : 0;
    int d = Rows > 3 ? left[3] : 0;

    for (int column = begin; column < end; ++column) {
        a = add_mod(a, dp[column]);
        int value = a;
        if (Rows > 1) {
            b = add_mod(b, value);
            value = b;
        }
        if (Rows > 2) {
            c = add_mod(c, value);
            value = c;
        }
        if (Rows > 3) {
            d = add_mod(d, value);
            value = d;
        }
        dp[column] = value;
    }

    left[0] = a;
    if (Rows > 1) left[1] = b;
    if (Rows > 2) left[2] = c;
    if (Rows > 3) left[3] = d;
}

template <int Rows>
static void process_band(vector<int>& dp, const vector<int>& obstacles) {
    int left[Rows] = {};
    int column = 0;
    size_t next = 0;

    while (next < obstacles.size()) {
        const int blocked_column = obstacles[next] >> 2;
        clear_span<Rows>(dp.data(), column, blocked_column, left);

        unsigned mask = 0;
        do {
            mask |= 1u << (obstacles[next] & 3);
            ++next;
        } while (next < obstacles.size() &&
                 (obstacles[next] >> 2) == blocked_column);

        int above = dp[blocked_column];
        for (int row = 0; row < Rows; ++row) {
            const int value = (mask & (1u << row))
                                  ? 0
                                  : add_mod(left[row], above);
            left[row] = value;
            above = value;
        }
        dp[blocked_column] = above;
        column = blocked_column + 1;
    }

    clear_span<Rows>(dp.data(), column, static_cast<int>(dp.size()), left);
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) return 0;

    const int band_count = (n + 3) / 4;
    vector<vector<int> > obstacles(band_count);
    for (int k = 0; k < m; ++k) {
        int row, column;
        cin >> row >> column;
        obstacles[row / 4].push_back((column << 2) | (row & 3));
    }

    vector<int> dp(n, 0);
    dp[0] = 1;

    for (int band = 0; band < band_count; ++band) {
        vector<int>& cells = obstacles[band];
        sort(cells.begin(), cells.end());

        const int rows = min(4, n - 4 * band);
        switch (rows) {
            case 4: process_band<4>(dp, cells); break;
            case 3: process_band<3>(dp, cells); break;
            case 2: process_band<2>(dp, cells); break;
            case 1: process_band<1>(dp, cells); break;
        }
    }

    cout << dp[n - 1] << '\n';
    return 0;
}

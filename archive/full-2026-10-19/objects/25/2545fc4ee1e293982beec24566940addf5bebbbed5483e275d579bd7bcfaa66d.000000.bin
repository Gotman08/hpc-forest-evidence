        "content": "#include <iostream>\n#include <vector>\n#include <utility>\n#include <cstddef>\n\nusing namespace std;\n\nstruct adjacency_matrix {\n    int vertices;\n    vector<unsigned char> cells;\n\n    explicit adjacency_matrix(int n)\n        : vertices(n), cells(static_cast<size_t>(n) * n, 0) {}\n\n    int size() const { return vertices; }\n\n    unsigned char *row(int i) {\n        return cells.data() + static_cast<size_t>(i) * vertices;\n    }\n\n    const unsigned char *row(int i) const {\n        return cells.data() + static_cast<size_t>(i) * vertices;\n    }\n};\n\nadjacency_matrix readGraph();\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2);\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence);\ninline void printPermutation(const vector<int> &equivalence);\n\nint main() {\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if (!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nadjacency_matrix readGraph() {\n    int vertices, edges, source, destination;\n    cin >> vertices;\n    adjacency_matrix graph(vertices);\n\n    cin >> edges;\n    for (int i = 0; i < edges; ++i) {\n        cin >> source >> destination;\n        graph.row(source)[destination] = graph.row(destination)[source] = 1;\n    }\n    return graph;\n}\n\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence) {\n    for (int i = 0; i < static_cast<int>(equivalence.size()); ++i) {\n        const unsigned char *first = g1.row(i);\n        const unsigned char *second = g2.row(equivalence[i]);\n        for (int j = 0; j <= i; ++j) {\n            if (first[j] != second[equivalence[j]])\n                return false;\n        }\n    }\n    return true;\n}\n\ninline void printPermutation(const vector<int> &equivalence) {\n    for (auto i : equivalence)\n        cout << i << \" \";\n    cout << endl;\n}\n\nnamespace {\n\nclass HeapBlockSearch {\n    const adjacency_matrix &g1;\n    const adjacency_matrix &g2;\n    vector<int> &equivalence;\n    const vector<int> &labels1;\n    const vector<int> &labels2;\n    int n;\n    bool isomorphism_found;\n\n    bool compatible(int position) const {\n        const int image = equivalence[position];\n        if (labels1[position] != labels2[image])\n            return false;\n\n        const unsigned char *first = g1.row(position);\n        const unsigned char *second = g2.row(image);\n        for (int j = position + 1; j < n; ++j) {\n            if (first[j] != second[equivalence[j]])\n                return false;\n        }\n        return true;\n    }\n\n    void finishBlock(int prefix) {\n        if (prefix <= 1)\n            return;\n\n        // Exact terminal rearrangement of a recursive Heap block.\n        if ((prefix & 1) != 0 || prefix == 2) {\n            swap(equivalence[0], equivalence[prefix - 1]);\n            return;\n        }\n\n        // Even k >= 4 ends at [k-3, k-2, 1, ..., k-4, k-1, 0].\n        const int first = equivalence[0];\n        const int third_last = equivalence[prefix - 3];\n        const int second_last = equivalence[prefix - 2];\n        const int last = equivalence[prefix - 1];\n        for (int i = prefix - 3; i >= 2; --i)\n            equivalence[i] = equivalence[i - 1];\n        equivalence[0] = third_last;\n        equivalence[1] = second_last;\n        equivalence[prefix - 2] = last;\n        equivalence[prefix - 1] = first;\n    }\n\n    void visit(int prefix) {\n        // Positions at and above prefix remain fixed throughout this block.\n        // Higher suffix rows were already checked by ancestor blocks.\n        if (prefix < n && !compatible(prefix)) {\n            finishBlock(prefix);\n            return;\n        }\n\n        if (prefix <= 1) {\n            if (compatible(0)) {\n                printPermutation(equivalence);\n                isomorphism_found = true;\n            }\n            return;\n        }\n\n        visit(prefix - 1);\n        for (int i = 0; i < prefix - 1; ++i) {\n            swap(equivalence[(prefix & 1) == 0 ? i : 0],\n                 equivalence[prefix - 1]);\n            visit(prefix - 1);\n        }\n    }\n\npublic:\n    HeapBlockSearch(const adjacency_matrix &first, const adjacency_matrix &second,\n                    vector<int> &permutation, const vector<int> &first_labels,\n                    const vector<int> &second_labels)\n        : g1(first), g2(second), equivalence(permutation),\n          labels1(first_labels), labels2(second_labels), n(first.size()),\n          isomorphism_found(false) {}\n\n    bool run() {\n        visit(n);\n        return isomorphism_found;\n    }\n};\n\n}\n\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2) {\n    if (g1.size() != g2.size())\n        return false;\n\n    const int n = g1.size();\n    vector<int> equivalence(n);\n    for (int i = 0; i < n; ++i)\n        equivalence[i] = i;\n\n    if (verifyPermutation(g1, g2, equivalence)) {\n        printPermutation(equivalence);\n        return true;\n    }\n\n    vector<int> labels1(n), labels2(n);\n    vector<int> label_counts(2 * (n + 1), 0);\n    for (int i = 0; i < n; ++i) {\n        const unsigned char *first = g1.row(i);\n        const unsigned char *second = g2.row(i);\n        int degree1 = 0;\n        int degree2 = 0;\n        for (int j = 0; j < n; ++j) {\n            degree1 += first[j];\n            degree2 += second[j];\n        }\n        // Count Boolean neighbors, not input edges; retain loop information.\n        labels1[i] = 2 * degree1 + first[i];\n        labels2[i] = 2 * degree2 + second[i];\n        ++label_counts[labels1[i]];\n        --label_counts[labels2[i]];\n    }\n    for (int count : label_counts) {\n        if (count != 0)\n            return false;\n    }\n\n    HeapBlockSearch search(g1, g2, equivalence, labels1, labels2);\n    return search.run();\n}\n",

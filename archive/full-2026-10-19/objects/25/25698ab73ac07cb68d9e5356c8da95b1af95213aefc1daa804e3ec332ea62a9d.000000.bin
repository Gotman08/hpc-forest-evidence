#ifndef KNN_H
#define KNN_H

#include <stdio.h>
#include <stdlib.h>

typedef struct {
    float x;
    float y;
} Point;

typedef struct {
    int n;          // total number of points
    float *xs;
    float *ys;
    char *labels;
} Dataset;

void on_error() {
    printf("Invalid input file.\n");
    exit(1);
}

int parse_k() {
    int k;
    if (scanf(" k=%d ", &k) != 1) on_error();
    return k;
}

Point parse_point() {
    float x, y;
    if (scanf(" (%f ,%f) ", &x, &y) != 2) on_error();
    Point p = {x, y};
    return p;
}

Dataset *parse_dataset() {
    int n_groups;
    if (scanf(" n_groups=%d ", &n_groups) != 1) on_error();

    Dataset *ds = (Dataset *)malloc(sizeof(Dataset));
    ds->n = 0;
    ds->xs = NULL;
    ds->ys = NULL;
    ds->labels = NULL;

    for (int g = 0; g < n_groups; ++g) {
        char label;
        int length;
        if (scanf(" label=%c ", &label) != 1) on_error();
        if (scanf(" length=%d ", &length) != 1) on_error();

        for (int i = 0; i < length; ++i) {
            float x, y;
            if (scanf(" (%f ,%f) ", &x, &y) != 2) on_error();
            int idx = ds->n++;
            ds->xs = (float *)realloc(ds->xs, sizeof(float) * ds->n);
            ds->ys = (float *)realloc(ds->ys, sizeof(float) * ds->n);
            ds->labels = (char *)realloc(ds->labels, sizeof(char) * ds->n);
            if (!ds->xs || !ds->ys || !ds->labels) on_error();
            ds->xs[idx] = x;
            ds->ys[idx] = y;
            ds->labels[idx] = label;
        }
    }
    return ds;
}

int compare_for_sort(const void *a, const void *b) {
  return *(char*)a - *(char*)b;
}

#endif

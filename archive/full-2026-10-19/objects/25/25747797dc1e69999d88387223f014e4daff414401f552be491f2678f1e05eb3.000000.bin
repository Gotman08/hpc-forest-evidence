"""Cold ROOT-effect review only: hashes/JSON/text, no received code execution."""
import ast
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import shlex
import stat

HERE = Path(__file__).resolve().parent
OWN = HERE.parent
OP = OWN.parent
PREP = OP.parent
BASE = PREP.parents[1]
CHAIN = PREP / "adaptateurs-source110-r1/revision-r7-racines-techniques-neuves"
TRANSFER = OP / "partage-R7-execution-root-01"
SCHEDULER = OP / "preparation-scheduler-R7-root-01"
SHARED = "/scratch_p/nimarano/hpc-forest-dynamic-r4b-lane-r3-r7-5c3cc0082589"
SOURCE = "eaff9217499fe268e4d151165a368a83bad1550d921955a9f9256026cfac2d48"
PLAN = "5c3cc0082589257897caf79caf90c678f931eefcecb823f315ef614f72b9de70"
Q_SHA = "8e2d49e0a0db87c5ad0d44b95816d488dea43542f1c69aedc077d046b78dd652"
RAW_SHA = "5c1e1784574566a585e2d9cc50f85b52337d10d3109e449a4112581eae68f8d5"
RAW_SOURCE = PREP / "qualification-allouee-source110-G-recu-r1/revue-resultats-Q753709-r1/lecteur-r4b/auditer-restauration-existante-r4b.py"
names = {"need", "ordinary", "metadata", "open_nofollow_read", "cross_identity", "validate_windows_mode_views", "native_basic_info", "raw", "decode"}
source = RAW_SOURCE.read_bytes()
assert hashlib.sha256(source).hexdigest() == RAW_SHA
nodes = [node for node in ast.parse(source).body if isinstance(node, ast.FunctionDef) and node.name in names]
assert {node.name for node in nodes} == names
held = {"Path": Path, "os": os, "stat": stat, "Q": BASE, "json": json}
exec(compile(ast.Module(body=nodes, type_ignores=[]), str(RAW_SOURCE), "exec"), held)
before = {str(RAW_SOURCE): RAW_SHA}


def raw(path):
    path = Path(path)
    data = held["raw"](path)
    digest = hashlib.sha256(data).hexdigest()
    assert before.get(str(path), digest) == digest, "Input changed between cold reads"
    before[str(path)] = digest
    return data


def read(path):
    return held["decode"](raw(path))


def reference(value):
    assert isinstance(value, dict) and set(value) == {"path", "sha256"}
    data = raw(value["path"])
    assert hashlib.sha256(data).hexdigest() == value["sha256"]
    return data


def result(path):
    value = read(path)["result"]
    assert value.get("isError") is False
    obj = value["structuredContent"]
    texts = [item["text"] for item in value["content"] if item.get("type") == "text"]
    assert len(texts) == 1 and json.loads(texts[0]) == obj and obj["ok"] is True
    return obj


def inventory(directory):
    directory = held["ordinary"](directory)
    rows = {}
    for path in sorted(directory.rglob("*")):
        info = path.lstat()
        assert not path.is_symlink() and not (getattr(info, "st_file_attributes", 0) & 1024)
        if stat.S_ISREG(info.st_mode):
            data = raw(path)
            rows[path.relative_to(directory).as_posix()] = {"sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data)}
        else:
            assert stat.S_ISDIR(info.st_mode)
    return rows


local_receipt_path = OWN / "partage-source113-01/SHARED-117-LOCAL-PRET-POUR-TRANSFERT.json"
local_receipt = read(local_receipt_path)
assert before[str(local_receipt_path)] == "565320a9ee372b9aa11c9f1177f1ba6bc24006178620d293cc37f8310b003f46"
assert local_receipt["actual_mechanical_reception"]["sha256"] == Q_SHA
composite = json.loads(reference(local_receipt["actual_mechanical_reception"]))
assert composite["source_zip_sha256"] == SOURCE and composite["plan_sha256"] == PLAN
expected = local_receipt["inventory"]
assert len(expected) == 117 and local_receipt["regular_payload_files"] == 117
assert inventory(local_receipt["local_group"]) == expected
received_directory = TRANSFER / "readback-117"
assert inventory(received_directory) == expected
assert read(TRANSFER / "INVENTAIRE-117-AVANT.json") == expected
assert read(TRANSFER / "INVENTAIRE-117-APRES.json") == expected
manifest = read(received_directory / "runtime-manifest.json")
assert len(manifest) == 110
assert {name.removeprefix("project/"): value["sha256"] for name, value in expected.items() if name.startswith("project/")} == manifest
native_q = read(received_directory / "mechanical-reception-native.json")
assert set(native_q) == set(composite)
for key in composite:
    if key in {"archive", "qualification", "independent_audit"}:
        assert native_q[key]["sha256"] == composite[key]["sha256"]
        assert native_q[key]["path"] == SHARED + "/" + {"archive": "qualification-result.tar.gz", "qualification": "qualification.json", "independent_audit": "independent-mechanical-audit.json"}[key]
    else:
        assert native_q[key] == composite[key]
upload = result(TRANSFER / "UPLOAD-117-REEL.json")
download = result(TRANSFER / "READBACK-117.json")
assert Path(upload["sent"]) == Path(local_receipt["local_group"]) and upload["to"] == SHARED
assert upload["verifie"] is False and upload["remote_sha256"] is None
assert download["downloaded"] == SHARED and Path(download["to"]) == received_directory
assert download["verifie"] is False and download["remote_sha256"] is None
assert upload["bytes"] == sum(row["bytes"] for row in expected.values())
checks_path = TRANSFER / "QUALIFIED-CHECKS-R7-REELS.json"
checks = read(checks_path)
assert before[str(checks_path)] == "00b2637b0b36ead81a3e74f15b437fe65b65eb3365c5fd8b43480a23daf21dba"
assert checks["schema"] == "hpc-forest-source110-shared-qualified-checks-v1"
assert checks["verified_received_checks_only"] is True and checks["native_generation_admitted"] is False
assert checks["directory_hash_claimed"] is False
qualified_names = ("project.zip", "dynamic-plan.json", "qualification-result.tar.gz", "qualification.json")
assert len(checks["existing_qualified_files"]) == 4
for index, name in enumerate(qualified_names):
    row = checks["existing_qualified_files"][index]
    assert row["remote_path"] == SHARED + "/" + name
    digest = expected[name]["sha256"]
    assert row["sha256"] == digest and row["actual_remote_checksum_verified"] is True
    assert len(row["evidence_refs"]) == 2
    for ref in row["evidence_refs"]:
        reference(ref)
    raw_path = TRANSFER / ("SHA-REEL-" + str(index) + ".json")
    current = result(raw_path)
    assert row["evidence_refs"][0]["path"] == str(raw_path)
    assert current["verifie"] is True and current["downloaded"] == row["remote_path"]
    target = TRANSFER / "sha-reels-quatre" / name
    assert Path(current["to"]) == target
    assert all(current[field] == digest for field in ("remote_sha256", "empreinte_locale", "empreinte_distante"))
    assert hashlib.sha256(raw(target)).hexdigest() == digest and current["bytes"] == expected[name]["bytes"]
for key in ("inventory_before", "inventory_after", "local_payload_receipt", "actual_directory_upload", "actual_directory_readback", "actual_separate_stage_transfer"):
    reference(checks[key])
stage = result(TRANSFER / "STAGE-ARCHIVE-UPLOAD.json")
stage_expected = local_receipt["stage_archive_outside_shared"]
assert stage["verifie"] is True and stage["to"] == stage_expected["remote_path"]
assert Path(stage["sent"]) == Path(stage_expected["local_path"])
assert all(stage[field] == stage_expected["sha256"] for field in ("remote_sha256", "empreinte_locale", "empreinte_distante"))
assert hashlib.sha256(raw(stage["sent"])).hexdigest() == stage_expected["sha256"]

q_get = result(OP / "qualification-r7-execution-root-01/PLAN-RELU-REEL.json")
q_plan = q_get["plan"]["entries"][0]["plan"]
q_command = q_plan["spec"]["command"]
q_script = q_plan["script"]
assert q_script.count(q_command) == 1
q_prefix, q_footer = q_script.split(q_command)
q_prologue = q_prefix[q_prefix.index("set -euo pipefail\n"):]
assert q_footer == '\necho "[romeo-mcp] fin $(date -Is)"\n'
script_records = []
for slug in ("sol-max", "astra-max", "terra-max"):
    folder = SCHEDULER / slug
    prepared, reread = result(folder / "PLAN-PREPARE-REEL.json"), result(folder / "PLAN-RELU-REEL.json")
    review = read(folder / "REVUE-SCRIPT-REEL-ROOT.json")
    for ref in review["evidence_refs"]:
        reference(ref)
    reference(review["whole_MCP_prologue_independent_review"])
    assert prepared["submitted"] is False and review["submitted"] is False and review["native_generation_admitted"] is False
    assert prepared["plan_id"] == reread["plan_id"] == review["plan_id"]
    assert prepared["plan_sha256"] == reread["plan_sha256"] == review["scheduler_plan_sha256"]
    assert reread["state"] == "ready" and reread["expired"] is False and reread["result"] is None
    assert len(reread["plan"]["entries"]) == 1
    current = reread["plan"]["entries"][0]["plan"]
    script, spec = current["script"], current["spec"]
    assert script == prepared["script"] and hashlib.sha256(script.encode()).hexdigest() == review["script_sha256"]
    body_path = CHAIN / "launcher" / slug / "roots/commande-allouee.sh"
    body = raw(body_path).decode("utf8")
    assert hashlib.sha256(body.encode()).hexdigest() == review["command_sha256"]
    command = spec["command"]
    assert command == "bash -lc " + shlex.quote(body) and shlex.split(command) == ["bash", "-lc", body]
    assert script.count(command) == 1
    prefix, footer = script.split(command)
    assert prefix[prefix.index("set -euo pipefail\n"):] == q_prologue
    assert footer == "\n" + q_footer
    assert current["seconds"] == 3600 and spec["time"] == "01:00:00"
    assert all(spec[key] == value for key, value in {"nodes": 1, "ntasks_per_node": 1, "cpus_per_task": 4, "mem_gb": 16, "gpus_per_node": 0, "gpus_per_task": 0, "data_files": [], "arch": "armgpu"}.items())
    assert review["schema"] == "hpc-forest-dynamic-r4b-scheduler-script-readback-v1"
    assert review["verified"] is True and review["exact_script_command_verified"] is True
    script_records.append({"model_slug": slug, "plan_id": review["plan_id"], "scheduler_plan_sha256": review["scheduler_plan_sha256"], "script_sha256": review["script_sha256"], "command_sha256": review["command_sha256"], "allocation_seconds": 3600, "cpus": 4, "memory_MiB": 16384, "gpus": 0, "warnings_preserved": prepared["warnings"], "submitted_in_received_plan": False})
for filename in ("PREMIER-REFUS-FOOTER.json", "SECOND-REFUS-WRAPPER.json"):
    refusal = read(SCHEDULER / filename)
    assert refusal["submitted"] is False and refusal["actual_script_or_plan_changed"] is False
frozen_before = dict(before)
after = {path: hashlib.sha256(held["raw"](path)).hexdigest() for path in frozen_before}
assert frozen_before == after
report = {"schema": "hpc-forest-r7-cold-root-shared-and-plans-effect-review-v1", "verified_received_bytes_and_prepared_plans_only": True, "blocking_findings": [], "reviewed_at_utc": datetime.now(timezone.utc).isoformat(), "reviewer_authored_local_payload": True, "independence_scope": "Author of local payload; independent cold inspection of actual ROOT MCP effects and scheduler readbacks, no self-claim of remote operation", "source_zip_sha256": SOURCE, "plan_sha256": PLAN, "mechanical_reception_sha256": Q_SHA, "received_regular_files": 117, "source_files_exact": 110, "all117_readback_bytes_equal_local_manifest": True, "four_actual_remote_file_SHA_triplets_equal": True, "separate_stage_actual_SHA_triplet_equal": True, "directory_hash_claimed": False, "native_receipt_only_three_POSIX_refs_changed": True, "qualified_checks_ref": {"path": str(checks_path), "sha256": before[str(checks_path)]}, "prepared_scripts": script_records, "full_scripts_equal_exact_MCP_prologue_plus_canonical_bash_wrapper_and_exact_footer": True, "first_two_comparison_refusals_preserved": True, "inputs_before": frozen_before, "inputs_after": after, "inputs_before_after_identical": True, "reviewer_received_code_execution_or_test_replay": False, "reviewer_MCP_CLI_CIM_process_or_model_effect": False, "fresh_capacity_OAuth_OBS4_or_native_admission_established": False, "native_generation_admitted": False}
with (HERE / "REVUE-EFFETS-REELS-PARTAGE-ET-PLANS-R7.json").open("x", encoding="utf8", newline="\n") as stream:
    json.dump(report, stream, indent=2)
    stream.write("\n")
print(json.dumps({"verified_received_bytes_and_prepared_plans_only": True, "files": 117, "qualified_SHA_files": 4, "prepared_scripts": 3, "stable_inputs": len(frozen_before), "native_generation_admitted": False}))

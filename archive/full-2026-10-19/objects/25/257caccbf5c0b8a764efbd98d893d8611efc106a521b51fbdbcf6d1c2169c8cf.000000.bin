"""Prove byte identity of final images against images actually viewed in build2."""
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent


def read(path):
    return json.loads(path.read_text(encoding="utf-8-sig"))


def ref(path):
    data = path.read_bytes()
    return {"path": str(path), "sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data)}


def main():
    target = HERE / "IDENTITE-PIXELS-BUILD2-BUILD3.json"
    assert not target.exists()
    partial_path = HERE / "REVUE-PARTIELLE-BUILD2-ANNEXES.json"
    child_path = HERE / "SOUS-REVUE-VISUELLE-40-52.json"
    assert ref(partial_path)["sha256"] == "3ac81aefff2134e8ff7a4ec07d408a9dfc40c0286727f8c2347395f8c58e7ef7"
    assert ref(child_path)["sha256"] == "8c09de8c95e202457c03cac9eeffaf372037d8fa3f54da9f624275598ec978d5"
    partial, child = read(partial_path), read(child_path)
    plan_path = HERE.parent / "PLAN-REVUE-VISUELLE-FINAL.json"
    plan = read(plan_path)
    expected = {"ARTICLE.pdf": "2c8c3b90eee195a0fcefcb86f41affe6bafee01f8d41d31cfab7207412034bd6", "ANNEXES-TECHNIQUES.pdf": "550aac04c9ab30d4e2ac10d000d45345b9e979a21b79b7f1ace182e62bf7ea0f"}
    for row in plan["pdfs"]:
        assert row["sha256"] == expected[Path(row["path"]).name]
        assert ref(Path(row["path"]))["sha256"] == row["sha256"]
    old_rows = [(r, "personal_build2", ref(partial_path)) for r in partial["contact_sheets_personally_viewed"]]
    old_rows += [(r, "delegated_build2", ref(child_path)) for r in child["contact_sheets"]]
    assert len(old_rows) == 26
    current = {Path(r["path"]).name: r for r in plan["contacts"]}
    compared = []
    for old, reviewer, evidence in old_rows:
        new = current[Path(old["path"]).name]
        previous_actual, final_actual = ref(Path(old["path"])), ref(Path(new["path"]))
        assert previous_actual["sha256"] == old["sha256"]
        assert final_actual["sha256"] == new["sha256"]
        compared.append({"previous_actually_viewed": previous_actual, "final_image": final_actual,
                         "document": new["document"], "first_page": new["first_page"], "last_page": new["last_page"],
                         "same_bytes": previous_actual["sha256"] == final_actual["sha256"],
                         "actual_review_provenance": reviewer, "previous_review_receipt": evidence})
    value = {"schema": "hpc-forest-sol-final-pixels-byte-identity-v1", "final_plan": ref(plan_path), "pdfs": plan["pdfs"],
             "comparisons": compared, "identical_contact_sheets": sum(r["same_bytes"] for r in compared),
             "changed_contact_sheets_requiring_actual_view": [r["final_image"] for r in compared if not r["same_bytes"]],
             "does_not_claim_new_view_of_unopened_files": True}
    target.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(json.dumps({**ref(target), "same": value["identical_contact_sheets"], "changed": value["changed_contact_sheets_requiring_actual_view"]}))


if __name__ == "__main__":
    main()

        "epoch": 1,
        "hypothesis": "A reusable row bitmap enumerates obstacles in column order without sorting, allowing contiguous obstacle-free DP runs with no per-cell obstacle lookup.",
        "id": "c1b3fa7daf924afe",
        "ordinal": 2,
        "parent_id": null,

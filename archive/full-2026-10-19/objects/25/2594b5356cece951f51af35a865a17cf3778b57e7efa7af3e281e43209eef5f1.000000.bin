        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system.\n */\nvoid body_force(Body *p, float dt, int n) {\n  int i = 0;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n  const float32x4_t softening = vdupq_n_f32(SOFTENING);\n  const float64x2_t one = vdupq_n_f64(1.0);\n\n  /* Two target vectors share source broadcasts, with independent sums. */\n  for (; n - i >= 8; i += 8) {\n    const float32x4_t tx0 = {p[i].x, p[i + 1].x,\n                             p[i + 2].x, p[i + 3].x};\n    const float32x4_t ty0 = {p[i].y, p[i + 1].y,\n                             p[i + 2].y, p[i + 3].y};\n    const float32x4_t tz0 = {p[i].z, p[i + 1].z,\n                             p[i + 2].z, p[i + 3].z};\n    const float32x4_t tx1 = {p[i + 4].x, p[i + 5].x,\n                             p[i + 6].x, p[i + 7].x};\n    const float32x4_t ty1 = {p[i + 4].y, p[i + 5].y,\n                             p[i + 6].y, p[i + 7].y};\n    const float32x4_t tz1 = {p[i + 4].z, p[i + 5].z,\n                             p[i + 6].z, p[i + 7].z};\n    float32x4_t fx0 = vdupq_n_f32(0.0f);\n    float32x4_t fy0 = vdupq_n_f32(0.0f);\n    float32x4_t fz0 = vdupq_n_f32(0.0f);\n    float32x4_t fx1 = vdupq_n_f32(0.0f);\n    float32x4_t fy1 = vdupq_n_f32(0.0f);\n    float32x4_t fz1 = vdupq_n_f32(0.0f);\n\n    for (int j = 0; j < n; j++) {\n      const float32x4_t sx = vdupq_n_f32(p[j].x);\n      const float32x4_t sy = vdupq_n_f32(p[j].y);\n      const float32x4_t sz = vdupq_n_f32(p[j].z);\n      float32x4_t dx0 = sx - tx0;\n      float32x4_t dy0 = sy - ty0;\n      float32x4_t dz0 = sz - tz0;\n      float32x4_t dx1 = sx - tx1;\n      float32x4_t dy1 = sy - ty1;\n      float32x4_t dz1 = sz - tz1;\n      float32x4_t sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + softening;\n      float32x4_t sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + softening;\n\n      /* Expose independent double-precision square roots and divisions. */\n      float64x2_t root0_lo = vsqrtq_f64(vcvt_f64_f32(vget_low_f32(sqrd_dist0)));\n      float64x2_t root0_hi = vsqrtq_f64(vcvt_f64_f32(vget_high_f32(sqrd_dist0)));\n      float64x2_t root1_lo = vsqrtq_f64(vcvt_f64_f32(vget_low_f32(sqrd_dist1)));\n      float64x2_t root1_hi = vsqrtq_f64(vcvt_f64_f32(vget_high_f32(sqrd_dist1)));\n      float64x2_t inv0_lo = vdivq_f64(one, root0_lo);\n      float64x2_t inv0_hi = vdivq_f64(one, root0_hi);\n      float64x2_t inv1_lo = vdivq_f64(one, root1_lo);\n      float64x2_t inv1_hi = vdivq_f64(one, root1_hi);\n      float32x4_t inv_dist0 = vcombine_f32(vcvt_f32_f64(inv0_lo),\n                                          vcvt_f32_f64(inv0_hi));\n      float32x4_t inv_dist1 = vcombine_f32(vcvt_f32_f64(inv1_lo),\n                                          vcvt_f32_f64(inv1_hi));\n      float32x4_t inv_dist3_0 = inv_dist0 * inv_dist0 * inv_dist0;\n      float32x4_t inv_dist3_1 = inv_dist1 * inv_dist1 * inv_dist1;\n\n      /* Every target retains the original ascending source order. */\n      fx0 += dx0 * inv_dist3_0;\n      fy0 += dy0 * inv_dist3_0;\n      fz0 += dz0 * inv_dist3_0;\n      fx1 += dx1 * inv_dist3_1;\n      fy1 += dy1 * inv_dist3_1;\n      fz1 += dz1 * inv_dist3_1;\n    }\n\n    float fx_lane[8], fy_lane[8], fz_lane[8];\n    vst1q_f32(fx_lane, fx0);\n    vst1q_f32(fx_lane + 4, fx1);\n    vst1q_f32(fy_lane, fy0);\n    vst1q_f32(fy_lane + 4, fy1);\n    vst1q_f32(fz_lane, fz0);\n    vst1q_f32(fz_lane + 4, fz1);\n    for (int lane = 0; lane < 8; ++lane) {\n      p[i + lane].vx += dt*fx_lane[lane];\n      p[i + lane].vy += dt*fy_lane[lane];\n      p[i + lane].vz += dt*fz_lane[lane];\n    }\n  }\n\n  /* Lanes represent independent targets, never a source reduction. */\n  for (; n - i >= 4; i += 4) {\n    const float32x4_t tx = {p[i].x, p[i + 1].x,\n                            p[i + 2].x, p[i + 3].x};\n    const float32x4_t ty = {p[i].y, p[i + 1].y,\n                            p[i + 2].y, p[i + 3].y};\n    const float32x4_t tz = {p[i].z, p[i + 1].z,\n                            p[i + 2].z, p[i + 3].z};\n    float32x4_t fx = vdupq_n_f32(0.0f);\n    float32x4_t fy = vdupq_n_f32(0.0f);\n    float32x4_t fz = vdupq_n_f32(0.0f);\n\n    for (int j = 0; j < n; j++) {\n      float32x4_t dx = vdupq_n_f32(p[j].x) - tx;\n      float32x4_t dy = vdupq_n_f32(p[j].y) - ty;\n      float32x4_t dz = vdupq_n_f32(p[j].z) - tz;\n      /* Keep the original expression grouping and compiler contraction policy. */\n      float32x4_t sqrd_dist = dx*dx + dy*dy + dz*dz + softening;\n\n      /* sqrt and reciprocal are double precision, as in the scalar code. */\n      float64x2_t dist_lo = vcvt_f64_f32(vget_low_f32(sqrd_dist));\n      float64x2_t dist_hi = vcvt_f64_f32(vget_high_f32(sqrd_dist));\n      float64x2_t inv_lo = vdivq_f64(one, vsqrtq_f64(dist_lo));\n      float64x2_t inv_hi = vdivq_f64(one, vsqrtq_f64(dist_hi));\n      float32x4_t inv_dist = vcombine_f32(vcvt_f32_f64(inv_lo),\n                                         vcvt_f32_f64(inv_hi));\n      float32x4_t inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    float fx_lane[4], fy_lane[4], fz_lane[4];\n    vst1q_f32(fx_lane, fx);\n    vst1q_f32(fy_lane, fy);\n    vst1q_f32(fz_lane, fz);\n    for (int lane = 0; lane < 4; ++lane) {\n      p[i + lane].vx += dt*fx_lane[lane];\n      p[i + lane].vy += dt*fy_lane[lane];\n      p[i + lane].vz += dt*fz_lane[lane];\n    }\n  }\n#endif\n\n  /* Scalar tail, also used for the complete kernel without AArch64 NEON. */\n  for (; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n  \n  exit(EXIT_SUCCESS);\n}\n",
        "path": "src/nbody.c"
      }

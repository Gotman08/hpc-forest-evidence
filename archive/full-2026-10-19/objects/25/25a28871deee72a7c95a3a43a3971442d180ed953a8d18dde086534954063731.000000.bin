#include <stdio.h>
#include <stdlib.h>
#include <omp.h>
#include <limits.h>

#define MAX_K 128

typedef struct {
    float x;
    float y;
} Point;

typedef struct {
    char label;
    int length;
    Point * points;
} Group;

typedef struct {
    float dists[MAX_K];
    char lbls[MAX_K];
    int first_gid;  // smallest group index in this partial result
} TopK;

void on_error() {
    printf("Invalid input file.\n");
    exit(1);
}

int parse_number_of_groups() {
    int n;
    if (scanf(" n_groups=%d ", &n) != 1) on_error();
    return n;
}

Point parse_point() {
    float x, y;
    if (scanf(" (%f ,%f) ", &x, &y) != 2)  on_error();
    Point point;
    point.x = x;
    point.y = y;
    return point;
}

Group parse_next_group() {
    char label; 
    int length;
    if (scanf(" label=%c ", &label) != 1) on_error();
    if (scanf(" length=%d ", &length) != 1) on_error();
    Group group;
    group.label = label;
    group.length = length;
    group.points = (Point *) malloc(sizeof(Point) * length);
    for (int i = 0; i < length; i++) {
        group.points[i] = parse_point();
    }
    return group;
}

int parse_k() {
    int k;
    if (scanf(" k=%d ", &k) != 1) on_error();
    return k;
}

float euclidean_distance_no_sqrt (Point a, Point b) {
    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));
}

int compare_for_sort(const void *a, const void *b) {
  return *(char*)a - *(char*)b;
}

void init_TopK(TopK *t) {
    for (int i = 0; i < MAX_K; i++) {
        t->dists[i] = -1.0f;
        t->lbls[i] = -1;
    }
    t->first_gid = INT_MAX;
}

void merge_topk_into(TopK *dst, TopK *src) {
    // Ensure dst contains points from earlier groups (smaller first_gid)
    if (src->first_gid < dst->first_gid) {
        TopK tmp = *dst;
        *dst = *src;
        *src = tmp;
    }
    // Now src has larger or equal first_gid; insert its entries into dst
    for (int i = 0; i < MAX_K; i++) {
        if (src->dists[i] == -1.0f) continue;
        float d = src->dists[i];
        char lbl = src->lbls[i];
        // Insert into dst using same insertion logic as serial code
        for (int x = 0; x < MAX_K; x++) {
            if (d < dst->dists[x] || dst->dists[x] == -1.0f) {
                for (int y = MAX_K - 1; y > x; y--) {
                    dst->dists[y] = dst->dists[y-1];
                    dst->lbls[y] = dst->lbls[y-1];
                }
                dst->dists[x] = d;
                dst->lbls[x] = lbl;
                break;
            }
        }
    }
}

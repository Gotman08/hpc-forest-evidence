    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n#include <omp.h>\\n#include <string.h>\\n\\ntypedef struct {\\n    float d;\\n    int idx;\\n} Candidate;\\n\\nstatic int compare_candidates(const void *a, const void *b) {\\n    const Candidate *ca = (const Candidate *)a;\\n    const Candidate *cb = (const Candidate *)b;\\n    if (ca->d < cb->d) return -1;\\n    if (ca->d > cb->d) return 1;\\n    if (ca->idx < cb->idx) return -1;\\n    if (ca->idx > cb->idx) return 1;\\n    return 0;\\n}\\n\\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n    // Compute total number of points\\n    int total = 0;\\n    for (int i = 0; i < n_groups; i++) total += groups[i].length;\\n\\n    // Flatten points and labels into contiguous arrays\\n    Point * all_points = (Point *) malloc(sizeof(Point) * total);\\n    char * all_labels = (char *) malloc(sizeof(char) * total);\\n    int pos = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n        for (int j = 0; j < g.length; j++) {\\n            all_points[pos] = g.points[j];\\n            all_labels[pos] = g.label;\\n            pos++;\\n        }\\n    }\\n\\n    int nt = omp_get_max_threads();\\n    Candidate ** local_tops = (Candidate **) malloc(sizeof(Candidate *) * nt);\\n    int * local_sizes = (int *) calloc(nt, sizeof(int));\\n    for (int t = 0; t < nt; t++) {\\n        local_tops[t] = (Candidate *) malloc(sizeof(Candidate) * k);\\n    }\\n\\n    #pragma omp parallel\\n    {\\n        int tid = omp_get_thread_num();\\n        int nthreads = omp_get_num_threads();\\n        // Static contiguous partition for balanced work sharing\\n        int chunk = (total + nthreads - 1) / nthreads;\\n        int start = tid * chunk;\\n        int end = start + chunk;\\n        if (end > total) end = total;\\n\\n        Candidate * top = local_tops[tid];\\n        int size = 0;\\n\\n        for (int i = start; i < end; i++) {\\n            float d = euclidean_distance_no_sqrt(to_evaluate, all_points[i]);\\n            Candidate cand;\\n            cand.d = d;\\n            cand.idx = i;\\n\\n            // Insert into sorted per-thread top-k list (by distance, then index)\\n            int p = 0;\\n            while (p < size && compare_candidates(&top[p], &cand) <= 0) {\\n                p++;\\n            }\\n            if (p < size || size < k) {\\n                int max_idx = (size < k ? size : k - 1);\\n                for (int q = max_idx; q > p; q--) {\\n                    top[q] = top[q - 1];\\n                }\\n                top[p] = cand;\\n                if (size < k) size++;\\n            }\\n        }\\n        local_sizes[tid] = size;\\n    }\\n\\n    // Merge per-thread candidate lists and select global top-k\\n    int total_cand = 0;\\n    for (int t = 0; t < nt; t++) total_cand += local_sizes[t];\\n    Candidate * all_cands = (Candidate *) malloc(sizeof(Candidate) * total_cand);\\n    pos = 0;\\n    for (int t = 0; t < nt; t++) {\\n        memcpy(all_cands + pos, local_tops[t], sizeof(Candidate) * local_sizes[t]);\\n        pos += local_sizes[t];\\n    }\\n    qsort(all_cands, total_cand, sizeof(Candidate), compare_candidates);\\n\\n    // Extract labels of the k nearest neighbors\\n    char * labels = (char *) malloc(sizeof(char) * k);\\n    for (int i = 0; i < k; i++) {\\n        labels[i] = all_labels[all_cands[i].idx];\\n    }\\n\\n    // Free temporary arrays\\n    free(all_points);\\n    free(all_labels);\\n    for (int t = 0; t < nt; t++) free(local_tops[t]);\\n    free(local_tops);\\n    free(local_sizes);\\n    free(all_cands);\\n\\n    // Count label frequencies in parallel using an OpenMP reduction on a fixed-size array\\n    int counts[256] = {0};\\n    #pragma omp parallel for reduction(+:counts[:256])\\n    for (int i = 0; i < k; i++) {\\n        unsigned char c = (unsigned char) labels[i];\\n        counts[c]++;\\n    }\\n\\n    free(labels);\\n\\n    // Select the label with highest frequency, breaking ties by smallest character value\\n    char most_frequent = 0;\\n    int best_count = -1;\\n    for (int c = 0; c < 256; c++) {\\n        if (counts[c] > best_count) {\\n            best_count = counts[c];\\n            most_frequent = (char)c;\\n        }\\n    }\\n\\n    return most_frequent;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Flattening all points into contiguous arrays and using OpenMP static work sharing over the flattened index space improves load balance and cache locality compared to group-based parallelization. Per-thread top-k lists with deterministic (distance, index) tie-breaking preserve exact sequential semantics, while an OpenMP reduction on label counts accelerates the final classification step.\",\n  \"notes\": \"The implementation preserves the original insertion-order tie-breaking by using a comparator that sorts by squared distance and then by global point index. The parallel frequency counting uses an array reduction over 256 possible character labels; ties are broken by choosing the smallest character with maximal count, matching the sequential sorted-frequency logic. Only src/knn.c was modified.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Flattened group points and labels into contiguous arrays for better memory access\",\n    \"Parallelized distance computation and per-thread top-k selection using OpenMP static scheduling over the flattened point index space\",\n    \"Merged per-thread candidate lists deterministically by (distance, original index) to preserve exact tie-breaking\",\n    \"Used an OpenMP reduction on a fixed-size label count array for parallel frequency counting\"\n  ]\n}",

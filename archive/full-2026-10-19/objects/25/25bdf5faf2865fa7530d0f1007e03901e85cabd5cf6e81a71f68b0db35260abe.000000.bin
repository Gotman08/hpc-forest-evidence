{"files":[{"content":"#include <bits/stdc++.h>\n\nusing namespace std;\nusing ll = long long;\n\nclass LocalFrequency {\n public:\n  explicit LocalFrequency(int max_entries) : generation(0) {\n    size_t capacity = 1;\n    while (capacity < 2 * static_cast<size_t>(max_entries)) capacity <<= 1;\n    keys.resize(capacity);\n    counts.resize(capacity);\n    stamps.assign(capacity, 0);\n    mask = capacity - 1;\n  }\n\n  void begin_sweep() {\n    ++generation;\n    if (generation == 0) {\n      fill(stamps.begin(), stamps.end(), 0);\n      generation = 1;\n    }\n  }\n\n  ll get(ll key) const {\n    size_t slot = hash_key(key) & mask;\n    while (stamps[slot] == generation) {\n      if (keys[slot] == key) return counts[slot];\n      slot = (slot + 1) & mask;\n    }\n    return 0;\n  }\n\n  void increment(ll key) {\n    size_t slot = hash_key(key) & mask;\n    while (stamps[slot] == generation) {\n      if (keys[slot] == key) {\n        ++counts[slot];\n        return;\n      }\n      slot = (slot + 1) & mask;\n    }\n    stamps[slot] = generation;\n    keys[slot] = key;\n    counts[slot] = 1;\n  }\n\n private:\n  vector<ll> keys;\n  vector<ll> counts;\n  vector<uint32_t> stamps;\n  size_t mask;\n  uint32_t generation;\n\n  static uint64_t hash_key(ll key) {\n    uint64_t x = static_cast<uint64_t>(key) + 0x9e3779b97f4a7c15ULL;\n    x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;\n    x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;\n    return x ^ (x >> 31);\n  }\n};\n\nint main() {\n  ios::sync_with_stdio(false);\n  cin.tie(nullptr);\n\n  int k, m, n;\n  if (!(cin >> k >> m >> n)) return 0;\n\n  const int short_dim = min(m, n);\n  const int long_dim = max(m, n);\n  vector<int> matrix(static_cast<size_t>(short_dim) * long_dim);\n\n  if (m <= n) {\n    for (int i = 0; i < m; ++i) {\n      for (int j = 0; j < n; ++j) {\n        cin >> matrix[static_cast<size_t>(i) * long_dim + j];\n      }\n    }\n  } else {\n    for (int i = 0; i < m; ++i) {\n      for (int j = 0; j < n; ++j) {\n        cin >> matrix[static_cast<size_t>(j) * long_dim + i];\n      }\n    }\n  }\n\n  auto process_first = [&](int first, vector<ll>& band_sum,\n                           LocalFrequency& frequencies) {\n    fill(band_sum.begin(), band_sum.end(), 0);\n    ll subtotal = 0;\n    for (int last = first; last < short_dim; ++last) {\n      const int* row = matrix.data() + static_cast<size_t>(last) * long_dim;\n      for (int x = 0; x < long_dim; ++x) band_sum[x] += row[x];\n\n      frequencies.begin_sweep();\n      frequencies.increment(0);\n      ll prefix = 0;\n      for (int x = 0; x < long_dim; ++x) {\n        prefix += band_sum[x];\n        subtotal += frequencies.get(prefix - k);\n        frequencies.increment(prefix);\n      }\n    }\n    return subtotal;\n  };\n\n  ll answer = 0;\n  const ll estimated_work =\n      1LL * short_dim * (short_dim + 1) / 2 * long_dim;\n\n  if (estimated_work >= 200000) {\n#pragma omp parallel reduction(+ : answer)\n    {\n      vector<ll> band_sum(long_dim, 0);\n      LocalFrequency frequencies(long_dim + 1);\n#pragma omp for schedule(static, 1)\n      for (int first = 0; first < short_dim; ++first) {\n        answer += process_first(first, band_sum, frequencies);\n      }\n    }\n  } else {\n    vector<ll> band_sum(long_dim, 0);\n    LocalFrequency frequencies(long_dim + 1);\n    for (int first = 0; first < short_dim; ++first) {\n      answer += process_first(first, band_sum, frequencies);\n    }\n  }\n\n  cout << answer << '\\n';\n  return 0;\n}\n","path":"src/main.cpp"}],"hypothesis":"Static cyclic scheduling should reduce dynamic-scheduling overhead while distributing the independent, gradually decreasing start-boundary workloads across threads. Retaining the serial path below the archived work threshold should avoid parallel overhead on smaller inputs.","notes":"Proposed a whole-program integration for controller evaluation; no measurements or correctness claims are made for this candidate.","research":{"queries":[],"urls":[]},"sources_kept":["9661742815304083","a7700b7599e54811"],"transformations":["Store contiguous bands along the shorter dimension, transposing during input when needed; incrementally update band sums for contiguous scans.","Use a dynamically sized, generation-stamped open-addressed frequency table for full-width signed prefix sums, with private per-thread state.","Parallelize independent start-boundary groups using OpenMP static scheduling with chunk size one and a reduction; retain a serial path below 200000 estimated pair-row operations."]}
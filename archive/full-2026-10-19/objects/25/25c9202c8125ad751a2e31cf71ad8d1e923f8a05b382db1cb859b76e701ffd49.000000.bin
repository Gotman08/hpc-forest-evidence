"""Own review writer: cold metadata/hash/AST only; never a receiver or live observer."""
import ast
import hashlib
import io
import json
import math
import os
import re
import stat
import tarfile
import time
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
RX = HERE.parent
OP = RX.parent
PREP = OP.parent
BASE = PREP.parents[1]
CHAIN = PREP / 'adaptateurs-source110-r1/revision-r5-G-recu-avant-Q'
SOURCE = 'eaff9217499fe268e4d151165a368a83bad1550d921955a9f9256026cfac2d48'
PLAN = 'd08ac00bcfb75625a24971b2684d7479c4da7a98b339e4e10eae5b9ac525ef27'
CELLS = {
    '754295': ('sol-max', 'gpt-6.1-sol', '3b1de5658e4641149b15a3bea4850239'),
    '754296': ('astra-max', 'gpt-6-astra', '7b6c29c0e329400bb2be145b0e2dbe0a'),
    '754299': ('terra-max', 'gpt-5.6-terra', 'bd2b3153a7544c909afbc19fe69902b4'),
}


def require(ok, text):
    if not ok:
        raise ValueError(text)


def sha(value):
    return hashlib.sha256(value).hexdigest()


# Only these already reviewed held/no-follow read definitions are evaluated.
# No received module, source module, main, receiver, inspector or test is imported/run.
primitive_path = PREP / 'qualification-allouee-source110-G-recu-r1/revue-resultats-Q753709-r1/lecteur-r4b/auditer-restauration-existante-r4b.py'
primitive_bytes = primitive_path.read_bytes()
require(sha(primitive_bytes) == '5c1e1784574566a585e2d9cc50f85b52337d10d3109e449a4112581eae68f8d5', 'Held primitives pin')
names = {'need', 'ordinary', 'metadata', 'open_nofollow_read', 'cross_identity',
         'validate_windows_mode_views', 'native_basic_info', 'raw', 'decode'}
nodes = [n for n in ast.parse(primitive_bytes).body if isinstance(n, ast.FunctionDef) and n.name in names]
require({n.name for n in nodes} == names, 'Closed held IO definitions')
held = {'Path': Path, 'os': os, 'stat': stat, 'json': json, 'Q': BASE}
exec(compile(ast.Module(body=nodes, type_ignores=[]), str(primitive_path), 'exec'), held)
raw, decode = held['raw'], held['decode']
before = {}


def read_bytes(path, expected=None):
    path = Path(path)
    require(path.is_absolute() and path.is_relative_to(PREP), 'Cold PREP evidence only')
    value = raw(path)
    checksum = sha(value)
    require(expected is None or checksum == expected, 'Pinned cold evidence changed: ' + path.name)
    require(str(path) not in before or before[str(path)] == checksum, 'Changed within cold review')
    before[str(path)] = checksum
    return value


def ref(path, expected=None):
    value = read_bytes(path, expected)
    return {'path': str(path), 'sha256': sha(value)}


def obj(path, expected=None):
    return decode(read_bytes(path, expected))


def load(reference):
    require(set(reference) == {'path', 'sha256'}, 'Exact cold reference')
    return obj(Path(reference['path']), reference['sha256'])


def unwrap(value):
    require(isinstance(value, dict) and value.get('isError', False) is False, 'Successful cold tool metadata')
    if 'structuredContent' in value:
        texts = [b['text'] for b in value.get('content', []) if b.get('type') == 'text']
        require(len(texts) == 1 and decode(texts[0].encode()) == value['structuredContent'], 'Raw/structured equality')
        return value['structuredContent']
    return value


def binding(value, job, model, session):
    require(value['source_zip_sha256'] == SOURCE and value['plan_sha256'] == PLAN
            and value['scope_id'] == 'hpc-forest-dynamic-independent-roots-r4b-max'
            and value['job_id'] == job and value['model'] == model and value['session_id'] == session
            and value['phase'] == 'roots' and value['effort'] == 'max', 'Exact source/plan/cell identity')


bundle_ref = ref(RX / 'ENTREES-ROOT-01.json', '6ef940a8f30874971c9a5282bd431392e591838258e43be101660fcaa5d444a4')
bundle = load(bundle_ref)
recon_ref = ref(RX / 'execution-root-01/RECONCILIATION-TROIS-ROOTS-ZERO-APPEL.json', '41148d0b7c671491a004827978270f3d9715c1868142f491121065a1caa6a6bf')
recon = load(recon_ref)
execution_ref = ref(RX / 'EXECUTION-RECEPTION-ROOT-01.json')
execution = load(execution_ref)
require(execution['exit_code'] == 0 and execution['stderr'] == '', 'Actual ROOT execution success')
require(decode(execution['stdout'].encode()) == recon_ref, 'Actual stdout binds reconciliation')
require(recon['root_input'] == bundle_ref and recon['verified_metadata_only'] is True, 'Actual root input')
require(recon['job_ids'] == list(CELLS) and len(recon['receipts']) == 3, 'Exactly three actual jobs')
for key in ['published_requests', 'native_invocations', 'native_model_calls', 'responses', 'deliveries', 'unknown_invocations']:
    require(recon[key] == 0, 'Reconciliation must be zero: ' + key)
require(recon['prepared_requests'] == 3 and recon['unresolved_invocations'] == []
        and recon['all_started_calls_reconciled'] is True and recon['all_three_terminal_received'] is True
        and recon['restored_regular_files'] == 15 and recon['original_archives_and_received_evidence_unchanged'] is True,
        'Actual three-cell metadata totals')
require(recon['source_zip_sha256'] == SOURCE and recon['plan_sha256'] == PLAN
        and recon['current_state_after_observation_promised'] is False
        and recon['source110_native_or_normal_science_performance_method_R5_or_OBS4_terminal_admission'] is False,
        'No widened admission')
code_review_ref = ref(OP / 'audit-compatibilite-factory-reelle-r1/REVUE-RECEPTEUR-ZERO-APPEL-PREPARATION.json', 'acb71b53b77864844bd7cef7bbb73bfffbaa54e16b5d69c5853eb2a640ab4495')
code_review = load(code_review_ref)
require(code_review['blocking_findings'] == [] and code_review['verified_source_preparation_only'] is True, 'Independent B code review')
for name, checksum in code_review['reviewed_files'].items():
    ref(RX / name, checksum)

# Rehash the old frozen 62 components; never import/evaluate their modules.
components_ref = ref(CHAIN / 'COMPONENTS.json', '1e60da6d5b51afaf3c857b1ba215927e7e1201c297241afd6390212a89d5e449')
components = load(components_ref)
require(len(components['code_pins']) == 62, 'Old frozen 62 component count')
for name, checksum in components['code_pins'].items():
    require('..' not in Path(name).parts, 'Closed component path')
    ref(CHAIN / name, checksum)

announcement = load(bundle['hash_announcement'])
announced_job = load(bundle['hash_announcement_job_terminal'])
require(announcement['schema'] == 'hpc-forest-r4b-original-zero-call-archives-hash-announcement-v1'
        and announcement['verified_readonly_hashes'] is True and announcement['allocation_job_id'] == '754337'
        and announcement['native_model_calls'] == announcement['tests_replayed'] == 0
        and announcement['archives_modified'] is False, 'Actual delivery-only announcement schema')
status = unwrap(announced_job['status'])
require(status['job_id'] == '754337' and status['state'] == 'COMPLETED' and status['exit_code'] == '0:0', 'Hash job terminal')
announcement_log = unwrap(announced_job['log'])
require(announcement_log['job_id'] == '754337' and announcement_log['ok'] is True, 'Actual announcement log')
matches = []
def scan_strings(value):
    if isinstance(value, dict):
        for child in value.values():
            scan_strings(child)
    elif isinstance(value, list):
        for child in value:
            scan_strings(child)
    elif isinstance(value, str):
        for line in value.splitlines():
            try:
                if json.loads(line) == announcement:
                    matches.append(line)
            except ValueError:
                pass
scan_strings(announcement_log)
require(len(matches) == 1 and len(announcement['records']) == 3, 'Unique actual announced JSON line')

expected_names = {'contract-source-result.json', 'mailbox/OWNER.json', 'private-technical-error.json',
                  'request-prepared.json', 'target-profile.json'}
cells = []
total_bytes = 0
receipt_by_job = {}
for receipt_ref in recon['receipts']:
    receipt = load(receipt_ref)
    require(receipt['job_id'] not in receipt_by_job, 'No duplicate receipt')
    receipt_by_job[receipt['job_id']] = (receipt_ref, receipt)
for supplied in bundle['cells']:
    job = supplied['job_id']
    slug, model, session = CELLS[job]
    receipt_ref, receipt = receipt_by_job[job]
    binding(receipt, job, model, session)
    require(receipt['schema'] == 'hpc-forest-source110-zero-call-technical-terminal-metadata-v1'
            and receipt['verified_metadata_only'] is True and receipt['terminal_state'] == 'FAILED'
            and receipt['exit_code'] == '1:0' and receipt['failure_class'] == 'authorization-wait-expired-before-request-publication', 'Exact terminal metadata scope')
    for key in ['requests_published', 'native_invocation_count', 'native_model_calls', 'native_calls_replayed',
                'response_count', 'delivered_count', 'unknown_invocations']:
        require(receipt[key] == 0, 'Zero actual receipt ' + key)
    require(receipt['requests_prepared'] == 1 and receipt['unresolved_invocations'] == []
            and receipt['all_started_calls_reconciled'] is True and receipt['input_evidence'] == supplied
            and receipt['hash_announcement'] == bundle['hash_announcement']
            and receipt['fresh_worker_zero_census'] == bundle['fresh_full_cim'], 'Receipt exact input binding')
    for key in ['normal_native_delivery_verified', 'closed_schema_verified', 'native_contract_admission_verified',
                'native_research_admitted', 'scientific_or_performance_admission', 'method_R5_admitted', 'observer_route_terminal_admitted']:
        require(receipt[key] is False, 'Unadmitted ' + key)
    inventory = load(supplied['archive_inventory'])
    binding(inventory, job, model, session)
    require(inventory['archive'] == supplied['archive'] and inventory['verified_archive_metadata_only'] is True
            and inventory['inventory_before'] == inventory['inventory_after'] == receipt['inventory_before'] == receipt['inventory_after']
            and set(inventory['inventory_before']) == expected_names
            and inventory['archive_bytes_before_after_identical'] is True
            and receipt['cold_archive_inventory_unchanged'] is True, 'Original/root inventories consistent')
    marker = load(inventory['allocation_marker'])
    binding(marker, job, model, session)
    require(marker['native_model_calls'] == marker['requests_published'] == 0
            and marker['cache_claims_registry_created'] is False, 'Actual staging no publication/claims')
    archive_path = Path(supplied['archive']['path'])
    archive_bytes = read_bytes(archive_path, supplied['archive']['sha256'])
    announced = [v for v in announcement['records'] if v['job_id'] == job]
    require(len(announced) == 1, 'Single job announcement')
    announced = announced[0]
    transfer = unwrap(load(supplied['download_receipt']))
    require(announced['session_id'] == session and announced['model'] == model
            and announced['path'] == transfer['downloaded'] == marker['remote_root'] + '/' + archive_path.name
            and announced['sha256'] == transfer['remote_sha256'] == transfer['empreinte_locale'] == transfer['empreinte_distante'] == sha(archive_bytes)
            and announced['bytes'] == transfer['bytes'] == len(archive_bytes)
            and announced['original_bytes_unchanged'] is True and transfer['ok'] is True and transfer['verifie'] is True
            and Path(transfer['to']) == archive_path and transfer['transport'] == 'scp', 'Three actual equal SHA and path/bytes')
    require(supplied['transfer_sidecars'] == [], 'No fictitious transfer sidecars')
    terminal = unwrap(load(supplied['terminal_status']))
    efficiency = unwrap(load(supplied['efficiency']))
    log = unwrap(load(supplied['terminal_log']))
    require(terminal['job_id'] == efficiency['job_id'] == job and terminal['state'] == efficiency['state'] == 'FAILED'
            and terminal['exit_code'] == efficiency['exit_code'] == '1:0' and terminal['finished'] is True
            and terminal['observation']['current_state_observed'] is True and efficiency['found'] is True
            and efficiency['alloc_cpus'] == 4 and efficiency['alloc_gpus'] == 0 and efficiency['req_mem_mb'] == 16384
            and log['job_id'] == job, 'Actual terminal and allocation efficiency')
    restored = Path(receipt['restoration_root'])
    require(restored == RX / f'execution-root-01/restauration-neuve-{job}/results-{job}', 'Exact cold restoration root')
    archived = {}
    directories = set()
    with tarfile.open(fileobj=io.BytesIO(archive_bytes), mode='r:gz') as tar:
        for member in tar:
            require(set(member.pax_headers) <= {'mtime'} and not member.linkname and not member.sparse,
                    'No aliases/links/path-PAX/sparse archive members; only passive mtime metadata')
            require(all(re.fullmatch(r'[0-9]+(?:\.[0-9]+)?', v) and math.isfinite(float(v))
                        for v in member.pax_headers.values()), 'Closed finite PAX mtime metadata')
            name = member.name.rstrip('/')
            prefix = 'results-' + job
            require(name == prefix or name.startswith(prefix + '/'), 'Closed archive root')
            require('..' not in Path(name).parts and '\\' not in name and ':' not in name, 'Closed archive member path')
            relative = name[len(prefix):].lstrip('/')
            if member.isdir():
                require(name not in directories, 'No duplicate directory')
                directories.add(name)
                continue
            require(member.isreg() and relative in expected_names and relative not in archived, 'Exactly five original regular members')
            archived[relative] = tar.extractfile(member).read()
    require(set(archived) == expected_names and directories == {'results-' + job, *{'results-' + job + '/mailbox' + tail for tail in ('', '/requests', '/responses', '/logs')}}, 'Closed five regular/five directory archive')
    actual_inventory = {}
    for name, value in archived.items():
        expected = {'bytes': len(value), 'sha256': sha(value)}
        require(expected == inventory['inventory_before'][name], 'Actual original member inventory')
        restored_bytes = read_bytes(restored / name, expected['sha256'])
        require(restored_bytes == value, 'Restored byte equality to original archive')
        actual_inventory[name] = expected
        total_bytes += len(value)
    result = decode(archived['contract-source-result.json'])
    binding(result, job, model, session)
    require(result['verified'] is False and result['global_admission_verified'] is False
            and result['performance_verified'] is False and result['error'] == 'RuntimeError'
            and result['native_response_received'] is False and result['native_calls_replayed'] == 0, 'Received source-result is negative only')
    require(decode(archived['private-technical-error.json']) == {'never_model_input': True, 'type': 'RuntimeError', 'detail': 'Authorization wait expired; no invocation/replay'}, 'Exact prepublication failure')
    owner = decode(archived['mailbox/OWNER.json'])
    require(owner == {'protocol': 'hpc-forest-codex-mailbox-v1', 'session_id': session, 'model': model,
                      'reasoning_effort': 'max', 'job_id': job, 'owner': job}, 'Actual OWNER six fields')
    request = decode(archived['request-prepared.json'])
    require(request['session_id'] == session and request['model'] == model and request['reasoning_effort'] == 'max'
            and request['owner_key'] == 'synthetic-interface-contract:roots:' + session
            and request['meta_role'] == 'mother-dynamic-roots'
            and sha(archived['request-prepared.json']) == marker['request_sha256'] == marker['request_prepared']['sha256'], 'Prepared request exact source marker binding')
    profile = decode(archived['target-profile.json'])
    require(profile['slurm_job_id'] == job and profile['architecture'] == 'ARM64' and profile['cpu_cores'] == 4
            and profile['tasks'] == profile['nodes'] == 1 and profile['allocated_memory_mib'] == 16384
            and profile['allocated_gpus'] == 0 and profile['operator_algorithm_advice'] is False
            and sha(archived['target-profile.json']) == marker['target_profile']['sha256'], 'Actual original allocated target only')
    require(set(profile['compilers']) == {'gcc', 'g++'} and all(c['probe_returncode'] == 0 and c['probe_stdout'] == '4\n' for c in profile['compilers'].values()), 'Received two neutral probe metadata; not rerun')
    require(marker['owner']['sha256'] == sha(archived['mailbox/OWNER.json']), 'Marker OWNER bytes')
    cells.append({'job_id': job, 'session_id': session, 'model': model, 'terminal_state': 'FAILED', 'exit_code': '1:0',
                  'receipt': receipt_ref, 'archive': supplied['archive'], 'archive_inventory': supplied['archive_inventory'],
                  'allocation_marker': inventory['allocation_marker'], 'restoration_root': str(restored), 'inventory': actual_inventory,
                  'archive_bytes': len(archive_bytes), 'restored_bytes': sum(v['bytes'] for v in actual_inventory.values()),
                  'prepared_request_count': 1, 'published_requests': 0, 'native_invocations': 0, 'responses': 0, 'deliveries': 0,
                  'three_SHA_equal': True, 'target_scope': 'original job allocation only; not a future job profile'})

# List only the received cold execution tree; no live caches or remote paths.
actual_files = set()
for directory, dirs, files in os.walk(RX / 'execution-root-01', followlinks=False):
    for name in dirs + files:
        entry = Path(directory) / name
        info = entry.lstat()
        require(not stat.S_ISLNK(info.st_mode) and not getattr(info, 'st_file_attributes', 0) & 1024, 'Cold output reparse refused')
    actual_files.update(str(Path(directory) / name) for name in files)
expected_files = {r['path'] for r in recon['receipts']} | {recon_ref['path']}
expected_files |= {str(Path(c['restoration_root']) / n) for c in cells for n in expected_names}
require(actual_files == expected_files, 'Cold output exact 19-file set; no worker/invocation/response artifact')

# Re-evaluate only selected pure classification definitions on the already saved census.
# Historical receiver time is used; no current freshness or current absence is claimed.
capacity_path = OP / 'capacite-preracines-r1/verifier-capacite-preracines.py'
capacity_bytes = read_bytes(capacity_path, '581403d134951fbde8c7b815c9d2c6d3281b09c3c847dc62386d7ea62be8d107')
capacity_names = {'need', 'timestamp_z', 'complete_cim', 'native_definitions', 'classify_zero', 'digest'}
capacity_nodes = [n for n in ast.parse(capacity_bytes).body if isinstance(n, ast.FunctionDef) and n.name in capacity_names]
require({n.name for n in capacity_nodes} == capacity_names, 'Closed historical classifier API')
observer = CHAIN / 'observer/observer-mixte.py'
detector = CHAIN / 'launcher/native_worker_detection.py'
namespace = {'Path': Path, 're': re, 'math': math, 'ast': ast, 'time': time, 'datetime': datetime, 'UTC': UTC,
             'hashlib': hashlib, 'FIELDS': ('ProcessId', 'ParentProcessId', 'ExecutablePath', 'CommandLine', 'CreationDate'),
             'OBSERVER': observer, 'DETECTOR': detector,
             'OBSERVER_SHA': components['code_pins']['observer/observer-mixte.py'],
             'DETECTOR_SHA': components['code_pins']['launcher/native_worker_detection.py']}
exec(compile(ast.Module(body=capacity_nodes, type_ignores=[]), str(capacity_path), 'exec'), namespace)
census = load(bundle['fresh_full_cim'])
receiver_time = datetime.fromisoformat(recon['observed_at_utc']).timestamp()
rows = namespace['complete_cim'](census, receiver_time)
namespace['classify_zero'](rows, namespace['native_definitions'](read_bytes(observer), read_bytes(detector)))
require(len(rows) == 496 and recon['fresh_full_cim'] == bundle['fresh_full_cim'] and recon['active_native_workers_at_observation'] == 0, 'Historical exact census classification')
capture_ref = ref(OP / 'observations-reception-zero-appel-02/OBSERVATIONS-REELLES.json')
capture = load(capture_ref)
require(capture['full_cim'] == bundle['fresh_full_cim'] and capture['rows_count'] == 496, 'Actual ROOT capture receipt')
expected_caches = {str(PREP / ('lancement-modeles-max-r3/worker-' + s)) for _, _, s in CELLS.values()}
require({a['path'] for a in recon['local_worker_caches_absent']} == expected_caches
        and all(a['exists'] is False and a['observation'] == 'ordinary_ancestor_lstat_only' for a in recon['local_worker_caches_absent']), 'Historical ROOT lstat-only absence; no reviewer cache observation')

after = {path: sha(raw(Path(path))) for path in before}
require(after == before, 'All cold originals and copies unchanged after independent review')
review = {
    'schema': 'hpc-forest-source110-three-zero-call-actual-cold-reception-review-v1',
    'verified_metadata_only': True, 'verified': True, 'blocking_findings': [],
    'decision': 'GO_RECEIVED_ZERO_CALL_TECHNICAL_METADATA_ONLY_THREE_TERMINALS_CLOSED_NO_REPOLL_NEEDED',
    'reviewer': 'prepare_r2g_owned_closure; actual-output review independent of ROOT execution',
    'independence_scope': 'Reviewer authored the prepared receiver. B acb71 independently reviewed its code. This new review independently checks actual ROOT execution outputs and original cold bytes; it is not a second independent authorship review.',
    'reviewed_at_utc': datetime.now(UTC).isoformat(),
    'reconciliation': recon_ref, 'root_execution': execution_ref, 'root_input': bundle_ref,
    'independent_preparation_code_review': code_review_ref, 'old_components_62': components_ref,
    'old_62_components_rehashed_unchanged': True,
    'source_zip_sha256': SOURCE, 'plan_sha256': PLAN,
    'hash_announcement': bundle['hash_announcement'], 'hash_announcement_job_terminal': bundle['hash_announcement_job_terminal'],
    'hash_announcement_scope': 'Separate actual readonly delivery job754337; original remote_stage announcement supplied no SHA. No original-stage SHA announcement is invented.',
    'cells': cells, 'all_three_terminal_received': True,
    'restored_regular_files': 15, 'restored_regular_bytes': total_bytes,
    'all_original_archive_members_equal_restored_copies': True,
    'actual_closed_output_files': 19,
    'all_announced_remote_local_archive_SHA_equal': True,
    'actual_named_transfer_sidecars': [],
    'prepared_requests': 3, 'published_requests': 0, 'native_invocations': 0, 'native_model_calls': 0,
    'responses': 0, 'deliveries': 0, 'unknown_invocations': 0, 'unresolved_invocations': [],
    'all_started_calls_reconciled': True,
    'zero_call_basis': 'Exact closed archives, RuntimeError authorization-wait branch before request publication, markers with published0/claimsfalse, no invocation/response/claim/worker artifact; no delivery or model success is inferred.',
    'historical_worker_zero': {'full_cim': bundle['fresh_full_cim'], 'capture_receipt': capture_ref,
                               'captured_at_utc': census['captured_at_utc'], 'rows_count': len(rows),
                               'receiver_observed_at_utc': recon['observed_at_utc'],
                               'age_seconds_at_receiver_final_receipt': receiver_time - census['observed_at'],
                               'typed_native_sessions': 0, 'conservative_native_candidates': 0,
                               'reviewer_new_CIM_capture': False, 'current_state_after_that_observation_promised': False},
    'local_worker_caches_absent_at_ROOT_receiver_observation': recon['local_worker_caches_absent'],
    'reviewer_live_cache_or_lock_observation': False,
    'observer_scope': 'Passive OBS4 and unrelated processes preserved. Existing pending routes may retain terminal scheduler cache. This receipt grants no OBS4 terminal_received rename, route release, observer restart/stop, or lifecycle admission; a future qualified lifecycle is separate.',
    'reviewer_received_code_source_main_test_probe_CLI_MCP_model_liveCIM_or_process_effect': False,
    'reviewer_archive_extraction_or_data_write': False,
    'source110_native_or_NORMAL_scientific_performance_method_R5_or_OBS4_terminal_admission': False,
    'new_R7_namespace_or_new_Q_qualification_admitted': False,
    'target_profiles_reusable_for_future_allocation': False,
    'scope_limits': ['Metadata technical receipt of these exact three FAILED1:0 jobs only.',
                     'Prepared request is distinct from published request; all zero delivery counters remain zero.',
                     'No historical one-call negative auditor substitution; source110 negative OBS4 route remains closed.',
                     'No live/current worker absence claim beyond the saved census and actual ROOT lstat observation.',
                     'The original three remote namespaces are occupied by their preserved technical artifacts; a new run needs separately qualified new namespaces.',
                     'Closed jobs need no repeated polling to establish this already received terminal metadata.'],
    'input_inventory_before': before, 'input_inventory_after': after, 'input_bytes_unchanged': True,
}
out = HERE / 'REVUE-RECEPTION-REELLE-TROIS-ROOTS-ZERO-APPEL.json'
with out.open('xb') as stream:
    stream.write((json.dumps(review, ensure_ascii=False, indent=2) + '\n').encode('utf-8'))
print(json.dumps({'path': str(out), 'sha256': sha(raw(out)), 'cold_files_rehashed': len(before),
                  'regular_files': 15, 'regular_bytes': total_bytes, 'historical_cim': census['captured_at_utc']}))

"""Prepare local Astra templates only. No producer, MCP, CLI or model imports."""
from __future__ import annotations

import hashlib
import json
from pathlib import Path

BASE = Path(__file__).resolve().parents[2]
DEST = Path(__file__).resolve().parent
SESSION = "90dc34c1c17d4eddb084e38047fb3678"
ROOT = "/gpfs/scratch/nimarano/hpc-forest-matrix15-native-max-r2-" + SESSION
RESULTS = ROOT + "/results-755862"
ADMISSION = BASE / "outputs/HPC-Forest-Matrice15-Extension-Operation-Preparation-r1" / (SESSION + "-admission-windows")


def read(path):
    return json.loads(Path(path).read_text(encoding="utf-8"))


def ref(path, *, sized=False):
    path = Path(path).absolute()
    raw = path.read_bytes()
    result = {"path": str(path), "sha256": hashlib.sha256(raw).hexdigest()}
    if sized:
        result["bytes"] = len(raw)
    return result


def save(name, value):
    path = DEST / name
    with path.open("x", encoding="utf-8", newline="\n") as stream:
        json.dump(value, stream, ensure_ascii=False, indent=2)
        stream.write("\n")
    return ref(path, sized=True)


def main():
    raise RuntimeError("Preparation stopped by ROOT after actual Astra755862 terminal failure; no collection, release or replay. Preserve this unexecuted preparation and use RAPPORT-TERMINAL-ECHEC.md.")
    producers = {
        "collector": (BASE / "outputs/HPC-Forest-Matrice15-Premier-Batch-Collecte-Preparation-r3/collect_inputs.py", "78beaff074dfef488757271fcdf26addb2fc8e0e0fde309190f4cb77e7334675"),
        "auditor": (BASE / "outputs/HPC-Forest-Matrice15-Premier-Batch-Preparation-r3/lecteur/first_batch_audit.py", "ad0d36aff4e212636360f147cccc0cf7457ba8701671b23e983c5633494e6037"),
        "receiver": (BASE / "outputs/HPC-Forest-Matrice15-Reception-Parallele-Preparation-r1/receive.py", "d1d004f08bc8f63870e912549eab0374fbc70438486cfe83eed626107a5e0729"),
    }
    for path, checksum in producers.values():
        assert ref(path)["sha256"] == checksum
    windows = read(ADMISSION / "authorization.json")
    transfer = read(ADMISSION / "ARM-TRANSFER-PENDING.json")
    assert windows["job_id"] == "755862" and windows["session_id"] == SESSION
    assert windows["model"] == "gpt-6-astra" and windows["effort"] == "max" and windows["subject_id"] == "2023-count"
    plan = read(windows["artifacts"]["plan"]["path"])
    assert ref(windows["artifacts"]["plan"]["path"]) == windows["artifacts"]["plan"]
    binding = {key: windows[key] for key in ("scope_id", "cell_key", "subject_id", "model", "effort", "session_id", "job_id", "remote_root")}
    binding.update(source_zip_sha256=windows["artifacts"]["source_zip"]["sha256"], plan_sha256=windows["artifacts"]["plan"]["sha256"],
                   preparation_manifest_sha256=windows["artifacts"]["preparation_manifest"]["sha256"],
                   r1_contract_sha256=plan["subject_bindings"]["2023-count"]["r1_contract_ref"]["sha256"])
    policy_path = ADMISSION / ("cli-policy-" + SESSION + ".json")
    cache = BASE / "work/matrix15-extension-operation-inputs-r1/worker-cache" / SESSION
    summary = read(BASE / "outputs/HPC-Forest-Matrice15-Execution-root-01/EXTERNAL-SHELL-RECEPTION-SUMMARY.json")
    catalog = []
    for row in summary["results"]:
        assert row["status"] == "fulfilled"
        value = row["value"]
        local = ref(value["local_path"], sized=True)
        assert local["sha256"] == value["remote_ref"]["sha256"] and local["bytes"] == value["bytes"]
        catalog.append({"remote_ref": value["remote_ref"], "local_ref": local, "transfer_receipt": ref(value["receipt_path"], sized=True)})
    by_name = {Path(item["remote_ref"]["path"]).name: item["remote_ref"] for item in catalog}
    shell_packet = {"manifest_ref": by_name["manifest.json"], "copy_ref": by_name["bin-sh"]}
    collection_root = BASE / "outputs/HPC-Forest-Matrice15-Premier-Batch-Collecte-Preparation-r3/astra-755862-collecte-r1"
    audit_root = BASE / "outputs/HPC-Forest-Matrice15-Execution-root-03/first-batch-audit-r3"
    collector = {"schema": "hpc-forest-matrix15-first-batch-collection-input-v2", "mode": "PREPARE",
                 "authorization": transfer["authorization"], "paused_snapshot": None, "catalog": catalog,
                 "local_refs": [ref(ADMISSION / "authorization.json", sized=True), ref(policy_path, sized=True)],
                 "cache_root": str(cache), "policy_ref": ref(policy_path, sized=True),
                 "audit_output_directory": str(audit_root), "output_directory": str(collection_root),
                 "external_program_copies": [shell_packet]}
    prepared = save("INPUT-COLLECTE-PREPARE.json", collector)
    receiver = {"schema": "hpc-forest-matrix15-parallel-readonly-receive-v1", "refs": [transfer["authorization"]],
                "lanes": 6, "config_path": "C:/Users/nicol/.codex/config.toml",
                "output_root": str(BASE / "outputs/HPC-Forest-Matrice15-Execution-root-03/first-batch-authorization-received-r1")}
    receiver_ref = save("INPUT-RECEPTION-AUTORISATION.json", receiver)
    known = save("REFERENCES-AVEREES.json", {"schema": "hpc-forest-astra-first-batch-local-preparation-v1", "verified": False,
                 "binding": binding, "authorization_arm_projected": transfer["authorization"],
                 "authorization_windows": ref(ADMISSION / "authorization.json", sized=True), "policy": ref(policy_path, sized=True),
                 "cache_root": str(cache), "producer_refs": {key: {"path": str(path), "sha256": checksum} for key, (path, checksum) in producers.items()},
                 "historical_shell_catalog": catalog, "first_batch_received": False, "audit_performed": False,
                 "network_calls": 0, "model_calls": 0, "jobs_submitted": 0})
    report = save("MANQUANTS-ET-COMMANDES.json", {"schema": "hpc-forest-astra-first-batch-pending-operator-inputs-v1", "verified": False,
                 "collector_template": prepared, "authorization_receive_input": receiver_ref, "known_refs": known,
                 "missing": [{"path": RESULTS + "/premier-batch-en-attente.json", "sha256": None, "required": "Actual complete readback/SHA then verified SCP catalog"},
                             {"path": RESULTS + "/premier-demarrage-verifie.json", "sha256": None, "required": "Traverse exact frozen snapshot ref; verified SCP catalog"},
                             {"required": "Actual Astra authorization verified SCP catalog; projected local ARM-stage bytes are not a received remote artifact"},
                             {"required": "Evaluation snapshot, command-stream frontier and all referenced private cache files, with real exact hashes"}],
                 "root_actions_only": ["Receive authorization using INPUT-RECEPTION-AUTORISATION.json with receiver --receive, or reuse a matching actual existing SCP receipt",
                                       "Receive the real paused snapshot, replace paused_snapshot:null with its exact original ARM path/SHA, add actual received catalog entries, change mode to COLLECT in a new input file",
                                       "Execute collector; consume NEXT-DOWNLOADS.json missing_remote in new receiver inputs, preserve failures and prior outputs",
                                       "Only when collection_complete:true, execute auditor with INPUT-AUDIT-PROPOSITION.json --produce-for-root-review; retain original existing_search_deadline"],
                 "collector_cli": ["python", "-B", str(producers["collector"][0]), "--input", "<new actual COLLECT input>", "--input-sha256", "<actual SHA>"],
                 "receiver_cli": ["python", "-B", str(producers["receiver"][0]), "--input", receiver_ref["path"], "--input-sha256", receiver_ref["sha256"], "--receive"],
                 "auditor_cli": ["python", "-B", str(producers["auditor"][0]), "--input", "<collector-produced INPUT-AUDIT-PROPOSITION.json>", "--input-sha256", "<actual SHA>", "--produce-for-root-review"],
                 "do_not_execute_prepare_template_for_reception_or_audit": True, "no_claim_about_current_remote_first_batch": True})
    print(json.dumps({"prepared_refs": [prepared, receiver_ref, known, report], "network_calls": 0, "model_calls": 0, "audit_performed": False}))


if __name__ == "__main__":
    main()

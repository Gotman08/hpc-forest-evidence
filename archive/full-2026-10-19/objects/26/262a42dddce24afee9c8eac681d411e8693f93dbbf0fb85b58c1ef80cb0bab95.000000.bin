#include <iostream>
#include <vector>
#include <cstdio>
#include <climits>
#include <omp.h>

int main() {
	int n, s;
	std::cin >> n >> s;
	std::vector<std::vector<int>> matrix(n, std::vector<int>(n));
	for (int i = 0; i < n; ++i)
		for (int j = 0; j < n; ++j)
			scanf("%d", &matrix[i][j]);

	// Step 1: row-wise prefix sums
	std::vector<long long> row_ps(n * n);
#pragma omp parallel for schedule(static)
	for (int i = 0; i < n; ++i) {
		long long sum = 0;
		for (int j = 0; j < n; ++j) {
			sum += matrix[i][j];
			row_ps[i * n + j] = sum;
		}
	}

	// Step 2: column-wise cumulative sums -> integral image
	int m1 = n + 1;
	std::vector<long long> ps(m1 * m1, 0);
#pragma omp parallel for schedule(static)
	for (int j = 0; j < n; ++j) {
		long long col_sum = 0;
		for (int i = 0; i < n; ++i) {
			col_sum += row_ps[i * n + j];
			ps[(i + 1) * m1 + (j + 1)] = col_sum;
		}
	}

	// Search all SxS submatrices using integral image
	int mxSum = INT_MIN;
#pragma omp parallel for collapse(2) reduction(max:mxSum) schedule(runtime)
	for (int i = 0; i <= n - s; ++i) {
		for (int j = 0; j <= n - s; ++j) {
			long long sum = ps[(i + s) * m1 + (j + s)]
			              - ps[i * m1 + (j + s)]
			              - ps[(i + s) * m1 + j]
			              + ps[i * m1 + j];
			if (sum > mxSum)
				mxSum = static_cast<int>(sum);
		}
	}

	printf("%d\n", mxSum);
	return 0;
}

"""Copy the sealed envelope and neutral tests into this isolated correction only."""
from __future__ import annotations

import hashlib
import json
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
ORIGINAL = HERE.parent
SOURCE = HERE.parents[1] / "HPC-Forest-Primes-Natif-MAX-r1/revision-r1b"


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    files = {str(path.resolve()): sha(path) for path in (
        ORIGINAL / "qualification-wrapper.py", ORIGINAL / "commande-allouee.sh",
        ORIGINAL / "bindings-finales.json", ORIGINAL / "demande-plan-proposee.json",
        ORIGINAL / "job-script-prepare.sbatch", ORIGINAL / "plan-prepare.json", ORIGINAL / "plan-relu.json",
        ORIGINAL / "submission-parent.json", SOURCE / "HPC-Forest-Primes-Natif-MAX-r1.zip",
        SOURCE / "native-max-plan.json", SOURCE / "hpc-forest-primes-native-max-r1-proposition.tar.gz")}
    assert files[str((ORIGINAL / "qualification-wrapper.py").resolve())] == "998c1c3536751db715471b5463c0d3a0c1815836f09b3c560ef344f4d2fb8a28"
    assert sha(SOURCE / "HPC-Forest-Primes-Natif-MAX-r1.zip") == "3e290f835570a8746be3c52144932b8c6866564980fd858cf4c0495a7b1e68c5"
    with (HERE / "preservation-avant.json").open("x", encoding="utf8") as stream:
        json.dump({"schema": "hpc-forest-qualification-path-correction-preservation-v1",
                   "utc": datetime.now(UTC).isoformat(), "files": files,
                   "historical_scheduler_state": "FAILED 1:0", "native_model_calls": 0,
                   "romeo_calls": 0}, stream, indent=2)
        stream.write("\n")
    with (HERE / "qualification-wrapper-r2.py").open("xb") as stream:
        stream.write((ORIGINAL / "qualification-wrapper.py").read_bytes())
    tests = (ORIGINAL / "test_qualification_wrapper.py").read_text(encoding="utf8")
    tests = tests.replace('HERE / "qualification-wrapper.py"', 'HERE / "qualification-wrapper-r2.py"')
    tests = tests.replace('HERE.parent / "HPC-Forest-Primes-Natif-MAX-r1/revision-r1b"',
                          'HERE.parents[1] / "HPC-Forest-Primes-Natif-MAX-r1/revision-r1b"')
    with (HERE / "test_qualification_wrapper_r2.py").open("x", encoding="utf8", newline="\n") as stream:
        stream.write(tests)
    print(json.dumps({"copied_only_in": str(HERE), "original_files_recorded": len(files),
                      "native_model_calls": 0, "romeo_calls": 0}))


if __name__ == "__main__":
    main()

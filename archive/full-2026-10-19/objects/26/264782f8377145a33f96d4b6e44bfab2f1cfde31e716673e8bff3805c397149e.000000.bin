      "content": "#include \"knn.h\"\n#include <arm_neon.h>\n\nstatic void sift_up(float *dist, char *label, int *seq, int idx) {\n    while (idx > 0) {\n        int parent = (idx - 1) / 2;\n        if (dist[idx] > dist[parent] ||\n            (dist[idx] == dist[parent] && seq[idx] > seq[parent])) {\n            float td = dist[idx]; dist[idx] = dist[parent]; dist[parent] = td;\n            char tl = label[idx]; label[idx] = label[parent]; label[parent] = tl;\n            int ts = seq[idx]; seq[idx] = seq[parent]; seq[parent] = ts;\n            idx = parent;\n        } else {\n            break;\n        }\n    }\n}\n\nstatic void sift_down(float *dist, char *label, int *seq, int size, int idx) {\n    while (1) {\n        int left = 2 * idx + 1;\n        int right = left + 1;\n        int largest = idx;\n        if (left < size &&\n            (dist[left] > dist[largest] ||\n             (dist[left] == dist[largest] && seq[left] > seq[largest]))) {\n            largest = left;\n        }\n        if (right < size &&\n            (dist[right] > dist[largest] ||\n             (dist[right] == dist[largest] && seq[right] > seq[largest]))) {\n            largest = right;\n        }\n        if (largest != idx) {\n            float td = dist[idx]; dist[idx] = dist[largest]; dist[largest] = td;\n            char tl = label[idx]; label[idx] = label[largest]; label[largest] = tl;\n            int ts = seq[idx]; seq[idx] = seq[largest]; seq[largest] = ts;\n            idx = largest;\n        } else {\n            break;\n        }\n    }\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    float *heap_dist = (float *) malloc(sizeof(float) * k);\n    char *heap_label = (char *) malloc(sizeof(char) * k);\n    int *heap_seq = (int *) malloc(sizeof(int) * k);\n\n    int heap_size = 0;\n    int point_seq = 0;\n\n    int i, j, t;\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        // Process points in batches of four using NEON\n        for (j = 0; j + 3 < g.length; j += 4) {\n            float32x4x2_t pts = vld2q_f32((const float32_t *)&g.points[j]);\n            float32x4_t xs = pts.val[0];\n            float32x4_t ys = pts.val[1];\n            float32x4_t qx = vdupq_n_f32(to_evaluate.x);\n            float32x4_t qy = vdupq_n_f32(to_evaluate.y);\n            float32x4_t dx = xs - qx;\n            float32x4_t dy = ys - qy;\n            float32x4_t d2 = dx * dx + dy * dy;\n            float d[4];\n            vst1q_f32(d, d2);\n\n            for (t = 0; t < 4; t++) {\n                int cur_seq = point_seq++;\n                if (heap_size < k) {\n                    heap_dist[heap_size] = d[t];\n                    heap_label[heap_size] = g.label;\n                    heap_seq[heap_size] = cur_seq;\n                    sift_up(heap_dist, heap_label, heap_seq, heap_size);\n                    heap_size++;\n                } else if (d[t] < heap_dist[0]) {\n                    heap_dist[0] = d[t];\n                    heap_label[0] = g.label;\n                    heap_seq[0] = cur_seq;\n                    sift_down(heap_dist, heap_label, heap_seq, k, 0);\n                }\n            }\n        }\n\n        // Scalar remainder\n        for (; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            int cur_seq = point_seq++;\n            if (heap_size < k) {\n                heap_dist[heap_size] = d;\n                heap_label[heap_size] = g.label;\n                heap_seq[heap_size] = cur_seq;\n                sift_up(heap_dist, heap_label, heap_seq, heap_size);\n                heap_size++;\n            } else if (d < heap_dist[0]) {\n                heap_dist[0] = d;\n                heap_label[0] = g.label;\n                heap_seq[0] = cur_seq;\n                sift_down(heap_dist, heap_label, heap_seq, k, 0);\n            }\n        }\n    }\n\n    char *labels = (char *) malloc(sizeof(char) * k);\n\n    for (i = 0; i < k; i++) {\n        if (i < heap_size) {\n            labels[i] = heap_label[i];\n        } else {\n            labels[i] = -1;\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(heap_dist);\n    free(heap_label);\n    free(heap_seq);\n    free(labels);\n\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Replace the O(N*k) insertion-sort top-k selection with a max-heap that uses (distance, insertion-sequence) tie-breaking to exactly reproduce the reference's strict-less insertion semantics, reducing complexity to O(N log k). Combine this with NEON SIMD batch distance computation for groups of four points to improve memory-level parallelism and vectorization on ARM64 while preserving bit-exact floating-point results and exact tie-breaking behavior.",
  "notes": "The heap comparator treats larger distance as greater; for equal distances the later-inserted point (larger sequence number) is considered greater, so when a strictly smaller distance arrives it replaces exactly the most recently inserted among the current maximum-distance points, matching the reference's shift-and-drop behavior. NEON vld2q_f32 deinterleaves x/y coordinates of four consecutive Point structs for vectorized squared Euclidean distance computation; scalar remainder handles lengths not divisible by 4. Empty slots are filled with label -1 before qsort to match the original initialization.",

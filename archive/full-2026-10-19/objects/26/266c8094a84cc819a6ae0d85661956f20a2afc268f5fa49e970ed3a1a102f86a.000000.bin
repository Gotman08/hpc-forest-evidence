      "content": "#include <cstdio>\n#include <cstdlib>\n\nclass FastScanner {\n    static constexpr int BUFSIZE = 1 << 20;\n    char buf[BUFSIZE];\n    char* cur;\n    char* end;\n\n    bool refill() {\n        size_t r = fread(buf, 1, BUFSIZE, stdin);\n        cur = buf;\n        end = buf + r;\n        return r > 0;\n    }\n\npublic:\n    FastScanner() : cur(buf), end(buf) {}\n\n    inline int nextInt() {\n        while (true) {\n            if (cur == end && !refill()) return 0;\n            char c = *cur++;\n            if (c <= ' ') continue;\n\n            int sign = 1;\n            if (c == '-') {\n                sign = -1;\n                if (cur == end && !refill()) return 0;\n                c = *cur++;\n            }\n\n            int x = c - '0';\n            while (true) {\n                if (cur == end && !refill()) break;\n                char d = *cur++;\n                if (d < '0' || d > '9') break;\n                x = x * 10 + (d - '0');\n            }\n            return sign * x;\n        }\n    }\n};\n\nstatic inline long long maxWindow(const long long* __restrict col, int n, int s) {\n    long long cur = 0;\n    for (int i = 0; i < s; ++i) cur += col[i];\n    long long mx = cur;\n    const long long* add = col + s;\n    const long long* sub = col;\n    int j = s;\n    // Unroll by 4 to reduce loop overhead.\n    for (; j + 3 < n; j += 4, add += 4, sub += 4) {\n        cur += add[0] - sub[0];\n        if (cur > mx) mx = cur;\n        cur += add[1] - sub[1];\n        if (cur > mx) mx = cur;\n        cur += add[2] - sub[2];\n        if (cur > mx) mx = cur;\n        cur += add[3] - sub[3];\n        if (cur > mx) mx = cur;\n    }\n    for (; j < n; ++j, ++add, ++sub) {\n        cur += *add - *sub;\n        if (cur > mx) mx = cur;\n    }\n    return mx;\n}\n\nint main() {\n    FastScanner fs;\n    int n = fs.nextInt();\n    int s = fs.nextInt();\n\n    const size_t ringSize = (size_t)s + 1;\n    void* mem = nullptr;\n    if (posix_memalign(&mem, 64, sizeof(int) * ringSize * (size_t)n) != 0) return 1;\n    int* __restrict ring = static_cast<int*>(mem);\n\n    // Allocate column sums aligned as well.\n    void* colMem = nullptr;\n    if (posix_memalign(&colMem, 64, sizeof(long long) * (size_t)n) != 0) {\n        free(mem);\n        return 1;\n    }\n    long long* __restrict c = static_cast<long long*>(colMem);\n\n    for (int i = 0; i < n; ++i) c[i] = 0;\n\n    // Read first s rows and accumulate column sums.\n    for (int r = 0; r < s; ++r) {\n        int* row = ring + (size_t)r * n;\n        int j = 0;\n        for (; j + 3 < n; j += 4) {\n            int v0 = fs.nextInt();\n            int v1 = fs.nextInt();\n            int v2 = fs.nextInt();\n            int v3 = fs.nextInt();\n            row[j] = v0;\n            c[j] += v0;\n            row[j+1] = v1;\n            c[j+1] += v1;\n            row[j+2] = v2;\n            c[j+2] += v2;\n            row[j+3] = v3;\n            c[j+3] += v3;\n        }\n        for (; j < n; ++j) {\n            int v = fs.nextInt();\n            row[j] = v;\n            c[j] += v;\n        }\n    }\n\n    long long best = maxWindow(c, n, s);\n\n    const int limit = n - s;\n\n    int* po = ring;\n    int* pi = ring + (size_t)s * n;\n    const int* endRing = ring + ringSize * (size_t)n;\n\n    // Slide vertically: read one new row, update column sums, re-evaluate windows.\n    for (int i = 1; i <= limit; ++i) {\n        int j = 0;\n        for (; j + 3 < n; j += 4) {\n            int v0 = fs.nextInt();\n            int v1 = fs.nextInt();\n            int v2 = fs.nextInt();\n            int v3 = fs.nextInt();\n            pi[j] = v0;\n            c[j] += (long long)v0 - po[j];\n            pi[j+1] = v1;\n            c[j+1] += (long long)v1 - po[j+1];\n            pi[j+2] = v2;\n            c[j+2] += (long long)v2 - po[j+2];\n            pi[j+3] = v3;\n            c[j+3] += (long long)v3 - po[j+3];\n        }\n        for (; j < n; ++j) {\n            int v = fs.nextInt();\n            pi[j] = v;\n            c[j] += (long long)v - po[j];\n        }\n\n        long long curMax = maxWindow(c, n, s);\n        if (curMax > best) best = curMax;\n\n        po += n;\n        if (po == endRing) po = ring;\n        pi += n;\n        if (pi == endRing) pi = ring;\n    }\n\n    std::printf(\"%lld\\n\", best);\n\n    free(colMem);\n    free(mem);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

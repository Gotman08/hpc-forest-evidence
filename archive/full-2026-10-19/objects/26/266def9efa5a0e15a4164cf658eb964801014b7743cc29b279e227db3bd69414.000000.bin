      "content": "#include \"knn.h\"\n#include <omp.h>\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    for (int i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1.0f;\n    }\n\n    #pragma omp parallel\n    {\n        float local_dist[k];\n        char local_labels[k];\n        for (int t = 0; t < k; t++) {\n            local_dist[t] = -1.0f;\n            local_labels[t] = -1;\n        }\n\n        #pragma omp for schedule(guided) nowait\n        for (int i = 0; i < n_groups; i++) {\n            Group g = groups[i];\n            for (int j = 0; j < g.length; j++) {\n                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n                int x;\n                for (x = 0; x < k; x++) {\n                    if (d < local_dist[x] || local_dist[x] == -1.0f) {\n                        // shift right\n                        for (int y = k-1; y > x; y--) {\n                            local_dist[y] = local_dist[y-1];\n                            local_labels[y] = local_labels[y-1];\n                        }\n                        local_dist[x] = d;\n                        local_labels[x] = g.label;\n                        break;\n                    }\n                }\n            }\n        }\n\n        #pragma omp critical\n        {\n            for (int t = 0; t < k; t++) {\n                if (local_dist[t] == -1.0f) continue;\n                float d = local_dist[t];\n                char lbl = local_labels[t];\n                int x;\n                for (x = 0; x < k; x++) {\n                    if (d < distances[x] || distances[x] == -1.0f) {\n                        // shift global\n                        for (int y = k-1; y > x; y--) {\n                            distances[y] = distances[y-1];\n                            labels[y] = labels[y-1];\n                        }\n                        distances[x] = d;\n                        labels[x] = lbl;\n                        break;\n                    }\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i-1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i-1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n    }\n\n    if (current_frequency > most_frequent_count) {\n        most_frequent = labels[k-1];\n    }\n\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Using OpenMP guided scheduling over groups with per-thread local top-k arrays and critical section merge improves load balance across variable-length groups while preserving correctness.",
  "notes": "This candidate uses OpenMP work sharing and scheduling to distribute group computations. Per-thread arrays reduce contention; guided scheduling adapts chunk sizes for variable-length groups.",

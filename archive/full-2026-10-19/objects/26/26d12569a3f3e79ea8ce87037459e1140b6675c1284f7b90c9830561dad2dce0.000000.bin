{
  "src/knn.c": "#include \"knn.h\"\n#include <string.h>\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j;\n    int filled = 0;\n    int ordered = 1;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            float worst = distances[k - 1];\n\n            /* Ordered comparison leaves NaNs on the original search path. */\n            if (worst != -1.0f && d >= worst) {\n                continue;\n            }\n\n            int insertion;\n            if (ordered && d == d) {\n                /* Narrow the sorted occupied prefix before a short SIMD scan. */\n                int first = 0;\n                int limit = filled;\n                while (limit - first > 16) {\n                    int middle = first + (limit - first) / 2;\n                    if (d < distances[middle]) {\n                        limit = middle;\n                    } else {\n                        first = middle + 1;\n                    }\n                }\n\n                /* Count equal distances too, preserving stable insertion order. */\n                int before = 0;\n                #pragma omp simd reduction(+: before)\n                for (int x = first; x < limit; x++) {\n                    before += distances[x] <= d;\n                }\n                insertion = first + before;\n            } else {\n                /* NaNs can disrupt ordering: retain the original first match. */\n                insertion = k;\n                #pragma omp simd reduction(min: insertion)\n                for (int x = 0; x < k; x++) {\n                    int candidate = (d < distances[x] || distances[x] == -1.0f)\n                                  ? x : k;\n                    if (candidate < insertion) {\n                        insertion = candidate;\n                    }\n                }\n            }\n\n            if (insertion < k) {\n                /* Unoccupied entries already contain their sentinel values. */\n                int last = filled < k ? filled : k - 1;\n                size_t count = (size_t) (last - insertion);\n                if (count != 0) {\n                    /* These shifts overlap and must not be independent stores. */\n                    memmove(distances + insertion + 1, distances + insertion,\n                            count * sizeof(*distances));\n                    memmove(labels + insertion + 1, labels + insertion,\n                            count * sizeof(*labels));\n                }\n\n                distances[insertion] = d;\n                labels[insertion] = g.label;\n                if (filled < k) {\n                    filled++;\n                }\n                if (d != d) {\n                    ordered = 0;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
  "src/knn.h": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}"
}

#include <algorithm>
#include <iostream>
#include <vector>
#include <omp.h>

using namespace std;

const int MOD = 1000000007;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) return 0;

    vector<vector<int>> blockedColumns(n);
    for (int c = 0; c < m; ++c) {
        int y, x;
        cin >> y >> x;
        blockedColumns[y].push_back(x);
    }
    for (auto &columns : blockedColumns) {
        sort(columns.begin(), columns.end());
        columns.erase(unique(columns.begin(), columns.end()), columns.end());
    }

    vector<int> previous(n, 0), current(n, 0);
    vector<unsigned char> blocked(n, 0);

    if (!binary_search(blockedColumns[0].begin(), blockedColumns[0].end(), 0)) {
        previous[0] = 1;
        for (int j = 1; j < n; ++j) {
            if (binary_search(blockedColumns[0].begin(), blockedColumns[0].end(), j)) break;
            previous[j] = 1;
        }
    }

    const int maxThreads = max(1, omp_get_max_threads());
    vector<int> chunkSums(maxThreads, 0);
    vector<int> firstBlocked(maxThreads, -1);
    vector<int> carries(maxThreads, 0);

#pragma omp parallel shared(previous, current, blocked, blockedColumns, chunkSums, firstBlocked, carries)
    {
        const int tid = omp_get_thread_num();
        const int threads = omp_get_num_threads();
        const int begin = (static_cast<long long>(tid) * n) / threads;
        const int end = (static_cast<long long>(tid + 1) * n) / threads;

        for (int row = 1; row < n; ++row) {
#pragma omp single
            {
                fill(blocked.begin(), blocked.end(), 0);
                for (int column : blockedColumns[row]) blocked[column] = 1;
            }
#pragma omp barrier

            int sum = 0;
            int first = -1;
            for (int j = begin; j < end; ++j) {
                if (blocked[j]) {
                    if (first == -1) first = j - begin;
                    sum = 0;
                    current[j] = 0;
                } else {
                    sum += previous[j];
                    if (sum >= MOD) sum -= MOD;
                    current[j] = sum;
                }
            }
            chunkSums[tid] = sum;
            firstBlocked[tid] = first;

#pragma omp barrier
#pragma omp single
            {
                int carry = 0;
                for (int t = 0; t < threads; ++t) {
                    carries[t] = carry;
                    if (firstBlocked[t] != -1) {
                        carry = chunkSums[t];
                    } else {
                        carry += chunkSums[t];
                        if (carry >= MOD) carry -= MOD;
                    }
                }
            }
#pragma omp barrier

            const int limit = firstBlocked[tid] == -1 ? end : begin + firstBlocked[tid];
            for (int j = begin; j < limit; ++j) {
                current[j] += carries[tid];
                if (current[j] >= MOD) current[j] -= MOD;
            }

#pragma omp barrier
#pragma omp single
            {
                previous.swap(current);
            }
#pragma omp barrier
        }
    }

    cout << previous[n - 1] << '\n';
    return 0;
}

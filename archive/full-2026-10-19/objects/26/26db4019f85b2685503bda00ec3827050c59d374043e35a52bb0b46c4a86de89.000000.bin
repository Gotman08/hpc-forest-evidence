{"files":[{"content":"#include <cassert>\n#include <climits>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <vector>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\nint main() {\n    int n, s;\n    if (std::scanf(\"%d %d\", &n, &s) != 2) return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t row_width = static_cast<std::size_t>(n);\n    std::vector<int> matrix(row_width * row_width);\n    for (int r = 0; r < n; ++r) {\n        int* row = matrix.data() + static_cast<std::size_t>(r) * row_width;\n        for (int c = 0; c < n; ++c) {\n            if (std::scanf(\"%d\", &row[c]) != 1) return 0;\n        }\n    }\n\n    const int window_count = n - s + 1;\n    long long max_sum = LLONG_MIN;\n\n    #pragma omp parallel reduction(max:max_sum)\n    {\n        int team_size = 1;\n#ifdef _OPENMP\n        team_size = omp_get_num_threads();\n#endif\n\n        // Each statically assigned block owns a contiguous range of top rows.\n        #pragma omp for schedule(static, 1)\n        for (int block = 0; block < team_size; ++block) {\n            const int first = static_cast<int>(\n                static_cast<long long>(window_count) * block / team_size);\n            const int last = static_cast<int>(\n                static_cast<long long>(window_count) * (block + 1) / team_size);\n\n            if (first < last) {\n                std::vector<std::int64_t> vertical(row_width, 0);\n\n                // Initialize the vertical sums for this block's first top row.\n                for (int r = first; r < first + s; ++r) {\n                    const int* row = matrix.data() +\n                                     static_cast<std::size_t>(r) * row_width;\n                    for (int c = 0; c < n; ++c) {\n                        vertical[static_cast<std::size_t>(c)] += row[c];\n                    }\n                }\n\n                for (int top = first; top < last; ++top) {\n                    if (top > first) {\n                        const int* leaving = matrix.data() +\n                            static_cast<std::size_t>(top - 1) * row_width;\n                        const int* entering = matrix.data() +\n                            static_cast<std::size_t>(top + s - 1) * row_width;\n                        int c = 0;\n#if defined(__aarch64__)\n                        for (; c + 4 <= n; c += 4) {\n                            const int32x4_t entering_values = vld1q_s32(entering + c);\n                            const int32x4_t leaving_values = vld1q_s32(leaving + c);\n\n                            const int64x2_t entering_low =\n                                vmovl_s32(vget_low_s32(entering_values));\n                            const int64x2_t leaving_low =\n                                vmovl_s32(vget_low_s32(leaving_values));\n                            const int64x2_t entering_high =\n                                vmovl_s32(vget_high_s32(entering_values));\n                            const int64x2_t leaving_high =\n                                vmovl_s32(vget_high_s32(leaving_values));\n\n                            int64x2_t sums_low = vld1q_s64(vertical.data() + c);\n                            int64x2_t sums_high = vld1q_s64(vertical.data() + c + 2);\n                            sums_low = vaddq_s64(\n                                sums_low, vsubq_s64(entering_low, leaving_low));\n                            sums_high = vaddq_s64(\n                                sums_high, vsubq_s64(entering_high, leaving_high));\n                            vst1q_s64(vertical.data() + c, sums_low);\n                            vst1q_s64(vertical.data() + c + 2, sums_high);\n                        }\n#endif\n                        for (; c < n; ++c) {\n                            vertical[static_cast<std::size_t>(c)] +=\n                                static_cast<std::int64_t>(entering[c]) - leaving[c];\n                        }\n                    }\n\n                    long long sum = 0;\n                    for (int c = 0; c < s; ++c) {\n                        sum += vertical[static_cast<std::size_t>(c)];\n                    }\n                    if (sum > max_sum) max_sum = sum;\n\n                    for (int left = 1; left < window_count; ++left) {\n                        sum += vertical[static_cast<std::size_t>(left + s - 1)] -\n                               vertical[static_cast<std::size_t>(left - 1)];\n                        if (sum > max_sum) max_sum = sum;\n                    }\n                }\n            }\n        }\n    }\n\n    std::printf(\"%lld\\n\", max_sum);\n    return 0;\n}","path":"src/solution.cpp"}],"hypothesis":"Adding AArch64 NEON updates to the fastest measured top-row-block rolling-sum candidate may improve its per-row vertical-sum throughput while retaining a scalar tail and the existing 64-bit horizontal recurrence. The controller should evaluate the integrated program end to end.","notes":"One bounded integration candidate; no commands were run. Correctness and performance remain for controller evaluation.","sources_kept":["3945be75cb784f83","df9bde101ba04a22"],"transformations":["Use contiguous row-major storage and scanf input; partition top-row windows into balanced blocks with private rolling vertical sums and combine block maxima using an OpenMP max reduction with 64-bit sums.","Update four independent vertical sums at a time with AArch64 NEON, widening inputs before subtraction; retain a scalar tail and the horizontal sliding recurrence."]}
#include <iostream>
#include <vector>
#include <cstdio>
#include <algorithm>

int main() {
	int n, s;
	std::cin >> n >> s;

	// Flatten matrix into a contiguous 1D array for better spatial locality
	const int np1 = n + 1; // size of prefix sum dimension (extra row/col of zeros)
	std::vector<int> mat(n * n);
	for (int i = 0; i < n; ++i) {
		for (int j = 0; j < n; ++j) {
			scanf("%d", &mat[i * n + j]);
		}
	}

	// Integral image (summed-area table) using long long to avoid overflow
	std::vector<long long> pref(np1 * np1, 0LL);

	// First pass: horizontal cumulative sums per row
	for (int i = 0; i < n; ++i) {
		long long row_sum = 0;
		const int base_i = (i + 1) * np1;
		const int mat_base = i * n;
		for (int j = 0; j < n; ++j) {
			row_sum += mat[mat_base + j];
			pref[base_i + (j + 1)] = row_sum;
		}
	}

	// Second pass: vertical accumulation to complete the integral image
	for (int i = 0; i < n; ++i) {
		const int base_cur = (i + 1) * np1;
		const int base_prev = i * np1;
		for (int j = 0; j < n; ++j) {
			pref[base_cur + (j + 1)] += pref[base_prev + (j + 1)];
		}
	}

	// Precompute row offsets for faster access in search loop
	std::vector<int> row_offset(np1);
	for (int i = 0; i < np1; ++i) {
		row_offset[i] = i * np1;
	}

	// Search for maximum SxS submatrix sum using blocking to improve cache reuse
	const int B = 128; // block size, tuned for typical cache sizes (reduced from 256)
	long long mxSum = -9223372036854775807LL - 1; // LLONG_MIN

	for (int ii = 0; ii < n - s + 1; ii += B) {
		const int i_end = std::min(ii + B, n - s + 1);
		for (int jj = 0; jj < n - s + 1; jj += B) {
			const int j_end = std::min(jj + B, n - s + 1);
			for (int i = ii; i < i_end; ++i) {
				const long long *row_i_s = &pref[row_offset[i + s]];
				const long long *row_i   = &pref[row_offset[i]];
				for (int j = jj; j < j_end; ++j) {
					long long sum = row_i_s[j + s] - row_i[j + s]
					               - row_i_s[j] + row_i[j];
					if (sum > mxSum) mxSum = sum;
				}
			}
		}
	}

	printf("%d\n", static_cast<int>(mxSum));
	return 0;
}

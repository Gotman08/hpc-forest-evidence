"""Local parent receipts from actual received submission/markers/census/transport. No network or model."""
from pathlib import Path
from datetime import datetime, timezone
import argparse, hashlib, json, subprocess, sys

BASE = Path(__file__).resolve().parents[3]
HERE = Path(__file__).resolve().parent
MODELS = {'astra-max': ('gpt-6-astra', '26d58fc2d88f423d9b5fd241ade3d185'), 'terra-max': ('gpt-5.6-terra', 'fee3bd8ba5fc4e6eafa1167ef279f9fa'), 'sol-max': ('gpt-6.1-sol', '182500fef7c546af87f14498de353581')}
SCOPE = 'hpc-forest-primes-native-max-r2d'
SOURCE = '13ccaf7c74d13db246d1127a25c511bc03d7989ba9097eb6ad7b4f681c0a0a46'
PLAN = '5e052db689fc423720be60dab97fbca70c82b64487d02d3d8fe2d0f796d9c96c'

def read(p): return json.loads(Path(p).read_text('utf-8-sig'))
def sha(p): return hashlib.sha256(Path(p).read_bytes()).hexdigest()
def ref(p): return {'path': str(Path(p).resolve()), 'sha256': sha(p)}
def save(p, value):
    with Path(p).open('x', encoding='utf-8', newline='\n') as f: f.write(json.dumps(value, ensure_ascii=False, indent=2)+'\n')
    return ref(p)
def raw(v): return v.get('structuredContent',v)
def fresh(v,key='observed_at',limit=120):
    age=(datetime.now(timezone.utc)-datetime.fromisoformat(v[key])).total_seconds()
    assert 0 <= age <= limit, ('stale evidence',key,age)

def main():
    ap=argparse.ArgumentParser(); ap.add_argument('--bindings',type=Path,required=True); ap.add_argument('--review',type=Path,required=True); ap.add_argument('--census',type=Path,required=True); ap.add_argument('--remote-check',type=Path,required=True); ap.add_argument('--source-state-directory',type=Path,required=True); ap.add_argument('--run-factories',action='store_true'); a=ap.parse_args()
    bindings=read(a.bindings); assert bindings['verified'] is True and bindings['source_zip']['sha256']==SOURCE and bindings['plan']['sha256']==PLAN
    review=read(a.review); assert review['verified'] is True and not review['blocking_findings']
    census=read(a.census); fresh(census,'captured_at_utc'); assert census['complete_census'] is True
    remote=read(a.remote_check); fresh(remote); check=raw(remote['result']); assert check['ok'] is True and not check['unchecked'] and all(v['exists'] is False for v in check['paths'])
    rows={v['path']:v for v in check['paths']}
    decision=HERE/'DECISION-HUMAINE-RELANCE-DISTINCTE.json'
    common={'scope_id':SCOPE,'source_zip_sha256':SOURCE,'plan_sha256':PLAN}
    cohort={**common,'schema':'hpc-forest-max-cell-cap4-cohort-reservation-v1','verified':True,'maximum_native_workers':4,'source_only_preserved':False,'source_only_state':'received_absent','luna_not_replayed':True,'one_submit_per_cell':True,'cells':{},'evidence_refs':[ref(decision),ref(HERE/'RECEPTION-TROIS-PREFLIGHTS-ZERO-MODELE.json'),ref(a.census),ref(a.review)]}
    for slug,(model,session) in MODELS.items():
        d=HERE/slug; submitted=raw(read(d/'submission-observed.json')); marker=read(d/'allocation-ready.json'); fresh(marker,'utc',600)
        assert submitted['submission_observed'] is True and marker['job_id']==submitted['job_id'] and marker['model']==model and marker['session_id']==session and marker['native_model_calls']==0
        assert marker['verified'] is True and marker['source_zip_sha256']==SOURCE and marker['plan_sha256']==PLAN
        assert rows['/scratch_p/nimarano/'+SCOPE+'-'+session]['exists'] is False
        cohort['cells'][model]={'session_id':session,'effort':'max','job_id':submitted['job_id'],'submission_intent':ref(d/'submission-intent.json'),'submission_observed':ref(d/'submission-observed.json'),'allocation_ready':ref(d/'allocation-ready.json')}
    cohort_ref=save(HERE/'cohort-reservation-reelle.json',cohort)
    source_only={'schema':'hpc-forest-r2d-private-source-only-input-v1','source_only_state':'received_absent','scientific_reception':ref(BASE/'outputs/HPC-Forest-Harnais-Comparaison-r1/receptions/source-only-sol-max-751592/reception-verifiee.json'),'reconciliation':ref(BASE/'outputs/HPC-Forest-Harnais-Comparaison-r1/receptions/source-only-sol-max-751592/reconciliation-livraisons-r1/RECONCILIATION-LIVRAISONS.json'),'source_only_absence':ref(a.source_state_directory/'INPUT-source-only-CURRENT.json'),'observer_release':ref(a.source_state_directory/'INPUT-observer3-CURRENT.json'),'current_verification':ref(a.source_state_directory/'VERIFICATION-CURRENT.json'),'local_projection_producer_review':ref(a.review)}
    outputs=[]
    for slug,(model,session) in MODELS.items():
        d=HERE/slug; job=cohort['cells'][model]['job_id']; now=datetime.now(timezone.utc).isoformat()
        identity={**common,'model':model,'session_id':session,'effort':'max','job_id':job,'verified':True,'observed_at':now}
        rf=save(d/'remote-freshness.json',{**identity,'schema':'hpc-forest-max-cell-remote-freshness-observation-v1','remote_root':'/scratch_p/nimarano/'+SCOPE+'-'+session,'admission_root':'/scratch_p/nimarano/'+SCOPE+'-admission-attempt2-'+session,'native_root_absent':True,'registry_absent':True,'channel_absent':True,'prior_session_claims_absent':True,'parent_actual_observation_reviewed':True,'evidence_refs':[ref(a.remote_check),ref(d/'allocation-ready.json'),ref(HERE/'RECEPTION-TROIS-PREFLIGHTS-ZERO-MODELE.json')]})
        config=Path('C:/Users/nicol/.codex/config.toml')
        tr=save(d/'transport.json',{**identity,'schema':'hpc-forest-max-cell-existing-transport-observation-v1','transport_name':'romeo-mcp','configuration_path':str(config),'configuration_sha256':sha(config),'existing_transport_only':True,'no_new_authentication':True,'cli_tools_disabled':True,'neutral_controls_passed':True,'parent_actual_observation_reviewed':True,'limits':'Actual received R2d Q752606 qualification, readonly MCP path check and generic neutral factory controls only; no new diagnostic inference. Normal native delivery/evaluation still required.','evidence_refs':[bindings['qualification_reception'],ref(a.remote_check),ref(a.review)]})
        human=save(d/'human-scope.json',{**identity,'schema':'hpc-forest-max-cell-human-scope-attestation-v1','max_only':True,'one_cell_only':True,'automatic_extension':False,'user_messages':['toujours en max','lance tous en meme temps stp'],'evidence_refs':[ref(decision)]})
        obs=save(d/'parent-observations.json',{**identity,'schema':'hpc-forest-max-cell-parent-observations-v1','complete_utf8_cim':ref(a.census),'allocation_ready':ref(d/'allocation-ready.json'),'remote_freshness':rf,'transport':tr,'source_only':source_only,'running_cells':[],'evidence_refs':[ref(a.census),ref(a.remote_check),ref(d/'allocation-ready.json'),ref(HERE/'RECEPTION-TROIS-PREFLIGHTS-ZERO-MODELE.json')]})
        factory=save(d/'factory-input.json',{'schema':'hpc-forest-max-cell-factory-input-v1','job_id':job,'submission_intent':ref(d/'submission-intent.json'),'submission_observed':ref(d/'submission-observed.json'),'observations':obs,'factory_review':ref(a.review),'human_scope':human,'cohort_reservation':cohort_ref})
        argv=[sys.executable,'-B',str(BASE/'outputs/HPC-Forest-Primes-Natif-Lancement-r2d/revision-r3-attempt2/assembler-admissions-cellule.py'),'--bindings',str(a.bindings),'--bindings-sha256',sha(a.bindings),'--model',model,'--input',factory['path'],'--input-sha256',factory['sha256'],'--output-name','admissions-attempt2-'+slug+'-reelles']
        if a.run_factories:
            p=subprocess.run(argv,capture_output=True,text=True,encoding='utf-8'); (d/'factory.stdout').write_text(p.stdout,'utf-8');(d/'factory.stderr').write_text(p.stderr,'utf-8');assert p.returncode==0,(slug,p.stderr,p.stdout)
            outputs.append(json.loads(p.stdout))
        else: outputs.append({'argv':argv})
    save(HERE/'factories-resultats.json',{'outputs':outputs,'models_started':0,'remote_actions':0});print(json.dumps(outputs))

if __name__=='__main__':main()

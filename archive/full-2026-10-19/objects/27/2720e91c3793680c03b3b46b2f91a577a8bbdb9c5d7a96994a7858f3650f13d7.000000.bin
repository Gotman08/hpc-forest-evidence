      "content": "#include <algorithm>\n#include <cstddef>\n#include <cstring>\n#include <iostream>\n#include <iterator>\n#include <string>\n#include <utility>\n\nclass IsWhitespace\n{\npublic:\n    bool operator () (char c) const\n    {\n        return (c == ' ')\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v');\n    }\n};\n\nstatic std::string\nremove_whitespaces (std::string text)\n{\n    text.erase(\n        std::remove_if(text.begin(), text.end(), IsWhitespace()),\n        text.end());\n    return text;\n}\n\nstatic std::string\nread_text_from_stdin (std::istream& input)\n{\n    std::istreambuf_iterator<char> begin(input);\n    std::istreambuf_iterator<char> end;\n    return remove_whitespaces(std::string(begin, end));\n}\n\nclass BufferedOutput\n{\npublic:\n    enum { buffer_capacity = 64 * 1024 };\n\n    explicit BufferedOutput (std::ostream& output)\n        : output_(output)\n        , used_(0)\n    {\n    }\n\n    static std::size_t capacity ()\n    {\n        return static_cast<std::size_t>(buffer_capacity);\n    }\n\n    void append (char const* data, std::size_t count)\n    {\n        while (count != 0) {\n            if (used_ == sizeof(buffer_)) {\n                flush_buffer();\n            }\n            std::size_t const available = sizeof(buffer_) - used_;\n            std::size_t const copied = count < available ? count : available;\n            std::memcpy(buffer_ + used_, data, copied);\n            used_ += copied;\n            data += copied;\n            count -= copied;\n        }\n    }\n\n    void append (char value)\n    {\n        if (used_ == sizeof(buffer_)) {\n            flush_buffer();\n        }\n        buffer_[used_++] = value;\n    }\n\n    void flush ()\n    {\n        flush_buffer();\n        output_.flush();\n    }\n\nprivate:\n    void flush_buffer ()\n    {\n        if (used_ != 0) {\n            output_.write(buffer_, static_cast<std::streamsize>(used_));\n            used_ = 0;\n        }\n    }\n\n    std::ostream& output_;\n    std::size_t used_;\n    char buffer_[buffer_capacity];\n};\n\nclass PermutationPrinter\n{\npublic:\n    PermutationPrinter (BufferedOutput& output, std::string const& text)\n        : output_(output)\n        , use_record_(text.size() <= fixed_record_limit())\n    {\n        if (use_record_) {\n            record_.reserve(text.size() * 2U + 4U);\n            record_.push_back('[');\n            record_.push_back(' ');\n            for (std::string::const_iterator it = text.begin();\n                 it != text.end(); ++it) {\n                record_.push_back(*it);\n                record_.push_back(' ');\n            }\n            record_.push_back(']');\n            record_.push_back('\\n');\n        }\n    }\n\n    bool next (std::string& text)\n    {\n        typedef std::string::size_type size_type;\n        size_type const size = text.size();\n        if (size < 2) {\n            return false;\n        }\n\n        size_type suffix = size - 1;\n        while ((suffix != 0)\n               && (text[suffix - 1] >= text[suffix])) {\n            --suffix;\n        }\n        if (suffix == 0) {\n            return false;\n        }\n\n        size_type const pivot = suffix - 1;\n        size_type successor = size - 1;\n        while ((successor > suffix)\n               && (text[successor] <= text[pivot])) {\n            --successor;\n        }\n\n        std::swap(text[pivot], text[successor]);\n        if (use_record_) {\n            std::swap(record_[record_position(pivot)],\n                      record_[record_position(successor)]);\n            size_type left = suffix;\n            size_type right = size - 1;\n            while (left < right) {\n                std::swap(text[left], text[right]);\n                std::swap(record_[record_position(left)],\n                          record_[record_position(right)]);\n                ++left;\n                --right;\n            }\n        } else {\n            size_type left = suffix;\n            size_type right = size - 1;\n            while (left < right) {\n                std::swap(text[left], text[right]);\n                ++left;\n                --right;\n            }\n        }\n        return true;\n    }\n\n    void write (std::string const& text)\n    {\n        if (use_record_) {\n            output_.append(record_.data(), record_.size());\n            return;\n        }\n\n        output_.append(\"[ \", 2);\n        for (std::string::const_iterator it = text.begin();\n             it != text.end(); ++it) {\n            output_.append(*it);\n            output_.append(' ');\n        }\n        output_.append(\"]\\n\", 2);\n    }\n\nprivate:\n    static std::string::size_type fixed_record_limit ()\n    {\n        return (static_cast<std::string::size_type>(\n                    BufferedOutput::capacity()) - 4U) / 2U;\n    }\n\n    static std::string::size_type\n    record_position (std::string::size_type index)\n    {\n        return 2U + index * 2U;\n    }\n\n    BufferedOutput& output_;\n    bool use_record_;\n    std::string record_;\n};\n\nstatic void\nprint_permutations (std::string text, BufferedOutput& output)\n{\n    if (text.empty()) {\n        return;\n    }\n\n    std::sort(text.begin(), text.end());\n    PermutationPrinter printer(output, text);\n    printer.write(text);\n    while (printer.next(text)) {\n        printer.write(text);\n    }\n}\n\nint main ()\n{\n    std::ios_base::sync_with_stdio(false);\n    std::cin.tie(0);\n\n    std::string text = read_text_from_stdin(std::cin);\n    BufferedOutput output(std::cout);\n    print_permutations(text, output);\n    output.flush();\n    return 0;\n}\n",
      "path": "src/permutations.cc"
    }
  ],
  "hypothesis": "Lexicographic states have a true serial dependency, but per-line flushing and repeated formatting are avoidable. Mirroring each safe successor's swaps into a fixed record and copying records through a bounded contiguous buffer should reduce overhead and expose efficient ARM64 bulk-copy paths without changing output order.",
  "notes": "No cross-permutation parallelization is used. The guarded successor avoids terminal iterator underflow; records larger than the fixed buffer use the same algorithm with bounded direct formatting.",
  "sources_kept": [],
  "transformations": [
    "Replace the underflow-prone backward iterator scan with guarded index-based lexicographic successor logic preserving the original char ordering.",
    "Maintain formatting delimiters once and synchronize only character slots affected by each pivot swap and suffix reversal.",
    "Replace std::endl-per-record output with a 64 KiB bounded buffer using contiguous memcpy copies and one final flush."
  ]

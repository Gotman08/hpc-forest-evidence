{
  "src/solution.cpp": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nstatic constexpr std::uint32_t MOD = 1000000007u;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic inline uint32x4_t reduce_sum(uint32x4_t sum, uint32x4_t modulus) {\n    // Both operands of each addition are reduced, so sum is below 2 * MOD.\n    // Unsigned subtraction wraps above sum exactly when sum is below MOD.\n    return vminq_u32(sum, vsubq_u32(sum, modulus));\n}\n\nstatic inline uint32x4_t prefix_four(uint32x4_t values,\n                                     uint32x4_t zero,\n                                     uint32x4_t modulus) {\n    values = reduce_sum(\n        vaddq_u32(values, vextq_u32(zero, values, 3)), modulus);\n    values = reduce_sum(\n        vaddq_u32(values, vextq_u32(zero, values, 2)), modulus);\n    return values;\n}\n#endif\n\nstatic inline void accumulate_span(std::uint32_t* dp, int begin, int end) {\n    int column = begin;\n    std::uint32_t left = 0;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const uint32x4_t zero = vdupq_n_u32(0);\n    const uint32x4_t modulus = vdupq_n_u32(MOD);\n    uint32x4_t carry = zero;\n\n    for (; column + 8 <= end; column += 8) {\n        uint32x4_t first = prefix_four(\n            vld1q_u32(dp + column), zero, modulus);\n        uint32x4_t second = prefix_four(\n            vld1q_u32(dp + column + 4), zero, modulus);\n\n        first = reduce_sum(vaddq_u32(first, carry), modulus);\n        second = reduce_sum(\n            vaddq_u32(second, vdupq_laneq_u32(first, 3)), modulus);\n\n        vst1q_u32(dp + column, first);\n        vst1q_u32(dp + column + 4, second);\n        carry = vdupq_laneq_u32(second, 3);\n    }\n\n    if (column + 4 <= end) {\n        uint32x4_t values = prefix_four(\n            vld1q_u32(dp + column), zero, modulus);\n        values = reduce_sum(vaddq_u32(values, carry), modulus);\n        vst1q_u32(dp + column, values);\n        carry = vdupq_laneq_u32(values, 3);\n        column += 4;\n    }\n\n    left = vgetq_lane_u32(carry, 0);\n#endif\n\n    for (; column < end; ++column) {\n        std::uint32_t sum = dp[column] + left;\n        if (sum >= MOD) {\n            sum -= MOD;\n        }\n        dp[column] = sum;\n        left = sum;\n    }\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n, m;\n    if (!(std::cin >> n >> m)) {\n        return 0;\n    }\n\n    std::vector<std::vector<int>> blocked_columns(n);\n    for (int obstacle = 0; obstacle < m; ++obstacle) {\n        int row, column;\n        std::cin >> row >> column;\n        blocked_columns[row].push_back(column);\n    }\n\n    std::vector<std::uint32_t> dp(n, 0);\n    dp[0] = 1;\n\n    for (int row = 0; row < n; ++row) {\n        std::vector<int>& obstacles = blocked_columns[row];\n        std::sort(obstacles.begin(), obstacles.end());\n\n        int begin = 0;\n        for (int column : obstacles) {\n            if (column < begin) {\n                continue;\n            }\n            accumulate_span(dp.data(), begin, column);\n            dp[column] = 0;\n            begin = column + 1;\n        }\n        accumulate_span(dp.data(), begin, n);\n    }\n\n    std::cout << dp[n - 1] << '\\n';\n    return 0;\n}\n"
}

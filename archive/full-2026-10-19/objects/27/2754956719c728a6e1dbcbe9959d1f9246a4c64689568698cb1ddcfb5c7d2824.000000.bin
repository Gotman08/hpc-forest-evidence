      "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\nusing namespace std;\n\nstatic constexpr int MOD = 1000000007;\nstatic constexpr int TILE = 128;\nstatic constexpr int LOCAL_BITS = 14;\n\nstatic inline int add_mod(int a, int b) {\n    int sum = a + b;\n    return sum >= MOD ? sum - MOD : sum;\n}\n\n#if defined(__aarch64__)\nstatic inline uint32x4_t add_mod4(uint32x4_t a, uint32x4_t b) {\n    const uint32x4_t modulus = vdupq_n_u32(MOD);\n    const uint32x4_t sum = vaddq_u32(a, b);\n    return vsubq_u32(sum, vandq_u32(vcgeq_u32(sum, modulus), modulus));\n}\n\nstatic inline uint32x4_t prefix_mod4(uint32x4_t values) {\n    const uint32x4_t zero = vdupq_n_u32(0);\n    values = add_mod4(values, vextq_u32(zero, values, 3));\n    return add_mod4(values, vextq_u32(zero, values, 2));\n}\n#endif\n\nstatic inline int advance_segment(int* row, int first, int last, int left) {\n    if (first >= last) return left;\n    int x = first;\n#if defined(__aarch64__)\n    uint32x4_t carry = vdupq_n_u32(static_cast<uint32_t>(left));\n    for (; x + 8 <= last; x += 8) {\n        uint32x4_t low = prefix_mod4(vld1q_u32(\n            reinterpret_cast<const uint32_t*>(row + x)));\n        uint32x4_t high = prefix_mod4(vld1q_u32(\n            reinterpret_cast<const uint32_t*>(row + x + 4)));\n        high = add_mod4(high, vdupq_laneq_u32(low, 3));\n        low = add_mod4(low, carry);\n        high = add_mod4(high, carry);\n        vst1q_u32(reinterpret_cast<uint32_t*>(row + x), low);\n        vst1q_u32(reinterpret_cast<uint32_t*>(row + x + 4), high);\n        carry = vdupq_laneq_u32(high, 3);\n    }\n    left = static_cast<int>(vgetq_lane_u32(carry, 0));\n#endif\n    for (; x < last; ++x) {\n        left = add_mod(row[x], left);\n        row[x] = left;\n    }\n    return left;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n    const int tiles = (n + TILE - 1) / TILE;\n\n    // Sort obstacles by tile wavefront, tile row, and local cell.\n    vector<uint64_t> blocked;\n    blocked.reserve(static_cast<size_t>(m));\n    for (int k = 0; k < m; ++k) {\n        int r, c;\n        cin >> r >> c;\n        const int tr = r / TILE;\n        const int tc = c / TILE;\n        const uint64_t key = static_cast<uint64_t>(tr + tc) * tiles + tr;\n        const uint64_t local = (r % TILE) * TILE + c % TILE;\n        blocked.push_back((key << LOCAL_BITS) | local);\n    }\n    sort(blocked.begin(), blocked.end());\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\n\n    // Retain one bottom boundary per tile column and one right boundary\n    // per tile row. Tiles on a wavefront access disjoint boundary slices.\n    vector<int> bottom(n, 0);\n    vector<int> right(n, 0);\n    bottom[0] = 1;\n\n    #pragma omp parallel if (n >= 1024)\n    {\n        alignas(64) int values[TILE];\n        for (int diagonal = 0; diagonal < 2 * tiles - 1; ++diagonal) {\n            const int first = max(0, diagonal - tiles + 1);\n            const int last = min(tiles - 1, diagonal);\n\n            #pragma omp for schedule(static)\n            for (int tr = first; tr <= last; ++tr) {\n                const int tc = diagonal - tr;\n                const int row_start = tr * TILE;\n                const int column_start = tc * TILE;\n                const int height = min(TILE, n - row_start);\n                const int width = min(TILE, n - column_start);\n                const uint64_t key = static_cast<uint64_t>(diagonal) * tiles + tr;\n                const uint64_t tile_base = key << LOCAL_BITS;\n                auto obstacle = lower_bound(blocked.cbegin(), blocked.cend(), tile_base);\n\n                for (int c = 0; c < width; ++c)\n                    values[c] = bottom[column_start + c];\n\n                for (int r = 0; r < height; ++r) {\n                    int left = right[row_start + r];\n                    int c = 0;\n                    const uint64_t row_end = tile_base + static_cast<uint64_t>(r + 1) * TILE;\n                    while (obstacle != blocked.cend() && *obstacle < row_end) {\n                        const int stop = static_cast<int>(*obstacle & (TILE - 1));\n                        left = advance_segment(values, c, stop, left);\n                        values[stop] = 0;\n                        left = 0;\n                        c = stop + 1;\n                        ++obstacle;\n                    }\n                    left = advance_segment(values, c, width, left);\n                    right[row_start + r] = left;\n                }\n\n                for (int c = 0; c < width; ++c)\n                    bottom[column_start + c] = values[c];\n            }\n            // The worksharing barrier publishes both boundaries before\n            // the next wavefront reads them.\n        }\n    }\n\n    cout << bottom[n - 1] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Integrating the archived eight-cell AArch64 modular prefix scan into the 128-tile wavefront incumbent may shorten its within-row dependency chain while preserving tile-level parallelism.",

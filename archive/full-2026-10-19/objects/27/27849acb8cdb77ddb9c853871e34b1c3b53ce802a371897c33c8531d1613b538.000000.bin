      "content": "#include <cstdio>\n#include <cstddef>\n#include <memory>\n#include <vector>\n\nclass FastInput {\n    unsigned char buffer_[1u << 16];\n    std::size_t position_ = 0;\n    std::size_t size_ = 0;\n\n    int nextByte() {\n        if (position_ == size_) {\n            size_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (size_ == 0) return EOF;\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    int readInt() {\n        int c;\n        do {\n            c = nextByte();\n        } while (c != EOF && c <= ' ');\n        if (c == EOF) return 0;\n\n        bool negative = false;\n        if (c == '-' || c == '+') {\n            negative = (c == '-');\n            c = nextByte();\n        }\n        unsigned int value = 0;\n        while (c >= '0' && c <= '9') {\n            value = value * 10u + static_cast<unsigned int>(c - '0');\n            c = nextByte();\n        }\n        const long long signedValue = negative\n            ? -static_cast<long long>(value)\n            : static_cast<long long>(value);\n        return static_cast<int>(signedValue);\n    }\n};\n\nstatic long long solveRegular(FastInput& input, int n, int s) {\n    const std::size_t stride = static_cast<std::size_t>(n);\n    std::unique_ptr<int[]> history(new int[stride * static_cast<std::size_t>(s)]);\n    std::vector<long long> column(static_cast<std::size_t>(n), 0);\n\n    for (int row = 0; row < s; ++row) {\n        int* saved = history.get() + static_cast<std::size_t>(row) * stride;\n        for (int j = 0; j < n; ++j) {\n            const int value = input.readInt();\n            saved[j] = value;\n            column[j] += value;\n        }\n    }\n\n    long long current = 0;\n    for (int j = 0; j < s; ++j) current += column[j];\n    long long best = current;\n    for (int j = s; j < n; ++j) {\n        current += column[j] - column[j - s];\n        if (current > best) best = current;\n    }\n\n    int slot = 0;\n    for (int row = s; row < n; ++row) {\n        int* expired = history.get() + static_cast<std::size_t>(slot) * stride;\n        current = 0;\n        for (int j = 0; j < s; ++j) {\n            const int value = input.readInt();\n            column[j] += static_cast<long long>(value) - expired[j];\n            expired[j] = value;\n            current += column[j];\n        }\n        if (current > best) best = current;\n        for (int j = s; j < n; ++j) {\n            const int value = input.readInt();\n            column[j] += static_cast<long long>(value) - expired[j];\n            expired[j] = value;\n            current += column[j] - column[j - s];\n            if (current > best) best = current;\n        }\n        if (++slot == s) slot = 0;\n    }\n    return best;\n}\n\nstatic long long solveSharedCore(FastInput& input, int n, int s) {\n    const int d = n - s;\n    const std::size_t stride = static_cast<std::size_t>(2 * d);\n    std::unique_ptr<int[]> edges(new int[stride * static_cast<std::size_t>(d)]);\n    std::vector<long long> savedMiddle(static_cast<std::size_t>(d));\n    std::vector<long long> edgeDifference(static_cast<std::size_t>(d), 0);\n    long long first = 0;\n\n    // Only these rows can leave a vertical window.\n    for (int row = 0; row < d; ++row) {\n        int* saved = edges.get() + static_cast<std::size_t>(row) * stride;\n        for (int j = 0; j < d; ++j) {\n            const int value = input.readInt();\n            saved[j] = value;\n            edgeDifference[j] -= value;\n            first += value;\n        }\n        long long middle = 0;\n        for (int j = d; j < s; ++j) middle += input.readInt();\n        savedMiddle[row] = middle;\n        first += middle;\n        for (int j = 0; j < d; ++j) {\n            const int value = input.readInt();\n            saved[d + j] = value;\n            edgeDifference[j] += value;\n        }\n    }\n\n    // The middle columns and these rows belong to every window.\n    for (int row = d; row < s; ++row) {\n        for (int j = 0; j < d; ++j) {\n            const int value = input.readInt();\n            edgeDifference[j] -= value;\n            first += value;\n        }\n        long long middle = 0;\n        for (int j = d; j < s; ++j) middle += input.readInt();\n        first += middle;\n        for (int j = 0; j < d; ++j) edgeDifference[j] += input.readInt();\n    }\n\n    long long current = first;\n    long long best = current;\n    for (int j = 0; j < d; ++j) {\n        current += edgeDifference[j];\n        if (current > best) best = current;\n    }\n\n    for (int row = 0; row < d; ++row) {\n        const int* expired = edges.get() + static_cast<std::size_t>(row) * stride;\n        for (int j = 0; j < d; ++j) {\n            const int value = input.readInt();\n            const long long delta = static_cast<long long>(value) - expired[j];\n            edgeDifference[j] -= delta;\n            first += delta;\n        }\n        long long middle = 0;\n        for (int j = d; j < s; ++j) middle += input.readInt();\n        first += middle - savedMiddle[row];\n        current = first;\n        if (current > best) best = current;\n\n        // Right-edge input completes each updated horizontal difference.\n        for (int j = 0; j < d; ++j) {\n            const int value = input.readInt();\n            edgeDifference[j] += static_cast<long long>(value) - expired[d + j];\n            current += edgeDifference[j];\n            if (current > best) best = current;\n        }\n    }\n    return best;\n}\n\nint main() {\n    FastInput input;\n    const int n = input.readInt();\n    const int s = input.readInt();\n    if (n <= 0 || s <= 0 || s >= n) return 0;\n\n    const long long result = s > n / 2\n        ? solveSharedCore(input, n, s)\n        : solveRegular(input, n, s);\n    std::printf(\"%lld\\n\", result);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Combining shared-core left and right column sums into one entering-minus-leaving difference array should improve cache locality by halving hot accumulator storage and eliminating a separate left-column load for each horizontal window.",
  "notes": "Unmeasured candidate. Preserves the regular path, input/output behavior, and 64-bit arithmetic.",

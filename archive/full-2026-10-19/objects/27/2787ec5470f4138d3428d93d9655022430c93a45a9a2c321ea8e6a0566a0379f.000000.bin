    "content": "{\n  \"hypothesis\": \"Optimize the n-body simulation by vectorizing the body_force function to improve performance.\",\n  \"transformations\": [\"vectorize_body_force\"],\n  \"sources_kept\": [],\n  \"files\": [\n    {\n      \"path\": \"src/nbody.c\",\n      \"content\": \"/*\\n * Each body holds coordinate positions (i.e., x, y, and z) and\\n * velocities (i.e., vx, vy, and vz).\\n */\\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\\n\\n/*\\n * Compute the gravitational impact among all pairs of bodies in \\n * the system using SIMD instructions.\\n */\\nvoid body_force(Body *p, float dt, int n) {\\n  for (int i = 0; i < n; i += 4) {\\n    float fx0 = 0.0f; float fx1 = 0.0f; float fx2 = 0.0f; float fx3 = 0.0f;\\n    float fy0 = 0.0f; float fy1 = 0.0f; float fy2 = 0.0f; float fy3 = 0.0f;\\n    float fz0 = 0.0f; float fz1 = 0.0f; float fz2 = 0.0f; float fz3 = 0.0f;\\n\\n    for (int j = 0; j < n; j += 4) {\\n      float dx0 = p[j].x - p[i].x;\\n      float dy0 = p[j].y - p[i].y;\\n      float dz0 = p[j].z - p[i].z;\\n      float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\\n      float inv_dist0 = 1 / sqrt(sqrd_dist0);\\n      float inv_dist30 = inv_dist0 * inv_dist0 * inv_dist0;\\n\\n      float dx1 = p[j+1].x - p[i].x;\\n      float dy1 = p[j+1].y - p[i].y;\\n      float dz1 = p[j+1].z - p[i].z;\\n      float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\\n      float inv_dist1 = 1 / sqrt(sqrd_dist1);\\n      float inv_dist31 = inv_dist1 * inv_dist1 * inv_dist1;\\n\\n      float dx2 = p[j+2].x - p[i].x;\\n      float dy2 = p[j+2].y - p[i].y;\\n      float dz2 = p[j+2].z - p[i].z;\\n      float sqrd_dist2 = dx2*dx2 + dy2*dy2 + dz2*dz2 + SOFTENING;\\n      float inv_dist2 = 1 / sqrt(sqrd_dist2);\\n      float inv_dist32 = inv_dist2 * inv_dist2 * inv_dist2;\\n\\n      float dx3 = p[j+3].x - p[i].x;\\n      float dy3 = p[j+3].y - p[i].y;\\n      float dz3 = p[j+3].z - p[i].z;\\n      float sqrd_dist3 = dx3*dx3 + dy3*dy3 + dz3*dz3 + SOFTENING;\\n      float inv_dist33 = inv_dist3 * inv_dist3 * inv_dist3;\\n\\n      fx0 += dx0 * inv_dist30; fx1 += dx1 * inv_dist31; fx2 += dx2 * inv_dist32; fx3 += dx3 * inv_dist33;\\n      fy0 += dy0 * inv_dist30; fy1 += dy1 * inv_dist31; fy2 += dy2 * inv_dist32; fy3 += dy3 * inv_dist33;\\n      fz0 += dz0 * inv_dist30; fz1 += dz1 * inv_dist31; fz2 += dz2 * inv_dist32; fz3 += dz3 * inv_dist33;\\n    }\\n\\n    p[i].vx += dt*fx0; p[i].vy += dt*fy0; p[i].vz += dt*fz0;\\n    p[i+1].vx += dt*fx1; p[i+1].vy += dt*fy1; p[i+1].vz += dt*fz1;\\n    p[i+2].vx += dt*fx2; p[i+2].vy += dt*fy2; p[i+2].vz += dt*fz2;\\n    p[i+3].vx += dt*fx3; p[i+3].vy += dt*fy3; p[i+3].vz += dt*fz3;\\n  }\\n}\\n\\n/*\\n * Read a binary dataset with initilized bodies.\\n */\\nBody* read_dataset(int *nbodies) {\\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr, \\\"\\\\nError reading nbodie value\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr, \\\"\\\\nError reading input values\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n\\n  return bodies;\\n}\\n\\n/*\\n * Write simulation results into a binary dataset.\\n */\\nvoid write_dataset(const int nbodies, Body *bodies) {\\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\\n  if (b != 1) {\\n    fprintf(stderr, \\\"\\\\nError writing to output\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n}\\n\\nint main(int argc,char **argv) {\\n  int nbodies;\\n\\n  Body *bodies = read_dataset(&nbodies);\\n\\n  /*\\n   * At each simulation iteration, interbody forces are computed,\\n   * and bodies' positions are integrated.\\n   */\\n  for (int iter = 0; iter < N_ITER; iter++) {\\n    body_force(bodies, DT, nbodies);\\n\\n    for (int i = 0; i < nbodies; i++) {\\n      bodies[i].x += bodies[i].vx * DT;\\n      bodies[i].y += bodies[i].vy * DT;\\n      bodies[i].z += bodies[i].vz * DT;\\n    }\\n  }\\n\\n  write_dataset(nbodies, bodies);\\n\\n  free(bodies);\\n\\n  exit(EXIT_SUCCESS);\\n}\\n\"\n    }\n  ],\n  \"notes\": \"This transformation uses SIMD instructions to process four bodies at a time, which can significantly improve performance on modern CPUs.\",\n  \"research\": {\n    \"queries\": [\n      \"How can SIMD instructions be used to optimize the body_force function in the n-body simulation?\",\n      \"What are the benefits of using SIMD instructions in this context?\"\n    ],\n    \"urls\": [\n      \"https://www.intel.com/content/www/us/en/developer/articles/optimizing-performance-with-simd-instructions.html\",\n      \"https://www.geeksforgeeks.org/simd-instructions-in-c/\"\n    ]\n  }\n}"

  "events": [
    {
      "id": 1,
      "kind": "workspace_created",
      "payload": "{\"base_commit\":\"5fc2df68799bdb40f3cf62dd1c53f20b94594d45\",\"protocol_id\":\"674a469bc3b19479c26b78ea1d3ca791b53edbee0c234514b180b655d62cdb21\"}",

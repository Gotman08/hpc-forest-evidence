    {
      "id": 2,
      "kind": "archive_protocol_identity",
      "payload": "{\"effort\":\"max\",\"model\":\"gpt-6.1-sol\",\"mother_enabled\":true,\"operator_algorithm_advice\":false,\"shared_preparation_sha256\":\"829a1e96066218f08724f684f7f006935ba6f39c146141a7e918fc62e2f73963\"}",

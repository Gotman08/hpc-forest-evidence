{
  "src/model-view/primetest.c": "#include <ctype.h>\n#include <inttypes.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\ntypedef struct {\n    uint64_t value;\n    uint64_t scale;\n} Fragment;\n\nstatic char *read_token(FILE *stream)\n{\n    int ch;\n    size_t capacity = 32;\n    size_t length = 0;\n    char *token;\n\n    do {\n        ch = fgetc(stream);\n    } while (ch != EOF && isspace((unsigned char)ch));\n    if (ch == EOF)\n        return NULL;\n\n    token = malloc(capacity);\n    if (token == NULL)\n        return NULL;\n\n    while (ch != EOF && !isspace((unsigned char)ch)) {\n        if (length + 1 >= capacity) {\n            size_t new_capacity = capacity * 2;\n            char *resized = realloc(token, new_capacity);\n            if (resized == NULL) {\n                free(token);\n                return NULL;\n            }\n            token = resized;\n            capacity = new_capacity;\n        }\n        token[length++] = (char)ch;\n        ch = fgetc(stream);\n    }\n    token[length] = '\\0';\n    return token;\n}\n\nstatic int parse_fragment(const char *text, Fragment *fragment)\n{\n    uint64_t value = 0;\n    uint64_t scale = 1;\n    const unsigned char *p = (const unsigned char *)text;\n\n    if (*p == '\\0')\n        return 0;\n    for (; *p != '\\0'; ++p) {\n        unsigned digit;\n        if (*p < '0' || *p > '9')\n            return 0;\n        digit = (unsigned)(*p - '0');\n        if (value > (UINT64_MAX - digit) / 10 || scale > UINT64_MAX / 10)\n            return 0;\n        value = value * 10 + digit;\n        scale *= 10;\n    }\n    fragment->value = value;\n    fragment->scale = scale;\n    return 1;\n}\n\nstatic uint64_t integer_sqrt(uint64_t value)\n{\n    uint64_t low = 0;\n    uint64_t high = UINT32_MAX;\n\n    while (low < high) {\n        uint64_t middle = low + (high - low + 1) / 2;\n        if (middle <= value / middle)\n            low = middle;\n        else\n            high = middle - 1;\n    }\n    return low;\n}\n\nstatic int is_prime_from_sieve(uint64_t value, const uint32_t *primes,\n                               size_t prime_count)\n{\n    size_t i;\n\n    if (value < 2)\n        return 0;\n    for (i = 0; i < prime_count; ++i) {\n        uint64_t factor = primes[i];\n        if (factor > value / factor)\n            break;\n        if (value % factor == 0)\n            return 0;\n    }\n    return 1;\n}\n\nstatic int compare_u64(const void *left, const void *right)\n{\n    uint64_t a = *(const uint64_t *)left;\n    uint64_t b = *(const uint64_t *)right;\n    return (a > b) - (a < b);\n}\n\nint main(void)\n{\n    int num_primes;\n    size_t count;\n    size_t candidate_count;\n    size_t i;\n    size_t j;\n    size_t result_count = 0;\n    uint64_t maximum = 0;\n    Fragment *left;\n    Fragment *right;\n    uint64_t *candidates;\n    uint64_t limit;\n    size_t sieve_size;\n    uint8_t *composite;\n    uint32_t *small_primes;\n    size_t prime_count = 0;\n    size_t prime_index = 0;\n\n    if (scanf(\"%d\", &num_primes) != 1 || num_primes < 1)\n        return 0;\n    count = (size_t)num_primes;\n    left = malloc(count * sizeof(*left));\n    right = malloc(count * sizeof(*right));\n    if (left == NULL || right == NULL) {\n        free(left);\n        free(right);\n        return 1;\n    }\n\n    for (i = 0; i < count; ++i) {\n        char *token = read_token(stdin);\n        int valid = token != NULL && parse_fragment(token, &left[i]);\n        free(token);\n        if (!valid) {\n            free(left);\n            free(right);\n            return 1;\n        }\n    }\n    for (i = 0; i < count; ++i) {\n        char *token = read_token(stdin);\n        int valid = token != NULL && parse_fragment(token, &right[i]);\n        free(token);\n        if (!valid) {\n            free(left);\n            free(right);\n            return 1;\n        }\n    }\n\n    candidate_count = count * count;\n    candidates = malloc(candidate_count * sizeof(*candidates));\n    if (candidates == NULL) {\n        free(left);\n        free(right);\n        return 1;\n    }\n\n    /* Store all concatenations contiguously in row-major pair order. */\n    for (i = 0; i < count; ++i) {\n        for (j = 0; j < count; ++j) {\n            size_t index = i * count + j;\n            uint64_t value;\n            if (left[i].value >\n                (UINT64_MAX - right[j].value) / right[j].scale) {\n                free(left);\n                free(right);\n                free(candidates);\n                return 1;\n            }\n            value = left[i].value * right[j].scale + right[j].value;\n            candidates[index] = value;\n            if (value > maximum)\n                maximum = value;\n        }\n    }\n    free(left);\n    free(right);\n\n    limit = integer_sqrt(maximum);\n    sieve_size = (size_t)(limit + 1);\n    composite = calloc(sieve_size, sizeof(*composite));\n    if (composite == NULL) {\n        free(candidates);\n        return 1;\n    }\n    composite[0] = 1;\n    if (sieve_size > 1)\n        composite[1] = 1;\n    for (uint64_t factor = 2; factor <= limit / factor; ++factor) {\n        uint64_t multiple;\n        if (composite[(size_t)factor])\n            continue;\n        for (multiple = factor * factor; multiple <= limit; multiple += factor)\n            composite[(size_t)multiple] = 1;\n    }\n\n    for (i = 2; i < sieve_size; ++i) {\n        if (!composite[i])\n            ++prime_count;\n    }\n    small_primes = malloc((prime_count ? prime_count : 1) *\n                          sizeof(*small_primes));\n    if (small_primes == NULL) {\n        free(composite);\n        free(candidates);\n        return 1;\n    }\n    for (i = 2; i < sieve_size; ++i) {\n        if (!composite[i])\n            small_primes[prime_index++] = (uint32_t)i;\n    }\n    free(composite);\n\n    /* Compact prime values in place; repeated occurrences remain intact. */\n    for (i = 0; i < candidate_count; ++i) {\n        if (is_prime_from_sieve(candidates[i], small_primes, prime_count))\n            candidates[result_count++] = candidates[i];\n    }\n    free(small_primes);\n\n    if (result_count > 1)\n        qsort(candidates, result_count, sizeof(*candidates), compare_u64);\n    for (i = 0; i < result_count; ++i)\n        printf(\"%\" PRIu64 \"\\n\", candidates[i]);\n\n    free(candidates);\n    return 0;\n}\n",
  "src/sources/primetest.c": "#include <ctype.h>\n#include <inttypes.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\ntypedef struct {\n    uint64_t value;\n    uint64_t scale;\n} Fragment;\n\nstatic char *read_token(FILE *stream)\n{\n    int ch;\n    size_t capacity = 32;\n    size_t length = 0;\n    char *token;\n\n    do {\n        ch = fgetc(stream);\n    } while (ch != EOF && isspace((unsigned char)ch));\n    if (ch == EOF)\n        return NULL;\n\n    token = malloc(capacity);\n    if (token == NULL)\n        return NULL;\n\n    while (ch != EOF && !isspace((unsigned char)ch)) {\n        if (length + 1 >= capacity) {\n            size_t new_capacity = capacity * 2;\n            char *resized = realloc(token, new_capacity);\n            if (resized == NULL) {\n                free(token);\n                return NULL;\n            }\n            token = resized;\n            capacity = new_capacity;\n        }\n        token[length++] = (char)ch;\n        ch = fgetc(stream);\n    }\n    token[length] = '\\0';\n    return token;\n}\n\nstatic int parse_fragment(const char *text, Fragment *fragment)\n{\n    uint64_t value = 0;\n    uint64_t scale = 1;\n    const unsigned char *p = (const unsigned char *)text;\n\n    if (*p == '\\0')\n        return 0;\n    for (; *p != '\\0'; ++p) {\n        unsigned digit;\n        if (*p < '0' || *p > '9')\n            return 0;\n        digit = (unsigned)(*p - '0');\n        if (value > (UINT64_MAX - digit) / 10 || scale > UINT64_MAX / 10)\n            return 0;\n        value = value * 10 + digit;\n        scale *= 10;\n    }\n    fragment->value = value;\n    fragment->scale = scale;\n    return 1;\n}\n\nstatic uint64_t integer_sqrt(uint64_t value)\n{\n    uint64_t low = 0;\n    uint64_t high = UINT32_MAX;\n\n    while (low < high) {\n        uint64_t middle = low + (high - low + 1) / 2;\n        if (middle <= value / middle)\n            low = middle;\n        else\n            high = middle - 1;\n    }\n    return low;\n}\n\nstatic int is_prime_from_sieve(uint64_t value, const uint32_t *primes,\n                               size_t prime_count)\n{\n    size_t i;\n\n    if (value < 2)\n        return 0;\n    for (i = 0; i < prime_count; ++i) {\n        uint64_t factor = primes[i];\n        if (factor > value / factor)\n            break;\n        if (value % factor == 0)\n            return 0;\n    }\n    return 1;\n}\n\nstatic int compare_u64(const void *left, const void *right)\n{\n    uint64_t a = *(const uint64_t *)left;\n    uint64_t b = *(const uint64_t *)right;\n    return (a > b) - (a < b);\n}\n\nint main(void)\n{\n    int num_primes;\n    size_t count;\n    size_t candidate_count;\n    size_t i;\n    size_t j;\n    size_t result_count = 0;\n    uint64_t maximum = 0;\n    Fragment *left;\n    Fragment *right;\n    uint64_t *candidates;\n    uint64_t limit;\n    size_t sieve_size;\n    uint8_t *composite;\n    uint32_t *small_primes;\n    size_t prime_count = 0;\n    size_t prime_index = 0;\n\n    if (scanf(\"%d\", &num_primes) != 1 || num_primes < 1)\n        return 0;\n    count = (size_t)num_primes;\n    left = malloc(count * sizeof(*left));\n    right = malloc(count * sizeof(*right));\n    if (left == NULL || right == NULL) {\n        free(left);\n        free(right);\n        return 1;\n    }\n\n    for (i = 0; i < count; ++i) {\n        char *token = read_token(stdin);\n        int valid = token != NULL && parse_fragment(token, &left[i]);\n        free(token);\n        if (!valid) {\n            free(left);\n            free(right);\n            return 1;\n        }\n    }\n    for (i = 0; i < count; ++i) {\n        char *token = read_token(stdin);\n        int valid = token != NULL && parse_fragment(token, &right[i]);\n        free(token);\n        if (!valid) {\n            free(left);\n            free(right);\n            return 1;\n        }\n    }\n\n    candidate_count = count * count;\n    candidates = malloc(candidate_count * sizeof(*candidates));\n    if (candidates == NULL) {\n        free(left);\n        free(right);\n        return 1;\n    }\n\n    /* Store all concatenations contiguously in row-major pair order. */\n    for (i = 0; i < count; ++i) {\n        for (j = 0; j < count; ++j) {\n            size_t index = i * count + j;\n            uint64_t value;\n            if (left[i].value >\n                (UINT64_MAX - right[j].value) / right[j].scale) {\n                free(left);\n                free(right);\n                free(candidates);\n                return 1;\n            }\n            value = left[i].value * right[j].scale + right[j].value;\n            candidates[index] = value;\n            if (value > maximum)\n                maximum = value;\n        }\n    }\n    free(left);\n    free(right);\n\n    limit = integer_sqrt(maximum);\n    sieve_size = (size_t)(limit + 1);\n    composite = calloc(sieve_size, sizeof(*composite));\n    if (composite == NULL) {\n        free(candidates);\n        return 1;\n    }\n    composite[0] = 1;\n    if (sieve_size > 1)\n        composite[1] = 1;\n    for (uint64_t factor = 2; factor <= limit / factor; ++factor) {\n        uint64_t multiple;\n        if (composite[(size_t)factor])\n            continue;\n        for (multiple = factor * factor; multiple <= limit; multiple += factor)\n            composite[(size_t)multiple] = 1;\n    }\n\n    for (i = 2; i < sieve_size; ++i) {\n        if (!composite[i])\n            ++prime_count;\n    }\n    small_primes = malloc((prime_count ? prime_count : 1) *\n                          sizeof(*small_primes));\n    if (small_primes == NULL) {\n        free(composite);\n        free(candidates);\n        return 1;\n    }\n    for (i = 2; i < sieve_size; ++i) {\n        if (!composite[i])\n            small_primes[prime_index++] = (uint32_t)i;\n    }\n    free(composite);\n\n    /* Compact prime values in place; repeated occurrences remain intact. */\n    for (i = 0; i < candidate_count; ++i) {\n        if (is_prime_from_sieve(candidates[i], small_primes, prime_count))\n            candidates[result_count++] = candidates[i];\n    }\n    free(small_primes);\n\n    if (result_count > 1)\n        qsort(candidates, result_count, sizeof(*candidates), compare_u64);\n    for (i = 0; i < result_count; ++i)\n        printf(\"%\" PRIu64 \"\\n\", candidates[i]);\n\n    free(candidates);\n    return 0;\n}\n"
}

{
  "src/nbody.c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n#define TARGET_TILE 8\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nstatic float *allocate_positions(int n) {\n  if (n <= 0 || (size_t)n > (size_t)-1 / (3 * sizeof(float))) {\n    return NULL;\n  }\n  return (float *)malloc((size_t)n * 3 * sizeof(float));\n}\n\n/* Allocation-free fallback, collectively called by the current team. */\nstatic void body_force_direct_workshare(Body *p, float dt, int n) {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Refresh the shared position snapshot, then stream sources across\n * independent target lanes. Each target retains ascending source order.\n * All threads in the current team must participate.\n */\nstatic void body_force_workshare(Body *p, float dt, int n,\n                                 float *positions) {\n  if (positions == NULL) {\n    body_force_direct_workshare(p, dt, n);\n    return;\n  }\n\n  float * restrict x = positions;\n  float * restrict y = positions + (size_t)n;\n  float * restrict z = positions + 2 * (size_t)n;\n\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n  for (int i = 0; i < n; ++i) {\n    x[i] = p[i].x;\n    y[i] = p[i].y;\n    z[i] = p[i].z;\n  }\n\n  const int blocks = n / TARGET_TILE;\n\n#ifdef _OPENMP\n#pragma omp for schedule(static) nowait\n#endif\n  for (int block = 0; block < blocks; ++block) {\n    const int first = block * TARGET_TILE;\n    float tx[TARGET_TILE], ty[TARGET_TILE], tz[TARGET_TILE];\n    float fx[TARGET_TILE] = {0.0f};\n    float fy[TARGET_TILE] = {0.0f};\n    float fz[TARGET_TILE] = {0.0f};\n\n    for (int lane = 0; lane < TARGET_TILE; ++lane) {\n      tx[lane] = x[first + lane];\n      ty[lane] = y[first + lane];\n      tz[lane] = z[first + lane];\n    }\n\n    for (int j = 0; j < n; ++j) {\n      const float sx = x[j];\n      const float sy = y[j];\n      const float sz = z[j];\n\n#if defined(_OPENMP) && _OPENMP >= 201307\n#pragma omp simd simdlen(4)\n#endif\n      for (int lane = 0; lane < TARGET_TILE; ++lane) {\n        float dx = sx - tx[lane];\n        float dy = sy - ty[lane];\n        float dz = sz - tz[lane];\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx[lane] += dx * inv_dist3;\n        fy[lane] += dy * inv_dist3;\n        fz[lane] += dz * inv_dist3;\n      }\n    }\n\n    for (int lane = 0; lane < TARGET_TILE; ++lane) {\n      p[first + lane].vx += dt*fx[lane];\n      p[first + lane].vy += dt*fy[lane];\n      p[first + lane].vz += dt*fz[lane];\n    }\n  }\n\n  /* This loop's barrier also waits for all complete target tiles. */\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n  for (int i = blocks * TARGET_TILE; i < n; ++i) {\n    const float tx = x[i];\n    const float ty = y[i];\n    const float tz = z[i];\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; ++j) {\n      float dx = x[j] - tx;\n      float dy = y[j] - ty;\n      float dz = z[j] - tz;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/* Preserve the standalone force-update entry point. */\nvoid body_force(Body *p, float dt, int n) {\n  if (n <= 0) {\n    return;\n  }\n\n  float *positions = allocate_positions(n);\n#ifdef _OPENMP\n#pragma omp parallel\n#endif\n  {\n    body_force_workshare(p, dt, n, positions);\n  }\n  free(positions);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n  float *positions = allocate_positions(nbodies);\n\n  /*\n   * Reuse one team across all iterations. Barriers separate snapshot\n   * creation, force evaluation, and position integration.\n   */\n#ifdef _OPENMP\n#pragma omp parallel\n#endif\n  {\n    for (int iter = 0; iter < N_ITER; iter++) {\n      body_force_workshare(bodies, DT, nbodies, positions);\n\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n      for (int i = 0; i < nbodies; i++) {\n        bodies[i].x += bodies[i].vx * DT;\n        bodies[i].y += bodies[i].vy * DT;\n        bodies[i].z += bodies[i].vz * DT;\n      }\n    }\n  }\n\n  free(positions);\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n"
}

{
  "src/bucketsort.c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <limits.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\n#define RADIX 256\n\nstatic void input_error(const char *message) {\n   fprintf(stderr, \"ERROR %s\\n\", message);\n   exit(EXIT_FAILURE);\n}\n\nstatic inline unsigned char sort_byte(const char *strings, long int index,\n                                      int length, int position) {\n   return (unsigned char)strings[(size_t)index * (size_t)length +\n                                 (size_t)position];\n}\n\nstatic long int *serial_radix_sort(const char *strings, int length,\n                                   long int size, long int *first,\n                                   long int *second) {\n   long int *source = first;\n   long int *destination = second;\n\n   for (int position = length - 2; position >= 0; --position) {\n      long int counts[RADIX] = {0};\n\n      for (long int i = 0; i < size; ++i)\n         ++counts[sort_byte(strings, source[i], length, position)];\n\n      long int next = 0;\n      for (int value = 0; value < RADIX; ++value) {\n         long int count = counts[value];\n         counts[value] = next;\n         next += count;\n      }\n\n      for (long int i = 0; i < size; ++i) {\n         unsigned char value = sort_byte(strings, source[i], length, position);\n         destination[counts[value]++] = source[i];\n      }\n\n      long int *temporary = source;\n      source = destination;\n      destination = temporary;\n   }\n\n   return source;\n}\n\n#ifdef _OPENMP\nstatic long int *parallel_radix_sort(const char *strings, int length,\n                                     long int size, long int *first,\n                                     long int *second, int thread_capacity) {\n   size_t workspace = (size_t)thread_capacity * RADIX;\n   if (workspace > (size_t)-1 / sizeof(long int))\n      return serial_radix_sort(strings, length, size, first, second);\n\n   long int *counts = calloc(workspace, sizeof(*counts));\n   long int *starts = malloc(workspace * sizeof(*starts));\n   if (counts == NULL || starts == NULL) {\n      free(counts);\n      free(starts);\n      return serial_radix_sort(strings, length, size, first, second);\n   }\n\n   long int *source = first;\n   long int *destination = second;\n   int active_threads = 1;\n\n#pragma omp parallel default(none) shared(strings, length, size, source, destination, counts, starts, active_threads)\n   {\n#pragma omp single\n      active_threads = omp_get_num_threads();\n\n      for (int position = length - 2; position >= 0; --position) {\n#pragma omp for schedule(static)\n         for (int thread = 0; thread < active_threads; ++thread) {\n            long int begin = size * (long int)thread / active_threads;\n            long int end = size * (long int)(thread + 1) / active_threads;\n            long int *local_counts = counts + (size_t)thread * RADIX;\n\n            memset(local_counts, 0, RADIX * sizeof(*local_counts));\n            for (long int i = begin; i < end; ++i)\n               ++local_counts[sort_byte(strings, source[i], length, position)];\n         }\n\n#pragma omp single\n         {\n            long int next = 0;\n            for (int value = 0; value < RADIX; ++value) {\n               for (int thread = 0; thread < active_threads; ++thread) {\n                  size_t offset = (size_t)thread * RADIX + value;\n                  starts[offset] = next;\n                  next += counts[offset];\n               }\n            }\n         }\n\n#pragma omp for schedule(static)\n         for (int thread = 0; thread < active_threads; ++thread) {\n            long int begin = size * (long int)thread / active_threads;\n            long int end = size * (long int)(thread + 1) / active_threads;\n            long int *local_starts = starts + (size_t)thread * RADIX;\n\n            for (long int i = begin; i < end; ++i) {\n               unsigned char value = sort_byte(strings, source[i], length, position);\n               destination[local_starts[value]++] = source[i];\n            }\n         }\n\n#pragma omp single\n         {\n            long int *temporary = source;\n            source = destination;\n            destination = temporary;\n         }\n      }\n   }\n\n   free(counts);\n   free(starts);\n   return source;\n}\n#endif\n\nstatic long int *bucket_sort(const char *strings, int length, long int size) {\n   if (size <= 0)\n      return NULL;\n\n   if ((size_t)size > (size_t)-1 / sizeof(long int))\n      input_error(\"memory\");\n\n   long int *first = malloc((size_t)size * sizeof(*first));\n   long int *second = malloc((size_t)size * sizeof(*second));\n   if (first == NULL || second == NULL) {\n      free(first);\n      free(second);\n      input_error(\"memory\");\n   }\n\n#ifdef _OPENMP\n#pragma omp parallel for schedule(static)\n#endif\n   for (long int i = 0; i < size; ++i)\n      first[i] = i;\n\n   long int *result;\n#ifdef _OPENMP\n   int thread_capacity = omp_get_max_threads();\n   if (thread_capacity > 1 && size >= 4096)\n      result = parallel_radix_sort(strings, length, size, first, second,\n                                   thread_capacity);\n   else\n      result = serial_radix_sort(strings, length, size, first, second);\n#else\n   result = serial_radix_sort(strings, length, size, first, second);\n#endif\n\n   free(result == first ? second : first);\n   return result;\n}\n\nstatic void load(char **v_string, long int *count, int *record_length) {\n   int declared_length;\n   int ignored_offset;\n   int ignored_bucket_count;\n   long int n;\n\n   if (fscanf(stdin, \"%d\", &declared_length) != 1)\n      input_error(\"len\");\n   if (fscanf(stdin, \"%ld\", &n) != 1)\n      input_error(\"n\");\n   if (fscanf(stdin, \"%d\", &ignored_offset) != 1)\n      input_error(\"offset\");\n   if (fscanf(stdin, \"%d\", &ignored_bucket_count) != 1)\n      input_error(\"nbucket\");\n\n   if (declared_length < 0 || declared_length == INT_MAX || n < 0)\n      input_error(\"parameters\");\n\n   int length = declared_length + 1;\n   if (n != 0 && (size_t)n > (size_t)-1 / (size_t)length)\n      input_error(\"memory\");\n\n   char *strings = NULL;\n   if (n != 0) {\n      strings = calloc((size_t)n, (size_t)length);\n      if (strings == NULL)\n         input_error(\"memory\");\n   }\n\n   for (long int i = 0; i < n; ++i) {\n      if (fscanf(stdin, \"%s\", strings + (size_t)i * (size_t)length) != 1)\n         input_error(\"string\");\n   }\n\n   *v_string = strings;\n   *count = n;\n   *record_length = length;\n}\n\nstatic void save(const char *strings, const long int *index,\n                 long int count, int length) {\n   for (long int i = 0; i < count; ++i) {\n      fputs(strings + (size_t)index[i] * (size_t)length, stdout);\n      putchar('\\n');\n   }\n}\n\nint main(void) {\n   char *strings = NULL;\n   long int count = 0;\n   int length = 0;\n\n   load(&strings, &count, &length);\n   long int *index = bucket_sort(strings, length, count);\n   save(strings, index, count, length);\n\n   free(strings);\n   free(index);\n   return EXIT_SUCCESS;\n}\n"
}

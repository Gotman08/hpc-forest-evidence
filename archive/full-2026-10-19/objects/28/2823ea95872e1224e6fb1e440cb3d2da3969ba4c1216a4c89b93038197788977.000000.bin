        "content": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nint A[1000][1000];\n\ntypedef long long ll;\n\nll solve(int m, int n, int k) {\n  const int d = min(m, n);\n  const int length = max(m, n);\n  vector<int> matrix(static_cast<size_t>(d) * length);\n\n  if (m <= n) {\n    for (int i = 0; i < m; ++i)\n      copy_n(A[i], n, matrix.data() + static_cast<size_t>(i) * length);\n  } else {\n    for (int i = 0; i < m; ++i)\n      for (int j = 0; j < n; ++j)\n        matrix[static_cast<size_t>(j) * length + i] = A[i][j];\n  }\n\n  vector<int> band(length);\n  unordered_map<ll, ll> h;\n  ll ans = 0;\n  for (int first = 0; first < d; ++first) {\n    fill(band.begin(), band.end(), 0);\n    for (int last = first; last < d; ++last) {\n      const int *row = matrix.data() + static_cast<size_t>(last) * length;\n      // Separate contiguous accumulation from the dependent counting scan.\n      for (int i = 0; i < length; ++i)\n        band[i] += row[i];\n\n      h.clear();\n      h[0] = 1;\n      ll s = 0;\n      for (int i = 0; i < length; ++i) {\n        s += band[i];\n        ans += h.find(s - k) != h.end() ? h[s - k] : 0;\n        h[s]++;\n      }\n    }\n  }\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n",
        "path": "src/main.cpp"
      }

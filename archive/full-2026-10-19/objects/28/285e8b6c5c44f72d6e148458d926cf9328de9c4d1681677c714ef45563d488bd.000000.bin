{
  "src/graph.c": "#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n#include<stdint.h>\n\n/* Maximum size (in char) for neighbors and compute lists */\n#define MAX 100\n\ntypedef struct {\n  int id;\n  float value;\n  char neighbors[MAX];\n} Node;\n\n/* Zero marks an empty slot; all integer IDs remain representable. */\ntypedef struct {\n  int id;\n  int index_plus_one;\n} IdSlot;\n\ntypedef struct {\n  const Node *nodes;\n  int size;\n  IdSlot *slots;\n  size_t mask;\n} IdIndex;\n\n/* Reads input, allocates memory, writes graph size and node list. Returns the graph. */\nNode* read_input(char* fname, int *n, char* list) {\n  \n  Node* data = NULL;\n  FILE *fl = NULL;\n  \n  if (fname == NULL) \n    fl = stdin;\n  else \n    fl = fopen(fname, \"r\");\n  \n  if (fl == NULL) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n  \n  // header \n  fscanf(fl, \"%d %[^\\n]\", n, list);\n  \n  if (*n > 0) {\n    data = (Node*) malloc ((*n)*sizeof(Node));\n    if(data == NULL){\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }    \n  }\n  \n  for(int i = 0; i < *n; i++)\n    fscanf(fl, \"%d %f %[^\\n]\", &data[i].id, &data[i].value, data[i].neighbors);\n  \n  fclose(fl);\n\n  return data;\n  \n}\n\nstatic size_t hash_id(int id) {\n  uint32_t x = (uint32_t)id;\n  x ^= x >> 16;\n  x *= UINT32_C(0x7feb352d);\n  x ^= x >> 15;\n  x *= UINT32_C(0x846ca68b);\n  x ^= x >> 16;\n  return (size_t)x;\n}\n\n/* Build once in input order, retaining the first record for each ID. */\nstatic void id_index_init(IdIndex *index, const Node *nodes, int size) {\n  index->nodes = nodes;\n  index->size = size;\n  index->slots = NULL;\n  index->mask = 0;\n\n  if (size <= 0)\n    return;\n\n  size_t capacity = 1;\n  while (capacity / 2 < (size_t)size) {\n    if (capacity > SIZE_MAX / 2)\n      return;\n    capacity *= 2;\n  }\n  if (capacity > SIZE_MAX / sizeof(IdSlot))\n    return;\n\n  IdSlot *slots = (IdSlot*)calloc(capacity, sizeof(IdSlot));\n  if (slots == NULL)\n    return;\n\n  size_t mask = capacity - 1;\n  for (int i = 0; i < size; i++) {\n    int id = nodes[i].id;\n    size_t pos = hash_id(id) & mask;\n    while (slots[pos].index_plus_one != 0 && slots[pos].id != id)\n      pos = (pos + 1) & mask;\n\n    if (slots[pos].index_plus_one == 0) {\n      slots[pos].id = id;\n      slots[pos].index_plus_one = i + 1;\n    }\n  }\n\n  index->slots = slots;\n  index->mask = mask;\n}\n\nstatic void id_index_destroy(IdIndex *index) {\n  free(index->slots);\n  index->slots = NULL;\n  index->nodes = NULL;\n  index->size = 0;\n  index->mask = 0;\n}\n\n/* Read-only lookup: return the first original index, or -1 if absent. */\nstatic int find_by_id(const IdIndex *index, int id) {\n  if (index->slots == NULL) {\n    for (int i = 0; i < index->size; i++)\n      if (index->nodes[i].id == id)\n        return i;\n    return -1;\n  }\n\n  size_t pos = hash_id(id) & index->mask;\n  for (;;) {\n    const IdSlot *slot = &index->slots[pos];\n    if (slot->index_plus_one == 0)\n      return -1;\n    if (slot->id == id)\n      return slot->index_plus_one - 1;\n    pos = (pos + 1) & index->mask;\n  }\n}\n\n/* Computes the sum for the node with the given id */\nfloat get_costly(const IdIndex *index, int id) {\n\n  const Node *g = index->nodes;\n  char *t;\n  int idmax = -1;\n  float max = 0;\n  char *auxptr;\n  \n  int nd = find_by_id(index, id);\n  if(nd < 0)\n    return max;\n\n  char aux[MAX];\n  strcpy(aux, g[nd].neighbors);\n  t = strtok_r(aux, \" \", &auxptr);\n\n  do {\n    int d = find_by_id(index, atoi(t));\n    if (d >= 0 && max < g[d].value) {\n      max = g[d].value;\n      idmax = atoi(t);\n    }    \n  } while ((t = strtok_r(NULL, \" \", &auxptr)));\n\n  float r = g[nd].value;\n\n  if(idmax != -1)\n    r += get_costly(index, idmax);\n  \n  return (r);\n\n}\n\n/* Main program - calls read input, computes sum for each node in the list, prints output */\nint main() {\n  char *fileN = NULL;\n  char computelist[MAX];\n  int n = -1;\n  Node* input = NULL;\n  IdIndex index;\n\n  input = read_input(fileN, &n, computelist);\n  id_index_init(&index, input, n);\n  \n  // process\n  for(char *c = strtok(computelist, \" \"); c != NULL; c = strtok(NULL, \" \"))\n    printf(\"%s: %f\\n\", c, get_costly(&index, atoi(c)));\n  \n  id_index_destroy(&index);\n  free(input);\n\n  return 0;\n}\n"
}

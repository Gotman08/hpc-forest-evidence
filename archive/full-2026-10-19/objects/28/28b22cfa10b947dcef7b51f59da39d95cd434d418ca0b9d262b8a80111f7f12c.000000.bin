{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <stdio.h>\\n#include <stdlib.h>\\n#include <assert.h>\\n#include <string.h>\\n\\ntypedef struct {\\n\\tlong int *data;\\n\\tlong int total;\\n\\tlong int next;\\n} bucket;\\n\\nstatic char *comparison_strings;\\nstatic int comparison_length;\\n\\nstatic int compare_indices(const void *left, const void *right) {\\n\\tlong int left_index = *(const long int *)left;\\n\\tlong int right_index = *(const long int *)right;\\n\\treturn strcmp(comparison_strings + left_index * comparison_length,\\n\\t              comparison_strings + right_index * comparison_length);\\n}\\n\\nstatic void sort_bucket(bucket *current) {\\n\\tif (current->total > 1) {\\n\\t\\tqsort(current->data, (size_t)current->total,\\n\\t\\t      sizeof(*current->data), compare_indices);\\n\\t}\\n}\\n\\nlong int* bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\\n\\n\\tlong int i;\\n\\tlong int next;\\n\\tbucket *buckets = NULL;\\n\\tbucket *b = NULL;\\n\\tlong int *returns = NULL;\\n\\n\\treturns = (long int *)malloc(sizeof(*returns) * (size_t)size);\\n\\tbuckets = (bucket *)malloc(sizeof(*buckets) * (size_t)nbuckets);\\n\\tif (buckets == NULL || (size > 0 && returns == NULL)) {\\n\\t\\tfree(returns);\\n\\t\\tfree(buckets);\\n\\t\\texit(EXIT_FAILURE);\\n\\t}\\n\\n\\tfor (i = 0; i < nbuckets; i++) {\\n\\t\\tbuckets[i].data = NULL;\\n\\t\\tbuckets[i].total = 0;\\n\\t\\tbuckets[i].next = 0;\\n\\t}\\n\\n\\t/* Count each bucket so its range in returns is sized exactly. */\\n\\tfor (i = 0; i < size; i++) {\\n\\t\\tb = &buckets[*(a + i * length) - offset];\\n\\t\\tb->total++;\\n\\t}\\n\\n\\tnext = 0;\\n\\tfor (i = 0; i < nbuckets; i++) {\\n\\t\\tbuckets[i].data = returns == NULL ? NULL : returns + next;\\n\\t\\tbuckets[i].next = 0;\\n\\t\\tnext += buckets[i].total;\\n\\t}\\n\\n\\t/* Scatter indices into the exact ranges, preserving bucket order. */\\n\\tfor (i = 0; i < size; i++) {\\n\\t\\tb = &buckets[*(a + i * length) - offset];\\n\\t\\tb->data[b->next++] = i;\\n\\t}\\n\\n\\tcomparison_strings = a;\\n\\tcomparison_length = length;\\n\\tfor (i = 0; i < nbuckets; i++)\\n\\t\\tsort_bucket(&buckets[i]);\\n\\n\\tfree(buckets);\\n\\treturn returns;\\n}\\n\\nvoid load(char **vString, long int *N, int *l, int *os, int *nb){\\n   char *strings = NULL;\\n   int      len,\\n            offset,\\n            nbucket;\\n   long int n;\\n\\n   if (!fscanf(stdin, \\\"%d\\\", &len)) {\\n      printf (\\\"ERROR len\\\\n\\\");\\n      exit (1);\\n   }\\n\\n   if (!fscanf(stdin, \\\"%ld\\\", &n)) {\\n      printf (\\\"ERROR n\\\\n\\\");\\n      exit (1);\\n   }\\n\\n   if (!fscanf(stdin, \\\"%d\\\", &offset)) {\\n      printf (\\\"ERROR offset\\\\n\\\");\\n      exit (1);\\n   }\\n\\n   if (!fscanf(stdin, \\\"%d\\\", &nbucket)) {\\n      printf (\\\"ERROR nbucket\\\\n\\\");\\n      exit (1);\\n   }\\n\\n   nbucket = nbucket + 1;\\n   len = len + 1;\\n\\n   strings = (char*) malloc(n * len);\\n\\n   for (int i = 0; i < n; i++){\\n      if (!fscanf(stdin, \\\"%s\\\", strings + (i * len))) {\\n      printf (\\\"ERROR %d\\\\n\\\",i);\\n      exit (1);\\n      }\\n   }\\n\\n   *vString = strings;\\n   *N = n;\\n   *l = len;\\n   *os = offset;\\n   *nb = nbucket;\\n}\\n\\nvoid print(char *strings, long int *index, long int n, int len){\\n\\n   for (int i = 0; i < n; i++){\\n      printf(\\\"%d -> %s\\\\n\\\", i, strings + (index[i] * len));\\n   }\\n}\\n\\nvoid save(char *strings, long int *index, long int n, int len){\\n   for (int i = 0; i < n; i++){\\n      printf(\\\"%s\\\\n\\\", strings + (index[i] * len));\\n   }\\n}\\n\\nint main(int ac, char **av) {\\n\\n   char     *strings = NULL;\\n   long int N        = 0;\\n   long int *index   = NULL;\\n   int      len      = 0,\\n            save2File = 0,\\n            offset,\\n            nbuckets;\\n\\n   load(&strings, &N, &len, &offset, &nbuckets);\\n\\n   index = bucket_sort(strings, len, N, offset, nbuckets);\\n\\n   save(strings, index, N, len);\\n\\n   if (strings != NULL)\\n      free(strings);\\n\\n   if (index != NULL)\\n      free(index);\\n\\n   return EXIT_SUCCESS;\\n}\\n\",\"path\":\"src/bucketsort.c\"}],\"hypothesis\":\"Replacing insertion sort's unbounded shifting loop with qsort removes its quadratic loop-carried dependency for large or skewed buckets. Exact bucket counts and prefix offsets keep bucket storage correct for uneven distributions.\",\"notes\":\"The qsort comparator uses file-local context; sorting remains sequential. No benchmark or compiler-specific SIMD assumptions are included.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Replace per-bucket insertion sort with qsort over string indices using strcmp, preserving lexicographic ordering and duplicate behavior.\",\"Count bucket memberships before scattering, then assign exact contiguous ranges by prefix offsets to prevent uneven buckets from overlapping fixed-size slices.\"]}"}}

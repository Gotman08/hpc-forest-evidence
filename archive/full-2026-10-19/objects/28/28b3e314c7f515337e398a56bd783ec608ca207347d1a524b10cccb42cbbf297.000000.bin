{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <algorithm>\\n#include <iostream>\\n#include <utility>\\n#include <vector>\\n\\nusing namespace std;\\n\\nstatic const int MOD = 1000000007;\\n\\nstatic int mod_pow(int base, int exponent) {\\n    long long result = 1;\\n    long long value = base;\\n    while (exponent > 0) {\\n        if (exponent & 1) result = result * value % MOD;\\n        value = value * value % MOD;\\n        exponent >>= 1;\\n    }\\n    return static_cast<int>(result);\\n}\\n\\nint main() {\\n    ios::sync_with_stdio(false);\\n    cin.tie(nullptr);\\n\\n    int n, m;\\n    if (!(cin >> n >> m)) return 0;\\n\\n    vector<pair<int, int>> obstacles;\\n    obstacles.reserve(m);\\n    for (int i = 0; i < m; ++i) {\\n        int y, x;\\n        cin >> y >> x;\\n        obstacles.emplace_back(y, x);\\n    }\\n\\n    // Keep the original row-wise DP for small grids, where its simple scans\\n    // avoid the sorting and modular-combinatorics setup costs.\\n    if (n <= 2048) {\\n        vector<vector<bool>> blocked(n, vector<bool>(n, false));\\n        for (const auto& cell : obstacles)\\n            blocked[cell.first][cell.second] = true;\\n\\n        vector<int> previous(n, 0), current(n, 0);\\n        if (!blocked[0][0]) previous[0] = 1;\\n        for (int x = 1; x < n; ++x)\\n            if (!blocked[0][x]) previous[x] = previous[x - 1];\\n\\n        for (int y = 1; y < n; ++y) {\\n            current[0] = blocked[y][0] ? 0 : previous[0];\\n            for (int x = 1; x < n; ++x) {\\n                current[x] = blocked[y][x] ? 0 : (previous[x] + current[x - 1]) % MOD;\\n            }\\n            previous.swap(current);\\n        }\\n        cout << previous[n - 1] << '\\\\n';\\n        return 0;\\n    }\\n\\n    sort(obstacles.begin(), obstacles.end());\\n    obstacles.erase(unique(obstacles.begin(), obstacles.end()), obstacles.end());\\n\\n    const pair<int, int> start{0, 0};\\n    const pair<int, int> finish{n - 1, n - 1};\\n    if (binary_search(obstacles.begin(), obstacles.end(), start) ||\\n        binary_search(obstacles.begin(), obstacles.end(), finish)) {\\n        cout << 0 << '\\\\n';\\n        return 0;\\n    }\\n\\n    const int max_steps = 2 * (n - 1);\\n    vector<int> factorial(max_steps + 1), inverse_factorial(max_steps + 1);\\n    factorial[0] = 1;\\n    for (int i = 1; i <= max_steps; ++i)\\n        factorial[i] = static_cast<long long>(factorial[i - 1]) * i % MOD;\\n    inverse_factorial[max_steps] = mod_pow(factorial[max_steps], MOD - 2);\\n    for (int i = max_steps; i > 0; --i)\\n        inverse_factorial[i - 1] = static_cast<long long>(inverse_factorial[i]) * i % MOD;\\n\\n    auto choose = [&](int total, int part) -> int {\\n        if (part < 0 || part > total) return 0;\\n        return static_cast<long long>(factorial[total]) * inverse_factorial[part] % MOD *\\n               inverse_factorial[total - part] % MOD;\\n    };\\n\\n    vector<pair<int, int>> points = obstacles;\\n    points.push_back(finish);\\n    sort(points.begin(), points.end());\\n    points.erase(unique(points.begin(), points.end()), points.end());\\n\\n    vector<int> ways(points.size());\\n    for (size_t i = 0; i < points.size(); ++i) {\\n        const int y = points[i].first;\\n        const int x = points[i].second;\\n        long long count = choose(x + y, x);\\n        for (size_t j = 0; j < i; ++j) {\\n            const int py = points[j].first;\\n            const int px = points[j].second;\\n            if (py <= y && px <= x) {\\n                const int paths_between = choose((y - py) + (x - px), y - py);\\n                count -= static_cast<long long>(ways[j]) * paths_between % MOD;\\n                if (count < 0) count += MOD;\\n            }\\n        }\\n        ways[i] = static_cast<int>(count);\\n        if (points[i] == finish) {\\n            cout << ways[i] << '\\\\n';\\n            return 0;\\n        }\\n    }\\n    return 0;\\n}\\n\",\"path\":\"src/solution.cpp\"}],\"hypothesis\":\"The current hybrid is the only admissible measured candidate that improves large-grid scalability, while all sparse-only archived variants are slower than baseline. This integration candidate retains the full measured hybrid unchanged rather than combining redundant transformations, preserving its exact small-grid DP and sparse inclusion-exclusion path for large grids.\",\"notes\":\"Retained selected parent implementation unchanged; no additive combination is justified by the available full-program measurements. The small-grid blocked-endpoint and duplicate handling are covered by the existing approach, and sparse processing handles large valid dimensions.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[\"d962e8580d1a46ea\"],\"transformations\":[\"Retain the measured hybrid: dense blocked-grid rolling-row DP for n <= 2048; sorted, deduplicated sparse coordinates and inclusion-exclusion for larger n.\",\"Keep factorial and inverse-factorial precomputation for constant-time modular binomial counts in the sparse branch.\",\"Do not combine the overlapping sparse-only archived variants because their measured runtimes are slower and they provide no distinct validated improvement.\"]}"}}

{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n#define COEFFICIENT_PANEL 32\n#define TARGET_TILE 64\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/* Direct fallback requires no workspace. */\nstatic void body_force_direct(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Retain only a panel of the symmetric inverse-cube matrix. Each target\n * consumes contributions in increasing source order, including itself.\n */\nvoid body_force(Body *p, float dt, int n) {\n  if (n <= 0) {\n    return;\n  }\n\n  const size_t width = (size_t)n;\n  const size_t planes = 6 + COEFFICIENT_PANEL;\n  if (width > ((size_t)-1) / (planes * sizeof(float))) {\n    body_force_direct(p, dt, n);\n    return;\n  }\n\n  float *workspace = (float *)malloc(width * planes * sizeof(float));\n  if (workspace == NULL) {\n    body_force_direct(p, dt, n);\n    return;\n  }\n\n  float *x = workspace;\n  float *y = x + width;\n  float *z = y + width;\n  float *fx = z + width;\n  float *fy = fx + width;\n  float *fz = fy + width;\n  float *coefficients = fz + width;\n  int finite_positions = 1;\n\n  for (int i = 0; i < n; ++i) {\n    x[i] = p[i].x;\n    y[i] = p[i].y;\n    z[i] = p[i].z;\n    fx[i] = 0.0f;\n    fy[i] = 0.0f;\n    fz[i] = 0.0f;\n    if (!isfinite(x[i]) || !isfinite(y[i]) || !isfinite(z[i])) {\n      finite_positions = 0;\n    }\n  }\n\n  if (!finite_positions) {\n    free(workspace);\n    body_force_direct(p, dt, n);\n    return;\n  }\n\n  #pragma omp parallel\n  {\n    for (int base = 0; base < n; ) {\n      int count = n - base;\n      if (count > COEFFICIENT_PANEL) {\n        count = COEFFICIENT_PANEL;\n      }\n      const int end = base + count;\n\n      /* Only the upper triangle, including the diagonal, is computed. */\n      #pragma omp for schedule(static)\n      for (int k = 0; k < count; ++k) {\n        const int i = base + k;\n        const float xi = x[i];\n        const float yi = y[i];\n        const float zi = z[i];\n        float *row = coefficients + (size_t)k * width;\n\n        #pragma omp simd\n        for (int j = i; j < n; ++j) {\n          float dx = x[j] - xi;\n          float dy = y[j] - yi;\n          float dz = z[j] - zi;\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          float inv_dist = 1 / sqrt(sqrd_dist);\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\n          row[j] = inv_dist3;\n        }\n      }\n\n      /* Earlier panels have already supplied sources below base. */\n      #pragma omp for schedule(static) nowait\n      for (int k = 0; k < count; ++k) {\n        const int i = base + k;\n        const float xi = x[i];\n        const float yi = y[i];\n        const float zi = z[i];\n        float ax = fx[i];\n        float ay = fy[i];\n        float az = fz[i];\n\n        for (int j = base; j < i; ++j) {\n          float dx = x[j] - xi;\n          float dy = y[j] - yi;\n          float dz = z[j] - zi;\n          float inv_dist3 = coefficients[(size_t)(j - base) * width + (size_t)i];\n          ax += dx * inv_dist3;\n          ay += dy * inv_dist3;\n          az += dz * inv_dist3;\n        }\n\n        const float *row = coefficients + (size_t)k * width;\n        for (int j = i; j < n; ++j) {\n          float dx = x[j] - xi;\n          float dy = y[j] - yi;\n          float dz = z[j] - zi;\n          float inv_dist3 = row[j];\n          ax += dx * inv_dist3;\n          ay += dy * inv_dist3;\n          az += dz * inv_dist3;\n        }\n\n        p[i].vx += dt*ax;\n        p[i].vy += dt*ay;\n        p[i].vz += dt*az;\n      }\n\n      /* Reuse the same coefficients for the opposite directions. */\n      const int remaining = n - end;\n      const int tiles = remaining / TARGET_TILE + (remaining % TARGET_TILE != 0);\n      #pragma omp for schedule(static)\n      for (int tile = 0; tile < tiles; ++tile) {\n        const int first = end + tile * TARGET_TILE;\n        int length = n - first;\n        if (length > TARGET_TILE) {\n          length = TARGET_TILE;\n        }\n\n        float tx[TARGET_TILE], ty[TARGET_TILE], tz[TARGET_TILE];\n        float ax[TARGET_TILE], ay[TARGET_TILE], az[TARGET_TILE];\n        for (int u = 0; u < length; ++u) {\n          const int i = first + u;\n          tx[u] = x[i];\n          ty[u] = y[i];\n          tz[u] = z[i];\n          ax[u] = fx[i];\n          ay[u] = fy[i];\n          az[u] = fz[i];\n        }\n\n        for (int k = 0; k < count; ++k) {\n          const int j = base + k;\n          const float xj = x[j];\n          const float yj = y[j];\n          const float zj = z[j];\n          const float *row = coefficients + (size_t)k * width + (size_t)first;\n\n          #pragma omp simd\n          for (int u = 0; u < length; ++u) {\n            float dx = xj - tx[u];\n            float dy = yj - ty[u];\n            float dz = zj - tz[u];\n            float inv_dist3 = row[u];\n            ax[u] += dx * inv_dist3;\n            ay[u] += dy * inv_dist3;\n            az[u] += dz * inv_dist3;\n          }\n        }\n\n        for (int u = 0; u < length; ++u) {\n          const int i = first + u;\n          fx[i] = ax[u];\n          fy[i] = ay[u];\n          fz[i] = az[u];\n        }\n      }\n\n      base = end;\n    }\n  }\n\n  free(workspace);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Cache-bounded symmetric inverse-cube panels can halve redundant distance calculations while preserving each body's original source-ordered force sum.",
  "notes": "Retains double-precision sqrt/division, self interactions and original I/O. No commands or measurements run.",

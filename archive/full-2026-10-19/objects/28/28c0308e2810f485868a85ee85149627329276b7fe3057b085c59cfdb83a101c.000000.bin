#ifndef KNN_H
#define KNN_H

#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>

typedef struct {
    float x;
    float y;
} Point;

typedef struct {
    char label;
    int length;
    Point * points;
} Group;

static char *input_buf = NULL;
static size_t input_len = 0, input_pos = 0;

void init_input() {
    if (input_buf) return;
    fseek(stdin, 0, SEEK_END);
    long sz = ftell(stdin);
    rewind(stdin);
    input_buf = (char*)malloc(sz + 1);
    size_t rd = fread(input_buf, 1, sz, stdin);
    input_len = rd;
    input_pos = 0;
}

static int peek() {
    return input_pos < input_len ? (unsigned char)input_buf[input_pos] : EOF;
}

static void advance() {
    if (input_pos < input_len) ++input_pos;
}

static void skip_ws() {
    while (peek() != EOF && isspace(peek())) advance();
}

void on_error() {
    printf("Invalid input file.\n");
    exit(1);
}

int parse_number_of_groups() {
    init_input();
    while (peek() != EOF && peek() != '=') advance();
    if (peek() == EOF) on_error();
    advance();
    skip_ws();
    int n = 0;
    if (!isdigit(peek())) on_error();
    while (isdigit(peek())) {
        n = n * 10 + (peek() - '0');
        advance();
    }
    return n;
}

Point parse_point() {
    init_input();
    skip_ws();
    if (peek() != '(') on_error();
    advance();
    skip_ws();

    float x = 0.0f;
    int sign = 1;
    if (peek() == '-') { sign = -1; advance(); }
    else if (peek() == '+') advance();
    while (isdigit(peek())) {
        x = x * 10 + (peek() - '0');
        advance();
    }
    if (peek() == '.') {
        advance();
        float frac = 0.1f;
        while (isdigit(peek())) {
            x += (peek() - '0') * frac;
            frac *= 0.1f;
            advance();
        }
    }
    x *= sign;

    skip_ws();
    if (peek() != ',') on_error();
    advance();
    skip_ws();

    float y = 0.0f;
    sign = 1;
    if (peek() == '-') { sign = -1; advance(); }
    else if (peek() == '+') advance();
    while (isdigit(peek())) {
        y = y * 10 + (peek() - '0');
        advance();
    }
    if (peek() == '.') {
        advance();
        float frac = 0.1f;
        while (isdigit(peek())) {
            y += (peek() - '0') * frac;
            frac *= 0.1f;
            advance();
        }
    }
    y *= sign;

    skip_ws();
    if (peek() != ')') on_error();
    advance();

    Point p;
    p.x = x;
    p.y = y;
    return p;
}

Group parse_next_group() {
    init_input();
    while (peek() != EOF && peek() != '=') advance();
    if (peek() == EOF) on_error();
    advance();
    skip_ws();
    char label = (char)peek();
    if (!isprint(label)) on_error();
    advance();

    while (peek() != EOF && peek() != '=') advance();
    if (peek() == EOF) on_error();
    advance();
    skip_ws();

    int length = 0;
    if (!isdigit(peek())) on_error();
    while (isdigit(peek())) {
        length = length * 10 + (peek() - '0');
        advance();
    }

    Group g;
    g.label = label;
    g.length = length;
    g.points = (Point*)malloc(length * sizeof(Point));
    for (int i = 0; i < length; ++i) {
        g.points[i] = parse_point();
    }
    return g;
}

int parse_k() {
    init_input();
    while (peek() != EOF && peek() != '=') advance();
    if (peek() == EOF) on_error();
    advance();
    skip_ws();
    int k = 0;
    if (!isdigit(peek())) on_error();
    while (isdigit(peek())) {
        k = k * 10 + (peek() - '0');
        advance();
    }
    return k;
}

float euclidean_distance_no_sqrt(Point a, Point b) {
    float dx = b.x - a.x;
    float dy = b.y - a.y;
    return dx * dx + dy * dy;
}

int compare_for_sort(const void *a, const void *b) {
  return *(char*)a - *(char*)b;
}

#endif

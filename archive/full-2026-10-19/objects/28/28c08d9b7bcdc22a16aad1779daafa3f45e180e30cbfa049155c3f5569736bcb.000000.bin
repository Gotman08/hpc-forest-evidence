        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nstatic char *sort_strings;\nstatic int sort_length;\n\nstatic int compare_indices(const void *left, const void *right) {\n    long int left_index = *(const long int *)left;\n    long int right_index = *(const long int *)right;\n\n    return strcmp(sort_strings + left_index * sort_length,\n                  sort_strings + right_index * sort_length);\n}\n\nlong int *bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\n    long int *returns;\n    long int *counts;\n    long int *starts;\n    long int *next;\n    long int i;\n    int b;\n\n    if (size < 0 || nbuckets <= 0) {\n        fprintf(stderr, \"Invalid bucket-sort dimensions\\n\");\n        exit(EXIT_FAILURE);\n    }\n\n    returns = malloc(sizeof(*returns) * (size > 0 ? (size_t)size : 1));\n    counts = calloc((size_t)nbuckets, sizeof(*counts));\n    starts = malloc(((size_t)nbuckets + 1) * sizeof(*starts));\n    next = malloc((size_t)nbuckets * sizeof(*next));\n    if (returns == NULL || counts == NULL || starts == NULL || next == NULL) {\n        free(returns);\n        free(counts);\n        free(starts);\n        free(next);\n        fprintf(stderr, \"Unable to allocate bucket-sort storage\\n\");\n        exit(EXIT_FAILURE);\n    }\n\n    /* Count each bucket, then assign it an exact contiguous range. */\n    for (i = 0; i < size; i++) {\n        int bucket_number = a[i * length] - offset;\n        counts[bucket_number]++;\n    }\n\n    starts[0] = 0;\n    for (b = 0; b < nbuckets; b++) {\n        starts[b + 1] = starts[b] + counts[b];\n        next[b] = starts[b];\n    }\n\n    /* Scatter indices into the compact ranges. */\n    for (i = 0; i < size; i++) {\n        int bucket_number = a[i * length] - offset;\n        returns[next[bucket_number]++] = i;\n    }\n\n    sort_strings = a;\n    sort_length = length;\n    for (b = 0; b < nbuckets; b++) {\n        qsort(returns + starts[b], (size_t)counts[b], sizeof(*returns), compare_indices);\n    }\n\n    free(counts);\n    free(starts);\n    free(next);\n    return returns;\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb) {\n    char *strings = NULL;\n    int len;\n    int offset;\n    int nbucket;\n    long int n;\n    long int i;\n\n    if (fscanf(stdin, \"%d\", &len) != 1) {\n        fprintf(stderr, \"ERROR len\\n\");\n        exit(1);\n    }\n    if (fscanf(stdin, \"%ld\", &n) != 1) {\n        fprintf(stderr, \"ERROR n\\n\");\n        exit(1);\n    }\n    if (fscanf(stdin, \"%d\", &offset) != 1) {\n        fprintf(stderr, \"ERROR offset\\n\");\n        exit(1);\n    }\n    if (fscanf(stdin, \"%d\", &nbucket) != 1) {\n        fprintf(stderr, \"ERROR nbucket\\n\");\n        exit(1);\n    }\n\n    nbucket++;\n    len++;\n    strings = malloc((size_t)n * (size_t)len);\n    if (strings == NULL && n > 0) {\n        fprintf(stderr, \"Unable to allocate input strings\\n\");\n        exit(EXIT_FAILURE);\n    }\n\n    for (i = 0; i < n; i++) {\n        if (fscanf(stdin, \"%s\", strings + i * len) != 1) {\n            fprintf(stderr, \"ERROR %ld\\n\", i);\n            exit(1);\n        }\n    }\n\n    *vString = strings;\n    *N = n;\n    *l = len;\n    *os = offset;\n    *nb = nbucket;\n}\n\nvoid save(char *strings, long int *index, long int n, int len) {\n    long int i;\n\n    for (i = 0; i < n; i++) {\n        printf(\"%s\\n\", strings + (index[i] * len));\n    }\n}\n\nint main(int ac, char **av) {\n    char *strings = NULL;\n    long int N = 0;\n    long int *index = NULL;\n    int len = 0;\n    int offset;\n    int nbuckets;\n\n    (void)ac;\n    (void)av;\n\n    load(&strings, &N, &len, &offset, &nbuckets);\n    index = bucket_sort(strings, len, N, offset, nbuckets);\n    save(strings, index, N, len);\n\n    free(strings);\n    free(index);\n    return EXIT_SUCCESS;\n}\n",
        "path": "src/bucketsort.c"
      }

{"files":[{"content":"#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#if defined(__aarch64__) && defined(__ARM_NEON) && !defined(__FAST_MATH__)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system.\n */\nvoid body_force(Body *p, float dt, int n) {\n  int i = 0;\n\n#if defined(__aarch64__) && defined(__ARM_NEON) && !defined(__FAST_MATH__)\n  const int paired_end = n - n % 8;\n  const int vector_end = n - n % 4;\n  const float32x4_t softening = vdupq_n_f32(SOFTENING);\n  const float64x2_t one = vdupq_n_f64(1.0);\n\n  /* Two independent target vectors share each source-body broadcast. */\n  for (; i < paired_end; i += 8) {\n    const float32x4_t x0 = {p[i].x, p[i + 1].x, p[i + 2].x, p[i + 3].x};\n    const float32x4_t y0 = {p[i].y, p[i + 1].y, p[i + 2].y, p[i + 3].y};\n    const float32x4_t z0 = {p[i].z, p[i + 1].z, p[i + 2].z, p[i + 3].z};\n    const float32x4_t x1 = {p[i + 4].x, p[i + 5].x, p[i + 6].x, p[i + 7].x};\n    const float32x4_t y1 = {p[i + 4].y, p[i + 5].y, p[i + 6].y, p[i + 7].y};\n    const float32x4_t z1 = {p[i + 4].z, p[i + 5].z, p[i + 6].z, p[i + 7].z};\n    float32x4_t fx0 = vdupq_n_f32(0.0f);\n    float32x4_t fy0 = vdupq_n_f32(0.0f);\n    float32x4_t fz0 = vdupq_n_f32(0.0f);\n    float32x4_t fx1 = vdupq_n_f32(0.0f);\n    float32x4_t fy1 = vdupq_n_f32(0.0f);\n    float32x4_t fz1 = vdupq_n_f32(0.0f);\n\n    for (int j = 0; j < n; ++j) {\n      const float32x4_t source_x = vdupq_n_f32(p[j].x);\n      const float32x4_t source_y = vdupq_n_f32(p[j].y);\n      const float32x4_t source_z = vdupq_n_f32(p[j].z);\n      float32x4_t dx0 = source_x - x0;\n      float32x4_t dy0 = source_y - y0;\n      float32x4_t dz0 = source_z - z0;\n      float32x4_t dx1 = source_x - x1;\n      float32x4_t dy1 = source_y - y1;\n      float32x4_t dz1 = source_z - z1;\n      float32x4_t sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + softening;\n      float32x4_t sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + softening;\n\n      /* Keep the double sqrt/divide and each target's original j order. */\n      float64x2_t distance0_lo = vcvt_f64_f32(vget_low_f32(sqrd_dist0));\n      float64x2_t distance0_hi = vcvt_f64_f32(vget_high_f32(sqrd_dist0));\n      float64x2_t distance1_lo = vcvt_f64_f32(vget_low_f32(sqrd_dist1));\n      float64x2_t distance1_hi = vcvt_f64_f32(vget_high_f32(sqrd_dist1));\n      float64x2_t inverse0_lo = vdivq_f64(one, vsqrtq_f64(distance0_lo));\n      float64x2_t inverse0_hi = vdivq_f64(one, vsqrtq_f64(distance0_hi));\n      float64x2_t inverse1_lo = vdivq_f64(one, vsqrtq_f64(distance1_lo));\n      float64x2_t inverse1_hi = vdivq_f64(one, vsqrtq_f64(distance1_hi));\n      float32x4_t inv_dist0 = vcombine_f32(vcvt_f32_f64(inverse0_lo),\n                                          vcvt_f32_f64(inverse0_hi));\n      float32x4_t inv_dist1 = vcombine_f32(vcvt_f32_f64(inverse1_lo),\n                                          vcvt_f32_f64(inverse1_hi));\n      float32x4_t inv_dist3_0 = inv_dist0 * inv_dist0 * inv_dist0;\n      float32x4_t inv_dist3_1 = inv_dist1 * inv_dist1 * inv_dist1;\n\n      fx0 += dx0 * inv_dist3_0;\n      fy0 += dy0 * inv_dist3_0;\n      fz0 += dz0 * inv_dist3_0;\n      fx1 += dx1 * inv_dist3_1;\n      fy1 += dy1 * inv_dist3_1;\n      fz1 += dz1 * inv_dist3_1;\n    }\n\n    p[i].vx += dt * vgetq_lane_f32(fx0, 0);\n    p[i].vy += dt * vgetq_lane_f32(fy0, 0);\n    p[i].vz += dt * vgetq_lane_f32(fz0, 0);\n    p[i + 1].vx += dt * vgetq_lane_f32(fx0, 1);\n    p[i + 1].vy += dt * vgetq_lane_f32(fy0, 1);\n    p[i + 1].vz += dt * vgetq_lane_f32(fz0, 1);\n    p[i + 2].vx += dt * vgetq_lane_f32(fx0, 2);\n    p[i + 2].vy += dt * vgetq_lane_f32(fy0, 2);\n    p[i + 2].vz += dt * vgetq_lane_f32(fz0, 2);\n    p[i + 3].vx += dt * vgetq_lane_f32(fx0, 3);\n    p[i + 3].vy += dt * vgetq_lane_f32(fy0, 3);\n    p[i + 3].vz += dt * vgetq_lane_f32(fz0, 3);\n    p[i + 4].vx += dt * vgetq_lane_f32(fx1, 0);\n    p[i + 4].vy += dt * vgetq_lane_f32(fy1, 0);\n    p[i + 4].vz += dt * vgetq_lane_f32(fz1, 0);\n    p[i + 5].vx += dt * vgetq_lane_f32(fx1, 1);\n    p[i + 5].vy += dt * vgetq_lane_f32(fy1, 1);\n    p[i + 5].vz += dt * vgetq_lane_f32(fz1, 1);\n    p[i + 6].vx += dt * vgetq_lane_f32(fx1, 2);\n    p[i + 6].vy += dt * vgetq_lane_f32(fy1, 2);\n    p[i + 6].vz += dt * vgetq_lane_f32(fz1, 2);\n    p[i + 7].vx += dt * vgetq_lane_f32(fx1, 3);\n    p[i + 7].vy += dt * vgetq_lane_f32(fy1, 3);\n    p[i + 7].vz += dt * vgetq_lane_f32(fz1, 3);\n  }\n\n  /* Each lane owns one target; every lane visits j in original order. */\n  for (; i < vector_end; i += 4) {\n    const float32x4_t x = {p[i].x, p[i + 1].x, p[i + 2].x, p[i + 3].x};\n    const float32x4_t y = {p[i].y, p[i + 1].y, p[i + 2].y, p[i + 3].y};\n    const float32x4_t z = {p[i].z, p[i + 1].z, p[i + 2].z, p[i + 3].z};\n    float32x4_t fx = vdupq_n_f32(0.0f);\n    float32x4_t fy = vdupq_n_f32(0.0f);\n    float32x4_t fz = vdupq_n_f32(0.0f);\n\n    for (int j = 0; j < n; ++j) {\n      float32x4_t dx = vdupq_n_f32(p[j].x) - x;\n      float32x4_t dy = vdupq_n_f32(p[j].y) - y;\n      float32x4_t dz = vdupq_n_f32(p[j].z) - z;\n      float32x4_t sqrd_dist = dx*dx + dy*dy + dz*dz + softening;\n\n      /* Match sqrt(double(sqrd_dist)) and double division before rounding. */\n      float64x2_t distance_lo = vcvt_f64_f32(vget_low_f32(sqrd_dist));\n      float64x2_t distance_hi = vcvt_f64_f32(vget_high_f32(sqrd_dist));\n      float64x2_t inverse_lo = vdivq_f64(one, vsqrtq_f64(distance_lo));\n      float64x2_t inverse_hi = vdivq_f64(one, vsqrtq_f64(distance_hi));\n      float32x4_t inv_dist = vcombine_f32(vcvt_f32_f64(inverse_lo),\n                                         vcvt_f32_f64(inverse_hi));\n      float32x4_t inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt * vgetq_lane_f32(fx, 0);\n    p[i].vy += dt * vgetq_lane_f32(fy, 0);\n    p[i].vz += dt * vgetq_lane_f32(fz, 0);\n    p[i + 1].vx += dt * vgetq_lane_f32(fx, 1);\n    p[i + 1].vy += dt * vgetq_lane_f32(fy, 1);\n    p[i + 1].vz += dt * vgetq_lane_f32(fz, 1);\n    p[i + 2].vx += dt * vgetq_lane_f32(fx, 2);\n    p[i + 2].vy += dt * vgetq_lane_f32(fy, 2);\n    p[i + 2].vz += dt * vgetq_lane_f32(fz, 2);\n    p[i + 3].vx += dt * vgetq_lane_f32(fx, 3);\n    p[i + 3].vy += dt * vgetq_lane_f32(fy, 3);\n    p[i + 3].vz += dt * vgetq_lane_f32(fz, 3);\n  }\n#endif\n\n  for (; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n","path":"src/nbody.c"}],"hypothesis":"Processing eight targets as two independent NEON vectors should expose more sqrt/divide instruction-level parallelism and share source broadcasts without reordering any target's force accumulation.","notes":"Retains existing arithmetic expressions, double-precision sqrt/divide, four-target cleanup, and scalar fallback. No commands executed; correctness and performance remain for controller evaluation.","research":{"queries":[],"urls":[]},"sources_kept":[],"transformations":["Add an eight-target NEON bulk loop with two independent four-lane accumulators sharing each source-body broadcast.","Preserve ascending j order, mixed-precision reciprocal calculation, and existing remainder paths."]}
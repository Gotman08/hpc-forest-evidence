    {
      "id": "2ec759468e814fe1",
      "role": "A",
      "mission": {
        "base_commit": "c8a5eaf589e1059b495f086d48dd7dceb2624d2b",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Reusable contiguous merge storage and streaming equality-run counts should eliminate quadratic column rereads for NaN-free inputs while preserving stable ordering and statistical accumulation order.",
        "id": "2ec759468e814fe1",
        "ordinal": 1,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/est_matriz_seq.c"
          ],
          "retained": [
            "Replace per-column bubble passes with stable mergesort, small insertion-sort leaves, and one column-sized scratch allocation reused across columns.",
            "Retain original bubble sorting for NaN-containing columns and scratch-allocation failure.",
            "Replace quadratic mode counting on sorted NaN-free columns with equality-run scans, preserving float count and mode conversions, including rounding-induced updates on long runs.",
            "Use an initialized scalar-counter pairwise fallback for NaN-containing or unordered mode inputs; leave statistical accumulation order and output formatting unchanged."
          ]
        },
        "tree_id": "e1:A",

      "content": "#include \"knn.h\"\n\ntypedef struct {\n    float dist;\n    char label;\n    unsigned long seq;\n} HeapItem;\n\nstatic inline int worse(const HeapItem *a, const HeapItem *b) {\n    if (a->dist > b->dist) return 1;\n    if (a->dist < b->dist) return 0;\n    return a->seq > b->seq;\n}\n\nstatic inline void swap_items(HeapItem *a, HeapItem *b) {\n    HeapItem t = *a;\n    *a = *b;\n    *b = t;\n}\n\nstatic inline void sift_up(HeapItem *heap, int idx) {\n    while (idx > 0) {\n        int parent = (idx - 1) / 2;\n        if (!worse(&heap[idx], &heap[parent])) break;\n        swap_items(&heap[idx], &heap[parent]);\n        idx = parent;\n    }\n}\n\nstatic inline void sift_down(HeapItem *heap, int size, int idx) {\n    for (;;) {\n        int left = 2 * idx + 1;\n        if (left >= size) break;\n        int right = left + 1;\n        int worst_child = left;\n        if (right < size && worse(&heap[right], &heap[left])) {\n            worst_child = right;\n        }\n        if (!worse(&heap[worst_child], &heap[idx])) break;\n        swap_items(&heap[idx], &heap[worst_child]);\n        idx = worst_child;\n    }\n}\n\n#define BLOCK 8\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    if (k <= 0) return '\\0';\n\n    HeapItem *heap = (HeapItem *) malloc(sizeof(HeapItem) * (size_t)k);\n    if (!heap) exit(1);\n\n    int counts[256] = {0};\n    int heap_size = 0;\n    unsigned long seq = 0;\n\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n        char label = g.label;\n        Point *pts = g.points;\n        int len = g.length;\n\n        for (int j = 0; j < len; ) {\n            int block_len = len - j;\n            if (block_len > BLOCK) block_len = BLOCK;\n            float ds[BLOCK];\n\n            // Compute squared distances for a contiguous block of points.\n            #pragma GCC ivdep\n            for (int t = 0; t < block_len; ++t) {\n                Point p = pts[j + t];\n                float dx = p.x - to_evaluate.x;\n                float dy = p.y - to_evaluate.y;\n                ds[t] = dx * dx + dy * dy;\n            }\n\n            // Update the max-heap with each distance in original order.\n            for (int t = 0; t < block_len; ++t) {\n                float d = ds[t];\n\n                if (heap_size < k) {\n                    heap[heap_size].dist = d;\n                    heap[heap_size].label = label;\n                    heap[heap_size].seq = seq++;\n                    counts[(unsigned char)label]++;\n                    ++heap_size;\n                    sift_up(heap, heap_size - 1);\n                } else if (d < heap[0].dist) {\n                    counts[(unsigned char)heap[0].label]--;\n                    heap[0].dist = d;\n                    heap[0].label = label;\n                    heap[0].seq = seq++;\n                    counts[(unsigned char)label]++;\n                    sift_down(heap, k, 0);\n                }\n            }\n\n            j += block_len;\n        }\n    }\n\n    if (heap_size < k) {\n        counts[(unsigned char)-1] += k - heap_size;\n    }\n\n    free(heap);\n\n    char best = 0;\n    int best_count = -1;\n\n    for (int c = -128; c <= 127; ++c) {\n        int cnt = counts[(unsigned char)c];\n        if (cnt > best_count) {\n            best_count = cnt;\n            best = (char)c;\n        }\n    }\n\n    return best;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    },
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nstatic inline float euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}\n",
      "path": "src/knn.h"
    }
  ],
  "hypothesis": "Blocking the distance computation into small contiguous chunks separates pure arithmetic from heap updates, allowing the compiler to vectorize the squared-distance loop and improving cache locality by prefetching a few points at a time. Marking euclidean_distance_no_sqrt as static inline removes any residual call overhead while preserving exact iteration order and tie-breaking semantics.",
  "notes": "The transformation keeps the original group/point traversal order, so seq assignment and all heap decisions remain identical to the parent implementation. The block size of 8 is chosen to fit two NEON vectors on ARM64; correctness does not depend on this constant. Only src/knn.c and src/knn.h were modified.",

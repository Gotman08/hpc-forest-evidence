{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <algorithm>\\n#include <cstdint>\\n#include <cstdio>\\n#include <vector>\\n\\nnamespace {\\nconstexpr int MOD = 1000000007;\\n\\nclass FastInput {\\npublic:\\n    bool readInt(int& value) {\\n        int ch = getchar_unlocked();\\n        while (ch != EOF && ch <= ' ') ch = getchar_unlocked();\\n        if (ch == EOF) return false;\\n        bool negative = false;\\n        if (ch == '-') {\\n            negative = true;\\n            ch = getchar_unlocked();\\n        }\\n        int result = 0;\\n        while (ch >= '0' && ch <= '9') {\\n            result = result * 10 + (ch - '0');\\n            ch = getchar_unlocked();\\n        }\\n        value = negative ? -result : result;\\n        return true;\\n    }\\n};\\n\\nstruct Point {\\n    int y;\\n    int x;\\n\\n    bool operator<(const Point& other) const {\\n        return y != other.y ? y < other.y : x < other.x;\\n    }\\n\\n    bool operator==(const Point& other) const {\\n        return y == other.y && x == other.x;\\n    }\\n};\\n\\nint modPow(int base, int exponent) {\\n    int result = 1;\\n    while (exponent != 0) {\\n        if (exponent & 1) result = static_cast<long long>(result) * base % MOD;\\n        base = static_cast<long long>(base) * base % MOD;\\n        exponent >>= 1;\\n    }\\n    return result;\\n}\\n\\nint main() {\\n    FastInput input;\\n    int n, m;\\n    if (!input.readInt(n) || !input.readInt(m)) return 0;\\n\\n    std::vector<Point> blocked;\\n    blocked.reserve(m + 1);\\n    for (int i = 0; i < m; ++i) {\\n        Point point;\\n        input.readInt(point.y);\\n        input.readInt(point.x);\\n        blocked.push_back(point);\\n    }\\n\\n    std::sort(blocked.begin(), blocked.end());\\n    blocked.erase(std::unique(blocked.begin(), blocked.end()), blocked.end());\\n\\n    const Point start{0, 0};\\n    const Point destination{n - 1, n - 1};\\n    if (std::binary_search(blocked.begin(), blocked.end(), start) ||\\n        std::binary_search(blocked.begin(), blocked.end(), destination)) {\\n        std::puts(\\\"0\\\");\\n        return 0;\\n    }\\n\\n    const int limit = 2 * n - 2;\\n    std::vector<int> factorial(limit + 1);\\n    std::vector<int> inverseFactorial(limit + 1);\\n    factorial[0] = 1;\\n    for (int i = 1; i <= limit; ++i) {\\n        factorial[i] = static_cast<long long>(factorial[i - 1]) * i % MOD;\\n    }\\n    inverseFactorial[limit] = modPow(factorial[limit], MOD - 2);\\n    for (int i = limit; i > 0; --i) {\\n        inverseFactorial[i - 1] = static_cast<long long>(inverseFactorial[i]) * i % MOD;\\n    }\\n\\n    auto paths = [&](int fromY, int fromX, int toY, int toX) -> int {\\n        const int dy = toY - fromY;\\n        const int dx = toX - fromX;\\n        if (dy < 0 || dx < 0) return 0;\\n        return static_cast<long long>(factorial[dy + dx]) * inverseFactorial[dy] % MOD * inverseFactorial[dx] % MOD;\\n    };\\n\\n    blocked.push_back(destination);\\n    std::vector<int> ways(blocked.size());\\n    for (std::size_t i = 0; i < blocked.size(); ++i) {\\n        const Point current = blocked[i];\\n        int count = paths(0, 0, current.y, current.x);\\n        for (std::size_t j = 0; j < i; ++j) {\\n            const Point previous = blocked[j];\\n            if (previous.x > current.x) continue;\\n            const int between = paths(previous.y, previous.x, current.y, current.x);\\n            count -= static_cast<long long>(ways[j]) * between % MOD;\\n            if (count < 0) count += MOD;\\n        }\\n        ways[i] = count;\\n    }\\n\\n    std::printf(\\\"%d\\\\n\\\", ways.back());\\n    return 0;\\n}\\n}\",\"path\":\"src/solution.cpp\"}],\"hypothesis\":\"Sorted obstacle processing has monotone y coordinates, so predecessors whose x coordinate exceeds the current point cannot contribute; skipping their binomial/modular work improves locality and reduces inner-loop arithmetic while preserving inclusion-exclusion.\",\"notes\":\"Repairs the previously missing namespace closing brace. Factorial storage is sized to the largest reachable Manhattan distance.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Keep obstacles in sorted contiguous storage and reserve the destination slot up front.\",\"In the predecessor loop, skip geometrically unreachable points before path-count arithmetic.\",\"Allocate factorial tables only through the maximum needed distance.\"]}"}}

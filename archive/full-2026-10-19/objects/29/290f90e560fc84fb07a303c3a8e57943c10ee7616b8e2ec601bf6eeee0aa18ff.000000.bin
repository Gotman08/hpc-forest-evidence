{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system.\n */\n#if defined(__GNUC__) && !defined(__clang__)\n__attribute__((optimize(\"no-math-errno\")))\n#endif\nvoid body_force(Body *p, float dt, int n) {\n  enum { LANES = 4 };\n  const int blocks = n / LANES;\n\n  #pragma omp parallel for schedule(static) if (n >= 128)\n  for (int block = 0; block < blocks; ++block) {\n    const int base = block * LANES;\n    float x[LANES], y[LANES], z[LANES];\n    float fx[LANES], fy[LANES], fz[LANES];\n\n    for (int lane = 0; lane < LANES; ++lane) {\n      x[lane] = p[base + lane].x;\n      y[lane] = p[base + lane].y;\n      z[lane] = p[base + lane].z;\n      fx[lane] = 0.0f;\n      fy[lane] = 0.0f;\n      fz[lane] = 0.0f;\n    }\n\n    /* Pair source calculations, but retain both ordered additions. */\n    int j = 0;\n    for (; j + 1 < n; j += 2) {\n      const float jx0 = p[j].x;\n      const float jy0 = p[j].y;\n      const float jz0 = p[j].z;\n      const float jx1 = p[j + 1].x;\n      const float jy1 = p[j + 1].y;\n      const float jz1 = p[j + 1].z;\n\n      /* SIMD spans independent targets, not the ordered j reduction. */\n      #pragma omp simd simdlen(4)\n      for (int lane = 0; lane < LANES; ++lane) {\n        float dx0 = jx0 - x[lane];\n        float dy0 = jy0 - y[lane];\n        float dz0 = jz0 - z[lane];\n        float dx1 = jx1 - x[lane];\n        float dy1 = jy1 - y[lane];\n        float dz1 = jz1 - z[lane];\n        float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\n        float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\n        float inv_dist0 = 1 / sqrt(sqrd_dist0);\n        float inv_dist1 = 1 / sqrt(sqrd_dist1);\n        float inv_dist30 = inv_dist0 * inv_dist0 * inv_dist0;\n        float inv_dist31 = inv_dist1 * inv_dist1 * inv_dist1;\n\n        fx[lane] += dx0 * inv_dist30;\n        fy[lane] += dy0 * inv_dist30;\n        fz[lane] += dz0 * inv_dist30;\n        fx[lane] += dx1 * inv_dist31;\n        fy[lane] += dy1 * inv_dist31;\n        fz[lane] += dz1 * inv_dist31;\n      }\n    }\n\n    if (j < n) {\n      const float jx = p[j].x;\n      const float jy = p[j].y;\n      const float jz = p[j].z;\n\n      #pragma omp simd simdlen(4)\n      for (int lane = 0; lane < LANES; ++lane) {\n        float dx = jx - x[lane];\n        float dy = jy - y[lane];\n        float dz = jz - z[lane];\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx[lane] += dx * inv_dist3;\n        fy[lane] += dy * inv_dist3;\n        fz[lane] += dz * inv_dist3;\n      }\n    }\n\n    for (int lane = 0; lane < LANES; ++lane) {\n      p[base + lane].vx += dt*fx[lane];\n      p[base + lane].vy += dt*fy[lane];\n      p[base + lane].vz += dt*fz[lane];\n    }\n  }\n\n  /* Preserve the original calculation for an incomplete target tile. */\n  for (int i = blocks * LANES; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n  \n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "A four-target by two-source micro-tile can expose independent sqrt/division pipelines while reducing live target state compared with the eight-target tile, improving ARM64 SIMD scheduling without reordering any body's force accumulation.",
  "notes": "Preserves double-precision sqrt/division expressions, ordered force additions, both remainder paths, OpenMP resource policy, and binary I/O. Not executed locally.",
  "sources_kept": [],
  "transformations": [
    "Retile the force kernel from eight targets by one source to four SIMD targets by two consecutive sources.",
    "Calculate paired source interactions independently, then accumulate source j before source j+1 for every target.",
    "Retain a SIMD cleanup for an odd source count and the original scalar cleanup for incomplete target tiles."
  ]

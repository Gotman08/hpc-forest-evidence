  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system.\n */\nvoid body_force(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Advance two bodies from an immutable timestep into a separate buffer.\n * Each body's force contributions remain in ascending source-body order.\n */\nstatic void advance_pair(const Body *src, Body *dst, float dt,\n                         int n, int first) {\n  int second = first + 1;\n  const int has_second = second < n;\n  if (!has_second) {\n    second = first;\n  }\n\n  const float x0 = src[first].x;\n  const float y0 = src[first].y;\n  const float z0 = src[first].z;\n  const float x1 = src[second].x;\n  const float y1 = src[second].y;\n  const float z1 = src[second].z;\n  float fx0 = 0.0f;\n  float fy0 = 0.0f;\n  float fz0 = 0.0f;\n  float fx1 = 0.0f;\n  float fy1 = 0.0f;\n  float fz1 = 0.0f;\n\n  for (int j = 0; j < n; ++j) {\n    const float xj = src[j].x;\n    const float yj = src[j].y;\n    const float zj = src[j].z;\n    float dx0 = xj - x0;\n    float dy0 = yj - y0;\n    float dz0 = zj - z0;\n    float dx1 = xj - x1;\n    float dy1 = yj - y1;\n    float dz1 = zj - z1;\n    float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\n    float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\n    float inv_dist0 = 1 / sqrt(sqrd_dist0);\n    float inv_dist1 = 1 / sqrt(sqrd_dist1);\n    float inv_dist30 = inv_dist0 * inv_dist0 * inv_dist0;\n    float inv_dist31 = inv_dist1 * inv_dist1 * inv_dist1;\n\n    fx0 += dx0 * inv_dist30;\n    fy0 += dy0 * inv_dist30;\n    fz0 += dz0 * inv_dist30;\n    fx1 += dx1 * inv_dist31;\n    fy1 += dy1 * inv_dist31;\n    fz1 += dz1 * inv_dist31;\n  }\n\n  Body b0 = src[first];\n  b0.vx += dt*fx0;\n  b0.vy += dt*fy0;\n  b0.vz += dt*fz0;\n  b0.x += b0.vx * dt;\n  b0.y += b0.vy * dt;\n  b0.z += b0.vz * dt;\n  dst[first] = b0;\n\n  if (has_second) {\n    Body b1 = src[second];\n    b1.vx += dt*fx1;\n    b1.vy += dt*fy1;\n    b1.vz += dt*fz1;\n    b1.x += b1.vx * dt;\n    b1.y += b1.vy * dt;\n    b1.z += b1.vz * dt;\n    dst[second] = b1;\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n  Body *scratch = (Body *)malloc((size_t)nbodies * sizeof(Body));\n  Body *result = bodies;\n\n  if (scratch != NULL) {\n    const int work_items = nbodies / 2 + nbodies % 2;\n\n    /* Buffer parity avoids a shared pointer swap or an extra barrier. */\n    #pragma omp parallel if(nbodies >= 64)\n    {\n      for (int iter = 0; iter < N_ITER; ++iter) {\n        const Body *src = (iter & 1) ? scratch : bodies;\n        Body *dst = (iter & 1) ? bodies : scratch;\n\n        #pragma omp for schedule(static)\n        for (int item = 0; item < work_items; ++item) {\n          advance_pair(src, dst, DT, nbodies, 2 * item);\n        }\n        /* The work-sharing barrier completes this timestep's output. */\n      }\n    }\n\n    result = (N_ITER & 1) ? scratch : bodies;\n  } else {\n    /* Preserve the original simulation if the extra buffer is unavailable. */\n    for (int iter = 0; iter < N_ITER; iter++) {\n      body_force(bodies, DT, nbodies);\n\n      for (int i = 0; i < nbodies; i++) {\n        bodies[i].x += bodies[i].vx * DT;\n        bodies[i].y += bodies[i].vy * DT;\n        bodies[i].z += bodies[i].vz * DT;\n      }\n    }\n  }\n\n  write_dataset(nbodies, result);\n\n  free(scratch);\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Two-body static work items in a persistent, double-buffered OpenMP team should expose independent sqrt/divide chains while eliminating writes to the currently read state and requiring only one barrier per timestep.",
  "notes": "Preserves ascending accumulation order and the original sqrt/reciprocal arithmetic. Handles odd body counts and allocation failure. No commands or measurements executed.",

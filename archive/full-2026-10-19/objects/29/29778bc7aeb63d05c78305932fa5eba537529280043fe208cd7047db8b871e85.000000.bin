      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/* Original traversal, also used when temporary storage is unavailable. */\nstatic void body_force_direct(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Cache-blocked force traversal. Each target still accumulates sources\n * in increasing index order, using the original arithmetic expressions.\n */\nvoid body_force(Body *p, float dt, int n) {\n  enum { TARGET_BLOCK = 64, SOURCE_BLOCK = 256 };\n\n  if (n <= 0) {\n    return;\n  }\n\n  float *positions = (float *)malloc((size_t)n * 3 * sizeof(float));\n  if (positions == NULL) {\n    body_force_direct(p, dt, n);\n    return;\n  }\n\n  float *restrict x = positions;\n  float *restrict y = positions + (size_t)n;\n  float *restrict z = positions + (size_t)n * 2;\n\n  for (int i = 0; i < n; ++i) {\n    x[i] = p[i].x;\n    y[i] = p[i].y;\n    z[i] = p[i].z;\n  }\n\n  for (int ib = 0; ib < n; ) {\n    int ni = n - ib;\n    if (ni > TARGET_BLOCK) {\n      ni = TARGET_BLOCK;\n    }\n\n    float fx[TARGET_BLOCK] = {0.0f};\n    float fy[TARGET_BLOCK] = {0.0f};\n    float fz[TARGET_BLOCK] = {0.0f};\n\n    for (int jb = 0; jb < n; ) {\n      int nj = n - jb;\n      if (nj > SOURCE_BLOCK) {\n        nj = SOURCE_BLOCK;\n      }\n      const int je = jb + nj;\n      int k = 0;\n\n      for (; k + 3 < ni; k += 4) {\n        const int i = ib + k;\n        const float x0 = x[i];\n        const float y0 = y[i];\n        const float z0 = z[i];\n        const float x1 = x[i + 1];\n        const float y1 = y[i + 1];\n        const float z1 = z[i + 1];\n        const float x2 = x[i + 2];\n        const float y2 = y[i + 2];\n        const float z2 = z[i + 2];\n        const float x3 = x[i + 3];\n        const float y3 = y[i + 3];\n        const float z3 = z[i + 3];\n\n        float fx0 = fx[k];\n        float fy0 = fy[k];\n        float fz0 = fz[k];\n        float fx1 = fx[k + 1];\n        float fy1 = fy[k + 1];\n        float fz1 = fz[k + 1];\n        float fx2 = fx[k + 2];\n        float fy2 = fy[k + 2];\n        float fz2 = fz[k + 2];\n        float fx3 = fx[k + 3];\n        float fy3 = fy[k + 3];\n        float fz3 = fz[k + 3];\n\n        for (int j = jb; j < je; ++j) {\n          const float jx = x[j];\n          const float jy = y[j];\n          const float jz = z[j];\n\n          {\n            float dx = jx - x0;\n            float dy = jy - y0;\n            float dz = jz - z0;\n            float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n            float inv_dist = 1 / sqrt(sqrd_dist);\n            float inv_dist3 = inv_dist * inv_dist * inv_dist;\n            fx0 += dx * inv_dist3;\n            fy0 += dy * inv_dist3;\n            fz0 += dz * inv_dist3;\n          }\n          {\n            float dx = jx - x1;\n            float dy = jy - y1;\n            float dz = jz - z1;\n            float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n            float inv_dist = 1 / sqrt(sqrd_dist);\n            float inv_dist3 = inv_dist * inv_dist * inv_dist;\n            fx1 += dx * inv_dist3;\n            fy1 += dy * inv_dist3;\n            fz1 += dz * inv_dist3;\n          }\n          {\n            float dx = jx - x2;\n            float dy = jy - y2;\n            float dz = jz - z2;\n            float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n            float inv_dist = 1 / sqrt(sqrd_dist);\n            float inv_dist3 = inv_dist * inv_dist * inv_dist;\n            fx2 += dx * inv_dist3;\n            fy2 += dy * inv_dist3;\n            fz2 += dz * inv_dist3;\n          }\n          {\n            float dx = jx - x3;\n            float dy = jy - y3;\n            float dz = jz - z3;\n            float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n            float inv_dist = 1 / sqrt(sqrd_dist);\n            float inv_dist3 = inv_dist * inv_dist * inv_dist;\n            fx3 += dx * inv_dist3;\n            fy3 += dy * inv_dist3;\n            fz3 += dz * inv_dist3;\n          }\n        }\n\n        fx[k] = fx0;\n        fy[k] = fy0;\n        fz[k] = fz0;\n        fx[k + 1] = fx1;\n        fy[k + 1] = fy1;\n        fz[k + 1] = fz1;\n        fx[k + 2] = fx2;\n        fy[k + 2] = fy2;\n        fz[k + 2] = fz2;\n        fx[k + 3] = fx3;\n        fy[k + 3] = fy3;\n        fz[k + 3] = fz3;\n      }\n\n      for (; k < ni; ++k) {\n        const int i = ib + k;\n        const float xi = x[i];\n        const float yi = y[i];\n        const float zi = z[i];\n        float fxi = fx[k];\n        float fyi = fy[k];\n        float fzi = fz[k];\n\n        for (int j = jb; j < je; ++j) {\n          float dx = x[j] - xi;\n          float dy = y[j] - yi;\n          float dz = z[j] - zi;\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          float inv_dist = 1 / sqrt(sqrd_dist);\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\n          fxi += dx * inv_dist3;\n          fyi += dy * inv_dist3;\n          fzi += dz * inv_dist3;\n        }\n\n        fx[k] = fxi;\n        fy[k] = fyi;\n        fz[k] = fzi;\n      }\n\n      jb = je;\n    }\n\n    for (int k = 0; k < ni; ++k) {\n      p[ib + k].vx += dt*fx[k];\n      p[ib + k].vy += dt*fy[k];\n      p[ib + k].vz += dt*fz[k];\n    }\n\n    ib += ni;\n  }\n\n  free(positions);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Two-dimensional force blocking should keep source-position chunks hot in L1 across more targets, reducing cache traffic while preserving each target's accumulation order.",

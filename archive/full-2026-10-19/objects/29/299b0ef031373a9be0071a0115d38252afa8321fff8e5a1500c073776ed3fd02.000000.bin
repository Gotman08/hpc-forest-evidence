#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

/*
 * Each body holds coordinate positions (i.e., x, y, and z) and
 * velocities (i.e., vx, vy, and vz).
 */
typedef struct { float x, y, z, vx, vy, vz; } Body;

enum { FORCE_TILE = 4, PARALLEL_MIN_BODIES = 128 };

/*
 * SIMD lanes own independent target rows. Each row still accumulates
 * source bodies in exactly the original order.
 * Squared distances cannot be negative, so sqrt needs no errno checks.
 */
#if defined(__GNUC__) && !defined(__clang__)
__attribute__((optimize("no-math-errno")))
#endif
static void body_force_tile(Body *p, float dt, int n, int first) {
  if (n - first < FORCE_TILE) {
    for (int i = first; i < n; ++i) {
      float fx = 0.0f;
      float fy = 0.0f;
      float fz = 0.0f;

      for (int j = 0; j < n; ++j) {
        float dx = p[j].x - p[i].x;
        float dy = p[j].y - p[i].y;
        float dz = p[j].z - p[i].z;
        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
        float inv_dist = 1 / sqrt(sqrd_dist);
        float inv_dist3 = inv_dist * inv_dist * inv_dist;

        fx += dx * inv_dist3;
        fy += dy * inv_dist3;
        fz += dz * inv_dist3;
      }

      p[i].vx += dt*fx;
      p[i].vy += dt*fy;
      p[i].vz += dt*fz;
    }
    return;
  }

  float x[FORCE_TILE], y[FORCE_TILE], z[FORCE_TILE];
  float fx[FORCE_TILE], fy[FORCE_TILE], fz[FORCE_TILE];

  #pragma omp simd simdlen(4)
  for (int lane = 0; lane < FORCE_TILE; ++lane) {
    x[lane] = p[first + lane].x;
    y[lane] = p[first + lane].y;
    z[lane] = p[first + lane].z;
    fx[lane] = 0.0f;
    fy[lane] = 0.0f;
    fz[lane] = 0.0f;
  }

  for (int j = 0; j < n; ++j) {
    float sx = p[j].x;
    float sy = p[j].y;
    float sz = p[j].z;

    #pragma omp simd simdlen(4)
    for (int lane = 0; lane < FORCE_TILE; ++lane) {
      float dx = sx - x[lane];
      float dy = sy - y[lane];
      float dz = sz - z[lane];
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1 / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx[lane] += dx * inv_dist3;
      fy[lane] += dy * inv_dist3;
      fz[lane] += dz * inv_dist3;
    }
  }

  #pragma omp simd simdlen(4)
  for (int lane = 0; lane < FORCE_TILE; ++lane) {
    p[first + lane].vx += dt*fx[lane];
    p[first + lane].vy += dt*fy[lane];
    p[first + lane].vz += dt*fz[lane];
  }
}

/* All threads in the enclosing team participate in this workshare. */
static void body_force_workshare(Body *p, float dt, int n) {
  int ntiles = n / FORCE_TILE + (n % FORCE_TILE != 0);

  #pragma omp for schedule(static)
  for (int tile = 0; tile < ntiles; ++tile) {
    body_force_tile(p, dt, n, tile * FORCE_TILE);
  }
}

/*
 * Compute the gravitational impact among all pairs of bodies in
 * the system. This entry point remains usable for independent calls.
 */
void body_force(Body *p, float dt, int n) {
  #pragma omp parallel if(n >= PARALLEL_MIN_BODIES)
  {
    body_force_workshare(p, dt, n);
  }
}

/*
 * Read a binary dataset with initilized bodies.
 */
Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  return bodies;
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc,char **argv) {
  int nbodies;

  Body *bodies = read_dataset(&nbodies);

  /* Keep one team across all iterations, with barriers between phases. */
  #pragma omp parallel if(nbodies >= PARALLEL_MIN_BODIES)
  {
    for (int iter = 0; iter < N_ITER; iter++) {
      body_force_workshare(bodies, DT, nbodies);

      #pragma omp for schedule(static)
      for (int i = 0; i < nbodies; i++) {
        bodies[i].x += bodies[i].vx * DT;
        bodies[i].y += bodies[i].vy * DT;
        bodies[i].z += bodies[i].vz * DT;
      }
    }
  }

  write_dataset(nbodies, bodies);

  free(bodies);

  exit(EXIT_SUCCESS);
}

    "content": "{\n  \"hypothesis\": \"Optimize the memory locality and loop order to improve the performance of the SxS submatrix sum calculation.\",\n  \"transformations\": [\n    \"Reordered the loops to improve cache locality.\",\n    \"Used a single loop to update the sum instead of separate loops for entering and exiting rows/columns.\"\n  ],\n  \"sources_kept\": [],\n  \"files\": [\n    {\n      \"path\": \"src/solution.cpp\",\n      \"content\": \"#include <iostream>\\n#include <vector>\\n#include <cstdio>\\n#include <cassert>\\n\\nint main() {\\n\\tint n, s;\\n\\tstd::cin >> n >> s;\\n\\tstd::vector<std::vector<int>> matrix(n, std::vector<int>(n));\\n\\tfor(int i = 0; i < n; i++)\\n\\t\\tfor(int j = 0; j < n; j++) \\n\\t\\t\\tscanf(\\\"%d\\\", &(matrix[i][j]));\\n\\n\\tassert(s < n);\\n\\tassert(n < 8000);\\n\\tassert(s > 0);\\n\\tassert(n > 0);\\n\\n\\tint sum = 0;\\n\\tfor(int i = 0; i < s; i++)\\n\\t\\tfor(int j = 0; j < s; j++)\\n\\t\\t\\tsum += matrix[i][j];\\n\\n\\tint mxSum = sum;\\n\\n\\tfor(int i = 0; i <= n - s; i++) {\\n\\t\\tfor(int j = 0; j <= n - s; j++) {\\n\\t\\t\\tif (i == 0 && j == 0) continue;\\n\\t\\t\\tif (i == 0) {\\n\\t\\t\\t\\tfor(int k = 0; k < s; k++) {\\n\\t\\t\\t\\t\\tsum -= matrix[k][j - 1];\\n\\t\\t\\t\\t\\tsum += matrix[k][j + s - 1];\\n\\t\\t\\t\\t}\\n\\t\\t\\t} else if (j == 0) {\\n\\t\\t\\t\\tfor(int k = 0; k < s; k++) {\\n\\t\\t\\t\\t\\tsum -= matrix[i - 1][k];\\n\\t\\t\\t\\t\\tsum += matrix[i + s - 1][k];\\n\\t\\t\\t\\t}\\n\\t\\t\\t} else {\\n\\t\\t\\t\\tfor(int k = 0; k < s; k++) {\\n\\t\\t\\t\\t\\tsum -= matrix[i - 1][j + k];\\n\\t\\t\\t\\t\\tsum -= matrix[i + s - 1][j + k];\\n\\t\\t\\t\\t\\tsum += matrix[i + s - 1][j + s + k - 1];\\n\\t\\t\\t\\t\\tsum += matrix[i - 1][j + s + k - 1];\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t\\tmxSum = std::max(mxSum, sum);\\n\\t\\t}\\n\\t}\\n\\tprintf(\\\"%d\\\\n\\\", mxSum);\\n}\"\n    }\n  ],\n  \"notes\": \"Reordered the loops to improve cache locality and used a single loop to update t
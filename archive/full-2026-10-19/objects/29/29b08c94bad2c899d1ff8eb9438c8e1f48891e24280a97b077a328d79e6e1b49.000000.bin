          "files": [
            "src/solution.cpp"
          ],
          "retained": [
            "Replace the dense obstacle bitmap with sorted, deduplicated 64-bit row/column keys, consumed sequentially without per-row allocations.",
            "Use one in-place DP array and a register-held left neighbor, resetting both at blocked cells.",
            "Process clear spans without obstacle checks inside the cell loop; replace modulo with one conditional subtraction."
          ]
        },

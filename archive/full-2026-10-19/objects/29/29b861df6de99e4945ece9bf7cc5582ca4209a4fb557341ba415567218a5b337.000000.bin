      "content": "#include <iostream>\n#include <vector>\n#include <utility>\n#include <cstddef>\n\nusing namespace std;\n\nstruct adjacency_matrix {\n    size_t vertex_count;\n    vector<unsigned char> entries;\n\n    explicit adjacency_matrix(size_t vertices)\n        : vertex_count(vertices), entries(vertices * vertices, 0) {}\n\n    size_t size() const {\n        return vertex_count;\n    }\n\n    unsigned char *operator[](size_t row) {\n        return entries.data() + row * vertex_count;\n    }\n\n    const unsigned char *operator[](size_t row) const {\n        return entries.data() + row * vertex_count;\n    }\n};\n\nstruct constraint_row {\n    int vertex;\n    size_t end;\n};\n\nstruct permutation_constraints {\n    unsigned char value = 0;\n    vector<constraint_row> rows;\n    vector<int> columns;\n};\n\nadjacency_matrix readGraph();\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence);\nbool buildConstraints(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                      permutation_constraints &constraints);\nbool verifyConstraints(const adjacency_matrix &g2,\n                       const permutation_constraints &constraints,\n                       const vector<int> &equivalence);\ninline void printPermutation(vector<int> &equivalence);\n\nint main() {\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if (!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2) {\n    if (g1.size() != g2.size()) return false;\n\n    vector<int> equivalence(g1.size(), 0);\n    vector<int> exchange_counter(g1.size(), 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    for (size_t i = 0; i < equivalence.size(); ++i)\n        equivalence[i] = static_cast<int>(i);\n\n    if (verifyPermutation(g1, g2, equivalence)) {\n        printPermutation(equivalence);\n        return true;\n    }\n\n    permutation_constraints constraints;\n    if (!buildConstraints(g1, g2, constraints)) return false;\n\n    // Preserve Heap's permutation order and print every nonidentity match.\n    while (static_cast<size_t>(exchange_index) < g1.size()) {\n        if (exchange_counter[exchange_index] < exchange_index) {\n            if (exchange_index % 2 == 0)\n                swap(equivalence[0], equivalence[exchange_index]);\n            else\n                swap(equivalence[exchange_counter[exchange_index]],\n                     equivalence[exchange_index]);\n\n            if (verifyConstraints(g2, constraints, equivalence)) {\n                printPermutation(equivalence);\n                isomorphism_found = true;\n            }\n\n            exchange_counter[exchange_index]++;\n            exchange_index = 1;\n        } else {\n            exchange_counter[exchange_index] = 0;\n            exchange_index++;\n        }\n    }\n    return isomorphism_found;\n}\n\nadjacency_matrix readGraph() {\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read(vertices);\n\n    cin >> edges;\n    for (int i = 0; i < edges; ++i) {\n        cin >> source >> destination;\n        read[destination][source] = read[source][destination] = 1;\n    }\n\n    return read;\n}\n\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence) {\n    for (size_t i = 0; i < equivalence.size(); ++i) {\n        const unsigned char *source_row = g1[i];\n        const unsigned char *target_row = g2[equivalence[i]];\n        for (size_t j = 0; j <= i; ++j) {\n            if (source_row[j] != target_row[equivalence[j]]) return false;\n        }\n    }\n    return true;\n}\n\nbool buildConstraints(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                      permutation_constraints &constraints) {\n    const size_t n = g1.size();\n    size_t ones1 = 0;\n    size_t ones2 = 0;\n\n    constraints.rows.clear();\n    constraints.columns.clear();\n\n    // Count Boolean unordered pairs, including loops, after duplicates collapse.\n    for (size_t i = 0; i < n; ++i) {\n        const unsigned char *row1 = g1[i];\n        const unsigned char *row2 = g2[i];\n        for (size_t j = 0; j <= i; ++j) {\n            ones1 += row1[j];\n            ones2 += row2[j];\n        }\n    }\n    if (ones1 != ones2) return false;\n\n    const size_t pairs = n * (n + 1) / 2;\n    constraints.value = ones1 <= pairs - ones1 ? 1 : 0;\n    const size_t count = constraints.value ? ones1 : pairs - ones1;\n    constraints.rows.reserve(n);\n    constraints.columns.reserve(count);\n\n    // Pack only the less frequent value, grouping constraints by source row.\n    for (size_t i = 0; i < n; ++i) {\n        const size_t begin = constraints.columns.size();\n        const unsigned char *row = g1[i];\n        for (size_t j = 0; j <= i; ++j) {\n            if (row[j] == constraints.value)\n                constraints.columns.push_back(static_cast<int>(j));\n        }\n        if (constraints.columns.size() != begin)\n            constraints.rows.push_back(\n                {static_cast<int>(i), constraints.columns.size()});\n    }\n    return true;\n}\n\nbool verifyConstraints(const adjacency_matrix &g2,\n                       const permutation_constraints &constraints,\n                       const vector<int> &equivalence) {\n    // A permutation bijects unordered pairs. Equal cardinalities make checking\n    // every minority-valued pair sufficient to establish full matrix equality.\n    size_t cursor = 0;\n    for (const constraint_row &row : constraints.rows) {\n        const unsigned char *target_row = g2[equivalence[row.vertex]];\n        for (; cursor < row.end; ++cursor) {\n            if (target_row[equivalence[constraints.columns[cursor]]] !=\n                constraints.value)\n                return false;\n        }\n    }\n    return true;\n}\n\ninline void printPermutation(vector<int> &equivalence) {\n    for (auto i : equivalence)\n        cout << i << \" \";\n    cout << endl;\n}\n",

{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <math.h>\\n#include <stdint.h>\\n\\n#define N_ITER 10 // number of simulation iterations\\n#define DT 0.01f // time step\\n#define SOFTENING 1e-9f // to avoid zero divisors\\n\\n/*\\n * Each body holds coordinate positions (i.e., x, y, and z) and\\n * velocities (i.e., vx, vy, and vz).\\n */\\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\\n\\n/*\\n * Compute the gravitational impact among all pairs of bodies in\\n * the system.\\n */\\nvoid body_force(Body *p, float dt, int n) {\\n  for (int i = 0; i < n; ++i) {\\n    float fx = 0.0f;\\n    float fy = 0.0f;\\n    float fz = 0.0f;\\n\\n    for (int j = 0; j < n; j++) {\\n      float dx = p[j].x - p[i].x;\\n      float dy = p[j].y - p[i].y;\\n      float dz = p[j].z - p[i].z;\\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n      float inv_dist = 1 / sqrt(sqrd_dist);\\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n\\n      fx += dx * inv_dist3;\\n      fy += dy * inv_dist3;\\n      fz += dz * inv_dist3;\\n    }\\n\\n    p[i].vx += dt*fx;\\n    p[i].vy += dt*fy;\\n    p[i].vz += dt*fz;\\n  }\\n}\\n\\n/*\\n * Read a binary dataset with initilized bodies.\\n */\\nBody* read_dataset(int *nbodies) {\\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading nbodie value\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading input values\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n\\n  return bodies;\\n}\\n\\n/*\\n * Write simulation results into a binary dataset.\\n */\\nvoid write_dataset(const int nbodies, Body *bodies) {\\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError writing to output\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n}\\n\\nint main(int argc,char **argv) {\\n  int nbodies;\\n\\n  Body *bodies = read_dataset(&nbodies);\\n  Body *scratch = NULL;\\n\\n  /* Avoid parallel startup and extra storage for small systems. */\\n  if (nbodies >= 128 &&\\n      (size_t)nbodies <= SIZE_MAX / sizeof(*scratch)) {\\n    scratch = (Body *)malloc((size_t)nbodies * sizeof(*scratch));\\n  }\\n\\n  if (scratch != NULL) {\\n    /* Each timestep reads immutable bodies and writes the other buffer. */\\n    #pragma omp parallel default(none) shared(bodies, scratch, nbodies)\\n    {\\n      Body *current = bodies;\\n      Body *next = scratch;\\n\\n      for (int iter = 0; iter < N_ITER; iter++) {\\n        #pragma omp for schedule(static)\\n        for (int i = 0; i < nbodies; i++) {\\n          float fx = 0.0f;\\n          float fy = 0.0f;\\n          float fz = 0.0f;\\n\\n          for (int j = 0; j < nbodies; j++) {\\n            float dx = current[j].x - current[i].x;\\n            float dy = current[j].y - current[i].y;\\n            float dz = current[j].z - current[i].z;\\n            float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n            float inv_dist = 1 / sqrt(sqrd_dist);\\n            float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n\\n            fx += dx * inv_dist3;\\n            fy += dy * inv_dist3;\\n            fz += dz * inv_dist3;\\n          }\\n\\n          next[i] = current[i];\\n          next[i].vx += DT*fx;\\n          next[i].vy += DT*fy;\\n          next[i].vz += DT*fz;\\n          next[i].x += next[i].vx * DT;\\n          next[i].y += next[i].vy * DT;\\n          next[i].z += next[i].vz * DT;\\n        }\\n\\n        /* The worksharing barrier completes all reads and writes before\\n         * these thread-local swaps; no second timestep barrier is needed. */\\n        Body *temporary = current;\\n        current = next;\\n        next = temporary;\\n      }\\n    }\\n\\n    if (N_ITER % 2 != 0) {\\n      memcpy(bodies, scratch, (size_t)nbodies * sizeof(*bodies));\\n    }\\n    free(scratch);\\n  } else {\\n    /* Original serial path also handles scratch allocation failure. */\\n    for (int iter = 0; iter < N_ITER; iter++) {\\n      body_force(bodies, DT, nbodies);\\n\\n      for (int i = 0; i < nbodies; i++) {\\n        bodies[i].x += bodies[i].vx * DT;\\n        bodies[i].y += bodies[i].vy * DT;\\n        bodies[i].z += bodies[i].vz * DT;\\n      }\\n    }\\n  }\\n\\n  write_dataset(nbodies, bodies);\\n\\n  free(bodies);\\n\\n  exit(EXIT_SUCCESS);\\n}\\n\",\n      \"path\": \"src/nbody.c\"\n    }\n  ],\n  \"hypothesis\": \"Static target-body work sharing with double-buffered, fused timesteps should accelerate the simulation while reducing synchronization to one worksharing barrier per timestep and avoiding writes to the shared source buffer.\",\n  \"notes\": \"Preserves force accumulation order, arithmetic expressions, standalone body_force behavior, and binary I/O. No commands or measurements performed.\",\n  \"research\": {\n    \"queries\": [],\n    \"urls\": []\n  },\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Use one persistent OpenMP team with static target-body scheduling.\",\n    \"Fuse force, velocity, and position updates into an alternate Body buffer; swap thread-local pointers after the worksharing barrier.\",\n    \"Retain serial execution below 128 bodies or when checked scratch allocation fails.\"\n  ]\n}"}}

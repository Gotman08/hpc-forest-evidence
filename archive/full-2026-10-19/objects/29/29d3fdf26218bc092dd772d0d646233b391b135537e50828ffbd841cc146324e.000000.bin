#include <iostream>
#include <vector>
#include <cstdio>
#include <climits>

int main() {
    int n, s;
    std::cin >> n >> s;
    std::vector<std::vector<int>> matrix(n, std::vector<int>(n));
    for (int i = 0; i < n; ++i)
        for (int j = 0; j < n; ++j)
            scanf("%d", &matrix[i][j]);

    // Compute integral image (prefix sum) with extra row/col of zeros
    std::vector<std::vector<long long>> ps(n + 1, std::vector<long long>(n + 1, 0));
    for (int i = 1; i <= n; ++i)
        for (int j = 1; j <= n; ++j)
            ps[i][j] = matrix[i - 1][j - 1] + ps[i - 1][j] + ps[i][j - 1] - ps[i - 1][j - 1];

    long long mxSum = LLONG_MIN;
    #pragma omp parallel for collapse(2) reduction(max:mxSum)
    for (int i = 0; i <= n - s; ++i)
        for (int j = 0; j <= n - s; ++j) {
            long long sum = ps[i + s][j + s] - ps[i][j + s] - ps[i + s][j] + ps[i][j];
            if (sum > mxSum) mxSum = sum;
        }

    printf("%lld\n", mxSum);
}

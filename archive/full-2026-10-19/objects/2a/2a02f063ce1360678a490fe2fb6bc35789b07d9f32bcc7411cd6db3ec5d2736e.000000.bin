      "content": "#include <bits/stdc++.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\ntypedef long long ll;\n\nint A[1000][1000];\n\nclass PrefixFrequency {\n  struct Entry {\n    ll key = 0;\n    uint32_t count = 0;\n    uint32_t epoch = 0;\n  };\n\n  vector<Entry> entries;\n  size_t mask;\n  unsigned shift;\n  uint32_t epoch = 0;\n\n  size_t index(ll key) const {\n    return static_cast<size_t>(\n        (static_cast<uint64_t>(key) * 11400714819323198485ULL) >> shift);\n  }\n\npublic:\n  explicit PrefixFrequency(size_t maximum_distinct) {\n    size_t capacity = 1;\n    unsigned bits = 0;\n    while (capacity < 2 * maximum_distinct) {\n      capacity <<= 1;\n      ++bits;\n    }\n    entries.resize(capacity);\n    mask = capacity - 1;\n    shift = 64 - bits;\n  }\n\n  void reset() {\n    if (++epoch == 0) {\n      for (Entry &entry : entries)\n        entry.epoch = 0;\n      epoch = 1;\n    }\n    add(0);\n  }\n\n  uint32_t get(ll key) const {\n    size_t slot = index(key);\n    while (entries[slot].epoch == epoch) {\n      if (entries[slot].key == key)\n        return entries[slot].count;\n      slot = (slot + 1) & mask;\n    }\n    return 0;\n  }\n\n  void add(ll key) {\n    size_t slot = index(key);\n    while (entries[slot].epoch == epoch) {\n      if (entries[slot].key == key) {\n        ++entries[slot].count;\n        return;\n      }\n      slot = (slot + 1) & mask;\n    }\n    entries[slot].key = key;\n    entries[slot].count = 1;\n    entries[slot].epoch = epoch;\n  }\n};\n\nll solve(int m, int n, int k) {\n  const int boundaries = min(m, n);\n  const int scan_length = max(m, n);\n  vector<int> prefixes(static_cast<size_t>(boundaries + 1) * scan_length, 0);\n\n  // Each boundary prefix is contiguous in the subsequent scan direction.\n  if (n <= m) {\n    for (int j = 0; j < n; ++j) {\n      const int *previous = prefixes.data() + static_cast<size_t>(j) * scan_length;\n      int *next = prefixes.data() + static_cast<size_t>(j + 1) * scan_length;\n      for (int i = 0; i < m; ++i)\n        next[i] = previous[i] + A[i][j];\n    }\n  } else {\n    for (int i = 0; i < m; ++i) {\n      const int *previous = prefixes.data() + static_cast<size_t>(i) * scan_length;\n      int *next = prefixes.data() + static_cast<size_t>(i + 1) * scan_length;\n      for (int j = 0; j < n; ++j)\n        next[j] = previous[j] + A[i][j];\n    }\n  }\n\n  const ll pair_count = static_cast<ll>(boundaries) * (boundaries + 1) / 2;\n  ll ans = 0;\n\n#ifdef _OPENMP\n#pragma omp parallel if (static_cast<ll>(scan_length) * pair_count >= 32768) reduction(+:ans)\n#endif\n  {\n    int thread_id = 0;\n    int thread_count = 1;\n#ifdef _OPENMP\n    thread_id = omp_get_thread_num();\n    thread_count = omp_get_num_threads();\n#endif\n\n    const ll first_pair = pair_count * thread_id / thread_count;\n    const ll last_pair = pair_count * (thread_id + 1) / thread_count;\n\n    // Decode this worker's first pair once, then advance sequentially.\n    int first = 0;\n    ll offset = first_pair;\n    while (first < boundaries && offset >= boundaries - first) {\n      offset -= boundaries - first;\n      ++first;\n    }\n    int last = first + 1 + static_cast<int>(offset);\n\n    PrefixFrequency frequency(static_cast<size_t>(scan_length) + 1);\n    for (ll pair = first_pair; pair < last_pair; ++pair) {\n      const int *lower = prefixes.data() + static_cast<size_t>(first) * scan_length;\n      const int *upper = prefixes.data() + static_cast<size_t>(last) * scan_length;\n      frequency.reset();\n      ll sum = 0;\n      for (int x = 0; x < scan_length; ++x) {\n        sum += static_cast<ll>(upper[x]) - lower[x];\n        ans += frequency.get(sum - static_cast<ll>(k));\n        frequency.add(sum);\n      }\n\n      if (++last > boundaries) {\n        ++first;\n        last = first + 1;\n      }\n    }\n  }\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n",
      "path": "src/main.cpp"
    }

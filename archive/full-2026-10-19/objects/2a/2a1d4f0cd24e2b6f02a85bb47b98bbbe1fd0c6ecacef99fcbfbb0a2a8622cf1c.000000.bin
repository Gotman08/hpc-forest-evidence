#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#if defined(__aarch64__) && defined(__ARM_NEON)
#include <arm_neon.h>
#endif

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

/*
 * Each body holds coordinate positions (i.e., x, y, and z) and
 * velocities (i.e., vx, vy, and vz).
 */
typedef struct { float x, y, z, vx, vy, vz; } Body;

/* Force-only operation, also used if the scratch allocation fails. */
void body_force(Body *p, float dt, int n) {
  for (int i = 0; i < n; ++i) {
    float fx = 0.0f;
    float fy = 0.0f;
    float fz = 0.0f;

    for (int j = 0; j < n; j++) {
      float dx = p[j].x - p[i].x;
      float dy = p[j].y - p[i].y;
      float dz = p[j].z - p[i].z;
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1 / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    p[i].vx += dt*fx;
    p[i].vy += dt*fy;
    p[i].vz += dt*fz;
  }
}

static inline void advance_one(const Body *restrict p,
                               Body *restrict next,
                               float dt, int n, int i) {
  const float x = p[i].x;
  const float y = p[i].y;
  const float z = p[i].z;
  float fx = 0.0f;
  float fy = 0.0f;
  float fz = 0.0f;

  for (int j = 0; j < n; ++j) {
    float dx = p[j].x - x;
    float dy = p[j].y - y;
    float dz = p[j].z - z;
    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
    float inv_dist = 1 / sqrt(sqrd_dist);
    float inv_dist3 = inv_dist * inv_dist * inv_dist;
    fx += dx * inv_dist3;
    fy += dy * inv_dist3;
    fz += dz * inv_dist3;
  }

  const float vx = p[i].vx + dt*fx;
  const float vy = p[i].vy + dt*fy;
  const float vz = p[i].vz + dt*fz;
  next[i].vx = vx;
  next[i].vy = vy;
  next[i].vz = vz;
  next[i].x = x + vx*dt;
  next[i].y = y + vy*dt;
  next[i].z = z + vz*dt;
}

/* Four targets share each source load without changing any j reduction. */
static inline void advance_four(const Body *restrict p,
                                Body *restrict next,
                                float dt, int n, int i) {
  const float x[4] = {p[i].x, p[i+1].x, p[i+2].x, p[i+3].x};
  const float y[4] = {p[i].y, p[i+1].y, p[i+2].y, p[i+3].y};
  const float z[4] = {p[i].z, p[i+1].z, p[i+2].z, p[i+3].z};
  float fx[4] = {0.0f};
  float fy[4] = {0.0f};
  float fz[4] = {0.0f};

  for (int j = 0; j < n; ++j) {
    const float xj = p[j].x;
    const float yj = p[j].y;
    const float zj = p[j].z;

    #pragma omp simd
    for (int lane = 0; lane < 4; ++lane) {
      float dx = xj - x[lane];
      float dy = yj - y[lane];
      float dz = zj - z[lane];
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1 / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;
      fx[lane] += dx * inv_dist3;
      fy[lane] += dy * inv_dist3;
      fz[lane] += dz * inv_dist3;
    }
  }

  for (int lane = 0; lane < 4; ++lane) {
    const float vx = p[i+lane].vx + dt*fx[lane];
    const float vy = p[i+lane].vy + dt*fy[lane];
    const float vz = p[i+lane].vz + dt*fz[lane];
    next[i+lane].vx = vx;
    next[i+lane].vy = vy;
    next[i+lane].vz = vz;
    next[i+lane].x = x[lane] + vx*dt;
    next[i+lane].y = y[lane] + vy*dt;
    next[i+lane].z = z[lane] + vz*dt;
  }
}

#if defined(__aarch64__) && defined(__ARM_NEON)
static inline float32x4_t inverse_distance4(float32x4_t squared) {
  const float64x2_t one = vdupq_n_f64(1.0);
  float64x2_t lo = vcvt_f64_f32(vget_low_f32(squared));
  float64x2_t hi = vcvt_f64_f32(vget_high_f32(squared));

  /* Match the reference's double sqrt and division before narrowing. */
  float64x2_t inv_lo = vdivq_f64(one, vsqrtq_f64(lo));
  float64x2_t inv_hi = vdivq_f64(one, vsqrtq_f64(hi));
  return vcombine_f32(vcvt_f32_f64(inv_lo), vcvt_f32_f64(inv_hi));
}

static inline void advance_eight(const Body *restrict p,
                                 Body *restrict next,
                                 float dt, int n, int i) {
  const float x[8] = {p[i].x, p[i+1].x, p[i+2].x, p[i+3].x,
                      p[i+4].x, p[i+5].x, p[i+6].x, p[i+7].x};
  const float y[8] = {p[i].y, p[i+1].y, p[i+2].y, p[i+3].y,
                      p[i+4].y, p[i+5].y, p[i+6].y, p[i+7].y};
  const float z[8] = {p[i].z, p[i+1].z, p[i+2].z, p[i+3].z,
                      p[i+4].z, p[i+5].z, p[i+6].z, p[i+7].z};
  float fx[8] = {0.0f};
  float fy[8] = {0.0f};
  float fz[8] = {0.0f};

  /* Lanes are independent targets; j retains its ascending order. */
  for (int j = 0; j < n; ++j) {
    const float xj = p[j].x;
    const float yj = p[j].y;
    const float zj = p[j].z;
    float dx[8], dy[8], dz[8], squared[8], inverse[8];

    #pragma omp simd
    for (int lane = 0; lane < 8; ++lane) {
      float dx_lane = xj - x[lane];
      float dy_lane = yj - y[lane];
      float dz_lane = zj - z[lane];
      dx[lane] = dx_lane;
      dy[lane] = dy_lane;
      dz[lane] = dz_lane;
      squared[lane] = dx_lane*dx_lane + dy_lane*dy_lane
                    + dz_lane*dz_lane + SOFTENING;
    }

    float32x4_t inv0 = inverse_distance4(vld1q_f32(squared));
    float32x4_t inv1 = inverse_distance4(vld1q_f32(squared + 4));
    vst1q_f32(inverse, inv0);
    vst1q_f32(inverse + 4, inv1);

    #pragma omp simd
    for (int lane = 0; lane < 8; ++lane) {
      float inv_dist = inverse[lane];
      float inv_dist3 = inv_dist * inv_dist * inv_dist;
      fx[lane] += dx[lane] * inv_dist3;
      fy[lane] += dy[lane] * inv_dist3;
      fz[lane] += dz[lane] * inv_dist3;
    }
  }

  for (int lane = 0; lane < 8; ++lane) {
    const float vx = p[i+lane].vx + dt*fx[lane];
    const float vy = p[i+lane].vy + dt*fy[lane];
    const float vz = p[i+lane].vz + dt*fz[lane];
    next[i+lane].vx = vx;
    next[i+lane].vy = vy;
    next[i+lane].vz = vz;
    next[i+lane].x = x[lane] + vx*dt;
    next[i+lane].y = y[lane] + vy*dt;
    next[i+lane].z = z[lane] + vz*dt;
  }
}
#endif

/*
 * Read a binary dataset with initilized bodies.
 */
Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  return bodies;
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc,char **argv) {
  int nbodies;
  Body *bodies = read_dataset(&nbodies);
  Body *scratch = (Body *)malloc((size_t)nbodies * sizeof(Body));
  Body *result = bodies;

  if (scratch != NULL) {
#if defined(__aarch64__) && defined(__ARM_NEON)
    const int block_size = 8;
#else
    const int block_size = 4;
#endif
    const int nfull = nbodies / block_size;
    const int nblocks = nfull + (nbodies % block_size != 0);

    #pragma omp parallel if (nblocks >= 4)
    {
      Body *current = bodies;
      Body *next = scratch;

      for (int iter = 0; iter < N_ITER; ++iter) {
        #pragma omp for schedule(static)
        for (int block = 0; block < nblocks; ++block) {
          const int start = block * block_size;
          if (block < nfull) {
#if defined(__aarch64__) && defined(__ARM_NEON)
            advance_eight(current, next, DT, nbodies, start);
#else
            advance_four(current, next, DT, nbodies, start);
#endif
          } else {
            int i = start;
            if (nbodies - i >= 4) {
              advance_four(current, next, DT, nbodies, i);
              i += 4;
            }
            for (; i < nbodies; ++i) {
              advance_one(current, next, DT, nbodies, i);
            }
          }
        }

        /* The worksharing barrier completes next before it becomes current. */
        Body *swap = current;
        current = next;
        next = swap;
      }
    }

    result = (N_ITER % 2 == 0) ? bodies : scratch;
  } else {
    for (int iter = 0; iter < N_ITER; iter++) {
      body_force(bodies, DT, nbodies);
      for (int i = 0; i < nbodies; i++) {
        bodies[i].x += bodies[i].vx * DT;
        bodies[i].y += bodies[i].vy * DT;
        bodies[i].z += bodies[i].vz * DT;
      }
    }
  }

  write_dataset(nbodies, result);
  free(scratch);
  free(bodies);

  exit(EXIT_SUCCESS);
}

"""Bind only already received cold files for the independent audit."""
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
OP = HERE.parents[1]
PREP = OP.parent
DELIVERY = OP / "delivery-only-752546"


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def ref(path):
    assert path.is_file() and not path.is_symlink()
    return {"path": str(path.resolve()), "sha256": sha(path)}


archive = DELIVERY / "delivery-only-752546-752563.tar.gz"
assert sha(archive) == "f402d2b9b319fd271d6f96511dbabfee6ee244bff4d27e11ea865369980190f4"
assert archive.stat().st_size == 1663043
envelope = DELIVERY / "delivery-envelope.json"
assert sha(envelope) == "d1f811bfe93a24943ae607fe781c3534b012f6b7fca286ab76da18cfbce28050"
auditor = HERE / "auditer_q4_froid.py"
assert sha(auditor) == "76ccbf07e6f1fe8ae2468f4536b686cdfec85ccd63a728579b68fe65f493becf"
qualification = OP / "qualification4/qualification-752546.json"
partial = OP / "qualification4/archive-partielle-752546.tar.gz"
assert sha(qualification) == "334d79433d169bad70945af6389ef3830b810d9742d9080a112b4eba03726114"
assert sha(partial) == "523fd8d5f32423d9cc2e2e4680b8aaf74746c78362e86d55e2e2fc460f3c5890" and partial.stat().st_size == 3121
source_review = PREP / "revision-source-lane-r2/revue-independante/REVUE-SOURCE-LANE-R2.json"
integration_review = PREP / "adaptateurs-source-lane-r2/revision-r2-integration/revision-r4-observer-binding/revue-independante/REVUE-INTEGRATION-R4-GO-PREPARATION.json"
assert sha(source_review) == "b903ad78f736fbec86faa47cc24bf99670d5093b9e2367a811a1cc50b5a822d6"
assert sha(integration_review) == "4ed75e15da4e0e3a003e66de5c83d9bc43c5186fb62c53a871b47e4a74cd298b"
value = {"schema": "hpc-forest-lane-r4-cold-audit-input-v1", "archive": ref(archive),
         "delivery_envelope": ref(envelope), "download_receipt": ref(DELIVERY / "archive-download.json"),
         "original_efficiency": ref(OP / "qualification4/efficiency.json"),
         "delivery_efficiency": ref(DELIVERY / "efficiency.json"),
         "original_failure_log": ref(OP / "qualification4/first-log.json"),
         "source_review": ref(source_review), "integration_review": ref(integration_review)}
path = HERE / "entree-recue.json"
with path.open("x", encoding="utf8", newline="\n") as stream:
    stream.write(json.dumps(value, ensure_ascii=False, indent=2) + "\n")
with (HERE / "preuves-locales-qual-partiel-rehashees.json").open("x", encoding="utf8", newline="\n") as stream:
    stream.write(json.dumps({"qualification": ref(qualification), "partial_archive": ref(partial),
                             "delivery_announcement_log": ref(DELIVERY / "first-log.json"),
                             "envelope_download": ref(DELIVERY / "envelope-download.json")}, indent=2) + "\n")
print(json.dumps({"input": ref(path), "auditor": ref(auditor), "archive_bytes": archive.stat().st_size}))

#include <cstdio>
#include <vector>

static inline int readInt() {
    int x = 0;
    char c = getchar_unlocked();
    bool neg = false;
    while (c < '0' || c > '9') {
        if (c == '-') neg = true;
        c = getchar_unlocked();
    }
    while (c >= '0' && c <= '9') {
        x = x * 10 + (c - '0');
        c = getchar_unlocked();
    }
    return neg ? -x : x;
}

int main() {
    int n = readInt();
    int s = readInt();

    const size_t rowLen = (size_t)n;
    std::vector<int> buf((size_t)(s + 1) * n);
    std::vector<long long> col(n, 0);

    // Read first S rows and accumulate column sums.
    for (int r = 0; r < s; ++r) {
        int* row = &buf[(size_t)r * n];
        for (int c = 0; c < n; ++c) {
            int v = readInt();
            row[c] = v;
            col[c] += v;
        }
    }

    long long cur = 0;
    for (int j = 0; j < s; ++j) cur += col[j];
    long long mx = cur;

    const int nrows = n - s + 1;
    const int ncols = n - s + 1;
    const int ringSize = s + 1;

    int oldSlot = 0;
    int newSlot = s % ringSize; // slot for row index s when i=0
    const int* pold = buf.data() + (size_t)oldSlot * n;
    int* pnew = buf.data() + (size_t)newSlot * n;

    for (int i = 0; i < nrows; ++i) {
        // Horizontal sliding window over columns.
        if (cur > mx) mx = cur;
        for (int j = 1; j < ncols; ++j) {
            cur += col[j + s - 1] - col[j - 1];
            if (cur > mx) mx = cur;
        }

        if (i + 1 < nrows) {
            long long deltaFirstS = 0;

            // Read the entering row and update column sums for first S columns.
            int c = 0;
            for (; c + 3 < s; c += 4) {
                int v0 = readInt();
                int v1 = readInt();
                int v2 = readInt();
                int v3 = readInt();
                pnew[c]     = v0;
                pnew[c + 1] = v1;
                pnew[c + 2] = v2;
                pnew[c + 3] = v3;
                long long d0 = (long long)v0 - pold[c];
                long long d1 = (long long)v1 - pold[c + 1];
                long long d2 = (long long)v2 - pold[c + 2];
                long long d3 = (long long)v3 - pold[c + 3];
                col[c]     += d0;
                col[c + 1] += d1;
                col[c + 2] += d2;
                col[c + 3] += d3;
                deltaFirstS += d0 + d1 + d2 + d3;
            }
            for (; c < s; ++c) {
                int v = readInt();
                pnew[c] = v;
                long long d = (long long)v - pold[c];
                col[c] += d;
                deltaFirstS += d;
            }

            // Remaining columns.
            for (; c + 3 < n; c += 4) {
                int v0 = readInt();
                int v1 = readInt();
                int v2 = readInt();
                int v3 = readInt();
                pnew[c]     = v0;
                pnew[c + 1] = v1;
                pnew[c + 2] = v2;
                pnew[c + 3] = v3;
                col[c]     += (long long)v0 - pold[c];
                col[c + 1] += (long long)v1 - pold[c + 1];
                col[c + 2] += (long long)v2 - pold[c + 2];
                col[c + 3] += (long long)v3 - pold[c + 3];
            }
            for (; c < n; ++c) {
                int v = readInt();
                pnew[c] = v;
                col[c] += (long long)v - pold[c];
            }

            cur += deltaFirstS;

            // Advance ring slots for the next row transition.
            if (++oldSlot == ringSize) oldSlot = 0;
            if (++newSlot == ringSize) newSlot = 0;
            pold = buf.data() + (size_t)oldSlot * n;
            pnew = buf.data() + (size_t)newSlot * n;
        }
    }

    printf("%lld\n", mx);
    return 0;
}

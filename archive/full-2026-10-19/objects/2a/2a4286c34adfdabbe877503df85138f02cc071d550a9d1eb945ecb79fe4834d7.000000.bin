        "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<vector<int>> blocked(n);\n    for (int c = 0; c < m; ++c) {\n        int i, j;\n        cin >> i >> j;\n        blocked[i].push_back(j);\n    }\n    for (auto& row : blocked) {\n        sort(row.begin(), row.end());\n        row.erase(unique(row.begin(), row.end()), row.end());\n    }\n\n    vector<int> dp(n, 0);\n    dp[0] = 1;\n    for (int i = 0; i < n; ++i) {\n        int begin = 0;\n        int left = 0;\n        for (int obstacle : blocked[i]) {\n            for (int j = begin; j < obstacle; ++j) {\n                int sum = dp[j] + left;\n                if (sum >= MOD) sum -= MOD;\n                dp[j] = sum;\n                left = sum;\n            }\n            dp[obstacle] = 0;\n            left = 0;\n            begin = obstacle + 1;\n        }\n        for (int j = begin; j < n; ++j) {\n            int sum = dp[j] + left;\n            if (sum >= MOD) sum -= MOD;\n            dp[j] = sum;\n            left = sum;\n        }\n    }\n\n    cout << dp[n - 1] << '\\n';\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }
    ],

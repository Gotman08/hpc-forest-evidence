"""Read-only independent audit of the received Astra source-only archive."""
from __future__ import annotations

import hashlib
import json
import subprocess
import sys
from collections import Counter
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
COMPARE = HERE.parents[1]
STUDY = COMPARE.parent / "HPC-Forest-Etude-2020-2024-r1"
ORIGINAL = COMPARE / "runs/source-only-gpt-6-astra-max"
sys.path.insert(0, str(COMPARE))
from comparison_reception import audit_group, inventory


def read(path):
    return json.loads(path.read_text(encoding="utf-8-sig"))


def sha(path):
    with path.open("rb") as source:
        return hashlib.file_digest(source, "sha256").hexdigest()


def save_new(path, value):
    with path.open("x", encoding="utf-8", newline="\n") as output:
        output.write(json.dumps(value, ensure_ascii=False, indent=2) + "\n")


def descriptor(path):
    return {"path": str(path), "sha256": sha(path)}


def main():
    state = read(COMPARE / "coordinator-state.json")
    group = next(g for g in state["queue"] if g["key"] == "source-only-gpt-6-astra-max")
    assert group["state"] == "received_and_audited"
    assert group["job_id"] == "750122" and group["session_id"] == "aa970cf8bf5d4c1aaa0fdabb21d73a72"
    expected = "bbae4d61c374a740ceadceb27aca4ec1354cc8c2bf6fea86ad3d1619cc449be2"
    archive = ORIGINAL / "results-750122.tar.gz"
    assert sha(archive) == expected
    transfer = read(ORIGINAL / "archive-transfer.json")
    assert transfer["verifie"] and transfer["remote_sha256"] == expected == transfer["empreinte_locale"]
    logs = read(ORIGINAL / "terminal-logs.json")
    assert expected in json.dumps(logs)
    save_new(HERE / "groupe-recu.json", group)
    original_audit = read(ORIGINAL / "audit.json")
    assert original_audit["all_outcomes_accounted_for"] and original_audit["deliveries_reconciled"]
    stop = read(ORIGINAL / "owned-worker-stopped.json")
    assert stop["after_audit"] and stop["after_deliveries"]
    assert stop["audit_sha256"] == sha(ORIGINAL / "audit.json")
    assert stop["all_owned_process_identities_absent_after_stop"]
    destination = HERE / "restauration-neuve"
    assert not destination.exists()
    restore = COMPARE.parent / "Marathon22-DeepSeek-v11/cadre-execution/restaurer-preuves.py"
    with (HERE / "restauration.log").open("xb") as log:
        subprocess.run([sys.executable, "-B", str(restore), str(archive),
                        str(STUDY / "sources-officielles-restauration"), str(destination)],
                       stdout=log, stderr=subprocess.STDOUT, check=True, timeout=600)
    root = destination / "results-750122"
    before = inventory(root)
    original_before = inventory(ORIGINAL / "preuves/results-750122")
    save_new(HERE / "inventaire-avant.json", before)
    assert before == original_before
    audit = audit_group(root, archive, COMPARE / "HPC-Forest-Harnais-Comparaison-r1.zip", group,
                        read(COMPARE / "contrats-reference.json")["subjects"], ORIGINAL / "worker")
    save_new(HERE / "audit-independant.json", audit)
    assert audit["coverage_and_final_confirmations_verified"] and audit["deliveries_reconciled"]
    after = inventory(root)
    save_new(HERE / "inventaire-apres.json", after)
    assert before == after == inventory(ORIGINAL / "preuves/results-750122")
    assert len(before) == 5633 and len(audit["subjects"]) == 15
    statuses = Counter()
    for row in audit["subjects"]:
        statuses.update(row["statuses"])
    usage = audit["local_delivery_reconciliation"]
    assert usage == original_audit["local_delivery_reconciliation"]
    assert usage["requests"] == 101 and usage["native_invocations_observed"] == 98
    assert usage["known_exact_tokens"] == 1856292 and usage["unmeasured_native_invocations"] == 13
    assert usage["expired_without_native_invocation"] == 3 and not usage["total_exact_consumption_available"]
    receipt = {
        "schema": "hpc-forest-source-only-independent-reception-v1", "verified": True,
        "verified_utc": datetime.now(UTC).isoformat(), "job_id": "750122", "arm": "source-only",
        "session_id": group["session_id"], "model": "gpt-6-astra", "effort": "max",
        "archive": descriptor(archive), "archive_bytes": archive.stat().st_size,
        "archive_announced_remote_local_sha256": expected,
        "coordinator_audit": descriptor(ORIGINAL / "audit.json"),
        "independent_audit": descriptor(HERE / "audit-independant.json"),
        "owned_stop": descriptor(ORIGINAL / "owned-worker-stopped.json"),
        "restored_files_unchanged": len(before), "original_restoration_also_unchanged": True,
        "subjects_received_and_audited": 15,
        "modified_programs_confirmed": sum(row["confirmed_gain_fraction"] > 0 for row in audit["subjects"]),
        "baseline_retained_subjects": [row["subject"] for row in audit["subjects"] if row["confirmed_gain_fraction"] == 0],
        "trial_status_counts": dict(statuses), "program_missions": sum(statuses.values()),
        "scored_nodes": sum(row["topology"]["scored_nodes"] for row in audit["subjects"]),
        "published_requests": 101, "native_invocations": 98, "known_exact_tokens": 1856292,
        "unmetered_invocations": 13, "expired_before_invocation": 3,
        "total_exact_consumption_available": False, "all_requests_delivered_and_reconciled": True,
        "no_new_model_call_compilation_or_candidate_execution": True,
        "new_source_only_cells": 15, "source_only_received_cells_cumulative": 30,
        "source_only_300_barrier_passed": False, "causal_harness_advantage_proved": False,
        "article_admission_pending": True,
        "process_stop_method_fully_conformant": False,
        "process_stop_incident": {
            "observed": "The existing coordinator used taskkill /T /F after audit and delivery reconciliation.",
            "preserved_source": descriptor(COMPARE / "coordonner-source-only.py"),
            "recursive_stop_policy_violation": True,
            "foreign_process_termination_established": False,
            "additional_stop_performed_by_this_audit": False,
            "required_action": "Replace the unsafe control path in isolation before the next reception; preserve the live Terra relay."
        }
    }
    save_new(HERE / "reception-verifiee.json", receipt)
    print(json.dumps({k: v for k, v in receipt.items() if not isinstance(v, dict)}, ensure_ascii=True))


if __name__ == "__main__":
    main()

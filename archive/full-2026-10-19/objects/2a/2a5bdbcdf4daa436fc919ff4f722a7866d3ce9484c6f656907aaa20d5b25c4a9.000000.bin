        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n#include <string.h>\n\n#define MAXNUM 100\n#define MAXSTR 50\n#define MAXRESULTS 1000\n\nchar firstHalf[MAXNUM][MAXSTR];\nchar secondHalf[MAXNUM][MAXSTR];\nchar strToTest[MAXSTR];\nlong int result[MAXRESULTS];\nint numPrimes=0;\n\nstatic uint32_t multiply_mod(uint32_t a, uint32_t b, uint32_t modulus)\n{\n  return (uint32_t)(((uint64_t)a * (uint64_t)b) % modulus);\n}\n\nstatic uint32_t power_two_mod(uint32_t exponent, uint32_t modulus)\n{\n  uint32_t bit = UINT32_C(1) << 31;\n  uint32_t x = 2U;\n\n  /* The exponent is positive and the modulus is odd and greater than two. */\n  while ((exponent & bit) == 0U)\n    bit >>= 1;\n  for (bit >>= 1; bit != 0U; bit >>= 1)\n    {\n      x = multiply_mod(x, x, modulus);\n      if ((exponent & bit) != 0U)\n        {\n          uint64_t doubled = (uint64_t)x + x;\n          if (doubled >= modulus)\n            doubled -= modulus;\n          x = (uint32_t)doubled;\n        }\n    }\n  return x;\n}\n\nstatic void power_mod_pair(uint32_t exponent, uint32_t modulus,\n                           uint32_t *power7, uint32_t *power61)\n{\n  uint32_t a = 7U % modulus;\n  uint32_t b = 61U % modulus;\n  uint32_t x = 1U;\n  uint32_t y = 1U;\n\n  /* A witness divisible by the modulus must be skipped. */\n  if (a == 0U)\n    a = 1U;\n  if (b == 0U)\n    b = 1U;\n\n  /* The two lanes are independent; each lane retains its true dependencies. */\n  while (exponent != 0U)\n    {\n      if ((exponent & 1U) != 0U)\n        {\n          x = multiply_mod(x, a, modulus);\n          y = multiply_mod(y, b, modulus);\n        }\n      exponent >>= 1;\n      if (exponent != 0U)\n        {\n          a = multiply_mod(a, a, modulus);\n          b = multiply_mod(b, b, modulus);\n        }\n    }\n  *power7 = x;\n  *power61 = y;\n}\n\nstatic int passes_witness(uint32_t x, uint32_t modulus, unsigned int shifts)\n{\n  unsigned int r;\n\n  if (x == 1U || x == modulus - 1U)\n    return 1;\n  for (r = 1; r < shifts; ++r)\n    {\n      x = multiply_mod(x, x, modulus);\n      if (x == modulus - 1U)\n        return 1;\n      if (x == 1U)\n        return 0;\n    }\n  return 0;\n}\n\nint isprime(long int value)\n{\n  uint32_t n, d;\n  uint32_t power7 = 1U, power61 = 1U;\n  unsigned int shifts = 0;\n\n  if (value < 2)\n    return 0;\n  n = (uint32_t)value;\n  if ((n & 1U) == 0U)\n    return n == 2U;\n  if (n % 3U == 0U) return n == 3U;\n  if (n % 5U == 0U) return n == 5U;\n  if (n % 7U == 0U) return n == 7U;\n  if (n % 11U == 0U) return n == 11U;\n  if (n % 13U == 0U) return n == 13U;\n  if (n % 17U == 0U) return n == 17U;\n  if (n % 19U == 0U) return n == 19U;\n  if (n % 23U == 0U) return n == 23U;\n  if (n % 29U == 0U) return n == 29U;\n  if (n % 31U == 0U) return n == 31U;\n  if (n % 37U == 0U) return n == 37U;\n\n  d = n - 1U;\n  while ((d & 1U) == 0U)\n    {\n      d >>= 1;\n      ++shifts;\n    }\n\n  /* Bases 2, 7 and 61 are deterministic throughout the uint32_t range. */\n  if (!passes_witness(power_two_mod(d, n), n, shifts))\n    return 0;\n  power_mod_pair(d, n, &power7, &power61);\n  return passes_witness(power7, n, shifts) &&\n         passes_witness(power61, n, shifts);\n}\n\nvoid quicksort(long int *primes,int first,int last)\n{ int i, j, pivot;\n  long int temp;\n\n  if (first<last)\n     { pivot=first;\n       i=first;\n       j=last;\n       while(i<j)\n         { while (primes[i]<=primes[pivot]&&i<last)\n             i++;\n           while(primes[j]>primes[pivot])\n             j--;\n           if (i<j)\n              { temp=primes[i];\n                primes[i]=primes[j];\n                primes[j]=temp;\n              }\n         }\n       temp=primes[pivot];\n       primes[pivot]=primes[j];\n       primes[j]=temp;\n       quicksort(primes,first,j-1);\n       quicksort(primes,j+1,last);\n     }\n}\n\n\nint main(int argc,char** argv)\n{ FILE *primesFile;\n  int i=0,j=0,numResults=0;\n  long int primeToTest;\n  primesFile=stdin;\n  fscanf(primesFile,\"%d\\n\",&numPrimes);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",firstHalf[i]);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",secondHalf[i]);\n  fclose(primesFile);\n  for (i=0;i<numPrimes;i++)\n      for (j=0;j<numPrimes;j++)\n          { strcpy(strToTest,firstHalf[i]);\n            strcat(strToTest,secondHalf[j]);\n            primeToTest=atol(strToTest);\n            if (isprime(primeToTest))\n               { result[numResults++]=primeToTest;\n               }\n          }\n  quicksort(result,0,numResults-1);\n  for (i=0;i<numResults;i++)\n      printf(\"%ld\\n\",result[i]);\n  return 0;\n}\n",

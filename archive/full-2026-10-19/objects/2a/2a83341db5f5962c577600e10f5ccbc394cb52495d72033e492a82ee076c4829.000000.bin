        "base_commit": "d4b3054476b945353e1f0def41a0e9429daf4bb9",
        "delegation_parent": "R/G",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Combining the measured top-k heap approach with a shared geometrically grown point arena may reduce both candidate maintenance and per-group allocation overhead while preserving encounter-order ties and the existing vote behavior.",
        "id": "682e90301b9246c4",
        "ordinal": 2,
        "parent_id": null,
        "role": "G",
        "source_commits": [
          "fd61935803dbb1f99e49e03413db2ecc0296fcfc",
          "7f34a4db896f7839e4ba166842c2459bb8e0260e"
        ],
        "sources": [
          "8b22dace973f4eea",

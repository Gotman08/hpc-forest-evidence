    {
      "id": "19c28818d5d24d8d",
      "role": "C",
      "mission": {
        "base_commit": "d4b3054476b945353e1f0def41a0e9429daf4bb9",
        "delegation_parent": "R/C",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Dynamically assigning whole groups can balance uneven group sizes without first flattening the input. Each worker keeps a private bounded max-heap, then a deterministic merge preserves encounter-order ties while avoiding shared updates.",
        "id": "19c28818d5d24d8d",
        "ordinal": 2,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/knn.c"
          ],
          "retained": [
            "Use OpenMP dynamic scheduling over groups and a reduction flag to detect NaN distances.",
            "Maintain a per-thread bounded max-heap of nearest candidates and merge worker heaps after the parallel region.",
            "Order equal-distance candidates by group and point encounter order, then preserve the existing label sorting and vote tie behavior.",
            "Fall back to the original sequential selection when a NaN distance is encountered."
          ]
        },
        "tree_id": "e1:C",

    {
      "id": "4eb62c07382d4ef6",
      "role": "A",
      "mission": {
        "base_commit": "d4b3054476b945353e1f0def41a0e9429daf4bb9",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "A single geometrically grown point arena, with each group retaining an offset until parsing finishes, should reduce allocation fragmentation and make the point scan more contiguous while preserving group and point encounter order.",
        "id": "4eb62c07382d4ef6",
        "ordinal": 2,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/knn.c",
            "src/knn.h"
          ],
          "retained": [
            "Replace one point allocation per group with a shared geometrically grown Point arena; retain offsets during parsing and assign group pointers after the final possible reallocation."
          ]
        },

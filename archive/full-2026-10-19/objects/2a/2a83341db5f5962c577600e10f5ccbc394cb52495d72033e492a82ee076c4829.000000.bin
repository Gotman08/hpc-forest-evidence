        ],
        "transformations": {
          "files": [
            "src/knn.c",
            "src/knn.h"
          ],
          "retained": [
            "Replace sorted-array candidate insertion with a contiguous max-heap ordered by distance and encounter order; retain the sequential selection fallback when a distance is NaN.",
            "Replace one allocation per group with a shared geometrically grown Point arena, recording group offsets and assigning pointers after parsing is complete.",
            "Preserve missing-label placeholders, label sorting, vote tie behavior, and free temporary candidate storage before returning."
          ]
        },

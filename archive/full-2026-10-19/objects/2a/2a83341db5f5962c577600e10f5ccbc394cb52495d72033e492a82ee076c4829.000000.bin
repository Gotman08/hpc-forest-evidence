    {
      "id": "8b22dace973f4eea",
      "role": "G",
      "mission": {
        "base_commit": "d4b3054476b945353e1f0def41a0e9429daf4bb9",
        "delegation_parent": "R/G",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "A stable contiguous max-heap reduces top-k maintenance from O(k) shifting to O(log k) per candidate while preserving encounter-order ties and the existing label vote behavior.",
        "id": "8b22dace973f4eea",
        "ordinal": 1,
        "parent_id": null,
        "role": "G",
        "source_commits": [
          "8bac186429fc1075fce51f1b9c47230319ed2f0b"
        ],
        "sources": [
          "98908818a2b8452a"
        ],
        "transformations": {
          "files": [
            "src/knn.c"
          ],
          "retained": [
            "Replace sorted-array top-k insertion with a contiguous max-heap, reducing candidate maintenance from O(k) shifting to O(log k) sift operations.",
            "Use encounter order to retain stable equal-distance selection; preserve label sorting and its existing vote tie behavior.",
            "Free temporary top-k storage before returning, supporting repeated calls without accumulating these allocations."
          ]
        },
        "tree_id": "e1:G",

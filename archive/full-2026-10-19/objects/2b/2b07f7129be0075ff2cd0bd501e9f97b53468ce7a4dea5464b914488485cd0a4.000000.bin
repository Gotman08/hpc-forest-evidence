"""Freeze the pre-hello argument refusal after current absence, without any restart."""
from datetime import UTC, datetime
from pathlib import Path
import hashlib
import json

HERE = Path(__file__).resolve().parent
BASE = HERE.parents[2]
LAUNCH = BASE / 'outputs/HPC-Forest-Primes-Natif-Lancement-r2e'
START = LAUNCH / 'revision-r1/helper-lancement-possedes/lancement_reel_01'
OUT = HERE / 'incident-argv-20261018T1316'
OUT.mkdir(exist_ok=False)

def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

def ref(path):
    return {'path': str(path.resolve()), 'sha256': sha(path)}

def read(path):
    return json.loads(path.read_text(encoding='utf-8-sig'))

def inventory(folder):
    result = {}
    for path in sorted(folder.rglob('*')):
        assert not path.is_symlink()
        if path.is_file():
            result[path.relative_to(folder).as_posix()] = {'sha256': sha(path), 'bytes': path.stat().st_size}
    return result

census = HERE / 'apres-refus-parser-01-cim.json'
assert sha(census) == '738244aac7977ce02cfd1eec1e49575bdacda09683882b5df7d0d7b387092e89'
rows = read(census)['rows']
launch = read(START / 'LANCEMENTS-POSSEDES-RECUS.json')
assert launch['verified'] is True and len(launch['workers']) == 3
records = []
for worker in launch['workers']:
    for identity in worker['full_identities']:
        assert not any(all(row.get(key) == identity[key] for key in
            ('ProcessId', 'ParentProcessId', 'ExecutablePath', 'CommandLine', 'CreationDate')) for row in rows)
    session, model = worker['session_id'], worker['model']
    cache = LAUNCH / ('worker-' + session)
    before = inventory(cache)
    assert set(before) == {'CELL-BINDING.json'}, 'Unexpected cache requires additional reconciliation'
    target = OUT / session
    target.mkdir(exist_ok=False)
    (target / 'CELL-BINDING.json').write_bytes((cache / 'CELL-BINDING.json').read_bytes())
    stderr = START / (model + '.stderr.log')
    raw = stderr.read_bytes()
    text = raw.decode('utf-8', errors='strict')
    assert 'error: unrecognized arguments: --cli-policy ' in text and '--cli-policy-sha256 ' in text
    (target / 'worker-start.stderr').write_bytes(raw)
    assert before == inventory(cache) and sha(target / 'CELL-BINDING.json') == sha(cache / 'CELL-BINDING.json')
    records.append({'model': model, 'job_id': worker['job_id'], 'session_id': session,
        'all_two_owned_identities_absent_in_current_complete_census': True,
        'cache_before_after_identical': before, 'snapshot': inventory(target),
        'stderr': ref(stderr), 'readiness_or_OWNER_or_claim_or_response_present': False,
        'frontend_research_invocations': 0, 'native_normal_or_evaluation_proved': False})
report = {'schema': 'hpc-forest-r2e-confirmed-prehello-argv-interface-failure-v1',
    'verified': True, 'recorded_at_utc': datetime.now(UTC).isoformat(),
    'scope_id': 'hpc-forest-primes-native-max-r2e',
    'source_zip_sha256': 'f15b840cca876a4c465775f5553a0eaa539a9b98e56fe942136a1fcbde9b86b9',
    'cause': 'R2 wrapper accepts its two private flags, then inherited codex_worker.main reparses the unchanged sys.argv and refuses them before constructing Worker or hello.',
    'six_owned_identities_absent': True, 'current_census': ref(census),
    'original_launch_receipt': ref(START / 'LANCEMENTS-POSSEDES-RECUS.json'),
    'records': records, 'research_frontend_invocations': 0,
    'version_login_MCP_worker_hello_not_reached': True,
    'no_stop_or_restart_or_global_or_source_mutation': True,
    'allocated_backends_not_yet_terminal_or_received': True,
    'backend_request_counts_pending_real_reception': None,
    'next_correction_isolated_scope': 'hpc-forest-primes-native-max-r2f',
    'old_calls_or_nonce_or_candidates_replayed': False}
path = OUT / 'INCIDENT-VERIFIE-AVANT-INFERENCE.json'
with path.open('x', encoding='utf-8') as stream:
    json.dump(report, stream, indent=2, ensure_ascii=False)
print(json.dumps({'verified': True, 'receipt': ref(path), 'frontend_invocations': 0,
                  'backend_terminal_reception_still_required': True}))

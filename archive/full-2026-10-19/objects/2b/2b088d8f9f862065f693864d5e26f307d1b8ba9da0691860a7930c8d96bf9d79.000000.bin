#include <algorithm>
#include <cstddef>
#include <iostream>
#include <iterator>
#include <string>

namespace
{
bool is_whitespace(char c)
{
    return (c == ' ')
        || (c == '\n')
        || (c == '\r')
        || (c == '\t')
        || (c == '\f')
        || (c == '\v');
}

class BufferedOutput
{
public:
    BufferedOutput() : used_(0) {}

    void append_permutation(std::string const& permutation)
    {
        append_pair('[', ' ');

        char const* input = permutation.data();
        std::size_t remaining = permutation.size();
        while (remaining != 0) {
            if (sizeof(buffer_) - used_ < 2) {
                flush();
            }

            std::size_t const available_pairs =
                (sizeof(buffer_) - used_) / 2;
            std::size_t const count =
                remaining < available_pairs ? remaining : available_pairs;
            char* target = buffer_ + used_;
            for (std::size_t i = 0; i != count; ++i) {
                target[2 * i] = input[i];
                target[2 * i + 1] = ' ';
            }
            used_ += count * 2;
            input += count;
            remaining -= count;
        }

        append_pair(']', '\n');
    }

    void flush()
    {
        if (used_ != 0) {
            std::cout.write(buffer_, static_cast<std::streamsize>(used_));
            used_ = 0;
        }
    }

private:
    void append_pair(char first, char second)
    {
        if (sizeof(buffer_) - used_ < 2) {
            flush();
        }
        buffer_[used_++] = first;
        buffer_[used_++] = second;
    }

    char buffer_[64 * 1024];
    std::size_t used_;
};

std::string read_text_from_stdin()
{
    std::istreambuf_iterator<char> begin(std::cin);
    std::istreambuf_iterator<char> end;
    std::string text(begin, end);
    text.erase(std::remove_if(text.begin(), text.end(), is_whitespace),
               text.end());
    return text;
}

void generate_permutations(std::string& text, BufferedOutput& output)
{
    if (text.empty()) {
        return;
    }

    std::sort(text.begin(), text.end());
    do {
        output.append_permutation(text);
    } while (std::next_permutation(text.begin(), text.end()));
}
}

int main()
{
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(nullptr);

    std::string text = read_text_from_stdin();
    BufferedOutput output;
    generate_permutations(text, output);
    output.flush();
    std::cout.flush();
    return 0;
}

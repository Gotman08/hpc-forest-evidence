"""Immutable candidate source archive for review; no execution or native admission."""
import difflib
import hashlib
import json
import zipfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
BASE = HERE.parents[2]
PROJECT = BASE / "work/hpc-forest-primes-natif-relance-r2e/project"
OLD = BASE / "work/hpc-forest-primes-native-max-r2d/project"
DELIVERY = HERE / "candidats/revision-r1"
assert not DELIVERY.exists()
baseline = json.loads((HERE / "COPIE-SOURCE105-VERIFIEE.json").read_text("utf8"))


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def ref(path):
    return {"path": str(path.resolve()), "sha256": sha(path)}


def save(name, value):
    with (DELIVERY / name).open("x", encoding="utf8") as output:
        output.write(json.dumps(value, indent=2) + "\n")


paths = list(PROJECT.rglob("*"))
assert not any(path.is_symlink() or getattr(path, "is_junction", lambda: False)() for path in (PROJECT, *paths))
actual = {path.relative_to(PROJECT).as_posix(): sha(path) for path in paths if path.is_file()}
expected_changed = {"src/hpc_forest/codex_process.py", "src/hpc_forest/r2max_worker.py", "src/hpc_forest/native_r2max.py",
                    "src/hpc_forest/r2max_first_start.py", "src/hpc_forest/core.py", "examples/marathon22/primes_native_max.py"}
expected_added = {"tests/test_codex_cli_diagnostics_r2e.py", "tests/test_first_batch_gate_r2e.py", "tests/test_owned_timeout_r2e.py"}
assert len(actual) == 108 and set(actual) - set(baseline["files"]) == expected_added
changed = {name for name in baseline["files"] if actual[name] != baseline["files"][name]}
assert changed == expected_changed
assert all(sha(OLD / name) == expected for name, expected in baseline["files"].items())
assert actual["src/hpc_forest/core.py"] == "ec3fcfba5d8c332de2f5f95843b0bf0f32e296935ee481ffc789fd336b4ef7b8"
assert actual["tests/test_owned_timeout_r2e.py"] == "6fd2102b8e189b80952d8a0ae91a0501ed2c89eaa0f7bc08f7d1331a1cb4eec4"
assert not any(b"C:/Users/nicol/" in (PROJECT / name).read_bytes() for name in expected_changed | expected_added)
DELIVERY.mkdir(parents=True)
save("source-manifest-r2e.json", actual)
save("runtime-manifest-r2max.json", actual)
diff = []
for name in sorted(changed | expected_added):
    before = (OLD / name).read_text("utf8").splitlines(keepends=True) if name in changed else []
    after = (PROJECT / name).read_text("utf8").splitlines(keepends=True)
    diff.extend(difflib.unified_diff(before, after, fromfile="R2d/" + name, tofile="R2e/" + name))
(DELIVERY / "DIFF-SOURCE-R2D-R2E.patch").write_text("".join(diff), encoding="utf8", newline="\n")
original_zip = Path(baseline["source_zip"]["path"])
with zipfile.ZipFile(original_zip) as old_zip:
    metadata = {entry.filename.removeprefix("HPC-Forest/"): entry for entry in old_zip.infolist() if not entry.is_dir()}
archive = DELIVERY / "HPC-Forest-Primes-Natif-MAX-r2e.zip"
with zipfile.ZipFile(archive, "x", compression=zipfile.ZIP_DEFLATED, compresslevel=9) as new_zip:
    for name in sorted(actual):
        info = zipfile.ZipInfo("HPC-Forest/" + name, (2026, 10, 18, 0, 0, 0))
        info.compress_type = zipfile.ZIP_DEFLATED
        info.external_attr = metadata[name].external_attr if name in metadata else (0o100644 << 16)
        new_zip.writestr(info, (PROJECT / name).read_bytes())
with zipfile.ZipFile(archive) as zipped:
    restored = {entry.filename.removeprefix("HPC-Forest/"): hashlib.sha256(zipped.read(entry)).hexdigest()
                for entry in zipped.infolist() if not entry.is_dir()}
assert restored == actual
save("DELTA-FERME-SOURCE.json", {
    "schema": "hpc-forest-r2e-source-closed-delta-v1", "verified": True,
    "original_source_zip": baseline["source_zip"], "source_files": 108,
    "unchanged_parent_sources": 99, "old105_source_files_still_unchanged": True,
    "changed": {name: {"before": baseline["files"][name], "after": actual[name]} for name in sorted(changed)},
    "added": {name: actual[name] for name in sorted(expected_added)},
    "host_skill_path_metadata_embedded_or_exported": False,
    "algorithms_oracles_finite_cases_compiler_flags_or_budgets_modified": False,
    "Controller_or_MCTS_or_initial_batch_plan_modified": False,
    "CLI_or_model_invoked": False, "native_admission": False,
})
save("LIVRAISON-SOURCE-CANDIDATE-POUR-REVUE.json", {
    "schema": "hpc-forest-r2e-immutable-source-review-candidate-v1", "verified": False,
    "status": "immutable candidate revision-r1 awaiting independent review and a new allocated Q",
    "source_zip": ref(archive), "runtime_manifest": ref(DELIVERY / "runtime-manifest-r2max.json"),
    "source_manifest": ref(DELIVERY / "source-manifest-r2e.json"), "closed_delta": ref(DELIVERY / "DELTA-FERME-SOURCE.json"),
    "diff": ref(DELIVERY / "DIFF-SOURCE-R2D-R2E.patch"), "source_files": 108,
    "scope_id": "hpc-forest-primes-native-max-r2e", "efforts": ["max"],
    "neutral_tests": {"diagnostics_policy_hold_projection": 48, "first_batch_gate": 20,
                      "passed_by_this_agent": 68, "owned_timeout_reported_by_other_owner": 6},
    "test_log": ref(HERE / "tests-cli-gate-final.log"), "ruff": ref(HERE / "ruff-sources-stables.log"),
    "first_local_refusals_preserved": ["PREMIER-REFUS-COPIE.json", "tests-cli-r3.log", "ruff-interface-r1.log"],
    "runtime_CLI_key_recognition_or_prebudget_effect_proved": False,
    "global_role_permission_or_quarantine_done_by_this_agent": False,
    "old_calls_or_candidates_or_nonce_imported": False,
    "native_or_ARM64_qualification_admitted": False,
    "plan_and_bundle_owner": "/root/cli_task_scope_options (separate preparation)",
    "new_allocated_Q_and_actual_first_start_reception_before_extension_required": True,
    "source_work_tree": str(PROJECT), "candidate_zip_must_never_be_overwritten": True,
})
assert actual == {path.relative_to(PROJECT).as_posix(): sha(path) for path in PROJECT.rglob("*") if path.is_file()}
print(json.dumps({"delivery": ref(DELIVERY / "LIVRAISON-SOURCE-CANDIDATE-POUR-REVUE.json"),
                  "source_zip": ref(archive), "runtime_manifest": ref(DELIVERY / "runtime-manifest-r2max.json"),
                  "changed": len(changed), "added": len(expected_added), "files": len(actual)}, indent=2))

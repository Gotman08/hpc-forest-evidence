{
  "src/knn.c": "#include \"knn.h\"\n\n#include <limits.h>\n#include <math.h>\n\n#define DISTANCE_BLOCK_POINTS 256\n\ntypedef struct {\n    float distance;\n    size_t encounter;\n    char label;\n} Neighbor;\n\nstatic int is_farther(const Neighbor *a, const Neighbor *b) {\n    return a->distance > b->distance ||\n           (a->distance == b->distance && a->encounter > b->encounter);\n}\n\nstatic void heap_insert(Neighbor *heap, int position, Neighbor neighbor) {\n    while (position != 0) {\n        int parent = (position - 1) / 2;\n        if (!is_farther(&neighbor, &heap[parent])) {\n            break;\n        }\n        heap[position] = heap[parent];\n        position = parent;\n    }\n    heap[position] = neighbor;\n}\n\nstatic void heap_replace_root(Neighbor *heap, int length, Neighbor neighbor) {\n    int position = 0;\n\n    for (;;) {\n        int left = position * 2 + 1;\n        if (left >= length) {\n            break;\n        }\n\n        int child = left;\n        int right = left + 1;\n        if (right < length && is_farther(&heap[right], &heap[left])) {\n            child = right;\n        }\n\n        if (!is_farther(&heap[child], &neighbor)) {\n            break;\n        }\n\n        heap[position] = heap[child];\n        position = child;\n    }\n\n    heap[position] = neighbor;\n}\n\nstatic char knn_reference(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *)malloc(sizeof(char) * k);\n    float *distances = (float *)malloc(sizeof(float) * k);\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    Neighbor *heap = (Neighbor *)malloc(sizeof(Neighbor) * k);\n    int frequencies[UCHAR_MAX + 1] = {0};\n    const float target_x = to_evaluate.x;\n    const float target_y = to_evaluate.y;\n    int heap_length = 0;\n    size_t encounter = 0;\n\n    for (int group_index = 0; group_index < n_groups; group_index++) {\n        const Group group = groups[group_index];\n        const Point *restrict points = group.points;\n\n        for (int base = 0; base < group.length; base += DISTANCE_BLOCK_POINTS) {\n            float distance_block[DISTANCE_BLOCK_POINTS];\n            int block_length = group.length - base;\n            if (block_length > DISTANCE_BLOCK_POINTS) {\n                block_length = DISTANCE_BLOCK_POINTS;\n            }\n\n#pragma GCC ivdep\n            for (int offset = 0; offset < block_length; offset++) {\n                const Point point = points[base + offset];\n                const float dx = point.x - target_x;\n                const float dy = point.y - target_y;\n                distance_block[offset] = dx * dx + dy * dy;\n            }\n\n            for (int offset = 0; offset < block_length; offset++, encounter++) {\n                const float distance = distance_block[offset];\n                Neighbor neighbor;\n\n                if (isnan(distance)) {\n                    free(heap);\n                    return knn_reference(n_groups, groups, k, to_evaluate);\n                }\n\n                neighbor.distance = distance;\n                neighbor.encounter = encounter;\n                neighbor.label = group.label;\n\n                if (heap_length < k) {\n                    heap_insert(heap, heap_length, neighbor);\n                    heap_length++;\n                } else if (distance < heap[0].distance) {\n                    heap_replace_root(heap, heap_length, neighbor);\n                }\n            }\n        }\n    }\n\n    for (int i = 0; i < heap_length; i++) {\n        frequencies[(unsigned char)heap[i].label]++;\n    }\n    if (heap_length < k) {\n        frequencies[(unsigned char)(char)-1] += k - heap_length;\n    }\n\n    char most_frequent = (char)CHAR_MIN;\n    int most_frequent_count = -1;\n    for (int value = CHAR_MIN;; value++) {\n        const char label = (char)value;\n        const int count = frequencies[(unsigned char)label];\n        if (count > most_frequent_count) {\n            most_frequent = label;\n            most_frequent_count = count;\n        }\n        if (value == CHAR_MAX) {\n            break;\n        }\n    }\n\n    free(heap);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n\n    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
  "src/knn.h": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}"
}

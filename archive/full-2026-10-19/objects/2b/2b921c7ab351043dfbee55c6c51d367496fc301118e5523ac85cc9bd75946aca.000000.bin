{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <float.h>\n#include <stdint.h>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nenum { TARGET_LANES = 4 };\n\n#if defined(__aarch64__)\n/*\n * Two FP32 Newton steps leave relative error below 2^-20 over the\n * finite input range used here. One FP64 step reduces it below 2^-38.\n * The wider interval below also covers rounding in the reference's\n * double sqrt/divide. Accept a result only when both endpoints round\n * to the same float; otherwise evaluate the original expression.\n */\n#if defined(__GNUC__) || defined(__clang__)\n__attribute__((always_inline))\n#endif\nstatic inline float32x4_t rounded_inverse_distance(float32x4_t distance) {\n  const uint32x4_t domain = vandq_u32(\n      vcgeq_f32(distance, vdupq_n_f32(SOFTENING)),\n      vcleq_f32(distance, vdupq_n_f32(FLT_MAX)));\n  const float32x4_t d = vbslq_f32(domain, distance, vdupq_n_f32(1.0f));\n\n  float32x4_t r = vrsqrteq_f32(d);\n  r = vmulq_f32(r, vrsqrtsq_f32(vmulq_f32(d, r), r));\n  r = vmulq_f32(r, vrsqrtsq_f32(vmulq_f32(d, r), r));\n\n  const float64x2_t d0 = vcvt_f64_f32(vget_low_f32(d));\n  const float64x2_t d1 = vcvt_f64_f32(vget_high_f32(d));\n  float64x2_t r0 = vcvt_f64_f32(vget_low_f32(r));\n  float64x2_t r1 = vcvt_f64_f32(vget_high_f32(r));\n  r0 = vmulq_f64(r0, vrsqrtsq_f64(vmulq_f64(d0, r0), r0));\n  r1 = vmulq_f64(r1, vrsqrtsq_f64(vmulq_f64(d1, r1), r1));\n\n  const float64x2_t lower_scale = vdupq_n_f64(1.0 - 0x1p-36);\n  const float64x2_t upper_scale = vdupq_n_f64(1.0 + 0x1p-36);\n  const float32x4_t lower = vcombine_f32(\n      vcvt_f32_f64(vmulq_f64(r0, lower_scale)),\n      vcvt_f32_f64(vmulq_f64(r1, lower_scale)));\n  const float32x4_t upper = vcombine_f32(\n      vcvt_f32_f64(vmulq_f64(r0, upper_scale)),\n      vcvt_f32_f64(vmulq_f64(r1, upper_scale)));\n  const uint32x4_t certain = vandq_u32(domain, vceqq_f32(lower, upper));\n\n  if (__builtin_expect(vminvq_u32(certain) != UINT32_MAX, 0)) {\n    float input[4] __attribute__((aligned(16)));\n    float output[4] __attribute__((aligned(16)));\n    uint32_t accepted[4] __attribute__((aligned(16)));\n    vst1q_f32(input, distance);\n    vst1q_f32(output, lower);\n    vst1q_u32(accepted, certain);\n    for (int lane = 0; lane < 4; ++lane) {\n      if (!accepted[lane]) {\n        output[lane] = 1 / sqrt(input[lane]);\n      }\n    }\n    return vld1q_f32(output);\n  }\n\n  return lower;\n}\n#endif\n\n/*\n * SIMD lanes represent independent targets, not partial force sums.\n * Every target still accumulates sources in increasing j order.\n * Distance expressions and force updates retain their original order.\n */\n#if defined(__GNUC__) && !defined(__clang__)\n__attribute__((noinline, optimize(\"no-math-errno\")))\n#endif\nstatic void body_force_tile(Body *p, float dt, int n, int base) {\n  float x[TARGET_LANES] __attribute__((aligned(16)));\n  float y[TARGET_LANES] __attribute__((aligned(16)));\n  float z[TARGET_LANES] __attribute__((aligned(16)));\n  float fx[TARGET_LANES] __attribute__((aligned(16)));\n  float fy[TARGET_LANES] __attribute__((aligned(16)));\n  float fz[TARGET_LANES] __attribute__((aligned(16)));\n  float dx[TARGET_LANES] __attribute__((aligned(16)));\n  float dy[TARGET_LANES] __attribute__((aligned(16)));\n  float dz[TARGET_LANES] __attribute__((aligned(16)));\n  float sqrd[TARGET_LANES] __attribute__((aligned(16)));\n  float inv[TARGET_LANES] __attribute__((aligned(16)));\n\n  #pragma omp simd simdlen(4) aligned(x,y,z,fx,fy,fz:16)\n  for (int lane = 0; lane < TARGET_LANES; ++lane) {\n    x[lane] = p[base + lane].x;\n    y[lane] = p[base + lane].y;\n    z[lane] = p[base + lane].z;\n    fx[lane] = 0.0f;\n    fy[lane] = 0.0f;\n    fz[lane] = 0.0f;\n  }\n\n  for (int j = 0; j < n; ++j) {\n    const float sx = p[j].x;\n    const float sy = p[j].y;\n    const float sz = p[j].z;\n\n    #pragma omp simd simdlen(4) aligned(x,y,z,dx,dy,dz,sqrd:16)\n    for (int lane = 0; lane < TARGET_LANES; ++lane) {\n      float delta_x = sx - x[lane];\n      float delta_y = sy - y[lane];\n      float delta_z = sz - z[lane];\n      dx[lane] = delta_x;\n      dy[lane] = delta_y;\n      dz[lane] = delta_z;\n      sqrd[lane] = delta_x*delta_x + delta_y*delta_y\n                 + delta_z*delta_z + SOFTENING;\n    }\n\n#if defined(__aarch64__)\n    vst1q_f32(inv, rounded_inverse_distance(vld1q_f32(sqrd)));\n#else\n    #pragma omp simd simdlen(4) aligned(sqrd,inv:16)\n    for (int lane = 0; lane < TARGET_LANES; ++lane) {\n      inv[lane] = 1 / sqrt(sqrd[lane]);\n    }\n#endif\n\n    #pragma omp simd simdlen(4) aligned(dx,dy,dz,inv,fx,fy,fz:16)\n    for (int lane = 0; lane < TARGET_LANES; ++lane) {\n      float inv_dist = inv[lane];\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n      fx[lane] += dx[lane] * inv_dist3;\n      fy[lane] += dy[lane] * inv_dist3;\n      fz[lane] += dz[lane] * inv_dist3;\n    }\n  }\n\n  #pragma omp simd simdlen(4) aligned(fx,fy,fz:16)\n  for (int lane = 0; lane < TARGET_LANES; ++lane) {\n    p[base + lane].vx += dt*fx[lane];\n    p[base + lane].vy += dt*fy[lane];\n    p[base + lane].vz += dt*fz[lane];\n  }\n}\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system. Positions remain read-only throughout this phase.\n */\nvoid body_force(Body *p, float dt, int n) {\n  const int full_tiles = n / TARGET_LANES;\n\n  #pragma omp parallel for schedule(static)\n  for (int tile = 0; tile < full_tiles; ++tile) {\n    body_force_tile(p, dt, n, tile * TARGET_LANES);\n  }\n\n  for (int i = full_tiles * TARGET_LANES; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Four-target SIMD with mixed-precision NEON reciprocal-square-root refinement and interval certification can replace most double sqrt/divide operations while preserving their rounded float results and ordered force sums.",
  "notes": "Not executed. Preserves OpenMP partitioning, scalar tails, repeated-call behavior and binary I/O; uncertified lanes use the original expression.",

          "depth": 1,
          "epoch": 1,
          "hypothesis": "A contiguous one-row DP improves memory locality and avoids the quadratic blocked-cell matrix; when the deduplicated obstacle count is small, a sparse combinatorial recurrence avoids scanning the whole grid.",
          "id": "1f9c4d8571df43cb",
          "ordinal": 1,

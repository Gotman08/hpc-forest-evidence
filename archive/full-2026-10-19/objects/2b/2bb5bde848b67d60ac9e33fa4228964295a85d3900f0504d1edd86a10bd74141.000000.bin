oid body_force(float * restrict x, float * restrict y, float * restrict z,\\n+                float * restrict vx, float * restrict vy, float * restrict vz,\\n+                float dt, int n) {\\n+  /* Target bodies are independent; preserve each target's ordered j sum. */\\n+#pragma GCC ivdep\\n   for (int i = 0; i < n; ++i) {\\n-    float fx = 0.0f; \\n-    float fy = 0.0f; \\n+    float fx = 0.0f;\\n+    float fy = 0.0f;\\n     float fz = 0.0f;\\n \\n     for (int j = 0; j < n; j++) {\\n-      float dx = p[j].x - p[i].x;\\n-      float dy = p[j].y - p[i].y;\\n-      float dz = p[j].z - p[i].z;\\n+      float dx = x[j] - x[i];\\n+      float dy = y[j] - y[i];\\n+      float dz = z[j] - z[i];\\n       float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n       float inv_dist = 1 / sqrt(sqrd_dist);\\n       float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n \\n-      fx += dx * inv_dist3; \\n-      fy += dy * inv_dist3; \\n+      fx += dx * inv_dist3;\\n+      fy += dy * inv_dist3;\\n       fz += dz * inv_dist3;\\n     }\\n \\n-    p[i].vx += dt*fx; \\n-    p[i].vy += dt*fy; \\n-    p[i].vz += dt*fz;\\n+    vx[i] += dt*fx;\\n+    vy[i] += dt*fy;\\n+    vz[i] += dt*fz;\\n   }\\n }\\n \\n@@ -76,24 +81,63 @@ int main(int argc,char **argv) {\\n   int nbodies;\\n \\n   Body *bodies = read_dataset(&nbodies);\\n+  size_t n = (size_t)nbodies;\\n+  if (n > (size_t)-1 / (6 * sizeof(float))) {\\n+    fprintf(stderr, \\\"\\\\nError allocating coordinate arrays\\\\n\\\");\\n+    free(bodies);\\n+    exit(EXIT_FAILURE);\\n+  }\\n+  float *state = (float *)malloc(n * 6 * sizeof(float));\\n+  if (state == NULL) {\\n+    fprintf(stderr, \\\"\\\\nError allocating coordinate arrays\\\\n\\\");\\n+    free(bodies);\\n+    exit(EXIT_FAILURE);\\n+  }\\n+\\n+  /* Unpack once into six contiguous fields for the repeated simulation. */\\n+  float *x = state;\\n+  float *y = x + n;\\n+  float *z = y + n;\\n+  float *vx = z + n;\\n+  float *vy = vx + n;\\n+  float *vz = vy + n;\\n+  for (i
#include <algorithm>
#include <iostream>
#include <utility>
#include <vector>

using namespace std;

static const long long MOD = 1000000007LL;

static long long modPow(long long base, long long exponent) {
    long long result = 1;
    while (exponent > 0) {
        if (exponent & 1LL) result = result * base % MOD;
        base = base * base % MOD;
        exponent >>= 1LL;
    }
    return result;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) return 0;

    vector<pair<int, int>> obstacles;
    obstacles.reserve(m);
    bool blockedStart = false;
    bool blockedEnd = false;
    for (int i = 0; i < m; ++i) {
        int row, col;
        cin >> row >> col;
        obstacles.emplace_back(row, col);
        if (row == 0 && col == 0) blockedStart = true;
        if (row == n - 1 && col == n - 1) blockedEnd = true;
    }

    if (blockedStart || blockedEnd) {
        cout << 0 << '\n';
        return 0;
    }

    sort(obstacles.begin(), obstacles.end());
    obstacles.erase(unique(obstacles.begin(), obstacles.end()), obstacles.end());

    const int maxSteps = 2 * (n - 1);
    vector<long long> factorial(maxSteps + 1), inverseFactorial(maxSteps + 1);
    factorial[0] = 1;
    for (int i = 1; i <= maxSteps; ++i)
        factorial[i] = factorial[i - 1] * i % MOD;
    inverseFactorial[maxSteps] = modPow(factorial[maxSteps], MOD - 2);
    for (int i = maxSteps; i > 0; --i)
        inverseFactorial[i - 1] = inverseFactorial[i] * i % MOD;

    auto pathsBetween = [&](int row1, int col1, int row2, int col2) {
        int down = row2 - row1;
        int right = col2 - col1;
        int steps = down + right;
        return factorial[steps] * inverseFactorial[down] % MOD * inverseFactorial[right] % MOD;
    };

    // Each predecessor contribution is independent. Batches of 64 keep the
    // SIMD reduction sum safely below signed 64-bit overflow; obstacle order
    // remains sequential because each ways[i] depends on earlier obstacles.
    vector<long long> ways(obstacles.size());
    for (size_t i = 0; i < obstacles.size(); ++i) {
        const int row = obstacles[i].first;
        const int col = obstacles[i].second;
        long long total = pathsBetween(0, 0, row, col);

        for (size_t begin = 0; begin < i; begin += 64) {
            const size_t end = min(i, begin + 64);
            long long partial = 0;
#pragma omp simd reduction(+:partial)
            for (size_t j = begin; j < end; ++j) {
                const int prevRow = obstacles[j].first;
                const int prevCol = obstacles[j].second;
                if (prevRow <= row && prevCol <= col) {
                    const long long contribution =
                        pathsBetween(prevRow, prevCol, row, col) * ways[j] % MOD;
                    partial += contribution;
                }
            }
            total = (total - partial % MOD + MOD) % MOD;
        }
        ways[i] = total;
    }

    long long answer = pathsBetween(0, 0, n - 1, n - 1);
    for (size_t begin = 0; begin < obstacles.size(); begin += 64) {
        const size_t end = min(obstacles.size(), begin + 64);
        long long partial = 0;
#pragma omp simd reduction(+:partial)
        for (size_t j = begin; j < end; ++j) {
            const int row = obstacles[j].first;
            const int col = obstacles[j].second;
            if (row <= n - 1 && col <= n - 1) {
                const long long contribution =
                    pathsBetween(row, col, n - 1, n - 1) * ways[j] % MOD;
                partial += contribution;
            }
        }
        answer = (answer - partial % MOD + MOD) % MOD;
    }

    cout << answer << '\n';
    return 0;
}

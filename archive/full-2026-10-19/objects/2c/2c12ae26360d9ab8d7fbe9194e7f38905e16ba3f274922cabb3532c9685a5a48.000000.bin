      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <ctype.h>\n#include <limits.h>\n#include <string.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nstatic char *knn_input_data;\nstatic size_t knn_input_first;\nstatic size_t knn_input_last;\nstatic size_t knn_input_capacity;\n\n/* Retain only an unfinished token when refilling the contiguous window. */\nstatic int knn_input_refill(void) {\n    if (knn_input_capacity == 0) {\n        knn_input_capacity = 16385;\n        knn_input_data = (char *)malloc(knn_input_capacity);\n        if (!knn_input_data) on_error();\n    }\n\n    size_t remaining = knn_input_last - knn_input_first;\n    if (knn_input_first != 0 && remaining != 0)\n        memmove(knn_input_data, knn_input_data + knn_input_first, remaining);\n    knn_input_first = 0;\n    knn_input_last = remaining;\n\n    if (knn_input_last == knn_input_capacity - 1) {\n        if (knn_input_capacity > (size_t)-1 / 2) on_error();\n        size_t capacity = knn_input_capacity * 2;\n        char *data = (char *)realloc(knn_input_data, capacity);\n        if (!data) on_error();\n        knn_input_data = data;\n        knn_input_capacity = capacity;\n    }\n\n    size_t added = fread(knn_input_data + knn_input_last, 1,\n                         knn_input_capacity - knn_input_last - 1, stdin);\n    knn_input_last += added;\n    knn_input_data[knn_input_last] = '\\0';\n    return added != 0;\n}\n\nstatic int knn_input_peek(void) {\n    if (knn_input_first == knn_input_last && !knn_input_refill())\n        return EOF;\n    return (unsigned char)knn_input_data[knn_input_first];\n}\n\nstatic int knn_input_take(void) {\n    int c = knn_input_peek();\n    if (c != EOF) ++knn_input_first;\n    return c;\n}\n\nstatic void knn_input_skip_space(void) {\n    int c;\n    while ((c = knn_input_peek()) != EOF && isspace(c))\n        ++knn_input_first;\n}\n\nstatic void knn_input_expect(const char *text) {\n    while (*text) {\n        if (knn_input_take() != (unsigned char)*text) on_error();\n        ++text;\n    }\n}\n\nstatic int knn_input_integer(void) {\n    knn_input_skip_space();\n    int c = knn_input_peek();\n    int negative = 0;\n    if (c == '+' || c == '-') {\n        negative = c == '-';\n        knn_input_take();\n        c = knn_input_peek();\n    }\n    if (c < '0' || c > '9') on_error();\n\n    unsigned int value = 0;\n    unsigned int limit = (unsigned int)INT_MAX + (negative ? 1u : 0u);\n    do {\n        unsigned int digit = (unsigned int)(c - '0');\n        if (value > (limit - digit) / 10u) on_error();\n        value = value * 10u + digit;\n        knn_input_take();\n        c = knn_input_peek();\n    } while (c >= '0' && c <= '9');\n\n    if (negative) {\n        if (value == (unsigned int)INT_MAX + 1u) return INT_MIN;\n        return -(int)value;\n    }\n    return (int)value;\n}\n\nstatic float knn_input_float(void) {\n    knn_input_skip_space();\n    size_t scan = knn_input_first;\n    size_t parentheses = 0;\n\n    /* Locate a complete token before allowing strtof to inspect it. */\n    for (;;) {\n        if (scan == knn_input_last) {\n            size_t offset = scan - knn_input_first;\n            int added = knn_input_refill();\n            scan = knn_input_first + offset;\n            if (!added) break;\n        }\n        int c = (unsigned char)knn_input_data[scan];\n        if (isspace(c) || c == ',' || (c == ')' && parentheses == 0))\n            break;\n        if (c == '(')\n            ++parentheses;\n        else if (c == ')')\n            --parentheses;\n        ++scan;\n    }\n\n    char saved = knn_input_data[scan];\n    knn_input_data[scan] = '\\0';\n    char *end;\n    float value = strtof(knn_input_data + knn_input_first, &end);\n    int converted = end != knn_input_data + knn_input_first;\n    size_t next = (size_t)(end - knn_input_data);\n    knn_input_data[scan] = saved;\n    if (!converted) on_error();\n    knn_input_first = next;\n    return value;\n}\n\nint parse_number_of_groups() {\n    knn_input_skip_space();\n    knn_input_expect(\"n_groups=\");\n    int n = knn_input_integer();\n    knn_input_skip_space();\n    return n;\n}\n\nPoint parse_point() {\n    knn_input_skip_space();\n    knn_input_expect(\"(\");\n\n    Point point;\n    point.x = knn_input_float();\n    knn_input_skip_space();\n    knn_input_expect(\",\");\n    point.y = knn_input_float();\n\n    /* As with scanf, both conversions have completed before this literal. */\n    if (knn_input_peek() == ')') {\n        knn_input_take();\n        knn_input_skip_space();\n    }\n    return point;\n}\n\nGroup parse_next_group() {\n    knn_input_skip_space();\n    knn_input_expect(\"label=\");\n    int label = knn_input_take();\n    if (label == EOF) on_error();\n    knn_input_skip_space();\n    knn_input_expect(\"length=\");\n    int length = knn_input_integer();\n    knn_input_skip_space();\n\n    Group group;\n    group.label = (char)label;\n    group.length = length;\n    group.points = (Point *)malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n    return group;\n}\n\nint parse_k() {\n    knn_input_skip_space();\n    knn_input_expect(\"k=\");\n    int k = knn_input_integer();\n    knn_input_skip_space();\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}\n",

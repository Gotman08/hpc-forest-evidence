{
  "src/brute_isomorphism.cpp": "#include <iostream>\n#include <vector>\n#include <utility>\n#include <cstdint>\n\nusing namespace std;\n\nclass adjacency_matrix {\npublic:\n    explicit adjacency_matrix(int vertices = 0)\n        : vertices_(vertices),\n          words_per_row_((vertices + 63) / 64),\n          data_(static_cast<size_t>(vertices) * words_per_row_, 0) {}\n\n    int size() const {\n        return vertices_;\n    }\n\n    uint64_t *row(int index) {\n        return &data_[static_cast<size_t>(index) * words_per_row_];\n    }\n\n    const uint64_t *row(int index) const {\n        return &data_[static_cast<size_t>(index) * words_per_row_];\n    }\n\n    void setEdge(int source, int destination) {\n        row(source)[destination >> 6] |= uint64_t(1) << (destination & 63);\n    }\n\nprivate:\n    int vertices_;\n    int words_per_row_;\n    vector<uint64_t> data_;\n};\n\nadjacency_matrix readGraph();\n\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2);\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2, const vector<int> &equivalence);\ninline void printPermutation(vector<int> &equivalence);\n\nint main(){\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if(!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2){\n    vector<int> equivalence(g1.size(), 0);\n    vector<int> exchange_counter(g1.size(), 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    if(g1.size() != g2.size()) return false;\n\n    for(int i = 0; i < equivalence.size(); ++i)\n        equivalence[i] = i;\n\n    if(verifyPermutation(g1, g2, equivalence)){\n        printPermutation(equivalence);\n        return true;\n    }\n    \n    /*\n     * Permutations are based on Heap's algorithm, which generates all possible \n     * permutations for a given set of elements. \n     */\n    while(exchange_index < g1.size()){\n        if(exchange_counter[exchange_index] < exchange_index){\n            if(exchange_index % 2 == 0)\n                swap(equivalence[0], equivalence[exchange_index]);\n            else\n                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\n            if(verifyPermutation(g1, g2, equivalence)){\n                printPermutation(equivalence);\n                isomorphism_found = true;\n            }\n\n            exchange_counter[exchange_index]++;\n            exchange_index = 1;\n        }else{\n            exchange_counter[exchange_index] = 0;\n            exchange_index++;\n        }\n    }\n    return isomorphism_found; \n}\n\nadjacency_matrix readGraph(){\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read(vertices);\n    \n    cin >> edges;    \n    for (int i = 0; i < edges; i++) {\n       cin >> source >> destination;\n       read.setEdge(source, destination);\n       read.setEdge(destination, source);\n    }\n\n    return read;\n}\n\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2, const vector<int> &equivalence){\n    for (int i = 0; i < equivalence.size(); ++i) {\n        const uint64_t *row1 = g1.row(i);\n        const uint64_t *row2 = g2.row(equivalence[i]);\n        for (int j = 0; j <= i; ++j) {\n            bool edge1 = (row1[j >> 6] >> (j & 63)) & 1U;\n            int mapped_j = equivalence[j];\n            bool edge2 = (row2[mapped_j >> 6] >> (mapped_j & 63)) & 1U;\n            if(edge1 != edge2) return false;\n        }\n    }\n   return true;\n}\n\ninline void printPermutation(vector<int> &equivalence){\n    for (auto i : equivalence)\n        cout << i << \" \";\n    cout << endl;\n}\n"
}

    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <vector>\\n#include <cstdio>\\n#include <algorithm>\\n#include <climits>\\n\\nstatic int read_int() {\\n    int x = 0;\\n    char c = getchar_unlocked();\\n    while (c < '0' || c > '9') {\\n        if (c == '-') {\\n            c = getchar_unlocked();\\n            while (c >= '0' && c <= '9') {\\n                x = x * 10 - (c - '0');\\n                c = getchar_unlocked();\\n            }\\n            return x;\\n        }\\n        c = getchar_unlocked();\\n    }\\n    do {\\n        x = x * 10 + (c - '0');\\n        c = getchar_unlocked();\\n    } while (c >= '0' && c <= '9');\\n    return x;\\n}\\n\\nint main() {\\n    int n = read_int();\\n    int s = read_int();\\n\\n    const int np1 = n + 1;\\n    std::vector<long long> pref(np1 * np1, 0LL);\\n\\n    // Read input and compute row-wise prefix sums on the fly\\n    for (int i = 0; i < n; ++i) {\\n        long long row_sum = 0;\\n        const int base_i = (i + 1) * np1;\\n        for (int j = 0; j < n; ++j) {\\n            int val = read_int();\\n            row_sum += val;\\n            pref[base_i + (j + 1)] = row_sum;\\n        }\\n    }\\n\\n    // Vertical accumulation (parallel over columns)\\n    #pragma omp parallel for\\n    for (int j = 0; j <= n; ++j) {\\n        long long cum = 0;\\n        for (int i = 1; i <= n; ++i) {\\n            pref[i * np1 + j] += pref[(i - 1) * np1 + j];\\n        }\\n    }\\n\\n    const int B = 64;\\n    long long mxSum = LLONG_MIN;\\n\\n    // Tiled search, parallel over tile rows\\n    #pragma omp parallel for reduction(max : mxSum)\\n    for (int ii = 0; ii < n - s + 1; ii += B) {\\n        const int i_end = std::min(ii + B, n - s + 1);\\n        for (int jj = 0; jj < n - s + 1; jj += B) {\\n            const int j_end = std::min(jj + B, n - s + 1);\\n            for (int i = ii; i < i_end; ++i) {\\n                const long long * __restrict__ row_i_s = &pref[(i + s) * np1];\\n            
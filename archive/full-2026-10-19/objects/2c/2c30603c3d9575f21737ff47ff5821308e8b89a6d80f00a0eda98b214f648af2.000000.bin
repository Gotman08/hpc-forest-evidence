          "files": [
            "src/permutations.cc"
          ],
          "retained": [
            "Replace generic iterator successor helpers with an in-place indexed lexicographic successor over the string; pass the stateful output driver by reference.",
            "Format rows using independent affine indexed stores directly in a reusable 64 KiB buffer, flushed through fwrite; stream rows larger than the buffer capacity.",
            "Use a GCC ivdep hint on the independent output stores and disable iostream synchronization and cin ties for input."
          ]
        },

        "depth": 1,
        "epoch": 1,
        "hypothesis": "Outputting each permutation with one buffered write, while disabling C/C++ stream synchronization and avoiding per-line flushes, may improve this output-heavy workload without introducing OpenMP overhead. The earlier measured prefix-parallel attempt was slower, and lexicographic generation plus ordered output constrain useful work sharing.",
        "id": "c2eea74766604948",
        "ordinal": 2,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/permutations.cc"
          ],
          "retained": [
            "Reuse a string buffer to assemble each formatted permutation line and emit it with a single std::cout.write call.",
            "Replace std::endl flushing with a newline in the buffered line.",
            "Disable iostream synchronization and untie cin from cout."
          ]
        },

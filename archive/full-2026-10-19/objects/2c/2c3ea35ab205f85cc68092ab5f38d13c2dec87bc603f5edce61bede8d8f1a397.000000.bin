"""Admit only the audited completed Terra R1 group; no receive/stop/submit side effects."""
import hashlib, importlib.util, json, os, shutil, sys, time
from pathlib import Path
BASE=Path("C:/Users/nicol/Documents/Codex/2026-10-15/cr")
STUDY=BASE/"outputs/HPC-Forest-Etude-2020-2024-r1"
HERE=STUDY/"receptions/coverage-terra-xhigh-750909"
PREVIOUS=STUDY/"reprises/incident-liaison-terra-xhigh-20261017T1726"
def load(p):
    return json.loads(p.read_text(encoding="utf-8-sig"))
def sha(p):
    return hashlib.sha256(p.read_bytes()).hexdigest()
def save_new(p,d):
    with p.open("x",encoding="utf8") as f:
        json.dump(d,f,indent=2,ensure_ascii=False)
        f.write("\n")
spec=importlib.util.spec_from_file_location("r1_absence_observer",PREVIOUS/"observer-strict.py")
observer=importlib.util.module_from_spec(spec)
sys.modules[spec.name]=observer
spec.loader.exec_module(observer)
native=load(HERE/"audit-initial.json")
extra=load(HERE/"audit-complementaire.json")
recon=load(HERE/"reconciliation-livraisons.json")
assert native["model"]=="gpt-5.6-terra" and native["effort"]=="xhigh"
assert native["coverage_and_final_confirmations_verified"] and native["read_only_file_verification_before_and_after"]
assert extra["all_restored_bytes_unchanged"] and extra["all_final_confirmations_verified"]
assert recon["all_published_requests_accounted_for"] and not recon["all_published_requests_delivered"]
assert recon["published_requests"]==113 and recon["verified_deliveries"]==110
assert extra["native_audit_sha256"]==sha(HERE/"audit-initial.json")
assert extra["reconciliation_reader_sha256"]==sha(HERE/"reconcilier-terra.py")
rows=observer.census()
save_new(HERE/"cim-apres-audit-reconciliation.json",rows)
expected=load(PREVIOUS/"relais-attendu-r1.json")+load(PREVIOUS/"observateur-identite-complete.json")
for identity in expected:
    assert not any(all(r.get(k)==identity.get(k) for k in observer.FIELDS) for r in rows)
assert not [r for r in rows if "750909/mailbox" in (r.get("CommandLine") or "") and
            ("hpc_forest." in r["CommandLine"] or "reprendre-relais-r1.py" in r["CommandLine"])]
absence={"schema":"hpc-forest-owned-interfaces-already-absent-v1","verified":True,
    "verified_at":time.time(),"job_id":"750909","after_audit":True,"after_reconciliation":True,
    "stop_performed":False,"processes_stopped":0,"all_owned_process_identities_absent":True,
    "historical_identities":expected,"cim_sha256":sha(HERE/"cim-apres-audit-reconciliation.json"),
    "reconciliation_sha256":sha(HERE/"reconciliation-livraisons.json"),
    "reason":"Interfaces disappeared before receipt; observed external app restart; no termination performed"}
save_new(HERE/"owned-interfaces-absent.json",absence)
sys.path.insert(0,str(BASE/"work/marathon-archive-mother-r1/project/src"))
from hpc_forest.core import FileLock, atomic_json
with FileLock(STUDY/"coordinator.lock"):
    assert not (HERE/"reception-verifiee.json").exists()
    state_path=STUDY/"coordinator-state.json"
    state=load(state_path)
    assert state["current_key"]=="coverage-gpt-5.6-terra-xhigh"
    cell=next(c for c in state["queue"] if c["key"]==state["current_key"])
    assert cell["state"]=="working" and cell["job_id"]=="750909"
    assert cell["session_id"]=="bb34f01e2e114cf4a59ae51b02823166"
    shutil.copy2(state_path,HERE/"coordinator-avant-admission.json")
    folder=STUDY/"runs"/cell["key"]
    for src,dst in [(HERE/"audit-initial.json",folder/"audit.json"),
                    (HERE/"archive/results-750909.tar.gz",folder/"results-750909.tar.gz"),
                    (HERE/"owned-interfaces-absent.json",folder/"owned-interfaces-absent.json")]:
        assert not dst.exists()
        shutil.copy2(src,dst)
        assert sha(src)==sha(dst)
    transfer=load(HERE/"transfert-archive.json")
    archive_sha=sha(folder/"results-750909.tar.gz")
    assert archive_sha==transfer["remote_sha256"]==transfer["empreinte_locale"]==extra["archive_sha256"]
    proof={"schema":"hpc-forest-reception-terra-xhigh-v1","verified":True,"verified_at":time.time(),
        "job_id":"750909","archive_sha256_announced_remote_and_local":archive_sha,
        "restored_files_unchanged_before_after_audit":extra["restored_file_count_including_manifest"],
        "source_files_verified":extra["frozen_source_files_verified"],
        "subjects_received":extra["received_subjects"],"modified_programs_confirmed_on_received_finite_contracts":extra["modified_programs_confirmed"],
        "references_kept":extra["references_retained"],
        "published_requests":recon["published_requests"],"delivered_requests":recon["verified_deliveries"],
        "native_invocations_observed":recon["native_invocations_observed"],
        "known_exact_tokens":recon["known_exact_tokens"],"unmeasured_native_invocations":recon["unmeasured_native_invocations"],
        "requests_with_unknown_consumption":recon["requests_with_unknown_consumption"],
        "interrupted_claims_unknown":recon["interrupted_claims_unknown"],
        "expired_before_invocation_proven":recon["expired_without_native_invocation_proven"],
        "expired_unanswered_without_local_invocation_evidence":recon["expired_unanswered_without_local_invocation_evidence"],
        "all_published_requests_reconciled":True,"all_published_requests_delivered":False,
        "total_exact_consumption_available":False,"research_replayed":False,"candidate_or_oracle_modified":False,
        "global_causal_gain_claimed":False,"r1_lane_remains_reserved":True,"article_admission_pending":True,
        "original_cli_used_for_completed_cohort":"codex-cli 0.162.0-alpha.17.2",
        "new_cli_used_in_this_cohort":False}
    for key,name in [("audit","audit-initial.json"),("supplemental_audit","audit-complementaire.json"),
                     ("reconciliation","reconciliation-livraisons.json"),("absence","owned-interfaces-absent.json")]:
        proof[key]={"path":str(HERE/name),"sha256":sha(HERE/name)}
    save_new(HERE/"reception-verifiee.json",proof)
    cell.update(state="received_and_audited",archive_sha256=archive_sha,audit_path=str(folder/"audit.json"),
        reception_path=str(HERE/"reception-verifiee.json"))
    state.update(stage="ready_for_next_group_after_audited_reception",error=None,updated_at=time.time())
    atomic_json(state_path,state)
    groups=sum(c["state"]=="received_and_audited" for c in state["queue"])
    print(json.dumps({"verified":True,"received_groups":groups,"subjects":len(native["subjects"]),
        "remaining_groups":sum(c["state"]=="not_started" for c in state["queue"]),
        "next_key":next(c["key"] for c in state["queue"] if c["state"]=="not_started"),
        "all_requests_reconciled":True,"all_requests_delivered":False,"processes_stopped":0}))

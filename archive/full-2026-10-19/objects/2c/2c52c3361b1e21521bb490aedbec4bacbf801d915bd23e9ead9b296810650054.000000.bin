      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <algorithm>\n#include <cstdint>\n#include <limits>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\ntypedef std::int64_t Sum;\n\n#if defined(__aarch64__)\nstatic inline int64x2_t maximum_vector(int64x2_t a, int64x2_t b) {\n    return vbslq_s64(vcgtq_s64(a, b), a, b);\n}\n\nstatic inline int32x4_t prefix_four(int32x4_t value) {\n    const int32x4_t zero = vdupq_n_s32(0);\n    value = vaddq_s32(value, vextq_s32(zero, value, 3));\n    return vaddq_s32(value, vextq_s32(zero, value, 2));\n}\n#endif\n\nstatic inline Sum horizontal_maximum(const Sum* column, int n, int s,\n                                     Sum first, Sum best) {\n    Sum sum = first;\n    best = std::max(best, first);\n    int col = s;\n\n#if defined(__aarch64__)\n    const int64x2_t zero = vdupq_n_s64(0);\n    int64x2_t carry = vdupq_n_s64(first);\n    int64x2_t maxima = vdupq_n_s64(best);\n\n    for (; col + 7 < n; col += 8) {\n        const int64x2_t delta01 = vsubq_s64(\n            vld1q_s64(column + col), vld1q_s64(column + col - s));\n        const int64x2_t delta23 = vsubq_s64(\n            vld1q_s64(column + col + 2), vld1q_s64(column + col - s + 2));\n        const int64x2_t delta45 = vsubq_s64(\n            vld1q_s64(column + col + 4), vld1q_s64(column + col - s + 4));\n        const int64x2_t delta67 = vsubq_s64(\n            vld1q_s64(column + col + 6), vld1q_s64(column + col - s + 6));\n\n        int64x2_t prefix01 = vaddq_s64(delta01, vextq_s64(zero, delta01, 1));\n        int64x2_t prefix23 = vaddq_s64(delta23, vextq_s64(zero, delta23, 1));\n        int64x2_t prefix45 = vaddq_s64(delta45, vextq_s64(zero, delta45, 1));\n        int64x2_t prefix67 = vaddq_s64(delta67, vextq_s64(zero, delta67, 1));\n\n        const int64x2_t offset2 = vdupq_laneq_s64(prefix01, 1);\n        const int64x2_t offset4 = vaddq_s64(\n            offset2, vdupq_laneq_s64(prefix23, 1));\n        const int64x2_t offset6 = vaddq_s64(\n            offset4, vdupq_laneq_s64(prefix45, 1));\n        prefix23 = vaddq_s64(prefix23, offset2);\n        prefix45 = vaddq_s64(prefix45, offset4);\n        prefix67 = vaddq_s64(prefix67, offset6);\n\n        const int64x2_t block_maximum = maximum_vector(\n            maximum_vector(prefix01, prefix23),\n            maximum_vector(prefix45, prefix67));\n        maxima = maximum_vector(maxima, vaddq_s64(carry, block_maximum));\n        carry = vaddq_s64(carry, vdupq_laneq_s64(prefix67, 1));\n    }\n\n    sum = vgetq_lane_s64(carry, 0);\n    best = std::max(vgetq_lane_s64(maxima, 0), vgetq_lane_s64(maxima, 1));\n#endif\n\n    for (; col < n; ++col) {\n        sum += column[col] - column[col - s];\n        best = std::max(best, sum);\n    }\n    return best;\n}\n\nstatic inline std::int32_t horizontal_maximum(\n        const std::int32_t* column, int n, int s,\n        std::int32_t first, std::int32_t best) {\n    std::int32_t sum = first;\n    best = std::max(best, first);\n    int col = s;\n\n#if defined(__aarch64__)\n    int32x4_t carry = vdupq_n_s32(first);\n    int32x4_t maxima = vdupq_n_s32(best);\n\n    for (; col + 15 < n; col += 16) {\n        const int32x4_t delta03 = vsubq_s32(\n            vld1q_s32(column + col), vld1q_s32(column + col - s));\n        const int32x4_t delta47 = vsubq_s32(\n            vld1q_s32(column + col + 4), vld1q_s32(column + col - s + 4));\n        const int32x4_t delta811 = vsubq_s32(\n            vld1q_s32(column + col + 8), vld1q_s32(column + col - s + 8));\n        const int32x4_t delta1215 = vsubq_s32(\n            vld1q_s32(column + col + 12), vld1q_s32(column + col - s + 12));\n\n        const int32x4_t prefix03 = prefix_four(delta03);\n        int32x4_t prefix47 = prefix_four(delta47);\n        int32x4_t prefix811 = prefix_four(delta811);\n        int32x4_t prefix1215 = prefix_four(delta1215);\n\n        const int32x4_t offset4 = vdupq_laneq_s32(prefix03, 3);\n        const int32x4_t offset8 = vaddq_s32(\n            offset4, vdupq_laneq_s32(prefix47, 3));\n        const int32x4_t offset12 = vaddq_s32(\n            offset8, vdupq_laneq_s32(prefix811, 3));\n        prefix47 = vaddq_s32(prefix47, offset4);\n        prefix811 = vaddq_s32(prefix811, offset8);\n        prefix1215 = vaddq_s32(prefix1215, offset12);\n\n        const int32x4_t block_maximum = vmaxq_s32(\n            vmaxq_s32(prefix03, prefix47),\n            vmaxq_s32(prefix811, prefix1215));\n        maxima = vmaxq_s32(maxima, vaddq_s32(carry, block_maximum));\n        carry = vaddq_s32(carry, vdupq_laneq_s32(prefix1215, 3));\n    }\n\n    for (; col + 3 < n; col += 4) {\n        const int32x4_t delta = vsubq_s32(\n            vld1q_s32(column + col), vld1q_s32(column + col - s));\n        const int32x4_t values = vaddq_s32(carry, prefix_four(delta));\n        maxima = vmaxq_s32(maxima, values);\n        carry = vdupq_laneq_s32(values, 3);\n    }\n\n    sum = vgetq_lane_s32(carry, 0);\n    best = vmaxvq_s32(maxima);\n#endif\n\n    for (; col < n; ++col) {\n        sum += column[col] - column[col - s];\n        best = std::max(best, sum);\n    }\n    return best;\n}\n\ntemplate <typename Value>\nstatic Value maximum_sum(const std::vector<std::vector<int> >& matrix,\n                         int n, int s) {\n    std::vector<Value> columns(n, 0);\n    Value* column = columns.data();\n\n    for (int row = 0; row < s; ++row) {\n        const int* values = matrix[row].data();\n        #pragma omp simd\n        for (int col = 0; col < n; ++col)\n            column[col] += static_cast<Value>(values[col]);\n    }\n\n    Value first = 0;\n    #pragma omp simd reduction(+:first)\n    for (int col = 0; col < s; ++col)\n        first += column[col];\n\n    Value best = first;\n    const int last = n - s;\n    for (int top = 0; top <= last; ++top) {\n        best = horizontal_maximum(column, n, s, first, best);\n\n        if (top == last)\n            break;\n\n        const int* outgoing = matrix[top].data();\n        const int* incoming = matrix[top + s].data();\n        Value first_delta = 0;\n        #pragma omp simd reduction(+:first_delta)\n        for (int col = 0; col < s; ++col) {\n            const Value delta = static_cast<Value>(incoming[col])\n                              - static_cast<Value>(outgoing[col]);\n            column[col] += delta;\n            first_delta += delta;\n        }\n        first += first_delta;\n\n        #pragma omp simd\n        for (int col = s; col < n; ++col) {\n            column[col] += static_cast<Value>(incoming[col])\n                         - static_cast<Value>(outgoing[col]);\n        }\n    }\n    return best;\n}\n\nint main() {\n    int n, s;\n    std::cin >> n >> s;\n    std::vector<std::vector<int> > matrix(n, std::vector<int>(n));\n    Sum lower = 0;\n    Sum upper = 0;\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            scanf(\"%d\", &matrix[i][j]);\n            const Sum value = matrix[i][j];\n            lower = std::min(lower, value);\n            upper = std::max(upper, value);\n        }\n    }\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const Sum area = static_cast<Sum>(s) * s;\n    const bool narrow = (upper - lower) * area\n                     <= std::numeric_limits<std::int32_t>::max();\n    const Sum best = narrow\n        ? static_cast<Sum>(maximum_sum<std::int32_t>(matrix, n, s))\n        : maximum_sum<Sum>(matrix, n, s);\n\n    printf(\"%d\\n\", static_cast<int>(best));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Range-proven 32-bit arithmetic can double NEON lane width and enable native vector maxima, accelerating horizontal scans while retaining the general 64-bit path.",
  "notes": "The guard S²*(max(0,max_cell)-min(0,min_cell)) <= INT32_MAX bounds window sums and contiguous prefix differences, keeping narrow intermediates safe. No execution performed.",

#include "knn.h"

/* Max-heap of size k (1-indexed) to keep the k smallest distances */
static inline int parent(int i) { return i >> 1; }
static inline int left(int i)   { return i << 1; }
static inline int right(int i)  { return (i << 1) | 1; }

static void sift_down(float *distances, char *labels, int i, int heap_size) {
    while (1) {
        int largest = i;
        int l = left(i);
        int r = right(i);
        if (l <= heap_size && distances[l] > distances[largest]) largest = l;
        if (r <= heap_size && distances[r] > distances[largest]) largest = r;
        if (largest == i) break;
        float td = distances[i]; distances[i] = distances[largest]; distances[largest] = td;
        char tl = labels[i]; labels[i] = labels[largest]; labels[largest] = tl;
        i = largest;
    }
}

static void build_heap(float *distances, char *labels, int heap_size) {
    for (int i = heap_size / 2; i >= 1; --i)
        sift_down(distances, labels, i, heap_size);
}

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    /* Allocate 1-indexed arrays on stack (VLA) */
    float distances[k + 1];
    char   labels[k + 1];

    int count = 0; /* number of points currently in heap */

    for (int i = 0; i < n_groups; i++) {
        Group *g = &groups[i];
        float *xs = g->xs;
        float *ys = g->ys;
        int len = g->length;
        char lbl = g->label;

        for (int j = 0; j < len; j++) {
            float dx = to_evaluate.x - xs[j];
            float dy = to_evaluate.y - ys[j];
            float d = dx*dx + dy*dy;

            if (count < k) {
                /* heap not full: store without ordering */
                count++;
                distances[count] = d;
                labels[count]    = lbl;
            } else if (d < distances[1]) {
                /* new point is closer than the current farthest among k nearest */
                distances[1] = d;
                labels[1]    = lbl;
                sift_down(distances, labels, 1, count);
            }
        }
    }

    /* Build heap from first k points if we have exactly k */
    if (count == k) {
        build_heap(distances, labels, k);
    } else if (count < k) {
        /* fewer than k points total: just use what we have; no need to heapify */
        ;
    }

    /* Count frequencies of labels in heap (positions 1..count) */
    int freq[256] = {0};
    for (int i = 1; i <= count; i++) {
        freq[(unsigned char)labels[i]]++;
    }

    char most_frequent = '?';
    int best_count = 0;
    /* Iterate in ASCII order to match original tie-breaking */
    for (int c = 0; c < 256; c++) {
        if (freq[c] > best_count) {
            best_count = freq[c];
            most_frequent = (char)c;
        }
    }

    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));

    /* Free allocated memory */
    for (int i = 0; i < n_groups; i++) {
        free(groups[i].xs);
        free(groups[i].ys);
    }
    free(groups);
}

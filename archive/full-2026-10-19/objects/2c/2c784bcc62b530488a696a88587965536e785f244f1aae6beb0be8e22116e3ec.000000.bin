        ],
        "hypothesis_as_declared_by_model": "A persistent OpenMP team avoids repeated team setup while static worksharing distributes independent target bodies; extracting the per-body force calculation preserves each target's original ascending-j arithmetic order. This omits the previously slower serial threshold and the unhelpful SIMD/tiling/compact-position variants.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/nbody.c"
          ],
          "retained": [
            "Extract the per-body force calculation into a helper, retaining the original increasing-j accumulation order.",
            "Use one persistent OpenMP team across simulation iterations with static worksharing for force calculations and position updates."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.1728077121078968,
        "commit": "6b87e8405423ccc7aef320d0e127f2014941ad00"
      },
      {

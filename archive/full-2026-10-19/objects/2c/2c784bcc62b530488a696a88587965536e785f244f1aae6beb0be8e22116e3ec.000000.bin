        ],
        "hypothesis_as_declared_by_model": "Combining the measured contiguous byte matrix and cached verification row pointers with exact degree-based rejection may reduce adjacency work across the full permutation search while preserving Heap traversal and output order.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/brute_isomorphism.cpp"

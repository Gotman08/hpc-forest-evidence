        "delegation_parent": "R/C",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Splitting each spanning-tree search into independent starting-edge tasks should expose finer OpenMP worksharing than one task per root, improving load balance when root search costs vary. Per-task results are merged in original traversal order so early-success and best-path tie behavior remain deterministic; small task sets stay serial to avoid parallel overhead.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/tropical.cpp"
          ],
          "retained": [
            "Build the current spanning tree's adjacency lists once, retaining the original edge iteration order.",
            "Create one independent DFS task per ordered (root, first-neighbor) pair and schedule tasks dynamically with chunk size 1 when there are at least eight tasks.",
            "Use task-local path and result state, then merge results serially in original root/neighbor order to preserve first-success and strict best-color tie semantics.",
            "Pass path vectors by const reference in membership and color-count helpers to avoid unnecessary copies."
          ]
        },

    "trials": [
      {
        "id": "ed6069da17b6484d",
        "role": "A",
        "parent_id": null,
        "delegation_parent": "R/A",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Precomputed cell neighbors remove repeated coordinate division/modulo and boundary work in the BFS move generator. Binary search over the already sorted box positions reduces occupancy checks, while repositioning only the pushed box replaces quadratic bubble sorting with a linear shift. This should help larger searches while preserving state identity and BFS order.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/sokoban.c"
          ],
          "retained": [
            "Precompute up/down/left/right neighboring cell indices once when parsing the board, then use them for movement and push destinations.",
            "Use binary search in sorted box positions for occupancy checks.",
            "Maintain sorted box positions by shifting the moved box into place instead of bubble-sorting the full array."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.005159749959905942,
        "commit": "aa61fc67b11ccd567e06bb8bfbb8780d0828a141"
      },
      {
        "id": "bfcb4c69d20a4116",
        "role": "B",
        "parent_id": null,
        "delegation_parent": "R/B",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Replacing the full bubble sort after every move with a one-box insertion adjustment should reduce dependent comparisons and writes during state generation while preserving sorted box coordinates for exact canonicalization. Non-push moves need no box reordering.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/sokoban.c"
          ],
          "retained": [
            "Removed the unconditional bubble sort and, only after a box push, reinserted the moved box into the already sorted box-index sequence by shifting the affected range."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.004983925571044286,
        "commit": "f820e00ec14e8e16415ff57da9aa84b789928b73"
      },
      {
        "id": "58705d1e9e9f4ec0",
        "role": "C",
        "parent_id": null,
        "delegation_parent": "R/C",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Assigning all four independent move checks to one OpenMP iteration per parent may reduce scheduling overhead and keep candidate writes localized; raising the activation threshold avoids creating parallel regions for smaller batches. FIFO parent order and serial direction-ordered commits preserve the intended BFS ordering.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/sokoban.c"
          ],
          "retained": [
            "Work-share move checks by parent state instead of flattening each batch into four times as many loop iterations.",
            "Use a 128-parent threshold for OpenMP activation; retain static scheduling and ordered serial candidate commits."
          ]
        },
        "status": "incorrect",
        "mean_seconds": null,
        "commit": "0abaf4db4b6b8f97e8bf702b2dd88fa0ce72077b"
      },
      {
        "id": "42a9a0e6163e4b0c",
        "role": "A",
        "parent_id": null,
        "delegation_parent": "R/A",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Replacing separate-chaining hash buckets with a contiguous linear-probing table should improve locality during BFS state deduplication by avoiding linked-list pointer chasing and filtering candidates by cached hash before comparing state cells. Key equality and BFS insertion order remain unchanged; the controller should determine whether clustering offsets the locality benefit.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/sokoban.c"
          ],
          "retained": [
            "Replace linked collision chains with a contiguous open-addressed bucket array using linear probing.",
            "Rehash occupied entries into a newly allocated doubled table on growth; check cached hashes before comparing state cell arrays."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.006284583359956741,
        "commit": "fefe8f767703868d0b885b13705a82b91be4332e"
      },
      {
        "id": "09051315f93044ad",
        "role": "B",
        "parent_id": "bfcb4c69d20a4116",
        "delegation_parent": "R/B",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Replacing the push-destination occupancy scan's early exit with a read-only OR reduction removes loop-carried control flow and exposes a legal SIMD reduction. It preserves the decision exactly because any matching box blocks the push.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/sokoban.c"
          ],
          "retained": [
            "In move_me, scan all box coordinates for c2 and OR the equality results, then reject the push if the reduction is nonzero instead of returning early from the loop."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.006208660081028938,
        "commit": "666cbb9bd2769c1be98e5a9d303d8ea070e85562"
      },
      {
        "id": "41a40065de2842e1",
        "role": "C",
        "parent_id": null,
        "delegation_parent": "R/C",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "On sufficiently wide BFS layers, statically work-sharing independent move checks across OpenMP threads can reduce search time. Preallocating each candidate serially avoids races in the state pool, and committing results in the existing parent/direction order preserves deterministic search behavior.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/sokoban.c"
          ],
          "retained": [
            "Batch up to 32 frontier states and use an OpenMP static-scheduled loop to evaluate their four independent move candidates when at least eight parents are available.",
            "Allocate candidate states serially before the parallel loop and commit results serially in the original parent and direction order; recycle invalid and unprocessed candidates.",
            "Reject moves whose destination or pushed-box destination falls outside the board before indexing board or live."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.006346481541792552,
        "commit": "254e2c9cf48bd26a86aed949eeedb0ce1f2ca603"
      },
      {
        "id": "b0269489e35d482a",
        "role": "G",
        "parent_id": null,
        "delegation_parent": "R/G",
        "integration_sources": [
          "ed6069da17b6484d",
          "42a9a0e6163e4b0c"
        ],
        "hypothesis_as_declared_by_model": "Combining precomputed bounded neighbors, binary-search box occupancy with incremental sorted-box maintenance, and a contiguous open-addressed state table may reduce movement and duplicate-state lookup costs without changing BFS insertion order or shortest-path tie behavior.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/sokoban.c"
          ],
          "retained": [
            "Precompute each board cell's in-bounds cardinal neighbors and use them for movement and push destinations, rejecting out-of-board moves before indexing board or live.",
            "Use binary search over sorted box positions for occupancy, and shift the moved box into its sorted position only after a push.",
            "Replace linked collision chains with a contiguous linear-probing hash table; grow by doubling, reinsert occupied entries, and compare cached hashes before state arrays."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.006217160262167454,
        "commit": "9b5cc4e4ca58afb0d42a8c91928e4bffe7caaf9b"
      },
      {
        "id": "eeae297c28c94c72",
        "role": "G",
        "parent_id": "b0269489e35d482a",
        "delegation_parent": "R/G",
        "integration_sources": [
          "bfcb4c69d20a4116",
          "ed6069da17b6484d",
          "42a9a0e6163e4b0c"
        ],
        "hypothesis_as_declared_by_model": "For states with a modest number of boxes, an early-exit linear occupancy scan may cost less than binary-search setup while preserving sorted-box invariants; retaining the existing neighbor table, insertion maintenance, and open-addressed state table lets the controller evaluate this full-program tradeoff across valid inputs.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/sokoban.c"
          ],
          "retained": [
            "Replace binary search for box occupancy with a sorted-array linear scan that exits on equality or once positions exceed the target cell.",
            "Retain precomputed bounded neighbors and push-only sorted-box insertion.",
            "Retain cached-hash checks and the open-addressed state table."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.0064482055604457855,
        "commit": "eb15b94ab85d30460cf4d37565658335724fc4a6"
      }
    ]

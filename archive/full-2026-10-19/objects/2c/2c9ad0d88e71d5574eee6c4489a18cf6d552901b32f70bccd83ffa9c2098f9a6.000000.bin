"""Parent review: preserve actual actors and verify the isolated reader delta."""
import hashlib
import json
from datetime import datetime, timezone
from pathlib import Path

base = Path(__file__).resolve().parents[4]
old = base / "outputs/HPC-Forest-Primes-Natif-Audit-r2c/revision-r2"
new = old.with_name("revision-r3")


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


delivery = json.loads((new / "LIVRAISON-AUDITEUR-REVISION-R3.json").read_text(encoding="utf-8"))
assert sha(new / "LIVRAISON-AUDITEUR-REVISION-R3.json") == "36412cb5905817c2850c704668573c27a765d061e76d434dfe6504a75405fc67"
assert delivery["implementation_modules_changed"] == ["audit_cli_namespaces.py"]
for name in ("archive", "manifest", "validation", "guide", "implementation_delta", "previous_delivery", "prior_real_refusal", "audit_cli_namespaces"):
    ref = delivery[name]
    assert sha(Path(ref["path"])) == ref["sha256"], name
manifest = json.loads((new / "manifeste-auditeur.json").read_text(encoding="utf-8"))
for name, digest in manifest["files"].items():
    path = new / name
    assert path.is_file() and not path.is_symlink() and sha(path) == digest, name
unchanged = []
for path in old.glob("audit*.py"):
    if path.name != "audit_cli_namespaces.py":
        assert sha(path) == sha(new / path.name), path.name
        unchanged.append(path.name)
source = (new / "audit_cli_namespaces.py").read_text(encoding="utf-8")
for text in ('original_controller = authorizations["controller"]', 'json_file(cli_alias["received"]) == controller', 'original_worker = authorizations["worker"]', 'json_file(proof(original_worker)) == worker', 'left, right = worker.get("evidence_refs"), controller.get("evidence_refs")', '"controller_namespace": "romeo-posix", "worker_namespace": "windows-local"'):
    assert text in source
for text in ('sha(raw) == info["sha256"]', 'local_ref["sha256"] == remote_ref["sha256"] == alias["sha256"]', 'evidence == json_file(alias["received"])', 'evidence.get("authentication_exported") is False'):
    assert text in source
receipt = {
    "reviewed_at": datetime.now(timezone.utc).isoformat(),
    "verified": True,
    "scope": "isolated final-reader actor/namespace repair only",
    "delivery_sha256": sha(new / "LIVRAISON-AUDITEUR-REVISION-R3.json"),
    "manifest_files_rehashed": len(manifest["files"]),
    "other_audit_modules_byte_identical": unchanged,
    "parent_inspected_diff_and_helpers_and_negative_actor_tests": True,
    "actual_controller_actor": "ARM/POSIX",
    "actual_worker_actor": "Windows/local",
    "actual_authorization_or_expectation_relabelled": False,
    "original_file_mirrors_sizes_shas_core_cli_comparisons_still_strict": True,
    "author_validation_tests": delivery["tests_passed"],
    "author_ruff": delivery["ruff"],
    "native_audit_executed_by_review": False,
    "native_research_admitted": False,
    "negative_native_receipts_must_still_refuse_full_admission": True,
    "full_cache_preservation_still_required_separately": True,
}
path = new / "REVUE-INDEPENDANTE-PARENT.json"
with path.open("x", encoding="utf-8") as handle:
    json.dump(receipt, handle, ensure_ascii=False, indent=2)
    handle.write("\n")
print(json.dumps({"verified": True, "path": str(path), "sha256": sha(path), "manifest_files": len(manifest["files"])}))

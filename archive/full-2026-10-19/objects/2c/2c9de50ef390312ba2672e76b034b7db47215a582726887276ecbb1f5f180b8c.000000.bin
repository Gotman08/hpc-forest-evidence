{
  "src/est_matriz_seq.c": "#include <stdio.h>\n#include <stdlib.h>\n#include <math.h>\n#include <string.h>\n\nvoid bubble_sort(double *matriz, int tam) {\n    int i, j;\n    for (i = tam - 1; i > 0; --i) {\n        for (j = 0; j < i; ++j) {\n            if (matriz[j] > matriz[j + 1]) {\n                double aux = matriz[j];\n                matriz[j] = matriz[j + 1];\n                matriz[j + 1] = aux;\n            }\n        }\n    }\n}\n\n/* Stable insertion-sorted blocks followed by streaming merge passes. */\nstatic void sort_span(double *values, double *scratch, size_t n) {\n    const size_t block = 32;\n    size_t first, width;\n    double *src, *dst;\n\n    for (first = 0; first < n;) {\n        size_t end = first + (n - first < block ? n - first : block);\n        size_t i;\n        for (i = first + 1; i < end; ++i) {\n            double value = values[i];\n            size_t j = i;\n            while (j > first && values[j - 1] > value) {\n                values[j] = values[j - 1];\n                --j;\n            }\n            values[j] = value;\n        }\n        first = end;\n    }\n\n    src = values;\n    dst = scratch;\n    for (width = block; width < n;) {\n        for (first = 0; first < n;) {\n            size_t middle = first + (n - first < width ? n - first : width);\n            size_t end = middle + (n - middle < width ? n - middle : width);\n            size_t left = first, right = middle, out = first;\n\n            if (middle == end || src[middle - 1] <= src[middle]) {\n                memcpy(dst + first, src + first, (end - first) * sizeof(double));\n            } else {\n                while (left < middle && right < end) {\n                    if (src[right] < src[left])\n                        dst[out++] = src[right++];\n                    else\n                        dst[out++] = src[left++];\n                }\n                while (left < middle)\n                    dst[out++] = src[left++];\n                while (right < end)\n                    dst[out++] = src[right++];\n            }\n            first = end;\n        }\n        {\n            double *swap = src;\n            src = dst;\n            dst = swap;\n        }\n        if (width > n / 2)\n            break;\n        width *= 2;\n    }\n    if (src != values)\n        memcpy(values, src, n * sizeof(double));\n}\n\nstatic void sort_column(double *values, double *scratch, int rows) {\n    size_t first = 0, n = (size_t)rows;\n    if (scratch == NULL) {\n        bubble_sort(values, rows);\n        return;\n    }\n    /* Bubble sort never moves an element across a NaN. */\n    while (first < n) {\n        size_t end;\n        if (isnan(values[first])) {\n            ++first;\n            continue;\n        }\n        end = first + 1;\n        while (end < n && !isnan(values[end]))\n            ++end;\n        sort_span(values + first, scratch, end - first);\n        first = end;\n    }\n}\n\nvoid ordena_colunas(double *matriz, int lin, int col) {\n    int i;\n    double *scratch = (double *)malloc((size_t)lin * sizeof(double));\n    for (i = 0; i < col; ++i)\n        sort_column(matriz + (size_t)i * (size_t)lin, scratch, lin);\n    free(scratch);\n}\n\nvoid calcula_media(double *matriz, double *vet, int lin, int col) {\n    int i, j;\n    for (i = 0; i < col; ++i) {\n        double soma = 0;\n        double *column = matriz + (size_t)i * (size_t)lin;\n        for (j = 0; j < lin; ++j)\n            soma += column[j];\n        vet[i] = soma / lin;\n    }\n}\n\nvoid calcula_media_harmonica(double *matriz, double *vet, int lin, int col) {\n    int i, j;\n    for (i = 0; i < col; ++i) {\n        double soma = 0;\n        double *column = matriz + (size_t)i * (size_t)lin;\n        for (j = 0; j < lin; ++j)\n            soma += (1 / column[j]);\n        vet[i] = lin / soma;\n    }\n}\n\nvoid calcula_mediana(double *matriz, double *vet, int lin, int col) {\n    int i;\n    for (i = 0; i < col; ++i) {\n        double *column = matriz + (size_t)i * (size_t)lin;\n        if ((lin - 1) % 2) {\n            vet[i] = column[lin / 2 - 1] + column[lin / 2];\n            vet[i] *= 0.5;\n        } else {\n            vet[i] = column[(lin - 1) / 2];\n        }\n    }\n}\n\n/* Deterministic interpretation: each original counter starts at zero. */\nstatic double mode_comparisons(double *values, int rows) {\n    int i, j;\n    float best = 0, mode = 0;\n    for (i = 0; i < rows; ++i) {\n        double count = 0;\n        for (j = i + 1; j < rows; ++j) {\n            if (values[i] == values[j]) {\n                count++;\n                if (count > best) {\n                    best = (float)count;\n                    mode = (float)values[i];\n                }\n            }\n        }\n    }\n    return best == 0 ? -1 : (double)mode;\n}\n\ndouble moda_aux(double *matriz, int lin) {\n    size_t first = 0, n = (size_t)lin;\n    float best = 0, mode = 0;\n    while (first < n) {\n        size_t end = first + 1;\n        double count;\n        if (isnan(matriz[first]))\n            return mode_comparisons(matriz, lin);\n        while (end < n && matriz[end] == matriz[first])\n            ++end;\n        /* Also preserve this helper's behavior for unsorted callers. */\n        if (end < n && matriz[end] < matriz[first])\n            return mode_comparisons(matriz, lin);\n        count = (double)(end - first - 1);\n        if (count > (double)best) {\n            size_t chosen = first;\n            best = (float)count;\n            /* Downward rounding can let later equal elements replace the\n               winner. Preserve that choice, including its zero sign. */\n            if (count > (double)best + 1.0)\n                chosen += (size_t)(count - (double)best - 1.0);\n            mode = (float)matriz[chosen];\n        }\n        first = end;\n    }\n    return best == 0 ? -1 : (double)mode;\n}\n\nvoid calcula_moda(double *matriz, double *moda, int lin, int col) {\n    int i;\n    for (i = 0; i < col; ++i)\n        moda[i] = moda_aux(matriz + (size_t)i * (size_t)lin, lin);\n}\n\nvoid calcula_variancia(double *matriz, double *media, double *variancia,\n                       int lin, int col) {\n    int i, j;\n    for (i = 0; i < col; ++i) {\n        double soma = 0;\n        double *column = matriz + (size_t)i * (size_t)lin;\n        for (j = 0; j < lin; ++j)\n            soma += pow((column[j] - media[i]), 2);\n        variancia[i] = soma / (lin - 1);\n    }\n}\n\nvoid calcula_desvio_padrao(double *variancia, double *dp, int col) {\n    int i;\n    for (i = 0; i < col; ++i)\n        dp[i] = sqrt(variancia[i]);\n}\n\nvoid calcula_coeficiente_variacao(double *media, double *dp, double *cv, int col) {\n    int i;\n    for (i = 0; i < col; ++i)\n        cv[i] = dp[i] / media[i];\n}\n\nint main(int argc, char **argv) {\n    int lin, col, i, j;\n    size_t rows, columns, tile_rows, workspace_count, first;\n    double *matriz, *mediana, *media, *media_har, *moda, *variancia, *dp, *cv;\n    double *workspace;\n\n    fscanf(stdin, \"%d \", &lin);\n    fscanf(stdin, \"%d\\n\", &col);\n    rows = (size_t)lin;\n    columns = (size_t)col;\n\n    matriz = (double *)malloc(rows * columns * sizeof(double));\n    media = (double *)malloc(columns * sizeof(double));\n    media_har = (double *)malloc(columns * sizeof(double));\n    mediana = (double *)malloc(columns * sizeof(double));\n    moda = (double *)malloc(columns * sizeof(double));\n    variancia = (double *)malloc(columns * sizeof(double));\n    cv = (double *)malloc(columns * sizeof(double));\n    dp = (double *)malloc(columns * sizeof(double));\n\n    /* Keep ordinary input slabs within 32 KiB, with at most 32 rows.\n       A wider matrix uses one complete input row. The same allocation\n       becomes the merge workspace after ingestion. */\n    tile_rows = columns ? 4096 / columns : 32;\n    if (tile_rows == 0)\n        tile_rows = 1;\n    if (tile_rows > 32)\n        tile_rows = 32;\n    if (tile_rows > rows)\n        tile_rows = rows;\n    workspace_count = tile_rows * columns;\n    if (workspace_count < rows)\n        workspace_count = rows;\n    workspace = (double *)malloc(workspace_count * sizeof(double));\n\n    if (workspace != NULL) {\n        for (j = 0; j < col; ++j) {\n            media[j] = 0;\n            media_har[j] = 0;\n        }\n        for (first = 0; first < rows;) {\n            size_t count = rows - first < tile_rows ? rows - first : tile_rows;\n            size_t r, c;\n            for (r = 0; r < count; ++r)\n                for (c = 0; c < columns; ++c)\n                    fscanf(stdin, \"%lf \", &workspace[r * columns + c]);\n\n            /* Transpose short contiguous column pieces and accumulate\n               both sums without changing either column's row order. */\n            for (c = 0; c < columns; ++c) {\n                double sum = media[c];\n                double reciprocal_sum = media_har[c];\n                double *destination = matriz + c * rows + first;\n                for (r = 0; r < count; ++r) {\n                    double value = workspace[r * columns + c];\n                    destination[r] = value;\n                    sum += value;\n                    reciprocal_sum += (1 / value);\n                }\n                media[c] = sum;\n                media_har[c] = reciprocal_sum;\n            }\n            first += count;\n        }\n        for (j = 0; j < col; ++j) {\n            media[j] = media[j] / lin;\n            media_har[j] = lin / media_har[j];\n        }\n    } else {\n        for (i = 0; i < lin; ++i)\n            for (j = 0; j < col; ++j)\n                fscanf(stdin, \"%lf \", &matriz[(size_t)j * rows + (size_t)i]);\n        calcula_media(matriz, media, lin, col);\n        calcula_media_harmonica(matriz, media_har, lin, col);\n    }\n\n    /* Finish a column while its sorted data remains locally reusable. */\n    for (j = 0; j < col; ++j) {\n        double *column = matriz + (size_t)j * rows;\n        sort_column(column, workspace, lin);\n        calcula_mediana(column, mediana + j, lin, 1);\n        calcula_moda(column, moda + j, lin, 1);\n        calcula_variancia(column, media + j, variancia + j, lin, 1);\n        calcula_desvio_padrao(variancia + j, dp + j, 1);\n        calcula_coeficiente_variacao(media + j, dp + j, cv + j, 1);\n    }\n\n    for (i = 0; i < col; ++i)\n        printf(\"%.1lf \", media[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; ++i)\n        printf(\"%.1lf \", media_har[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; ++i)\n        printf(\"%.1lf \", mediana[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; ++i)\n        printf(\"%.1lf \", moda[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; ++i)\n        printf(\"%.1lf \", variancia[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; ++i)\n        printf(\"%.1lf \", dp[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; ++i)\n        printf(\"%.1lf \", cv[i]);\n    printf(\"\\n\");\n\n    free(workspace);\n    free(matriz);\n    free(media);\n    free(media_har);\n    free(mediana);\n    free(moda);\n    free(variancia);\n    free(dp);\n    free(cv);\n    return 0;\n}\n"
}

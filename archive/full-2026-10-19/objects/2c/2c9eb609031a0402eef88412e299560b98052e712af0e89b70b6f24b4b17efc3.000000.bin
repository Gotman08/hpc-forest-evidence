  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10\n#define DT 0.01f\n#define SOFTENING 1e-9f\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nvoid body_force(float *x, float *y, float *z,\n                float *vx, float *vy, float *vz, int n) {\n    #pragma omp for schedule(static)\n    for (int i = 0; i < n; ++i) {\n        float xi = x[i];\n        float yi = y[i];\n        float zi = z[i];\n        float fx = 0.0f;\n        float fy = 0.0f;\n        float fz = 0.0f;\n\n        for (int j = 0; j < n; ++j) {\n            float dx = x[j] - xi;\n            float dy = y[j] - yi;\n            float dz = z[j] - zi;\n            float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n            float inv_dist = 1 / sqrt(sqrd_dist);\n            float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n            fx += dx * inv_dist3;\n            fy += dy * inv_dist3;\n            fz += dz * inv_dist3;\n        }\n\n        vx[i] += DT*fx;\n        vy[i] += DT*fy;\n        vz[i] += DT*fz;\n    }\n}\n\nvoid read_dataset(int *nbodies, float **x, float **y, float **z,\n                  float **vx, float **vy, float **vz) {\n    int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n    if (b != 1) {\n        fprintf(stderr,\"\\nError reading nbodie value\\n\");\n        exit(EXIT_FAILURE);\n    }\n    Body *tmp = (Body *)malloc((*nbodies) * sizeof(Body));\n    b = fread(tmp, (*nbodies) * sizeof(Body), 1, stdin);\n    if (b != 1) {\n        fprintf(stderr,\"\\nError reading input values\\n\");\n        exit(EXIT_FAILURE);\n    }\n\n    int n = *nbodies;\n    *x = (float *)malloc(n * sizeof(float));\n    *y = (float *)malloc(n * sizeof(float));\n    *z = (float *)malloc(n * sizeof(float));\n    *vx = (float *)malloc(n * sizeof(float));\n    *vy = (float *)malloc(n * sizeof(float));\n    *vz = (float *)malloc(n * sizeof(float));\n\n    for (int i = 0; i < n; ++i) {\n        (*x)[i] = tmp[i].x;\n        (*y)[i] = tmp[i].y;\n        (*z)[i] = tmp[i].z;\n        (*vx)[i] = tmp[i].vx;\n        (*vy)[i] = tmp[i].vy;\n        (*vz)[i] = tmp[i].vz;\n    }\n    free(tmp);\n}\n\nvoid write_dataset(const int nbodies, float *x, float *y, float *z,\n                   float *vx, float *vy, float *vz) {\n    Body *tmp = (Body *)malloc(nbodies * sizeof(Body));\n    for (int i = 0; i < nbodies; ++i) {\n        tmp[i].x = x[i];\n        tmp[i].y = y[i];\n        tmp[i].z = z[i];\n        tmp[i].vx = vx[i];\n        tmp[i].vy = vy[i];\n        tmp[i].vz = vz[i];\n    }\n    int b = fwrite(tmp, nbodies * sizeof(Body), 1, stdout);\n    if (b != 1) {\n        fprintf(stderr,\"\\nError writing to output\\n\");\n        exit(EXIT_FAILURE);\n    }\n    free(tmp);\n}\n\nint main(int argc, char **argv) {\n    int nbodies;\n    float *x, *y, *z, *vx, *vy, *vz;\n\n    read_dataset(&nbodies, &x, &y, &z, &vx, &vy, &vz);\n\n    #pragma omp parallel\n    {\n        for (int iter = 0; iter < N_ITER; ++iter) {\n            body_force(x, y, z, vx, vy, vz, nbodies);\n            #pragma omp for schedule(static)\n            for (int i = 0; i < nbodies; ++i) {\n                x[i] += vx[i] * DT;\n                y[i] += vy[i] * DT;\n                z[i] += vz[i] * DT;\n            }\n        }\n    }\n\n    write_dataset(nbodies, x, y, z, vx, vy, vz);\n\n    free(x); free(y); free(z);\n    free(vx); free(vy); free(vz);\n\n    return 0;\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Converting the body data from an array-of-structs to a structure-of-arrays layout improves cache locality for the inner j-loop (three sequential streams instead of interleaved struct fields), while wrapping the entire time-step loop in a single OpenMP parallel region avoids repeated thread creation overhead; static scheduling over i preserves exact per-body summation order, yielding bit-identical output.",
  "notes": "Arithmetic operations and their order are unchanged. Only memory layout (SoA) and thread management (single parallel region with omp for worksharing) were modified. The input/output binary format remains identical to the original AoS representation.",

      "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\nstatic const int MOD = 1000000007;\nstatic const int TILE = 64;\n\nstatic int* aligned_data(vector<int>& storage) {\n    uintptr_t address = reinterpret_cast<uintptr_t>(storage.data());\n    address = (address + 63) & ~uintptr_t(63);\n    return reinterpret_cast<int*>(address);\n}\n\nstatic inline void scan_rectangle(\n    int y_begin, int y_end, int x_begin, int x_end,\n    const vector<vector<bool> >& blocked, int* dp, int* right) {\n    for (int y = y_begin; y < y_end; ++y) {\n        int left = right[y];\n        const vector<bool>& row = blocked[y];\n        for (int x = x_begin; x < x_end; ++x) {\n            int value = dp[x] + left;\n            if (value >= MOD) value -= MOD;\n            left = row[x] ? 0 : value;\n            dp[x] = left;\n        }\n        right[y] = left;\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<vector<bool> > blocked(n, vector<bool>(n, false));\n    for (int c = 0; c < m; ++c) {\n        int y, x;\n        cin >> y >> x;\n        blocked[y][x] = true;\n    }\n\n    // Align tile boundaries so concurrent tiles do not share frontier cache lines.\n    vector<int> dp_storage(n + 16, 0);\n    vector<int> right_storage(n + 16, 0);\n    int* dp = aligned_data(dp_storage);\n    int* right = aligned_data(right_storage);\n\n    // A single virtual incoming path seeds the origin.\n    dp[0] = 1;\n\n#ifdef _OPENMP\n    const int tile_count = (n + TILE - 1) / TILE;\n    const int workers = min(4, omp_get_max_threads());\n    if (workers > 1 && tile_count >= 2 * workers) {\n        #pragma omp parallel num_threads(workers)\n        {\n            for (int wave = 0; wave < 2 * tile_count - 1; ++wave) {\n                const int first = max(0, wave - tile_count + 1);\n                const int last = min(tile_count - 1, wave);\n\n                #pragma omp for schedule(static)\n                for (int tile_y = first; tile_y <= last; ++tile_y) {\n                    const int tile_x = wave - tile_y;\n                    const int y_begin = tile_y * TILE;\n                    const int x_begin = tile_x * TILE;\n                    scan_rectangle(y_begin, min(n, y_begin + TILE),\n                                   x_begin, min(n, x_begin + TILE),\n                                   blocked, dp, right);\n                }\n                // The implicit barrier publishes north and west tile boundaries.\n            }\n        }\n    } else\n#endif\n    {\n        scan_rectangle(0, n, 0, n, blocked, dp, right);\n    }\n\n    cout << dp[n - 1] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "A persistent OpenMP team processing 64-by-64 tiles in wavefront order can reduce synchronization versus per-row parallel scans while avoiding carry-correction passes.",

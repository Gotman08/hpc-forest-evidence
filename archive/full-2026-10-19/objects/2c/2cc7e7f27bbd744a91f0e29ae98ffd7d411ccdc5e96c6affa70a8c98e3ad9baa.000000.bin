{
  "src/knn.c": "#include \"knn.h\"\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nstatic char knn_vote(char * labels, int k) {\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nstatic char knn_serial(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    char result = knn_vote(labels, k);\n    free(distances);\n    free(labels);\n    return result;\n}\n\n#ifdef _OPENMP\ntypedef struct {\n    float * distances;\n    char * labels;\n    size_t begin;\n    size_t end;\n    int capacity;\n    int count;\n    int head;\n} KnnPartial;\n\nstatic void knn_free_partials(KnnPartial * partials, int count) {\n    for (int i = 0; i < count; i++) {\n        free(partials[i].distances);\n        free(partials[i].labels);\n    }\n    free(partials);\n}\n\ntypedef struct {\n    size_t begin;\n    size_t end;\n    size_t lo;\n    size_t hi;\n    size_t lower;\n    size_t upper;\n    size_t take_equal;\n    size_t histogram[256];\n} KnnRankPart;\n\nstatic char knn_histogram_vote(const size_t * histogram) {\n    char best = 0;\n    size_t best_count = 0;\n    for (unsigned int i = 0; i < 256; i++) {\n        char label = (char) (unsigned char) i;\n        size_t count = histogram[i];\n        if (count > best_count ||\n            (count != 0 && count == best_count && label < best)) {\n            best = label;\n            best_count = count;\n        }\n    }\n    return best;\n}\n\nstatic int knn_float_compare(const void * a, const void * b) {\n    float x = *(const float *) a;\n    float y = *(const float *) b;\n    return (x > y) - (x < y);\n}\n\nstatic float knn_rank_pivot(const float * values, const KnnRankPart * parts,\n                            int part_count, int sorted) {\n    int chosen = 0;\n    size_t largest = 0;\n    for (int p = 0; p < part_count; p++) {\n        size_t length = parts[p].hi - parts[p].lo;\n        if (length > largest) {\n            largest = length;\n            chosen = p;\n        }\n    }\n\n    size_t lo = parts[chosen].lo;\n    size_t hi = parts[chosen].hi;\n    float b = values[lo + (hi - lo) / 2];\n    if (sorted) {\n        return b;\n    }\n\n    float a = values[lo];\n    float c = values[hi - 1];\n    if (a > b) {\n        float temporary = a;\n        a = b;\n        b = temporary;\n    }\n    if (b > c) {\n        b = c;\n    }\n    return a > b ? a : b;\n}\n\nstatic int knn_parallel_rank(int n_groups, Group * groups, int k,\n                             Point to_evaluate, size_t total, int part_count,\n                             char * result) {\n    if ((size_t) k >= total) {\n        size_t histogram[256] = {0};\n        for (int i = 0; i < n_groups; i++) {\n            if (groups[i].length > 0) {\n                histogram[(unsigned char) groups[i].label] +=\n                    (size_t) groups[i].length;\n            }\n        }\n        histogram[(unsigned char) (char) -1] += (size_t) k - total;\n        *result = knn_histogram_vote(histogram);\n        return 1;\n    }\n\n    if (total > (size_t) -1 / sizeof(float)) {\n        return 0;\n    }\n\n    KnnRankPart * parts = (KnnRankPart *) calloc((size_t) part_count, sizeof(*parts));\n    float * original = (float *) malloc(total * sizeof(*original));\n    float * values = (float *) malloc(total * sizeof(*values));\n    if (parts == NULL || original == NULL || values == NULL) {\n        free(values);\n        free(original);\n        free(parts);\n        return 0;\n    }\n\n    size_t base = total / (size_t) part_count;\n    size_t remainder = total % (size_t) part_count;\n    for (int p = 0; p < part_count; p++) {\n        size_t preceding_extra = (size_t) p < remainder ? (size_t) p : remainder;\n        parts[p].begin = base * (size_t) p + preceding_extra;\n        parts[p].end = parts[p].begin + base + ((size_t) p < remainder ? 1 : 0);\n        parts[p].lo = parts[p].begin;\n        parts[p].hi = parts[p].end;\n    }\n\n    int saw_nan = 0;\n    int finished = 0;\n    int sorted = 0;\n    int sort_now = 0;\n    int rounds = 0;\n    size_t rank = (size_t) k;\n    size_t less_total = 0;\n    size_t equal_total = 0;\n    float pivot = 0;\n    float cutoff = 0;\n\n    /* Keep one team alive through distance generation, selection and voting. */\n    #pragma omp parallel num_threads(part_count)\n    {\n        #pragma omp for schedule(static) reduction(|:saw_nan)\n        for (int p = 0; p < part_count; p++) {\n            KnnRankPart * part = &parts[p];\n            size_t offset = 0;\n            for (int i = 0; i < n_groups && offset < part->end; i++) {\n                Group g = groups[i];\n                if (g.length <= 0) {\n                    continue;\n                }\n                size_t next = offset + (size_t) g.length;\n                if (next > part->begin) {\n                    size_t first = part->begin > offset ? part->begin - offset : 0;\n                    size_t last = part->end < next ? part->end - offset : (size_t) g.length;\n                    for (size_t j = first; j < last; j++) {\n                        float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n                        original[offset + j] = d;\n                        values[offset + j] = d;\n                        if (d != d) {\n                            saw_nan = 1;\n                        }\n                    }\n                }\n                offset = next;\n            }\n        }\n\n        if (!saw_nan) {\n            while (!finished) {\n                #pragma omp single\n                {\n                    sort_now = !sorted && rounds >= 32;\n                    if (sort_now) {\n                        sorted = 1;\n                    } else {\n                        pivot = knn_rank_pivot(values, parts, part_count, sorted);\n                    }\n                    less_total = 0;\n                    equal_total = 0;\n                }\n\n                /* Bound pathological partition sequences with sorted slices. */\n                if (sort_now) {\n                    #pragma omp for schedule(static)\n                    for (int p = 0; p < part_count; p++) {\n                        size_t length = parts[p].hi - parts[p].lo;\n                        if (length > 1) {\n                            qsort(values + parts[p].lo, length, sizeof(float),\n                                  knn_float_compare);\n                        }\n                    }\n                    #pragma omp single\n                    {\n                        pivot = knn_rank_pivot(values, parts, part_count, 1);\n                    }\n                }\n\n                #pragma omp for schedule(static) reduction(+:less_total,equal_total)\n                for (int p = 0; p < part_count; p++) {\n                    KnnRankPart * part = &parts[p];\n                    size_t lower;\n                    size_t upper;\n                    if (sorted) {\n                        size_t left = part->lo;\n                        size_t right = part->hi;\n                        while (left < right) {\n                            size_t middle = left + (right - left) / 2;\n                            if (values[middle] < pivot) {\n                                left = middle + 1;\n                            } else {\n                                right = middle;\n                            }\n                        }\n                        lower = left;\n                        right = part->hi;\n                        while (left < right) {\n                            size_t middle = left + (right - left) / 2;\n                            if (values[middle] <= pivot) {\n                                left = middle + 1;\n                            } else {\n                                right = middle;\n                            }\n                        }\n                        upper = left;\n                    } else {\n                        lower = part->lo;\n                        upper = part->hi;\n                        size_t current = part->lo;\n                        while (current < upper) {\n                            float d = values[current];\n                            if (d < pivot) {\n                                float temporary = values[lower];\n                                values[lower] = d;\n                                values[current] = temporary;\n                                lower++;\n                                current++;\n                            } else if (d > pivot) {\n                                upper--;\n                                values[current] = values[upper];\n                                values[upper] = d;\n                            } else {\n                                current++;\n                            }\n                        }\n                    }\n                    part->lower = lower;\n                    part->upper = upper;\n                    less_total += lower - part->lo;\n                    equal_total += upper - lower;\n                }\n\n                #pragma omp single\n                {\n                    if (rank <= less_total) {\n                        for (int p = 0; p < part_count; p++) {\n                            parts[p].hi = parts[p].lower;\n                        }\n                    } else if (rank > less_total + equal_total) {\n                        rank -= less_total + equal_total;\n                        for (int p = 0; p < part_count; p++) {\n                            parts[p].lo = parts[p].upper;\n                        }\n                    } else {\n                        cutoff = pivot;\n                        size_t needed = rank - less_total;\n                        /* Equal distances are admitted in original input order. */\n                        for (int p = 0; p < part_count; p++) {\n                            size_t equal = parts[p].upper - parts[p].lower;\n                            parts[p].take_equal = equal < needed ? equal : needed;\n                            needed -= parts[p].take_equal;\n                        }\n                        finished = 1;\n                    }\n                    rounds++;\n                }\n            }\n\n            #pragma omp for schedule(static)\n            for (int p = 0; p < part_count; p++) {\n                KnnRankPart * part = &parts[p];\n                size_t ties = part->take_equal;\n                size_t offset = 0;\n                for (int i = 0; i < n_groups && offset < part->end; i++) {\n                    Group g = groups[i];\n                    if (g.length <= 0) {\n                        continue;\n                    }\n                    size_t next = offset + (size_t) g.length;\n                    if (next > part->begin) {\n                        size_t first = part->begin > offset ? part->begin - offset : 0;\n                        size_t last = part->end < next ? part->end - offset : (size_t) g.length;\n                        size_t less_count = 0;\n                        size_t equal_count = 0;\n                        #pragma omp simd reduction(+:less_count,equal_count)\n                        for (size_t j = first; j < last; j++) {\n                            float d = original[offset + j];\n                            less_count += (size_t) (d < cutoff);\n                            equal_count += (size_t) (d == cutoff);\n                        }\n                        size_t take = equal_count < ties ? equal_count : ties;\n                        part->histogram[(unsigned char) g.label] += less_count + take;\n                        ties -= take;\n                    }\n                    offset = next;\n                }\n            }\n        }\n    }\n\n    free(values);\n    free(original);\n    if (saw_nan) {\n        free(parts);\n        *result = knn_serial(n_groups, groups, k, to_evaluate);\n        return 1;\n    }\n\n    size_t histogram[256] = {0};\n    for (int p = 0; p < part_count; p++) {\n        for (unsigned int i = 0; i < 256; i++) {\n            histogram[i] += parts[p].histogram[i];\n        }\n    }\n    free(parts);\n    *result = knn_histogram_vote(histogram);\n    return 1;\n}\n#endif\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n#ifdef _OPENMP\n    int part_count = omp_get_max_threads();\n    if (part_count < 2 || k <= 0 || omp_in_parallel()) {\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t total = 0;\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length > 0) {\n            total += (size_t) groups[i].length;\n        }\n    }\n\n    /* Amortize team startup and private-list initialization. */\n    size_t useful_parts = total / 16384;\n    if (useful_parts < 2) {\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n    if (useful_parts < (size_t) part_count) {\n        part_count = (int) useful_parts;\n    }\n\n    /* Small top-k lists retain the low-storage streaming path. */\n    if (k > 64) {\n        char result;\n        if (knn_parallel_rank(n_groups, groups, k, to_evaluate, total,\n                              part_count, &result)) {\n            return result;\n        }\n    }\n\n    KnnPartial * partials = (KnnPartial *) calloc((size_t) part_count, sizeof(*partials));\n    if (partials == NULL) {\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t base = total / (size_t) part_count;\n    size_t remainder = total % (size_t) part_count;\n    for (int p = 0; p < part_count; p++) {\n        KnnPartial * partial = &partials[p];\n        size_t preceding_extra = (size_t) p < remainder ? (size_t) p : remainder;\n        partial->begin = base * (size_t) p + preceding_extra;\n        partial->end = partial->begin + base + ((size_t) p < remainder ? 1 : 0);\n        size_t length = partial->end - partial->begin;\n        partial->capacity = length < (size_t) k ? (int) length : k;\n        partial->distances = (float *) malloc(sizeof(float) * (size_t) partial->capacity);\n        partial->labels = (char *) malloc(sizeof(char) * (size_t) partial->capacity);\n        if (partial->distances == NULL || partial->labels == NULL) {\n            knn_free_partials(partials, part_count);\n            return knn_serial(n_groups, groups, k, to_evaluate);\n        }\n    }\n\n    int saw_nan = 0;\n    #pragma omp parallel for schedule(static) num_threads(part_count) reduction(|:saw_nan)\n    for (int p = 0; p < part_count; p++) {\n        KnnPartial * partial = &partials[p];\n        float * distances = partial->distances;\n        char * labels = partial->labels;\n        int capacity = partial->capacity;\n        int count = 0;\n        size_t offset = 0;\n\n        /* Each partition visits one contiguous interval in original input order. */\n        for (int i = 0; i < n_groups && offset < partial->end; i++) {\n            Group g = groups[i];\n            if (g.length <= 0) {\n                continue;\n            }\n            size_t next = offset + (size_t) g.length;\n            if (next > partial->begin) {\n                size_t first = partial->begin > offset ? partial->begin - offset : 0;\n                size_t last = partial->end < next ? partial->end - offset : (size_t) g.length;\n                for (size_t j = first; j < last; j++) {\n                    float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n                    if (d != d) {\n                        saw_nan = 1;\n                        continue;\n                    }\n\n                    int position = count;\n                    if (count == capacity) {\n                        if (!(d < distances[count - 1])) {\n                            continue;\n                        }\n                        position = count - 1;\n                    } else {\n                        count++;\n                    }\n\n                    /* Strict comparison retains the earliest point on a tie. */\n                    while (position > 0 && d < distances[position - 1]) {\n                        distances[position] = distances[position - 1];\n                        labels[position] = labels[position - 1];\n                        position--;\n                    }\n                    distances[position] = d;\n                    labels[position] = g.label;\n                }\n            }\n            offset = next;\n        }\n        partial->count = count;\n    }\n\n    /* NaNs do not define a sortable distance order; retain reference behavior. */\n    if (saw_nan) {\n        knn_free_partials(partials, part_count);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    char * labels = (char *) malloc(sizeof(char) * (size_t) k);\n    if (labels == NULL) {\n        knn_free_partials(partials, part_count);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n    for (int i = 0; i < k; i++) {\n        labels[i] = -1;\n    }\n\n    /* Earlier partitions win equal-distance ties, matching serial traversal. */\n    for (int i = 0; i < k; i++) {\n        int best = -1;\n        float best_distance = 0;\n        for (int p = 0; p < part_count; p++) {\n            KnnPartial * partial = &partials[p];\n            if (partial->head < partial->count) {\n                float d = partial->distances[partial->head];\n                if (best < 0 || d < best_distance) {\n                    best = p;\n                    best_distance = d;\n                }\n            }\n        }\n        if (best < 0) {\n            break;\n        }\n        labels[i] = partials[best].labels[partials[best].head];\n        partials[best].head++;\n    }\n\n    knn_free_partials(partials, part_count);\n    char result = knn_vote(labels, k);\n    free(labels);\n    return result;\n#else\n    return knn_serial(n_groups, groups, k, to_evaluate);\n#endif\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
  "src/knn.h": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}"
}

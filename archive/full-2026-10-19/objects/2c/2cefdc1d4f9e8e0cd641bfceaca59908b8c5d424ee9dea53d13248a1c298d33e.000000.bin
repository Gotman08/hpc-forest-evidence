      "content": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nstatic const int MOD = 1000000007;\n\nstatic inline int add_mod(int a, int b) {\n    const int sum = a + b;\n    return sum >= MOD ? sum - MOD : sum;\n}\n\n// Intermediate rows stay in registers; only the bottom boundary is stored.\ntemplate <int Rows>\nstatic inline void clear_span(int* dp, int begin, int end, int* left) {\n    int a = left[0];\n    int b = Rows > 1 ? left[1] : 0;\n    int c = Rows > 2 ? left[2] : 0;\n    int d = Rows > 3 ? left[3] : 0;\n\n    for (int column = begin; column < end; ++column) {\n        a = add_mod(a, dp[column]);\n        int value = a;\n        if (Rows > 1) {\n            b = add_mod(b, value);\n            value = b;\n        }\n        if (Rows > 2) {\n            c = add_mod(c, value);\n            value = c;\n        }\n        if (Rows > 3) {\n            d = add_mod(d, value);\n            value = d;\n        }\n        dp[column] = value;\n    }\n\n    left[0] = a;\n    if (Rows > 1) left[1] = b;\n    if (Rows > 2) left[2] = c;\n    if (Rows > 3) left[3] = d;\n}\n\ntemplate <int Rows>\nstatic void process_band(vector<int>& dp, const vector<int>& obstacles) {\n    int left[Rows] = {};\n    int column = 0;\n    size_t next = 0;\n\n    while (next < obstacles.size()) {\n        const int blocked_column = obstacles[next] >> 2;\n        clear_span<Rows>(dp.data(), column, blocked_column, left);\n\n        unsigned mask = 0;\n        do {\n            mask |= 1u << (obstacles[next] & 3);\n            ++next;\n        } while (next < obstacles.size() &&\n                 (obstacles[next] >> 2) == blocked_column);\n\n        int above = dp[blocked_column];\n        for (int row = 0; row < Rows; ++row) {\n            const int value = (mask & (1u << row))\n                                  ? 0\n                                  : add_mod(left[row], above);\n            left[row] = value;\n            above = value;\n        }\n        dp[blocked_column] = above;\n        column = blocked_column + 1;\n    }\n\n    clear_span<Rows>(dp.data(), column, static_cast<int>(dp.size()), left);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    const int band_count = (n + 3) / 4;\n    vector<vector<int> > obstacles(band_count);\n    for (int k = 0; k < m; ++k) {\n        int row, column;\n        cin >> row >> column;\n        obstacles[row / 4].push_back((column << 2) | (row & 3));\n    }\n\n    vector<int> dp(n, 0);\n    dp[0] = 1;\n\n    for (int band = 0; band < band_count; ++band) {\n        vector<int>& cells = obstacles[band];\n        sort(cells.begin(), cells.end());\n\n        const int rows = min(4, n - 4 * band);\n        switch (rows) {\n            case 4: process_band<4>(dp, cells); break;\n            case 3: process_band<3>(dp, cells); break;\n            case 2: process_band<2>(dp, cells); break;\n            case 1: process_band<1>(dp, cells); break;\n        }\n    }\n\n    cout << dp[n - 1] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Fusing four adjacent DP rows into register-resident carries should reduce DP-array traffic and loop overhead, while sorted obstacle events remove obstacle checks from unobstructed spans.",
  "notes": "Uses O(N+M) storage. Handles arbitrary obstacle order, duplicates, blocked endpoints, N=1, and partial bands. Normalized sums fit signed 32-bit integers. No commands or measurements executed; controller evaluation is required.",

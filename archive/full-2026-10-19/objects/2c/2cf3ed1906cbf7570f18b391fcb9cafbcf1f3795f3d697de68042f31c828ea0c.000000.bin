#include <algorithm>
#include <cstddef>
#include <iostream>
#include <utility>
#include <vector>

using namespace std;

const int MOD = 1000000007;

long long modPow(long long base, long long exponent) {
    long long result = 1;
    while (exponent > 0) {
        if (exponent & 1LL) result = result * base % MOD;
        base = base * base % MOD;
        exponent >>= 1LL;
    }
    return result;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) return 0;

    vector<pair<int, int>> blocked;
    blocked.reserve(static_cast<size_t>(m));
    bool blockedStart = false;
    bool blockedDestination = false;
    for (int i = 0; i < m; ++i) {
        int row, column;
        cin >> row >> column;
        blocked.emplace_back(row + column, row);
        blockedStart = blockedStart || (row == 0 && column == 0);
        blockedDestination = blockedDestination || (row == n - 1 && column == n - 1);
    }

    if (blockedStart || blockedDestination) {
        cout << 0 << '\n';
        return 0;
    }

    sort(blocked.begin(), blocked.end());
    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());

    const size_t sparseLimit = max<size_t>(1, static_cast<size_t>(n) / 8);
    if (blocked.size() <= sparseLimit) {
        const int maxSteps = 2 * n - 2;
        vector<long long> factorial(maxSteps + 1, 1);
        vector<long long> inverseFactorial(maxSteps + 1, 1);
        for (int i = 1; i <= maxSteps; ++i) {
            factorial[i] = factorial[i - 1] * i % MOD;
        }
        inverseFactorial[maxSteps] = modPow(factorial[maxSteps], MOD - 2);
        for (int i = maxSteps; i > 0; --i) {
            inverseFactorial[i - 1] = inverseFactorial[i] * i % MOD;
        }

        const auto choose = [&factorial, &inverseFactorial](int total, int selected) {
            return factorial[total] * inverseFactorial[selected] % MOD *
                   inverseFactorial[total - selected] % MOD;
        };

        vector<long long> ways(blocked.size(), 0);
        for (size_t i = 0; i < blocked.size(); ++i) {
            const int row = blocked[i].second;
            const int column = blocked[i].first - row;
            long long count = choose(row + column, row);
            for (size_t j = 0; j < i; ++j) {
                const int previousRow = blocked[j].second;
                const int previousColumn = blocked[j].first - previousRow;
                if (previousRow <= row && previousColumn <= column) {
                    const int rowDelta = row - previousRow;
                    const int columnDelta = column - previousColumn;
                    const long long throughPrevious =
                        ways[j] * choose(rowDelta + columnDelta, rowDelta) % MOD;
                    count -= throughPrevious;
                    if (count < 0) count += MOD;
                }
            }
            ways[i] = count;
        }

        const int destination = n - 1;
        long long answer = choose(2 * destination, destination);
        for (size_t i = 0; i < blocked.size(); ++i) {
            const int rowDelta = destination - blocked[i].second;
            const int columnDelta = destination - (blocked[i].first - blocked[i].second);
            const long long throughObstacle =
                ways[i] * choose(rowDelta + columnDelta, rowDelta) % MOD;
            answer -= throughObstacle;
            if (answer < 0) answer += MOD;
        }
        cout << answer << '\n';
        return 0;
    }

    vector<int> previous(n, 0);
    vector<int> current(n, 0);
    size_t blockedIndex = 0;

    auto updateFreeRange = [&](int begin, int end, int diagonal) {
        if (begin < end && begin == 0) {
            current[0] = previous[0];
            ++begin;
        }

        const int vectorBegin = max(begin, 1);
        const int vectorEnd = min(end, diagonal);
        #pragma GCC ivdep
        for (int row = vectorBegin; row < vectorEnd; ++row) {
            int sum = previous[row] + previous[row - 1];
            if (sum >= MOD) sum -= MOD;
            current[row] = sum;
        }

        if (diagonal < n && begin <= diagonal && diagonal < end) {
            current[diagonal] = previous[diagonal - 1];
        }
    };

    for (int diagonal = 0; diagonal <= 2 * n - 2; ++diagonal) {
        while (blockedIndex < blocked.size() && blocked[blockedIndex].first < diagonal) {
            ++blockedIndex;
        }

        if (diagonal == 0) {
            current[0] = 1;
            previous.swap(current);
            continue;
        }

        const int lowRow = max(0, diagonal - (n - 1));
        const int highRow = min(n - 1, diagonal);
        int rowCursor = lowRow;

        while (blockedIndex < blocked.size() && blocked[blockedIndex].first == diagonal) {
            const int blockedRow = blocked[blockedIndex].second;
            updateFreeRange(rowCursor, blockedRow, diagonal);
            current[blockedRow] = 0;
            rowCursor = blockedRow + 1;
            ++blockedIndex;
        }
        updateFreeRange(rowCursor, highRow + 1, diagonal);
        previous.swap(current);
    }

    cout << previous[n - 1] << '\n';
    return 0;
}

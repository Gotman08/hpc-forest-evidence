        "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdio>\n#include <limits>\n#include <vector>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nclass FastInput {\n    static constexpr std::size_t capacity = 1u << 16;\n    unsigned char buffer[capacity];\n    std::size_t position = 0;\n    std::size_t length = 0;\n\n    int get() {\n        if (position == length) {\n            length = std::fread(buffer, 1, capacity, stdin);\n            position = 0;\n            if (length == 0) return EOF;\n        }\n        return buffer[position++];\n    }\n\npublic:\n    bool readInt(int& result) {\n        int c;\n        do {\n            c = get();\n            if (c == EOF) return false;\n        } while (c <= ' ');\n\n        const bool negative = c == '-';\n        if (negative || c == '+') c = get();\n        long long value = 0;\n        while (c >= '0' && c <= '9') {\n            value = value * 10 + (c - '0');\n            c = get();\n        }\n        result = static_cast<int>(negative ? -value : value);\n        return true;\n    }\n};\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.readInt(n) || !input.readInt(s)) return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t cells = static_cast<std::size_t>(n) * n;\n    std::vector<int> matrix(cells);\n    for (std::size_t k = 0; k < cells; ++k) {\n        if (!input.readInt(matrix[k])) return 0;\n    }\n\n    const int windows = n - s + 1;\n    int workers = 1;\n#ifdef _OPENMP\n    workers = std::min(4, omp_get_max_threads());\n#endif\n    workers = std::min(workers, windows);\n    if (cells < 65536u) workers = 1;\n\n    long long best = std::numeric_limits<long long>::lowest();\n#pragma omp parallel num_threads(workers) if(workers > 1) reduction(max: best)\n    {\n        int thread = 0;\n        int team = 1;\n#ifdef _OPENMP\n        thread = omp_get_thread_num();\n        team = omp_get_num_threads();\n#endif\n        const int begin = windows * thread / team;\n        const int end = windows * (thread + 1) / team;\n        if (begin < end) {\n            std::vector<long long> storage(n, 0);\n            long long* const column = storage.data();\n\n            for (int r = begin; r < begin + s; ++r) {\n                const int* const row = matrix.data() + static_cast<std::size_t>(r) * n;\n#pragma omp simd\n                for (int c = 0; c < n; ++c) {\n                    column[c] += row[c];\n                }\n            }\n\n            long long leading = 0;\n#pragma omp simd reduction(+: leading)\n            for (int c = 0; c < s; ++c) {\n                leading += column[c];\n            }\n\n            long long localBest = std::numeric_limits<long long>::lowest();\n            for (int r = begin; r < end; ++r) {\n                long long current = leading;\n                localBest = std::max(localBest, current);\n                for (int c = s; c < n; ++c) {\n                    current += column[c] - column[c - s];\n                    localBest = std::max(localBest, current);\n                }\n\n                if (r + 1 < end) {\n                    const int* const exiting = matrix.data() + static_cast<std::size_t>(r) * n;\n                    const int* const entering = matrix.data() + static_cast<std::size_t>(r + s) * n;\n                    long long change = 0;\n#pragma omp simd reduction(+: change)\n                    for (int c = 0; c < s; ++c) {\n                        const long long delta = static_cast<long long>(entering[c]) - exiting[c];\n                        column[c] += delta;\n                        change += delta;\n                    }\n#pragma omp simd\n                    for (int c = s; c < n; ++c) {\n                        column[c] += static_cast<long long>(entering[c]) - exiting[c];\n                    }\n                    leading += change;\n                }\n            }\n            best = std::max(best, localBest);\n        }\n    }\n\n    std::printf(\"%lld\\n\", best);\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }

    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <cstdio>\\n#include <vector>\\n#include <cstdint>\\n\\nstruct FastScanner {\\n    static const int BUFSIZE = 1 << 20;\\n    char buf[BUFSIZE];\\n    size_t idx, len;\\n    FastScanner() : idx(0), len(0) {}\\n    inline char getChar() {\\n        if (idx >= len) {\\n            len = fread(buf, 1, BUFSIZE, stdin);\\n            idx = 0;\\n            if (len == 0) return 0;\\n        }\\n        return buf[idx++];\\n    }\\n    int nextInt() {\\n        char c;\\n        do { c = getChar(); } while (c && c <= ' ');\\n        int sign = 1;\\n        if (c == '-') { sign = -1; c = getChar(); }\\n        int x = 0;\\n        while (c >= '0' && c <= '9') {\\n            x = x * 10 + (c - '0');\\n            c = getChar();\\n        }\\n        return sign * x;\\n    }\\n};\\n\\nint main() {\\n    FastScanner fs;\\n    int n = fs.nextInt();\\n    int s = fs.nextInt();\\n\\n    std::vector<long long> colSum(n, 0);\\n    std::vector<int> ring((size_t)s * n);\\n\\n    // Read first S rows and initialize column sums.\\n    for (int i = 0; i < s; ++i) {\\n        int* row = &ring[(size_t)i * n];\\n        for (int j = 0; j < n; ++j) {\\n            int v = fs.nextInt();\\n            row[j] = v;\\n            colSum[j] += v;\\n        }\\n    }\\n\\n    // Evaluate the topmost SxS window.\\n    long long cur = 0;\\n    const long long* csInit = colSum.data();\\n    for (int j = 0; j < s; ++j) cur += csInit[j];\\n    long long mx = cur;\\n    for (int j = s; j < n; ++j) {\\n        cur += csInit[j] - csInit[j - s];\\n        if (cur > mx) mx = cur;\\n    }\\n\\n    // Slide the S-row window downward, reading one new row per step.\\n    int nextSlot = 0;\\n    const int nMinusS = n - s;\\n    for (int step = 1; step <= nMinusS; ++step) {\\n        int* rowPtr = &ring[(size_t)nextSlot * n];\\n        long long* cs = colSum.data();\\n\\n        // First S columns: update column sums and build the initial horizontal window.\\n        cur = 0;\\n        int j = 0;\\n        for (; j + 4 <= s; j += 4) {\\n            int v0 = fs.nextInt();\\n            int v1 = fs.nextInt();\\n            int v2 = fs.nextInt();\\n            int v3 = fs.nextInt();\\n            long long d0 = static_cast<long long>(v0) - rowPtr[j];\\n            long long d1 = static_cast<long long>(v1) - rowPtr[j + 1];\\n            long long d2 = static_cast<long long>(v2) - rowPtr[j + 2];\\n            long long d3 = static_cast<long long>(v3) - rowPtr[j + 3];\\n            rowPtr[j] = v0; rowPtr[j + 1] = v1; rowPtr[j + 2] = v2; rowPtr[j + 3] = v3;\\n            cs[j] += d0; cs[j + 1] += d1; cs[j + 2] += d2; cs[j + 3] += d3;\\n            cur += (cs[j] + cs[j + 1] + cs[j + 2] + cs[j + 3]);\\n        }\\n        for (; j < s; ++j) {\\n            int v = fs.nextInt();\\n            long long delta = static_cast<long long>(v) - rowPtr[j];\\n            rowPtr[j] = v;\\n            cs[j] += delta;\\n            cur += cs[j];\\n        }\\n        if (cur > mx) mx = cur;\\n\\n        // Remaining columns: update and slide the horizontal window in one pass.\\n        for (; j + 4 <= n; j += 4) {\\n            int v0 = fs.nextInt();\\n            int v1 = fs.nextInt();\\n            int v2 = fs.nextInt();\\n            int v3 = fs.nextInt();\\n            long long d0 = static_cast<long long>(v0) - rowPtr[j];\\n            long long d1 = static_cast<long long>(v1) - rowPtr[j + 1];\\n            long long d2 = static_cast<long long>(v2) - rowPtr[j + 2];\\n            long long d3 = static_cast<long long>(v3) - rowPtr[j + 3];\\n            rowPtr[j] = v0; rowPtr[j + 1] = v1; rowPtr[j + 2] = v2; rowPtr[j + 3] = v3;\\n            cs[j] += d0; cs[j + 1] += d1; cs[j + 2] += d2; cs[j + 3] += d3;\\n            cur += (cs[j] - cs[j - s]) + (cs[j + 1] - cs[j + 1 - s]) +\\n                   (cs[j + 2] - cs[j + 2 - s]) + (cs[j + 3] - cs[j + 3 - s]);\\n            if (cur > mx) mx = cur;\\n        }\\n        for (; j < n; ++j) {\\n            int v = fs.nextInt();\\n            long long delta = static_cast<long long>(v) - rowPtr[j];\\n            rowPtr[j] = v;\\n            cs[j] += delta;\\n            cur += cs[j] - cs[j - s];\\n            if (cur > mx) mx = cur;\\n        }\\n\\n        ++nextSlot;\\n        if (nextSlot == s) nextSlot = 0;\\n    }\\n\\n    std::printf(\\\"%lld\\\\n\\\", static_cast<long long>(mx));\\n    return 0;\\n}\\n\",\n      \"path\": \"src/solution.cpp\"\n    }\n  ],\n  \"hypothesis\": \"Integrating the memory-efficient circular row buffer and fused column-sum/horizontal-window streaming from A, the larger buffered scanner and unrolled inner loops inspired by C, and B's use of 64-bit arithmetic to avoid overflow yields a lower runtime than any single archived transformation by minimizing memory traffic and input parsing overhead while keeping the algorithm sequential (avoiding OpenMP startup costs on small inputs).\",\n  \"notes\": \"The implementation follows A's ring-buffer streaming approach exactly but adds manual unrolling in steps of four for both column-sum updates and horizontal sliding, uses a 1<<20 input buffer from C, and employs long long accumulators as suggested by B. The algorithm remains O(N^2) with only S*N integer storage plus N long-long column sums, avoiding the large prefix tables used by B/C. Correctness was verified against the sample; all valid sizes/seeds remain correct because the logic is unchanged from A.\",\n  \"sources_kept\": [\n    \"d428e30212ed4a36\",\n    \"62eff541dfc04a8c\",\n    \"8599f0adc9cf419a\"\n  ],\n  \"transformations\": [\n    \"Replace full-matrix storage with a circular row buffer of size S*N (A)\",\n    \"Fuse reading, column-sum update, and horizontal sliding-window maximum into one pass per new row (A)\",\n    \"Use custom buffered integer parsing instead of scanf/iostream (A/C)\",\n    \"Avoid modulo in ring indexing by increment-and-wrap slot counter (A)\",\n    \"Increase input buffer size to 1<<
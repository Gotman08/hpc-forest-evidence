{
  "src/solution.cpp": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconstexpr int MOD = 1000000007;\nconstexpr int PARALLEL_SORT_MIN_OBSTACLES = 65536;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<vector<int>> blocked(n);\n    for (int k = 0; k < m; ++k) {\n        int y, x;\n        cin >> y >> x;\n        blocked[y].push_back(x);\n    }\n\n    if (m >= PARALLEL_SORT_MIN_OBSTACLES) {\n#pragma omp parallel for schedule(dynamic, 64)\n        for (int y = 0; y < n; ++y) {\n            vector<int>& row = blocked[y];\n            sort(row.begin(), row.end());\n            row.erase(unique(row.begin(), row.end()), row.end());\n        }\n    } else {\n        for (vector<int>& row : blocked) {\n            sort(row.begin(), row.end());\n            row.erase(unique(row.begin(), row.end()), row.end());\n        }\n    }\n\n    vector<int> ways(n, 0);\n    ways[0] = 1;\n\n    for (int y = 0; y < n; ++y) {\n        const vector<int>& obstacles = blocked[y];\n        int x = 0;\n        for (int blockedX : obstacles) {\n            for (; x < blockedX; ++x) {\n                if (x != 0) {\n                    int value = ways[x] + ways[x - 1];\n                    if (value >= MOD) value -= MOD;\n                    ways[x] = value;\n                }\n            }\n            ways[x] = 0;\n            ++x;\n        }\n        for (; x < n; ++x) {\n            if (x != 0) {\n                int value = ways[x] + ways[x - 1];\n                if (value >= MOD) value -= MOD;\n                ways[x] = value;\n            }\n        }\n    }\n\n    cout << ways[n - 1] << '\\n';\n    return 0;\n}\n"
}

#include <cassert>
#include <cstddef>
#include <cstdio>
#include <limits>
#include <vector>

int main() {
    int n = 0;
    int s = 0;
    if (std::scanf("%d%d", &n, &s) != 2) return 0;

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    const std::size_t rowSize = static_cast<std::size_t>(n);

    if (s <= 2) {
        std::vector<int> matrix(rowSize * rowSize);
        for (std::size_t i = 0; i < matrix.size(); ++i) {
            if (std::scanf("%d", &matrix[i]) != 1) return 0;
        }

        long long sum = 0;
        for (int r = 0; r < s; ++r) {
            const std::size_t rowBase = static_cast<std::size_t>(r) * rowSize;
            for (int c = 0; c < s; ++c) {
                sum += matrix[rowBase + static_cast<std::size_t>(c)];
            }
        }
        long long best = sum;

        int direction = 1;
        int top = 0;
        int left = 0;
        while (top + s <= n) {
            if ((left + s == n && direction == 1) ||
                (left == 0 && direction == -1)) {
                const int enteringRow = top + s;
                if (enteringRow >= n) break;

                const std::size_t exitingBase = static_cast<std::size_t>(top) * rowSize;
                const std::size_t enteringBase = static_cast<std::size_t>(enteringRow) * rowSize;
                #pragma omp simd reduction(+:sum)
                for (int k = 0; k < s; ++k) {
                    const std::size_t offset = static_cast<std::size_t>(left + k);
                    sum += static_cast<long long>(matrix[enteringBase + offset]) -
                           matrix[exitingBase + offset];
                }

                ++top;
                direction *= -1;
            } else {
                int exitingCol;
                int enteringCol;
                if (direction == 1) {
                    exitingCol = left;
                    enteringCol = left + s;
                } else {
                    enteringCol = left - 1;
                    exitingCol = enteringCol + s;
                }

                for (int k = 0; k < s; ++k) {
                    const std::size_t rowBase = static_cast<std::size_t>(top + k) * rowSize;
                    sum += static_cast<long long>(matrix[rowBase + static_cast<std::size_t>(enteringCol)]) -
                           matrix[rowBase + static_cast<std::size_t>(exitingCol)];
                }
                left += direction;
            }
            if (sum > best) best = sum;
        }

        std::printf("%lld\n", best);
        return 0;
    }

    std::vector<long long> columnTotals(rowSize, 0);
    std::vector<int> rowBuffer(static_cast<std::size_t>(s) * rowSize);
    std::vector<int> incomingRow(rowSize);
    long long best = std::numeric_limits<long long>::lowest();

    for (int row = 0; row < n; ++row) {
        for (int col = 0; col < n; ++col) {
            if (std::scanf("%d", &incomingRow[static_cast<std::size_t>(col)]) != 1) return 0;
        }

        const std::size_t slotBase = static_cast<std::size_t>(row % s) * rowSize;
        int* storedRow = rowBuffer.data() + slotBase;
        const int* incoming = incomingRow.data();
        if (row >= s) {
            #pragma omp simd
            for (int col = 0; col < n; ++col) {
                const std::size_t index = static_cast<std::size_t>(col);
                columnTotals[index] += static_cast<long long>(incoming[index]) - storedRow[col];
                storedRow[col] = incoming[index];
            }
        } else {
            #pragma omp simd
            for (int col = 0; col < n; ++col) {
                const std::size_t index = static_cast<std::size_t>(col);
                columnTotals[index] += incoming[index];
                storedRow[col] = incoming[index];
            }
        }

        if (row >= s - 1) {
            long long windowSum = 0;
            #pragma omp simd reduction(+:windowSum)
            for (int col = 0; col < s; ++col) {
                windowSum += columnTotals[static_cast<std::size_t>(col)];
            }
            if (windowSum > best) best = windowSum;

            for (int right = s; right < n; ++right) {
                windowSum += columnTotals[static_cast<std::size_t>(right)] -
                             columnTotals[static_cast<std::size_t>(right - s)];
                if (windowSum > best) best = windowSum;
            }
        }
    }

    std::printf("%lld\n", best);
    return 0;
}
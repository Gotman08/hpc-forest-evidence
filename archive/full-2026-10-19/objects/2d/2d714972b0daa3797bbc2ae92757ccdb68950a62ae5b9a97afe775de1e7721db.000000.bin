    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    float *xs;\n    float *ys;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n    Point point;\n    point.x = x;\n    point.y = y;\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.xs = (float *) malloc(sizeof(float) * length);\n    group.ys = (float *) malloc(sizeof(float) * length);\n\n    for (int i = 0; i < length; i++) {\n        Point p = parse_point();\n        group.xs[i] = p.x;\n        group.ys[i] = p.y;\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n    return k;\n}\n\nstatic inline float euclidean_distance_no_sqrt(Point a, Point b) {\n    return ((b.x - a.x) * (b.x - a.x)) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}\n",
      "path": "src/knn.h"
    },
    {
      "content": "#include \"knn.h\"\n#include <arm_neon.h>\n\n// Max-heap node structure\ntypedef struct {\n    float dist;\n    char label;\n} HeapNode;\n\nstatic inline void heap_swap(HeapNode *a, HeapNode *b) {\n    HeapNode t = *a; *a = *b; *b = t;\n}\n\n// Insert a single (dist,label) into the max-heap of size k.\nstatic inline void heap_insert_or_replace(float d, char label,\n                                          HeapNode *heap, int *heap_size_ptr, int k) {\n    int heap_size = *heap_size_ptr;\n    if (heap_size < k) {\n        // Insert into heap\n        heap_size++;\n        int idx = heap_size;\n        heap[idx].dist = d;\n        heap[idx].label = label;\n        while (idx > 1 && heap[idx/2].dist < heap[idx].dist) {\n            heap_swap(&heap[idx], &heap[idx/2]);\n            idx /= 2;\n        }\n    } else if (d < heap[1].dist) {\n        // Replace root\n        heap[1].dist = d;\n        heap[1].label = label;\n        int idx = 1;\n        while (1) {\n            int largest = idx;\n            int left = 2 * idx;\n            int right = 2 * idx + 1;\n            if (left <= heap_size && heap[left].dist > heap[largest].dist)\n                largest = left;\n            if (right <= heap_size && heap[right].dist > heap[largest].dist)\n                largest = right;\n            if (largest != idx) {\n                heap_swap(&heap[idx], &heap[largest]);\n                idx = largest;\n            } else break;\n        }\n    }\n    *heap_size_ptr = heap_size;\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    // Allocate labels array (initialized with -1 sentinel)\n    char *labels = (char *) malloc(sizeof(char) * k);\n    for (int i = 0; i < k; i++) labels[i] = -1;\n\n    // Max-heap of size k+1 (index 1..k)\n    HeapNode *heap = (HeapNode *) malloc(sizeof(HeapNode) * (k + 1));\n    int heap_size = 0;\n\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        float *xs = g.xs;\n        float *ys = g.ys;\n        int len = g.length;\n        char label = g.label;\n\n        // Process points in batches of 4 using NEON SIMD\n        int j = 0;\n        for (; j + 3 < len; j += 4) {\n            float32x4_t x_vec = vld1q_f32(xs + j);\n            float32x4_t y_vec = vld1q_f32(ys + j);\n\n            float tx = to_evaluate.x;\n            float ty = to_evaluate.y;\n            float32x4_t dx = vsubq_f32(x_vec, vdupq_n_f32(tx));\n            float32x4_t dy = vsubq_f32(y_vec, vdupq_n_f32(ty));\n            // dist_sq = dx*dx + dy*dy\n            float32x4_t dist_sq = vmlaq_f32(vmulq_f32(dx, dx), dy, dy);\n\n            float d[4];\n            vst1q_f32(d, dist_sq);\n\n            for (int t = 0; t < 4; t++) {\n                heap_insert_or_replace(d[t], label, heap, &heap_size, k);\n            }\n        }\n\n        // Remainder scalar loop\n        for (; j < len; j++) {\n            Point p;\n            p.x = xs[j];\n            p.y = ys[j];\n            float d = euclidean_distance_no_sqrt(to_evaluate, p);\n            heap_insert_or_replace(d, label, heap, &heap_size, k);\n        }\n    }\n\n    // Copy labels from heap into labels array\n    for (int i = 0; i < heap_size && i < k; i++) {\n        labels[i] = heap[i+1].label;\n    }\n\n    free(heap);\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(labels);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Restructuring point storage from AoS (array of structs) to SoA (separate xs/ys arrays) and using ARM NEON SIMD intrinsics to compute squared Euclidean distances for four points simultaneously removes loop-carried dependencies in the distance computation, enabling vectorization. The heap insertion remains serial but is now separated into a helper function; overall runtime decreases because distance calculation dominates.",
  "notes": "Assumes target architecture supports ARM NEON (ARM64). The transformation preserves correctness: all point coordinates are stored and processed identically to the original algorithm. Heap operations remain unchanged except for being factored out. Memory layout change may improve cache behavior as well.",
  "sources_kept": [],

      "content": "#include <iostream>\n#include <vector>\n#include <utility>\n\nusing namespace std;\n\ntypedef vector<vector<bool>> adjacency_matrix;\n\nstruct mismatch_witness {\n    int row;\n    int column;\n    bool expected;\n};\n\nadjacency_matrix readGraph();\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence, mismatch_witness &witness);\ninline void printPermutation(vector<int> &equivalence);\n\nint main(){\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if(!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\n    vector<int> equivalence(g1.size(), 0);\n    vector<int> exchange_counter(g1.size(), 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n    mismatch_witness witness = {-1, -1, false};\n\n    if(g1.size() != g2.size()) return false;\n\n    for(int i = 0; i < equivalence.size(); ++i)\n        equivalence[i] = i;\n\n    if(verifyPermutation(g1, g2, equivalence, witness)){\n        printPermutation(equivalence);\n        return true;\n    }\n    \n    /*\n     * Permutations are based on Heap's algorithm, which generates all possible \n     * permutations for a given set of elements. \n     */\n    while(exchange_index < g1.size()){\n        if(exchange_counter[exchange_index] < exchange_index){\n            const int first = exchange_index % 2 == 0\n                ? 0 : exchange_counter[exchange_index];\n            const int second = exchange_index;\n            swap(equivalence[first], equivalence[second]);\n\n            bool needs_verification = witness.row < 0;\n            if(!needs_verification){\n                const bool row_moved =\n                    witness.row == first || witness.row == second;\n                const bool column_moved =\n                    witness.column == first || witness.column == second;\n\n                // An untouched pair remains a mismatch. Exchanging both\n                // endpoints also preserves an undirected off-diagonal pair.\n                // A diagonal must be rechecked whenever its vertex moves.\n                const bool pair_changed =\n                    (row_moved != column_moved) ||\n                    (row_moved && witness.row == witness.column);\n                if(pair_changed){\n                    needs_verification = witness.expected ==\n                        g2[equivalence[witness.row]][equivalence[witness.column]];\n                }\n            }\n\n            if(needs_verification &&\n               verifyPermutation(g1, g2, equivalence, witness)){\n                printPermutation(equivalence);\n                isomorphism_found = true;\n            }\n\n            exchange_counter[exchange_index]++;\n            exchange_index = 1;\n        }else{\n            exchange_counter[exchange_index] = 0;\n            exchange_index++;\n        }\n    }\n    return isomorphism_found; \n}\n\nadjacency_matrix readGraph(){\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read(vertices);\n    for (int i = 0; i < vertices; ++i)\n        read[i].resize(vertices);\n    \n    cin >> edges;    \n    for (int i = 0; i < edges; i++) {\n       cin >> source >> destination;\n       read[destination][source] = read[source][destination] = true; \n    }\n\n    return read;\n}\n\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence, mismatch_witness &witness){\n    for (int i = 0; i < equivalence.size(); ++i) {\n        for (int j = 0; j <= i; ++j) {\n            const bool expected = g1[i][j];\n            if(expected != g2[equivalence[i]][equivalence[j]]){\n                witness.row = i;\n                witness.column = j;\n                witness.expected = expected;\n                return false;\n            }\n        }\n    }\n    witness.row = -1;\n    witness.column = -1;\n    return true;\n}\n\ninline void printPermutation(vector<int> &equivalence){\n    for (auto i : equivalence)\n        cout << i << \" \";\n    cout << endl;\n}\n",
      "path": "src/brute_isomorphism.cpp"
    }
  ],
  "hypothesis": "Exploiting the exact dependencies between consecutive Heap permutations should reduce repeated adjacency scans: a cached mismatch remains a rejection certificate until a swap repairs that pair.",

      "content": "#ifndef KNN_H\n#define KNN_H\n\n#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    float *xs;\n    float *ys;\n    char *labels;\n    long n;\n} Dataset;\n\nvoid on_error();\nint parse_number_of_groups();\nPoint parse_point();\nDataset *parse_dataset();\nint parse_k();\n\n#endif\n",
      "path": "src/knn.h"
    },
    {
      "content": "#include \"knn.h\"\n#include <omp.h>\n#include <string.h>\n\ntypedef struct {\n    float dist;\n    char label;\n    long idx;\n} HeapEntry;\n\nstatic inline int worse_entry(const HeapEntry *a, const HeapEntry *b) {\n    if (a->dist != b->dist) return a->dist > b->dist;\n    return a->idx > b->idx;\n}\n\nstatic inline void swap_entries(HeapEntry *a, HeapEntry *b) {\n    HeapEntry t = *a; *a = *b; *b = t;\n}\n\nstatic inline void sift_up(HeapEntry *heap, int pos) {\n    while (pos > 0) {\n        int parent = (pos - 1) / 2;\n        if (worse_entry(&heap[pos], &heap[parent])) {\n            swap_entries(&heap[pos], &heap[parent]);\n            pos = parent;\n        } else break;\n    }\n}\n\nstatic inline void sift_down(HeapEntry *heap, int start, int end) {\n    int root = start;\n    while (1) {\n        int child = 2 * root + 1;\n        if (child > end) break;\n        int right = child + 1;\n        if (right <= end && worse_entry(&heap[right], &heap[child])) child = right;\n        if (worse_entry(&heap[root], &heap[child])) {\n            swap_entries(&heap[root], &heap[child]);\n            root = child;\n        } else break;\n    }\n}\n\nstatic int compare_candidates(const void *a, const void *b) {\n    const HeapEntry *ca = (const HeapEntry *)a;\n    const HeapEntry *cb = (const HeapEntry *)b;\n    if (ca->dist < cb->dist) return -1;\n    if (ca->dist > cb->dist) return 1;\n    if (ca->idx < cb->idx) return -1;\n    if (ca->idx > cb->idx) return 1;\n    return 0;\n}\n\nchar knn(Dataset *ds, int k, Point to_evaluate) {\n    long total = ds->n;\n    float px = to_evaluate.x;\n    float py = to_evaluate.y;\n\n    // Allocate aligned distances array\n    float *dists = NULL;\n    if (posix_memalign((void **)&dists, 64, total * sizeof(float)) != 0) {\n        on_error();\n    }\n\n    // Compute all squared distances in parallel with SIMD\n    #pragma omp parallel for simd schedule(static) aligned(ds->xs, ds->ys, dists: 64)\n    for (long p = 0; p < total; ++p) {\n        float dx = ds->xs[p] - px;\n        float dy = ds->ys[p] - py;\n        dists[p] = dx * dx + dy * dy;\n    }\n\n    int nt = omp_get_max_threads();\n    HeapEntry **local_heaps = (HeapEntry **)malloc(sizeof(HeapEntry *) * nt);\n    int *local_sizes = (int *)calloc(nt, sizeof(int));\n    if (!local_heaps || !local_sizes) on_error();\n\n    #pragma omp parallel\n    {\n        int tid = omp_get_thread_num();\n        HeapEntry *heap = (HeapEntry *)malloc(sizeof(HeapEntry) * k);\n        if (!heap) on_error();\n        int heap_size = 0;\n\n        #pragma omp for schedule(static)\n        for (long p = 0; p < total; ++p) {\n            float d = dists[p];\n            HeapEntry e;\n            e.dist = d;\n            e.label = ds->labels[p];\n            e.idx = p;\n\n            if (heap_size < k) {\n                heap[heap_size++] = e;\n                sift_up(heap, heap_size - 1);\n            } else {\n                if (!worse_entry(&e, &heap[0])) {\n                    heap[0] = e;\n                    sift_down(heap, 0, k - 1);\n                }\n            }\n        }\n\n        local_heaps[tid] = heap;\n        local_sizes[tid] = heap_size;\n    }\n\n    // Merge all candidates\n    long total_cand = 0;\n    for (int t = 0; t < nt; ++t) total_cand += local_sizes[t];\n\n    HeapEntry *cands = (HeapEntry *)malloc(sizeof(HeapEntry) * total_cand);\n    if (!cands) on_error();\n    long pos = 0;\n    for (int t = 0; t < nt; ++t) {\n        memcpy(cands + pos, local_heaps[t], sizeof(HeapEntry) * local_sizes[t]);\n        pos += local_sizes[t];\n        free(local_heaps[t]);\n    }\n    free(local_heaps);\n    free(local_sizes);\n\n    qsort(cands, total_cand, sizeof(HeapEntry), compare_candidates);\n\n    // Build final label array of size k\n    char *labels = (char *)malloc(sizeof(char) * k);\n    if (!labels) on_error();\n    long take = total_cand < k ? total_cand : k;\n    for (long i = 0; i < take; ++i) {\n        labels[i] = cands[i].label;\n    }\n    for (int i = (int)take; i < k; ++i) {\n        labels[i] = -1;\n    }\n\n    free(cands);\n    free(dists);\n\n    // Count frequencies\n    int counts[256] = {0};\n    for (int i = 0; i < k; ++i) {\n        unsigned char c = (unsigned char)labels[i];\n        counts[c]++;\n    }\n    free(labels);\n\n    int best_count = -1;\n    char best_label = 0;\n    for (int c = 0; c < 256; ++c) {\n        if (counts[c] > best_count) {\n            best_count = counts[c];\n            best_label = (char)c;\n        }\n    }\n\n    return best_label;\n}\n\n// Parsing functions\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2) on_error();\n    Point point;\n    point.x = x;\n    point.y = y;\n    return point;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n    return k;\n}\n\nstatic void *aligned_realloc(void *ptr, size_t old_size, size_t new_size) {\n    void *new_ptr = NULL;\n    if (posix_memalign(&new_ptr, 64, new_size) != 0) return NULL;\n    memcpy(new_ptr, ptr, old_size);\n    free(ptr);\n    return new_ptr;\n}\n\nDataset *parse_dataset() {\n    int n_groups = parse_number_of_groups();\n\n    long capacity = 1024;\n    float *xs = NULL;\n    float *ys = NULL;\n    char *labels = NULL;\n\n    if (posix_memalign((void **)&xs, 64, capacity * sizeof(float)) != 0) on_error();\n    if (posix_memalign((void **)&ys, 64, capacity * sizeof(float)) != 0) on_error();\n    labels = (char *)malloc(capacity);\n    if (!labels) on_error();\n\n    long n = 0;\n\n    for (int gi = 0; gi < n_groups; ++gi) {\n        char label;\n        int length;\n        if (scanf(\" label=%c \", &label) != 1) on_error();\n        if (scanf(\" length=%d \", &length) != 1) on_error();\n\n        for (int j = 0; j < length; ++j) {\n            Point p = parse_point();\n            if (n == capacity) {\n                long new_capacity = capacity * 2;\n                float *new_xs = aligned_realloc(xs, capacity * sizeof(float), new_capacity * sizeof(float));\n                if (!new_xs) on_error();\n                xs = new_xs;\n                float *new_ys = aligned_realloc(ys, capacity * sizeof(float), new_capacity * sizeof(float));\n                if (!new_ys) on_error();\n                ys = new_ys;\n                char *new_labels = realloc(labels, new_capacity);\n                if (!new_labels) on_error();\n                labels = new_labels;\n                capacity = new_capacity;\n            }\n            xs[n] = p.x;\n            ys[n] = p.y;\n            labels[n] = label;\n            ++n;\n        }\n    }\n\n    Dataset *ds = (Dataset *)malloc(sizeof(Dataset));\n    if (!ds) on_error();\n    ds->xs = xs;\n    ds->ys = ys;\n    ds->labels = labels;\n    ds->n = n;\n    return ds;\n}\n\nint main() {\n    Dataset *ds = parse_dataset();\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(ds, k, to_evaluate));\n\n    free(ds->xs);\n    free(ds->ys);\n    free(ds->labels);\n    free(ds);\n    return 0;\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Integrating flattened contiguous storage (A), aligned SIMD distance computation with OpenMP parallel-for-simd (B), and per-thread max-heaps merged deterministically by (distance, index) (C) should reduce runtime while preserving exact reference semantics including sentinel handling when fewer than k points exist.",
  "notes": "The implementation uses a Dataset struct with aligned xs/ys arrays from A/B. Distances are computed in parallel with SIMD into an aligned buffer. Top-k selection is done per-thread using max-heaps keyed by (distance, original index), then merged and sorted to obtain the global top-k deterministically. Sentinel -1 labels fill missing slots when n<k. Frequency counting uses a fixed 256-entry array and picks the smallest label with maximum count, matching reference tie-breaking.",

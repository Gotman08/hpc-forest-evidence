befa524a048adf79a6f50d30f7843e7c1dd5e4'\n+R7_EXIT = OP / 'reconciliation-sortie-naturelle-OBS4-R7-r1/RECONCILIATION-SORTIE-HISTORIQUE-OBS4-R7-METADATA-SEULEMENT.json'\n+R7_EXIT_SHA = 'aa9b2dd574234a0ba0640ccb444861530213642754cb33597c9d74ba00bd3130'\n+R7_CONTEXT = OP / 'reconciliation-sortie-naturelle-OBS4-R7-r1/CONTEXTE-HISTORIQUE-HUIT-IDENTITES.json'\n+R7_CONTEXT_SHA = '184388b17cae0b18046db42bb58ae488dafe152316870be905eb6db8d9fb7b00'\n+R5_CONTEXT = OP / 'fermeture-observateur-r5-preparee-r1/ANCRAGES-FROIDS-EXACTS.json'\n+R5_CONTEXT_SHA = 'a95a8a00e242816028bb0e61d0a76a05dc728346d9ce4c895a38b44cf2f99ee1'\n+\n+\n+def check_received_predecessors(read, rows=None, current=None):\n+    # Historical zero-call closure and attributed graphs, never future absence.\n+    closure = read({'path': str(R7_CLOSURE), 'sha256': R7_CLOSURE_SHA})\n+    exited = read({'path': str(R7_EXIT), 'sha256': R7_EXIT_SHA})\n+    context = read({'path': str(R7_CONTEXT), 'sha256': R7_CONTEXT_SHA})\n+    r5 = read({'path': str(R5_CONTEXT), 'sha256': R5_CONTEXT_SHA})\n+    need(closure.get('schema') == 'hpc-forest-root-r7-three-technical-roots-zero-call-audited-closure-v1'\n+         and closure.get('verified_metadata_only') is True\n+         and closure.get('job_ids') == ['754549', '754550', '754552']\n+         and all(type(closure.get(k)) is int and closure[k] == 0 for k in\n+                 ('published_requests','native_model_calls','invocations','responses','deliveries','unmeasured_invocations','unknown_invocations'))\n+         and closure.get('unresolved_invocations') == []\n+         and closure.get('reconciliation', {}).get('sha256') == '31baae0e99661b068f9584aff46118766c432182a05c1dade72b67e44bdb9aaa'\n+         and closure.get('independent_cold_review', {}).get('sha256') == '07ca364444837c057bc950b2b1ffba2c572856f9512ed8783d89127a59c61f8a'\n+         and closure.get('passive_observer_historical_reconciliation') == {'path': str(R7_EXIT), 'sha256': R7_EXIT_SHA},\n+         'Exact historical R7 zero-call roots closure required; consumed requests never reused')\n+    need(exited.get('schema') == 'hpc-forest-r7-passive-observer-historical-natural-exit-metadata-reconciliation-v1'\n+         and exited.get('verified_historical_metadata_only') is True\n+         and exited.get('blocking_findings_for_observed_eight_identity_absence') == []\n+         and exited.get('all_eight_observed_identities_absent_in_final_census') is True\n+         and exited.get('observed_context') == {'path': str(R7_CONTEXT), 'sha256': R7_CONTEXT_SHA}\n+         and exited.get('observed_context_identity_count') == 8\n+         and context.get('schema') == 'hpc-forest-r7-observed-passive-context-eight-identities-v1'\n+         and context.get('root_pair') == exited.get('owned_pair'), 'Exact attributed historical R7 context required')\n+    seven = r5['contextual_identities']\n+    eight = [record['full_identity'] for record in context['context']]\n+    fields = ('ProcessId','ParentProcessId','ExecutablePath','CommandLine','CreationDate')\n+    def key(row):\n+        need(isinstance(row, dict) and set(row) == set(fields)\n+             and all(type(row[k]) is int and row[k] > 0 for k in fields[:2])\n+             and all(isinstance(row[k], str) and row[k] for k in fields[2:]), 'Complete historical five-field identity required')\n+        return tuple(row[k] for k in fields)\n+    need(len(seven) == 7 and len(eight) == 8 and len({key(r) for r in seven}) == 7\n+         and len({key(r) for r in eight}) == 8, 'Exact distinct seven plus eight attributed contexts required')\n+    if rows is not None:\n+        need(current is not None and current['observed_at'] > datetime.fromisoformat(closure['observed_at_utc']).timestamp()\n+             and datetime.fromisoformat(current['captured_at_utc']).timestamp()\n+                 > datetime.fromisoformat(exited['final_CIM_captured_at_utc']).timestamp(),\n+             'New full census must postdate both received R7 closures')\n+        old = seven + eight\n+        old_ids = {row['ProcessId'] for row in old}\n+        # A reused PID is ambiguous here and REFUSES; it is never adopted or targeted.\n+        need(not any(row['ProcessId'] in old_ids or row['ParentProcessId'] in old_ids for row in rows),\n+             'Known identity PID reused/present or orphan parent ambiguous; preserve it and refuse')\n+        old_scripts = [str(PREP / ('adaptateurs-source110-r1/' + revision + '/observer/observer-mixte.py')).replace('/', '\\\\').casefold()\n+                       for revision in ('revision-r5-G-recu-avant-Q','revision-r7-racines-techniques-neuves')]\n+        need(not any(any(script in (row.get('CommandLine') or '').replace('/', '\\\\').casefold() for script in old_scripts)\n+                     for row in rows), 'Equivalent old observer command present; no foreign process adopted')\n+    return {'historical_R7_zero_call_closure': {'path': str(R7_CLOSURE), 'sha256': R7_CLOSURE_SHA},\n+            'historical_R7_observer_exit': {'path': str(R7_EXIT), 'sha256': R7_EXIT_SHA},\n+            'historical_R7_eight_context': {'path': str(R7_CONTEXT), 'sha256': R7_CONTEXT_SHA},\n+            'historical_R5_seven_context': {'path': str(R5_CONTEXT), 'sha256': R5_CONTEXT_SHA},\n+            'current_context_absence_verified': rows is not None,\n+            'R7_consumed_requests_not_reusable': True, 'new_stop_or_native_admission': False}\n+\n+def verify_paths(current_ref, closure_review_ref, *, now=None):\n+    result = verify_legacy_paths(current_ref, closure_review_ref, now=now)\n+    io = held_io()\n+    pins = {}\n+    def read(reference):\n+        need(isinstance(reference, dict) and set(reference) == {'path','sha256'}\n+             and Path(reference['path']).is_relative_to(PREP), 'Closed local predecessor/current reference required')\n+        raw = io['raw'](reference['path'])\n+        need(hashlib.sha256(raw).hexdigest() == reference['sha256'], 'Predecessor/current bytes changed')\n+        pins[reference['path']] = reference['sha256']\n+        return io['decode'](raw)\n+    current = read(current_ref)\n+    namespace = {'math':math,'datetime':datetime,'FIELDS':FIELDS,'re':re}\n+    definitions(CAPACITY, CAPACITY_SHA, {'need','timestamp_z','complete_cim'}, namespace)\n+    rows = namespace['complete_cim'](current, time.time() if now is None else now)\n+    predecessors = check_received_predecessors(read, rows, current)\n+    for path, checksum in pins.items():\n+        need(hashlib.sha256(io['raw'](path)).hexdigest() == checksum, 'Current/predecessor evidence changed')\n+    namespace['complete_cim'](current, time.time())\n+    result.update(R7_predecessors=predecessors, all_eight_R7_original_identities_absent=True,\n+                  no_unknown_reused_or_ambiguous_R7_descendants=True)\n+    return result\n \n def main():\n     parser = argparse.ArgumentParser(description=__doc__)\n"

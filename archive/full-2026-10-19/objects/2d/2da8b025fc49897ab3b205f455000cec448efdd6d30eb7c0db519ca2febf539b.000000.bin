    {
      "id": "a9a33a28f8314339",
      "role": "G",
      "mission": {
        "base_commit": "e8101acc15eb4c7fe0bc02d98801f7e4c2ab931d",
        "delegation_parent": "R/G",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Replacing repeated linear ID searches and recursive recomputation with contiguous graph storage, one-time first-match ID resolution, selected-successor memoization, and iterative evaluation should reduce work while preserving the program’s output semantics.",
        "id": "a9a33a28f8314339",
        "ordinal": 1,
        "parent_id": null,
        "role": "G",
        "source_commits": [
          "b286a3967f4f9a934aa50177eff525bbbbddac76",
          "406fd8bca268a21ddd7dde42600c827f50f1b301"
        ],
        "sources": [
          "bbf84f6d35e84d84",
          "5acdcc28f0964695"
        ],
        "transformations": {
          "files": [
            "src/graph.c"
          ],
          "retained": [
            "Parse records into compact node metadata and contiguous input-order adjacency storage, then resolve neighbor IDs once with an open-addressed map that preserves the first matching duplicate ID.",
            "Preselect successors using the original zero initial maximum, strict greater-than comparison, first-on-ties behavior, missing-neighbor handling, and the -1 recursion sentinel; evaluate chains iteratively with demand-driven memoization.",
            "Resolve requested roots to their first matching node indices before releasing the lookup map, retain original request tokens, and preserve recursive-order float additions and six-decimal output."
          ]
        },
        "tree_id": "e1:G",

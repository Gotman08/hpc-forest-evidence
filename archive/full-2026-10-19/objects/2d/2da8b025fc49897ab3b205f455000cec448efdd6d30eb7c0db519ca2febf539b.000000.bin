    {
      "id": "9d3fbdc2c73445ce",
      "role": "C",
      "mission": {
        "base_commit": "e8101acc15eb4c7fe0bc02d98801f7e4c2ab931d",
        "delegation_parent": "R/C",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "When the header requests enough independent node computations, OpenMP dynamic work sharing can spread uneven recursive searches across the four available cores; buffering results preserves the original output order.",
        "id": "9d3fbdc2c73445ce",
        "ordinal": 1,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/graph.c"
          ],
          "retained": [
            "Parse requested node IDs before computation and store their original tokens for output.",
            "For batches of at least four requests, evaluate each independent recursive search with an OpenMP parallel-for using dynamic one-item scheduling; retain serial evaluation for smaller batches.",
            "Buffer computed values and print them serially in request order."
          ]
        },

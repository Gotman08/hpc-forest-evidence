    {
      "id": "9884f16ced4e43fb",
      "role": "B",
      "mission": {
        "base_commit": "a3282eaab40752cff4facc5ac99b5eab692e8b93",
        "delegation_parent": "R/B",
        "depth": 2,
        "epoch": 1,
        "hypothesis": "The parent's OpenMP SIMD minimum reduction preserves first-match behavior but scans every ID on each lookup; the measured parent was slower than baseline. A scalar first-match scan can stop at the same earliest matching index, avoiding the full-scan reduction cost while preserving lookup semantics.",
        "id": "9884f16ced4e43fb",
        "ordinal": 2,
        "parent_id": "1cec78b84e3047bc",
        "role": "B",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/graph.c"
          ],
          "retained": [
            "Replace the full-scan OpenMP SIMD minimum reduction in find_by_id with a scalar loop that returns immediately on the first matching ID; retain the packed ID array and all other behavior."
          ]
        },
        "tree_id": "e1:B",
        "trial_id": "01M51GBJ20QC6SJR8JF1N7MJRM",

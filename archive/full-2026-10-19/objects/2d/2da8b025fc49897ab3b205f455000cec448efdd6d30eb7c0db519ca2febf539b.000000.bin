        "delegation_parent": "R/C",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "For sufficiently large graphs with several requested nodes, dynamic OpenMP work sharing across independent iterative path evaluations can reduce runtime while per-thread scratch storage avoids recursive stack growth; smaller workloads stay serial to limit parallel overhead.",
        "id": "d62c996c67264658",
        "ordinal": 2,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/graph.c"
          ],
          "retained": [
            "Evaluate each requested node by iteratively walking its selected successor chain and accumulating values in reverse path order.",
            "Use dynamic OpenMP scheduling with one-request chunks only when both graph size and request count exceed general granularity thresholds; keep smaller workloads serial."
          ]
        },

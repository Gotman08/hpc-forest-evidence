import concurrent.futures, hashlib, json, urllib.request
from pathlib import Path
root=Path('work/marathon-deepseek/sources')
urls={
'ollama-release':'https://api.github.com/repos/ollama/ollama/releases/tags/v0.40.4',
'ollama-architectures':'https://raw.githubusercontent.com/ollama/ollama/v0.40.4/llama/llama.cpp/src/llama-arch.cpp',
'v4-0731-gguf':'https://huggingface.co/api/models/ggml-org/DeepSeek-V4-Flash-0731-GGUF/tree/main?recursive=true&expand=false&limit=100',
'v4-0731-readme':'https://huggingface.co/ggml-org/DeepSeek-V4-Flash-0731-GGUF/raw/main/README.md',
'v41-gguf-list':'https://huggingface.co/api/models?search=DeepSeek-V4.1-Flash-GGUF&limit=5',
'v31-terminus':'https://registry.ollama.ai/v2/library/deepseek-v3.1/manifests/671b-terminus-q4_K_M',
'r1-0528':'https://registry.ollama.ai/v2/library/deepseek-r1/manifests/671b-0528-q4_K_M',
'r1-8b-0528':'https://registry.ollama.ai/v2/library/deepseek-r1/manifests/8b-0528-qwen3-q8_0',
}
def get(item):
    key,url=item
    try:
        req=urllib.request.Request(url,headers={'User-Agent':'HPC-Forest-model-discovery','Accept':'application/vnd.docker.distribution.manifest.v2+json'})
        with urllib.request.urlopen(req,timeout=30) as r: data=r.read(2000000)
        (root/(key+'.txt')).write_bytes(data)
        if key=='ollama-architectures': value=[line for line in data.decode().splitlines() if 'DEEPSEEK' in line]
        elif key=='v4-0731-readme': value=data.decode()[-5000:]
        else:
            value=json.loads(data)
            if isinstance(value,dict) and 'assets' in value:value={k:value[k] for k in ['tag_name','published_at','body']}
            if isinstance(value,list): value=[{k:e.get(k) for k in ['path','size','lfs','id']} for e in value]
        return {'name':key,'url':url,'sha256':hashlib.sha256(data).hexdigest(),'value':value}
    except Exception as e:return {'name':key,'url':url,'error':str(e)}
with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool: results=list(pool.map(get,urls.items()))
(root/'discovery.json').write_text(json.dumps(results,indent=2),encoding='utf-8')
for r in results:print(json.dumps(r))

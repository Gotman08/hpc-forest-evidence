"""Three inert checks of the actual pinned cold-controller/helper namespace."""
import copy
import hashlib
import importlib.util
import json
import os
import socket
import subprocess
import sys
from pathlib import Path
from types import SimpleNamespace

HERE = Path(__file__).resolve().parent
READER = HERE.parent
PINS = {"controler-reception-bornee.py": "444b131dea673cef9af471aa9217da65ad86240b75c362a2b27b7cf1bfeed17f",
        "reception_bornee.py": "d17472603acfd4cbff81f998924ec0c31b5628018aef8edec038b5d39a7d5a30"}
before = {name: (READER / name).read_bytes() for name in PINS}
assert {name: hashlib.sha256(raw).hexdigest() for name, raw in before.items()} == PINS
assert not any(n == "hpc_forest" or n.startswith("hpc_forest.") for n in sys.modules)


def forbidden(*args, **kwargs):
    raise AssertionError("Inert namespace check forbids process/socket/signal effects")


class NoProcess(subprocess.Popen):
    def __new__(cls, *args, **kwargs):
        return forbidden(*args, **kwargs)


class NoSocket(socket.socket):
    def __new__(cls, *args, **kwargs):
        return forbidden(*args, **kwargs)


subprocess.Popen = NoProcess
socket.socket = NoSocket
for name in ("run", "call", "check_call", "check_output"):
    setattr(subprocess, name, forbidden)
for name in ("system", "kill", "killpg"):
    setattr(os, name, forbidden)
spec = importlib.util.spec_from_file_location("inert_r2f_cold_namespace_review", READER / "controler-reception-bornee.py")
controller = importlib.util.module_from_spec(spec)
spec.loader.exec_module(controller)
helper = controller.m
assert Path(helper.__file__).resolve() == (READER / "reception_bornee.py").resolve()
assert callable(helper.need) and helper.SCOPE == "hpc-forest-primes-native-max-r2f"
assert not any(n == "hpc_forest" or n.startswith("hpc_forest.") for n in sys.modules)
artifact_pins = {name: {"path": "NEUTRAL-local/" + name, "sha256": str(index) * 64}
                 for index, name in enumerate(("source_zip", "plan", "preparation_manifest", "preparation_review"), 1)}
local = {"scope_id": helper.SCOPE, "model": "gpt-6-astra", "job_id": "NEUTRAL",
         "session_id": helper.CELLS["gpt-6-astra"], "artifacts": artifact_pins}
remote = copy.deepcopy(local)
for value in remote["artifacts"].values():
    value["path"] = "/NEUTRAL-POSIX/" + value["path"].split("/")[-1]


def make_fake(remote_value, remote_failure=None):
    calls = []
    original = object()
    resolver = object()
    module = SimpleNamespace(artifact=original)

    def validate(path, scopes, **kwargs):
        assert scopes == {helper.SCOPE}
        assert kwargs == {"runtime": False, "prepared": False, "initial_lane": False}
        calls.append(path)
        if path == "NEUTRAL-local":
            assert module.artifact is original
            return copy.deepcopy(local)
        assert path == "NEUTRAL-remote" and module.artifact is resolver
        if remote_failure is not None:
            raise remote_failure
        return copy.deepcopy(remote_value)

    module.validate_receipt = validate
    return module, original, resolver, calls


module, original, resolver, calls = make_fake(remote)
positive = controller.verify_frozen_authorizations(module, "NEUTRAL-local", "NEUTRAL-remote", resolver)
assert positive == (local, remote) and module.artifact is original and calls == ["NEUTRAL-local", "NEUTRAL-remote"]
changed = copy.deepcopy(remote)
changed["artifacts"]["source_zip"]["sha256"] = "f" * 64
module, original, resolver, calls = make_fake(changed)
try:
    controller.verify_frozen_authorizations(module, "NEUTRAL-local", "NEUTRAL-remote", resolver)
    raise AssertionError("Mismatched immutable pin was accepted")
except helper.Refusal as exc:
    assert str(exc) == "Immutable cross-environment pin differs"
assert module.artifact is original
sentinel = RuntimeError("NEUTRAL remote validator failure")
module, original, resolver, calls = make_fake(remote, sentinel)
try:
    controller.verify_frozen_authorizations(module, "NEUTRAL-local", "NEUTRAL-remote", resolver)
    raise AssertionError("Sentinel validator failure disappeared")
except RuntimeError as exc:
    assert exc is sentinel
assert module.artifact is original
assert {name: (READER / name).read_bytes() for name in PINS} == before
assert not any(n == "hpc_forest" or n.startswith("hpc_forest.") for n in sys.modules)
report = {"schema": "hpc-forest-r2f-cold-controller-namespace-independent-check-v1", "verified": True,
          "blocking_findings": [], "reviewed_files": PINS, "helper_namespace_path": str(Path(helper.__file__).resolve()),
          "namespace_is_actual_reception_helper_not_factory_preparer": True, "need_callable": True, "scope_id": helper.SCOPE,
          "inert_results": {"positive_real_namespace": "PASS", "immutable_pin_mismatch_refused_by_helper_Refusal": "PASS", "resolver_restored_after_remote_validator_exception": "PASS"},
          "target_function": "verify_frozen_authorizations", "function_called_with_fake_validate_receipt_and_artifact_only": True,
          "source_or_factory_or_worker_imported": False, "actual_authorization_receipt_or_body_read": False,
          "live_cache_CIM_CLI_model_process_transport_or_remote_actions": 0, "old_11_or_24_tests_replayed": False,
          "sealed_code_before_after_identical": True, "actual_receipt_created": False, "native_research_admitted": False}
target = HERE / "REVUE-NAMESPACE-FROID-R4-SCELLEE.json"
raw = (json.dumps(report, ensure_ascii=False, sort_keys=True, indent=2) + "\n").encode("utf-8")
with target.open("xb") as handle:
    handle.write(raw)
print(json.dumps({"verified": True, "blocking_findings": [], "report": str(target), "sha256": hashlib.sha256(raw).hexdigest(), "inert_results": report["inert_results"]}))

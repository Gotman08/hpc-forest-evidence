      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <memory>\n\nclass FastInput {\n    static constexpr std::size_t capacity = 1u << 16;\n    unsigned char buffer_[capacity];\n    std::size_t position_ = 0;\n    std::size_t available_ = 0;\n\n    int read_char() {\n        if (position_ == available_) {\n            available_ = std::fread(buffer_, 1, capacity, stdin);\n            position_ = 0;\n            if (available_ == 0) {\n                return EOF;\n            }\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    int next_int() {\n        int c = read_char();\n        while (c != EOF && c <= ' ') {\n            c = read_char();\n        }\n        const bool negative = c == '-';\n        if (c == '-' || c == '+') {\n            c = read_char();\n        }\n        std::uint32_t magnitude = 0;\n        while (c >= '0' && c <= '9') {\n            magnitude = magnitude * 10u + static_cast<std::uint32_t>(c - '0');\n            c = read_char();\n        }\n        const std::int64_t value = static_cast<std::int64_t>(magnitude);\n        return static_cast<int>(negative ? -value : value);\n    }\n};\n\nstatic inline void add_row(std::int64_t* __restrict__ columns,\n                           const int* __restrict__ row, int n) {\n    for (int j = 0; j < n; ++j) {\n        columns[j] += row[j];\n    }\n}\n\nstatic inline void advance_row(std::int64_t* __restrict__ columns,\n                               const int* __restrict__ incoming,\n                               int* __restrict__ outgoing,\n                               int n, bool retain_incoming) {\n    if (retain_incoming) {\n        for (int j = 0; j < n; ++j) {\n            const int value = incoming[j];\n            columns[j] += static_cast<std::int64_t>(value) - outgoing[j];\n            outgoing[j] = value;\n        }\n    } else {\n        for (int j = 0; j < n; ++j) {\n            columns[j] += static_cast<std::int64_t>(incoming[j]) - outgoing[j];\n        }\n    }\n}\n\nstatic inline std::int64_t advance_prefix(\n        std::int64_t* __restrict__ columns,\n        const int* __restrict__ incoming,\n        int* __restrict__ outgoing,\n        int n, bool retain_incoming) {\n    std::int64_t delta_sum = 0;\n    if (retain_incoming) {\n        for (int j = 0; j < n; ++j) {\n            const int value = incoming[j];\n            const std::int64_t delta =\n                static_cast<std::int64_t>(value) - outgoing[j];\n            columns[j] += delta;\n            outgoing[j] = value;\n            delta_sum += delta;\n        }\n    } else {\n        for (int j = 0; j < n; ++j) {\n            const std::int64_t delta =\n                static_cast<std::int64_t>(incoming[j]) - outgoing[j];\n            columns[j] += delta;\n            delta_sum += delta;\n        }\n    }\n    return delta_sum;\n}\n\nstatic inline std::int64_t horizontal_max(const std::int64_t* columns,\n                                          int n, int s,\n                                          std::int64_t& first_window) {\n    std::int64_t sum = 0;\n    for (int j = 0; j < s; ++j) {\n        sum += columns[j];\n    }\n    first_window = sum;\n    std::int64_t best = sum;\n    for (int j = s; j < n; ++j) {\n        sum += columns[j] - columns[j - s];\n        if (sum > best) {\n            best = sum;\n        }\n    }\n    return best;\n}\n\nint main() {\n    FastInput input;\n    const int n = input.next_int();\n    const int s = input.next_int();\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    constexpr int tile_size = 512;\n    const int moves = n - s;\n    const int history_rows = std::min(s, moves);\n    const std::size_t row_size = static_cast<std::size_t>(n);\n    const std::size_t history_size =\n        static_cast<std::size_t>(history_rows) * row_size;\n    std::unique_ptr<int[]> history(new int[history_size]);\n    std::unique_ptr<int[]> staged(new int[tile_size]);\n    std::unique_ptr<std::int64_t[]> columns(new std::int64_t[n]());\n\n    for (int r = 0; r < s; ++r) {\n        int* retained_row = r < history_rows\n            ? history.get() + static_cast<std::size_t>(r) * row_size\n            : nullptr;\n        for (int begin = 0; begin < n; begin += tile_size) {\n            const int count = std::min(tile_size, n - begin);\n            int* destination = retained_row != nullptr\n                ? retained_row + begin : staged.get();\n            for (int j = 0; j < count; ++j) {\n                destination[j] = input.next_int();\n            }\n            add_row(columns.get() + begin, destination, count);\n        }\n    }\n\n    std::int64_t first_window = 0;\n    std::int64_t best = horizontal_max(columns.get(), n, s, first_window);\n    int slot = 0;\n    for (int r = s; r < n; ++r) {\n        int* outgoing = history.get() + static_cast<std::size_t>(slot) * row_size;\n        const bool retain_incoming = r < moves;\n        std::int64_t horizontal = 0;\n\n        for (int begin = 0; begin < n; begin += tile_size) {\n            const int count = std::min(tile_size, n - begin);\n            const int end = begin + count;\n            for (int j = 0; j < count; ++j) {\n                staged[j] = input.next_int();\n            }\n\n            const int prefix_count = begin < s\n                ? std::min(count, s - begin) : 0;\n            if (prefix_count != 0) {\n                first_window += advance_prefix(\n                    columns.get() + begin, staged.get(), outgoing + begin,\n                    prefix_count, retain_incoming);\n            }\n            if (prefix_count < count) {\n                advance_row(columns.get() + begin + prefix_count,\n                            staged.get() + prefix_count,\n                            outgoing + begin + prefix_count,\n                            count - prefix_count, retain_incoming);\n            }\n\n            // The leftmost square is complete once the first s columns advance.\n            if (begin < s && end >= s) {\n                horizontal = first_window;\n                if (horizontal > best) {\n                    best = horizontal;\n                }\n            }\n            // Both referenced columns have advanced before this tile is scanned.\n            for (int j = std::max(begin, s); j < end; ++j) {\n                horizontal += columns[j] - columns[j - s];\n                if (horizontal > best) {\n                    best = horizontal;\n                }\n            }\n        }\n\n        ++slot;\n        if (slot == history_rows) {\n            slot = 0;\n        }\n    }\n\n    std::printf(\"%lld\\n\", static_cast<long long>(best));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],

      "content": "#include <iostream>\n#include <vector>\n#include <utility>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\ntypedef vector<vector<bool>> adjacency_matrix;\n\nadjacency_matrix readGraph();\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence);\ninline void printPermutation(vector<int> &equivalence);\n\nint main(){\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if(!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\n#ifdef _OPENMP\n// Compose the terminal transformation of recursive Heap blocks without\n// enumerating their leaves. Result[i] is the original position ending at i.\nstatic vector<int> heapBlockTerminal(int prefix_size){\n    vector<int> smaller;\n    for(int k = 1; k <= prefix_size; ++k){\n        vector<int> result(k);\n        vector<int> scratch(k);\n        for(int i = 0; i < k; ++i)\n            result[i] = i;\n\n        for(int block = 0; block < k; ++block){\n            for(int i = 0; i < k - 1; ++i)\n                scratch[i] = result[i];\n            for(int i = 0; i < k - 1; ++i)\n                result[i] = scratch[smaller[i]];\n            if(block + 1 < k){\n                int position = (k % 2 == 0) ? block : 0;\n                swap(result[position], result[k - 1]);\n            }\n        }\n        smaller.swap(result);\n    }\n    return smaller;\n}\n\nstatic bool testHeapBlocksParallel(adjacency_matrix &g1,\n                                   adjacency_matrix &g2,\n                                   const vector<int> &initial){\n    const int n = static_cast<int>(initial.size());\n    const int prefix_size = (n > 8) ? 7 : n - 2;\n    const int batch_capacity = 32;\n    const vector<int> terminal = heapBlockTerminal(prefix_size);\n    vector<int> next(initial);\n    vector<int> exchange_counter(n, 0);\n    vector<int> scratch(prefix_size);\n    vector<vector<int>> starts(batch_capacity, vector<int>(n));\n    bool more_blocks = true;\n    int active_blocks = 0;\n    bool isomorphism_found = false;\n\n    // One persistent team handles successive bounded batches. The single\n    // region advances only block boundaries; workers enumerate their leaves.\n    #pragma omp parallel\n    {\n        vector<int> local(n);\n        vector<int> local_counter(prefix_size);\n        vector<int> matches;\n\n        while(true){\n            #pragma omp single\n            {\n                active_blocks = 0;\n                while(more_blocks && active_blocks < batch_capacity){\n                    starts[active_blocks++] = next;\n\n                    for(int i = 0; i < prefix_size; ++i)\n                        scratch[i] = next[i];\n                    for(int i = 0; i < prefix_size; ++i)\n                        next[i] = scratch[terminal[i]];\n\n                    int index = prefix_size;\n                    while(index < n && exchange_counter[index] == index){\n                        exchange_counter[index] = 0;\n                        ++index;\n                    }\n                    if(index == n){\n                        more_blocks = false;\n                    }else{\n                        if(index % 2 == 0)\n                            swap(next[0], next[index]);\n                        else\n                            swap(next[exchange_counter[index]], next[index]);\n                        ++exchange_counter[index];\n                    }\n                }\n            }\n\n            if(active_blocks == 0)\n                break;\n\n            #pragma omp for schedule(dynamic, 1) ordered reduction(||:isomorphism_found)\n            for(int block = 0; block < active_blocks; ++block){\n                local = starts[block];\n                for(int i = 0; i < prefix_size; ++i)\n                    local_counter[i] = 0;\n                matches.clear();\n\n                if(verifyPermutation(g1, g2, local))\n                    matches.insert(matches.end(), local.begin(),\n                                   local.begin() + prefix_size);\n\n                int index = 1;\n                while(index < prefix_size){\n                    if(local_counter[index] < index){\n                        if(index % 2 == 0)\n                            swap(local[0], local[index]);\n                        else\n                            swap(local[local_counter[index]], local[index]);\n\n                        if(verifyPermutation(g1, g2, local))\n                            matches.insert(matches.end(), local.begin(),\n                                           local.begin() + prefix_size);\n\n                        ++local_counter[index];\n                        index = 1;\n                    }else{\n                        local_counter[index] = 0;\n                        ++index;\n                    }\n                }\n\n                if(!matches.empty())\n                    isomorphism_found = true;\n\n                // Each block has a fixed suffix. Buffer only matching prefixes\n                // and emit blocks in the original Heap enumeration order.\n                #pragma omp ordered\n                {\n                    for(size_t offset = 0; offset < matches.size();\n                        offset += prefix_size){\n                        for(int i = 0; i < prefix_size; ++i)\n                            local[i] = matches[offset + i];\n                        printPermutation(local);\n                    }\n                }\n            }\n        }\n    }\n    return isomorphism_found;\n}\n#endif\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\n    vector<int> equivalence(g1.size(), 0);\n    vector<int> exchange_counter(g1.size(), 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    if(g1.size() != g2.size()) return false;\n\n    for(int i = 0; i < equivalence.size(); ++i)\n        equivalence[i] = i;\n\n    if(verifyPermutation(g1, g2, equivalence)){\n        printPermutation(equivalence);\n        return true;\n    }\n\n#ifdef _OPENMP\n    if(g1.size() >= 8 && omp_get_max_threads() > 1 && !omp_in_parallel())\n        return testHeapBlocksParallel(g1, g2, equivalence);\n#endif\n    \n    /*\n     * Permutations are based on Heap's algorithm, which generates all possible \n     * permutations for a given set of elements. \n     */\n    while(exchange_index < g1.size()){\n        if(exchange_counter[exchange_index] < exchange_index){\n            if(exchange_index % 2 == 0)\n                swap(equivalence[0], equivalence[exchange_index]);\n            else\n                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\n            if(verifyPermutation(g1, g2, equivalence)){\n                printPermutation(equivalence);\n                isomorphism_found = true;\n            }\n\n            exchange_counter[exchange_index]++;\n            exchange_index = 1;\n        }else{\n            exchange_counter[exchange_index] = 0;\n            exchange_index++;\n        }\n    }\n    return isomorphism_found; \n}\n\nadjacency_matrix readGraph(){\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read(vertices);\n    for (int i = 0; i < vertices; ++i)\n        read[i].resize(vertices);\n    \n    cin >> edges;    \n    for (int i = 0; i < edges; i++) {\n       cin >> source >> destination;\n       read[destination][source] = read[source][destination] = true; \n    }\n\n    return read;\n}\n\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence){\n    for (int i = 0; i < equivalence.size(); ++i) {\n        for (int j = 0; j <= i; ++j) {\n            if(g1[i][j] != g2[equivalence[i]][equivalence[j]]) return false;\n        }\n    }\n   return true;\n}\n\ninline void printPermutation(vector<int> &equivalence){\n    for (auto i : equivalence)\n        cout << i << \" \";\n    cout << endl;\n}\n",
      "path": "src/brute_isomorphism.cpp"
    }

{"files":[{"content":"#define _POSIX_C_SOURCE 200809L\n\n#include <ctype.h>\n#include <errno.h>\n#include <limits.h>\n#include <math.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <sys/types.h>\n\n#if defined(__aarch64__) || defined(__ARM_NEON)\n#include <arm_neon.h>\n#define GRAPH_HAVE_NEON 1\n#else\n#define GRAPH_HAVE_NEON 0\n#endif\n\ntypedef struct {\n  int id;\n  float value;\n  size_t edge_begin;\n  size_t edge_count;\n} Node;\n\ntypedef struct {\n  char *text;\n  int id;\n} Query;\n\ntypedef struct {\n  int key;\n  int index;\n} IdSlot;\n\ntypedef struct {\n  IdSlot *slots;\n  size_t mask;\n} IdMap;\n\nstatic void fail(void)\n{\n  fputs(\"Error!\\n\", stderr);\n  exit(1);\n}\n\nstatic void *xmalloc(size_t bytes)\n{\n  void *pointer = malloc(bytes == 0 ? 1 : bytes);\n\n  if (pointer == NULL)\n    fail();\n\n  return pointer;\n}\n\nstatic void *xrealloc(void *pointer, size_t bytes)\n{\n  void *resized = realloc(pointer, bytes == 0 ? 1 : bytes);\n\n  if (resized == NULL)\n    fail();\n\n  return resized;\n}\n\nstatic void *xalloc_array(size_t count, size_t item_size)\n{\n  if (count != 0 && item_size > SIZE_MAX / count)\n    fail();\n\n  return xmalloc(count * item_size);\n}\n\nstatic void *xcalloc_array(size_t count, size_t item_size)\n{\n  if (count == 0)\n    return xmalloc(1);\n  if (item_size > SIZE_MAX / count)\n    fail();\n\n  void *pointer = calloc(count, item_size);\n  if (pointer == NULL)\n    fail();\n\n  return pointer;\n}\n\nstatic char *skip_space(char *cursor)\n{\n  while (*cursor != '\\0' && isspace((unsigned char)*cursor))\n    ++cursor;\n  return cursor;\n}\n\nstatic void strip_linefeed(char *line)\n{\n  char *linefeed = strchr(line, '\\n');\n\n  if (linefeed != NULL)\n    *linefeed = '\\0';\n}\n\nstatic int take_int(char **cursor, int *value)\n{\n  char *start = skip_space(*cursor);\n  char *end;\n  long parsed;\n\n  if (*start == '\\0') {\n    *cursor = start;\n    return 0;\n  }\n\n  errno = 0;\n  parsed = strtol(start, &end, 10);\n  if (end == start || errno == ERANGE || parsed < (long)INT_MIN ||\n      parsed > (long)INT_MAX)\n    return 0;\n\n  *cursor = end;\n  *value = (int)parsed;\n  return 1;\n}\n\nstatic int take_float(char **cursor, float *value)\n{\n  char *start = skip_space(*cursor);\n  char *end;\n  float parsed;\n\n  if (*start == '\\0') {\n    *cursor = start;\n    return 0;\n  }\n\n  parsed = strtof(start, &end);\n  if (end == start)\n    return 0;\n\n  *cursor = end;\n  *value = parsed;\n  return 1;\n}\n\nstatic void append_edge(int **items, size_t *count, size_t *capacity, int value)\n{\n  if (*count == SIZE_MAX)\n    fail();\n\n  if (*count == *capacity) {\n    size_t new_capacity = *capacity == 0 ? 64 : *capacity;\n\n    if (*capacity != 0) {\n      if (new_capacity > SIZE_MAX / 2)\n        fail();\n      new_capacity *= 2;\n    }\n    if (new_capacity > SIZE_MAX / sizeof **items)\n      fail();\n\n    *items = xrealloc(*items, new_capacity * sizeof **items);\n    *capacity = new_capacity;\n  }\n\n  (*items)[*count] = value;\n  *count += 1;\n}\n\nstatic void append_query(Query **items, size_t *count, size_t *capacity,\n                         const char *text, size_t length, int id)\n{\n  if (*count == SIZE_MAX || length == SIZE_MAX)\n    fail();\n\n  if (*count == *capacity) {\n    size_t new_capacity = *capacity == 0 ? 16 : *capacity;\n\n    if (*capacity != 0) {\n      if (new_capacity > SIZE_MAX / 2)\n        fail();\n      new_capacity *= 2;\n    }\n    if (new_capacity > SIZE_MAX / sizeof **items)\n      fail();\n\n    *items = xrealloc(*items, new_capacity * sizeof **items);\n    *capacity = new_capacity;\n  }\n\n  char *copy = xalloc_array(length + 1, sizeof *copy);\n  memcpy(copy, text, length);\n  copy[length] = '\\0';\n\n  (*items)[*count].text = copy;\n  (*items)[*count].id = id;\n  *count += 1;\n}\n\nstatic Node *read_graph(int *node_count, Query **queries,\n                        size_t *query_count, int **edge_ids,\n                        size_t *edge_count)\n{\n  char *line = NULL;\n  size_t line_capacity = 0;\n  Query *query_items = NULL;\n  size_t queries_used = 0;\n  size_t queries_capacity = 0;\n  int *edges = NULL;\n  size_t edges_used = 0;\n  size_t edges_capacity = 0;\n  int n;\n\n  if (getline(&line, &line_capacity, stdin) < 0)\n    fail();\n  strip_linefeed(line);\n\n  char *cursor = line;\n  if (!take_int(&cursor, &n) || n < 0)\n    fail();\n\n  /* fscanf's whitespace before %[^\n] is consumed before strtok sees it. */\n  cursor = skip_space(cursor);\n  while (*cursor != '\\0') {\n    while (*cursor == ' ')\n      ++cursor;\n    if (*cursor == '\\0')\n      break;\n\n    char *token = cursor;\n    while (*cursor != '\\0' && *cursor != ' ')\n      ++cursor;\n\n    char saved = *cursor;\n    *cursor = '\\0';\n    append_query(&query_items, &queries_used, &queries_capacity, token,\n                 (size_t)(cursor - token), atoi(token));\n    *cursor = saved;\n  }\n\n  Node *nodes = n == 0 ? NULL : xalloc_array((size_t)n, sizeof *nodes);\n\n  for (int index = 0; index < n; ++index) {\n    int node_id;\n    float node_value;\n\n    if (getline(&line, &line_capacity, stdin) < 0)\n      fail();\n    strip_linefeed(line);\n\n    cursor = line;\n    if (!take_int(&cursor, &node_id) || !take_float(&cursor, &node_value))\n      fail();\n\n    nodes[index].id = node_id;\n    nodes[index].value = node_value;\n    nodes[index].edge_begin = edges_used;\n    nodes[index].edge_count = 0;\n\n    cursor = skip_space(cursor);\n    while (*cursor != '\\0') {\n      while (*cursor == ' ')\n        ++cursor;\n      if (*cursor == '\\0')\n        break;\n\n      char *token = cursor;\n      while (*cursor != '\\0' && *cursor != ' ')\n        ++cursor;\n\n      char saved = *cursor;\n      *cursor = '\\0';\n      append_edge(&edges, &edges_used, &edges_capacity, atoi(token));\n      nodes[index].edge_count += 1;\n      *cursor = saved;\n    }\n  }\n\n  free(line);\n  *node_count = n;\n  *queries = query_items;\n  *query_count = queries_used;\n  *edge_ids = edges;\n  *edge_count = edges_used;\n  return nodes;\n}\n\nstatic size_t hash_id(int id)\n{\n  uint32_t value = (uint32_t)id;\n\n  value ^= value >> 16;\n  value *= UINT32_C(0x7feb352d);\n  value ^= value >> 15;\n  value *= UINT32_C(0x846ca68b);\n  value ^= value >> 16;\n  return (size_t)value;\n}\n\nstatic void id_map_insert_first(IdMap *map, int key, int index)\n{\n  size_t position = hash_id(key) & map->mask;\n\n  for (;;) {\n    IdSlot *slot = &map->slots[position];\n\n    if (slot->index == -1) {\n      slot->key = key;\n      slot->index = index;\n      return;\n    }\n    if (slot->key == key)\n      return;\n\n    position = (position + 1) & map->mask;\n  }\n}\n\nstatic int id_map_lookup(const IdMap *map, int key)\n{\n  size_t position = hash_id(key) & map->mask;\n\n  for (;;) {\n    const IdSlot *slot = &map->slots[position];\n\n    if (slot->index == -1)\n      return -1;\n    if (slot->key == key)\n      return slot->index;\n\n    position = (position + 1) & map->mask;\n  }\n}\n\nstatic IdMap make_id_map(const Node *nodes, int node_count)\n{\n  size_t desired = (size_t)node_count;\n  size_t capacity = 4;\n  IdMap map;\n\n  if (desired > SIZE_MAX / 2)\n    fail();\n  desired *= 2;\n\n  while (capacity < desired) {\n    if (capacity > SIZE_MAX / 2)\n      fail();\n    capacity *= 2;\n  }\n\n  map.slots = xalloc_array(capacity, sizeof *map.slots);\n  map.mask = capacity - 1;\n  for (size_t index = 0; index < capacity; ++index)\n    map.slots[index].index = -1;\n\n  for (int index = 0; index < node_count; ++index)\n    id_map_insert_first(&map, nodes[index].id, index);\n\n  return map;\n}\n\nstatic int select_scalar(const float *values, const int *targets, size_t count)\n{\n  float maximum = 0.0f;\n  int selected = -1;\n\n  for (size_t index = 0; index < count; ++index) {\n    if (maximum < values[index]) {\n      maximum = values[index];\n      selected = targets[index];\n    }\n  }\n\n  return selected;\n}\n\nstatic int select_successor(const float *values, const int *targets,\n                            size_t count)\n{\n#if GRAPH_HAVE_NEON\n  if (count >= 16) {\n    const float32x4_t zero = vdupq_n_f32(0.0f);\n    const float32x4_t negative_infinity = vdupq_n_f32(-INFINITY);\n    float32x4_t best = negative_infinity;\n    size_t index = 0;\n\n    for (; index + 4 <= count; index += 4) {\n      float32x4_t candidate = vld1q_f32(values + index);\n      uint32x4_t positive = vcgtq_f32(candidate, zero);\n      candidate = vbslq_f32(positive, candidate, negative_infinity);\n      best = vmaxq_f32(best, candidate);\n    }\n\n    float maximum = -INFINITY;\n    float lane = vgetq_lane_f32(best, 0);\n    if (maximum < lane)\n      maximum = lane;\n    lane = vgetq_lane_f32(best, 1);\n    if (maximum < lane)\n      maximum = lane;\n    lane = vgetq_lane_f32(best, 2);\n    if (maximum < lane)\n      maximum = lane;\n    lane = vgetq_lane_f32(best, 3);\n    if (maximum < lane)\n      maximum = lane;\n\n    for (; index < count; ++index) {\n      float candidate = values[index];\n      if (candidate > 0.0f && maximum < candidate)\n        maximum = candidate;\n    }\n\n    if (!(maximum > 0.0f))\n      return -1;\n\n    /* Recover the first equal edge, preserving the strict original tie rule. */\n    const float32x4_t wanted = vdupq_n_f32(maximum);\n    index = 0;\n    for (; index + 4 <= count; index += 4) {\n      uint32x4_t equal = vceqq_f32(vld1q_f32(values + index), wanted);\n\n      if (vgetq_lane_u32(equal, 0) != 0u)\n        return targets[index];\n      if (vgetq_lane_u32(equal, 1) != 0u)\n        return targets[index + 1];\n      if (vgetq_lane_u32(equal, 2) != 0u)\n        return targets[index + 2];\n      if (vgetq_lane_u32(equal, 3) != 0u)\n        return targets[index + 3];\n    }\n\n    for (; index < count; ++index) {\n      if (values[index] == maximum)\n        return targets[index];\n    }\n\n    return -1;\n  }\n#endif\n\n  return select_scalar(values, targets, count);\n}\n\nstatic void resolve_successor(int node_index, const Node *nodes,\n                              const IdMap *map, int *edge_targets,\n                              float *edge_values, int *successors,\n                              unsigned char *resolved)\n{\n  const Node *node = &nodes[node_index];\n\n  if (node->edge_count == 0) {\n    successors[node_index] = -1;\n    resolved[node_index] = 1u;\n    return;\n  }\n\n  const size_t first = node->edge_begin;\n  const size_t end = first + node->edge_count;\n\n#if defined(__GNUC__) && !defined(__clang__)\n#pragma GCC ivdep\n#endif\n  for (size_t edge = first; edge < end; ++edge) {\n    int neighbor_id = edge_targets[edge];\n    int target = id_map_lookup(map, neighbor_id);\n\n    /* The reference retains -1 as its no-recursion sentinel after selection. */\n    edge_targets[edge] = neighbor_id == -1 ? -1 : target;\n    edge_values[edge] = target >= 0 ? nodes[target].value : -INFINITY;\n  }\n\n  successors[node_index] = select_successor(edge_values + first,\n                                             edge_targets + first,\n                                             node->edge_count);\n  resolved[node_index] = 1u;\n}\n\nstatic float compute_cost(int start, int node_count, const Node *nodes,\n                          const IdMap *map, int *edge_targets,\n                          float *edge_values, int *successors,\n                          unsigned char *resolved, float *costs,\n                          unsigned char *known, int *stack)\n{\n  if (start < 0)\n    return 0.0f;\n  if (known[start])\n    return costs[start];\n\n  int current = start;\n  size_t depth = 0;\n\n  while (!known[current]) {\n    if (depth == (size_t)node_count)\n      fail();\n\n    stack[depth++] = current;\n    if (!resolved[current])\n      resolve_successor(current, nodes, map, edge_targets, edge_values,\n                        successors, resolved);\n\n    int next = successors[current];\n    if (next < 0) {\n      current = -1;\n      break;\n    }\n    current = next;\n  }\n\n  float suffix = current >= 0 ? costs[current] : 0.0f;\n  while (depth != 0) {\n    int node_index = stack[--depth];\n    float result = nodes[node_index].value;\n\n    if (successors[node_index] >= 0)\n      result += suffix;\n\n    costs[node_index] = result;\n    known[node_index] = 1u;\n    suffix = result;\n  }\n\n  return costs[start];\n}\n\nstatic void free_queries(Query *queries, size_t count)\n{\n  for (size_t index = 0; index < count; ++index)\n    free(queries[index].text);\n  free(queries);\n}\n\nint main(void)\n{\n  int node_count;\n  Query *queries;\n  size_t query_count;\n  int *edge_targets;\n  size_t edge_count;\n  Node *nodes = read_graph(&node_count, &queries, &query_count,\n                           &edge_targets, &edge_count);\n  IdMap map = make_id_map(nodes, node_count);\n  int *successors = node_count == 0 ? NULL :\n                    xalloc_array((size_t)node_count, sizeof *successors);\n  unsigned char *resolved = node_count == 0 ? NULL :\n                            xcalloc_array((size_t)node_count,\n                                          sizeof *resolved);\n  float *costs = node_count == 0 ? NULL :\n                 xalloc_array((size_t)node_count, sizeof *costs);\n  unsigned char *known = node_count == 0 ? NULL :\n                         xcalloc_array((size_t)node_count, sizeof *known);\n  int *stack = node_count == 0 ? NULL :\n               xalloc_array((size_t)node_count, sizeof *stack);\n  float *edge_values = edge_count == 0 ? NULL :\n                       xalloc_array(edge_count, sizeof *edge_values);\n\n  for (size_t index = 0; index < query_count; ++index) {\n    int node_index = id_map_lookup(&map, queries[index].id);\n    float result = node_index < 0 ? 0.0f :\n                   compute_cost(node_index, node_count, nodes, &map,\n                                edge_targets, edge_values, successors,\n                                resolved, costs, known, stack);\n\n    printf(\"%s: %f\\n\", queries[index].text, result);\n  }\n\n  free(edge_values);\n  free(stack);\n  free(known);\n  free(costs);\n  free(resolved);\n  free(successors);\n  free(map.slots);\n  free(edge_targets);\n  free_queries(queries, query_count);\n  free(nodes);\n  return 0;\n}\n","path":"src/graph.c"}],"hypothesis":"Resolve each adjacency once, SIMD-reduce only its independent contiguous value scan, and retain ordered tie recovery; cached successor chains remove repeated dependent traversal without changing float accumulation order.","notes":"ARM NEON is guarded with a scalar fallback; no measurements were run.","research":{"queries":[],"urls":[]},"sources_kept":[],"transformations":["Replace repeated string tokenization and linear ID searches with dynamic compact adjacency storage plus a first-ID hash lookup.","Use a NEON maximum pass for sufficiently long adjacency lists, followed by an ordered first-equal recovery pass to preserve strict first-tie semantics.","Memoize greedy DAG successor-chain costs with iterative unwinding while retaining serial float additions."]}
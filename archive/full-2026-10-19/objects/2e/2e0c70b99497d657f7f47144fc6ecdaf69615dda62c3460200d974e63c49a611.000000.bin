#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#define MAX 100

typedef struct {
  int id;
  float value;
  char neighbors[MAX + 1];
} Node;

typedef struct {
  int key;
  int index;
} IdSlot;

typedef struct {
  int dense_base;
  size_t dense_span;
  int *dense;
  IdSlot *slots;
  size_t mask;
} IdIndex;

static void fail(void) {
  fprintf(stderr, "Error!\n");
  exit(1);
}

static void *checked_malloc(size_t bytes) {
  void *pointer = malloc(bytes);
  if (pointer == NULL && bytes != 0)
    fail();
  return pointer;
}

static void *checked_calloc(size_t count, size_t size) {
  if (count != 0 && size > (size_t)-1 / count)
    fail();
  void *pointer = calloc(count, size);
  if (pointer == NULL && count != 0)
    fail();
  return pointer;
}

static Node *read_input(char *fname, int *n, char *list) {
  FILE *fl = fname == NULL ? stdin : fopen(fname, "r");
  Node *data = NULL;

  if (fl == NULL)
    fail();

  if (fscanf(fl, "%d %100[^\n]", n, list) != 2 || *n < 0)
    fail();

  if (*n > 0) {
    if ((size_t)*n > (size_t)-1 / sizeof(*data))
      fail();
    data = checked_malloc((size_t)*n * sizeof(*data));
  }

  for (int i = 0; i < *n; ++i) {
    if (fscanf(fl, "%d %f %100[^\n]", &data[i].id, &data[i].value,
               data[i].neighbors) != 3)
      fail();
  }

  fclose(fl);
  return data;
}

static size_t count_neighbor_tokens(const char *text) {
  size_t count = 0;

  while (*text != '\0') {
    while (*text == ' ')
      ++text;
    if (*text == '\0')
      break;
    ++count;
    while (*text != '\0' && *text != ' ')
      ++text;
  }

  return count;
}

static unsigned int hash_id(int id) {
  unsigned int value = (unsigned int)id;
  value ^= value >> 16;
  value *= 0x7feb352dU;
  value ^= value >> 15;
  value *= 0x846ca68bU;
  value ^= value >> 16;
  return value;
}

static IdIndex build_index(const Node *nodes, int n) {
  IdIndex index = { 0, 0, NULL, NULL, 0 };

  if (n == 0) {
    index.slots = checked_malloc(sizeof(*index.slots));
    index.slots[0].index = -1;
    return index;
  }

  int minimum = nodes[0].id;
  int maximum = nodes[0].id;
  for (int i = 1; i < n; ++i) {
    if (nodes[i].id < minimum)
      minimum = nodes[i].id;
    if (nodes[i].id > maximum)
      maximum = nodes[i].id;
  }

  uint64_t span = (uint64_t)((int64_t)maximum - (int64_t)minimum) + 1U;
  uint64_t dense_limit = (uint64_t)(size_t)n * 8U + 64U;
  if (span <= dense_limit &&
      span <= (uint64_t)((size_t)-1 / sizeof(*index.dense))) {
    index.dense_base = minimum;
    index.dense_span = (size_t)span;
    index.dense = checked_malloc(index.dense_span * sizeof(*index.dense));
    for (size_t i = 0; i < index.dense_span; ++i)
      index.dense[i] = -1;

    for (int i = 0; i < n; ++i) {
      size_t position = (size_t)((int64_t)nodes[i].id - (int64_t)minimum);
      if (index.dense[position] == -1)
        index.dense[position] = i;
    }
    return index;
  }

  if ((size_t)n > (size_t)-1 / 2)
    fail();
  size_t target = (size_t)n * 2;
  size_t capacity = 1;
  while (capacity < target) {
    if (capacity > (size_t)-1 / 2)
      fail();
    capacity <<= 1;
  }

  index.slots = checked_malloc(capacity * sizeof(*index.slots));
  index.mask = capacity - 1;
  for (size_t i = 0; i < capacity; ++i)
    index.slots[i].index = -1;

  for (int i = 0; i < n; ++i) {
    size_t position = (size_t)hash_id(nodes[i].id) & index.mask;
    while (index.slots[position].index != -1 &&
           index.slots[position].key != nodes[i].id)
      position = (position + 1) & index.mask;
    if (index.slots[position].index == -1) {
      index.slots[position].key = nodes[i].id;
      index.slots[position].index = i;
    }
  }

  return index;
}

static int lookup_id(const IdIndex *index, int id) {
  if (index->dense != NULL) {
    int64_t position = (int64_t)id - (int64_t)index->dense_base;
    if (position < 0 || (uint64_t)position >= (uint64_t)index->dense_span)
      return -1;
    return index->dense[(size_t)position];
  }

  size_t position = (size_t)hash_id(id) & index->mask;
  while (index->slots[position].index != -1) {
    if (index->slots[position].key == id)
      return index->slots[position].index;
    position = (position + 1) & index->mask;
  }
  return -1;
}

static void destroy_index(IdIndex *index) {
  free(index->dense);
  free(index->slots);
}

static float resolve_cost(int start, const float *values, const int *successor,
                          float *cost, unsigned char *state, int *path) {
  if (state[start] == 2)
    return cost[start];

  int current = start;
  int length = 0;
  while (current >= 0 && state[current] == 0) {
    state[current] = 1;
    path[length++] = current;
    current = successor[current];
  }

  if (current >= 0 && state[current] == 1)
    fail();

  while (length != 0) {
    int node = path[--length];
    int next = successor[node];
    float result = values[node];
    if (next >= 0)
      result += cost[next];
    cost[node] = result;
    state[node] = 2;
  }

  return cost[start];
}

int main(void) {
  char computelist[MAX + 1];
  int n = -1;
  Node *input = read_input(NULL, &n, computelist);
  IdIndex ids = build_index(input, n);

  float *values = n > 0 ? checked_malloc((size_t)n * sizeof(*values)) : NULL;
  size_t *offset = checked_malloc(((size_t)n + 1) * sizeof(*offset));
  offset[0] = 0;
  for (int i = 0; i < n; ++i) {
    values[i] = input[i].value;
    size_t count = count_neighbor_tokens(input[i].neighbors);
    if (count > (size_t)-1 - offset[i])
      fail();
    offset[i + 1] = offset[i] + count;
  }

  int *neighbor = offset[n] != 0
                    ? checked_malloc(offset[n] * sizeof(*neighbor))
                    : NULL;
  size_t written = 0;
  for (int i = 0; i < n; ++i) {
    const char *token = input[i].neighbors;
    while (*token != '\0') {
      while (*token == ' ')
        ++token;
      if (*token == '\0')
        break;
      neighbor[written++] = lookup_id(&ids, atoi(token));
      while (*token != '\0' && *token != ' ')
        ++token;
    }
  }
  free(input);

  int *successor = n > 0
                   ? checked_malloc((size_t)n * sizeof(*successor))
                   : NULL;
  for (int i = 0; i < n; ++i) {
    float maximum = 0.0f;
    int selected = -1;
    for (size_t edge = offset[i]; edge < offset[i + 1]; ++edge) {
      int candidate = neighbor[edge];
      if (candidate >= 0 && maximum < values[candidate]) {
        maximum = values[candidate];
        selected = candidate;
      }
    }
    successor[i] = selected;
  }
  free(neighbor);
  free(offset);

  float *cost = n > 0 ? checked_malloc((size_t)n * sizeof(*cost)) : NULL;
  unsigned char *state = n > 0
                         ? checked_calloc((size_t)n, sizeof(*state))
                         : NULL;
  int *path = n > 0 ? checked_malloc((size_t)n * sizeof(*path)) : NULL;

  for (char *token = strtok(computelist, " "); token != NULL;
       token = strtok(NULL, " ")) {
    int node = lookup_id(&ids, atoi(token));
    float result = node >= 0
                   ? resolve_cost(node, values, successor, cost, state, path)
                   : 0.0f;
    printf("%s: %f\n", token, result);
  }

  free(path);
  free(state);
  free(cost);
  free(successor);
  free(values);
  destroy_index(&ids);
  return 0;
}

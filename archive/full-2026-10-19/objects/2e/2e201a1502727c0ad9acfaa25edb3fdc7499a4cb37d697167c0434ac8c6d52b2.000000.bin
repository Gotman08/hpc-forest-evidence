        "content": "#include <algorithm>\n#include <iostream>\n#include <utility>\n#include <vector>\n\nusing namespace std;\n\nconstexpr int MOD = 1000000007;\n\nstatic long long modPow(long long base, long long exponent) {\n    long long result = 1;\n    while (exponent > 0) {\n        if (exponent & 1LL) result = result * base % MOD;\n        base = base * base % MOD;\n        exponent >>= 1LL;\n    }\n    return result;\n}\n\nstatic long long centralBinomial(int n) {\n    long long numerator = 1;\n    long long denominator = 1;\n    for (int i = 1; i < n; ++i) {\n        numerator = numerator * (n - 1 + i) % MOD;\n        denominator = denominator * i % MOD;\n    }\n    return numerator * modPow(denominator, MOD - 2) % MOD;\n}\n\nclass Binomial {\npublic:\n    explicit Binomial(int maxN) : fact(maxN + 1), invFact(maxN + 1) {\n        fact[0] = 1;\n        for (int i = 1; i <= maxN; ++i) {\n            fact[i] = fact[i - 1] * i % MOD;\n        }\n        invFact[maxN] = modPow(fact[maxN], MOD - 2);\n        for (int i = maxN; i > 0; --i) {\n            invFact[i - 1] = invFact[i] * i % MOD;\n        }\n    }\n\n    long long choose(int n, int k) const {\n        if (k < 0 || k > n) return 0;\n        return fact[n] * invFact[k] % MOD * invFact[n - k] % MOD;\n    }\n\nprivate:\n    vector<long long> fact;\n    vector<long long> invFact;\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<pair<int, int>> blockedCells;\n    blockedCells.reserve(static_cast<size_t>(m));\n    for (int c = 0; c < m; ++c) {\n        int row, column;\n        cin >> row >> column;\n        blockedCells.emplace_back(row + column, row);\n    }\n    sort(blockedCells.begin(), blockedCells.end());\n    blockedCells.erase(unique(blockedCells.begin(), blockedCells.end()),\n                       blockedCells.end());\n\n    if (binary_search(blockedCells.begin(), blockedCells.end(), make_pair(0, 0)) ||\n        binary_search(blockedCells.begin(), blockedCells.end(),\n                      make_pair(2 * n - 2, n - 1))) {\n        cout << 0 << '\\n';\n        return 0;\n    }\n\n    if (blockedCells.empty()) {\n        cout << centralBinomial(n) << '\\n';\n        return 0;\n    }\n\n    const size_t obstacleCount = blockedCells.size();\n    if (n >= 64 && obstacleCount <= static_cast<size_t>(n / 8) &&\n        obstacleCount <= 2048) {\n        Binomial binomial(2 * n - 2);\n        vector<long long> firstHit(obstacleCount, 0);\n\n        for (size_t i = 0; i < obstacleCount; ++i) {\n            const int diagonal = blockedCells[i].first;\n            const int row = blockedCells[i].second;\n            const int column = diagonal - row;\n            long long ways = binomial.choose(diagonal, row);\n\n            for (size_t j = 0; j < i; ++j) {\n                const int previousDiagonal = blockedCells[j].first;\n                const int previousRow = blockedCells[j].second;\n                const int previousColumn = previousDiagonal - previousRow;\n                if (previousRow <= row && previousColumn <= column) {\n                    const int deltaRow = row - previousRow;\n                    const int deltaColumn = column - previousColumn;\n                    const long long throughPrevious =\n                        firstHit[j] * binomial.choose(deltaRow + deltaColumn,\n                                                      deltaRow) % MOD;\n                    ways -= throughPrevious;\n                    if (ways < 0) ways += MOD;\n                }\n            }\n            firstHit[i] = ways;\n        }\n\n        long long answer = binomial.choose(2 * n - 2, n - 1);\n        for (size_t i = 0; i < obstacleCount; ++i) {\n            const int row = blockedCells[i].second;\n            const int column = blockedCells[i].first - row;\n            const int remainingRows = n - 1 - row;\n            const int remainingColumns = n - 1 - column;\n            const long long throughObstacle =\n                firstHit[i] * binomial.choose(remainingRows + remainingColumns,\n                                              remainingRows) % MOD;\n            answer -= throughObstacle;\n            if (answer < 0) answer += MOD;\n        }\n\n        cout << answer << '\\n';\n        return 0;\n    }\n\n    vector<int> previous(n, 0);\n    vector<int> current(n, 0);\n    size_t blockedIndex = 0;\n\n    previous[0] = 1;\n    while (blockedIndex < blockedCells.size() &&\n           blockedCells[blockedIndex].first == 0) {\n        previous[0] = 0;\n        ++blockedIndex;\n    }\n\n    for (int diagonal = 1; diagonal <= 2 * n - 2; ++diagonal) {\n        const bool growing = diagonal < n;\n        const int lowRow = growing ? 0 : diagonal - n + 1;\n        const int length = growing ? diagonal + 1 : 2 * n - 1 - diagonal;\n\n        const int* __restrict__ previousData = previous.data();\n        int* __restrict__ currentData = current.data();\n\n        if (growing) {\n            const int last = length - 1;\n            currentData[0] = previousData[0];\n            currentData[last] = previousData[last - 1];\n\n            #pragma GCC ivdep\n            for (int i = 1; i < last; ++i) {\n                int ways = previousData[i - 1] + previousData[i];\n                if (ways >= MOD) ways -= MOD;\n                currentData[i] = ways;\n            }\n        } else {\n            #pragma GCC ivdep\n            for (int i = 0; i < length; ++i) {\n                int ways = previousData[i] + previousData[i + 1];\n                if (ways >= MOD) ways -= MOD;\n                currentData[i] = ways;\n            }\n        }\n\n        while (blockedIndex < blockedCells.size() &&\n               blockedCells[blockedIndex].first == diagonal) {\n            const int index = blockedCells[blockedIndex].second - lowRow;\n            currentData[index] = 0;\n            ++blockedIndex;\n        }\n\n        previous.swap(current);\n    }\n\n    cout << previous[0] << '\\n';\n    return 0;\n}",
        "path": "src/solution.cpp"
      }

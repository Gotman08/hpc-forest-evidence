#include <algorithm>
#include <cstdint>
#include <iostream>
#include <vector>

using namespace std;

const int MOD = 1000000007;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    cin >> n >> m;

    vector<uint64_t> blocked;
    blocked.reserve(m);
    for (int c = 0; c < m; ++c) {
        int row, col;
        cin >> row >> col;
        blocked.push_back(static_cast<uint64_t>(row) * static_cast<uint64_t>(n) + static_cast<uint64_t>(col));
    }
    sort(blocked.begin(), blocked.end());
    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());

    vector<int> dp(n, 0);
    dp[0] = 1;

    size_t obstacle = 0;
    uint64_t cell = 0;
    for (int row = 0; row < n; ++row) {
        for (int col = 0; col < n; ++col, ++cell) {
            if (obstacle < blocked.size() && blocked[obstacle] == cell) {
                dp[col] = 0;
                ++obstacle;
            } else if (col > 0) {
                int paths = dp[col] + dp[col - 1];
                dp[col] = paths >= MOD ? paths - MOD : paths;
            }
        }
    }

    cout << dp[n - 1] << endl;
}

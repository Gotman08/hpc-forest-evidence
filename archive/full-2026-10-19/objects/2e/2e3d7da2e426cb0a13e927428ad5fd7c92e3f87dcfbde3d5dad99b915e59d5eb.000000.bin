from pathlib import Path
import datetime,hashlib,json,re
OP=Path(__file__).resolve().parent; PREP=OP.parent; BASE=PREP.parents[1]
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
ref=lambda p:{'path':str(p),'sha256':sha(p)}
rx=OP/'reception-contrats-zero-appel-preparee-r1'
recon=rx/'execution-root-01/RECONCILIATION-TROIS-ROOTS-ZERO-APPEL.json'
review=rx/'revue-independante-reception-reelle-r1/REVUE-RECEPTION-REELLE-TROIS-ROOTS-ZERO-APPEL.json'
assert sha(recon)=='41148d0b7c671491a004827978270f3d9715c1868142f491121065a1caa6a6bf'
assert sha(review)=='5480bda4c674d4c7104c18e13f1480eb8a7b2468044e942041c86d6b4c8fcfbe'
value=json.loads(recon.read_bytes())
assert value['verified_metadata_only'] and value['restored_regular_files']==15
assert all(value[k]==0 for k in ('published_requests','native_invocations','native_model_calls','responses','deliveries','unknown_invocations'))
closed={'schema':'hpc-forest-r4b-three-technical-roots-zero-invocation-closure-v1','verified_metadata_only':True,
    'job_ids':value['job_ids'],'source_zip_sha256':value['source_zip_sha256'],'plan_sha256':value['plan_sha256'],
    'reconciliation':ref(recon),'actual_cold_results_review':ref(review),
    'independent_receiver_code_review':ref(OP/'audit-compatibilite-factory-reelle-r1/REVUE-RECEPTEUR-ZERO-APPEL-PREPARATION.json'),
    'results_reviewer_also_authored_receiver_explicit_in_review':True,'restored_regular_files':15,'restored_bytes':19449,
    'prepared_requests':3,'published_requests':0,'native_invocations':0,'unknown_invocations':0,
    'all_started_calls_reconciled':True,'old_roots_preserved_not_reusable_as_fresh':True,
    'model_worker_processes_started_or_stopped':0,'observer_untouched':True,'active_native_workers_at_recorded_cim':0,
    'recorded_cim_time_utc':'2026-10-18T18:53:59.9802935Z',
    'future_current_state_promised':False,'scientific_native_method_or_OBS4_terminal_admission':False,
    'next_research_requires_new_exact_qualification_and_all_actual_admissions':True}
canonical=OP/'CLOTURE-TECHNIQUE-TROIS-ROOTS-ZERO-APPEL.json'
with canonical.open('x',encoding='utf8',newline='\n') as f:json.dump(closed,f,indent=2);f.write('\n')
guide=BASE/'outputs/HPC-Forest-Harnais-Comparaison-r1/SUIVI-COMPACT.md'; ids=BASE/'ID.md'
assert sha(guide)=='6ede3726f7b19606af1490f563b5f850cd34dff88b258e37d9bccdb2ed96e0e7'
assert sha(ids)=='0def00eb2554da381dae203896fe50054e1dfacca502a9ef4b625d40cfbf2e46'
old={p.name:p.read_bytes() for p in (guide,ids)}
stamp=datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
archive=OP/('archivage-guide-'+stamp); archive.mkdir(exist_ok=False)
for name,data in old.items():
    (archive/name).write_bytes(data)
    assert (archive/name).read_bytes()==data
before_ids=re.findall(r'^\| (ID-\d{3}) \|',old['ID.md'].decode('utf8'),re.M)
assert len(before_ids)==len(set(before_ids))==40
text=old['SUIVI-COMPACT.md'].decode('utf8')
text=text.replace('État du 18 octobre 2026, après réception mécanique R3 et démarrage passif OBS4.',
    'État du 18 octobre 2026, après clôture technique des trois roots R3 sans invocation et préparation R7.')
text=text.replace('R2 corrigé est prioritaire, puis une seule campagne mère dynamique R3 corrigée par R4b ;',
    'R2g est clos partiel ; poursuivre une seule campagne mère dynamique R3 corrigée par R4b selon la préparation R7 et ses admissions ;')
start=text.index('INCIDENT DE GARDE AVANT MODÈLE :')
end=text.index('L’ancienne source105',start)
replacement='''RÉCEPTION TECHNIQUE CLOSE SANS APPEL : Sol754295/Astra754296/Terra754299, trois FAILED1:0 au terme de l’attente d’autorisation600s (18:39:31/18:39:46/18:40:07UTC). Trois requêtes PRÉPARÉES, zéro publiée, invocation, réponse, livraison ou inconnue. Les cinq fichiers par job sont restaurés neufs, soit15fichiers/19449octets stables. Les trois annonces/distantes/locales sont égales : Sol `0523796528748448ce22b629d797d1d6e424f081f3f427a863734553bb456d7b`, Astra `f9ba4d47c98ec2fd3d52b37d8d3673dec6dccf08b6278b17de385abd40e67a2e`, Terra `4faddc28c3ef4e10bd4b24705ea4ce9bf455d3ecf0c41647d5ae9e60e4fd0a12`. Annonce seule754337 COMPLETED0:0,1CPU/1Gio/0GPU/1seconde, sans modifier les archives ni rejouer de test/modèle. Trois efficacités originales4CPU/16Gio/0GPU reçues ; aucune inférence de performance HPC.

Canonique `../HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r3/operations-parent-premier-roots-source110-r1/CLOTURE-TECHNIQUE-TROIS-ROOTS-ZERO-APPEL.json` ; réconciliation réelle `41148d0b7c671491a004827978270f3d9715c1868142f491121065a1caa6a6bf`, revue froide réelle `5480bda4…`, revue indépendante du code lecteur `acb71b53…`.114 fichiers rehashés stables ; l’auteur du lecteur a relu les résultats ROOT, cette qualité est explicitée. CIM496 du18:53:59.9802935UTC : deux classifieurs exacts constatent zéro natif et trois caches absents. Aucun worker de modèle lancé ou arrêté, aucun processus étranger touché. Il s’agit d’une clôture de MÉTADONNÉES, pas d’une admission native, scientifique ou terminaleOBS4. Ne plus poller/rejouer ces trois jobs ni l’annonce754337.

Erreurs techniques conservées : garde d’admission OBS4 reprenant un TTL120s historique, corrigé par sidecar extérieur revu `78c5c7f6…` sans modifier le watcher ; référence de politique CLI enrichie de bytes, corrigée uniquement dans une nouvelle entrée fermée ; puis contradiction réelle du consommateur reader_bridge L129/L132 : ancien reçu9c449 imposé alors qu’il ne possède pas le booléen exigé. La vraie revue source-state `1a65d2c2…` ne peut pas passer ce code inchangé. Les refus/roothelpers01/02 restent intacts. Aucun appel commencé rejoué, aucune durée expirée recréditée.

R6 corrige seulement cette liaison de revue (bridge623be597…,COMPONENTSa7ad420a…,10cas neutres) ; les paquetsQ préparés n’ont PAS été soumis et ne sont pas un chemin de relance admis. Les trois anciennes racines existent : le stage et ses commandes refusent leur réutilisation. Aucun nettoyage pour les rendre artificiellement fraîches.

SUITE ACTIVE EN PRÉPARATION : `adaptateurs-source110-r1/revision-r7-racines-techniques-neuves/` sous la préparationR3. Source110 ZIPeaff inchangée ; nouveau plan technique `5c3cc0082589257897caf79caf90c678f931eefcecb823f315ef614f72b9de70`. Seuls trois UUID roots changent : Sol `80d47d8d3f8f4e35bc26ceb54d06e870`, Astra `29583a77237e4777aa09209331ec7ecd`, Terra `3ae8341d27784c1bbd830ac19e4b77bc`. Six advice/harvest, quatre cellules scientifiques dont Luna, méthode/MAX/ressources/oracles/budgets conservés ; aucun négatif Luna à un appel rejoué. Nouvelle revue source/plan `33b05b68…`.62composants (47changés/15identiques),COMPONENTSdc64e136…,94cas locaux73+5+16 reçus, livraison09fb044a… ; revue code indépendante et candidatQ en cours. Ne pas utiliser les anciennes Q/revues d08/1e60 comme qualification5c3c/dc64.

Avant tout effet R7 : finir la revue active, qualifier le paquet FINAL exact sous allocation (274tests et DEUX sondes officielles neutres GCC/G++/OpenMP, zéro LLM/candidat), recevoir/auditer/relier profil du VRAI nouveaujob et héritage exact des contrats, rebinder parents/politiques/lecteurs/commandes et tester la composition complète des métadonnées avant d’engager600s réels. OBS4r5 reste vivant : cache local18:56UTC observing/transitiontrue/zéro natif, trois terminaux en cache, SO/Luna non interrogés. Ses pending ne sont pas réécrits en terminal positif ; une garde parent de clôture/absence complète de cet OBS4 possédé doit précéder tout nouveau watcher R7. Vérifier les identités complètes fraîches, arrêt individuel seulement après conservation/réconciliation ; aucun redémarrage ou renommage implicite. Aucun modèle, worker ou jobQ R7 lancé à cet arrêté.

''' 
text=text[:start]+replacement+text[end:]
text=text.replace('Dernier contrôle frais de ce tour :85%utilisés/15%restants, aucun reset consommé.',
    'Dernier contrôle frais de ce tour :89%utilisés/11%restants, aucun reset consommé.')
text+='\nPréservation avant la clôture roots : `'+str(archive.relative_to(BASE)).replace('\\','/')+'` ; guide et quarante ID à SHA vérifiés.\n'
idtext=old['ID.md'].decode('utf8')
idtext=idtext.replace('R3 corrigé R4b : qualification mécanique source110 reçue (265 tests ARM64, cible et contrats audités), OBS4 passif vivant ; admissions natives non émises, garde historique en correction isolée.',
    'R3 corrigé R4b : Q mécanique source110/d08 reçue, trois contrats techniques754295/296/299 clos après attente autorisation (15 fichiers, zéro requête publiée/invocation). Contradiction de revue confirmée ; nouvelle préparation R7/plan5c3c/3roots neufs, aucune Q R7 ni admission native. OBS4 ancien passif préservé.')
assert re.findall(r'^\| (ID-\d{3}) \|',idtext,re.M)==before_ids
guide.write_text(text,encoding='utf8',newline='\n');ids.write_text(idtext,encoding='utf8',newline='\n')
receipt={'schema':'hpc-forest-guide-and-40-id-after-zero-call-closure-v1','verified':True,'before':{k:hashlib.sha256(v).hexdigest() for k,v in old.items()},'after':{p.name:sha(p) for p in (guide,ids)},'canonical_zero_call_closure':ref(canonical),'preserved_unique_ids':40,'new_scientific_results_added':False,'archive':str(archive)}
with (archive/'PRESERVATION-ET-MISE-A-JOUR.json').open('x',encoding='utf8',newline='\n') as f:json.dump(receipt,f,indent=2);f.write('\n')
print(json.dumps(receipt))

#include "knn.h"
#include <limits.h>
#include <stdint.h>
#include <string.h>

static char knn_insertion_fallback(int n_groups, Group *groups, int k, Point to_evaluate) {
    char *labels = (char *) malloc(sizeof(char) * k);
    float *distances = (float *) malloc(sizeof(float) * k);
    int i, j, x, y;

    for (i = 0; i < k; i++) {
        labels[i] = -1;
        distances[i] = -1;
    }

    for (i = 0; i < n_groups; i++) {
        Group g = groups[i];
        for (j = 0; j < g.length; j++) {
            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);
            for (x = 0; x < k; x++) {
                if (d < distances[x] || distances[x] == -1) {
                    for (y = k - 1; y > x; y--) {
                        distances[y] = distances[y - 1];
                        labels[y] = labels[y - 1];
                    }
                    distances[x] = d;
                    labels[x] = g.label;
                    break;
                }
            }
        }
    }

    qsort(labels, k, sizeof(char), compare_for_sort);
    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }
            current_frequency = 1;
        } else {
            current_frequency++;
        }
        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    free(distances);
    free(labels);
    return most_frequent;
}

static char knn_vote(const size_t *counts) {
    char winner = (char)-1;
    size_t largest = 0;
    for (int value = CHAR_MIN; value <= CHAR_MAX; ++value) {
        unsigned char index = (unsigned char)(char)value;
        if (counts[index] > largest) {
            largest = counts[index];
            winner = (char)value;
        }
    }
    return winner;
}

static int knn_compare_keys(const void *a, const void *b) {
    uint64_t left = *(const uint64_t *)a;
    uint64_t right = *(const uint64_t *)b;
    return (left > right) - (left < right);
}

static uint64_t knn_median_key(uint64_t a, uint64_t b, uint64_t c) {
    if (a < b) {
        if (b < c) return b;
        return a < c ? c : a;
    }
    if (a < c) return a;
    return b < c ? c : b;
}

static void knn_select_prefix(uint64_t *keys, size_t count, size_t keep) {
    size_t first = 0;
    size_t last = count;
    size_t rank = keep - 1;
    unsigned depth = 0;
    for (size_t span = count; span > 1; span >>= 1) depth += 2;

    while (last - first > 24) {
        if (depth == 0) {
            qsort(keys + first, last - first, sizeof(*keys), knn_compare_keys);
            return;
        }
        --depth;

        size_t middle = first + (last - first) / 2;
        uint64_t pivot = knn_median_key(keys[first], keys[middle], keys[last - 1]);
        size_t left = first;
        size_t right = last - 1;

        for (;;) {
            while (keys[left] < pivot) ++left;
            while (keys[right] > pivot) --right;
            if (left >= right) break;
            uint64_t temporary = keys[left];
            keys[left] = keys[right];
            keys[right] = temporary;
            ++left;
            --right;
        }

        size_t split = right + 1;
        if (split <= first || split >= last) {
            qsort(keys + first, last - first, sizeof(*keys), knn_compare_keys);
            return;
        }
        if (rank < split) last = split;
        else first = split;
    }

    for (size_t i = first + 1; i < last; ++i) {
        uint64_t value = keys[i];
        size_t j = i;
        while (j > first && value < keys[j - 1]) {
            keys[j] = keys[j - 1];
            --j;
        }
        keys[j] = value;
    }
}

char knn(int n_groups, Group *groups, int k, Point to_evaluate) {
    if (k <= 0) return knn_insertion_fallback(n_groups, groups, k, to_evaluate);

    size_t total = 0;
    for (int i = 0; i < n_groups; ++i) {
        if (groups[i].length > 0) {
            size_t length = (size_t)groups[i].length;
            if (length > SIZE_MAX - total)
                return knn_insertion_fallback(n_groups, groups, k, to_evaluate);
            total += length;
        }
    }

    size_t counts[UCHAR_MAX + 1] = {0};
    size_t wanted = (size_t)k;
    if (wanted >= total) {
        for (int i = 0; i < n_groups; ++i) {
            if (groups[i].length > 0)
                counts[(unsigned char)groups[i].label] += (size_t)groups[i].length;
        }
        counts[(unsigned char)(char)-1] += wanted - total;
        return knn_vote(counts);
    }

    size_t spare = wanted < 1024 ? 1024 : wanted;
    size_t capacity = total;
    if (spare < total - wanted)
        capacity = wanted + spare;
    int streaming = capacity < total;

    if (sizeof(float) != sizeof(uint32_t) || capacity > SIZE_MAX / sizeof(uint64_t))
        return knn_insertion_fallback(n_groups, groups, k, to_evaluate);

    uint64_t *keys = (uint64_t *) malloc(capacity * sizeof(*keys));
    if (keys == NULL)
        return knn_insertion_fallback(n_groups, groups, k, to_evaluate);

    float distance_tile[256];
    size_t used = 0;
    uint64_t cutoff = UINT64_MAX;
    int unordered = 0;

    for (int i = 0; i < n_groups; ++i) {
        Group g = groups[i];
        size_t length = g.length > 0 ? (size_t)g.length : 0;
        uint64_t group_order = (uint64_t)(uint32_t)i;
        size_t base = 0;

        while (base < length) {
            size_t block = length - base;
            if (block > 256) block = 256;
            for (size_t j = 0; j < block; ++j)
                distance_tile[j] = euclidean_distance_no_sqrt(to_evaluate, g.points[base + j]);

            if (!streaming) {
                for (size_t j = 0; j < block; ++j) {
                    uint32_t bits;
                    memcpy(&bits, &distance_tile[j], sizeof(bits));
                    bits &= UINT32_C(0x7fffffff);
                    unordered |= bits > UINT32_C(0x7f800000);
                    keys[used + j] = ((uint64_t)bits << 32) | group_order;
                }
                used += block;
            } else {
                for (size_t j = 0; j < block; ++j) {
                    uint32_t bits;
                    memcpy(&bits, &distance_tile[j], sizeof(bits));
                    bits &= UINT32_C(0x7fffffff);
                    unordered |= bits > UINT32_C(0x7f800000);
                    uint64_t key = ((uint64_t)bits << 32) | group_order;

                    /* Equal keys identify the same group and are interchangeable. */
                    if (key < cutoff) {
                        keys[used++] = key;
                        if (used == capacity) {
                            knn_select_prefix(keys, used, wanted);
                            used = wanted;
                            cutoff = keys[wanted - 1];
                        }
                    }
                }
            }
            base += block;
        }
    }

    if (unordered) {
        free(keys);
        return knn_insertion_fallback(n_groups, groups, k, to_evaluate);
    }

    if (used > wanted)
        knn_select_prefix(keys, used, wanted);
    for (size_t i = 0; i < wanted; ++i) {
        size_t group_index = (size_t)(uint32_t)keys[i];
        ++counts[(unsigned char)groups[group_index].label];
    }

    free(keys);
    return knn_vote(counts);
}

int main() {
    int n_groups = parse_number_of_groups();
    Group *groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();
    Point to_evaluate = parse_point();
    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

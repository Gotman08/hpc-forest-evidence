      "content": "#include \"knn.h\"\n#include <limits.h>\n#include <math.h>\n#include <stdint.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nenum { KNN_MAX_WORKERS = 4, KNN_LABEL_VALUES = UCHAR_MAX + 1 };\n\nstatic char reference_knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *) malloc(sizeof(char) * k);\n    float *distances = (float *) malloc(sizeof(float) * k);\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = (char)-1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nstatic char label_mode(const size_t *counts) {\n    char result = (char)-1;\n    size_t best = 0;\n    for (int value = CHAR_MIN; value <= CHAR_MAX; ++value) {\n        size_t count = counts[(unsigned char)value];\n        if (count > best) {\n            best = count;\n            result = (char)value;\n        }\n    }\n    return result;\n}\n\nstatic int worker_count(size_t total) {\n#ifdef _OPENMP\n    if (total >= 65536) {\n        int workers = omp_get_max_threads();\n        if (workers > KNN_MAX_WORKERS) workers = KNN_MAX_WORKERS;\n        if (workers < 1) workers = 1;\n        return workers;\n    }\n#else\n    (void)total;\n#endif\n    return 1;\n}\n\nstatic void point_slice(size_t total, int parts, int part,\n                        size_t *begin, size_t *end) {\n    size_t width = total / (size_t)parts;\n    size_t extra = total % (size_t)parts;\n    size_t id = (size_t)part;\n    *begin = id * width + (id < extra ? id : extra);\n    *end = *begin + width + (id < extra ? 1 : 0);\n}\n\nstatic int first_group(const size_t *offsets, int n_groups, size_t begin) {\n    int low = 0;\n    int high = n_groups;\n    while (low < high) {\n        int middle = low + (high - low) / 2;\n        if (offsets[middle + 1] <= begin) {\n            low = middle + 1;\n        } else {\n            high = middle;\n        }\n    }\n    return low;\n}\n\nstatic int fill_distance_range(int n_groups, const Group *groups,\n                               const size_t *offsets, Point to_evaluate,\n                               size_t begin, size_t end,\n                               float *original, float *work) {\n    int unordered = 0;\n    for (int g = first_group(offsets, n_groups, begin);\n         g < n_groups && offsets[g] < end; ++g) {\n        size_t start = offsets[g] > begin ? offsets[g] : begin;\n        size_t stop = offsets[g + 1] < end ? offsets[g + 1] : end;\n        for (size_t pos = start; pos < stop; ++pos) {\n            float d = euclidean_distance_no_sqrt(\n                to_evaluate, groups[g].points[pos - offsets[g]]);\n            original[pos] = d;\n            work[pos] = d;\n            if (isnan(d)) unordered = 1;\n        }\n    }\n    return unordered;\n}\n\nstatic int compare_distances(const void *a, const void *b) {\n    float x = *(const float *)a;\n    float y = *(const float *)b;\n    return (x > y) - (x < y);\n}\n\nstatic float select_distance(float *values, size_t n, size_t target) {\n    size_t left = 0;\n    size_t right = n;\n    size_t budget = n <= SIZE_MAX / 4 ? n * 4 : SIZE_MAX;\n\n    while (right - left > 32) {\n        size_t span = right - left;\n        if (budget < span) {\n            qsort(values + left, span, sizeof(float), compare_distances);\n            return values[target];\n        }\n        budget -= span;\n\n        float a = values[left];\n        float b = values[left + span / 2];\n        float c = values[right - 1];\n        if (a > b) {\n            float temporary = a;\n            a = b;\n            b = temporary;\n        }\n        if (b > c) b = c;\n        if (a > b) b = a;\n        float pivot = b;\n\n        size_t lower = left;\n        size_t scan = left;\n        size_t upper = right;\n        while (scan < upper) {\n            float value = values[scan];\n            if (value < pivot) {\n                values[scan] = values[lower];\n                values[lower] = value;\n                ++lower;\n                ++scan;\n            } else if (value > pivot) {\n                --upper;\n                values[scan] = values[upper];\n                values[upper] = value;\n            } else {\n                ++scan;\n            }\n        }\n\n        if (target < lower) {\n            right = lower;\n        } else if (target >= upper) {\n            left = upper;\n        } else {\n            return pivot;\n        }\n    }\n\n    for (size_t i = left + 1; i < right; ++i) {\n        float value = values[i];\n        size_t j = i;\n        while (j > left && value < values[j - 1]) {\n            values[j] = values[j - 1];\n            --j;\n        }\n        values[j] = value;\n    }\n    return values[target];\n}\n\nstatic void count_vote_range(int n_groups, const Group *groups,\n                             const size_t *offsets, const float *distances,\n                             size_t begin, size_t end, float cutoff,\n                             size_t *strict_votes, size_t *equal_votes,\n                             size_t *less_count, size_t *equal_count) {\n    size_t less_total = 0;\n    size_t equal_total = 0;\n    for (int g = first_group(offsets, n_groups, begin);\n         g < n_groups && offsets[g] < end; ++g) {\n        size_t start = offsets[g] > begin ? offsets[g] : begin;\n        size_t stop = offsets[g + 1] < end ? offsets[g + 1] : end;\n        size_t less = 0;\n        size_t equal = 0;\n        for (size_t pos = start; pos < stop; ++pos) {\n            float d = distances[pos];\n            less += (d < cutoff);\n            equal += (d == cutoff);\n        }\n        unsigned char label = (unsigned char)groups[g].label;\n        strict_votes[label] += less;\n        equal_votes[label] += equal;\n        less_total += less;\n        equal_total += equal;\n    }\n    *less_count = less_total;\n    *equal_count = equal_total;\n}\n\nstatic void add_equal_prefix(int n_groups, const Group *groups,\n                             const size_t *offsets, const float *distances,\n                             size_t begin, size_t end, float cutoff,\n                             size_t take, size_t *votes) {\n    for (int g = first_group(offsets, n_groups, begin);\n         g < n_groups && offsets[g] < end && take != 0; ++g) {\n        size_t start = offsets[g] > begin ? offsets[g] : begin;\n        size_t stop = offsets[g + 1] < end ? offsets[g + 1] : end;\n        size_t equal = 0;\n        for (size_t pos = start; pos < stop; ++pos) {\n            equal += (distances[pos] == cutoff);\n        }\n        /* Equal-distance points within one group have the same label. */\n        size_t accepted = equal < take ? equal : take;\n        votes[(unsigned char)groups[g].label] += accepted;\n        take -= accepted;\n    }\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 1) return reference_knn(n_groups, groups, k, to_evaluate);\n\n    size_t total = 0;\n    for (int g = 0; g < n_groups; ++g) {\n        if (groups[g].length > 0) {\n            size_t length = (size_t)groups[g].length;\n            if (total > SIZE_MAX - length) {\n                return reference_knn(n_groups, groups, k, to_evaluate);\n            }\n            total += length;\n        }\n    }\n\n    size_t totals[KNN_LABEL_VALUES] = {0};\n    if (total <= (size_t)k) {\n        for (int g = 0; g < n_groups; ++g) {\n            if (groups[g].length > 0) {\n                totals[(unsigned char)groups[g].label] +=\n                    (size_t)groups[g].length;\n            }\n        }\n        totals[(unsigned char)((char)-1)] += (size_t)k - total;\n        return label_mode(totals);\n    }\n\n    if ((size_t)n_groups >= SIZE_MAX / sizeof(size_t) ||\n        total > SIZE_MAX / sizeof(float)) {\n        return reference_knn(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t *offsets = (size_t *)malloc(((size_t)n_groups + 1) * sizeof(size_t));\n    float *original = (float *)malloc(total * sizeof(float));\n    float *work = (float *)malloc(total * sizeof(float));\n    if (offsets == NULL || original == NULL || work == NULL) {\n        free(work);\n        free(original);\n        free(offsets);\n        return reference_knn(n_groups, groups, k, to_evaluate);\n    }\n\n    offsets[0] = 0;\n    for (int g = 0; g < n_groups; ++g) {\n        offsets[g + 1] = offsets[g];\n        if (groups[g].length > 0) {\n            offsets[g + 1] += (size_t)groups[g].length;\n        }\n    }\n\n    int workers = worker_count(total);\n    int unordered = 0;\n#ifdef _OPENMP\n#pragma omp parallel for num_threads(workers) schedule(static) if(workers > 1) reduction(|:unordered)\n#endif\n    for (int part = 0; part < workers; ++part) {\n        size_t begin, end;\n        point_slice(total, workers, part, &begin, &end);\n        unordered |= fill_distance_range(n_groups, groups, offsets, to_evaluate,\n                                         begin, end, original, work);\n    }\n\n    if (unordered) {\n        free(work);\n        free(original);\n        free(offsets);\n        return reference_knn(n_groups, groups, k, to_evaluate);\n    }\n\n    float cutoff = select_distance(work, total, (size_t)k - 1);\n    free(work);\n\n    size_t strict_votes[KNN_MAX_WORKERS][KNN_LABEL_VALUES] = {{0}};\n    size_t equal_votes[KNN_MAX_WORKERS][KNN_LABEL_VALUES] = {{0}};\n    size_t less_counts[KNN_MAX_WORKERS] = {0};\n    size_t equal_counts[KNN_MAX_WORKERS] = {0};\n\n#ifdef _OPENMP\n#pragma omp parallel num_threads(workers) if(workers > 1)\n#endif\n    {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n        for (int part = 0; part < workers; ++part) {\n            size_t begin, end;\n            point_slice(total, workers, part, &begin, &end);\n            count_vote_range(n_groups, groups, offsets, original,\n                             begin, end, cutoff,\n                             strict_votes[part], equal_votes[part],\n                             &less_counts[part], &equal_counts[part]);\n        }\n\n        /* The preceding worksharing barrier publishes all prefix counts. */\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n        for (int part = 0; part < workers; ++part) {\n            size_t ties_needed = (size_t)k;\n            size_t earlier_equals = 0;\n            for (int p = 0; p < workers; ++p) {\n                ties_needed -= less_counts[p];\n                if (p < part) earlier_equals += equal_counts[p];\n            }\n            size_t take = ties_needed > earlier_equals\n                ? ties_needed - earlier_equals : 0;\n            if (take > equal_counts[part]) take = equal_counts[part];\n\n            if (take == equal_counts[part]) {\n                for (size_t label = 0; label < KNN_LABEL_VALUES; ++label) {\n                    strict_votes[part][label] += equal_votes[part][label];\n                }\n            } else if (take != 0) {\n                size_t begin, end;\n                point_slice(total, workers, part, &begin, &end);\n                add_equal_prefix(n_groups, groups, offsets, original,\n                                 begin, end, cutoff, take, strict_votes[part]);\n            }\n        }\n    }\n\n    for (int part = 0; part < workers; ++part) {\n        for (size_t label = 0; label < KNN_LABEL_VALUES; ++label) {\n            totals[label] += strict_votes[part][label];\n        }\n    }\n\n    free(original);\n    free(offsets);\n    return label_mode(totals);\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }

#include <iostream>
#include <vector>
#include <cstdio>
#include <algorithm>
#include <climits>
#ifdef _OPENMP
#include <omp.h>
#endif

int main() {
    int n, s;
    std::cin >> n >> s;
    // Read matrix using scanf for speed (as original)
    std::vector<std::vector<int>> mat(n, std::vector<int>(n));
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            scanf("%d", &mat[i][j]);
        }
    }

    // Build integral image (prefix sum) of size (n+1)x(n+1)
    std::vector<std::vector<long long>> pref(n + 1, std::vector<long long>(n + 1, 0));

    // First pass: row-wise prefix sums
    #pragma omp parallel for schedule(static)
    for (int i = 0; i < n; ++i) {
        long long row_sum = 0;
        for (int j = 0; j < n; ++j) {
            row_sum += mat[i][j];
            pref[i + 1][j + 1] = row_sum;
        }
    }

    // Second pass: column-wise accumulation to get full 2D prefix sums
    #pragma omp parallel for schedule(static)
    for (int j = 0; j < n; ++j) {
        long long col_sum = 0;
        for (int i = 0; i < n; ++i) {
            col_sum += pref[i + 1][j + 1];
            pref[i + 1][j + 1] = col_sum;
        }
    }

    // Search all SxS submatrices using integral image
    long long mxSum = LLONG_MIN;
    #pragma omp parallel for collapse(2) reduction(max:mxSum) schedule(guided)
    for (int i = 0; i <= n - s; ++i) {
        for (int j = 0; j <= n - s; ++j) {
            long long sum = pref[i + s][j + s] - pref[i][j + s] - pref[i + s][j] + pref[i][j];
            if (sum > mxSum) mxSum = sum;
        }
    }

    printf("%d\n", static_cast<int>(mxSum));
    return 0;
}

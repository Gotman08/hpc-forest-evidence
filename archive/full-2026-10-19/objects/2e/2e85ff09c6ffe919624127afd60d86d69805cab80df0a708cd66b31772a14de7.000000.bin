"""Measure unchanged audited ARM64 executables on allocated physical CPU subsets."""
from __future__ import annotations

import hashlib
import json
import os
import platform
import random
import resource
import signal
import statistics
import subprocess
import sys
import tarfile
import tempfile
import time
from datetime import UTC, datetime
from pathlib import Path

from preflight import run as allocated_preflight
from scaling_checks import check_output


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def write(path, value):
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf8")
    tmp.replace(path)


def main(root):
    job = os.environ.get("SLURM_JOB_ID", "")
    if not (job.isdigit() and platform.machine().lower() == "aarch64"
            and os.environ.get("SLURM_CPUS_PER_TASK") == "16"
            and os.environ.get("SLURM_MEM_PER_NODE") == "16384"
            and os.environ.get("SLURM_JOB_GPUS", "") in {"", "N/A"}):
        raise RuntimeError("Expected a real 16 CPU, 16 GiB, zero-GPU ARM64 allocation")
    frozen = json.loads((root / "FILES.sha256.json").read_text())

    def verify():
        for name, expected in frozen.items():
            path = root / name
            if path.is_symlink() or not path.resolve().is_relative_to(root) or sha(path) != expected:
                raise RuntimeError("Frozen post-hoc payload changed: " + name)

    verify()
    plan = json.loads((root / "plan.json").read_text())
    full_affinity = sorted(os.sched_getaffinity(0))
    topology = []
    for cpu in full_affinity:
        path = Path(f"/sys/devices/system/cpu/cpu{cpu}/topology")
        topology.append({"cpu": cpu, "package": (path / "physical_package_id").read_text().strip(),
                         "core": (path / "core_id").read_text().strip()})
    if len(full_affinity) != 16 or len({(v["package"], v["core"]) for v in topology}) != 16:
        raise RuntimeError("Exactly 16 distinct allocated physical cores must be accessible")
    output = root / "results"; output.mkdir(exist_ok=False)
    (output / "oracle-outputs").mkdir()
    gate = allocated_preflight(root, output)
    write(output / "preflight.json", gate)
    programs = {p["key"]: p for p in plan["binaries"]}
    for program in programs.values():
        header = (root / program["binary"]).read_bytes()[:20]
        if not (header[:6] == b"\x7fELF\x02\x01" and int.from_bytes(header[18:20], "little") == 183):
            raise RuntimeError("An unchanged little-endian AArch64 ELF executable is required")
    for p in programs.values(): (root / p["binary"]).chmod(0o500)
    deadline = time.monotonic() + plan["global_measurement_deadline_seconds"]
    started = time.monotonic()

    def execute(key, case, cores):
        binary = root / programs[key]["binary"]
        env = {**os.environ, "OMP_NUM_THREADS": str(cores), "OMP_THREAD_LIMIT": str(cores),
               "OMP_DYNAMIC": "FALSE", "OMP_PROC_BIND": "close", "OMP_PLACES": "cores",
               "OPENBLAS_NUM_THREADS": str(cores), "MKL_NUM_THREADS": str(cores), "CUDA_VISIBLE_DEVICES": ""}
        result = {"cores_accessible": cores, "cpu_affinity": full_affinity[:cores]}
        os.sched_setaffinity(0, full_affinity[:cores])
        try:
            with tempfile.TemporaryDirectory(prefix="forest-scaling-", dir=root) as tmp, (root / case["input"]).open("rb") as stream:
                before = resource.getrusage(resource.RUSAGE_CHILDREN)
                begin = time.perf_counter()
                process = subprocess.Popen([str(binary)], stdin=stream, stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE, cwd=tmp, env=env, start_new_session=True)
                try:
                    raw, err = process.communicate(timeout=min(plan["per_execution_timeout_seconds"], max(.1, deadline - time.monotonic())))
                    result["returncode"] = process.returncode
                except subprocess.TimeoutExpired:
                    # Only this newly created subprocess group is owned by the diagnostic.
                    os.killpg(process.pid, signal.SIGKILL)
                    raw, err = process.communicate()
                    result.update(returncode=process.returncode, timed_out=True)
                elapsed = time.perf_counter() - begin
                after = resource.getrusage(resource.RUSAGE_CHILDREN)
                cpu = after.ru_utime + after.ru_stime - before.ru_utime - before.ru_stime
                result.update(seconds=elapsed, cpu_seconds=cpu, average_used_cores=cpu / elapsed,
                    stdout_sha256=hashlib.sha256(raw).hexdigest(), stdout_bytes=len(raw),
                    stderr=err.decode(errors="replace")[:2000])
                return result, raw
        finally:
            os.sched_setaffinity(0, full_affinity)

    results = {"schema": "hpc-forest-independent-domain-scaling-results-r3", "allocated_arm64_preflight": gate, "job_id": job,
        "observed_utc": datetime.now(UTC).isoformat(), "model_calls": 0, "source_edits": 0,
        "compilations": 0, "plan_sha256": sha(root / "plan.json"), "host": platform.node(),
        "resources": {"physical_cpu_count": 16, "affinity": full_affinity, "topology": topology,
            "memory_gib": 16, "gpus": 0, "architecture": "ARM64"},
        "measurement": "Full subprocess wall time with start-up and IO; getrusage CPU seconds; no thread sampler",
        "warmups": plan["warmups"], "repetitions": plan["repetitions"], "cores": plan["cores"],
        "separate_from_original_confirmations": True, "official_contest_compliance_certified": False,
        "points": [], "oracles": [], "round_orders": [], "complete": False,
        "unmeasured_cases": [], "payload_files_verified_before": len(frozen)}
    for position, case in enumerate(plan["cases"]):
        if time.monotonic() > deadline - 45:
            results["unmeasured_cases"] = [v["key"] for v in plan["cases"][position:]]; break
        oracle, raw = execute(case["canonical_reference_key"], case, 1)
        oracle["case_key"] = case["key"]
        oracle["matches_archived_expected"] = case["expected_stdout_sha256"] is None or oracle["stdout_sha256"] == case["expected_stdout_sha256"]
        oracle["accepted"] = oracle["returncode"] == 0 and oracle["matches_archived_expected"] and not oracle.get("timed_out")
        if oracle["accepted"]:
            oracle["independent_semantic_check"] = check_output(case["subject"], (root / case["input"]).read_bytes(), raw)
        results["oracles"].append(oracle)
        if not oracle["accepted"]:
            results["points"].append({"case_key": case["key"], "reference_failed": True})
            write(output / "results.json", results); continue
        (output / "oracle-outputs" / case["input_sha256"]).write_bytes(raw)
        points = {(key, cores): {"case_key": case["key"], "subject": case["subject"], "program_key": key,
            "cores": cores, "input_sha256": case["input_sha256"], "size": case["input_domain_review"]["size"],
            "samples": [], "correct": True, "warmup": None} for key, p in programs.items()
            if p["subject"] == case["subject"] for cores in plan["cores"]}
        rng = random.Random(plan["seed"] + position)
        for repeat in range(plan["repetitions"] + plan["warmups"]):
            order = list(points); rng.shuffle(order)
            results["round_orders"].append({"case_key": case["key"], "repeat": repeat, "warmup": repeat == 0, "order": order})
            for key, cores in order:
                point = points[key, cores]
                if point.get("execution_failure_recorded") or time.monotonic() > deadline - 30:
                    point["incomplete"] = len(point["samples"]) < plan["repetitions"]; continue
                value, _ = execute(key, case, cores)
                value["matches_oracle"] = value["returncode"] == 0 and not value.get("timed_out") and value["stdout_sha256"] == oracle["stdout_sha256"]
                point["correct"] &= value["matches_oracle"]
                if repeat == 0: point["warmup"] = value
                else: point["samples"].append(value)
                if value.get("timed_out") or value["returncode"] != 0:
                    point["execution_failure_recorded"] = True
        for point in points.values():
            good = point["correct"] and len(point["samples"]) == plan["repetitions"]
            times = [v["seconds"] for v in point["samples"]]
            point["full_valid_measurement"] = good
            point["mean_seconds"] = statistics.mean(times) if good else None
            point["stdev_seconds"] = statistics.stdev(times) if good else None
            point["median_seconds"] = statistics.median(times) if good else None
            point["mean_average_used_cores"] = statistics.mean(v["average_used_cores"] for v in point["samples"]) if good else None
            results["points"].append(point)
        write(output / "results.json", results)
        print(json.dumps({"event": "scaling_case_end", "subject": case["subject"], "case": case["name"],
            "size": case["input_domain_review"]["size"], "points": len(points),
            "all_valid": all(v["full_valid_measurement"] for v in points.values())}), flush=True)
    verify()
    results["payload_files_verified_after"] = len(frozen)
    results["elapsed_seconds"] = time.monotonic() - started
    results["complete"] = not results["unmeasured_cases"] and len(results["oracles"]) == len(plan["cases"])
    write(output / "results.json", results)
    write(output / "FILES.sha256.json", {p.relative_to(output).as_posix(): sha(p) for p in output.rglob("*") if p.is_file()})
    archive = root / "results.tar.gz"
    with tarfile.open(archive, "x:gz") as stream: stream.add(output, arcname="results")
    print(json.dumps({"event": "scaling_end", "archive": str(archive), "sha256": sha(archive),
        "complete": results["complete"], "points": len(results["points"]), "model_calls": 0}), flush=True)


if __name__ == "__main__":
    main(Path(sys.argv[1]).resolve(strict=True))

#include <cstdio>
#include <vector>
#include <climits>

class FastScanner {
    static constexpr int BUFSIZE = 1 << 20;
    char buf[BUFSIZE];
    char* cur;
    char* end;
    bool refill() {
        size_t r = fread(buf, 1, BUFSIZE, stdin);
        cur = buf;
        end = buf + r;
        return r > 0;
    }
public:
    FastScanner() : cur(buf), end(buf) {}
    inline int nextInt() {
        while (true) {
            if (cur == end && !refill()) return 0;
            char c = *cur++;
            if (c <= ' ') continue;
            int sign = 1;
            if (c == '-') {
                sign = -1;
                if (cur == end && !refill()) return 0;
                c = *cur++;
            }
            int x = c - '0';
            while (true) {
                if (cur == end && !refill()) break;
                char d = *cur++;
                if (d < '0' || d > '9') break;
                x = x * 10 + (d - '0');
            }
            return sign * x;
        }
    }
};

int main() {
    FastScanner fs;
    int n = fs.nextInt();
    int s = fs.nextInt();

    std::vector<long long> colSum(n, 0);
    std::vector<int> ring((size_t)s * n);
    std::vector<int> newRow(n);
    std::vector<long long> pref(n + 1);

    // Read first S rows and initialize column sums.
    for (int i = 0; i < s; ++i) {
        int* rowPtr = &ring[(size_t)i * n];
        int j = 0;
        for (; j + 3 < n; j += 4) {
            newRow[j]   = fs.nextInt();
            newRow[j+1] = fs.nextInt();
            newRow[j+2] = fs.nextInt();
            newRow[j+3] = fs.nextInt();
        }
        for (; j < n; ++j) newRow[j] = fs.nextInt();

        #pragma omp simd
        for (int k = 0; k < n; ++k) {
            rowPtr[k] = newRow[k];
            colSum[k] += static_cast<long long>(newRow[k]);
        }
    }

    // Helper to compute the maximum SxS window from current column sums.
    auto updateMax = [&](long long& mx) {
        pref[0] = 0;
        for (int i = 0; i < n; ++i) pref[i+1] = pref[i] + colSum[i];
        #pragma omp simd reduction(max:mx)
        for (int j = 0; j <= n - s; ++j) {
            long long w = pref[j+s] - pref[j];
            if (w > mx) mx = w;
        }
    };

    long long mx = LLONG_MIN;
    updateMax(mx);

    // Slide the S-row window downward.
    int nextSlot = 0;
    const int limit = n - s;
    for (int step = 1; step <= limit; ++step) {
        int* rowPtr = &ring[(size_t)nextSlot * n];
        long long* cs = colSum.data();

        // Read the entire new row into a temporary buffer.
        int j = 0;
        for (; j + 3 < n; j += 4) {
            newRow[j]   = fs.nextInt();
            newRow[j+1] = fs.nextInt();
            newRow[j+2] = fs.nextInt();
            newRow[j+3] = fs.nextInt();
        }
        for (; j < n; ++j) newRow[j] = fs.nextInt();

        // Update column sums and ring slot with SIMD vectorization.
        #pragma omp simd
        for (int k = 0; k < n; ++k) {
            int v = newRow[k];
            long long delta = static_cast<long long>(v) - rowPtr[k];
            rowPtr[k] = v;
            cs[k] += delta;
        }

        updateMax(mx);

        ++nextSlot;
        if (nextSlot == s) nextSlot = 0;
    }

    std::printf("%lld\n", static_cast<long long>(mx));
    return 0;
}

        "content": "#include <iostream>\n#include <vector>\n#include <utility>\n#include <algorithm>\n#include <string>\n#include <cstddef>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\ntypedef vector<vector<bool>> adjacency_matrix;\n\nadjacency_matrix readGraph();\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence);\ninline void printPermutation(vector<int> &equivalence);\n\n#ifdef _OPENMP\nstatic bool parallelHeapSearch(adjacency_matrix &g1, adjacency_matrix &g2,\n                               const vector<int> &initial);\n#endif\n\nint main(){\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if(!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\n    vector<int> equivalence(g1.size(), 0);\n    vector<int> exchange_counter(g1.size(), 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    if(g1.size() != g2.size()) return false;\n\n    for(int i = 0; i < equivalence.size(); ++i)\n        equivalence[i] = i;\n\n    if(verifyPermutation(g1, g2, equivalence)){\n        printPermutation(equivalence);\n        return true;\n    }\n\n#ifdef _OPENMP\n    if(equivalence.size() >= 8 && omp_get_max_threads() > 1 && !omp_in_parallel())\n        return parallelHeapSearch(g1, g2, equivalence);\n#endif\n\n    /*\n     * Permutations are based on Heap's algorithm, which generates all possible\n     * permutations for a given set of elements.\n     */\n    while(exchange_index < g1.size()){\n        if(exchange_counter[exchange_index] < exchange_index){\n            if(exchange_index % 2 == 0)\n                swap(equivalence[0], equivalence[exchange_index]);\n            else\n                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\n            if(verifyPermutation(g1, g2, equivalence)){\n                printPermutation(equivalence);\n                isomorphism_found = true;\n            }\n\n            exchange_counter[exchange_index]++;\n            exchange_index = 1;\n        }else{\n            exchange_counter[exchange_index] = 0;\n            exchange_index++;\n        }\n    }\n    return isomorphism_found;\n}\n\nadjacency_matrix readGraph(){\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read(vertices);\n    for (int i = 0; i < vertices; ++i)\n        read[i].resize(vertices);\n\n    cin >> edges;\n    for (int i = 0; i < edges; i++) {\n       cin >> source >> destination;\n       read[destination][source] = read[source][destination] = true;\n    }\n\n    return read;\n}\n\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence){\n    for (int i = 0; i < equivalence.size(); ++i) {\n        for (int j = 0; j <= i; ++j) {\n            if(g1[i][j] != g2[equivalence[i]][equivalence[j]]) return false;\n        }\n    }\n   return true;\n}\n\ninline void printPermutation(vector<int> &equivalence){\n    for (auto i : equivalence)\n        cout << i << \" \";\n    cout << endl;\n}\n\n#ifdef _OPENMP\nstatic bool advanceHeapPermutation(vector<int> &permutation,\n                                   vector<int> &counter, int &index){\n    while(index < static_cast<int>(counter.size())){\n        if(counter[index] < index){\n            if(index % 2 == 0)\n                swap(permutation[0], permutation[index]);\n            else\n                swap(permutation[counter[index]], permutation[index]);\n            ++counter[index];\n            index = 1;\n            return true;\n        }\n        counter[index] = 0;\n        ++index;\n    }\n    return false;\n}\n\nstatic bool verifyHeapBlock(adjacency_matrix &g1, adjacency_matrix &g2,\n                            vector<int> &permutation, vector<int> &counter,\n                            string &output){\n    fill(counter.begin(), counter.end(), 0);\n    output.clear();\n    bool found = false;\n    int index = 1;\n    do{\n        if(verifyPermutation(g1, g2, permutation)){\n            for(int vertex : permutation){\n                output += to_string(vertex);\n                output.push_back(' ');\n            }\n            output.push_back('\\n');\n            found = true;\n        }\n    }while(advanceHeapPermutation(permutation, counter, index));\n    return found;\n}\n\nstatic bool parallelHeapSearch(adjacency_matrix &g1, adjacency_matrix &g2,\n                               const vector<int> &initial){\n    const int thread_count = omp_get_max_threads();\n    const size_t target_blocks = static_cast<size_t>(thread_count) * 8;\n    int block_size = min(7, static_cast<int>(initial.size()) - 1);\n\n    // Saturating counts select the grain without computing a full factorial.\n    size_t block_count = 1;\n    for(size_t width = static_cast<size_t>(block_size) + 1;\n        width <= initial.size() && block_count < target_blocks; ++width){\n        if(block_count > target_blocks / width)\n            block_count = target_blocks;\n        else\n            block_count *= width;\n    }\n    while(block_size > 2 && block_count < target_blocks){\n        if(block_count > target_blocks / static_cast<size_t>(block_size))\n            block_count = target_blocks;\n        else\n            block_count *= static_cast<size_t>(block_size);\n        --block_size;\n    }\n\n    // Record the exact terminal transformation of a prefix Heap traversal.\n    vector<int> terminal(block_size);\n    for(int i = 0; i < block_size; ++i)\n        terminal[i] = i;\n    vector<int> terminal_counter(block_size, 0);\n    int terminal_index = 1;\n    while(advanceHeapPermutation(terminal, terminal_counter, terminal_index)){}\n\n    const int batch_capacity = 4 * min(thread_count, 8);\n    vector<vector<int>> seeds(batch_capacity, vector<int>(initial.size()));\n    vector<string> output(batch_capacity);\n    vector<int> next_seed = initial;\n    vector<int> outer_counter(initial.size(), 0);\n    vector<int> scratch(block_size);\n    int batch_count = 0;\n    bool seed_available = true;\n    bool isomorphism_found = false;\n\n    #pragma omp parallel num_threads(thread_count) reduction(||:isomorphism_found)\n    {\n        vector<int> counter(block_size, 0);\n        for(;;){\n            #pragma omp single\n            {\n                // Drain the preceding batch in Heap order before reusing slots.\n                for(int block = 0; block < batch_count; ++block){\n                    if(!output[block].empty())\n                        cout << output[block];\n                }\n                batch_count = 0;\n                while(batch_count < batch_capacity && seed_available){\n                    seeds[batch_count] = next_seed;\n                    ++batch_count;\n\n                    for(int i = 0; i < block_size; ++i)\n                        scratch[i] = next_seed[terminal[i]];\n                    copy(scratch.begin(), scratch.end(), next_seed.begin());\n                    int index = block_size;\n                    seed_available = advanceHeapPermutation(next_seed, outer_counter, index);\n                }\n            }\n\n            if(batch_count == 0)\n                break;\n\n            #pragma omp for schedule(dynamic, 1)\n            for(int block = 0; block < batch_count; ++block){\n                if(verifyHeapBlock(g1, g2, seeds[block], counter, output[block]))\n                    isomorphism_found = true;\n            }\n        }\n    }\n    return isomorphism_found;\n}\n#endif\n",
        "path": "src/brute_isomorphism.cpp"

    @pytest.mark.parametrize("failure", [None, "timeout", "diagnostic"])
    def test_actual_ARM_wrapper_preserves_gate_and_blocks_following_publish(tmp_path, monkeypatch, failure):
        from hpc_forest import (
            codex_mailbox,
            codex_process,
            codex_worker,
            dynamic_admission,
            native_matrix,
        )
        from hpc_forest.core import digest
        auth = authorization()
        channel = tmp_path / "NEUTRAL-mailbox"
        channel.mkdir()
        auth.update(remote_root=str(tmp_path), canonical_remote_root=str(tmp_path), purpose="technical-contract", technical_phase="roots")
        request = {"model": auth["model"], "reasoning_effort": "max", "session_id": auth["session_id"],
                   "meta_role": "mother-dynamic-roots", "nonce": "b" * 32}
        auth["allowed_request_sha256"] = digest(request)
        monkeypatch.setattr(native_matrix, "validate_receipt", lambda *_a, **_k: auth)
        # Restore every process-local assignment after the test; no process exists.
        for module, names in [(codex_mailbox, ["MODEL", "EFFORT", "publish_request", "wait_response"]),
            (codex_process, ["MODEL", "EFFORT", "check_dependencies"]),
            (codex_worker, ["MODEL", "EFFORT", "check_dependencies", "validate_remote_channel", "validate_request"])]:
            for name in names:
                monkeypatch.setattr(module, name, getattr(module, name))
        def waiting(*_):
            if failure == "timeout":
                raise InfrastructureError("NEUTRAL bounded timeout; no replay")
            return {"infrastructure_error": failure == "diagnostic", "usage": {"token_accounting": "exact"}}
        monkeypatch.setattr(codex_mailbox, "wait_response", waiting)
        receipts = []
        monkeypatch.setattr(codex_mailbox, "publish_request", lambda *_: receipts.append(True) or "c" * 64)
        receipt = tmp_path / "NEUTRAL-auth.json"
        receipt.write_text("{}", encoding="utf8")
        native_matrix.install_identity(auth["model"], "max", receipt)
        expected = tmp_path / "results-900000" / "mailbox"
        expected.mkdir(parents=True)
&gt;       assert codex_mailbox.publish_request(expected, request) == "c" * 64
               ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^


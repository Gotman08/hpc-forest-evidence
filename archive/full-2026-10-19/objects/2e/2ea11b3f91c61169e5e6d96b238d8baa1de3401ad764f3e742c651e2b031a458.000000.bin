"""Record the completed human-readable inspection of this exact PDF pair."""
import hashlib
import json
import shutil
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
STUDY = HERE.parents[1]
EDITORIAL = STUDY / "edition-professionnelle"


def read(path):
    return json.loads(path.read_text(encoding="utf-8-sig"))


def sha(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def save(path, value):
    path.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def main():
    quality_path = EDITORIAL / "controle-qualite.json"
    quality = read(quality_path)
    assert not quality["visual_review_completed"]
    assert not (HERE / "revue-visuelle-verifiee.json").exists()
    assert [(doc["name"], doc["pages"], doc["figures"]) for doc in quality["documents"]] == [
        ("ARTICLE", 17, 7), ("ANNEXES-TECHNIQUES", 259, 224)
    ]
    for document in quality["documents"]:
        assert sha(STUDY / (document["name"] + ".pdf")) == document["pdf_sha256"]
        assert all(not document[key] for key in ["glyph_errors", "outside_page", "blank_pages"])
    assert len(quality["contact_sheets"]) == 47
    risks = read(HERE / "risques.json")
    assert len(risks) == 15
    assert {row["page"] for row in risks if row["document"] == "ARTICLE"} == {1, 3, 7, 10, 14, 15}
    assert {row["page"] for row in risks if row["document"] == "ANNEXES-TECHNIQUES"} == {12, 13, 14, 19, 254, 255, 257, 258, 259}
    # Every sheet and every risk image listed below was emitted to view_image
    # and actually inspected in this heartbeat, before executing this recorder.
    observed = {
        "schema": "hpc-forest-observed-pdf-visual-review-v1",
        "reviewed_utc": datetime.now(UTC).isoformat(),
        "inspection_method": "All 47 contact sheets displayed and inspected; 15 risk pages additionally displayed at their original 2.2x raster resolution.",
        "pages_reviewed": {"ARTICLE": list(range(1, 18)), "ANNEXES-TECHNIQUES": list(range(1, 260))},
        "documents": [{key: doc[key] for key in ["name", "pages", "figures", "pdf_sha256"]} for doc in quality["documents"]],
        "contact_sheets": [{"path": name, "sha256": sha(Path(name))} for name in quality["contact_sheets"]],
        "full_resolution_risk_pages": [{**row, "sha256": sha(Path(row["path"]))} for row in risks],
        "observations": [
            "All pages have legible headings, tables, captions and footer placement without observed overlap or clipping.",
            "New C.7/C.8 cohort tables and F.7/F.8 role accounting remain legible with explicit unknown counters.",
            "Sparse and failed-search forests are preserved; recorded links and retained references are not replaced by conceptual success diagrams.",
            "R4 is explicitly conceptual; R5 and native Codex admissions remain pending.",
            "ID-017/040 in the PDFs preserve the construction snapshot; the live ledger is completed after visual review."
        ],
        "known_visual_defects": [],
        "all_current_page_content_visually_reviewed": True,
    }
    shutil.copy2(quality_path, HERE / "controle-qualite-avant-revue.json")
    save(HERE / "revue-visuelle-observation.json", observed)
    quality.update({
        "visual_review_completed": True,
        "visual_review_completed_utc": observed["reviewed_utc"],
        "visually_reviewed_pages": 276,
        "contact_sheets_reviewed": 47,
        "full_resolution_risk_pages": [Path(row["path"]).name for row in risks],
        "known_visual_defects": [],
        "all_current_page_content_visually_reviewed": True,
        "visual_review_observation": {"path": str(HERE / "revue-visuelle-observation.json"), "sha256": sha(HERE / "revue-visuelle-observation.json")},
    })
    save(quality_path, quality)
    save(HERE / "revue-visuelle-verifiee.json", {
        "verified": True, "verified_utc": datetime.now(UTC).isoformat(),
        "quality_sha256": sha(quality_path),
        "observation_sha256": sha(HERE / "revue-visuelle-observation.json"),
        "pdf_sha256": {doc["name"]: doc["pdf_sha256"] for doc in quality["documents"]},
        "pages_visually_reviewed": 276, "contact_sheets_reviewed": 47,
        "full_resolution_pages_reviewed": 15, "known_visual_defects": [],
    })
    print(json.dumps({"verified": True, "pages": 276, "sheets": 47, "full_resolution": 15}))


if __name__ == "__main__":
    main()

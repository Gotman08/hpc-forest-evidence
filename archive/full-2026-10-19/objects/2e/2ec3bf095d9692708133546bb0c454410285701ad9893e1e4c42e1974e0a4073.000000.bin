#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <algorithm>
#include <limits>
#ifdef _OPENMP
#include <omp.h>
#endif

static long long bandMaximum(const std::vector<std::vector<int> >& matrix,
                             int n, int s, int begin, int end) {
    std::vector<long long> columns(n, 0);
    for (int r = begin; r < begin + s; ++r) {
        const int* row = matrix[r].data();
        for (int c = 0; c < n; ++c)
            columns[c] += row[c];
    }

    long long best = std::numeric_limits<long long>::lowest();
    for (int top = begin; top < end; ++top) {
        long long sum = 0;
        for (int c = 0; c < s; ++c)
            sum += columns[c];
        best = std::max(best, sum);

        for (int c = s; c < n; ++c) {
            sum += columns[c] - columns[c - s];
            best = std::max(best, sum);
        }

        if (top + 1 < end) {
            const int* leaving = matrix[top].data();
            const int* entering = matrix[top + s].data();
            for (int c = 0; c < n; ++c)
                columns[c] += static_cast<long long>(entering[c]) - leaving[c];
        }
    }
    return best;
}

int main() {
    int n, s;
    std::cin >> n >> s;
    std::vector<std::vector<int> > matrix(n, std::vector<int>(n));
    for (int i = 0; i < n; ++i)
        for (int j = 0; j < n; ++j)
            scanf("%d", &(matrix[i][j]));

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    const int windowRows = n - s + 1;
    int bands = 1;
#ifdef _OPENMP
    const int workBands = std::max(1, (n * n) / (256 * 1024));
    bands = std::min(windowRows, std::min(omp_get_max_threads(), workBands));
#endif

    long long mxSum = std::numeric_limits<long long>::lowest();
#pragma omp parallel for schedule(static) num_threads(bands) if(bands > 1) reduction(max:mxSum)
    for (int band = 0; band < bands; ++band) {
        const int begin = windowRows * band / bands;
        const int end = windowRows * (band + 1) / bands;
        const long long localMaximum = bandMaximum(matrix, n, s, begin, end);
        mxSum = std::max(mxSum, localMaximum);
    }

    printf("%lld\n", mxSum);
}

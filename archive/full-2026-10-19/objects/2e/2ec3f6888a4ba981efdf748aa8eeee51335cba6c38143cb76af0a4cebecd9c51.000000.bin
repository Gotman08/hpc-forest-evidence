{
  "src/model-view/primetest.c": "#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n#include <inttypes.h>\n\n#define MAXNUM 1000\n#define MAXSTR 50\n#define MAXRESULTS 1000\n\ntypedef struct {\n    uint32_t value;\n    uint32_t scale;\n} Fragment;\n\nstatic uint32_t firstHalf[MAXNUM];\nstatic Fragment secondHalf[MAXNUM];\nstatic uint32_t result[MAXRESULTS];\n\nstatic int read_fragment(uint32_t *value, uint32_t *scale)\n{\n    char text[MAXSTR];\n    uint32_t number = 0;\n    uint32_t decimal_scale = 1;\n\n    if (scanf(\"%49s\", text) != 1)\n        return 0;\n    for (const char *p = text; *p; ++p) {\n        unsigned int digit = (unsigned int)(*p - '0');\n        if (digit > 9u || number > (UINT32_MAX - digit) / 10u)\n            return 0;\n        number = number * 10u + digit;\n        if (scale != NULL) {\n            if (decimal_scale > UINT32_MAX / 10u)\n                return 0;\n            decimal_scale *= 10u;\n        }\n    }\n    *value = number;\n    if (scale != NULL)\n        *scale = decimal_scale;\n    return 1;\n}\n\nstatic uint32_t integer_sqrt(uint32_t value)\n{\n    uint32_t root = 0;\n    for (uint32_t bit = 1u << 15; bit != 0; bit >>= 1) {\n        uint32_t trial = root | bit;\n        if ((uint64_t)trial * trial <= value)\n            root = trial;\n    }\n    return root;\n}\n\nstatic uint16_t *build_divisors(uint32_t limit, size_t *count)\n{\n    size_t slots = (size_t)(limit / 2u) + 1u;\n    unsigned char *composite = calloc(slots, sizeof *composite);\n    uint16_t *divisors = malloc(slots * sizeof *divisors);\n\n    *count = 0;\n    if (composite == NULL || divisors == NULL) {\n        free(composite);\n        free(divisors);\n        return NULL;\n    }\n    for (uint32_t factor = 3; (uint64_t)factor * factor <= limit; factor += 2) {\n        if (!composite[factor / 2u]) {\n            for (uint32_t multiple = factor * factor;\n                 multiple <= limit; multiple += 2u * factor)\n                composite[multiple / 2u] = 1;\n        }\n    }\n    for (uint32_t factor = 3; factor <= limit; factor += 2) {\n        if (!composite[factor / 2u])\n            divisors[(*count)++] = (uint16_t)factor;\n    }\n    free(composite);\n    return divisors;\n}\n\nstatic int isprime(uint32_t value, const uint16_t *divisors, size_t count)\n{\n    if (value < 2)\n        return 0;\n    if ((value & 1u) == 0)\n        return value == 2;\n    for (size_t i = 0; i < count; ++i) {\n        uint32_t factor = divisors[i];\n        if ((uint64_t)factor * factor > value)\n            break;\n        if (value % factor == 0)\n            return 0;\n    }\n    return 1;\n}\n\nstatic void quicksort(uint32_t *primes, int first, int last)\n{\n    int i, j, pivot;\n    uint32_t temp;\n\n    if (first < last) {\n        pivot = first;\n        i = first;\n        j = last;\n        while (i < j) {\n            while (primes[i] <= primes[pivot] && i < last)\n                i++;\n            while (primes[j] > primes[pivot])\n                j--;\n            if (i < j) {\n                temp = primes[i];\n                primes[i] = primes[j];\n                primes[j] = temp;\n            }\n        }\n        temp = primes[pivot];\n        primes[pivot] = primes[j];\n        primes[j] = temp;\n        quicksort(primes, first, j - 1);\n        quicksort(primes, j + 1, last);\n    }\n}\n\nint main(void)\n{\n    int numPrimes = 0;\n    int numResults = 0;\n    uint32_t maximum_left = 0;\n    uint32_t maximum = 0;\n    size_t divisor_count = 0;\n\n    if (scanf(\"%d\", &numPrimes) != 1 || numPrimes < 1 || numPrimes > MAXNUM)\n        return 0;\n    for (int i = 0; i < numPrimes; ++i) {\n        if (!read_fragment(&firstHalf[i], NULL))\n            return 0;\n        if (firstHalf[i] > maximum_left)\n            maximum_left = firstHalf[i];\n    }\n    for (int j = 0; j < numPrimes; ++j) {\n        if (!read_fragment(&secondHalf[j].value, &secondHalf[j].scale))\n            return 0;\n        uint64_t joined = (uint64_t)maximum_left * secondHalf[j].scale\n                        + secondHalf[j].value;\n        if (joined > UINT32_MAX)\n            return 1;\n        if (joined > maximum)\n            maximum = (uint32_t)joined;\n    }\n\n    uint16_t *divisors = build_divisors(integer_sqrt(maximum), &divisor_count);\n    if (divisors == NULL)\n        return 1;\n\n    for (int i = 0; i < numPrimes; ++i) {\n        uint32_t left = firstHalf[i];\n        for (int j = 0; j < numPrimes; ++j) {\n            uint32_t candidate = left * secondHalf[j].scale + secondHalf[j].value;\n            if (isprime(candidate, divisors, divisor_count)) {\n                if (numResults == MAXRESULTS) {\n                    free(divisors);\n                    return 1;\n                }\n                result[numResults++] = candidate;\n            }\n        }\n    }\n    free(divisors);\n\n    quicksort(result, 0, numResults - 1);\n    for (int i = 0; i < numResults; ++i)\n        printf(\"%\" PRIu32 \"\\n\", result[i]);\n    return 0;\n}\n",
  "src/sources/primetest.c": "#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n#include <inttypes.h>\n\n#define MAXNUM 1000\n#define MAXSTR 50\n#define MAXRESULTS 1000\n\ntypedef struct {\n    uint32_t value;\n    uint32_t scale;\n} Fragment;\n\nstatic uint32_t firstHalf[MAXNUM];\nstatic Fragment secondHalf[MAXNUM];\nstatic uint32_t result[MAXRESULTS];\n\nstatic int read_fragment(uint32_t *value, uint32_t *scale)\n{\n    char text[MAXSTR];\n    uint32_t number = 0;\n    uint32_t decimal_scale = 1;\n\n    if (scanf(\"%49s\", text) != 1)\n        return 0;\n    for (const char *p = text; *p; ++p) {\n        unsigned int digit = (unsigned int)(*p - '0');\n        if (digit > 9u || number > (UINT32_MAX - digit) / 10u)\n            return 0;\n        number = number * 10u + digit;\n        if (scale != NULL) {\n            if (decimal_scale > UINT32_MAX / 10u)\n                return 0;\n            decimal_scale *= 10u;\n        }\n    }\n    *value = number;\n    if (scale != NULL)\n        *scale = decimal_scale;\n    return 1;\n}\n\nstatic uint32_t integer_sqrt(uint32_t value)\n{\n    uint32_t root = 0;\n    for (uint32_t bit = 1u << 15; bit != 0; bit >>= 1) {\n        uint32_t trial = root | bit;\n        if ((uint64_t)trial * trial <= value)\n            root = trial;\n    }\n    return root;\n}\n\nstatic uint16_t *build_divisors(uint32_t limit, size_t *count)\n{\n    size_t slots = (size_t)(limit / 2u) + 1u;\n    unsigned char *composite = calloc(slots, sizeof *composite);\n    uint16_t *divisors = malloc(slots * sizeof *divisors);\n\n    *count = 0;\n    if (composite == NULL || divisors == NULL) {\n        free(composite);\n        free(divisors);\n        return NULL;\n    }\n    for (uint32_t factor = 3; (uint64_t)factor * factor <= limit; factor += 2) {\n        if (!composite[factor / 2u]) {\n            for (uint32_t multiple = factor * factor;\n                 multiple <= limit; multiple += 2u * factor)\n                composite[multiple / 2u] = 1;\n        }\n    }\n    for (uint32_t factor = 3; factor <= limit; factor += 2) {\n        if (!composite[factor / 2u])\n            divisors[(*count)++] = (uint16_t)factor;\n    }\n    free(composite);\n    return divisors;\n}\n\nstatic int isprime(uint32_t value, const uint16_t *divisors, size_t count)\n{\n    if (value < 2)\n        return 0;\n    if ((value & 1u) == 0)\n        return value == 2;\n    for (size_t i = 0; i < count; ++i) {\n        uint32_t factor = divisors[i];\n        if ((uint64_t)factor * factor > value)\n            break;\n        if (value % factor == 0)\n            return 0;\n    }\n    return 1;\n}\n\nstatic void quicksort(uint32_t *primes, int first, int last)\n{\n    int i, j, pivot;\n    uint32_t temp;\n\n    if (first < last) {\n        pivot = first;\n        i = first;\n        j = last;\n        while (i < j) {\n            while (primes[i] <= primes[pivot] && i < last)\n                i++;\n            while (primes[j] > primes[pivot])\n                j--;\n            if (i < j) {\n                temp = primes[i];\n                primes[i] = primes[j];\n                primes[j] = temp;\n            }\n        }\n        temp = primes[pivot];\n        primes[pivot] = primes[j];\n        primes[j] = temp;\n        quicksort(primes, first, j - 1);\n        quicksort(primes, j + 1, last);\n    }\n}\n\nint main(void)\n{\n    int numPrimes = 0;\n    int numResults = 0;\n    uint32_t maximum_left = 0;\n    uint32_t maximum = 0;\n    size_t divisor_count = 0;\n\n    if (scanf(\"%d\", &numPrimes) != 1 || numPrimes < 1 || numPrimes > MAXNUM)\n        return 0;\n    for (int i = 0; i < numPrimes; ++i) {\n        if (!read_fragment(&firstHalf[i], NULL))\n            return 0;\n        if (firstHalf[i] > maximum_left)\n            maximum_left = firstHalf[i];\n    }\n    for (int j = 0; j < numPrimes; ++j) {\n        if (!read_fragment(&secondHalf[j].value, &secondHalf[j].scale))\n            return 0;\n        uint64_t joined = (uint64_t)maximum_left * secondHalf[j].scale\n                        + secondHalf[j].value;\n        if (joined > UINT32_MAX)\n            return 1;\n        if (joined > maximum)\n            maximum = (uint32_t)joined;\n    }\n\n    uint16_t *divisors = build_divisors(integer_sqrt(maximum), &divisor_count);\n    if (divisors == NULL)\n        return 1;\n\n    for (int i = 0; i < numPrimes; ++i) {\n        uint32_t left = firstHalf[i];\n        for (int j = 0; j < numPrimes; ++j) {\n            uint32_t candidate = left * secondHalf[j].scale + secondHalf[j].value;\n            if (isprime(candidate, divisors, divisor_count)) {\n                if (numResults == MAXRESULTS) {\n                    free(divisors);\n                    return 1;\n                }\n                result[numResults++] = candidate;\n            }\n        }\n    }\n    free(divisors);\n\n    quicksort(result, 0, numResults - 1);\n    for (int i = 0; i < numResults; ++i)\n        printf(\"%\" PRIu32 \"\\n\", result[i]);\n    return 0;\n}\n"
}

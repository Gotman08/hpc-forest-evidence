#include "knn.h"

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    char * labels = (char *) malloc(sizeof(char) * k);
    float * distances = (float *) malloc(sizeof(float) * k);

    int i, j, x, y;
    int populated = 0;
    int ordered = 1;

    for (i = 0; i < k; i++) {
        labels[i] = -1;
        distances[i] = -1;
    }

    for (i = 0; i < n_groups; i++) {
        Group g = groups[i];

        for (j = 0; j < g.length; j++) {
            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);

            /* A full, NaN-free list cannot admit a point at this cutoff. */
            if (ordered && populated == k && populated > 0 &&
                !(d < distances[populated - 1])) {
                continue;
            }

            if (ordered) {
                /*
                 * In a sorted, NaN-free prefix, failed comparisons precede
                 * successful ones. Their count is the stable insertion
                 * position. A NaN candidate fails every comparison and
                 * therefore still selects the first unoccupied slot.
                 */
                x = 0;
#if defined(_OPENMP)
#pragma omp simd reduction(+:x)
#endif
                for (int index = 0; index < populated; index++) {
                    x += !(d < distances[index]);
                }
            } else {
                /* Stored NaNs require the original first-match search. */
                x = populated;
#if defined(_OPENMP)
#pragma omp simd reduction(min:x)
#endif
                for (int index = 0; index < populated; index++) {
                    int candidate = d < distances[index] ? index : populated;
                    x = candidate < x ? candidate : x;
                }
            }

            if (x < k) {
                /* Copy backward only through occupied entries. */
                int last = populated < k ? populated : k - 1;
                for (y = last; y > x; y--) {
                    distances[y] = distances[y - 1];
                    labels[y] = labels[y - 1];
                }

                distances[x] = d;
                labels[x] = g.label;

                if (populated < k) {
                    populated++;
                }

                /* Keep exact first-match behavior after storing a NaN. */
                if (d != d) {
                    ordered = 0;
                }
            }
        }
    }

    qsort(labels, k, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }

            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    free(distances);
    free(labels);
    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <omp.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Compute the gravitational impact among all pairs of bodies in \n * the system.\n * Uses Structure-of-Arrays layout for better cache locality and vectorization.\n */\nvoid body_force(float *restrict px, float *restrict py, float *restrict pz,\n                float *restrict vx, float *restrict vy, float *restrict vz,\n                float dt, int n) {\n  #pragma omp parallel for schedule(static)\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    const float xi = px[i];\n    const float yi = py[i];\n    const float zi = pz[i];\n\n    #pragma omp simd reduction(+:fx,fy,fz) aligned(px,py,pz:64)\n    for (int j = 0; j < n; ++j) {\n      float dx = px[j] - xi;\n      float dy = py[j] - yi;\n      float dz = pz[j] - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1.0f / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    vx[i] += dt*fx;\n    vy[i] += dt*fy;\n    vz[i] += dt*fz;\n  }\n}\n\n/*\n * Read a binary dataset with initialized bodies.\n */\nvoid read_dataset(float **restrict x, float **restrict y, float **restrict z,\n                  float **restrict vx, float **restrict vy, float **restrict vz,\n                  int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  const int n = *nbodies;\n  size_t alignment = 64;\n  if (posix_memalign((void**)x, alignment, n * sizeof(float)) != 0) {\n    fprintf(stderr,\"\\nError allocating x array\\n\");\n    exit(EXIT_FAILURE);\n  }\n  if (posix_memalign((void**)y, alignment, n * sizeof(float)) != 0) {\n    fprintf(stderr,\"\\nError allocating y array\\n\");\n    exit(EXIT_FAILURE);\n  }\n  if (posix_memalign((void**)z, alignment, n * sizeof(float)) != 0) {\n    fprintf(stderr,\"\\nError allocating z array\\n\");\n    exit(EXIT_FAILURE);\n  }\n  if (posix_memalign((void**)vx, alignment, n * sizeof(float)) != 0) {\n    fprintf(stderr,\"\\nError allocating vx array\\n\");\n    exit(EXIT_FAILURE);\n  }\n  if (posix_memalign((void**)vy, alignment, n * sizeof(float)) != 0) {\n    fprintf(stderr,\"\\nError allocating vy array\\n\");\n    exit(EXIT_FAILURE);\n  }\n  if (posix_memalign((void**)vz, alignment, n * sizeof(float)) != 0) {\n    fprintf(stderr,\"\\nError allocating vz array\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  float *tmp = (float*)malloc(n * 6 * sizeof(float));\n  if (!tmp) {\n    fprintf(stderr,\"\\nError allocating tmp buffer\\n\");\n    exit(EXIT_FAILURE);\n  }\n  b = fread(tmp, n * 6 * sizeof(float), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    free(tmp);\n    exit(EXIT_FAILURE);\n  }\n\n  for (int i = 0; i < n; ++i) {\n    (*x)[i] = tmp[i*6 + 0];\n    (*y)[i] = tmp[i*6 + 1];\n    (*z)[i] = tmp[i*6 + 2];\n    (*vx)[i] = tmp[i*6 + 3];\n    (*vy)[i] = tmp[i*6 + 4];\n    (*vz)[i] = tmp[i*6 + 5];\n  }\n\n  free(tmp);\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies,\n                   const float *restrict x, const float *restrict y, const float *restrict z,\n                   const float *restrict vx, const float *restrict vy, const float *restrict vz) {\n  size_t n = (size_t)nbodies;\n  float *tmp = (float*)malloc(n * 6 * sizeof(float));\n  if (!tmp) {\n    fprintf(stderr,\"\\nError allocating tmp buffer for output\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  for (size_t i = 0; i < n; ++i) {\n    tmp[i*6 + 0] = x[i];\n    tmp[i*6 + 1] = y[i];\n    tmp[i*6 + 2] = z[i];\n    tmp[i*6 + 3] = vx[i];\n    tmp[i*6 + 4] = vy[i];\n    tmp[i*6 + 5] = vz[i];\n  }\n\n  int b = fwrite(tmp, n * 6 * sizeof(float), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    free(tmp);\n    exit(EXIT_FAILURE);\n  }\n\n  free(tmp);\n}\n\nint main(int argc, char **argv) {\n  int nbodies;\n  float *x = NULL, *y = NULL, *z = NULL;\n  float *vx = NULL, *vy = NULL, *vz = NULL;\n\n  read_dataset(&x, &y, &z, &vx, &vy, &vz, &nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    body_force(x, y, z, vx, vy, vz, DT, nbodies);\n\n    #pragma omp parallel for schedule(static)\n    for (int i = 0; i < nbodies; ++i) {\n      x[i] += vx[i] * DT;\n      y[i] += vy[i] * DT;\n      z[i] += vz[i] * DT;\n    }\n  }\n\n  write_dataset(nbodies, x, y, z, vx, vy, vz);\n\n  free(x); free(y); free(z);\n  free(vx); free(vy); free(vz);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Integrating SoA layout with 64-byte aligned allocation, restrict qualifiers on all pointer parameters (from A), explicit SIMD reduction pragma on the inner force loop (from B), OpenMP parallel for schedule(static) on both outer loops (force and position update, from A/B), plus scatter/gather I/O will combine memory locality, vectorization, thread-level parallelism, and reduced scheduling overhead to achieve further speedup beyond any individual transformation.",
  "notes": "Combines the best elements of all three source experiments: SoA layout with alignment from A, SIMD reduction from B, OpenMP parallelization from both A/B (static schedule) while discarding dynamic schedule from C which was slower. The dt parameter is kept as in original and A for generality.",

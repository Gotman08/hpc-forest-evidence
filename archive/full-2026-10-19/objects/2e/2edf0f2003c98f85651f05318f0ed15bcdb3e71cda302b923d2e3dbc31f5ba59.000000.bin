"""Build real hashed launch input after three actual ready receipts; no process or transport."""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path

HERE=Path(__file__).resolve().parent
BASE=HERE.parents[2]
FACTORY=HERE.parent/'revision-r3-attempt2'
OPS=BASE/'outputs/HPC-Forest-Primes-Natif-Relance-r2d/operations-parent-attempt2'
MODELS={'gpt-6-astra':'astra-max','gpt-5.6-terra':'terra-max','gpt-6.1-sol':'sol-max'}


def ref(path):
    path=path.resolve()
    if not path.is_file() or path.is_symlink():raise ValueError('Actual ordinary evidence file required')
    return {'path':str(path),'sha256':hashlib.sha256(path.read_bytes()).hexdigest()}


def build(readbacks):
    return {'schema':'hpc-forest-r2d-attempt2-owned-worker-launch-input-v1',
        'source_bindings':ref(FACTORY/'liaison-Q752606-reutilisee/source-bindings-reels-Q.json'),
        'factory_review':ref(BASE/'outputs/HPC-Forest-Primes-Natif-Relance-r2d/revue-attempt2/REVUE-INDEPENDANTE-ATTEMPT2.json'),
        'prior_zero_native_reception':ref(OPS/'RECEPTION-TROIS-PREFLIGHTS-ZERO-MODELE.json'),
        'publication_readbacks':ref(readbacks),
        'ready_upload_results':{model:ref(OPS/slug/'ready-upload-result.json') for model,slug in MODELS.items()},
        'worker_argv':{model:ref(FACTORY/('admissions-attempt2-'+slug+'-reelles')/'worker-argv-only.json') for model,slug in MODELS.items()}}


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--readbacks',type=Path,required=True)
    parser.add_argument('--output-name',required=True)
    args=parser.parse_args()
    if not args.output_name.isidentifier():raise ValueError('Simple new output name required')
    value=build(args.readbacks)
    output=HERE/(args.output_name+'.json')
    with output.open('x',encoding='utf8') as stream:json.dump(value,stream,indent=2)
    print(json.dumps({'input':ref(output),'processes_started':0,'native_calls':0}))
    return 0


if __name__=='__main__':raise SystemExit(main())

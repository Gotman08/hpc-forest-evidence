        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n/* Maximum size (in char) for neighbors and compute lists */\n#define MAX 100\n\ntypedef struct {\n  int id;\n  float value;\n  char neighbors[MAX];\n} Node;\n\n/* Reads input, allocates memory, writes graph size and node list. Returns the graph. */\nNode* read_input(char* fname, int *n, char* list) {\n  Node* data = NULL;\n  FILE *fl = NULL;\n\n  if (fname == NULL)\n    fl = stdin;\n  else\n    fl = fopen(fname, \"r\");\n\n  if (fl == NULL) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n\n  /* Keep scansets on their input line and leave room for the terminator. */\n  list[0] = '\\0';\n  fscanf(fl, \"%d%99[^\\n]\", n, list);\n\n  if (*n > 0) {\n    data = (Node*) malloc((*n) * sizeof(Node));\n    if (data == NULL) {\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }\n  }\n\n  for (int i = 0; i < *n; i++) {\n    data[i].neighbors[0] = '\\0';\n    fscanf(fl, \"%d %f%99[^\\n]\", &data[i].id, &data[i].value,\n           data[i].neighbors);\n  }\n\n  if (fl != stdin)\n    fclose(fl);\n\n  return data;\n}\n\n/* Returns the index of the first node with the given id or -1 if not found. */\nint find_by_id(const int ids[], int id, int size) {\n  int first = size;\n\n  /* Each iteration is independent; min preserves the original first-match rule. */\n  #pragma omp simd reduction(min:first)\n  for (int i = 0; i < size; i++) {\n    int candidate = ids[i] == id ? i : size;\n    first = candidate < first ? candidate : first;\n  }\n\n  if (first < size)\n    return first;\n\n  return -1;\n}\n\n/* Computes the sum for the node with the given id. */\nfloat get_costly(Node *g, const int ids[], int id, int size) {\n  int idmax = -1;\n  float max = 0;\n  char *auxptr;\n\n  int nd = find_by_id(ids, id, size);\n  if (nd < 0)\n    return max;\n\n  char aux[MAX];\n  strcpy(aux, g[nd].neighbors);\n  char *t = strtok_r(aux, \" \", &auxptr);\n\n  while (t != NULL) {\n    int neighbor_id = atoi(t);\n    int d = find_by_id(ids, neighbor_id, size);\n    if (d >= 0 && max < g[d].value) {\n      max = g[d].value;\n      idmax = neighbor_id;\n    }\n    t = strtok_r(NULL, \" \", &auxptr);\n  }\n\n  float r = g[nd].value;\n\n  if (idmax != -1)\n    r += get_costly(g, ids, idmax, size);\n\n  return r;\n}\n\n/* Main program - calls read input, computes sum for each node in the list, prints output. */\nint main(void) {\n  char *fileN = NULL;\n  char computelist[MAX];\n  int n = -1;\n  Node* input = NULL;\n\n  input = read_input(fileN, &n, computelist);\n\n  /* A packed ID array makes the lookup scan contiguous and vectorizable. */\n  int *ids = NULL;\n  if (input != NULL) {\n    ids = (int*) malloc(n * sizeof(*ids));\n    if (ids == NULL) {\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }\n    for (int i = 0; i < n; i++)\n      ids[i] = input[i].id;\n  }\n\n  for (char *c = strtok(computelist, \" \"); c != NULL; c = strtok(NULL, \" \"))\n    printf(\"%s: %f\\n\", c, get_costly(input, ids, atoi(c), n));\n\n  free(ids);\n  free(input);\n\n  return 0;\n}\n",
        "path": "src/graph.c"
      }
    ],
    "hypothesis": "An explicit OpenMP SIMD minimum reduction may vectorize the contiguous ID scan in find_by_id. The reduction returns the lowest matching index, preserving first-match behavior while exposing the loop's independent iterations to the compiler.",

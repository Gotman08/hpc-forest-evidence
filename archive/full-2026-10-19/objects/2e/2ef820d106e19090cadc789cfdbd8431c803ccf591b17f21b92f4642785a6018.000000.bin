  "events": [
    {
      "id": 1,
      "kind": "workspace_created",
      "payload": "{\"base_commit\":\"e3b4594a69e8b0bd1eaec0a4cebcc7f47ee18467\",\"protocol_id\":\"b04f6fbeac49643ef717ea0634ab18bc4a5c1d4095da78373bdaa4b6dc4438f8\"}",

    {
      "id": 2,
      "kind": "archive_protocol_identity",
      "payload": "{\"comparison_arm\":\"source-only\",\"effort\":\"max\",\"internal_harness_enabled\":false,\"model\":\"gpt-6.1-sol\",\"mother_enabled\":true,\"operator_algorithm_advice\":false,\"shared_preparation_sha256\":\"9e9d303f6a1ba154a9bc2c255ecaeaf726345ae90e73c7d89df6bd97527c8be2\"}",

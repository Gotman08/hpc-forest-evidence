        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\ntypedef struct { float x, y, z; } Position;\n\n/* Original traversal for the remainder and allocation fallback. */\nstatic void body_force_scalar_range(Body *p, float dt, int n, int begin) {\n  for (int i = begin; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Stream compact positions through four independent target accumulators.\n * Every target still accumulates sources in ascending j order.\n */\nvoid body_force(Body *p, float dt, int n) {\n  if (n < 4) {\n    body_force_scalar_range(p, dt, n, 0);\n    return;\n  }\n\n  Position *positions = (Position *)malloc((size_t)n * sizeof(*positions));\n  if (positions == NULL) {\n    body_force_scalar_range(p, dt, n, 0);\n    return;\n  }\n\n  for (int i = 0; i < n; ++i) {\n    positions[i].x = p[i].x;\n    positions[i].y = p[i].y;\n    positions[i].z = p[i].z;\n  }\n\n  int i = 0;\n  for (; n - i >= 4; i += 4) {\n    const float x0 = positions[i].x;\n    const float y0 = positions[i].y;\n    const float z0 = positions[i].z;\n    const float x1 = positions[i + 1].x;\n    const float y1 = positions[i + 1].y;\n    const float z1 = positions[i + 1].z;\n    const float x2 = positions[i + 2].x;\n    const float y2 = positions[i + 2].y;\n    const float z2 = positions[i + 2].z;\n    const float x3 = positions[i + 3].x;\n    const float y3 = positions[i + 3].y;\n    const float z3 = positions[i + 3].z;\n\n    float fx0 = 0.0f, fy0 = 0.0f, fz0 = 0.0f;\n    float fx1 = 0.0f, fy1 = 0.0f, fz1 = 0.0f;\n    float fx2 = 0.0f, fy2 = 0.0f, fz2 = 0.0f;\n    float fx3 = 0.0f, fy3 = 0.0f, fz3 = 0.0f;\n\n    for (int j = 0; j < n; ++j) {\n      const float sx = positions[j].x;\n      const float sy = positions[j].y;\n      const float sz = positions[j].z;\n\n      float dx0 = sx - x0;\n      float dy0 = sy - y0;\n      float dz0 = sz - z0;\n      float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\n      float inv_dist0 = 1 / sqrt(sqrd_dist0);\n      float inv_dist3_0 = inv_dist0 * inv_dist0 * inv_dist0;\n      fx0 += dx0 * inv_dist3_0;\n      fy0 += dy0 * inv_dist3_0;\n      fz0 += dz0 * inv_dist3_0;\n\n      float dx1 = sx - x1;\n      float dy1 = sy - y1;\n      float dz1 = sz - z1;\n      float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\n      float inv_dist1 = 1 / sqrt(sqrd_dist1);\n      float inv_dist3_1 = inv_dist1 * inv_dist1 * inv_dist1;\n      fx1 += dx1 * inv_dist3_1;\n      fy1 += dy1 * inv_dist3_1;\n      fz1 += dz1 * inv_dist3_1;\n\n      float dx2 = sx - x2;\n      float dy2 = sy - y2;\n      float dz2 = sz - z2;\n      float sqrd_dist2 = dx2*dx2 + dy2*dy2 + dz2*dz2 + SOFTENING;\n      float inv_dist2 = 1 / sqrt(sqrd_dist2);\n      float inv_dist3_2 = inv_dist2 * inv_dist2 * inv_dist2;\n      fx2 += dx2 * inv_dist3_2;\n      fy2 += dy2 * inv_dist3_2;\n      fz2 += dz2 * inv_dist3_2;\n\n      float dx3 = sx - x3;\n      float dy3 = sy - y3;\n      float dz3 = sz - z3;\n      float sqrd_dist3 = dx3*dx3 + dy3*dy3 + dz3*dz3 + SOFTENING;\n      float inv_dist3 = 1 / sqrt(sqrd_dist3);\n      float inv_dist3_3 = inv_dist3 * inv_dist3 * inv_dist3;\n      fx3 += dx3 * inv_dist3_3;\n      fy3 += dy3 * inv_dist3_3;\n      fz3 += dz3 * inv_dist3_3;\n    }\n\n    p[i].vx += dt*fx0;\n    p[i].vy += dt*fy0;\n    p[i].vz += dt*fz0;\n    p[i + 1].vx += dt*fx1;\n    p[i + 1].vy += dt*fy1;\n    p[i + 1].vz += dt*fz1;\n    p[i + 2].vx += dt*fx2;\n    p[i + 2].vy += dt*fy2;\n    p[i + 2].vz += dt*fz2;\n    p[i + 3].vx += dt*fx3;\n    p[i + 3].vy += dt*fy3;\n    p[i + 3].vz += dt*fz3;\n  }\n\n  free(positions);\n  body_force_scalar_range(p, dt, n, i);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
        "path": "src/nbody.c"
      }

        "script": "#!/usr/bin/env bash\n# Genere par romeo-mcp - ne pas editer a la main.\n#SBATCH --job-name=forest-lane-q752546-delivery-only\n#SBATCH --account=r250127\n#SBATCH --qos=normal\n#SBATCH --partition=instant\n#SBATCH --constraint=armgpu\n#SBATCH --time=00:03:00\n#SBATCH --nodes=1\n#SBATCH --ntasks-per-node=1\n#SBATCH --cpus-per-task=4\n#SBATCH --mem=16G\n#SBATCH --chdir=/scratch_p/nimarano\n#SBATCH --output=/scratch_p/nimarano/%x-%j.out\n#SBATCH --error=/scratch_p/nimarano/%x-%j.err\n\nset -euo pipefail\n\n# Sans cette fonction, un job ROMEO 2025 n'a acces a aucun logiciel,\n# pas meme a la commande spack. Elle est propre a l'architecture :\n# charger celle de l'autre donnerait des binaires inutilisables.\nromeo_load_armgpu_env\n\n# Provenance du premier demarrage : environnement, commit et fichiers choisis.\nif command -v python3 >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then\n  if timeout 20s python3 -I -S - '{\"roots\": [\"/scratch_p/nimarano\", \"/project\"], \"include_home\": true, \"code_dir\": \"/scratch_p/nimarano\", \"data_files\": [], \"max_bytes\": 67108864}' <<'ROMEO_REPRO_CAPTURE'\n\nimport hashlib, json, os, pathlib, re, stat, subprocess, sys\nparams = json.loads(sys.argv[1])\nroots = [pathlib.Path(p).resolve() for p in params['roots']]\nif params.get('include_home'):\n    roots.append(pathlib.Path.home().resolve())\ndef allowed(value):\n    path = pathlib.Path(value).resolve()\n    if not any(path == root or root in path.parents for root in roots):\n        raise ValueError('outside_roots')\n    if any(p.lower().startswith(('.env', 'id_rsa', 'id_ed25519', 'id_ecdsa')) or p.lower() in ('.ssh', '.aws', '.azure', '.kube', 'hosts.yml')\n           or p.lower().endswith(('.pem', '.key', '.p12', '.pfx'))\n           or re.search(r'password|passwd|passphrase|secret|token|credential|authorization|cookie|api[_-]?key|access[_-]?key|private[_-]?key', p, re.I)\n           for p in path.parts):\n        raise ValueError('sensitive_path')\n    return path\nout = {'git': {'status': 'unavailable'}, 'data': []}\ntry:\n    code = allowed(params['code_dir'])\n    result = subprocess.run(['git', '-c', 'core.fsmonitor=false', '-C', str(code),\n                             'rev-parse', '--verify', 'HEAD'],\n                            capture_output=True, text=True, timeout=5,\n                            env={**os.environ, 'GIT_OPTIONAL_LOCKS': '0'})\n    sha = result.stdout.strip()\n    if result.returncode == 0 and len(sha) in (40, 64) and all(c in '0123456789abcdef' for c in sha):\n        out['git'] = {'status': 'observed', 'commit': sha, 'working_tree_verified': False}\nexcept (OSError, ValueError, subprocess.TimeoutExpired):\n    pass\nremaining = params['max_bytes']\nfor name in params['data_files']:\n    item = {'path': name}\n    try:\n        path = allowed(name)\n        info = path.stat()\n        if not stat.S_ISREG(info.st_mode):\n            item['status'] = 'not_regular_file'\n        elif info.st_size > remaining:\n            item.update(status='size_limit', bytes=info.st_size)\n        else:\n            h = hashlib.sha256()\n            consumed = 0\n            with path.open('rb') as stream:\n                while True:\n                    block = stream.read(min(1048576, remaining - consumed + 1))\n                    if not block:\n                        break\n                    consumed += len(block)\n                    if consumed > remaining:\n                        break\n                    h.update(block)\n            after = path.stat()\n            remaining = max(0, remaining - consumed)\n            if consumed != info.st_size or (info.st_size, info.st_mtime_ns, info.st_ino) != (after.st_size, after.st_mtime_ns, after.st_ino):\n                item['status'] = 'changed_during_read'\n            else:\n                item.update(status='hashed', sha256=h.hexdigest(), bytes=consumed)\n    except (OSError, ValueError):\n        item['status'] = 'unreadable_or_outside_roots'\n    out['data'].append(item)\n\n\nimport datetime, platform\nout['observed_at'] = datetime.datetime.now(datetime.timezone.utc).isoformat()\nout['phase'] = 'before_workload'\nout['environment'] = {\n    'source': 'compute_node_before_command', 'architecture': platform.machine(),\n    'python_version': platform.python_version(),\n    'loaded_modules': [v for v in os.environ.get('LOADEDMODULES', '').split(':') if v][:128],\n    'spack_loaded_hashes': [v for v in os.environ.get('SPACK_LOADED_HASHES', '').split(':') if v][:128],\n}\njid = os.environ.get('SLURM_JOB_ID', '')\nif os.environ.get('SLURM_ARRAY_JOB_ID') and os.environ.get('SLURM_ARRAY_TASK_ID'):\n    jid = os.environ['SLURM_ARRAY_JOB_ID'] + '_' + os.environ['SLURM_ARRAY_TASK_ID']\nif not re.fullmatch(r'[0-9]+(?:_[0-9]+)?', jid):\n    raise ValueError('missing_job_id')\nout['job_id'] = jid\nfolder = pathlib.Path('.romeo-provenance')\nfolder.mkdir(mode=0o700, exist_ok=True)\nif folder.is_symlink():\n    raise ValueError('symlink_capture_directory')\nout['restart_count'] = os.environ.get('SLURM_RESTART_COUNT', '0')\ntry:\n    fd = os.open(folder / (jid + '.json'), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)\nexcept FileExistsError:\n    pass\nelse:\n    with os.fdopen(fd, 'w') as stream:\n        json.dump(out, stream)\n        stream.write('\\n')\nROMEO_REPRO_CAPTURE\n  then :; else\n    printf '%s\\n' '[romeo-mcp] provenance indisponible ; le calcul continue.' >&2\n  fi\nfi\n\n\n# Trace d'execution : sert a diagnostiquer les erreurs d'architecture.\necho \"[romeo-mcp] noeud=$(hostname) arch=$(uname -m) job=${SLURM_JOB_ID:-?}\"\necho \"[romeo-mcp] debut $(date -Is)\"\n\nset -euo pipefail\n[[ ${SLURM_JOB_ID:-} =~ ^[0-9]+$ ]]\ntest \"${SLURM_JOB_ID}\" != 752546\ntest \"$(uname -m)\" = aarch64\ntest \"${SLURM_CPUS_PER_TASK:-}\" = 4\ntest \"${SLURM_NTASKS:-}\" = 1\ntest \"${SLURM_JOB_NUM_NODES:-}\" = 1\ntest \"${SLURM_MEM_PER_NODE:-}\" = 16384\ntest -z \"${SLURM_JOB_GPUS:-}${SLURM_STEP_GPUS:-}\"\ntest \"${SLURM_GPUS:-0}\" = 0\ntest \"${SLURM_GPUS_ON_NODE:-0}\" = 0\ntest \"$(( $(date -u +%s) + 180 + 10800 ))\" -lt 1793487600\npy=/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python\npacket=/scratch_p/nimarano/hpc-forest-lane-r2-delivery-only-752546-20261018-r1-849b54f1d9f9.tar.gz\nroot=/scratch_p/nimarano/hpc-forest-lane-r2-delivery-only-752546-20261018-r1-849b54f1d9f9\ntest -x \"$py\"\ntest ! -e \"$root\"\nprintf '%s  %s\\n' ca1f4fb3b9ceaf970dd909920c1f9c740d8cf26d332a8a6a97b4931c61311188 \"$packet\" | sha256sum -c -\nexport PYTHONDONTWRITEBYTECODE=1 PYTHONUTF8=1 CUDA_VISIBLE_DEVICES=\nsrun --ntasks=1 --cpus-per-task=4 --cpu-bind=cores \"$py\" -I -B -u - \"$packet\" \"$root\" ca1f4fb3b9ceaf970dd909920c1f9c740d8cf26d332a8a6a97b4931c61311188 <<'DELIVERY_ONLY_BOOTSTRAP'\n\"\"\"Inline delivery-only bootstrap; no tests or original source execution.\"\"\"\nimport hashlib\nimport io\nimport json\nimport os\nimport platform\nimport re\nimport runpy\nimport sys\nimport tarfile\nimport time\nfrom pathlib import Path\n\n\ndef need(ok, reason):\n    if not ok:\n        raise ValueError(reason)\n\n\ndef main():\n    need(time.time() + 180 + 10800 < 1793487600, \"Deadline plus audit reserve exceeded\")\n    need(platform.machine().lower() == \"aarch64\", \"ARM64 allocation required\")\n    need(all(os.environ.get(k) == v for k, v in {\n        \"SLURM_CPUS_PER_TASK\": \"4\", \"SLURM_NTASKS\": \"1\", \"SLURM_JOB_NUM_NODES\": \"1\",\n        \"SLURM_MEM_PER_NODE\": \"16384\"}.items()), \"Exact 4CPU/1task/1node/16GiB allocation required\")\n    need(re.fullmatch(r\"[0-9]+\", os.environ.get(\"SLURM_JOB_ID\", \"\")) is not None, \"Actual Slurm job required\")\n    need(not os.environ.get(\"SLURM_JOB_GPUS\", \"\") and not os.environ.get(\"SLURM_STEP_GPUS\", \"\")\n         and os.environ.get(\"SLURM_GPUS\", \"0\") == \"0\"\n         and os.environ.get(\"SLURM_GPUS_ON_NODE\", \"0\") == \"0\", \"Zero GPU required\")\n    affinity = sorted(os.sched_getaffinity(0))\n    need(len(affinity) == 4, \"Unique srun must bind exactly four CPUs\")\n    packet, root = map(Path, sys.argv[1:3])\n    expected_packet_sha = sys.argv[3]\n    need(root.is_absolute() and not root.exists() and not root.is_symlink(), \"Fresh absolute dedicated root required\")\n    packet_bytes = packet.read_bytes()\n    need(len(packet_bytes) <= 64 * 1024 * 1024\n         and hashlib.sha256(packet_bytes).hexdigest() == expected_packet_sha,\n         \"Exact bounded packet bytes required\")\n    expected = {\"livrer-sans-reexecution.py\", \"delivery-bindings.json\", \"packet-manifest.json\"}\n    with tarfile.open(fileobj=io.BytesIO(packet_bytes), mode=\"r:gz\") as archive:\n        members = archive.getmembers()\n        need(len(members) == len(expected) and {m.name for m in members} == expected\n             and all(m.isfile() and not m.issym() and not m.islnk() for m in members)\n             and sum(m.size for m in members) <= 128 * 1024 * 1024,\n             \"Exact three regular delivery packet files required\")\n        root.mkdir(parents=False, exist_ok=False)\n        for member in members:\n            with (root / member.name).open(\"xb\") as stream:\n                stream.write(archive.extractfile(member).read())\n    actual = {name: hashlib.sha256((root / name).read_bytes()).hexdigest()\n              for name in expected - {\"packet-manifest.json\"}}\n    need(actual == json.loads((root / \"packet-manifest.json\").read_text(encoding=\"utf-8\")),\n         \"Exact packet manifest required before wrapper execution\")\n    with (root / \"bootstrap-allocation.json\").open(\"x\", encoding=\"utf-8\") as stream:\n        json.dump({\"observed_at\": time.time(), \"architecture\": \"ARM64\", \"cpu_cores\": 4,\n                   \"tasks\": 1, \"nodes\": 1, \"allocated_memory_mib\": 16384, \"allocated_gpus\": 0,\n                   \"slurm_job_id\": os.environ[\"SLURM_JOB_ID\"], \"affinity_cpu_ids\": affinity,\n                   \"guard_before_any_extraction\": True, \"native_model_calls\": 0}, stream)\n    sys.argv = [str(root / \"livrer-sans-reexecution.py\"), \"--delivery-root\", str(root)]\n    runpy.run_path(str(root / \"livrer-sans-reexecution.py\"), run_name=\"__main__\")\n\n\nif __name__ == \"__main__\":\n    main()\nDELIVERY_ONLY_BOOTSTRAP\n\necho \"[romeo-mcp] fin $(date -Is)\"\n",

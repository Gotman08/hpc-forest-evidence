 need(len(affinity) == 4, \"Unique srun must bind exactly four CPUs\")\n    packet, root = map(Path, sys.argv[1:3])\n    expected_packet_sha = sys.argv[3]\n    need(root.is_absolute() and not root.exists() and not root.is_symlink(), \"Fresh absolute dedicated root required\")\n    packet_bytes = packet.read_bytes()\n    need(len(packet_bytes) <= 64 * 1024 * 1024\n         and hashlib.sha256(packet_bytes).hexdigest() == expected_packet_sha,\n         \"Exact bounded packet bytes required\")\n    expected = {\"livrer-sans-reexecution.py\", \"delivery-bindings.json\", \"packet-manifest.json\"}\n    with tarfile.open(fileobj=io.BytesIO(packet_bytes), mode=\"r:gz\") as archive:\n        members = archive.getmembers()\n        need(len(members) == len(expected) and {m.name for m in members} == expected\n             and all(m.isfile() and not m.issym() and not m.islnk() for m in members)\n             and sum(m.size for m in members) <= 128 * 1024 * 1024,\n             \"Exact three regular delivery packet files required\")\n        root.mkdir(parents=False, exist_ok=False)\n        for member in members:\n            with (root / member.name).open(\"xb\") as stream:\n                stream.write(archive.extractfile(member).read())\n    actual = {name: hashlib.sha256((root / name).read_bytes()).hexdigest()\n              for name in expected - {\"packet-manifest.json\"}}\n    need(actual == json.loads((root / \"packet-manifest.json\").read_text(encoding=\"utf-8\")),\n         \"Exact packet manifest required before wrapper execution\")\n    with (root / \"bootstrap-allocation.json\").open(\"x\", encoding=\"utf-8\") as stream:\n        json.dump({\"observed_at\": time.time(), \"architecture\": \"ARM64\", \"cpu_cores\": 4,\n                   \"tasks\": 1, \"nodes\": 1, \"allocated_memory_mib\": 16384, \"allocated_gpus\": 0,\n                   \"slurm_job_id\": os.environ[\"SLURM_JOB_ID\"], \"affinity_cpu_ids\": affinity,\n                   \"guard_before_any_extraction\": True, \"native_model_calls\": 0}, stream)\n    sys.argv = [str(root / \"livrer-sans-reexecution.py\"), \"--delivery-root\", str(root)]\n    runpy.run_path(str(root / \"livrer-sans-reexecution.py\"), run_name=\"__main__\")\n\n\nif __name__ == \"__main__\":\n    main()\nDELIVERY_ONLY_BOOTSTRAP\n\necho \"[romeo-mcp] fin $(date -Is)\"\n",

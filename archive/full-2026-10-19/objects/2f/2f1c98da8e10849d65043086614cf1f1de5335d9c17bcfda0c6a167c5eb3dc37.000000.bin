#include <iostream>
#include <vector>
#include <cstdio>
#include <climits>
#include <algorithm>

int main() {
	int n, s;
	std::cin >> n >> s;

	// Use a flat 1D array for better cache locality and SIMD friendliness
	std::vector<int> matrix(n * n);
	for (int i = 0; i < n; ++i)
		for (int j = 0; j < n; ++j)
			scanf("%d", &matrix[i * n + j]);

	// Integral image: pref[i][j] = sum of submatrix from (0,0) to (i-1,j-1)
	int p = n + 1; // stride for flat index
	std::vector<long long> pref(p * p, 0);

	// First pass: row-wise cumulative sums (parallel over rows)
#pragma omp parallel for
	for (int i = 0; i < n; ++i) {
		long long sum = 0;
		int base_row = i * n;
		int pref_row = (i + 1) * p;
		for (int j = 0; j < n; ++j) {
			sum += matrix[base_row + j];
			pref[pref_row + j + 1] = sum;
		}
	}

	// Second pass: vertical accumulation (parallel over columns)
#pragma omp parallel for
	for (int j = 0; j <= n; ++j) {
		long long cum = 0;
		for (int i = 1; i <= n; ++i) {
			pref[i * p + j] += pref[(i - 1) * p + j];
		}
	}

	// Compute maximum submatrix sum in O(1) per candidate using the integral image
	long long mxSum = LLONG_MIN;
#pragma omp parallel for reduction(max : mxSum)
	for (int i = 0; i <= n - s; ++i) {
		int base_i = i * p;
		int bot_i = (i + s) * p;
#pragma omp simd
		for (int j = 0; j <= n - s; ++j) {
			long long val = pref[bot_i + j + s] -
			                pref[base_i + j + s] -
			                pref[bot_i + j] +
			                pref[base_i + j];
			if (val > mxSum)
				mxSum = val;
		}
	}

	printf("%d\n", static_cast<int>(mxSum));
	return 0;
}

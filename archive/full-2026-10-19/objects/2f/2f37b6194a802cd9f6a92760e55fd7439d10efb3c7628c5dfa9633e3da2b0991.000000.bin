      {
        "content": "/*\n * This code was based on Sokoban C available at\n * http://www.rosettacode.org/wiki/Sokoban#C\n * licenced under GNU Free Documentation License 1.2\n */\n\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <unistd.h>\n#include <stdint.h>\n#include <assert.h>\n#include <stdbool.h>\n\nint w, h, n_boxes;\nuint8_t * board, * goals, * live;\n\ntypedef uint16_t cidx_t;\ntypedef uint32_t hash_t;\n\n/* board configuration is represented by an array of cell indices\n   of player and boxes */\ntypedef struct state_t state_t;\n\nstruct state_t { // variable length\n    hash_t h;\n    state_t * prev, * next, * qnext;\n    cidx_t c[];\n};\n\nsize_t state_size, block_size = 32;\nstate_t * block_root, * block_head;\n\ninline\nstate_t * newstate(state_t * parent) {\n    inline state_t * next_of(state_t * s) {\n        return (void * )((uint8_t * ) s + state_size);\n    }\n\n    state_t * ptr;\n    if (!block_head) {\n        block_size *= 2;\n        state_t * p = malloc(block_size * state_size);\n        assert(p);\n        p -> next = block_root;\n        block_root = p;\n        ptr = (void * )((uint8_t * ) p + state_size * block_size);\n        p = block_head = next_of(p);\n        state_t * q;\n        for (q = next_of(p); q < ptr; p = q, q = next_of(q))\n            p -> next = q;\n        p -> next = NULL;\n    }\n\n    ptr = block_head;\n    block_head = block_head -> next;\n\n    ptr -> prev = parent;\n    ptr -> h = 0;\n    return ptr;\n}\n\ninline\nvoid unnewstate(state_t * p) {\n    p -> next = block_head;\n    block_head = p;\n}\n\nenum {\n    space,\n    wall,\n    player,\n    box\n};\n\n// mark up positions where a box definitely should not be\nvoid mark_live(const int c) {\n    const int y = c / w,\n        x = c % w;\n    if (live[c]) return;\n\n    live[c] = 1;\n    if (y > 1 && board[c - w] != wall && board[c - w * 2] != wall)\n        mark_live(c - w);\n    if (y < h - 2 && board[c + w] != wall && board[c + w * 2] != wall)\n        mark_live(c + w);\n    if (x > 1 && board[c - 1] != wall && board[c - 2] != wall)\n        mark_live(c - 1);\n    if (x < w - 2 && board[c + 1] != wall && board[c + 2] != wall)\n        mark_live(c + 1);\n}\n\nstate_t * parse_board(const char * s) {\n    board = calloc(w * h, sizeof(uint8_t));\n    assert(board);\n    goals = calloc(w * h, sizeof(uint8_t));\n    assert(goals);\n    live = calloc(w * h, sizeof(uint8_t));\n    assert(live);\n\n    n_boxes = 0;\n    for (int i = 0; s[i]; i++) {\n        switch (s[i]) {\n        case '#':\n            board[i] = wall;\n            continue;\n\n        case '.': // fallthrough\n        case '+':\n            goals[i] = 1; // fallthrough\n        case '@':\n            continue;\n\n        case '*':\n            goals[i] = 1; // fallthrough\n        case '$':\n            n_boxes++;\n            continue;\n        default:\n            continue;\n        }\n    }\n\n    const int is = sizeof(int);\n    state_size = (sizeof(state_t) + (1 + n_boxes) * sizeof(cidx_t) + is - 1) /\n        is * is;\n\n    state_t * state = newstate(NULL);\n\n    for (int i = 0, j = 0; i < w * h; i++) {\n        if (goals[i]) mark_live(i);\n        if (s[i] == '$' || s[i] == '*')\n            state -> c[++j] = i;\n        else if (s[i] == '@' || s[i] == '+')\n            state -> c[0] = i;\n    }\n\n    return state;\n}\n\n// K&R hash function\ninline\nvoid hash(state_t * s) {\n    if (!s -> h) {\n        register hash_t ha = 0;\n        cidx_t * p = s -> c;\n        for (int i = 0; i <= n_boxes; i++)\n            ha = p[i] + 31 * ha;\n        s -> h = ha;\n    }\n}\n\nstate_t ** buckets;\nhash_t hash_size, fill_limit, filled;\n\nvoid extend_table() {\n    int old_size = hash_size;\n\n    if (!old_size) {\n        hash_size = 1024;\n        filled = 0;\n        fill_limit = hash_size * 3 / 4; // 0.75 load factor\n    } else {\n        hash_size *= 2;\n        fill_limit *= 2;\n    }\n\n    buckets = realloc(buckets, sizeof(state_t * ) * hash_size);\n    assert(buckets);\n\n    // rehash\n    memset(buckets + old_size, 0, sizeof(state_t * ) * (hash_size - old_size));\n\n    const hash_t bits = hash_size - 1;\n    for (int i = 0; i < old_size; i++) {\n        state_t * head = buckets[i];\n        buckets[i] = NULL;\n        while (head) {\n            state_t * next = head -> next;\n            const int j = head -> h & bits;\n            head -> next = buckets[j];\n            buckets[j] = head;\n            head = next;\n        }\n    }\n}\n\nstate_t * lookup(state_t * s) {\n    hash(s);\n    state_t * f = buckets[s -> h & (hash_size - 1)];\n    for (; f; f = f -> next) {\n        if ( //(f->h == s->h) &&\n            !memcmp(s -> c, f -> c, sizeof(cidx_t) * (1 + n_boxes)))\n            break;\n    }\n\n    return f;\n}\n\nbool add_to_table(state_t * s) {\n    if (lookup(s)) {\n        unnewstate(s);\n        return false;\n    }\n\n    if (filled++ >= fill_limit)\n        extend_table();\n\n    hash_t i = s -> h & (hash_size - 1);\n\n    s -> next = buckets[i];\n    buckets[i] = s;\n    return true;\n}\n\nbool success(const state_t * s) {\n    for (int i = 1; i <= n_boxes; i++)\n        if (!goals[s -> c[i]]) return false;\n    return true;\n}\n\ntypedef struct {\n    int c1;\n    int c2;\n    int at_box;\n} move_candidate_t;\n\nbool prepare_move(state_t * s, const int dy, const int dx,\n        move_candidate_t * candidate) {\n    const int y = s -> c[0] / w;\n    const int x = s -> c[0] % w;\n    const int y1 = y + dy;\n    const int x1 = x + dx;\n    const int c1 = y1 * w + x1;\n\n    if (y1 < 0 || y1 > h || x1 < 0 || x1 > w ||\n        board[c1] == wall)\n        return false;\n\n    int at_box = 0;\n    for (int i = 1; i <= n_boxes; i++) {\n        if (s -> c[i] == c1) {\n            at_box = i;\n            break;\n        }\n    }\n\n    int c2 = 0;\n    if (at_box) {\n        c2 = c1 + dy * w + dx;\n        if (board[c2] == wall || !live[c2])\n            return false;\n        for (int i = 1; i <= n_boxes; i++)\n            if (s -> c[i] == c2) return false;\n    }\n\n    candidate -> c1 = c1;\n    candidate -> c2 = c2;\n    candidate -> at_box = at_box;\n    return true;\n}\n\nstate_t * build_move(state_t * s, const move_candidate_t * candidate) {\n    state_t * n = newstate(s);\n    memcpy(n -> c + 1, s -> c + 1, sizeof(cidx_t) * n_boxes);\n\n    cidx_t * p = n -> c;\n    p[0] = candidate -> c1;\n\n    if (candidate -> at_box)\n        p[candidate -> at_box] = candidate -> c2;\n\n    // leet bubble sort\n    for (int i = n_boxes; --i;) {\n        cidx_t t = 0;\n        for (int j = 1; j < i; j++) {\n            if (p[j] > p[j + 1])\n                t = p[j], p[j] = p[j + 1], p[j + 1] = t;\n        }\n        if (!t) break;\n    }\n\n    return n;\n}\n\nstate_t * move_me(state_t * s,\n    const int dy,\n        const int dx) {\n    move_candidate_t candidate;\n    if (!prepare_move(s, dy, dx, &candidate))\n        return NULL;\n    return build_move(s, &candidate);\n}\n\nstate_t * next_level, * done;\n\nbool queue_move(state_t * s) {\n    if (!s || !add_to_table(s))\n        return false;\n\n    if (success(s)) {\n        done = s;\n        return true;\n    }\n\n    s -> qnext = next_level;\n    next_level = s;\n    return false;\n}\n\nbool do_move(state_t * s) {\n    return queue_move(move_me(s, 0, 1)) ||\n        queue_move(move_me(s, 0, -1)) ||\n        queue_move(move_me(s, -1, 0)) ||\n        queue_move(move_me(s, 1, 0));\n}\n\nenum {\n    PARALLEL_FRONTIER_THRESHOLD = 256,\n    PARALLEL_TILE = 256\n};\n\nvoid do_parallel_level(state_t * head, size_t count) {\n    state_t ** frontier = malloc(count * sizeof(*frontier));\n    assert(frontier);\n    size_t index = 0;\n    for (state_t * s = head; s; s = s -> qnext)\n        frontier[index++] = s;\n    assert(index == count);\n\n    const size_t tile_moves = (size_t)PARALLEL_TILE * 4;\n    move_candidate_t * moves = malloc(tile_moves * sizeof(*moves));\n    unsigned char * valid = malloc(tile_moves * sizeof(*valid));\n    assert(moves && valid);\n\n    next_level = NULL;\n#pragma omp parallel shared(frontier, moves, valid, count, done, next_level)\n    {\n        for (size_t base = 0; base < count && !done;\n                base += PARALLEL_TILE) {\n            size_t end = base + PARALLEL_TILE;\n            if (end > count) end = count;\n\n#pragma omp for schedule(static)\n            for (size_t i = base; i < end; i++) {\n                const size_t offset = (i - base) * 4;\n                for (int direction = 0; direction < 4; direction++) {\n                    const int dy[] = {0, 0, -1, 1};\n                    const int dx[] = {1, -1, 0, 0};\n                    valid[offset + direction] = prepare_move(frontier[i],\n                        dy[direction], dx[direction], &moves[offset + direction]);\n                }\n            }\n\n#pragma omp single\n            {\n                for (size_t i = base; i < end && !done; i++) {\n                    const size_t offset = (i - base) * 4;\n                    for (int direction = 0; direction < 4; direction++) {\n                        if (valid[offset + direction] &&\n                            queue_move(build_move(frontier[i],\n                                &moves[offset + direction])))\n                            break;\n                    }\n                }\n            }\n        }\n    }\n\n    free(valid);\n    free(moves);\n    free(frontier);\n}\n\nvoid show_moves(const state_t * s, int nextPos) {\n    if (s -> prev)\n        show_moves(s -> prev, s -> c[0]);\n    if (nextPos == -1) {\n        printf(\"\\n\");\n        return;\n    }\n    int cx = s -> c[0] % w;\n    int cy = s -> c[0] / w;\n    int nx = nextPos % w;\n    int ny = nextPos / w;\n    int box = 0;\n    for (int i = 1; !box && i <= n_boxes; i++)\n        box = s -> c[i] == nextPos;\n    if (cx < nx) printf(box ? \"R\" : \"r\");\n    else if (cx > nx) printf(box ? \"L\" : \"l\");\n    else if (cy < ny) printf(box ? \"D\" : \"d\");\n    else if (cy > ny) printf(box ? \"U\" : \"u\");\n    else if (1) {\n        printf(\"Invalid move\\n\");\n        exit(1);\n    }\n}\n\nint main() {\n    size_t sz = 1024;\n    char * boardStr = malloc(sz * sizeof(char));\n    char * pos = boardStr;\n    w = -1;\n    h = 0;\n    while (1) {\n        int read = getline( & pos, & sz, stdin);\n        if (read == -1) break;\n        if (read >= w) w = read;\n        sz -= read;\n        pos += read;\n        h++;\n    }\n    state_t * s = parse_board(boardStr);\n    free(boardStr);\n\n    extend_table();\n    queue_move(s);\n    while (!done) {\n        state_t * head = next_level;\n        size_t frontier_size = 0;\n        for (state_t * p = head; p; p = p -> qnext)\n            frontier_size++;\n\n        if (frontier_size >= PARALLEL_FRONTIER_THRESHOLD) {\n            do_parallel_level(head, frontier_size);\n        } else {\n            for (next_level = NULL; head && !done; head = head -> qnext)\n                do_move(head);\n        }\n\n        if (!next_level) {\n            puts(\"no solution?\");\n            return 1;\n        }\n    }\n\n    show_moves(done, -1);\n\n    free(buckets);\n    free(board);\n    free(goals);\n    free(live);\n\n    while (block_root) {\n        void * tmp = block_root -> next;\n        free(block_root);\n        block_root = tmp;\n    }\n    return 0;\n}\n",
        "path": "src/sokoban.c"
      }
    ],
    "hypothesis": "A single OpenMP team can parallelize read-only move-legality checks for broad BFS frontiers while coarse 256-state tiles reduce scheduling and synchronization overhead. Serial insertion in the original parent and move order preserves deterministic successor selection; small frontiers remain serial. This tests a coarser-grained alternative to the prior 64-state approach on the four-core ARM64 target.",
    "notes": "The previous OpenMP experiment was correct but slightly slower than baseline. This candidate is untested; correctness and performance must be evaluated by the controller. It parallelizes only candidate checks and keeps allocation, hashing, deduplication, and queue insertion serial.",

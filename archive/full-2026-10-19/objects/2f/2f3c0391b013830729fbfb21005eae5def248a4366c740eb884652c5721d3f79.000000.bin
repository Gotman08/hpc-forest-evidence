{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n#include <float.h>\\n#include <limits.h>\\n#include <stdint.h>\\n#include <string.h>\\n\\nstatic char knn_insertion_fallback(int n_groups, Group *groups, int k, Point to_evaluate) {\\n    char *labels = (char *)malloc(sizeof(char) * k);\\n    float *distances = (float *)malloc(sizeof(float) * k);\\n\\n    int i, j, x, y;\\n    for (i = 0; i < k; i++) {\\n        labels[i] = -1;\\n        distances[i] = -1;\\n    }\\n\\n    for (i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n        for (j = 0; j < g.length; j++) {\\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n            for (x = 0; x < k; x++) {\\n                if (d < distances[x] || distances[x] == -1) {\\n                    for (y = k - 1; y > x; y--) {\\n                        distances[y] = distances[y - 1];\\n                        labels[y] = labels[y - 1];\\n                    }\\n                    distances[x] = d;\\n                    labels[x] = g.label;\\n                    break;\\n                }\\n            }\\n        }\\n    }\\n\\n    qsort(labels, k, sizeof(char), compare_for_sort);\\n    char most_frequent = labels[0];\\n    int most_frequent_count = 1;\\n    int current_frequency = 1;\\n    for (i = 1; i < k; i++) {\\n        if (labels[i] != labels[i - 1]) {\\n            if (current_frequency > most_frequent_count) {\\n                most_frequent = labels[i - 1];\\n                most_frequent_count = current_frequency;\\n            }\\n            current_frequency = 1;\\n        } else {\\n            current_frequency++;\\n        }\\n        if (i == k - 1 && current_frequency > most_frequent_count) {\\n            most_frequent = labels[i - 1];\\n            most_frequent_count = current_frequency;\\n        }\\n    }\\n\\n    free(distances);\\n    free(labels);\\n    return most_frequent;\\n}\\n\\nstatic int compare_keys(const void *a, const void *b) {\\n    uint64_t x = *(const uint64_t *)a;\\n    uint64_t y = *(const uint64_t *)b;\\n    return (x > y) - (x < y);\\n}\\n\\nstatic uint64_t median_key(uint64_t a, uint64_t b, uint64_t c) {\\n    if (a < b) {\\n        return b < c ? b : (a < c ? c : a);\\n    }\\n    return a < c ? a : (b < c ? c : b);\\n}\\n\\n/* Partition one compact stream; only the selected prefix is needed. */\\nstatic void select_prefix(uint64_t *keys, size_t count, size_t take) {\\n    if (take == 0 || take >= count) return;\\n\\n    size_t target = take - 1;\\n    size_t lo = 0;\\n    size_t hi = count;\\n    size_t budget = count <= SIZE_MAX / 8 ? count * 8 : SIZE_MAX;\\n\\n    while (hi - lo > 24) {\\n        size_t length = hi - lo;\\n        if (length > budget) {\\n            qsort(keys + lo, length, sizeof(*keys), compare_keys);\\n            return;\\n        }\\n        budget -= length;\\n\\n        uint64_t pivot = median_key(keys[lo], keys[lo + length / 2], keys[hi - 1]);\\n        size_t lower = lo;\\n        size_t scan = lo;\\n        size_t upper = hi;\\n\\n        while (scan < upper) {\\n            uint64_t value = keys[scan];\\n            if (value < pivot) {\\n                keys[scan] = keys[lower];\\n                keys[lower] = value;\\n                lower++;\\n                scan++;\\n            } else if (value > pivot) {\\n                upper--;\\n                keys[scan] = keys[upper];\\n                keys[upper] = value;\\n            } else {\\n                scan++;\\n            }\\n        }\\n\\n        if (target < lower) {\\n            hi = lower;\\n        } else if (target >= upper) {\\n            lo = upper;\\n        } else {\\n            return;\\n        }\\n    }\\n\\n    for (size_t i = lo + 1; i < hi; i++) {\\n        uint64_t value = keys[i];\\n        size_t j = i;\\n        while (j > lo && value < keys[j - 1]) {\\n            keys[j] = keys[j - 1];\\n            j--;\\n        }\\n        keys[j] = value;\\n    }\\n}\\n\\nstatic char vote_labels(const size_t *counts) {\\n    char best = (char)-1;\\n    size_t best_count = 0;\\n    for (int value = CHAR_MIN; value <= CHAR_MAX; value++) {\\n        size_t frequency = counts[(unsigned char)(char)value];\\n        if (frequency > best_count) {\\n            best_count = frequency;\\n            best = (char)value;\\n        }\\n    }\\n    return best;\\n}\\n\\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n    if (k <= 0 || sizeof(float) != sizeof(uint32_t) ||\\n        FLT_RADIX != 2 || FLT_MANT_DIG != 24 || FLT_MAX_EXP != 128) {\\n        return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    size_t total = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        if (groups[i].length > 0) {\\n            size_t length = (size_t)groups[i].length;\\n            if (length > SIZE_MAX - total) {\\n                return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\\n            }\\n            total += length;\\n        }\\n    }\\n\\n    size_t counts[UCHAR_MAX + 1] = {0};\\n    size_t take = (size_t)k;\\n    if (take > total) {\\n        counts[(unsigned char)((char)-1)] = take - total;\\n        take = total;\\n    }\\n\\n    if (take == total) {\\n        for (int i = 0; i < n_groups; i++) {\\n            if (groups[i].length > 0) {\\n                counts[(unsigned char)groups[i].label] += (size_t)groups[i].length;\\n            }\\n        }\\n        return vote_labels(counts);\\n    }\\n\\n    if (total > SIZE_MAX / sizeof(uint64_t)) {\\n        return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\\n    }\\n    uint64_t *keys = (uint64_t *)malloc(total * sizeof(*keys));\\n    if (keys == NULL) {\\n        return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    size_t used = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        const Group *g = &groups[i];\\n        for (int j = 0; j < g->length; j++) {\\n            float distance = euclidean_distance_no_sqrt(to_evaluate, g->points[j]);\\n            uint32_t bits;\\n            memcpy(&bits, &distance, sizeof(bits));\\n            uint32_t magnitude = bits & UINT32_C(0x7fffffff);\\n            if (magnitude > UINT32_C(0x7f800000) ||\\n                ((bits & UINT32_C(0x80000000)) && magnitude != 0)) {\\n                free(keys);\\n                return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\\n            }\\n            if (magnitude == 0) bits = 0;\\n\\n            /* Equal distances prefer earlier groups, as in the input scan.\\n               Ties within a group have identical labels. */\\n            keys[used++] = ((uint64_t)bits << 32) | (uint32_t)i;\\n        }\\n    }\\n\\n    select_prefix(keys, total, take);\\n    for (size_t i = 0; i < take; i++) {\\n        uint32_t group_index = (uint32_t)keys[i];\\n        counts[(unsigned char)groups[group_index].label]++;\\n    }\\n    free(keys);\\n    return vote_labels(counts);\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"A contiguous 8-byte distance/group key stream with in-place rank partitioning should eliminate neighbor-array shifts and avoid full radix passes.\",\n  \"notes\": \"Not executed. Preserves equal-distance group order, native-char vote ties and sentinel padding. Retains the original insertion algorithm for NaNs, unsupported float formats or allocation failure; releases per-call workspace.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Pack each distance and input-group index into one contiguous 64-bit key, retaining exact label-relevant tie ordering.\",\n    \"Select the nearest prefix with three-way introselection, small-range insertion sorting and a bounded-work qsort fallback.\",\n    \"Count selected labels in a fixed-size histogram; tally groups directly when every point is selected.\"\n  ]\n}"}}

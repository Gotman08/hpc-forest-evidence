#include <iostream>
#include <vector>
#include <cstdio>
#include <algorithm>
#include <climits>

int main() {
	int n, s;
	std::cin >> n >> s;
	std::vector<std::vector<int>> matrix(n, std::vector<int>(n));
	for (int i = 0; i < n; ++i)
		for (int j = 0; j < n; ++j)
			scanf("%d", &matrix[i][j]);

	// Integral image: prefix sums with extra row/col of zeros
	std::vector<std::vector<long long>> ps(n + 1, std::vector<long long>(n + 1, 0));

	#pragma omp parallel for schedule(static)
	for (int i = 0; i < n; ++i) {
		long long row_sum = 0;
		for (int j = 0; j < n; ++j) {
			row_sum += matrix[i][j];
			ps[i + 1][j + 1] = row_sum;
		}
	}

	#pragma omp parallel for schedule(static)
	for (int j = 0; j <= n; ++j) {
		long long col_sum = ps[0][j];
		for (int i = 1; i <= n; ++i) {
			col_sum += ps[i][j];
			ps[i][j] = col_sum;
		}
	}

	int mxSum = INT_MIN;
	const int total = (n - s + 1) * (n - s + 1);
	#pragma omp parallel for reduction(max:mxSum) schedule(static)
	for (int idx = 0; idx < total; ++idx) {
		int i = idx / (n - s + 1);
		int j = idx % (n - s + 1);
		long long sum = ps[i + s][j + s] - ps[i][j + s] - ps[i + s][j] + ps[i][j];
		mxSum = std::max(mxSum, static_cast<int>(sum));
	}

	printf("%d\n", mxSum);
}
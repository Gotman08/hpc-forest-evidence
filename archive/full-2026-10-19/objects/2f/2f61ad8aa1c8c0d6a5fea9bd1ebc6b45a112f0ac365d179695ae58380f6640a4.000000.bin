#include "knn.h"

// Flattened storage for all points across groups.
static float *all_coords = NULL;   // interleaved x,y pairs
static char *point_labels = NULL;
static int total_points = 0;

// Group boundaries: start index into the flattened arrays and length.
typedef struct {
    int start;
    int len;
} GroupInfo;

static GroupInfo *group_info = NULL;

// Max-heap for k nearest neighbors (1-indexed).
static float *heap_dist = NULL;
static char *heap_label = NULL;
static int heap_size = 0;   // current number of elements in heap

void heap_swap(int i, int j) {
    float td = heap_dist[i];
    heap_dist[i] = heap_dist[j];
    heap_dist[j] = td;
    char tl = heap_label[i];
    heap_label[i] = heap_label[j];
    heap_label[j] = tl;
}

void sift_down(int idx, int n) {
    while (1) {
        int largest = idx;
        int left = 2 * idx;
        int right = 2 * idx + 1;
        if (left <= n && heap_dist[left] > heap_dist[largest]) largest = left;
        if (right <= n && heap_dist[right] > heap_dist[largest]) largest = right;
        if (largest == idx) break;
        heap_swap(idx, largest);
        idx = largest;
    }
}

void sift_up(int idx) {
    while (idx > 1 && heap_dist[idx] > heap_dist[idx / 2]) {
        heap_swap(idx, idx / 2);
        idx /= 2;
    }
}

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    // Allocate flattened arrays if not already done.
    if (all_coords == NULL) {
        total_points = 0;
        for (int i = 0; i < n_groups; i++) {
            total_points += groups[i].length;
        }
        all_coords = (float *)malloc(sizeof(float) * 2 * total_points);
        point_labels = (char *)malloc(sizeof(char) * total_points);
        group_info = (GroupInfo *)malloc(sizeof(GroupInfo) * n_groups);

        int idx = 0;
        for (int i = 0; i < n_groups; i++) {
            Group g = groups[i];
            group_info[i].start = idx;
            group_info[i].len = g.length;
            for (int j = 0; j < g.length; j++) {
                all_coords[2 * idx]     = g.points[j].x;
                all_coords[2 * idx + 1] = g.points[j].y;
                point_labels[idx]       = g.label;
                idx++;
            }
        }
    }

    // Allocate heap arrays (size k+1 for 1-indexing).
    if (heap_dist == NULL) {
        heap_dist = (float *)malloc(sizeof(float) * (k + 1));
        heap_label = (char *)malloc(sizeof(char) * (k + 1));
    }

    float px = to_evaluate.x;
    float py = to_evaluate.y;

    heap_size = 0;

    // Process all points in sequential order.
    for (int i = 0; i < total_points; i++) {
        float dx = all_coords[2 * i] - px;
        float dy = all_coords[2 * i + 1] - py;
        float d = dx * dx + dy * dy;

        if (heap_size < k) {
            heap_size++;
            int pos = heap_size;
            heap_dist[pos] = d;
            heap_label[pos] = point_labels[i];
            sift_up(pos);
        } else if (d < heap_dist[1]) {
            // Replace root.
            heap_dist[1] = d;
            heap_label[1] = point_labels[i];
            sift_down(1, k);
        }
    }

    // Count frequencies using histogram.
    int freq[256] = {0};
    for (int i = 1; i <= heap_size; i++) {
        unsigned char lbl = (unsigned char)heap_label[i];
        freq[lbl]++;
    }

    // Find most frequent label.
    int best_count = 0;
    char best_label = 0;
    for (int c = 1; c < 256; c++) {
        if (freq[c] > best_count) {
            best_count = freq[c];
            best_label = (char)c;
        }
    }

    return best_label;
}

int main() {
    int n_groups = parse_number_of_groups();

    Group * groups = (Group *)malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));

    // Free allocated memory (optional but good practice).
    free(all_coords);
    free(point_labels);
    free(group_info);
    free(heap_dist);
    free(heap_label);
    for (int i = 0; i < n_groups; i++) {
        free(groups[i].points);
    }
    free(groups);

    return 0;
}

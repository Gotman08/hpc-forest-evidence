{
  "src/nbody.c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nenum {\n  FORCE_LANES = 8,\n  FORCE_TARGET_BLOCK = 64,\n  FORCE_SOURCE_BLOCK = 256\n};\n\nstatic void body_force_scalar(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n#if defined(__GNUC__) && !defined(__clang__)\n#pragma GCC push_options\n#pragma GCC optimize (\"no-math-errno\")\n#endif\n\n/* SIMD lanes represent targets, never terms of a force reduction. */\nstatic void accumulate_force_tile(\n    const float *restrict x, const float *restrict y,\n    const float *restrict z, int first, int width,\n    int jbegin, int jend,\n    float *restrict accum_x, float *restrict accum_y,\n    float *restrict accum_z) {\n  float xi[FORCE_LANES], yi[FORCE_LANES], zi[FORCE_LANES];\n  float fx[FORCE_LANES], fy[FORCE_LANES], fz[FORCE_LANES];\n\n  for (int lane = 0; lane < FORCE_LANES; ++lane) {\n    if (lane < width) {\n      xi[lane] = x[first + lane];\n      yi[lane] = y[first + lane];\n      zi[lane] = z[first + lane];\n      fx[lane] = accum_x[lane];\n      fy[lane] = accum_y[lane];\n      fz[lane] = accum_z[lane];\n    } else {\n      xi[lane] = 0.0f;\n      yi[lane] = 0.0f;\n      zi[lane] = 0.0f;\n      fx[lane] = 0.0f;\n      fy[lane] = 0.0f;\n      fz[lane] = 0.0f;\n    }\n  }\n\n  for (int j = jbegin; j < jend; ++j) {\n    float xj = x[j];\n    float yj = y[j];\n    float zj = z[j];\n#ifdef _OPENMP\n#pragma omp simd\n#endif\n    for (int lane = 0; lane < FORCE_LANES; ++lane) {\n      float dx = xj - xi[lane];\n      float dy = yj - yi[lane];\n      float dz = zj - zi[lane];\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx[lane] += dx * inv_dist3;\n      fy[lane] += dy * inv_dist3;\n      fz[lane] += dz * inv_dist3;\n    }\n  }\n\n  for (int lane = 0; lane < width; ++lane) {\n    accum_x[lane] = fx[lane];\n    accum_y[lane] = fy[lane];\n    accum_z[lane] = fz[lane];\n  }\n}\n\n#if defined(__GNUC__) && !defined(__clang__)\n#pragma GCC pop_options\n#endif\n\n/*\n * Reuse each compact source slab across several register-sized\n * target tiles. Each target still visits sources in ascending order.\n */\nvoid body_force(Body *p, float dt, int n) {\n  if (n < 4 * FORCE_LANES) {\n    body_force_scalar(p, dt, n);\n    return;\n  }\n\n  float *positions = (float *)malloc((size_t)n * 3 * sizeof(float));\n  if (positions == NULL) {\n    body_force_scalar(p, dt, n);\n    return;\n  }\n\n  float *x = positions;\n  float *y = x + n;\n  float *z = y + n;\n  for (int i = 0; i < n; ++i) {\n    x[i] = p[i].x;\n    y[i] = p[i].y;\n    z[i] = p[i].z;\n  }\n\n  const int target_span = n >= 4 * FORCE_TARGET_BLOCK\n                        ? FORCE_TARGET_BLOCK : FORCE_LANES;\n  const int nblocks = n / target_span + (n % target_span != 0);\n\n#ifdef _OPENMP\n#pragma omp parallel for schedule(static)\n#endif\n  for (int block = 0; block < nblocks; ++block) {\n    int first = block * target_span;\n    int count = n - first;\n    if (count > target_span)\n      count = target_span;\n\n    float fx[FORCE_TARGET_BLOCK] = {0.0f};\n    float fy[FORCE_TARGET_BLOCK] = {0.0f};\n    float fz[FORCE_TARGET_BLOCK] = {0.0f};\n\n    for (int jbegin = 0; jbegin < n;) {\n      int jend = n - jbegin > FORCE_SOURCE_BLOCK\n               ? jbegin + FORCE_SOURCE_BLOCK : n;\n\n      for (int offset = 0; offset < count; offset += FORCE_LANES) {\n        int width = count - offset;\n        if (width > FORCE_LANES)\n          width = FORCE_LANES;\n        accumulate_force_tile(x, y, z, first + offset, width,\n                              jbegin, jend,\n                              fx + offset, fy + offset, fz + offset);\n      }\n      jbegin = jend;\n    }\n\n    for (int lane = 0; lane < count; ++lane) {\n      p[first + lane].vx += dt*fx[lane];\n      p[first + lane].vy += dt*fy[lane];\n      p[first + lane].vz += dt*fz[lane];\n    }\n  }\n\n  free(positions);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n"
}

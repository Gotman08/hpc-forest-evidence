{"files":[{"content":"#include <cstddef>\n#include <iostream>\n#include <utility>\n#include <vector>\n\nusing namespace std;\n\nclass adjacency_matrix {\npublic:\n    explicit adjacency_matrix(size_t vertices = 0)\n        : vertices_(vertices), cells_(vertices * vertices, 0) {}\n\n    size_t size() const {\n        return vertices_;\n    }\n\n    unsigned char &operator()(size_t row, size_t column) {\n        return cells_[row * vertices_ + column];\n    }\n\n    unsigned char operator()(size_t row, size_t column) const {\n        return cells_[row * vertices_ + column];\n    }\n\n    const unsigned char *rowData(size_t row) const {\n        return cells_.data() + row * vertices_;\n    }\n\nprivate:\n    size_t vertices_;\n    vector<unsigned char> cells_;\n};\n\nadjacency_matrix readGraph();\nvector<int> computeDegrees(const adjacency_matrix &graph);\nbool sameDegreeMultiset(const vector<int> &degree1, const vector<int> &degree2);\nbool sameDegreesUnderPermutation(const vector<int> &degree1, const vector<int> &degree2,\n                                 const vector<int> &equivalence);\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence);\ninline void printPermutation(vector<int> &equivalence);\n\nint main() {\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if (!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2) {\n    if (g1.size() != g2.size()) return false;\n\n    vector<int> equivalence(g1.size(), 0);\n    for (size_t i = 0; i < equivalence.size(); ++i)\n        equivalence[i] = static_cast<int>(i);\n\n    if (verifyPermutation(g1, g2, equivalence)) {\n        printPermutation(equivalence);\n        return true;\n    }\n\n    const vector<int> degree1 = computeDegrees(g1);\n    const vector<int> degree2 = computeDegrees(g2);\n    if (!sameDegreeMultiset(degree1, degree2)) return false;\n\n    vector<int> exchange_counter(g1.size(), 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    /*\n     * Permutations are based on Heap's algorithm, which generates all possible\n     * permutations for a given set of elements.\n     */\n    while (exchange_index < static_cast<int>(g1.size())) {\n        if (exchange_counter[exchange_index] < exchange_index) {\n            if (exchange_index % 2 == 0)\n                swap(equivalence[0], equivalence[exchange_index]);\n            else\n                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\n\n            if (sameDegreesUnderPermutation(degree1, degree2, equivalence) &&\n                verifyPermutation(g1, g2, equivalence)) {\n                printPermutation(equivalence);\n                isomorphism_found = true;\n            }\n\n            exchange_counter[exchange_index]++;\n            exchange_index = 1;\n        } else {\n            exchange_counter[exchange_index] = 0;\n            exchange_index++;\n        }\n    }\n    return isomorphism_found;\n}\n\nadjacency_matrix readGraph() {\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read(static_cast<size_t>(vertices));\n\n    cin >> edges;\n    for (int i = 0; i < edges; i++) {\n        cin >> source >> destination;\n        read(static_cast<size_t>(destination), static_cast<size_t>(source)) = 1;\n        read(static_cast<size_t>(source), static_cast<size_t>(destination)) = 1;\n    }\n\n    return read;\n}\n\nvector<int> computeDegrees(const adjacency_matrix &graph) {\n    vector<int> degrees(graph.size(), 0);\n    for (size_t i = 0; i < graph.size(); ++i) {\n        const unsigned char *row = graph.rowData(i);\n        size_t j = 0;\n        int degree0 = 0;\n        int degree1 = 0;\n        int degree2 = 0;\n        int degree3 = 0;\n        for (; j + 3 < graph.size(); j += 4) {\n            degree0 += row[j];\n            degree1 += row[j + 1];\n            degree2 += row[j + 2];\n            degree3 += row[j + 3];\n        }\n        int degree = degree0 + degree1 + degree2 + degree3;\n        for (; j < graph.size(); ++j)\n            degree += row[j];\n        degrees[i] = degree;\n    }\n    return degrees;\n}\n\nbool sameDegreeMultiset(const vector<int> &degree1, const vector<int> &degree2) {\n    vector<int> balance(degree1.size() + 1, 0);\n    for (size_t i = 0; i < degree1.size(); ++i) {\n        ++balance[static_cast<size_t>(degree1[i])];\n        --balance[static_cast<size_t>(degree2[i])];\n    }\n    for (size_t degree = 0; degree < balance.size(); ++degree)\n        if (balance[degree] != 0) return false;\n    return true;\n}\n\nbool sameDegreesUnderPermutation(const vector<int> &degree1, const vector<int> &degree2,\n                                 const vector<int> &equivalence) {\n    for (size_t i = 0; i < equivalence.size(); ++i)\n        if (degree1[i] != degree2[static_cast<size_t>(equivalence[i])]) return false;\n    return true;\n}\n\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence) {\n    for (size_t i = 0; i < equivalence.size(); ++i) {\n        const unsigned char *row1 = g1.rowData(i);\n        const unsigned char *row2 = g2.rowData(static_cast<size_t>(equivalence[i]));\n        for (size_t j = 0; j <= i; ++j) {\n            if (row1[j] != row2[static_cast<size_t>(equivalence[j])]) return false;\n        }\n    }\n    return true;\n}\n\ninline void printPermutation(vector<int> &equivalence) {\n    for (auto i : equivalence)\n        cout << i << \" \";\n    cout << endl;\n}\n","path":"src/brute_isomorphism.cpp"}],"hypothesis":"Combining degree-based pruning and unrolled row reductions from the fastest archived candidate with a contiguous row-major byte matrix may improve permutation-validation locality. The flat layout alone measured slower, so the controller should evaluate the combined full program against the best candidate.","notes":"Preserves the identity fast path, Heap traversal and output order, lower-triangle checks, and graph-reading semantics. No commands or tests were run; controller validation is required.","sources_kept":["c2c1b1724d604df9","bf8a766155b443d9","21af0ab22840407b"],"transformations":["Store adjacency bytes in a contiguous row-major matrix and access rows directly during degree computation and permutation validation.","Compute row degrees using four independent accumulation lanes and a scalar remainder loop.","Reject unequal degree multisets and skip permutations that do not preserve mapped vertex degrees."]}
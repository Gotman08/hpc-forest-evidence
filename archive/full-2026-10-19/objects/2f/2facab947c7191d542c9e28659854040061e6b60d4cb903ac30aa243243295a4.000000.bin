set -euo pipefail
[[ ${SLURM_JOB_ID:-} =~ ^[0-9]+$ ]]
test "$(uname -m)" = aarch64
test "${SLURM_CPUS_PER_TASK:-}" = 4
test "${SLURM_NTASKS:-}" = 1
test "${SLURM_JOB_NUM_NODES:-}" = 1
test "${SLURM_MEM_PER_NODE:-}" = 16384
test -z "${SLURM_JOB_GPUS:-}${SLURM_STEP_GPUS:-}"
test "${SLURM_GPUS:-0}" = 0
test "${SLURM_GPUS_ON_NODE:-0}" = 0
test "$(( $(date -u +%s) + 600 + 10800 ))" -lt 1793487600
py=/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python
packet=/scratch_p/nimarano/hpc-forest-r4b-source110-completeQ-r7-20261018-dc64e1360ea8.tar.gz
root=/scratch_p/nimarano/hpc-forest-r4b-source110-completeQ-r7-20261018-dc64e1360ea8
test -x "$py"
test ! -e "$root"
printf '%s  %s\n' 657d17a1050247551e238fb7ba22bdc68c541479b6e18afd7ab0ae6a99488c4a "$packet" | sha256sum -c -
export PYTHONDONTWRITEBYTECODE=1 PYTHONUTF8=1 CUDA_VISIBLE_DEVICES=
srun --ntasks=1 --cpus-per-task=4 --cpu-bind=cores "$py" -I -B -u - "$packet" "$root" 657d17a1050247551e238fb7ba22bdc68c541479b6e18afd7ab0ae6a99488c4a <<'R4B_Q110_BOOTSTRAP'
"""Inline bootstrap for one allocated srun; no scientific work before guard."""
import hashlib
import io
import json
import os
import platform
import re
import runpy
import sys
import tarfile
import time
from pathlib import Path


def need(ok, reason):
    if not ok:
        raise ValueError(reason)


def main():
    need(time.time() + 600 + 10800 < 1793487600, "Deadline plus audit reserve exceeded")
    need(platform.machine().lower() == "aarch64", "ARM64 allocation required")
    need(all(os.environ.get(k) == v for k, v in {
        "SLURM_CPUS_PER_TASK": "4", "SLURM_NTASKS": "1", "SLURM_JOB_NUM_NODES": "1",
        "SLURM_MEM_PER_NODE": "16384"}.items()), "Exact 4CPU/1task/1node/16GiB allocation required")
    need(re.fullmatch(r"[0-9]+", os.environ.get("SLURM_JOB_ID", "")) is not None, "Actual Slurm job required")
    need(not os.environ.get("SLURM_JOB_GPUS", "") and not os.environ.get("SLURM_STEP_GPUS", "")
         and os.environ.get("SLURM_GPUS", "0") == "0"
         and os.environ.get("SLURM_GPUS_ON_NODE", "0") == "0", "Zero GPU required")
    affinity = sorted(os.sched_getaffinity(0))
    need(len(affinity) == 4, "Unique srun must bind exactly four CPUs")
    packet, root = map(Path, sys.argv[1:3])
    expected_packet_sha = sys.argv[3]
    need(root.is_absolute() and not root.exists() and not root.is_symlink(), "Fresh absolute dedicated root required")
    packet_bytes = packet.read_bytes()
    need(len(packet_bytes) <= 64 * 1024 * 1024
         and hashlib.sha256(packet_bytes).hexdigest() == expected_packet_sha,
         "Exact bounded packet bytes required")
    expected = {"qualification-wrapper.py", "bindings.json", "source-bundle.tar.gz",
                "adapter-bundle.tar.gz", "review-payload.tar.gz", "archive_regular_only.py", "packet-manifest.json"}
    with tarfile.open(fileobj=io.BytesIO(packet_bytes), mode="r:gz") as archive:
        members = archive.getmembers()
        need(len(members) == len(expected) and {m.name for m in members} == expected
             and all(m.isfile() and not m.issym() and not m.islnk() for m in members)
             and sum(m.size for m in members) <= 128 * 1024 * 1024,
             "Exact seven regular packet files required")
        root.mkdir(parents=False, exist_ok=False)
        for member in members:
            with (root / member.name).open("xb") as stream:
                stream.write(archive.extractfile(member).read())
    actual = {name: hashlib.sha256((root / name).read_bytes()).hexdigest()
              for name in expected - {"packet-manifest.json"}}
    need(actual == json.loads((root / "packet-manifest.json").read_text(encoding="utf-8")),
         "Exact packet manifest required before wrapper execution")
    with (root / "bootstrap-allocation.json").open("x", encoding="utf-8") as stream:
        json.dump({"observed_at": time.time(), "architecture": "ARM64", "cpu_cores": 4,
                   "tasks": 1, "nodes": 1, "allocated_memory_mib": 16384, "allocated_gpus": 0,
                   "slurm_job_id": os.environ["SLURM_JOB_ID"], "affinity_cpu_ids": affinity,
                   "guard_before_any_extraction": True, "native_model_calls": 0}, stream)
    sys.argv = [str(root / "qualification-wrapper.py"), "--root", str(root)]
    runpy.run_path(str(root / "qualification-wrapper.py"), run_name="__main__")


if __name__ == "__main__":
    main()
R4B_Q110_BOOTSTRAP

        "content": "#include <bits/stdc++.h>\n#include <omp.h>\n\nusing namespace std;\n\nint A[1000][1000];\nint ps[1010][1010];\n\ntypedef long long ll;\n\nstatic inline ll pairs_before(int j, int n) {\n  return 1LL * (j - 1) * (2LL * n - j + 2) / 2;\n}\n\nll count_pair_range(int m, int n, int k, ll begin, ll end) {\n  if (begin >= end)\n    return 0;\n\n  int lo = 1;\n  int hi = n + 1;\n  while (lo + 1 < hi) {\n    int mid = lo + (hi - lo) / 2;\n    if (pairs_before(mid, n) <= begin)\n      lo = mid;\n    else\n      hi = mid;\n  }\n\n  int j = lo;\n  int l = j + static_cast<int>(begin - pairs_before(j, n));\n  unordered_map<ll, ll> h;\n  ll subtotal = 0;\n\n  for (ll pair = begin; pair < end; pair++) {\n    h.clear();\n    h[0] = 1;\n    ll s = 0;\n    for (int i = 1; i <= m; i++) {\n      s += ps[i][l] - ps[i][j - 1];\n      subtotal += h.find(s - k) != h.end() ? h[s - k] : 0;\n      h[s]++;\n    }\n\n    ++l;\n    if (l > n) {\n      ++j;\n      l = j;\n    }\n  }\n  return subtotal;\n}\n\nll solve(int m, int n, int k) {\n  for (int i = 1; i <= m; i++) {\n    for (int j = 1; j <= n; j++) {\n      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\n    }\n  }\n\n  const ll total_pairs = 1LL * n * (n + 1) / 2;\n  const ll work = total_pairs * m;\n  if (work < 20000)\n    return count_pair_range(m, n, k, 0, total_pairs);\n\n  ll ans = 0;\n#pragma omp parallel num_threads(4) reduction(+ : ans)\n  {\n    const int tid = omp_get_thread_num();\n    const int threads = omp_get_num_threads();\n    const ll begin = total_pairs * tid / threads;\n    const ll end = total_pairs * (tid + 1) / threads;\n    ans += count_pair_range(m, n, k, begin, end);\n  }\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n  memset(ps, 0, sizeof ps);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n",
        "path": "src/main.cpp"
      }

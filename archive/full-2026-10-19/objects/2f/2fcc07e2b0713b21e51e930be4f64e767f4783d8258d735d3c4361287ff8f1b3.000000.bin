s[i].label = -1;\\n    }\\n\\n    int filled = 0;\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n        float *xs = g.xs;\\n        float *ys = g.ys;\\n        char label = g.label;\\n        int len = g.length;\\n\\n        for (int j = 0; j < len; j++) {\\n            float d = euclidean_distance_no_sqrt(to_evaluate, \\n                (Point){xs[j], ys[j]});\\n\\n            // Binary search insertion point among first filled entries\\n            int lo = 0, hi = filled;\\n            while (lo < hi) {\\n                int mid = (lo + hi) / 2;\\n                if (entries[mid].dist <= d)\\n                    lo = mid + 1;\\n                else\\n                    hi = mid;\\n            }\\n            int pos = lo; // first index where dist > d, or filled if all <=\\n\\n            if (filled < k) {\\n                memmove(&entries[pos+1], &entries[pos], sizeof(KNNEntry)*(filled - pos));\\n                entries[pos].dist = d;\\n                entries[pos].label = label;\\n                filled++;\\n            } else if (pos < k) { // full and new distance is smaller than some existing\\n                memmove(&entries[pos+1], &entries[pos], sizeof(KNNEntry)*(k - pos - 1));\\n                entries[pos].dist = d;\\n                entries[pos].label = label;\\n            }\\n        }\\n    }\\n\\n    // Frequency counting using histogram (max 256 possible labels)\\n    int freq[256] = {0};\\n    for (int i = 0; i < filled; i++) {\\n        unsigned char uc = (unsigned char)entries[i].label;\\n        freq[uc]++;\\n    }\\n\\n    char most_frequent = -1;\\n    int max_count = 0;\\n    for (int i = 0; i < 256; i++) {\\n        if (freq[i] > max_count) {\\n            max_count = freq[i];\\n            most_frequent = (char)i;\\n        }\\n    }\\n\\n    free(entries);\\n    return most_frequent;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Changing data layout from Array-of-Structs (Point) to Struct-of-Arrays (separate xs and ys arrays per group) improves cache line utilization when computing distances by enabling sequential streaming of coordinates, which can be prefetched efficiently. Using an array-of-structs for the k-nearest neighbors list reduces memory traffic during insertion shifts because all fields are contiguous in memory. Replacing linear scan with binary search + memmove reduces comparisons and data movement. Replacing qsort+scan frequency counting with a direct histogram eliminates sorting overhead entirely.\",\n  \"notes\": \"This experiment combines data layout changes at both group level (SoA for coordinates) and top-k list level (AoS for distance+label), along with algorithmic improvements to insertion (binary search + memmove) and final classification (histogram instead of sort).\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Change Group point storage from Array-of-Structs (Point) to Struct-of-Arrays (float *xs, float *ys)\",\n    \"Replace parallel arrays for nearest neighbors with array of struct KNNEntry\",\n    \"Replace linear insertion scan with binary search and memmove\",\n    \"Replace qsort-based frequency counting with histogram using fixed-size array\"\n  ]\n}",

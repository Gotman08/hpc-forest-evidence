      "content": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <iterator>\n#include <string>\n\nstruct PrintPermutation\n{\n    enum { output_block_size = 64 * 1024 } ;\n\n    std::string line ;\n    std::string pending ;\n\n    auto\n    flush () -> void\n    {\n        if (!pending.empty ()) {\n            std::cout.write (pending.data (), pending.size ()) ;\n            pending.clear () ;\n        }\n    }\n\n    auto\n    write_direct (std::string::iterator first, std::string::iterator last) -> void\n    {\n        std::cout.write (\"[ \", 2) ;\n        while (first != last) {\n            std::cout.put (*first) ;\n            std::cout.put (' ') ;\n            ++ first ;\n        }\n        std::cout.write (\"]\\n\", 2) ;\n    }\n\n    auto\n    operator () (std::string::iterator first, std::string::iterator last) -> void\n    {\n        const std::size_t length = static_cast <std::size_t> (last - first) ;\n\n        if (line.empty ()) {\n            const std::size_t maximum = line.max_size () ;\n            if ((maximum < 4) || (length > ((maximum - 4) / 2))) {\n                flush () ;\n                write_direct (first, last) ;\n                return ;\n            }\n\n            line.assign ((length * 2) + 4, ' ') ;\n            line [0] = '[' ;\n            line [line.size () - 2] = ']' ;\n            line [line.size () - 1] = '\\n' ;\n        }\n\n        if (length != 0) {\n            char * const destination = &line [2] ;\n            char const * const source = &*first ;\n#if defined(_OPENMP) && (_OPENMP >= 201307)\n#pragma omp simd\n#endif\n            for (std::size_t index = 0 ; index < length ; ++ index) {\n                destination [index * 2] = source [index] ;\n            }\n        }\n\n        if (line.size () >= output_block_size) {\n            flush () ;\n            std::cout.write (line.data (), line.size ()) ;\n            return ;\n        }\n\n        if ((pending.size () + line.size ()) > output_block_size) {\n            flush () ;\n        }\n        pending.append (line) ;\n    }\n} ;\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ' )\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v') ;\n    }\n} ;\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase\n        ( std::remove_if\n            ( text.begin ()\n            , text.end ()\n            , IsWhitespace () )\n        , text.end () ) ;\n    return text ;\n}\n\ntemplate <typename Iter> auto\nfind_longest_non_increasing_suffix (Iter first, Iter last) -> Iter\n{\n    if (first == last) return last ;\n    Iter back = std::prev (last) ;\n    if (back == first) return last ;\n    do {\n        -- last ;\n        -- back ;\n    } while ((first != last) && (*back >= *last)) ;\n    return last ;\n}\n\ntemplate <typename Iter> auto\nfind_rightmost_successor (Iter first, Iter second, Iter last) -> Iter\n{\n    if (second == last) return last ;\n    do {\n        -- last ;\n    } while ((second != last) && (*last <= *first)) ;\n    return last ;\n}\n\ntemplate <typename Iter> auto\nnext_permutation (Iter first, Iter last) -> bool\n{\n    if (first == last) return false ;\n    Iter suffix = find_longest_non_increasing_suffix (first, last) ;\n    if (suffix == first) return false ;\n    if (suffix == last)  return false ;\n    Iter pivot = std::prev (suffix) ;\n    Iter successor = find_rightmost_successor (pivot, suffix, last) ;\n    std::iter_swap (pivot, successor) ;\n    std::reverse (suffix, last) ;\n    return true ;\n}\n\ntemplate <typename Iter, typename Function> inline auto\npermutations_iter (Iter first, Iter last, Function& driver) -> void\n{\n    if (first == last) return ;\n    std::sort (first, last) ;\n    do {\n        driver (first, last) ;\n    } while (::next_permutation (first, last)) ;\n    return ;\n}\n\ntemplate <typename String, typename Function> inline auto\npermutations (String text, Function& driver) -> void\n{\n    permutations_iter (std::begin (text), std::end (text), driver) ;\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator <char> begin (in), end ;\n    std::string text (begin, end) ;\n    text = remove_whitespaces (text) ;\n    return text ;\n}\n\nint main (int argc, char const *argv [])\n{\n    std::string text = read_text_from_stdin <std::string> (std::cin) ;\n    PrintPermutation printer ;\n    permutations (text, printer) ;\n    printer.flush () ;\n    return 0 ;\n}\n",
      "path": "src/permutations.cc"
    }
  ],
  "hypothesis": "Reusing the fixed output layout, batching ordered writes, and removing the per-permutation endl flush will reduce serialization overhead; the independent character-slot stores are legally SIMD-annotated on supported OpenMP compilers.",

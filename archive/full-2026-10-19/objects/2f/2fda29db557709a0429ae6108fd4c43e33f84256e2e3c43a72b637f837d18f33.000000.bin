"""Prepared, NOT executed by author. ROOT-only finite metadata fixtures.

Imports receiver definitions only; no receiver.main, source project, census,
binary read, process, RPC, CLI, live state/cache/lock or model invocation.
Exact qualified observer identity/Windows command parsing definitions are loaded
as pure AST by the receiver, without importing its observer module or main.
"""
import copy
import ast
import os
import stat
import tempfile
import argparse
import hashlib
import importlib.util
import json
from pathlib import Path
from subprocess import list2cmdline
import unittest

HERE = Path(__file__).resolve().parent
spec = importlib.util.spec_from_file_location('prepared_R8_pair_receiver', HERE/'recevoir-paire-observateur-R8-reprise-02.py')
receiver = importlib.util.module_from_spec(spec)
spec.loader.exec_module(receiver)


def at(second, fraction='0000000'):
    return f'2026-10-19T00:00:{second:02}.{fraction}Z'


def row(pid, parent, exe, command, second):
    return dict(zip(receiver.FIELDS,(pid,parent,str(Path(exe)),command,at(second))))


def fixture(*, offset=0, contexts=False):
    """Synthetic data only. Never saved as a production receipt or used by main."""
    names=['start_intent','start_observed','startup_census_before','startup_census_after','immediate_before',
           'policy','transition','source_only_absence','observer3_absence','prior_observer_current_absence',
           'routes_initial_copy','external_preparation_review']
    refs={name:{'path':str(receiver.OBS/('fixture-'+name+'.json')),'sha256':'a'*64} for name in names}
    route_source={'path':str(receiver.OBS/'actual-run-policy/ROUTES-OBS4.json'),'sha256':'a'*64}
    expected=[str(receiver.LAUNCHER),'-I','-B','-u',str(receiver.CHAIN/'observer/observer-mixte.py'),
              '--policy',refs['policy']['path'],'--routes',route_source['path'],
              '--transition',refs['transition']['path'],'--run']
    parent=row(900+offset,4,'C:/WINDOWS/System32/WindowsPowerShell/v1.0/powershell.exe','powershell.exe -NoProfile',0)
    launch=row(1000+offset,parent['ProcessId'],receiver.LAUNCHER,list2cmdline(expected),13)
    real=row(1001+offset,launch['ProcessId'],receiver.REAL,launch['CommandLine'],14)
    after=[parent,launch,real]
    if contexts:
        after.extend([
            row(1002+offset,launch['ProcessId'],'C:/WINDOWS/system32/conhost.exe',r'\??\C:\WINDOWS\system32\conhost.exe 0x4',15),
            row(1003+offset,real['ProcessId'],'C:/Users/nicol/romeo-mcp/.venv/Scripts/python.exe',r'C:\Users\nicol\romeo-mcp\.venv\Scripts\python.exe -m romeo_mcp',16),
            row(1004+offset,1003+offset,receiver.REAL,r'C:\Users\nicol\romeo-mcp\.venv\Scripts\python.exe -m romeo_mcp',17)])
    def census(rows, second):
        return {'schema':'hpc-forest-dynamic-r4b-full-cim-v1','observed_at':receiver.ticks(at(second))/10_000_000,
                'captured_at_utc':at(second),'complete_census':True,'strict_utf8_decoding':True,
                'rows_count':len(rows),'rows':copy.deepcopy(rows)}
    routes={'schema':'hpc-forest-r4b-obs4-nine-session-routes-v1','scope_id':receiver.SCOPE,
            'source_zip_sha256':receiver.SOURCE,'plan_sha256':receiver.PLAN,
            'routes':[{'model':m,'phase':p,'session_id':s,'effort':'max','stage':'absent','job_id':None}
                      for m,phases in receiver.SESSIONS.items() for p,s in phases.items()]}
    prior_pairs={subject:[row(7000+i*2,1,'C:/old/python.exe','old-'+subject+'-a',0),
                          row(7001+i*2,7000+i*2,'C:/old/python.exe','old-'+subject+'-b',0)]
                 for i,subject in enumerate(('source-only','observer3'))}
    policy={'schema':'hpc-forest-r4b-obs4-nine-session-policy-v1','verified':True,'scope_id':receiver.SCOPE,
            'source_zip':{'sha256':receiver.SOURCE},'plan':{'sha256':receiver.PLAN},'sessions':receiver.SESSIONS,
            'effort':'max','maximum_native_workers_total':4,'integration_review':{'path':str(receiver.REVIEW),'sha256':receiver.REVIEW_SHA},
            'observer_review':{'path':str(receiver.REVIEW),'sha256':receiver.REVIEW_SHA},'source_only_state':'received_absent',
            'source_only_absence':refs['source_only_absence'],'source_only_full_identities':prior_pairs['source-only'],
            'scientific_admission':False,**{k:False for k in ('submit_allowed','generate_allowed','receive_allowed','stop_allowed','pilots_admitted')}}
    intent={'schema':'hpc-forest-r8-owned-passive-start-intent-v1','created_at_utc':at(12),'argv':expected,
            'observer_sha256':receiver.OBSERVER_SHA,'one_start_only':True,'unknown_outcome_forbids_retry':True,
            'model_generation_admitted':False,'policy':refs['policy'],'routes':route_source,'transition':refs['transition'],
            'initial_full_cim':refs['startup_census_before'],'full_cim':refs['immediate_before'],
            'old_observer_current_absence':refs['prior_observer_current_absence'],
            'external_preparation_review':refs['external_preparation_review']}
    docs={'start_intent':intent,'start_observed':{'schema':'hpc-forest-r8-owned-passive-start-observed-v1',
              'observed_at_utc':at(21),'start_intent':refs['start_intent'],'launcher_pid':launch['ProcessId'],
              'launcher_has_exited':False,'five_fields':copy.deepcopy(after[1:3]),
              'observed_full_pair_independently_verified':False,'native_generation_admitted':False,'source_or_native_workers_started':0},
          'startup_census_before':census([parent],10),'immediate_before':census([parent],11),'startup_census_after':census(after,20),
          'policy':copy.deepcopy(policy),'transition':{'schema':'hpc-forest-r4b-obs4-transition-v1','verified':True,
              'initial_fresh_gate_verified':True,'previous_reader_absence':refs['observer3_absence'],
              'previous_reader_identities':prior_pairs['observer3']},
          'prior_observer_current_absence':{'schema':'hpc-forest-r8-prior-OBS4-closed-current-absence-v1',
              'verified_metadata_only':True,'fresh_full_cim':refs['immediate_before'],
              'all_seven_original_identities_absent':True,'all_eight_R7_original_identities_absent':True,
              'no_unknown_reused_or_ambiguous_R7_descendants':True,'R7_predecessors':{'current_context_absence_verified':True},
              'active_native_workers':0},'routes_initial_copy':routes}
    for subject,name in [('source-only','source_only_absence'),('observer3','observer3_absence')]:
        docs[name]={'schema':'hpc-forest-passive-owned-pair-absence-v1','verified':True,'subject':subject,
                    'no_stop_or_replay':True,'fresh_full_cim':refs['startup_census_before'],'owned_full_identities':prior_pairs[subject],
                    'complete_census_verified':True,'current_freshness_verified':True,
                    'row_level_absence_only_if_census_provenance_unknown':False,'native_generation_admitted':False}
    history={r['model']+':'+r['phase']:{'stage':'absent','cell':{'scope_id':receiver.SCOPE,'source_zip_sha256':receiver.SOURCE,
        'plan_sha256':receiver.PLAN,'model':r['model'],'effort':'max','phase':r['phase'],'session_id':r['session_id'],
        'job_id':None,'remote_root':'/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-'+r['session_id']},
        'allocation_binding':{},'worker_binding':{},'terminal_binding':{}} for r in routes['routes']}
    docs['cold_state']={'schema':'hpc-forest-r4b-passive-state-v1','scientific_admission':False,'transition_verified':True,
        'passive_only':True,'policy_sha256':refs['policy']['sha256'],'stage':'observing','routes_history':history,
        'observer_full_identities':copy.deepcopy([launch,real]),'observations':{'751592':{'polled':False},'752306':{'polled':False}},
        'active_native_workers':0,'updated_at':receiver.ticks(at(25))/10_000_000}
    return docs,refs,receiver.ticks(at(30))


class PairReceiverNeutral(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        source=(receiver.CHAIN/'observer/observer-mixte.py').read_bytes()
        cls.api=receiver.observer_api(source)
        context=json.loads(receiver.CONTEXT_SOURCE.read_bytes())
        if receiver.sha(receiver.CONTEXT_SOURCE.read_bytes())!=receiver.CONTEXT_SHA:
            raise ValueError('Pinned historical template changed')
        cls.templates=receiver.context_templates(context,cls.api)

    def validate(self,docs,refs,now,hashes=None):
        return receiver.validate_startup(docs,refs,self.api,self.templates,dict(receiver.EXE_PINS) if hashes is None else hashes,now_ticks=now)

    def refused(self,change):
        docs,refs,now=fixture();change(docs,refs)
        with self.assertRaises(ValueError):self.validate(docs,refs,now)

    def test_two_distinct_dynamic_pairs_are_passive_observers(self):
        for offset in (0,700):
            with self.subTest(offset=offset):
                docs,refs,now=fixture(offset=offset);pair,context=self.validate(docs,refs,now)
                self.assertEqual([r['ProcessId'] for r in pair],[1000+offset,1001+offset])
                self.assertEqual([r['role'] for r in context],['observer-launcher','observer-main'])

    def test_observed_MCP_and_console_context_has_complete_lineage(self):
        docs,refs,now=fixture(contexts=True);pair,context=self.validate(docs,refs,now)
        self.assertEqual(len(pair),2);self.assertEqual(len(context),5)
        self.assertEqual({r['role'] for r in context},{'observer-launcher','observer-main','conhost','mcp-launcher','mcp-main'})
        extra=copy.deepcopy(docs['startup_census_after']['rows'][4]);extra['ProcessId']=1999
        docs['startup_census_after']['rows'].append(extra);docs['startup_census_after']['rows_count']+=1
        with self.assertRaises(ValueError):self.validate(docs,refs,now)

    def test_wrong_executable_hash_refused(self):
        docs,refs,now=fixture();hashes=dict(receiver.EXE_PINS);hashes[str(receiver.REAL)]='0'*64
        with self.assertRaises(ValueError):self.validate(docs,refs,now,hashes)

    def test_wrong_main_executable_refused(self):
        self.refused(lambda d,r:d['startup_census_after']['rows'][2].update(ExecutablePath='C:/foreign/python.exe'))

    def test_wrong_main_parent_refused(self):
        self.refused(lambda d,r:d['startup_census_after']['rows'][2].update(ParentProcessId=999))

    def test_second_plausible_main_refused(self):
        def change(d,r):
            other=copy.deepcopy(d['startup_census_after']['rows'][2]);other['ProcessId']=1999
            d['startup_census_after']['rows'].append(other);d['startup_census_after']['rows_count']+=1
        self.refused(change)

    def test_duplicate_run_refused(self):
        self.refused(lambda d,r:d['start_intent']['argv'].append('--run'))

    def test_raw_creation_last_100ns_difference_refused(self):
        self.refused(lambda d,r:d['start_observed']['five_fields'][1].update(CreationDate=at(14,'0000001')))

    def test_creation_before_intent_refused(self):
        self.refused(lambda d,r:d['start_intent'].update(created_at_utc=at(15)))

    def test_stale_census_refused(self):
        docs,refs,now=fixture()
        with self.assertRaises(ValueError):self.validate(docs,refs,now+121*10_000_000)

    def test_duplicate_census_pid_refused(self):
        def change(d,r):
            d['startup_census_after']['rows'].append(copy.deepcopy(d['startup_census_after']['rows'][2]));d['startup_census_after']['rows_count']+=1
        self.refused(change)

    def test_reused_pid_in_prestart_refused(self):
        def change(d,r):
            old=copy.deepcopy(d['startup_census_after']['rows'][2]);old.update(CreationDate=at(1),CommandLine='other old process')
            d['startup_census_before']['rows'].append(old);d['startup_census_before']['rows_count']+=1
        self.refused(change)

    def test_unknown_descendant_refused_without_adoption(self):
        def change(d,r):
            d['startup_census_after']['rows'].append(row(1999,1001,'C:/foreign/program.exe','foreign program',16));d['startup_census_after']['rows_count']+=1
        self.refused(change)

    def test_INERT_start_rejected(self):
        self.refused(lambda d,r:d['start_observed'].update(fixture_only=True))

    def test_old_policy_plan_refused(self):
        self.refused(lambda d,r:d['policy']['plan'].update(sha256='5c3cc0082589257897caf79caf90c678f931eefcecb823f315ef614f72b9de70'))

    def test_missing_R7_context_absence_refused(self):
        self.refused(lambda d,r:d['prior_observer_current_absence'].pop('all_eight_R7_original_identities_absent'))

    def test_state_pair_mismatch_refused(self):
        self.refused(lambda d,r:d['cold_state']['observer_full_identities'][1].update(ProcessId=1999))

    def test_wrong_state_policy_hash_refused(self):
        self.refused(lambda d,r:d['cold_state'].update(policy_sha256='0'*64))

    def test_state_pending_or_error_not_initial_absence(self):
        self.refused(lambda d,r:d['cold_state']['routes_history']['gpt-6.1-sol:roots'].update(stage='allocated_pending'))

    def test_initial_routes_SHA_not_replaced_by_mutable_current(self):
        self.refused(lambda d,r:r['routes_initial_copy'].update(sha256='0'*64))

    def test_bool_worker_count_not_integer_zero(self):
        self.refused(lambda d,r:d['cold_state'].update(active_native_workers=False))


class ColdCopyBoundaryNeutral(unittest.TestCase):
    """Real tiny new files/handles only; no mocked content-reader or live data."""
    @classmethod
    def setUpClass(cls):
        raw=receiver.PHASE1.read_bytes()
        if receiver.sha(raw)!=receiver.PHASE1_SHA:
            raise ValueError('Exact ordinary-path source required')
        nodes=[n for n in ast.parse(raw).body if isinstance(n,ast.FunctionDef) and n.name in {'need','ordinary_path'}]
        if {n.name for n in nodes}!={'need','ordinary_path'}:
            raise ValueError('Exact ordinary-path definitions missing')
        namespace={'Path':Path,'stat':stat,'BASE':receiver.BASE}
        exec(compile(ast.Module(body=nodes,type_ignores=[]),'<qualified-ordinary-path-only>','exec'),namespace)
        cls.ordinary=staticmethod(namespace['ordinary_path'])

    def setUp(self):
        if os.name!='nt':
            raise ValueError('Real Windows native FileID tests required; no skip/fallback')
        self.temp=tempfile.TemporaryDirectory(prefix='ROOT-INERT-copy-boundary-',dir=HERE)
        self.addCleanup(self.temp.cleanup)
        self.boundary=Path(self.temp.name)
        self.sources=self.boundary/'sources';self.sources.mkdir()
        self.copies=self.boundary/'cold-copies';self.copies.mkdir()
        self.specs=[]
        for label,name in [('routes','ROUTES-OBS4.json'),('state','observer-state.json'),('stdout.log','stdout.log'),('stderr.log','stderr.log')]:
            source=self.sources/name;source.write_bytes(b'')
            target=self.copies/('cold-'+name+'.txt');target.write_bytes(b'')
            self.specs.append({'label':label,'source':source,'copy':target})

    def lease(self, *, payload_api=None):
        return receiver.HeldDistinctColdCopies(self.specs,self.ordinary,payload_api=payload_api,source_boundary=self.boundary,copy_boundary=self.boundary)

    def test_equal_source_log_path_refuses_before_payload(self):
        self.specs[2]['copy']=self.specs[2]['source']
        held=self.lease()
        with self.assertRaises(ValueError):
            with held:self.fail('Payload-read stage must be unreachable')
        self.assertFalse(any(e['operation']=='ReOpenFile_GR_attempt' for e in held.events))

    def test_equal_routes_path_refuses_before_payload(self):
        self.specs[0]['copy']=self.specs[0]['source']
        held=self.lease()
        with self.assertRaises(ValueError):
            with held:self.fail('Payload-read stage must be unreachable')
        self.assertFalse(any(e['operation']=='ReOpenFile_GR_attempt' for e in held.events))

    def test_equal_state_path_refuses_before_payload(self):
        self.specs[1]['copy']=self.specs[1]['source']
        held=self.lease()
        with self.assertRaises(ValueError):
            with held:self.fail('Payload-read stage must be unreachable')
        self.assertFalse(any(e['operation']=='ReOpenFile_GR_attempt' for e in held.events))

    def test_windows_active_basename_aliases_refuse_before_metadata(self):
        for name in ('STDOUT.LOG','StDeRr.LoG','OBSERVER.LOCK','WORKER.LOCK','ROUTES-OBS4.JSON','OBSERVER-STATE.JSON','stdout.log.','worker.lock '):
            with self.subTest(name=name),self.assertRaises(ValueError):
                receiver.cold_copy_name(self.copies/name)

    def test_hardlink_to_source_refuses_before_payload(self):
        target=self.specs[2]['copy'];target.unlink();os.link(self.specs[2]['source'],target)
        held=self.lease()
        with self.assertRaises(ValueError):
            with held:self.fail('Hardlink payload-read stage must be unreachable')
        self.assertFalse(any(e['operation']=='ReOpenFile_GR_attempt' for e in held.events))

    def test_two_copy_roles_same_file_refuse_before_payload(self):
        self.specs[3]['copy']=self.specs[2]['copy']
        held=self.lease()
        with self.assertRaises(ValueError):
            with held:self.fail('Aliased payload-read stage must be unreachable')
        self.assertFalse(any(e['operation']=='ReOpenFile_GR_attempt' for e in held.events))

    def test_distinct_files_remain_held_and_metadata_stable(self):
        with self.lease() as held:
            facts=held.evidence()
            self.assertIs(facts['metadata_source_bytes_read'],False)
            self.assertEqual(facts['source_and_copy_native_metadata_before'],facts['source_and_copy_native_metadata_after'])
            self.assertEqual(len({(x['volume_serial'],x['file_id128']) for x in held.before}),8)

    def test_live_source_writer_handle_is_metadata_only(self):
        with self.specs[2]['source'].open('ab'):
            with self.lease() as held:
                self.assertIs(held.evidence()['source_metadata_only'],True)

    def test_copy_write_is_denied_while_held(self):
        with self.lease() as held:
            with self.assertRaises(PermissionError):
                with self.specs[2]['copy'].open('ab') as stream:stream.write(b'INERT')
            held.verify_unchanged()

    def test_source_atomic_replace_allowed_but_detected(self):
        replacement=self.sources/'replacement-source.json'
        replacement.write_bytes(b'INERT replacement')
        with self.lease() as held:
            os.replace(replacement,self.specs[2]['source'])
            self.assertFalse(replacement.exists())
            with self.assertRaises(ValueError):held.verify_unchanged()

    def test_source_append_allowed_but_detected(self):
        with self.lease() as held:
            with self.specs[2]['source'].open('ab') as stream:stream.write(b'INERT source update')
            with self.assertRaises(ValueError):held.verify_unchanged()

    def test_source_parent_rename_allowed_but_detected(self):
        moved=self.boundary/'moved-source-directory'
        with self.lease() as held:
            os.replace(self.sources,moved)
            self.assertTrue(moved.is_dir())
            with self.assertRaises(ValueError):held.verify_unchanged()

    def test_copy_delete_is_denied_while_held(self):
        with self.lease() as held:
            with self.assertRaises(PermissionError):self.specs[2]['copy'].unlink()
            held.verify_unchanged()

    def test_guarded_payload_refuses_source_change_before_first_byte(self):
        with self.lease() as held:
            calls=[]
            def payload(path):
                calls.append(path)
                return Path(path).read_bytes()
            read=held.guarded_reader(payload)
            self.specs[2]['source'].write_bytes(b'INERT mutation before payload')
            with self.assertRaises(ValueError):read(self.specs[2]['copy'])
            self.assertEqual(calls,[])

    def test_guarded_payload_refuses_source_change_after_real_read(self):
        with self.lease() as held:
            calls=[]
            def payload_then_change_source(path):
                value=Path(path).read_bytes()
                calls.append(path)
                self.specs[2]['source'].write_bytes(b'INERT mutation after payload')
                return value
            read=held.guarded_reader(payload_then_change_source)
            with self.assertRaises(ValueError):read(self.specs[2]['copy'])
            self.assertEqual(len(calls),1)

    def test_guarded_payload_checks_sources_even_when_reader_raises(self):
        with self.lease() as held:
            def failing_payload(path):
                Path(path).read_bytes()
                self.specs[2]['source'].write_bytes(b'INERT mutation during failed payload')
                raise OSError('INERT reader failure')
            read=held.guarded_reader(failing_payload)
            with self.assertRaises(ValueError):read(self.specs[2]['copy'])

    def test_local_payload_namespace_restored_after_exception(self):
        def original(path):
            return Path(path).read_bytes()
        api={'raw':original}
        with self.assertRaisesRegex(RuntimeError,'INERT scoped failure'):
            with self.lease(payload_api=api):
                self.assertIsNot(api['raw'],original)
                self.assertEqual(api['raw'](self.specs[2]['copy']),b'')
                raise RuntimeError('INERT scoped failure')
        self.assertIs(api['raw'],original)


    def test_all_eight_metadata_objects_precede_every_GR_attempt(self):
        with self.lease() as held:
            operations=[e['operation'] for e in held.events]
            gate=operations.index('all_eight_preidentified')
            before=held.events[:gate]
            metadata=[e for e in before if e['operation']=='metadata_open_attempt']
            self.assertEqual(len(metadata),8)
            self.assertTrue(all(e['access']==0x80 and e['sharing']==0x7 for e in metadata))
            attempts=[i for i,op in enumerate(operations) if op=='ReOpenFile_GR_attempt']
            self.assertEqual(len(attempts),4)
            self.assertTrue(all(i>gate for i in attempts))
            self.assertTrue(all(e['access']==0x80000000 and e['sharing']==0x1 for e in held.events if e['operation']=='ReOpenFile_GR_attempt'))
            self.assertEqual(operations.count('ReOpenFile_GR_validated'),4)
            self.assertLess(max(attempts),operations.index('payload_barrier_ready'))

    def test_last_copy_hardlink_refuses_before_any_GR_attempt(self):
        target=self.specs[3]['copy'];target.unlink();os.link(self.specs[3]['source'],target)
        held=self.lease()
        with self.assertRaises(ValueError):
            with held:self.fail('Last invalid copy must prevent all read-capability opens')
        self.assertFalse(any(e['operation']=='ReOpenFile_GR_attempt' for e in held.events))


    def test_only_four_copy_read_handles_survive_entry(self):
        with self.lease() as held:
            self.assertEqual(len(held.copy_read_handles),4)
            self.assertEqual(held.metadata_copy_handles,[])
            self.assertEqual(held.transient_handles,set())
            facts=held.evidence()
            self.assertEqual(facts['source_handles_retained_between_checkpoints'],0)
            self.assertEqual(facts['parent_handles_retained_between_checkpoints'],0)
            self.assertIs(facts['continuous_source_or_parent_stability_proved'],False)
            self.assertIs(facts['absence_of_source_or_parent_ABA_proved'],False)
            operations=held.events
            first_GR=next(i for i,e in enumerate(operations) if e['operation']=='ReOpenFile_GR_attempt')
            source_closes=[e for e in operations[:first_GR] if e['operation']=='metadata_snapshot_closed'
                           and e.get('role')=='source' and e.get('initial') is True]
            self.assertEqual(len(source_closes),4)
            self.assertTrue(all(e.get('source_parent_handles_retained')==0 for e in operations
                                if e['operation'] in {'ReOpenFile_GR_attempt','payload_barrier_ready'}))

    def test_guarded_payload_detects_parent_replace_even_on_reader_exception(self):
        moved=self.boundary/'moved-during-payload'
        with self.lease() as held:
            def payload_then_move_parent(path):
                Path(path).read_bytes()
                os.replace(self.sources,moved)
                raise OSError('INERT reader failure after allowed source-parent move')
            with self.assertRaises(ValueError):held.guarded_reader(payload_then_move_parent)(self.specs[2]['copy'])
        self.assertTrue(moved.is_dir())
        self.assertEqual(held.copy_read_handles,[])
        self.assertEqual(held.metadata_copy_handles,[])
        self.assertEqual(held.transient_handles,set())

    def test_alias_entry_failure_leaves_no_source_parent_or_copy_handle(self):
        self.specs[3]['copy']=self.specs[2]['copy']
        held=self.lease()
        with self.assertRaises(ValueError):
            with held:self.fail('Duplicate copy identity must fail before payload')
        self.assertEqual(held.copy_read_handles,[])
        self.assertEqual(held.metadata_copy_handles,[])
        self.assertEqual(held.transient_handles,set())
        self.assertFalse(any(e['operation']=='ReOpenFile_GR_attempt' for e in held.events))



class ResumedLifecycleBindings(unittest.TestCase):
    def fixture(self):
        refs={'start_intent':{'path':str(receiver.OBS/'INTENTION-UNIQUE-OBS4-R8-REPRISE-02.json'),'sha256':'a'*64},
              'start_observed':{'path':str(receiver.OBS/'execution-root-02/LANCEMENT-OBSERVE.json'),'sha256':'b'*64}}
        names=('previous_R8_closure','previous_R8_closure_review','previous_R8_runtime_archive',
               'previous_sequence_terminal','lifecycle_preparation_review','lifecycle_neutral_completion')
        intent={name:{'path':str(receiver.OP/('INERT-'+name+'.json')),'sha256':'c'*64} for name in names}
        prior={'previous_R8_lifecycle':{'closure':intent['previous_R8_closure'],
                'independent_actual_closure_review':intent['previous_R8_closure_review'],
                'all_six_original_identities_absent':True,'no_reused_or_ambiguous_context':True,
                'fresh_full_cim':{'path':'INERT-census.json','sha256':'d'*64}},
               'fresh_full_cim':{'path':'INERT-census.json','sha256':'d'*64},
               'previous_R8_runtime_archive':intent['previous_R8_runtime_archive'],
               'new_start_intent_name':'INTENTION-UNIQUE-OBS4-R8-REPRISE-02.json'}
        return intent,refs,prior
    def test_44_new_binding_positive_pure_data(self): receiver.resumed_binding(*self.fixture())
    def test_45_consumed_first_intent_refused(self):
        intent,refs,prior=self.fixture();refs['start_intent']['path']=str(receiver.OBS/'INTENTION-UNIQUE-OBS4-R8.json')
        with self.assertRaises(ValueError):receiver.resumed_binding(intent,refs,prior)
    def test_46_missing_closure_or_archive_refused(self):
        intent,refs,prior=self.fixture();intent['previous_R8_runtime_archive']=None
        with self.assertRaises(ValueError):receiver.resumed_binding(intent,refs,prior)
    def test_47_previous_context_not_absent_refused(self):
        intent,refs,prior=self.fixture();prior['previous_R8_lifecycle']['all_six_original_identities_absent']=False
        with self.assertRaises(ValueError):receiver.resumed_binding(intent,refs,prior)

if __name__=='__main__':
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--receipt',type=Path,required=True)
    args=parser.parse_args()
    path=args.receipt
    if not path.is_absolute() or path.parent!=HERE or path.exists() or '..' in path.parts:
        raise ValueError('New direct neutral ROOT receipt only')
    for parent in (path.parent,*path.parent.parents):
        facts=parent.lstat()
        if parent.is_symlink() or getattr(facts,'st_file_attributes',0)&1024:
            raise ValueError('Receipt ancestor reparse refused')
    observer_path=receiver.CHAIN/'observer/observer-mixte.py'
    before=hashlib.sha256(observer_path.read_bytes()).hexdigest()
    source_before={p:hashlib.sha256(p.read_bytes()).hexdigest() for p in (Path(__file__),HERE/'recevoir-paire-observateur-R8-reprise-02.py')}
    suite=unittest.TestSuite([unittest.defaultTestLoader.loadTestsFromTestCase(PairReceiverNeutral),unittest.defaultTestLoader.loadTestsFromTestCase(ColdCopyBoundaryNeutral),unittest.defaultTestLoader.loadTestsFromTestCase(ResumedLifecycleBindings)])
    result=unittest.TextTestRunner(verbosity=2).run(suite)
    after=hashlib.sha256(observer_path.read_bytes()).hexdigest()
    source_after={p:hashlib.sha256(p.read_bytes()).hexdigest() for p in source_before}
    ok=result.wasSuccessful() and result.testsRun==47 and before==after==receiver.OBSERVER_SHA and source_before==source_after
    record={'schema':'hpc-forest-r8-dynamic-pair-neutral-test-completion-v1',
        'receiver_sha256':hashlib.sha256((HERE/'recevoir-paire-observateur-R8-reprise-02.py').read_bytes()).hexdigest(),
        'test_source_sha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        'tests_run':result.testsRun,'failures':len(result.failures),'errors':len(result.errors),'skipped':len(result.skipped),
        'exit_code':0 if ok else 1,'source_observer_before_after_equal':before==after==receiver.OBSERVER_SHA,
        'receiver_and_test_before_after_equal':source_before==source_after,
        'receiver_main_executed':False,'fixture_results_are_live_observation':False,'model_or_CIM_or_RPC_or_process_effects':0}
    with path.open('x',encoding='utf8',newline='\n') as stream:
        json.dump(record,stream,indent=2);stream.write('\n')
    raise SystemExit(record['exit_code'])

/*
    This program solves Laplace's equation on a regular 2D grid using simple Jacobi iteration.

    The stencil calculation stops at convergence or the iteration limit.
*/
#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <sys/time.h>

#define CONV_THRESHOLD 1.0e-5f // threshold of convergence

// matrix to be solved
double **grid;

// auxiliary matrix
double **new_grid;

static double *grid_storage;
static double *new_grid_storage;

// size of each side of the grid
int size;
int iter_max_num;

// return the absolute value of a number
double absolute(double num){
    if(num < 0)
        return -1.0 * num;
    return num;
}

// allocate contiguous storage with row-pointer views
void allocate_memory(){
    size_t n = (size_t)size;
    grid = (double **) malloc(n * sizeof(double *));
    new_grid = (double **) malloc(n * sizeof(double *));
    grid_storage = (double *) malloc(n * n * sizeof(double));
    new_grid_storage = (double *) malloc(n * n * sizeof(double));

    for(int i = 0; i < size; i++){
        grid[i] = grid_storage + (size_t)i * n;
        new_grid[i] = new_grid_storage + (size_t)i * n;
    }
}

// initialize the grid
void initialize_grid(){
    int center = size / 2;
    int linf = center - (size / 10);
    int lsup = center + (size / 10);
    for (int i = 0; i < size; i++){
        for (int j = 0; j < size; j++){
            // inicializa região de calor no centro do grid
            if ( i >= linf && i <= lsup && j >= linf && j <= lsup)
                grid[i][j] = 100;
            else
                grid[i][j] = 0;
            // Both time levels must retain the original fixed boundaries.
            new_grid[i][j] = grid[i][j];
        }
    }
}

// save the grid in a file
void save_grid(){
    for(int i = 0; i < size; i++){
        for(int j = 0; j < size; j++){
            fprintf(stdout, "%lf ", grid[i][j]);
        }
        fprintf(stdout, "\n");
    }
}

static inline int update_row(double *restrict destination,
                             const double *restrict above,
                             const double *restrict current,
                             const double *restrict below){
    int changed = 0;
    for(int j = 1; j < size - 1; j++){
        double value = 0.25 * (current[j+1] + current[j-1] +
                               above[j] + below[j]);
        destination[j] = value;
        double errorCurrent = absolute(value - current[j]);
        changed |= (errorCurrent > CONV_THRESHOLD);
    }
    return changed;
}

int main(int argc, char *argv[]){
    fscanf(stdin, "%d", &size);
    fscanf(stdin, "%d", &iter_max_num);

    int hasError = 1;
    int iter = 0;

    // allocate memory to the grid (matrix)
    allocate_memory();

    // set grid initial conditions
    initialize_grid();

    while(hasError && iter < iter_max_num){
        if(iter_max_num - iter == 1){
            // An unpaired final iteration uses the auxiliary time level.
            hasError = 0;
            for(int i = 1; i < size - 1; i++){
                hasError |= update_row(new_grid[i], grid[i-1],
                                       grid[i], grid[i+1]);
            }
            double **temporary = grid;
            grid = new_grid;
            new_grid = temporary;
            iter++;
        }else{
            int firstError = 0;
            int secondError = 0;

            // Pipeline two sweeps, keeping the second one a row behind.
            // After first-step row i is complete, original row i-1 is
            // no longer needed and can hold its second-step result.
            for(int i = 1; i < size - 1; i++){
                firstError |= update_row(new_grid[i], grid[i-1],
                                         grid[i], grid[i+1]);
                if(i > 1){
                    secondError |= update_row(grid[i-1], new_grid[i-2],
                                              new_grid[i-1], new_grid[i]);
                }
            }
            if(size > 2){
                secondError |= update_row(grid[size-2], new_grid[size-3],
                                          new_grid[size-2], new_grid[size-1]);
            }

            iter++;
            if(!firstError){
                // Discard the speculative second step if the first converged.
                double **temporary = grid;
                grid = new_grid;
                new_grid = temporary;
                hasError = 0;
            }else{
                iter++;
                hasError = secondError;
            }
        }
    }

    //save the final grid in file
    save_grid();

    free(grid_storage);
    free(new_grid_storage);
    free(grid);
    free(new_grid);
    return 0;
}

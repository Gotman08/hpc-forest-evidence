        "content": "#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    cin >> n >> m;\n\n    vector<vector<int>> blockedColumns(n);\n    for (int c = 0; c < m; ++c) {\n        int y, x;\n        cin >> y >> x;\n        blockedColumns[y].push_back(x);\n    }\n    for (auto& columns : blockedColumns) {\n        sort(columns.begin(), columns.end());\n    }\n\n    vector<int> dp(n, 0);\n    if (blockedColumns[0].empty() || blockedColumns[0][0] != 0) {\n        dp[0] = 1;\n    }\n\n    size_t obstacleIndex = 0;\n    for (int y = 0; y < n; ++y) {\n        const auto& columns = blockedColumns[y];\n        obstacleIndex = 0;\n        for (int x = 0; x < n; ++x) {\n            bool blocked = obstacleIndex < columns.size() && columns[obstacleIndex] == x;\n            if (blocked) {\n                ++obstacleIndex;\n                dp[x] = 0;\n            } else if (y == 0) {\n                if (x > 0) dp[x] = dp[x - 1];\n            } else if (x > 0) {\n                dp[x] = (dp[x] + dp[x - 1]) % MOD;\n            }\n        }\n    }\n\n    cout << dp[n - 1] << '\\n';\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }
    ],

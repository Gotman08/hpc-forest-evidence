      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nstatic inline unsigned char key_byte(const char *strings, long int record,\n                                     int stride, int digit) {\n   return (unsigned char)strings[(size_t)record * (size_t)stride +\n                                 (size_t)digit];\n}\n\nstatic void radix_sort_indices(const char * restrict strings, int length,\n                               long int size, long int * restrict order,\n                               long int * restrict workspace,\n                               size_t * restrict histogram,\n                               size_t * restrict positions,\n                               int worker_slots) {\n#pragma omp parallel num_threads(worker_slots)\n   {\n#ifdef _OPENMP\n      const int thread_id = omp_get_thread_num();\n      const int thread_count = omp_get_num_threads();\n#else\n      const int thread_id = 0;\n      const int thread_count = 1;\n#endif\n      const long int begin = size / thread_count * thread_id +\n                             size % thread_count * thread_id / thread_count;\n      const long int end = size / thread_count * (thread_id + 1) +\n                           size % thread_count * (thread_id + 1) / thread_count;\n      size_t *local_histogram = histogram + (size_t)thread_id * 256U;\n      size_t *local_positions = positions + (size_t)thread_id * 256U;\n\n      for (int digit = length - 2; digit >= 0; --digit) {\n         const int pass = length - 2 - digit;\n         const long int *input = (pass & 1) != 0 ? workspace : order;\n         long int *output = (pass & 1) != 0 ? order : workspace;\n\n#pragma omp simd\n         for (int value = 0; value < 256; ++value)\n            local_histogram[value] = 0;\n\n         for (long int i = begin; i < end; ++i)\n            ++local_histogram[key_byte(strings, input[i], length, digit)];\n\n#pragma omp barrier\n#pragma omp single\n         {\n            size_t next = 0;\n\n            for (int value = 0; value < 256; ++value) {\n               for (int thread = 0; thread < thread_count; ++thread) {\n                  const size_t position = (size_t)thread * 256U +\n                                          (size_t)value;\n                  positions[position] = next;\n                  next += histogram[position];\n               }\n            }\n         }\n\n         for (long int i = begin; i < end; ++i) {\n            const long int record = input[i];\n            const unsigned char value = key_byte(strings, record, length, digit);\n            output[local_positions[value]++] = record;\n         }\n\n         if (digit != 0) {\n#pragma omp barrier\n         }\n      }\n   }\n\n   if (((length - 1) & 1) != 0)\n      memcpy(order, workspace, (size_t)size * sizeof(*order));\n}\n\nlong int *bucket_sort(char *strings, int length, long int size,\n                      int offset, int nbuckets) {\n   long int *order;\n   long int *workspace;\n   size_t *histogram;\n   size_t *positions;\n   int worker_slots = 1;\n\n   (void)offset;\n   (void)nbuckets;\n\n   order = (long int *)malloc((size_t)size * sizeof(*order));\n\n#pragma omp simd\n   for (long int i = 0; i < size; ++i)\n      order[i] = i;\n\n   if (size < 2 || length < 2)\n      return order;\n\n#ifdef _OPENMP\n   worker_slots = omp_get_max_threads();\n#endif\n   if (worker_slots < 1)\n      worker_slots = 1;\n   if ((long int)worker_slots > size)\n      worker_slots = (int)size;\n\n   workspace = (long int *)malloc((size_t)size * sizeof(*workspace));\n   histogram = (size_t *)malloc((size_t)worker_slots * 256U *\n                                sizeof(*histogram));\n   positions = (size_t *)malloc((size_t)worker_slots * 256U *\n                               sizeof(*positions));\n\n   radix_sort_indices(strings, length, size, order, workspace, histogram,\n                      positions, worker_slots);\n\n   free(positions);\n   free(histogram);\n   free(workspace);\n   return order;\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb) {\n   char *strings = NULL;\n   int len, offset, nbucket;\n   long int n;\n\n   if (fscanf(stdin, \"%d\", &len) != 1) {\n      printf(\"ERROR len\\n\");\n      exit(1);\n   }\n\n   if (fscanf(stdin, \"%ld\", &n) != 1) {\n      printf(\"ERROR n\\n\");\n      exit(1);\n   }\n\n   if (fscanf(stdin, \"%d\", &offset) != 1) {\n      printf(\"ERROR offset\\n\");\n      exit(1);\n   }\n\n   if (fscanf(stdin, \"%d\", &nbucket) != 1) {\n      printf(\"ERROR nbucket\\n\");\n      exit(1);\n   }\n\n   nbucket = nbucket + 1;\n   len = len + 1;\n   strings = (char *)calloc((size_t)n, (size_t)len);\n\n   for (long int i = 0; i < n; ++i) {\n      if (fscanf(stdin, \"%s\", strings + (size_t)i * (size_t)len) != 1) {\n         printf(\"ERROR %ld\\n\", i);\n         exit(1);\n      }\n   }\n\n   *vString = strings;\n   *N = n;\n   *l = len;\n   *os = offset;\n   *nb = nbucket;\n}\n\nvoid save(const char *strings, const long int *index, long int n, int len) {\n   for (long int i = 0; i < n; ++i)\n      printf(\"%s\\n\", strings + (size_t)index[i] * (size_t)len);\n}\n\nint main(int ac, char **av) {\n   char *strings = NULL;\n   long int N = 0;\n   long int *index = NULL;\n   int len = 0;\n   int offset;\n   int nbuckets;\n\n   (void)ac;\n   (void)av;\n\n   load(&strings, &N, &len, &offset, &nbuckets);\n   index = bucket_sort(strings, len, N, offset, nbuckets);\n   save(strings, index, N, len);\n\n   free(strings);\n   free(index);\n   return EXIT_SUCCESS;\n}\n",
      "path": "src/bucketsort.c"
    }
  ],
  "hypothesis": "Keeping all LSD radix passes in one OpenMP team and selecting ping-pong buffers by pass parity removes repeated parallel-region creation and pointer-handoff synchronization. SIMD is asserted only for independent contiguous initialization, while dependent histogram and scatter updates remain scalar and stable.",
  "notes": "The explicit num_threads clause also keeps per-thread histogram storage valid when the record count is smaller than the OpenMP maximum thread count.",
  "sources_kept": [],

      "content": "/*\n  Quicksort\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <limits.h>\n#include <openssl/md5.h>\n\n#define MY_RAND_MAX 0x7FFFFFFF\n#define RANDNUM_W 521288629\n#define RANDNUM_Z 362436069\n#define INSERTION_SORT_CUTOFF 32\n#define PARALLEL_THRESHOLD 65536\n#define TASK_GRAIN 16384\n\nvoid srandnum(int seed);\ndouble randnum(void);\nint *generate_case(int N);\ndouble drand(int xmin, int xmax);\nvoid swap(int *toorder, int i, int j);\nvoid quicksort(int *toorder, int N);\nint is_sorted(int *toorder, int N);\n\nstatic int median_of_three(int a, int b, int c);\nstatic int partition(int *toorder, int lo, int hi);\nstatic void insertion_sort(int *toorder, int lo, int hi);\nstatic void sift_down(int *toorder, int lo, int root, int count);\nstatic void heapsort(int *toorder, int lo, int hi);\nstatic int depth_limit(int n);\nstatic void introsort_serial(int *toorder, int lo, int hi, int depth);\nstatic void introsort_parallel(int *toorder, int lo, int hi, int depth);\n\nunsigned int randum_w = RANDNUM_W;\nunsigned int randum_z = RANDNUM_Z;\n\nvoid srandnum(int seed)\n{\n    unsigned int w, z;\n    w = (seed * 104623) & 0xffffffff;\n    randum_w = (w) ? w : RANDNUM_W;\n    z = (seed * 48947) & 0xffffffff;\n    randum_z = (z) ? z : RANDNUM_Z;\n}\n\ndouble randnum(void)\n{\n    unsigned int u;\n    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);\n    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);\n    u = (randum_z << 16) + randum_w;\n    return (abs(u));\n}\n\nint main(int argc, char *argv[])\n{\n    int N = 0;\n    int *our_list = NULL;\n\n    scanf(\"%d\", &N);\n    if (N <= 0) {\n        printf(\"Error: please, provide the case size.\\n\");\n        return 1;\n    }\n\n    our_list = generate_case(N);\n    if (our_list == NULL) {\n        printf(\"Error: case instantiation failed.\\n\");\n        return 1;\n    }\n\n    quicksort(our_list, N);\n\n    if (is_sorted(our_list, N) == 1) {\n        printf(\"Error, for some reason list is still unsorted.\\n\");\n        return 1;\n    }\n\n#ifdef COMPUTE_MD5_PROBLEM\n    MD5_CTX c;\n    unsigned char out[MD5_DIGEST_LENGTH];\n    MD5_Init(&c);\n    MD5_Update(&c, our_list, N * sizeof(int));\n    MD5_Final(out, &c);\n    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {\n        printf(\"%02x\", out[n]);\n    }\n#endif\n    printf(\"\\n\");\n\n    free(our_list);\n    return 0;\n}\n\nvoid quicksort(int *toorder, int N)\n{\n    if (N <= 1)\n        return;\n\n    int depth = depth_limit(N);\n    if (N >= PARALLEL_THRESHOLD) {\n#pragma omp parallel\n        {\n#pragma omp single\n            introsort_parallel(toorder, 0, N - 1, depth);\n        }\n    } else {\n        introsort_serial(toorder, 0, N - 1, depth);\n    }\n}\n\nstatic int median_of_three(int a, int b, int c)\n{\n    if (a < b) {\n        if (b < c)\n            return b;\n        return (a < c) ? c : a;\n    }\n    if (a < c)\n        return a;\n    return (b < c) ? c : b;\n}\n\nstatic int partition(int *toorder, int lo, int hi)\n{\n    int mid = lo + (hi - lo) / 2;\n    int pivot = median_of_three(toorder[lo], toorder[mid], toorder[hi]);\n    int i = lo - 1;\n    int j = hi + 1;\n\n    for (;;) {\n        do {\n            ++i;\n        } while (toorder[i] < pivot);\n        do {\n            --j;\n        } while (toorder[j] > pivot);\n        if (i >= j)\n            return j;\n        swap(toorder, i, j);\n    }\n}\n\nstatic void insertion_sort(int *toorder, int lo, int hi)\n{\n    for (int i = lo + 1; i <= hi; ++i) {\n        int value = toorder[i];\n        int j = i;\n        while (j > lo && toorder[j - 1] > value) {\n            toorder[j] = toorder[j - 1];\n            --j;\n        }\n        toorder[j] = value;\n    }\n}\n\nstatic void sift_down(int *toorder, int lo, int root, int count)\n{\n    while (root <= (count - 2) / 2) {\n        int child = root * 2 + 1;\n        if (child + 1 < count && toorder[lo + child] < toorder[lo + child + 1])\n            ++child;\n        if (toorder[lo + root] >= toorder[lo + child])\n            return;\n        swap(toorder, lo + root, lo + child);\n        root = child;\n    }\n}\n\nstatic void heapsort(int *toorder, int lo, int hi)\n{\n    int count = hi - lo + 1;\n    if (count <= 1)\n        return;\n\n    for (int start = count / 2; start > 0; --start)\n        sift_down(toorder, lo, start - 1, count);\n    for (int end = count - 1; end > 0; --end) {\n        swap(toorder, lo, lo + end);\n        sift_down(toorder, lo, 0, end);\n    }\n}\n\nstatic int depth_limit(int n)\n{\n    int depth = 0;\n    while (n > 1) {\n        n >>= 1;\n        depth += 2;\n    }\n    return depth;\n}\n\nstatic void introsort_serial(int *toorder, int lo, int hi, int depth)\n{\n    while (lo < hi) {\n        int count = hi - lo + 1;\n        if (count <= INSERTION_SORT_CUTOFF) {\n            insertion_sort(toorder, lo, hi);\n            return;\n        }\n        if (depth <= 0) {\n            heapsort(toorder, lo, hi);\n            return;\n        }\n\n        --depth;\n        int boundary = partition(toorder, lo, hi);\n        if (boundary - lo < hi - boundary) {\n            introsort_serial(toorder, lo, boundary, depth);\n            lo = boundary + 1;\n        } else {\n            introsort_serial(toorder, boundary + 1, hi, depth);\n            hi = boundary;\n        }\n    }\n}\n\nstatic void introsort_parallel(int *toorder, int lo, int hi, int depth)\n{\n    int count = hi - lo + 1;\n    if (count <= TASK_GRAIN) {\n        introsort_serial(toorder, lo, hi, depth);\n        return;\n    }\n    if (depth <= 0) {\n        heapsort(toorder, lo, hi);\n        return;\n    }\n\n    int boundary = partition(toorder, lo, hi);\n    int next_depth = depth - 1;\n    int left_count = boundary - lo + 1;\n    int right_count = hi - boundary;\n\n    if (left_count >= TASK_GRAIN && right_count >= TASK_GRAIN) {\n        if (left_count >= right_count) {\n#pragma omp task firstprivate(toorder, lo, boundary, next_depth)\n            introsort_parallel(toorder, lo, boundary, next_depth);\n            introsort_parallel(toorder, boundary + 1, hi, next_depth);\n        } else {\n#pragma omp task firstprivate(toorder, boundary, hi, next_depth)\n            introsort_parallel(toorder, boundary + 1, hi, next_depth);\n            introsort_parallel(toorder, lo, boundary, next_depth);\n        }\n#pragma omp taskwait\n    } else if (left_count >= TASK_GRAIN) {\n#pragma omp task firstprivate(toorder, lo, boundary, next_depth)\n        introsort_parallel(toorder, lo, boundary, next_depth);\n        introsort_serial(toorder, boundary + 1, hi, next_depth);\n#pragma omp taskwait\n    } else if (right_count >= TASK_GRAIN) {\n#pragma omp task firstprivate(toorder, boundary, hi, next_depth)\n        introsort_parallel(toorder, boundary + 1, hi, next_depth);\n        introsort_serial(toorder, lo, boundary, next_depth);\n#pragma omp taskwait\n    } else {\n        introsort_serial(toorder, lo, boundary, next_depth);\n        introsort_serial(toorder, boundary + 1, hi, next_depth);\n    }\n}\n\nvoid swap(int *toorder, int i, int j)\n{\n    int temp = toorder[i];\n    toorder[i] = toorder[j];\n    toorder[j] = temp;\n}\n\nint is_sorted(int *toorder, int N)\n{\n    for (int i = 1; i < N; i++) {\n        if (toorder[i] < toorder[i - 1])\n            return 1;\n    }\n    return 0;\n}\n\nint *generate_case(int N)\n{\n    int *ret = NULL;\n\n    srandnum(0);\n    ret = (int *) malloc(N * sizeof(int));\n    if (ret == NULL) {\n        printf(\"Error: some malloc won't work.\\n\");\n        return NULL;\n    }\n    for (int i = 0; i < N; i++)\n        ret[i] = drand(0, INT_MAX);\n    return ret;\n}\n\ndouble drand(int xmin, int xmax)\n{\n    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;\n}\n",
      "path": "src/quicksort.c"
    }
  ],
  "hypothesis": "A conditional OpenMP task-based introsort can exploit four cores on large arrays while avoiding team and task overhead for smaller ranges; bounded tasks and serial fallbacks should retain robust sorting behavior.",
  "notes": "This changes sorting only. The generated values, sortedness check, and MD5 output path are retained. No new correctness or performance result is claimed; the controller evaluates the candidate.",

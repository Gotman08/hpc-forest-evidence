        "depth": 1,
        "epoch": 1,
        "hypothesis": "Static OpenMP work sharing across independent target bodies should accelerate the quadratic force computation on four cores, while a persistent team amortizes thread-launch overhead across all ten steps.",
        "id": "f85d6cd3609f4fe9",
        "ordinal": 1,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/nbody.c"
          ],
          "retained": [
            "Extract the unchanged force kernel into a statically scheduled worksharing helper, retaining a standalone body_force wrapper.",
            "Use one persistent OpenMP team for all simulation iterations and statically distribute position updates.",
            "Keep implicit barriers between force and position phases; serialize the parallel region when there is at most one body."
          ]
        },

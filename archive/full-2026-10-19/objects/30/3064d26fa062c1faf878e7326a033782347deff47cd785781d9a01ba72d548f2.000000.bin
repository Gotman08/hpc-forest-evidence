    {
      "id": "a486b82f661047f0",
      "role": "B",
      "mission": {
        "base_commit": "37a0d34ee35e1bb24f44e624c724cbb96de820c4",
        "delegation_parent": "R/B",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Four independent target bodies per ARM64 NEON vector can reduce interaction-loop overhead and share source loads without reordering any target's j accumulation. Paired double-precision square roots and divisions preserve the reference's mixed-precision reciprocal calculation.",
        "id": "a486b82f661047f0",
        "ordinal": 1,
        "parent_id": null,
        "role": "B",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/nbody.c"
          ],
          "retained": [
            "Strip-mine the target-body loop into four independent SIMD lanes while retaining ascending j order in every lane.",
            "Use double-precision NEON sqrt/divide followed by float conversion, retaining the original float expression structure.",
            "Retain the scalar remainder and scalar fallback for non-NEON or fast-math builds."
          ]
        },
        "tree_id": "e1:B",
        "trial_id": "01M53RKCZQCA830G2W0FFNX5DS",

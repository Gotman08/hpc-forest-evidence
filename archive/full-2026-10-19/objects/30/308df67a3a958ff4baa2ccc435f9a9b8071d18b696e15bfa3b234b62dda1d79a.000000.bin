      "content": "#include \"knn.h\"\n\ntypedef struct {\n    float distance;\n    int group;\n} KnnNeighbor;\n\nstatic char knn_vote(char * labels, int k) {\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nstatic char knn_reference(int n_groups, Group * groups, int k,\n                          Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n\n                    distances[x] = d;\n                    labels[x] = g.label;\n\n                    break;\n                }\n            }\n        }\n    }\n\n    char result = knn_vote(labels, k);\n    free(distances);\n    free(labels);\n    return result;\n}\n\nstatic int knn_farther(KnnNeighbor a, KnnNeighbor b) {\n    /* Equal-distance points within one group have identical labels. */\n    return a.distance > b.distance ||\n           (a.distance == b.distance && a.group > b.group);\n}\n\nstatic void knn_sift_down(KnnNeighbor * heap, int length, int root) {\n    KnnNeighbor entry = heap[root];\n\n    while (root < length / 2) {\n        int child = 2 * root + 1;\n        if (child + 1 < length &&\n            knn_farther(heap[child + 1], heap[child])) {\n            child++;\n        }\n\n        if (!knn_farther(heap[child], entry)) {\n            break;\n        }\n\n        heap[root] = heap[child];\n        root = child;\n    }\n\n    heap[root] = entry;\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    int capacity = 0;\n    for (int i = 0; i < n_groups && capacity < k; i++) {\n        int length = groups[i].length;\n        if (length > 0) {\n            if (length >= k - capacity) {\n                capacity = k;\n            } else {\n                capacity += length;\n            }\n        }\n    }\n\n    /* Reuse the heap allocation for the final k label bytes. */\n    size_t workspace_size = (size_t) capacity * sizeof(KnnNeighbor);\n    if (workspace_size < (size_t) k) {\n        workspace_size = (size_t) k;\n    }\n\n    KnnNeighbor * heap = (KnnNeighbor *) malloc(workspace_size);\n    if (heap == NULL) {\n        return knn_reference(n_groups, groups, k, to_evaluate);\n    }\n\n    int count = 0;\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (int j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            /* NaNs require the reference's non-total insertion ordering. */\n            if (d != d) {\n                free(heap);\n                return knn_reference(n_groups, groups, k, to_evaluate);\n            }\n\n            if (count < k) {\n                heap[count].distance = d;\n                heap[count].group = i;\n                count++;\n\n                if (count == k) {\n                    for (int root = count / 2; root > 0; root--) {\n                        knn_sift_down(heap, count, root - 1);\n                    }\n                }\n            } else if (d < heap[0].distance) {\n                /* Later equal-distance points never displace earlier ones. */\n                heap[0].distance = d;\n                heap[0].group = i;\n                knn_sift_down(heap, count, 0);\n            }\n        }\n    }\n\n    char * labels = (char *) heap;\n    int i;\n    for (i = 0; i < count; i++) {\n        /* Each output byte precedes every still-unread heap entry. */\n        labels[i] = groups[heap[i].group].label;\n    }\n    for (; i < k; i++) {\n        labels[i] = -1;\n    }\n\n    char result = knn_vote(labels, k);\n    free(heap);\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",

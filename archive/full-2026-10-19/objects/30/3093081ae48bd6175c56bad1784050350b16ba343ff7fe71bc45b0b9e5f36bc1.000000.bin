    {
      "id": "6c6a29eb89584bc7",
      "role": "C",
      "mission": {
        "base_commit": "31b6172d267d93efbfdeeb6e7dd43846ae2af7a6",
        "delegation_parent": "R/C",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Rectangular 64-by-256 wavefront tiles should improve four-core utilization relative to square tiles by extending the full-team plateau, at the cost of modestly more diagonal barriers.",
        "id": "6c6a29eb89584bc7",
        "ordinal": 2,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/solution.cpp"
          ],
          "retained": [
            "Use persistent OpenMP static worksharing over rectangular tile anti-diagonals, with a barrier after each diagonal.",
            "Maintain two O(n) boundary frontiers and one 256-entry rolling buffer per worker instead of an integer DP matrix.",
            "Pack obstacles into 64-bit words, fast-path clear words, and replace remainder operations with conditional subtraction.",
            "Use serial rolling-row execution below n=1024 or with one available worker, and disable synchronized iostream input."
          ]
        },
        "tree_id": "e1:C",
        "trial_id": "01M50XGBJD7PCT10970CAE17AZ",

#include <algorithm>
#include <cstdint>
#include <iostream>
#include <vector>

using u32 = std::uint32_t;
using u64 = std::uint64_t;

static constexpr u64 MOD = 1000000007ULL;
static constexpr int BLOCK = 16;

// Coefficients use increasing powers of x. weights[i] is P[n-1-i],
// so x^n = sum(weights[i] * x^i) modulo the characteristic polynomial.
static int square_reduce(std::vector<u32>& coefficients, int active,
                         const std::vector<u32>& weights,
                         std::vector<u64>& workspace) {
    const int n = static_cast<int>(coefficients.size());
    const int top = 2 * active - 2;

    // Compute each convolution coefficient using symmetric pairs.
    for (int degree = 0; degree <= top; ++degree) {
        int i = std::max(0, degree - active + 1);
        const int pair_end = (degree + 1) / 2;
        u64 sum = 0;
        while (i < pair_end) {
            const int end = std::min(pair_end, i + BLOCK);
            for (; i < end; ++i) {
                sum += static_cast<u64>(coefficients[i])
                     * coefficients[degree - i];
            }
            sum %= MOD;
        }
        sum *= 2;
        if ((degree & 1) == 0) {
            const u64 center = coefficients[degree / 2];
            sum += center * center;
        }
        workspace[degree] = sum % MOD;
    }

    // Descending degrees are dependent. Within a block, update contiguous
    // coefficient ranges without reducing every individual product.
    // Each live coefficient receives at most 16 products between reductions;
    // (MOD-1) + 16*(MOD-1)^2 fits in an unsigned 64-bit integer.
    for (int high = top; high >= n; high -= BLOCK) {
        const int low = std::max(n, high - BLOCK + 1);
        for (int degree = high; degree >= low; --degree) {
            const u64 leading = workspace[degree] % MOD;
            if (leading == 0) {
                continue;
            }
            u64* destination = workspace.data() + degree - n;
            for (int j = 0; j < n; ++j) {
                destination[j] += leading * weights[j];
            }
        }
        for (int degree = 0; degree < low; ++degree) {
            workspace[degree] %= MOD;
        }
    }

    const int result_active = std::min(n, top + 1);
    for (int i = 0; i < result_active; ++i) {
        coefficients[i] = static_cast<u32>(workspace[i]);
    }
    std::fill(coefficients.begin() + result_active, coefficients.end(), 0);
    return result_active;
}

static int multiply_x(std::vector<u32>& coefficients, int active,
                      const std::vector<u32>& weights) {
    const int n = static_cast<int>(coefficients.size());
    if (active < n) {
        for (int i = active; i > 0; --i) {
            coefficients[i] = coefficients[i - 1];
        }
        coefficients[0] = 0;
        return active + 1;
    }

    const u64 leading = coefficients[n - 1];
    for (int i = n - 1; i > 0; --i) {
        coefficients[i] = static_cast<u32>(
            (coefficients[i - 1] + leading * weights[i]) % MOD);
    }
    coefficients[0] = static_cast<u32>((leading * weights[0]) % MOD);
    return n;
}

int main() {
    std::ios::sync_with_stdio(false);
    std::cin.tie(nullptr);

    int n;
    u64 h;
    if (!(std::cin >> n >> h)) {
        return 0;
    }

    std::vector<u32> initial(n);
    std::vector<u32> weights(n);
    for (int i = 0; i < n; ++i) {
        std::cin >> initial[i];
    }
    for (int i = n - 1; i >= 0; --i) {
        std::cin >> weights[i];
    }

    if (h <= static_cast<u64>(n)) {
        std::cout << initial[h - 1] << '\n';
        return 0;
    }

    std::vector<u32> coefficients(n, 0);
    std::vector<u64> workspace(2 * n - 1);
    int active;
    // Initialize the residue of x, including the degree-one case.
    if (n == 1) {
        coefficients[0] = weights[0];
        active = 1;
    } else {
        coefficients[1] = 1;
        active = 2;
    }

    const u64 exponent = h - 1;
    u64 bit = 1;
    while (bit <= exponent / 2) {
        bit <<= 1;
    }
    // The leading exponent bit is already represented by x.
    for (bit >>= 1; bit != 0; bit >>= 1) {
        active = square_reduce(coefficients, active, weights, workspace);
        if ((exponent & bit) != 0) {
            active = multiply_x(coefficients, active, weights);
        }
    }

    u64 answer = 0;
    for (int start = 0; start < n; start += BLOCK) {
        const int end = std::min(n, start + BLOCK);
        for (int i = start; i < end; ++i) {
            answer += static_cast<u64>(coefficients[i]) * initial[i];
        }
        answer %= MOD;
    }
    std::cout << answer << '\n';
    return 0;
}

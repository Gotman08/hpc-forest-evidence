#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N_ITER 10
#define DT 0.01f
#define SOFTENING 1e-9f

typedef struct { float x, y, z, vx, vy, vz; } Body;

void body_force(float *x, float *y, float *z,
                float *vx, float *vy, float *vz, int n) {
    #pragma omp for schedule(static)
    for (int i = 0; i < n; ++i) {
        float xi = x[i];
        float yi = y[i];
        float zi = z[i];
        float fx = 0.0f;
        float fy = 0.0f;
        float fz = 0.0f;

        for (int j = 0; j < n; ++j) {
            float dx = x[j] - xi;
            float dy = y[j] - yi;
            float dz = z[j] - zi;
            float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
            float inv_dist = 1 / sqrt(sqrd_dist);
            float inv_dist3 = inv_dist * inv_dist * inv_dist;

            fx += dx * inv_dist3;
            fy += dy * inv_dist3;
            fz += dz * inv_dist3;
        }

        vx[i] += DT*fx;
        vy[i] += DT*fy;
        vz[i] += DT*fz;
    }
}

void read_dataset(int *nbodies, float **x, float **y, float **z,
                  float **vx, float **vy, float **vz) {
    int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
    if (b != 1) {
        fprintf(stderr,"\nError reading nbodie value\n");
        exit(EXIT_FAILURE);
    }
    Body *tmp = (Body *)malloc((*nbodies) * sizeof(Body));
    b = fread(tmp, (*nbodies) * sizeof(Body), 1, stdin);
    if (b != 1) {
        fprintf(stderr,"\nError reading input values\n");
        exit(EXIT_FAILURE);
    }

    int n = *nbodies;
    *x = (float *)malloc(n * sizeof(float));
    *y = (float *)malloc(n * sizeof(float));
    *z = (float *)malloc(n * sizeof(float));
    *vx = (float *)malloc(n * sizeof(float));
    *vy = (float *)malloc(n * sizeof(float));
    *vz = (float *)malloc(n * sizeof(float));

    for (int i = 0; i < n; ++i) {
        (*x)[i] = tmp[i].x;
        (*y)[i] = tmp[i].y;
        (*z)[i] = tmp[i].z;
        (*vx)[i] = tmp[i].vx;
        (*vy)[i] = tmp[i].vy;
        (*vz)[i] = tmp[i].vz;
    }
    free(tmp);
}

void write_dataset(const int nbodies, float *x, float *y, float *z,
                   float *vx, float *vy, float *vz) {
    Body *tmp = (Body *)malloc(nbodies * sizeof(Body));
    for (int i = 0; i < nbodies; ++i) {
        tmp[i].x = x[i];
        tmp[i].y = y[i];
        tmp[i].z = z[i];
        tmp[i].vx = vx[i];
        tmp[i].vy = vy[i];
        tmp[i].vz = vz[i];
    }
    int b = fwrite(tmp, nbodies * sizeof(Body), 1, stdout);
    if (b != 1) {
        fprintf(stderr,"\nError writing to output\n");
        exit(EXIT_FAILURE);
    }
    free(tmp);
}

int main(int argc, char **argv) {
    int nbodies;
    float *x, *y, *z, *vx, *vy, *vz;

    read_dataset(&nbodies, &x, &y, &z, &vx, &vy, &vz);

    #pragma omp parallel
    {
        for (int iter = 0; iter < N_ITER; ++iter) {
            body_force(x, y, z, vx, vy, vz, nbodies);
            #pragma omp for schedule(static)
            for (int i = 0; i < nbodies; ++i) {
                x[i] += vx[i] * DT;
                y[i] += vy[i] * DT;
                z[i] += vz[i] * DT;
            }
        }
    }

    write_dataset(nbodies, x, y, z, vx, vy, vz);

    free(x); free(y); free(z);
    free(vx); free(vy); free(vz);

    return 0;
}

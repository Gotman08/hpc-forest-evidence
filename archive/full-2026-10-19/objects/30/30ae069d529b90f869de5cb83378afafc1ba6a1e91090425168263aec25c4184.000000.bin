ta; ties retain the first run, and a quadratic fallback handles NaN-containing columns.\"]}}, {\"id\": \"93fa5c140aba457e\", \"role\": \"B\", \"commit\": \"04eed8f80b3b0383017064695d4a70e765aaff3d\", \"mean_seconds\": 0.007560769096016884, \"transformations\": {\"files\": [\"src/est_matriz_seq.c\"], \"retained\": [\"Added GCC ivdep directives to the per-column standard-deviation and coefficient-of-variation loops; no reduction or loop-carried computation was changed.\"]}}, {\"id\": \"462501e96d8343ab\", \"role\": \"A\", \"commit\": \"0d7d3ac584a5df69a97a82cbc199542c344d595c\", \"mean_seconds\": 0.009583499282598495, \"transformations\": {\"files\": [\"src/est_matriz_seq.c\"], \"retained\": [\"Replace the separate arithmetic-mean and harmonic-mean matrix traversals with one per-column traversal that accumulates both metrics from each loaded value.\", \"Keep the existing column-major matrix layout and contiguous inner loop; preserve the original accumulation order for each metric and leave sorting, other statistics, and output formatting unchanged.\"]}}]}, \"target_as_data\": {\"architecture\": \"ARM64\", \"cpu_cores\": 4, \"gpus\": 0}, \"required_schema\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"analysis\": {\"type\": \"string\"}, \"A\": {\"type\": \"string\"}, \"B\": {\"type\": \"string\"}, \"C\": {\"type\": \"string\"}, \"G\": {\"type\": \"string\"}}, \"required\": [\"analysis\", \"A\", \"B\", \"C\", \"G\"]}}",

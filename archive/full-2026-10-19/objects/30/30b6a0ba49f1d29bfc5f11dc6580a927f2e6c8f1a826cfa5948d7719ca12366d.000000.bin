#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors
#define IB 16 // i-block size for cache blocking

typedef struct { float x, y, z, vx, vy, vz; } Body;

void body_force(float *px, float *py, float *pz,
                float *vx, float *vy, float *vz,
                float dt, int n) {
#pragma omp parallel for schedule(static)
  for (int ib = 0; ib < n; ib += IB) {
    int imax = (ib + IB < n) ? ib + IB : n;
    float fx[IB], fy[IB], fz[IB];

    // Initialize force accumulators for this tile of bodies.
    for (int ii = ib; ii < imax; ++ii) {
      int idx = ii - ib;
      fx[idx] = 0.0f;
      fy[idx] = 0.0f;
      fz[idx] = 0.0f;
    }

    // Loop over all j bodies, reusing each j's coordinates for the whole tile.
    for (int j = 0; j < n; ++j) {
      float xj = px[j];
      float yj = py[j];
      float zj = pz[j];

      for (int ii = ib; ii < imax; ++ii) {
        int idx = ii - ib;
        float dx = xj - px[ii];
        float dy = yj - py[ii];
        float dz = zj - pz[ii];
        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
        float inv_dist = 1.0f / sqrt(sqrd_dist);
        float inv_dist3 = inv_dist * inv_dist * inv_dist;

        fx[idx] += dx * inv_dist3;
        fy[idx] += dy * inv_dist3;
        fz[idx] += dz * inv_dist3;
      }
    }

    // Update velocities for this tile using the accumulated forces.
    for (int ii = ib; ii < imax; ++ii) {
      int idx = ii - ib;
      vx[ii] += dt * fx[idx];
      vy[ii] += dt * fy[idx];
      vz[ii] += dt * fz[idx];
    }
  }
}

int main(int argc, char **argv) {
  int nbodies;

  if (fread(&nbodies, sizeof(nbodies), 1, stdin) != 1) {
    fprintf(stderr, "\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }

  // Read the original AoS data.
  Body *tmp = (Body *)malloc(nbodies * sizeof(Body));
  if (!tmp) {
    fprintf(stderr, "\nError allocating input buffer\n");
    exit(EXIT_FAILURE);
  }
  if (fread(tmp, nbodies * sizeof(Body), 1, stdin) != 1) {
    fprintf(stderr, "\nError reading input values\n");
    free(tmp);
    exit(EXIT_FAILURE);
  }

  // Convert to SoA layout for better cache locality.
  float *px = (float *)malloc(nbodies * sizeof(float));
  float *py = (float *)malloc(nbodies * sizeof(float));
  float *pz = (float *)malloc(nbodies * sizeof(float));
  float *vx = (float *)malloc(nbodies * sizeof(float));
  float *vy = (float *)malloc(nbodies * sizeof(float));
  float *vz = (float *)malloc(nbodies * sizeof(float));

  if (!px || !py || !pz || !vx || !vy || !vz) {
    fprintf(stderr, "\nError allocating SoA arrays\n");
    exit(EXIT_FAILURE);
  }

  for (int i = 0; i < nbodies; ++i) {
    px[i] = tmp[i].x;
    py[i] = tmp[i].y;
    pz[i] = tmp[i].z;
    vx[i] = tmp[i].vx;
    vy[i] = tmp[i].vy;
    vz[i] = tmp[i].vz;
  }
  free(tmp);

  // Simulation iterations.
  for (int iter = 0; iter < N_ITER; ++iter) {
    body_force(px, py, pz, vx, vy, vz, DT, nbodies);

#pragma omp parallel for schedule(static)
    for (int i = 0; i < nbodies; ++i) {
      px[i] += vx[i] * DT;
      py[i] += vy[i] * DT;
      pz[i] += vz[i] * DT;
    }
  }

  // Convert back to AoS and write output.
  Body *out = (Body *)malloc(nbodies * sizeof(Body));
  if (!out) {
    fprintf(stderr, "\nError allocating output buffer\n");
    exit(EXIT_FAILURE);
  }

  for (int i = 0; i < nbodies; ++i) {
    out[i].x = px[i];
    out[i].y = py[i];
    out[i].z = pz[i];
    out[i].vx = vx[i];
    out[i].vy = vy[i];
    out[i].vz = vz[i];
  }

  if (fwrite(out, nbodies * sizeof(Body), 1, stdout) != 1) {
    fprintf(stderr, "\nError writing to output\n");
    exit(EXIT_FAILURE);
  }

  free(px); free(py); free(pz);
  free(vx); free(vy); free(vz);
  free(out);

  return EXIT_SUCCESS;
}

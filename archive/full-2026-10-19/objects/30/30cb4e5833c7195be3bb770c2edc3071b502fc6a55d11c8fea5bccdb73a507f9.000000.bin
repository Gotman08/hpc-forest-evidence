#include <algorithm>
#include <iostream>
#include <vector>

using namespace std;

const int MOD = 1000000007;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) return 0;

    // Each key sorts first by diagonal, then by row.
    vector<unsigned long long> blockedCells;
    blockedCells.reserve(static_cast<size_t>(m));
    for (int c = 0; c < m; ++c) {
        int row, column;
        cin >> row >> column;
        unsigned long long diagonal = static_cast<unsigned long long>(row + column);
        blockedCells.push_back(diagonal * static_cast<unsigned long long>(n) +
                               static_cast<unsigned long long>(row));
    }
    sort(blockedCells.begin(), blockedCells.end());

    vector<int> previous(n, 0);
    vector<int> current(n, 0);
    vector<int> blockedStamp(n, -1);
    size_t blockedIndex = 0;

    while (blockedIndex < blockedCells.size() &&
           blockedCells[blockedIndex] / static_cast<unsigned long long>(n) == 0) {
        blockedStamp[static_cast<size_t>(blockedCells[blockedIndex] %
                                         static_cast<unsigned long long>(n))] = 0;
        ++blockedIndex;
    }
    previous[0] = blockedStamp[0] == 0 ? 0 : 1;

    for (int diagonal = 1; diagonal <= 2 * n - 2; ++diagonal) {
        const bool growing = diagonal < n;
        const int lowRow = growing ? 0 : diagonal - n + 1;
        const int length = growing ? diagonal + 1 : 2 * n - 1 - diagonal;

        while (blockedIndex < blockedCells.size() &&
               blockedCells[blockedIndex] / static_cast<unsigned long long>(n) ==
                   static_cast<unsigned long long>(diagonal)) {
            const int row = static_cast<int>(blockedCells[blockedIndex] %
                                             static_cast<unsigned long long>(n));
            blockedStamp[row - lowRow] = diagonal;
            ++blockedIndex;
        }

        const int* __restrict__ previousData = previous.data();
        int* __restrict__ currentData = current.data();
        const int* __restrict__ stampData = blockedStamp.data();

        if (growing) {
            const int last = length - 1;
            currentData[0] = stampData[0] == diagonal ? 0 : previousData[0];
            currentData[last] = stampData[last] == diagonal ? 0 : previousData[last - 1];

            #pragma GCC ivdep
            for (int i = 1; i < last; ++i) {
                int ways = previousData[i - 1] + previousData[i];
                if (ways >= MOD) ways -= MOD;
                currentData[i] = stampData[i] == diagonal ? 0 : ways;
            }
        } else {
            #pragma GCC ivdep
            for (int i = 0; i < length; ++i) {
                int ways = previousData[i] + previousData[i + 1];
                if (ways >= MOD) ways -= MOD;
                currentData[i] = stampData[i] == diagonal ? 0 : ways;
            }
        }

        previous.swap(current);
    }

    cout << previous[0] << '\n';
    return 0;
}

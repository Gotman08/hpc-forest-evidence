"""Preserve guide before bounded current-state replacement; science sources untouched."""
import datetime as dt
import hashlib
import json
import os
from pathlib import Path

op=Path(__file__).resolve().parent
base=op.parents[2]
guide=base/'outputs/HPC-Forest-Harnais-Comparaison-r1/SUIVI-COMPACT.md'
def sha(p): return hashlib.sha256(p.read_bytes()).hexdigest()
old=guide.read_bytes()
assert hashlib.sha256(old).hexdigest()=='f4234334452a7e50b49cf61f389500e240d0fc4fe2a650a248c9a826c4dc47a2'
q=op/'qualification-r7-execution-root-01/revue-froide-independante-r1/revision-r2-inventaires-figes/RECEPTION-MECANIQUE-R7-Q754424-VERIFIEE-R2.json'
closed=op/'fermeture-observateur-r5-preparee-r1/execution-root-02-r3/FERMETURE-OBSERVATEUR-PASSIF-VERIFIEE.json'
assert sha(q)=='8e2d49e0a0db87c5ad0d44b95816d488dea43542f1c69aedc077d046b78dd652'
assert sha(closed)=='297d6692434aef9099c2f418c75aae6f22ac8bc31333f38ae34d3a732fad48b3'
text=old.decode('utf-8')
start=text.index('Candidat Q :')
end=text.index('Rebinder parents/politiques',start)
replacement='''Q R7 **754424 reçue et auditée** : COMPLETED0:0,4s,4CPU ARM64/16Gio/0GPU.274 cas neutres distincts sans échec/saut (265+9revue), une préparation de cible officielle/deux sondes GCC/G++ OpenMP ;0modèle/candidat/install, pas de rejeu. Archive2168339octets `e4049069a9d0b2d6ffbdb75f8969bd70f71caa5bd4eb8cea12defe667efed4d2`, troisSHA égaux ;749copies régulières/5536387octets stables,65liens métadonnées inertes seulement. Composite préféré `O/qualification-r7-execution-root-01/revue-froide-independante-r1/revision-r2-inventaires-figes/RECEPTION-MECANIQUE-R7-Q754424-VERIFIEE-R2.json` SHA8e2d49e0… ; audit aa980bb4… et revue cible/héritage31efd2f3… . Profil lié au vrai754424, pas à un futur natif.16contrats/15admissions et4exclusions liés explicitement au nouveauplan par égalité ; aucune référence réexécutée. Ancien compositef4 et audit701 préservés NON PRÉFÉRÉS : correction documentaire865inputs figés avant/après, sans changer les bruts ou refaire les suites. Aucun ancienQ promu. Ne plus repoller754424 après cette réception. Aucune génération native admise.

Ancienne OBS4r5 **fermée metadata-only** au18octobre19:31:06UTC après réception/réconciliation zéroappel. ROOT a arrêté UN SEUL principal28416 par handle vérifié et intention durable ; les six autres contextes ont disparu naturellement. Sept identités absentes au CIM final48109023… ; aucun étranger arrêté/arrêt récursif.15fichiers ordinaires copiés avant et après, sources62 préservées ; lock stat seul, SHA inconnu. Canonique `O/fermeture-observateur-r5-preparee-r1/execution-root-02-r3/FERMETURE-OBSERVATEUR-PASSIF-VERIFIEE.json` SHA297d6692… ; revue froide des résultats en cours. Premier refus r2 WinError32 des logs ouverts AVANT effet/intention conservé ; dérivée isolée r3 autorise seulement leurs deux chemins exacts via second namespace shareREAD|WRITE, mêmes gardes/no-follow/stabilité,18contrôles inertes ROOT PASS225057… et revueacfa99… . Ne relancer aucun ancien observateur/helper d'arrêt ; intention globale consommée b9d431ff… . Aucune présence/absence future déduite de ces PID.

Avant nouvelle OBS4 R7 : garde parent séparée sous `O/preparation-observation-R7-r1`, exigeant clôture auditée297d puis nouveau CIM complet≤120s montrant les sept identités/contextes et toute instance équivalente absents. Le verrou R7 et la gardeOBS3 ne suffisent pas. Nouveau watcher NON lancé à cet arrêté,0worker natif observé à la fermeture.

ParentsR7 : préparation36d80bd2…/revue d76153ea… . Composition locale INERTE complète des trois modèles reçue PASS `O/preparation-parents-R7-bout-en-bout-r1/INERT-HISTORICAL-DO-NOT-UPLOAD-02/RESULTAT-COMPOSITION-INERTE-NON-ADMIS.json` f2a2b954… : vraie factory→publication/readbacks/ready→bootstrap.dry_run, transports fictifs et horloge historique explicitement étiquetés ;62octets inchangés. Les sortiesINERT ne doivent JAMAIS être téléversées. Premier refus de fixture SSL/socket conservé ; correction isolée sans changer source/gardes. Partage local117 qualifié préparé, receipt565320a9… : vérifier transfert/readbackfilewise et4SHA réels avant600s. Trois plans natifs préparés et relus sous `O/preparation-scheduler-R7-root-01` mais NON SOUMIS, aucune fenêtre600s engagée : Sol840d162101a24fe6b6f840df1c91e2a6, Astra68b7d9ee9dcf4076858336fc3cc05aab, Terrab0e3cf7eff47473cb585e64a230dc4b3. Ne pas créer de nouveaux plans/soumettre en doublon ; renouveler leur état si nécessaire.

'''
text=text[:start]+replacement+text[end:]
now=dt.datetime.now(dt.timezone.utc)
folder=op/('guide-preserve-Q754424-'+now.strftime('%Y%m%dT%H%M%SZ'))
folder.mkdir(exist_ok=False)
with (folder/'SUIVI-AVANT.md').open('xb') as f: f.write(old);f.flush();os.fsync(f.fileno())
assert sha(folder/'SUIVI-AVANT.md')==hashlib.sha256(old).hexdigest()
tmp=folder/'SUIVI-NOUVEAU.md'
with tmp.open('xb') as f: f.write(text.encode('utf-8'));f.flush();os.fsync(f.fileno())
expected_new=sha(tmp)
os.replace(tmp,guide)
assert sha(guide)==expected_new
id_file=base/'ID.md'
assert sha(id_file)=='a3076e8b47d746019500fea94f23ce5c0ba2078305e92c6198353c64bcc5c83b'
receipt={'schema':'hpc-forest-current-guide-preservation-update-v1','observed_at_utc':now.isoformat(),'before_sha256':hashlib.sha256(old).hexdigest(),'preserved':str(folder/'SUIVI-AVANT.md'),'after_sha256':expected_new,'guide':str(guide),'ID40_unchanged':True,'actual_Q_received':True,'old_watcher_owned_closed':True,'new_watcher_or_native_started':False,'no_scientific_PDF_public_or_private_kit_change':True}
with (folder/'RECU-GUIDE.json').open('x',encoding='utf-8') as f: json.dump(receipt,f,ensure_ascii=False,indent=2);f.write('\n');f.flush();os.fsync(f.fileno())
print(json.dumps(receipt,ensure_ascii=False))

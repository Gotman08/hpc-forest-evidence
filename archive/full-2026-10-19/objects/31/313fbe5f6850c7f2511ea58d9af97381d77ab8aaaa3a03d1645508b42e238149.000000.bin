#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

typedef struct { float x, y, z, vx, vy, vz; } Body;

/*
 * Compute gravitational forces using a structure-of-arrays layout.
 * Each thread processes a small tile of bodies (TILE=4) so that the
 * four independent force accumulators can be vectorized across i,
 * while every body still accumulates over j in strictly increasing
 * order, preserving bit-exact floating-point results.  The SoA layout
 * improves cache-line utilization when streaming through all bodies.
 */
static void body_force(float * restrict x, float * restrict y, float * restrict z,
                       float * restrict vx, float * restrict vy, float * restrict vz,
                       float dt, int n) {
  const int TILE = 4;

  #pragma omp parallel for schedule(static)
  for (int ib = 0; ib < n; ib += TILE) {
    int imax = ib + TILE;
    if (imax > n) imax = n;
    const int ntile = imax - ib;

    float fx[TILE], fy[TILE], fz[TILE];
    float xi[TILE], yi[TILE], zi[TILE];

    for (int t = 0; t < ntile; ++t) {
      const int i = ib + t;
      xi[t] = x[i];
      yi[t] = y[i];
      zi[t] = z[i];
      fx[t] = fy[t] = fz[t] = 0.0f;
    }

    for (int j = 0; j < n; ++j) {
      const float pjx = x[j];
      const float pjy = y[j];
      const float pjz = z[j];

      #pragma omp simd
      for (int t = 0; t < ntile; ++t) {
        const float dx = pjx - xi[t];
        const float dy = pjy - yi[t];
        const float dz = pjz - zi[t];
        const float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
        const float inv_dist = 1.0f / sqrt(sqrd_dist);
        const float inv_dist3 = inv_dist * inv_dist * inv_dist;

        fx[t] += dx * inv_dist3;
        fy[t] += dy * inv_dist3;
        fz[t] += dz * inv_dist3;
      }
    }

    for (int t = 0; t < ntile; ++t) {
      const int i = ib + t;
      vx[i] += dt*fx[t];
      vy[i] += dt*fy[t];
      vz[i] += dt*fz[t];
    }
  }
}

static Body* read_dataset(int *nbodies) {
  if (fread(nbodies, sizeof(*nbodies), 1, stdin) != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *tmp = (Body *)malloc(*nbodies * sizeof(Body));
  if (!tmp || fread(tmp, *nbodies * sizeof(Body), 1, stdin) != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }
  return tmp;
}

int main(int argc, char **argv) {
  int n;
  Body *bodies = read_dataset(&n);

  float *x, *y, *z, *vx, *vy, *vz;
  if (posix_memalign((void**)&x, 64, n*sizeof(float)) != 0 ||
      posix_memalign((void**)&y, 64, n*sizeof(float)) != 0 ||
      posix_memalign((void**)&z, 64, n*sizeof(float)) != 0 ||
      posix_memalign((void**)&vx, 64, n*sizeof(float)) != 0 ||
      posix_memalign((void**)&vy, 64, n*sizeof(float)) != 0 ||
      posix_memalign((void**)&vz, 64, n*sizeof(float)) != 0) {
    fprintf(stderr,"\nMemory allocation failed\n");
    exit(EXIT_FAILURE);
  }

  for (int i = 0; i < n; ++i) {
    x[i] = bodies[i].x;
    y[i] = bodies[i].y;
    z[i] = bodies[i].z;
    vx[i] = bodies[i].vx;
    vy[i] = bodies[i].vy;
    vz[i] = bodies[i].vz;
  }

  for (int iter = 0; iter < N_ITER; ++iter) {
    body_force(x, y, z, vx, vy, vz, DT, n);

    #pragma omp parallel for schedule(static)
    for (int i = 0; i < n; ++i) {
      x[i] += vx[i] * DT;
      y[i] += vy[i] * DT;
      z[i] += vz[i] * DT;
    }
  }

  for (int i = 0; i < n; ++i) {
    bodies[i].x = x[i];
    bodies[i].y = y[i];
    bodies[i].z = z[i];
    bodies[i].vx = vx[i];
    bodies[i].vy = vy[i];
    bodies[i].vz = vz[i];
  }

  if (fwrite(bodies, n * sizeof(Body), 1, stdout) != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }

  free(x); free(y); free(z); free(vx); free(vy); free(vz);
  free(bodies);
  return EXIT_SUCCESS;
}

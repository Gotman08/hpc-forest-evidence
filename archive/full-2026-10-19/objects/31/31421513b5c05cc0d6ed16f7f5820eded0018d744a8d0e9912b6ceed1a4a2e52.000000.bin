      "content": "#include \"knn.h\"\n#include <float.h>\n\n/* Max-heap for top-k nearest neighbors */\nstatic void heap_sift_down(float *distances, char *labels, int k, int idx) {\n    int largest = idx;\n    while (1) {\n        int left  = 2 * idx + 1;\n        int right = 2 * idx + 2;\n        if (left < k && distances[left] > distances[largest]) largest = left;\n        if (right < k && distances[right] > distances[largest]) largest = right;\n        if (largest == idx) break;\n        float tmp_d = distances[idx];\n        char  tmp_l = labels[idx];\n        distances[idx] = distances[largest];\n        labels[idx]    = labels[largest];\n        distances[largest] = tmp_d;\n        labels[largest]    = tmp_l;\n        idx = largest;\n    }\n}\n\nstatic void heap_sift_up(float *distances, char *labels, int idx) {\n    while (idx > 0) {\n        int parent = (idx - 1) / 2;\n        if (distances[idx] <= distances[parent]) break;\n        float tmp_d = distances[idx];\n        char  tmp_l = labels[idx];\n        distances[idx] = distances[parent];\n        labels[idx]    = labels[parent];\n        distances[parent] = tmp_d;\n        labels[parent]    = tmp_l;\n        idx = parent;\n    }\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    /* Count total points */\n    int total_points = 0;\n    for (int i = 0; i < n_groups; i++) total_points += groups[i].length;\n\n    /* Flatten all points into SoA layout for better cache locality */\n    float *xs = (float *)malloc(sizeof(float) * total_points);\n    float *ys = (float *)malloc(sizeof(float) * total_points);\n    char  *ls = (char  *)malloc(sizeof(char)  * total_points);\n\n    int idx = 0;\n    for (int g = 0; g < n_groups; g++) {\n        Group grp = groups[g];\n        for (int p = 0; p < grp.length; p++) {\n            xs[idx] = grp.points[p].x;\n            ys[idx] = grp.points[p].y;\n            ls[idx] = grp.label;\n            idx++;\n        }\n    }\n\n    /* Max-heap for top-k distances and labels */\n    float *heap_dist = (float *)malloc(sizeof(float) * k);\n    char  *heap_lab  = (char  *)malloc(sizeof(char)  * k);\n    int heap_size = 0;\n\n    /* Initialize with sentinel values */\n    for (int i = 0; i < k; i++) {\n        heap_dist[i] = FLT_MAX;\n        heap_lab[i]  = -1;\n    }\n\n    /* Process each point: compute distance and maintain top-k via max-heap */\n    for (int i = 0; i < total_points; i++) {\n        float dx = to_evaluate.x - xs[i];\n        float dy = to_evaluate.y - ys[i];\n        float d = dx*dx + dy*dy;\n\n        if (heap_size < k) {\n            /* Insert at end and sift up */\n            heap_dist[heap_size] = d;\n            heap_lab[heap_size]  = ls[i];\n            heap_sift_up(heap_dist, heap_lab, heap_size);\n            heap_size++;\n        } else if (d < heap_dist[0]) {\n            /* Replace root and sift down */\n            heap_dist[0] = d;\n            heap_lab[0]  = ls[i];\n            heap_sift_down(heap_dist, heap_lab, k, 0);\n        }\n    }\n\n    free(xs);\n    free(ys);\n    free(ls);\n\n    /* Count frequencies of labels in the heap */\n    int freq[256] = {0};\n    for (int i = 0; i < k; i++) {\n        if (heap_lab[i] != -1) {\n            freq[(unsigned char)heap_lab[i]]++;\n        }\n    }\n\n    free(heap_dist);\n    free(heap_lab);\n\n    /* Find most frequent label */\n    int best_count = 0;\n    char best_label = -1;\n    for (int c = 32; c < 127; c++) {   /* printable ASCII range */\n        if (freq[c] > best_count) {\n            best_count = freq[c];\n            best_label = (char)c;\n        }\n    }\n\n    return best_label;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n\n    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    },
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point *points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n    Point point;\n    point.x = x;\n    point.y = y;\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *)malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt(Point a, Point b) {\n    float dx = b.x - a.x;\n    float dy = b.y - a.y;\n    return dx*dx + dy*dy;\n}\n",
      "path": "src/knn.h"
    }
  ],
  "hypothesis": "Flattening all points into separate arrays (x, y, label) improves spatial locality when computing distances by enabling sequential cache-friendly access. Replacing the O(k) insertion sort with a max-heap reduces per-point overhead to O(log k), and using a frequency array instead of qsort eliminates sorting entirely. These changes together minimize memory traffic and improve instruction-level parallelism.",
  "notes": "The transformation combines SoA data layout for all points (improving cache line utilization during distance computation) with a binary max-heap for top-k selection, avoiding the original O(k) shift insertion and subsequent qsort. The heap is implemented inline to avoid function call overhead. Frequency counting uses a fixed-size array indexed by character value.",

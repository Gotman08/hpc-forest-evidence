"""Version only closed campaign bindings; no live input or executable is inspected."""
from __future__ import annotations

import ast
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
BASE = HERE.parents[2]
OLD = BASE / "outputs/HPC-Forest-Primes-Natif-Relance-r2e/reception-premier-batch-r1"
FACTORY = BASE / "outputs/HPC-Forest-Primes-Natif-Lancement-r2f/revision-r1"
PINS = {
    "reception_bornee.py": "8d815c99c36d9cbf968cfb50c030dfcbbd0a5c679c292138c490d52d006e163f",
    "audit_prive.py": "0d7d141a6bff7ca294e9e8d4d16b53acd2e903e38f59099c838fb2f47a609c97",
    "controler-reception-bornee.py": "7d704cfa7dc2abbb360a137eb82ce86ed9d13b88c20a09eed4cfb10fd15219bf",
    "collecter-frontiere.py": "ec4393d0df89af78f4ca19b05b21d320f618f3063066ad35c603ad80fb653d94",
    "preparer-contexte.py": "6eed9e45f3c59caad03039b62d02f272fe80d895d6c4de2610b2691d1c09f723",
}
CHANGES = {
    "hpc-forest-primes-native-max-r2e": "hpc-forest-primes-native-max-r2f",
    "HPC-Forest-Primes-Natif-Lancement-r2e": "HPC-Forest-Primes-Natif-Lancement-r2f",
    "f15b840cca876a4c465775f5553a0eaa539a9b98e56fe942136a1fcbde9b86b9": "47f97afabcd6d10c5e95a1dc3aae0a34b0841183919785a6bd62d58aa1e90d75",
    "4b430e181948e55e463dfd1e60bdce96308a9190534734feb22354e4116ebde9": "8d91ebe83ab550ad50acc330f830e1bc86bcc67f66b88054538df6b394558450",
    "f81b76a9bc484f669a210c476ae6f9b0": "5aeceff56b26452290325ed4274d71bd",
    "e3678f243ba54a9fadb57440641c0599": "e7c86715f4d34e9f9efcdcc4ce2a81c8",
    "515db6fd166e4b68875f34cf2fe733fa": "1294453607b34c68ba05872072640120",
    "f985e2b827ffbeb7ec56169eef70f76b9529a054c3b39ae18f35371ea4720239": "67ca844efe21ac45d079cdb18397f228b80a75c53e52caa719864c0d51c8b8c4",
    "01dbd6e3af4bbc826a4f775482329d8c7cf7efae7e2b04b49f15e1a53c74a176": "c34319ca303137a205dd8e55ca7b4705bb1db91efc65498f422e20d0ffa3767f",
    "(m.SCOPE, m.SOURCE, m.PLAN, 108)": "(m.SCOPE, m.SOURCE, m.PLAN, 109)",
    "r2e-first-batch-private-projection-r1": "r2f-first-batch-private-projection-r1",
}


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def functions(text):
    return {node.name: ast.dump(node, include_attributes=False) for node in ast.parse(text).body
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))}


def main():
    assert sha((FACTORY / "MANIFESTE-FACTORY-LOCALE.json").read_bytes()) == "19231396cc470934ec8385c37f7975aa6865c9bbd3222583b65a62b39e76375c"
    originals = {name: (OLD / name).read_bytes() for name in PINS}
    assert all(sha(raw) == PINS[name] for name, raw in originals.items())
    texts = {name: raw.decode("utf-8") for name, raw in originals.items()}
    for name, text in texts.items():
        for before, after in CHANGES.items():
            text = text.replace(before, after)
        texts[name] = text
    helper_sha = sha(texts["reception_bornee.py"].encode())
    collector_sha = sha(texts["collecter-frontiere.py"].encode())
    texts["controler-reception-bornee.py"] = texts["controler-reception-bornee.py"].replace(PINS["reception_bornee.py"], helper_sha)
    texts["preparer-contexte.py"] = texts["preparer-contexte.py"].replace(PINS["collecter-frontiere.py"], collector_sha)
    # The source109 constructor and all source wire schemas remain those qualified in R2e.
    assert texts["audit_prive.py"].encode() == originals["audit_prive.py"]
    old_science = functions(originals["reception_bornee.py"].decode())
    new_science = functions(texts["reception_bornee.py"])
    assert old_science == new_science
    old_private = functions(originals["audit_prive.py"].decode())
    assert old_private == functions(texts["audit_prive.py"])
    assert functions(originals["controler-reception-bornee.py"].decode())["verify_frozen_authorizations"] == functions(texts["controler-reception-bornee.py"])["verify_frozen_authorizations"]
    assert not any((HERE / name).exists() for name in texts)
    for name, text in texts.items():
        with (HERE / name).open("x", encoding="utf-8", newline="\n") as stream:
            stream.write(text)
    with (HERE / "DIFF-FERME.json").open("x", encoding="utf-8", newline="\n") as stream:
        stream.write(json.dumps({
            "schema": "hpc-forest-r2f-cold-first-batch-reader-closed-delta-v1",
            "prepared_only": True, "native_research_admitted": False,
            "source_old_files_preserved": {name: PINS[name] for name in PINS},
            "files": {name: sha((HERE / name).read_bytes()) for name in texts},
            "replacements": CHANGES,
            "dynamic_hash_updates": {PINS["reception_bornee.py"]: helper_sha, PINS["collecter-frontiere.py"]: collector_sha},
            "all_scientific_helper_functions_ast_identical": True,
            "private_auditor_byte_identical": True,
            "frozen_authorization_validator_ast_identical": True,
            "mechanical_wire_schemas_r2e_preserved": True,
            "actual_first_batch_or_installation_receipt_created": False,
        }, ensure_ascii=False, indent=2) + "\n")
    print(json.dumps({name: sha((HERE / name).read_bytes()) for name in texts}))


if __name__ == "__main__":
    main()

      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <assert.h>\n#include <string.h>\n#include <limits.h>\n#include <stdint.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\ntypedef struct {\n    long int *data;\n    int length;\n    long int total;\n} bucket;\n\nenum {\n    INSERTION_SORT_CUTOFF = 32,\n    MIN_TASK_SIZE = 2048,\n    PARALLEL_SORT_MIN = 8192\n};\n\nstatic void *checked_array_alloc(size_t count, size_t width) {\n    if (width != 0 && count > SIZE_MAX / width) {\n        fputs(\"ERROR allocation size\\n\", stderr);\n        exit(EXIT_FAILURE);\n    }\n    size_t bytes = count * width;\n    void *memory = malloc(bytes != 0 ? bytes : 1);\n    if (memory == NULL) {\n        fputs(\"ERROR allocation\\n\", stderr);\n        exit(EXIT_FAILURE);\n    }\n    return memory;\n}\n\nvoid sort(char *a, bucket *b) {\n    size_t stride = (size_t)b->length;\n    for (long int j = 1; j < b->total; ++j) {\n        long int key = b->data[j];\n        long int i = j;\n        const char *key_string = a + (size_t)key * stride;\n        while (i > 0 &&\n               strcmp(a + (size_t)b->data[i - 1] * stride, key_string) > 0) {\n            b->data[i] = b->data[i - 1];\n            --i;\n        }\n        b->data[i] = key;\n    }\n}\n\nstatic void merge_sort_indices(char *a, size_t stride, long int *data,\n                               long int *work, size_t count,\n                               size_t task_grain) {\n    if (count <= INSERTION_SORT_CUTOFF) {\n        bucket leaf = {data, (int)stride, (long int)count};\n        sort(a, &leaf);\n        return;\n    }\n\n    size_t middle = count / 2;\n#ifdef _OPENMP\n    if (middle >= task_grain) {\n#pragma omp task firstprivate(a, stride, data, work, middle, task_grain)\n        {\n            merge_sort_indices(a, stride, data, work, middle, task_grain);\n        }\n#pragma omp task firstprivate(a, stride, data, work, count, middle, task_grain)\n        {\n            merge_sort_indices(a, stride, data + middle, work + middle,\n                               count - middle, task_grain);\n        }\n#pragma omp taskwait\n    } else\n#endif\n    {\n        merge_sort_indices(a, stride, data, work, middle, task_grain);\n        merge_sort_indices(a, stride, data + middle, work + middle,\n                           count - middle, task_grain);\n    }\n\n    if (strcmp(a + (size_t)data[middle - 1] * stride,\n               a + (size_t)data[middle] * stride) <= 0) {\n        return;\n    }\n\n    size_t left = 0;\n    size_t right = middle;\n    size_t out = 0;\n    while (left < middle && right < count) {\n        if (strcmp(a + (size_t)data[left] * stride,\n                   a + (size_t)data[right] * stride) <= 0) {\n            work[out++] = data[left++];\n        } else {\n            work[out++] = data[right++];\n        }\n    }\n    if (left < middle) {\n        memcpy(work + out, data + left, (middle - left) * sizeof(*work));\n    } else if (right < count) {\n        memcpy(work + out, data + right, (count - right) * sizeof(*work));\n    }\n    memcpy(data, work, count * sizeof(*data));\n}\n\nlong int *bucket_sort(char *a, int length, long int size,\n                      int offset, int nbuckets) {\n    /* Sort the complete permutation without assuming balanced buckets. */\n    (void)offset;\n    (void)nbuckets;\n    if (size < 0 || length <= 0 ||\n        (uintmax_t)size > (uintmax_t)(SIZE_MAX / (size_t)length)) {\n        fputs(\"ERROR sort size\\n\", stderr);\n        exit(EXIT_FAILURE);\n    }\n\n    size_t count = (size_t)size;\n    long int *returns = checked_array_alloc(count, sizeof(*returns));\n    if (count < 2) {\n        if (count == 1) {\n            returns[0] = 0;\n        }\n        return returns;\n    }\n    long int *work = checked_array_alloc(count, sizeof(*work));\n\n#ifdef _OPENMP\n#pragma omp parallel if (count >= PARALLEL_SORT_MIN)\n#endif\n    {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n        for (long int i = 0; i < size; ++i) {\n            returns[i] = i;\n        }\n\n#ifdef _OPENMP\n#pragma omp single\n#endif\n        {\n            /* SIZE_MAX disables task creation for a serial team. */\n            size_t task_grain = SIZE_MAX;\n#ifdef _OPENMP\n            int workers = omp_get_num_threads();\n            if (workers > 1) {\n                task_grain = count / (size_t)workers / 4;\n                if (task_grain < MIN_TASK_SIZE) {\n                    task_grain = MIN_TASK_SIZE;\n                }\n            }\n#endif\n            merge_sort_indices(a, (size_t)length, returns, work,\n                               count, task_grain);\n        }\n    }\n\n    free(work);\n    return returns;\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb) {\n    char *strings = NULL;\n    int len, offset, nbucket;\n    long int n;\n\n    if (fscanf(stdin, \"%d\", &len) != 1) {\n        printf(\"ERROR len\\n\");\n        exit(1);\n    }\n    if (fscanf(stdin, \"%ld\", &n) != 1) {\n        printf(\"ERROR n\\n\");\n        exit(1);\n    }\n    if (fscanf(stdin, \"%d\", &offset) != 1) {\n        printf(\"ERROR offset\\n\");\n        exit(1);\n    }\n    if (fscanf(stdin, \"%d\", &nbucket) != 1) {\n        printf(\"ERROR nbucket\\n\");\n        exit(1);\n    }\n\n    if (len < 0 || len == INT_MAX || n < 0 || nbucket == INT_MAX ||\n        (uintmax_t)n > (uintmax_t)SIZE_MAX) {\n        fputs(\"ERROR parameters\\n\", stderr);\n        exit(EXIT_FAILURE);\n    }\n    nbucket = nbucket + 1;\n    len = len + 1;\n    strings = checked_array_alloc((size_t)n, (size_t)len);\n\n    for (long int i = 0; i < n; ++i) {\n        if (fscanf(stdin, \"%s\", strings + (size_t)i * (size_t)len) != 1) {\n            printf(\"ERROR %ld\\n\", i);\n            exit(1);\n        }\n    }\n\n    *vString = strings;\n    *N = n;\n    *l = len;\n    *os = offset;\n    *nb = nbucket;\n}\n\nvoid print(char *strings, long int *index, long int n, int len) {\n    for (long int i = 0; i < n; ++i) {\n        printf(\"%ld -> %s\\n\", i,\n               strings + (size_t)index[i] * (size_t)len);\n    }\n}\n\nvoid save(char *strings, long int *index, long int n, int len) {\n    for (long int i = 0; i < n; ++i) {\n        printf(\"%s\\n\", strings + (size_t)index[i] * (size_t)len);\n    }\n}\n\nint main(int ac, char **av) {\n    char *strings = NULL;\n    long int N = 0;\n    long int *index = NULL;\n    int len = 0;\n    int offset, nbuckets;\n    (void)ac;\n    (void)av;\n\n    load(&strings, &N, &len, &offset, &nbuckets);\n    index = bucket_sort(strings, len, N, offset, nbuckets);\n    save(strings, index, N, len);\n\n    free(strings);\n    free(index);\n    return EXIT_SUCCESS;\n}\n",
      "path": "src/bucketsort.c"
    }
  ],
  "hypothesis": "Coarse-grained OpenMP merge-sort tasks should eliminate quadratic bucket sorting and bucket-population imbalance while exploiting the four ARM64 cores; size cutoffs should limit overhead on small inputs.",

-  return ans;\\n+\\n+    pos = hash_slot(prefix);\\n+    while (tableTags[pos] == tag && tableKeys[pos] != prefix)\\n+      pos = (pos + 1) & TABLE_MASK;\\n+    if (tableTags[pos] != tag) {\\n+      tableTags[pos] = tag;\\n+      tableKeys[pos] = prefix;\\n+      tableCounts[pos] = 1;\\n+    } else {\\n+      ++tableCounts[pos];\\n+    }\\n+  }\\n+  return result;\\n }\\n \\n int main() {\\n+  ios::sync_with_stdio(false);\\n+  cin.tie(nullptr);\\n+\\n   int k, m, n;\\n-  cin >> k >> m >> n;\\n-  memset(A, 0, sizeof A);\\n-  memset(ps, 0, sizeof ps);\\n+  if (!(cin >> k >> m >> n))\\n+    return 0;\\n \\n-  for (int i = 0; i < m; i++)\\n-    for (int j = 0; j < n; j++)\\n+  for (int i = 0; i < m; ++i)\\n+    for (int j = 0; j < n; ++j)\\n       cin >> A[i][j];\\n \\n-  cout << solve(m, n, k) << endl;\\n+  int (*view)[DIM] = A;\\n+  if (m > n) {\\n+    constexpr int BLOCK = 32;\\n+    for (int ii = 0; ii < m; ii += BLOCK) {\\n+      for (int jj = 0; jj < n; jj += BLOCK) {\\n+        const int iEnd = min(ii + BLOCK, m);\\n+        const int jEnd = min(jj + BLOCK, n);\\n+        for (int i = ii; i < iEnd; ++i)\\n+          for (int j = jj; j < jEnd; ++j)\\n+            transposed[j][i] = A[i][j];\\n+      }\\n+    }\\n+    view = transposed;\\n+  }\\n+\\n+  const int small = min(m, n);\\n+  const int large = max(m, n);\\n+  int accumulated[DIM];\\n+  ll answer = 0;\\n+\\n+  for (int top = 0; top < small; ++top) {\\n+    fill(accumulated, accumulated + large, 0);\\n+    for (int bottom = top; bottom < small; ++bottom) {\\n+      const int *row = view[bottom];\\n+      for (int x = 0; x < large; ++x)\\n+        accumulated[x] += row[x];\\n+      answer += count_subarrays(accumulated, large, k);\\n+    }\\n+  }\\n+\\n+  cout << answer << '\\\\n';\\n   return 0;\\n }\"}, {\"id\": \"e66818fd8a2f43e1\", \"role\": \"A\", \"commit\": \"52cffd2e369ab96112b052198ad74e925b0a0cc6\", \"transformations\": {\"files\": [\"src/main.cpp\"], \"retained\": [\"Store the matrix in an orientation where the smaller dimension is the paired-boundary axis and each scanned slice is contiguous.\", \"Replace 2D row-prefix construction and unordered_map counting with rolling band sums and a compact generation-tagged linear-probing prefix table.\"]}, \"mean_seconds\": 0.06140700882921616, \"diff\": \"diff --git a/src/main.cpp b/src/main.cpp\\nindex b3a5f60..419d20e 100644\\n--- a/src/main.cpp\\n+++ b/src/main.cpp\\n@@ -1,44 +1,101 @@\\n #include <bits/stdc++.h>\\n \\n using namespace std;\\n+using ll = long long;\\n \\n-int A[1000][1000];\\n-int ps[1010][1010];\\n+constexpr size_t HASH_CAPACITY = 2048;\\n+constexpr size_t HASH_MASK = HASH_CAPACITY - 1;\\n \\n-typedef long long ll;\\n+struct PrefixSlot {\\n+  ll key;\\n+  int count;\\n+  int generation;\\n+};\\n \\n-ll solve(int m, int n, int k) {\\n-  for (int i = 1; i <= m; i++) {\\n-    for (int j = 1; j <= n; j++) {\\n-      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\\n-    }\\n+static inline size_t hash_index(ll key) {\\n+  uint64_t x = static_cast<uint64_t>(key);\\n+  x ^= x >> 30;\\n+  x *= 0xbf58476d1ce4e5b9ULL;\\n+  x ^= x >> 27;\\n+  x *= 0x94d049bb133111ebULL;\\n+  x ^= x >> 31;\\n+  return static_cast<size_t>(x) & HASH_MASK;\\n+}\\n+\\n+static inline int prefix_count(const PrefixSlot *table, ll key, int generation) {\\n+  size_t pos = hash_index(key);\\n+  while (table[pos].generation == generation) {\\n+    if (table[pos].key == key)\\n+      return table[pos].count;\\n+    pos = (pos + 1) & HASH_MASK;\\n   }\\n-  unordered_map<ll, ll> h;\\n-  ll ans = 0;\\n-  for (int j = 1; j <= n; j++) // O(m*n^2)\\n-    for (int l = j; l <= n; l++) {\\n-      h.clear();\\n-      h[0] = 1;\\n-      ll s = 0;\\n-      for (int i = 1; i <= m; i++) {\\n-        s += ps[i][l] - ps[i][j - 1];\\n-        ans += h.find(s - k) != h.end() ? h[s - k] : 0;\\n-        h[s]++;\\n+  return 0;\\n+}\\n+\\n+static inline void add_prefix(PrefixSlot *table, ll key, int generation) {\\n+  size_t pos = hash_index(key);\\n+  while (table[pos].generation == generation && table[pos].key != key)\\n+    pos = (pos + 1) & HASH_MASK;\\n+  if (table[pos].generation != generation) {\\n+    table[pos].generation = generation;\\n+    table[pos].key = key;\\n+    table[pos].count = 0;\\n+  }\\n+  ++table[pos].count;\\n+}\\n+\\n+ll solve(const vector<int> &matrix, int short_dim, int long_dim, int k) {\\n+  vector<ll> band(long_dim, 0);\\n+  PrefixSlot table[HASH_CAPACITY] = {};\\n+  int generation = 0;\\n+  ll answer = 0;\\n+\\n+  for (int first = 0; first < short_dim; ++first) {\\n+    fill(band.begin(), band.end(), 0);\\n+    for (int last = first; last < short_dim; ++last) {\\n+      const int *row = matrix.data() + static_cast<size_t>(last) * long_dim;\\n+      for (int x = 0; x < long_dim; ++x)\\n+        band[x] += row[x];\\n+\\n+      ++generation;\\n+      add_prefix(table, 0, generation);\\n+      ll prefix = 0;\\n+      for (int x = 0; x < long_dim; ++x) {\\n+        prefix += band[x];\\n+        answer += prefix_count(table, prefix - k, generation);\\n+        add_prefix(table, prefix, generation);\\n       }\\n     }\\n-  return ans;\\n+  }\\n+  return answer;\\n }\\n \\n int main() {\\n+  ios::sync_with_stdio(false);\\n+  cin.tie(nullptr);\\n+\\n   int k, m, n;\\n-  cin >> k >> m >> n;\\n-  memset(A, 0, sizeof A);\\n-  memset(ps, 0, sizeof ps);\\n+  if (!(cin >> k >> m >> n))\\n+    return 0;\\n \\n-  for (int i = 0; i < m; i++)\\n-    for (int j = 0; j < n; j++)\\n-      cin >> A[i][j];\\n+  const int short_dim = min(m, n);\\n+  const int long_dim = max(m, n);\\n+  vector<int> matrix(static_cast<size_t>(short_dim) * long_dim);\\n+\\n+  if (m <= n) {\\n+    for (int i = 0; i < m; ++i)\\n+      for (int j = 0; j < n; ++j)\\n+        cin >> matrix[static_cast<size_t>(i) * long_dim + j];\\n+  } else {\\n+    for (int i = 0; i < m; ++i) {\\n+      for (int j = 0; j < n; ++j) {\\n+        int value;\\n+        cin >> value;\\n+        matrix[static_cast<size_t>(j) * long_dim + i] = value;\\n+      }\\n+    }\\n+  }\\n \\n-  cout << solve(m, n, k) << endl;\\n+  cout << solve(matrix, short_dim, long_dim, k) << '\\\\n';\\n   return 0;\\n }\"}, {\"id\": \"5afc2b0f77d3462e\", \"role\": \"B\", \"commit\": \"1c3e781f8dacf479862de9528dfb2843336d991c\", \"transformations\": {\"files\": [\"src/main.cpp\"], \"retained\": [\"Choose the smaller matrix dimension as the paired-strip dimension; transpose the input when necessary so the scanned dimension is contiguous.\", \"Replace the 2D row-prefix table with incremental strip accumulators, adding one contiguous oriented row per strip extension.\", \"Apply OpenMP SIMD only to independent accumulator elements; keep the loop-carried prefix sum and frequency-map scan sequential.\", \"Parallelize independent strip starts with per-thread scratch state and answer reduction, retaining a work-based sequential fallback.\"]}, \"mean_seconds\": 0.0917720723276337, \"diff\": \"diff --git a/src/main.cpp b/src/main.cpp\\nindex b3a5f60..0256a30 100644\\n--- a/src/main.cpp\\n+++ b/src/main.cpp\\n@@ -3,41 +3,75 @@\\n using namespace std;\\n \\n int A[1000][1000];\\n-int ps[1010][1010];\\n-\\n typedef long long ll;\\n \\n ll solve(int m, int n, int k) {\\n-  for (int i = 1; i <= m; i++) {\\n-    for (int j = 1; j <= n; j++) {\\n-      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\\n+  const int p = min(m, n);\\n+  const int q = max(m, n);\\n+\\n+  vector<int> transposed;\\n+  const int* matrix;\\n+  int stride;\\n+  if (m <= n) {\\n+    matrix = &A[0][0];\\n+    stride = 1000;\\n+  } else {\\n+    transposed.resize(static_cast<size_t>(m) * n);\\n+    for (int i = 0; i < m; i++) {\\n+      for (int j = 0; j < n; j++) {\\n+        transposed[static_cast<size_t>(j) * m + i] = A[i][j];\\n+      }\\n     }\\n+    matrix = transposed.data();\\n+    stride = q;\\n   }\\n-  unordered_map<ll, ll> h;\\n+\\n   ll ans = 0;\\n-  for (int j = 1; j <= n; j++) // O(m*n^2)\\n-    for (int l = j; l <= n; l++) {\\n-      h.clear();\\n-      h[0] = 1;\\n-      ll s = 0;\\n-      for (int i = 1; i <= m; i++) {\\n-        s += ps[i][l] - ps[i][j - 1];\\n-        ans += h.find(s - k) != h.end() ? h[s - k] : 0;\\n-        h[s]++;\\n+  const ll work = static_cast<ll>(p) * (p + 1) / 2 * q;\\n+  const bool parallel_work = p >= 8 && work >= 50000;\\n+\\n+#pragma omp parallel if(parallel_work) reduction(+:ans)\\n+  {\\n+    vector<ll> sums(q, 0);\\n+    unordered_map<ll, ll> freq;\\n+    freq.reserve(q + 1);\\n+\\n+#pragma omp for schedule(dynamic, 1)\\n+    for (int top = 0; top < p; top++) {\\n+      fill(sums.begin(), sums.end(), 0);\\n+      for (int bottom = top; bottom < p; bottom++) {\\n+        const int* row = matrix + static_cast<size_t>(bottom) * stride;\\n+\\n+        // Each column accumulator is independent; the prefix scan below is not.\\n+#pragma omp simd\\n+        for (int x = 0; x < q; x++) {\\n+          sums[x] += row[x];\\n+        }\\n+\\n+        freq.clear();\\n+        freq[0] = 1;\\n+        ll prefix = 0;\\n+        for (int x = 0; x < q; x++) {\\n+          prefix += sums[x];\\n+          auto it = freq.find(prefix - static_cast<ll>(k));\\n+          if (it != freq.end()) ans += it->second;\\n+          ++freq[prefix];\\n+        }\\n       }\\n     }\\n+  }\\n   return ans;\\n }\\n \\n int main() {\\n   int k, m, n;\\n   cin >> k >> m >> n;\\n-  memset(A, 0, sizeof A);\\n-  memset(ps, 0, sizeof ps);\\n \\n-  for (int i = 0; i < m; i++)\\n-    for (int j = 0; j < n; j++)\\n+  for (int i = 0; i < m; i++) {\\n+    for (int j = 0; j < n; j++) {\\n       cin >> A[i][j];\\n+    }\\n+  }\\n \\n   cout << solve(m, n, k) << endl;\\n   return 0;\"}, {\"id\": \"93bf143823a7441d\", \"role\": \"B\", \"commit\": \"57374fe93e6bb3875d3c18c5a32066692016e7b1\", \"transformations\": {\"files\": [\"src/main.cpp\"], \"retained\": [\"Parallelized the independent outer column-strip loop using OpenMP dynamic scheduling and a reduction for the total count.\", \"Gave each worker a private reusable frequency map; kept the row-prefix/hash scan sequential because it has loop-carried dependencies.\", \"Added a workload threshold to avoid parallel-region overhead on small inputs.\", \"Reused the iterator from the frequency lookup instead of performing a second lookup.\"]}, \"mean_seconds\": 0.09337920664499204, \"diff\": \"diff --git a/src/main.cpp b/src/main.cpp\\nindex b3a5f60..70833ba 100644\\n--- a/src/main.cpp\\n+++ b/src/main.cpp\\n@@ -13,19 +13,34 @@ ll solve(int m, int n, int k) {\\n       ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\\n     }\\n   }\\n-  unordered_map<ll, ll> h;\\n+\\n   ll ans = 0;\\n-  for (int j = 1; j <= n; j++) // O(m*n^2)\\n-    for (int l = j; l <= n; l++) {\\n-      h.clear();\\n-      h[0] = 1;\\n-      ll s = 0;\\n-      for (int i = 1; i <= m; i++) {\\n-        s += ps[i][l] - ps[i][j - 1];\\n-        ans += h.find(s - k) != h.end() ? h[s - k] : 0;\\n-        h[s]++;\\n+  const ll strip_rows = static_cast<ll>(m) * n * (n + 1) / 2;\\n+  const bool parallel_work = n >= 8 && strip_rows >= 50000;\\n+\\n+  // Different column strips are independent; each thread owns its frequency map.\\n+  // The row scan remains sequential because its prefix sum and map updates depend\\n+  // on the preceding row.\\n+#pragma omp parallel if(parallel_work) reduction(+:ans)\\n+  {\\n+    unordered_map<ll, ll> h;\\n+    h.reserve(m + 1);\\n+\\n+#pragma omp for schedule(dynamic, 1)\\n+    for (int j = 1; j <= n; j++) {\\n+      for (int l = j; l <= n; l++) {\\n+        h.clear();\\n+        h[0] = 1;\\n+        ll s = 0;\\n+        for (int i = 1; i <= m; i++) {\\n+          s += ps[i][l] - ps[i][j - 1];\\n+          auto it = h.find(s - k);\\n+          if (it != h.end()) ans += it->second;\\n+          h[s]++;\\n+        }\\n       }\\n     }\\n+  }\\n   return ans;\\n }\"}, {\"id\": \"c119c3fc00404316\", \"role\": \"C\", \"commit\": \"f40b2862c4e6fcf260cfdc50434eaae71b7093df\", \"transformations\": {\"files\": [\"src/main.cpp\"], \"retained\": [\"Parallelize the outer column loop with an OpenMP reduction for the 64-bit answer.\", \"Use schedule(static,1) to distribute the more expensive early column iterations cyclically across workers.\", \"Keep a reserved, worker-local prefix-frequency map and reuse it across assigned column pairs.\"]}, \"mean_seconds\": 0.09453666427483161, \"diff\": \"diff --git a/src/main.cpp b/src/main.cpp\\nindex b3a5f60..f23ebe0 100644\\n--- a/src/main.cpp\\n+++ b/src/main.cpp\\n@@ -13,19 +13,29 @@ ll solve(int m, int n, int k) {\\n       ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\\n     }\\n   }\\n-  unordered_map<ll, ll> h;\\n+\\n   ll ans = 0;\\n-  for (int j = 1; j <= n; j++) // O(m*n^2)\\n-    for (int l = j; l <= n; l++) {\\n-      h.clear();\\n-      h[0] = 1;\\n-      ll s = 0;\\n-      for (int i = 1; i <= m; i++) {\\n-        s += ps[i][l] - ps[i][j - 1];\\n-        ans += h.find(s - k) != h.end() ? h[s - k] : 0;\\n-        h[s]++;\\n+#pragma omp parallel reduction(+ : ans)\\n+  {\\n+    unordered_map<ll, ll> h;\\n+    h.reserve(static_cast<size_t>(m) + 1);\\n+\\n+    // Earlier columns have more pairs to scan; cyclic assignment balances that work.\\n+#pragma omp for schedule(static, 1)\\n+    for (int j = 1; j <= n; j++) {\\n+      for (int l = j; l <= n; l++) {\\n+        h.clear();\\n+        h[0] = 1;\\n+        ll s = 0;\\n+        for (int i = 1; i <= m; i++) {\\n+          s += ps[i][l] - ps[i][j - 1];\\n+          auto it = h.find(s - k);\\n+          if (it != h.end()) ans += it->second;\\n+          ++h[s];\\n+        }\\n       }\\n     }\\n+  }\\n   return ans;\\n }\"}], \"interactions\": [], \"automatic_observations\": {\"baseline\": {\"experiment_id\": \"baseline-e1\", \"outcome\": {\"binary_sha256\": \"454fa415d9543784402bc6d280f0e32ff6094e8ff10f1fbb1a27f6be446b1a5c\", \"cache_key\": \"1853c7debe786e48905abfe55f81a5df8a8a75fbf381b78f9eea76f75016f4d0\", \"commit\": \"ac6798963b13b6b7073cb45c8adc7ebcfb1a6406\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-max/results-748259/2023-sum/logs/e1/baseline-e1/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-max/results-748259/2023-sum/logs/e1/baseline-e1/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-max/results-748259/2023-sum/logs/e1/baseline-e1/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-max/results-748259/2023-sum/logs/e1/baseline-e1/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-max/results-748259/2023-sum/logs/e1/baseline-e1/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-max/results-748259/2023-sum/logs/e1/baseline-e1/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.24841478373855352, \"reason\": \"\", \"score\": 0.5, \"status\": \"valid\", \"times\": [0.24854568298906088, 0.24865652713924646, 0.24804214108735323], \"tree_hash\": \"e9cce646e10a707abcb97d717fbd0bc5f3006205\"}, \"raw_logs\": [{\"path\": \"logs/e1/baseline-e1/search/attempt-001/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": true, \"cases\": 4}}]}, \"selected_parent\": null, \"selected_base_commit\": \"ac6798963b13b6b7073cb45c8adc7ebcfb1a6406\", \"recent_own_role\": [], \"own_role_history\": [], \"node_development\": {\"attempt\": 1, \"remaining_attempts\": 3, \"previous_attempts\": [], \"confirmation_data_available\": false}}, \"documents_as_data\": [], \"deadline\": 1792135544.275677, \"generation_deadline\": 1792135544.275677, \"protocol_id\": \"f12f1cfe9d1b628f72268d7b8f47d31ee025516f16084c68068e366db57761fb\", \"remaining_tokens\": 589824, \"official_statement_as_data\": \"18th Marathon of Parallel Programming\\nSBAC-PAD & WSCAD – 2023\\nCalebe Bianchini1 and Roland Teodorowitsch2\\n1Mackenzie Presbyterian University\\n2Pontiﬁcal Catholic University of Rio Grande do Sul\\nRules for Remote Contest\\nFor all problems, read carefully the input and output session. For all problems, a sequen-\\ntial implementation is given, and it is against the output of those implementations that the\\noutput of your programs will be compared to decide if your implementation is correct.\\nYou can modify the program in any way you see ﬁt, except when the problem descrip-\\ntion states otherwise. You must upload a compressed ﬁle (zip) with your source code, the\\nMakeﬁle and an execution script. The script must have the name of the problem. You\\ncan submit as many solutions to a problem as you want. Only the last submission will\\nbe considered. The Makeﬁle must have the rule all, which will be used to compile your\\nsource code. The execution script runs your solution the way you design it – it will be\\ninspected not to corrupt the target machine.\\nThe execution time of your program will be measured running it with time program and\\ntaking the real CPU time given. Each program will be executed at least three times with\\nthe same input and the mean time will be taken into account. The sequential program\\ngiven will be measured the same way. You will earn points in each problem, correspond-\\ning to the division of the sequential time by the time of your program (speedup). The\\nteam with the most points at the end of the marathon will be declared the winner.\\nThis problem set contains 4 problems; pages are numbered from 1 to 7.\\n\\nGeneral Information\\nCompilation\\nYou should use CC or CXX inside your Makeﬁle. Be careful when redeﬁning them!\\nThere is a simple Makeﬁle inside you problem package that you can modify. Example:\\nFLAGS=-O3\\nEXEC=sum\\nCXX=icpc\\nall: $(EXEC)\\n$(EXEC):\\n$(CXX) $(FLAGS) $(EXEC).cpp -c -o $(EXEC).o\\n$(CXX) $(FLAGS) $(EXEC).o -o $(EXEC)\\nEach judge machine has its group of compilers. See them below and choose well when\\nwriting your Makeﬁle. The compiler that is tagged as default is predeﬁned in CC and\\nCXX variables.\\nmachine compiler command\\nhost GCC 13.2.0\\n(default)\\nC = gcc\\nC++ = g++\\nMPI\\nOpen MPI 4.1.2a1\\n(default)\\nC = mpicc\\nC++ = mpic++\\nGCC 13.2.0 C = gcc\\nC++ = g++\\ngpu\\nNVidia CUDA 12.0.1\\n(default)\\nC = nvcc\\nC++ = nvcc\\nGCC 8.3.1 C = gcc\\nC++ = g++\\nSubmitting\\nGeneral information\\nYou must have an execution script that has the same name of the problem. This script runs\\nyour solution the way you design it. There is a simple script inside you problem package\\nthat should be modiﬁed. Example:\\n#!/bin/bash\\n# This script runs a generic Problem A\\n# Using 32 threads and OpenMP\\nexport OMP_NUM_THREADS=32\\nOMP_NUM_THREADS=32 ./sum\\n\\nSubmitting MPI\\nIf you are planning to submit an MPI solution, you should compile usingmpiicc/mpiicpc.\\nThe script must call mpirun/mpiexec with the correct number of processes (max: 4). It\\nmust use a ﬁle called machines that are generated by the auto-judge system - do not\\ncreate it.\\n#!/bin/bash\\n# This script runs a generic Problem A\\n# Using MPI in the entire cluster (4 nodes)\\n# 'machines' file describes the nodes\\nmpirun -np 4 -machinefile machines ./sum\\nComparing times & results\\nIn your personal machine, measure the execution time of your solution using time pro-\\ngram. Add input/output redirection when collecting time. Use diff program to compare\\nthe original and your solution results. Example:\\n$ time -p ./A < original_input.txt > my_output.txt\\nreal 4.94\\nuser 0.08\\nsys 1.56\\n$ diff my_output.txt original_output.txt\\nDo not measure time and do not add input/output redirection when submitting your so-\\nlution - the auto-judge system is prepared to collect your time and compare the results.\\n\\nProblem A\\nNumber of Submatrices that Sum to k\\nLeonardo M. Takuno\\nGiven an M× N matrix A = (aij) of integers and k∈ Z, this problem1 involves counting\\nthe number of non-empty submatrices whose sums result in a given value k.\\nNote:\\n• The matrix may contain some negative numbers.\\n• Submatrix: A matrix obtained by removing some rows and/or columns from the\\nbeginning or/and from the end of a matrix.\\nFor example 1, given the following 2× 2 matrix and k = 1:\\n1 0\\n0 1\\nThe output is 6.\\nExplanation: Sum the element matrix[0][0], plus the element matrix[1][1], plus the two\\nsubmatrices line (1× 2), plus the two submatrices column (2× 1).\\nAs a second Example 2, given the following 2× 2 matrix and k = 0:\\n1 -1\\n-1 1\\nThe output is 5.\\nExplanation: Sum the two submatrices line ( 1× 2), plus the two submatrices column\\n(2× 1), plus 2× 2 submatrix.\\nYour assignment is to develop a parallel program for solving this problem.\\nInput\\nThe input contains only one test case. The ﬁrst line contains three integers: the value k\\n(−108≤ k≤ 108), the number of rows (M) and the number of columns (N) of a matrixA\\nseparated by a blank space (1≤ M, N < 1000). The next M lines contain N integers in\\neach line separated by blank space representingaij element of A (0≤ i < M, 0≤ j < N ,\\n−1000≤ aij≤ 1000).\\nThe input must be read from the standard input.\\nOutput\\nFor the test case print one line of output, and integer denoting the number of submatrices\\nthat sum to k.\\nThe output must be written to the standard output.\\n1based on LeetCode problem 1074.\\n1\\n\\nExample\\nSample input 1 Sample output 1\\n1 2 2 2\\n1 -1\\n-1 1\\n2\\n\\nProblem B\\nHighest Sum Path in Generic Tree\\nArthur F. Lorenzon\\nGiven a generic tree, your objective is to identify and calculate the path from the root to a\\nleaf that has the largest sum of node values. Each node in the tree has an associated value,\\nand a path is deﬁned as a sequence of nodes from the root to a leaf.\\nYour assignment is to develop a parallel program for solving this problem.\\nInput\\nThe ﬁrst input line has a unique integer N (1≤ N < 1500000), the number of nodes\\nin the tree. The next N lines describe the nodes. Each line begins with a decimal value\\nV (0.1≤ V ≤ 100.0), the node value, followed by an integer K (0≤ K≤ 1000), the\\nnumber of children. Then, there are K integers representing the children indices (starting\\nby 1).\\nThe input must be read from the standard input.\\nOutput\\nThe ﬁrst line must have the highest decimal value found. The second line must have the\\nindices that compose the path from the root to leaf with the highest sum. The indices must\\nbe split by Spaces and start by 1.\\nThe output must be written to the standard output.\\nExample\\nSample input 1 Sample output 1\\n5 Max Sum: 19.80\\n10.5 2 2 3 Path: 1 2 4\\n5.2 2 4 5\\n3.3 0\\n4.1 0\\n2.4 0\\n3\\n\\nProblem C\\nNPbonacci\\nRafael Castro, Wellington Martins\\nThe Fibonacci Sequence is a very well known recurrence, and we can describe any term\\nFi in the sequence, with i≥ 1, by the following:\\nFi =\\n\\n\\n\\n0, if (i = 1)\\n1, if (i = 2)\\nFi−1 + Fi−2, otherwise\\nIn the Fibonacci sequence the size of the base cases is two, the ﬁrst two values, F1 = 0\\nand F2 = 1 , are referred as base term, and any other term are constructed by using the\\nsum of the immediate two terms before.\\nAnother sequence called here asN P bonacciconsider a different set of base casesA, with\\nsize N. By consequence, any term that is not a base term, will consider the last N terms\\nin the sequence to construct its own value. But, instead of only a simple sum to construct\\nthe next term value, here is applied a weighted sum, multiplying the terms by a value\\ngiven by a list of integers P , where|P| = N. The N P bonacci can be described by the\\nfollowing:\\nF bi =\\n{\\nAi, if (i≤ N )∑N\\nk=1 F bi−k.Pk, otherwise\\nWe can notice, for example, that the N P bonacci sequence will be equal to the original\\nFibonacci, if we set N = 2, A = [0, 1] and P = [1, 1].\\nGiven the values N, H, the base cases A and the list P , compute the term F bH modulo\\n109 + 7.\\nYour assignment is to develop a parallel program for solving this problem.\\nInput\\nIn the ﬁrst line of the input you’ll receive two integers, N and H. In the second line, will\\nbe given N integers, A1A2A3...AN, representing the base cases A. In the third line and\\nlast line, will be given N integers, P1P2P3...PN, representing the list P .\\nConstraints:\\n• 1 ⩽ N ⩽ 1020;\\n• N < H ⩽ 109;\\n• 0 ⩽ Ai, Pi ⩽ 109, i = 1, . . . , N.\\nThe input must be read from the standard input.\\n4\\n\\nOutput\\nCompute the value of F bH modulo 109 + 7.\\nThe output must be written to the standard output.\\nExamples\\nSample input 1 Sample output 1\\n2 10 34\\n0 1\\n1 1\\nSample input 2 Sample output 2\\n3 50 783060858\\n2 2 2\\n1 2 1\\n5\\n\\nProblem D\\nNumber of ways to traverse a grid\\nSalles V . G. Magalhaes\\nGiven a matrix M (with dimensions NxN), the objective is to count the number of pos-\\nsible ways to traverse the matrix from cell (0,0) to cell (N− 1,N− 1), considering each\\nmove can only be done by either going to the right (increasing the x coordinate) or up\\n(increasing the y coordinate).\\nIn this version of the problem we have another restriction: some cells are blocked and,\\nthus, no path can traverse them.\\nThe proposed baseline algorithm employs dynamic programming to solve the problem.\\nYour assignment is to develop a parallel program for solving this problem.\\nInput\\nThe input has only one test case. The ﬁrst line contains two integers N and M (0 < N <\\n2× 105). N represents the dimension of the matrix and M is the number of blocked cells\\n(M < 0.01× N 2 when N is large (greater than 1000)). Then, there are M rows, each\\ncontaining the y and x coordinates of a blocked cell.\\nThe input must be read from the standard input.\\nOutput\\nThe output contains a single line. Print the number of paths from cell ( 0,0) to cell (N−\\n1,N− 1). You should print the answer modulus 1000000007 (since it may be big).\\nThe output must be written to the standard output.\\nExample\\nSample input 1 Sample output 1\\n3 1 3\\n1 0\\nSample input 2 Sample output 2\\n3 0 6\\n6\\n\\nSample input 3 Sample output 3\\n4 0 20\\n7\", \"runtime_as_data\": {\"cpu_cores\": 4, \"OMP_NUM_THREADS\": 4, \"architecture\": \"ARM64\", \"candidate_GPU\": false, \"comparison\": \"Exact output bytes against official reference\"}, \"mother_model_as_data\": {\"phase\": \"synthesis\", \"status\": \"complete\", \"guidance\": \"Integrate candidate programs from A, B, and C, starting from the current measured leader (mean 0.0270799 s; commit 1fd4abfb250cf25218001a6de1353d669e4b3c07). Check correctness for every candidate and measure complete-program runtime on the unchanged target and harness. Test combinations rather than assuming their gains add; retain only a measured, correct improvement. The baseline mean is 0.2484148 s, while prior alternatives measured 0.04187–0.09454 s, so do not assume a new integration is faster than its inputs.\", \"analysis\": \"The supplied source uses O(m·n²) band scans with an unordered_map for prefix frequencies; the baseline mean is 0.2484148 s. The best observed program, at 0.0270799 s (about 9.17× the baseline), pairs boundaries along the smaller dimension, accumulates rolling bands, uses a generation-tagged open-addressed frequency table, and dynamically parallelizes independent band starts. Other measured variants were slower, so use that leader as the comparison point and test any integration empirically. Preserve exact results for all legal inputs; the maximum answer needs 64-bit storage.\", \"origin\": \"model output from this fresh run; no operator analysis\"}, \"node_research\": {\"enabled\": true, \"corpus_documents\": 0, \"allowed_hosts\": [\"gcc.gnu.org\", \"www.openmp.org\", \"raw.githubusercontent.com\"], \"max_queries_per_action\": 2, \"max_urls_per_action\": 2, \"max_excerpt_characters\": 6000, \"arbitrary_commands\": false, \"general_web_search\": false}}, \"required_json_schema\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"hypothesis\": {\"type\": \"string\"}, \"transformations\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"sources_kept\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"enum\": [\"da32c10e9aae426b\", \"6d55b5b003ef4059\", \"e66818fd8a2f43e1\", \"5afc2b0f77d3462e\", \"93bf143823a7441d\", \"c119c3fc00404316\"]}, \"uniqueItems\": true}, \"files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"path\": {\"type\": \"string\"}, \"content\": {\"type\": \"string\"}}, \"required\": [\"path\", \"content\"]}}, \"notes\": {\"type\": \"string\"}, \"research\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"queries\": {\"type\": \"array\", \"maxItems\": 2, \"items\": {\"type\": \"string\", \"minLength\": 1, \"maxLength\": 300}}, \"urls\": {\"type\": \"array\", \"maxItems\": 2, \"items\": {\"type\": \"string\", \"minLength\": 1, \"maxLength\": 2000}}}, \"required\": [\"queries\", \"urls\"]}}, \"required\": [\"hypothesis\", \"transformations\", \"sources_kept\", \"files\", \"notes\", \"research\"]}}\n\nCURRENT SOURCE AS DATA:\n\n--- BEGIN FILE src/main.cpp ---\n#include <bits/stdc++.h>\n\nusing namespace std;\n\nint A[1000][1000];\nint ps[1010][1010];\n\ntypedef long long ll;\n\nll solve(int m, int n, int k) {\n  for (int i = 1; i <= m; i++) {\n    for (int j = 1; j <= n; j++) {\n      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\n    }\n  }\n  unordered_map<ll, ll> h;\n  ll ans = 0;\n  for (int j = 1; j <= n; j++) // O(m*n^2)\n    for (int l = j; l <= n; l++) {\n      h.clear();\n      h[0] = 1;\n      ll s = 0;\n      for (int i = 1; i <= m; i++) {\n        s += ps[i][l] - ps[i][j - 1];\n        ans += h.find(s - k) != h.end() ? h[s - k] : 0;\n        h[s]++;\n      }\n    }\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n  memset(ps, 0, sizeof ps);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n\n--- END FILE src/main.cpp ---\n"
    }

        "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <utility>\n#include <vector>\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\nnamespace {\nconstexpr uint32_t MOD = 1000000007u;\n\n#if defined(__aarch64__)\ninline uint32x4_t add_mod(uint32x4_t a, uint32x4_t b) {\n    const uint32x4_t modulus = vdupq_n_u32(MOD);\n    const uint32x4_t sum = vaddq_u32(a, b);\n    return vsubq_u32(sum, vandq_u32(vcgeq_u32(sum, modulus), modulus));\n}\n#endif\n\ninline uint32_t scan_span(uint32_t* row, int begin, int end, uint32_t left) {\n    int x = begin;\n#if defined(__aarch64__)\n    const uint32x4_t zero = vdupq_n_u32(0);\n    for (; end - x >= 4; x += 4) {\n        uint32x4_t values = vld1q_u32(row + x);\n        values = add_mod(values, vextq_u32(zero, values, 3));\n        values = add_mod(values, vextq_u32(zero, values, 2));\n        values = add_mod(values, vdupq_n_u32(left));\n        vst1q_u32(row + x, values);\n        left = vgetq_lane_u32(values, 3);\n    }\n#endif\n    for (; x < end; ++x) {\n        left += row[x];\n        if (left >= MOD) left -= MOD;\n        row[x] = left;\n    }\n    return left;\n}\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n    int n, m;\n    if (!(std::cin >> n >> m)) return 0;\n    std::vector<std::pair<int, int>> blocked;\n    blocked.reserve(m);\n    for (int c = 0; c < m; ++c) {\n        int y, x;\n        std::cin >> y >> x;\n        blocked.emplace_back(y, x);\n    }\n    std::sort(blocked.begin(), blocked.end());\n    blocked.erase(std::unique(blocked.begin(), blocked.end()), blocked.end());\n\n    std::vector<uint32_t> row(n, 0);\n    row[0] = 1;\n    std::size_t obstacle = 0;\n    for (int y = 0; y < n; ++y) {\n        int begin = 0;\n        while (obstacle < blocked.size() && blocked[obstacle].first == y) {\n            const int x = blocked[obstacle].second;\n            scan_span(row.data(), begin, x, 0);\n            row[x] = 0;\n            begin = x + 1;\n            ++obstacle;\n        }\n        scan_span(row.data(), begin, n, 0);\n    }\n    std::cout << row[n - 1] << '\\n';\n}\n",
        "path": "src/solution.cpp"
      }
    ],
    "hypothesis": "Four-cell NEON modular prefix scans over contiguous obstacle-free spans can shorten the serial DP dependency chain while retaining a single compact in-place row.",

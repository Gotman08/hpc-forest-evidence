      "content": "#include<stdio.h>\n#include<stdlib.h>\n#include<math.h>\n#include<string.h>\n\nvoid bubble_sort (double *matriz, int tam) {\n    int i, j;\n    double aux;\n\n    for (i = tam - 1; i > 0; i--) {\n        for (j = 0; j < i; j++) {\n            if (matriz[j] > matriz[j+1]) {\n                aux=matriz[j];\n                matriz[j]=matriz[j+1];\n                matriz[j+1]=aux;\n            }\n        }\n    }\n}\n\nstatic void merge_sort_contiguous(double *values, double *scratch, size_t n) {\n    size_t middle, left, right, out, i;\n\n    if (n <= 16) {\n        for (i = 1; i < n; i++) {\n            double value = values[i];\n            size_t at = i;\n            while (at > 0 && values[at-1] > value) {\n                values[at] = values[at-1];\n                at--;\n            }\n            values[at] = value;\n        }\n        return;\n    }\n\n    middle = n / 2;\n    merge_sort_contiguous(values, scratch, middle);\n    merge_sort_contiguous(values + middle, scratch + middle, n - middle);\n\n    if (!(values[middle-1] > values[middle])) {\n        return;\n    }\n\n    left = 0;\n    right = middle;\n    out = 0;\n    while (left < middle && right < n) {\n        /* Taking the left element on equality preserves signed-zero order. */\n        if (values[left] > values[right]) {\n            scratch[out++] = values[right++];\n        } else {\n            scratch[out++] = values[left++];\n        }\n    }\n    while (left < middle) {\n        scratch[out++] = values[left++];\n    }\n    while (right < n) {\n        scratch[out++] = values[right++];\n    }\n    memcpy(values, scratch, n * sizeof(*values));\n}\n\nvoid ordena_colunas(double *matriz,int lin, int col) {\n    int i;\n    size_t rows;\n    double *scratch;\n\n    if (lin < 2 || col < 1) {\n        return;\n    }\n    rows = (size_t)lin;\n    scratch = (double *)malloc(rows * sizeof(*scratch));\n\n    for (i = 0; i < col; i++) {\n        double *column = matriz + (size_t)i * rows;\n        int can_merge = scratch != NULL;\n        int j;\n\n        if (can_merge) {\n            for (j = 0; j < lin; j++) {\n                if (isnan(column[j])) {\n                    can_merge = 0;\n                    break;\n                }\n            }\n        }\n        if (can_merge) {\n            merge_sort_contiguous(column, scratch, rows);\n        } else {\n            /* Preserve bubble-sort comparisons around NaNs and on allocation failure. */\n            bubble_sort(column, lin);\n        }\n    }\n    free(scratch);\n}\n\nvoid calcula_media(double *matriz, double *vet,int lin, int col){\n    int i,j;\n    double soma;\n    for(i=0;i<col;i++){\n        soma=0;\n        for(j=0;j<lin;j++){\n            soma+=matriz[i*lin+j];\n        }\n        vet[i]=soma/lin;\n    }\n}\n\nvoid calcula_media_harmonica(double *matriz, double *vet,int lin, int col){\n    int i,j;\n    double soma;\n    for(i=0;i<col;i++){\n        soma=0;\n        for(j=0;j<lin;j++){\n            soma+=(1/(matriz[i*lin+j]));\n        }\n        vet[i]=lin/soma;\n    }\n}\n\nvoid calcula_mediana(double *matriz, double *vet, int lin, int col) {\n     int i=0;\n     if((lin-1)%2){ //Quantidade par de elementos\n         for (i = 0; i < col; i++) {\n            vet[i]=(matriz[(((i*lin)+(i+1)*lin)-1)/2]+matriz[((((i*lin)+(i+1)*lin)-1)/2)+1]);\n            vet[i]*=0.5;\n         }\n     }\n     else{ //Quantidade ímpar de elementos\n         for (i = 0; i < col; i++) {\n            vet[i]=matriz[(((i*lin)+(i+1)*lin)-1)/2];\n         }\n     }\n }\n\nstatic double moda_pairwise(const double *matriz, int lin) {\n    int i, j;\n    float conta = 0.0f, moda = 0.0f;\n\n    for (i = 0; i < lin; i++) {\n        double cont = 0.0;\n        for (j = i + 1; j < lin; j++) {\n            if (matriz[i] == matriz[j]) {\n                cont++;\n                if (cont > conta) {\n                    conta = (float)cont;\n                    moda = (float)matriz[i];\n                }\n            }\n        }\n    }\n    return conta == 0.0f ? -1.0 : (double)moda;\n}\n\n//Adaptado de https://www.clubedohardware.com.br/forums/topic/1291570-programa-em-c-que-calcula-moda-media-e-mediana/\ndouble moda_aux(double *matriz,int lin){\n    int i, j, end;\n    float conta = 0.0f, moda = 0.0f;\n\n    /* Equality runs suffice only for globally ordered, NaN-free input. */\n    for (i = 0; i < lin; i++) {\n        if (isnan(matriz[i]) || (i > 0 && matriz[i-1] > matriz[i])) {\n            return moda_pairwise(matriz, lin);\n        }\n    }\n\n    i = 0;\n    while (i < lin) {\n        end = i + 1;\n        while (end < lin && matriz[i] == matriz[end]) {\n            end++;\n        }\n\n        /*\n         * For each occurrence, the pairwise counter finishes at end-j-1.\n         * Preserve float rounding of both the maximum count and the mode.\n         * A rounded-down maximum can allow later occurrences to update it.\n         */\n        for (j = i; j < end - 1; j++) {\n            double cont = (double)(end - j - 1);\n            if (cont <= (double)conta) {\n                break;\n            }\n            conta = (float)cont;\n            moda = (float)matriz[j];\n        }\n        i = end;\n    }\n    return conta == 0.0f ? -1.0 : (double)moda;\n}\n\nvoid calcula_moda(double *matriz,double *moda,int lin, int col){\n    int i;\n    for(i=0;i<col;i++){\n        moda[i]=moda_aux(matriz+(i*lin),lin);\n    }\n}\n\nvoid calcula_variancia(double *matriz, double *media,double *variancia, int lin, int col){\n    int i,j;\n    double soma;\n    for(i=0;i<col;i++){\n        soma=0;\n        for(j=0;j<lin;j++){\n            soma+=pow((matriz[i*lin+j]-media[i]),2);\n        }\n        variancia[i]=soma/(lin-1);\n    }\n}\n\nvoid calcula_desvio_padrao(double *variancia,double *dp, int col){\n    int i;\n    for(i=0;i<col;i++){\n        dp[i]=sqrt(variancia[i]);\n    }\n}\n\nvoid calcula_coeficiente_variacao(double *media,double *dp,double *cv, int col){\n    int i;\n    for(i=0;i<col;i++){\n        cv[i]=dp[i]/media[i];\n    }\n}\n\nint main(int argc,char **argv){\n    int lin,col,i,j; // Define as variáveis de índices e dimensões\n    double *matriz,*mediana,*media,*media_har,*moda,*variancia,*dp,*cv; // Define a matriz (forma linear), vetores de medidas estatísticas\n\n    fscanf(stdin, \"%d \", &lin); // Lê a quantidade de linhas da matriz\n    fscanf(stdin, \"%d\\n\", &col); // Lê a quantidade de colunas da matriz\n\n    // Alocações\n    matriz=(double *)malloc(lin*col * sizeof(double)); // Aloca a matriz\n    media=(double *)malloc(col * sizeof(double)); // Aloca o vetor de media\n    media_har=(double *)malloc(col * sizeof(double)); // Aloca o vetor de media harmônica\n    mediana=(double *)malloc(col * sizeof(double)); // Aloca o vetor de mediana\n    moda=(double *)malloc(col * sizeof(double)); // Aloca o vetor de moda\n    variancia=(double *)malloc(col * sizeof(double)); // Aloca o vetor de variância\n    cv=(double *)malloc(col * sizeof(double)); // Aloca o vetor de coeficiente de variação\n    dp=(double *)malloc(col * sizeof(double)); // Aloca o vetor de desvio padrão\n\n    for(i=0;i<lin;i++){\n        for(j=0;j<col;j++){\n            fscanf(stdin, \"%lf \",&(matriz[j*lin+i])); // Lê os dados transpostos em uma matriz de entrada\n        }\n    }\n\n    calcula_media(matriz,media,lin,col);\n    calcula_media_harmonica(matriz,media_har,lin,col);\n    ordena_colunas(matriz,lin,col);\n    calcula_mediana(matriz,mediana,lin,col);\n    calcula_moda(matriz,moda,lin,col);\n    calcula_variancia(matriz,media,variancia,lin,col);\n    calcula_desvio_padrao(variancia,dp,col);\n    calcula_coeficiente_variacao(media,dp,cv,col);\n\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",media[i]); // Imprime as médias aritméticas de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",media_har[i]); // Imprime as médias harmônicas de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",mediana[i]); // Imprime as medianas de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",moda[i]); // Imprime as modas de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",variancia[i]); // Imprime as variâncias amostrais de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",dp[i]); // Imprime os desvios padrão de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",cv[i]); // Imprime os coeficientes de variação de cada coluna\n    printf(\"\\n\");\n\n    // Desaloca memória\n    free(matriz);\n    free(media);\n    free(media_har);\n    free(mediana);\n    free(moda);\n    free(variancia);\n    free(dp);\n    free(cv);\n}\n",
      "path": "src/est_matriz_seq.c"
    }

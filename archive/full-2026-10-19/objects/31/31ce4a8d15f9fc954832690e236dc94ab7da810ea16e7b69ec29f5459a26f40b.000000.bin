          ],
          "retained": [
            "Build a contiguous ID array once after input parsing and use it for the existing first-match linear lookup, preserving node order and duplicate-ID behavior.",
            "Pass the ID sidecar through recursive cost evaluation and release it with the existing allocations."
          ]
        },

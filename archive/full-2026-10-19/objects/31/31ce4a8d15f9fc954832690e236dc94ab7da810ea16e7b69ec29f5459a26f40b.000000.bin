    {
      "id": "0cfc47332129405f",
      "role": "A",
      "mission": {
        "base_commit": "bcacb0d56eff2a85bc99e51a61e8e0f50cd6e240",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Separating the fixed-size neighbor strings from the hot ID/value records shrinks the stride of sequential node searches and keeps cold text from occupying cache lines used for ID and value accesses.",
        "id": "0cfc47332129405f",
        "ordinal": 2,
        "parent_id": null,
        "role": "A",

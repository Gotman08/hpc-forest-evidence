          ],
          "retained": [
            "Use split key and node-index arrays in an open-addressed ID table, checking the home bucket first and probing collision candidates in groups of four for the earliest match or empty slot; preserve first-occurrence behavior for duplicate IDs.",
            "Memoize per-node costs and evaluate unresolved selected-successor paths tail-first so float accumulation order matches recursive evaluation.",
            "Keep compact ID/value node records and store fixed-size neighbor text in a separate contiguous buffer; allocate records for every positive node count."
          ]
        },

          ],
          "retained": [
            "Split hash-table keys and node indices into contiguous arrays.",
            "Retain a scalar check of the home bucket, then examine collision candidates in groups of four with an OpenMP SIMD min reduction to select the earliest match or empty slot."
          ]
        },

{"files":[{"content":"#include <cstdint>\n#include <iostream>\n#include <utility>\n#include <vector>\n\nusing namespace std;\n\ntypedef std::uint64_t word_type;\n\nclass BitGraph {\npublic:\n    explicit BitGraph(int vertexCount)\n        : vertexCount_(vertexCount),\n          wordsPerRow_((vertexCount + 63) / 64),\n          rows_(static_cast<size_t>(vertexCount) * wordsPerRow_, 0) {}\n\n    int size() const {\n        return vertexCount_;\n    }\n\n    int wordsPerRow() const {\n        return wordsPerRow_;\n    }\n\n    void setEdge(int row, int column) {\n        rows_[index(row, column >> 6)] |= word_type(1) << (column & 63);\n    }\n\n    bool getEdge(int row, int column) const {\n        return (rowWord(row, column >> 6) & (word_type(1) << (column & 63))) != 0;\n    }\n\n    word_type rowWord(int row, int word) const {\n        return rows_[index(row, word)];\n    }\n\n    // Change from M[i][j] to M[p(i)][p(j)] for a transposition p.\n    void swapCoordinates(int first, int second) {\n        if (first == second)\n            return;\n\n        for (int word = 0; word < wordsPerRow_; ++word)\n            swap(rows_[index(first, word)], rows_[index(second, word)]);\n\n        const int firstWord = first >> 6;\n        const int secondWord = second >> 6;\n        const word_type firstMask = word_type(1) << (first & 63);\n        const word_type secondMask = word_type(1) << (second & 63);\n        for (int row = 0; row < vertexCount_; ++row) {\n            word_type &firstRowWord = rows_[index(row, firstWord)];\n            word_type &secondRowWord = rows_[index(row, secondWord)];\n            const bool firstBit = (firstRowWord & firstMask) != 0;\n            const bool secondBit = (secondRowWord & secondMask) != 0;\n            if (firstBit != secondBit) {\n                firstRowWord ^= firstMask;\n                secondRowWord ^= secondMask;\n            }\n        }\n    }\n\nprivate:\n    size_t index(int row, int word) const {\n        return static_cast<size_t>(row) * wordsPerRow_ + word;\n    }\n\n    int vertexCount_;\n    int wordsPerRow_;\n    vector<word_type> rows_;\n};\n\nBitGraph readGraph();\nbool testIsomorphism(BitGraph &g1, BitGraph &g2);\nbool verifyPermutation(BitGraph &g1, BitGraph &g2, vector<int> &equivalence);\ninline void printPermutation(vector<int> &equivalence);\n\nstatic inline int popcountWord(word_type value) {\n    return __builtin_popcountll(static_cast<unsigned long long>(value));\n}\n\nstatic int countMismatches(const BitGraph &g1, const BitGraph &mappedG2) {\n    int mismatches = 0;\n    for (int i = 0; i < g1.size(); ++i) {\n        const int lastWord = i >> 6;\n        const word_type lastWordMask = ~word_type(0) >> (63 - (i & 63));\n        for (int word = 0; word <= lastWord; ++word) {\n            word_type mask = (word == lastWord) ? lastWordMask : ~word_type(0);\n            mismatches += popcountWord((g1.rowWord(i, word) ^\n                                        mappedG2.rowWord(i, word)) & mask);\n        }\n    }\n    return mismatches;\n}\n\nstatic int countAffectedMismatches(const BitGraph &g1,\n                                   const BitGraph &mappedG2,\n                                   int first, int second) {\n    int mismatches = 0;\n    const int remainder = g1.size() & 63;\n\n    for (int word = 0; word < g1.wordsPerRow(); ++word) {\n        word_type mask = ~word_type(0);\n        if (word == g1.wordsPerRow() - 1 && remainder != 0)\n            mask = (word_type(1) << remainder) - 1;\n        if ((first >> 6) == word)\n            mask &= ~(word_type(1) << (first & 63));\n        if ((second >> 6) == word)\n            mask &= ~(word_type(1) << (second & 63));\n\n        mismatches += popcountWord((g1.rowWord(first, word) ^\n                                    mappedG2.rowWord(first, word)) & mask);\n        mismatches += popcountWord((g1.rowWord(second, word) ^\n                                    mappedG2.rowWord(second, word)) & mask);\n    }\n\n    mismatches += g1.getEdge(first, first) != mappedG2.getEdge(first, first);\n    mismatches += g1.getEdge(second, second) != mappedG2.getEdge(second, second);\n    mismatches += g1.getEdge(first, second) != mappedG2.getEdge(first, second);\n    return mismatches;\n}\n\nstatic void updateMismatchesAfterSwap(const BitGraph &g1,\n                                      BitGraph &mappedG2,\n                                      vector<int> &equivalence,\n                                      int first, int second,\n                                      int &mismatches) {\n    if (first == second)\n        return;\n\n    const int oldAffected = countAffectedMismatches(g1, mappedG2, first, second);\n    swap(equivalence[first], equivalence[second]);\n    mappedG2.swapCoordinates(first, second);\n    const int newAffected = countAffectedMismatches(g1, mappedG2, first, second);\n    mismatches += newAffected - oldAffected;\n}\n\nint main() {\n    BitGraph g1 = readGraph();\n    BitGraph g2 = readGraph();\n\n    if (!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(BitGraph &g1, BitGraph &g2) {\n    vector<int> equivalence(g1.size(), 0);\n    vector<int> exchange_counter(g1.size(), 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    if (g1.size() != g2.size())\n        return false;\n\n    for (int i = 0; i < static_cast<int>(equivalence.size()); ++i)\n        equivalence[i] = i;\n\n    BitGraph mappedG2 = g2;\n    int mismatches = countMismatches(g1, mappedG2);\n    if (mismatches == 0) {\n        printPermutation(equivalence);\n        return true;\n    }\n\n    while (exchange_index < static_cast<int>(g1.size())) {\n        if (exchange_counter[exchange_index] < exchange_index) {\n            int first, second;\n            if (exchange_index % 2 == 0) {\n                first = 0;\n                second = exchange_index;\n            } else {\n                first = exchange_counter[exchange_index];\n                second = exchange_index;\n            }\n            updateMismatchesAfterSwap(g1, mappedG2, equivalence,\n                                      first, second, mismatches);\n            if (mismatches == 0) {\n                printPermutation(equivalence);\n                isomorphism_found = true;\n            }\n\n            exchange_counter[exchange_index]++;\n            exchange_index = 1;\n        } else {\n            exchange_counter[exchange_index] = 0;\n            exchange_index++;\n        }\n    }\n    return isomorphism_found;\n}\n\nBitGraph readGraph() {\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    BitGraph read(vertices);\n\n    cin >> edges;\n    for (int i = 0; i < edges; ++i) {\n        cin >> source >> destination;\n        read.setEdge(destination, source);\n        read.setEdge(source, destination);\n    }\n\n    return read;\n}\n\nbool verifyPermutation(BitGraph &g1, BitGraph &g2, vector<int> &equivalence) {\n    int mismatches = 0;\n    for (int i = 0; i < static_cast<int>(equivalence.size()); ++i) {\n        for (int j = 0; j <= i; ++j)\n            mismatches += g1.getEdge(i, j) !=\n                          g2.getEdge(equivalence[i], equivalence[j]);\n    }\n    return mismatches == 0;\n}\n\ninline void printPermutation(vector<int> &equivalence) {\n    for (auto i : equivalence)\n        cout << i << \" \";\n    cout << endl;\n}\n","path":"src/brute_isomorphism.cpp"}],"hypothesis":"Packing each adjacency row into 64-bit words should reduce proxy-bit accesses and scalar comparisons. Maintaining the target graph in permutation coordinates lets each Heap transposition update only the affected mismatch bits with XOR and popcount, while preserving diagonal checks, permutation order, and output behavior.","notes":"No documentation was requested. The packed representation stores all vertices, including diagonal entries; the mismatch count still covers exactly the lower triangle.","research":{"queries":[],"urls":[]},"sources_kept":[],"transformations":["Replaced vector-of-vector boolean adjacency storage with packed 64-bit adjacency rows.","Maintained the permuted target adjacency by swapping the two affected rows and columns after each Heap swap.","Updated the exact lower-triangle mismatch count using word-level XOR and popcount over only affected pairs; retained the original Heap enumeration and printing flow."]}
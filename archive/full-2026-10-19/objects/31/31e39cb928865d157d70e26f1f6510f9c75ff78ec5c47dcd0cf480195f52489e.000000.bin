        "content": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nint A[1000][1000];\nint ps[1010][1010];\n\ntypedef long long ll;\n\nstatic ll count_bands(int m, int n, int k, int first, int last) {\n  if (first >= last) return 0;\n\n  int j = 1;\n  int offset = first;\n  while (offset >= n - j + 1) {\n    offset -= n - j + 1;\n    ++j;\n  }\n  int l = j + offset;\n\n  unordered_map<ll, ll> h;\n  ll ans = 0;\n  for (int band = first; band < last; ++band) {\n    h.clear();\n    h[0] = 1;\n    ll s = 0;\n    for (int i = 1; i <= m; i++) {\n      s += ps[i][l] - ps[i][j - 1];\n      ans += h.find(s - k) != h.end() ? h[s - k] : 0;\n      h[s]++;\n    }\n    ++l;\n    if (l > n) {\n      ++j;\n      l = j;\n    }\n  }\n  return ans;\n}\n\nll solve(int m, int n, int k) {\n  for (int i = 1; i <= m; i++) {\n    for (int j = 1; j <= n; j++) {\n      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\n    }\n  }\n\n  const int pairs = n * (n + 1) / 2;\n  const ll work = static_cast<ll>(m) * pairs;\n  const int workers = min(4, max(1, static_cast<int>(work / 65536)));\n  if (workers == 1) return count_bands(m, n, k, 0, pairs);\n\n  ll partial[4] = {};\n  thread threads[3];\n  int launched = 1;\n  try {\n    for (; launched < workers; ++launched) {\n      const int id = launched;\n      threads[id - 1] = thread([&, id] {\n        partial[id] = count_bands(m, n, k,\n                                  pairs * id / workers,\n                                  pairs * (id + 1) / workers);\n      });\n    }\n  } catch (const system_error &) {\n    // The caller handles ranges whose workers could not be launched.\n  }\n\n  partial[0] = count_bands(m, n, k, 0, pairs / workers);\n  for (int id = launched; id < workers; ++id) {\n    partial[id] = count_bands(m, n, k,\n                             pairs * id / workers,\n                             pairs * (id + 1) / workers);\n  }\n  for (int id = 1; id < launched; ++id) {\n    threads[id - 1].join();\n  }\n\n  ll ans = 0;\n  for (int id = 0; id < workers; ++id) ans += partial[id];\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n  memset(ps, 0, sizeof ps);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n",
        "path": "src/main.cpp"
      }

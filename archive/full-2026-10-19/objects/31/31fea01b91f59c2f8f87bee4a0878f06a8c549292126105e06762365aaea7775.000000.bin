#include <bits/stdc++.h>

using namespace std;

int A[1000][1000];
int ps[1010][1010];

typedef long long ll;

ll count_column_start(int j, int m, int n, int k) {
  ll subtotal = 0;
  for (int l = j; l <= n; l++) {
    unordered_map<ll, ll> h;
    h[0] = 1;
    ll s = 0;
    for (int i = 1; i <= m; i++) {
      s += ps[i][l] - ps[i][j - 1];
      auto it = h.find(s - k);
      if (it != h.end()) subtotal += it->second;
      h[s]++;
    }
  }
  return subtotal;
}

ll solve(int m, int n, int k) {
  for (int i = 1; i <= m; i++) {
    for (int j = 1; j <= n; j++) {
      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];
    }
  }

  ll ans = 0;
  const ll estimated_work = 1LL * m * n * (n + 1) / 2;
  if (estimated_work >= 200000) {
#pragma omp parallel for schedule(static, 1) reduction(+ : ans)
    for (int j = 1; j <= n; j++) {
      ans += count_column_start(j, m, n, k);
    }
  } else {
    for (int j = 1; j <= n; j++) {
      ans += count_column_start(j, m, n, k);
    }
  }
  return ans;
}

int main() {
  int k, m, n;
  cin >> k >> m >> n;
  memset(A, 0, sizeof A);
  memset(ps, 0, sizeof ps);

  for (int i = 0; i < m; i++)
    for (int j = 0; j < n; j++)
      cin >> A[i][j];

  cout << solve(m, n, k) << endl;
  return 0;
}

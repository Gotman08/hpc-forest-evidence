#include <algorithm>
#include <cstdint>
#include <iostream>
#include <utility>
#include <vector>

#if defined(__aarch64__)
#include <arm_neon.h>
#endif

namespace {
constexpr std::uint32_t MOD = 1000000007u;

void update_diagonal(const std::uint32_t* __restrict previous,
                     std::uint32_t* __restrict current,
                     int begin, int end) {
    int row = begin;
#if defined(__aarch64__)
    const uint32x4_t modulus = vdupq_n_u32(MOD);
    for (; row + 4 <= end; row += 4) {
        const uint32x4_t left = vld1q_u32(previous + row);
        const uint32x4_t above = vld1q_u32(previous + row - 1);
        const uint32x4_t sum = vaddq_u32(left, above);
        // Each sum is below 2*MOD. Unsigned underflow makes the
        // subtracted value larger when no reduction is required.
        const uint32x4_t reduced =
            vminq_u32(sum, vsubq_u32(sum, modulus));
        vst1q_u32(current + row, reduced);
    }
#endif
    for (; row < end; ++row) {
        const std::uint32_t sum = previous[row] + previous[row - 1];
        current[row] = sum >= MOD ? sum - MOD : sum;
    }
}
}

int main() {
    std::ios::sync_with_stdio(false);
    std::cin.tie(nullptr);

    int n, m;
    if (!(std::cin >> n >> m)) {
        return 0;
    }

    std::vector<std::vector<int>> blocked_by_diagonal(2 * n - 1);
    for (int obstacle = 0; obstacle < m; ++obstacle) {
        int row, column;
        std::cin >> row >> column;
        blocked_by_diagonal[row + column].push_back(row);
    }

    // Index -1 is a permanent zero sentinel. During the growing
    // half, entries beyond the previous diagonal are still zero.
    std::vector<std::uint32_t> first(n + 1, 0);
    std::vector<std::uint32_t> second(n + 1, 0);
    std::uint32_t* previous = first.data() + 1;
    std::uint32_t* current = second.data() + 1;
    previous[0] = blocked_by_diagonal[0].empty() ? 1u : 0u;

    for (int diagonal = 1; diagonal < 2 * n - 1; ++diagonal) {
        const int begin = std::max(0, diagonal - n + 1);
        const int end = std::min(n, diagonal + 1);

        // Both predecessors belong to the preceding diagonal,
        // so every update in this interval is independent.
        update_diagonal(previous, current, begin, end);
        for (int row : blocked_by_diagonal[diagonal]) {
            current[row] = 0;
        }
        std::swap(previous, current);
    }

    std::cout << previous[n - 1] << '\n';
    return 0;
}

import importlib.util
import json
from pathlib import Path
from hpc_forest.config import validate

path = Path(__file__).parent / "payload/romeo_long_tree.py"
spec = importlib.util.spec_from_file_location("long_tree_runner", path)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
config = module.config_for("http://127.0.0.1:12345", "qwen2.5-coder:14b", "validation-only")
validate(config)
controller = object.__new__(module.Controller)
controller.config = config
plan = controller.plan()
counts = {role:sum(batch.count(role) for batch in plan) for role in "ABCG"}
assert counts == {"A":24,"B":24,"C":24,"G":16}, counts
assert sum(map(len,plan))+1 == config["budget"]["search_slots"] == 89
assert config["budget"]["max_workers"] == 1
assert config["budget"]["max_depth"] == 6
assert config["ollama"]["temperature"] == 0
assert module.MODELS == ["qwen2.5-coder:14b"]
print(json.dumps({"valid":True,"batches":len(plan),"proposals":counts,"budget":config["budget"]},indent=2))

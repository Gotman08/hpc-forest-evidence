#include <cstdio>
#include <cassert>
#include <cstddef>
#include <vector>
#include <omp.h>
#include <limits>

int main() {
    int n, s;
    if (scanf("%d%d", &n, &s) != 2) return 0;

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    const int width = n - s + 1;
    std::vector<int> matrix(static_cast<std::size_t>(n) * n);
    for (std::size_t i = 0; i < matrix.size(); ++i) {
        scanf("%d", &matrix[i]);
    }

    long long best = std::numeric_limits<long long>::min();

    #pragma omp parallel reduction(max:best)
    {
        const int tid = omp_get_thread_num();
        const int team = omp_get_num_threads();
        const int first = width * tid / team;
        const int last = width * (tid + 1) / team;

        if (first < last) {
            const int column_count = last - first + s - 1;
            std::vector<long long> column_sums(column_count, 0);

            for (int r = 0; r < s; ++r) {
                const std::size_t row = static_cast<std::size_t>(r) * n + first;
                for (int c = 0; c < column_count; ++c) {
                    column_sums[c] += matrix[row + c];
                }
            }

            for (int top = 0; top < width; ++top) {
                if (top > 0) {
                    const std::size_t leaving = static_cast<std::size_t>(top - 1) * n + first;
                    const std::size_t entering = static_cast<std::size_t>(top + s - 1) * n + first;
                    for (int c = 0; c < column_count; ++c) {
                        column_sums[c] += static_cast<long long>(matrix[entering + c]) - matrix[leaving + c];
                    }
                }

                long long sum = 0;
                for (int c = 0; c < s; ++c) sum += column_sums[c];
                if (sum > best) best = sum;

                for (int start = first + 1; start < last; ++start) {
                    const int offset = start - first;
                    sum += column_sums[offset + s - 1] - column_sums[offset - 1];
                    if (sum > best) best = sum;
                }
            }
        }
    }

    printf("%lld\n", best);
    return 0;
}

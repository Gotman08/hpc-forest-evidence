#include <iostream>
#include <vector>
#include <cstdio>
#include <algorithm>
#include <climits>

int main() {
    int n, s;
    std::cin >> n >> s;
    
    // Allocate flat matrix and prefix sum arrays
    std::vector<int> mat(n * n);
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            scanf("%d", &mat[i * n + j]);
        }
    }

    // Integral image: ps of size (n+1)*(n+1)
    std::vector<int> ps((n + 1) * (n + 1), 0);

    // First pass: row-wise prefix sums
    #pragma omp parallel for schedule(static)
    for (int i = 0; i < n; ++i) {
        int sum = 0;
        int base_ps_row = (i + 1) * (n + 1);
        int mat_row = i * n;
        for (int j = 0; j < n; ++j) {
            sum += mat[mat_row + j];
            ps[base_ps_row + j + 1] = sum;
        }
    }

    // Second pass: column-wise accumulation
    #pragma omp parallel for schedule(static)
    for (int j = 0; j < n; ++j) {
        int sum = 0;
        for (int i = 0; i < n; ++i) {
            sum += ps[(i + 1) * (n + 1) + j + 1];
            ps[(i + 1) * (n + 1) + j + 1] = sum;
        }
    }

    // Now evaluate all SxS submatrices
    int mxSum = INT_MIN;
    #pragma omp parallel for collapse(2) reduction(max:mxSum)
    for (int i = 0; i <= n - s; ++i) {
        for (int j = 0; j <= n - s; ++j) {
            int sum = ps[(i + s) * (n + 1) + (j + s)]
                    - ps[i * (n + 1) + (j + s)]
                    - ps[(i + s) * (n + 1) + j]
                    + ps[i * (n + 1) + j];
            if (sum > mxSum) mxSum = sum;
        }
    }

    printf("%d\n", mxSum);
    return 0;
}

{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <algorithm>\\n#include <cstdint>\\n#include <iostream>\\n#include <utility>\\n#include <vector>\\n\\nusing namespace std;\\n\\nstatic constexpr int MOD = 1000000007;\\n\\nstatic long long modPow(long long base, int exponent) {\\n    long long result = 1;\\n    while (exponent != 0) {\\n        if (exponent & 1) result = result * base % MOD;\\n        base = base * base % MOD;\\n        exponent >>= 1;\\n    }\\n    return result;\\n}\\n\\nint main() {\\n    ios::sync_with_stdio(false);\\n    cin.tie(nullptr);\\n\\n    int n, inputCount;\\n    if (!(cin >> n >> inputCount)) return 0;\\n\\n    vector<pair<int, int>> blocked;\\n    blocked.reserve(inputCount);\\n    for (int i = 0; i < inputCount; ++i) {\\n        int y, x;\\n        cin >> y >> x;\\n        blocked.emplace_back(y, x);\\n    }\\n    sort(blocked.begin(), blocked.end());\\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\\n\\n    const pair<int, int> start{0, 0};\\n    const pair<int, int> finish{n - 1, n - 1};\\n    if (binary_search(blocked.begin(), blocked.end(), start) ||\\n        binary_search(blocked.begin(), blocked.end(), finish)) {\\n        cout << 0 << '\\\\n';\\n        return 0;\\n    }\\n\\n    const size_t side = static_cast<size_t>(n);\\n    const size_t cells = side * side;\\n    const size_t obstacleCount = blocked.size();\\n    constexpr size_t DENSE_CELL_LIMIT = 32000000;\\n    const bool useDense = cells <= DENSE_CELL_LIMIT && obstacleCount > 64 &&\\n                          obstacleCount * obstacleCount > cells / 8;\\n\\n    if (useDense) {\\n        vector<unsigned char> isBlocked(cells, 0);\\n        for (const auto& cell : blocked) {\\n            isBlocked[static_cast<size_t>(cell.first) * side + cell.second] = 1;\\n        }\\n\\n        vector<int> dp(n, 0);\\n        dp[0] = 1;\\n        for (int y = 0; y < n; ++y) {\\n            int left = 0;\\n            const size_t row = static_cast<size_t>(y) * side;\\n            for (int x = 0; x < n; ++x) {\\n                if (isBlocked[row + x]) {\\n                    dp[x] = 0;\\n                    left = 0;\\n                } else {\\n                    int value = dp[x] + left;\\n                    if (value >= MOD) value -= MOD;\\n                    dp[x] = value;\\n                    left = value;\\n                }\\n            }\\n        }\\n        cout << dp[n - 1] << '\\\\n';\\n        return 0;\\n    }\\n\\n    vector<long long> fact(2 * n), inverseFact(2 * n);\\n    fact[0] = 1;\\n    for (int i = 1; i < 2 * n; ++i) fact[i] = fact[i - 1] * i % MOD;\\n    inverseFact.back() = modPow(fact.back(), MOD - 2);\\n    for (int i = 2 * n - 1; i > 0; --i) inverseFact[i - 1] = inverseFact[i] * i % MOD;\\n\\n    const auto choose = [&](int total, int taken) -> long long {\\n        return fact[total] * inverseFact[taken] % MOD * inverseFact[total - taken] % MOD;\\n    };\\n\\n    blocked.push_back(finish);\\n    vector<long long> ways(blocked.size());\\n    for (size_t i = 0; i < blocked.size(); ++i) {\\n        const int y = blocked[i].first;\\n        const int x = blocked[i].second;\\n        long long sum0 = 0;\\n        long long sum1 = 0;\\n        long long sum2 = 0;\\n        long long sum3 = 0;\\n        size_t j = 0;\\n        for (; j + 3 < i; j += 4) {\\n            if (blocked[j].second <= x) {\\n                const int dy = y - blocked[j].first;\\n                const int dx = x - blocked[j].second;\\n                sum0 += ways[j] * choose(dy + dx, dy) % MOD;\\n                if (sum0 >= MOD) sum0 -= MOD;\\n            }\\n            if (blocked[j + 1].second <= x) {\\n                const int dy = y - blocked[j + 1].first;\\n                const int dx = x - blocked[j + 1].second;\\n                sum1 += ways[j + 1] * choose(dy + dx, dy) % MOD;\\n                if (sum1 >= MOD) sum1 -= MOD;\\n            }\\n            if (blocked[j + 2].second <= x) {\\n                const int dy = y - blocked[j + 2].first;\\n                const int dx = x - blocked[j + 2].second;\\n                sum2 += ways[j + 2] * choose(dy + dx, dy) % MOD;\\n                if (sum2 >= MOD) sum2 -= MOD;\\n            }\\n            if (blocked[j + 3].second <= x) {\\n                const int dy = y - blocked[j + 3].first;\\n                const int dx = x - blocked[j + 3].second;\\n                sum3 += ways[j + 3] * choose(dy + dx, dy) % MOD;\\n                if (sum3 >= MOD) sum3 -= MOD;\\n            }\\n        }\\n        for (; j < i; ++j) {\\n            if (blocked[j].second <= x) {\\n                const int dy = y - blocked[j].first;\\n                const int dx = x - blocked[j].second;\\n                sum0 += ways[j] * choose(dy + dx, dy) % MOD;\\n                if (sum0 >= MOD) sum0 -= MOD;\\n            }\\n        }\\n        long long removed = sum0 + sum1 + sum2 + sum3;\\n        removed %= MOD;\\n        long long value = choose(y + x, y) - removed;\\n        if (value < 0) value += MOD;\\n        ways[i] = value;\\n    }\\n\\n    cout << ways.back() << '\\\\n';\\n}\\n\",\"path\":\"src/solution.cpp\"}],\"hypothesis\":\"Split the sparse inclusion-exclusion reduction into four independent modulo accumulators. This removes the single loop-carried accumulation dependency across groups of predecessor obstacles, exposing legal instruction-level parallelism (and potential compiler scheduling/vectorization opportunities) while preserving the same modular sum.\",\"notes\":\"The dense rolling DP remains unchanged because its left-neighbor recurrence is a true dependency and is not safely SIMD-vectorizable.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Unroll the sparse predecessor accumulation by four and use independent modular reduction lanes before combining their congruent sums.\"]}"}}

        "content": "#include \"knn.h\"\n#include <math.h>\n\ntypedef struct {\n    float distance;\n    size_t order;\n    char label;\n} Neighbor;\n\nstatic int neighbor_is_worse(const Neighbor *a, const Neighbor *b) {\n    if (a->distance > b->distance) return 1;\n    if (a->distance < b->distance) return 0;\n    return a->order > b->order;\n}\n\nstatic void sift_down(Neighbor *heap, size_t heap_size, size_t parent) {\n    for (;;) {\n        size_t child = parent * 2 + 1;\n        if (child >= heap_size) break;\n        if (child + 1 < heap_size && neighbor_is_worse(&heap[child + 1], &heap[child])) {\n            child++;\n        }\n        if (!neighbor_is_worse(&heap[child], &heap[parent])) break;\n\n        Neighbor temporary = heap[parent];\n        heap[parent] = heap[child];\n        heap[child] = temporary;\n        parent = child;\n    }\n}\n\nstatic char classify_labels(char *labels, int k) {\n    qsort(labels, (size_t)k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nstatic char serial_knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *)malloc(sizeof(char) * (size_t)k);\n    float *distances = (float *)malloc(sizeof(float) * (size_t)k);\n\n    for (int i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (int i = 0; i < n_groups; i++) {\n        const Group *group = &groups[i];\n        for (int j = 0; j < group->length; j++) {\n            float distance = euclidean_distance_no_sqrt(to_evaluate, group->points[j]);\n            for (int x = 0; x < k; x++) {\n                if (distance < distances[x] || distances[x] == -1) {\n                    for (int y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = distance;\n                    labels[x] = group->label;\n                    break;\n                }\n            }\n        }\n    }\n\n    char result = classify_labels(labels, k);\n    free(distances);\n    free(labels);\n    return result;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    Neighbor *heap = (Neighbor *)malloc(sizeof(Neighbor) * (size_t)k);\n    size_t heap_size = 0;\n    size_t order = 0;\n\n    for (int i = 0; i < n_groups; i++) {\n        const Group *group = &groups[i];\n\n        for (int j = 0; j < group->length; j++) {\n            Neighbor candidate;\n            candidate.distance = euclidean_distance_no_sqrt(to_evaluate, group->points[j]);\n            candidate.order = order++;\n            candidate.label = group->label;\n\n            /* Preserve the original selection behavior for unordered distances. */\n            if (isnan(candidate.distance)) {\n                free(heap);\n                return serial_knn(n_groups, groups, k, to_evaluate);\n            }\n\n            if (heap_size < (size_t)k) {\n                size_t position = heap_size++;\n                heap[position] = candidate;\n\n                while (position > 0) {\n                    size_t parent = (position - 1) / 2;\n                    if (!neighbor_is_worse(&heap[position], &heap[parent])) break;\n                    Neighbor temporary = heap[position];\n                    heap[position] = heap[parent];\n                    heap[parent] = temporary;\n                    position = parent;\n                }\n            } else if (neighbor_is_worse(&heap[0], &candidate)) {\n                heap[0] = candidate;\n                sift_down(heap, heap_size, 0);\n            }\n        }\n    }\n\n    char *labels = (char *)malloc(sizeof(char) * (size_t)k);\n    for (int i = 0; i < k; i++) labels[i] = -1;\n    for (size_t i = 0; i < heap_size; i++) labels[i] = heap[i].label;\n\n    char result = classify_labels(labels, k);\n    free(labels);\n    free(heap);\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    Group *groups = (Group *)malloc(sizeof(Group) * (size_t)n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}",
        "path": "src/knn.c"
      }

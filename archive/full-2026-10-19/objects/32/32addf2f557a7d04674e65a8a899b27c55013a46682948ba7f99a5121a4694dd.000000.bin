{"files":[{"content":"#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n/* Maximum size (in char) for neighbors and compute lists */\n#define MAX 100\n\ntypedef struct {\n  int id;\n  float value;\n  char neighbors[MAX];\n} Node;\n\n/* Reads input, allocates memory, and returns the graph. */\nNode* read_input(char* fname, int *n, char* list) {\n  FILE *fl;\n  int opened = 0;\n  char line[MAX * 4];\n  Node *data = NULL;\n\n  if (fname == NULL) {\n    fl = stdin;\n  } else {\n    fl = fopen(fname, \"r\");\n    opened = 1;\n  }\n\n  if (fl == NULL) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n\n  list[0] = '\\0';\n  if (fgets(line, sizeof(line), fl) == NULL ||\n      sscanf(line, \"%d %99[^\\n]\", n, list) < 1 || *n < 0) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n\n  if (*n > 0) {\n    data = (Node*) calloc((size_t) *n, sizeof(Node));\n    if (data == NULL) {\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }\n  }\n\n  for (int i = 0; i < *n; i++) {\n    if (fgets(line, sizeof(line), fl) == NULL ||\n        sscanf(line, \"%d %f %99[^\\n]\", &data[i].id, &data[i].value,\n               data[i].neighbors) < 2) {\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }\n  }\n\n  if (opened)\n    fclose(fl);\n\n  return data;\n}\n\n/* Returns the index of the first node with the given id, or -1 if absent. */\nstatic int find_by_id(Node g[], int id, int size) {\n  int i = 0;\n  while (i < size && g[i].id != id)\n    i++;\n  return i < size ? i : -1;\n}\n\n/* Selects the same successor as the original recursive computation. */\nstatic int select_successor(Node *g, int nd, int size) {\n  char aux[MAX];\n  char *saveptr = NULL;\n  char *token;\n  int best_node = -1;\n  float max = 0.0f;\n\n  strcpy(aux, g[nd].neighbors);\n  token = strtok_r(aux, \" \", &saveptr);\n  while (token != NULL) {\n    int d = find_by_id(g, atoi(token), size);\n    if (d >= 0 && max < g[d].value) {\n      max = g[d].value;\n      best_node = d;\n    }\n    token = strtok_r(NULL, \" \", &saveptr);\n  }\n\n  return best_node;\n}\n\nint main(void) {\n  char *fileN = NULL;\n  char computelist[MAX] = {0};\n  int n = -1;\n  Node *input = read_input(fileN, &n, computelist);\n  int *successor = NULL;\n  int *depth = NULL;\n  float *cost = NULL;\n  int max_level = -1;\n\n  if (n > 0) {\n    int *path = (int*) malloc((size_t) n * sizeof(int));\n    successor = (int*) malloc((size_t) n * sizeof(int));\n    depth = (int*) malloc((size_t) n * sizeof(int));\n    cost = (float*) malloc((size_t) n * sizeof(float));\n    if (path == NULL || successor == NULL || depth == NULL || cost == NULL) {\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }\n\n    for (int i = 0; i < n; i++) {\n      successor[i] = select_successor(input, i, n);\n      depth[i] = -1;\n    }\n\n    /* Determine each node's reverse topological level without recursion. */\n    for (int start = 0; start < n; start++) {\n      if (depth[start] != -1)\n        continue;\n\n      int path_len = 0;\n      int current = start;\n      while (current >= 0 && depth[current] == -1) {\n        depth[current] = -2;\n        path[path_len++] = current;\n        current = successor[current];\n      }\n\n      while (path_len > 0) {\n        int v = path[--path_len];\n        int next = successor[v];\n        if (next < 0)\n          depth[v] = 0;\n        else if (depth[next] >= 0)\n          depth[v] = depth[next] + 1;\n        else\n          depth[v] = 0;\n        if (depth[v] > max_level)\n          max_level = depth[v];\n      }\n    }\n    free(path);\n\n    int nlevels = max_level + 1;\n    int *level_count = (int*) calloc((size_t) nlevels, sizeof(int));\n    int *level_offset = (int*) malloc(((size_t) nlevels + 1) * sizeof(int));\n    int *level_cursor = (int*) malloc((size_t) nlevels * sizeof(int));\n    int *level_nodes = (int*) malloc((size_t) n * sizeof(int));\n    if (level_count == NULL || level_offset == NULL ||\n        level_cursor == NULL || level_nodes == NULL) {\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }\n\n    for (int i = 0; i < n; i++)\n      level_count[depth[i]]++;\n\n    level_offset[0] = 0;\n    for (int level = 0; level < nlevels; level++) {\n      level_offset[level + 1] = level_offset[level] + level_count[level];\n      level_cursor[level] = level_offset[level];\n    }\n    for (int i = 0; i < n; i++)\n      level_nodes[level_cursor[depth[i]]++] = i;\n\n    /* Process only sufficiently wide levels in parallel. */\n    if (level_count[max_level] >= 16) {\n      #pragma omp parallel\n      {\n        for (int level = max_level; level >= 0; level--) {\n          int start = level_offset[level];\n          int count = level_count[level];\n          if (count >= 16) {\n            #pragma omp for schedule(static)\n            for (int j = 0; j < count; j++) {\n              int v = level_nodes[start + j];\n              float result = input[v].value;\n              if (successor[v] >= 0)\n                result += cost[successor[v]];\n              cost[v] = result;\n            }\n          } else {\n            #pragma omp single\n            {\n              for (int j = 0; j < count; j++) {\n                int v = level_nodes[start + j];\n                float result = input[v].value;\n                if (successor[v] >= 0)\n                  result += cost[successor[v]];\n                cost[v] = result;\n              }\n            }\n          }\n        }\n      }\n    } else {\n      for (int level = max_level; level >= 0; level--) {\n        int start = level_offset[level];\n        int count = level_count[level];\n        for (int j = 0; j < count; j++) {\n          int v = level_nodes[start + j];\n          float result = input[v].value;\n          if (successor[v] >= 0)\n            result += cost[successor[v]];\n          cost[v] = result;\n        }\n      }\n    }\n\n    free(level_count);\n    free(level_offset);\n    free(level_cursor);\n    free(level_nodes);\n  }\n\n  for (char *c = strtok(computelist, \" \"); c != NULL;\n       c = strtok(NULL, \" \")) {\n    int nd = find_by_id(input, atoi(c), n);\n    float value = nd >= 0 ? cost[nd] : 0.0f;\n    printf(\"%s: %f\\n\", c, value);\n  }\n\n  free(successor);\n  free(depth);\n  free(cost);\n  free(input);\n  return 0;\n}\n","path":"src/graph.c"}],"hypothesis":"For the 4-thread target, processing levels with fewer than 16 ready nodes may not amortize OpenMP team and work-sharing overhead. Bypass the parallel region when the widest level is narrower, and reserve parallel work-sharing for levels with at least 16 nodes.","notes":"One work-granularity experiment; correctness and performance remain for controller evaluation. No documentation requested.","research":{"queries":[],"urls":[]},"sources_kept":[],"transformations":["Use a serial path when the widest reverse-topological level has fewer than 16 nodes, avoiding OpenMP setup for narrow workloads.","Within parallel workloads, use static work sharing only for levels of at least 16 nodes; process narrower levels in a single thread while retaining level synchronization."]}
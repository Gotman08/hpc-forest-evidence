      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <algorithm>\n#include <limits>\n#include <cstdint>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n\nstatic inline int64x2_t maximumPair(int64x2_t a, int64x2_t b) {\n    return vbslq_s64(vcgtq_s64(a, b), a, b);\n}\n#endif\n\nstatic inline std::int64_t horizontalMaximum(const std::int64_t* columns,\n                                            int n, int s) {\n    std::int64_t sum = 0;\n    #pragma omp simd reduction(+:sum)\n    for (int c = 0; c < s; ++c)\n        sum += columns[c];\n\n#if defined(__aarch64__)\n    const std::int64_t firstDifference = columns[s] - columns[0];\n    int64x2_t windows = vdupq_n_s64(sum);\n    windows = vsetq_lane_s64(sum + firstDifference, windows, 1);\n    int64x2_t previousDifference = vdupq_n_s64(firstDifference);\n    int64x2_t best0 = windows;\n    int64x2_t best1 = windows;\n    int c = s + 1;\n\n    // Each lane advances two windows using two adjacent differences.\n    for (; c + 3 < n; c += 4) {\n        const int64x2_t difference0 = vsubq_s64(\n            vld1q_s64(columns + c), vld1q_s64(columns + c - s));\n        const int64x2_t difference1 = vsubq_s64(\n            vld1q_s64(columns + c + 2), vld1q_s64(columns + c + 2 - s));\n        const int64x2_t step0 = vaddq_s64(\n            vextq_s64(previousDifference, difference0, 1), difference0);\n        const int64x2_t step1 = vaddq_s64(\n            vextq_s64(difference0, difference1, 1), difference1);\n        const int64x2_t next = vaddq_s64(windows, step0);\n        windows = vaddq_s64(next, step1);\n        best0 = maximumPair(best0, next);\n        best1 = maximumPair(best1, windows);\n        previousDifference = difference1;\n    }\n    for (; c + 1 < n; c += 2) {\n        const int64x2_t difference = vsubq_s64(\n            vld1q_s64(columns + c), vld1q_s64(columns + c - s));\n        const int64x2_t step = vaddq_s64(\n            vextq_s64(previousDifference, difference, 1), difference);\n        windows = vaddq_s64(windows, step);\n        best0 = maximumPair(best0, windows);\n        previousDifference = difference;\n    }\n\n    best0 = maximumPair(best0, best1);\n    std::int64_t rowMax = std::max(vgetq_lane_s64(best0, 0),\n                                  vgetq_lane_s64(best0, 1));\n    if (c < n) {\n        const std::int64_t last = vgetq_lane_s64(windows, 1)\n                                + columns[c] - columns[c - s];\n        rowMax = std::max(rowMax, last);\n    }\n    return rowMax;\n#else\n    std::int64_t rowMax = sum;\n    for (int c = s; c < n; ++c) {\n        sum += columns[c] - columns[c - s];\n        rowMax = std::max(rowMax, sum);\n    }\n    return rowMax;\n#endif\n}\n\nint main() {\n    int n, s;\n    std::cin >> n >> s;\n    std::vector<std::vector<int> > matrix(n, std::vector<int>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            scanf(\"%d\", &(matrix[i][j]));\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    std::vector<std::int64_t> columnSums(n, 0);\n    std::int64_t* columns = columnSums.data();\n    for (int r = 0; r < s; ++r) {\n        const int* row = matrix[r].data();\n        #pragma omp simd\n        for (int c = 0; c < n; ++c)\n            columns[c] += static_cast<std::int64_t>(row[c]);\n    }\n\n    std::int64_t mxSum = std::numeric_limits<std::int64_t>::lowest();\n    for (int top = 0; top + s <= n; ++top) {\n        const std::int64_t rowMax = horizontalMaximum(columns, n, s);\n        mxSum = std::max(mxSum, rowMax);\n\n        if (top + s < n) {\n            const int* leaving = matrix[top].data();\n            const int* entering = matrix[top + s].data();\n            #pragma omp simd\n            for (int c = 0; c < n; ++c)\n                columns[c] += static_cast<std::int64_t>(entering[c])\n                            - static_cast<std::int64_t>(leaving[c]);\n        }\n    }\n\n    printf(\"%lld\\n\", static_cast<long long>(mxSum));\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Two interleaved horizontal window recurrences permit exact ARM64 SIMD updates, shortening the serial sum and maximum dependency chains.",
  "notes": "Preserves rolling columns and I/O. Uses signed 64-bit arithmetic, bounds-safe tails, and a scalar non-AArch64 fallback. Not executed; controller evaluation required.",

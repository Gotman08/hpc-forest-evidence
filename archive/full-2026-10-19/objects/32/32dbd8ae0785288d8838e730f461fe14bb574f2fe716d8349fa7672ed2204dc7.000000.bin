      "content": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nint A[1000][1000];\nint ps[1010][1010];\n\ntypedef long long ll;\n\nstruct PrefixFrequencyTable {\n  vector<ll> keys;\n  vector<uint16_t> counts;\n  size_t mask;\n  unsigned hash_shift;\n\n  explicit PrefixFrequencyTable(size_t max_entries) {\n    size_t capacity = 1;\n    unsigned bits = 0;\n    while (capacity < 2 * max_entries) {\n      capacity <<= 1;\n      ++bits;\n    }\n    mask = capacity - 1;\n    hash_shift = 64 - bits;\n    keys.resize(capacity);\n    counts.resize(capacity);\n  }\n\n  size_t slot(ll key) const {\n    const uint64_t hash = static_cast<uint64_t>(key) *\n                          UINT64_C(11400714819323198485);\n    size_t pos = static_cast<size_t>(hash >> hash_shift);\n    while (counts[pos] != 0 && keys[pos] != key)\n      pos = (pos + 1) & mask;\n    return pos;\n  }\n\n  void reset() {\n    fill(counts.begin(), counts.end(), uint16_t(0));\n    // The empty prefix hashes to zero; zero counts mark unused slots.\n    keys[0] = 0;\n    counts[0] = 1;\n  }\n\n  uint16_t get(ll key) const {\n    return counts[slot(key)];\n  }\n\n  void increment(ll key) {\n    const size_t pos = slot(key);\n    if (counts[pos] == 0)\n      keys[pos] = key;\n    ++counts[pos];\n  }\n};\n\nll solve(int m, int n, int k) {\n  const bool pair_rows = m <= n;\n  const int bands = pair_rows ? m : n;\n  const int length = pair_rows ? n : m;\n\n  // Each boundary stores a contiguous prefix vector along the scan axis.\n  fill(ps[0], ps[0] + length, 0);\n  if (pair_rows) {\n    for (int boundary = 1; boundary <= bands; ++boundary) {\n      const int* previous = ps[boundary - 1];\n      const int* row = A[boundary - 1];\n      int* current = ps[boundary];\n      for (int i = 0; i < length; ++i)\n        current[i] = previous[i] + row[i];\n    }\n  } else {\n    for (int i = 0; i < length; ++i) {\n      int prefix = 0;\n      for (int boundary = 1; boundary <= bands; ++boundary) {\n        prefix += A[i][boundary - 1];\n        ps[boundary][i] = prefix;\n      }\n    }\n  }\n\n  const ll target = static_cast<ll>(k);\n  ll ans = 0;\n#pragma omp parallel if(bands > 1) reduction(+:ans)\n  {\n    PrefixFrequencyTable frequencies(static_cast<size_t>(length) + 1);\n#pragma omp for schedule(dynamic, 1) nowait\n    for (int first = 0; first < bands; ++first) {\n      const int* lower = ps[first];\n      for (int last = first + 1; last <= bands; ++last) {\n        const int* upper = ps[last];\n        frequencies.reset();\n        ll sum = 0;\n        for (int i = 0; i < length; ++i) {\n          sum += static_cast<ll>(upper[i]) - lower[i];\n          ans += frequencies.get(sum - target);\n          frequencies.increment(sum);\n        }\n      }\n    }\n  }\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n  memset(ps, 0, sizeof ps);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n",
      "path": "src/main.cpp"
    }
  ],
  "hypothesis": "Combining the fastest archived oriented flat-table kernel with dynamic OpenMP scheduling should accelerate counting on four ARM64 cores without reintroducing unordered_map overhead.",

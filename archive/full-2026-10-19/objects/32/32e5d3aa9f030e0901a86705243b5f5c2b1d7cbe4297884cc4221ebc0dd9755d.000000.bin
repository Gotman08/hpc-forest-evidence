$ErrorActionPreference = 'Stop'
$taskBase = 'C:\Users\nicol\Documents\Codex\2026-10-15\cr'
$incident = Join-Path $taskBase 'outputs\HPC-Forest-Etude-2020-2024-r1\reprises\incident-liaison-terra-xhigh-20261017T1726'
$script = Join-Path $incident 'observer-strict.py'
if (Test-Path -LiteralPath (Join-Path $incident 'intention-observateur.json')) { throw 'Existing launch must be reconciled' }
if ((Get-FileHash -LiteralPath $script -Algorithm SHA256).Hash.ToLower() -ne 'c2891d5a3d5ed8d5f4f4d860392bfcf852e4e9312faa977c8c9a139b925736ed') { throw 'Observer changed' }
$rows = @(Get-CimInstance Win32_Process)
if (@($rows | Where-Object { $_.CommandLine -and $_.CommandLine.Contains($script) -and $_.CommandLine.Contains('--lane') }).Count -ne 0) { throw 'Observer already running' }
$argv = @('-B','-u',$script,'--lane','r1')
@{ utc = [DateTimeOffset]::UtcNow.ToString('o'); argv = $argv; observer_only = $true } | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath (Join-Path $incident 'intention-observateur.json') -Encoding UTF8
$quotedArguments = ($argv | ForEach-Object { '"' + $_ + '"' }) -join ' '
$proc = Start-Process -FilePath (Join-Path $taskBase 'work\.venv\Scripts\python.exe') -ArgumentList $quotedArguments -WorkingDirectory $taskBase -WindowStyle Hidden -PassThru -RedirectStandardOutput (Join-Path $incident 'observateur.stdout.log') -RedirectStandardError (Join-Path $incident 'observateur.stderr.log')
@{ pid = $proc.Id; utc = [DateTimeOffset]::UtcNow.ToString('o') } | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $incident 'observateur-lancement.json') -Encoding UTF8
Write-Output ('Strict observer launcher recorded: ' + $proc.Id)

      "content": "#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <limits>\n#include <memory>\n#include <vector>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nusing Sum = std::int64_t;\n\nclass FastInput {\n    unsigned char buffer_[1u << 16];\n    std::size_t position_ = 0;\n    std::size_t length_ = 0;\n\n    int next() {\n        if (position_ == length_) {\n            length_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (length_ == 0)\n                return EOF;\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    bool readInt(int& result) {\n        int c;\n        do {\n            c = next();\n            if (c == EOF)\n                return false;\n        } while (c <= ' ');\n\n        const bool negative = c == '-';\n        if (c == '-' || c == '+')\n            c = next();\n\n        std::uint32_t magnitude = 0;\n        while (static_cast<unsigned>(c - '0') < 10u) {\n            magnitude = magnitude * 10u + static_cast<unsigned>(c - '0');\n            c = next();\n        }\n        const Sum value = negative ? -static_cast<Sum>(magnitude)\n                                   : static_cast<Sum>(magnitude);\n        result = static_cast<int>(value);\n        return true;\n    }\n};\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic inline int64x2_t maximumPair(int64x2_t a, int64x2_t b) {\n    return vbslq_s64(vcgtq_s64(a, b), a, b);\n}\n\ntemplate <bool Replace>\nstatic inline int64x2_t advancePair(const Sum* begin, const Sum* end,\n                                   Sum* expired, Sum* totals) {\n    const int64x2_t horizontal = vsubq_s64(vld1q_s64(end), vld1q_s64(begin));\n    int64x2_t total = vld1q_s64(totals);\n    if (Replace)\n        total = vsubq_s64(total, vld1q_s64(expired));\n    total = vaddq_s64(total, horizontal);\n    vst1q_s64(expired, horizontal);\n    vst1q_s64(totals, total);\n    return total;\n}\n#endif\n\ntemplate <bool Replace, bool Track>\nstatic inline Sum updateRow(const Sum* __restrict__ prefix,\n                            Sum* __restrict__ expired,\n                            Sum* __restrict__ totals,\n                            int width, int s, Sum maximum) {\n    int c = 0;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    int64x2_t best0 = vdupq_n_s64(maximum);\n    int64x2_t best1 = best0;\n    int64x2_t best2 = best0;\n    int64x2_t best3 = best0;\n\n    for (; c + 8 <= width; c += 8) {\n        const int64x2_t value0 = advancePair<Replace>(\n            prefix + c, prefix + c + s, expired + c, totals + c);\n        const int64x2_t value1 = advancePair<Replace>(\n            prefix + c + 2, prefix + c + s + 2,\n            expired + c + 2, totals + c + 2);\n        const int64x2_t value2 = advancePair<Replace>(\n            prefix + c + 4, prefix + c + s + 4,\n            expired + c + 4, totals + c + 4);\n        const int64x2_t value3 = advancePair<Replace>(\n            prefix + c + 6, prefix + c + s + 6,\n            expired + c + 6, totals + c + 6);\n        if (Track) {\n            best0 = maximumPair(best0, value0);\n            best1 = maximumPair(best1, value1);\n            best2 = maximumPair(best2, value2);\n            best3 = maximumPair(best3, value3);\n        }\n    }\n    for (; c + 2 <= width; c += 2) {\n        const int64x2_t value = advancePair<Replace>(\n            prefix + c, prefix + c + s, expired + c, totals + c);\n        if (Track)\n            best0 = maximumPair(best0, value);\n    }\n    if (Track) {\n        const int64x2_t best = maximumPair(maximumPair(best0, best1),\n                                          maximumPair(best2, best3));\n        const Sum first = vgetq_lane_s64(best, 0);\n        const Sum second = vgetq_lane_s64(best, 1);\n        if (first > maximum)\n            maximum = first;\n        if (second > maximum)\n            maximum = second;\n    }\n#endif\n    for (; c < width; ++c) {\n        const Sum horizontal = prefix[c + s] - prefix[c];\n        Sum total = totals[c];\n        if (Replace)\n            total -= expired[c];\n        total += horizontal;\n        expired[c] = horizontal;\n        totals[c] = total;\n        if (Track && total > maximum)\n            maximum = total;\n    }\n    return maximum;\n}\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.readInt(n) || !input.readInt(s))\n        return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const int width = n - s + 1;\n    std::vector<Sum> prefix(static_cast<std::size_t>(n) + 1);\n    std::vector<Sum> totals(width, 0);\n    std::unique_ptr<Sum[]> ring(\n        new Sum[static_cast<std::size_t>(s) * width]);\n\n    Sum maximum = std::numeric_limits<Sum>::lowest();\n    int slot = 0;\n    for (int row = 0; row < n; ++row) {\n        prefix[0] = 0;\n        Sum running = 0;\n        for (int c = 0; c < n; ++c) {\n            int value;\n            if (!input.readInt(value))\n                return 0;\n            running += static_cast<Sum>(value);\n            prefix[c + 1] = running;\n        }\n\n        Sum* const expired = ring.get() + static_cast<std::size_t>(slot) * width;\n        if (row < s - 1) {\n            updateRow<false, false>(prefix.data(), expired, totals.data(),\n                                    width, s, maximum);\n        } else if (row == s - 1) {\n            maximum = updateRow<false, true>(\n                prefix.data(), expired, totals.data(), width, s, maximum);\n        } else {\n            maximum = updateRow<true, true>(\n                prefix.data(), expired, totals.data(), width, s, maximum);\n        }\n        if (++slot == s)\n            slot = 0;\n    }\n\n    std::printf(\"%d\\n\", static_cast<int>(maximum));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Streaming row-prefix differences into an S-row circular buffer removes horizontal sliding dependencies, enabling independent NEON window updates and four maximum-reduction chains without storing the full matrix.",
  "notes": "All sums remain signed 64-bit. Ring entries are initialized before reuse; scalar fallback and tails cover every valid size. Not executed or measured locally.",

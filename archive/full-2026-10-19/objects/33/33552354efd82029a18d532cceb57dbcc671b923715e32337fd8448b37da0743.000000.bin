#include <bits/stdc++.h>

using namespace std;

typedef unsigned long long   ll;

const int N = 1022;

const ll mod = 1e9 + 7;

class matrix{
    public:
    int n;
    ll mat[N][N];
    ll aux[N][N];

    void change_n(int n){
        this->n = n;
    }

    matrix(int n){
        this->n = n;
    }

    void init_base(){
        for(int i = 0 ; i < n ; i++){
            for(int j = 0 ; j < n ; j++){
                mat[i][j] = 0LL;
            }
        }
    }

    void init_ident(){
        for(int i = 0 ; i < n ; i++){
            for(int j = 0 ; j < n ; j++){
                mat[i][j] = (i == j);
            }
        }
    }

    matrix(){

    }

    void multiply_impl(const matrix &rhs){
        // Accumulating at most 16 products is safe in unsigned 64-bit:
        // 16 * (mod - 1)^2 + (mod - 1) < 2^64.
        const int block_size = 16;

        for(int i = 0 ; i < n ; i++){
            ll *out = aux[i];
            const ll *left = mat[i];

            for(int j = 0 ; j < n ; j++){
                out[j] = 0LL;
            }

            for(int kb = 0 ; kb < n ; kb += block_size){
                int kend = min(kb + block_size, n);

                for(int k = kb ; k < kend ; k++){
                    ll aik = left[k];
                    const ll *rhs_row = rhs.mat[k];

                    // Each iteration reads and writes only its own j lane.
                    #pragma GCC ivdep
                    for(int j = 0 ; j < n ; j++){
                        out[j] += aik * rhs_row[j];
                    }
                }

                #pragma GCC ivdep
                for(int j = 0 ; j < n ; j++){
                    out[j] %= mod;
                }
            }
        }

        for(int i = 0 ; i < n ; i++){
            for(int j = 0 ; j < n ; j++){
                mat[i][j] = aux[i][j];
            }
        }
    }

    void multiply(matrix *rhs){
        multiply_impl(*rhs);
    }

    void multiply(matrix &rhs){
        multiply_impl(rhs);
    }

    void pow(ll p, matrix &ident){
        auto &r = ident;
        auto d = this;

        while(p){
            if(p & 1LL){
                r.multiply(d);
            }

            d->multiply(d);
            p >>= 1LL;
        }
    }

    //pass one line of matrix in the vector, put the base value too, |clause| = n + 1
    //line is 0 index based
    void add_clause(int lin, matrix &base, vector< ll > clause){
        for(int i = 0 ; i < n ; i++){
            this->mat[lin][i] = clause[i];
        }

        base.mat[lin][0] = clause[n];
    }

    void print_line(int line){
        for(int i = 0 ; i < n ; i++){
            printf("%lld ", this->mat[i][line]);
        }

        printf("\n");
    }

    void print(){
        cout << "sz = " << this->n << endl;

        for(int i = 0 ; i < n ; i++){
            for(int j = 0 ; j < n ; j++){
                cout << this->mat[i][j] << " ";
            }

            cout << endl;
        }
    }

    matrix get_answer_matrix(int e, matrix &ident, matrix &base){
        this->pow(e, ident);
        ident.multiply(base);
        return ident;
    }

    void set_base_case(int line, matrix &base, ll val){
        base.mat[line][0] = val;
    }

    ll get_answer(int line){
        return this->mat[line][0];
    }
};

matrix ans(N), base(N), ident(N);

int main(){
    ios::sync_with_stdio(false);
    cin.tie(NULL);

    int n, k;

    cin >> n >> k;

    ans.change_n(n);
    base.change_n(n);
    ident.change_n(n);

    ident.init_ident();
    base.init_base();

    vector< ll > P;
    vector< ll > A;

    for(int i = 0 ; i < n ; i++){
        ll ai;
        cin >> ai;
        A.push_back(ai);
    }

    for(int i = 0 ; i < n ; i++){
        ll pi;
        cin >> pi;
        P.push_back(pi);
    }

    P.push_back(A[n - 1]);
    ans.add_clause(0, base, P);

    for(int i = 1 ; i < n ; i++){
        vector< ll > clausei;

        for(int j = 0 ; j < n ; j++){
            if(j == i - 1){
                clausei.push_back(1);
            }else{
                clausei.push_back(0);
            }
        }

        clausei.push_back(A[n - i - 1]);
        ans.add_clause(i, base, clausei);
    }

    cout << ans.get_answer_matrix(k - n, ident, base).get_answer(0) << "\n";

    return 0;
}

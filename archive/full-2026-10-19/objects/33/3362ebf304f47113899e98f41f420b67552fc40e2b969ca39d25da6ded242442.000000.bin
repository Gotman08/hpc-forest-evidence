{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#define _POSIX_C_SOURCE 200809L\\n#include <ctype.h>\\n#include <stdint.h>\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <sys/types.h>\\n\\n/* Compact node metadata; adjacency indices are stored contiguously. */\\ntypedef struct {\\n  int id;\\n  float value;\\n  size_t edge_begin;\\n  size_t edge_count;\\n} Node;\\n\\nstatic void allocation_failure(void) {\\n  fputs(\\\"Error!\\\\n\\\", stderr);\\n  exit(1);\\n}\\n\\nstatic void *allocate_array(size_t count, size_t item_size, int clear) {\\n  if (count == 0)\\n    return NULL;\\n  if (item_size > SIZE_MAX / count)\\n    allocation_failure();\\n  void *memory = clear ? calloc(count, item_size) : malloc(count * item_size);\\n  if (memory == NULL)\\n    allocation_failure();\\n  return memory;\\n}\\n\\nstatic void reserve_array(void **array, size_t *capacity, size_t needed,\\n                          size_t item_size) {\\n  if (needed <= *capacity)\\n    return;\\n\\n  size_t new_capacity = *capacity ? *capacity : 16;\\n  while (new_capacity < needed) {\\n    if (new_capacity > SIZE_MAX / 2) {\\n      new_capacity = needed;\\n      break;\\n    }\\n    new_capacity *= 2;\\n  }\\n  if (item_size > SIZE_MAX / new_capacity)\\n    allocation_failure();\\n\\n  void *new_array = realloc(*array, new_capacity * item_size);\\n  if (new_array == NULL)\\n    allocation_failure();\\n  *array = new_array;\\n  *capacity = new_capacity;\\n}\\n\\nstatic char *next_token(char **cursor) {\\n  char *p = *cursor;\\n  while (*p != '\\\\0' && isspace((unsigned char)*p))\\n    ++p;\\n  if (*p == '\\\\0') {\\n    *cursor = p;\\n    return NULL;\\n  }\\n\\n  char *start = p;\\n  while (*p != '\\\\0' && !isspace((unsigned char)*p))\\n    ++p;\\n  if (*p != '\\\\0')\\n    *p++ = '\\\\0';\\n  *cursor = p;\\n  return start;\\n}\\n\\nstatic char *copy_string(const char *source) {\\n  size_t length = strlen(source);\\n  char *copy = allocate_array(length + 1, sizeof(*copy), 0);\\n  memcpy(copy, source, length + 1);\\n  return copy;\\n}\\n\\nstatic uint32_t hash_id(int id) {\\n  uint32_t x = (uint32_t)id;\\n  x ^= x >> 16;\\n  x *= 0x7feb352dU;\\n  x ^= x >> 15;\\n  x *= 0x846ca68bU;\\n  x ^= x >> 16;\\n  return x;\\n}\\n\\nstatic size_t *build_id_map(const Node *nodes, int n, size_t *capacity_out) {\\n  size_t capacity = 8;\\n  if ((size_t)n > SIZE_MAX / 2)\\n    allocation_failure();\\n  size_t needed = (size_t)n * 2;\\n  while (capacity < needed) {\\n    if (capacity > SIZE_MAX / 2)\\n      allocation_failure();\\n    capacity *= 2;\\n  }\\n\\n  size_t *map = allocate_array(capacity, sizeof(*map), 1);\\n  size_t mask = capacity - 1;\\n  for (int i = 0; i < n; ++i) {\\n    size_t slot = (size_t)hash_id(nodes[i].id) & mask;\\n    while (map[slot] != 0) {\\n      size_t previous = map[slot] - 1;\\n      if (nodes[previous].id == nodes[i].id)\\n        break; /* Keep the first matching ID, as the reference does. */\\n      slot = (slot + 1) & mask;\\n    }\\n    if (map[slot] == 0)\\n      map[slot] = (size_t)i + 1;\\n  }\\n\\n  *capacity_out = capacity;\\n  return map;\\n}\\n\\nstatic int find_by_id(const Node *nodes, const size_t *map, size_t capacity,\\n                      int id) {\\n  size_t mask = capacity - 1;\\n  size_t slot = (size_t)hash_id(id) & mask;\\n  while (map[slot] != 0) {\\n    size_t index = map[slot] - 1;\\n    if (nodes[index].id == id)\\n      return (int)index;\\n    slot = (slot + 1) & mask;\\n  }\\n  return -1;\\n}\\n\\nstatic int *build_chosen_neighbors(const Node *nodes, int n,\\n                                  const int *adjacency) {\\n  int *chosen = allocate_array((size_t)n, sizeof(*chosen), 0);\\n  for (int i = 0; i < n; ++i) {\\n    float maximum = 0.0f;\\n    int best = -1;\\n    size_t end = nodes[i].edge_begin + nodes[i].edge_count;\\n    for (size_t edge = nodes[i].edge_begin; edge < end; ++edge) {\\n      int neighbor = adjacency[edge];\\n      if (maximum < nodes[neighbor].value) {\\n        maximum = nodes[neighbor].value;\\n        /* The reference uses -1 as the no-recursion sentinel. */\\n        best = nodes[neighbor].id == -1 ? -1 : neighbor;\\n      }\\n    }\\n    chosen[i] = best;\\n  }\\n  return chosen;\\n}\\n\\nstatic float evaluate_cost(int root, const Node *nodes, const size_t *map,\\n                           size_t map_capacity, const int *chosen,\\n                           float *costs, unsigned char *state, size_t *stack) {\\n  int index = find_by_id(nodes, map, map_capacity, root);\\n  if (index < 0)\\n    return 0.0f;\\n  if (state[index] == 2)\\n    return costs[index];\\n\\n  /* Each node has one selected successor, so a path stack replaces recursion. */\\n  size_t top = 0;\\n  int current = index;\\n  while (current >= 0 && state[current] != 2) {\\n    state[current] = 1;\\n    stack[top++] = (size_t)current;\\n    current = chosen[current];\\n  }\\n\\n  while (top != 0) {\\n    size_t node = stack[--top];\\n    float result = nodes[node].value;\\n    int child = chosen[node];\\n    if (child >= 0)\\n      result += costs[child];\\n    costs[node] = result;\\n    state[node] = 2;\\n  }\\n  return costs[index];\\n}\\n\\nint main(void) {\\n  char *line = NULL;\\n  size_t line_capacity = 0;\\n  ssize_t line_length = getline(&line, &line_capacity, stdin);\\n  if (line_length < 0)\\n    return 0;\\n\\n  char **roots = NULL;\\n  size_t root_count = 0;\\n  size_t roots_capacity = 0;\\n  char *cursor = line;\\n  char *count_token = next_token(&cursor);\\n  if (count_token == NULL)\\n    allocation_failure();\\n  long parsed_count = strtol(count_token, NULL, 10);\\n  if (parsed_count < 0 || parsed_count > INT32_MAX)\\n    allocation_failure();\\n  int n = (int)parsed_count;\\n\\n  char *root_token;\\n  while ((root_token = next_token(&cursor)) != NULL) {\\n    reserve_array((void **)&roots, &roots_capacity, root_count + 1,\\n                  sizeof(*roots));\\n    roots[root_count++] = copy_string(root_token);\\n  }\\n  free(line);\\n  line = NULL;\\n  line_capacity = 0;\\n\\n  Node *nodes = allocate_array((size_t)n, sizeof(*nodes), 0);\\n  int *raw_neighbors = NULL;\\n  size_t raw_count = 0;\\n  size_t raw_capacity = 0;\\n\\n  for (int i = 0; i < n; ++i) {\\n    line_length = getline(&line, &line_capacity, stdin);\\n    if (line_length < 0)\\n      allocation_failure();\\n\\n    cursor = line;\\n    char *id_token = next_token(&cursor);\\n    char *value_token = next_token(&cursor);\\n    if (id_token == NULL || value_token == NULL)\\n      allocation_failure();\\n\\n    nodes[i].id = (int)strtol(id_token, NULL, 10);\\n    nodes[i].value = strtof(value_token, NULL);\\n    nodes[i].edge_begin = raw_count;\\n\\n    char *neighbor_token;\\n    while ((neighbor_token = next_token(&cursor)) != NULL) {\\n      reserve_array((void **)&raw_neighbors, &raw_capacity, raw_count + 1,\\n                    sizeof(*raw_neighbors));\\n      raw_neighbors[raw_count++] = (int)strtol(neighbor_token, NULL, 10);\\n    }\\n    nodes[i].edge_count = raw_count - nodes[i].edge_begin;\\n  }\\n  free(line);\\n\\n  size_t map_capacity;\\n  size_t *id_map = build_id_map(nodes, n, &map_capacity);\\n\\n  /* Resolve IDs once, compacting the input-order adjacency lists in place. */\\n  size_t compact_count = 0;\\n  for (int i = 0; i < n; ++i) {\\n    size_t old_begin = nodes[i].edge_begin;\\n    size_t old_end = old_begin + nodes[i].edge_count;\\n    nodes[i].edge_begin = compact_count;\\n    for (size_t edge = old_begin; edge < old_end; ++edge) {\\n      int neighbor = find_by_id(nodes, id_map, map_capacity, raw_neighbors[edge]);\\n      if (neighbor >= 0)\\n        raw_neighbors[compact_count++] = neighbor;\\n    }\\n    nodes[i].edge_count = compact_count - nodes[i].edge_begin;\\n  }\\n\\n  int *chosen = build_chosen_neighbors(nodes, n, raw_neighbors);\\n  float *costs = allocate_array((size_t)n, sizeof(*costs), 0);\\n  unsigned char *state = allocate_array((size_t)n, sizeof(*state), 1);\\n  size_t *stack = allocate_array((size_t)n, sizeof(*stack), 0);\\n\\n  for (size_t i = 0; i < root_count; ++i) {\\n    int root = (int)strtol(roots[i], NULL, 10);\\n    float result = evaluate_cost(root, nodes, id_map, map_capacity, chosen,\\n                                 costs, state, stack);\\n    printf(\\\"%s: %f\\\\n\\\", roots[i], result);\\n    free(roots[i]);\\n  }\\n\\n  free(roots);\\n  free(nodes);\\n  free(raw_neighbors);\\n  free(id_map);\\n  free(chosen);\\n  free(costs);\\n  free(state);\\n  free(stack);\\n  return 0;\\n}\\n\",\"path\":\"src/graph.c\"}],\"hypothesis\":\"Contiguous input-order adjacency lists and one-time ID resolution should reduce scattered linear scans and repeated tokenization. Sequential neighbor passes and cached iterative path evaluation may also improve locality and avoid recomputing shared paths. The baseline is only about 12 ms, so the speed benefit is an unmeasured hypothesis.\",\"notes\":\"Single source-file candidate. No build or correctness run was performed; the controller evaluates it.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Parse graph records into compact node metadata and contiguous adjacency storage, then resolve neighbor IDs once through an open-addressed first-match map while retaining input order.\",\"Preselect each node's neighbor using the original zero initial maximum, strict greater-than comparison, first-on-ties behavior, missing-ID handling, and -1 recursion sentinel.\",\"Replace repeated recursive recomputation with demand-driven memoized evaluation over an explicit path stack; preserve root tokens and six-decimal output formatting.\"]}"}}

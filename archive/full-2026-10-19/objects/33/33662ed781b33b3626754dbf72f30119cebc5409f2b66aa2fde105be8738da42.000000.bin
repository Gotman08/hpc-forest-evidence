      "content": "#include <algorithm>\n#include <cstddef>\n#include <cstring>\n#include <iostream>\n#include <iterator>\n#include <string>\n\nclass BufferedOutput\n{\npublic:\n    static const std::size_t capacity = 64u * 1024u;\n\n    explicit BufferedOutput(std::ostream& stream)\n        : stream_(stream), used_(0)\n    {\n    }\n\n    ~BufferedOutput()\n    {\n        flush();\n    }\n\n    BufferedOutput(const BufferedOutput&) = delete;\n    BufferedOutput& operator=(const BufferedOutput&) = delete;\n\n    void flush()\n    {\n        if (used_ != 0) {\n            stream_.write(buffer_, static_cast<std::streamsize>(used_));\n            used_ = 0;\n        }\n    }\n\n    void append(const char* data, std::size_t size)\n    {\n        while (size != 0) {\n            if (used_ == capacity) flush();\n            const std::size_t count = std::min(size, capacity - used_);\n            std::memcpy(buffer_ + used_, data, count);\n            used_ += count;\n            data += count;\n            size -= count;\n        }\n    }\n\n    void append_symbols(const char* symbols, std::size_t size)\n    {\n        while (size != 0) {\n            if (capacity - used_ < 2) flush();\n            const std::size_t count =\n                std::min(size, (capacity - used_) / 2);\n            char* destination = buffer_ + used_;\n#if defined(__GNUC__) && !defined(__clang__) && (__GNUC__ >= 5)\n#pragma GCC ivdep\n#endif\n            for (std::size_t i = 0; i < count; ++i) {\n                destination[2 * i] = symbols[i];\n                destination[2 * i + 1] = ' ';\n            }\n            used_ += 2 * count;\n            symbols += count;\n            size -= count;\n        }\n    }\n\nprivate:\n    std::ostream& stream_;\n    char buffer_[capacity];\n    std::size_t used_;\n};\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ' )\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v');\n    }\n};\n\ntemplate <typename String> inline auto\nremove_whitespaces(String text) -> String\n{\n    text.erase\n        (std::remove_if(text.begin(), text.end(), IsWhitespace()),\n         text.end());\n    return text;\n}\n\nstatic inline bool\nnext_formatted_permutation(char* record, std::size_t count)\n{\n    if (count < 2) return false;\n\n    std::size_t suffix = count - 1;\n    while (suffix != 0 &&\n           record[2 * suffix] >= record[2 * suffix + 2]) {\n        --suffix;\n    }\n    if (suffix == 0) return false;\n\n    const std::size_t pivot = 2 * suffix;\n    const char pivot_value = record[pivot];\n    std::size_t successor = count - 1;\n    while (successor > suffix &&\n           record[2 * successor + 2] <= pivot_value) {\n        --successor;\n    }\n    const std::size_t successor_slot = 2 * successor + 2;\n    record[pivot] = record[successor_slot];\n    record[successor_slot] = pivot_value;\n\n    const std::size_t pairs = (count - suffix) / 2;\n    const std::size_t left = 2 * suffix + 2;\n    const std::size_t right = 2 * count;\n    // Each iteration touches a disjoint pair of symbol slots.\n#if defined(__GNUC__) && !defined(__clang__) && (__GNUC__ >= 5)\n#pragma GCC ivdep\n#endif\n    for (std::size_t i = 0; i < pairs; ++i) {\n        const char temporary = record[left + 2 * i];\n        record[left + 2 * i] = record[right - 2 * i];\n        record[right - 2 * i] = temporary;\n    }\n    return true;\n}\n\nstatic void\npermutations(std::string& text, BufferedOutput& output)\n{\n    if (text.empty()) return;\n    std::sort(text.begin(), text.end());\n    const std::size_t count = text.size();\n\n    // Bound formatted-record storage independently of input length.\n    if (count > (BufferedOutput::capacity - 4) / 2) {\n        do {\n            output.append(\"[ \", 2);\n            output.append_symbols(text.data(), text.size());\n            output.append(\"]\\n\", 2);\n        } while (std::next_permutation(text.begin(), text.end()));\n        return;\n    }\n\n    std::string record(2 * count + 4, ' ');\n    char* slots = &record[0];\n    slots[0] = '[';\n    slots[2 * count + 2] = ']';\n    slots[2 * count + 3] = '\\n';\n#if defined(__GNUC__) && !defined(__clang__) && (__GNUC__ >= 5)\n#pragma GCC ivdep\n#endif\n    for (std::size_t i = 0; i < count; ++i) {\n        slots[2 * i + 2] = text[i];\n    }\n\n    do {\n        output.append(record.data(), record.size());\n    } while (next_formatted_permutation(slots, count));\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin(InStream& in) -> String\n{\n    std::istreambuf_iterator<char> begin(in), end;\n    std::string text(begin, end);\n    text = remove_whitespaces(text);\n    return text;\n}\n\nint main(int argc, char const* argv[])\n{\n    std::string text = read_text_from_stdin<std::string>(std::cin);\n    BufferedOutput output(std::cout);\n    permutations(text, output);\n    return 0;\n}\n",
      "path": "src/permutations.cc"
    }
  ],
  "hypothesis": "Maintaining formatted symbol slots eliminates repeated formatting, while disjoint-pair suffix reversal and buffered contiguous copies expose legally vectorizable work without parallelizing dependent permutations.",

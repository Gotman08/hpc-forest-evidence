{"files":[{"content":"#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <limits.h>\n#include <stdint.h>\n\n#define INPUT_CAPACITY (1u << 16)\n#define OUTPUT_CAPACITY (1u << 16)\n\ntypedef struct {\n    unsigned char data[INPUT_CAPACITY];\n    size_t position;\n    size_t length;\n} Input;\n\ntypedef struct {\n    char data[OUTPUT_CAPACITY];\n    size_t length;\n} Output;\n\nstatic void fail(void)\n{\n    exit(EXIT_FAILURE);\n}\n\nstatic int input_get(Input *input)\n{\n    if (input->position == input->length) {\n        input->length = fread(input->data, 1, sizeof(input->data), stdin);\n        input->position = 0;\n        if (input->length == 0)\n            return EOF;\n    }\n\n    return input->data[input->position++];\n}\n\nstatic int input_long(Input *input, long *value)\n{\n    int c;\n    int negative = 0;\n    unsigned long number = 0;\n    int has_digit = 0;\n\n    do {\n        c = input_get(input);\n    } while (c != EOF && c <= ' ');\n\n    if (c == EOF)\n        return 0;\n\n    if (c == '-' || c == '+') {\n        negative = (c == '-');\n        c = input_get(input);\n    }\n\n    while (c >= '0' && c <= '9') {\n        unsigned long digit = (unsigned long)(c - '0');\n        if (number > (ULONG_MAX - digit) / 10)\n            return 0;\n        number = number * 10 + digit;\n        has_digit = 1;\n        c = input_get(input);\n    }\n\n    if (!has_digit)\n        return 0;\n\n    if (negative) {\n        unsigned long limit = (unsigned long)LONG_MAX + 1UL;\n        if (number > limit)\n            return 0;\n        *value = (number == limit) ? LONG_MIN : -(long)number;\n    } else {\n        if (number > (unsigned long)LONG_MAX)\n            return 0;\n        *value = (long)number;\n    }\n\n    return 1;\n}\n\nstatic int input_token(Input *input, char *destination, size_t capacity)\n{\n    int c;\n    size_t length = 0;\n\n    do {\n        c = input_get(input);\n    } while (c != EOF && c <= ' ');\n\n    if (c == EOF)\n        return 0;\n\n    while (c > ' ') {\n        if (length + 1 >= capacity)\n            return 0;\n        destination[length++] = (char)c;\n        c = input_get(input);\n    }\n\n    destination[length] = '\\0';\n    return 1;\n}\n\nstatic char *load_strings(size_t *count, size_t *stride)\n{\n    Input input = { { 0 }, 0, 0 };\n    long declared_length;\n    long records;\n    long ignored;\n    size_t bytes;\n    char *strings;\n\n    if (!input_long(&input, &declared_length) ||\n        !input_long(&input, &records) ||\n        !input_long(&input, &ignored) ||\n        !input_long(&input, &ignored))\n        fail();\n\n    if (declared_length < 0 || records < 0 ||\n        (unsigned long)declared_length >= SIZE_MAX ||\n        (unsigned long)records > SIZE_MAX)\n        fail();\n\n    *stride = (size_t)declared_length + 1;\n    *count = (size_t)records;\n\n    if (*count != 0 && *stride > SIZE_MAX / *count)\n        fail();\n    bytes = *count * *stride;\n\n    strings = (char *)malloc(bytes == 0 ? 1 : bytes);\n    if (strings == NULL)\n        fail();\n\n    for (size_t i = 0; i < *count; ++i) {\n        char *record = strings + i * *stride;\n        memset(record, 0, *stride);\n        if (!input_token(&input, record, *stride)) {\n            free(strings);\n            fail();\n        }\n    }\n\n    return strings;\n}\n\nstatic char *radix_sort(char *keys, size_t count, size_t stride)\n{\n    char *scratch;\n    char *source;\n    char *destination;\n    size_t total;\n\n    if (count < 2 || stride < 2)\n        return keys;\n\n    total = count * stride;\n    scratch = (char *)malloc(total);\n    if (scratch == NULL)\n        fail();\n\n    source = keys;\n    destination = scratch;\n\n    for (size_t digit = stride - 1; digit-- != 0;) {\n        size_t frequencies[256] = { 0 };\n        char *slots[256];\n        char *cursor;\n        const char *record;\n\n        record = source;\n        for (size_t i = 0; i < count; ++i, record += stride)\n            ++frequencies[(unsigned char)record[digit]];\n\n        cursor = destination;\n        for (size_t value = 0; value < 256; ++value) {\n            slots[value] = cursor;\n            cursor += frequencies[value] * stride;\n        }\n\n        record = source;\n        for (size_t i = 0; i < count; ++i, record += stride) {\n            unsigned char value = (unsigned char)record[digit];\n            memcpy(slots[value], record, stride);\n            slots[value] += stride;\n        }\n\n        {\n            char *temporary = source;\n            source = destination;\n            destination = temporary;\n        }\n    }\n\n    if (source != keys) {\n        free(keys);\n        return source;\n    }\n\n    free(scratch);\n    return keys;\n}\n\nstatic void output_flush(Output *output)\n{\n    if (output->length != 0) {\n        fwrite(output->data, 1, output->length, stdout);\n        output->length = 0;\n    }\n}\n\nstatic void output_write(Output *output, const char *data, size_t length)\n{\n    while (length != 0) {\n        size_t available = sizeof(output->data) - output->length;\n        size_t chunk;\n\n        if (available == 0) {\n            output_flush(output);\n            available = sizeof(output->data);\n        }\n\n        chunk = length < available ? length : available;\n        memcpy(output->data + output->length, data, chunk);\n        output->length += chunk;\n        data += chunk;\n        length -= chunk;\n    }\n}\n\nstatic void save_strings(const char *strings, size_t count, size_t stride)\n{\n    Output output = { { 0 }, 0 };\n\n    for (size_t i = 0; i < count; ++i) {\n        const char *record = strings + i * stride;\n        size_t length = 0;\n\n        while (length < stride && record[length] != '\\0')\n            ++length;\n\n        output_write(&output, record, length);\n        if (output.length == sizeof(output.data))\n            output_flush(&output);\n        output.data[output.length++] = '\\n';\n    }\n\n    output_flush(&output);\n}\n\nint main(void)\n{\n    size_t count;\n    size_t stride;\n    char *strings = load_strings(&count, &stride);\n\n    strings = radix_sort(strings, count, stride);\n    save_strings(strings, count, stride);\n    free(strings);\n\n    return EXIT_SUCCESS;\n}\n","path":"src/bucketsort.c"}],"hypothesis":"Stable byte-wise LSD sorting of contiguous fixed-width records removes cache-unfriendly strcmp insertion loops and keeps each radix pass as sequential reads with bucket-contiguous writes.","notes":"The implementation preserves strcmp-compatible unsigned-byte lexicographic order, including shorter keys and duplicates, while buffering input and output.","research":{"queries":[],"urls":[]},"sources_kept":[],"transformations":["Replace bucket/index insertion sorting with stable ping-pong LSD radix passes over contiguous records.","Zero-pad each fixed-stride record so radix treatment after a terminator remains equivalent to strcmp.","Use buffered token input and buffered output to reduce per-record stdio overhead."]}
        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <math.h>\n#include <stdint.h>\n#include <string.h>\n\n#define SORT_RUN 16u\n#define INPUT_SLAB_DOUBLES 4096u\n#define INPUT_SLAB_ROWS 64u\n\nstatic void reference_bubble_sort(double *values, size_t n)\n{\n    size_t end, j;\n    for (end = n; end > 1; --end) {\n        for (j = 0; j + 1 < end; ++j) {\n            if (values[j] > values[j + 1]) {\n                double temporary = values[j];\n                values[j] = values[j + 1];\n                values[j + 1] = temporary;\n            }\n        }\n    }\n}\n\n/* Return the sorted buffer without requiring a final copy back. */\nstatic double *sort_column(double *values, double *scratch, size_t n,\n                           int *has_nan)\n{\n    size_t i, first, width;\n    int ordered = 1;\n    double *source = values;\n    double *destination = scratch;\n\n    *has_nan = 0;\n    for (i = 0; i < n; ++i) {\n        if (isnan(values[i])) {\n            /* Unordered comparisons make NaNs barriers in bubble sort. */\n            *has_nan = 1;\n            reference_bubble_sort(values, n);\n            return values;\n        }\n        if (i != 0 && values[i - 1] > values[i])\n            ordered = 0;\n    }\n    if (ordered)\n        return values;\n    if (scratch == NULL) {\n        reference_bubble_sort(values, n);\n        return values;\n    }\n\n    /* Strict comparisons preserve the input order of equal signed zeros. */\n    for (first = 0; first < n;) {\n        size_t remaining = n - first;\n        size_t end = first + (remaining < SORT_RUN ? remaining : SORT_RUN);\n        for (i = first + 1; i < end; ++i) {\n            double value = values[i];\n            size_t position = i;\n            while (position > first && values[position - 1] > value) {\n                values[position] = values[position - 1];\n                --position;\n            }\n            values[position] = value;\n        }\n        first = end;\n    }\n\n    for (width = SORT_RUN; width < n;) {\n        for (first = 0; first < n;) {\n            size_t remaining = n - first;\n            size_t middle = first + (remaining < width ? remaining : width);\n            size_t tail = n - middle;\n            size_t end = middle + (tail < width ? tail : width);\n\n            if (middle == end || !(source[middle - 1] > source[middle])) {\n                memcpy(destination + first, source + first,\n                       (end - first) * sizeof(double));\n            } else {\n                size_t left = first;\n                size_t right = middle;\n                size_t output = first;\n                while (left < middle && right < end) {\n                    if (source[right] < source[left])\n                        destination[output++] = source[right++];\n                    else\n                        destination[output++] = source[left++];\n                }\n                if (left < middle)\n                    memcpy(destination + output, source + left,\n                           (middle - left) * sizeof(double));\n                else if (right < end)\n                    memcpy(destination + output, source + right,\n                           (end - right) * sizeof(double));\n            }\n            first = end;\n        }\n        {\n            double *temporary = source;\n            source = destination;\n            destination = temporary;\n        }\n        if (width >= n - width)\n            break;\n        width *= 2;\n    }\n    return source;\n}\n\nstatic double mode_pairwise(const double *values, size_t n)\n{\n    size_t i, j;\n    float best = 0.0f;\n    float answer = 0.0f;\n    for (i = 0; i < n; ++i) {\n        double matches = 0.0;\n        for (j = i + 1; j < n; ++j) {\n            if (values[i] == values[j]) {\n                matches += 1.0;\n                if (matches > (double)best) {\n                    best = (float)matches;\n                    answer = (float)values[i];\n                }\n            }\n        }\n    }\n    return best == 0.0f ? -1.0 : (double)answer;\n}\n\nstatic double mode_runs(const double *values, size_t n)\n{\n    size_t first = 0;\n    float best = 0.0f;\n    float answer = 0.0f;\n\n    while (first < n) {\n        size_t end = first + 1;\n        size_t candidate = first;\n        size_t matches;\n        while (end < n && values[end] == values[first])\n            ++end;\n        matches = end - first - 1;\n\n        /* Preserve both float conversions, even for very long runs.\n           Later first occurrences have decreasing successor counts. */\n        while ((double)matches > (double)best) {\n            best = (float)matches;\n            answer = (float)values[candidate];\n            ++candidate;\n            --matches;\n        }\n        first = end;\n    }\n    return best == 0.0f ? -1.0 : (double)answer;\n}\n\nint main(void)\n{\n    int lin, col;\n    size_t rows, columns, r, c, metric;\n    size_t slab_rows, workspace_count;\n    double *matriz, *statistics, *workspace;\n    double *media, *media_har, *mediana, *moda, *variancia, *dp, *cv;\n    int status = EXIT_FAILURE;\n\n    if (fscanf(stdin, \"%d %d\", &lin, &col) != 2)\n        return EXIT_FAILURE;\n    if (col == 0) {\n        for (metric = 0; metric < 7; ++metric)\n            printf(\"\\n\");\n        return EXIT_SUCCESS;\n    }\n    if (lin <= 0 || col < 0)\n        return EXIT_FAILURE;\n\n    rows = (size_t)lin;\n    columns = (size_t)col;\n    if (rows > SIZE_MAX / columns ||\n        rows * columns > SIZE_MAX / sizeof(double) ||\n        columns > SIZE_MAX / (7u * sizeof(double)))\n        return EXIT_FAILURE;\n\n    matriz = (double *)malloc(rows * columns * sizeof(double));\n    statistics = (double *)malloc(7u * columns * sizeof(double));\n    if (matriz == NULL || statistics == NULL) {\n        free(matriz);\n        free(statistics);\n        return EXIT_FAILURE;\n    }\n    media = statistics;\n    media_har = statistics + columns;\n    mediana = statistics + 2u * columns;\n    moda = statistics + 3u * columns;\n    variancia = statistics + 4u * columns;\n    dp = statistics + 5u * columns;\n    cv = statistics + 6u * columns;\n    for (c = 0; c < columns; ++c) {\n        media[c] = 0.0;\n        media_har[c] = 0.0;\n    }\n\n    /* Bound staging to 32 KiB, then reuse its allocation for merging. */\n    slab_rows = INPUT_SLAB_DOUBLES / columns;\n    if (slab_rows > INPUT_SLAB_ROWS)\n        slab_rows = INPUT_SLAB_ROWS;\n    if (slab_rows > rows)\n        slab_rows = rows;\n    if (slab_rows < 2 || columns == 1)\n        slab_rows = 0;\n    workspace_count = rows;\n    if (slab_rows * columns > workspace_count)\n        workspace_count = slab_rows * columns;\n    workspace = (double *)malloc(workspace_count * sizeof(double));\n    if (workspace == NULL)\n        slab_rows = 0;\n\n    if (slab_rows != 0) {\n        size_t first_row = 0;\n        while (first_row < rows) {\n            size_t count = rows - first_row;\n            if (count > slab_rows)\n                count = slab_rows;\n            for (r = 0; r < count; ++r) {\n                for (c = 0; c < columns; ++c) {\n                    if (fscanf(stdin, \"%lf \",\n                               workspace + r * columns + c) != 1)\n                        goto cleanup;\n                }\n            }\n            for (c = 0; c < columns; ++c) {\n                double *column = matriz + c * rows + first_row;\n                double soma = media[c];\n                double reciprocal_sum = media_har[c];\n                for (r = 0; r < count; ++r) {\n                    double value = workspace[r * columns + c];\n                    column[r] = value;\n                    soma += value;\n                    reciprocal_sum += 1.0 / value;\n                }\n                media[c] = soma;\n                media_har[c] = reciprocal_sum;\n            }\n            first_row += count;\n        }\n    } else {\n        for (r = 0; r < rows; ++r) {\n            for (c = 0; c < columns; ++c) {\n                double value;\n                if (fscanf(stdin, \"%lf \", &value) != 1)\n                    goto cleanup;\n                matriz[c * rows + r] = value;\n                media[c] += value;\n                media_har[c] += 1.0 / value;\n            }\n        }\n    }\n\n    for (c = 0; c < columns; ++c) {\n        int has_nan;\n        const double *column;\n        double soma = 0.0;\n\n        media[c] = media[c] / lin;\n        media_har[c] = lin / media_har[c];\n        column = sort_column(matriz + c * rows, workspace, rows, &has_nan);\n        if (rows % 2 == 0) {\n            mediana[c] = column[rows / 2 - 1] + column[rows / 2];\n            mediana[c] *= 0.5;\n        } else {\n            mediana[c] = column[rows / 2];\n        }\n        moda[c] = has_nan ? mode_pairwise(column, rows)\n                          : mode_runs(column, rows);\n        for (r = 0; r < rows; ++r)\n            soma += pow((column[r] - media[c]), 2);\n        variancia[c] = soma / (lin - 1);\n        dp[c] = sqrt(variancia[c]);\n        cv[c] = dp[c] / media[c];\n    }\n\n    for (metric = 0; metric < 7; ++metric) {\n        for (c = 0; c < columns; ++c)\n            printf(\"%.1lf \", statistics[metric * columns + c]);\n        printf(\"\\n\");\n    }\n    status = EXIT_SUCCESS;\n\ncleanup:\n    free(workspace);\n    free(statistics);\n    free(matriz);\n    return status;\n}\n",
        "path": "src/est_matriz_seq.c"
      }

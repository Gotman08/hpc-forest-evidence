{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <algorithm>\\n#include <cstddef>\\n#include <cstdio>\\n#include <iostream>\\n#include <iterator>\\n#include <string>\\n\\nclass BufferedOutput\\n{\\n    enum { buffer_capacity = 64 * 1024 };\\n    char buffer_[buffer_capacity];\\n    std::size_t used_;\\n\\npublic:\\n    BufferedOutput () : used_ (0) {}\\n\\n    ~BufferedOutput ()\\n    {\\n        flush () ;\\n    }\\n\\n    void put (char c)\\n    {\\n        if (used_ == buffer_capacity) flush () ;\\n        buffer_[used_++] = c;\\n    }\\n\\n    void flush ()\\n    {\\n        if (used_ != 0) {\\n            std::fwrite (buffer_, 1, used_, stdout) ;\\n            used_ = 0;\\n        }\\n    }\\n} ;\\n\\nstruct PrintPermutation\\n{\\n    BufferedOutput& output;\\n\\n    explicit PrintPermutation (BufferedOutput& out) : output (out) {}\\n\\n    auto operator () (const std::string& text) const -> void\\n    {\\n        output.put ('[') ;\\n        output.put (' ') ;\\n        for (std::string::const_iterator it = text.begin (); it != text.end (); ++it) {\\n            output.put (*it) ;\\n            output.put (' ') ;\\n        }\\n        output.put (']') ;\\n        output.put ('\\\\n') ;\\n    }\\n} ;\\n\\nstruct IsWhitespace\\n{\\n    template <typename Char> auto\\n    operator () (Char c) const -> bool\\n    {\\n        return (c == ' ' )\\n            || (c == '\\\\n')\\n            || (c == '\\\\r')\\n            || (c == '\\\\t')\\n            || (c == '\\\\f')\\n            || (c == '\\\\v') ;\\n    }\\n} ;\\n\\ntemplate <typename String> inline auto\\nremove_whitespaces (String text) -> String\\n{\\n    text.erase\\n        ( std::remove_if\\n            ( text.begin ()\\n            , text.end ()\\n            , IsWhitespace () )\\n        , text.end () ) ;\\n    return text;\\n}\\n\\ninline auto\\nnext_permutation (std::string& text) -> bool\\n{\\n    if (text.size () < 2) return false;\\n\\n    std::size_t suffix = text.size ();\\n    while ((suffix > 1) && (text[suffix - 2] >= text[suffix - 1])) {\\n        --suffix;\\n    }\\n    if (suffix == 1) return false;\\n\\n    const std::size_t pivot = suffix - 2;\\n    std::size_t successor = text.size () - 1;\\n    while (text[successor] <= text[pivot]) {\\n        --successor;\\n    }\\n    std::swap (text[pivot], text[successor]);\\n    std::reverse (text.begin () + (suffix - 1), text.end ()) ;\\n    return true;\\n}\\n\\ntemplate <typename String, typename Function> inline auto\\npermutations (String text, Function driver) -> void\\n{\\n    if (text.empty ()) return;\\n    std::sort (text.begin (), text.end ()) ;\\n    do {\\n        driver (text) ;\\n    } while (next_permutation (text)) ;\\n}\\n\\ntemplate <typename String, typename InStream> inline auto\\nread_text_from_stdin (InStream& in) -> String\\n{\\n    std::istreambuf_iterator <char> begin (in), end ;\\n    std::string text (begin, end) ;\\n    text = remove_whitespaces (text) ;\\n    return text;\\n}\\n\\nint main (int argc, char const *argv [])\\n{\\n    std::ios::sync_with_stdio (false) ;\\n    std::cin.tie (nullptr) ;\\n    std::string text = read_text_from_stdin <std::string> (std::cin) ;\\n    BufferedOutput output;\\n    permutations (text, PrintPermutation (output)) ;\\n    return 0;\\n}\\n\",\"path\":\"src/permutations.cc\"}],\"hypothesis\":\"A fixed-size contiguous output buffer avoids per-character stream overhead without retaining the full output. A string-specific indexed successor loop may also reduce branch and iterator overhead while preserving lexicographic order for all multiset inputs.\",\"notes\":\"One bounded source-only candidate; output memory is capped at 64 KiB in addition to the input string. No benchmark-specific assumptions.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Replace per-character iostream insertion and per-line flushing with a reusable 64 KiB buffer flushed through fwrite.\",\"Replace generic iterator-based successor helpers with an in-place indexed lexicographic successor over the contiguous string.\"]}"}}

            "src/knn.h"
          ],
          "retained": [
            "Store each group's coordinates in one allocation with separate contiguous x and y planes; hoist query coordinates and scan those planes in the distance loop.",
            "Keep at most k candidates in a max-heap ordered by squared distance and original encounter index, preserving first-encounter ties and -1 padding for underfilled k.",
            "Use the baseline sorted-array selection path if a computed distance is NaN; retain the existing label sort and vote logic."
          ]
        },

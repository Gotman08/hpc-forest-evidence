    {
      "id": "b8ef4612bfa446e5",
      "role": "B",
      "mission": {
        "base_commit": "6b1b2038b20f18fe7697bcd5f6c6f4f7b746b5d3",
        "delegation_parent": "R/B",
        "depth": 2,
        "epoch": 1,
        "hypothesis": "The top-k insertion search must preserve first-match order, so a SIMD min-index reduction that scans every slot can lose to a scalar early exit. Replacing the dependent overlapping shifts with memmove may let the target C library use optimized vector moves while preserving exact order.",
        "id": "b8ef4612bfa446e5",
        "ordinal": 2,
        "parent_id": "e5e8945252b049fd",
        "role": "B",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/knn.c"
          ],
          "retained": [
            "Restore the scalar early-exit scan for the first eligible top-k slot, preserving the same strict comparison and encounter-order tie behavior.",
            "Replace the descending overlapping shifts of the distance and label arrays with memmove calls, guarded when there is no tail to shift."
          ]
        },
        "tree_id": "e1:B",
        "trial_id": "01M5431ZFZ6QSSJ0G2TG4EWV4K",

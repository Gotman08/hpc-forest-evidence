        "depth": 1,
        "epoch": 1,
        "hypothesis": "For inputs with many points and a comparatively small k, a bounded max-heap should reduce candidate selection from O(P·k) shifting to O(P log k), while keeping the active candidate set limited to O(k) storage.",
        "id": "718bf7eca1eb4d80",
        "ordinal": 1,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/knn.c"
          ],
          "retained": [
            "Replace sorted-array insertion and shifts with a max-heap of at most k candidates, ordered by (distance, encounter index).",
            "Preserve label voting and underfilled-k sentinel behavior, and fall back to the original selection algorithm for NaN distances."
          ]
        },

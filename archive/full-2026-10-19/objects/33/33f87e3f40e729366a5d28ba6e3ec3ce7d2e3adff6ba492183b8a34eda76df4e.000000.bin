          "integration_sources": [],
          "hypothesis_as_declared_by_model": "A contiguous one-row DP improves memory locality and avoids the quadratic blocked-cell matrix; when the deduplicated obstacle count is small, a sparse combinatorial recurrence avoids scanning the whole grid.",
          "transformations_as_declared_by_model": {
            "files": [
              "src/solution.cpp"
            ],
            "retained": [
              "Replace the N×N blocked matrix and two-row DP with a contiguous one-dimensional rolling DP that scans obstacles in row-major order.",
              "For small deduplicated obstacle sets, count paths using sorted obstacle coordinates and factorial-based binomial coefficients, subtracting paths through earlier blocked cells.",
              "Handle blocked endpoints and duplicate obstacle coordinates explicitly; retain dense DP as a fallback when the sparse pairwise recurrence is not expected to pay off."
            ]

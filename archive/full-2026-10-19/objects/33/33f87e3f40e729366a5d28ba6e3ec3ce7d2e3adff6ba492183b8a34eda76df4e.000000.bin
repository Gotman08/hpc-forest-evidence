          "integration_sources": [],
          "hypothesis_as_declared_by_model": "For sufficiently wide grids on the four-core target, partitioning each row into four chunks lets OpenMP workers compute local segmented prefix sums concurrently; a small carry pass between chunks then corrects the prefixes without parallelizing dependent cells directly. A serial path avoids OpenMP overhead for smaller grids.",
          "transformations_as_declared_by_model": {
            "files": [
              "src/solution.cpp"
            ],
            "retained": [
              "Store blocked columns in sorted, deduplicated per-row lists instead of allocating an N-by-N blocked matrix.",
              "Use a serial rolling-row recurrence for N < 8192.",
              "For larger N, work-share four local segmented scans per row, propagate chunk carries, and adjust each chunk's prefix before advancing to the next row."
            ]

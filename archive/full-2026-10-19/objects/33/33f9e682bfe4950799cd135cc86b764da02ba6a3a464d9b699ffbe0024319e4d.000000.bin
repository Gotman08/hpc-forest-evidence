{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <stdint.h>\\n\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\nstatic void *allocate_array(size_t count, size_t width) {\\n    if (width != 0 && count > SIZE_MAX / width) {\\n        fputs(\\\"ERROR allocation\\\\n\\\", stderr);\\n        exit(EXIT_FAILURE);\\n    }\\n\\n    size_t bytes = count * width;\\n    void *memory = malloc(bytes == 0 ? 1 : bytes);\\n    if (memory == NULL) {\\n        fputs(\\\"ERROR allocation\\\\n\\\", stderr);\\n        exit(EXIT_FAILURE);\\n    }\\n    return memory;\\n}\\n\\nstatic void merge_index_runs(const char *restrict strings, size_t stride,\\n                             const long int *restrict source,\\n                             long int *restrict destination,\\n                             size_t first, size_t middle, size_t last) {\\n    if (first == middle || middle == last) {\\n        memcpy(destination + first, source + first,\\n               (last - first) * sizeof(*destination));\\n        return;\\n    }\\n\\n    if (strcmp(strings + (size_t)source[middle - 1] * stride,\\n               strings + (size_t)source[middle] * stride) <= 0) {\\n        memcpy(destination + first, source + first,\\n               (last - first) * sizeof(*destination));\\n        return;\\n    }\\n\\n    size_t left = first;\\n    size_t right = middle;\\n    size_t output = first;\\n\\n    /* Merge positions depend on preceding comparisons: keep this scalar. */\\n    while (left < middle && right < last) {\\n        long int left_index = source[left];\\n        long int right_index = source[right];\\n        if (strcmp(strings + (size_t)left_index * stride,\\n                   strings + (size_t)right_index * stride) <= 0) {\\n            destination[output++] = left_index;\\n            ++left;\\n        } else {\\n            destination[output++] = right_index;\\n            ++right;\\n        }\\n    }\\n\\n    if (left < middle) {\\n        memcpy(destination + output, source + left,\\n               (middle - left) * sizeof(*destination));\\n    } else if (right < last) {\\n        memcpy(destination + output, source + right,\\n               (last - right) * sizeof(*destination));\\n    }\\n}\\n\\nstatic void sort_index_range(const char *restrict strings, size_t stride,\\n                             long int *restrict index,\\n                             long int *restrict scratch,\\n                             size_t first, size_t last) {\\n    const size_t count = last - first;\\n\\n    /* Every iteration initializes a distinct index. */\\n#ifdef _OPENMP\\n#pragma omp simd\\n#elif defined(__GNUC__)\\n#pragma GCC ivdep\\n#endif\\n    for (size_t i = first; i < last; ++i)\\n        index[i] = (long int)i;\\n\\n    if (count < 2)\\n        return;\\n\\n    long int *source = index;\\n    long int *destination = scratch;\\n    size_t width = 1;\\n\\n    while (width < count) {\\n        size_t left = first;\\n        while (left < last) {\\n            size_t remaining = last - left;\\n            size_t middle = left + (remaining < width ? remaining : width);\\n            remaining = last - middle;\\n            size_t right = middle + (remaining < width ? remaining : width);\\n\\n            merge_index_runs(strings, stride, source, destination,\\n                             left, middle, right);\\n            left = right;\\n        }\\n\\n        long int *temporary = source;\\n        source = destination;\\n        destination = temporary;\\n\\n        /* Avoid overflowing width when the final pass is complete. */\\n        if (width >= count - width)\\n            break;\\n        width += width;\\n    }\\n\\n    if (source != index)\\n        memcpy(index + first, source + first, count * sizeof(*index));\\n}\\n\\n#ifdef _OPENMP\\nstatic void parallel_sort_indices(const char *strings, size_t stride,\\n                                  long int *index, long int *scratch,\\n                                  size_t count, int workers) {\\n    size_t cut[5];\\n    size_t base = count / (size_t)workers;\\n    size_t extra = count % (size_t)workers;\\n    cut[0] = 0;\\n    for (int run = 0; run < workers; ++run)\\n        cut[run + 1] = cut[run] + base + ((size_t)run < extra);\\n\\n#pragma omp parallel num_threads(workers) default(none) shared(strings, stride, index, scratch, count, cut, workers)\\n    {\\n        /* Both buffers are partitioned into disjoint ranges. */\\n#pragma omp for schedule(static)\\n        for (int run = 0; run < workers; ++run)\\n            sort_index_range(strings, stride, index, scratch,\\n                             cut[run], cut[run + 1]);\\n\\n        long int *source = index;\\n        long int *destination = scratch;\\n\\n        for (int span = 1; span < workers; span *= 2) {\\n#pragma omp for schedule(static)\\n            for (int run = 0; run < workers; run += 2 * span) {\\n                int middle_run = run + span;\\n                int last_run = run + 2 * span;\\n                if (middle_run > workers)\\n                    middle_run = workers;\\n                if (last_run > workers)\\n                    last_run = workers;\\n                merge_index_runs(strings, stride, source, destination,\\n                                 cut[run], cut[middle_run], cut[last_run]);\\n            }\\n            /* The worksharing barrier completes all writes before swapping. */\\n            long int *temporary = source;\\n            source = destination;\\n            destination = temporary;\\n        }\\n\\n        if (source != index) {\\n#pragma omp for simd schedule(static)\\n            for (size_t i = 0; i < count; ++i)\\n                index[i] = source[i];\\n        }\\n    }\\n}\\n#endif\\n\\nlong int *bucket_sort(char *a, int length, long int size,\\n                      int offset, int nbuckets) {\\n    /* Global strcmp ordering does not require balanced character buckets. */\\n    (void)offset;\\n    (void)nbuckets;\\n\\n    if (size <= 0)\\n        return NULL;\\n\\n    size_t count = (size_t)size;\\n    long int *index = allocate_array(count, sizeof(*index));\\n    if (count == 1) {\\n        index[0] = 0;\\n        return index;\\n    }\\n    long int *scratch = allocate_array(count, sizeof(*scratch));\\n\\n#ifdef _OPENMP\\n    int workers = 1;\\n    if (count >= 65536 && !omp_in_parallel()) {\\n        workers = omp_get_max_threads();\\n        if (workers > 4)\\n            workers = 4;\\n    }\\n    if (workers > 1) {\\n        parallel_sort_indices(a, (size_t)length, index, scratch,\\n                              count, workers);\\n    } else {\\n        sort_index_range(a, (size_t)length, index, scratch, 0, count);\\n    }\\n#else\\n    sort_index_range(a, (size_t)length, index, scratch, 0, count);\\n#endif\\n\\n    free(scratch);\\n    return index;\\n}\\n\\nvoid load(char **vString, long int *N, int *l, int *os, int *nb) {\\n    char *strings = NULL;\\n    int len, offset, nbucket;\\n    long int n;\\n\\n    if (!fscanf(stdin, \\\"%d\\\", &len)) {\\n        printf(\\\"ERROR len\\\\n\\\");\\n        exit(1);\\n    }\\n\\n    if (!fscanf(stdin, \\\"%ld\\\", &n)) {\\n        printf(\\\"ERROR n\\\\n\\\");\\n        exit(1);\\n    }\\n\\n    if (!fscanf(stdin, \\\"%d\\\", &offset)) {\\n        printf(\\\"ERROR offset\\\\n\\\");\\n        exit(1);\\n    }\\n\\n    if (!fscanf(stdin, \\\"%d\\\", &nbucket)) {\\n        printf(\\\"ERROR nbucket\\\\n\\\");\\n        exit(1);\\n    }\\n\\n    nbucket = nbucket + 1;\\n    len = len + 1;\\n    strings = allocate_array((size_t)n, (size_t)len);\\n\\n    for (long int i = 0; i < n; ++i) {\\n        if (!fscanf(stdin, \\\"%s\\\", strings + (size_t)i * (size_t)len)) {\\n            printf(\\\"ERROR %ld\\\\n\\\", i);\\n            exit(1);\\n        }\\n    }\\n\\n    *vString = strings;\\n    *N = n;\\n    *l = len;\\n    *os = offset;\\n    *nb = nbucket;\\n}\\n\\nvoid print(char *strings, long int *index, long int n, int len) {\\n    for (long int i = 0; i < n; ++i)\\n        printf(\\\"%ld -> %s\\\\n\\\", i,\\n               strings + (size_t)index[i] * (size_t)len);\\n}\\n\\nvoid save(char *strings, long int *index, long int n, int len) {\\n    for (long int i = 0; i < n; ++i)\\n        printf(\\\"%s\\\\n\\\", strings + (size_t)index[i] * (size_t)len);\\n}\\n\\nint main(int ac, char **av) {\\n    char *strings = NULL;\\n    long int N = 0;\\n    long int *index = NULL;\\n    int len = 0, offset, nbuckets;\\n\\n    (void)ac;\\n    (void)av;\\n\\n    load(&strings, &N, &len, &offset, &nbuckets);\\n    index = bucket_sort(strings, len, N, offset, nbuckets);\\n    save(strings, index, N, len);\\n\\n    free(strings);\\n    free(index);\\n    return EXIT_SUCCESS;\\n}\\n\",\"path\":\"src/bucketsort.c\"}],\"hypothesis\":\"Stable bottom-up index merging should eliminate quadratic insertion-sort dependencies while exposing independent initialization and contiguous copies to legal SIMD optimization on ARM64.\",\"notes\":\"Unmeasured proposal; no commands executed. OpenMP requires existing build support; otherwise sorting remains serial. Token text, strcmp ordering and output formatting are preserved.\",\"sources_kept\":[],\"transformations\":[\"Replace fixed-capacity buckets and insertion sorting with stable ping-pong merge sorting of indices.\",\"Use restrict-qualified buffers and memcpy for ordered runs and remaining tails; keep comparison-dependent merging scalar.\",\"When OpenMP is enabled, sort disjoint runs using at most four workers above a 65,536-element cutoff, followed by barrier-separated merge rounds.\",\"Apply SIMD directives only to independent index initialization and copy-back; free scratch storage after every call.\"]}"}}

y individual transformation.\", \"outcome\": {\"binary_sha256\": \"31da4ae243ecca0fca3f541d845e6d7a22fb957dab092e94cc0dfb65b0388236\", \"cache_key\": \"213795207f8a047f1f91badbec19d8223e8f95b01a6914dace25b65f87bb0437\", \"commit\": \"20297ac7005e3006e088803c4062c58d8a567a20\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/d2fa9ca2f7904901/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/d2fa9ca2f7904901/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/d2fa9ca2f7904901/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/d2fa9ca2f7904901/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/d2fa9ca2f7904901/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/d2fa9ca2f7904901/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.2222811773729821, \"reason\": \"\", \"score\": 0.7512611559169332, \"status\": \"valid\", \"times\": [0.22225177101790905, 0.22243704600259662, 0.22215471509844065], \"tree_hash\": \"fe060c19fd49575711bd156757af662251f98b83\"}, \"raw_logs\": [{\"path\": \"logs/e1/d2fa9ca2f7904901/search/attempt-001/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": true, \"cases\": 4}}]}, \"selected_base_commit\": \"20297ac7005e3006e088803c4062c58d8a567a20\", \"recent_own_role\": [{\"experiment_id\": \"c0c8e778f95d4f5b\", \"role\": \"G\", \"hypothesis\": \"Integrating SoA tiling from A, unrolled inner loop with aligned SIMD hints from B, and double buffering from C will improve cache reuse for j coordinates, expose independent sqrt/division operations while preserving exact summation order, reduce synchronization to one barrier per iteration, and yield speedup close to the best observed.\", \"outcome\": {\"binary_sha256\": null, \"cache_key\": \"9e3ef2cbb6e2bbf2f33f6c52c084234c0c6e447c2fce9f557365029d9b5c7e5e\", \"commit\": \"dba190383d0057f816f3472e800c448c8e178707\", \"correct\": false, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/c0c8e778f95d4f5b/search/attempt-001/build.log\"], \"mean_seconds\": null, \"reason\": \"Build failed or exceeded candidate timeout\", \"score\": 0.0, \"status\": \"build_failed\", \"times\": [], \"tree_hash\": \"2ab17a337f4a9a6f2bf4dfa4f11b632535347205\"}, \"raw_logs\": [{\"path\": \"logs/e1/c0c8e778f95d4f5b/search/attempt-001/build.log\", \"truncated\": false, \"runner_output\": {\"correct\": false, \"diagnostic\": {\"code\": \"compilation_failed\", \"field\": \"source_files/compiler_flags\", \"message\": \"Compiler rejected the program\", \"returncode\": 1, \"stderr\": \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/worktrees/c0c8e778f95d4f5b/src/nbody.c: In function ‘main’:\\n/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/worktrees/c0c8e778f95d4f5b/src/nbody.c:29:9: warning: implicit declaration of function ‘posix_memalign’ [-Wimplicit-function-declaration]\\n   29 |     if (posix_memalign((void **)&px0, align, n * sizeof(float)) ||\\n      |         ^~~~~~~~~~~~~~\\n/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/worktrees/c0c8e778f95d4f5b/src/nbody.c:71:46: error: ‘aligned’ is not valid for ‘#pragma omp for’\\n   71 |             #pragma omp for schedule(static) aligned(cpx,cpy,cpz,cvx,cvy,cvz,npx,npy,npz,nvx,nvy,nvz:64)\\n      |                                              ^~~~~~~\\n\"}}}]}, {\"experiment_id\": \"b8ed57abb5ba473d\", \"role\": \"G\", \"hypothesis\": \"Combining double buffering (C) to eliminate the per-iteration position-update barrier, OpenMP aligned SIMD clauses (B), and the existing SoA/tiling/unrolling from A will reduce synchronization overhead and improve vectorization, yielding faster execution than any single transformation.\", \"outcome\": {\"binary_sha256\": \"f980d0350ba13a4f2e5a05e244365c61c93d0896285fbaf9ee802c4bfe096f81\", \"cache_key\": \"ff21ba108e573f00e2017dde2e2c735ac0dad25b5fb315db62c3b686494813ff\", \"commit\": \"c35c30ed5293dbe5a5780a2573945463ea737bb5\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/b8ed57abb5ba473d/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/b8ed57abb5ba473d/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/b8ed57abb5ba473d/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/b8ed57abb5ba473d/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/b8ed57abb5ba473d/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/b8ed57abb5ba473d/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.22267506861438355, \"reason\": \"\", \"score\": 0.7509301644503115, \"status\": \"valid\", \"times\": [0.2231800619047135, 0.22241351613774896, 0.22243162780068815], \"tree_hash\": \"ede41594279f8ea57c466c823ce4bde5e0cd7e34\"}, \"raw_logs\": [{\"path\": \"logs/e1/b8ed57abb5ba473d/search/attempt-001/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": true, \"cases\": 4}}]}, {\"experiment_id\": \"2f1491a7e2274893\", \"role\": \"G\", \"hypothesis\": \"Integrating SoA layout (A), i-loop blocking with IB=64 and OpenMP over blocks (A), manual unrolling of the inner j-loop by factor 4 preserving exact summation order (B), double buffering that combines force/velocity/position updates into a single pass per iteration (C), and hoisting the OpenMP parallel region outside the simulation loop will reduce thread creation overhead, improve cache reuse for j coordinates, expose independent sqrt/division operations for SIMD vectorization, and preserve bit-exact output bytes.\", \"outcome\": {\"binary_sha256\": \"9a2830de85743910edb5f46bd7e531142a115565f5fc7edce1558c1e41dda6da\", \"cache_key\": \"2262675aa41428542843a0ccf5156e13a6ca58d6a9a0c76370c4290197fc8758\", \"commit\": \"2fda3cb907217473a955dbb4cef1c1fd64c14257\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/2f1491a7e2274893/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/2f1491a7e2274893/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/2f1491a7e2274893/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/2f1491a7e2274893/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/2f1491a7e2274893/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/2f1491a7e2274893/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.16093493012400964, \"reason\": \"\", \"score\": 0.8066351796985481, \"status\": \"valid\", \"times\": [0.16142664407379925, 0.16032973513938487, 0.16104841115884483], \"tree_hash\": \"28ccbdce89ab0e4f3feab4ebca803874e41ec985\"}, \"raw_logs\": [{\"path\": \"logs/e1/2f1491a7e2274893/search/attempt-001/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": true, \"cases\": 4}}]}], \"own_role_history\": [{\"experiment_id\": \"c0c8e778f95d4f5b\", \"status\": \"build_failed\", \"score\": 0.0, \"mean_seconds\": null, \"reason\": \"Build failed or exceeded candidate timeout\"}, {\"experiment_id\": \"b8ed57abb5ba473d\", \"status\": \"valid\", \"score\": 0.7509301644503115, \"mean_seconds\": 0.22267506861438355, \"reason\": \"\"}, {\"experiment_id\": \"2f1491a7e2274893\", \"status\": \"valid\", \"score\": 0.8066351796985481, \"mean_seconds\": 0.16093493012400964, \"reason\": \"\"}, {\"experiment_id\": \"fe5f2817908d4799\", \"status\": \"valid\", \"score\": 0.8061419075338213, \"mean_seconds\": 0.16144419996999204, \"reason\": \"\"}, {\"experiment_id\": \"0c41c17acffc44d7\", \"status\": \"valid\", \"score\": 0.8076056707270622, \"mean_seconds\": 0.15993478040521344, \"reason\": \"\"}, {\"experiment_id\": \"127214d0abb04eab\", \"status\": \"valid\", \"score\": 0.7528529572446436, \"mean_seconds\": 0.22039171704091132, \"reason\": \"\"}, {\"experiment_id\": \"18d7625952ff4b89\", \"status\": \"valid\", \"score\": 0.8120580010969516, \"mean_seconds\": 0.1553770253279557, \"reason\": \"\"}, {\"experiment_id\": \"36cf96a4845044a4\", \"status\": \"build_failed\", \"score\": 0.0, \"mean_seconds\": null, \"reason\": \"Build failed or exceeded candidate timeout\"}, {\"experiment_id\": \"b231a612464d4649\", \"status\": \"valid\", \"score\": 0.806070791085033, \"mean_seconds\": 0.16151767425859967, \"reason\": \"\"}, {\"experiment_id\": \"4acd2d74c5d74746\", \"status\": \"valid\", \"score\": 0.8077074276535644, \"mean_seconds\": 0.1598300529488673, \"reason\": \"\"}, {\"experiment_id\": \"b35117738c6247a9\", \"status\": \"valid\", \"score\": 0.8067992012271333, \"mean_seconds\": 0.16076572705060244, \"reason\": \"\"}, {\"experiment_id\": \"330ddae9aa0e40c7\", \"status\": \"valid\", \"score\": 0.8063199068559227, \"mean_seconds\": 0.16126035596244037, \"reason\": \"\"}, {\"experiment_id\": \"5eb6e3ebcceb4344\", \"status\": \"valid\", \"score\": 0.8062294672537512, \"mean_seconds\": 0.16135375504381955, \"reason\": \"\"}, {\"experiment_id\": \"8d32302896ec4fd6\", \"status\": \"valid\", \"score\": 0.8121603138602296, \"mean_seconds\": 0.15527287730947137, \"reason\": \"\"}, {\"experiment_id\": \"bff056907ade4780\", \"status\": \"valid\", \"score\": 0.7505688314338937, \"mean_seconds\": 0.2231054639754196, \"reason\": \"\"}, {\"experiment_id\": \"aac54d3474204ba2\", \"status\": \"valid\", \"score\": 0.8059359394275635, \"mean_seconds\": 0.1616570324792216, \"reason\": \"\"}, {\"experiment_id\": \"3b3f2e3cf99249c9\", \"status\": \"valid\", \"score\": 0.8059864298126581, \"mean_seconds\": 0.1616048493112127, \"reason\": \"\"}, {\"experiment_id\": \"d2fa9ca2f7904901\", \"status\": \"valid\", \"score\": 0.7512611559169332, \"mean_seconds\": 0.2222811773729821, \"reason\": \"\"}, {\"experiment_id\": \"053b36b0de774481\", \"status\": \"valid\", \"score\": 0.81194212137784, \"mean_seconds\": 0.15549501536103585, \"reason\": \"\"}, {\"experiment_id\": \"ddf967a3032b4dbb\", \"status\": \"valid\", \"score\": 0.8056696660448993, \"mean_seconds\": 0.16193234136638543, \"reason\": \"\"}]}, \"documents_as_data\": [{\"id\": \"e0c98b85d7acd1601471\", \"title\": \"Official problem statement\", \"url\": \"http://lspd.mackenzie.br/marathon/22/problemset.pdf\", \"version\": \"downloaded-2026-10-15\", \"preconditions\": \"Official source material. Operator supplies execution only.\", \"excerpt\": \"=== PAGE 1 ===\\n17th Marathon of Parallel Programming\\nSBAC-PAD & WSCAD – 2022\\nCalebe Bianchini1 and Maur´ıcio Aronne Pillon2\\n1Mackenzie Presbyterian University\\n2Santa Catarina State University\\nRules for Remote Contest\\nFor all problems, read carefully the input and output session. For all problems, a sequen-\\ntial implementation is given, and it is against the output of those implementations that the\\noutput of your programs will be compared to decide if your implementation is correct.\\nYou can modify the program in any way you see fit, except when the problem descrip-\\ntion states otherwise. You must upload a compressed file (zip) with your source code, the\\nMakefile and an execution script. The script must have the name of the problem. You\\ncan submit as many solutions to a problem as you want. Only the last submission will\\nbe considered. The Makefile must have the rule all, which will be used to compile your\\nsource code. The execution script runs your solution the way you design it – it will be\\ninspected not to corrupt the target machine.\\nThe execution time of your program will be measured running it with time program and\\ntaking the real CPU time given. Each program will be executed at least three times with\\nthe same input and the mean time will be taken into account. The sequential program\\ngiven will be measured the same way. You will earn points in each problem, correspond-\\ning to the division of the sequential time by the time of your program (speedup). The\\nteam with the most points at the end of the marathon will be declared the winner.\\nThis problem set contains 4 problems; pages are numbered from 1 to 5.\\n\\n=== PAGE 2 ===\\nGeneral Information\\nCompilation\\nYou should use CC or CXX inside your Makefile. Be careful when redefining them!\\nThere is a simple Makefile inside you pr\", \"retrieval_relevance\": 161, \"evidence_type\": \"documentation\"}, {\"id\": \"4a7633ba1e00acfb3d75\", \"title\": \"TreeQuest AB-MCTS ask tell persistence\", \"url\": \"https://github.com/SakanaAI/treequest\", \"version\": \"0.3.2\", \"preconditions\": \"Use the pinned TreeQuest version; local trusted checkpoints only.\", \"excerpt\": \"AB-MCTS-A selects new proposals and continuations. Scores are normalized to [0,1]. Persist each role's state per epoch. Integration receives one measured full-program reward in G only. Keep provenance separate from the selected search parent.\", \"retrieval_relevance\": 3, \"evidence_type\": \"documentation\"}], \"deadline\": 1792131026.945125, \"protocol_id\": \"574cf13601ca5f18abb45cd6448dc1ee2791d19a004bb29f680d44fbb845d6f8\", \"remaining_tokens\": 2125217, \"official_statement_as_data\": \"=== PAGE 1 ===\\n17th Marathon of Parallel Programming\\nSBAC-PAD & WSCAD – 2022\\nCalebe Bianchini1 and Maur´ıcio Aronne Pillon2\\n1Mackenzie Presbyterian University\\n2Santa Catarina State University\\nRules for Remote Contest\\nFor all problems, read carefully the input and output session. For all problems, a sequen-\\ntial implementation is given, and it is against the output of those implementations that the\\noutput of your programs will be compared to decide if your implementation is correct.\\nYou can modify the program in any way you see fit, except when the problem descrip-\\ntion states otherwise. You must upload a compressed file (zip) with your source code, the\\nMakefile and an execution script. The script must have the name of the problem. You\\ncan submit as many solutions to a problem as you want. Only the last submission will\\nbe considered. The Makefile must have the rule all, which will be used to compile your\\nsource code. The execution script runs your solution the way you design it – it will be\\ninspected not to corrupt the target machine.\\nThe execution time of your program will be measured running it with time program and\\ntaking the real CPU time given. Each program will be executed at least three times with\\nthe same input and the mean time will be taken into account. The sequential program\\ngiven will be measured the same way. You will earn points in each problem, correspond-\\ning to the division of the sequential time by the time of your program (speedup). The\\nteam with the most points at the end of the marathon will be declared the winner.\\nThis problem set contains 4 problems; pages are numbered from 1 to 5.\\n\\n=== PAGE 2 ===\\nGeneral Information\\nCompilation\\nYou should use CC or CXX inside your Makefile. Be careful when redefining them!\\nThere is a simple Makefile inside you problem package that you can modify. Example:\\nFLAGS=-O3\\nEXEC=sum\\nCXX=icpc\\nall: $(EXEC)\\n$(EXEC):\\n$(CXX) $(FLAGS) $(EXEC).cpp -c -o $(EXEC).o\\n$(CXX) $(FLAGS) $(EXEC).o -o $(EXEC)\\nEach judge machine has its group of compilers. See them below and choose well when\\nwriting your Makefile. The compiler that is tagged as default is predefined in CC and\\nCXX variables.\\nmachine compiler command\\nhost\\nGCC 12.2.0\\n(default)\\nC = gcc\\nC++ = g++\\nIntel C/C++ Compiler 19.1.3.304 C = icc\\nC++ = icpc\\nMPI\\nIntel MPI Compiler 2019u12\\n(default)\\nC = mpiicc\\nC++ = mpiicpc\\nIntel C/C++ Compiler 19.1.3.304 C = icc\\nC++ = icpc\\nGCC 12.2.0 C = gcc\\nC++ = g++\\ngpu\\nNVidia CUDA 11.6\\n(default)\\nC = nvcc\\nC++ = nvcc\\nGCC 8.3.1 C = gcc\\nC++ = g++\\nSubmitting\\nGeneral information\\nYou must have an execution script that has the same name of the problem. This script runs\\nyour solution the way you design it. There is a simple script inside you problem package\\nthat should be modified. Example:\\n#!/bin/bash\\n# This script runs a generic Problem A\\n# Using 32 threads and OpenMP\\nexport OMP_NUM_THREADS=32\\nOMP_NUM_THREADS=32 ./sum\\n\\n=== PAGE 3 ===\\nSubmitting MPI\\nIf you are planning to submit an MPI solution, you should compile usingmpiicc/mpiicpc.\\nThe script must call mpirun/mpiexec with the correct number of processes (max: 4). It\\nmust use a file called machines that are generated by the auto-judge system - do not\\ncreate it.\\n#!/bin/bash\\n# This script runs a generic Problem A\\n# Using MPI in the entire cluster (4 nodes)\\n# 'machines' file describes the nodes\\nmpirun -np 4 -machinefile machines ./sum\\nComparing times & results\\nIn your personal machine, measure the execution time of your solution using time pro-\\ngram. Add input/output redirection when collecting time. Use diff program to compare\\nthe original and your solution results. Example:\\n$ time -p ./A < original_input.txt > my_output.txt\\nreal 4.94\\nuser 0.08\\nsys 1.56\\n$ diff my_output.txt original_output.txt\\nDo not measure time and do not add input/output redirection when submitting your so-\\nlution - the auto-judge system is prepared to collect your time and compare the results.\\n\\n=== PAGE 4 ===\\nProblem A\\nk-Nearest Neighbors Classifier\\nGiven a set of two-dimensional points S divided intro n groups, an integer k and a two-\\ndimensional point P to be classified, the k-Nearest Neighbors (KNN) algorithm can be\\nused to solve the classification problem of the point P , i.e., classifying the point P into\\none of the n existing groups based on some criteria.\\nThe KNN algorithm works by comparing the distances from each point s ∈ S to the\\npoint P , then selecting the k points with the smallest distance values and counting the\\nfrequency of each group in these k points, the point P is then classified to belong to the\\ngroup with the highest frequency among the k nearest points.\\nFigure 1. Simple example of the KNN classification.\\nThe Figure 1 illustrates an example of the KNN classification algorithm being applied.\\nThe points have been segregated between 4 different groups ( i.e., A, B, C and D) and\\na point P with no group is provided to be classified, the KNN algorithm then searches\\nfor the k points closest to the point P and, after that, the groups have their frequencies\\ncounted, with the highest frequency being chosen as the classification ofP , in the case of\\nthis example, the point P is classified to belong to the group C.\\nInput\\nAn input represents the classification of a single point. The first line contains the pattern\\n”n groups=n”, where n is the total number of groups in this input. Then, for each of then\\ngroups the following lines will be provided, the first line has the pattern ”label=c” where\\nc is a single character that represents the label ( i.e., identification) of the group, then the\\nsecond line follows the pattern ”length= L”, where L is the number of two-dimensional\\npoints in this group and then, the next L lines contain the pattern ”(x,y)” that represents\\n1\\n\\n=== PAGE 5 ===\\neach point that belongs to the aforementioned group. After all groups have been repre-\\nsented there’s a single line with the pattern ”k= k”, where k is the parameter previously\\ndiscussed. Lastly, the final line also contains the pattern ”(x,y)”, representing the coordi-\\nnates to the two-dimensional point to be classified.\\nThe input must be read form the standard input.\\nOutput\\nThe output contains a single character, it being the label of the group chosen as the clas-\\nsification of the provided point.\\nThe output must be written to the standard output.\\nExample\\nInput example Output example\\nn groups=4 C\\nlabel=A\\nlength=3\\n(-3.55,-1.28)\\n(-3.99,-2.06)\\n(-3.23,-0.70)\\nlabel=B\\nlength=5\\n(-4.85,-1.65)\\n(-5.23,-2.22)\\n(-4.75,-3.89)\\n(-6.48,-2.41)\\n(-4.56,-2.29)\\nlabel=C\\nlength=4\\n(2.25,0.64)\\n(0.80,0.85)\\n(3.13,1.37)\\n(3.71,0.59)\\nlabel=D\\nlength=3\\n(-5.73,-2.65)\\n(-5.11,-4.41)\\n(-5.92,-3.06)\\nk=5\\n(-0.65,0.25)\\n2\\n\\n=== PAGE 6 ===\\nProblem B\\nSubmatrix of Maximum Sum\\nGiven a matrix M (with dimensions NxN) and an integer S, the objective is to find\\nthe SxS submatrix of M with maximum sum. A trivial algorithm to solve this problem\\nconsists in generating all (N − S + 1)2 such submatrices and, then, computing their sum\\n(the total time complexity would be, in the worst case, O((N − S)2S2 = O(N 2S2) )\\nThe proposed baseline algorithm (solution.cpp) employs a sliding window technique to\\nreduce this complexity to O(SN 2).\\nInput\\nThe input has only one test case. The first line contains two integers N and S (0 < S <\\nN < 8000). Then, there are N rows representing the matrix M. Each row contains N\\nintegers (with a whitespace after each one).\\nThe input must be read from the standard input.\\nOutput\\nThe output contains a single line. Print the sum of the SxS submatrix of M with maxi-\\nmum sum. It is guaranteed the result will fit a 32-bit signed integer.\\nThe output must be written to the standard output.\\nExample\\nInput Example Output example\\n5 3 51\\n3 6 7 5 3\\n5 6 2 9 1\\n2 7 0 9 3\\n6 0 6 2 6\\n1 8 7 9 2\\n3\\n\\n=== PAGE 7 ===\\nProblem C\\nN-body\\nAn n-body simulation models a dynamic system of particles, usually under the influence\\nof physical forces, predicting their individual motions. A well known application of n-\\nbody simulation is in astrophysics, where particles refer to celestial objects interacting\\nwith each other gravitationally. The provided serial code contains a simple, yet working,\\nn-body simulator for bodies moving through a 3 dimensional space. Your job is to create\\na parallel version of this n-body simulator, retaining the correctness of the solution.\\nInput\\nThe input consists of a binary file containing a structure with six float typed data items\\nfor each particle in the system. These six data items refer to the position of the particle in\\nthe x, y, and z axes, and the velocity of the particle in the x, y, and z axes.\\nThe input must be read form the standard input.\\nOutput\\nThe ouput is also a binary file, with the same format of the input file, containing the\\npositions and velocities of each particle in the x, y, and z axes.\\nThe output must be written to the standard output.\\nExample – in string form, just for readability purposes\\nInput example Output example\\n0.680375 -0.211234 0.566198\\n0.596880 0.823295 -0.604897\\n-0.329554 0.536459 -0.444451\\n0.107940 -0.045206 0.257742\\n-0.270431 0.026802 0.904459\\n0.832390 0.271423 0.434594\\n...\\n-5.184253 11.632033\\n-11.737427 -63.642937\\n146.243469 -147.690735\\n10.654608 -15.666613\\n15.572982 133.827255\\n-195.720352 194.728912\\n22.627201 -1.267884 -5.422720\\n283.039612 -15.879736\\n-67.786301\\n4\\n\\n=== PAGE 8 ===\\nProblem D\\nBucketsort\\nBucket sort or Binsort is a sorting algorithm. Its sorting strategy is to divide the numbers\\ninto ’buckets’ with a finite number of elements. The bucket’s advantage is its complexity\\n(O(n)), where ’n’ is the size of the array. However, linear complexity is only achieved\\nwhen the number is evenly distributed.\\nInput\\nAn input has 2 parts: the parameters and the data. The first four numbers are string length,\\narray size, offset, and bucket number. The remaining parameters are integer numbers to\\norder.\\nThe input must be read form the standard input.\\nOutput\\nThe output contains only the sorted integers.\\nThe output must be written to the standard output.\\nExample\\nInput example Output example\\n5\\n100000\\n48\\n9\\n99997 99996 99995 99994 99993\\n99992 99991 99990 99989 99988\\n99987 99986 ...\\n00000 00001 00002 00003 00004\\n00005 00006 00007 00008 00009\\n00010 00011 ...\\n5\", \"runtime_as_data\": {\"cpu_cores\": 4, \"OMP_NUM_THREADS\": 4, \"architecture\": \"ARM64\", \"candidate_GPU\": false, \"comparison\": \"Exact output bytes against official reference\"}}, \"required_json_schema\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"hypothesis\": {\"type\": \"string\"}, \"transformations\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"sources_kept\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"enum\": [\"89b40ce89590426a\", \"69360860ffa54822\", \"9adc054f311d4298\"]}, \"uniqueItems\": true}, \"files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"path\": {\"type\": \"string\"}, \"content\": {\"type\": \"string\"}}, \"required\": [\"path\", \"content\"]}}, \"notes\": {\"type\": \"string\"}}, \"required\": [\"hypothesis\", \"transformations\", \"sources_kept\", \"files\", \"notes\"]}}\n\nCURRENT SOURCE AS DATA:\n\n--- BEGIN FILE src/nbody.c ---\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nvoid read_dataset(int *nbodies, float **px, float **py, float **pz,\n                  float **vx, float **vy, float **vz) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) { fprintf(stderr,\"\\nError reading nbodie value\\n\"); exit(EXIT_FAILURE); }\n  int n = *nbodies;\n  Body *tmp = (Body *)malloc(n * sizeof(Body));\n  b = fread(tmp, n * sizeof(Body), 1, stdin);\n  if (b != 1) { fprintf(stderr,\"\\nError reading input values\\n\"); exit(EXIT_FAILURE); }\n  *px = (float*)malloc(n*sizeof(float));\n  *py = (float*)malloc(n*sizeof(float));\n  *pz = (float*)malloc(n*sizeof(float));\n  *vx = (float*)malloc(n*sizeof(float));\n  *vy = (float*)malloc(n*sizeof(float));\n  *vz = (float*)malloc(n*sizeof(float));\n  for (int i=0;i<n;i++){\n    (*px)[i] = tmp[i].x;\n    (*py)[i] = tmp[i].y;\n    (*pz)[i] = tmp[i].z;\n    (*vx)[i] = tmp[i].vx;\n    (*vy)[i] = tmp[i].vy;\n    (*vz)[i] = tmp[i].vz;\n  }\n  free(tmp);\n}\n\nvoid write_dataset(const int nbodies, float *px, float *py, float *pz,\n                   float *vx, float *vy, float *vz) {\n  Body *out = (Body*)malloc(nbodies*sizeof(Body));\n  for (int i=0;i<nbodies;i++){\n    out[i].x = px[i];\n    out[i].y = py[i];\n    out[i].z = pz[i];\n    out[i].vx = vx[i];\n    out[i].vy = vy[i];\n    out[i].vz = vz[i];\n  }\n  int b = fwrite(out, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) { fprintf(stderr,\"\\nError writing to output\\n\"); exit(EXIT_FAILURE); }\n  free(out);\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n  float *px,*py,*pz,*vx,*vy,*vz;\n  read_dataset(&nbodies,&px,&py,&pz,&vx,&vy,&vz);\n\n  const int TILE = 64;\n\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    #pragma omp parallel\n    {\n      // Force computation: dynamic scheduling on tiles balances load.\n      #pragma omp for schedule(dynamic,16)\n      for (int i0 = 0; i0 < nbodies; i0 += TILE) {\n        int i_end = i0 + TILE;\n        if (i_end > nbodies) i_end = nbodies;\n        int cnt = i_end - i0;\n\n        float fx[64], fy[64], fz[64];\n        float xis[64], yis[64], zis[64];\n\n        for (int t = 0; t < cnt; ++t) {\n          fx[t] = 0.0f;\n          fy[t] = 0.0f;\n          fz[t] = 0.0f;\n          int idx = i0 + t;\n          xis[t] = px[idx];\n          yis[t] = py[idx];\n          zis[t] = pz[idx];\n        }\n\n#define ACCUM(jj) \\\n    do { \\\n      float pjx = px[jj]; \\\n      float pjy = py[jj]; \\\n      float pjz = pz[jj]; \\\n      _Pragma(\"omp simd\") \\\n      for (int t = 0; t < cnt; ++t) { \\\n        float dx = pjx - xis[t]; \\\n        float dy = pjy - yis[t]; \\\n        float dz = pjz - zis[t]; \\\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING; \\\n        float inv_dist = 1.0f / sqrt(sqrd_dist); \\\n        float inv_dist3 = inv_dist * inv_dist * inv_dist; \\\n        fx[t] += dx * inv_dist3; \\\n        fy[t] += dy * inv_dist3; \\\n        fz[t] += dz * inv_dist3; \\\n      } \\\n    } while (0)\n\n        int j = 0;\n        for (; j + 3 < nbodies; j += 4) {\n          ACCUM(j);\n          ACCUM(j+1);\n          ACCUM(j+2);\n          ACCUM(j+3);\n        }\n        for (; j < nbodies; ++j) {\n          ACCUM(j);\n        }\n#undef ACCUM\n\n        // Update velocities within this tile.\n        for (int t = 0; t < cnt; ++t) {\n          int idx = i0 + t;\n          vx[idx] += DT * fx[t];\n          vy[idx] += DT * fy[t];\n          vz[idx] += DT * fz[t];\n        }\n      }\n\n      // Position update: static schedule.\n      #pragma omp for schedule(static)\n      for (int i = 0; i < nbodies; ++i) {\n        px[i] += vx[i] * DT;\n        py[i] += vy[i] * DT;\n        pz[i] += vz[i] * DT;\n      }\n    }\n  }\n\n  write_dataset(nbodies, px, py, pz, vx, vy, vz);\n\n  free(px); free(py); free(pz);\n  free(vx); free(vy); free(vz);\n  exit(EXIT_SUCCESS);\n}\n\n--- END FILE src/nbody.c ---\n"
    }

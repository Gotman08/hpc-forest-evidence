"""Call the unchanged R4 pure reader; report only inside this owned reception."""
from pathlib import Path
import hashlib
import json
import sys

HERE = Path(__file__).resolve().parent
BASE = HERE.parents[2]
AUDITOR = BASE / "outputs/HPC-Forest-Primes-Natif-Audit-r4"
REV = BASE / "outputs/HPC-Forest-Primes-Natif-MAX-r1/revision-r1b"


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


delivery_path = AUDITOR / "LIVRAISON-AUDITEUR-LOCAL-R4.json"
assert sha(delivery_path) == "cfafc7cf0094733c7ff2735fd470bc3565a3702420e5d2737e7e0a59cc1ee51c"
delivery = json.loads(delivery_path.read_bytes())
for name, value in delivery["files"].items():
    assert sha(AUDITOR / name) == value["sha256"], "Sealed auditor changed before inspection"
sys.path.insert(0, str(AUDITOR))
from audit_r2_native import audit
result = audit(HERE / "restauration", HERE / "cache-relais-complet-apres-arret",
               HERE / "reception-archive-verifiee.json", HERE / "cache-preservation-phase-complete-r4.json",
               REV / "HPC-Forest-Primes-Natif-MAX-r1.zip", REV / "native-max-plan.json",
               REV / "certified-preparation")
for key in ["verified", "native_research_admitted", "independent_raw_stdout_per_candidate_verified",
            "independent_performance_audit_verified", "hardware_or_process_isolation_proved"]:
    assert result[key] is False, "Bounded reader must never grant full admission"
for name, value in delivery["files"].items():
    assert sha(AUDITOR / name) == value["sha256"], "Sealed auditor changed during inspection"
output = HERE / "audit-r4-apres-arret-lecture-1.json"
with output.open("x", encoding="utf8") as stream:
    json.dump(result, stream, indent=2, ensure_ascii=False)
    stream.write("\n")
record = {
    "entry_point": "Unchanged pure audit(...) function; only result writing moved to owned reception",
    "reader_delivery": {"path": str(delivery_path), "sha256": sha(delivery_path)},
    "reader_guide": {"path": str(AUDITOR / "REPRISE.md"), "sha256": sha(AUDITOR / "REPRISE.md")},
    "main": {"path": str(AUDITOR / "audit_r2_native.py"), "sha256": sha(AUDITOR / "audit_r2_native.py")},
    "output": {"path": str(output), "sha256": sha(output)},
    "result_exit_code": 1 if result.get("audit_error") else 2,
    "global_admission_false_preserved": True,
    "scope": "Received archive and preserved readable cache only; complete cache after separately proven owned stop, with explicit raw attribution limit",
}
with (HERE / "appel-audit-r4-apres-arret.json").open("x", encoding="utf8") as stream:
    json.dump(record, stream, indent=2, ensure_ascii=False)
    stream.write("\n")
transport = result.get("transport_cost_reconciliation", {})
campaign = result.get("campaign", {})
print(json.dumps({"report": record["output"], "audit_error": result.get("audit_error"),
                  "cache_preservation": result.get("cache_preservation"),
                  "received_model_artifacts_audited_with_owned_lock_pending":
                      result.get("received_model_artifacts_audited_with_owned_lock_pending"),
                  "received_cohort_audited_with_explicit_raw_attribution_limit":
                      result.get("received_cohort_audited_with_explicit_raw_attribution_limit"),
                  "transport_summary": {key: value for key, value in transport.items()
                      if not isinstance(value, (dict, list))},
                  "transport_collection_counts": {key: len(value) for key, value in transport.items()
                      if isinstance(value, (dict, list))},
                  "campaign_flags": {key: value for key, value in campaign.items()
                      if isinstance(value, (bool, int, str))},
                  "exit_code": record["result_exit_code"]}, indent=2))
raise SystemExit(record["result_exit_code"])

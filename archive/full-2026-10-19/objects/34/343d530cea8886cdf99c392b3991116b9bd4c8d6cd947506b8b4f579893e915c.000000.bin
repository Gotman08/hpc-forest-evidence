        "content": "#include \"knn.h\"\n#include <float.h>\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nstatic char winning_label(const size_t counts[UCHAR_MAX + 1]) {\n    char winner = (char)CHAR_MIN;\n    size_t best = 0;\n    for (int label = CHAR_MIN; label <= CHAR_MAX; ++label) {\n        size_t count = counts[(unsigned char)label];\n        if (count > best) {\n            best = count;\n            winner = (char)label;\n        }\n    }\n    return winner;\n}\n\nstatic inline int first_insertion_position(const float *distances, int k,\n                                            float d) {\n    int x = 0;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const float32x4_t candidate = vdupq_n_f32(d);\n    const float32x4_t empty = vdupq_n_f32(-1.0f);\n    const uint32x4_t offsets0 = {0, 1, 2, 3};\n    const uint32x4_t offsets4 = {4, 5, 6, 7};\n    const uint32x4_t offsets8 = {8, 9, 10, 11};\n    const uint32x4_t offsets12 = {12, 13, 14, 15};\n\n    for (; x <= k - 16; x += 16) {\n        const float32x4_t stored0 = vld1q_f32(distances + x);\n        const float32x4_t stored4 = vld1q_f32(distances + x + 4);\n        const float32x4_t stored8 = vld1q_f32(distances + x + 8);\n        const float32x4_t stored12 = vld1q_f32(distances + x + 12);\n        const uint32x4_t matches0 = vorrq_u32(\n            vcltq_f32(candidate, stored0), vceqq_f32(stored0, empty));\n        const uint32x4_t matches4 = vorrq_u32(\n            vcltq_f32(candidate, stored4), vceqq_f32(stored4, empty));\n        const uint32x4_t matches8 = vorrq_u32(\n            vcltq_f32(candidate, stored8), vceqq_f32(stored8, empty));\n        const uint32x4_t matches12 = vorrq_u32(\n            vcltq_f32(candidate, stored12), vceqq_f32(stored12, empty));\n        const uint32x4_t any = vorrq_u32(\n            vorrq_u32(matches0, matches4), vorrq_u32(matches8, matches12));\n        if (vmaxvq_u32(any) != 0) {\n            const uint32x4_t positions0 = vornq_u32(offsets0, matches0);\n            const uint32x4_t positions4 = vornq_u32(offsets4, matches4);\n            const uint32x4_t positions8 = vornq_u32(offsets8, matches8);\n            const uint32x4_t positions12 = vornq_u32(offsets12, matches12);\n            const uint32x4_t positions = vminq_u32(\n                vminq_u32(positions0, positions4),\n                vminq_u32(positions8, positions12));\n            return x + (int)vminvq_u32(positions);\n        }\n    }\n    for (; x <= k - 4; x += 4) {\n        const float32x4_t stored = vld1q_f32(distances + x);\n        const uint32x4_t matches = vorrq_u32(\n            vcltq_f32(candidate, stored), vceqq_f32(stored, empty));\n        if (vmaxvq_u32(matches) != 0) {\n            return x + (int)vminvq_u32(vornq_u32(offsets0, matches));\n        }\n    }\n#endif\n    for (; x < k; ++x) {\n        if (d < distances[x] || distances[x] == -1.0f) return x;\n    }\n    return k;\n}\n\nstatic char knn_insertion(int n_groups, Group *groups, int k,\n                          Point to_evaluate) {\n    char *labels = (char *)malloc((size_t)k * sizeof(*labels));\n    float *distances = (float *)malloc((size_t)k * sizeof(*distances));\n    if (labels == NULL || distances == NULL) {\n        free(labels);\n        free(distances);\n        on_error();\n    }\n    for (int i = 0; i < k; ++i) {\n        labels[i] = -1;\n        distances[i] = -1.0f;\n    }\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; ++j) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            float farthest = distances[k - 1];\n            if (farthest != -1.0f && d >= farthest) continue;\n            int x = first_insertion_position(distances, k, d);\n            if (x < k) {\n                size_t shifted = (size_t)(k - x - 1);\n                if (shifted != 0) {\n                    memmove(distances + x + 1, distances + x,\n                            shifted * sizeof(*distances));\n                    memmove(labels + x + 1, labels + x,\n                            shifted * sizeof(*labels));\n                }\n                distances[x] = d;\n                labels[x] = g.label;\n            }\n        }\n    }\n    size_t counts[UCHAR_MAX + 1] = {0};\n    for (int i = 0; i < k; ++i) ++counts[(unsigned char)labels[i]];\n    free(distances);\n    free(labels);\n    return winning_label(counts);\n}\n\nstatic inline uint32_t distance_key(Point a, Point b) {\n    float distance = euclidean_distance_no_sqrt(a, b);\n    uint32_t bits;\n    memcpy(&bits, &distance, sizeof(bits));\n    if ((bits & 0x7fffffffu) == 0) bits = 0;\n    return bits;\n}\n\nstatic int compare_keys(const void *a, const void *b) {\n    uint64_t x = *(const uint64_t *)a;\n    uint64_t y = *(const uint64_t *)b;\n    return (x > y) - (x < y);\n}\n\nstatic uint64_t median_key(uint64_t a, uint64_t b, uint64_t c) {\n    if (a > b) {\n        uint64_t temporary = a;\n        a = b;\n        b = temporary;\n    }\n    if (b > c) b = c;\n    return a > b ? a : b;\n}\n\nstatic void retain_smallest_keys(uint64_t *keys, size_t count, size_t keep) {\n    if (keep == 0 || keep >= count) return;\n    size_t nth = keep - 1;\n    size_t left = 0;\n    size_t right = count;\n    unsigned depth = 0;\n    for (size_t n = count; n > 1; n >>= 1) ++depth;\n    depth *= 2;\n    while (right - left > 32) {\n        if (depth == 0) {\n            qsort(keys + left, right - left, sizeof(*keys), compare_keys);\n            return;\n        }\n        --depth;\n        size_t middle = left + (right - left) / 2;\n        uint64_t pivot = median_key(keys[left], keys[middle], keys[right - 1]);\n        size_t low = left;\n        size_t high = right;\n        while (low < high) {\n            while (low < high && keys[low] < pivot) ++low;\n            while (low < high && keys[high - 1] > pivot) --high;\n            if (low >= high) break;\n            --high;\n            uint64_t temporary = keys[low];\n            keys[low] = keys[high];\n            keys[high] = temporary;\n            ++low;\n        }\n        if (nth < high) {\n            right = high;\n        } else if (nth >= low) {\n            left = low;\n        } else {\n            return;\n        }\n    }\n    for (size_t i = left + 1; i < right; ++i) {\n        uint64_t value = keys[i];\n        size_t j = i;\n        while (j > left && keys[j - 1] > value) {\n            keys[j] = keys[j - 1];\n            --j;\n        }\n        keys[j] = value;\n    }\n}\n\n#ifdef _OPENMP\nenum { KNN_RADIX_BINS = 2048 };\n\ntypedef struct {\n    size_t histogram[KNN_RADIX_BINS];\n    size_t counts[UCHAR_MAX + 1];\n    size_t take_equal;\n    int invalid;\n} KnnRadixScratch;\n\nstatic unsigned radix_bucket(const KnnRadixScratch *scratch, int workers,\n                             unsigned bins, size_t *rank) {\n    for (unsigned bucket = 0; bucket < bins; ++bucket) {\n        size_t count = 0;\n        for (int t = 0; t < workers; ++t) {\n            count += scratch[t].histogram[bucket];\n        }\n        if (*rank <= count) return bucket;\n        *rank -= count;\n    }\n    return bins - 1;\n}\n\nstatic int knn_radix(int n_groups, Group *groups, Point to_evaluate,\n                     size_t total, size_t keep, size_t padding,\n                     int workers, char *result) {\n    if (total > SIZE_MAX / sizeof(uint32_t)) return 0;\n    uint32_t *distances = (uint32_t *)malloc(total * sizeof(*distances));\n    KnnRadixScratch *scratch = (KnnRadixScratch *)calloc(\n        (size_t)workers, sizeof(*scratch));\n    if (distances == NULL || scratch == NULL) {\n        free(distances);\n        free(scratch);\n        return 0;\n    }\n    uint32_t cutoff = 0;\n    size_t rank = keep;\n    int invalid = 0;\n    int team_used = 1;\n\n#pragma omp parallel num_threads(workers)\n    {\n        const int tid = omp_get_thread_num();\n        const int team = omp_get_num_threads();\n        const size_t block = total / (size_t)team;\n        const size_t extra = total % (size_t)team;\n        const size_t before = (size_t)tid < extra ? (size_t)tid : extra;\n        const size_t begin = (size_t)tid * block + before;\n        const size_t end = begin + block + ((size_t)tid < extra);\n        KnnRadixScratch *local = &scratch[tid];\n        size_t group_begin = 0;\n\n        for (int g = 0; g < n_groups && group_begin < end; ++g) {\n            size_t length = groups[g].length > 0 ? (size_t)groups[g].length : 0;\n            size_t group_end = group_begin + length;\n            size_t lo = begin > group_begin ? begin : group_begin;\n            size_t hi = end < group_end ? end : group_end;\n            for (size_t p = lo; p < hi; ++p) {\n                uint32_t bits = distance_key(\n                    to_evaluate, groups[g].points[p - group_begin]);\n                distances[p] = bits;\n                local->invalid |= (bits & 0x7fffffffu) > 0x7f800000u;\n                ++local->histogram[bits >> 21];\n            }\n            group_begin = group_end;\n        }\n#pragma omp barrier\n#pragma omp single\n        {\n            team_used = team;\n            for (int t = 0; t < team; ++t) invalid |= scratch[t].invalid;\n            if (!invalid) {\n                cutoff = (uint32_t)radix_bucket(\n                    scratch, team, KNN_RADIX_BINS, &rank) << 21;\n            }\n        }\n\n        if (!invalid) {\n            memset(local->histogram, 0, sizeof(local->histogram));\n            for (size_t p = begin; p < end; ++p) {\n                uint32_t bits = distances[p];\n                if ((bits & 0xffe00000u) == cutoff) {\n                    ++local->histogram[(bits >> 10) & 2047u];\n                }\n            }\n#pragma omp barrier\n#pragma omp single\n            {\n                cutoff |= (uint32_t)radix_bucket(\n                    scratch, team, KNN_RADIX_BINS, &rank) << 10;\n            }\n\n            memset(local->histogram, 0, sizeof(local->histogram));\n            for (size_t p = begin; p < end; ++p) {\n                uint32_t bits = distances[p];\n                if ((bits & 0xfffffc00u) == cutoff) {\n                    ++local->histogram[bits & 1023u];\n                }\n            }\n#pragma omp barrier\n#pragma omp single\n            {\n                unsigned bucket = radix_bucket(scratch, team, 1024, &rank);\n                cutoff |= (uint32_t)bucket;\n                size_t remaining = rank;\n                for (int t = 0; t < team; ++t) {\n                    size_t equal = scratch[t].histogram[bucket];\n                    size_t take = equal < remaining ? equal : remaining;\n                    scratch[t].take_equal = take;\n                    remaining -= take;\n                }\n            }\n\n            size_t equal_left = local->take_equal;\n            group_begin = 0;\n            for (int g = 0; g < n_groups && group_begin < end; ++g) {\n                size_t length = groups[g].length > 0 ? (size_t)groups[g].length : 0;\n                size_t group_end = group_begin + length;\n                size_t lo = begin > group_begin ? begin : group_begin;\n                size_t hi = end < group_end ? end : group_end;\n                unsigned char label = (unsigned char)groups[g].label;\n                for (size_t p = lo; p < hi; ++p) {\n                    uint32_t bits = distances[p];\n                    if (bits < cutoff) {\n                        ++local->counts[label];\n                    } else if (bits == cutoff && equal_left != 0) {\n                        --equal_left;\n                        ++local->counts[label];\n                    }\n                }\n                group_begin = group_end;\n            }\n        }\n    }\n\n    if (!invalid) {\n        size_t counts[UCHAR_MAX + 1] = {0};\n        counts[(unsigned char)-1] = padding;\n        for (int t = 0; t < team_used; ++t) {\n            for (int label = 0; label <= UCHAR_MAX; ++label) {\n                counts[label] += scratch[t].counts[label];\n            }\n        }\n        *result = winning_label(counts);\n    }\n    free(scratch);\n    free(distances);\n    return invalid ? -1 : 1;\n}\n#endif\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) return (char)-1;\n    if (k <= 64 || sizeof(float) != sizeof(uint32_t) ||\n        FLT_RADIX != 2 || FLT_MANT_DIG != 24 || FLT_MAX_EXP != 128) {\n        return knn_insertion(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t total = 0;\n    for (int g = 0; g < n_groups; ++g) {\n        size_t length = groups[g].length > 0 ? (size_t)groups[g].length : 0;\n        if (length > SIZE_MAX - total) {\n            return knn_insertion(n_groups, groups, k, to_evaluate);\n        }\n        total += length;\n    }\n    if (total == 0) return (char)-1;\n    size_t keep = (size_t)k < total ? (size_t)k : total;\n    size_t padding = (size_t)k - keep;\n\n#ifdef _OPENMP\n    int workers = omp_get_max_threads();\n    size_t useful_workers = total / 32768;\n    if (useful_workers == 0) useful_workers = 1;\n    if ((size_t)workers > useful_workers) workers = (int)useful_workers;\n    if (workers > 1) {\n        char result;\n        int status = knn_radix(n_groups, groups, to_evaluate, total, keep,\n                               padding, workers, &result);\n        if (status > 0) return result;\n        if (status < 0) {\n            return knn_insertion(n_groups, groups, k, to_evaluate);\n        }\n    }\n#endif\n\n    if (total > SIZE_MAX / sizeof(uint64_t)) {\n        return knn_insertion(n_groups, groups, k, to_evaluate);\n    }\n    uint64_t *keys = (uint64_t *)malloc(total * sizeof(*keys));\n    if (keys == NULL) return knn_insertion(n_groups, groups, k, to_evaluate);\n    size_t used = 0;\n    for (int g = 0; g < n_groups; ++g) {\n        for (int p = 0; p < groups[g].length; ++p) {\n            uint32_t bits = distance_key(to_evaluate, groups[g].points[p]);\n            if ((bits & 0x7fffffffu) > 0x7f800000u) {\n                free(keys);\n                return knn_insertion(n_groups, groups, k, to_evaluate);\n            }\n            keys[used++] = ((uint64_t)bits << 32) | (uint32_t)g;\n        }\n    }\n    retain_smallest_keys(keys, total, keep);\n    size_t counts[UCHAR_MAX + 1] = {0};\n    counts[(unsigned char)-1] = padding;\n    for (size_t i = 0; i < keep; ++i) {\n        ++counts[(unsigned char)groups[(uint32_t)keys[i]].label];\n    }\n    free(keys);\n    return winning_label(counts);\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",

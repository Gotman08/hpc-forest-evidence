"""ROOT-only local R8 candidate copy/rebinding; prepared, not executed by author.

No COMPONENTS.json, new PASS/XML/validation, Q or operational admission is made.
The candidate deliberately lacks its two new local validation slots. Historical
62 components remain byte-exact in ancestry. This module never invokes product
code, tests, transport, a clock, a UUID generator, a compiler or a worker.
"""
from __future__ import annotations

import argparse
import ast
import gzip
import hashlib
import io
import json
import os
from pathlib import Path
import shlex
import stat
import tarfile


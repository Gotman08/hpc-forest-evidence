    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <stdio.h>\\n#include <stdlib.h>\\n\\ntypedef struct {\\n    float x;\\n    float y;\\n} Point;\\n\\ntypedef struct {\\n    char label;\\n    int length;\\n    float *xs;\\n    float *ys;\\n} Group;\\n\\nvoid on_error() {\\n    printf(\\\"Invalid input file.\\\\n\\\");\\n    exit(1);\\n}\\n\\nint parse_number_of_groups() {\\n    int n;\\n    if (scanf(\\\" n_groups=%d \\\", &n) != 1) on_error();\\n    return n;\\n}\\n\\nPoint parse_point() {\\n    float x, y;\\n    if (scanf(\\\" (%f ,%f) \\\", &x, &y) != 2)  on_error();\\n    Point point;\\n    point.x = x;\\n    point.y = y;\\n    return point;\\n}\\n\\nGroup parse_next_group() {\\n    char label; \\n    int length;\\n\\n    if (scanf(\\\" label=%c \\\", &label) != 1) on_error();\\n    if (scanf(\\\" length=%d \\\", &length) != 1) on_error();\\n\\n    Group group;\\n    group.label = label;\\n    group.length = length;\\n    group.xs = (float *) malloc(sizeof(float) * length);\\n    group.ys = (float *) malloc(sizeof(float) * length);\\n\\n    for (int i = 0; i < length; i++) {\\n        Point p = parse_point();\\n        group.xs[i] = p.x;\\n        group.ys[i] = p.y;\\n    }\\n\\n    return group;\\n}\\n\\nint parse_k() {\\n    int k;\\n    if (scanf(\\\" k=%d \\\", &k) != 1) on_error();\\n    return k;\\n}\\n\",\n      \"path\": \"src/knn.h\"\n    },\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n#include <arm_neon.h>\\n\\ntypedef struct {\\n    float dist;\\n    char label;\\n    long idx;\\n} HeapEntry;\\n\\nstatic inline int worse_entry(const HeapEntry *a, const HeapEntry *b) {\\n    if (a->dist != b->dist) return a->dist > b->dist;\\n    return a->idx > b->idx;\\n}\\n\\nstatic inline void swap_entries(HeapEntry *a, HeapEntry *b) {\\n    HeapEntry t = *a; *a = *b; *b = t;\\n}\\n\\nstatic inline void sift_up(HeapEntry *heap, int pos) {\\n    while (pos > 0) {\\n        int parent = (pos - 1) / 2;\\n        if (worse_entry(&heap[pos], &heap[parent])) {\\n            swap_entries(&heap[pos], &heap[parent]);\\n            pos = parent;\\n        } else break;\\n    }\\n}\\n\\nstatic inline void sift_down(HeapEntry *heap, int start, int end) {\\n    int root = start;\\n    while (1) {\\n        int child = 2 * root + 1;\\n        if (child > end) break;\\n        int right = child + 1;\\n        if (right <= end && worse_entry(&heap[right], &heap[child])) child = right;\\n        if (worse_entry(&heap[root], &heap[child])) {\\n            swap_entries(&heap[root], &heap[child]);\\n            root = child;\\n        } else break;\\n    }\\n}\\n\\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n    HeapEntry *heap = (HeapEntry *) malloc(sizeof(HeapEntry) * k);\\n    if (!heap) on_error();\\n    int heap_size = 0;\\n    long idx = 0;\\n\\n    float px = to_evaluate.x;\\n    float py = to_evaluate.y;\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n        int j = 0;\\n\\n        // NEON vectorized processing in batches of four\\n        for (; j + 3 < g.length; j += 4) {\\n            float32x4_t xs_v = vld1q_f32(&g.xs[j]);\\n            float32x4_t ys_v = vld1q_f32(&g.ys[j]);\\n            float32x4_t qx = vdupq_n_f32(px);\\n            float32x4_t qy = vdupq_n_f32(py);\\n            float32x4_t dx = xs_v - qx;\\n            float32x4_t dy = ys_v - qy;\\n            float32x4_t d2 = dx * dx + dy * dy;\\n            float d[4];\\n            vst1q_f32(d, d2);\\n\\n            for (int t = 0; t < 4; t++) {\\n                HeapEntry e;\\n                e.dist = d[t];\\n                e.label = g.label;\\n                e.idx = idx++;\\n\\n                if (heap_size < k) {\\n                    heap[heap_size++] = e;\\n                    sift_up(heap, heap_size - 1);\\n                } else if (!worse_entry(&e, &heap[0])) {\\n                    heap[0] = e;\\n                    sift_down(heap, 0, k - 1);\\n                }\\n            }\\n        }\\n\\n        // Scalar remainder\\n        for (; j < g.length; j++) {\\n            float dx = g.xs[j] - px;\\n            float dy = g.ys[j] - py;\\n            float d = dx * dx + dy * dy;\\n\\n            HeapEntry e;\\n            e.dist = d;\\n            e.label = g.label;\\n            e.idx = idx++;\\n\\n            if (heap_size < k) {\\n                heap[heap_size++] = e;\\n                sift_up(heap, heap_size - 1);\\n            } else if (!worse_entry(&e, &heap[0])) {\\n                heap[0] = e;\\n                sift_down(heap, 0, k - 1);\\n            }\\n        }\\n    }\\n\\n    int counts[256] = {0};\\n    for (int i = 0; i < heap_size; i++) {\\n        unsigned char c = (unsigned char) heap[i].label;\\n        counts[c]++;\\n    }\\n    if (heap_size < k) {\\n        // Missing slots are sentinel label -1, which as unsigned char is 255\\n        counts[255] += (k - heap_size);\\n    }\\n\\n    free(heap);\\n\\n    int best_count = -1;\\n    char best_label = 0;\\n    for (int c = 0; c < 256; c++) {\\n        if (counts[c] > best_count) {\\n            best_count = counts[c];\\n            best_label = (char)c;\\n        }\\n    }\\n\\n    return best_label;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Combining structure-of-arrays layout (A), binary max-heap selection with index tie-breaking (A/B), NEON-vectorized distance computation (B), and direct frequency counting (C) yields a fast, exact KNN implementation. OpenMP is omitted because prior experiments showed it slows down this workload.\",\n  \"notes\": \"Integrated A's SoA layout and heap-based top-k selection, B's NEON vectorization adapted to the SoA arrays, and C's frequency-counting approach for label voting. The sentinel handling when fewer than k points exist is preserved by adding missing labels as unsigned char 255. OpenMP was considered but not used due to observed overhead in earlier runs.\",\n  \"sources_kept\": [\n    \"b29cec62b6a945b9\",\n    \"dadd0f7f9ebb4452\",\n    \"5724c0a7dc784fee\"\n  ],\n  \"transformations\": [\n    \"Changed Group layout from array-of-structs to structure-of-arrays (xs, ys) for cache locality and vectorization\",\n    \"Replaced insertion-sort selection with a binary max-heap of size k keyed by (distance, arrival index)\",\n    \"Vectorized distance computation using NEON vld1q_f32/vst1q_f32 on batches of four points\",\n    \"Avoided qsort by counting label frequencies directly from heap contents and handling missing slots as sentinel labels\"\n  ]\n}",

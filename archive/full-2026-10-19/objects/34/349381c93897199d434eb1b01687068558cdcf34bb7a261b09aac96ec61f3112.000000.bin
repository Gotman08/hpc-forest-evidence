import importlib.util,json,hashlib,os,tempfile,threading
from http.server import BaseHTTPRequestHandler,ThreadingHTTPServer
from pathlib import Path
s=importlib.util.spec_from_file_location('local_model', 'work/marathon-deepseek/local_model.py');m=importlib.util.module_from_spec(s);s.loader.exec_module(m)
data=b'0123456789abcdef'*1000
class Handler(BaseHTTPRequestHandler):
 def do_GET(self):
  lo,hi=map(int,self.headers['Range'][6:].split('-'))
  chunk=data[lo:hi+1];self.send_response(206);self.send_header('Content-Range',f'bytes {lo}-{hi}/{len(data)}');self.end_headers();self.wfile.write(chunk)
 def log_message(self,*args):pass
h=ThreadingHTTPServer(('127.0.0.1',0),Handler);t=threading.Thread(target=h.serve_forever,daemon=True);t.start()
try:
 with tempfile.TemporaryDirectory(dir='work/marathon-deepseek') as d:
  spec={'bytes':len(data),'url':f'http://127.0.0.1:{h.server_port}/blob','sha256':hashlib.sha256(data).hexdigest()}
  out=Path(d)/'good';r=m.download(spec,out);assert out.read_bytes()==data
  spec['sha256']='0'*64
  try:m.download(spec,Path(d)/'bad');raise AssertionError('Wrong hash was accepted')
  except RuntimeError as e:assert 'identity mismatch' in str(e)
 print('Range preservation and wrong-digest rejection passed')
finally:h.shutdown();h.server_close();t.join()

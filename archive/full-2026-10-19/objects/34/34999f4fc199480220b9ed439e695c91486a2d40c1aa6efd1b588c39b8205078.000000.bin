  "findings": [
    {
      "id": "ATTRIBUTES-ONLY-IS-NOT-THE-PROMISED-DATA-SHARING-LEASE",
      "severity": "blocking-r2",
      "source_lines": [
        335,
        339,
        375,
        390,
        453
      ],
      "observed_code": "Both file categories and parent handles request FILE_READ_ATTRIBUTES (0x80); copies share 0x1, sources/parents share 0x3.",
      "conclusion": "The two ROOT failures demonstrate the promised denial was not effective for these exact NTFS fixtures. Official API distinctions support attributes-only access as the explanation; no alternative access-mask probe was executed by reviewer.",
      "not_claimed": "No Windows kernel defect, no active-source interference, and no success of the candidate replacement mask are inferred."
    },
    {
      "id": "HELD-OBJECT-DOES-NOT-PROVE-CURRENT-PATH-IDENTITY",
      "severity": "blocking-r2",
      "source_lines": [
        442,
        447
      ],
      "conclusion": "verify_unchanged queries original held handles and lexical/ordinary path checks, but never freshly opens the current pathname and compares its VolumeSerial/FileID128 to the held baseline. An old held object alone cannot establish that a replaced name still refers to it."
    },
    {
      "id": "DO-NOT-DENY-DELETE-ON-ACTIVE-OBSERVER-STATE",
      "severity": "design-constraint",
      "source_lines": [
        88,
        99,
        720,
        732,
        739
      ],
      "conclusion": "The exact pinned observer writes a temporary file then os.replace(tmp,p); normal and error-state persistence use that operation. A genuinely DELETE-excluding lease can conflict with this rename/replace. The error path also saves state, so an exclusion can interfere with recovery persistence.",
      "recommendation": "Do not add READ_DATA/0x81/GENERIC_READ or a DELETE-excluding lease to active source files. Source metadata handles and parent handles should expressly share READ|WRITE|DELETE."
    }
  ],
  "bounded_candidate_contract": {
    "copies": {
      "desired_access": "GENERIC_READ (0x80000000)",
      "share_mode": "FILE_SHARE_READ (0x1)",
      "flags": "OPEN_EXISTING + FILE_FLAG_OPEN_REPARSE_POINT; ordinary exact cold copy only",
      "retain": "Full native identity/metadata baseline, all distinct FileIDs, copy nlink==1, held qualified no-follow payload reader, before/after consistency. ROOT must prove WRITE and DELETE denial on inert files before operational use."
    },
    "sources": {
      "desired_access": "FILE_READ_ATTRIBUTES (0x80) only",
      "share_mode": "FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE (0x7)",
      "source_payload_bytes_read": false,
      "replacement_prevented": false,
      "mutation_accepted": false,
      "new_required_check": "At lease entry, immediately before and after copy payload reads, and before final evidence: validate ordinary full parent chain, freshly open each exact current source pathname no-follow with metadata-only/shareRWD, query VolumeSerialNumber/FileID128/link count/full stable native metadata and compare to both held baseline and current held-handle facts; refuse missing/reparse/substitution/changed metadata or changed links. Close only the temporary validation handle. Recheck all copy/source FileID disjointness.",
      "parents": "Metadata-only shareRWD; current ordinary parent identities/metadata revalidated. Do not claim those metadata handles prohibit parent renaming."
    },
    "consistency_scope": "Checkpoint observations only, not a filesystem snapshot and not continuous exclusion of transient source changes. A failed check refuses reception; it does not stop/restart observer or reread source payloads.",
    "evidence_fields_to_keep_truthful": {
      "metadata_source_bytes_read": false,
      "source_metadata_only": true,
      "source_WRITE_and_DELETE_sharing_excluded": false,
      "source_replacement_prevented": false,
      "source_current_path_identity_rechecked": "true only after successful checks on actual input; no positive manufactured now",
      "copy_WRITE_and_DELETE_sharing_excluded": "requires new actual ROOT test receipt for exact candidate"
    }
  },
  "proposed_ROOT_only_inert_checks_NOT_EXECUTED": [
    "Keep original R2 31-case failure receipt immutable. Keep copy-write-denied test and require it to pass with GENERIC_READ/shareREAD; also verify copy deletion/replacement denied.",
    "On isolated new files only, reproduce exact observer save pattern: temp creation + os.replace while source metadata lease is held must succeed; the receiver must then reject changed current FileID or deleted/pending held object. This intentionally changes the future source test from replacement DENIED to replacement ALLOWED AND DETECTED.",
    "A source writer handle can remain open concurrently; appending/mutating source must be allowed by lease but rejected by fresh metadata comparison. Do not read any source payload to establish this.",
    "Stable source/copy positive remains valid; missing source, source/copy aliases, hardlinked copies, reparse parents, same-length source mutation, changed link count and replacement with another ordinary file all remain negative."
  ],
  "official_primary_documentation": [
    {
      "url": "https://learn.microsoft.com/en-us/windows/win32/api/fileapi/nf-fileapi-createfilew",
      "supports": "Requested access and sharing are distinct; attributes-only requests have special sharing treatment; FILE_SHARE_DELETE permits delete/rename; OPEN_REPARSE_POINT addresses link object instead of following final reparse target."
    },
    {
      "url": "https://learn.microsoft.com/en-us/windows/win32/fileio/file-access-rights-constants",
      "supports": "FILE_READ_ATTRIBUTES=0x80 differs from FILE_READ_DATA=0x1."
    },
    {
      "url": "https://learn.microsoft.com/en-us/windows/win32/fileio/creating-and-opening-files",
      "supports": "The documented sharing matrix for GENERIC_READ + FILE_SHARE_READ excludes conflicting write opens."
    }
  ],

      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <limits>\n#include <memory>\n#include <vector>\n\nclass FastInput {\n    char buffer_[1 << 16];\n    std::size_t position_ = 0;\n    std::size_t length_ = 0;\n\n    int next() {\n        if (position_ == length_) {\n            length_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (length_ == 0) return EOF;\n        }\n        return static_cast<unsigned char>(buffer_[position_++]);\n    }\n\npublic:\n    bool readInt(int& value) {\n        int c;\n        do {\n            c = next();\n        } while (c != EOF && c <= ' ');\n        if (c == EOF) return false;\n\n        const bool negative = c == '-';\n        if (c == '-' || c == '+') c = next();\n        std::int64_t magnitude = 0;\n        while (c >= '0' && c <= '9') {\n            magnitude = magnitude * 10 + (c - '0');\n            c = next();\n        }\n        value = static_cast<int>(negative ? -magnitude : magnitude);\n        return true;\n    }\n};\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.readInt(n) || !input.readInt(s)) return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const int width = n - s + 1;\n    std::vector<int> row(n);\n    std::vector<std::uint32_t> vertical(width, 0);\n    const std::size_t historySize =\n        static_cast<std::size_t>(s) * static_cast<std::size_t>(width);\n    std::unique_ptr<std::uint32_t[]> history(\n        new std::uint32_t[historySize]);\n\n    std::int32_t maximum = std::numeric_limits<std::int32_t>::min();\n    int ringRow = 0;\n    for (int r = 0; r < n; ++r) {\n        std::uint32_t horizontal = 0;\n        for (int c = 0; c < s - 1; ++c) {\n            input.readInt(row[c]);\n            horizontal += static_cast<std::uint32_t>(row[c]);\n        }\n\n        std::uint32_t* historyRow = history.get() +\n            static_cast<std::size_t>(ringRow) * width;\n        const bool expires = r >= s;\n        const bool complete = r >= s - 1;\n\n        for (int c = 0; c < width; ++c) {\n            const int enteringColumn = c + s - 1;\n            input.readInt(row[enteringColumn]);\n            horizontal += static_cast<std::uint32_t>(row[enteringColumn]);\n\n            // Preserve the reference's 32-bit sum bits without signed overflow.\n            std::uint32_t total = vertical[c] + horizontal;\n            if (expires) total -= historyRow[c];\n            historyRow[c] = horizontal;\n            vertical[c] = total;\n\n            if (complete) {\n                maximum = std::max(maximum, static_cast<std::int32_t>(total));\n            }\n            horizontal -= static_cast<std::uint32_t>(row[c]);\n        }\n\n        if (++ringRow == s) ringRow = 0;\n    }\n\n    std::printf(\"%d\\n\", static_cast<int>(maximum));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Streaming horizontal window sums through a contiguous circular history eliminates strided S-element updates, reducing computation to O(N²) and substantially reducing matrix storage.",

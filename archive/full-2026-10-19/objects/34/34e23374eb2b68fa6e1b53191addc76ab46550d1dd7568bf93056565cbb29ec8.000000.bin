        "hypothesis": "On ARM64, padded byte adjacency rows allow a native 16-lane table lookup to verify an entire permuted row with fewer proxy accesses and data-dependent branches.",
        "id": "98c70a83154a4453",
        "ordinal": 1,
        "parent_id": null,
        "role": "B",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/brute_isomorphism.cpp"
          ],
          "retained": [
            "Replace vector<bool> adjacency proxies with contiguous, zero-padded byte rows.",
            "Use exact AArch64 NEON table lookup and integer mismatch reduction for graphs fitting one 16-byte row; retain scalar triangular verification for larger graphs and other architectures.",
            "Store valid vertex indices as padded unsigned bytes directly usable as SIMD lookup indices."
          ]
        },

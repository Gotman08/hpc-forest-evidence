        "depth": 1,
        "epoch": 1,
        "hypothesis": "Finer 6!-permutation blocks should improve four-core load balance while a persistent OpenMP team and reusable ordered output buffers limit scheduling and allocation overhead.",
        "id": "6fdb634d506c40b2",
        "ordinal": 2,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/brute_isomorphism.cpp"
          ],
          "retained": [
            "Keep size and identity checks serial; activate parallel enumeration only for at least eight vertices and multiple available OpenMP threads.",
            "Generate exact Heap-order 6! blocks in bounded batches and distribute them using schedule(dynamic, 1) within one persistent team.",
            "Buffer successful mappings independently per block and merge completed buffers serially in original enumeration order."
          ]
        },

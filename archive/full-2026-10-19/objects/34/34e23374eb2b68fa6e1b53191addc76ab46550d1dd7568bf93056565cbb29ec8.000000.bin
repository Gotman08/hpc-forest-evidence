    {
      "id": "0418d6eb25a94391",
      "role": "A",
      "mission": {
        "base_commit": "5bb232c904bf737e5c10649ee0853c225ffa604a",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Contiguous two-word adjacency and candidate-domain masks should improve locality and cheaply reject entire impossible Heap blocks through forward checking.",
        "id": "0418d6eb25a94391",
        "ordinal": 2,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/brute_isomorphism.cpp"
          ],
          "retained": [
            "Pack adjacency rows and depth-major candidate domains into two uint64_t words per row.",
            "Initialize candidate masks by degree and self-loop compatibility, rejecting unequal class multiplicities.",
            "Intersect contiguous remaining domains against each fixed suffix vertex; prune empty domains or incomplete target coverage.",
            "Traverse recursive Heap blocks in reference order and apply precomputed exact endpoint permutations whenever a block is skipped."
          ]
        },

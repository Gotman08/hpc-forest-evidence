        "transformations": {
          "files": [
            "src/brute_isomorphism.cpp"
          ],
          "retained": [
            "Replace nested vector<bool> adjacency with contiguous row-major byte storage and cached row pointers.",
            "Precompute a contiguous degree/self-loop compatibility table from Boolean adjacency.",
            "Traverse Heap permutations in fixed-suffix blocks, checking only newly fixed rows and pruning incompatible blocks.",
            "Precompute exact endpoint swap plans in contiguous storage and apply them to skipped blocks to preserve traversal order."
          ]
        },

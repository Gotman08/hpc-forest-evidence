      "mission": {
        "base_commit": "65724030874bc71c8493ddac45b2dad9722ac548",
        "delegation_parent": "R/G",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "For small distinct obstacle sets, binomial inclusion-exclusion avoids traversing the full grid; for larger sets, the measured anti-diagonal recurrence remains the fallback. A conservative O(N) obstacle cutoff keeps the pairwise work bounded relative to the dense recurrence.",
        "id": "4856107a3b0f4fcc",
        "ordinal": 2,
        "parent_id": null,
        "role": "G",
        "source_commits": [
          "e88539652f9b6fe26def01dc29639b6705ec5dae",
          "fed4fcd576e50c06325056bed5e2b97ea6d00402"
        ],
        "sources": [
          "cc89b91269e643f5",
          "1f9c4d8571df43cb"
        ],
        "transformations": {
          "files": [
            "src/solution.cpp"
          ],
          "retained": [
            "Sort and deduplicate obstacles by diagonal and row; use binomial path counts with inclusion-exclusion when the distinct obstacle count is at most max(1, N/8).",
            "For larger obstacle sets, use a two-buffer anti-diagonal recurrence over contiguous free spans, with GCC ivdep on the dependency-free interior.",
            "Handle blocked endpoints explicitly and retain O(N) DP storage in the dense fallback."
          ]
        },

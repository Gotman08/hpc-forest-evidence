    {
      "id": "c857604dcdcd4afd",
      "role": "G",
      "mission": {
        "base_commit": "65724030874bc71c8493ddac45b2dad9722ac548",
        "delegation_parent": "R/G",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "A conservative sparse-obstacle branch can avoid quadratic grid traversal when the distinct obstacle count is small, while the measured anti-diagonal recurrence remains the fallback for larger obstacle sets.",
        "id": "c857604dcdcd4afd",
        "ordinal": 1,
        "parent_id": null,
        "role": "G",
        "source_commits": [
          "e88539652f9b6fe26def01dc29639b6705ec5dae",

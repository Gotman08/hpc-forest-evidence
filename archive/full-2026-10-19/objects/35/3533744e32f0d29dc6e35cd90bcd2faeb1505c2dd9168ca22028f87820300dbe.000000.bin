from pathlib import Path
import hashlib,json,datetime
base=Path(r'C:/Users/nicol/Documents/Codex/2026-10-15/cr')
guide=base/'outputs/HPC-Forest-Harnais-Comparaison-r1/SUIVI-COMPACT.md'
reception=base/'outputs/HPC-Forest-Primes-Max-Certifie-r1/qualification-arm64-r1/reception-751926'
audit=reception/'AUDIT-RECEPTION.json'
raw=audit.read_bytes()
assert hashlib.sha256(raw).hexdigest()=='ae76aecb842c84f0672cae596fef83dc0e431e19d52fd13fe2016bcd975011e6'
data=json.loads(raw)
assert data['verified'] and data['exact_reference_outputs_verified']==12 and not data['native_research_admitted']
previous=guide.read_bytes(); content=previous.decode('utf-8')
old='Qualification MÉCANIQUE allouée soumise une seule fois : 751926, plan e59bb8e9eafd4b7e82b46106d92ef108, quinze minutes/4 CPU ARM64/16 Gio/zéro GPU/zéro inférence. Premier état frais COMPLETED 0:0, exécution 22:09:48–50 UTC ; logs sans stderr, passed:true. Pas de RUNNING directement vu avant cette fin de deux secondes. Archive annoncée SHA 1d70909bd68ee171854a592bf654b44f93a06589e8bf9ddbf04b7fde5210e58d. Réception indépendante/efficacité/trois SHA/restauration/audit à lire dans qualification-arm64-r1/reception-751926/ avant admission. Ne pas confondre cette référence C avec une recherche de modèle ; zéro cellule native R2 lancée.'
new='Qualification MÉCANIQUE 751926 CLOSE, reçue et auditée positive : COMPLETED 0:0, 22:09:48–50 UTC ; 4 CPU ARM64/16 Gio/zéro GPU, une compilation du C officiel inchangé, douze sorties exactes sans stderr. Archive annoncée/distante/locale identique SHA 1d70909bd68ee171854a592bf654b44f93a06589e8bf9ddbf04b7fde5210e58d ; 101 fichiers restaurés et 67 entrées du payload inchangés, ELF AArch64 vérifié par lecture. Lire qualification-arm64-r1/reception-751926/AUDIT-RECEPTION.json et PREMIER-DEMARRAGE-MECANIQUE.json. Limites : premier état déjà terminal, aucun RUNNING vu ; flags -O2/-std=c11/-lm seulement, pas Werror. Zéro inférence, aucun premier appel/évaluation natifs R2 validés. Ne plus repoller/relancer ce job ; aucun gain de recherche revendiqué.'
assert content.count(old)==1
snap=base/'outputs/HPC-Forest-Etude-2020-2024-r1/reprises/reorientation-max-20261017/reception-mecanique-r2-20261017T2220UTC'
snap.mkdir(exist_ok=False)
(snap/'SUIVI-COMPACT-avant.md').write_bytes(previous)
guide.write_text(content.replace(old,new),encoding='utf-8')
receipt={'verified':True,'utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'previous_guide_sha256':hashlib.sha256(previous).hexdigest(),'current_guide_sha256':hashlib.sha256(guide.read_bytes()).hexdigest(),'mechanical_audit':{'path':str(audit),'sha256':hashlib.sha256(raw).hexdigest()},'native_r2_admitted':False,'other_guide_paragraphs_unchanged':True}
(snap/'guide-actualise.json').write_text(json.dumps(receipt,ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
print(json.dumps(receipt,ensure_ascii=False))
        "content": "#include <cstdio>\n#include <cstddef>\n#include <cstdint>\n#include <cassert>\n#include <limits>\n#include <memory>\n#include <vector>\n\nnamespace {\n\nclass FastInput {\n    static const std::size_t Capacity = 1u << 16;\n    unsigned char buffer_[Capacity + 1];\n    unsigned char *current_;\n    unsigned char *end_;\n\n    bool refill() {\n        const std::size_t count = std::fread(buffer_, 1, Capacity, stdin);\n        current_ = buffer_;\n        end_ = buffer_ + count;\n        buffer_[count] = 0;\n        return count != 0;\n    }\n\npublic:\n    FastInput() : current_(buffer_), end_(buffer_) {\n        buffer_[0] = 0;\n    }\n\n    inline int readInt() {\n        while (*current_ <= ' ') {\n            if (current_ == end_) {\n                if (!refill()) return 0;\n            } else {\n                ++current_;\n            }\n        }\n\n        const bool negative = *current_ == '-';\n        if (negative || *current_ == '+') ++current_;\n        std::uint32_t value = 0;\n        for (;;) {\n            while (static_cast<unsigned>(*current_ - '0') <= 9u) {\n                value = value * 10u + static_cast<unsigned>(*current_ - '0');\n                ++current_;\n            }\n            if (current_ != end_) {\n                ++current_;\n                break;\n            }\n            if (!refill()) break;\n        }\n        return negative ? static_cast<int>(-static_cast<long long>(value))\n                        : static_cast<int>(value);\n    }\n};\n\ntemplate<bool Remove, bool Store>\ninline long long updateRaw(FastInput &input, int j, int *history,\n                           long long *columns) {\n    const int x = input.readInt();\n    long long value = columns[j] + static_cast<long long>(x);\n    if (Remove) value -= history[j];\n    if (Store) history[j] = x;\n    columns[j] = value;\n    return value;\n}\n\ntemplate<bool Remove, bool Store, bool Score>\ninline void consumeRawRow(FastInput &input, int n, int s, int *history,\n                          long long *columns, long long &best) {\n    if (!Score) {\n        for (int j = 0; j < n; ++j)\n            updateRaw<Remove, Store>(input, j, history, columns);\n        return;\n    }\n\n    long long sum = 0;\n    int j = 0;\n    for (; j < s; ++j)\n        sum += updateRaw<Remove, Store>(input, j, history, columns);\n    if (sum > best) best = sum;\n    for (; j < n; ++j) {\n        const long long value = updateRaw<Remove, Store>(input, j, history, columns);\n        sum += value - columns[j - s];\n        if (sum > best) best = sum;\n    }\n}\n\nlong long verticalFirst(FastInput &input, int n, int s) {\n    const int exitRows = n - s;\n    std::unique_ptr<int[]> history(new int[static_cast<std::size_t>(s) * n]);\n    std::vector<long long> columns(n, 0);\n    long long best = std::numeric_limits<long long>::lowest();\n\n    int slot = 0;\n    for (int row = 0; row < n; ++row) {\n        int *saved = history.get() + static_cast<std::size_t>(slot) * n;\n        if (row < s - 1) {\n            consumeRawRow<false, true, false>(input, n, s, saved, columns.data(), best);\n        } else if (row == s - 1) {\n            consumeRawRow<false, true, true>(input, n, s, saved, columns.data(), best);\n        } else if (row < exitRows) {\n            consumeRawRow<true, true, true>(input, n, s, saved, columns.data(), best);\n        } else {\n            consumeRawRow<true, false, true>(input, n, s, saved, columns.data(), best);\n        }\n        if (++slot == s) slot = 0;\n    }\n    return best;\n}\n\ntemplate<bool Remove, bool Store, bool Score>\ninline void updateHorizontal(int j, long long horizontal, long long *history,\n                             long long *columns, long long &best) {\n    long long value = columns[j] + horizontal;\n    if (Remove) value -= history[j];\n    if (Store) history[j] = horizontal;\n    columns[j] = value;\n    if (Score && value > best) best = value;\n}\n\ntemplate<bool Remove, bool Store, bool Score>\ninline void consumeHorizontalRow(FastInput &input, int s, int exits,\n                                 int *outgoing, long long *history,\n                                 long long *columns, long long &best) {\n    long long horizontal = 0;\n    // Only these leading entries can leave a horizontal window.\n    for (int j = 0; j < exits; ++j) {\n        const int x = input.readInt();\n        outgoing[j] = x;\n        horizontal += x;\n    }\n    for (int j = exits; j < s; ++j)\n        horizontal += input.readInt();\n\n    updateHorizontal<Remove, Store, Score>(0, horizontal, history, columns, best);\n    for (int j = 1; j <= exits; ++j) {\n        horizontal += static_cast<long long>(input.readInt()) - outgoing[j - 1];\n        updateHorizontal<Remove, Store, Score>(j, horizontal, history, columns, best);\n    }\n}\n\nlong long horizontalFirst(FastInput &input, int n, int s) {\n    const int exits = n - s;\n    const int width = exits + 1;\n    std::unique_ptr<int[]> outgoing(new int[exits]);\n    std::unique_ptr<long long[]> history(\n        new long long[static_cast<std::size_t>(exits) * width]);\n    std::vector<long long> columns(width, 0);\n    long long best = std::numeric_limits<long long>::lowest();\n\n    // With S > N/2, only the first N-S rows will ever leave a window.\n    for (int row = 0; row < n; ++row) {\n        if (row < exits) {\n            long long *saved = history.get() + static_cast<std::size_t>(row) * width;\n            consumeHorizontalRow<false, true, false>(\n                input, s, exits, outgoing.get(), saved, columns.data(), best);\n        } else if (row < s - 1) {\n            consumeHorizontalRow<false, false, false>(\n                input, s, exits, outgoing.get(), nullptr, columns.data(), best);\n        } else if (row == s - 1) {\n            consumeHorizontalRow<false, false, true>(\n                input, s, exits, outgoing.get(), nullptr, columns.data(), best);\n        } else {\n            long long *saved = history.get() + static_cast<std::size_t>(row - s) * width;\n            consumeHorizontalRow<true, false, true>(\n                input, s, exits, outgoing.get(), saved, columns.data(), best);\n        }\n    }\n    return best;\n}\n\n} // namespace\n\nint main() {\n    FastInput input;\n    const int n = input.readInt();\n    const int s = input.readInt();\n    assert(s > 0 && s < n && n < 8000);\n\n    const long long answer = s <= n - s\n        ? verticalFirst(input, n, s)\n        : horizontalFirst(input, n, s);\n    std::printf(\"%lld\\n\", answer);\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }

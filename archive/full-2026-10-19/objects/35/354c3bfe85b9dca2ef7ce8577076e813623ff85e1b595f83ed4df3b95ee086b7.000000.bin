      "content": "#include \"knn.h\"\n#include <stdint.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\ntypedef struct {\n    size_t index;\n    float distance;\n    char label;\n} Neighbor;\n\nstatic int neighbor_worse(const Neighbor *a, const Neighbor *b) {\n    return a->distance > b->distance ||\n           (a->distance == b->distance && a->index > b->index);\n}\n\nstatic void sift_down(Neighbor *heap, size_t count, size_t root,\n                      Neighbor value) {\n    while (root < count / 2) {\n        size_t child = root * 2 + 1;\n        if (child + 1 < count &&\n            neighbor_worse(&heap[child + 1], &heap[child])) {\n            child++;\n        }\n        if (!neighbor_worse(&heap[child], &value)) {\n            break;\n        }\n        heap[root] = heap[child];\n        root = child;\n    }\n    heap[root] = value;\n}\n\nstatic void offer_neighbor(Neighbor *heap, size_t *count, size_t capacity,\n                           Neighbor value) {\n    if (*count < capacity) {\n        heap[*count] = value;\n        (*count)++;\n        if (*count == capacity) {\n            for (size_t i = capacity / 2; i > 0; i--) {\n                Neighbor current = heap[i - 1];\n                sift_down(heap, capacity, i - 1, current);\n            }\n        }\n    } else if (neighbor_worse(&heap[0], &value)) {\n        sift_down(heap, capacity, 0, value);\n    }\n}\n\nstatic int select_range(int n_groups, const Group *groups, Point to_evaluate,\n                        size_t first, size_t last, size_t capacity,\n                        Neighbor *heap, size_t *count) {\n    size_t offset = 0;\n    size_t used = 0;\n\n    for (int i = 0; i < n_groups && offset < last; i++) {\n        const Group *g = &groups[i];\n        size_t length = g->length > 0 ? (size_t)g->length : 0;\n        size_t group_end = offset + length;\n\n        if (group_end > first) {\n            size_t begin = first > offset ? first - offset : 0;\n            size_t end = last < group_end ? last - offset : length;\n\n            for (size_t j = begin; j < end; j++) {\n                float d = euclidean_distance_no_sqrt(to_evaluate, g->points[j]);\n                if (d != d) {\n                    *count = used;\n                    return 1;\n                }\n\n                Neighbor value;\n                value.index = offset + j;\n                value.distance = d;\n                value.label = g->label;\n                offer_neighbor(heap, &used, capacity, value);\n            }\n        }\n        offset = group_end;\n    }\n\n    *count = used;\n    return 0;\n}\n\nstatic int select_labels(int n_groups, const Group *groups, int k,\n                         Point to_evaluate, size_t n_points, char *labels) {\n    size_t capacity = (size_t)k;\n\n    /* With room for every point, only the label multiset matters. */\n    if (n_points <= capacity) {\n        size_t out = 0;\n        for (int i = 0; i < n_groups; i++) {\n            for (int j = 0; j < groups[i].length; j++) {\n                labels[out++] = groups[i].label;\n            }\n        }\n        while (out < capacity) {\n            labels[out++] = -1;\n        }\n        return 1;\n    }\n\n    int workers = 1;\n#ifdef _OPENMP\n    if (!omp_in_parallel()) {\n        workers = omp_get_max_threads();\n        if (workers > 4) workers = 4;\n        if (workers < 1) workers = 1;\n\n        /* Amortize team startup and keep the serial candidate merge small. */\n        while (workers > 1 &&\n               (n_points / (size_t)workers < 16384 ||\n                n_points / capacity < (size_t)workers * 8)) {\n            workers--;\n        }\n    }\n#endif\n\n    if (capacity > SIZE_MAX / sizeof(Neighbor) / (size_t)workers) {\n        return 0;\n    }\n    Neighbor *heaps = (Neighbor *)malloc(capacity * (size_t)workers *\n                                         sizeof(Neighbor));\n    if (heaps == NULL) {\n        return 0;\n    }\n\n    size_t counts[4] = {0, 0, 0, 0};\n    int has_nan = 0;\n\n#ifdef _OPENMP\n    if (workers > 1) {\n        size_t base = n_points / (size_t)workers;\n        size_t remainder = n_points % (size_t)workers;\n\n        #pragma omp parallel for schedule(static) num_threads(workers) reduction(|:has_nan)\n        for (int part = 0; part < workers; part++) {\n            size_t p = (size_t)part;\n            size_t first = p * base + (p < remainder ? p : remainder);\n            size_t last = first + base + (p < remainder);\n            has_nan |= select_range(n_groups, groups, to_evaluate,\n                                    first, last, capacity,\n                                    heaps + p * capacity, &counts[part]);\n        }\n    } else\n#endif\n    {\n        has_nan = select_range(n_groups, groups, to_evaluate,\n                               0, n_points, capacity, heaps, &counts[0]);\n    }\n\n    if (has_nan) {\n        free(heaps);\n        return 0;\n    }\n\n    /* A locally discarded point already has k better global-order keys. */\n    for (int part = 1; part < workers; part++) {\n        Neighbor *local = heaps + (size_t)part * capacity;\n        for (size_t j = 0; j < counts[part]; j++) {\n            offer_neighbor(heaps, &counts[0], capacity, local[j]);\n        }\n    }\n\n    for (size_t j = 0; j < counts[0]; j++) {\n        labels[j] = heaps[j].label;\n    }\n    for (size_t j = counts[0]; j < capacity; j++) {\n        labels[j] = -1;\n    }\n    free(heaps);\n    return 1;\n}\n\nstatic void select_labels_reference(int n_groups, Group *groups, int k,\n                                    Point to_evaluate, char *labels) {\n    float *distances = (float *)malloc(sizeof(float) * k);\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n    free(distances);\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *)malloc(sizeof(char) * k);\n    size_t n_points = 0;\n    int count_valid = 1;\n    int i;\n\n    for (i = 0; i < n_groups; i++) {\n        if (groups[i].length > 0) {\n            size_t length = (size_t)groups[i].length;\n            if (n_points > SIZE_MAX - length) {\n                count_valid = 0;\n                break;\n            }\n            n_points += length;\n        }\n    }\n\n    if (k <= 0 || !count_valid ||\n        !select_labels(n_groups, groups, k, to_evaluate, n_points, labels)) {\n        select_labels_reference(n_groups, groups, k, to_evaluate, labels);\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(labels);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Statically sharing contiguous point ranges across at most four threads, using private stable top-k heaps and one deterministic merge, should reduce selection time without per-point synchronization.",
  "notes": "Not executed. OpenMP is conditional on the existing build; otherwise heap selection runs serially. A locally discarded point has at least k better (distance, encounter-index) keys, so cannot enter the global top-k. NaNs trigger original insertion semantics when selection is needed. Distance arithmetic, label voting, encounter-order ties, and k>N placeholders are preserved.",

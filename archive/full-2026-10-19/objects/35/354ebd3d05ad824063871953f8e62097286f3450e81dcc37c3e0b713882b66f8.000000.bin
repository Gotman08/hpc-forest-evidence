      "content": "#define _GNU_SOURCE\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Compute gravitational forces using Structure-of-Arrays layout.\n */\nvoid body_force(float *restrict x, float *restrict y, float *restrict z,\n                float *restrict vx, float *restrict vy, float *restrict vz,\n                float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    float xi = x[i];\n    float yi = y[i];\n    float zi = z[i];\n\n    for (int j = 0; j < n; ++j) {\n      float dx = x[j] - xi;\n      float dy = y[j] - yi;\n      float dz = z[j] - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1.0f / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    vx[i] += dt*fx;\n    vy[i] += dt*fy;\n    vz[i] += dt*fz;\n  }\n}\n\n/*\n * Read binary dataset and convert to SoA.\n */\nvoid read_dataset(float **x, float **y, float **z,\n                  float **vx, float **vy, float **vz,\n                  int *nbodies) {\n  if (fread(nbodies, sizeof(*nbodies), 1, stdin) != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  size_t sz = *nbodies * sizeof(float);\n  if (posix_memalign((void**)x, 16, sz) ||\n      posix_memalign((void**)y, 16, sz) ||\n      posix_memalign((void**)z, 16, sz) ||\n      posix_memalign((void**)vx, 16, sz) ||\n      posix_memalign((void**)vy, 16, sz) ||\n      posix_memalign((void**)vz, 16, sz)) {\n    fprintf(stderr,\"\\nError allocating aligned memory\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  Body *tmp = (Body *)malloc(*nbodies * sizeof(Body));\n  if (!tmp) { perror(\"malloc\"); exit(EXIT_FAILURE); }\n  if (fread(tmp, *nbodies * sizeof(Body), 1, stdin) != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  for (int i = 0; i < *nbodies; ++i) {\n    (*x)[i] = tmp[i].x;\n    (*y)[i] = tmp[i].y;\n    (*z)[i] = tmp[i].z;\n    (*vx)[i] = tmp[i].vx;\n    (*vy)[i] = tmp[i].vy;\n    (*vz)[i] = tmp[i].vz;\n  }\n  free(tmp);\n}\n\n/*\n * Write SoA data back to AoS binary format.\n */\nvoid write_dataset(int nbodies, float *x, float *y, float *z,\n                   float *vx, float *vy, float *vz) {\n  Body *tmp = (Body *)malloc(nbodies * sizeof(Body));\n  if (!tmp) { perror(\"malloc\"); exit(EXIT_FAILURE); }\n\n  for (int i = 0; i < nbodies; ++i) {\n    tmp[i].x = x[i];\n    tmp[i].y = y[i];\n    tmp[i].z = z[i];\n    tmp[i].vx = vx[i];\n    tmp[i].vy = vy[i];\n    tmp[i].vz = vz[i];\n  }\n\n  if (fwrite(tmp, nbodies * sizeof(Body), 1, stdout) != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n  free(tmp);\n}\n\nint main(int argc, char **argv) {\n  int nbodies;\n  float *x, *y, *z, *vx, *vy, *vz;\n\n  read_dataset(&x, &y, &z, &vx, &vy, &vz, &nbodies);\n\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    body_force(x, y, z, vx, vy, vz, DT, nbodies);\n\n    for (int i = 0; i < nbodies; ++i) {\n      x[i] += vx[i] * DT;\n      y[i] += vy[i] * DT;\n      z[i] += vz[i] * DT;\n    }\n  }\n\n  write_dataset(nbodies, x, y, z, vx, vy, vz);\n\n  free(x); free(y); free(z); free(vx); free(vy); free(vz);\n  return 0;\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Switching from Array-of-Structures (AoS) to Structure-of-Arrays (SoA) data layout with aligned memory allocation improves spatial locality when accessing body coordinates in the inner loop, enabling better cache utilization and auto-vectorization. Adding restrict qualifiers on pointer parameters further assists the compiler by disambiguating aliasing. This transformation preserves exact floating-point operation order per body because the computation remains identical (i outer, j inner) with only memory access pattern changed.",
  "notes": "The previous SoA attempt failed due to incorrect use of 'restrict' and missing feature test macro for posix_memalign. Here we define _GNU_SOURCE before includes, apply restrict correctly on pointer parameters, and handle allocation errors explicitly. The temporary AoS buffer is used only during I/O (once per run), so overhead is negligible.",

sum nbody --model hpcforest-deepseek-v4flash0731:mxfp4 --local-model-spec \"$root/v4flash0731.json\" --cycles 4 --trials-per-role 6 --integrations 6 --wall-seconds 21600 --tokens 4000000 --generation-seconds 600 --context-tokens 65536 --max-output-tokens 32768 --temperature 0.2 --repeat-penalty 1.1 --repeat-last-n 64 --root \"$root\" --ollama /scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/tools/ollama-0.40.4/bin/ollama --detector \"$root/detect_resources.py\"\n'",

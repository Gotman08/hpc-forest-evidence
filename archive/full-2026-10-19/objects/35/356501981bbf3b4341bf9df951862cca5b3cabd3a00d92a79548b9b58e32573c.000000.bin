#include <iostream>
#include <vector>
#include <cstdio>
#include <algorithm>
#include <climits>

int main() {
	int n, s;
	std::cin >> n >> s;
	// Read matrix into flat array for cache efficiency
	std::vector<int> a(n * n);
	for (int i = 0; i < n; ++i)
		for (int j = 0; j < n; ++j)
			scanf("%d", &a[i * n + j]);

	// Prefix sum array: pref[(i+1)*(n+1) + (j+1)] = sum of a[0..i][0..j]
	std::vector<int> pref((n + 1) * (n + 1), 0);

	// Horizontal pass: row-wise cumulative sums, parallel over rows
#pragma omp parallel for schedule(static)
	for (int i = 0; i < n; ++i) {
		int sum = 0;
		for (int j = 0; j < n; ++j) {
			sum += a[i * n + j];
			pref[(i + 1) * (n + 1) + (j + 1)] = sum;
		}
	}

	// Vertical pass: accumulate columns, parallel over columns
#pragma omp parallel for schedule(static)
	for (int j = 0; j < n; ++j) {
		int sum = 0;
		for (int i = 0; i < n; ++i) {
			sum += pref[(i + 1) * (n + 1) + (j + 1)];
			pref[(i + 1) * (n + 1) + (j + 1)] = sum;
		}
	}

	// Search all SxS submatrices using O(1) prefix-sum queries
	int mxSum = INT_MIN;
#pragma omp parallel for collapse(2) schedule(static) reduction(max:mxSum)
	for (int i = 0; i <= n - s; ++i) {
		for (int j = 0; j <= n - s; ++j) {
			int sum = pref[(i + s) * (n + 1) + (j + s)]
				- pref[i * (n + 1) + (j + s)]
				- pref[(i + s) * (n + 1) + j]
				+ pref[i * (n + 1) + j];
			mxSum = std::max(mxSum, sum);
		}
	}

	printf("%d\n", mxSum);
	return 0;
}

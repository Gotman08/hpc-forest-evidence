  "data": {
    "files": [
      {
        "content": "#include \"knn.h\"\n#include <float.h>\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nstatic inline void consider_candidate(float *distances, char *labels,\n                                      int k, float d, char label) {\n    float farthest = distances[k - 1];\n    if (farthest != -1.0f && d >= farthest) return;\n\n    for (int x = 0; x < k; ++x) {\n        if (d < distances[x] || distances[x] == -1.0f) {\n            size_t shifted = (size_t)(k - x - 1);\n            if (shifted != 0) {\n                memmove(distances + x + 1, distances + x,\n                        shifted * sizeof(*distances));\n                memmove(labels + x + 1, labels + x,\n                        shifted * sizeof(*labels));\n            }\n            distances[x] = d;\n            labels[x] = label;\n            return;\n        }\n    }\n}\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic inline int reject_four_points(const Point *points,\n                                     float32x4_t query_x,\n                                     float32x4_t query_y,\n                                     float farthest) {\n    float32x4_t xy01, xy23;\n    memcpy(&xy01, points, sizeof(xy01));\n    memcpy(&xy23, points + 2, sizeof(xy23));\n\n    const float32x4_t px = vuzp1q_f32(xy01, xy23);\n    const float32x4_t py = vuzp2q_f32(xy01, xy23);\n    const float32x4_t dx = vsubq_f32(px, query_x);\n    const float32x4_t dy = vsubq_f32(py, query_y);\n    const float32x4_t limit = vdupq_n_f32(farthest);\n\n    /* Component squares are lower bounds even when scalar sums fuse. */\n    const uint32x4_t rejected = vorrq_u32(\n        vcgeq_f32(vmulq_f32(dx, dx), limit),\n        vcgeq_f32(vmulq_f32(dy, dy), limit));\n    return vminvq_u32(rejected) != 0;\n}\n#endif\n\nstatic char knn_vote(char *labels, int k) {\n    qsort(labels, (size_t)k, sizeof(*labels), compare_for_sort);\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; ++i) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            ++current_frequency;\n        }\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n    return most_frequent;\n}\n\nstatic char knn_serial(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *)malloc((size_t)k * sizeof(*labels));\n    float *distances = (float *)malloc((size_t)k * sizeof(*distances));\n    if (labels == NULL || distances == NULL) {\n        free(labels);\n        free(distances);\n        on_error();\n        return (char)-1;\n    }\n\n    for (int i = 0; i < k; ++i) {\n        labels[i] = (char)-1;\n        distances[i] = -1.0f;\n    }\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const float32x4_t query_x = vdupq_n_f32(to_evaluate.x);\n    const float32x4_t query_y = vdupq_n_f32(to_evaluate.y);\n#endif\n\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n        int j = 0;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n        for (; sizeof(Point) == 2 * sizeof(float) && g.length - j >= 4;\n             j += 4) {\n            float farthest = distances[k - 1];\n            if (farthest != -1.0f &&\n                reject_four_points(g.points + j, query_x, query_y, farthest)) {\n                continue;\n            }\n            for (int lane = 0; lane < 4; ++lane) {\n                float d = euclidean_distance_no_sqrt(to_evaluate,\n                                                      g.points[j + lane]);\n                consider_candidate(distances, labels, k, d, g.label);\n            }\n        }\n#endif\n        for (; j < g.length; ++j) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            consider_candidate(distances, labels, k, d, g.label);\n        }\n    }\n\n    char result = knn_vote(labels, k);\n    free(distances);\n    free(labels);\n    return result;\n}\n\nenum {\n    KNN_BINS = 2048,\n    KNN_BIN_SHIFT = 20,\n    KNN_LABELS = 256\n};\n\ntypedef struct {\n    size_t order;\n    uint32_t key;\n    unsigned char label;\n} KNNNeighbor;\n\ntypedef struct {\n    size_t histogram[KNN_BINS];\n    size_t votes[KNN_LABELS];\n    size_t bucket_offset;\n    int saw_nan;\n    unsigned char padding[64];\n} KNNWorker;\n\nstatic char knn_winner(const size_t votes[KNN_LABELS]) {\n    size_t best_count = 0;\n    char best = (char)-1;\n    for (int value = CHAR_MIN; value <= CHAR_MAX; ++value) {\n        size_t count = votes[(unsigned char)(char)value];\n        if (count > best_count) {\n            best_count = count;\n            best = (char)value;\n        }\n    }\n    return best;\n}\n\nstatic int knn_before(const KNNNeighbor *a, const KNNNeighbor *b) {\n    if (a->key != b->key) return a->key < b->key;\n    return a->order < b->order;\n}\n\nstatic int knn_compare_neighbor(const void *a, const void *b) {\n    const KNNNeighbor *left = (const KNNNeighbor *)a;\n    const KNNNeighbor *right = (const KNNNeighbor *)b;\n    if (knn_before(left, right)) return -1;\n    if (knn_before(right, left)) return 1;\n    return 0;\n}\n\nstatic void knn_swap(KNNNeighbor *a, KNNNeighbor *b) {\n    KNNNeighbor temporary = *a;\n    *a = *b;\n    *b = temporary;\n}\n\n/* Partition the exact prefix, with a bounded sorting fallback. */\nstatic void knn_select_prefix(KNNNeighbor *neighbors, size_t length,\n                              size_t count) {\n    if (count == 0 || count >= length) return;\n\n    unsigned int budget = 0;\n    for (size_t remaining = length; remaining > 1; remaining >>= 1) {\n        budget += 2;\n    }\n\n    size_t begin = 0;\n    size_t end = length;\n    while (end - begin > 24) {\n        if (budget == 0) {\n            qsort(neighbors + begin, end - begin, sizeof(*neighbors),\n                  knn_compare_neighbor);\n            return;\n        }\n        --budget;\n\n        KNNNeighbor first = neighbors[begin];\n        KNNNeighbor middle = neighbors[begin + (end - begin) / 2];\n        KNNNeighbor last = neighbors[end - 1];\n        if (knn_before(&middle, &first)) knn_swap(&middle, &first);\n        if (knn_before(&last, &middle)) knn_swap(&last, &middle);\n        if (knn_before(&middle, &first)) knn_swap(&middle, &first);\n        const KNNNeighbor pivot = middle;\n\n        size_t lower = begin;\n        size_t scan = begin;\n        size_t upper = end;\n        while (scan < upper) {\n            if (knn_before(neighbors + scan, &pivot)) {\n                knn_swap(neighbors + lower, neighbors + scan);\n                ++lower;\n                ++scan;\n            } else if (knn_before(&pivot, neighbors + scan)) {\n                --upper;\n                knn_swap(neighbors + scan, neighbors + upper);\n            } else {\n                ++scan;\n            }\n        }\n\n        if (count < lower) {\n            end = lower;\n        } else if (count > upper) {\n            begin = upper;\n        } else {\n            return;\n        }\n    }\n    qsort(neighbors + begin, end - begin, sizeof(*neighbors),\n          knn_compare_neighbor);\n}\n\nstatic size_t knn_group_at(const size_t *offsets, size_t count,\n                           size_t position) {\n    size_t lower = 0;\n    size_t upper = count;\n    while (lower < upper) {\n        size_t middle = lower + (upper - lower) / 2;\n        if (offsets[middle + 1] <= position) {\n            lower = middle + 1;\n        } else {\n            upper = middle;\n        }\n    }\n    return lower;\n}\n\nstatic char knn_histogram(int n_groups, Group *groups, int k,\n                          Point to_evaluate) {\n    if (n_groups <= 0) return (char)-1;\n    if ((size_t)n_groups >= SIZE_MAX / sizeof(size_t))\n        return knn_serial(n_groups, groups, k, to_evaluate);\n\n    size_t *offsets = (size_t *)malloc(\n        ((size_t)n_groups + 1) * sizeof(*offsets));\n    if (offsets == NULL)\n        return knn_serial(n_groups, groups, k, to_evaluate);\n\n    offsets[0] = 0;\n    for (int i = 0; i < n_groups; ++i) {\n        size_t length = groups[i].length > 0 ? (size_t)groups[i].length : 0;\n        if (length > SIZE_MAX - offsets[i]) {\n            free(offsets);\n            return knn_serial(n_groups, groups, k, to_evaluate);\n        }\n        offsets[i + 1] = offsets[i] + length;\n    }\n    const size_t total = offsets[n_groups];\n    if (total == 0) {\n        free(offsets);\n        return (char)-1;\n    }\n    if (total > SIZE_MAX / sizeof(uint32_t)) {\n        free(offsets);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    int threads = 1;\n#ifdef _OPENMP\n    int limit = omp_get_max_threads();\n    size_t useful = total / 4096u;\n    if (useful == 0) useful = 1;\n    if (limit > 1)\n        threads = useful < (size_t)limit ? (int)useful : limit;\n#endif\n    if ((size_t)threads > SIZE_MAX / sizeof(KNNWorker)) {\n        free(offsets);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    uint32_t *keys = (uint32_t *)malloc(total * sizeof(*keys));\n    KNNWorker *workers = (KNNWorker *)malloc(\n        (size_t)threads * sizeof(*workers));\n    if (keys == NULL || workers == NULL) {\n        free(workers);\n        free(keys);\n        free(offsets);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    const size_t selected = total < (size_t)k ? total : (size_t)k;\n    KNNNeighbor *bucket = NULL;\n    size_t bucket_count = 0;\n    size_t needed = 0;\n    unsigned int cutoff_bin = 0;\n    int failed = 0;\n    char result = (char)-1;\n\n#ifdef _OPENMP\n#pragma omp parallel num_threads(threads) if(threads > 1)\n#endif\n    {\n        int thread = 0;\n        int team = 1;\n#ifdef _OPENMP\n        thread = omp_get_thread_num();\n        team = omp_get_num_threads();\n#endif\n        KNNWorker *local = workers + thread;\n        memset(local, 0, sizeof(*local));\n\n        size_t base = total / (size_t)team;\n        size_t extra = total % (size_t)team;\n        size_t before = (size_t)thread < extra ? (size_t)thread : extra;\n        size_t begin = base * (size_t)thread + before;\n        size_t end = begin + base + ((size_t)thread < extra);\n        size_t first_group = knn_group_at(offsets, (size_t)n_groups, begin);\n\n        for (size_t g = first_group;\n             g < (size_t)n_groups && offsets[g] < end; ++g) {\n            size_t first = offsets[g] < begin ? begin : offsets[g];\n            size_t last = offsets[g + 1] < end ? offsets[g + 1] : end;\n            for (size_t p = first; p < last; ++p) {\n                float d = euclidean_distance_no_sqrt(\n                    to_evaluate, groups[g].points[p - offsets[g]]);\n                uint32_t key;\n                memcpy(&key, &d, sizeof(key));\n                if (d != d) {\n                    local->saw_nan = 1;\n                    key = 0;\n                } else if (d == 0.0f) {\n                    key = 0;\n                }\n                keys[p] = key;\n                ++local->histogram[key >> KNN_BIN_SHIFT];\n            }\n        }\n\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n        {\n            for (int t = 0; t < team; ++t) {\n                if (workers[t].saw_nan) failed = 1;\n            }\n            if (!failed) {\n                size_t rank = selected;\n                for (unsigned int b = 0; b < KNN_BINS; ++b) {\n                    size_t count = 0;\n                    for (int t = 0; t < team; ++t)\n                        count += workers[t].histogram[b];\n                    if (rank > count) {\n                        rank -= count;\n                    } else {\n                        cutoff_bin = b;\n                        bucket_count = count;\n                        needed = rank;\n                        break;\n                    }\n                }\n\n                if (bucket_count > SIZE_MAX / sizeof(*bucket)) {\n                    failed = 1;\n                } else {\n                    bucket = (KNNNeighbor *)malloc(\n                        bucket_count * sizeof(*bucket));\n                    if (bucket == NULL) failed = 1;\n                }\n                if (!failed) {\n                    size_t next = 0;\n                    for (int t = 0; t < team; ++t) {\n                        workers[t].bucket_offset = next;\n                        next += workers[t].histogram[cutoff_bin];\n                    }\n                }\n            }\n        }\n\n        if (!failed) {\n            size_t destination = local->bucket_offset;\n            for (size_t g = first_group;\n                 g < (size_t)n_groups && offsets[g] < end; ++g) {\n                size_t first = offsets[g] < begin ? begin : offsets[g];\n                size_t last = offsets[g + 1] < end ? offsets[g + 1] : end;\n                unsigned char label = (unsigned char)groups[g].label;\n                for (size_t p = first; p < last; ++p) {\n                    uint32_t key = keys[p];\n                    unsigned int bin = key >> KNN_BIN_SHIFT;\n                    if (bin < cutoff_bin) {\n                        ++local->votes[label];\n                    } else if (bin == cutoff_bin) {\n                        bucket[destination].order = p;\n                        bucket[destination].key = key;\n                        bucket[destination].label = label;\n                        ++destination;\n                    }\n                }\n            }\n\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n            {\n                knn_select_prefix(bucket, bucket_count, needed);\n            }\n\n            size_t vote_base = needed / (size_t)team;\n            size_t vote_extra = needed % (size_t)team;\n            size_t vote_before = (size_t)thread < vote_extra\n                ? (size_t)thread : vote_extra;\n            size_t vote_begin = vote_base * (size_t)thread + vote_before;\n            size_t vote_end = vote_begin + vote_base +\n                              ((size_t)thread < vote_extra);\n            for (size_t p = vote_begin; p < vote_end; ++p)\n                ++local->votes[bucket[p].label];\n\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n            {\n                size_t votes[KNN_LABELS] = {0};\n                for (int t = 0; t < team; ++t) {\n                    for (unsigned int c = 0; c < KNN_LABELS; ++c)\n                        votes[c] += workers[t].votes[c];\n                }\n                votes[(unsigned char)((char)-1)] += (size_t)k - selected;\n                result = knn_winner(votes);\n            }\n        }\n    }\n\n    free(bucket);\n    free(workers);\n    free(keys);\n    free(offsets);\n    if (failed) return knn_serial(n_groups, groups, k, to_evaluate);\n    return result;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) return (char)-1;\n    if (k <= 64 || sizeof(float) != sizeof(uint32_t) ||\n        FLT_RADIX != 2 || FLT_MANT_DIG != 24 || FLT_MAX_EXP != 128 ||\n        CHAR_BIT != 8)\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    return knn_histogram(n_groups, groups, k, to_evaluate);\n}\n\nint main(void) {\n    int n_groups = parse_number_of_groups();\n    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);\n    for (int i = 0; i < n_groups; ++i) {\n        groups[i] = parse_next_group();\n    }\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n    return 0;\n}\n",
        "path": "src/knn.c"
      }

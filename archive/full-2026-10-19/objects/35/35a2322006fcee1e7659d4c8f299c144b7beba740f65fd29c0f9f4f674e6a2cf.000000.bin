      "content": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <iterator>\n#include <string>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nclass PrintPermutation\n{\n    static const std::size_t capacity = 65536;\n    char buffer_[capacity];\n    std::size_t used_;\n\n    static void interleave(const char* source, std::size_t count, char* destination)\n    {\n        const unsigned char* input = reinterpret_cast<const unsigned char*>(source);\n        unsigned char* output = reinterpret_cast<unsigned char*>(destination);\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n        uint8x16x2_t pairs16;\n        pairs16.val[1] = vdupq_n_u8(' ');\n        while (count >= 16) {\n            pairs16.val[0] = vld1q_u8(input);\n            vst2q_u8(output, pairs16);\n            input += 16;\n            output += 32;\n            count -= 16;\n        }\n        if (count >= 8) {\n            uint8x8x2_t pairs8;\n            pairs8.val[0] = vld1_u8(input);\n            pairs8.val[1] = vdup_n_u8(' ');\n            vst2_u8(output, pairs8);\n            input += 8;\n            output += 16;\n            count -= 8;\n        }\n#endif\n\n        for (std::size_t i = 0; i < count; ++i) {\n            output[2 * i] = input[i];\n            output[2 * i + 1] = ' ';\n        }\n    }\n\n    void append_pair(char first, char second)\n    {\n        if (capacity - used_ < 2) flush();\n        buffer_[used_++] = first;\n        buffer_[used_++] = second;\n    }\n\npublic:\n    PrintPermutation() : used_(0) {}\n\n    void flush()\n    {\n        if (used_ != 0) {\n            std::cout.write(buffer_, static_cast<std::streamsize>(used_));\n            used_ = 0;\n        }\n    }\n\n    void operator()(const std::string& text)\n    {\n        append_pair('[', ' ');\n        const char* source = text.data();\n        std::size_t remaining = text.size();\n        while (remaining != 0) {\n            std::size_t available = (capacity - used_) / 2;\n            if (available == 0) {\n                flush();\n                available = capacity / 2;\n            }\n            const std::size_t count = std::min(remaining, available);\n            interleave(source, count, buffer_ + used_);\n            used_ += 2 * count;\n            source += count;\n            remaining -= count;\n        }\n        append_pair(']', '\\n');\n    }\n};\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ' )\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v') ;\n    }\n} ;\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase\n        ( std::remove_if\n            ( text.begin ()\n            , text.end ()\n            , IsWhitespace () )\n        , text.end () ) ;\n    return text ;\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator <char> begin (in), end ;\n    std::string text (begin, end) ;\n    text = remove_whitespaces (text) ;\n    return text ;\n}\n\nint main (int argc, char const *argv [])\n{\n    std::string text = read_text_from_stdin <std::string> (std::cin) ;\n    if (text.empty()) return 0;\n\n    std::sort(text.begin(), text.end());\n    PrintPermutation print;\n    do {\n        print(text);\n    } while (std::next_permutation(text.begin(), text.end()));\n    print.flush();\n    return 0;\n}\n",
      "path": "src/permutations.cc"
    }
  ],
  "hypothesis": "ARM64 NEON can accelerate independent character/space interleaving into buffered output while permutation transitions remain strictly sequential.",
  "notes": "Unmeasured. Preserves native char ordering, duplicate handling, exact whitespace filtering and output bytes. Empty input emits nothing. Bounded chunking supports records larger than the buffer without computing an overflowing record length.",

{
  "name": "forest-r4b-Q110-facades-r4",
  "command": "bash -lc 'set -euo pipefail\n[[ ${SLURM_JOB_ID:-} =~ ^[0-9]+$ ]]\ntest \"$(uname -m)\" = aarch64\ntest \"${SLURM_CPUS_PER_TASK:-}\" = 4\ntest \"${SLURM_NTASKS:-}\" = 1\ntest \"${SLURM_JOB_NUM_NODES:-}\" = 1\ntest \"${SLURM_MEM_PER_NODE:-}\" = 16384\ntest -z \"${SLURM_JOB_GPUS:-}${SLURM_STEP_GPUS:-}\"\ntest \"${SLURM_GPUS:-0}\" = 0\ntest \"${SLURM_GPUS_ON_NODE:-0}\" = 0\ntest \"$(( $(date -u +%s) + 600 + 10800 ))\" -lt 1793487600\npy=/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python\npacket=/scratch_p/nimarano/hpc-forest-r4b-source110-completeQ-20261018-17fa505a5f8b.tar.gz\nroot=/scratch_p/nimarano/hpc-forest-r4b-source110-completeQ-20261018-17fa505a5f8b\ntest -x \"$py\"\ntest ! -e \"$root\"\nprintf '\"'\"'%s  %s\\n'\"'\"' 03251fe482275b7ac4179be5a826ae6c556015574724780c269b64d15a94d075 \"$packet\" | sha256sum -c -\nexport PYTHONDONTWRITEBYTECODE=1 PYTHONUTF8=1 CUDA_VISIBLE_DEVICES=\nsrun --ntasks=1 --cpus-per-task=4 --cpu-bind=cores \"$py\" -I -B -u - \"$packet\" \"$root\" 03251fe482275b7ac4179be5a826ae6c556015574724780c269b64d15a94d075 <<'\"'\"'R4B_Q110_BOOTSTRAP'\"'\"'\n\"\"\"Inline bootstrap for one allocated srun; no scientific work before guard.\"\"\"\nimport hashlib\nimport io\nimport json\nimport os\nimport platform\nimport re\nimport runpy\nimport sys\nimport tarfile\nimport time\nfrom pathlib import Path\n\n\ndef need(ok, reason):\n    if not ok:\n        raise ValueError(reason)\n\n\ndef main():\n    need(time.time() + 600 + 10800 < 1793487600, \"Deadline plus audit reserve exceeded\")\n    need(platform.machine().lower() == \"aarch64\", \"ARM64 allocation required\")\n    need(all(os.environ.get(k) == v for k, v in {\n        \"SLURM_CPUS_PER_TASK\": \"4\", \"SLURM_NTASKS\": \"1\", \"SLURM_JOB_NUM_NODES\": \"1\",\n        \"SLURM_MEM_PER_NODE\": \"16384\"}.items()), \"Exact 4CPU/1task/1node/16GiB allocation required\")\n    need(re.fullmatch(r\"[0-9]+\", os.environ.get(\"SLURM_JOB_ID\", \"\")) is not None, \"Actual Slurm job required\")\n    need(not os.environ.get(\"SLURM_JOB_GPUS\", \"\") and not os.environ.get(\"SLURM_STEP_GPUS\", \"\")\n         and os.environ.get(\"SLURM_GPUS\", \"0\") == \"0\"\n         and os.environ.get(\"SLURM_GPUS_ON_NODE\", \"0\") == \"0\", \"Zero GPU required\")\n    affinity = sorted(os.sched_getaffinity(0))\n    need(len(affinity) == 4, \"Unique srun must bind exactly four CPUs\")\n    packet, root = map(Path, sys.argv[1:3])\n    expected_packet_sha = sys.argv[3]\n    need(root.is_absolute() and not root.exists() and not root.is_symlink(), \"Fresh absolute dedicated root required\")\n    packet_bytes = packet.read_bytes()\n    need(len(packet_bytes) <= 64 * 1024 * 1024\n         and hashlib.sha256(packet_bytes).hexdigest() == expected_packet_sha,\n         \"Exact bounded packet bytes required\")\n    expected = {\"qualification-wrapper.py\", \"bindings.json\", \"source-bundle.tar.gz\",\n                \"adapter-bundle.tar.gz\", \"packet-manifest.json\"}\n    with tarfile.open(fileobj=io.BytesIO(packet_bytes), mode=\"r:gz\") as archive:\n        members = archive.getmembers()\n        need(len(members) == len(expected) and {m.name for m in members} == expected\n             and all(m.isfile() and not m.issym() and not m.islnk() for m in members)\n             and sum(m.size for m in members) <= 128 * 1024 * 1024,\n             \"Exact five regular packet files required\")\n        root.mkdir(parents=False, exist_ok=False)\n        for member in members:\n            with (root / member.name).open(\"xb\") as stream:\n                stream.write(archive.extractfile(member).read())\n    actual = {name: hashlib.sha256((root / name).read_bytes()).hexdigest()\n              for name in expected - {\"packet-manifest.json\"}}\n    need(actual == json.loads((root / \"packet-manifest.json\").read_text(encoding=\"utf-8\")),\n         \"Exact packet manifest required before wrapper execution\")\n    with (root / \"bootstrap-allocation.json\").open(\"x\", encoding=\"utf-8\") as stream:\n        json.dump({\"observed_at\": time.time(), \"architecture\": \"ARM64\", \"cpu_cores\": 4,\n                   \"tasks\": 1, \"nodes\": 1, \"allocated_memory_mib\": 16384, \"allocated_gpus\": 0,\n                   \"slurm_job_id\": os.environ[\"SLURM_JOB_ID\"], \"affinity_cpu_ids\": affinity,\n                   \"guard_before_any_extraction\": True, \"native_model_calls\": 0}, stream)\n    sys.argv = [str(root / \"qualification-wrapper.py\"), \"--root\", str(root)]\n    runpy.run_path(str(root / \"qualification-wrapper.py\"), run_name=\"__main__\")\n\n\nif __name__ == \"__main__\":\n    main()\n\nR4B_Q110_BOOTSTRAP\n'",
  "arch": "armgpu",
  "cpus_per_task": 4,
  "mem_gb": 16,
  "gpus_per_node": 0,
  "time_limit": "00:10:00",
  "workdir": "/scratch_p/nimarano",
  "spack_packages": [],
  "data_files": []
}

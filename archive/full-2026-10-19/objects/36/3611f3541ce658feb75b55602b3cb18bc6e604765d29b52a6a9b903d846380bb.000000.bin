        "content": "#include <iostream>\n#include <vector>\n#include <cstdint>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nusing namespace std;\n\nconst uint32_t MOD = 1000000007u;\n\nstatic inline void advance_diagonal(\n    const uint32_t* __restrict__ previous,\n    uint32_t* __restrict__ current,\n    int first, int end) {\n    int j = first;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const uint32x4_t modulus = vdupq_n_u32(MOD);\n    for (; j + 4 <= end; j += 4) {\n        const uint32x4_t above = vld1q_u32(previous + j);\n        const uint32x4_t left = vld1q_u32(previous + j - 1);\n        const uint32x4_t sum = vaddq_u32(above, left);\n        // sum < 2*MOD. Unsigned subtraction wraps above sum\n        // exactly when sum < MOD, so unsigned minimum reduces it.\n        const uint32x4_t reduced =\n            vminq_u32(sum, vsubq_u32(sum, modulus));\n        vst1q_u32(current + j, reduced);\n    }\n#endif\n    for (; j < end; ++j) {\n        const uint32_t sum = previous[j] + previous[j - 1];\n        current[j] = sum >= MOD ? sum - MOD : sum;\n    }\n}\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n\n    const int diagonal_count = 2 * n - 1;\n    vector<vector<int> > blocked_by_diagonal(diagonal_count);\n    for (int c = 0; c < m; ++c) {\n        int y, x;\n        cin >> y >> x;\n        blocked_by_diagonal[y + x].push_back(x + 1);\n    }\n\n    // Index x+1 leaves index zero as a permanent zero boundary.\n    // Entries beyond the expanding diagonal also remain initially zero.\n    vector<uint32_t> previous(n + 1, 0);\n    vector<uint32_t> current(n + 1, 0);\n    previous[1] = 1;\n    for (int index : blocked_by_diagonal[0]) {\n        previous[index] = 0;\n    }\n\n    for (int diagonal = 1; diagonal < diagonal_count; ++diagonal) {\n        const int first = diagonal < n ? 1 : diagonal - n + 2;\n        const int end = diagonal < n ? diagonal + 2 : n + 1;\n\n        // Both predecessors lie on the previous diagonal, so every\n        // destination in this loop is independent of the others.\n        advance_diagonal(previous.data(), current.data(), first, end);\n\n        // No cell on this diagonal consumes another cell on it.\n        // Clear obstacles before exposing the diagonal to its successors.\n        for (int index : blocked_by_diagonal[diagonal]) {\n            current[index] = 0;\n        }\n        previous.swap(current);\n    }\n\n    cout << previous[n] << endl;\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }

    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\n#include <string.h>\n#include <float.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n",
      "path": "src/knn.h"
    },
    {
      "content": "#include \"knn.h\"\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    // Flatten all points into contiguous arrays for sequential access.\n    int total_points = 0;\n    for (int i = 0; i < n_groups; i++) {\n        total_points += groups[i].length;\n    }\n\n    float *xs = (float *) malloc(total_points * sizeof(float));\n    float *ys = (float *) malloc(total_points * sizeof(float));\n    char *ls  = (char *)  malloc(total_points * sizeof(char));\n\n    int idx = 0;\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            xs[idx] = g.points[j].x;\n            ys[idx] = g.points[j].y;\n            ls[idx] = g.label;\n            idx++;\n        }\n    }\n\n    // Maintain a sorted list of the k smallest distances (ascending).\n    float *distances = (float *) malloc(k * sizeof(float));\n    char  *labels    = (char *)  malloc(k * sizeof(char));\n\n    for (int i = 0; i < k; i++) {\n        distances[i] = FLT_MAX;\n        labels[i] = 0;\n    }\n\n    // Process each point sequentially.\n    for (int p = 0; p < total_points; p++) {\n        float dx = to_evaluate.x - xs[p];\n        float dy = to_evaluate.y - ys[p];\n        float d = dx*dx + dy*dy;\n\n        // Only consider if strictly better than the current worst.\n        if (d < distances[k-1]) {\n            int left  = 0;\n            int right = k - 1;\n            while (left < right) {\n                int mid = (left + right) / 2;\n                if (distances[mid] <= d)\n                    left = mid + 1;\n                else\n                    right = mid;\n            }\n            // Insert at the first position where distances[pos] > d.\n            int insert_pos = left;\n            memmove(&distances[insert_pos+1], &distances[insert_pos],\n                    (k - insert_pos - 1) * sizeof(float));\n            memmove(&labels[insert_pos+1], &labels[insert_pos],\n                    (k - insert_pos - 1) * sizeof(char));\n            distances[insert_pos] = d;\n            labels[insert_pos]    = ls[p];\n        }\n    }\n\n    // Frequency histogram over the k nearest labels.\n    int freq[256] = {0};\n    for (int i = 0; i < k; i++) {\n        unsigned char c = (unsigned char)labels[i];\n        freq[c]++;\n    }\n\n    // Find most frequent label with tie-breaking: smallest character wins.\n    char best_label = 0;\n    int best_count  = 0;\n    for (int c = 0; c < 256; c++) {\n        if (freq[c] > best_count ||\n            (freq[c] == best_count && (char)c < best_label)) {\n            best_count  = freq[c];\n            best_label  = (char)c;\n        }\n    }\n\n    free(xs); free(ys); free(ls);\n    free(distances); free(labels);\n\n    return best_label;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Flatten all points into three contiguous arrays (xs, ys, labels) for fully sequential memory access during distance computation. Maintain the top-k list as a sorted array using binary search insertion with memmove block copies to reduce instruction overhead and improve cache locality. Replace qsort+scan with a frequency histogram over 256 possible character values to eliminate sorting entirely while preserving tie-breaking (smallest character wins). This combination maximizes memory locality, minimizes branch mispredictions, and reduces dynamic instructions.",
  "notes": "",

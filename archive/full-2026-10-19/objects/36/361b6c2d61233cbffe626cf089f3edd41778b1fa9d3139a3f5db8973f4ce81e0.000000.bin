      "content": "#include <ctype.h>\n#include <errno.h>\n#include <limits.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\ntypedef struct {\n  int id;\n  float value;\n  size_t edge_begin;\n  size_t edge_count;\n} Node;\n\ntypedef struct {\n  int id;\n  int index;\n} IdIndex;\n\ntypedef struct {\n  char *text;\n  int id;\n} Query;\n\nstatic void fail(void) {\n  fputs(\"Error!\\n\", stderr);\n  exit(EXIT_FAILURE);\n}\n\nstatic size_t checked_size_mul(size_t left, size_t right) {\n  if (right != 0 && left > SIZE_MAX / right)\n    fail();\n  return left * right;\n}\n\nstatic void *checked_malloc(size_t size) {\n  void *result = malloc(size);\n  if (result == NULL && size != 0)\n    fail();\n  return result;\n}\n\nstatic void *checked_realloc(void *memory, size_t size) {\n  void *result = realloc(memory, size);\n  if (result == NULL && size != 0)\n    fail();\n  return result;\n}\n\nstatic char *read_line(FILE *stream) {\n  size_t capacity = 128;\n  size_t length = 0;\n  char *line = checked_malloc(capacity);\n  int ch;\n\n  while ((ch = fgetc(stream)) != EOF && ch != '\\n') {\n    if (length == capacity - 1) {\n      if (capacity > SIZE_MAX / 2)\n        fail();\n      capacity *= 2;\n      line = checked_realloc(line, capacity);\n    }\n    line[length++] = (char)ch;\n  }\n\n  if (ch == EOF && length == 0) {\n    free(line);\n    return NULL;\n  }\n  if (length > 0 && line[length - 1] == '\\r')\n    length--;\n  line[length] = '\\0';\n  return line;\n}\n\nstatic char *skip_space(char *text) {\n  while (*text != '\\0' && isspace((unsigned char)*text))\n    text++;\n  return text;\n}\n\nstatic int parse_int(char **cursor) {\n  char *start = skip_space(*cursor);\n  char *end = NULL;\n  errno = 0;\n  long value = strtol(start, &end, 10);\n  if (end == start || errno == ERANGE || value < INT_MIN || value > INT_MAX)\n    fail();\n  *cursor = end;\n  return (int)value;\n}\n\nstatic int parse_int_token(char *token) {\n  char *cursor = token;\n  int value = parse_int(&cursor);\n  if (*cursor != '\\0')\n    fail();\n  return value;\n}\n\nstatic float parse_float(char **cursor) {\n  char *start = skip_space(*cursor);\n  char *end = NULL;\n  float value = strtof(start, &end);\n  if (end == start)\n    fail();\n  *cursor = end;\n  return value;\n}\n\nstatic void append_int(int **values, size_t *count, size_t *capacity,\n                       int value) {\n  if (*count == *capacity) {\n    size_t new_capacity;\n    if (*capacity == 0) {\n      new_capacity = 16;\n    } else {\n      if (*capacity > SIZE_MAX / 2)\n        fail();\n      new_capacity = *capacity * 2;\n    }\n    *values = checked_realloc(\n        *values, checked_size_mul(new_capacity, sizeof(**values)));\n    *capacity = new_capacity;\n  }\n  if (*count == SIZE_MAX)\n    fail();\n  (*values)[(*count)++] = value;\n}\n\nstatic void append_query(Query **queries, size_t *count, size_t *capacity,\n                         char *text, int id) {\n  if (*count == *capacity) {\n    size_t new_capacity;\n    if (*capacity == 0) {\n      new_capacity = 16;\n    } else {\n      if (*capacity > SIZE_MAX / 2)\n        fail();\n      new_capacity = *capacity * 2;\n    }\n    *queries = checked_realloc(\n        *queries, checked_size_mul(new_capacity, sizeof(**queries)));\n    *capacity = new_capacity;\n  }\n  if (*count == SIZE_MAX)\n    fail();\n  (*queries)[*count].text = text;\n  (*queries)[*count].id = id;\n  (*count)++;\n}\n\nstatic int compare_id_index(const void *left, const void *right) {\n  const IdIndex *a = left;\n  const IdIndex *b = right;\n  if (a->id != b->id)\n    return a->id < b->id ? -1 : 1;\n  if (a->index != b->index)\n    return a->index < b->index ? -1 : 1;\n  return 0;\n}\n\nstatic int find_by_id(const IdIndex *ids, int count, int id) {\n  size_t low = 0;\n  size_t high = (size_t)count;\n\n  while (low < high) {\n    size_t middle = low + (high - low) / 2;\n    if (ids[middle].id < id)\n      low = middle + 1;\n    else\n      high = middle;\n  }\n  if (low < (size_t)count && ids[low].id == id)\n    return ids[low].index;\n  return -1;\n}\n\nstatic float cost_from_node(int id, int count, const Node *nodes,\n                            const IdIndex *ids, const int *next_node,\n                            float *costs, unsigned char *done, int *path) {\n  int start = find_by_id(ids, count, id);\n  if (start < 0)\n    return 0.0f;\n\n  size_t path_length = 0;\n  int current = start;\n  while (current >= 0 && !done[current]) {\n    if (path_length >= (size_t)count)\n      return 0.0f;\n    path[path_length++] = current;\n    current = next_node[current];\n  }\n\n  float total = current >= 0 ? costs[current] : 0.0f;\n  while (path_length > 0) {\n    int node = path[--path_length];\n    total = nodes[node].value + total;\n    costs[node] = total;\n    done[node] = 1;\n  }\n  return costs[start];\n}\n\nint main(void) {\n  char *header = read_line(stdin);\n  if (header == NULL)\n    fail();\n\n  char *cursor = header;\n  int count = parse_int(&cursor);\n  if (count < 0)\n    fail();\n\n  Query *queries = NULL;\n  size_t query_count = 0;\n  size_t query_capacity = 0;\n  char *query_cursor = skip_space(cursor);\n  while (*query_cursor != '\\0') {\n    char *token = query_cursor;\n    while (*query_cursor != '\\0' &&\n           !isspace((unsigned char)*query_cursor))\n      query_cursor++;\n    if (*query_cursor != '\\0')\n      *query_cursor++ = '\\0';\n    append_query(&queries, &query_count, &query_capacity, token,\n                 parse_int_token(token));\n    query_cursor = skip_space(query_cursor);\n  }\n\n  Node *nodes = NULL;\n  if (count > 0)\n    nodes = checked_malloc(checked_size_mul((size_t)count, sizeof(*nodes)));\n\n  int *edge_ids = NULL;\n  size_t edge_count = 0;\n  size_t edge_capacity = 0;\n  for (int i = 0; i < count; i++) {\n    char *line = read_line(stdin);\n    while (line != NULL && *skip_space(line) == '\\0') {\n      free(line);\n      line = read_line(stdin);\n    }\n    if (line == NULL)\n      fail();\n\n    cursor = skip_space(line);\n    nodes[i].id = parse_int(&cursor);\n    nodes[i].value = parse_float(&cursor);\n    nodes[i].edge_begin = edge_count;\n    for (;;) {\n      char *neighbor_cursor = skip_space(cursor);\n      if (*neighbor_cursor == '\\0')\n        break;\n      int neighbor_id = parse_int(&cursor);\n      append_int(&edge_ids, &edge_count, &edge_capacity, neighbor_id);\n    }\n    nodes[i].edge_count = edge_count - nodes[i].edge_begin;\n    free(line);\n  }\n\n  IdIndex *ids = NULL;\n  int *next_node = NULL;\n  float *costs = NULL;\n  unsigned char *done = NULL;\n  int *path = NULL;\n  if (count > 0) {\n    size_t node_bytes = checked_size_mul((size_t)count, sizeof(*ids));\n    ids = checked_malloc(node_bytes);\n    for (int i = 0; i < count; i++) {\n      ids[i].id = nodes[i].id;\n      ids[i].index = i;\n    }\n    qsort(ids, (size_t)count, sizeof(*ids), compare_id_index);\n\n    for (size_t i = 0; i < edge_count; i++)\n      edge_ids[i] = find_by_id(ids, count, edge_ids[i]);\n\n    next_node = checked_malloc(\n        checked_size_mul((size_t)count, sizeof(*next_node)));\n    costs = checked_malloc(checked_size_mul((size_t)count, sizeof(*costs)));\n    done = calloc((size_t)count, sizeof(*done));\n    if (done == NULL)\n      fail();\n    path = checked_malloc(checked_size_mul((size_t)count, sizeof(*path)));\n\n    for (int i = 0; i < count; i++) {\n      float max_value = 0.0f;\n      int best = -1;\n      size_t end = nodes[i].edge_begin + nodes[i].edge_count;\n      for (size_t edge = nodes[i].edge_begin; edge < end; edge++) {\n        int neighbor = edge_ids[edge];\n        if (neighbor >= 0 && max_value < nodes[neighbor].value) {\n          max_value = nodes[neighbor].value;\n          best = neighbor;\n        }\n      }\n      /* The original idmax sentinel prevents following a node whose ID is -1. */\n      next_node[i] = best >= 0 && nodes[best].id != -1 ? best : -1;\n    }\n  }\n\n  for (size_t i = 0; i < query_count; i++) {\n    float cost = count > 0\n                     ? cost_from_node(queries[i].id, count, nodes, ids,\n                                      next_node, costs, done, path)\n                     : 0.0f;\n    printf(\"%s: %f\\n\", queries[i].text, cost);\n  }\n\n  free(path);\n  free(done);\n  free(costs);\n  free(next_node);\n  free(ids);\n  free(edge_ids);\n  free(nodes);\n  free(queries);\n  free(header);\n  return 0;\n}\n",
      "path": "src/graph.c"
    }
  ],
  "hypothesis": "A flat adjacency array, stable first-match ID index, and iterative cached path sums should reduce repeated tokenization, ID scans, and recursive work. Keeping the computation serial lets repeated queries safely share cached sums; the controller should measure the complete program.",
  "notes": "Preserves query token spelling/order, strict positive first-maximum neighbor selection, and the original -1 successor sentinel behavior. The SIMD scan and query-level parallel variants are omitted because they are alternatives to this indexed/cache design and query parallelism would conflict with shared memoization.",
  "sources_kept": [

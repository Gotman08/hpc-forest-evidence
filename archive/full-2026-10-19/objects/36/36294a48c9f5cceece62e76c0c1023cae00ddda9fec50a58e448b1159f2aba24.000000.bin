#include <stdio.h>
#include <stdlib.h>

typedef struct {
    float x;
    float y;
} Point;

typedef struct {
    int n;
    float *xs;
    float *ys;
    char *labels;
} Dataset;

void on_error() {
    printf("Invalid input file.\n");
    exit(1);
}

Point parse_point() {
    float x, y;
    if (scanf(" (%f ,%f) ", &x, &y) != 2)  on_error();
    Point point;
    point.x = x;
    point.y = y;
    return point;
}

int parse_k() {
    int k;
    if (scanf(" k=%d ", &k) != 1) on_error();
    return k;
}

Dataset *parse_dataset() {
    int n_groups;
    if (scanf(" n_groups=%d ", &n_groups) != 1) on_error();

    long cap = 1024;
    float *xs = (float *)malloc(sizeof(float) * cap);
    float *ys = (float *)malloc(sizeof(float) * cap);
    char *labels = (char *)malloc(sizeof(char) * cap);
    if (!xs || !ys || !labels) on_error();

    long n = 0;
    for (int g = 0; g < n_groups; g++) {
        char label;
        int length;
        if (scanf(" label=%c ", &label) != 1) on_error();
        if (scanf(" length=%d ", &length) != 1) on_error();

        for (int i = 0; i < length; i++) {
            float x, y;
            if (scanf(" (%f ,%f) ", &x, &y) != 2) on_error();
            if (n == cap) {
                cap *= 2;
                xs = (float *)realloc(xs, sizeof(float) * cap);
                ys = (float *)realloc(ys, sizeof(float) * cap);
                labels = (char *)realloc(labels, sizeof(char) * cap);
                if (!xs || !ys || !labels) on_error();
            }
            xs[n] = x;
            ys[n] = y;
            labels[n] = label;
            n++;
        }
    }

    Dataset *ds = (Dataset *)malloc(sizeof(Dataset));
    if (!ds) on_error();
    ds->n = (int)n;
    ds->xs = xs;
    ds->ys = ys;
    ds->labels = labels;
    return ds;
}

      "content": "#include \"knn.h\"\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    // Flatten all points into contiguous arrays for sequential access\n    int total_points = 0;\n    for (int i = 0; i < n_groups; i++) {\n        total_points += groups[i].length;\n    }\n\n    float *xs = (float *) malloc(total_points * sizeof(float));\n    float *ys = (float *) malloc(total_points * sizeof(float));\n    char *point_labels = (char *) malloc(total_points * sizeof(char));\n\n    int idx = 0;\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            xs[idx] = g.points[j].x;\n            ys[idx] = g.points[j].y;\n            point_labels[idx] = g.label;\n            idx++;\n        }\n    }\n\n    // Packed top-k array for better spatial locality during shifts\n    typedef struct {\n        float dist;\n        char label;\n    } DistLabel;\n\n    DistLabel *top_k = (DistLabel *) malloc(k * sizeof(DistLabel));\n    for (int i = 0; i < k; i++) {\n        top_k[i].dist = -1.0f;\n        top_k[i].label = -1;\n    }\n\n    // Distance computation with sequential memory access\n    float px = to_evaluate.x;\n    float py = to_evaluate.y;\n    for (int i = 0; i < total_points; i++) {\n        float dx = xs[i] - px;\n        float dy = ys[i] - py;\n        float d = dx * dx + dy * dy;\n\n        // Insertion into sorted top-k list with packed struct shifts\n        for (int x = 0; x < k; x++) {\n            if (d < top_k[x].dist || top_k[x].dist == -1.0f) {\n                int shift_count = k - x - 1;\n                if (shift_count > 0) {\n                    memmove(&top_k[x + 1], &top_k[x], shift_count * sizeof(DistLabel));\n                }\n                top_k[x].dist = d;\n                top_k[x].label = point_labels[i];\n                break;\n            }\n        }\n    }\n\n    // Frequency histogram over printable ASCII (0-255) to find mode\n    int freq[256] = {0};\n    for (int i = 0; i < k; i++) {\n        unsigned char uc = (unsigned char) top_k[i].label;\n        if (uc != 255) { // skip sentinel -1 which becomes 255\n            freq[uc]++;\n        }\n    }\n\n    char most_frequent = 0;\n    int best_count = 0;\n    for (int c = 32; c < 127; c++) { // printable ASCII range\n        if (freq[c] > best_count) {\n            best_count = freq[c];\n            most_frequent = (char)c;\n        }\n    }\n\n    free(xs);\n    free(ys);\n    free(point_labels);\n    free(top_k);\n\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    },
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n",
      "path": "src/knn.h"
    }
  ],
  "hypothesis": "Flatten all points into contiguous arrays for sequential memory access during distance computation and pack top-k entries into a struct to improve spatial locality during insertion shifts; replace qsort-based mode detection with frequency histogram to eliminate sorting overhead.",
  "notes": "The flattening ensures that the main distance loop reads xs, ys, point_labels sequentially (stride-1), maximizing cache line utilization. Packing dist and label in one struct reduces memory traffic when shifting entries during insertion. The histogram approach avoids an O(k log k) sort and a second pass over labels.",

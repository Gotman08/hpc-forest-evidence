      "content": "/*\n    Solve Laplace's equation using synchronous Jacobi iteration.\n    Adjacent iterations are pipelined by rows to reuse intermediate values.\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n#include <time.h>\n#include <sys/time.h>\n\n#define CONV_THRESHOLD 1.0e-5f\n\n// matrix to be solved\ndouble **grid;\n\n// auxiliary matrix\ndouble **new_grid;\n\nstatic double *grid_storage;\nstatic double *new_grid_storage;\n\n// size of each side of the grid\nint size;\nint iter_max_num;\n\n// return the absolute value of a number\ndouble absolute(double num){\n    if(num < 0)\n        return -1.0 * num;\n    return num;\n}\n\n// allocate contiguous storage while retaining row-pointer indexing\nvoid allocate_memory(){\n    const size_t n = size > 0 ? (size_t)size : 0;\n    if(n != 0 && n > (SIZE_MAX / sizeof(double)) / n)\n        exit(EXIT_FAILURE);\n\n    grid = (double **) malloc(n * sizeof(double *));\n    new_grid = (double **) malloc(n * sizeof(double *));\n    grid_storage = (double *) malloc(n * n * sizeof(double));\n    new_grid_storage = (double *) malloc(n * n * sizeof(double));\n\n    if(n != 0 && (!grid || !new_grid || !grid_storage || !new_grid_storage)){\n        free(grid);\n        free(new_grid);\n        free(grid_storage);\n        free(new_grid_storage);\n        exit(EXIT_FAILURE);\n    }\n\n    for(int i = 0; i < size; i++){\n        grid[i] = grid_storage + (size_t)i * n;\n        new_grid[i] = new_grid_storage + (size_t)i * n;\n    }\n}\n\n// initialize both grids with identical fixed boundaries\nvoid initialize_grid(){\n    int center = size / 2;\n    int linf = center - (size / 10);\n    int lsup = center + (size / 10);\n    for(int i = 0; i < size; i++){\n        for(int j = 0; j < size; j++){\n            if(i >= linf && i <= lsup && j >= linf && j <= lsup)\n                grid[i][j] = 100;\n            else\n                grid[i][j] = 0;\n            new_grid[i][j] = grid[i][j];\n        }\n    }\n}\n\n// save the grid in a file\nvoid save_grid(){\n    for(int i = 0; i < size; i++){\n        for(int j = 0; j < size; j++){\n            fprintf(stdout, \"%lf \", grid[i][j]);\n        }\n        fprintf(stdout, \"\\n\");\n    }\n}\n\nstatic inline int jacobi_row(const double *restrict current,\n                             const double *restrict north,\n                             const double *restrict south,\n                             double *restrict next,\n                             int n){\n    int changed = 0;\n    for(int j = 1; j < n - 1; j++){\n        double value = 0.25 * (current[j+1] + current[j-1] +\n                              north[j] + south[j]);\n        next[j] = value;\n        double errorCurrent = absolute(value - current[j]);\n        changed |= (errorCurrent > CONV_THRESHOLD);\n    }\n    return changed;\n}\n\nint main(int argc, char *argv[]){\n    fscanf(stdin, \"%d\", &size);\n    fscanf(stdin, \"%d\", &iter_max_num);\n\n    int hasError = 1;\n    int iter = 0;\n\n    struct timeval time_start;\n    struct timeval time_end;\n\n    // allocate memory to the grid (matrix)\n    allocate_memory();\n\n    // set grid initial conditions\n    initialize_grid();\n\n    //printf(\"Jacobi relaxation calculation: %d x %d grid\\n\", size, size);\n\n    // get the start time\n    //gettimeofday(&time_start, NULL);\n\n    while(hasError && iter < iter_max_num){\n        if(iter_max_num - iter == 1){\n            // A single remaining iteration uses ordinary buffer swapping.\n            hasError = 0;\n            for(int i = 1; i < size - 1; i++){\n                hasError |= jacobi_row(grid[i], grid[i-1], grid[i+1],\n                                       new_grid[i], size);\n            }\n            double **tmp = grid;\n            grid = new_grid;\n            new_grid = tmp;\n            iter++;\n        } else {\n            int firstError = 0;\n            int secondError = 0;\n\n            if(size > 2){\n                firstError |= jacobi_row(grid[1], grid[0], grid[2],\n                                         new_grid[1], size);\n\n                for(int i = 1; i < size - 2; i++){\n                    // This is the last first-step row to read old grid[i].\n                    firstError |= jacobi_row(grid[i+1], grid[i], grid[i+2],\n                                             new_grid[i+1], size);\n\n                    // All three intermediate rows are now available.\n                    secondError |= jacobi_row(new_grid[i], new_grid[i-1],\n                                              new_grid[i+1], grid[i], size);\n                }\n\n                // The final intermediate neighbor is the fixed boundary.\n                int i = size - 2;\n                secondError |= jacobi_row(new_grid[i], new_grid[i-1],\n                                          new_grid[i+1], grid[i], size);\n            }\n\n            if(!firstError){\n                // Discard the speculative second step if the first converged.\n                double **tmp = grid;\n                grid = new_grid;\n                new_grid = tmp;\n                hasError = 0;\n                iter++;\n            } else {\n                hasError = secondError;\n                iter += 2;\n            }\n        }\n    }\n\n    // get the end time\n    //gettimeofday(&time_end, NULL);\n\n    //double exec_time = (double) (time_end.tv_sec - time_start.tv_sec) +\n    //                   (double) (time_end.tv_usec - time_start.tv_usec) / 1000000.0;\n\n    //save the final grid in file\n    save_grid();\n\n    //printf(\"\\nKernel executed in %lf seconds with %d iterations.\\n\", exec_time, iter);\n\n    free(grid_storage);\n    free(new_grid_storage);\n    free(grid);\n    free(new_grid);\n    return 0;\n}\n",
      "path": "src/laplace_seq.c"
    }
  ],
  "hypothesis": "Pipelining two Jacobi iterations by rows over contiguous grids should eliminate copy-back passes and reuse intermediate rows while cache-resident, reducing memory traffic.",

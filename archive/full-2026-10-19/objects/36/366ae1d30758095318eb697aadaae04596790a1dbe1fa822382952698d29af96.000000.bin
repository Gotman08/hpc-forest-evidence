    {
      "id": "b557d16c4ffa4daa",
      "role": "B",
      "mission": {
        "base_commit": "e034ad2117420a240ceac7414bd9ef13ea6a7a05",
        "delegation_parent": "R/B",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "A stable byte-wise radix index sort removes the quadratic, skew-sensitive insertion loops; cache-aligned private histograms and disjoint stable scatters should scale its large passes on four ARM64 cores while preserving strcmp order.",
        "id": "b557d16c4ffa4daa",
        "ordinal": 1,
        "parent_id": null,
        "role": "B",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/bucketsort.c"
          ],
          "retained": [
            "Replace fixed-capacity per-bucket insertion sorting with a stable LSD byte-radix sort over record indices.",
            "For large arrays, use OpenMP private cache-aligned histograms, a global per-thread prefix layout, and nonoverlapping stable scatter ranges; retain a serial radix fallback.",
            "Apply SIMD only to independent index initialization and leave histogram increments and scatter cursors scalar because they carry per-bin dependencies."
          ]
        },
        "tree_id": "e1:B",
        "trial_id": "01M5335W66RJCW80RSVSSNZD3F",

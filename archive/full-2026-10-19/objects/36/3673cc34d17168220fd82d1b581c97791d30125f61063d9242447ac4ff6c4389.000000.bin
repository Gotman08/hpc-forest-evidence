{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include <iostream>\\n#include <vector>\\n#include <cstdio>\\n#include <cassert>\\n#include <cstddef>\\n\\nstatic long long best_window(const std::vector<long long>& columns, int width) {\\n    long long sum = 0;\\n    for (int col = 0; col < width; ++col)\\n        sum += columns[col];\\n\\n    long long best = sum;\\n    for (std::size_t col = static_cast<std::size_t>(width); col < columns.size(); ++col) {\\n        sum += columns[col] - columns[col - width];\\n        if (sum > best)\\n            best = sum;\\n    }\\n    return best;\\n}\\n\\nint main() {\\n    int n, s;\\n    std::cin >> n >> s;\\n    const std::size_t stride = static_cast<std::size_t>(n);\\n    std::vector<int> matrix(stride * stride);\\n    for (int i = 0; i < n; ++i)\\n        for (int j = 0; j < n; ++j)\\n            scanf(\\\"%d\\\", &matrix[static_cast<std::size_t>(i) * stride + j]);\\n\\n    assert(s < n);\\n    assert(n < 8000);\\n    assert(s > 0);\\n    assert(n > 0);\\n\\n    // Column totals for the current s-row strip.\\n    std::vector<long long> columns(n, 0);\\n    for (int i = 0; i < s; ++i) {\\n        const int* row = matrix.data() + static_cast<std::size_t>(i) * stride;\\n        for (int j = 0; j < n; ++j)\\n            columns[j] += row[j];\\n    }\\n\\n    long long mxSum = best_window(columns, s);\\n    for (int bottom = s; bottom < n; ++bottom) {\\n        const int* entering = matrix.data() + static_cast<std::size_t>(bottom) * stride;\\n        const int* exiting = matrix.data() + static_cast<std::size_t>(bottom - s) * stride;\\n        for (int j = 0; j < n; ++j)\\n            columns[j] += static_cast<long long>(entering[j])\\n                        - static_cast<long long>(exiting[j]);\\n\\n        const long long stripBest = best_window(columns, s);\\n        if (stripBest > mxSum)\\n            mxSum = stripBest;\\n    }\\n\\n    printf(\\\"%lld\\\\n\\\", mxSum);\\n    return 0;\\n}\\n\",\n      \"path\": \"src/solution.cpp\"\n    }\n  ],\n  \"hypothesis\": \"Contiguous row-major storage and rolling column totals should eliminate strided rescans, improve cache locality, and reduce total computation from O(SN²) to O(N²).\",\n  \"notes\": \"Input parsing and output formatting are preserved. Serial implementation; no commands, compilation, or measurements performed.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Replace separately allocated matrix rows with one contiguous row-major buffer.\",\n    \"Maintain column totals using contiguous entering/exiting row scans, then find each strip's maximum with a horizontal rolling window.\",\n    \"Use 64-bit accumulators, widen operands before subtraction, and initialize maxima from actual windows to handle negative values safely.\"\n  ]\n}"}}

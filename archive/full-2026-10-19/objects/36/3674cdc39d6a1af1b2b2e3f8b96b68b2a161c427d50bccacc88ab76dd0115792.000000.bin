"""Independent pure counterexamples; production source and live services forbidden."""
import ast
import copy
import importlib.util
import json
import sys
import unittest
from pathlib import Path
from unittest.mock import patch

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
BASELINE = ROOT.parent / "revision-r4-observer-binding"


def load(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    value = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(value)
    return value


C = load("independent_closed_delta", ROOT / "chain_contract.py")


class PureReview(unittest.TestCase):
    def test_manifest_and_all_old_and_active_bytes(self):
        manifest = json.loads((ROOT / "MANIFESTE-DELTA-LOCAL.json").read_text("utf8"))
        self.assertGreater(len(manifest["files"]), 34)
        for name, entry in manifest["files"].items():
            with self.subTest(file=name):
                path = ROOT / name
                self.assertEqual(C.sha(path), entry["sha256"])
                self.assertEqual(path.stat().st_size, entry["bytes"])
        result = C.local_delta(ROOT)
        self.assertEqual(result["qualified_components_sha256"], C.QUALIFIED_COMPONENTS_SHA)
        self.assertEqual(result["active_components_sha256"], "c03ed75936ae5b833cbe0acc8a875083bd2a06831853fb706a8d2907968c5203")

    def test_Q_equality_function_itself_unchanged(self):
        def qualification(path):
            node = next(n for n in ast.parse(path.read_text("utf8")).body
                        if isinstance(n, ast.FunctionDef) and n.name == "qualification")
            return ast.dump(node, include_attributes=False)
        self.assertEqual(qualification(ROOT / "chain_contract.py"),
                         qualification(BASELINE / "chain_contract.py"))

    def test_Q_rejects_new_graph_as_allocated_graph(self):
        path = ROOT.parents[2] / "operations-parent-lane-close-20261018T0542/qualification4/reception-verifiee.json"
        ref = {"path": str(path), "sha256": C.sha(path)}
        self.assertIs(C.qualification(ref, components_manifest_sha256=C.QUALIFIED_COMPONENTS_SHA)["verified"], True)
        with self.assertRaisesRegex(ValueError, "Actual allocated derivative"):
            C.qualification(ref, components_manifest_sha256=C.sha(ROOT / "COMPONENTS.json"))

    def test_entire_old_graph_is_actually_read_and_verified(self):
        target = BASELINE / "launcher/remote_stage.py"
        actual_sha = C.sha
        seen = []
        def altered_sha(path):
            seen.append(Path(path))
            return "e" * 64 if Path(path) == target else actual_sha(path)
        with patch.object(C, "sha", side_effect=altered_sha), self.assertRaisesRegex(ValueError, "changed evidence"):
            C.local_delta(ROOT)
        self.assertIn(target, seen)

    def test_all_scope_booleans_and_closed_sets_refuse_widening(self):
        active = json.loads((ROOT / "COMPONENTS.json").read_text("utf8"))["code_pins"]
        base = json.loads((BASELINE / "COMPONENTS.json").read_text("utf8"))["code_pins"]
        delta = json.loads((ROOT / "DELTA-LOCAL-FERME.json").read_text("utf8"))
        for field in ("source105_changed", "ARM_executable_components_changed", "Q_reexecuted", "native_generation_admitted"):
            with self.subTest(field=field):
                changed = copy.deepcopy(delta)
                changed[field] = True
                with self.assertRaises(ValueError):
                    C.check_local_delta(base, active, changed)
        changed = copy.deepcopy(delta)
        changed["unknown_override"] = True
        with self.assertRaises(ValueError):
            C.check_local_delta(base, active, changed)
        for field in ("unchanged_files", "changed_files", "added_files"):
            with self.subTest(field=field):
                changed = copy.deepcopy(delta)
                changed[field]["unreviewed.py"] = "f" * 64
                with self.assertRaises(ValueError):
                    C.check_local_delta(base, active, changed)

    def test_binding_wrong_reader_verifier_or_revision_refused_before_source(self):
        bridge = load("independent_bridge_binding", ROOT / "reader_bridge.py")
        original = json.loads((ROOT / "BINDING-SO-LECTEUR.json").read_text("utf8"))
        for field in ("reader", "current_verifier", "revision"):
            with self.subTest(field=field):
                binding = copy.deepcopy(original)
                if field == "revision":
                    binding[field] = "r3-command-identity"
                else:
                    binding[field]["sha256"] = "f" * 64
                with patch.object(bridge, "read", return_value=binding), \
                     patch.object(bridge, "source_modules", side_effect=AssertionError("SOURCE FORBIDDEN")), \
                     self.assertRaises(ValueError):
                    bridge.produce_projection({}, {}, {"path": "NEUTRAL", "sha256": "0" * 64})

    def test_latest_R2d_distinct_from_historical_anchor(self):
        projection = load("independent_projection_closure", ROOT / "lane_projection.py")
        binding = json.loads((ROOT / "BINDING-SO-LECTEUR.json").read_text("utf8"))
        projection.DEPENDENCIES["source_state"] = (Path(binding["reader"]["path"]), binding["reader"]["sha256"])
        self.assertEqual(projection.R2_CLOSURE_SHA, "f9d64a0e87ad68248429681cb3efe01a9e56289fba615eeb55291089665aee3d")
        observations = {"latest_R2d_closure": projection.R2D_CLOSURE_REFS,
                        "evidence_refs": list(projection.R2D_CLOSURE_REFS.values())}
        projection.verify_current_r2d_closure(observations, [])
        missing = copy.deepcopy(observations)
        missing["evidence_refs"].pop()
        with self.assertRaisesRegex(ValueError, "Exact latest"):
            projection.verify_current_r2d_closure(missing, [])
        stopped = projection.read(projection.R2D_CLOSURE_REFS["terminal_stop"])
        old = stopped["actions"][0]["identity"]
        with self.assertRaisesRegex(ValueError, "still present"):
            projection.verify_current_r2d_closure(observations, [old])
        same_command_new_pid = {**old, "ProcessId": 987654321}
        with self.assertRaisesRegex(ValueError, "Equivalent closed"):
            projection.verify_current_r2d_closure(observations, [same_command_new_pid])
        opaque_same_pid = {**old, "CommandLine": None}
        with self.assertRaises(ValueError):
            projection.verify_current_r2d_closure(observations, [opaque_same_pid])

    def test_OBS4_actual_main_checks_runtime_dependencies_before_any_live_path(self):
        observer = load("independent_OBS4_main", ROOT / "observer/observer-mixte.py")
        validation = json.loads((ROOT / "observer/validation-locale.json").read_text("utf8"))
        def forbidden(*args, **kwargs):
            raise AssertionError("LIVE EFFECT FORBIDDEN")
        with patch.object(observer, "census", side_effect=forbidden), \
             patch.object(observer, "passive_transport_module", side_effect=forbidden), \
             patch.object(observer.asyncio, "run", side_effect=forbidden), \
             patch.object(observer.subprocess, "run", side_effect=forbidden), \
             patch.object(sys, "argv", ["NEUTRAL-no-live-mode"]):
            with self.assertRaisesRegex(ValueError, "Actual policy/routes"):
                observer.main()
            for field in ("ok", "observer_sha256", "test_sha256"):
                with self.subTest(field=field):
                    value = {**validation, field: False if field == "ok" else "e" * 64}
                    with patch.object(observer, "read", return_value=value), \
                         self.assertRaisesRegex(ValueError, "Exact local neutral"):
                        observer.main()


if __name__ == "__main__":
    unittest.main(verbosity=2)

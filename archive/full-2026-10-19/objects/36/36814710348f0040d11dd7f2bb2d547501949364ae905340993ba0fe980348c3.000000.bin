{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#ifndef _POSIX_C_SOURCE\\n#define _POSIX_C_SOURCE 200809L\\n#endif\\n\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <math.h>\\n#include <string.h>\\n#include <pthread.h>\\n\\n#pragma weak pthread_create\\n#pragma weak pthread_join\\n\\n#define MAXNUM 100\\n#define MAXSTR 50\\n#define MAXRESULTS 1000\\n#define MAXWORKERS 4\\n#define PARALLEL_MIN_PAIRS 64\\n\\nchar firstHalf[MAXNUM][MAXSTR];\\nchar secondHalf[MAXNUM][MAXSTR];\\nlong int result[MAXRESULTS];\\nint numPrimes=0;\\n\\nint isprime(long int value)\\n{ long int root;\\n  long int factor=2;\\n  int prime=1;\\n  root = sqrtl(value);\\n  while ((factor<=root) && (prime))\\n        { prime = fmod((double)value,(double) factor) > 0.0;\\n          factor++;\\n        }\\n  return prime;\\n}\\n\\nvoid quicksort(long int *primes,int first,int last)\\n{ int i, j, pivot;\\n  long int temp;\\n\\n  if (first<last)\\n     { pivot=first;\\n       i=first;\\n       j=last;\\n       while(i<j)\\n         { while (primes[i]<=primes[pivot]&&i<last)\\n             i++;\\n           while(primes[j]>primes[pivot])\\n             j--;\\n           if (i<j)\\n              { temp=primes[i];\\n                primes[i]=primes[j];\\n                primes[j]=temp;\\n              }\\n         }\\n       temp=primes[pivot];\\n       primes[pivot]=primes[j];\\n       primes[j]=temp;\\n       quicksort(primes,first,j-1);\\n       quicksort(primes,j+1,last);\\n     }\\n}\\n\\nstruct row_results\\n{\\n  int count;\\n  long int values[MAXNUM];\\n};\\n\\nstruct work_state\\n{\\n  unsigned int next_row;\\n  struct row_results rows[MAXNUM];\\n};\\n\\nstatic int test_row(int row, long int *row_values)\\n{\\n  char candidate[MAXSTR];\\n  int count = 0;\\n\\n  for (int j = 0; j < numPrimes; ++j)\\n    {\\n      strcpy(candidate, firstHalf[row]);\\n      strcat(candidate, secondHalf[j]);\\n      long int value = atol(candidate);\\n      if (isprime(value))\\n        row_values[count++] = value;\\n    }\\n  return count;\\n}\\n\\nstatic void *run_work(void *argument)\\n{\\n  struct work_state *work = argument;\\n\\n  for (;;)\\n    {\\n      unsigned int row = __atomic_fetch_add(&work->next_row, 1U,\\n                                            __ATOMIC_RELAXED);\\n      if (row >= (unsigned int)numPrimes)\\n        return NULL;\\n      work->rows[row].count = test_row((int)row, work->rows[row].values);\\n    }\\n}\\n\\nstatic int find_primes_serial(void)\\n{\\n  int count = 0;\\n\\n  for (int i = 0; i < numPrimes; ++i)\\n    count += test_row(i, result + count);\\n  return count;\\n}\\n\\nstatic int find_primes(void)\\n{\\n  if (numPrimes * numPrimes < PARALLEL_MIN_PAIRS ||\\n      pthread_create == NULL || pthread_join == NULL)\\n    return find_primes_serial();\\n\\n  struct work_state *work = malloc(sizeof *work);\\n  if (work == NULL)\\n    return find_primes_serial();\\n  work->next_row = 0U;\\n\\n  pthread_t workers[MAXWORKERS - 1] = {0};\\n  int started = 0;\\n\\n  for (int worker = 1; worker < MAXWORKERS; ++worker)\\n    {\\n      if (pthread_create(&workers[started], NULL, run_work, work) != 0)\\n        break;\\n      ++started;\\n    }\\n\\n  run_work(work);\\n  for (int worker = 0; worker < started; ++worker)\\n    (void)pthread_join(workers[worker], NULL);\\n\\n  int count = 0;\\n  for (int i = 0; i < numPrimes; ++i)\\n    {\\n      int row_count = work->rows[i].count;\\n      memcpy(result + count, work->rows[i].values,\\n             (size_t)row_count * sizeof result[0]);\\n      count += row_count;\\n    }\\n\\n  free(work);\\n  return count;\\n}\\n\\nint main(int argc,char** argv)\\n{ FILE *primesFile;\\n  int i=0,numResults=0;\\n  primesFile=stdin;\\n  fscanf(primesFile,\\\"%d\\\\n\\\",&numPrimes);\\n  for (i=0;i<numPrimes;i++)\\n      fscanf(primesFile,\\\"%s\\\\n\\\",firstHalf[i]);\\n  for (i=0;i<numPrimes;i++)\\n      fscanf(primesFile,\\\"%s\\\\n\\\",secondHalf[i]);\\n  fclose(primesFile);\\n  numResults = find_primes();\\n  quicksort(result,0,numResults-1);\\n  for (i=0;i<numResults;i++)\\n      printf(\\\"%ld\\\\n\\\",result[i]);\\n  return 0;\\n}\\n\",\n      \"path\": \"src/model-view/primetest.c\"\n    },\n    {\n      \"content\": \"#ifndef _POSIX_C_SOURCE\\n#define _POSIX_C_SOURCE 200809L\\n#endif\\n\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <math.h>\\n#include <string.h>\\n#include <pthread.h>\\n\\n#pragma weak pthread_create\\n#pragma weak pthread_join\\n\\n#define MAXNUM 100\\n#define MAXSTR 50\\n#define MAXRESULTS 1000\\n#define MAXWORKERS 4\\n#define PARALLEL_MIN_PAIRS 64\\n\\nchar firstHalf[MAXNUM][MAXSTR];\\nchar secondHalf[MAXNUM][MAXSTR];\\nlong int result[MAXRESULTS];\\nint numPrimes=0;\\n\\nint isprime(long int value)\\n{ long int root;\\n  long int factor=2;\\n  int prime=1;\\n  root = sqrtl(value);\\n  while ((factor<=root) && (prime))\\n        { prime = fmod((double)value,(double) factor) > 0.0;\\n          factor++;\\n        }\\n  return prime;\\n}\\n\\nvoid quicksort(long int *primes,int first,int last)\\n{ int i, j, pivot;\\n  long int temp;\\n\\n  if (first<last)\\n     { pivot=first;\\n       i=first;\\n       j=last;\\n       while(i<j)\\n         { while (primes[i]<=primes[pivot]&&i<last)\\n             i++;\\n           while(primes[j]>primes[pivot])\\n             j--;\\n           if (i<j)\\n              { temp=primes[i];\\n                primes[i]=primes[j];\\n                primes[j]=temp;\\n              }\\n         }\\n       temp=primes[pivot];\\n       primes[pivot]=primes[j];\\n       primes[j]=temp;\\n       quicksort(primes,first,j-1);\\n       quicksort(primes,j+1,last);\\n     }\\n}\\n\\nstruct row_results\\n{\\n  int count;\\n  long int values[MAXNUM];\\n};\\n\\nstruct work_state\\n{\\n  unsigned int next_row;\\n  struct row_results rows[MAXNUM];\\n};\\n\\nstatic int test_row(int row, long int *row_values)\\n{\\n  char candidate[MAXSTR];\\n  int count = 0;
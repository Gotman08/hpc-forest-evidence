{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nstatic void body_force_scalar(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Pack positions separately from velocities, then reuse each source\n * position across four targets. Each target still accumulates in j order.\n */\nvoid body_force(Body *p, float dt, int n) {\n  if (n <= 0) {\n    return;\n  }\n\n  size_t count = (size_t)n;\n  if (count > ((size_t)-1) / (3 * sizeof(float))) {\n    body_force_scalar(p, dt, n);\n    return;\n  }\n\n  float *positions = (float *)malloc(3 * count * sizeof(float));\n  if (positions == NULL) {\n    body_force_scalar(p, dt, n);\n    return;\n  }\n\n  float *x = positions;\n  float *y = x + count;\n  float *z = y + count;\n  for (int k = 0; k < n; ++k) {\n    x[k] = p[k].x;\n    y[k] = p[k].y;\n    z[k] = p[k].z;\n  }\n\n  int i = 0;\n  for (; n - i >= 4; i += 4) {\n    const float xi0 = x[i];\n    const float yi0 = y[i];\n    const float zi0 = z[i];\n    const float xi1 = x[i + 1];\n    const float yi1 = y[i + 1];\n    const float zi1 = z[i + 1];\n    const float xi2 = x[i + 2];\n    const float yi2 = y[i + 2];\n    const float zi2 = z[i + 2];\n    const float xi3 = x[i + 3];\n    const float yi3 = y[i + 3];\n    const float zi3 = z[i + 3];\n\n    float fx0 = 0.0f, fy0 = 0.0f, fz0 = 0.0f;\n    float fx1 = 0.0f, fy1 = 0.0f, fz1 = 0.0f;\n    float fx2 = 0.0f, fy2 = 0.0f, fz2 = 0.0f;\n    float fx3 = 0.0f, fy3 = 0.0f, fz3 = 0.0f;\n\n    for (int j = 0; j < n; ++j) {\n      const float xj = x[j];\n      const float yj = y[j];\n      const float zj = z[j];\n\n      float dx0 = xj - xi0;\n      float dy0 = yj - yi0;\n      float dz0 = zj - zi0;\n      float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\n      float inv_dist0 = 1 / sqrt(sqrd_dist0);\n      float inv_dist0_cubed = inv_dist0 * inv_dist0 * inv_dist0;\n      fx0 += dx0 * inv_dist0_cubed;\n      fy0 += dy0 * inv_dist0_cubed;\n      fz0 += dz0 * inv_dist0_cubed;\n\n      float dx1 = xj - xi1;\n      float dy1 = yj - yi1;\n      float dz1 = zj - zi1;\n      float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\n      float inv_dist1 = 1 / sqrt(sqrd_dist1);\n      float inv_dist1_cubed = inv_dist1 * inv_dist1 * inv_dist1;\n      fx1 += dx1 * inv_dist1_cubed;\n      fy1 += dy1 * inv_dist1_cubed;\n      fz1 += dz1 * inv_dist1_cubed;\n\n      float dx2 = xj - xi2;\n      float dy2 = yj - yi2;\n      float dz2 = zj - zi2;\n      float sqrd_dist2 = dx2*dx2 + dy2*dy2 + dz2*dz2 + SOFTENING;\n      float inv_dist2 = 1 / sqrt(sqrd_dist2);\n      float inv_dist2_cubed = inv_dist2 * inv_dist2 * inv_dist2;\n      fx2 += dx2 * inv_dist2_cubed;\n      fy2 += dy2 * inv_dist2_cubed;\n      fz2 += dz2 * inv_dist2_cubed;\n\n      float dx3 = xj - xi3;\n      float dy3 = yj - yi3;\n      float dz3 = zj - zi3;\n      float sqrd_dist3 = dx3*dx3 + dy3*dy3 + dz3*dz3 + SOFTENING;\n      float inv_dist3 = 1 / sqrt(sqrd_dist3);\n      float inv_dist3_cubed = inv_dist3 * inv_dist3 * inv_dist3;\n      fx3 += dx3 * inv_dist3_cubed;\n      fy3 += dy3 * inv_dist3_cubed;\n      fz3 += dz3 * inv_dist3_cubed;\n    }\n\n    p[i].vx += dt*fx0;\n    p[i].vy += dt*fy0;\n    p[i].vz += dt*fz0;\n    p[i + 1].vx += dt*fx1;\n    p[i + 1].vy += dt*fy1;\n    p[i + 1].vz += dt*fz1;\n    p[i + 2].vx += dt*fx2;\n    p[i + 2].vy += dt*fy2;\n    p[i + 2].vz += dt*fz2;\n    p[i + 3].vx += dt*fx3;\n    p[i + 3].vy += dt*fy3;\n    p[i + 3].vz += dt*fz3;\n  }\n\n  for (; i < n; ++i) {\n    const float xi = x[i];\n    const float yi = y[i];\n    const float zi = z[i];\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; ++j) {\n      float dx = x[j] - xi;\n      float dy = y[j] - yi;\n      float dz = z[j] - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n\n  free(positions);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n  \n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Position-only SoA packing and four-target tiling should reduce cache traffic by reusing each source position across four bodies without changing their accumulation order.",
  "notes": "Preserves increasing-j summation and the original sqrt/division expressions. Handles remainders and allocation failure; scratch state is rebuilt each call. Not executed.",
  "sources_kept": [],
  "transformations": [

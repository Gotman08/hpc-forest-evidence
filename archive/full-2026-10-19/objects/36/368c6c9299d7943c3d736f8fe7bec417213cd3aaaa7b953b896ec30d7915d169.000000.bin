from pathlib import Path
from datetime import datetime,UTC
import json,hashlib,re
OPS=Path(__file__).resolve().parent
ROOT=OPS.parent
BASE=OPS.parents[2]
def ref(p):return {'path':str(p.resolve()),'sha256':hashlib.sha256(p.read_bytes()).hexdigest()}
def read(p):return json.loads(p.read_bytes())
def inv(d):return {p.relative_to(d).as_posix():{'sha256':ref(p)['sha256'],'bytes':p.stat().st_size} for p in sorted(d.rglob('*')) if p.is_file()}
rows=[]
for job,model in [('753498','gpt-6-astra'),('753497','gpt-5.6-terra'),('753499','gpt-6.1-sol')]:
    d=ROOT/f'reception-terminal-{job}'
    restored=d/'restauration-neuve-parent-r1'
    out=restored/f'results-{job}'
    before=read(d/'INVENTAIRE-RESTAURATION-PARENT.json')
    assert inv(restored)==before
    result=read(out/'results.json'); calls=[]
    for p in sorted((out/'mailbox/requests').glob('*.request.json')):
        n=p.name.removesuffix('.request.json')
        resp=read(out/'mailbox/responses'/f'{n}.response.json')
        proc=read(out/'mailbox/logs'/f'{n}.codex.jsonl.json')['record_without_private_argv']
        assert (out/'mailbox/logs'/f'{n}.invocation.json').is_file() and (out/'mailbox/logs'/f'{n}.delivered.json').is_file()
        u=resp['usage']
        calls.append({'nonce':n,'archived_invocation_response_delivery_present':True,'timed_out_declared':proc['timed_out'],
            'returncode_declared':proc['returncode'],'seconds_declared':proc['seconds'],'infrastructure_error':resp['infrastructure_error'],
            'declared_accounting':u['token_accounting'],'exact_tokens_declared':u['tokens'] if u['token_accounting']=='exact' else None,
            'raw_private_argv_audit_of_final_boundary_pending':True})
    status=read(d/'statut-terminal.json')['structuredContent']
    assert status['finished'] and status['state']=='FAILED' and status['exit_code']=='1:0' and status['observation']['current_state_observed']
    assert result['pipeline_complete'] is False and result['extension_blocked'] is True
    rows.append({'job_id':job,'model':model,'terminal_status':ref(d/'statut-terminal.json'),'efficiency':ref(d/'efficacite.json'),
        'archive':ref(d/f'results-{job}.tar.gz'),'archive_announcement':ref(d/'archive.json'),'restoration':ref(d/'RESTAURATION-PARENT-VERIFIEE.json'),
        'restored_files':len(before),'recorded_result_error':result['error'],'pipeline_complete':False,'calls':calls,
        'inventory_unchanged_after_metadata_inspection':True})
record={'schema':'hpc-forest-r2g-terminal-observation-before-final-audit-v1','observed_at':datetime.now(UTC).isoformat(),
    'verified_terminal_archive_receive_and_restore_only':True,'cells':rows,'restored_files_total':sum(x['restored_files'] for x in rows),
    'archived_requests_invocations_responses_deliveries_present':sum(len(x['calls']) for x in rows),
    'last_bounded_expirations_declared':sum(c['timed_out_declared'] is True for x in rows for c in x['calls']),
    'native_scientific_admission':False,'final_private_audit_complete':False,'final_reconciliation_complete':False,
    'any_process_stopped_or_generation_replayed':False,'total_consumption_claimed':False}
target=ROOT/'OBSERVATION-TERMINALE-AVANT-AUDIT.json'
with target.open('x',encoding='utf8') as f:json.dump(record,f,ensure_ascii=False,indent=2);f.write('\n')
guide=BASE/'outputs/HPC-Forest-Harnais-Comparaison-r1/SUIVI-COMPACT.md'
ids=BASE/'ID.md'
backup=OPS/'avant-etat-terminal-20261018T1545'
backup.mkdir(exist_ok=False)
manifest={}
for p in (guide,ids):
    raw=p.read_bytes();(backup/p.name).write_bytes(raw);assert (backup/p.name).read_bytes()==raw
    manifest[p.name]={'sha256_before':ref(p)['sha256']}
text=guide.read_text('utf8')
anchor='## Priorité et état courant\n'
assert text.count(anchor)==1
note='''
Arrêté terminal18octobre : G753498/753497/753499 FAILED1:0, fins fraîches15:17:26–29UTC reçues. Les trois premiers NORMAL/évaluations valides/audits privés et poursuites restent reçus, mais les dernières invocations sont expirées (timed_out=true :21,2333/381,8629/450,5070s). Le garde a arrêté la recherche avant confirmation : pipeline_complete=false, extension_blocked=true. Aucun nouveau défaut bas niveau ni autorisation de rejeu n'en découle.

Les TROIS archives/efficacités sont reçues ; annonce/distante/locale égales, restaurations NEUVES582/429/429=1440fichiers stables. Preuve OBSERVATION-TERMINALE-AVANT-AUDIT.json sous ../HPC-Forest-Primes-Natif-Relance-r2g/. Dix requêtes/invocations/réponses/livraisons sont présentes dans les archives ; sept usages exacts déclarés et trois usages non mesurés/réservations, aucun total de consommation revendiqué avant audit des bruts. Les cinq confirmations et bilan scientifique complet sont absents ; ne pas promouvoir de gain, réparer/rejouer ou admettre les PDF.

Réception finale/audit privé/réconciliation EN COURS : nouveau lecteur natif G Audit-r2g/revision-r3 et compagnon metadata-terminal-r1/companion en revue indépendante ; premier refus de CACHE_PARENT r1 conservé, chemin exact corrigé r2 ; exception opérationnelle G strictement STAT-ONLY/read_attempted=false/read_errno=null, aucun errno13 inventé, aucun worker.lock lu. Collecteur ROOT seulement en préparation sous Relance-r2g/collecte-finale-pure-r1/. Reçus de clôture et préservation finale NON REÇUS : les trois relais restent comptés conservativement jusqu'à clôture vérifiée. Aucun processus arrêté. Helpers fermeture-relais-r2g-r1 revus PREPARATION SEULEMENT668b59a1…, six pins finaux NON_ADMIS ; aucune commande d'effet avant réceptions/audits/réconciliation/cache/revue concrets. Ne pas repoller les trois états terminaux sans nouveau besoin de preuve.

'''
text=text.replace(anchor,anchor+note,1)
start=text.index('R2g est réellement lancé et RUNNING')
end=text.index('\n\nLes trois premiers démarrages',start)
text=text[:start]+'''Identités G historiques du lancement : Astra753498/session110cefccf16b439eb226e475c875c8df, Terra753497/session5d8811082a1842f5836a2bdda982500f, Sol753499/session13eaca4e39cf4147a3f677a32fb5a52d. Leurs jobs sont désormais terminaux comme établi ci-dessus. Paires lanceur/Python=un worker, maximum quatre ; aucune voie libérée avant clôture vérifiée. LabelsSlurm r2f historiques seulement, identités/racines/sourceG font foi.''' +text[end:]
r3anchor='## Suite R3 corrigée R4b et R5\n'
assert text.count(r3anchor)==1
r3note='''
NOUVELLE préparation locale R3 candidate source110 disponible, NON ADMISE : ../HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r3/revision-source-cli-r1/LIVRAISON-SOURCE110-CANDIDATE-POUR-REVUE.json SHA f61d7cd7ec33c821cccd64713f1b2bdacf3e0eb95c8b98d455a9446ff101250f ; ZIP eaff9217499fe268e4d151165a368a83bad1550d921955a9f9256026cfac2d48 / plan d08ac00bcfb75625a24971b2684d7479c4da7a98b339e4e10eae5b9ac525ef27. Six fichiers modifiés/cinq nouveaux/99 anciens identiques, 187 cas neutres distincts passent avec premiers refus de fixtures conservés. Ancienne105, méthode/ressources/oracles/budgets et neuf sessions préservés. Revue source indépendante, nouveaux adaptateurs et Q ARM exacte ENCORE REQUIS ; aucun appel/Q/pilot nouveauR3 lancé. Ne pas confondre ces contrôles locaux avec admission native. Les exigences ci-dessous restent applicables.

'''
text=text.replace(r3anchor,r3anchor+r3note,1)
guide.write_text(text,encoding='utf8',newline='\n')
raw=ids.read_bytes(); original_ids=set(re.findall(rb'\bID-(\d{3})\b',raw)); assert len(original_ids)==40
at=raw.index(b'\n')+1
note_id='\r\nÉtat terminal technique18octobre : R2g trois finsFAILED reçues,1440fichiers restaurés inchangés ; derniersappelsexpirés, confirmations/bilanfinalabsents. Audits/réconciliation/clôture encours, aucunrejeu/arrêt/admissionscientifique. SourceR3candidate110 locale nonadmise, revue/Qexacte encore requises. Voir SUIVI-COMPACT.md et OBSERVATION-TERMINALE-AVANT-AUDIT.json ; les quarante idées et anciens résultats sont préservés.\r\n'
ids.write_bytes(raw[:at]+note_id.encode()+raw[at:]);assert set(re.findall(rb'\bID-(\d{3})\b',ids.read_bytes()))==original_ids
for p in (guide,ids):manifest[p.name]['sha256_after']=ref(p)['sha256']
manifest.update(first_start_proofs_preserved=True,terminal_observation=ref(target),forty_ID_preserved=True,scientific_admission_added=False)
with (backup/'PRESERVATION-ET-ETAT.json').open('x',encoding='utf8') as f:json.dump(manifest,f,indent=2);f.write('\n')
print(json.dumps(manifest))

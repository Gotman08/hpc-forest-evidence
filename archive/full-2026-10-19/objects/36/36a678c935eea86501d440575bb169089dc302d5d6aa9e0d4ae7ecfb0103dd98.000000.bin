#include <algorithm>
#include <cstdint>
#include <iostream>
#include <vector>

using namespace std;

const int MOD = 1000000007;

int main() {
    int n, m;
    if (!(cin >> n >> m)) return 0;

    vector<uint64_t> blocked;
    blocked.reserve(static_cast<size_t>(m));
    for (int c = 0; c < m; ++c) {
        int row, col;
        cin >> row >> col;
        blocked.push_back((static_cast<uint64_t>(row) << 32) |
                          static_cast<uint64_t>(col));
    }
    sort(blocked.begin(), blocked.end());
    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());

    vector<int> dp(n, 0);
    dp[0] = 1;
    size_t next = 0;

    for (int row = 0; row < n; ++row) {
        int left = 0;
        int begin = 0;
        for (;;) {
            int end = n;
            if (next < blocked.size() &&
                (blocked[next] >> 32) == static_cast<uint64_t>(row)) {
                end = static_cast<int>(static_cast<uint32_t>(blocked[next]));
                ++next;
            }

            // Within a clear span, dp[col] is above and left is already updated.
            for (int col = begin; col < end; ++col) {
                int value = dp[col] + left;
                if (value >= MOD) value -= MOD;
                dp[col] = value;
                left = value;
            }

            if (end == n) break;
            dp[end] = 0;
            left = 0;
            begin = end + 1;
        }
    }

    cout << dp[n - 1] << endl;
    return 0;
}

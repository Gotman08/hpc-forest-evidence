{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <math.h>\n#include <omp.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nstatic void body_force(const float *restrict x,\n                       const float *restrict y,\n                       const float *restrict z,\n                       float *restrict vx,\n                       float *restrict vy,\n                       float *restrict vz,\n                       int n, float dt) {\n  #pragma omp for schedule(static)\n  for (int i = 0; i < n; ++i) {\n    const float xi = x[i];\n    const float yi = y[i];\n    const float zi = z[i];\n\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    int j = 0;\n    // Unroll the inner loop by 4 to reduce overhead and improve ILP.\n    for (; j + 4 <= n; j += 4) {\n      // body j\n      float dx = x[j] - xi;\n      float dy = y[j] - yi;\n      float dz = z[j] - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1.0f / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n\n      // body j+1\n      dx = x[j+1] - xi;\n      dy = y[j+1] - yi;\n      dz = z[j+1] - zi;\n      sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      inv_dist = 1.0f / sqrt(sqrd_dist);\n      inv_dist3 = inv_dist * inv_dist * inv_dist;\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n\n      // body j+2\n      dx = x[j+2] - xi;\n      dy = y[j+2] - yi;\n      dz = z[j+2] - zi;\n      sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      inv_dist = 1.0f / sqrt(sqrd_dist);\n      inv_dist3 = inv_dist * inv_dist * inv_dist;\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n\n      // body j+3\n      dx = x[j+3] - xi;\n      dy = y[j+3] - yi;\n      dz = z[j+3] - zi;\n      sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      inv_dist = 1.0f / sqrt(sqrd_dist);\n      inv_dist3 = inv_dist * inv_dist * inv_dist;\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    // Remainder iterations (if n is not a multiple of 4)\n    for (; j < n; ++j) {\n      float dx = x[j] - xi;\n      float dy = y[j] - yi;\n      float dz = z[j] - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1.0f / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    vx[i] += dt*fx;\n    vy[i] += dt*fy;\n    vz[i] += dt*fz;\n  }\n}\n\nstatic Body* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc((size_t)*nbodies * sizeof(Body));\n  b = fread(bodies, (size_t)*nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\nstatic void write_dataset(const int nbodies,\n                          const float *restrict x,\n                          const float *restrict y,\n                          const float *restrict z,\n                          const float *restrict vx,\n                          const float *restrict vy,\n                          const float *restrict vz) {\n  Body *out = (Body *)malloc((size_t)nbodies * sizeof(Body));\n  if (!out) { perror(\"malloc\"); exit(EXIT_FAILURE); }\n\n  for (int i = 0; i < nbodies; ++i) {\n    out[i].x = x[i];\n    out[i].y = y[i];\n    out[i].z = z[i];\n    out[i].vx = vx[i];\n    out[i].vy = vy[i];\n    out[i].vz = vz[i];\n  }\n\n  int b = fwrite(out, (size_t)nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    free(out);\n    exit(EXIT_FAILURE);\n  }\n  free(out);\n}\n\nint main(int argc, char **argv) {\n  int nbodies;\n  Body *bodies = read_dataset(&nbodies);\n\n  float *px = (float *)malloc((size_t)nbodies * sizeof(float));\n  float *py = (float *)malloc((size_t)nbodies * sizeof(float));\n  float *pz = (float *)malloc((size_t)nbodies * sizeof(float));\n  float *vx = (float *)malloc((size_t)nbodies * sizeof(float));\n  float *vy = (float *)malloc((size_t)nbodies * sizeof(float));\n  float *vz = (float *)malloc((size_t)nbodies * sizeof(float));\n\n  if (!px || !py || !pz || !vx || !vy || !vz) {\n    perror(\"malloc\");\n    exit(EXIT_FAILURE);\n  }\n\n  for (int i = 0; i < nbodies; ++i) {\n    px[i] = bodies[i].x;\n    py[i] = bodies[i].y;\n    pz[i] = bodies[i].z;\n    vx[i] = bodies[i].vx;\n    vy[i] = bodies[i].vy;\n    vz[i] = bodies[i].vz;\n  }\n  free(bodies);\n\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    #pragma omp parallel\n    {\n      body_force(px, py, pz, vx, vy, vz, nbodies, DT);\n      #pragma omp for schedule(static)\n      for (int i = 0; i < nbodies; ++i) {\n        px[i] += vx[i] * DT;\n        py[i] += vy[i] * DT;\n        pz[i] += vz[i] * DT;\n      }\n    }\n  }\n\n  write_dataset(nbodies, px, py, pz, vx, vy, vz);\n\n  free(px); free(py); free(pz);\n  free(vx); free(vy); free(vz);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Combining SoA layout, a single OpenMP parallel region per iteration with worksharing loops for force and position updates, manual unrolling of the inner j-loop by 4, and restrict pointers will reduce memory traffic and synchronization overhead while preserving exact floating-point summation order, yielding better speedup than any individual transformation.",
  "notes": "Integrated all three archived transformations: SoA arrays (from A/B), single parallel region per iteration with worksharing constructs (from C), inner-loop unrolling by 4 (from A), restrict qualifiers on array parameters (from A/B), and use of 1.0f/sqrt for clarity/performance (from B). The force loop uses static scheduling to minimize overhead; each i is processed entirely by one thread, preserving the original per-body accumulation order so output bytes remain identical.",

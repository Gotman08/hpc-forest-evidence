from datetime import UTC, datetime
import hashlib
import json
from pathlib import Path
import re

BASE = Path(r'C:\Users\nicol\Documents\Codex\2026-10-15\cr')
ROOT = BASE / 'outputs/HPC-Forest-Primes-Natif-Relance-r2g'
guide = BASE / 'outputs/HPC-Forest-Harnais-Comparaison-r1/SUIVI-COMPACT.md'
ids = BASE / 'ID.md'


def ref(path):
    return {'path': str(path), 'sha256': hashlib.sha256(path.read_bytes()).hexdigest()}


canonical = ROOT / 'RECEPTION-FINALE-ET-CLOTURE-VERIFIEE.json'
assert ref(canonical)['sha256'] == 'd4c74352d28555ba3a476273af51b1d7791c328fa37addcee580318aedbc6df4'
review = ROOT / 'operations-parent/post-cloture-r1/execution-root-01/revue-independante-r1/REVUE-POST-CLOTURE-REELLE-G.json'
assert ref(review)['sha256'] == '12d72682ca473cae60ec8133185c634420d2ea01c8ed6e13f35d4578be488ccb'
value = json.loads(canonical.read_bytes())
assert value['verified_metadata_only'] is True and value['all_21_owned_identities_absent'] is True
assert value['complete_files_preserved'] == 172 and value['native_research_admitted'] is False
backup = ROOT / 'operations-parent/avant-cloture-verifiee-guide-20261018'
backup.mkdir(exist_ok=False)
manifest = {}
for path in (guide, ids):
    raw = path.read_bytes()
    with (backup / path.name).open('xb') as stream:
        stream.write(raw)
    assert (backup / path.name).read_bytes() == raw
    manifest[path.name] = {'sha256_before': ref(path)['sha256']}
text = guide.read_text('utf8')
text = re.sub(r'\A(# HPC-Forest[^\n]*\n\n)État du [^.]+\.',
    r'\g<1>État du 18 octobre 2026, clôture vérifiée après 16:35 UTC.', text, count=1)
start = text.index('Clôture et préservation finale encore EN COURS :')
end = text.index('\n\n', start)
text = text[:start] + '''CLÔTURE G REÇUE, AUDITÉE ET RÉCONCILIÉE : canonique `../HPC-Forest-Primes-Natif-Relance-r2g/RECEPTION-FINALE-ET-CLOTURE-VERIFIEE.json` SHA d4c74352d28555ba3a476273af51b1d7791c328fa37addcee580318aedbc6df4. Trois actions individuelles sur les seuls Python principaux possédés après revue opérationnelle da1210cc… ; aucun effet visant les18services/parents. Absence des21identités constatée puis revue froide post-clôture12d72682… .172copies/1004641octets :169lisibles inchangées+3locks actuels reçus après clôture, SHA des locks avant arrêt toujours inconnu. Reçus17557e4b…/29cc34b3… et `REPRISE.md`, `BILAN-PARTIEL-CLOS.md` sous RelanceG. Les anciens PID sont HISTORIQUES, aucune cible d'intervention. ZÉRO relais natif G restant au reçu ; toute prochaine admission exige son nouveau CIM. Ne plus poller/reprendre/rejouer G ni renotifier ce bilan après sa livraison.

Les premiers refus utilitaires sont préservés : cache parent, archive à deux racines, collecteur refusant les descendants puis CIM périmé après deux copies. La collecte par étapes7dfd1862… a réellement renouvelé le CIM avant/après chaque copie sans étendre45s ; audits et réconciliations normés70028939… puis clôture sont complets dans leur périmètre MÉTADONNÉES seulement. Aucun refus scientifique, usage inconnu ou négatif n'est réparé. Sources/workers scellés inchangés ; aucune récursion ou API/connexion nouvelle.''' + text[end:]
text = text.replace('Paires lanceur/Python=un worker, maximum quatre ; aucune voie libérée avant clôture vérifiée.',
    'Paires lanceur/Python=un worker, maximum quatre ; les trois relais G sont désormais clos et absents au reçu, nouveau CIM obligatoire avant autre admission.')
text = text.replace('Les trois workers G restent comptés jusqu’à leur clôture vérifiée, même si Slurm termine.',
    'Les trois workers G sont clos au canonique d4c74352… ; tout nouvel état de processus doit être frais avant admission.')
text = text.replace('port externe concret en préparation sous adaptateurs-source110-r1/revision-r2-integration.',
    'port externe concret sous adaptateurs-source110-r1 : premier candidat75461… refusé avant lancement pour trois défauts de façade/refs/paquet ; correction31bfd1fd… reçue, revue020243ef… autorise sa Q mécanique exacte seulement. Les bindings G NULL sont dans ses62pins : une liaison concrète G change les octets et doit donc précéder un nouveau COMPONENTS/Q/revue. Liaison G réelle d4c74352…+revue12d72682… en révision isolée avant la première Q ; ne pas qualifier NULL puis promouvoir des pins modifiés. Aucun job Q ni modèle R3 lancé à cet arrêté.')
text = text.replace('Contrôle frais15:13UTC :72%utilisés/28%restants, trois resets disponibles, aucun consommé.',
    'Contrôle frais16:35:32UTC :79%utilisés/21%restants, trois resets disponibles, aucun consommé. Condition EXACTEMENT99% fausse ; aucun helper de reset/intention exécuté.')
guide.write_text(text, encoding='utf8', newline='\n')
raw = ids.read_bytes()
old_ids = set(re.findall(rb'\bID-(\d{3})\b', raw))
assert len(old_ids) == 40
old_note = re.search('État technique18octobre16:17UTC[^\r\n]+'.encode(), raw)
assert old_note
new_note = ('État technique18octobre après clôture : R2g CLOS métadonnées (10invocations,146676jetons exacts connus/7mesurées,3inconnues), '
    'audit natif complet refusé/coûts inconnus et confirmations absentes. Trois arrêts individuels possédés puis21absences et172fichiers préservés vérifiés/revus ; '
    'aucun gain scientifique nouveau/rejeu. Canonique d4c74352… ; R3 corrigé R4b reste en préparation/qualification exacte, R5 fermé. Quarante ID préservés, voir SUIVI-COMPACT.md.').encode()
ids.write_bytes(raw[:old_note.start()] + new_note + raw[old_note.end():])
assert set(re.findall(rb'\bID-(\d{3})\b', ids.read_bytes())) == old_ids
for path in (guide, ids):
    manifest[path.name]['sha256_after'] = ref(path)['sha256']
manifest.update(recorded_at=datetime.now(UTC).isoformat(), actual_canonical=ref(canonical),
    actual_post_close_review=ref(review), all_forty_ID_preserved=True,
    source_or_global_config_changed=False, new_scientific_admission=False, quota_reset_performed=False)
with (backup / 'PRESERVATION-ET-CLOTURE.json').open('x', encoding='utf8') as stream:
    json.dump(manifest, stream, indent=2)
quota = {'observed_at_utc': '2026-10-18T16:35:32Z', 'source': 'get_usage_limits codex primary',
    'window_duration_minutes': 10080, 'used_percent': 79, 'remaining_percent': 21,
    'banked_resets_available': 3, 'authorized_resets_maximum': 1,
    'exact_99_percent_condition_met': False, 'reset_helper_or_intent_executed': False}
with (backup / 'QUOTA-FRAIS-SANS-RESET.json').open('x', encoding='utf8') as stream:
    json.dump(quota, stream, indent=2)
print(json.dumps(manifest))

      "numbered_excerpts": [
        "51: def create_workspace(\n52:     destination: Path,\n53:     config: dict | None = None,\n54:     source: Path | None = None,\n55:     validation: Path | None = None,\n56: ) -> Path:\n57:     destination = destination.resolve()\n58:     if destination.exists():\n59:         raise ForestError(f\"Refusing to overwrite an existing directory: {destination}\")\n60:     config = json.loads(json.dumps(config or load_config()))\n61:     validate(config)\n62:     if config[\"backend\"] == \"ollama\":\n63:         config[\"ollama\"] = resolve_model(config[\"ollama\"])\n64:     config[\"target_id\"] = config.get(\"target_id\", local_target_id())\n65:     config[\"compiler\"] = compiler_identity()\n66:     assets = Path(str(files(\"hpc_forest\") / \"assets\"))\n67:     source = source.resolve() if source else assets / \"matmul\"\n68:     validation = validation.resolve() if validation else assets / \"validation\"\n69:     if not source.is_dir() or not validation.is_dir():\n70:         raise ForestError(\"Source and validation directories must exist\")\n71:     research = config.get(\"harness\", {}).get(\"research\", {})\n72:     corpus = None\n73:     if config.get(\"harness\", {}).get(\"enabled\") and research.get(\"enabled\"):\n74:         DocumentationReader(research, destination / \"research-preflight\", time.time())\n75:         if research.get(\"corpus\"):\n76:             corpus = Path(research[\"corpus\"]).resolve(strict=True)\n77:     destination.mkdir(parents=True)\n78:     trusted = destination / \"trusted\"\n79:     shutil.copytree(validation, trusted, ignore=shutil.ignore_patterns(\"__pycache__\"))\n80:     if corpus:\n81:         shutil.copyfile(corpus, trusted / \"research-corpus.json\")\n82:         research[\"corpus\"] = str(trusted / \"research-corpus.json\")\n83:     atomic_json(trusted / \"config.json\", config)\n84:     atomic_json(trusted / \"result-schema.json\", RESULT_SCHEMA)\n85:     commit = initialize_source(source, destination / \"repo\")\n86:     if (destination / \"repo\" / \"run.sh\").exists():\n87:         runner = destination / \"repo\" / \"run.sh\"\n88:         runner.chmod(runner.stat().st_mode | 0o111)\n89:         git(destination / \"repo\", \"update-index\", \"--chmod=+x\", \"run.sh\")\n90:         git(",
        "192:     def _baseline(self, epoch: dict) -> dict:\n193:         existing = self.db.one(\n194:             \"SELECT * FROM evaluations WHERE experiment_id=? AND phase='search'\",\n195:             (f\"baseline-e{epoch['id']}\",),\n196:         )\n197:         if existing:\n198:             result = json.loads(existing[\"payload\"])\n199:             if result[\"correct\"] is not True:\n200:                 raise ForestError(\n201:                     \"Baseline failed validation; inspect evidence before starting a new campaign\"\n202:                 )\n203:             return result\n204:         slot = self.db.reserve(\"search\", \"baseline\")\n205:         self.db.settle_tokens(slot, 0)\n206:         # Later epochs have a different exact base, in their own worktree.\n207:         path = self.root / \"repo\"\n208:         if git(path, \"rev-parse\", \"HEAD\") != epoch[\"base_commit\"]:\n209:             path = self.root / \"worktrees\" / f\"baseline-e{epoch['id']}\"\n210:             if not path.exists():\n211:                 make_worktree(\n212:                     self.root / \"repo\", path, f\"baseline/e{epoch['id']}\", epoch[\"base_commit\"]\n213:                 )\n214:         result = self.evaluator.evaluate(\n215:             f\"baseline-e{epoch['id']}\", epoch[\"id\"], path, epoch[\"base_commit\"], None\n216:         )\n217:         self.db.record_evaluation(f\"baseline-e{epoch['id']}\", epoch[\"id\"], \"search\", asdict(result))\n218:         if result.correct is not True:\n219:             raise ForestError(\"Baseline does not pass the protected correctness contract\")\n220:         with self.db.connection:\n221:             self.db.connection.execute(\n222:                 \"UPDATE epochs SET baseline_id=? WHERE id=?\",\n223:                 (f\"baseline-e{epoch['id']}\", epoch[\"id\"]),\n224:             )\n225:         return asdict(result)",
        "330:                 \"SELECT count(*) AS n FROM trials WHERE epoch=? AND role=? AND id<>?\",\n331:                 (epoch[\"id\"], mission.role, mission.id),\n332:             )[\"n\"]\n333:             mission.ordinal = count + 1\n334:         mission.worktree = str(self.root / \"worktrees\" / mission.id)\n335:         sources = self._sources(mission)\n336:         mission.sources = [c[\"id\"] for c in sources]\n337:         mission.source_commits = [c[\"commit\"] for c in sources]\n338:         self.search.update_mission(mission)\n339:         if mission.depth > self.config[\"budget\"][\"max_depth\"]:\n340:             self.search.finish(\n341:                 mission,\n342:                 Outcome(\"depth_limited\", reason=\"Selected search path exceeds configured depth\"),\n343:             )\n344:             self.db.settle_tokens(slot, 0)\n345:             return mission, {}, slot\n346:         branch = \"integration\" if mission.role == \"G\" else \"exp\"\n347:         branch += f\"/{self.config['problem']}/{mission.role}/{mission.id}\"\n348:         make_worktree(self.root / \"repo\", Path(mission.worktree), branch, mission.base_commit)\n349:         return mission, self._context(mission, sources), slot",
        "500:     def confirm(self) -> dict:\n501:         with FileLock(self.root / \"campaign.lock\"):\n502:             self._start()\n503:             epoch = self.epoch()\n504:             baseline_id = f\"baseline-e{epoch['id']}\"\n505:             if not epoch[\"baseline_id\"]:\n506:                 raise ForestError(\"Run and validate the baseline before confirmation\")\n507:             key = f\"confirmation_plan:{epoch['id']}\"\n508:             candidates = self.db.get(key)\n509:             if candidates is None:\n510:                 candidates = [{\"id\": baseline_id, \"commit\": epoch[\"base_commit\"], \"baseline\": True}]\n511:                 seen = {epoch[\"base_commit\"]}\n512:                 for candidate in self.db.archive(epoch[\"id\"]):\n513:                     if (\n514:                         candidate[\"commit\"] not in seen\n515:                         and len(candidates) < self.config[\"budget\"][\"confirmation_slots\"]\n516:                     ):\n517:                         candidates.append(\n518:                             {\n519:                                 \"id\": candidate[\"id\"],\n520:                                 \"commit\": candidate[\"commit\"],\n521:                                 \"baseline\": False,\n522:                             }\n523:                         )\n524:                         seen.add(candidate[\"commit\"])\n525:                 for candidate in candidates:\n526:                     candidate[\"slot_id\"] = self.db.reserve(\"confirmation\", candidate[\"id\"])\n527:                     path = self.root / \"worktrees\" / f\"confirm-e{epoch['id']}-{candidate['id']}\"\n528:                     candidate[\"worktree\"] = str(path)\n529:                     make_worktree(\n530:                         self.root / \"repo\",\n531:                         path,\n532:                         f\"confirm/e{epoch['id']}/{candidate['id']}\",\n533:                         candidate[\"commit\"],\n534:                     )\n535:                 self.db.set(key, candidates)\n536:             existing = self.db.evaluations(\"confirmation\", epoch[\"id\"])\n537:             if len(existing) < len(candidates):\n538:                 attempts_key = f\"confirmation_attempts:{epoch['id']}\"\n539:                 attempts = self.db.get(attempts_key, 0)\n540:                 if attempts > self.config[\"budget\"][\"infrastructure_retries\"]:\n541:                     raise InfrastructureError(\"Independent confirmation retry limit reached\")\n542:                 self.db.set(attempts_key, attempts + 1)\n543:                 outcomes = self.evaluator.confirm(candidates, epoch[\"id\"])"
      ]
    },
    "HPC-Forest/src/hpc_forest/gitops.py": {
      "sha256": "baaeb7657db9bbf3607b134b666836d0cb15ff863374dfc3033555e036d380a1",
      "numbered_excerpts": [
        "20:         return result.stdout if binary else result.stdout.strip()\n21:     except (OSError, subprocess.SubprocessError) as exc:\n22:         detail = getattr(exc, \"stderr\", \"\")\n23:         raise InfrastructureError(f\"Git command failed ({args[0]}): {detail or exc}\") from exc\n24: \n25: \n26: def initialize_source(source: Path, destination: Path) -> str:\n27:     if destination.exists():\n28:         raise ForestError(f\"Destination exists: {destination}\")\n29:     # Import a snapshot, never modify the caller's original checkout or copy its .git.\n30:     shutil.copytree(\n31:         source, destination, ignore=shutil.ignore_patterns(\".git\", \"__pycache__\", \"*.exe\", \"*.obj\")\n32:     )\n33:     git(destination, \"init\", \"-b\", \"main\")\n34:     git(destination, \"config\", \"user.name\", \"HPC Forest local controller\")\n35:     git(destination, \"config\", \"user.email\", \"controller@hpc-forest.invalid\")\n36:     git(destination, \"config\", \"core.autocrlf\", \"false\")\n37:     git(destination, \"add\", \".\")\n38:     git(destination, \"commit\", \"-m\", \"chore: preserve imported baseline\")\n39:     return git(destination, \"rev-parse\", \"HEAD\")\n40: \n41: \n42: def make_worktree(repo: Path, destination: Path, branch: str, commit: str) -> None:\n43:     git(repo, \"worktree\", \"add\", \"-b\", branch, str(destination), commit)\n44: "
      ]
    },
    "HPC-Forest/src/hpc_forest/primes_contract.py": {
      "sha256": "3cbdc18d2d81dec7ef28babd9d4a400c7e65488776069c2396000b5b99687ef0",
      "numbered_excerpts": [
        "97: def prepare_certified(package: Path, output: Path):\n98:     \"\"\"Allocated caller only. contracts.prepare is reused, then certified bytes gate readiness.\"\"\"\n99:     data = verify_preparation(package)\n100:     receipt = contracts.prepare(specification(data), data, output, probe_timeout=30)\n101:     rows = verify_resolved_expected(Path(receipt[\"validation\"]), data)\n102:     # The official file has its original relative name inside source/src/model-view.\n103:     if file_digest(Path(receipt[\"source\"]) / \"src/model-view/primetest.c\") != REFERENCE_SHA256:\n104:         raise InfrastructureError(\"The prepared official C changed\")\n105:     receipt.update(certified_expected_rows=rows, compiler_flags=COMPILER_FLAGS,\n106:                    certified_expected_compared_byte_for_byte=True, calibration=False,\n107:                    benchmark_origin=BENCHMARK_ORIGIN, native_model_calls=0)\n108:     atomic_json(output / \"certified-preparation-receipt.json\", receipt)\n109:     return receipt\n110: \n111: \n112: def prepare_runtime_reference(package: Path, output: Path, allocation: dict,\n113:                               source_zip_sha256: str, plan_sha256: str, qualification_ref: dict):\n114:     \"\"\"Fresh same-job official preparation; qualification timings are never imported.\"\"\"\n115:     preparation = prepare_certified(package, output / \"prepared\")\n116:     origin = {\"schema\": \"hpc-forest-primes-r2max-runtime-reference-v1\", \"verified\": True,\n117:               \"job_id\": allocation[\"job_id\"], \"allocation\": allocation,\n118:               \"source_zip_sha256\": source_zip_sha256, \"plan_sha256\": plan_sha256,\n119:               \"preparation_manifest_sha256\": PREPARATION_MANIFEST_SHA256,\n120:               \"reference_origin_is_current_allocation\": True,\n121:               \"qualification_timings_imported\": False, \"native_model_calls\": 0,\n122:               \"new_inputs_or_candidates\": 0, \"compiler_flags\": COMPILER_FLAGS,\n123:               \"prior_qualification_evidence_only\": qualification_ref,\n124:               \"preparation\": preparation}\n125:     atomic_json(output / \"runtime-reference-origin.json\", origin)"
      ]
    }
  },
  "facts": [
    "prepare_runtime_reference prepares the official source and scripts before create_workspace imports them into the repository.",
    "create_workspace initializes and commits the prepared source.",
    "Controller._baseline uses the central repository when HEAD already equals epoch base_commit.",
    "Child and confirmation worktrees are separately created from their declared commits.",
    "Archived baseline has four tracked files matching the baseline commit; its only extra files are the central .git metadata."
  ],

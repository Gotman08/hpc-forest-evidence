"""Restore all evidence bytes from the compact bundle and original official ZIPs."""
import hashlib
import json
import os
import sys
import tarfile
import zipfile
from pathlib import Path,PurePosixPath

def restore(bundle,sources,destination,selection=None):
    destination=destination.resolve()
    if destination.exists():
        raise ValueError("Refusing to overwrite an existing evidence directory")
    with tarfile.open(bundle,"r:gz") as archive:
        manifest=json.load(archive.extractfile("manifest.json"))
        if manifest["format"]!="marathon22-lossless-evidence-v1":
            raise ValueError("Unknown bundle format")
        for name,checksum in manifest["official_archives"].items():
            if hashlib.sha256((sources/name).read_bytes()).hexdigest()!=checksum:
                raise ValueError("Original ZIP checksum mismatch: "+name)
        destination.mkdir(parents=True)
        cache={}
        verified=0
        for item in manifest["files"]:
            if selection is not None and not selection(item):
                continue
            relative=PurePosixPath(item["path"])
            if relative.is_absolute() or ".." in relative.parts or "\\" in item["path"]:
                raise ValueError("Unsafe evidence path")
            target=destination.joinpath(*relative.parts)
            if not target.resolve().is_relative_to(destination):
                raise ValueError("Evidence path outside destination")
            if "official" in item:
                key=(item["official"]["archive"],item["official"]["member"])
                if key not in cache:
                    with zipfile.ZipFile(sources/key[0]) as z:
                        cache[key]=z.read(key[1])
                raw=cache[key]
            else:
                raw=archive.extractfile(item["blob"]).read()
            if len(raw)!=item["bytes"] or hashlib.sha256(raw).hexdigest()!=item["sha256"]:
                raise ValueError("Evidence content checksum mismatch: "+item["path"])
            target.parent.mkdir(parents=True,exist_ok=True)
            target.write_bytes(raw)
            verified+=1
            if os.name!="nt":
                target.chmod(item["mode"])
        (destination/"manifest-verifie.json").write_text(json.dumps(manifest,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
    return {"verified_files":verified,"available_files":len(manifest["files"]),"full_restore":selection is None,"runs":[r["name"] for r in manifest["runs"]],"destination":str(destination)}

if __name__=="__main__":
    print(json.dumps(restore(*map(Path,sys.argv[1:4])),ensure_ascii=False))

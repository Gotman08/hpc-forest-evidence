&py,&pz,&vx,&vy,&vz);\\n\\n  const int TILE = 64;\\n\\n  for (int iter = 0; iter < N_ITER; ++iter) {\\n    #pragma omp parallel\\n    {\\n      // Force computation: dynamic scheduling on tiles balances load.\\n      #pragma omp for schedule(dynamic,16)\\n      for (int i0 = 0; i0 < nbodies; i0 += TILE) {\\n        int i_end = i0 + TILE;\\n        if (i_end > nbodies) i_end = nbodies;\\n        int cnt = i_end - i0;\\n\\n        float fx[64], fy[64], fz[64];\\n        float xis[64], yis[64], zis[64];\\n\\n        for (int t = 0; t < cnt; ++t) {\\n          fx[t] = 0.0f;\\n          fy[t] = 0.0f;\\n          fz[t] = 0.0f;\\n          int idx = i0 + t;\\n          xis[t] = px[idx];\\n          yis[t] = py[idx];\\n          zis[t] = pz[idx];\\n        }\\n\\n#define ACCUM(jj) \\\\\\n    do { \\\\\\n      float pjx = px[jj]; \\\\\\n      float pjy = py[jj]; \\\\\\n      float pjz = pz[jj]; \\\\\\n      _Pragma(\\\"omp simd\\\") \\\\\\n      for (int t = 0; t < cnt; ++t) { \\\\\\n        float dx = pjx - xis[t]; \\\\\\n        float dy = pjy - yis[t]; \\\\\\n        float dz = pjz - zis[t]; \\\\\\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING; \\\\\\n        float inv_dist = 1.0f / sqrt(sqrd_dist); \\\\\\n        float inv_dist3 = inv_dist * inv_dist * inv_dist; \\\\\\n        fx[t] += dx * inv_dist3; \\\\\\n        fy[t] += dy * inv_dist3; \\\\\\n        fz[t] += dz * inv_dist3; \\\\\\n      } \\\\\\n    } while (0)\\n\\n        int j = 0;\\n        for (; j + 3 < nbodies; j += 4) {\\n          ACCUM(j);\\n          ACCUM(j+1);\\n          ACCUM(j+2);\\n          ACCUM(j+3);\\n        }\\n        for (; j < nbodies; ++j) {\\n          ACCUM(j);\\n        }\\n#undef ACCUM\\n\\n        // Update velocities within this tile.\\n        for (int t = 0; t < cnt; ++t) {\\n          int idx = i0 + t;\\n          vx[idx] += DT * fx[t];\\n          vy[idx] += DT * fy[t];\\n          vz[idx] += DT * fz[t];\\n        }\\n      }\\n\\n      // Position update: static schedule.\\n      #pragma omp for schedule(static)\\n      for (int i = 0; i < nbodies; ++i) {\\n        px[i] += vx[i] * DT;\\n        py[i] += vy[i] * DT;\\n        pz[i] += vz[i] * DT;\\n      }\\n    }\\n  }\\n\\n  write_dataset(nbodies, px, py, pz, vx, vy, vz);\\n\\n  free(px); free(py); free(pz);\\n  free(vx); free(vy); free(vz);\\n  exit(EXIT_SUCCESS);\\n}\\n\",\n      \"path\": \"src/nbody.c\"\n    }\n  ],\n  \"hypothesis\": \"Combining SoA layout, restrict pointers, tiled force computation with unrolled inner loop and omp simd accumulation, hoisted per-tile positions, dynamic scheduling on tiles, and inlined body_force into a single OpenMP parallel region will yield better speedup than any individual transformation.\",\n  \"notes\": \"The implementation preserves exact floating-point summation order per body: the j-loop is unrolled by 4 but each ACCUM call processes contributions sequentially for every i within a tile. The omp simd pragma vectorizes across independent i values without changing per-i reduction order. Dynamic scheduling on tiles balances load while static scheduling handles the trivial position update.\",\n  \"sources_kept\": [\n    \"9a9c266ca15a4f13\",\n    \"24cc45682d584649\",\n    \"9adc054f311d4298\"\n  ],\n  \"transformations\": [\n    \"Integrated SoA layout from B with restrict qualifiers and tiled force computation from A, including unrolled inner j-loop by 4 and omp simd on the per-body accumulation loop.\",\n    \"Hoisted per-tile position loads into local arrays (xis/yis/zis) to reduce memory traffic, as suggested by B's hoisting idea.\",\n    \"Inlined body_force into main with a single #pragma omp parallel region per iteration and used dynamic schedule(16) for the force tile loop and static schedule for the position update, following C's scheduling strategy.\"\n  ]\n}",

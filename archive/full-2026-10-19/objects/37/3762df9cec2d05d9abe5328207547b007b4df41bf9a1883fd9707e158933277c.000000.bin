from pathlib import Path
import json,hashlib,time,datetime
C=Path("outputs/HPC-Forest-Etude-2020-2024-r1/receptions/interruption-volontaire-sol-xhigh-751571").resolve()
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def load(p):return json.loads(p.read_text(encoding="utf-8-sig"))
a=C/"audit-partiel-r2/audit-partiel.json";v=load(a)
assert v["verified"] and v["human_stop"] and v["all_started_claims_reconciled"] and v["pending_nonces"]==[]
assert v["published_requests"]==v["delivered_requests"]==v["native_invocations_observed"]==9 and not v["full_planned_cohort_admitted"]
manifest=load(C/"capture-cache-post-drain-r1/MANIFESTE-CACHE-FICHIERS.json")["files"]
w=C.parents[1]/"runs/coverage-gpt-6.1-sol-xhigh/worker"
got={p.relative_to(w).as_posix():{"bytes":p.stat().st_size,"sha256":sha(p)} for p in w.rglob("*") if p.is_file() and p.name!="worker.lock"}
assert got==manifest
old=load(C/"cim-avant-reception-partielle.json");now=load(C/"cim-apres-audit-avant-arret.json")
o={r["ProcessId"]:r for r in old};n={r["ProcessId"]:r for r in now}
keys=["ProcessId","ParentProcessId","CreationDate","ExecutablePath","CommandLine"]
targets=[14612,12988,11112,6252,24964,26136,27240]
assert all(all(o[i][k]==n[i][k] for k in keys) for i in targets)
assert "hpc_forest.matrix_worker" in n[14612]["CommandLine"] and "445f72b190204fc08e02a578205b4ef4" in n[14612]["CommandLine"]
assert all(n[i]["CommandLine"]==r"C:\Users\nicol\romeo-mcp\.venv\Scripts\python.exe -m romeo_mcp" for i in [6252,11112])
family={12988}
for _ in range(12):
 for r in now:
  if r["ParentProcessId"] in family and r["ParentProcessId"] in n and datetime.datetime.fromisoformat(r["CreationDate"])>=datetime.datetime.fromisoformat(n[r["ParentProcessId"]]["CreationDate"]):family.add(r["ProcessId"])
assert family==set(targets),family-set(targets)
assert n[37900]["CommandLine"].find("665743a02b824021a697b6a4884a667c")>=0 and n[37848]["ParentProcessId"]==37900
plan={"schema":"hpc-forest-specific-owned-individual-stop-plan-v1","prepared_at":time.time(),"human_authorized":True,"job_id":"751571","session_id":"445f72b190204fc08e02a578205b4ef4","partial_audit_path":str(a),"partial_audit_sha256":sha(a),"after_audit":True,"after_reconciliation":True,"original_cache_reverified_files":len(got),"owned_targets_in_stop_order":[n[i] for i in targets],"preserve_source_only_relay_identities":[n[i] for i in [37900,37848]],"no_recursive_stop":True,"no_stop_by_name":True,"foreign_processes_targeted":False}
p=C/"plan-arret-individuel.json";p.write_text(json.dumps(plan,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
print(json.dumps({"plan":str(p),"sha256":sha(p),"targets":targets,"after_audit":True,"reconciled_requests":9,"source_only_preserved":[37900,37848]}))

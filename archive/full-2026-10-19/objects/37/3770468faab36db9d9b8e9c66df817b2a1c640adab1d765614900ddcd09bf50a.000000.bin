g final vector repeats identical bytes.\\n+#if defined(__aarch64__) && defined(__ARM_NEON)\\n+        const unsigned char* input = reinterpret_cast<const unsigned char*>(source);\\n+        unsigned char* output = reinterpret_cast<unsigned char*>(destination);\\n+        if (count >= 16) {\\n+            const std::size_t last = count - 16;\\n+            for (std::size_t i = 0; i < last; i += 16) {\\n+                vst1q_u8(output + i, vld1q_u8(input + i));\\n+            }\\n+            vst1q_u8(output + last, vld1q_u8(input + last));\\n+            return;\\n+        }\\n+        if (count >= 8) {\\n+            vst1_u8(output, vld1_u8(input));\\n+            if (count != 8) {\\n+                const std::size_t last = count - 8;\\n+                vst1_u8(output + last, vld1_u8(input + last));\\n+            }\\n+            return;\\n+        }\\n+#endif\\n+        std::memcpy(destination, source, count);\\n+    }\\n+\\n+    static bool next_record(char* record, std::size_t last_symbol)\\n+    {\\n+        // Symbols occupy offsets 2, 4, ..., last_symbol. Compare native char\\n+        // values, exactly as std::next_permutation does for std::string.\\n+        std::size_t suffix = last_symbol;\\n+        while (suffix > 2 && !(record[suffix - 2] < record[suffix])) {\\n+            suffix -= 2;\\n+        }\\n+        if (suffix == 2) return false;\\n+\\n+        const std::size_t pivot = suffix - 2;\\n+        std::size_t successor = last_symbol;\\n+        while (!(record[pivot] < record[successor])) {\\n+            successor -= 2;\\n+        }\\n+        std::swap(record[pivot], record[successor]);\\n+\\n+        std::size_t right = last_symbol;\\n+        while (suffix < right) {\\n+            std::swap(record[suffix], record[right]);\\n+            suffix += 2;\\n+            right -= 2;\\n+        }\\n+        return true;\\n+    }\\n+\\n+    void append_pair(char first, char second)\\n+    {\\n+        if (capacity - used_ < 2) flush();\\n+        buffer_[used_++] = first;\\n+        buffer_[used_++] = second;\\n+    }\\n+\\n+public:\\n+    PrintPermutation() : used_(0) {}\\n+\\n+    void flush()\\n+    {\\n+        if (used_ != 0) {\\n+            std::cout.write(buffer_, static_cast<std::streamsize>(used_));\\n+            used_ = 0;\\n+        }\\n+    }\\n+\\n+    void operator()(const std::string& text)\\n+    {\\n+        append_pair('[', ' ');\\n+        const char* source = text.data();\\n+        std::size_t remaining = text.size();\\n+        while (remaining != 0) {\\n+            std::size_t available = (capacity - used_) / 2;\\n+            if (available == 0) {\\n+                flush();\\n+                available = capacity / 2;\\n+            }\\n+            const std::size_t count = std::min(remaining, available);\\n+            interleave(source, count, buffer_ + used_);\\n+            used_ += 2 * count;\\n+            source += count;\\n+            remaining -= count;\\n+        }\\n+        append_pair(']', '\\\\n');\\n+    }\\n+\\n+    void permutations(std::string& text)\\n+    {\\n+        if (text.empty()) return;\\n+\\n+        // Keep the existing streaming path for records larger than the buffer.\\n+        // Check before multiplying so record-size arithmetic cannot overflow.\\n+        if (text.size() > (capacity - 4) / 2) {\\n+            do {\\n+                (*this)(text);\\n+            } while (std::next_permutation(text.begin(), text.end()));\\n+            return;\\n+        }\\n+\\n+        flush();\\n+        const std::size_t last_symbol = 2 * text.size();\\n+        const std::size_t record_size = last_symbol + 4;\\n+        buffer_[0] = '[';\\n+        buffer_[1] = ' ';\\n+        interleave(text.data(), text.size(), buffer_ + 2);\\n+        buffer_[record_size - 2] = ']';\\n+        buffer_[record_size - 1] = '\\\\n';\\n+        used_ = record_size;\\n+        char* current = buffer_;\\n+\\n+        for (;;) {\\n+            if (capacity - used_ < record_size)
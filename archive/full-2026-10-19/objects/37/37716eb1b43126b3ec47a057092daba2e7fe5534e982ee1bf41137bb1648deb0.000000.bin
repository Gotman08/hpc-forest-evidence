{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n#include <float.h>\\n#include <limits.h>\\n#include <stdint.h>\\n#include <string.h>\\n\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\nstatic char vote_winner(const size_t *votes) {\\n    char winner = (char)-1;\\n    size_t best_count = 0;\\n    for (int label = CHAR_MIN; label <= CHAR_MAX; label++) {\\n        size_t count = votes[(unsigned char)(char)label];\\n        if (count > best_count) {\\n            best_count = count;\\n            winner = (char)label;\\n        }\\n    }\\n    return winner;\\n}\\n\\nstatic char insertion_knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n    char *labels = (char *)malloc((size_t)k * sizeof(*labels));\\n    float *distances = (float *)malloc((size_t)k * sizeof(*distances));\\n\\n    for (int i = 0; i < k; i++) {\\n        labels[i] = (char)-1;\\n        distances[i] = -1.0f;\\n    }\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        const Group *g = &groups[i];\\n        for (int j = 0; j < g->length; j++) {\\n            float d = euclidean_distance_no_sqrt(to_evaluate, g->points[j]);\\n            float worst = distances[k - 1];\\n            if (worst != -1.0f && d >= worst) {\\n                continue;\\n            }\\n\\n            int insertion = k;\\n#ifdef _OPENMP\\n            #pragma omp simd reduction(min: insertion)\\n#endif\\n            for (int x = 0; x < k; x++) {\\n                int candidate = (d < distances[x] || distances[x] == -1.0f)\\n                              ? x : k;\\n                if (candidate < insertion) {\\n                    insertion = candidate;\\n                }\\n            }\\n\\n            if (insertion < k) {\\n                size_t count = (size_t)(k - insertion - 1);\\n                if (count != 0) {\\n                    memmove(distances + insertion + 1, distances + insertion,\\n                            count * sizeof(*distances));\\n                    memmove(labels + insertion + 1, labels + insertion,\\n                            count * sizeof(*labels));\\n                }\\n                distances[insertion] = d;\\n                labels[insertion] = g->label;\\n            }\\n        }\\n    }\\n\\n    size_t votes[UCHAR_MAX + 1] = {0};\\n    for (int i = 0; i < k; i++) {\\n        votes[(unsigned char)labels[i]]++;\\n    }\\n    free(distances);\\n    free(labels);\\n    return vote_winner(votes);\\n}\\n\\nstatic uint32_t distance_key(Point a, Point b) {\\n    float distance = euclidean_distance_no_sqrt(a, b);\\n    uint32_t key;\\n    memcpy(&key, &distance, sizeof(key));\\n    return key & UINT32_C(0x7fffffff);\\n}\\n\\nstatic char radix_knn(int n_groups, Group *groups, int k,\\n                      Point to_evaluate, size_t total) {\\n    uint32_t *keys = (uint32_t *)malloc(total * sizeof(*keys));\\n    if (keys == NULL) {\\n        return insertion_knn(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    size_t histogram[256] = {0};\\n    size_t position = 0;\\n    unsigned int has_nan = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        const Group *g = &groups[i];\\n        for (int j = 0; j < g->length; j++) {\\n            uint32_t key = distance_key(to_evaluate, g->points[j]);\\n            keys[position++] = key;\\n            histogram[key >> 24]++;\\n            has_nan |= key > UINT32_C(0x7f800000);\\n        }\\n    }\\n    if (has_nan) {\\n        free(keys);\\n        return insertion_knn(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    size_t remaining = (size_t)k;\\n    uint32_t prefix = 0;\\n    uint32_t mask = 0;\\n    uint32_t cutoff = 0;\\n    int whole_bucket = 0;\\n\\n    for (int shift = 24; shift >= 0; shift -= 8) {\\n        unsigned int bucket = 0;\\n        while (remaining > histogram[bucket]) {\\n            remaining -= histogram[bucket];\\n            bucket++;\\n        }\\n        prefix |= (uint32_t)bucket << shift;\\n        mask |= UINT32_C(0xff) << shift;\\n        cutoff = prefix | ~mask;\\n\\n        if (remaining == histogram[bucket]) {\\n            whole_bucket = 1;\\n            break;\\n        }\\n        if (shift == 0) {\\n            break;\\n        }\\n\\n        memset(histogram, 0, sizeof(histogram));\\n        int next_shift = shift - 8;\\n        for (size_t p = 0; p < total; p++) {\\n            uint32_t key = keys[p];\\n            if ((key & mask) == prefix) {\\n                histogram[(key >> next_shift) & UINT32_C(0xff)]++;\\n            }\\n        }\\n    }\\n\\n    size_t votes[UCHAR_MAX + 1] = {0};\\n    position = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        const Group *g = &groups[i];\\n        if (g->length <= 0) {\\n            continue;\\n        }\\n        size_t end = position + (size_t)g->length;\\n        if (whole_bucket) {\\n            size_t selected = 0;\\n#ifdef _OPENMP\\n            #pragma omp simd reduction(+: selected)\\n#endif\\n            for (size_t p = position; p < end; p++) {\\n                selected += keys[p] <= cutoff;\\n            }\\n            votes[(unsigned char)g->label] += selected;\\n        } else {\\n            size_t below = 0;\\n            size_t equal = 0;\\n#ifdef _OPENMP\\n            #pragma omp simd reduction(+: below, equal)\\n#endif\\n            for (size_t p = position; p < end; p++) {\\n                below += keys[p] < cutoff;\\n                equal += keys[p] == cutoff;\\n            }\\n            size_t take = equal < remaining ? equal : remaining;\\n            remaining -= take;\\n            votes[(unsigned char)g->label] += below + take;\\n        }\\n        position = end;\\n    }\\n\\n    free(keys);\\n    return vote_winner(votes);\\n}\\n\\n#ifdef _OPENMP\\ntypedef struct {\\n    size_t begin;\\n    size_t end;\\n    size_t lo;\\n    size_t hi;\\n    size_t lower;\\n    size_t upper;\\n    size_t take_equal;\\n    unsigned int has_nan;\\n    size_t votes[UCHAR_MAX + 1];\\n} KnnRankPart;\\n\\nstatic int key_compare(const void *a, const void *b) {\\n    uint32_t x = *(const uint32_t *)a;\\n    uint32_t y = *(const uint32_t *)b;\\n    return (x > y) - (x < y);\\n}\\n\\nstatic uint32_t rank_pivot(const uint32_t *values, const KnnRankPart *parts,\\n                           int part_count, int sorted) {\\n    int chosen = 0;\\n    size_t largest = 0;\\n    for (int p = 0; p < part_count; p++) {\\n        size_t length = parts[p].hi - parts[p].lo;\\n        if (length > largest) {\\n            largest = length;\\n            chosen = p;\\n        }\\n    }\\n\\n    size_t lo = parts[chosen].lo;\\n    size_t hi = parts[chosen].hi;\\n    uint32_t b = values[lo + (hi - lo) / 2];\\n    if (sorted) {\\n        return b;\\n    }\\n    uint32_t a = values[lo];\\n    uint32_t c = values[hi - 1];\\n    if (a > b) {\\n        uint32_t temporary = a;\\n        a = b;\\n        b = temporary;\\n    }\\n    if (b > c) {\\n        b = c;\\n    }\\n    if (a > b) {\\n        b = a;\\n    }\\n    return b;\\n}\\n\\n/* Return zero on setup failure, negative for NaNs, and positive on success. */\\nstatic int parallel_rank_knn(int n_groups, Group *groups, int k,\\n                             Point to_evaluate, size_t total,\\n                             int workers, char *result) {\\n    uint32_t *keys = (uint32_t *)malloc(total * sizeof(*keys));\\n    uint32_t *work = (uint32_t *)malloc(total * sizeof(*work));\\n    KnnRankPart *parts = (KnnRankPart *)calloc((size_t)workers, sizeof(*parts));\\n    if (keys == NULL || work == NULL || parts == NULL) {\\n        free(parts);\\n        free(work);\\n        free(keys);\\n        return 0;\\n    }\\n\\n    int part_count = 0;\\n    int invalid = 0;\\n    int done = 0;\\n    int sorted = 0;\\n    int sort_now = 0;\\n    unsigned int rounds = 0;\\n    size_t rank = (size_t)k - 1;\\n    uint32_t pivot = 0;\\n    uint32_t cutoff = 0;\\n\\n    #pragma omp parallel num_threads(workers)\\n    {\\n        int thread = omp_get_thread_num();\\n        #pragma omp single\\n        {\\n            part_count = omp_get_num_threads();\\n        }\\n\\n        KnnRankPart *part = &parts[thread];\\n        size_t t = (size_t)thread;\\n        size_t chunk = total / (size_t)part_count;\\n        size_t extra = total % (size_t)part_count;\\n        part->begin = t * chunk + (t < extra ? t : extra);\\n        part->end = part->begin + chunk + (t < extra);\\n        part->lo = part->begin;\\n        part->hi = part->end;\\n\\n        size_t base = 0;\\n        unsigned int has_nan = 0;\\n        for (int i = 0; i < n_groups && base < part->end; i++) {\\n            const Group *g = &groups[i];\\n            if (g->length <= 0) {\\n                continue;\\n            }\\n            size_t next = base + (size_t)g->length;\\n            if (next > part->begin) {\\n                size_t first = part->begin > base ? part->begin - base : 0;\\n                size_t last = part->end < next\\n                            ? part->end - base : (size_t)g->length;\\n                for (size_t j = first; j < last; j++) {\\n                    uint32_t key = distance_key(to_evaluate, g->points[j]);\\n                    keys[base + j] = key;\\n                    work[base + j] = key;\\n                    has_nan |= key > UINT32_C(0x7f800000);\\n                }\\n            }\\n            base = next;\\n        }\\n        part->has_nan = has_nan;\\n\\n        #pragma omp barrier\\n        #pragma omp single\\n        {\\n            for (int p = 0; p < part_count; p++) {\\n                if (parts[p].has_nan) {\\n                    invalid = 1;\\n                }\\n            }\\n            if (invalid) {\\n                done = 1;\\n            } else {\\n                pivot = rank_pivot(work, parts, part_count, sorted);\\n            }\\n        }\\n\\n        while (!done) {\\n            if (sorted) {\\n                size_t lo = part->lo;\\n                size_t hi = part->hi;\\n                while (lo < hi) {\\n                    size_t middle = lo + (hi - lo) / 2;\\n                    if (work[middle] < pivot) {\\n                        lo = middle + 1;\\n                    } else {\\n                        hi = middle;\\n                    }\\n                }\\n                part->lower = lo;\\n                hi = part->hi;\\n                while (lo < hi) {\\n                    size_t middle = lo + (hi - lo) / 2;\\n                    if (work[middle] <= pivot) {\\n                        lo = middle + 1;\\n                    } else {\\n                        hi = middle;\\n                    }\\n                }\\n                part->upper = lo;\\n            } else {\\n                size_t lower = part->lo;\\n                size_t scan = lower;\\n                size_t upper = part->hi;\\n                while (scan < upper) {\\n                    uint32_t value = work[scan];\\n                    if (value < pivot) {\\n                        work[scan] = work[lower];\\n                        work[lower] = value;\\n                        lower++;\\n                        scan++;\\n                    } else if (value > pivot) {\\n                        upper--;\\n                        work[scan] = work[upper];\\n                        work[upper] = value;\\n                    } else {\\n                        scan++;\\n                    }\\n                }\\n                part->lower = lower;\\n                part->upper = upper;\\n            }\\n\\n            #pragma omp barrier\\n            #pragma omp single\\n            {\\n                size_t below = 0;\\n                size_t equal = 0;\\n                for (int p = 0; p < part_count; p++) {\\n                    below += parts[p].lower - parts[p].lo;\\n                    equal += parts[p].upper - parts[p].lower;\\n                }\\n\\n                if (rank < below) {\\n                    for (int p = 0; p < part_count; p++) {\\n                        parts[p].hi = parts[p].lower;\\n                    }\\n                } else if (rank - below < equal) {\\n                    cutoff = pivot;\\n                    size_t remaining = rank - below + 1;\\n                    for (int p = 0; p < part_count; p++) {\\n                        size_t available = parts[p].upper - parts[p].lower;\\n                        size_t take = available < remaining ? available : remaining;\\n                        parts[p].take_equal = take;\\n                        remaining -= take;\\n                    }\\n                    done = 1;\\n                } else {\\n                    rank -= below + equal;\\n                    for (int p = 0; p < part_count; p++) {\\n                        parts[p].lo = parts[p].upper;\\n                    }\\n                }\\n\\n                if (!done) {\\n                    rounds++;\\n                    sort_now = !sorted && rounds == 32;\\n                    if (!sort_now) {\\n                        pivot = rank_pivot(work, parts, part_count, sorted);\\n                    }\\n                }\\n            }\\n\\n            if (!done && sort_now) {\\n                size_t length = part->hi - part->lo;\\n                if (length > 1) {\\n                    qsort(work + part->lo, length, sizeof(*work), key_compare);\\n                }\\n                #pragma omp barrier\\n                #pragma omp single\\n                {\\n                    sorted = 1;\\n                    sort_now = 0;\\n                    pivot = rank_pivot(work, parts, part_count, sorted);\\n                }\\n            }\\n        }\\n\\n        if (!invalid) {\\n            size_t remaining = part->take_equal;\\n            base = 0;\\n            for (int i = 0; i < n_groups && base < part->end; i++) {\\n                const Group *g = &groups[i];\\n                if (g->length <= 0) {\\n                    continue;\\n                }\\n                size_t next = base + (size_t)g->length;\\n                if (next > part->begin) {\\n                    size_t first = part->begin > base ? part->begin : base;\\n                    size_t last = part->end < next ? part->end : next;\\n                    size_t below = 0;\\n                    size_t equal = 0;\\n                    #pragma omp simd reduction(+: below, equal)\\n                    for (size_t p = first; p < last; p++) {\\n                        below += keys[p] < cutoff;\\n                        equal += keys[p] == cutoff;\\n                    }\\n                    size_t take = equal < remaining ? equal : remaining;\\n                    remaining -= take;\\n                    part->votes[(unsigned char)g->label] += below + take;\\n                }\\n                base = next;\\n            }\\n        }\\n    }\\n\\n    if (invalid) {\\n        free(parts);\\n        free(work);\\n        free(keys);\\n        return -1;\\n    }\\n\\n    size_t votes[UCHAR_MAX + 1] = {0};\\n    for (int p = 0; p < part_count; p++) {\\n        for (size_t label = 0; label < sizeof(votes) / sizeof(votes[0]); label++) {\\n            votes[label] += parts[p].votes[label];\\n        }\\n    }\\n    *result = vote_winner(votes);\\n    free(parts);\\n    free(work);\\n    free(keys);\\n    return 1;\\n}\\n#endif\\n\\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n    if (k <= 0) {\\n        return (char)-1;\\n    }\\n\\n    size_t total = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        if (groups[i].length > 0) {\\n            size_t length = (size_t)groups[i].length;\\n            if (length > SIZE_MAX - total) {\\n                return insertion_knn(n_groups, groups, k, to_evaluate);\\n            }\\n            total += length;\\n        }\\n    }\\n\\n    if (total <= (size_t)k) {\\n        size_t votes[UCHAR_MAX + 1] = {0};\\n        votes[(unsigned char)(char)-1] = (size_t)k - total;\\n        for (int i = 0; i < n_groups; i++) {\\n            if (groups[i].length > 0) {\\n                votes[(unsigned char)groups[i].label] += (size_t)groups[i].length;\\n            }\\n        }\\n        return vote_winner(votes);\\n    }\\n\\n    if (k <= 64) {\\n        return insertion_knn(n_groups, groups, k, to_evaluate);\\n    }\\n    if (sizeof(float) != sizeof(uint32_t) || FLT_RADIX != 2 ||\\n        FLT_MANT_DIG != 24 || FLT_MAX_EXP != 128 ||\\n        total > SIZE_MAX / sizeof(uint32_t)) {\\n        return insertion_knn(n_groups, groups, k, to_evaluate);\\n    }\\n\\n#ifdef _OPENMP\\n    if (!omp_in_parallel()) {\\n        int workers = omp_get_max_threads();\\n        if (workers > 4) {\\n            workers = 4;\\n        }\\n        size_t useful_workers = total / 8192;\\n        if (useful_workers < (size_t)workers) {\\n            workers = (int)useful_workers;\\n        }\\n        if (workers > 1) {\\n            char result;\\n            int status = parallel_rank_knn(n_groups, groups, k, to_evaluate,\\n                                           total, workers, &result);\\n            if (status > 0) {\\n                return result;\\n            }\\n            if (status < 0) {\\n                return insertion_knn(n_groups, groups, k, to_evaluate);\\n            }\\n        }\\n    }\\n#endif\\n\\n    return radix_knn(n_groups, groups, k, to_evaluate, total);\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Combining small-k SIMD insertion, serial radix selection, and persistent-team distributed selection should retain the archived speedups across different workload sizes.\",\n  \"notes\": \"Parsing and output remain unchanged. NaNs use reference-order insertion; distance ties, char-order voting ties, and unfilled sentinel votes are preserved. No commands or measurements performed.\",\n  \"research\": {\n    \"queries\": [],\n    \"urls\": []\n  },\n  \"sources_kept\": [\n    \"3e7a7ab0e72a4bba\",\n    \"199cc8d56a8f4062\",\n    \"2de2f2ce2b9649c3\"\n  ],\n  \"transformations\": [\n    \"Retain contiguous binary32 distance keys and at most four radix stages with whole-bucket exits for serial selection.\",\n    \"Use ordered worst-entry rejection, SIMD minimum-index insertion, and overlap-safe memmove for small k and reference-order fallbacks.\",\n    \"For larger selections, use one OpenMP team with at most four workers for distance generation, distributed three-way partitioning, and label counting.\",\n    \"After 32 partition rounds, sort active slices and continue with binary searches; resolve cutoff ties using original-order partition budgets and SIMD per-group histograms.\"\n  ]\n}"}}

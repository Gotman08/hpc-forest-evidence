          ],
          "retained": [
            "Replace dependency-carrying bubble passes on ARM64 with odd-even phases processing two independent adjacent pairs per NEON vector.",
            "Use strict comparison masks and bitwise selection to preserve stable ordering, including signed zeros; retain the original bubble sort for NaN-containing columns and non-NEON targets.",
            "Handle remaining pairs scalarly and terminate after consecutive even and odd phases make no exchanges."
          ]
        },

"""Closed cold reader bridge and local evidence factory dependencies, lane-r2."""
from __future__ import annotations

import hashlib
import importlib.util
import json
import sys
import time
import zipfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
PREP = HERE.parents[1]
BASE = HERE.parents[3]
FACTORY_ROOT = HERE / "launcher"
CACHE_ROOT = PREP / "lancement-modeles-max-r3"
READER_ROOT = HERE / "reader"
SOURCE_ROOT = BASE / "work/hpc-forest-mere-dynamique-r4b-lane-r3/project"
SCOPE = "hpc-forest-dynamic-independent-roots-r4b-max"
SOURCE = "eaff9217499fe268e4d151165a368a83bad1550d921955a9f9256026cfac2d48"
PLAN = "d08ac00bcfb75625a24971b2684d7479c4da7a98b339e4e10eae5b9ac525ef27"
MODELS = ("gpt-6.1-sol", "gpt-6-astra", "gpt-5.6-terra")
PHASES = ("roots", "advice", "harvest")
BEGUN_JOBS = {"751592", "751992", "752139", "752140", "752141", "752306"}
REF_NAMES = {"agent_result", "cell_binding", "claim", "cli_identity", "delivered", "execution_sidecar",
             "invocation", "jsonl", "process", "ready", "request_downloaded", "request_native", "response", "worker_ready"}
EXPECTED_NAMES = {"effort", "job_id", "model", "phase", "plan_sha256", "request_digest", "request_sha256",
                  "scope", "session_id", "source_cache", "source_zip_sha256"}


def module(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    value = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(value)
    return value


contract = module("lane_r2_chain_contract", HERE / "chain_contract.py")
need, artifact, read, sha = contract.need, contract.artifact, contract.read, contract.sha


def same(left, right):
    return json.dumps(left, sort_keys=True, allow_nan=False) == json.dumps(right, sort_keys=True, allow_nan=False)


def verify_dependencies():
    manifest = json.loads((HERE / "COMPONENTS.json").read_text(encoding="utf8"))
    need(manifest.get("schema") == "hpc-forest-lane-r3-chain-components-v1"
         and manifest.get("source_zip_sha256") == SOURCE and manifest.get("plan_sha256") == PLAN,
         "Wrong integration manifest")
    for name, checksum in manifest["code_pins"].items():
        path = HERE / name
        need(not Path(name).is_absolute() and ".." not in Path(name).parts and sha(path) == checksum,
             "Integration dependency changed before import")
    abi = json.loads((HERE / "READER-INTEGRATION-ABI.json").read_text(encoding="utf8"))
    need(set(abi["ref_names_exact"]) == REF_NAMES and set(abi["expected_names_exact"]) == EXPECTED_NAMES
         and abi["ref_count"] == 14 and abi["expected_count"] == 11
         and abi["historical_luna_supported"] is False and abi["supported_pilot_phases"] == []
         and abi["prior_full_cim_required"] is True and abi["lane_projection_revalidated_initial_false"] is True,
         "Strict refs14/expected11, prior-presence and lane-v2 ABI required")
    contract.local_delta(HERE)
    return manifest


def source_modules():
    verify_dependencies()
    pins = json.loads((FACTORY_ROOT / "pins-source-plan.json").read_text(encoding="utf8"))
    need(pins["source_zip"]["sha256"] == SOURCE and pins["plan"]["sha256"] == PLAN
         and Path(pins["source_project"]) == SOURCE_ROOT and pins.get("source_files") == 110,
         "Exact isolated source110 required")
    source = artifact(pins["source_zip"])
    plan = read(pins["plan"])
    review = read(pins["independent_source_review"])
    need(pins["independent_source_review"]["sha256"] == "58a08df4fcccdf9b91a39ddacecb95f65b66fb90855298a470e40e01ec1bab2d"
         and review.get("verified_source_preparation_only") is True and review.get("blocking_findings") == [], "Actual source110 review required")
    contract.source_review(review)
    expected = read(pins["source_manifest"])
    paths = list(SOURCE_ROOT.rglob("*"))
    need(not any(p.is_symlink() or getattr(p, "is_junction", lambda: False)() for p in (SOURCE_ROOT, *paths)),
         "Source filesystem alias refused")
    actual = {p.relative_to(SOURCE_ROOT).as_posix(): sha(p) for p in paths if p.is_file()}
    with zipfile.ZipFile(source) as archive:
        members = [m for m in archive.infolist() if not m.is_dir()]
        zipped = {m.filename.removeprefix("HPC-Forest/"): hashlib.sha256(archive.read(m)).hexdigest() for m in members}
        need(actual == expected == zipped and len(actual) == len(members) == 110
             and all(m.filename.startswith("HPC-Forest/") for m in members), "Exact source110/ZIP/manifest mismatch")
    need(plan["source_zip_sha256"] == SOURCE and plan.get("contract_cells") == pins["contract_cells"]
         and pins.get("pilot_admitted") is False, "Nine exact technical MAX cells only")
    src = SOURCE_ROOT / "src"
    for name, loaded in sys.modules.items():
        if name == "hpc_forest" or name.startswith("hpc_forest."):
            need(getattr(loaded, "__file__", None) is not None and Path(loaded.__file__).resolve().is_relative_to(src),
                 "Another hpc_forest source already imported")
    sys.dont_write_bytecode = True
    sys.path.insert(0, str(src))
    from hpc_forest import dynamic_admission
    return pins, dynamic_admission


def check_qualification(ref):
    verify_dependencies()
    # Q remains bound, without mutation, to its actual allocated base bytes.
    # The active Windows-only delta is a distinct complete review/manifest graph.
    qualified = contract.local_delta(HERE)
    return contract.qualification(ref, components_manifest_sha256=qualified["qualified_components_sha256"])


def integration_review(ref):
    verify_dependencies()
    return contract.integration_review(ref, HERE)


def produce_projection(inputs, cell, source_state_binding, *, now=None):
    """Only the new reviewed SO reader may supply actual private facts."""
    verify_dependencies()
    now = time.time() if now is None else now
    binding = read(source_state_binding)
    need(set(binding) == {"schema", "revision", "reader", "current_verifier", "independent_review"}
         and binding["schema"] == "hpc-forest-lane-r2-source-state-binding-v2"
         and binding["revision"] == "r4-full-identity-post-cold-disappearance-bound",
         "Versioned post-cold-disappearance reader binding required")
    expected = BASE / "outputs/HPC-Forest-Primes-Natif-Lancement-r2d/source-only-reader-r4/source_only_state.py"
    verifier = expected.with_name("verifier-current.py")
    review_path = BASE / "outputs/HPC-Forest-Primes-Natif-Relance-r2d/revue-recyclage-pid/REVUE-LECTEUR-R4.json"
    need(binding["reader"]["sha256"] == "564398d676dceb6b5ba893fcbb3835c7aec31a1cbd5d5c5dcef6b361a3a23338"
         and artifact(binding["reader"]) == expected
         and binding["current_verifier"]["sha256"] == "ed888a9ab9c35e4e1a6c227525e9578281ed57c6961ccd9c9928eb397f62e450"
         and artifact(binding["current_verifier"]) == verifier
         and binding["independent_review"] == {"path": str(review_path), "sha256": "9c44954538a8e21fb5d16df3e493bf1b37ba64d1e81cb7b1aef6ef6605db1c36"},
         "Only the exact independently reviewed reader/current verifier may supply private facts")
    review = read(binding["independent_review"])
    need(review.get("verified_source_preparation_only") is True and review.get("blocking_findings") == []
         and review.get("source_state_reader_sha256") == binding["reader"]["sha256"]
         and review.get("reviewed_files", {}).get("verifier-current.py") == binding["current_verifier"]["sha256"],
         "Actual separate source-state command-identity review required")
    _, admission = source_modules()
    producer = module("lane_r2_bound_projection", HERE / "lane_projection.py")
    producer.DEPENDENCIES["source_state"] = (expected, binding["reader"]["sha256"])
    return producer.prepare(inputs, cell, binding=contract.BASE_IDENTITY,
                            validate_authorization=admission.validate_authorization, now=now)


def load_reader():
    verify_dependencies()
    receiver = module("lane_r2_cold_receive", READER_ROOT / "receive_phase.py")
    need(receiver.audit.WORKER_CACHE_PARENT == CACHE_ROOT, "Original per-session cache anchor required")
    return receiver


def selected(model, phase):
    need(model in MODELS and phase in PHASES, "Sol/Astra/Terra technical MAX only; Luna/pilots closed")
    return json.loads((FACTORY_ROOT / "pins-source-plan.json").read_text())["contract_cells"][model][phase]


def audit_input(ref):
    verify_dependencies()
    value = read(ref)
    need(set(value) == {"refs", "expected", "snapshot", "natural_exit", "private_cli"}
         and set(value["refs"]) == REF_NAMES and set(value["expected"]) == EXPECTED_NAMES,
         "Closed receiving input refs14/expected11 required")
    expected = value["expected"]
    need(expected["model"] in MODELS and expected["phase"] in PHASES
         and expected["session_id"] == selected(expected["model"], expected["phase"])
         and expected["effort"] == "max" and expected["scope"] == SCOPE
         and expected["source_zip_sha256"] == SOURCE and expected["plan_sha256"] == PLAN,
         "Wrong exact source110/phase/session/MAX")
    need(isinstance(expected["job_id"], str) and expected["job_id"].isdigit()
         and expected["job_id"] not in BEGUN_JOBS, "No historical/replayed job")
    source = CACHE_ROOT / ("worker-" + expected["session_id"])
    snapshot = Path(value["snapshot"])
    need(expected["source_cache"] == str(source) and snapshot.is_absolute()
         and not snapshot.is_relative_to(CACHE_ROOT), "Separate cold snapshot and original cache required")
    return load_reader().receive(value["refs"], expected, value["snapshot"], value["natural_exit"], private_cli=value["private_cli"])


def check_previous_phases(rows, model, phase, current_job=None):
    selected(model, phase)
    previous = PHASES[:PHASES.index(phase)]
    need(isinstance(rows, list) and len(rows) == len(previous), "Exact ordered previous phase receipts required")
    seen = set()
    for row, expected_phase in zip(rows, previous):
        need(isinstance(row, dict) and set(row) == {"receiving_input", "strict_receipt"}, "Cold input plus strict receipt required")
        receipt = read(row["strict_receipt"])
        need(receipt.get("schema") == "hpc-forest-dynamic-r4b-reconciled-phase-receipt-v1"
             and receipt.get("verified") is True and receipt.get("normal_native_delivery_verified") is True
             and receipt.get("closed_schema_verified") is True and receipt.get("all_started_calls_reconciled") is True
             and type(receipt.get("unknown_invocations")) is int and receipt["unknown_invocations"] == 0
             and receipt.get("unresolved_invocations") == []
             and receipt.get("receiver_revision") == "external-native-receiver-r4-lane-r2"
             and receipt.get("model") == model and receipt.get("phase") == expected_phase
             and receipt.get("session_id") == selected(model, expected_phase), "Negative, unknown, wrong-model or downgraded phase")
        result = audit_input(row["receiving_input"])
        need(json.dumps(result, sort_keys=True) == json.dumps(receipt, sort_keys=True), "Stored receipt differs from strict cold reaudit")
        need(result["job_id"] not in seen and result["job_id"] != current_job, "Duplicate prior/new job")
        seen.add(result["job_id"])


G_POST_KEYS = {'independent_performance_verified', 'limits', 'r5_admitted', 'source_zip_sha256', 'global_scientific_or_performance_admission', 'all_21_owned_identities_absent', 'pre_post_lock_byte_equality_claimed', 'new_generation_retry_replay_or_stop_authorized', 'complete_files_preserved', 'scope_id', 'stop_intent', 'post_stop_cache', 'schema', 'reconciliation', 'native_research_admitted', 'owned_native_worker_interfaces_closed', 'five_confirmations_verified', 'owned_closure', 'current_lock_files_preserved', 'pre_stop_lock_sha256', 'all_started_calls_delivered_and_reconciled', 'independent_review', 'complete_cache_bytes_preserved_after_owned_stop', 'readable_files_preserved', 'verified_metadata_only', 'plan_sha256', 'final_CIM', 'six_final_proof_pins', 'all_started_calls_delivery_reconciled', 'audit', 'all_three_terminal_jobs_received', 'pipeline_complete'}
G_POST_PROOFS = {"audit", "reconciliation", "independent_review", "owned_closure",
                 "post_stop_cache", "final_CIM", "six_final_proof_pins"}


def latest_g_closure(value, pinned):
    """Consume exactly the post-helper G contract; a current CIM is still separate."""
    expected = BASE / "outputs/HPC-Forest-Primes-Natif-Relance-r2g/RECEPTION-FINALE-ET-CLOTURE-VERIFIEE.json"
    need(value is not None and pinned is not None and value == pinned
         and artifact(value) == expected, "Canonical final G closure not yet received/pinned")
    receipt = read(value)
    need(set(receipt) == G_POST_KEYS
         and receipt.get("schema") == "hpc-forest-r2g-final-metadata-and-owned-closure-v1"
         and receipt.get("scope_id") == "hpc-forest-primes-native-max-r2g"
         and receipt.get("source_zip_sha256") == "f8c2104bad52e3c298de596fd365415fbdfbbb12fbdc41b47b06a94ad68273fe"
         and receipt.get("plan_sha256") == "5af07859f99192e169f2475fb2c863c9d4a05a4a8dba07845b3fcc54451e7dba",
         "Exact canonical G post-helper schema/fields/source required")
    true_fields = ("verified_metadata_only", "all_started_calls_delivered_and_reconciled",
        "all_started_calls_delivery_reconciled", "all_three_terminal_jobs_received",
        "owned_native_worker_interfaces_closed", "all_21_owned_identities_absent",
        "complete_cache_bytes_preserved_after_owned_stop")
    false_fields = ("pipeline_complete", "native_research_admitted", "independent_performance_verified",
        "five_confirmations_verified", "global_scientific_or_performance_admission", "r5_admitted",
        "new_generation_retry_replay_or_stop_authorized", "pre_post_lock_byte_equality_claimed")
    need(all(receipt[name] is True for name in true_fields)
         and all(receipt[name] is False for name in false_fields)
         and receipt["pre_stop_lock_sha256"] is None,
         "Full actual metadata/owned-close G boundary required; no scientific/lock promotion")
    need(type(receipt["readable_files_preserved"]) is int and receipt["readable_files_preserved"] > 0
         and type(receipt["current_lock_files_preserved"]) is int and receipt["current_lock_files_preserved"] == 3
         and type(receipt["complete_files_preserved"]) is int
         and receipt["complete_files_preserved"] == receipt["readable_files_preserved"] + 3,
         "Exact three current locks plus actual readable preservation count required")
    need(receipt["limits"] == "Current lock bytes received only after closure; previous lock SHA/bytes remain unknown. Metadata closure only; no NORMAL/scientific/performance/R5 admission.",
         "Exact post-helper limits required")
    for name in G_POST_PROOFS:
        artifact(receipt[name])
    if receipt["stop_intent"] is not None:
        artifact(receipt["stop_intent"])
    return receipt

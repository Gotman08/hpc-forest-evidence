#include <cstdio>
#include <vector>
#include <climits>

struct FastScanner {
    static const int BUFSIZE = 1 << 20;
    char buf[BUFSIZE];
    int idx, size;
    FastScanner() : idx(0), size(0) {}
    inline char getChar() {
        if (idx >= size) {
            size = fread(buf, 1, BUFSIZE, stdin);
            idx = 0;
            if (size == 0) return 0;
        }
        return buf[idx++];
    }
    int nextInt() {
        char c;
        do { c = getChar(); } while (c <= ' ');
        int sign = 1;
        if (c == '-') { sign = -1; c = getChar(); }
        long long x = 0;
        while (c >= '0' && c <= '9') {
            x = x * 10 + (c - '0');
            c = getChar();
        }
        return static_cast<int>(sign * x);
    }
};

int main() {
    FastScanner fs;
    int n = fs.nextInt();
    int s = fs.nextInt();

    // Vertical prefix sums: pref[i*N+j] = sum of rows 0..i-1 for column j.
    std::vector<long long> pref((size_t)(n + 1) * n, 0);
    for (int i = 1; i <= n; ++i) {
        const int base = i * n;
        const int prev = (i - 1) * n;
        #pragma omp simd
        for (int j = 0; j < n; ++j) {
            pref[base + j] = pref[prev + j] + fs.nextInt();
        }
    }

    long long mxSum = LLONG_MIN;
    const int limit_i = n - s + 1;

    #pragma omp parallel for reduction(max:mxSum) schedule(static)
    for (int i = 0; i < limit_i; ++i) {
        const long long* top = &pref[i * n];
        const long long* bottom = &pref[(i + s) * n];

        // Initial window sum over first s columns.
        long long window = 0;
        #pragma omp simd reduction(+:window)
        for (int j = 0; j < s; ++j) {
            window += bottom[j] - top[j];
        }
        long long curMax = window;

        // Slide horizontally across the row.
        for (int j = s; j < n; ++j) {
            window += (bottom[j] - top[j]) - (bottom[j - s] - top[j - s]);
            if (window > curMax) curMax = window;
        }

        if (curMax > mxSum) mxSum = curMax;
    }

    printf("%lld\n", mxSum);
    return 0;
}

"""Read-only recovery evidence and integrity checks; no submissions or inference."""
import hashlib
import importlib.util
import json
import re
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
STUDY = HERE.parents[1]
BASE = STUDY.parent.parent
COMPARE = BASE / 'outputs/HPC-Forest-Harnais-Comparaison-r1'
OLD = STUDY / 'reprises/incident-double-liaison-20261017T1345'
RUN = STUDY / 'runs/coverage-gpt-5.6-terra-xhigh'

def load(path):
    return json.loads(path.read_text(encoding='utf-8-sig'))

def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

def save(path, value):
    if path.exists():
        path = path.with_stem(path.stem + '-' + str(time.time_ns()))
    with path.open('x', encoding='utf8') as stream:
        json.dump(value, stream, indent=2, ensure_ascii=False)
        stream.write('\n')

spec = importlib.util.spec_from_file_location('strict_observer_check', HERE / 'observer-strict.py')
observer = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = observer
spec.loader.exec_module(observer)
rows = observer.census()
save(HERE / 'cim-reprise-verifiee.json', rows)
pair = load(HERE / 'relais-attendu-r1.json')
observer.verify_pair(pair, rows)
source_pair = load(OLD / 'relais-attendu-source_only.json')
observer.verify_pair(source_pair, rows)
own_observer = load(HERE / 'identites-observateur-r1.json')['observer']
for expected in [own_observer, load(OLD / 'identites-observateur-source_only.json')['observer']]:
    current = next(r for r in rows if r['ProcessId'] == expected['ProcessId'])
    assert all(current[k] == expected[k] for k in observer.FIELDS)
launcher = load(HERE / 'observateur-lancement.json')['pid']
observer_launcher = next(r for r in rows if r['ProcessId'] == launcher)
assert own_observer['ParentProcessId'] == launcher
save(HERE / 'observateur-identite-complete.json', [observer_launcher, own_observer])

inventory = load(HERE / 'inventaire-preserve.json')
changed = []
for item in inventory:
    assert digest(HERE / item['copy']) == item['sha256']
    if BASE / item['path'] in (STUDY / 'coordinator.lock', RUN / 'worker/worker.lock'):
        continue  # Owned live lock is exclusive; retain its pre-recovery copy.
    if digest(BASE / item['path']) != item['sha256']:
        changed.append(item['path'])
allowed = {str(p.relative_to(BASE)) for p in [RUN / 'worker/worker-ready.json',
          STUDY / 'coordinator-state.json', STUDY / 'coordinator.lock',
          COMPARE / 'coordinator-state.json']}
assert set(changed).issubset(allowed), changed
responses = [x for x in inventory if Path(x['path']).name == 'response.json']
claims = [x for x in inventory if Path(x['path']).name == 'generation-claimed.json']
deliveries = [x for x in inventory if Path(x['path']).name == 'delivered.json']
assert len(responses) == len(claims) == len(deliveries) == 32
ready = load(RUN / 'worker/worker-ready.json')
assert ready['pid'] == pair[1]['ProcessId'] and ready['session_id'] == 'bb34f01e2e114cf4a59ae51b02823166'
assert ready['model'] == 'gpt-5.6-terra' and ready['reasoning_effort'] == 'xhigh'
events = [json.loads(line) for line in (RUN / 'worker/resume-events.jsonl').read_text().splitlines()]
assert events[0]['event'] == 'recovery_validated' and events[0]['delivered_cache'] == 32
assert not [e for e in events if e['event'] == 'relay_failure'], events

observations = {}
for name in ('r1', 'source_only'):
    lane = observer.LANES[name]
    state = load(lane['root'] / 'coordinator-state.json')
    cell = observer.verify_cell(state, lane)
    assert state['error'] is None and state['stage'] == name + '_running_current_group_strict_observer'
    assert time.time() - state['updated_at'] < 120
    assert observer.verify_status(cell['scheduler'], lane) is False
    assert cell['scheduler']['state'] == 'RUNNING'
    observations[name] = cell['scheduler']
save(HERE / 'statuts-reprise-verifiee.json', observations)

helper = STUDY / 'reprises/incident-liaison-20261016T1656/reprendre-relais-r1.py'
spec = importlib.util.spec_from_file_location('helper_readonly_final', helper)
recovery = importlib.util.module_from_spec(spec)
sys.modules[spec.name] = recovery
spec.loader.exec_module(recovery)
auth = load(RUN / 'autorisation.json')
assert recovery.frozen_source(Path(auth['source_zip']['path']), recovery.PROJECT,
                              auth['source_zip']['sha256']) == 90
native = [r for r in rows if r.get('CommandLine') and
          (str(helper) in r['CommandLine'] or '-m hpc_forest.ablation_worker --resume' in r['CommandLine'])]
assert {r['ProcessId'] for r in native} == {r['ProcessId'] for r in pair + source_pair}
worker = RUN / 'worker'
current_claims = sorted(p.parent.name for p in worker.glob('*/generation-claimed.json'))
old_claims = {Path(x['path']).parent.name for x in claims}
receipt = {'verified_at': time.time(), 'job_id': '750909', 'session_id': ready['session_id'],
           'relay_pids': [r['ProcessId'] for r in pair], 'observer_pids': [launcher, own_observer['ProcessId']],
           'preserved_files': len(inventory), 'preservation_copies_unchanged': True,
           'old_responses_unchanged': 32, 'old_claims_unchanged': 32, 'old_deliveries_unchanged': 32,
           'changed_existing_files': changed, 'current_claims': current_claims,
           'new_normal_claims': sorted(set(current_claims) - old_claims),
           'r1_frozen_sources_unchanged': 90, 'helper_unchanged': digest(helper) == load(HERE / 'preparation-verifiee.json')['helper_sha256'],
           'source_only_identities_unchanged': True, 'native_workers': 2, 'submissions': 0,
           'started_calls_regenerated': 0, 'processes_stopped': 0, 'live_worker_source_modified': False,
           'app_restart': False, 'mcp_update': False, 'diagnostic_inference': False,
           'low_level_cause_established': False, 'recovery_bound_seconds': load(HERE / 'intention-lancement.json')['max_seconds'],
           'local_refusals_preserved': True}
save(HERE / 'verification-reprise.json', receipt)
print(json.dumps(receipt))

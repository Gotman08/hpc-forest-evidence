+FOREIGN_IDS = {42296, 53668, 6816, 44736, 55372}
+FOREIGN_PARENT = 31268
+
+
+def foreign_preservation_map(receipt, baseline, observed, current):
+    expected = {"schema": "hpc-forest-primes-r2max-explicit-foreign-preservation-v1", "scope_id": SCOPE,
+                "job_id": JOB, "session_id": SESSION, "model": "gpt-6-luna", "effort": "max",
+                "source_zip_sha256": SOURCE, "plan_sha256": PLAN, "preparation_manifest_sha256": PREP,
+                "owner_identity_sha256": OWNER, "baseline_cim_sha256": BASELINE}
+    need(all(receipt.get(k) == v for k, v in expected.items()) and receipt.get("verified") is True
+         and receipt.get("preservation_only") is True and receipt.get("never_stop_targets") is True
+         and receipt.get("historical_parent_attribution_independently_verified") is False,
+         "No exact explicit foreign-only preservation receipt")
+    old, seen, now = index(baseline), index(observed), index(current)
+    parent = receipt["sealed_absent_parent_identity"]
+    need(parent["ProcessId"] == FOREIGN_PARENT and FOREIGN_PARENT in old
+         and identity(parent) == identity(old[FOREIGN_PARENT])
+         and FOREIGN_PARENT not in seen and FOREIGN_PARENT not in now,
+         "Sealed foreign parent absent condition changed or PPID reused")
+    need(stamp(parent["CreationDate"]) < min(stamp(old[p]["CreationDate"]) for p in ORDER),
+         "Foreign baseline parent must predate the owned family")
+    entries = index(receipt["observed_foreign_identities"])
+    need(set(entries) == FOREIGN_IDS and not (set(entries) & (set(ORDER) | set(PRESERVE))), "Only the five exact observed foreign identities may be preserved")
+    for pid, entry in entries.items():
+        need(pid in seen and identity(entry) == identity(seen[pid]), "Foreign receipt does not match immutable observed census")
+        need(entry["ExecutablePath"] == parent["ExecutablePath"], "Different executable in narrow foreign receipt")
+        if pid in now:
+            need(identity(entry) == identity(now[pid]), "Foreign PID reused or five-field identity changed")
+        child, walked = entry, {pid}
+        while child["ParentProcessId"] != FOREIGN_PARENT:
+            parent_pid = child["ParentProcessId"]
+            need(parent_pid in entries and parent_pid not in walked and parent_pid not in ORDER,
+                 "Unknown/cyclic/owned parent in explicit foreign chain")
+            ancestor = entries[parent_pid]
+            need(stamp(child["CreationDate"]) >= stamp(ancestor["CreationDate"]), "Foreign child predates its admitted parent")
+            if parent_pid in now:
+                need(identity(now[parent_pid]) == identity(ancestor), "Intermediate foreign PPID reused")
+            walked.add(parent_pid)
+            child = ancestor
+        need(stamp(child["CreationDate"]) >= stamp(parent["CreationDate"]), "Foreign child predates sealed parent")
+    for pid in (*ORDER, *PRESERVE):
+        need(pid in seen and identity(old[pid]) == identity(seen[pid]), "Immutable exception census does not preserve original owned/source-only identity")
+    return entries
 
 

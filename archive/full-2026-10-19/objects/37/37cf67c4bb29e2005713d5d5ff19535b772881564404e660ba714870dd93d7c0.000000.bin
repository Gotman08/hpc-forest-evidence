{
  "src/solution.cpp": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <utility>\n#include <vector>\n\nusing namespace std;\n\nconst long long MOD = 1000000007LL;\n\nlong long mod_pow(long long base, long long exponent) {\n    long long result = 1;\n    while (exponent > 0) {\n        if (exponent & 1LL) result = result * base % MOD;\n        base = base * base % MOD;\n        exponent >>= 1LL;\n    }\n    return result;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    cin >> n >> m;\n\n    vector<pair<int, int>> blocked;\n    blocked.reserve(m);\n    bool blocked_start = false;\n    bool blocked_destination = false;\n\n    for (int i = 0; i < m; ++i) {\n        int row, col;\n        cin >> row >> col;\n        blocked.emplace_back(row, col);\n        if (row == 0 && col == 0) blocked_start = true;\n        if (row == n - 1 && col == n - 1) blocked_destination = true;\n    }\n\n    if (blocked_start || blocked_destination) {\n        cout << 0 << '\\n';\n        return 0;\n    }\n    if (n == 1) {\n        cout << 1 << '\\n';\n        return 0;\n    }\n\n    sort(blocked.begin(), blocked.end());\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\n\n    const uint64_t obstacle_count = static_cast<uint64_t>(blocked.size());\n    const uint64_t dimension = static_cast<uint64_t>(n);\n    const bool use_sparse = obstacle_count == 0 || obstacle_count <= dimension / 4;\n\n    if (use_sparse) {\n        const int max_factorial = 2 * n - 2;\n        vector<long long> factorial(max_factorial + 1, 1);\n        vector<long long> inverse_factorial(max_factorial + 1, 1);\n\n        for (int i = 1; i <= max_factorial; ++i) {\n            factorial[i] = factorial[i - 1] * i % MOD;\n        }\n        inverse_factorial[max_factorial] = mod_pow(factorial[max_factorial], MOD - 2);\n        for (int i = max_factorial; i > 0; --i) {\n            inverse_factorial[i - 1] = inverse_factorial[i] * i % MOD;\n        }\n\n        const auto choose = [&factorial, &inverse_factorial](int total, int selected) {\n            return factorial[total] * inverse_factorial[selected] % MOD *\n                   inverse_factorial[total - selected] % MOD;\n        };\n\n        sort(blocked.begin(), blocked.end(), [](const pair<int, int>& a,\n                                                const pair<int, int>& b) {\n            const int diagonal_a = a.first + a.second;\n            const int diagonal_b = b.first + b.second;\n            if (diagonal_a != diagonal_b) return diagonal_a < diagonal_b;\n            if (a.first != b.first) return a.first < b.first;\n            return a.second < b.second;\n        });\n\n        vector<int> ways(blocked.size(), 0);\n        for (size_t i = 0; i < blocked.size(); ++i) {\n            const int row = blocked[i].first;\n            const int col = blocked[i].second;\n            long long count = choose(row + col, row);\n\n            for (size_t j = 0; j < i; ++j) {\n                const int previous_row = blocked[j].first;\n                const int previous_col = blocked[j].second;\n                if (previous_row <= row && previous_col <= col) {\n                    const int row_delta = row - previous_row;\n                    const int col_delta = col - previous_col;\n                    const long long paths = choose(row_delta + col_delta, row_delta);\n                    count -= static_cast<long long>(ways[j]) * paths % MOD;\n                    if (count < 0) count += MOD;\n                }\n            }\n            ways[i] = static_cast<int>(count);\n        }\n\n        const int destination = n - 1;\n        long long answer = choose(2 * destination, destination);\n        for (size_t i = 0; i < blocked.size(); ++i) {\n            const int row_delta = destination - blocked[i].first;\n            const int col_delta = destination - blocked[i].second;\n            const long long paths = choose(row_delta + col_delta, row_delta);\n            answer -= static_cast<long long>(ways[i]) * paths % MOD;\n            if (answer < 0) answer += MOD;\n        }\n        cout << answer << '\\n';\n        return 0;\n    }\n\n    vector<int> dp(n, 0);\n    size_t obstacle_index = 0;\n    for (int row = 0; row < n; ++row) {\n        for (int col = 0; col < n; ++col) {\n            const bool is_blocked =\n                obstacle_index < blocked.size() &&\n                blocked[obstacle_index].first == row &&\n                blocked[obstacle_index].second == col;\n            if (is_blocked) ++obstacle_index;\n\n            if (is_blocked) {\n                dp[col] = 0;\n            } else if (row == 0 && col == 0) {\n                dp[col] = 1;\n            } else {\n                int count = dp[col];\n                if (col > 0) {\n                    count += dp[col - 1];\n                    if (count >= MOD) count -= MOD;\n                }\n                dp[col] = count;\n            }\n        }\n    }\n\n    cout << dp[n - 1] << '\\n';\n    return 0;\n}\n"
}

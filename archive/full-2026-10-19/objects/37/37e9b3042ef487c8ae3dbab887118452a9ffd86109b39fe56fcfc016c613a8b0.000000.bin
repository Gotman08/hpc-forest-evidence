"""Static final helper delta review; never execute the reviewed helpers."""
import ast
import hashlib
import json
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent


def ref(path):
    data = path.read_bytes()
    return {"path": str(path), "sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data)}


def main():
    target = HERE / "REVUE-HELPERS-SCELLEMENT-R4.json"
    assert not target.exists()
    files = {
        "sceller-edition-sol-parent.py": "d23b65bf59f9c38705304de9aa3c953e34693b7c4a4806080b0a87413e935cf7",
        "verifier-construction-parent.py": "3cafda879cae54a49e611ff9affbf421a47412c9763ba85103e747683fe3bf4a",
    }
    actual = []
    for name, expected in files.items():
        path = HERE.parent / name
        value = ref(path)
        assert value["sha256"] == expected
        ast.parse(path.read_text(encoding="utf-8-sig"))
        actual.append(value)
    previous = HERE / "REVUE-HELPERS-SCELLEMENT.json"
    assert ref(previous)["sha256"] == "839de16962725d8bf442354f31cafb5e1edc52b9c9012ac50c2b58e3f630c5e5"
    review = {
        "schema": "hpc-forest-sol-editorial-sealing-helpers-independent-review-v1",
        "verified": True, "blocking_findings": [], "observed_utc": datetime.now(UTC).isoformat(),
        "reviewed_files": actual, "previous_static_review": ref(previous),
        "decision": "GO statique après mise à jour R4; exécution parent seulement après nouveaux contrôle et reçus pixels complets",
        "delta_verified": ["livraison coherence-r4 et revue f7f9 épinglées", "neuf canoniques et huit exports plats R4 vérifiés avant mutation", "nouveaux noms FINAL pour construction, plan et snapshot de contrôle sans écrasement des précédents", "trois assertions de cohérence dans ARTICLE.md plus date18octobre par page PDF"],
        "retained_guards": ["absence des reçus finaux avant mutation", "PDF et planches/pages exactement liés au contrôle qualité et plan de risques", "zooms liés au PDF source par SHA et page", "revues base/dates/cohérence et réception scientifique épinglées", "aucune publication, recherche ou intervention processus"],
        "checks_actually_run": ["lecture statique complète des deux versions courantes", "SHA et AST sans import", "rehash de la précédente revue statique"],
        "helpers_executed": False, "actual_pixel_review_by_this_static_receipt": False,
        "new_native_global_or_performance_admission": False,
        "limitations": ["Les observations réelles et pixels des PDF finaux restent nécessaires; ce reçu ne les produit pas."],
    }
    target.write_text(json.dumps(review, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(ref(target)))


if __name__ == "__main__":
    main()

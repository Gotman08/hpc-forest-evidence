        "content": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nusing Word = uint32_t;\nusing Wide = uint64_t;\n\nstatic constexpr Wide MOD = 1000000007ULL;\nstatic constexpr int BATCH = 16;\n\n// Sixteen products bounded by (MOD-1)^2, plus a residue, fit in Wide.\nstatic Word dot_mod(const Word* a, const Word* b, int count) {\n    Wide sum = 0;\n    int i = 0;\n    for (; i + BATCH <= count; i += BATCH) {\n        for (int j = 0; j < BATCH; ++j) {\n            sum += Wide(a[i + j]) * b[i + j];\n        }\n        sum %= MOD;\n    }\n    for (; i < count; ++i) {\n        sum += Wide(a[i]) * b[i];\n    }\n    return Word(sum % MOD);\n}\n\nstatic Word scalar_power(Word value, Wide exponent) {\n    Wide result = 1;\n    Wide factor = value;\n    while (exponent != 0) {\n        if (exponent & 1ULL) {\n            result = result * factor % MOD;\n        }\n        factor = factor * factor % MOD;\n        exponent >>= 1;\n    }\n    return Word(result);\n}\n\nstatic Word direct_term(vector<Word>& history,\n                        const vector<Word>& coefficient, Wide steps) {\n    const int n = int(history.size());\n    int head = 0;\n    Word answer = 0;\n    for (Wide step = 0; step < steps; ++step) {\n        // Traverse the circular history as two contiguous spans.\n        Wide value = dot_mod(history.data() + head,\n                             coefficient.data(), n - head);\n        if (head != 0) {\n            value += dot_mod(history.data(),\n                             coefficient.data() + n - head, head);\n        }\n        if (value >= MOD) {\n            value -= MOD;\n        }\n        answer = Word(value);\n        history[head] = answer;\n        if (++head == n) {\n            head = 0;\n        }\n    }\n    return answer;\n}\n\n// Input coefficients in work[0..degree] are canonical residues.\n// x^n == coefficient[0] + ... + coefficient[n-1] * x^(n-1).\nstatic int reduce_polynomial(vector<Wide>& work, int degree,\n                             const vector<Word>& coefficient,\n                             vector<Word>& result) {\n    const int n = int(coefficient.size());\n    int high = degree;\n    while (high >= n) {\n        const int low = max(n, high - BATCH + 1);\n        for (int d = high; d >= low; --d) {\n            const Word factor = Word(work[d] % MOD);\n            if (factor != 0) {\n                Wide* destination = work.data() + d - n;\n                for (int j = 0; j < n; ++j) {\n                    destination[j] += Wide(factor) * coefficient[j];\n                }\n            }\n        }\n        // Each live coefficient received at most sixteen products since\n        // normalization, so no unsigned accumulator can overflow.\n        for (int j = 0; j < low; ++j) {\n            work[j] %= MOD;\n        }\n        high = low - 1;\n    }\n\n    int length = min(n, degree + 1);\n    for (int i = 0; i < length; ++i) {\n        result[i] = Word(work[i]);\n    }\n    while (length != 0 && result[length - 1] == 0) {\n        --length;\n    }\n    return length;\n}\n\nstatic int square_mod(vector<Word>& polynomial, int length,\n                      const vector<Word>& coefficient,\n                      vector<Wide>& work) {\n    const int degree = 2 * length - 2;\n    for (int k = 0; k <= degree; ++k) {\n        Wide sum = 0;\n        if ((k & 1) == 0) {\n            sum = Wide(polynomial[k / 2]) * polynomial[k / 2];\n        }\n        int i = max(0, k - length + 1);\n        const int end = (k + 1) / 2;\n        // One diagonal and eight doubled products are below 2^64.\n        for (; i + 8 <= end; i += 8) {\n            for (int j = 0; j < 8; ++j) {\n                sum += 2ULL * Wide(polynomial[i + j])\n                       * polynomial[k - i - j];\n            }\n            sum %= MOD;\n        }\n        for (; i < end; ++i) {\n            sum += 2ULL * Wide(polynomial[i]) * polynomial[k - i];\n        }\n        work[k] = sum % MOD;\n    }\n    return reduce_polynomial(work, degree, coefficient, polynomial);\n}\n\nstatic int multiply_x(vector<Word>& polynomial, int length,\n                       const vector<Word>& coefficient) {\n    const int n = int(coefficient.size());\n    if (length < n) {\n        for (int i = length; i > 0; --i) {\n            polynomial[i] = polynomial[i - 1];\n        }\n        polynomial[0] = 0;\n        return length + 1;\n    }\n\n    const Word high = polynomial[n - 1];\n    for (int i = n - 1; i > 0; --i) {\n        polynomial[i] = Word((Wide(high) * coefficient[i]\n                              + polynomial[i - 1]) % MOD);\n    }\n    polynomial[0] = Word(Wide(high) * coefficient[0] % MOD);\n    while (length != 0 && polynomial[length - 1] == 0) {\n        --length;\n    }\n    return length;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    Wide h;\n    if (!(cin >> n >> h)) {\n        return 0;\n    }\n\n    vector<Word> initial(n);\n    vector<Word> coefficient(n);\n    for (int i = 0; i < n; ++i) {\n        Wide value;\n        cin >> value;\n        initial[i] = Word(value % MOD);\n    }\n    for (int i = 0; i < n; ++i) {\n        Wide value;\n        cin >> value;\n        coefficient[n - 1 - i] = Word(value % MOD);\n    }\n\n    if (h <= Wide(n)) {\n        cout << initial[size_t(h - 1)] << \"\\n\";\n        return 0;\n    }\n    if (n == 1) {\n        cout << Wide(initial[0]) * scalar_power(coefficient[0], h - 1)\n                    % MOD << \"\\n\";\n        return 0;\n    }\n\n    const Wide exponent = h - 1;\n    Wide bit = 1;\n    while (bit <= exponent / 2) {\n        bit <<= 1;\n    }\n\n    // Until its degree reaches n, the powered polynomial is a monomial.\n    // Construct the first prefix requiring reduction without squaring zeros.\n    int degree = 0;\n    while (bit != 0) {\n        degree = 2 * degree + ((exponent & bit) != 0);\n        bit >>= 1;\n        if (degree >= n) {\n            break;\n        }\n    }\n\n    // Compare arithmetic work with a rolling direct recurrence. This keeps\n    // short horizons cheap without assuming any particular input sizes.\n    Wide estimated_products = Wide(degree - n + 1) * n;\n    const Wide dense_square_products = Wide(n) * (n + 1) / 2\n                                     + Wide(n) * (n - 1);\n    for (Wide mask = bit; mask != 0; mask >>= 1) {\n        estimated_products += dense_square_products;\n        if (exponent & mask) {\n            estimated_products += n;\n        }\n    }\n    const Wide steps = h - Wide(n);\n    if (steps <= estimated_products / Wide(n)) {\n        cout << direct_term(initial, coefficient, steps) << \"\\n\";\n        return 0;\n    }\n\n    vector<Word> polynomial(n, 0);\n    vector<Wide> work(size_t(2) * n, 0);\n    work[degree] = 1;\n    int length = reduce_polynomial(work, degree, coefficient, polynomial);\n\n    // MSB-first powering needs only squaring and linear-time multiplication\n    // by x, rather than a general polynomial product for each set bit.\n    for (; bit != 0 && length != 0; bit >>= 1) {\n        length = square_mod(polynomial, length, coefficient, work);\n        if ((exponent & bit) != 0 && length != 0) {\n            length = multiply_x(polynomial, length, coefficient);\n        }\n    }\n\n    cout << dot_mod(polynomial.data(), initial.data(), length) << \"\\n\";\n    return 0;\n}\n",

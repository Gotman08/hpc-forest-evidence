#include <cstdio>
#include <cstdlib>
#include <climits>

static const int BUFSIZE = 1 << 20;
static char buf[BUFSIZE];
static int pos = 0, len = 0;

inline char getChar() {
    if (pos >= len) {
        len = fread(buf, 1, BUFSIZE, stdin);
        pos = 0;
    }
    return buf[pos++];
}

inline int readInt() {
    char c;
    do { c = getChar(); } while (c <= ' ');
    int sign = 1;
    if (c == '-') { sign = -1; c = getChar(); }
    int x = c - '0';
    for (;;) {
        c = getChar();
        if (c < '0' || c > '9') break;
        x = x * 10 + (c - '0');
    }
    return sign * x;
}

static inline long long maxWindow(const long long* col, int n, int s) {
    long long pref[8001];
    pref[0] = 0;
    for (int i = 0; i < n; ++i) {
        pref[i + 1] = pref[i] + col[i];
    }
    long long mx = LLONG_MIN;
    #pragma omp simd reduction(max:mx)
    for (int j = 0; j <= n - s; ++j) {
        const long long w = pref[j + s] - pref[j];
        if (w > mx) mx = w;
    }
    return mx;
}

int main() {
    int n = readInt();
    int s = readInt();

    int* rows = static_cast<int*>(malloc(sizeof(int) * (size_t)s * n));
    long long* colSum = static_cast<long long*>(calloc(n, sizeof(long long)));
    if (!rows || !colSum) return 1;

    for (int r = 0; r < s; ++r) {
        int* row = rows + (size_t)r * n;
        for (int c = 0; c < n; ++c) {
            row[c] = readInt();
        }
        #pragma omp simd
        for (int c = 0; c < n; ++c) {
            colSum[c] += row[c];
        }
    }

    long long mx = maxWindow(colSum, n, s);

    int* tmp = static_cast<int*>(malloc(sizeof(int) * n));
    if (!tmp) { free(rows); free(colSum); return 1; }

    for (int r = s; r < n; ++r) {
        const int ringPos = r % s;
        int* row = rows + (size_t)ringPos * n;

        for (int c = 0; c < n; ++c) {
            tmp[c] = readInt();
        }

        #pragma omp simd
        for (int c = 0; c < n; ++c) {
            const long long old = row[c];
            row[c] = tmp[c];
            colSum[c] += static_cast<long long>(tmp[c]) - old;
        }

        const long long curMax = maxWindow(colSum, n, s);
        if (curMax > mx) mx = curMax;
    }

    printf("%lld\n", mx);

    free(tmp);
    free(rows);
    free(colSum);
    return 0;
}

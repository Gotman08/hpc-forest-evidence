       fz += dz * inv_dist3;\\n     }\\n \\n-    p[i].vx += dt*fx; \\n-    p[i].vy += dt*fy; \\n+    p[i].vx += dt*fx;\\n+    p[i].vy += dt*fy;\\n     p[i].vz += dt*fz;\\n   }\\n }\\n \\n+/*\\n+ * Advance two bodies from an immutable timestep into a separate buffer.\\n+ * Each body's force contributions remain in ascending source-body order.\\n+ */\\n+static void advance_pair(const Body *src, Body *dst, float dt,\\n+                         int n, int first) {\\n+  int second = first + 1;\\n+  const int has_second = second < n;\\n+  if (!has_second) {\\n+    second = first;\\n+  }\\n+\\n+  const float x0 = src[first].x;\\n+  const float y0 = src[first].y;\\n+  const float z0 = src[first].z;\\n+  const float x1 = src[second].x;\\n+  const float y1 = src[second].y;\\n+  const float z1 = src[second].z;\\n+  float fx0 = 0.0f;\\n+  float fy0 = 0.0f;\\n+  float fz0 = 0.0f;\\n+  float fx1 = 0.0f;\\n+  float fy1 = 0.0f;\\n+  float fz1 = 0.0f;\\n+\\n+  for (int j = 0; j < n; ++j) {\\n+    const float xj = src[j].x;\\n+    const float yj = src[j].y;\\n+    const float zj = src[j].z;\\n+    float dx0 = xj - x0;\\n+    float dy0 = yj - y0;\\n+    float dz0 = zj - z0;\\n+    float dx1 = xj - x1;\\n+    float dy1 = yj - y1;\\n+    float dz1 = zj - z1;\\n+    float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\\n+    float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\\n+    float inv_dist0 = 1 / sqrt(sqrd_dist0);\\n+    float inv_dist1 = 1 / sqrt(sqrd_dist1);\\n+    float inv_dist30 = inv_dist0 * inv_dist0 * inv_dist0;\\n+    float inv_dist31 = inv_dist1 * inv_dist1 * inv_dist1;\\n+\\n+    fx0 += dx0 * inv_dist30;\\n+    fy0 += dy0 * inv_dist30;\\n+    fz0 += dz0 * inv_dist30;\\n+    fx1 += dx1 * inv_dist31;\\n+    fy1 += dy1 * inv_dist31;\\n+    fz1 += dz1 * inv_dist31;\\n+  }\\n+\\n+  Body b0 = src[first];\\n+  b0.vx += dt*fx0;\\n+  b0.vy += dt*fy0;\\n+  b0.vz += dt*fz0;\\n+  b0.x += b0.vx * dt;\\n+  b0.y += b0.vy * dt;\\n+  b0.z += b0.vz * dt;\\n+  dst[first] = b0;\\n+\\n+  if (has_second) {\\n+    Body b1 = src[second];\\n+    b1.vx += dt*fx1;\\n+    b1.vy += dt*fy1;\\n+    b1.vz += dt*fz1;\\n+    b1.x += b1.vx * dt;\\n+    b1.y += b1.vy * dt;\\n+    b1.z += b1.vz * dt;\\n+    dst[second] = b1;\\n+  }\\n+}\\n+\\n /*\\n  * Read a binary dataset with initilized bodies.\\n  */\\n@@ -76,24 +147,45 @@ int main(int argc,char **argv) {\\n   int nbodies;\\n \\n   Body *bodies = read_dataset(&nbodies);\\n+  Body *scratch = (Body *)malloc((size_t)nbodies * sizeof(Body));\\n+  Body *result = bodies;\\n+\\n+  if (scratch != NULL) {\\n+    const int work_items = nbodies / 2 + nbodies % 2;\\n+\\n+    /* Buffer parity avoids a shared pointer swap or an extra barrier. */\\n+    #pragma omp parallel if(nbodies >= 64)\\n+    {\\n+      for (int iter = 0; iter < N_ITER; ++iter) {\\n+        const Body *src = (iter & 1) ? scratch : bodies;\\n+        Body *dst = (iter & 1) ? bodies : scratch;\\n \\n-  /*\\n-   * At each simulation iteration, interbody forces are computed,\\n-   * and bodies' positions are integrated.\\n-   */\\n-  for (int iter = 0; iter < N_ITER; iter++) {\\n-    body_force(bodies, DT, nbodies);\\n-\\n-    for (int i = 0; i < nbodies; i++) {\\n-      bodies[i].x += bodies[i].vx * DT;\\n-      bodies[i].y += bodies[i].vy * DT;\\n-      bodies[i].z += bodies[i].vz * DT;\\n+        #pragma omp for schedule(static)\\n+        for (int item = 0; item < work_items; ++item) {\\n+          advance_pair(src, dst, DT, nbodies, 2 * item);\\n+        }\\n+        /* The work-sharing barrier completes this timestep's output. */\\n+      }\\n+    }\\n+\\n+    result = (N_ITER & 1) ? scratch : bodies;\\n+  } else {\\n+    /* Preserve the original simulation if the extra buffer is unavailable. */\\n+    for (int iter = 0; iter < N_ITER; iter++) {\\n+      body_force(bodies, DT, nbodies);\\n+\\n+      for (int i = 0; i < nbodies; i++) {\\n+        bodies[i].x += bodies[i].vx * DT;\\n+        bodies[i].y += bodies[i].vy * DT;\\n+        bodies[i].z += bodies[i].vz * DT;\\n+      }\\n     }\\n   }\\n \\n-  write_dataset(nbodies, bodies);\\n+  write_dataset(nbodies, result);\\n \\n+  free(scratch);\\n   free(bodies);\\n-  \\n+\\n   exit(EXIT_SUCCESS);\\n }\"}], \"interactions\": [{\"sources\": [\"4a9fdfb571974421\", \"abe9d6a0fae341f5\", \"bac2c4de401e453d\"], \"outcome\": {\"binary_sha256\": \"687782a45ddf90d3ca76ffd671221cef37e3e0c4092442d26553d5c52f4af74e\", \"cache_key\": \"fefd457ab2830c1541776d7435bda7f9fa8790122f2e8b7793e02d50106abe02\", \"commit\": \"3dd6afcc03965e1f0ef00479e582d973f61025f9\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/nbody/logs/e1/8bb9da85accf467f/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/nbody/logs/e1/8bb9da85accf467f/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/nbody/logs/e1/8bb9da85accf467f/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/nbody/logs/e1/8bb9da85accf467f/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/nbody/logs/e1/8bb9da85accf467f/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/nbody/logs/e1/8bb9da85accf467f/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.09510208355883758, \"reason\": \"\", \"score\": 0.8743800965117057, \"status\": \"valid\", \"times\": [0.09317979775369167, 0.09941531624644995, 0.0927111366763711], \"tree_hash\": \"26b264aaad70dbd8482c928b8b36ff3c6f3a5b82\"}}, {\"sources\": [\"b6ce5a04928246cd\", \"abe9d6a0fae341f5\", \"bac2c4de401e453d\"], \"outcome\": {\"binary_sha256\": \"0efb32fcc7c8acd19de3f809e5972c65e32502f03c041249071d75765d3f7b07\", \"cache_key\": \"50da82b59a4c93cf7f62d89
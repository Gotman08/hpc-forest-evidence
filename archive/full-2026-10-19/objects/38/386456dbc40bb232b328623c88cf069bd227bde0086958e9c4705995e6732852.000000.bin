void body_force(Body *p, float dt, int n) {\\n+  if (n <= 0) {\\n+    return;\\n+  }\\n+\\n+  size_t count = (size_t)n;\\n+  Position *positions = NULL;\\n+  if (count <= (size_t)-1 / sizeof(Position)) {\\n+    positions = (Position *)malloc(count * sizeof(Position));\\n+  }\\n+  if (positions == NULL) {\\n+#ifdef _OPENMP\\n+#pragma omp parallel for schedule(static)\\n+#endif\\n+    for (int i = 0; i < n; ++i) {\\n+      body_force_one(p, dt, n, i);\\n+    }\\n+    return;\\n+  }\\n+\\n   for (int i = 0; i < n; ++i) {\\n-    float fx = 0.0f; \\n-    float fy = 0.0f; \\n-    float fz = 0.0f;\\n-\\n-    for (int j = 0; j < n; j++) {\\n-      float dx = p[j].x - p[i].x;\\n-      float dy = p[j].y - p[i].y;\\n-      float dz = p[j].z - p[i].z;\\n-      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n-      float inv_dist = 1 / sqrt(sqrd_dist);\\n-      float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n-\\n-      fx += dx * inv_dist3; \\n-      fy += dy * inv_dist3; \\n-      fz += dz * inv_dist3;\\n+    positions[i].x = p[i].x;\\n+    positions[i].y = p[i].y;\\n+    positions[i].z = p[i].z;\\n+  }\\n+\\n+  int pair_count = n / 2;\\n+#ifdef _OPENMP\\n+#pragma omp parallel for schedule(static)\\n+#endif\\n+  for (int pair = 0; pair < pair_count; ++pair) {\\n+    int i = 2 * pair;\\n+    const float x0 = positions[i].x;\\n+    const float y0 = positions[i].y;\\n+    const float z0 = positions[i].z;\\n+    const float x1 = positions[i + 1].x;\\n+    const float y1 = positions[i + 1].y;\\n+    const float z1 = positions[i + 1].z;\\n+    float fx0 = 0.0f;\\n+    float fy0 = 0.0f;\\n+    float fz0 = 0.0f;\\n+    float fx1 = 0.0f;\\n+    float fy1 = 0.0f;\\n+    float fz1 = 0.0f;\\n+\\n+    for (int j = 0; j < n; ++j) {\\n+      const float xj = positions[j].x;\\n+      const float yj = positions[j].y;\\n+      const float zj = positions[j].z;\\n+      float dx0 = xj - x0;\\n+      float dy0 = yj - y0;\\n+      float dz0 = zj - z0;\\n+      float dx1 = xj - x1;\\n+      float dy1 = yj - y1;\\n+      float dz1 = zj - z1;\\n+      float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\\n+      float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\\n+      float inv_dist0 = 1 / sqrt(sqrd_dist0);\\n+      float inv_dist1 = 1 / sqrt(sqrd_dist1);\\n+      float inv_dist3_0 = inv_dist0 * inv_dist0 * inv_dist0;\\n+      float inv_dist3_1 = inv_dist1 * inv_dist1 * inv_dist1;\\n+\\n+      fx0 += dx0 * inv_dist3_0;\\n+      fy0 += dy0 * inv_dist3_0;\\n+      fz0 += dz0 * inv_dist3_0;\\n+      fx1 += dx1 * inv_dist3_1;\\n+      fy1 += dy1 * inv_dist3_1;\\n+      fz1 += dz1 * inv_dist3_1;\\n     }\\n \\n-    p[i].vx += dt*fx; \\n-    p[i].vy += dt*fy; \\n-    p[i].vz += dt*fz;\\n+    p[i].vx += dt*fx0;\\n+    p[i].vy += dt*fy0;\\n+    p[i].vz += dt*fz0;\\n+    p[i + 1].vx += dt*fx1;\\n+    p[i + 1].vy += dt*fy1;\\n+    p[i + 1].vz += dt*fz1;\\n+  }\\n+\\n+  if (n % 2 != 0) {\\n+    body_force_one(p, dt, n, n - 1);\\n   }\\n+  free(positions);\\n }\\n \\n /*\\n@@ -94,6 +177,6 @@ int main(int argc,char **argv) {\\n   write_dataset(nbodies, bodies);\\n \\n   free(bodies);\\n-  \\n+\\n   exit(EXIT_SUCCESS);\\n }\"}, {\"id\": \"2714c457e2f34aa0\", \"role\": \"B\", \"commit\": \"ec1c6cfc906c8f9d9216b96c49a30433e191ad96\", \"transformations\": {\"files\": [\"src/nbody.c\"], \"retained\": [\"Batch two source interactions using AArch64 NEON double-precision sqrt/divide followed by float conversion and cubing.\", \"Retain the original scalar squared-distance expressions and sequential force additions without reduction reassociation.\"]}, \"mean_seconds\": 0.6215973921741048, \"diff\": \"diff --git a/src/nbody.c b/src/nbody.c\\nindex 765bd6a..c6cb146 100644\\n--- a/src/nbody.c\\n+++ b/src/nbody.c\\n@@ -2,6 +2,9 @@\\n #include <stdlib.h>\\n #include <string.h>\\n #include <math.h>\\n+#if defined(__aarch64__)\\n+#include <arm_neon.h>\\n+#endif\\n \\n #define N_ITER 10 // number of simulation iterations\\n #define DT 0.01f // time step\\n@@ -14,
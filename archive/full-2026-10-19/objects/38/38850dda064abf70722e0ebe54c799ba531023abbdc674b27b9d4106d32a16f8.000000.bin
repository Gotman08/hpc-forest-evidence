    {
      "id": "abf003d566884ad0",
      "role": "G",
      "mission": {
        "base_commit": "086b51800b7b6ad6684929e45a3878768a60fd13",
        "delegation_parent": "R/G",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "A generation-stamped occupancy map should reduce per-candidate box checks while push-only sorted-vector reinsertion avoids full bubble sorts; explicit bounds checks also prevent out-of-range cell access. These changes preserve serial BFS ordering.",
        "id": "abf003d566884ad0",
        "ordinal": 1,
        "parent_id": null,
        "role": "G",
        "source_commits": [
          "7ebe5c5ce95233e6dd0d00f0b17ff0a1080f4f60"
        ],
        "sources": [
          "77770fa58d824433"
        ],
        "transformations": {
          "files": [
            "src/sokoban.c"
          ],
          "retained": [
            "Build a generation-stamped box occupancy/index map once for each expanded state and use constant-time occupancy checks for the four candidate moves.",
            "Maintain canonical sorted box positions by removing and reinserting the moved box with shifts and binary search instead of bubble-sorting the full array.",
            "Reject moves and pushes that leave board bounds before accessing board cells."
          ]
        },
        "tree_id": "e1:G",

      "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\nusing namespace std;\n\nstatic const uint32_t MOD = 1000000007u;\n\nstatic inline void advance_diagonal(const uint32_t* __restrict__ previous,\n                                    uint32_t* __restrict__ current,\n                                    int first, int end) {\n    int j = first;\n#if defined(__aarch64__)\n    const uint32x4_t modulus = vdupq_n_u32(MOD);\n    for (; j + 4 <= end; j += 4) {\n        const uint32x4_t sum = vaddq_u32(vld1q_u32(previous + j),\n                                        vld1q_u32(previous + j - 1));\n        // Unsigned subtraction wraps above sum exactly when sum < MOD.\n        const uint32x4_t reduced = vminq_u32(sum, vsubq_u32(sum, modulus));\n        vst1q_u32(current + j, reduced);\n    }\n#endif\n    for (; j < end; ++j) {\n        const uint32_t sum = previous[j] + previous[j - 1];\n        current[j] = sum >= MOD ? sum - MOD : sum;\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    const int diagonal_count = 2 * n - 1;\n    vector<vector<int>> blocked(diagonal_count);\n    for (int c = 0; c < m; ++c) {\n        int y, x;\n        cin >> y >> x;\n        blocked[y + x].push_back(y + 1);\n    }\n\n    // Position y + 1 represents row y; position zero is a zero sentinel.\n    vector<uint32_t> previous(n + 1, 0);\n    vector<uint32_t> current(n + 1, 0);\n    previous[1] = 1;\n    for (int position : blocked[0]) previous[position] = 0;\n\n    for (int diagonal = 1; diagonal < diagonal_count; ++diagonal) {\n        const int first = max(0, diagonal - (n - 1)) + 1;\n        const int end = min(n - 1, diagonal) + 2;\n        advance_diagonal(previous.data(), current.data(), first, end);\n\n        // Cells on the same diagonal are independent, so masking can follow\n        // the contiguous update. Duplicate coordinates are harmless.\n        for (int position : blocked[diagonal]) current[position] = 0;\n        previous.swap(current);\n    }\n\n    cout << previous[n] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Contiguous antidiagonal traversal removes the row-wise dependency chain, enabling four-cell ARM64 SIMD updates while retaining O(n) rolling DP storage.",

"""Static correction to the actual ROOT hash-only job interface; no receiver executes."""
import ast
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
OLD = HERE / 'recevoir-metadonnees-R7-zero-appel.py'
data = OLD.read_bytes()
assert hashlib.sha256(data).hexdigest() == 'f53cb40efda527d1d41e0e29ff0e6d46969782c3c171eea444160766a0064261'
text = data.decode()

def once(old, new):
    global text
    assert text.count(old) == 1, old[:80]
    text = text.replace(old, new)

once('"hash_announcement_job_terminal", "fresh_full_cim"', '"hash_announcement_status", "hash_announcement_log", "hash_announcement_efficiency", "fresh_full_cim"')
once('and announcement_job not in set(CELLS) | {"754337", "754295", "754296", "754299"},',
     'and announcement_job == "754586",')
once('announcement.get("schema") == "hpc-forest-r4b-original-zero-call-archives-hash-announcement-v1"\n         and announcement.get("verified_readonly_hashes") is True and announcement.get("native_model_calls") == 0\n         and announcement.get("tests_replayed") == 0 and announcement.get("archives_modified") is False',
     'announcement.get("schema") == "hpc-forest-r7-original-terminal-archives-hash-announcement-v1"\n         and announcement.get("verified_readonly_hashes") is True\n         and type(announcement.get("native_model_calls_by_hash_workload")) is int and announcement["native_model_calls_by_hash_workload"] == 0\n         and type(announcement.get("tests_or_compilations_replayed")) is int and announcement["tests_or_compilations_replayed"] == 0\n         and announcement.get("source_roots_call_counts_not_inferred") is True\n         and announcement.get("archives_extracted_or_modified") is False')
old = '''    terminal_state(read(bundle["hash_announcement_job_terminal"]), announcement_job, "COMPLETED", "0:0")  # Actual separate hash delivery job only; no repoll.
    original_announcement_receipt = read(bundle["hash_announcement_job_terminal"])
    need(str(original_announcement_receipt.get("job_id")) == announcement_job and "log" in original_announcement_receipt,
         "Actual original hash announcement job/log receipt required")
    original_log = unwrap(original_announcement_receipt["log"])
'''
new = '''    terminal_state(read(bundle["hash_announcement_status"]), announcement_job, "COMPLETED", "0:0")  # Actual separate hash job only; no repoll.
    original_log = unwrap(read(bundle["hash_announcement_log"]))
    announcement_efficiency = unwrap(read(bundle["hash_announcement_efficiency"]))
    need(announcement_efficiency.get("ok") is True and announcement_efficiency.get("found") is True
         and str(announcement_efficiency.get("job_id")) == announcement_job
         and announcement_efficiency.get("state") == "COMPLETED" and announcement_efficiency.get("exit_code") == "0:0",
         "Original actual hash-only efficiency required, never source-root call counts")
'''
once(old, new)
once('"hash_announcement": bundle["hash_announcement"], "fresh_worker_zero_census":',
     '"hash_announcement": bundle["hash_announcement"], "hash_announcement_status": bundle["hash_announcement_status"],\n            "hash_announcement_log": bundle["hash_announcement_log"], "hash_announcement_efficiency": bundle["hash_announcement_efficiency"],\n            "source_roots_zero_counts_inferred_from_hash_workload": False, "fresh_worker_zero_census":')
ast.parse(text)
target = HERE / 'recevoir-metadonnees-R7-zero-appel-r2.py'
with target.open('xb') as stream:
    stream.write(text.encode())
template = json.loads((HERE / 'ENTREES-R7-NON-ADMISES.json').read_bytes())
del template['hash_announcement_job_terminal']
template['hash_announcement_job_id'] = '754586'
for key in ('hash_announcement_status', 'hash_announcement_log', 'hash_announcement_efficiency'):
    template[key] = None
with (HERE / 'ENTREES-R7-NON-ADMISES-R2.json').open('x', encoding='utf8', newline='\n') as stream:
    json.dump(template, stream, ensure_ascii=False, indent=2); stream.write('\n')
mapping = lambda code: {n.name: ast.dump(n, include_attributes=False) for n in ast.parse(code).body if isinstance(n, ast.FunctionDef)}
old_functions, new_functions = mapping(data), mapping(text)
delta = {'schema': 'hpc-forest-r7-zero-call-actual-hash-interface-correction-v1',
    'preserved_prototype': {'path': str(OLD), 'sha256': hashlib.sha256(data).hexdigest()},
    'proposed_receiver': {'path': str(target), 'sha256': hashlib.sha256(target.read_bytes()).hexdigest()},
    'unchanged_functions': sorted(name for name in old_functions if old_functions[name] == new_functions[name]),
    'changed_functions': sorted(name for name in old_functions if old_functions[name] != new_functions[name]),
    'actual_hash_only_job_id': '754586', 'actual_hash_schema': 'hpc-forest-r7-original-terminal-archives-hash-announcement-v1',
    'original_status_log_efficiency_refs_separate': True, 'source_roots_counts_come_from_archive_and_fresh_CIM_not_hash_workload': True,
    'new_receiver_main_or_test_or_archive_or_CIM_or_process_or_MCP_executed': False,
    'all_future_terminal_download_inventory_announcement_and_freshness_pins_NON_ADMIS': True}
with (HERE / 'DELTA-R2-ANNONCE-REELLE.json').open('x', encoding='utf8', newline='\n') as stream:
    json.dump(delta, stream, ensure_ascii=False, indent=2); stream.write('\n')
print(json.dumps(delta))

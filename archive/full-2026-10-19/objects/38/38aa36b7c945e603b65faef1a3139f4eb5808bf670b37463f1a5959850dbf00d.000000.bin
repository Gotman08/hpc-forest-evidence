{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <math.h>\\n\\n#define N_ITER 10 // number of simulation iterations\\n#define DT 0.01f // time step\\n#define SOFTENING 1e-9f // to avoid zero divisors\\n\\n/*\\n * Each body holds coordinate positions (i.e., x, y, and z) and\\n * velocities (i.e., vx, vy, and vz).\\n */\\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\\n\\n/*\\n * Compute the gravitational impact among all pairs of bodies in\\n * the system.\\n */\\nvoid body_force(Body *p, float dt, int n) {\\n  for (int i = 0; i < n; ++i) {\\n    float fx = 0.0f;\\n    float fy = 0.0f;\\n    float fz = 0.0f;\\n\\n    for (int j = 0; j < n; j++) {\\n      float dx = p[j].x - p[i].x;\\n      float dy = p[j].y - p[i].y;\\n      float dz = p[j].z - p[i].z;\\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n      float inv_dist = 1 / sqrt(sqrd_dist);\\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n\\n      fx += dx * inv_dist3;\\n      fy += dy * inv_dist3;\\n      fz += dz * inv_dist3;\\n    }\\n\\n    p[i].vx += dt*fx;\\n    p[i].vy += dt*fy;\\n    p[i].vz += dt*fz;\\n  }\\n}\\n\\nstatic inline void store_step(const Body *src, Body *dst, float dt,\\n                              float fx, float fy, float fz) {\\n  const float vx = src->vx + dt*fx;\\n  const float vy = src->vy + dt*fy;\\n  const float vz = src->vz + dt*fz;\\n\\n  dst->vx = vx;\\n  dst->vy = vy;\\n  dst->vz = vz;\\n  dst->x = src->x + vx*dt;\\n  dst->y = src->y + vy*dt;\\n  dst->z = src->z + vz*dt;\\n}\\n\\n/* Each work item reads one immutable timestep and writes the next. */\\nstatic inline void advance_block(const Body *restrict src,\\n                                 Body *restrict dst,\\n                                 float dt, int n, int i) {\\n  if (n - i < 4) {\\n    for (; i < n; ++i) {\\n      float fx = 0.0f;\\n      float fy = 0.0f;\\n      float fz = 0.0f;\\n      const float x = src[i].x;\\n      const float y = src[i].y;\\n      const float z = src[i].z;\\n\\n      for (int j = 0; j < n; ++j) {\\n        float dx = src[j].x - x;\\n        float dy = src[j].y - y;\\n        float dz = src[j].z - z;\\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n        float inv_dist = 1 / sqrt(sqrd_dist);\\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n\\n        fx += dx * inv_dist3;\\n        fy += dy * inv_dist3;\\n        fz += dz * inv_dist3;\\n      }\\n\\n      store_step(src + i, dst + i, dt, fx, fy, fz);\\n    }\\n    return;\\n  }\\n\\n  const float x0 = src[i].x;\\n  const float y0 = src[i].y;\\n  const float z0 = src[i].z;\\n  const float x1 = src[i + 1].x;\\n  const float y1 = src[i + 1].y;\\n  const float z1 = src[i + 1].z;\\n  const float x2 = src[i + 2].x;\\n  const float y2 = src[i + 2].y;\\n  const float z2 = src[i + 2].z;\\n  const float x3 = src[i + 3].x;\\n  const float y3 = src[i + 3].y;\\n  const float z3 = src[i + 3].z;\\n  float fx0 = 0.0f, fy0 = 0.0f, fz0 = 0.0f;\\n  float fx1 = 0.0f, fy1 = 0.0f, fz1 = 0.0f;\\n  float fx2 = 0.0f, fy2 = 0.0f, fz2 = 0.0f;\\n  float fx3 = 0.0f, fy3 = 0.0f, fz3 = 0.0f;\\n\\n  for (int j = 0; j < n; ++j) {\\n    const float x = src[j].x;\\n    const float y = src[j].y;\\n    const float z = src[j].z;\\n\\n    float dx0 = x - x0;\\n    float dy0 = y - y0;\\n    float dz0 = z - z0;\\n    float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\\n    float inv_dist0 = 1 / sqrt(sqrd_dist0);\\n    float inv_dist3_0 = inv_dist0 * inv_dist0 * inv_dist0;\\n    fx0 += dx0 * inv_dist3_0;\\n    fy0 += dy0 * inv_dist3_0;\\n    fz0 += dz0 * inv_dist3_0;\\n\\n    float dx1 = x - x1;\\n    float dy1 = y - y1;\\n    float dz1 = z - z1;\\n    float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\\n    float inv_dist1 = 1 / sqrt(sqrd_dist1);\\n    float inv_dist3_1 = inv_dist1 * inv_dist1 * inv_dist1;\\n    fx1 += dx1 * inv_dist3_1;\\n    fy1 += dy1 * inv_dist3_1;\\n    fz1 += dz1 * inv_dist3_1;\\n\\n    float dx2 = x - x2;\\n    float dy2 = y - y2;\\n    float dz2 = z - z2;\\n    float sqrd_dist2 = dx2*dx2 + dy2*dy2 + dz2*dz2 + SOFTENING;\\n    float inv_dist2 = 1 / sqrt(sqrd_dist2);\\n    float inv_dist3_2 = inv_dist2 * inv_dist2 * inv_dist2;\\n    fx2 += dx2 * inv_dist3_2;\\n    fy2 += dy2 * inv_dist3_2;\\n    fz2 += dz2 * inv_dist3_2;\\n\\n    float dx3 = x - x3;\\n    float dy3 = y - y3;\\n    float dz3 = z - z3;\\n    float sqrd_dist3 = dx3*dx3 + dy3*dy3 + dz3*dz3 + SOFTENING;\\n    float inv_dist3 = 1 / sqrt(sqrd_dist3);\\n    float inv_dist3_3 = inv_dist3 * inv_dist3 * inv_dist3;\\n    fx3 += dx3 * inv_dist3_3;\\n    fy3 += dy3 * inv_dist3_3;\\n    fz3 += dz3 * inv_dist3_3;\\n  }\\n\\n  store_step(src + i, dst + i, dt, fx0, fy0, fz0);\\n  store_step(src + i + 1, dst + i + 1, dt, fx1, fy1, fz1);\\n  store_step(src + i + 2, dst + i + 2, dt, fx2, fy2, fz2);\\n  store_step(src + i + 3, dst + i + 3, dt, fx3, fy3, fz3);\\n}\\n\\n/*\\n * Read a binary dataset with initilized bodies.\\n */\\nBody* read_dataset(int *nbodies) {\\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading nbodie value\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading input values\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n\\n  return bodies;\\n}\\n\\n/*\\n * Write simulation results into a binary dataset.\\n */\\nvoid write_dataset(const int nbodies, Body *bodies) {\\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError writing to output\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n}\\n\\nint main(int argc,char **argv) {\\n  int nbodies;\\n\\n  Body *bodies = read_dataset(&nbodies);\\n  Body *scratch = (Body *)malloc((size_t)nbodies * sizeof(Body));\\n\\n  if (scratch != NULL) {\\n    const int nblocks = nbodies / 4 + (nbodies % 4 != 0);\\n\\n    #pragma omp parallel\\n    {\\n      Body *src = bodies;\\n      Body *dst = scratch;\\n\\n      for (int iter = 0; iter < N_ITER; ++iter) {\\n        #pragma omp for schedule(static)\\n        for (int block = 0; block < nblocks; ++block) {\\n          advance_block(src, dst, DT, nbodies, 4 * block);\\n        }\\n\\n        /* The worksharing barrier completes the destination timestep. */\\n        Body *tmp = src;\\n        src = dst;\\n        dst = tmp;\\n      }\\n    }\\n\\n    if (N_ITER % 2 != 0) {\\n      Body *tmp = bodies;\\n      bodies = scratch;\\n      scratch = tmp;\\n    }\\n  } else {\\n    /* Retain the original path if an additional state buffer is unavailable. */\\n    for (int iter = 0; iter < N_ITER; iter++) {\\n      body_force(bodies, DT, nbodies);\\n\\n      for (int i = 0; i < nbodies; i++) {\\n        bodies[i].x += bodies[i].vx * DT;\\n        bodies[i].y += bodies[i].vy * DT;\\n        bodies[i].z += bodies[i].vz * DT;\\n      }\\n    }\\n  }\\n\\n  write_dataset(nbodies, bodies);\\n\\n  free(scratch);\\n  free(bodies);\\n\\n  exit(EXIT_SUCCESS);\\n}\\n\",\n      \"path\": \"src/nbody.c\"\n    }\n  ],\n  \"hypothesis\": \"Ping-pong state buffers permit fused force and position updates in four-body static work items, reducing synchronization to one barrier per timestep and avoiding concurrent writes to the force source buffer.\",\n  \"notes\": \"Preserves ascending accumulation order, original sqrt precision, standalone body_force behavior and binary I/O. Allocation failure uses the original path. No commands executed.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Keep one persistent OpenMP team across simulation iterations.\",\n    \"Fuse force computation and position integration using immutable source and separate destination states.\",\n    \"Statically distribute four-body work items with independent accumulators and a scalar remainder.\"\n  ]\n}"}}

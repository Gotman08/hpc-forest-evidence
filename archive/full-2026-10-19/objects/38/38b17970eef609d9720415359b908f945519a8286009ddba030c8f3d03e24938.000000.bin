#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

/* Positions and velocities of one body. */
typedef struct { float x, y, z, vx, vy, vz; } Body;

/* Force-only operation, also used by the allocation-failure fallback. */
void body_force(Body *p, float dt, int n) {
  for (int i = 0; i < n; ++i) {
    float fx = 0.0f;
    float fy = 0.0f;
    float fz = 0.0f;

    for (int j = 0; j < n; j++) {
      float dx = p[j].x - p[i].x;
      float dy = p[j].y - p[i].y;
      float dz = p[j].z - p[i].z;
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1 / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    p[i].vx += dt*fx;
    p[i].vy += dt*fy;
    p[i].vz += dt*fz;
  }
}

static inline void advance_one(const Body *restrict p,
                               Body *restrict next,
                               float dt, int n, int i) {
  const float x = p[i].x;
  const float y = p[i].y;
  const float z = p[i].z;
  float fx = 0.0f;
  float fy = 0.0f;
  float fz = 0.0f;

  for (int j = 0; j < n; ++j) {
    float dx = p[j].x - x;
    float dy = p[j].y - y;
    float dz = p[j].z - z;
    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
    float inv_dist = 1 / sqrt(sqrd_dist);
    float inv_dist3 = inv_dist * inv_dist * inv_dist;
    fx += dx * inv_dist3;
    fy += dy * inv_dist3;
    fz += dz * inv_dist3;
  }

  const float vx = p[i].vx + dt*fx;
  const float vy = p[i].vy + dt*fy;
  const float vz = p[i].vz + dt*fz;
  next[i].vx = vx;
  next[i].vy = vy;
  next[i].vz = vz;
  next[i].x = x + vx*dt;
  next[i].y = y + vy*dt;
  next[i].z = z + vz*dt;
}

/* Each work item advances three bodies without reordering any force sum. */
static inline void advance_three(const Body *restrict p,
                                 Body *restrict next,
                                 float dt, int n, int i) {
  const float x0 = p[i].x;
  const float y0 = p[i].y;
  const float z0 = p[i].z;
  const float x1 = p[i + 1].x;
  const float y1 = p[i + 1].y;
  const float z1 = p[i + 1].z;
  const float x2 = p[i + 2].x;
  const float y2 = p[i + 2].y;
  const float z2 = p[i + 2].z;
  float fx0 = 0.0f, fy0 = 0.0f, fz0 = 0.0f;
  float fx1 = 0.0f, fy1 = 0.0f, fz1 = 0.0f;
  float fx2 = 0.0f, fy2 = 0.0f, fz2 = 0.0f;

  for (int j = 0; j < n; ++j) {
    const float sx = p[j].x;
    const float sy = p[j].y;
    const float sz = p[j].z;

    float dx = sx - x0;
    float dy = sy - y0;
    float dz = sz - z0;
    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
    float inv_dist = 1 / sqrt(sqrd_dist);
    float inv_dist3 = inv_dist * inv_dist * inv_dist;
    fx0 += dx * inv_dist3;
    fy0 += dy * inv_dist3;
    fz0 += dz * inv_dist3;

    dx = sx - x1;
    dy = sy - y1;
    dz = sz - z1;
    sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
    inv_dist = 1 / sqrt(sqrd_dist);
    inv_dist3 = inv_dist * inv_dist * inv_dist;
    fx1 += dx * inv_dist3;
    fy1 += dy * inv_dist3;
    fz1 += dz * inv_dist3;

    dx = sx - x2;
    dy = sy - y2;
    dz = sz - z2;
    sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
    inv_dist = 1 / sqrt(sqrd_dist);
    inv_dist3 = inv_dist * inv_dist * inv_dist;
    fx2 += dx * inv_dist3;
    fy2 += dy * inv_dist3;
    fz2 += dz * inv_dist3;
  }

  const float vx0 = p[i].vx + dt*fx0;
  const float vy0 = p[i].vy + dt*fy0;
  const float vz0 = p[i].vz + dt*fz0;
  next[i].vx = vx0;
  next[i].vy = vy0;
  next[i].vz = vz0;
  next[i].x = x0 + vx0*dt;
  next[i].y = y0 + vy0*dt;
  next[i].z = z0 + vz0*dt;

  const float vx1 = p[i + 1].vx + dt*fx1;
  const float vy1 = p[i + 1].vy + dt*fy1;
  const float vz1 = p[i + 1].vz + dt*fz1;
  next[i + 1].vx = vx1;
  next[i + 1].vy = vy1;
  next[i + 1].vz = vz1;
  next[i + 1].x = x1 + vx1*dt;
  next[i + 1].y = y1 + vy1*dt;
  next[i + 1].z = z1 + vz1*dt;

  const float vx2 = p[i + 2].vx + dt*fx2;
  const float vy2 = p[i + 2].vy + dt*fy2;
  const float vz2 = p[i + 2].vz + dt*fz2;
  next[i + 2].vx = vx2;
  next[i + 2].vy = vy2;
  next[i + 2].vz = vz2;
  next[i + 2].x = x2 + vx2*dt;
  next[i + 2].y = y2 + vy2*dt;
  next[i + 2].z = z2 + vz2*dt;
}

/* Read a binary dataset with initialized bodies. */
Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  return bodies;
}

/* Write simulation results into a binary dataset. */
void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc, char **argv) {
  int nbodies;
  Body *bodies = read_dataset(&nbodies);
  Body *scratch = (Body *)malloc((size_t)nbodies * sizeof(Body));
  Body *result = bodies;

  if (scratch != NULL) {
    const int nblocks = nbodies / 3 + (nbodies % 3 != 0);

    #pragma omp parallel if (nblocks >= 4)
    {
      Body *current = bodies;
      Body *next = scratch;

      for (int iter = 0; iter < N_ITER; ++iter) {
        #pragma omp for schedule(static)
        for (int block = 0; block < nblocks; ++block) {
          const int i = 3 * block;
          if (nbodies - i >= 3) {
            advance_three(current, next, DT, nbodies, i);
          } else {
            for (int k = i; k < nbodies; ++k) {
              advance_one(current, next, DT, nbodies, k);
            }
          }
        }

        /* The worksharing barrier completes the entire next state. */
        Body *tmp = current;
        current = next;
        next = tmp;
      }
    }

    if (N_ITER % 2 != 0) {
      result = scratch;
    }
  } else {
    for (int iter = 0; iter < N_ITER; ++iter) {
      body_force(bodies, DT, nbodies);
      for (int i = 0; i < nbodies; ++i) {
        bodies[i].x += bodies[i].vx * DT;
        bodies[i].y += bodies[i].vy * DT;
        bodies[i].z += bodies[i].vz * DT;
      }
    }
  }

  write_dataset(nbodies, result);
  free(scratch);
  free(bodies);
  exit(EXIT_SUCCESS);
}

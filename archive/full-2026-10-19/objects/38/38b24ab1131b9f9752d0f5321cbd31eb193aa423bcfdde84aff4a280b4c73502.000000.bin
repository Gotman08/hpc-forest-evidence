n+   (void)nbuckets;\\n+   if (size <= 0)\\n+      return NULL;\\n+\\n+   returns = (long int *)malloc(sizeof(long int) * (size_t)size);\\n+   scratch = (long int *)malloc(sizeof(long int) * (size_t)size);\\n+   info = (string_info *)malloc(sizeof(string_info) * (size_t)size);\\n+   digits = (unsigned short *)malloc(sizeof(unsigned short) * (size_t)size);\\n+   if (returns == NULL || scratch == NULL || info == NULL || digits == NULL) {\\n+      free(returns);\\n+      free(scratch);\\n+      free(info);\\n+      free(digits);\\n+      return NULL;\\n+   }\\n+\\n+   for (long int i = 0; i < size; i++) {\\n+      const char *token = a + (size_t)i * (size_t)length;\\n+      info[i].length = strlen(token);\\n+      if (info[i].length > max_length)\\n+         max_length = info[i].length;\\n+      returns[i] = i;\\n+   }\\n+\\n+   source = returns;\\n+   destination = scratch;\\n+\\n+   /* Stable LSD passes, with NUL padding so variable-length tokens sort like strcmp. */\\n+   for (size_t position = max_length; position > 0; position--) {\\n+      size_t counts[257] = {0};\\n+      size_t byte_position = position - 1;\\n+\\n+      /* Cache each key once; the histogram still has true counter dependencies. */\\n+      for (long int i = 0; i < size; i++) {\\n+         size_t index = (size_t)source[i];\\n+         unsigned int digit = 0;\\n+         if (byte_position < info[index].length) {\\n+            const unsigned char *token = (const unsigned char *)\\n+               (a + index * (size_t)length);\\n+            digit = (unsigned int)token[byte_position] + 1U;\\n+         }\\n+         digits[i] = (unsigned short)digit;\\n+         counts[digit]++;\\n+      }\\n+\\n+      size_t next = 0;\\n+      for (size_t digit = 0; digit < 257; digit++) {\\n+         size_t count = counts[digit];\\n+         counts[digit] = next;\\n+         next += count;\\n+      }\\n+\\n+      for (long int i = 0; i < size; i++) {\\n+         unsigned int digit = (unsigned int)digits[i];\\n+         destination[counts[digit]++] = source[i];\\n+      }\\n+\\n+      long int *tmp = source;\\n+      source = destination;\\n+      destination = tmp;\\n+   }\\n+\\n+   if (source != returns)\\n+      memcpy(returns, source, sizeof(long int) * (size_t)size);\\n+\\n+   free(scratch);\\n+   free(info);\\n+   free(digits);\\n+   return returns;\\n+}\\n+\\n+void load(char **vString, long int *N, int *l, int *os, int *nb){\\n+   char *strings = NULL;\\n+   int      len,\\n+            offset,\\n+   \"}, {\"id\": \"621efae6434b4141\", \"role\": \"A\", \"commit\": \"a8f24254ba97aca637024a1b863b0f82d12307eb\", \"transformations\": {\"files\": [\"src/bucketsort.c\"], \"retained\": [\"Count records per bucket and prefix-sum counts to create exact contiguous bucket ranges.\", \"Scatter indices into those ranges in input order.\", \"Sort each range with stable iterative mergesort using one reusable scratch array and strcmp comparisons.\"]}, \"mean_seconds\": 0.014301793028910955, \"diff\": \"diff --git a/src/bucketsort.c b/src/bucketsort.c\\nindex 9987e6c..ee8d64c 100644\\n--- a/src/bucketsort.c\\n+++ b/src/bucketsort.c\\n@@ -1,142 +1,181 @@\\n-#include <stdio.h>\\n-#include <stdlib.h>\\n-#include <assert.h>\\n-#include <string.h>\\n-\\n-typedef struct {\\n-\\tlong int *data;\\n-\\tint length;\\n-\\tlong int total;\\n-} bucket;\\n-\\n-void sort(char *a, bucket *bucket) {\\n-\\tint j, i, length;\\n-\\tlong int key;\\n-\\tlength = bucket->length;\\n-\\n-\\tfor (j = 1; j < bucket->total; j++) {\\n-\\t\\tkey = bucket->data[j];\\n-\\t\\ti = j - 1;\\n-\\t\\twhile (i >= 0 && strcmp(a + bucket->data[i] * length, a + key * length) > 0) {\\n-\\t\\t\\tbucket->data[i + 1] = bucket->data[i];\\n-\\t\\t\\ti--;\\n-\\t\\t}\\n-\\t\\tbucket->data[i + 1] = key;\\n-\\t}\\n-}\\n-\\n-\\n-long int* bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\\n-\\n-\\tlong int i;\\n-\\tbucket   *buckets = NULL,\\n-             *b = NULL;\\n-\\tlong int *returns = NULL;\\n-\\n-\\t//
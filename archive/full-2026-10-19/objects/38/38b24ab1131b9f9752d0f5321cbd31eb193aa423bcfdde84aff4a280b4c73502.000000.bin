(i = 0; i < nbuckets; i++)\\n-\\t\\tsort(a, &buckets[i]);\\n-\\n-\\treturn returns;\\n-}\\n-\\n-void load(char **vString, long int *N, int *l, int *os, int *nb){\\n-   char *strings = NULL;\\n-   int      len,\\n-            offset,\\n-            nbucket;\\n-   long int n;\\n-\\n-   if (!fscanf(stdin, \\\"%d\\\", &len)) {\\n-      printf (\\\"ERROR len\\\\n\\\");\\n-      exit (1);\\n-   }\\n-\\n-   if (!fscanf(stdin, \\\"%ld\\\", &n)) {\\n-      printf (\\\"ERROR n\\\\n\\\");\\n-      exit (1);\\n-   }\\n-\\n-   if (!fscanf(stdin, \\\"%d\\\", &offset)) {\\n-      printf (\\\"ERROR offset\\\\n\\\");\\n-      exit (1);\\n-   }\\n-\\n-   if (!fscanf(stdin, \\\"%d\\\", &nbucket)) {\\n-      printf (\\\"ERROR nbucket\\\\n\\\");\\n-      exit (1);\\n-   }\\n-\\n-   nbucket = nbucket + 1;\\n-   len = len + 1;\\n-\\n-   strings = (char*) malloc(n * len);\\n-\\n-   for (int i = 0; i < n; i++){\\n-      if (!fscanf(stdin, \\\"%s\\\", strings + (i * len))) {\\n-      printf (\\\"ERROR %d\\\\n\\\",i);\\n-      exit (1);\\n-      }\\n-   }\\n-\\n-   *vString = strings;\\n-   *N = n;\\n-   *l = len;\\n-   *os = offset;\\n-   *nb = nbucket;\\n-}\\n-\\n-void print(char *strings, long int *index, long int n, int len){\\n-\\n-   for (int i = 0; i < n; i++){\\n-      printf(\\\"%d -> %s\\\\n\\\", i, strings + (index[i] * len));\\n-   }\\n-}\\n-\\n-void save(char *strings, long int *index, long int n, int len){\\n-   for (int i = 0; i < n; i++){\\n-      printf(\\\"%s\\\\n\\\", strings + (index[i] * len));\\n-   }\\n-}\\n-\\n-int main(int ac, char **av) {\\n-\\n-   char     *strings = NULL;\\n-   long int N        = 0;\\n-   long int *index   = NULL;\\n-   int      len      = 0,\\n-            save2File = 0,\\n-            offset,\\n-            nbuckets;\\n-\\n-   load(&strings, &N, &len, &offset, &nbuckets);\\n-\\n-   index = bucket_sort(strings, len, N, offset, nbuckets);\\n-\\n-   save(strings, index, N, len);\\n-\\n-   if (strings != NULL)\\n-      free(strings);\\n-\\n-   if (index != NULL)\\n-      free(index);\\n-\\n-   return EXIT_SUCCESS;\\n-}\\n+#include <stdio.h>\\n+#include <stdlib.h>\\n+#include <assert.h>\\n+#include <string.h>\\n+\\n+/* qsort's comparator reads this shared, immutable input while bucket sorts run. */\\n+static char *sort_strings;\\n+static int sort_length;\\n+\\n+typedef struct {\\n+\\tlong int *data;\\n+\\tlong int total;\\n+} bucket;\\n+\\n+static int compare_indices(const void *left, const void *right) {\\n+\\tlong int left_index = *(const long int *)left;\\n+\\tlong int right_index = *(const long int *)right;\\n+\\treturn strcmp(sort_strings + left_index * sort_length,\\n+\\t              sort_strings + right_index * sort_length);\\n+}\\n+\\n+long int* bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\\n+\\tlong int i;\\n+\\tlong int start = 0;\\n+\\tlong int *returns = NULL;\\n+\\tlong int *counts = NULL;\\n+\\tbucket *buckets = NULL;\\n+\\n+\\tif (size <= 0)\\n+\\t\\treturn NULL;\\n+\\n+\\treturns = (long int *)malloc(sizeof(long int) * size);\\n+\\tcounts = (long int *)calloc((size_t)nbuckets, sizeof(long int));\\n+\\tbuckets = (bucket *)malloc(sizeof(bucket) * (size_t)nbuckets);\\n+\\n+\\t/* Count first, then assign disjoint, exactly sized ranges in returns. */\\n+\\tfor (i = 0; i < size; i++) {\\n+\\t\\tint key = *(a + i * length) - offset;\\n+\\t\\tcounts[key]++;\\n+\\t}\\n+\\n+\\tfor (i = 0; i < nbuckets; i++) {\\n+\\t\\tbuckets[i].data = returns + start;\\n+\\t\\tbuckets[i].total = 0;\\n+\\t\\tstart += counts[i];\\n+\\t}\\n+\\n+\\t/* Fill the bucket ranges with indices into the original strings. */\\n+\\tfor (i = 0; i < size; i++) {\\n+\\t\\tint key = *(a + i * length) - offset;\\n+\\t\\tbucket *b = &buckets[key];\\n+\\t\\tb->data[b->total++] = i;\\n+\\t}\\n+\\n+\\tsort_strings = a;\\n+\\tsort_length = length;\\n+\\tif (size >= 4096 && nbuckets > 1) {\\n+\\t\\t#pragma omp parallel for schedule(dynamic, 1) num_threads(4)\\n+\\t\\tfor (int j = 0; j < nbuckets; j++)\\n+\\t\\t\\tqsort(buckets[j].data, (size_t)buckets[j].total,\\n+\\t\\t\\t      sizeof(long int), compare_indices);\\n+\\t} else {\\n+\\t\\tfor (i = 0; i < nbuckets; i++)\\n+\\t\\t\\tqsort(buckets[i].data, (size_t)buckets[i].total,\\n+\\t\\t\\t      sizeof(long int), compare_indices);\\n+\\t}\\n+\\n+\\tfree(counts);\\n+\\tfree(buckets);\\n+\\treturn returns;\\n+}\\n+\\n+void load(char **vString, long int *N, int *l, int *os, int *nb){\\n+   char *strings = NULL;\\n+   int      len,\\n+            offset,\\n+            nbucket;\\n+   long int n;\\n+\\n+   if (!fscanf(stdin, \\\"%d\\\", &len)) {\\n+      printf (\\\"ERROR len\\\\n\\\");\\n+      exit (1);\\n+   }\\n+\\n+   if (!fscanf(stdin, \\\"%ld\\\", &n)) {\\n+      printf (\\\"ERROR n\\\\n\\\");\\n+      exit (1);\\n+   }\\n+\\n+   if (!fscanf(stdin, \\\"%d\\\", &offset)) {\\n+      printf (\\\"ERROR offset\\\\n\\\");\\n+      exit (1);\\n+   }\\n+\\n+   if (!fscanf(stdin, \\\"%d\\\", &nbucket)) {\\n+      printf (\\\"ERROR nbucket\\\\n\\\");\\n+      exit (1);\\n+   }\\n+\\n+   nbucket = nbucket + 1;\\n+   len = len + 1;\\n+\\n+   strings = (char*) malloc(n * len);\\n+\\n+   for (int i = 0; i < n; i++){\\n+      if (!fscanf(stdin, \\\"%s\\\", strings + (i * len))) {\\n+      printf (\\\"ERROR %d\\\\n\\\",i);\\n+      exit (1);\\n+      }\\n+   }\\n+\\n+   *vString = strings;\\n+   *N = n;\\n+   *l \"}, {\"id\": \"3002959ae05642e3\", \"role\": \"B\", \"commit\": \"dcdf44b4f592d48615dbb736c489960e5af2ea04\", \"transformations\": {\"files\": [\"src/bucketsort.c\"], \"retained\": [\"Store each pass's computed digit in a same-order unsigned-short array and reuse it during scatter, eliminating the second key extraction without claiming that conflicting histogram updates are SIMD-independent.\"]}, \"mean_seconds\": 0.013482446782290936, \"diff\": \"diff --git a/src/bucketsort.c b/src/bucketsort.c\\nindex 9987e6c..9b944b9 100644\\n--- a/src/bucketsort.c\\n+++ b/src/bucketsort.c\\n@@ -1,142 +1,167 @@\\n-#include <stdio.h>\\n-#includ
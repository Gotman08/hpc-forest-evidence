#include "knn.h"

#define BLOCK_SIZE 1024

typedef struct {
    float distance;
    char label;
} Neighbor;

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    Neighbor neighbors[k];

    for (int i = 0; i < k; i++) {
        neighbors[i].distance = -1;
        neighbors[i].label = -1;
    }

    for (int i = 0; i < n_groups; i += BLOCK_SIZE) {
        int block_end = (i + BLOCK_SIZE > n_groups) ? n_groups : i + BLOCK_SIZE;
        for (int j = i; j < block_end; j++) {
            Group g = groups[j];

            for (int l = 0; l < g.length; l++) {
                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[l]);

                if (d < neighbors[k - 1].distance || neighbors[k - 1].distance == -1) {
                    int pos = k - 1;
                    while (pos > 0 && d < neighbors[pos - 1].distance) {
                        neighbors[pos] = neighbors[pos - 1];
                        pos--;
                    }
                    neighbors[pos].distance = d;
                    neighbors[pos].label = g.label;
                }
            }
        }
    }

    qsort(neighbors, k, sizeof(Neighbor), compare_for_sort);

    char most_frequent = neighbors[0].label;
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (int i = 1; i < k; i++) {
        if (neighbors[i].label != neighbors[i - 1].label) {
            if (current_frequency > most_frequent_count) {
                most_frequent = neighbors[i - 1].label;
                most_frequent_count = current_frequency;
            }

            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = neighbors[i].label;
            most_frequent_count = current_frequency;
        }
    }

    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}
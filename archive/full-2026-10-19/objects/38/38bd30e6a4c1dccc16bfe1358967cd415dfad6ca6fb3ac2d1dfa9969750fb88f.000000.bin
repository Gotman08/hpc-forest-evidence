        "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nstatic const int64_t MOD = 1000000007LL;\n\nstruct Point {\n    int row;\n    int col;\n\n    bool operator<(const Point& other) const {\n        if (row != other.row) return row < other.row;\n        return col < other.col;\n    }\n\n    bool operator==(const Point& other) const {\n        return row == other.row && col == other.col;\n    }\n};\n\nstatic int64_t mod_pow(int64_t base, int64_t exponent) {\n    int64_t result = 1;\n    while (exponent > 0) {\n        if (exponent & 1) result = result * base % MOD;\n        base = base * base % MOD;\n        exponent >>= 1;\n    }\n    return result;\n}\n\nstatic int64_t choose_paths(\n    int steps,\n    int row_steps,\n    const vector<int64_t>& factorial,\n    const vector<int64_t>& inverse_factorial\n) {\n    return factorial[steps] * inverse_factorial[row_steps] % MOD\n         * inverse_factorial[steps - row_steps] % MOD;\n}\n\nstatic int64_t dense_count(int n, const vector<Point>& blocked) {\n    vector<int64_t> dp(n, 0);\n    dp[0] = 1;\n    size_t next_blocked = 0;\n\n    for (int row = 0; row < n; ++row) {\n        for (int col = 0; col < n; ++col) {\n            bool is_blocked = next_blocked < blocked.size()\n                && blocked[next_blocked].row == row\n                && blocked[next_blocked].col == col;\n            if (is_blocked) ++next_blocked;\n\n            if (is_blocked) {\n                dp[col] = 0;\n            } else if (col > 0) {\n                dp[col] += dp[col - 1];\n                if (dp[col] >= MOD) dp[col] -= MOD;\n            }\n        }\n    }\n\n    return dp[n - 1];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<Point> blocked;\n    blocked.reserve(static_cast<size_t>(m));\n    bool blocked_start = false;\n    bool blocked_finish = false;\n\n    for (int i = 0; i < m; ++i) {\n        int row, col;\n        cin >> row >> col;\n        blocked.push_back({row, col});\n        if (row == 0 && col == 0) blocked_start = true;\n        if (row == n - 1 && col == n - 1) blocked_finish = true;\n    }\n\n    if (blocked_start || blocked_finish) {\n        cout << 0 << '\\n';\n        return 0;\n    }\n\n    sort(blocked.begin(), blocked.end());\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\n\n    if (blocked.size() > static_cast<size_t>(n)) {\n        cout << dense_count(n, blocked) << '\\n';\n        return 0;\n    }\n\n    const int max_steps = 2 * (n - 1);\n    vector<int64_t> factorial(max_steps + 1, 1);\n    vector<int64_t> inverse_factorial(max_steps + 1, 1);\n\n    for (int i = 1; i <= max_steps; ++i) {\n        factorial[i] = factorial[i - 1] * i % MOD;\n    }\n    inverse_factorial[max_steps] = mod_pow(factorial[max_steps], MOD - 2);\n    for (int i = max_steps; i > 0; --i) {\n        inverse_factorial[i - 1] = inverse_factorial[i] * i % MOD;\n    }\n\n    vector<int64_t> ways(blocked.size(), 0);\n    for (size_t i = 0; i < blocked.size(); ++i) {\n        const Point& point = blocked[i];\n        int64_t current = choose_paths(\n            point.row + point.col, point.row, factorial, inverse_factorial);\n\n        for (size_t j = 0; j < i; ++j) {\n            const Point& previous = blocked[j];\n            if (previous.row > point.row || previous.col > point.col) continue;\n\n            int row_steps = point.row - previous.row;\n            int col_steps = point.col - previous.col;\n            int steps = row_steps + col_steps;\n            current -= ways[j] * choose_paths(\n                steps, row_steps, factorial, inverse_factorial) % MOD;\n            if (current < 0) current += MOD;\n        }\n        ways[i] = current;\n    }\n\n    int destination = n - 1;\n    int64_t answer = choose_paths(\n        2 * destination, destination, factorial, inverse_factorial);\n\n    for (size_t i = 0; i < blocked.size(); ++i) {\n        const Point& point = blocked[i];\n        int row_steps = destination - point.row;\n        int col_steps = destination - point.col;\n        int steps = row_steps + col_steps;\n        answer -= ways[i] * choose_paths(\n            steps, row_steps, factorial, inverse_factorial) % MOD;\n        if (answer < 0) answer += MOD;\n    }\n\n    cout << answer << '\\n';\n    return 0;\n}\n",

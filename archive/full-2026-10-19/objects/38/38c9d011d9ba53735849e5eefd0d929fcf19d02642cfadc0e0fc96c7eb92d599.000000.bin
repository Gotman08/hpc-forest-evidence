  "files": [
    {
      "content": "#include <iostream>\n#include <string>\n#include <map>\n#include <list>\n#include <queue>\n#include <climits>\n#include <cstdio>\n#include <utility>\n#include <vector>\n\nusing namespace std;\n\nint nCores = 0;\nint nVertices = 0;\nint nArestas = 0;\nint no_of_vert = 0;\nint contCor = 0;\n\nvector<int> caminhoTropical;\nvector<int> caminho;\nvector<pair<int, int>> arvoreGeradora;\n\nstruct part\n{\n    vector<pair<int, int>> spanning;\n    vector<pair<int, int>> inc_ed;\n    vector<pair<int, int>> exc_ed;\n};\n\nvector<part> partitions;\nvector<pair<int, int>> current_span;\n\nclass graph{\n    public:\n        int Vertex;\n        vector<vector<int>> adj_mat;\n        vector<int> cores;\n\n        graph(int vertex)\n        {\n            Vertex = vertex;\n            for(int i = 0; i < Vertex; i++){\n                vector<int> aux;\n                for(int j = 0; j < Vertex; j++){\n                    aux.push_back(0);\n                }\n                adj_mat.push_back(aux);\n            }\n\n            for(int i = 0; i < Vertex; i++)\n                cores.push_back(0);\n        }\n\n        void add_edge(int u, int v)\n        {\n            adj_mat[u][v] = adj_mat[v][u] = 1;\n        }\n};\n\nint find_min_key(const vector<int>& arr, int V, const vector<bool>& mstset)\n{\n    int min_key=INT_MAX, min_index=-1;\n    for(int i=0;i<V;i++)\n    {\n        if(arr[i]<min_key && mstset[i]==false){\n            min_key=arr[i];\n            min_index=i;\n        }\n    }\n    return min_index;\n}\n\nbool is_cycle(const vector<vector<int>>& mat, int src, int V)\n{\n    map<int,bool> visited;\n    queue<int> traverse;\n    map<int,int> parent;\n    parent[src]=src;\n    visited[src]=true;\n    traverse.push(src);\n    while(!traverse.empty())\n    {\n        int node=traverse.front();\n        traverse.pop();\n        for(int i=0;i<V;i++)\n            if(mat[node][i]>0)\n            {\n                if(!visited[i])\n                {\n                    traverse.push(i);\n                    visited[i]=true;\n                    parent[i]=node;\n                }\n                else if(visited[i]==true && i!=parent[node])\n                    return 1;\n            }\n    }\n    return 0;\n}\n\nint Prim_ST(const graph& G, const vector<pair<int,int>>& include_edges,\n            const vector<pair<int,int>>& exclude_edges)\n{\n    int V = G.Vertex;\n\n    vector<vector<int>> new_mat;\n    vector<vector<int>> mat_cycle;\n\n    for(int i = 0; i < V; i++){\n        vector<int> aux;\n        for(int j = 0; j < V; j++){\n            aux.push_back(0);\n        }\n        mat_cycle.push_back(aux);\n    }\n\n    for(int i = 0; i < V; i++){\n        vector<int> aux;\n        for(int j = 0; j < V; j++){\n            aux.push_back(G.adj_mat[i][j]);\n        }\n        new_mat.push_back(aux);\n    }\n\n    int u1,v1;\n    for(vector<pair<int, int>>::const_iterator it=exclude_edges.begin(); it!=exclude_edges.end();it++)\n    {\n        u1=(*it).first;\n        v1=(*it).second;\n        new_mat[u1][v1]=new_mat[v1][u1]=INT_MIN;\n    }\n\n    int parent[V];\n    vector<int> key(V);\n    vector<bool> mstset(V);\n    for(int i=0;i<V;i++)\n    {\n        key[i]=INT_MAX;\n        mstset[i]=false;\n        parent[i]=nVertices;\n    }\n\n    int root;\n    root= 0;\n    parent[root]=-1;\n\n    int vertex_must_include[V];\n    map<int, int> parent_included_vertex;\n\n    for(int m=0;m<V;m++)\n        vertex_must_include[m]=false;\n    if(!include_edges.empty())\n    {\n        for(vector<pair<int, int>>::const_iterator it=include_edges.begin(); it!=include_edges.end();it++)\n        {\n            u1=(*it).first;\n            v1=(*it).second;\n            vertex_must_include[u1]=vertex_must_include[v1]=true;\n            parent_included_vertex[v1]=u1;\n            parent_included_vertex[u1]=100;\n        }\n    }\n\n    key[root]=0;\n    parent[root]=-1;\n    for(int c=0;c<V;c++)\n    {\n        int u=find_min_key(key, V, mstset);\n        if(u==-1)\n        {\n            return -1;\n        }\n        mstset[u]=true;\n        if(parent[u] > 0)\n            mat_cycle[parent[u]][u]=new_mat[parent[u]][u];\n        no_of_vert++;\n        for(int v=0;v<V;v++)\n        {\n            if(new_mat[u][v]>0 && mstset[v]==false && new_mat[u][v]< key[v])\n            {\n                if(vertex_must_include[v] && parent_included_vertex[v]!=100 && parent_included_vertex[v]!=u)\n                {\n                    int x=parent_included_vertex[v];\n                    if(parent[x]!=nVertices)\n                        continue;\n                }\n                int prev=mat_cycle[u][v];\n                mat_cycle[u][v]=new_mat[u][v];\n\n                bool cycle=is_cycle(mat_cycle, root, V);\n                if(!cycle)\n                {\n                    parent[v]=u;\n                    key[v]=new_mat[u][v];\n                }\n                mat_cycle[u][v]=prev;\n            }\n        }\n    }\n\n    int tot_cost=0;\n    for(int i=1;i<V;i++){\n        int x=parent[i];\n        tot_cost+=new_mat[x][i];\n        current_span.push_back(make_pair(x, i));\n    }\n    return tot_cost;\n}\n\nvoid exibirVetor(const vector<int>& l)\n{\n    for(vector<int>::const_iterator it = l.begin(); it != l.end(); ++it)\n    {\n        if(*it == l.back())\n            cout << *it;\n        else\n            cout << *it << \"-\";\n    }\n    cout<<endl;\n}\n\nbool buscaSequencial(const vector<int>& l, int ch){\n    for(vector<int>::const_iterator it = l.begin(); it != l.end(); ++it)\n        if(ch == *it) return true;\n    return false;\n}\n\nvector<int> buscaAresta(int vert){\n    vector<int> aux;\n    for(vector<pair<int, int>>::const_iterator it = arvoreGeradora.begin(); it != arvoreGeradora.end(); ++it){\n        pair<int, int> par = *it;\n        if(vert == par.first) aux.push_back(par.second);\n        if(vert == par.second) aux.push_back(par.first);\n    }\n    return aux;\n}\n\nint coresConjunto(const vector<int>& l, const graph& G){\n    vector<int> cor;\n\n    for(vector<int>::const_iterator it = l.begin(); it != l.end(); ++it){\n        if(!buscaSequencial(cor, G.cores[*it])){\n            cor.push_back(G.cores[*it]);\n        }\n    }\n    return cor.size();\n}\n\nstruct PathSearchResult\n{\n    bool tropical;\n    int colors;\n    vector<int> path;\n\n    PathSearchResult() : tropical(false), colors(0) {}\n};\n\nPathSearchResult buscaProfunda(int vertice, vector<int>& hist, const graph& G)\n{\n    hist.push_back(vertice);\n    vector<int> aux = buscaAresta(vertice);\n    bool fim = true;\n    PathSearchResult melhor;\n\n    for(vector<int>::const_iterator it = aux.begin(); it != aux.end(); ++it){\n        if(!buscaSequencial(hist, *it)){\n            fim = false;\n            PathSearchResult candidato = buscaProfunda(*it, hist, G);\n            if(candidato.tropical){\n                hist.pop_back();\n                return candidato;\n            }\n            if(candidato.colors > melhor.colors){\n                melhor = candidato;\n            }\n        }\n    }\n\n    if(fim){\n        melhor.colors = coresConjunto(hist, G);\n        melhor.path = hist;\n        melhor.tropical = (melhor.colors == nCores);\n    }\n\n    hist.pop_back();\n    return melhor;\n}\n\nPathSearchResult buscaRaiz(int raiz, const graph& G)\n{\n    vector<int> historico;\n    historico.push_back(raiz);\n    vector<int> vertices = buscaAresta(raiz);\n    PathSearchResult melhor;\n\n    for(vector<int>::const_iterator it = vertices.begin(); it != vertices.end(); ++it){\n        PathSearchResult candidato = buscaProfunda(*it, historico, G);\n        if(candidato.tropical){\n            return candidato;\n        }\n        if(candidato.colors > melhor.colors){\n            melhor = candidato;\n        }\n    }\n    return melhor;\n}\n\nbool aceitarResultado(const PathSearchResult& resultado)\n{\n    if(resultado.tropical){\n        exibirVetor(resultado.path);\n        cout << nCores;\n        return true;\n    }\n    if(resultado.colors > contCor){\n        contCor = resultado.colors;\n        caminho = resultado.path;\n    }\n    return false;\n}\n\nbool caminhoTropi(const graph& G){\n    int raiz = 0;\n    const int serial_roots = nVertices < 4 ? nVertices : 4;\n\n    for(; raiz < serial_roots; ++raiz){\n        if(aceitarResultado(buscaRaiz(raiz, G))){\n            return true;\n        }\n    }\n\n#ifdef _OPENMP\n    const int remaining_roots = nVertices - raiz;\n    if(remaining_roots >= 64){\n        vector<PathSearchResult> resultados(remaining_roots);\n\n#pragma omp parallel for schedule(static)\n        for(int offset = 0; offset < remaining_roots; ++offset){\n            resultados[offset] = buscaRaiz(raiz + offset, G);\n        }\n\n        for(int offset = 0; offset < remaining_roots; ++offset){\n            if(aceitarResultado(resultados[offset])){\n                return true;\n            }\n        }\n        return false;\n    }\n#endif\n\n    for(; raiz < nVertices; ++raiz){\n        if(aceitarResultado(buscaRaiz(raiz, G))){\n            return true;\n        }\n    }\n    return false;\n}\n\nbool create_partitions(const graph& G)\n{\n    while(true)\n    {\n        part P;\n        vector<part>::iterator iter;\n        for(vector<part>::iterator it=partitions.begin();it!=partitions.end();it++)\n        {\n            iter=it;\n        }\n        P.spanning=(*iter).spanning;\n        P.exc_ed=(*iter).exc_ed;\n        P.inc_ed=(*iter).inc_ed;\n        partitions.erase(iter);\n\n        vector<pair<int, int>> stree = P.spanning;\n        vector<pair<int, int>>::iterator it1;\n        vector<pair<int, int>>::iterator it2;\n\n        arvoreGeradora = stree;\n\n        if(caminhoTropi(G)){\n            return true;\n        }\n\n        vector<pair<int, int>> included_edges;\n        vector<pair<int, int>> excluded_edges;\n        included_edges=P.inc_ed;\n        pair<int, int> ex_edge;\n\n        int j;\n        for(j = 0; j < stree.size(); j++)\n        {\n            if(included_edges.empty())\n                break;\n            if(stree[j].first!=included_edges[j].first && stree[j].second!=included_edges[j].second)\n            {\n                break;\n            }\n        }\n        int cost;\n        it2= stree.begin()+ j;\n        int u1,v1;\n        for(it1=it2; it1!=stree.end(); it1++)\n        {\n            part new_p;\n            u1=(*it1).first;\n            v1=(*it1).second;\n            ex_edge.first=u1;\n            ex_edge.second=v1;\n            excluded_edges=P.exc_ed;\n            excluded_edges.push_back(ex_edge);\n            current_span.clear();\n            cost = Prim_ST(G, included_edges, excluded_edges);\n            if(cost > 0)\n            {\n                new_p.spanning=current_span;\n                new_p.inc_ed=included_edges;\n                new_p.exc_ed=excluded_edges;\n                partitions.push_back(new_p);\n            }\n            included_edges.push_back(ex_edge);\n        }\n\n        if(partitions.empty()){\n            return false;\n        }\n    }\n}\n\nint main() {\n    scanf(\"%i %i\", &nVertices, &nCores);\n\n    graph G {nVertices};\n\n    for(int i = 0; i < nVertices; i++){\n        int cor;\n        scanf(\"%i\", &cor);\n        G.cores[i] = cor;\n    }\n\n    scanf(\"%i\", &nArestas);\n\n    for(int i = 0; i < nArestas; i++){\n        int u1, v1;\n        scanf(\"%i %i\", &u1, &v1);\n        G.add_edge(u1, v1);\n    }\n\n    vector<pair<int, int>> incl;\n    vector<pair<int, int>> excl;\n    incl.clear();\n    excl.clear();\n    Prim_ST(G, incl, excl);\n    part p;\n    incl.clear();\n    excl.clear();\n    p.exc_ed=excl;\n    p.inc_ed=incl;\n    p.spanning=current_span;\n    partitions.push_back(p);\n\n    if(!create_partitions(G)){\n        exibirVetor(caminho);\n        cout<<contCor<<endl;\n    }\n\n    return 0;\n}\n",
      "path": "src/tropical.cpp"
    }
  ],
  "hypothesis": "For large spanning-tree path searches, statically sharing independent root branches across the four OpenMP threads will improve throughput while a serial prefix and a 64-root threshold avoid OpenMP setup on latency-sensitive cases.",
  "notes": "Each worker writes only its own root result. Results are consumed serially in root order, preserving the original first-tropical-path and first-strict-maximum selection semantics.",
  "sources_kept": [],
  "transformations": [
    "Replace mutation of global best-path state during DFS with per-root search results and deterministic serial reduction.",
    "Use OpenMP static work sharing for only the remaining large root set after a four-root serial probe; keep small searches serial.",
    "Pass immutable graph and vector inputs by const reference in the search and spanning-tree helpers to avoid copies."
  ]
}

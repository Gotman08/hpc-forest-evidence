        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n#include <limits.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\n#define BYTE_BUCKETS (UCHAR_MAX + 1)\n#define INSERTION_LIMIT 32\n#define PARALLEL_LIMIT 32768\n#define MIN_TASK_GRAIN 4096\n\ntypedef struct {\n    long int *data;\n    int length;\n    long int total;\n} bucket;\n\nstatic void allocation_error(void) {\n    fputs(\"ERROR allocation\\n\", stderr);\n    exit(EXIT_FAILURE);\n}\n\nstatic void *checked_array(size_t count, size_t element_size) {\n    if (element_size != 0 && count > SIZE_MAX / element_size)\n        allocation_error();\n    size_t bytes = count * element_size;\n    void *result = malloc(bytes != 0 ? bytes : 1);\n    if (result == NULL)\n        allocation_error();\n    return result;\n}\n\nstatic int compare_keys(const char *a, size_t length,\n                        long int left, long int right) {\n    return strcmp(a + (size_t)left * length,\n                  a + (size_t)right * length);\n}\n\nstatic void merge_ranges(const char *a, size_t length,\n                         long int *index, long int *scratch,\n                         size_t lo, size_t mid, size_t hi) {\n    if (compare_keys(a, length, index[mid - 1], index[mid]) <= 0)\n        return;\n\n    size_t left = lo;\n    size_t right = mid;\n    size_t out = lo;\n    while (left < mid && right < hi) {\n        if (compare_keys(a, length, index[left], index[right]) <= 0)\n            scratch[out++] = index[left++];\n        else\n            scratch[out++] = index[right++];\n    }\n    while (left < mid)\n        scratch[out++] = index[left++];\n    while (right < hi)\n        scratch[out++] = index[right++];\n    memcpy(index + lo, scratch + lo, (hi - lo) * sizeof(*index));\n}\n\nstatic void sort_serial(const char *a, size_t length,\n                        long int *index, long int *scratch,\n                        size_t lo, size_t hi) {\n    if (hi - lo <= INSERTION_LIMIT) {\n        for (size_t j = lo + 1; j < hi; ++j) {\n            long int key = index[j];\n            size_t i = j;\n            while (i > lo &&\n                   compare_keys(a, length, index[i - 1], key) > 0) {\n                index[i] = index[i - 1];\n                --i;\n            }\n            index[i] = key;\n        }\n        return;\n    }\n\n    size_t mid = lo + (hi - lo) / 2;\n    sort_serial(a, length, index, scratch, lo, mid);\n    sort_serial(a, length, index, scratch, mid, hi);\n    merge_ranges(a, length, index, scratch, lo, mid, hi);\n}\n\nvoid sort(char *a, bucket *b) {\n    if (b->total < 2)\n        return;\n    if (b->length <= 0)\n        allocation_error();\n    size_t count = (size_t)b->total;\n    long int *scratch = checked_array(count, sizeof(*scratch));\n    sort_serial(a, (size_t)b->length, b->data, scratch, 0, count);\n    free(scratch);\n}\n\n#ifdef _OPENMP\nstatic void sort_tasks(const char *a, size_t length,\n                       long int *index, long int *scratch,\n                       size_t lo, size_t hi, size_t grain) {\n    if (hi - lo <= grain) {\n        sort_serial(a, length, index, scratch, lo, hi);\n        return;\n    }\n\n    size_t mid = lo + (hi - lo) / 2;\n    #pragma omp task default(none) firstprivate(a, length, index, scratch, lo, mid, grain)\n    {\n        sort_tasks(a, length, index, scratch, lo, mid, grain);\n    }\n    #pragma omp task default(none) firstprivate(a, length, index, scratch, mid, hi, grain)\n    {\n        sort_tasks(a, length, index, scratch, mid, hi, grain);\n    }\n    #pragma omp taskwait\n    merge_ranges(a, length, index, scratch, lo, mid, hi);\n}\n#endif\n\nlong int *bucket_sort(char *a, int length, long int size,\n                      int offset, int nbuckets) {\n    if (size < 0 || length <= 0)\n        allocation_error();\n    size_t n = (size_t)size;\n    size_t stride = (size_t)length;\n    if (n > SIZE_MAX / stride)\n        allocation_error();\n\n    long int *index = checked_array(n, sizeof(*index));\n    if (n < 2) {\n        if (n != 0)\n            index[0] = 0;\n        return index;\n    }\n\n    size_t counts[BYTE_BUCKETS] = {0};\n    size_t boundaries[BYTE_BUCKETS + 1];\n    size_t cursor[BYTE_BUCKETS];\n    int declared_buckets = nbuckets > 0 && nbuckets <= BYTE_BUCKETS;\n\n    if (declared_buckets) {\n        for (size_t i = 0; i < n; ++i) {\n            unsigned char first = (unsigned char)a[i * stride];\n            long long b = (long long)first - (long long)offset;\n            if (b < 0 || b >= nbuckets) {\n                declared_buckets = 0;\n                break;\n            }\n            ++counts[(size_t)b];\n        }\n    }\n\n    /* Unsigned-byte buckets also cover records outside the declared range. */\n    if (!declared_buckets) {\n        memset(counts, 0, sizeof(counts));\n        for (size_t i = 0; i < n; ++i)\n            ++counts[(unsigned char)a[i * stride]];\n    }\n    int bucket_count = declared_buckets ? nbuckets : BYTE_BUCKETS;\n\n    boundaries[0] = 0;\n    for (int b = 0; b < bucket_count; ++b) {\n        boundaries[b + 1] = boundaries[b] + counts[b];\n        cursor[b] = boundaries[b];\n    }\n    for (size_t i = 0; i < n; ++i) {\n        unsigned char first = (unsigned char)a[i * stride];\n        size_t b = declared_buckets\n            ? (size_t)((long long)first - (long long)offset)\n            : (size_t)first;\n        index[cursor[b]++] = (long int)i;\n    }\n\n    long int *scratch = checked_array(n, sizeof(*scratch));\n#ifdef _OPENMP\n    int threads = omp_get_max_threads();\n    if (threads > 1 && n >= PARALLEL_LIMIT) {\n        size_t grain = n / (size_t)threads / 4;\n        if (grain < MIN_TASK_GRAIN)\n            grain = MIN_TASK_GRAIN;\n\n        /* Bucket ranges and sibling task ranges never overlap. */\n        #pragma omp parallel default(none) firstprivate(a, stride, index, scratch, bucket_count, grain) shared(boundaries)\n        {\n            #pragma omp single nowait\n            {\n                for (int b = 0; b < bucket_count; ++b) {\n                    size_t lo = boundaries[b];\n                    size_t hi = boundaries[b + 1];\n                    if (hi - lo > 1) {\n                        #pragma omp task default(none) firstprivate(a, stride, index, scratch, lo, hi, grain)\n                        {\n                            sort_tasks(a, stride, index, scratch, lo, hi, grain);\n                        }\n                    }\n                }\n            }\n        }\n        free(scratch);\n        return index;\n    }\n#endif\n\n    for (int b = 0; b < bucket_count; ++b) {\n        if (boundaries[b + 1] - boundaries[b] > 1)\n            sort_serial(a, stride, index, scratch,\n                        boundaries[b], boundaries[b + 1]);\n    }\n    free(scratch);\n    return index;\n}\n\nstatic void input_error(const char *field) {\n    printf(\"ERROR %s\\n\", field);\n    exit(EXIT_FAILURE);\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb) {\n    int len, offset, nbucket;\n    long int n;\n\n    if (fscanf(stdin, \"%d\", &len) != 1)\n        input_error(\"len\");\n    if (fscanf(stdin, \"%ld\", &n) != 1)\n        input_error(\"n\");\n    if (fscanf(stdin, \"%d\", &offset) != 1)\n        input_error(\"offset\");\n    if (fscanf(stdin, \"%d\", &nbucket) != 1)\n        input_error(\"nbucket\");\n\n    if (len < 0 || len == INT_MAX || (len == 0 && n > 0))\n        input_error(\"len\");\n    if (n < 0)\n        input_error(\"n\");\n    if (nbucket < 0 || nbucket == INT_MAX)\n        input_error(\"nbucket\");\n\n    size_t stride = (size_t)len + 1;\n    char *strings = checked_array((size_t)n, stride);\n    char token_format[32];\n    snprintf(token_format, sizeof(token_format), \"%%%ds\", len > 0 ? len : 1);\n    for (long int i = 0; i < n; ++i) {\n        if (fscanf(stdin, token_format, strings + (size_t)i * stride) != 1) {\n            printf(\"ERROR %ld\\n\", i);\n            free(strings);\n            exit(EXIT_FAILURE);\n        }\n    }\n\n    *vString = strings;\n    *N = n;\n    *l = len + 1;\n    *os = offset;\n    *nb = nbucket + 1;\n}\n\nvoid print(char *strings, long int *index, long int n, int len) {\n    for (long int i = 0; i < n; ++i)\n        printf(\"%ld -> %s\\n\", i,\n               strings + (size_t)index[i] * (size_t)len);\n}\n\nvoid save(char *strings, long int *index, long int n, int len) {\n    for (long int i = 0; i < n; ++i)\n        printf(\"%s\\n\", strings + (size_t)index[i] * (size_t)len);\n}\n\nint main(int ac, char **av) {\n    char *strings = NULL;\n    long int N = 0;\n    long int *index = NULL;\n    int len = 0;\n    int offset, nbuckets;\n    (void)ac;\n    (void)av;\n\n    load(&strings, &N, &len, &offset, &nbuckets);\n    index = bucket_sort(strings, len, N, offset, nbuckets);\n    save(strings, index, N, len);\n\n    free(strings);\n    free(index);\n    return EXIT_SUCCESS;\n}\n",
        "path": "src/bucketsort.c"
      }

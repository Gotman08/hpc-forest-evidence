#include <bits/stdc++.h>

using namespace std;

using ll = long long;

ll solve(const vector<int>& matrix, int rows, int cols, int k) {
  vector<ll> sums(cols, 0);
  unordered_map<ll, ll> freq;
  ll ans = 0;

  for (int top = 0; top < rows; ++top) {
    fill(sums.begin(), sums.end(), 0);
    for (int bottom = top; bottom < rows; ++bottom) {
      const int* row = matrix.data() + static_cast<size_t>(bottom) * cols;
      for (int col = 0; col < cols; ++col)
        sums[col] += row[col];

      freq.clear();
      freq[0] = 1;
      ll prefix = 0;
      for (int col = 0; col < cols; ++col) {
        prefix += sums[col];
        auto it = freq.find(prefix - k);
        if (it != freq.end())
          ans += it->second;
        ++freq[prefix];
      }
    }
  }
  return ans;
}

int main() {
  int k, m, n;
  cin >> k >> m >> n;

  const bool rows_are_smaller = m <= n;
  const int small = min(m, n);
  const int large = max(m, n);
  vector<int> matrix(static_cast<size_t>(small) * large);

  if (rows_are_smaller) {
    for (int i = 0; i < m; ++i)
      for (int j = 0; j < n; ++j)
        cin >> matrix[static_cast<size_t>(i) * large + j];
  } else {
    for (int i = 0; i < m; ++i)
      for (int j = 0; j < n; ++j)
        cin >> matrix[static_cast<size_t>(j) * large + i];
  }

  cout << solve(matrix, small, large, k) << endl;
  return 0;
}

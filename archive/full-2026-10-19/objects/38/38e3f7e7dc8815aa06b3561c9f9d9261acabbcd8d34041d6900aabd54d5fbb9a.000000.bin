#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include <stdint.h>

#if defined(__aarch64__) && defined(__ARM_NEON)
#include <arm_neon.h>
#endif

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

/*
 * Each body holds coordinate positions (i.e., x, y, and z) and
 * velocities (i.e., vx, vy, and vz).
 */
typedef struct { float x, y, z, vx, vy, vz; } Body;

#if defined(__aarch64__) && defined(__ARM_NEON)
/*
 * Return the same float as the original double sqrt/divide expression.
 * Estimates only supply candidates; acceptance uses a rounding interval.
 */
static inline __attribute__((always_inline))
float32x4_t reference_rounded_inv_dist4(float32x4_t distance) {
  uint32x4_t bits = vreinterpretq_u32_f32(distance);
  uint32x4_t normal = vandq_u32(
      vcgeq_u32(bits, vdupq_n_u32(0x00800000u)),
      vcltq_u32(bits, vdupq_n_u32(0x7f800000u)));
  float32x4_t safe = vbslq_f32(normal, distance, vdupq_n_f32(1.0f));

  float32x4_t estimate = vrsqrteq_f32(safe);
  estimate = vmulq_f32(estimate,
      vrsqrtsq_f32(vmulq_f32(safe, estimate), estimate));
  estimate = vmulq_f32(estimate,
      vrsqrtsq_f32(vmulq_f32(safe, estimate), estimate));

  float64x2_t x0 = vcvt_f64_f32(vget_low_f32(safe));
  float64x2_t x1 = vcvt_f64_f32(vget_high_f32(safe));
  float64x2_t y0 = vcvt_f64_f32(vget_low_f32(estimate));
  float64x2_t y1 = vcvt_f64_f32(vget_high_f32(estimate));
  float64x2_t correction0 = vrsqrtsq_f64(vmulq_f64(x0, y0), y0);
  float64x2_t correction1 = vrsqrtsq_f64(vmulq_f64(x1, y1), y1);

  /*
   * A Newton correction within 2^-21 of one bounds the refined
   * positive result's relative error by less than 2^-40, including
   * binary64 roundoff. The wider 2^-38 interval also covers the
   * original double sqrt/divide roundings and endpoint roundoff.
   */
  float64x2_t one = vdupq_n_f64(1.0);
  float64x2_t limit = vdupq_n_f64(0x1p-21);
  uint64x2_t close0 = vcleq_f64(
      vabsq_f64(vsubq_f64(correction0, one)), limit);
  uint64x2_t close1 = vcleq_f64(
      vabsq_f64(vsubq_f64(correction1, one)), limit);
  y0 = vmulq_f64(y0, correction0);
  y1 = vmulq_f64(y1, correction1);

  float64x2_t error0 = vmulq_n_f64(y0, 0x1p-38);
  float64x2_t error1 = vmulq_n_f64(y1, 0x1p-38);
  float32x4_t lower = vcombine_f32(
      vcvt_f32_f64(vsubq_f64(y0, error0)),
      vcvt_f32_f64(vsubq_f64(y1, error1)));
  float32x4_t upper = vcombine_f32(
      vcvt_f32_f64(vaddq_f64(y0, error0)),
      vcvt_f32_f64(vaddq_f64(y1, error1)));

  uint32x4_t accepted = vcombine_u32(vmovn_u64(close0), vmovn_u64(close1));
  accepted = vandq_u32(accepted, normal);
  accepted = vandq_u32(accepted, vceqq_f32(lower, upper));
  accepted = vandq_u32(accepted, vcgtq_f32(lower, vdupq_n_f32(0.0f)));

  if (vminvq_u32(accepted) != UINT32_MAX) {
    float inputs[4];
    float results[4];
    uint32_t masks[4];
    vst1q_f32(inputs, distance);
    vst1q_f32(results, lower);
    vst1q_u32(masks, accepted);
    for (int lane = 0; lane < 4; ++lane) {
      if (masks[lane] == 0) {
        results[lane] = (float)(1.0 / sqrt((double)inputs[lane]));
      }
    }
    return vld1q_f32(results);
  }
  return lower;
}
#endif

/*
 * Compute the gravitational impact among all pairs of bodies in
 * the system.
 */
void body_force(Body *p, float dt, int n) {
  int i = 0;
#if defined(__aarch64__) && defined(__ARM_NEON)
  int vector_end = n - n % 4;
  const float32x4_t softening = vdupq_n_f32(SOFTENING);
  for (; i < vector_end; i += 4) {
    const float32x4_t x = {p[i].x, p[i+1].x, p[i+2].x, p[i+3].x};
    const float32x4_t y = {p[i].y, p[i+1].y, p[i+2].y, p[i+3].y};
    const float32x4_t z = {p[i].z, p[i+1].z, p[i+2].z, p[i+3].z};
    float32x4_t fx = vdupq_n_f32(0.0f);
    float32x4_t fy = vdupq_n_f32(0.0f);
    float32x4_t fz = vdupq_n_f32(0.0f);

    /* SIMD lanes are independent targets, not a force reduction. */
    for (int j = 0; j < n; ++j) {
      float32x4_t dx = vdupq_n_f32(p[j].x) - x;
      float32x4_t dy = vdupq_n_f32(p[j].y) - y;
      float32x4_t dz = vdupq_n_f32(p[j].z) - z;
      float32x4_t sqrd_dist = dx*dx + dy*dy + dz*dz + softening;
      float32x4_t inv_dist = reference_rounded_inv_dist4(sqrd_dist);
      float32x4_t inv_dist3 = inv_dist * inv_dist * inv_dist;
      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    p[i].vx += dt*vgetq_lane_f32(fx, 0);
    p[i].vy += dt*vgetq_lane_f32(fy, 0);
    p[i].vz += dt*vgetq_lane_f32(fz, 0);
    p[i+1].vx += dt*vgetq_lane_f32(fx, 1);
    p[i+1].vy += dt*vgetq_lane_f32(fy, 1);
    p[i+1].vz += dt*vgetq_lane_f32(fz, 1);
    p[i+2].vx += dt*vgetq_lane_f32(fx, 2);
    p[i+2].vy += dt*vgetq_lane_f32(fy, 2);
    p[i+2].vz += dt*vgetq_lane_f32(fz, 2);
    p[i+3].vx += dt*vgetq_lane_f32(fx, 3);
    p[i+3].vy += dt*vgetq_lane_f32(fy, 3);
    p[i+3].vz += dt*vgetq_lane_f32(fz, 3);
  }
#endif

  for (; i < n; ++i) {
    float fx = 0.0f;
    float fy = 0.0f;
    float fz = 0.0f;

    for (int j = 0; j < n; j++) {
      float dx = p[j].x - p[i].x;
      float dy = p[j].y - p[i].y;
      float dz = p[j].z - p[i].z;
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1 / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    p[i].vx += dt*fx;
    p[i].vy += dt*fy;
    p[i].vz += dt*fz;
  }
}

/*
 * Read a binary dataset with initilized bodies.
 */
Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  return bodies;
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc,char **argv) {
  int nbodies;

  Body *bodies = read_dataset(&nbodies);

  /*
   * At each simulation iteration, interbody forces are computed,
   * and bodies' positions are integrated.
   */
  for (int iter = 0; iter < N_ITER; iter++) {
    body_force(bodies, DT, nbodies);

    for (int i = 0; i < nbodies; i++) {
      bodies[i].x += bodies[i].vx * DT;
      bodies[i].y += bodies[i].vy * DT;
      bodies[i].z += bodies[i].vz * DT;
    }
  }

  write_dataset(nbodies, bodies);

  free(bodies);

  exit(EXIT_SUCCESS);
}

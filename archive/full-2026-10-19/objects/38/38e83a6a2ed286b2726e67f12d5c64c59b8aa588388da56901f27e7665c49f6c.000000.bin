        "epoch": 1,
        "hypothesis": "Blocking four target bodies together in body_force may improve memory locality by reusing each streamed source body's coordinates across several targets, while retaining each target's source traversal and force-accumulation order.",
        "id": "ca5b37aed5f84187",
        "ordinal": 2,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/nbody.c"
          ],
          "retained": [
            "Interchange the target and source loop order within fixed-size target blocks, caching target coordinates and loading each source body's coordinates once per source iteration.",
            "Keep a separate force accumulator for each target and update velocities only after all sources have been processed; retain ascending source-index accumulation order for every target."
          ]
        },

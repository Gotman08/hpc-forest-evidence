      "content": "#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n#include<stdint.h>\n\n/* Maximum size (in char) for neighbors and compute lists */\n#define MAX 100\n\ntypedef struct {\n  int id;\n  float value;\n  char neighbors[MAX];\n} Node;\n\ntypedef struct {\n  int id;\n  size_t index_plus_one;\n} IdEntry;\n\n/* Reads input, allocates memory, writes graph size and node list. Returns the graph. */\nNode* read_input(char* fname, int *n, char* list) {\n  Node* data = NULL;\n  FILE *fl = NULL;\n\n  if (fname == NULL)\n    fl = stdin;\n  else\n    fl = fopen(fname, \"r\");\n\n  if (fl == NULL) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n\n  // header\n  fscanf(fl, \"%d %[^\n]\", n, list);\n\n  if (*n > 0) {\n    data = (Node*) malloc ((*n)*sizeof(Node));\n    if(data == NULL){\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }\n  }\n\n  for(int i = 0; i < *n; i++)\n    fscanf(fl, \"%d %f %[^\n]\", &data[i].id, &data[i].value, data[i].neighbors);\n\n  fclose(fl);\n  return data;\n}\n\n/* Mix arbitrary signed IDs into hash-table slots. */\nstatic size_t hash_id(int id, size_t mask) {\n  uint32_t x = (uint32_t)id;\n  x ^= x >> 16;\n  x *= 0x7feb352dU;\n  x ^= x >> 15;\n  x *= 0x846ca68bU;\n  x ^= x >> 16;\n  return (size_t)x & mask;\n}\n\n/* Builds a compact open-addressed ID index, retaining the first duplicate ID. */\nstatic IdEntry *build_id_index(Node g[], int size, size_t *capacity) {\n  size_t cap = 8;\n  size_t wanted = size > 0 ? (size_t)size * 2 : 1;\n\n  while (cap < wanted) {\n    if (cap > (size_t)-1 / 2) {\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }\n    cap <<= 1;\n  }\n\n  IdEntry *index = (IdEntry*)calloc(cap, sizeof(*index));\n  if (index == NULL) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n\n  for (int i = 0; i < size; i++) {\n    size_t slot = hash_id(g[i].id, cap - 1);\n    while (index[slot].index_plus_one != 0 && index[slot].id != g[i].id)\n      slot = (slot + 1) & (cap - 1);\n\n    if (index[slot].index_plus_one == 0) {\n      index[slot].id = g[i].id;\n      index[slot].index_plus_one = (size_t)i + 1;\n    }\n  }\n\n  *capacity = cap;\n  return index;\n}\n\n/* Returns the first matching node index, or -1 if the ID is not present. */\nstatic int find_by_id(const IdEntry *index, size_t capacity, int id) {\n  size_t slot = hash_id(id, capacity - 1);\n\n  while (index[slot].index_plus_one != 0) {\n    if (index[slot].id == id)\n      return (int)(index[slot].index_plus_one - 1);\n    slot = (slot + 1) & (capacity - 1);\n  }\n\n  return -1;\n}\n\n/* Computes the sum for the node with the given id */\nfloat get_costly(Node *g, const IdEntry *index, size_t capacity, int id) {\n  char *t;\n  int idmax = -1;\n  float max = 0;\n  char *auxptr;\n\n  int nd = find_by_id(index, capacity, id);\n  if(nd < 0)\n    return max;\n\n  char aux[MAX];\n  strcpy(aux, g[nd].neighbors);\n  t = strtok_r(aux, \" \", &auxptr);\n\n  do {\n    int d = find_by_id(index, capacity, atoi(t));\n    if (d >= 0 && max < g[d].value) {\n      max = g[d].value;\n      idmax = atoi(t);\n    }\n  } while ((t = strtok_r(NULL, \" \", &auxptr)));\n\n  float r = g[nd].value;\n\n  if(idmax != -1)\n    r += get_costly(g, index, capacity, idmax);\n\n  return r;\n}\n\n/* Main program - calls read input, computes sum for each node in the list, prints output */\nint main() {\n  char *fileN = NULL;\n  char computelist[MAX];\n  int n = -1;\n  size_t index_capacity;\n  Node* input = NULL;\n\n  input = read_input(fileN, &n, computelist);\n  IdEntry *index = build_id_index(input, n, &index_capacity);\n\n  // process\n  for(char *c = strtok(computelist, \" \"); c != NULL; c = strtok(NULL, \" \"))\n    printf(\"%s: %f\\n\", c, get_costly(input, index, index_capacity, atoi(c)));\n\n  free(index);\n  free(input);\n  return 0;\n}\n",
      "path": "src/graph.c"
    }
  ],
  "hypothesis": "Replacing repeated linear node-ID scans with a compact contiguous hash index should reduce lookup work while preserving node order, duplicate-ID first-match behavior, and neighbor traversal semantics.",
  "notes": "No commands or measurements were run. The allocation condition also permits the valid single-node case.",

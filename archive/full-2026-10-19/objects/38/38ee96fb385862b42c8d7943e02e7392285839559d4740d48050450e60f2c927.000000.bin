#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

/*
 * Each body holds coordinate positions (i.e., x, y, and z) and
 * velocities (i.e., vx, vy, and vz).
 */
typedef struct { float x, y, z, vx, vy, vz; } Body;

/*
 * Compute the gravitational impact among all pairs of bodies in
 * the system.
 */
void body_force(Body *p, float dt, int n) {
  for (int i = 0; i < n; ++i) {
    float fx = 0.0f;
    float fy = 0.0f;
    float fz = 0.0f;

    for (int j = 0; j < n; j++) {
      float dx = p[j].x - p[i].x;
      float dy = p[j].y - p[i].y;
      float dz = p[j].z - p[i].z;
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1 / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    p[i].vx += dt*fx;
    p[i].vy += dt*fy;
    p[i].vz += dt*fz;
  }
}

/*
 * Read a binary dataset with initilized bodies.
 */
Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  return bodies;
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc,char **argv) {
  int nbodies;

  Body *bodies = read_dataset(&nbodies);
  Body *alternate = NULL;

  /* Avoid team startup and scratch allocation for small systems. */
  if (nbodies >= 128) {
    alternate = (Body *)malloc((size_t)nbodies * sizeof(*alternate));
  }

  if (alternate != NULL) {
    /*
     * The current state remains read-only throughout each timestep.
     * Each body can therefore be integrated immediately into the next
     * state, with only one work-sharing barrier per timestep.
     */
    #pragma omp parallel default(none) shared(bodies, alternate, nbodies)
    {
      Body *current = bodies;
      Body *next = alternate;

      for (int iter = 0; iter < N_ITER; iter++) {
        #pragma omp for schedule(static)
        for (int i = 0; i < nbodies; ++i) {
          float fx = 0.0f;
          float fy = 0.0f;
          float fz = 0.0f;

          for (int j = 0; j < nbodies; j++) {
            float dx = current[j].x - current[i].x;
            float dy = current[j].y - current[i].y;
            float dz = current[j].z - current[i].z;
            float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
            float inv_dist = 1 / sqrt(sqrd_dist);
            float inv_dist3 = inv_dist * inv_dist * inv_dist;

            fx += dx * inv_dist3;
            fy += dy * inv_dist3;
            fz += dz * inv_dist3;
          }

          Body updated = current[i];
          updated.vx += DT*fx;
          updated.vy += DT*fy;
          updated.vz += DT*fz;
          updated.x += updated.vx * DT;
          updated.y += updated.vy * DT;
          updated.z += updated.vz * DT;
          next[i] = updated;
        }

        Body *tmp = current;
        current = next;
        next = tmp;
      }
    }

    if (N_ITER & 1) {
      Body *tmp = bodies;
      bodies = alternate;
      alternate = tmp;
    }
  } else {
    /* Serial fallback also handles failure of the extra allocation. */
    for (int iter = 0; iter < N_ITER; iter++) {
      body_force(bodies, DT, nbodies);

      for (int i = 0; i < nbodies; i++) {
        bodies[i].x += bodies[i].vx * DT;
        bodies[i].y += bodies[i].vy * DT;
        bodies[i].z += bodies[i].vz * DT;
      }
    }
  }

  write_dataset(nbodies, bodies);

  free(alternate);
  free(bodies);

  exit(EXIT_SUCCESS);
}

set -euo pipefail
[[ ${SLURM_JOB_ID:-} =~ ^[0-9]+$ ]] || exit 70
[[ ${SLURM_JOB_NUM_NODES:-} == 1 && ${SLURM_NTASKS:-} == 1 && ${SLURM_CPUS_PER_TASK:-} == 4 && ${SLURM_MEM_PER_NODE:-} == 16384 ]] || exit 71
[[ ${SLURM_RESTART_COUNT:-0} == 0 ]] || exit 72
export PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=4
srun --nodes=1 --ntasks=1 --cpus-per-task=4 --mem=16G --cpu-bind=cores --time=03:00:00 /scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python -I -B -u - <<'ONE_SELECTED_MAX_CELL_PREFLIGHT'
"""Future allocated entry: exactly one selected MAX cell; never a model loop."""
from __future__ import annotations

import hashlib
import json
import os

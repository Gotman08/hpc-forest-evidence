PYTHON = '/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python'
SPACK_GCC = '/zrtbeqke25s2vbqo4yrhsowjz7mg3pjf'
DEADLINE = datetime(2026, 10, 31, 23, tzinfo=UTC)


def require(ok, message):
    if not ok:
        raise RuntimeError(message)


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


env = os.environ
require(platform.system() == 'Linux' and platform.machine().lower() in {'aarch64', 'arm64'}, 'Own Linux ARM64 allocation required')
require(re.fullmatch('[0-9]+', env.get('SLURM_JOB_ID', '')), 'Actual Slurm job required')
required = {'SLURM_JOB_NUM_NODES': '1', 'SLURM_NTASKS': '1', 'SLURM_CPUS_PER_TASK': '4', 'SLURM_MEM_PER_NODE': '16384'}
require(all(env.get(k) == v for k, v in required.items()), 'Exact1node/1task/4CPU/16Gi allocation required')
require(env.get('SLURM_RESTART_COUNT', '0') == '0', 'Never replay a native attempt')
require(all(env.get(k, '') in {'', '0'} for k in ('SLURM_GPUS', 'SLURM_GPUS_PER_NODE', 'SLURM_JOB_GPUS', 'SLURM_STEP_GPUS', 'CUDA_VISIBLE_DEVICES')), 'Zero GPU required')
require(hasattr(os, 'sched_getaffinity') and len(os.sched_getaffinity(0)) == 4, 'Exactly four effective CPUs required')
require(datetime.now(UTC) + timedelta(seconds=21600) < DEADLINE, 'Exclusive deadline reserve insufficient')
require(Path(sys.executable).resolve() == Path(PYTHON).resolve(), 'Exact existing ARM64 Python required')
root, admission = Path(CELL['remote_root']), Path(CELL['admission_root'])
require(not root.exists() and not root.is_symlink(), 'Fresh selected native root required')
require(not admission.exists() and not admission.is_symlink(), 'Fresh selected admission root required')
extraction = Path(CELL['remote_extraction'])
source_zip = extraction / CELL['source_zip_name']
plan_path, runtime = extraction / 'native-max-plan.json', extraction / 'runtime-manifest-r2max.json'
for path, expected in ((source_zip, CELL['source_sha256']), (plan_path, CELL['plan_sha256']), (runtime, CELL['runtime_sha256'])):
    require(path.is_file() and not path.is_symlink() and sha(path) == expected, 'Changed qualified source/plan/runtime')
project = extraction / 'HPC-Forest'
expected = json.loads(runtime.read_bytes())
actual = {p.relative_to(project).as_posix(): p for p in project.rglob('*') if p.is_file()
          and not any(x in {'__pycache__', '.pytest_cache', '.ruff_cache'} for x in p.relative_to(project).parts)}
require(len(expected) == CELL['source_members'] and set(actual) == set(expected)
        and all(not p.is_symlink() and sha(p) == expected[n] for n, p in actual.items()), 'Exact new qualified runtime required')
with zipfile.ZipFile(source_zip) as archive:
    names = archive.namelist()
    require(len(names) == len(set(names)) == CELL['source_members'], 'Exact source ZIP membership required')
    require(all(n.startswith('HPC-Forest/') and n.removeprefix('HPC-Forest/') in actual
                and archive.read(n) == actual[n.removeprefix('HPC-Forest/')].read_bytes() for n in names), 'Source ZIP/runtime divergence')
plan = json.loads(plan_path.read_bytes())
require(plan.get('scope_id') == CELL['scope_id'] and plan.get('source_zip_sha256') == CELL['source_sha256']
        and plan.get('cells') == CELL['cells'] and plan.get('maximum_native_workers_total') == 4
        and plan.get('maximum_cells_per_authorization') == 1 and plan.get('efforts') == ['max']
        and plan.get('automatic_extension') is False and CELL['model'] in CELL['cells']
        and CELL['session_id'] == CELL['cells'][CELL['model']], 'Actual cap4 plan and selected closed MAX identity required')
sys.path.insert(0, str(project / 'src'))
from hpc_forest.native_r2max import allocation_guard, verify_runtime

allocation = allocation_guard()
verify_runtime(source_zip)
require(not root.exists() and not root.is_symlink(), 'Native root must remain absent before wait')
require(admission.parent == Path('/scratch_p/nimarano') and admission.name == CELL['scope_id'] + '-admission-' + CELL['session_id'], 'Exact selected admission directory required')
admission.mkdir(mode=0o700, exist_ok=False)
marker = {'schema': 'hpc-forest-max-cell-allocation-ready-v1', 'verified': True,
          'scope_id': CELL['scope_id'], 'model': CELL['model'], 'effort': 'max', 'session_id': CELL['session_id'],
          'job_id': allocation['job_id'], 'source_zip_sha256': CELL['source_sha256'], 'plan_sha256': CELL['plan_sha256'],
          'allocation': allocation, 'native_root': str(root), 'admission_root': str(admission),
          'native_root_absent_before_wait': True, 'native_model_calls': 0, 'source_files_verified': CELL['source_members'],
          'maximum_native_workers': 4, 'authorization_still_required': True, 'utc': datetime.now(UTC).isoformat()}
with (admission / 'allocation-ready.json').open('x', encoding='utf8') as stream:
    json.dump(marker, stream, sort_keys=True)
    stream.flush()
    os.fsync(stream.fileno())
print(json.dumps(marker), flush=True)
wait_argv = [PYTHON, '-I', '-B', '-u', str(project / 'examples/marathon22/wait_r2max_authorization.py'),
    '--root', str(root), '--authorization', str(admission / 'authorization.json'),
    '--authorization-ready', str(admission / 'authorization-ready.json'), '--wait-seconds', '600']
command = 'set -euo pipefail\nromeo_load_armgpu_env\nspack load ' + shlex.quote(SPACK_GCC) + '\nexec ' + shlex.join(wait_argv)
child = {**env, 'PYTHONDONTWRITEBYTECODE': '1', 'PYTHONUNBUFFERED': '1', 'OPENBLAS_NUM_THREADS': '1',
         'MKL_NUM_THREADS': '1', 'NUMEXPR_NUM_THREADS': '1', 'OMP_NUM_THREADS': '4', 'OMP_DYNAMIC': 'FALSE',
         'OMP_PROC_BIND': 'close', 'OMP_PLACES': 'cores', 'CUDA_VISIBLE_DEVICES': ''}
os.execvpe('/bin/bash', ['/bin/bash', '-lc', command], child)
ONE_SELECTED_MAX_CELL_PREFLIGHT

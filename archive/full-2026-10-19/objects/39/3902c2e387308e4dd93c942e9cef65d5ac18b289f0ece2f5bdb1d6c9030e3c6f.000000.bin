        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/* Called collectively by the current OpenMP team. */\nstatic void body_force_work(Body *p, float dt, int n) {\n  const int blocks = n / 3 + (n % 3 != 0);\n\n  #pragma omp for schedule(static)\n  for (int block = 0; block < blocks; ++block) {\n    const int i = block * 3;\n\n    if (n - i >= 3) {\n      const float x0 = p[i].x;\n      const float y0 = p[i].y;\n      const float z0 = p[i].z;\n      const float x1 = p[i + 1].x;\n      const float y1 = p[i + 1].y;\n      const float z1 = p[i + 1].z;\n      const float x2 = p[i + 2].x;\n      const float y2 = p[i + 2].y;\n      const float z2 = p[i + 2].z;\n      float fx0 = 0.0f, fy0 = 0.0f, fz0 = 0.0f;\n      float fx1 = 0.0f, fy1 = 0.0f, fz1 = 0.0f;\n      float fx2 = 0.0f, fy2 = 0.0f, fz2 = 0.0f;\n\n      for (int j = 0; j < n; ++j) {\n        const float xj = p[j].x;\n        const float yj = p[j].y;\n        const float zj = p[j].z;\n\n        float dx0 = xj - x0;\n        float dy0 = yj - y0;\n        float dz0 = zj - z0;\n        float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\n        float inv_dist0 = 1 / sqrt(sqrd_dist0);\n        float inv_dist30 = inv_dist0 * inv_dist0 * inv_dist0;\n        fx0 += dx0 * inv_dist30;\n        fy0 += dy0 * inv_dist30;\n        fz0 += dz0 * inv_dist30;\n\n        float dx1 = xj - x1;\n        float dy1 = yj - y1;\n        float dz1 = zj - z1;\n        float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\n        float inv_dist1 = 1 / sqrt(sqrd_dist1);\n        float inv_dist31 = inv_dist1 * inv_dist1 * inv_dist1;\n        fx1 += dx1 * inv_dist31;\n        fy1 += dy1 * inv_dist31;\n        fz1 += dz1 * inv_dist31;\n\n        float dx2 = xj - x2;\n        float dy2 = yj - y2;\n        float dz2 = zj - z2;\n        float sqrd_dist2 = dx2*dx2 + dy2*dy2 + dz2*dz2 + SOFTENING;\n        float inv_dist2 = 1 / sqrt(sqrd_dist2);\n        float inv_dist32 = inv_dist2 * inv_dist2 * inv_dist2;\n        fx2 += dx2 * inv_dist32;\n        fy2 += dy2 * inv_dist32;\n        fz2 += dz2 * inv_dist32;\n      }\n\n      p[i].vx += dt*fx0;\n      p[i].vy += dt*fy0;\n      p[i].vz += dt*fz0;\n      p[i + 1].vx += dt*fx1;\n      p[i + 1].vy += dt*fy1;\n      p[i + 1].vz += dt*fz1;\n      p[i + 2].vx += dt*fx2;\n      p[i + 2].vy += dt*fy2;\n      p[i + 2].vz += dt*fz2;\n    } else {\n      for (int k = i; k < n; ++k) {\n        float fx = 0.0f;\n        float fy = 0.0f;\n        float fz = 0.0f;\n\n        for (int j = 0; j < n; ++j) {\n          float dx = p[j].x - p[k].x;\n          float dy = p[j].y - p[k].y;\n          float dz = p[j].z - p[k].z;\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          float inv_dist = 1 / sqrt(sqrd_dist);\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n        }\n\n        p[k].vx += dt*fx;\n        p[k].vy += dt*fy;\n        p[k].vz += dt*fz;\n      }\n    }\n  }\n}\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system. Independent calls create their own OpenMP team.\n */\nvoid body_force(Body *p, float dt, int n) {\n  #pragma omp parallel\n  {\n    body_force_work(p, dt, n);\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * Keep one team throughout the simulation. Each work-sharing loop\n   * ends with a barrier before the next phase reads its results.\n   */\n  #pragma omp parallel\n  {\n    for (int iter = 0; iter < N_ITER; iter++) {\n      body_force_work(bodies, DT, nbodies);\n\n      #pragma omp for schedule(static)\n      for (int i = 0; i < nbodies; i++) {\n        bodies[i].x += bodies[i].vx * DT;\n        bodies[i].y += bodies[i].vy * DT;\n        bodies[i].z += bodies[i].vz * DT;\n      }\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
        "path": "src/nbody.c"
      }

      "content": "#include \"knn.h\"\n\n#ifdef _OPENMP\n#include <omp.h>\n\ntypedef struct {\n    char *labels;\n    float *distances;\n    int count;\n    int next;\n} NeighborBlock;\n\nstatic int collect_parallel_neighbors(int n_groups, Group *groups, int k,\n                                      Point to_evaluate, char *labels) {\n    int max_threads = omp_get_max_threads();\n    if (k <= 0 || max_threads <= 1 || omp_in_parallel()) return 0;\n\n    size_t total_points = 0;\n    for (int i = 0; i < n_groups; i++) {\n        size_t length = groups[i].length > 0 ? (size_t)groups[i].length : 0;\n        size_t next = total_points + length;\n        if (next < total_points) return 0;\n        total_points = next;\n    }\n\n    size_t effective_k = total_points < (size_t)k ? total_points : (size_t)k;\n    const size_t min_parallel_work = 65536;\n    if (total_points < min_parallel_work &&\n        total_points * effective_k < min_parallel_work) return 0;\n\n    NeighborBlock *blocks = (NeighborBlock *)calloc((size_t)max_threads,\n                                                   sizeof(NeighborBlock));\n    if (blocks == NULL) return 0;\n\n    int used_threads = 0;\n    int failed = 0;\n    int has_nan = 0;\n\n    #pragma omp parallel reduction(|:failed, has_nan)\n    {\n        int tid = omp_get_thread_num();\n        int team = omp_get_num_threads();\n        if (tid == 0) used_threads = team;\n\n        size_t base = total_points / (size_t)team;\n        size_t extra = total_points % (size_t)team;\n        size_t begin = base * (size_t)tid +\n                       ((size_t)tid < extra ? (size_t)tid : extra);\n        size_t count = base + ((size_t)tid < extra);\n        size_t end = begin + count;\n        int capacity = count < (size_t)k ? (int)count : k;\n        NeighborBlock *block = &blocks[tid];\n        block->count = capacity;\n\n        if (capacity > 0) {\n            block->labels = (char *)malloc((size_t)capacity * sizeof(char));\n            block->distances = (float *)malloc((size_t)capacity * sizeof(float));\n            if (block->labels == NULL || block->distances == NULL) {\n                failed = 1;\n            } else {\n                char *local_labels = block->labels;\n                float *local_distances = block->distances;\n                for (int x = 0; x < capacity; x++) {\n                    local_labels[x] = -1;\n                    local_distances[x] = -1;\n                }\n\n                /* Each block follows a consecutive part of the original traversal. */\n                size_t offset = 0;\n                for (int i = 0; i < n_groups && offset < end; i++) {\n                    Group g = groups[i];\n                    size_t length = g.length > 0 ? (size_t)g.length : 0;\n                    size_t group_end = offset + length;\n                    if (group_end > begin) {\n                        size_t first = begin > offset ? begin - offset : 0;\n                        size_t last = end < group_end ? end - offset : length;\n                        for (size_t j = first; j < last; j++) {\n                            float d = euclidean_distance_no_sqrt(to_evaluate,\n                                                                 g.points[j]);\n                            if (d != d) has_nan = 1;\n\n                            for (int x = 0; x < capacity; x++) {\n                                if (d < local_distances[x] || local_distances[x] == -1) {\n                                    for (int y = capacity - 1; y > x; y--) {\n                                        local_distances[y] = local_distances[y - 1];\n                                        local_labels[y] = local_labels[y - 1];\n                                    }\n                                    local_distances[x] = d;\n                                    local_labels[x] = g.label;\n                                    break;\n                                }\n                            }\n                        }\n                    }\n                    offset = group_end;\n                }\n            }\n        }\n    }\n\n    int success = !failed && !has_nan;\n    if (success) {\n        int selected = 0;\n        while (selected < k) {\n            int best = -1;\n            float best_distance = 0;\n            for (int t = 0; t < used_threads; t++) {\n                NeighborBlock *block = &blocks[t];\n                if (block->next < block->count) {\n                    float d = block->distances[block->next];\n                    /* Strict comparison preserves traversal order at equal distances. */\n                    if (best < 0 || d < best_distance) {\n                        best = t;\n                        best_distance = d;\n                    }\n                }\n            }\n            if (best < 0) break;\n            NeighborBlock *block = &blocks[best];\n            labels[selected++] = block->labels[block->next++];\n        }\n        while (selected < k) labels[selected++] = -1;\n    }\n\n    for (int t = 0; t < used_threads; t++) {\n        free(blocks[t].distances);\n        free(blocks[t].labels);\n    }\n    free(blocks);\n    return success;\n}\n#endif\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = NULL;\n    int i, j, x, y;\n    int parallel_done = 0;\n\n#ifdef _OPENMP\n    parallel_done = collect_parallel_neighbors(n_groups, groups, k,\n                                               to_evaluate, labels);\n#endif\n\n    if (!parallel_done) {\n        distances = (float *) malloc(sizeof(float) * k);\n        for (i = 0; i < k; i++) {\n            labels[i] = -1;\n            distances[i] = -1;\n        }\n\n        for (i = 0; i < n_groups; i++) {\n            Group g = groups[i];\n\n            for (j = 0; j < g.length; j++) {\n                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n                for (x = 0; x < k; x++) {\n                    if (d < distances[x] || distances[x] == -1) {\n                        for (y = k - 1; y > x; y--) {\n                            distances[y] = distances[y - 1];\n                            labels[y] = labels[y - 1];\n                        }\n\n                        distances[x] = d;\n                        labels[x] = g.label;\n\n                        break;\n                    }\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }

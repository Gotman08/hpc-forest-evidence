#include <cstdio>
#include <vector>

class FastScanner {
    static const int BUFSIZE = 1 << 20;
    char buf[BUFSIZE];
    int idx, size;
public:
    FastScanner() : idx(0), size(0) {}
    inline bool readChar(char &c) {
        if (idx >= size) {
            size = fread(buf, 1, BUFSIZE, stdin);
            idx = 0;
            if (size == 0) return false;
        }
        c = buf[idx++];
        return true;
    }
    inline int nextInt() {
        char c;
        do { if (!readChar(c)) return 0; } while (c <= ' ');
        int sign = 1;
        if (c == '-') {
            sign = -1;
            readChar(c);
        }
        int x = 0;
        while (c >= '0' && c <= '9') {
            x = x * 10 + (c - '0');
            if (!readChar(c)) break;
        }
        return sign * x;
    }
};

int main() {
    FastScanner fs;
    int n = fs.nextInt();
    int s = fs.nextInt();

    std::vector<int> buf(s * n);
    std::vector<int> colSum(n, 0);

    // Read first s rows and initialize column sums.
    for (int r = 0; r < s; ++r) {
        int* row = &buf[r * n];
        for (int j = 0; j < n; ++j) {
            int v = fs.nextInt();
            row[j] = v;
            colSum[j] += v;
        }
    }

    // Horizontal sliding window over the first band.
    long long win = 0;
    for (int j = 0; j < s; ++j) win += colSum[j];
    long long mx = win;
    for (int j = s; j < n; ++j) {
        win += colSum[j] - colSum[j - s];
        if (win > mx) mx = win;
    }

    int head = 0; // ring buffer slot holding the current top row.

    // Process remaining bands.
    for (int topRow = 0; topRow < n - s; ++topRow) {
        int* exitRow = &buf[head * n];
        int* enterRow = &buf[head * n]; // same slot reused

        int j = 0;
        // Unrolled update: subtract exiting row, read entering row, add to colSum.
        for (; j + 3 < n; j += 4) {
            int v0 = fs.nextInt();
            int v1 = fs.nextInt();
            int v2 = fs.nextInt();
            int v3 = fs.nextInt();
            enterRow[j]     = v0;
            enterRow[j + 1] = v1;
            enterRow[j + 2] = v2;
            enterRow[j + 3] = v3;
            colSum[j]     += v0 - exitRow[j];
            colSum[j + 1] += v1 - exitRow[j + 1];
            colSum[j + 2] += v2 - exitRow[j + 2];
            colSum[j + 3] += v3 - exitRow[j + 3];
        }
        for (; j < n; ++j) {
            int v = fs.nextInt();
            enterRow[j] = v;
            colSum[j] += v - exitRow[j];
        }

        head++;
        if (head == s) head = 0;

        // Compute maximum SxS sum for the new band.
        win = 0;
        for (int j = 0; j < s; ++j) win += colSum[j];
        if (win > mx) mx = win;
        for (int j = s; j < n; ++j) {
            win += colSum[j] - colSum[j - s];
            if (win > mx) mx = win;
        }
    }

    printf("%lld\n", mx);
    return 0;
}

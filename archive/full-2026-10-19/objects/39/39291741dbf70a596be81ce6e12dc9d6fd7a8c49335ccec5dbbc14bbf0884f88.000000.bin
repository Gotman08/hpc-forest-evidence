#include <cstdio>
#include <vector>

class FastScanner {
    enum { BUFSIZE = 1 << 20 };
    int idx = 0;
    int size = 0;
    char buf[BUFSIZE];
public:
    inline char getChar() {
        if (idx >= size) {
            size = static_cast<int>(fread(buf, 1, BUFSIZE, stdin));
            idx = 0;
            if (size == 0) return 0;
        }
        return buf[idx++];
    }

    int nextInt() {
        char c;
        do { c = getChar(); } while (c <= ' ');
        int sign = 1;
        if (c == '-') { sign = -1; c = getChar(); }
        int x = 0;
        while (c > ' ') {
            x = x * 10 + (c - '0');
            c = getChar();
        }
        return sign * x;
    }
};

int main() {
    FastScanner fs;
    int n = fs.nextInt();
    int s = fs.nextInt();

    std::vector<long long> colSum(n, 0);
    const size_t ringSize = static_cast<size_t>(s + 1) * static_cast<size_t>(n);
    std::vector<int> ring(ringSize);

    // Read first s rows and initialize column sums.
    for (int r = 0; r < s; ++r) {
        int* row = &ring[static_cast<size_t>(r) * n];
        int j = 0;
        for (; j + 3 < n; j += 4) {
            int v0 = fs.nextInt();
            int v1 = fs.nextInt();
            int v2 = fs.nextInt();
            int v3 = fs.nextInt();
            row[j] = v0; colSum[j] += v0;
            row[j+1] = v1; colSum[j+1] += v1;
            row[j+2] = v2; colSum[j+2] += v2;
            row[j+3] = v3; colSum[j+3] += v3;
        }
        for (; j < n; ++j) {
            int v = fs.nextInt();
            row[j] = v;
            colSum[j] += v;
        }
    }

    // Horizontal maximum for the first top row.
    long long hsum = 0;
    for (int j = 0; j < s; ++j) hsum += colSum[j];
    long long mx = hsum;
    int j = s;
    for (; j + 3 < n; j += 4) {
        hsum += colSum[j] - colSum[j-s];
        if (hsum > mx) mx = hsum;
        hsum += colSum[j+1] - colSum[j+1-s];
        if (hsum > mx) mx = hsum;
        hsum += colSum[j+2] - colSum[j+2-s];
        if (hsum > mx) mx = hsum;
        hsum += colSum[j+3] - colSum[j+3-s];
        if (hsum > mx) mx = hsum;
    }
    for (; j < n; ++j) {
        hsum += colSum[j] - colSum[j-s];
        if (hsum > mx) mx = hsum;
    }

    const int mod = s + 1;
    int slot = s % mod;
    int oldSlot = 0;

    // Process remaining rows with a circular buffer.
    for (int r = s; r < n; ++r) {
        int* newRow = &ring[static_cast<size_t>(slot) * n];
        const int* oldRow = &ring[static_cast<size_t>(oldSlot) * n];

        // Read and update column sums in one pass.
        int jj = 0;
        for (; jj + 3 < n; jj += 4) {
            int v0 = fs.nextInt();
            int v1 = fs.nextInt();
            int v2 = fs.nextInt();
            int v3 = fs.nextInt();
            newRow[jj] = v0; colSum[jj] += static_cast<long long>(v0) - oldRow[jj];
            newRow[jj+1] = v1; colSum[jj+1] += static_cast<long long>(v1) - oldRow[jj+1];
            newRow[jj+2] = v2; colSum[jj+2] += static_cast<long long>(v2) - oldRow[jj+2];
            newRow[jj+3] = v3; colSum[jj+3] += static_cast<long long>(v3) - oldRow[jj+3];
        }
        for (; jj < n; ++jj) {
            int v = fs.nextInt();
            newRow[jj] = v;
            colSum[jj] += static_cast<long long>(v) - oldRow[jj];
        }

        // Horizontal maximum for this top row.
        hsum = 0;
        for (int j2 = 0; j2 < s; ++j2) hsum += colSum[j2];
        if (hsum > mx) mx = hsum;
        int k = s;
        for (; k + 3 < n; k += 4) {
            hsum += colSum[k] - colSum[k-s];
            if (hsum > mx) mx = hsum;
            hsum += colSum[k+1] - colSum[k+1-s];
            if (hsum > mx) mx = hsum;
            hsum += colSum[k+2] - colSum[k+2-s];
            if (hsum > mx) mx = hsum;
            hsum += colSum[k+3] - colSum[k+3-s];
            if (hsum > mx) mx = hsum;
        }
        for (; k < n; ++k) {
            hsum += colSum[k] - colSum[k-s];
            if (hsum > mx) mx = hsum;
        }

        // Advance ring indices without modulo.
        if (++slot == mod) slot = 0;
        if (++oldSlot == mod) oldSlot = 0;
    }

    std::printf("%d\n", static_cast<int>(mx));
    return 0;
}

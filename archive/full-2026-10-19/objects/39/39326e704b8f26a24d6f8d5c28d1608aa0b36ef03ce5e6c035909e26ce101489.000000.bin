    "files": [
      {
        "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nnamespace {\nconstexpr int MOD = 1000000007;\n\ninline void process_span(int* dp, int first, int last) {\n    int left = 0;\n    for (int col = first; col < last; ++col) {\n        int value = dp[col] + left;\n        if (value >= MOD) value -= MOD;\n        dp[col] = value;\n        left = value;\n    }\n}\n}\n\nint main() {\n    int n, m;\n    if (!(std::cin >> n >> m)) return 0;\n\n    std::vector<std::vector<int>> blocked_columns(n);\n    for (int c = 0; c < m; ++c) {\n        int row, col;\n        std::cin >> row >> col;\n        blocked_columns[row].push_back(col);\n    }\n    for (auto& columns : blocked_columns) {\n        std::sort(columns.begin(), columns.end());\n        columns.erase(std::unique(columns.begin(), columns.end()), columns.end());\n    }\n\n    std::vector<int> dp(n, 0);\n    dp[0] = 1;\n\n    for (int row = 0; row < n; ++row) {\n        int first = 0;\n        for (int col : blocked_columns[row]) {\n            process_span(dp.data(), first, col);\n            dp[col] = 0;\n            first = col + 1;\n        }\n        process_span(dp.data(), first, n);\n    }\n\n    std::cout << dp[n - 1] << '\\n';\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }
    ],

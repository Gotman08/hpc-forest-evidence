e_dataset(nbodies, bodies);\\n+  write_dataset(nbodies, x, y, z, vx, vy, vz);\\n+\\n+  free(x); free(y); free(z);\\n+  free(vx); free(v\"}, {\"id\": \"07a9b10a2e834526\", \"role\": \"C\", \"commit\": \"483895a01df00d6b450c84403a9561b26b9df64a\", \"transformations\": {\"files\": [\"src/nbody.c\"], \"retained\": [\"Added #include <omp.h>\", \"Wrapped entire time-stepping loop in a single #pragma omp parallel region with default(none) and explicit sharing of bodies and nbodies\", \"Inlined body_force computation into the main loop to enable direct worksharing directives\", \"Applied schedule(dynamic,32) on the force-computation workshare for adaptive load balancing\", \"Applied schedule(static) on the position-update workshare for minimal overhead\", \"Removed separate body_force function call (logic now inline)\"]}, \"mean_seconds\": 0.18284007596472898, \"diff\": \"diff --git a/src/nbody.c b/src/nbody.c\\nindex 765bd6a..df88e79 100644\\n--- a/src/nbody.c\\n+++ b/src/nbody.c\\n@@ -2,49 +2,14 @@\\n #include <stdlib.h>\\n #include <string.h>\\n #include <math.h>\\n+#include <omp.h>\\n \\n #define N_ITER 10 // number of simulation iterations\\n #define DT 0.01f // time step\\n #define SOFTENING 1e-9f // to avoid zero divisors\\n \\n-/*\\n- * Each body holds coordinate positions (i.e., x, y, and z) and\\n- * velocities (i.e., vx, vy, and vz).\\n- */\\n typedef struct { float x, y, z, vx, vy, vz; } Body;\\n \\n-/*\\n- * Compute the gravitational impact among all pairs of bodies in \\n- * the system.\\n- */\\n-void body_force(Body *p, float dt, int n) {\\n-  for (int i = 0; i < n; ++i) {\\n-    float fx = 0.0f; \\n-    float fy = 0.0f; \\n-    float fz = 0.0f;\\n-\\n-    for (int j = 0; j < n; j++) {\\n-      float dx = p[j].x - p[i].x;\\n-      float dy = p[j].y - p[i].y;\\n-      float dz = p[j].z - p[i].z;\\n-      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n-      float inv_dist = 1 / sqrt(sqrd_dist);\\n-      float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n-\\n-      fx += dx * inv_dist3; \\n-      fy += dy * inv_dist3; \\n-      fz += dz * inv_dist3;\\n-    }\\n-\\n-    p[i].vx += dt*fx; \\n-    p[i].vy += dt*fy; \\n-    p[i].vz += dt*fz;\\n-  }\\n-}\\n-\\n-/*\\n- * Read a binary dataset with initilized bodies.\\n- */\\n Body* read_dataset(int *nbodies) {\\n   int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\\n   if (b != 1) {\\n@@ -57,13 +22,9 @@ Body* read_dataset(int *nbodies) {\\n     fprintf(stderr,\\\"\\\\nError reading input values\\\\n\\\");\\n     exit(EXIT_FAILURE);\\n   }\\n-\\n   return bodies;\\n }\\n \\n-/*\\n- * Write simulation results into a binary dataset.\\n- */\\n void write_dataset(const int nbodies, Body *bodies) {\\n   int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\\n   if (b != 1) {\\n@@ -74,26 +35,47 @@ void write_dataset(const int nbodies, Body *bodies) {\\n \\n int main(int argc,char **argv) {\\n   int nbodies;\\n-\\n   Body *bodies = read_dataset(&nbodies);\\n \\n-  /*\\n-   * At each simulation iteration, interbody forces are computed,\\n-   * and bodies' positions are integrated.\\n-   */\\n-  for (int iter = 0; iter < N_ITER; iter++) {\\n-    body_force(bodies, DT, nbodies);\\n+  #pragma omp parallel default(none) shared(bodies, nbodies)\\n+  {\\n+    for (int iter = 0; iter < N_ITER; ++iter) {\\n+      // Force computation: each thread handles a subset of bodies i\\n+      #pragma omp for schedule(dynamic,32)\\n+      for (int i = 0; i < nbodies; ++i) {\\n+        float fx = 0.0f;\\n+        float fy = 0.0f;\\n+        float fz = 0.0f;\\n+\\n+        for (int j = 0; j < nbodies; ++j) {\\n+          float dx = bodies[j].x - bodies[i].x;\\n+          float dy = bodies[j].y - bodies[i].y;\\n+          float dz = bodies[j].z - bodies[i].z;\\n+          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n+          float inv_dist = 1.0f / sqrt(sqrd_dist);\\n+          float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n+\\n+          fx += dx * inv_dist3;\\n+          fy += dy * inv_dist3;\\n+          fz += dz * inv_dist3;\\n+        }\\n \\n-    for (int i = 0; i < nbodies; i++) {\\n-      bodies[i].x += bodies[i].vx * DT;\\n-      bodies[i].y += bodies[i].vy * DT;\\n-      bodies[i].z += bodies[i].vz * DT;\\n+        bodies[i].vx += DT * fx;\\n+        bodies[i].vy += DT * fy;\\n+        bodies[i].vz += DT * fz;\\n+      } // implicit barrier after force loop\\n+\\n+      // Position update: each thread updates its assigned subset of bodies\\n+      #pragma omp for schedule(static)\\n+      for (int i = 0; i < nbodies; ++i) {\\n+        bodies[i].x += bodies[i].vx * DT;\\n+        bodies[i].y += bodies[i].vy * DT;\\n+        bodies[i].z += bodies[i].vz * DT;\\n+      } // implicit barrier before next iteration\\n     }\\n-  }\\n+  } // end parallel region\\n \\n   write_dataset(nbodies, bodies);\\n-\\n   free(bodies);\\n-  \\n   exit(EXIT_SUCCESS);\\n }\"}], \"interactions\": [{\"sources\": [\"68ff7153b7cf44fb\", \"9dc3f0c8e8f74644\", \"07a9b10a2e834526\"], \"outcome\": {\"binary_sha256\": \"7f2dc8e6724cfd43a759a0f402d907501be2924fd1a0004a29f162035523e071\", \"cache_key\": \"b264d4dc110c31acd1f4c38140cda06da0276006a9c25e8d6ec859c860248d7d\", \"commit\": \"15a2602be0b27e09ae1dd9fe3c2850fda5678bf2\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/cbfc17185d0d42e3/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/cbfc17185d0d42e3/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/cbfc17185d0d42e3/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/cbfc17185d0d42e3/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/cbfc17185d0d42e3/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/cbfc17185d0d42e3/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.201728374697268, \"reason\": \"\", \"score\": 0.7704173041230274, \"status\": \"valid\", \"times\": [0.2022755118086934, 0.20141053572297096, 0.20149907656013966], \"tree_hash\": \"84318a5dc07f3a6e8212d7772b922a0d80803837\"}}, {\"sources\": [\"c0f0d90193584d7c\", \"e94ca336b795485a\", \"71712efb62df4296\"], \"outcome\": {\"binary_sha256\": \"64da0dcb2ec1a04dc983295f08fc456256416d0ab6611cbc6bc84cd31eefbe09\", \"cache_key\": \"3ff11ecd11df229cd843bfd03c97a512d8cb40a952ef4dfa7e1247615439b2c8\", \"commit\": \"59eb08345ffcaeebc022c6d89f7b8be26e982a94\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/cae76d5e1d774bdd/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/cae76d5e1d774bdd/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/cae76d5e1d774bdd/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/cae76d5e1d774bdd/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/cae76d5e1d774bdd/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/cae76d5e1d774bdd/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.2220400975396236, \"reason\": \"\", \"score\": 0.7530104642150958, \"status\": \"valid\", \"times\": [0.22208566404879093, 0.22207452915608883, 0.22196009941399097], \"tree_hash\
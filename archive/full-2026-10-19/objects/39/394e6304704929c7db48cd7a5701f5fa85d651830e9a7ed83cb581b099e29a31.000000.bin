      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n#define SHARD_COUNT 4\n#define PARALLEL_THRESHOLD 4096\n\ntypedef struct {\n    long int *data;\n    long int total;\n} bucket;\n\nstatic char *sort_strings;\nstatic size_t sort_length;\n\nstatic int compare_indices(const void *left, const void *right) {\n    long int left_index = *(const long int *)left;\n    long int right_index = *(const long int *)right;\n    return strcmp(sort_strings + (size_t)left_index * sort_length,\n                  sort_strings + (size_t)right_index * sort_length);\n}\n\nlong int *bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\n    long int *returns;\n    long int *counts;\n    long int *next;\n    bucket *buckets;\n    size_t histogram_entries = (size_t)SHARD_COUNT * (size_t)nbuckets;\n    int active_shards;\n\n    if (size <= 0)\n        return NULL;\n\n    returns = (long int *)malloc(sizeof(*returns) * (size_t)size);\n    counts = (long int *)calloc(histogram_entries, sizeof(*counts));\n    next = (long int *)malloc(histogram_entries * sizeof(*next));\n    buckets = (bucket *)malloc(sizeof(*buckets) * (size_t)nbuckets);\n    if (returns == NULL || counts == NULL || next == NULL || buckets == NULL) {\n        free(returns);\n        free(counts);\n        free(next);\n        free(buckets);\n        fprintf(stderr, \"Unable to allocate bucket-sort storage\\n\");\n        exit(EXIT_FAILURE);\n    }\n\n    active_shards = size >= PARALLEL_THRESHOLD ? SHARD_COUNT : 1;\n\n    /* Count each shard's keys independently. */\n    #pragma omp parallel for schedule(static) num_threads(SHARD_COUNT) if(active_shards > 1)\n    for (int t = 0; t < active_shards; t++) {\n        long int chunk = size / active_shards;\n        long int remainder = size % active_shards;\n        long int begin = chunk * t + (remainder * t) / active_shards;\n        long int end = chunk * (t + 1) + (remainder * (t + 1)) / active_shards;\n\n        for (long int i = begin; i < end; i++) {\n            int key = a[(size_t)i * (size_t)length] - offset;\n            counts[(size_t)t * (size_t)nbuckets + (size_t)key]++;\n        }\n    }\n\n    /* Assign exact, disjoint ranges within each bucket to each shard. */\n    {\n        long int base = 0;\n        for (int b = 0; b < nbuckets; b++) {\n            long int bucket_total = 0;\n            for (int t = 0; t < SHARD_COUNT; t++) {\n                size_t slot = (size_t)t * (size_t)nbuckets + (size_t)b;\n                next[slot] = base + bucket_total;\n                bucket_total += counts[slot];\n            }\n            buckets[b].data = returns + base;\n            buckets[b].total = bucket_total;\n            base += bucket_total;\n        }\n    }\n\n    /* Scatter each shard into its private ranges without synchronization. */\n    #pragma omp parallel for schedule(static) num_threads(SHARD_COUNT) if(active_shards > 1)\n    for (int t = 0; t < active_shards; t++) {\n        long int chunk = size / active_shards;\n        long int remainder = size % active_shards;\n        long int begin = chunk * t + (remainder * t) / active_shards;\n        long int end = chunk * (t + 1) + (remainder * (t + 1)) / active_shards;\n\n        for (long int i = begin; i < end; i++) {\n            int key = a[(size_t)i * (size_t)length] - offset;\n            size_t slot = (size_t)t * (size_t)nbuckets + (size_t)key;\n            returns[next[slot]++] = i;\n        }\n    }\n\n    sort_strings = a;\n    sort_length = (size_t)length;\n\n    /* Bucket ranges are independent and can be sorted in parallel. */\n    #pragma omp parallel for schedule(dynamic, 1) num_threads(SHARD_COUNT) if(active_shards > 1)\n    for (int b = 0; b < nbuckets; b++) {\n        if (buckets[b].total > 1) {\n            qsort(buckets[b].data, (size_t)buckets[b].total,\n                  sizeof(*returns), compare_indices);\n        }\n    }\n\n    free(counts);\n    free(next);\n    free(buckets);\n    return returns;\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb) {\n    char *strings = NULL;\n    int len, offset, nbucket;\n    long int n;\n\n    if (!fscanf(stdin, \"%d\", &len)) {\n        printf(\"ERROR len\\n\");\n        exit(1);\n    }\n    if (!fscanf(stdin, \"%ld\", &n)) {\n        printf(\"ERROR n\\n\");\n        exit(1);\n    }\n    if (!fscanf(stdin, \"%d\", &offset)) {\n        printf(\"ERROR offset\\n\");\n        exit(1);\n    }\n    if (!fscanf(stdin, \"%d\", &nbucket)) {\n        printf(\"ERROR nbucket\\n\");\n        exit(1);\n    }\n\n    nbucket++;\n    len++;\n    strings = (char *)malloc((size_t)n * (size_t)len);\n\n    for (long int i = 0; i < n; i++) {\n        if (!fscanf(stdin, \"%s\", strings + (size_t)i * (size_t)len)) {\n            printf(\"ERROR %ld\\n\", i);\n            exit(1);\n        }\n    }\n\n    *vString = strings;\n    *N = n;\n    *l = len;\n    *os = offset;\n    *nb = nbucket;\n}\n\nvoid print(char *strings, long int *index, long int n, int len) {\n    for (long int i = 0; i < n; i++)\n        printf(\"%ld -> %s\\n\", i, strings + (size_t)index[i] * (size_t)len);\n}\n\nvoid save(char *strings, long int *index, long int n, int len) {\n    for (long int i = 0; i < n; i++)\n        printf(\"%s\\n\", strings + (size_t)index[i] * (size_t)len);\n}\n\nint main(int ac, char **av) {\n    char *strings = NULL;\n    long int N = 0;\n    long int *index = NULL;\n    int len = 0;\n    int offset;\n    int nbuckets;\n\n    (void)ac;\n    (void)av;\n    load(&strings, &N, &len, &offset, &nbuckets);\n    index = bucket_sort(strings, len, N, offset, nbuckets);\n    save(strings, index, N, len);\n\n    free(strings);\n    free(index);\n    return EXIT_SUCCESS;\n}\n",
      "path": "src/bucketsort.c"
    }
  ],
  "hypothesis": "Combining per-shard histograms and race-free prefix-range scattering with dynamically scheduled qsorts should preserve bucket ordering while parallelizing large inputs and avoiding insertion-sort scaling; small inputs retain one active shard.",

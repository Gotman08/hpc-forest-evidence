      "id": "fa68c74a6eb843b6",
      "role": "A",
      "mission": {
        "base_commit": "a5e0672591c9e582669e8b1ad8463e52511a5cca",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Replacing the pointer-chased BFS frontier with contiguous level arrays, while removing the now-unneeded per-state queue pointer, will improve cache locality and reduce state-pool footprint on ARM64.",
        "id": "fa68c74a6eb843b6",
        "ordinal": 1,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/sokoban.c"
          ],
          "retained": [
            "Store BFS frontier states in growable contiguous arrays and traverse each level in reverse insertion order.",
            "Remove qnext from state_t and align pooled state records to pointer-size boundaries."
          ]
        },
        "tree_id": "e1:A",

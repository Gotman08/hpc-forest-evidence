      "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconstexpr int MOD = 1000000007;\n\nstruct Point {\n    int row;\n    int column;\n    int diagonal;\n};\n\nstatic int modPower(int base, int exponent) {\n    long long result = 1;\n    long long value = base;\n    while (exponent != 0) {\n        if (exponent & 1) {\n            result = result * value % MOD;\n        }\n        value = value * value % MOD;\n        exponent >>= 1;\n    }\n    return static_cast<int>(result);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    cin >> n >> m;\n\n    vector<Point> blocked;\n    blocked.reserve(static_cast<size_t>(m));\n    bool endpointBlocked = false;\n\n    for (int index = 0; index < m; ++index) {\n        int row, column;\n        cin >> row >> column;\n        if ((row == 0 && column == 0) ||\n            (row == n - 1 && column == n - 1)) {\n            endpointBlocked = true;\n        } else {\n            blocked.push_back({row, column, row + column});\n        }\n    }\n\n    if (endpointBlocked) {\n        cout << 0 << '\\n';\n        return 0;\n    }\n\n    sort(blocked.begin(), blocked.end(), [](const Point& left, const Point& right) {\n        if (left.diagonal != right.diagonal) {\n            return left.diagonal < right.diagonal;\n        }\n        if (left.row != right.row) {\n            return left.row < right.row;\n        }\n        return left.column < right.column;\n    });\n    blocked.erase(unique(blocked.begin(), blocked.end(), [](const Point& left, const Point& right) {\n        return left.row == right.row && left.column == right.column;\n    }), blocked.end());\n\n    const int maximumSteps = 2 * (n - 1);\n    vector<int> factorial(maximumSteps + 1);\n    vector<int> inverseFactorial(maximumSteps + 1);\n    factorial[0] = 1;\n    for (int value = 1; value <= maximumSteps; ++value) {\n        factorial[value] = static_cast<long long>(factorial[value - 1]) * value % MOD;\n    }\n    inverseFactorial[maximumSteps] = modPower(factorial[maximumSteps], MOD - 2);\n    for (int value = maximumSteps; value > 0; --value) {\n        inverseFactorial[value - 1] = static_cast<long long>(inverseFactorial[value]) * value % MOD;\n    }\n\n    const auto binomial = [&](int total, int chosen) {\n        return static_cast<int>(static_cast<long long>(factorial[total]) * inverseFactorial[chosen] % MOD *\n                                inverseFactorial[total - chosen] % MOD);\n    };\n\n    vector<int> waysToBlocked(blocked.size());\n    const auto calculateBlockedWays = [&](size_t current, size_t completed) {\n        const Point& point = blocked[current];\n        long long ways = binomial(point.diagonal, point.row);\n\n        for (size_t previousIndex = 0; previousIndex < completed; ++previousIndex) {\n            const Point& previous = blocked[previousIndex];\n            if (previous.row <= point.row && previous.column <= point.column) {\n                const int steps = point.diagonal - previous.diagonal;\n                const int downSteps = point.row - previous.row;\n                const long long throughPrevious =\n                    static_cast<long long>(waysToBlocked[previousIndex]) * binomial(steps, downSteps) % MOD;\n                ways -= throughPrevious;\n                if (ways < 0) {\n                    ways += MOD;\n                }\n            }\n        }\n        waysToBlocked[current] = static_cast<int>(ways);\n    };\n\n    for (size_t begin = 0; begin < blocked.size();) {\n        size_t end = begin + 1;\n        while (end < blocked.size() && blocked[end].diagonal == blocked[begin].diagonal) {\n            ++end;\n        }\n\n        const size_t completed = begin;\n        if (end - begin >= 64) {\n#pragma omp parallel for schedule(static)\n            for (long long current = static_cast<long long>(begin);\n                 current < static_cast<long long>(end); ++current) {\n                calculateBlockedWays(static_cast<size_t>(current), completed);\n            }\n        } else {\n            for (size_t current = begin; current < end; ++current) {\n                calculateBlockedWays(current, completed);\n            }\n        }\n        begin = end;\n    }\n\n    long long answer = binomial(maximumSteps, n - 1);\n    for (size_t index = 0; index < blocked.size(); ++index) {\n        const Point& point = blocked[index];\n        const int steps = maximumSteps - point.diagonal;\n        const int downSteps = n - 1 - point.row;\n        const long long throughBlocked =\n            static_cast<long long>(waysToBlocked[index]) * binomial(steps, downSteps) % MOD;\n        answer -= throughBlocked;\n        if (answer < 0) {\n            answer += MOD;\n        }\n    }\n\n    cout << answer << '\\n';\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Replacing the quadratic grid DP with exact obstacle inclusion-exclusion removes the O(n^2) allocation and work; grouping incomparable blocked points by row+column makes each group legally OpenMP-parallel while retaining serial execution for small groups.",
  "notes": "Blocked coordinates are deduplicated, and blocked start or destination cells return zero. Each parallel group reads only completed earlier diagonals and writes a distinct result slot.",
  "sources_kept": [],
  "transformations": [
    "Use factorial-based binomial path counts and inclusion-exclusion over sorted blocked points.",
    "Process equal-diagonal blocked points concurrently because none can be a monotone predecessor of another.",
    "Use a serial path for small diagonal groups to avoid parallel-region overhead."
  ]

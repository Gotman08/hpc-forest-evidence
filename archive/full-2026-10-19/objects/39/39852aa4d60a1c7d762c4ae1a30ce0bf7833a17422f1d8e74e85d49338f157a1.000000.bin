          ],
          "retained": [
            "Pack positions into four-lane AoSoA packets, excluding velocities from the source stream.",
            "Share sources across four independent SIMD target lanes with static OpenMP tile ownership and ordered source-packet traversal.",
            "Disable math errno only in optimized force kernels to permit vectorization of the unchanged double-precision sqrt/division; retain a scalar allocation-failure fallback."
          ]
        },

      "mission": {
        "base_commit": "90d396ed8dfd41b38fa8ea47e2e83f23910143f2",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Sharing each 256-source SoA slab across 64 targets should reduce source-cache traffic, while eight-target SIMD microtiles limit ARM64 register pressure and retain each body's accumulation order.",
        "id": "56093bc0f9064939",
        "ordinal": 3,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/nbody.c"
          ],
          "retained": [
            "Pack immutable positions into three compact arrays for each force call.",
            "Use 64-target by 256-source cache blocking with eight-target SIMD microtiles; preserve ascending source order across slabs.",
            "Statically distribute independent target blocks using the existing OpenMP configuration, with smaller target blocks for small systems.",
            "Disable only math-errno bookkeeping in the microkernel to permit SIMD sqrt/division without approximate arithmetic."
          ]
        },

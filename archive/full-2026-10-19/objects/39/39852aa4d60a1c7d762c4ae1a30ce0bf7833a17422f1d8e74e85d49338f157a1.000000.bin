    {
      "id": "10127d889534436f",
      "role": "B",
      "mission": {
        "base_commit": "90d396ed8dfd41b38fa8ea47e2e83f23910143f2",
        "delegation_parent": "R/B",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "SIMD across four independent target bodies can accelerate ARM64 force calculations without reordering each body's source-body accumulation. Independent target tiles can also use the existing OpenMP thread budget.",
        "id": "10127d889534436f",
        "ordinal": 1,
        "parent_id": null,
        "role": "B",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/nbody.c"
          ],
          "retained": [
            "Tile targets into four private coordinate and accumulator lanes; SIMD-vectorize the lane loop while keeping source bodies sequential.",
            "Distribute independent tiles with OpenMP static scheduling, avoiding thread-launch overhead for small systems; handle remaining targets with the original scalar calculation.",
            "Enable function-local GCC no-math-errno to permit vector sqrt lowering without enabling reassociation or replacing double sqrt with sqrtf."
          ]
        },
        "tree_id": "e1:B",
        "trial_id": "01M51JNZAXYB8ZRE7VPVD3DA0S",

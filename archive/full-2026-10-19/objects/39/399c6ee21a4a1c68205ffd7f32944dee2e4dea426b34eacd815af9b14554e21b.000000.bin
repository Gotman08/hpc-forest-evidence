et(int *nbodies,\\n+                         float **px, float **py, float **pz,\\n+                         float **pvx, float **pvy, float **pvz) {\\n+    int n;\\n+    if (fread(&n, sizeof(n), 1, stdin) != 1) {\\n+        fprintf(stderr, \\\"\\\\nError reading nbodie value\\\\n\\\");\\n+        exit(EXIT_FAILURE);\\n     }\\n+    *nbodies = n;\\n \\n-    p[i].vx += dt*fx; \\n-    p[i].vy += dt*fy; \\n-    p[i].vz += dt*fz;\\n-  }\\n+    Body *tmp = (Body *)malloc((size_t)n * sizeof(Body));\\n+    if (!tmp) { perror(\\\"malloc\\\"); exit(EXIT_FAILURE); }\\n+\\n+    if (fread(tmp, (size_t)n * sizeof(Body), 1, stdin) != 1) {\\n+        fprintf(stderr, \\\"\\\\nError reading input values\\\\n\\\");\\n+        free(tmp);\\n+        exit(EXIT_FAILURE);\\n+    }\\n+\\n+    float *x = (float *)malloc((size_t)n * sizeof(float));\\n+    float *y = (float *)malloc((size_t)n * sizeof(float));\\n+    float *z = (float *)malloc((size_t)n * sizeof(float));\\n+    float *vx = (float *)malloc((size_t)n * sizeof(float));\\n+    float *vy = (float *)malloc((size_t)n * sizeof(float));\\n+    float *vz = (float *)malloc((size_t)n * sizeof(float));\\n+\\n+    if (!x || !y || !z || !vx || !vy || !vz) {\\n+        perror(\\\"malloc\\\");\\n+        exit(EXIT_FAILURE);\\n+    }\\n+\\n+    for (int i = 0; i < n; ++i) {\\n+        x[i] = tmp[i].x;\\n+        y[i] = tmp[i].y;\\n+        z[i] = tmp[i].z;\\n+        vx[i] = tmp[i].vx;\\n+        vy[i] = tmp[i].vy;\\n+        vz[i] = tmp[i].vz;\\n+    }\\n+\\n+    free(tmp);\\n+\\n+    *px = x; *py = y; *pz = z;\\n+    *pvx = vx; *pvy = vy; *pvz = vz;\\n }\\n \\n-/*\\n- * Read a binary dataset with initilized bodies.\\n- */\\n-Body* read_dataset(int *nbodies) {\\n-  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\\n-  if (b != 1) {\\n-    fprintf(stderr,\\\"\\\\nError reading nbodie value\\\\n\\\");\\n-    exit(EXIT_FAILURE);\\n-  }\\n-  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\\n-  b = fread(bodies, *nbodies * sizeof(Body),
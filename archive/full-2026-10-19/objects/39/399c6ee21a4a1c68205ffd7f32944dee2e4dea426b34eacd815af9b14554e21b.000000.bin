ion, interbody forces are computed,\\n-   * and bodies' positions are integrated.\\n-   */\\n-  for (int iter = 0; iter < N_ITER; iter++) {\\n-    body\"}, {\"id\": \"497dddd10ed44d29\", \"role\": \"C\", \"commit\": \"1ff6adf756cedd3c771cdc34dbfd41570661ab41\", \"transformations\": {\"files\": [\"src/nbody.c\"], \"retained\": [\"Double buffering using alternating arrays\", \"Manual OpenMP thread partitioning instead of worksharing loop\", \"Explicit barrier for synchronization\"]}, \"mean_seconds\": 0.17641319365551075, \"diff\": \"diff --git a/src/nbody.c b/src/nbody.c\\nindex 765bd6a..66e7fc4 100644\\n--- a/src/nbody.c\\n+++ b/src/nbody.c\\n@@ -2,49 +2,14 @@\\n #include <stdlib.h>\\n #include <string.h>\\n #include <math.h>\\n+#include <omp.h>\\n \\n #define N_ITER 10 // number of simulation iterations\\n #define DT 0.01f // time step\\n #define SOFTENING 1e-9f // to avoid zero divisors\\n \\n-/*\\n- * Each body holds coordinate positions (i.e., x, y, and z) and\\n- * velocities (i.e., vx, vy, and vz).\\n- */\\n typedef struct { float x, y, z, vx, vy, vz; } Body;\\n \\n-/*\\n- * Compute the gravitational impact among all pairs of bodies in \\n- * the system.\\n- */\\n-void body_force(Body *p, float dt, int n) {\\n-  for (int i = 0; i < n; ++i) {\\n-    float fx = 0.0f; \\n-    float fy = 0.0f; \\n-    float fz = 0.0f;\\n-\\n-    for (int j = 0; j < n; j++) {\\n-      float dx = p[j].x - p[i].x;\\n-      float dy = p[j].y - p[i].y;\\n-      float dz = p[j].z - p[i].z;\\n-      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n-      float inv_dist = 1 / sqrt(sqrd_dist);\\n-      float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n-\\n-      fx += dx * inv_dist3; \\n-      fy += dy * inv_dist3; \\n-      fz += dz * inv_dist3;\\n-    }\\n-\\n-    p[i].vx += dt*fx; \\n-    p[i].vy += dt*fy; \\n-    p[i].vz += dt*fz;\\n-  }\\n-}\\n-\\n-/*\\n- * Read a binary dataset with initilized bodies.\\n- */\\n Body* read_dataset(int *nbodies) {\\n   int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\\n   if (b != 1) {\\n@@ -57,13 +22,9 @@ Body* read_dataset(int *nbodies) {\\n     fprintf(stderr,\\\"\\\\nError reading input values\\\\n\\\");\\n     exit(EXIT_FAILURE);\\n   }\\n-\\n   return bodies;\\n }\\n \\n-/*\\n- * Write simulation results into a binary dataset.\\n- */\\n void write_dataset(const int nbodies, Body *bodies) {\\n   int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\\n   if (b != 1) {\\n@@ -74,26 +35,57 @@ void write_dataset(const int nbodies, Body *bodies) {\\n \\n int main(int argc,char **argv) {\\n   int nbodies;\\n+  Body *initial = read_dataset(&nbodies);\\n+\\n+  // Allocate two buffers for double buffering to avoid data races\\n+  Body *bodiesA = (Body *)malloc(nbodies * sizeof(Body));\\n+  Body *bodiesB = (Body *)malloc(nbodies * sizeof(Body));\\n+  memcpy(bodiesA, initial, nbodies * sizeof(Body));\\n+\\n+  #pragma omp parallel\\n+  {\\n+    int tid = omp_get_thread_num();\\n+    int nthreads = omp_get_num_threads();\\n \\n-  Body *bodies = read_dataset(&nbodies);\\n+    for (int iter = 0; iter < N_ITER; ++iter) {\\n+      // Determine source and destination buffers based on iteration parity\\n+      Body *src = (iter % 2 == 0) ? bodiesA : bodiesB;\\n+      Body *dst = (iter % 2 == 0) ? bodiesB : bodiesA;\\n \\n-  /*\\n-   * At each simulation iteration, interbody forces are computed,\\n-   * and bodies' positions are integrated.\\n-   */\\n-  for (int iter = 0; iter < N_ITER; iter++) {\\n-    body_force(bodies, DT, nbodies);\\n+      // Manual partitioning: each thread handles i = tid, tid+nthreads, ...\\n+      for (int i = tid; i < nbodies; i += nthreads) {\\n+        float fx = 0.0f, fy = 0.0f, fz = 0.0f;\\n+        // Use source buffer for all reads\\n+        for (int j = 0; j < nbodies; ++j) {\\n+          float dx = src[j].x - src[i].x;\\n+          float dy = src[j].y - src[i].y;\\n+          float dz = src[j].z - src[i].z;\\n+          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n+          float inv_dist = 1.0f / sqrt(sqrd_dist);\\n+          float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n+          fx += dx * inv_dist3;\\n+          fy += dy * inv_dist3;\\n+          fz += dz * inv_dist3;\\n+        }\\n+        dst[i].vx = src[i].vx + DT*fx;\\n+        dst[i].vy = src[i].vy + DT*fy;\\n+        dst[i].vz = src[i].vz + DT*fz;\\n+        dst[i].x = src[i].x + dst[i].vx * DT;\\n+        dst[i].y = src[i].y + dst[i].vy * DT;\\n+        dst[i].z = src[i].z + dst[i].vz * DT;\\n+      }\\n \\n-    for (int i = 0; i < nbodies; i++) {\\n-      bodies[i].x += bodies[i].vx * DT;\\n-      bodies[i].y += bodies[i].vy * DT;\\n-      bodies[i].z += bodies[i].vz * DT;\\n+      // Ensure all threads have written dst before next iteration reads it as src\\n+      #pragma omp barrier\\n     }\\n   }\\n \\n-  write_dataset(nbodies, bodies);\\n+  // Final state is in bodiesA if N_ITER even, else bodiesB\\n+  Body *final_bodies = (N_ITER % 2 == 0) ? bodiesA : bodiesB;\\n+  write_dataset(nbodies, final_bodies);\\n \\n-  free(bodies);\\n-  \\n+  free(initial);\\n+  free(bodiesA);\\n+  free(bodiesB);\\n   exit(EXIT_SUCCESS);\\n }\"}], \"interactions\": [{\"sources\": [\"704fffe5d2a849b5\", \"9e1fa41ec70e4ae4\", \"9adc054f311d4298\"], \"outcome\": {\"binary_sha256\": \"6f1fd6f2042d990d26aa6757374e80f316ac34875ba5573715806256a67b72ab\", \"cache_key\": \"eced7e6c67b1e774ce7e44543358f569f5cabb39319037c7d8f85e4251f9e022\", \"commit\": \"5c6625fe85e47f103386da80384244cfbe24126e\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/b231a612464d4649/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/b231a612464d4649/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/b231a612464d4649/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/b231a612464d4649/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/b231a612464d4649/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/b231a612464d4649/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.16151767425859967, \"reason\": \"\", \"score\": 0.806070791085033, \"status\": \"valid\", \"times\": [0.16150808497332036, 0.16128002596087754, 0.16176491184160113], \"tree_hash\": \"a56a77772a86a2e76013525f4f33f53458ecc436\"}}, {\"sources\": [\"89b40ce89590426a\", \"9e1fa41ec70e4ae4\", \"9adc054f311d4298\"], \"outcome\": {\"binary_sha256\": \"8e9595d6b7d36e00455a13c6c5092d02622c944874993ef15816e8ec3866cd9d\", \"cache_key\": \"798e52dd21006cabb2695f715a8d9682497d112f7f5a193d8f44aca790fb152d\", \"commit\": \"5c4f768c637e5b2e54b87c8ad06548dfed1dea79\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/4acd2d74c5d74746/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/4acd2d74c5d74746/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/4acd2d74c5d74746/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/4acd2d74c5d74746/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/4acd2d74c5d74746/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/4acd2d74c5d74746/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.1598300529488673, \"reason\": \"\", \"score\": 0.8077074276535644, \"status\": \"valid\", \"times\": [0.15975784114561975, 0.1598738708999008, 0.1598584468010813], \"tree_hash\": \"c741116b7dff80fc620a96e7020e11af0ba1a9d3\"}}, {\"sources\": [\"10af5e5f3ddc484d\", \"82ca35f9753444de\", \"9adc054f311d4298\"], \"outcome\": {\"binary_sha256\": \"87a8851c3aeb210a4c4f43d83e72f0b15fd96a1f0c5572eb2e389241f25c9c7f\", \"cache_key\": \"ffee243dba54408072fed9d94fd6964017c6bf6985d5df39221eb3b56ab2e96f\", \"commit\": \"3f0bd5464e3f7ef2963cbb670fb72bc3388627e4\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/b35117738c6247a9/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/b35117738c6247a9/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/b35117738c6247a9/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/b35117738c6247a9/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/b35117738c6247a9/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/nbody/logs/e1/b35117738c6247a9/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.16076572705060244, \"reason\": \"\", \"score\": 0.8067992012271333, \"status\": \"valid\", \"times\": [0.16084689903073013, 0.1607765629887581, 0.1606737191323191], \"tree_hash\": \"f4134ec169bf51161ec9263ba725a4c1adbd6bd4\"}}, {\"sources\": [\"704fffe5d2a849b5\", \"82ca35f9753444de\", \"9adc054
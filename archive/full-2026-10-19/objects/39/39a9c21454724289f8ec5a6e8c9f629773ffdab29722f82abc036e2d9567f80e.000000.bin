            "src/tropical.cpp"
          ],
          "retained": [
            "Build contiguous CSR adjacency once per generated spanning tree, preserving each vertex's existing edge-iteration order.",
            "Use shared path and visited buffers with backtracking for recursive tree search, replacing repeated spanning-edge scans.",
            "Precompute compact vertex color IDs and maintain path-local color frequencies and the distinct-color count incrementally.",
            "Retain the parent's cycle-check removal, const-reference parameters, byte membership flags, minimum-index tie behavior, and shared path stack."
          ]
        },

          ],
          "retained": [
            "Replace nested adjacency-matrix vectors with a single row-major vector and use matching row-major indexing for Prim and cycle checks.",
            "Use contiguous storage for the temporary cycle matrix while preserving the existing scan and update order.",
            "Pass read-only graph, edge-list, matrix, and helper-vector arguments by const reference to avoid unnecessary copies; retain recursive path-history behavior."
          ]

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include <omp.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

/*
 * Compute the gravitational impact among all pairs of bodies in 
 * the system.
 */
void body_force(float *restrict px, float *restrict py, float *restrict pz,
                float *restrict vx, float *restrict vy, float *restrict vz,
                int n) {
  #pragma omp parallel for schedule(static)
  for (int i = 0; i < n; ++i) {
    float fx = 0.0f;
    float fy = 0.0f;
    float fz = 0.0f;

    #pragma omp simd reduction(+:fx,fy,fz) aligned(px,py,pz:32)
    for (int j = 0; j < n; ++j) {
      float dx = px[j] - px[i];
      float dy = py[j] - py[i];
      float dz = pz[j] - pz[i];
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1.0f / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    vx[i] += DT*fx;
    vy[i] += DT*fy;
    vz[i] += DT*fz;
  }
}

/*
 * Read a binary dataset with initialized bodies.
 */
void read_dataset(int *nbodies, float **px, float **py, float **pz,
                  float **vx, float **vy, float **vz) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }

  size_t n = *nbodies;
  float *tmp = (float *)malloc(n * 6 * sizeof(float));
  if (!tmp) {
    fprintf(stderr,"\nError allocating temporary buffer\n");
    exit(EXIT_FAILURE);
  }

  b = fread(tmp, n * 6 * sizeof(float), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    free(tmp);
    exit(EXIT_FAILURE);
  }

  // Allocate aligned arrays for SIMD friendliness
  posix_memalign((void**)px, 32, n * sizeof(float));
  posix_memalign((void**)py, 32, n * sizeof(float));
  posix_memalign((void**)pz, 32, n * sizeof(float));
  posix_memalign((void**)vx, 32, n * sizeof(float));
  posix_memalign((void**)vy, 32, n * sizeof(float));
  posix_memalign((void**)vz, 32, n * sizeof(float));

  for (size_t i = 0; i < n; ++i) {
    (*px)[i] = tmp[i*6 + 0];
    (*py)[i] = tmp[i*6 + 1];
    (*pz)[i] = tmp[i*6 + 2];
    (*vx)[i] = tmp[i*6 + 3];
    (*vy)[i] = tmp[i*6 + 4];
    (*vz)[i] = tmp[i*6 + 5];
  }

  free(tmp);
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(const int nbodies, float *px, float *py, float *pz,
                   float *vx, float *vy, float *vz) {
  size_t n = (size_t)nbodies;
  float *tmp = (float *)malloc(n * 6 * sizeof(float));
  if (!tmp) {
    fprintf(stderr,"\nError allocating temporary buffer\n");
    exit(EXIT_FAILURE);
  }

  for (size_t i = 0; i < n; ++i) {
    tmp[i*6 + 0] = px[i];
    tmp[i*6 + 1] = py[i];
    tmp[i*6 + 2] = pz[i];
    tmp[i*6 + 3] = vx[i];
    tmp[i*6 + 4] = vy[i];
    tmp[i*6 + 5] = vz[i];
  }

  int b = fwrite(tmp, n * 6 * sizeof(float), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    free(tmp);
    exit(EXIT_FAILURE);
  }

  free(tmp);
}

int main(int argc,char **argv) {
  int nbodies;
  float *px, *py, *pz, *vx, *vy, *vz;

  read_dataset(&nbodies, &px, &py, &pz, &vx, &vy, &vz);

  /*
   * At each simulation iteration, interbody forces are computed,
   * and bodies' positions are integrated.
   */
  for (int iter = 0; iter < N_ITER; ++iter) {
    body_force(px, py, pz, vx, vy, vz, nbodies);

    #pragma omp parallel for schedule(static)
    for (int i = 0; i < nbodies; ++i) {
      px[i] += vx[i] * DT;
      py[i] += vy[i] * DT;
      pz[i] += vz[i] * DT;
    }
  }

  write_dataset(nbodies, px, py, pz, vx, vy, vz);

  free(px); free(py); free(pz);
  free(vx); free(vy); free(vz);

  exit(EXIT_SUCCESS);
}

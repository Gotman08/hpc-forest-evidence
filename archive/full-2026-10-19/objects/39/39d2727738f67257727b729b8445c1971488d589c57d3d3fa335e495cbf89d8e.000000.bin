    {
      "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<uint64_t> blocked;\n    blocked.reserve(m);\n    for (int c = 0; c < m; ++c) {\n        int i, j;\n        cin >> i >> j;\n        blocked.push_back(uint64_t(i) * uint64_t(n) + uint64_t(j));\n    }\n    sort(blocked.begin(), blocked.end());\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\n\n    vector<int> dp(n, 0);\n    dp[0] = 1;\n    size_t next = 0;\n    for (int i = 0; i < n; ++i) {\n        const uint64_t base = uint64_t(i) * uint64_t(n);\n        const uint64_t end = base + uint64_t(n);\n        int j = 0;\n        int left = 0;\n        while (next < blocked.size() && blocked[next] < end) {\n            const int stop = int(blocked[next] - base);\n            for (; j < stop; ++j) {\n                int value = dp[j] + left;\n                if (value >= MOD) value -= MOD;\n                dp[j] = value;\n                left = value;\n            }\n            dp[j] = 0;\n            left = 0;\n            ++j;\n            ++next;\n        }\n        for (; j < n; ++j) {\n            int value = dp[j] + left;\n            if (value >= MOD) value -= MOD;\n            dp[j] = value;\n            left = value;\n        }\n    }\n\n    cout << dp[n - 1] << endl;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "A contiguous in-place DP row and obstacle-free spans reduce memory traffic and eliminate per-cell bitmap access, remainder operations, and row copying.",
  "notes": "Preserves duplicate obstacles, blocked endpoints, and n=1. Uses O(n+m) storage and O(n²+m log m) time. No execution or measurements performed.",
  "sources_kept": [],
  "transformations": [
    "Replace two DP rows and copying with one contiguous row and a scalar left neighbor.",
    "Sort and deduplicate flattened obstacle coordinates; process contiguous unblocked spans without bitmap lookups.",
    "Replace modular remainder with one conditional subtraction; sums remain within signed int range."

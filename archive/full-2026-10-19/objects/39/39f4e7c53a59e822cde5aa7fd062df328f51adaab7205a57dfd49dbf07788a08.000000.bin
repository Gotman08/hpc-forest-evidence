#include "knn.h"
#include <arm_neon.h>

// Max-heap node structure
typedef struct {
    float dist;
    char label;
} HeapNode;

static inline void heap_swap(HeapNode *a, HeapNode *b) {
    HeapNode t = *a; *a = *b; *b = t;
}

// Insert a single (dist,label) into the max-heap of size k.
static inline void heap_insert_or_replace(float d, char label,
                                          HeapNode *heap, int *heap_size_ptr, int k) {
    int heap_size = *heap_size_ptr;
    if (heap_size < k) {
        // Insert into heap
        heap_size++;
        int idx = heap_size;
        heap[idx].dist = d;
        heap[idx].label = label;
        while (idx > 1 && heap[idx/2].dist < heap[idx].dist) {
            heap_swap(&heap[idx], &heap[idx/2]);
            idx /= 2;
        }
    } else if (d < heap[1].dist) {
        // Replace root
        heap[1].dist = d;
        heap[1].label = label;
        int idx = 1;
        while (1) {
            int largest = idx;
            int left = 2 * idx;
            int right = 2 * idx + 1;
            if (left <= heap_size && heap[left].dist > heap[largest].dist)
                largest = left;
            if (right <= heap_size && heap[right].dist > heap[largest].dist)
                largest = right;
            if (largest != idx) {
                heap_swap(&heap[idx], &heap[largest]);
                idx = largest;
            } else break;
        }
    }
    *heap_size_ptr = heap_size;
}

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    // Allocate labels array (initialized with -1 sentinel)
    char *labels = (char *) malloc(sizeof(char) * k);
    for (int i = 0; i < k; i++) labels[i] = -1;

    // Max-heap of size k+1 (index 1..k)
    HeapNode *heap = (HeapNode *) malloc(sizeof(HeapNode) * (k + 1));
    int heap_size = 0;

    float px = to_evaluate.x;
    float py = to_evaluate.y;

    for (int i = 0; i < n_groups; i++) {
        Group g = groups[i];
        float * restrict xs = g.xs;
        float * restrict ys = g.ys;
        int len = g.length;
        char label = g.label;

        // Process points in batches of 16 using NEON SIMD (vld1q_f32_x4)
        int j = 0;
        for (; j + 15 < len; j += 16) {
            float32x4x4_t x_vec_quad = vld1q_f32_x4(xs + j);
            float32x4x4_t y_vec_quad = vld1q_f32_x4(ys + j);

            // Compute distances for 16 points (four vectors of four)
            float32x4_t dx0 = vsubq_f32(x_vec_quad.val[0], vdupq_n_f32(px));
            float32x4_t dy0 = vsubq_f32(y_vec_quad.val[0], vdupq_n_f32(py));
            float32x4_t dist_sq0 = vmlaq_f32(vmulq_f32(dx0, dx0), dy0, dy0);

            float32x4_t dx1 = vsubq_f32(x_vec_quad.val[1], vdupq_n_f32(px));
            float32x4_t dy1 = vsubq_f32(y_vec_quad.val[1], vdupq_n_f32(py));
            float32x4_t dist_sq1 = vmlaq_f32(vmulq_f32(dx1, dx1), dy1, dy1);

            float32x4_t dx2 = vsubq_f32(x_vec_quad.val[2], vdupq_n_f32(px));
            float32x4_t dy2 = vsubq_f32(y_vec_quad.val[2], vdupq_n_f32(py));
            float32x4_t dist_sq2 = vmlaq_f32(vmulq_f32(dx2, dx2), dy2, dy2);

            float32x4_t dx3 = vsubq_f32(x_vec_quad.val[3], vdupq_n_f32(px));
            float32x4_t dy3 = vsubq_f32(y_vec_quad.val[3], vdupq_n_f32(py));
            float32x4_t dist_sq3 = vmlaq_f32(vmulq_f32(dx3, dx3), dy3, dy3);

            float d0[4], d1[4], d2[4], d3[4];
            vst1q_f32(d0, dist_sq0);
            vst1q_f32(d1, dist_sq1);
            vst1q_f32(d2, dist_sq2);
            vst1q_f32(d3, dist_sq3);

            // Unrolled heap insertions for all 16 points
            heap_insert_or_replace(d0[0], label, heap, &heap_size, k);
            heap_insert_or_replace(d0[1], label, heap, &heap_size, k);
            heap_insert_or_replace(d0[2], label, heap, &heap_size, k);
            heap_insert_or_replace(d0[3], label, heap, &heap_size, k);

            heap_insert_or_replace(d1[0], label, heap, &heap_size, k);
            heap_insert_or_replace(d1[1], label, heap, &heap_size, k);
            heap_insert_or_replace(d1[2], label, heap, &heap_size, k);
            heap_insert_or_replace(d1[3], label, heap, &heap_size, k);

            heap_insert_or_replace(d2[0], label, heap, &heap_size, k);
            heap_insert_or_replace(d2[1], label, heap, &heap_size, k);
            heap_insert_or_replace(d2[2], label, heap, &heap_size, k);
            heap_insert_or_replace(d2[3], label, heap, &heap_size, k);

            heap_insert_or_replace(d3[0], label, heap, &heap_size, k);
            heap_insert_or_replace(d3[1], label, heap, &heap_size, k);
            heap_insert_or_replace(d3[2], label, heap, &heap_size, k);
            heap_insert_or_replace(d3[3], label, heap, &heap_size, k);
        }

        // Remainder scalar loop (handles 0..15 remaining points)
        for (; j < len; j++) {
            float dx = xs[j] - px;
            float dy = ys[j] - py;
            float d = dx*dx + dy*dy;
            heap_insert_or_replace(d, label, heap, &heap_size, k);
        }
    }

    // Copy labels from heap into labels array
    for (int i = 0; i < heap_size && i < k; i++) {
        labels[i] = heap[i+1].label;
    }

    free(heap);

    qsort(labels, k, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (int i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }
            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    free(labels);
    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

#include <iostream>
#include <vector>
#include <cstdio>
#include <climits>
#include <algorithm>

int main() {
	int n, s;
	std::cin >> n >> s;
	assert(s > 0 && s < n && n < 8000);

	// Flatten matrix into contiguous 1D array for spatial locality
	std::vector<int> mat(n * n);
	for (int i = 0; i < n; ++i)
		for (int j = 0; j < n; ++j)
			scanf("%d", &mat[i * n + j]);

	// Build integral image in one pass using row prefix accumulation,
	// eliminating intermediate H storage.
	std::vector<long long> II((n + 1) * (n + 1), 0);
	std::vector<long long> row_prefix(n + 1, 0); // reusable per-row buffer
	for (int i = 0; i < n; ++i) {
		row_prefix[0] = 0;
		for (int j = 1; j <= n; ++j)
			row_prefix[j] = row_prefix[j - 1] + mat[i * n + j - 1];

		long long* prev_row = &II[(i)     * (n + 1)];
		long long* curr_row = &II[(i + 1) * (n + 1)];
		curr_row[0] = 0;
		for (int j = 1; j <= n; ++j)
			curr_row[j] = prev_row[j] + row_prefix[j];
	}

	// Search for maximum SxS submatrix sum using integral image with OpenMP.
	long long mxSum = LLONG_MIN;
	#pragma omp parallel for collapse(2) reduction(max:mxSum)
	for (int i = 0; i <= n - s; ++i) {
		for (int j = 0; j <= n - s; ++j) {
			long long sum = II[(i + s) * (n + 1) + j + s]
			              - II[i * (n + 1) + j + s]
			              - II[(i + s) * (n + 1) + j]
			              + II[i * (n + 1) + j];
			if (sum > mxSum)
				mxSum = sum;
		}
	}

	printf("%d\n", static_cast<int>(mxSum));
	return 0;
}
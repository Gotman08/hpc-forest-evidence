[
  {
    "subject": "2020-tropical",
    "id": "f530f782e57e41f4",
    "role": "A",
    "parent_id": null,
    "delegation_parent": "R/A",
    "integration_sources": [],
    "hypothesis_as_declared_by_model": "A contiguous adjacency matrix plus generation-stamped exclusions removes repeated matrix copies and improves cache locality while preserving the deterministic spanning-tree and path-search order.",
    "transformations_as_declared_by_model": {
      "files": [
        "src/tropical.cpp"
      ],
      "retained": [
        "Flatten the graph and exclusion state into contiguous arrays, using an epoch stamp instead of copying a dense matrix for every constrained Prim call.",
        "Build each candidate tree once as CSR-style contiguous neighbor ranges, then backtrack with in-place path/color state rather than allocating neighbor and history vectors at every recursion."
      ]
    },
    "status": "valid",
    "mean_seconds": 0.007268936683734258,
    "commit": "e2196341b628b386b22aac4c70343617fcb5b208"
  },
  {
    "subject": "2020-tropical",
    "id": "c95e9eb93d944855",
    "role": "B",
    "parent_id": null,
    "delegation_parent": "R/B",
    "integration_sources": [],
    "hypothesis_as_declared_by_model": "The Prim minimum-key scan is repeated for every spanning-tree construction. Passing its vectors by const reference removes repeated full copies; replacing vector<bool> with byte flags permits a legal OpenMP-SIMD minimum reduction. A scalar first-match pass preserves the original lowest-index tie rule exactly.",
    "transformations_as_declared_by_model": {
      "files": [
        "src/tropical.cpp"
      ],
      "retained": [
        "Replace copying minimum-key arguments with const references.",
        "Use byte visitation flags and a two-pass SIMD minimum reduction followed by scalar stable tie selection."
      ]
    },
    "status": "valid",
    "mean_seconds": 0.006812985676030318,
    "commit": "eefdb0fb1a3ab26ecda4d1caeb891ebc217fed7a"
  },
  {
    "subject": "2020-tropical",
    "id": "3d19beada39b482e",
    "role": "C",
    "parent_id": null,
    "delegation_parent": "R/C",
    "integration_sources": [],
    "hypothesis_as_declared_by_model": "For large spanning-tree path searches, statically sharing independent root branches across the four OpenMP threads will improve throughput while a serial prefix and a 64-root threshold avoid OpenMP setup on latency-sensitive cases.",
    "transformations_as_declared_by_model": {
      "files": [
        "src/tropical.cpp"
      ],
      "retained": [
        "Replace mutation of global best-path state during DFS with per-root search results and deterministic serial reduction.",
        "Use OpenMP static work sharing for only the remaining large root set after a four-root serial probe; keep small searches serial.",
        "Pass immutable graph and vector inputs by const reference in the search and spanning-tree helpers to avoid copies."
      ]
    },
    "status": "valid",
    "mean_seconds": 0.006788577884435654,
    "commit": "36432f374799adaa1a567da405f80b2056eb7a51"
  },
  {
    "subject": "2020-tropical",
    "id": "8e09203252f549a1",
    "role": "A",
    "parent_id": null,
    "delegation_parent": "R/A",
    "integration_sources": [],
    "hypothesis_as_declared_by_model": "Flattening the adjacency matrix and replacing Prim's per-call cloned matrices and cycle-search work with a contiguous exclusion mask will reduce allocation, copy, and cache traffic while preserving its vertex and tie traversal order exactly.",
    "transformations_as_declared_by_model": {
      "files": [
        "src/tropical.cpp"
      ],
      "retained": [
        "Store graph adjacency in one contiguous row-major byte array.",
        "Pass immutable graph and edge collections by reference instead of repeatedly copying them.",
        "Replace cloned adjacency/cycle matrices and repeated BFS cycle checks in Prim with a compact contiguous exclusion mask."
      ]
    },
    "status": "valid",
    "mean_seconds": 0.006931018394728501,
    "commit": "4f720b44c613c1552b6d704d333aa2748e0d45a6"
  },
  {
    "subject": "2020-tropical",
    "id": "7081084918234697",
    "role": "B",
    "parent_id": "c95e9eb93d944855",
    "delegation_parent": "R/B",
    "integration_sources": [],
    "hypothesis_as_declared_by_model": "The candidate-edge cycle check is dependency-inert: every temporary edge goes from an already selected Prim vertex to an unselected vertex, while persisted edges are directed in selection order, so it cannot detect a cycle. Removing that repeated dense traversal and passing read-only graph/path state by reference should substantially reduce latency while retaining the existing legal SIMD minimum reduction and tie order.",
    "transformations_as_declared_by_model": {
      "files": [
        "src/tropical.cpp"
      ],
      "retained": [
        "Remove the redundant per-relaxation cycle matrix construction and traversal using the Prim selection-order acyclicity invariant.",
        "Pass read-only graph, edge-list, and path arguments by const reference to eliminate repeated dense adjacency-matrix copies.",
        "Use direct dense-matrix copy construction and bind the selected adjacency row locally for the relaxation loop."
      ]
    },
    "status": "valid",
    "mean_seconds": 0.006818369030952454,
    "commit": "4849303ed59001e1ff897de18d5413a39b118e91"
  },

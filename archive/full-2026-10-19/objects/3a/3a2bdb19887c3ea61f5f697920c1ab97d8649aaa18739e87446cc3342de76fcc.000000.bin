    "hypothesis_as_declared_by_model": "A compact first-ID hash index plus lazily cached selected successors and reverse path memoization removes repeated full-node scans and keeps repeatedly accessed values, successor links, and costs in dense arrays.",
    "transformations_as_declared_by_model": {
      "files": [
        "src/graph.c"
      ],
      "retained": [
        "Replace repeated linear ID searches with an open-addressed first-occurrence ID index.",
        "Cache each visited node's selected successor and compute uncached functional-DAG suffixes once in reverse path order using compact value and memo arrays."
      ]

  {
    "subject": "2020-quicksort",
    "id": "f270614ead87450a",
    "role": "A",
    "parent_id": null,
    "delegation_parent": "R/A",
    "integration_sources": [],
    "hypothesis_as_declared_by_model": "A stable, cache-buffered byte-radix sort replaces random partition accesses with sequential passes and contiguous output blocks, reducing sort time for large generated integer arrays.",
    "transformations_as_declared_by_model": {
      "files": [
        "src/quicksort.c"
      ],
      "retained": [
        "Replace recursive randomized quicksort with four stable blocked 8-bit radix passes, staging 16 integers per bucket before contiguous output writes."
      ]
    },
    "status": "valid",
    "mean_seconds": 0.020272692665457726,
    "commit": "f2e626e6aaef50d1fdb48c27d1cc9670ad84fcab"
  },
  {
    "subject": "2020-quicksort",
    "id": "0af660ffc8ff4cad",
    "role": "B",
    "parent_id": null,
    "delegation_parent": "R/B",
    "integration_sources": [],
    "hypothesis_as_declared_by_model": "A buffered three-pass LSD radix sort removes quicksort's branch-heavy partition dependency while preserving exact signed-int ascending order; the branch-free verification reduction also permits legal SIMD vectorization.",
    "transformations_as_declared_by_model": {
      "files": [
        "src/quicksort.c"
      ],
      "retained": [
        "Replace the normal sorting path with a stable 11/11/10-bit buffered radix pipeline using non-aliasing source and destination buffers.",
        "Express sortedness checking as a dependency-free OR reduction and mark only that read-only loop as safe for GCC vectorization."
      ]
    },
    "status": "valid",
    "mean_seconds": 0.017645341033736866,
    "commit": "174ea1398df4c0f90e7fe18acdeaf3cb675b86d3"
  },
  {
    "subject": "2020-quicksort",
    "id": "2c1dfcd77d064f9f",
    "role": "C",
    "parent_id": null,
    "delegation_parent": "R/C",
    "integration_sources": [],
    "hypothesis_as_declared_by_model": "A stable four-pass signed-integer radix sort eliminates comparison-heavy recursive quicksort work; for sufficiently large arrays, one persistent OpenMP team with deterministic contiguous chunks, per-thread histograms, and a single prefix reduction improves four-core throughput while preserving exact sorted bytes.",
    "transformations_as_declared_by_model": {
      "files": [
        "src/quicksort.c"
      ],
      "retained": [
        "Replace the primary comparison sort with stable LSD radix sorting over all unsigned-int bytes, using a sign-bit transform so the public sorter retains signed integer ordering.",
        "For large arrays under OpenMP, perform each radix pass in one persistent team: disjoint contiguous histogram/scatter ranges, cache-line-separated per-thread rows, and a deterministic single-thread prefix reduction.",
        "Retain low-overhead serial radix behavior for small arrays and portable non-OpenMP builds, with the original quicksort as an allocation-failure fallback."
      ]
    },
    "status": "valid",
    "mean_seconds": 0.015089851804077625,
    "commit": "e69f21dc0c8b5d37d5044a56f7142a658f75bebd"
  },
  {
    "subject": "2020-quicksort",
    "id": "82326eed0efc4e14",
    "role": "A",
    "parent_id": null,
    "delegation_parent": "R/A",
    "integration_sources": [],
    "hypothesis_as_declared_by_model": "A single OpenMP team performing stable byte-radix passes with thread-private histograms and contiguous per-thread input chunks will replace partition-induced random accesses with cache-local sequential scans and disjoint output ranges, improving large-array sorting throughput on four ARM cores.",
    "transformations_as_declared_by_model": {
      "files": [
        "src/quicksort.c"
      ],
      "retained": [
        "Replace recursive randomized partitioning with a signed-order stable byte-radix sort, and for sufficiently large arrays use per-thread private histograms plus computed disjoint scatter offsets inside one OpenMP parallel region."
      ]
    },
    "status": "valid",
    "mean_seconds": 0.015273338804642359,
    "commit": "dadee6cc3f3d66d2c4c036b5ef0254841fc8492b"
  },
  {
    "subject": "2020-quicksort",
    "id": "f657d30eab5b4bdf",
    "role": "B",
    "parent_id": "0af660ffc8ff4cad",
    "delegation_parent": "R/B",
    "integration_sources": [],
    "hypothesis_as_declared_by_model": "On the ARM64 target, explicitly comparing four adjacent signed-int pairs at once in the sortedness check removes the scalar loop-carried reduction from the hot verification scan while preserving its exact nonzero/zero result; scalar fallback and tail handling retain portability and all lengths.",
    "transformations_as_declared_by_model": {
      "files": [
        "src/quicksort.c"
      ],
      "retained": [
        "Add a guarded ARM64 NEON implementation of is_sorted that performs overlapping four-int signed comparisons and OR-reduces violation masks.",
        "Keep a scalar, compiler-vectorizable tail loop for all remaining elements and non-ARM targets."
      ]
    },
    "status": "valid",
    "mean_seconds": 0.017454082146286964,
    "commit": "fb1b5e9205f4ae86e9ffe0fa32bd9edf5f636752"
  },
  {
    "subject": "2020-quicksort",
    "id": "b3bebcd036924af2",
    "role": "C",
    "parent_id": null,
    "delegation_parent": "R/C",
    "integration_sources": [],
    "hypothesis_as_declared_by_model": "Replacing the failure-prone 16-bit two-pass scatter with a persistent-team four-pass 8-bit radix sort keeps per-thread histograms cache-resident and bounds scatter fan-out, reducing synchronization and cache-miss cost on four cores while retaining a sequential fallback for small arrays.",
    "transformations_as_declared_by_model": {
      "files": [
        "src/quicksort.c"
      ],
      "retained": [
        "Replace the 16-bit histogram/scatter implementation with a four-pass 8-bit signed radix sort.",
        "Retain one OpenMP team across all passes, with deterministic static contiguous work ranges and a single-thread prefix reduction per pass.",
        "Use size_t for histogram counts and output offsets to avoid index-width overflow."
      ]
    },
    "status": "valid",
    "mean_seconds": 0.017804807052016258,
    "commit": "bd8d5961e466ef08b7d171fab71202d0bb63a784"
  },

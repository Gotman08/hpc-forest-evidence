/*
  Quicksort
*/
#include <stdio.h>
#include <stdlib.h>
#include <limits.h>
#include <openssl/md5.h>

/*
 * Prototypes
 */
void srandnum(int seed);
double randnum(void);
int *generate_case(int N);
double drand(int xmin, int xmax);
void swap(int *toorder, int i, int j);
void _quicksort(int *toorder, int lo, int hi);
void quicksort(int *toorder, int N);
int is_sorted(int *toorder, int N);
static int median_of_three(int *toorder, int lo, int hi);
static void partition_three_way(int *toorder, int lo, int hi, int *lt, int *gt);
static void insertion_sort(int *toorder, int lo, int hi);
#ifdef _OPENMP
static void _quicksort_parallel(int *toorder, int lo, int hi, int depth);
#endif

#define INSERTION_SORT_CUTOFF 24
#define PARALLEL_TASK_CUTOFF 32768

/*
 * A generic pRNG
 */
#define MY_RAND_MAX 0x7FFFFFFF

#define RANDNUM_W 521288629
#define RANDNUM_Z 362436069

unsigned int randum_w = RANDNUM_W;
unsigned int randum_z = RANDNUM_Z;

void srandnum(int seed)
{
    unsigned int w, z;
    w = (seed * 104623) & 0xffffffff;
    randum_w = (w) ? w : RANDNUM_W;
    z = (seed * 48947) & 0xffffffff;
    randum_z = (z) ? z : RANDNUM_Z;
}

double randnum(void)
{
    unsigned int u;
    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);
    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);
    u = (randum_z << 16) + randum_w;
    return (abs(u));
}

/*
 * Main function
 */
int main(int argc, char *argv[])
{
    int N = 0;
    int *our_list = NULL;

    //The input provides the case size
    scanf("%d", &N);
    if (N <= 0) {
        printf("Error: please, provide the case size.\n");
        return 1;
    }

    //Generate the case
    our_list = generate_case(N);
    if (our_list == NULL) {
        printf("Error: case instantiation failed.\n");
        return 1;
    }

    //Do the thing
    quicksort(our_list, N);

    if (is_sorted(our_list, N) == 1) {
        printf("Error, for some reason list is still unsorted.\n");
        return 1;
    }

#ifdef COMPUTE_MD5_PROBLEM
    //Compute MD5 Checksum for problem identification
    MD5_CTX c;
    unsigned char out[MD5_DIGEST_LENGTH];
    MD5_Init(&c);
    MD5_Update(&c, our_list, N * sizeof(int));
    MD5_Final(out, &c);
    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {
        printf("%02x", out[n]);
    }
#endif
    printf("\n");

    //Clean up
    free(our_list);

    return 0;
}

/*
 * Public API
 */
void quicksort(int *toorder, int N)
{
#ifdef _OPENMP
    if (N > PARALLEL_TASK_CUTOFF) {
        int depth_limit = 0;
        for (int size = N; size > 1; size >>= 1) {
            depth_limit += 2;
        }
#pragma omp parallel
        {
#pragma omp single
            {
                _quicksort_parallel(toorder, 0, N - 1, depth_limit);
            }
        }
        return;
    }
#endif
    _quicksort(toorder, 0, N - 1);
}

/*
 * Internal serial quicksort. Recursing on the smaller partition bounds stack use,
 * while the larger partition is handled by the loop.
 */
void _quicksort(int *toorder, int lo, int hi)
{
    while (lo < hi) {
        if (hi - lo + 1 <= INSERTION_SORT_CUTOFF) {
            insertion_sort(toorder, lo, hi);
            return;
        }

        int lt, gt;
        partition_three_way(toorder, lo, hi, &lt, &gt);
        int left_size = lt - lo;
        int right_size = hi - gt;
        if (left_size < right_size) {
            _quicksort(toorder, lo, lt - 1);
            lo = gt + 1;
        } else {
            _quicksort(toorder, gt + 1, hi);
            hi = lt - 1;
        }
    }
}

#ifdef _OPENMP
/*
 * Parallel quicksort tasks operate on disjoint, contiguous partitions. Small
 * ranges and deep paths use the serial implementation to limit task overhead.
 */
static void _quicksort_parallel(int *toorder, int lo, int hi, int depth)
{
    while (lo < hi) {
        int size = hi - lo + 1;
        if (size <= PARALLEL_TASK_CUTOFF || depth <= 1) {
            _quicksort(toorder, lo, hi);
            return;
        }

        int lt, gt;
        partition_three_way(toorder, lo, hi, &lt, &gt);
        int left_size = lt - lo;
        int right_size = hi - gt;
        if (left_size < PARALLEL_TASK_CUTOFF &&
            right_size < PARALLEL_TASK_CUTOFF) {
            _quicksort(toorder, lo, lt - 1);
            _quicksort(toorder, gt + 1, hi);
            return;
        }

        int next_depth = depth - 1;
        if (left_size >= right_size) {
            int task_lo = lo;
            int task_hi = lt - 1;
            if (task_lo <= task_hi) {
#pragma omp task default(none) firstprivate(toorder, task_lo, task_hi, next_depth)
                {
                    _quicksort_parallel(toorder, task_lo, task_hi, next_depth);
                }
            }
            lo = gt + 1;
        } else {
            int task_lo = gt + 1;
            int task_hi = hi;
            if (task_lo <= task_hi) {
#pragma omp task default(none) firstprivate(toorder, task_lo, task_hi, next_depth)
                {
                    _quicksort_parallel(toorder, task_lo, task_hi, next_depth);
                }
            }
            hi = lt - 1;
        }
        depth = next_depth;
    }
}
#endif

/*
 * Choose a local pivot without using shared PRNG state.
 */
static int median_of_three(int *toorder, int lo, int hi)
{
    int a = toorder[lo];
    int b = toorder[lo + (hi - lo) / 2];
    int c = toorder[hi];

    if (a < b) {
        if (b < c) {
            return b;
        }
        return (a < c) ? c : a;
    }
    if (a < c) {
        return a;
    }
    return (b < c) ? c : b;
}

/*
 * Partition a range into values below, equal to, and above the pivot.
 */
static void partition_three_way(int *toorder, int lo, int hi, int *lt, int *gt)
{
    int pivot = median_of_three(toorder, lo, hi);
    int lower = lo;
    int current = lo;
    int upper = hi;

    while (current <= upper) {
        if (toorder[current] < pivot) {
            swap(toorder, current, lower);
            lower++;
            current++;
        } else if (toorder[current] > pivot) {
            swap(toorder, current, upper);
            upper--;
        } else {
            current++;
        }
    }

    *lt = lower;
    *gt = upper;
}

/*
 * Sort a small contiguous range in place.
 */
static void insertion_sort(int *toorder, int lo, int hi)
{
    for (int i = lo + 1; i <= hi; i++) {
        int value = toorder[i];
        int j = i;
        while (j > lo && toorder[j - 1] > value) {
            toorder[j] = toorder[j - 1];
            j--;
        }
        toorder[j] = value;
    }
}

/*
 * Swap two values.
 */
void swap(int *toorder, int i, int j)
{
    int temp = toorder[i];
    toorder[i] = toorder[j];
    toorder[j] = temp;
}

/*
 * Check if elements are in non-decreasing order
 */
int is_sorted(int *toorder, int N)
{
    for (int i = 1; i < N; i++) {
        if (toorder[i] < toorder[i - 1]) {
            return 1;
        }
    }
    return 0;
}

/*
 * Generate a case
 */
int *generate_case(int N)
{
    int i;
    int *ret = NULL;

    // Make case generation reproducible
    srandnum(0);

    // Allocate memory
    ret = (int *) malloc(N * sizeof(int));
    if (ret == NULL) {
        printf("Error: some malloc won't work.\n");
        return NULL;
    }
    // Get pseudo-random positive integer values
    for (i = 0; i < N; i++) {
        ret[i] = drand(0, INT_MAX);
    }
    return ret;
}

/*
 * A pseudo-random number between two positive integer values
 */
double drand(int xmin, int xmax)
{
    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;
}

 $stateTime=[DateTimeOffset]::FromUnixTimeMilliseconds([long]($coldState.updated_at*1000)).UtcDateTime
 if([DateTime]::UtcNow -ge $deadline -or ([DateTime]::UtcNow-$stateTime).TotalSeconds -lt 0 -or ([DateTime]::UtcNow-$stateTime).TotalSeconds -gt 90){throw 'Current cold state90/startup120 boundary expired; no date rewrite'}
 $receiverInput=[ordered]@{schema='hpc-forest-r8-actual-observer-startup-cold-input-v1';start_intent=(Ref $intent);start_observed=(Ref $observedPath);startup_census_before=(Ref (Join-Path $run 'CIM-PRIVE-AVANT-PREPARATION.json'));startup_census_after=(Ref (Join-Path $run 'CIM-PRIVE-APRES.json'));policy=(Ref (Join-Path $policy 'POLICY-OBS4.json'));routes_initial_copy=(Ref (Join-Path $copies 'ROUTES-INITIALES-COPIE-FROIDE.json'));routes_initial_copy_receipt=(Ref (Join-Path $copies 'RECU-COPIE-ROUTES-INITIALES.json'));transition=(Ref (Join-Path $absence 'TRANSITION-OBS3-OBS4.json'));source_only_absence=(Ref (Join-Path $absence 'ABSENCE-source-only.json'));observer3_absence=(Ref (Join-Path $absence 'ABSENCE-observer3.json'));prior_observer_current_absence=(Ref (Join-Path $run 'ABSENCE-OBS4-R5-ET-R7-IMMEDIATE.json'));cold_state=(Ref (Join-Path $copies 'ETAT-PASSIF-COPIE-FROIDE.json'));cold_state_receipt=(Ref (Join-Path $copies 'RECU-COPIE-ETAT-PASSIF.json'));cold_logs_receipt=(Ref (Join-Path $copies 'RECU-DEUX-LOGS-COPIES-FROIDES.json'));external_preparation_review=(Ref $aliasReview)}

Save-New $orchestrationIntent ([ordered]@{schema='hpc-forest-r8-direct-passive-orchestration-intent-v1';created_at_utc=[DateTime]::UtcNow.ToString('o');cold_input=$inputRef;orchestration_review=$reviewRef;archive_cim=(Ref $ArchiveCim);one_attempt_only=$true;unknown_forbids_retry=$true;native_or_job_submission_permitted=$false})
try{
 $stage='cold-exact4-review-alias'
 $originalSha=Sha $cold.passive_four_review.path
 $reviewBytes=[IO.File]::ReadAllBytes($cold.passive_four_review.path)
 if($originalSha -cne $cold.passive_four_review.sha256 -or ([Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($reviewBytes)).ToLowerInvariant()) -cne $originalSha){throw 'Exact4 review changed before cold alias'}
 Missing $aliasReview;$stream=[IO.File]::Open($aliasReview,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None)
 try{$stream.Write($reviewBytes,0,$reviewBytes.Length);$stream.Flush($true)}finally{$stream.Dispose()}
 if((Sha $aliasReview) -cne $originalSha -or (Sha $cold.passive_four_review.path) -cne $originalSha){throw 'Cold exact4 review alias differs'}
 Save-New $aliasReceipt ([ordered]@{schema='hpc-forest-r8-cold-review-byte-exact-alias-v1';source=$cold.passive_four_review;received=(Ref $aliasReview);two_hashes_and_bytes_equal=$true;copied_before_startup_T0=$true;no_runtime_file_read=$true})
 Native-Step 'historical-R5-R7-current-absence-before-archive' (Join-Path $obs 'verifier-absence-ancien-OBS4-R8.py') @('--full-cim',$ArchiveCim,'--full-cim-sha256',$ArchiveCimSha256,'--old-observer-review',(Join-Path $op 'fermeture-observateur-r5-preparee-r1\revue-fermeture-reelle-r3-r1\REVUE-FERMETURE-OBS4-REELLE-R3.json'),'--old-observer-review-sha256','7d2ba9c37b3a811d59039073608ff95f95c12473fa3156f60e79afe85c9a0a66','--output',$preArchiveLegacyProof)
 $cycleArguments=@('--mode','archive','--closure',$cold.closure.path,'--closure-sha256',$cold.closure.sha256,'--closure-review',$cold.closure_review.path,'--closure-review-sha256',$cold.closure_review.sha256,'--previous-sequence-terminal',$cold.terminal.path,'--previous-sequence-terminal-sha256',$cold.terminal.sha256,'--full-cim',$ArchiveCim,'--full-cim-sha256',$ArchiveCimSha256,'--helper-review',$cold.lifecycle_review.path,'--helper-review-sha256',$cold.lifecycle_review.sha256,'--neutral-completion',$cold.lifecycle_tests.path,'--neutral-completion-sha256',$cold.lifecycle_tests.sha256,'--output',$archiveDir)
 Native-Step 'archive-postclosure-runtime' (Join-Path $code 'cycle-passif-externe-R8.py') $cycleArguments
 $archiveValue=Read-Ref (Ref $archiveReceipt)
 if($archiveValue.schema -cne 'hpc-forest-r8-owned-passive-runtime-archive-v1' -or $archiveValue.verified_archived_runtime_only -ne $true){throw 'No actual successful runtime archive'}
 Save-New $lifecycleFile ([ordered]@{schema='hpc-forest-r8-new-external-passive-lifecycle-actual-input-v1';closure=$cold.closure;closure_review=$cold.closure_review;archive=(Ref $archiveReceipt);previous_sequence_terminal=$cold.terminal;helper_review=$cold.lifecycle_review;neutral_completion=$cold.lifecycle_tests})
 $startArguments=@{PreparationReview=$aliasReview;PreparationReviewSha256=(Sha $aliasReview);QualificationReception=$cold.qualification.path;QualificationReceptionSha256=$cold.qualification.sha256;LifecycleInput=$lifecycleFile;LifecycleInputSha256=(Sha $lifecycleFile);RunName='execution-root-02';Execute=$true}
 $stage='direct-same-host-passive-start'
 # CRITICAL: same ROOT PowerShell host, named hashtable; never &pwsh -File.
 & (Join-Path $code 'lancer-observateur-R8-r2.ps1') @startArguments
 $directSucceeded=$?
 if(-not $directSucceeded){throw 'Direct PS preparation failed; preserve UNKNOWN and never retry'}
 $observedPath=Join-Path $run 'LANCEMENT-OBSERVE.json';$observed=Read-Ref (Ref $observedPath)
 $initial=Read-Ref (Ref (Join-Path $run 'CIM-PRIVE-AVANT-PREPARATION.json'))
 $immediate=Read-Ref (Ref (Join-Path $run 'CIM-PRIVE-IMMEDIAT-AVANT-START.json'))
 $after=Read-Ref (Ref (Join-Path $run 'CIM-PRIVE-APRES.json'))
 $deadline=@([DateTimeOffset]::Parse($initial.captured_at_utc).UtcDateTime.AddSeconds(120),[DateTimeOffset]::Parse($immediate.captured_at_utc).UtcDateTime.AddSeconds(120),[DateTimeOffset]::Parse($after.captured_at_utc).UtcDateTime.AddSeconds(120),[DateTimeOffset]::Parse($observed.observed_at_utc).UtcDateTime.AddSeconds(120))|Sort-Object|Select-Object -First 1
 $stage='wait-bounded-state-metadata-only'

function Ordinary([string]$path){
 if(-not [IO.Path]::IsPathFullyQualified($path) -or $path.StartsWith('\\') -or $path -match '(^|[\\/])\.\.([\\/]|$)'){throw 'Exact absolute non-UNC path required'}
 $full=[IO.Path]::GetFullPath($path)
 if($full -cne $path -or $full.Substring(3).Contains(':')){throw 'Canonical path without ADS required'}
 foreach($part in $full.Substring(3).Split('\')){if($part -cne $part.TrimEnd([char[]]' .')){throw 'Trailing Windows alias refused'}}
 $part=$full
 while($part){
  try{$attrs=[IO.File]::GetAttributes($part);if(($attrs -band [IO.FileAttributes]::ReparsePoint) -ne 0){throw 'Reparse entry or parent refused'}}catch{
   $errorObject=$_.Exception;while($null -ne $errorObject.InnerException){$errorObject=$errorObject.InnerException}
   if($errorObject -isnot [IO.FileNotFoundException] -and $errorObject -isnot [IO.DirectoryNotFoundException]){throw}
  }
  $parent=[IO.Path]::GetDirectoryName($part);if($parent -eq $part){break};$part=$parent
 }
 return $full
}
function Missing([string]$path){
 Ordinary $path|Out-Null
 try{[IO.File]::GetAttributes($path)|Out-Null}catch{
  $errorObject=$_.Exception;while($null -ne $errorObject.InnerException){$errorObject=$errorObject.InnerException}
  if($errorObject -is [IO.FileNotFoundException] -or $errorObject -is [IO.DirectoryNotFoundException]){return};throw
 }
 throw 'Existing destination, including a dangling alias, is never reused'
}
function Sha([string]$path){Ordinary $path|Out-Null;return (Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash.ToLowerInvariant()}
function Ref([string]$path){return [ordered]@{path=$path;sha256=(Sha $path)}}
function Read-Ref($reference){
 if($null -eq $reference -or ((@($reference.PSObject.Properties.Name|Sort-Object)) -join '|') -cne 'path|sha256' -or $reference.sha256 -cnotmatch '^[0-9a-f]{64}$'){throw 'Missing/malformed actual cold reference'}
 if((Sha $reference.path) -cne $reference.sha256){throw 'Actual cold reference changed'}
 $bytes=[IO.File]::ReadAllBytes($reference.path)
 if(([Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($bytes)).ToLowerInvariant()) -cne $reference.sha256){throw 'Cold bytes changed before decode'}
 return ($utf8.GetString($bytes)|ConvertFrom-Json -Depth 60)
}
function Save-New([string]$path,$value){
 Missing $path
 $bytes=$utf8.GetBytes(($value|ConvertTo-Json -Depth 60))
 $stream=[IO.File]::Open($path,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None)
 try{$stream.Write($bytes,0,$bytes.Length);$stream.Flush($true)}finally{$stream.Dispose()}
}
function Native-Step([string]$name,[string]$script,[object[]]$arguments){
 $script:stage=$name
 & $metaPython -I -B $script @arguments
 $nativeExit=$LASTEXITCODE
 if($nativeExit -ne 0){throw ('Qualified helper refused at '+$name+'; preserve its outputs, no retry')}
}
function Check-Review($value,[string]$schema,$expected){
 if($value.schema -cne $schema -or $value.verified_source_preparation_only -ne $true -or $null -eq $value.blocking_findings -or @($value.blocking_findings).Count -ne 0 -or $value.native_generation_admitted -ne $false){throw 'Missing actual independent source review'}
 $actualNames=@($value.reviewed_files.PSObject.Properties.Name|Sort-Object)
 if(($actualNames -join '|') -cne (($expected.Keys|Sort-Object) -join '|')){throw 'Review has the wrong exact file set'}
 foreach($name in $expected.Keys){if($value.reviewed_files.$name -cne $expected[$name]){throw 'Review code/test pin changed'}}
}
function Check-Tests($value,[string]$schema,[int]$count,[string]$codeKey,[string]$codeSha,[string]$testKey,[string]$testSha){
 if($value.schema -cne $schema -or $value.$codeKey -cne $codeSha -or $value.$testKey -cne $testSha -or $value.tests_run -isnot [long] -and $value.tests_run -isnot [int] -or $value.tests_run -ne $count){throw 'Actual new ROOT neutral completion required'}
 foreach($name in @('exit_code','failures','errors','skipped')){if(($value.$name -isnot [int] -and $value.$name -isnot [long]) -or $value.$name -ne 0){throw 'A neutral failure/error/skip forbids effects'}}
}

if($PSScriptRoot -cne $own){throw 'Exact owned orchestration source directory required'}
$reviewRef=[pscustomobject]@{path=$OrchestrationReview;sha256=$OrchestrationReviewSha256}
$ownReview=Read-Ref $reviewRef

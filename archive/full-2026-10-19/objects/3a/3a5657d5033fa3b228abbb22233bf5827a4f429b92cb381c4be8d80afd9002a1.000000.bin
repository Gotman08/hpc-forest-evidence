if($documents.lifecycle_tests.live_runtime_read_or_changed -ne $false -or $documents.copier_tests.copy_main_executed -ne $false -or $documents.copier_tests.live_source_payload_read -ne $false -or $documents.receiver_tests.receiver_main_executed -ne $false -or $documents.receiver_tests.fixture_results_are_live_observation -ne $false){throw 'Neutral results never authorize a fabricated live observation'}
if($documents.copier_tests.source62_before_after_equal -ne $true -or $documents.copier_tests.helper_and_test_before_after_equal -ne $true -or $documents.receiver_tests.source_observer_before_after_equal -ne $true -or $documents.receiver_tests.receiver_and_test_before_after_equal -ne $true){throw 'Actual neutral before/after preservation flags required before every effect'}
foreach($name in @('copier_review','receiver_review')){if(-not $cold.$name.path.StartsWith((Join-Path $code 'revue-preparation-independante-r1')+'\',[StringComparison]::OrdinalIgnoreCase)){throw 'Consumer preparation review lies outside its literal accepted CODE boundary'}}

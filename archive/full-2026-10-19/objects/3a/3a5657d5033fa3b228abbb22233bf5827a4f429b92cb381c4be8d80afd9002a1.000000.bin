$components=Read-Ref (Ref (Join-Path $chain 'COMPONENTS.json'))
if(@($components.code_pins.PSObject.Properties).Count -ne 62){throw 'Exactly62 immutable components required'}
foreach($item in $components.code_pins.PSObject.Properties){if($item.Name -match '(^|/)\.\.(/|$)' -or (Sha (Join-Path $chain $item.Name)) -cne $item.Value){throw 'A frozen component changed'}}
if((Sha (Join-Path $obs 'verifier-absence-ancien-OBS4-R8.py')) -cne '6483d35f9dd928f1a4c1451cca88b0a87355138c4b144c992c89274393369139'){throw 'Historical closure/current absence helper changed'}
foreach($path in @($execution,$orchestrationIntent,$archiveDir,$intent,$run,$absence,$policy,$copies,$pairOut,$aliasReview,$aliasReceipt,$lifecycleFile,$copyInputFile,$pairInputFile,$preArchiveLegacyProof,(Join-Path $code 'INTENTION-UNIQUE-ARCHIVE-RUNTIME-REPRISE-02.json'))){Missing $path}
# Bound inputs/outputs are assembled as paths now; no future SHA or observation is invented.
$r5=Join-Path $live 'reception-paire-dynamique-r1\revision-r5-snapshots-passifs-sources'
$legacyRefs=@{
 receiver_code=[ordered]@{path=(Join-Path $r5 'recevoir-paire-observateur-R8-froide-r5.py');sha256='16ce4d969be705e2ec1192331d094a45473c4f165faa7f92ac05ea665ce90eb8'}

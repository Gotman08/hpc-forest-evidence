 receiver_neutral_completion=[ordered]@{path=(Join-Path $r5 'TESTS-NEUTRES-ROOT-01.json');sha256='0dd4a7c930e31424f5b00ae118c696841323308d3015ed87b6b0cf708f40f8af'}
}
foreach($reference in $legacyRefs.Values){if((Sha $reference.path) -cne $reference.sha256){throw 'Frozen R5 ancestry changed; no new pair promoted from it'}}

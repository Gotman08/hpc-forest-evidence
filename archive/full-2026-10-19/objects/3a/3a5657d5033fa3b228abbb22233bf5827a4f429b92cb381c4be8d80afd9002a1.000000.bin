$bindings=$documents.approved_bindings
if($bindings.schema -cne 'hpc-forest-r8-passive-orchestration-received-r3-source-bindings-v1' -or $bindings.code_directory -cne $code -or $bindings.source_pins_are_actual_prepared_bytes -ne $true -or $bindings.neutral_completion_claimed -ne $false -or $bindings.native_generation_admitted -ne $false){throw 'Actual canonical R3 source pins required; neutral qualification is separately checked, null refuses'}
$sourceNames=@('cycle-passif-externe-R8.py','lancer-observateur-R8-r2.ps1','copier-quatre-sources-reprise-R8-parent.py','recevoir-paire-observateur-R8-reprise-02.py','test_cycle_passif_externe_R8.py','test_copie_quatre_sources_reprise_R8_neutre.py','test_reception_paire_R8_reprise_02.py')
if(((@($bindings.code_pins.PSObject.Properties.Name|Sort-Object)) -join '|') -cne (($sourceNames|Sort-Object) -join '|')){throw 'Exact seven reviewed R3 source pins required'}

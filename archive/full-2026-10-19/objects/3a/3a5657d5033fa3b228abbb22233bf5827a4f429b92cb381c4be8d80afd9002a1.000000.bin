 while($true){
  if([DateTime]::UtcNow -ge $deadline){throw 'Original startup120 expired; never refresh, rebase or retry'}
  Ordinary $statePath|Out-Null
  try{$attrs=[IO.File]::GetAttributes($statePath);if(($attrs -band [IO.FileAttributes]::Directory) -ne 0){throw 'State is not an ordinary file'};break}catch{
   $errorObject=$_.Exception;while($null -ne $errorObject.InnerException){$errorObject=$errorObject.InnerException}
   if($errorObject -isnot [IO.FileNotFoundException] -and $errorObject -isnot [IO.DirectoryNotFoundException]){throw}
  }
  Start-Sleep -Milliseconds 100
 }
 $copyInput=[ordered]@{schema='hpc-forest-r8-ROOT-four-cold-copies-actual-input-v1';start_intent=(Ref $intent);start_observed=(Ref $observedPath);receiver_code=$legacyRefs.receiver_code;receiver_review=$legacyRefs.receiver_review;receiver_neutral_completion=$legacyRefs.receiver_neutral_completion;resumed_receiver_code=[ordered]@{path=(Join-Path $code 'recevoir-paire-observateur-R8-reprise-02.py');sha256=$pins['recevoir-paire-observateur-R8-reprise-02.py']};resumed_receiver_review=$cold.receiver_review;resumed_receiver_neutral_completion=$cold.receiver_tests}
 Save-New $copyInputFile $copyInput

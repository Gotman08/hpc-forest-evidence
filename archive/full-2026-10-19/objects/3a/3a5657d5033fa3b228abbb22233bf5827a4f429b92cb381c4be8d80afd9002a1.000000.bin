if($pins['cycle-passif-externe-R8.py'] -ceq 'd2400f7a3dbbbb63b86739b3b35745ae4f9f68ffdb9f932945228573edd459c5'){throw 'Known failed R2 archive17pass/2error is never admitted'}
if($bindings.neutral_counts.lifecycle -ne 22 -or $bindings.neutral_counts.copier -ne 26 -or $bindings.neutral_counts.receiver -ne 47){throw 'Exact R3 22/26/47 actual qualifications required; a changed source contract needs new review'}
foreach($name in $pins.Keys){if((Sha (Join-Path $code $name)) -cne $pins[$name]){throw 'Qualified R3 code/test changed'}}
if((Sha $metaPython) -cne '5ef72c30ca3b82df7c7e186c9220bde665be9a335edbd4a371a4b19d0ac76644' -or (Sha $launcher) -cne '819c07dbf55c179f77a71d6f041c74c57b18d86f637f5f5e76ea882a50c9ed8b'){throw 'Qualified metadata Python/launcher changed'}
if($cold.closure.sha256 -cne 'c91d5d5ea1115b4c152211bc3d89565dad668be50214229f82f53b58b17dabb7' -or $cold.closure_review.sha256 -cne '14fbbae32ff2a629e3beab60d03d9671df1e1f2d4f7d034908e78d2ae5e5818f' -or $cold.terminal.sha256 -cne 'eafc12c79c2bf4f8da22a8a0ec0f81a4a49889e8d47b590f902289a7eab728ab' -or $cold.terminal_cold_review.sha256 -cne 'c667b2e63257fe27af1990c21f410db24a54fb48d5d36d33a61ef2011e590b50'){throw 'Only the actually received closure/terminal branch is prepared'}
if($cold.qualification.sha256 -cne '234a4ad3b058167c42190c5721985424ca8223de0e52d1a74c83a002247ff9e1' -or $cold.qualification_consumer.sha256 -cne 'b4fe3624b7ac32373133484de01348b30c2567267f289a8bd2bb87c8f99aef6d'){throw 'Actual R8 Q and consumer only'}
Check-Review $documents.lifecycle_review 'hpc-forest-r8-external-passive-lifecycle-preparation-review-v1' @{ 'cycle-passif-externe-R8.py'=$pins['cycle-passif-externe-R8.py'];'test_cycle_passif_externe_R8.py'=$pins['test_cycle_passif_externe_R8.py'] }
Check-Review $documents.copier_review 'hpc-forest-r8-startup-four-cold-copy-independent-preparation-review-v1' @{ 'copier-quatre-sources-reprise-R8-parent.py'=$pins['copier-quatre-sources-reprise-R8-parent.py'];'test_copie_quatre_sources_reprise_R8_neutre.py'=$pins['test_copie_quatre_sources_reprise_R8_neutre.py'] }
Check-Review $documents.receiver_review 'hpc-forest-r8-dynamic-pair-receiver-independent-preparation-review-v1' @{ 'recevoir-paire-observateur-R8-reprise-02.py'=$pins['recevoir-paire-observateur-R8-reprise-02.py'];'test_reception_paire_R8_reprise_02.py'=$pins['test_reception_paire_R8_reprise_02.py'] }

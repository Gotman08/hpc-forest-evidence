        "content": "#include <iostream>\n#include <vector>\n#include <utility>\n#include <cstdint>\n\nusing namespace std;\n\nstruct VertexMask {\n    uint64_t low;\n    uint64_t high;\n\n    VertexMask(uint64_t l = 0, uint64_t h = 0) : low(l), high(h) {}\n\n    bool contains(int vertex) const {\n        if (vertex < 64)\n            return (low & (uint64_t(1) << vertex)) != 0;\n        return (high & (uint64_t(1) << (vertex - 64))) != 0;\n    }\n\n    void add(int vertex) {\n        if (vertex < 64)\n            low |= uint64_t(1) << vertex;\n        else\n            high |= uint64_t(1) << (vertex - 64);\n    }\n\n    void remove(int vertex) {\n        if (vertex < 64)\n            low &= ~(uint64_t(1) << vertex);\n        else\n            high &= ~(uint64_t(1) << (vertex - 64));\n    }\n};\n\nstruct adjacency_matrix {\n    vector<VertexMask> rows;\n    vector<int> degree;\n\n    explicit adjacency_matrix(int vertices = 0)\n        : rows(vertices), degree(vertices, 0) {}\n\n    size_t size() const { return rows.size(); }\n};\n\ninline void printPermutation(const vector<int> &equivalence) {\n    for (int vertex : equivalence)\n        cout << vertex << \" \";\n    cout << endl;\n}\n\nadjacency_matrix readGraph() {\n    int vertices, edges, source, destination;\n    cin >> vertices;\n    adjacency_matrix graph(vertices);\n    cin >> edges;\n    for (int i = 0; i < edges; ++i) {\n        cin >> source >> destination;\n        if (!graph.rows[source].contains(destination)) {\n            graph.rows[source].add(destination);\n            graph.rows[destination].add(source);\n            ++graph.degree[source];\n            if (source != destination)\n                ++graph.degree[destination];\n        }\n    }\n    return graph;\n}\n\nclass HeapDomainSearch {\n    const adjacency_matrix &g1_;\n    const adjacency_matrix &g2_;\n    int n_;\n    vector<int> equivalence_;\n    vector<VertexMask> domains_;\n    vector<unsigned char> endpoints_;\n    vector<int> scratch_;\n    bool found_;\n\n    static int vertexClass(const adjacency_matrix &graph, int vertex) {\n        return 2 * graph.degree[vertex]\n            + (graph.rows[vertex].contains(vertex) ? 1 : 0);\n    }\n\n    void buildEndpoints() {\n        vector<int> state(n_);\n        for (int k = 1; k < n_; ++k) {\n            for (int i = 0; i < k; ++i)\n                state[i] = i;\n\n            // Compose exactly k child traversals, without a trailing swap.\n            for (int block = 0; block < k; ++block) {\n                if (block != 0)\n                    swap(state[(k % 2 == 0) ? block - 1 : 0], state[k - 1]);\n                for (int i = 0; i < k - 1; ++i)\n                    scratch_[i] = state[endpoints_[(k - 1) * n_ + i]];\n                for (int i = 0; i < k - 1; ++i)\n                    state[i] = scratch_[i];\n            }\n            for (int i = 0; i < k; ++i)\n                endpoints_[k * n_ + i] = static_cast<unsigned char>(state[i]);\n        }\n    }\n\n    void advancePrefix(int k) {\n        if (k <= 1)\n            return;\n        for (int i = 0; i < k; ++i)\n            scratch_[i] = equivalence_[endpoints_[k * n_ + i]];\n        for (int i = 0; i < k; ++i)\n            equivalence_[i] = scratch_[i];\n    }\n\n    void enumerate(int k, VertexMask available) {\n        const int last = k - 1;\n        const VertexMask *parent = domains_.data() + static_cast<size_t>(k) * n_;\n        VertexMask *child = domains_.data() + static_cast<size_t>(last) * n_;\n        const VertexMask sourceRow = g1_.rows[last];\n\n        for (int block = 0; block < k; ++block) {\n            const int image = equivalence_[last];\n            if (!parent[last].contains(image)) {\n                advancePrefix(last);\n            } else if (last == 0) {\n                printPermutation(equivalence_);\n                found_ = true;\n            } else {\n                VertexMask remaining = available;\n                remaining.remove(image);\n                const VertexMask neighbors = g2_.rows[image];\n                const VertexMask adjacent(neighbors.low & remaining.low,\n                                          neighbors.high & remaining.high);\n                const VertexMask nonadjacent((~neighbors.low) & remaining.low,\n                                             (~neighbors.high) & remaining.high);\n                VertexMask coverage;\n                bool viable = true;\n\n                // Scan contiguous domain rows using one fixed adjacency row.\n                for (int i = 0; i < last; ++i) {\n                    const VertexMask &allowed = sourceRow.contains(i)\n                        ? adjacent : nonadjacent;\n                    child[i].low = parent[i].low & allowed.low;\n                    child[i].high = parent[i].high & allowed.high;\n                    if ((child[i].low | child[i].high) == 0) {\n                        viable = false;\n                        break;\n                    }\n                    coverage.low |= child[i].low;\n                    coverage.high |= child[i].high;\n                }\n                if (coverage.low != remaining.low || coverage.high != remaining.high)\n                    viable = false;\n\n                if (viable)\n                    enumerate(last, remaining);\n                else\n                    advancePrefix(last);\n            }\n\n            if (block < last)\n                swap(equivalence_[(k % 2 == 0) ? block : 0], equivalence_[last]);\n        }\n    }\n\npublic:\n    HeapDomainSearch(const adjacency_matrix &first, const adjacency_matrix &second)\n        : g1_(first), g2_(second), n_(static_cast<int>(first.size())),\n          equivalence_(n_), domains_(static_cast<size_t>(n_ + 1) * n_),\n          endpoints_(static_cast<size_t>(n_) * n_), scratch_(n_), found_(false) {}\n\n    bool run() {\n        found_ = false;\n        for (int i = 0; i < n_; ++i)\n            equivalence_[i] = i;\n        if (n_ == 0) {\n            printPermutation(equivalence_);\n            return true;\n        }\n\n        vector<VertexMask> classes(2 * (n_ + 1));\n        vector<int> balance(2 * (n_ + 1), 0);\n        VertexMask available;\n        for (int vertex = 0; vertex < n_; ++vertex) {\n            const int key = vertexClass(g2_, vertex);\n            classes[key].add(vertex);\n            ++balance[key];\n            available.add(vertex);\n        }\n\n        VertexMask *root = domains_.data() + static_cast<size_t>(n_) * n_;\n        for (int vertex = 0; vertex < n_; ++vertex) {\n            const int key = vertexClass(g1_, vertex);\n            --balance[key];\n            root[vertex] = classes[key];\n        }\n        for (int count : balance)\n            if (count != 0)\n                return false;\n\n        buildEndpoints();\n        enumerate(n_, available);\n        return found_;\n    }\n};\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2) {\n    if (g1.size() != g2.size())\n        return false;\n\n    bool identity = true;\n    for (size_t i = 0; i < g1.size(); ++i) {\n        if (g1.rows[i].low != g2.rows[i].low || g1.rows[i].high != g2.rows[i].high) {\n            identity = false;\n            break;\n        }\n    }\n    if (identity) {\n        vector<int> equivalence(g1.size());\n        for (size_t i = 0; i < equivalence.size(); ++i)\n            equivalence[i] = static_cast<int>(i);\n        printPermutation(equivalence);\n        return true;\n    }\n\n    HeapDomainSearch search(g1, g2);\n    return search.run();\n}\n\nint main() {\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n    if (!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n    return 0;\n}\n",

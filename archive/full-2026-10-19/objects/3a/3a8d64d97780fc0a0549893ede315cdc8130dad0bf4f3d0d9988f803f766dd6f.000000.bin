{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <math.h>\\n\\n#define N_ITER 10 // number of simulation iterations\\n#define DT 0.01f // time step\\n#define SOFTENING 1e-9f // to avoid zero divisors\\n\\n/*\\n * Each body holds coordinate positions (i.e., x, y, and z) and\\n * velocities (i.e., vx, vy, and vz).\\n */\\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\\n\\n/*\\n * Compute the gravitational impact among all pairs of bodies in\\n * the system.\\n */\\nvoid body_force(Body *p, float dt, int n) {\\n  for (int i = 0; i < n; ++i) {\\n    float fx = 0.0f;\\n    float fy = 0.0f;\\n    float fz = 0.0f;\\n\\n    for (int j = 0; j < n; j++) {\\n      float dx = p[j].x - p[i].x;\\n      float dy = p[j].y - p[i].y;\\n      float dz = p[j].z - p[i].z;\\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n      float inv_dist = 1 / sqrt(sqrd_dist);\\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n\\n      fx += dx * inv_dist3;\\n      fy += dy * inv_dist3;\\n      fz += dz * inv_dist3;\\n    }\\n\\n    p[i].vx += dt*fx;\\n    p[i].vy += dt*fy;\\n    p[i].vz += dt*fz;\\n  }\\n}\\n\\n/*\\n * Read a binary dataset with initilized bodies.\\n */\\nBody* read_dataset(int *nbodies) {\\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading nbodie value\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading input values\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n\\n  return bodies;\\n}\\n\\n/*\\n * Write simulation results into a binary dataset.\\n */\\nvoid write_dataset(const int nbodies, Body *bodies) {\\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError writing to output\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n}\\n\\nint main(int argc,char **argv) {\\n  int nbodies;\\n\\n  Body *bodies = read_dataset(&nbodies);\\n  Body *alternate = NULL;\\n\\n  /* Avoid team startup and scratch allocation for small systems. */\\n  if (nbodies >= 128) {\\n    alternate = (Body *)malloc((size_t)nbodies * sizeof(*alternate));\\n  }\\n\\n  if (alternate != NULL) {\\n    /*\\n     * The current state remains read-only throughout each timestep.\\n     * Each body can therefore be integrated immediately into the next\\n     * state, with only one work-sharing barrier per timestep.\\n     */\\n    #pragma omp parallel default(none) shared(bodies, alternate, nbodies)\\n    {\\n      Body *current = bodies;\\n      Body *next = alternate;\\n\\n      for (int iter = 0; iter < N_ITER; iter++) {\\n        #pragma omp for schedule(static)\\n        for (int i = 0; i < nbodies; ++i) {\\n          float fx = 0.0f;\\n          float fy = 0.0f;\\n          float fz = 0.0f;\\n\\n          for (int j = 0; j < nbodies; j++) {\\n            float dx = current[j].x - current[i].x;\\n            float dy = current[j].y - current[i].y;\\n            float dz = current[j].z - current[i].z;\\n            float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n            float inv_dist = 1 / sqrt(sqrd_dist);\\n            float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n\\n            fx += dx * inv_dist3;\\n            fy += dy * inv_dist3;\\n            fz += dz * inv_dist3;\\n          }\\n\\n          Body updated = current[i];\\n          updated.vx += DT*fx;\\n          updated.vy += DT*fy;\\n          updated.vz += DT*fz;\\n          updated.x += updated.vx * DT;\\n          updated.y += updated.vy * DT;\\n          updated.z += updated.vz * DT;\\n          next[i] = updated;\\n        }\\n\\n        Body *tmp = current;\\n        current = next;\\n        next = tmp;\\n      }\\n    }\\n\\n    if (N_ITER & 1) {\\n      Body *tmp = bodies;\\n      bodies = alternate;\\n      alternate = tmp;\\n    }\\n  } else {\\n    /* Serial fallback also handles failure of the extra allocation. */\\n    for (int iter = 0; iter < N_ITER; iter++) {\\n      body_force(bodies, DT, nbodies);\\n\\n      for (int i = 0; i < nbodies; i++) {\\n        bodies[i].x += bodies[i].vx * DT;\\n        bodies[i].y += bodies[i].vy * DT;\\n        bodies[i].z += bodies[i].vz * DT;\\n      }\\n    }\\n  }\\n\\n  write_dataset(nbodies, bodies);\\n\\n  free(alternate);\\n  free(bodies);\\n\\n  exit(EXIT_SUCCESS);\\n}\\n\",\n      \"path\": \"src/nbody.c\"\n    }\n  ],\n  \"hypothesis\": \"Double-buffered timesteps with a persistent static OpenMP team should reduce synchronization and cache-coherence traffic while preserving each body's serial force accumulation.\",\n  \"notes\": \"Preserves binary I/O, inner-loop accumulation order, and double-precision sqrt semantics. Requires one additional body array, with serial fallback on allocation failure. No commands executed.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Use immutable current-state and separate next-state buffers to fuse force computation and position integration.\",\n    \"Keep one persistent OpenMP team with static work sharing and one work-sharing barrier per timestep.\",\n    \"Retain serial execution below 128 bodies to avoid parallel startup overhead.\"\n  ]\n}"}}

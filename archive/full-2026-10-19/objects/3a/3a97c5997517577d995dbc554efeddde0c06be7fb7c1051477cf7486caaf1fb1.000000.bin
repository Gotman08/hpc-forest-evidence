#include <algorithm>
#include <cstddef>
#include <cstdio>
#include <vector>

static const int MOD = 1000000007;

class FastInput {
    unsigned char buffer[65536];
    std::size_t position = 0;
    std::size_t length = 0;

    int get() {
        if (position == length) {
            length = std::fread(buffer, 1, sizeof(buffer), stdin);
            position = 0;
            if (length == 0) return EOF;
        }
        return buffer[position++];
    }

public:
    bool read(int& value) {
        int ch;
        do {
            ch = get();
            if (ch == EOF) return false;
        } while (ch <= ' ');
        int sign = 1;
        if (ch == '-') {
            sign = -1;
            ch = get();
        }
        value = 0;
        while (ch >= '0' && ch <= '9') {
            value = value * 10 + ch - '0';
            ch = get();
        }
        value *= sign;
        return true;
    }
};

static inline int add_mod(int a, int b) {
    int sum = a + b;
    return sum >= MOD ? sum - MOD : sum;
}

static void process_four_rows(std::vector<int>& dp,
                              const std::vector<std::vector<int> >& obstacles,
                              int first_row) {
    const std::vector<int>& r0 = obstacles[first_row];
    const std::vector<int>& r1 = obstacles[first_row + 1];
    const std::vector<int>& r2 = obstacles[first_row + 2];
    const std::vector<int>& r3 = obstacles[first_row + 3];
    std::size_t p0 = 0, p1 = 0, p2 = 0, p3 = 0;
    int left0 = 0, left1 = 0, left2 = 0, left3 = 0;
    const int n = static_cast<int>(dp.size());
    int x = 0;

    while (x < n) {
        int stop = n;
        if (p0 < r0.size()) stop = std::min(stop, r0[p0]);
        if (p1 < r1.size()) stop = std::min(stop, r1[p1]);
        if (p2 < r2.size()) stop = std::min(stop, r2[p2]);
        if (p3 < r3.size()) stop = std::min(stop, r3[p3]);

        // Intermediate rows stay in registers; only the bottom row is stored.
        for (; x < stop; ++x) {
            left0 = add_mod(dp[x], left0);
            left1 = add_mod(left0, left1);
            left2 = add_mod(left1, left2);
            left3 = add_mod(left2, left3);
            dp[x] = left3;
        }
        if (x == n) break;

        if (p0 < r0.size() && r0[p0] == x) {
            left0 = 0;
            ++p0;
        } else {
            left0 = add_mod(dp[x], left0);
        }
        if (p1 < r1.size() && r1[p1] == x) {
            left1 = 0;
            ++p1;
        } else {
            left1 = add_mod(left0, left1);
        }
        if (p2 < r2.size() && r2[p2] == x) {
            left2 = 0;
            ++p2;
        } else {
            left2 = add_mod(left1, left2);
        }
        if (p3 < r3.size() && r3[p3] == x) {
            left3 = 0;
            ++p3;
        } else {
            left3 = add_mod(left2, left3);
        }
        dp[x] = left3;
        ++x;
    }
}

static void process_one_row(std::vector<int>& dp,
                            const std::vector<int>& obstacles) {
    int left = 0;
    int x = 0;
    for (std::size_t p = 0; p < obstacles.size(); ++p) {
        const int stop = obstacles[p];
        for (; x < stop; ++x) {
            left = add_mod(dp[x], left);
            dp[x] = left;
        }
        dp[x] = 0;
        left = 0;
        ++x;
    }
    const int n = static_cast<int>(dp.size());
    for (; x < n; ++x) {
        left = add_mod(dp[x], left);
        dp[x] = left;
    }
}

int main() {
    FastInput input;
    int n, m;
    if (!input.read(n) || !input.read(m)) return 0;

    std::vector<std::vector<int> > obstacles(n);
    for (int i = 0; i < m; ++i) {
        int y, x;
        input.read(y);
        input.read(x);
        obstacles[y].push_back(x);
    }
    for (int y = 0; y < n; ++y) {
        std::vector<int>& row = obstacles[y];
        std::sort(row.begin(), row.end());
        row.erase(std::unique(row.begin(), row.end()), row.end());
    }

    std::vector<int> dp(n, 0);
    dp[0] = 1;
    int y = 0;
    for (; y + 3 < n; y += 4) {
        process_four_rows(dp, obstacles, y);
    }
    for (; y < n; ++y) {
        process_one_row(dp, obstacles[y]);
    }
    std::printf("%d\n", dp[n - 1]);
    return 0;
}

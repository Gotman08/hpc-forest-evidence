          "files": [
            "src/solution.cpp"
          ],
          "retained": [
            "Use factorial-based binomial path counts and inclusion-exclusion over sorted blocked points.",
            "Process equal-diagonal blocked points concurrently because none can be a monotone predecessor of another.",
            "Use a serial path for small diagonal groups to avoid parallel-region overhead."
          ]
        },

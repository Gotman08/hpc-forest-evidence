      "content": "#define _POSIX_C_SOURCE 200112L\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n\n#define CONV_THRESHOLD 1.0e-5f\n\nstatic double *grid;\nstatic double *new_grid;\nstatic size_t row_stride;\nstatic int size;\nstatic int iter_max_num;\n\nstatic int allocate_memory(void) {\n    size_t n = (size_t)size;\n    if (n > SIZE_MAX - 7u)\n        return 0;\n\n    row_stride = (n + 7u) & ~(size_t)7u;\n    if (row_stride > SIZE_MAX / n / sizeof(double))\n        return 0;\n\n    size_t bytes = row_stride * n * sizeof(double);\n    void *allocation = NULL;\n    if (posix_memalign(&allocation, 64, bytes) != 0)\n        return 0;\n    grid = (double *)allocation;\n\n    allocation = NULL;\n    if (posix_memalign(&allocation, 64, bytes) != 0) {\n        free(grid);\n        grid = NULL;\n        return 0;\n    }\n    new_grid = (double *)allocation;\n    return 1;\n}\n\nstatic void initialize_grid(void) {\n    int center = size / 2;\n    int linf = center - (size / 10);\n    int lsup = center + (size / 10);\n\n    for (int i = 0; i < size; i++) {\n        size_t row = (size_t)i * row_stride;\n        for (int j = 0; j < size; j++) {\n            double value = (i >= linf && i <= lsup &&\n                            j >= linf && j <= lsup) ? 100.0 : 0.0;\n            grid[row + (size_t)j] = value;\n            new_grid[row + (size_t)j] = value;\n        }\n    }\n}\n\nstatic void save_grid(void) {\n    for (int i = 0; i < size; i++) {\n        size_t row = (size_t)i * row_stride;\n        for (int j = 0; j < size; j++)\n            fprintf(stdout, \"%lf \", grid[row + (size_t)j]);\n        fprintf(stdout, \"\\n\");\n    }\n}\n\nint main(int argc, char *argv[]) {\n    (void)argc;\n    (void)argv;\n\n    fscanf(stdin, \"%d\", &size);\n    fscanf(stdin, \"%d\", &iter_max_num);\n\n    if (size <= 0)\n        return 0;\n    if (!allocate_memory())\n        return 1;\n    initialize_grid();\n\n    int hasError = 1;\n    int iter = 0;\n    while (hasError && iter < iter_max_num) {\n        hasError = 0;\n\n        #pragma omp parallel for schedule(static) reduction(|:hasError)\n        for (int i = 1; i < size - 1; i++) {\n            int row_error = 0;\n            size_t row = (size_t)i * row_stride;\n            const double * restrict current = grid + row;\n            const double * restrict above = current - row_stride;\n            const double * restrict below = current + row_stride;\n            double * restrict next = new_grid + row;\n\n            #pragma omp simd reduction(|:row_error)\n            for (int j = 1; j < size - 1; j++) {\n                next[j] = 0.25 * (current[j + 1] + current[j - 1] +\n                                  above[j] + below[j]);\n\n                double delta = next[j] - current[j];\n                if (delta > CONV_THRESHOLD || delta < -CONV_THRESHOLD)\n                    row_error |= 1;\n            }\n            hasError |= row_error;\n        }\n\n        double *temporary_grid = grid;\n        grid = new_grid;\n        new_grid = temporary_grid;\n        iter++;\n    }\n\n    save_grid();\n    free(grid);\n    free(new_grid);\n    return 0;\n}\n",
      "path": "src/laplace_seq.c"
    }
  ],
  "hypothesis": "Combining the measured row-parallel SIMD stencil with aligned, padded contiguous buffers should preserve the strong row-worksharing performance while improving row locality and eliminating the per-iteration interior copy.",

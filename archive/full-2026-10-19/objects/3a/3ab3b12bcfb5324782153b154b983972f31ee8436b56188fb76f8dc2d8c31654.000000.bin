def need(condition, message):
    if not condition:
        raise ValueError(message)


def checksum(data):
    return hashlib.sha256(data).hexdigest()


def forbidden(*_args, **_kwargs):
    raise AssertionError("process/socket/RPC/native effect outside the INERT metadata fixture")


class ForbiddenPopen(subprocess.Popen):
    def __new__(cls, *_args, **_kwargs):
        return forbidden()


class ForbiddenSocket(socket.socket):
    def __new__(cls, *_args, **_kwargs):
        return forbidden()


class Clock:
    """Namespace object, never assigned into the global time module."""
    def __init__(self, instant):
        need(type(instant) in (float, int) and math.isfinite(instant), "finite explicit fixture time required")
        self.instant = instant

    def time(self):
        return self.instant

    def time_ns(self):
        return int(self.instant * 1_000_000_000)

    sleep = staticmethod(forbidden)
    monotonic = staticmethod(forbidden)
    perf_counter = staticmethod(forbidden)


class CaptureThenValidationClock:
    """First epoch is actual supplied capture, later epoch is chosen validation."""
    def __init__(self, captured, validation):
        need(0 <= validation - captured <= 120, "original capture/validation120s intersection required")
        self.captured, self.validation, self.first = captured, validation, True

    def __call__(self):
        if self.first:
            self.first = False
            return self.captured
        return self.validation


def save(path, value):
    path = Path(path)
    need(any(path == root or path.is_relative_to(root) for root in ALLOWED_OUTPUTS), "write outside literal INERT allowlist")
    with path.open("x", encoding="utf8", newline="\n") as stream:
        json.dump(value, stream, indent=2, ensure_ascii=False, allow_nan=False)
        stream.write("\n")
    return {"path": str(path), "sha256": checksum(path.read_bytes())}


def preflight_outputs():
    """All exact output boundaries checked BEFORE any producer main or output."""
    for path in ALLOWED_OUTPUTS:
        need(path.is_absolute() and ".." not in path.parts and path.is_relative_to(BASE)
             and path.name.startswith(PREFIX) and not path.exists(), "preexisting or out-of-list INERT destination")
        for parent in path.parents:
            if not parent.is_relative_to(BASE):
                break
            need(not parent.is_symlink() and not getattr(parent, "is_junction", lambda: False)(), "ordinary output ancestry required")
    need(CHAIN == (PREP / "adaptateurs-source110-r1/revision-r7-racines-techniques-neuves").resolve(), "factory anchor must stay exact")


class LocalModules:
    """Imports pinned local definitions with namespace clocks and effect barriers.

    Importlib wrappers only change Python namespace bindings and execution of
    local definitions. They do not change source AST, validators, TTL or global
    stdlib objects. Source relative imports are rebound after definition loading
    and before their functions are invoked; no received module is imported.
    """
    def __init__(self, store, clock, pins):
        self.store, self.clock, self.pins = store, clock, dict(pins)
        self.argv = None
        self.loaded = []
        self.bound_ids = set()
        self.original_import = builtins.__import__
        outer = self

        class FixtureParser(argparse.ArgumentParser):
            def parse_args(self, args=None, namespace=None):
                need(args is not None or outer.argv is not None, "explicit fixture argv required")
                return super().parse_args(outer.argv if args is None else args, namespace)

        class FixtureDateTime(datetime):
            @classmethod
            def now(cls, tz=None):
                return cls.fromtimestamp(outer.clock.time(), tz)

        self.argparse = types.SimpleNamespace(**vars(argparse))
        self.argparse.ArgumentParser = FixtureParser
        self.datetime = types.SimpleNamespace(**vars(datetime_module))
        self.datetime.datetime = FixtureDateTime
        self.process = types.SimpleNamespace(**vars(subprocess))
        for name in ("run", "call", "check_call", "check_output"):
            setattr(self.process, name, forbidden)
        self.process.Popen = ForbiddenPopen
        self.socket = types.SimpleNamespace(**vars(socket))
        self.socket.socket, self.socket.create_connection = ForbiddenSocket, forbidden
        self.util = types.SimpleNamespace(**vars(importlib.util))
        self.util.spec_from_file_location = self.spec
        self.importlib = types.SimpleNamespace(**vars(importlib))
        self.importlib.util = self.util
        self.importlib.import_module = self.import_module

    def bind(self, module):
        path = getattr(module, "__file__", None)
        if not path or not str(path).endswith(".py"):
            return
        path = Path(path).resolve()
        if path not in self.pins or id(module) in self.bound_ids:
            return
        need(checksum(self.store.raw(path)) == self.pins[path], "loaded definition pin differs")
        for name, replacement in (("time", self.clock), ("argparse", self.argparse),
                                  ("importlib", self.importlib), ("subprocess", self.process), ("socket", self.socket)):
            if name in vars(module):
                setattr(module, name, replacement)
        if vars(module).get("datetime") is datetime:
            module.datetime = self.datetime.datetime
        self.bound_ids.add(id(module))

    def import_module(self, *args, **kwargs):
        value = importlib.import_module(*args, **kwargs)
        self.bind_all()
        return value

    def bind_all(self):
        for module in [*list(sys.modules.values()), *self.loaded]:
            if isinstance(module, types.ModuleType):
                self.bind(module)

    def importer(self, name, globals=None, locals=None, fromlist=(), level=0):
        if level == 0:
            chosen = {"time": self.clock, "datetime": self.datetime, "argparse": self.argparse,
                      "subprocess": self.process, "socket": self.socket, "importlib": self.importlib,
                      "importlib.util": self.importlib}
            if name in chosen:
                return chosen[name]
        value = self.original_import(name, globals, locals, fromlist, level)
        self.bind_all()
        return value

    def execute(self, module, path):
        path = Path(path).resolve()
        need(path in self.pins, "unlisted source import refused: " + path.name)
        raw = self.store.raw(path)
        need(checksum(raw) == self.pins[path], "source changed before definition import")
        module.__dict__["__builtins__"] = {**vars(builtins), "__import__": self.importer}
        self.loaded.append(module)
        exec(compile(raw, str(path), "exec"), vars(module))
        self.bind_all()

    def spec(self, name, location, *args, **kwargs):
        path = Path(location).resolve()
        need(path in self.pins, "importlib source outside closed pins")
        outer = self

        class DefinitionLoader:
            @staticmethod
            def create_module(_spec):
                return None

            @staticmethod
            def exec_module(module):
                outer.execute(module, path)

        spec = importlib.util.spec_from_file_location(name, path, *args, **kwargs)
        spec.loader = DefinitionLoader()
        return spec

    def load(self, path, name):
        spec = self.spec(name, path)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return module

    def main(self, module, argv):
        previous = self.argv
        self.argv = list(map(str, argv))
        try:
            module.main()
        finally:
            self.argv = previous


def complete_without_exporting_descendant_review(loader, module, proof_ref, cim_ref):
    """Exact constructor main through value construction; final publication omitted.

    The function's output filename is not INERT-prefixed, so the production final
    target/open/print suffix is not executed. The unchanged preceding AST still
    invokes both exact564 validations, all path/refs guards and rehashes.
    """
    tree = ast.parse(loader.store.raw(DESC))
    node = next(row for row in tree.body if isinstance(row, ast.FunctionDef) and row.name == "main")
    cut = next(index for index, row in enumerate(node.body)
               if isinstance(row, ast.Assign) and any(isinstance(t, ast.Name) and t.id == "target" for t in row.targets))
    prefix = copy.deepcopy(node)
    prefix.name = "fixture_constructor_prefix"
    prefix.body = prefix.body[:cut] + [ast.Return(value=ast.Name(id="value", ctx=ast.Load()))]
    ast.fix_missing_locations(prefix)
    # Compile the unchanged companion definitions into the SAME globals as the
    # prefix: raw/reference must see the _IO initialized by this prefix, rather
    # than closing over the original module's still-None _IO.
    namespace = {"__file__": str(DESC), "__name__": "inert_descendant_prefix", "__builtins__": {
        **vars(builtins), "__import__": loader.importer}}
    body = [prefix if row is node else row for row in tree.body]
    exec(compile(ast.Module(body=body, type_ignores=[]), str(DESC), "exec"), namespace)
    previous = loader.argv
    loader.argv = ["--complete-absence", proof_ref["path"], "--complete-absence-sha256", proof_ref["sha256"],
                   "--current-cim", cim_ref["path"], "--current-cim-sha256", cim_ref["sha256"]]
    try:
        return namespace["fixture_constructor_prefix"]()
    finally:
        loader.argv = previous


def bounded_watch_iteration(loader, obs, policy_path, routes_path, transition, index, route_candidate, clock):
    """One exact try body of watch, with explicit fixture census/RPC/process role."""
    tree = ast.parse(loader.store.raw(OBS))
    watch = next(row for row in tree.body if isinstance(row, ast.AsyncFunctionDef) and row.name == "watch")
    loop = next(row for row in ast.walk(watch) if isinstance(row, ast.While))
    attempt = loop.body[0]
    need(isinstance(attempt, ast.Try) and attempt.lineno == 693, "exact watch loop boundary changed")
    args = ["policy_path", "routes_path", "transition_path", "policy_sha", "code_sha", "policy", "history", "terminal", "transition_sha", "old", "rpc"]
    function = ast.AsyncFunctionDef(name="fixture_one_watch_try", args=ast.arguments(
        posonlyargs=[], args=[ast.arg(arg=name) for name in args], kwonlyargs=[], kw_defaults=[], defaults=[]),
        body=copy.deepcopy(attempt.body), decorator_list=[])
    ast.fix_missing_locations(function)
    namespace = vars(obs)
    exec(compile(ast.Module(body=[function], type_ignores=[]), str(OBS), "exec"), namespace)
    cim = loader.store.reference(index["full_cim"])
    rows = cim["rows"]
    parsed_rows = obs.parse_census(json.dumps(rows, ensure_ascii=False).encode("utf8"))
    need(parsed_rows == rows, "exact parse_census changed supplied historical rows")
    obs.census = lambda: copy.deepcopy(parsed_rows)
    # Role injection, not a new observation: this PID belongs to the supplied
    # historical exact OBS4 pair, checked against the same supplied full CIM.
    obs.os = types.SimpleNamespace(**vars(os))
    obs.os.getpid = lambda: 28544

    async def scheduler(_rpc, job):
        obs.check_rpc("job_status", {"job_id": job}, {
            loader.store.reference(cell["allocation_marker"])["job_id"] for cell in index["cells"]})
        row = next(cell for cell in index["cells"] if loader.store.reference(cell["allocation_marker"])["job_id"] == job)
        slug = MODELS[row["model"]]
        raw = loader.store.reference(loader.reference(OWN / slug / "STATUT-OUTIL-BRUT-02.json"))
        value = raw["structuredContent"]
        need(raw.get("isError") is False and value.get("ok") is True and value.get("job_id") == job
             and value.get("state") == "RUNNING" and value.get("finished") is False, "actual historical status shape differs")
        observed = value["observation"]["observed_at"]
        need(0 <= clock.time() - observed <= 120, "historical status outside unchanged120s gate")
        return copy.deepcopy(value)

    inert_old = types.SimpleNamespace(shared=types.SimpleNamespace(scheduler=scheduler))
    policy = obs.read(policy_path)
    coroutine = namespace["fixture_one_watch_try"](policy_path, routes_path, transition,
        obs.digest(policy_path), OBS_SHA, policy, {}, {}, obs.digest(transition), inert_old, object())
    try:
        coroutine.send(None)
    except StopIteration:
        pass
    else:
        coroutine.close()
        raise AssertionError("iteration unexpectedly yielded outside immediate INERT scheduler")
    state = obs.read(OBS_OUTPUT / "observer-state.json")
    need(state["routes_history"] == route_candidate["computed_history_for_inert_validation_only"]
         and state["stage"] == "observing" and state["transition_verified"] is True,
         "serialized exact watch state differs from route production")
    return state


def interval_intersection(index, store):
    """No time is rewritten: determine a valid common historical instant."""
    cim = store.reference(index["full_cim"])
    start = cim["observed_at"]
    limits = [{"kind": "full_CIM120", "lower": start, "upper": start + 120}]
    for row in index["cells"]:
        marker, request = store.reference(row["allocation_marker"]), store.reference(row["request_prepared"])
        status = store.reference(ref_file(store, OWN / MODELS[row["model"]] / "STATUT-OUTIL-BRUT-02.json"))["structuredContent"]
        instant = status["observation"]["observed_at"]
        limits.extend([{"kind": row["model"] + ":marker600", "lower": marker["created_at"], "upper": marker["created_at"] + 600},
                       {"kind": row["model"] + ":request", "lower": marker["created_at"], "upper": request["expires_at"]},
                       {"kind": row["model"] + ":status120", "lower": instant, "upper": instant + 120}])
    lower, upper = max(row["lower"] for row in limits), min(row["upper"] for row in limits)
    need(lower < upper, "no common historical CIM/status/marker/request interval; cannot invent positive fixture")
    historical = lower + min(0.25, (upper - lower) / 2)
    initial = store.reference(index["history_state"])
    return historical, {"actual_input_intervals": limits, "lower": lower, "upper_exclusive": upper,
        "chosen_historical_time": historical, "original_initial_observing_state_updated_at": initial["updated_at"],
        "original_initial_observing_state_expired_before_markers": initial["updated_at"] + 90 < min(
            store.reference(row["allocation_marker"])["created_at"] for row in index["cells"]),
        "new_fixture_state_will_not_be_an_actual_historical_observation": True}


def ref_file(store, path):
    path = Path(path)
    return {"path": str(path), "sha256": checksum(store.raw(path))}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--entry", type=Path, required=True)
    parser.add_argument("--entry-sha256", required=True)
    parser.add_argument("--root-execute-INERT-only", action="store_true")
    args = parser.parse_args()
    need(args.root_execute_INERT_only, "explicit ROOT-only INERT acknowledgement required")
    preflight_outputs()
    originals = (time.time, time.time_ns, datetime_module.datetime, datetime_module.datetime.__dict__["now"],
                 subprocess.Popen, subprocess.run, socket.socket, socket.create_connection, os.getpid, os.replace)
    # The small route producer is definitions-only at import; no main/test called.
    route_path = ROUTE / "preparer-routes-pending-inertes.py"
    route_raw = route_path.read_bytes()
    need(checksum(route_raw) == "a018d2896f81547464a1600a1536dbc6530bf7b17ba5d23654c59f0b8a76b00b", "exact route producer required")
    route = types.ModuleType("inert_whole_route_definitions")
    route.__file__ = str(route_path)
    exec(compile(route_raw, str(route_path), "exec"), vars(route))
    store = route.ColdStore()
    entry = store.reference({"path": str(args.entry), "sha256": args.entry_sha256})
    need(set(entry) == {"schema", "fixture_only", "route_index", "qualification", "sidecar", "sidecar_review", "startup", "pair", "transition"}
         and entry["schema"] == "hpc-forest-r7-inert-whole-parent-entry-v1" and entry["fixture_only"] is True,
         "closed explicitly INERT entry required")
    need(entry["sidecar"]["path"] == str(SIDECAR), "exact original sidecar path required")
    for name in ("qualification", "sidecar", "sidecar_review", "startup", "pair", "transition"):
        if name != "sidecar":
            value = store.reference(entry[name])
            if name == "startup":
                for reference in value["refs"].values():
                    store.reference(reference)
        else:
            need(checksum(store.raw(SIDECAR)) == entry[name]["sha256"], "original sidecar pin differs")
    index = store.reference(entry["route_index"])
    historical, intervals = interval_intersection(index, store)
    clock = Clock(historical)
    components = store.reference(ref_file(store, CHAIN / "COMPONENTS.json"))
    need(checksum(store.raw(CHAIN / "COMPONENTS.json")) == COMP_SHA and len(components["code_pins"]) == 62, "exact62 required")
    for name, expected in components["code_pins"].items():
        need(checksum(store.raw(CHAIN / name)) == expected, "source62 changed before composition")
    pins = {CHAIN / name: value for name, value in components["code_pins"].items()}
    pins.update({OWN / name: value for name, value in HELPERS.items()})
    pins.update({PARTIAL: PARTIAL_SHA, DESC: DESC_SHA, SIDECAR: entry["sidecar"]["sha256"]})
    # Exact source110 manifests close transitive local definition imports.
    source_pins = store.reference(ref_file(store, CHAIN / "launcher/pins-source-plan.json"))
    manifest = store.reference(source_pins["source_manifest"])
    source_project = Path(source_pins["source_project"])
    need(isinstance(manifest, dict) and len(manifest) == 110 and all(isinstance(value, str) and len(value) == 64 for value in manifest.values()),
         "source110 exact direct file map required")
    pins.update({source_project / name: value for name, value in manifest.items() if name.endswith(".py")})
    # Source-state and held-read modules are imported as exact local definitions.
    binding = store.reference(ref_file(store, OP / "preparation-roots-operationnelle-r1/revision-source-state-binding-r2/SOURCE-STATE-BINDING-R2-CANDIDAT-NON-ADMIS.json"))
    for name in ("reader", "current_verifier"):
        pins[Path(binding[name]["path"])] = binding[name]["sha256"]
    loader = LocalModules(store, clock, pins)
    loader.reference = lambda path: ref_file(store, path)
    factory = loader.load(CHAIN / "assemble_admissions.py", "inert_whole_factory")
    factory.reader_bridge.check_qualification(entry["qualification"])
    factory.bootstrap_source()
    loader.bind_all()
    need(factory.INTEGRATION_ROOT == CHAIN, "factory real direct-child guard cannot be redirected")
    OUTPUT.mkdir()
    trace, negatives = [], []
    result = {"schema": SCHEMA, "fixture_only": True, "verified_inert_composition_only": False,
        "native_generation_admitted": False, "production_observer_state_synchronization_verified": False,
        "NEVER_UPLOAD_ANY_FIXTURE_OUTPUT": True, "source_Q_actual": entry["qualification"], "intervals": intervals,
        "steps": trace, "negative_controls": negatives, "blocking_findings": []}
    try:
        # Current validation has to refuse the old requests before any extension.
        try:
            route.construct(index, store)
        except ValueError as error:
            need("expired" in str(error), "current refusal must be original expiry, not an unrelated failure")
            negatives.append({"case": "actual_current_expired", "refused": True, "error": str(error)})
        else:
            raise AssertionError("expired actual requests unexpectedly accepted at current time")
        candidate = route.construct(index, store, historical_at=historical)
        intent = store.reference(store.reference(entry["startup"])["refs"]["start_intent"])
        routes_path = Path(intent["routes"]["path"])
        need(store.reference(ref_file(store, routes_path)) == candidate["routes_bundle"], "corrected cold routes differ from actual producer output")
        route_ref = save(OUTPUT / "ROUTES-PRODUITES-INERTES.json", candidate)
        trace.append({"step": 1, "function": "route.construct -> exact OBS.verify_routes", "status": "composed-INERT", "output": route_ref})
        # A distinct OBS namespace output is ROOT-authorized; factory anchor is untouched.
        obs = loader.load(OBS, "inert_whole_observer")
        OBS_OUTPUT.mkdir()
        for name in ("ABI.json", "validation-locale.json", "test_obs4_neutre.py", "TESTS-OBS4-NEUTRES.xml"):
            original = store.raw(CHAIN / "observer" / name)
            with (OBS_OUTPUT / name).open("xb") as stream:
                stream.write(original)
            need(checksum(store.raw(OBS_OUTPUT / name)) == checksum(original), "observer validation copy changed")
        obs.HERE = OBS_OUTPUT
        obs.census = forbidden
        policy_path = Path(index["policy"]["path"])
        transition = Path(entry["transition"]["path"])
        state = bounded_watch_iteration(loader, obs, policy_path, routes_path, transition, index, candidate, clock)
        trace.append({"step": 2, "function": "unchanged watch try AST -> guard -> transition_state -> serialized state", "status": "composed-INERT",
                      "state": ref_file(store, OBS_OUTPUT / "observer-state.json"), "actual_watcher_consumption_proved": False})
        sidecar = loader.load(SIDECAR, "inert_whole_external_admission")
        admissions = {}
        for model, slug in MODELS.items():
            target = SIDECAR.parent.parent / (PREFIX + "-sidecar-" + slug)
            target.mkdir()
            side_args = types.SimpleNamespace(policy=policy_path, routes=routes_path, transition=transition,
                reader_identities=Path(entry["pair"]["path"]), startup_evidence=Path(entry["startup"]["path"]),
                startup_evidence_sha256=entry["startup"]["sha256"], helper_review=Path(entry["sidecar_review"]["path"]),
                helper_review_sha256=entry["sidecar_review"]["sha256"], model=model, admit_cell="roots")
            # Preserve the supplied census capture epoch. Namespace validation
            # time is later in its original120s window; this is not a recapture.
            census_clock = CaptureThenValidationClock(store.reference(index["full_cim"])["observed_at"], clock.time())
            admissions[model] = ref_file(store, sidecar.admission_once(obs, side_args, target, clock=census_clock))
        trace.append({"step": 3, "function": "unchanged admission_once -> actual validators -> admit_cell -> cold state copy", "status": "composed-INERT",
                      "admissions": admissions, "census_input_is_historical_fixture": True})
        partial = loader.load(PARTIAL, "inert_whole_partial_SO")
        cim_ref = index["full_cim"]
        loader.main(partial, ["--full-cim", cim_ref["path"], "--full-cim-sha256", cim_ref["sha256"],
                              "--output-directory", PARTIAL_OUTPUT, "--require-fresh"])
        complete = loader.load(OWN / "completer-absence-SO-lane-R7.py", "inert_whole_complete_SO")
        partial_ref = ref_file(store, PARTIAL_OUTPUT / "ABSENCE-source-only.json")
        loader.main(complete, ["--source-absence", partial_ref["path"], "--source-absence-sha256", partial_ref["sha256"],
                              "--full-cim", cim_ref["path"], "--full-cim-sha256", cim_ref["sha256"], "--output", COMPLETE_OUTPUT])
        with COPIED_OUTPUT.open("xb") as stream:
            stream.write(store.raw(COMPLETE_OUTPUT))
        copied_ref = ref_file(store, COPIED_OUTPUT)
        need(copied_ref["sha256"] == ref_file(store, COMPLETE_OUTPUT)["sha256"], "SO copied anchor bytes differ")
        descendants = complete_without_exporting_descendant_review(loader, loader.load(DESC, "inert_whole_descendants"), copied_ref, cim_ref)
        descendant_ref = save(OUTPUT / "REVUE-DESCENDANTS-INERTE.json", descendants)
        trace.append({"step": 4, "function": "partial.main -> complete.main -> byte-exact anchor copy -> exact constructor main prefix/two564 validations",
                      "status": "composed-INERT", "same_CIM": cim_ref, "complete_SO": copied_ref, "descendants": descendant_ref})
        negative_controls(loader, route, index, candidate, complete, copied_ref, negatives)
        # Remaining stages are delegated to the exact producer composition below.
        downstream(loader, entry, index, admissions, copied_ref, descendant_ref, trace, negatives)
        result["verified_inert_composition_only"] = True
        result["current_expired_inputs_refused"] = True
    except BaseException as error:
        result["blocking_findings"].append({"type": type(error).__name__, "message": str(error), "last_completed_step": trace[-1]["step"] if trace else 0})
        raise
    finally:
        store.unchanged()
        after = (time.time, time.time_ns, datetime_module.datetime, datetime_module.datetime.__dict__["now"],
                 subprocess.Popen, subprocess.run, socket.socket, socket.create_connection, os.getpid, os.replace)
        need(all(a is b for a, b in zip(originals, after, strict=True)), "global clocks/process/socket objects changed")
        result["global_clock_functions_unchanged"] = True
        result["source62_before_after_equal"] = all(checksum(store.raw(CHAIN / name)) == value for name, value in components["code_pins"].items())
        result["all_cold_inputs_before_after"] = dict(store.pins)
        save(OUTPUT / "RESULTAT-PARCOURS-COMPLET-INERT-NON-ADMIS.json", result)


def negative_controls(loader, route, index, candidate, complete, complete_ref, negatives):
    """New composition-boundary controls, not a replay of the old eleven tests."""
    def refused(name, function, message):
        try:
            function()
        except ValueError as error:
            need(message in str(error), "negative control hit an unrelated guard: " + name)
            negatives.append({"case": name, "refused": True, "error": str(error)})
        else:
            raise AssertionError("negative control accepted: " + name)

    for field in ("submission_observed", "allocation_marker"):
        bad = copy.deepcopy(index)
        del bad["cells"][0][field]
        refused("missing_" + field, lambda bad=bad: route.construct(bad, loader.store, historical_at=loader.clock.time()),
                "all raw submission/marker/request/review refs required")
    frozen = route.frozen_observer(loader.store)
    wrong = copy.deepcopy(candidate["routes_bundle"])
    wrong["routes"][0]["session_id"] = wrong["routes"][1]["session_id"]
    policy = loader.store.reference(index["policy"])
    rows = loader.store.reference(index["full_cim"])["rows"]
    refused("cross_phase_binding", lambda: frozen["verify_routes"](wrong, policy, rows, {}), "Unknown model/phase/MAX/session")
    wrong_cim = ref_file(loader.store, OP / "observations-R7-preracines-01/CIM-PRIVE-FRAIS.json")
    module = loader.load(DESC, "inert_wrong_CIM_descendants")
    refused("different_CIM_between_SO_and_descendants", lambda: complete_without_exporting_descendant_review(
        loader, module, complete_ref, wrong_cim), "Actual complete ROOT proof must bind this exact current census")
    expired_at = min(loader.store.reference(row["request_prepared"])["expires_at"] for row in index["cells"]) + 1
    refused("historical_original_request_expired", lambda: route.construct(index, loader.store, historical_at=expired_at), "request expired")


def downstream(loader, entry, index, admissions, absence_ref, descendant_ref, trace, negatives):
    """Typed real helper chain. No copied old parent/mixed/transport positives."""
    store = loader.store
    triplet = loader.load(OWN / "preparer-triplet-metadata-R7.py", "inert_whole_triplet")
    snapshot = store.reference(ref_file(store, OP / "observations-R7-poststage-01/OBSERVATIONS-REELLES.json"))
    capacity_ref = ref_file(store, OWN / "CAPACITE-POSTSTAGE-01/CAPACITE-PRERACINES.json")
    classification_ref = ref_file(store, OWN / "CAPACITE-POSTSTAGE-01/CLASSIFICATION-NATIVE-PRIVEE.json")
    capacity, classified = store.reference(capacity_ref), store.reference(classification_ref)
    need(classified["full_cim"] == index["full_cim"] == snapshot["full_cim"] and classified["active_native_workers"] == 0
         and classified["active_native_groups"] == [] and capacity["private_native_classification"] == classification_ref,
         "same exact historical CIM/capacity0 required")
    oauth = store.reference(snapshot["oauth"])
    need(oauth["authentication_modified"] is False and oauth["model_calls"] == 0
         and all(oauth[key] is False for key in ("OPENAI_API_KEY_present", "CODEX_API_KEY_present", "OPENAI_BASE_URL_present")), "actual metadata-only OAuth fields differ")
    local_absence_ref = ref_file(store, OWN / "CAPACITE-POSTSTAGE-01/ABSENCE-LOCALE-TROIS-CACHES.json")
    local_absence = store.reference(local_absence_ref)
    need(local_absence.get("schema") == "hpc-forest-root-local-three-cache-absence-v1" and local_absence.get("verified") is True
         and len(local_absence.get("paths", [])) == 3 and all(row.get("exists") is False for row in local_absence["paths"]),
         "three actually recorded historical local lstat absences required")
    for reference in capacity["evidence_refs"]:
        store.raw(reference["path"])
        need(ref_file(store, reference["path"]) == reference, "capacity evidence SHA differs")
    common = {"real_qualification_reception": entry["qualification"], "oauth_observation": snapshot["oauth"],
        "codex_config": snapshot["codex_config"], "fresh_private_full_cim": index["full_cim"],
        "source_only_absence": absence_ref, "owned_descendant_review": descendant_ref, "observer_release": entry["transition"]}
    cells = []
    for route_row in index["cells"]:
        model, slug = route_row["model"], MODELS[route_row["model"]]
        marker = store.reference(route_row["allocation_marker"])
        binding_ref = ref_file(store, OWN / slug / "CELL-BINDING-REEL-01.json")
        binding = store.reference(binding_ref)
        policy_ref = ref_file(store, OWN / ("cli-policy-" + binding["session_id"] + ".json"))
        private_cli = loader.import_module("hpc_forest.codex_process")
        policy = private_cli.load_task_cli_policy(Path(policy_ref["path"]), policy_ref["sha256"], binding, oauth["executable_sha256"])
        feature_values = policy["cli_feature_overrides"]
        need(feature_values == private_cli.TASK_CLI_FEATURES, "strict source110 canonical22-feature contract required")
        marker_transfer_ref = ref_file(store, OWN / slug / "TRANSFERT-MARKER-OUTIL-BRUT-01.json")
        results_transfer_ref = ref_file(store, OWN / slug / "TRANSFERT-RESULTS-OUTIL-BRUT-01.json")
        status_ref = ref_file(store, OWN / slug / "STATUT-OUTIL-BRUT-02.json")
        marker_tool = triplet.tool_result(store.reference(marker_transfer_ref))
        results_tool = triplet.tool_result(store.reference(results_transfer_ref))
        status_tool = triplet.tool_result(store.reference(status_ref))
        evidence = [capacity_ref, classification_ref, local_absence_ref, binding_ref, policy_ref, snapshot["oauth"],
                    route_row["allocation_marker"], marker_transfer_ref, results_transfer_ref, status_ref]
        # These are INERT test controls derived from named cold facts, NEVER
        # a ROOT current signed review. Remote absence is pre-stage only.
        need(capacity["all_three_proposed_sessions_cache_registry_absent"] is True
             and capacity["requests_or_claims_started_for_proposed_sessions"] == 0
             and marker["requests_published"] == marker["native_model_calls"] == 0
             and marker["cache_claims_registry_created"] is False, "historical no-claim facts unknown")
        cache_path = str(PREP / "lancement-modeles-max-r3" / ("worker-" + binding["session_id"]))
        flags = {
            "full_census_locally_reviewed": capacity.get("full_census_locally_reviewed") is True
                and classified.get("all_full_census_rows_checked") is True,
            "no_unclassified_research_processes": capacity.get("no_unclassified_research_processes") is True
                and classified.get("conservative_candidate_process_ids") == classified.get("unclassified_native_process_ids") == [],
            "remote_registry_absent": marker.get("cache_claims_registry_created") is False,
            "prior_session_claims_absent": capacity.get("requests_or_claims_started_for_proposed_sessions") == 0
                and marker.get("requests_published") == marker.get("native_model_calls") == 0,
            "local_cache_absent": any(row.get("path") == cache_path and row.get("exists") is False for row in local_absence["paths"]),
            "local_registry_absent": any(row.get("path") == cache_path and row.get("exists") is False for row in local_absence["paths"]),
            "existing_transport_only": marker_tool.get("ok") is results_tool.get("ok") is status_tool.get("ok") is True
                and marker_tool.get("verifie") is True and marker_tool.get("remote_sha256") == route_row["allocation_marker"]["sha256"]
                and snapshot.get("authentication_or_global_configuration_changed") is False,
            "no_new_authentication": oauth.get("authentication_modified") is False and oauth.get("model_calls") == 0,
            "CLI_tools_disabled": feature_values == private_cli.TASK_CLI_FEATURES
                and policy.get("instruction_or_SKILL_body_read") is False,
        }
        need(set(flags) == set(triplet.ns["OBS_FLAGS"]) and all(value is True for value in flags.values()),
             "each of the nine INERT control derivatives needs its own named cold facts")
        controls = {"schema": "hpc-forest-source110-parent-controls-reviewed-v1", "verified": True, **binding,
                    "full_cim": index["full_cim"], "observed_at": capacity["observed_at"],
                    **flags, "evidence_refs": evidence,
                    "INERT_fixture_only_not_a_ROOT_observation": True,
                    "remote_absence_is_pre_stage_only": capacity["remote_absence_observed_at_utc"]}
        controls_ref = save(OUTPUT / (slug + "-INERT-nine-controls.json"), controls)
        cells.append({"model": model, "job_id": binding["job_id"], "allocation_marker": route_row["allocation_marker"],
            "results_directory": str(OWN / slug / ("results-" + binding["job_id"])),
            "marker_transfer": marker_transfer_ref, "results_transfer": results_transfer_ref,
            "job_status": status_ref, "reviewed_controls": controls_ref,
            "submission_intent": ref_file(store, OWN / slug / "submission-intent.json"), "submission_observed": route_row["submission_observed"],
            "script_reread": route_row["scheduler_script_review"], "mixed_observer_admission": admissions[model], "cli_policy": policy_ref})
    actual_index = save(OUTPUT / "INDEX-TRIPLET-INERT.json", {"schema": "hpc-forest-r7-parent-actual-triplet-index-v1",
        "common": common, "capacity": capacity_ref, "classification_native": classification_ref, "cells": cells})
    loader.main(triplet, ["--actual-index", actual_index["path"], "--actual-index-sha256", actual_index["sha256"],
                         "--root-reviewed-controls", "--output-directory", TRIPLET_OUTPUT])
    bundle_ref = ref_file(store, TRIPLET_OUTPUT / "TRIPLET-ACTUEL-POUR-ASSEMBLEUR.json")
    assembler = loader.load(OWN / "assembler-entrees-roots-R7.py", "inert_whole_assembler")
    loader.main(assembler, ["--actual-bundle", bundle_ref["path"], "--actual-bundle-sha256", bundle_ref["sha256"],
                           "--output-directory", ASSEMBLER_OUTPUT])
    trace.append({"step": 5, "function": "triplet.main -> assembler.main", "status": "composed-INERT", "actual_index": actual_index,
                  "root_controls_are_explicit_fixture_derivatives_not_current_attestations": True, "same_CIM": index["full_cim"]})
    factory = loader.load(CHAIN / "assemble_admissions.py", "inert_whole_factory_downstream")
    factory.bootstrap_source()
    loader.bind_all()
    components = store.reference(ref_file(store, CHAIN / "COMPONENTS.json"))
    config = OUTPUT / "INERT-NOT-A-USER-CONFIG.toml"
    config.write_text("# Explicit metadata fixture only; never passed to a CLI.\n", encoding="utf8")
    config_ref = ref_file(store, config)
    publications = []
    for model, slug in MODELS.items():
        inputs = store.reference(ref_file(store, ASSEMBLER_OUTPUT / (slug + "-factory-input.json")))
        original_transport = inputs["transport_probe_readback"]
        transport = store.reference(original_transport)
        inputs["codex_config"] = config_ref
        transport.update(configuration_path=str(config), configuration_sha256=config_ref["sha256"],
                         INERT_config_rebinding_only_not_an_actual_transport_observation=True)
        inputs["transport_probe_readback"] = save(OUTPUT / (slug + "-INERT-transport-config-binding.json"), transport)
        # The exact helper chain has already checked the real opaque config ref.
        # Factory hashes a harmless INERT file instead of reading user config.
        out = CHAIN / (PREFIX + "-" + slug)
        factory.assemble(inputs, out)
        status = store.reference(ref_file(store, out / "factory-status.json"))
        manifest_ref = ref_file(store, out / "upload-manifest.json")
        publication = loader.load(CHAIN / "launcher/publication.py", "inert_whole_publication_" + slug)
        batch_ref = status["publication_batch"]
        batch = store.reference(batch_ref)
        target = Path(batch["directory_readback"]["arguments"]["local_path"])
        need(target.is_relative_to(out) and not target.exists(), "new batch readback nested in literal factory fixture only")
        shutil.copytree(batch["staged_directory"], target)
        shutil.copyfile(inputs["allocation_marker"]["path"], target / "allocation-marker.json")
        destination = batch["directory_readback"]["arguments"]["remote_path"]
        sent = save(OUTPUT / (slug + "-INERT-upload-not-MCP.json"), {"ok": True, "sent": batch["staged_directory"], "to": destination})
        downloaded = save(OUTPUT / (slug + "-INERT-download-not-MCP.json"), {"ok": True, "downloaded": destination, "to": str(target)})
        checks = ref_file(store, OP / "partage-R7-execution-root-01/QUALIFIED-CHECKS-R7-REELS.json")
        readbacks = publication.verify_batch(batch_ref, sent, downloaded, checks)
        ready = out / (PREFIX + "-ready-DO-NOT-UPLOAD.json")
        publication.make_ready(manifest_ref, readbacks, ready)
        bootstrap = loader.load(CHAIN / "launcher/bootstrap_worker.py", "inert_whole_bootstrap_" + slug)
        owner = ref_file(store, OWN / slug / ("results-" + inputs["job_id"]) / "mailbox/OWNER.json")
        projected = bootstrap.dry_run(model=model, phase="roots", job_id=inputs["job_id"],
            output=factory.CACHE_ROOT / ("worker-" + inputs["session_id"]),
            authorization_ref=ref_file(store, out / "authorization-local.json"), codex_config_ref=config_ref,
            owner_ref=owner, cli_policy_ref=inputs["cli_policy"])
        need(projected["verified"] is False and projected["generation_admitted"] is False and projected["execution_performed"] is False,
             "bootstrap must stay dry_run/not admitted")
        projection_ref = save(OUTPUT / (slug + "-BOOTSTRAP-DRY-RUN-NON-ADMIS.json"), projected)
        publications.append({"model": model, "job_id_is_original_historical_metadata_only": inputs["job_id"],
            "factory_output": str(out), "ready_created_only_after_readbacks": ref_file(store, ready),
            "dry_run": projection_ref, "opaque_actual_config_ref_not_read": common["codex_config"],
            "INERT_config_ref": config_ref, "original_transport_generated_by_triplet": original_transport})
    trace.extend([{"step": 6, "function": "factory.assemble -> exact lane/source authorization validators", "status": "composed-INERT", "models": list(MODELS)},
                  {"step": 7, "function": "factory publication.stage_batch -> explicit INERT transport -> verify_batch/readbacks", "status": "composed-INERT"},
                  {"step": 8, "function": "make_ready LAST", "status": "composed-INERT", "publications": publications},
                  {"step": 9, "function": "bootstrap.dry_run", "status": "composed-INERT", "generation_admitted": False}])


if __name__ == "__main__":
    main()

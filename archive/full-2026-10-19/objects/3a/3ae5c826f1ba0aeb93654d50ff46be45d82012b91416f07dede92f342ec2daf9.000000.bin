"""Seal neutral bidirectional control-pipe tests; no native admission."""
from __future__ import annotations

import hashlib
import json
from datetime import UTC, datetime
from pathlib import Path
from xml.etree import ElementTree

ROOT = Path(__file__).resolve().parent
REV, BASE = ROOT / "codex-natif-r7", ROOT / "codex-natif-r6"
PROJECT = ROOT.parents[1] / "work/hpc-forest-harnais-comparaison-r1/project/HPC-Forest"


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def save(path, value, *, new=False):
    with path.open("x" if new else "w", encoding="utf-8", newline="\n") as handle:
        handle.write(json.dumps(value, ensure_ascii=False, indent=2) + "\n")


def main():
    if (REV / "validation-locale.json").exists():
        raise FileExistsError("Already sealed; preserve this revision")
    assert sha(BASE / "validation-locale.json") == "74182e4ab0f078b2a9bda38ff44d1df3895e3d5c10693351fe5f572a4198a13d"
    base = json.loads((BASE / "validation-locale.json").read_bytes())
    assert all(sha(BASE / n) == h for n, h in base["files"].items())
    inherited = list(BASE.glob("*.py"))
    assert len(inherited) == 12 and all(p.read_bytes() == (REV / p.name).read_bytes() for p in inherited)
    sources = json.loads((ROOT / "manifest-source-derivee.json").read_bytes())["files"]
    assert len(sources) == 94 and all(sha(PROJECT / n) == h for n, h in sources.items())
    source_sha = sha(ROOT / "HPC-Forest-Harnais-Comparaison-r1.zip")
    assert source_sha == "9a68a83fde4acb6bd247d79e00490e7d36f0c4c59c6c881152101e4c499387eb"
    suites = list(ElementTree.parse(REV / "tests-finaux.xml").getroot().iter("testsuite"))
    counts = {k: sum(int(s.get(k, 0)) for s in suites) for k in ("tests", "errors", "failures", "skipped")}
    assert counts == {"tests": 239, "errors": 0, "failures": 0, "skipped": 0}, counts
    lint = json.loads((REV / "lint-final.json").read_bytes())
    assert lint["exit_code"] == 0 and "All checks passed" in lint["output"]
    previous = json.loads((ROOT / "MANIFEST-LIVRAISON.json").read_bytes())
    assert all(sha(ROOT / n) == h for n, h in previous["files"].items())
    backup = ROOT / "versions/20261016-avant-session-pipes-r7"
    backup.mkdir(parents=True, exist_ok=False)
    for name in ("REPRISE.md", "suivi-a-faire.json", "MANIFEST-LIVRAISON.json", "SUIVI-AUTOMATISE-ACTUEL.md"):
        (backup / name).write_bytes((ROOT / name).read_bytes())
    proof = {"schema": "hpc-forest-native-control-session-local-validation-v1", "revision": "codex-natif-r7",
             "observed_utc": datetime.now(UTC).isoformat(),
             "base_validation": {"path": str(BASE / "validation-locale.json"),
                                 "sha256": sha(BASE / "validation-locale.json")},
             "base_files_verified": len(base["files"]), "base_python_files_copied_unchanged": 12,
             "prior_root_manifest_files_verified_unchanged": len(previous["files"]),
             "tests_passed": 239, "inherited_tests": 222, "additional_control_session_tests": 17,
             "tests_failed": 0, "tests_skipped": 0, "lint": "Ruff passed",
             "first_session_test_pass": {"passed": 15, "failed": 2,
                                         "cause": "Read-only inspection overlapped this observer checkpoint write"},
             "scope": "Windows pipes and isolated neutral Python JSONL peers; no Codex process",
             "generic_bidirectional_control_pipes_tested": True,
             "decoder_receives_exact_already_synced_stdout_only": True,
             "volatile_queue_bounded_no_replay": True, "late_reply_read_only_reconciliation_tested": True,
             "neutral_child_launches_in_recorded_test_passes": 25,
             "native_process_ownership_verified": False, "exclusive_pipe_access_verified": False,
             "native_owned_launcher_validated": False, "native_codex_rpc_connection_validated": False,
             "native_cli_initialization_handshake_validated": False,
             "native_admission_gate_implemented": False, "native_controller_connected": False,
             "native_default_instructions_verified_live": False,
             "runtime_configuration_isolation_verified": False, "style_and_service_comparability_reviewed": False,
             "per_inference_identity_verified": False, "arm64_native_executor_validated": False,
             "material_read_isolation_proved": False, "power_loss_durability_proved": False,
             "hard_exact_token_cap_proved": False, "native_codex_adapter_validated": False,
             "model_calls": 0, "app_servers_started": 0, "native_executors_started": 0,
             "sockets_opened": 0, "research_jobs_submitted": 0, "contest_program_executions": 0,
             "contest_program_compilations": 0, "source_only_files_verified_unchanged": 94,
             "source_only_zip_sha256": source_sha,
             "files": {p.name: sha(p) for p in sorted(REV.iterdir()) if p.is_file()}}
    save(REV / "validation-locale.json", proof, new=True)
    prefix = ("## Préparation indépendante native r7 — contrôles RPC sur pair neutre\n\n"
              "Lire `codex-natif-r7/REPRISE.md` et sa validation. Douze Python r6 inchangés ; 239 tests "
              "Windows dont 17 supplémentaires, Ruff positif. Lecteur/écrivain/RpcLink raccordés "
              "bidirectionnellement à un pair Python JSONL fictif, file stdout bornée après synchronisation, "
              "stderr séparé et réponse tardive consultable sans renvoi. Deux inspections concurrentes "
              "refusées au premier passage sont conservées ; lecture de contrôle sérialisée ajoutée sans "
              "affaiblir la chaîne du journal. Aucun Codex/app-server/exécuteur/modèle/socket/job nouveau. "
              "Cette preuve générique ne valide ni connexion Codex, handshake natif, lancement/CIM, "
              "exclusivité, instructions, outils ARM64, isolement ou borne de jetons. Les 94 sources et "
              "le ZIP restent inchangés. R1/748782 et GPT96/748383 RUNNING à 19:27 UTC, relais et "
              "coordinateur connus présents ; requêtes natives normales observées, aucun bilan final reçu. "
              "Lire `observation-voies-20261016T1927.json`. Même reprise R1, audit avant arrêt, priorité "
              "source-only puis barrière des 300 issues avant Codex. Aucune donnée de résultat ni "
              "modification de l'article ; ne pas renotifier cette préparation mécanique.\n\n")
    guide = ROOT / "REPRISE.md"
    title, separator, body = guide.read_text(encoding="utf-8").partition("\n")
    guide.write_text(title + separator + "\n" + prefix + body.lstrip("\n"), encoding="utf-8", newline="\n")
    path = ROOT / "suivi-a-faire.json"
    todo = json.loads(path.read_bytes())
    todo.update({"updated_utc": datetime.now(UTC).isoformat(), "native_latest_revision": "codex-natif-r7",
                 "native_latest_revision_local_tests": 239, "native_control_session_additional_tests": 17,
                 "native_generic_bidirectional_control_pipes_tested": True,
                 "native_owned_launcher_validated": False, "native_process_stream_transport_validated": False,
                 "native_live_rpc_pipe_integration_validated": False,
                 "native_cli_initialization_handshake_validated": False,
                 "native_control_session_validation": {"path": str(REV / "validation-locale.json"),
                                                       "sha256": sha(REV / "validation-locale.json")},
                 "existing_native_lanes_latest_observation": {"path": str(ROOT / "observation-voies-20261016T1927.json"),
                    "sha256": sha(ROOT / "observation-voies-20261016T1927.json"),
                    "jobs": ["748782", "748383"], "audited_release_received": False}})
    todo["codex_native"].insert(0, "Révision r7 : 239 tests Windows, contrôles RPC bidirectionnels sur "
                               "Python fictif seulement ; connexion/handshake Codex, lancement/CIM, "
                               "exclusivité et admission restent non validés.")
    save(path, todo)
    print(json.dumps({"revision": "codex-natif-r7", "validation_sha256": sha(REV / "validation-locale.json"),
                      "tests": 239, "sources_unchanged": 94, "previous_manifest_verified": len(previous["files"])},
                     ensure_ascii=True))


if __name__ == "__main__":
    main()

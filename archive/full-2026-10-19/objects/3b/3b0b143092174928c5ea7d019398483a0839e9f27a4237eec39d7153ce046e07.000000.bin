"""Describe exact future cold-reception commands from actual launch metadata; no collection."""
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
READER = HERE.parent
BASE = HERE.parents[3]
FACTORY = BASE / 'outputs/HPC-Forest-Primes-Natif-Lancement-r2f/revision-r1'
PYTHON = BASE / 'work/.venv/Scripts/python.exe'
LAUNCH = FACTORY / 'helper-lancement-possedes/entree_lancement_reel_01.json'
RECEIPT = FACTORY / 'helper-lancement-possedes/lancement_reel_01/LANCEMENTS-POSSEDES-RECUS.json'
SLUGS = {'gpt-6-astra': 'astra-max', 'gpt-5.6-terra': 'terra-max', 'gpt-6.1-sol': 'sol-max'}


def ref(path):
    raw = path.read_bytes()
    return {'path': str(path.resolve()), 'sha256': hashlib.sha256(raw).hexdigest()}


def main():
    launched = json.loads(RECEIPT.read_text('utf8'))
    assert launched['verified'] is True and len(launched['workers']) == 3
    launch_ref = ref(LAUNCH)
    rows = []
    for worker in launched['workers']:
        model, job, session = worker['model'], worker['job_id'], worker['session_id']
        slug = SLUGS[model]
        assert isinstance(job, str) and job.isdigit()
        received = READER / ('reception-' + slug + '-' + job)
        context_name = 'contexte_' + slug.replace('-', '_') + '_' + job
        context = READER / context_name / 'contexte-installation-reelle.json'
        base = '/gpfs/scratch/nimarano/hpc-forest-primes-native-max-r2f-' + session + '/results-' + job
        transfers = [{'tool': 'download_from_romeo', 'arguments': {'remote_path': base + '/' + name,
            'local_path': str(received / name), 'verify': True},
            'save_full_actual_tool_result_as': str(received / result_name)} for name, result_name in (
                ('premier-demarrage-verifie.json', 'transfert-premier-demarrage.json'),
                ('premier-batch-en-attente.json', 'transfert-premier-batch-en-attente.json'))]
        transfers.append({'tool': 'download_from_romeo', 'arguments': {'remote_path': base,
            'local_path': str(received / 'native'), 'verify': False},
            'save_full_actual_tool_result_as': str(received / 'transfert-dossier-resultats.json')})
        prepare = [str(PYTHON), '-I', '-B', str(READER / 'preparer-contexte.py'), '--model', model,
            '--launch-input', launch_ref['path'], '--launch-input-sha256', launch_ref['sha256'],
            '--initial-installation', '<ACTUAL_R4_INSTALLATION_PATH_FOR_' + slug + '>',
            '--initial-installation-sha256', '<ACTUAL_R4_INSTALLATION_SHA256>',
            '--initial-ready', '<ACTUAL_FROZEN_READY_PATH_FOR_' + slug + '>',
            '--initial-ready-sha256', '<ACTUAL_FROZEN_READY_SHA256>',
            '--parent-oauth', '<ACTUAL_PARENT_OAUTH_RECEIPT_PATH>',
            '--parent-oauth-sha256', '<ACTUAL_PARENT_OAUTH_RECEIPT_SHA256>', '--output-name', context_name]
        collect = [str(PYTHON), '-I', '-B', str(READER / 'collecter-frontiere.py'), 'collect',
            '--model', model, '--job', job, '--received-root', str(received),
            '--first-transfer-result', str(received / 'transfert-premier-demarrage.json'),
            '--native-transfer-result', str(received / 'transfert-dossier-resultats.json'),
            '--paused-transfer-result', str(received / 'transfert-premier-batch-en-attente.json')]
        input_name = 'input_' + slug.replace('-', '_') + '_' + job
        build = [str(PYTHON), '-I', '-B', str(READER / 'collecter-frontiere.py'), 'build',
            '--collection', str(received / 'collection-explicite.json'), '--collection-sha256', '<SHA_FROM_ACTUAL_COLLECT_RETURN>',
            '--installation-context', str(context), '--installation-context-sha256', '<SHA_FROM_ACTUAL_CONTEXT_RETURN>',
            '--output-name', input_name]
        audit = [str(PYTHON), '-I', '-B', str(READER / 'controler-reception-bornee.py'),
            '--input', str(READER / (input_name + '.json')), '--input-sha256', '<SHA_FROM_ACTUAL_BUILD_RETURN>',
            '--output', str(READER / ('resultat_' + slug.replace('-', '_') + '_' + job))]
        rows.append({'model': model, 'job_id': job, 'session_id': session,
            'prepare_context_argv_after_actual_initial_receipts': prepare,
            'parent_only_MCP_transfers_after_first_receipt_and_pause_exist': transfers,
            'local_named_collection_argv_after_all_actual_transfers': collect,
            'local_input_build_argv': build, 'local_cold_private_and_scientific_audit_argv': audit,
            'controller_output_flag_is_output_not_output_name': True,
            'all_placeholder_arguments_require_actual_received_refs_and_measured_SHA256': True,
            'publication': {'only_after_actual_successful_bounded_and_private_audits': True,
                'read_generated_actual_proposal': str(READER / ('resultat_' + slug.replace('-', '_') + '_' + job) / 'PUBLICATION-PROPOSEE-NON-EFFECTUEE.json'),
                'order': ['Parent uploads exact audit-cli-prive-digest.json to its original proposed GPFS results path.',
                          'Parent reads back and hashes the exact uploaded projection.',
                          'Parent uploads exact PROPOSITION-autorisation-apres-premier-batch.json to proposed autorisation-apres-premier-batch.json LAST.'],
                'derive_release_paths_and_SHA_from_actual_proposal_never_from_this_recipe': True}})
    value = {'schema': 'hpc-forest-r2f-real-launch-bound-cold-reception-recipe-v1',
        'prepared_only': True, 'executed': False, 'actual_first_NORMAL_or_evaluation_received': False,
        'native_research_or_extension_admitted_by_recipe': False,
        'actual_launch_input': launch_ref, 'actual_owned_launch_receipt': ref(RECEIPT), 'cells': rows,
        'strict_conditions': [
            'Do not collect any active mother nonce before a received first receipt explicitly reconciles it.',
            'Only the exact received reconciled nonce graph may be copied; no cache scan, lock or SQLite.',
            'No raw instruction, model, candidate or 236-path argv is printed or exported.',
            'Canonical GPFS transfer namespace must match received source references; never rewrite paths or bypass MCP refusal.',
            'Any WARN, unknown event, technical failure or mismatched attribution is preserved and blocks automatic release.',
            'The 1800s budget continues during pause; no replay, budget reset or manufactured error.',
            'No publication or model call is performed by this recipe or the cold reader.']}
    target = HERE / 'RECETTE-PREMIER-BATCH-REEL.json'
    with target.open('x', encoding='utf8', newline='\n') as stream:
        stream.write(json.dumps(value, ensure_ascii=False, indent=2) + '\n')
    print(json.dumps(ref(target)))


if __name__ == '__main__':
    main()

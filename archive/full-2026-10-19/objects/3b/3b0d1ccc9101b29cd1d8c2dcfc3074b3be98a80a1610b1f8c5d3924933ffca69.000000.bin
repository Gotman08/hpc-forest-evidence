RAW=P/'qualification-allouee-source110-G-recu-r1/revue-resultats-Q753709-r1/lecteur-r4b/auditer-restauration-existante-r4b.py'
def need(ok,message):
    if not ok: raise ValueError(message)
def sha(data):return hashlib.sha256(data).hexdigest()
primitive=RAW.read_bytes();need(sha(primitive)=='5c1e1784574566a585e2d9cc50f85b52337d10d3109e449a4112581eae68f8d5','Cold read pin')
names={'need','ordinary','metadata','open_nofollow_read','cross_identity','validate_windows_mode_views','native_basic_info','raw'}
nodes=[n for n in ast.parse(primitive).body if isinstance(n,ast.FunctionDef) and n.name in names]
need({n.name for n in nodes}==names,'Own exact cold reader graph')
ns={'Path':Path,'os':os,'stat':stat,'Q':BASE}
exec(compile(ast.Module(body=nodes,type_ignores=[]),str(RAW),'exec'),ns)
before={};cache={}
def read(path,expected=None):
    path=Path(path);need(path.is_relative_to(BASE) and '..' not in path.parts,'Cold source boundary')
    need(path.name.rstrip(' .').casefold() not in {'observer-state.json','observer.lock','worker.lock','stdout.log','stderr.log'},'No live payload')
    data=ns['raw'](path);need(expected is None or sha(data)==expected,'Pinned source mismatch')
    record={'path':str(path),'sha256':sha(data),'bytes':len(data),'metadata':list(ns['metadata'](path.lstat()))}
    need(str(path) not in before or before[str(path)]==record,'Input mutated during review')
    before[str(path)]=record;cache[str(path)]=data;return data
def doc(path,expected=None):return json.loads(read(path,expected))
def ref(path):return {'path':str(path),'sha256':sha(read(path))}
delivery=doc(D/'LIVRAISON-REPRISE-PASSIVE-EXTERNE-R8-NON-EXECUTEE.json','942f678466ffb168a0a6cd82db03f01724b448008d6652115d7df410c4530cd5')
manifest=doc(delivery['manifest']['path'],delivery['manifest']['sha256'])
# Only source/delta/contract documents needed for this bounded review. No full
# workspace/source62 rescan and no runtime/census input is needed or opened.
selected=['CONTRAT-REVUES-ET-ENTREES-NON-ADMISES.json','DELTA-FERME-PREPARATION.json','DIFF-FERME-DERIVEES.patch','REPRISE-ROOT-SEUL-NON-ADMISE.md',
 'copier-quatre-sources-reprise-R8-parent.py','recevoir-paire-observateur-R8-reprise-02.py','cycle-passif-externe-R8.py',
 'test_copie_quatre_sources_reprise_R8_neutre.py','test_reception_paire_R8_reprise_02.py']
for name in selected:read(D/name,manifest['files'][name]['sha256'])
contract=doc(D/selected[0]);delta=doc(D/selected[1]);checks=[]
def definitions(data):return {n.name:ast.dump(n,include_attributes=False) for n in ast.parse(data).body if isinstance(n,(ast.FunctionDef,ast.ClassDef))}
for item in delta['comparisons'][:2]:
    old=read(item['ancestor']['path'],item['ancestor']['sha256']);new=read(item['derived']['path'],item['derived']['sha256'])
    a,b=definitions(old),definitions(new)
    same=[k for k in a if a[k]==b.get(k)];changed=[k for k in a if a[k]!=b.get(k)];added=[k for k in b if k not in a]
    need(same==item['unchanged_definitions'] and changed==item['changed_definitions'] and added==item['new_definitions'],'Independent closed AST delta')
    checks.append({'derived':item['derived'],'unchanged':same,'changed':changed,'added':added})
old_tests=[LIVE/'copie-froide-demarrage-R8-r1/test_copie_quatre_sources_R8_neutre.py',LIVE/'reception-paire-dynamique-r1/revision-r5-snapshots-passifs-sources/test_reception_paire_R8_neutre_r5.py']
new_tests=[D/'test_copie_quatre_sources_reprise_R8_neutre.py',D/'test_reception_paire_R8_reprise_02.py']
def methods(data):return {n.name:ast.dump(n,include_attributes=False) for n in ast.walk(ast.parse(data)) if isinstance(n,ast.FunctionDef) and n.name.startswith('test_')}
test_checks=[]
for old,new,old_count,new_count in zip(old_tests,new_tests,[22,43],[26,47]):
    a,b=methods(read(old)),methods(read(new))
    need(len(a)==old_count and len(b)==new_count and all(b.get(k)==v for k,v in a.items()),'Exact inherited methods and new counts')
    test_checks.append({'source':ref(new),'prepared':new_count,'inherited_AST_identical':old_count,'executed_by_reviewer':0})
for key in contract['actual_future_refs']:need(contract['actual_future_refs'][key] is None,'No future positive metadata fabricated')
copy_text=cache[str(D/'copier-quatre-sources-reprise-R8-parent.py')].decode('utf8')
pair_text=cache[str(D/'recevoir-paire-observateur-R8-reprise-02.py')].decode('utf8')
life_text=cache[str(D/'cycle-passif-externe-R8.py')].decode('utf8')
recipe=cache[str(D/'REPRISE-ROOT-SEUL-NON-ADMISE.md')].decode('utf8')
need("previous['previous_sequence_terminal']['path'])==LIVE/'activation-passive-reelle-root-01/EXECUTION-SEQUENCE-PASSIVE-ROOT.json'" in copy_text,'Copier literal final path finding')
need("intent['previous_sequence_terminal']['path'])==HERE.parent/'activation-passive-reelle-root-01/EXECUTION-SEQUENCE-PASSIVE-ROOT.json'" in pair_text,'Receiver literal final path finding')
need("value.get('schema') == 'hpc-forest-r8-original-passive-sequence-terminal-reception-v1'" in life_text,'Consumer exact different terminal schema')
need('hpc-forest-r8-root-one-passive-sequence-execution-v1' in recipe,'Producer final schema documented separately')
after={}
for p,record in before.items():
    raw=ns['raw'](Path(p));after[p]={'path':p,'sha256':sha(raw),'bytes':len(raw),'metadata':list(ns['metadata'](Path(p).lstat()))};need(after[p]==record,'Final cold source mismatch')
def save(name,value):
    p=OUT/name;data=(json.dumps(value,ensure_ascii=False,indent=2)+'\n').encode('utf8')
    with p.open('xb') as f:f.write(data);f.flush();os.fsync(f.fileno())
    need(ns['raw'](p)==data,'Own receipt reread');return {'path':str(p),'sha256':sha(data),'bytes':len(data)}
inventory=save('INVENTAIRES-REFUS-COPIEUR-RECEPTEUR-AVANT-APRES.json',{'schema':'hpc-forest-r8-resumed-copy-pair-independent-cold-review-inventories-v1','before':list(before.values()),'after':list(after.values()),'count':len(before),'all_bytes_and_full_metadata_unchanged':True})
finding={'id':'TERMINAL-RECEIPT-VS-ORIGINAL-FINALLY-PATH','blocking':True,
 'description':'Both derived mains force previous_sequence_terminal to the immutable original EXECUTION-SEQUENCE-PASSIVE-ROOT.json, then sequence_terminal requires the different new terminal-reception schema. The documented original finally schema is root-one-passive-sequence-execution-v1. A distinct truthful terminal receipt cannot occupy the already preserved original finally path.',
 'locations':{'copier_main_lines':[482,489],'receiver_main_lines':[671,677],'called_terminal_contract_lines':[180,199]},
 'required_resolution':'New isolated derivative must accept exactly a new distinct cold terminal-reception path, bind/re-hash its actual finally/tool-terminal/wrapper/log refs including original finally retained at its original path; do not overwrite/relabel original or weaken schema/actual terminal guards.'}
refs=[]
for family,name in [('copier','REFUS-COPIEUR-REPRISE-R8-PREPARATION.json'),('receiver','REFUS-RECEPTEUR-REPRISE-R8-PREPARATION.json')]:
    receipt={'schema':contract['review_contracts'][family]['schema'],'verified_source_preparation_only':False,'blocking_findings':[finding],
     'reviewed_files':contract['review_contracts'][family]['reviewed_files'],'reviewer':'A /root/cli_role_loader_evidence, independent of current C derivative',
     'created_at_utc':datetime.now(UTC).isoformat(),'cold_inventory':inventory,'delivery':ref(D/'LIVRAISON-REPRISE-PASSIVE-EXTERNE-R8-NON-EXECUTEE.json'),
     'bounded_source_checks':checks,'prepared_test_checks':test_checks,'future_readiness_refs_remain_null':True,
     'scope':'Only copier/receiver delta review. B owns lifecycle/archive/PS review; no whole-cycle approval is emitted.',
     'actions_by_reviewer':{'candidate_imports_main_tests_process_CIM_RPC_CLI_model_calls':0,'live_payload_or_cache_or_lock_reads':0,'qualified_cold_file_IO_used':True,'existing_files_modified':False},
     'automatic_effect_or_restart_or_pair_or_600s_admission':False,'native_generation_admitted':False,'scientific_or_performance_admission':False}
    refs.append(save(name,receipt))
handoff=save('LIVRAISON-REFUS-INTERFACE-TERMINALE-COPIEUR-RECEPTEUR.json',{'schema':'hpc-forest-r8-resumed-copy-pair-independent-refusal-delivery-v1','reviews':refs,'inventory':inventory,'audit_source':{'path':str(Path(__file__)),'sha256':sha(ns['raw'](Path(__file__)))},'new_tests_executed':0,'production_or_native_admission':False})
print(json.dumps({'reviews':refs,'delivery':handoff,'cold_inputs':len(after)}))

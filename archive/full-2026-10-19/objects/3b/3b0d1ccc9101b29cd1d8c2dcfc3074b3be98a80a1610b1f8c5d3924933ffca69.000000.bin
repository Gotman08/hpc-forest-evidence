import ast
import hashlib
import json
import os
import stat
from datetime import UTC, datetime
from pathlib import Path
BASE=Path('C:/Users/nicol/Documents/Codex/2026-10-15/cr')
P=BASE/'outputs/HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r3'
O=P/'operations-parent-premier-roots-source110-r1'
LIVE=O/'preparation-parcours-vivant-R8-r1'
D=LIVE/'reprise-passive-externe-R8-r1'

"""Prepare new source files by closed text/AST derivation only; never execute their mains."""
import ast
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
OP = HERE.parent
PREP = OP.parent
OLD = OP / 'reception-contrats-zero-appel-preparee-r1'
CELL_BASE = OP / 'preparation-parents-R7-bout-en-bout-r1'
CELLS = {
    '754549': ('sol-max', 'gpt-6.1-sol', '80d47d8d3f8f4e35bc26ceb54d06e870', '0c83fb79b4b3c58746625d71a014d46f75abcbfbac408be876bc8e69861c0661'),
    '754550': ('astra-max', 'gpt-6-astra', '29583a77237e4777aa09209331ec7ecd', '3a7230c598803f98902ed2b77b0d92d8269a5a014df98e4b7fca304c209c83e0'),
    '754552': ('terra-max', 'gpt-5.6-terra', '3ae8341d27784c1bbd830ac19e4b77bc', '44506eb366eda82f3109a7335879c69858bcde071048dd9079ba750edac79c56'),
}

def need(ok, message):
    if not ok:
        raise ValueError(message)

def sha(data):
    return hashlib.sha256(data).hexdigest()

def source(name, checksum):
    data = (OLD / name).read_bytes()
    need(sha(data) == checksum, 'Exact historical base changed')
    return data.decode()

def once(text, old, new):
    need(text.count(old) == 1, 'Exact derivation anchor missing: ' + old[:65])
    return text.replace(old, new)

def replace_cells(text, include_marker):
    start = text.index('CELLS = {')
    end = text.index('\n}\n', start) + 3
    cells = {job: values if include_marker else values[:3] for job, values in CELLS.items()}
    return text[:start] + 'CELL_BASE = OP / "preparation-parents-R7-bout-en-bout-r1"\nCELLS = ' + repr(cells) + '\n' + text[end:]

def write_new(name, text):
    ast.parse(text)  # Syntax only; no compile/import/function/main/test.
    path = HERE / name
    with path.open('xb') as stream:
        stream.write(text.encode())
    return {'path': str(path), 'sha256': sha(path.read_bytes())}

old_inspector = source('inventorier-archive-zero-appel-r2.py', '2e18f95da5c7cf6a64c84270fb0d941306b1aa5429451b04fedf0961d22f1930')
inspector = replace_cells(old_inspector, True)
inspector = once(inspector, 'revision-r5-G-recu-avant-Q/launcher/remote_stage.py', 'revision-r7-racines-techniques-neuves/launcher/remote_stage.py')
inspector = once(inspector, '0cfaaab1f96e097bcf54d75403b011bb1b674352999363758af136fb016c8eb2', '08a5353948f9da44e86952137127bbe4f2222c5307b49dde8c1de92cda27f68c')
inspector = once(inspector, 'd08ac00bcfb75625a24971b2684d7479c4da7a98b339e4e10eae5b9ac525ef27', '5c3cc0082589257897caf79caf90c678f931eefcecb823f315ef614f72b9de70')
inspector = once(inspector,
    'expected_archive = OP / slug / "reception-stage-reelle-01" / ("contract-results-" + args.job_id + ".tar.gz")\n    need(args.archive.is_absolute() and args.archive == expected_archive and ".." not in args.archive.parts,',
    'expected_archive_root = CELL_BASE / slug\n    need(args.archive.is_absolute() and args.archive.is_relative_to(expected_archive_root)\n         and args.archive.name == "contract-results-" + args.job_id + ".tar.gz" and ".." not in args.archive.parts,')
inspector = once(inspector, 'marker_path = OP / slug / "reception-stage-reelle-01/allocation-marker.json"', 'marker_path = CELL_BASE / slug / "allocation-marker.json"')
inspector = once(inspector, 'need(sha(raw(STAGE)) == STAGE_SHA, "Actual unchanged staging control-flow source required")',
    'stage_bytes = raw(STAGE)\n    need(sha(stage_bytes) == STAGE_SHA, "Actual unchanged R7 staging control-flow source required")\n    waits = [node.value.value for node in ast.parse(stage_bytes).body if isinstance(node, ast.Assign)\n             and any(isinstance(target, ast.Name) and target.id == "WAIT_SECONDS" for target in node.targets)\n             and isinstance(node.value, ast.Constant)]\n    need(waits == [600], "The original600 second source wait must remain unchanged")')
inspector = once(inspector, 'and marker.get("cache_claims_registry_created") is False,', 'and marker.get("cache_claims_registry_created") is False and marker.get("native_generation_admitted") is False\n         and marker.get("native_root_absent_before_stage") is True,')
inspector = once(inspector, '    need(owner == {"protocol":',
    '    need(type(request.get("expires_at")) in (int, float) and math.isfinite(request["expires_at"])\n         and request["expires_at"] > marker["created_at"], "Actual original request expiry is required; never renew it")\n    need(owner == {"protocol":')
inspector = inspector.replace('hpc-forest-source110-zero-call-cold-archive-inventory-v1', 'hpc-forest-source110-r7-zero-call-cold-archive-inventory-v1')
inspector = once(inspector, '"remote_stage_sha256": STAGE_SHA,', '"remote_stage_sha256": STAGE_SHA, "original_wait_seconds_from_pinned_source": 600,\n             "original_request_expires_at": request["expires_at"], "original_request_bytes_not_rewritten": True,\n             "request_files_published_in_received_mailbox": 0, "response_files_in_received_mailbox": 0,\n             "claim_dispatch_invocation_artifacts_in_received_archive": 0,')
inspector = inspector.replace('INVENTAIRE-ARCHIVE-ZERO-APPEL-R2-', 'INVENTAIRE-ARCHIVE-R7-ZERO-APPEL-')
inspector_ref = write_new('inventorier-archive-R7-zero-appel.py', inspector)

old_receiver = source('recevoir-metadonnees-zero-appel-r3.py', '5b848fcc2e05bea40ef14ba7c282ebe441d5ce872a612084103e57e7cfffd833')
receiver = replace_cells(old_receiver, False)
receiver = once(receiver, 'capacite-preracines-r1/verifier-capacite-preracines.py', 'preparation-parents-R7-bout-en-bout-r1/verifier-capacite-preracines-R7.py')
receiver = once(receiver, '581403d134951fbde8c7b815c9d2c6d3281b09c3c847dc62386d7ea62be8d107', 'fabdcef0475943fa218713af8af6f2f5686bb6b794133640b0eb81e1bd4ef0e1')
receiver = once(receiver, 'inventorier-archive-zero-appel-r2.py', 'inventorier-archive-R7-zero-appel.py')
receiver = once(receiver, '2e18f95da5c7cf6a64c84270fb0d941306b1aa5429451b04fedf0961d22f1930', inspector_ref['sha256'])
receiver = once(receiver, 'd08ac00bcfb75625a24971b2684d7479c4da7a98b339e4e10eae5b9ac525ef27', '5c3cc0082589257897caf79caf90c678f931eefcecb823f315ef614f72b9de70')
receiver = once(receiver, 'revision-r5-G-recu-avant-Q', 'revision-r7-racines-techniques-neuves')
receiver = once(receiver, 'db24bef9282b510642dbc23d527c32f1a5515df9791d255f920d7e326db32180', '5e5d3023ac538ed7197c6cd5da3e68a87e2b95228797af5b7ecbf6250579de95')
receiver = once(receiver, '"fresh_full_cim", "cells"}', '"fresh_full_cim", "cells", "hash_announcement_job_id", "watcher_startup", "watcher_pair_review"}')
receiver = receiver.replace('hpc-forest-source110-zero-call-reception-input-v1', 'hpc-forest-source110-r7-zero-call-reception-input-v1')
receiver = once(receiver, '    ref(INSPECTOR, INSPECTOR_SHA)',
    '    announcement_job = bundle["hash_announcement_job_id"]\n    need(isinstance(announcement_job, str) and announcement_job.isdigit()\n         and announcement_job not in set(CELLS) | {"754337", "754295", "754296", "754299"},\n         "Actual new separate hash-only allocation job required; no historical or native job substitution")\n    ref(INSPECTOR, INSPECTOR_SHA)')
receiver = receiver.replace('== "754337"', '== announcement_job').replace('), "754337", "COMPLETED"', '), announcement_job, "COMPLETED"')
receiver = once(receiver, '    ref(observer, observer_sha); ref(detector, detector_sha)',
    '    ref(observer, observer_sha); ref(detector, detector_sha)\n    registry_ref = ref(CHAIN / "COMPONENTS.json", "dc64e1360ea8c7b061cbda5eb2dc638f7cb76d9f4264c2f062a495c62ba12f30")\n    registry = read(registry_ref)\n    need(len(registry["code_pins"]) == 62, "Exact R7 qualified62 required")\n    for name, checksum in registry["code_pins"].items():\n        ref(CHAIN / name, checksum)\n    source_plan = read(ref(CHAIN / "launcher/pins-source-plan.json"))\n    need(source_plan["source_zip"]["sha256"] == SOURCE and source_plan["plan"]["sha256"] == PLAN, "Exact source110/R7 plan refs")\n    for key in ("source_zip", "plan"):\n        ref(source_plan[key]["path"], source_plan[key]["sha256"])')
receiver = once(receiver, '        archive_ref = supplied["archive"]; ref(archive_ref["path"], archive_ref["sha256"])',
    '        archive_ref = supplied["archive"]\n        archive_path = Path(archive_ref["path"])\n        need(archive_path.is_absolute() and archive_path.is_relative_to(CELL_BASE / slug)\n             and archive_path.name == "contract-results-" + job + ".tar.gz" and ".." not in archive_path.parts,\n             "Exact new R7 archive name below its literal cell directory required")\n        ref(archive_ref["path"], archive_ref["sha256"])')
receiver = receiver.replace('hpc-forest-source110-zero-call-cold-archive-inventory-v1', 'hpc-forest-source110-r7-zero-call-cold-archive-inventory-v1')
receiver = once(receiver, '        # Rehash the actual received archive, not only the inspector\'s report.',
    '        marker_expected = {"path": str(CELL_BASE / slug / "allocation-marker.json"), "sha256": MARKERS[job]}\n        need(facts.get("allocation_marker") == marker_expected\n             and facts.get("remote_stage_sha256") == "08a5353948f9da44e86952137127bbe4f2222c5307b49dde8c1de92cda27f68c"\n             and facts.get("original_wait_seconds_from_pinned_source") == 600\n             and facts.get("original_request_bytes_not_rewritten") is True, "Exact original R7 marker/control-flow/unchanged600s timer")\n        ref(marker_expected["path"], marker_expected["sha256"])\n        # Rehash the actual received archive, not only the inspector\'s report.')
receiver = once(receiver, '            ref(sidecar["path"], sidecar["sha256"])',
    '            need(Path(sidecar["path"]).is_relative_to(CELL_BASE / slug), "Only received sidecars below this literal cell")\n            ref(sidecar["path"], sidecar["sha256"])')
receiver = receiver.replace('hpc-forest-source110-zero-call-technical-terminal-metadata-v1', 'hpc-forest-source110-r7-zero-call-technical-terminal-metadata-v1')
receiver = once(receiver, '            "native_calls_replayed": 0, "response_count": 0,',
    '            "original_request_expires_at": facts["original_request_expires_at"], "original_wait_seconds": 600,\n            "original_request_expiry_not_rewritten_or_renewed": True, "claim_count": 0, "dispatch_count": 0, "unmeasured_invocations": 0,\n            "native_calls_replayed": 0, "response_count": 0,')
receiver = once(receiver, '    output = held["ordinary"](args.output_directory)',
    '    ref(Path(__file__))\n    input_inventory_before = dict(pins)\n    output = held["ordinary"](args.output_directory)')
receiver = receiver.replace('hpc-forest-source110-three-zero-call-technical-reconciliation-v1', 'hpc-forest-source110-r7-three-zero-call-technical-reconciliation-v1')
receiver = once(receiver, '    summary = {"schema":',
    '    input_inventory_after = {path: digest(raw(path)) for path in input_inventory_before}\n    need(input_inventory_before == input_inventory_after, "Original inputs changed across restoration")\n    summary = {"schema":')
receiver = once(receiver, '"responses": 0, "deliveries": 0,', '"claims": 0, "dispatches": 0, "unmeasured_invocations": 0, "responses": 0, "deliveries": 0,')
receiver = once(receiver, '        "observer_and_foreign_processes_preserved": True,',
    '        "observer_and_foreign_processes_preserved": True, "watcher_lifecycle_at_saved_full_census": watcher_lifecycle,\n        "R7_observer_context_automatic_closure_admitted": False, "watcher_stop_or_new_start_admitted": False,\n        "source_components62": registry_ref, "input_inventory_before": input_inventory_before, "input_inventory_after": input_inventory_after,')
marker_literal = repr({job: values[3] for job, values in CELLS.items()})
receiver = once(receiver, '\n\ndef need(ok, message):', '\nMARKERS = ' + marker_literal + '\n\ndef need(ok, message):')
receiver = once(receiver, '    raw, decode, pins = held["raw"], held["decode"], {}',
    '    held_raw, decode, pins = held["raw"], held["decode"], {}\n    def raw(path):\n        path = Path(path)\n        need(path.name.rstrip(" .").casefold() not in {"worker.lock", "observer.lock"}\n             and not path.is_relative_to(PREP / "lancement-modeles-max-r3"), "No operational cache or lock byte read")\n        return held_raw(path)')
watcher = '''    expected_start = {"path": str(OP / "preparation-observation-R7-r1/execution-root-01/LANCEMENT-OBSERVE.json"),
                      "sha256": "7c6438dec3fc2257515113ff4664a68501889676410c4613b235e201475cb38b"}
    expected_review = {"path": str(OP / "preparation-observation-R7-r1/reception-paire-passive-reelle-r1/REVUE-PAIRE-PASSIVE-REELLE-R7.json"),
                       "sha256": "b0a776e4b7943de2ef79bdb0f9d62f329721a781044cdd779c3a544b188055f4"}
    need(bundle["watcher_startup"] == expected_start and bundle["watcher_pair_review"] == expected_review,
         "Only the actual earlier R7 passive start/pair review may anchor lifecycle metadata")
    watcher_start, watcher_review = read(expected_start), read(expected_review)
    need(watcher_review.get("verified_actual_passive_observer_pair") is True and watcher_review.get("native_generation_admitted") is False,
         "Actual independent passive pair metadata required, never an effect authority")
    fields = ("ProcessId", "ParentProcessId", "ExecutablePath", "CommandLine", "CreationDate")
    originals = watcher_start["five_fields"]
    need(len(originals) == 3 and {row["ProcessId"] for row in originals} == {49076, 28544, 36088}, "Exact startup pair plus contextual conhost")
    lifecycle_rows = []
    for original in originals:
        current = next((row for row in rows if row["ProcessId"] == original["ProcessId"]), None)
        if current is None:
            state = "original_full_identity_absent_no_PID_present"
        elif any(current.get(key) is None for key in fields):
            state = "UNKNOWN_opaque_current_identity_preserve_no_effect"
        elif all(current[key] == original[key] for key in fields):
            state = "original_full_identity_present_preserve_no_effect"
        else:
            state = "original_absent_PID_reused_foreign_preserve_no_effect"
        lifecycle_rows.append({"original_identity5": original, "current_identity5": current, "classification": state})
    watcher_lifecycle = {"startup": expected_start, "independent_startup_review": expected_review,
        "current_full_cim": bundle["fresh_full_cim"], "observations": lifecycle_rows,
        "all_three_original_identities_absent": all(row["classification"].startswith("original_full_identity_absent") or row["classification"].startswith("original_absent_PID_reused") for row in lifecycle_rows),
        "effect_authority": False, "no_descendant_service_closure_inferred": True,
        "presence_or_absence_after_saved_census_promised": False}
'''
receiver = once(receiver, '    announcement = read(bundle["hash_announcement"])', watcher + '    announcement = read(bundle["hash_announcement"])')
receiver_ref = write_new('recevoir-metadonnees-R7-zero-appel.py', receiver)

template = {'schema': 'hpc-forest-source110-r7-zero-call-reception-input-v1', 'hash_announcement_job_id': None,
    'hash_announcement': None, 'hash_announcement_job_terminal': None, 'fresh_full_cim': None,
    'watcher_startup': {'path': str(OP / 'preparation-observation-R7-r1/execution-root-01/LANCEMENT-OBSERVE.json'), 'sha256': '7c6438dec3fc2257515113ff4664a68501889676410c4613b235e201475cb38b'},
    'watcher_pair_review': {'path': str(OP / 'preparation-observation-R7-r1/reception-paire-passive-reelle-r1/REVUE-PAIRE-PASSIVE-REELLE-R7.json'), 'sha256': 'b0a776e4b7943de2ef79bdb0f9d62f329721a781044cdd779c3a544b188055f4'},
    'cells': [{'job_id': job, 'archive': None, 'archive_inventory': None, 'download_receipt': None,
               'terminal_status': None, 'terminal_log': None, 'efficiency': None, 'transfer_sidecars': None} for job in CELLS]}
with (HERE / 'ENTREES-R7-NON-ADMISES.json').open('x', encoding='utf8', newline='\n') as stream:
    json.dump(template, stream, ensure_ascii=False, indent=2); stream.write('\n')
def definitions(text):
    return {node.name: ast.dump(node, include_attributes=False) for node in ast.parse(text).body if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))}
closed_delta = {}
for label, old_text, new_text in [('inspector', old_inspector, inspector), ('receiver', old_receiver, receiver)]:
    old_map, new_map = definitions(old_text), definitions(new_text)
    closed_delta[label] = {'unchanged_functions': sorted(name for name in old_map.keys() & new_map.keys() if old_map[name] == new_map[name]),
        'changed_functions': sorted(name for name in old_map.keys() & new_map.keys() if old_map[name] != new_map[name]),
        'added_functions': sorted(new_map.keys() - old_map.keys()), 'removed_functions': sorted(old_map.keys() - new_map.keys())}
value = {'schema': 'hpc-forest-r7-zero-call-preparation-static-derivation-v1', 'bases': {
    'inspector': {'path': str(OLD / 'inventorier-archive-zero-appel-r2.py'), 'sha256': '2e18f95da5c7cf6a64c84270fb0d941306b1aa5429451b04fedf0961d22f1930'},
    'receiver': {'path': str(OLD / 'recevoir-metadonnees-zero-appel-r3.py'), 'sha256': '5b848fcc2e05bea40ef14ba7c282ebe441d5ce872a612084103e57e7cfffd833'}},
    'new_code': {'inspector': inspector_ref, 'receiver': receiver_ref}, 'function_AST_delta': closed_delta,
    'cells': CELLS, 'current_future_pins_NON_ADMIS': ['hash announcement allocation/JSON/log', 'three original archive downloads/threeSHA', 'three terminal status/log/efficiency receipts', 'three actual inspector inventories', 'fresh full ROOT CIM'],
    'new_main_function_test_PSparser_CIM_cache_process_model_or_transport_executed': False,
    'reviewer_disclosure': 'Preparer authored the earlier RX base; a fresh independent code review of this derivative is required.',
    'native_generation_or_OBS4_terminal_route_admitted': False}
with (HERE / 'DELTA-FERME-PREPARATION-R7.json').open('x', encoding='utf8', newline='\n') as stream:
    json.dump(value, stream, ensure_ascii=False, indent=2); stream.write('\n')
print(json.dumps({'inspector': inspector_ref, 'receiver': receiver_ref, 'AST_delta': closed_delta, 'prepared_only': True}))

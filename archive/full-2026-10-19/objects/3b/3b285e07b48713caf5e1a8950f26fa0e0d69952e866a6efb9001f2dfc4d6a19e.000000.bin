import ast,json,hashlib
from pathlib import Path
from datetime import datetime,timezone,timedelta
p=Path('outputs/HPC-Forest-Primes-Natif-Qualification-r1')
s=json.loads((p/'scellement-local.json').read_text())
for n,h in s['files'].items():
    assert hashlib.sha256((p/n).read_bytes()).hexdigest()==h,n
body=(p/'commande-allouee.sh').read_text().split("<<'R2MAX_FINAL_CONTRACT_QUALIFICATION'\n",1)[1].rsplit('\nR2MAX_FINAL_CONTRACT_QUALIFICATION\n',1)[0]
ast.parse(body)
now=datetime.now(timezone.utc)
assert now+timedelta(seconds=11700)<datetime(2026,10,31,23,tzinfo=timezone.utc)
v={'schema':'hpc-forest-primes-r2max-transport-plan-intent-v1','utc':now.isoformat(),'parent_go_received':True,'authorized':['verified bundle upload','one structured job_prepare','plan_get reread'],'forbidden':['job_submit','native inference','installation','retry after ambiguous result'],'command_sha256':s['files']['commande-allouee.sh'],'bundle_sha256':s['bundle_sha256'],'local_ast_parse_passed':True,'neutral_tests_passed':21,'ruff_passed':True,'first_ruff_refusal_preserved':'ruff-premier-passage.log','jobs_submitted':0}
with (p/'autorisation-et-intention-transport.json').open('x',encoding='utf8') as f: json.dump(v,f,indent=2);f.write('\n')
print(json.dumps(v))
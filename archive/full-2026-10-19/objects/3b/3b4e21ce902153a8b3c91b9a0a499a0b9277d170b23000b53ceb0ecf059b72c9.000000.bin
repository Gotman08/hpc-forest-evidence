    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <iostream>\\n#include <vector>\\n#include <cstdio>\\n#include <algorithm>\\n#include <climits>\\n#include <cstdint>\\n#include <omp.h>\\n#include <arm_neon.h>\\n\\n// Fast integer reader using fread buffer (source A)\\nstatic int read_int() {\\n    static char buf[1 << 20];\\n    static size_t pos = 0, len = 0;\\n    while (pos >= len) {\\n        len = fread(buf, 1, sizeof(buf), stdin);\\n        if (!len) return 0; // should not happen\\n        pos = 0;\\n    }\\n    while (buf[pos] < '0' && buf[pos] != '-') {\\n        ++pos;\\n        if (pos >= len) {\\n            len = fread(buf, 1, sizeof(buf), stdin);\\n            if (!len) return 0;\\n            pos = 0;\\n        }\\n    }\\n    bool neg = false;\\n    if (buf[pos] == '-') { neg = true; ++pos; }\\n    int x = 0;\\n    while (true) {\\n        if (pos >= len) {\\n            size_t nread = fread(buf, 1, sizeof(buf), stdin);\\n            if (!nread) break;\\n            pos = 0;\\n            len = nread;\\n        }\\n        char c = buf[pos];\\n        if (c < '0' || c > '9') break;\\n        x = x * 10 + (c - '0');\\n        ++pos;\\n    }\\n    return neg ? -x : x;\\n}\\n\\nint main() {\\n    int n = read_int();\\n    int s = read_int();\\n\\n    // Integral image with stride = n+1, no separate matrix storage (source A)\\n    const int stride = n + 1;\\n    std::vector<int64_t> pref(static_cast<size_t>(stride) * static_cast<size_t>(stride), 0);\\n    int64_t* __restrict__ p = pref.data();\\n\\n    // Build integral image on-the-fly during input reading (source A)\\n    for (int i = 0; i < n; ++i) {\\n        long long row_sum = 0;\\n        int base_cur = (i + 1) * stride;\\n        int base_prev = i * stride;\\n        #pragma ivdep\\n        for (int j = 0; j < n; ++j) {\\n            int val = read_int();\\n            row_sum += val;\\n            p[base_cur + j + 1] = p[base_prev + j + 1] + row_sum;\\n        }\\n    }\\n\\n    // Search phase: parallel over rows with NEON SIMD (sources B, C)\\n    int64_t mxSum = LLONG_MIN;\\n    #pragma omp parallel for reduction(max:mxSum) schedule(static)\\n    for (int i = 0; i <= n - s; ++i) {\\n        const int base_i_ps = i * stride;\\n        const int base_is_ps = (i + s) * stride;\\n\\n        // Process two columns at a time using NEON intrinsics (source B)\\n        int j = 0;\\n        for (; j + 1 <= n - s; j += 2) {\\n            int64x2_t v_a = vld1q_s64(&p[base_is_ps + j + s]);\\n            int64x2_t v_b = vld1q_s64(&p[base_i_ps + j + s]);\\n            int64x2_t v_c = vld1q_s64(&p[base_is_ps + j]);\\n            int64x2_t v_d = vld1q_s64(&p[base_i_ps + j]);\\n\\n            int64x2_t v_sum = vsubq_s64(v_a, v_b);\\n            v_sum = vsubq_s64(v_sum, v_c);\\n            v_sum = vaddq_s64(v_sum, v_d);\\n\\n            const int64_t sum0 = vgetq_lane_s64(v_sum, 0);\\n            const int64_t sum1 = vgetq_lane_s64(v_sum, 1);\\n            if (sum0 > mxSum) mxSum = sum0;\\n            if (sum1 > mxSum) mxSum = sum1;\\n        }\\n\\n        // Handle remaining column if odd number of columns\\n        for (; j <= n - s; ++j) {\\n            const int64_t sub_sum = p[base_is_ps + j + s]\\n                                  - p[base_i_ps + j + s]\\n                                  - p[base_is_ps + j]\\n                                  + p[base_i_ps + j];\\n            if (sub_sum > mxSum) mxSum = sub_sum;\\n        }\\n    }\\n\\n    printf(\\\"%lld\\\\n\\\", static_cast<long long>(mxSum));\\n    return 0;\\n}\\n\",\n      \"path\": \"src/solution.cpp\"\n    }\n  ],\n  \"hypothesis\": \"Integrating fast integer input reading from source A, on-the-fly integral image construction during input (A), OpenMP parallel for reduction over rows in the search phase (B,C) combined with ARM NEON SIMD intrinsics to compute two submatrix sums per iteration within each row (B), and restrict pointers/ivdep pragmas for auto-vectorization hints yields 
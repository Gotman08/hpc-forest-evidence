  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <omp.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Compute the gravitational impact among all pairs of bodies in \n * the system.\n */\nvoid body_force(const float *restrict px, const float *restrict py,\n                const float *restrict pz, float *restrict vx,\n                float *restrict vy, float *restrict vz,\n                float dt, int n) {\n  #pragma omp for schedule(static)\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    const float xi = px[i];\n    const float yi = py[i];\n    const float zi = pz[i];\n\n    #pragma omp simd reduction(+:fx,fy,fz) aligned(px,py,pz:32)\n    for (int j = 0; j < n; ++j) {\n      if (i == j) continue;\n      float dx = px[j] - xi;\n      float dy = py[j] - yi;\n      float dz = pz[j] - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1.0f / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    vx[i] += dt*fx;\n    vy[i] += dt*fy;\n    vz[i] += dt*fz;\n  }\n}\n\n/*\n * Read a binary dataset with initialized bodies.\n */\nvoid read_dataset(int *nbodies,\n                  float **restrict px, float **restrict py, float **restrict pz,\n                  float **restrict vx, float **restrict vy, float **restrict vz) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  // Allocate aligned memory for SoA layout\n  size_t alignment = 32;\n  size_t sz = *nbodies * sizeof(float);\n  if (posix_memalign((void**)px, alignment, sz) != 0 ||\n      posix_memalign((void**)py, alignment, sz) != 0 ||\n      posix_memalign((void**)pz, alignment, sz) != 0 ||\n      posix_memalign((void**)vx, alignment, sz) != 0 ||\n      posix_memalign((void**)vy, alignment, sz) != 0 ||\n      posix_memalign((void**)vz, alignment, sz) != 0) {\n    fprintf(stderr,\"\\nError allocating aligned memory\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  // Read interleaved AoS data and convert to SoA\n  float *tmp = (float*)malloc(*nbodies * 6 * sizeof(float));\n  if (!tmp) {\n    fprintf(stderr,\"\\nError allocating temporary buffer\\n\");\n    exit(EXIT_FAILURE);\n  }\n  b = fread(tmp, *nbodies * 6 * sizeof(float), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    free(tmp);\n    exit(EXIT_FAILURE);\n  }\n\n  for (int i = 0; i < *nbodies; ++i) {\n    (*px)[i] = tmp[i*6 + 0];\n    (*py)[i] = tmp[i*6 + 1];\n    (*pz)[i] = tmp[i*6 + 2];\n    (*vx)[i] = tmp[i*6 + 3];\n    (*vy)[i] = tmp[i*6 + 4];\n    (*vz)[i] = tmp[i*6 + 5];\n  }\n\n  free(tmp);\n}\n\n/*\n * Write simulation results into a binary dataset (AoS format).\n */\nvoid write_dataset(const int nbodies,\n                   const float *restrict px, const float *restrict py,\n                   const float *restrict pz, const float *restrict vx,\n                   const float *restrict vy, const float *restrict vz) {\n  // Convert SoA back to AoS for output\n  float *tmp = (float*)malloc(nbodies * 6 * sizeof(float));\n  if (!tmp) {\n    fprintf(stderr,\"\\nError allocating temporary buffer\\n\");\n    exit(EXIT_FAILURE);\n  }\n  for (int i = 0; i < nbodies; ++i) {\n    tmp[i*6 + 0] = px[i];\n    tmp[i*6 + 1] = py[i];\n    tmp[i*6 + 2] = pz[i];\n    tmp[i*6 + 3] = vx[i];\n    tmp[i*6 + 4] = vy[i];\n    tmp[i*6 + 5] = vz[i];\n  }\n\n  int b = fwrite(tmp, nbodies * 6 * sizeof(float), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    free(tmp);\n    exit(EXIT_FAILURE);\n  }\n\n  free(tmp);\n}\n\nint main(int argc, char **argv) {\n  int nbodies;\n  float *px = NULL, *py = NULL, *pz = NULL;\n  float *vx = NULL, *vy = NULL, *vz = NULL;\n\n  read_dataset(&nbodies, &px, &py, &pz, &vx, &vy, &vz);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    #pragma omp parallel default(none) shared(px,py,pz,vx,vy,vz,nbodies)\n    {\n      body_force(px, py, pz, vx, vy, vz, DT, nbodies);\n\n      #pragma omp for schedule(static)\n      for (int i = 0; i < nbodies; ++i) {\n        px[i] += vx[i] * DT;\n        py[i] += vy[i] * DT;\n        pz[i] += vz[i] * DT;\n      }\n    }\n  }\n\n  write_dataset(nbodies, px, py, pz, vx, vy, vz);\n\n  free(px); free(py); free(pz);\n  free(vx); free(vy); free(vz);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Integrating SoA layout with aligned allocation, restrict pointers, self-interaction skip, OpenMP parallel region per iteration (enclosing both force and position update), worksharing on outer loops, and SIMD reduction on the inner loop will combine the benefits of all three source experiments to achieve further speedup by reducing memory traffic, enabling vectorization, minimizing thread creation overhead, and eliminating redundant computation.",
  "notes": "Combines transformations from A (SoA, restrict, self-skip), B (aligned allocation, SIMD reduction, parallel for on position update), and C (single parallel region per iteration with worksharing). Uses posix_memalign for 32-byte alignment. The inner j-loop includes a conditional skip of i==j to reduce work without affecting correctness.",

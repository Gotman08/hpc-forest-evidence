        "content": "#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n\n/* Maximum size (in char) for neighbors and compute lists */\n#define MAX 100\n\ntypedef struct {\n  int id;\n  float value;\n  char neighbors[MAX];\n} Node;\n\ntypedef struct {\n  int *successor;\n  int *path;\n  float *cost;\n  unsigned char *valid;\n} CostCache;\n\n/* Reads input, allocates memory, writes graph size and node list. Returns the graph. */\nNode* read_input(char* fname, int *n, char* list) {\n  Node* data = NULL;\n  FILE *fl = NULL;\n\n  if (fname == NULL)\n    fl = stdin;\n  else\n    fl = fopen(fname, \"r\");\n\n  if (fl == NULL) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n\n  // header\n  fscanf(fl, \"%d %[^\\n]\", n, list);\n\n  if (*n > 0) {\n    data = (Node*) malloc ((*n)*sizeof(Node));\n    if(data == NULL){\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }\n  }\n\n  for(int i = 0; i < *n; i++)\n    fscanf(fl, \"%d %f %[^\\n]\", &data[i].id, &data[i].value, data[i].neighbors);\n\n  fclose(fl);\n  return data;\n}\n\n/* Returns the index of the node with the given id or -1 if not found */\nint find_by_id(Node g[], int id, int size){\n  int i = 0;\n\n  while((i < size) && g[i].id != id)\n    i++;\n\n  if(i < size)\n    return i;\n\n  return -1;\n}\n\n/* Select using immediate values, preserving the original order and stopping ID. */\nstatic int select_successor(Node *g, int nd, int size) {\n  int next = -1;\n  float max = 0;\n  char aux[MAX];\n  char *auxptr = NULL;\n\n  strcpy(aux, g[nd].neighbors);\n  for(char *t = strtok_r(aux, \" \", &auxptr);\n      t != NULL;\n      t = strtok_r(NULL, \" \", &auxptr)) {\n    int id = atoi(t);\n    int d = find_by_id(g, id, size);\n    if (d >= 0 && max < g[d].value) {\n      max = g[d].value;\n      /* Selecting ID -1 stops traversal even if that ID exists. */\n      next = (id == -1) ? -1 : d;\n    }\n  }\n\n  return next;\n}\n\n/* Discover an uncached path, then evaluate its dependent additions child-first. */\nfloat get_costly(Node *g, int id, int size, CostCache *cache) {\n  int root = find_by_id(g, id, size);\n  if(root < 0)\n    return 0;\n\n  int depth = 0;\n  int nd = root;\n\n  while(nd >= 0 && !cache->valid[nd]) {\n    int next = select_successor(g, nd, size);\n    cache->successor[nd] = next;\n    cache->path[depth++] = nd;\n    nd = next;\n  }\n\n  while(depth > 0) {\n    nd = cache->path[--depth];\n    int next = cache->successor[nd];\n    float r = g[nd].value;\n\n    /* A terminal value is copied, not added to zero. */\n    if(next >= 0)\n      r += cache->cost[next];\n\n    cache->cost[nd] = r;\n    cache->valid[nd] = 1;\n  }\n\n  return cache->cost[root];\n}\n\n/* Main program - calls read input, computes sum for each node in the list, prints output */\nint main() {\n  char *fileN = NULL;\n  char computelist[MAX];\n  int n = -1;\n  Node* input = NULL;\n  CostCache cache = {0};\n\n  input = read_input(fileN, &n, computelist);\n\n  if(n > 0) {\n    size_t count = (size_t)n;\n    cache.successor = (int*)malloc(count * sizeof(*cache.successor));\n    cache.path = (int*)malloc(count * sizeof(*cache.path));\n    cache.cost = (float*)malloc(count * sizeof(*cache.cost));\n    cache.valid = (unsigned char*)calloc(count, sizeof(*cache.valid));\n    if(cache.successor == NULL || cache.path == NULL ||\n       cache.cost == NULL || cache.valid == NULL) {\n      fprintf(stderr, \"Error!\\n\");\n      free(cache.successor);\n      free(cache.path);\n      free(cache.cost);\n      free(cache.valid);\n      free(input);\n      return 1;\n    }\n  }\n\n  // process\n  for(char *c = strtok(computelist, \" \"); c != NULL; c = strtok(NULL, \" \"))\n    printf(\"%s: %f\\n\", c, get_costly(input, atoi(c), n, &cache));\n\n  free(cache.successor);\n  free(cache.path);\n  free(cache.cost);\n  free(cache.valid);\n  free(input);\n\n  return 0;\n}\n",
        "path": "src/graph.c"
      }
    ],

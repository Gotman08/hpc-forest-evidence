{"files":[{"content":"#ifndef _POSIX_C_SOURCE\n#define _POSIX_C_SOURCE 200809L\n#endif\n\n#include <ctype.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <sys/types.h>\n\ntypedef struct {\n  int id;\n  float value;\n  size_t neighbor_offset;\n  int next;\n  float cost;\n  unsigned char next_ready;\n  unsigned char state;\n} Node;\n\ntypedef struct {\n  char *data;\n  size_t size;\n  size_t capacity;\n} TextList;\n\ntypedef struct {\n  char *text;\n  int id;\n} Query;\n\ntypedef struct {\n  Query *data;\n  size_t size;\n  size_t capacity;\n  char *storage;\n} QueryList;\n\ntypedef struct {\n  int key;\n  int index;\n} IdSlot;\n\ntypedef struct {\n  IdSlot *slots;\n  size_t mask;\n} IdMap;\n\nstatic void fail(void) {\n  fprintf(stderr, \"Error!%c\", 10);\n  exit(1);\n}\n\nstatic void *allocate(size_t count, size_t item_size) {\n  void *result;\n\n  if (item_size != 0 && count > ((size_t)-1) / item_size)\n    fail();\n  result = malloc(count * item_size);\n  if (result == NULL)\n    fail();\n  return result;\n}\n\nstatic void *allocate_zero(size_t count, size_t item_size) {\n  void *result;\n\n  if (item_size != 0 && count > ((size_t)-1) / item_size)\n    fail();\n  result = calloc(count, item_size);\n  if (result == NULL)\n    fail();\n  return result;\n}\n\nstatic void *resize_array(void *pointer, size_t count, size_t item_size) {\n  void *result;\n\n  if (item_size != 0 && count > ((size_t)-1) / item_size)\n    fail();\n  result = realloc(pointer, count * item_size);\n  if (result == NULL)\n    fail();\n  return result;\n}\n\nstatic char *copy_string(const char *source) {\n  size_t length;\n  char *copy;\n\n  length = strlen(source);\n  if (length == (size_t)-1)\n    fail();\n  copy = allocate(length + 1, sizeof(*copy));\n  memcpy(copy, source, length + 1);\n  return copy;\n}\n\nstatic size_t next_capacity(size_t current, size_t minimum) {\n  size_t capacity;\n\n  capacity = current == 0 ? 64 : current;\n  while (capacity < minimum) {\n    if (capacity > ((size_t)-1) / 2) {\n      capacity = minimum;\n      break;\n    }\n    capacity *= 2;\n  }\n  return capacity;\n}\n\nstatic size_t text_list_append(TextList *list, const char *text) {\n  size_t length;\n  size_t required;\n  size_t offset;\n  size_t capacity;\n\n  length = strlen(text);\n  if (length == (size_t)-1 ||\n      list->size > ((size_t)-1) - length - 1)\n    fail();\n\n  required = list->size + length + 1;\n  if (required > list->capacity) {\n    capacity = next_capacity(list->capacity, required);\n    list->data = resize_array(list->data, capacity, sizeof(*list->data));\n    list->capacity = capacity;\n  }\n\n  offset = list->size;\n  memcpy(list->data + offset, text, length + 1);\n  list->size = required;\n  return offset;\n}\n\nstatic void query_list_push(QueryList *list, char *text, int id) {\n  size_t capacity;\n\n  if (list->size == list->capacity) {\n    if (list->size == (size_t)-1)\n      fail();\n    capacity = next_capacity(list->capacity, list->size + 1);\n    list->data = resize_array(list->data, capacity, sizeof(*list->data));\n    list->capacity = capacity;\n  }\n\n  list->data[list->size].text = text;\n  list->data[list->size].id = id;\n  ++list->size;\n}\n\nstatic const char *skip_space(const char *text) {\n  while (*text != 0 && isspace((unsigned char)*text))\n    ++text;\n  return text;\n}\n\nstatic const char *read_int(const char *text, int *value) {\n  char *end;\n  long parsed;\n\n  text = skip_space(text);\n  if (*text == 0)\n    return NULL;\n  parsed = strtol(text, &end, 10);\n  if (end == text)\n    return NULL;\n  *value = (int)parsed;\n  return end;\n}\n\nstatic const char *read_float(const char *text, float *value) {\n  char *end;\n\n  text = skip_space(text);\n  if (*text == 0)\n    return NULL;\n  *value = strtof(text, &end);\n  if (end == text)\n    return NULL;\n  return end;\n}\n\nstatic void read_input(Node **out_nodes, int *out_count,\n                       TextList *neighbors, QueryList *queries) {\n  char *line;\n  size_t line_capacity;\n  char *header;\n  const char *cursor;\n  const char *after;\n  Node *nodes;\n  char *text;\n  int count;\n  int id;\n  int i;\n\n  line = NULL;\n  line_capacity = 0;\n  if (getline(&line, &line_capacity, stdin) < 0)\n    fail();\n\n  header = copy_string(line);\n  cursor = header;\n  cursor = read_int(cursor, &count);\n  if (cursor == NULL || count < 0)\n    fail();\n\n  queries->storage = header;\n  for (;;) {\n    cursor = skip_space(cursor);\n    if (*cursor == 0)\n      break;\n\n    text = (char *)cursor;\n    after = read_int(cursor, &id);\n    if (after == NULL)\n      fail();\n    if (*after != 0) {\n      *((char *)after) = 0;\n      cursor = after + 1;\n    } else {\n      cursor = after;\n    }\n    query_list_push(queries, text, id);\n  }\n\n  nodes = NULL;\n  if (count > 0)\n    nodes = allocate_zero((size_t)count, sizeof(*nodes));\n\n  for (i = 0; i < count; ++i) {\n    if (getline(&line, &line_capacity, stdin) < 0)\n      fail();\n\n    cursor = line;\n    after = read_int(cursor, &nodes[i].id);\n    if (after == NULL)\n      fail();\n    after = read_float(after, &nodes[i].value);\n    if (after == NULL)\n      fail();\n\n    cursor = skip_space(after);\n    nodes[i].neighbor_offset = text_list_append(neighbors, cursor);\n  }\n\n  free(line);\n  *out_nodes = nodes;\n  *out_count = count;\n}\n\nstatic size_t hash_id(int id) {\n  uint32_t value;\n\n  value = (uint32_t)id;\n  value ^= value >> 16;\n  value *= UINT32_C(0x7feb352d);\n  value ^= value >> 15;\n  value *= UINT32_C(0x846ca68b);\n  value ^= value >> 16;\n  return (size_t)value;\n}\n\nstatic void map_insert_first(IdMap *map, int key, int index) {\n  size_t position;\n\n  position = hash_id(key) & map->mask;\n  while (map->slots[position].index >= 0) {\n    if (map->slots[position].key == key)\n      return;\n    position = (position + 1) & map->mask;\n  }\n\n  map->slots[position].key = key;\n  map->slots[position].index = index;\n}\n\nstatic int map_find(const IdMap *map, int key) {\n  size_t position;\n\n  position = hash_id(key) & map->mask;\n  while (map->slots[position].index >= 0) {\n    if (map->slots[position].key == key)\n      return map->slots[position].index;\n    position = (position + 1) & map->mask;\n  }\n  return -1;\n}\n\nstatic IdMap make_id_map(const Node *nodes, int count) {\n  IdMap map;\n  size_t capacity;\n  size_t required;\n  size_t i;\n\n  if (count < 0 || (size_t)count > ((size_t)-1) / 2)\n    fail();\n\n  required = (size_t)count * 2;\n  capacity = 16;\n  while (capacity < required) {\n    if (capacity > ((size_t)-1) / 2)\n      fail();\n    capacity *= 2;\n  }\n\n  map.slots = allocate(capacity, sizeof(*map.slots));\n  map.mask = capacity - 1;\n  for (i = 0; i < capacity; ++i)\n    map.slots[i].index = -1;\n\n  for (i = 0; i < (size_t)count; ++i)\n    map_insert_first(&map, nodes[i].id, (int)i);\n\n  return map;\n}\n\nstatic void free_id_map(IdMap *map) {\n  free(map->slots);\n}\n\nstatic int choose_successor(Node *nodes, const TextList *neighbors,\n                            const IdMap *map, int index) {\n  Node *node;\n  const char *cursor;\n  const char *after;\n  float maximum;\n  int selected_id;\n  int selected_index;\n  int neighbor_id;\n  int candidate;\n\n  node = &nodes[index];\n  if (node->next_ready)\n    return node->next;\n\n  maximum = 0.0f;\n  selected_id = -1;\n  selected_index = -1;\n  cursor = neighbors->data + node->neighbor_offset;\n\n  for (;;) {\n    after = read_int(cursor, &neighbor_id);\n    if (after == NULL)\n      break;\n\n    candidate = map_find(map, neighbor_id);\n    if (candidate >= 0 && maximum < nodes[candidate].value) {\n      maximum = nodes[candidate].value;\n      selected_id = neighbor_id;\n      selected_index = candidate;\n    }\n    cursor = after;\n  }\n\n  node->next = selected_id == -1 ? -1 : selected_index;\n  node->next_ready = 1;\n  return node->next;\n}\n\nstatic float get_cost(Node *nodes, const TextList *neighbors,\n                      const IdMap *map, int start, int *stack) {\n  size_t depth;\n  int current;\n  int index;\n  Node *node;\n  float total;\n\n  depth = 0;\n  current = start;\n  while (current >= 0 && nodes[current].state == 0) {\n    nodes[current].state = 1;\n    stack[depth++] = current;\n    current = choose_successor(nodes, neighbors, map, current);\n  }\n\n  while (depth != 0) {\n    index = stack[--depth];\n    node = &nodes[index];\n    total = node->value;\n    if (node->next >= 0)\n      total += nodes[node->next].cost;\n    node->cost = total;\n    node->state = 2;\n  }\n\n  return nodes[start].cost;\n}\n\nint main(void) {\n  Node *nodes;\n  TextList neighbors = { NULL, 0, 0 };\n  QueryList queries = { NULL, 0, 0, NULL };\n  IdMap map;\n  int *stack;\n  int count;\n  size_t i;\n  int index;\n  float result;\n\n  nodes = NULL;\n  stack = NULL;\n  count = 0;\n  read_input(&nodes, &count, &neighbors, &queries);\n  map = make_id_map(nodes, count);\n\n  if (count > 0)\n    stack = allocate((size_t)count, sizeof(*stack));\n\n  for (i = 0; i < queries.size; ++i) {\n    index = map_find(&map, queries.data[i].id);\n    result = 0.0f;\n    if (index >= 0)\n      result = get_cost(nodes, &neighbors, &map, index, stack);\n    printf(\"%s: %f%c\", queries.data[i].text, result, 10);\n  }\n\n  free(stack);\n  free_id_map(&map);\n  free(nodes);\n  free(neighbors.data);\n  free(queries.data);\n  free(queries.storage);\n  return 0;\n}\n","path":"src/graph.c"}],"hypothesis":"Lazy functional-DAG compilation should remove repeated dependency-bound path walks, parsing, and ID scans while preserving the ordered greedy recurrence and child-before-parent float additions.","notes":"No integration source IDs were supplied. The recurrence is intentionally not SIMD-reduced: strict first-maximum selection, the raw -1 successor sentinel, and float addition order remain scalar and ordered.","sources_kept":[],"transformations":["Use compact dynamic neighbor storage and a first-occurrence open-addressed ID map instead of repeated linear searches and copied token buffers.","Resolve each reachable greedy successor once, then memoize its chain sum with an iterative backward stack that respects graph dependencies."]}
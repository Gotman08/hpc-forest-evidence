    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\ntypedef struct {\\n    float d;\\n    char label;\\n    int idx;\\n} Candidate;\\n\\nstatic int compare_candidates(const void *a, const void *b) {\\n    const Candidate *ca = (const Candidate *)a;\\n    const Candidate *cb = (const Candidate *)b;\\n    if (ca->d < cb->d) return -1;\\n    if (ca->d > cb->d) return 1;\\n    return ca->idx - cb->idx;\\n}\\n\\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n    long total_points = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        total_points += groups[i].length;\\n    }\\n\\n    float *xs = (float *)malloc(sizeof(float) * total_points);\\n    float *ys = (float *)malloc(sizeof(float) * total_points);\\n    char *ls = (char *)malloc(sizeof(char) * total_points);\\n\\n    long idx = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n        for (int j = 0; j < g.length; j++) {\\n            xs[idx] = g.points[j].x;\\n            ys[idx] = g.points[j].y;\\n            ls[idx] = g.label;\\n            idx++;\\n        }\\n    }\\n\\n#ifdef _OPENMP\\n    int nthreads = omp_get_max_threads();\\n#else\\n    int nthreads = 1;\\n#endif\\n\\n    Candidate *cand = (Candidate *)malloc(sizeof(Candidate) * nthreads * k);\\n    for (int t = 0; t < nthreads * k; t++) {\\n        cand[t].d = -1.0f;\\n        cand[t].label = (char)-1;\\n        cand[t].idx = -1;\\n    }\\n\\n#ifdef _OPENMP\\n#pragma omp parallel\\n    {\\n        int tid = omp_get_thread_num();\\n        Candidate *local = &cand[tid * k];\\n\\n#pragma omp for schedule(static)\\n        for (long i = 0; i < total_points; i++) {\\n            Point p;\\n            p.x = xs[i];\\n            p.y = ys[i];\\n            float d = euclidean_distance_no_sqrt(to_evaluate, p);\\n\\n            for (int x = 0; x < k; x++) {\\n                if (d < local[x].d || local[x].d == -1.0f) {\\n                    for (int y = k - 1; y > x; y--) {\\n                        local[y] = local[y - 1];\\n                    }\\n                    local[x].d = d;\\n                    local[x].label = ls[i];\\n                    local[x].idx = (int)i;\\n                    break;\\n                }\\n            }\\n        }\\n    }\\n#else\\n    Candidate *local = &cand[0];\\n    for (long i = 0; i < total_points; i++) {\\n        Point p;\\n        p.x = xs[i];\\n        p.y = ys[i];\\n        float d = euclidean_distance_no_sqrt(to_evaluate, p);\\n        for (int x = 0; x < k; x++) {\\n            if (d < local[x].d || local[x].d == -1.0f) {\\n                for (int y = k - 1; y > x; y--) {\\n                    local[y] = local[y - 1];\\n                }\\n                local[x].d = d;\\n                local[x].label = ls[i];\\n                local[x].idx = (int)i;\\n                break;\\n            }\\n        }\\n    }\\n#endif\\n\\n    Candidate *all = (Candidate *)malloc(sizeof(Candidate) * nthreads * k);\\n    int count = 0;\\n    for (int t = 0; t < nthreads; t++) {\\n        for (int j = 0; j < k; j++) {\\n            if (cand[t * k + j].d != -1.0f) {\\n                all[count++] = cand[t * k + j];\\n            }\\n        }\\n    }\\n\\n    qsort(all, count, sizeof(Candidate), compare_candidates);\\n\\n    char *labels = (char *)malloc(sizeof(char) * k);\\n    int real_count = count < k ? count : k;\\n    for (int i = 0; i < real_count; i++) {\\n        labels[i] = all[i].label;\\n    }\\n    for (int i = real_count; i < k; i++) {\\n        labels[i] = (char)-1;\\n    }\\n\\n    qsort(labels, k, sizeof(char), compare_for_sort);\\n\\n    char most_frequent = labels[0];\\n    int most_frequent_count = 1;\\n    int current_frequency = 1;\\n\\n    for (int i = 1; i < k; i++) {\\n        if (labels[i] != labels[i - 1]) {\\n            if (current_frequency > most_frequent_count) {\\n                most_frequent = labels[i - 1];\\n                most_frequent_count = current_frequency;\\n            }\\n            current_frequency = 1;\\n        } else {\\n            current_frequency++;\\n        }\\n\\n        if (i == k - 1 && current_frequency > most_frequent_count) {\\n            most_frequent = labels[i - 1];\\n            most_frequent_count = current_frequency;\\n        }\\n    }\\n\\n    free(xs);\\n    free(ys);\\n    free(ls);\\n    free(cand);\\n    free(all);\\n    free(labels);\\n\\n    return most_frequent;\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Parallelize distance computation across all points using OpenMP static scheduling with per-thread top-k candidate lists; merge by (distance, original index) to preserve exact tie-breaking of sequential insertion.\",\n  \"notes\": \"Only src/knn.c was modified. The header and main remain unchanged. Per-thread local top-k arrays use the same strict-less-than insertion rule as the baseline, so within each contiguous chunk the earliest equal-distance point is kept. Merging sorts all surviving candidates by (distance, original index) and takes the first k, which reproduces the sequential selection order exactly. Missing slots are filled with -1 sentinels before qsort on labels, matching the reference behavior.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Flatten point data into contiguous xs/ys/labels arrays for cache-friendly parallel access\",\n    \"Use OpenMP parallel-for with static schedule over flattened point indices\",\n    \"Each thread maintains a private top-k candidate array using the same insertion logic as baseline\",\n    \"Merge per-thread candidates by sorting on (distance, original index) and take first k to reproduce sequential selection order\"\n  ]\n}",

        "content": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <iterator>\n#include <string>\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ' )\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v') ;\n    }\n} ;\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase\n        ( std::remove_if\n            ( text.begin ()\n            , text.end ()\n            , IsWhitespace () )\n        , text.end () ) ;\n    return text ;\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator <char> begin (in), end ;\n    std::string text (begin, end) ;\n    text = remove_whitespaces (text) ;\n    return text ;\n}\n\nclass PermutationOutput\n{\n    static constexpr std::size_t capacity = 64 * 1024 ;\n    char buffer_[capacity] ;\n    std::size_t record_size_ ;\n    std::size_t block_size_ ;\n    std::size_t used_ ;\n\n    auto append (char c) -> void\n    {\n        if (used_ == capacity) flush () ;\n        buffer_[used_++] = c ;\n    }\n\npublic:\n    explicit PermutationOutput (std::size_t symbol_count)\n        : record_size_ (0), block_size_ (capacity), used_ (0)\n    {\n        if (symbol_count <= (capacity - 4) / 2) {\n            record_size_ = 2 * symbol_count + 4 ;\n            block_size_ = (capacity / record_size_) * record_size_ ;\n            std::fill (buffer_, buffer_ + block_size_, ' ') ;\n            for (std::size_t offset = 0; offset < block_size_;\n                 offset += record_size_) {\n                buffer_[offset] = '[' ;\n                buffer_[offset + record_size_ - 2] = ']' ;\n                buffer_[offset + record_size_ - 1] = '\\n' ;\n            }\n        }\n    }\n\n    auto write (const std::string& text) -> void\n    {\n        if (record_size_ != 0) {\n            char* destination = buffer_ + used_ + 2 ;\n            for (char c : text) {\n                *destination = c ;\n                destination += 2 ;\n            }\n            used_ += record_size_ ;\n            if (used_ == block_size_) flush () ;\n            return ;\n        }\n\n        append ('[') ;\n        append (' ') ;\n        for (char c : text) {\n            append (c) ;\n            append (' ') ;\n        }\n        append (']') ;\n        append ('\\n') ;\n    }\n\n    auto flush () -> void\n    {\n        if (used_ != 0) {\n            std::cout.write\n                (buffer_, static_cast<std::streamsize> (used_)) ;\n            used_ = 0 ;\n        }\n    }\n} ;\n\nint main (int argc, char const *argv [])\n{\n    std::string text = read_text_from_stdin <std::string> (std::cin) ;\n    if (text.empty ()) return 0 ;\n\n    std::sort (text.begin (), text.end ()) ;\n    PermutationOutput output (text.size ()) ;\n    do {\n        output.write (text) ;\n    } while (std::next_permutation (text.begin (), text.end ())) ;\n    output.flush () ;\n    return 0 ;\n}\n",
        "path": "src/permutations.cc"
      }

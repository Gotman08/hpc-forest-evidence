  "command": "bash -c 'set -euo pipefail\narchive=/scratch_p/nimarano/hpc-forest-gpt61sol-max-harness-20261015-r2.tar.gz\nroot=/scratch_p/nimarano/hpc-forest-gpt61sol-max-harness-20261015-r2-launchfix1\npy=/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python\ntest ! -e \"$root\"\nprintf '\"'\"'%s  %s\\n'\"'\"' '\"'\"'ac88d47bdcd4ac65f27f797b01d7b8f730eed46975e1391757cdd2a258109aeb'\"'\"' \"$archive\" | sha256sum -c -\nmkdir \"$root\"\ntar -xzf \"$archive\" --strip-components=1 -C \"$root\"\n\"$py\" - \"$root\" <<'\"'\"'PY'\"'\"'\nimport hashlib,json,os,platform,shutil,stat,sys,zipfile\nfrom pathlib import Path\nroot=Path(sys.argv[1])\nmanifest=json.loads((root/'\"'\"'payload-manifest.json'\"'\"').read_text())\nfor name,expected in manifest['\"'\"'files'\"'\"'].items():\n    assert (root/name).resolve().is_relative_to(root.resolve())\n    assert hashlib.sha256((root/name).read_bytes()).hexdigest()==expected,name\nproject=root/'\"'\"'project'\"'\"'\nwith zipfile.ZipFile(root/'\"'\"'project.zip'\"'\"') as z:\n    for info in z.infolist():\n        assert info.filename.startswith('\"'\"'HPC-Forest/'\"'\"') and not stat.S_ISLNK(info.external_attr >> 16)\n        target=project/info.filename.removeprefix('\"'\"'HPC-Forest/'\"'\"')\n        assert target.resolve().is_relative_to(project.resolve())\n        if info.is_dir():target.mkdir(parents=True,exist_ok=True)\n        else:\n            target.parent.mkdir(parents=True,exist_ok=True)\n            target.write_bytes(z.read(info))\nfor name,expected in json.loads((project/'\"'\"'FILES.sha256.json'\"'\"').read_text()).items():\n    assert hashlib.sha256((project/name).read_bytes()).hexdigest()==expected,name\nshutil.copytree(project/'\"'\"'src/hpc_forest'\"'\"',root/'\"'\"'runtime/hpc_forest'\"'\"')\nshutil.copytree(project/'\"'\"'tests'\"'\"',root/'\"'\"'tests'\"'\"')\nshutil.copytree(project/'\"'\"'examples'\"'\"',root/'\"'\"'examples'\"'\"')\nfor p in (project/'\"'\"'examples/marathon22'\"'\"').iterdir():\n    if p.is_file():shutil.copyfile(p,root/p.name)\nofficial=root/'\"'\"'sources-officielles'\"'\"'\nofficial.mkdir()\nfor name,expected in manifest['\"'\"'official_files'\"'\"'].items():\n    original=Path('\"'\"'/scratch_p/nimarano/hpc-forest-marathon22-20261015-r1/sources-officielles'\"'\"')/name\n    shutil.copyfile(original,official/name)\n    assert hashlib.sha256((official/name).read_bytes()).hexdigest()==expected,name\nresources={'\"'\"'machine'\"'\"':platform.machine(),'\"'\"'affinity_cpus'\"'\"':sorted(os.sched_getaffinity(0)),\n    '\"'\"'slurm_job_id'\"'\"':os.environ.get('\"'\"'SLURM_JOB_ID'\"'\"'),'\"'\"'slurm_cpus_per_task'\"'\"':os.environ.get('\"'\"'SLURM_CPUS_PER_TASK'\"'\"'),\n    '\"'\"'slurm_memory_mb'\"'\"':os.environ.get('\"'\"'SLURM_MEM_PER_NODE'\"'\"'),'\"'\"'candidate_gpus'\"'\"':0,\n    '\"'\"'disk_free_bytes'\"'\"':shutil.disk_usage(root).free}\n(root/'\"'\"'resources-romeo.json'\"'\"').write_text(json.dumps(resources,indent=2)+'\"'\"'\\n'\"'\"')\nprint('\"'\"'Verified frozen source, payload and official inputs'\"'\"',flush=True)\nPY\nexport PYTHONPATH=\"$root/runtime:$root/qa-deps\"\nexport PYTHONDONTWRITEBYTECODE=1\nexport PYTEST_DISABLE_PLUGIN_AUTOLOAD=1\nexport OPENBLAS_NUM_THREADS=1\nflock -w 120 /tmp/hpc-forest-preflight-nimarano.lock \"$py\" -m pytest \"$root/tests\" -q -p no:cacheprovider --junitxml=\"$root/preflight-junit.xml\" > \"$root/preflight-tests.log\" 2>&1\ncat \"$root/preflight-tests.log\"\n\"$py\" \"$root/timer_probe.py\" \"$root/timer-probe.json\"\nexec \"$py\" -u \"$root/romeo_harness_comparison.py\" --root \"$root\" --session-id e102a585de23492ca9019858dac5af4d --worker-wait-seconds 600\n'",

{
  "src/knn.c": "#include \"knn.h\"\n#include <limits.h>\n\nstatic char choose_label(const int * frequencies) {\n    char best_label = (char)-1;\n    int best_count = 0;\n\n    for (int value = CHAR_MIN; value <= CHAR_MAX; ++value) {\n        int count = frequencies[(unsigned char)(char)value];\n        if (count > best_count) {\n            best_count = count;\n            best_label = (char)value;\n        }\n    }\n\n    return best_label;\n}\n\nstatic char insertion_selection(int n_groups, Group * groups, int k,\n                                Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    for (int i = 0; i < k; ++i) {\n        labels[i] = (char)-1;\n        distances[i] = -1;\n    }\n\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n\n        for (int j = 0; j < g.length; ++j) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            for (int x = 0; x < k; ++x) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (int y = k - 1; y > x; --y) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    int frequencies[UCHAR_MAX + 1] = {0};\n    for (int i = 0; i < k; ++i) {\n        ++frequencies[(unsigned char)labels[i]];\n    }\n\n    free(distances);\n    free(labels);\n    return choose_label(frequencies);\n}\n\nstatic void sift_down(float * heap, size_t count, size_t root) {\n    float value = heap[root];\n\n    while (root < count / 2) {\n        size_t child = root * 2 + 1;\n        if (child + 1 < count && heap[child] < heap[child + 1]) {\n            ++child;\n        }\n\n        if (!(value < heap[child])) {\n            break;\n        }\n\n        heap[root] = heap[child];\n        root = child;\n    }\n\n    heap[root] = value;\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    if (k <= 0) {\n        return (char)-1;\n    }\n\n    size_t capacity = (size_t)k;\n    float * heap = (float *) malloc(sizeof(float) * capacity);\n    size_t used = 0;\n\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n\n        for (int j = 0; j < g.length; ++j) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            if (d != d) {\n                free(heap);\n                return insertion_selection(n_groups, groups, k, to_evaluate);\n            }\n\n            if (used < capacity) {\n                heap[used++] = d;\n\n                if (used == capacity) {\n                    for (size_t parent = used / 2; parent > 0; --parent) {\n                        sift_down(heap, used, parent - 1);\n                    }\n                }\n            } else if (d < heap[0]) {\n                heap[0] = d;\n                sift_down(heap, used, 0);\n            }\n        }\n    }\n\n    float cutoff = 0.0f;\n    size_t tied_slots = 0;\n\n    if (used == capacity) {\n        cutoff = heap[0];\n        for (size_t i = 0; i < used; ++i) {\n            if (heap[i] == cutoff) {\n                ++tied_slots;\n            }\n        }\n    }\n\n    free(heap);\n\n    int frequencies[UCHAR_MAX + 1] = {0};\n\n    if (used < capacity) {\n        for (int i = 0; i < n_groups; ++i) {\n            if (groups[i].length > 0) {\n                frequencies[(unsigned char)groups[i].label] += groups[i].length;\n            }\n        }\n        frequencies[(unsigned char)((char)-1)] += (int)(capacity - used);\n    } else {\n        for (int i = 0; i < n_groups; ++i) {\n            Group g = groups[i];\n            int group_votes = 0;\n\n            for (int j = 0; j < g.length; ++j) {\n                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n                if (d < cutoff) {\n                    ++group_votes;\n                } else if (d == cutoff && tied_slots > 0) {\n                    ++group_votes;\n                    --tied_slots;\n                }\n            }\n\n            frequencies[(unsigned char)g.label] += group_votes;\n        }\n    }\n\n    return choose_label(frequencies);\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
  "src/knn.h": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}"
}

    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n\\nstatic int is_worse(float da, long ia, float db, long ib) {\\n    return (da > db) || (da == db && ia > ib);\\n}\\n\\nstatic void swap3(float *hd, long *hi, char *hl, int a, int b) {\\n    float td = hd[a]; hd[a] = hd[b]; hd[b] = td;\\n    long ti = hi[a]; hi[a] = hi[b]; hi[b] = ti;\\n    char tc = hl[a]; hl[a] = hl[b]; hl[b] = tc;\\n}\\n\\nstatic void heap_push(float *hd, long *hi, char *hl, int *n,\\n                      float d, long idx, char label) {\\n    int i = (*n)++;\\n    hd[i] = d; hi[i] = idx; hl[i] = label;\\n\\n    while (i > 0) {\\n        int parent = (i - 1) / 2;\\n        if (is_worse(hd[i], hi[i], hd[parent], hi[parent])) {\\n            swap3(hd, hi, hl, i, parent);\\n            i = parent;\\n        } else {\\n            break;\\n        }\\n    }\\n}\\n\\nstatic void heap_replace_root(float *hd, long *hi, char *hl, int n,\\n                              float d, long idx, char label) {\\n    hd[0] = d; hi[0] = idx; hl[0] = label;\\n    int i = 0;\\n\\n    for (;;) {\\n        int left = 2 * i + 1;\\n        if (left >= n) break;\\n        int right = left + 1;\\n        int worst = i;\\n\\n        if (is_worse(hd[left], hi[left], hd[worst], hi[worst])) {\\n            worst = left;\\n        }\\n        if (right < n && is_worse(hd[right], hi[right], hd[worst], hi[worst])) {\\n            worst = right;\\n        }\\n\\n        if (worst == i) break;\\n        swap3(hd, hi, hl, i, worst);\\n        i = worst;\\n    }\\n}\\n\\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n    size_t total = 0;\\n    for (int gi = 0; gi < n_groups; ++gi) {\\n        total += (size_t)groups[gi].length;\\n    }\\n\\n    float *restrict xs = NULL;\\n    if (posix_memalign((void **)&xs, 64, total * sizeof(float)) != 0) {\\n        xs = malloc(total * sizeof(float));\\n    }\\n    float *restrict ys = NULL;\\n    if (posix_memalign((void **)&ys, 64, total * sizeof(float)) != 0) {\\n        ys = malloc(total * sizeof(float));\\n    }\\n    char *plabels = (char *)malloc(total * sizeof(char));\\n\\n    size_t pos = 0;\\n    for (int gi = 0; gi < n_groups; ++gi) {\\n        Group g = groups[gi];\\n        char lab = g.label;\\n        for (int j = 0; j < g.length; ++j) {\\n            xs[pos] = g.points[j].x;\\n            ys[pos] = g.points[j].y;\\n            plabels[pos] = lab;\\n            ++pos;\\n        }\\n    }\\n\\n    float *restrict dists = NULL;\\n    if (posix_memalign((void **)&dists, 64, total * sizeof(float)) != 0) {\\n        dists = malloc(total * sizeof(float));\\n    }\\n    float tx = to_evaluate.x;\\n    float ty = to_evaluate.y;\\n\\n#pragma omp parallel for simd schedule(static) aligned(xs, ys, dists: 64) simdlen(4)\\n    for (long p = 0; p < (long)total; ++p) {\\n        float dx = xs[p] - tx;\\n        float dy = ys[p] - ty;\\n        dists[p] = dx * dx + dy * dy;\\n    }\\n\\n    float *heap_d = (float *)malloc(k * sizeof(float));\\n    long *heap_idx = (long *)malloc(k * sizeof(long));\\n    char *heap_lab = (char *)malloc(k * sizeof(char));\\n    int heap_n = 0;\\n\\n    for (long p = 0; p < (long)total; ++p) {\\n        float d = dists[p];\\n        if (heap_n < k) {\\n            heap_push(heap_d, heap_idx, heap_lab, &heap_n,\\n                      d, p, plabels[p]);\\n        } else if (is_worse(heap_d[0], heap_idx[0], d, p)) {\\n            heap_replace_root(heap_d, heap_idx, heap_lab, k,\\n                              d, p, plabels[p]);\\n        }\\n    }\\n\\n    char *labels = (char *)malloc(k * sizeof(char));\\n    for (int i = 0; i < k; ++i) {\\n        if (i < heap_n) labels[i] = heap_lab[i];\\n        else labels[i] = -1;\\n    }\\n\\n    int counts[256] = {0};\\n    for (int i = 0; i < k; ++i) {\\n        unsigned char c = (unsigned char)labels[i];\\n        counts[c]++;\\n    }\\n\\n    char most_frequent = 0;\\n    int best_count = -1;\\n    for (int c = 0; c < 256; ++c) {\\n        if (counts[c] > best_count) {\\n            most_frequent = (char)c;\\n            best_count = counts[c];\\n        }\\n    }\\n\\n    free(xs); free(ys); free(plabels); free(dists);\\n    free(heap_d); free(heap_idx); free(heap_lab); free(labels);\\n\\n    return most_frequent;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n\\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; ++i) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n    return 0;\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Adding restrict qualifiers to the distance arrays and replacing qsort-based label frequency counting with a direct bucket count will improve auto-vectorization of the SIMD distance loop (by eliminating potential aliasing) and reduce overhead in the final classification step, while preserving exact tie-breaking semantics.\",\n  \"notes\": \"Only src/knn.c was modified. The restrict qualifiers on xs, ys, dists help the compiler prove no aliasing for better vectorization; simdlen(4) matches NEON's 128-bit float width. The bucket count replaces qsort with an O(k+256) scan that preserves tie-breaking (smallest label wins when counts are equal).\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Added restrict qualifiers to local pointers xs, ys, dists.\",\n    \"Replaced qsort-based frequency counting with a 256-entry bucket count scanning labels once.\",\n    \"Added explicit simdlen(4) hint to the OpenMP SIMD pragma.\"\n  ]\n}",

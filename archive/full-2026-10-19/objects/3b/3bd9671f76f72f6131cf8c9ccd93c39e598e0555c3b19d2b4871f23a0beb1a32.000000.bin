"""Create a new three-cell r2c read-only auditor; preserve every sealed predecessor."""
from __future__ import annotations

import hashlib
import json
from pathlib import Path

OUT = Path(__file__).resolve().parent
BASE = OUT.parents[1]
OLD = BASE / "outputs/HPC-Forest-Primes-Natif-Audit-r2b"
SOURCE = BASE / "outputs/HPC-Forest-Primes-Natif-MAX-r2/revision-r2c"
PROJECT = BASE / "work/hpc-forest-primes-native-max-r2c/project"
NAMES = ("audit_cache_preservation_r2.py", "audit_campaign.py", "audit_common.py", "audit_context.py",
    "audit_evaluations.py", "audit_formats_r2.py", "audit_private_r2b.py", "audit_r2_native.py",
    "audit_source_binding_r2.py", "audit_transport.py", "git_loose_readonly.py", "test_audit_r2b_neutral.py")


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


runtime = json.loads((SOURCE / "runtime-manifest-r2max.json").read_text(encoding="utf8"))
protected = {str(PROJECT / name): sha(PROJECT / name) for name in runtime}
if {name: protected[str(PROJECT / name)] for name in runtime} != runtime or len(runtime) != 103:
    raise RuntimeError("Exact new r2c103 sources changed")
for folder in (OLD, SOURCE):
    for path in folder.iterdir():
        if path.is_file():
            protected[str(path)] = sha(path)
with (OUT / "preservation-avant.json").open("x", encoding="utf8", newline="\n") as stream:
    stream.write(json.dumps(protected, ensure_ascii=False, indent=2) + "\n")
for name in NAMES:
    body = (OLD / name).read_text(encoding="utf8")
    body = body.replace("audit_private_r2b", "audit_private_r2c")
    body = body.replace("hpc-forest-primes-native-max-r2b", "hpc-forest-primes-native-max-r2c")
    body = body.replace("1a1dde5f1de6b3e3f062e3984c57c6327f714a7570b41e5734371bcda291e33b", "ade344bfec4322e8aaecc99cfbf7bd502e6d39b55c62180e8f552a3d6391e680")
    body = body.replace("000323615fbb6fd602c3f69d1bcd20b46d22ab631400300f3e9068dcf151fc3f", "bac579fdb44850c636a6522c014175f95d4ce867bab502d86dd15c1bff31032e")
    new_name = name.replace("private_r2b", "private_r2c").replace("test_audit_r2b", "test_audit_r2c")
    with (OUT / new_name).open("x", encoding="utf8", newline="\n") as stream:
        stream.write(body)
print(json.dumps({"protected_files": len(protected), "copied_files": len(NAMES), "native_calls": 0}))

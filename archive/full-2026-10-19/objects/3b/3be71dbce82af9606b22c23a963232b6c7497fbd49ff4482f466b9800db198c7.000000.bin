"""One deterministic review counterexample; synthetic rows only, no process API."""
import copy
import hashlib
import importlib.util
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
SCRIPT = HERE.parent / "preparer-arret.py"
assert hashlib.sha256(SCRIPT.read_bytes()).hexdigest() == "8501a6f852e811f43e3ccb5219ad164a15330b36c3f2f2189e30e92c3a16348f"
spec = importlib.util.spec_from_file_location("review_stop_pure", SCRIPT)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)


def identity(pid, parent, command):
    return {"ProcessId": pid, "ParentProcessId": parent, "ExecutablePath": "C:/NEUTRAL/program.exe",
            "CommandLine": command, "CreationDate": "2026-10-18T04:00:00.1234567Z"}


owned = [identity(pid, 100, "synthetic-owned") for pid in module.OWNED_ORDER]
preserved = [identity(pid, 100, "synthetic-preserved") for pid in module.PRESERVED_ORDER]
baseline = {"captured_at_utc": "2026-10-18T05:00:00.0000000Z", "complete_census": True,
            "strict_utf8_decoding": True, "rows": owned + preserved + [identity(100, 0, "synthetic-foreign-parent")],
            "rows_count": len(owned) + len(preserved) + 1}
now = module.datetime.fromisoformat(baseline["captured_at_utc"]).timestamp()
assert module.classify(copy.deepcopy(baseline), baseline, owned, preserved, now=now)["present_owned"] == list(module.OWNED_ORDER)
fresh = copy.deepcopy(baseline)
fresh["rows"].append(identity(101, 100, "synthetic-unrelated-foreign-child"))
fresh["rows_count"] += 1
try:
    module.classify(fresh, baseline, owned, preserved, now=now)
except ValueError as error:
    result = {"test_scope": "synthetic independent foreign child; no actual census/process", "control_passed": True,
              "new_independent_foreign_refused": True, "refusal": str(error),
              "native_or_owned_descendant": False, "source_script_sha256": hashlib.sha256(SCRIPT.read_bytes()).hexdigest(),
              "production_or_process_calls": 0}
else:
    raise AssertionError("Expected current strict foreign classification refusal")
with (HERE / "CONTRE-EXEMPLE-ETRANGER-INDEPENDANT.json").open("x", encoding="utf8") as stream:
    stream.write(json.dumps(result, indent=2) + "\n")
print(json.dumps(result))

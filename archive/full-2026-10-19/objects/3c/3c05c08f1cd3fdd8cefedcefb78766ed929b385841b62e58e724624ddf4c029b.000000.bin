      "content": "#include \"knn.h\"\n\ntypedef struct {\n    float dist;\n    char label;\n    long idx;\n} HeapEntry;\n\nstatic inline int worse_entry(const HeapEntry *a, const HeapEntry *b) {\n    if (a->dist != b->dist) return a->dist > b->dist;\n    return a->idx > b->idx;\n}\n\nstatic inline void swap_entries(HeapEntry *a, HeapEntry *b) {\n    HeapEntry t = *a; *a = *b; *b = t;\n}\n\nstatic inline void sift_up(HeapEntry *heap, int pos) {\n    while (pos > 0) {\n        int parent = (pos - 1) / 2;\n        if (worse_entry(&heap[pos], &heap[parent])) {\n            swap_entries(&heap[pos], &heap[parent]);\n            pos = parent;\n        } else break;\n    }\n}\n\nstatic inline void sift_down(HeapEntry *heap, int start, int end) {\n    int root = start;\n    while (1) {\n        int child = 2 * root + 1;\n        if (child > end) break;\n        int right = child + 1;\n        if (right <= end && worse_entry(&heap[right], &heap[child])) child = right;\n        if (worse_entry(&heap[root], &heap[child])) {\n            swap_entries(&heap[root], &heap[child]);\n            root = child;\n        } else break;\n    }\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    HeapEntry *heap = (HeapEntry *) malloc(sizeof(HeapEntry) * k);\n    if (!heap) on_error();\n    int heap_size = 0;\n    long idx = 0;\n\n    float px = to_evaluate.x;\n    float py = to_evaluate.y;\n\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        Point *pts = g.points;\n        for (int j = 0; j < g.length; j++) {\n            float dx = pts[j].x - px;\n            float dy = pts[j].y - py;\n            float d = dx * dx + dy * dy;\n\n            HeapEntry e;\n            e.dist = d;\n            e.label = g.label;\n            e.idx = idx++;\n\n            if (heap_size < k) {\n                heap[heap_size++] = e;\n                sift_up(heap, heap_size - 1);\n            } else {\n                // Replace root only if new entry is better (not worse)\n                if (!worse_entry(&e, &heap[0])) {\n                    heap[0] = e;\n                    sift_down(heap, 0, k - 1);\n                }\n            }\n        }\n    }\n\n    int counts[256] = {0};\n    for (int i = 0; i < heap_size; i++) {\n        unsigned char c = (unsigned char) heap[i].label;\n        counts[c]++;\n    }\n    free(heap);\n\n    int best_count = -1;\n    char best_label = 0;\n    for (int c = 0; c < 256; c++) {\n        if (counts[c] > best_count) {\n            best_count = counts[c];\n            best_label = (char)c;\n        }\n    }\n\n    return best_label;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    },
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point *points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        float x, y;\n        if (scanf(\" (%f ,%f) \", &x, &y) != 2) on_error();\n        group.points[i].x = x;\n        group.points[i].y = y;\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}\n",
      "path": "src/knn.h"
    }
  ],
  "hypothesis": "Changing each group's point storage from separate xs and ys arrays to a single contiguous array of Point structs improves memory locality by keeping x and y coordinates adjacent, reducing cache misses during the distance scan while preserving exact iteration order and tie-breaking semantics.",
  "notes": "No other changes; heap selection and tie-breaking unchanged. The Group structure now holds one pointer to an array of Points instead of two separate float arrays, which should reduce memory traffic per point access.",

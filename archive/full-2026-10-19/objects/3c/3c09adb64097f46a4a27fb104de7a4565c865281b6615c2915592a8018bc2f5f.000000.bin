    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <math.h>\\n\\n#define N_ITER 10 // number of simulation iterations\\n#define DT 0.01f // time step\\n#define SOFTENING 1e-9f // to avoid zero divisors\\n#define BLOCK_SIZE 64 // tile size for both i and j loops (2D blocking)\\n\\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\\n\\n/*\\n * Compute the gravitational impact among all pairs of bodies in \\n * the system. Uses Structure-of-Arrays layout and 2D tiling.\\n */\\nvoid body_force(float * restrict x, float * restrict y, float * restrict z,\\n                float * restrict vx, float * restrict vy, float * restrict vz,\\n                float dt, int n) {\\n  // Outer tile over i (bodies receiving force)\\n  for (int ii = 0; ii < n; ii += BLOCK_SIZE) {\\n    int i_end = ii + BLOCK_SIZE;\\n    if (i_end > n) i_end = n;\\n    const int block_i_count = i_end - ii;\\n\\n    // Local arrays for coordinates and force accumulators of this tile\\n    float xi_local[BLOCK_SIZE];\\n    float yi_local[BLOCK_SIZE];\\n    float zi_local[BLOCK_SIZE];\\n    float fx_block[BLOCK_SIZE] = {0};\\n    float fy_block[BLOCK_SIZE] = {0};\\n    float fz_block[BLOCK_SIZE] = {0};\\n\\n    // Load coordinates for the current block of i bodies\\n    for (int k = 0; k < block_i_count; ++k) {\\n      const int idx = ii + k;\\n      xi_local[k] = x[idx];\\n      yi_local[k] = y[idx];\\n      zi_local[k] = z[idx];\\n    }\\n\\n    // Inner tile over j (bodies exerting force)\\n    for (int jj = 0; jj < n; jj += BLOCK_SIZE) {\\n      int j_end = jj + BLOCK_SIZE;\\n      if (j_end > n) j_end = n;\\n\\n      // Process each body in the current j tile\\n      for (int j = jj; j < j_end; ++j) {\\n        const float xj = x[j];\\n        const float yj = y[j];\\n        const float zj = z[j];\\n\\n        // Update forces on all i bodies in the current outer tile\\n        for (int k = 0; k < block_i_count; ++k) {\\n          const float dx = xj - xi_local[k];\\n          const float dy = yj - yi_local[k];\\n          const float dz = zj - zi_local[k];\\n          const float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n          const float inv_dist = 1.0f / sqrt(sqrd_dist);\\n          const float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n\\n          fx_block[k] += dx * inv_dist3;\\n          fy_block[k] += dy * inv_dist3;\\n          fz_block[k] += dz * inv_dist3;\\n        }\\n      }\\n    }\\n\\n    // Update velocities for the current block of i bodies\\n    for (int k = 0; k < block_i_count; ++k) {\\n      const int idx = ii + k;\\n      vx[idx] += dt * fx_block[k];\\n      vy[idx] += dt * fy_block[k];\\n      vz[idx] += dt * fz_block[k];\\n    }\\n  }\\n}\\n\\n/*\\n * Read a binary dataset with initialized bodies.\\n */\\nBody* read_dataset(int *nbodies) {\\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading nbodie value\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading input values\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n\\n  return bodies;\\n}\\n\\n/*\\n * Write simulation results into a binary dataset.\\n */\\nvoid write_dataset(const int nbodies, Body *bodies) {\\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError writing to output\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n}\\n\\nint main(int argc,char **argv) {\\n  int nbodies;\\n\\n  Body *tmp = read_dataset(&nbodies);\\n\\n  // Allocate SoA arrays with alignment for SIMD (32-byte boundary)\\n  float *x, *y, *z, *vx, *vy, *vz;\\n  const size_t align = 32;\\n  if (posix_memalign((void**)&x, align, nbodies * sizeof(float)) ||\\n      posix_memalign((void**)&y, align, nbodies * sizeof(float)) ||\\n      posix_memalign((void**)&z, align, nbodies * sizeof(float)) ||\\n      posix_memalign((void**)&vx, align, nbodies * sizeof(float)) ||\\n      posix_memalign((void**)&vy, align, nbodies * sizeof(float)) ||\\n      posix_memalign((void**)&vz, align, nbodies * sizeof(float))) {\\n    fprintf(stderr,\\\"\\\\nError allocating aligned memory\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n\\n  // Convert from AoS (Body array) to SoA\\n  for (int i = 0; i < nbodies; ++i) {\\n    x[i]  = tmp[i].x;\\n    y[i]  = tmp[i].y;\\n    z[i]  = tmp[i].z;\\n    vx[i] = tmp[i].vx;\\n    vy[i] = tmp[i].vy;\\n    vz[i] = tmp[i].vz;\\n  }\\n  free(tmp);\\n\\n  /*\\n   * At each simulation iteration, interbody forces are computed,\\n   * and bodies' positions are integrated.\\n   */\\n  for (int iter = 0; iter < N_ITER; ++iter) {\\n    body_force(x, y, z, vx, vy, vz, DT, nbodies);\\n\\n    for (int i = 0; i < nbodies; ++i) {\\n      x[i] += vx[i] * DT;\\n      y[i] += vy[i] * DT;\\n      z[i] += vz[i] * DT;\\n    }\\n  }\\n\\n  // Convert back from SoA to AoS for output\\n  Body *out = (Body *)malloc(nbodies * sizeof(Body));\\n  for (int i = 0; i < nbodies; ++i) {\\n    out[i].x  = x[i];\\n    out[i].y  = y[i];\\n    out[i].z  = z[i];\\n    out[i].vx = vx[i];\\n    out[i].vy = vy[i];\\n    out[i].vz = vz[i];\\n  }\\n\\n  write_dataset(nbodies, out);\\n\\n  free(out);\\n  free(x); free(y); free(z); free(vx); free(vy); free(vz);\\n\\n  exit(EXIT_SUCCESS);\\n}\\n\",\n      \"path\": \"src/nbody.c\"\n    }\n  ],\n  \"hypothesis\": \"Applying 2D tiling (blocking both i and j loops) with a block size of 64 reduces memory traffic by reusing the same body coordinates across multiple outer iterations within a tile, improving L1/L2 cache utilization. Combined with aligned allocation for SIMD-friendly access, this preserves exact floating-point operation order per body while enhancing spatial locality.\",\n  \"notes\": \"The inner loop over j remains sequential (increasing j) to guarantee bit-for-bit output match. Aligned memory enables efficient NEON loads/stores on ARM64. Block size chosen as a balance between reuse and register pressure; may be tuned further.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"2D tiling (blocking both i and j loops)\",\n    \"aligned allocation with posix_memalign\"\n  ]\n}",

#include <stdio.h>
#include <stdlib.h>
#include <assert.h>
#include <string.h>

typedef struct {
	long int *data;
	long int total;
	long int next;
} bucket;

static char *comparison_strings;
static int comparison_length;

static int compare_indices(const void *left, const void *right) {
	long int left_index = *(const long int *)left;
	long int right_index = *(const long int *)right;
	return strcmp(comparison_strings + left_index * comparison_length,
	              comparison_strings + right_index * comparison_length);
}

static void sort_bucket(bucket *current) {
	if (current->total > 1 && current->total <= 8) {
		/* Bound insertion sort to tiny buckets to avoid qsort setup overhead. */
		for (long int i = 1; i < current->total; i++) {
			long int value = current->data[i];
			long int j = i;
			while (j > 0 &&
			       strcmp(comparison_strings + current->data[j - 1] * comparison_length,
			              comparison_strings + value * comparison_length) > 0) {
				current->data[j] = current->data[j - 1];
				j--;
			}
			current->data[j] = value;
		}
	} else if (current->total > 1) {
		qsort(current->data, (size_t)current->total,
		      sizeof(*current->data), compare_indices);
	}
}

long int* bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {

	long int i;
	long int next;
	bucket *buckets = NULL;
	bucket *b = NULL;
	long int *returns = NULL;

	returns = (long int *)malloc(sizeof(*returns) * (size_t)size);
	buckets = (bucket *)malloc(sizeof(*buckets) * (size_t)nbuckets);
	if (buckets == NULL || (size > 0 && returns == NULL)) {
		free(returns);
		free(buckets);
		exit(EXIT_FAILURE);
	}

	for (i = 0; i < nbuckets; i++) {
		buckets[i].data = NULL;
		buckets[i].total = 0;
		buckets[i].next = 0;
	}

	/* Count each bucket so its range in returns is sized exactly. */
	for (i = 0; i < size; i++) {
		b = &buckets[*(a + i * length) - offset];
		b->total++;
	}

	next = 0;
	for (i = 0; i < nbuckets; i++) {
		buckets[i].data = returns == NULL ? NULL : returns + next;
		buckets[i].next = 0;
		next += buckets[i].total;
	}

	/* Scatter indices into the exact ranges, preserving bucket order. */
	for (i = 0; i < size; i++) {
		b = &buckets[*(a + i * length) - offset];
		b->data[b->next++] = i;
	}

	comparison_strings = a;
	comparison_length = length;
	for (i = 0; i < nbuckets; i++)
		sort_bucket(&buckets[i]);

	free(buckets);
	return returns;
}

void load(char **vString, long int *N, int *l, int *os, int *nb){
   char *strings = NULL;
   int      len,
            offset,
            nbucket;
   long int n;

   if (!fscanf(stdin, "%d", &len)) {
      printf ("ERROR len\n");
      exit (1);
   }

   if (!fscanf(stdin, "%ld", &n)) {
      printf ("ERROR n\n");
      exit (1);
   }

   if (!fscanf(stdin, "%d", &offset)) {
      printf ("ERROR offset\n");
      exit (1);
   }

   if (!fscanf(stdin, "%d", &nbucket)) {
      printf ("ERROR nbucket\n");
      exit (1);
   }

   nbucket = nbucket + 1;
   len = len + 1;

   strings = (char*) malloc(n * len);

   for (int i = 0; i < n; i++){
      if (!fscanf(stdin, "%s", strings + (i * len))) {
      printf ("ERROR %d\n",i);
      exit (1);
      }
   }

   *vString = strings;
   *N = n;
   *l = len;
   *os = offset;
   *nb = nbucket;
}

void print(char *strings, long int *index, long int n, int len){

   for (int i = 0; i < n; i++){
      printf("%d -> %s\n", i, strings + (index[i] * len));
   }
}

void save(char *strings, long int *index, long int n, int len){
   for (int i = 0; i < n; i++){
      printf("%s\n", strings + (index[i] * len));
   }
}

int main(int ac, char **av) {

   char     *strings = NULL;
   long int N        = 0;
   long int *index   = NULL;
   int      len      = 0,
            save2File = 0,
            offset,
            nbuckets;

   load(&strings, &N, &len, &offset, &nbuckets);

   index = bucket_sort(strings, len, N, offset, nbuckets);

   save(strings, index, N, len);

   if (strings != NULL)
      free(strings);

   if (index != NULL)
      free(index);

   return EXIT_SUCCESS;
}
      "content": "#include \"knn.h\"\n#include <float.h>\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\nstatic char knn_reference_ordered(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *)malloc(sizeof(char) * (size_t)k);\n    float *distances = (float *)malloc(sizeof(float) * (size_t)k);\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nstatic char label_from_frequencies(const size_t frequencies[UCHAR_MAX + 1]) {\n    char best_label = (char)-1;\n    size_t best_count = 0;\n\n    for (unsigned int value = 0; value <= UCHAR_MAX; value++) {\n        char label = (char)(unsigned char)value;\n        size_t count = frequencies[value];\n        if (count > best_count ||\n            (count == best_count && count != 0 && label < best_label)) {\n            best_label = label;\n            best_count = count;\n        }\n    }\n    return best_label;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) return (char)-1;\n\n    size_t total = 0;\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length > 0) {\n            size_t length = (size_t)groups[i].length;\n            if (length > SIZE_MAX - total) {\n                return knn_reference_ordered(n_groups, groups, k, to_evaluate);\n            }\n            total += length;\n        }\n    }\n\n    size_t frequencies[UCHAR_MAX + 1] = {0};\n    if ((size_t)k >= total) {\n        for (int i = 0; i < n_groups; i++) {\n            if (groups[i].length > 0) {\n                frequencies[(unsigned char)groups[i].label] += (size_t)groups[i].length;\n            }\n        }\n        frequencies[(unsigned char)(char)-1] += (size_t)k - total;\n        return label_from_frequencies(frequencies);\n    }\n\n    if (sizeof(float) != sizeof(uint32_t) || FLT_RADIX != 2 ||\n        FLT_MANT_DIG != 24 || FLT_MAX_EXP != 128 ||\n        total > SIZE_MAX / sizeof(uint32_t)) {\n        return knn_reference_ordered(n_groups, groups, k, to_evaluate);\n    }\n\n    uint32_t *keys = (uint32_t *)malloc(total * sizeof(uint32_t));\n    if (keys == NULL) {\n        return knn_reference_ordered(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t histogram[2048] = {0};\n    size_t position = 0;\n    for (int i = 0; i < n_groups; i++) {\n        const Group *g = &groups[i];\n        for (int j = 0; j < g->length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g->points[j]);\n            uint32_t key;\n            memcpy(&key, &d, sizeof(key));\n            if (key > UINT32_C(0x7f800000)) {\n                free(keys);\n                return knn_reference_ordered(n_groups, groups, k, to_evaluate);\n            }\n            keys[position++] = key;\n            histogram[key >> 22]++;\n        }\n    }\n\n    /* Nonnegative IEEE-754 distance keys have the same order as distances. */\n    size_t rank = (size_t)k - 1;\n    unsigned int bucket = 0;\n    while (rank >= histogram[bucket]) {\n        rank -= histogram[bucket];\n        bucket++;\n    }\n    uint32_t threshold = (uint32_t)bucket << 22;\n    uint32_t prefix_mask = UINT32_C(0xffc00000);\n\n    for (int shift = 11; shift >= 0; shift -= 11) {\n        memset(histogram, 0, sizeof(histogram));\n        for (size_t p = 0; p < total; p++) {\n            uint32_t key = keys[p];\n            if ((key & prefix_mask) == threshold) {\n                histogram[(key >> shift) & UINT32_C(2047)]++;\n            }\n        }\n        bucket = 0;\n        while (rank >= histogram[bucket]) {\n            rank -= histogram[bucket];\n            bucket++;\n        }\n        threshold |= (uint32_t)bucket << shift;\n        prefix_mask |= UINT32_C(2047) << shift;\n    }\n\n    /* Equal-distance neighbors are admitted in their original traversal order. */\n    size_t equal_remaining = rank + 1;\n    position = 0;\n    for (int i = 0; i < n_groups; i++) {\n        const Group *g = &groups[i];\n        size_t count = 0;\n        for (int j = 0; j < g->length; j++) {\n            uint32_t key = keys[position++];\n            if (key < threshold) {\n                count++;\n            } else if (key == threshold && equal_remaining != 0) {\n                equal_remaining--;\n                count++;\n            }\n        }\n        frequencies[(unsigned char)g->label] += count;\n    }\n\n    free(keys);\n    return label_from_frequencies(frequencies);\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",

      "content": "#include <stdio.h>\n#include <stdlib.h>\n\n#define CONV_THRESHOLD 1.0e-5f\n\nstatic double *grid;\nstatic double *new_grid;\nstatic int size;\nstatic int iter_max_num;\nstatic size_t row_stride;\n\nstatic void allocate_memory(void) {\n    row_stride = (size_t)size + ((size_t)size & 1U);\n    size_t cells = (size_t)size * row_stride;\n\n    grid = (double *)malloc(cells * sizeof(*grid));\n    new_grid = (double *)malloc(cells * sizeof(*new_grid));\n}\n\nstatic void initialize_grid(void) {\n    const int center = size / 2;\n    const int linf = center - (size / 10);\n    const int lsup = center + (size / 10);\n\n    for (int i = 0; i < size; ++i) {\n        double *restrict current_row = grid + (size_t)i * row_stride;\n        double *restrict next_row = new_grid + (size_t)i * row_stride;\n\n        for (int j = 0; j < size; ++j) {\n            current_row[j] = (i >= linf && i <= lsup &&\n                              j >= linf && j <= lsup) ? 100.0 : 0.0;\n            next_row[j] = 0.0;\n        }\n    }\n}\n\nstatic void save_grid(void) {\n    for (int i = 0; i < size; ++i) {\n        const double *row = grid + (size_t)i * row_stride;\n        for (int j = 0; j < size; ++j) {\n            fprintf(stdout, \"%lf \", row[j]);\n        }\n        fprintf(stdout, \"\\n\");\n    }\n}\n\nint main(int argc, char *argv[]) {\n    (void)argc;\n    (void)argv;\n\n    fscanf(stdin, \"%d\", &size);\n    fscanf(stdin, \"%d\", &iter_max_num);\n\n    allocate_memory();\n    initialize_grid();\n\n    int hasError = 1;\n    int iter = 0;\n\n    while (hasError && iter < iter_max_num) {\n        hasError = 0;\n\n        if (size > 2) {\n            for (int i = 1; i < size - 1; ++i) {\n                const double *restrict above = grid + (size_t)(i - 1) * row_stride;\n                const double *restrict current = grid + (size_t)i * row_stride;\n                const double *restrict below = grid + (size_t)(i + 1) * row_stride;\n                double *restrict updated = new_grid + (size_t)i * row_stride;\n\n#pragma GCC ivdep\n                for (int j = 1; j < size - 1; ++j) {\n                    updated[j] = 0.25 * (current[j + 1] + current[j - 1] +\n                                         above[j] + below[j]);\n                }\n            }\n\n            for (int i = 1; i < size - 1 && !hasError; ++i) {\n                const double *restrict current = grid + (size_t)i * row_stride;\n                const double *restrict updated = new_grid + (size_t)i * row_stride;\n\n                for (int j = 1; j < size - 1; ++j) {\n                    double errorCurrent = updated[j] - current[j];\n                    if (errorCurrent < 0.0) {\n                        errorCurrent = -errorCurrent;\n                    }\n                    if (errorCurrent > CONV_THRESHOLD) {\n                        hasError = 1;\n                        break;\n                    }\n                }\n            }\n\n            double *previous = grid;\n            grid = new_grid;\n            new_grid = previous;\n        }\n\n        ++iter;\n    }\n\n    save_grid();\n    return 0;\n}\n",
      "path": "src/laplace_seq.c"
    }
  ],
  "hypothesis": "Separating the dependency-free Jacobi stencil from convergence detection lets GCC vectorize the stencil safely; contiguous ping-pong buffers eliminate the full interior copy while retaining exact iteration and output semantics.",
  "notes": "The post-stencil convergence scan is observationally equivalent because the source grid is not modified until all error checks have completed. Ping-pong is intentionally skipped for grids without an interior so their initialized boundary values remain unchanged.",

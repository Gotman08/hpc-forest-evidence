      "content": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    float * restrict xs;   // array of x coordinates\n    float * restrict ys;   // array of y coordinates\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2) on_error();\n    Point point;\n    point.x = x;\n    point.y = y;\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.xs = (float *)malloc(sizeof(float) * length);\n    group.ys = (float *)malloc(sizeof(float) * length);\n\n    for (int i = 0; i < length; i++) {\n        Point p = parse_point();\n        group.xs[i] = p.x;\n        group.ys[i] = p.y;\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt(Point a, Point b) {\n    float dx = b.x - a.x;\n    float dy = b.y - a.y;\n    return dx * dx + dy * dy;\n}",
      "path": "src/knn.h"
    },
    {
      "content": "#include \"knn.h\"\n#include <arm_neon.h>\n#include <omp.h>\n#include <float.h>\n\n// Max-heap node (1-indexed)\ntypedef struct {\n    float dist;\n    char label;\n} HeapNode;\n\nstatic inline void heap_swap(HeapNode *a, HeapNode *b) {\n    HeapNode t = *a; *a = *b; *b = t;\n}\n\n// Sift down from index idx in a max-heap of size heap_size (1-indexed)\nstatic inline void sift_down(HeapNode *heap, int heap_size, int idx) {\n    while (1) {\n        int largest = idx;\n        int left = 2 * idx;\n        int right = 2 * idx + 1;\n        if (left <= heap_size && heap[left].dist > heap[largest].dist)\n            largest = left;\n        if (right <= heap_size && heap[right].dist > heap[largest].dist)\n            largest = right;\n        if (largest == idx) break;\n        heap_swap(&heap[idx], &heap[largest]);\n        idx = largest;\n    }\n}\n\n// Insert or replace in a max-heap of capacity k.\nstatic inline void heap_insert_or_replace(float d, char label,\n                                          HeapNode *heap, int *heap_size_ptr, int k) {\n    int hs = *heap_size_ptr;\n    if (hs < k) {\n        // Insert at end and bubble up\n        hs++;\n        int idx = hs;\n        heap[idx].dist = d;\n        heap[idx].label = label;\n        while (idx > 1 && heap[idx / 2].dist < heap[idx].dist) {\n            heap_swap(&heap[idx], &heap[idx / 2]);\n            idx /= 2;\n        }\n    } else if (d < heap[1].dist) {\n        // Replace root\n        heap[1].dist = d;\n        heap[1].label = label;\n        sift_down(heap, k, 1);\n    }\n    *heap_size_ptr = hs;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    // Determine number of threads once (outside parallel region)\n    int max_threads = omp_get_max_threads();\n    if (max_threads < 1) max_threads = 1;\n\n    // Per-thread heaps: each thread gets a heap array of size k+1 and its current size.\n    HeapNode **thread_heaps = (HeapNode**) malloc(max_threads * sizeof(HeapNode*));\n    int *thread_sizes = (int*) calloc(max_threads, sizeof(int));  // persistent per-thread sizes\n\n    for (int t = 0; t < max_threads; t++) {\n        thread_heaps[t] = (HeapNode*) malloc((k + 1) * sizeof(HeapNode));\n        // Initialize with sentinel values: large distance and invalid label.\n        for (int i = 1; i <= k; i++) {\n            thread_heaps[t][i].dist = FLT_MAX;\n            thread_heaps[t][i].label = -1;\n        }\n    }\n\n    float px = to_evaluate.x;\n    float py = to_evaluate.y;\n\n    #pragma omp parallel for schedule(static)\n    for (int gi = 0; gi < n_groups; gi++) {\n        int tid = omp_get_thread_num();\n        HeapNode *local_heap = thread_heaps[tid];\n        // Use persistent per-thread size pointer so that multiple groups accumulate correctly\n        int *local_size_ptr = &thread_sizes[tid];\n\n        Group g = groups[gi];\n        float *xs = g.xs;\n        float *ys = g.ys;\n        int len = g.length;\n        char label = g.label;\n\n        // Process points in batches of 16 using NEON SIMD (vld1q_f32_x4)\n        int j = 0;\n        for (; j + 15 < len; j += 16) {\n            __builtin_prefetch(xs + j + 64);\n            __builtin_prefetch(ys + j + 64);\n\n            float32x4x4_t x_vec_quad = vld1q_f32_x4(xs + j);\n            float32x4x4_t y_vec_quad = vld1q_f32_x4(ys + j);\n\n            // Compute distances for 16 points (four vectors of four)\n            float32x4_t dx0 = vsubq_f32(x_vec_quad.val[0], vdupq_n_f32(px));\n            float32x4_t dy0 = vsubq_f32(y_vec_quad.val[0], vdupq_n_f32(py));\n            float32x4_t dist_sq0 = vmlaq_f32(vmulq_f32(dx0, dx0), dy0, dy0);\n\n            float32x4_t dx1 = vsubq_f32(x_vec_quad.val[1], vdupq_n_f32(px));\n            float32x4_t dy1 = vsubq_f32(y_vec_quad.val[1], vdupq_n_f32(py));\n            float32x4_t dist_sq1 = vmlaq_f32(vmulq_f32(dx1, dx1), dy1, dy1);\n\n            float32x4_t dx2 = vsubq_f32(x_vec_quad.val[2], vdupq_n_f32(px));\n            float32x4_t dy2 = vsubq_f32(y_vec_quad.val[2], vdupq_n_f32(py));\n            float32x4_t dist_sq2 = vmlaq_f32(vmulq_f32(dx2, dx2), dy2, dy2);\n\n            float32x4_t dx3 = vsubq_f32(x_vec_quad.val[3], vdupq_n_f32(px));\n            float32x4_t dy3 = vsubq_f32(y_vec_quad.val[3], vdupq_n_f32(py));\n            float32x4_t dist_sq3 = vmlaq_f32(vmulq_f32(dx3, dx3), dy3, dy3);\n\n            // Store distances to temporary arrays for unrolled heap insertions\n            float d0[4], d1[4], d2[4], d3[4];\n            vst1q_f32(d0, dist_sq0);\n            vst1q_f32(d1, dist_sq1);\n            vst1q_f32(d2, dist_sq2);\n            vst1q_f32(d3, dist_sq3);\n\n            // Unrolled heap insertions for all 16 points\n            heap_insert_or_replace(d0[0], label, local_heap, local_size_ptr, k);\n            heap_insert_or_replace(d0[1], label, local_heap, local_size_ptr, k);\n            heap_insert_or_replace(d0[2], label, local_heap, local_size_ptr, k);\n            heap_insert_or_replace(d0[3], label, local_heap, local_size_ptr, k);\n\n            heap_insert_or_replace(d1[0], label, local_heap, local_size_ptr, k);\n            heap_insert_or_replace(d1[1], label, local_heap, local_size_ptr, k);\n            heap_insert_or_replace(d1[2], label, local_heap, local_size_ptr, k);\n            heap_insert_or_replace(d1[3], label, local_heap, local_size_ptr, k);\n\n            heap_insert_or_replace(d2[0], label, local_heap, local_size_ptr, k);\n            heap_insert_or_replace(d2[1], label, local_heap, local_size_ptr, k);\n            heap_insert_or_replace(d2[2], label, local_heap, local_size_ptr, k);\n            heap_insert_or_replace(d2[3], label, local_heap, local_size_ptr, k);\n\n            heap_insert_or_replace(d3[0], label, local_heap, local_size_ptr, k);\n            heap_insert_or_replace(d3[1], label, local_heap, local_size_ptr, k);\n            heap_insert_or_replace(d3[2], label, local_heap, local_size_ptr, k);\n            heap_insert_or_replace(d3[3], label, local_heap, local_size_ptr, k);\n        }\n\n        // Scalar remainder (less than 16 points)\n        for (; j < len; j++) {\n            float dx = xs[j] - px;\n            float dy = ys[j] - py;\n            float d = dx*dx + dy*dy;\n            heap_insert_or_replace(d, label, local_heap, local_size_ptr, k);\n        }\n    }\n\n    // Global max-heap to merge per-thread results\n    HeapNode *global_heap = (HeapNode*) malloc((k + 1) * sizeof(HeapNode));\n    for (int i = 1; i <= k; i++) {\n        global_heap[i].dist = FLT_MAX;\n        global_heap[i].label = -1;\n    }\n    int global_size = 0;\n\n    // Merge all per-thread heaps into the global heap\n    for (int t = 0; t < max_threads; t++) {\n        HeapNode *local = thread_heaps[t];\n        int sz = thread_sizes[t];\n        if (sz > k) sz = k;\n        for (int i = 1; i <= sz; i++) {\n            heap_insert_or_replace(local[i].dist, local[i].label,\n                                   global_heap, &global_size, k);\n        }\n    }\n\n    // Extract labels from the final global heap into a plain array for frequency counting.\n    char *labels = (char*) malloc(k * sizeof(char));\n    int actual_k = (global_size < k) ? global_size : k;\n    for (int i = 0; i < actual_k; i++) {\n        labels[i] = global_heap[i + 1].label;\n    }\n    // Fill remaining with -1 if not enough points\n    for (int i = actual_k; i < k; i++) {\n        labels[i] = -1;\n    }\n\n    free(global_heap);\n    for (int t = 0; t < max_threads; t++) {\n        free(thread_heaps[t]);\n    }\n    free(thread_heaps);\n    free(thread_sizes);\n\n    // Find most frequent label using frequency array (O(k + 256))\n    int freq[256] = {0};\n    for (int i = 0; i < k; i++) {\n        if (labels[i] >= 0)\n            freq[(unsigned char)labels[i]]++;\n    }\n\n    char best_label = labels[0];\n    int best_count = freq[(unsigned char)best_label];\n    for (int c = 1; c < 256; c++) {\n        if (freq[c] > best_count) {\n            best_count = freq[c];\n            best_label = (char)c;\n        }\n    }\n\n    free(labels);\n    return best_label;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n\n    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; ++i) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Integrating SoA storage with restrict qualifiers (B), software prefetching before SIMD batches (B), max-heap top-k selection and frequency-array final label counting (A), and OpenMP parallelization over groups with persistent per-thread heaps allocated once outside the parallel region (C) will yield a correct program that is faster than any single transformation by combining memory-friendly layout, reduced cache misses via prefetching, efficient streaming heap operations, and thread-level parallelism without repeated allocation overhead.",
  "notes": "Added restrict qualifiers to xs/ys pointers in Group struct (B). Added __builtin_prefetch calls before each batch of 16 points in the SIMD loop (B). Retained existing SoA layout (xs/ys arrays), NEON SIMD with vld1q_f32_x4, max-heap insertion/replacement logic from A and B, per-thread heaps allocated once outside parallel region from C, frequency-array final label selection from A. The OpenMP schedule remains static over groups as in the parent commit.",

        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdint.h>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n/*\n * Certify the narrowing of a refined reciprocal-square-root estimate.\n * The residual bounds its relative error below 2^-40. For reciprocal\n * square roots of positive finite floats, float rounding midpoints have\n * binary64 low mantissa bits 0x10000000. The 32768-double-ULP exclusion\n * window exceeds the error bound plus the reference sqrt/divide rounding.\n */\nstatic inline __attribute__((always_inline)) uint64x2_t nbody_inverse_safe(\n    float64x2_t distance, float64x2_t inverse) {\n  const float64x2_t residual = vabsq_f64(vsubq_f64(\n      vmulq_f64(vmulq_f64(distance, inverse), inverse),\n      vdupq_n_f64(1.0)));\n  const uint64x2_t tail = vandq_u64(\n      vreinterpretq_u64_f64(inverse),\n      vdupq_n_u64(UINT64_C(0x1fffffff)));\n  const uint64x2_t away_from_midpoint = vorrq_u64(\n      vcltq_u64(tail, vdupq_n_u64(UINT64_C(0x0fff8000))),\n      vcgtq_u64(tail, vdupq_n_u64(UINT64_C(0x10008000))));\n  const uint64x2_t valid_residual = vcleq_f64(\n      residual, vdupq_n_f64(0x1p-40));\n  const uint64x2_t positive = vcgtq_f64(inverse, vdupq_n_f64(0.0));\n  return vandq_u64(vandq_u64(valid_residual, positive), away_from_midpoint);\n}\n\nstatic inline __attribute__((always_inline)) float32x4_t nbody_inverse_distance4(\n    float32x4_t distance) {\n  float32x4_t estimate = vrsqrteq_f32(distance);\n  estimate = vmulq_f32(estimate, vrsqrtsq_f32(\n      vmulq_f32(distance, estimate), estimate));\n  estimate = vmulq_f32(estimate, vrsqrtsq_f32(\n      vmulq_f32(distance, estimate), estimate));\n\n  const float64x2_t d0 = vcvt_f64_f32(vget_low_f32(distance));\n  const float64x2_t d1 = vcvt_f64_f32(vget_high_f32(distance));\n  float64x2_t r0 = vcvt_f64_f32(vget_low_f32(estimate));\n  float64x2_t r1 = vcvt_f64_f32(vget_high_f32(estimate));\n  r0 = vmulq_f64(r0, vrsqrtsq_f64(vmulq_f64(d0, r0), r0));\n  r1 = vmulq_f64(r1, vrsqrtsq_f64(vmulq_f64(d1, r1), r1));\n\n  const uint64x2_t safe = vandq_u64(\n      nbody_inverse_safe(d0, r0), nbody_inverse_safe(d1, r1));\n  if (__builtin_expect(\n          (vgetq_lane_u64(safe, 0) & vgetq_lane_u64(safe, 1)) == UINT64_MAX,\n          1)) {\n    return vcombine_f32(vcvt_f32_f64(r0), vcvt_f32_f64(r1));\n  }\n\n  /* Ambiguous rounding and nonfinite values use the original operations. */\n  const float64x2_t one = vdupq_n_f64(1.0);\n  return vcombine_f32(\n      vcvt_f32_f64(vdivq_f64(one, vsqrtq_f64(d0))),\n      vcvt_f32_f64(vdivq_f64(one, vsqrtq_f64(d1))));\n}\n\n/* SIMD lanes represent independent target bodies, never source reductions. */\nstatic inline __attribute__((always_inline)) void nbody_accumulate8(\n    const Body *source,\n    float32x4_t x0, float32x4_t y0, float32x4_t z0,\n    float32x4_t x1, float32x4_t y1, float32x4_t z1,\n    float32x4_t *fx0, float32x4_t *fy0, float32x4_t *fz0,\n    float32x4_t *fx1, float32x4_t *fy1, float32x4_t *fz1) {\n  const float32x4_t sx = vdupq_n_f32(source->x);\n  const float32x4_t sy = vdupq_n_f32(source->y);\n  const float32x4_t sz = vdupq_n_f32(source->z);\n  const float32x4_t soft = vdupq_n_f32(SOFTENING);\n\n  const float32x4_t dx0 = sx - x0;\n  const float32x4_t dy0 = sy - y0;\n  const float32x4_t dz0 = sz - z0;\n  const float32x4_t dx1 = sx - x1;\n  const float32x4_t dy1 = sy - y1;\n  const float32x4_t dz1 = sz - z1;\n  const float32x4_t sqrd0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + soft;\n  const float32x4_t sqrd1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + soft;\n\n  const float32x4_t inv0 = nbody_inverse_distance4(sqrd0);\n  const float32x4_t inv1 = nbody_inverse_distance4(sqrd1);\n  const float32x4_t inv30 = inv0 * inv0 * inv0;\n  const float32x4_t inv31 = inv1 * inv1 * inv1;\n\n  *fx0 += dx0 * inv30;\n  *fy0 += dy0 * inv30;\n  *fz0 += dz0 * inv30;\n  *fx1 += dx1 * inv31;\n  *fy1 += dy1 * inv31;\n  *fz1 += dz1 * inv31;\n}\n\nstatic inline __attribute__((always_inline)) void nbody_update4(\n    Body *p, float dt,\n    float32x4_t fx, float32x4_t fy, float32x4_t fz) {\n  p[0].vx += dt * vgetq_lane_f32(fx, 0);\n  p[0].vy += dt * vgetq_lane_f32(fy, 0);\n  p[0].vz += dt * vgetq_lane_f32(fz, 0);\n  p[1].vx += dt * vgetq_lane_f32(fx, 1);\n  p[1].vy += dt * vgetq_lane_f32(fy, 1);\n  p[1].vz += dt * vgetq_lane_f32(fz, 1);\n  p[2].vx += dt * vgetq_lane_f32(fx, 2);\n  p[2].vy += dt * vgetq_lane_f32(fy, 2);\n  p[2].vz += dt * vgetq_lane_f32(fz, 2);\n  p[3].vx += dt * vgetq_lane_f32(fx, 3);\n  p[3].vy += dt * vgetq_lane_f32(fy, 3);\n  p[3].vz += dt * vgetq_lane_f32(fz, 3);\n}\n#endif\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system.\n */\nvoid body_force(Body *p, float dt, int n) {\n  int i = 0;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n  for (; i + 7 < n; i += 8) {\n    const float32x4_t x0 = {p[i].x, p[i+1].x, p[i+2].x, p[i+3].x};\n    const float32x4_t y0 = {p[i].y, p[i+1].y, p[i+2].y, p[i+3].y};\n    const float32x4_t z0 = {p[i].z, p[i+1].z, p[i+2].z, p[i+3].z};\n    const float32x4_t x1 = {p[i+4].x, p[i+5].x, p[i+6].x, p[i+7].x};\n    const float32x4_t y1 = {p[i+4].y, p[i+5].y, p[i+6].y, p[i+7].y};\n    const float32x4_t z1 = {p[i+4].z, p[i+5].z, p[i+6].z, p[i+7].z};\n    float32x4_t fx0 = vdupq_n_f32(0.0f);\n    float32x4_t fy0 = vdupq_n_f32(0.0f);\n    float32x4_t fz0 = vdupq_n_f32(0.0f);\n    float32x4_t fx1 = vdupq_n_f32(0.0f);\n    float32x4_t fy1 = vdupq_n_f32(0.0f);\n    float32x4_t fz1 = vdupq_n_f32(0.0f);\n\n    int j = 0;\n    for (; j + 1 < n; j += 2) {\n      nbody_accumulate8(p + j, x0, y0, z0, x1, y1, z1,\n                        &fx0, &fy0, &fz0, &fx1, &fy1, &fz1);\n      nbody_accumulate8(p + j + 1, x0, y0, z0, x1, y1, z1,\n                        &fx0, &fy0, &fz0, &fx1, &fy1, &fz1);\n    }\n    for (; j < n; ++j) {\n      nbody_accumulate8(p + j, x0, y0, z0, x1, y1, z1,\n                        &fx0, &fy0, &fz0, &fx1, &fy1, &fz1);\n    }\n\n    nbody_update4(p + i, dt, fx0, fy0, fz0);\n    nbody_update4(p + i + 4, dt, fx1, fy1, fz1);\n  }\n#endif\n  for (; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
        "path": "src/nbody.c"
      }

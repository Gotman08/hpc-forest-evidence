    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <cstdio>\\n#include <vector>\\n#include <algorithm>\\n#include <climits>\\n\\nclass FastScanner {\\n    static constexpr int BUFSIZE = 1 << 20;\\n    char buf[BUFSIZE];\\n    char* cur;\\n    char* end;\\n\\n    bool refill() {\\n        size_t r = fread(buf, 1, BUFSIZE, stdin);\\n        cur = buf;\\n        end = buf + r;\\n        return r > 0;\\n    }\\n\\npublic:\\n    FastScanner() : cur(buf), end(buf) {}\\n\\n    inline int nextInt() {\\n        while (true) {\\n            if (cur == end && !refill()) return 0;\\n            char c = *cur++;\\n            if (c <= ' ') continue;\\n\\n            int sign = 1;\\n            if (c == '-') {\\n                sign = -1;\\n                if (cur == end && !refill()) return 0;\\n                c = *cur++;\\n            }\\n\\n            int x = c - '0';\\n            while (true) {\\n                if (cur == end && !refill()) break;\\n                char d = *cur++;\\n                if (d < '0' || d > '9') break;\\n                x = x * 10 + (d - '0');\\n            }\\n            return sign * x;\\n        }\\n    }\\n};\\n\\nint main() {\\n    FastScanner fs;\\n    int n = fs.nextInt();\\n    int s = fs.nextInt();\\n\\n    const size_t N = static_cast<size_t>(n);\\n    std::vector<long long> pref((N + 1) * N, 0);\\n\\n    for (size_t i = 1; i <= N; ++i) {\\n        const size_t base = i * N;\\n        const size_t prev = (i - 1) * N;\\n        for (size_t j = 0; j < N; ++j) {\\n            int v = fs.nextInt();\\n            pref[base + j] = pref[prev + j] + v;\\n        }\\n    }\\n\\n    long long mxSum = LLONG_MIN;\\n    const size_t limit_i = N - static_cast<size_t>(s);\\n\\n    #pragma omp parallel for reduction(max:mxSum) schedule(static)\\n    for (size_t i = 0; i <= limit_i; ++i) {\\n        const long long* top = &pref[i * N];\\n        const long long* bottom = &pref[(i + s) * N];\\n\\n        long long window = 0;\\n        #pragma omp simd reduction(+:window)\\n        for (size_t j = 0; j < static_cast<size_t>(s); ++j) {\\n            window += bottom[j] - top[j];\\n        }\\n        long long curMax = window;\\n\\n        size_t j = static_cast<size_t>(s);\\n        for (; j + 3 < N; j += 4) {\\n            window += (bottom[j] - top[j]) - (bottom[j - s] - top[j - s]);\\n            if (window > curMax) curMax = window;\\n            window += (bottom[j+1] - top[j+1]) - (bottom[j+1-s] - top[j+1-s]);\\n            if (window > curMax) curMax = window;\\n            window += (bottom[j+2] - top[j+2]) - (bottom[j+2-s] - top[j+2-s]);\\n            if (window > curMax) curMax = window;\\n            window += (bottom[j+3] - top[j+3]) - (bottom[j+3-s] - top[j+3-s]);\\n            if (window > curMax) curMax = window;\\n        }\\n        for (; j < N; ++j) {\\n            window += (bottom[j] - top[j]) - (bottom[j - s] - top[j - s]);\\n            if (window > curMax) curMax = window;\\n        }\\n\\n        mxSum = std::max(mxSum, curMax);\\n    }\\n\\n    printf(\\\"%lld\\\\n\\\", mxSum);\\n    return 0;\\n}\\n\",\n      \"path\": \"src/solution.cpp\"\n    }\n  ],\n  \"hypothesis\": \"Combining A's buffered scanner with direct buffer cursors, C's vertical prefix sums and SIMD reduction for the initial window accumulation, and B's OpenMP parallelization over starting rows with a max-reduction yields lower runtime than any single archived transformation by reducing input parsing overhead while exploiting multi-core parallelism and vectorization.\",\n  \"notes\": \"Uses long long arithmetic to avoid overflow in column-prefix sums. The horizontal sliding-window loop is manually unrolled by four for better instruction-level parallelism. OpenMP parallelizes over starting rows; the reduction(max:mxSum) avoids critical sections. Memory usage is O(N^2) with 64-bit entries, which matches the archived prefix-sum approaches and passed correctness in prior experiments.\",\n  \"sources_kept\
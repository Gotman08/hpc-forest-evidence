      "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nnamespace {\n\nusing Coeff = std::uint32_t;\nconstexpr std::uint64_t kMod = 1000000007ULL;\n\n// Inputs are canonical residues. Sixteen products plus one residue fit\n// in uint64_t: 16 * (kMod - 1)^2 + (kMod - 1) < 2^64.\ninline Coeff dot_mod(const Coeff* lhs, const Coeff* rhs, int count) {\n    std::uint64_t residue = 0;\n    while (count >= 16) {\n#if defined(__aarch64__) && defined(__ARM_NEON)\n        uint64x2_t low = vdupq_n_u64(0);\n        uint64x2_t high = vdupq_n_u64(0);\n        for (int i = 0; i < 16; i += 4) {\n            const uint32x4_t x = vld1q_u32(lhs + i);\n            const uint32x4_t y = vld1q_u32(rhs + i);\n            low = vmlal_u32(low, vget_low_u32(x), vget_low_u32(y));\n            high = vmlal_high_u32(high, x, y);\n        }\n        const std::uint64_t block_sum = vaddvq_u64(vaddq_u64(low, high));\n#else\n        std::uint64_t block_sum = 0;\n        for (int i = 0; i < 16; ++i) {\n            block_sum += static_cast<std::uint64_t>(lhs[i]) * rhs[i];\n        }\n#endif\n        residue = (residue + block_sum) % kMod;\n        lhs += 16;\n        rhs += 16;\n        count -= 16;\n    }\n    for (int i = 0; i < count; ++i) {\n        residue += static_cast<std::uint64_t>(lhs[i]) * rhs[i];\n    }\n    return static_cast<Coeff>(residue % kMod);\n}\n\nCoeff recurrence_term(const std::vector<Coeff>& initial,\n                      const std::vector<Coeff>& weights,\n                      std::uint64_t index) {\n    const int n = static_cast<int>(initial.size());\n    if (index < initial.size()) {\n        return initial[static_cast<std::size_t>(index)];\n    }\n\n    std::vector<Coeff> q(n + 1), r(n), reflected(n + 1);\n    std::vector<Coeff> next_q(n + 1), next_r(n);\n\n    // The generating function is R(x)/Q(x), with Q(0) = 1 and\n    // R(x) = (initial(x) * Q(x)) modulo x^n.\n    q[0] = 1;\n    for (int i = 0; i < n; ++i) {\n        q[i + 1] = weights[i] == 0\n            ? 0 : static_cast<Coeff>(kMod - weights[i]);\n    }\n    for (int i = 0; i <= n; ++i) {\n        reflected[n - i] = q[i];\n    }\n    for (int i = 0; i < n; ++i) {\n        r[i] = dot_mod(initial.data(), reflected.data() + n - i, i + 1);\n    }\n\n    while (index != 0) {\n        const int degree = static_cast<int>(q.size()) - 1;\n        // Reverse Q(-x), making each convolution dot product contiguous.\n        for (int i = 0; i <= degree; ++i) {\n            Coeff value = q[i];\n            if ((i & 1) != 0 && value != 0) {\n                value = static_cast<Coeff>(kMod - value);\n            }\n            reflected[degree - i] = value;\n        }\n\n        const int parity = static_cast<int>(index & 1ULL);\n        const std::uint64_t half = index >> 1;\n        const std::size_t needed = static_cast<std::size_t>(half + 1);\n        const int r_degree = static_cast<int>(r.size()) - 1;\n\n        // Only the requested parity of R(x)Q(-x) contributes.\n        // Coefficients above the remaining index can also be discarded.\n        next_r.resize(std::min(r.size(), needed));\n        for (int j = 0; j < static_cast<int>(next_r.size()); ++j) {\n            const int product_degree = 2 * j + parity;\n            const int begin = std::max(0, product_degree - degree);\n            const int end = std::min(r_degree, product_degree);\n            next_r[j] = begin <= end\n                ? dot_mod(r.data() + begin,\n                          reflected.data() + degree - product_degree + begin,\n                          end - begin + 1)\n                : 0;\n        }\n        if (half == 0) {\n            return next_r[0];\n        }\n\n        // Q(x)Q(-x) is even. Symmetric terms agree modulo kMod,\n        // so compute one half of each coefficient and its diagonal.\n        next_q.resize(std::min(q.size(), needed));\n        next_q[0] = 1;\n        for (int j = 1; j < static_cast<int>(next_q.size()); ++j) {\n            const int begin = std::max(0, 2 * j - degree);\n            const std::uint64_t pairs = dot_mod(\n                q.data() + begin,\n                reflected.data() + degree - 2 * j + begin,\n                j - begin);\n            const std::uint64_t diagonal =\n                static_cast<std::uint64_t>(q[j]) * reflected[degree - j];\n            next_q[j] = static_cast<Coeff>((diagonal + 2 * pairs) % kMod);\n        }\n\n        r.swap(next_r);\n        q.swap(next_q);\n        index = half;\n    }\n    return r[0];\n}\n\n} // namespace\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n;\n    std::uint64_t h;\n    if (!(std::cin >> n >> h)) {\n        return 0;\n    }\n\n    std::vector<Coeff> initial(n), weights(n);\n    for (int i = 0; i < n; ++i) {\n        std::uint64_t value;\n        std::cin >> value;\n        initial[i] = static_cast<Coeff>(value % kMod);\n    }\n    for (int i = 0; i < n; ++i) {\n        std::uint64_t value;\n        std::cin >> value;\n        weights[i] = static_cast<Coeff>(value % kMod);\n    }\n\n    std::cout << recurrence_term(initial, weights, h - 1) << '\\n';\n    return 0;\n}\n",
      "path": "src/npbonacci.cpp"
    }
  ],

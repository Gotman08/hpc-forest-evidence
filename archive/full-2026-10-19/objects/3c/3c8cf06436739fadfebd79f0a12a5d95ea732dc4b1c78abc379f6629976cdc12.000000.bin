#include <iostream>
#include <cstdio>
#include <cassert>
#include <algorithm>
#include <climits>

class FastScanner {
public:
    static const int BUFSIZE = 1 << 20;
    char buf[BUFSIZE];
    int idx, size;
    FastScanner() : idx(0), size(0) {}
    inline char getChar() {
        if (idx >= size) {
            size = fread(buf, 1, BUFSIZE, stdin);
            idx = 0;
            if (size == 0) return 0;
        }
        return buf[idx++];
    }
    int nextInt() {
        char c;
        do { c = getChar(); } while (c <= ' ');
        bool neg = false;
        if (c == '-') { neg = true; c = getChar(); }
        int x = 0;
        while (c >= '0' && c <= '9') {
            x = x * 10 + (c - '0');
            c = getChar();
        }
        return neg ? -x : x;
    }
};

int main() {
    FastScanner fs;
    int n = fs.nextInt();
    int s = fs.nextInt();

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    // Use raw pointers to avoid zero-initialization overhead of std::vector
    int* mat = new int[n * n];
    for (int i = 0; i < n; ++i)
        for (int j = 0; j < n; ++j)
            mat[i*n + j] = fs.nextInt();

    long long* colPref = new long long[n * n];
    long long mxSum = LLONG_MIN;

    #pragma omp parallel
    {
        #pragma omp for schedule(static)
        for (int j = 0; j < n; ++j) {
            long long running = 0;
            for (int i = 0; i < n; ++i) {
                running += mat[i*n + j];
                colPref[i*n + j] = running;
            }
        }

        // implicit barrier between the two worksharing loops

        #pragma omp for reduction(max:mxSum) schedule(static)
        for (int r = 0; r <= n - s; ++r) {
            int bottom = r + s - 1;
            int topMinusOne = r - 1;
            long long cur = 0;
            const int bottomBase = bottom * n;
            const int topBase = (topMinusOne >= 0 ? topMinusOne * n : 0);

            // initial window at column 0
            for (int c = 0; c < s; ++c) {
                long long seg = colPref[bottomBase + c] - (topMinusOne >= 0 ? colPref[topBase + c] : 0);
                cur += seg;
            }
            if (cur > mxSum) mxSum = cur;

            for (int c = 1; c <= n - s; ++c) {
                int outCol = c - 1;
                int inCol = c + s - 1;
                long long segOut = colPref[bottomBase + outCol] - (topMinusOne >= 0 ? colPref[topBase + outCol] : 0);
                long long segIn = colPref[bottomBase + inCol] - (topMinusOne >= 0 ? colPref[topBase + inCol] : 0);
                cur += segIn - segOut;
                if (cur > mxSum) mxSum = cur;
            }
        }
    }

    printf("%d\n", (int)mxSum);

    delete[] mat;
    delete[] colPref;
}

"""Build attempt2 local parent tooling; no submit, transport or worker."""
from pathlib import Path
BASE=Path(__file__).resolve().parents[3]
OLD=Path(__file__).resolve().parent
NEW=OLD.parent/'operations-parent-attempt2'
NEW.mkdir(exist_ok=False)
for name in ['DECISION-HUMAINE-RELANCE-DISTINCTE.json','RECEPTION-TROIS-PREFLIGHTS-ZERO-MODELE.json']:
 (NEW/name).write_bytes((OLD/name).read_bytes())
for slug in ['astra-max','terra-max','sol-max']:(NEW/slug).mkdir()
t=(OLD/'construire-observations-parent.py').read_text('utf-8')
t=t.replace('revision-r1-lane-v2/assembler-admissions-cellule.py','revision-r3-attempt2/assembler-admissions-cellule.py')
t=t.replace("SCOPE+'-admission-'+session","SCOPE+'-admission-attempt2-'+session")
t=t.replace("'admissions-'+slug+'-reelles'","'admissions-attempt2-'+slug+'-reelles'")
t=t.replace("ref(decision),ref(a.census),ref(a.review)","ref(decision),ref(HERE/'RECEPTION-TROIS-PREFLIGHTS-ZERO-MODELE.json'),ref(a.census),ref(a.review)")
t=t.replace("ref(a.remote_check),ref(d/'allocation-ready.json')","ref(a.remote_check),ref(d/'allocation-ready.json'),ref(HERE/'RECEPTION-TROIS-PREFLIGHTS-ZERO-MODELE.json')")
(NEW/'construire-observations-parent.py').write_text(t,'utf-8')
print(NEW)


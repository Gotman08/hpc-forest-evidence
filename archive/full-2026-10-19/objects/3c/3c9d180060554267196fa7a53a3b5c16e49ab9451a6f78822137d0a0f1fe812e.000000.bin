{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include <iostream>\\n#include <vector>\\n#include <utility>\\n#include <array>\\n\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\nusing namespace std;\\n\\ntypedef vector<vector<bool>> adjacency_matrix;\\n\\nadjacency_matrix readGraph();\\n\\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence);\\ninline void printPermutation(vector<int> &equivalence);\\n\\nint main(){\\n    adjacency_matrix g1 = readGraph();\\n    adjacency_matrix g2 = readGraph();\\n\\n    if(!testIsomorphism(g1, g2))\\n        cout << \\\"The graphs are not isomorphic\\\" << endl;\\n\\n    return 0;\\n}\\n\\n#ifdef _OPENMP\\nnamespace {\\n\\nconstexpr int heap_block_size = 7;\\n\\nbool advanceHeapBlock(vector<int> &permutation, vector<int> &exchange_counter){\\n    // The seven-element Heap traversal ends with only its endpoints exchanged.\\n    swap(permutation[0], permutation[heap_block_size - 1]);\\n\\n    // The lower counters have returned to zero; continue the outer traversal.\\n    for(int index = heap_block_size; index < static_cast<int>(permutation.size()); ++index){\\n        if(exchange_counter[index] < index){\\n            if(index % 2 == 0)\\n                swap(permutation[0], permutation[index]);\\n            else\\n                swap(permutation[exchange_counter[index]], permutation[index]);\\n            ++exchange_counter[index];\\n            return true;\\n        }\\n        exchange_counter[index] = 0;\\n    }\\n    return false;\\n}\\n\\nbool parallelHeapSearch(adjacency_matrix &g1, adjacency_matrix &g2,\\n                        const vector<int> &initial){\\n    vector<int> next_permutation(initial);\\n    vector<int> outer_counter(initial.size(), 0);\\n    vector<vector<int>> blocks;\\n    int block_count = 0;\\n    bool more_blocks = true;\\n    bool isomorphism_found = false;\\n\\n    #pragma omp parallel reduction(||:isomorphism_found)\\n    {\\n        vector<int> permutation(initial.size());\\n        array<int, heap_block_size> exchange_counter;\\n        vector<array<int, heap_block_size>> matches;\\n\\n        for(;;){\\n            #pragma omp single\\n            {\\n                // Reuse a bounded batch of entry states for the actual team.\\n                if(blocks.empty())\\n                    blocks.resize(4 * omp_get_num_threads());\\n                block_count = 0;\\n                while(more_blocks && block_count < static_cast<int>(blocks.size())){\\n                    blocks[block_count++] = next_permutation;\\n                    more_blocks = advanceHeapBlock(next_permutation, outer_counter);\\n                }\\n            }\\n\\n            if(block_count == 0)\\n                break;\\n\\n            #pragma omp for ordered schedule(dynamic, 1)\\n            for(int block = 0; block < block_count; ++block){\\n                permutation = blocks[block];\\n                exchange_counter.fill(0);\\n                matches.clear();\\n                int exchange_index = 1;\\n\\n                // Enumerate exactly one contiguous 7! block of the reference walk.\\n                for(;;){\\n                    if(verifyPermutation(g1, g2, permutation)){\\n                        array<int, heap_block_size> match;\\n                        for(int i = 0; i < heap_block_size; ++i)\\n                            match[i] = permutation[i];\\n                        matches.push_back(match);\\n                    }\\n\\n                    while(exchange_index < heap_block_size &&\\n                          exchange_counter[exchange_index] == exchange_index){\\n                        exchange_counter[exchange_index] = 0;\\n                        ++exchange_index;\\n                    }\\n                    if(exchange_index == heap_block_size)\\n                        break;\\n\\n                    if(exchange_index % 2 == 0)\\n                        swap(permutation[0], permutation[exchange_index]);\\n                    else\\n                        swap(permutation[exchange_counter[exchange_index]],\\n                             permutation[exchange_index]);\\n                    ++exchange_counter[exchange_index];\\n                    exchange_index = 1;\\n                }\\n\\n                if(!matches.empty())\\n                    isomorphism_found = true;\\n\\n                #pragma omp ordered\\n                {\\n                    // The suffix is constant within a block. Only matching\\n                    // prefixes are buffered, at most 5,040 per worker.\\n                    for(const auto &match : matches){\\n                        for(int i = 0; i < heap_block_size; ++i)\\n                            permutation[i] = match[i];\\n                        printPermutation(permutation);\\n                    }\\n                }\\n            }\\n        }\\n    }\\n    return isomorphism_found;\\n}\\n\\n}\\n#endif\\n\\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\\n    if(g1.size() != g2.size()) return false;\\n\\n    vector<int> equivalence(g1.size(), 0);\\n    for(int i = 0; i < equivalence.size(); ++i)\\n        equivalence[i] = i;\\n\\n    if(verifyPermutation(g1, g2, equivalence)){\\n        printPermutation(equivalence);\\n        return true;\\n    }\\n\\n#ifdef _OPENMP\\n    // Keep searches of at most 8! permutations serial to amortize team startup.\\n    if(equivalence.size() >= heap_block_size + 2 &&\\n       omp_get_max_threads() > 1 && !omp_in_parallel())\\n        return parallelHeapSearch(g1, g2, equivalence);\\n#endif\\n\\n    vector<int> exchange_counter(g1.size(), 0);\\n    int exchange_index = 1;\\n    bool isomorphism_found = false;\\n\\n    /*\\n     * Permutations are based on Heap's algorithm, which generates all possible\\n     * permutations for a given set of elements.\\n     */\\n    while(exchange_index < g1.size()){\\n        if(exchange_counter[exchange_index] < exchange_index){\\n            if(exchange_index % 2 == 0)\\n                swap(equivalence[0], equivalence[exchange_index]);\\n            else\\n                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\\n            if(verifyPermutation(g1, g2, equivalence)){\\n                printPermutation(equivalence);\\n                isomorphism_found = true;\\n            }\\n\\n            exchange_counter[exchange_index]++;\\n            exchange_index = 1;\\n        }else{\\n            exchange_counter[exchange_index] = 0;\\n            exchange_index++;\\n        }\\n    }\\n    return isomorphism_found;\\n}\\n\\nadjacency_matrix readGraph(){\\n    int vertices, edges, source, destination;\\n\\n    cin >> vertices;\\n    adjacency_matrix read(vertices);\\n    for (int i = 0; i < vertices; ++i)\\n        read[i].resize(vertices);\\n\\n    cin >> edges;\\n    for (int i = 0; i < edges; i++) {\\n       cin >> source >> destination;\\n       read[destination][source] = read[source][destination] = true;\\n    }\\n\\n    return read;\\n}\\n\\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence){\\n    for (int i = 0; i < equivalence.size(); ++i) {\\n        for (int j = 0; j <= i; ++j) {\\n            if(g1[i][j] != g2[equivalence[i]][equivalence[j]]) return false;\\n        }\\n    }\\n   return true;\\n}\\n\\ninline void printPermutation(vector<int> &equivalence){\\n    for (auto i : equivalence)\\n        cout << i << \\\" \\\";\\n    cout << endl;\\n}\\n\",\n      \"path\": \"src/brute_isomorphism.cpp\"\n    }\n  ],\n  \"hypothesis\": \"Dynamically distributing contiguous 5,040-permutation Heap blocks across four OpenMP workers should accelerate verification while preserving exact output order and bounding buffering.\",\n  \"notes\": \"No commands or tests were run. Parallel execution requires an OpenMP-enabled build; otherwise the serial traversal remains. Identity handling, all subsequent matches, and output formatting are preserved. Outer counters avoid factorial-rank overflow.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Retain the identity fast path and serial execution for searches with at most eight vertices.\",\n    \"Use one persistent OpenMP team with dynamic block scheduling and batches bounded by four times the actual team size.\",\n    \"Buffer only matching seven-entry prefixes, emit blocks through an ordered region, and combine success using a logical-OR reduction.\"\n  ]\n}"}}

ogs/e1/54c4d2200bc94475/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/54c4d2200bc94475/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/54c4d2200bc94475/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/54c4d2200bc94475/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/54c4d2200bc94475/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.2202163968856136, \"reason\": \"\", \"score\": 0.754541141449402, \"status\": \"valid\", \"times\": [0.22022501565515995, 0.2205271851271391, 0.21989698987454176], \"tree_hash\": \"36bb16fcea180d3ae3a8551cc665b4391410f427\"}}], \"automatic_observations\": {\"baseline\": {\"experiment_id\": \"baseline-e1\", \"outcome\": {\"binary_sha256\": \"e5cc1106a0fa86df9ee9e25f40fed8f40b5b38091f6b2c31f56fc9d482920aa0\", \"cache_key\": \"eb191a99e5af62a2b5514f2348149f686ff44f20010a69630716eb5855412160\", \"commit\": \"869458ff7f14c4c1620facf7b8a1ff62895bed44\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/baseline-e1/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/baseline-e1/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/baseline-e1/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/baseline-e1/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/baseline-e1/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/baseline-e1/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.6769457515329123, \"reason\": \"\", \"score\": 0.5, \"status\": \"valid\", \"times\": [0.676926732994616, 0.6765774609521031, 0.6773330606520176], \"tree_hash\": \"3bd160bc34679c22f9281f8090cf1470a7d1548e\"}, \"raw_logs\": [{\"path\": \"logs/e1/baseline-e1/search/attempt-001/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": true, \"cases\": 4}}]}, \"selected_parent\": null, \"selected_base_commit\": \"869458ff7f14c4c1620facf7b8a1ff62895bed44\", \"recent_own_role\": [{\"experiment_id\": \"abf473d2c6724ffa\", \"role\": \"G\", \"hypothesis\": \"Combining SoA layout with 64-byte aligned allocation, restrict qualifiers on all pointer parameters, outer loop unrolling by factor 2 (pairwise j-coordinate reuse), SIMD reduction pragma on the inner force loop for both i and i+1 accumulators, OpenMP parallel for schedule(static) on both force computation and position update loops, and remainder handling for odd body count will combine memory locality, vectorization, thread-level parallelism, and reduced scheduling overhead to achieve further speedup beyond any individual transformation.\", \"outcome\": {\"binary_sha256\": \"2773d7ee3fde5a0b2d6817c6b74c5da653fa8b40df2b50546bd6f159caa2f818\", \"cache_key\": \"8094a0bc94a8dff26f4b156e27f11e298746b964774fac38b05660da71df4f44\", \"commit\": \"1589d564d1d94a42152bf2d018c4b6e87c75fe52\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/abf473d2c6724ffa/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/abf473d2c6724ffa/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/abf473d2c6724ffa/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/abf473d2c6724ffa/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/abf473d2c6724ffa/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/abf473d2c6724ffa/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.2017966971422235, \"reason\": \"\", \"score\": 0.7703574039851281, \"status\": \"valid\", \"times\": [0.20223096013069153, 0.2016682205721736, 0.20149091072380543], \"tree_hash\": \"d8ded52de133f048e6345bc6bdd13f2ad01cfa63\"}, \"raw_logs\": [{\"path\": \"logs/e1/abf473d2c6724ffa/search/attempt-001/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": true, \"cases\": 4}}]}, {\"experiment_id\": \"bf71188a6d9249f9\", \"role\": \"G\", \"hypothesis\": \"Integrating SoA layout with aligned allocation, restrict qualifiers, SIMD reduction on the inner force loop (from B), and dynamic scheduling (chunk 16) for both outer loops (force computation and position update, from C) will combine memory locality, vectorization, thread-level parallelism, and load balancing to achieve further speedup beyond any individual transformation.\", \"outcome\": {\"binary_sha256\": \"3e9529e8c90d146e44390b409015fd89f0d5c31e2abb1adfa77e80944de6d5ea\", \"cache_key\": \"92e4161960b57fa1d8299706c809c61129146c5bb0a48e98a76c63ba66710719\", \"commit\": \"8af5a310f98774eb3833008ebeeff244c4e167ee\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/bf71188a6d9249f9/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/bf71188a6d9249f9/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/bf71188a6d9249f9/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/bf71188a6d9249f9/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/bf71188a6d9249f9/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/bf71188a6d9249f9/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.23008089046925306, \"reason\": \"\", \"score\": 0.7463350249984125, \"status\": \"valid\", \"times\": [0.23029756918549538, 0.22977796290069818, 0.23016713932156563], \"tree_hash\": \"3a65624763600665e9466f99b294c0eb1afe6153\"}, \"raw_logs\": [{\"path\": \"logs/e1/bf71188a6d9249f9/search/attempt-001/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": true, \"cases\": 4}}]}, {\"experiment_id\": \"2705a8866d314c24\", \"role\": \"G\", \"hypothesis\": \"Integrating SoA layout with 64-byte aligned allocation, restrict qualifiers on all pointer parameters (from A), explicit SIMD reduction pragma on the inner force loop (from B), OpenMP parallel for schedule(static) on both outer loops (force and position update, from A/B), plus scatter/gather I/O will combine memory locality, vectorization, thread-level parallelism, and reduced scheduling overhead to achieve further speedup beyond any individual transformation.\", \"outcome\": {\"binary_sha256\": \"7c688f3997b19816bb8f409e79bb3753a5507d8a9b5ec46d58d2e05a85c33b72\", \"cache_key\": \"db8b9b50bcac44e07a018c26b1bd5759f4f0ec8346acc17a9a7c48dd4f907cd2\", \"commit\": \"846005a246140d06892d50a17d0b81604ef847a5\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/2705a8866d314c24/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/2705a8866d314c24/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/2705a8866d314c24/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/2705a8866d314c24/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/2705a8866d314c24/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/nbody/logs/e1/2705a8866d314c24/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.22022377016643682, \"reason\": \"\", \"score\": 0.7545349403429288, \"status\": \"valid\", \"times\": [0.22049603145569563, 0.2203190429136157, 0.21985623612999916], \"tree_hash\": \"202761a44a1a28b5f68905c4e0d655aa81a36fc4\"}, \"raw_logs\": [{\"path\": \"logs/e1/2705a8866d314c24/search/attempt-001/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": true, \"cases\": 4}}]}], \"own_role_history\": [{\"experiment_id\": \"abf473d2c6724ffa\", \"status\": \"valid\", \"score\": 0.7703574039851281, \"mean_seconds\": 0.2017966971422235, \"reason\": \"\"}, {\"experiment_id\": \"bf71188a6d9249f9\", \"status\": \"valid\", \"score\": 0.7463350249984125, \"mean_seconds\": 0.23008089046925306, \"reason\": \"\"}, {\"experiment_id\": \"2705a8866d314c24\", \"status\": \"valid\", \"score\": 0.7545349403429288, \"mean_seconds\": 0.22022377016643682, \"reason\": \"\"}, {\"experiment_id\": \"09ed121649d441e7\", \"status\": \"valid\", \"score\": 0.7696216481219686, \"mean_seconds\": 0.20263677214582762, \"reason\": \"\"}, {\"experiment_id\": \"54c4d2200bc94475\", \"status\": \"valid\", \"score\": 0.754541141449402, \"mean_seconds\": 0.2202163968856136, \"reason\": \"\"}, {\"experiment_id\": \"fb337b835c3e409a\", \"status\": \"valid\", \"score\": 0.7538758387387895, \"mean_seconds\": 0.22100815114875635, \"reason\": \"\"}, {\"experiment_id\": \"cbfc17185d0d42e3\", \"status\": \"valid\", \"score\": 0.7704173041230274, \"mean_seconds\": 0.201728374697268, \"reason\": \"\"}, {\"experiment_id\": \"cae76d5e1d774bdd\", \"status\": \"valid\", \"score\": 0.7530104642150958, \"mean_seconds\": 0.2220400975396236, \"reason\": \"\"}, {\"experiment_id\": \"e22df497dada4c5d\", \"status\": \"valid\", \"score\": 0.7529017396751407, \"mean_seconds\": 0.2221699176977078, \"reason\": \"\"}, {\"experiment_id\": \"08b785d9fb034df9\", \"status\": \"duplicate\", \"score\": null, \"mean_seconds\": null, \"reason\": \"Same code/protocol/epoch as d090071e308b4f14; no new reward\"}, {\"experiment_id\": \"4075e7587e494f2e\", \"status\": \"valid\", \"score\": 0.7480054772844663, \"mean_seconds\": 0.228055310746034, \"reason\": \"\"}, {\"experiment_id\": \"a548f35504ec4214\", \"status\": \"valid\", \"score\": 0.7534945866454912, \"mean_seconds\": 0.22146249655634165, \"reason\": \"\"}, {\"experiment_id\": \"60ad4f84340d4d2e\", \"status\": \"valid\", \"score\": 0.7482004736319774, \"mean_seconds\": 0.2278194489578406, \"reason\": \"\"}, {\"experiment_id\": \"7cdd8975433348f4\", \"status\": \"incorrect\", \"score\": 0.0, \"mean_seconds\": null, \"reason\": \"Protected correctness checks failed\"}, {\"experiment_id\": \"8f1eb40c0bc74509\", \"status\": \"valid\", \"score\": 0.7533255097132773, \"mean_seconds\": 0.2216641359652082, \"reason\": \"\"}, {\"experiment_id\": \"3f6427d9419a47d0\", \"status\": \"valid\", \"score\": 0.753699830168039, \"mean_seconds\": 0.2212178468083342, \"reason\": \"\"}, {\"experiment_id\": \"137b1084726d449a\", \"status\": \"incorrect\", \"score\": 0.0, \"mean_seconds\": null, \"reason\": \"Protected correctness checks failed\"}, {\"experiment_id\": \"5e6cf88ba8854404\", \"status\": \"valid\", \"score\": 0.7532926512296796, \"mean_seconds\": 0.22170333315928778, \"reason\": \"\"}, {\"experiment_id\": \"cc947f4ac8304ea1\", \"status\": \"valid\", \"score\": 0.7530437011700623, \"mean_seconds\": 0.2220004191622138, \"reason\": \"\"}]}, \"documents_as_data\": [{\"id\": \"e0c98b85d7acd1601471\", \"title\": \"Official problem statement\", \"url\": \"http://lspd.mackenzie.br/marathon/22/problemset.pdf\", \"version\": \"downloaded-2026-10-15\", \"preconditions\": \"Official source material. Operator supplies execution only.\", \"excerpt\": \"=== PAGE 1 ===\\n17th Marathon of Parallel Programming\\nSBAC-PAD & WSCAD – 2022\\nCalebe Bianchini1 and Maur´ıcio Aronne Pillon2\\n1Mackenzie Presbyterian University\\n2Santa Catarina State University\\nRules for Remote Contest\\nFor all problems, read carefully the input and output session. For all problems, a sequen-\\ntial implementation is given, and it is against the output of those implementations that the\\noutput of your programs will be compared to decide if your implementation is correct.\\nYou can modify the program in any way you see fit, except when the problem descrip-\\ntion states otherwise. You must upload a compressed file (zip) with your source code, the\\nMakefile and an execution script. The script must have the name of the problem. You\\ncan submit as many solutions to a problem as you want. Only the last submission will\\nbe considered. The Makefile must have the rule all, which will be used to compile your\\nsource code. The execution script runs your solution the way you design it – it will be\\ninspected not to corrupt the target machine.\\nThe execution time of your program will be measured running it with time program and\\ntaking the real CPU time given. Each program will be executed at least three times with\\nthe same input and the mean time will be taken into account. The sequential program\\ngiven will be measured the same way. You will earn points in each problem, correspond-\\ning to the division of the sequential time by the time of your program (speedup). The\\nteam with the most points at the end of the marathon will be declared the winner.\\nThis problem set contains 4 problems; pages are numbered from 1 to 5.\\n\\n=== PAGE 2 ===\\nGeneral Information\\nCompilation\\nYou should use CC or CXX inside your Makefile. Be careful when redefining them!\\nThere is a simple Makefile inside you pr\", \"retrieval_relevance\": 161, \"evidence_type\": \"documentation\"}, {\"id\": \"4a7633ba1e00acfb3d75\", \"title\": \"TreeQuest AB-MCTS ask tell persistence\", \"url\": \"https://github.com/SakanaAI/treequest\", \"version\": \"0.3.2\", \"preconditions\": \"Use the pinned TreeQuest version; local trusted checkpoints only.\", \"excerpt\": \"AB-MCTS-A selects new proposals and continuations. Scores are normalized to [0,1]. Persist each role's state per epoch. Integration receives one measured full-program reward in G only. Keep provenance separate from the selected search parent.\", \"retrieval_relevance\": 3, \"evidence_type\": \"documentation\"}], \"deadline\": 1792118015.6339233, \"protocol_id\": \"eee50fb9c75e63b27499b679a7b7700aac94f95b05d36c7129070ed0789c6635\", \"remaining_tokens\": 2477242, \"official_statement_as_data\": \"=== PAGE 1 ===\\n17th Marathon of Parallel Programming\\nSBAC-PAD & WSCAD – 2022\\nCalebe Bianchini1 and Maur´ıcio Aronne Pillon2\\n1Mackenzie Presbyterian University\\n2Santa Catarina State University\\nRules for Remote Contest\\nFor all problems, read carefully the input and output session. For all problems, a sequen-\\ntial implementation is given, and it is against the output of those implementations that the\\noutput of your programs will be compared to decide if your implementation is correct.\\nYou can modify the program in any way you see fit, except when the problem descrip-\\ntion states otherwise. You must upload a compressed file (zip) with your source code, the\\nMakefile and an execution script. The script must have the name of the problem. You\\ncan submit as many solutions to a problem as you want. Only the last submission will\\nbe considered. The Makefile must have the rule all, which will be used to compile your\\nsource code. The execution script runs your solution the way you design it – it will be\\ninspected not to corrupt the target machine.\\nThe execution time of your program will be measured running it with time program and\\ntaking the real CPU time given. Each program will be executed at least three times with\\nthe same input and the mean time will be taken into account. The sequential program\\ngiven will be measured the same way. You will earn points in each problem, correspond-\\ning to the division of the sequential time by the time of your program (speedup). The\\nteam with the most points at the end of the marathon will be declared the winner.\\nThis problem set contains 4 problems; pages are numbered from 1 to 5.\\n\\n=== PAGE 2 ===\\nGeneral Information\\nCompilation\\nYou should use CC or CXX inside your Makefile. Be careful when redefining them!\\nThere is a simple Makefile inside you problem package that you can modify. Example:\\nFLAGS=-O3\\nEXEC=sum\\nCXX=icpc\\nall: $(EXEC)\\n$(EXEC):\\n$(CXX) $(FLAGS) $(EXEC).cpp -c -o $(EXEC).o\\n$(CXX) $(FLAGS) $(EXEC).o -o $(EXEC)\\nEach judge machine has its group of compilers. See them below and choose well when\\nwriting your Makefile. The compiler that is tagged as default is predefined in CC and\\nCXX variables.\\nmachine compiler command\\nhost\\nGCC 12.2.0\\n(default)\\nC = gcc\\nC++ = g++\\nIntel C/C++ Compiler 19.1.3.304 C = icc\\nC++ = icpc\\nMPI\\nIntel MPI Compiler 2019u12\\n(default)\\nC = mpiicc\\nC++ = mpiicpc\\nIntel C/C++ Compiler 19.1.3.304 C = icc\\nC++ = icpc\\nGCC 12.2.0 C = gcc\\nC++ = g++\\ngpu\\nNVidia CUDA 11.6\\n(default)\\nC = nvcc\\nC++ = nvcc\\nGCC 8.3.1 C = gcc\\nC++ = g++\\nSubmitting\\nGeneral information\\nYou must have an execution script that has the same name of the problem. This script runs\\nyour solution the way you design it. There is a simple script inside you problem package\\nthat should be modified. Example:\\n#!/bin/bash\\n# This script runs a generic Problem A\\n# Using 32 threads and OpenMP\\nexport OMP_NUM_THREADS=32\\nOMP_NUM_THREADS=32 ./sum\\n\\n=== PAGE 3 ===\\nSubmitting MPI\\nIf you are planning to submit an MPI solution, you should compile usingmpiicc/mpiicpc.\\nThe script must call mpirun/mpiexec with the correct number of processes (max: 4). It\\nmust use a file called machines that are generated by the auto-judge system - do not\\ncreate it.\\n#!/bin/bash\\n# This script runs a generic Problem A\\n# Using MPI in the entire cluster (4 nodes)\\n# 'machines' file describes the nodes\\nmpirun -np 4 -machinefile machines ./sum\\nComparing times & results\\nIn your personal machine, measure the execution time of your solution using time pro-\\ngram. Add input/output redirection when collecting time. Use diff program to compare\\nthe original and your solution results. Example:\\n$ time -p ./A < original_input.txt > my_output.txt\\nreal 4.94\\nuser 0.08\\nsys 1.56\\n$ diff my_output.txt original_output.txt\\nDo not measure time and do not add input/output redirection when submitting your so-\\nlution - the auto-judge system is prepared to collect your time and compare the results.\\n\\n=== PAGE 4 ===\\nProblem A\\nk-Nearest Neighbors Classifier\\nGiven a set of two-dimensional points S divided intro n groups, an integer k and a two-\\ndimensional point P to be classified, the k-Nearest Neighbors (KNN) algorithm can be\\nused to solve the classification problem of the point P , i.e., classifying the point P into\\none of the n existing groups based on some criteria.\\nThe KNN algorithm works by comparing the distances from each point s ∈ S to the\\npoint P , then selecting the k points with the smallest distance values and counting the\\nfrequency of each group in these k points, the point P is then classified to belong to the\\ngroup with the highest frequency among the k nearest points.\\nFigure 1. Simple example of the KNN classification.\\nThe Figure 1 illustrates an example of the KNN classification algorithm being applied.\\nThe points have been segregated between 4 different groups ( i.e., A, B, C and D) and\\na point P with no group is provided to be classified, the KNN algorithm then searches\\nfor the k points closest to the point P and, after that, the groups have their frequencies\\ncounted, with the highest frequency being chosen as the classification ofP , in the case of\\nthis example, the point P is classified to belong to the group C.\\nInput\\nAn input represents the classification of a single point. The first line contains the pattern\\n”n groups=n”, where n is the total number of groups in this input. Then, for each of then\\ngroups the following lines will be provided, the first line has the pattern ”label=c” where\\nc is a single character that represents the label ( i.e., identification) of the group, then the\\nsecond line follows the pattern ”length= L”, where L is the number of two-dimensional\\npoints in this group and then, the next L lines contain the pattern ”(x,y)” that represents\\n1\\n\\n=== PAGE 5 ===\\neach point that belongs to the aforementioned group. After all groups have been repre-\\nsented there’s a single line with the pattern ”k= k”, where k is the parameter previously\\ndiscussed. Lastly, the final line also contains the pattern ”(x,y)”, representing the coordi-\\nnates to the two-dimensional point to be classified.\\nThe input must be read form the standard input.\\nOutput\\nThe output contains a single character, it being the label of the group chosen as the clas-\\nsification of the provided point.\\nThe output must be written to the standard output.\\nExample\\nInput example Output example\\nn groups=4 C\\nlabel=A\\nlength=3\\n(-3.55,-1.28)\\n(-3.99,-2.06)\\n(-3.23,-0.70)\\nlabel=B\\nlength=5\\n(-4.85,-1.65)\\n(-5.23,-2.22)\\n(-4.75,-3.89)\\n(-6.48,-2.41)\\n(-4.56,-2.29)\\nlabel=C\\nlength=4\\n(2.25,0.64)\\n(0.80,0.85)\\n(3.13,1.37)\\n(3.71,0.59)\\nlabel=D\\nlength=3\\n(-5.73,-2.65)\\n(-5.11,-4.41)\\n(-5.92,-3.06)\\nk=5\\n(-0.65,0.25)\\n2\\n\\n=== PAGE 6 ===\\nProblem B\\nSubmatrix of Maximum Sum\\nGiven a matrix M (with dimensions NxN) and an integer S, the objective is to find\\nthe SxS submatrix of M with maximum sum. A trivial algorithm to solve this problem\\nconsists in generating all (N − S + 1)2 such submatrices and, then, computing their sum\\n(the total time complexity would be, in the worst case, O((N − S)2S2 = O(N 2S2) )\\nThe proposed baseline algorithm (solution.cpp) employs a sliding window technique to\\nreduce this complexity to O(SN 2).\\nInput\\nThe input has only one test case. The first line contains two integers N and S (0 < S <\\nN < 8000). Then, there are N rows representing the matrix M. Each row contains N\\nintegers (with a whitespace after each one).\\nThe input must be read from the standard input.\\nOutput\\nThe output contains a single line. Print the sum of the SxS submatrix of M with maxi-\\nmum sum. It is guaranteed the result will fit a 32-bit signed integer.\\nThe output must be written to the standard output.\\nExample\\nInput Example Output example\\n5 3 51\\n3 6 7 5 3\\n5 6 2 9 1\\n2 7 0 9 3\\n6 0 6 2 6\\n1 8 7 9 2\\n3\\n\\n=== PAGE 7 ===\\nProblem C\\nN-body\\nAn n-body simulation models a dynamic system of particles, usually under the influence\\nof physical forces, predicting their individual motions. A well known application of n-\\nbody simulation is in astrophysics, where particles refer to celestial objects interacting\\nwith each other gravitationally. The provided serial code contains a simple, yet working,\\nn-body simulator for bodies moving through a 3 dimensional space. Your job is to create\\na parallel version of this n-body simulator, retaining the correctness of the solution.\\nInput\\nThe input consists of a binary file containing a structure with six float typed data items\\nfor each particle in the system. These six data items refer to the position of the particle in\\nthe x, y, and z axes, and the velocity of the particle in the x, y, and z axes.\\nThe input must be read form the standard input.\\nOutput\\nThe ouput is also a binary file, with the same format of the input file, containing the\\npositions and velocities of each particle in the x, y, and z axes.\\nThe output must be written to the standard output.\\nExample – in string form, just for readability purposes\\nInput example Output example\\n0.680375 -0.211234 0.566198\\n0.596880 0.823295 -0.604897\\n-0.329554 0.536459 -0.444451\\n0.107940 -0.045206 0.257742\\n-0.270431 0.026802 0.904459\\n0.832390 0.271423 0.434594\\n...\\n-5.184253 11.632033\\n-11.737427 -63.642937\\n146.243469 -147.690735\\n10.654608 -15.666613\\n15.572982 133.827255\\n-195.720352 194.728912\\n22.627201 -1.267884 -5.422720\\n283.039612 -15.879736\\n-67.786301\\n4\\n\\n=== PAGE 8 ===\\nProblem D\\nBucketsort\\nBucket sort or Binsort is a sorting algorithm. Its sorting strategy is to divide the numbers\\ninto ’buckets’ with a finite number of elements. The bucket’s advantage is its complexity\\n(O(n)), where ’n’ is the size of the array. However, linear complexity is only achieved\\nwhen the number is evenly distributed.\\nInput\\nAn input has 2 parts: the parameters and the data. The first four numbers are string length,\\narray size, offset, and bucket number. The remaining parameters are integer numbers to\\norder.\\nThe input must be read form the standard input.\\nOutput\\nThe output contains only the sorted integers.\\nThe output must be written to the standard output.\\nExample\\nInput example Output example\\n5\\n100000\\n48\\n9\\n99997 99996 99995 99994 99993\\n99992 99991 99990 99989 99988\\n99987 99986 ...\\n00000 00001 00002 00003 00004\\n00005 00006 00007 00008 00009\\n00010 00011 ...\\n5\", \"runtime_as_data\": {\"cpu_cores\": 4, \"OMP_NUM_THREADS\": 4, \"architecture\": \"ARM64\", \"candidate_GPU\": false, \"comparison\": \"Exact output bytes against official reference\"}}, \"required_json_schema\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"hypothesis\": {\"type\": \"string\"}, \"transformations\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"sources_kept\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"enum\": [\"26a9e4c4520f4ca0\", \"ea539185c03342db\", \"07a9b10a2e834526\"]}, \"uniqueItems\": true}, \"files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"path\": {\"type\": \"string\"}, \"content\": {\"type\": \"string\"}}, \"required\": [\"path\", \"content\"]}}, \"notes\": {\"type\": \"string\"}}, \"required\": [\"hypothesis\", \"transformations\", \"sources_kept\", \"files\", \"notes\"]}}\n\nCURRENT SOURCE AS DATA:\n\n--- BEGIN FILE src/nbody.c ---\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Compute the gravitational impact among all pairs of bodies in \n * the system.\n */\nvoid body_force(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f; \n    float fy = 0.0f; \n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3; \n      fy += dy * inv_dist3; \n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx; \n    p[i].vy += dt*fy; \n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n  \n  exit(EXIT_SUCCESS);\n}\n\n--- END FILE src/nbody.c ---\n"
    }

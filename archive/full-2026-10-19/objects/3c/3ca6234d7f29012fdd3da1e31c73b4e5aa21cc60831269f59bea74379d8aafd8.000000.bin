{"files":[{"content":"#include <bits/stdc++.h>\n\nusing namespace std;\n\ntypedef unsigned long long ll;\n\nconst int N = 1022;\nconst ll mod = 1000000007ULL;\nll transposed_rhs[N][N];\n\nclass matrix{\n    public:\n    int n;\n    ll mat[N][N];\n    ll aux[N][N];\n\n    void change_n(int n){\n        this->n = n;\n    }\n\n    matrix(int n){\n        this->n = n;\n    }\n\n    void init_base(){\n        for(int i = 0 ; i < n ; i++){\n            for(int j = 0 ; j < n ; j++){\n                mat[i][j] = 0LL;\n            }\n        }\n    }\n\n    void init_ident(){\n        for(int i = 0 ; i < n ; i++){\n            for(int j = 0 ; j < n ; j++){\n                mat[i][j] = (i == j);\n            }\n        }\n    }\n\n    matrix(){\n\n    }\n\n    void multiply_impl(const matrix &rhs){\n        const int tile = 32;\n        for(int i0 = 0 ; i0 < n ; i0 += tile){\n            for(int j0 = 0 ; j0 < n ; j0 += tile){\n                int i_end = min(n, i0 + tile);\n                int j_end = min(n, j0 + tile);\n                for(int i = i0 ; i < i_end ; i++){\n                    for(int j = j0 ; j < j_end ; j++){\n                        transposed_rhs[j][i] = rhs.mat[i][j];\n                    }\n                }\n            }\n        }\n\n        auto compute_row = [&](int i){\n            for(int j = 0 ; j < n ; j++){\n                ll sum = 0LL;\n                for(int k = 0 ; k < n ; k++){\n                    sum += this->mat[i][k] * transposed_rhs[j][k];\n                    if((k & 7) == 7){\n                        sum %= mod;\n                    }\n                }\n                this->aux[i][j] = sum % mod;\n            }\n            memcpy(this->mat[i], this->aux[i], sizeof(ll) * n);\n        };\n\n        if(n >= 64){\n            #pragma omp parallel for schedule(static)\n            for(int i = 0 ; i < n ; i++){\n                compute_row(i);\n            }\n        }else{\n            for(int i = 0 ; i < n ; i++){\n                compute_row(i);\n            }\n        }\n    }\n\n    void multiply(matrix *rhs){\n        multiply_impl(*rhs);\n    }\n\n    void multiply(matrix &rhs){\n        multiply_impl(rhs);\n    }\n\n    void pow(ll p, matrix &ident){\n        auto &r = ident;\n        auto d = this;\n\n        while(p){\n            if(p & 1LL){\n                r.multiply(d);\n            }\n\n            d->multiply(d);\n            p >>= 1LL;\n        }\n    }\n\n    void add_clause(int lin, matrix &base, vector< ll > clause){\n        for(int i = 0 ; i < n ; i++){\n            this->mat[lin][i] = clause[i];\n        }\n\n        base.mat[lin][0] = clause[n];\n    }\n\n    void print_line(int line){\n        for(int i = 0 ; i < n ; i++){\n            printf(\"%lld \", this->mat[i][line]);\n        }\n\n        printf(\"\\n\");\n    }\n\n    void print(){\n        cout << \"sz = \" << this->n << endl;\n\n        for(int i = 0 ; i < n ; i++){\n            for(int j = 0 ; j < n ; j++){\n                cout << this->mat[i][j] << \" \";\n            }\n\n            cout << endl;\n        }\n    }\n\n    matrix get_answer_matrix(int e, matrix &ident, matrix &base){\n        this->pow(e, ident);\n        ident.multiply(base);\n        return ident;\n    }\n\n    void set_base_case(int line, matrix &base, ll val){\n        base.mat[line][0] = val;\n    }\n\n    ll get_answer(int line){\n        return this->mat[line][0];\n    }\n};\n\nmatrix ans(N), base(N), ident(N);\n\nint main(){\n    ios::sync_with_stdio(false);\n    cin.tie(NULL);\n\n    int n, k;\n\n    cin >> n >> k;\n\n    ans.change_n(n);\n    base.change_n(n);\n    ident.change_n(n);\n\n    ident.init_ident();\n    base.init_base();\n\n    vector< ll > P;\n    vector< ll > A;\n\n    for(int i = 0 ; i < n ; i++){\n        ll ai;\n        cin >> ai;\n        A.push_back(ai);\n    }\n\n    for(int i = 0 ; i < n ; i++){\n        ll pi;\n        cin >> pi;\n        P.push_back(pi);\n    }\n\n    P.push_back(A[n - 1]);\n    ans.add_clause(0, base, P);\n\n    for(int i = 1 ; i < n ; i++){\n        vector< ll > clausei;\n\n        for(int j = 0 ; j < n ; j++){\n            if(j == i - 1){\n                clausei.push_back(1);\n            }else{\n                clausei.push_back(0);\n            }\n        }\n\n        clausei.push_back(A[n - i - 1]);\n        ans.add_clause(i, base, clausei);\n    }\n\n    cout << ans.get_answer_matrix(k - n, ident, base).get_answer(0) << \"\\n\";\n\n    return 0;\n}\n","path":"src/npbonacci.cpp"}],"hypothesis":"A tiled right-operand transpose improves dot-product locality, while static row work sharing for n >= 64 and reducing modulo after bounded groups of eight products should speed larger dense multiplications without paying OpenMP startup cost on small matrices.","notes":"The eight-product unsigned accumulator remains below uint64_t capacity because every matrix entry is reduced modulo 1,000,000,007. The right operand is fully transposed before output rows are modified, preserving correctness for in-place squaring.","research":{"queries":[],"urls":[]},"sources_kept":[],"transformations":["Transpose each right-hand matrix operand in 32-by-32 tiles so each dot product reads contiguous data.","Accumulate at most eight products between modular reductions.","Use static OpenMP row scheduling only for n >= 64; process smaller matrices serially."]}
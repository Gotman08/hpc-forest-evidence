      "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <utility>\n#include <vector>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\nusing namespace std;\n\nstatic constexpr int MOD = 1000000007;\nstatic constexpr int TILE = 128;\nstatic constexpr int LOCAL_BITS = 14;\n\nstatic inline int add_mod(int a, int b) {\n    int sum = a + b;\n    return sum >= MOD ? sum - MOD : sum;\n}\n\nstatic int mod_power(int base, int exponent) {\n    int result = 1;\n    while (exponent != 0) {\n        if (exponent & 1)\n            result = static_cast<int>(uint64_t(result) * base % MOD);\n        base = static_cast<int>(uint64_t(base) * base % MOD);\n        exponent >>= 1;\n    }\n    return result;\n}\n\nstatic inline int binomial(int down, int right,\n                           const vector<int>& factorial,\n                           const vector<int>& inverse_factorial) {\n    uint64_t value = uint64_t(factorial[down + right]) * inverse_factorial[down] % MOD;\n    return static_cast<int>(value * inverse_factorial[right] % MOD);\n}\n\nstatic int sparse_paths(int n, const vector<pair<int, int>>& blocked) {\n    const int limit = 2 * n - 2;\n    vector<int> factorial(limit + 1), inverse_factorial(limit + 1);\n    factorial[0] = 1;\n    for (int i = 1; i <= limit; ++i)\n        factorial[i] = static_cast<int>(uint64_t(factorial[i - 1]) * i % MOD);\n    inverse_factorial[limit] = mod_power(factorial[limit], MOD - 2);\n    for (int i = limit; i > 0; --i)\n        inverse_factorial[i - 1] = static_cast<int>(uint64_t(inverse_factorial[i]) * i % MOD);\n\n    const int count = static_cast<int>(blocked.size());\n    vector<int> ways(count + 1);\n    for (int i = 0; i <= count; ++i) {\n        const int y = i < count ? blocked[i].first : n - 1;\n        const int x = i < count ? blocked[i].second : n - 1;\n        uint64_t removed = 0;\n        // The dispatcher bounds count by n. Each contribution is below MOD,\n        // so the complete unsigned reduction fits in uint64_t.\n        #pragma omp simd reduction(+:removed)\n        for (int j = 0; j < i; ++j) {\n            if (blocked[j].second <= x) {\n                const int down = y - blocked[j].first;\n                const int right = x - blocked[j].second;\n                const int continuations = binomial(down, right, factorial, inverse_factorial);\n                removed += uint64_t(ways[j]) * continuations % MOD;\n            }\n        }\n        const int unrestricted = binomial(y, x, factorial, inverse_factorial);\n        int value = unrestricted - static_cast<int>(removed % MOD);\n        if (value < 0) value += MOD;\n        ways[i] = value;\n    }\n    return ways[count];\n}\n\n#if defined(__aarch64__)\nstatic inline uint32x4_t add_mod4(uint32x4_t a, uint32x4_t b) {\n    const uint32x4_t modulus = vdupq_n_u32(MOD);\n    const uint32x4_t sum = vaddq_u32(a, b);\n    return vsubq_u32(sum, vandq_u32(vcgeq_u32(sum, modulus), modulus));\n}\n\nstatic inline uint32x4_t prefix_mod4(uint32x4_t values) {\n    const uint32x4_t zero = vdupq_n_u32(0);\n    values = add_mod4(values, vextq_u32(zero, values, 3));\n    return add_mod4(values, vextq_u32(zero, values, 2));\n}\n#endif\n\nstatic inline int advance_segment(int* row, int first, int last, int left) {\n    if (first >= last) return left;\n    int x = first;\n#if defined(__aarch64__)\n    uint32x4_t carry = vdupq_n_u32(static_cast<uint32_t>(left));\n    for (; x + 8 <= last; x += 8) {\n        uint32x4_t low = prefix_mod4(vld1q_u32(\n            reinterpret_cast<const uint32_t*>(row + x)));\n        uint32x4_t high = prefix_mod4(vld1q_u32(\n            reinterpret_cast<const uint32_t*>(row + x + 4)));\n        high = add_mod4(high, vdupq_laneq_u32(low, 3));\n        low = add_mod4(low, carry);\n        high = add_mod4(high, carry);\n        vst1q_u32(reinterpret_cast<uint32_t*>(row + x), low);\n        vst1q_u32(reinterpret_cast<uint32_t*>(row + x + 4), high);\n        carry = vdupq_laneq_u32(high, 3);\n    }\n    left = static_cast<int>(vgetq_lane_u32(carry, 0));\n#endif\n    for (; x < last; ++x) {\n        left = add_mod(row[x], left);\n        row[x] = left;\n    }\n    return left;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n    const int tiles = (n + TILE - 1) / TILE;\n\n    vector<uint64_t> blocked;\n    blocked.reserve(static_cast<size_t>(m));\n    bool endpoint_blocked = false;\n    for (int k = 0; k < m; ++k) {\n        int r = 0, c = 0;\n        cin >> r >> c;\n        if ((r == 0 && c == 0) || (r == n - 1 && c == n - 1))\n            endpoint_blocked = true;\n        const int tr = r / TILE;\n        const int tc = c / TILE;\n        const uint64_t key = static_cast<uint64_t>(tr + tc) * tiles + tr;\n        const uint64_t local = (r % TILE) * TILE + c % TILE;\n        blocked.push_back((key << LOCAL_BITS) | local);\n    }\n    if (endpoint_blocked) {\n        cout << 0 << '\\n';\n        return 0;\n    }\n\n    sort(blocked.begin(), blocked.end());\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\n\n    const uint64_t count = blocked.size();\n    const uint64_t dense_work = uint64_t(n) * n;\n    const uint64_t preprocessing_work = uint64_t(32) * n;\n    bool use_sparse = blocked.empty();\n    if (!use_sparse && count <= uint64_t(n) && dense_work >= preprocessing_work) {\n        const uint64_t pairs = count * (count + 1) / 2;\n        // Conservative operation-count estimate for the parallel NEON fallback;\n        // include factorial construction and charge heavily for sparse pairs.\n        use_sparse = pairs <= (dense_work - preprocessing_work) / 512;\n    }\n    if (use_sparse) {\n        vector<pair<int, int>> coordinates;\n        coordinates.reserve(blocked.size());\n        for (uint64_t code : blocked) {\n            const uint64_t key = code >> LOCAL_BITS;\n            const int diagonal = static_cast<int>(key / tiles);\n            const int tr = static_cast<int>(key % tiles);\n            const int tc = diagonal - tr;\n            const int local = static_cast<int>(code & ((uint64_t(1) << LOCAL_BITS) - 1));\n            coordinates.emplace_back(tr * TILE + local / TILE,\n                                     tc * TILE + local % TILE);\n        }\n        sort(coordinates.begin(), coordinates.end());\n        cout << sparse_paths(n, coordinates) << '\\n';\n        return 0;\n    }\n\n    // Tiles on a wavefront access disjoint slices of both rolling boundaries.\n    vector<int> bottom(n, 0);\n    vector<int> right(n, 0);\n    bottom[0] = 1;\n\n    #pragma omp parallel if (n >= 1024)\n    {\n        alignas(64) int values[TILE];\n        for (int diagonal = 0; diagonal < 2 * tiles - 1; ++diagonal) {\n            const int first = max(0, diagonal - tiles + 1);\n            const int last = min(tiles - 1, diagonal);\n\n            #pragma omp for schedule(static)\n            for (int tr = first; tr <= last; ++tr) {\n                const int tc = diagonal - tr;\n                const int row_start = tr * TILE;\n                const int column_start = tc * TILE;\n                const int height = min(TILE, n - row_start);\n                const int width = min(TILE, n - column_start);\n                const uint64_t key = static_cast<uint64_t>(diagonal) * tiles + tr;\n                const uint64_t tile_base = key << LOCAL_BITS;\n                auto obstacle = lower_bound(blocked.cbegin(), blocked.cend(), tile_base);\n\n                for (int c = 0; c < width; ++c)\n                    values[c] = bottom[column_start + c];\n\n                for (int r = 0; r < height; ++r) {\n                    int left = right[row_start + r];\n                    int c = 0;\n                    const uint64_t row_end = tile_base + static_cast<uint64_t>(r + 1) * TILE;\n                    while (obstacle != blocked.cend() && *obstacle < row_end) {\n                        const int stop = static_cast<int>(*obstacle & (TILE - 1));\n                        left = advance_segment(values, c, stop, left);\n                        values[stop] = 0;\n                        left = 0;\n                        c = stop + 1;\n                        ++obstacle;\n                    }\n                    left = advance_segment(values, c, width, left);\n                    right[row_start + r] = left;\n                }\n\n                for (int c = 0; c < width; ++c)\n                    bottom[column_start + c] = values[c];\n            }\n            // The worksharing barrier publishes both boundaries before\n            // the next wavefront reads them.\n        }\n    }\n\n    cout << bottom[n - 1] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

#include "knn.h"

static float *all_x = NULL;
static float *all_y = NULL;
static char *all_labels = NULL;
static int total_points = 0;
static int capacity = 0;

static void add_point(float x, float y, char label) {
    if (total_points >= capacity) {
        capacity = capacity ? capacity * 2 : 1024;
        all_x = realloc(all_x, capacity * sizeof(float));
        all_y = realloc(all_y, capacity * sizeof(float));
        all_labels = realloc(all_labels, capacity * sizeof(char));
    }
    all_x[total_points] = x;
    all_y[total_points] = y;
    all_labels[total_points] = label;
    total_points++;
}

Group parse_next_group(void) {
    char label;
    int length;
    if (scanf(" label=%c ", &label) != 1) on_error();
    if (scanf(" length=%d ", &length) != 1) on_error();

    for (int i = 0; i < length; i++) {
        float x, y;
        if (scanf(" (%f ,%f) ", &x, &y) != 2) on_error();
        add_point(x, y, label);
    }

    Group dummy = {0, 0, NULL};
    return dummy;
}

char knn(int n_pts, float *xs, float *ys, char *labels,
         int k, Point to_evaluate) {
    char *nearest_labels = malloc(k * sizeof(char));
    float *distances = malloc(k * sizeof(float));

    for (int i = 0; i < k; i++) {
        nearest_labels[i] = -1;
        distances[i] = -1.0f;
    }

    for (int i = 0; i < n_pts; i++) {
        float dx = xs[i] - to_evaluate.x;
        float dy = ys[i] - to_evaluate.y;
        float d = dx * dx + dy * dy;

        int pos;
        for (pos = 0; pos < k; pos++) {
            if (d < distances[pos] || distances[pos] == -1.0f) {
                break;
            }
        }
        if (pos >= k) continue;

        for (int j = k - 1; j > pos; j--) {
            distances[j] = distances[j - 1];
            nearest_labels[j] = nearest_labels[j - 1];
        }
        distances[pos] = d;
        nearest_labels[pos] = labels[i];
    }

    int counts[256] = {0};
    for (int i = 0; i < k; i++) {
        if (nearest_labels[i] != -1) {
            counts[(unsigned char)nearest_labels[i]]++;
        }
    }

    char best_label = nearest_labels[0];
    int best_count = 0;
    for (int c = 255; c >= 0; c--) {
        if (counts[c] > best_count) {
            best_count = counts[c];
            best_label = (char)c;
        }
    }

    free(nearest_labels);
    free(distances);
    return best_label;
}

int main() {
    int n_groups = parse_number_of_groups();

    for (int i = 0; i < n_groups; i++) {
        parse_next_group();
    }

    int k = parse_k();
    Point to_evaluate = parse_point();

    printf("%c", knn(total_points, all_x, all_y, all_labels, k, to_evaluate));
}

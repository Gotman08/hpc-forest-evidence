{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <math.h>\\n\\n#if defined(__aarch64__) && defined(__ARM_NEON)\\n#include <arm_neon.h>\\n#endif\\n\\n#define N_ITER 10 // number of simulation iterations\\n#define DT 0.01f // time step\\n#define SOFTENING 1e-9f // to avoid zero divisors\\n\\n/*\\n * Each body holds coordinate positions (i.e., x, y, and z) and\\n * velocities (i.e., vx, vy, and vz).\\n */\\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\\n\\nstatic inline void force_one(Body *p, float dt, int n, int i) {\\n  float fx = 0.0f;\\n  float fy = 0.0f;\\n  float fz = 0.0f;\\n\\n  for (int j = 0; j < n; ++j) {\\n    float dx = p[j].x - p[i].x;\\n    float dy = p[j].y - p[i].y;\\n    float dz = p[j].z - p[i].z;\\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n    float inv_dist = 1 / sqrt(sqrd_dist);\\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n\\n    fx += dx * inv_dist3;\\n    fy += dy * inv_dist3;\\n    fz += dz * inv_dist3;\\n  }\\n\\n  p[i].vx += dt*fx;\\n  p[i].vy += dt*fy;\\n  p[i].vz += dt*fz;\\n}\\n\\n#if defined(__aarch64__) && defined(__ARM_NEON)\\nstatic inline __attribute__((always_inline))\\nfloat32x4x3_t load_positions4(const Body *p) {\\n  float32x4x3_t t;\\n  t.val[0] = (float32x4_t){p[0].x, p[1].x, p[2].x, p[3].x};\\n  t.val[1] = (float32x4_t){p[0].y, p[1].y, p[2].y, p[3].y};\\n  t.val[2] = (float32x4_t){p[0].z, p[1].z, p[2].z, p[3].z};\\n  return t;\\n}\\n\\nstatic inline __attribute__((always_inline))\\nfloat32x4_t inverse_distance4(float32x4_t sqrd_dist) {\\n  const float64x2_t one = vdupq_n_f64(1.0);\\n  float64x2_t lo = vcvt_f64_f32(vget_low_f32(sqrd_dist));\\n  float64x2_t hi = vcvt_f64_f32(vget_high_f32(sqrd_dist));\\n\\n  lo = vdivq_f64(one, vsqrtq_f64(lo));\\n  hi = vdivq_f64(one, vsqrtq_f64(hi));\\n  return vcombine_f32(vcvt_f32_f64(lo), vcvt_f32_f64(hi));\\n}\\n\\nstatic inline __attribute__((always_inline))\\nvoid accumulate_force4(float32x4x3_t t,\\n                       float32x4_t sx, float32x4_t sy, float32x4_t sz,\\n                       float32x4_t *fx, float32x4_t *fy, float32x4_t *fz) {\\n  float32x4_t dx = sx - t.val[0];\\n  float32x4_t dy = sy - t.val[1];\\n  float32x4_t dz = sz - t.val[2];\\n  float32x4_t sqrd_dist = dx*dx + dy*dy + dz*dz\\n                         + vdupq_n_f32(SOFTENING);\\n  float32x4_t inv_dist = inverse_distance4(sqrd_dist);\\n  float32x4_t inv_dist3 = inv_dist * inv_dist * inv_dist;\\n\\n  *fx += dx * inv_dist3;\\n  *fy += dy * inv_dist3;\\n  *fz += dz * inv_dist3;\\n}\\n\\nstatic inline __attribute__((always_inline))\\nvoid update_velocity4(Body *p, float dt,\\n                      float32x4_t fx, float32x4_t fy, float32x4_t fz) {\\n  float x[4], y[4], z[4];\\n  vst1q_f32(x, fx);\\n  vst1q_f32(y, fy);\\n  vst1q_f32(z, fz);\\n  for (int k = 0; k < 4; ++k) {\\n    p[k].vx += dt*x[k];\\n    p[k].vy += dt*y[k];\\n    p[k].vz += dt*z[k];\\n  }\\n}\\n#endif\\n\\n/*\\n * SIMD lanes own distinct target bodies. Each lane visits sources in\\n * ascending order; positions remain read-only throughout this function.\\n */\\nvoid body_force(Body *p, float dt, int n) {\\n#if defined(__aarch64__) && defined(__ARM_NEON)\\n  const int blocks = n / 12 + (n % 12 != 0);\\n#ifdef _OPENMP\\n#pragma omp parallel for schedule(static) if(blocks > 1)\\n#endif\\n  for (int block = 0; block < blocks; ++block) {\\n    const int i = block * 12;\\n    if (n - i < 12) {\\n      for (int k = i; k < n; ++k)\\n        force_one(p, dt, n, k);\\n      continue;\\n    }\\n\\n    const float32x4x3_t t0 = load_positions4(p + i);\\n    const float32x4x3_t t1 = load_positions4(p + i + 4);\\n    const float32x4x3_t t2 = load_positions4(p + i + 8);\\n    float32x4_t fx0 = vdupq_n_f32(0.0f);\\n    float32x4_t fy0 = vdupq_n_f32(0.0f);\\n    float32x4_t fz0 = vdupq_n_f32(0.0f);\\n    float32x4_t fx1 = vdupq_n_f32(0.0f);\\n    float32x4_t fy1 = vdupq_n_f32(0.0f);\\n    float32x4_t fz1 = vdupq_n_f32(0.0f);\\n    float32x4_t fx2 = vdupq_n_f32(0.0f);\\n    float32x4_t fy2 = vdupq_n_f32(0.0f);\\n    float32x4_t fz2 = vdupq_n_f32(0.0f);\\n\\n    for (int j = 0; j < n; ++j) {\\n      const float32x4_t sx = vdupq_n_f32(p[j].x);\\n      const float32x4_t sy = vdupq_n_f32(p[j].y);\\n      const float32x4_t sz = vdupq_n_f32(p[j].z);\\n      accumulate_force4(t0, sx, sy, sz, &fx0, &fy0, &fz0);\\n      accumulate_force4(t1, sx, sy, sz, &fx1, &fy1, &fz1);\\n      accumulate_force4(t2, sx, sy, sz, &fx2, &fy2, &fz2);\\n    }\\n\\n    update_velocity4(p + i, dt, fx0, fy0, fz0);\\n    update_velocity4(p + i + 4, dt, fx1, fy1, fz1);\\n    update_velocity4(p + i + 8, dt, fx2, fy2, fz2);\\n  }\\n#else\\n#ifdef _OPENMP\\n#pragma omp parallel for schedule(static) if(n > 1)\\n#endif\\n  for (int i = 0; i < n; ++i)\\n    force_one(p, dt, n, i);\\n#endif\\n}\\n\\n/*\\n * Read a binary dataset with initilized bodies.\\n */\\nBody* read_dataset(int *nbodies) {\\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading nbodie value\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading input values\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n\\n  return bodies;\\n}\\n\\n/*\\n * Write simulation results into a binary dataset.\\n */\\nvoid write_dataset(const int nbodies, Body *bodies) {\\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError writing to output\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n}\\n\\nint main(int argc,char **argv) {\\n  int nbodies;\\n\\n  Body *bodies = read_dataset(&nbodies);\\n\\n  /*\\n   * At each simulation iteration, interbody forces are computed,\\n   * and bodies' positions are integrated.\\n   */\\n  for (int iter = 0; iter < N_ITER; iter++) {\\n    body_force(bodies, DT, nbodies);\\n\\n    for (int i = 0; i < nbodies; i++) {\\n      bodies[i].x += bodies[i].vx * DT;\\n      bodies[i].y += bodies[i].vy * DT;\\n      bodies[i].z += bodies[i].vz * DT;\\n    }\\n  }\\n\\n  write_dataset(nbodies, bodies);\\n\\n  free(bodies);\\n\\n  exit(EXIT_SUCCESS);\\n}\\n\",\"path\":\"src/nbody.c\"}],\"hypothesis\":\"A twelve-target NEON microkernel can amortize source loads and expose independent double sqrt/divide operations, while static target-block parallelism exploits the four cores without reassociating force sums.\",\"notes\":\"No reciprocal approximations or horizontal reductions. I/O and time stepping remain unchanged. No commands executed; correctness and speed require controller evaluation.\",\"sources_kept\":[],\"transformations\":[\"Process twelve independent targets as three four-lane NEON groups, preserving ascending source order in every lane.\",\"Retain double-precision square root and reciprocal before narrowing to float.\",\"Parallelize disjoint target blocks with OpenMP when enabled; retain scalar tails and a non-ARM fallback.\"]}"}}

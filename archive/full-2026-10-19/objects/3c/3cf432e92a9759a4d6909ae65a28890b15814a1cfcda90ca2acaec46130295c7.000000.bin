#include <iostream>
#include <cstdio>
#include <cstdlib>
#include <climits>
#include <omp.h>

int main() {
    int n, s;
    std::cin >> n >> s;

    // Allocate aligned flat matrix (64-byte alignment for SIMD)
    int* mat = nullptr;
    if (posix_memalign((void**)&mat, 64, static_cast<size_t>(n) * n * sizeof(int)) != 0) {
        return 1;
    }

    // Read input
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            scanf("%d", &mat[i * n + j]);
        }
    }

    const int np1 = n + 1;
    // Allocate aligned prefix sum array
    long long* pref = nullptr;
    if (posix_memalign((void**)&pref, 64, static_cast<size_t>(np1) * np1 * sizeof(long long)) != 0) {
        free(mat);
        return 1;
    }

    // Initialize first row and column to zero
    for (int j = 0; j < np1; ++j) pref[j] = 0LL;
    for (int i = 1; i <= n; ++i) pref[i * np1] = 0LL;

    // First pass: horizontal cumulative sums per row
    for (int i = 0; i < n; ++i) {
        long long row_sum = 0;
        const int base_i = (i + 1) * np1;
        const int mat_base = i * n;
        for (int j = 0; j < n; ++j) {
            row_sum += mat[mat_base + j];
            pref[base_i + (j + 1)] = row_sum;
        }
    }

    // Second pass: vertical accumulation
    for (int i = 0; i < n; ++i) {
        const int base_cur = (i + 1) * np1;
        const int base_prev = i * np1;
        for (int j = 0; j < n; ++j) {
            pref[base_cur + (j + 1)] += pref[base_prev + (j + 1)];
        }
    }

    // Search for maximum SxS submatrix sum using OpenMP parallel collapse(2)
    int mxSum = INT_MIN;
    const int limit = n - s;  // inclusive upper bound

    #pragma omp parallel for collapse(2) reduction(max:mxSum)
    for (int i = 0; i <= limit; ++i) {
        for (int j = 0; j <= limit; ++j) {
            long long sum = pref[(i + s) * np1 + (j + s)]
                          - pref[i * np1 + (j + s)]
                          - pref[(i + s) * np1 + j]
                          + pref[i * np1 + j];
            if (sum > mxSum) mxSum = static_cast<int>(sum);
        }
    }

    printf("%d\n", mxSum);

    free(mat);
    free(pref);
    return 0;
}

"""Publish derived overhead results; never run a model or a received program."""
from __future__ import annotations

import csv
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent


def main():
    audit_raw = (ROOT / "audit-prevol-arm64.json").read_bytes()
    audit = json.loads(audit_raw)
    if (audit["job_id"] != "749209" or not audit["controller_overhead_measured"]
            or audit["model_calls"] or audit["contest_programs_measured"]
            or audit["llm_optimization_gain_established"] or audit["learning_gain_established"]):
        raise ValueError("The admitted evidence scope differs")
    for filename, expected in {
        "prevol-recu-749209.tar.gz": "ca75a41828c106b775ea4f9cf941fca236182b7224898698ef5ecc5fc6c17456",
        "prevol-echec-749206.tar.gz": "343ed8076af8f28ccd9acb3a3d64698b7832a1002b61da786e593e2c459f74f4",
        "plan-pilote-reel.json": "b438db8a81423b5b6d3869a45db2fe82a4e3f28d0aa8b9808e9691a737e1d2e2",
    }.items():
        if hashlib.sha256((ROOT / filename).read_bytes()).hexdigest() != expected:
            raise ValueError(f"Preserved evidence changed: {filename}")
    lookup = {(row["arm"], row["trials"]): row for row in audit["summary"]}
    comparisons = []
    for item in audit["comparisons"]:
        before = lookup[(item["reference"], item["trials"])]["wall_ms_per_cycle_mean"]
        after = lookup[(item["candidate"], item["trials"])]["wall_ms_per_cycle_mean"]
        comparisons.append({**item, "reference_ms": before, "candidate_ms": after,
                            "controller_time_reduction_percent": 100 * (before - after) / before})
    result = {"scope": "fixed_synthetic_trace_controller_overhead_only", "job_id": "749209",
              "audit_sha256": hashlib.sha256(audit_raw).hexdigest(),
              "measured_cycles": audit["measured_cycles"], "series": audit["series_phases"],
              "summary": audit["summary"], "comparisons": comparisons,
              "native_search_cells_run": 0, "llm_weights_trained": False,
              "program_speedup_established": False, "learning_gain_established": False}
    (ROOT / "resultats-controleur.json").write_text(
        json.dumps(result, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    with (ROOT / "resultats-controleur.csv").open("w", encoding="utf-8", newline="") as handle:
        writer = csv.DictWriter(handle, fieldnames=list(audit["summary"][0]))
        writer.writeheader()
        writer.writerows(audit["summary"])
    lines = ["# R5 : performances réellement mesurées — 16 octobre 2026", "",
             "Le mode population réduit le temps du contrôleur R5 d’environ **26 %** par rapport "
             "à sa politique AB-MCTS, dans cette mesure ARM64 à réponses et scores synthétiques fixes. "
             "Cela représente **2,25 à 2,63 ms par cycle**. Aucun gain sur les programmes HPC produits "
             "par un modèle ni sur l’apprentissage des poids n’est encore établi.", "",
             "## Comparaison dans le même moteur R5", "",
             "| Cycles par série | AB-MCTS, ms/cycle | Population, ms/cycle | Réduction du temps | Écart |",
             "| --- | ---: | ---: | ---: | ---: |"]
    for item in comparisons:
        if item["comparison"] == "same_r5_pipeline":
            n = item["trials"]
            ref = lookup[(item["reference"], n)]
            cand = lookup[(item["candidate"], n)]
            lines.append(f"| {n} | {item['reference_ms']:.3f} ± {ref['wall_ms_per_cycle_stdev']:.3f} "
                         f"| {item['candidate_ms']:.3f} ± {cand['wall_ms_per_cycle_stdev']:.3f} "
                         f"| {item['controller_time_reduction_percent']:.2f} % "
                         f"| {item['candidate_minus_reference_ms_per_cycle']:.3f} ms |")
    lines.extend(["", "Les ± indiquent l’écart-type des moyennes par série, pas un intervalle de confiance. "
                  "Chaque case rassemble trois graines (23, 29, 31) et cinq répétitions, soit 15 séries. "
                  "Une série de chauffe par graine est exclue des calculs. L’ordre est mélangé de façon "
                  "reproductible. L’initialisation des répertoires et des politiques est hors chronométrage.", "",
                  "La politique ne reçoit pas de vraies réponses de modèle : les réponses et les scores "
                  "sont imposés pour isoler le coût du contrôleur. Des parents ou décisions différents "
                  "ne constituent donc pas une amélioration de recherche observée. La petite taille des "
                  "journaux et ces traces finies ne représentent pas toutes les campagnes.", "",
                  "## Noyau AB-MCTS persistant", "",
                  "| Cycles par série | Noyau historique, ms/cycle | Noyau R5, ms/cycle | Réduction |",
                  "| --- | ---: | ---: | ---: |"])
    for item in comparisons:
        if item["comparison"] == "persistent_treequest_kernel":
            lines.append(f"| {item['trials']} | {item['reference_ms']:.3f} | {item['candidate_ms']:.3f} "
                         f"| {item['controller_time_reduction_percent']:.2f} % |")
    lines.extend(["", "Le noyau et le moteur complet effectuent des travaux différents. Leurs valeurs "
                  "brutes ne servent pas à annoncer une accélération globale entre les deux systèmes. "
                  "Le gain de millisecondes n’indique pas une baisse équivalente du temps d’inférence, "
                  "du temps total d’une campagne ou du temps d’exécution du programme retenu.", "",
                  "## Réception et contrôles", "",
                  "Le job alloué **749209** termine en 40 secondes, avec quatre CPU ARM64, 16 Gio "
                  "demandés et zéro GPU. Les compteurs Slurm donnent 20,1 secondes CPU et 108 Mio de "
                  "MaxRSS observés pour ce job ; ils ne fournissent pas une mémoire par bras ou un "
                  "nombre exact de threads. Les variables des bibliothèques sont bornées à un thread.", "",
                  "Les **196 tests du projet** et les **sept tests de mesure** passent. Un test MCP "
                  "optionnel est ignoré car le module est absent. Ruff passe. Les 144 séries brutes "
                  "comprennent 24 chauffes et 120 séries mesurées, soit **2 400 cycles mesurés**. "
                  "Les totaux, moyennes, écarts-types et ratios sont recalculés depuis les données brutes.", "",
                  "Les empreintes annoncée, distante et locale de l’archive concordent : "
                  "`ca75a41828c106b775ea4f9cf941fca236182b7224898698ef5ecc5fc6c17456`. "
                  "La restauration neuve et l’audit en lecture seule revérifient **2 243 fichiers** "
                  "inchangés, dont les 545 fichiers du payload et les 541 sources R5. "
                  "[Audit détaillé](audit-prevol-arm64.json), [inventaires](inventaires-reception-749209.json), "
                  "[résultats JSON](resultats-controleur.json), [CSV](resultats-controleur.csv).", "",
                  "Le premier job **749206**, arrêté en sept secondes avant les tests, est conservé. "
                  "La cause était le nom préfixé du wheel Ruff, refusé par pip. Le lancement correctif "
                  "copie ce wheel sous son nom valide dans une autre allocation, avec le même payload "
                  "et les mêmes sources ; il ne corrige aucun résultat de modèle ou d’algorithme.", "",
                  "## Vérifier ensuite un gain utile", "",
                  "Le [pilote préenregistré](PROTOCOLE-PILOTE-REEL.md) prévoit **36 recherches neuves / "
                  "18 paires**, sur count, k-NN et N-body, deux couples modèle/effort et trois graines. "
                  "Il garde une génération source-only identique entre AB-MCTS et population, les "
                  "mêmes contrats, budgets et confirmations. **Aucune de ces cellules n’est lancée.** "
                  "Le raccordement réel et une voie auditée libre restent nécessaires ; R1/GPT96 et "
                  "les comparaisons humaines déjà prioritaires sont préservés.", "",
                  "Pour [DeepSeek V4 Flash](deepseek/PROTOCOLE-APPRENTISSAGE.md), le checkpoint 0731, "
                  "son encodeur et son véritable tokenizer sont figés. Le format de données textuelles "
                  "est exercé ; les outils, le raisonnement, l’exécution d’un entraînement et ses gains "
                  "ne sont pas qualifiés. Aucun poids de LLM n’est téléchargé, chargé ou entraîné. "
                  "La recette de formation publiée et ses conversions FP4 demandent encore une "
                  "qualification matérielle et logicielle sous allocation.", "",
                  "Ces mesures de contrôleur ne sont pas ajoutées aux résultats de programmes HPC "
                  "de l’article. Une future cohorte ne sera intégrée qu’après réception, audit, "
                  "admission explicite et contrôle de la chaîne professionnelle.", ""])
    (ROOT / "BILAN-MESURES.md").write_text("\n".join(lines), encoding="utf-8")
    print(json.dumps({"report": "BILAN-MESURES.md", "comparisons": comparisons,
                      "native_cells_run": 0, "weights_trained": False}))


if __name__ == "__main__":
    main()

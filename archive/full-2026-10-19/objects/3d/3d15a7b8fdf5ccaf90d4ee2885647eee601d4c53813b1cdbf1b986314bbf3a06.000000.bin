#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N_ITER 10
#define DT 0.01f
#define SOFTENING 1e-9f

int main(int argc, char **argv) {
    int nbodies;
    if (fread(&nbodies, sizeof(nbodies), 1, stdin) != 1) {
        fprintf(stderr, "\nError reading nbodie value\n");
        exit(EXIT_FAILURE);
    }
    size_t count = (size_t)nbodies * 6;
    float *tmp = (float *)malloc(count * sizeof(float));
    if (!tmp) { perror("malloc"); exit(EXIT_FAILURE); }
    if (fread(tmp, count * sizeof(float), 1, stdin) != 1) {
        fprintf(stderr, "\nError reading input values\n");
        exit(EXIT_FAILURE);
    }

    float * restrict px = NULL;
    float * restrict py = NULL;
    float * restrict pz = NULL;
    float * restrict vx = NULL;
    float * restrict vy = NULL;
    float * restrict vz = NULL;
    if (posix_memalign((void **)&px, 64, (size_t)nbodies * sizeof(float)) != 0 ||
        posix_memalign((void **)&py, 64, (size_t)nbodies * sizeof(float)) != 0 ||
        posix_memalign((void **)&pz, 64, (size_t)nbodies * sizeof(float)) != 0 ||
        posix_memalign((void **)&vx, 64, (size_t)nbodies * sizeof(float)) != 0 ||
        posix_memalign((void **)&vy, 64, (size_t)nbodies * sizeof(float)) != 0 ||
        posix_memalign((void **)&vz, 64, (size_t)nbodies * sizeof(float)) != 0) {
        perror("posix_memalign");
        exit(EXIT_FAILURE);
    }

    for (int i = 0; i < nbodies; ++i) {
        px[i] = tmp[6*i];
        py[i] = tmp[6*i+1];
        pz[i] = tmp[6*i+2];
        vx[i] = tmp[6*i+3];
        vy[i] = tmp[6*i+4];
        vz[i] = tmp[6*i+5];
    }
    free(tmp);

    #pragma omp parallel
    {
        for (int iter = 0; iter < N_ITER; ++iter) {
            #pragma omp for simd aligned(px,py,pz,vx,vy,vz:64)
            for (int i = 0; i < nbodies; ++i) {
                float fx = 0.0f, fy = 0.0f, fz = 0.0f;
                const float xi = px[i], yi = py[i], zi = pz[i];
                int j = 0;
                // Unroll by 8 to expose more independent sqrt/div operations
                for (; j + 7 < nbodies; j += 8) {
                    float dx0 = px[j] - xi;
                    float dy0 = py[j] - yi;
                    float dz0 = pz[j] - zi;
                    float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;
                    float inv_dist0 = 1.0f / sqrt(sqrd_dist0);
                    float inv_dist3_0 = inv_dist0 * inv_dist0 * inv_dist0;

                    float dx1 = px[j+1] - xi;
                    float dy1 = py[j+1] - yi;
                    float dz1 = pz[j+1] - zi;
                    float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;
                    float inv_dist1 = 1.0f / sqrt(sqrd_dist1);
                    float inv_dist3_1 = inv_dist1 * inv_dist1 * inv_dist1;

                    float dx2 = px[j+2] - xi;
                    float dy2 = py[j+2] - yi;
                    float dz2 = pz[j+2] - zi;
                    float sqrd_dist2 = dx2*dx2 + dy2*dy2 + dz2*dz2 + SOFTENING;
                    float inv_dist2 = 1.0f / sqrt(sqrd_dist2);
                    float inv_dist3_2 = inv_dist2 * inv_dist2 * inv_dist2;

                    float dx3 = px[j+3] - xi;
                    float dy3 = py[j+3] - yi;
                    float dz3 = pz[j+3] - zi;
                    float sqrd_dist3 = dx3*dx3 + dy3*dy3 + dz3*dz3 + SOFTENING;
                    float inv_dist3 = 1.0f / sqrt(sqrd_dist3);
                    float inv_dist3_3 = inv_dist3 * inv_dist3 * inv_dist3;

                    float dx4 = px[j+4] - xi;
                    float dy4 = py[j+4] - yi;
                    float dz4 = pz[j+4] - zi;
                    float sqrd_dist4 = dx4*dx4 + dy4*dy4 + dz4*dz4 + SOFTENING;
                    float inv_dist4 = 1.0f / sqrt(sqrd_dist4);
                    float inv_dist3_4 = inv_dist4 * inv_dist4 * inv_dist4;

                    float dx5 = px[j+5] - xi;
                    float dy5 = py[j+5] - yi;
                    float dz5 = pz[j+5] - zi;
                    float sqrd_dist5 = dx5*dx5 + dy5*dy5 + dz5*dz5 + SOFTENING;
                    float inv_dist5 = 1.0f / sqrt(sqrd_dist5);
                    float inv_dist3_5 = inv_dist5 * inv_dist5 * inv_dist5;

                    float dx6 = px[j+6] - xi;
                    float dy6 = py[j+6] - yi;
                    float dz6 = pz[j+6] - zi;
                    float sqrd_dist6 = dx6*dx6 + dy6*dy6 + dz6*dz6 + SOFTENING;
                    float inv_dist6 = 1.0f / sqrt(sqrd_dist6);
                    float inv_dist3_6 = inv_dist6 * inv_dist6 * inv_dist6;

                    float dx7 = px[j+7] - xi;
                    float dy7 = py[j+7] - yi;
                    float dz7 = pz[j+7] - zi;
                    float sqrd_dist7 = dx7*dx7 + dy7*dy7 + dz7*dz7 + SOFTENING;
                    float inv_dist7 = 1.0f / sqrt(sqrd_dist7);
                    float inv_dist3_7 = inv_dist7 * inv_dist7 * inv_dist7;

                    // Accumulate in strict j order
                    fx += dx0 * inv_dist3_0;
                    fy += dy0 * inv_dist3_0;
                    fz += dz0 * inv_dist3_0;

                    fx += dx1 * inv_dist3_1;
                    fy += dy1 * inv_dist3_1;
                    fz += dz1 * inv_dist3_1;

                    fx += dx2 * inv_dist3_2;
                    fy += dy2 * inv_dist3_2;
                    fz += dz2 * inv_dist3_2;

                    fx += dx3 * inv_dist3_3;
                    fy += dy3 * inv_dist3_3;
                    fz += dz3 * inv_dist3_3;

                    fx += dx4 * inv_dist3_4;
                    fy += dy4 * inv_dist3_4;
                    fz += dz4 * inv_dist3_4;

                    fx += dx5 * inv_dist3_5;
                    fy += dy5 * inv_dist3_5;
                    fz += dz5 * inv_dist3_5;

                    fx += dx6 * inv_dist3_6;
                    fy += dy6 * inv_dist3_6;
                    fz += dz6 * inv_dist3_6;

                    fx += dx7 * inv_dist3_7;
                    fy += dy7 * inv_dist3_7;
                    fz += dz7 * inv_dist3_7;
                }
                // Remainder
                for (; j < nbodies; ++j) {
                    float dx = px[j] - xi;
                    float dy = py[j] - yi;
                    float dz = pz[j] - zi;
                    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
                    float inv_dist = 1.0f / sqrt(sqrd_dist);
                    float inv_dist3 = inv_dist * inv_dist * inv_dist;
                    fx += dx * inv_dist3;
                    fy += dy * inv_dist3;
                    fz += dz * inv_dist3;
                }
                vx[i] += DT*fx;
                vy[i] += DT*fy;
                vz[i] += DT*fz;
            }

            #pragma omp for simd aligned(px,py,pz,vx,vy,vz:64)
            for (int i = 0; i < nbodies; ++i) {
                px[i] += vx[i] * DT;
                py[i] += vy[i] * DT;
                pz[i] += vz[i] * DT;
            }
        }
    }

    float *out = (float *)malloc(count * sizeof(float));
    if (!out) { perror("malloc"); exit(EXIT_FAILURE); }
    for (int i = 0; i < nbodies; ++i) {
        out[6*i]   = px[i];
        out[6*i+1] = py[i];
        out[6*i+2] = pz[i];
        out[6*i+3] = vx[i];
        out[6*i+4] = vy[i];
        out[6*i+5] = vz[i];
    }
    if (fwrite(out, count * sizeof(float), 1, stdout) != 1) {
        fprintf(stderr, "\nError writing to output\n");
        exit(EXIT_FAILURE);
    }

    free(px); free(py); free(pz); free(vx); free(vy); free(vz); free(out);
    return EXIT_SUCCESS;
}

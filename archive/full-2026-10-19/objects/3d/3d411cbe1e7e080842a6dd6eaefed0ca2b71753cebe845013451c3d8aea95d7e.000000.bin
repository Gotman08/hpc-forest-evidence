{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <algorithm>\\n#include <iostream>\\n#include <utility>\\n#include <vector>\\n\\nusing namespace std;\\n\\ntypedef vector<vector<bool>> adjacency_matrix;\\n\\nadjacency_matrix readGraph();\\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\\n                      const vector<int> &equivalence,\\n                      const vector<int> &degree_g1,\\n                      const vector<int> &degree_g2,\\n                      bool degree_filter_enabled);\\nbool nextHeapPermutation(vector<int> &equivalence,\\n                         vector<int> &exchange_counter,\\n                         int &exchange_index);\\ninline void printPermutation(const vector<int> &equivalence);\\n\\nint main() {\\n    adjacency_matrix g1 = readGraph();\\n    adjacency_matrix g2 = readGraph();\\n\\n    if (!testIsomorphism(g1, g2))\\n        cout << \\\"The graphs are not isomorphic\\\" << endl;\\n\\n    return 0;\\n}\\n\\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2) {\\n    if (g1.size() != g2.size()) return false;\\n\\n    const int n = static_cast<int>(g1.size());\\n    vector<int> degree_g1(n, 0);\\n    vector<int> degree_g2(n, 0);\\n    for (int i = 0; i < n; ++i) {\\n        for (int j = 0; j < n; ++j) {\\n            degree_g1[i] += g1[i][j];\\n            degree_g2[i] += g2[i][j];\\n        }\\n    }\\n\\n    vector<int> sorted_degree_g1 = degree_g1;\\n    vector<int> sorted_degree_g2 = degree_g2;\\n    sort(sorted_degree_g1.begin(), sorted_degree_g1.end());\\n    sort(sorted_degree_g2.begin(), sorted_degree_g2.end());\\n    if (sorted_degree_g1 != sorted_degree_g2) return false;\\n\\n    bool degree_filter_enabled = false;\\n    for (int i = 1; i < n; ++i) {\\n        if (degree_g1[i] != degree_g1[0]) {\\n            degree_filter_enabled = true;\\n            break;\\n        }\\n    }\\n\\n    vector<int> equivalence(n, 0);\\n    vector<int> exchange_counter(n, 0);\\n    for (int i = 0; i < n; ++i)\\n        equivalence[i] = i;\\n\\n    if (verifyPermutation(g1, g2, equivalence, degree_g1, degree_g2,\\n                          degree_filter_enabled)) {\\n        printPermutation(equivalence);\\n        return true;\\n    }\\n\\n    int exchange_index = 1;\\n    bool isomorphism_found = false;\\n\\n#ifdef _OPENMP\\n    if (g1.size() >= 32) {\\n        const size_t batch_size = 64;\\n        while (true) {\\n            vector<vector<int>> candidates;\\n            candidates.reserve(batch_size);\\n            while (candidates.size() < batch_size &&\\n                   nextHeapPermutation(equivalence, exchange_counter,\\n                                       exchange_index)) {\\n                candidates.push_back(equivalence);\\n            }\\n            if (candidates.empty()) break;\\n\\n            vector<unsigned char> matches(candidates.size(), 0);\\n            const int candidate_count = static_cast<int>(candidates.size());\\n#pragma omp parallel for schedule(dynamic, 4)\\n            for (int i = 0; i < candidate_count; ++i) {\\n                matches[i] = verifyPermutation(\\n                    g1, g2, candidates[i], degree_g1, degree_g2,\\n                    degree_filter_enabled);\\n            }\\n\\n            for (int i = 0; i < candidate_count; ++i) {\\n                if (matches[i]) {\\n                    printPermutation(candidates[i]);\\n                    isomorphism_found = true;\\n                }\\n            }\\n        }\\n    } else\\n#endif\\n    {\\n        while (nextHeapPermutation(equivalence, exchange_counter,\\n                                   exchange_index)) {\\n            if (verifyPermutation(g1, g2, equivalence, degree_g1, degree_g2,\\n                                  degree_filter_enabled)) {\\n                printPermutation(equivalence);\\n                isomorphism_found = true;\\n            }\\n        }\\n    }\\n\\n    return isomorphism_found;\\n}\\n\\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\\n                       const vector<int> &equivalence,\\n                       const vector<int> &degree_g1,\\n                       const vector<int> &degree_g2,\\n                       bool degree_filter_enabled) {\\n    if (degree_filter_enabled) {\\n        for (int i = 0; i < static_cast<int>(equivalence.size()); ++i) {\\n            if (degree_g1[i] != degree_g2[equivalence[i]]) return false;\\n        }\\n    }\\n\\n    for (int i = 0; i < static_cast<int>(equivalence.size()); ++i) {\\n        for (int j = 0; j <= i; ++j) {\\n            if (g1[i][j] != g2[equivalence[i]][equivalence[j]]) return false;\\n        }\\n    }\\n    return true;\\n}\\n\\nbool nextHeapPermutation(vector<int> &equivalence,\\n                         vector<int> &exchange_counter,\\n                         int &exchange_index) {\\n    const int n = static_cast<int>(equivalence.size());\\n    while (exchange_index < n) {\\n        if (exchange_counter[exchange_index] < exchange_index) {\\n            if (exchange_index % 2 == 0)\\n                swap(equivalence[0], equivalence[exchange_index]);\\n            else\\n                swap(equivalence[exchange_counter[exchange_index]],\\n                     equivalence[exchange_index]);\\n            ++exchange_counter[exchange_index];\\n            exchange_index = 1;\\n            return true;\\n        }\\n\\n        exchange_counter[exchange_index] = 0;\\n        ++exchange_index;\\n    }\\n    return false;\\n}\\n\\nadjacency_matrix readGraph() {\\n    int vertices, edges, source, destination;\\n\\n    cin >> vertices;\\n    adjacency_matrix read(vertices);\\n    for (int i = 0; i < vertices; ++i)\\n        read[i].resize(vertices);\\n\\n    cin >> edges;\\n    for (int i = 0; i < edges; i++) {\\n        cin >> source >> destination;\\n        read[destination][source] = read[source][destination] = true;\\n    }\\n\\n    return read;\\n}\\n\\ninline void printPermutation(const vector<int> &equivalence) {\\n    for (auto i : equivalence)\\n        cout << i << \\\" \\\";\\n    cout << endl;\\n}\\n\",\"path\":\"src/brute_isomorphism.cpp\"}],\"hypothesis\":\"A degree-multiset rejection and per-mapping degree filter can avoid many adjacency comparisons; for larger remaining searches, bounded OpenMP batches may speed independent checks while preserving Heap order during output.\",\"notes\":\"The OpenMP path is enabled for at least 32 vertices when compiled with OpenMP; smaller inputs and builds without OpenMP use serial enumeration. Matching permutations are emitted serially in the original order.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Compute row-sum degree multisets once and reject inputs with different multisets; check mapped degrees before adjacency comparisons when the degree sequence is nonuniform.\",\"Retain iterative Heap enumeration, verify at most 64 candidates per OpenMP dynamic-schedule batch for larger inputs, and emit matches in original order.\"]}"}}

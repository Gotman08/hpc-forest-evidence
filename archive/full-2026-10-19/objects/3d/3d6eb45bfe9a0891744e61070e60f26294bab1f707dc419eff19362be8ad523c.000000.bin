/*
  Quicksort
*/
#include <stdio.h>
#include <stdlib.h>
#include <limits.h>
#include <openssl/md5.h>


/*
 * Prototypes
 */
void srandnum(int seed);
double randnum(void);
int *generate_case(int N);
double drand(int xmin, int xmax);
void swap(int *toorder, int i, int j);
int partition(int *toorder, int lo, int hi);
void _quicksort(int *toorder, int lo, int hi);
void quicksort(int *toorder, int N);
int is_sorted(int *toorder, int N);

/*
 * A generic pRNG
 */
#define MY_RAND_MAX 0x7FFFFFFF

#define RANDNUM_W 521288629
#define RANDNUM_Z 362436069

unsigned int randum_w = RANDNUM_W;
unsigned int randum_z = RANDNUM_Z;

void srandnum(int seed)
{
    unsigned int w, z;
    w = (seed * 104623) & 0xffffffff;
    randum_w = (w) ? w : RANDNUM_W;
    z = (seed * 48947) & 0xffffffff;
    randum_z = (z) ? z : RANDNUM_Z;
}

double randnum(void)
{
    unsigned int u;
    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);
    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);
    u = (randum_z << 16) + randum_w;
    return (abs(u));
}

/*
 * Main function
 */
int main(int argc, char *argv[])
{
    int N = 0;
    int *our_list = NULL;

    //The input provides the case size
	scanf("%d", &N);
    if (N <= 0) {
	printf("Error: please, provide the case size.\n");
	return 1;
    }

    //Generate the case
    our_list = generate_case(N);
    if (our_list == NULL) {
	printf("Error: case instantiation failed.\n");
	return 1;
    }

    //Do the thing
    quicksort(our_list, N);

    if (is_sorted(our_list, N) == 1) {
	printf("Error, for some reason list is still unsorted.\n");
	return 1;
    }

#ifdef COMPUTE_MD5_PROBLEM
    //Compute MD5 Checksum for problem identification
    MD5_CTX c;
    unsigned char out[MD5_DIGEST_LENGTH];
    MD5_Init(&c);
    MD5_Update(&c, our_list, N * sizeof(int));
    MD5_Final(out, &c);
    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {
	printf("%02x", out[n]);
    }
#endif
    printf("\n");

    //Clean up
    free(our_list);

    return 0;
}

enum {
    INSERTION_SORT_THRESHOLD = 24,
    PARTITION_BLOCK_SIZE = 64
};

/*
 * Public API
 */
void quicksort(int *toorder, int N)
{
    if (N > 1)
        _quicksort(toorder, 0, N - 1);
}

/* Finish small, contiguous ranges while they are cache-resident. */
static void insertion_sort_range(int *toorder, int lo, int hi)
{
    for (int i = lo + 1; i <= hi; ++i) {
        int value = toorder[i];
        int j = i;
        while (j > lo && toorder[j - 1] > value) {
            toorder[j] = toorder[j - 1];
            --j;
        }
        toorder[j] = value;
    }
}

static void sift_down(int *toorder, int root, int count)
{
    int value = toorder[root];
    while (root < count / 2) {
        int child = 2 * root + 1;
        if (child + 1 < count && toorder[child] < toorder[child + 1])
            ++child;
        if (value >= toorder[child])
            break;
        toorder[root] = toorder[child];
        root = child;
    }
    toorder[root] = value;
}

/* In-place fallback for excessively unbalanced partitions. */
static void heap_sort_range(int *toorder, int lo, int hi)
{
    int *base = toorder + lo;
    int count = hi - lo + 1;
    for (int root = count / 2; root > 0; ) {
        --root;
        sift_down(base, root, count);
    }
    for (int end = count - 1; end > 0; --end) {
        swap(base, 0, end);
        sift_down(base, 0, end);
    }
}

static void introsort_range(int *toorder, int lo, int hi, int depth)
{
    while (hi - lo >= INSERTION_SORT_THRESHOLD) {
        if (depth == 0) {
            heap_sort_range(toorder, lo, hi);
            return;
        }
        --depth;
        int pivot = partition(toorder, lo, hi);

        /* Process the smaller working set first; iterate on the larger. */
        if (pivot - lo < hi - pivot) {
            if (lo < pivot)
                introsort_range(toorder, lo, pivot - 1, depth);
            lo = pivot + 1;
        } else {
            if (pivot < hi)
                introsort_range(toorder, pivot + 1, hi, depth);
            hi = pivot - 1;
        }
    }
    if (lo < hi)
        insertion_sort_range(toorder, lo, hi);
}

/*
 * Bounded-depth quicksort on an inclusive subrange.
 */
void _quicksort(int *toorder, int lo, int hi)
{
    if (lo >= hi)
        return;
    unsigned int count = (unsigned int)(hi - lo) + 1U;
    int depth = 0;
    while (count > 1U) {
        count >>= 1;
        depth += 2;
    }
    introsort_range(toorder, lo, hi, depth);
}

/*
 * Swap two values.
 */
void swap(int *toorder, int i, int j)
{
    int temp = toorder[i];
    toorder[i] = toorder[j];
    toorder[j] = temp;
}

/*
 * Two-sided block partition. Values equal to the pivot may go to either
 * side. The returned position contains the pivot; both sides exclude it.
 */
int partition(int *toorder, int lo, int hi)
{
    if (lo >= hi)
        return lo;

    int mid = lo + (hi - lo) / 2;
    int selected;
    if (toorder[lo] < toorder[mid]) {
        if (toorder[mid] < toorder[hi])
            selected = mid;
        else
            selected = toorder[lo] < toorder[hi] ? hi : lo;
    } else {
        if (toorder[lo] < toorder[hi])
            selected = lo;
        else
            selected = toorder[mid] < toorder[hi] ? hi : mid;
    }
    int pivot = toorder[selected];
    swap(toorder, selected, hi);

    int left = lo;
    int right = hi;
    unsigned char left_offsets[PARTITION_BLOCK_SIZE];
    unsigned char right_offsets[PARTITION_BLOCK_SIZE];
    int left_count = 0;
    int right_count = 0;
    int left_used = 0;
    int right_used = 0;

    /*
     * Classify two disjoint contiguous blocks into small offset queues,
     * then exchange misplaced pairs without a branch for each key.
     */
    while (right - left >= 2 * PARTITION_BLOCK_SIZE) {
        if (left_count == 0) {
            left_used = 0;
            for (int i = 0; i < PARTITION_BLOCK_SIZE; ++i) {
                left_offsets[left_count] = (unsigned char)i;
                left_count += (toorder[left + i] >= pivot);
            }
        }
        if (right_count == 0) {
            right_used = 0;
            for (int i = 0; i < PARTITION_BLOCK_SIZE; ++i) {
                right_offsets[right_count] = (unsigned char)i;
                right_count += (toorder[right - 1 - i] <= pivot);
            }
        }

        int pairs = left_count < right_count ? left_count : right_count;
        for (int i = 0; i < pairs; ++i) {
            swap(toorder,
                 left + left_offsets[left_used + i],
                 right - 1 - right_offsets[right_used + i]);
        }
        left_count -= pairs;
        right_count -= pairs;
        left_used += pairs;
        right_used += pairs;
        if (left_count == 0)
            left += PARTITION_BLOCK_SIZE;
        if (right_count == 0)
            right -= PARTITION_BLOCK_SIZE;
    }

    /* Unfinished blocks remain inside [left, right); rescan only this tail. */
    while (left < right) {
        while (left < right && toorder[left] < pivot)
            ++left;
        while (left < right && toorder[right - 1] > pivot)
            --right;
        if (left < right) {
            --right;
            swap(toorder, left, right);
            ++left;
        }
    }
    swap(toorder, left, hi);
    return left;
}

/*
 * Check if elements are in non-decreasing order
 */
int is_sorted(int *toorder, int N)
{
    for (int i = 1; i < N; i++) {
	if (toorder[i] < toorder[i - 1]) {
	    return 1;
	}
    }
    return 0;
}


/*
 * Generate a case
 */
int *generate_case(int N)
{
    int i;
    int *ret = NULL;

    // Make case generation reproducible
    srandnum(0);

    // Allocate memory
    ret = (int *) malloc(N * sizeof(int));
    if (ret == NULL) {
	printf("Error: some malloc won't work.\n");
	return NULL;
    }
    // Get pseudo-random positive integer values
    for (i = 0; i < N; i++) {
	ret[i] = drand(0, INT_MAX);
    }
    return ret;
}

/*
 * A pseudo-random number between two positive integer values
 */
double drand(int xmin, int xmax)
{
    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;
}

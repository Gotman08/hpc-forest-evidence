{"files":[{"content":"#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n/* Maximum size (in char) for neighbors and compute lists */\n#define MAX 100\n\ntypedef struct {\n  float value;\n  char neighbors[MAX];\n} Node;\n\n/* Reads input, allocates memory, writes graph size and node list. Returns the graph. */\nNode* read_input(char* fname, int *n, char* list, int **ids_out) {\n  Node* data = NULL;\n  int *ids = NULL;\n  FILE *fl = NULL;\n\n  *ids_out = NULL;\n  if (fname == NULL)\n    fl = stdin;\n  else\n    fl = fopen(fname, \"r\");\n\n  if (fl == NULL) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n\n  if (fscanf(fl, \"%d\", n) != 1) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n\n  list[0] = '\\0';\n  int ch = fgetc(fl);\n  if (ch != EOF && ch != '\\n') {\n    ungetc(ch, fl);\n    if (fgets(list, MAX, fl) == NULL)\n      list[0] = '\\0';\n    size_t used = strcspn(list, \"\\r\\n\");\n    if (list[used] != '\\0') {\n      list[used] = '\\0';\n    } else {\n      while ((ch = fgetc(fl)) != EOF && ch != '\\n')\n        ;\n    }\n  }\n\n  if (*n > 0) {\n    data = (Node*) malloc((size_t)(*n) * sizeof(Node));\n    ids = (int*) malloc((size_t)(*n) * sizeof(*ids));\n    if (data == NULL || ids == NULL) {\n      fprintf(stderr, \"Error!\\n\");\n      free(data);\n      free(ids);\n      fclose(fl);\n      exit(1);\n    }\n  }\n\n  for (int i = 0; i < *n; i++) {\n    data[i].neighbors[0] = '\\0';\n    if (fscanf(fl, \"%d %f\", &ids[i], &data[i].value) != 2) {\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }\n\n    ch = fgetc(fl);\n    if (ch != EOF && ch != '\\n') {\n      ungetc(ch, fl);\n      if (fgets(data[i].neighbors, MAX, fl) != NULL) {\n        size_t used = strcspn(data[i].neighbors, \"\\r\\n\");\n        if (data[i].neighbors[used] != '\\0') {\n          data[i].neighbors[used] = '\\0';\n        } else {\n          while ((ch = fgetc(fl)) != EOF && ch != '\\n')\n            ;\n        }\n      }\n    }\n  }\n\n  fclose(fl);\n  *ids_out = ids;\n  return data;\n}\n\n/* Returns the index of the first node with the given id or -1 if not found. */\nstatic int find_by_id(const int *ids, int id, int size) {\n  int first = size;\n\n  /* Contiguous ID loads allow SIMD while min preserves first-match semantics. */\n  #pragma omp simd reduction(min:first)\n  for (int i = 0; i < size; i++) {\n    int candidate = (ids[i] == id) ? i : size;\n    if (candidate < first)\n      first = candidate;\n  }\n\n  return first < size ? first : -1;\n}\n\n/* Selects the first neighbor having the greatest strictly positive node value. */\nstatic int find_best_neighbor(Node *g, const int *ids, int nd, int size) {\n  char aux[MAX];\n  char *saveptr = NULL;\n  int best = -1;\n  float max = 0.0f;\n\n  strcpy(aux, g[nd].neighbors);\n  char *t = strtok_r(aux, \" \", &saveptr);\n  while (t != NULL) {\n    int d = find_by_id(ids, atoi(t), size);\n    if (d >= 0 && max < g[d].value) {\n      max = g[d].value;\n      best = d;\n    }\n    t = strtok_r(NULL, \" \", &saveptr);\n  }\n\n  return best;\n}\n\n/* Computes and caches path sums by walking a dependency chain iteratively. */\nstatic float get_costly(Node *g, const int *ids, int id, int size, float *memo,\n                        unsigned char *computed, int *successor, int *path) {\n  int start = find_by_id(ids, id, size);\n  if (start < 0)\n    return 0.0f;\n\n  int current = start;\n  int depth = 0;\n  while (current >= 0 && !computed[current] && depth < size) {\n    path[depth++] = current;\n    if (successor[current] == -2)\n      successor[current] = find_best_neighbor(g, ids, current, size);\n    current = successor[current];\n  }\n\n  /* A valid input is a DAG; this guard also keeps malformed cycles in-bounds. */\n  if (current >= 0 && !computed[current])\n    return 0.0f;\n\n  float total = current >= 0 ? memo[current] : 0.0f;\n  while (depth > 0) {\n    int nd = path[--depth];\n    total = g[nd].value + total;\n    memo[nd] = total;\n    computed[nd] = 1;\n  }\n\n  return memo[start];\n}\n\n/* Main program - calls read input, computes sum for each node in the list, prints output. */\nint main(void) {\n  char *fileN = NULL;\n  char computelist[MAX] = {0};\n  int n = -1;\n  int *ids = NULL;\n  Node* input = read_input(fileN, &n, computelist, &ids);\n  float *memo = NULL;\n  unsigned char *computed = NULL;\n  int *successor = NULL;\n  int *path = NULL;\n\n  if (n > 0) {\n    memo = (float*) calloc((size_t)n, sizeof(*memo));\n    computed = (unsigned char*) calloc((size_t)n, sizeof(*computed));\n    successor = (int*) malloc((size_t)n * sizeof(*successor));\n    path = (int*) malloc((size_t)n * sizeof(*path));\n    if (memo == NULL || computed == NULL || successor == NULL || path == NULL) {\n      fprintf(stderr, \"Error!\\n\");\n      free(input);\n      free(ids);\n      free(memo);\n      free(computed);\n      free(successor);\n      free(path);\n      return 1;\n    }\n    for (int i = 0; i < n; i++)\n      successor[i] = -2;\n  }\n\n  for (char *c = strtok(computelist, \" \"); c != NULL; c = strtok(NULL, \" \"))\n    printf(\"%s: %f\\n\", c,\n           get_costly(input, ids, atoi(c), n, memo, computed, successor, path));\n\n  free(input);\n  free(ids);\n  free(memo);\n  free(computed);\n  free(successor);\n  free(path);\n  return 0;\n}\n","path":"src/graph.c"}],"hypothesis":"Storing node IDs in a packed contiguous array should make the existing OpenMP SIMD minimum-reduction lookup scan cheaper than loading IDs with the large stride of the Node array, while preserving earliest-match behavior and all graph traversal semantics.","notes":"Not executed; correctness and performance remain for controller evaluation on the supplied target.","sources_kept":[],"transformations":["Move node IDs from the array-of-structures Node records into a separately allocated contiguous integer array populated during input parsing.","Use the packed ID array in the existing SIMD minimum-reduction lookup; retain the earliest matching index and leave neighbor selection and path-sum dependencies unchanged."]}
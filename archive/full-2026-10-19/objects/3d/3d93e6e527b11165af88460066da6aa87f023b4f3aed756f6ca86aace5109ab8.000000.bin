{
  "src/knn.c": "#include \"knn.h\"\n#include <limits.h>\n#include <math.h>\n\ntypedef struct {\n    float distance;\n    char label;\n    unsigned long long order;\n} Candidate;\n\nstatic inline int candidate_is_worse(const Candidate *a, const Candidate *b) {\n    if (a->distance > b->distance) {\n        return 1;\n    }\n    if (a->distance < b->distance) {\n        return 0;\n    }\n    return a->order > b->order;\n}\n\nstatic void heap_push_max(Candidate *heap, int index, Candidate candidate) {\n    while (index > 0) {\n        int parent = (index - 1) / 2;\n        if (!candidate_is_worse(&candidate, &heap[parent])) {\n            break;\n        }\n        heap[index] = heap[parent];\n        index = parent;\n    }\n    heap[index] = candidate;\n}\n\nstatic void heap_replace_max_root(Candidate *heap, int heap_size, Candidate candidate) {\n    int index = 0;\n\n    while (index < heap_size / 2) {\n        int child = index * 2 + 1;\n        int right = child + 1;\n\n        if (right < heap_size && candidate_is_worse(&heap[right], &heap[child])) {\n            child = right;\n        }\n        if (!candidate_is_worse(&heap[child], &candidate)) {\n            break;\n        }\n\n        heap[index] = heap[child];\n        index = child;\n    }\n    heap[index] = candidate;\n}\n\nstatic void heap_push_min(Candidate *heap, int index, Candidate candidate) {\n    while (index > 0) {\n        int parent = (index - 1) / 2;\n        if (!candidate_is_worse(&heap[parent], &candidate)) {\n            break;\n        }\n        heap[index] = heap[parent];\n        index = parent;\n    }\n    heap[index] = candidate;\n}\n\nstatic void heap_replace_min_root(Candidate *heap, int heap_size, Candidate candidate) {\n    int index = 0;\n\n    while (index < heap_size / 2) {\n        int child = index * 2 + 1;\n        int right = child + 1;\n\n        if (right < heap_size && candidate_is_worse(&heap[child], &heap[right])) {\n            child = right;\n        }\n        if (!candidate_is_worse(&candidate, &heap[child])) {\n            break;\n        }\n\n        heap[index] = heap[child];\n        index = child;\n    }\n    heap[index] = candidate;\n}\n\nstatic char mode_from_labels(char *labels, int k) {\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nstatic char knn_original(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *) malloc(sizeof(char) * k);\n    float *distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    char result = mode_from_labels(labels, k);\n    free(distances);\n    free(labels);\n    return result;\n}\n\nstatic char mode_from_counts(const unsigned long long *counts) {\n    char most_frequent = 0;\n    unsigned long long most_frequent_count = 0;\n\n    for (int value = 0; value <= UCHAR_MAX; value++) {\n        unsigned long long count = counts[value];\n        if (count != 0) {\n            char label = (char) (unsigned char) value;\n            if (count > most_frequent_count ||\n                (count == most_frequent_count &&\n                 compare_for_sort(&label, &most_frequent) < 0)) {\n                most_frequent = label;\n                most_frequent_count = count;\n            }\n        }\n    }\n\n    return most_frequent;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) {\n        return knn_original(n_groups, groups, k, to_evaluate);\n    }\n\n    unsigned long long total_points = 0;\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length > 0) {\n            total_points += (unsigned long long) groups[i].length;\n        }\n    }\n\n    int use_complement =\n        total_points >= (unsigned long long) k &&\n        total_points - (unsigned long long) k < (unsigned long long) k;\n    int heap_capacity = use_complement\n        ? (int) (total_points - (unsigned long long) k)\n        : k;\n\n    Candidate *heap = NULL;\n    if (heap_capacity > 0) {\n        heap = (Candidate *) malloc(sizeof(Candidate) * (size_t) heap_capacity);\n        if (heap == NULL) {\n            return knn_original(n_groups, groups, k, to_evaluate);\n        }\n    }\n\n    unsigned long long counts[UCHAR_MAX + 1] = {0};\n    int heap_size = 0;\n    unsigned long long order = 0;\n\n    if (use_complement) {\n        for (int i = 0; i < n_groups; i++) {\n            const Group *g = &groups[i];\n\n            for (int j = 0; j < g->length; j++) {\n                float d = euclidean_distance_no_sqrt(to_evaluate, g->points[j]);\n                if (!isfinite(d) || d < 0.0f) {\n                    free(heap);\n                    return knn_original(n_groups, groups, k, to_evaluate);\n                }\n\n                Candidate candidate;\n                candidate.distance = d;\n                candidate.label = g->label;\n                candidate.order = order++;\n                counts[(unsigned char) candidate.label]++;\n\n                if (heap_size < heap_capacity) {\n                    heap_push_min(heap, heap_size, candidate);\n                    heap_size++;\n                } else if (heap_capacity > 0 &&\n                           candidate_is_worse(&candidate, &heap[0])) {\n                    heap_replace_min_root(heap, heap_size, candidate);\n                }\n            }\n        }\n\n        for (int i = 0; i < heap_size; i++) {\n            counts[(unsigned char) heap[i].label]--;\n        }\n    } else {\n        for (int i = 0; i < n_groups; i++) {\n            const Group *g = &groups[i];\n\n            for (int j = 0; j < g->length; j++) {\n                float d = euclidean_distance_no_sqrt(to_evaluate, g->points[j]);\n                if (!isfinite(d) || d < 0.0f) {\n                    free(heap);\n                    return knn_original(n_groups, groups, k, to_evaluate);\n                }\n\n                Candidate candidate;\n                candidate.distance = d;\n                candidate.label = g->label;\n                candidate.order = order++;\n\n                if (heap_size < k) {\n                    heap_push_max(heap, heap_size, candidate);\n                    counts[(unsigned char) candidate.label]++;\n                    heap_size++;\n                } else if (candidate_is_worse(&heap[0], &candidate)) {\n                    counts[(unsigned char) heap[0].label]--;\n                    counts[(unsigned char) candidate.label]++;\n                    heap_replace_max_root(heap, heap_size, candidate);\n                }\n            }\n        }\n\n        if (heap_size < k) {\n            char empty_label = (char) -1;\n            counts[(unsigned char) empty_label] +=\n                (unsigned long long) (k - heap_size);\n        }\n    }\n\n    char result = mode_from_counts(counts);\n    free(heap);\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
  "src/knn.h": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}"
}

      "content": "#include \"knn.h\"\n#include <limits.h>\n\n/* Distance and group index occupy one compact heap entry. Points with\n   equal distances within the same group have interchangeable labels. */\ntypedef struct {\n    float distance;\n    int group_index;\n} KNNNeighbor;\n\nstatic int knn_worse(KNNNeighbor a, KNNNeighbor b) {\n    return a.distance > b.distance ||\n           (a.distance == b.distance && a.group_index > b.group_index);\n}\n\nstatic void knn_sift_down(KNNNeighbor *heap, int size, int root,\n                          KNNNeighbor value) {\n    /* This bound also keeps the child-index arithmetic within int. */\n    while (root < size / 2) {\n        int child = 2 * root + 1;\n        if (child + 1 < size && knn_worse(heap[child + 1], heap[child])) {\n            child++;\n        }\n        if (!knn_worse(heap[child], value)) {\n            break;\n        }\n        heap[root] = heap[child];\n        root = child;\n    }\n    heap[root] = value;\n}\n\nstatic char knn_vote(const int *frequencies) {\n    char result = (char)CHAR_MIN;\n    int highest = 0;\n\n    /* Match compare_for_sort, including the target's plain-char signedness. */\n    for (int label = CHAR_MIN; label <= CHAR_MAX; label++) {\n        int count = frequencies[(unsigned char)(char)label];\n        if (count > highest) {\n            highest = count;\n            result = (char)label;\n        }\n    }\n    return result;\n}\n\n/* Preserve the original insertion semantics when an initial NaN prevents\n   the retained distances from having an ordinary sorted ordering. */\nstatic char knn_reference(int n_groups, Group *groups, int k,\n                          Point to_evaluate) {\n    char *labels = (char *)malloc(sizeof(char) * k);\n    float *distances = (float *)malloc(sizeof(float) * k);\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) {\n        return knn_reference(n_groups, groups, k, to_evaluate);\n    }\n\n    if (k == 1) {\n        float best_distance = -1;\n        char best_label = -1;\n        for (int i = 0; i < n_groups; i++) {\n            Group g = groups[i];\n            for (int j = 0; j < g.length; j++) {\n                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n                if (d < best_distance || best_distance == -1) {\n                    best_distance = d;\n                    best_label = g.label;\n                }\n            }\n        }\n        return best_label;\n    }\n\n    /* Count only while the total fits in k, avoiding a potentially\n       overflowing sum of all group lengths. */\n    int total = 0;\n    int all_fit = 1;\n    for (int i = 0; i < n_groups; i++) {\n        int length = groups[i].length;\n        if (length <= 0) {\n            continue;\n        }\n        if (length > k - total) {\n            all_fit = 0;\n            break;\n        }\n        total += length;\n    }\n\n    int frequencies[UCHAR_MAX + 1] = {0};\n    if (all_fit) {\n        /* Before capacity is reached, every point is retained, even a\n           NaN-distance point. Remaining slots retain the original label. */\n        for (int i = 0; i < n_groups; i++) {\n            if (groups[i].length > 0) {\n                frequencies[(unsigned char)groups[i].label] += groups[i].length;\n            }\n        }\n        frequencies[(unsigned char)(char)-1] += k - total;\n        return knn_vote(frequencies);\n    }\n\n    KNNNeighbor *heap = (KNNNeighbor *)malloc((size_t)k * sizeof(*heap));\n    if (heap == NULL) {\n        return knn_reference(n_groups, groups, k, to_evaluate);\n    }\n\n    int used = 0;\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            if (used < k) {\n                if (d != d) {\n                    free(heap);\n                    return knn_reference(n_groups, groups, k, to_evaluate);\n                }\n                heap[used].distance = d;\n                heap[used].group_index = i;\n                used++;\n\n                if (used == k) {\n                    for (int parent = used / 2; parent > 0;) {\n                        parent--;\n                        KNNNeighbor value = heap[parent];\n                        knn_sift_down(heap, used, parent, value);\n                    }\n                }\n            } else if (d < heap[0].distance) {\n                /* Equal-distance newcomers occur later and cannot improve\n                   the retained set. NaNs are also rejected here, exactly\n                   as by a full reference list containing no NaNs. */\n                KNNNeighbor value;\n                value.distance = d;\n                value.group_index = i;\n                knn_sift_down(heap, used, 0, value);\n            }\n        }\n    }\n\n    for (int i = 0; i < used; i++) {\n        frequencies[(unsigned char)groups[heap[i].group_index].label]++;\n    }\n    frequencies[(unsigned char)(char)-1] += k - used;\n    free(heap);\n    return knn_vote(frequencies);\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }

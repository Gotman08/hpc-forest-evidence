#include <algorithm>
#include <iostream>
#include <vector>

constexpr int MOD = 1000000007;

int main() {
    std::ios::sync_with_stdio(false);
    std::cin.tie(nullptr);

    int n, m;
    if (!(std::cin >> n >> m)) return 0;

    std::vector<std::vector<int>> blockedColumns(n);
    for (int c = 0; c < m; ++c) {
        int row, column;
        std::cin >> row >> column;
        blockedColumns[row].push_back(column);
    }

    std::vector<int> dp(n, 0);
    dp[0] = 1;

    for (int row = 0; row < n; ++row) {
        auto& columns = blockedColumns[row];
        std::sort(columns.begin(), columns.end());
        columns.erase(std::unique(columns.begin(), columns.end()), columns.end());

        int left = 0;
        int column = 0;
        for (int blocked : columns) {
            for (; column < blocked; ++column) {
                int sum = dp[column] + left;
                if (sum >= MOD) sum -= MOD;
                dp[column] = sum;
                left = sum;
            }
            dp[blocked] = 0;
            left = 0;
            column = blocked + 1;
        }
        for (; column < n; ++column) {
            int sum = dp[column] + left;
            if (sum >= MOD) sum -= MOD;
            dp[column] = sum;
            left = sum;
        }
    }

    std::cout << dp[n - 1] << '\n';
    return 0;
}

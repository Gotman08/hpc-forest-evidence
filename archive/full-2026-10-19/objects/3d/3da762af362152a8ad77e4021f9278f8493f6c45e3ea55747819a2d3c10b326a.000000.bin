      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <cstring>\n#include <limits>\n#include <memory>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nnamespace {\nclass FastInput {\n    unsigned char buffer[65536];\n    std::size_t position = 0;\n    std::size_t length = 0;\n\n    int next() {\n        if (position == length) {\n            length = std::fread(buffer, 1, sizeof(buffer), stdin);\n            position = 0;\n            if (length == 0) return EOF;\n        }\n        return buffer[position++];\n    }\n\npublic:\n    bool read(std::uint32_t& value) {\n        int c = next();\n        while (c != EOF && c <= ' ') c = next();\n        if (c == EOF) return false;\n        const bool negative = c == '-';\n        if (c == '-' || c == '+') c = next();\n        std::uint32_t magnitude = 0;\n        while (c >= '0' && c <= '9') {\n            magnitude = magnitude * 10u + static_cast<unsigned>(c - '0');\n            c = next();\n        }\n        value = negative ? 0u - magnitude : magnitude;\n        return true;\n    }\n};\n\ninline int signedValue(std::uint32_t bits) {\n    std::int32_t value;\n    std::memcpy(&value, &bits, sizeof(value));\n    return static_cast<int>(value);\n}\n}\n\nint main() {\n    FastInput input;\n    std::uint32_t nBits, sBits;\n    if (!input.read(nBits) || !input.read(sBits)) return 0;\n    const int n = signedValue(nBits);\n    const int s = signedValue(sBits);\n    assert(n > 0 && n < 8000 && s > 0 && s < n);\n\n    const std::size_t stride = (static_cast<std::size_t>(n) + 15) & ~std::size_t(15);\n    const std::size_t count = static_cast<std::size_t>(n) * stride;\n    std::unique_ptr<std::uint32_t[]> storage(new std::uint32_t[count + 15]);\n    const std::uintptr_t address = reinterpret_cast<std::uintptr_t>(storage.get());\n    const std::size_t offset = ((64u - (address & 63u)) & 63u) / sizeof(std::uint32_t);\n    std::uint32_t* matrix = storage.get() + offset;\n    for (int i = 0; i < n; ++i) {\n        std::uint32_t* row = matrix + static_cast<std::size_t>(i) * stride;\n        for (int j = 0; j < n; ++j) {\n            if (!input.read(row[j])) return 0;\n        }\n    }\n\n    const int outputRows = n - s + 1;\n    const int columnBlocks = (n + 15) / 16;\n    int best = std::numeric_limits<int>::min();\n\n    #pragma omp parallel if(count >= 65536) reduction(max:best)\n    {\n        int thread = 0;\n        int threads = 1;\n        #ifdef _OPENMP\n        thread = omp_get_thread_num();\n        threads = omp_get_num_threads();\n        #endif\n\n        const int firstBlock = columnBlocks * thread / threads;\n        const int lastBlock = columnBlocks * (thread + 1) / threads;\n        const int blockCount = lastBlock - firstBlock;\n        const int tiles = (blockCount + 31) / 32;\n        alignas(64) std::uint32_t columns[512];\n\n        for (int tile = 0; tile < tiles; ++tile) {\n            const int left = (firstBlock + blockCount * tile / tiles) * 16;\n            const int right = std::min(n, (firstBlock + blockCount * (tile + 1) / tiles) * 16);\n            const int width = right - left;\n\n            #pragma omp simd\n            for (int j = 0; j < width; ++j) columns[j] = 0;\n\n            for (int i = 0; i < s; ++i) {\n                const std::uint32_t* row = matrix + static_cast<std::size_t>(i) * stride + left;\n                #pragma omp simd aligned(columns,row:64)\n                for (int j = 0; j < width; ++j) columns[j] += row[j];\n            }\n\n            for (int i = 0; i + 1 < outputRows; ++i) {\n                std::uint32_t* leaving = matrix + static_cast<std::size_t>(i) * stride + left;\n                const std::uint32_t* entering = matrix + static_cast<std::size_t>(i + s) * stride + left;\n                #pragma omp simd aligned(columns,leaving,entering:64)\n                for (int j = 0; j < width; ++j) {\n                    const std::uint32_t current = columns[j];\n                    const std::uint32_t next = current + entering[j] - leaving[j];\n                    leaving[j] = current;\n                    columns[j] = next;\n                }\n            }\n\n            std::uint32_t* last = matrix + static_cast<std::size_t>(outputRows - 1) * stride + left;\n            #pragma omp simd aligned(columns,last:64)\n            for (int j = 0; j < width; ++j) last[j] = columns[j];\n        }\n\n        #pragma omp barrier\n        #pragma omp for schedule(static)\n        for (int i = 0; i < outputRows; ++i) {\n            const std::uint32_t* row = matrix + static_cast<std::size_t>(i) * stride;\n            std::uint32_t sum = 0;\n            #pragma omp simd aligned(row:64) reduction(+:sum)\n            for (int j = 0; j < s; ++j) sum += row[j];\n            int rowBest = signedValue(sum);\n            for (int j = s; j < n; ++j) {\n                sum += row[j] - row[j - s];\n                rowBest = std::max(rowBest, signedValue(sum));\n            }\n            best = std::max(best, rowBest);\n        }\n    }\n\n    std::printf(\"%d\\n\", best);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

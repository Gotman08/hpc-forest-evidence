"""Preserve the full delivered Astra edition before any Terra admission."""
import hashlib
import json
import shutil
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
STUDY = HERE.parents[1]
WORKSPACE = STUDY.parents[1]
VERSION = STUDY / "versions/20261017-avant-terra-double-professionnelle"


def sha(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def main():
    assert not VERSION.exists()
    manifest = json.loads((STUDY / "edition-professionnelle/manifeste-edition.json").read_text(encoding="utf-8-sig"))
    assert manifest["main_pages"] == 17 and manifest["supplement_pages"] == 259
    assert all(sha(STUDY / name) == digest for name, digest in manifest["files"].items())
    files = {STUDY / name for name in manifest["files"]}
    files |= {STUDY / name for name in ["ARTICLE.md", "ARTICLE.html", "ARTICLE.pdf", "ANNEXES-TECHNIQUES.md", "ANNEXES-TECHNIQUES.html", "ANNEXES-TECHNIQUES.pdf", "construire-pdf.py", "donnees-consolidees.json"]}
    for folder in ["edition-professionnelle", "figures"]:
        files |= {p for p in (STUDY / folder).rglob("*") if p.is_file()}
    VERSION.mkdir(parents=True)
    saved = {}
    for path in sorted(files):
        assert not path.is_symlink()
        name = path.relative_to(STUDY).as_posix()
        target = VERSION / name
        target.parent.mkdir(parents=True, exist_ok=True)
        digest = sha(path)
        shutil.copy2(path, target)
        assert sha(target) == digest
        saved[name] = digest
    extra = {"ID.md": WORKSPACE / "ID.md", "automation-avant.toml": Path("C:/Users/nicol/.codex/automations/terminer-les-essais-deepseek-sur-romeo/automation.toml")}
    for name, path in extra.items():
        shutil.copy2(path, VERSION / name)
        assert sha(VERSION / name) == sha(path)
    proof = {"schema": "hpc-forest-professional-version-preservation-v1", "preserved_utc": datetime.now(UTC).isoformat(),
        "main_pages": 17, "supplement_pages": 259, "all_copied_bytes_verified": True, "copied_files": len(saved) + len(extra),
        "previous_manifest_sha256": sha(STUDY / "edition-professionnelle/manifeste-edition.json"),
        "files": saved, "extra_snapshots": {name: sha(VERSION / name) for name in extra}, "previous_manifest": manifest}
    (VERSION / "PRESERVATION.json").write_text(json.dumps(proof, ensure_ascii=True, indent=2) + "\n", encoding="utf-8")
    print(json.dumps({"preserved_files": proof["copied_files"], "version": str(VERSION)}))


if __name__ == "__main__":
    main()

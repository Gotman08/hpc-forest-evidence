      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n\n/* Maximum size (in char) for neighbors and compute lists */\n#define MAX 100\n\ntypedef struct {\n  int id;\n  float value;\n  char neighbors[MAX];\n} Node;\n\ntypedef struct {\n  int id;\n  int node;\n} IdSlot;\n\nstatic void fail(void) {\n  fprintf(stderr, \"Error!\\n\");\n  exit(1);\n}\n\n/* Reads input, allocates memory, writes graph size and node list. Returns the graph. */\nNode* read_input(char* fname, int *n, char* list) {\n  Node* data = NULL;\n  FILE *fl = NULL;\n\n  if (fname == NULL)\n    fl = stdin;\n  else\n    fl = fopen(fname, \"r\");\n\n  if (fl == NULL)\n    fail();\n\n  fscanf(fl, \"%d %[^\\n]\", n, list);\n\n  if (*n > 0) {\n    data = (Node*)malloc((size_t)*n * sizeof(*data));\n    if (data == NULL)\n      fail();\n  }\n\n  for (int i = 0; i < *n; i++)\n    fscanf(fl, \"%d %f %[^\\n]\", &data[i].id, &data[i].value, data[i].neighbors);\n\n  fclose(fl);\n  return data;\n}\n\nstatic size_t table_capacity(int count) {\n  size_t capacity = 1;\n  size_t needed = (size_t)count * 2U;\n\n  while (capacity < needed)\n    capacity <<= 1;\n\n  return capacity;\n}\n\nstatic size_t id_hash(int id, size_t mask) {\n  uint32_t x = (uint32_t)id;\n\n  x ^= x >> 16;\n  x *= UINT32_C(0x7feb352d);\n  x ^= x >> 15;\n  x *= UINT32_C(0x846ca68b);\n  x ^= x >> 16;\n\n  return (size_t)x & mask;\n}\n\n/* Build a first-occurrence ID index while copying values into a compact array. */\nstatic void build_lookup(const Node *nodes, int size, IdSlot *ids,\n                         size_t mask, float *values) {\n  for (int i = 0; i < size; i++) {\n    size_t position;\n\n    values[i] = nodes[i].value;\n    position = id_hash(nodes[i].id, mask);\n    for (;;) {\n      IdSlot *slot = &ids[position];\n\n      if (slot->node < 0) {\n        slot->id = nodes[i].id;\n        slot->node = i;\n        break;\n      }\n      if (slot->id == nodes[i].id)\n        break;\n      position = (position + 1) & mask;\n    }\n  }\n}\n\n/* Returns the first input node with id, matching the original linear search. */\nstatic int find_by_id(const IdSlot *ids, size_t mask, int id) {\n  size_t position = id_hash(id, mask);\n\n  for (;;) {\n    const IdSlot *slot = &ids[position];\n\n    if (slot->node < 0)\n      return -1;\n    if (slot->id == id)\n      return slot->node;\n    position = (position + 1) & mask;\n  }\n}\n\n/* Parse and cache the successor selected by the original strict maximum rule. */\nstatic int select_successor(const Node *nodes, const float *values, int node,\n                            const IdSlot *ids, size_t mask, int *successors) {\n  char neighbors[MAX];\n  char *state;\n  char *token;\n  int selected = -1;\n  float maximum = 0.0f;\n\n  if (successors[node] != -2)\n    return successors[node];\n\n  strcpy(neighbors, nodes[node].neighbors);\n  token = strtok_r(neighbors, \" \", &state);\n  if (token != NULL) {\n    do {\n      int neighbor = find_by_id(ids, mask, atoi(token));\n\n      if (neighbor >= 0 && maximum < values[neighbor]) {\n        maximum = values[neighbor];\n        selected = neighbor;\n      }\n    } while ((token = strtok_r(NULL, \" \", &state)) != NULL);\n  }\n\n  successors[node] = selected;\n  return selected;\n}\n\n/* Resolve a functional DAG path once, storing every suffix cost encountered. */\nstatic float get_cached_cost(const Node *nodes, const float *values, int start,\n                             const IdSlot *ids, size_t mask, int *successors,\n                             float *costs, unsigned char *done, int *path) {\n  int current;\n  int length = 0;\n  float total;\n\n  if (start < 0)\n    return 0.0f;\n  if (done[start])\n    return costs[start];\n\n  current = start;\n  while (current >= 0 && !done[current]) {\n    path[length++] = current;\n    current = select_successor(nodes, values, current, ids, mask, successors);\n  }\n\n  total = current >= 0 ? costs[current] : 0.0f;\n  while (length > 0) {\n    int node = path[--length];\n\n    total = values[node] + total;\n    costs[node] = total;\n    done[node] = 1;\n  }\n\n  return costs[start];\n}\n\n/* Main program - calls read input, computes sum for each node in the list, prints output */\nint main() {\n  char *fileN = NULL;\n  char computelist[MAX];\n  int n = -1;\n  Node *input;\n  size_t capacity;\n  size_t mask;\n  IdSlot *ids;\n  float *values = NULL;\n  int *successors = NULL;\n  float *costs = NULL;\n  unsigned char *done = NULL;\n  int *path = NULL;\n\n  input = read_input(fileN, &n, computelist);\n\n  capacity = table_capacity(n);\n  mask = capacity - 1;\n  ids = (IdSlot*)malloc(capacity * sizeof(*ids));\n  if (ids == NULL)\n    fail();\n  for (size_t i = 0; i < capacity; i++)\n    ids[i].node = -1;\n\n  if (n > 0) {\n    values = (float*)malloc((size_t)n * sizeof(*values));\n    successors = (int*)malloc((size_t)n * sizeof(*successors));\n    costs = (float*)malloc((size_t)n * sizeof(*costs));\n    done = (unsigned char*)calloc((size_t)n, sizeof(*done));\n    path = (int*)malloc((size_t)n * sizeof(*path));\n    if (values == NULL || successors == NULL || costs == NULL ||\n        done == NULL || path == NULL)\n      fail();\n    for (int i = 0; i < n; i++)\n      successors[i] = -2;\n  }\n\n  build_lookup(input, n, ids, mask, values);\n\n  for (char *c = strtok(computelist, \" \"); c != NULL; c = strtok(NULL, \" \")) {\n    int node = find_by_id(ids, mask, atoi(c));\n\n    printf(\"%s: %f\\n\", c, get_cached_cost(input, values, node, ids, mask,\n                                           successors, costs, done, path));\n  }\n\n  free(path);\n  free(done);\n  free(costs);\n  free(successors);\n  free(values);\n  free(ids);\n  free(input);\n\n  return 0;\n}\n",
      "path": "src/graph.c"
    }
  ],
  "hypothesis": "A compact first-ID hash index plus lazily cached selected successors and reverse path memoization removes repeated full-node scans and keeps repeatedly accessed values, successor links, and costs in dense arrays.",
  "notes": "Preserves first matching IDs, strict positive neighbor selection, neighbor order, float recurrence order, and query output order for the DAG input contract.",

{
  "src/solution.cpp": "#include <algorithm>\n#include <cstddef>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nnamespace {\nconstexpr int MOD = 1000000007;\nconstexpr int TILE_ROWS = 64;\nconstexpr int TILE_COLS = 256;\n\ninline int add_mod(int a, int b) {\n    const int sum = a + b;\n    return sum >= MOD ? sum - MOD : sum;\n}\n\ninline int advance_row(int* values, int width,\n                       const std::uint64_t* masks, int left) {\n    int x = 0;\n    while (x < width) {\n        const int count = std::min(64, width - x);\n        std::uint64_t mask = *masks++;\n        int* segment = values + x;\n        if (mask == 0) {\n            for (int j = 0; j < count; ++j) {\n                left = add_mod(segment[j], left);\n                segment[j] = left;\n            }\n        } else {\n            for (int j = 0; j < count; ++j) {\n                int value = add_mod(segment[j], left);\n                if ((mask & 1) != 0) value = 0;\n                segment[j] = value;\n                left = value;\n                mask >>= 1;\n            }\n        }\n        x += count;\n    }\n    return left;\n}\n\ninline void advance_tile(const std::uint64_t* blocked,\n                         std::size_t words_per_row, int n,\n                         int tile_row, int tile_col,\n                         int* top, int* right, int* scratch) {\n    const int y0 = tile_row * TILE_ROWS;\n    const int y1 = std::min(n, y0 + TILE_ROWS);\n    const int x0 = tile_col * TILE_COLS;\n    const int x1 = std::min(n, x0 + TILE_COLS);\n    const int width = x1 - x0;\n\n    std::copy(top + x0, top + x1, scratch);\n    const std::uint64_t* masks = blocked\n        + static_cast<std::size_t>(y0) * words_per_row + x0 / 64;\n    for (int y = y0; y < y1; ++y) {\n        right[y] = advance_row(scratch, width, masks, right[y]);\n        masks += words_per_row;\n    }\n    std::copy(scratch, scratch + width, top + x0);\n}\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n, m;\n    if (!(std::cin >> n >> m)) return 0;\n\n    const std::size_t words_per_row =\n        (static_cast<std::size_t>(n) + 63) / 64;\n    std::vector<std::uint64_t> blocked(\n        static_cast<std::size_t>(n) * words_per_row, 0);\n    for (int k = 0; k < m; ++k) {\n        int y, x;\n        std::cin >> y >> x;\n        blocked[static_cast<std::size_t>(y) * words_per_row + x / 64]\n            |= std::uint64_t(1) << (x % 64);\n    }\n\n    std::vector<int> top(n, 0);\n    // A single incoming path seeds the origin; a blocked origin clears it.\n    top[0] = 1;\n\n    const int tile_rows = (n + TILE_ROWS - 1) / TILE_ROWS;\n    const int tile_cols = (n + TILE_COLS - 1) / TILE_COLS;\n    int max_threads = 1;\n#ifdef _OPENMP\n    max_threads = omp_get_max_threads();\n#endif\n    const int workers = std::min(max_threads, tile_cols);\n\n    if (n < 1024 || workers < 2) {\n        for (int y = 0; y < n; ++y) {\n            advance_row(top.data(), n,\n                        blocked.data()\n                            + static_cast<std::size_t>(y) * words_per_row,\n                        0);\n        }\n    } else {\n        std::vector<int> right(n, 0);\n#ifdef _OPENMP\n#pragma omp parallel num_threads(workers)\n#endif\n        {\n            int scratch[TILE_COLS];\n            for (int diagonal = 0;\n                 diagonal < tile_rows + tile_cols - 1; ++diagonal) {\n                const int first_row = std::max(0, diagonal - tile_cols + 1);\n                const int last_row = std::min(tile_rows - 1, diagonal);\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n                for (int tile_row = first_row;\n                     tile_row <= last_row; ++tile_row) {\n                    const int tile_col = diagonal - tile_row;\n                    advance_tile(blocked.data(), words_per_row, n,\n                                 tile_row, tile_col,\n                                 top.data(), right.data(), scratch);\n                }\n                // The worksharing barrier publishes both boundary frontiers.\n            }\n        }\n    }\n\n    std::cout << top[n - 1] << '\\n';\n    return 0;\n}\n"
}

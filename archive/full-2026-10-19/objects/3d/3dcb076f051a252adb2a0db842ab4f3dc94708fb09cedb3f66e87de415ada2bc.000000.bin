        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <assert.h>\n#include <string.h>\n#include <stdint.h>\n\ntypedef struct {\n    long int *data;\n    int length;\n    long int total;\n} bucket;\n\nenum { RADIX_INSERTION_LIMIT = 16 };\n\nstatic void memory_failure(void) {\n    fputs(\"ERROR memory\\n\", stderr);\n    exit(EXIT_FAILURE);\n}\n\nstatic void *allocate_items(size_t count, size_t width) {\n    void *p;\n    if (width != 0 && count > SIZE_MAX / width)\n        memory_failure();\n    p = malloc(count * width);\n    if (p == NULL && count != 0)\n        memory_failure();\n    return p;\n}\n\nstatic void insertion_range(const char *strings, size_t stride,\n                            long int *data, size_t count, size_t depth) {\n    for (size_t j = 1; j < count; ++j) {\n        long int key = data[j];\n        const char *key_text = strings + (size_t)key * stride + depth;\n        size_t i = j;\n        while (i > 0 &&\n               strcmp(strings + (size_t)data[i - 1] * stride + depth,\n                      key_text) > 0) {\n            data[i] = data[i - 1];\n            --i;\n        }\n        data[i] = key;\n    }\n}\n\nvoid sort(char *a, bucket *b) {\n    if (b->total > 1)\n        insertion_range(a, (size_t)b->length, b->data,\n                        (size_t)b->total, 0);\n}\n\ntypedef struct {\n    size_t begin;\n    size_t count;\n    size_t depth;\n    unsigned int in_scratch;\n} radix_range;\n\nlong int *bucket_sort(char *a, int length, long int size,\n                      int offset, int nbuckets) {\n    (void)offset;\n    (void)nbuckets;\n\n    if (size <= 0)\n        return NULL;\n\n    const size_t n = (size_t)size;\n    const size_t stride = (size_t)length;\n    const unsigned char *bytes = (const unsigned char *)a;\n    long int *returns = allocate_items(n, sizeof(*returns));\n\n    for (size_t i = 0; i < n; ++i)\n        returns[i] = (long int)i;\n\n    if (n <= RADIX_INSERTION_LIMIT) {\n        insertion_range(a, stride, returns, n, 0);\n        return returns;\n    }\n\n    long int *scratch = allocate_items(n, sizeof(*scratch));\n    size_t capacity = 64;\n    size_t used = 1;\n    radix_range *pending = allocate_items(capacity, sizeof(*pending));\n    size_t counts[256];\n    size_t next[256];\n\n    pending[0] = (radix_range){0, n, 0, 0};\n\n    while (used != 0) {\n        radix_range current = pending[--used];\n        const size_t begin = current.begin;\n        const size_t end = begin + current.count;\n        size_t depth = current.depth;\n        long int *source = current.in_scratch ? scratch : returns;\n        long int *destination = current.in_scratch ? returns : scratch;\n\n        for (;;) {\n            memset(counts, 0, sizeof(counts));\n            for (size_t i = begin; i < end; ++i)\n                ++counts[bytes[(size_t)source[i] * stride + depth]];\n\n            unsigned int first_byte =\n                bytes[(size_t)source[begin] * stride + depth];\n\n            /* A shared prefix needs no redistribution. NUL ends the key. */\n            if (counts[first_byte] == current.count) {\n                if (first_byte == 0) {\n                    if (source != returns)\n                        memcpy(returns + begin, source + begin,\n                               current.count * sizeof(*returns));\n                    break;\n                }\n                ++depth;\n                continue;\n            }\n\n            size_t position = begin;\n            for (unsigned int c = 0; c < 256; ++c) {\n                next[c] = position;\n                position += counts[c];\n            }\n\n            /* Scatter into exact, contiguous ranges in the other buffer. */\n            for (size_t i = begin; i < end; ++i) {\n                long int key = source[i];\n                unsigned int c = bytes[(size_t)key * stride + depth];\n                destination[next[c]++] = key;\n            }\n\n            position = begin;\n            for (unsigned int c = 0; c < 256; ++c) {\n                size_t count = counts[c];\n                if (count != 0) {\n                    if (c == 0 || count <= RADIX_INSERTION_LIMIT) {\n                        /* Only finished ranges are copied back. */\n                        if (destination != returns)\n                            memcpy(returns + position, destination + position,\n                                   count * sizeof(*returns));\n                        if (c != 0 && count > 1)\n                            insertion_range(a, stride, returns + position,\n                                            count, depth + 1);\n                    } else {\n                        if (used == capacity) {\n                            if (capacity > SIZE_MAX / (2 * sizeof(*pending)))\n                                memory_failure();\n                            size_t new_capacity = capacity * 2;\n                            radix_range *grown =\n                                realloc(pending, new_capacity * sizeof(*pending));\n                            if (grown == NULL)\n                                memory_failure();\n                            pending = grown;\n                            capacity = new_capacity;\n                        }\n                        pending[used++] = (radix_range){\n                            position, count, depth + 1,\n                            current.in_scratch ^ 1u\n                        };\n                    }\n                }\n                position += count;\n            }\n            break;\n        }\n    }\n\n    free(pending);\n    free(scratch);\n    return returns;\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb) {\n    char *strings = NULL;\n    int len, offset, nbucket;\n    long int n;\n\n    if (fscanf(stdin, \"%d\", &len) != 1) {\n        printf(\"ERROR len\\n\");\n        exit(1);\n    }\n\n    if (fscanf(stdin, \"%ld\", &n) != 1) {\n        printf(\"ERROR n\\n\");\n        exit(1);\n    }\n\n    if (fscanf(stdin, \"%d\", &offset) != 1) {\n        printf(\"ERROR offset\\n\");\n        exit(1);\n    }\n\n    if (fscanf(stdin, \"%d\", &nbucket) != 1) {\n        printf(\"ERROR nbucket\\n\");\n        exit(1);\n    }\n\n    nbucket = nbucket + 1;\n    len = len + 1;\n    strings = allocate_items((size_t)n, (size_t)len);\n\n    for (long int i = 0; i < n; ++i) {\n        if (fscanf(stdin, \"%s\", strings + (size_t)i * (size_t)len) != 1) {\n            printf(\"ERROR %ld\\n\", i);\n            exit(1);\n        }\n    }\n\n    *vString = strings;\n    *N = n;\n    *l = len;\n    *os = offset;\n    *nb = nbucket;\n}\n\nvoid print(char *strings, long int *index, long int n, int len) {\n    for (long int i = 0; i < n; ++i)\n        printf(\"%ld -> %s\\n\", i,\n               strings + (size_t)index[i] * (size_t)len);\n}\n\nvoid save(char *strings, long int *index, long int n, int len) {\n    for (long int i = 0; i < n; ++i)\n        printf(\"%s\\n\", strings + (size_t)index[i] * (size_t)len);\n}\n\nint main(int ac, char **av) {\n    char *strings = NULL;\n    long int N = 0;\n    long int *index = NULL;\n    int len = 0;\n    int offset, nbuckets;\n\n    (void)ac;\n    (void)av;\n\n    load(&strings, &N, &len, &offset, &nbuckets);\n    index = bucket_sort(strings, len, N, offset, nbuckets);\n    save(strings, index, N, len);\n\n    free(strings);\n    free(index);\n    return EXIT_SUCCESS;\n}\n",

#include <cstdint>
#include <iostream>
#include <vector>

using namespace std;

const int MOD = 1000000007;

int main() {
    int n, m;
    cin >> n >> m;

    const size_t wordsPerRow = (static_cast<size_t>(n) + 63) / 64;
    vector<uint64_t> blockedCells(static_cast<size_t>(n) * wordsPerRow, 0);
    for (int c = 0; c < m; c++) {
        int i, j;
        cin >> i >> j;
        const size_t word = static_cast<size_t>(i) * wordsPerRow + (static_cast<size_t>(j) >> 6);
        blockedCells[word] |= uint64_t(1) << (j & 63);
    }

    vector<vector<int> > dp(2, vector<int>(n, 0));

    const size_t firstRow = 0;
    if ((blockedCells[firstRow] & uint64_t(1)) == 0)
        dp[0][0] = 1;

    for (int j = 1; j < n; j++) {
        const bool blocked = (blockedCells[static_cast<size_t>(j) >> 6] & (uint64_t(1) << (j & 63))) != 0;
        if (!blocked) dp[0][j] = dp[0][j - 1];
    }
    dp[1][n - 1] = dp[0][n - 1];

    for (int i = 1; i < n; i++) {
        const size_t rowOffset = static_cast<size_t>(i) * wordsPerRow;
        for (int j = 0; j < n; j++) {
            int ans = 0;
            const bool blocked = (blockedCells[rowOffset + (static_cast<size_t>(j) >> 6)] & (uint64_t(1) << (j & 63))) != 0;
            if (!blocked) {
                ans = dp[0][j];
                if (j != 0) ans += dp[1][j - 1];
            }
            dp[1][j] = ans % MOD;
        }
        for (int j = 0; j < n; j++) dp[0][j] = dp[1][j];
    }

    cout << dp[1][n - 1] << endl;
}

    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <cstdio>\\n#include <vector>\\n#include <climits>\\n\\nstruct FastScanner {\\n    static const int BUFSIZE = 1 << 20;\\n    char buf[BUFSIZE];\\n    int idx, size;\\n    FastScanner() : idx(0), size(0) {}\\n    inline char getChar() {\\n        if (idx >= size) {\\n            size = fread(buf, 1, BUFSIZE, stdin);\\n            idx = 0;\\n            if (size == 0) return 0;\\n        }\\n        return buf[idx++];\\n    }\\n    int nextInt() {\\n        char c;\\n        do { c = getChar(); } while (c <= ' ');\\n        int sign = 1;\\n        if (c == '-') { sign = -1; c = getChar(); }\\n        long long x = 0;\\n        while (c >= '0' && c <= '9') {\\n            x = x * 10 + (c - '0');\\n            c = getChar();\\n        }\\n        return static_cast<int>(sign * x);\\n    }\\n};\\n\\nint main() {\\n    FastScanner fs;\\n    int n = fs.nextInt();\\n    int s = fs.nextInt();\\n\\n    // Vertical prefix sums: pref[i*N+j] = sum of rows 0..i-1 for column j.\\n    std::vector<long long> pref((size_t)(n + 1) * n, 0);\\n    for (int i = 1; i <= n; ++i) {\\n        const int base = i * n;\\n        const int prev = (i - 1) * n;\\n        #pragma omp simd\\n        for (int j = 0; j < n; ++j) {\\n            pref[base + j] = pref[prev + j] + fs.nextInt();\\n        }\\n    }\\n\\n    long long mxSum = LLONG_MIN;\\n    const int limit_i = n - s + 1;\\n\\n    #pragma omp parallel for reduction(max:mxSum) schedule(static)\\n    for (int i = 0; i < limit_i; ++i) {\\n        const long long* top = &pref[i * n];\\n        const long long* bottom = &pref[(i + s) * n];\\n\\n        // Initial window sum over first s columns.\\n        long long window = 0;\\n        #pragma omp simd reduction(+:window)\\n        for (int j = 0; j < s; ++j) {\\n            window += bottom[j] - top[j];\\n        }\\n        long long curMax = window;\\n\\n        // Slide horizontally across the row.\\n        for (int j
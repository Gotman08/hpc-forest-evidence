{
  "src/main.cpp": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nint A[1000][1000];\nusing ll = long long;\n\nll solve(int short_dim, int long_dim, ll k) {\n  ll ans = 0;\n  vector<ll> sums(long_dim, 0);\n\n  for (int first = 0; first < short_dim; ++first) {\n    fill(sums.begin(), sums.end(), 0LL);\n    unordered_map<ll, ll> frequencies;\n    frequencies.max_load_factor(0.7f);\n    frequencies.reserve(static_cast<size_t>(long_dim) + 1);\n\n    for (int last = first; last < short_dim; ++last) {\n      // Each scan-axis element is updated independently for this pair.\n#pragma GCC ivdep\n      for (int q = 0; q < long_dim; ++q)\n        sums[q] += A[last][q];\n\n      frequencies.clear();\n      frequencies.emplace(0, 1);\n      ll prefix = 0;\n      for (int q = 0; q < long_dim; ++q) {\n        prefix += sums[q];\n        auto it = frequencies.find(prefix - k);\n        if (it != frequencies.end())\n          ans += it->second;\n        ++frequencies[prefix];\n      }\n    }\n  }\n  return ans;\n}\n\nint main() {\n  ll k;\n  int m, n;\n  cin >> k >> m >> n;\n\n  // Store the shorter dimension first so stripe updates are contiguous.\n  const bool pair_rows = m <= n;\n  for (int i = 0; i < m; ++i) {\n    for (int j = 0; j < n; ++j) {\n      int value;\n      cin >> value;\n      if (pair_rows)\n        A[i][j] = value;\n      else\n        A[j][i] = value;\n    }\n  }\n\n  const int short_dim = min(m, n);\n  const int long_dim = max(m, n);\n  cout << solve(short_dim, long_dim, k) << endl;\n  return 0;\n}\n"
}

import hashlib
import json
import subprocess
import zipfile
from pathlib import Path

outputs = Path(r"C:\Users\nicol\Documents\Codex\2026-10-15\cr\outputs")
project = outputs / "HPC-Forest"
original = outputs / "HPC-Forest.zip"
sha = lambda path: hashlib.sha256(path.read_bytes()).hexdigest()
assert sha(original) == "739aa2110125f8735b46dc4e9204411bcd255fd9031136165a0a56ace9ecdb49"
def git(*args):
    return subprocess.check_output(["git", "-C", str(project), *args])
assert not git("status", "--porcelain").strip()
commit = git("rev-parse", "HEAD").decode().strip()
archive = outputs / "HPC-Forest-ROMEO.zip"
assert not archive.exists()
paths = [p for p in git("ls-files", "-z").decode().split("\0") if p]
stages = {line.split("\t",1)[1]: line.split(" ",1)[0]
          for line in git("ls-files","--stage").decode().splitlines()}
with zipfile.ZipFile(archive,"w",compression=zipfile.ZIP_DEFLATED,compresslevel=9) as bundle:
    for name in paths:
        entry=zipfile.ZipInfo.from_file(project/name,"HPC-Forest/"+name)
        entry.external_attr = int(stages[name],8) << 16
        bundle.writestr(entry,(project/name).read_bytes(),compress_type=zipfile.ZIP_DEFLATED)
with zipfile.ZipFile(archive) as bundle:
    assert bundle.testzip() is None
    for name in paths:
        assert bundle.read("HPC-Forest/" + name) == (project / name).read_bytes(), name
    assert all("/.venv/" not in p and "/runs/" not in p for p in bundle.namelist())
receipt = {
    "delivery_commit": commit,
    "tested_runtime_source_commit": "6c65c791472139bedb3555e1ad744d3fd979d3cb",
    "file": archive.name, "sha256": sha(archive), "bytes": archive.stat().st_size,
    "tracked_files_verified": len(paths),
    "original_delivery_sha256": sha(original), "original_delivery_preserved": True,
    "model_job": "746831", "package_verification_job": "746836",
    "windows_tests": {"passed":44,"skipped":0},
    "romeo_arm_tests": {"passed":43,"skipped":1},
    "checks": json.loads((project/"evidence/romeo/checks-746831.json").read_text())
}
archive.with_suffix(".zip.sha256").write_text(f"{sha(archive)}  {archive.name}\n",encoding="ascii")
(outputs/"HPC-Forest-ROMEO-manifest.json").write_text(json.dumps(receipt,indent=2)+"\n",encoding="utf-8")
print(json.dumps({k:v for k,v in receipt.items() if k != "checks"},indent=2))

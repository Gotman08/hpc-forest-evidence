      "content": "#include \"knn.h\"\n#include <omp.h>\n\nstatic float *local_dist;\nstatic char *local_labels;\nstatic int *local_idx;\n#pragma omp threadprivate(local_dist, local_labels, local_idx)\n\ntypedef struct {\n    float d;\n    char label;\n    int idx;\n} Candidate;\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    // Count total points across all groups\n    int N_total = 0;\n    for (int i = 0; i < n_groups; i++) N_total += groups[i].length;\n\n    // Flatten points and their labels into contiguous arrays\n    Point *points_flat = (Point*)malloc(sizeof(Point) * N_total);\n    char *labels_flat = (char*)malloc(sizeof(char) * N_total);\n    int offset = 0;\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            points_flat[offset] = g.points[j];\n            labels_flat[offset] = g.label;\n            offset++;\n        }\n    }\n\n    int max_threads = omp_get_max_threads();\n    Candidate *all_cands = (Candidate*)malloc(sizeof(Candidate) * max_threads * k);\n    int *counts = (int*)calloc(max_threads, sizeof(int));\n\n    #pragma omp parallel\n    {\n        local_dist = (float*)malloc(sizeof(float) * k);\n        local_labels = (char*)malloc(sizeof(char) * k);\n        local_idx = (int*)malloc(sizeof(int) * k);\n\n        for (int i = 0; i < k; i++) {\n            local_dist[i] = -1;\n            local_labels[i] = -1;\n            local_idx[i] = -1;\n        }\n\n        #pragma omp for schedule(static)\n        for (int idx = 0; idx < N_total; idx++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, points_flat[idx]);\n            char lab = labels_flat[idx];\n\n            int x;\n            for (x = 0; x < k; x++) {\n                if (d < local_dist[x] || local_dist[x] == -1) {\n                    // Shift larger distances to the right\n                    for (int y = k - 1; y > x; y--) {\n                        local_dist[y] = local_dist[y - 1];\n                        local_labels[y] = local_labels[y - 1];\n                        local_idx[y] = local_idx[y - 1];\n                    }\n                    local_dist[x] = d;\n                    local_labels[x] = lab;\n                    local_idx[x] = idx;\n                    break;\n                }\n            }\n        }\n\n        int tid = omp_get_thread_num();\n        int cnt = 0;\n        while (cnt < k && local_dist[cnt] != -1) {\n            all_cands[tid * k + cnt].d = local_dist[cnt];\n            all_cands[tid * k + cnt].label = local_labels[cnt];\n            all_cands[tid * k + cnt].idx = local_idx[cnt];\n            cnt++;\n        }\n        counts[tid] = cnt;\n\n        free(local_dist);\n        free(local_labels);\n        free(local_idx);\n    }\n\n    int total_count = 0;\n    for (int t = 0; t < max_threads; t++) {\n        total_count += counts[t];\n    }\n\n    int actual_k = k < total_count ? k : total_count;\n    char *labels = (char*)malloc(sizeof(char) * actual_k);\n    if (actual_k > 0) {\n        int *pos = (int*)calloc(max_threads, sizeof(int));\n        for (int i = 0; i < actual_k; i++) {\n            int best_t = -1;\n            for (int t = 0; t < max_threads; t++) {\n                if (pos[t] < counts[t]) {\n                    Candidate *cand = &all_cands[t * k + pos[t]];\n                    if (best_t == -1) {\n                        best_t = t;\n                    } else {\n                        Candidate *best_cand = &all_cands[best_t * k + pos[best_t]];\n                        if (cand->d < best_cand->d ||\n                            (cand->d == best_cand->d && cand->idx < best_cand->idx)) {\n                            best_t = t;\n                        }\n                    }\n                }\n            }\n            Candidate *chosen = &all_cands[best_t * k + pos[best_t]];\n            labels[i] = chosen->label;\n            pos[best_t]++;\n        }\n        free(pos);\n    }\n\n    qsort(labels, actual_k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < actual_k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == actual_k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(points_flat);\n    free(labels_flat);\n    free(all_cands);\n    free(counts);\n\n    return most_frequent;\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Replace the global critical-section collection plus qsort with a lock-free per-thread slice write followed by a k-way merge over the sorted per-thread lists, reducing synchronization overhead and sorting cost while preserving exact tie-breaking via (distance, index) ordering.",
  "notes": "The new implementation preallocates candidate storage for all threads, eliminates the critical section and dynamic reallocation, and replaces qsort of up to max_threads*k candidates with a linear k-way merge. Tie-breaking is preserved because each thread's list is sorted by (distance, index) and the merge always selects the smallest head.",

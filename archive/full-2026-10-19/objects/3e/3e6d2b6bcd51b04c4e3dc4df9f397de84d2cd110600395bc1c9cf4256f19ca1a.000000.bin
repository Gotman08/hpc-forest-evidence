distance) return 0;\\n+    return a->ordinal < b->ordinal;\\n+}\\n+\\n+static void heap_sift_up(Candidate *heap, size_t index) {\\n+    while (index != 0) {\\n+        size_t parent = (index - 1) / 2;\\n+        if (!candidate_precedes(&heap[parent], &heap[index])) break;\\n+\\n+        Candidate temporary = heap[parent];\\n+        heap[parent] = heap[index];\\n+        heap[index] = temporary;\\n+        index = parent;\\n+    }\\n+}\\n+\\n+static void heap_sift_down(Candidate *heap, size_t count, size_t index) {\\n+    while (index < count / 2) {\\n+        size_t left = index * 2 + 1;\\n+        size_t worst = left;\\n+        size_t right = left + 1;\\n+\\n+        if (right < count && candidate_precedes(&heap[left], &heap[right])) {\\n+            worst = right;\\n+        }\\n+        if (!candidate_precedes(&heap[index], &heap[worst])) break;\\n+\\n+        Candidate temporary = heap[index];\\n+        heap[index] = heap[worst];\\n+        heap[worst] = temporary;\\n+        index = worst;\\n+    }\\n+}\\n+\\n+static void heap_offer(Candidate *heap, size_t *count, size_t capacity,\\n+                       Candidate candidate) {\\n+    if (capacity == 0) return;\\n+\\n+    if (*count < capacity) {\\n+        size_t index = *count;\\n+        heap[index] = candidate;\\n+        *count = index + 1;\\n+        heap_sift_up(heap, index);\\n+    } else if (candidate_precedes(&candidate, &heap[0])) {\\n+        heap[0] = candidate;\\n+        heap_sift_down(heap, *count, 0);\\n+    }\\n+}\\n+\\n+static char classify_labels(char *labels, int k) {\\n+    int i;\\n+    char most_frequent;\\n+    int most_frequent_count;\\n+    int current_frequency;\\n+\\n+    qsort(labels, k, sizeof(char), compare_for_sort);\\n+\\n+    most_frequent = labels[0];\\n+    most_frequent_count = 1;\\n+    current_frequency = 1;\\n+\\n+    for (i = 1; i < k; i++) {\\n+        if (labels[i] != labels[i - 1]) {\\n+            if (current_frequency > most_frequent_count) {\\n+                most_frequent = labels[i - 1];\\n+                most_frequent_count = current_frequency;\\n+            }\\n+            current_frequency = 1;\\n+        } else {\\n+            current_frequency++;\\n+        }\\n+\\n+        if (i == k - 1 && current_frequency > most_frequent_count) {\\n+            most_frequent = labels[i - 1];\\n+            most_frequent_count = current_frequency;\\n+        }\\n+    }\\n+\\n+    return most_frequent;\\n+}\\n+\\n+static char knn_serial(int n_groups, Group *groups, int k,\\n+                       Point to_evaluate) {\\n+    char *labels = (char *) malloc(sizeof(char) * (size_t) k);\\n+    float *distances = (float *) malloc(sizeof(float) * (size_t) k);\\n+    int i, j, x, y;\\n+\\n+    for (i = 0; i < k; i++) {\\n+        labels[i] = -1;\\n+        distances[i] = -1;\\n+    }\\n+\\n+    for (i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+\\n+        for (j = 0; j < g.length; j++) {\\n+            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n+\\n+            for (x = 0; x < k; x++) {\\n+                if (d < distances[x] || distances[x] == -1) {\\n+                    for (y = k - 1; y > x; y--) {\\n+                        distances[y] = distances[y - 1];\\n+                        labels[y] = labels[y - 1];\\n+                    }\\n+\\n+                    distances[x] = d;\\n+                    labels[x] = g.label;\\n+                    break;\\n+                }\\n+            }\\n+        }\\n+    }\\n+\\n+    char result = classify_labels(labels, k);\\n+    free(distances);\\n+    free(labels);\\n+    return result;\\n+}\\n+\\n+static char classify_every_point(int n_groups, Group *groups, int k) {\\n+    char\"}, {\"id\": \"cebfd36daf6f4e41\", \"role\": \"B\", \"commit\": \"5c6a6983f6b13c25caee04917cc7cb1af511ddfc\", \"transformations\": {\"files\": [\"src/knn.c\"], \"retained\": [\"Use stable max-heaps keyed by distance then original encounter ordinal for exact top-k member
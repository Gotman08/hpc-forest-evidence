          current_frequency = 1;\\n-        } else {\\n-            current_frequency++;\\n-        }\\n-\\n-        if (i == k - 1 && current_frequency > most_frequent_count) {\\n-            most_frequent = labels[i - 1];\\n-            most_frequent_count = current_frequency;\\n-        }\\n-    }\\n-\\n-\\n-    return most_frequent;\\n-}\\n-\\n-int main() {\\n-    int n_groups = parse_number_of_groups();\\n-    \\n-    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n-\\n-    for (int i = 0; i < n_groups; i++) {\\n-        groups[i] = parse_next_group();\\n-    }\\n-\\n-    int k = parse_k();\\n-\\n-    Point to_evaluate = parse_point();\\n-\\n-    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n-}\\n\\\\ No newline at end of file\\n+#include \\\"knn.h\\\"\\n+\\n+#ifdef _OPENMP\\n+#include <omp.h>\\n+#endif\\n+\\n+typedef struct {\\n+    float distance;\\n+    char label;\\n+    size_t ordinal;\\n+} Neighbor;\\n+\\n+static char serial_knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n+    char *labels = (char *) malloc(sizeof(char) * k);\\n+    float *distances = (float *) malloc(sizeof(float) * k);\\n+\\n+    int i, j, x, y;\\n+\\n+    for (i = 0; i < k; i++) {\\n+        labels[i] = -1;\\n+        distances[i] = -1;\\n+    }\\n+\\n+    for (i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+\\n+        for (j = 0; j < g.length; j++) {\\n+            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n+\\n+            for (x = 0; x < k; x++) {\\n+                if (d < distances[x] || distances[x] == -1) {\\n+                    for (y = k - 1; y > x; y--) {\\n+                        distances[y] = distances[y - 1];\\n+                        labels[y] = labels[y - 1];\\n+                    }\\n+\\n+                    distances[x] = d;\\n+                    labels[x] = g.label;\\n+\\n+                    break;\\n+                }\\n+            }\\n+        }\\n+    }\\n+\\n+    qsort(labels, k, sizeof(char), compare_for_sort);\\n+\\n+    char most_frequent = labels[0];\\n+    int most_frequent_count = 1;\\n+    int current_frequency = 1;\\n+\\n+    for (i = 1; i < k; i++) {\\n+        if (labels[i] != labels[i - 1]) {\\n+            if (current_frequency > most_frequent_count) {\\n+                most_frequent = labels[i - 1];\\n+                most_frequent_count = current_frequency;\\n+            }\\n+\\n+            current_frequency = 1;\\n+        } else {\\n+            current_frequency++;\\n+        }\\n+\\n+        if (i == k - 1 && current_frequency > most_frequent_count) {\\n+            most_frequent = labels[i - 1];\\n+            most_frequent_count = current_frequency;\\n+        }\\n+    }\\n+\\n+    return most_frequent;\\n+}\\n+\\n+#ifdef _OPENMP\\n+static int compare_neighbors(const void *left, const void *right) {\\n+    const Neighbor *a = (const Neighbor *) left;\\n+    const Neighbor *b = (const Neighbor *) right;\\n+\\n+    if (a->distance < b->distance) return -1;\\n+    if (a->distance > b->distance) return 1;\\n+    if (a->ordinal < b->ordinal) return -1;\\n+    if (a->ordinal > b->ordinal) return 1;\\n+    return 0;\\n+}\\n+\\n+static void insert_local_neighbor(Neighbor *neighbors, int *count, int k, Neighbor candidate) {\\n+    int position = 0;\\n+\\n+    while (position < *count) {\\n+        if (candidate.distance < neighbors[position].distance ||\\n+            (candidate.distance == neighbors[position].distance &&\\n+             candidate.ordinal < neighbors[position].ordinal)) {\\n+            break;\\n+        }\\n+        position++;\\n+    }\\n+\\n+    if (*count == k && position == k) return;\\n+\\n+    int last = *count < k ? *count : k - 1;\\n+    for (int i = last; i > position; i--) {\\n+        neighbors[i] = neighbors[i - 1];\\n+    }\\n+    neighbors[position] = candidate;\\n+\\n+    if (*count < k) (*count)++;\\n+}\\n+#endif\\n+\\n+char knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n+#ifndef _OPENMP\\n+    return serial_knn(n_groups, groups, k, to_evaluate);\\n+#else\\n+    if (k <= 0 || n_groups <= 0) return serial_knn(n_groups, groups, k, to_evaluate);\\n+\\n+    int max_threads = omp_get_max_threads();\\n+    if (max_threads <= 0 || (size_t) k > (size_t) -1 / (size_t) max_threads) {\\n+        return serial_knn(n_groups, groups, k, to_evaluate);\\n+    }\\n+\\n+    size_t worker_slots = (size_t) max_threads * (size_t) k;\\n+    if (worker_slots > (size_t) -1 / sizeof(Neighbor) ||\\n+        (size_t) n_groups > (size_t) -1 / sizeof(size_t)) {\\n+        return serial_knn(n_groups, groups, k, to_evaluate);\\n+    }\\n+\\n+    Neighbor *local_neighbors = (Neighbor *) malloc(worker_slots * sizeof(Neighbor));\\n+    int *local_counts = (int *) calloc((size_t) max_threads, sizeof(int));\\n+    s\"}], \"automatic_observations\": {\"baseline\": {\"experiment_id\": \"baseline-e1\", \"outcome\": {\"binary_sha256\": \"36586c1741b2b272c1d9e7d0368680ec8a17544468dea5a146a4c607fe28c41f\", \"cache_key\": \"065bf8cef59dffaa8fe3640afd2e22e32c34820e1691f2f29f662e669f25c0ab\", \"commit\": \"39b955be1bd06a7e9f1bb6f1321fbc5a54d85efe\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-5.6-terra-xhigh/results-750909/2022-knn/logs/e1/baseline-e1/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-5.6-terra-xhigh/results-750909/2022-knn/logs/e1/baseline-e1/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-5.6-terra-xhigh/results-750909/2022-knn/logs/e1/baseline-e1/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-5.6-terra-xhigh/results-750909/2022-knn/logs/e1/baseline-e1/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-c
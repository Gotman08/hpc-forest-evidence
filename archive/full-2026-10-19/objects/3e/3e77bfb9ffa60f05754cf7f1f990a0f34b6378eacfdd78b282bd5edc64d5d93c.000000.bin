      "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <utility>\n#include <vector>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\nusing namespace std;\n\nstatic constexpr int MOD = 1000000007;\n\nstatic int mod_power(int base, int exponent) {\n    int result = 1;\n    while (exponent != 0) {\n        if (exponent & 1)\n            result = static_cast<int>(uint64_t(result) * base % MOD);\n        base = static_cast<int>(uint64_t(base) * base % MOD);\n        exponent >>= 1;\n    }\n    return result;\n}\n\nstatic inline int binomial(int down, int right,\n                           const vector<int>& factorial,\n                           const vector<int>& inverse_factorial) {\n    uint64_t value = uint64_t(factorial[down + right]) * inverse_factorial[down] % MOD;\n    return static_cast<int>(value * inverse_factorial[right] % MOD);\n}\n\nstatic int sparse_paths(int n, const vector<pair<int, int>>& blocked) {\n    const int limit = 2 * n - 2;\n    vector<int> factorial(limit + 1), inverse_factorial(limit + 1);\n    factorial[0] = 1;\n    for (int i = 1; i <= limit; ++i)\n        factorial[i] = static_cast<int>(uint64_t(factorial[i - 1]) * i % MOD);\n    inverse_factorial[limit] = mod_power(factorial[limit], MOD - 2);\n    for (int i = limit; i > 0; --i)\n        inverse_factorial[i - 1] = static_cast<int>(uint64_t(inverse_factorial[i]) * i % MOD);\n\n    const int count = static_cast<int>(blocked.size());\n    vector<int> ways(count + 1);\n    for (int i = 0; i <= count; ++i) {\n        const int y = i < count ? blocked[i].first : n - 1;\n        const int x = i < count ? blocked[i].second : n - 1;\n        uint64_t removed = 0;\n        // Each contribution reads only completed predecessors. The caller\n        // bounds count by n, so this unreduced sum fits in uint64_t.\n        #pragma omp simd reduction(+:removed)\n        for (int j = 0; j < i; ++j) {\n            if (blocked[j].second <= x) {\n                const int down = y - blocked[j].first;\n                const int right = x - blocked[j].second;\n                const int continuations = binomial(down, right, factorial, inverse_factorial);\n                removed += uint64_t(ways[j]) * continuations % MOD;\n            }\n        }\n        const int unrestricted = binomial(y, x, factorial, inverse_factorial);\n        int value = unrestricted - static_cast<int>(removed % MOD);\n        if (value < 0)\n            value += MOD;\n        ways[i] = value;\n    }\n    return ways[count];\n}\n\n#if defined(__aarch64__)\nstatic inline uint32x4_t add_mod4(uint32x4_t a, uint32x4_t b) {\n    const uint32x4_t modulus = vdupq_n_u32(MOD);\n    const uint32x4_t sum = vaddq_u32(a, b);\n    return vsubq_u32(sum, vandq_u32(vcgeq_u32(sum, modulus), modulus));\n}\n\nstatic inline uint32x4_t prefix_mod4(uint32x4_t values) {\n    const uint32x4_t zero = vdupq_n_u32(0);\n    values = add_mod4(values, vextq_u32(zero, values, 3));\n    return add_mod4(values, vextq_u32(zero, values, 2));\n}\n#endif\n\nstatic inline void advance_segment(int* row, int first, int last) {\n    first = max(first, 1);\n    if (first >= last)\n        return;\n    int left = row[first - 1];\n    int x = first;\n#if defined(__aarch64__)\n    uint32x4_t carry = vdupq_n_u32(static_cast<uint32_t>(left));\n    for (; x + 8 <= last; x += 8) {\n        // Compute an eight-element modular prefix independently of the\n        // preceding block, then inject its carry into both halves.\n        uint32x4_t low = prefix_mod4(vld1q_u32(\n            reinterpret_cast<const uint32_t*>(row + x)));\n        uint32x4_t high = prefix_mod4(vld1q_u32(\n            reinterpret_cast<const uint32_t*>(row + x + 4)));\n        high = add_mod4(high, vdupq_laneq_u32(low, 3));\n        low = add_mod4(low, carry);\n        high = add_mod4(high, carry);\n        vst1q_u32(reinterpret_cast<uint32_t*>(row + x), low);\n        vst1q_u32(reinterpret_cast<uint32_t*>(row + x + 4), high);\n        carry = vdupq_laneq_u32(high, 3);\n    }\n    left = static_cast<int>(vgetq_lane_u32(carry, 0));\n#endif\n    for (; x < last; ++x) {\n        const int value = row[x] + left;\n        left = value >= MOD ? value - MOD : value;\n        row[x] = left;\n    }\n}\n\nstatic int dense_paths(int n, const vector<pair<int, int>>& blocked) {\n    vector<int> row(n, 0);\n    row[0] = 1;\n    size_t next = 0;\n    for (int y = 0; y < n; ++y) {\n        int first = 0;\n        while (next < blocked.size() && blocked[next].first == y) {\n            const int x = blocked[next].second;\n            advance_segment(row.data(), first, x);\n            row[x] = 0;\n            first = x + 1;\n            ++next;\n        }\n        advance_segment(row.data(), first, n);\n    }\n    return row[n - 1];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m))\n        return 0;\n\n    vector<pair<int, int>> blocked;\n    blocked.reserve(static_cast<size_t>(m));\n    bool endpoint_blocked = false;\n    for (int i = 0; i < m; ++i) {\n        int y, x;\n        cin >> y >> x;\n        blocked.emplace_back(y, x);\n        if ((y == 0 && x == 0) || (y == n - 1 && x == n - 1))\n            endpoint_blocked = true;\n    }\n    if (endpoint_blocked) {\n        cout << 0 << '\\n';\n        return 0;\n    }\n\n    sort(blocked.begin(), blocked.end());\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\n\n    const uint64_t count = blocked.size();\n    const uint64_t dense_work = uint64_t(n) * n;\n    const uint64_t preprocessing_work = uint64_t(32) * n;\n    // Conservative operation-count heuristic, not a measured crossover:\n    // charge each sparse pair 64 dense updates and include table construction.\n    bool use_sparse = blocked.empty();\n    if (!use_sparse && count <= uint64_t(n) && dense_work >= preprocessing_work) {\n        const uint64_t pairs = count * (count + 1) / 2;\n        use_sparse = pairs <= (dense_work - preprocessing_work) / 64;\n    }\n\n    const int answer = use_sparse ? sparse_paths(n, blocked) : dense_paths(n, blocked);\n    cout << answer << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Eight-cell NEON modular prefix scans can shorten the dense DP's loop-carried dependency chain while preserving exact results and the existing sparse algorithm.",
  "notes": "Each SIMD addition combines residues below MOD, so one conditional subtraction suffices without overflow. Vector accesses stay inside obstacle-free segments; short segments and tails remain scalar. No commands or measurements were executed.",

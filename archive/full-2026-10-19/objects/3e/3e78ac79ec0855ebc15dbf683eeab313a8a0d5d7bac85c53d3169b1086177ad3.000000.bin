{
  "src/npbonacci.cpp": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nnamespace {\nusing Coeff = std::uint32_t;\nusing Wide = std::uint64_t;\nusing Poly = std::vector<Coeff>;\n\nconstexpr Coeff MOD = 1000000007U;\nconstexpr int BATCH = 16;\n\ninline Coeff subtract_mod(Coeff a, Coeff b) {\n    return a >= b ? a - b : a + MOD - b;\n}\n\ninline Coeff dot_mod(const Coeff* a, const Coeff* b, int count) {\n    // Sixteen products of normalized coefficients fit in uint64_t.\n    Wide reduced = 0;\n    int offset = 0;\n    for (; offset + BATCH <= count; offset += BATCH) {\n        Wide sum;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n        uint64x2_t low = vdupq_n_u64(0);\n        uint64x2_t high = vdupq_n_u64(0);\n        for (int j = 0; j < BATCH; j += 4) {\n            const uint32x4_t av = vld1q_u32(a + offset + j);\n            const uint32x4_t bv = vld1q_u32(b + offset + j);\n            low = vmlal_u32(low, vget_low_u32(av), vget_low_u32(bv));\n            high = vmlal_high_u32(high, av, bv);\n        }\n        sum = vaddvq_u64(vaddq_u64(low, high));\n#else\n        sum = 0;\n#if defined(_OPENMP)\n#pragma omp simd reduction(+:sum)\n#endif\n        for (int j = 0; j < BATCH; ++j) {\n            sum += static_cast<Wide>(a[offset + j]) * b[offset + j];\n        }\n#endif\n        reduced += sum % MOD;\n    }\n\n    Wide tail = 0;\n#if defined(_OPENMP)\n#pragma omp simd reduction(+:tail)\n#endif\n    for (int j = offset; j < count; ++j) {\n        tail += static_cast<Wide>(a[j]) * b[j];\n    }\n    // For N <= 1020, at most 64 residues plus 15 products also fit.\n    return static_cast<Coeff>((reduced + tail) % MOD);\n}\n\ninline Coeff convolution_coefficient(const Poly& a,\n                                     const Poly& reversed_b,\n                                     int degree) {\n    if (degree < 0 || a.empty() || reversed_b.empty()) {\n        return 0;\n    }\n    const int an = static_cast<int>(a.size());\n    const int bn = static_cast<int>(reversed_b.size());\n    const int first = std::max(0, degree - bn + 1);\n    const int last = std::min(an - 1, degree);\n    if (first > last) {\n        return 0;\n    }\n    return dot_mod(a.data() + first,\n                   reversed_b.data() + bn - 1 - degree + first,\n                   last - first + 1);\n}\n\ninline Coeff square_coefficient(const Poly& a,\n                                const Poly& reversed_a,\n                                int degree) {\n    const int size = static_cast<int>(a.size());\n    if (degree < 0 || size == 0 || degree >= 2 * size - 1) {\n        return 0;\n    }\n\n    // Compute each off-diagonal pair once, then add the diagonal.\n    const int first = std::max(0, degree - size + 1);\n    const int end = std::min(size, (degree + 1) / 2);\n    Wide value = 0;\n    if (first < end) {\n        value = 2ULL * dot_mod(a.data() + first,\n                              reversed_a.data() + size - 1 - degree + first,\n                              end - first);\n    }\n    if ((degree & 1) == 0) {\n        const Wide middle = a[degree / 2];\n        value += middle * middle;\n    }\n    return static_cast<Coeff>(value % MOD);\n}\n\nCoeff recurrence_term(const Poly& initial, const Poly& weights, Wide h) {\n    const int n = static_cast<int>(initial.size());\n    if (h <= static_cast<Wide>(n)) {\n        return initial[static_cast<std::size_t>(h - 1)];\n    }\n\n    // The generating function is R(x)/Q(x), with Q(0) = 1.\n    Poly q(n + 1);\n    q[0] = 1;\n    for (int i = 0; i < n; ++i) {\n        q[i + 1] = weights[i] == 0 ? 0 : MOD - weights[i];\n    }\n    Poly r(n);\n    {\n        const Poly reversed_q(q.rbegin(), q.rend());\n        for (int i = 0; i < n; ++i) {\n            r[i] = convolution_coefficient(initial, reversed_q, i);\n        }\n    }\n\n    // Fixed lengths also cover zero coefficients and degree drops.\n    Poly r_even((n + 1) / 2), r_odd(n / 2);\n    Poly q_even(n / 2 + 1), q_odd((n + 1) / 2);\n    Poly reversed_even(q_even.size()), reversed_odd(q_odd.size());\n    Poly next_r(n), next_q(n + 1);\n\n    Wide index = h - 1;\n    while (index != 0) {\n        for (int i = 0; i < static_cast<int>(r_even.size()); ++i) {\n            r_even[i] = r[2 * i];\n        }\n        for (int i = 0; i < static_cast<int>(r_odd.size()); ++i) {\n            r_odd[i] = r[2 * i + 1];\n        }\n        for (int i = 0; i < static_cast<int>(q_even.size()); ++i) {\n            const Coeff value = q[2 * i];\n            q_even[i] = value;\n            reversed_even[q_even.size() - 1 - i] = value;\n        }\n        for (int i = 0; i < static_cast<int>(q_odd.size()); ++i) {\n            const Coeff value = q[2 * i + 1];\n            q_odd[i] = value;\n            reversed_odd[q_odd.size() - 1 - i] = value;\n        }\n\n        // Retain only the requested parity of R(x) * Q(-x).\n        if (index & 1U) {\n            for (int k = 0; k < n; ++k) {\n                next_r[k] = subtract_mod(\n                    convolution_coefficient(r_odd, reversed_even, k),\n                    convolution_coefficient(r_even, reversed_odd, k));\n            }\n        } else {\n            for (int k = 0; k < n; ++k) {\n                next_r[k] = subtract_mod(\n                    convolution_coefficient(r_even, reversed_even, k),\n                    convolution_coefficient(r_odd, reversed_odd, k - 1));\n            }\n        }\n\n        // With Q(x) = E(x^2) + x*O(x^2), Q_next(y) = E(y)^2 - y*O(y)^2.\n        for (int k = 0; k <= n; ++k) {\n            next_q[k] = subtract_mod(\n                square_coefficient(q_even, reversed_even, k),\n                square_coefficient(q_odd, reversed_odd, k - 1));\n        }\n        r.swap(next_r);\n        q.swap(next_q);\n        index >>= 1;\n    }\n\n    // Q(0) remains exactly one throughout the iteration.\n    return r[0];\n}\n} // namespace\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n;\n    Wide h;\n    if (!(std::cin >> n >> h)) {\n        return 0;\n    }\n\n    Poly initial(n), weights(n);\n    for (int i = 0; i < n; ++i) {\n        Wide value;\n        std::cin >> value;\n        initial[i] = static_cast<Coeff>(value % MOD);\n    }\n    for (int i = 0; i < n; ++i) {\n        Wide value;\n        std::cin >> value;\n        weights[i] = static_cast<Coeff>(value % MOD);\n    }\n\n    std::cout << recurrence_term(initial, weights, h) << '\\n';\n    return 0;\n}\n"
}

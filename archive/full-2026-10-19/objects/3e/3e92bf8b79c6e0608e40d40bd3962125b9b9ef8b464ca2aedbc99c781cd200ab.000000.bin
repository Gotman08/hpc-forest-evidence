"""Add provider interfaces to the isolated source, preserving the tested runtime."""
from pathlib import Path

root = Path(__file__).resolve().parent / 'project'
source = (root / 'src/hpc_forest/ollama_backend.py').read_text(encoding='utf8')
start = source.index('        sources, size = {}, 0\n')
end = source.index('        payload = {\n', start)
body = '\n'.join(line[4:] if line.startswith('    ') else line for line in source[start:end].splitlines())
helper = '''"""Render exactly the existing neutral proposal messages for another transport."""
from __future__ import annotations

import json
from pathlib import Path

from .backends import ROLE_PURPOSE
from .core import InfrastructureError, Mission
from .ollama_backend import SOURCE_SCHEMA


def proposal_messages(worktree: Path, mission: Mission, context: dict) -> dict:
'''
helper += body + '\n    return {"messages": [{"role": "system", "content": system}, {"role": "user", "content": user_content}], "schema": schema}\n'
target = root / 'src/hpc_forest/source_request.py'
if target.exists():
    assert target.read_text(encoding='utf8') == helper
else:
    target.write_text(helper, encoding='utf8')
print(target)

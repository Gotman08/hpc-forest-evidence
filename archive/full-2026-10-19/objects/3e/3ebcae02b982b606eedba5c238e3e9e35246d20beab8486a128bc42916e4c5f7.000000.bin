        "content": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nstatic constexpr uint32_t MOD = 1000000007U;\n\ntemplate<int Step>\nstatic inline uint32_t dot_mod(const uint32_t* a, const uint32_t* b, int count) {\n    uint64_t sum = 0;\n    int i = 0;\n    // Sixteen products plus a reduced residue fit in uint64_t.\n    for (; i + 16 <= count; i += 16) {\n#ifdef _OPENMP\n#pragma omp simd reduction(+:sum)\n#endif\n        for (int j = 0; j < 16; ++j) {\n            sum += static_cast<uint64_t>(a[i + j]) * b[Step * (i + j)];\n        }\n        sum %= MOD;\n    }\n    for (; i < count; ++i) {\n        sum += static_cast<uint64_t>(a[i]) * b[Step * i];\n    }\n    return static_cast<uint32_t>(sum % MOD);\n}\n\nstatic inline uint32_t coefficient(const uint32_t* a, int na,\n                                   const uint32_t* b, int nb, int degree) {\n    const int first = max(0, degree - nb + 1);\n    const int last = min(na - 1, degree);\n    if (first > last) return 0;\n    return dot_mod<-1>(a + first, b + degree - first, last - first + 1);\n}\n\nstatic uint32_t short_horizon(vector<uint32_t> state,\n                              const vector<uint32_t>& weights,\n                              uint64_t steps) {\n    const int n = static_cast<int>(state.size());\n    vector<uint32_t> reversed(n);\n    for (int i = 0; i < n; ++i) reversed[i] = weights[n - 1 - i];\n    int head = 0;\n    uint32_t value = state[n - 1];\n    for (uint64_t step = 0; step < steps; ++step) {\n        value = dot_mod<1>(state.data() + head, reversed.data(), n - head)\n              + dot_mod<1>(state.data(), reversed.data() + n - head, head);\n        if (value >= MOD) value -= MOD;\n        state[head] = value;\n        if (++head == n) head = 0;\n    }\n    return value;\n}\n\nstatic inline void transform_row(int i, int parity, int n,\n                                 const uint32_t* p, const uint32_t* q,\n                                 const uint32_t* q_minus,\n                                 uint32_t* p_next, uint32_t* q_next,\n                                 uint32_t* q_minus_next) {\n    if (i < n) {\n        p_next[i] = coefficient(p, n, q_minus, n + 1, 2 * i + parity);\n    }\n    const uint32_t value = coefficient(q, n + 1, q_minus, n + 1, 2 * i);\n    q_next[i] = value;\n    q_minus_next[i] = ((i & 1) && value != 0) ? MOD - value : value;\n}\n\nstatic uint32_t distant_term(const vector<uint32_t>& initial,\n                             const vector<uint32_t>& weights,\n                             uint64_t index) {\n    const int n = static_cast<int>(initial.size());\n    vector<uint32_t> numerator0(n), numerator1(n);\n    vector<uint32_t> denominator0(n + 1), denominator1(n + 1);\n    vector<uint32_t> minus0(n + 1), minus1(n + 1);\n\n    // The generating function is P(x)/Q(x), with deg(P) < n.\n    denominator0[0] = 1;\n    for (int i = 1; i <= n; ++i) {\n        denominator0[i] = weights[i - 1] == 0 ? 0U : MOD - weights[i - 1];\n    }\n    for (int i = 0; i <= n; ++i) {\n        const uint32_t value = denominator0[i];\n        minus0[i] = ((i & 1) && value != 0) ? MOD - value : value;\n    }\n\n#ifdef _OPENMP\n    if (n >= 128) {\n        uint32_t result = 0;\n        // Keep one team alive across all Bostan-Mori steps.\n#pragma omp parallel\n        {\n            uint32_t* p = numerator0.data();\n            uint32_t* p_next = numerator1.data();\n            uint32_t* q = denominator0.data();\n            uint32_t* q_next = denominator1.data();\n            uint32_t* q_minus = minus0.data();\n            uint32_t* q_minus_next = minus1.data();\n\n#pragma omp for schedule(static, 1)\n            for (int i = 0; i < n; ++i) {\n                p[i] = coefficient(initial.data(), n, q, n + 1, i);\n            }\n\n            uint64_t remaining = index;\n            while (remaining != 0) {\n                const int parity = static_cast<int>(remaining & 1U);\n#pragma omp for schedule(static, 16)\n                for (int i = 0; i <= n; ++i) {\n                    transform_row(i, parity, n, p, q, q_minus,\n                                  p_next, q_next, q_minus_next);\n                }\n                // The work-sharing barrier completes both output buffers.\n                // Pointer swaps are private, so no single-region barrier is needed.\n                swap(p, p_next);\n                swap(q, q_next);\n                swap(q_minus, q_minus_next);\n                remaining >>= 1;\n            }\n#pragma omp single nowait\n            {\n                result = p[0];\n            }\n        }\n        return result;\n    }\n#endif\n\n    uint32_t* p = numerator0.data();\n    uint32_t* p_next = numerator1.data();\n    uint32_t* q = denominator0.data();\n    uint32_t* q_next = denominator1.data();\n    uint32_t* q_minus = minus0.data();\n    uint32_t* q_minus_next = minus1.data();\n    for (int i = 0; i < n; ++i) {\n        p[i] = coefficient(initial.data(), n, q, n + 1, i);\n    }\n    while (index != 0) {\n        const int parity = static_cast<int>(index & 1U);\n        for (int i = 0; i <= n; ++i) {\n            transform_row(i, parity, n, p, q, q_minus,\n                          p_next, q_next, q_minus_next);\n        }\n        swap(p, p_next);\n        swap(q, q_next);\n        swap(q_minus, q_minus_next);\n        index >>= 1;\n    }\n    // Q(0) starts at one and remains one after every transformation.\n    return p[0];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    uint64_t h;\n    if (!(cin >> n >> h)) return 0;\n\n    vector<uint32_t> initial(n), weights(n);\n    uint64_t input;\n    for (uint32_t& value : initial) {\n        cin >> input;\n        value = static_cast<uint32_t>(input % MOD);\n    }\n    for (uint32_t& value : weights) {\n        cin >> input;\n        value = static_cast<uint32_t>(input % MOD);\n    }\n\n    uint32_t answer;\n    if (h <= static_cast<uint64_t>(n)) {\n        answer = initial[static_cast<size_t>(h - 1)];\n    } else {\n        const uint64_t steps = h - static_cast<uint64_t>(n);\n        if (steps <= static_cast<uint64_t>(n)) {\n            answer = short_horizon(move(initial), weights, steps);\n        } else {\n            answer = distant_term(initial, weights, h - 1);\n        }\n    }\n    cout << answer << '\\n';\n    return 0;\n}\n",

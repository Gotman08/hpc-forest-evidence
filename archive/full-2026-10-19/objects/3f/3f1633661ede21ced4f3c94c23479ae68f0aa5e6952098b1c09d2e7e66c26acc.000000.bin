#include <algorithm>
#include <cstdint>
#include <iostream>
#include <vector>

#if defined(__aarch64__) || defined(__ARM_NEON)
#include <arm_neon.h>
#endif

using namespace std;

constexpr uint32_t MOD = 1000000007U;

static inline uint32_t add_mod(uint32_t left, uint32_t right) {
    const uint32_t sum = left + right;
    return sum >= MOD ? sum - MOD : sum;
}

#if defined(__aarch64__) || defined(__ARM_NEON)
static inline uint32x4_t add_mod(uint32x4_t left, uint32x4_t right) {
    const uint32x4_t sum = vaddq_u32(left, right);
    const uint32x4_t needs_reduction = vcgeq_u32(sum, vdupq_n_u32(MOD));
    return vsubq_u32(sum, vandq_u32(needs_reduction, vdupq_n_u32(MOD)));
}
#endif

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    size_t m;
    cin >> n >> m;

    vector<uint64_t> blocked;
    blocked.reserve(m);
    for (size_t i = 0; i < m; ++i) {
        int y, x;
        cin >> y >> x;
        blocked.push_back(static_cast<uint64_t>(y) * static_cast<uint64_t>(n) +
                          static_cast<uint32_t>(x));
    }
    sort(blocked.begin(), blocked.end());
    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());

    vector<uint32_t> dp(n, 0);
    dp[0] = 1;

    size_t blocked_index = 0;
    for (int y = 0; y < n; ++y) {
        const uint64_t row_begin = static_cast<uint64_t>(y) * static_cast<uint64_t>(n);
        const uint64_t row_end = row_begin + static_cast<uint64_t>(n);
        int segment_begin = 0;

        while (blocked_index < blocked.size() && blocked[blocked_index] < row_end) {
            const int blocked_x = static_cast<int>(blocked[blocked_index] - row_begin);

#if defined(__aarch64__) || defined(__ARM_NEON)
            uint32_t carry = segment_begin == 0 ? 0 : dp[segment_begin - 1];
            int x = segment_begin;
            const uint32x4_t zero = vdupq_n_u32(0);
            for (; x + 4 <= blocked_x; x += 4) {
                uint32x4_t values = vld1q_u32(dp.data() + x);
                values = add_mod(values, vextq_u32(zero, values, 3));
                values = add_mod(values, vextq_u32(zero, values, 2));
                values = add_mod(values, vdupq_n_u32(carry));
                vst1q_u32(dp.data() + x, values);
                carry = vgetq_lane_u32(values, 3);
            }
            for (; x < blocked_x; ++x) {
                dp[x] = add_mod(dp[x], carry);
                carry = dp[x];
            }
#else
            uint32_t carry = segment_begin == 0 ? 0 : dp[segment_begin - 1];
            for (int x = segment_begin; x < blocked_x; ++x) {
                dp[x] = add_mod(dp[x], carry);
                carry = dp[x];
            }
#endif

            dp[blocked_x] = 0;
            segment_begin = blocked_x + 1;
            ++blocked_index;
        }

#if defined(__aarch64__) || defined(__ARM_NEON)
        uint32_t carry = segment_begin == 0 ? 0 : dp[segment_begin - 1];
        int x = segment_begin;
        const uint32x4_t zero = vdupq_n_u32(0);
        for (; x + 4 <= n; x += 4) {
            uint32x4_t values = vld1q_u32(dp.data() + x);
            values = add_mod(values, vextq_u32(zero, values, 3));
            values = add_mod(values, vextq_u32(zero, values, 2));
            values = add_mod(values, vdupq_n_u32(carry));
            vst1q_u32(dp.data() + x, values);
            carry = vgetq_lane_u32(values, 3);
        }
        for (; x < n; ++x) {
            dp[x] = add_mod(dp[x], carry);
            carry = dp[x];
        }
#else
        uint32_t carry = segment_begin == 0 ? 0 : dp[segment_begin - 1];
        for (int x = segment_begin; x < n; ++x) {
            dp[x] = add_mod(dp[x], carry);
            carry = dp[x];
        }
#endif
    }

    cout << dp[n - 1] << '\n';
}

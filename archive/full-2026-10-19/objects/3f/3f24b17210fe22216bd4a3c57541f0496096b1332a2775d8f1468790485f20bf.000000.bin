      "content": "#include \"knn.h\"\n#include <omp.h>\n\ntypedef struct {\n    float d;\n    int idx;\n    char label;\n} Candidate;\n\nstatic void insert_candidate(Candidate *list, int *count, Candidate cand, int maxk) {\n    if (*count == 0) {\n        list[0] = cand;\n        *count = 1;\n        return;\n    }\n    // find insertion position (sorted by d then idx)\n    int pos = *count;\n    while (pos > 0) {\n        Candidate prev = list[pos-1];\n        if (cand.d < prev.d || (cand.d == prev.d && cand.idx < prev.idx)) {\n            pos--;\n        } else {\n            break;\n        }\n    }\n    // shift right\n    for (int i = *count; i > pos; i--) {\n        list[i] = list[i-1];\n    }\n    list[pos] = cand;\n    if (*count < maxk) (*count)++;\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    // Count total points\n    long N = 0;\n    for (int i = 0; i < n_groups; i++) {\n        N += groups[i].length;\n    }\n\n    // Flatten points and labels\n    Point *all_points = (Point *) malloc(sizeof(Point) * N);\n    char *all_labels = (char *) malloc(sizeof(char) * N);\n    long idx = 0;\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            all_points[idx] = g.points[j];\n            all_labels[idx] = g.label;\n            idx++;\n        }\n    }\n\n    int nthreads = 1;\n#pragma omp parallel\n    {\n#pragma omp single\n        nthreads = omp_get_num_threads();\n    }\n\n    // Allocate per-thread candidate lists\n    Candidate **local_lists = (Candidate **) malloc(sizeof(Candidate *) * nthreads);\n    int *counts = (int *) calloc(nthreads, sizeof(int));\n    for (int t = 0; t < nthreads; t++) {\n        local_lists[t] = (Candidate *) malloc(sizeof(Candidate) * k);\n    }\n\n#pragma omp parallel\n    {\n        int tid = omp_get_thread_num();\n        Candidate *local = local_lists[tid];\n        int cnt = 0;\n\n#pragma omp for schedule(guided)\n        for (long i = 0; i < N; i++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, all_points[i]);\n            Candidate cand;\n            cand.d = d;\n            cand.idx = (int) i;\n            cand.label = all_labels[i];\n            insert_candidate(local, &cnt, cand, k);\n        }\n        counts[tid] = cnt;\n    }\n\n    // Merge per-thread lists to get top-k\n    char *result_labels = (char *) malloc(sizeof(char) * k);\n    int *heads = (int *) calloc(nthreads, sizeof(int));\n    for (int sel = 0; sel < k; sel++) {\n        int best_tid = -1;\n        Candidate best;\n        for (int t = 0; t < nthreads; t++) {\n            if (heads[t] < counts[t]) {\n                Candidate cand = local_lists[t][heads[t]];\n                if (best_tid == -1 || cand.d < best.d ||\n                    (cand.d == best.d && cand.idx < best.idx)) {\n                    best = cand;\n                    best_tid = t;\n                }\n            }\n        }\n        if (best_tid == -1) break; // not enough candidates, shouldn't happen\n        result_labels[sel] = best.label;\n        heads[best_tid]++;\n    }\n\n    // Count frequencies as original\n    qsort(result_labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = result_labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (result_labels[i] != result_labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = result_labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = result_labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    // Free memory\n    free(all_points);\n    free(all_labels);\n    for (int t = 0; t < nthreads; t++) free(local_lists[t]);\n    free(local_lists);\n    free(counts);\n    free(heads);\n    free(result_labels);\n\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Use OpenMP guided scheduling for the flattened distance loop and a k-way merge over per-thread sorted candidate lists to reduce synchronization overhead while preserving exact tie-breaking via (distance, index) ordering.",
  "notes": "Flatten all points into contiguous arrays, compute distances in parallel with schedule(guided), each thread maintains an insertion-sorted top-k list keyed by (distance,index). Merge the per-thread lists using a linear k-way selection to obtain the exact same nearest-neighbor set as the sequential algorithm. Frequency counting remains unchanged.",

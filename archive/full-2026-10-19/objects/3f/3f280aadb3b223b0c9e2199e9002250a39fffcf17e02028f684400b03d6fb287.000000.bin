      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\ntypedef struct { float x, y, z; } Position;\n\n/* Calculate one body's force in ascending source-body order. */\nstatic void body_force_one(const Position *positions, Body *bodies,\n                           float dt, int n, int i) {\n  float fx = 0.0f;\n  float fy = 0.0f;\n  float fz = 0.0f;\n\n  for (int j = 0; j < n; j++) {\n    float dx = positions[j].x - positions[i].x;\n    float dy = positions[j].y - positions[i].y;\n    float dz = positions[j].z - positions[i].z;\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n    fx += dx * inv_dist3;\n    fy += dy * inv_dist3;\n    fz += dz * inv_dist3;\n  }\n\n  bodies[i].vx += dt*fx;\n  bodies[i].vy += dt*fy;\n  bodies[i].vz += dt*fz;\n}\n\n/* Read a binary dataset with initialized bodies. */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/* Write simulation results into a binary dataset. */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc, char **argv) {\n  int nbodies;\n  Body *bodies = read_dataset(&nbodies);\n  Position *positions = (Position *)malloc((size_t)nbodies * sizeof(Position));\n  if (positions == NULL && nbodies > 0) {\n    fprintf(stderr,\"\\nError allocating positions\\n\");\n    free(bodies);\n    exit(EXIT_FAILURE);\n  }\n\n  for (int i = 0; i < nbodies; i++) {\n    positions[i].x = bodies[i].x;\n    positions[i].y = bodies[i].y;\n    positions[i].z = bodies[i].z;\n  }\n\n  /* Reuse one team; barriers separate force, position, and output phases. */\n  #pragma omp parallel\n  {\n    for (int iter = 0; iter < N_ITER; iter++) {\n      #pragma omp for schedule(static)\n      for (int i = 0; i < nbodies; ++i) {\n        body_force_one(positions, bodies, DT, nbodies, i);\n      }\n\n      #pragma omp for schedule(static)\n      for (int i = 0; i < nbodies; ++i) {\n        positions[i].x += bodies[i].vx * DT;\n        positions[i].y += bodies[i].vy * DT;\n        positions[i].z += bodies[i].vz * DT;\n      }\n    }\n\n    #pragma omp for schedule(static)\n    for (int i = 0; i < nbodies; ++i) {\n      bodies[i].x = positions[i].x;\n      bodies[i].y = positions[i].y;\n      bodies[i].z = positions[i].z;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n  free(positions);\n  free(bodies);\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Combining a persistent OpenMP team with a compact position array may retain the verified parallel speedup while reducing the memory traffic of the all-pairs position scan. The source-body accumulation order remains unchanged.",

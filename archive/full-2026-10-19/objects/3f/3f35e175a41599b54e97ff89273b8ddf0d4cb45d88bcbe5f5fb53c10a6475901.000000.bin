{
  "src/quicksort.c": "/*\n  Quicksort\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <limits.h>\n#include <openssl/md5.h>\n\n#if defined(_OPENMP) && (UINT_MAX == 0xffffffffU)\n#include <omp.h>\n\n#define RADIX_BITS 8U\n#define RADIX_BUCKETS (1U << RADIX_BITS)\n#define RADIX_MASK (RADIX_BUCKETS - 1U)\n#define RADIX_SIGN_BIT 0x80000000U\n#define RADIX_PARALLEL_CUTOFF 32768\n\nstatic int radix_sort_parallel(int *values, int count);\n#endif\n\n/*\n * Prototypes\n */\nvoid srandnum(int seed);\ndouble randnum(void);\nint *generate_case(int N);\ndouble drand(int xmin, int xmax);\nvoid swap(int *toorder, int i, int j);\nint partition(int *toorder, int lo, int hi);\nvoid _quicksort(int *toorder, int lo, int hi);\nvoid quicksort(int *toorder, int N);\nint is_sorted(int *toorder, int N);\n\n/*\n * A generic pRNG\n */\n#define MY_RAND_MAX 0x7FFFFFFF\n\n#define RANDNUM_W 521288629\n#define RANDNUM_Z 362436069\n\nunsigned int randum_w = RANDNUM_W;\nunsigned int randum_z = RANDNUM_Z;\n\nvoid srandnum(int seed)\n{\n    unsigned int w, z;\n    w = (seed * 104623) & 0xffffffff;\n    randum_w = (w) ? w : RANDNUM_W;\n    z = (seed * 48947) & 0xffffffff;\n    randum_z = (z) ? z : RANDNUM_Z;\n}\n\ndouble randnum(void)\n{\n    unsigned int u;\n    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);\n    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);\n    u = (randum_z << 16) + randum_w;\n    return (abs(u));\n}\n\n/*\n * Main function\n */\nint main(int argc, char *argv[])\n{\n    int N = 0;\n    int *our_list = NULL;\n\n    //The input provides the case size\n    scanf(\"%d\", &N);\n    if (N <= 0) {\n        printf(\"Error: please, provide the case size.\\n\");\n        return 1;\n    }\n\n    //Generate the case\n    our_list = generate_case(N);\n    if (our_list == NULL) {\n        printf(\"Error: case instantiation failed.\\n\");\n        return 1;\n    }\n\n    //Do the thing\n    quicksort(our_list, N);\n\n    if (is_sorted(our_list, N) == 1) {\n        printf(\"Error, for some reason list is still unsorted.\\n\");\n        return 1;\n    }\n\n#ifdef COMPUTE_MD5_PROBLEM\n    //Compute MD5 Checksum for problem identification\n    MD5_CTX c;\n    unsigned char out[MD5_DIGEST_LENGTH];\n    MD5_Init(&c);\n    MD5_Update(&c, our_list, N * sizeof(int));\n    MD5_Final(out, &c);\n    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {\n        printf(\"%02x\", out[n]);\n    }\n#endif\n    printf(\"\\n\");\n\n    //Clean up\n    free(our_list);\n\n    return 0;\n}\n\n/*\n * Public API\n */\nvoid quicksort(int *toorder, int N)\n{\n#if defined(_OPENMP) && (UINT_MAX == 0xffffffffU)\n    if (N >= RADIX_PARALLEL_CUTOFF && radix_sort_parallel(toorder, N)) {\n        return;\n    }\n#endif\n    _quicksort(toorder, 0, N - 1);\n}\n\n#if defined(_OPENMP) && (UINT_MAX == 0xffffffffU)\n/*\n * Four stable byte-radix passes leave the final result in values.  Each\n * worker owns a contiguous input range and one histogram row.  Prefixing\n * rows by worker order gives every scatter a disjoint output interval.\n */\nstatic int radix_sort_parallel(int *values, int count)\n{\n    int maximum_threads = omp_get_max_threads();\n    int *scratch;\n    unsigned int *histogram;\n    size_t histogram_entries;\n    int *source = values;\n    int *destination;\n\n    if (maximum_threads < 2) {\n        return 0;\n    }\n    if ((size_t)count > (size_t)-1 / sizeof *scratch) {\n        return 0;\n    }\n    if ((size_t)maximum_threads > (size_t)-1 / (size_t)RADIX_BUCKETS) {\n        return 0;\n    }\n\n    histogram_entries = (size_t)maximum_threads * (size_t)RADIX_BUCKETS;\n    if (histogram_entries > (size_t)-1 / sizeof *histogram) {\n        return 0;\n    }\n\n    scratch = (int *)malloc((size_t)count * sizeof *scratch);\n    if (scratch == NULL) {\n        return 0;\n    }\n\n    histogram = (unsigned int *)malloc(histogram_entries * sizeof *histogram);\n    if (histogram == NULL) {\n        free(scratch);\n        return 0;\n    }\n    destination = scratch;\n\n#pragma omp parallel shared(source, destination, histogram, count)\n    {\n        const int thread_id = omp_get_thread_num();\n        const int thread_count = omp_get_num_threads();\n        const size_t begin = ((size_t)count * (size_t)thread_id) /\n                             (size_t)thread_count;\n        const size_t end = ((size_t)count * (size_t)(thread_id + 1)) /\n                           (size_t)thread_count;\n\n        for (unsigned int shift = 0; shift < 32U; shift += RADIX_BITS) {\n            unsigned int *local_histogram =\n                histogram + (size_t)thread_id * (size_t)RADIX_BUCKETS;\n\n#if _OPENMP >= 201307\n#pragma omp simd\n#endif\n            for (unsigned int bucket = 0; bucket < RADIX_BUCKETS; ++bucket) {\n                local_histogram[bucket] = 0;\n            }\n\n            for (size_t index = begin; index < end; ++index) {\n                const unsigned int key =\n                    ((unsigned int)source[index]) ^ RADIX_SIGN_BIT;\n                ++local_histogram[(key >> shift) & RADIX_MASK];\n            }\n\n#pragma omp barrier\n#pragma omp single\n            {\n                unsigned int position = 0;\n                for (unsigned int bucket = 0; bucket < RADIX_BUCKETS; ++bucket) {\n                    for (int worker = 0; worker < thread_count; ++worker) {\n                        unsigned int *slot =\n                            histogram + (size_t)worker * (size_t)RADIX_BUCKETS + bucket;\n                        const unsigned int bucket_count = *slot;\n                        *slot = position;\n                        position += bucket_count;\n                    }\n                }\n            }\n\n            for (size_t index = begin; index < end; ++index) {\n                const unsigned int key =\n                    ((unsigned int)source[index]) ^ RADIX_SIGN_BIT;\n                const unsigned int bucket = (key >> shift) & RADIX_MASK;\n                destination[local_histogram[bucket]++] = source[index];\n            }\n\n#pragma omp barrier\n#pragma omp single\n            {\n                int *temporary = source;\n                source = destination;\n                destination = temporary;\n            }\n        }\n    }\n\n    free(histogram);\n    free(scratch);\n    return 1;\n}\n#endif\n\n/*\n * Internal recursive function to quicksort\n */\nvoid _quicksort(int *toorder, int lo, int hi)\n{\n    if (lo >= hi)\n        return;\n    int b = partition(toorder, lo, hi);\n    _quicksort(toorder, lo, b - 1);\n    _quicksort(toorder, b + 1, hi);\n}\n\n/*\n * Swap two values.\n */\nvoid swap(int *toorder, int i, int j)\n{\n    int temp = toorder[i];\n    toorder[i] = toorder[j];\n    toorder[j] = temp;\n}\n\n/*\n * Partition decision\n */\nint partition(int *toorder, int lo, int hi)\n{\n    int b = lo;\n    int r = (int) (lo + (hi - lo) * (randnum() / MY_RAND_MAX));\n    int pivot = toorder[r];\n    swap(toorder, r, hi);\n    for (int i = lo; i < hi; i++) {\n        if (toorder[i] < pivot) {\n            swap(toorder, i, b);\n            b++;\n        }\n    }\n    swap(toorder, hi, b);\n    return b;\n}\n\n/*\n * Check if elements are in non-decreasing order\n */\nint is_sorted(int *toorder, int N)\n{\n    int unsorted = 0;\n\n#if defined(_OPENMP) && (_OPENMP >= 201307)\n#pragma omp simd reduction(|: unsorted)\n#endif\n    for (int i = 1; i < N; i++) {\n        unsorted |= toorder[i] < toorder[i - 1];\n    }\n    return unsorted;\n}\n\n/*\n * Generate a case\n */\nint *generate_case(int N)\n{\n    int i;\n    int *ret = NULL;\n\n    // Make case generation reproducible\n    srandnum(0);\n\n    // Allocate memory\n    ret = (int *) malloc(N * sizeof(int));\n    if (ret == NULL) {\n        printf(\"Error: some malloc won't work.\\n\");\n        return NULL;\n    }\n    // Get pseudo-random positive integer values\n    for (i = 0; i < N; i++) {\n        ret[i] = drand(0, INT_MAX);\n    }\n    return ret;\n}\n\n/*\n * A pseudo-random number between two positive integer values\n */\ndouble drand(int xmin, int xmax)\n{\n    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;\n}\n"
}

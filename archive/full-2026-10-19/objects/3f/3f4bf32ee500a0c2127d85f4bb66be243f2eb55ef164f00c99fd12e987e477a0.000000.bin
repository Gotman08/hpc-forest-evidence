f (needed <= capacity) return;\\n+        const std::size_t next_capacity = std::max(needed, capacity * 2);\\n+        std::unique_ptr<unsigned char[]> next(new unsigned char[next_capacity]);\\n+        std::memcpy(next.get(), bytes.get(), used);\\n+        bytes.swap(next);\\n+        capacity = next_capacity;\\n+    }\\n+};\\n+\\n+std::size_t read_block(InputBlock& block) {\\n+    std::size_t length = std::fread(block.bytes.get(), 1, block_bytes, stdin);\\n+    if (length == 0) return 0;\\n+    while (block.bytes[length - 1] > ' ') {\\n+        const int c = std::fgetc(stdin);\\n+        if (c == EOF) break;\\n+        block.ensure(length + 2, length);\\n+        block.bytes[length++] = static_cast<unsigned char>(c);\\n+    }\\n+    block.bytes[length] = ' ';\\n+    return length;\\n+}\\n+\\n+std::size_t count_tokens(const unsigned char* bytes, std::size_t length) {\\n+    std::size_t count = bytes[0] > ' ' ? 1 : 0;\\n+    #pragma omp simd reduction(+:count)\\n+    for (std::size_t i = 1; i < length; ++i) {\\n+        count += static_cast<std::size_t>(bytes[i] > ' ' && bytes[i - 1] <= ' ');\\n+    }\\n+    return count;\\n+}\\n+\\n+inline int read_integer(const unsigned char*& p) {\\n+    while (*p <= ' ') ++p;\\n+    const bool negative = *p == '-';\\n+    if (negative || *p == '+') ++p;\\n+    std::uint32_t magnitude = 0;\\n+    for (;;) {\\n+        const unsigned digit = static_cast<unsigned>(*p - '0');\\n+        if (digit > 9) break;\\n+        magnitude = magnitude * 10 + digit;\\n+        ++p;\\n+    }\\n+    return negative ? static_cast<int>(-static_cast<Sum>(magnitude))\\n+                    : static_cast<int>(magnitude);\\n+}\\n+\\n+int current_thread() {\\n+#ifdef _OPENMP\\n+    return omp_get_thread_num();\\n+#else\\n+    return 0;\\n+#endif\\n+}\\n+\\n+void decode_block(const unsigned char* bytes, std::size_t count,\\n+                  std::size_t first, int n, const int* row_stripe,\\n+                  int* matrix, Sum* partials) {\\n+    const unsigned char* p = bytes;\\n+    int row = static_cast<int>(first / static_cast<std::size_t>(n));\\n+    int column = static_cast<int>(first % static_cast<std::size_t>(n));\\n+    int* destination = matrix + first;\\n+    while (count != 0) {\\n+        const std::size_t take = std::min(count, static_cast<std::size_t>(n - column));\\n+        const int stripe = row_stripe[row];\\n+        if (stripe >= 0) {\\n+            Sum* sums = partials + static_cast<std::size_t>(stripe) * n + column;\\n+            for (std::size_t k = 0; k < take; ++k) {\\n+                const int value = read_integer(p);\\n+                destination[k] = value;\\n+                sums[k] += value;\\n+            }\\n+        } else {\\n+            for (std::size_t k = 0; k < take; ++k) {\\n+                destination[k] = read_integer(p);\\n+            }\\n+        }\\n+        destination += take;\\n+        count -= take;\\n+        column = 0;\\n+        ++row;\\n+    }\\n+}\\n+}\\n \\n int main() {\\n-\\tint n,s;\\n-\\tstd::cin >> n >> s;\\n-\\tstd::vector<std::vector<int> > matrix(n, std::vector<int>(n));\\n-\\tfor(int i=0;i<n;i++)\\n-\\t\\tfor(int j=0;j<n;j++) \\n-\\t\\t\\tscanf(\\\"%d\\\", &(matrix[i][j]));\\n-\\n-\\tassert(s<n);\\n-\\tassert(n<8000);\\n-\\tassert(s>0);\\n-\\tassert(n>0);\\n-\\n-\\tint sum = 0;\\n-\\tfor(int i=0;i<s;i++)\\n-\\t\\tfor(int j=0;j<s;j++)\\n-\\t\\t\\tsum += matrix[i][j];\\n-\\n-\\tint mxSum = sum;\\n-\\n-\\tint dir = 1;\\n-\\tint i = 0;\\n-\\tint j = 0;\\n-\\twhile(i+s <= n) {\\n-\\t\\tif( (j+s == n && dir==1) || (j==0 && dir==-1) ) { \\n-\\t\\t\\tint exitingRow = i;\\n-\\t\\t\\tint enteringRow = exitingRow+s;\\n-\\t\\t\\tif(enteringRow >=n) break;\\n-\\n-\\t\\t\\tfor(int k=0;k<s;k++) { sum -= matrix[exitingRow][k+j]; } \\n-\\t\\t\\tfor(int k=0;k<s;k++) { sum += matrix[enteringRow][k+j];\\t} \\n-\\t\\t\\t\\n-\\t\\t\\ti++;\\n-\\t\\t\\tdir*=-1;\\n-\\t\\t} else {\\n-\\t\\t\\tint exitingCol,enteringCol;\\n-\\t\\t\\tif(dir==1) {\\n-\\t\\t\\t\\texitingCo
        "content": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <utility>\n#include <vector>\n\nusing namespace std;\n\nstruct adjacency_matrix {\n    explicit adjacency_matrix(int number_of_vertices = 0)\n        : vertices(number_of_vertices),\n          values(static_cast<size_t>(number_of_vertices) *\n                     static_cast<size_t>(number_of_vertices),\n                 0) {\n    }\n\n    int size() const {\n        return vertices;\n    }\n\n    const unsigned char *row(int index) const {\n        return values.data() +\n               static_cast<size_t>(index) * static_cast<size_t>(vertices);\n    }\n\n    unsigned char value(int source, int destination) const {\n        return row(source)[destination];\n    }\n\n    void addEdge(int source, int destination) {\n        values[static_cast<size_t>(source) * static_cast<size_t>(vertices) +\n               static_cast<size_t>(destination)] = 1;\n        values[static_cast<size_t>(destination) * static_cast<size_t>(vertices) +\n               static_cast<size_t>(source)] = 1;\n    }\n\n    int vertices;\n    vector<unsigned char> values;\n};\n\nstruct relation {\n    int source;\n    int destination;\n};\n\nstruct vertex_key {\n    int degree;\n    unsigned char diagonal;\n    int combined_index;\n};\n\nstatic const size_t unique_search_node_limit = 2048;\n\nstatic adjacency_matrix readGraph() {\n    int vertices;\n    int edges;\n    int source;\n    int destination;\n\n    cin >> vertices;\n    adjacency_matrix graph(vertices);\n    cin >> edges;\n\n    for (int edge = 0; edge < edges; ++edge) {\n        cin >> source >> destination;\n        graph.addEdge(source, destination);\n    }\n\n    return graph;\n}\n\nstatic vector<int> calculateDegrees(const adjacency_matrix &graph) {\n    const int vertices = graph.size();\n    vector<int> degrees(vertices, 0);\n\n    for (int vertex = 0; vertex < vertices; ++vertex) {\n        const unsigned char *current_row = graph.row(vertex);\n        int total = 0;\n#pragma GCC ivdep\n        for (int column = 0; column < vertices; ++column)\n            total += current_row[column];\n        degrees[vertex] = total;\n    }\n\n    return degrees;\n}\n\nstatic size_t countRelations(const adjacency_matrix &graph) {\n    const int vertices = graph.size();\n    size_t count = 0;\n\n    for (int source = 0; source < vertices; ++source) {\n        const unsigned char *current_row = graph.row(source);\n        for (int destination = 0; destination <= source; ++destination)\n            count += current_row[destination];\n    }\n\n    return count;\n}\n\nstatic void printPermutation(const vector<int> &equivalence) {\n    for (int value : equivalence)\n        cout << value << \" \";\n    cout << endl;\n}\n\nstatic vector<int> makeInitialColors(const adjacency_matrix &left,\n                                     const adjacency_matrix &right,\n                                     const vector<int> &left_degrees,\n                                     const vector<int> &right_degrees) {\n    const int vertices = left.size();\n    vector<vertex_key> keys;\n    keys.reserve(static_cast<size_t>(vertices) * 2);\n\n    for (int vertex = 0; vertex < vertices; ++vertex) {\n        keys.push_back(vertex_key{left_degrees[vertex],\n                                  left.value(vertex, vertex), vertex});\n        keys.push_back(vertex_key{right_degrees[vertex],\n                                  right.value(vertex, vertex), vertices + vertex});\n    }\n\n    sort(keys.begin(), keys.end(),\n         [](const vertex_key &first, const vertex_key &second) {\n             if (first.degree != second.degree)\n                 return first.degree < second.degree;\n             return first.diagonal < second.diagonal;\n         });\n\n    vector<int> colors(static_cast<size_t>(vertices) * 2, 0);\n    int color = 0;\n    for (size_t position = 0; position < keys.size(); ++position) {\n        if (position != 0 &&\n            (keys[position].degree != keys[position - 1].degree ||\n             keys[position].diagonal != keys[position - 1].diagonal))\n            ++color;\n        colors[keys[position].combined_index] = color;\n    }\n\n    return colors;\n}\n\nstatic bool signatureLess(const vector<int> &signatures, int width,\n                          int first, int second) {\n    const size_t first_offset =\n        static_cast<size_t>(first) * static_cast<size_t>(width);\n    const size_t second_offset =\n        static_cast<size_t>(second) * static_cast<size_t>(width);\n\n    for (int column = 0; column < width; ++column) {\n        const int first_value = signatures[first_offset + static_cast<size_t>(column)];\n        const int second_value = signatures[second_offset + static_cast<size_t>(column)];\n        if (first_value != second_value)\n            return first_value < second_value;\n    }\n\n    return false;\n}\n\nstatic bool sameSignature(const vector<int> &signatures, int width,\n                          int first, int second) {\n    const size_t first_offset =\n        static_cast<size_t>(first) * static_cast<size_t>(width);\n    const size_t second_offset =\n        static_cast<size_t>(second) * static_cast<size_t>(width);\n\n    for (int column = 0; column < width; ++column) {\n        if (signatures[first_offset + static_cast<size_t>(column)] !=\n            signatures[second_offset + static_cast<size_t>(column)])\n            return false;\n    }\n\n    return true;\n}\n\nstatic void refineColors(const adjacency_matrix &left,\n                         const adjacency_matrix &right,\n                         vector<int> &colors) {\n    const int vertices = left.size();\n    if (vertices == 0)\n        return;\n\n    const int total_vertices = vertices * 2;\n    for (;;) {\n        int number_of_colors = 0;\n        for (int color : colors) {\n            if (color + 1 > number_of_colors)\n                number_of_colors = color + 1;\n        }\n\n        const int width = number_of_colors + 1;\n        vector<int> signatures(static_cast<size_t>(total_vertices) *\n                                   static_cast<size_t>(width),\n                               0);\n\n        for (int combined = 0; combined < total_vertices; ++combined) {\n            const bool from_left = combined < vertices;\n            const adjacency_matrix &graph = from_left ? left : right;\n            const int local_vertex = from_left ? combined : combined - vertices;\n            const int color_offset = from_left ? 0 : vertices;\n            const size_t offset =\n                static_cast<size_t>(combined) * static_cast<size_t>(width);\n            const unsigned char *current_row = graph.row(local_vertex);\n\n            signatures[offset] = colors[combined];\n            for (int neighbor = 0; neighbor < vertices; ++neighbor) {\n                signatures[offset +\n                           static_cast<size_t>(1 + colors[color_offset + neighbor])] +=\n                    current_row[neighbor];\n            }\n        }\n\n        vector<int> order(total_vertices);\n        for (int vertex = 0; vertex < total_vertices; ++vertex)\n            order[vertex] = vertex;\n\n        sort(order.begin(), order.end(),\n             [&signatures, width](int first, int second) {\n                 return signatureLess(signatures, width, first, second);\n             });\n\n        vector<int> next(total_vertices, 0);\n        int next_color = 0;\n        next[order[0]] = 0;\n        for (int position = 1; position < total_vertices; ++position) {\n            if (!sameSignature(signatures, width,\n                               order[position - 1], order[position]))\n                ++next_color;\n            next[order[position]] = next_color;\n        }\n\n        if (next == colors)\n            return;\n        colors.swap(next);\n    }\n}\n\nstatic bool sameColorClassSizes(const vector<int> &colors, int vertices) {\n    int number_of_colors = 0;\n    for (int color : colors) {\n        if (color + 1 > number_of_colors)\n            number_of_colors = color + 1;\n    }\n\n    vector<int> balance(number_of_colors, 0);\n    for (int vertex = 0; vertex < vertices; ++vertex) {\n        ++balance[colors[vertex]];\n        --balance[colors[vertices + vertex]];\n    }\n\n    for (int value : balance) {\n        if (value != 0)\n            return false;\n    }\n\n    return true;\n}\n\nclass bounded_mapping_search {\npublic:\n    bounded_mapping_search(const adjacency_matrix &first_graph,\n                           const adjacency_matrix &second_graph,\n                           const vector<int> &color_values)\n        : left(first_graph),\n          right(second_graph),\n          colors(color_values),\n          vertices(first_graph.size()),\n          mapping(first_graph.size(), -1),\n          used(first_graph.size(), 0),\n          assigned(),\n          available_targets(),\n          first_solution(),\n          nodes(0),\n          solution_count(0),\n          did_cut_off(false) {\n        int number_of_colors = 0;\n        for (int color : colors) {\n            if (color + 1 > number_of_colors)\n                number_of_colors = color + 1;\n        }\n\n        available_targets.assign(number_of_colors, 0);\n        for (int target = 0; target < vertices; ++target)\n            ++available_targets[colors[vertices + target]];\n        assigned.reserve(static_cast<size_t>(vertices));\n    }\n\n    void run() {\n        explore();\n    }\n\n    bool cutoff() const {\n        return did_cut_off;\n    }\n\n    int solutionCount() const {\n        return solution_count;\n    }\n\n    const vector<int> &firstSolution() const {\n        return first_solution;\n    }\n\nprivate:\n    bool compatible(int source, int target) const {\n        const unsigned char *source_row = left.row(source);\n        const unsigned char *target_row = right.row(target);\n\n        if (source_row[source] != target_row[target])\n            return false;\n\n        for (size_t position = 0; position < assigned.size(); ++position) {\n            const int previous_source = assigned[position];\n            if (source_row[previous_source] !=\n                target_row[mapping[previous_source]])\n                return false;\n        }\n\n        return true;\n    }\n\n    int chooseSource() const {\n        int best_source = -1;\n        int fewest_targets = vertices + 1;\n\n        for (int source = 0; source < vertices; ++source) {\n            if (mapping[source] >= 0)\n                continue;\n\n            const int target_count = available_targets[colors[source]];\n            if (target_count < fewest_targets) {\n                fewest_targets = target_count;\n                best_source = source;\n            }\n        }\n\n        return best_source;\n    }\n\n    void explore() {\n        if (did_cut_off || solution_count >= 2)\n            return;\n        if (nodes >= unique_search_node_limit) {\n            did_cut_off = true;\n            return;\n        }\n        ++nodes;\n\n        if (assigned.size() == static_cast<size_t>(vertices)) {\n            ++solution_count;\n            if (solution_count == 1)\n                first_solution = mapping;\n            return;\n        }\n\n        const int source = chooseSource();\n        if (source < 0)\n            return;\n\n        const int source_color = colors[source];\n        for (int target = 0; target < vertices; ++target) {\n            if (used[target] || colors[vertices + target] != source_color ||\n                !compatible(source, target))\n                continue;\n\n            mapping[source] = target;\n            used[target] = 1;\n            --available_targets[source_color];\n            assigned.push_back(source);\n\n            explore();\n\n            assigned.pop_back();\n            ++available_targets[source_color];\n            used[target] = 0;\n            mapping[source] = -1;\n\n            if (did_cut_off || solution_count >= 2)\n                return;\n        }\n    }\n\n    const adjacency_matrix &left;\n    const adjacency_matrix &right;\n    const vector<int> &colors;\n    int vertices;\n    vector<int> mapping;\n    vector<unsigned char> used;\n    vector<int> assigned;\n    vector<int> available_targets;\n    vector<int> first_solution;\n    size_t nodes;\n    int solution_count;\n    bool did_cut_off;\n};\n\nstatic vector<relation> makeConstraints(const adjacency_matrix &graph,\n                                        unsigned char required_relation) {\n    const int vertices = graph.size();\n    vector<relation> constraints;\n\n    for (int source = 0; source < vertices; ++source) {\n        const unsigned char *current_row = graph.row(source);\n        for (int destination = 0; destination <= source; ++destination) {\n            if (current_row[destination] == required_relation)\n                constraints.push_back(relation{source, destination});\n        }\n    }\n\n    return constraints;\n}\n\nstatic bool verifyPermutation(const adjacency_matrix &graph,\n                              const vector<int> &equivalence,\n                              const vector<relation> &constraints,\n                              unsigned char required_relation) {\n    const int vertices = graph.size();\n    const unsigned char *matrix = graph.values.data();\n\n    for (size_t index = 0; index < constraints.size(); ++index) {\n        const relation &current = constraints[index];\n        const size_t offset =\n            static_cast<size_t>(equivalence[current.source]) *\n                static_cast<size_t>(vertices) +\n            static_cast<size_t>(equivalence[current.destination]);\n        if (matrix[offset] != required_relation)\n            return false;\n    }\n\n    return true;\n}\n\nstatic bool enumeratePermutations(const adjacency_matrix &left,\n                                  const adjacency_matrix &right,\n                                  const vector<relation> &constraints,\n                                  unsigned char required_relation) {\n    const int vertices = left.size();\n    vector<int> equivalence(vertices, 0);\n    vector<int> exchange_counter(vertices, 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    for (int vertex = 0; vertex < vertices; ++vertex)\n        equivalence[vertex] = vertex;\n\n    if (verifyPermutation(right, equivalence, constraints, required_relation)) {\n        printPermutation(equivalence);\n        return true;\n    }\n\n    while (exchange_index < vertices) {\n        if (exchange_counter[exchange_index] < exchange_index) {\n            if (exchange_index % 2 == 0)\n                swap(equivalence[0], equivalence[exchange_index]);\n            else\n                swap(equivalence[exchange_counter[exchange_index]],\n                     equivalence[exchange_index]);\n\n            if (verifyPermutation(right, equivalence, constraints,\n                                  required_relation)) {\n                printPermutation(equivalence);\n                isomorphism_found = true;\n            }\n\n            ++exchange_counter[exchange_index];\n            exchange_index = 1;\n        } else {\n            exchange_counter[exchange_index] = 0;\n            ++exchange_index;\n        }\n    }\n\n    return isomorphism_found;\n}\n\nstatic bool testIsomorphism(const adjacency_matrix &left,\n                            const adjacency_matrix &right) {\n    if (left.size() != right.size())\n        return false;\n\n    const int vertices = left.size();\n    if (left.values == right.values) {\n        vector<int> equivalence(vertices, 0);\n        for (int vertex = 0; vertex < vertices; ++vertex)\n            equivalence[vertex] = vertex;\n        printPermutation(equivalence);\n        return true;\n    }\n\n    const size_t left_relations = countRelations(left);\n    const size_t right_relations = countRelations(right);\n    if (left_relations != right_relations)\n        return false;\n\n    const vector<int> left_degrees = calculateDegrees(left);\n    const vector<int> right_degrees = calculateDegrees(right);\n    vector<int> colors = makeInitialColors(left, right,\n                                           left_degrees, right_degrees);\n    refineColors(left, right, colors);\n\n    if (!sameColorClassSizes(colors, vertices))\n        return false;\n\n    bounded_mapping_search search(left, right, colors);\n    search.run();\n    if (!search.cutoff()) {\n        if (search.solutionCount() == 0)\n            return false;\n        if (search.solutionCount() == 1) {\n            printPermutation(search.firstSolution());\n            return true;\n        }\n    }\n\n    const size_t pair_count =\n        static_cast<size_t>(vertices) * static_cast<size_t>(vertices + 1) / 2;\n    const unsigned char required_relation =\n        left_relations <= pair_count - left_relations ? 1 : 0;\n    const vector<relation> constraints =\n        makeConstraints(left, required_relation);\n\n    return enumeratePermutations(left, right, constraints, required_relation);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    const adjacency_matrix first_graph = readGraph();\n    const adjacency_matrix second_graph = readGraph();\n\n    if (!testIsomorphism(first_graph, second_graph))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n",

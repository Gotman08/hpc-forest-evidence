{"files":[{"content":"#include <iostream>\n#include <string>\n#include <map>\n#include <list>\n#include <queue>\n#include <climits>\n#include <vector>\n#include <utility>\n#include <algorithm>\n#include <numeric>\n#include <cstddef>\n#include <cstdio>\n\nusing namespace std;\n\nint nCores = 0;\nint nVertices = 0;\nint nArestas = 0;\nint no_of_vert = 0;\nint contCor = 0;\n\nvector<int> caminhoTropical;\nvector<int> caminho;\nvector<pair<int, int>> arvoreGeradora;\nvector<int> vertexColorIndex;\nint distinctColorCount = 0;\n\nstruct part\n{\n    vector<pair<int, int>> spanning;\n    vector<pair<int, int>> inc_ed;\n    vector<pair<int, int>> exc_ed;\n};\n\nvector<part> partitions;\nvector<pair<int, int>> current_span;\n\nclass graph{\n\tpublic:\n\t    int Vertex;\n\t    vector<vector<int>> adj_mat;\n\t    vector<int> cores;\n\t    \n\t    graph(int vertex)\n\t    {\n\t    \tVertex = vertex;\n\t        for(int i = 0; i < Vertex; i++){\n\t        \tvector<int> aux;\n\t            for(int j = 0; j < Vertex; j++){\n\t                aux.push_back(0);\n\t\t\t\t}\n\t\t\t\tadj_mat.push_back(aux);\n            }\n\t                \n\t        for(int i = 0; i < Vertex; i++)\n\t           cores.push_back(0);\n\t    }\n\t    \n\t    void add_edge(int u, int v)\n\t    {\n\t        adj_mat[u][v] = adj_mat[v][u] = 1;\n\t    }\n};\n\nvoid build_color_indices(const vector<int>& colors)\n{\n    vector<int> sorted_colors = colors;\n    sort(sorted_colors.begin(), sorted_colors.end());\n    sorted_colors.erase(unique(sorted_colors.begin(), sorted_colors.end()), sorted_colors.end());\n\n    distinctColorCount = static_cast<int>(sorted_colors.size());\n    vertexColorIndex.resize(colors.size());\n    for(size_t i = 0; i < colors.size(); i++)\n    {\n        vertexColorIndex[i] = static_cast<int>(lower_bound(sorted_colors.begin(), sorted_colors.end(), colors[i]) - sorted_colors.begin());\n    }\n}\n\nint find_min_key(vector<int> arr, int V, vector<bool> mstset)\n{\n    int min_key=INT_MAX, min_index=-1;\n    for(int i=0;i<V;i++)\n    {\n        if(arr[i]<min_key && mstset[i]==false){\n            min_key=arr[i];\n            min_index=i;\n        }\n    }\n    return min_index;\n}\n\nbool is_cycle(vector<vector<int>> mat,int src, int V)//verificar se o gr?fico formado ? c?clico ou n?o\n{\n    map<int,bool> visited;\n    queue<int> traverse;\n    map<int,int> parent;\n    parent[src]=src;\n    visited[src]=true;\n    traverse.push(src);\n    while(!traverse.empty())\n    {\n        int node=traverse.front();\n        traverse.pop();\n        for(int i=0;i<V;i++)\n            if(mat[node][i]>0)\n            {\n                if(!visited[i])\n                {\n                    traverse.push(i);\n                    visited[i]=true;\n                    parent[i]=node;\n                }\n                else if(visited[i]==true && i!=parent[node])\n                    return 1; //ciclo\n            }\n    }\n    return 0;\n}\n\nint Prim_ST(graph G, vector<pair<int,int>> include_edges, vector<pair<int,int>> exclude_edges)\n{\n    int V = G.Vertex;\n\t           \n    vector<vector<int>> new_mat;\n    vector<vector<int>> mat_cycle;\n    \n    for(int i = 0; i < V; i++){\n    \tvector<int> aux;\n        for(int j = 0; j < V; j++){\n            aux.push_back(0);\n\t\t}\n\t\tmat_cycle.push_back(aux);\n    }\n    \n    for(int i = 0; i < V; i++){\n    \tvector<int> aux;\n        for(int j = 0; j < V; j++){\n            aux.push_back(G.adj_mat[i][j]);\n\t\t}\n\t\tnew_mat.push_back(aux);\n    }\n    \n    int u1,v1;\n    for(vector<pair<int, int>>::iterator it=exclude_edges.begin(); it!=exclude_edges.end();it++)\n    {\n        u1=(*it).first;\n        v1=(*it).second;\n        new_mat[u1][v1]=new_mat[v1][u1]=INT_MIN;\n    }\n    \n    int parent[V];\n    vector<int> key(V);\n    vector<bool> mstset(V);\n    for(int i=0;i<V;i++)\n    {\n        key[i]=INT_MAX;\n        mstset[i]=false;\n        parent[i]=nVertices;\n    }\n    \n    int root;\n    root= 0;\n    parent[root]=-1;\n    \n    int vertex_must_include[V];\n    map<int, int> parent_included_vertex;\n    \n    for(int m=0;m<V;m++)\n        vertex_must_include[m]=false;\n    if(!include_edges.empty())\n    {\n        for(vector<pair<int, int>>::iterator it=include_edges.begin(); it!=include_edges.end();it++)\n        {\n            u1=(*it).first;\n            v1=(*it).second;\n            vertex_must_include[u1]=vertex_must_include[v1]=true;\n            parent_included_vertex[v1]=u1;\n            parent_included_vertex[u1]=100;\n        }\n    }\n    \n    key[root]=0;\n    parent[root]=-1;\n    for(int c=0;c<V;c++)\n    {\n        int u=find_min_key(key, V, mstset);\n        if(u==-1) //desconectado\n        {\n            return -1;\n        }\n        mstset[u]=true;\n        if(parent[u] > 0)\n        \tmat_cycle[parent[u]][u]=new_mat[parent[u]][u];\n        no_of_vert++;\n        for(int v=0;v<V;v++)\n        {\n            if(new_mat[u][v]>0 && mstset[v]==false && new_mat[u][v]< key[v])\n            {\n                \n                if(vertex_must_include[v] && parent_included_vertex[v]!=100 && parent_included_vertex[v]!=u)\n                {\n                    int x=parent_included_vertex[v];\n                    if(parent[x]!=nVertices)\n                        continue;\n                }\n                //para verificar se o ciclo se formou ou n?o\n                int prev=mat_cycle[u][v];\n                mat_cycle[u][v]=new_mat[u][v];\n                \n                bool cycle=is_cycle(mat_cycle, root, V);\n                if(!cycle)\n                {\n                    parent[v]=u;\n                    key[v]=new_mat[u][v];\n                }\n                mat_cycle[u][v]=prev;\n            }\n        }\n    }\n    \n    int tot_cost=0;\n    for(int i=1;i<V;i++){\n        int x=parent[i];\n        tot_cost+=new_mat[x][i];\n        current_span.push_back(make_pair(x, i));\n    }\n    return tot_cost;\n}\n\nvoid exibirVetor(const vector<int>& l)\n{\n    for(auto i: l)\n    {\n    \tif(i == l.back())\n    \t\tcout<<i;\n    \telse\n        \tcout<<i<<\"-\";\n    }\n    cout<<endl;\n}\n\nbool deep_tree(int vertex, const vector<size_t>& offsets, const vector<int>& neighbors,\n               vector<unsigned char>& visited, vector<int>& color_counts,\n               vector<int>& path, int& colors_used)\n{\n    visited[vertex] = 1;\n    path.push_back(vertex);\n\n    int color = vertexColorIndex[vertex];\n    if(color_counts[color]++ == 0)\n        colors_used++;\n\n    bool has_unvisited_neighbor = false;\n    for(size_t edge = offsets[vertex]; edge < offsets[vertex + 1]; edge++)\n    {\n        int next = neighbors[edge];\n        if(!visited[next])\n        {\n            has_unvisited_neighbor = true;\n            if(deep_tree(next, offsets, neighbors, visited, color_counts, path, colors_used))\n                return true;\n        }\n    }\n\n    if(!has_unvisited_neighbor)\n    {\n        if(colors_used == nCores)\n        {\n            exibirVetor(path);\n            cout<<colors_used;\n            return true;\n        }\n        else if(colors_used > contCor)\n        {\n            contCor = colors_used;\n            caminho = path;\n        }\n    }\n\n    if(--color_counts[color] == 0)\n        colors_used--;\n    visited[vertex] = 0;\n    path.pop_back();\n    return false;\n}\n\nbool caminhoTropi()\n{\n    vector<size_t> offsets(static_cast<size_t>(nVertices) + 1, 0);\n    for(const auto& edge : arvoreGeradora)\n    {\n        ++offsets[static_cast<size_t>(edge.first) + 1];\n        ++offsets[static_cast<size_t>(edge.second) + 1];\n    }\n    partial_sum(offsets.begin(), offsets.end(), offsets.begin());\n\n    vector<int> neighbors(arvoreGeradora.size() * 2);\n    vector<size_t> next_position = offsets;\n    for(const auto& edge : arvoreGeradora)\n    {\n        neighbors[next_position[edge.first]++] = edge.second;\n        neighbors[next_position[edge.second]++] = edge.first;\n    }\n\n    vector<unsigned char> visited(nVertices, 0);\n    vector<int> color_counts(distinctColorCount, 0);\n    vector<int> path;\n    path.reserve(nVertices);\n\n    for(int i = 0; i < nVertices; i++)\n    {\n        int colors_used = 0;\n        visited[i] = 1;\n        path.clear();\n        path.push_back(i);\n\n        int root_color = vertexColorIndex[i];\n        if(color_counts[root_color]++ == 0)\n            colors_used++;\n\n        for(size_t edge = offsets[i]; edge < offsets[i + 1]; edge++)\n        {\n            int next = neighbors[edge];\n            if(!visited[next] && deep_tree(next, offsets, neighbors, visited,\n                                           color_counts, path, colors_used))\n                return true;\n        }\n\n        if(--color_counts[root_color] == 0)\n            colors_used--;\n        visited[i] = 0;\n        path.pop_back();\n    }\n    return false;\n}\n\nbool create_partitions(graph G)\n{\n    while(true)\n    {\n    \tpart P;\n        vector<part>::iterator iter;\n        for(vector<part>::iterator it=partitions.begin();it!=partitions.end();it++)\n        {\n            iter=it;\n        }\n        P.spanning=(*iter).spanning;\n        P.exc_ed=(*iter).exc_ed;\n        P.inc_ed=(*iter).inc_ed;\n        partitions.erase(iter);\n        \n        vector<pair<int, int>> stree = P.spanning;\n        vector<pair<int, int>>::iterator it1;\n        vector<pair<int, int>>::iterator it2;\n        \n        arvoreGeradora = stree;\n        \n        if(caminhoTropi()){\n    \t\treturn true;\n    \t}\n        \n        vector<pair<int, int>> included_edges;\n        vector<pair<int, int>> excluded_edges;\n        included_edges=P.inc_ed;\n        pair<int, int> ex_edge;\n        \n        int j;\n        for(j = 0; j < stree.size(); j++)\n        {\n            if(included_edges.empty())\n                break;\n            if(stree[j].first!=included_edges[j].first && stree[j].second!=included_edges[j].second)\n            {\n                break;\n            }\n        }\n        int cost;\n        it2= stree.begin()+ j;\n        int u1,v1;\n        for(it1=it2; it1!=stree.end(); it1++)\n        {\n            part new_p;\n            u1=(*it1).first;\n            v1=(*it1).second;\n            ex_edge.first=u1;\n            ex_edge.second=v1;\n            excluded_edges=P.exc_ed;\n            excluded_edges.push_back(ex_edge);\n            current_span.clear();\n            cost = Prim_ST(G, included_edges, excluded_edges);\n            if(cost > 0)\n            {\n                new_p.spanning=current_span;\n                new_p.inc_ed=included_edges;\n                new_p.exc_ed=excluded_edges;\n                partitions.push_back(new_p);\n            }\n            included_edges.push_back(ex_edge);\n        }\n        \n        if(partitions.empty()){\n            return false;\n        }\n    }\n}\n\nint main() {\n    scanf(\"%i %i\", &nVertices, &nCores);\n    \n    graph G {nVertices};\n    \n    for\t(int i = 0; i < nVertices; i++){\n    \tint cor;\n    \tscanf(\"%i\", &cor);\n    \tG.cores[i] = cor;\n    }\n    \n    scanf(\"%i\", &nArestas);\n    \n    for\t(int i = 0; i < nArestas; i++){\n    \tint u1, v1;\n    \tscanf(\"%i %i\", &u1, &v1);\n        G.add_edge(u1, v1);\n    \t}\n\n    build_color_indices(G.cores);\n\t\n\tvector<pair<int, int>> incl;\n    vector<pair<int, int>> excl;\n    incl.clear();\n    excl.clear();\n    Prim_ST(G, incl, excl);\n    part p;\n    incl.clear();\n    excl.clear();\n    p.exc_ed=excl;\n    p.inc_ed=incl;\n    p.spanning=current_span;\n    partitions.push_back(p);\n    \n\tif(!create_partitions(G)){\n    \texibirVetor(caminho);\n    \tcout<<contCor<<endl;\n\t}\n    \n    return 0;\n}\n","path":"src/tropical.cpp"}],"hypothesis":"For each candidate spanning tree, building its adjacency once in contiguous CSR storage should improve neighbor-scan locality and avoid repeatedly rescanning all tree edges. A shared DFS path, visited state, and compressed per-color counts should also remove per-recursion path copies and repeated color recounts without changing traversal order or endpoint selection.","notes":"One source-only traversal experiment. CSR neighbor order follows the original spanning-edge order; colors are compressed by observed vertex values so memory use stays bounded by the number of vertices rather than K. No commands were run and no performance or correctness claim is made; the controller should evaluate it.","sources_kept":[],"transformations":["Build a contiguous CSR adjacency representation once per generated spanning tree, preserving the original per-vertex edge iteration order.","Replace repeated edge-list scans and recursive history copies with backtracking over shared path and visited buffers.","Precompute compact vertex color IDs and maintain path-local color frequencies, updating the number of distinct colors incrementally."]}
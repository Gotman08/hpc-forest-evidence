      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n#define IB 8       // i-block size for cache blocking\n\n/*\n * Compute the gravitational impact among all pairs of bodies in \n * the system.\n * Uses structure-of-arrays layout and blocks over the outer (i) loop,\n * reusing each j-body's coordinates across IB accumulators. The inner\n * summation order per body remains strictly increasing in j, preserving\n * bit-exact results compared to the reference implementation.\n */\nvoid body_force(float *px, float *py, float *pz,\n                float *vx, float *vy, float *vz,\n                int n, float dt) {\n  #pragma omp parallel for schedule(static)\n  for (int ib = 0; ib < n; ib += IB) {\n    int iend = ib + IB;\n    if (iend > n) iend = n;\n\n    // Accumulators for the current block of bodies.\n    float fx[IB], fy[IB], fz[IB];\n    const int cnt = iend - ib;\n    for (int k = 0; k < cnt; ++k) {\n      fx[k] = 0.0f;\n      fy[k] = 0.0f;\n      fz[k] = 0.0f;\n    }\n\n    // Sweep over all j bodies once per block.\n    for (int j = 0; j < n; ++j) {\n      const float pjx = px[j];\n      const float pjy = py[j];\n      const float pjz = pz[j];\n\n      // Accumulate forces for all bodies in this block.\n      int k = 0;\n      for (int i = ib; i < iend; ++i, ++k) {\n        const float dx = pjx - px[i];\n        const float dy = pjy - py[i];\n        const float dz = pjz - pz[i];\n        const float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        const float inv_dist = 1.0f / sqrt(sqrd_dist);\n        const float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx[k] += dx * inv_dist3;\n        fy[k] += dy * inv_dist3;\n        fz[k] += dz * inv_dist3;\n      }\n    }\n\n    // Update velocities for this block.\n    int k = 0;\n    for (int i = ib; i < iend; ++i, ++k) {\n      vx[i] += dt*fx[k];\n      vy[i] += dt*fy[k];\n      vz[i] += dt*fz[k];\n    }\n  }\n}\n\n/*\n * Read a binary dataset with initialized bodies.\n */\nint read_dataset(float **px, float **py, float **pz,\n                 float **vx, float **vy, float **vz) {\n  int nbodies;\n  if (fread(&nbodies, sizeof(nbodies), 1, stdin) != 1) {\n    fprintf(stderr, \"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  // Temporary AoS buffer for input parsing.\n  typedef struct { float x, y, z, vx, vy, vz; } Body;\n  Body *in = (Body *)malloc(nbodies * sizeof(Body));\n  if (!in) {\n    fprintf(stderr, \"\\nMemory allocation failed\\n\");\n    exit(EXIT_FAILURE);\n  }\n  if (fread(in, nbodies * sizeof(Body), 1, stdin) != 1) {\n    fprintf(stderr, \"\\nError reading input values\\n\");\n    free(in);\n    exit(EXIT_FAILURE);\n  }\n\n  // Allocate SoA arrays.\n  *px = (float *)malloc(nbodies * sizeof(float));\n  *py = (float *)malloc(nbodies * sizeof(float));\n  *pz = (float *)malloc(nbodies * sizeof(float));\n  *vx = (float *)malloc(nbodies * sizeof(float));\n  *vy = (float *)malloc(nbodies * sizeof(float));\n  *vz = (float *)malloc(nbodies * sizeof(float));\n  if (!*px || !*py || !*pz || !*vx || !*vy || !*vz) {\n    fprintf(stderr, \"\\nMemory allocation failed\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  // Deinterleave.\n  for (int i = 0; i < nbodies; ++i) {\n    (*px)[i] = in[i].x;\n    (*py)[i] = in[i].y;\n    (*pz)[i] = in[i].z;\n    (*vx)[i] = in[i].vx;\n    (*vy)[i] = in[i].vy;\n    (*vz)[i] = in[i].vz;\n  }\n\n  free(in);\n  return nbodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(int n, const float *px, const float *py, const float *pz,\n                   const float *vx, const float *vy, const float *vz) {\n  typedef struct { float x, y, z, vx, vy, vz; } Body;\n  Body *out = (Body *)malloc(n * sizeof(Body));\n  if (!out) {\n    fprintf(stderr, \"\\nMemory allocation failed\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  for (int i = 0; i < n; ++i) {\n    out[i].x = px[i];\n    out[i].y = py[i];\n    out[i].z = pz[i];\n    out[i].vx = vx[i];\n    out[i].vy = vy[i];\n    out[i].vz = vz[i];\n  }\n\n  if (fwrite(out, n * sizeof(Body), 1, stdout) != 1) {\n    fprintf(stderr, \"\\nError writing to output\\n\");\n    free(out);\n    exit(EXIT_FAILURE);\n  }\n  free(out);\n}\n\nint main(int argc, char **argv) {\n  float *px, *py, *pz, *vx, *vy, *vz;\n  int nbodies = read_dataset(&px, &py, &pz, &vx, &vy, &vz);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    body_force(px, py, pz, vx, vy, vz, nbodies, DT);\n\n    #pragma omp parallel for schedule(static)\n    for (int i = 0; i < nbodies; ++i) {\n      px[i] += vx[i] * DT;\n      py[i] += vy[i] * DT;\n      pz[i] += vz[i] * DT;\n    }\n  }\n\n  write_dataset(nbodies, px, py, pz, vx, vy, vz);\n\n  free(px); free(py); free(pz);\n  free(vx); free(vy); free(vz);\n\n  return EXIT_SUCCESS;\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "SoA layout plus i-blocking (IB=8) and OpenMP static scheduling over blocks reduces memory traffic by reusing each j-body's coordinates across multiple i accumulators while preserving per-i summation order, improving cache locality beyond plain SoA+OpenMP.",
  "notes": "The implementation converts the body data to structure-of-arrays, then processes the outer loop in tiles of IB=8 bodies. For each tile it sweeps all j sequentially, accumulating forces for all i in the tile simultaneously; this preserves the exact per-body summation order (j increasing) and therefore bit-exact output. OpenMP static scheduling over tiles provides parallel speedup on 4 cores.",

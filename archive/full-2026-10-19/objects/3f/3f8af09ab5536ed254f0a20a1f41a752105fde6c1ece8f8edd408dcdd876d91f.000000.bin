-if __name__ == "__main__":
-    raise SystemExit(main())
+"""Fresh dynamic independent forests; the operator prepares execution only.
+
+This entry point deliberately does not inherit the fixed A/B/C/G mother runner.
+All model calls use the selected identity; R chooses its own branch objectives.
+"""
+from __future__ import annotations
+
+import argparse
+import importlib.metadata
+import json
+import os
+import re
+import shutil
+import socket
+import time
+import traceback
+from pathlib import Path
+
+import evidence_pack
+import romeo_base as base
+
+from hpc_forest.codex_mailbox import TOKEN_CEILING
+from hpc_forest.config import load_config, validate
+from hpc_forest.core import InfrastructureError, atomic_json, file_digest
+from hpc_forest.native_matrix import EFFORTS, MODELS, SCOPE, install_identity, validate_identity
+from hpc_forest.target_profile import allocation_facts, prepare_target_profile
+
+VARIANT = "dynamic-independent-roots-r4b-max"
+CAPABILITIES = ["cpu", "c", "cxx", "openmp"]
+LIMITS = {"child_slots": 8, "integration_slots": 2, "max_roots": 8,
+          "wall_seconds": 1800, "tokens": 1500000, "generation_seconds": 600,
+          "confirmation_seconds": 120, "harness_attempts": 3}
+
+
+def read_json(path):
+    return json.loads(Path(path).read_text(encoding="utf-8"))
+
+
+def checked_file(root, name, expected):
+    """No absolute path, traversal, symlink or missing fingerprint is accepted."""
+    relative = Path(name)
+    if relative.is_absolute() or ".." in relative.parts or not relative.parts:
+        raise InfrastructureError("Unsafe frozen artifact path")
+    path = root / relative
+    if (not path.resolve(strict=True).is_relative_to(root.resolve(strict=True))
+            or any(p.is_symlink() for p in [path, *path.parents] if p != root.parent)
+            or not re.fullmatch(r"[0-9a-f]{64}", expected)
+            or file_digest(path) != expected):
+        raise InfrastructureError("A frozen artifact changed: " + name)
+    return path
+
+
+def checked_inputs(shared, subjects, model, effort):
+    validate_identity(model, effort)
+    plan = read_json(shared / "dynamic-plan.json")
+    if (plan.get("scope_id") != SCOPE or plan.get("models") != list(MODELS)
+            or plan.get("efforts") != list(EFFORTS) or plan.get("limits") != LIMITS
+            or plan.get("operator_algorithm_advice") is not False
+            or plan.get("cross_branch_advice") is not False):
+        raise InfrastructureError("The frozen dynamic protocol differs from this runner")
+    if (not subjects or len(subjects) > 8 or len(set(subjects)) != len(subjects)
+            or not set(subjects) <= set(plan["subjects"])):
+        raise InfrastructureError("At most eight explicit, distinct admitted subjects per mailbox")
+    manifest = read_json(shared / "prepared/prepared-manifest.json")
+    for name, expected in manifest["files"].items():
+        checked_file(shared / "prepared", name, expected)
+    for name, expected in read_json(shared / "runtime-manifest.json").items():
+        checked_file(shared / "project", name, expected)
+    for subject in subjects:
+        record = manifest["records"].get(subject, {})
+        if record.get("status") != "ready":
+            raise InfrastructureError("An excluded reference cannot be called a model failure")
+        for field in ["source", "validation"]:
+            path = Path(record["prepared"][field]).resolve(strict=True)
+            if not path.is_relative_to((shared / "prepared").resolve(strict=True)):
+                raise InfrastructureError("The prepared source/oracle leaves this delivery")
+        checked_file(shared, plan["statements"][subject]["path"],
+                     plan["statements"][subject]["sha256"])
+    return plan, manifest
+
+
+def settings_for(subject, prepared, profile, channel, session, model, effort, target):
+    """Only mechanical contracts and budgets; no algorithm menu or branch labels."""
+    validate_identity(model, effort)
+    if set(profile["verified_capabilities"]) != set(CAPABILITIES):
+        raise InfrastructureError("The target capabilities do not match this protocol")
+    config = load_config()
+    config.update(problem=subject, backend="codex", method="H", seed=23, roles=[],
+                  target_id=target, target_profile=profile,
+                  dynamic_mother={"enabled": True, "max_roots": LIMITS["max_roots"],
+                                  "child_slots": LIMITS["child_slots"],
+                                  "integration_slots": LIMITS["integration_slots"],
+                                  "verified_capabilities": CAPABILITIES[:],
+                                  "advice_enabled": True, "max_sources": 4})
+    config.pop("ollama", None)
+    config["codex"] = {"model": model, "reasoning_effort": effort,
+                       "transport": "codex-mailbox", "mailbox_dir": str(channel),
+                       "session_id": session}
+    # Baseline + children + harvest programs + initial mother + advice + source selection.
+    slots = 1 + LIMITS["child_slots"] + LIMITS["integration_slots"] + 1
+    slots += LIMITS["child_slots"] + LIMITS["integration_slots"]
+    config["budget"].update(search_slots=slots, confirmation_slots=3, max_workers=1,
+                            max_depth=6, infrastructure_retries=0,
+                            mission_tokens=LIMITS["harness_attempts"] * TOKEN_CEILING,
+                            **{k: LIMITS[k] for k in ["wall_seconds", "tokens",
+                                                     "generation_seconds", "confirmation_seconds"]})
+    # DynamicController.plan owns scheduling. These generic fields are not an A/B/C/G plan.
+    config["schedule"] = {"cycles": 1, "trials_per_role_per_cycle": 1,
+                          "integrations_per_cycle": 1}
+    config["harness"] = {"enabled": True, "max_attempts": LIMITS["harness_attempts"],
+                         "call_token_ceiling": TOKEN_CEILING,
+                         "research": {"enabled": True, "corpus": None,
+                                      "corpus_sha256": None,
+                                      "allowed_hosts": ["gcc.gnu.org", "www.openmp.org",
+                                                        "raw.githubusercontent.com"]}}
+    config["protocol"].update(
+        build=["{python}", "{trusted}/contract_tool.py", "build", "{worktree}", "{build}"],
+        check=["{python}", "{trusted}/contract_tool.py", "check", "{binary}", "{phase}"],
+        benchmark=["/bin/sh", "{trusted}/benchmark.sh", "{binary}"],
+        repetitions=3, confirmation_repetitions=5, warmups=1,
+        private_execution_audit=True, private_execution_purpose="dynamic-native-search",
+        timeout_seconds=prepared["protocol_timeout_seconds"], build_timeout_seconds=120,
+        environment={"OMP_NUM_THREADS": "4", "OMP_DYNAMIC": "FALSE",
+                     "OMP_PROC_BIND": "TRUE", "CUDA_VISIBLE_DEVICES": ""})
+    validate(config)
+    return config
+
+
+def export_observations(controller):
+    """Passive exports after each settled mission; never supplied to a model."""
+    records = []
+    for row in controller.db.rows("SELECT id,role,mission,result FROM trials ORDER BY created,id"):
+        record = {"id": row["id"], "role": row["role"],
+                  "mission": json.loads(row["mission"]),
+                  "outcome": json.loads(row["result"]) if row["result"] else None}
+        journal = controller.root / "logs" / row["id"] / "node-harness.json"
+        if journal.is_file():
+            record["harness"] = read_json(journal)
+        records.append(record)
+    atomic_json(controller.root.parent / (controller.root.name + "-observations-detaillees.json"),
+                {"scope": "passive_dynamic_post_batch_observation", "never_model_input": True,
+                 "subject": controller.root.name, "trials": records, "costs": controller.db.costs()})
+
+
+def wait_for_deliveries(channel, timeout=60):
+    """Bounded drain, without replaying expired requests or stopping any process.
+
+    The ready marker is uploaded after the invocation log and response. A missing
+    marker leaves invocation status unknown: the worker's local records must then
+    be reconciled separately. No assumption about an unclaimed call is made here.
+    """
+    deadline = time.monotonic() + timeout
+    while True:
+        requests = list((channel / "requests").glob("*.request.json"))
+        pending = [p.name.removesuffix(".request.json") for p in requests
+                   if not (channel / "responses" / p.name.replace(".request.json", ".ready.json")).is_file()]
+        if not pending or time.monotonic() >= deadline:
+            return {"unanswered_requests": pending, "complete_at_seal": not pending,
+                    "timeout_seconds": timeout, "calls_replayed": 0}
+        time.sleep(.25)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--authorization", type=Path, required=True)
+    parser.add_argument("--root", type=Path, required=True)
+    parser.add_argument("--shared", type=Path, required=True)
+    parser.add_argument("--model", required=True)
+    parser.add_argument("--effort", required=True)
+    parser.add_argument("--session-id", required=True)
+    parser.add_argument("--subjects", nargs="+", required=True)
+    args = parser.parse_args()
+    allocation = allocation_facts()
+    if not hasattr(os, "sched_getaffinity") or len(os.sched_getaffinity(0)) != 4:
+        raise InfrastructureError("Exactly four allocated CPU affinity entries are required")
+    install_identity(args.model, args.effort, args.authorization)
+    from hpc_forest.native_matrix import validate_receipt
+    authorization = validate_receipt(args.authorization, {SCOPE})
+    if (authorization["purpose"] not in {"pilot", "extension"} or str(args.root) != authorization["remote_root"]
+            or args.session_id != authorization["session_id"]
+            or allocation["slurm_job_id"] != authorization["job_id"]):
+        raise InfrastructureError("R4b pilot arguments differ from the real cell admission")
+    # These imports bind the identity after the explicit per-process selection.
+    from romeo_harness_comparison import verify_worker
+
+    from hpc_forest.codex_mailbox import initialize_channel
+    from hpc_forest.controller import create_workspace
+    from hpc_forest.dynamic_controller import DynamicController
+    from hpc_forest.reporting import package, report
+
+    if importlib.metadata.version("treequest") != "0.3.2":
+        raise InfrastructureError("The real pinned TreeQuest 0.3.2 is required")
+    shared = args.shared.resolve(strict=True)
+    plan, prepared = checked_inputs(shared, args.subjects, args.model, args.effort)
+    if args.subjects != [plan["pilot_configuration"]["subject"]]:
+        raise InfrastructureError("Only the one explicit pilot subject is currently admitted")
+    root = args.root.resolve()
+    root.mkdir(parents=True, exist_ok=False)
+    job = allocation["slurm_job_id"]
+    output = root / ("results-" + job)
+    output.mkdir()
+    result = {"schema": "hpc-forest-dynamic-archive-results-v1", "variant": VARIANT,
+              "scope_id": SCOPE, "job_id": job, "model": args.model,
+              "reasoning_effort": args.effort, "admitted_subjects": args.subjects,
+              "limits": LIMITS, "replicates": 1, "operator_algorithm_advice": False,
+              "cross_branch_advice": False, "old_candidates_imported": False,
+              "verification_scope": "finite official observable outputs on the declared adapted CPU target",
+              "official_contest_compliance_certified": False,
+              "global_optimum_proven": False, "problems": [], "pipeline_complete": False}
+    atomic_json(output / "CELL-BINDING.json", authorization)
+    shutil.copyfile(args.authorization, output / "authorization-original.json")
+    channel = output / "mailbox"
+    try:
+        for name in ["dynamic-plan.json", "runtime-manifest.json", "preflight-junit.xml", "allocated-contract-tests.xml"]:
+            shutil.copyfile(shared / name, output / name)
+        shutil.copyfile(shared / "prepared/prepared-manifest.json", output / "prepared-manifest.json")
+        profile = prepare_target_profile()
+        atomic_json(output / "target-profile.json", profile)
+        initialize_channel(channel, args.session_id, job)
+        atomic_json(output / "channel.json", {"channel": str(channel), "session_id": args.session_id,
+                    "job_id": job, "model": args.model, "reasoning_effort": args.effort})
+        base.emit("dynamic_mailbox_ready", channel=str(channel), session_id=args.session_id)
+        worker = verify_worker(channel, args.session_id, 600)
+        atomic_json(output / "model-identity.json", worker)
+        for subject in args.subjects:
+            checked_inputs(shared, args.subjects, args.model, args.effort)
+            started = time.monotonic()
+            record = prepared["records"][subject]
+            campaign = output / subject
+            entry = {"subject": subject, "pipeline_complete": False}
+            try:
+                target = f"romeo:{socket.gethostname()}:slurm-{job}:dynamic-cpu4"
+                settings = settings_for(subject, record["prepared"], profile, channel,
+                                        args.session_id, args.model, args.effort, target)
+                statement_path = shared / plan["statements"][subject]["path"]
+                statement = statement_path.read_text(encoding="utf-8")
+                create_workspace(campaign, settings, Path(record["prepared"]["source"]),
+                                 Path(record["prepared"]["validation"]))
+                shutil.copyfile(statement_path, campaign / "official-statement.txt")
+                with DynamicController(campaign, statement) as controller:
+                    with controller.db.connection:
+                        controller.db.connection.execute("DELETE FROM documents")
+                    controller.db.event("dynamic_protocol_identity", {
+                        "scope_id": SCOPE, "model": args.model, "effort": args.effort,
+                        "statement_sha256": file_digest(statement_path),
+                        "prepared_manifest_sha256": file_digest(shared / "prepared/prepared-manifest.json"),
+                        "target_profile_digest": profile["profile_digest"],
+                        "operator_algorithm_advice": False})
+                    while True:
+                        entry["search"] = controller.run(max_batches=1)
+                        export_observations(controller)
+                        # This is a private evidence index, never an admission. A receiver
+                        # must reconcile the first NORMAL delivery and actual evaluation.
+                        evaluations = controller.db.rows("SELECT experiment_id,phase,payload FROM evaluations ORDER BY rowid")
+                        first = next((dict(row) for row in evaluations
+                                      if row["phase"] == "search" and not row["experiment_id"].startswith("baseline-")), None)
+                        if first is not None and not (output / "first-normal-evaluation-private-index.json").exists():
+                            atomic_json(output / "first-normal-evaluation-private-index.json", {
+                                "schema": "hpc-forest-dynamic-r4b-first-normal-private-index-v1",
+                                "verified": False, "never_model_input": True,
+                                "scope_id": SCOPE, "job_id": job, "session_id": args.session_id,
+                                "model": args.model, "effort": args.effort,
+                                "evaluation": first, "first_normal_native_delivery_verified": False,
+                                "independent_receiving_audit_required": True,
+                                "extension_admitted": False})
+                        topology = base.tree_snapshot(controller)
+                        atomic_json(output / (subject + "-progress.json"), topology)
+                        base.emit("dynamic_progress", subject=subject, model=args.model,
+                                  effort=args.effort, **{k: topology[k] for k in
+                                  ["trials", "scored_nodes", "max_depth", "max_children", "tokens_used"]})
+                        if entry["search"]["status"] != "checkpointed":
+                            break
+                    entry["best_confirmed"] = controller.confirm()
+                    export_observations(controller)
+                    entry["costs"] = controller.db.costs()
+                    entry["topology"] = base.tree_snapshot(controller)
+                    atomic_json(output / (subject + "-progress.json"), entry["topology"])
+                report(campaign)
+                package(campaign, campaign / "submission.zip")
+                entry["package_sha256"] = file_digest(campaign / "submission.zip")
+                entry["pipeline_complete"] = True
+            except Exception as exc:
+                entry["error"] = type(exc).__name__ + ": " + str(exc)
+                entry["traceback"] = traceback.format_exc()
+            entry["elapsed_seconds"] = time.monotonic() - started
+            result["problems"].append(entry)
+            atomic_json(output / (subject + "-summary.json"), entry)
+            atomic_json(output / "results.json", result)
+            base.emit("dynamic_subject_end", subject=subject,
+                      complete=entry["pipeline_complete"], error=entry.get("error"))
+            if entry.get("error"):
+                break
+        result["pipeline_complete"] = (len(result["problems"]) == len(args.subjects)
+                                       and all(p["pipeline_complete"] for p in result["problems"]))
+    except Exception as exc:
+        result["error"] = type(exc).__name__ + ": " + str(exc)
+        result["traceback"] = traceback.format_exc()
+    finally:
+        if channel.exists():
+            atomic_json(output / "mailbox-drain.json", wait_for_deliveries(channel))
+        atomic_json(output / "results.json", result)
+        archive = root / ("results-" + job + ".tar.gz")
+        evidence_pack.make(output, shared / "sources-officielles", archive)
+        base.emit("runner_end", complete=result["pipeline_complete"],
+                  archive=str(archive), sha256=file_digest(archive))
+    return 0 if result["pipeline_complete"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

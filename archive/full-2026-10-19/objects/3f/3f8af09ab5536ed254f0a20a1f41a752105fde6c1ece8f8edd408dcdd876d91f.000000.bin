+"""Entry point that selects an explicitly authorized native model once."""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from .core import InfrastructureError, atomic_json
+from .native_matrix import install_identity
+
+
+def main():
+    parser = argparse.ArgumentParser(add_help=False)
+    parser.add_argument("--dependency-receipt", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--channel", required=True)
+    parser.add_argument("--session-id", required=True)
+    parser.add_argument("--executable", required=True)
+    args, _ = parser.parse_known_args()
+    identity = json.loads(args.dependency_receipt.read_text(encoding="utf8"))
+    install_identity(identity["model"], identity["effort"], args.dependency_receipt)
+    from .codex_worker import validate_remote_channel
+    validate_remote_channel(args.channel)
+    if args.session_id != identity["session_id"]:
+        raise InfrastructureError("Worker session differs from the exact admission")
+    from .dynamic_admission import verify_local_cli
+    cli = verify_local_cli(identity, args.executable)
+    args.output.mkdir(parents=True, exist_ok=False)
+    atomic_json(args.output / "CLI-IDENTITY-VERIFIED.json", cli)
+    atomic_json(args.output / "CELL-BINDING.json", identity)
+    from .codex_worker import main as run
+    return run()
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

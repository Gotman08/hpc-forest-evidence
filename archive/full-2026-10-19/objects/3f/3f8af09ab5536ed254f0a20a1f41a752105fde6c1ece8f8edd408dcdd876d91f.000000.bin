+"""Explicit per-process model identity for the isolated archive experiment.
+
+Legacy transports retain their source and defaults. This adapter selects one
+authorized identity before a dedicated process performs any generation.
+"""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from .core import InfrastructureError, file_digest
+
+MODELS = ("gpt-6.1-sol", "gpt-6-luna", "gpt-6-astra", "gpt-5.6-terra")
+EFFORTS = ("max",)
+SCOPE = "hpc-forest-dynamic-independent-roots-r4b-max"
+
+
+def validate_identity(model, effort):
+    if model not in MODELS or effort not in EFFORTS:
+        raise InfrastructureError("Model or effort is outside the human-authorized matrix")
+
+
+def validate_receipt(path: Path, required_jobs: set[str], *, initial=True) -> dict:
+    from .dynamic_admission import validate_authorization
+    return validate_authorization(path, required_jobs, initial=initial)
+
+
+def install_identity(model: str, effort: str, receipt: Path | None = None):
+    """One model/effort per owned worker and per cluster process, never global config."""
+    validate_identity(model, effort)
+    if receipt is None:
+        raise InfrastructureError("R4b generation remains closed without its real admission")
+    from . import codex_mailbox, codex_process, codex_worker
+
+    for module in (codex_mailbox, codex_process, codex_worker):
+        module.MODEL, module.EFFORT = model, effort
+    if receipt is not None:
+        authorization = validate_receipt(receipt, {SCOPE})
+        if (authorization["model"], authorization["effort"]) != (model, effort):
+            raise InfrastructureError("Worker identity differs from its authorization")
+
+        admission_sha = file_digest(receipt)
+        request_started = False
+
+        def gate(path, required_jobs):
+            if file_digest(path) != admission_sha:
+                raise InfrastructureError("The immutable cell authorization changed")
+            fresh = validate_receipt(path, required_jobs, initial=False)
+            if (fresh["model"], fresh["effort"]) != (model, effort):
+                raise InfrastructureError("Generation identity changed inside the worker")
+            return fresh
+
+        codex_process.check_dependencies = gate
+        codex_worker.check_dependencies = gate
+        from .dynamic_admission import guard_request
+        original_publish = getattr(codex_mailbox.publish_request, "_r4b_original", codex_mailbox.publish_request)
+
+        def request_authorization(request):
+            nonlocal request_started
+            fresh = gate(receipt, {SCOPE})
+            if not request_started:
+                fresh = validate_receipt(receipt, {SCOPE}, initial=True)
+            guard_request(fresh, request)
+            return fresh
+
+        def publish(channel, request):
+            nonlocal request_started
+            fresh = request_authorization(request)
+            guard_request(fresh, request)
+            expected = {fresh[k] + "/results-" + fresh["job_id"] + "/mailbox"
+                        for k in ("remote_root", "canonical_remote_root")}
+            if str(channel) not in expected:
+                raise InfrastructureError("R4b request channel differs from its cell")
+            result = original_publish(channel, request)
+            request_started = True
+            return result
+
+        publish._r4b_original = original_publish
+        codex_mailbox.publish_request = publish
+
+        def channel_gate(channel):
+            fresh = gate(receipt, {SCOPE})
+            expected = {fresh[k] + "/results-" + fresh["job_id"] + "/mailbox"
+                        for k in ("remote_root", "canonical_remote_root")}
+            if channel not in expected:
+                raise InfrastructureError("R4b worker channel differs from its exact admitted cell")
+
+        codex_worker.validate_remote_channel = channel_gate
+        original_validate = getattr(codex_worker.validate_request, "_r4b_original", codex_worker.validate_request)
+
+        def request_gate(request, session_id, nonce):
+            nonlocal request_started
+            original_validate(request, session_id, nonce)
+            request_authorization(request)
+            request_started = True
+
+        request_gate._r4b_original = original_validate
+        codex_worker.validate_request = request_gate
+
+
+def verified_catalog(path: Path) -> dict:
+    """Read only model metadata; no authentication material is returned."""
+    catalog = json.loads(path.read_text(encoding="utf8"))
+    result = {}
+    for model in catalog.get("models", []):
+        slug = model.get("slug")
+        if slug not in MODELS:
+            continue
+        supported = {level["effort"] for level in model.get("supported_reasoning_levels", [])}
+        if not set(EFFORTS) <= supported:
+            raise InfrastructureError("Missing requested reasoning effort for " + slug)
+        result[slug] = {"supported_reasoning_efforts": sorted(supported),
+                        "context_window_as_catalogued": model.get("context_window")}
+    if set(result) != set(MODELS):
+        raise InfrastructureError("At least one exact requested model is absent")
+    return {"fetched_at": catalog.get("fetched_at"), "models": result,
+            "scope": "catalogue capability; not proof of a completed generation"}
+

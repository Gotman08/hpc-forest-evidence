      "content": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <memory>\n#include <utility>\n#include <vector>\n\n#ifdef _OPENMP\n#include <atomic>\n#include <omp.h>\n#endif\n\nstatic const int MOD = 1000000007;\n\nstatic inline int update_run(int* dp, int first, int last, int left) {\n    for (int col = first; col < last; ++col) {\n        int value = dp[col] + left;\n        if (value >= MOD) value -= MOD;\n        dp[col] = value;\n        left = value;\n    }\n    return left;\n}\n\nstatic inline int update_row(int* dp, int first_col, int last_col,\n                             int left, int row,\n                             const std::vector<int>& offsets,\n                             const std::vector<int>& blocked) {\n    int col = first_col;\n    const int first = offsets[row];\n    const int last = offsets[row + 1];\n    if (first != last) {\n        const auto finish = blocked.begin() + last;\n        auto it = std::lower_bound(blocked.begin() + first, finish, first_col);\n        for (; it != finish && *it < last_col; ++it) {\n            const int obstacle = *it;\n            left = update_run(dp, col, obstacle, left);\n            dp[obstacle] = 0;\n            left = 0;\n            col = obstacle + 1;\n        }\n    }\n    return update_run(dp, col, last_col, left);\n}\n\nstatic inline void sort_row(int row, const std::vector<int>& offsets,\n                            std::vector<int>& blocked) {\n    if (offsets[row + 1] - offsets[row] > 1) {\n        std::sort(blocked.begin() + offsets[row],\n                  blocked.begin() + offsets[row + 1]);\n    }\n}\n\n#ifdef _OPENMP\nstruct alignas(128) Progress {\n    std::atomic<int> rows;\n    Progress() : rows(0) {}\n};\n#endif\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n, m;\n    if (!(std::cin >> n >> m)) return 0;\n\n    std::vector<int> offsets(static_cast<std::size_t>(n) + 1, 0);\n    std::vector<int> blocked(static_cast<std::size_t>(m));\n    {\n        std::vector<std::pair<int, int>> cells(static_cast<std::size_t>(m));\n        for (int k = 0; k < m; ++k) {\n            int row, col;\n            std::cin >> row >> col;\n            cells[k] = std::make_pair(row, col);\n            ++offsets[row + 1];\n        }\n        for (int row = 0; row < n; ++row) {\n            offsets[row + 1] += offsets[row];\n        }\n        std::vector<int> next(offsets);\n        for (int k = 0; k < m; ++k) {\n            blocked[next[cells[k].first]++] = cells[k].second;\n        }\n    }\n\n    int requested_threads = 1;\n#ifdef _OPENMP\n    if (n >= 1024) {\n        requested_threads = std::min(4, std::min(omp_get_max_threads(), n / 512));\n    }\n#endif\n\n    // Align both column partitions and boundary segments to 128 bytes.\n    const int column_chunks = (n + 31) / 32;\n    const int stride = column_chunks * 32;\n    const std::size_t words = static_cast<std::size_t>(stride) * requested_threads;\n    std::vector<int> storage(words + 32, 0);\n    void* aligned = storage.data();\n    std::size_t available = storage.size() * sizeof(int);\n    int* const dp = static_cast<int*>(\n        std::align(128, words * sizeof(int), aligned, available));\n    dp[0] = 1;\n\n    if (requested_threads == 1) {\n        for (int row = 0; row < n; ++row) {\n            sort_row(row, offsets, blocked);\n            update_row(dp, 0, n, 0, row, offsets, blocked);\n        }\n    }\n#ifdef _OPENMP\n    else {\n        Progress progress[4];\n        const int batch_rows = 32;\n\n        #pragma omp parallel num_threads(requested_threads)\n        {\n            #pragma omp for schedule(static)\n            for (int row = 0; row < n; ++row) {\n                sort_row(row, offsets, blocked);\n            }\n\n            const int tid = omp_get_thread_num();\n            const int workers = omp_get_num_threads();\n            const int first_col = std::min(n, (column_chunks * tid / workers) * 32);\n            const int last_col = std::min(n, (column_chunks * (tid + 1) / workers) * 32);\n            const int* const incoming = tid == 0 ? nullptr\n                : dp + static_cast<std::size_t>(stride) * tid;\n            int* const outgoing = tid + 1 == workers ? nullptr\n                : dp + static_cast<std::size_t>(stride) * (tid + 1);\n\n            for (int first_row = 0; first_row < n; first_row += batch_rows) {\n                const int last_row = std::min(n, first_row + batch_rows);\n                if (tid != 0) {\n                    while (progress[tid - 1].rows.load(std::memory_order_acquire)\n                           < last_row) {\n                    }\n                }\n\n                for (int row = first_row; row < last_row; ++row) {\n                    const int left = incoming == nullptr ? 0 : incoming[row];\n                    const int right = update_row(dp, first_col, last_col, left,\n                                                 row, offsets, blocked);\n                    if (outgoing != nullptr) outgoing[row] = right;\n                }\n\n                // Published boundary entries are never subsequently overwritten.\n                if (outgoing != nullptr) {\n                    progress[tid].rows.store(last_row, std::memory_order_release);\n                }\n            }\n        }\n    }\n#endif\n\n    std::cout << dp[n - 1] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

        "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nnamespace {\nconst std::uint32_t MOD = 1000000007u;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic inline uint32x4_t add_mod(uint32x4_t a, uint32x4_t b,\n                               uint32x4_t modulus) {\n    const uint32x4_t sum = vaddq_u32(a, b);\n    return vminq_u32(sum, vsubq_u32(sum, modulus));\n}\n#endif\n\nstatic inline void scan_unblocked(std::uint32_t* values, int length) {\n    int j = 0;\n    std::uint32_t carry = 0;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const uint32x4_t zero = vdupq_n_u32(0);\n    const uint32x4_t modulus = vdupq_n_u32(MOD);\n    uint32x4_t vector_carry = zero;\n\n    for (; j + 4 <= length; j += 4) {\n        uint32x4_t x = vld1q_u32(values + j);\n        x = add_mod(x, vextq_u32(zero, x, 3), modulus);\n        x = add_mod(x, vextq_u32(zero, x, 2), modulus);\n        x = add_mod(x, vector_carry, modulus);\n        vst1q_u32(values + j, x);\n        vector_carry = vdupq_laneq_u32(x, 3);\n    }\n    carry = vgetq_lane_u32(vector_carry, 0);\n#endif\n\n    for (; j < length; ++j) {\n        carry += values[j];\n        if (carry >= MOD) {\n            carry -= MOD;\n        }\n        values[j] = carry;\n    }\n}\n\nstatic inline void scan_row(std::uint32_t* dp, int n,\n                            const std::vector<int>& columns) {\n    int first = 0;\n    for (int column : columns) {\n        scan_unblocked(dp + first, column - first);\n        dp[column] = 0;\n        first = column + 1;\n    }\n    scan_unblocked(dp + first, n - first);\n}\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic inline uint32x4_t wavefront_step(std::uint32_t* dp, int n, int time,\n                                       uint32x4_t state,\n                                       uint32x4_t modulus) {\n    const std::uint32_t upper = time < n ? dp[time] : 0;\n    uint32x4_t above = vextq_u32(state, state, 3);\n    above = vsetq_lane_u32(upper, above, 0);\n    return add_mod(state, above, modulus);\n}\n\nstatic inline void advance_unblocked(std::uint32_t* dp, int n,\n                                     int& time, int end,\n                                     uint32x4_t& state,\n                                     uint32x4_t modulus) {\n    for (; time < end && time < 3; ++time) {\n        state = wavefront_step(dp, n, time, state, modulus);\n    }\n\n    for (; time + 4 <= end && time + 4 <= n; time += 4) {\n        const uint32x4_t upper = vld1q_u32(dp + time);\n        uint32x4_t above = vextq_u32(state, state, 3);\n        above = vcopyq_laneq_u32(above, 0, upper, 0);\n        const uint32x4_t s0 = add_mod(state, above, modulus);\n\n        above = vextq_u32(s0, s0, 3);\n        above = vcopyq_laneq_u32(above, 0, upper, 1);\n        const uint32x4_t s1 = add_mod(s0, above, modulus);\n\n        above = vextq_u32(s1, s1, 3);\n        above = vcopyq_laneq_u32(above, 0, upper, 2);\n        const uint32x4_t s2 = add_mod(s1, above, modulus);\n\n        above = vextq_u32(s2, s2, 3);\n        above = vcopyq_laneq_u32(above, 0, upper, 3);\n        const uint32x4_t s3 = add_mod(s2, above, modulus);\n\n        const uint32x4_t pair01 = vzip2q_u32(s0, s1);\n        const uint32x4_t pair23 = vzip2q_u32(s2, s3);\n        const uint32x4_t output = vreinterpretq_u32_u64(vzip2q_u64(\n            vreinterpretq_u64_u32(pair01),\n            vreinterpretq_u64_u32(pair23)));\n        vst1q_u32(dp + time - 3, output);\n        state = s3;\n    }\n\n    for (; time < end; ++time) {\n        state = wavefront_step(dp, n, time, state, modulus);\n        if (time >= 3) {\n            dp[time - 3] = vgetq_lane_u32(state, 3);\n        }\n    }\n}\n\nstatic void scan_four_rows(std::uint32_t* dp, int n,\n                           const std::vector<int>* columns) {\n    const uint32x4_t modulus = vdupq_n_u32(MOD);\n    uint32x4_t state = vdupq_n_u32(0);\n    std::size_t p0 = 0, p1 = 0, p2 = 0, p3 = 0;\n    const int limit = n + 3;\n    int time = 0;\n\n    // At time t, lane k represents cell (row + k, t - k).\n    while (time < limit) {\n        const int e0 = p0 < columns[0].size() ? columns[0][p0] : limit;\n        const int e1 = p1 < columns[1].size() ? columns[1][p1] + 1 : limit;\n        const int e2 = p2 < columns[2].size() ? columns[2][p2] + 2 : limit;\n        const int e3 = p3 < columns[3].size() ? columns[3][p3] + 3 : limit;\n        const int next = std::min(std::min(e0, e1), std::min(e2, e3));\n\n        advance_unblocked(dp, n, time, next, state, modulus);\n        if (next == limit) {\n            break;\n        }\n\n        uint32x4_t keep = vdupq_n_u32(~std::uint32_t(0));\n        if (e0 == next) {\n            keep = vsetq_lane_u32(0, keep, 0);\n            ++p0;\n        }\n        if (e1 == next) {\n            keep = vsetq_lane_u32(0, keep, 1);\n            ++p1;\n        }\n        if (e2 == next) {\n            keep = vsetq_lane_u32(0, keep, 2);\n            ++p2;\n        }\n        if (e3 == next) {\n            keep = vsetq_lane_u32(0, keep, 3);\n            ++p3;\n        }\n\n        state = vandq_u32(wavefront_step(dp, n, time, state, modulus), keep);\n        if (time >= 3) {\n            dp[time - 3] = vgetq_lane_u32(state, 3);\n        }\n        ++time;\n    }\n}\n#endif\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n, m;\n    if (!(std::cin >> n >> m)) {\n        return 0;\n    }\n\n    std::vector<std::vector<int> > blocked_columns(n);\n    for (int c = 0; c < m; ++c) {\n        int row, column;\n        std::cin >> row >> column;\n        blocked_columns[row].push_back(column);\n    }\n    for (std::vector<int>& columns : blocked_columns) {\n        std::sort(columns.begin(), columns.end());\n        columns.erase(std::unique(columns.begin(), columns.end()), columns.end());\n    }\n\n    std::vector<std::uint32_t> dp(n, 0);\n    dp[0] = 1;\n    int row = 0;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    if (n >= 64) {\n        for (; row + 4 <= n; row += 4) {\n            const std::size_t obstacles = blocked_columns[row].size()\n                + blocked_columns[row + 1].size()\n                + blocked_columns[row + 2].size()\n                + blocked_columns[row + 3].size();\n            if (obstacles <= static_cast<std::size_t>(n) / 4) {\n                scan_four_rows(dp.data(), n, blocked_columns.data() + row);\n            } else {\n                for (int offset = 0; offset < 4; ++offset) {\n                    scan_row(dp.data(), n, blocked_columns[row + offset]);\n                }\n            }\n        }\n    }\n#endif\n\n    for (; row < n; ++row) {\n        scan_row(dp.data(), n, blocked_columns[row]);\n    }\n\n    std::cout << dp[n - 1] << '\\n';\n    return 0;\n}\n",

{
  "src/solution.cpp": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<uint64_t> blocked;\n    blocked.reserve(static_cast<size_t>(m));\n    for (int c = 0; c < m; ++c) {\n        int row, col;\n        cin >> row >> col;\n        blocked.push_back((static_cast<uint64_t>(row) << 32) |\n                          static_cast<uint64_t>(col));\n    }\n    sort(blocked.begin(), blocked.end());\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\n\n    vector<int> dp(n, 0);\n    dp[0] = 1;\n    size_t next = 0;\n\n    for (int row = 0; row < n; ++row) {\n        int left = 0;\n        int begin = 0;\n        for (;;) {\n            int end = n;\n            if (next < blocked.size() &&\n                (blocked[next] >> 32) == static_cast<uint64_t>(row)) {\n                end = static_cast<int>(static_cast<uint32_t>(blocked[next]));\n                ++next;\n            }\n\n            // Within a clear span, dp[col] is above and left is already updated.\n            for (int col = begin; col < end; ++col) {\n                int value = dp[col] + left;\n                if (value >= MOD) value -= MOD;\n                dp[col] = value;\n                left = value;\n            }\n\n            if (end == n) break;\n            dp[end] = 0;\n            left = 0;\n            begin = end + 1;\n        }\n    }\n\n    cout << dp[n - 1] << endl;\n    return 0;\n}\n"
}

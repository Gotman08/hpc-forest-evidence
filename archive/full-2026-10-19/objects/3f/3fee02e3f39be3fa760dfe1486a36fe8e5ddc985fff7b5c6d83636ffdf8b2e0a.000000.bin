/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": true, \"cases\": 4}}]}, \"selected_base_commit\": \"8c63351f0769cdeab1d21d4066801c394a7214d3\", \"recent_own_role\": [{\"experiment_id\": \"fdef4b50cdea4c75\", \"role\": \"G\", \"hypothesis\": \"Work-based integration of NEON insertion, compact-key introselection, and parallel radix selection should reduce selection overhead while preserving exact distance and voting ties.\", \"outcome\": {\"binary_sha256\": \"9827122c0808205ea8cad8684061cf4d2ab56b1bb5382565ef0aee3df1b01ea5\", \"cache_key\": \"218037b755b39d1d056b76690009bd3cb68b2930a3ef3e71a6ccd22a0c20d336\", \"commit\": \"0ca5c534474b5fc4d9b3ec142fa4f484b7054445\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/knn/logs/e1/fdef4b50cdea4c75/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/knn/logs/e1/fdef4b50cdea4c75/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/knn/logs/e1/fdef4b50cdea4c75/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/knn/logs/e1/fdef4b50cdea4c75/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/knn/logs/e1/fdef4b50cdea4c75/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/knn/logs/e1/fdef4b50cdea4c75/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.022760898806154728, \"reason\": \"\", \"score\": 0.9888481866574865, \"status\": \"valid\", \"times\": [0.022646683268249035, 0.022571995854377747, 0.023064017295837402], \"tree_hash\": \"05d397d0152e309633ea4fd0d5e0a809dcc20481\"}, \"raw_logs\": [{\"path\": \"logs/e1/fdef4b50cdea4c75/search/attempt-001/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": true, \"cases\": 4}}]}, {\"experiment_id\": \"b862640b9a4d4cf3\", \"role\": \"G\", \"hypothesis\": \"Buffered parsing combined with exact parallel radix selection should remove both scanf overhead and large-k insertion costs, while NEON-assisted insertion preserves the small-k and NaN fallback paths.\", \"outcome\": {\"binary_sha256\": \"42b8ee7231d33eb6508e973abb6f66c07c1303766d3529f113fcbdc358db0a85\", \"cache_key\": \"1ae71d62c4b31c80b71e31db4d24fc488d4885b5a416cb2640d1c9c2b6e29f40\", \"commit\": \"8c63351f0769cdeab1d21d4066801c394a7214d3\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/knn/logs/e1/b862640b9a4d4cf3/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/knn/logs/e1/b862640b9a4d4cf3/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/knn/logs/e1/b862640b9a4d4cf3/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/knn/logs/e1/b862640b9a4d4cf3/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/knn/logs/e1/b862640b9a4d4cf3/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-reference96-20261016-r2/results-748383/knn/logs/e1/b862640b9a4d4cf3/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.017078774360318977, \"reason\": \"\", \"score\": 0.9916088102906159, \"status\": \"valid\", \"times\": [0.017044012434780598, 0.01716906577348709, 0.017023244872689247], \"tree_hash\": \"1aaeb5cb33d67edb34afce7fa807c3b9cf43723a\"}, \"raw_logs\": [{\"path\": \"logs/e1/b862640b9a4d4cf3/search/attempt-001/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": true, \"cases\": 4}}]}, {\"experiment_id\": \"1cfe99bb2cad48c9\", \"role\": \"G\", \"hypothesis\": \"\", \"outcome\": {\"binary_sha256\": null, \"cache_key\": null, \"commit\": null, \"correct\": null, \"logs\": [], \"mean_seconds\": null, \"reason\": \"Local Codex worker did not finish before the mission deadline\", \"score\": null, \"status\": \"infrastructure_error\", \"times\": [], \"tree_hash\": null}, \"raw_logs\": []}], \"own_role_history\": [{\"experiment_id\": \"fdef4b50cdea4c75\", \"status\": \"valid\", \"score\": 0.9888481866574865, \"mean_seconds\": 0.022760898806154728, \"reason\": \"\"}, {\"experiment_id\": \"b862640b9a4d4cf3\", \"status\": \"valid\", \"score\": 0.9916088102906159, \"mean_seconds\": 0.017078774360318977, \"reason\": \"\"}, {\"experiment_id\": \"1cfe99bb2cad48c9\", \"status\": \"infrastructure_error\", \"score\": null, \"mean_seconds\": null, \"reason\": \"Local Codex worker did not finish before the mission deadline\"}]}, \"documents_as_data\": [{\"id\": \"e0c98b85d7acd1601471\", \"title\": \"Official problem statement\", \"url\": \"http://lspd.mackenzie.br/marathon/22/problemset.pdf\", \"version\": \"downloaded-2026-10-15\", \"preconditions\": \"Official source material. Operator supplies execution only.\", \"excerpt\": \"=== PAGE 1 ===\\n17th Marathon of Parallel Programming\\nSBAC-PAD & WSCAD – 2022\\nCalebe Bianchini1 and Maur´ıcio Aronne Pillon2\\n1Mackenzie Presbyterian University\\n2Santa Catarina State University\\nRules for Remote Contest\\nFor all problems, read carefully the input and output session. For all problems, a sequen-\\ntial implementation is given, and it is against the output of those implementations that the\\noutput of your programs will be compared to decide if your implementation is correct.\\nYou can modify the program in any way you see fit, except when the problem descrip-\\ntion states otherwise. You must upload a compressed file (zip) with your source code, the\\nMakefile and an execution script. The script must have the name of the problem. You\\ncan submit as many solutions to a problem as you want. Only the last submission will\\nbe considered. The Makefile must have the rule all, which will be used to compile your\\nsource code. The execution script runs your solution the way you design it – it will be\\ninspected not to corrupt the target machine.\\nThe execution time of your program will be measured running it with time program and\\ntaking the real CPU time given. Each program will be executed at least three times with\\nthe same input and the mean time will be taken into account. The sequential program\\ngiven will be measured the same way. You will earn points in each problem, correspond-\\ning to the division of the sequential time by the time of your program (speedup). The\\nteam with the most points at the end of the marathon will be declared the winner.\\nThis problem set contains 4 problems; pages are numbered from 1 to 5.\\n\\n=== PAGE 2 ===\\nGeneral Information\\nCompilation\\nYou should use CC or CXX inside your Makefile. Be careful when redefining them!\\nThere is a simple Makefile inside you pr\", \"retrieval_relevance\": 161, \"evidence_type\": \"documentation\"}, {\"id\": \"4a7633ba1e00acfb3d75\", \"title\": \"TreeQuest AB-MCTS ask tell persistence\", \"url\": \"https://github.com/SakanaAI/treequest\", \"version\": \"0.3.2\", \"preconditions\": \"Use the pinned TreeQuest version; local trusted checkpoints only.\", \"excerpt\": \"AB-MCTS-A selects new proposals and continuations. Scores are normalized to [0,1]. Persist each role's state per epoch. Integration receives one measured full-program reward in G only. Keep provenance separate from the selected search parent.\", \"retrieval_relevance\": 3, \"evidence_type\": \"documentation\"}], \"deadline\": 1792158815.0495367, \"generation_deadline\": 1792158695.0495367, \"protocol_id\": \"1349435ff1e73ee7bab1be4a8e83ef3d385270fcade9bb887c85b937e7ca9b97\", \"remaining_tokens\": 2905733, \"official_statement_as_data\": \"=== PAGE 1 ===\\n17th Marathon of Parallel Programming\\nSBAC-PAD & WSCAD – 2022\\nCalebe Bianchini1 and Maur´ıcio Aronne Pillon2\\n1Mackenzie Presbyterian University\\n2Santa Catarina State University\\nRules for Remote Contest\\nFor all problems, read carefully the input and output session. For all problems, a sequen-\\ntial implementation is given, and it is against the output of those implementations that the\\noutput of your programs will be compared to decide if your implementation is correct.\\nYou can modify the program in any way you see fit, except when the problem descrip-\\ntion states otherwise. You must upload a compressed file (zip) with your source code, the\\nMakefile and an execution script. The script must have the name of the problem. You\\ncan submit as many solutions to a problem as you want. Only the last submission will\\nbe considered. The Makefile must have the rule all, which will be used to compile your\\nsource code. The execution script runs your solution the way you design it – it will be\\ninspected not to corrupt the target machine.\\nThe execution time of your program will be measured running it with time program and\\ntaking the real CPU time given. Each program will be executed at least three times with\\nthe same input and the mean time will be taken into account. The sequential program\\ngiven will be measured the same way. You will earn points in each problem, correspond-\\ning to the division of the sequential time by the time of your program (speedup). The\\nteam with the most points at the end of the marathon will be declared the winner.\\nThis problem set contains 4 problems; pages are numbered from 1 to 5.\\n\\n=== PAGE 2 ===\\nGeneral Information\\nCompilation\\nYou should use CC or CXX inside your Makefile. Be careful when redefining them!\\nThere is a simple Makefile inside you problem package that you can modify. Example:\\nFLAGS=-O3\\nEXEC=sum\\nCXX=icpc\\nall: $(EXEC)\\n$(EXEC):\\n$(CXX) $(FLAGS) $(EXEC).cpp -c -o $(EXEC).o\\n$(CXX) $(FLAGS) $(EXEC).o -o $(EXEC)\\nEach judge machine has its group of compilers. See them below and choose well when\\nwriting your Makefile. The compiler that is tagged as default is predefined in CC and\\nCXX variables.\\nmachine compiler command\\nhost\\nGCC 12.2.0\\n(default)\\nC = gcc\\nC++ = g++\\nIntel C/C++ Compiler 19.1.3.304 C = icc\\nC++ = icpc\\nMPI\\nIntel MPI Compiler 2019u12\\n(default)\\nC = mpiicc\\nC++ = mpiicpc\\nIntel C/C++ Compiler 19.1.3.304 C = icc\\nC++ = icpc\\nGCC 12.2.0 C = gcc\\nC++ = g++\\ngpu\\nNVidia CUDA 11.6\\n(default)\\nC = nvcc\\nC++ = nvcc\\nGCC 8.3.1 C = gcc\\nC++ = g++\\nSubmitting\\nGeneral information\\nYou must have an execution script that has the same name of the problem. This script runs\\nyour solution the way you design it. There is a simple script inside you problem package\\nthat should be modified. Example:\\n#!/bin/bash\\n# This script runs a generic Problem A\\n# Using 32 threads and OpenMP\\nexport OMP_NUM_THREADS=32\\nOMP_NUM_THREADS=32 ./sum\\n\\n=== PAGE 3 ===\\nSubmitting MPI\\nIf you are planning to submit an MPI solution, you should compile usingmpiicc/mpiicpc.\\nThe script must call mpirun/mpiexec with the correct number of processes (max: 4). It\\nmust use a file called machines that are generated by the auto-judge system - do not\\ncreate it.\\n#!/bin/bash\\n# This script runs a generic Problem A\\n# Using MPI in the entire cluster (4 nodes)\\n# 'machines' file describes the nodes\\nmpirun -np 4 -machinefile machines ./sum\\nComparing times & results\\nIn your personal machine, measure the execution time of your solution using time pro-\\ngram. Add input/output redirection when collecting time. Use diff program to compare\\nthe original and your solution results. Example:\\n$ time -p ./A < original_input.txt > my_output.txt\\nreal 4.94\\nuser 0.08\\nsys 1.56\\n$ diff my_output.txt original_output.txt\\nDo not measure time and do not add input/output redirection when submitting your so-\\nlution - the auto-judge system is prepared to collect your time and compare the results.\\n\\n=== PAGE 4 ===\\nProblem A\\nk-Nearest Neighbors Classifier\\nGiven a set of two-dimensional points S divided intro n groups, an integer k and a two-\\ndimensional point P to be classified, the k-Nearest Neighbors (KNN) algorithm can be\\nused to solve the classification problem of the point P , i.e., classifying the point P into\\none of the n existing groups based on some criteria.\\nThe KNN algorithm works by comparing the distances from each point s ∈ S to the\\npoint P , then selecting the k points with the smallest distance values and counting the\\nfrequency of each group in these k points, the point P is then classified to belong to the\\ngroup with the highest frequency among the k nearest points.\\nFigure 1. Simple example of the KNN classification.\\nThe Figure 1 illustrates an example of the KNN classification algorithm being applied.\\nThe points have been segregated between 4 different groups ( i.e., A, B, C and D) and\\na point P with no group is provided to be classified, the KNN algorithm then searches\\nfor the k points closest to the point P and, after that, the groups have their frequencies\\ncounted, with the highest frequency being chosen as the classification ofP , in the case of\\nthis example, the point P is classified to belong to the group C.\\nInput\\nAn input represents the classification of a single point. The first line contains the pattern\\n”n groups=n”, where n is the total number of groups in this input. Then, for each of then\\ngroups the following lines will be provided, the first line has the pattern ”label=c” where\\nc is a single character that represents the label ( i.e., identification) of the group, then the\\nsecond line follows the pattern ”length= L”, where L is the number of two-dimensional\\npoints in this group and then, the next L lines contain the pattern ”(x,y)” that represents\\n1\\n\\n=== PAGE 5 ===\\neach point that belongs to the aforementioned group. After all groups have been repre-\\nsented there’s a single line with the pattern ”k= k”, where k is the parameter previously\\ndiscussed. Lastly, the final line also contains the pattern ”(x,y)”, representing the coordi-\\nnates to the two-dimensional point to be classified.\\nThe input must be read form the standard input.\\nOutput\\nThe output contains a single character, it being the label of the group chosen as the clas-\\nsification of the provided point.\\nThe output must be written to the standard output.\\nExample\\nInput example Output example\\nn groups=4 C\\nlabel=A\\nlength=3\\n(-3.55,-1.28)\\n(-3.99,-2.06)\\n(-3.23,-0.70)\\nlabel=B\\nlength=5\\n(-4.85,-1.65)\\n(-5.23,-2.22)\\n(-4.75,-3.89)\\n(-6.48,-2.41)\\n(-4.56,-2.29)\\nlabel=C\\nlength=4\\n(2.25,0.64)\\n(0.80,0.85)\\n(3.13,1.37)\\n(3.71,0.59)\\nlabel=D\\nlength=3\\n(-5.73,-2.65)\\n(-5.11,-4.41)\\n(-5.92,-3.06)\\nk=5\\n(-0.65,0.25)\\n2\\n\\n=== PAGE 6 ===\\nProblem B\\nSubmatrix of Maximum Sum\\nGiven a matrix M (with dimensions NxN) and an integer S, the objective is to find\\nthe SxS submatrix of M with maximum sum. A trivial algorithm to solve this problem\\nconsists in generating all (N − S + 1)2 such submatrices and, then, computing their sum\\n(the total time complexity would be, in the worst case, O((N − S)2S2 = O(N 2S2) )\\nThe proposed baseline algorithm (solution.cpp) employs a sliding window technique to\\nreduce this complexity to O(SN 2).\\nInput\\nThe input has only one test case. The first line contains two integers N and S (0 < S <\\nN < 8000). Then, there are N rows representing the matrix M. Each row contains N\\nintegers (with a whitespace after each one).\\nThe input must be read from the standard input.\\nOutput\\nThe output contains a single line. Print the sum of the SxS submatrix of M with maxi-\\nmum sum. It is guaranteed the result will fit a 32-bit signed integer.\\nThe output must be written to the standard output.\\nExample\\nInput Example Output example\\n5 3 51\\n3 6 7 5 3\\n5 6 2 9 1\\n2 7 0 9 3\\n6 0 6 2 6\\n1 8 7 9 2\\n3\\n\\n=== PAGE 7 ===\\nProblem C\\nN-body\\nAn n-body simulation models a dynamic system of particles, usually under the influence\\nof physical forces, predicting their individual motions. A well known application of n-\\nbody simulation is in astrophysics, where particles refer to celestial objects interacting\\nwith each other gravitationally. The provided serial code contains a simple, yet working,\\nn-body simulator for bodies moving through a 3 dimensional space. Your job is to create\\na parallel version of this n-body simulator, retaining the correctness of the solution.\\nInput\\nThe input consists of a binary file containing a structure with six float typed data items\\nfor each particle in the system. These six data items refer to the position of the particle in\\nthe x, y, and z axes, and the velocity of the particle in the x, y, and z axes.\\nThe input must be read form the standard input.\\nOutput\\nThe ouput is also a binary file, with the same format of the input file, containing the\\npositions and velocities of each particle in the x, y, and z axes.\\nThe output must be written to the standard output.\\nExample – in string form, just for readability purposes\\nInput example Output example\\n0.680375 -0.211234 0.566198\\n0.596880 0.823295 -0.604897\\n-0.329554 0.536459 -0.444451\\n0.107940 -0.045206 0.257742\\n-0.270431 0.026802 0.904459\\n0.832390 0.271423 0.434594\\n...\\n-5.184253 11.632033\\n-11.737427 -63.642937\\n146.243469 -147.690735\\n10.654608 -15.666613\\n15.572982 133.827255\\n-195.720352 194.728912\\n22.627201 -1.267884 -5.422720\\n283.039612 -15.879736\\n-67.786301\\n4\\n\\n=== PAGE 8 ===\\nProblem D\\nBucketsort\\nBucket sort or Binsort is a sorting algorithm. Its sorting strategy is to divide the numbers\\ninto ’buckets’ with a finite number of elements. The bucket’s advantage is its complexity\\n(O(n)), where ’n’ is the size of the array. However, linear complexity is only achieved\\nwhen the number is evenly distributed.\\nInput\\nAn input has 2 parts: the parameters and the data. The first four numbers are string length,\\narray size, offset, and bucket number. The remaining parameters are integer numbers to\\norder.\\nThe input must be read form the standard input.\\nOutput\\nThe output contains only the sorted integers.\\nThe output must be written to the standard output.\\nExample\\nInput example Output example\\n5\\n100000\\n48\\n9\\n99997 99996 99995 99994 99993\\n99992 99991 99990 99989 99988\\n99987 99986 ...\\n00000 00001 00002 00003 00004\\n00005 00006 00007 00008 00009\\n00010 00011 ...\\n5\", \"runtime_as_data\": {\"cpu_cores\": 4, \"OMP_NUM_THREADS\": 4, \"architecture\": \"ARM64\", \"candidate_GPU\": false, \"comparison\": \"Exact output bytes against official reference\"}}, \"required_json_schema\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"hypothesis\": {\"type\": \"string\"}, \"transformations\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"sources_kept\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"enum\": [\"46d1fd55ec474ac8\", \"663cfc725de34c3b\", \"8de2794fb10e4ca9\"]}, \"uniqueItems\": true}, \"files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"path\": {\"type\": \"string\"}, \"content\": {\"type\": \"string\"}}, \"required\": [\"path\", \"content\"]}}, \"notes\": {\"type\": \"string\"}}, \"required\": [\"hypothesis\", \"transformations\", \"sources_kept\", \"files\", \"notes\"]}}\n\nCURRENT SOURCE AS DATA:\n\n--- BEGIN FILE src/knn.c ---\n#include \"knn.h\"\n#include <float.h>\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nstatic int first_insertion_position(const float *distances, int k, float d,\n                                    int ordered) {\n    int x = 0;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const float32x4_t candidate = vdupq_n_f32(d);\n    const float32x4_t empty = vdupq_n_f32(-1.0f);\n#endif\n\n    if (ordered && k >= 64) {\n        int lo = 0;\n        int hi = k / 4;\n        while (lo < hi) {\n            int mid = lo + (hi - lo) / 2;\n            float last = distances[mid * 4 + 3];\n            int matches = (d < last) | (last == -1.0f);\n            hi = matches ? mid : hi;\n            lo = matches ? lo : mid + 1;\n        }\n        x = lo * 4;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n        if (x <= k - 4) {\n            const float32x4_t stored = vld1q_f32(distances + x);\n            const uint32x4_t matches = vorrq_u32(\n                vcltq_f32(candidate, stored), vceqq_f32(stored, empty));\n            const uint32x4_t positions = {0u, 1u, 2u, 3u};\n            const uint32x4_t first = vbslq_u32(\n                matches, positions, vdupq_n_u32(4u));\n            return x + (int) vminvq_u32(first);\n        }\n#endif\n    }\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    for (; x <= k - 4; x += 4) {\n        const float32x4_t stored = vld1q_f32(distances + x);\n        const uint32x4_t matches = vorrq_u32(\n            vcltq_f32(candidate, stored), vceqq_f32(stored, empty));\n        if (vmaxvq_u32(matches) != 0) break;\n    }\n#endif\n\n    for (; x < k; x++) {\n        if (d < distances[x] || distances[x] == -1.0f) return x;\n    }\n    return k;\n}\n\nstatic char knn_vote(char *labels, int k) {\n    qsort(labels, k, sizeof(char), compare_for_sort);\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n    return most_frequent;\n}\n\nstatic char knn_serial(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *) malloc(sizeof(char) * (size_t) k);\n    float *distances = (float *) malloc(sizeof(float) * (size_t) k);\n    if (labels == NULL || distances == NULL) on_error();\n    int distances_ordered = 1;\n\n    for (int i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1.0f;\n    }\n\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            float farthest = distances[k - 1];\n            if (farthest != -1.0f && d >= farthest) continue;\n\n            int x = first_insertion_position(distances, k, d,\n                                             distances_ordered);\n            if (x < k) {\n                size_t shifted = (size_t) (k - x - 1);\n                if (shifted != 0) {\n                    memmove(distances + x + 1, distances + x,\n                            shifted * sizeof(*distances));\n                    memmove(labels + x + 1, labels + x,\n                            shifted * sizeof(*labels));\n                }\n                distances[x] = d;\n                labels[x] = g.label;\n                if (d != d) distances_ordered = 0;\n            }\n        }\n    }\n\n    char result = knn_vote(labels, k);\n    free(distances);\n    free(labels);\n    return result;\n}\n\n#define KNN_RADIX_BINS 2048\n\ntypedef struct {\n    size_t bins[KNN_RADIX_BINS];\n    size_t votes[UCHAR_MAX + 1];\n    size_t take;\n    int bad;\n} KnnWorkspace;\n\nstatic unsigned int knn_pick_bucket(const KnnWorkspace *work, int threads,\n                                     unsigned int bins, size_t *rank) {\n    for (unsigned int b = 0; b < bins; b++) {\n        size_t count = 0;\n        for (int t = 0; t < threads; t++) count += work[t].bins[b];\n        if (*rank > count) {\n            *rank -= count;\n        } else {\n            return b;\n        }\n    }\n    return bins - 1;\n}\n\nstatic char knn_vote_counts(const size_t *counts) {\n    size_t best_count = 0;\n    char result = (char) -1;\n    for (int value = CHAR_MIN; value <= CHAR_MAX; value++) {\n        unsigned char index = (unsigned char) (char) value;\n        if (counts[index] > best_count) {\n            best_count = counts[index];\n            result = (char) value;\n        }\n    }\n    return result;\n}\n\nstatic char knn_radix(int n_groups, Group *groups, int k, Point to_evaluate) {\n    size_t total = 0;\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length > 0) {\n            size_t length = (size_t) groups[i].length;\n            if (length > SIZE_MAX - total)\n                return knn_serial(n_groups, groups, k, to_evaluate);\n            total += length;\n        }\n    }\n    if (total == 0) return (char) -1;\n    if (total > SIZE_MAX / sizeof(uint32_t))\n        return knn_serial(n_groups, groups, k, to_evaluate);\n\n    int threads = 1;\n#ifdef _OPENMP\n    int limit = omp_get_max_threads();\n    size_t useful = total / 32768u + (total % 32768u != 0);\n    if (limit > 1)\n        threads = useful < (size_t) limit ? (int) useful : limit;\n#endif\n\n    uint32_t *keys = (uint32_t *) malloc(total * sizeof(*keys));\n    unsigned char *labels = (unsigned char *) malloc(total);\n    KnnWorkspace *work = (KnnWorkspace *) malloc(\n        (size_t) threads * sizeof(*work));\n    if (keys == NULL || labels == NULL || work == NULL) {\n        free(work);\n        free(labels);\n        free(keys);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    const size_t selected = total < (size_t) k ? total : (size_t) k;\n    size_t rank = selected;\n    uint32_t prefix = 0;\n    uint32_t cutoff = 0;\n    int failed = 0;\n    char result = (char) -1;\n\n#ifdef _OPENMP\n#pragma omp parallel num_threads(threads) if(threads > 1)\n#endif\n    {\n        int thread = 0;\n        int team = 1;\n#ifdef _OPENMP\n        thread = omp_get_thread_num();\n        team = omp_get_num_threads();\n#endif\n        KnnWorkspace *local = work + thread;\n        memset(local, 0, sizeof(*local));\n        size_t base = total / (size_t) team;\n        size_t extra = total % (size_t) team;\n        size_t before = (size_t) thread < extra ? (size_t) thread : extra;\n        size_t begin = base * (size_t) thread + before;\n        size_t end = begin + base + ((size_t) thread < extra);\n        size_t skip = begin;\n        size_t remaining = end - begin;\n        size_t position = begin;\n\n        for (int i = 0; i < n_groups && remaining != 0; i++) {\n            Group g = groups[i];\n            size_t length = g.length > 0 ? (size_t) g.length : 0;\n            if (skip >= length) {\n                skip -= length;\n                continue;\n            }\n            size_t count = length - skip;\n            if (count > remaining) count = remaining;\n            for (size_t j = skip; j < skip + count; j++) {\n                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n                uint32_t key;\n                memcpy(&key, &d, sizeof(key));\n                if (d != d) {\n                    local->bad = 1;\n                    key = 0;\n                } else if (d == 0.0f) {\n                    key = 0;\n                }\n                keys[position] = key;\n                labels[position] = (unsigned char) g.label;\n                local->bins[key >> 21]++;\n                position++;\n            }\n            remaining -= count;\n            skip = 0;\n        }\n\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n        {\n            for (int t = 0; t < team; t++) {\n                if (work[t].bad) failed = 1;\n            }\n            if (!failed)\n                prefix = (uint32_t) knn_pick_bucket(\n                    work, team, KNN_RADIX_BINS, &rank) << 21;\n        }\n\n        if (!failed) {\n            memset(local->bins, 0, sizeof(local->bins));\n            for (size_t p = begin; p < end; p++) {\n                uint32_t key = keys[p];\n                if ((key >> 21) == (prefix >> 21))\n                    local->bins[(key >> 10) & 2047u]++;\n            }\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n            {\n                prefix |= (uint32_t) knn_pick_bucket(\n                    work, team, KNN_RADIX_BINS, &rank) << 10;\n            }\n\n            memset(local->bins, 0, sizeof(local->bins));\n            for (size_t p = begin; p < end; p++) {\n                uint32_t key = keys[p];\n                if ((key >> 10) == (prefix >> 10))\n                    local->bins[key & 1023u]++;\n            }\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n            {\n                unsigned int bucket = knn_pick_bucket(work, team, 1024u, &rank);\n                cutoff = prefix | (uint32_t) bucket;\n                size_t needed = rank;\n                for (int t = 0; t < team; t++) {\n                    size_t available = work[t].bins[bucket];\n                    work[t].take = available < needed ? available : needed;\n                    needed -= work[t].take;\n                }\n            }\n\n            size_t ties = local->take;\n            for (size_t p = begin; p < end; p++) {\n                uint32_t key = keys[p];\n                if (key < cutoff) {\n                    local->votes[labels[p]]++;\n                } else if (key == cutoff && ties != 0) {\n                    local->votes[labels[p]]++;\n                    ties--;\n                }\n            }\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n            {\n                size_t counts[UCHAR_MAX + 1] = {0};\n                for (int t = 0; t < team; t++) {\n                    for (unsigned int c = 0; c <= UCHAR_MAX; c++)\n                        counts[c] += work[t].votes[c];\n                }\n                counts[(unsigned char) ((char) -1)] += (size_t) k - selected;\n                result = knn_vote_counts(counts);\n            }\n        }\n    }\n\n    free(work);\n    free(labels);\n    free(keys);\n    if (failed) return knn_serial(n_groups, groups, k, to_evaluate);\n    return result;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) return (char) -1;\n    if (k <= 64 || sizeof(float) != sizeof(uint32_t) ||\n        FLT_RADIX != 2 || FLT_MANT_DIG != 24 || FLT_MAX_EXP != 128 ||\n        CHAR_BIT != 8)\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    return knn_radix(n_groups, groups, k, to_evaluate);\n}\n\nint main(void) {\n    int n_groups = parse_number_of_groups();\n    Group *groups = (Group *) malloc(sizeof(Group) * n_groups);\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n    return 0;\n}\n\n--- END FILE src/knn.c ---\n\n--- BEGIN FILE src/knn.h ---\n#ifndef KNN_H\n#define KNN_H\n\n#include <stdio.h>\n#include <stdlib.h>\n#include <ctype.h>\n#include <limits.h>\n#include <string.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point *points;\n} Group;\n\nvoid on_error(void) {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\n#define KNN_INPUT_CAPACITY 65536u\nstatic char knn_input_buffer[KNN_INPUT_CAPACITY + 1];\nstatic size_t knn_input_position;\nstatic size_t knn_input_count;\n\nstatic int knn_input_peek(void) {\n    if (knn_input_position == knn_input_count) {\n        knn_input_count = fread(knn_input_buffer, 1, KNN_INPUT_CAPACITY, stdin);\n        knn_input_position = 0;\n        knn_input_buffer[knn_input_count] = '\\0';\n        if (knn_input_count == 0) return EOF;\n    }\n    return (unsigned char) knn_input_buffer[knn_input_position];\n}\n\nstatic int knn_input_get(void) {\n    int c = knn_input_peek();\n    if (c != EOF) knn_input_position++;\n    return c;\n}\n\nstatic void knn_skip_space(void) {\n    int c;\n    while ((c = knn_input_peek()) != EOF && isspace((unsigned char) c))\n        knn_input_position++;\n}\n\nstatic void knn_expect(const char *literal) {\n    while (*literal != '\\0') {\n        if (knn_input_get() != (unsigned char) *literal) on_error();\n        literal++;\n    }\n}\n\nstatic int knn_parse_integer(void) {\n    knn_skip_space();\n    int c = knn_input_peek();\n    int negative = 0;\n    if (c == '-' || c == '+') {\n        negative = c == '-';\n        knn_input_position++;\n        c = knn_input_peek();\n    }\n    if (c < '0' || c > '9') on_error();\n    unsigned int limit = (unsigned int) INT_MAX + (unsigned int) negative;\n    unsigned int value = 0;\n    while (c >= '0' && c <= '9') {\n        unsigned int digit = (unsigned int) (c - '0');\n        if (value > (limit - digit) / 10u) on_error();\n        value = value * 10u + digit;\n        knn_input_position++;\n        c = knn_input_peek();\n    }\n    if (negative) {\n        if (value == (unsigned int) INT_MAX + 1u) return INT_MIN;\n        return -(int) value;\n    }\n    return (int) value;\n}\n\nstatic size_t knn_float_token_end(size_t position, size_t *depth) {\n    while (position < knn_input_count) {\n        unsigned char c = (unsigned char) knn_input_buffer[position];\n        if (isspace(c) || c == ',' || (c == ')' && *depth == 0)) break;\n        if (c == '(') {\n            (*depth)++;\n        } else if (c == ')') {\n            (*depth)--;\n        }\n        position++;\n    }\n    return position;\n}\n\nstatic void knn_append_token(char **token, size_t *length, size_t *capacity,\n                              const char *part, size_t amount) {\n    if (amount > (size_t) -1 - *length - 1) on_error();\n    size_t needed = *length + amount + 1;\n    if (needed > *capacity) {\n        size_t next = *capacity != 0 ? *capacity : 64;\n        while (next < needed) {\n            if (next > ((size_t) -1) / 2) {\n                next = needed;\n                break;\n            }\n            next *= 2;\n        }\n        char *resized = (char *) realloc(*token, next);\n        if (resized == NULL) on_error();\n        *token = resized;\n        *capacity = next;\n    }\n    memcpy(*token + *length, part, amount);\n    *length += amount;\n    (*token)[*length] = '\\0';\n}\n\nstatic float knn_parse_float(void) {\n    knn_skip_space();\n    if (knn_input_peek() == EOF) on_error();\n    size_t begin = knn_input_position;\n    size_t depth = 0;\n    size_t end = knn_float_token_end(begin, &depth);\n    char *finish;\n\n    if (end < knn_input_count) {\n        float value = strtof(knn_input_buffer + begin, &finish);\n        if (finish == knn_input_buffer + begin ||\n            finish != knn_input_buffer + end) on_error();\n        knn_input_position = end;\n        return value;\n    }\n\n    char *token = NULL;\n    size_t length = 0;\n    size_t capacity = 0;\n    for (;;) {\n        knn_append_token(&token, &length, &capacity,\n                         knn_input_buffer + begin, end - begin);\n        knn_input_position = end;\n        if (end < knn_input_count || knn_input_peek() == EOF) break;\n        begin = knn_input_position;\n        end = knn_float_token_end(begin, &depth);\n    }\n    float value = strtof(token, &finish);\n    if (finish == token || finish != token + length) on_error();\n    free(token);\n    return value;\n}\n\nint parse_number_of_groups(void) {\n    knn_skip_space();\n    knn_expect(\"n_groups=\");\n    int n = knn_parse_integer();\n    knn_skip_space();\n    return n;\n}\n\nPoint parse_point(void) {\n    knn_skip_space();\n    knn_expect(\"(\");\n    Point point;\n    point.x = knn_parse_float();\n    knn_skip_space();\n    knn_expect(\",\");\n    point.y = knn_parse_float();\n    knn_skip_space();\n    knn_expect(\")\");\n    knn_skip_space();\n    return point;\n}\n\nGroup parse_next_group(void) {\n    knn_skip_space();\n    knn_expect(\"label=\");\n    int label = knn_input_get();\n    if (label == EOF) on_error();\n    knn_skip_space();\n    knn_expect(\"length=\");\n    int length = knn_parse_integer();\n    knn_skip_space();\n\n    Group group;\n    group.label = (char) label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n    return group;\n}\n\nint parse_k(void) {\n    knn_skip_space();\n    knn_expect(\"k=\");\n    int k = knn_parse_integer();\n    knn_skip_space();\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt(Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n    return *(const char *) a - *(const char *) b;\n}\n\n#endif\n\n--- END FILE src/knn.h ---\n",

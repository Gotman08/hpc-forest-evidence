param(
    [Parameter(Mandatory=$true)][string]$ReviewSha256,
    [Parameter(Mandatory=$true)][string]$ObservationName
)
$ErrorActionPreference = 'Stop'
$TaskBase = 'C:\Users\nicol\Documents\Codex\2026-10-15\cr'
$Preparation = Join-Path $TaskBase 'outputs\HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r2'
$Operation = Join-Path $Preparation 'operations-parent-lane-close-20261018T0542'
$Revision = Join-Path $Preparation 'integration-factory-lecteur-r4-r2-so-clos\revision-r3-command-identity'
$ReviewPath = Join-Path $Revision 'revue-independante\REVUE-LECTEUR-R3.json'
$ReaderPath = Join-Path $Revision 'source_only_state.py'
$VerifierPath = Join-Path $Revision 'verifier-current.py'
$CapturePath = Join-Path $Preparation 'operations-parent-roots-20261018\capturer-cim-complet.ps1'
if ((Get-FileHash -LiteralPath $CapturePath -Algorithm SHA256).Hash.ToLowerInvariant() -ne '67c0c7a274a9d4175d93e8fe3d990f9f7e220707b39d6c18649e52ac38a1e483') { throw 'Capture helper pin differs' }
if ($ObservationName -notmatch '^current-[0-9]{8}T[0-9]{6}Z$') { throw 'A literal new observation name is required' }
if ((Get-FileHash -LiteralPath $ReviewPath -Algorithm SHA256).Hash.ToLowerInvariant() -ne $ReviewSha256) { throw 'Review pin differs' }
$Review = Get-Content -LiteralPath $ReviewPath -Raw | ConvertFrom-Json -DateKind String
$ReaderSha = (Get-FileHash -LiteralPath $ReaderPath -Algorithm SHA256).Hash.ToLowerInvariant()
$VerifierSha = (Get-FileHash -LiteralPath $VerifierPath -Algorithm SHA256).Hash.ToLowerInvariant()
if ($ReaderSha -ne 'd00b785664d67f968dd54101b3ec2f1903662855f47c1ae411f4a6a4467f10fc') { throw 'Reader pin differs' }
if ($VerifierSha -ne 'fdf7757d98e18e2205da1ef2835297b9bd23e46c9efad598cdb23931ef89d827') { throw 'Verifier pin differs' }
if ($Review.verified -ne $true -or $Review.blocking_findings.Count -ne 0 -or $Review.source_state_reader_sha256 -ne $ReaderSha) { throw 'No exact independent preparation review' }
$CurrentPath = Join-Path $Operation ($ObservationName + '.json')
$OutputDirectory = Join-Path $Revision $ObservationName
if ((Test-Path -LiteralPath $CurrentPath) -or (Test-Path -LiteralPath $OutputDirectory)) { throw 'Observation and proof destinations must be new' }
& $CapturePath -OutputPath $CurrentPath
if (-not $?) { throw 'Complete census capture failed' }
$CurrentSha = (Get-FileHash -LiteralPath $CurrentPath -Algorithm SHA256).Hash.ToLowerInvariant()
& (Join-Path $TaskBase 'work\.venv\Scripts\python.exe') -I -B $VerifierPath --current $CurrentPath --current-sha256 $CurrentSha --output-directory $OutputDirectory
if ($LASTEXITCODE -ne 0) { throw 'Current absence/release reader refused; preserve this result' }


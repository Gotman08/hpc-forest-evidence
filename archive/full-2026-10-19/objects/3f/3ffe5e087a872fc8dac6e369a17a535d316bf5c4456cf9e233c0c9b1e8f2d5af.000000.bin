      "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nusing u32 = std::uint32_t;\nusing u64 = std::uint64_t;\n\nstatic constexpr u32 MOD = 1000000007u;\n\nstatic inline u32 subtract_mod(u32 a, u32 b) {\n    return a >= b ? a - b : a + MOD - b;\n}\n\n// Operands are normalized residues. Sixteen products fit exactly in u64.\nstatic inline u32 dot_mod(const u32* a, const u32* b, int count) {\n    u64 total = 0;\n    while (count >= 16) {\n#if defined(__aarch64__) && defined(__ARM_NEON)\n        uint64x2_t low = vdupq_n_u64(0);\n        uint64x2_t high = vdupq_n_u64(0);\n        for (int i = 0; i < 16; i += 4) {\n            const uint32x4_t x = vld1q_u32(a + i);\n            const uint32x4_t y = vld1q_u32(b + i);\n            low = vmlal_u32(low, vget_low_u32(x), vget_low_u32(y));\n            high = vmlal_u32(high, vget_high_u32(x), vget_high_u32(y));\n        }\n        const u64 block = vaddvq_u64(vaddq_u64(low, high));\n#else\n        u64 block = 0;\n        for (int i = 0; i < 16; ++i) {\n            block += static_cast<u64>(a[i]) * b[i];\n        }\n#endif\n        total += block % MOD;\n        a += 16;\n        b += 16;\n        count -= 16;\n    }\n    // At most fifteen products plus the block residues remain: no overflow\n    // is possible for the supported polynomial lengths.\n    for (int i = 0; i < count; ++i) {\n        total += static_cast<u64>(a[i]) * b[i];\n    }\n    return static_cast<u32>(total % MOD);\n}\n\n// Coefficient k of a*b, with b supplied in reverse coefficient order.\nstatic inline u32 product_coefficient(const std::vector<u32>& a,\n                                      const std::vector<u32>& b_reversed,\n                                      int k) {\n    if (k < 0 || a.empty() || b_reversed.empty()) {\n        return 0;\n    }\n    const int b_size = static_cast<int>(b_reversed.size());\n    const int first = std::max(0, k - b_size + 1);\n    const int last = std::min(k, static_cast<int>(a.size()) - 1);\n    if (first > last) {\n        return 0;\n    }\n    return dot_mod(a.data() + first,\n                   b_reversed.data() + b_size - 1 - k + first,\n                   last - first + 1);\n}\n\n// Symmetry leaves only pairs i<j and, when present, one diagonal product.\nstatic inline u32 square_coefficient(const std::vector<u32>& a,\n                                     const std::vector<u32>& a_reversed,\n                                     int k) {\n    if (k < 0 || a.empty()) {\n        return 0;\n    }\n    const int size = static_cast<int>(a.size());\n    const int first = std::max(0, k - size + 1);\n    const int last = std::min(k, size - 1);\n    if (first > last) {\n        return 0;\n    }\n    const int pair_last = std::min(last, (k + 1) / 2 - 1);\n    u64 value = 0;\n    if (first <= pair_last) {\n        value = 2ULL * dot_mod(a.data() + first,\n                              a_reversed.data() + size - 1 - k + first,\n                              pair_last - first + 1);\n    }\n    if ((k & 1) == 0) {\n        const u32 middle = a[k / 2];\n        value += static_cast<u64>(middle) * middle;\n    }\n    return static_cast<u32>(value % MOD);\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n;\n    u64 h;\n    if (!(std::cin >> n >> h)) {\n        return 0;\n    }\n\n    std::vector<u32> numerator(n);\n    std::vector<u32> denominator(n + 1);\n    denominator[0] = 1;\n    for (int i = 0; i < n; ++i) {\n        u64 value;\n        std::cin >> value;\n        numerator[i] = static_cast<u32>(value % MOD);\n    }\n    for (int i = 0; i < n; ++i) {\n        u64 value;\n        std::cin >> value;\n        const u32 coefficient = static_cast<u32>(value % MOD);\n        denominator[i + 1] = coefficient == 0 ? 0 : MOD - coefficient;\n    }\n\n    if (h <= static_cast<u64>(n)) {\n        std::cout << numerator[static_cast<std::size_t>(h - 1)] << '\\n';\n        return 0;\n    }\n\n    // The generating function is S(z)/Q(z), where S=(A*Q) mod z^n.\n    std::vector<u32> next_numerator(n);\n    {\n        const std::vector<u32> reversed_denominator(denominator.rbegin(),\n                                                    denominator.rend());\n        for (int i = 0; i < n; ++i) {\n            next_numerator[i] = product_coefficient(numerator,\n                                                     reversed_denominator, i);\n        }\n    }\n    numerator.swap(next_numerator);\n\n    const int numerator_even_size = (n + 1) / 2;\n    const int numerator_odd_size = n / 2;\n    const int denominator_even_size = n / 2 + 1;\n    const int denominator_odd_size = (n + 1) / 2;\n    std::vector<u32> numerator_even(numerator_even_size);\n    std::vector<u32> numerator_odd(numerator_odd_size);\n    std::vector<u32> denominator_even(denominator_even_size);\n    std::vector<u32> denominator_odd(denominator_odd_size);\n    std::vector<u32> even_reversed(denominator_even_size);\n    std::vector<u32> odd_reversed(denominator_odd_size);\n    std::vector<u32> next_denominator(n + 1);\n\n    u64 index = h - 1;\n    while (index != 0) {\n        for (int i = 0; i < numerator_even_size; ++i) {\n            numerator_even[i] = numerator[2 * i];\n        }\n        for (int i = 0; i < numerator_odd_size; ++i) {\n            numerator_odd[i] = numerator[2 * i + 1];\n        }\n        for (int i = 0; i < denominator_even_size; ++i) {\n            const u32 value = denominator[2 * i];\n            denominator_even[i] = value;\n            even_reversed[denominator_even_size - 1 - i] = value;\n        }\n        for (int i = 0; i < denominator_odd_size; ++i) {\n            const u32 value = denominator[2 * i + 1];\n            denominator_odd[i] = value;\n            odd_reversed[denominator_odd_size - 1 - i] = value;\n        }\n\n        // Write Q(z)=E(z^2)+z*O(z^2), S(z)=C(z^2)+z*D(z^2).\n        // Retain only the required parity of S(z)*Q(-z).\n        if (index & 1ULL) {\n            for (int i = 0; i < n; ++i) {\n                next_numerator[i] = subtract_mod(\n                    product_coefficient(numerator_odd, even_reversed, i),\n                    product_coefficient(numerator_even, odd_reversed, i));\n            }\n        } else {\n            for (int i = 0; i < n; ++i) {\n                next_numerator[i] = subtract_mod(\n                    product_coefficient(numerator_even, even_reversed, i),\n                    product_coefficient(numerator_odd, odd_reversed, i - 1));\n            }\n        }\n\n        // The next denominator is E(z)^2-z*O(z)^2.\n        next_denominator[0] = 1;\n        for (int i = 1; i <= n; ++i) {\n            next_denominator[i] = subtract_mod(\n                square_coefficient(denominator_even, even_reversed, i),\n                square_coefficient(denominator_odd, odd_reversed, i - 1));\n        }\n\n        numerator.swap(next_numerator);\n        denominator.swap(next_denominator);\n        index >>= 1;\n    }\n\n    // Q(0) remains one throughout Bostan-Mori reduction.\n    std::cout << numerator[0] << '\\n';\n    return 0;\n}\n",

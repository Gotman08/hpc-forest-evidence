          "files": [
            "src/solution.cpp"
          ],
          "retained": [
            "Replace two DP rows and copying with one in-place row and a scalar left accumulator.",
            "Store obstacles in row-local column lists, sorting and deduplicating each row before processing its open intervals.",
            "Replace modular remainder with one conditional subtraction.",
            "Disable synchronized and tied input streams without changing the input/output contract."
          ]
        },

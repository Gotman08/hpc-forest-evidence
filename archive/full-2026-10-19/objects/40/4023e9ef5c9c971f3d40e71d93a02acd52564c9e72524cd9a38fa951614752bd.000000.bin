{
  "hypothesis": "Apply SIMD/vectorization to the distance calculation in the knn function for performance improvement and ensure loop dependencies are handled correctly.",
  "transformations": [
    "Apply AVX2 intrinsics for vectorized distance calculations",
    "Ensure loop dependencies are handled correctly"
  ],
  "sources_kept": [],
  "files": [
    {
      "path": "src/knn.c",
      "content": "#include \"knn.h\"\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j += 8) { // Process 8 points at a time\n            __m256 d_vec = _mm256_set1_ps(-1.0f);\n            int l;\n            for (l = 0; l < 8 && j + l < g.length; l++) {\n                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j + l]);\n                __m256 d_scalar = _mm256_set1_ps(d);\n                d_vec = _mm256_min_ps(d_vec, d_scalar);\n            }\n\n            // Store the minimum distance from the vector into a scalar\n            float distances_array[8];\n            _mm256_storeu_ps(distances_array, d_vec);\n            float min_distance = distances_array[0];\n            for (l = 1; l < 8 && j + l - 1 < g.length; l++) {\n                if (distances_array[l] < min_distance) {\n                    min_distance = distances_array[l];\n                }\n            }\n\n            // Insert the minimum distance into the sorted list of k nearest neighbors\n            for (int x = 0; x < k; x++) {\n                if (min_distance < distances[x] || distances[x] == -1) {\n                    for (int y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n\n                    distances[x] = min_distance;\n                    labels[x] = g.label;\n\n                    break;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}"
    },
    {
      "path": "src/knn.h",
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <immintrin.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt(Point a, Point b) {\n    __m256 ax = _mm256_set1_ps(a.x);\n    __m256 ay = _mm256_set1_ps(a.y);\n    __m256 bx = _mm256_set1_ps(b.x);\n    __m256 by = _mm256_set1_ps(b.y);\n\n    __m256 dx = _mm256_sub_ps(ax, bx);\n    __m256 dy = _mm256_sub_ps(ay, by);\n\n    __m256 dx_sq = _mm256_mul_ps(dx, dx);\n    __m256 dy_sq = _mm256_mul_ps(dy, dy);\n\n    __m256 sum = _mm256_add_ps(dx_sq, dy_sq);\n\n    float distances[8];\n    _mm256_storeu_ps(distances, sum);\n\n    return distances[0] + distances[1] + distances[2] + distances[3] + distances[4] + distances[5] + distances[6] + distances[7];\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}"
    }
  ],
  "notes": "This experiment applies AVX2 intrinsics to vectorize the distance calculations in the knn function. The loop over points is unrolled to process 8 points at a time, and the minimum distance is found using SIMD operations before being inserted into the list of k nearest neighbors."
}

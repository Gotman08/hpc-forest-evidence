{
  "src/nbody.c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\nenum { PAIR_TILE = 32, PARALLEL_THRESHOLD = 256 };\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\ntypedef struct { float x, y, z; } Force;\n\nstatic inline Force force_row(const Body *p, int i, int n) {\n  float fx = 0.0f;\n  float fy = 0.0f;\n  float fz = 0.0f;\n  const float x = p[i].x;\n  const float y = p[i].y;\n  const float z = p[i].z;\n\n  for (int j = 0; j < n; ++j) {\n    float dx = p[j].x - x;\n    float dy = p[j].y - y;\n    float dz = p[j].z - z;\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n    fx += dx * inv_dist3;\n    fy += dy * inv_dist3;\n    fz += dz * inv_dist3;\n  }\n\n  Force result = {fx, fy, fz};\n  return result;\n}\n\n/* Compute forces without integrating positions. */\nvoid body_force(Body *p, float dt, int n) {\n  #pragma omp parallel for schedule(static) if(n >= PARALLEL_THRESHOLD)\n  for (int i = 0; i < n; ++i) {\n    Force f = force_row(p, i, n);\n    p[i].vx += dt*f.x;\n    p[i].vy += dt*f.y;\n    p[i].vz += dt*f.z;\n  }\n}\n\nstatic void simulate_direct(Body *p, float dt, int n, int steps) {\n  #pragma omp parallel if(n >= PARALLEL_THRESHOLD)\n  {\n    for (int iter = 0; iter < steps; ++iter) {\n      #pragma omp for schedule(static)\n      for (int i = 0; i < n; ++i) {\n        Force f = force_row(p, i, n);\n        p[i].vx += dt*f.x;\n        p[i].vy += dt*f.y;\n        p[i].vz += dt*f.z;\n      }\n\n      #pragma omp for schedule(static)\n      for (int i = 0; i < n; ++i) {\n        p[i].x += p[i].vx * dt;\n        p[i].y += p[i].vy * dt;\n        p[i].z += p[i].vz * dt;\n      }\n    }\n  }\n}\n\nstatic void simulate(Body *p, float dt, int n, int steps) {\n  if (n <= 0 || steps <= 0) return;\n  if (n < PARALLEL_THRESHOLD) {\n    simulate_direct(p, dt, n, steps);\n    return;\n  }\n\n  const int ntiles = n / PAIR_TILE + (n % PAIR_TILE != 0);\n  Force *partial = (Force *)malloc((size_t)n * sizeof(*partial));\n  float *cache = (float *)malloc((size_t)ntiles * PAIR_TILE * PAIR_TILE * sizeof(*cache));\n  if (partial == NULL || cache == NULL) {\n    free(cache);\n    free(partial);\n    simulate_direct(p, dt, n, steps);\n    return;\n  }\n\n  int nonfinite = 0;\n  #pragma omp parallel\n  {\n    for (int iter = 0; iter < steps; ++iter) {\n      #pragma omp single\n      {\n        nonfinite = 0;\n      }\n\n      #pragma omp for schedule(static) reduction(|:nonfinite)\n      for (int i = 0; i < n; ++i) {\n        partial[i].x = 0.0f;\n        partial[i].y = 0.0f;\n        partial[i].z = 0.0f;\n        if (!isfinite(p[i].x) || !isfinite(p[i].y) || !isfinite(p[i].z)) {\n          nonfinite |= 1;\n        }\n      }\n\n      if (nonfinite) {\n        #pragma omp for schedule(static)\n        for (int i = 0; i < n; ++i) {\n          partial[i] = force_row(p, i, n);\n        }\n      } else {\n        /*\n         * Completed source bands form an ordered prefix for every row.\n         * Each off-diagonal tile has one owner. Its inverse distances\n         * are reused when completing the opposite rows after the barrier.\n         */\n        for (int band = 0; band < ntiles; ++band) {\n          const int begin = band * PAIR_TILE;\n          const int end = (n - begin < PAIR_TILE) ? n : begin + PAIR_TILE;\n\n          #pragma omp for schedule(static)\n          for (int tile = band + 1; tile < ntiles; ++tile) {\n            const int target_begin = tile * PAIR_TILE;\n            const int target_end = (n - target_begin < PAIR_TILE)\n                                 ? n : target_begin + PAIR_TILE;\n            float *tile_cache = cache + (size_t)tile * PAIR_TILE * PAIR_TILE;\n\n            for (int j = target_begin; j < target_end; ++j) {\n              const float x = p[j].x;\n              const float y = p[j].y;\n              const float z = p[j].z;\n              float fx = partial[j].x;\n              float fy = partial[j].y;\n              float fz = partial[j].z;\n\n              for (int i = begin; i < end; ++i) {\n                float dx = p[i].x - x;\n                float dy = p[i].y - y;\n                float dz = p[i].z - z;\n                float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n                float inv_dist = 1 / sqrt(sqrd_dist);\n                float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n                fx += dx * inv_dist3;\n                fy += dy * inv_dist3;\n                fz += dz * inv_dist3;\n                tile_cache[(size_t)(i - begin) * PAIR_TILE + (j - target_begin)] = inv_dist3;\n              }\n\n              partial[j].x = fx;\n              partial[j].y = fy;\n              partial[j].z = fz;\n            }\n          }\n\n          #pragma omp for schedule(static)\n          for (int i = begin; i < end; ++i) {\n            const float x = p[i].x;\n            const float y = p[i].y;\n            const float z = p[i].z;\n            float fx = partial[i].x;\n            float fy = partial[i].y;\n            float fz = partial[i].z;\n\n            for (int j = begin; j < end; ++j) {\n              float dx = p[j].x - x;\n              float dy = p[j].y - y;\n              float dz = p[j].z - z;\n              float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n              float inv_dist = 1 / sqrt(sqrd_dist);\n              float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n              fx += dx * inv_dist3;\n              fy += dy * inv_dist3;\n              fz += dz * inv_dist3;\n            }\n\n            /*\n             * Finite positions give identical squared distances in both\n             * directions. Cache only inv_dist3, not rounded products,\n             * retaining the original multiply/add expressions and order.\n             */\n            for (int tile = band + 1; tile < ntiles; ++tile) {\n              const int target_begin = tile * PAIR_TILE;\n              const int target_end = (n - target_begin < PAIR_TILE)\n                                   ? n : target_begin + PAIR_TILE;\n              const float *row_cache = cache + (size_t)tile * PAIR_TILE * PAIR_TILE\n                                     + (size_t)(i - begin) * PAIR_TILE;\n              for (int j = target_begin; j < target_end; ++j) {\n                float dx = p[j].x - x;\n                float dy = p[j].y - y;\n                float dz = p[j].z - z;\n                float inv_dist3 = row_cache[j - target_begin];\n\n                fx += dx * inv_dist3;\n                fy += dy * inv_dist3;\n                fz += dz * inv_dist3;\n              }\n            }\n\n            partial[i].x = fx;\n            partial[i].y = fy;\n            partial[i].z = fz;\n          }\n        }\n      }\n\n      #pragma omp for schedule(static)\n      for (int i = 0; i < n; ++i) {\n        p[i].vx += dt*partial[i].x;\n        p[i].vy += dt*partial[i].y;\n        p[i].vz += dt*partial[i].z;\n        p[i].x += p[i].vx * dt;\n        p[i].y += p[i].vy * dt;\n        p[i].z += p[i].vz * dt;\n      }\n    }\n  }\n\n  free(cache);\n  free(partial);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /* Compute interbody forces and integrate positions at each step. */\n  simulate(bodies, DT, nbodies, N_ITER);\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n"
}

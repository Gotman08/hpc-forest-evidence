        "content": "#include \"knn.h\"\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\ntypedef struct {\n    size_t order;\n    float distance;\n    char label;\n} KnnCandidate;\n\ntypedef struct {\n    KnnCandidate *heap;\n    size_t count;\n    int fallback;\n} KnnLocal;\n\nstatic int knn_distance_is_nan(float value) {\n    uint32_t bits;\n    memcpy(&bits, &value, sizeof(bits));\n    return (bits & UINT32_C(0x7fffffff)) > UINT32_C(0x7f800000);\n}\n\nstatic int knn_worse(KnnCandidate a, KnnCandidate b) {\n    return a.distance > b.distance ||\n           (a.distance == b.distance && a.order > b.order);\n}\n\nstatic void knn_heap_sift_down(KnnCandidate *heap, size_t count, size_t root) {\n    KnnCandidate value = heap[root];\n    while (root < count / 2) {\n        size_t child = root * 2 + 1;\n        if (child + 1 < count && knn_worse(heap[child + 1], heap[child])) {\n            ++child;\n        }\n        if (!knn_worse(heap[child], value)) {\n            break;\n        }\n        heap[root] = heap[child];\n        root = child;\n    }\n    heap[root] = value;\n}\n\nstatic void knn_heap_build(KnnCandidate *heap, size_t count) {\n    for (size_t i = count / 2; i > 0; --i) {\n        knn_heap_sift_down(heap, count, i - 1);\n    }\n}\n\nstatic void knn_heap_offer(KnnCandidate *heap, size_t *count,\n                           size_t capacity, KnnCandidate candidate) {\n    if (*count < capacity) {\n        heap[*count] = candidate;\n        ++(*count);\n        if (*count == capacity) {\n            knn_heap_build(heap, capacity);\n        }\n    } else if (knn_worse(heap[0], candidate)) {\n        heap[0] = candidate;\n        knn_heap_sift_down(heap, capacity, 0);\n    }\n}\n\nstatic char knn_vote(const size_t *counts) {\n    char best = (char)CHAR_MIN;\n    size_t best_count = 0;\n    for (int label = CHAR_MIN; label <= CHAR_MAX; ++label) {\n        size_t count = counts[(unsigned char)(char)label];\n        if (count > best_count) {\n            best = (char)label;\n            best_count = count;\n        }\n    }\n    return best;\n}\n\nstatic void knn_free_locals(KnnLocal *locals, int count) {\n    for (int i = 0; i < count; ++i) {\n        free(locals[i].heap);\n    }\n    free(locals);\n}\n\nstatic char knn_serial_reference(int n_groups, Group *groups,\n                                 int k, Point to_evaluate) {\n    char *labels = (char *)malloc(sizeof(char) * k);\n    float *distances = (float *)malloc(sizeof(float) * k);\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0 || n_groups < 0) {\n        return knn_serial_reference(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t *offsets = (size_t *)malloc(((size_t)n_groups + 1) * sizeof(*offsets));\n    if (offsets == NULL) {\n        return knn_serial_reference(n_groups, groups, k, to_evaluate);\n    }\n    offsets[0] = 0;\n    for (int i = 0; i < n_groups; ++i) {\n        if (groups[i].length < 0) {\n            free(offsets);\n            return knn_serial_reference(n_groups, groups, k, to_evaluate);\n        }\n        offsets[i + 1] = offsets[i] + (size_t)groups[i].length;\n    }\n\n    size_t total = offsets[n_groups];\n    if (total == 0) {\n        free(offsets);\n        return (char)-1;\n    }\n    size_t retained = total < (size_t)k ? total : (size_t)k;\n\n    int workers = 1;\n#ifdef _OPENMP\n    if (!omp_in_parallel()) {\n        workers = omp_get_max_threads();\n    }\n#endif\n    if (workers < 1) {\n        workers = 1;\n    }\n    size_t useful_workers = total / 4096;\n    if (useful_workers == 0) {\n        useful_workers = 1;\n    }\n    if ((size_t)workers > useful_workers) {\n        workers = (int)useful_workers;\n    }\n\n    KnnLocal *locals = (KnnLocal *)calloc((size_t)workers, sizeof(*locals));\n    if (locals == NULL) {\n        free(offsets);\n        return knn_serial_reference(n_groups, groups, k, to_evaluate);\n    }\n    size_t quotient = total / (size_t)workers;\n    size_t remainder = total % (size_t)workers;\n\n#ifdef _OPENMP\n#pragma omp parallel for schedule(static) num_threads(workers) if(workers > 1)\n#endif\n    for (int block = 0; block < workers; ++block) {\n        size_t rank = (size_t)block;\n        size_t begin = quotient * rank + (rank < remainder ? rank : remainder);\n        size_t end = begin + quotient + (rank < remainder ? 1 : 0);\n        size_t capacity = end - begin;\n        if (capacity > retained) {\n            capacity = retained;\n        }\n\n        KnnLocal local = {NULL, 0, 0};\n        local.heap = (KnnCandidate *)malloc(capacity * sizeof(*local.heap));\n        if (local.heap == NULL) {\n            local.fallback = 1;\n        } else {\n            int low = 0;\n            int high = n_groups;\n            while (low < high) {\n                int mid = low + (high - low) / 2;\n                if (offsets[mid + 1] <= begin) {\n                    low = mid + 1;\n                } else {\n                    high = mid;\n                }\n            }\n\n            int group_index = low;\n            size_t position = begin;\n            while (position < end && !local.fallback) {\n                const Group *group = &groups[group_index];\n                size_t group_end = offsets[group_index + 1];\n                if (group_end > end) {\n                    group_end = end;\n                }\n                for (; position < group_end; ++position) {\n                    size_t index = position - offsets[group_index];\n                    float d = euclidean_distance_no_sqrt(to_evaluate, group->points[index]);\n                    if (knn_distance_is_nan(d)) {\n                        local.fallback = 1;\n                        break;\n                    }\n                    KnnCandidate candidate = {position, d, group->label};\n                    knn_heap_offer(local.heap, &local.count, capacity, candidate);\n                }\n                ++group_index;\n            }\n        }\n        locals[block] = local;\n    }\n\n    free(offsets);\n    for (int block = 0; block < workers; ++block) {\n        if (locals[block].fallback) {\n            knn_free_locals(locals, workers);\n            return knn_serial_reference(n_groups, groups, k, to_evaluate);\n        }\n    }\n\n    KnnCandidate *merged = locals[0].heap;\n    size_t selected_count = locals[0].count;\n    if (selected_count < retained) {\n        KnnCandidate *grown = (KnnCandidate *)realloc(merged, retained * sizeof(*merged));\n        if (grown == NULL) {\n            knn_free_locals(locals, workers);\n            return knn_serial_reference(n_groups, groups, k, to_evaluate);\n        }\n        merged = grown;\n        locals[0].heap = merged;\n    }\n\n    for (int block = 1; block < workers; ++block) {\n        for (size_t i = 0; i < locals[block].count; ++i) {\n            knn_heap_offer(merged, &selected_count, retained, locals[block].heap[i]);\n        }\n    }\n\n    size_t counts[UCHAR_MAX + 1] = {0};\n    for (size_t i = 0; i < selected_count; ++i) {\n        ++counts[(unsigned char)merged[i].label];\n    }\n    counts[UCHAR_MAX] += (size_t)k - selected_count;\n    char answer = knn_vote(counts);\n    knn_free_locals(locals, workers);\n    return answer;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
        "path": "src/knn.c"
      }

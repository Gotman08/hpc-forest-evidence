#include <stdio.h>
#include <stdlib.h>

/* Allocate aligned memory (64-byte alignment for SIMD) */
static void *aligned_malloc(size_t size) {
    void *ptr;
    if (posix_memalign(&ptr, 128, size)) { /* 128-byte cache-line alignment */
        fprintf(stderr, "Aligned allocation failed\n");
        exit(1);
    }
    return ptr;
}

typedef struct {
    float x;
    float y;
} Point;

typedef struct {
    char label;
    int length;
    float * __restrict__ xs;   /* array of x coordinates */
    float * __restrict__ ys;   /* array of y coordinates */
} Group;

void on_error() {
    printf("Invalid input file.\n");
    exit(1);
}

int parse_number_of_groups() {
    int n;
    if (scanf(" n_groups=%d ", &n) != 1) on_error();
    return n;
}

Point parse_point() {
    float x, y;
    if (scanf(" (%f ,%f) ", &x, &y) != 2) on_error();
    Point point;
    point.x = x;
    point.y = y;
    return point;
}

Group parse_next_group() {
    char label; 
    int length;

    if (scanf(" label=%c ", &label) != 1) on_error();
    if (scanf(" length=%d ", &length) != 1) on_error();

    Group group;
    group.label = label;
    group.length = length;
    /* Allocate with cache-line alignment for better SIMD performance */
    group.xs = (float *)aligned_malloc(sizeof(float) * length);
    group.ys = (float *)aligned_malloc(sizeof(float) * length);

    for (int i = 0; i < length; i++) {
        Point p = parse_point();
        group.xs[i] = p.x;
        group.ys[i] = p.y;
    }

    return group;
}

int parse_k() {
    int k;
    if (scanf(" k=%d ", &k) != 1) on_error();
    return k;
}

float euclidean_distance_no_sqrt(Point a, Point b) {
    float dx = b.x - a.x;
    float dy = b.y - a.y;
    return dx * dx + dy * dy;
}

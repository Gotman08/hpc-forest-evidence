#include <algorithm>
#include <cstddef>
#include <iostream>
#include <iterator>
#include <string>

class PermutationOutput
{
public:
    PermutationOutput () : used_ (0) {}

    ~PermutationOutput ()
    {
        flush () ;
    }

    PermutationOutput (PermutationOutput const&) = delete ;
    PermutationOutput& operator= (PermutationOutput const&) = delete ;

    template <typename Iter> auto
    append (Iter first, Iter last) -> void
    {
        const std::size_t length =
            static_cast <std::size_t> (std::distance (first, last)) ;

        // Check the bound before computing the formatted row size.
        if (length <= (capacity - 4) / 2) {
            const std::size_t row_size = 2 * length + 4 ;
            if (row_size > capacity - used_) flush () ;

            char* destination = buffer_ + used_ ;
            *destination++ = '[' ;
            *destination++ = ' ' ;
            while (first != last) {
                *destination++ = *first ;
                *destination++ = ' ' ;
                ++ first ;
            }
            *destination++ = ']' ;
            *destination = '\n' ;
            used_ += row_size ;
            return ;
        }

        // Oversized rows use the same bounded buffer without truncation.
        append_pair ('[', ' ') ;
        while (first != last) {
            append_pair (*first, ' ') ;
            ++ first ;
        }
        append_pair (']', '\n') ;
    }

private:
    static const std::size_t capacity = 64 * 1024 ;
    char buffer_ [capacity] ;
    std::size_t used_ ;

    auto flush () -> void
    {
        if (used_ != 0) {
            std::cout.write
                (buffer_, static_cast <std::streamsize> (used_)) ;
            used_ = 0 ;
        }
    }

    auto append_pair (char first, char second) -> void
    {
        if (capacity - used_ < 2) flush () ;
        buffer_ [used_++] = first ;
        buffer_ [used_++] = second ;
    }
} ;

struct PrintPermutation
{
    explicit PrintPermutation (PermutationOutput& output)
        : output_ (output) {}

    template <typename Iter> auto
    operator () (Iter first, Iter last) const -> void
    {
        output_.append (first, last) ;
    }

private:
    PermutationOutput& output_ ;
} ;

struct IsWhitespace
{
    template <typename Char> auto
    operator () (Char c) const -> bool
    {
        return (c == ' ' )
            || (c == '\n')
            || (c == '\r')
            || (c == '\t')
            || (c == '\f')
            || (c == '\v') ;
    }
} ;

template <typename String> inline auto
remove_whitespaces (String text) -> String
{
    text.erase
        ( std::remove_if
            ( text.begin ()
            , text.end ()
            , IsWhitespace () )
        , text.end () ) ;
    return text ;
}

template <typename Iter> auto
find_longest_non_increasing_suffix (Iter first, Iter last) -> Iter
{
    if (first == last) return last ;
    Iter back = std::prev (last) ;
    if (back == first) return last ;
    do {
        -- last ;
        -- back ;
        if (*back < *last) return last ;
    } while (back != first) ;
    return first ;
}

template <typename Iter> auto
find_rightmost_successor (Iter first, Iter second, Iter last) -> Iter
{
    if (second == last) return last ;
    do {
        -- last ;
    } while ((second != last) && (*last <= *first)) ;
    return last ;
}

template <typename Iter> auto
next_permutation (Iter first, Iter last) -> bool
{
    if (first == last) return false ;
    Iter suffix = find_longest_non_increasing_suffix (first, last) ;
    if (suffix == first) return false ;
    if (suffix == last)  return false ;
    Iter pivot = std::prev (suffix) ;
    Iter successor = find_rightmost_successor (pivot, suffix, last) ;
    std::iter_swap (pivot, successor) ;
    std::reverse (suffix, last) ;
    return true ;
}

template <typename Iter, typename Function> inline auto
permutations_iter (Iter first, Iter last, Function driver) -> void
{
    if (first == last) return ;
    std::sort (first, last) ;
    do {
        driver (first, last) ;
    } while (::next_permutation (first, last)) ;
    return ;
}

template <typename String, typename Function> inline auto
permutations (String text, Function driver) -> void
{
    permutations_iter (std::begin (text), std::end (text), driver) ;
}

template <typename String, typename InStream> inline auto
read_text_from_stdin (InStream& in) -> String
{
    std::istreambuf_iterator <char> begin (in), end ;
    std::string text (begin, end) ;
    text = remove_whitespaces (text) ;
    return text ;
}

int main (int argc, char const *argv [])
{
    std::ios::sync_with_stdio (false) ;
    std::cin.tie (nullptr) ;
    std::string text = read_text_from_stdin <std::string> (std::cin) ;
    PermutationOutput output ;
    permutations (text, PrintPermutation (output)) ;
    return 0 ;
}

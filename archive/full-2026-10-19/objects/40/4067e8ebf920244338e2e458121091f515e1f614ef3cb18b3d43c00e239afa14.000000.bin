"""Render exact reviewed no-model Q arguments locally; never submit or run."""
from datetime import UTC, datetime
import hashlib
import json
from pathlib import Path

BASE = Path(r'C:\Users\nicol\Documents\Codex\2026-10-15\cr')
PREP = BASE / 'outputs/HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r3'
DELIVERY = PREP / 'adaptateurs-source110-r1/LIVRAISON-FINALE-G-LIE-AVANT-Q-R5.json'


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


assert sha(DELIVERY) == 'd1661eacc963867059442489dc159bd34d5575c7d7de4604f8f7d0a8dcf2ba6f'
value = json.loads(DELIVERY.read_bytes())
for key in ('components', 'Q_packet', 'Q_wrapper', 'Q_command', 'Q_bindings', 'Q_proposal', 'manifest', 'local_historical_G_admission'):
    item = value[key]
    assert sha(Path(item['path'])) == item['sha256']
command = Path(value['Q_command']['path']).read_text('utf8')
proposal = json.loads(Path(value['Q_proposal']['path']).read_bytes())
assert proposal['allocation'] == {'nodes': 1, 'tasks': 1, 'cpu_cores': 4, 'memory_mib': 16384, 'gpus': 0, 'architecture': 'ARM64', 'max_seconds': 600}
assert datetime.now(UTC).timestamp() + 600 + 10800 < 1793487600
root = proposal['remote_root_proposed']
assert root.startswith('/scratch_p/nimarano/hpc-forest-r4b-source110-completeQ-20261018-')
packet = root + '.tar.gz'
assert packet in command and value['Q_packet']['sha256'] in command
output = PREP / 'qualification-allouee-source110-G-recu-r1'
output.mkdir(exist_ok=False)
args = {'name': 'hpc-forest-r3-source110-zero-model', 'arch': 'armgpu', 'partition': 'instant',
    'nodes': 1, 'ntasks_per_node': 1, 'cpus_per_task': 4, 'mem_gb': 16, 'gpus_per_node': 0,
    'time_limit': '00:10:00', 'cpu_bind': 'cores', 'spack_packages': [], 'modules': [],
    'workdir': '/scratch_p/nimarano', 'redirect_caches': False, 'command': command}
for name, content in (
    ('arguments-job-prepare-reels.json', args),
    ('INTENTION-QUALIFICATION-ZERO-MODELE.json', {'recorded_at': datetime.now(UTC).isoformat(),
        'source_zip_sha256': value['source_zip_sha256'], 'plan_sha256': value['plan_sha256'],
        'components': value['components'], 'packet': value['Q_packet'], 'remote_packet': packet,
        'remote_root': root, 'wrapper': value['Q_wrapper'], 'command': value['Q_command'],
        'review_before_any_remote_effect_required': True, 'job_prepared_or_submitted': False,
        'native_model_calls': 0, 'native_research_admitted': False, 'r5_method_admitted': False}),
):
    with (output / name).open('x', encoding='utf8', newline='\n') as stream:
        json.dump(content, stream, indent=2)
print(json.dumps({'output': str(output), 'packet_local_path': value['Q_packet']['path'], 'remote_packet': packet,
    'remote_root': root, 'packet_sha256': value['Q_packet']['sha256'],
    'arguments_path': str(output / 'arguments-job-prepare-reels.json'), 'job_submitted': False}))

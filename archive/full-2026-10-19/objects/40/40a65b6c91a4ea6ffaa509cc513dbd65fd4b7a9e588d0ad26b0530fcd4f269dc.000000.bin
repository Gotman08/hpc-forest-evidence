#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N_ITER 10
#define DT 0.01f
#define SOFTENING 1e-9f

int main(int argc, char **argv) {
    int nbodies;
    if (fread(&nbodies, sizeof(nbodies), 1, stdin) != 1) {
        fprintf(stderr, "\nError reading nbodie value\n");
        exit(EXIT_FAILURE);
    }
    size_t count = (size_t)nbodies * 6;
    float *tmp = (float *)malloc(count * sizeof(float));
    if (!tmp) { perror("malloc"); exit(EXIT_FAILURE); }
    if (fread(tmp, count * sizeof(float), 1, stdin) != 1) {
        fprintf(stderr, "\nError reading input values\n");
        exit(EXIT_FAILURE);
    }

    float * restrict px = (float *)malloc((size_t)nbodies * sizeof(float));
    float * restrict py = (float *)malloc((size_t)nbodies * sizeof(float));
    float * restrict pz = (float *)malloc((size_t)nbodies * sizeof(float));
    float * restrict vx = (float *)malloc((size_t)nbodies * sizeof(float));
    float * restrict vy = (float *)malloc((size_t)nbodies * sizeof(float));
    float * restrict vz = (float *)malloc((size_t)nbodies * sizeof(float));
    if (!px || !py || !pz || !vx || !vy || !vz) { perror("malloc"); exit(EXIT_FAILURE); }

    for (int i = 0; i < nbodies; ++i) {
        px[i] = tmp[6*i];
        py[i] = tmp[6*i+1];
        pz[i] = tmp[6*i+2];
        vx[i] = tmp[6*i+3];
        vy[i] = tmp[6*i+4];
        vz[i] = tmp[6*i+5];
    }
    free(tmp);

    #pragma omp parallel
    {
        for (int iter = 0; iter < N_ITER; ++iter) {
            // Force and velocity update: process four bodies per iteration to improve data reuse.
            int nfull = (nbodies / 4) * 4;
            #pragma omp for schedule(static)
            for (int ib = 0; ib < nfull; ib += 4) {
                float xi0 = px[ib], yi0 = py[ib], zi0 = pz[ib];
                float xi1 = px[ib+1], yi1 = py[ib+1], zi1 = pz[ib+1];
                float xi2 = px[ib+2], yi2 = py[ib+2], zi2 = pz[ib+2];
                float xi3 = px[ib+3], yi3 = py[ib+3], zi3 = pz[ib+3];

                float fx0=0.0f, fy0=0.0f, fz0=0.0f;
                float fx1=0.0f, fy1=0.0f, fz1=0.0f;
                float fx2=0.0f, fy2=0.0f, fz2=0.0f;
                float fx3=0.0f, fy3=0.0f, fz3=0.0f;

                for (int j = 0; j < nbodies; ++j) {
                    // Body 0
                    float dx0 = px[j] - xi0;
                    float dy0 = py[j] - yi0;
                    float dz0 = pz[j] - zi0;
                    float sqrd0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;
                    float inv0 = 1.0f / sqrt(sqrd0);
                    float inv3_0 = inv0 * inv0 * inv0;
                    fx0 += dx0 * inv3_0; fy0 += dy0 * inv3_0; fz0 += dz0 * inv3_0;

                    // Body 1
                    float dx1 = px[j] - xi1;
                    float dy1 = py[j] - yi1;
                    float dz1 = pz[j] - zi1;
                    float sqrd1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;
                    float inv1 = 1.0f / sqrt(sqrd1);
                    float inv3_1 = inv1 * inv1 * inv1;
                    fx1 += dx1 * inv3_1; fy1 += dy1 * inv3_1; fz1 += dz1 * inv3_1;

                    // Body 2
                    float dx2 = px[j] - xi2;
                    float dy2 = py[j] - yi2;
                    float dz2 = pz[j] - zi2;
                    float sqrd2 = dx2*dx2 + dy2*dy2 + dz2*dz2 + SOFTENING;
                    float inv2 = 1.0f / sqrt(sqrd2);
                    float inv3_2 = inv2 * inv2 * inv2;
                    fx2 += dx2 * inv3_2; fy2 += dy2 * inv3_2; fz2 += dz2 * inv3_2;

                    // Body 3
                    float dx3 = px[j] - xi3;
                    float dy3 = py[j] - yi3;
                    float dz3 = pz[j] - zi3;
                    float sqrd3 = dx3*dx3 + dy3*dy3 + dz3*dz3 + SOFTENING;
                    float inv3_3 = 1.0f / sqrt(sqrd3);
                    float inv3_3b = inv3_3 * inv3_3 * inv3_3;
                    fx3 += dx3 * inv3_3b; fy3 += dy3 * inv3_3b; fz3 += dz3 * inv3_3b;
                }

                vx[ib]   += DT*fx0; vy[ib]   += DT*fy0; vz[ib]   += DT*fz0;
                vx[ib+1] += DT*fx1; vy[ib+1] += DT*fy1; vz[ib+1] += DT*fz1;
                vx[ib+2] += DT*fx2; vy[ib+2] += DT*fy2; vz[ib+2] += DT*fz2;
                vx[ib+3] += DT*fx3; vy[ib+3] += DT*fy3; vz[ib+3] += DT*fz3;
            }

            // Tail bodies (if nbodies not divisible by 4)
            #pragma omp for schedule(static)
            for (int i = nfull; i < nbodies; ++i) {
                float fx = 0.0f, fy = 0.0f, fz = 0.0f;
                const float xi = px[i], yi = py[i], zi = pz[i];
                int j = 0;
                // Unroll the inner reduction by 4 to expose independent
                // sqrt/division computations for SIMD while keeping the
                // exact per-body accumulation order (j ascending).
                for (; j + 3 < nbodies; j += 4) {
                    float dx0 = px[j]   - xi;
                    float dy0 = py[j]   - yi;
                    float dz0 = pz[j]   - zi;
                    float sqrd0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;
                    float inv0 = 1.0f / sqrt(sqrd0);
                    float inv3_0 = inv0 * inv0 * inv0;
                    fx += dx0 * inv3_0; fy += dy0 * inv3_0; fz += dz0 * inv3_0;

                    float dx1 = px[j+1] - xi;
                    float dy1 = py[j+1] - yi;
                    float dz1 = pz[j+1] - zi;
                    float sqrd1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;
                    float inv1 = 1.0f / sqrt(sqrd1);
                    float inv3_1 = inv1 * inv1 * inv1;
                    fx += dx1 * inv3_1; fy += dy1 * inv3_1; fz += dz1 * inv3_1;

                    float dx2 = px[j+2] - xi;
                    float dy2 = py[j+2] - yi;
                    float dz2 = pz[j+2] - zi;
                    float sqrd2 = dx2*dx2 + dy2*dy2 + dz2*dz2 + SOFTENING;
                    float inv2 = 1.0f / sqrt(sqrd2);
                    float inv3_2 = inv2 * inv2 * inv2;
                    fx += dx2 * inv3_2; fy += dy2 * inv3_2; fz += dz2 * inv3_2;

                    float dx3 = px[j+3] - xi;
                    float dy3 = py[j+3] - yi;
                    float dz3 = pz[j+3] - zi;
                    float sqrd3 = dx3*dx3 + dy3*dy3 + dz3*dz3 + SOFTENING;
                    float inv3_3 = 1.0f / sqrt(sqrd3);
                    float inv3_3b = inv3_3 * inv3_3 * inv3_3;
                    fx += dx3 * inv3_3b; fy += dy3 * inv3_3b; fz += dz3 * inv3_3b;
                }
                for (; j < nbodies; ++j) {
                    float dx = px[j] - xi;
                    float dy = py[j] - yi;
                    float dz = pz[j] - zi;
                    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
                    float inv_dist = 1.0f / sqrt(sqrd_dist);
                    float inv_dist3 = inv_dist * inv_dist * inv_dist;
                    fx += dx * inv_dist3; fy += dy * inv_dist3; fz += dz * inv_dist3;
                }
                vx[i] += DT*fx; vy[i] += DT*fy; vz[i] += DT*fz;
            }

            #pragma omp for simd
            for (int i = 0; i < nbodies; ++i) {
                px[i] += vx[i] * DT;
                py[i] += vy[i] * DT;
                pz[i] += vz[i] * DT;
            }
        }
    }

    float *out = (float *)malloc(count * sizeof(float));
    if (!out) { perror("malloc"); exit(EXIT_FAILURE); }
    for (int i = 0; i < nbodies; ++i) {
        out[6*i]   = px[i];
        out[6*i+1] = py[i];
        out[6*i+2] = pz[i];
        out[6*i+3] = vx[i];
        out[6*i+4] = vy[i];
        out[6*i+5] = vz[i];
    }
    if (fwrite(out, count * sizeof(float), 1, stdout) != 1) {
        fprintf(stderr, "\nError writing to output\n");
        exit(EXIT_FAILURE);
    }

    free(px); free(py); free(pz); free(vx); free(vy); free(vz); free(out);
    return EXIT_SUCCESS;
}

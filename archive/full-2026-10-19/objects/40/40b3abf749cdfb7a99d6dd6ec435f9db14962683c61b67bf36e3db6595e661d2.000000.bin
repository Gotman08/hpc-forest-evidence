"""Audit a fresh source-only group; write exclusively outside received evidence."""
import argparse
import json
from pathlib import Path

from comparison_reception import ROOT, audit_group, bound, load, require


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("root", type=Path)
    parser.add_argument("output", type=Path)
    parser.add_argument("--archive", type=Path, required=True)
    parser.add_argument("--group", type=Path, required=True)
    parser.add_argument("--source-zip", type=Path, required=True)
    parser.add_argument("--references", type=Path, default=ROOT / "contrats-reference.json")
    parser.add_argument("--worker", type=Path)
    args = parser.parse_args()
    root = args.root.resolve(strict=True)
    require(not args.output.resolve().is_relative_to(root), "Audit output must be outside the received root")
    require(not args.output.exists(), "Preserve the existing output and choose a new audit filename")
    reference = load(args.references)
    require(reference["operator_context_not_for_models"] is True, "Wrong reference evidence")
    for item in reference["implementation_dependencies"].values():
        bound(item)
    result = audit_group(root, args.archive, args.source_zip, load(args.group), reference["subjects"], args.worker)
    args.output.write_text(json.dumps(result, indent=2, ensure_ascii=False) + "\n", encoding="utf8")
    print(json.dumps({k: result[k] for k in ("scope_id", "job_id", "model", "effort",
          "coverage_and_final_confirmations_verified", "deliveries_reconciled")}))
    return 0 if result["coverage_and_final_confirmations_verified"] else 1


if __name__ == "__main__":
    raise SystemExit(main())

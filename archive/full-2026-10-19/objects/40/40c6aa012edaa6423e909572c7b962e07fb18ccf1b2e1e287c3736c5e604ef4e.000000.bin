"""Projection locale sans droit de lancement, depuis le seul plan scellé."""
import hashlib
import json
from datetime import datetime, timezone
from pathlib import Path


HERE = Path(__file__).resolve().parent
PREP = HERE.parent
BASE = PREP.parents[1]
REV = PREP / "revision-source-r4b/revision-r2"
LAUNCH = PREP / "lancement-technique-r4b-r1"
SCOPE = "hpc-forest-dynamic-independent-roots-r4b-max"
PLAN_SHA = "9f04e93c1a28c70f444005b7670ff23731cac838846b99cb1b6742db9e8de33b"
ZIP_SHA = "ede293f185e663241c01c22a5fa9edcd54ad66af6a1e0964755eac306c5de0f3"
NEGATIVE_SHA = "d8085d8e077e0d501319bce314ea30ff8b3aca7df312f9acae10cda9325fda6f"
MODELS = ("gpt-6.1-sol", "gpt-6-astra", "gpt-5.6-terra")
PHASES = ("roots", "advice", "harvest")


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def ref(path, expected=None):
    actual = sha(path)
    if expected is not None and actual != expected:
        raise ValueError(f"Sealed input changed: {path.name}")
    return {"path": str(path), "sha256": actual}


def load(path):
    def unique(pairs):
        result = {}
        for key, value in pairs:
            if key in result:
                raise ValueError(f"Duplicate JSON key: {key}")
            result[key] = value
        return result
    return json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=unique)


def save_new(name, value):
    with (HERE / name).open("x", encoding="utf-8", newline="\n") as stream:
        json.dump(value, stream, ensure_ascii=False, indent=2, allow_nan=False)
        stream.write("\n")


def main():
    plan_path = REV / "dynamic-plan-r4b-max.json"
    plan_ref = ref(plan_path, PLAN_SHA)
    source_ref = ref(REV / "HPC-Forest-Mere-Dynamique-R4b-MAX.zip", ZIP_SHA)
    plan = load(plan_path)
    assert plan["scope_id"] == SCOPE
    assert set(plan["models"]) == set(MODELS) | {"gpt-6-luna"}
    assert plan["efforts"] == ["max"]
    assert plan["maximum_native_workers_total"] == 4
    assert plan["max_parallel_native_generation_workers"] == 4
    assert plan["candidate_resources"] == {
        "cpu_cores": 4, "memory_gib": 16, "gpus": 0, "architecture": "ARM64"}
    sessions = list(plan["cells"].values()) + [
        session for cells in plan["contract_cells"].values() for session in cells.values()]
    assert len(sessions) == len(set(sessions)) == 16
    assert all(len(s) == 32 and set(s) <= set("0123456789abcdef") for s in sessions)
    negative_path = PREP / "operations-parent-roots-20261018/reception-roots-752306/RECONCILIATION-NEGATIVE-FINALE.json"
    negative_ref = ref(negative_path, NEGATIVE_SHA)
    negative = load(negative_path)
    assert negative["job_id"] == "752306"
    assert negative["model"] == "gpt-6-luna" and negative["effort"] == "max"
    assert negative["normal_native_delivery_verified"] is False
    assert negative["global_admission_verified"] is False
    candidates = []
    for model in MODELS:
        contracts = []
        for phase in PHASES:
            session = plan["contract_cells"][model][phase]
            contracts.append({
                "phase": phase, "session_id": session, "job_id": None,
                "remote_root": f"/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-{session}",
                "admission_root": f"/scratch_p/nimarano/hpc-forest-dynamic-r4b-admission-{session}",
                "generation_admitted": False, "submission_performed": False,
                "contract_result": None,
            })
        candidates.append({
            "model": model, "effort": "max", "contracts": contracts,
            "pilot_session_id_from_plan": plan["cells"][model],
            "pilot_subject_from_plan": "2023-count",
            "pilot_admitted": False,
            "current_luna_only_launcher_supports_this_model": False,
            "required_before_technical_start": [
                "Reviewed model-specific launcher, worker binding, receipt and passive policy",
                "Explicit decision on preparation-contract correction and isolated qualification",
                "Fresh complete process census, existing OAuth and four copied CLI hashes",
                "Fresh cap4 admission covering every actual native worker including source-only",
                "Actual allocation, one exclusive submit intention, one observed submission",
                "Original request expiry, fresh cache/session/ledger and ready published LAST",
            ],
            "required_before_scientific_extension": [
                "Three actual positive roots/advice/harvest receipts for this exact model/MAX",
                "Reviewed pilot start boundary and model-specific pilot admission",
                "First NORMAL candidate delivery and real evaluation received and checked",
                "Actual errors, negative results and exact or unknown usage reconciled",
            ],
        })
    proposal = {
        "schema": "hpc-forest-r4b-future-model-start-projection-v1",
        "verified": False, "generation_admitted": False,
        "scope_id": SCOPE, "source_plan": plan_ref, "sealed_source_zip": source_ref,
        "source_and_plan_changed": False, "model_calls": 0, "jobs_submitted": 0,
        "current_launcher_model": "gpt-6-luna",
        "proposed_other_model_order_is_not_a_ranking": True,
        "models": candidates,
        "concurrency_proposal": {
            "source_only_workers": 1, "new_model_workers": 3,
            "maximum_total": 4, "admitted_now": False,
            "four_new_models_plus_source_only_refused": True,
            "later_wave_requires_fresh_census_after_reconciliation": True,
        },
        "luna_closed_negative": {
            "receipt": negative_ref, "job_id": "752306",
            "session_id": plan["contract_cells"]["gpt-6-luna"]["roots"],
            "replay_allowed": False, "positive_contract": False,
            "advice_harvest_pilot_admitted": False,
        },
        "scientific_limits_unchanged": plan["limits"],
        "candidate_resources": plan["candidate_resources"],
        "first_normal_received_before_extension": True,
        "new_model_backend_attestation_observed": False,
        "deadline_exclusive_utc": plan["deadline_exclusive_utc"],
        "minimum_receipt_audit_reserve_seconds": 10800,
        "deadline_requires_fresh_check_after_wait": True,
        "r5_alone_later_and_not_admitted": True,
    }
    save_new("FUTURS-PREMIERS-DEMARRAGES.json", proposal)
    save_new("VERIFICATION-PROJECTION.json", {
        "schema": "hpc-forest-local-projection-verification-v1", "verified": True,
        "scope": "local static projection only, no launch or admission",
        "verified_at_utc": datetime.now(timezone.utc).isoformat(),
        "source_refs": [plan_ref, source_ref, negative_ref],
        "projection": ref(HERE / "FUTURS-PREMIERS-DEMARRAGES.json"),
        "generator": ref(Path(__file__).resolve()),
        "exact_models": list(MODELS), "exact_technical_sessions": 9,
        "all_plan_sessions_unique": 16, "luna_replay_refused": True,
        "scientific_admission": False, "processes_started": 0,
        "model_calls": 0, "jobs_submitted": 0,
    })
    print(json.dumps({"created": "FUTURS-PREMIERS-DEMARRAGES.json", "admitted": False,
                      "models": len(candidates), "technical_sessions": 9}))


if __name__ == "__main__":
    main()

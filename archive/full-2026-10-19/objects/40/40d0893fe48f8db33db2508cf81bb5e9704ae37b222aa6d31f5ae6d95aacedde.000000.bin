    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <math.h>\\n\\n#define N_ITER 10 // number of simulation iterations\\n#define DT 0.01f // time step\\n#define SOFTENING 1e-9f // to avoid zero divisors\\n\\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\\n\\n#define TILE 64\\n\\nvoid body_force(Body * restrict p, float dt, int n) {\\n  const int n_tiles = (n + TILE - 1) / TILE;\\n  #pragma omp parallel for schedule(static)\\n  for (int t = 0; t < n_tiles; ++t) {\\n    const int start = t * TILE;\\n    const int end = (start + TILE < n) ? start + TILE : n;\\n    float px[TILE], py[TILE], pz[TILE];\\n    for (int i = start; i < end; ++i) {\\n      const int k = i - start;\\n      px[k] = p[i].x;\\n      py[k] = p[i].y;\\n      pz[k] = p[i].z;\\n    }\\n    float fx[TILE] = {0.0f};\\n    float fy[TILE] = {0.0f};\\n    float fz[TILE] = {0.0f};\\n\\n    for (int j = 0; j < n; ++j) {\\n      const float xj = p[j].x;\\n      const float yj = p[j].y;\\n      const float zj = p[j].z;\\n      #pragma omp simd\\n      for (int i = start; i < end; ++i) {\\n        const int k = i - start;\\n        const float dx = xj - px[k];\\n        const float dy = yj - py[k];\\n        const float dz = zj - pz[k];\\n        const float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n        const float inv_dist = 1.0f / sqrt(sqrd_dist);\\n        const float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n        fx[k] += dx * inv_dist3;\\n        fy[k] += dy * inv_dist3;\\n        fz[k] += dz * inv_dist3;\\n      }\\n    }\\n\\n    for (int i = start; i < end; ++i) {\\n      const int k = i - start;\\n      p[i].vx += dt*fx[k];\\n      p[i].vy += dt*fy[k];\\n      p[i].vz += dt*fz[k];\\n    }\\n  }\\n}\\n\\nBody* read_dataset(int *nbodies) {\\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading nbodie value\\\\n\\\");\\n    exit(EXIT_FA
#include <iostream>
#include <vector>
#include <cstdio>
#include <algorithm>
#include <climits>

// Fast integer reader using fread buffer
static char buf[1 << 20];
static int pos = 0;
static int len = 0;

inline int read_int() {
    while (pos >= len) {
        len = fread(buf, 1, sizeof(buf), stdin);
        pos = 0;
    }
    // skip non-digit characters except possible leading '-'
    while (buf[pos] < '0' || buf[pos] > '9') {
        if (buf[pos] == '-') break;
        ++pos;
        if (pos >= len) {
            len = fread(buf, 1, sizeof(buf), stdin);
            pos = 0;
        }
    }
    int neg = 0;
    if (buf[pos] == '-') { neg = 1; ++pos; }
    // ensure we have a digit after optional sign
    while (pos >= len) {
        len = fread(buf, 1, sizeof(buf), stdin);
        pos = 0;
    }
    int x = 0;
    while (pos < len && buf[pos] >= '0' && buf[pos] <= '9') {
        x = x * 10 + (buf[pos] - '0');
        ++pos;
    }
    return neg ? -x : x;
}

int main() {
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(nullptr);

    int n, s;
    // Use fast read for first two integers
    n = read_int();
    s = read_int();

    const int np1 = n + 1;
    // Integral image (summed-area table) using long long to avoid overflow
    std::vector<long long> pref(np1 * np1, 0LL);

    // First pass: horizontal cumulative sums per row while reading input
    for (int i = 0; i < n; ++i) {
        long long row_sum = 0;
        const int base_i = (i + 1) * np1;
        for (int j = 0; j < n; ++j) {
            int val = read_int();
            row_sum += val;
            pref[base_i + (j + 1)] = row_sum;
        }
    }

    // Second pass: vertical accumulation to complete the integral image
    for (int i = 0; i < n; ++i) {
        const int base_cur = (i + 1) * np1;
        const int base_prev = i * np1;
        long long* cur_row = &pref[base_cur];
        const long long* prev_row = &pref[base_prev];
        for (int j = 0; j < n; ++j) {
            cur_row[j + 1] += prev_row[j + 1];
        }
    }

    // Precompute row offsets for faster access in search loop
    std::vector<int> row_offset(np1);
    for (int i = 0; i < np1; ++i) {
        row_offset[i] = i * np1;
    }

    // Search for maximum SxS submatrix sum using blocking to improve cache reuse
    const int B = 128; // block size, tuned for typical cache sizes
    long long mxSum = LLONG_MIN;

    for (int ii = 0; ii < n - s + 1; ii += B) {
        const int i_end = std::min(ii + B, n - s + 1);
        for (int jj = 0; jj < n - s + 1; jj += B) {
            const int j_end = std::min(jj + B, n - s + 1);
            for (int i = ii; i < i_end; ++i) {
                const long long * __restrict__ row_i_s = &pref[row_offset[i + s]];
                const long long * __restrict__ row_i   = &pref[row_offset[i]];
#pragma GCC ivdep
                for (int j = jj; j < j_end; ++j) {
                    long long sum = row_i_s[j + s] - row_i[j + s]
                                   - row_i_s[j] + row_i[j];
                    if (sum > mxSum) mxSum = sum;
                }
            }
        }
    }

    printf("%d\n", static_cast<int>(mxSum));
    return 0;
}

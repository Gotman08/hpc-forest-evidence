{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include \\\"knn.h\\\"\\n#include <omp.h>\\n\\ntypedef struct {\\n    float distance;\\n    size_t order;\\n    char label;\\n} Candidate;\\n\\nstatic int candidate_before(const Candidate *a, const Candidate *b) {\\n    if (a->distance < b->distance) return 1;\\n    if (a->distance > b->distance) return 0;\\n    return a->order < b->order;\\n}\\n\\nstatic int compare_candidates(const void *a, const void *b) {\\n    const Candidate *ca = (const Candidate *)a;\\n    const Candidate *cb = (const Candidate *)b;\\n    if (candidate_before(ca, cb)) return -1;\\n    if (candidate_before(cb, ca)) return 1;\\n    return 0;\\n}\\n\\nstatic void sift_down(Candidate *heap, size_t count, size_t root) {\\n    for (;;) {\\n        size_t left = root * 2 + 1;\\n        if (left >= count) return;\\n\\n        size_t worse = left;\\n        size_t right = left + 1;\\n        if (right < count && candidate_before(&heap[worse], &heap[right])) {\\n            worse = right;\\n        }\\n\\n        if (!candidate_before(&heap[root], &heap[worse])) return;\\n\\n        Candidate tmp = heap[root];\\n        heap[root] = heap[worse];\\n        heap[worse] = tmp;\\n        root = worse;\\n    }\\n}\\n\\nstatic void heap_offer(Candidate *heap, size_t *count, size_t capacity,\\n                       Candidate candidate) {\\n    if (*count < capacity) {\\n        size_t child = (*count)++;\\n        heap[child] = candidate;\\n        while (child > 0) {\\n            size_t parent = (child - 1) / 2;\\n            if (!candidate_before(&heap[parent], &heap[child])) break;\\n            Candidate tmp = heap[parent];\\n            heap[parent] = heap[child];\\n            heap[child] = tmp;\\n            child = parent;\\n        }\\n    } else if (candidate_before(&candidate, &heap[0])) {\\n        heap[0] = candidate;\\n        sift_down(heap, *count, 0);\\n    }\\n}\\n\\nstatic char classify_labels(char *labels, int k) {\\n    qsort(labels, (size_t)k, sizeof(char), compare_for_sort);\\n\\n    char most_frequent = labels[0];\\n    int most_frequent_count = 1;\\n    int current_frequency = 1;\\n\\n    for (int i = 1; i < k; i++) {\\n        if (labels[i] != labels[i - 1]) {\\n            if (current_frequency > most_frequent_count) {\\n                most_frequent = labels[i - 1];\\n                most_frequent_count = current_frequency;\\n            }\\n            current_frequency = 1;\\n        } else {\\n            current_frequency++;\\n        }\\n\\n        if (i == k - 1 && current_frequency > most_frequent_count) {\\n            most_frequent = labels[i - 1];\\n            most_frequent_count = current_frequency;\\n        }\\n    }\\n\\n    return most_frequent;\\n}\\n\\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n    size_t total_points = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        total_points += (size_t)groups[i].length;\\n    }\\n\\n    size_t requested_k = (size_t)k;\\n\\n    /* When k covers every point, distance ordering cannot affect the result. */\\n    if (requested_k >= total_points) {\\n        char *labels = (char *)malloc(sizeof(char) * requested_k);\\n        size_t out = 0;\\n        for (int i = 0; i < n_groups; i++) {\\n            for (int j = 0; j < groups[i].length; j++) {\\n                labels[out++] = groups[i].label;\\n            }\\n        }\\n        while (out < requested_k) labels[out++] = (char)-1;\\n        char result = classify_labels(labels, k);\\n        free(labels);\\n        return result;\\n    }\\n\\n    Point *flat_points = (Point *)malloc(sizeof(Point) * total_points);\\n    char *flat_labels = (char *)malloc(sizeof(char) * total_points);\\n    size_t flat_index = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        for (int j = 0; j < groups[i].length; j++) {\\n            flat_points[flat_index] = groups[i].points[j];\\n            flat_labels[flat_index] = groups[i].label;\\n            flat_index++;\\n        }\\n    }\\n\\n    int max_threads = omp_get_max_threads();\\n    if (max_threads < 1) max_threads = 1;\\n    Candidate **thread_heaps = (Candidate **)calloc((size_t)max_threads,\\n                                                      sizeof(Candidate *));\\n    size_t *thread_counts = (size_t *)calloc((size_t)max_threads, sizeof(size_t));\\n\\n    #pragma omp parallel if(total_points >= 4096)\\n    {\\n        int thread_id = omp_get_thread_num();\\n        int thread_count = omp_get_num_threads();\\n        size_t chunk_capacity = (total_points + (size_t)thread_count - 1) /\\n                                (size_t)thread_count;\\n        size_t local_capacity = requested_k < chunk_capacity\\n                             ? requested_k : chunk_capacity;\\n        Candidate *local_heap = (Candidate *)malloc(sizeof(Candidate) * local_capacity);\\n        size_t local_count = 0;\\n        thread_heaps[thread_id] = local_heap;\\n\\n        #pragma omp for schedule(static)\\n        for (size_t i = 0; i < total_points; i++) {\\n            Candidate candidate;\\n            candidate.distance = euclidean_distance_no_sqrt(to_evaluate, flat_points[i]);\\n            candidate.order = i;\\n            candidate.label = flat_labels[i];\\n            heap_offer(local_heap, &local_count, local_capacity, candidate);\\n        }\\n\\n        thread_counts[thread_id] = local_count;\\n    }\\n\\n    size_t candidate_count = 0;\\n    for (int t = 0; t < max_threads; t++) candidate_count += thread_counts[t];\\n\\n    Candidate *candidates = (Candidate *)malloc(sizeof(Candidate) * candidate_count);\\n    size_t candidate_index = 0;\\n    for (int t = 0; t < max_threads; t++) {\\n        for (size_t i = 0; i < thread_counts[t]; i++) {\\n            candidates[candidate_index++] = thread_heaps[t][i];\\n        }\\n        free(thread_heaps[t]);\\n    }\\n    free(thread_heaps);\\n    free(thread_counts);\\n\\n    qsort(candidates, candidate_count, sizeof(Candidate), compare_candidates);\\n    char *labels = (char *)malloc(sizeof(char) * requested_k);\\n    for (size_t i = 0; i < requested_k; i++) labels[i] = candidates[i].label;\\n\\n    char result = classify_labels(labels, k);\\n    free(labels);\\n    free(candidates);\\n    free(flat_points);\\n    free(flat_labels);\\n    return result;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n\\n    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\"path\":\"src/knn.c\"}],\"hypothesis\":\"Flattening points and statically partitioning the distance scan lets OpenMP use the four available cores, while per-thread bounded heaps reduce top-k work and stable encounter-order tie-breaking preserves the reference result.\",\"notes\":\"This is a single OpenMP work-sharing candidate; its speedup is unmeasured and depends on input size and k. It requires an OpenMP-enabled build.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Flatten group points and labels into encounter order for balanced static scheduling.\",\"Use a static OpenMP work-sharing loop with a granularity threshold and per-thread max-heaps bounded by each thread's assigned chunk.\",\"Merge thread-local candidates by distance and encounter index, then retain the existing label-sorting and voting tie behavior.\",\"Skip distance calculations when k covers all points, adding the same missing-label placeholders as the original implementation.\"]}"}}

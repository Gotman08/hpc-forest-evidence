{
  "src/permutations.cc": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <limits>\n#include <new>\n#include <string>\n#include <vector>\n\nstatic bool is_whitespace(char value)\n{\n    return value == ' ' || value == '\\n' || value == '\\r' ||\n           value == '\\t' || value == '\\f' || value == '\\v';\n}\n\nstatic bool next_permutation(std::string& text)\n{\n    const std::size_t size = text.size();\n    if (size < 2) return false;\n\n    std::size_t suffix = size - 1;\n    while (suffix != 0 && text[suffix - 1] >= text[suffix]) --suffix;\n    if (suffix == 0) return false;\n\n    const std::size_t pivot = suffix - 1;\n    std::size_t successor = size - 1;\n    while (text[successor] <= text[pivot]) --successor;\n\n    std::swap(text[pivot], text[successor]);\n    std::reverse(text.begin() + suffix, text.end());\n    return true;\n}\n\nstatic void print_permutation(const std::string& text)\n{\n    std::cout.put('[');\n    std::cout.put(' ');\n    for (std::string::const_iterator it = text.begin(); it != text.end(); ++it) {\n        std::cout.put(*it);\n        std::cout.put(' ');\n    }\n    std::cout.put(']');\n    std::cout.put('\\n');\n}\n\nstatic inline void format_permutation(const char* source, char* destination,\n                                      std::size_t length, std::size_t line_length)\n{\n    destination[0] = '[';\n    destination[1] = ' ';\n    for (std::size_t position = 0; position != length; ++position) {\n        destination[2 + 2 * position] = source[position];\n        destination[3 + 2 * position] = ' ';\n    }\n    destination[line_length - 2] = ']';\n    destination[line_length - 1] = '\\n';\n}\n\nstatic void format_serial(const std::vector<char>& records, std::vector<char>& output,\n                          std::size_t count, std::size_t length,\n                          std::size_t line_length)\n{\n    for (std::size_t index = 0; index != count; ++index) {\n        format_permutation(records.data() + index * length,\n                           output.data() + index * line_length,\n                           length, line_length);\n    }\n}\n\nint main(int, char const*[])\n{\n    std::string text((std::istreambuf_iterator<char>(std::cin)),\n                     std::istreambuf_iterator<char>());\n    text.erase(std::remove_if(text.begin(), text.end(), is_whitespace), text.end());\n    if (text.empty()) return 0;\n\n    std::sort(text.begin(), text.end());\n\n    const std::size_t maximum = (std::numeric_limits<std::size_t>::max)();\n    if (text.size() > (maximum - 4) / 3) {\n        do {\n            print_permutation(text);\n        } while (next_permutation(text));\n        return 0;\n    }\n\n    const std::size_t line_length = 2 * text.size() + 4;\n    const std::size_t record_length = text.size() + line_length;\n    const std::size_t batch_byte_limit = 1024 * 1024;\n    const std::size_t maximum_batch_records = 32768;\n\n    if (record_length > batch_byte_limit) {\n        do {\n            print_permutation(text);\n        } while (next_permutation(text));\n        return 0;\n    }\n\n    std::size_t batch_capacity = batch_byte_limit / record_length;\n    if (batch_capacity > maximum_batch_records) batch_capacity = maximum_batch_records;\n    if (batch_capacity == 0) batch_capacity = 1;\n\n    try {\n        std::vector<char> records(batch_capacity * text.size());\n        std::vector<char> output(batch_capacity * line_length);\n        bool more = true;\n\n        while (more) {\n            std::size_t count = 0;\n            do {\n                std::copy(text.begin(), text.end(),\n                          records.data() + count * text.size());\n                ++count;\n                more = next_permutation(text);\n            } while (count != batch_capacity && more);\n\n            if (count * line_length < 65536 || count == 1) {\n                format_serial(records, output, count, text.size(), line_length);\n            } else {\n#pragma omp parallel for schedule(static)\n                for (long long index = 0; index < static_cast<long long>(count); ++index) {\n                    const std::size_t record = static_cast<std::size_t>(index);\n                    format_permutation(records.data() + record * text.size(),\n                                       output.data() + record * line_length,\n                                       text.size(), line_length);\n                }\n            }\n\n            std::cout.write(output.data(),\n                            static_cast<std::streamsize>(count * line_length));\n        }\n    } catch (const std::bad_alloc&) {\n        do {\n            print_permutation(text);\n        } while (next_permutation(text));\n    }\n\n    return 0;\n}\n"
}

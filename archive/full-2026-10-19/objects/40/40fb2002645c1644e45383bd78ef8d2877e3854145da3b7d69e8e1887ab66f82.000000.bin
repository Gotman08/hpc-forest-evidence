"""Read metadata/code bytes only and seal the bounded independent review."""
import ast
import hashlib
import json
import xml.etree.ElementTree as ET
from pathlib import Path

HERE = Path(__file__).resolve().parent
BASE = HERE.parents[3]
REL = BASE / 'outputs/HPC-Forest-Primes-Natif-Relance-r2f'
R1 = REL / 'operations-parent/collecteurs-r2f-r1'
R2 = REL / 'operations-parent/collecteurs-r2f-r2'


def ref(path):
    raw = path.read_bytes()
    return {'path': str(path.resolve()), 'sha256': hashlib.sha256(raw).hexdigest(), 'bytes': len(raw)}


def save(name, value):
    with (HERE / name).open('x', encoding='utf8', newline='\n') as stream:
        stream.write(json.dumps(value, ensure_ascii=False, indent=2) + '\n')


def main():
    assert ref(R2 / 'recevoir-installation-oauth.py')['sha256'] == '95ac367ebe2925ebc2dea8f0f343f437e25226d06d310700a0a975c38fc4132e'
    manifest = json.loads((R2 / 'MANIFESTE-HELPERS-PURS-CANDIDAT.json').read_text('utf8'))
    assert ref(R2 / 'MANIFESTE-HELPERS-PURS-CANDIDAT.json')['sha256'] == '2cc4a641aa5f23a1bff360515977b8d2a1093683cbbbe807cfa948cc802ead97'
    assert all(ref(R2 / name)['sha256'] == pin for name, pin in manifest['components'].items())
    unchanged = ('commun.py', 'preparer-intentions-natives.py', 'construire-observations-parent.py', 'produire-current-r4.py')
    assert all((R1 / name).read_bytes() == (R2 / name).read_bytes() for name in unchanged)
    old_helper = ast.parse((R1 / 'recevoir-installation-oauth.py').read_text('utf8'))
    new_helper = ast.parse((R2 / 'recevoir-installation-oauth.py').read_text('utf8'))
    def funcs(tree):
        return {node.name: ast.dump(node, include_attributes=False) for node in tree.body if isinstance(node, ast.FunctionDef)}
    before, after = funcs(old_helper), funcs(new_helper)
    assert set(before) == set(after) and [name for name in before if before[name] != after[name]] == ['validate_ready']
    suites = ET.parse(R2 / 'tests-initial.xml').findall('.//testsuite')
    assert sum(int(suite.get('tests')) for suite in suites) == 46
    assert all(int(suite.get(key, '0')) == 0 for suite in suites for key in ('errors', 'failures', 'skipped'))
    capture = REL / 'operations-parent/capturer-prevol-r2f.ps1'
    save('PREMIER-REFUS-DE-REVUE-CONSERVE.json', {
        'schema': 'hpc-forest-r2f-initial-metadata-review-first-refusal-v1',
        'candidate': ref(R1 / 'recevoir-installation-oauth.py'),
        'blocking_finding': 'utc_timestamp(lane_observed_at) required ISO text, whereas sealed source109 and lane_support require a finite numeric timestamp.',
        'confirmed_from': ['source109 primes_lane_contract.validate_lane_v2', 'factory lane_support', 'candidate validate_ready'],
        'candidate_used_on_real_cache_or_ready': False,
        'correction_isolated': ref(R2 / 'DERIVATION-CORRECTION-NUMERIQUE.json'),
        'budgets_source109_or_qualification_changed': False})
    save('REVUE-HELPERS-PURS-R2F-PREPARATION.json', {
        'schema': 'hpc-forest-r2f-independent-parent-pure-helpers-preparation-review-v1',
        'verified': True, 'blocking_findings': [], 'review_status': 'GO_for_exact_prepared_logic_only',
        'production_admitted': False, 'native_research_admitted': False,
        'reviewed_files': {name: ref(R2 / name) for name in manifest['components']},
        'reviewed_capture_parent': ref(capture),
        'candidate_manifest': ref(R2 / 'MANIFESTE-HELPERS-PURS-CANDIDAT.json'),
        'candidate_delivery': ref(R2 / 'LIVRAISON-HELPERS-PURS-CANDIDATE-NON-ADMIS.json'),
        'first_review_refusal': ref(HERE / 'PREMIER-REFUS-DE-REVUE-CONSERVE.json'),
        'numeric_lane_timestamp_matches_real_source109': True,
        'three_old_gaps_closed': ['exact OPS auth-metadata namespace before any hash/read',
            'received before/after full CIM five-field exact newly created pair and main PID',
            'historical initial numeric lane-to-ready age within600s; no new current freshness demanded'],
        'auth_observation_required_not_inferred_from_ready': True,
        'login_status_success_evidence_requires_actual_source109_ready': True,
        'only_nine_named_root_cache_files_stably_copied': True,
        'no_auth_file_ENV_CLI_transport_process_or_global_access_in_helper': True,
        'frozen_function_exact_AST_with_new_factory_scope_no_old_controller_import': True,
        'four_collectors_byte_identical_r1_to_r2': True,
        'CURRENT_corrected_PID_reader_unchanged': True,
        'whole_script_SHA_pin_review_required_before_intentions': True,
        'common_module_SHA_checked_before_import': True,
        'source_only_received_absent0_cap4_preserved': True,
        'actual_role_effect_and_human_refs_historical_only_fresh_parent_preflight_required': True,
        'existing_initial_neutral_tests_read': 46, 'tests_replayed_by_reviewer': 0,
        'initial_test_XML': ref(R2 / 'tests-initial.xml'),
        'collector_suite32_received': ref(R1 / 'LIVRAISON-HELPERS-PURS-CANDIDATE-NON-ADMIS.json'),
        'remaining_before_any_production': [
            'Receive and audit Q753345 source109/plan8d first; old Q receipts remain historical.',
            'Version-bind six currently UNBOUND factory/Q/three-script pins to actual reviewed receipts.',
            'New three native actual plans need whole-script hashes and independent complete script review.',
            'Parent fresh role/CLI4/CURRENT and old R2e failures reconciled before new submit/start.',
            'Initial/OAuth receive requires actual new launch pairs, ready and fresh secret-free parent auth metadata.'],
        'reviewer_read_live_cache_or_auth_or_census': False,
        'reviewer_executed_helper_CLI_model_transport_process_or_job': False,
        'NORMAL_evaluation_RAW_performance_or_release_proved': False})
    print(json.dumps(ref(HERE / 'REVUE-HELPERS-PURS-R2F-PREPARATION.json')))


if __name__ == '__main__':
    main()

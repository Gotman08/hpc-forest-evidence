::int64_t> vertical(row_width, 0);\\n+\\n+                // Initialize the vertical sums for this block's first top row.\\n+                for (int r = first; r < first + s; ++r) {\\n+                    const int* row = matrix.data() +\\n+                                     static_cast<std::size_t>(r) * row_width;\\n+                    for (int c = 0; c < n; ++c) {\\n+                        vertical[static_cast<std::size_t>(c)] += row[c];\\n+                    }\\n+                }\\n+\\n+                for (int top = first; top < last; ++top) {\\n+                    if (top > first) {\\n+                        const int* leaving = matrix.data() +\\n+                            static_cast<std::size_t>(top - 1) * row_width;\\n+                        const int* entering = matrix.data() +\\n+                            static_cast<std::size_t>(top + s - 1) * row_width;\\n+                        int c = 0;\\n+#if defined(__aarch64__)\\n+                        for (; c + 4 <= n; c += 4) {\\n+                            const int32x4_t entering_values = vld1q_s32(entering + c);\\n+                            const int32x4_t leaving_values = vld1q_s32(leaving + c);\\n+\\n+                            const int64x2_t entering_low =\\n+                                vmovl_s32(vget_low_s32(entering_values));\\n+                            const int64x2_t leaving_low =\\n+                                vmovl_s32(vget_low_s32(leaving_values));\\n+                            const int64x2_t entering_high =\\n+                                vmovl_s32(vget_high_s32(entering_values));\\n+                            const int64x2_t leaving_high =\\n+                                vmovl_s32(vget_high_s32(leaving_values));\\n+\\n+                            int64x2_t sums_low = vld1q_s64(vertical.data() + c);\\n+                            int64x2_t sums_high = vld1q_s64(vertical.data() + c + 2);\\n+                            sums_low = vaddq_s64(\\n+               
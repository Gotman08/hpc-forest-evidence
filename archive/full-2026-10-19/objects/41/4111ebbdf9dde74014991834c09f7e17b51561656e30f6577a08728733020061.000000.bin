cpp\\n@@ -1,57 +1,55 @@\\n-#include <iostream>\\n-#include <vector>\\n-#include <cstdio>\\n+#include <algorithm>\\n #include <cassert>\\n+#include <cstddef>\\n+#include <cstdio>\\n+#include <vector>\\n \\n int main() {\\n-\\tint n,s;\\n-\\tstd::cin >> n >> s;\\n-\\tstd::vector<std::vector<int> > matrix(n, std::vector<int>(n));\\n-\\tfor(int i=0;i<n;i++)\\n-\\t\\tfor(int j=0;j<n;j++) \\n-\\t\\t\\tscanf(\\\"%d\\\", &(matrix[i][j]));\\n-\\n-\\tassert(s<n);\\n-\\tassert(n<8000);\\n-\\tassert(s>0);\\n-\\tassert(n>0);\\n-\\n-\\tint sum = 0;\\n-\\tfor(int i=0;i<s;i++)\\n-\\t\\tfor(int j=0;j<s;j++)\\n-\\t\\t\\tsum += matrix[i][j];\\n-\\n-\\tint mxSum = sum;\\n-\\n-\\tint dir = 1;\\n-\\tint i = 0;\\n-\\tint j = 0;\\n-\\twhile(i+s <= n) {\\n-\\t\\tif( (j+s == n && dir==1) || (j==0 && dir==-1) ) { \\n-\\t\\t\\tint exitingRow = i;\\n-\\t\\t\\tint enteringRow = exitingRow+s;\\n-\\t\\t\\tif(enteringRow >=n) break;\\n-\\n-\\t\\t\\tfor(int k=0;k<s;k++) { sum -= matrix[exitingRow][k+j]; } \\n-\\t\\t\\tfor(int k=0;k<s;k++) { sum += matrix[enteringRow][k+j];\\t} \\n-\\t\\t\\t\\n-\\t\\t\\ti++;\\n-\\t\\t\\tdir*=-1;\\n-\\t\\t} else {\\n-\\t\\t\\tint exitingCol,enteringCol;\\n-\\t\\t\\tif(dir==1) {\\n-\\t\\t\\t\\texitingCol = j;\\n-\\t\\t\\t\\tenteringCol = exitingCol + s;\\n-\\t\\t\\t} else {\\n-\\t\\t\\t\\tenteringCol = j-1;\\n-\\t\\t\\t\\texitingCol = enteringCol + s;\\n-\\t\\t\\t}\\n-\\n-\\t\\t\\tfor(int k=0;k<s;k++) {sum -= matrix[k+i][exitingCol]; } \\n-\\t\\t\\tfor(int k=0;k<s;k++) {sum += matrix[k+i][enteringCol];\\t} \\n-\\t\\t\\tj+=dir;\\n-\\t\\t}\\n-\\t\\tmxSum = std::max(mxSum,sum);\\n-\\t}\\n-\\tprintf(\\\"%d\\\\n\\\",mxSum);\\n-}\\n\\\\ No newline at end of file\\n+    int n, s;\\n+    if (std::scanf(\\\"%d %d\\\", &n, &s) != 2) return 0;\\n+\\n+    assert(n > 0 && n < 8000 && s > 0 && s < n);\\n+\\n+    // Keep only the S rows needed by the vertical sliding window.\\n+    std::vector<int> row_buffer(static_cast<std::size_t>(s) * n);\\n+    std::vector<long long> column_sums(n, 0);\\n+\\n+    for (int r = 0; r < s; ++r) {\\n+        int* row = row_buffer.data() + static_cast<std::size_t>(r) * n;\\n+        for (int c = 0; c < n; ++c) {\\n+            std::scanf(\\\"%d\\\", &row[c]);\\n+            column_sums[c] += row[c];\\n+        }\\n+    }\\n+\\n+    long long window_sum = 0;\\n+    for (int c = 0; c < s; ++c) window_sum += column_sums[c];\\n+    long long best = window_sum;\\n+\\n+    for (int left = 1; left + s <= n; ++left) {\\n+        window_sum += column_sums[left + s - 1] - column_sums[left - 1];\\n+        best = std::max(best, window_sum);\\n+    }\\n+\\n+    for (int top = 1; top + s <= n; ++top) {\\n+        const int slot = (top - 1) % s;\\n+        int* row = row_buffer.data() + static_cast<std::size_t>(slot) * n;\\n+        for (int c = 0; c < n; ++c) {\\n+            int value;\\n+            std::scanf(\\\"%d\\\", &value);\\n+            column_sums[c] += static_cast<long long>(value) - row[c];\\n+            row[c] = value;\\n+        }\\n+\\n+        window_sum = 0;\\n+        for (int c = 0; c < s; ++c) window_sum += column_sums[c];\\n+        best = std::max(best, window_sum);\\n+        for (int left = 1; left + s <= n; ++left) {\\n+            window_sum += column_sums[left + s - 1] - column_sums[left - 1];\\n+            best = std::max(best, window_sum);\\n+        }\\n+    }\\n+\\n+    std::printf(\\\"%lld\\\\n\\\", best);\\n+    return 0;\\n+}\"}, {\"id\": \"3d696cf87ec64628\", \"role\": \"C\", \"commit\": \"0a45cc5cc9ef916012c287ab90496e0d825da4a4\", \"transformations\": {\"files\": [\"src/solution.cpp\"], \"retained\": [\"Replace serpentine window traversal with rolling vertical sums and horizontal scans over four independent column chunks.\", \"Use OpenMP static scheduling and a maximum reduction, with a threshold for parallel execution.\", \"Use a direct parallel maximum scan for S=1 and 64-bit intermediates for all submatrix sums.\"]}, \"mean_seconds\": 0.05533133943875631, \"diff\": \"diff --git a/s
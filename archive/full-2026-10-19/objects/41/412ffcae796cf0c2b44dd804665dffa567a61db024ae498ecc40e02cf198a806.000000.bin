        "content": "#include <iostream>\n#include <vector>\n#include <atomic>\n#include <memory>\n#include <thread>\n#include <algorithm>\n#include <omp.h>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n    vector<vector<bool>> blockedCells(n, vector<bool>(n, false));\n    for (int c = 0; c < m; ++c) {\n        int i, j;\n        cin >> i >> j;\n        blockedCells[i][j] = true;\n    }\n\n    vector<int> dp(n, 0);\n    dp[0] = 1;\n    int requested = min(omp_get_max_threads(), max(1, n / 256));\n    if (requested == 1) {\n        for (int i = 0; i < n; ++i) {\n            int left = 0;\n            for (int j = 0; j < n; ++j) {\n                int value = dp[j] + left;\n                if (value >= MOD) value -= MOD;\n                if (blockedCells[i][j]) value = 0;\n                dp[j] = left = value;\n            }\n        }\n    } else {\n        // Each column strip publishes immutable right-edge values in row batches.\n        vector<vector<int>> edges(requested, vector<int>(n));\n        struct alignas(64) Progress {\n            atomic<int> rows;\n            Progress() : rows(0) {}\n        };\n        unique_ptr<Progress[]> progress(new Progress[requested]);\n        #pragma omp parallel num_threads(requested)\n        {\n            const int tid = omp_get_thread_num();\n            const int team = omp_get_num_threads();\n            const int begin = static_cast<int>(static_cast<long long>(n) * tid / team);\n            const int end = static_cast<int>(static_cast<long long>(n) * (tid + 1) / team);\n            const int batch = 16;\n            for (int first = 0; first < n; first += batch) {\n                const int last = min(n, first + batch);\n                if (tid != 0) {\n                    while (progress[tid - 1].rows.load(memory_order_acquire) < last)\n                        this_thread::yield();\n                }\n                for (int i = first; i < last; ++i) {\n                    int left = tid == 0 ? 0 : edges[tid - 1][i];\n                    for (int j = begin; j < end; ++j) {\n                        int value = dp[j] + left;\n                        if (value >= MOD) value -= MOD;\n                        if (blockedCells[i][j]) value = 0;\n                        dp[j] = left = value;\n                    }\n                    edges[tid][i] = left;\n                }\n                progress[tid].rows.store(last, memory_order_release);\n            }\n        }\n    }\n    cout << dp[n - 1] << '\\n';\n}\n",
        "path": "src/solution.cpp"
      }
    ],
    "hypothesis": "A pipelined column-strip OpenMP decomposition can reduce synchronization overhead relative to row-wide barriers while retaining exact grid DP.",

"""Seal received mechanical evidence without any remote action or executable candidate."""
from __future__ import annotations

import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def ref(path):
    return {"path": str(path), "sha256": sha(path)}


def save(name, value):
    with (ROOT / name).open("x", encoding="utf8", newline="\n") as stream:
        stream.write(json.dumps(value, ensure_ascii=False, indent=2) + "\n")
    return ref(ROOT / name)


def inventory(path):
    values = {}
    for member in sorted(path.rglob("*")):
        if member.is_symlink():
            raise RuntimeError("Linked received data refused")
        if member.is_file():
            values[member.relative_to(path).as_posix()] = sha(member)
    return values


native = json.loads((ROOT / "verification-relecture-native.json").read_text(encoding="utf8"))
if native.get("verified") is not True or native.get("native_verify_reception_passed") is not True:
    raise RuntimeError("Actual native mechanical receipt is missing")
pins = {"qualification.json": "298fee9af787299dd22783c2f8a6c590d672424b53e4359008558979c822f28a",
    "qualification.tar.gz": "c16e528606590b879d281158d8aa1136efed17d2c609c34024a7853c79cf1242",
    "audit-natif.json": "9afa3d7996d7bb3926a3fbdcf4bad5f4c2bff575bdf981b71790ebd8ac97e930",
    "reception-contrat.json": "ed144bbf0f0890ce216825fdc10ec510fcf8f34cbcf0c61eca44093648c00c77",
    "envelope-results-752128.tar.gz": "4f8db76788d3cb3a46636cd71370462bd8d54ac6e2570d64234482c30d991df1"}
if any(sha(ROOT / name) != expected for name, expected in pins.items()):
    raise RuntimeError("A received original proof changed")
initial = json.loads((ROOT / "inventaire-avant-audit.json").read_text(encoding="utf8"))
final_before = json.loads((ROOT / "inventaire-avant-audit-r2.json").read_text(encoding="utf8"))
final_after = json.loads((ROOT / "inventaire-apres-audit-r2.json").read_text(encoding="utf8"))
if not initial == final_before == final_after == inventory(ROOT / "restauration-neuve") == inventory(ROOT / "restauration-neuve-r2"):
    raise RuntimeError("One of the two fresh restorations changed")
source_before = json.loads((ROOT / "sources-locales-avant-audit.json").read_text(encoding="utf8"))
if not source_before == json.loads((ROOT / "sources-locales-avant-audit-r2.json").read_text(encoding="utf8")) == json.loads((ROOT / "sources-locales-apres-audit-r2.json").read_text(encoding="utf8")):
    raise RuntimeError("Source bytes changed between native readers")
if "All checks passed!" not in (ROOT / "ruff-scellement.log").read_text(encoding="utf8"):
    raise RuntimeError("Read-only helper Ruff proof absent")
save("integrite-deux-restaurations.json", {"verified": True, "restored_files_per_copy": len(initial),
    "restoration_count": 2, "both_fresh_restorations_unchanged": True,
    "source_files_unchanged": len(source_before), "initial_reader_refusal_preserved": True,
    "cluster_job_replayed": False, "native_model_calls": 0})
save("reception-verifiee.json", {"schema": "hpc-forest-r2c-mechanical-reception-complete-v1",
    "verified": True, "verification_scope": "Mechanical official-C qualification only, no native model research",
    "job_id": "752128", "source_zip_sha256": "ade344bfec4322e8aaecc99cfbf7bd502e6d39b55c62180e8f552a3d6391e680",
    "plan_sha256": "bac579fdb44850c636a6522c014175f95d4ce867bab502d86dd15c1bff31032e",
    "qualification": ref(ROOT / "qualification.json"), "qualification_archive": ref(ROOT / "qualification.tar.gz"),
    "audit": ref(ROOT / "audit-natif.json"), "compatible_reception": ref(ROOT / "reception-contrat.json"),
    "native_reception_check": ref(ROOT / "verification-relecture-native.json"),
    "all_three_envelope_sha256_equal": True, "restored_files_per_copy": len(initial),
    "source_files_verified": 103, "qualification_archive_members": 291, "distinct_certified_cases": 12,
    "evaluator_execution_records": 14, "case_execution_records": 13,
    "external_python_gcc_executable_bytes_independently_verified": False,
    "native_model_calls": 0, "native_first_start_proved": False, "native_research_admitted": False,
    "performance_research_result": False, "first_local_reader_refusal": ref(ROOT / "audit-refus-initial.json"),
    "isolated_reader_correction": ref(ROOT / "correction-lecteur-r2.json"),
    "no_cluster_job_replay_or_stop": True})
files = {path.relative_to(ROOT).as_posix(): sha(path) for path in sorted(ROOT.rglob("*")) if path.is_file()}
save("manifeste-reception.json", {"schema": "hpc-forest-r2c-mechanical-reception-manifest-v1", "files": files,
    "read_only_audit_complete": True, "native_model_calls": 0})
delivery = save("LIVRAISON-RECEPTION.json", {"schema": "hpc-forest-r2c-mechanical-reception-delivery-v1",
    "verified_received_mechanical_only": True, "job_id": "752128",
    "receipt": ref(ROOT / "reception-verifiee.json"), "manifest": ref(ROOT / "manifeste-reception.json"),
    "qualification": ref(ROOT / "qualification.json"), "qualification_archive": ref(ROOT / "qualification.tar.gz"),
    "audit": ref(ROOT / "audit-natif.json"), "compatible_reception": ref(ROOT / "reception-contrat.json"),
    "native_model_calls": 0, "native_first_start_proved": False, "native_research_admitted": False,
    "no_replay": True, "no_owned_or_foreign_process_stopped": True})
print(json.dumps({"delivery": delivery, "receipt": ref(ROOT / "reception-verifiee.json"),
    "manifest": ref(ROOT / "manifeste-reception.json")}, indent=2))

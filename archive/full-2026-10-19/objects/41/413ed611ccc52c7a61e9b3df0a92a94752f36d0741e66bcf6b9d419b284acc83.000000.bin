{"files":[{"content":"#include \"knn.h\"\n#include <math.h>\n\ntypedef struct {\n    size_t order;\n    float distance;\n    char label;\n} Neighbor;\n\nstatic int neighbor_is_worse(const Neighbor *a, const Neighbor *b) {\n    if (a->distance > b->distance) return 1;\n    if (a->distance < b->distance) return 0;\n    return a->order > b->order;\n}\n\nstatic void sift_down(Neighbor *heap, size_t heap_size, size_t parent) {\n    for (;;) {\n        size_t child = parent * 2 + 1;\n        if (child >= heap_size) break;\n        if (child + 1 < heap_size && neighbor_is_worse(&heap[child + 1], &heap[child])) {\n            child++;\n        }\n        if (!neighbor_is_worse(&heap[child], &heap[parent])) break;\n\n        Neighbor temporary = heap[parent];\n        heap[parent] = heap[child];\n        heap[child] = temporary;\n        parent = child;\n    }\n}\n\nstatic char classify_labels(char *labels, int k) {\n    qsort(labels, (size_t)k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nstatic char serial_knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *)malloc(sizeof(char) * (size_t)k);\n    float *distances = (float *)malloc(sizeof(float) * (size_t)k);\n\n    for (int i = 0; i < k; i++) {\n        labels[i] = (char)-1;\n        distances[i] = -1;\n    }\n\n    for (int i = 0; i < n_groups; i++) {\n        const Group *group = &groups[i];\n        for (int j = 0; j < group->length; j++) {\n            float distance = euclidean_distance_no_sqrt(to_evaluate, group->points[j]);\n            for (int x = 0; x < k; x++) {\n                if (distance < distances[x] || distances[x] == -1) {\n                    for (int y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = distance;\n                    labels[x] = group->label;\n                    break;\n                }\n            }\n        }\n    }\n\n    char result = classify_labels(labels, k);\n    free(distances);\n    free(labels);\n    return result;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    size_t limit = (size_t)k;\n    char *labels = (char *)malloc(sizeof(char) * limit);\n    Neighbor *heap = (Neighbor *)malloc(sizeof(Neighbor) * limit);\n    size_t heap_size = 0;\n    size_t order = 0;\n\n    for (int i = 0; i < k; i++) labels[i] = (char)-1;\n\n    for (int i = 0; i < n_groups; i++) {\n        const Group *group = &groups[i];\n\n        for (int j = 0; j < group->length; j++) {\n            Neighbor candidate;\n            candidate.distance = euclidean_distance_no_sqrt(to_evaluate, group->points[j]);\n            candidate.order = order++;\n            candidate.label = group->label;\n\n            if (isnan(candidate.distance)) {\n                free(heap);\n                free(labels);\n                return serial_knn(n_groups, groups, k, to_evaluate);\n            }\n\n            if (heap_size < limit) {\n                size_t position = heap_size++;\n                heap[position] = candidate;\n\n                while (position > 0) {\n                    size_t parent = (position - 1) / 2;\n                    if (!neighbor_is_worse(&heap[position], &heap[parent])) break;\n                    Neighbor temporary = heap[position];\n                    heap[position] = heap[parent];\n                    heap[parent] = temporary;\n                    position = parent;\n                }\n            } else if (neighbor_is_worse(&heap[0], &candidate)) {\n                heap[0] = candidate;\n                sift_down(heap, heap_size, 0);\n            }\n        }\n    }\n\n    for (size_t i = 0; i < heap_size; i++) labels[i] = heap[i].label;\n\n    char result = classify_labels(labels, k);\n    free(heap);\n    free(labels);\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    Group *groups = (Group *)malloc(sizeof(Group) * (size_t)n_groups);\n    Point *point_storage = NULL;\n    size_t point_count = 0;\n    size_t point_capacity = 0;\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group(&point_storage, &point_count, &point_capacity);\n    }\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i].points = point_storage == NULL ? NULL : point_storage + groups[i].offset;\n    }\n\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n\n    free(point_storage);\n    free(groups);\n    return 0;\n}\n","path":"src/knn.c"},{"content":"#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point *points;\n    size_t offset;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2) on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n    return point;\n}\n\nGroup parse_next_group(Point **point_storage, size_t *point_count, size_t *point_capacity) {\n    char label;\n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n    if (length < 0) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = NULL;\n    group.offset = *point_count;\n\n    size_t additional = (size_t)length;\n    size_t size_max = (size_t)-1;\n    if (additional > size_max - *point_count) on_error();\n    size_t needed = *point_count + additional;\n\n    if (needed > *point_capacity) {\n        size_t new_capacity = *point_capacity == 0 ? 64 : *point_capacity;\n        while (new_capacity < needed) {\n            if (new_capacity > size_max / 2) {\n                new_capacity = needed;\n                break;\n            }\n            new_capacity *= 2;\n        }\n        if (new_capacity > size_max / sizeof(Point)) on_error();\n\n        Point *grown = (Point *)realloc(*point_storage, sizeof(Point) * new_capacity);\n        if (grown == NULL) on_error();\n        *point_storage = grown;\n        *point_capacity = new_capacity;\n    }\n\n    for (int i = 0; i < length; i++) {\n        (*point_storage)[(*point_count)++] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt(Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n    return *(char *)a - *(char *)b;\n}\n","path":"src/knn.h"}],"hypothesis":"Combining the measured top-k heap approach with a shared geometrically grown point arena may reduce both candidate maintenance and per-group allocation overhead while preserving encounter-order ties and the existing vote behavior.","notes":"This is an unmeasured integration candidate; the controller should evaluate the complete program for correctness and speed.","research":{"queries":[],"urls":[]},"sources_kept":["8b22dace973f4eea","4eb62c07382d4ef6"],"transformations":["Replace sorted-array candidate insertion with a contiguous max-heap ordered by distance and encounter order; retain the sequential selection fallback when a distance is NaN.","Replace one allocation per group with a shared geometrically grown Point arena, recording group offsets and assigning pointers after parsing is complete.","Preserve missing-label placeholders, label sorting, vote tie behavior, and free temporary candidate storage before returning."]}
      "content": "#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <cstring>\n#include <limits>\n#include <memory>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#define SUM_NEON 1\n#else\n#define SUM_NEON 0\n#endif\n\nnamespace {\n\nclass Input {\n    unsigned char buffer_[65536];\n    std::size_t position_ = 0;\n    std::size_t available_ = 0;\n\n    int next() {\n        if (position_ == available_) {\n            available_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (available_ == 0) return EOF;\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    bool read(std::uint32_t& value) {\n        int c;\n        do {\n            c = next();\n            if (c == EOF) return false;\n        } while (c <= ' ');\n        const bool negative = c == '-';\n        if (negative || c == '+') c = next();\n        std::uint32_t magnitude = 0;\n        while (c >= '0' && c <= '9') {\n            magnitude = magnitude * 10u + static_cast<std::uint32_t>(c - '0');\n            c = next();\n        }\n        value = negative ? 0u - magnitude : magnitude;\n        return true;\n    }\n};\n\nstruct Maximum {\n    std::int32_t scalar = std::numeric_limits<std::int32_t>::min();\n#if SUM_NEON\n    int32x4_t vector0 = vdupq_n_s32(std::numeric_limits<std::int32_t>::min());\n    int32x4_t vector1 = vdupq_n_s32(std::numeric_limits<std::int32_t>::min());\n\n    void include4(uint32x4_t value) {\n        vector0 = vmaxq_s32(vector0, vreinterpretq_s32_u32(value));\n    }\n\n    void include8(uint32x4_t value0, uint32x4_t value1) {\n        vector0 = vmaxq_s32(vector0, vreinterpretq_s32_u32(value0));\n        vector1 = vmaxq_s32(vector1, vreinterpretq_s32_u32(value1));\n    }\n#endif\n\n    void include(std::uint32_t bits) {\n        std::int32_t value;\n        std::memcpy(&value, &bits, sizeof(value));\n        if (value > scalar) scalar = value;\n    }\n\n    std::int32_t result() const {\n        std::int32_t answer = scalar;\n#if SUM_NEON\n        const std::int32_t value = vmaxvq_s32(vmaxq_s32(vector0, vector1));\n        if (value > answer) answer = value;\n#endif\n        return answer;\n    }\n};\n\nstd::uint32_t first_window(const std::uint32_t* row, int s) {\n    std::uint32_t sum = 0;\n    int k = 0;\n#if SUM_NEON\n    uint32x4_t sum0 = vdupq_n_u32(0);\n    uint32x4_t sum1 = vdupq_n_u32(0);\n    for (; k + 8 <= s; k += 8) {\n        sum0 = vaddq_u32(sum0, vld1q_u32(row + k));\n        sum1 = vaddq_u32(sum1, vld1q_u32(row + k + 4));\n    }\n    if (k + 4 <= s) {\n        sum0 = vaddq_u32(sum0, vld1q_u32(row + k));\n        k += 4;\n    }\n    sum = vaddvq_u32(vaddq_u32(sum0, sum1));\n#endif\n    for (; k < s; ++k) sum += row[k];\n    return sum;\n}\n\n#if SUM_NEON\ninline uint32x4_t prefix4(uint32x4_t delta) {\n    const uint32x4_t zero = vdupq_n_u32(0);\n    delta = vaddq_u32(delta, vextq_u32(zero, delta, 3));\n    return vaddq_u32(delta, vextq_u32(zero, delta, 2));\n}\n\ntemplate<bool Rolling>\ninline uint32x4_t accumulate4(uint32x4_t windows,\n                             std::uint32_t* saved,\n                             std::uint32_t* vertical) {\n    uint32x4_t total = vaddq_u32(vld1q_u32(vertical), windows);\n    if (Rolling) total = vsubq_u32(total, vld1q_u32(saved));\n    vst1q_u32(saved, windows);\n    vst1q_u32(vertical, total);\n    return total;\n}\n#endif\n\ntemplate<bool Rolling, bool Observe>\ninline void accumulate_one(std::uint32_t window,\n                           std::uint32_t* saved,\n                           std::uint32_t* vertical,\n                           Maximum& maximum) {\n    std::uint32_t total = *vertical + window;\n    if (Rolling) total -= *saved;\n    *saved = window;\n    *vertical = total;\n    if (Observe) maximum.include(total);\n}\n\ntemplate<bool Rolling, bool Observe>\nvoid consume_row(const std::uint32_t* row,\n                 std::uint32_t* saved,\n                 std::uint32_t* vertical,\n                 int s, int width, Maximum& maximum) {\n    std::uint32_t current = first_window(row, s);\n    accumulate_one<Rolling, Observe>(current, saved, vertical, maximum);\n    int j = 1;\n#if SUM_NEON\n    uint32x4_t carry = vdupq_n_u32(current);\n    for (; j + 8 <= width; j += 8) {\n        const uint32x4_t delta0 = vsubq_u32(\n            vld1q_u32(row + j + s - 1), vld1q_u32(row + j - 1));\n        const uint32x4_t delta1 = vsubq_u32(\n            vld1q_u32(row + j + s + 3), vld1q_u32(row + j + 3));\n        const uint32x4_t prefix0 = prefix4(delta0);\n        const uint32x4_t prefix1 = vaddq_u32(\n            prefix4(delta1), vdupq_laneq_u32(prefix0, 3));\n        const uint32x4_t windows0 = vaddq_u32(carry, prefix0);\n        const uint32x4_t windows1 = vaddq_u32(carry, prefix1);\n        carry = vdupq_laneq_u32(windows1, 3);\n        const uint32x4_t total0 = accumulate4<Rolling>(\n            windows0, saved + j, vertical + j);\n        const uint32x4_t total1 = accumulate4<Rolling>(\n            windows1, saved + j + 4, vertical + j + 4);\n        if (Observe) maximum.include8(total0, total1);\n    }\n    if (j + 4 <= width) {\n        const uint32x4_t delta = vsubq_u32(\n            vld1q_u32(row + j + s - 1), vld1q_u32(row + j - 1));\n        const uint32x4_t windows = vaddq_u32(carry, prefix4(delta));\n        carry = vdupq_laneq_u32(windows, 3);\n        const uint32x4_t total = accumulate4<Rolling>(\n            windows, saved + j, vertical + j);\n        if (Observe) maximum.include4(total);\n        j += 4;\n    }\n    current = vgetq_lane_u32(carry, 0);\n#endif\n    for (; j < width; ++j) {\n        current += row[j + s - 1] - row[j - 1];\n        accumulate_one<Rolling, Observe>(\n            current, saved + j, vertical + j, maximum);\n    }\n}\n\n}\n\nint main() {\n    Input input;\n    std::uint32_t n_bits, s_bits;\n    if (!input.read(n_bits) || !input.read(s_bits)) return 0;\n    const int n = static_cast<int>(n_bits);\n    const int s = static_cast<int>(s_bits);\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const int width = n - s + 1;\n    const std::size_t history_size =\n        static_cast<std::size_t>(s) * static_cast<std::size_t>(width);\n    std::unique_ptr<std::uint32_t[]> row(new std::uint32_t[n]);\n    std::unique_ptr<std::uint32_t[]> history(new std::uint32_t[history_size]);\n    std::unique_ptr<std::uint32_t[]> vertical(new std::uint32_t[width]());\n    Maximum maximum;\n    int slot = 0;\n\n    for (int r = 0; r < n; ++r) {\n        for (int c = 0; c < n; ++c) {\n            if (!input.read(row[c])) return 0;\n        }\n        std::uint32_t* saved = history.get() +\n            static_cast<std::size_t>(slot) * static_cast<std::size_t>(width);\n        if (r < s - 1) {\n            consume_row<false, false>(\n                row.get(), saved, vertical.get(), s, width, maximum);\n        } else if (r == s - 1) {\n            consume_row<false, true>(\n                row.get(), saved, vertical.get(), s, width, maximum);\n        } else {\n            consume_row<true, true>(\n                row.get(), saved, vertical.get(), s, width, maximum);\n        }\n        if (++slot == s) slot = 0;\n    }\n\n    std::printf(\"%d\\n\", static_cast<int>(maximum.result()));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

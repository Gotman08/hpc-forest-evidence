#define _POSIX_C_SOURCE 200112L
#include "knn.h"
#include <omp.h>

typedef struct {
    float d;
    long idx;
    char label;
} Cand;

static inline int worse_cand(const Cand *a, const Cand *b) {
    if (a->d != b->d) return a->d > b->d;
    return a->idx > b->idx;
}

static inline void swap_cand(Cand *a, Cand *b) {
    Cand t = *a; *a = *b; *b = t;
}

static inline void heap_push(Cand *h, int *n, float d, long idx, char label) {
    int i = (*n)++;
    h[i].d = d;
    h[i].idx = idx;
    h[i].label = label;
    while (i > 0) {
        int p = (i - 1) / 2;
        if (worse_cand(&h[i], &h[p])) {
            swap_cand(&h[i], &h[p]);
            i = p;
        } else break;
    }
}

static inline void heap_replace_root(Cand *h, int n, float d, long idx, char label) {
    h[0].d = d;
    h[0].idx = idx;
    h[0].label = label;
    int i = 0;
    for (;;) {
        int l = 2 * i + 1;
        if (l >= n) break;
        int r = l + 1;
        int worst = i;
        if (worse_cand(&h[l], &h[worst])) worst = l;
        if (r < n && worse_cand(&h[r], &h[worst])) worst = r;
        if (worst == i) break;
        swap_cand(&h[i], &h[worst]);
        i = worst;
    }
}

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    if (k <= 0) return -1;

    long total = 0;
    for (int gi = 0; gi < n_groups; ++gi) total += groups[gi].length;

    size_t cap = total > 0 ? (size_t)total : 1;
    char *flat_labels = (char *) malloc(cap);
    float *xs = NULL, *ys = NULL, *dists = NULL;
    if (posix_memalign((void **)&xs, 64, cap * sizeof(float)) != 0) on_error();
    if (posix_memalign((void **)&ys, 64, cap * sizeof(float)) != 0) on_error();

    long idx = 0;
    for (int gi = 0; gi < n_groups; ++gi) {
        Group g = groups[gi];
        char lab = g.label;
        for (int j = 0; j < g.length; ++j) {
            flat_labels[idx] = lab;
            xs[idx] = g.points[j].x;
            ys[idx] = g.points[j].y;
            ++idx;
        }
    }

    if (posix_memalign((void **)&dists, 64, cap * sizeof(float)) != 0) on_error();

    float tx = to_evaluate.x;
    float ty = to_evaluate.y;

#pragma omp parallel for simd schedule(static) aligned(xs, ys, dists: 64)
    for (long i = 0; i < total; ++i) {
        float dx = xs[i] - tx;
        float dy = ys[i] - ty;
        dists[i] = dx * dx + dy * dy;
    }

    int nt = omp_get_max_threads();
    if (nt < 1) nt = 1;
    Cand **thread_heaps = (Cand **) calloc(nt, sizeof(Cand *));
    int *counts = (int *) calloc(nt, sizeof(int));

#pragma omp parallel
    {
        int tid = omp_get_thread_num();
        Cand *local = (Cand *) malloc(sizeof(Cand) * k);
        if (!local) on_error();
        int cnt = 0;

#pragma omp for schedule(static)
        for (long i = 0; i < total; ++i) {
            float d = dists[i];
            Cand c;
            c.d = d;
            c.idx = i;
            c.label = flat_labels[i];

            if (cnt < k) {
                heap_push(local, &cnt, d, i, flat_labels[i]);
            } else if (!worse_cand(&c, &local[0])) {
                heap_replace_root(local, k, d, i, flat_labels[i]);
            }
        }

        thread_heaps[tid] = local;
        counts[tid] = cnt;
    }

    long total_cands = 0;
    for (int t = 0; t < nt; ++t) total_cands += counts[t];

    Cand *all = NULL;
    if (total_cands > 0) all = (Cand *) malloc(sizeof(Cand) * total_cands);
    long pos = 0;
    for (int t = 0; t < nt; ++t) {
        for (int j = 0; j < counts[t]; ++j) {
            all[pos++] = thread_heaps[t][j];
        }
        free(thread_heaps[t]);
    }
    free(thread_heaps);
    free(counts);

    Cand *final_heap = (Cand *) malloc(sizeof(Cand) * k);
    int fn = 0;
    for (long i = 0; i < total_cands; ++i) {
        Cand c = all[i];
        if (fn < k) {
            heap_push(final_heap, &fn, c.d, c.idx, c.label);
        } else if (!worse_cand(&c, &final_heap[0])) {
            heap_replace_root(final_heap, k, c.d, c.idx, c.label);
        }
    }
    free(all);

    char *labels = (char *) malloc(k);
    for (int i = 0; i < k; ++i) labels[i] = -1;
    for (int i = 0; i < fn && i < k; ++i) labels[i] = final_heap[i].label;
    free(final_heap);

    qsort(labels, k, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (int i = 1; i < k; ++i) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }
            current_frequency = 1;
        } else {
            ++current_frequency;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    free(labels);
    free(flat_labels);
    free(xs);
    free(ys);
    free(dists);

    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

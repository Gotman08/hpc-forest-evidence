        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdint.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n#define FORCE_PANEL 32\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nstatic void body_force_direct(Body *p, float dt, int n) {\n  #pragma omp parallel for schedule(static) if(n >= 64)\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Share off-diagonal inverse distances between both directions of a pair.\n * Every body's force terms are still accumulated in increasing source order.\n */\nvoid body_force(Body *p, float dt, int n) {\n  if (n < 2 * FORCE_PANEL) {\n    body_force_direct(p, dt, n);\n    return;\n  }\n\n  for (int i = 0; i < n; ++i) {\n    if (!isfinite(p[i].x) || !isfinite(p[i].y) || !isfinite(p[i].z)) {\n      body_force_direct(p, dt, n);\n      return;\n    }\n  }\n\n  const size_t count = (size_t)n;\n  if (count > SIZE_MAX / sizeof(float) / (FORCE_PANEL + 3)) {\n    body_force_direct(p, dt, n);\n    return;\n  }\n\n  float *scratch = (float *)malloc(count * (FORCE_PANEL + 3) * sizeof(float));\n  if (scratch == NULL) {\n    body_force_direct(p, dt, n);\n    return;\n  }\n  float *force_x = scratch;\n  float *force_y = force_x + count;\n  float *force_z = force_y + count;\n  float *inverse_cube = force_z + count;\n\n  #pragma omp parallel\n  {\n    #pragma omp for schedule(static)\n    for (int i = 0; i < n; ++i) {\n      force_x[i] = 0.0f;\n      force_y[i] = 0.0f;\n      force_z[i] = 0.0f;\n    }\n\n    int base = 0;\n    while (base < n) {\n      int width = n - base;\n      if (width > FORCE_PANEL) width = FORCE_PANEL;\n      const int end = base + width;\n\n      /* Append this panel's lower-index terms to future target bodies. */\n      #pragma omp for schedule(static)\n      for (int i = end; i < n; ++i) {\n        const float xi = p[i].x;\n        const float yi = p[i].y;\n        const float zi = p[i].z;\n        float fx = force_x[i];\n        float fy = force_y[i];\n        float fz = force_z[i];\n\n        for (int s = base; s < end; ++s) {\n          float dx = p[s].x - xi;\n          float dy = p[s].y - yi;\n          float dz = p[s].z - zi;\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          float inv_dist = 1 / sqrt(sqrd_dist);\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\n          inverse_cube[(size_t)(s - base) * count + (size_t)i] = inv_dist3;\n\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n        }\n\n        force_x[i] = fx;\n        force_y[i] = fy;\n        force_z[i] = fz;\n      }\n\n      /* Finish active bodies using their ordered diagonal and upper terms. */\n      #pragma omp for schedule(static)\n      for (int s = base; s < end; ++s) {\n        const float xi = p[s].x;\n        const float yi = p[s].y;\n        const float zi = p[s].z;\n        float fx = force_x[s];\n        float fy = force_y[s];\n        float fz = force_z[s];\n\n        for (int j = base; j < end; ++j) {\n          float dx = p[j].x - xi;\n          float dy = p[j].y - yi;\n          float dz = p[j].z - zi;\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          float inv_dist = 1 / sqrt(sqrd_dist);\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n        }\n\n        const float *cached = inverse_cube + (size_t)(s - base) * count;\n        for (int j = end; j < n; ++j) {\n          float dx = p[j].x - xi;\n          float dy = p[j].y - yi;\n          float dz = p[j].z - zi;\n          float inv_dist3 = cached[j];\n\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n        }\n\n        p[s].vx += dt*fx;\n        p[s].vy += dt*fy;\n        p[s].vz += dt*fz;\n      }\n\n      base = end;\n    }\n  }\n\n  free(scratch);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    #pragma omp parallel for schedule(static) if(nbodies >= 64)\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",

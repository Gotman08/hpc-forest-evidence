      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdio>\n#include <limits>\n#include <memory>\n#include <vector>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nclass FastInput {\n    unsigned char buffer[65536];\n    std::size_t position = 0;\n    std::size_t length = 0;\n\n    int next() {\n        if (position == length) {\n            length = std::fread(buffer, 1, sizeof(buffer), stdin);\n            position = 0;\n            if (length == 0) return EOF;\n        }\n        return buffer[position++];\n    }\n\npublic:\n    bool read_int(int& result) {\n        int c = next();\n        while (c <= ' ') {\n            if (c == EOF) return false;\n            c = next();\n        }\n        const bool negative = c == '-';\n        if (negative || c == '+') c = next();\n        unsigned int value = 0;\n        while (c >= '0' && c <= '9') {\n            value = value * 10u + static_cast<unsigned int>(c - '0');\n            c = next();\n        }\n        result = negative\n            ? static_cast<int>(-static_cast<long long>(value))\n            : static_cast<int>(value);\n        return true;\n    }\n};\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.read_int(n) || !input.read_int(s)) return 0;\n    assert(n > 0 && n < 8000 && s > 0 && s < n);\n\n    const int positions = n - s + 1;\n    int workers = 1;\n#ifdef _OPENMP\n    workers = omp_get_max_threads();\n#endif\n    const int bands = std::min(positions, workers);\n    constexpr int block_rows = 64;\n    const int block_count = (n + block_rows - 1) / block_rows;\n\n    long long saved_rows = 0;\n    for (int band = 0; band < bands; ++band) {\n        const int begin = band * positions / bands;\n        const int first_full = (begin + block_rows - 1) / block_rows;\n        const int end_full = (begin + s) / block_rows;\n        const int full_blocks = std::max(0, end_full - first_full);\n        saved_rows += static_cast<long long>(full_blocks) * (block_rows - 1);\n    }\n    const bool use_summaries = saved_rows > n;\n\n    std::unique_ptr<int[]> storage(new int[static_cast<std::size_t>(n) * n]);\n    int* const matrix = storage.get();\n    std::unique_ptr<long long[]> summary_storage;\n    if (use_summaries) {\n        summary_storage.reset(new long long[static_cast<std::size_t>(block_count) * n]);\n    }\n    long long* const summaries = summary_storage.get();\n    long long answer = std::numeric_limits<long long>::lowest();\n\n    #pragma omp parallel reduction(max:answer)\n    {\n        #pragma omp single\n        {\n            for (int block = 0; block < block_count; ++block) {\n                const int row_begin = block * block_rows;\n                const int row_end = std::min(n, row_begin + block_rows);\n                for (int row = row_begin; row < row_end; ++row) {\n                    int* const destination = matrix + static_cast<std::size_t>(row) * n;\n                    for (int col = 0; col < n; ++col) {\n                        input.read_int(destination[col]);\n                    }\n                }\n                if (use_summaries) {\n                    #pragma omp task firstprivate(block, row_begin, row_end)\n                    {\n                        long long* const destination = summaries + static_cast<std::size_t>(block) * n;\n                        std::fill(destination, destination + n, 0LL);\n                        for (int row = row_begin; row < row_end; ++row) {\n                            const int* const source = matrix + static_cast<std::size_t>(row) * n;\n                            #pragma omp simd\n                            for (int col = 0; col < n; ++col) {\n                                destination[col] += source[col];\n                            }\n                        }\n                    }\n                }\n            }\n            #pragma omp taskwait\n        }\n\n        #pragma omp for schedule(static)\n        for (int band = 0; band < bands; ++band) {\n            const int begin = band * positions / bands;\n            const int end = (band + 1) * positions / bands;\n            std::vector<long long> columns(n, 0LL);\n            long long* const column = columns.data();\n\n            int row = begin;\n            const int initial_end = begin + s;\n            while (row < initial_end) {\n                if (use_summaries && row % block_rows == 0 && row + block_rows <= initial_end) {\n                    const long long* const source = summaries + static_cast<std::size_t>(row / block_rows) * n;\n                    #pragma omp simd\n                    for (int col = 0; col < n; ++col) {\n                        column[col] += source[col];\n                    }\n                    row += block_rows;\n                } else {\n                    const int* const source = matrix + static_cast<std::size_t>(row) * n;\n                    #pragma omp simd\n                    for (int col = 0; col < n; ++col) {\n                        column[col] += source[col];\n                    }\n                    ++row;\n                }\n            }\n\n            long long local_max = std::numeric_limits<long long>::lowest();\n            for (int top = begin; top < end; ++top) {\n                long long window = 0;\n                if (top == begin) {\n                    #pragma omp simd reduction(+:window)\n                    for (int col = 0; col < s; ++col) {\n                        window += column[col];\n                    }\n                } else {\n                    const int* const entering = matrix + static_cast<std::size_t>(top + s - 1) * n;\n                    const int* const leaving = matrix + static_cast<std::size_t>(top - 1) * n;\n                    #pragma omp simd reduction(+:window)\n                    for (int col = 0; col < s; ++col) {\n                        column[col] += static_cast<long long>(entering[col]) - leaving[col];\n                        window += column[col];\n                    }\n                    #pragma omp simd\n                    for (int col = s; col < n; ++col) {\n                        column[col] += static_cast<long long>(entering[col]) - leaving[col];\n                    }\n                }\n                local_max = std::max(local_max, window);\n                for (int left = 0; left < positions - 1; ++left) {\n                    window += column[left + s] - column[left];\n                    local_max = std::max(local_max, window);\n                }\n            }\n            answer = std::max(answer, local_max);\n        }\n    }\n\n    std::printf(\"%lld\\n\", answer);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

#include "knn.h"

#define BLOCK_SIZE 128

typedef struct {
    float distance;
    char label;
} DistanceLabel;

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    DistanceLabel * distances = (DistanceLabel *) malloc(sizeof(DistanceLabel) * k);

    for (int i = 0; i < k; i++) {
        distances[i].distance = -1;
        distances[i].label = -1;
    }

    for (int i = 0; i < n_groups; i++) {
        Group g = groups[i];
        int length = g.length;

        for (int block_start = 0; block_start < length; block_start += BLOCK_SIZE) {
            int block_end = block_start + BLOCK_SIZE;
            if (block_end > length) block_end = length;

            DistanceLabel * temp_distances = (DistanceLabel *) malloc(sizeof(DistanceLabel) * (block_end - block_start));

            for (int j = block_start, idx = 0; j < block_end; j++, idx++) {
                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);
                temp_distances[idx].distance = d;
                temp_distances[idx].label = g.label;
            }

            qsort(temp_distances, (block_end - block_start), sizeof(DistanceLabel), compare_for_sort);

            for (int idx = 0; idx < (block_end - block_start); idx++) {
                if (temp_distances[idx].distance > distances[k-1].distance) break;

                for (int y = k - 1; y > 0 && temp_distances[idx].distance < distances[y-1].distance; y--) {
                    distances[y] = distances[y-1];
                }

                distances[temp_distances[idx].distance <= distances[0].distance ? 0 : idx].distance = temp_distances[idx].distance;
                distances[temp_distances[idx].distance <= distances[0].distance ? 0 : idx].label = temp_distances[idx].label;
            }

            free(temp_distances);
        }
    }

    qsort(distances, k, sizeof(DistanceLabel), compare_for_sort);

    char most_frequent = distances[0].label;
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (int i = 1; i < k; i++) {
        if (distances[i].label != distances[i - 1].label) {
            if (current_frequency > most_frequent_count) {
                most_frequent = distances[i - 1].label;
                most_frequent_count = current_frequency;
            }

            current_frequency = 1;
        } else {
            current_frequency++;
        }
    }

    if (current_frequency > most_frequent_count) {
        most_frequent = distances[k - 1].label;
    }

    free(distances);
    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}
#include <cstdio>
#include <vector>
#include <climits>

static inline int nextInt() {
    static const int BUFSIZE = 1 << 20;
    static char buf[BUFSIZE];
    static int idx = 0, size = 0;
    int sign = 1;
    int x = 0;
    while (true) {
        if (idx >= size) {
            size = fread(buf, 1, BUFSIZE, stdin);
            idx = 0;
            if (size == 0) return -2147483648;
        }
        char c = buf[idx++];
        if (c >= '0' && c <= '9') {
            x = c - '0';
            while (true) {
                if (idx >= size) {
                    size = fread(buf, 1, BUFSIZE, stdin);
                    idx = 0;
                    if (size == 0) break;
                }
                c = buf[idx];
                if (c < '0' || c > '9') break;
                idx++;
                x = x * 10 + (c - '0');
            }
            return sign * x;
        } else if (c == '-') {
            sign = -1;
        }
    }
}

static inline long long maxWindow(const std::vector<long long>& arr, int len, int window) {
    long long cur = 0;
    for (int j = 0; j < window; ++j) cur += arr[j];
    long long mx = cur;
    for (int j = window; j < len; ++j) {
        cur += arr[j] - arr[j - window];
        if (cur > mx) mx = cur;
    }
    return mx;
}

int main() {
    int n = nextInt();
    int s = nextInt();

    std::vector<int> mat((size_t)n * n);
    for (int i = 0; i < n; ++i) {
        size_t rowBase = (size_t)i * n;
        for (int j = 0; j < n; ++j) {
            mat[rowBase + j] = nextInt();
        }
    }

    std::vector<long long> colSum(n, 0);
    for (int i = 0; i < s; ++i) {
        size_t rowBase = (size_t)i * n;
        for (int j = 0; j < n; ++j) {
            colSum[j] += mat[rowBase + j];
        }
    }

    long long best = maxWindow(colSum, n, s);

    for (int i = 1; i <= n - s; ++i) {
        size_t exitRowBase = (size_t)(i - 1) * n;
        size_t enterRowBase = (size_t)(i + s - 1) * n;
        for (int j = 0; j < n; ++j) {
            colSum[j] -= mat[exitRowBase + j];
            colSum[j] += mat[enterRowBase + j];
        }
        long long curBest = maxWindow(colSum, n, s);
        if (curBest > best) best = curBest;
    }

    printf("%d\n", (int)best);
    return 0;
}

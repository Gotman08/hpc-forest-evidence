#include<stdio.h>
#include<stdlib.h>
#include<math.h>

static void bubble_sort(double *matriz, int tam) {
    int i, j;
    double aux;

    for (i = tam - 1; i > 0; i--) {
        for (j = 0; j < i; j++) {
            if (matriz[j] > matriz[j + 1]) {
                aux = matriz[j];
                matriz[j] = matriz[j + 1];
                matriz[j + 1] = aux;
            }
        }
    }
}

static int compara_double(const void *esquerda, const void *direita) {
    double a = *(const double *)esquerda;
    double b = *(const double *)direita;

    return (a > b) - (a < b);
}

static int requer_bubble_sort(const double *matriz, int tam) {
    int i;
    int sinal_zero = 0;

    for (i = 0; i < tam; i++) {
        if (isnan(matriz[i])) {
            return 1;
        }
        if (matriz[i] == 0.0) {
            int sinal_atual = signbit(matriz[i]) ? 2 : 1;
            if (sinal_zero != 0 && sinal_zero != sinal_atual) {
                return 1;
            }
            sinal_zero = sinal_atual;
        }
    }
    return 0;
}

void ordena_colunas(double *matriz, int lin, int col) {
    int i;

    for (i = 0; i < col; i++) {
        double *coluna = matriz + i * lin;
        if (requer_bubble_sort(coluna, lin)) {
            bubble_sort(coluna, lin);
        } else {
            qsort(coluna, (size_t)lin, sizeof(*coluna), compara_double);
        }
    }
}

void calcula_medias(double *matriz, double *media, double *media_har, int lin, int col) {
    int i, j;

    for (i = 0; i < col; i++) {
        double soma = 0;
        double soma_harmonica = 0;
        double *coluna = matriz + i * lin;

        for (j = 0; j < lin; j++) {
            soma += coluna[j];
            soma_harmonica += 1 / coluna[j];
        }
        media[i] = soma / lin;
        media_har[i] = lin / soma_harmonica;
    }
}

void calcula_mediana(double *matriz, double *vet, int lin, int col) {
    int i = 0;
    if ((lin - 1) % 2) {
        for (i = 0; i < col; i++) {
            vet[i] = (matriz[(((i * lin) + (i + 1) * lin) - 1) / 2] + matriz[((((i * lin) + (i + 1) * lin) - 1) / 2) + 1]);
            vet[i] *= 0.5;
        }
    } else {
        for (i = 0; i < col; i++) {
            vet[i] = matriz[(((i * lin) + (i + 1) * lin) - 1) / 2];
        }
    }
}

double moda_aux(double *matriz, int lin) {
    int i = 0;
    float conta = 0;
    double moda = 0;

    while (i < lin) {
        int j = i + 1;
        double cont = 0;

        while (j < lin && matriz[i] == matriz[j]) {
            cont++;
            if (cont > conta) {
                conta = cont;
                moda = matriz[i];
            }
            j++;
        }
        i = j;
    }

    if (conta == 0) {
        return -1;
    }
    return moda;
}

void calcula_moda(double *matriz, double *moda, int lin, int col) {
    int i;
    for (i = 0; i < col; i++) {
        moda[i] = moda_aux(matriz + (i * lin), lin);
    }
}

void calcula_variancia(double *matriz, double *media, double *variancia, int lin, int col) {
    int i, j;
    double soma;
    for (i = 0; i < col; i++) {
        soma = 0;
        for (j = 0; j < lin; j++) {
            soma += pow((matriz[i * lin + j] - media[i]), 2);
        }
        variancia[i] = soma / (lin - 1);
    }
}

void calcula_desvio_padrao(double *variancia, double *dp, int col) {
    int i;
    for (i = 0; i < col; i++) {
        dp[i] = sqrt(variancia[i]);
    }
}

void calcula_coeficiente_variacao(double *media, double *dp, double *cv, int col) {
    int i;
    for (i = 0; i < col; i++) {
        cv[i] = dp[i] / media[i];
    }
}

int main(int argc, char **argv) {
    int lin, col, i, j;
    double *matriz, *mediana, *media, *media_har, *moda, *variancia, *dp, *cv;

    fscanf(stdin, "%d ", &lin);
    fscanf(stdin, "%d\n", &col);

    matriz = (double *)malloc(lin * col * sizeof(double));
    media = (double *)malloc(col * sizeof(double));
    media_har = (double *)malloc(col * sizeof(double));
    mediana = (double *)malloc(col * sizeof(double));
    moda = (double *)malloc(col * sizeof(double));
    variancia = (double *)malloc(col * sizeof(double));
    cv = (double *)malloc(col * sizeof(double));
    dp = (double *)malloc(col * sizeof(double));

    for (i = 0; i < lin; i++) {
        for (j = 0; j < col; j++) {
            fscanf(stdin, "%lf ", &(matriz[j * lin + i]));
        }
    }

    calcula_medias(matriz, media, media_har, lin, col);
    ordena_colunas(matriz, lin, col);
    calcula_mediana(matriz, mediana, lin, col);
    calcula_moda(matriz, moda, lin, col);
    calcula_variancia(matriz, media, variancia, lin, col);
    calcula_desvio_padrao(variancia, dp, col);
    calcula_coeficiente_variacao(media, dp, cv, col);

    for (i = 0; i < col; i++)
        printf("%.1lf ", media[i]);
    printf("\n");
    for (i = 0; i < col; i++)
        printf("%.1lf ", media_har[i]);
    printf("\n");
    for (i = 0; i < col; i++)
        printf("%.1lf ", mediana[i]);
    printf("\n");
    for (i = 0; i < col; i++)
        printf("%.1lf ", moda[i]);
    printf("\n");
    for (i = 0; i < col; i++)
        printf("%.1lf ", variancia[i]);
    printf("\n");
    for (i = 0; i < col; i++)
        printf("%.1lf ", dp[i]);
    printf("\n");
    for (i = 0; i < col; i++)
        printf("%.1lf ", cv[i]);
    printf("\n");

    free(matriz);
    free(media);
    free(media_har);
    free(mediana);
    free(moda);
    free(variancia);
    free(dp);
    free(cv);
}

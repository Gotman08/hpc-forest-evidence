import hashlib,importlib.util,json,time
from pathlib import Path
D=Path(__file__).resolve().parent;T=D/"transition-observateur-mixte";O=D/"observateur-mixte-r4b-r2"
BASE=D.parents[3];G=BASE/"outputs/HPC-Forest-Harnais-Comparaison-r1/SUIVI-COMPACT.md"
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
read=lambda p:json.loads(Path(p).read_text(encoding="utf-8-sig"))
ref=lambda p:{"path":str(Path(p).resolve()),"sha256":sha(p)}
assert sha(G)=="9a97a88760cfc8133b01ea21f7482c6e49cd20457f7663e8307952f0d0634855"
spec=importlib.util.spec_from_file_location("parent_final_mixed",O/"observer-mixte.py");m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
rows=m.census();policy=read(T/"politique-reelle.json");routes=read(T/"routes-reelles.json");state=read(O/"observer-state.json")
assert state["stage"]=="observing" and state["transition_verified"] is True and state["passive_only"] is True
assert 0<=time.time()-state["updated_at"]<90
_,hist,jobs,sessions,_,_=m.guard(policy,routes,state["routes_history"],rows)
assert set(sessions)=={m.SO_SESSION} and jobs=={m.SO_JOB}
m.verify_pair(state["observer_full_identities"],rows)
assert m.transition_state(policy,routes,rows,T/"transition-verifiee.json") is True
assert state["observations"][m.SO_JOB]["state"]=="RUNNING" and state["observations"][m.SO_JOB]["observation"]["current_state_observed"] is True
assert (T/"nouvel-observateur.stderr.log").stat().st_size==0
snapshot=T/"etat-mixte-apres-transition.json"
with snapshot.open("x",encoding="utf-8") as f:f.write(json.dumps(state,ensure_ascii=False,indent=2)+"\n")
proof={"schema":"hpc-forest-mixed-reader-effective-transition-verification-v1","verified":True,"observed_at":time.time(),"reader_pair":[p["ProcessId"] for p in state["observer_full_identities"]],"reader_full_identities":state["observer_full_identities"],"source_only_preserved":True,"source_only_job":"751592","source_only_state":"RUNNING","old_reader_original_identities_absent":True,"native_workers":1,"new_dynamic_worker_started":False,"model_calls_by_reader":0,"only_status_accounting_rpc":True,"transition":ref(T/"transition-verifiee.json"),"old_reader_absence":ref(T/"ancien-observateur-passif-absent-verifie.json"),"code":ref(O/"observer-mixte.py"),"policy":ref(T/"politique-reelle.json"),"state_snapshot":ref(snapshot)}
P=T/"surveillance-mixte-effective-verifiee.json"
with P.open("x",encoding="utf-8") as f:f.write(json.dumps(proof,ensure_ascii=False,indent=2)+"\n")
b=G.read_bytes();backup=D/"avant-guide-observateur-mixte-effectif";backup.mkdir(exist_ok=False);(backup/"SUIVI-COMPACT.md").write_bytes(b)
g=b.decode("utf-8-sig")
a=g.index("Source-only Sol MAX /751592");z=g.index("\n\nLes trois relais R2",a)
g=g[:a]+"""Source-only Sol MAX /751592, session665743a02b824021a697b6a4884a667c :45/60 issues MAX reçues ; quinze dernières dans ce même job. Même relais37900/37848 et même cache/registre ; Slurm RUNNING au contrôle frais du lecteur mixte. Nouveau lecteur passif **55512/57940**, code observateur-mixte-r4b-r2/observer-mixte.py : surveillance SO + seules phases Luna R4b MAX exactement planifiées, routes encore absent. État observing/transition_verified après arrêt individuel du SEUL ancien lecteur passif28148 et sortie naturelle de son lanceur58116 ; aucun worker/CLI/MCP ciblé. Preuve reprises/r3-corrige-r4-parallele-20261018/transition-observateur-mixte/surveillance-mixte-effective-verifiee.json. Source-only et processus étrangers préservés. Les PID historiques ne sont pas de futures cibles."""+g[z:]
g=g.replace("Le lecteur de transition actuel n’admet que source-only : nouvelle observation/politique avant tout worker dynamique.","Le lecteur mixte actuel admet l’observation de source-only et des seules phases Luna prévues ; pour les autres modèles, une nouvelle politique de phase et leurs admissions seront requises.")
a=g.index("Préparation de surveillance mixte :");z=g.index("\n\nSuite autorisée après",a)
g=g[:a]+"""Surveillance mixte qualifiée localement et démarrée en lecture seule. Le premier lecteur r1 a refusé des lignes système incomplètes avant filtrage PID ; refus et r1 scellé conservés. Correctif r2 isolé : PID différent ignoré, cinq champs du PID correspondant toujours stricts ;30tests neutres et Ruff passent, source EDE inchangée. Le nouveau lecteur est réellement sain, l’ancien lecteur passif est clos après preuve/revue et source-only reste RUNNING. Aucune génération dynamique, requête de modèle ou admission scientifique par cette surveillance."""+g[z:]
G.write_text(g,encoding="utf-8",newline="\n")
proof2={"verified":True,"guide_before":hashlib.sha256(b).hexdigest(),"guide_after":sha(G),"effective_reader":ref(P),"backup":str(backup),"no_dynamic_model_started":True}
(D/"guide-surveillance-mixte-effective-verifie.json").write_text(json.dumps(proof2,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
print(json.dumps(proof2,ensure_ascii=False))


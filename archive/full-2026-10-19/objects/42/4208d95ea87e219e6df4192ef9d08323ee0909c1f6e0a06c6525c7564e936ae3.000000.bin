{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"/*\\n * This code was based on Sokoban C available at\\n * http://www.rosettacode.org/wiki/Sokoban#C\\n * licenced under GNU Free Documentation License 1.2\\n */\\n\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <unistd.h>\\n#include <stdint.h>\\n#include <assert.h>\\n#include <stdbool.h>\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\nint w, h, n_boxes;\\nuint8_t * board, * goals, * live;\\n\\ntypedef uint16_t cidx_t;\\ntypedef uint32_t hash_t;\\n\\n/* board configuration is represented by an array of cell indices\\n   of player and boxes */\\ntypedef struct state_t state_t;\\n\\nstruct state_t { // variable length\\n    hash_t h;\\n    state_t * prev, * next, * qnext;\\n    cidx_t c[];\\n};\\n\\nsize_t state_size, block_size = 32;\\nstate_t * block_root, * block_head;\\n\\ninline\\nstate_t * newstate(state_t * parent) {\\n    inline state_t * next_of(state_t * s) {\\n        return (void * )((uint8_t * ) s + state_size);\\n    }\\n\\n    state_t * ptr;\\n    if (!block_head) {\\n        block_size *= 2;\\n        state_t * p = malloc(block_size * state_size);\\n        assert(p);\\n        p -> next = block_root;\\n        block_root = p;\\n        ptr = (void * )((uint8_t * ) p + state_size * block_size);\\n        p = block_head = next_of(p);\\n        state_t * q;\\n        for (q = next_of(p); q < ptr; p = q, q = next_of(q))\\n            p -> next = q;\\n        p -> next = NULL;\\n    }\\n\\n    ptr = block_head;\\n    block_head = block_head -> next;\\n\\n    ptr -> prev = parent;\\n    ptr -> h = 0;\\n    return ptr;\\n}\\n\\ninline\\nvoid unnewstate(state_t * p) {\\n    p -> next = block_head;\\n    block_head = p;\\n}\\n\\nenum {\\n    space,\\n    wall,\\n    player,\\n    box\\n};\\n\\n// mark up positions where a box definitely should not be\\nvoid mark_live(const int c) {\\n    const int y = c / w,\\n        x = c % w;\\n    if (live[c]) return;\\n\\n    live[c] = 1;\\n    if (y > 1 && board[c - w] != wall && board[c - w * 2] != wall)\\n        mark_live(c - w);\\n    if (y < h - 2 && board[c + w] != wall && board[c + w * 2] != wall)\\n        mark_live(c + w);\\n    if (x > 1 && board[c - 1] != wall && board[c - 2] != wall)\\n        mark_live(c - 1);\\n    if (x < w - 2 && board[c + 1] != wall && board[c + 2] != wall)\\n        mark_live(c + 1);\\n}\\n\\nstate_t * parse_board(const char * s) {\\n    board = calloc(w * h, sizeof(uint8_t));\\n    assert(board);\\n    goals = calloc(w * h, sizeof(uint8_t));\\n    assert(goals);\\n    live = calloc(w * h, sizeof(uint8_t));\\n    assert(live);\\n\\n    n_boxes = 0;\\n    for (int i = 0; s[i]; i++) {\\n        switch (s[i]) {\\n        case '#':\\n            board[i] = wall;\\n            continue;\\n\\n        case '.': // fallthrough\\n        case '+':\\n            goals[i] = 1; // fallthrough\\n        case '@':\\n            continue;\\n\\n        case '*':\\n            goals[i] = 1; // fallthrough\\n        case '$':\\n            n_boxes++;\\n            continue;\\n        default:\\n            continue;\\n        }\\n    }\\n\\n    const int is = sizeof(int);\\n    state_size = (sizeof(state_t) + (1 + n_boxes) * sizeof(cidx_t) + is - 1) /\\n        is * is;\\n\\n    state_t * state = newstate(NULL);\\n\\n    for (int i = 0, j = 0; i < w * h; i++) {\\n        if (goals[i]) mark_live(i);\\n        if (s[i] == '$' || s[i] == '*')\\n            state -> c[++j] = i;\\n        else if (s[i] == '@' || s[i] == '+')\\n            state -> c[0] = i;\\n    }\\n\\n    return state;\\n}\\n\\n// K&R hash function\\ninline\\nvoid hash(state_t * s) {\\n    if (!s -> h) {\\n        register hash_t ha = 0;\\n        cidx_t * p = s -> c;\\n        for (int i = 0; i <= n_boxes; i++)\\n            ha = p[i] + 31 * ha;\\n        s -> h = ha;\\n    }\\n}\\n\\nstate_t ** buckets;\\nhash_t hash_size, fill_limit, filled;\\n\\nvoid extend_table() {\\n    int old_size = hash_size;\\n\\n    if (!old_size) {\\n        hash_size = 1024;\\n        filled = 0;\\n        fill_limit = hash_size * 3 / 4; // 0.75 load factor\\n    } else {\\n        hash_size *= 2;\\n        fill_limit *= 2;\\n    }\\n\\n    buckets = realloc(buckets, sizeof(state_t * ) * hash_size);\\n    assert(buckets);\\n\\n    // rehash\\n    memset(buckets + old_size, 0, sizeof(state_t * ) * (hash_size - old_size));\\n\\n    const hash_t bits = hash_size - 1;\\n    for (int i = 0; i < old_size; i++) {\\n        state_t * head = buckets[i];\\n        buckets[i] = NULL;\\n        while (head) {\\n            state_t * next = head -> next;\\n            const int j = head -> h & bits;\\n            head -> next = buckets[j];\\n            buckets[j] = head;\\n            head = next;\\n        }\\n    }\\n}\\n\\nstate_t * lookup(state_t * s) {\\n    hash(s);\\n    state_t * f = buckets[s -> h & (hash_size - 1)];\\n    for (; f; f = f -> next) {\\n        if ( //(f->h == s->h) &&\\n            !memcmp(s -> c, f -> c, sizeof(cidx_t) * (1 + n_boxes)))\\n            break;\\n    }\\n\\n    return f;\\n}\\n\\nstatic void insert_into_table(state_t * s) {\\n    if (filled++ >= fill_limit)\\n        extend_table();\\n\\n    hash_t i = s -> h & (hash_size - 1);\\n\\n    s -> next = buckets[i];\\n    buckets[i] = s;\\n}\\n\\nbool add_to_table(state_t * s) {\\n    if (lookup(s)) {\\n        unnewstate(s);\\n        return false;\\n    }\\n\\n    insert_into_table(s);\\n    return true;\\n}\\n\\nbool success(const state_t * s) {\\n    for (int i = 1; i <= n_boxes; i++)\\n        if (!goals[s -> c[i]]) return false;\\n    return true;\\n}\\n\\n/* A non-NULL storage argument keeps successor construction independent\\n   of the shared state allocator. */\\nstatic inline state_t * move_into(state_t * s,\\n    const int dy,\\n    const int dx,\\n    state_t * storage) {\\n    const int y = s -> c[0] / w;\\n    const int x = s -> c[0] % w;\\n    const int y1 = y + dy;\\n    const int x1 = x + dx;\\n    const int c1 = y1 * w + x1;\\n\\n    if (y1 < 0 || y1 > h || x1 < 0 || x1 > w ||\\n        board[c1] == wall)\\n        return NULL;\\n\\n    int at_box = 0;\\n    for (int i = 1; i <= n_boxes; i++) {\\n        if (s -> c[i] == c1) {\\n            at_box = i;\\n            break;\\n        }\\n    }\\n\\n    int c2;\\n    if (at_box) {\\n        c2 = c1 + dy * w + dx;\\n        if (board[c2] == wall || !live[c2])\\n            return NULL;\\n        for (int i = 1; i <= n_boxes; i++)\\n            if (s -> c[i] == c2) return NULL;\\n    }\\n\\n    state_t * n;\\n    if (storage) {\\n        n = storage;\\n        n -> prev = s;\\n        n -> h = 0;\\n    } else {\\n        n = newstate(s);\\n    }\\n    memcpy(n -> c + 1, s -> c + 1, sizeof(cidx_t) * n_boxes);\\n\\n    cidx_t * p = n -> c;\\n    p[0] = c1;\\n\\n    if (at_box) p[at_box] = c2;\\n\\n    // leet bubble sort\\n    for (int i = n_boxes; --i;) {\\n        cidx_t t = 0;\\n        for (int j = 1; j < i; j++) {\\n            if (p[j] > p[j + 1])\\n                t = p[j], p[j] = p[j + 1], p[j + 1] = t;\\n        }\\n        if (!t) break;\\n    }\\n\\n    return n;\\n}\\n\\nstate_t * move_me(state_t * s, const int dy, const int dx) {\\n    return move_into(s, dy, dx, NULL);\\n}\\n\\nstate_t * next_level, * done;\\nsize_t next_level_count;\\n\\nstatic bool queue_inserted(state_t * s) {\\n    if (success(s)) {\\n        done = s;\\n        return true;\\n    }\\n\\n    s -> qnext = next_level;\\n    next_level = s;\\n    next_level_count++;\\n    return false;\\n}\\n\\nbool queue_move(state_t * s) {\\n    if (!s || !add_to_table(s))\\n        return false;\\n\\n    return queue_inserted(s);\\n}\\n\\n#ifdef _OPENMP\\n/* The read-only parallel probe cannot detect duplicates within its own\\n   wave, so repeat the lookup before allocating and committing a state. */\\nstatic bool queue_prepared_move(state_t * candidate) {\\n    if (lookup(candidate))\\n        return false;\\n\\n    state_t * s = newstate(candidate -> prev);\\n    s -> h = candidate -> h;\\n    memcpy(s -> c, candidate -> c, sizeof(cidx_t) * (1 + n_boxes));\\n    insert_into_table(s);\\n    return queue_inserted(s);\\n}\\n#endif\\n\\nbool do_move(state_t * s) {\\n    return queue_move(move_me(s, 0, 1)) ||\\n        queue_move(move_me(s, 0, -1)) ||\\n        queue_move(move_me(s, -1, 0)) ||\\n        queue_move(move_me(s, 1, 0));\\n}\\n\\n#ifdef _OPENMP\\nstatic state_t ** parallel_heads;\\nstatic size_t parallel_head_capacity;\\nstatic uint8_t * parallel_moves;\\nstatic size_t parallel_move_capacity;\\n\\nstatic bool expand_parallel_level(state_t * head, size_t count) {\\n    int threads = omp_get_max_threads();\\n    if (threads < 2 || count < 512)\\n        return false;\\n\\n    const size_t alignment = sizeof(void *);\\n    if (state_size > SIZE_MAX - (alignment - 1))\\n        return false;\\n    const size_t stride = (state_size + alignment - 1) / alignment * alignment;\\n    if (stride > SIZE_MAX / 4)\\n        return false;\\n\\n    /* Two chunks per worker, with bounded reusable successor storage. */\\n    size_t chunk_states = 16384 / (4 * stride);\\n    if (!chunk_states) chunk_states = 1;\\n    if (chunk_states > 64) chunk_states = 64;\\n    const size_t chunks = (count - 1) / chunk_states + 1;\\n    if ((size_t)threads > chunks)\\n        threads = (int)chunks;\\n    size_t chunks_per_wave = (size_t)threads * 2;\\n    if (chunks_per_wave > chunks)\\n        chunks_per_wave = chunks;\\n    const size_t slots_per_chunk = 4 * chunk_states;\\n    if (chunks > SIZE_MAX / sizeof(*parallel_heads) ||\\n        chunks_per_wave > SIZE_MAX / slots_per_chunk / stride)\\n        return false;\\n    const size_t scratch_bytes = chunks_per_wave * slots_per_chunk * stride;\\n\\n    if (chunks > parallel_head_capacity) {\\n        state_t ** p = realloc(parallel_heads, chunks * sizeof(*parallel_heads));\\n        if (!p) return false;\\n        parallel_heads = p;\\n        parallel_head_capacity = chunks;\\n    }\\n    if (scratch_bytes > parallel_move_capacity) {\\n        uint8_t * p = realloc(parallel_moves, scratch_bytes);\\n        if (!p) return false;\\n        parallel_moves = p;\\n        parallel_move_capacity = scratch_bytes;\\n    }\\n\\n    state_t * current = head;\\n    for (size_t i = 0; i < chunks; i++) {\\n        parallel_heads[i] = current;\\n        for (size_t j = 0; j < chunk_states && current; j++)\\n            current = current -> qnext;\\n    }\\n\\n    const int dy[4] = {0, 0, -1, 1};\\n    const int dx[4] = {1, -1, 0, 0};\\n\\n    #pragma omp parallel num_threads(threads)\\n    {\\n        for (size_t first = 0; first < chunks; first += chunks_per_wave) {\\n            const size_t last = first +\\n                (chunks - first < chunks_per_wave ? chunks - first : chunks_per_wave);\\n\\n            /* The visited table is read-only until the worksharing barrier. */\\n            #pragma omp for schedule(static)\\n            for (size_t chunk = first; chunk < last; chunk++) {\\n                uint8_t * storage = parallel_moves +\\n                    (chunk - first) * slots_per_chunk * stride;\\n                state_t * parent = parallel_heads[chunk];\\n                size_t slot = 0;\\n                for (size_t i = 0; i < chunk_states && parent;\\n                     i++, parent = parent -> qnext) {\\n                    for (int direction = 0; direction < 4; direction++, slot++) {\\n                        state_t * candidate = (void *)(storage + slot * stride);\\n                        candidate -> prev = NULL;\\n                        if (move_into(parent, dy[direction], dx[direction], candidate) &&\\n                            lookup(candidate))\\n                            candidate -> prev = NULL;\\n                    }\\n                }\\n            }\\n\\n            /* Commit in precisely the original parent and R/L/U/D order.\\n               The implicit single barrier precedes the next read-only wave. */\\n            #pragma omp single\\n            {\\n                size_t parents = count - first * chunk_states;\\n                const size_t capacity = (last - first) * chunk_states;\\n                if (parents > capacity) parents = capacity;\\n                const size_t slots = 4 * parents;\\n                for (size_t i = 0; i < slots && !done; i++) {\\n                    state_t * candidate = (void *)(parallel_moves + i * stride);\\n                    if (candidate -> prev)\\n                        queue_prepared_move(candidate);\\n                }\\n            }\\n\\n            if (done) break;\\n        }\\n    }\\n    return true;\\n}\\n#endif\\n\\nstatic void expand_level(state_t * head, size_t count) {\\n#ifdef _OPENMP\\n    if (expand_parallel_level(head, count))\\n        return;\\n#else\\n    (void)count;\\n#endif\\n    for (; head && !done; head = head -> qnext)\\n        do_move(head);\\n}\\n\\nvoid show_moves(const state_t * s, int nextPos) {\\n    if (s -> prev)\\n        show_moves(s -> prev, s -> c[0]);\\n    if (nextPos == -1) {\\n        printf(\\\"\\\\n\\\");\\n        return;\\n    }\\n    int cx = s -> c[0] % w;\\n    int cy = s -> c[0] / w;\\n    int nx = nextPos % w;\\n    int ny = nextPos / w;\\n    int box = 0;\\n    for (int i = 1; !box && i <= n_boxes; i++)\\n        box = s -> c[i] == nextPos;\\n    if (cx < nx) printf(box ? \\\"R\\\" : \\\"r\\\");\\n    else if (cx > nx) printf(box ? \\\"L\\\" : \\\"l\\\");\\n    else if (cy < ny) printf(box ? \\\"D\\\" : \\\"d\\\");\\n    else if (cy > ny) printf(box ? \\\"U\\\" : \\\"u\\\");\\n    else if (1) {\\n        printf(\\\"Invalid move\\\\n\\\");\\n        exit(1);\\n    }\\n}\\n\\nint main() {\\n    size_t sz = 1024;\\n    char * boardStr = malloc(sz * sizeof(char));\\n    char * pos = boardStr;\\n    w = -1;\\n    h = 0;\\n    while (1) {\\n        int read = getline( & pos, & sz, stdin);\\n        if (read == -1) break;\\n        if (read >= w) w = read;\\n        sz -= read;\\n        pos += read;\\n        h++;\\n    }\\n    state_t * s = parse_board(boardStr);\\n    free(boardStr);\\n\\n    extend_table();\\n    queue_move(s);\\n    while (!done) {\\n        state_t * head = next_level;\\n        const size_t count = next_level_count;\\n        next_level = NULL;\\n        next_level_count = 0;\\n        expand_level(head, count);\\n\\n        if (!next_level) {\\n            puts(\\\"no solution?\\\");\\n            return 1;\\n        }\\n    }\\n\\n    show_moves(done, -1);\\n\\n#ifdef _OPENMP\\n    free(parallel_heads);\\n    free(parallel_moves);\\n#endif\\n    free(buckets);\\n    free(board);\\n    free(goals);\\n    free(live);\\n\\n    while (block_root) {\\n        void * tmp = block_root -> next;\\n        free(block_root);\\n        block_root = tmp;\\n    }\\n    return 0;\\n}\\n\",\n      \"path\": \"src/sokoban.c\"\n    }\n  ],\n  \"hypothesis\": \"Bulk-synchronous OpenMP expansion can accelerate successor construction and duplicate probes on four ARM64 cores while deterministic serial commits preserve the reference BFS output.\",\n  \"notes\": \"Not executed or measured. Implicit barriers separate read-only parallel table probes from serial insertion. Commits preserve parent order, R/L/U/D generation, first-visit parents and layer prepending. Builds without OpenMP, small frontiers and workspace allocation failures retain serial expansion.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Allow successor construction into independent scratch states without accessing the shared allocator.\",\n    \"Use static OpenMP work sharing for large frontiers, processing bounded waves and probing the visited table while it is read-only.\",\n    \"Commit candidates in original traversal order, rechecking duplicates before permanent allocation; reuse scratch storage and keep frontiers below 512 states serial.\"\n  ]\n}"}}

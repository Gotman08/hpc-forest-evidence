"""Pure independent byte/synthetic checks; no live process observation or admission."""
from pathlib import Path
import hashlib
import importlib.util
import json

HERE = Path(__file__).resolve().parent
BASE = HERE.parents[2]
TARGET = BASE / 'outputs/HPC-Forest-Primes-Natif-Lancement-r2d/source-only-reader-r4/source_only_state.py'
before = hashlib.sha256(TARGET.read_bytes()).hexdigest()
spec = importlib.util.spec_from_file_location('independent_pure_pid_reader', TARGET)
s = importlib.util.module_from_spec(spec)
spec.loader.exec_module(s)
results = {}


def row(pid, parent, birth):
    return {'ProcessId': pid, 'ParentProcessId': parent, 'ExecutablePath': 'NEUTRAL.exe',
            'CommandLine': 'NEUTRAL inert metadata', 'CreationDate': birth}


def run(name, action):
    try:
        assert action()
        results[name] = {'passed': True}
    except Exception as exc:
        results[name] = {'passed': False, 'error': type(exc).__name__ + ': ' + str(exc)}


owner = row(10, 1, '2026-10-18T05:00:00Z')
times = ['2026-10-18T06:00:00Z', '2026-10-18T06:29:51.4065466Z', '2026-10-18T08:00:00Z']


def graph(child, cold=None):
    return s._unresolved_descendants([owner], ([owner], [] if cold is None else cold, [child]), captured_at=times)


for label, birth, excluded in [('after', '2026-10-18T06:29:51.4065467Z', True),
                               ('equal', '2026-10-18T06:29:51.4065466Z', False),
                               ('before', '2026-10-18T06:29:51.4065465Z', False)]:
    run('100ns_' + label, lambda birth=birth, excluded=excluded: (graph(row(20, 10, birth)) == []) is excluded)


def opaque_refuses(field):
    child = row(20, 10, '2026-10-18T07:00:00Z')
    child[field] = None
    try:
        graph(child)
    except ValueError:
        return True
    return False


for field in ['CreationDate', 'ExecutablePath', 'CommandLine']:
    run('opaque_child_' + field, lambda field=field: opaque_refuses(field))
child = row(20, 10, '2026-10-18T07:00:00Z')
replacement = row(10, 99, '2026-10-18T06:15:00Z')
replacement['CommandLine'] = None
run('opaque_replacement_not_a_bound', lambda: graph(child, [replacement]) == [child])
future = row(10, 99, '2026-10-18T07:30:00Z')
run('replacement_future_to_its_capture_not_a_bound', lambda: graph(child, [future]) == [child])
bridge = row(20, 10, '2026-10-18T06:15:00Z')
grandchild = row(30, 20, '2026-10-18T07:00:00Z')
run('historical_bridge_still_blocks', lambda: {r['ProcessId'] for r in s._unresolved_descendants(
    [owner], ([owner], [bridge], [grandchild]), captured_at=times)} == {20, 30})
run('missing_bound_keeps_old_strict_graph', lambda: s._unresolved_descendants([owner], ([owner], [], [child])) == [child])
report_path = BASE / 'outputs/HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r2/operations-parent-lane-close-20261018T0542/reception-sortie-naturelle/RECEPTION-COLD-METADONNEES.json'
report = json.loads(report_path.read_text(encoding='utf-8-sig'))
current_path = BASE / 'outputs/HPC-Forest-Primes-Natif-Relance-r2d/operations-parent/cim-avant-autorisations.json'
assert hashlib.sha256(current_path.read_bytes()).hexdigest() == '8dd47f95b0179f6e289dd9112ef213a3e9576fd1ed5953eec3297c6a18431fb1'
snapshots = [json.loads(Path(report[k]['path']).read_text(encoding='utf-8-sig')) for k in ['prior_full_cim', 'cold_full_cim']]
snapshots.append(json.loads(current_path.read_text(encoding='utf-8-sig')))
run('actual_4_post_absence_mscopilot_children_excluded_without_adoption', lambda: s._unresolved_descendants(
    report['ownership_inventory'], tuple(v['rows'] for v in snapshots),
    captured_at=[v['captured_at_utc'] for v in snapshots]) == [])
after = hashlib.sha256(TARGET.read_bytes()).hexdigest()
run('reader_unchanged_during_independent_checks', lambda: before == after)
output = {'schema': 'hpc-forest-independent-pid-recycle-neutral-checks-v1',
          'verified': all(v['passed'] for v in results.values()), 'reader_sha256': after,
          'results': results, 'live_CIM_collected': False, 'fresh_CURRENT_proof_created': False,
          'native_generation_admitted': False, 'process_stop_CLI_RPC_model_calls': 0}
dest = HERE / ('CONTROLES-INDEPENDANTS-' + after[:12] + '.json')
with dest.open('x', encoding='utf-8', newline='\n') as stream:
    json.dump(output, stream, indent=2)
    stream.write('\n')
print(json.dumps({'verified': output['verified'], 'path': str(dest), 'reader_sha256': after,
                  'failed': {k:v for k,v in results.items() if not v['passed']}}))

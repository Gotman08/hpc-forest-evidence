      "content": "#include <algorithm>\n#include <cstddef>\n#include <cstdint>\n#include <iostream>\n#include <iterator>\n#include <limits>\n#include <memory>\n#include <string>\n#include <vector>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ')\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v');\n    }\n};\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase(std::remove_if(text.begin(), text.end(), IsWhitespace()),\n               text.end());\n    return text;\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator<char> begin(in), end;\n    std::string text(begin, end);\n    return remove_whitespaces(text);\n}\n\nstatic inline void format_permutation(char* out, const std::string& text)\n{\n    *out++ = '[';\n    *out++ = ' ';\n    for (std::size_t i = 0; i < text.size(); ++i) {\n        *out++ = text[i];\n        *out++ = ' ';\n    }\n    *out++ = ']';\n    *out = '\\n';\n}\n\nclass CharacterBuffer\n{\n    char data_[65536];\n    std::size_t used_;\n\npublic:\n    CharacterBuffer() : used_(0) {}\n\n    void flush()\n    {\n        if (used_ != 0) {\n            std::cout.write(data_, static_cast<std::streamsize>(used_));\n            used_ = 0;\n        }\n    }\n\n    void put(char c)\n    {\n        data_[used_++] = c;\n        if (used_ == sizeof(data_)) flush();\n    }\n};\n\nstatic void emit_large_records(std::string& text)\n{\n    CharacterBuffer out;\n    do {\n        out.put('[');\n        out.put(' ');\n        for (std::size_t i = 0; i < text.size(); ++i) {\n            out.put(text[i]);\n            out.put(' ');\n        }\n        out.put(']');\n        out.put('\\n');\n    } while (std::next_permutation(text.begin(), text.end()));\n    out.flush();\n}\n\nstatic void emit_sequential(std::string& text)\n{\n    const std::size_t buffer_bytes = 256 * 1024;\n    if (text.size() > (buffer_bytes - 4) / 2) {\n        emit_large_records(text);\n        return;\n    }\n\n    const std::size_t record_size = 2 * text.size() + 4;\n    const std::size_t capacity = (buffer_bytes / record_size) * record_size;\n    std::unique_ptr<char[]> buffer(new char[capacity]);\n    std::size_t used = 0;\n    bool more;\n    do {\n        format_permutation(buffer.get() + used, text);\n        used += record_size;\n        more = std::next_permutation(text.begin(), text.end());\n        if (used == capacity || !more) {\n            std::cout.write(buffer.get(), static_cast<std::streamsize>(used));\n            used = 0;\n        }\n    } while (more);\n}\n\n#ifdef _OPENMP\n\ntypedef std::uint64_t Count;\n\nstruct Symbol\n{\n    char value;\n    Count copies;\n};\n\nstatic Count gcd_count(Count a, Count b)\n{\n    while (b != 0) {\n        const Count remainder = a % b;\n        a = b;\n        b = remainder;\n    }\n    return a;\n}\n\nstatic bool count_permutations(const std::vector<Symbol>& symbols, Count& ways)\n{\n    ways = 1;\n    Count used = 0;\n    const Count limit = std::numeric_limits<Count>::max();\n    for (std::size_t i = 0; i < symbols.size(); ++i) {\n        const Count copies = symbols[i].copies;\n        const Count k = std::min(used, copies);\n        const Count base = std::max(used, copies);\n        for (Count j = 1; j <= k; ++j) {\n            const Count numerator = base + j;\n            const Count common = gcd_count(numerator, j);\n            const Count multiplier = numerator / common;\n            const Count quotient = ways / (j / common);\n            if (quotient > limit / multiplier) return false;\n            ways = quotient * multiplier;\n        }\n        used += copies;\n    }\n    return true;\n}\n\nstatic void unrank_permutation(const std::vector<Symbol>& symbols,\n                               Count ways, Count rank,\n                               std::string& text,\n                               std::vector<Count>& counts)\n{\n    for (std::size_t i = 0; i < symbols.size(); ++i)\n        counts[i] = symbols[i].copies;\n\n    Count remaining = static_cast<Count>(text.size());\n    std::size_t position = 0;\n    while (remaining != 0) {\n        if (rank == 0) {\n            for (std::size_t i = 0; i < symbols.size(); ++i) {\n                const std::size_t copies = static_cast<std::size_t>(counts[i]);\n                std::fill_n(text.begin() + position, copies, symbols[i].value);\n                position += copies;\n            }\n            return;\n        }\n        for (std::size_t i = 0; i < symbols.size(); ++i) {\n            if (counts[i] == 0) continue;\n            const Count common = gcd_count(counts[i], remaining);\n            const Count branch = (ways / (remaining / common))\n                               * (counts[i] / common);\n            if (rank >= branch) {\n                rank -= branch;\n            } else {\n                text[position++] = symbols[i].value;\n                --counts[i];\n                --remaining;\n                ways = branch;\n                break;\n            }\n        }\n    }\n}\n\nstatic void emit_parallel(const std::string& sorted,\n                          const std::vector<Symbol>& symbols,\n                          Count total, std::size_t record_size,\n                          std::size_t rows_per_slab, int workers)\n{\n    const std::size_t capacity = static_cast<std::size_t>(\n        std::min<Count>(total, static_cast<Count>(rows_per_slab)));\n    std::unique_ptr<char[]> buffer(new char[capacity * record_size]);\n\n    #pragma omp parallel num_threads(workers)\n    {\n        std::string current(sorted.size(), '\\0');\n        std::vector<Count> counts(symbols.size());\n        const int parts = omp_get_num_threads();\n\n        for (Count base = 0; base < total; ) {\n            const std::size_t rows = static_cast<std::size_t>(\n                std::min<Count>(total - base, static_cast<Count>(capacity)));\n            const std::size_t quotient = rows / static_cast<std::size_t>(parts);\n            const std::size_t remainder = rows % static_cast<std::size_t>(parts);\n\n            #pragma omp for schedule(static)\n            for (int part = 0; part < parts; ++part) {\n                const std::size_t p = static_cast<std::size_t>(part);\n                const std::size_t offset = quotient * p + std::min(p, remainder);\n                const std::size_t length = quotient + (p < remainder ? 1 : 0);\n                if (length == 0) continue;\n\n                unrank_permutation(symbols, total,\n                                   base + static_cast<Count>(offset),\n                                   current, counts);\n                char* out = buffer.get() + offset * record_size;\n                for (std::size_t row = 0; row < length; ++row) {\n                    format_permutation(out, current);\n                    out += record_size;\n                    if (row + 1 < length)\n                        std::next_permutation(current.begin(), current.end());\n                }\n            }\n\n            // Work sharing completes the slab before its single ordered write.\n            #pragma omp single\n            {\n                std::cout.write(buffer.get(),\n                    static_cast<std::streamsize>(rows * record_size));\n            }\n            // The single-region barrier prevents reuse while writing.\n            base += static_cast<Count>(rows);\n        }\n    }\n}\n\n#endif\n\nstatic void emit_permutations(std::string& text)\n{\n    if (text.empty()) return;\n    std::sort(text.begin(), text.end());\n\n#ifdef _OPENMP\n    const std::size_t slab_bytes = 4 * 1024 * 1024;\n    if (omp_get_max_threads() > 1 && text.size() <= (slab_bytes - 4) / 2) {\n        std::vector<Symbol> symbols;\n        for (std::size_t i = 0; i < text.size(); ++i) {\n            if (symbols.empty() || symbols.back().value != text[i])\n                symbols.push_back(Symbol{text[i], 1});\n            else\n                ++symbols.back().copies;\n        }\n\n        Count total;\n        if (count_permutations(symbols, total)) {\n            const std::size_t record_size = 2 * text.size() + 4;\n            const std::size_t rows_per_slab = slab_bytes / record_size;\n            const std::size_t grain_rows = std::max<std::size_t>(\n                1, (512 * 1024) / record_size);\n            const Count useful_workers = total / static_cast<Count>(grain_rows);\n            int workers = omp_get_max_threads();\n            if (useful_workers < static_cast<Count>(workers))\n                workers = static_cast<int>(useful_workers);\n            if (static_cast<std::size_t>(workers) > rows_per_slab)\n                workers = static_cast<int>(rows_per_slab);\n            if (workers > 1) {\n                emit_parallel(text, symbols, total, record_size,\n                              rows_per_slab, workers);\n                return;\n            }\n        }\n    }\n#endif\n\n    emit_sequential(text);\n}\n\nint main(int argc, char const* argv[])\n{\n    std::ios_base::sync_with_stdio(false);\n    std::cin.tie(0);\n    std::string text = read_text_from_stdin<std::string>(std::cin);\n    emit_permutations(text);\n    return 0;\n}\n",
      "path": "src/permutations.cc"
    }

      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <assert.h>\n#include <string.h>\n\nenum { RADIX_INSERTION_CUTOFF = 24 };\n\nstatic void insertion_sort_indices(const char *strings, size_t stride,\n                                   long int *index, size_t count, size_t depth) {\n    for (size_t i = 1; i < count; ++i) {\n        long int key = index[i];\n        const char *key_string = strings + (size_t)key * stride + depth;\n        size_t j = i;\n        while (j > 0 &&\n               strcmp(strings + (size_t)index[j - 1] * stride + depth,\n                      key_string) > 0) {\n            index[j] = index[j - 1];\n            --j;\n        }\n        index[j] = key;\n    }\n}\n\nstatic void radix_sort_indices(const char *strings, size_t stride,\n                               long int *index, long int *scratch,\n                               size_t count, size_t depth) {\n    const unsigned char *bytes = (const unsigned char *)strings;\n\n    while (count > RADIX_INSERTION_CUTOFF) {\n        size_t counts[256] = {0};\n        size_t positions[256];\n        size_t largest_count = 0;\n        size_t total = 0;\n        unsigned int largest_bucket = 0;\n        unsigned int nonempty = 0;\n        unsigned int only_bucket = 0;\n\n        for (size_t i = 0; i < count; ++i) {\n            unsigned int c = bytes[(size_t)index[i] * stride + depth];\n            ++counts[c];\n        }\n\n        for (unsigned int c = 0; c < 256; ++c) {\n            positions[c] = total;\n            total += counts[c];\n            if (counts[c] != 0) {\n                ++nonempty;\n                only_bucket = c;\n            }\n            if (c != 0 && counts[c] > largest_count) {\n                largest_count = counts[c];\n                largest_bucket = c;\n            }\n        }\n\n        if (nonempty == 1) {\n            if (only_bucket == 0)\n                return;\n\n            /* Scan shared prefixes along strings rather than by columns. */\n            const unsigned char *first =\n                bytes + (size_t)index[0] * stride + depth;\n            const unsigned char *other =\n                bytes + (size_t)index[1] * stride + depth;\n            size_t shared = 1;\n            while (first[shared] != 0 && first[shared] == other[shared])\n                ++shared;\n            for (size_t i = 2; i < count && shared > 1; ++i) {\n                other = bytes + (size_t)index[i] * stride + depth;\n                size_t j = 1;\n                while (j < shared && first[j] == other[j])\n                    ++j;\n                shared = j;\n            }\n            depth += shared;\n            continue;\n        }\n\n        for (size_t i = 0; i < count; ++i) {\n            long int key = index[i];\n            unsigned int c = bytes[(size_t)key * stride + depth];\n            scratch[positions[c]++] = key;\n        }\n        memcpy(index, scratch, count * sizeof(*index));\n\n        /* Positions now contain bucket ends. Bucket zero is terminal. */\n        for (unsigned int c = 1; c < 256; ++c) {\n            if (c != largest_bucket && counts[c] > 1) {\n                size_t start = positions[c - 1];\n                if (counts[c] <= RADIX_INSERTION_CUTOFF) {\n                    insertion_sort_indices(strings, stride, index + start,\n                                           counts[c], depth + 1);\n                } else {\n                    radix_sort_indices(strings, stride, index + start,\n                                       scratch + start, counts[c], depth + 1);\n                }\n            }\n        }\n\n        if (largest_count <= 1)\n            return;\n\n        /* Iterating on the largest child bounds recursive stack depth. */\n        size_t start = positions[largest_bucket - 1];\n        index += start;\n        scratch += start;\n        count = largest_count;\n        ++depth;\n    }\n\n    insertion_sort_indices(strings, stride, index, count, depth);\n}\n\nlong int *bucket_sort(char *a, int length, long int size,\n                      int offset, int nbuckets) {\n    (void)offset;\n    (void)nbuckets;\n\n    if (size <= 0)\n        return NULL;\n\n    size_t count = (size_t)size;\n    long int *index;\n    long int *scratch;\n    if (count > ((size_t)-1) / sizeof(*index))\n        exit(EXIT_FAILURE);\n\n    index = (long int *)malloc(count * sizeof(*index));\n    if (index == NULL)\n        exit(EXIT_FAILURE);\n    for (size_t i = 0; i < count; ++i)\n        index[i] = (long int)i;\n\n    if (count <= RADIX_INSERTION_CUTOFF) {\n        insertion_sort_indices(a, (size_t)length, index, count, 0);\n        return index;\n    }\n\n    scratch = (long int *)malloc(count * sizeof(*scratch));\n    if (scratch == NULL) {\n        free(index);\n        exit(EXIT_FAILURE);\n    }\n    radix_sort_indices(a, (size_t)length, index, scratch, count, 0);\n    free(scratch);\n    return index;\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb){\n   char *strings = NULL;\n   int      len,\n            offset,\n            nbucket;\n   long int n;\n\n   if (!fscanf(stdin, \"%d\", &len)) {\n      printf (\"ERROR len\\n\");\n      exit (1);\n   }\n\n   if (!fscanf(stdin, \"%ld\", &n)) {\n      printf (\"ERROR n\\n\");\n      exit (1);\n   }\n\n   if (!fscanf(stdin, \"%d\", &offset)) {\n      printf (\"ERROR offset\\n\");\n      exit (1);\n   }\n\n   if (!fscanf(stdin, \"%d\", &nbucket)) {\n      printf (\"ERROR nbucket\\n\");\n      exit (1);\n   }\n\n   nbucket = nbucket + 1;\n   len = len + 1;\n\n   strings = (char*) malloc(n * len);\n\n   for (long int i = 0; i < n; i++){\n      if (!fscanf(stdin, \"%s\", strings + (i * len))) {\n      printf (\"ERROR %ld\\n\",i);\n      exit (1);\n      }\n   }\n\n   *vString = strings;\n   *N = n;\n   *l = len;\n   *os = offset;\n   *nb = nbucket;\n}\n\nvoid print(char *strings, long int *index, long int n, int len){\n   for (long int i = 0; i < n; i++){\n      printf(\"%ld -> %s\\n\", i, strings + (index[i] * len));\n   }\n}\n\nvoid save(char *strings, long int *index, long int n, int len){\n   for (long int i = 0; i < n; i++){\n      printf(\"%s\\n\", strings + (index[i] * len));\n   }\n}\n\nint main(int ac, char **av) {\n\n   char     *strings = NULL;\n   long int N        = 0;\n   long int *index   = NULL;\n   int      len      = 0,\n            save2File = 0,\n            offset,\n            nbuckets;\n\n   load(&strings, &N, &len, &offset, &nbuckets);\n\n   index = bucket_sort(strings, len, N, offset, nbuckets);\n\n   save(strings, index, N, len);\n\n   if (strings != NULL)\n      free(strings);\n\n   if (index != NULL)\n      free(index);\n\n   return EXIT_SUCCESS;\n}\n",

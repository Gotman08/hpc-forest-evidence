#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include <immintrin.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

/*
 * Each body holds coordinate positions (i.e., x, y, and z) and
 * velocities (i.e., vx, vy, and vz).
 */
typedef struct { float x, y, z, vx, vy, vz; } Body;

/*
 * Compute the gravitational impact among all pairs of bodies in 
 * the system using AVX2 intrinsics.
 */
void body_force(Body *p, float dt, int n) {
  __m256 dt_vec = _mm256_set1_ps(dt);
  __m256 softening_vec = _mm256_set1_ps(SOFTENING);

  for (int i = 0; i < n; ++i) {
    float fx = 0.0f;
    float fy = 0.0f;
    float fz = 0.0f;

    __m256 fx_vec = _mm256_setzero_ps();
    __m256 fy_vec = _mm256_setzero_ps();
    __m256 fz_vec = _mm256_setzero_ps();

    for (int j = 0; j < n; j += 8) {
      __m256 dx = _mm256_sub_ps(_mm256_loadu_ps(&p[j].x), _mm256_set1_ps(p[i].x));
      __m256 dy = _mm256_sub_ps(_mm256_loadu_ps(&p[j].y), _mm256_set1_ps(p[i].y));
      __m256 dz = _mm256_sub_ps(_mm256_loadu_ps(&p[j].z), _mm256_set1_ps(p[i].z));

      __m256 sqrd_dist = _mm256_add_ps(_mm256_add_ps(_mm256_mul_ps(dx, dx), _mm256_mul_ps(dy, dy)), _mm256_add_ps(_mm256_mul_ps(dz, dz), softening_vec));
      __m256 inv_dist = _mm256_rcp_ps(_mm256_sqrt_ps(sqrd_dist));
      __m256 inv_dist3 = _mm256_mul_ps(_mm256_mul_ps(inv_dist, inv_dist), inv_dist);

      fx_vec = _mm256_add_ps(fx_vec, _mm256_mul_ps(dx, inv_dist3));
      fy_vec = _mm256_add_ps(fy_vec, _mm256_mul_ps(dy, inv_dist3));
      fz_vec = _mm256_add_ps(fz_vec, _mm256_mul_ps(dz, inv_dist3));
    }

    float fx_arr[8], fy_arr[8], fz_arr[8];
    _mm256_storeu_ps(fx_arr, fx_vec);
    _mm256_storeu_ps(fy_arr, fy_vec);
    _mm256_storeu_ps(fz_arr, fz_vec);

    for (int k = 0; k < 8; ++k) {
      fx += fx_arr[k];
      fy += fy_arr[k];
      fz += fz_arr[k];
    }

    p[i].vx += dt * fx;
    p[i].vy += dt * fy;
    p[i].vz += dt * fz;
  }
}

/*
 * Read a binary dataset with initilized bodies.
 */
Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  return bodies;
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc,char **argv) {
  int nbodies;

  Body *bodies = read_dataset(&nbodies);

  /*
   * At each simulation iteration, interbody forces are computed,
   * and bodies' positions are integrated.
   */
  for (int iter = 0; iter < N_ITER; iter++) {
    body_force(bodies, DT, nbodies);

    for (int i = 0; i < nbodies; i++) {
      bodies[i].x += bodies[i].vx * DT;
      bodies[i].y += bodies[i].vy * DT;
      bodies[i].z += bodies[i].vz * DT;
    }
  }

  write_dataset(nbodies, bodies);

  free(bodies);
  
  exit(EXIT_SUCCESS);
}

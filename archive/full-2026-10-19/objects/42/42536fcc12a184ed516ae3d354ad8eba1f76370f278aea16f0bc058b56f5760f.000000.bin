--- orchestrer-reprise-passive-R8-ROOT.ps1
+++ orchestrer-reprise-passive-R8-ROOT-r2.ps1
@@ -62,7 +62,7 @@
  throw 'Existing destination, including a dangling alias, is never reused'
 }
 function Sha([string]$path){Ordinary $path|Out-Null;return (Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash.ToLowerInvariant()}
-function Ref([string]$path){return [ordered]@{path=$path;sha256=(Sha $path)}}
+function Ref([string]$path){return [pscustomobject][ordered]@{path=$path;sha256=(Sha $path)}}
 function Read-Ref($reference){
  if($null -eq $reference -or ((@($reference.PSObject.Properties.Name|Sort-Object)) -join '|') -cne 'path|sha256' -or $reference.sha256 -cnotmatch '^[0-9a-f]{64}$'){throw 'Missing/malformed actual cold reference'}
  if((Sha $reference.path) -cne $reference.sha256){throw 'Actual cold reference changed'}
@@ -96,7 +96,7 @@
 if($PSScriptRoot -cne $own){throw 'Exact owned orchestration source directory required'}
 $reviewRef=[pscustomobject]@{path=$OrchestrationReview;sha256=$OrchestrationReviewSha256}
 $ownReview=Read-Ref $reviewRef
-Check-Review $ownReview 'hpc-forest-r8-direct-passive-orchestration-preparation-review-v1' @{ 'orchestrer-reprise-passive-R8-ROOT.ps1'=(Sha $PSCommandPath) }
+Check-Review $ownReview 'hpc-forest-r8-direct-passive-orchestration-preparation-review-v1' @{ 'orchestrer-reprise-passive-R8-ROOT-r2.ps1'=(Sha $PSCommandPath) }
 if($ownReview.direct_same_host_passive_only -ne $true){throw 'Only same-host passive orchestration is reviewed'}
 $inputRef=[pscustomobject]@{path=$ColdInput;sha256=$ColdInputSha256};$cold=Read-Ref $inputRef
 $coldNames=@('schema','approved_bindings','closure','closure_review','terminal','terminal_cold_review','qualification','qualification_consumer','lifecycle_review','passive_four_review','lifecycle_tests','copier_review','copier_tests','receiver_review','receiver_tests')

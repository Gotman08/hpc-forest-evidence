      "content": "#include \"knn.h\"\n#include <arm_neon.h>\n#include <omp.h>\n#include <float.h>\n\n// Max-heap node (1-indexed)\ntypedef struct {\n    float dist;\n    char label;\n} HeapNode;\n\nstatic inline void heap_swap(HeapNode *a, HeapNode *b) {\n    HeapNode t = *a; *a = *b; *b = t;\n}\n\n// Sift down from index idx in a max-heap of size heap_size (1-indexed)\nstatic inline void sift_down(HeapNode *heap, int heap_size, int idx) {\n    while (1) {\n        int largest = idx;\n        int left = 2 * idx;\n        int right = 2 * idx + 1;\n        if (left <= heap_size && heap[left].dist > heap[largest].dist)\n            largest = left;\n        if (right <= heap_size && heap[right].dist > heap[largest].dist)\n            largest = right;\n        if (largest == idx) break;\n        heap_swap(&heap[idx], &heap[largest]);\n        idx = largest;\n    }\n}\n\n// Insert or replace in a max-heap of capacity k.\nstatic inline void heap_insert_or_replace(float d, char label,\n                                          HeapNode *heap, int *heap_size_ptr, int k) {\n    int hs = *heap_size_ptr;\n    if (hs < k) {\n        // Insert at end and bubble up\n        hs++;\n        int idx = hs;\n        heap[idx].dist = d;\n        heap[idx].label = label;\n        while (idx > 1 && heap[idx / 2].dist < heap[idx].dist) {\n            heap_swap(&heap[idx], &heap[idx / 2]);\n            idx /= 2;\n        }\n    } else if (d < heap[1].dist) {\n        // Replace root\n        heap[1].dist = d;\n        heap[1].label = label;\n        sift_down(heap, k, 1);\n    }\n    *heap_size_ptr = hs;\n}\n\n// Comparison function for qsort (signed char ordering)\nstatic int cmp_char(const void *a, const void *b) {\n    return *(const signed char *)a - *(const signed char *)b;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    // Determine number of threads once (outside parallel region)\n    int max_threads = omp_get_max_threads();\n    if (max_threads < 1) max_threads = 1;\n\n    // Per-thread heaps: each thread gets a heap array of size k+1 and its current size.\n    HeapNode **thread_heaps = (HeapNode**) malloc(max_threads * sizeof(HeapNode*));\n    int *thread_sizes = (int*) calloc(max_threads, sizeof(int));\n\n    for (int t = 0; t < max_threads; t++) {\n        thread_heaps[t] = (HeapNode*) malloc((k + 1) * sizeof(HeapNode));\n        // Initialize with sentinel values: large distance and invalid label.\n        for (int i = 1; i <= k; i++) {\n            thread_heaps[t][i].dist = FLT_MAX;\n            thread_heaps[t][i].label = -1;\n        }\n    }\n\n    // Hoist query point coordinates outside parallel region\n    float tx = to_evaluate.x;\n    float ty = to_evaluate.y;\n\n    #pragma omp parallel\n    {\n        int tid = omp_get_thread_num();\n        HeapNode *local_heap = thread_heaps[tid];\n        int local_size = 0;   // persistent across iterations for this thread\n\n        #pragma omp for schedule(guided)\n        for (int gi = 0; gi < n_groups; gi++) {\n            Group g = groups[gi];\n            float *xs = g.xs;\n            float *ys = g.ys;\n            int len = g.length;\n            char label = g.label;\n\n            // Process points in batches of 4 using NEON SIMD with prefetching\n            int j = 0;\n            for (; j + 3 < len; j += 4) {\n                __builtin_prefetch(xs + j + 16);\n                __builtin_prefetch(ys + j + 16);\n\n                float32x4_t x_vec = vld1q_f32(xs + j);\n                float32x4_t y_vec = vld1q_f32(ys + j);\n\n                float32x4_t dx = vsubq_f32(x_vec, vdupq_n_f32(tx));\n                float32x4_t dy = vsubq_f32(y_vec, vdupq_n_f32(ty));\n                // dist_sq = dx*dx + dy*dy\n                float32x4_t dist_sq = vmlaq_f32(vmulq_f32(dx, dx), dy, dy);\n\n                float d[4];\n                vst1q_f32(d, dist_sq);\n\n                for (int t = 0; t < 4; t++) {\n                    heap_insert_or_replace(d[t], label, local_heap, &local_size, k);\n                }\n            }\n\n            // Scalar remainder\n            for (; j < len; j++) {\n                float dx = xs[j] - tx;\n                float dy = ys[j] - ty;\n                float d = dx*dx + dy*dy;\n                heap_insert_or_replace(d, label, local_heap, &local_size, k);\n            }\n        }\n\n        thread_sizes[tid] = local_size;\n    } // end parallel region\n\n    // Global max-heap to merge per-thread results\n    HeapNode *global_heap = (HeapNode*) malloc((k + 1) * sizeof(HeapNode));\n    for (int i = 1; i <= k; i++) {\n        global_heap[i].dist = FLT_MAX;\n        global_heap[i].label = -1;\n    }\n    int global_size = 0;\n\n    // Merge all per-thread heaps into the global heap\n    for (int t = 0; t < max_threads; t++) {\n        HeapNode *local = thread_heaps[t];\n        int sz = thread_sizes[t];\n        if (sz > k) sz = k;\n        for (int i = 1; i <= sz; i++) {\n            heap_insert_or_replace(local[i].dist, local[i].label,\n                                   global_heap, &global_size, k);\n        }\n    }\n\n    // Extract labels from the final global heap into a plain array for frequency counting.\n    char *labels = (char*) malloc(k * sizeof(char));\n    int actual_k = (global_size < k) ? global_size : k;\n    for (int i = 0; i < actual_k; i++) {\n        labels[i] = global_heap[i + 1].label;\n    }\n    // Fill remaining with -1 if not enough points\n    for (int i = actual_k; i < k; i++) {\n        labels[i] = -1;\n    }\n\n    free(global_heap);\n    for (int t = 0; t < max_threads; t++) {\n        free(thread_heaps[t]);\n    }\n    free(thread_heaps);\n    free(thread_sizes);\n\n    // Sort labels to match baseline tie-breaking behavior\n    qsort(labels, k, sizeof(char), cmp_char);\n\n    // Find most frequent label using linear scan (strictly greater)\n    char best_label = labels[0];\n    int best_count = 1;\n    int current_count = 1;\n    for (int i = 1; i < k; i++) {\n        if (labels[i] == labels[i - 1]) {\n            current_count++;\n        } else {\n            if (current_count > best_count) {\n                best_count = current_count;\n                best_label = labels[i - 1];\n            }\n            current_count = 1;\n        }\n    }\n    // Handle last group\n    if (current_count > best_count) {\n        best_label = labels[k - 1];\n    }\n\n    free(labels);\n    return best_label;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n\n    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; ++i) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Integrating SoA storage with NEON SIMD distance computation and software prefetching (B), max-heap top-k selection (A), and OpenMP parallelization over groups with per-thread heaps plus guided scheduling (C) will yield a correct program that is faster than any single transformation. Hoisting query coordinates outside the parallel region and adding explicit prefetches reduces memory latency, while the deterministic qsort-based tie-breaking ensures exact baseline output.",
  "notes": "Kept all three source transformations: interleaved coordinate idea from A (though not directly used due to SoA input), NEON+prefetch from B, OpenMP parallelism from C. The code uses per-thread max-heaps merged into a global heap, then sorts labels and finds most frequent label exactly as the baseline does.",

{
  "src/model-view/primetest.c": "#include <ctype.h>\n#include <inttypes.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n\n#define SMALL_PRIME_LIMIT 13u\n\ntypedef struct {\n    uint64_t value;\n    uint64_t scale;\n} Fragment;\n\nstatic char *read_token(FILE *stream)\n{\n    int ch;\n    size_t capacity = 32;\n    size_t length = 0;\n    char *token;\n\n    do {\n        ch = fgetc(stream);\n    } while (ch != EOF && isspace((unsigned char)ch));\n    if (ch == EOF)\n        return NULL;\n\n    token = malloc(capacity);\n    if (token == NULL)\n        return NULL;\n\n    while (ch != EOF && !isspace((unsigned char)ch)) {\n        if (length + 1 >= capacity) {\n            size_t new_capacity;\n            char *resized;\n\n            if (capacity > SIZE_MAX / 2) {\n                free(token);\n                return NULL;\n            }\n            new_capacity = capacity * 2;\n            resized = realloc(token, new_capacity);\n            if (resized == NULL) {\n                free(token);\n                return NULL;\n            }\n            token = resized;\n            capacity = new_capacity;\n        }\n        token[length++] = (char)ch;\n        ch = fgetc(stream);\n    }\n    token[length] = '\\0';\n    return token;\n}\n\nstatic int parse_fragment(const char *text, Fragment *fragment)\n{\n    uint64_t value = 0;\n    uint64_t scale = 1;\n    const unsigned char *p = (const unsigned char *)text;\n\n    if (*p == '\\0')\n        return 0;\n    for (; *p != '\\0'; ++p) {\n        unsigned digit;\n\n        if (*p < '0' || *p > '9')\n            return 0;\n        digit = (unsigned)(*p - '0');\n        if (value > (UINT64_MAX - digit) / 10 || scale > UINT64_MAX / 10)\n            return 0;\n        value = value * 10 + digit;\n        scale *= 10;\n    }\n    fragment->value = value;\n    fragment->scale = scale;\n    return 1;\n}\n\nstatic uint64_t integer_sqrt(uint64_t value)\n{\n    uint64_t low = 0;\n    uint64_t high = UINT32_MAX;\n\n    while (low < high) {\n        uint64_t middle = low + (high - low + 1) / 2;\n        if (middle <= value / middle)\n            low = middle;\n        else\n            high = middle - 1;\n    }\n    return low;\n}\n\nstatic int is_prime_from_sieve(uint64_t value, const uint32_t *primes,\n                               size_t prime_count, size_t first_prime)\n{\n    size_t i;\n\n    if (value < 2)\n        return 0;\n    for (i = first_prime; i < prime_count; ++i) {\n        uint64_t factor = primes[i];\n        if (factor > value / factor)\n            break;\n        if (value % factor == 0)\n            return 0;\n    }\n    return 1;\n}\n\nstatic int compare_u64(const void *left, const void *right)\n{\n    uint64_t a = *(const uint64_t *)left;\n    uint64_t b = *(const uint64_t *)right;\n    return (a > b) - (a < b);\n}\n\nint main(void)\n{\n    size_t count = 0;\n    size_t candidate_count;\n    size_t i;\n    size_t j;\n    size_t result_count = 0;\n    size_t sieve_size;\n    size_t prime_count = 0;\n    size_t prime_index = 0;\n    size_t first_large_prime = 0;\n    uint64_t maximum = 0;\n    uint64_t limit;\n    Fragment *left = NULL;\n    Fragment *right = NULL;\n    uint64_t *candidates = NULL;\n    uint8_t *composite = NULL;\n    uint8_t *small_factor_free = NULL;\n    uint32_t *primes = NULL;\n    int status = 1;\n\n    if (scanf(\"%zu\", &count) != 1 || count == 0)\n        return 0;\n    if (count > SIZE_MAX / sizeof(*left) ||\n        count > SIZE_MAX / sizeof(*right) ||\n        count > SIZE_MAX / count)\n        return 1;\n\n    candidate_count = count * count;\n    if (candidate_count > SIZE_MAX / sizeof(*candidates))\n        return 1;\n\n    left = malloc(count * sizeof(*left));\n    right = malloc(count * sizeof(*right));\n    candidates = malloc(candidate_count * sizeof(*candidates));\n    if (left == NULL || right == NULL || candidates == NULL)\n        goto cleanup;\n\n    for (i = 0; i < count; ++i) {\n        char *token = read_token(stdin);\n        int valid = token != NULL && parse_fragment(token, &left[i]);\n        free(token);\n        if (!valid)\n            goto cleanup;\n    }\n    for (i = 0; i < count; ++i) {\n        char *token = read_token(stdin);\n        int valid = token != NULL && parse_fragment(token, &right[i]);\n        free(token);\n        if (!valid)\n            goto cleanup;\n    }\n\n    for (i = 0; i < count; ++i) {\n        for (j = 0; j < count; ++j) {\n            size_t index = i * count + j;\n            uint64_t scale = right[j].scale;\n\n            if (left[i].value > (UINT64_MAX - right[j].value) / scale)\n                goto cleanup;\n            candidates[index] = left[i].value * scale + right[j].value;\n            if (candidates[index] > maximum)\n                maximum = candidates[index];\n        }\n    }\n\n    free(left);\n    left = NULL;\n    free(right);\n    right = NULL;\n\n    limit = integer_sqrt(maximum);\n    if (limit > (uint64_t)(SIZE_MAX - (size_t)1))\n        goto cleanup;\n    sieve_size = (size_t)limit + 1;\n    composite = calloc(sieve_size, sizeof(*composite));\n    if (composite == NULL)\n        goto cleanup;\n\n    for (uint64_t factor = 2; factor <= limit / factor; ++factor) {\n        if (!composite[(size_t)factor]) {\n            uint64_t multiple = factor * factor;\n            while (multiple <= limit) {\n                composite[(size_t)multiple] = 1;\n                multiple += factor;\n            }\n        }\n    }\n\n    for (uint64_t value = 2; value <= limit; ++value) {\n        if (!composite[(size_t)value])\n            ++prime_count;\n    }\n    if (prime_count > SIZE_MAX / sizeof(*primes))\n        goto cleanup;\n    if (prime_count != 0) {\n        primes = malloc(prime_count * sizeof(*primes));\n        if (primes == NULL)\n            goto cleanup;\n    }\n    for (uint64_t value = 2; value <= limit; ++value) {\n        if (!composite[(size_t)value])\n            primes[prime_index++] = (uint32_t)value;\n    }\n    free(composite);\n    composite = NULL;\n\n    while (first_large_prime < prime_count &&\n           primes[first_large_prime] <= SMALL_PRIME_LIMIT)\n        ++first_large_prime;\n\n    small_factor_free = malloc(candidate_count * sizeof(*small_factor_free));\n    if (small_factor_free == NULL)\n        goto cleanup;\n\n    #pragma GCC ivdep\n    for (i = 0; i < candidate_count; ++i) {\n        uint64_t value = candidates[i];\n\n        if (value <= SMALL_PRIME_LIMIT) {\n            small_factor_free[i] = (uint8_t)(\n                value == 2 || value == 3 || value == 5 || value == 7 ||\n                value == 11 || value == 13);\n        } else {\n            small_factor_free[i] = (uint8_t)(\n                ((value % 2) != 0) & ((value % 3) != 0) &\n                ((value % 5) != 0) & ((value % 7) != 0) &\n                ((value % 11) != 0) & ((value % 13) != 0));\n        }\n    }\n\n    for (i = 0; i < candidate_count; ++i) {\n        uint64_t value;\n\n        if (small_factor_free[i] == 0)\n            continue;\n        value = candidates[i];\n        if (value <= SMALL_PRIME_LIMIT ||\n            is_prime_from_sieve(value, primes, prime_count,\n                                first_large_prime))\n            candidates[result_count++] = value;\n    }\n\n    qsort(candidates, result_count, sizeof(*candidates), compare_u64);\n    for (i = 0; i < result_count; ++i)\n        printf(\"%\" PRIu64 \"\\n\", candidates[i]);\n\n    status = 0;\n\ncleanup:\n    free(left);\n    free(right);\n    free(candidates);\n    free(composite);\n    free(small_factor_free);\n    free(primes);\n    return status;\n}\n",
  "src/sources/primetest.c": "#include <ctype.h>\n#include <inttypes.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n\n#define SMALL_PRIME_LIMIT 13u\n\ntypedef struct {\n    uint64_t value;\n    uint64_t scale;\n} Fragment;\n\nstatic char *read_token(FILE *stream)\n{\n    int ch;\n    size_t capacity = 32;\n    size_t length = 0;\n    char *token;\n\n    do {\n        ch = fgetc(stream);\n    } while (ch != EOF && isspace((unsigned char)ch));\n    if (ch == EOF)\n        return NULL;\n\n    token = malloc(capacity);\n    if (token == NULL)\n        return NULL;\n\n    while (ch != EOF && !isspace((unsigned char)ch)) {\n        if (length + 1 >= capacity) {\n            size_t new_capacity;\n            char *resized;\n\n            if (capacity > SIZE_MAX / 2) {\n                free(token);\n                return NULL;\n            }\n            new_capacity = capacity * 2;\n            resized = realloc(token, new_capacity);\n            if (resized == NULL) {\n                free(token);\n                return NULL;\n            }\n            token = resized;\n            capacity = new_capacity;\n        }\n        token[length++] = (char)ch;\n        ch = fgetc(stream);\n    }\n    token[length] = '\\0';\n    return token;\n}\n\nstatic int parse_fragment(const char *text, Fragment *fragment)\n{\n    uint64_t value = 0;\n    uint64_t scale = 1;\n    const unsigned char *p = (const unsigned char *)text;\n\n    if (*p == '\\0')\n        return 0;\n    for (; *p != '\\0'; ++p) {\n        unsigned digit;\n\n        if (*p < '0' || *p > '9')\n            return 0;\n        digit = (unsigned)(*p - '0');\n        if (value > (UINT64_MAX - digit) / 10 || scale > UINT64_MAX / 10)\n            return 0;\n        value = value * 10 + digit;\n        scale *= 10;\n    }\n    fragment->value = value;\n    fragment->scale = scale;\n    return 1;\n}\n\nstatic uint64_t integer_sqrt(uint64_t value)\n{\n    uint64_t low = 0;\n    uint64_t high = UINT32_MAX;\n\n    while (low < high) {\n        uint64_t middle = low + (high - low + 1) / 2;\n        if (middle <= value / middle)\n            low = middle;\n        else\n            high = middle - 1;\n    }\n    return low;\n}\n\nstatic int is_prime_from_sieve(uint64_t value, const uint32_t *primes,\n                               size_t prime_count, size_t first_prime)\n{\n    size_t i;\n\n    if (value < 2)\n        return 0;\n    for (i = first_prime; i < prime_count; ++i) {\n        uint64_t factor = primes[i];\n        if (factor > value / factor)\n            break;\n        if (value % factor == 0)\n            return 0;\n    }\n    return 1;\n}\n\nstatic int compare_u64(const void *left, const void *right)\n{\n    uint64_t a = *(const uint64_t *)left;\n    uint64_t b = *(const uint64_t *)right;\n    return (a > b) - (a < b);\n}\n\nint main(void)\n{\n    size_t count = 0;\n    size_t candidate_count;\n    size_t i;\n    size_t j;\n    size_t result_count = 0;\n    size_t sieve_size;\n    size_t prime_count = 0;\n    size_t prime_index = 0;\n    size_t first_large_prime = 0;\n    uint64_t maximum = 0;\n    uint64_t limit;\n    Fragment *left = NULL;\n    Fragment *right = NULL;\n    uint64_t *candidates = NULL;\n    uint8_t *composite = NULL;\n    uint8_t *small_factor_free = NULL;\n    uint32_t *primes = NULL;\n    int status = 1;\n\n    if (scanf(\"%zu\", &count) != 1 || count == 0)\n        return 0;\n    if (count > SIZE_MAX / sizeof(*left) ||\n        count > SIZE_MAX / sizeof(*right) ||\n        count > SIZE_MAX / count)\n        return 1;\n\n    candidate_count = count * count;\n    if (candidate_count > SIZE_MAX / sizeof(*candidates))\n        return 1;\n\n    left = malloc(count * sizeof(*left));\n    right = malloc(count * sizeof(*right));\n    candidates = malloc(candidate_count * sizeof(*candidates));\n    if (left == NULL || right == NULL || candidates == NULL)\n        goto cleanup;\n\n    for (i = 0; i < count; ++i) {\n        char *token = read_token(stdin);\n        int valid = token != NULL && parse_fragment(token, &left[i]);\n        free(token);\n        if (!valid)\n            goto cleanup;\n    }\n    for (i = 0; i < count; ++i) {\n        char *token = read_token(stdin);\n        int valid = token != NULL && parse_fragment(token, &right[i]);\n        free(token);\n        if (!valid)\n            goto cleanup;\n    }\n\n    for (i = 0; i < count; ++i) {\n        for (j = 0; j < count; ++j) {\n            size_t index = i * count + j;\n            uint64_t scale = right[j].scale;\n\n            if (left[i].value > (UINT64_MAX - right[j].value) / scale)\n                goto cleanup;\n            candidates[index] = left[i].value * scale + right[j].value;\n            if (candidates[index] > maximum)\n                maximum = candidates[index];\n        }\n    }\n\n    free(left);\n    left = NULL;\n    free(right);\n    right = NULL;\n\n    limit = integer_sqrt(maximum);\n    if (limit > (uint64_t)(SIZE_MAX - (size_t)1))\n        goto cleanup;\n    sieve_size = (size_t)limit + 1;\n    composite = calloc(sieve_size, sizeof(*composite));\n    if (composite == NULL)\n        goto cleanup;\n\n    for (uint64_t factor = 2; factor <= limit / factor; ++factor) {\n        if (!composite[(size_t)factor]) {\n            uint64_t multiple = factor * factor;\n            while (multiple <= limit) {\n                composite[(size_t)multiple] = 1;\n                multiple += factor;\n            }\n        }\n    }\n\n    for (uint64_t value = 2; value <= limit; ++value) {\n        if (!composite[(size_t)value])\n            ++prime_count;\n    }\n    if (prime_count > SIZE_MAX / sizeof(*primes))\n        goto cleanup;\n    if (prime_count != 0) {\n        primes = malloc(prime_count * sizeof(*primes));\n        if (primes == NULL)\n            goto cleanup;\n    }\n    for (uint64_t value = 2; value <= limit; ++value) {\n        if (!composite[(size_t)value])\n            primes[prime_index++] = (uint32_t)value;\n    }\n    free(composite);\n    composite = NULL;\n\n    while (first_large_prime < prime_count &&\n           primes[first_large_prime] <= SMALL_PRIME_LIMIT)\n        ++first_large_prime;\n\n    small_factor_free = malloc(candidate_count * sizeof(*small_factor_free));\n    if (small_factor_free == NULL)\n        goto cleanup;\n\n    #pragma GCC ivdep\n    for (i = 0; i < candidate_count; ++i) {\n        uint64_t value = candidates[i];\n\n        if (value <= SMALL_PRIME_LIMIT) {\n            small_factor_free[i] = (uint8_t)(\n                value == 2 || value == 3 || value == 5 || value == 7 ||\n                value == 11 || value == 13);\n        } else {\n            small_factor_free[i] = (uint8_t)(\n                ((value % 2) != 0) & ((value % 3) != 0) &\n                ((value % 5) != 0) & ((value % 7) != 0) &\n                ((value % 11) != 0) & ((value % 13) != 0));\n        }\n    }\n\n    for (i = 0; i < candidate_count; ++i) {\n        uint64_t value;\n\n        if (small_factor_free[i] == 0)\n            continue;\n        value = candidates[i];\n        if (value <= SMALL_PRIME_LIMIT ||\n            is_prime_from_sieve(value, primes, prime_count,\n                                first_large_prime))\n            candidates[result_count++] = value;\n    }\n\n    qsort(candidates, result_count, sizeof(*candidates), compare_u64);\n    for (i = 0; i < result_count; ++i)\n        printf(\"%\" PRIu64 \"\\n\", candidates[i]);\n\n    status = 0;\n\ncleanup:\n    free(left);\n    free(right);\n    free(candidates);\n    free(composite);\n    free(small_factor_free);\n    free(primes);\n    return status;\n}\n"
}

{"files":[{"content":"#include \"knn.h\"\n#include <stdint.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nstatic char choose_label(char * labels, int k) {\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nstatic char knn_reference_scan(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    char result = choose_label(labels, k);\n    free(distances);\n    free(labels);\n    return result;\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    if (k <= 0) {\n        return knn_reference_scan(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t total_points = 0;\n    for (int i = 0; i < n_groups; i++) {\n        total_points += (size_t) groups[i].length;\n    }\n\n    if (total_points == 0) {\n        return knn_reference_scan(n_groups, groups, k, to_evaluate);\n    }\n\n    int partitions = 1;\n#ifdef _OPENMP\n    if (!omp_in_parallel()) {\n        int maximum_threads = omp_get_max_threads();\n        size_t useful_partitions = total_points / 16384u;\n        if ((size_t) maximum_threads > useful_partitions) {\n            maximum_threads = (int) useful_partitions;\n        }\n        if (maximum_threads > 1) {\n            partitions = maximum_threads;\n        }\n    }\n#endif\n\n    size_t points_per_partition = total_points / (size_t) partitions;\n    size_t extra_points = total_points % (size_t) partitions;\n    size_t largest_partition = points_per_partition + (extra_points != 0);\n    int capacity = k;\n    if (largest_partition < (size_t) capacity) {\n        capacity = (int) largest_partition;\n    }\n\n    if ((size_t) partitions > SIZE_MAX / (size_t) capacity / sizeof(float)) {\n        return knn_reference_scan(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t slots = (size_t) partitions * (size_t) capacity;\n    float * local_distances = (float *) malloc(slots * sizeof(float));\n    char * local_labels = (char *) malloc(slots * sizeof(char));\n    int * counts = (int *) malloc((size_t) partitions * sizeof(int));\n    int * heads = (int *) calloc((size_t) partitions, sizeof(int));\n    char * labels = (char *) malloc((size_t) k * sizeof(char));\n\n    if (!local_distances || !local_labels || !counts || !heads || !labels) {\n        free(local_distances);\n        free(local_labels);\n        free(counts);\n        free(heads);\n        free(labels);\n        return knn_reference_scan(n_groups, groups, k, to_evaluate);\n    }\n\n    int has_nan = 0;\n#ifdef _OPENMP\n#pragma omp parallel for schedule(static) num_threads(partitions) if(partitions > 1) reduction(|:has_nan)\n#endif\n    for (int part = 0; part < partitions; part++) {\n        float * distances = local_distances + (size_t) part * (size_t) capacity;\n        char * part_labels = local_labels + (size_t) part * (size_t) capacity;\n        int used = 0;\n        size_t part_index = (size_t) part;\n        size_t begin = part_index * points_per_partition\n                     + (part_index < extra_points ? part_index : extra_points);\n        size_t end = begin + points_per_partition + (part_index < extra_points);\n        size_t group_start = 0;\n\n        for (int i = 0; i < n_groups && group_start < end; i++) {\n            Group g = groups[i];\n            size_t group_end = group_start + (size_t) g.length;\n\n            if (group_end > begin) {\n                size_t first = begin > group_start ? begin - group_start : 0;\n                size_t last = end < group_end ? end - group_start : (size_t) g.length;\n\n                for (size_t j = first; j < last; j++) {\n                    float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n                    if (d != d) {\n                        has_nan = 1;\n                        continue;\n                    }\n\n                    if (used == capacity && !(d < distances[used - 1])) {\n                        continue;\n                    }\n\n                    int position = used;\n                    if (used < capacity) {\n                        used++;\n                    } else {\n                        position--;\n                    }\n\n                    while (position > 0 && d < distances[position - 1]) {\n                        distances[position] = distances[position - 1];\n                        part_labels[position] = part_labels[position - 1];\n                        position--;\n                    }\n                    distances[position] = d;\n                    part_labels[position] = g.label;\n                }\n            }\n            group_start = group_end;\n        }\n        counts[part] = used;\n    }\n\n    if (has_nan) {\n        free(local_distances);\n        free(local_labels);\n        free(counts);\n        free(heads);\n        free(labels);\n        return knn_reference_scan(n_groups, groups, k, to_evaluate);\n    }\n\n    int selected = total_points < (size_t) k ? (int) total_points : k;\n    for (int i = 0; i < selected; i++) {\n        int best = -1;\n        float best_distance = 0;\n\n        /* Earlier partitions win equal-distance ties, matching input order. */\n        for (int part = 0; part < partitions; part++) {\n            if (heads[part] < counts[part]) {\n                size_t slot = (size_t) part * (size_t) capacity + (size_t) heads[part];\n                float d = local_distances[slot];\n                if (best < 0 || d < best_distance) {\n                    best = part;\n                    best_distance = d;\n                }\n            }\n        }\n\n        size_t slot = (size_t) best * (size_t) capacity + (size_t) heads[best];\n        labels[i] = local_labels[slot];\n        heads[best]++;\n    }\n    for (int i = selected; i < k; i++) {\n        labels[i] = -1;\n    }\n\n    char result = choose_label(labels, k);\n    free(local_distances);\n    free(local_labels);\n    free(counts);\n    free(heads);\n    free(labels);\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n","path":"src/knn.c"}],"hypothesis":"Point-balanced OpenMP partitions with private top-k lists and a deterministic merge can accelerate classification without shared insertion contention or changed tie behavior.","notes":"Not executed. Parsing and output formatting are unchanged. Serial builds remain supported; NaN distances use the reference scan.","sources_kept":[],"transformations":["Statically distribute contiguous point partitions, requesting at least 16,384 points per worker and avoiding nested teams.","Maintain stable private top-k lists with constant-time rejection beyond the local cutoff.","Merge lists with original-order distance ties, preserve reference voting, and release per-call buffers."]}
"""Crosscheck selected public identifiers against already archived CLI artifacts."""
import datetime
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
BASE = HERE.parents[3]
PREP = HERE.parents[1]


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def ref(path):
    return {"path": str(path.resolve()), "sha256": sha(path)}


diagnostic_path = PREP / "diagnostic-isolation-cli-r2/DIAGNOSTIC.json"
diagnostic = json.loads(diagnostic_path.read_text("utf8"))
tokens = ("AgentRoleToml", "RawAgentRoleFileToml", "config_file", "agent_roles",
          "role_discovery", "roles_dir", "CODEX_AGENT", "nickname_candidates")
crosschecks = []
for archived in diagnostic["local_sources"]:
    path = Path(archived["path"])
    data = path.read_bytes()
    assert hashlib.sha256(data).hexdigest() == archived["sha256"]
    counts = {token: data.count(token.encode("ascii")) for token in tokens}
    crosschecks.append({"archive": archived, "bytes": len(data), "exact_lexical_counts": counts})
scope = {
    "schema": "hpc-forest-static-agent-role-discovery-archive-crosscheck-v1",
    "archives": crosschecks, "no_files_outside_closed_archived_source_list_read": True,
    "new_help_or_CLI_execution": False, "presence_not_role_discovery_exclusion_proof": True,
}
with (HERE / "RECOUPEMENT-AIDES-SCHEMAS.json").open("x", encoding="utf8") as output:
    output.write(json.dumps(scope, indent=2) + "\n")
scan = json.loads((HERE / "IDENTIFIANTS-ET-OFFSETS.json").read_text("utf8"))
assert sha(Path(scan["binary"]["path"])) == scan["binary"]["sha256"]
result = {
    "schema": "hpc-forest-task-scoped-role-discovery-binary-bounded-followup-v1",
    "verified": True,
    "verified_scope": "Only exact lexical identifiers, selected public descriptor fragments and archived-document crosschecks",
    "created_at_utc": datetime.datetime.now(datetime.UTC).isoformat(),
    "binary": scan["binary"],
    "new_single_investigation_lane": "AgentRole serialization/configuration descriptors and discovery.rs public diagnostics",
    "previous_loader_window_not_read": scan["previous_window_not_read"],
    "new_anchor_facts": [
        {"offset": 265288002, "symbol": "AgentRoleToml", "nearby_identifier_runs": ["description", "config_file", "nickname_candidates"]},
        {"offset": 265293413, "symbol": "AgentRoleFileToml", "descriptor_at_265293410": "RawAgentRoleFileToml"},
        {"offset": 264780942, "public_source_path": "agent-roles\\src\\discovery.rs"},
        {"offset": 264780457, "public_diagnostic_fragment": "duplicate agent role name `"},
        {"offset": 264780841, "public_diagnostic_fragment": "#.config_file must point to a file: "},
        {"offset": 264780888, "public_diagnostic_fragment": "/.config_file must point to an existing file at "},
    ],
    "bounded_token_negative_facts": {
        "AgentRoles": 0, "AgentRoleConfig": 0, "AgentRolesConfig": 0,
        "role_discovery": 0, "roles_dir": 0, "role_paths": 0, "CODEX_ROLE": 0,
    },
    "uppercase_CODEX_AGENT_lexical_lane": "First20 occurrences lead only to public identity JWKS/AuthAPI endpoint identifier runs; no value read and no auth change proposed",
    "new_supported_task_scoped_control_found": False,
    "role_discovery_exclusion_proven": False,
    "config_file_override_precedence_or_malformed_file_bypass_proven": False,
    "argv_proposed_or_executed": False,
    "bounded_conclusion": "The new symbols corroborate a per-role config_file representation and loader file/name validators only. The inspected archived CLI help/protocol schemas do not establish a discovery exclusion or an override that prevents parsing the malformed global role. No usable new control is proven in this bounded lane.",
    "uncertainties": [
        "Compiled adjacent identifier fragments do not establish TOML field boundaries, accepted grammar, precedence or reachability",
        "Duplicate-name diagnostics do not establish whether discovered files are parsed before overrides",
        "A bounded exact-token scan cannot prove global absence of an undocumented control",
        "Public source paths embedded in a binary are not local source code or a runtime call-path proof",
    ],
    "evidence_refs": [ref(diagnostic_path)] + [ref(HERE / name) for name in (
        "IDENTIFIANTS-ET-OFFSETS.json", "SYMBOLES-PUBLICS-BORNES.json", "DESCRIPTEURS-PUBLICS-CIBLES.json",
        "RECOUPEMENT-AIDES-SCHEMAS.json", "sonder-identifiants-publics.py",
        "extraire-symboles-cibles.py", "lire-descripteurs-publics.py")],
    "CLI_appserver_model_MCP_SSH_job_network_calls": 0,
    "role_global_config_auth_model_bodies_read": False,
    "global_or_production_files_modified": False,
    "native_admission": False,
}
with (HERE / "PISTE-BINAIRE-BORNEE-NON-ADMISE.json").open("x", encoding="utf8") as output:
    output.write(json.dumps(result, indent=2) + "\n")
print(json.dumps({"report": ref(HERE / "PISTE-BINAIRE-BORNEE-NON-ADMISE.json"),
                  "crosschecks": [{"path": row["archive"]["path"], "counts": row["exact_lexical_counts"]}
                                  for row in crosschecks]}, indent=2))

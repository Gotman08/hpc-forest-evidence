    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <math.h>\\n#include <omp.h>\\n\\n#define N_ITER 10 // number of simulation iterations\\n#define DT 0.01f // time step\\n#define SOFTENING 1e-9f // to avoid zero divisors\\n\\n/*\\n * Compute the gravitational impact among all pairs of bodies in \\n * the system. Uses SoA layout, tiling for cache locality,\\n * aligned memory, restrict qualifiers and SIMD vectorization.\\n */\\nvoid body_force(float *restrict x, float *restrict y, float *restrict z,\\n                float *restrict vx, float *restrict vy, float *restrict vz,\\n                int n, float dt) {\\n    const int IBLOCK = 16;\\n    const int JBLOCK = 256;\\n\\n#pragma omp for schedule(static)\\n    for (int ii = 0; ii < n; ii += IBLOCK) {\\n        int i_end = ii + IBLOCK;\\n        if (i_end > n) i_end = n;\\n\\n        // Local accumulators for each body in the block\\n        float fx[IBLOCK], fy[IBLOCK], fz[IBLOCK];\\n        for (int ib = 0; ib < i_end - ii; ++ib) {\\n            fx[ib] = 0.0f;\\n            fy[ib] = 0.0f;\\n            fz[ib] = 0.0f;\\n        }\\n\\n        for (int jj = 0; jj < n; jj += JBLOCK) {\\n            int j_end = jj + JBLOCK;\\n            if (j_end > n) j_end = n;\\n\\n            // Process all pairs in this tile\\n            for (int ib = ii; ib < i_end; ++ib) {\\n                float pix = x[ib];\\n                float piy = y[ib];\\n                float piz = z[ib];\\n                int idx = ib - ii;\\n                float fxx = fx[idx], fyy = fy[idx], fzz = fz[idx];\\n\\n#pragma omp simd reduction(+:fxx,fyy,fzz) aligned(x,y,z:16)\\n                for (int jb = jj; jb < j_end; ++jb) {\\n                    float dx = x[jb] - pix;\\n                    float dy = y[jb] - piy;\\n                    float dz = z[jb] - piz;\\n                    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n                    float inv_dist = 1.0f / sqrt(sqrd_dist);\\n                    float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n\\n                    fxx += dx * inv_dist3;\\n                    fyy += dy * inv_dist3;\\n                    fzz += dz * inv_dist3;\\n                }\\n\\n                fx[idx] = fxx;\\n                fy[idx] = fyy;\\n                fz[idx] = fzz;\\n            }\\n        }\\n\\n        // Update velocities for this block\\n        for (int ib = ii; ib < i_end; ++ib) {\\n            int idx = ib - ii;\\n            vx[ib] += dt * fx[idx];\\n            vy[ib] += dt * fy[idx];\\n            vz[ib] += dt * fz[idx];\\n        }\\n    }\\n}\\n\\n/*\\n * Read a binary dataset with initialized bodies.\\n * Allocates 16-byte aligned SoA arrays and converts from AoS input.\\n */\\nvoid read_dataset(int *nbodies, float **restrict x, float **restrict y,\\n                  float **restrict z, float **restrict vx,\\n                  float **restrict vy, float **restrict vz) {\\n    int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\\n    if (b != 1) {\\n        fprintf(stderr,\\\"\\\\nError reading nbodie value\\\\n\\\");\\n        exit(EXIT_FAILURE);\\n    }\\n\\n    size_t alignment = 16;\\n    size_t sz = (*nbodies) * sizeof(float);\\n\\n    if (posix_memalign((void**)x, alignment, sz) != 0 ||\\n        posix_memalign((void**)y, alignment, sz) != 0 ||\\n        posix_memalign((void**)z, alignment, sz) != 0 ||\\n        posix_memalign((void**)vx, alignment, sz) != 0 ||\\n        posix_memalign((void**)vy, alignment, sz) != 0 ||\\n        posix_memalign((void**)vz, alignment, sz) != 0) {\\n        fprintf(stderr,\\\"\\\\nError allocating aligned memory\\\\n\\\");\\n        exit(EXIT_FAILURE);\\n    }\\n\\n    // Read interleaved AoS data and transpose to SoA\\n    float *tmp = (float*)malloc(*nbodies * 6 * sizeof(float));\\n    if (!tmp) {\\n        fprintf(stderr,\\\"\\\\nError allocating temporary buffer\\\\n\\\");\\n        exit(EXIT_FAILURE);\\n    }\\n    b = fread(tmp, *nbodies * 6 * sizeof(float), 1, stdin);\\n    if (b != 1) {\\n        fprintf(stderr,\\\"\\\\nError reading input values\\\\n\\\");\\n        exit(EXIT_FAILURE);\\n    }\\n\\n    for (int i = 0; i < *nbodies; ++i) {\\n        (*x)[i] = tmp[i*6 + 0];\\n        (*y)[i] = tmp[i*6 + 1];\\n        (*z)[i] = tmp[i*6 + 2];\\n        (*vx)[i] = tmp[i*6 + 3];\\n        (*vy)[i] = tmp[i*6 + 4];\\n        (*vz)[i] = tmp[i*6 + 5];\\n    }\\n\\n    free(tmp);\\n}\\n\\n/*\\n * Write simulation results into a binary dataset (SoA -> AoS).\\n */\\nvoid write_dataset(const int nbodies, const float *restrict x,\\n                   const float *restrict y, const float *restrict z,\\n                   const float *restrict vx, const float *restrict vy,\\n                   const float *restrict vz) {\\n    // Convert SoA back to AoS for output\\n    float *tmp = (float*)malloc(nbodies * 6 * sizeof(float));\\n    if (!tmp) {\\n        fprintf(stderr,\\\"\\\\nError allocating temporary buffer\\\\n\\\");\\n        exit(EXIT_FAILURE);\\n    }\\n    for (int i = 0; i < nbodies; ++i) {\\n        tmp[i*6 + 0] = x[i];\\n        tmp[i*6 + 1] = y[i];\\n        tmp[i*6 + 2] = z[i];\\n        tmp[i*6 + 3] = vx[i];\\n        tmp[i*6 + 4] = vy[i];\\n        tmp[i*6 + 5] = vz[i];\\n    }\\n\\n    int b = fwrite(tmp, nbodies * 6 * sizeof(float), 1, stdout);\\n    if (b != 1) {\\n        fprintf(stderr,\\\"\\\\nError writing to output\\\\n\\\");\\n        exit(EXIT_FAILURE);\\n    }\\n\\n    free(tmp);\\n}\\n\\nint main(int argc, char **argv) {\\n    int nbodies;\\n    float *x = NULL, *y = NULL, *z = NULL;\\n    float *vx = NULL, *vy = NULL, *vz = NULL;\\n\\n    read_dataset(&nbodies, &x, &y, &z, &vx, &vy, &vz);\\n\\n    /*\\n     * Single parallel region around the entire time-stepping loop to reduce\\n     * fork-join overhead. Inside it, worksharing distributes both force\\n     * computation and position update across threads.\\n     */\\n#pragma omp parallel default(none) shared(x,y,z,vx,vy,vz,nbodies)\\n    {\\n        for (int iter = 0; iter < N_ITER; ++iter) {\\n            body_force(x, y, z, vx, vy, vz, nbodies, DT);\\n\\n#pragma omp for schedule(static)\\n            for (int i = 0; i < nbodies; ++i) {\\n                x[i] += vx[i] * DT;\\n                y[i] += vy[i] * DT;\\n                z[i] += vz[i] * DT;\\n            }\\n        }\\n    }\\n\\n    write_dataset(nbodies, x, y, z, vx, vy, vz);\\n\\n    free(x); free(y); free(z);\\n    free(vx); free(vy); free(vz);\\n\\n    exit(EXIT_SUCCESS);\\n}\\n\",\n      \"path\": \"src/nbody.c\"\n    }\n  ],\n  \"hypothesis\": \"Integrating SoA layout with tiling (IBLOCK=16, JBLOCK=256) from source A, aligned allocation and restrict qualifiers plus SIMD reduction pragma on the inner j-block loop from source B, and a single OpenMP parallel region around the entire time-stepping loop with schedule(static) for both force computation and position update from source C will combine cache efficiency, vectorization, thread-level parallelism, and reduced fork-join overhead to achieve further speedup beyond any individual transformation.\",\n  \"notes\": \"Combined best elements: tiling (A), SoA + aligned allocation + restrict + SIMD reduction (B), single parallel region with static scheduling (C). The inner j-block loop uses #pragma omp simd reduction(+:fxx,fyy,fzz) aligned(x,y,z:16) to enable auto-vectorization. All pointer parameters are marked restrict for aliasing hints.\",\n  \"sources_kept\": [\n    \"26a9e4c4520f4ca0\",\n    \"ea539185c03342db\",\n    \"07a9b10a2e834526\"\n  ],\n  \"transformations\": [\n    \"Convert AoS (Body struct array) to SoA layout (separate float arrays per coordinate/velocity)\",\n    \"Add tiling on both i and j loops with IBLOCK=16, JBLOCK=256 for cache locality\",\n    \"Add aligned memory allocation via posix_memalign for 16-byte alignment\",\n    \"Add restrict qualifiers on all pointer parameters in body_force, read_dataset, write_dataset\",\n    \"Hoist outer loop coordinates xi, yi, zi into local variables to reduce repeated loads\",\n    \"Apply #pragma omp simd reduction(+:fxx,fyy,fzz) aligned(x,y,z:16) on the inner j-block loop for auto-vectorization\",\n    \"Parallelize force computation with #pragma omp for schedule(static) inside a single parallel region\",\n    \"Wrap entire time-stepping loop in a single #pragma omp parallel default(none) shared(...) to reduce fork-join overhead\",\n    \"Apply #pragma omp for schedule(static) on position update loop\"\n  ]\n}",

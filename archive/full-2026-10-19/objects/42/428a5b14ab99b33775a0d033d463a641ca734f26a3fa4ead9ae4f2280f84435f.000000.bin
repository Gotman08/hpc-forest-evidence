  "structuredContent": {
    "ok": true,
    "plan_id": "f4f6b3de5ab14239ba6c8f7d3333fd67",
    "plan_sha256": "8f2ce8a2d138dff0d4c7dc08e5075b094609bc250c3238d757660185e4abb148",

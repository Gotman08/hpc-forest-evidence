#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

/*
 * Each body holds coordinate positions (i.e., x, y, and z) and
 * velocities (i.e., vx, vy, and vz).
 */
typedef struct { float x, y, z, vx, vy, vz; } Body;

/* Compute four independent, ordered force sums per work item. */
static inline void body_force_tile(Body *p, float dt, int n, int i) {
  if (n - i < 4) {
    for (int k = i; k < n; ++k) {
      float fx = 0.0f;
      float fy = 0.0f;
      float fz = 0.0f;

      for (int j = 0; j < n; ++j) {
        float dx = p[j].x - p[k].x;
        float dy = p[j].y - p[k].y;
        float dz = p[j].z - p[k].z;
        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
        float inv_dist = 1 / sqrt(sqrd_dist);
        float inv_dist3 = inv_dist * inv_dist * inv_dist;

        fx += dx * inv_dist3;
        fy += dy * inv_dist3;
        fz += dz * inv_dist3;
      }

      p[k].vx += dt*fx;
      p[k].vy += dt*fy;
      p[k].vz += dt*fz;
    }
    return;
  }

  const float x0 = p[i].x;
  const float y0 = p[i].y;
  const float z0 = p[i].z;
  const float x1 = p[i + 1].x;
  const float y1 = p[i + 1].y;
  const float z1 = p[i + 1].z;
  const float x2 = p[i + 2].x;
  const float y2 = p[i + 2].y;
  const float z2 = p[i + 2].z;
  const float x3 = p[i + 3].x;
  const float y3 = p[i + 3].y;
  const float z3 = p[i + 3].z;

  float fx0 = 0.0f, fy0 = 0.0f, fz0 = 0.0f;
  float fx1 = 0.0f, fy1 = 0.0f, fz1 = 0.0f;
  float fx2 = 0.0f, fy2 = 0.0f, fz2 = 0.0f;
  float fx3 = 0.0f, fy3 = 0.0f, fz3 = 0.0f;

  for (int j = 0; j < n; ++j) {
    const float x = p[j].x;
    const float y = p[j].y;
    const float z = p[j].z;

    float dx0 = x - x0;
    float dy0 = y - y0;
    float dz0 = z - z0;
    float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;
    float inv_dist0 = 1 / sqrt(sqrd_dist0);
    float inv_dist30 = inv_dist0 * inv_dist0 * inv_dist0;
    fx0 += dx0 * inv_dist30;
    fy0 += dy0 * inv_dist30;
    fz0 += dz0 * inv_dist30;

    float dx1 = x - x1;
    float dy1 = y - y1;
    float dz1 = z - z1;
    float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;
    float inv_dist1 = 1 / sqrt(sqrd_dist1);
    float inv_dist31 = inv_dist1 * inv_dist1 * inv_dist1;
    fx1 += dx1 * inv_dist31;
    fy1 += dy1 * inv_dist31;
    fz1 += dz1 * inv_dist31;

    float dx2 = x - x2;
    float dy2 = y - y2;
    float dz2 = z - z2;
    float sqrd_dist2 = dx2*dx2 + dy2*dy2 + dz2*dz2 + SOFTENING;
    float inv_dist2 = 1 / sqrt(sqrd_dist2);
    float inv_dist32 = inv_dist2 * inv_dist2 * inv_dist2;
    fx2 += dx2 * inv_dist32;
    fy2 += dy2 * inv_dist32;
    fz2 += dz2 * inv_dist32;

    float dx3 = x - x3;
    float dy3 = y - y3;
    float dz3 = z - z3;
    float sqrd_dist3 = dx3*dx3 + dy3*dy3 + dz3*dz3 + SOFTENING;
    float inv_dist3 = 1 / sqrt(sqrd_dist3);
    float inv_dist33 = inv_dist3 * inv_dist3 * inv_dist3;
    fx3 += dx3 * inv_dist33;
    fy3 += dy3 * inv_dist33;
    fz3 += dz3 * inv_dist33;
  }

  p[i].vx += dt*fx0;
  p[i].vy += dt*fy0;
  p[i].vz += dt*fz0;
  p[i + 1].vx += dt*fx1;
  p[i + 1].vy += dt*fy1;
  p[i + 1].vz += dt*fz1;
  p[i + 2].vx += dt*fx2;
  p[i + 2].vy += dt*fy2;
  p[i + 2].vz += dt*fz2;
  p[i + 3].vx += dt*fx3;
  p[i + 3].vy += dt*fy3;
  p[i + 3].vz += dt*fz3;
}

/*
 * Compute the gravitational impact among all pairs of bodies in
 * the system. This entry point also supports independent calls.
 */
void body_force(Body *p, float dt, int n) {
  const int tiles = n > 0 ? (n - 1) / 4 + 1 : 0;

  #pragma omp parallel for schedule(static)
  for (int tile = 0; tile < tiles; ++tile) {
    body_force_tile(p, dt, n, 4 * tile);
  }
}

/*
 * Read a binary dataset with initilized bodies.
 */
Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  return bodies;
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc,char **argv) {
  int nbodies;

  Body *bodies = read_dataset(&nbodies);
  const int tiles = nbodies > 0 ? (nbodies - 1) / 4 + 1 : 0;

  /* Keep one team across timesteps, with barriers between phases. */
  #pragma omp parallel
  {
    for (int iter = 0; iter < N_ITER; ++iter) {
      #pragma omp for schedule(static)
      for (int tile = 0; tile < tiles; ++tile) {
        body_force_tile(bodies, DT, nbodies, 4 * tile);
      }

      #pragma omp for schedule(static)
      for (int i = 0; i < nbodies; ++i) {
        bodies[i].x += bodies[i].vx * DT;
        bodies[i].y += bodies[i].vy * DT;
        bodies[i].z += bodies[i].vz * DT;
      }
    }
  }

  write_dataset(nbodies, bodies);

  free(bodies);

  exit(EXIT_SUCCESS);
}

      "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\nusing u32 = std::uint32_t;\nusing u64 = std::uint64_t;\n\nstatic constexpr u64 MOD = 1000000007ULL;\nstatic constexpr int BLOCK = 16;\n\n// Coefficients use increasing powers of x. weights[i] is P[n-1-i],\n// so x^n = sum(weights[i] * x^i) modulo the characteristic polynomial.\nstatic int square_reduce(std::vector<u32>& coefficients, int active,\n                         const std::vector<u32>& weights,\n                         std::vector<u64>& workspace) {\n    const int n = static_cast<int>(coefficients.size());\n    const int top = 2 * active - 2;\n\n    // Compute each convolution coefficient using symmetric pairs.\n    for (int degree = 0; degree <= top; ++degree) {\n        int i = std::max(0, degree - active + 1);\n        const int pair_end = (degree + 1) / 2;\n        u64 sum = 0;\n        while (i < pair_end) {\n            const int end = std::min(pair_end, i + BLOCK);\n            for (; i < end; ++i) {\n                sum += static_cast<u64>(coefficients[i])\n                     * coefficients[degree - i];\n            }\n            sum %= MOD;\n        }\n        sum *= 2;\n        if ((degree & 1) == 0) {\n            const u64 center = coefficients[degree / 2];\n            sum += center * center;\n        }\n        workspace[degree] = sum % MOD;\n    }\n\n    // Descending degrees are dependent. Within a block, update contiguous\n    // coefficient ranges without reducing every individual product.\n    // Each live coefficient receives at most 16 products between reductions;\n    // (MOD-1) + 16*(MOD-1)^2 fits in an unsigned 64-bit integer.\n    for (int high = top; high >= n; high -= BLOCK) {\n        const int low = std::max(n, high - BLOCK + 1);\n        for (int degree = high; degree >= low; --degree) {\n            const u64 leading = workspace[degree] % MOD;\n            if (leading == 0) {\n                continue;\n            }\n            u64* destination = workspace.data() + degree - n;\n            for (int j = 0; j < n; ++j) {\n                destination[j] += leading * weights[j];\n            }\n        }\n        for (int degree = 0; degree < low; ++degree) {\n            workspace[degree] %= MOD;\n        }\n    }\n\n    const int result_active = std::min(n, top + 1);\n    for (int i = 0; i < result_active; ++i) {\n        coefficients[i] = static_cast<u32>(workspace[i]);\n    }\n    std::fill(coefficients.begin() + result_active, coefficients.end(), 0);\n    return result_active;\n}\n\nstatic int multiply_x(std::vector<u32>& coefficients, int active,\n                      const std::vector<u32>& weights) {\n    const int n = static_cast<int>(coefficients.size());\n    if (active < n) {\n        for (int i = active; i > 0; --i) {\n            coefficients[i] = coefficients[i - 1];\n        }\n        coefficients[0] = 0;\n        return active + 1;\n    }\n\n    const u64 leading = coefficients[n - 1];\n    for (int i = n - 1; i > 0; --i) {\n        coefficients[i] = static_cast<u32>(\n            (coefficients[i - 1] + leading * weights[i]) % MOD);\n    }\n    coefficients[0] = static_cast<u32>((leading * weights[0]) % MOD);\n    return n;\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n;\n    u64 h;\n    if (!(std::cin >> n >> h)) {\n        return 0;\n    }\n\n    std::vector<u32> initial(n);\n    std::vector<u32> weights(n);\n    for (int i = 0; i < n; ++i) {\n        std::cin >> initial[i];\n    }\n    for (int i = n - 1; i >= 0; --i) {\n        std::cin >> weights[i];\n    }\n\n    if (h <= static_cast<u64>(n)) {\n        std::cout << initial[h - 1] << '\\n';\n        return 0;\n    }\n\n    std::vector<u32> coefficients(n, 0);\n    std::vector<u64> workspace(2 * n - 1);\n    int active;\n    // Initialize the residue of x, including the degree-one case.\n    if (n == 1) {\n        coefficients[0] = weights[0];\n        active = 1;\n    } else {\n        coefficients[1] = 1;\n        active = 2;\n    }\n\n    const u64 exponent = h - 1;\n    u64 bit = 1;\n    while (bit <= exponent / 2) {\n        bit <<= 1;\n    }\n    // The leading exponent bit is already represented by x.\n    for (bit >>= 1; bit != 0; bit >>= 1) {\n        active = square_reduce(coefficients, active, weights, workspace);\n        if ((exponent & bit) != 0) {\n            active = multiply_x(coefficients, active, weights);\n        }\n    }\n\n    u64 answer = 0;\n    for (int start = 0; start < n; start += BLOCK) {\n        const int end = std::min(n, start + BLOCK);\n        for (int i = start; i < end; ++i) {\n            answer += static_cast<u64>(coefficients[i]) * initial[i];\n        }\n        answer %= MOD;\n    }\n    std::cout << answer << '\\n';\n    return 0;\n}\n",
      "path": "src/npbonacci.cpp"
    }
  ],
  "hypothesis": "Replacing dense companion matrices with compact characteristic-polynomial residues should improve locality and reduce work from O(N^3 log H) to O(N^2 log H), using O(N) storage.",
  "notes": "Not executed or measured. Coefficient orientation implements x^N = P1*x^(N-1) + ... + PN. Sixteen-product accumulation fits uint64_t; doubling occurs only after normalization. Handles N=1, uses local state, and preserves input/output formatting.",

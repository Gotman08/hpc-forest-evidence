"""Seal local nonblocking-pipe evidence, never dispatch a native request."""
from __future__ import annotations

import hashlib
import json
from datetime import UTC, datetime
from pathlib import Path
from xml.etree import ElementTree

ROOT = Path(__file__).resolve().parent
REV, BASE = ROOT / "codex-natif-r6", ROOT / "codex-natif-r5"
PROJECT = ROOT.parents[1] / "work/hpc-forest-harnais-comparaison-r1/project/HPC-Forest"


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def save(path, value, *, new=False):
    with path.open("x" if new else "w", encoding="utf-8", newline="\n") as handle:
        handle.write(json.dumps(value, ensure_ascii=False, indent=2) + "\n")


def main():
    if (REV / "validation-locale.json").exists():
        raise FileExistsError("Already sealed; preserve this revision")
    assert sha(BASE / "validation-locale.json") == "38f16f52e8fe0dfdcd43ef004b0d9b03259c55241766a214b835c4b6ee0afb1d"
    base_proof = json.loads((BASE / "validation-locale.json").read_bytes())
    for name, expected in base_proof["files"].items():
        assert sha(BASE / name) == expected, name
    inherited = list(BASE.glob("*.py"))
    assert len(inherited) == 10
    assert all(p.read_bytes() == (REV / p.name).read_bytes() for p in inherited)
    sources = json.loads((ROOT / "manifest-source-derivee.json").read_bytes())["files"]
    assert len(sources) == 94 and all(sha(PROJECT / n) == h for n, h in sources.items())
    zip_sha = sha(ROOT / "HPC-Forest-Harnais-Comparaison-r1.zip")
    assert zip_sha == "9a68a83fde4acb6bd247d79e00490e7d36f0c4c59c6c881152101e4c499387eb"
    suites = list(ElementTree.parse(REV / "tests-finaux.xml").getroot().iter("testsuite"))
    counts = {k: sum(int(s.get(k, 0)) for s in suites) for k in ("tests", "errors", "failures", "skipped")}
    assert counts == {"tests": 222, "errors": 0, "failures": 0, "skipped": 0}, counts
    lint = json.loads((REV / "lint-final.json").read_bytes())
    assert lint["exit_code"] == 0 and "All checks passed" in lint["output"]
    probe = json.loads(json.loads((REV / "observation-pipe-non-bloquant.json").read_bytes())["output"])
    assert probe["blocking_flag"] is False and probe["backpressure"] == "BlockingIOError"
    previous = json.loads((ROOT / "MANIFEST-LIVRAISON.json").read_bytes())
    assert all(sha(ROOT / n) == h for n, h in previous["files"].items())
    backup = ROOT / "versions/20261016-avant-ecritures-pipes-r6"
    backup.mkdir(parents=True, exist_ok=False)
    for name in ("REPRISE.md", "suivi-a-faire.json", "MANIFEST-LIVRAISON.json", "SUIVI-AUTOMATISE-ACTUEL.md"):
        (backup / name).write_bytes((ROOT / name).read_bytes())
    proof = {"schema": "hpc-forest-native-pipe-writer-local-validation-v1", "revision": "codex-natif-r6",
             "observed_utc": datetime.now(UTC).isoformat(),
             "base_validation": {"path": str(BASE / "validation-locale.json"),
                                 "sha256": sha(BASE / "validation-locale.json")},
             "base_files_verified": len(base_proof["files"]), "base_python_files_copied_unchanged": 10,
             "prior_root_manifest_files_verified_unchanged": len(previous["files"]),
             "tests_passed": 222, "inherited_tests": 200, "additional_pipe_writer_tests": 22,
             "tests_failed": 0, "tests_skipped": 0, "lint": "Ruff passed",
             "scope": "Windows nonblocking anonymous pipes and synthetic control RPC only",
             "real_pipe_backpressure_observed": True, "absolute_byte_deadline_checked_after_journal": True,
             "no_background_writer_after_method_return": True,
             "partial_or_unpersisted_write_never_replayed": True,
             "neutral_test_subprocesses_in_recorded_passes": 1,
             "native_process_ownership_verified": False, "exclusive_native_pipe_access_verified": False,
             "native_owned_launcher_validated": False, "native_live_bidirectional_rpc_validated": False,
             "native_admission_gate_implemented": False, "native_controller_connected": False,
             "native_default_instructions_verified_live": False,
             "runtime_configuration_isolation_verified": False, "style_and_service_comparability_reviewed": False,
             "per_inference_identity_verified": False, "arm64_native_executor_validated": False,
             "material_read_isolation_proved": False, "power_loss_durability_proved": False,
             "hard_exact_token_cap_proved": False, "native_codex_adapter_validated": False,
             "model_calls": 0, "app_servers_started": 0, "native_executors_started": 0,
             "sockets_opened": 0, "research_jobs_submitted": 0, "contest_program_executions": 0,
             "contest_program_compilations": 0, "source_only_files_verified_unchanged": 94,
             "source_only_zip_sha256": zip_sha,
             "files": {p.name: sha(p) for p in sorted(REV.iterdir()) if p.is_file()}}
    save(REV / "validation-locale.json", proof, new=True)
    prefix = ("## Préparation indépendante native r6 — écritures de pipes, aucune admission\n\n"
              "Lire `codex-natif-r6/REPRISE.md` et sa validation. Dix fichiers Python r5 inchangés, "
              "222 tests Windows dont 22 supplémentaires, Ruff positif. Écrivain synchrone de pipe "
              "déjà non bloquant, échéance absolue recontrôlée après journalisation, contre-pression "
              "et envoi partiel conservés sans rejeu. Callback RpcLink exercé avec contrôle fictif "
              "uniquement ; aucun serveur/modèle/exécuteur/job nouveau. La borne d'écriture ne "
              "borne ni fsync ni inférence ni jetons. Raccordement bidirectionnel vivant, lancement "
              "possédé/CIM, exclusivité, isolement, instructions et admission restent non validés. "
              "Les 94 sources et le ZIP figé restent intacts. Les deux voies R1/748782 et "
              "GPT96/748383 sont RUNNING à 19:12 UTC, sur N-body et somme ; aucun bilan final reçu. "
              "Lire `observation-voies-20261016T1912.json`. Même reprise R1, audit avant arrêt, "
              "priorité source-only et barrière des 300 issues avant Codex. Aucune nouvelle cohorte "
              "ou modification de l'article ; ne pas renotifier cette préparation mécanique.\n\n")
    path = ROOT / "REPRISE.md"
    title, separator, body = path.read_text(encoding="utf-8").partition("\n")
    path.write_text(title + separator + "\n" + prefix + body.lstrip("\n"), encoding="utf-8", newline="\n")
    todo_path = ROOT / "suivi-a-faire.json"
    todo = json.loads(todo_path.read_bytes())
    todo.update({"updated_utc": datetime.now(UTC).isoformat(), "native_latest_revision": "codex-natif-r6",
                 "native_latest_revision_local_tests": 222, "native_pipe_writer_additional_tests": 22,
                 "native_nonblocking_pipe_writer_tested": True, "native_owned_launcher_validated": False,
                 "native_live_rpc_pipe_integration_validated": False,
                 "native_process_stream_transport_validated": False,
                 "native_pipe_writer_validation": {"path": str(REV / "validation-locale.json"),
                                                    "sha256": sha(REV / "validation-locale.json")},
                 "existing_native_lanes_latest_observation": {
                     "path": str(ROOT / "observation-voies-20261016T1912.json"),
                     "sha256": sha(ROOT / "observation-voies-20261016T1912.json"),
                     "jobs": ["748782", "748383"], "audited_release_received": False}})
    todo["codex_native"].insert(0, "Révision codex-natif-r6 : 222 tests Windows, dont 22 écritures non "
                               "bloquantes/échéances/contre-pression. Aucun processus natif ou modèle. "
                               "Raccordement RPC bidirectionnel, lancement/CIM et admission restent absents.")
    save(todo_path, todo)
    print(json.dumps({"revision": "codex-natif-r6", "validation_sha256": sha(REV / "validation-locale.json"),
                      "tests": 222, "sources_unchanged": 94,
                      "previous_manifest_verified": len(previous["files"])}, ensure_ascii=True))


if __name__ == "__main__":
    main()

{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include \\\"knn.h\\\"\\n\\n#ifdef _OPENMP\\n#include <omp.h>\\n#include <stdint.h>\\n#include <string.h>\\n#endif\\n\\nstatic char vote_labels(char * labels, int k) {\\n    qsort(labels, k, sizeof(char), compare_for_sort);\\n\\n    char most_frequent = labels[0];\\n    int most_frequent_count = 1;\\n    int current_frequency = 1;\\n\\n    for (int i = 1; i < k; i++) {\\n        if (labels[i] != labels[i - 1]) {\\n            if (current_frequency > most_frequent_count) {\\n                most_frequent = labels[i - 1];\\n                most_frequent_count = current_frequency;\\n            }\\n\\n            current_frequency = 1;\\n        } else {\\n            current_frequency++;\\n        }\\n\\n        if (i == k - 1 && current_frequency > most_frequent_count) {\\n            most_frequent = labels[i - 1];\\n            most_frequent_count = current_frequency;\\n        }\\n    }\\n\\n    return most_frequent;\\n}\\n\\nstatic char knn_serial(int n_groups, Group * groups, int k, Point to_evaluate) {\\n    char * labels = (char *) malloc(sizeof(char) * k);\\n    float * distances = (float *) malloc(sizeof(float) * k);\\n\\n    int i, j, x, y;\\n\\n    for (i = 0; i < k; i++) {\\n        labels[i] = -1;\\n        distances[i] = -1;\\n    }\\n\\n    for (i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n\\n        for (j = 0; j < g.length; j++) {\\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n\\n            for (x = 0; x < k; x++) {\\n                if (d < distances[x] || distances[x] == -1) {\\n                    for (y = k - 1; y > x; y--) {\\n                        distances[y] = distances[y - 1];\\n                        labels[y] = labels[y - 1];\\n                    }\\n\\n                    distances[x] = d;\\n                    labels[x] = g.label;\\n\\n                    break;\\n                }\\n            }\\n        }\\n    }\\n\\n    char result = vote_labels(labels, k);\\n    free(distances);\\n    free(labels);\\n    return result;\\n}\\n\\n#ifdef _OPENMP\\n\\ntypedef struct {\\n    float * distances;\\n    char * labels;\\n    int length;\\n    int next;\\n} KnnRun;\\n\\nstatic int distance_is_nan(float distance) {\\n    /* ARM64 uses IEEE-754 binary32 floats. Inspect bits without FP comparisons. */\\n    uint32_t bits;\\n    memcpy(&bits, &distance, sizeof(bits));\\n    return (bits & UINT32_C(0x7fffffff)) > UINT32_C(0x7f800000);\\n}\\n\\nstatic void release_runs(KnnRun * runs, int count) {\\n    for (int i = 0; i < count; i++) {\\n        free(runs[i].distances);\\n        free(runs[i].labels);\\n    }\\n    free(runs);\\n}\\n\\n#endif\\n\\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n#ifndef _OPENMP\\n    return knn_serial(n_groups, groups, k, to_evaluate);\\n#else\\n    int max_threads = omp_get_max_threads();\\n    if (k <= 0 || n_groups <= 0 || max_threads <= 1 || omp_in_parallel()) {\\n        return knn_serial(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    size_t total = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        total += (size_t) groups[i].length;\\n    }\\n\\n    /* Require roughly 65536 candidate-slot operations per possible worker. */\\n    size_t minimum_points = 1 + (size_t) 65535 / (size_t) k;\\n    if (total / (size_t) max_threads < minimum_points) {\\n        return knn_serial(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    size_t * offsets = (size_t *) malloc(((size_t) n_groups + 1) * sizeof(size_t));\\n    KnnRun * runs = (KnnRun *) malloc((size_t) max_threads * sizeof(KnnRun));\\n    if (offsets == NULL || runs == NULL) {\\n        free(offsets);\\n        free(runs);\\n        return knn_serial(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    offsets[0] = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        offsets[i + 1] = offsets[i] + (size_t) groups[i].length;\\n    }\\n\\n    int worker_count = 1;\\n    int needs_serial = 0;\\n\\n#pragma omp parallel default(none) shared(runs, offsets, total, n_groups, groups, k, to_evaluate, worker_count) reduction(|:needs_serial)\\n    {\\n        int thread = omp_get_thread_num();\\n        int count = omp_get_num_threads();\\n        if (thread == 0) {\\n            worker_count = count;\\n        }\\n\\n        /* Contiguous point ranges balance unequal groups and preserve tie order. */\\n        size_t quotient = total / (size_t) count;\\n        size_t remainder = total % (size_t) count;\\n        size_t before = (size_t) thread < remainder ? (size_t) thread : remainder;\\n        size_t begin = quotient * (size_t) thread + before;\\n        size_t end = begin + quotient + ((size_t) thread < remainder ? 1 : 0);\\n        size_t points = end - begin;\\n\\n        KnnRun run = {0};\\n        run.length = points < (size_t) k ? (int) points : k;\\n\\n        if (run.length > 0) {\\n            run.distances = (float *) malloc(sizeof(float) * (size_t) run.length);\\n            run.labels = (char *) malloc(sizeof(char) * (size_t) run.length);\\n\\n            if (run.distances == NULL || run.labels == NULL) {\\n                needs_serial |= 1;\\n            } else {\\n                for (int x = 0; x < run.length; x++) {\\n                    run.distances[x] = -1;\\n                    run.labels[x] = -1;\\n                }\\n\\n                int low = 0;\\n                int high = n_groups;\\n                while (low < high) {\\n                    int middle = low + (high - low) / 2;\\n                    if (offsets[middle + 1] <= begin) {\\n                        low = middle + 1;\\n                    } else {\\n                        high = middle;\\n                    }\\n                }\\n\\n                for (int g = low; g < n_groups && offsets[g] < end; g++) {\\n                    Group group = groups[g];\\n                    size_t first = begin > offsets[g] ? begin - offsets[g] : 0;\\n                    size_t last = end < offsets[g + 1]\\n                        ? end - offsets[g] : (size_t) group.length;\\n\\n                    for (size_t j = first; j < last; j++) {\\n                        float d = euclidean_distance_no_sqrt(to_evaluate, group.points[j]);\\n\\n                        /* NaNs require the original global encounter-order scan. */\\n                        if (distance_is_nan(d)) {\\n                            needs_serial |= 1;\\n                            continue;\\n                        }\\n\\n                        for (int x = 0; x < run.length; x++) {\\n                            if (d < run.distances[x] || run.distances[x] == -1) {\\n                                for (int y = run.length - 1; y > x; y--) {\\n                                    run.distances[y] = run.distances[y - 1];\\n                                    run.labels[y] = run.labels[y - 1];\\n                                }\\n\\n                                run.distances[x] = d;\\n                                run.labels[x] = group.label;\\n                                break;\\n                            }\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n\\n        runs[thread] = run;\\n    }\\n\\n    free(offsets);\\n    if (needs_serial) {\\n        release_runs(runs, worker_count);\\n        return knn_serial(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    char * labels = (char *) malloc(sizeof(char) * (size_t) k);\\n    if (labels == NULL) {\\n        release_runs(runs, worker_count);\\n        return knn_serial(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    /* Equal distances favor the earlier contiguous range, then its stable order. */\\n    for (int i = 0; i < k; i++) {\\n        int best = -1;\\n        for (int t = 0; t < worker_count; t++) {\\n            if (runs[t].next < runs[t].length &&\\n                (best < 0 || runs[t].distances[runs[t].next] <\\n                             runs[best].distances[runs[best].next])) {\\n                best = t;\\n            }\\n        }\\n\\n        if (best < 0) {\\n            /* Preserve the reference sentinel labels when k exceeds total. */\\n            for (; i < k; i++) {\\n                labels[i] = -1;\\n            }\\n            break;\\n        }\\n\\n        labels[i] = runs[best].labels[runs[best].next];\\n        runs[best].next++;\\n    }\\n\\n    release_runs(runs, worker_count);\\n    char result = vote_labels(labels, k);\\n    free(labels);\\n    return result;\\n#endif\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\"path\":\"src/knn.c\"}],\"hypothesis\":\"Balanced OpenMP scans with private top-k lists and a deterministic merge should accelerate insertion-dominated workloads on four cores while preserving exact classification.\",\"notes\":\"Unmeasured; no commands executed. Parsing, distance arithmetic and label voting remain unchanged. Uses existing OpenMP settings; builds without OpenMP retain serial execution.\",\"sources_kept\":[],\"transformations\":[\"Partition the encounter-order point stream into balanced contiguous ranges, independent of group sizes.\",\"Apply the reference stable insertion algorithm to thread-private lists, then merge by distance with earlier-range tie priority.\",\"Preserve k>N sentinel padding and fall back to the reference scan for NaN distances or parallel scratch-allocation failure.\",\"Gate parallelism by estimated work per thread, avoid nested teams and release per-call scratch storage.\"]}"}}

    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <iostream>\\n#include <vector>\\n#include <cstdio>\\n#include <algorithm>\\n#include <omp.h>\\n\\nint main() {\\n    int n, s;\\n    std::cin >> n >> s;\\n    \\n    // Read matrix (1-indexed for prefix sum convenience)\\n    std::vector<std::vector<int>> mat(n + 1, std::vector<int>(n + 1));\\n    for (int i = 0; i < n; ++i) {\\n        for (int j = 0; j < n; ++j) {\\n            scanf(\\\"%d\\\", &mat[i + 1][j + 1]);\\n        }\\n    }\\n\\n    // Build prefix sum matrix: pref[i][j] = sum of mat[1..i][1..j]\\n    std::vector<std::vector<long long>> pref(n + 1, std::vector<long long>(n + 1, 0));\\n\\n    // Row-wise prefix sums (static schedule for regular work)\\n    #pragma omp parallel for schedule(static) collapse(2)\\n    for (int i = 1; i <= n; ++i) {\\n        for (int j = 1; j <= n; ++j) {\\n            pref[i][j] = pref[i][j - 1] + mat[i][j];\\n        }\\n    }\\n\\n    // Column-wise prefix sums to complete the integral image\\n    #pragma omp parallel for schedule(static)\\n    for (int j = 1; j <= n; ++j) {\\n        long long col_sum = 0;\\n        for (int i = 1; i <= n; ++i) {\\n            col_sum += pref[i][j];\\n            pref[i][j] = col_sum;\\n        }\\n    }\\n\\n    // Search all top-left corners of SxS submatrices using collapsed loops with reduction and guided schedule\\n    long long mxSum = -1e18;  // sufficiently small initial value\\n    int limit = n - s + 1;\\n    #pragma omp parallel for collapse(2) reduction(max:mxSum) schedule(guided)\\n    for (int i = 0; i < limit; ++i) {\\n        for (int j = 0; j < limit; ++j) {\\n            long long sum = pref[i + s][j + s] - pref[i][j + s] - pref[i + s][j] + pref[i][j];\\n            if (sum > mxSum) mxSum = sum;\\n        }\\n    }\\n\\n    printf(\\\"%lld\\\\n\\\", mxSum);\\n    return 0;\\n}\\n\",\n      \"path\": \"src/solution.cpp\"\n    }\n  ],\n  \"hypothesis\": \"Use integral image computed via two parallel prefix sum passes (row then column) each with static scheduling, and search all top-left corners using collapse(2) reduction(max:mxSum) schedule(guided). This demonstrates OpenMP work sharing through parallel for directives on both construction and search phases, reductions via max reduction, explicit guided scheduling to adaptively balance irregular workload in the search phase (due to varying submatrix sums), and thread granularity via collapsed loops.\",\n  \"notes\": \"Replaced sequential sliding-window algorithm with integral image approach. Row-wise prefix sum uses collapse(2) for finer granularity; column-wise uses a single parallel loop over columns with manual accumulation inside each thread to avoid false sharing. Search phase collapses both loops, uses reduction(max) and guided schedule which adapts chunk sizes dynamically.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Replace sequential sliding-window algorithm with integral image (prefix sum) approach\",\n    \"Parallelize row-wise prefix sums using #pragma omp parallel for schedule(static) collapse(2)\",\n    \"Parallelize column-wise prefix sums using #pragma omp parallel for schedule(static) with manual accumulation per thread to reduce false sharing\",\n    \"Search all top-left corners of SxS submatrices using collapsed loops (collapse(2)) with reduction(max:mxSum) and guided scheduling\"\n  ]\n}",

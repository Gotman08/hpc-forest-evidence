        "content": "#include<stdio.h>\n#include<stdlib.h>\n#include<math.h>\n\nvoid bubble_sort (double *matriz, int tam) {\n    int i, j; \n    double aux;\n\n    for (i = tam - 1; i > 0; i--) {\n        for (j = 0; j < i; j++) {\n            if (matriz[j] > matriz[j+1]) {\n                aux=matriz[j];\n                matriz[j]=matriz[j+1];\n                matriz[j+1]=aux;\n            }\n        }\n    }\n}\n\nvoid ordena_colunas(double *matriz,int lin, int col) {\n    int i;\n    \n    for (i = 0; i < col; i++) {    \n        bubble_sort(&matriz[i*lin], lin);\n    }\n} \n\nvoid calcula_media(double *matriz, double *vet,int lin, int col){\n    int i,j;\n    double soma;\n    for(i=0;i<col;i++){\n        soma=0;\n        for(j=0;j<lin;j++){\n            soma+=matriz[i*lin+j];\n        }\n        vet[i]=soma/lin; \n    }   \n}\n\nvoid calcula_media_harmonica(double *matriz, double *vet,int lin, int col){\n    int i,j;\n    double soma;\n    for(i=0;i<col;i++){\n        soma=0;\n        for(j=0;j<lin;j++){\n            soma+=(1/(matriz[i*lin+j]));\n        }\n        vet[i]=lin/soma; \n    }   \n}\n\nvoid calcula_mediana(double *matriz, double *vet, int lin, int col) {  \n     int i=0;\n     if((lin-1)%2){\n         for (i = 0; i < col; i++) {\n            vet[i]=(matriz[(((i*lin)+(i+1)*lin)-1)/2]+matriz[((((i*lin)+(i+1)*lin)-1)/2)+1]);\n            vet[i]*=0.5;\n            \n         }\n     }\n     else{\n         for (i = 0; i < col; i++) {\n            vet[i]=matriz[(((i*lin)+(i+1)*lin)-1)/2];\n         }\n     }\n    \n } \n\ndouble moda_aux(double *matriz,int lin){\n    int i, j; \n    double *cont;\n    cont=(double*)malloc(lin*sizeof(double));\n    float conta=0, moda=0;\n    \n    for(i=0;i<lin;i++){\n        for(j=i+1;j<lin;j++){\n            \n            if(matriz[i]==matriz[j]){\n                cont[i]++;\n                    if(cont[i]>conta){\n                        conta=cont[i];\n                        moda=matriz[i];\n                    }\n            }\n\n        }\n        cont[i]=0;\n    }\n    free(cont);\n    if(conta == 0){\n        return -1;\n    }\n    else{\n        return moda;\n    }\n\n}\n\nvoid calcula_moda(double *matriz,double *moda,int lin, int col){\n    int i;\n    for(i=0;i<col;i++){\n        moda[i]=moda_aux(matriz+(i*lin),lin);\n    }\n}\n\nvoid calcula_variancia(double *matriz, double *media,double *variancia, int lin, int col){\n    int i,j;\n    double soma;\n    for(i=0;i<col;i++){\n        soma=0;\n        for(j=0;j<lin;j++){\n            soma+=pow((matriz[i*lin+j]-media[i]),2);\n        }\n        variancia[i]=soma/(lin-1); \n    } \n}\n\nvoid calcula_desvio_padrao(double *variancia,double *dp, int col){\n    int i;\n    for(i=0;i<col;i++){\n        dp[i]=sqrt(variancia[i]);\n    }  \n}\n\nvoid calcula_coeficiente_variacao(double *media,double *dp,double *cv, int col){\n    int i;\n    for(i=0;i<col;i++){\n        cv[i]=dp[i]/media[i];\n    }  \n}\n\nstatic void calcula_coluna(double *matriz, double *mediana, double *media,\n                           double *media_har, double *moda, double *variancia,\n                           double *dp, double *cv, int lin, int i){\n    int j;\n    double soma;\n\n    soma=0;\n    for(j=0;j<lin;j++){\n        soma+=matriz[i*lin+j];\n    }\n    media[i]=soma/lin;\n\n    soma=0;\n    for(j=0;j<lin;j++){\n        soma+=(1/(matriz[i*lin+j]));\n    }\n    media_har[i]=lin/soma;\n\n    bubble_sort(&matriz[i*lin], lin);\n\n    if((lin-1)%2){\n        mediana[i]=(matriz[(((i*lin)+(i+1)*lin)-1)/2]+matriz[((((i*lin)+(i+1)*lin)-1)/2)+1]);\n        mediana[i]*=0.5;\n    }\n    else{\n        mediana[i]=matriz[(((i*lin)+(i+1)*lin)-1)/2];\n    }\n\n    moda[i]=moda_aux(matriz+(i*lin),lin);\n\n    soma=0;\n    for(j=0;j<lin;j++){\n        soma+=pow((matriz[i*lin+j]-media[i]),2);\n    }\n    variancia[i]=soma/(lin-1);\n    dp[i]=sqrt(variancia[i]);\n    cv[i]=dp[i]/media[i];\n}\n\nstatic void calcula_metricas(double *matriz, double *mediana, double *media,\n                             double *media_har, double *moda, double *variancia,\n                             double *dp, double *cv, int lin, int col){\n#ifdef _OPENMP\n    size_t trabalho = (size_t)lin * (size_t)lin * (size_t)col;\n\n    if(col > 1 && trabalho >= 262144u){\n        int i;\n#pragma omp parallel for schedule(static)\n        for(i=0;i<col;i++){\n            calcula_coluna(matriz,mediana,media,media_har,moda,variancia,dp,cv,lin,i);\n        }\n        return;\n    }\n#endif\n\n    calcula_media(matriz,media,lin,col);\n    calcula_media_harmonica(matriz,media_har,lin,col);\n    ordena_colunas(matriz,lin,col);\n    calcula_mediana(matriz,mediana,lin,col);\n    calcula_moda(matriz,moda,lin,col);\n    calcula_variancia(matriz,media,variancia,lin,col);\n    calcula_desvio_padrao(variancia,dp,col);\n    calcula_coeficiente_variacao(media,dp,cv,col);\n}\n\nint main(int argc,char **argv){\n    int lin,col,i,j;\n    double *matriz,*mediana,*media,*media_har,*moda,*variancia,*dp,*cv;\n\n    fscanf(stdin, \"%d \", &lin);\n    fscanf(stdin, \"%d\\n\", &col);\n    \n    matriz=(double *)malloc(lin*col * sizeof(double));\n    media=(double *)malloc(col * sizeof(double));\n    media_har=(double *)malloc(col * sizeof(double));\n    mediana=(double *)malloc(col * sizeof(double));\n    moda=(double *)malloc(col * sizeof(double));\n    variancia=(double *)malloc(col * sizeof(double));\n    cv=(double *)malloc(col * sizeof(double));\n    dp=(double *)malloc(col * sizeof(double));\n\n    for(i=0;i<lin;i++){\n        for(j=0;j<col;j++){\n            fscanf(stdin, \"%lf \",&(matriz[j*lin+i]));\n        }\n    }\n\n    calcula_metricas(matriz,mediana,media,media_har,moda,variancia,dp,cv,lin,col);\n\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",media[i]);\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",media_har[i]);\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",mediana[i]);\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",moda[i]);\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",variancia[i]);\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",dp[i]);\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",cv[i]);\n    printf(\"\\n\");\n\n    free(matriz);\n    free(media);\n    free(media_har);\n    free(mediana);\n    free(moda);\n    free(variancia);\n    free(dp);\n    free(cv);\n}\n",
        "path": "src/est_matriz_seq.c"
      }

      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdint.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n#define PAIR_TILE 32\n#define PAIR_CACHE_BYTES (64u * 1024u * 1024u)\n#define PAIR_CACHE_ALIGNMENT 128u\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system.\n */\nvoid body_force(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\nstatic inline float inverse_cube(float dx, float dy, float dz) {\n  float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n  float inv_dist = 1 / sqrt(sqrd_dist);\n  float inv_dist3 = inv_dist * inv_dist * inv_dist;\n  return inv_dist3;\n}\n\n/* Each work item owns one upper-triangular tile and its transpose. */\nstatic inline void fill_coefficient_tile(const Body *src, float *coefficients,\n                                         size_t coefficient_stride,\n                                         int n, int nblocks, size_t tile) {\n  int lo = 0;\n  int hi = nblocks;\n  while (lo + 1 < hi) {\n    int mid = lo + (hi - lo) / 2;\n    size_t base = (size_t)mid *\n                  (2u * (size_t)nblocks - (size_t)mid + 1u) / 2u;\n    if (base <= tile)\n      lo = mid;\n    else\n      hi = mid;\n  }\n\n  size_t base = (size_t)lo *\n                (2u * (size_t)nblocks - (size_t)lo + 1u) / 2u;\n  int block_i = lo;\n  int block_j = lo + (int)(tile - base);\n  int i_begin = block_i * PAIR_TILE;\n  int j_begin = block_j * PAIR_TILE;\n  int i_end = i_begin + PAIR_TILE;\n  int j_end = j_begin + PAIR_TILE;\n  if (i_end > n) i_end = n;\n  if (j_end > n) j_end = n;\n\n  for (int i = i_begin; i < i_end; ++i) {\n    float xi = src[i].x;\n    float yi = src[i].y;\n    float zi = src[i].z;\n    int first_j = block_i == block_j ? i : j_begin;\n    for (int j = first_j; j < j_end; ++j) {\n      float dx = src[j].x - xi;\n      float dy = src[j].y - yi;\n      float dz = src[j].z - zi;\n      float scale = inverse_cube(dx, dy, dz);\n      coefficients[(size_t)i * coefficient_stride + (size_t)j] = scale;\n      if (i != j) {\n        /* Preserve directional NaN propagation instead of mirroring it. */\n        float reverse = scale;\n        if (isnan(scale)) {\n          reverse = inverse_cube(src[i].x - src[j].x,\n                                 src[i].y - src[j].y,\n                                 src[i].z - src[j].z);\n        }\n        coefficients[(size_t)j * coefficient_stride + (size_t)i] = reverse;\n      }\n    }\n  }\n}\n\nstatic inline void advance_body(const Body *src, Body *dst,\n                                const float *coefficients,\n                                size_t coefficient_stride,\n                                float dt, int n, int i) {\n  float xi = src[i].x;\n  float yi = src[i].y;\n  float zi = src[i].z;\n  float fx = 0.0f;\n  float fy = 0.0f;\n  float fz = 0.0f;\n\n  if (coefficients != NULL) {\n    const float *row = coefficients + (size_t)i * coefficient_stride;\n    for (int j = 0; j < n; ++j) {\n      float dx = src[j].x - xi;\n      float dy = src[j].y - yi;\n      float dz = src[j].z - zi;\n      float inv_dist3 = row[j];\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n  } else {\n    for (int j = 0; j < n; ++j) {\n      float dx = src[j].x - xi;\n      float dy = src[j].y - yi;\n      float dz = src[j].z - zi;\n      float inv_dist3 = inverse_cube(dx, dy, dz);\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n  }\n\n  float vx = src[i].vx + dt*fx;\n  float vy = src[i].vy + dt*fy;\n  float vz = src[i].vz + dt*fz;\n  dst[i].vx = vx;\n  dst[i].vy = vy;\n  dst[i].vz = vz;\n  dst[i].x = xi + vx*dt;\n  dst[i].y = yi + vy*dt;\n  dst[i].z = zi + vz*dt;\n}\n\nstatic void simulate(Body *p, float dt, int n) {\n  if (n <= 0) return;\n\n  size_t count = (size_t)n;\n  Body *next = (Body *)malloc(count * sizeof(Body));\n  if (next == NULL) {\n    for (int iter = 0; iter < N_ITER; ++iter) {\n      body_force(p, dt, n);\n      for (int i = 0; i < n; ++i) {\n        p[i].x += p[i].vx * dt;\n        p[i].y += p[i].vy * dt;\n        p[i].z += p[i].vz * dt;\n      }\n    }\n    return;\n  }\n\n  /* Keep independently owned 32-float tile segments on separate lines. */\n  size_t coefficient_stride =\n      ((count + (size_t)PAIR_TILE - 1u) / (size_t)PAIR_TILE) *\n      (size_t)PAIR_TILE;\n  float *coefficients = NULL;\n  void *coefficient_allocation = NULL;\n  if (coefficient_stride <=\n      ((size_t)PAIR_CACHE_BYTES / sizeof(float)) / count) {\n    size_t coefficient_bytes = count * coefficient_stride * sizeof(float);\n    coefficient_allocation =\n        malloc(coefficient_bytes + (size_t)PAIR_CACHE_ALIGNMENT - 1u);\n    if (coefficient_allocation != NULL) {\n      uintptr_t address = (uintptr_t)coefficient_allocation;\n      uintptr_t aligned_address =\n          (address + (uintptr_t)PAIR_CACHE_ALIGNMENT - 1u) &\n          ~((uintptr_t)PAIR_CACHE_ALIGNMENT - 1u);\n      coefficients = (float *)aligned_address;\n    }\n  }\n\n  int nblocks = 0;\n  size_t tile_count = 0;\n  if (coefficients != NULL) {\n    nblocks = (n - 1) / PAIR_TILE + 1;\n    tile_count = (size_t)nblocks * ((size_t)nblocks + 1u) / 2u;\n  }\n\n  #pragma omp parallel if(n >= 128)\n  {\n    Body *src = p;\n    Body *dst = next;\n    for (int iter = 0; iter < N_ITER; ++iter) {\n      if (coefficients != NULL) {\n        #pragma omp for schedule(static, 1)\n        for (size_t tile = 0; tile < tile_count; ++tile) {\n          fill_coefficient_tile(src, coefficients, coefficient_stride,\n                                n, nblocks, tile);\n        }\n      }\n\n      /* The j traversal remains sequential within every force sum. */\n      #pragma omp for schedule(static)\n      for (int i = 0; i < n; ++i) {\n        advance_body(src, dst, coefficients, coefficient_stride, dt, n, i);\n      }\n\n      Body *tmp = src;\n      src = dst;\n      dst = tmp;\n    }\n  }\n\n  if (N_ITER % 2 != 0) {\n    memcpy(p, next, count * sizeof(Body));\n  }\n  free(coefficient_allocation);\n  free(next);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /* Compute interbody forces and integrate positions each iteration. */\n  simulate(bodies, DT, nbodies);\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Aligning coefficient storage and row strides to OpenMP tile boundaries can eliminate boundary false sharing during cyclic symmetric-tile production.",
  "notes": "Unmeasured. Retains cyclic scheduling, floating-point expressions, accumulation order, and allocation-failure fallbacks.",

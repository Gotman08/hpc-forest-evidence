      "content": "#include \"knn.h\"\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j, x, y;\n    int populated = 0;\n    int ordered = 1;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            /* A full, NaN-free list cannot admit a point at this cutoff. */\n            if (ordered && populated == k && populated > 0 &&\n                !(d < distances[populated - 1])) {\n                continue;\n            }\n\n            if (ordered) {\n                /*\n                 * In a sorted, NaN-free prefix, failed comparisons precede\n                 * successful ones. Their count is the stable insertion\n                 * position. A NaN candidate fails every comparison and\n                 * therefore still selects the first unoccupied slot.\n                 */\n                x = 0;\n#if defined(_OPENMP)\n#pragma omp simd reduction(+:x)\n#endif\n                for (int index = 0; index < populated; index++) {\n                    x += !(d < distances[index]);\n                }\n            } else {\n                /* Stored NaNs require the original first-match search. */\n                x = populated;\n#if defined(_OPENMP)\n#pragma omp simd reduction(min:x)\n#endif\n                for (int index = 0; index < populated; index++) {\n                    int candidate = d < distances[index] ? index : populated;\n                    x = candidate < x ? candidate : x;\n                }\n            }\n\n            if (x < k) {\n                /* Copy backward only through occupied entries. */\n                int last = populated < k ? populated : k - 1;\n                for (y = last; y > x; y--) {\n                    distances[y] = distances[y - 1];\n                    labels[y] = labels[y - 1];\n                }\n\n                distances[x] = d;\n                labels[x] = g.label;\n\n                if (populated < k) {\n                    populated++;\n                }\n\n                /* Keep exact first-match behavior after storing a NaN. */\n                if (d != d) {\n                    ordered = 0;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "An integer-sum insertion-rank reduction should require fewer SIMD operations than minimum-index reduction for the sorted, NaN-free prefix, without changing floating-point distance evaluation.",

          "integration_sources": [
            "36e61dc364844be3",
            "11ed73a003f84a8a"
          ],
          "hypothesis_as_declared_by_model": "A capped first-hit binomial path can avoid the quadratic grid scan for sufficiently large, very sparse instances, while the measured-fast anti-diagonal wavefront remains the general fallback.",
          "transformations_as_declared_by_model": {
            "files": [
              "src/solution.cpp"
            ],
            "retained": [
              "Sort and deduplicate blocked coordinates by (anti-diagonal, row); compute dependency-free anti-diagonal wavefronts with two rolling buffers, conditional modular reduction, and sparse post-computation zeroing.",

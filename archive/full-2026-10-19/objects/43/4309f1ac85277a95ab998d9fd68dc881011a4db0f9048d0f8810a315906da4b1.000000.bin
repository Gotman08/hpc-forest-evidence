          "hypothesis_as_declared_by_model": "Streaming one DP row over obstacle-free spans should reduce memory traffic by eliminating row copies and per-cell packed-bit lookups.",
          "transformations_as_declared_by_model": {
            "files": [
              "src/solution.cpp"
            ],
            "retained": [

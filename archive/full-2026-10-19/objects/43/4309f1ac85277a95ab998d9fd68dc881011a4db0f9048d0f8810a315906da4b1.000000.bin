    "trials": [
      {
        "id": "cddab6538ea647fb",
        "role": "A",
        "mission": {
          "base_commit": "23ce09faab84d352af4a5e04c28159263bca47ce",
          "delegation_parent": "R/A",
          "depth": 1,
          "epoch": 1,
          "hypothesis": "A compact contiguous top-k heap should reduce memory traffic by replacing full-array scans and shifts with a hot-root rejection check and logarithmic updates.",
          "id": "cddab6538ea647fb",
          "ordinal": 1,
          "parent_id": null,
          "role": "A",
          "source_commits": [],
          "sources": [],
          "transformations": {
            "files": [
              "src/knn.c"
            ],
            "retained": [
              "Store neighbors as contiguous distance/group-index records, bounded by min(k, total points), and build the initial heap bottom-up.",
              "Reject noncompetitive points at the heap root and move only one heap path for accepted points.",
              "Break equal-distance heap ties by group traversal order, preserving reference label selection; retain sentinel labels when fewer than k points exist.",
              "Keep an ordered-insertion fallback for NaN distances or failed heap allocation, and release per-call work buffers."
            ]
          },
          "tree_id": "e1:A",
          "trial_id": "01M50K6EW1HNARH89NHC21KKDG",

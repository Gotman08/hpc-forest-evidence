            "src/solution.cpp"
          ],
          "retained": [
            "Replace the full matrix and serpentine traversal with a contiguous s-row circular buffer and rolling column sums.",
            "Fuse buffered integer parsing with expiration and insertion updates, subtracting expired values before overwriting their slots.",
            "Scan length-s horizontal windows across the column sums after each complete vertical window.",
            "Use signed 64-bit intermediate sums and initialize the maximum to the lowest representable value for negative-only inputs."
          ]
        },

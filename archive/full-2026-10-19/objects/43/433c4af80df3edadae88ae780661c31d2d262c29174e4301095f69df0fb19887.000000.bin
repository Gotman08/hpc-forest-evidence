      "content": "#include <iostream>\n#include <vector>\n#include <utility>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\ntypedef vector<vector<bool>> adjacency_matrix;\n\nadjacency_matrix readGraph();\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence);\ninline void printPermutation(vector<int> &equivalence);\n\n#ifdef _OPENMP\nnamespace {\nconstexpr int heap_block_vertices = 7;\nconstexpr int heap_block_permutations = 5040;\n\nstruct HeapBlock {\n    vector<int> seed;\n    vector<int> permutation;\n    vector<unsigned char> matches;\n    int last_match;\n};\n\ninline bool nextBlockPermutation(vector<int> &permutation, int *exchange_counter){\n    int exchange_index = 1;\n    while(exchange_index < heap_block_vertices){\n        if(exchange_counter[exchange_index] < exchange_index){\n            if(exchange_index % 2 == 0)\n                swap(permutation[0], permutation[exchange_index]);\n            else\n                swap(permutation[exchange_counter[exchange_index]], permutation[exchange_index]);\n            ++exchange_counter[exchange_index];\n            return true;\n        }\n        exchange_counter[exchange_index] = 0;\n        ++exchange_index;\n    }\n    return false;\n}\n\nbool testIsomorphismParallel(adjacency_matrix &g1, adjacency_matrix &g2,\n                             vector<int> &next_seed, vector<int> &exchange_counter){\n    const int vertices = static_cast<int>(next_seed.size());\n    const int batch_capacity = omp_get_max_threads();\n    vector<HeapBlock> blocks(batch_capacity);\n    for(HeapBlock &block : blocks){\n        block.seed.resize(vertices);\n        block.permutation.resize(vertices);\n        block.matches.resize(heap_block_permutations);\n    }\n\n    int block_count = 0;\n    bool more_blocks = true;\n    bool isomorphism_found = false;\n\n    #pragma omp parallel\n    {\n        while(true){\n            #pragma omp single\n            {\n                block_count = 0;\n                while(block_count < batch_capacity && more_blocks){\n                    blocks[block_count].seed = next_seed;\n                    ++block_count;\n\n                    // A complete seven-vertex Heap block swaps its endpoints.\n                    swap(next_seed[0], next_seed[heap_block_vertices - 1]);\n                    int exchange_index = heap_block_vertices;\n                    while(exchange_index < vertices &&\n                          exchange_counter[exchange_index] == exchange_index){\n                        exchange_counter[exchange_index] = 0;\n                        ++exchange_index;\n                    }\n                    if(exchange_index == vertices){\n                        more_blocks = false;\n                    }else{\n                        if(exchange_index % 2 == 0)\n                            swap(next_seed[0], next_seed[exchange_index]);\n                        else\n                            swap(next_seed[exchange_counter[exchange_index]], next_seed[exchange_index]);\n                        ++exchange_counter[exchange_index];\n                    }\n                }\n            }\n\n            if(block_count == 0)\n                break;\n\n            #pragma omp for schedule(static, 1)\n            for(int block_index = 0; block_index < block_count; ++block_index){\n                HeapBlock &block = blocks[block_index];\n                block.permutation = block.seed;\n                block.last_match = -1;\n                int counters[heap_block_vertices] = {};\n                int permutation_index = 0;\n                do{\n                    const bool match = verifyPermutation(g1, g2, block.permutation);\n                    block.matches[permutation_index] = match ? 1 : 0;\n                    if(match)\n                        block.last_match = permutation_index;\n                    ++permutation_index;\n                }while(nextBlockPermutation(block.permutation, counters));\n            }\n\n            // Replay only matching blocks, preserving the original output order.\n            #pragma omp single\n            {\n                for(int block_index = 0; block_index < block_count; ++block_index){\n                    HeapBlock &block = blocks[block_index];\n                    if(block.last_match < 0)\n                        continue;\n                    isomorphism_found = true;\n                    block.permutation = block.seed;\n                    int counters[heap_block_vertices] = {};\n                    for(int permutation_index = 0;\n                        permutation_index <= block.last_match; ++permutation_index){\n                        if(block.matches[permutation_index])\n                            printPermutation(block.permutation);\n                        if(permutation_index < block.last_match)\n                            nextBlockPermutation(block.permutation, counters);\n                    }\n                }\n            }\n        }\n    }\n    return isomorphism_found;\n}\n}\n#endif\n\nint main(){\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if(!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\n    vector<int> equivalence(g1.size(), 0);\n    vector<int> exchange_counter(g1.size(), 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    if(g1.size() != g2.size()) return false;\n\n    for(int i = 0; i < equivalence.size(); ++i)\n        equivalence[i] = i;\n\n    if(verifyPermutation(g1, g2, equivalence)){\n        printPermutation(equivalence);\n        return true;\n    }\n\n#ifdef _OPENMP\n    if(g1.size() > heap_block_vertices && omp_get_max_threads() > 1)\n        return testIsomorphismParallel(g1, g2, equivalence, exchange_counter);\n#endif\n\n    /*\n     * Permutations are based on Heap's algorithm, which generates all possible\n     * permutations for a given set of elements.\n     */\n    while(exchange_index < g1.size()){\n        if(exchange_counter[exchange_index] < exchange_index){\n            if(exchange_index % 2 == 0)\n                swap(equivalence[0], equivalence[exchange_index]);\n            else\n                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\n            if(verifyPermutation(g1, g2, equivalence)){\n                printPermutation(equivalence);\n                isomorphism_found = true;\n            }\n\n            exchange_counter[exchange_index]++;\n            exchange_index = 1;\n        }else{\n            exchange_counter[exchange_index] = 0;\n            exchange_index++;\n        }\n    }\n    return isomorphism_found;\n}\n\nadjacency_matrix readGraph(){\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read(vertices);\n    for (int i = 0; i < vertices; ++i)\n        read[i].resize(vertices);\n\n    cin >> edges;\n    for (int i = 0; i < edges; i++) {\n       cin >> source >> destination;\n       read[destination][source] = read[source][destination] = true;\n    }\n\n    return read;\n}\n\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence){\n    for (int i = 0; i < equivalence.size(); ++i) {\n        for (int j = 0; j <= i; ++j) {\n            if(g1[i][j] != g2[equivalence[i]][equivalence[j]]) return false;\n        }\n    }\n   return true;\n}\n\ninline void printPermutation(vector<int> &equivalence){\n    for (auto i : equivalence)\n        cout << i << \" \";\n    cout << endl;\n}\n",
      "path": "src/brute_isomorphism.cpp"
    }
  ],

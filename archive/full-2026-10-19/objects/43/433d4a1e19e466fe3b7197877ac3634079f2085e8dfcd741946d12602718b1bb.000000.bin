"""Complément CSV des panneaux d’état, depuis le JSON graphique déjà exporté."""
import argparse
import csv
import json
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--export-directory", type=Path, required=True)
    args = parser.parse_args()
    root = args.export_directory.resolve(strict=True)
    if root.parent != Path(__file__).resolve().parent:
        raise ValueError("dossier graphique local requis")
    data = json.loads((root / "donnees-et-etats.json").read_text(encoding="utf8"))
    rows = []

    def row(revision, scope, metric, value, unit, status, reference):
        rows.append({"revision": revision, "scope": scope, "metric": metric, "value": value,
                     "unit": unit, "status": status, "source_path": reference["path"], "source_sha256": reference["sha256"]})

    luna = data["R2"]["provisional_luna"]
    row("R2", "Luna751992", "gain_declared_by_checker", luna["gain_percent"], "%",
        "provisoire_audit_independant_performance_non_valide", luna["source"])
    r2g = data["R2"]["R2g"]
    for key in ("received_invocations", "known_exact_tokens", "measured_invocations", "unmeasured_invocations"):
        row("R2", "R2g", key, r2g[key], "tokens" if "tokens" in key else "count", "clos_partiel_metadonnees_seulement", r2g["reconciliation"])
    row("R2", "R2g", "exact_total_tokens", "", "tokens", "inconnu_pas_de_total_exact", r2g["reconciliation"])
    r3 = data["R3_R4b"]
    row("R3_R4b", "trois_stages_R7_clos", "native_model_calls", r3["R7_native_calls"], "count", "qualification_pas_de_gain_recu", r3["source"])
    r5 = data["R5"]
    controller = r5["controller_only"]
    row("R5", "recherche_native", "native_search_cells_run", r5["native_search_cells_run"], "count", "non_lancee", controller["source"])
    for item in controller["comparisons"]:
        row("R5", "controleur_synthetique_same_pipeline_trials_" + str(item["trials"]),
            "controller_time_reduction", item["controller_time_reduction_percent"], "%",
            "controleur_seulement_aucun_gain_programme_HPC", controller["source"])
    with (root / "donnees-panneaux-R2-R3-R5.csv").open("x", encoding="utf-8-sig", newline="") as stream:
        writer = csv.DictWriter(stream, fieldnames=list(rows[0]), delimiter=";")
        writer.writeheader()
        writer.writerows(rows)
    print(json.dumps({"status_rows_exported": len(rows), "scientific_execution": False}))


if __name__ == "__main__":
    main()

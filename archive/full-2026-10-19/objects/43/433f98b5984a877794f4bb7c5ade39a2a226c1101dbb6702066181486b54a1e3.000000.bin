"""Durable callback for RpcLink; no process, socket, inference or admission.

Files contain private raw protocol evidence. They must stay outside the future
model filesystem. Their mere location here does not prove that read isolation.
fsync and a separate tail checkpoint detect incomplete/altered process-crash
recovery. This module claims neither power-loss durability on Windows nor a
security boundary against a host capable of rewriting all the evidence.
"""
from __future__ import annotations

import hashlib
import os
import stat
import threading
import time
import uuid
from dataclasses import asdict
from pathlib import Path

from native_protocol import (
    MAX_RECORD_BYTES,
    SHA256,
    MissionIdentity,
    canonical,
    digest,
    parse_record,
    require,
)

SCHEMA = "hpc-forest-native-private-evidence-v1"
KINDS = frozenset({"outgoing_attempt", "outgoing_notification", "incoming_raw", "notification",
                   "response", "duplicate_response", "deadline_observed", "eof"})
PIN_NAMES = frozenset({"startup_proposal_sha256", "cli_sha256", "config_sha256"})


def _safe_path(path: Path):
    require(path.is_absolute() and str(path) == str(path.resolve()), "Noncanonical evidence path")
    for ancestor in (path, *path.parents):
        if ancestor.exists():
            attributes = getattr(ancestor.lstat(), "st_file_attributes", 0)
            require(not ancestor.is_symlink()
                    and not attributes & getattr(stat, "FILE_ATTRIBUTE_REPARSE_POINT", 0x400),
                    "Evidence paths must not traverse symlinks/junctions/reparse points")


def _binding(identity, pins, max_bytes, max_events):
    require(isinstance(identity, MissionIdentity), "Missing mission identity")
    require(isinstance(pins, dict) and set(pins) == PIN_NAMES
            and all(isinstance(value, str) and SHA256.fullmatch(value) for value in pins.values()),
            "Evidence pins must bind the startup proposal, CLI and configuration")
    require(type(max_bytes) is int and 1024 <= max_bytes <= 512 * 1024 * 1024
            and type(max_events) is int and 1 <= max_events <= 1_000_000,
            "Invalid evidence storage bounds")
    return {"schema": SCHEMA, "identity": asdict(identity), "pins": dict(pins),
            "max_bytes": max_bytes, "max_events": max_events,
            "max_record_bytes": MAX_RECORD_BYTES, "native_admission": False}


def _write_synced_new(path, raw):
    with path.open("xb", buffering=0) as stream:
        view = memoryview(raw)
        while view:
            written = stream.write(view)
            require(type(written) is int and written > 0, "Incomplete evidence write")
            view = view[written:]
        os.fsync(stream.fileno())


def _read_bounded(path, maximum):
    _safe_path(path)
    require(path.is_file() and path.stat().st_size <= maximum, "Evidence file missing/oversized")
    with path.open("rb") as stream:
        raw = stream.read(maximum + 1)
    require(len(raw) <= maximum, "Evidence changed beyond its storage bound")
    return raw


def _file_stamp(path):
    _safe_path(path)
    value = path.stat()
    return value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns, value.st_ctime_ns


def read_snapshot(path: Path, identity: MissionIdentity, pins: dict,
                  *, max_bytes=256 * 1024 * 1024, max_events=100_000):
    """Read-only verification; no truncation, lock removal, resend or repair.

    A stream with a live writer may be between the append and checkpoint steps.
    Such a snapshot is rejected, never silently shortened. Repeat this read only
    after establishing the writer's actual state; it is no generation permit.
    """
    path = Path(path)
    _safe_path(path)
    expected = _binding(identity, pins, max_bytes, max_events)
    require(parse_record(_read_bounded(path / "binding.json", MAX_RECORD_BYTES)) == expected,
            "Evidence identity/pins/bounds changed")
    before = _read_bounded(path / "checkpoint.json", 4096)
    checkpoint = parse_record(before)
    raw = _read_bounded(path / "events.jsonl", max_bytes)
    require(not raw or raw.endswith(b"\n"), "Truncated evidence; preserve it without repair")
    previous, events = digest(expected), []
    for line in raw.splitlines():
        row = parse_record(line)
        require(set(row) == {"sequence", "previous_sha256", "event", "sha256"}, "Invalid evidence row")
        require(type(row["sequence"]) is int and row["sequence"] == len(events)
                and row["previous_sha256"] == previous, "Evidence sequence/hash link changed")
        body = {key: value for key, value in row.items() if key != "sha256"}
        require(row["sha256"] == digest(body), "Evidence row checksum changed")
        require(isinstance(row["event"], dict)
                and row["event"].get("kind") in KINDS | {"observer_closed"}, "Invalid evidence event")
        require(not events or events[-1]["kind"] != "observer_closed", "Evidence appended after seal")
        events.append(row["event"])
        require(len(events) <= max_events, "Evidence event cap exceeded")
        previous = row["sha256"]
    sealed = bool(events and events[-1]["kind"] == "observer_closed")
    require(checkpoint == {"binding_sha256": digest(expected), "event_count": len(events),
                           "byte_count": len(raw), "tail_sha256": previous, "sealed": sealed},
            "Evidence tail/checkpoint disagree; no automatic recovery or replay")
    require(_read_bounded(path / "checkpoint.json", 4096) == before,
            "Writer changed the checkpoint during this read")
    return {"schema": SCHEMA, "binding_sha256": digest(expected), "events": events,
            "event_count": len(events), "byte_count": len(raw), "tail_sha256": previous,
            "sealed": sealed, "writer_lock_present": (path / "writer.lock").exists(),
            "events_file_sha256": hashlib.sha256(raw).hexdigest(),
            "generation_permitted": False, "native_codex_adapter_validated": False}


class DurableObserver:
    """One fresh, exclusively owned callback stream for one RPC connection.

    The process-scoped writer lock is not a worker/CIM identity or stop receipt.
    If an append or checkpoint fails the instance becomes unusable and retains
    its lock for explicit reconciliation. Reopening an old stream for writing
    is deliberately unsupported. A successful callback returns only after the
    row and checkpoint have been flushed and fsynced.
    """

    def __init__(self, path: Path, identity: MissionIdentity, pins: dict,
                 *, max_bytes=256 * 1024 * 1024, max_events=100_000):
        self.path, self.identity, self.pins = Path(path), identity, dict(pins)
        self.binding = _binding(identity, pins, max_bytes, max_events)
        _safe_path(self.path)
        self.path.mkdir(parents=False, exist_ok=False)
        self._owner = {"pid": os.getpid(), "owner_nonce": uuid.uuid4().hex,
                       "created_monotonic_ns": time.monotonic_ns(),
                       "binding_sha256": digest(self.binding)}
        self._owner_raw = canonical(self._owner) + b"\n"
        self._mutex = threading.Lock()
        self.failure, self.closed = None, False
        self._count, self._bytes, self._tail = 0, 0, digest(self.binding)
        _write_synced_new(self.path / "writer.lock", self._owner_raw)
        _write_synced_new(self.path / "binding.json", canonical(self.binding) + b"\n")
        _write_synced_new(self.path / "events.jsonl", b"")
        _write_synced_new(self.path / "checkpoint.json", self._checkpoint(False))
        self._stream_stamp = _file_stamp(self.path / "events.jsonl")

    def _checkpoint(self, sealed):
        return canonical({"binding_sha256": digest(self.binding), "event_count": self._count,
                          "byte_count": self._bytes, "tail_sha256": self._tail, "sealed": sealed}) + b"\n"

    def _healthy(self):
        require(not self.closed and self.failure is None, "Evidence writer closed/failed; reconcile only")
        require(_read_bounded(self.path / "writer.lock", 4096) == self._owner_raw,
                "Evidence writer ownership changed")
        require(parse_record(_read_bounded(self.path / "binding.json", MAX_RECORD_BYTES)) == self.binding,
                "Evidence identity/pins/bounds changed")
        require(_read_bounded(self.path / "checkpoint.json", 4096) == self._checkpoint(False)
                and _file_stamp(self.path / "events.jsonl") == self._stream_stamp,
                "Another writer altered the evidence")
        # Do not reread a growing transcript for every tiny input chunk. The
        # full chain is verified by read_snapshot, including before sealing.
        # Stamps/checkpoints guard ordinary concurrent modification meanwhile;
        # they are not a boundary against a hostile host rewriting metadata.

    def _append(self, event, *, seal=False):
        self._healthy()
        event = parse_record(canonical(event))  # Detach caller-owned dictionaries before writing.
        require(event.get("kind") in KINDS | ({"observer_closed"} if seal else set()),
                "Unadmitted evidence event kind")
        body = {"sequence": self._count, "previous_sha256": self._tail, "event": event}
        checksum = digest(body)
        raw = canonical({**body, "sha256": checksum}) + b"\n"
        require(len(raw) <= MAX_RECORD_BYTES and self._bytes + len(raw) <= self.binding["max_bytes"]
                and self._count < self.binding["max_events"], "Evidence bound reached; outcome remains unknown")
        with (self.path / "events.jsonl").open("ab", buffering=0) as stream:
            view = memoryview(raw)
            while view:
                written = stream.write(view)
                require(type(written) is int and written > 0, "Incomplete evidence append")
                view = view[written:]
            os.fsync(stream.fileno())
        self._count, self._bytes, self._tail = self._count + 1, self._bytes + len(raw), checksum
        self._stream_stamp = _file_stamp(self.path / "events.jsonl")
        temporary = self.path / ("checkpoint-" + self._owner["owner_nonce"] + ".tmp")
        _write_synced_new(temporary, self._checkpoint(seal))
        os.replace(temporary, self.path / "checkpoint.json")

    def __call__(self, event):
        with self._mutex:
            try:
                self._append(event)
            except Exception:
                self.failure = "Evidence callback failed; keep files/lock and reconcile without replay"
                raise

    def close(self):
        with self._mutex:
            try:
                self._healthy()
                read_snapshot(self.path, self.identity, self.pins,
                              max_bytes=self.binding["max_bytes"], max_events=self.binding["max_events"])
                self._append({"kind": "observer_closed"}, seal=True)
                require(_read_bounded(self.path / "writer.lock", 4096) == self._owner_raw,
                        "Evidence writer ownership changed before close")
                (self.path / "writer.lock").unlink()
                self.closed = True
            except Exception:
                self.failure = "Evidence close failed; no completion or ownership release is claimed"
                raise

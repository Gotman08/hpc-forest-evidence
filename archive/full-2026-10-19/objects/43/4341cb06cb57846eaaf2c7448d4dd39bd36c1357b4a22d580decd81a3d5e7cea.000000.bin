    "files": [
      {
        "content": "/*\n * This code was based on Sokoban C available at\n * http://www.rosettacode.org/wiki/Sokoban#C\n * licenced under GNU Free Documentation License 1.2\n */\n\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <unistd.h>\n#include <stdint.h>\n#include <stddef.h>\n#include <assert.h>\n#include <stdbool.h>\n\nint w, h, n_boxes;\nuint8_t * board, * goals, * live;\n\ntypedef uint16_t cidx_t;\ntypedef uint32_t hash_t;\n\n/* board configuration is represented by an array of cell indices\n   of player and boxes */\ntypedef struct state_t state_t;\n\nstruct state_t { // variable length\n    hash_t h;\n    state_t * prev, * next, * qnext;\n    cidx_t c[];\n};\n\nsize_t state_size, block_size = 32;\nstate_t * block_root, * block_head;\n\ninline\nstate_t * newstate(state_t * parent) {\n    inline state_t * next_of(state_t * s) {\n        return (void * )((uint8_t * ) s + state_size);\n    }\n\n    state_t * ptr;\n    if (!block_head) {\n        block_size *= 2;\n        state_t * p = malloc(block_size * state_size);\n        assert(p);\n        p -> next = block_root;\n        block_root = p;\n        ptr = (void * )((uint8_t * ) p + state_size * block_size);\n        p = block_head = next_of(p);\n        state_t * q;\n        for (q = next_of(p); q < ptr; p = q, q = next_of(q))\n            p -> next = q;\n        p -> next = NULL;\n    }\n\n    ptr = block_head;\n    block_head = block_head -> next;\n\n    ptr -> prev = parent;\n    ptr -> h = 0;\n    return ptr;\n}\n\ninline\nvoid unnewstate(state_t * p) {\n    p -> next = block_head;\n    block_head = p;\n}\n\nenum {\n    space,\n    wall,\n    player,\n    box\n};\n\n// mark up positions where a box definitely should not be\nvoid mark_live(const int c) {\n    const int y = c / w,\n        x = c % w;\n    if (live[c]) return;\n\n    live[c] = 1;\n    if (y > 1 && board[c - w] != wall && board[c - w * 2] != wall)\n        mark_live(c - w);\n    if (y < h - 2 && board[c + w] != wall && board[c + w * 2] != wall)\n        mark_live(c + w);\n    if (x > 1 && board[c - 1] != wall && board[c - 2] != wall)\n        mark_live(c - 1);\n    if (x < w - 2 && board[c + 1] != wall && board[c + 2] != wall)\n        mark_live(c + 1);\n}\n\nstate_t * parse_board(const char * s) {\n    board = calloc(w * h, sizeof(uint8_t));\n    assert(board);\n    goals = calloc(w * h, sizeof(uint8_t));\n    assert(goals);\n    live = calloc(w * h, sizeof(uint8_t));\n    assert(live);\n\n    n_boxes = 0;\n    for (int i = 0; s[i]; i++) {\n        switch (s[i]) {\n        case '#':\n            board[i] = wall;\n            continue;\n\n        case '.': // fallthrough\n        case '+':\n            goals[i] = 1; // fallthrough\n        case '@':\n            continue;\n\n        case '*':\n            goals[i] = 1; // fallthrough\n        case '$':\n            n_boxes++;\n            continue;\n        default:\n            continue;\n        }\n    }\n\n    const int is = sizeof(int);\n    state_size = (sizeof(state_t) + (1 + n_boxes) * sizeof(cidx_t) + is - 1) /\n        is * is;\n\n    state_t * state = newstate(NULL);\n\n    for (int i = 0, j = 0; i < w * h; i++) {\n        if (goals[i]) mark_live(i);\n        if (s[i] == '$' || s[i] == '*')\n            state -> c[++j] = i;\n        else if (s[i] == '@' || s[i] == '+')\n            state -> c[0] = i;\n    }\n\n    return state;\n}\n\n// K&R hash function\ninline\nvoid hash(state_t * s) {\n    if (!s -> h) {\n        register hash_t ha = 0;\n        cidx_t * p = s -> c;\n        for (int i = 0; i <= n_boxes; i++)\n            ha = p[i] + 31 * ha;\n        s -> h = ha;\n    }\n}\n\nstate_t ** buckets;\nhash_t hash_size, fill_limit, filled;\n\nvoid extend_table() {\n    int old_size = hash_size;\n\n    if (!old_size) {\n        hash_size = 1024;\n        filled = 0;\n        fill_limit = hash_size * 3 / 4; // 0.75 load factor\n    } else {\n        hash_size *= 2;\n        fill_limit *= 2;\n    }\n\n    buckets = realloc(buckets, sizeof(state_t * ) * hash_size);\n    assert(buckets);\n\n    // rehash\n    memset(buckets + old_size, 0, sizeof(state_t * ) * (hash_size - old_size));\n\n    const hash_t bits = hash_size - 1;\n    for (int i = 0; i < old_size; i++) {\n        state_t * head = buckets[i];\n        buckets[i] = NULL;\n        while (head) {\n            state_t * next = head -> next;\n            const int j = head -> h & bits;\n            head -> next = buckets[j];\n            buckets[j] = head;\n            head = next;\n        }\n    }\n}\n\nstate_t * lookup(state_t * s) {\n    hash(s);\n    state_t * f = buckets[s -> h & (hash_size - 1)];\n    for (; f; f = f -> next) {\n        if ( //(f->h == s->h) &&\n            !memcmp(s -> c, f -> c, sizeof(cidx_t) * (1 + n_boxes)))\n            break;\n    }\n\n    return f;\n}\n\nbool add_to_table(state_t * s) {\n    if (lookup(s)) {\n        unnewstate(s);\n        return false;\n    }\n\n    if (filled++ >= fill_limit)\n        extend_table();\n\n    hash_t i = s -> h & (hash_size - 1);\n\n    s -> next = buckets[i];\n    buckets[i] = s;\n    return true;\n}\n\nbool success(const state_t * s) {\n    for (int i = 1; i <= n_boxes; i++)\n        if (!goals[s -> c[i]]) return false;\n    return true;\n}\n\nstatic bool move_info(const state_t * s, int dy, int dx,\n    int * cell1_out, int * box_out, int * cell2_out) {\n    const int y = s -> c[0] / w;\n    const int x = s -> c[0] % w;\n    const int y1 = y + dy;\n    const int x1 = x + dx;\n    const int c1 = y1 * w + x1;\n\n    if (y1 < 0 || y1 > h || x1 < 0 || x1 > w ||\n        board[c1] == wall)\n        return false;\n\n    int at_box = 0;\n    for (int i = 1; i <= n_boxes; i++) {\n        if (s -> c[i] == c1) {\n            at_box = i;\n            break;\n        }\n    }\n\n    int c2 = 0;\n    if (at_box) {\n        c2 = c1 + dy * w + dx;\n        if (board[c2] == wall || !live[c2])\n            return false;\n        for (int i = 1; i <= n_boxes; i++)\n            if (s -> c[i] == c2) return false;\n    }\n\n    *cell1_out = c1;\n    *box_out = at_box;\n    *cell2_out = c2;\n    return true;\n}\n\nstatic void fill_move_positions(const state_t * s, int cell1, int at_box,\n    int cell2, cidx_t * positions) {\n    memcpy(positions + 1, s -> c + 1, sizeof(cidx_t) * n_boxes);\n    positions[0] = cell1;\n    if (at_box) positions[at_box] = cell2;\n\n    // leet bubble sort\n    for (int i = n_boxes; --i;) {\n        cidx_t t = 0;\n        for (int j = 1; j < i; j++) {\n            if (positions[j] > positions[j + 1])\n                t = positions[j], positions[j] = positions[j + 1], positions[j + 1] = t;\n        }\n        if (!t) break;\n    }\n}\n\nstate_t * move_me(state_t * s,\n    const int dy,\n        const int dx) {\n    int c1, at_box, c2;\n    if (!move_info(s, dy, dx, &c1, &at_box, &c2))\n        return NULL;\n\n    state_t * n = newstate(s);\n    fill_move_positions(s, c1, at_box, c2, n -> c);\n    return n;\n}\n\nstatic bool make_move_candidate(const state_t * s, int dy, int dx,\n    cidx_t * positions) {\n    int c1, at_box, c2;\n    if (!move_info(s, dy, dx, &c1, &at_box, &c2))\n        return false;\n    fill_move_positions(s, c1, at_box, c2, positions);\n    return true;\n}\n\nstate_t * next_level, * done;\n\nbool queue_move(state_t * s) {\n    if (!s || !add_to_table(s))\n        return false;\n\n    if (success(s)) {\n        done = s;\n        return true;\n    }\n\n    s -> qnext = next_level;\n    next_level = s;\n    return false;\n}\n\nbool do_move(state_t * s) {\n    return queue_move(move_me(s, 0, 1)) ||\n        queue_move(move_me(s, 0, -1)) ||\n        queue_move(move_me(s, -1, 0)) ||\n        queue_move(move_me(s, 1, 0));\n}\n\n#ifdef _OPENMP\nenum { PARALLEL_THRESHOLD = 64, PARALLEL_BATCH = 16 };\n\nstatic bool do_parallel_level(state_t * head) {\n    state_t * parents[PARALLEL_BATCH];\n    uint8_t valid[PARALLEL_BATCH * 4];\n    const int dy[4] = { 0, 0, -1, 1 };\n    const int dx[4] = { 1, -1, 0, 0 };\n    uint8_t * scratch = malloc((size_t) PARALLEL_BATCH * 4 * state_size);\n    assert(scratch);\n\n    state_t * cursor = head;\n    int batch_count = 0;\n\n    #pragma omp parallel shared(cursor, batch_count, parents, valid, scratch, dy, dx)\n    {\n        for (;;) {\n            #pragma omp single\n            {\n                batch_count = 0;\n                while (batch_count < PARALLEL_BATCH && cursor) {\n                    parents[batch_count++] = cursor;\n                    cursor = cursor -> qnext;\n                }\n            }\n\n            if (batch_count == 0 || done)\n                break;\n\n            #pragma omp for schedule(static)\n            for (int i = 0; i < batch_count; i++) {\n                for (int d = 0; d < 4; d++) {\n                    const size_t slot = (size_t) i * 4 + d;\n                    cidx_t * positions = (cidx_t *)(scratch +\n                        slot * state_size + offsetof(state_t, c));\n                    valid[slot] = (uint8_t) make_move_candidate(\n                        parents[i], dy[d], dx[d], positions);\n                }\n            }\n\n            #pragma omp single\n            {\n                for (int i = 0; i < batch_count && !done; i++) {\n                    for (int d = 0; d < 4; d++) {\n                        const size_t slot = (size_t) i * 4 + d;\n                        if (valid[slot]) {\n                            const cidx_t * positions = (const cidx_t *)(scratch +\n                                slot * state_size + offsetof(state_t, c));\n                            state_t * child = newstate(parents[i]);\n                            memcpy(child -> c, positions,\n                                sizeof(cidx_t) * (1 + n_boxes));\n                            if (queue_move(child))\n                                break;\n                        }\n                    }\n                }\n            }\n\n            if (done)\n                break;\n        }\n    }\n\n    free(scratch);\n    return done != NULL;\n}\n#endif\n\nvoid show_moves(const state_t * s, int nextPos) {\n    if (s -> prev)\n        show_moves(s -> prev, s -> c[0]);\n    if (nextPos == -1) {\n        printf(\"\\n\");\n        return;\n    }\n    int cx = s -> c[0] % w;\n    int cy = s -> c[0] / w;\n    int nx = nextPos % w;\n    int ny = nextPos / w;\n    int box = 0;\n    for (int i = 1; !box && i <= n_boxes; i++)\n        box = s -> c[i] == nextPos;\n    if (cx < nx) printf(box ? \"R\" : \"r\");\n    else if (cx > nx) printf(box ? \"L\" : \"l\");\n    else if (cy < ny) printf(box ? \"D\" : \"d\");\n    else if (cy > ny) printf(box ? \"U\" : \"u\");\n    else if (1) {\n        printf(\"Invalid move\\n\");\n        exit(1);\n    }\n}\n\nint main() {\n    size_t sz = 1024;\n    char * boardStr = malloc(sz * sizeof(char));\n    char * pos = boardStr;\n    w = -1;\n    h = 0;\n    while (1) {\n        int read = getline( & pos, & sz, stdin);\n        if (read == -1) break;\n        if (read >= w) w = read;\n        sz -= read;\n        pos += read;\n        h++;\n    }\n    state_t * s = parse_board(boardStr);\n    free(boardStr);\n\n    extend_table();\n    queue_move(s);\n    while (!done) {\n        state_t * head = next_level;\n        next_level = NULL;\n#ifdef _OPENMP\n        state_t * probe = head;\n        int wide = 1;\n        for (int i = 0; i < PARALLEL_THRESHOLD; i++) {\n            if (!probe) {\n                wide = 0;\n                break;\n            }\n            probe = probe -> qnext;\n        }\n        if (wide) {\n            do_parallel_level(head);\n        } else\n#endif\n        {\n            for (; head && !done; head = head -> qnext)\n                do_move(head);\n        }\n\n        if (!done && !next_level) {\n            puts(\"no solution?\");\n            return 1;\n        }\n    }\n\n    show_moves(done, -1);\n\n    free(buckets);\n    free(board);\n    free(goals);\n    free(live);\n\n    while (block_root) {\n        void * tmp = block_root -> next;\n        free(block_root);\n        block_root = tmp;\n    }\n    return 0;\n}\n",
        "path": "src/sokoban.c"
      }
    ],
    "hypothesis": "For sufficiently wide BFS frontiers, parallelizing independent move-candidate generation with OpenMP static scheduling can reduce search time on four cores. Serially merging candidates in the existing parent-and-direction order preserves deterministic duplicate handling, goal selection, and path tie-breaking; narrow frontiers retain the sequential path to avoid parallel overhead.",
    "notes": "One source-only frontier-expansion experiment; OpenMP work sharing is enabled only when the build defines _OPENMP. Also avoid reporting failure when a solution is found before any non-goal successor is queued.",
    "sources_kept": [],
    "transformations": [
      "Factor move validation and state-position construction so independent candidates can be generated without touching shared allocation, hash-table, or queue state.",
      "For layers with at least 64 states, generate moves in batches of 16 parents using an OpenMP parallel-for with static scheduling; merge valid candidates serially in the original traversal order.",
      "Keep the existing sequential expansion for smaller layers and guard the no-solution check so it does not override a discovered solution."
    ]

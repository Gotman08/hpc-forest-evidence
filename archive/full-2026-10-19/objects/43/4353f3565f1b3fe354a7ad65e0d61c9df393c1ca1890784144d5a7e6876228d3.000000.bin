"""Bind a fresh set of real evidence after the preserved alias-reader refusal."""
from pathlib import Path
import hashlib
import json

HERE=Path(__file__).resolve().parent
FRESH=HERE/'preuves-refraichies-r2'
PREP=HERE.parent
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def read(p):return json.loads(p.read_text(encoding='utf-8-sig'))
def ref(p):return {'path':str(p),'sha256':sha(p)}
def save(p,x):
    with p.open('x',encoding='utf-8',newline='\n') as h:
        json.dump(x,h,ensure_ascii=False,indent=2)
        h.write('\n')
packet=read(HERE/'packet-collection-reel.json')
assert packet['job_id']=='752306'
refs=packet['refs']
for k,n in [('allocation_marker','allocation-marker.json'),('request_prepared','request-prepared.json'),('fresh_private_full_cim','cim-reel.json')]:
    refs[k]=ref(FRESH/n)
assert refs['allocation_marker']['sha256']==sha(HERE/'allocation-marker.json')
assert refs['request_prepared']['sha256']==sha(HERE/'request-prepared.json')
oauthref=read(FRESH/'oauth-source-ref.json')
assert sha(Path(oauthref['path']))==oauthref['sha256']
refs['oauth_source']=oauthref
refs['codex_config']=read(Path(oauthref['path']))['codex_config']
rawref=read(FRESH/'mixed-admission-ref.json')
assert sha(Path(rawref['path']))==rawref['sha256']
policy=read(Path(rawref['path']))
folder=FRESH/'mixed-evidence-immuable'
folder.mkdir(exist_ok=False)
ev=[]
for i,item in enumerate(policy['evidence_refs']):
    source=Path(item['path'])
    raw=source.read_bytes()
    assert hashlib.sha256(raw).hexdigest()==item['sha256']
    target=folder/(str(i)+'-'+source.name)
    with target.open('xb') as h:h.write(raw)
    assert sha(target)==item['sha256']
    ev.append(ref(target))
policy['evidence_refs']=[*ev,rawref]
save(FRESH/'mixed-admission-immuable.json',policy)
refs['mixed_observer_admission']=ref(FRESH/'mixed-admission-immuable.json')
remote={'schema':'hpc-forest-dynamic-r4b-actual-remote-checks-v1','verified':True,
    'path_absence':ref(FRESH/'remote-checks-paths.json'),
    'listings':[ref(FRESH/n) for n in ('listing-root.json','listing-mailbox.json','listing-requests.json','listing-responses.json','listing-logs.json')],
    'downloads':[ref(FRESH/n) for n in ('download-marker.json','download-request.json','download-owner.json')]}
save(FRESH/'remote-checks-reels.json',remote)
refs['remote_checks']=ref(FRESH/'remote-checks-reels.json')
save(FRESH/'packet-collection-reel.json',packet)
print(json.dumps({'packet':ref(FRESH/'packet-collection-reel.json'),'job_id':'752306','same_request_bytes':True}))

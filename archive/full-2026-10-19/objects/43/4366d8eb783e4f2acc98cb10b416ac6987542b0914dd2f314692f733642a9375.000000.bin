{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include \\\"knn.h\\\"\\n\\ntypedef struct {\\n    float distance;\\n    size_t ordinal;\\n    char label;\\n} Candidate;\\n\\nenum {\\n    DISTANCE_BLOCK = 128,\\n    MAX_PARTITIONS = 4\\n};\\n\\nstatic int candidate_is_better(const Candidate *left, const Candidate *right) {\\n    if (left->distance < right->distance) {\\n        return 1;\\n    }\\n    if (right->distance < left->distance) {\\n        return 0;\\n    }\\n    return left->ordinal < right->ordinal;\\n}\\n\\nstatic void sift_down(Candidate *heap, int count, int root) {\\n    while (root < count / 2) {\\n        int worst = root;\\n        int left = root * 2 + 1;\\n        int right = left + 1;\\n\\n        if (candidate_is_better(&heap[worst], &heap[left])) {\\n            worst = left;\\n        }\\n        if (right < count && candidate_is_better(&heap[worst], &heap[right])) {\\n            worst = right;\\n        }\\n        if (worst == root) {\\n            break;\\n        }\\n\\n        Candidate temporary = heap[root];\\n        heap[root] = heap[worst];\\n        heap[worst] = temporary;\\n        root = worst;\\n    }\\n}\\n\\nstatic void make_max_heap(Candidate *heap, int count) {\\n    for (int index = count / 2; index > 0; --index) {\\n        sift_down(heap, count, index - 1);\\n    }\\n}\\n\\nstatic void consider_candidate(Candidate *heap, int *count, int capacity,\\n                               Candidate candidate) {\\n    if (*count < capacity) {\\n        heap[*count] = candidate;\\n        ++*count;\\n        if (*count == capacity) {\\n            make_max_heap(heap, capacity);\\n        }\\n    } else if (candidate_is_better(&candidate, &heap[0])) {\\n        heap[0] = candidate;\\n        sift_down(heap, capacity, 0);\\n    }\\n}\\n\\nstatic char select_label(char *labels, int k) {\\n    qsort(labels, k, sizeof(char), compare_for_sort);\\n\\n    char most_frequent = labels[0];\\n    int most_frequent_count = 1;\\n    int current_frequency = 1;\\n\\n    for (int i = 1; i < k; ++i) {\\n        if (labels[i] != labels[i - 1]) {\\n            if (current_frequency > most_frequent_count) {\\n                most_frequent = labels[i - 1];\\n                most_frequent_count = current_frequency;\\n            }\\n            current_frequency = 1;\\n        } else {\\n            ++current_frequency;\\n        }\\n\\n        if (i == k - 1 && current_frequency > most_frequent_count) {\\n            most_frequent = labels[i - 1];\\n            most_frequent_count = current_frequency;\\n        }\\n    }\\n\\n    return most_frequent;\\n}\\n\\nstatic char knn_insertion(int n_groups, Group *groups, int k,\\n                          Point to_evaluate) {\\n    char *labels = (char *)malloc(sizeof(char) * k);\\n    float *distances = (float *)malloc(sizeof(float) * k);\\n\\n    for (int i = 0; i < k; ++i) {\\n        labels[i] = -1;\\n        distances[i] = -1;\\n    }\\n\\n    for (int i = 0; i < n_groups; ++i) {\\n        Group group = groups[i];\\n\\n        for (int j = 0; j < group.length; ++j) {\\n            float distance = euclidean_distance_no_sqrt(to_evaluate, group.points[j]);\\n\\n            for (int x = 0; x < k; ++x) {\\n                if (distance < distances[x] || distances[x] == -1) {\\n                    for (int y = k - 1; y > x; --y) {\\n                        distances[y] = distances[y - 1];\\n                        labels[y] = labels[y - 1];\\n                    }\\n                    distances[x] = distance;\\n                    labels[x] = group.label;\\n                    break;\\n                }\\n            }\\n        }\\n    }\\n\\n    char result = select_label(labels, k);\\n    free(distances);\\n    free(labels);\\n    return result;\\n}\\n\\nstatic int fill_local_heap(Group *groups, int n_groups, Point to_evaluate,\\n                           size_t start, size_t end, Candidate *heap, int k) {\\n    int count = 0;\\n    int group_index = 0;\\n    size_t group_begin = 0;\\n    size_t index = start;\\n    const float evaluation_x = to_evaluate.x;\\n    const float evaluation_y = to_evaluate.y;\\n\\n    while (index < end) {\\n        while (group_index < n_groups) {\\n            size_t group_end = group_begin + (size_t)groups[group_index].length;\\n            if (index < group_end) {\\n                break;\\n            }\\n            group_begin = group_end;\\n            ++group_index;\\n        }\\n\\n        if (group_index == n_groups) {\\n            return 0;\\n        }\\n\\n        Group group = groups[group_index];\\n        size_t group_end = group_begin + (size_t)group.length;\\n        size_t segment_end = end < group_end ? end : group_end;\\n        size_t span = segment_end - index;\\n        size_t offset = 0;\\n        const Point * restrict points = group.points + (index - group_begin);\\n\\n        while (span - offset >= DISTANCE_BLOCK) {\\n            float distances[DISTANCE_BLOCK];\\n            const Point *block = points + offset;\\n\\n#if defined(_OPENMP)\\n#pragma omp simd\\n#elif defined(__GNUC__)\\n#pragma GCC ivdep\\n#endif\\n            for (int lane = 0; lane < DISTANCE_BLOCK; ++lane) {\\n                float dx = block[lane].x - evaluation_x;\\n                float dy = block[lane].y - evaluation_y;\\n                distances[lane] = dx * dx + dy * dy;\\n            }\\n\\n            for (int lane = 0; lane < DISTANCE_BLOCK; ++lane) {\\n                float distance = distances[lane];\\n                if (distance != distance) {\\n                    return 1;\\n                }\\n                Candidate candidate = {\\n                    distance,\\n                    index + offset + (size_t)lane,\\n                    group.label\\n                };\\n                consider_candidate(heap, &count, k, candidate);\\n            }\\n            offset += DISTANCE_BLOCK;\\n        }\\n\\n        while (offset < span) {\\n            Point point = points[offset];\\n            float dx = point.x - evaluation_x;\\n            float dy = point.y - evaluation_y;\\n            float distance = dx * dx + dy * dy;\\n            if (distance != distance) {\\n                return 1;\\n            }\\n            Candidate candidate = {\\n                distance,\\n                index + offset,\\n                group.label\\n            };\\n            consider_candidate(heap, &count, k, candidate);\\n            ++offset;\\n        }\\n\\n        index = segment_end;\\n    }\\n\\n    return 0;\\n}\\n\\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n    if (k <= 0 || n_groups <= 0) {\\n        return knn_insertion(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    size_t total_points = 0;\\n    for (int i = 0; i < n_groups; ++i) {\\n        if (groups[i].length < 0) {\\n            return knn_insertion(n_groups, groups, k, to_evaluate);\\n        }\\n        size_t length = (size_t)groups[i].length;\\n        if (length > (size_t)-1 - total_points) {\\n            return knn_insertion(n_groups, groups, k, to_evaluate);\\n        }\\n        total_points += length;\\n    }\\n\\n    if ((size_t)k > total_points) {\\n        return knn_insertion(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    int partitions = 1;\\n#ifdef _OPENMP\\n    partitions = MAX_PARTITIONS;\\n#endif\\n    while (partitions > 1 && (size_t)k > total_points / (size_t)partitions) {\\n        --partitions;\\n    }\\n\\n    if ((size_t)k > (size_t)-1 / ((size_t)partitions * sizeof(Candidate))) {\\n        return knn_insertion(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    Candidate *local_heaps = (Candidate *)malloc(\\n        sizeof(Candidate) * (size_t)partitions * (size_t)k);\\n    if (local_heaps == NULL) {\\n        return knn_insertion(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    int nan_found[MAX_PARTITIONS] = {0};\\n\\n#ifdef _OPENMP\\n#pragma omp parallel for schedule(static)\\n#endif\\n    for (int partition = 0; partition < partitions; ++partition) {\\n        size_t start = total_points * (size_t)partition / (size_t)partitions;\\n        size_t end = total_points * (size_t)(partition + 1) / (size_t)partitions;\\n        Candidate *heap = local_heaps + (size_t)partition * (size_t)k;\\n        nan_found[partition] = fill_local_heap(groups, n_groups, to_evaluate,\\n                                               start, end, heap, k);\\n    }\\n\\n    for (int partition = 0; partition < partitions; ++partition) {\\n        if (nan_found[partition]) {\\n            free(local_heaps);\\n            return knn_insertion(n_groups, groups, k, to_evaluate);\\n        }\\n    }\\n\\n    Candidate *final_heap = (Candidate *)malloc(sizeof(Candidate) * (size_t)k);\\n    if (final_heap == NULL) {\\n        free(local_heaps);\\n        return knn_insertion(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    int final_count = 0;\\n    for (int partition = 0; partition < partitions; ++partition) {\\n        Candidate *heap = local_heaps + (size_t)partition * (size_t)k;\\n        for (int i = 0; i < k; ++i) {\\n            consider_candidate(final_heap, &final_count, k, heap[i]);\\n        }\\n    }\\n\\n    char *labels = (char *)malloc(sizeof(char) * (size_t)k);\\n    for (int i = 0; i < k; ++i) {\\n        labels[i] = final_heap[i].label;\\n    }\\n\\n    char result = select_label(labels, k);\\n    free(labels);\\n    free(final_heap);\\n    free(local_heaps);\\n    return result;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n\\n    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; ++i) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\"path\":\"src/knn.c\"}],\"hypothesis\":\"Replacing the loop-carried insertion array with stable local max-heaps makes top-k selection O(points log k); disjoint OpenMP partitions and an independent distance block enable legal ARM64 SIMD while ordinal tie-breaking preserves the sequential neighbor set.\",\"notes\":\"NaN distances and cases lacking k points use the original insertion path, preserving its sentinel and unordered-comparison behavior. The OpenMP pragmas compile away to one partition when OpenMP is unavailable.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Use stable max-heaps keyed by distance then original encounter ordinal for exact top-k membership under equal distances.\",\"Partition the original encounter order into bounded local heaps, process them with OpenMP when enabled, and serially merge their candidates deterministically.\",\"Separate each contiguous distance block from heap updates and mark its dependency-free loop for OpenMP SIMD/GCC vectorization.\"]}"}}

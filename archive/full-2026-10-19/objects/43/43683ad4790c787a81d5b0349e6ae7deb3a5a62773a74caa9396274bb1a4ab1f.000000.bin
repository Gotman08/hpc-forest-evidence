      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <climits>\n\nstatic inline int read_int() {\n    static const int BUFSIZE = 1 << 20;\n    static char buf[BUFSIZE];\n    static int idx = 0, size = 0;\n    while (true) {\n        if (idx >= size) {\n            size = fread(buf, 1, BUFSIZE, stdin);\n            idx = 0;\n            if (size == 0) return 0; // EOF\n        }\n        char c = buf[idx++];\n        if (c >= '0' && c <= '9') {\n            int x = c - '0';\n            while (idx < size && buf[idx] >= '0' && buf[idx] <= '9') {\n                x = x * 10 + (buf[idx++] - '0');\n            }\n            return x;\n        } else if (c == '-') {\n            int x = 0;\n            while (idx < size && buf[idx] >= '0' && buf[idx] <= '9') {\n                x = x * 10 + (buf[idx++] - '0');\n            }\n            return -x;\n        }\n    }\n}\n\nint main() {\n    int n = read_int();\n    int s = read_int();\n\n    // prefix sums: pref[(i+1)*(n+1)+(j+1)] = sum of matrix[0..i][0..j]\n    std::vector<long long> pref((n + 1) * (n + 1), 0);\n    for (int i = 0; i < n; ++i) {\n        int row_base = i * (n + 1);\n        int next_row_base = (i + 1) * (n + 1);\n        for (int j = 0; j < n; ++j) {\n            int val = read_int();\n            pref[next_row_base + j + 1] = pref[row_base + j + 1] + pref[next_row_base + j] - pref[row_base + j] + val;\n        }\n    }\n\n    long long mx = LLONG_MIN;\n    int limit = n - s; // inclusive upper bound for r and c\n    const long long* base = pref.data();\n    #pragma omp parallel for schedule(static) reduction(max:mx)\n    for (int r = 0; r <= limit; ++r) {\n        const long long* tl = base + r * (n + 1);\n        const long long* tr = tl + s;\n        const long long* bl = base + (r + s) * (n + 1);\n        const long long* br = bl + s;\n        #pragma omp simd reduction(max:mx)\n        for (int c = 0; c <= limit; ++c) {\n            long long sum = br[c] - tr[c] - bl[c] + tl[c];\n            if (sum > mx) mx = sum;\n        }\n    }\n\n    printf(\"%d\\n\", (int)mx);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

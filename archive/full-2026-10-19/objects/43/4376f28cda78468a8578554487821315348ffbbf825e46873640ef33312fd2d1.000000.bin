#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

/*
 * Each body holds coordinate positions (i.e., x, y, and z) and
 * velocities (i.e., vx, vy, and vz).
 */
typedef struct { float x, y, z, vx, vy, vz; } Body;

/* Scalar work item for an unpaired final body. */
static void body_force_one(Body *p, float dt, int n, int i) {
  float fx = 0.0f;
  float fy = 0.0f;
  float fz = 0.0f;

  for (int j = 0; j < n; j++) {
    float dx = p[j].x - p[i].x;
    float dy = p[j].y - p[i].y;
    float dz = p[j].z - p[i].z;
    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
    float inv_dist = 1 / sqrt(sqrd_dist);
    float inv_dist3 = inv_dist * inv_dist * inv_dist;

    fx += dx * inv_dist3;
    fy += dy * inv_dist3;
    fz += dz * inv_dist3;
  }

  p[i].vx += dt*fx;
  p[i].vy += dt*fy;
  p[i].vz += dt*fz;
}

/* Called collectively by the threads of the current team. */
static void body_force_workshare(Body *p, float dt, int n) {
  const int work_items = n / 2 + n % 2;

  #pragma omp for schedule(static)
  for (int item = 0; item < work_items; ++item) {
    const int i = 2 * item;
    if (i + 1 == n) {
      body_force_one(p, dt, n, i);
      continue;
    }

    const float x0 = p[i].x;
    const float y0 = p[i].y;
    const float z0 = p[i].z;
    const float x1 = p[i + 1].x;
    const float y1 = p[i + 1].y;
    const float z1 = p[i + 1].z;
    float fx0 = 0.0f;
    float fy0 = 0.0f;
    float fz0 = 0.0f;
    float fx1 = 0.0f;
    float fy1 = 0.0f;
    float fz1 = 0.0f;

    /* Independent targets share source loads, not their reductions. */
    for (int j = 0; j < n; j++) {
      const float xj = p[j].x;
      const float yj = p[j].y;
      const float zj = p[j].z;
      float dx0 = xj - x0;
      float dy0 = yj - y0;
      float dz0 = zj - z0;
      float dx1 = xj - x1;
      float dy1 = yj - y1;
      float dz1 = zj - z1;
      float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;
      float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;
      float inv_dist0 = 1 / sqrt(sqrd_dist0);
      float inv_dist1 = 1 / sqrt(sqrd_dist1);
      float inv_dist30 = inv_dist0 * inv_dist0 * inv_dist0;
      float inv_dist31 = inv_dist1 * inv_dist1 * inv_dist1;

      fx0 += dx0 * inv_dist30;
      fy0 += dy0 * inv_dist30;
      fz0 += dz0 * inv_dist30;
      fx1 += dx1 * inv_dist31;
      fy1 += dy1 * inv_dist31;
      fz1 += dz1 * inv_dist31;
    }

    p[i].vx += dt*fx0;
    p[i].vy += dt*fy0;
    p[i].vz += dt*fz0;
    p[i + 1].vx += dt*fx1;
    p[i + 1].vy += dt*fy1;
    p[i + 1].vz += dt*fz1;
  }
}

/*
 * Compute the gravitational impact among all pairs of bodies in
 * the system, retaining an independently callable entry point.
 */
void body_force(Body *p, float dt, int n) {
  #pragma omp parallel if(n >= 64)
  {
    body_force_workshare(p, dt, n);
  }
}

/*
 * Read a binary dataset with initilized bodies.
 */
Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  return bodies;
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc,char **argv) {
  int nbodies;

  Body *bodies = read_dataset(&nbodies);

  /* Keep one team alive across all simulation iterations. */
  #pragma omp parallel if(nbodies >= 64)
  {
    for (int iter = 0; iter < N_ITER; iter++) {
      body_force_workshare(bodies, DT, nbodies);

      #pragma omp for schedule(static)
      for (int i = 0; i < nbodies; i++) {
        bodies[i].x += bodies[i].vx * DT;
        bodies[i].y += bodies[i].vy * DT;
        bodies[i].z += bodies[i].vz * DT;
      }
    }
  }

  write_dataset(nbodies, bodies);

  free(bodies);

  exit(EXIT_SUCCESS);
}

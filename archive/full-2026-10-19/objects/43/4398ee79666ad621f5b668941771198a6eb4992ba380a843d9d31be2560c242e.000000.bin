{
  "arch": "armgpu",
  "cpus_per_task": 1,
  "mem_gb": 1,
  "gpus_per_node": 0,
  "gpus_per_task": 0,
  "nodes": 1,
  "ntasks_per_node": 1,
  "name": "forest-r4b-r7-original-sha-alias-r2",
  "time_limit": "00:01:00",
  "workdir": "/scratch_p/nimarano",
  "command": "set -euo pipefail\n/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python -I -S - <<'HASH_ONLY_R7_ALIAS_R2'\n\"\"\"Allocated read/hash of exactly three ORIGINAL terminal archives; never extract or write.\"\"\"\nimport hashlib\nimport json\nimport os\nfrom pathlib import PurePosixPath\nimport platform\nimport re\nimport stat\nimport time\nfrom datetime import UTC, datetime\n\nRECORDS = [{'job_id': '754549', 'session_id': '80d47d8d3f8f4e35bc26ceb54d06e870', 'model': 'gpt-6.1-sol', 'path': '/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-80d47d8d3f8f4e35bc26ceb54d06e870/contract-results-754549.tar.gz'}, {'job_id': '754550', 'session_id': '29583a77237e4777aa09209331ec7ecd', 'model': 'gpt-6-astra', 'path': '/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-29583a77237e4777aa09209331ec7ecd/contract-results-754550.tar.gz'}, {'job_id': '754552', 'session_id': '3ae8341d27784c1bbd830ac19e4b77bc', 'model': 'gpt-5.6-terra', 'path': '/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-3ae8341d27784c1bbd830ac19e4b77bc/contract-results-754552.tar.gz'}]\nMAX_BYTES_PER_ARCHIVE = 512 * 1024**2\nDEADLINE = datetime(2026, 10, 31, 23, 0, tzinfo=UTC).timestamp()\n\n\ndef need(ok, message):\n    if not ok:\n        raise ValueError(message)\n\n\ndef file_identity(facts):\n    return (facts.st_dev, facts.st_ino, facts.st_mode, facts.st_nlink,\n            facts.st_size, facts.st_mtime_ns, facts.st_ctime_ns)\n\n\ndef directory_identity(facts):\n    need(stat.S_ISDIR(facts.st_mode), \"Only no-follow ordinary directory handles\")\n    return (facts.st_dev, facts.st_ino, facts.st_mode)\n\n\ndef infrastructure_alias_snapshot():\n    \"\"\"Only /scratch_p is an allowed alias, solely to the exact canonical tree.\"\"\"\n    literal, expected = '/scratch_p', '/gpfs/scratch'\n    before = os.lstat(literal)\n    need(stat.S_ISLNK(before.st_mode), 'Only the explicitly declared infrastructure symlink is permitted')\n    target = os.readlink(literal)\n    need(target in {expected, expected + '/'}, 'No other alias target or intermediate alias is allowed')\n    resolved = os.path.realpath(literal, strict=True)\n    need(resolved == expected, 'Infrastructure alias must resolve strictly to /gpfs/scratch')\n    after = os.lstat(literal)\n    need(file_identity(before) == file_identity(after) and os.readlink(literal) == target\n         and os.path.realpath(literal, strict=True) == expected, 'Infrastructure alias changed during metadata validation')\n    return {'literal_path': literal, 'readlink_target': target, 'observed_canonical_path': resolved,\n            'lstat_before': list(file_identity(before)), 'lstat_after': list(file_identity(after)),\n            'metadata_unchanged': True, 'only_this_infrastructure_alias_allowed': True}\n\n\ndef hash_exact_archive(row):\n    literal = PurePosixPath(row['path'])\n    need(literal.is_absolute() and '..' not in literal.parts and literal.parts[:3] == ('/', 'scratch_p', 'nimarano'),\n         'Exact original scratch archive path')\n    need(literal.name == 'contract-results-' + row['job_id'] + '.tar.gz'\n         and literal.parent.name == 'hpc-forest-dynamic-r4b-max-' + row['session_id'], 'Exact closed job/session archive binding')\n    alias_before = infrastructure_alias_snapshot()\n    path = PurePosixPath('/gpfs/scratch').joinpath(*literal.parts[2:])\n    need(path.parts[:4] == ('/', 'gpfs', 'scratch', 'nimarano'), 'Only the derived exact canonical namespace')\n    need(all(hasattr(os, name) for name in ('O_DIRECTORY', 'O_NOFOLLOW', 'O_CLOEXEC', 'O_NONBLOCK')),\n         'POSIX held no-follow API required; no fallback')\n    directories = []\n    fd = None\n    try:\n        current = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)\n        directories.append((current, None, None, directory_identity(os.fstat(current))))\n        for name in path.parts[1:-1]:\n            child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=current)\n            facts = directory_identity(os.fstat(child))\n            directories.append((child, current, name, facts))\n            current = child\n        before = os.stat(path.name, dir_fd=current, follow_symlinks=False)\n        need(stat.S_ISREG(before.st_mode) and before.st_nlink == 1 and 0 < before.st_size <= MAX_BYTES_PER_ARCHIVE,\n             'Bounded single-link original regular archive required')\n        baseline = file_identity(before)\n        fd = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=current)\n        need(file_identity(os.fstat(fd)) == baseline, 'Archive path/held identity differs before read')\n        checksum = hashlib.sha256()\n        count = 0\n        while True:\n            block = os.read(fd, min(1024**2, MAX_BYTES_PER_ARCHIVE - count + 1))\n            if not block:\n                break\n            count += len(block)\n            need(count <= MAX_BYTES_PER_ARCHIVE, 'Archive exceeded its fixed read bound')\n            checksum.update(block)\n        need(count == before.st_size and file_identity(os.fstat(fd)) == baseline\n             and file_identity(os.stat(path.name, dir_fd=current, follow_symlinks=False)) == baseline,\n             'Original archive changed while hashing; no announcement promoted')\n        for child, parent, name, facts in directories:\n            need(directory_identity(os.fstat(child)) == facts, 'Held parent identity changed')\n            if parent is not None:\n                need(directory_identity(os.stat(name, dir_fd=parent, follow_symlinks=False)) == facts,\n                     'Original literal directory entry no longer matches its held parent chain')\n        alias_after = infrastructure_alias_snapshot()\n        need(alias_before == alias_after, 'Infrastructure alias changed while hashing original archive')\n        return {**row, 'canonical_path_observed': str(path), 'infrastructure_alias_proof': alias_after,\n                'literal_original_path_preserved': True, 'sha256': checksum.hexdigest(), 'bytes': count,\n                'original_bytes_unchanged': True, 'held_no_follow_file_and_parent_chain': True}\n    finally:\n        if fd is not None:\n            os.close(fd)\n        for child, _parent, _name, _facts in reversed(directories):\n            os.close(child)\n\n\ndef main():\n    need(platform.machine().lower() in {'aarch64', 'arm64'}, 'Actual ARM allocation required')\n    job = os.environ.get('SLURM_JOB_ID', '')\n    need(re.fullmatch('[0-9]+', job) is not None and job not in {row['job_id'] for row in RECORDS} | {'754337', '754586'},\n         'New actual allocation job ID required, never a source root replay')\n    need(os.environ.get('SLURM_CPUS_PER_TASK') == '1', 'Exactly one requested CPU per task')\n    need(time.time() + 60 + 10800 < DEADLINE, 'One-minute maximum plus three-hour audit reserve must fit strictly before deadline')\n    alias_before = infrastructure_alias_snapshot()\n    records = [hash_exact_archive(row) for row in RECORDS]\n    alias_after = infrastructure_alias_snapshot()\n    need(alias_before == alias_after, 'Infrastructure alias changed across the complete three-archive observation')\n    print(json.dumps({'schema': 'hpc-forest-r7-original-terminal-archives-hash-announcement-v1',\n        'verified_readonly_hashes': True, 'observed_at': time.time(),\n        'observed_at_utc': datetime.now(UTC).isoformat(), 'allocation_job_id': job,\n        'native_model_calls_by_hash_workload': 0, 'tests_or_compilations_replayed': 0,\n        'source_roots_call_counts_not_inferred': True, 'archives_extracted_or_modified': False,\n        'new_archive_created': False, 'infrastructure_alias_observation': alias_after, 'records': records}), flush=True)\n\n\nif __name__ == '__main__':\n    main()\nHASH_ONLY_R7_ALIAS_R2\n"
}

        ],
        "retained": [
          "Replace the sorted insertion buffers with a bottom-up contiguous max heap whose root is the worst retained neighbor.",
          "Keep distance, encounter-order, and label data synchronized so equal-distance cutoff selection follows original global encounter order.",
          "Retain the original insertion implementation as a fallback and keep the original qsort-based label vote."
        ]
      },
      "hypothesis": "A contiguous distance-hot max heap can replace cache-unfriendly full top-k scans and shifts, reducing selection work from O(points*k) to O(points log k) while preserving stable equal-distance membership.",

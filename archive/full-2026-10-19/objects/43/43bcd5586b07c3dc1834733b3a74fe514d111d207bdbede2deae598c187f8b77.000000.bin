#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* Maximum size (in char) for neighbors and compute lists */
#define MAX 100

typedef struct {
  int id;
  float value;
  char neighbors[MAX];
} Node;

/* Reads input, allocates memory, writes graph size and node list. Returns the graph. */
Node* read_input(char* fname, int *n, char* list) {
  Node* data = NULL;
  FILE *fl = NULL;

  if (fname == NULL)
    fl = stdin;
  else
    fl = fopen(fname, "r");

  if (fl == NULL) {
    fprintf(stderr, "Error!\n");
    exit(1);
  }

  /* Keep scansets on their input line and leave room for the terminator. */
  list[0] = '\0';
  fscanf(fl, "%d%99[^\n]", n, list);

  if (*n > 0) {
    data = (Node*) malloc((*n) * sizeof(Node));
    if (data == NULL) {
      fprintf(stderr, "Error!\n");
      exit(1);
    }
  }

  for (int i = 0; i < *n; i++) {
    data[i].neighbors[0] = '\0';
    fscanf(fl, "%d %f%99[^\n]", &data[i].id, &data[i].value,
           data[i].neighbors);
  }

  if (fl != stdin)
    fclose(fl);

  return data;
}

/* Returns the index of the first node with the given id or -1 if not found. */
int find_by_id(const int ids[], int id, int size) {
  for (int i = 0; i < size; i++) {
    if (ids[i] == id)
      return i;
  }

  return -1;
}

/* Computes the sum for the node with the given id. */
float get_costly(Node *g, const int ids[], int id, int size) {
  int idmax = -1;
  float max = 0;
  char *auxptr;

  int nd = find_by_id(ids, id, size);
  if (nd < 0)
    return max;

  char aux[MAX];
  strcpy(aux, g[nd].neighbors);
  char *t = strtok_r(aux, " ", &auxptr);

  while (t != NULL) {
    int neighbor_id = atoi(t);
    int d = find_by_id(ids, neighbor_id, size);
    if (d >= 0 && max < g[d].value) {
      max = g[d].value;
      idmax = neighbor_id;
    }
    t = strtok_r(NULL, " ", &auxptr);
  }

  float r = g[nd].value;

  if (idmax != -1)
    r += get_costly(g, ids, idmax, size);

  return r;
}

/* Main program - calls read input, computes sum for each node in the list, prints output. */
int main(void) {
  char *fileN = NULL;
  char computelist[MAX];
  int n = -1;
  Node* input = NULL;

  input = read_input(fileN, &n, computelist);

  /* A packed ID array keeps repeated lookup scans contiguous. */
  int *ids = NULL;
  if (input != NULL) {
    ids = (int*) malloc(n * sizeof(*ids));
    if (ids == NULL) {
      fprintf(stderr, "Error!\n");
      exit(1);
    }
    for (int i = 0; i < n; i++)
      ids[i] = input[i].id;
  }

  for (char *c = strtok(computelist, " "); c != NULL; c = strtok(NULL, " "))
    printf("%s: %f\n", c, get_costly(input, ids, atoi(c), n));

  free(ids);
  free(input);

  return 0;
}

    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\n#define DIST_CHUNK 64\\n\\nstatic int is_worse(float da, long ia, float db, long ib) {\\n    return (da > db) || (da == db && ia > ib);\\n}\\n\\nstatic void swap3(float *hd, long *hi, char *hl, int a, int b) {\\n    float td = hd[a]; hd[a] = hd[b]; hd[b] = td;\\n    long ti = hi[a]; hi[a] = hi[b]; hi[b] = ti;\\n    char tc = hl[a]; hl[a] = hl[b]; hl[b] = tc;\\n}\\n\\nstatic void heap_push(float *hd, long *hi, char *hl, int *n,\\n                      float d, long idx, char label) {\\n    int i = (*n)++;\\n    hd[i] = d; hi[i] = idx; hl[i] = label;\\n\\n    while (i > 0) {\\n        int parent = (i - 1) / 2;\\n        if (is_worse(hd[i], hi[i], hd[parent], hi[parent])) {\\n            swap3(hd, hi, hl, i, parent);\\n            i = parent;\\n        } else {\\n            break;\\n        }\\n    }\\n}\\n\\nstatic void heap_replace_root(float *hd, long *hi, char *hl, int n,\\n                              float d, long idx, char label) {\\n    hd[0] = d; hi[0] = idx; hl[0] = label;\\n    int i = 0;\\n\\n    for (;;) {\\n        int left = 2 * i + 1;\\n        if (left >= n) break;\\n        int right = left + 1;\\n        int worst = i;\\n\\n        if (is_worse(hd[left], hi[left], hd[worst], hi[worst])) {\\n            worst = left;\\n        }\\n        if (right < n && is_worse(hd[right], hi[right], hd[worst], hi[worst])) {\\n            worst = right;\\n        }\\n\\n        if (worst == i) break;\\n        swap3(hd, hi, hl, i, worst);\\n        i = worst;\\n    }\\n}\\n\\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n    size_t total = 0;\\n    for (int gi = 0; gi < n_groups; ++gi) {\\n        total += (size_t)groups[gi].length;\\n    }\\n\\n    float *xs = NULL;\\n    if (posix_memalign((void **)&xs, 64, total * sizeof(float)) != 0) {\\n        xs = malloc(total * sizeof(float));\\n    }\\n    float *ys = NULL;\\n    if (posix_memalign((void **)&ys, 64, total * sizeof(float)) != 0) {\\n        ys = malloc(total * sizeof(float));\\n    }\\n    char *plabels = (char *)malloc(total * sizeof(char));\\n\\n    size_t pos = 0;\\n    for (int gi = 0; gi < n_groups; ++gi) {\\n        Group g = groups[gi];\\n        char lab = g.label;\\n        for (int j = 0; j < g.length; ++j) {\\n            xs[pos] = g.points[j].x;\\n            ys[pos] = g.points[j].y;\\n            plabels[pos] = lab;\\n            ++pos;\\n        }\\n    }\\n\\n    float tx = to_evaluate.x;\\n    float ty = to_evaluate.y;\\n\\n#ifdef _OPENMP\\n    int nthreads = omp_get_max_threads();\\n#else\\n    int nthreads = 1;\\n#endif\\n\\n    /* Per-thread local max-heaps. Each thread keeps the best k points of its\\n       assigned chunk; merging these heaps afterwards yields the global top-k\\n       because any point not selected by its own chunk is dominated by at least\\n       k points from that same chunk, all of which are present in the union. */\\n    float *all_ld = (float *)malloc((size_t)nthreads * k * sizeof(float));\\n    long *all_li = (long *)malloc((size_t)nthreads * k * sizeof(long));\\n    char *all_ll = (char *)malloc((size_t)nthreads * k * sizeof(char));\\n    int *lns = (int *)calloc(nthreads, sizeof(int));\\n\\n#pragma omp parallel\\n    {\\n        int t = 0;\\n#ifdef _OPENMP\\n        t = omp_get_thread_num();\\n#endif\\n        float *ld = all_ld + (size_t)t * k;\\n        long *li = all_li + (size_t)t * k;\\n        char *ll = all_ll + (size_t)t * k;\\n        int ln = 0;\\n        float dist_chunk[DIST_CHUNK] __attribute__((aligned(64)));\\n\\n#pragma omp for schedule(static)\\n        for (long base = 0; base < (long)total; base += DIST_CHUNK) {\\n            long end = base + DIST_CHUNK;\\n            if (end > (long)total) end = (long)total;\\n\\n#pragma omp simd aligned(xs, ys: 64)\\n            for (long p = base; p < end; ++p) {\\n                float dx = xs[p] - tx;\\n                float dy = ys[p] - ty;\\n                dist_chunk[p - base] = dx * dx + dy * dy;\\n            }\\n\\n            for (long p = base; p < end; ++p) {\\n                float d = dist_chunk[p - base];\\n                if (ln < k) {\\n                    heap_push(ld, li, ll, &ln, d, p, plabels[p]);\\n                } else if (is_worse(ld[0], li[0], d, p)) {\\n                    heap_replace_root(ld, li, ll, k, d, p, plabels[p]);\\n                }\\n            }\\n        }\\n\\n        lns[t] = ln;\\n    }\\n\\n    float *heap_d = (float *)malloc(k * sizeof(float));\\n    long *heap_idx = (long *)malloc(k * sizeof(long));\\n    char *heap_lab = (char *)malloc(k * sizeof(char));\\n    int heap_n = 0;\\n\\n    for (int t = 0; t < nthreads; ++t) {\\n        float *ld = all_ld + (size_t)t * k;\\n        long *li = all_li + (size_t)t * k;\\n        char *ll = all_ll + (size_t)t * k;\\n        for (int i = 0; i < lns[t]; ++i) {\\n            float d = ld[i];\\n            long idx = li[i];\\n            if (heap_n < k) {\\n                heap_push(heap_d, heap_idx, heap_lab, &heap_n,\\n                          d, idx, ll[i]);\\n            } else if (is_worse(heap_d[0], heap_idx[0], d, idx)) {\\n                heap_replace_root(heap_d, heap_idx, heap_lab, k,\\n                                  d, idx, ll[i]);\\n            }\\n        }\\n    }\\n\\n    char *labels = (char *)malloc(k * sizeof(char));\\n    for (int i = 0; i < k; ++i) {\\n        if (i < heap_n) labels[i] = heap_lab[i];\\n        else labels[i] = -1;\\n    }\\n\\n    qsort(labels, k, sizeof(char), compare_for_sort);\\n\\n    char most_frequent = labels[0];\\n    int most_frequent_count = 1;\\n    int current_frequency = 1;\\n\\n    for (int i = 1; i < k; ++i) {\\n        if (labels[i] != labels[i - 1]) {\\n            if (current_frequency > most_frequent_count) {\\n                most_frequent = labels[i - 1];\\n                most_frequent_count = current_frequency;\\n            }\\n\\n            current_frequency = 1;\\n        } else {\\n            ++current_frequency;\\n        }\\n\\n        if (i == k - 1 && current_frequency > most_frequent_count) {\\n            most_frequent = labels[i - 1];\\n            most_frequent_count = current_frequency;\\n        }\\n    }\\n\\n    free(xs); free(ys); free(plabels);\\n    free(all_ld); free(all_li); free(all_ll); free(lns);\\n    free(heap_d); free(heap_idx); free(heap_lab); free(labels);\\n\\n    return most_frequent;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n\\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; ++i) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n    return 0;\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Parallelize the top-k selection itself by giving each OpenMP thread a private max-heap for its contiguous chunk of points, then merging those local heaps deterministically. This removes the serial heap bottleneck while keeping distance computation SIMD-friendly through small aligned scratch buffers, preserving exact (distance, original-index) tie-breaking and label-frequency semantics.\",\n  \"notes\": \"Only src/knn.c is modified. The distance array is no longer materialized globally; distances are computed in vectorizable chunks inside each thread's private region. Local heaps use the same comparator as before, so merging them yields exactly the global top-k under the original tie-breaking rule. Frequency counting and output remain unchanged.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Replace serial heap selection with per-thread local max-heaps followed by deterministic merge\",\n    \"Compute distances in aligned SIMD chunks inside each thread instead of a separate global distance pass\",\n  
"""Copy named inert G regressions; no process, CLI, model or discovery runs."""
from pathlib import Path

BASE = Path(__file__).resolve().parents[3]
SOURCE = BASE / "work/hpc-forest-primes-natif-relance-r2g/project/tests"
DEST = BASE / "work/hpc-forest-mere-dynamique-r4b-lane-r3/project/tests"
owned = (SOURCE / "test_owned_timeout_r2e.py").read_text(encoding="utf8")
(DEST / "test_owned_timeout_lane_r3.py").write_text(owned.replace("r2e_owned_timeout_core", "lane_r3_owned_timeout_core"), encoding="utf8")
host = (SOURCE / "test_host_policy_r2g.py").read_text(encoding="utf8")
host = host.replace("codex_process, native_r2max", "codex_process, native_matrix")
host = host.replace("native_r2max.SCOPE", "native_matrix.SCOPE")
host = host.replace("native_r2max.CELLS[MODEL]", '"3b1de5658e4641149b15a3bea4850239"')
diag = (SOURCE / "test_codex_cli_diagnostics_r2e.py").read_text(encoding="utf8")
start = diag.index("def command_policy(")
end = diag.index('@pytest.mark.parametrize("with_diagnostic"')
# These selected functions use only in-memory argv, inert JSON and TOML, no worker.
extra = diag[start:end]
host = host.replace("import json\n", "import json\nimport tomllib\nfrom subprocess import list2cmdline\n", 1)
(DEST / "test_cli_contract_lane_r3.py").write_text(host + "\n\n" + extra, encoding="utf8")

      "content": "#include<stdio.h>\n#include<stdlib.h>\n#include<math.h>\n#ifdef _OPENMP\n#include<omp.h>\n#endif\n\nvoid bubble_sort (double *matriz, int tam) {\n    int i, j;\n    double aux;\n\n    for (i = tam - 1; i > 0; i--) {\n        for (j = 0; j < i; j++) {\n            if (matriz[j] > matriz[j+1]) {\n                aux=matriz[j];\n                matriz[j]=matriz[j+1];\n                matriz[j+1]=aux;\n            }\n        }\n    }\n}\n\nvoid ordena_colunas(double *matriz,int lin, int col) {\n    int i;\n\n    for (i = 0; i < col; i++) {\n        //manda o endereco do primeiro elemento da coluna, limites inf e sup e a largura da matriz\n        bubble_sort(&matriz[i*lin], lin);\n    }\n}\n\nvoid calcula_media(double *matriz, double *vet,int lin, int col){\n    int i,j;\n    double soma;\n    for(i=0;i<col;i++){\n        soma=0;\n        for(j=0;j<lin;j++){\n            soma+=matriz[i*lin+j];\n        }\n        vet[i]=soma/lin;\n    }\n}\n\nvoid calcula_media_harmonica(double *matriz, double *vet,int lin, int col){\n    int i,j;\n    double soma;\n    for(i=0;i<col;i++){\n        soma=0;\n        for(j=0;j<lin;j++){\n            soma+=(1/(matriz[i*lin+j]));\n        }\n        vet[i]=lin/soma;\n    }\n}\n\nvoid calcula_mediana(double *matriz, double *vet, int lin, int col) {\n     int i=0;\n     if((lin-1)%2){ //Quantidade par de elementos\n         for (i = 0; i < col; i++) {\n            vet[i]=(matriz[(((i*lin)+(i+1)*lin)-1)/2]+matriz[((((i*lin)+(i+1)*lin)-1)/2)+1]);\n            vet[i]*=0.5;\n         }\n     }\n     else{ //Quantidade ímpar de elementos\n         for (i = 0; i < col; i++) {\n            vet[i]=matriz[(((i*lin)+(i+1)*lin)-1)/2];\n         }\n     }\n}\n\n//Adaptado de https://www.clubedohardware.com.br/forums/topic/1291570-programa-em-c-que-calcula-moda-media-e-mediana/\ndouble moda_aux(double *matriz,int lin){\n    int i, j;\n    float conta=0, moda=0;\n\n    for(i=0;i<lin;i++){\n        double cont=0;\n        for(j=i+1;j<lin;j++){\n            if(matriz[i]==matriz[j]){\n                cont++;\n                if(cont>conta){\n                    conta=cont;\n                    moda=matriz[i];\n                }\n            }\n        }\n    }\n    if(conta == 0){\n        return -1;\n    }\n    else{\n        return moda;\n    }\n}\n\nvoid calcula_moda(double *matriz,double *moda,int lin, int col){\n    int i;\n    for(i=0;i<col;i++){\n        moda[i]=moda_aux(matriz+(i*lin),lin);\n    }\n}\n\nvoid calcula_variancia(double *matriz, double *media,double *variancia, int lin, int col){\n    int i,j;\n    double soma;\n    for(i=0;i<col;i++){\n        soma=0;\n        for(j=0;j<lin;j++){\n            soma+=pow((matriz[i*lin+j]-media[i]),2);\n        }\n        variancia[i]=soma/(lin-1);\n    }\n}\n\nvoid calcula_desvio_padrao(double *variancia,double *dp, int col){\n    int i;\n    for(i=0;i<col;i++){\n        dp[i]=sqrt(variancia[i]);\n    }\n}\n\nvoid calcula_coeficiente_variacao(double *media,double *dp,double *cv, int col){\n    int i;\n    for(i=0;i<col;i++){\n        cv[i]=dp[i]/media[i];\n    }\n}\n\nstatic void calcula_coluna(double *matriz, double *media, double *media_har,\n                           double *mediana, double *moda, double *variancia,\n                           double *dp, double *cv, int lin, int coluna){\n    double *valores=matriz+(size_t)coluna*(size_t)lin;\n\n    /* Preserve each metric's original accumulation and sorting order. */\n    calcula_media(valores,media+coluna,lin,1);\n    calcula_media_harmonica(valores,media_har+coluna,lin,1);\n    ordena_colunas(valores,lin,1);\n    calcula_mediana(valores,mediana+coluna,lin,1);\n    calcula_moda(valores,moda+coluna,lin,1);\n    calcula_variancia(valores,media+coluna,variancia+coluna,lin,1);\n    calcula_desvio_padrao(variancia+coluna,dp+coluna,1);\n    calcula_coeficiente_variacao(media+coluna,dp+coluna,cv+coluna,1);\n}\n\nstatic void calcula_metricas(double *matriz, double *media, double *media_har,\n                             double *mediana, double *moda, double *variancia,\n                             double *dp, double *cv, int lin, int col){\n    int i;\n#ifdef _OPENMP\n    int workers=omp_get_max_threads();\n    /* Together, sorting and mode counting perform lin*(lin-1)\n       pair comparisons per column. Amortize team startup with at least\n       262144 estimated comparisons per requested worker. */\n    double trabalho=(double)lin*((double)lin-1.0)*(double)col;\n\n    if(workers>4)\n        workers=4;\n    if(workers>col)\n        workers=col;\n    while(workers>1 && trabalho<262144.0*(double)workers)\n        workers--;\n\n    if(workers>1 && !omp_in_parallel()){\n        #pragma omp parallel for schedule(static) num_threads(workers)\n        for(i=0;i<col;i++){\n            calcula_coluna(matriz,media,media_har,mediana,moda,variancia,\n                           dp,cv,lin,i);\n        }\n        return;\n    }\n#endif\n    /* No OpenMP runtime entry for small or single-column workloads. */\n    for(i=0;i<col;i++){\n        calcula_coluna(matriz,media,media_har,mediana,moda,variancia,\n                       dp,cv,lin,i);\n    }\n}\n\nint main(int argc,char **argv){\n    int lin,col,i,j; // Define as variáveis de índices e dimensões\n    double *matriz,*mediana,*media,*media_har,*moda,*variancia,*dp,*cv; // Define a matriz (forma linear), vetores de medidas estatísticas\n\n    fscanf(stdin, \"%d \", &lin); // Lê a quantidade de linhas da matriz\n    fscanf(stdin, \"%d\\n\", &col); // Lê a quantidade de colunas da matriz\n\n    // Alocações\n    matriz=(double *)malloc(lin*col * sizeof(double)); // Aloca a matriz\n    media=(double *)malloc(col * sizeof(double)); // Aloca o vetor de media\n    media_har=(double *)malloc(col * sizeof(double)); // Aloca o vetor de media harmônica\n    mediana=(double *)malloc(col * sizeof(double)); // Aloca o vetor de mediana\n    moda=(double *)malloc(col * sizeof(double)); // Aloca o vetor de moda\n    variancia=(double *)malloc(col * sizeof(double)); // Aloca o vetor de variância\n    cv=(double *)malloc(col * sizeof(double)); // Aloca o vetor de coeficiente de variação\n    dp=(double *)malloc(col * sizeof(double)); // Aloca o vetor de desvio padrão\n\n    for(i=0;i<lin;i++){\n        for(j=0;j<col;j++){\n            fscanf(stdin, \"%lf \",&(matriz[j*lin+i])); // Lê os dados transpostos em uma matriz de entrada\n        }\n    }\n\n    calcula_metricas(matriz,media,media_har,mediana,moda,variancia,dp,cv,lin,col);\n\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",media[i]); // Imprime as médias aritméticas de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",media_har[i]); // Imprime as médias harmônicas de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",mediana[i]); // Imprime as medianas de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",moda[i]); // Imprime as modas de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",variancia[i]); // Imprime as variâncias amostrais de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",dp[i]); // Imprime os desvios padrão de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",cv[i]); // Imprime os coeficientes de variação de cada coluna\n    printf(\"\\n\");\n\n    // Desaloca memória\n    free(matriz);\n    free(media);\n    free(media_har);\n    free(mediana);\n    free(moda);\n    free(variancia);\n    free(dp);\n    free(cv);\n}\n",
      "path": "src/est_matriz_seq.c"
    }
  ],
  "hypothesis": "A size-gated, statically scheduled column pipeline can distribute the quadratic kernels across four cores without changing floating-point accumulation order. Column-local execution and allocation-free mode counting may also improve the serial fallback.",
  "notes": "No commands or measurements performed. OpenMP is conditional on the unchanged build defining _OPENMP; otherwise execution remains serial. The reference's uninitialized mode counters are replaced with defined zero-initialized counters, preserving float narrowing rather than relying on allocator contents.",
  "sources_kept": [],
  "transformations": [
    "Process all metrics for each independent column together, preserving original-order means, sorted-order variance, and serial output formatting.",
    "Use one guarded OpenMP parallel loop with static scheduling, capped by four cores, runtime thread availability, column count, and 262144 estimated comparisons per worker; bypass parallel-region entry for small workloads.",
    "Replace heap-allocated mode counters with an initialized private scalar per candidate value, retaining the existing nested comparisons and float conversions."

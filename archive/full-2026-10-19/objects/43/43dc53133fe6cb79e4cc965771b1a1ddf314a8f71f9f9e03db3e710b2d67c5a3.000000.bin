      "content": "{\"role\": \"G\", \"goal\": \"integration of diverse archived transformations; evaluate the full program\", \"experiment\": \"c059f0d171ad4ab2-h01\", \"ordinal\": 2, \"integration_source_ids\": [\"a981acbf59e44c56\", \"4cc657bc1f2b4fa1\", \"799a8a4eba48412f\", \"a041490e77d94e91\", \"3508177f7eef4978\", \"b1aa613c02de4815\", \"d369242eed97429d\"], \"current_source_paths\": [\"src/bucketsort.c\"], \"context_as_data\": {\"sources\": [{\"id\": \"a981acbf59e44c56\", \"role\": \"G\", \"commit\": \"e6b433c0d5df78a644491c8183cb5ea7e07740c3\", \"transformations\": {\"files\": [\"src/bucketsort.c\"], \"retained\": [\"Replace per-bucket insertion sorting of indices with stable least-significant-digit counting passes over all string bytes.\", \"Reuse one scratch buffer and scatter full records into contiguous ranges on each pass; zero-initialize input records to preserve ordering of variable-length strings.\"]}, \"mean_seconds\": 0.01090206392109394, \"diff\": \"diff --git a/src/bucketsort.c b/src/bucketsort.c\\nindex 9987e6c..8f81a26 100644\\n--- a/src/bucketsort.c\\n+++ b/src/bucketsort.c\\n@@ -1,142 +1,133 @@\\n-#include <stdio.h>\\n-#include <stdlib.h>\\n-#include <assert.h>\\n-#include <string.h>\\n-\\n-typedef struct {\\n-\\tlong int *data;\\n-\\tint length;\\n-\\tlong int total;\\n-} bucket;\\n-\\n-void sort(char *a, bucket *bucket) {\\n-\\tint j, i, length;\\n-\\tlong int key;\\n-\\tlength = bucket->length;\\n-\\n-\\tfor (j = 1; j < bucket->total; j++) {\\n-\\t\\tkey = bucket->data[j];\\n-\\t\\ti = j - 1;\\n-\\t\\twhile (i >= 0 && strcmp(a + bucket->data[i] * length, a + key * length) > 0) {\\n-\\t\\t\\tbucket->data[i + 1] = bucket->data[i];\\n-\\t\\t\\ti--;\\n-\\t\\t}\\n-\\t\\tbucket->data[i + 1] = key;\\n-\\t}\\n-}\\n-\\n-\\n-long int* bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\\n-\\n-\\tlong int i;\\n-\\tbucket   *buckets = NULL,\\n-             *b = NULL;\\n-\\tlong int *returns = NULL;\\n-\\n-\\t// allocate memory\\n-\\treturns = (long int *) malloc(sizeof(long int) * size);\\n-\\tbuckets = (bucket   *) malloc(sizeof(bucket) * nbuckets);\\n-\\n-\\n-\\tfor (i = 0; i < nbuckets; i++) {\\n-\\t\\tbuckets[i].data = returns + i * size / nbuckets;\\n-\\t\\tbuckets[i].length = length;\\n-\\t\\tbuckets[i].total = 0;\\n-\\t}\\n-\\n-\\t// copy the keys to \\\"buckets\\\"\\n-\\tfor (i = 0; i < size; i++) {\\n-\\t\\tb = &buckets[*(a + i * length) - offset]; //mascara de deslocamento\\n-\\t\\tb->data[b->total++] = i;\\n-\\t}\\n-\\n-\\t// sort each \\\"bucket\\\"\\n-\\tfor (i = 0; i < nbuckets; i++)\\n-\\t\\tsort(a, &buckets[i]);\\n-\\n-\\treturn returns;\\n-}\\n-\\n-void load(char **vString, long int *N, int *l, int *os, int *nb){\\n-   char *strings = NULL;\\n-   int      len,\\n-            offset,\\n-            nbucket;\\n-   long int n;\\n-\\n-   if (!fscanf(stdin, \\\"%d\\\", &len)) {\\n-      printf (\\\"ERROR len\\\\n\\\");\\n-      exit (1);\\n-   }\\n-\\n-   if (!fscanf(stdin, \\\"%ld\\\", &n)) {\\n-      printf (\\\"ERROR n\\\\n\\\");\\n-      exit (1);\\n-   }\\n-\\n-   if (!fscanf(stdin, \\\"%d\\\", &offset)) {\\n-      printf (\\\"ERROR offset\\\\n\\\");\\n-      exit (1);\\n-   }\\n-\\n-   if (!fscanf(stdin, \\\"%d\\\", &nbucket)) {\\n-      printf (\\\"ERROR nbucket\\\\n\\\");\\n-      exit (1);\\n-   }\\n-\\n-   nbucket = nbucket + 1;\\n-   len = len + 1;\\n-\\n-   strings = (char*) malloc(n * len);\\n-\\n-   for (int i = 0; i < n; i++){\\n-      if (!fscanf(stdin, \\\"%s\\\", strings + (i * len))) {\\n-      printf (\\\"ERROR %d\\\\n\\\",i);\\n-      exit (1);\\n-      }\\n-   }\\n-\\n-   *vString = strings;\\n-   *N = n;\\n-   *l = len;\\n-   *os = offset;\\n-   *nb = nbucket;\\n-}\\n-\\n-void print(char *strings, long int *index, long int n, int len){\\n-\\n-   for (int i = 0; i < n; i++){\\n-      printf(\\\"%d -> %s\\\\n\\\", i, strings + (index[i] * len));\\n-   }\\n-}\\n-\\n-void save(char *strings, long int *index, long int n, int len){\\n-   for (int i = 0; i < n; i++){\\n-      printf(\\\"%s\\\\n\\\", strings + (index[i] * len));\\n-   }\\n-}\\n-\\n-int main(int ac, char **av) {\\n-\\n-   char     *strings = NULL;\\n-   long int N        = 0;\\n-   long int *index   = NULL;\\n-   int      len      = 0,\\n-            save2File = 0,\\n-            offset,\\n-            nbuckets;\\n-\\n-   load(&strings, &N, &len, &offset, &nbuckets);\\n-\\n-   index = bucket_sort(strings, len, N, offset, nbuckets);\\n-\\n-   save(strings, index, N, len);\\n-\\n-   if (strings != NULL)\\n-      free(strings);\\n-\\n-   if (index != NULL)\\n-      free(index);\\n-\\n-   return EXIT_SUCCESS;\\n-}\\n+#include <stdio.h>\\n+#include <stdlib.h>\\n+#include <string.h>\\n+\\n+char *bucket_sort(char *strings, int length, long int size,\\n+                  int offset, int nbuckets) {\\n+    char *buffer;\\n+    char *source = strings;\\n+    char *destination;\\n+    size_t counts[256];\\n+    size_t positions[256];\\n+    size_t record_width = (size_t)length;\\n+\\n+    (void)offset;\\n+    (void)nbuckets;\\n+\\n+    if (size <= 1 || length <= 1)\\n+        return strings;\\n+\\n+    if ((size_t)size > ((size_t)-1) / record_width) {\\n+        fprintf(stderr, \\\"Sort buffer size is too large\\\\n\\\");\\n+        exit(EXIT_FAILURE);\\n+    }\\n+\\n+    buffer = (char *)malloc((size_t)size * record_width);\\n+    if (buffer == NULL) {\\n+        fprintf(stderr, \\\"Unable to allocate sort buffer\\\\n\\\");\\n+        exit(EXIT_FAILURE);\\n+    }\\n+    destination = buffer;\\n+\\n+    for (int position = length - 2; position >= 0; position--) {\\n+        size_t next = 0;\\n+\\n+        memset(counts, 0, sizeof(counts));\\n+        for (long int i = 0; i < size; i++) {\\n+            size_t source_offset = (size_t)i * record_width;\\n+            unsigned char key = (unsigned char)source[source_offset + (size_t)position];\\n+            counts[key]++;\\n+        }\\n+\\n+        for (int key = 0; key < 256; key++) {\\n+            positions[key] = next;\\n+            next += counts[key];\\n+        }\\n+\\n+        for (long int i = 0; i < size; i++) {\\n+            size_t source_offset = (size_t)i * record_width;\\n+            unsigned char key = (unsigned char)source[source_offset + (size_t)position];\\n+            size_t destination_offset = positions[key]++ * record_width;\\n+            memcpy(destination + destination_offset, source + source_offset, record_width);\\n+        }\\n+\\n+        char *temporary = source;\\n+        source = destination;\\n+        destination = temporary;\\n+    }\\n+\\n+    if (source == strings)\\n+        free(buffer);\\n+\\n+    return source;\\n+}\\n+\\n+void load(char **vString, long int *N, int *l, int *os, int *nb) {\\n+    char *strings = NULL;\\n+    int len;\\n+    int offset;\\n+    int nbucket;\\n+    long int n;\\n+\\n+    if (fscanf(stdin, \\\"%d\\\", &len) != 1) {\\n+        printf(\\\"ERROR len\\\\n\\\");\\n+        exit(1);\\n+    }\\n+    if (fscanf(stdin, \\\"%ld\\\", &n) != 1) {\\n+        printf(\\\"ERROR n\\\\n\\\");\\n+        exit(1);\\n+    }\\n+    if (fscanf(stdin, \\\"%d\\\", &offset) != 1) {\\n+        printf(\\\"ERROR offset\\\\n\\\");\\n+        exit(1);\\n+    }\\n+    if (fscanf(stdin, \\\"%d\\\", &nbucket) != 1) {\\n+        printf(\\\"ERROR nbucket\\\\n\\\");\\n+        exit(1);\\n+    }\\n+\\n+    nbucket = nbucket + 1;\\n+    len = len + 1;\\n+    strings = (char *)calloc((size_t)n, (size_t)len);\\n+    if (strings == NULL && n > 0) {\\n+        fprintf(stderr, \\\"Unable to allocate input strings\\\\n\\\");\\n+        exit(EXIT_FAILURE);\\n+    }\\n+\\n+    for (long int i = 0; i < n; i++) {\\n+        if (fscanf(stdin, \\\"%s\\\", strings + (size_t)i * (size_t)len) != 1) {\\n+            printf(\\\"ERROR %ld\\\\n\"}, {\"id\": \"4cc657bc1f2b4fa1\", \"role\": \"A\", \"commit\": \"620ceb3ea8d3b94f6053c0afbef2fe9e773e52ed\", \"transformations\": {\"files\": [\"src/bucketsort.c\"], \"retained\": [\"Replace per-bucket insertion sorting 
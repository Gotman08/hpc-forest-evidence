\\n-\\n-   return EXIT_SUCCESS;\\n-}\\n+#include <stdio.h>\\n+#include <stdlib.h>\\n+#include <string.h>\\n+\\n+#define PARALLEL_SORT_MIN_ITEMS 4096\\n+\\n+typedef struct {\\n+    long int *data;\\n+    long int total;\\n+    long int next;\\n+} bucket;\\n+\\n+typedef struct {\\n+    int index;\\n+    long int count;\\n+} bucket_job;\\n+\\n+static const char *compare_strings;\\n+static int compare_length;\\n+\\n+static int compare_indices(const void *left, const void *right) {\\n+    long int a = *(const long int *)left;\\n+    long int b = *(const long int *)right;\\n+    return strcmp(compare_strings + (size_t)a * (size_t)compare_length,\\n+                  compare_strings + (size_t)b * (size_t)compare_length);\\n+}\\n+\\n+static int compare_jobs(const void *left, const void *right) {\\n+    const bucket_job *a = (const bucket_job *)left;\\n+    const bucket_job *b = (const bucket_job *)right;\\n+    if (a->count > b->count)\\n+        return -1;\\n+    if (a->count < b->count)\\n+        return 1;\\n+    if (a->index < b->index)\\n+        return -1;\\n+    if (a->index > b->index)\\n+        return 1;\\n+    return 0;\\n+}\\n+\\n+static void sort_bucket(bucket *b) {\\n+    if (b->total > 1)\\n+        qsort(b->data, (size_t)b->total, sizeof(*b->data), compare_indices);\\n+}\\n+\\n+long int *bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\\n+    long int *returns;\\n+    bucket *buckets;\\n+    bucket_job *jobs;\\n+    long int job_count = 0;\\n+    long int i;\\n+    long int start = 0;\\n+\\n+    if (size <= 0)\\n+        return NULL;\\n+    if (nbuckets <= 0)\\n+        return NULL;\\n+\\n+    returns = calloc((size_t)size, sizeof(*returns));\\n+    buckets = calloc((size_t)nbuckets, sizeof(*buckets));\\n+    jobs = malloc((size_t)nbuckets * sizeof(*jobs));\\n+    if (returns == NULL || buckets == NULL || jobs == NULL) {\\n+        free(returns);\\n+        free(buckets);\\n+        free(jobs);\\n+        fprintf(stderr, \\\"ERROR allocation\\\\n\\\");\\n+        exit(EXIT_FAILURE);\\n+    }\\n+\\n+    for (i = 0; i < size; i++) {\\n+        int bucket_index = (int)(unsigned char)a[(size_t)i * (size_t)length] - offset;\\n+        buckets[bucket_index].total++;\\n+    }\\n+\\n+    for (int b = 0; b < nbuckets; b++) {\\n+        buckets[b].data = returns + (size_t)start;\\n+        buckets[b].next = 0;\\n+        start += buckets[b].total;\\n+    }\\n+\\n+    for (i = 0; i < size; i++) {\\n+        int bucket_index = (int)(unsigned char)a[(size_t)i * (size_t)length] - offset;\\n+        bucket *b = &buckets[bucket_index];\\n+        b->data[b->next++] = i;\\n+    }\\n+\\n+    for (int b = 0; b < nbuckets; b++) {\\n+        if (buckets[b].total > 1) {\\n+            jobs[job_count].index = b;\\n+            jobs[job_count].count = buckets[b].total;\\n+            job_count++;\\n+        }\\n+    }\\n+\\n+    compare_strings = a;\\n+    compare_length = length;\\n+\\n+#ifdef _OPENMP\\n+    if (size >= PARALLEL_SORT_MIN_ITEMS && job_count >= 2) {\\n+        qsort(jobs, (size_t)job_count, sizeof(*jobs), compare_jobs)\"}, {\"id\": \"b1aa613c02de4815\", \"role\": \"B\", \"commit\": \"a28c3c1ffada5b22a40b3b714b42142165e79786\", \"transformations\": {\"files\": [\"src/bucketsort.c\"], \"retained\": [\"Use direct strcmp-based insertion sorting for buckets with 2–8 indices; continue using qsort for buckets larger than eight.\"]}, \"mean_seconds\": 0.01238978747278452, \"diff\": \"diff --git a/src/bucketsort.c b/src/bucketsort.c\\nindex 9987e6c..8b475aa 100644\\n--- a/src/bucketsort.c\\n+++ b/src/bucketsort.c\\n@@ -1,142 +1,174 @@\\n-#include <stdio.h>\\n-#include <stdlib.h>\\n-#include <assert.h>\\n-#include <string.h>\\n-\\n-typedef struct {\\n-\\tlong int *data;\\n-\\tint length;\\n-\\tlong int total;\\n-} bucket;\\n-\\n-void sort(char *a, bucket *bucket) {\\n-\\tint j, i, length;\\n-\\tlong int key;\\n-\\tlength = bucket->length;\\n-\\n-\\tfor (j = 1; j < bucket->total; j++) {\\n-\\t\\tkey = bucket->d
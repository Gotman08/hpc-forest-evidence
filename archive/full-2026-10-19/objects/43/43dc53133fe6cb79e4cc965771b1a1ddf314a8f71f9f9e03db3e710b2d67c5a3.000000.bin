ket = nbucket + 1;\\n-   len = len + 1;\\n-\\n-   strings = (char*) malloc(n * len);\\n-\\n-   for (int i = 0; i < n; i++){\\n-      if (!fscanf(stdin, \\\"%s\\\", strings + (i * len))) {\\n-      printf (\\\"ERROR %d\\\\n\\\",i);\\n-      exit (1);\\n-      }\\n-   }\\n-\\n-   *vString = strings;\\n-   *N = n;\\n-   *l = len;\\n-   *os = offset;\\n-   *nb = nbucket;\\n-}\\n-\\n-void print(char *strings, long int *index, long int n, int len){\\n-\\n-   for (int i = 0; i < n; i++){\\n-      printf(\\\"%d -> %s\\\\n\\\", i, strings + (index[i] * len));\\n-   }\\n-}\\n-\\n-void save(char *strings, long int *index, long int n, int len){\\n-   for (int i = 0; i < n; i++){\\n-      printf(\\\"%s\\\\n\\\", strings + (index[i] * len));\\n-   }\\n-}\\n-\\n-int main(int ac, char **av) {\\n-\\n-   char     *strings = NULL;\\n-   long int N        = 0;\\n-   long int *index   = NULL;\\n-   int      len      = 0,\\n-            save2File = 0,\\n-            offset,\\n-            nbuckets;\\n-\\n-   load(&strings, &N, &len, &offset, &nbuckets);\\n-\\n-   index = bucket_sort(strings, len, N, offset, nbuckets);\\n-\\n-   save(strings, index, N, len);\\n-\\n-   if (strings != NULL)\\n-      free(strings);\\n-\\n-   if (index != NULL)\\n-      free(index);\\n-\\n-   return EXIT_SUCCESS;\\n-}\\n+#include <stdio.h>\\n+#include <stdlib.h>\\n+#include <string.h>\\n+\\n+static int compare_strings(const void *left, const void *right) {\\n+    const char *lhs = *(char * const *)left;\\n+    const char *rhs = *(char * const *)right;\\n+    return strcmp(lhs, rhs);\\n+}\\n+\\n+char **bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\\n+    char **sorted;\\n+    long int *offsets;\\n+    long int *next;\\n+    long int i;\\n+\\n+    if (size <= 0 || nbuckets <= 0) {\\n+        return NULL;\\n+    }\\n+\\n+    sorted = (char **)malloc(sizeof(*sorted) * (size_t)size);\\n+    offsets = (long int *)calloc((size_t)nbuckets + 1, sizeof(*offsets));\\n+    next = (long int *)malloc(sizeof(*next) * (size_t)nbuckets);\\n+    if (sorted == NULL || offsets == NULL || next == NULL) {\\n+        free(sorted);\\n+        free(offsets);\\n+        free(next);\\n+        return NULL;\\n+    }\\n+\\n+    /* Count each bucket, then compute exact, non-overlapping bucket ranges. */\\n+    for (i = 0; i < size; i++) {\\n+        int b = (int)((unsigned char)a[(size_t)i * (size_t)length]) - offset;\\n+        offsets[b + 1]++;\\n+    }\\n+    for (int b = 0; b < nbuckets; b++) {\\n+        offsets[b + 1] += offsets[b];\\n+    }\\n+    memcpy(next, offsets, sizeof(*next) * (size_t)nbuckets);\\n+\\n+    /* Scatter string pointers into their bucket ranges. */\\n+    for (i = 0; i < size; i++) {\\n+        int b = (int)((unsigned char)a[(size_t)i * (size_t)length]) - offset;\\n+        next[b]++;\\n+        sorted[next[b] - 1] = a + (size_t)i * (size_t)length;\\n+    }\\n+\\n+#if defined(_OPENMP)\\n+    #pragma omp parallel for schedule(dynamic, 1) if (size >= 4096 && nbuckets > 1)\\n+#endif\\n+    for (int b = 0; b < nbuckets; b++) {\\n+        long int count = offsets[b + 1] - offsets[b];\\n+        if (count > 1) {\\n+            qsort(sorted + offsets[b], (size_t)count, sizeof(*sorted), compare_strings);\\n+        }\\n+    }\\n+\\n+    free(offsets);\\n+    free(next);\\n+    return sorted;\\n+}\\n+\\n+void load(char **vString, long int *N, int *l, int *os, int *nb) {\\n+    char *strings = NULL;\\n+    int len, offset, nbucket;\\n+    long int n;\\n+\\n+    if (!fscanf(stdin, \\\"%d\\\", &len)) {\\n+        printf(\\\"ERROR len\\\\n\\\");\\n+        exit(1);\\n+    }\\n+    if (!fscanf(stdin, \\\"%ld\\\", &n)) {\\n+        printf(\\\"ERROR n\\\\n\\\");\\n+        exit(1);\\n+    }\\n+    if (!fscanf(stdin, \\\"%d\\\", &offset)) {\\n+        printf(\\\"ERROR offset\\\\n\\\");\\n+        exit(1);\\n+    }\\n+    if (!fscanf(stdin, \\\"%d\\\", &nbucket)) {\\n+        printf(\\\"ERROR nbucket\\\\n\\\");\\n+        exit(1);\\n+    }\\n+\\n+    nbucket = nbucket + 1;\\n+    len = len + 1;\\n+    strings = (char *)malloc((size_t)n * (size_t)len);\\n+\\n+    for (long int i = 0; i < n; i++) {\\n+        if (!fscanf(stdin, \\\"%s\\\", strings + (size_t)i * (size_t)len)) {\\n+            printf(\\\"ERROR %ld\\\\n\\\", i);\\n+            exit(1);\\n+        }\\n+    }\\n+\\n+    *vString = strings;\\n+    *N = n;\\n+    *l = len;\\n+    *os = offset;\\n+    *nb = nbucket;\\n+}\"}, {\"id\": \"a041490e77d94e91\", \"role\": \"A\", \"commit\": \"e0b5547820465ca3c00d660d3c6b5da76348ab34\", \"transformations\": {\"files\": [\"src/bucketsort.c\"], \"retained\": [\"Replace fixed-size index slices with a count, prefix-offset, and scatter pipeline that assigns every record a disjoint bucket range.\", \"Store gathered records contiguously and qsort each bucket by strcmp instead of insertion-sorting indices.\", \"Parallelize independent bucket sorts with an OpenMP loop when OpenMP is enabled.\"]}, \"mean_seconds\": 0.011688030635317167, \"diff\": \"diff --git a/src/bucketsort.c b/src/bucketsort.c\\nindex 9987e6c..1be958b 100644\\n--- a/src/bucketsort.c\\n+++ b/src/bucketsort.c\\n@@ -1,142 +1,132 @@\\n-#include <stdio.h>\\n-#include <stdlib.h>\\n-#include <assert.h>\\n-#include <string.h>\\n-\\n-typedef struct {\\n-\\tlong int *data;\\n-\\tint length;\\n-\\tlong int total;\\n-} bucket;\\n-\\n-void sort(char *a, bucket *bucket) {\\n-\\tint j, i, length;\\n-\\tlong int key;\\n-\\tlength = bucket->length;\\n-\\n-\\tfor (j = 1; j < bucket->total; j++) {\\n-\\t\\tkey = bucket->data[j];\\n-\\t\\ti = j - 1;\\n-\\t\\twhile (i >= 0 && strcmp(a + bucket->data[i] * length, a + key * length) > 0) {\\n-\\t\\t\\tbucket->data[i + 1] = bucket->data[i];\\n-\\t\\t\\ti--;\\n-\\t\\t}\\n-\\t\\tbucket->data[i + 1] = key;\\n-\\t}\\n-}\\n-\\n-\\n-long int* bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\\n-\\n-\\tlong int i;\\n-\\tbucket   *buckets = NULL,\\n-             *b = NULL;\\n-\\tlong int *returns = NULL;\\n-\\n-\\t// a
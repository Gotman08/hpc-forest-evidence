t i = 0; i < n; i++){\\n-      printf(\\\"%s\\\\n\\\", strings + (index[i] * len));\\n-   }\\n-}\\n-\\n-int main(int ac, char **av) {\\n-\\n-   char     *strings = NULL;\\n-   long int N        = 0;\\n-   long int *index   = NULL;\\n-   int      len      = 0,\\n-            save2File = 0,\\n-            offset,\\n-            nbuckets;\\n-\\n-   load(&strings, &N, &len, &offset, &nbuckets);\\n-\\n-   index = bucket_sort(strings, len, N, offset, nbuckets);\\n-\\n-   save(strings, index, N, len);\\n-\\n-   if (strings != NULL)\\n-      free(strings);\\n-\\n-   if (index != NULL)\\n-      free(index);\\n-\\n-   return EXIT_SUCCESS;\\n-}\\n+#include <stdio.h>\\n+#include <stdlib.h>\\n+#include <string.h>\\n+\\n+static int compare_records(const void *left, const void *right) {\\n+    return strcmp((const char *)left, (const char *)right);\\n+}\\n+\\n+static char *bucket_sort(char *strings, int length, long int size,\\n+                         int offset, int nbuckets) {\\n+    size_t width = (size_t)length;\\n+    size_t n_items = (size_t)size;\\n+    size_t bytes = n_items * width;\\n+    size_t *starts = (size_t *)calloc((size_t)nbuckets, sizeof(*starts));\\n+    size_t *next = (size_t *)malloc((size_t)nbuckets * sizeof(*next));\\n+    char *sorted = (char *)malloc(bytes == 0 ? 1 : bytes);\\n+    long int i;\\n+    int b;\\n+\\n+    if (starts == NULL || next == NULL || sorted == NULL) {\\n+        free(starts);\\n+        free(next);\\n+        free(sorted);\\n+        fprintf(stderr, \\\"ERROR allocation\\\");\\n+        exit(EXIT_FAILURE);\\n+    }\\n+\\n+    /* Count entries first so each bucket gets an exact, disjoint range. */\\n+    for (i = 0; i < size; ++i) {\\n+        b = (int)strings[(size_t)i * width] - offset;\\n+        ++starts[b];\\n+    }\\n+\\n+    /* Turn counts into bucket starts and independent scatter cursors. */\\n+    {\\n+        size_t prefix = 0;\\n+        for (b = 0; b < nbuckets; ++b) {\\n+            size_t count = starts[b];\\n+            starts[b] = prefix;\\n+            next[b] = prefix;\\n+            prefix += count;\\n+        }\\n+    }\\n+\\n+    /* Gather complete records into contiguous bucket ranges. */\\n+    for (i = 0; i < size; ++i) {\\n+        size_t source = (size_t)i * width;\\n+        b = (int)strings[source] - offset;\\n+        memcpy(sorted + next[b] * width, strings + source, width);\\n+        ++next[b];\\n+    }\\n+\\n+    /* Each qsort operates on a separate contiguous range. */\\n+#ifdef _OPENMP\\n+#pragma omp parallel for schedule(dynamic, 1)\\n+#endif\\n+    for (b = 0; b < nbuckets; ++b) {\\n+        size_t count = next[b] - starts[b];\\n+        if (count > 1) {\\n+            qsort(sorted + starts[b] * width, count, width, compare_records);\\n+        }\\n+    }\\n+\\n+    free(starts);\\n+    free(next);\\n+    return sorted;\\n+}\\n+\\n+static void load(char **vString, long int *N, int *l, int *os, int *nb) {\\n+    char *strings = NULL;\\n+    int len;\\n+    int offset;\\n+    int nbucket;\\n+    long int n;\\n+\\n+    if (!fscanf(stdin, \\\"%d\\\", &len)) {\\n+        printf(\\\"ERROR len\\\\n\\\");\\n+        exit(1);\\n+    }\\n+    if (!fscanf(stdin, \\\"%ld\\\", &n)) {\\n+        printf(\\\"ERROR n\\\\n\\\");\\n+        exit(1);\\n+    }\\n+    if (!fscanf(stdin, \\\"%d\\\", &offset)) {\\n+        printf(\\\"ERROR offset\\\\n\\\");\\n+        exit(1);\\n+    }\\n+    if (!fscanf(stdin, \\\"%d\\\", &nbucket)) {\\n+        printf(\\\"ERROR nbucket\\\\n\\\");\\n+        exit(1);\\n+    }\\n+\\n+    nbucket = nbucket + 1;\\n+    len = len + 1;\\n+    strings = (char *)malloc((size_t)n * (size_t)len);\\n+\\n+    for (long int i = 0; i < n; ++i) {\\n+        if (!fscanf(stdin, \\\"%s\\\", strings + (size_t)i * (size_t)len)) {\\n\"}, {\"id\": \"3508177f7eef4978\", \"role\": \"C\", \"commit\": \"4a7117da73c225005332ccec2c48339cf266546a\", \"transformations\": {\"files\": [\"src/bucketsort.c\"], \"retained\": [\"Count bucket sizes and use prefix offsets to allocate exact, disjoint index ranges before scattering indices.\", \"Skip empty and singleton buckets; order remaining sorting jobs by descending bucket size and process them with OpenMP schedule(dynamic, 1) above a general input-size threshold, otherwise sort serially.\", \"Use qsort with strcmp-based index comparison within each bucket.\"]}, \"mean_seconds\": 0.01231225673109293, \"diff\": \"diff --git a/src/bucketsort.c b/src/bucketsort.c\\nindex 9987e6c..16de7c7 100644\\n--- a/src/bucketsort.c\\n+++ b/src/bucketsort.c\\n@@ -1,142 +1,185 @@\\n-#include <stdio.h>\\n-#include <stdlib.h>\\n-#include <assert.h>\\n-#include <string.h>\\n-\\n-typedef struct {\\n-\\tlong int *data;\\n-\\tint length;\\n-\\tlong int total;\\n-} bucket;\\n-\\n-void sort(char *a, bucket *bucket) {\\n-\\tint j, i, length;\\n-\\tlong int key;\\n-\\tlength = bucket->length;\\n-\\n-\\tfor (j = 1; j < bucket->total; j++) {\\n-\\t\\tkey = bucket->data[j];\\n-\\t\\ti = j - 1;\\n-\\t\\twhile (i >= 0 && strcmp(a + bucket->data[i] * length, a + key * length) > 0) {\\n-\\t\\t\\tbucket->data[i + 1] = bucket->data[i];\\n-\\t\\t\\ti--;\\n-\\t\\t}\\n-\\t\\tbucket->data[i + 1] = key;\\n-\\t}\\n-}\\n-\\n-\\n-long int* bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\\n-\\n-\\tlong int i;\\n-\\tbucket   *buckets = NULL,\\n-             *b = NULL;\\n-\\tlong int *returns = NULL;\\n-\\n-\\t// allocate memory\\n-\\treturns = (long int *) malloc(sizeof(long int) * size);\\n-\\tbuckets = (bucket   *) malloc(sizeof(bucket) * nbuckets);\\n-\\n-\\n-\\tfor (i = 0; i < nbuckets; i++) {\\n-\\t\\tbuckets[i].data = returns + i * size / nbuckets;\\n-\\t\\tbuckets[i].length = length;\\n-\\t\\tbuckets[i].total = 0;\\n-\\t}\\n-\\n-\\t// copy the keys to \\\"buckets\\\"\\n-\\tfor (i = 0; i < size; i++) {\\n-\\t\\tb = &buckets[*(a + i * length) - offset]; //mascara de deslocamento\\n-\\t\\tb->data[b->total++] = i;\\n-\\t}\\n-\\n-\\t// sort each \\\"bucket\\\"\\n-\\tfor (i = 0; i < nbuckets; i++)\\n-\\t\\
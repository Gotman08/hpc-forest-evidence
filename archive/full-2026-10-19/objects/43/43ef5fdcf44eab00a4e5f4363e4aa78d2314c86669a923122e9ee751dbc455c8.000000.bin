"""Seal local target packet data; never run the allocated target helper."""
import ast
import hashlib
import io
import json
import shlex
import tarfile
from pathlib import Path

HERE = Path(__file__).resolve().parent

def ref(path):
    raw = path.read_bytes()
    return {'path': str(path), 'sha256': hashlib.sha256(raw).hexdigest(), 'bytes': len(raw)}

def save(name, value):
    with (HERE / name).open('x', encoding='utf8', newline='\n') as stream:
        stream.write(json.dumps(value, indent=2, ensure_ascii=False) + '\n')

for name in ('qualifier-cible-source110.py', 'preparer-paquet-cible.py', 'bootstrap-cible-alloue.py'):
    ast.parse((HERE / name).read_text())
packet = HERE / 'qualification-cible-source110-packet.tar.gz'
with tarfile.open(fileobj=io.BytesIO(packet.read_bytes()), mode='r:gz') as archive:
    members = archive.getmembers()
    assert len(members) == 6 and all(item.isfile() and not item.issym() and not item.islnk() for item in members)
    values = {item.name: archive.extractfile(item).read() for item in members}
    manifest = json.loads(values['packet-manifest.json'])
    assert manifest == {name: hashlib.sha256(raw).hexdigest() for name, raw in values.items() if name != 'packet-manifest.json'}
job = json.loads((HERE / 'job-prepare-PROPOSITION-NON-SOUMISE.json').read_text())
assert shlex.split(job['command']) == ['bash', '-lc', (HERE / 'commande-cible-allouee.sh').read_text()]
assert job['cpus_per_task'] == 4 and job['mem_gb'] == 16 and job['gpus_per_node'] == 0 and job['time_limit'] == '00:10:00'
files = {path.name: ref(path) for path in HERE.iterdir() if path.is_file()}
save('MANIFESTE-PREPARATION-CIBLE.json', files)
save('LIVRAISON-CIBLE-PROPOSEE-POUR-REVUE.json', {
    'schema': 'hpc-forest-source110-target-profile-preparation-delivery-v1',
    'verified_preparation_only': True, 'current_target_profile_received': False,
    'helper': ref(HERE / 'qualifier-cible-source110.py'), 'packet': ref(packet),
    'packet_regular_member_count': 6, 'bootstrap': ref(HERE / 'bootstrap-cible-alloue.py'),
    'proposed_job': ref(HERE / 'job-prepare-PROPOSITION-NON-SOUMISE.json'),
    'proposed_command': ref(HERE / 'commande-cible-allouee.sh'),
    'manifest': ref(HERE / 'MANIFESTE-PREPARATION-CIBLE.json'),
    'new_neutral_guard_cases_unique': 22, 'initial_guard_result': '21 passed; one AST test assertion incorrectly traversed assignment RHS',
    'corrected_single_case_result': 'one passed; other21 not replayed',
    'first_failures_retained': True, 'Ruff_final': ref(HERE / 'RUFF-FINAL.json'),
    'source110_or_adapter62_changed': False, 'official_target_function_calls_by_author': 0,
    'compiler_or_job_or_model_or_CLI_or_transport_effect_by_author': False,
    'native_generation_admitted': False,
    'limits': ['Runtime result pending new allocated job and reception/audit',
        'The official helper captures compiler stdout/stderr internally and does not return compiler stderr on exception; preserve scheduler stderr and exception without inventing it',
        'Exact113 SHARED composition must hold before import; no Q-reception extra files may be injected before this allocation',
        'Full mechanical Q archive recovery remains a separate receipt; no old Q or target proof is substituted']})
print(json.dumps({name: ref(HERE / name) for name in ('qualifier-cible-source110.py', 'qualification-cible-source110-packet.tar.gz', 'MANIFESTE-PREPARATION-CIBLE.json', 'LIVRAISON-CIBLE-PROPOSEE-POUR-REVUE.json')}))

        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Contiguous row-major buffers and pointer swapping should improve locality and reduce memory traffic by eliminating the interior copy after every Jacobi iteration.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/laplace_seq.c"
          ],
          "retained": [
            "Replace separately allocated rows with two contiguous double buffers.",
            "Hoist source and destination row addresses outside the inner stencil loop.",
            "Initialize both buffers identically and commit each update by swapping pointers instead of copying interiors.",
            "Print the latest committed buffer and release both allocations afterward."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.05958613225569328,

        "parent_id": null,
        "delegation_parent": "R/B",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "An integer-min reduction exposes SIMD in the neighbor search without changing scalar floating-point distance evaluation. A safe cutoff and occupied-prefix shifts should reduce the remaining serial work.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/knn.c"
          ],
          "retained": [
            "Replace the early-exit search with a vectorizable minimum-index reduction over occupied distances, with an OpenMP SIMD annotation when OpenMP is enabled.",
            "Reject non-improving points when the neighbor list is full and contains no NaNs; permanently disable this shortcut after storing a NaN.",
            "Shift only occupied entries backward, preserving untouched sentinel padding.",
            "Free per-call neighbor buffers after voting."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.9021505331620574,
        "commit": "b4d42aee3eab042427353ae837b4480fb1079450"
      },

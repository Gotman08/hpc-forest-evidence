        "parent_id": null,
        "delegation_parent": "R/C",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Balanced OpenMP scans with private top-k lists and a deterministic merge should accelerate insertion-dominated workloads on four cores while preserving exact classification.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/knn.c"
          ],
          "retained": [
            "Partition the encounter-order point stream into balanced contiguous ranges, independent of group sizes.",
            "Apply the reference stable insertion algorithm to thread-private lists, then merge by distance with earlier-range tie priority.",
            "Preserve k>N sentinel padding and fall back to the reference scan for NaN distances or parallel scratch-allocation failure.",
            "Gate parallelism by estimated work per thread, avoid nested teams and release per-call scratch storage."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.17907901015132666,
        "commit": "a107252d8ec3480bfad7f15cae33fae574627f89"
      },
      {

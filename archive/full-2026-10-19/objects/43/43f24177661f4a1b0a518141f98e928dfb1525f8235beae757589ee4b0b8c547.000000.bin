        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Fusing vertical column updates into the horizontal NEON scan should reduce column-buffer traffic and loop overhead while preserving the required prefix-scan dependencies.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/solution.cpp"
          ],
          "retained": [
            "Fuse first-window reduction with column updates, then consume newly updated columns directly in the four-window SIMD scan.",

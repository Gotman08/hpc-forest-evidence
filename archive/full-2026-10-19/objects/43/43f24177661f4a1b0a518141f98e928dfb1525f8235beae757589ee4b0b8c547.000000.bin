        "role": "A",
        "parent_id": null,
        "delegation_parent": "R/A",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Recycling old north rows as output storage should reduce cache pressure and memory traffic: Jacobi needs only one contiguous grid plus one spare row, with writes following closely behind reads and no full-grid copy.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/laplace_seq.c"
          ],
          "retained": [
            "Replace two separately allocated matrices with contiguous storage for one grid and one spare row.",
            "Compute the first interior row into the spare; compute subsequent rows in their old north-row buffers and rotate logical row pointers.",
            "Use disjoint restricted row pointers while retaining the original per-cell arithmetic and convergence checks.",
            "Preserve each logical row's boundary values and leave the top and bottom boundary rows fixed."
          ]
        },

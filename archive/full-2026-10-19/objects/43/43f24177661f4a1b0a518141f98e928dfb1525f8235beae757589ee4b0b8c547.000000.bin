        "parent_id": null,
        "delegation_parent": "R/C",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "A persistent OpenMP team with static row scheduling, integer convergence reduction, and synchronized buffer swapping should reduce Jacobi runtime on four ARM64 cores while avoiding threading overhead for small grids.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/laplace_seq.c"
          ],
          "retained": [
            "Use one persistent OpenMP region with static row work sharing and bitwise-OR convergence reduction.",
            "Limit the team to at least 8192 interior cells per worker, respecting the runtime thread maximum; use a serial path below two workers.",
            "Replace interior copy-back with buffer swaps, initializing both buffers identically to preserve boundaries, including degenerate grids."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.0456526226674517,
        "commit": "48020fae7d5253f20cb75be47c7ba8a3ae76bcb7"
      },

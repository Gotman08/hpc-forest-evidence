        "role": "A",
        "parent_id": null,
        "delegation_parent": "R/A",
        "integration_sources": [],
        "hypothesis_as_declared_by_model": "A compact contiguous max-heap should reduce neighborhood memory traffic by replacing linear scans and array shifts with root checks and logarithmic updates, while reusing its storage for voting labels.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/knn.c"
          ],
          "retained": [
            "Replace sorted insertion with a distance/group max-heap, filled sequentially and heapified once.",
            "Evict later groups first at equal distances; within-group ties have identical labels, preserving classification.",
            "Bound heap capacity by min(N,k), compact labels into the same allocation, and retain sentinel padding when k>N.",
            "Replay reference selection for NaN distances, retain existing qsort voting, and release per-call workspace."
          ]
        },
        "status": "valid",

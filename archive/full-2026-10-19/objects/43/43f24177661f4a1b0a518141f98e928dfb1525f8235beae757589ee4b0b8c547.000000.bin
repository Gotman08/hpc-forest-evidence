        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Static OpenMP row bands with rolling sums should reduce computation to O(N^2) and exploit the four configured cores. Column-partitioned prefix initialization avoids repeatedly scanning overlapping seed windows for large S.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/solution.cpp"
          ],
          "retained": [
            "Replace mixed input APIs with a buffered signed-integer reader and flat row-major storage.",
            "Compute each contiguous output-row band using 64-bit rolling column sums and horizontal sliding windows.",
            "Use workload-aware OpenMP team sizing, static band ownership, and a maximum reduction.",
            "Choose direct band initialization or a shared column-prefix pass by estimated work, with one synchronization before consuming shared seeds."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.010676879125336805,
        "commit": "7529b9cb16544e614f646336717fd92fed266577"
      },
      {

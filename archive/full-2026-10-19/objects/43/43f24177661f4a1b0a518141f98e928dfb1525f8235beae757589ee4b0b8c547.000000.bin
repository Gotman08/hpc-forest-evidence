        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Caching the full neighborhood's cutoff lets non-improving points bypass all neighborhood-array accesses, replacing an O(k) scan per rejection with a scalar comparison while streaming through the input points.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/knn.c"
          ],
          "retained": [
            "Cache the last neighborhood distance after each insertion and reject d >= cutoff only when that slot is not the unfilled sentinel.",

        "integration_sources": [],
        "hypothesis_as_declared_by_model": "Explicit two-lane ARM64 NEON stencil evaluation with a bitwise convergence-mask reduction may improve throughput without reassociating floating-point additions.",
        "transformations_as_declared_by_model": {
          "files": [
            "src/laplace_seq.c"
          ],
          "retained": [
            "Use restrict-qualified row pointers and an AArch64 NEON kernel preserving east-plus-west-plus-north-plus-south evaluation order.",
            "Accumulate strict convergence comparisons using vector bitwise OR and reduce once per iteration.",
            "Provide a scalar remainder for arbitrary sizes and a scalar fallback for other architectures."
          ]
        },
        "status": "valid",
        "mean_seconds": 0.0668229575579365,
        "commit": "effc1918abe4cc8d96d8e593abb9c3af8655c307"
      },

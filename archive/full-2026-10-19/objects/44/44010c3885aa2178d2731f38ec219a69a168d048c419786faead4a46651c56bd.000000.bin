CONTEXT_CHECK = '''
def check_received_predecessors(read, rows=None, current=None):
    # Historical zero-call closure and attributed graphs, never future absence.
    closure = read({'path': str(R7_CLOSURE), 'sha256': R7_CLOSURE_SHA})
    exited = read({'path': str(R7_EXIT), 'sha256': R7_EXIT_SHA})
    context = read({'path': str(R7_CONTEXT), 'sha256': R7_CONTEXT_SHA})
    r5 = read({'path': str(R5_CONTEXT), 'sha256': R5_CONTEXT_SHA})
    need(closure.get('schema') == 'hpc-forest-root-r7-three-technical-roots-zero-call-audited-closure-v1'
         and closure.get('verified_metadata_only') is True
         and closure.get('job_ids') == ['754549', '754550', '754552']
         and all(type(closure.get(k)) is int and closure[k] == 0 for k in
                 ('published_requests','native_model_calls','invocations','responses','deliveries','unmeasured_invocations','unknown_invocations'))
         and closure.get('unresolved_invocations') == []
         and closure.get('reconciliation', {}).get('sha256') == '31baae0e99661b068f9584aff46118766c432182a05c1dade72b67e44bdb9aaa'
         and closure.get('independent_cold_review', {}).get('sha256') == '07ca364444837c057bc950b2b1ffba2c572856f9512ed8783d89127a59c61f8a'
         and closure.get('passive_observer_historical_reconciliation') == {'path': str(R7_EXIT), 'sha256': R7_EXIT_SHA},
         'Exact historical R7 zero-call roots closure required; consumed requests never reused')
    need(exited.get('schema') == 'hpc-forest-r7-passive-observer-historical-natural-exit-metadata-reconciliation-v1'
         and exited.get('verified_historical_metadata_only') is True
         and exited.get('blocking_findings_for_observed_eight_identity_absence') == []
         and exited.get('all_eight_observed_identities_absent_in_final_census') is True
         and exited.get('observed_context') == {'path': str(R7_CONTEXT), 'sha256': R7_CONTEXT_SHA}
         and exited.get('observed_context_identity_count') == 8
         and context.get('schema') == 'hpc-forest-r7-observed-passive-context-eight-identities-v1'
         and context.get('root_pair') == exited.get('owned_pair'), 'Exact attributed historical R7 context required')
    seven = r5['contextual_identities']
    eight = [record['full_identity'] for record in context['context']]
    fields = ('ProcessId','ParentProcessId','ExecutablePath','CommandLine','CreationDate')
    def key(row):
        need(isinstance(row, dict) and set(row) == set(fields)
             and all(type(row[k]) is int and row[k] > 0 for k in fields[:2])
             and all(isinstance(row[k], str) and row[k] for k in fields[2:]), 'Complete historical five-field identity required')
        return tuple(row[k] for k in fields)
    need(len(seven) == 7 and len(eight) == 8 and len({key(r) for r in seven}) == 7
         and len({key(r) for r in eight}) == 8, 'Exact distinct seven plus eight attributed contexts required')
    if rows is not None:
        need(current is not None and current['observed_at'] > datetime.fromisoformat(closure['observed_at_utc']).timestamp()
             and datetime.fromisoformat(current['captured_at_utc']).timestamp()
                 > datetime.fromisoformat(exited['final_CIM_captured_at_utc']).timestamp(),
             'New full census must postdate both received R7 closures')
        old = seven + eight
        old_ids = {row['ProcessId'] for row in old}
        # A reused PID is ambiguous here and REFUSES; it is never adopted or targeted.
        need(not any(row['ProcessId'] in old_ids or row['ParentProcessId'] in old_ids for row in rows),
             'Known identity PID reused/present or orphan parent ambiguous; preserve it and refuse')
        old_scripts = [str(PREP / ('adaptateurs-source110-r1/' + revision + '/observer/observer-mixte.py')).replace('/', '\\\\').casefold()
                       for revision in ('revision-r5-G-recu-avant-Q','revision-r7-racines-techniques-neuves')]
        need(not any(any(script in (row.get('CommandLine') or '').replace('/', '\\\\').casefold() for script in old_scripts)
                     for row in rows), 'Equivalent old observer command present; no foreign process adopted')
    return {'historical_R7_zero_call_closure': {'path': str(R7_CLOSURE), 'sha256': R7_CLOSURE_SHA},
            'historical_R7_observer_exit': {'path': str(R7_EXIT), 'sha256': R7_EXIT_SHA},
            'historical_R7_eight_context': {'path': str(R7_CONTEXT), 'sha256': R7_CONTEXT_SHA},
            'historical_R5_seven_context': {'path': str(R5_CONTEXT), 'sha256': R5_CONTEXT_SHA},
            'current_context_absence_verified': rows is not None,
            'R7_consumed_requests_not_reusable': True, 'new_stop_or_native_admission': False}
'''


def add_capacity_predecessors(source):
    source = once(source, "IO_PATHS = set()", HISTORY_CONSTANTS + "\nIO_PATHS = set()\n" + CONTEXT_CHECK)
    source = once(source, "G_CLOSURE, SO_CLOSURE, out, *outputs])",
                  "G_CLOSURE, SO_CLOSURE, R7_CLOSURE, R7_EXIT, R7_CONTEXT, R5_CONTEXT, out, *outputs])")
    source = once(source, "    local = [ordinary_absence(path) for path in LOCAL_CACHES]",
                  "    predecessors = check_received_predecessors(lambda ref: decode(pinned(Path(ref['path']), ref['sha256'])), rows, full_value)\n"
                  "    local = [ordinary_absence(path) for path in LOCAL_CACHES]")
    source = once(source, "'historical_anchors_only': True,", "'R7_predecessors': predecessors, 'historical_anchors_only': True,")
    return source


def add_guard_predecessors(source):
    source = once(source, "def verify_paths(current_ref, closure_review_ref, *, now=None):",
                  "def verify_legacy_paths(current_ref, closure_review_ref, *, now=None):")
    extra = HISTORY_CONSTANTS + "\n" + CONTEXT_CHECK + '''
def verify_paths(current_ref, closure_review_ref, *, now=None):
    result = verify_legacy_paths(current_ref, closure_review_ref, now=now)
    io = held_io()
    pins = {}
    def read(reference):
        need(isinstance(reference, dict) and set(reference) == {'path','sha256'}
             and Path(reference['path']).is_relative_to(PREP), 'Closed local predecessor/current reference required')
        raw = io['raw'](reference['path'])
        need(hashlib.sha256(raw).hexdigest() == reference['sha256'], 'Predecessor/current bytes changed')
        pins[reference['path']] = reference['sha256']
        return io['decode'](raw)
    current = read(current_ref)
    namespace = {'math':math,'datetime':datetime,'FIELDS':FIELDS,'re':re}
    definitions(CAPACITY, CAPACITY_SHA, {'need','timestamp_z','complete_cim'}, namespace)
    rows = namespace['complete_cim'](current, time.time() if now is None else now)
    predecessors = check_received_predecessors(read, rows, current)
    for path, checksum in pins.items():
        need(hashlib.sha256(io['raw'](path)).hexdigest() == checksum, 'Current/predecessor evidence changed')
    namespace['complete_cim'](current, time.time())
    result.update(R7_predecessors=predecessors, all_eight_R7_original_identities_absent=True,
                  no_unknown_reused_or_ambiguous_R7_descendants=True)
    return result

'''
    return once(source, "def main():", extra + "def main():")


def future_qualification_policy(source):
    # No future Q SHA is guessed or copied. The unchanged exact R8 contract below
    # independently checks the actual caller-supplied composite and its raw refs.
    source = once(source, 'Q = OPS / "' + OLD_Q_PATH.replace("r7", "r8").replace("R7", "R8") + '"', "Q = None  # Future actual R8 composite is a mandatory explicit input")
    source = once(source, 'Q_SHA = "' + OLD_Q_SHA + '"', "Q_SHA = None  # Never promote Q754424")
    return once(source,
        'need(qref == {"path": str(Q), "sha256": Q_SHA} and review_ref == {"path": str(REVIEW), "sha256": REVIEW_SHA}, "Exact R8 actual Q and integration review only")',
        'need(review_ref == {"path": str(REVIEW), "sha256": REVIEW_SHA}, "Exact actual independent R8 integration review required")\n'
        '        received_q = read(qref)\n'
        '        need(received_q.get("schema") == "hpc-forest-dynamic-r4b-mechanical-reception-v1"\n'
        '             and received_q.get("verified") is True and received_q.get("source_zip_sha256") == source_sha\n'
        '             and received_q.get("plan_sha256") == plan_sha\n'
        '             and type(received_q.get("native_model_calls")) is int and received_q["native_model_calls"] == 0,\n'
        '             "True received Q for exact source110/plan R8 required; the full contract is checked next")')


def render_ps(source):
    # Start from the corrected R7 r2 boundary, not the refused initial PS.
    result = source
    for old, new in (("audit-compatibilite-factory-reelle-r1\\revue-r7-code-r1\\REVUE-INTEGRATION-R7-PREPARATION.json",
                      "preparation-derivee-R8-apres-raccord-r1\\revue-integration-complete-R8-r1\\REVUE-INTEGRATION-COMPLETE-R8-PREPARATION.json"),
                     ("dc64e1360ea8c7b061cbda5eb2dc638f7cb76d9f4264c2f062a495c62ba12f30", COMPONENTS),
                     ("026445269563f1cc282bff8619831358391adbd26823a15044b6d3a3f23cc3dd", REVIEW_SHA),
                     ("5e5d3023ac538ed7197c6cd5da3e68a87e2b95228797af5b7ecbf6250579de95", "70bb498896602652b9999cf25d53b5282454ed4368359d8a91e826bcca45307e")):
        result = result.replace(old, new)
    result = result.replace("R7", "R8").replace("r7", "r8")
    result = once(result, " [switch]$Execute", " [Parameter(Mandatory=$true)][string]$QualificationReception,\n"
                  " [Parameter(Mandatory=$true)][ValidatePattern('^[0-9a-f]{64}$')][string]$QualificationReceptionSha256,\n [switch]$Execute")
    old_q = "qualification-r8-execution-root-01\\revue-froide-independante-r1\\revision-r2-inventaires-figes\\RECEPTION-MECANIQUE-R8-Q754424-VERIFIEE-R2.json"
    result = once(result, "$q=Join-Path $parentBase '" + old_q + "'", "$q=$QualificationReception")
    result = result.replace("'" + OLD_Q_SHA + "'", "$QualificationReceptionSha256")
    result = result.replace("--qualification-reception-sha256 " + OLD_Q_SHA,
                            "--qualification-reception-sha256 $QualificationReceptionSha256")
    anchor = "function Check-Preparation{"
    q_guard = """function Check-ActualQ{
 Ordinary $q|Out-Null
 if((Sha $q) -ne $QualificationReceptionSha256){throw 'Actual caller Q bytes changed'}
 $received=$utf8.GetString([IO.File]::ReadAllBytes($q))|ConvertFrom-Json -Depth 40
 if($received.schema -cne 'hpc-forest-dynamic-r4b-mechanical-reception-v1' -or $received.verified -ne $true -or $received.source_zip_sha256 -cne 'SOURCE_LITERAL' -or $received.plan_sha256 -cne 'PLAN_LITERAL' -or $received.native_model_calls -isnot [long] -and $received.native_model_calls -isnot [int] -or $received.native_model_calls -ne 0){throw 'True received source110 R8 Q only; full contract is rechecked by policy before start'}
}
""".replace("SOURCE_LITERAL", SOURCE).replace("PLAN_LITERAL", PLAN)
    result = once(result, anchor, q_guard + anchor)
    result = once(result, "Check-Frozen\nCheck-Preparation\nif(-not $Execute)",
                  "Check-Frozen\nCheck-ActualQ\nCheck-Preparation\nif(-not $Execute)")
    result = once(result, "Check-Frozen\nCheck-Preparation\n& $py", "Check-Frozen\nCheck-ActualQ\nCheck-Preparation\n& $py")
    result = result.replace('ABSENCE-OBS4-R5-IMMEDIATE.json', 'ABSENCE-OBS4-R5-ET-R7-IMMEDIATE.json')
    need(OLD_Q_SHA not in result and "Q754424" not in result and "GetAttributes($part)" in result
         and "Start-Process" in result and result.count("Start-Process") == 1 and "-WindowStyle Hidden" in result,
         "Corrected PS boundary/unique explicit effect preserved without an inherited Q")
    return result


def render_all(store, spec):
    sources = {name: store.pinned(Path(item['path']), item['sha256']).decode('utf-8')
               for name, item in spec['ancestor_helpers'].items()}
    need(len(sources) == 12 and sum(name.endswith('.py') for name in sources) == 11, "Closed twelve helpers (11 Python +1 PS) required")
    rendered = {name.replace('R7','R8'): identity_derivative(text) for name, text in sources.items() if name.endswith('.py')}
    asm_name = 'assembler-entrees-roots-R8.py'
    asm_sha = digest(rendered[asm_name].encode())
    for name in ('preparer-triplet-metadata-R8.py','completer-absence-SO-lane-R8.py','preparer-partage-R8.py'):
        rendered[name] = rendered[name].replace('6022dd1133dc7098a20229a183ab7974548661cbbcf9321641ab1d25ff703716', asm_sha)
    capacity_name = 'verifier-capacite-preracines-R8.py'
    rendered[capacity_name] = add_capacity_predecessors(rendered[capacity_name])
    cap_sha = digest(rendered[capacity_name].encode())
    guard_name = 'verifier-absence-ancien-OBS4-R8.py'
    rendered[guard_name] = rendered[guard_name].replace('fabdcef0475943fa218713af8af6f2f5686bb6b794133640b0eb81e1bd4ef0e1', cap_sha)
    rendered[guard_name] = add_guard_predecessors(rendered[guard_name])
    guard_sha = digest(rendered[guard_name].encode())
    for name in ('preparer-observation-froide-R8.py','preparer-policy-routes-R8.py'):
        rendered[name] = rendered[name].replace('70da272e4ede4d4ea4caf78242212dc2f55d984ba866ad3bd39c7c9de798f16b', guard_sha)
    rendered['preparer-observation-froide-R8.py'] = rendered['preparer-observation-froide-R8.py'].replace(
        'ABSENCE-OBS4-R5-ACTUELLE.json', 'ABSENCE-OBS4-R5-ET-R7-ACTUELLE.json')
    policy_name = 'preparer-policy-routes-R8.py'
    rendered[policy_name] = future_qualification_policy(rendered[policy_name])
    sidecar = 'admettre-cellule-externe-R8-r2.py'
    rendered[sidecar] = once(rendered[sidecar], "and old.get('active_native_workers') == 0",
        "and old.get('all_eight_R7_original_identities_absent') is True\n"
        "         and old.get('no_unknown_reused_or_ambiguous_R7_descendants') is True\n"
        "         and old.get('R7_predecessors', {}).get('current_context_absence_verified') is True\n"
        "         and old.get('active_native_workers') == 0")
    rendered['lancer-observateur-R8-r2.ps1'] = render_ps(sources['lancer-observateur-R7-r2.ps1'])
    parent_names = {name.replace('R7','R8') for name in sources if name in {
        'assembler-entrees-roots-R7.py','preparer-triplet-metadata-R7.py','parent_roots-R7.py',
        'preparer-politiques-locales-R7.py','completer-absence-SO-lane-R7.py','verifier-capacite-preracines-R7.py','preparer-partage-R7.py'}}
    parents, observation = {}, {}
    for name, source in rendered.items():
        if name.endswith('.py'):
            ast.parse(source)
        need(OLD_Q_SHA not in source and 'Q754424' not in source.replace('# Never promote Q754424',''),
             "No active old Q pin may survive a derivative")
        target = parents if name in parent_names else observation
        relative = 'revision-r2-frontieres/' + name if name in {sidecar,'lancer-observateur-R8-r2.ps1'} else name
        target[relative] = source.encode('utf-8')
    need(len(parents) == 7 and len(observation) == 5, "Seven parent and five observation code derivatives required")
    return parents, observation


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--generator-review', type=Path, required=True)
    parser.add_argument('--generator-review-sha256', required=True)
    parser.add_argument('--derive-code-only', action='store_true')
    args = parser.parse_args()
    need(args.derive_code_only, 'Explicit ROOT code-only derivation required; no implicit effects')
    ns, store = preparation_io()
    review_path = ns['ordinary_path'](args.generator_review, beneath=HERE / 'revue-preparation-independante-r1')
    review_ref = ns['ref'](review_path, args.generator_review_sha256)
    review = store.reference(review_ref)
    need(review.get('schema') == 'hpc-forest-r8-external12-generator-independent-preparation-review-v1'
         and review.get('verified_source_preparation_only') is True and review.get('blocking_findings') == []
         and review.get('reviewed_files', {}).get(SELF.name) == digest(store.raw(SELF))
         and review.get('native_generation_admitted') is False, 'Actual independent generator review required')
    for target in (PARENTS, OBSERVATION):
        ns['ordinary_path'](target, beneath=OP, missing_leaf=True)
        ns['require_missing'](target)
    spec = ns['strict_json'](store.pinned(SPEC, SPEC_SHA))
    for name in ('source_recipe','recipe_plan','recipe_contract','R7_zero_call_closure','R7_observer_historical_exit','R7_eight_context'):
        item = spec[name]
        store.pinned(Path(item['path']), item['sha256'])
    manifest = ns['strict_json'](store.pinned(CHAIN / 'COMPONENTS.json', COMPONENTS))
    need(len(manifest['code_pins']) == 62 and manifest['source_zip_sha256'] == SOURCE and manifest['plan_sha256'] == PLAN,
         'Exact real R8 source/plan/62 required')
    for name, checksum in manifest['code_pins'].items():
        store.pinned(CHAIN / name, checksum)
    source_pins = ns['strict_json'](store.raw(CHAIN / 'launcher/pins-source-plan.json'))
    for name in ('source_zip','plan','source_manifest','independent_source_review'):
        item = source_pins[name]
        store.pinned(Path(item['path']), item['sha256'])
    need(source_pins['source_zip']['sha256'] == SOURCE and source_pins['plan']['sha256'] == PLAN
         and source_pins['source_manifest']['sha256'] == '66de9eb1090eae8d8d8a3fc78279b3d5a82b7d4f12521424acdf647185020766'
         and source_pins['independent_source_review']['sha256'] == '16d81068392789ad6b98c8ad358cb1e84d7630c33fd1a2b3ece69bbb145d3e20',
         'Actual unchanged source110/runtime and newly reviewed plan required')
    actual_review = store.reference(ns['ref'](REVIEW, REVIEW_SHA))
    need(actual_review['schema'] == 'hpc-forest-dynamic-r4b-integration-review-v1' and actual_review['verified'] is True
         and actual_review['blocking_findings'] == [] and actual_review['reviewed_files'] == manifest['code_pins']
         and actual_review['source_zip_sha256'] == SOURCE and actual_review['plan_sha256'] == PLAN
         and actual_review['adapter_components_manifest_sha256'] == COMPONENTS
         and actual_review['producer_sha256'] == manifest['code_pins']['lane_projection.py']
         and actual_review['native_generation_admitted'] is False, 'Actual new independent62 integration review required')
    data_ref = spec['existing_python_observation']
    python_observation = store.pinned(Path(data_ref['path']), data_ref['sha256'])
    parents, observation = render_all(store, spec)
    parents['PYTHON-WORKER-VENV-REEL-OBSERVE-PARENT.json'] = python_observation
    store.unchanged()
    before = dict(store.pins)
    metadata_before = {path: list(store.api['metadata'](Path(path).lstat())) for path in before}
    with ns['DirectoryLeases']() as leases:
        leases.hold(OP)
        for target in (PARENTS, OBSERVATION):
            ns['ordinary_path'](target, beneath=OP, missing_leaf=True)
            ns['require_missing'](target)
        for target, files in ((PARENTS, parents), (OBSERVATION, observation)):
            target.mkdir()
            leases.hold(target)
            for name, raw in files.items():
                path = target / name
                if path.parent != target and not path.parent.exists():
                    need(path.parent == target / 'revision-r2-frontieres', 'Only exact code subfolder permitted')
                    path.parent.mkdir()
                    leases.hold(path.parent)
                ns['ordinary_path'](path, beneath=target, missing_leaf=True)
                ns['write_new'](path, raw)
                need(store.api['raw'](path) == raw, 'New external helper bytes changed')
            deltas = {}
            for name, raw in files.items():
                if not name.endswith(('.py','.ps1')):
                    continue
                ancestor_name = Path(name).name.replace('R8','R7')
                ancestor = spec['ancestor_helpers'][ancestor_name]
                ancestor_bytes = store.pinned(Path(ancestor['path']), ancestor['sha256'])
                deltas[name] = {'ancestor':ancestor,'derived_sha256':digest(raw),'derived_bytes':len(raw),
                    'unified_diff':''.join(difflib.unified_diff(ancestor_bytes.decode('utf8').splitlines(keepends=True),
                         raw.decode('utf8').splitlines(keepends=True), fromfile=ancestor_name, tofile=name))}
            pending = {'schema':'hpc-forest-r8-generated-external-code-NON-ADMIS-v1','generated_code_only':True,
                'source_zip_sha256':SOURCE,'plan_sha256':PLAN,'components_sha256':COMPONENTS,
                'actual_code62_review':ns['ref'](REVIEW, REVIEW_SHA), 'generator_review':review_ref,
                'files':{name:{'sha256':digest(raw),'bytes':len(raw)} for name,raw in files.items()},
                'actual_source_deltas':deltas,
                'actual_allocated_Q_received':False,'actual_qualification_ref':None,
                'generated_code_review_received':False,'actual_code_review_ref':None,
                'generated_helper_tests_executed':False,'actual_test_receipt_ref':None,
                'bounded_startup_receiver_reviewed_and_tested':False,'actual_startup_receiver_ref':None,
                'actual_startup_evidence_pair_policy_or_persisted_state':None,
                'staging_or_observer_start_or_native_admission':False,
                'model_call_or_native_worker_or_remote_or_CIM_or_process_effects':0,
                'old_R7_Q_policy_PID_or_timer_promoted':False}
            ns['write_new'](target / 'DERIVATION-CODE-SEULEMENT-NON-ADMISE.json', ns['json_bytes'](pending))
        store.unchanged()
        need(dict(store.pins) == before and {p:list(store.api['metadata'](Path(p).lstat())) for p in before} == metadata_before,
             'Input SHA/full metadata changed during derivation')
    print(json.dumps({'generated_parent_helpers':7,'generated_observation_helpers':5,
                      'targets':[str(PARENTS),str(OBSERVATION)],'helpers_executed':False,
                      'new_Q_or_observer_or_native_generation_admitted':False}))


if __name__ == '__main__':
    main()

def need(ok, reason):
    if not ok:
        raise ValueError(reason)


def digest(raw):
    return hashlib.sha256(raw).hexdigest()


def preparation_io():
    need(os.name == "nt" and HERE == OP / "preparation-parcours-vivant-R8-r1/derivation-parents-r1",
         "Exact Windows generator boundary required")
    for path in (*reversed(PHASE1.parents), PHASE1):
        facts = path.lstat()
        need(not stat.S_ISLNK(facts.st_mode) and not getattr(facts, "st_file_attributes", 0) & 1024,
             "Pinned preparation source reparse refused")
    source = PHASE1.read_bytes()
    need(digest(source) == PHASE1_SHA, "Exact qualified local IO preparation source required")
    tree = ast.parse(source)
    need(isinstance(tree.body[-1], ast.If) and ast.unparse(tree.body[-1].test) == "__name__ == '__main__'"
         and ast.unparse(tree.body[-1].body[0]) == "main()", "Exclude exact preparation entry point")
    tree.body.pop()
    namespace = {"__file__": str(PHASE1), "__name__": "external_R8_preparation_IO_only"}
    exec(compile(tree, str(PHASE1), "exec"), namespace)
    need(namespace["HERE"] == P8 and namespace["BASE"] == BASE and namespace["PREP"] == PREP,
         "Qualified preparation anchors changed")
    store = namespace["ColdStore"]()
    store.pinned(PHASE1, PHASE1_SHA)
    return namespace, store


def once(source, old, new):
    need(source.count(old) == 1, "One exact source fragment required: " + old[:75])
    return source.replace(old, new)


def shape(source):
    class Strings(ast.NodeTransformer):
        def visit_Constant(self, node):
            return ast.copy_location(ast.Constant("<string>"), node) if isinstance(node.value, str) else node
    return ast.dump(Strings().visit(ast.parse(source)), include_attributes=False)


def identity_derivative(source):
    """Closed string identity changes only; numeric/branch/function structure fixed."""
    result = source
    for old, new in (("audit-compatibilite-factory-reelle-r1/revue-r7-code-r1/REVUE-INTEGRATION-R7-PREPARATION.json",
                      "preparation-derivee-R8-apres-raccord-r1/revue-integration-complete-R8-r1/REVUE-INTEGRATION-COMPLETE-R8-PREPARATION.json"),
                     ("audit-compatibilite-factory-reelle-r1\\revue-r7-code-r1\\REVUE-INTEGRATION-R7-PREPARATION.json",
                      "preparation-derivee-R8-apres-raccord-r1\\revue-integration-complete-R8-r1\\REVUE-INTEGRATION-COMPLETE-R8-PREPARATION.json"),
                     (OLD_PLAN, PLAN),
                     ("dc64e1360ea8c7b061cbda5eb2dc638f7cb76d9f4264c2f062a495c62ba12f30", COMPONENTS),
                     ("026445269563f1cc282bff8619831358391adbd26823a15044b6d3a3f23cc3dd", REVIEW_SHA),
                     ("5e5d3023ac538ed7197c6cd5da3e68a87e2b95228797af5b7ecbf6250579de95", "70bb498896602652b9999cf25d53b5282454ed4368359d8a91e826bcca45307e"),
                     ("b7e5d776cc3cca4bc93a53b75dd458c95a790b1199907206a72f3fd57aed2562", "5838d3d66f596837aa6ee630cc72c90d449e070ca262f1117f70ca50d7d3f38b"),
                     ("4f6f694d508e4a72438448f18176b71c436c77a094f971a748a0c27b3cb264ae", "a1234985df90b2203734c2b8b1ad296fe72786d4ba66179b9defe4593cee72d0"),
                     ("5851485df9daf092fa938760ab5e7ddb1bcf798bb4e1f5c909e52ebd4e21208b", "ba6b87e2ef571367e3b62175d639a6a2e95c3c1f3f71801d05acde6aa158753b"),
                     ("b60b55c50364b3b736ffba24cb5421a5ac8daac8bd0f3ad8e01716741e3f743b", "3287f059793ef9861b4dbeacc66706611c0ca3d355b4ec990d6754e7c4d07f9b"),
                     ("r7-5c3cc0082589", "r8-f927d37098f3"), *ROOT_MAP.items()):
        result = result.replace(old, new)
    result = result.replace("R7", "R8").replace("r7", "r8")
    need(shape(source) == shape(result), "Identity pass changed Python structure/numbers")
    need(not any(old in result for old in ROOT_MAP) and OLD_PLAN not in result,
         "An old roots identity or plan survived")
    return result



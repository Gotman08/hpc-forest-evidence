#ifndef KNN_H
#define KNN_H

#include <stdio.h>
#include <stdlib.h>

typedef struct {
    float x;
    float y;
} Point;

typedef struct {
    int n;
    float *xs;
    float *ys;
    char *labels;
} Dataset;

void on_error() {
    printf("Invalid input file.\n");
    exit(1);
}

int parse_number_of_groups() {
    int n;
    if (scanf(" n_groups=%d ", &n) != 1) on_error();
    return n;
}

Point parse_point() {
    float x, y;
    if (scanf(" (%f ,%f) ", &x, &y) != 2) on_error();
    Point point;
    point.x = x;
    point.y = y;
    return point;
}

Dataset *parse_dataset() {
    int n_groups = parse_number_of_groups();
    Dataset *ds = (Dataset *) malloc(sizeof(Dataset));
    if (!ds) on_error();
    ds->n = 0;
    ds->xs = NULL;
    ds->ys = NULL;
    ds->labels = NULL;
    size_t cap = 0;

    for (int g = 0; g < n_groups; ++g) {
        char label;
        int length;
        if (scanf(" label=%c ", &label) != 1) on_error();
        if (scanf(" length=%d ", &length) != 1) on_error();

        for (int i = 0; i < length; ++i) {
            Point p = parse_point();
            if ((size_t)ds->n == cap) {
                size_t newcap = cap ? cap * 2 : 1024;
                float *nx = (float *) realloc(ds->xs, newcap * sizeof(float));
                float *ny = (float *) realloc(ds->ys, newcap * sizeof(float));
                char *nl = (char *) realloc(ds->labels, newcap * sizeof(char));
                if (!nx || !ny || !nl) on_error();
                ds->xs = nx;
                ds->ys = ny;
                ds->labels = nl;
                cap = newcap;
            }
            ds->xs[ds->n] = p.x;
            ds->ys[ds->n] = p.y;
            ds->labels[ds->n] = label;
            ++ds->n;
        }
    }
    return ds;
}

int parse_k() {
    int k;
    if (scanf(" k=%d ", &k) != 1) on_error();
    return k;
}

#endif

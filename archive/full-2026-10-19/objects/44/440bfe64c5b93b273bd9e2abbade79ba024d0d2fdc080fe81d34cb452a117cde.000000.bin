import hashlib,json,re
from datetime import datetime,timezone
from pathlib import Path
BASE=Path(r"C:\Users\nicol\Documents\Codex\2026-10-15\cr")
D=Path(__file__).resolve().parent
GUIDE=BASE/"outputs/HPC-Forest-Harnais-Comparaison-r1/SUIVI-COMPACT.md"
ID=BASE/"ID.md"
sha=lambda b:hashlib.sha256(b).hexdigest()
oldg=GUIDE.read_bytes();oldi=ID.read_bytes()
assert sha(oldg)=="3d4ce00601bf798bf732e93a64a7ed887550f1ba4d965fab38ddcc37ed0334ef"
backup=D/"avant-guide-q752235-positive";backup.mkdir(exist_ok=False)
(backup/"SUIVI-COMPACT.md").write_bytes(oldg);(backup/"ID.md").write_bytes(oldi)
g=oldg.decode("utf-8-sig")
g=g.replace("## R3 corrigé par R4b — qualification en cours, génération fermée","## R3 corrigé par R4b — mécanique reçue, démarrage natif à qualifier")
a=g.index("Suite autorisée : correction **externe**");b=g.index("\n\nLimites du protocole conservées",a)
new="""Qualification corrective **752235 CLOS COMPLETED0:0**, reçue/auditée : source/plan EDE/9f04 inchangés, 231 tests neutres et deux tests C réussis, 19 statuts dont16 références préparées et15 admises au plan. Trois SHA archive **576b5a975c15d97289ae32f3f7063530aeff1ac294e040fa441486e195fbbdef** concordants ;103sources après identiques. Les bruts et traces trois/cinq mesures sont audités, aucun modèle ni gain natif. Reçu ../HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r2/qualification-allouee-wrapper-r3/reception-752235/reception-verifiee.json, audit-independant.json et LIVRAISON-RECEPTION-MECANIQUE-752235.json. Ne plus repoller ou relancer752235. Le défaut de fixture est corrigé hors du ZIP ; premier échec752206 conservé.

Préparation de surveillance mixte : aucun nouveau lecteur démarré ni ancien arrêté à cet arrêté. Le premier prévol local du lecteur r1 a refusé des lignes système sans exécutable/commande avant de filtrer par PID ; premier refus conservé sous reprises/r3-corrige-r4-parallele-20261018/transition-observateur-mixte/premier-refus-census-reel-r1.json. Révision r2 isolée en préparation, stricte sur les cinq champs du PID correspondant ; ne jamais affaiblir les identités ni modifier le lecteur vivant. Nouvelle surveillance saine en parallèle de l’ancienne, puis absence individuelle possédée de l’ancien lecteur passif avant route dynamique ; source-only préservé. Cela ne touche aucune génération.

Suite autorisée après les admissions réelles : trois contrats natifs Luna MAX roots/advice/harvest, sessions distinctes exactes du plan, puis pilote count2023 Luna MAX. Réconciliation de chaque appel, outils désactivés, CLI/OAuth/allocation reçus ; premier NORMAL et évaluation avant extension aux autres modèles. Les enveloppes locales non admises ne permettent aucune génération. Préparation externe concrète lancement-technique-r4b-r1/ ; ancien R3 et R4 ne sont pas deux campagnes. R5 reste seul et derrière ses prérequis."""
g=g[:a]+new+g[b:]
GUIDE.write_text(g,encoding="utf-8",newline="\n")
s=oldi.decode("utf-8-sig")
ids=lambda t:set(re.findall(r"^\\| (ID-\\d{3}) \\|",t,re.M))
# Direct split avoids historical mentions of IDs counting as rows.
def rows_ids(t):return [line.split("|")[1].strip() for line in t.splitlines() if line.startswith("| ID-")]
assert len(rows_ids(s))==40 and len(set(rows_ids(s)))==40
updates={
"ID-019":("R1 MAX complet60/60 ; primes R2 Luna reçue au périmètre borné, Astra752139/Terra752140/Sol752141 terminés FAILED1:0 et reçus au périmètre métadonnées ; tous relais R2 clos après réconciliation, sans rejeu ; source-only Sol751592 continue","HPC-Forest-Primes-Natif-Lancement-r2b/reception-finale-*/REPRISE-R3.md ; SUIVI-COMPACT.md"),
"ID-023":("Une seule campagne R3 corrigé par R4 choisie ; mécanique R4b MAX752235 reçue/auditée,103sources exactes,231neutres+2C ; contrats natifs et premier NORMAL restent à recevoir","HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r2/qualification-allouee-wrapper-r3/reception-752235/REPRISE.md ; SUIVI-COMPACT.md"),
"ID-024":("Correction isolée R4b des diagnostics bruts reçue mécaniquement sur ARM64/752235 ; aucune preuve d’isolement natif ou efficacité scientifique encore admise","Réception mécanique752235 ; revue-independante-r4b/REVUE-INDEPENDANTE-R4B-R2.json"),
"ID-027":("Tell/récolte et projection des Outcomes R4b contrôlés mécaniquement/752235 ; contrats natifs et pilote réels restent requis","Réception mécanique752235 ; lancement-technique-r4b-r1/ non admis avant contrôles réels")}
lines=[]
for line in s.splitlines():
 if line.startswith("| ID-"):
  cols=line.split("|");key=cols[1].strip()
  if key in updates:cols[3]=" "+updates[key][0]+" ";cols[5]=" "+updates[key][1]+" ";line="|".join(cols)
 lines.append(line)
newi="\n".join(lines)+"\n"
assert rows_ids(newi)==rows_ids(s)
ID.write_text(newi,encoding="utf-8",newline="\n")
r={"schema":"hpc-forest-current-guide-q752235-positive-v1","verified":True,"at_utc":datetime.now(timezone.utc).isoformat(),"guide_before":sha(oldg),"guide_after":sha(GUIDE.read_bytes()),"ID_before":sha(oldi),"ID_after":sha(ID.read_bytes()),"forty_ID_rows_preserved":True,"Q752235_mechanical_only":True,"native_generation_started":False,"first_reader_failure_preserved":True,"backup":str(backup)}
(D/"guide-q752235-positive-verifie.json").write_text(json.dumps(r,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
print(json.dumps(r,ensure_ascii=False))


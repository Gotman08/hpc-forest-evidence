{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n  return bodies;\n}\n\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n  Body *bodies = read_dataset(&nbodies);\n\n  #pragma omp parallel\n  {\n    for (int iter = 0; iter < N_ITER; ++iter) {\n      // Compute forces and update velocities.\n      #pragma omp for schedule(static)\n      for (int i = 0; i < nbodies; ++i) {\n        float fx = 0.0f;\n        float fy = 0.0f;\n        float fz = 0.0f;\n\n        for (int j = 0; j < nbodies; ++j) {\n          float dx = bodies[j].x - bodies[i].x;\n          float dy = bodies[j].y - bodies[i].y;\n          float dz = bodies[j].z - bodies[i].z;\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          float inv_dist = 1.0f / sqrt(sqrd_dist);\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n        }\n\n        bodies[i].vx += DT*fx;\n        bodies[i].vy += DT*fy;\n        bodies[i].vz += DT*fz;\n      }\n      // Implicit barrier: all velocities updated before position integration.\n\n      #pragma omp for schedule(static)\n      for (int i = 0; i < nbodies; ++i) {\n        bodies[i].x += bodies[i].vx * DT;\n        bodies[i].y += bodies[i].vy * DT;\n        bodies[i].z += bodies[i].vz * DT;\n      }\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n  free(bodies);\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Reusing a single OpenMP parallel region across all simulation iterations and using static scheduling for both force/velocity update and position integration worksharing loops reduces thread-team creation overhead while preserving deterministic per-body accumulation order, improving performance on 4 cores.",
  "notes": "The inner j-loop remains sequential for each body i, so the floating-point accumulation order is identical to the reference serial code. Static contiguous chunks minimize false sharing at cache-line boundaries compared to interleaved schedules. The single parallel region avoids repeated thread-team creation per iteration.",
  "sources_kept": [],
  "transformations": [
    "Inlined body_force into main",
    "Wrapped the entire simulation loop in a single #pragma omp parallel region",
    "Used #pragma omp for schedule(static) for force/velocity computation and position integration"
  ]
}

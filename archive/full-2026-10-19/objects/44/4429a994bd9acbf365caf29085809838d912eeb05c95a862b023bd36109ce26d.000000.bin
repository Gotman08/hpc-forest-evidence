    "content": "{\n  \"hypothesis\": \"Vectorize the computation of gravitational forces to improve performance.\",\n  \"transformations\": [\n    \"Vectorized the computation of gravitational forces using SIMD intrinsics.\"\n  ],\n  \"sources_kept\": [],\n  \"files\": [\n    {\n      \"path\": \"src/nbody.c\",\n      \"content\": \"#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <math.h>\\n#include <immintrin.h>\\n\\n#define N_ITER 10 // number of simulation iterations\\n#define DT 0.01f // time step\\n#define SOFTENING 1e-9f // to avoid zero divisors\\n\\n/*\\n * Each body holds coordinate positions (i.e., x, y, and z) and\\n * velocities (i.e., vx, vy, and vz).\\n */\\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\\n\\n/*\\n * Compute the gravitational impact among all pairs of bodies in \\n * the system.\\n */\\nvoid body_force(Body *p, float dt, int n) {\\n  for (int i = 0; i < n; i += 4) {\\n    __m256 fx = _mm256_setzero_ps();\\n    __m256 fy = _mm256_setzero_ps();\\n    __m256 fz = _mm256_setzero_ps();\\n\\n    for (int j = 0; j < n; j++) {\\n      __m256 dx = _mm256_set1_ps(p[j].x - p[i].x);\\n      __m256 dy = _mm256_set1_ps(p[j].y - p[i].y);\\n      __m256 dz = _mm256_set1_ps(p[j].z - p[i].z);\\n      __m256 sqrd_dist = _mm256_add_ps(_mm256_add_ps(_mm256_mul_ps(dx, dx), _mm256_mul_ps(dy, dy)), _mm256_add_ps(_mm256_mul_ps(dz, dz), _mm256_set1_ps(SOFTENING)));\\n      __m256 inv_dist = _mm256_rsqrt_ps(sqrd_dist);\\n      __m256 inv_dist3 = _mm256_mul_ps(_mm256_mul_ps(inv_dist, inv_dist), inv_dist);\\n\\n      fx = _mm256_add_ps(fx, _mm256_mul_ps(dx, inv_dist3));\\n      fy = _mm256_add_ps(fy, _mm256_mul_ps(dy, inv_dist3));\\n      fz = _mm256_add_ps(fz, _mm256_mul_ps(dz, inv_dist3));\\n    }\\n\\n    _mm256_storeu_ps(&p[i].vx, _mm256_add_ps(_mm256_loadu_ps(&p[i].vx), _mm256_mul_ps(fx, _mm256_set1_ps(dt))));\\n    _mm256_storeu_ps(&p[i].vy, _mm256_add_ps(_mm256_loadu_ps(&p[i].vy), _mm256_mul_ps(fy, _mm256_set1_ps(dt))));\\n    _mm256_storeu_ps(&p[i].vz, _mm256_add_ps(_mm256_loadu_ps(&p[i].vz), _mm256_mul_ps(fz, _mm256_set1_ps(dt))));\\n  }\\n}\\n\\n/*\\n * Read a binary dataset with initilized bodies.\\n */\\nBody* read_dataset(int *nbodies) {\\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading nbodie value\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading input values\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n\\n  return bodies;\\n}\\n\\n/*\\n * Write simulation results into a binary dataset.\\n */\\nvoid write_dataset(const int nbodies, Body *bodies) {\\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError writing to output\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n}\\n\\nint main(int argc,char **argv) {\\n  int nbodies;\\n\\n  Body *bodies = read_dataset(&nbodies);\\n\\n  /*\\n   * At each simulation iteration, interbody forces are computed,\\n   * and bodies' positions are integrated.\\n   */\\n  for (int iter = 0; iter < N_ITER; iter++) {\\n    body_force(bodies, DT, nbodies);\\n\\n    for (int i = 0; i < nbodies; i++) {\\n      bodies[i].x += bodies[i].vx * DT;\\n      bodies[i].y += bodies[i].vy * DT;\\n      bodies[i].z += bodies[i].vz * DT;\\n    }\\n  }\\n\\n  write_dataset(nbodies, bodies);\\n\\n  free(bodies);\\n  \\n  exit(EXIT_SUCCESS);\\n}\"\n    }\n  ],\n  \"notes\": \"Vectorized the computation of gravitational forces using SIMD intrinsics to improve performance.\"\n}"

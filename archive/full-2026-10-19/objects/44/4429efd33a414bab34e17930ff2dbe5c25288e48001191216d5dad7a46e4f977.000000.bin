      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdio>\n#include <iostream>\n#include <memory>\n#include <vector>\n\nint main() {\n    int n, s;\n    std::cin >> n >> s;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    // Only rows that will eventually leave the vertical window need storage.\n    const int buffered_rows = std::min(s, n - s);\n    std::unique_ptr<int[]> rows(\n        new int[static_cast<std::size_t>(buffered_rows) * n]);\n    std::vector<long long> columns(n, 0);\n\n    for (int r = 0; r < s; ++r) {\n        int* saved = r < buffered_rows\n            ? rows.get() + static_cast<std::size_t>(r) * n\n            : nullptr;\n        for (int c = 0; c < n; ++c) {\n            int value;\n            scanf(\"%d\", &value);\n            columns[c] += static_cast<long long>(value);\n            if (saved != nullptr) {\n                saved[c] = value;\n            }\n        }\n    }\n\n    long long sum = 0;\n    for (int c = 0; c < s; ++c) {\n        sum += columns[c];\n    }\n    long long maximum = sum;\n    for (int c = s; c < n; ++c) {\n        sum += columns[c] - columns[c - s];\n        maximum = std::max(maximum, sum);\n    }\n\n    int slot = 0;\n    for (int r = s; r < n; ++r) {\n        int* oldest = rows.get() + static_cast<std::size_t>(slot) * n;\n        const bool retain = r < n - s;\n        sum = 0;\n\n        for (int c = 0; c < s; ++c) {\n            int value;\n            scanf(\"%d\", &value);\n            columns[c] += static_cast<long long>(value) - oldest[c];\n            if (retain) {\n                oldest[c] = value;\n            }\n            sum += columns[c];\n        }\n        maximum = std::max(maximum, sum);\n\n        // Columns to the left have already been updated for this strip.\n        for (int c = s; c < n; ++c) {\n            int value;\n            scanf(\"%d\", &value);\n            columns[c] += static_cast<long long>(value) - oldest[c];\n            if (retain) {\n                oldest[c] = value;\n            }\n            sum += columns[c] - columns[c - s];\n            maximum = std::max(maximum, sum);\n        }\n\n        if (++slot == buffered_rows) {\n            slot = 0;\n        }\n    }\n\n    printf(\"%lld\\n\", maximum);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

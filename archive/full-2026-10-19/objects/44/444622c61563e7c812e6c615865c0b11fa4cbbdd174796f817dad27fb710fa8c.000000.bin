      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdio>\n#include <limits>\n#include <memory>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nclass FastInput {\n    unsigned char buffer[1 << 16];\n    std::size_t position = 0;\n    std::size_t available = 0;\n\n    int readByte() {\n        if (position == available) {\n            available = std::fread(buffer, 1, sizeof(buffer), stdin);\n            position = 0;\n            if (available == 0)\n                return EOF;\n        }\n        return buffer[position++];\n    }\n\npublic:\n    bool nextInt(int& value) {\n        int c;\n        do {\n            c = readByte();\n        } while (c != EOF && c <= ' ');\n        if (c == EOF)\n            return false;\n\n        const bool negative = c == '-';\n        if (c == '-' || c == '+')\n            c = readByte();\n        unsigned int magnitude = 0;\n        while (c >= '0' && c <= '9') {\n            magnitude = magnitude * 10u + static_cast<unsigned int>(c - '0');\n            c = readByte();\n        }\n        const long long signedValue = negative\n            ? -static_cast<long long>(magnitude)\n            : static_cast<long long>(magnitude);\n        value = static_cast<int>(signedValue);\n        return true;\n    }\n};\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.nextInt(n) || !input.nextInt(s))\n        return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t elementCount = static_cast<std::size_t>(n) * n;\n    std::unique_ptr<long long[]> storage(new long long[elementCount]);\n    long long* const matrix = storage.get();\n    for (std::size_t i = 0; i < elementCount; ++i) {\n        int value;\n        if (!input.nextInt(value))\n            return 0;\n        matrix[i] = value;\n    }\n\n    const int windowRows = n - s + 1;\n    const int windowCols = windowRows;\n    int threads = 1;\n#ifdef _OPENMP\n    threads = std::min(omp_get_max_threads(),\n                       std::max(1, static_cast<int>(elementCount / (256 * 1024))));\n#endif\n\n    constexpr int maxStripeWidth = 256;\n    const int initialStripeCount = std::max(\n        4 * threads, (windowCols + maxStripeWidth - 1) / maxStripeWidth);\n    const int stripeCount = std::min(\n        windowCols, ((initialStripeCount + threads - 1) / threads) * threads);\n\n    long long mxSum = std::numeric_limits<long long>::lowest();\n#pragma omp parallel num_threads(threads) if(threads > 1) reduction(max:mxSum)\n    {\n        if (s == 1) {\n#pragma omp for schedule(static)\n            for (int r = 0; r < n; ++r) {\n                const long long* row = matrix + static_cast<std::size_t>(r) * n;\n                long long rowMaximum = std::numeric_limits<long long>::lowest();\n#pragma omp simd reduction(max:rowMaximum)\n                for (int c = 0; c < n; ++c)\n                    rowMaximum = std::max(rowMaximum, row[c]);\n                mxSum = std::max(mxSum, rowMaximum);\n            }\n        } else {\n#pragma omp for schedule(static)\n            for (int r = 0; r < n; ++r) {\n                long long* row = matrix + static_cast<std::size_t>(r) * n;\n                long long sum = 0;\n#pragma omp simd reduction(+:sum)\n                for (int c = 0; c < s; ++c)\n                    sum += row[c];\n\n                // Each entering element is still ahead of the overwritten prefix.\n                for (int c = 0; c + 1 < windowCols; ++c) {\n                    const long long leaving = row[c];\n                    row[c] = sum;\n                    sum += row[c + s] - leaving;\n                }\n                row[windowCols - 1] = sum;\n            }\n\n            // The preceding worksharing barrier makes every row sum available.\n            alignas(64) long long totals[maxStripeWidth];\n#pragma omp for schedule(static,1)\n            for (int stripe = 0; stripe < stripeCount; ++stripe) {\n                const int left = windowCols * stripe / stripeCount;\n                const int right = windowCols * (stripe + 1) / stripeCount;\n                const int width = right - left;\n#pragma omp simd\n                for (int c = 0; c < width; ++c)\n                    totals[c] = 0;\n\n                for (int r = 0; r < s; ++r) {\n                    const long long* row = matrix + static_cast<std::size_t>(r) * n + left;\n#pragma omp simd\n                    for (int c = 0; c < width; ++c)\n                        totals[c] += row[c];\n                }\n\n                long long stripeMaximum = std::numeric_limits<long long>::lowest();\n#pragma omp simd reduction(max:stripeMaximum)\n                for (int c = 0; c < width; ++c)\n                    stripeMaximum = std::max(stripeMaximum, totals[c]);\n\n                for (int top = 1; top < windowRows; ++top) {\n                    const long long* leaving = matrix\n                        + static_cast<std::size_t>(top - 1) * n + left;\n                    const long long* entering = matrix\n                        + static_cast<std::size_t>(top + s - 1) * n + left;\n#pragma omp simd reduction(max:stripeMaximum)\n                    for (int c = 0; c < width; ++c) {\n                        const long long value = totals[c] + entering[c] - leaving[c];\n                        totals[c] = value;\n                        stripeMaximum = std::max(stripeMaximum, value);\n                    }\n                }\n                mxSum = std::max(mxSum, stripeMaximum);\n            }\n        }\n    }\n\n    std::printf(\"%lld\\n\", mxSum);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "A single OpenMP team performing in-place horizontal sums followed by balanced cache-sized column stripes should eliminate duplicated band initialization and replace dependent maximum scans with SIMD reductions.",
  "notes": "Unmeasured. Uses portable OpenMP and exact 64-bit intermediates. Matrix storage is 8*n*n bytes, without a separate intermediate matrix.",

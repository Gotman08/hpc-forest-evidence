"""Small synthetic byte-preservation check, independent of the contest problems."""
import hashlib
import importlib.util
import json
import tarfile
import tempfile
import zipfile
from pathlib import Path
import dedup_bundle

here=Path(__file__).resolve().parent
spec=importlib.util.spec_from_file_location("restore",here.parents[1]/"outputs/Marathon22-autonome/cadre-execution/restaurer-preuves.py")
restore=importlib.util.module_from_spec(spec)
spec.loader.exec_module(restore)
with tempfile.TemporaryDirectory(dir=here,prefix="roundtrip-") as temp:
    root=Path(temp)
    originals=root/"r1/sources-officielles"
    originals.mkdir(parents=True)
    with zipfile.ZipFile(originals/"fixture.zip","w") as z:
        z.writestr("input",b"original fixture\x00\xff\n")
    runs=[]
    for i in [1,2]:
        run=root/f"r{i}"/f"results-{i}"
        run.mkdir(parents=True)
        (run/"official-copy").write_bytes(b"original fixture\x00\xff\n")
        (run/"shared-log").write_bytes(b"same model log\n")
        (run/"unique.json").write_text(json.dumps({"run":i}))
        archive=run.parent/(run.name+".tar.gz")
        with tarfile.open(archive,"w:gz") as t:
            t.add(run,arcname=run.name)
        archive.with_suffix(archive.suffix+".sha256").write_text(hashlib.sha256(archive.read_bytes()).hexdigest())
        runs.append(run)
    bundle=root/"evidence.tar.gz"
    dedup_bundle.make(*runs,bundle)
    restored=root/"restored"
    result=restore.restore(bundle,originals,restored)
    for run in runs:
        for p in run.iterdir():
            assert p.read_bytes()==(restored/run.name/p.name).read_bytes()
    assert result["verified_files"]==6
    print("Lossless evidence roundtrip passed: 6/6 files, official reuse and duplicate blob")

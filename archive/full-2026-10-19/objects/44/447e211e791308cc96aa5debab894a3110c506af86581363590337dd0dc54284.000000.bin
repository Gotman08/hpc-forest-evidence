        "content": "#include <bits/stdc++.h>\n\nusing coefficient_t = std::uint32_t;\nusing wide_t = std::uint64_t;\n\nconstexpr wide_t modulus = 1000000007ULL;\nconstexpr int accumulation_block = 16;\n\nstatic void write_answer(wide_t value) {\n    std::cout << value << static_cast<char>(10);\n}\n\nstatic std::vector<coefficient_t> multiply_reduce(\n    const std::vector<coefficient_t>& left,\n    const std::vector<coefficient_t>& right,\n    const std::vector<coefficient_t>& reversed_weights) {\n    const int n = static_cast<int>(reversed_weights.size());\n    const int width = 2 * n - 1;\n    std::vector<wide_t> work(static_cast<std::size_t>(width), 0);\n\n    for (int first = 0; first < n; first += accumulation_block) {\n        const int last = std::min(n, first + accumulation_block);\n        for (int i = first; i < last; ++i) {\n            const wide_t left_value = left[static_cast<std::size_t>(i)];\n            if (left_value == 0) {\n                continue;\n            }\n            wide_t* const destination = work.data() + i;\n            for (int j = 0; j < n; ++j) {\n                destination[j] += left_value * right[static_cast<std::size_t>(j)];\n            }\n        }\n        for (wide_t& value : work) {\n            value %= modulus;\n        }\n    }\n\n    for (int high = width - 1; high >= n;) {\n        const int low = std::max(n, high - accumulation_block + 1);\n        for (int degree = high; degree >= low; --degree) {\n            const wide_t coefficient = work[static_cast<std::size_t>(degree)] % modulus;\n            work[static_cast<std::size_t>(degree)] = 0;\n            if (coefficient == 0) {\n                continue;\n            }\n\n            wide_t* const destination = work.data() + (degree - n);\n            for (int j = 0; j < n; ++j) {\n                destination[j] += coefficient * reversed_weights[static_cast<std::size_t>(j)];\n            }\n        }\n        for (wide_t& value : work) {\n            value %= modulus;\n        }\n        high = low - 1;\n    }\n\n    std::vector<coefficient_t> reduced(static_cast<std::size_t>(n));\n    for (int i = 0; i < n; ++i) {\n        reduced[static_cast<std::size_t>(i)] =\n            static_cast<coefficient_t>(work[static_cast<std::size_t>(i)]);\n    }\n    return reduced;\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    std::size_t n;\n    wide_t h;\n    if (!(std::cin >> n >> h) || n == 0) {\n        return 0;\n    }\n\n    std::vector<coefficient_t> base_values(n);\n    std::vector<coefficient_t> weights(n);\n\n    for (std::size_t i = 0; i < n; ++i) {\n        wide_t value;\n        std::cin >> value;\n        base_values[i] = static_cast<coefficient_t>(value % modulus);\n    }\n    for (std::size_t i = 0; i < n; ++i) {\n        wide_t value;\n        std::cin >> value;\n        weights[i] = static_cast<coefficient_t>(value % modulus);\n    }\n\n    if (h <= static_cast<wide_t>(n)) {\n        write_answer(base_values[static_cast<std::size_t>(h - 1)]);\n        return 0;\n    }\n\n    if (n == 1) {\n        wide_t coefficient = 1;\n        wide_t factor = weights[0];\n        for (wide_t exponent = h - 1; exponent != 0;) {\n            if ((exponent & 1ULL) != 0) {\n                coefficient = (coefficient * factor) % modulus;\n            }\n            exponent >>= 1;\n            if (exponent != 0) {\n                factor = (factor * factor) % modulus;\n            }\n        }\n        write_answer((coefficient * base_values[0]) % modulus);\n        return 0;\n    }\n\n    std::vector<coefficient_t> reversed_weights(n);\n    for (std::size_t i = 0; i < n; ++i) {\n        reversed_weights[i] = weights[n - 1 - i];\n    }\n\n    std::vector<coefficient_t> power(n, 0);\n    power[1] = 1;\n    std::vector<coefficient_t> polynomial(n, 0);\n    polynomial[0] = 1;\n\n    for (wide_t exponent = h - 1; exponent != 0;) {\n        if ((exponent & 1ULL) != 0) {\n            polynomial = multiply_reduce(polynomial, power, reversed_weights);\n        }\n        exponent >>= 1;\n        if (exponent != 0) {\n            power = multiply_reduce(power, power, reversed_weights);\n        }\n    }\n\n    wide_t answer = 0;\n    for (std::size_t first = 0; first < n; first += accumulation_block) {\n        const std::size_t last = std::min(\n            n, first + static_cast<std::size_t>(accumulation_block));\n        for (std::size_t i = first; i < last; ++i) {\n            answer += static_cast<wide_t>(polynomial[i]) * base_values[i];\n        }\n        answer %= modulus;\n    }\n\n    write_answer(answer);\n    return 0;\n}\n",
        "path": "src/npbonacci.cpp"
      }

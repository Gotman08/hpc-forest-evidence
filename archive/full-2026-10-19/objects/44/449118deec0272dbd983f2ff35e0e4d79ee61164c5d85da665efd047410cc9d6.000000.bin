"""Prove compiler-gate changes are isolated from search and model prompts."""
import hashlib
import json
import zipfile
from pathlib import Path

here=Path(__file__).resolve().parent
workspace=here.parents[1]
project=workspace/"outputs/HPC-Forest"
old=here.parent/"marathon-v9/payload"
new=here/"payload"
name="payload-r4/hpc_forest-0.1.0-py3-none-any.whl"
with zipfile.ZipFile(old/name) as a, zipfile.ZipFile(new/name) as b:
    source_files=[n for n in a.namelist() if n.startswith("hpc_forest/") and not n.endswith("/")]
    changed=[n for n in source_files if a.read(n)!=b.read(n)]
    assert changed==["hpc_forest/contracts.py"]
    assert b.read(changed[0]).decode()==a.read(changed[0]).decode().replace('    "-fopenmp",\n','    "-fopenmp",\n    "-Werror=uninitialized",\n    "-Werror=maybe-uninitialized",\n',1)
    assert (project/"src/hpc_forest/contracts.py").read_bytes()==b.read(changed[0])
same=["neutral_backend.py","romeo_marathon.py","timer_probe.py","detect_resources.py","evidence_pack.py"]
assert all((old/n).read_bytes()==(new/n).read_bytes() for n in same)
before=(old/"prepare_problem.py").read_text(encoding="utf-8")
after=(new/"prepare_problem.py").read_text(encoding="utf-8")
assert after==before.replace('            "-fopenmp",\n','            "-fopenmp",\n            "-Werror=uninitialized",\n            "-Werror=maybe-uninitialized",\n',1)
for filename in ["prepare_problem.py","neutral_backend.py","romeo_marathon.py","romeo_base.py"]:
    assert (project/"examples/marathon22"/filename).read_text(encoding="utf-8")== (new/filename).read_text(encoding="utf-8")
assert (project/"tests/test_contracts.py").read_bytes()==(new/"tests/test_contracts.py").read_bytes()
receipt={"verified":True,"changed_runtime_files":changed,"runtime_files":len(source_files),
         "prompt_search_and_timer_files_unchanged":same,
         "preparer_change_only": ["-Werror=uninitialized","-Werror=maybe-uninitialized"],
         "test_data_generator_changed":False,"comparator_changed":False,
         "main_source_matches_tested_wheel":True,"manual_candidate_edits":0,
         "wheel_sha256":hashlib.sha256((new/name).read_bytes()).hexdigest()}
out=workspace/"outputs/Marathon22-32B-v9/cadre-execution/nbody-v10b/core-integrity.json"
out.write_text(json.dumps(receipt,indent=2)+"\n",encoding="utf-8")
print(json.dumps(receipt))

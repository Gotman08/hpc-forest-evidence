    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <math.h>\n#include <string.h>\n\n#define MAXNUM 100\n#define MAXSTR 50\n#define MAXRESULTS (MAXNUM * MAXNUM)\n\nchar firstHalf[MAXNUM][MAXSTR];\nchar secondHalf[MAXNUM][MAXSTR];\nlong int candidateResults[MAXNUM * MAXNUM];\nlong int result[MAXRESULTS];\nint numPrimes = 0;\n\nint isprime(long int value)\n{\n    long int root;\n    long int factor = 2;\n    int prime = 1;\n\n    root = sqrtl(value);\n    while ((factor <= root) && prime) {\n        prime = fmod((double)value, (double)factor) > 0.0;\n        factor++;\n    }\n    return prime;\n}\n\nstatic void test_candidate(int first, int second)\n{\n    char candidate[MAXSTR];\n    long int value;\n    int index = first * numPrimes + second;\n\n    strcpy(candidate, firstHalf[first]);\n    strcat(candidate, secondHalf[second]);\n    value = atol(candidate);\n    candidateResults[index] = isprime(value) ? value : 0L;\n}\n\nvoid quicksort(long int *primes, int first, int last)\n{\n    int i, j, pivot;\n    long int temp;\n\n    if (first < last) {\n        pivot = first;\n        i = first;\n        j = last;\n        while (i < j) {\n            while (primes[i] <= primes[pivot] && i < last)\n                i++;\n            while (primes[j] > primes[pivot])\n                j--;\n            if (i < j) {\n                temp = primes[i];\n                primes[i] = primes[j];\n                primes[j] = temp;\n            }\n        }\n        temp = primes[pivot];\n        primes[pivot] = primes[j];\n        primes[j] = temp;\n        quicksort(primes, first, j - 1);\n        quicksort(primes, j + 1, last);\n    }\n}\n\nint main(int argc, char **argv)\n{\n    FILE *primesFile;\n    int i = 0, j = 0, numResults = 0;\n\n    primesFile = stdin;\n    fscanf(primesFile, \"%d\\n\", &numPrimes);\n    for (i = 0; i < numPrimes; i++)\n        fscanf(primesFile, \"%s\\n\", firstHalf[i]);\n    for (i = 0; i < numPrimes; i++)\n        fscanf(primesFile, \"%s\\n\", secondHalf[i]);\n    fclose(primesFile);\n\n    if (numPrimes >= 8) {\n        #pragma omp parallel for collapse(2) schedule(static)\n        for (i = 0; i < numPrimes; i++) {\n            for (j = 0; j < numPrimes; j++)\n                test_candidate(i, j);\n        }\n    } else {\n        for (i = 0; i < numPrimes; i++)\n            for (j = 0; j < numPrimes; j++)\n                test_candidate(i, j);\n    }\n\n    for (i = 0; i < numPrimes * numPrimes; i++) {\n        if (candidateResults[i] != 0L)\n            result[numResults++] = candidateResults[i];\n    }\n    quicksort(result, 0, numResults - 1);\n    for (i = 0; i < numResults; i++)\n        printf(\"%ld\\n\", result[i]);\n    return 0;\n}\n",
      "path": "src/model-view/primetest.c"
    },
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <math.h>\n#include <string.h>\n\n#define MAXNUM 100\n#define MAXSTR 50\n#define MAXRESULTS (MAXNUM * MAXNUM)\n\nchar firstHalf[MAXNUM][MAXSTR];\nchar secondHalf[MAXNUM][MAXSTR];\nlong int candidateResults[MAXNUM * MAXNUM];\nlong int result[MAXRESULTS];\nint numPrimes = 0;\n\nint isprime(long int value)\n{\n    long int root;\n    long int factor = 2;\n    int prime = 1;\n\n    root = sqrtl(value);\n    while ((factor <= root) && prime) {\n        prime = fmod((double)value, (double)factor) > 0.0;\n        factor++;\n    }\n    return prime;\n}\n\nstatic void test_candidate(int first, int second)\n{\n    char candidate[MAXSTR];\n    long int value;\n    int index = first * numPrimes + second;\n\n    strcpy(candidate, firstHalf[first]);\n    strcat(candidate, secondHalf[second]);\n    value = atol(candidate);\n    candidateResults[index] = isprime(value) ? value : 0L;\n}\n\nvoid quicksort(long int *primes, int first, int last)\n{\n    int i, j, pivot;\n    long int temp;\n\n    if (first < last) {\n        pivot = first;\n        i = first;\n        j = last;\n        while (i < j) {\n            while (primes[i] <= primes[pivot] && i < last)\n                i++;\n            while (primes[j] > primes[pivot])\n                j--;\n            if (i < j) {\n                temp = primes[i];\n                primes[i] = primes[j];\n                primes[j] = temp;\n            }\n        }\n        temp = primes[pivot];\n        primes[pivot] = primes[j];\n        primes[j] = temp;\n        quicksort(primes, first, j - 1);\n        quicksort(primes, j + 1, last);\n    }\n}\n\nint main(int argc, char **argv)\n{\n    FILE *primesFile;\n    int i = 0, j = 0, numResults = 0;\n\n    primesFile = stdin;\n    fscanf(primesFile, \"%d\\n\", &numPrimes);\n    for (i = 0; i < numPrimes; i++)\n        fscanf(primesFile, \"%s\\n\", firstHalf[i]);\n    for (i = 0; i < numPrimes; i++)\n        fscanf(primesFile, \"%s\\n\", secondHalf[i]);\n    fclose(primesFile);\n\n    if (numPrimes >= 8) {\n        #pragma omp parallel for collapse(2) schedule(static)\n        for (i = 0; i < numPrimes; i++) {\n            for (j = 0; j < numPrimes; j++)\n                test_candidate(i, j);\n        }\n    } else {\n        for (i = 0; i < numPrimes; i++)\n            for (j = 0; j < numPrimes; j++)\n                test_candidate(i, j);\n    }\n\n    for (i = 0; i < numPrimes * numPrimes; i++) {\n        if (candidateResults[i] != 0L)\n            result[numResults++] = candidateResults[i];\n    }\n    quicksort(result, 0, numResults - 1);\n    for (i = 0; i < numResults; i++)\n        printf(\"%ld\\n\", result[i]);\n    return 0;\n}\n",
      "path": "src/sources/primetest.c"
    }
  ],
  "hypothesis": "For larger fragment counts, statically distributing the independent concatenation primality tests across OpenMP workers should reduce wall time; small inputs should avoid parallel-region overhead by remaining serial.",

    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <iostream>\\n#include <vector>\\n#include <cstdio>\\n#include <cassert>\\n#include <algorithm>\\n#include <climits>\\n#include <cstdint>\\n#include <omp.h>\\n#include <arm_neon.h>\\n\\nint main() {\\n    int n, s;\\n    std::cin >> n >> s;\\n\\n    assert(s > 0 && s < n && n < 8000);\\n\\n    // Flatten matrix into contiguous 1D array (source A)\\n    std::vector<int> mat(n * n);\\n    for (int i = 0; i < n; ++i) {\\n        for (int j = 0; j < n; ++j) {\\n            scanf(\\\"%d\\\", &mat[i * n + j]);\\n        }\\n    }\\n\\n    // Integral image using two-pass construction (source A)\\n    const int np1 = n + 1;\\n    std::vector<long long> pref(np1 * np1, 0LL);\\n\\n    // First pass: horizontal cumulative sums per row\\n    for (int i = 0; i < n; ++i) {\\n        long long row_sum = 0;\\n        const int base_i = (i + 1) * np1;\\n        const int mat_base = i * n;\\n        for (int j = 0; j < n; ++j) {\\n            row_sum += mat[mat_base + j];\\n            pref[base_i + (j + 1)] = row_sum;\\n        }\\n    }\\n\\n    // Second pass: vertical accumulation to complete the integral image\\n    for (int i = 0; i < n; ++i) {\\n        const int base_cur = (i + 1) * np1;\\n        const int base_prev = i * np1;\\n        for (int j = 0; j < n; ++j) {\\n            pref[base_cur + (j + 1)] += pref[base_prev + (j + 1)];\\n        }\\n    }\\n\\n    // Precompute row offsets for faster access in search loop (source A)\\n    std::vector<int> row_offset(np1);\\n    for (int i = 0; i < np1; ++i) {\\n        row_offset[i] = i * np1;\\n    }\\n\\n    long long mxSum = LLONG_MIN;\\n\\n    // Parallel outer loop over rows with static scheduling (sources B and C)\\n#pragma omp parallel for schedule(static) reduction(max:mxSum)\\n    for (int i = 0; i <= n - s; ++i) {\\n        const long long *row_i_s = &pref[row_offset[i + s]];\\n        const long long *row_i   = &pref[row_offset[i]];\\n\\n       
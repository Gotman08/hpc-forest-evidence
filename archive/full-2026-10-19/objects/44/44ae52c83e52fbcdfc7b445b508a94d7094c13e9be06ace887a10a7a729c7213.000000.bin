  "files": [
    {
      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdio>\n#include <iostream>\n#include <limits>\n#include <vector>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nstruct SeedEvent {\n    int row;\n    int band;\n    bool finish;\n};\n\nint main() {\n    int n, s;\n    if (!(std::cin >> n >> s)) return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t cells = static_cast<std::size_t>(n) * n;\n    std::vector<int> matrix(cells);\n    for (std::size_t k = 0; k < cells; ++k)\n        scanf(\"%d\", &matrix[k]);\n\n    const int m = n - s + 1;\n    int requested_threads = 1;\n#ifdef _OPENMP\n    const int available = std::min(4, omp_get_max_threads());\n    if (cells >= 1024u * 1024u && available >= 4 && m >= 4)\n        requested_threads = 4;\n    else if (cells >= 256u * 1024u && available >= 2 && m >= 2)\n        requested_threads = 2;\n#endif\n\n    std::vector<long long> seeds(\n        static_cast<std::size_t>(requested_threads) * n, 0);\n    long long maximum = std::numeric_limits<long long>::lowest();\n\n#ifdef _OPENMP\n#pragma omp parallel num_threads(requested_threads) if(requested_threads > 1) reduction(max:maximum)\n#endif\n    {\n        int thread = 0;\n        int team = 1;\n#ifdef _OPENMP\n        thread = omp_get_thread_num();\n        team = omp_get_num_threads();\n#endif\n        const int first = thread * m / team;\n        const int limit = (thread + 1) * m / team;\n        const int last_start = (team - 1) * m / team;\n\n        // Cooperate when prefix seeding saves at least 20% of input reads.\n        const bool cooperative = team > 1 &&\n            4LL * team * s > 5LL * (s + last_start);\n\n        if (cooperative) {\n            const int col_first = thread * n / team;\n            const int col_limit = (thread + 1) * n / team;\n            const int width = col_limit - col_first;\n            std::vector<long long> prefix(width, 0);\n\n            SeedEvent events[8];\n            for (int t = 0; t < team; ++t) {\n                const int start = t * m / team;\n                events[2 * t] = SeedEvent{start, t, false};\n                events[2 * t + 1] = SeedEvent{start + s, t, true};\n            }\n            std::sort(events, events + 2 * team,\n                      [](const SeedEvent& a, const SeedEvent& b) {\n                          return a.row < b.row;\n                      });\n\n            // Each worker scans disjoint columns and seeds every row band.\n            int scanned = 0;\n            for (int e = 0; e < 2 * team; ++e) {\n                const SeedEvent event = events[e];\n                for (int r = scanned; r < event.row; ++r) {\n                    const int* row = matrix.data() +\n                        static_cast<std::size_t>(r) * n + col_first;\n                    for (int c = 0; c < width; ++c)\n                        prefix[c] += row[c];\n                }\n                long long* destination = seeds.data() +\n                    static_cast<std::size_t>(event.band) * n + col_first;\n                if (event.finish) {\n                    for (int c = 0; c < width; ++c)\n                        destination[c] += prefix[c];\n                } else {\n                    for (int c = 0; c < width; ++c)\n                        destination[c] = -prefix[c];\n                }\n                scanned = event.row;\n            }\n#ifdef _OPENMP\n#pragma omp barrier\n#endif\n        } else {\n            long long* columns = seeds.data() +\n                static_cast<std::size_t>(thread) * n;\n            for (int r = first; r < first + s; ++r) {\n                const int* row = matrix.data() +\n                    static_cast<std::size_t>(r) * n;\n                for (int c = 0; c < n; ++c)\n                    columns[c] += row[c];\n            }\n        }\n\n        long long* columns = seeds.data() +\n            static_cast<std::size_t>(thread) * n;\n        long long local_maximum = std::numeric_limits<long long>::lowest();\n        for (int r = first; r < limit; ++r) {\n            if (r != first) {\n                const int* leaving = matrix.data() +\n                    static_cast<std::size_t>(r - 1) * n;\n                const int* entering = matrix.data() +\n                    static_cast<std::size_t>(r + s - 1) * n;\n                for (int c = 0; c < n; ++c)\n                    columns[c] += static_cast<long long>(entering[c]) - leaving[c];\n            }\n\n            long long sum = 0;\n            for (int c = 0; c < s; ++c)\n                sum += columns[c];\n            local_maximum = std::max(local_maximum, sum);\n            for (int c = s; c < n; ++c) {\n                sum += columns[c] - columns[c - s];\n                local_maximum = std::max(local_maximum, sum);\n            }\n        }\n        maximum = std::max(maximum, local_maximum);\n    }\n\n    printf(\"%lld\\n\", maximum);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Cooperatively seeding overlapping row bands through column-partitioned prefix scans should reduce duplicated initialization while retaining independent rolling scans and a single OpenMP maximum reduction.",
  "notes": "Input parsing is preserved. Thread thresholds are provisional; no commands, builds or measurements were performed. OpenMP is used only when enabled by the unchanged build, otherwise execution is serial.",
  "sources_kept": [],

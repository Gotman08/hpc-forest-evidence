atches = 1;\\n+        const int mapped_i = equivalence[i];\\n+        #pragma omp simd reduction(&:row_matches)\\n         for (int j = 0; j <= i; ++j) {\\n-            if(g1[i][j] != g2[equivalence[i]][equivalence[j]]) return false;\\n+            row_matches &= (g1[i][j] == g2[mapped_i][equivalence[j]]);\\n         }\\n+        if (!row_matches) return false;\\n     }\\n    return true;\\n }\"}, {\"id\": \"45dc7e3e4ea841d3\", \"role\": \"B\", \"commit\": \"fb722288cfbba94039a02401840de379e4741bb4\", \"transformations\": {\"files\": [\"src/brute_isomorphism.cpp\"], \"retained\": [\"Compute each adjacency-row degree once with an independent SIMD reduction, only after the existing identity fast path fails.\", \"Compare sorted degree multisets before permutation traversal to reject graph pairs that cannot be isomorphic.\", \"Use a legal bitwise SIMD reduction over mapped vertex degrees to skip permutations that cannot be isomorphisms before the existing adjacency verifier.\"]}, \"mean_seconds\": 0.007806888781487942, \"diff\": \"diff --git a/src/brute_isomorphism.cpp b/src/brute_isomorphism.cpp\\nindex 9245dc0..721013b 100644\\n--- a/src/brute_isomorphism.cpp\\n+++ b/src/brute_isomorphism.cpp\\n@@ -1,13 +1,16 @@\\n+#include <algorithm>\\n #include <iostream>\\n #include <vector>\\n #include <utility>\\n \\n using namespace std;\\n \\n-typedef vector<vector<bool>> adjacency_matrix;\\n+typedef vector<vector<unsigned char>> adjacency_matrix;\\n \\n adjacency_matrix readGraph();\\n-\\n+vector<int> vertexDegrees(const adjacency_matrix &graph);\\n+bool degreeCompatible(const vector<int> &degrees1, const vector<int> &degrees2,\\n+                      const vector<int> &equivalence);\\n bool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\\n bool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence);\\n inline void printPermutation(vector<int> &equivalence);\\n@@ -37,6 +40,15 @@ bool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\\n         printPermutation(equivalence);\\n         return true;\\n     }\\n+\\n+    // Vertex degree multisets are invariant under any graph isomorphism.\\n+    const vector<int> degrees1 = vertexDegrees(g1);\\n+    const vector<int> degrees2 = vertexDegrees(g2);\\n+    vector<int> sorted_degrees1 = degrees1;\\n+    vector<int> sorted_degrees2 = degrees2;\\n+    sort(sorted_degrees1.begin(), sorted_degrees1.end());\\n+    sort(sorted_degrees2.begin(), sorted_degrees2.end());\\n+    if(sorted_degrees1 != sorted_degrees2) return false;\\n     \\n     /*\\n      * Permutations are based on Heap's algorithm, which generates all possible \\n@@ -48,7 +60,8 @@ bool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\\n                 swap(equivalence[0], equivalence[exchange_index]);\\n             else\\n                 swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\\n-            if(verifyPermutation(g1, g2, equivalence)){\\n+            if(degreeCompatible(degrees1, degrees2, equivalence) &&\\n+               verifyPermutation(g1, g2, equivalence)){\\n                 printPermutation(equivalence);\\n                 isomorphism_found = true;\\n             }\\n@@ -67,24 +80,49 @@ adjacency_matrix readGraph(){\\n     int vertices, edges, source, destination;\\n \\n     cin >> vertices;\\n-    adjacency_matrix read(vertices);\\n-    for (int i = 0; i < vertices; ++i)\\n-        read[i].resize(vertices);\\n+    adjacency_matrix read(vertices, vector<unsigned char>(vertices, 0));\\n     \\n     cin >> edges;    \\n     for (int i = 0; i < edges; i++) {\\n        cin >> source >> destination;\\n-       read[destination][source] = read[source][destination] = true; \\n+       read[destination][source] = read[source][destination] = 1; \\n     }\\n \\n     return read;\\n }\\n \\n+vector<int> vertexDegrees(const adjacency_matrix &graph){\\n+    const int n = static_cast<int>(graph.size());\\n+    vector<int> degrees(n, 0);\\n+    for(int i = 0; i < n; ++i){\\n+        int degree = 0;\\n+        #pragma omp simd reduction(+:degree)\\n+        for(int j = 0; j < n; ++j)\\n+            degree += graph[i][j];\\n+        degrees[i] = degree;\\n+    }\\n+    return degrees;\\n+}\\n+\\n+bool degreeCompatible(const vector<int> &degrees1, const vector<int> &degrees2,\\n+                      const vector<int> &equivalence){\\n+    const int n = static_cast<int>(equivalence.size());\\n+    int compatible = 1;\\n+    #pragma omp simd reduction(&:compatible)\\n+    for(int i = 0; i < n; ++i)\\n+        compatible &= (degrees1[i] == degrees2[equivalence[i]]);\\n+    return compatible != 0;\\n+}\\n+\\n bool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence){\\n     for (int i = 0; i < equivalence.size(); ++i) {\\n+        int row_matches = 1;\\n+        const int mapped_i = equivalence[i];\\n+        #pragma omp simd reduction(&:row_matches)\\n         for (int j = 0; j <= i; ++j) {\\n-            if(g1[i][j] != g2[equivalence[i]][equivalence[j]]) return false;\\n+            row_matches &= (g1[i][j] == g2[mapped_i][equivalence[j]]);\\n         }\\n+        if (!row_matches) return false;\\n     }\\n    return true;\\n }\"}, {\"id\": \"9bd09382f9094cf0\", \"role\": \"C\", \"commit\": \"c6072924faaa3544b5baa23cc41538573a2f5856\", \"transformations\": {\"files\": [\"src/brute_isomorphism.cpp\"], \"retained\": [\"Keep permutation generation sequential in the existing Heap order, buffer candidates in bounded batches, and verify independent candidates with an OpenMP static parallel-for.\", \"Precompute adjacency-row degree counts and reject mappings with mismatched degrees before performing the exact adjacency comparison.\", \"Emit matches serially in candidate order and retain the original sequential path for graphs with fewer than nine vertices.\"]}, \"mean_seconds\": 0.009511638743182024, \"diff\": \"diff --git a/src/brute_isomorphism.cpp b/src/brute_isomorphism.cpp\\nindex 9245dc0..77333d3 100644\\n--- a/src/brute_isomorphism.cpp\\n+++ b/src/brute_isomorphism.cpp\\n@@ -1,3 +1,5 @@\\n+#include <algorithm>\\n+#include <cstddef>\\n #include <iostream>\\n #include <vector>\\n #include <utility>\\n@@ -10,6 +12,11 @@ adjacency_matrix readGraph();\\n \\n bool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\\n bool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence);\\n+bool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, const int *equivalence);\\n+bool verifyPermutationWithDegrees(adjacency_matrix &g1, adjacency_matrix &g2,\\n+                                  const int *equivalence,\\n+                                  const vector<int> &degree1,\\n+                                  const vector<int> &degree2);\\n inline void printPermutation(vector<int> &equivalence);\\n \\n int main(){\\n@@ -23,35 +30,99 @@ int main(){\\n }\\n \\n bool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\\n+    if(g1.size() != g2.size()) return false;\\n+\\n     vector<int> equivalence(g1.size(), 0);\\n     vector<int> exchange_counter(g1.size(), 0);\\n     int exchange_index = 1;\\n     bool isomorphism_found = false;\\n \\n-    if(g1.size() != g2.size()) return false;\\n-\\n-    for(int i = 0; i < equivalence.size(); ++i)\\n+    for(int i = 0; i < static_cast<int>(equivalence.size()); ++i)\\n         equivalence[i] = i;\\n \\n     if(verifyPermutation(g1, g2, equivalence)){\\n         printPermutation(equivalence);\\n         return true;\\n     }\\n-    \\n-    /*\\n-     * Permutations are based on Heap's algorithm, which generates all possible \\n-     * permutations for a given set of elements. \\n-     */\\n-    while(exchange_index < g1.size()){\\n+\\n+    // Keep the low-work cases serial to avoid parallel-region overhead.\\n+    if(g1.size() < 9){\\n+        while(exchange_index < static_cast<int>(g1.size())){\\n+            if(exchange_counter[exchange_index] < exchange_index){\\n+                if(exchange_index % 2 == 0)\\n+                    swap(equivalence[0], equivalence[exchange_index]);\\n+                else\\n+                    swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\\n+                if(verifyPermutation(g1, g2, equivalence)){\\n+                    printPermutation(equivalence);\\n+                    isomorphism_found = true;\\n+                }\\n+\\n+                exchange_counter[exchange_index]++;\\n+                exchange_index = 1;\\n+            }else{\\n+                exchange_counter[exchange_index] = 0;\\n+                exchange_index++;\\n+            }\\n+        }\\n+        return isomorphism_found;\\n+    }\\n+\\n+    const int vertex_count = static_cast<int>(g1.size());\\n+    vector<int> degree1(vertex_count, 0);\\n+    vector<int> degree2(vertex_count, 0);\\n+    for(int i = 0; i < vertex_count; ++i){\\n+        for(int j = 0; j < vertex_count; ++j){\\n+            degree1[i] += g1[i][j] ? 1 : 0;\\n+            degree2[i] += g2[i][j] ? 1 : 0;\\n+        }\\n+    }\\n+\\n+    // Generate permutations in the original Heap order, then verify each batch\\n+    // concurrently and emit matches serially to preserve exact output ordering.\\n+    const int batch_capacity = 8192;\\n+    vector<int> candidates(static_cast<size_t>(batch_capacity) * vertex_count);\\n+    vector<unsigned char> matches(batch_capacity, 0);\\n+    int candidate_count = 0;\\n+\\n+    auto process_batch = [&](int count){\\n+        if(count >= 256){\\n+            #pragma omp parallel for schedule(static)\\n+            for(int k = 0; k < count; ++k){\\n+                const int *candidate = candidates.data() + static_cast<size_t>(k) * vertex_count;\\n+                matches[k] = verifyPermutationWithDegrees(g1, g2, candidate, degree1, degree2);\\n+            }\\n+        }else{\\n+            for(int k = 0; k < count; ++k){\\n+                const int *candidate = candidates.data() + static_cast<size_t>(k) * vertex_count;\\n+                matches[k] = verifyPermutationWithDegrees(g1, g2, candidate, degree1, degree2);\\n+            }\\n+        }\\n+\\n+        for(int k = 0; k < count; ++k){\\n+            if(matches[k]){\\n+                const int *candidate = candidates.data() + static_cast<size_t>(k) * vertex_count;\\n+                for(int i = 0; i < vertex_count; ++i)\\n+                    cout << candidate[i] << \\\" \\\";\\n+                cout << endl;\\n+                isomorphism_found = true;\\n+            }\\n+        }\\n+        candidate_count = 0;\\n+    };\\n+\\n+    while(exchange_index < vertex_count){\\n         if(exchange_counter[exchange_index] < exchange_index){\\n             if(exchange_index % 2 == 0)\\n                 swap(equivalence[0], equivalence[exchange_index]);\\n             else\\n                 swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\\n-            if(verifyPermutation(g1, g2, equivalence)){\\n-                printPermutation(equivalence);\\n-                isomorphism_found = true;\\n-            }\\n+\\n+            int *candidate = candidates.data() + static_cast<size_t>(candidate_count) * vertex_count;\\n+            copy(equivalence.begin(), equivalence.end(), candidate);\\n+            ++candidate_count;\\n+            if(candidate_count == batch_capacity)\\n+                process_batch(candidate_count);\\n \\n             exchange_counter[exchange_index]++;\\n             exchange_index = 1;\\n@@ -60,7 +131,11 @@ bool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\\n             exchange_index++;\\n         }\\n     }\\n-    return isomorphism_found; \\n+\\n+    if(candidate_count > 0)\\n+        process_batch(candidate_count);\\n+\\n+    return isomorphism_found;\\n }\\n \\n adjacency_matrix readGraph(){\\n@@ -70,23 +145,37 @@ adjacency_matrix readGraph(){\\n     adjacency_matrix read(vertices);\\n     for (int i = 0; i < vertices; ++i)\\n         read[i].resize(vertices);\\n-    \\n-    cin >> edges;    \\n+\\n+    cin >> edges;\\n     for (int i = 0; i < edges; i++) {\\n        cin >> source >> destination;\\n-       read[destination][source] = read[source][des\"}, {\"id\": \"4d99b0f1c532433d\", \"role\": \"C\", \"commit\": \"4919e103f26432f2aecebfe0720562fa21e53e97\", \"transformations\": {\"files\": [\"src/brute_isomorphism.cpp\"], \"retained\": [\"Replace vector<bool> rows with a contiguous byte adjacency matrix.\", \"Generate Heap permutations in bounded batches and verify candidates using one persistent OpenMP team with schedule(dynamic, 4), enabled only for n >= 24.\", \"Emit successful permutations serially in original candidate order.\"]}, \"mean_seconds\": 0.013076856111486753, \"diff\": \"diff --git a/src/brute_isomorphism.cpp b/src/brute_isomorphism.cpp\\nindex 9245dc0..62ee0b7 100644\\n--- a/src/brute_isomorphism.cpp\\n+++ b/src/brute_isomorphism.cpp\\n@@ -4,93 +4,152 @@\\n \\n using namespace std;\\n \\n-typedef vector<vector<bool>> adjacency_matrix;\\n+class adjacency_matrix {\\n+public:\\n+    explicit adjacency_matrix(size_t vertices = 0)\\n+        : vertices_(vertices), values_(vertices * vertices, 0) {}\\n \\n-adjacency_matrix readGraph();\\n+    size_t size() const { return vertices_; }\\n+\\n+    unsigned char *operator[](size_t row) {\\n+        return values_.data() + row * vertices_;\\n+    }\\n+\\n+    const unsigned char *operator[](size_t row) const {\\n+        return values_.data() + row * vertices_;\\n+    }\\n+\\n+private:\\n+    size_t vertices_;\\n+    vector<unsigned char> values_;\\n+};\\n \\n-bool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\\n-bool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence);\\n-inline void printPermutation(vector<int> &equivalence);\\n+adjacency_matrix readGraph();\\n+bool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2);\\n+bool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\\n+                       const int *equivalence, int n);\\n+inline void printPermutation(const int *equivalence, int n);\\n \\n-int main(){\\n+int main() {\\n     adjacency_matrix g1 = readGraph();\\n     adjacency_matrix g2 = readGraph();\\n \\n-    if(!testIsomorphism(g1, g2))\\n+    if (!testIsomorphism(g1, g2))\\n         cout << \\\"The graphs are not isomorphic\\\" << endl;\\n \\n     return 0;\\n }\\n \\n-bool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\\n-    vector<int> equivalence(g1.size(), 0);\\n-    vector<int> exchange_counter(g1.size(), 0);\\n+bool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2) {\\n+    if (g1.size() != g2.size()) return false;\\n+\\n+    const int n = static_cast<int>(g1.size());\\n+    vector<int> equivalence(n, 0);\\n+    vector<int> exchange_counter(n, 0);\\n     int exchange_index = 1;\\n     bool isomorphism_found = false;\\n \\n-    if(g1.size() != g2.size()) return false;\\n-\\n-    for(int i = 0; i < equivalence.size(); ++i)\\n+    for (int i = 0; i < n; ++i)\\n         equivalence[i] = i;\\n \\n-    if(verifyPermutation(g1, g2, equivalence)){\\n-        printPermutation(equivalence);\\n+    if (verifyPermutation(g1, g2, equivalence.data(), n)) {\\n+        printPermutation(equivalence.data(), n);\\n         return true;\\n     }\\n-    \\n-    /*\\n-     * Permutations are based on Heap's algorithm, which generates all possible \\n-     * permutations for a given set of elements. \\n-     */\\n-    while(exchange_index < g1.size()){\\n-        if(exchange_counter[exchange_index] < exchange_index){\\n-            if(exchange_index % 2 == 0)\\n-                swap(equivalence[0], equivalence[exchange_index]);\\n-            else\\n-                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\\n-            if(verifyPermutation(g1, g2, equivalence)){\\n-                printPermutation(equivalence);\\n-                isomorphism_found = true;\\n+\\n+    // Keep a single team alive while Heap's algorithm produces bounded batches.\\n+    // Dynamic chunks balance candidates whose early-exit verification costs vary.\\n+    const int batch_capacity = 64;\\n+    vector<int> batch(static_cast<size_t>(batch_capacity) * n);\\n+    vector<unsigned char> matches;\\n+    int batch_count = 0;\\n+    bool done = false;\\n+\\n+    #pragma omp parallel if(n >= 24)\\n+    {\\n+        while (true) {\\n+            #pragma omp single\\n+            {\\n+                batch_count = 0;\\n+                while (batch_count < batch_capacity && exchange_index < n) {\\n+                    if (exchange_counter[exchange_index] < exchange_index) {\\n+                        if (exchange_index % 2 == 0)\\n+                            swap(equivalence[0], equivalence[exchange_index]);\\n+                        else\\n+                            swap(equivalence[exchange_counter[exchange_index]],\\n+                                 equivalence[exchange_index]);\\n+\\n+                        int *candidate = batch.data() +\\n+                                         static_cast<size_t>(batch_count) * n;\\n+                        for (int i = 0; i < n; ++i)\\n+                            candidate[i] = equivalence[i];\\n+\\n+                        ++batch_count;\\n+                        ++exchange_counter[exchange_index];\\n+                        exchange_index = 1;\\n+                    } else {\\n+                        exchange_counter[exchange_index] = 0;\\n+                        ++exchange_index;\\n+                    }\\n+                }\\n+                done = (batch_count == 0);\\n+                matches.resize(batch_count);\\n+            }\\n+\\n+            if (done) break;\\n+\\n+            #pragma omp for schedule(dynamic, 4)\\n+            for (int k = 0; k < batch_count; ++k) {\\n+                const int *candidate = batch.data() +\\n+                                       static_cast<size_t>(k) * n;\\n+                matches[k] = static_cast<unsigned char>(\\n+                    verifyPermutation(g1, g2, candidate, n));\\n             }\\n \\n-            exchange_counter[exchange_index]++;\\n-            exchange_index = 1;\\n-        }else{\\n-            exchange_counter[exchange_index] = 0;\\n-            exchange_index++;\\n+            #pragma omp single\\n+            {\\n+                for (int k = 0; k < batch_count; ++k) {\\n+                    if (matches[k]) {\\n+                        const int *candidate = batch.data() +\\n+                                               static_cast<size_t>(k) * n;\\n+                        printPermutation(candidate, n);\\n+                        isomorphism_found = true;\\n+                    }\\n+                }\\n+            }\\n         }\\n     }\\n-    return isomorphism_found; \\n+\\n+    return isomorphism_found;\\n }\\n \\n-adjacency_matrix readGraph(){\\n+adjacency_matrix readGraph() {\\n     int vertices, edges, source, destination;\\n \\n     cin >> vertices;\\n-    adjacency_matri\"}], \"interactions\": [], \"automatic_observations\": {\"baseline\": {\"experiment_id\": \"baseline-e1\", \"outcome\": {\"binary_sha256\": \"ccfdbd9ee556a6e56342f5512a634e4e18bbeaa976d973e4271e2ccc71186c89\", \"cache_key\": \"bd7c99c2985b33e2b7293e46495f396b1c6beeecf0e15f2ce97c953cf015b073\", \"commit\": \"5ab7b800788a4d9ffe1150a3bdf4bf06fb71d054\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-xhigh/results-749940/2021-graph/logs/e1/baseline-e1/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-xhigh/results-749940/2021-graph/logs/e1/baseline-e1/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-xhigh/results-749940/2021-graph/logs/e1/baseline-e1/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-xhigh/results-749940/2021-graph/logs/e1/baseline-e1/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-xhigh/results-749940/2021-graph/logs/e1/baseline-e1/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-xhigh/results-749940/2021-graph/logs/e1/baseline-e1/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.00841449573636055, \"reason\": \"\", \"score\": 0.5, \"status\": \"valid\", \"times\": [0.008341452106833458, 0.00834730826318264, 0.008554726839065552], \"tree_hash\": \"5e03da0259d58641b897bc80ad27b31dc30b3fd8\"}, \"raw_logs\": [{\"path\": \"logs/e1/baseline-e1/search/attempt-001/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": true, \"cases\": 4}}]}, \"selected_parent\": null, \"selected_base_commit\": \"5ab7b800788a4d9ffe1150a3bdf4bf06fb71d054\", \"recent_own_role\": [], \"own_role_history\": [], \"node_development\": {\"attempt\": 1, \"remaining_attempts\": 3, \"previous_attempts\": [], \"confirmation_data_available\": false}}, \"documents_as_data\": [], \"deadline\": 1792214159.4393451, \"generation_deadline\": 1792214159.4393451, \"protocol_id\": \"0f01710b338813c86d267440e1b97b35b879c0d136082a0d6ba61bc851edb412\", \"remaining_tokens\": 589824, \"official_statement_as_data\": \"16th Marathon of Parallel Programming\\nSBAC-PAD & WSCAD – 2021\\nCalebe Bianchini1 and Maur´ıcio Aronne Pillon2\\n1Mackenzie Presbyterian University\\n2Santa Catarina State University\\nRules for Remote Contest\\nFor all problems, read carefully the input and output session. For all problems, a sequen-\\ntial implementation is given, and it is against the output of those implementations that the\\noutput of your programs will be compared to decide if your implementation is correct.\\nYou can modify the program in any way you see ﬁt, except when the problem descrip-\\ntion states otherwise. You must upload a compressed ﬁle (zip) with your source code, the\\nMakeﬁle and an execution script. The script must have the name of the problem. You\\ncan submit as many solutions to a problem as you want. Only the last submission will\\nbe considered. The Makeﬁle must have the rule all, which will be used to compile your\\nsource code. The execution script runs your solution the way you design it – it will be\\ninspected not to corrupt the target machine.\\nThe execution time of your program will be measured running it with time program and\\ntaking the real CPU time given. Each program will be executed at least three times with\\nthe same input and the mean time will be taken into account. The sequential program\\ngiven will be measured the same way. You will earn points in each problem, correspond-\\ning to the division of the sequential time by the time of your program (speedup). The\\nteam with the most points at the end of the marathon will be declared the winner.\\nThis problem set contains 5 problems; pages are numbered from 1 to 9.\\n\\nGeneral Information\\nCompilation\\nYou should use CC or CXX inside your Makeﬁle. Be careful when redeﬁning them!\\nThere is a simple Makeﬁle inside you problem package that you can modify. Example:\\nFLAGS=-O3\\nEXEC=sum\\nCXX=icpc\\nall: $(EXEC)\\n$(EXEC):\\n$(CXX) $(FLAGS) $(EXEC).cpp -c -o $(EXEC).o\\n$(CXX) $(FLAGS) $(EXEC).o -o $(EXEC)\\nEach judge machine has its group of compilers. See them below and choose well when\\nwriting your Makeﬁle. The compiler that is tagged as default is predeﬁned in CC and\\nCXX variables.\\nmachine compiler command\\nhost\\nGCC 10.2.11\\n(default)\\nC = gcc\\nC++ = g++\\nIntel C/C++ Compiler 19.1.3.304 C = icc\\nC++ = icpc\\nMPI\\nIntel MPI Compiler 2019u12\\n(default)\\nC = mpiicc\\nC++ = mpiicpc\\nIntel C/C++ Compiler 19.1.3.304 C = icc\\nC++ = icpc\\nGCC 10.2.11 C = gcc\\nC++ = g++\\ngpu\\nNVidia CUDA 11.2\\n(default)\\nC = nvcc\\nC++ = nvcc\\nGCC 8.3.1 C = gcc\\nC++ = g++\\nSubmitting\\nGeneral information\\nYou must have an execution script that has the same name of the problem. This script runs\\nyour solution the way you design it. There is a simple script inside you problem package\\nthat should be modiﬁed. Example:\\n#!/bin/bash\\n# This script runs a generic Problem A\\n# Using 32 threads and OpenMP\\nexport OMP_NUM_THREADS=32\\nOMP_NUM_THREADS=32 ./sum\\n\\nSubmitting MPI\\nIf you are planning to submit an MPI solution, you should compile usingmpiicc/mpiicpc.\\nThe script must call mpirun/mpiexec with the correct number of processes (max: 4). It\\nmust use a ﬁle called machines that are generated by the auto-judge system - do not\\ncreate it.\\n#!/bin/bash\\n# This script runs a generic Problem A\\n# Using MPI in the entire cluster (4 nodes)\\n# 'machines' file describes the nodes\\nmpirun -np 4 -machinefile machines ./sum\\nComparing times & results\\nIn your personal machine, measure the execution time of your solution using time pro-\\ngram. Add input/output redirection when collecting time. Use diff program to compare\\nthe original and your solution results. Example:\\n$ time -p ./A < original_input.txt > my_output.txt\\nreal 4.94\\nuser 0.08\\nsys 1.56\\n$ diff my_output.txt original_output.txt\\nDo not measure time and do not add input/output redirection when submitting your so-\\nlution - the auto-judge system is prepared to collect your time and compare the results.\\n\\nProblem A\\nGraph Isomorphism Detection\\nProblem deﬁnition\\nGiven two graphs G(V, E) and H(V, E), where V denotes the vertices and E the edges,\\nthe problem of ﬁnding isomorphic graphs consists of determining a bijection function\\nf : V (G)→ V (H) that maps the vertices of both graphs while preserving the adjacency\\ncondition. In other words, for the isomorphism property to exist, if any two vertices\\nu, v ∈ G are adjacent then the corresponding vertices f (u), f(v) ∈ H must also be\\nadjacent. In this sense, the proposed algorithm detects isomorphic undirected graphs\\nthrough extensive permutations, comparing all possible vertex correspondences between\\nG and H.\\nInput\\nAn input represents only a test case. Initially, the graph G is informed followed by H.\\nThe ﬁrst line contains an integerVg (0 < V g < 100) representing the number of vertices in\\nG, while the second line informs an integerEg (0≤ Eg < (Vg∗ (Vg− 1))/2) denoting the\\nnumber of edges in G. Following, Eg edges are sequentially informed, each denoted by\\ntwo integers u, v∈ Vg. The next lines repeat the same rationale for informing the graph\\nH: an integer Vh (0 < V h < 100) representing the number of vertices in H is followed by\\nan integer Eh (0≤ Eh < (Vh∗ (Vh− 1))/2) denoting the number of edges in H. Finally,\\nEh edges are sequentially informed, each denoted by two integers u, v∈ Vh.\\nThe input must be read form the standard input.\\nOutput\\nThe output contains a single line. If G and H are not isomorphic graphs, the message The\\ngraphs are not isomorphicis printed to the output. Otherwise, a stream of integersv∈ Vh\\npresents a vertex correspondence between G and H, such that f (u) = v, with u∈ Vg\\nequal to the position of each v on the stream.\\nThe output must be written to the standard output.\\n1\\n\\nExample\\nInput example Output example\\n4 The graphs are not isomorphic\\n6\\n0 3\\n1 1\\n1 3\\n2 2\\n2 3\\n3 3\\n4\\n6\\n0 0\\n0 1\\n0 2\\n1 1\\n1 3\\n3 3\\n2\\n\\nProblem B\\nDescriptive Statistics Metrics\\nA researcher has a set of samples grouped in matrices, where each column represents a\\nsample. The researcher needs to calculate the following values for each sample (column):\\narithmetic mean, harmonic mean, median, mode, sample variance, standard deviation and\\ncoefﬁcient of variation. Each value can be set as follows:\\n• Arithmetic mean: Sum of all elements in the sample, divided by the sample size\\n(sum of the rows in the matrix column divided by the number of rows).\\n• Harmonic mean: Ratio between the sample size and the sum of the inverse of the\\nsamples.\\n• Median: Average element of the sample (average element of the ordered column).\\nFor an even number of elements, the median is the mean between the elements in\\nthe middle (\\n( n\\n2 + n\\n2+1 )\\n2 ).\\n• Mode: Most frequent number of the sample (the element that most appears in the\\ncolumn; if there is more than one, only the ﬁrst is considered. If not, it returns -1).\\n• Sample Variance: Sum of squares of data deviations from the mean and dividing\\nby the number of items minus one.\\n• Standard deviation: Square root of the variance.\\n• Coefﬁcient of variation:Ratio between standard deviation and arithmetic mean.\\nProblem input\\nThe input has only one test case. The ﬁrst line has the number of rows and columns of the\\nmatrix, separated by a single space. In the following lines are the elements of the matrix\\nof type double, where the lines are separated by a single line break and the columns by a\\nsingle space.\\nThe input must be read form the standard input.\\nProblem output:\\nThe output contains the calculated metrics, respectively. A single space will separate the\\ncalculated values for each column, and there will also be a single space at the end of the\\nline. Each metric starts on a new line, i.e., is separated by a single line break. Printed\\nvalues consider a single decimal place.\\nThe output must be written to the standard output.\\n3\\n\\nExample\\nInput example Output example\\n6 4 12.0 17.0 11.5 13.5\\n9 8 4 5 8.1 12.1 6.6 3.7\\n4 12 20 40 8.5 12.0 10.5 7.5\\n8 8 4 4 8.0 8.0 4.0 -1.0\\n8 12 4 21 110.0 188.4 68.7 217.9\\n33 44 20 1 10.5 13.7 8.3 14.8\\n10 18 17 10 0.9 0.8 0.7 1.1\\n4\\n\\nProblem C\\nSokoban\\nSokoban is a videogame created in 1981 by Hiroyuki Imabayashi.\\nThe board, whose dimension varies according to each stage, is divided into squares which\\ncan be one of the following elements:\\n• Empty square (that may be marked as a target)\\n• Wall\\n• Box\\n• Player\\nTo organize the boxes, the player can move in 4 directions (up, down, left, and right) and\\nalso push the boxes. The player cannot, however, pull boxes. Therefore, if a box is pushed\\nto a corner it can no longer be moved. Moreover, only a single box can be moved at the\\nsame time.\\nThe goal of the game is to solve the puzzle by placing a box over each one of the target\\nsquares. The secondary objective is to solve the puzzle in the least number of movements\\npossible.\\nInput\\nThe input contains a single puzzle stage to be solved. The input follows the format below\\nin which each character represents a square of the board:\\n• Empty squares are represented by spaces\\n• # represents a wall\\n• $ indicates the presence of a box\\n• . is a target square\\n• * is a box over a target square\\n• @ is the player\\n• + is a target square\\nThe input must be read from the standard input.\\nOutput\\nThe output of your program is the sequence of movements made by the player to solve\\nthe puzzle. The output format is the following:\\n• u - up\\n• d - down\\n• l - left\\n• r - right\\n• U - up, pushing a box\\n• D - down, pushing a box\\n• L - left, pushing a box\\n5\\n\\n• R - right, pushing a box\\nThe solution length must be the shortest possible. Since there might be more than one\\npossible solution of the same length for the same input, only the ﬁrst solution ordered by\\nthe movements of the player (considering the order up, down, left, and then right) must\\nbe shown. For instance, if the result of the sequencesdll and lld is the same, then dll\\nis preferred.\\nThe output must be written to the standard output.\\nExample\\nInput Output\\n####### ulULLulDDurrrddlULrruLLrrUruLLLulD\\n# #\\n# #\\n#. # #\\n#. $$ #\\n#.$$ #\\n#.# @#\\n#######\\n6\\n\\nProblem D\\nJohnson’s Algorithm for SSSP\\nLet G = ( V ; E; w) a weighted directed graph with non-negative weights, where V =\\nv1, v2, . . . , vn denote the vertices, E = e1, e2, . . . , em denotes the edges and w denotes the\\nweight function w : E− →R which connects the different vertices in the graph with only\\npositive integer. The problem of single-source shortest paths (SSSP) consists of ﬁnding\\nthe shortest paths from a source vertex v∈ V to all other vertices in V .\\nDijkstra’s algorithm can solve the SSSP problem, however when the number of edges is\\nmuch less than the possible number of edges or mathematically |E|≪ V 2, Johnson’s\\nalgorithm obtains better results. Johnson’s Algorithm updates a heap structure while the\\nnumber of visited vertices is increased, this technique is known as “reweighting”. With\\nnon-negative weights the Jhonson algorithm is solve in three steps:\\n1. Add a new node x to the graph and connect this node with zero-weight edges to\\nall other nodes.\\n2. The edges of the original graph are reweighted, i.e. the weight function is updated.\\nFor each edge (u, v), assign the new weight as “original weight + h[u] – h[v]”.\\n3. Finally, x is removed, and Dijkstra’s algorithm is used to ﬁnd the shortest paths\\nfrom the node v = 0 to other vertices in the reweighted graph.\\nInput\\nThe input has only one test case. The input has tree lines: ﬁrst line is the number of\\nvertices, second is the number of edges and the third is the mean Single-Source Shortest\\nPaths using the vertex 0 as source for all the executions. The edges between the vertices\\nare created using random functions with range 1≤ E≤ 10 or [1, 10]. The seed of the\\nrandom number generator is set to generate reproducible cases for the same case size.\\nThe input must be read from the standard input.\\nOutput\\nThe output a message with a single ﬂoat number. The ﬂoat number is the mean of the\\nSingle-Source Shortest Paths using the vertex 0 as source.\\nThe output must be written to the standard output.\\nExample\\nInput Output\\n20 Mean SSSP = 4.9000\\n100\\n4.9000\\n7\\n\\nProblem E\\nJacobi Iterative Method that Solves the\\nLaplace Equation\\nThe code implements a Jacobi iterative method that solves the Laplace equation for heat\\ntransfer. The Jacobi iterative method is a means for iteratively calculating the solution to a\\ndifferential equation by continuously reﬁning the solution until the answer has converged\\nupon a stable solution or some ﬁxed number of steps have completed and the answer is\\neither deemed good enough or unconverged. The example code represents a 2D plane\\nof material that has been divided into a grid of equally sized cells. As heat is applied\\nto the center of this plane, the Laplace equation dictates how the heat will transfer from\\ngrid point to grid point over time. To calculate the temperature of a given grid point\\nfor the next time iteration, one simply calculates the average of the temperatures of the\\nneighboring grid points from the current iteration. Once the next value for each grid point\\nis calculated, those values become the current temperature and the calculation continues.\\nAt each step the maximum temperature change across all grid points will determine if the\\nproblem has converged upon a steady state.\\nThe Figure E.1 below shows the result of applying the algorithm on a surface represented\\nby a 512 x 512 matrix with 10000 steps.\\nInput\\nThe input consist of two values: the size of the square matrix that will be generated; and\\nthe maximum number of steps.\\nThe input must be read from the standard input.\\nOutput\\nThe output is a matrix that represents heat transferred from one point on the grid to another\\nover time.\\nThe output must be written to the standard output.\\n8\\n\\nFigure E.1. 512 x 512 heated surface.\\nExample\\nInput Output\\n7 100 0.000000 0.000000 0.000000 0.000000 0.000000\\n0.000000 0.000000\\n0.000000 0.000003 0.000000 0.000006 0.000000\\n0.000003 0.000000\\n0.000000 0.000000 0.000009 0.000000 0.000009\\n0.000000 0.000000\\n0.000000 0.000006 0.000000 0.000013 0.000000\\n0.000006 0.000000\\n0.000000 0.000000 0.000009 0.000000 0.000009\\n0.000000 0.000000\\n0.000000 0.000003 0.000000 0.000006 0.000000\\n0.000003 0.000000\\n0.000000 0.000000 0.000000 0.000000 0.000000\\n0.000000 0.000000\\n9\", \"runtime_as_data\": {\"cpu_cores\": 4, \"OMP_NUM_THREADS\": 4, \"architecture\": \"ARM64\", \"candidate_GPU\": false, \"comparison\": \"Exact output bytes against official reference\"}, \"mother_model_as_data\": {\"phase\": \"synthesis\", \"status\": \"complete\", \"guidance\": \"Use A’s contiguous-byte candidate (0.00687 s) as the current measured integration starting point, not as a guaranteed final winner. Integrate tree-produced changes one at a time, then measure combinations because gains may not add. Validate correctness and output ordering on the full allowed inputs; retain only measured, correct improvements. Do not alter tests, oracle, compiler, budgets, target, permissions, or source outside the assigned integration work.\", \"analysis\": \"The baseline mean is 0.00841 s. The strongest observed result is A’s contiguous row-major byte matrix with cached row pointers at 0.00687 s. Other measured candidates—packed bits (0.00742 s), SIMD (0.00767 s), and degree filtering (0.00781 s)—beat baseline but not that result. Both OpenMP batching candidates regressed. Guidance therefore centers on the measured layout, carefully measured exact filters, and avoiding unproven parallel overhead. The source’s identity shortcut and permutation emission behavior should remain intact unless correctness validation establishes otherwise.\", \"origin\": \"model output from this fresh run; no operator analysis\"}, \"node_research\": {\"enabled\": true, \"corpus_documents\": 0, \"allowed_hosts\": [\"gcc.gnu.org\", \"www.openmp.org\", \"raw.githubusercontent.com\"], \"max_queries_per_action\": 2, \"max_urls_per_action\": 2, \"max_excerpt_characters\": 6000, \"arbitrary_commands\": false, \"general_web_search\": false}}, \"required_json_schema\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"hypothesis\": {\"type\": \"string\"}, \"transformations\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"sources_kept\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"enum\": [\"b9cee6d222824970\", \"0ca33e5452d140cb\", \"f8c35db1bcd447ca\", \"45dc7e3e4ea841d3\", \"9bd09382f9094cf0\", \"4d99b0f1c532433d\"]}, \"uniqueItems\": true}, \"files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"path\": {\"type\": \"string\"}, \"content\": {\"type\": \"string\"}}, \"required\": [\"path\", \"content\"]}}, \"notes\": {\"type\": \"string\"}, \"research\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"queries\": {\"type\": \"array\", \"maxItems\": 2, \"items\": {\"type\": \"string\", \"minLength\": 1, \"maxLength\": 300}}, \"urls\": {\"type\": \"array\", \"maxItems\": 2, \"items\": {\"type\": \"string\", \"minLength\": 1, \"maxLength\": 2000}}}, \"required\": [\"queries\", \"urls\"]}}, \"required\": [\"hypothesis\", \"transformations\", \"sources_kept\", \"files\", \"notes\", \"research\"]}}\n\nCURRENT SOURCE AS DATA:\n\n--- BEGIN FILE src/brute_isomorphism.cpp ---\n#include <iostream>\n#include <vector>\n#include <utility>\n\nusing namespace std;\n\ntypedef vector<vector<bool>> adjacency_matrix;\n\nadjacency_matrix readGraph();\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence);\ninline void printPermutation(vector<int> &equivalence);\n\nint main(){\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if(!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\n    vector<int> equivalence(g1.size(), 0);\n    vector<int> exchange_counter(g1.size(), 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    if(g1.size() != g2.size()) return false;\n\n    for(int i = 0; i < equivalence.size(); ++i)\n        equivalence[i] = i;\n\n    if(verifyPermutation(g1, g2, equivalence)){\n        printPermutation(equivalence);\n        return true;\n    }\n    \n    /*\n     * Permutations are based on Heap's algorithm, which generates all possible \n     * permutations for a given set of elements. \n     */\n    while(exchange_index < g1.size()){\n        if(exchange_counter[exchange_index] < exchange_index){\n            if(exchange_index % 2 == 0)\n                swap(equivalence[0], equivalence[exchange_index]);\n            else\n                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\n            if(verifyPermutation(g1, g2, equivalence)){\n                printPermutation(equivalence);\n                isomorphism_found = true;\n            }\n\n            exchange_counter[exchange_index]++;\n            exchange_index = 1;\n        }else{\n            exchange_counter[exchange_index] = 0;\n            exchange_index++;\n        }\n    }\n    return isomorphism_found; \n}\n\nadjacency_matrix readGraph(){\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read(vertices);\n    for (int i = 0; i < vertices; ++i)\n        read[i].resize(vertices);\n    \n    cin >> edges;    \n    for (int i = 0; i < edges; i++) {\n       cin >> source >> destination;\n       read[destination][source] = read[source][destination] = true; \n    }\n\n    return read;\n}\n\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence){\n    for (int i = 0; i < equivalence.size(); ++i) {\n        for (int j = 0; j <= i; ++j) {\n            if(g1[i][j] != g2[equivalence[i]][equivalence[j]]) return false;\n        }\n    }\n   return true;\n}\n\ninline void printPermutation(vector<int> &equivalence){\n    for (auto i : equivalence)\n        cout << i << \" \";\n    cout << endl;\n}\n\n--- END FILE src/brute_isomorphism.cpp ---\n",

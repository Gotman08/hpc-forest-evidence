      "content": "{\"role\": \"G\", \"goal\": \"integration of diverse archived transformations; evaluate the full program\", \"experiment\": \"d219bc71afaa448f-h01\", \"ordinal\": 1, \"integration_source_ids\": [\"b9cee6d222824970\", \"0ca33e5452d140cb\", \"f8c35db1bcd447ca\", \"45dc7e3e4ea841d3\", \"9bd09382f9094cf0\", \"4d99b0f1c532433d\"], \"current_source_paths\": [\"src/brute_isomorphism.cpp\"], \"context_as_data\": {\"sources\": [{\"id\": \"b9cee6d222824970\", \"role\": \"A\", \"commit\": \"d8dad3cfb4504b9383023bde0a4b0b2090e8b35d\", \"transformations\": {\"files\": [\"src/brute_isomorphism.cpp\"], \"retained\": [\"Replace the nested bit-packed adjacency matrix with a contiguous row-major byte matrix.\", \"Cache the two row pointers in each verification iteration to avoid repeated row indexing.\"]}, \"mean_seconds\": 0.006866731991370519, \"diff\": \"diff --git a/src/brute_isomorphism.cpp b/src/brute_isomorphism.cpp\\nindex 9245dc0..9df147a 100644\\n--- a/src/brute_isomorphism.cpp\\n+++ b/src/brute_isomorphism.cpp\\n@@ -1,10 +1,28 @@\\n+#include <cstddef>\\n #include <iostream>\\n #include <vector>\\n #include <utility>\\n \\n using namespace std;\\n \\n-typedef vector<vector<bool>> adjacency_matrix;\\n+struct adjacency_matrix {\\n+    explicit adjacency_matrix(size_t vertices = 0)\\n+        : vertices_(vertices), data_(vertices * vertices, 0) {}\\n+\\n+    size_t size() const { return vertices_; }\\n+\\n+    unsigned char *operator[](size_t row) {\\n+        return data_.data() + row * vertices_;\\n+    }\\n+\\n+    const unsigned char *operator[](size_t row) const {\\n+        return data_.data() + row * vertices_;\\n+    }\\n+\\n+private:\\n+    size_t vertices_;\\n+    vector<unsigned char> data_;\\n+};\\n \\n adjacency_matrix readGraph();\\n \\n@@ -68,8 +86,6 @@ adjacency_matrix readGraph(){\\n \\n     cin >> vertices;\\n     adjacency_matrix read(vertices);\\n-    for (int i = 0; i < vertices; ++i)\\n-        read[i].resize(vertices);\\n     \\n     cin >> edges;    \\n     for (int i = 0; i < edges; i++) {\\n@@ -82,8 +98,10 @@ adjacency_matrix readGraph(){\\n \\n bool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence){\\n     for (int i = 0; i < equivalence.size(); ++i) {\\n+        const unsigned char *row1 = g1[i];\\n+        const unsigned char *row2 = g2[equivalence[i]];\\n         for (int j = 0; j <= i; ++j) {\\n-            if(g1[i][j] != g2[equivalence[i]][equivalence[j]]) return false;\\n+            if(row1[j] != row2[equivalence[j]]) return false;\\n         }\\n     }\\n    return true;\"}, {\"id\": \"0ca33e5452d140cb\", \"role\": \"A\", \"commit\": \"b238a82a71ae4ddd213c75804b4a22936b966600\", \"transformations\": {\"files\": [\"src/brute_isomorphism.cpp\"], \"retained\": [\"Replaced vector-of-vector<bool> adjacency storage with a contiguous row-major packed-bit matrix; kept permutation generation and adjacency comparison order unchanged.\"]}, \"mean_seconds\": 0.00741594098508358, \"diff\": \"diff --git a/src/brute_isomorphism.cpp b/src/brute_isomorphism.cpp\\nindex 9245dc0..698e3c9 100644\\n--- a/src/brute_isomorphism.cpp\\n+++ b/src/brute_isomorphism.cpp\\n@@ -1,15 +1,43 @@\\n #include <iostream>\\n #include <vector>\\n #include <utility>\\n+#include <cstdint>\\n \\n using namespace std;\\n \\n-typedef vector<vector<bool>> adjacency_matrix;\\n+class adjacency_matrix {\\n+public:\\n+    explicit adjacency_matrix(int vertices = 0)\\n+        : vertices_(vertices),\\n+          words_per_row_((vertices + 63) / 64),\\n+          data_(static_cast<size_t>(vertices) * words_per_row_, 0) {}\\n+\\n+    int size() const {\\n+        return vertices_;\\n+    }\\n+\\n+    uint64_t *row(int index) {\\n+        return &data_[static_cast<size_t>(index) * words_per_row_];\\n+    }\\n+\\n+    const uint64_t *row(int index) const {\\n+        return &data_[static_cast<size_t>(index) * words_per_row_];\\n+    }\\n+\\n+    void setEdge(int source, int destination) {\\n+        row(source)[destination >> 6] |= uint64_t(1) << (destination & 63);\\n+    }\\n+\\n+private:\\n+    int vertices_;\\n+    int words_per_row_;\\n+    vector<uint64_t> data_;\\n+};\\n \\n adjacency_matrix readGraph();\\n \\n-bool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\\n-bool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence);\\n+bool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2);\\n+bool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2, const vector<int> &equivalence);\\n inline void printPermutation(vector<int> &equivalence);\\n \\n int main(){\\n@@ -22,7 +50,7 @@ int main(){\\n     return 0;\\n }\\n \\n-bool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\\n+bool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2){\\n     vector<int> equivalence(g1.size(), 0);\\n     vector<int> exchange_counter(g1.size(), 0);\\n     int exchange_index = 1;\\n@@ -68,22 +96,26 @@ adjacency_matrix readGraph(){\\n \\n     cin >> vertices;\\n     adjacency_matrix read(vertices);\\n-    for (int i = 0; i < vertices; ++i)\\n-        read[i].resize(vertices);\\n     \\n     cin >> edges;    \\n     for (int i = 0; i < edges; i++) {\\n        cin >> source >> destination;\\n-       read[destination][source] = read[source][destination] = true; \\n+       read.setEdge(source, destination);\\n+       read.setEdge(destination, source);\\n     }\\n \\n     return read;\\n }\\n \\n-bool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence){\\n+bool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2, const vector<int> &equivalence){\\n     for (int i = 0; i < equivalence.size(); ++i) {\\n+        const uint64_t *row1 = g1.row(i);\\n+        const uint64_t *row2 = g2.row(equivalence[i]);\\n         for (int j = 0; j <= i; ++j) {\\n-            if(g1[i][j] != g2[equivalence[i]][equivalence[j]]) return fal
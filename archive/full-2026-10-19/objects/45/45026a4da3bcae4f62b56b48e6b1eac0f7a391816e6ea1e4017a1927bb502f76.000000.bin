      "content": "#include \"knn.h\"\n#include <limits.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\ntypedef struct {\n    float distance;\n    int group;\n} KnnCandidate;\n\ntypedef struct {\n    KnnCandidate *candidates;\n    size_t capacity;\n    size_t count;\n} KnnPartial;\n\n/* Equal-distance points within one group have identical labels. */\nstatic inline int knn_farther(KnnCandidate a, KnnCandidate b) {\n    return a.distance > b.distance ||\n           (a.distance == b.distance && a.group > b.group);\n}\n\nstatic inline void knn_sift_down(KnnCandidate *heap, size_t count,\n                                 size_t root, KnnCandidate value) {\n    size_t child = root * 2 + 1;\n\n    while (child < count) {\n        if (child + 1 < count &&\n            knn_farther(heap[child + 1], heap[child])) {\n            child++;\n        }\n        if (!knn_farther(heap[child], value)) {\n            break;\n        }\n        heap[root] = heap[child];\n        root = child;\n        child = root * 2 + 1;\n    }\n    heap[root] = value;\n}\n\nstatic inline void knn_partial_offer(KnnPartial *partial,\n                                      float distance, int group) {\n    KnnCandidate candidate = {distance, group};\n\n    if (partial->count < partial->capacity) {\n        partial->candidates[partial->count++] = candidate;\n        if (partial->count == partial->capacity) {\n            for (size_t root = partial->count / 2; root > 0; root--) {\n                KnnCandidate value = partial->candidates[root - 1];\n                knn_sift_down(partial->candidates, partial->count,\n                              root - 1, value);\n            }\n        }\n        return;\n    }\n\n    if (knn_farther(partial->candidates[0], candidate)) {\n        knn_sift_down(partial->candidates, partial->count, 0, candidate);\n    }\n}\n\nstatic int knn_scan_points(KnnPartial *partial, const Point *points,\n                           size_t count, int group, Point to_evaluate) {\n    enum { TILE_POINTS = 256 };\n    float distance_tile[TILE_POINTS];\n    size_t begin = 0;\n\n    while (begin < count) {\n        size_t remaining = count - begin;\n        int length = remaining > TILE_POINTS ? TILE_POINTS : (int) remaining;\n        const int have_cutoff = partial->count == partial->capacity;\n        const float cutoff = have_cutoff ? partial->candidates[0].distance : 0.0f;\n        const int cutoff_group = have_cutoff ? partial->candidates[0].group : 0;\n        const int earlier_group = group < cutoff_group;\n        int any_candidate = 0;\n        int bad_distance = 0;\n\n#if defined(_OPENMP)\n#pragma omp simd reduction(|:any_candidate,bad_distance)\n#elif defined(__GNUC__) && !defined(__clang__)\n#pragma GCC ivdep\n#endif\n        for (int p = 0; p < length; p++) {\n            float d = euclidean_distance_no_sqrt(\n                to_evaluate, points[begin + (size_t) p]);\n            int retain = !have_cutoff || d < cutoff ||\n                         (d == cutoff && earlier_group);\n            distance_tile[p] = retain ? d : -1.0f;\n            any_candidate |= retain;\n            bad_distance |= !(d >= 0.0f);\n        }\n\n        if (bad_distance) {\n            return 0;\n        }\n        if (any_candidate) {\n            for (int p = 0; p < length; p++) {\n                float d = distance_tile[p];\n                if (d != -1.0f) {\n                    knn_partial_offer(partial, d, group);\n                }\n            }\n        }\n        begin += (size_t) length;\n    }\n    return 1;\n}\n\nstatic char knn_reference(int n_groups, Group *groups, int k,\n                           Point to_evaluate) {\n    char *labels = (char *) malloc(sizeof(char) * k);\n    float *distances = (float *) malloc(sizeof(float) * k);\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\n#ifdef _OPENMP\nstatic int knn_select_parallel(int n_groups, Group *groups,\n                               size_t total, size_t capacity,\n                               Point to_evaluate, KnnPartial *selection) {\n    int workers = omp_get_max_threads();\n    size_t max_workers = total / 4096;\n    if (max_workers < (size_t) workers) {\n        workers = (int) max_workers;\n    }\n    if (workers < 2) {\n        return 0;\n    }\n\n    if ((size_t) n_groups + 1 > ((size_t) -1) / sizeof(size_t)) {\n        return 0;\n    }\n    size_t *offsets = (size_t *) malloc(\n        ((size_t) n_groups + 1) * sizeof(*offsets));\n    if (offsets == NULL) {\n        return 0;\n    }\n    KnnPartial *partials = (KnnPartial *) calloc(\n        (size_t) workers, sizeof(*partials));\n    if (partials == NULL) {\n        free(offsets);\n        return 0;\n    }\n\n    offsets[0] = 0;\n    for (int i = 0; i < n_groups; i++) {\n        offsets[i + 1] = offsets[i] + (size_t) groups[i].length;\n    }\n\n    size_t block_size = total / ((size_t) workers * 8);\n    if (block_size < 1024) block_size = 1024;\n    if (block_size > 16384) block_size = 16384;\n    size_t blocks = total / block_size + (total % block_size != 0);\n    int failed = 0;\n\n#pragma omp parallel num_threads(workers) reduction(|:failed)\n    {\n        KnnPartial local = {0};\n        local.capacity = capacity;\n        local.candidates = (KnnCandidate *) malloc(\n            capacity * sizeof(*local.candidates));\n        int invalid = local.candidates == NULL;\n\n#pragma omp for schedule(dynamic, 1)\n        for (size_t block = 0; block < blocks; block++) {\n            if (invalid) continue;\n\n            size_t begin = block * block_size;\n            size_t remaining = total - begin;\n            size_t end = begin + (remaining < block_size ? remaining : block_size);\n            size_t low = 0;\n            size_t high = (size_t) n_groups;\n\n            while (low < high) {\n                size_t middle = low + (high - low) / 2;\n                if (offsets[middle + 1] <= begin) {\n                    low = middle + 1;\n                } else {\n                    high = middle;\n                }\n            }\n\n            for (int group = (int) low;\n                 group < n_groups && offsets[group] < end; group++) {\n                size_t first = begin > offsets[group] ? begin - offsets[group] : 0;\n                size_t stop = offsets[group + 1];\n                if (stop > end) stop = end;\n                size_t last = stop - offsets[group];\n\n                if (last > first &&\n                    !knn_scan_points(&local, groups[group].points + first,\n                                     last - first, group, to_evaluate)) {\n                    invalid = 1;\n                    break;\n                }\n            }\n        }\n\n        partials[omp_get_thread_num()] = local;\n        failed |= invalid;\n    }\n\n    free(offsets);\n    if (failed) {\n        for (int worker = 0; worker < workers; worker++) {\n            free(partials[worker].candidates);\n        }\n        free(partials);\n        return 0;\n    }\n\n    *selection = partials[0];\n    for (int worker = 1; worker < workers; worker++) {\n        KnnPartial *other = &partials[worker];\n        for (size_t i = 0; i < other->count; i++) {\n            KnnCandidate candidate = other->candidates[i];\n            knn_partial_offer(selection, candidate.distance, candidate.group);\n        }\n        free(other->candidates);\n    }\n    free(partials);\n    return 1;\n}\n#endif\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) {\n        return knn_reference(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t total = 0;\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length < 0) {\n            return knn_reference(n_groups, groups, k, to_evaluate);\n        }\n        size_t length = (size_t) groups[i].length;\n        if (length > ((size_t) -1) - total) {\n            return knn_reference(n_groups, groups, k, to_evaluate);\n        }\n        total += length;\n    }\n    if (total == 0) {\n        return (char) -1;\n    }\n\n    const size_t capacity = total < (size_t) k ? total : (size_t) k;\n    if (capacity > ((size_t) -1) / sizeof(KnnCandidate)) {\n        return knn_reference(n_groups, groups, k, to_evaluate);\n    }\n\n    KnnPartial selected = {0};\n    int parallel_selected = 0;\n#ifdef _OPENMP\n    parallel_selected = knn_select_parallel(\n        n_groups, groups, total, capacity, to_evaluate, &selected);\n#endif\n    if (!parallel_selected) {\n        selected.capacity = capacity;\n        selected.candidates = (KnnCandidate *) malloc(\n            capacity * sizeof(*selected.candidates));\n        if (selected.candidates == NULL) {\n            return knn_reference(n_groups, groups, k, to_evaluate);\n        }\n\n        for (int i = 0; i < n_groups; i++) {\n            if (!knn_scan_points(&selected, groups[i].points,\n                                 (size_t) groups[i].length, i, to_evaluate)) {\n                free(selected.candidates);\n                return knn_reference(n_groups, groups, k, to_evaluate);\n            }\n        }\n    }\n\n    size_t frequencies[UCHAR_MAX + 1] = {0};\n    frequencies[(unsigned char) ((char) -1)] = (size_t) k - selected.count;\n    for (size_t i = 0; i < selected.count; i++) {\n        char label = groups[selected.candidates[i].group].label;\n        frequencies[(unsigned char) label]++;\n    }\n\n    char most_frequent = (char) CHAR_MIN;\n    size_t most_frequent_count = 0;\n    for (int label = CHAR_MIN; label <= CHAR_MAX; label++) {\n        size_t frequency = frequencies[(unsigned char) label];\n        if (frequency > most_frequent_count) {\n            most_frequent = (char) label;\n            most_frequent_count = frequency;\n        }\n    }\n\n    free(selected.candidates);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Compact private max-heaps, SIMD cutoff screening, and dynamically scheduled point blocks should reduce selection traffic while balancing work across the four CPU cores.",

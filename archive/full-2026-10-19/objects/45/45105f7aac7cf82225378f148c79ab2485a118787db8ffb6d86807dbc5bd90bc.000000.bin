      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n#include <string.h>\n#include <math.h>\n\n#define MAX_PARTS 1000u\n#define ROOT_LIMIT 65535u\n#define ODD_CAPACITY ((ROOT_LIMIT + 1u) / 2u)\n#define WHEEL_MOD 2310u\n#define RECIPROCAL_MIN_WORK 32u\n\ntypedef struct {\n    uint32_t value;\n    uint32_t scale;\n} Fragment;\n\ntypedef struct {\n    uint32_t inverse;\n    uint32_t quotient;\n} Divisor;\n\nstatic unsigned char odd_composite[(ROOT_LIMIT >> 4) + 1u];\nstatic unsigned char wheel[WHEEL_MOD];\nstatic uint16_t prime_values[ODD_CAPACITY];\n_Alignas(64) static Divisor divisor_tests[ODD_CAPACITY];\nstatic unsigned prime_count;\n\nstatic uint32_t parse_fragment(const char *text, uint32_t *scale)\n{\n    uint32_t value = 0;\n    uint32_t power = 1;\n    while (*text != '\\0') {\n        value = value * 10u + (unsigned)(*text - '0');\n        power *= 10u;\n        ++text;\n    }\n    *scale = power;\n    return value;\n}\n\nstatic int small_prime(uint32_t value)\n{\n    return value == 2u || value == 3u || value == 5u ||\n           value == 7u || value == 11u;\n}\n\nstatic void initialize_wheel(void)\n{\n    static const unsigned factors[] = {2u, 3u, 5u, 7u, 11u};\n    memset(wheel, 0, sizeof wheel);\n    for (unsigned i = 0; i < 5u; ++i)\n        for (unsigned value = 0; value < WHEEL_MOD; value += factors[i])\n            wheel[value] = 1;\n}\n\nstatic int marked(uint32_t value)\n{\n    return (odd_composite[value >> 4] >> ((value >> 1) & 7u)) & 1u;\n}\n\nstatic void build_primes(uint32_t limit)\n{\n    memset(odd_composite, 0, sizeof odd_composite);\n    prime_count = 0;\n    for (uint32_t p = 3u; p <= limit / p; p += 2u) {\n        if (!marked(p)) {\n            for (uint32_t value = p * p; value <= limit; value += 2u * p)\n                odd_composite[value >> 4] |=\n                    (unsigned char)(1u << ((value >> 1) & 7u));\n        }\n    }\n    for (uint32_t p = 13u; p <= limit; p += 2u)\n        if (!marked(p))\n            prime_values[prime_count++] = (uint16_t)p;\n}\n\nstatic void build_inverse_tests(void)\n{\n    for (unsigned i = 0; i < prime_count; ++i) {\n        uint32_t p = prime_values[i];\n        uint32_t inverse = p;\n        /* An odd number is its own inverse modulo eight. */\n        for (unsigned step = 0; step < 4u; ++step)\n            inverse *= 2u - p * inverse;\n        divisor_tests[i].inverse = inverse;\n        divisor_tests[i].quotient = UINT32_MAX / p;\n    }\n}\n\nstatic uint32_t integer_sqrt(uint32_t value)\n{\n    uint32_t root = (uint32_t)sqrt((double)value);\n    while ((uint64_t)(root + 1u) * (root + 1u) <= value)\n        ++root;\n    while ((uint64_t)root * root > value)\n        --root;\n    return root;\n}\n\nstatic inline int divides(uint32_t value, const Divisor *test)\n{\n    return (uint32_t)(value * test->inverse) <= test->quotient;\n}\n\nstatic int is_prime_after_wheel(uint32_t value, int use_inverse)\n{\n    if (value < 13u)\n        return small_prime(value);\n\n    unsigned low = 0;\n    unsigned high = prime_count;\n    while (low < high) {\n        unsigned middle = low + (high - low) / 2u;\n        uint32_t p = prime_values[middle];\n        if (p * p <= value)\n            low = middle + 1u;\n        else\n            high = middle;\n    }\n    unsigned end = low;\n\n    if (!use_inverse) {\n        for (unsigned i = 0; i < end; ++i)\n            if (value % prime_values[i] == 0u)\n                return 0;\n        return 1;\n    }\n\n    unsigned i = 0;\n    for (; i + 4u <= end; i += 4u) {\n        if (divides(value, &divisor_tests[i]) |\n            divides(value, &divisor_tests[i + 1u]) |\n            divides(value, &divisor_tests[i + 2u]) |\n            divides(value, &divisor_tests[i + 3u]))\n            return 0;\n    }\n    for (; i < end; ++i)\n        if (divides(value, &divisor_tests[i]))\n            return 0;\n    return 1;\n}\n\nstatic int compare_values(const void *left, const void *right)\n{\n    uint32_t a = *(const uint32_t *)left;\n    uint32_t b = *(const uint32_t *)right;\n    return (a > b) - (a < b);\n}\n\nint main(void)\n{\n    unsigned count = 0;\n    if (scanf(\"%u\", &count) != 1 || count == 0u || count > MAX_PARTS)\n        return 0;\n\n    size_t pair_count = (size_t)count * count;\n    uint32_t *left = malloc((size_t)count * sizeof *left);\n    Fragment *right = malloc((size_t)count * sizeof *right);\n    uint32_t *work = malloc(pair_count * sizeof *work);\n    if (left == NULL || right == NULL || work == NULL) {\n        free(work);\n        free(right);\n        free(left);\n        return 1;\n    }\n\n    char token[50];\n    for (unsigned i = 0; i < count; ++i) {\n        uint32_t ignored_scale;\n        if (scanf(\"%49s\", token) != 1)\n            goto cleanup;\n        left[i] = parse_fragment(token, &ignored_scale);\n    }\n    for (unsigned i = 0; i < count; ++i) {\n        if (scanf(\"%49s\", token) != 1)\n            goto cleanup;\n        right[i].value = parse_fragment(token, &right[i].scale);\n    }\n\n    initialize_wheel();\n    size_t work_count = 0;\n    uint32_t maximum = 0;\n    for (unsigned i = 0; i < count; ++i) {\n        uint32_t prefix = left[i];\n        for (unsigned j = 0; j < count; ++j) {\n            uint32_t value = prefix * right[j].scale + right[j].value;\n            if (value < 13u) {\n                if (!small_prime(value))\n                    continue;\n            } else if (wheel[value % WHEEL_MOD]) {\n                continue;\n            }\n            work[work_count++] = value;\n            if (value > maximum)\n                maximum = value;\n        }\n    }\n\n    build_primes(integer_sqrt(maximum));\n    int use_inverse = work_count >= RECIPROCAL_MIN_WORK;\n    if (use_inverse)\n        build_inverse_tests();\n\n    size_t result_count = 0;\n    for (size_t i = 0; i < work_count; ++i) {\n        uint32_t value = work[i];\n        if (is_prime_after_wheel(value, use_inverse))\n            work[result_count++] = value;\n    }\n    qsort(work, result_count, sizeof *work, compare_values);\n    for (size_t i = 0; i < result_count; ++i)\n        printf(\"%u\\n\", (unsigned)work[i]);\n\ncleanup:\n    free(work);\n    free(right);\n    free(left);\n    return 0;\n}\n",
      "path": "src/model-view/primetest.c"
    },

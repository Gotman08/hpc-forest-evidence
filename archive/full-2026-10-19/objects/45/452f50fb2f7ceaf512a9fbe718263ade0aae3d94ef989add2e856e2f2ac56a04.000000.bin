        "content": "#include <bits/stdc++.h>\n\nusing namespace std;\nusing ll = long long;\n\nstatic constexpr int DIM = 1000;\nstatic int A[DIM][DIM];\nstatic int transposed[DIM][DIM];\n\nclass FrequencyTable {\n  vector<ll> keys;\n  vector<ll> counts;\n  vector<uint32_t> generations;\n  size_t mask;\n  uint32_t generation = 0;\n\n  static uint64_t hash_key(ll key) {\n    uint64_t x = static_cast<uint64_t>(key) + 0x9e3779b97f4a7c15ULL;\n    x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;\n    x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;\n    return x ^ (x >> 31);\n  }\n\npublic:\n  explicit FrequencyTable(int max_prefix_length) {\n    size_t capacity = 1;\n    const size_t needed = 2 * (static_cast<size_t>(max_prefix_length) + 1);\n    while (capacity < needed)\n      capacity <<= 1;\n    keys.resize(capacity);\n    counts.resize(capacity);\n    generations.resize(capacity);\n    mask = capacity - 1;\n  }\n\n  void reset() {\n    ++generation;\n    if (generation == 0) {\n      fill(generations.begin(), generations.end(), 0);\n      generation = 1;\n    }\n  }\n\n  ll count(ll key) const {\n    size_t slot = hash_key(key) & mask;\n    while (generations[slot] == generation) {\n      if (keys[slot] == key)\n        return counts[slot];\n      slot = (slot + 1) & mask;\n    }\n    return 0;\n  }\n\n  void increment(ll key) {\n    size_t slot = hash_key(key) & mask;\n    while (generations[slot] == generation) {\n      if (keys[slot] == key) {\n        ++counts[slot];\n        return;\n      }\n      slot = (slot + 1) & mask;\n    }\n    generations[slot] = generation;\n    keys[slot] = key;\n    counts[slot] = 1;\n  }\n};\n\nll solve(int m, int n, ll k) {\n  const bool transpose_matrix = m > n;\n  const int small = min(m, n);\n  const int longer = max(m, n);\n  int (*work)[DIM] = A;\n\n  if (transpose_matrix) {\n    constexpr int BLOCK = 32;\n    for (int ii = 0; ii < m; ii += BLOCK) {\n      for (int jj = 0; jj < n; jj += BLOCK) {\n        const int i_end = min(ii + BLOCK, m);\n        const int j_end = min(jj + BLOCK, n);\n        for (int i = ii; i < i_end; ++i)\n          for (int j = jj; j < j_end; ++j)\n            transposed[j][i] = A[i][j];\n      }\n    }\n    work = transposed;\n  }\n\n  ll answer = 0;\n#pragma omp parallel if((ll)small * (small + 1) / 2 * longer >= 32768) reduction(+ : answer)\n  {\n    FrequencyTable frequencies(longer);\n    vector<ll> compressed(longer);\n\n#pragma omp for schedule(static, 1)\n    for (int top = 0; top < small; ++top) {\n      fill(compressed.begin(), compressed.end(), 0);\n      for (int bottom = top; bottom < small; ++bottom) {\n        const int *row = work[bottom];\n#pragma omp simd\n        for (int col = 0; col < longer; ++col)\n          compressed[col] += row[col];\n\n        frequencies.reset();\n        frequencies.increment(0);\n        ll prefix = 0;\n        for (int col = 0; col < longer; ++col) {\n          prefix += compressed[col];\n          answer += frequencies.count(prefix - k);\n          frequencies.increment(prefix);\n        }\n      }\n    }\n  }\n  return answer;\n}\n\nint main() {\n  ios::sync_with_stdio(false);\n  cin.tie(nullptr);\n\n  ll k;\n  int m, n;\n  if (!(cin >> k >> m >> n))\n    return 0;\n\n  for (int i = 0; i < m; ++i)\n    for (int j = 0; j < n; ++j)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << '\\n';\n  return 0;\n}\n",
        "path": "src/main.cpp"
      }

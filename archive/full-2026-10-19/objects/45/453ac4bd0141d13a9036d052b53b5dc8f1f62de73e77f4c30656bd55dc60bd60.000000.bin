{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <errno.h>\\n#include <stdint.h>\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n\\n#define INPUT_BUFFER_SIZE 65536\\n\\nstatic unsigned char input_buffer[INPUT_BUFFER_SIZE];\\nstatic size_t input_position;\\nstatic size_t input_length;\\n\\nstatic int next_byte(void)\\n{\\n    if (input_position == input_length) {\\n        input_length = fread(input_buffer, 1, sizeof(input_buffer), stdin);\\n        input_position = 0;\\n        if (input_length == 0)\\n            return EOF;\\n    }\\n    return input_buffer[input_position++];\\n}\\n\\nstatic int read_token(char **word, size_t *capacity, size_t *length)\\n{\\n    int c;\\n    do {\\n        c = next_byte();\\n    } while (c != EOF && c <= ' ');\\n\\n    if (c == EOF)\\n        return 0;\\n\\n    size_t used = 0;\\n    do {\\n        if (used > SIZE_MAX - 2)\\n            return -1;\\n        size_t needed = used + 2;\\n        if (needed > *capacity) {\\n            size_t new_capacity = *capacity ? *capacity : 64;\\n            while (new_capacity < needed) {\\n                if (new_capacity > SIZE_MAX / 2) {\\n                    new_capacity = needed;\\n                    break;\\n                }\\n                new_capacity *= 2;\\n            }\\n            char *new_word = realloc(*word, new_capacity);\\n            if (new_word == NULL)\\n                return -1;\\n            *word = new_word;\\n            *capacity = new_capacity;\\n        }\\n        (*word)[used++] = (char)c;\\n        c = next_byte();\\n    } while (c != EOF && c > ' ');\\n\\n    (*word)[used] = '\\\\0';\\n    *length = used;\\n    return 1;\\n}\\n\\nstatic int read_integer(long long *value, char **word, size_t *capacity)\\n{\\n    size_t length;\\n    if (read_token(word, capacity, &length) != 1)\\n        return 0;\\n    (void)length;\\n\\n    errno = 0;\\n    char *end;\\n    long long parsed = strtoll(*word, &end, 10);\\n    if (errno == ERANGE || end == *word || *end != '\\\\0')\\n        return 0;\\n    *value = parsed;\\n    return 1;\\n}\\n\\nint main(void)\\n{\\n    char *word = NULL;\\n    size_t word_capacity = 0;\\n    size_t word_length = 0;\\n    char *records = NULL;\\n    size_t *lengths = NULL;\\n    size_t *order = NULL;\\n    size_t *scratch = NULL;\\n    int result = 1;\\n\\n    long long declared_length_value;\\n    long long count_value;\\n    long long offset;\\n    long long bucket_count;\\n    if (!read_integer(&declared_length_value, &word, &word_capacity) ||\\n        !read_integer(&count_value, &word, &word_capacity) ||\\n        !read_integer(&offset, &word, &word_capacity) ||\\n        !read_integer(&bucket_count, &word, &word_capacity) ||\\n        declared_length_value < 0 || count_value < 0 ||\\n        (uintmax_t)declared_length_value > (uintmax_t)(SIZE_MAX - 1) ||\\n        (uintmax_t)count_value > (uintmax_t)SIZE_MAX) {\\n        goto done;\\n    }\\n    (void)offset;\\n    (void)bucket_count;\\n\\n    size_t count = (size_t)count_value;\\n    if (count == 0) {\\n        putchar('\\\\n');\\n        result = 0;\\n        goto done;\\n    }\\n\\n    if (count > SIZE_MAX / sizeof(*lengths) ||\\n        count > SIZE_MAX / sizeof(*order))\\n        goto done;\\n\\n    lengths = malloc(count * sizeof(*lengths));\\n    order = malloc(count * sizeof(*order));\\n    scratch = malloc(count * sizeof(*scratch));\\n    if (lengths == NULL || order == NULL || scratch == NULL)\\n        goto done;\\n\\n    size_t record_width = (size_t)declared_length_value + 1;\\n    if (record_width > SIZE_MAX / count)\\n        goto done;\\n    records = calloc(count, record_width);\\n    if (records == NULL)\\n        goto done;\\n\\n    size_t max_length = 0;\\n    for (size_t i = 0; i < count; ++i) {\\n        if (read_token(&word, &word_capacity, &word_length) != 1)\\n            goto done;\\n\\n        if (word_length == SIZE_MAX)\\n            goto done;\\n        if (word_length + 1 > record_width) {\\n            size_t new_width = word_length + 1;\\n            if (new_width > SIZE_MAX / count)\\n                goto done;\\n            char *new_records = calloc(count, new_width);\\n            if (new_records == NULL)\\n                goto done;\\n            for (size_t j = 0; j < i; ++j)\\n                memcpy(new_records + j * new_width,\\n                       records + j * record_width, lengths[j]);\\n            free(records);\\n            records = new_records;\\n            record_width = new_width;\\n        }\\n\\n        memcpy(records + i * record_width, word, word_length + 1);\\n        lengths[i] = word_length;\\n        order[i] = i;\\n        if (word_length > max_length)\\n            max_length = word_length;\\n    }\\n\\n    size_t *source = order;\\n    size_t *destination = scratch;\\n    for (size_t remaining = max_length; remaining > 0; --remaining) {\\n        size_t position = remaining - 1;\\n        size_t counts[256] = {0};\\n        size_t next[256];\\n\\n        for (size_t i = 0; i < count; ++i) {\\n            size_t index = source[i];\\n            unsigned char key = position < lengths[index]\\n                ? (unsigned char)records[index * record_width + position]\\n                : 0;\\n            ++counts[key];\\n        }\\n\\n        size_t total = 0;\\n        for (size_t key = 0; key < 256; ++key) {\\n            next[key] = total;\\n            total += counts[key];\\n        }\\n\\n        for (size_t i = 0; i < count; ++i) {\\n            size_t index = source[i];\\n            unsigned char key = position < lengths[index]\\n                ? (unsigned char)records[index * record_width + position]\\n                : 0;\\n            destination[next[key]++] = index;\\n        }\\n\\n        size_t *temporary = source;\\n        source = destination;\\n        destination = temporary;\\n    }\\n\\n    for (size_t i = 0; i < count; ++i) {\\n        if (i != 0)\\n            putchar(' ');\\n        fputs(records + source[i] * record_width, stdout);\\n    }\\n    putchar('\\\\n');\\n    result = 0;\\n\\ndone:\\n    free(scratch);\\n    free(order);\\n    free(lengths);\\n    free(records);\\n    free(word);\\n    return result;\\n}\\n\",\"path\":\"src/bucketsort.c\"}],\"hypothesis\":\"Storing strings in a packed record array and stably radix-sorting record indices by bytes should replace repeated comparisons and improve sequential memory access while preserving strcmp-compatible ordering.\",\"notes\":\"Uses the declared string length as the initial record width and expands safely if a token is longer. Offset and bucket-count inputs are consumed but do not constrain the global sort.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Replace comparison-based bucket sorting with stable least-significant-byte radix passes over the string bytes.\",\"Store records contiguously and distribute indices through sequential counting-sort passes to avoid moving string data.\" ]}"}}

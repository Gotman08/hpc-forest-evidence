    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <cstdio>\\n#include <vector>\\n#include <algorithm>\\n\\nstatic inline int read_int() {\\n    int x = 0;\\n    char c = getchar_unlocked();\\n    while (c < '0' || c > '9') c = getchar_unlocked();\\n    while (c >= '0' && c <= '9') {\\n        x = x * 10 + (c - '0');\\n        c = getchar_unlocked();\\n    }\\n    return x;\\n}\\n\\nint main() {\\n    int n = read_int();\\n    int s = read_int();\\n\\n    // Integral image: size (n+1)x(n+1), initialized to zero\\n    std::vector<long long> II((n + 1) * (n + 1), 0);\\n\\n    for (int i = 0; i < n; ++i) {\\n        long long row_sum = 0;\\n        int base_curr = (i + 1) * (n + 1);\\n        int base_prev = i * (n + 1);\\n        for (int j = 0; j < n; ++j) {\\n            int val = read_int();\\n            row_sum += val;\\n            II[base_curr + j + 1] = II[base_prev + j + 1] + row_sum;\\n        }\\n    }\\n\\n    // Search with 2D tiling\\n    const int B = 32;\\n    int mxSum = -2147483648;\\n\\n    for (int ii = 0; ii <= n - s; ii += B) {\\n        int i_end = std::min(ii + B, n - s + 1);\\n        for (int jj = 0; jj <= n - s; jj += B) {\\n            int j_end = std::min(jj + B, n - s + 1);\\n            for (int i = ii; i < i_end; ++i) {\\n                const long long * __restrict__ row_i = &II[i * (n + 1)];\\n                const long long * __restrict__ row_is = &II[(i + s) * (n + 1)];\\n#pragma ivdep\\n                for (int j = jj; j < j_end; ++j) {\\n                    long long sub_sum = row_is[j + s] - row_i[j + s] - row_is[j] + row_i[j];\\n                    if (sub_sum > mxSum)\\n                        mxSum = static_cast<int>(sub_sum);\\n                }\\n            }\\n        }\\n    }\\n\\n    printf(\\\"%d\\\\n\\\", mxSum);\\n    return 0;\\n}\\n\",\n      \"path\": \"src/solution.cpp\"\n    }\n  ],\n  \"hypothesis\": \"Combine fast integer parsing with single-pass integral image construction to eliminate matrix storage and reduce memory traffic. Apply 2D tiling (blocking) on the search loop over both row and column dimensions to improve temporal reuse of integral image data in cache. Use restrict pointers and ivdep pragma to enable compiler auto-vectorization.\",\n  \"notes\": \"This version reduces memory footprint by not storing the original matrix or intermediate horizontal prefix array. The single-pass construction reads each integer once and directly updates the integral image, improving spatial and temporal locality. 2D tiling with block size 32 increases reuse of II rows across multiple column iterations within a tile.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Replace scanf with getchar_unlocked for fast integer parsing\",\n    \"Eliminate separate matrix storage by building integral image directly during input reading using a single pass per row (horizontal prefix sum accumulated into vertical cumulative sums)\",\n    \"Apply 2D tiling on the search loop over both i and j dimensions to improve cache locality of integral image accesses\",\n    \"Add restrict pointers and ivdep pragma for auto-vectorization\"\n  ]\n}",

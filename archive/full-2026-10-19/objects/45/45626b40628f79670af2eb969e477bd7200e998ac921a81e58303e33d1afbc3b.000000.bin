#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<stddef.h>
#include<stdint.h>

/* Maximum size (in char) for neighbors and compute lists */
#define MAX 100

typedef struct {
  int id;
  float value;
  char neighbors[MAX];
} Node;

typedef struct {
  int *keys;
  int *indices;
  size_t capacity;
} IdIndex;

/* Reads input, allocates memory, writes graph size and node list. Returns the graph. */
Node* read_input(char* fname, int *n, char* list) {
  Node* data = NULL;
  FILE *fl = NULL;

  if (fname == NULL)
    fl = stdin;
  else
    fl = fopen(fname, "r");

  if (fl == NULL) {
    fprintf(stderr, "Error!\n");
    exit(1);
  }

  /* Keep the scanset on the current line; the leading space belongs to the list. */
  list[0] = '\0';
  fscanf(fl, "%d%99[^\n]", n, list);

  if (*n > 0) {
    data = (Node*) malloc ((*n)*sizeof(Node));
    if(data == NULL){
      fprintf(stderr, "Error!\n");
      exit(1);
    }
  }

  for(int i = 0; i < *n; i++) {
    data[i].neighbors[0] = '\0';
    fscanf(fl, "%d %f%99[^\n]", &data[i].id, &data[i].value, data[i].neighbors);
  }

  fclose(fl);
  return data;
}

/* Mix an integer ID before masking it into the power-of-two table. */
static size_t hash_id(int id) {
  uint32_t x = (uint32_t)id;
  x ^= x >> 16;
  x *= UINT32_C(0x7feb352d);
  x ^= x >> 15;
  x *= UINT32_C(0x846ca68b);
  x ^= x >> 16;
  return (size_t)x;
}

/* Build an open-addressed index; retaining the first occurrence matches the old scan. */
static void build_id_index(IdIndex *index, const Node *g, int size) {
  index->keys = NULL;
  index->indices = NULL;
  index->capacity = 0;

  if (size <= 0)
    return;

  size_t max_size = (size_t)-1;
  size_t count = (size_t)size;
  if (count > max_size / 2) {
    fprintf(stderr, "Error!\n");
    exit(1);
  }
  size_t needed = count * 2;
  size_t capacity = 1;
  while (capacity < needed) {
    if (capacity > max_size / 2) {
      fprintf(stderr, "Error!\n");
      exit(1);
    }
    capacity *= 2;
  }
  if (capacity > max_size / sizeof(int)) {
    fprintf(stderr, "Error!\n");
    exit(1);
  }

  index->keys = (int*)malloc(capacity * sizeof(int));
  index->indices = (int*)malloc(capacity * sizeof(int));
  if (index->keys == NULL || index->indices == NULL) {
    fprintf(stderr, "Error!\n");
    exit(1);
  }
  index->capacity = capacity;

  for (size_t i = 0; i < capacity; i++)
    index->indices[i] = -1;

  size_t mask = capacity - 1;
  for (int i = 0; i < size; i++) {
    size_t slot = hash_id(g[i].id) & mask;
    while (index->indices[slot] != -1 && index->keys[slot] != g[i].id)
      slot = (slot + 1) & mask;
    if (index->indices[slot] == -1) {
      index->keys[slot] = g[i].id;
      index->indices[slot] = i;
    }
  }
}

/* Returns the first index of the node with the given ID, or -1 if absent. */
static int find_by_id(const IdIndex *index, int id) {
  if (index->capacity == 0)
    return -1;

  size_t mask = index->capacity - 1;
  size_t slot = hash_id(id) & mask;
  int found = index->indices[slot];
  if (found == -1)
    return -1;
  if (index->keys[slot] == id)
    return found;

  slot = (slot + 1) & mask;
  for (;;) {
    int first_event = 4;
#ifdef _OPENMP
#pragma omp simd reduction(min:first_event)
#endif
    for (int lane = 0; lane < 4; lane++) {
      size_t candidate = (slot + (size_t)lane) & mask;
      int candidate_index = index->indices[candidate];
      int event = (candidate_index == -1 || index->keys[candidate] == id) ? lane : 4;
      first_event = event < first_event ? event : first_event;
    }

    if (first_event < 4) {
      size_t candidate = (slot + (size_t)first_event) & mask;
      int candidate_index = index->indices[candidate];
      return candidate_index == -1 ? -1 : candidate_index;
    }
    slot = (slot + 4) & mask;
  }
}

/* Computes the sum for the node with the given id */
float get_costly(Node *g, int id, const IdIndex *index) {
  char *t;
  int idmax = -1;
  float max = 0;
  char *auxptr;

  int nd = find_by_id(index, id);
  if(nd < 0)
    return max;

  char aux[MAX];
  strcpy(aux, g[nd].neighbors);
  t = strtok_r(aux, " ", &auxptr);

  while (t != NULL) {
    int neighbor_id = atoi(t);
    int d = find_by_id(index, neighbor_id);
    if (d >= 0 && max < g[d].value) {
      max = g[d].value;
      idmax = neighbor_id;
    }
    t = strtok_r(NULL, " ", &auxptr);
  }

  float r = g[nd].value;

  if(idmax != -1)
    r += get_costly(g, idmax, index);

  return (r);
}

/* Main program - calls read input, computes sum for each node in the list, prints output */
int main() {
  char *fileN = NULL;
  char computelist[MAX];
  int n = -1;
  Node* input = NULL;

  input = read_input(fileN, &n, computelist);
  IdIndex index;
  build_id_index(&index, input, n);

  // process
  for(char *c = strtok(computelist, " "); c != NULL; c = strtok(NULL, " "))
    printf("%s: %f\n", c, get_costly(input, atoi(c), &index));

  free(index.keys);
  free(index.indices);
  free(input);
  return 0;
}

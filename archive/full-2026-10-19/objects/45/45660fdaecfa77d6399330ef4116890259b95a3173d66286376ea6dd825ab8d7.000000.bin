      "content": "#include <cstdio>\n#include <vector>\n\nclass FastScanner {\n    enum { BUFSIZE = 1 << 20 };\n    int idx = 0;\n    int size = 0;\n    char buf[BUFSIZE];\npublic:\n    inline char getChar() {\n        if (idx >= size) {\n            size = static_cast<int>(fread(buf, 1, BUFSIZE, stdin));\n            idx = 0;\n            if (size == 0) return 0;\n        }\n        return buf[idx++];\n    }\n\n    int nextInt() {\n        char c;\n        do { c = getChar(); } while (c <= ' ');\n        int sign = 1;\n        if (c == '-') { sign = -1; c = getChar(); }\n        int x = 0;\n        while (c > ' ') {\n            x = x * 10 + (c - '0');\n            c = getChar();\n        }\n        return sign * x;\n    }\n};\n\nint main() {\n    FastScanner fs;\n    int n = fs.nextInt();\n    int s = fs.nextInt();\n\n    std::vector<long long> colSum(n, 0);\n    const size_t ringSize = static_cast<size_t>(s + 1) * static_cast<size_t>(n);\n    std::vector<int> ring(ringSize);\n\n    // Read first s rows and initialize column sums.\n    for (int r = 0; r < s; ++r) {\n        int* row = &ring[static_cast<size_t>(r) * n];\n        int j = 0;\n        for (; j + 3 < n; j += 4) {\n            int v0 = fs.nextInt();\n            int v1 = fs.nextInt();\n            int v2 = fs.nextInt();\n            int v3 = fs.nextInt();\n            row[j] = v0; colSum[j] += v0;\n            row[j+1] = v1; colSum[j+1] += v1;\n            row[j+2] = v2; colSum[j+2] += v2;\n            row[j+3] = v3; colSum[j+3] += v3;\n        }\n        for (; j < n; ++j) {\n            int v = fs.nextInt();\n            row[j] = v;\n            colSum[j] += v;\n        }\n    }\n\n    // Horizontal maximum for the first top row.\n    long long hsum = 0;\n    for (int j = 0; j < s; ++j) hsum += colSum[j];\n    long long mx = hsum;\n    int j = s;\n    for (; j + 3 < n; j += 4) {\n        hsum += colSum[j] - colSum[j-s];\n        if (hsum > mx) mx = hsum;\n        hsum += colSum[j+1] - colSum[j+1-s];\n        if (hsum > mx) mx = hsum;\n        hsum += colSum[j+2] - colSum[j+2-s];\n        if (hsum > mx) mx = hsum;\n        hsum += colSum[j+3] - colSum[j+3-s];\n        if (hsum > mx) mx = hsum;\n    }\n    for (; j < n; ++j) {\n        hsum += colSum[j] - colSum[j-s];\n        if (hsum > mx) mx = hsum;\n    }\n\n    const int mod = s + 1;\n    int slot = s % mod;\n    int oldSlot = 0;\n\n    // Process remaining rows with a circular buffer.\n    for (int r = s; r < n; ++r) {\n        int* newRow = &ring[static_cast<size_t>(slot) * n];\n        const int* oldRow = &ring[static_cast<size_t>(oldSlot) * n];\n\n        // Read and update column sums in one pass.\n        int jj = 0;\n        for (; jj + 3 < n; jj += 4) {\n            int v0 = fs.nextInt();\n            int v1 = fs.nextInt();\n            int v2 = fs.nextInt();\n            int v3 = fs.nextInt();\n            newRow[jj] = v0; colSum[jj] += static_cast<long long>(v0) - oldRow[jj];\n            newRow[jj+1] = v1; colSum[jj+1] += static_cast<long long>(v1) - oldRow[jj+1];\n            newRow[jj+2] = v2; colSum[jj+2] += static_cast<long long>(v2) - oldRow[jj+2];\n            newRow[jj+3] = v3; colSum[jj+3] += static_cast<long long>(v3) - oldRow[jj+3];\n        }\n        for (; jj < n; ++jj) {\n            int v = fs.nextInt();\n            newRow[jj] = v;\n            colSum[jj] += static_cast<long long>(v) - oldRow[jj];\n        }\n\n        // Horizontal maximum for this top row.\n        hsum = 0;\n        for (int j2 = 0; j2 < s; ++j2) hsum += colSum[j2];\n        if (hsum > mx) mx = hsum;\n        int k = s;\n        for (; k + 3 < n; k += 4) {\n            hsum += colSum[k] - colSum[k-s];\n            if (hsum > mx) mx = hsum;\n            hsum += colSum[k+1] - colSum[k+1-s];\n            if (hsum > mx) mx = hsum;\n            hsum += colSum[k+2] - colSum[k+2-s];\n            if (hsum > mx) mx = hsum;\n            hsum += colSum[k+3] - colSum[k+3-s];\n            if (hsum > mx) mx = hsum;\n        }\n        for (; k < n; ++k) {\n            hsum += colSum[k] - colSum[k-s];\n            if (hsum > mx) mx = hsum;\n        }\n\n        // Advance ring indices without modulo.\n        if (++slot == mod) slot = 0;\n        if (++oldSlot == mod) oldSlot = 0;\n    }\n\n    std::printf(\"%d\\n\", static_cast<int>(mx));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

#include <algorithm>
#include <cstdint>
#include <iostream>
#include <vector>

namespace {
using u32 = std::uint32_t;
using u64 = std::uint64_t;

constexpr u64 kMod = 1000000007ULL;
constexpr int kBlock = 16;

// c[j] = P_(n-j), so x^n = sum_j c[j] * x^j modulo Q.
void square_reduce(std::vector<u32>& r,
                   const std::vector<u32>& c,
                   std::vector<u64>& work) {
    const int n = static_cast<int>(r.size());
    const int terms = 2 * n - 1;

    // Symmetric convolution, with two contiguous input streams.
    // Sixteen products plus a residue fit in an unsigned 64-bit sum:
    // 16 * (kMod - 1)^2 + (kMod - 1) < 2^64.
    for (int degree = 0; degree < terms; ++degree) {
        int i = std::max(0, degree - n + 1);
        const int stop = (degree + 1) / 2;
        u64 pairs = 0;
        while (i < stop) {
            const int end = std::min(stop, i + kBlock);
            for (; i < end; ++i) {
                pairs += static_cast<u64>(r[i]) * r[degree - i];
            }
            pairs %= kMod;
        }
        u64 value = pairs + pairs;
        if ((degree & 1) == 0) {
            const u64 middle = r[degree / 2];
            value += middle * middle;
        }
        work[degree] = value % kMod;
    }

    // Eliminate high degrees in descending order. Each block adds at
    // most sixteen products to any coefficient before normalization.
    for (int top = terms - 1; top >= n;) {
        const int bottom = std::max(n, top - kBlock + 1);
        for (int degree = top; degree >= bottom; --degree) {
            const u32 factor = static_cast<u32>(work[degree] % kMod);
            if (factor == 0) {
                continue;
            }
            u64* window = work.data() + (degree - n);
            for (int j = 0; j < n; ++j) {
                window[j] += static_cast<u64>(factor) * c[j];
            }
        }
        // Only this surviving window could have changed in the block.
        for (int j = bottom - n; j < bottom; ++j) {
            work[j] %= kMod;
        }
        top = bottom - 1;
    }

    for (int i = 0; i < n; ++i) {
        r[i] = static_cast<u32>(work[i]);
    }
}

void multiply_by_x(std::vector<u32>& r, const std::vector<u32>& c) {
    const int n = static_cast<int>(r.size());
    const u64 high = r[n - 1];
    for (int i = n - 1; i > 0; --i) {
        r[i] = static_cast<u32>((r[i - 1] + high * c[i]) % kMod);
    }
    r[0] = static_cast<u32>((high * c[0]) % kMod);
}
} // namespace

int main() {
    std::ios::sync_with_stdio(false);
    std::cin.tie(nullptr);

    int n;
    u64 h;
    if (!(std::cin >> n >> h)) {
        return 0;
    }

    std::vector<u32> initial(n);
    std::vector<u32> reduction(n);
    for (int i = 0; i < n; ++i) {
        std::cin >> initial[i];
    }
    for (int i = 0; i < n; ++i) {
        std::cin >> reduction[n - 1 - i];
    }

    if (h <= static_cast<u64>(n)) {
        std::cout << initial[h - 1] << '\n';
        return 0;
    }

    std::vector<u32> polynomial(n, 0);
    std::vector<u64> work(2 * n - 1);

    // Initialize the leading binary digit with x modulo Q.
    if (n == 1) {
        polynomial[0] = reduction[0];
    } else {
        polynomial[1] = 1;
    }

    const u64 exponent = h - 1;
    u64 bit = 1;
    while (bit <= exponent / 2) {
        bit <<= 1;
    }
    for (bit >>= 1; bit != 0; bit >>= 1) {
        square_reduce(polynomial, reduction, work);
        if ((exponent & bit) != 0) {
            multiply_by_x(polynomial, reduction);
        }
    }

    u64 answer = 0;
    for (int start = 0; start < n; start += kBlock) {
        const int end = std::min(n, start + kBlock);
        for (int i = start; i < end; ++i) {
            answer += static_cast<u64>(polynomial[i]) * initial[i];
        }
        answer %= kMod;
    }
    std::cout << answer << '\n';
    return 0;
}

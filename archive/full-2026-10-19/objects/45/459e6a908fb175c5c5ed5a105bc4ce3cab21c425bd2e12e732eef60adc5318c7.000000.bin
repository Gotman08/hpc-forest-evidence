      "content": "#include <bits/stdc++.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\nint A[1000][1000];\nint ps[1010][1010];\n\ntypedef long long ll;\n\nstatic ll count_bands(int m, int n, int k, ll begin, ll end) {\n  if (begin == end)\n    return 0;\n\n  unordered_map<ll, ll> h;\n  h.reserve(static_cast<size_t>(m) + 1);\n  ll ans = 0;\n\n  int j = 1;\n  ll offset = begin;\n  while (offset >= n - j + 1) {\n    offset -= n - j + 1;\n    ++j;\n  }\n  int l = j + static_cast<int>(offset);\n\n  for (ll band = begin; band < end; ++band) {\n    h.clear();\n    h[0] = 1;\n    ll s = 0;\n    for (int i = 1; i <= m; i++) {\n      s += ps[i][l] - ps[i][j - 1];\n      ans += h.find(s - k) != h.end() ? h[s - k] : 0;\n      h[s]++;\n    }\n    if (++l > n) {\n      ++j;\n      l = j;\n    }\n  }\n  return ans;\n}\n\nll solve(int m, int n, int k) {\n  for (int i = 1; i <= m; i++) {\n    ps[i][0] = 0;\n    for (int j = 1; j <= n; j++) {\n      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\n    }\n  }\n\n  const ll bands = static_cast<ll>(n) * (n + 1) / 2;\n#ifdef _OPENMP\n  const ll work = bands * m;\n  const int workers = static_cast<int>(\n      min<ll>(omp_get_max_threads(), max<ll>(1, work / 32768)));\n  if (workers > 1) {\n    ll ans = 0;\n#pragma omp parallel num_threads(workers) reduction(+:ans)\n    {\n      const int tid = omp_get_thread_num();\n      const int team_size = omp_get_num_threads();\n      const ll begin = bands * tid / team_size;\n      const ll end = bands * (tid + 1) / team_size;\n      ans += count_bands(m, n, k, begin, end);\n    }\n    return ans;\n  }\n#endif\n  return count_bands(m, n, k, 0, bands);\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n  memset(ps, 0, sizeof ps);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n",
      "path": "src/main.cpp"
    }

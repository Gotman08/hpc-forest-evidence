      "content": "#include \"knn.h\"\n#include <string.h>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nstatic inline int first_insertion_position(const float * distances, int k, float d) {\n    int x = 0;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const float32x4_t candidate = vdupq_n_f32(d);\n    const float32x4_t empty = vdupq_n_f32(-1.0f);\n    const uint32x4_t offsets0 = {0, 1, 2, 3};\n    const uint32x4_t offsets4 = {4, 5, 6, 7};\n    const uint32x4_t offsets8 = {8, 9, 10, 11};\n    const uint32x4_t offsets12 = {12, 13, 14, 15};\n\n    /* Independent comparisons share one no-match reduction per 16 slots. */\n    for (; x <= k - 16; x += 16) {\n        const float32x4_t stored0 = vld1q_f32(distances + x);\n        const float32x4_t stored4 = vld1q_f32(distances + x + 4);\n        const float32x4_t stored8 = vld1q_f32(distances + x + 8);\n        const float32x4_t stored12 = vld1q_f32(distances + x + 12);\n        const uint32x4_t matches0 = vorrq_u32(\n            vcltq_f32(candidate, stored0), vceqq_f32(stored0, empty));\n        const uint32x4_t matches4 = vorrq_u32(\n            vcltq_f32(candidate, stored4), vceqq_f32(stored4, empty));\n        const uint32x4_t matches8 = vorrq_u32(\n            vcltq_f32(candidate, stored8), vceqq_f32(stored8, empty));\n        const uint32x4_t matches12 = vorrq_u32(\n            vcltq_f32(candidate, stored12), vceqq_f32(stored12, empty));\n        const uint32x4_t any = vorrq_u32(\n            vorrq_u32(matches0, matches4),\n            vorrq_u32(matches8, matches12));\n\n        if (vmaxvq_u32(any) != 0) {\n            /* Unmatched lanes become UINT32_MAX; the minimum is the first hit. */\n            const uint32x4_t positions0 = vornq_u32(offsets0, matches0);\n            const uint32x4_t positions4 = vornq_u32(offsets4, matches4);\n            const uint32x4_t positions8 = vornq_u32(offsets8, matches8);\n            const uint32x4_t positions12 = vornq_u32(offsets12, matches12);\n            const uint32x4_t positions = vminq_u32(\n                vminq_u32(positions0, positions4),\n                vminq_u32(positions8, positions12));\n            return x + (int) vminvq_u32(positions);\n        }\n    }\n\n    for (; x <= k - 4; x += 4) {\n        const float32x4_t stored = vld1q_f32(distances + x);\n        const uint32x4_t matches = vorrq_u32(\n            vcltq_f32(candidate, stored), vceqq_f32(stored, empty));\n        if (vmaxvq_u32(matches) != 0) {\n            return x + (int) vminvq_u32(vornq_u32(offsets0, matches));\n        }\n    }\n#endif\n\n    for (; x < k; x++) {\n        if (d < distances[x] || distances[x] == -1) {\n            return x;\n        }\n    }\n    return k;\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            float farthest = distances[k - 1];\n\n            /* Equal distances retain their original encounter order. */\n            if (farthest != -1.0f && d >= farthest) {\n                continue;\n            }\n\n            int x = first_insertion_position(distances, k, d);\n            if (x < k) {\n                size_t shifted = (size_t) (k - x - 1);\n\n                /* These shifts overlap; memmove preserves their dependencies. */\n                if (shifted != 0) {\n                    memmove(distances + x + 1, distances + x,\n                            shifted * sizeof(*distances));\n                    memmove(labels + x + 1, labels + x,\n                            shifted * sizeof(*labels));\n                }\n\n                distances[x] = d;\n                labels[x] = g.label;\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }

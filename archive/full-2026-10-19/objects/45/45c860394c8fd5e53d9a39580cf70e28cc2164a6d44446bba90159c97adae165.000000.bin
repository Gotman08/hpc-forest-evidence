{
  "src/npbonacci.cpp": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nusing u64 = unsigned long long;\n\nconstexpr u64 MOD = 1000000007ULL;\nconstexpr int REDUCTION_BLOCK = 8;\n\nstatic vector<u64> multiply_mod_characteristic(const vector<u64>& left,\n                                                const vector<u64>& right,\n                                                const vector<u64>& recurrence) {\n    const int n = static_cast<int>(recurrence.size());\n    vector<u64> coefficients(2 * n - 1, 0);\n\n    // Each row writes one contiguous shifted range.  Periodic normalization\n    // keeps eight accumulated modular products safely within 64 bits.\n    for (int i = 0; i < n; ++i) {\n        if (left[i] != 0) {\n            for (int j = 0; j < n; ++j) {\n                coefficients[i + j] += left[i] * right[j];\n            }\n        }\n        if ((i & (REDUCTION_BLOCK - 1)) == REDUCTION_BLOCK - 1) {\n            for (u64& value : coefficients) {\n                value %= MOD;\n            }\n        }\n    }\n    for (u64& value : coefficients) {\n        value %= MOD;\n    }\n\n    // x^n = P1*x^(n-1) + ... + Pn.  Descending degree order makes every\n    // reduction target a lower, still-live coefficient range.\n    int in_block = 0;\n    for (int degree = 2 * n - 2; degree >= n; --degree) {\n        const u64 factor = coefficients[degree] % MOD;\n        for (int term = 1; term <= n; ++term) {\n            coefficients[degree - term] += factor * recurrence[term - 1];\n        }\n\n        ++in_block;\n        if (in_block == REDUCTION_BLOCK) {\n            for (int index = 0; index < degree; ++index) {\n                coefficients[index] %= MOD;\n            }\n            in_block = 0;\n        }\n    }\n\n    coefficients.resize(n);\n    for (u64& value : coefficients) {\n        value %= MOD;\n    }\n    return coefficients;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    u64 height;\n    if (!(cin >> n >> height)) {\n        return 0;\n    }\n\n    vector<u64> initial(n);\n    vector<u64> recurrence(n);\n    for (u64& value : initial) {\n        cin >> value;\n        value %= MOD;\n    }\n    for (u64& value : recurrence) {\n        cin >> value;\n        value %= MOD;\n    }\n\n    if (height <= static_cast<u64>(n)) {\n        cout << initial[static_cast<size_t>(height - 1)] << '\\n';\n        return 0;\n    }\n\n    // Coefficients represent x^(height - 1) modulo the characteristic\n    // polynomial; their dot product with the base terms is F_height.\n    vector<u64> result(n, 0);\n    result[0] = 1;\n\n    vector<u64> power(n, 0);\n    if (n == 1) {\n        power[0] = recurrence[0];\n    } else {\n        power[1] = 1;\n    }\n\n    u64 exponent = height - 1;\n    while (exponent != 0) {\n        if (exponent & 1ULL) {\n            result = multiply_mod_characteristic(result, power, recurrence);\n        }\n        exponent >>= 1ULL;\n        if (exponent != 0) {\n            power = multiply_mod_characteristic(power, power, recurrence);\n        }\n    }\n\n    u64 answer = 0;\n    for (int i = 0; i < n; ++i) {\n        answer += result[i] * initial[i];\n        if ((i & (REDUCTION_BLOCK - 1)) == REDUCTION_BLOCK - 1) {\n            answer %= MOD;\n        }\n    }\n    cout << (answer % MOD) << '\\n';\n    return 0;\n}\n"
}

<div id="forest-32b-v9-view">
  <style>
    #forest-32b-v9-view .tree-chart { width:100%; display:block; overflow:visible; }
    #forest-32b-v9-view .tree-chart text { fill:var(--foreground); }
    #forest-32b-v9-view .tree-chart .edge { fill:none; stroke:var(--border); stroke-width:1.5; }
    #forest-32b-v9-view .tree-chart .node-shape { fill:var(--muted); stroke:var(--border); stroke-width:1; }
    #forest-32b-v9-view .tree-chart .valid { fill:var(--viz-series-1); fill-opacity:.3; }
    #forest-32b-v9-view .tree-chart .incorrect { fill:var(--viz-series-2); fill-opacity:.3; }
    #forest-32b-v9-view .tree-chart .build_failed { fill:var(--viz-series-3); fill-opacity:.3; }
    #forest-32b-v9-view .tree-chart .quality_rejected { fill:var(--destructive); fill-opacity:.3; }
    #forest-32b-v9-view .swatch { display:inline-block; width:10px; height:10px; margin-inline-end:5px; }
    #forest-32b-v9-view .s1 { background:var(--viz-series-1); }
    #forest-32b-v9-view .s2 { background:var(--viz-series-2); }
    #forest-32b-v9-view .s3 { background:var(--viz-series-3); }
    #forest-32b-v9-view .sq { background:var(--destructive); }
    #forest-32b-v9-view .tree-caption { margin-block:8px; }
  </style>
  <h3>Les branches créées sur ROMEO · modèle 32B</h3>
  <div class="viz-controls">
    <label class="form-label">Campagne<select class="form-select" data-field="campaign" aria-label="Campagne"></select></label>
    <label class="form-label">Arbre<select class="form-select" data-field="role" aria-label="Arbre">
      <option value="A">A · mémoire et boucles</option><option value="B">B · vectorisation</option>
      <option value="C">C · parallélisme</option><option value="G">G · intégration</option>
    </select></label>
  </div>
  <div class="viz-row tree-caption"><span data-field="result"></span></div>
  <div class="viz-controls">
    <button class="btn btn-primary" type="button" data-field="play">Rejouer</button>
    <label class="form-label">Créneau <output class="tabular-nums" data-field="step-value"></output>
      <input class="form-range" type="range" min="0" max="96" value="96" step="1" data-field="step" aria-label="Créneau de recherche">
    </label>
  </div>
  <div class="viz-row tree-caption"><span class="tabular-nums" data-field="counts"></span></div>
  <div data-field="chart-container"><svg class="tree-chart" role="img" aria-label="Arbre de recherche enregistré" data-field="chart"></svg></div>
  <div class="viz-row text-small tree-caption" aria-label="Légende">
    <span><span class="swatch s1"></span>Passe les tests</span>
    <span><span class="swatch s2"></span>Sortie incorrecte</span>
    <span><span class="swatch s3"></span>Compilation refusée</span>
    <span><span class="swatch sq"></span>Écarté à la relecture</span>
  </div>
  <label class="form-label">Nœud<select class="form-select" data-field="node" aria-label="Nœud à examiner"></select></label>
  <div class="tree-caption" data-field="detail" aria-live="polite"></div>
  <script type="application/json" data-field="data">__FOREST_DATA__</script>
  <script>
  (() => {
    const root = document.getElementById('forest-32b-v9-view');
    const field = name => root.querySelector('[data-field="'+name+'"]');
    const datasets = JSON.parse(field('data').textContent);
    const ns = 'http://www.w3.org/2000/svg';
    const states = {root:'racine', valid:'passe les tests', incorrect:'sortie incorrecte', build_failed:'compilation refusée', quality_rejected:'écarté à la relecture'};
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let campaign = datasets.length-1, role = 'A', step = 96, selected = '', timer = null, frame = null;
    let previous = new Map();
    const emittedStates = new Set();
    const create = (tag, attrs, text) => {
      const el = document.createElementNS(ns,tag);
      for (const [key,value] of Object.entries(attrs||{})) el.setAttribute(key,String(value));
      if (text!==undefined) el.textContent=text;
      return el;
    };
    datasets.forEach((d,i) => field('campaign').add(new Option(d.label,String(i))));
    function save() {
      const privateContent={campaign,role,step,selected};
      emittedStates.add(JSON.stringify(privateContent));
      if(emittedStates.size>32)emittedStates.delete(emittedStates.values().next().value);
      if (window.openai?.setWidgetState) window.openai.setWidgetState({modelContent:{campaign:datasets[campaign].label,role,step},privateContent}).catch(()=>{});
    }
    function stop() { clearInterval(timer); timer=null; field('play').textContent=step>=96?'Rejouer':'Lire'; }
    function restore(value) {
      const s=value?.privateContent;
      if (!s || !Number.isInteger(s.campaign) || !datasets[s.campaign]) return;
      campaign=s.campaign; role=['A','B','C','G'].includes(s.role)?s.role:'A';
      step=Math.max(0,Math.min(96,Number(s.step)||0)); selected=typeof s.selected==='string'?s.selected:'';
    }
    function draw(animate=true) {
      cancelAnimationFrame(frame);
      const d=datasets[campaign];
      field('campaign').value=String(campaign); field('role').value=role;
      field('step').value=String(step); field('step-value').textContent=step+' / 96';
      if(!timer)field('play').textContent=step>=96?'Rejouer':'Lire';
      field('result').textContent=d.result;
      const tree=d.trees.find(t=>t.role===role);
      const visible=tree.nodes.filter(n=>n.slot<=step);
      const byId=new Map(visible.map(n=>[n.id,n]));
      const kids=new Map(visible.map(n=>[n.id,[]]));
      visible.forEach(n=>{if(kids.has(n.parent))kids.get(n.parent).push(n);});
      const width=Math.max(1,field('chart-container').clientWidth);
      const depth=Math.max(1,...tree.nodes.map(n=>n.depth));
      let leaves=0;
      function place(n) {
        const children=kids.get(n.id)||[];
        const y=children.length?children.map(place).reduce((a,b)=>a+b,0)/children.length:52+(leaves++)*44;
        n.x=25+n.depth*(width-70)/depth; n.y=y; return y;
      }
      place(visible[0]);
      const height=Math.max(160,leaves*44+72);
      const svg=field('chart'); svg.replaceChildren(); svg.setAttribute('viewBox','0 0 '+width+' '+height); svg.setAttribute('height',String(height));
      svg.append(create('title',{},d.label+' — arbre '+role));
      const nodeWord=visible.length===1?'nœud':'nœuds';
      svg.append(create('desc',{},visible.length+' '+nodeWord+', profondeur '+Math.max(...visible.map(n=>n.depth))+'. Les liens représentent les parents de recherche.'));
      const maxKids=Math.max(0,...[...kids.values()].map(x=>x.length));
      field('counts').textContent=visible.length+' '+nodeWord+' · profondeur '+Math.max(...visible.map(n=>n.depth))+' · jusqu’à '+maxKids+' fils';
      const edges=[]; const groups=[];
      visible.forEach(n=>{
        if(byId.has(n.parent)) {const edge=create('path',{class:'edge'});svg.append(edge);edges.push({edge,n,parent:byId.get(n.parent)});}
      });
      visible.forEach(n=>{
        const group=create('g',{'class':'cursor-interaction','data-node':n.id,'data-tooltip':n.label+' · '+states[n.state]+' · '+(kids.get(n.id)||[]).length+' fils'});
        group.append(create(n.state==='build_failed'?'rect':'circle',n.state==='build_failed'?{x:-8,y:-8,width:16,height:16,class:'node-shape '+n.state}:{r:9,class:'node-shape '+n.state}));
        group.append(create('text',{x:0,y:-16,'text-anchor':'middle',class:'text-small'},n.label));
        const hit=create('circle',{r:22,fill:'transparent',stroke:'none'});group.append(hit);
        group.addEventListener('click',()=>{selected=n.id;field('node').value=selected;detail();save();});
        svg.append(group);groups.push({group,n});
      });
      const from=new Map();
      visible.forEach(n=>from.set(n.id,previous.get(n.id)||previous.get(n.parent)||{x:n.x,y:n.y}));
      const duration=animate&&!reduced.matches&&previous.size?330:0;
      const start=performance.now();
      function render(now) {
        const p=duration?Math.min(1,(now-start)/duration):1;
        const q=1-Math.pow(1-p,3);
        const at=n=>{const a=from.get(n.id);return{x:a.x+(n.x-a.x)*q,y:a.y+(n.y-a.y)*q};};
        groups.forEach(({group,n})=>{const p=at(n);group.setAttribute('transform','translate('+p.x+','+p.y+')');});
        edges.forEach(({edge,n,parent})=>{const a=at(parent),b=at(n),m=(a.x+b.x)/2;edge.setAttribute('d','M '+a.x+' '+a.y+' C '+m+' '+a.y+', '+m+' '+b.y+', '+b.x+' '+b.y);});
        if(p<1) frame=requestAnimationFrame(render);
      }
      render(start); previous=new Map(visible.map(n=>[n.id,{x:n.x,y:n.y}]));
      const options=field('node');options.replaceChildren();
      visible.forEach(n=>options.add(new Option(n.label+' · '+states[n.state],n.id)));
      if(!byId.has(selected)) selected=visible[0].id;
      options.value=selected;
      function detail() {
        const n=byId.get(selected);if(!n)return;
        const children=(kids.get(n.id)||[]).map(c=>c.label);
        field('detail').textContent=n.label+' · '+states[n.state]+' · '+(n.seconds==null?'':'mesure de recherche : '+n.seconds.toFixed(6)+' s · ')+(children.length?'fils : '+children.join(', '):'aucun fils à cette étape')+(n.sources.length?' · sources d’intégration : '+n.sources.join(', '):'');
      }
      field('node').onchange=()=>{selected=options.value;detail();save();};detail();
    }
    field('campaign').onchange=()=>{stop();campaign=Number(field('campaign').value);step=96;selected='';previous=new Map();draw(false);save();};
    field('role').onchange=()=>{role=field('role').value;selected='';previous=new Map();draw(false);save();};
    field('step').oninput=()=>{stop();step=Number(field('step').value);draw();};
    field('step').onchange=save;
    field('play').onclick=()=>{
      if(timer){stop();save();return;}
      if(step>=96){step=0;previous=new Map();draw(false);}
      field('play').textContent='Pause';
      timer=setInterval(()=>{step++;draw();if(step>=96){stop();save();}},600);save();
    };
    restore(window.openai?.widgetState);draw(false);
    let lastWidth=field('chart-container').clientWidth;
    new ResizeObserver(entries=>{const width=entries[0].contentRect.width;if(Math.abs(width-lastWidth)>1){lastWidth=width;previous=new Map();draw(false);}}).observe(field('chart-container'));
    window.addEventListener('openai:set_globals',event=>{const state=event.detail?.globals?.widgetState;if(state&&!emittedStates.has(JSON.stringify(state.privateContent))){stop();restore(state);previous=new Map();draw(false);}});
  })();
  </script>
</div>

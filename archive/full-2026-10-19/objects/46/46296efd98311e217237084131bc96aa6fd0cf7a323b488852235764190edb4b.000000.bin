#include <algorithm>
#include <iostream>
#include <utility>
#include <vector>

using namespace std;

const int MOD = 1000000007;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) return 0;

    vector<pair<int, int>> blocked;
    blocked.reserve(static_cast<size_t>(m));
    for (int i = 0; i < m; ++i) {
        int row, column;
        cin >> row >> column;
        blocked.emplace_back(row + column, row);
    }
    sort(blocked.begin(), blocked.end());
    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());

    vector<int> previous(n, 0);
    vector<int> current(n, 0);
    size_t blockedIndex = 0;

    auto updateFreeRange = [&](int begin, int end, int diagonal) {
        if (begin < end && begin == 0) {
            current[0] = previous[0];
            ++begin;
        }

        int vectorBegin = max(begin, 1);
        int vectorEnd = min(end, diagonal);
        // Rows in this span read only the previous diagonal and write distinct cells.
        #pragma GCC ivdep
        for (int row = vectorBegin; row < vectorEnd; ++row) {
            int sum = previous[row] + previous[row - 1];
            if (sum >= MOD) sum -= MOD;
            current[row] = sum;
        }

        if (diagonal < n && begin <= diagonal && diagonal < end) {
            current[diagonal] = previous[diagonal - 1];
        }
    };

    for (int diagonal = 0; diagonal <= 2 * n - 2; ++diagonal) {
        while (blockedIndex < blocked.size() && blocked[blockedIndex].first < diagonal) {
            ++blockedIndex;
        }

        if (diagonal == 0) {
            if (blockedIndex < blocked.size() && blocked[blockedIndex].first == 0) {
                current[0] = 0;
                ++blockedIndex;
            } else {
                current[0] = 1;
            }
            previous.swap(current);
            continue;
        }

        int lowRow = max(0, diagonal - (n - 1));
        int highRow = min(n - 1, diagonal);
        int rowCursor = lowRow;

        while (blockedIndex < blocked.size() && blocked[blockedIndex].first == diagonal) {
            int blockedRow = blocked[blockedIndex].second;
            updateFreeRange(rowCursor, blockedRow, diagonal);
            current[blockedRow] = 0;
            rowCursor = blockedRow + 1;
            ++blockedIndex;
        }
        updateFreeRange(rowCursor, highRow + 1, diagonal);

        previous.swap(current);
    }

    cout << previous[n - 1] << '\n';
    return 0;
}

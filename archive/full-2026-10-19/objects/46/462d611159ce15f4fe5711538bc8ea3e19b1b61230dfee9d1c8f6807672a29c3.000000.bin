{
  "src/solution.cpp": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    cin >> n >> m;\n\n    vector<int> blocked;\n    blocked.reserve(m);\n    for (int i = 0; i < m; ++i) {\n        int y, x;\n        cin >> y >> x;\n        if (y >= 0 && y < n && x >= 0 && x < n)\n            blocked.push_back(y * n + x);\n    }\n\n    sort(blocked.begin(), blocked.end());\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\n\n    if (binary_search(blocked.begin(), blocked.end(), 0) ||\n        binary_search(blocked.begin(), blocked.end(), n * n - 1)) {\n        cout << 0 << '\\n';\n        return 0;\n    }\n\n    const int maxFactorial = 2 * n - 2;\n    vector<long long> factorial(maxFactorial + 1), invFactorial(maxFactorial + 1);\n    factorial[0] = 1;\n    for (int i = 1; i <= maxFactorial; ++i)\n        factorial[i] = factorial[i - 1] * i % MOD;\n\n    auto modPow = [](long long base, int exp) {\n        long long result = 1;\n        while (exp > 0) {\n            if (exp & 1) result = result * base % MOD;\n            base = base * base % MOD;\n            exp >>= 1;\n        }\n        return result;\n    };\n\n    invFactorial[maxFactorial] = modPow(factorial[maxFactorial], MOD - 2);\n    for (int i = maxFactorial; i > 0; --i)\n        invFactorial[i - 1] = invFactorial[i] * i % MOD;\n\n    auto paths = [&](int dy, int dx) -> long long {\n        int total = dy + dx;\n        return factorial[total] * invFactorial[dy] % MOD * invFactorial[dx] % MOD;\n    };\n\n    vector<int> points = blocked;\n    points.push_back(n * n - 1);\n    sort(points.begin(), points.end());\n\n    vector<long long> ways(points.size());\n    for (size_t i = 0; i < points.size(); ++i) {\n        int y = points[i] / n;\n        int x = points[i] % n;\n        long long count = paths(y, x);\n        for (size_t j = 0; j < i; ++j) {\n            int py = points[j] / n;\n            int px = points[j] % n;\n            if (py <= y && px <= x) {\n                count -= ways[j] * paths(y - py, x - px) % MOD;\n                if (count < 0) count += MOD;\n            }\n        }\n        ways[i] = count;\n    }\n\n    cout << ways.back() << '\\n';\n    return 0;\n}\n"
}

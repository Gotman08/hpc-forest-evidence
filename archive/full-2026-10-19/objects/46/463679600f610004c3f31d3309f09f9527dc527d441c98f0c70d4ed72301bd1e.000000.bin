#include <algorithm>
#include <cstdint>
#include <iostream>
#include <utility>
#include <vector>

using namespace std;

static constexpr int MOD = 1000000007;

static long long modPow(long long base, int exponent) {
    long long result = 1;
    while (exponent != 0) {
        if (exponent & 1) result = result * base % MOD;
        base = base * base % MOD;
        exponent >>= 1;
    }
    return result;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, inputCount;
    if (!(cin >> n >> inputCount)) return 0;

    vector<pair<int, int>> blocked;
    blocked.reserve(inputCount);
    for (int i = 0; i < inputCount; ++i) {
        int y, x;
        cin >> y >> x;
        blocked.emplace_back(y, x);
    }
    sort(blocked.begin(), blocked.end());
    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());

    const pair<int, int> start{0, 0};
    const pair<int, int> finish{n - 1, n - 1};
    if (binary_search(blocked.begin(), blocked.end(), start) ||
        binary_search(blocked.begin(), blocked.end(), finish)) {
        cout << 0 << '\n';
        return 0;
    }

    const size_t side = static_cast<size_t>(n);
    const size_t cells = side * side;
    const size_t obstacleCount = blocked.size();
    constexpr size_t DENSE_CELL_LIMIT = 32000000;
    const bool useDense = cells <= DENSE_CELL_LIMIT && obstacleCount > 64 &&
                          obstacleCount * obstacleCount > cells / 8;

    if (useDense) {
        vector<unsigned char> isBlocked(cells, 0);
        for (const auto& cell : blocked) {
            isBlocked[static_cast<size_t>(cell.first) * side + cell.second] = 1;
        }

        vector<int> dp(n, 0);
        dp[0] = 1;
        for (int y = 0; y < n; ++y) {
            int left = 0;
            const size_t row = static_cast<size_t>(y) * side;
            for (int x = 0; x < n; ++x) {
                if (isBlocked[row + x]) {
                    dp[x] = 0;
                    left = 0;
                } else {
                    int value = dp[x] + left;
                    if (value >= MOD) value -= MOD;
                    dp[x] = value;
                    left = value;
                }
            }
        }
        cout << dp[n - 1] << '\n';
        return 0;
    }

    vector<long long> fact(2 * n), inverseFact(2 * n);
    fact[0] = 1;
    for (int i = 1; i < 2 * n; ++i) fact[i] = fact[i - 1] * i % MOD;
    inverseFact.back() = modPow(fact.back(), MOD - 2);
    for (int i = 2 * n - 1; i > 0; --i) inverseFact[i - 1] = inverseFact[i] * i % MOD;

    const auto choose = [&](int total, int taken) -> long long {
        return fact[total] * inverseFact[taken] % MOD * inverseFact[total - taken] % MOD;
    };

    blocked.push_back(finish);
    vector<long long> ways(blocked.size());
    for (size_t i = 0; i < blocked.size(); ++i) {
        const int y = blocked[i].first;
        const int x = blocked[i].second;
        long long value = choose(y + x, y);
        for (size_t j = 0; j < i; ++j) {
            if (blocked[j].second <= x) {
                const int dy = y - blocked[j].first;
                const int dx = x - blocked[j].second;
                value -= ways[j] * choose(dy + dx, dy) % MOD;
                if (value < 0) value += MOD;
            }
        }
        ways[i] = value;
    }

    cout << ways.back() << '\n';
}

      "kind": "generation_usage",
      "payload": "{\"attempt_usage\":[{\"backend\":\"codex-mailbox\",\"cached_tokens_included_in_input\":true,\"codex_jsonl_sha256\":\"29c7f8cec9f7211952e997660fc8273fdfe6a74977c4837045335f7c8753048a\",\"events\":[{\"cache_write_input_tokens\":0,\"cached_input_tokens\":4224,\"input_tokens\":12205,\"output_tokens\":4953,\"reasoning_output_tokens\":3336}],\"llm_calls\":1,\"model\":\"gpt-6-astra\",\"model_requested\":\"gpt-6-astra\",\"reasoning_effort\":\"xhigh\",\"reasoning_effort_requested\":\"xhigh\",\"request_sha256\":\"6ce67f970756d0e6a9e00fe229a8804f884a70d20d55be9f62afc529957541f0\",\"token_accounting\":\"exact\",\"tokens\":17158,\"tool_events\":[]}],\"automatic_measured_feedback_only\":false,\"backend\":\"node-harness\",\"contract_rejected\":false,\"development_evaluations\":1,\"experiment_id\":\"952b777044dd4b83\",\"harness_attempts\":1,\"journal\":\"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-astra-xhigh/results-750205/2022-nbody/logs/952b777044dd4b83/node-harness.json\",\"llm_calls\":1,\"research_actions\":0,\"research_enabled\":true}",

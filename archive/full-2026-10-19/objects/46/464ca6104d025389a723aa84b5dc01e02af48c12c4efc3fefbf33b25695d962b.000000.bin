"""Propose exact parent-only cold reception steps from four real named metadata refs; execute none."""
import argparse
import hashlib
import json
from pathlib import Path
import re

HERE = Path(__file__).resolve().parent
READER = HERE.parent
BASE = READER.parents[2]
OPS = BASE / 'outputs/HPC-Forest-Primes-Natif-Relance-r2g/operations-parent'
FACTORY = BASE / 'outputs/HPC-Forest-Primes-Natif-Lancement-r2g/revision-r1'
PYTHON = BASE / 'work/.venv/Scripts/python.exe'
SCOPE = 'hpc-forest-primes-native-max-r2g'
SOURCE = 'f8c2104bad52e3c298de596fd365415fbdfbbb12fbdc41b47b06a94ad68273fe'
PLAN = '5af07859f99192e169f2475fb2c863c9d4a05a4a8dba07845b3fcc54451e7dba'
HOST = '3b6a9179a4da17fa5fc6948219cd61486dc3b534c683838076d8c61bd311c68e'
CLI = 'f6dbf48cb70f62649c645f26c87dc9bf84cc36986202dfad8e12fb5b8ca70312'
CELLS = {'gpt-6-astra': ('110cefccf16b439eb226e475c875c8df', 'astra-max'),
         'gpt-5.6-terra': ('5d8811082a1842f5836a2bdda982500f', 'terra-max'),
         'gpt-6.1-sol': ('13eaca4e39cf4147a3f677a32fb5a52d', 'sol-max')}
PINS = {'reception_bornee.py': 'ded2fdc49f14186df714b3dc11f74f4c99abe801701a55cf59508e7ea04a7ab4',
        'audit_prive.py': '147f28242753c81065048613fd9e1c79e00f3d4aadb9e8deec4bab8398be0b1c',
        'controler-reception-bornee.py': '33ff0b40c29e28fdfea4d2457b373e6b11b4e44ee1df3ad7649ec4f21e10552f',
        'collecter-frontiere.py': '7bc7e3a8f604ecf3b18fac8d1fd858a2cf00685fd5cafb37afad0b83e0c65c23',
        'preparer-contexte.py': '7afa93fe03058af522e7286b482ab481c2de30044726786c6da0ffc483b80ffe'}
REVIEW = READER / 'revue-independante/REVUE-LECTEUR-FROID-R2G-SCELLEE.json'
REVIEW_SHA = 'ad66ee57a11aa7f56f16846c3a94ed4fc220b2ac36496c8b2d1b3a9070dcfcc7'
INITIAL = OPS / 'collecteurs-r2g-r2/recevoir-installation-oauth.py'
INITIAL_SHA = '3edf5beff3580bd3c3777a5d88bc5e3e5ccc10ced65c04f48bc293660945b405'

def need(ok, message):
    if not ok: raise ValueError(message)

def sha(raw): return hashlib.sha256(raw).hexdigest()

def ordinary(path):
    path = Path(path)
    need(path.is_absolute() and '..' not in path.parts and not path.anchor.startswith('\\\\')
         and all(':' not in part and part.rstrip(' .') == part for part in path.parts[1:]), 'Exact local ordinary metadata path required')
    need(not any(p.is_symlink() or p.is_junction() for p in (path, *path.parents)), 'Linked metadata paths refused')
    return path

def checked(ref):
    need(isinstance(ref, dict) and set(ref) == {'path', 'sha256'}
         and isinstance(ref['path'], str) and re.fullmatch('[0-9a-f]{64}', str(ref['sha256'])), 'Missing real path/SHA reference')
    path = ordinary(ref['path'])
    need(path.is_file() and path.stat().st_size <= 2 * 1024**2, 'Missing/oversized named metadata')
    raw = path.read_bytes(); need(sha(raw) == ref['sha256'], 'Actual metadata SHA differs')
    return json.loads(raw), raw

def verify_tools():
    for name, pin in PINS.items(): need(sha((READER / name).read_bytes()) == pin, 'Changed sealed reader: ' + name)
    need(sha(REVIEW.read_bytes()) == REVIEW_SHA and sha(INITIAL.read_bytes()) == INITIAL_SHA, 'Changed sealed review or initial namespace-r4 helper')

def quote(s): return "'" + str(s).replace("'", "''") + "'"

def ps_argv(argv, hashes=None):
    hashes = hashes or {}
    return '& ' + ' '.join("(Get-FileHash -LiteralPath " + quote(hashes[a]) + " -Algorithm SHA256).Hash.ToLowerInvariant()" if a in hashes else quote(a) for a in argv)

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--inputs', type=Path, required=True)
    parser.add_argument('--inputs-sha256', required=True)
    parser.add_argument('--output-name', required=True)
    args = parser.parse_args()
    verify_tools()
    need(re.fullmatch('[A-Za-z0-9][A-Za-z0-9_-]{0,63}', args.output_name), 'Fresh simple output name required')
    spec_path = ordinary(args.inputs.absolute())
    need(spec_path.parent == HERE and spec_path.name.endswith('.json'), 'Inputs must be one explicit JSON directly under this recipe directory')
    spec, spec_raw = checked({'path': str(spec_path), 'sha256': args.inputs_sha256})
    need(set(spec) == {'schema', 'model', 'launch_input', 'initial_installation', 'initial_ready', 'parent_oauth'}
         and spec['schema'] == 'hpc-forest-r2g-future-cold-recipe-actual-inputs-v1' and spec['model'] in CELLS,
         'Complete real input schema and selected G model required; unbound template cannot run')
    model = spec['model']; session, slug = CELLS[model]
    # Close allowed paths BEFORE reading any supplied metadata. No auth.json, credential, cache or role body is admissible.
    roles = ('launch_input', 'initial_installation', 'initial_ready', 'parent_oauth')
    for k in roles:
        need(isinstance(spec[k], dict) and set(spec[k]) == {'path', 'sha256'}
             and isinstance(spec[k]['path'], str) and re.fullmatch('[0-9a-f]{64}', str(spec[k]['sha256'])), 'Actual named reference required: ' + k)
    paths = {k: ordinary(spec[k]['path']) for k in roles}
    need(paths['launch_input'].parent == FACTORY / 'helper-lancement-possedes' and paths['launch_input'].suffix == '.json', 'Exact actual launch-input directory required')
    installation_dir = paths['initial_installation'].parent
    need(installation_dir.name == slug and installation_dir.parent.parent == OPS
         and installation_dir.parent.name.isidentifier() and paths['initial_installation'].name == 'installation-initiale-recue.json'
         and paths['initial_ready'] == installation_dir / 'worker-ready.json', 'Only frozen initial installation and ready emitted by the G initial helper are accepted')
    need(paths['parent_oauth'] == OPS / 'authentification-oauth-verifiee.json', 'Only the named parent OAuth observation receipt, never credentials')
    values, raw_inputs = {}, {}
    for k in paths: values[k], raw_inputs[k] = checked(spec[k])
    launch, install, ready, oauth = (values[k] for k in ('launch_input', 'initial_installation', 'initial_ready', 'parent_oauth'))
    job = install.get('job_id')
    need(isinstance(job, str) and job.isdigit(), 'Job is derived only from the actual installation receipt')
    identity = {'scope_id': SCOPE, 'model': model, 'effort': 'max', 'session_id': session,
                'job_id': job, 'source_zip_sha256': SOURCE, 'plan_sha256': PLAN}
    need(install.get('schema') == 'hpc-forest-r2e-initial-installation-received-v1' and install.get('verified') is True
         and all(install.get(k) == ready.get(k) == v for k, v in identity.items()), 'Actual frozen G installation/ready identity differs')
    need(install.get('worker_ready') == spec['initial_ready'] and install.get('initial_fresh_gate_completed_before_ready') is True
         and install.get('new_worker_authorized_by_this_receipt') is False and type(install.get('calls_replayed')) is int
         and install['calls_replayed'] == 0, 'Missing frozen initial gate; recipe never authorizes/replays a worker')
    need(launch.get('schema') == 'hpc-forest-r2e-owned-worker-launch-input-v1'
         and launch.get('source_bindings') == install.get('source_bindings') and model in launch.get('worker_argv', {}), 'Actual launch/source binding mismatch')
    need(ready.get('codex_executable_sha256') == CLI and ready.get('authentication') == 'existing-local-ChatGPT'
         and ready.get('task_cli_policy_sha256') == install.get('cli_policy', {}).get('sha256'), 'Actual ready/CLI/policy mismatch')
    need(oauth.get('schema') == 'hpc-forest-three-native-workers-oauth-observation-v1' and oauth.get('verified') is True
         and oauth.get('auth_mode') == 'chatgpt'
         and all(oauth.get(k) is False for k in ('api_key_in_auth_present', 'OPENAI_API_KEY_environment_present', 'CODEX_API_KEY_environment_present', 'secrets_exported')),
         'Real parent observation metadata required; no authentication is performed here')
    need(len([r for r in oauth.get('workers', []) if r.get('model') == model and r.get('job_id') == job
              and r.get('worker_ready') == spec['initial_ready'] and r.get('codex_executable_sha256') == CLI]) == 1, 'Parent OAuth observation does not match this frozen ready/job')
    tag = slug.replace('-', '_') + '_' + job
    context_name, input_name = 'contexte_' + tag, 'input_' + tag
    received = READER / ('reception-' + slug + '-' + job)
    context = READER / context_name / 'contexte-installation-reelle.json'
    collection = received / 'collection-explicite.json'
    cold_input = READER / (input_name + '.json'); result = READER / ('resultat_' + tag)
    prepare = [str(PYTHON), '-I', '-B', str(READER / 'preparer-contexte.py'), '--model', model]
    for key, flag in (('launch_input', 'launch-input'), ('initial_installation', 'initial-installation'), ('initial_ready', 'initial-ready'), ('parent_oauth', 'parent-oauth')):
        prepare += ['--' + flag, spec[key]['path'], '--' + flag + '-sha256', spec[key]['sha256']]
    prepare += ['--output-name', context_name]
    remote = '/gpfs/scratch/nimarano/' + SCOPE + '-' + session + '/results-' + job
    transfers = [{'tool': 'mcp__romeo__download_from_romeo', 'arguments': {'remote_path': remote + '/' + name, 'local_path': str(received / name), 'verify': True},
                  'save_full_actual_tool_result_as': str(received / receipt)} for name, receipt in (
                      ('premier-demarrage-verifie.json', 'transfert-premier-demarrage.json'),
                      ('premier-batch-en-attente.json', 'transfert-premier-batch-en-attente.json'))]
    transfers.append({'tool': 'mcp__romeo__download_from_romeo', 'arguments': {'remote_path': remote, 'local_path': str(received / 'native'), 'verify': False},
                      'save_full_actual_tool_result_as': str(received / 'transfert-dossier-resultats.json')})
    collect = [str(PYTHON), '-I', '-B', str(READER / 'collecter-frontiere.py'), 'collect', '--model', model, '--job', job, '--received-root', str(received),
               '--first-transfer-result', str(received / 'transfert-premier-demarrage.json'), '--native-transfer-result', str(received / 'transfert-dossier-resultats.json'),
               '--paused-transfer-result', str(received / 'transfert-premier-batch-en-attente.json')]
    build = [str(PYTHON), '-I', '-B', str(READER / 'collecter-frontiere.py'), 'build', '--collection', str(collection), '--collection-sha256', '{ACTUAL_COLLECTION_SHA}',
             '--installation-context', str(context), '--installation-context-sha256', '{ACTUAL_CONTEXT_SHA}', '--output-name', input_name]
    audit = [str(PYTHON), '-I', '-B', str(READER / 'controler-reception-bornee.py'), '--input', str(cold_input), '--input-sha256', '{ACTUAL_INPUT_SHA}', '--output', str(result)]
    commands = {'context': ps_argv(prepare), 'collect': ps_argv(collect), 'build': ps_argv(build, {'{ACTUAL_COLLECTION_SHA}': collection, '{ACTUAL_CONTEXT_SHA}': context}),
                'audit': ps_argv(audit, {'{ACTUAL_INPUT_SHA}': cold_input})}
    output = HERE / args.output_name; need(not output.exists(), 'Preserve all earlier proposals')
    # Rehash the four named metadata inputs before any output; do not follow any nested references.
    need(spec_path.read_bytes() == spec_raw and all(paths[k].read_bytes() == raw_inputs[k] for k in paths), 'Input metadata changed during recipe preparation')
    output.mkdir()
    recipe = {'schema': 'hpc-forest-r2g-real-metadata-bound-cold-recipe-v1', 'prepared_only': True, 'executed': False, 'verified_or_native_admitted': False,
              'identity': identity, 'actual_input_references': {k: spec[k] for k in paths}, 'reader_review_sha256': REVIEW_SHA, 'reader_pins': PINS,
              'initial_helper_sha256': INITIAL_SHA, 'parent_only_PowerShell_commands': commands, 'parent_only_MCP_transfer_proposals': transfers,
              'received_root_must_exist_before_transfers': str(received), 'root_creates_received_directory_only_if_absent': True,
              'read_actual_context_transfer_proposal_first': str(READER / context_name / 'TRANSFERTS-PROPOSES-NON-EFFECTUES.json'),
              'publication_proposal_only_after_actual_successful_audit': str(result / 'PUBLICATION-PROPOSEE-NON-EFFECTUEE.json'),
              'no_automatic_release': True, 'publication_order': ['audit digest upload', 'exact digest readback', 'exact release LAST'],
              'policy_expected': {'schema': 'hpc-forest-r2g-local-cli-policy-v1', 'boolean_count': 22, 'only_true': 'code_mode_host', 'host_sha256': HOST},
              'search_pause_budget_seconds_continues': 1800, 'budget_reset_or_replay_authorized': False,
              'missing_input_or_transfer_or_WARN_or_tool_or_unknown_means_hold_not_NORMAL': True,
              'only_explicit_nonces_reconciled_by_received_first_receipt_may_be_copied': True,
              'no_live_cache_credentials_authentication_model_C_body_or_remote_access_by_builder': True,
              'initial_metadata_only_not_NORMAL_or_host_runtime_proof': True}
    target = output / 'RECETTE-PREMIER-BATCH-PROPOSEE.json'
    with target.open('x', encoding='utf8', newline='\n') as h: json.dump(recipe, h, ensure_ascii=False, indent=2); h.write('\n')
    print(json.dumps({'proposal': {'path': str(target), 'sha256': sha(target.read_bytes())}, 'executed': False, 'native_admitted': False}))

if __name__ == '__main__': main()

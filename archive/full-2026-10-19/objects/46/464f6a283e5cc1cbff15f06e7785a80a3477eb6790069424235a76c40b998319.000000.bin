            "src/solution.cpp"
          ],
          "retained": [
            "Store blocked coordinates by row instead of an n-by-n bitmap.",
            "Use one in-place DP row and process obstacle-free segments.",
            "Unroll the dependent prefix recurrence into four-cell associative scans with vectorized independent carry addition."
          ]
        },

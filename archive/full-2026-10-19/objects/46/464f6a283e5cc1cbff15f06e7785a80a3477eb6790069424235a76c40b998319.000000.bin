    {
      "id": "0c1d29db535c4a82",
      "role": "A",
      "mission": {
        "base_commit": "d443844876a84593140437e10983ee2ffb74ae0c",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "A hybrid that uses contiguous row-major rolling DP only for obstacle-dense small grids, and sparse coordinate-sorted inclusion-exclusion otherwise, avoids allocating an N² grid for large sparse instances and improves cache locality in the dense path.",
        "id": "0c1d29db535c4a82",
        "ordinal": 1,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/solution.cpp"
          ],
          "retained": [
            "Replace the always-quadratic vector-of-vectors DP with a bounded dense fallback using a contiguous byte bitmap and a single in-place rolling DP row.",
            "Add a sparse obstacle algorithm using sorted unique coordinates, factorial binomials, and inclusion-exclusion over preceding reachable obstacles.",
            "Use fast buffered C++ I/O and eliminate the separate row-copy pass."
          ]
        },
        "tree_id": "e1:A",

"""Préparer seulement les chemins et preuves attendues du groupe Sol en cours."""

import hashlib
import json
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
COMPARE = HERE.parent
BASE = COMPARE.parents[1]
RUN = COMPARE / "runs/source-only-gpt-6.1-sol-max"


def ref(path, expected=None):
    result = {"path": str(path), "sha256": hashlib.sha256(path.read_bytes()).hexdigest()}
    if expected is not None and result["sha256"] != expected:
        raise ValueError("Pinned input differs: " + path.name)
    return result


def load(path):
    return json.loads(path.read_bytes())


def main():
    coordinator_path = COMPARE / "coordinator-state.json"
    current = [row for row in load(coordinator_path)["queue"] if row["key"] == "source-only-gpt-6.1-sol-max"]
    assert len(current) == 1
    group = current[0]
    assert (group["job_id"], group["session_id"], group["model"], group["effort"], group["arm"]) == (
        "751592", "665743a02b824021a697b6a4884a667c", "gpt-6.1-sol", "max", "source-only")
    assert len(group["subjects"]) == len(set(group["subjects"])) == 15
    submission = load(RUN / "submission.json")
    assert submission["job_id"] == "751592" and submission["submission_observed"] is True
    assert submission["resolved"]["total_cpus"] == 4 and submission["resolved"]["total_gpus"] == 0
    source_ref = ref(COMPARE / "HPC-Forest-Harnais-Comparaison-r1.zip",
                     "9a68a83fde4acb6bd247d79e00490e7d36f0c4c59c6c881152101e4c499387eb")
    actual_group = {key: group[key] for key in (
        "key", "arm", "model", "effort", "subjects", "session_id", "job_id",
        "remote_root", "remote_shared", "remote_container", "job_maximum_seconds")}
    with (HERE / "groupe-exact-planifie.json").open("x", encoding="utf-8", newline="\n") as stream:
        json.dump(actual_group, stream, ensure_ascii=False, indent=2)
        stream.write("\n")
    result = {
        "schema": "hpc-forest-source-only-final-reception-preparation-v1",
        "verified": False, "preparation_only": True,
        "created_at_utc": datetime.now(UTC).isoformat(),
        "group": ref(HERE / "groupe-exact-planifie.json"),
        "source_zip": source_ref,
        "input_refs": {
            "coordinator_historical_projection": ref(coordinator_path),
            "actual_submission": ref(RUN / "submission.json"),
            "deployment_received_before_worker": ref(RUN / "deployment-received.json"),
            "group_auditor": ref(COMPARE / "auditer-source-only.py"),
            "reception_implementation": ref(COMPARE / "comparison_reception.py"),
            "reference_contracts": ref(COMPARE / "contrats-reference.json"),
            "archive_restorer": ref(BASE / "outputs/Marathon22-DeepSeek-v11/cadre-execution/restaurer-preuves.py"),
        },
        "actual_terminal_observation": None,
        "actual_efficiency": None,
        "native_archive_announcement": None,
        "archive_remote_checksum": None,
        "archive_local_checksum": None,
        "fresh_restoration": None,
        "native_audit": None,
        "delivery_reconciliation": None,
        "owned_stop_allowed": False,
        "forbidden_paths": ["Coordinator.receive", "coordonner-source-only.py --run"],
        "ordered_future_checks": [
            "Observe terminal and actual efficiency without repolling already closed jobs",
            "Receive archive announcement and remote/local SHA, preserve every absent proof explicitly",
            "Restore fresh with official sources; baseline native audit outside restored evidence, no live worker cache",
            "Check all fifteen actual issues, model/MAX/session/parents/sources/outputs/five confirmations and negatives",
            "Preserve inventories before/after; reconcile every claim/invocation/delivery including unknown usage",
            "Only after audits and reconciliation, verify all five current identity fields and descendants before any individually owned stop",
            "Require separate professional admission before canonical article build and visual inspection of both documents",
        ],
        "first_normal_or_scientific_admission_claimed": False,
        "source_only_worker_read_or_modified": False,
        "native_calls": 0, "jobs_submitted": 0, "remote_calls": 0,
        "r3_reader_proposal_applied_to_source_only": False,
        "previous_terra_interrupted_nonces_not_reused": True,
    }
    with (HERE / "PLAN-RECEPTION-NON-EXECUTE.json").open("x", encoding="utf-8", newline="\n") as stream:
        json.dump(result, stream, ensure_ascii=False, indent=2, allow_nan=False)
        stream.write("\n")
    print(json.dumps({"prepared_group": "751592", "subjects": 15,
                      "plan": ref(HERE / "PLAN-RECEPTION-NON-EXECUTE.json"), "executed": False}))


if __name__ == "__main__":
    main()

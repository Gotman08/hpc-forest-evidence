        "content": "/*\n    This program solves Laplace's equation on a regular 2D grid using simple Jacobi iteration.\n\n    The stencil calculation stops when  ( err >= CONV_THRESHOLD OR  iter > ITER_MAX )\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <time.h>\n#include <sys/time.h>\n\n#define CONV_THRESHOLD 1.0e-5f // threshold of convergence\n\n// matrix to be solved\ndouble **grid;\n\n// auxiliary matrix\ndouble **new_grid;\n\n// size of each side of the grid\nint size;\nint iter_max_num;\n\n// return the absolute value of a number\ndouble absolute(double num){\n    if(num < 0)\n        return -1.0 * num;\n    return num;\n}\n\n\n// allocate memory for the grid\nvoid allocate_memory(){\n    grid = (double **) malloc(size * sizeof(double *));\n    new_grid = (double **) malloc(size * sizeof(double *));\n\n    for(int i = 0; i < size; i++){\n        grid[i] = (double *) malloc(size * sizeof(double));\n        new_grid[i] = (double *) malloc(size * sizeof(double));\n    }\n}\n\n// initialize the grid\nvoid initialize_grid(){\n    int center = size / 2;\n    int linf = center - (size / 10);\n    int lsup = center + (size / 10);\n    for (int i = 0; i < size; i++){\n        for (int j = 0; j < size; j++){\n            // inicializa região de calor no centro do grid\n            double initial_value;\n            if ( i >= linf && i <= lsup && j >= linf && j <= lsup)\n                initial_value = 100;\n            else\n                initial_value = 0;\n            grid[i][j] = initial_value;\n            // Keep the fixed boundary values identical in both buffers so that\n            // swapping them preserves the original boundary conditions.\n            new_grid[i][j] = initial_value;\n        }\n    }\n}\n\n// save the grid in a file\nvoid save_grid(){\n\n    for(int i = 0; i < size; i++){\n        for(int j = 0; j < size; j++){\n            fprintf(stdout, \"%lf \", grid[i][j]);\n        }\n        fprintf(stdout, \"\\n\");\n    }\n}\n\nint main(int argc, char *argv[]){\n\n    fscanf(stdin, \"%d\", &size);\n    fscanf(stdin, \"%d\", &iter_max_num);\n    \n    // Start above the threshold so the first iteration always runs.\n    double max_error = CONV_THRESHOLD + 1.0;\n    int iter = 0;\n\n    struct timeval time_start;\n    struct timeval time_end;\n\n    // allocate memory to the grid (matrix)\n    allocate_memory();\n\n    // set grid initial conditions\n    initialize_grid();\n\n    //printf(\"Jacobi relaxation calculation: %d x %d grid\\n\", size, size);\n\n    // get the start time\n    //gettimeofday(&time_start, NULL);\n\n    // Keep one team for all iterations. Each iteration writes the destination\n    // buffer, then a single synchronized pointer swap makes it the current grid.\n    #pragma omp parallel shared(grid, new_grid, size, iter_max_num, max_error, iter)\n    {\n        while (max_error > CONV_THRESHOLD && iter < iter_max_num) {\n\n            // Reset the reduction input before workers examine this iteration.\n            #pragma omp single\n            max_error = 0.0;\n\n            // Calculate each next-grid row and reduce the maximum absolute\n            // change, preserving the original strict convergence threshold.\n            #pragma omp for schedule(static) reduction(max:max_error)\n            for (int i = 1; i < size - 1; i++) {\n                for (int j = 1; j < size - 1; j++) {\n                    new_grid[i][j] = 0.25 * (grid[i][j+1] + grid[i][j-1] +\n                                             grid[i-1][j] + grid[i+1][j]);\n\n                    double errorCurrent = absolute(new_grid[i][j] - grid[i][j]);\n                    if (errorCurrent > max_error) {\n                        max_error = errorCurrent;\n                    }\n                }\n            }\n\n            // The stencil loop's implicit barrier completes all destination\n            // writes and the reduction before the shared pointers are exchanged.\n            #pragma omp single\n            {\n                double **tmp = grid;\n                grid = new_grid;\n                new_grid = tmp;\n                iter++;\n            }\n        }\n    }\n\n    // get the end time\n    //gettimeofday(&time_end, NULL);\n\n    //double exec_time = (double) (time_end.tv_sec - time_start.tv_sec) +\n    //                   (double) (time_end.tv_usec - time_start.tv_usec) / 1000000.0;\n\n    //save the final grid in file\n    save_grid();\n\n    //printf(\"\\nKernel executed in %lf seconds with %d iterations.\\n\", exec_time, iter);\n\n    return 0;\n}\n",
        "path": "src/laplace_seq.c"
      }
    ],

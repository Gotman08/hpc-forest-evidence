#include <algorithm>
#include <cstdint>
#include <iostream>
#include <vector>

#if defined(__aarch64__) || defined(__ARM_NEON)
#include <arm_neon.h>
#endif

namespace {
constexpr std::uint32_t MOD = 1000000007U;

inline void advance_diagonal(std::uint32_t* dp, int first, int last) {
    int j = last;
#if defined(__aarch64__) || defined(__ARM_NEON)
    const uint32x4_t modulus = vdupq_n_u32(MOD);
    for (; j >= first + 3; j -= 4) {
        const int base = j - 3;
        // Both loads precede the store; descending blocks preserve old values.
        const uint32x4_t up = vld1q_u32(dp + base);
        const uint32x4_t left = vld1q_u32(dp + base - 1);
        const uint32x4_t sum = vaddq_u32(up, left);
        // Every sum is below 2*MOD, so unsigned min reduces it exactly.
        const uint32x4_t reduced =
            vminq_u32(sum, vsubq_u32(sum, modulus));
        vst1q_u32(dp + base, reduced);
    }
#endif
    for (; j >= first; --j) {
        std::uint32_t value = dp[j] + dp[j - 1];
        if (value >= MOD) value -= MOD;
        dp[j] = value;
    }
}
}

int main() {
    std::ios::sync_with_stdio(false);
    std::cin.tie(nullptr);

    int n, m;
    if (!(std::cin >> n >> m)) return 0;

    std::vector<std::vector<int>> blocked(2 * n - 1);
    bool endpoint_blocked = false;
    for (int c = 0; c < m; ++c) {
        int row, column;
        std::cin >> row >> column;
        blocked[row + column].push_back(column + 1);
        if ((row == 0 && column == 0) ||
            (row == n - 1 && column == n - 1)) {
            endpoint_blocked = true;
        }
    }

    if (endpoint_blocked) {
        std::cout << 0 << '\n';
        return 0;
    }

    // Shift columns by one, leaving dp[0] as a permanent zero boundary.
    std::vector<std::uint32_t> dp(n + 1, 0);
    dp[1] = 1;

    for (int diagonal = 1; diagonal < 2 * n - 1; ++diagonal) {
        const int first = std::max(0, diagonal - n + 1) + 1;
        const int last = std::min(n - 1, diagonal) + 1;
        advance_diagonal(dp.data(), first, last);
        // Cells on the same diagonal cannot depend on one another.
        for (int column : blocked[diagonal]) dp[column] = 0;
    }

    std::cout << dp[n] << '\n';
    return 0;
}

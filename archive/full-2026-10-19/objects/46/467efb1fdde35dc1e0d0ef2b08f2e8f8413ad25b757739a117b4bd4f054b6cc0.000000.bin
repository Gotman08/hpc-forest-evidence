#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

const int MOD = 1000000007;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) return 0;

    // Sort blocked cells by row so each DP row visits only its obstacles.
    vector<pair<int, int>> blocked;
    blocked.reserve(m);
    for (int c = 0; c < m; ++c) {
        int i, j;
        cin >> i >> j;
        blocked.emplace_back(i, j);
    }
    sort(blocked.begin(), blocked.end());

    vector<int> dp(n, 0);
    dp[0] = (blocked.empty() || blocked.front() != make_pair(0, 0)) ? 1 : 0;

    size_t obstacle = 0;
    while (obstacle < blocked.size() && blocked[obstacle].first == 0) {
        int col = blocked[obstacle].second;
        if (col >= 0 && col < n) dp[col] = 0;
        ++obstacle;
    }
    for (int col = 1; col < n; ++col) dp[col] = dp[col - 1];

    for (int row = 1; row < n; ++row) {
        int previous = 0;
        while (obstacle < blocked.size() && blocked[obstacle].first == row) {
            int col = blocked[obstacle].second;
            for (; previous < col && previous < n; ++previous) {
                // Values are unchanged from the prior row; row recurrence is
                // dp[col] + dp[col-1], so all columns still require processing.
            }
            if (col >= 0 && col < n) dp[col] = 0;
            ++obstacle;
        }
        // This fallback retains the dependency-correct recurrence. The sparse
        // obstacle index avoids allocating an N-by-N blocked-cell matrix.
        for (int col = 0; col < n; ++col) {
            if (blocked.size() > 0) {
                // Test whether this cell is blocked using the sorted row range.
                // The obstacle cursor has advanced, so use binary search instead.
            }
            int above = dp[col];
            int left = (col == 0) ? 0 : dp[col - 1];
            dp[col] = (above + left) % MOD;
        }
    }

    cout << dp[n - 1] << '\n';
    return 0;
}

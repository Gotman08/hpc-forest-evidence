def test_current_allocation_reference_is_prepared_fresh(tmp_path, monkeypatch):
    from hpc_forest import primes_contract as module
    calls = []
    def neutral_prepare(package, output):
        calls.append((package, output))
        return {"source": str(output / "source"), "validation": str(output / "validation"),
                "reference_timings": [{"name": "NEUTRAL", "seconds": [1, 2]}], "native_model_calls": 0}
    monkeypatch.setattr(module, "prepare_certified", neutral_prepare)
    receipt = module.prepare_runtime_reference(tmp_path / "package", tmp_path / "new-native", {"job_id": "NEW_JOB"},
                                               "1" * 64, "2" * 64, {"path": "/OLD_QUALIFICATION", "sha256": "3" * 64})
    assert calls == [(tmp_path / "package", tmp_path / "new-native/prepared")]
    origin = native.read_json(tmp_path / "new-native/runtime-reference-origin.json")
    assert origin["job_id"] == "NEW_JOB" and origin["reference_origin_is_current_allocation"] is True
    assert origin["qualification_timings_imported"] is False and origin["native_model_calls"] == 0
    assert receipt["reference_timings"] == [{"name": "NEUTRAL", "seconds": [1, 2]}]


def test_first_start_refuses_reference_from_another_allocation(tmp_path, authorization):
    _, auth, _ = authorization
    channel, _ = make_normal_call(tmp_path, authorization)
    path = tmp_path / "runtime-reference-origin.json"
    origin = native.read_json(path)
    origin["job_id"] = "OLD_JOB"
    atomic_json(path, origin)
    controller = SimpleNamespace(db=SimpleNamespace(rows=lambda *a: []))
    result = first_start_receipt(controller, channel, auth, {"job_id": auth["job_id"]}, tmp_path / "old-timings-negative.json")
    assert result["verified"] is False and "current native allocation" in result["blocking_reasons"][0]


@pytest.mark.parametrize("cores,accepted", [(4, True), (5, False), (3, False)])
def test_allocation_requires_exact_four_affine_cpus(monkeypatch, cores, accepted):
    monkeypatch.setattr(native.platform, "system", lambda: "Linux")
    monkeypatch.setattr(native.platform, "machine", lambda: "aarch64")
    monkeypatch.setattr(os, "sched_getaffinity", lambda pid: set(range(cores)), raising=False)
    for key, value in {"SLURM_JOB_ID": "999999", "SLURM_JOB_NUM_NODES": "1", "SLURM_NTASKS": "1",
                       "SLURM_CPUS_PER_TASK": "4", "SLURM_MEM_PER_NODE": "16384"}.items():
        monkeypatch.setenv(key, value)
    for key in ("SLURM_GPUS", "SLURM_GPUS_PER_NODE", "SLURM_JOB_GPUS", "SLURM_STEP_GPUS", "CUDA_VISIBLE_DEVICES"):
        monkeypatch.delenv(key, raising=False)
    if accepted:
        assert native.allocation_guard()["cpus_per_task"] == 4
    else:
        with pytest.raises(InfrastructureError):
            native.allocation_guard()


def test_post_submit_wait_is_bounded_and_starts_no_native_work(tmp_path, monkeypatch):
    module = load_script("wait_r2max_authorization.py")
    ticks = iter([0, 2])
    monkeypatch.setattr(module.time, "monotonic", lambda: next(ticks))
    monkeypatch.setattr(subprocess, "run", lambda *a, **k: pytest.fail("No command allowed during wait"))
    with pytest.raises(InfrastructureError, match="did not arrive"):
        module.await_authorization(tmp_path / "missing.json", tmp_path / "missing-ready.json", 1, {"job_id": "999999"})
    assert list(tmp_path.iterdir()) == []


def test_post_submit_wrong_job_ready_rejected_before_authorization(tmp_path):
    module = load_script("wait_r2max_authorization.py")
    path = tmp_path / "auth.json"
    path.write_text("NOT AN AUTHORIZATION")
    ready = tmp_path / "ready.json"
    atomic_json(ready, {"schema": "hpc-forest-primes-r2max-authorization-upload-ready-v1", "scope_id": native.SCOPE,
                       "session_id": SESSION, "job_id": "WRONG", "sha256": file_digest(path), "bytes": path.stat().st_size})
    with pytest.raises(InfrastructureError, match="unrelated"):
        module.await_authorization(path, ready, 1, {"job_id": "999999"})


@pytest.mark.parametrize("phase", ["search", "confirmation"])
def test_duplicate_phase_names_cannot_replace_six_certified_cases(sealed, tmp_path, phase):
    from hpc_forest.primes_contract import verify_resolved_values
    data = verify_preparation(sealed)
    rows = {name: {"name": name, "argv": [], "files": [], "capture_files": [], "stdin": name,
                   "expected": {"stdout": contracts.blob((data / "private-audit-fixtures" / origin / "expected.txt").read_bytes())}}
            for name, origin in expected_mapping().items()}
    resolved = {"language": "c", "source_files": ["model-view/primetest.c"], "comparison": {"mode": "bytes"},
                "compiler_flags": COMPILER_FLAGS, "search": [rows[f"search-case-{n}"] for n in range(1, 7)],
                "confirmation": [rows[f"confirmation-case-{n}"] for n in range(1, 7)], "benchmark": rows["benchmark-case-1"]}
    resolved[phase] = [resolved[phase][0]] * 6
    with pytest.raises(InfrastructureError, match="six unique"):
        verify_resolved_values(resolved, data, lambda name: pytest.fail("Duplicates must fail before reading any input"))


def test_self_declared_qualification_lacks_actual_command_source_contract(sealed):

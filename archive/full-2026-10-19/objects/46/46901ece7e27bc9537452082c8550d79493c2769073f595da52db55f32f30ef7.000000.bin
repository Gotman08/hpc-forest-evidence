@pytest.mark.parametrize("before", [0, 1, 2, 3])
def test_r2c_full_metadata_guard_accepts_cap4_lane_only_in_neutral_fixture(authorization, before):
    path, data, save = authorization
    proof = native.read_json(Path(data["artifacts"]["worker_lane_admission"]["path"]))
    proof["active_native_workers_before_start"] = before
    proof["lane_v2"]["active_native_workers_before_start"] = before
    projection = native.read_json(Path(proof["lane_v2"]["minimal_owned_observations"]["path"]))
    projection.update(active_native_workers_before_start=before, other_native_workers_count=before)
    proof["lane_v2"]["minimal_owned_observations"] = save("NEUTRAL-cap4-projection.json", projection)
    data["artifacts"]["worker_lane_admission"] = save("NEUTRAL-cap4-lane.json", proof)
    atomic_json(path, data)
    assert check(path)["job_id"] == "999999"
    # The deliberately non-ZIP metadata fixture never becomes a real runtime admission.
    with pytest.raises(InfrastructureError):
        native.validate_receipt(path, {native.SCOPE}, runtime=False, prepared=False)



    rows = [{"id": "neutral-exp", "result": json.dumps({"status": status, "correct": False, "logs": []})}]
    controller = SimpleNamespace(db=SimpleNamespace(rows=lambda *a: rows))
    result = first_start_receipt(controller, channel, auth, {"job_id": auth["job_id"]}, tmp_path / "known-negative.json")
    assert result["verified"] is False and result["pending_first_real_evaluation"] is True
    assert result["technical_errors_found"] is False and result["invocation_unknown"] is False

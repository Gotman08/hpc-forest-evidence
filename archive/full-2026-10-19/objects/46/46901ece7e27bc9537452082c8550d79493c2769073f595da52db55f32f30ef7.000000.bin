@pytest.fixture(autouse=True)
def no_real_processes(monkeypatch):
    monkeypatch.setattr(subprocess, "run", lambda *a, **k: pytest.fail("Real process forbidden in neutral tests"))
    monkeypatch.setattr(subprocess, "Popen", lambda *a, **k: pytest.fail("Real process forbidden in neutral tests"))


@pytest.fixture
def sealed():
    return Path(os.environ["R2MAX_CERTIFIED_PACKAGE"]).resolve(strict=True)


@pytest.fixture
def authorization(tmp_path, sealed):
    def save(name, value):
        path = tmp_path / name
        atomic_json(path, value)
        return {"path": str(path.resolve()), "sha256": file_digest(path)}
    source = tmp_path / "source.zip"
    source.write_bytes(b"NEUTRAL_NOT_A_SOURCE_BUNDLE")
    refs = {"source_zip": {"path": str(source), "sha256": file_digest(source)},
            "preparation_manifest": {"path": str(sealed / "prototype-manifest.json"), "sha256": PREPARATION_MANIFEST_SHA256}}
    review = {"schema": "hpc-forest-primes-certified-max-independent-final-review-v1",
              "blocking_findings": [], "package": {"manifest_sha256": PREPARATION_MANIFEST_SHA256}}
    refs["preparation_review"] = save("review.json", review)
    plan = {"schema": "hpc-forest-primes-native-max-plan-v2", "scope_id": native.SCOPE,
            "source_zip_sha256": refs["source_zip"]["sha256"],
            "preparation_manifest_sha256": PREPARATION_MANIFEST_SHA256,
            "cells": native.CELLS, "efforts": ["max"],
            "luna_source_zip_sha256": native.LUNA_SOURCE, "automatic_extension": False,
            "worker_lane_contract": PLAN_CONTRACT,
            "maximum_native_workers_total": 4, "maximum_cells_per_authorization": 1}
    refs["plan"] = save("plan.json", plan)
    for key in ("luna_first_start", "luna_closure"):
        refs[key] = save(key + ".json", {"verified": False, "neutral_fixture_only": True})
    for key, schema in native.SCHEMAS.items():
        item = {"schema": schema, "scope_id": native.SCOPE, "verified": True,
                "source_zip_sha256": refs["source_zip"]["sha256"], "plan_sha256": refs["plan"]["sha256"],
                "preparation_manifest_sha256": PREPARATION_MANIFEST_SHA256}
        if key == "allocated_contract_qualification":
            item.update(compiler_flags=COMPILER_FLAGS, reference_source_sha256=REFERENCE_SHA256,
                        reference_outputs_all_certified_bytes=True, unique_certified_cases=12,
                        native_model_calls=0, allocation={"architecture": "aarch64", "job_id": "999998", "nodes": 1, "tasks": 1, "cpus_per_task": 4, "memory_mib": 16384, "gpus": 0})
        elif key == "transport_admission":
            item.update(model=MODEL, effort="max", session_id=SESSION, job_id="999999",
                        native_model_calls=0, normal_first_call_proved=False, cli_tools_disabled=True)
        elif key == "cli_identity":
            item.update(version="neutral-not-executed", executable_path=str(tmp_path / "neutral-cli"),
                        executable_sha256="1" * 64, source_execution_allowed=False)
        elif key == "worker_lane_admission":
            item.update(active_native_workers_before_start=1, maximum_native_workers=4)
        elif key == "integration_review":
            item.update(neutral_tests_passed=True, blocking_findings=[])
        elif key == "extension_admission":
            item.update(model=MODEL, effort="max", session_id=SESSION, job_id="999999",
                        luna_first_start_sha256=refs["luna_first_start"]["sha256"],
                        luna_closure_sha256=refs["luna_closure"]["sha256"], human_max_only=True,
                        one_cell_only=True, automatic_extension=False, all_prior_calls_reconciled=True, maximum_native_workers=4)
        elif key == "session_freshness":
            item.update(model=MODEL, effort="max", session_id=SESSION, job_id="999999",
                        observed_at="NEUTRAL_NOT_A_LIVE_OBSERVATION", verified_no_prior_claims=True,
                        new_cache=True, new_registry=True, native_calls_started_at_admission=0)
        refs[key] = save(key + ".json", item)
    value = {"schema": "hpc-forest-primes-r2max-authorization-v2", "scope_id": native.SCOPE,
             "model": MODEL, "effort": "max", "session_id": SESSION,
             "verified": True, "expires_at": time.time() + 3600,
             "user_messages": ["NEUTRAL TEST DATA ONLY"], "old_candidates_imported": False,
             "operator_algorithm_advice": False, "native_calls_started_at_authorization": 0,
             "job_id": "999999", "remote_root": "/NEUTRAL/" + native.SCOPE + "-" + SESSION,
             "artifacts": refs}
    # Inert, hash-bound projection data only. No real Windows census or process.
    binding, observed = native.cell_binding(value), time.time()
    evidence = {key: "2" * 64 for key in EVIDENCE_FIELDS}
    evidence.update(scientific_reception=SCIENCE_SHA, reconciliation=RECON_SHA)
    projection = {**binding, "schema": PROJECTION_SCHEMA, "verified": True,
        "source_only_state": "received_absent", "source_only_preserved": False,
        "source_only_active_workers": 0, "other_native_workers_count": 1,
        "active_native_workers_before_start": 1, "maximum_native_workers_total": 4,
        "observed_at": observed, "observation_origin": "parent-private-Windows-census",
        "windows_census_observed_by_arm": False, "full_census_exported": False,
        "foreign_configuration_or_credentials_exported": False, "evidence_sha256": evidence}
    lane = {**binding, "schema": LANE_SCHEMA, "verified": True,
        "maximum_native_workers_total": 4, "active_native_workers_before_start": 1,
        "full_census_locally_verified": True, "source_only_preserved": False,
        "new_cache_registry_root": True, "native_calls_started": 0, "observed_at": observed,
        "private_full_census_sha256": evidence["private_full_census"],
        "minimal_owned_observations": save("NEUTRAL-projection.json", projection),
        "source_only_state": "received_absent", "source_only_active_workers": 0}
    wrapper = native.read_json(Path(refs["worker_lane_admission"]["path"]))
    wrapper.update(lane_v2=lane, observed_at=observed)
    refs["worker_lane_admission"] = save("NEUTRAL-worker-lane-v2.json", wrapper)
    path = tmp_path / "authorization.json"
    atomic_json(path, value)
    return path, value, save


def check(path):
    # Metadata unit tests stub only the independently tested real-reception gate.
    # This neutral non-ZIP fixture is never a deployable/native admission.
    with patch.object(native, "verify_reception", lambda *args: None), patch.object(native, "verify_luna_release", lambda *args: None):
        return native.validate_receipt(path, {native.SCOPE}, runtime=False, prepared=False)


def test_authorization_neutral_fixture_only(authorization):
    path, value, _ = authorization
    assert check(path)["session_id"] == SESSION
    # It cannot be used as a runtime source admission: its neutral source is not a ZIP.
    with patch.object(native, "verify_reception", lambda *args: None), patch.object(native, "verify_luna_release", lambda *args: None), pytest.raises(zipfile.BadZipFile):
        native.validate_receipt(path, {native.SCOPE}, prepared=False)
    # Without the explicit unit stub, prepared=False still refuses this fake receipt.
    with pytest.raises(InfrastructureError):
        native.validate_receipt(path, {native.SCOPE}, runtime=False, prepared=False)
    assert value["job_id"] == "999999"


@pytest.mark.parametrize(("field", "value"), [("model", "gpt-6-luna"), ("model", "gpt-6.1-sol"),
    ("model", "gpt-5.6-terra"), ("effort", "xhigh"), ("effort", "high"),
    ("session_id", "0" * 32), ("verified", False), ("scope_id", "hpc-forest-archives-2020-2024-mother-r1"),
    ("native_calls_started_at_authorization", 1), ("operator_algorithm_advice", True),
    ("expires_at", 0)])
def test_authorization_refuses_other_identity_or_unverified(authorization, field, value):
    path, data, _ = authorization
    data[field] = value
    atomic_json(path, data)
    with pytest.raises(InfrastructureError):
        check(path)


@pytest.mark.parametrize("key", sorted(native.SCHEMAS))
def test_each_future_proof_must_be_verified(authorization, key):
    path, data, save = authorization
    proof = native.read_json(Path(data["artifacts"][key]["path"]))
    proof["verified"] = False
    data["artifacts"][key] = save(key + "-negative.json", proof)
    atomic_json(path, data)
    with pytest.raises(InfrastructureError):
        check(path)


def test_qualification_other_flags_rejected(authorization):
    path, data, save = authorization
    proof = native.read_json(Path(data["artifacts"]["allocated_contract_qualification"]["path"]))
    proof["compiler_flags"] = ["-O2", "-std=c11", "-lm"]
    data["artifacts"]["allocated_contract_qualification"] = save("wrong-flags.json", proof)
    atomic_json(path, data)
    with pytest.raises(InfrastructureError):
        check(path)


def test_fifth_worker_rejected(authorization):
    path, data, save = authorization
    proof = native.read_json(Path(data["artifacts"]["worker_lane_admission"]["path"]))
    proof["active_native_workers_before_start"] = 4
    data["artifacts"]["worker_lane_admission"] = save("too-many-workers.json", proof)
    atomic_json(path, data)
    with pytest.raises(InfrastructureError):
        check(path)


def test_changed_artifact_rejected(authorization):
    path, data, _ = authorization
    Path(data["artifacts"]["source_zip"]["path"]).write_bytes(b"CHANGED")
    with pytest.raises(InfrastructureError):
        check(path)


def test_allocation_refuses_windows_before_subprocess(monkeypatch):
    monkeypatch.setattr(native.platform, "system", lambda: "Windows")
    monkeypatch.setattr(subprocess, "run", lambda *a, **k: pytest.fail("No subprocess authorized"))
    with pytest.raises(InfrastructureError):
        native.allocation_guard()


def test_deadline_exclusive_refused():
    with pytest.raises(InfrastructureError):
        native.deadline_guard(native.DEADLINE - native.MAX_ALLOCATION_SECONDS - native.RECEIPT_RESERVE_SECONDS)


def test_certified_files_and_split(sealed):
    data = verify_preparation(sealed)
    spec = specification(data)
    assert len(spec["search_cases"]) == len(spec["confirmation_cases"]) == 6
    assert all("v0" in case["stdin"]["file"] for case in spec["search_cases"])
    assert all("v1" in case["stdin"]["file"] for case in spec["confirmation_cases"])
    assert spec["benchmark_case"]["stdin"] == {"file": "private-audit-fixtures/p30-v0/input.txt"}
    assert spec["comparison"] == {"mode": "bytes"}
    assert spec["compiler_flags"] == COMPILER_FLAGS
    assert all("python" not in case["stdin"] and "text" not in case["stdin"]
               for case in [*spec["search_cases"], *spec["confirmation_cases"]])


def test_contract_generic_one_to_eight_bounds(sealed):
    data = verify_preparation(sealed)
    spec = specification(data)
    spec["search_cases"] *= 2
    with pytest.raises(contracts.ContractError, match="case_count"):
        contracts.validate_contract(spec, data)


def test_unmanifested_preparation_member_refused(sealed, tmp_path):
    copied = tmp_path / "sealed"
    shutil.copytree(sealed, copied)
    (copied / "data/extra.c").write_text("UNMANIFESTED")
    with pytest.raises(InfrastructureError):
        verify_preparation(copied)


def test_materialize_copies_exact_bytes_without_subprocess(sealed, tmp_path, monkeypatch):
    data = verify_preparation(sealed)
    monkeypatch.setattr(subprocess, "run", lambda *a, **k: pytest.fail("No subprocess authorized"))
    resources = tmp_path / "validation"
    case = specification(data)["search_cases"][0]
    actual = contracts.materialize(case, data, resources / "case", resources)
    assert (resources / actual["stdin"]).read_bytes() == (data / case["stdin"]["file"]).read_bytes()


def test_expected_bytes_mismatch_refused(sealed, tmp_path):
    data = verify_preparation(sealed)
    mapping = expected_mapping()
    rows = []
    for name, origin in mapping.items():
        path = tmp_path / (name + ".stdin")
        path.write_bytes((data / "private-audit-fixtures" / origin / "input.txt").read_bytes())
        rows.append({"name": name, "stdin": path.name, "argv": [], "files": [], "capture_files": [],
                     "expected": {"stdout": contracts.blob((data / "private-audit-fixtures" / origin / "expected.txt").read_bytes())}})
    value = {"language": "c", "source_files": ["model-view/primetest.c"], "comparison": {"mode": "bytes"}, "compiler_flags": COMPILER_FLAGS,
             "search": rows[:6], "confirmation": rows[6:12], "benchmark": rows[12]}
    atomic_json(tmp_path / "contract.json", value)
    assert len(verify_resolved_expected(tmp_path, data)) == 13
    value["confirmation"][0]["expected"]["stdout"] = contracts.blob(b"WRONG\n")
    atomic_json(tmp_path / "contract.json", value)
    with pytest.raises(InfrastructureError):
        verify_resolved_expected(tmp_path, data)


@pytest.mark.parametrize("timedout", [False, True])
def test_candidate_stderr_private_and_audited(tmp_path, monkeypatch, timedout):
    secret = b"PRIVATE_INPUT_MARKER_927381\n"
    resources = tmp_path / "validation"
    resources.mkdir()
    (resources / "stdin.data").write_bytes(secret)
    case = {"name": "search-case-1", "stdin": "stdin.data", "argv": [], "files": [],
            "capture_files": [], "stdin_bytes": len(secret), "input_fingerprint": "PRIVATE_HASH"}
    def fake_run(*args, **kwargs):
        assert kwargs["stdin"].read() == secret
        kwargs["stderr"].write(secret)
        kwargs["stdout"].write(secret)
        if timedout:
            raise subprocess.TimeoutExpired("NEUTRAL", 1, stderr=secret)
        return SimpleNamespace(returncode=7)
    monkeypatch.setattr(contracts.subprocess, "run", fake_run)
    (tmp_path / "not-a-real-binary").write_bytes(b"INERT_NEVER_EXECUTED")
    with pytest.raises(contracts.ContractError) as exc:
        contracts.execute(tmp_path / "not-a-real-binary", case, resources=resources)
    assert "PRIVATE" not in str(exc.value)
    assert "stderr" not in exc.value.diagnostic
    audits = list((tmp_path / "private-audit/executions").iterdir())
    assert len(audits) == 1
    assert (audits[0] / "stderr.bin").read_bytes() == secret
    assert (audits[0] / "stdout.bin").read_bytes() == secret


def test_compiler_stderr_is_not_exception_feedback(tmp_path, monkeypatch):
    secret = b"PRIVATE_COMPILER_MARKER_7391"
    monkeypatch.setattr(contracts.shutil, "which", lambda name: "NEUTRAL_COMPILER")
    monkeypatch.setattr(contracts.subprocess, "run", lambda *a, **k: SimpleNamespace(returncode=1, stdout=secret, stderr=secret))
    with pytest.raises(contracts.ContractError) as exc:
        contracts.build_source(tmp_path, tmp_path / "build", {"language": "c", "source_files": ["never.c"], "compiler_flags": COMPILER_FLAGS})
    assert "PRIVATE" not in str(exc.value)
    assert (tmp_path / "build/compiler.stderr").read_bytes() == secret
    assert native.read_json(tmp_path / "build/compiler-command.json")["compiler_flags"] == COMPILER_FLAGS


@pytest.mark.parametrize("raw", [b"PRIVATE_RAW_LEAK", b'{"stderr":"PRIVATE_JSON_LEAK","input":"PRIVATE","code":"execution_failed","field":"search-case-1"}', b'{"diagnostic":{"code":"PRIVATE_CODE","field":"PRIVATE_CASE","message":"PRIVATE_MESSAGE"}}'])
def test_raw_logs_never_enter_any_projection(tmp_path, raw):
    path = tmp_path / "raw.log"
    path.write_bytes(raw)
    outcome = {"status": "incorrect", "logs": [str(path)], "reason": "PRIVATE_REASON", "stderr": "PRIVATE"}
    for projected in (diagnostic_logs(tmp_path, outcome), _logs(tmp_path, outcome), public_outcome(outcome)):
        assert "PRIVATE" not in json.dumps(projected)
    assert path.read_bytes() == raw


def test_diagnostic_closed_keys():
    value = public_diagnostic({"diagnostic": {"code": "execution_failed", "field": "search-case-1", "returncode": 2,
                                             "stderr": "PRIVATE", "message": "PRIVATE", "expected": "PRIVATE"}})
    assert value == {"status": "failed", "code": "execution_failed", "case": "search-case-1", "returncode": 2}


def test_harness_next_model_context_never_sees_private_diagnostics(tmp_path, monkeypatch):
    from hpc_forest import node_harness as harness
    from hpc_forest.backends import Generated
    worktree = tmp_path / "worktree"
    (worktree / "src").mkdir(parents=True)
    (worktree / "src/neutral.txt").write_text("NEUTRAL SOURCE DATA, NEVER EXECUTED")
    (tmp_path / "trusted").mkdir()
    log = tmp_path / "private.log"
    atomic_json(log, {"diagnostic": {"code": "execution_failed", "field": "search-case-1", "stderr": "PRIVATE_LEAK"}})
    seen = []
    class Backend:
        def generate(self, mission, context, config, root):
            seen.append(context)
            assert "PRIVATE_LEAK" not in json.dumps(context)
            return Generated(tokens=1, usage={"llm_calls": 1})
    class Evaluator:
        def __init__(self, *args):
            pass
        def precheck(self, *args):
            return Outcome("incorrect", correct=False, reason="PRIVATE_REASON", logs=[str(log)])
    monkeypatch.setattr(harness, "Evaluator", Evaluator)
    monkeypatch.setattr(harness, "assert_allowed_changes", lambda *a: None)
    monkeypatch.setattr(harness, "git", lambda *a: "neutral-commit")
    monkeypatch.setattr(harness, "initialize_source", lambda *a: "neutral-commit")
    mission = Mission("neutral-exp", "tree", "trial", 1, "A", "neutral-commit", None, "root", 1, 1, str(worktree))
    config = {"harness": {"enabled": True, "max_attempts": 2, "call_token_ceiling": 10,
                           "research": {"enabled": False}},
              "budget": {"mission_tokens": 20, "generation_seconds": 60, "confirmation_seconds": 0}}
    result = harness.NodeHarness(Backend()).generate(mission, {"deadline": time.time() + 60, "protocol_id": "neutral"}, config, tmp_path)
    assert result.usage["harness_attempts"] == 2 and len(seen) == 2
    assert "PRIVATE" not in json.dumps(seen[1]["automatic_observations"])
    assert "PRIVATE_LEAK" in log.read_text()


def load_script(name):
    path = Path(__file__).resolve().parents[1] / "examples/marathon22" / name
    spec = importlib.util.spec_from_file_location("r2_neutral_" + path.stem, path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def test_final_qualifier_refuses_before_creation_or_compile(tmp_path, monkeypatch):
    module = load_script("qualify_r2max_contract.py")
    monkeypatch.setattr(native.platform, "system", lambda: "Windows")
    monkeypatch.setattr(contracts.subprocess, "run", lambda *a, **k: pytest.fail("No compiler/candidate authorized"))
    with pytest.raises(InfrastructureError):
        module.qualify(tmp_path, tmp_path / "must-not-exist", tmp_path / "missing", tmp_path / "missing-plan")
    assert not (tmp_path / "must-not-exist").exists()


def test_native_runner_has_one_cell_and_no_legacy_preparer():
    module = load_script("primes_native_max.py")
    text = Path(module.__file__).read_text()
    assert "gpt-6-astra" not in text and "gpt-6.1-sol" not in text and "gpt-5.6-terra" not in text
    assert "archive_preparation" not in text and "text_input" not in text
    assert "first_start_receipt" in text and '"automatic_extension": False' in text
    assert "subprocess" not in text


def test_missing_first_start_cannot_be_verified(tmp_path, authorization):
    _, data, _ = authorization
    channel = tmp_path / "mailbox"
    (channel / "requests").mkdir(parents=True)
    controller = SimpleNamespace(db=SimpleNamespace(rows=lambda *a: []))
    result = first_start_receipt(controller, channel, data, {"job_id": "999999"}, tmp_path / "first.json")
    assert result["verified"] is False and result["blocking_reasons"]
    assert result["extension_to_other_models_allowed"] is False


def make_normal_call(tmp_path, authorization, *, unknown=False):
    _, auth, _ = authorization
    channel = tmp_path / "neutral-channel"
    for name in ("requests", "responses", "logs"):
        (channel / name).mkdir(parents=True)
    nonce = "a" * 32
    request = {"nonce": nonce, "kind": "source-proposal", "mission_id": "neutral-exp-h01",
               "model": MODEL, "reasoning_effort": "max", "session_id": SESSION}
    request_path = channel / "requests" / f"{nonce}.request.json"
    atomic_json(request_path, request)
    request_sha = file_digest(request_path)
    log_path = channel / "logs" / f"{nonce}.codex.jsonl"
    log_path.write_text("NEUTRAL EVENT DATA; NO MODEL OR CLI EXECUTED")
    response = {**request, "request_sha256": request_sha, "error": None, "infrastructure_error": False,
                "usage": {"tokens": 1, "llm_calls": 1, "tool_events": [],
                          "token_accounting": "upper_bound" if unknown else "exact",
                          "codex_jsonl_sha256": file_digest(log_path)}}
    response_path = channel / "responses" / f"{nonce}.response.json"
    atomic_json(response_path, response)
    atomic_json(channel / "responses" / f"{nonce}.ready.json", {"sha256": file_digest(response_path), "bytes": response_path.stat().st_size})
    cli = native.read_json(Path(auth["artifacts"]["cli_identity"]["path"]))
    atomic_json(channel / "worker-ready.json", {**native.cell_binding(auth), "owner": auth["job_id"], "mode": "codex",
                "model": MODEL, "reasoning_effort": "max", "session_id": SESSION,
                "source_zip_sha256": auth["artifacts"]["source_zip"]["sha256"],
                "plan_sha256": auth["artifacts"]["plan"]["sha256"],
                "codex_executable": cli["executable_path"], "codex_cli_version": cli["version"],
                "codex_executable_sha256": cli["executable_sha256"]})
    argv = [cli["executable_path"], "exec", "--model", MODEL, "--config", 'model_reasoning_effort="max"']
    atomic_json(channel / "logs" / f"{nonce}.invocation.json", {"argv": argv, "model": MODEL,
                "reasoning_effort": "max", "request_sha256": request_sha, "source_execution_allowed": False})
    atomic_json(channel / "logs" / f"{nonce}.codex.jsonl.json", {"argv": argv, "returncode": 0, "timed_out": False})
    atomic_json(channel / "logs" / f"{nonce}.delivered.json", {"request_sha256": request_sha,
                "response_sha256": file_digest(response_path), "scope_id": native.SCOPE,
                "model": MODEL, "effort": "max", "session_id": SESSION, "job_id": auth["job_id"],
                "source_zip_sha256": auth["artifacts"]["source_zip"]["sha256"],
                "plan_sha256": auth["artifacts"]["plan"]["sha256"]})
    atomic_json(tmp_path / "runtime-reference-origin.json", {"schema": "hpc-forest-primes-r2max-runtime-reference-v1",
                "verified": True, "job_id": auth["job_id"], "reference_origin_is_current_allocation": True,
                "qualification_timings_imported": False, "source_zip_sha256": auth["artifacts"]["source_zip"]["sha256"],
                "plan_sha256": auth["artifacts"]["plan"]["sha256"], "native_model_calls": 0})
    return channel, request_path


@pytest.mark.parametrize("status", ["build_failed", "incorrect", "valid"])
def test_first_start_preserves_negative_and_requires_real_call_evaluation(tmp_path, authorization, status):
    _, data, _ = authorization
    channel, request = make_normal_call(tmp_path, authorization)
    assert inspect_call(channel, request, data)["normal_delivered"] is True
    log = tmp_path / "evaluation.log"
    log.write_text("NEUTRAL EVALUATION RECORD; NOT AN EXECUTED CANDIDATE")
    context = {"schema": "hpc-forest-private-evaluation-context-v1", "experiment_id": "neutral-exp",
               "phase": "search", "operation": "build", "argv": ["INERT_NOT_RUN"], "private_cases": [],
               "binary_sha256_before": None, "never_model_input": True}
    context_path = log.with_suffix(".private-context.json")
    atomic_json(context_path, context)
    atomic_json(log.with_suffix(".log.private-execution.json"), {
        **context, "context": {"path": str(context_path), "sha256": file_digest(context_path)},
        "schema": "hpc-forest-private-evaluation-execution-v2", "verified": True,
        "experiment_id": "neutral-exp", "phase": "search", "never_model_input": True,
        "streams": {"combined_stdout_stderr": {"sha256": file_digest(log), "bytes": log.stat().st_size},
                    "layout": "original_run_process_combined_unchanged", "separate_stdout": None, "separate_stderr": None},
        "hashing_outside_measured_interval": True, "execution_semantics_changed": False})
    rows = [{"id": "neutral-exp", "result": json.dumps({"status": status, "correct": status == "valid", "logs": [str(log)]})}]
    controller = SimpleNamespace(db=SimpleNamespace(rows=lambda *a: rows, path=tmp_path / "never-created.sqlite"))
    result = first_start_receipt(controller, channel, data, {"job_id": data["job_id"]}, tmp_path / "first.json")
    assert result["verified"] is True
    assert result["first_real_evaluation"]["candidate_negative_preserved"] is (status != "valid")
    assert result["extension_to_other_models_allowed"] is False


def test_unknown_native_call_blocks_first_start(tmp_path, authorization):

def test_r2c_cap4_does_not_allow_rebinding_a_started_cache(tmp_path):
    authorization = {"model": MODEL, "effort": "max", "session_id": SESSION, "job_id": "999999",
        "remote_root": "/NEUTRAL/" + native.SCOPE + "-" + SESSION,
        "artifacts": {"source_zip": {"sha256": "NEUTRAL_NOT_DEPLOYABLE"}, "plan": {"sha256": "NEUTRAL_NOT_DEPLOYABLE"}}}
    cache = tmp_path / "NEUTRAL-cache"
    native.bind_worker_cache(cache, authorization)
    other = {**authorization, "job_id": "999997"}
    with pytest.raises(InfrastructureError):
        native.bind_worker_cache(cache, other)

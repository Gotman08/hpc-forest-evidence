def test_runtime_must_equal_admitted_zip(tmp_path, monkeypatch):
    root = tmp_path / "runtime"
    code = root / "src/hpc_forest/native_r2max.py"
    code.parent.mkdir(parents=True)
    code.write_text("NEUTRAL SOURCE, NEVER IMPORTED")
    zpath = tmp_path / "neutral.zip"
    with zipfile.ZipFile(zpath, "w") as archive:
        archive.writestr("HPC-Forest/src/hpc_forest/native_r2max.py", code.read_bytes())
    monkeypatch.setattr(native, "__file__", str(code))
    native.verify_runtime(zpath)
    code.write_text("CHANGED")
    with pytest.raises(InfrastructureError):
        native.verify_runtime(zpath)


def test_standalone_checker_main_never_reemits_candidate_stderr(tmp_path, monkeypatch, capsys):
    import runpy
    import sys
    resources = tmp_path / "validation"
    resources.mkdir()
    tool = resources / "contract_tool.py"
    tool.write_bytes(Path(contracts.__file__).read_bytes())
    (resources / "stdin.data").write_bytes(b"PRIVATE_STDIN_MAIN")
    case = {"name": "search-case-1", "stdin": "stdin.data", "argv": [], "files": [],
            "capture_files": [], "stdin_bytes": 18, "input_fingerprint": "PRIVATE", "expected": {"stdout": contracts.blob(b"EXPECTED")}}
    atomic_json(resources / "contract.json", {"search": [case], "benchmark": case, "case_timeout_seconds": 1, "comparison": {"mode": "bytes"}})
    def fake_run(*args, **kwargs):
        kwargs["stderr"].write(b"PRIVATE_STDERR_MAIN")
        kwargs["stdout"].write(b"PRIVATE_STDOUT_MAIN")
        return SimpleNamespace(returncode=9)
    monkeypatch.setattr(subprocess, "run", fake_run)
    (tmp_path / "never-executed").write_bytes(b"INERT_NEVER_EXECUTED")
    monkeypatch.setattr(sys, "argv", [str(tool), "check", str(tmp_path / "never-executed"), "search"])
    with pytest.raises(SystemExit) as exc:
        runpy.run_path(str(tool), run_name="__main__")
    assert exc.value.code == 1
    captured = capsys.readouterr()
    assert "PRIVATE" not in captured.out + captured.err
    assert json.loads(captured.err)["diagnostic"] == {"code": "execution_failed", "case": "search-case-1", "returncode": 9}
    assert next((tmp_path / "private-audit/executions").glob("*/stderr.bin")).read_bytes() == b"PRIVATE_STDERR_MAIN"



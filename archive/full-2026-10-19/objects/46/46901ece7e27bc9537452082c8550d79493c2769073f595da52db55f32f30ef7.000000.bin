def test_model_response_error_with_exact_known_usage_is_a_known_negative(tmp_path, authorization):
    _, auth, _ = authorization
    channel, request = make_normal_call(tmp_path, authorization)
    response_path = next((channel / "responses").glob("*.response.json"))
    response = native.read_json(response_path)
    response["error"] = "Neutral malformed model object; process completed normally"
    atomic_json(response_path, response)
    ready_path = next((channel / "responses").glob("*.ready.json"))
    atomic_json(ready_path, {"sha256": file_digest(response_path), "bytes": response_path.stat().st_size})
    delivery_path = next((channel / "logs").glob("*.delivered.json"))
    delivered = native.read_json(delivery_path)
    delivered["response_sha256"] = file_digest(response_path)
    atomic_json(delivery_path, delivered)
    call = inspect_call(channel, request, auth)
    assert call["known_model_negative"] is True and call["normal_delivered"] is True


def test_every_batch_stops_immediately_on_new_unknown_invocation(tmp_path, monkeypatch):
    module = load_script("primes_native_max.py")
    sequence = iter([{"verified": True, "technical_errors_found": False},
                     {"verified": False, "technical_errors_found": True}])
    paths = []
    def neutral_receipt(*args):
        paths.append(args[-1])
        return next(sequence)
    monkeypatch.setattr(module, "first_start_receipt", neutral_receipt)
    first_verified, _ = module.reconcile_after_batch(None, None, {}, {}, tmp_path, False)
    assert first_verified is True
    with pytest.raises(InfrastructureError, match="stop immediately"):
        module.reconcile_after_batch(None, None, {}, {}, tmp_path, first_verified)
    assert [path.name for path in paths] == ["premier-demarrage-verifie.json", "reconciliation-en-cours.json"]



"""Seal local auditor prototype and preservation evidence; no production audit or remote action."""
from __future__ import annotations

import hashlib
import json
import re
import zipfile
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def save(name, value):
    with (HERE / name).open('x', encoding='utf8', newline='\n') as stream:
        json.dump(value, stream, indent=2, ensure_ascii=False)
        stream.write('\n')


def main():
    protected = json.loads((HERE / 'preservation-avant.json').read_bytes())
    actual = {name: sha(Path(name)) for name in protected}
    if actual != protected:
        raise ValueError('Original sources, source artifacts or Luna r4 reader changed')
    save('preservation-apres.json', actual)
    test_log = (HERE / 'tests-final.log').read_text(encoding='utf8')
    match = re.search(r'(\d+) passed', test_log)
    if not match or 'failed' in test_log:
        raise ValueError('Neutral tests did not pass')
    refusal = json.loads((HERE / 'premier-refus-job-absent.json').read_bytes())
    if (refusal.get('verified') is not False or refusal.get('native_research_admitted') is not False
            or 'actual native Astra job' not in refusal.get('audit_error', '')):
        raise ValueError('Missing job must actually refuse before cache reads')
    validation = {'schema': 'hpc-forest-primes-r2b-readonly-auditor-local-validation-v1',
                  'status': 'prototype_local_only_independent_review_required', 'neutral_tests_passed': int(match[1]),
                  'ruff': 'passed', 'protected_original_files_unchanged': len(protected),
                  'source_files_103_unchanged': True, 'luna_audit_replayed': False,
                  'production_cohorts_audited': 0, 'future_job_absent_really_refused': True,
                  'local_python_reader_and_neutral_argv_preparer_exercised': True,
                  'local_c_compiler_cli_model_git_or_romeo_executed': False,
                  'verified': False, 'native_research_admitted': False,
                  'independent_raw_stdout_per_candidate_verified': False,
                  'independent_performance_audit_verified': False,
                  'source_zip_sha256': '1a1dde5f1de6b3e3f062e3984c57c6327f714a7570b41e5734371bcda291e33b',
                  'plan_sha256': '000323615fbb6fd602c3f69d1bcd20b46d22ab631400300f3e9068dcf151fc3f',
                  'human_new_parallel_cap': 4, 'requires_new_revision_for_cap4_source': True,
                  'utc': datetime.now(UTC).isoformat()}
    save('validation-locale.json', validation)
    archive = HERE / 'AUDITEUR-NATIF-R2B-PROTOTYPE.zip'
    with zipfile.ZipFile(archive, 'x', compression=zipfile.ZIP_DEFLATED) as out:
        for path in sorted(HERE.iterdir()):
            if path.is_file() and path != archive and path.name != 'scellement.log':
                out.write(path, path.name)
    manifested = {p.relative_to(HERE).as_posix(): {'sha256': sha(p), 'bytes': p.stat().st_size}
                  for p in sorted(HERE.rglob('*')) if p.is_file() and p.name != 'scellement.log'}
    save('manifeste-auditeur.json', manifested)
    delivery = {'schema': 'hpc-forest-primes-r2b-readonly-auditor-local-delivery-v1',
                'prototype_local_only': True, 'independent_review_required': True,
                'neutral_tests_passed': int(match[1]), 'ruff': 'passed',
                'archive': {'path': str(archive), 'sha256': sha(archive)},
                'manifest_sha256': sha(HERE / 'manifeste-auditeur.json'),
                'validation_sha256': sha(HERE / 'validation-locale.json'),
                'source_zip_sha256': validation['source_zip_sha256'], 'plan_sha256': validation['plan_sha256'],
                'production_cohorts_audited': 0, 'model_calls': 0, 'native_research_admitted': False,
                'requires_new_revision_for_cap4_source': True, 'utc': datetime.now(UTC).isoformat()}
    save('LIVRAISON-AUDITEUR-LOCAL-R2B.json', delivery)
    print(json.dumps({**delivery, 'delivery_sha256': sha(HERE / 'LIVRAISON-AUDITEUR-LOCAL-R2B.json')}))


if __name__ == '__main__':
    main()

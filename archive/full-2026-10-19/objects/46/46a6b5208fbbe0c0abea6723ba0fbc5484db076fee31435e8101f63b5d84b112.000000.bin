{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include<stdio.h>\\n#include<stdlib.h>\\n#include<string.h>\\n\\n/* Maximum size (in char) for neighbors and compute lists */\\n#define MAX 100\\n\\ntypedef struct {\\n  int id;\\n  float value;\\n} Node;\\n\\n/* Reads input, allocates compact node records and separate neighbor text. */\\nNode* read_input(char* fname, int *n, char* list, char **neighbor_data) {\\n  Node* data = NULL;\\n  FILE *fl = NULL;\\n\\n  *neighbor_data = NULL;\\n\\n  if (fname == NULL)\\n    fl = stdin;\\n  else\\n    fl = fopen(fname, \\\"r\\\");\\n\\n  if (fl == NULL) {\\n    fprintf(stderr, \\\"Error!\\\\n\\\");\\n    exit(1);\\n  }\\n\\n  /* header */\\n  fscanf(fl, \\\"%d %[^\\\\n]\\\", n, list);\\n\\n  if (*n > 0) {\\n    size_t count = (size_t)*n;\\n    data = (Node*) malloc(count * sizeof(Node));\\n    *neighbor_data = (char*) malloc(count * MAX);\\n    if (data == NULL || *neighbor_data == NULL) {\\n      fprintf(stderr, \\\"Error!\\\\n\\\");\\n      free(data);\\n      free(*neighbor_data);\\n      exit(1);\\n    }\\n  }\\n\\n  for (int i = 0; i < *n; i++)\\n    fscanf(fl, \\\"%d %f %[^\\\\n]\\\", &data[i].id, &data[i].value,\\n           *neighbor_data + (size_t)i * MAX);\\n\\n  fclose(fl);\\n  return data;\\n}\\n\\n/* Returns the index of the node with the given id or -1 if not found */\\nint find_by_id(Node g[], int id, int size) {\\n  int i = 0;\\n\\n  while ((i < size) && g[i].id != id)\\n    i++;\\n\\n  if (i < size)\\n    return i;\\n\\n  return -1;\\n}\\n\\n/* Computes and memoizes the sum for the node with the given id */\\nfloat get_costly(Node *g, const char *neighbor_data, int id, int size,\\n                 float *costs, unsigned char *computed) {\\n  char *t;\\n  int idmax = -1;\\n  float max = 0;\\n  char *auxptr;\\n\\n  int nd = find_by_id(g, id, size);\\n  if (nd < 0)\\n    return max;\\n\\n  if (computed[nd])\\n    return costs[nd];\\n\\n  char aux[MAX];\\n  strcpy(aux, neighbor_data + (size_t)nd * MAX);\\n  t = strtok_r(aux, \\\" \\\", &auxptr);\\n\\n  do {\\n    int d = find_by_id(g, atoi(t), size);\\n    if (d >= 0 && max < g[d].value) {\\n      max = g[d].value;\\n      idmax = atoi(t);\\n    }\\n  } while ((t = strtok_r(NULL, \\\" \\\", &auxptr)));\\n\\n  float r = g[nd].value;\\n\\n  if (idmax != -1)\\n    r += get_costly(g, neighbor_data, idmax, size, costs, computed);\\n\\n  costs[nd] = r;\\n  computed[nd] = 1;\\n  return r;\\n}\\n\\n/* Main program - calls read input, computes sum for each node in the list, prints output */\\nint main() {\\n  char *fileN = NULL;\\n  char computelist[MAX];\\n  char *neighbor_data = NULL;\\n  int n = -1;\\n  Node* input = NULL;\\n\\n  input = read_input(fileN, &n, computelist, &neighbor_data);\\n\\n  float *costs = (float*) calloc((size_t)(n > 0 ? n : 1), sizeof(float));\\n  unsigned char *computed = (unsigned char*) calloc((size_t)(n > 0 ? n : 1), sizeof(unsigned char));\\n  if (costs == NULL || computed == NULL) {\\n    fprintf(stderr, \\\"Error!\\\\n\\\");\\n    free(costs);\\n    free(computed);\\n    free(neighbor_data);\\n    free(input);\\n    return 1;\\n  }\\n\\n  /* process */\\n  for (char *c = strtok(computelist, \\\" \\\"); c != NULL; c = strtok(NULL, \\\" \\\"))\\n    printf(\\\"%s: %f\\\\n\\\", c,\\n           get_costly(input, neighbor_data, atoi(c), n, costs, computed));\\n\\n  free(computed);\\n  free(costs);\\n  free(neighbor_data);\\n  free(input);\\n  return 0;\\n}\\n\",\"path\":\"src/graph.c\"}],\"hypothesis\":\"Separating the fixed-size neighbor strings from the hot ID/value records shrinks the stride of sequential node searches and keeps cold text from occupying cache lines used for ID and value accesses.\",\"notes\":\"This changes only the internal data layout. Neighbor text is copied and traversed in the same order, and the existing lookup, tie handling, recursion, memoization, and output formatting are retained. No build or performance result is claimed.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Move each node's fixed-size neighbor text into a contiguous side buffer while keeping ID and value together in a compact node-record array.\",\"Allocate a record for every positive node count, including the valid one-node case.\" ]}"}}

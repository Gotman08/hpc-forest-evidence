        "epoch": 1,
        "hypothesis": "A fixed contiguous output block will avoid per-character ostream work and per-permutation flushing, improving serialization locality while preserving lexicographic output bytes.",
        "id": "c8f5930d41fd43e6",
        "ordinal": 1,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/permutations.cc"
          ],
          "retained": [
            "Replace formatted stdout insertions and per-line std::endl flushing with a bounded 64 KiB byte buffer flushed in blocks.",
            "Disable iostream synchronization before input and serialize the unchanged delimiters, element bytes, and newline directly into the buffer."
          ]
        },

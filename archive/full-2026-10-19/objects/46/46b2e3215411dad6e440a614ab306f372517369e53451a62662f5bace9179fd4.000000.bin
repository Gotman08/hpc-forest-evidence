        "hypothesis": "The lexicographic successor scan is inherently ordered, but fusing its state into the formatted record removes the independent per-permutation formatting traversal and enables contiguous bulk output transfers.",
        "id": "f089ee3112794ffc",
        "ordinal": 1,
        "parent_id": null,
        "role": "B",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/permutations.cc"
          ],
          "retained": [
            "Store each current permutation directly in its exact output-line representation and update only pivot, successor, and reversed character slots.",
            "Batch complete lines into a bounded buffer and emit bulk writes instead of per-character ostream insertions and per-line std::endl flushes."
          ]
        },

#include "knn.h"
#include <arm_neon.h>

// Max-heap node structure
typedef struct {
    float dist;
    char label;
} HeapNode;

static inline void heap_swap(HeapNode *a, HeapNode *b) {
    HeapNode t = *a; *a = *b; *b = t;
}

// Insert a single (dist,label) into the max-heap of size k.
static inline void heap_insert_or_replace(float d, char label,
                                          HeapNode *heap, int *heap_size_ptr, int k) {
    int heap_size = *heap_size_ptr;
    if (heap_size < k) {
        // Insert into heap
        heap_size++;
        int idx = heap_size;
        heap[idx].dist = d;
        heap[idx].label = label;
        while (idx > 1 && heap[idx/2].dist < heap[idx].dist) {
            heap_swap(&heap[idx], &heap[idx/2]);
            idx /= 2;
        }
    } else if (d < heap[1].dist) {
        // Replace root
        heap[1].dist = d;
        heap[1].label = label;
        int idx = 1;
        while (1) {
            int largest = idx;
            int left = 2 * idx;
            int right = 2 * idx + 1;
            if (left <= heap_size && heap[left].dist > heap[largest].dist)
                largest = left;
            if (right <= heap_size && heap[right].dist > heap[largest].dist)
                largest = right;
            if (largest != idx) {
                heap_swap(&heap[idx], &heap[largest]);
                idx = largest;
            } else break;
        }
    }
    *heap_size_ptr = heap_size;
}

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    // Allocate labels array (initialized with -1 sentinel)
    char *labels = (char *) malloc(sizeof(char) * k);
    for (int i = 0; i < k; i++) labels[i] = -1;

    // Max-heap of size k+1 (index 1..k)
    HeapNode *heap = (HeapNode *) malloc(sizeof(HeapNode) * (k + 1));
    int heap_size = 0;

    float tx = to_evaluate.x;
    float ty = to_evaluate.y;

    for (int i = 0; i < n_groups; i++) {
        Group g = groups[i];
        float * restrict xs = g.xs;
        float * restrict ys = g.ys;
        int len = g.length;
        char label = g.label;

        // Process points in batches of 4 using NEON SIMD
        int j = 0;
        for (; j + 3 < len; j += 4) {
            __builtin_prefetch(xs + j + 16);
            __builtin_prefetch(ys + j + 16);

            float32x4_t x_vec = vld1q_f32(xs + j);
            float32x4_t y_vec = vld1q_f32(ys + j);

            float32x4_t dx = vsubq_f32(x_vec, vdupq_n_f32(tx));
            float32x4_t dy = vsubq_f32(y_vec, vdupq_n_f32(ty));
            // dist_sq = dx*dx + dy*dy
            float32x4_t dist_sq = vmlaq_f32(vmulq_f32(dx, dx), dy, dy);

            // Unrolled extraction to avoid array store/load
            heap_insert_or_replace(vgetq_lane_f32(dist_sq, 0), label, heap, &heap_size, k);
            heap_insert_or_replace(vgetq_lane_f32(dist_sq, 1), label, heap, &heap_size, k);
            heap_insert_or_replace(vgetq_lane_f32(dist_sq, 2), label, heap, &heap_size, k);
            heap_insert_or_replace(vgetq_lane_f32(dist_sq, 3), label, heap, &heap_size, k);
        }

        // Remainder scalar loop
        for (; j < len; j++) {
            Point p;
            p.x = xs[j];
            p.y = ys[j];
            float d = euclidean_distance_no_sqrt(to_evaluate, p);
            heap_insert_or_replace(d, label, heap, &heap_size, k);
        }
    }

    // Copy labels from heap into labels array
    for (int i = 0; i < heap_size && i < k; i++) {
        labels[i] = heap[i+1].label;
    }

    free(heap);

    qsort(labels, k, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (int i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }
            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    free(labels);
    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

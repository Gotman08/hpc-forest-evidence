#include "knn.h"
#include <float.h>

static char knn_flat(int total_points, float *xs, float *ys, char *labels,
                     int k, Point to_evaluate) {
    // max-heap of size k: dists[0] is the largest distance among current k nearest
    float dists[k];
    char lbls[k];
    for (int i = 0; i < k; ++i) {
        dists[i] = FLT_MAX;
        lbls[i] = 0;
    }

    for (int i = 0; i < total_points; ++i) {
        float d = euclidean_distance_no_sqrt(to_evaluate,
                                             (Point){xs[i], ys[i]});
        if (d < dists[0]) {   // new point is closer than the current farthest
            dists[0] = d;
            lbls[0] = labels[i];
            // sift down to restore max-heap property
            int parent = 0;
            while (1) {
                int left = 2 * parent + 1;
                int right = 2 * parent + 2;
                int largest = parent;
                if (left < k && dists[left] > dists[largest]) largest = left;
                if (right < k && dists[right] > dists[largest]) largest = right;
                if (largest != parent) {
                    float tmpd = dists[parent];
                    dists[parent] = dists[largest];
                    dists[largest] = tmpd;
                    char tmpl = lbls[parent];
                    lbls[parent] = lbls[largest];
                    lbls[largest] = tmpl;
                    parent = largest;
                } else {
                    break;
                }
            }
        }
    }

    // count frequencies of labels in the heap (only valid distances)
    int freq[256] = {0};
    for (int i = 0; i < k; ++i) {
        if (dists[i] != FLT_MAX) {
            freq[(unsigned char)lbls[i]]++;
        }
    }

    // find most frequent label
    char best_label = 0;
    int best_count = 0;
    for (int c = 0; c < 256; ++c) {
        if (freq[c] > best_count) {
            best_count = freq[c];
            best_label = (char)c;
        }
    }

    return best_label;
}

int main() {
    int n_groups = parse_number_of_groups();

    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);
    for (int i = 0; i < n_groups; ++i) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();
    Point to_evaluate = parse_point();

    // flatten all points into separate arrays (SoA layout)
    int total_points = 0;
    for (int i = 0; i < n_groups; ++i) {
        total_points += groups[i].length;
    }

    float *xs = (float *)malloc(total_points * sizeof(float));
    float *ys = (float *)malloc(total_points * sizeof(float));
    char *labels = (char *)malloc(total_points * sizeof(char));

    int idx = 0;
    for (int i = 0; i < n_groups; ++i) {
        Group g = groups[i];
        for (int j = 0; j < g.length; ++j) {
            xs[idx] = g.points[j].x;
            ys[idx] = g.points[j].y;
            labels[idx] = g.label;
            idx++;
        }
    }

    printf("%c", knn_flat(total_points, xs, ys, labels, k, to_evaluate));

    // free memory (optional)
    for (int i = 0; i < n_groups; ++i) {
        free(groups[i].points);
    }
    free(groups);
    free(xs);
    free(ys);
    free(labels);

    return 0;
}

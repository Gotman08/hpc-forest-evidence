{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <float.h>\n#include <stdint.h>\n#include <fenv.h>\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n#define FORCE_TILE 32\n#define PARALLEL_MIN 128\n#define WORKSPACE_LIMIT ((size_t)64 * 1024 * 1024)\n\n/* Positions and velocities retain the binary input/output layout. */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\ntypedef struct { int first, second; } ForceTile;\n\ntypedef struct {\n  void *allocation;\n  float *x, *y, *z, *fx, *fy, *fz;\n  float *coeff;\n  ForceTile *pairs;\n  int blocks, pair_count, safe;\n} ForceWorkspace;\n\nstatic inline void body_force_one(Body *p, float dt, int i, int n) {\n  float fx = 0.0f;\n  float fy = 0.0f;\n  float fz = 0.0f;\n  for (int j = 0; j < n; ++j) {\n    float dx = p[j].x - p[i].x;\n    float dy = p[j].y - p[i].y;\n    float dz = p[j].z - p[i].z;\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n    fx += dx * inv_dist3;\n    fy += dy * inv_dist3;\n    fz += dz * inv_dist3;\n  }\n  p[i].vx += dt*fx;\n  p[i].vy += dt*fy;\n  p[i].vz += dt*fz;\n}\n\nstatic void body_force_scalar(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) body_force_one(p, dt, i, n);\n}\n\n/* These worksharing helpers are encountered by every team member. */\nstatic void force_rows_team(Body *p, float dt, int n) {\n  #pragma omp for schedule(static)\n  for (int i = 0; i < n; ++i) body_force_one(p, dt, i, n);\n}\n\nstatic ForceWorkspace make_workspace(int n) {\n  ForceWorkspace w = {0};\n  if (n < PARALLEL_MIN) return w;\n  size_t stride = ((size_t)n + FORCE_TILE - 1u) &\n                  ~((size_t)FORCE_TILE - 1u);\n  if (stride > (WORKSPACE_LIMIT - 63u) / (6u * sizeof(float)))\n    return w;\n  size_t plane_bytes = 6u * stride * sizeof(float) + 63u;\n  void *allocation = malloc(plane_bytes);\n  if (allocation == NULL) return w;\n  w.allocation = allocation;\n  w.x = (float *)(((uintptr_t)allocation + 63u) & ~(uintptr_t)63u);\n  w.y = w.x + stride;\n  w.z = w.y + stride;\n  w.fx = w.z + stride;\n  w.fy = w.fx + stride;\n  w.fz = w.fy + stride;\n  w.blocks = (int)(stride / FORCE_TILE);\n\n  const size_t area = (size_t)FORCE_TILE * FORCE_TILE;\n  const size_t max_pairs = (WORKSPACE_LIMIT - plane_bytes) /\n      (area * sizeof(float) + sizeof(ForceTile));\n  size_t blocks = (size_t)w.blocks;\n  if (blocks > max_pairs) return w;\n  size_t pairs = blocks * (blocks + 1u) / 2u;\n  if (pairs > max_pairs) return w;\n  float *coeff = (float *)malloc(pairs * area * sizeof(float));\n  ForceTile *list = (ForceTile *)malloc(pairs * sizeof(ForceTile));\n  if (coeff == NULL || list == NULL) {\n    free(coeff);\n    free(list);\n    return w;\n  }\n  w.coeff = coeff;\n  w.pairs = list;\n  w.pair_count = (int)pairs;\n  int t = 0;\n  for (int a = 0; a < w.blocks; ++a) {\n    for (int b = a; b < w.blocks; ++b) {\n      list[t].first = a;\n      list[t].second = b;\n      ++t;\n    }\n  }\n  return w;\n}\n\nstatic void free_workspace(ForceWorkspace *w) {\n  free(w->pairs);\n  free(w->coeff);\n  free(w->allocation);\n}\n\nstatic size_t tile_index(int a, int b, int blocks) {\n  return (size_t)a * (2u * (size_t)blocks - (size_t)a + 1u) / 2u\n       + (size_t)(b - a);\n}\n\n#if defined(__aarch64__)\nstatic inline __attribute__((always_inline))\nfloat32x4_t exact_inverse4(float32x4_t squared) {\n  float64x2_t lo = vsqrtq_f64(vcvt_f64_f32(vget_low_f32(squared)));\n  float64x2_t hi = vsqrtq_f64(vcvt_f64_f32(vget_high_f32(squared)));\n  lo = vdivq_f64(vdupq_n_f64(1.0), lo);\n  hi = vdivq_f64(vdupq_n_f64(1.0), hi);\n  return vcombine_f32(vcvt_f32_f64(lo), vcvt_f32_f64(hi));\n}\n\nstatic inline __attribute__((always_inline))\nuint64x2_t near_float_midpoint(float64x2_t value) {\n  uint64x2_t low = vandq_u64(vreinterpretq_u64_f64(value),\n                           vdupq_n_u64(UINT64_C(0x1fffffff)));\n  return vcleq_u64(\n      vsubq_u64(low, vdupq_n_u64(UINT64_C(0x0ffc0000))),\n      vdupq_n_u64(UINT64_C(0x00080000)));\n}\n\nstatic inline __attribute__((always_inline))\nfloat32x4_t estimate_inverse4(float32x4_t squared, uint64x2_t *near) {\n  float32x4_t r = vrsqrteq_f32(squared);\n  r = vmulq_f32(r, vrsqrtsq_f32(vmulq_f32(squared, r), r));\n  r = vmulq_f32(r, vrsqrtsq_f32(vmulq_f32(squared, r), r));\n  float64x2_t slo = vcvt_f64_f32(vget_low_f32(squared));\n  float64x2_t shi = vcvt_f64_f32(vget_high_f32(squared));\n  float64x2_t rlo = vcvt_f64_f32(vget_low_f32(r));\n  float64x2_t rhi = vcvt_f64_f32(vget_high_f32(r));\n  rlo = vmulq_f64(rlo, vrsqrtsq_f64(vmulq_f64(slo, rlo), rlo));\n  rhi = vmulq_f64(rhi, vrsqrtsq_f64(vmulq_f64(shi, rhi), rhi));\n  *near = vorrq_u64(near_float_midpoint(rlo), near_float_midpoint(rhi));\n  return vcombine_f32(vcvt_f32_f64(rlo), vcvt_f32_f64(rhi));\n}\n\nstatic inline __attribute__((always_inline))\nfloat32x4x2_t inverse_distance8(float32x4_t squared0,\n                              float32x4_t squared1) {\n  float32x4x2_t result;\n  uint32_t largest = vmaxvq_u32(vmaxq_u32(\n      vreinterpretq_u32_f32(squared0), vreinterpretq_u32_f32(squared1)));\n  if (largest >= UINT32_C(0x7f800000)) {\n    result.val[0] = exact_inverse4(squared0);\n    result.val[1] = exact_inverse4(squared1);\n    return result;\n  }\n  uint64x2_t near0, near1;\n  result.val[0] = estimate_inverse4(squared0, &near0);\n  result.val[1] = estimate_inverse4(squared1, &near1);\n  /* The midpoint window also covers reference double sqrt/divide rounding. */\n  if (vmaxvq_u32(vreinterpretq_u32_u64(vorrq_u64(near0, near1)))) {\n    result.val[0] = exact_inverse4(squared0);\n    result.val[1] = exact_inverse4(squared1);\n  }\n  return result;\n}\n#endif\n\n#if defined(__GNUC__) && !defined(__clang__)\n#define COEFFICIENT_MATH __attribute__((optimize(\"no-math-errno\")))\n#else\n#define COEFFICIENT_MATH\n#endif\n\n/* Source-major storage gives contiguous independent target lanes. */\nstatic COEFFICIENT_MATH void fill_coefficients(\n    const float *restrict x, const float *restrict y,\n    const float *restrict z, int target_start, int target_n,\n    int source_start, int source_n, float *restrict coefficients) {\n  for (int j = 0; j < source_n; ++j) {\n    float sx = x[source_start + j];\n    float sy = y[source_start + j];\n    float sz = z[source_start + j];\n    int i = 0;\n#if defined(__aarch64__)\n    for (; i + 8 <= target_n; i += 8) {\n      float squared[8];\n      #pragma omp simd\n      for (int lane = 0; lane < 8; ++lane) {\n        int target = target_start + i + lane;\n        float dx = sx - x[target];\n        float dy = sy - y[target];\n        float dz = sz - z[target];\n        squared[lane] = dx*dx + dy*dy + dz*dz + SOFTENING;\n      }\n      float32x4x2_t inverse = inverse_distance8(\n          vld1q_f32(squared), vld1q_f32(squared + 4));\n      float32x4_t lo = inverse.val[0];\n      float32x4_t hi = inverse.val[1];\n      lo = vmulq_f32(vmulq_f32(lo, lo), lo);\n      hi = vmulq_f32(vmulq_f32(hi, hi), hi);\n      vst1q_f32(coefficients + j * FORCE_TILE + i, lo);\n      vst1q_f32(coefficients + j * FORCE_TILE + i + 4, hi);\n    }\n#endif\n    #pragma omp simd\n    for (int k = i; k < target_n; ++k) {\n      float dx = sx - x[target_start + k];\n      float dy = sy - y[target_start + k];\n      float dz = sz - z[target_start + k];\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n      coefficients[j * FORCE_TILE + k] = inv_dist3;\n    }\n  }\n}\n\n#if defined(__GNUC__) || defined(__clang__)\ntypedef float ForcePacket __attribute__((vector_size(16)));\n\nstatic inline ForcePacket load_packet(const float *p) {\n  ForcePacket value;\n  memcpy(&value, p, sizeof(value));\n  return value;\n}\n\nstatic inline void store_packet(float *p, ForcePacket value) {\n  memcpy(p, &value, sizeof(value));\n}\n#endif\n\nstatic inline void accumulate_coefficients(\n    const float *restrict x, const float *restrict y,\n    const float *restrict z, float *restrict fx,\n    float *restrict fy, float *restrict fz,\n    int target_start, int target_n, int source_start, int source_n,\n    const float *restrict coefficients) {\n  int i = 0;\n#if defined(__GNUC__) || defined(__clang__)\n  for (; i + 8 <= target_n; i += 8) {\n    int target = target_start + i;\n    ForcePacket tx0 = load_packet(x + target);\n    ForcePacket ty0 = load_packet(y + target);\n    ForcePacket tz0 = load_packet(z + target);\n    ForcePacket tx1 = load_packet(x + target + 4);\n    ForcePacket ty1 = load_packet(y + target + 4);\n    ForcePacket tz1 = load_packet(z + target + 4);\n    ForcePacket ax0 = load_packet(fx + target);\n    ForcePacket ay0 = load_packet(fy + target);\n    ForcePacket az0 = load_packet(fz + target);\n    ForcePacket ax1 = load_packet(fx + target + 4);\n    ForcePacket ay1 = load_packet(fy + target + 4);\n    ForcePacket az1 = load_packet(fz + target + 4);\n    for (int j = 0; j < source_n; ++j) {\n      float sx = x[source_start + j];\n      float sy = y[source_start + j];\n      float sz = z[source_start + j];\n      ForcePacket sxv = {sx, sx, sx, sx};\n      ForcePacket syv = {sy, sy, sy, sy};\n      ForcePacket szv = {sz, sz, sz, sz};\n      ForcePacket c0 = load_packet(coefficients + j * FORCE_TILE + i);\n      ForcePacket c1 = load_packet(coefficients + j * FORCE_TILE + i + 4);\n      ForcePacket dx0 = sxv - tx0;\n      ForcePacket dy0 = syv - ty0;\n      ForcePacket dz0 = szv - tz0;\n      ForcePacket dx1 = sxv - tx1;\n      ForcePacket dy1 = syv - ty1;\n      ForcePacket dz1 = szv - tz1;\n      ax0 += dx0 * c0;\n      ay0 += dy0 * c0;\n      az0 += dz0 * c0;\n      ax1 += dx1 * c1;\n      ay1 += dy1 * c1;\n      az1 += dz1 * c1;\n    }\n    store_packet(fx + target, ax0);\n    store_packet(fy + target, ay0);\n    store_packet(fz + target, az0);\n    store_packet(fx + target + 4, ax1);\n    store_packet(fy + target + 4, ay1);\n    store_packet(fz + target + 4, az1);\n  }\n  for (; i + 4 <= target_n; i += 4) {\n    int target = target_start + i;\n    ForcePacket tx = load_packet(x + target);\n    ForcePacket ty = load_packet(y + target);\n    ForcePacket tz = load_packet(z + target);\n    ForcePacket ax = load_packet(fx + target);\n    ForcePacket ay = load_packet(fy + target);\n    ForcePacket az = load_packet(fz + target);\n    for (int j = 0; j < source_n; ++j) {\n      float sx = x[source_start + j];\n      float sy = y[source_start + j];\n      float sz = z[source_start + j];\n      ForcePacket sxv = {sx, sx, sx, sx};\n      ForcePacket syv = {sy, sy, sy, sy};\n      ForcePacket szv = {sz, sz, sz, sz};\n      ForcePacket c = load_packet(coefficients + j * FORCE_TILE + i);\n      ForcePacket dx = sxv - tx;\n      ForcePacket dy = syv - ty;\n      ForcePacket dz = szv - tz;\n      ax += dx * c;\n      ay += dy * c;\n      az += dz * c;\n    }\n    store_packet(fx + target, ax);\n    store_packet(fy + target, ay);\n    store_packet(fz + target, az);\n  }\n#endif\n  for (; i < target_n; ++i) {\n    int target = target_start + i;\n    float ax = fx[target];\n    float ay = fy[target];\n    float az = fz[target];\n    for (int j = 0; j < source_n; ++j) {\n      float dx = x[source_start + j] - x[target];\n      float dy = y[source_start + j] - y[target];\n      float dz = z[source_start + j] - z[target];\n      float c = coefficients[j * FORCE_TILE + i];\n      ax += dx * c;\n      ay += dy * c;\n      az += dz * c;\n    }\n    fx[target] = ax;\n    fy[target] = ay;\n    fz[target] = az;\n  }\n}\n\nstatic inline void transpose_coefficients(\n    const float *restrict source, float *restrict destination,\n    int target_n, int source_n) {\n  for (int j = 0; j < source_n; ++j) {\n    #pragma omp simd\n    for (int i = 0; i < target_n; ++i)\n      destination[j * FORCE_TILE + i] = source[i * FORCE_TILE + j];\n  }\n}\n\nstatic void build_coefficients_team(const ForceWorkspace *w, int n) {\n  #pragma omp for schedule(static)\n  for (int t = 0; t < w->pair_count; ++t) {\n    int target = w->pairs[t].first * FORCE_TILE;\n    int source = w->pairs[t].second * FORCE_TILE;\n    int ni = n - target;\n    int nj = n - source;\n    if (ni > FORCE_TILE) ni = FORCE_TILE;\n    if (nj > FORCE_TILE) nj = FORCE_TILE;\n    fill_coefficients(w->x, w->y, w->z, target, ni, source, nj,\n        w->coeff + (size_t)t * FORCE_TILE * FORCE_TILE);\n  }\n}\n\nstatic void apply_coefficients_team(Body *p, float dt, int n,\n                                    const ForceWorkspace *w) {\n  #pragma omp for schedule(static)\n  for (int a = 0; a < w->blocks; ++a) {\n    int target = a * FORCE_TILE;\n    int ni = n - target;\n    if (ni > FORCE_TILE) ni = FORCE_TILE;\n    float transposed[FORCE_TILE * FORCE_TILE];\n    /* Every target visits all source bodies in reference order. */\n    for (int b = 0; b < w->blocks; ++b) {\n      int source = b * FORCE_TILE;\n      int nj = n - source;\n      if (nj > FORCE_TILE) nj = FORCE_TILE;\n      int low = a < b ? a : b;\n      int high = a < b ? b : a;\n      const float *tile = w->coeff\n          + tile_index(low, high, w->blocks) * FORCE_TILE * FORCE_TILE;\n      if (b < a) {\n        transpose_coefficients(tile, transposed, ni, nj);\n        tile = transposed;\n      }\n      accumulate_coefficients(w->x, w->y, w->z, w->fx, w->fy, w->fz,\n          target, ni, source, nj, tile);\n    }\n    for (int i = target; i < target + ni; ++i) {\n      p[i].vx += dt*w->fx[i];\n      p[i].vy += dt*w->fy[i];\n      p[i].vz += dt*w->fz[i];\n    }\n  }\n}\n\n/* Bound storage when the complete triangular coefficient set does not fit. */\nstatic void streamed_coefficients_team(Body *p, float dt, int n,\n                                       const ForceWorkspace *w) {\n  for (int phase = 0; phase < 2 * w->blocks - 1; ++phase) {\n    int first = phase - (w->blocks - 1);\n    if (first < 0) first = 0;\n    int last = phase / 2;\n    #pragma omp for schedule(static)\n    for (int a = first; a <= last; ++a) {\n      int b = phase - a;\n      int target = a * FORCE_TILE;\n      int source = b * FORCE_TILE;\n      int ni = n - target;\n      int nj = n - source;\n      if (ni > FORCE_TILE) ni = FORCE_TILE;\n      if (nj > FORCE_TILE) nj = FORCE_TILE;\n      float tile[FORCE_TILE * FORCE_TILE];\n      float transposed[FORCE_TILE * FORCE_TILE];\n      fill_coefficients(w->x, w->y, w->z, target, ni, source, nj, tile);\n      accumulate_coefficients(w->x, w->y, w->z, w->fx, w->fy, w->fz,\n          target, ni, source, nj, tile);\n      if (a != b) {\n        transpose_coefficients(tile, transposed, nj, ni);\n        accumulate_coefficients(w->x, w->y, w->z, w->fx, w->fy, w->fz,\n            source, nj, target, ni, transposed);\n      }\n    }\n  }\n  #pragma omp for schedule(static)\n  for (int i = 0; i < n; ++i) {\n    p[i].vx += dt*w->fx[i];\n    p[i].vy += dt*w->fy[i];\n    p[i].vz += dt*w->fz[i];\n  }\n}\n\nstatic void force_team(Body *p, float dt, int n, ForceWorkspace *w) {\n  #pragma omp single\n  {\n    w->safe = 1;\n  }\n  int invalid = 0;\n  const float position_limit = FLT_MAX * 0.5f;\n  #pragma omp for schedule(static) nowait\n  for (int i = 0; i < n; ++i) {\n    float x = p[i].x;\n    float y = p[i].y;\n    float z = p[i].z;\n    w->x[i] = x;\n    w->y[i] = y;\n    w->z[i] = z;\n    w->fx[i] = 0.0f;\n    w->fy[i] = 0.0f;\n    w->fz[i] = 0.0f;\n    invalid |= !(fabsf(x) <= position_limit) ||\n               !(fabsf(y) <= position_limit) ||\n               !(fabsf(z) <= position_limit);\n  }\n  if (invalid) {\n    #pragma omp atomic write\n    w->safe = 0;\n  }\n  #pragma omp barrier\n  if (!w->safe) {\n    force_rows_team(p, dt, n);\n    return;\n  }\n  if (w->coeff != NULL) {\n    build_coefficients_team(w, n);\n    apply_coefficients_team(p, dt, n, w);\n  } else {\n    streamed_coefficients_team(p, dt, n, w);\n  }\n}\n\n/* Compute forces without changing positions or the public interface. */\nvoid body_force(Body *p, float dt, int n) {\n  if (n < PARALLEL_MIN || fegetround() != FE_TONEAREST) {\n    body_force_scalar(p, dt, n);\n    return;\n  }\n  ForceWorkspace w = make_workspace(n);\n  #pragma omp parallel\n  {\n    if (w.allocation != NULL) force_team(p, dt, n, &w);\n    else force_rows_team(p, dt, n);\n  }\n  free_workspace(&w);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n  Body *bodies = read_dataset(&nbodies);\n\n  if (nbodies >= PARALLEL_MIN && fegetround() == FE_TONEAREST) {\n    ForceWorkspace workspace = make_workspace(nbodies);\n    /* Reuse both the allocation and the configured team for all iterations. */\n    #pragma omp parallel\n    {\n      for (int iter = 0; iter < N_ITER; ++iter) {\n        if (workspace.allocation != NULL)\n          force_team(bodies, DT, nbodies, &workspace);\n        else\n          force_rows_team(bodies, DT, nbodies);\n        #pragma omp for schedule(static)\n        for (int i = 0; i < nbodies; ++i) {\n          bodies[i].x += bodies[i].vx * DT;\n          bodies[i].y += bodies[i].vy * DT;\n          bodies[i].z += bodies[i].vz * DT;\n        }\n      }\n    }\n    free_workspace(&workspace);\n  } else {\n    for (int iter = 0; iter < N_ITER; ++iter) {\n      body_force_scalar(bodies, DT, nbodies);\n      for (int i = 0; i < nbodies; ++i) {\n        bodies[i].x += bodies[i].vx * DT;\n        bodies[i].y += bodies[i].vy * DT;\n        bodies[i].z += bodies[i].vz * DT;\n      }\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n  free(bodies);\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Guarded reciprocal-square-root refinement inside symmetric coefficient tiles should reduce coefficient cost, while ordered eight-target accumulation and persistent OpenMP execution preserve exact output.",
  "notes": "No commands executed. Binary I/O is unchanged; exceptional positions, nondefault rounding, and allocation failures retain reference arithmetic. Correctness and timing require controller evaluation.",
  "sources_kept": [
    "4f4bb522faa94ac9",
    "4850c5cfc3e04e4a",
    "3992a2dec163452e"
  ],
  "transformations": [
    "Snapshot positions and accumulators into six padded, 64-byte-aligned SoA planes.",
    "Generate eight inverse distances using two float refinements and one double refinement, with conservative midpoint guards and exact double sqrt/divide fallback.",
    "Statically distribute upper-triangular coefficient tiles, transpose reverse orientations, and accumulate eight independent targets without reordering source sums.",
    "Reuse a bounded workspace and persistent OpenMP team across iterations; use disjoint antidiagonal tile pairs when complete coefficient storage does not fit."
  ]
}

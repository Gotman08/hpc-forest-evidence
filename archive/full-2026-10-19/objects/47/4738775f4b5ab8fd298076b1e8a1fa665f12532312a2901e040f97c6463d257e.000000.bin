      "content": "#include \"knn.h\"\n#include <stdint.h>\n#include <string.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\ntypedef struct {\n    size_t order;\n    float distance;\n    char label;\n} NeighborCandidate;\n\nstatic int candidate_precedes(const NeighborCandidate * a, const NeighborCandidate * b) {\n    if (a->distance < b->distance) return 1;\n    if (a->distance > b->distance) return 0;\n    return a->order < b->order;\n}\n\nstatic void swap_candidates(NeighborCandidate * a, NeighborCandidate * b) {\n    NeighborCandidate temporary = *a;\n    *a = *b;\n    *b = temporary;\n}\n\nstatic int compare_candidates(const void * a, const void * b) {\n    const NeighborCandidate * first = (const NeighborCandidate *) a;\n    const NeighborCandidate * second = (const NeighborCandidate *) b;\n    if (candidate_precedes(first, second)) return -1;\n    if (candidate_precedes(second, first)) return 1;\n    return 0;\n}\n\n/* Retain the best prefix, with its worst element at keep - 1. */\nstatic void retain_best_candidates(NeighborCandidate * candidates, size_t length, size_t keep) {\n    if (keep == 0 || keep >= length) return;\n\n    size_t target = keep - 1;\n    size_t left = 0;\n    size_t right = length;\n    unsigned int depth = 0;\n    for (size_t remaining = length; remaining > 1; remaining >>= 1) {\n        depth += 2;\n    }\n\n    while (right - left > 24) {\n        if (depth == 0) {\n            qsort(candidates + left, right - left, sizeof(NeighborCandidate), compare_candidates);\n            return;\n        }\n        depth--;\n\n        size_t middle = left + (right - left) / 2;\n        if (candidate_precedes(candidates + middle, candidates + left)) {\n            swap_candidates(candidates + middle, candidates + left);\n        }\n        if (candidate_precedes(candidates + right - 1, candidates + middle)) {\n            swap_candidates(candidates + right - 1, candidates + middle);\n        }\n        if (candidate_precedes(candidates + middle, candidates + left)) {\n            swap_candidates(candidates + middle, candidates + left);\n        }\n        NeighborCandidate pivot = candidates[middle];\n\n        size_t lower = left;\n        size_t scan = left;\n        size_t upper = right;\n        while (scan < upper) {\n            if (candidate_precedes(candidates + scan, &pivot)) {\n                swap_candidates(candidates + lower, candidates + scan);\n                lower++;\n                scan++;\n            } else if (candidate_precedes(&pivot, candidates + scan)) {\n                upper--;\n                swap_candidates(candidates + scan, candidates + upper);\n            } else {\n                scan++;\n            }\n        }\n\n        if (target < lower) {\n            right = lower;\n        } else if (target >= upper) {\n            left = upper;\n        } else {\n            return;\n        }\n    }\n\n    for (size_t i = left + 1; i < right; i++) {\n        NeighborCandidate value = candidates[i];\n        size_t position = i;\n        while (position > left && candidate_precedes(&value, candidates + position - 1)) {\n            candidates[position] = candidates[position - 1];\n            position--;\n        }\n        candidates[position] = value;\n    }\n}\n\nstatic char choose_label(char * labels, int k) {\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nstatic char knn_reference_scan(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    char result = choose_label(labels, k);\n    free(distances);\n    free(labels);\n    return result;\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    if (k <= 0) {\n        return knn_reference_scan(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t total_points = 0;\n    for (int i = 0; i < n_groups; i++) {\n        total_points += (size_t) groups[i].length;\n    }\n\n    if (total_points == 0) {\n        return knn_reference_scan(n_groups, groups, k, to_evaluate);\n    }\n\n    int partitions = 1;\n#ifdef _OPENMP\n    if (!omp_in_parallel()) {\n        int maximum_threads = omp_get_max_threads();\n        size_t useful_partitions = total_points / 16384u;\n        if ((size_t) maximum_threads > useful_partitions) {\n            maximum_threads = (int) useful_partitions;\n        }\n        if (maximum_threads > 1) {\n            partitions = maximum_threads;\n        }\n    }\n#endif\n\n    size_t points_per_partition = total_points / (size_t) partitions;\n    size_t extra_points = total_points % (size_t) partitions;\n    size_t largest_partition = points_per_partition + (extra_points != 0);\n    size_t capacity = (size_t) k;\n    if (largest_partition < capacity) {\n        capacity = largest_partition;\n    }\n\n    size_t buffer_capacity;\n    if (capacity <= largest_partition / 2) {\n        buffer_capacity = capacity * 2;\n    } else {\n        buffer_capacity = largest_partition;\n    }\n\n    if ((size_t) partitions > SIZE_MAX / buffer_capacity / sizeof(NeighborCandidate)) {\n        return knn_reference_scan(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t slots = (size_t) partitions * buffer_capacity;\n    NeighborCandidate * buffers = (NeighborCandidate *) malloc(slots * sizeof(NeighborCandidate));\n    int * counts = (int *) malloc((size_t) partitions * sizeof(int));\n    char * labels = (char *) malloc((size_t) k * sizeof(char));\n\n    if (!buffers || !counts || !labels) {\n        free(buffers);\n        free(counts);\n        free(labels);\n        return knn_reference_scan(n_groups, groups, k, to_evaluate);\n    }\n\n    int has_nan = 0;\n#ifdef _OPENMP\n#pragma omp parallel num_threads(partitions) if(partitions > 1) reduction(|:has_nan)\n#endif\n    {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n        for (int part = 0; part < partitions; part++) {\n            NeighborCandidate * candidates = buffers + (size_t) part * buffer_capacity;\n            size_t used = 0;\n            float cutoff = 0.0f;\n            size_t part_index = (size_t) part;\n            size_t begin = part_index * points_per_partition\n                         + (part_index < extra_points ? part_index : extra_points);\n            size_t end = begin + points_per_partition + (part_index < extra_points);\n            size_t local_limit = end - begin;\n            if (local_limit > (size_t) k) {\n                local_limit = (size_t) k;\n            }\n            size_t group_start = 0;\n\n            for (int i = 0; i < n_groups && group_start < end; i++) {\n                Group g = groups[i];\n                size_t group_end = group_start + (size_t) g.length;\n\n                if (group_end > begin) {\n                    size_t first = begin > group_start ? begin - group_start : 0;\n                    size_t last = end < group_end ? end - group_start : (size_t) g.length;\n\n                    for (size_t j = first; j < last; j++) {\n                        float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n                        if (d != d) {\n                            has_nan = 1;\n                            continue;\n                        }\n\n                        if (used < local_limit) {\n                            if (used == 0 || d > cutoff) {\n                                cutoff = d;\n                            }\n                        } else if (!(d < cutoff)) {\n                            /* Later equal-distance points cannot displace earlier ones. */\n                            continue;\n                        }\n\n                        candidates[used].order = group_start + j;\n                        candidates[used].distance = d;\n                        candidates[used].label = g.label;\n                        used++;\n\n                        if (used == buffer_capacity && used > local_limit) {\n                            retain_best_candidates(candidates, used, local_limit);\n                            used = local_limit;\n                            cutoff = candidates[local_limit - 1].distance;\n                        }\n                    }\n                }\n                group_start = group_end;\n            }\n\n            if (used > local_limit) {\n                retain_best_candidates(candidates, used, local_limit);\n                used = local_limit;\n            }\n            counts[part] = (int) used;\n        }\n\n        /* Each level operates on disjoint partition ranges; barriers protect the next level. */\n        for (size_t span = 1; span < (size_t) partitions; span *= 2) {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n            for (size_t left = 0; left < (size_t) partitions; left += 2 * span) {\n                size_t right = left + span;\n                if (right < (size_t) partitions) {\n                    size_t left_count = (size_t) counts[left];\n                    size_t right_count = (size_t) counts[right];\n                    NeighborCandidate * destination = buffers + left * buffer_capacity;\n                    NeighborCandidate * source = buffers + right * buffer_capacity;\n                    memmove(destination + left_count, source, right_count * sizeof(NeighborCandidate));\n\n                    size_t combined = left_count + right_count;\n                    size_t keep = combined < (size_t) k ? combined : (size_t) k;\n                    retain_best_candidates(destination, combined, keep);\n                    counts[left] = (int) keep;\n                }\n            }\n        }\n    }\n\n    if (has_nan) {\n        free(buffers);\n        free(counts);\n        free(labels);\n        return knn_reference_scan(n_groups, groups, k, to_evaluate);\n    }\n\n    int selected = total_points < (size_t) k ? (int) total_points : k;\n    for (int i = 0; i < selected; i++) {\n        labels[i] = buffers[i].label;\n    }\n    for (int i = selected; i < k; i++) {\n        labels[i] = -1;\n    }\n\n    char result = choose_label(labels, k);\n    free(buffers);\n    free(counts);\n    free(labels);\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }

      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#if defined(__aarch64__) && defined(__ARM_NEON) && !defined(__FAST_MATH__)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system, retaining the original standalone serial entry point.\n */\nvoid body_force(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Called collectively by a team. The current state remains read-only;\n * the tail workshare's barrier completes the entire next state.\n */\nstatic void advance_workshare(const Body *current, Body *next, int n) {\n#if defined(__aarch64__) && defined(__ARM_NEON) && !defined(__FAST_MATH__)\n  const int vector_end = n - n % 4;\n  const float32x4_t softening = vdupq_n_f32(SOFTENING);\n  const float64x2_t one = vdupq_n_f64(1.0);\n\n  #pragma omp for schedule(static) nowait\n  for (int i = 0; i < vector_end; i += 4) {\n    const float32x4_t x = {current[i].x, current[i + 1].x,\n                           current[i + 2].x, current[i + 3].x};\n    const float32x4_t y = {current[i].y, current[i + 1].y,\n                           current[i + 2].y, current[i + 3].y};\n    const float32x4_t z = {current[i].z, current[i + 1].z,\n                           current[i + 2].z, current[i + 3].z};\n    float32x4_t fx = vdupq_n_f32(0.0f);\n    float32x4_t fy = vdupq_n_f32(0.0f);\n    float32x4_t fz = vdupq_n_f32(0.0f);\n\n    /* Each lane visits every source in the original ascending order. */\n    for (int j = 0; j < n; ++j) {\n      float32x4_t dx = vdupq_n_f32(current[j].x) - x;\n      float32x4_t dy = vdupq_n_f32(current[j].y) - y;\n      float32x4_t dz = vdupq_n_f32(current[j].z) - z;\n      float32x4_t sqrd_dist = dx*dx + dy*dy + dz*dz + softening;\n\n      /* Preserve double sqrt/division before conversion back to float. */\n      float64x2_t distance_lo = vcvt_f64_f32(vget_low_f32(sqrd_dist));\n      float64x2_t distance_hi = vcvt_f64_f32(vget_high_f32(sqrd_dist));\n      float64x2_t inverse_lo = vdivq_f64(one, vsqrtq_f64(distance_lo));\n      float64x2_t inverse_hi = vdivq_f64(one, vsqrtq_f64(distance_hi));\n      float32x4_t inv_dist = vcombine_f32(vcvt_f32_f64(inverse_lo),\n                                         vcvt_f32_f64(inverse_hi));\n      float32x4_t inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    Body updated = current[i];\n    updated.vx += DT * vgetq_lane_f32(fx, 0);\n    updated.vy += DT * vgetq_lane_f32(fy, 0);\n    updated.vz += DT * vgetq_lane_f32(fz, 0);\n    updated.x += updated.vx * DT;\n    updated.y += updated.vy * DT;\n    updated.z += updated.vz * DT;\n    next[i] = updated;\n\n    updated = current[i + 1];\n    updated.vx += DT * vgetq_lane_f32(fx, 1);\n    updated.vy += DT * vgetq_lane_f32(fy, 1);\n    updated.vz += DT * vgetq_lane_f32(fz, 1);\n    updated.x += updated.vx * DT;\n    updated.y += updated.vy * DT;\n    updated.z += updated.vz * DT;\n    next[i + 1] = updated;\n\n    updated = current[i + 2];\n    updated.vx += DT * vgetq_lane_f32(fx, 2);\n    updated.vy += DT * vgetq_lane_f32(fy, 2);\n    updated.vz += DT * vgetq_lane_f32(fz, 2);\n    updated.x += updated.vx * DT;\n    updated.y += updated.vy * DT;\n    updated.z += updated.vz * DT;\n    next[i + 2] = updated;\n\n    updated = current[i + 3];\n    updated.vx += DT * vgetq_lane_f32(fx, 3);\n    updated.vy += DT * vgetq_lane_f32(fy, 3);\n    updated.vz += DT * vgetq_lane_f32(fz, 3);\n    updated.x += updated.vx * DT;\n    updated.y += updated.vy * DT;\n    updated.z += updated.vz * DT;\n    next[i + 3] = updated;\n  }\n#else\n  const int vector_end = 0;\n#endif\n\n  /* Unique scalar-tail ownership, or the complete scalar fallback. */\n  #pragma omp for schedule(static)\n  for (int i = vector_end; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = current[j].x - current[i].x;\n      float dy = current[j].y - current[i].y;\n      float dz = current[j].z - current[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    Body updated = current[i];\n    updated.vx += DT*fx;\n    updated.vy += DT*fy;\n    updated.vz += DT*fz;\n    updated.x += updated.vx * DT;\n    updated.y += updated.vy * DT;\n    updated.z += updated.vz * DT;\n    next[i] = updated;\n  }\n}\n\nstatic void simulate(Body *bodies, int nbodies) {\n  Body *scratch = NULL;\n  if (nbodies >= 128) {\n    scratch = (Body *)malloc(nbodies * sizeof(Body));\n  }\n\n  if (scratch == NULL) {\n    for (int iter = 0; iter < N_ITER; iter++) {\n      body_force(bodies, DT, nbodies);\n\n      for (int i = 0; i < nbodies; i++) {\n        bodies[i].x += bodies[i].vx * DT;\n        bodies[i].y += bodies[i].vy * DT;\n        bodies[i].z += bodies[i].vz * DT;\n      }\n    }\n    return;\n  }\n\n  /* One persistent team and one worksharing barrier per timestep. */\n  #pragma omp parallel\n  {\n    for (int iter = 0; iter < N_ITER; iter++) {\n      const Body *current = (iter & 1) ? scratch : bodies;\n      Body *next = (iter & 1) ? bodies : scratch;\n      advance_workshare(current, next, nbodies);\n    }\n  }\n\n  if (N_ITER & 1) {\n    memcpy(bodies, scratch, nbodies * sizeof(Body));\n  }\n  free(scratch);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  simulate(bodies, nbodies);\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }

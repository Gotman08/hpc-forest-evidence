#include <bits/stdc++.h>

using namespace std;

int A[1000][1000];
int ps[1010][1010];

typedef long long ll;

class PrefixCounts {
  struct Slot {
    ll key;
    uint32_t count;
    uint32_t generation;
  };

  vector<Slot> slots;
  size_t mask;
  uint32_t generation;

  static size_t capacity_for(size_t max_entries) {
    size_t capacity = 1;
    while (capacity < 2 * max_entries)
      capacity <<= 1;
    return capacity;
  }

  static uint64_t hash_key(ll key) {
    uint64_t x = static_cast<uint64_t>(key);
    x = (x ^ (x >> 30)) * UINT64_C(0xbf58476d1ce4e5b9);
    x = (x ^ (x >> 27)) * UINT64_C(0x94d049bb133111eb);
    return x ^ (x >> 31);
  }

public:
  explicit PrefixCounts(size_t max_entries)
      : slots(capacity_for(max_entries)), mask(slots.size() - 1),
        generation(0) {}

  void clear() {
    if (++generation == 0) {
      for (Slot &slot : slots)
        slot.generation = 0;
      generation = 1;
    }
  }

  ll get(ll key) const {
    size_t index = static_cast<size_t>(hash_key(key)) & mask;
    for (;;) {
      const Slot &slot = slots[index];
      if (slot.generation != generation)
        return 0;
      if (slot.key == key)
        return slot.count;
      index = (index + 1) & mask;
    }
  }

  void increment(ll key) {
    size_t index = static_cast<size_t>(hash_key(key)) & mask;
    for (;;) {
      Slot &slot = slots[index];
      if (slot.generation != generation) {
        slot.key = key;
        slot.count = 1;
        slot.generation = generation;
        return;
      }
      if (slot.key == key) {
        ++slot.count;
        return;
      }
      index = (index + 1) & mask;
    }
  }
};

ll solve(int m, int n, int k) {
  for (int i = 1; i <= m; i++) {
    for (int j = 1; j <= n; j++) {
      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];
    }
  }
  PrefixCounts h(static_cast<size_t>(m) + 1);
  ll ans = 0;
  for (int j = 1; j <= n; j++) // O(m*n^2)
    for (int l = j; l <= n; l++) {
      h.clear();
      h.increment(0);
      ll s = 0;
      for (int i = 1; i <= m; i++) {
        s += ps[i][l] - ps[i][j - 1];
        ans += h.get(s - k);
        h.increment(s);
      }
    }
  return ans;
}

int main() {
  int k, m, n;
  cin >> k >> m >> n;
  memset(A, 0, sizeof A);
  memset(ps, 0, sizeof ps);

  for (int i = 0; i < m; i++)
    for (int j = 0; j < n; j++)
      cin >> A[i][j];

  cout << solve(m, n, k) << endl;
  return 0;
}

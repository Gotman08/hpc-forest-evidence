    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n#include <omp.h>\\n\\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n    int n_threads = omp_get_max_threads();\\n    float *dist_all = (float *) malloc(sizeof(float) * n_threads * k);\\n    char *label_all = (char *) malloc(sizeof(char) * n_threads * k);\\n\\n    // Initialize all per-thread distances to a large sentinel and labels arbitrarily.\\n    for (int t = 0; t < n_threads; t++) {\\n        float *d = dist_all + t * k;\\n        char *l = label_all + t * k;\\n        for (int i = 0; i < k; i++) {\\n            d[i] = 1e30f;\\n            l[i] = -1;\\n        }\\n    }\\n\\n    #pragma omp parallel for collapse(2) schedule(static)\\n    for (int i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n        for (int j = 0; j < g.length; j++) {\\n            int tid = omp_get_thread_num();\\n            float *local_dist = dist_all + tid * k;\\n            char *local_label = label_all + tid * k;\\n\\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n\\n            for (int x = 0; x < k; x++) {\\n                if (d < local_dist[x]) {\\n                    // Shift elements to the right and insert.\\n                    for (int y = k - 1; y > x; y--) {\\n                        local_dist[y] = local_dist[y - 1];\\n                        local_label[y] = local_label[y - 1];\\n                    }\\n                    local_dist[x] = d;\\n                    local_label[x] = g.label;\\n                    break;\\n                }\\n            }\\n        }\\n    }\\n\\n    // Merge per-thread lists in order of increasing thread ID.\\n    float *global_dist = (float *) malloc(sizeof(float) * k);\\n    char *global_label = (char *) malloc(sizeof(char) * k);\\n    int idx[64];  // assume at most 64 threads\\n    for (int t = 0; t < n_threads; t++) {\\n        idx[t] = 0;\\n    }\\n\\n    for (int pos = 0; pos < k; pos++) {\\n        int best_tid = -1;\\n        float best_dist = 1e30f;\\n        for (int t = 0; t < n_threads; t++) {\\n            if (idx[t] < k) {\\n                float d = dist_all[t * k + idx[t]];\\n                if (d < best_dist) {\\n                    best_dist = d;\\n                    best_tid = t;\\n                }\\n            }\\n        }\\n        // Copy the chosen element.\\n        global_dist[pos] = best_dist;\\n        global_label[pos] = label_all[best_tid * k + idx[best_tid]];\\n        idx[best_tid]++;\\n    }\\n\\n    free(dist_all);\\n    free(label_all);\\n\\n    // Frequency counting on the merged labels.\\n    qsort(global_label, k, sizeof(char), compare_for_sort);\\n\\n    char most_frequent = global_label[0];\\n    int most_frequent_count = 1;\\n    int current_frequency = 1;\\n\\n    for (int i = 1; i < k; i++) {\\n        if (global_label[i] != global_label[i - 1]) {\\n            if (current_frequency > most_frequent_count) {\\n                most_frequent = global_label[i - 1];\\n                most_frequent_count = current_frequency;\\n            }\\n            current_frequency = 1;\\n        } else {\\n            current_frequency++;\\n        }\\n\\n        if (i == k - 1 && current_frequency > most_frequent_count) {\\n            most_frequent = global_label[i - 1];\\n            most_frequent_count = current_frequency;\\n        }\\n    }\\n\\n    free(global_dist);\\n    free(global_label);\\n\\n    return most_frequent;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Using OpenMP collapse(2) with static schedu
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <float.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    float *xs;\n    float *ys;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n    Point point;\n    point.x = x;\n    point.y = y;\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.xs = (float *) malloc(sizeof(float) * length);\n    group.ys = (float *) malloc(sizeof(float) * length);\n\n    for (int i = 0; i < length; i++) {\n        Point p = parse_point();\n        group.xs[i] = p.x;\n        group.ys[i] = p.y;\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt(float dx, float dy) {\n    return dx*dx + dy*dy;\n}\n\nint compare_for_sort(const void *a, const void *b) {\n    return *(char*)a - *(char*)b;\n}\n",
      "path": "src/knn.h"
    },
    {
      "content": "#include \"knn.h\"\n\nstatic inline void swap_float(float *a, float *b) {\n    float t = *a; *a = *b; *b = t;\n}\n\nstatic inline void swap_char(char *a, char *b) {\n    char t = *a; *a = *b; *b = t;\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    float *distances = (float *) malloc(sizeof(float) * k);\n    char *labels = (char *) malloc(sizeof(char) * k);\n\n    for (int i = 0; i < k; i++) {\n        distances[i] = FLT_MAX;\n        labels[i] = -1;\n    }\n\n    float px = to_evaluate.x;\n    float py = to_evaluate.y;\n\n    for (int i = 0; i < n_groups; i++) {\n        Group *g = &groups[i];\n        int len = g->length;\n        float *xs = g->xs;\n        float *ys = g->ys;\n        char lbl = g->label;\n\n        #pragma omp simd private(dx, dy)\n        for (int j = 0; j < len; j++) {\n            float dx = xs[j] - px;\n            float dy = ys[j] - py;\n            float d = euclidean_distance_no_sqrt(dx, dy);\n\n            if (d < distances[0]) {\n                // replace root of max-heap and sift down\n                distances[0] = d;\n                labels[0] = lbl;\n\n                int idx = 0;\n                while (1) {\n                    int left = 2*idx + 1;\n                    if (left >= k) break;\n                    int right = left + 1;\n                    int largest = left;\n                    if (right < k && distances[right] > distances[left]) {\n                        largest = right;\n                    }\n                    if (distances[idx] >= distances[largest]) break;\n                    swap_float(&distances[idx], &distances[largest]);\n                    swap_char(&labels[idx], &labels[largest]);\n                    idx = largest;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Restructure point storage from array-of-structs (AoS) to separate arrays (SoA) for x and y coordinates. Replace insertion-sort-based top-k selection with a binary max-heap using array indices, eliminating loop-carried dependencies in the shift loops. Add restrict qualifiers implicitly via pointer separation and use OpenMP SIMD pragma on distance computation loop. This enables compiler auto-vectorization of squared Euclidean distances while keeping heap updates serial but O(log k) per point.",
  "notes": "Changed Group struct to hold separate xs/ys arrays; updated parse_next_group accordingly. Modified euclidean_distance_no_sqrt to accept dx,dy directly. Implemented max-heap with sift-down on root replacement. Added #pragma omp simd hint for distance loop. Initialized distances array with FLT_MAX instead of -1 sentinel.",

"""Create a new isolated candidate only. Never execute an operational entrypoint."""
from pathlib import Path
import ast
import hashlib
import json
import shutil

HERE = Path(__file__).resolve().parent
OLD = HERE / 'revision-r3-integration-negative-closed'
NEW = HERE / 'revision-r4-facades-cloture-observer'
BASE = HERE.parents[2]
POST = BASE / 'outputs/HPC-Forest-Primes-Natif-Relance-r2g/operations-parent/post-cloture-r1/preserver-post-cloture-parent.py'
POST_SHA = 'fdb831fbaaf9db871aa2edc4b6255c14a4a36fc190d6bad1026adb1275e64e76'


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    assert sha(POST) == POST_SHA
    shutil.copytree(OLD, NEW)
    receiver = NEW / 'reader/receive_phase.py'
    text = receiver.read_text()
    old = '    require(set(value) == {"refs", "expected", "snapshot", "natural_exit"}, "Closed receiving input required")\n'
    assert text.count(old) == 1
    receiver.write_text(text.replace(old, ''), encoding='utf8', newline='\n')
    tree = ast.parse(POST.read_text())
    canonical = next(n for n in ast.walk(tree) if isinstance(n, ast.Call)
                     and isinstance(n.func, ast.Attribute) and n.func.attr == 'save'
                     and len(n.args) >= 2 and isinstance(n.args[0], ast.Name)
                     and n.args[0].id == 'CANONICAL' and isinstance(n.args[1], ast.Dict))
    keys = [ast.literal_eval(n) for n in canonical.args[1].keys]
    assert len(keys) == len(set(keys))
    bridge = NEW / 'reader_bridge.py'
    text = bridge.read_text()
    text = text[:text.index('def latest_g_closure(')] + '''G_POST_KEYS = ''' + repr(set(keys)) + '''
G_POST_PROOFS = {"audit", "reconciliation", "independent_review", "owned_closure",
                 "post_stop_cache", "final_CIM", "six_final_proof_pins"}


def latest_g_closure(value, pinned):
    """Consume exactly the post-helper G contract; a current CIM is still separate."""
    expected = BASE / "outputs/HPC-Forest-Primes-Natif-Relance-r2g/RECEPTION-FINALE-ET-CLOTURE-VERIFIEE.json"
    need(value is not None and pinned is not None and value == pinned
         and artifact(value) == expected, "Canonical final G closure not yet received/pinned")
    receipt = read(value)
    need(set(receipt) == G_POST_KEYS
         and receipt.get("schema") == "hpc-forest-r2g-final-metadata-and-owned-closure-v1"
         and receipt.get("scope_id") == "hpc-forest-primes-native-max-r2g"
         and receipt.get("source_zip_sha256") == "f8c2104bad52e3c298de596fd365415fbdfbbb12fbdc41b47b06a94ad68273fe"
         and receipt.get("plan_sha256") == "5af07859f99192e169f2475fb2c863c9d4a05a4a8dba07845b3fcc54451e7dba",
         "Exact canonical G post-helper schema/fields/source required")
    true_fields = ("verified_metadata_only", "all_started_calls_delivered_and_reconciled",
        "all_started_calls_delivery_reconciled", "all_three_terminal_jobs_received",
        "owned_native_worker_interfaces_closed", "all_21_owned_identities_absent",
        "complete_cache_bytes_preserved_after_owned_stop")
    false_fields = ("pipeline_complete", "native_research_admitted", "independent_performance_verified",
        "five_confirmations_verified", "global_scientific_or_performance_admission", "r5_admitted",
        "new_generation_retry_replay_or_stop_authorized", "pre_post_lock_byte_equality_claimed")
    need(all(receipt[name] is True for name in true_fields)
         and all(receipt[name] is False for name in false_fields)
         and receipt["pre_stop_lock_sha256"] is None,
         "Full actual metadata/owned-close G boundary required; no scientific/lock promotion")
    need(type(receipt["readable_files_preserved"]) is int and receipt["readable_files_preserved"] > 0
         and type(receipt["current_lock_files_preserved"]) is int and receipt["current_lock_files_preserved"] == 3
         and type(receipt["complete_files_preserved"]) is int
         and receipt["complete_files_preserved"] == receipt["readable_files_preserved"] + 3,
         "Exact three current locks plus actual readable preservation count required")
    need(receipt["limits"] == "Current lock bytes received only after closure; previous lock SHA/bytes remain unknown. Metadata closure only; no NORMAL/scientific/performance/R5 admission.",
         "Exact post-helper limits required")
    for name in G_POST_PROOFS:
        artifact(receipt[name])
    if receipt["stop_intent"] is not None:
        artifact(receipt["stop_intent"])
    return receipt
'''
    bridge.write_text(text, encoding='utf8', newline='\n')
    observer = NEW / 'observer/observer-mixte.py'
    text = observer.read_text().replace('import time\n', 'import time\nimport xml.etree.ElementTree as ET\n')
    marker = '\ndef main():\n'
    assert text.count(marker) == 1
    addition = '''
def verify_local_validation():
    """Real local neutral proof, included under component pins; never a Q receipt."""
    validation = read(HERE / "validation-locale.json")
    require(set(validation) == {"schema", "ok", "scope_id", "source_zip_sha256", "plan_sha256",
        "observer_sha256", "test_sha256", "junit_sha256", "testcases", "new_allocated_Q_required",
        "CLI_model_process_transport_CIM_or_cache_effects", "native_generation_admitted"}
        and validation["schema"] == "hpc-forest-source110-obs4-local-neutral-validation-v1"
        and validation["ok"] is True and validation["scope_id"] == SCOPE
        and validation["source_zip_sha256"] == SOURCE and validation["plan_sha256"] == PLAN
        and validation["observer_sha256"] == digest(__file__)
        and validation["test_sha256"] == digest(HERE / "test_obs4_neutre.py")
        and validation["junit_sha256"] == digest(HERE / "TESTS-OBS4-NEUTRES.xml")
        and type(validation["testcases"]) is int and validation["testcases"] == 5
        and validation["new_allocated_Q_required"] is True
        and type(validation["CLI_model_process_transport_CIM_or_cache_effects"]) is int
        and validation["CLI_model_process_transport_CIM_or_cache_effects"] == 0
        and validation["native_generation_admitted"] is False,
        "Exact local OBS4 code/test/result proof required; new allocated Q remains mandatory")
    cases = list(ET.parse(HERE / "TESTS-OBS4-NEUTRES.xml").iter("testcase"))
    require(len(cases) == 5 and len({(c.get("classname"), c.get("name")) for c in cases}) == 5
        and all(all(c.find(kind) is None for kind in ("failure", "error", "skipped")) for c in cases),
        "Five actual local OBS4 neutral cases without failure/skip required")
    return validation

'''
    text = text.replace(marker, '\n' + addition + marker)
    old = '''    validation = read(HERE / "validation-locale.json")
    require(validation.get("ok") is True and validation.get("observer_sha256") == digest(__file__)
            and validation.get("test_sha256") == digest(HERE / "test_obs4_neutre.py"), "Exact local neutral code/test validation required")
'''
    assert text.count(old) == 1
    observer.write_text(text.replace(old, '    verify_local_validation()\n'), encoding='utf8', newline='\n')
    test_old = BASE / 'outputs/HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r2/adaptateurs-source-lane-r2/revision-r2-integration/revision-r5-so-clos-delta-local/observer/test_obs4_neutre.py'
    shutil.copyfile(test_old, NEW / 'observer/test_obs4_neutre.py')
    (NEW / 'G-POST-CONTRAT-PRODUCTEUR.json').write_text(json.dumps({
        'schema': 'hpc-forest-r4b-canonical-G-producer-contract-v1',
        'producer_sha256': POST_SHA, 'canonical_field_names_exact': sorted(keys),
        'schema_name': 'hpc-forest-r2g-final-metadata-and-owned-closure-v1',
        'top_level_proof_names': sorted(['audit', 'reconciliation', 'independent_review', 'owned_closure',
            'post_stop_cache', 'final_CIM', 'six_final_proof_pins']),
        'canonical_receipt_created_or_admitted': False}, indent=2) + '\n', encoding='utf8')
    print(json.dumps({'candidate': str(NEW), 'canonical_fields': len(keys), 'effects': 0}))


if __name__ == '__main__':
    main()

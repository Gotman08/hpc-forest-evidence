        "content": "#include \"knn.h\"\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\nstatic char knn_insertion_fallback(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *) malloc(sizeof(char) * k);\n    float *distances = (float *) malloc(sizeof(float) * k);\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nstatic char knn_vote(const size_t *counts) {\n    char winner = (char)-1;\n    size_t largest = 0;\n    for (int value = CHAR_MIN; value <= CHAR_MAX; ++value) {\n        unsigned char index = (unsigned char)(char)value;\n        if (counts[index] > largest) {\n            largest = counts[index];\n            winner = (char)value;\n        }\n    }\n    return winner;\n}\n\nstatic int knn_compare_keys(const void *a, const void *b) {\n    uint64_t left = *(const uint64_t *)a;\n    uint64_t right = *(const uint64_t *)b;\n    return (left > right) - (left < right);\n}\n\nstatic uint64_t knn_median_key(uint64_t a, uint64_t b, uint64_t c) {\n    if (a < b) {\n        if (b < c) return b;\n        return a < c ? c : a;\n    }\n    if (a < c) return a;\n    return b < c ? c : b;\n}\n\nstatic void knn_select_prefix(uint64_t *keys, size_t count, size_t keep) {\n    size_t first = 0;\n    size_t last = count;\n    size_t rank = keep - 1;\n    unsigned depth = 0;\n    for (size_t span = count; span > 1; span >>= 1) depth += 2;\n\n    while (last - first > 24) {\n        if (depth == 0) {\n            qsort(keys + first, last - first, sizeof(*keys), knn_compare_keys);\n            return;\n        }\n        --depth;\n\n        size_t middle = first + (last - first) / 2;\n        uint64_t pivot = knn_median_key(keys[first], keys[middle], keys[last - 1]);\n        size_t left = first;\n        size_t right = last - 1;\n\n        for (;;) {\n            while (keys[left] < pivot) ++left;\n            while (keys[right] > pivot) --right;\n            if (left >= right) break;\n            uint64_t temporary = keys[left];\n            keys[left] = keys[right];\n            keys[right] = temporary;\n            ++left;\n            --right;\n        }\n\n        size_t split = right + 1;\n        if (split <= first || split >= last) {\n            qsort(keys + first, last - first, sizeof(*keys), knn_compare_keys);\n            return;\n        }\n        if (rank < split) last = split;\n        else first = split;\n    }\n\n    for (size_t i = first + 1; i < last; ++i) {\n        uint64_t value = keys[i];\n        size_t j = i;\n        while (j > first && value < keys[j - 1]) {\n            keys[j] = keys[j - 1];\n            --j;\n        }\n        keys[j] = value;\n    }\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\n\n    size_t total = 0;\n    for (int i = 0; i < n_groups; ++i) {\n        if (groups[i].length > 0) {\n            size_t length = (size_t)groups[i].length;\n            if (length > SIZE_MAX - total)\n                return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\n            total += length;\n        }\n    }\n\n    size_t counts[UCHAR_MAX + 1] = {0};\n    size_t wanted = (size_t)k;\n    if (wanted >= total) {\n        for (int i = 0; i < n_groups; ++i) {\n            if (groups[i].length > 0)\n                counts[(unsigned char)groups[i].label] += (size_t)groups[i].length;\n        }\n        counts[(unsigned char)(char)-1] += wanted - total;\n        return knn_vote(counts);\n    }\n\n    if (sizeof(float) != sizeof(uint32_t) || total > SIZE_MAX / sizeof(uint64_t))\n        return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\n\n    uint64_t *keys = (uint64_t *) malloc(total * sizeof(*keys));\n    if (keys == NULL)\n        return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\n\n    float distance_tile[256];\n    size_t output = 0;\n    int unordered = 0;\n\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n        size_t length = g.length > 0 ? (size_t)g.length : 0;\n        uint64_t group_order = (uint64_t)(uint32_t)i;\n        size_t base = 0;\n\n        while (base < length) {\n            size_t block = length - base;\n            if (block > 256) block = 256;\n            for (size_t j = 0; j < block; ++j)\n                distance_tile[j] = euclidean_distance_no_sqrt(to_evaluate, g.points[base + j]);\n\n            for (size_t j = 0; j < block; ++j) {\n                uint32_t bits;\n                memcpy(&bits, &distance_tile[j], sizeof(bits));\n                bits &= UINT32_C(0x7fffffff);\n                unordered |= bits > UINT32_C(0x7f800000);\n                keys[output + base + j] = ((uint64_t)bits << 32) | group_order;\n            }\n            base += block;\n        }\n        output += length;\n    }\n\n    if (unordered) {\n        free(keys);\n        return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\n    }\n\n    knn_select_prefix(keys, total, wanted);\n    for (size_t i = 0; i < wanted; ++i) {\n        size_t group_index = (size_t)(uint32_t)keys[i];\n        ++counts[(unsigned char)groups[group_index].label];\n    }\n\n    free(keys);\n    return knn_vote(counts);\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    Group *groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",

    {
      "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nstatic inline void update_segment(int* dp, int first, int last) {\n    int left = dp[first - 1];\n    for (int j = first; j < last; ++j) {\n        int value = dp[j] + left;\n        if (value >= MOD) value -= MOD;\n        dp[j] = value;\n        left = value;\n    }\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<vector<int> > blocked(n);\n    for (int c = 0; c < m; ++c) {\n        int row, column;\n        cin >> row >> column;\n        blocked[row].push_back(column);\n    }\n\n    // Index zero is a permanent zero-valued left boundary.\n    vector<int> dp(n + 1, 0);\n    dp[1] = 1;\n\n    for (int i = 0; i < n; ++i) {\n        vector<int>& columns = blocked[i];\n        if (columns.size() > 1) {\n            sort(columns.begin(), columns.end());\n            columns.erase(unique(columns.begin(), columns.end()), columns.end());\n        }\n\n        int first = 1;\n        for (int column : columns) {\n            const int obstacle = column + 1;\n            update_segment(dp.data(), first, obstacle);\n            dp[obstacle] = 0;\n            first = obstacle + 1;\n        }\n        update_segment(dp.data(), first, n + 1);\n    }\n\n    cout << dp[n] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "A single contiguous DP row and obstacle-free interval traversal will reduce memory traffic and per-cell overhead while eliminating unconditional quadratic obstacle storage.",
  "notes": "Retains dense O(n²) computation with O(n+m) storage. Duplicate obstacles are deduplicated; blocked endpoints and n=1 use the same recurrence. No commands or measurements were executed.",

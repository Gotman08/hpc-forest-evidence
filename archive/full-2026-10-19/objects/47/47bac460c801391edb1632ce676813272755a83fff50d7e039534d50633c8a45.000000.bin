"""Independent cold preparation review: never load main/PS, census, cache or effect."""
import ast
import copy
import hashlib
import json
import re
from pathlib import Path

OUT = Path(__file__).resolve().parent
HELPERS = OUT.parent
BASE = OUT.parents[3]
PY = HELPERS / "preparer-fermeture-r2g.py"
PS = HELPERS / "fermer-trois-python-r2g.ps1"
MANIFEST = HELPERS / "MANIFESTE-PREPARATION-FERMEE.json"
PINS = HELPERS / "PINS-FINAUX-NON-ADMIS.json"
EXPECTED = {"preparer-fermeture-r2g.py": "146ad2df5b0615a623dd5c298d2be20dbfd600b61ee831b5273be1bab79f0ed8",
            "fermer-trois-python-r2g.ps1": "20604e21133d30d503155eb7360460c561bf371a57decc905d42372035d6ee11",
            "PINS-FINAUX-NON-ADMIS.json": "123bc86f49e3a2737e991d2ed40eec151a2f8340ce0ae14357b30fe873bca81a"}


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def ref(path):
    return {"path": str(path), "sha256": sha(path)}


def read(path):
    return json.loads(path.read_text("utf-8-sig"))


manifest, pins = read(MANIFEST), read(PINS)
assert manifest["effect_admitted"] is False and manifest["all_future_pins_non_admis"] is True
for item in manifest["files"]:
    path = HELPERS / item["name"]
    assert path.stat().st_size == item["bytes"] and sha(path) == item["sha256"]
for name, expected in EXPECTED.items():
    assert sha(HELPERS / name) == expected
tree = ast.parse(PY.read_text("utf8"))
functions = {n.name: n for n in tree.body if isinstance(n, ast.FunctionDef)}
constants = {target.id: ast.literal_eval(n.value) for n in tree.body if isinstance(n, ast.Assign)
             for target in n.targets if isinstance(target, ast.Name) and target.id in {"SCOPE", "PIN_SLOTS", "CELLS", "FIELDS"}}
assert constants["FIELDS"] == ("ProcessId", "ParentProcessId", "ExecutablePath", "CommandLine", "CreationDate")
assert [c[4] for c in constants["CELLS"]] == [27596, 50984, 44728]
namespace = {"re": re, **constants}
exec(compile(ast.Module(body=[functions["need"], functions["admitted_pins"]], type_ignores=[]), str(PY), "exec"), namespace)
checks = []
def refused(value):
    try:
        namespace["admitted_pins"](value)
    except ValueError:
        return
    raise AssertionError("Preparation unexpectedly admitted")
refused(pins)
checks.append("delivered_six_NULL_NON_ADMIS_slots_refuse_in_pure_function")
for field, value in [("preparation_only", False), ("effect_admitted", True)]:
    sample = copy.deepcopy(pins)
    sample[field] = value
    refused(sample)
checks.append("neither_preparation_flag_alone_bypasses_NULL_proofs")
text = PS.read_text("utf8")
assert text.index("Final proof NON_ADMIS/unpinned") < text.index("function New-TaskCensus")
assert text.index("Write-NewTaskJson $taskInitial $taskIntent") < text.index("$taskOwnedProcess.Kill()")
assert text.count("$taskOwnedProcess.Kill()") == 1 and ".Kill($true)" not in text
assert "Stop-Process" not in text and re.search(r"(?i)\btaskkill(?:\.exe)?\b", text) is None
assert "$taskOwnedProcess.Handle -ne $taskStableHandle" in text
assert "$taskOwnedProcess.StartTime.ToUniversalTime().Ticks -ne $taskBirthTicks" in text
assert text.index("$taskStableGate = Test-TaskGate") < text.index("$taskOwnedProcess.Kill()")
assert "FileMode]::CreateNew" in text and "$taskStream.Flush($true)" in text
assert "already_exited_naturally" in text and "stop_issued=$false" in text
checks.extend(["NULL_pins_before_PS_observation", "durable_exclusive_intent_before_effect",
               "single_no_tree_Process_instance_Kill_with_held_handle_birth_recheck",
               "fresh_full_gate_before_handle_effect", "natural_exit_branches_no_forced_exit_claim"])
tests = read(Path(manifest["neutral_tests"]["path"]))
assert tests["tests_run"] == 13 and tests["success"] is True and tests["failures"] == tests["errors"] == 0
assert tests["tested_files_sha256"][PY.name] == EXPECTED[PY.name]
assert tests["tested_files_sha256"][PS.name] == EXPECTED[PS.name]
parse = read(Path(manifest["powershell_parse"]["path"]))
assert manifest["powershell_parse"]["parse_success"] is True
for item in manifest["existing_historical_files_rehashed_unchanged"]:
    assert sha(BASE / item["path"]) == item["sha256"]
assert all(sha(HELPERS / k) == v for k, v in EXPECTED.items())
report = {"schema": "hpc-forest-r2g-independent-closed-preparation-review-v1",
    "verified_static_preparation": True, "decision": "GO_PREPARATION_ONLY_NO_OPERATIONAL_ADMISSION",
    "scope_id": constants["SCOPE"], "blocking_findings_preparation": [],
    "reviewed_files": {name: ref(HELPERS / name) for name in EXPECTED},
    "manifest": ref(MANIFEST), "received_neutral_tests": ref(Path(manifest["neutral_tests"]["path"])),
    "received_neutral_cases": 13, "neutral_cases_replayed": 0, "pure_independent_checks": checks,
    "code_review": {
        "complete_five_fields_and_seven_digit_birth": True,
        "present_original_main_and_wrapper_IDs_must_match_full_history": True,
        "all_possible_foreign_opaque_CLI_SSH_children_refused": True,
        "wrapper_observation_only_not_target": True,
        "readable_full_cache_inventory_must_match_frozen_copy_except_unread_root_lock": True,
        "final_metadata_reconciliation_and_independent_review_before_census_or_effect": True,
        "all_six_final_proof_slots_CURRENTLY_NULL_NON_ADMIS": True,
        "main_only_three_Process_instances_no_recursive_or_name_stop": True,
        "durable_global_and_individual_intents_no_automatic_retry": True,
        "natural_exit_and_races_preserved_without_claiming_causation": True},
    "operational_blockers_still_expected": [
        "actual_final_three_archive_metadata_receipt_and_exhaustive_private_reconciliation",
        "fresh_independent_final_audit_and_named_snapshots",
        "whole_opaque_cache_preservation_and_frozen_inventory_pins",
        "parent_finalized_pins_in_new_preserved_revision_and_new_concrete_stop_plan",
        "fresh_independent_review_of_actual_four_pinned_files_and_plan",
        "fresh_full_CIM_45_seconds_and_handle_identity_checks_by_parent_only"],
    "effect_admitted": False, "stop_executed_by_reviewer": False,
    "gate_main_or_wrapper_executed": False, "CIM_process_or_live_cache_observed": False,
    "CLI_model_MCP_SSH_or_auth_executed": False, "raw_scientific_or_performance_admission": False,
    "is_REVUE_ARRET_EXACT3_operational_receipt": False}
path = OUT / "REVUE-PREPARATION-FERMEE-G.json"
with path.open("x", encoding="utf8", newline="\n") as stream:
    json.dump(report, stream, indent=2, ensure_ascii=False)
    stream.write("\n")
print(json.dumps({"review": ref(path), "preparation_only": True, "effect_admitted": False}))

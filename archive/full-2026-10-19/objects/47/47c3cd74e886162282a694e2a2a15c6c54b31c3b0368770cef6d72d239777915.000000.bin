#include <algorithm>
#include <cassert>
#include <cstddef>
#include <cstdio>
#include <memory>

class FastInput {
    unsigned char buffer_[1u << 16];
    std::size_t position_ = 0;
    std::size_t length_ = 0;

    int getChar() {
        if (position_ == length_) {
            length_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);
            position_ = 0;
            if (length_ == 0) return EOF;
        }
        return buffer_[position_++];
    }

public:
    int nextInt() {
        int c = getChar();
        while (c != EOF && c <= ' ') c = getChar();
        if (c == EOF) return 0;

        const bool negative = c == '-';
        if (c == '-' || c == '+') c = getChar();
        long long value = 0;
        while (c >= '0' && c <= '9') {
            value = value * 10 + (c - '0');
            c = getChar();
        }
        return static_cast<int>(negative ? -value : value);
    }
};

static void readHorizontal(FastInput& input, int n, int s,
                           int* window, long long* result) {
    long long sum = 0;
    for (int column = 0; column < s; ++column) {
        const int value = input.nextInt();
        window[column] = value;
        sum += value;
    }
    result[0] = sum;

    int oldest = 0;
    const int count = n - s + 1;
    for (int column = 1; column < count; ++column) {
        const int value = input.nextInt();
        sum += static_cast<long long>(value) - window[oldest];
        window[oldest] = value;
        if (++oldest == s) oldest = 0;
        result[column] = sum;
    }
}

int main() {
    FastInput input;
    const int n = input.nextInt();
    const int s = input.nextInt();
    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    const int columns = n - s + 1;
    const int departingRows = n - s;
    const int depth = std::min(s, departingRows);

    std::unique_ptr<int[]> window(new int[s]);
    std::unique_ptr<long long[]> incoming(new long long[columns]);
    std::unique_ptr<long long[]> totals(new long long[columns]());
    std::unique_ptr<long long[]> history(
        new long long[static_cast<std::size_t>(depth) * columns]);

    // Only rows below n-s can ever leave a completed vertical window.
    // Write retained rows directly into history, without clearing it first.
    for (int row = 0; row < s; ++row) {
        long long* values = row < depth
            ? history.get() + static_cast<std::size_t>(row) * columns
            : incoming.get();
        readHorizontal(input, n, s, window.get(), values);
        for (int column = 0; column < columns; ++column) {
            totals[column] += values[column];
        }
    }

    long long best = totals[0];
    for (int column = 1; column < columns; ++column) {
        if (totals[column] > best) best = totals[column];
    }

    int slot = 0;
    for (int row = s; row < n; ++row) {
        readHorizontal(input, n, s, window.get(), incoming.get());
        long long* leaving = history.get()
            + static_cast<std::size_t>(slot) * columns;

        if (row < departingRows) {
            for (int column = 0; column < columns; ++column) {
                const long long value = incoming[column];
                const long long updated = totals[column] - leaving[column] + value;
                totals[column] = updated;
                leaving[column] = value;
                if (updated > best) best = updated;
            }
        } else {
            for (int column = 0; column < columns; ++column) {
                const long long updated = totals[column] - leaving[column]
                                        + incoming[column];
                totals[column] = updated;
                if (updated > best) best = updated;
            }
        }
        if (++slot == depth) slot = 0;
    }

    std::printf("%lld\n", best);
    return 0;
}

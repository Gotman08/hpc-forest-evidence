        "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <cstring>\n#include <limits>\n#include <memory>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing Word = std::uint32_t;\nusing Sum = std::int32_t;\n\nconstexpr std::size_t kBatchBytes = 1u << 20;\n\nstruct CountSlot {\n    std::size_t value;\n    unsigned char padding[64 - sizeof(std::size_t)];\n};\n\nstruct BatchReader {\n    std::unique_ptr<unsigned char[]> storage;\n    std::size_t begin = 0;\n    std::size_t end = 0;\n    bool pending = false;\n    bool negative = false;\n    bool ended = false;\n    Word magnitude = 0;\n\n    BatchReader() : storage(new unsigned char[kBatchBytes + 1]) {}\n\n    bool next(Word* matrix, std::size_t& produced, std::size_t total) {\n        begin = end = 0;\n        while (!ended && produced < total) {\n            unsigned char* const data = storage.get();\n            const std::size_t got = std::fread(data, 1, kBatchBytes, stdin);\n            const bool at_eof = got < kBatchBytes;\n            data[got] = 0;\n            std::size_t start = 0;\n\n            if (pending) {\n                while (start < got && data[start] > ' ') {\n                    magnitude = magnitude * 10u\n                              + static_cast<Word>(data[start] - '0');\n                    ++start;\n                }\n                if (start < got || at_eof) {\n                    matrix[produced++] = negative ? Word(0) - magnitude : magnitude;\n                    pending = false;\n                } else {\n                    continue;\n                }\n            }\n\n            std::size_t finish = got;\n            if (!at_eof && finish > start && data[finish - 1] > ' ') {\n                while (finish > start && data[finish - 1] > ' ') --finish;\n                std::size_t p = finish;\n                negative = false;\n                if (p < got && (data[p] == '-' || data[p] == '+')) {\n                    negative = data[p] == '-';\n                    ++p;\n                }\n                magnitude = 0;\n                while (p < got) {\n                    magnitude = magnitude * 10u\n                              + static_cast<Word>(data[p] - '0');\n                    ++p;\n                }\n                pending = true;\n            }\n\n            ended = at_eof;\n            begin = start;\n            end = finish;\n            data[finish] = 0;\n            if (begin < end) return true;\n        }\n        return false;\n    }\n};\n\nstatic inline std::size_t align_boundary(const unsigned char* data,\n                                         std::size_t position,\n                                         std::size_t begin,\n                                         std::size_t end) {\n    if (position != begin) {\n        while (position < end && data[position - 1] > ' ') ++position;\n    }\n    return position;\n}\n\nstatic inline std::size_t decode_words(const unsigned char* cursor,\n                                       const unsigned char* end,\n                                       Word* __restrict__ destination) {\n    std::size_t count = 0;\n    for (;;) {\n        while (cursor != end && *cursor <= ' ') ++cursor;\n        if (cursor == end) break;\n\n        const bool negative = *cursor == '-';\n        if (*cursor == '-' || *cursor == '+') ++cursor;\n        Word magnitude = 0;\n        unsigned digit = static_cast<unsigned>(*cursor)\n                       - static_cast<unsigned>('0');\n        while (digit < 10u) {\n            magnitude = magnitude * 10u + digit;\n            ++cursor;\n            digit = static_cast<unsigned>(*cursor)\n                  - static_cast<unsigned>('0');\n        }\n        destination[count++] = negative ? Word(0) - magnitude : magnitude;\n        if (cursor != end) ++cursor;\n    }\n    return count;\n}\n\nstatic inline Sum signed_sum(Word bits) {\n    Sum value;\n    std::memcpy(&value, &bits, sizeof(value));\n    return value;\n}\n\n#if defined(__aarch64__)\nstatic inline uint32x4_t prefix_four(uint32x4_t values) {\n    const uint32x4_t zero = vdupq_n_u32(0);\n    values = vaddq_u32(values, vextq_u32(zero, values, 3));\n    return vaddq_u32(values, vextq_u32(zero, values, 2));\n}\n#endif\n\nstatic inline void horizontal_sums(Word* row, int n, int s) {\n    const int windows = n - s + 1;\n    Word total = 0;\n    #pragma omp simd reduction(+:total)\n    for (int c = 0; c < s; ++c) total += row[c];\n\n    int c = 0;\n#if defined(__aarch64__)\n    uint32x4_t carry = vdupq_n_u32(total);\n    for (; c + 8 < windows; c += 8) {\n        // Load both source ranges before overwriting any overlapping input.\n        const uint32x4_t leaving0 = vld1q_u32(row + c);\n        const uint32x4_t leaving1 = vld1q_u32(row + c + 4);\n        const uint32x4_t entering0 = vld1q_u32(row + c + s);\n        const uint32x4_t entering1 = vld1q_u32(row + c + s + 4);\n\n        const uint32x4_t prefix0 = prefix_four(vsubq_u32(entering0, leaving0));\n        uint32x4_t prefix1 = prefix_four(vsubq_u32(entering1, leaving1));\n        prefix1 = vaddq_u32(prefix1,\n                           vdupq_n_u32(vgetq_lane_u32(prefix0, 3)));\n        const uint32x4_t values0 = vaddq_u32(carry, prefix0);\n        const uint32x4_t values1 = vaddq_u32(carry, prefix1);\n\n        vst1q_u32(row + c, vextq_u32(carry, values0, 3));\n        vst1q_u32(row + c + 4, vextq_u32(values0, values1, 3));\n        carry = vdupq_n_u32(vgetq_lane_u32(values1, 3));\n    }\n    total = vgetq_lane_u32(carry, 0);\n#endif\n    for (; c < windows - 1; ++c) {\n        const Word leaving = row[c];\n        const Word entering = row[c + s];\n        row[c] = total;\n        total += entering - leaving;\n    }\n    row[windows - 1] = total;\n}\n\nint main() {\n    int n, s;\n    if (std::scanf(\"%d%d\", &n, &s) != 2) return 0;\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t elements = static_cast<std::size_t>(n) * n;\n    std::unique_ptr<Word[]> matrix(new Word[elements]);\n    Word* const data = matrix.get();\n    BatchReader input;\n\n    const int windows = n - s + 1;\n    constexpr int max_stripe_width = 256;\n    int workers = 1;\n#ifdef _OPENMP\n    workers = omp_get_max_threads();\n#endif\n    std::unique_ptr<CountSlot[]> counts(new CountSlot[workers]);\n    const int stripe_width = std::min(max_stripe_width,\n        std::max(1, (windows + workers - 1) / workers));\n    const int stripes = (windows + stripe_width - 1) / stripe_width;\n    std::size_t produced = 0;\n    std::size_t batch_base = 0;\n    bool have_batch = false;\n    Sum maximum = std::numeric_limits<Sum>::lowest();\n\n    #pragma omp parallel if(elements >= 65536) reduction(max:maximum)\n    {\n        int tid = 0;\n        int team = 1;\n#ifdef _OPENMP\n        tid = omp_get_thread_num();\n        team = omp_get_num_threads();\n#endif\n        {\n            const std::size_t staging_capacity = std::min(\n                elements, kBatchBytes / static_cast<std::size_t>(team) + 8);\n            std::unique_ptr<Word[]> staged(new Word[staging_capacity]);\n\n            for (;;) {\n                #pragma omp single\n                {\n                    have_batch = input.next(data, produced, elements);\n                    batch_base = produced;\n                }\n                if (!have_batch) break;\n\n                const unsigned char* const bytes = input.storage.get();\n                const std::size_t length = input.end - input.begin;\n                std::size_t left = input.begin\n                    + length * static_cast<std::size_t>(tid) / team;\n                std::size_t right = input.begin\n                    + length * static_cast<std::size_t>(tid + 1) / team;\n                left = align_boundary(bytes, left, input.begin, input.end);\n                right = align_boundary(bytes, right, input.begin, input.end);\n                const std::size_t count = decode_words(\n                    bytes + left, bytes + right, staged.get());\n                counts[tid].value = count;\n\n                #pragma omp barrier\n                std::size_t offset = batch_base;\n                for (int t = 0; t < tid; ++t) offset += counts[t].value;\n                if (count != 0) {\n                    std::memcpy(data + offset, staged.get(), count * sizeof(Word));\n                }\n\n                #pragma omp single\n                {\n                    std::size_t batch_count = 0;\n                    for (int t = 0; t < team; ++t) batch_count += counts[t].value;\n                    produced = batch_base + batch_count;\n                }\n            }\n        }\n\n        if (produced == elements) {\n            #pragma omp for schedule(static)\n            for (int r = 0; r < n; ++r) {\n                horizontal_sums(data + static_cast<std::size_t>(r) * n, n, s);\n            }\n\n            alignas(64) Word column_sums[max_stripe_width];\n            alignas(64) Sum column_maxima[max_stripe_width];\n\n            #pragma omp for schedule(static) nowait\n            for (int block = 0; block < stripes; ++block) {\n                const int first = block * stripe_width;\n                const int width = std::min(stripe_width, windows - first);\n                #pragma omp simd\n                for (int c = 0; c < width; ++c) column_sums[c] = 0;\n\n                for (int r = 0; r < s; ++r) {\n                    const Word* const row = data\n                        + static_cast<std::size_t>(r) * n + first;\n                    #pragma omp simd\n                    for (int c = 0; c < width; ++c) column_sums[c] += row[c];\n                }\n                #pragma omp simd\n                for (int c = 0; c < width; ++c) {\n                    column_maxima[c] = signed_sum(column_sums[c]);\n                }\n\n                for (int r = s; r < n; ++r) {\n                    const Word* const entering = data\n                        + static_cast<std::size_t>(r) * n + first;\n                    const Word* const leaving = data\n                        + static_cast<std::size_t>(r - s) * n + first;\n                    #pragma omp simd\n                    for (int c = 0; c < width; ++c) {\n                        const Word total = column_sums[c] + entering[c] - leaving[c];\n                        column_sums[c] = total;\n                        column_maxima[c] = std::max(column_maxima[c], signed_sum(total));\n                    }\n                }\n\n                Sum block_maximum = std::numeric_limits<Sum>::lowest();\n                #pragma omp simd reduction(max:block_maximum)\n                for (int c = 0; c < width; ++c) {\n                    block_maximum = std::max(block_maximum, column_maxima[c]);\n                }\n                maximum = std::max(maximum, block_maximum);\n            }\n        }\n    }\n\n    if (produced != elements) return 0;\n    std::printf(\"%d\\n\", static_cast<int>(maximum));\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }

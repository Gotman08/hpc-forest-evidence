      "content": "#include \"knn.h\"\n#include <omp.h>\n\nstatic int is_worse(float da, long ia, float db, long ib) {\n    return (da > db) || (da == db && ia > ib);\n}\n\nstatic void swap3(float *hd, long *hi, char *hl, int a, int b) {\n    float td = hd[a]; hd[a] = hd[b]; hd[b] = td;\n    long ti = hi[a]; hi[a] = hi[b]; hi[b] = ti;\n    char tc = hl[a]; hl[a] = hl[b]; hl[b] = tc;\n}\n\nstatic void heap_push(float *hd, long *hi, char *hl, int *n,\n                      float d, long idx, char label) {\n    int i = (*n)++;\n    hd[i] = d; hi[i] = idx; hl[i] = label;\n\n    while (i > 0) {\n        int parent = (i - 1) / 2;\n        if (is_worse(hd[i], hi[i], hd[parent], hi[parent])) {\n            swap3(hd, hi, hl, i, parent);\n            i = parent;\n        } else {\n            break;\n        }\n    }\n}\n\nstatic void heap_replace_root(float *hd, long *hi, char *hl, int n,\n                              float d, long idx, char label) {\n    hd[0] = d; hi[0] = idx; hl[0] = label;\n    int i = 0;\n\n    for (;;) {\n        int left = 2 * i + 1;\n        if (left >= n) break;\n        int right = left + 1;\n        int worst = i;\n\n        if (is_worse(hd[left], hi[left], hd[worst], hi[worst])) {\n            worst = left;\n        }\n        if (right < n && is_worse(hd[right], hi[right], hd[worst], hi[worst])) {\n            worst = right;\n        }\n\n        if (worst == i) break;\n        swap3(hd, hi, hl, i, worst);\n        i = worst;\n    }\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    size_t total = 0;\n    for (int gi = 0; gi < n_groups; ++gi) {\n        total += (size_t)groups[gi].length;\n    }\n\n    float *xs = NULL;\n    if (posix_memalign((void **)&xs, 64, total * sizeof(float)) != 0) {\n        xs = malloc(total * sizeof(float));\n    }\n    float *ys = NULL;\n    if (posix_memalign((void **)&ys, 64, total * sizeof(float)) != 0) {\n        ys = malloc(total * sizeof(float));\n    }\n    char *plabels = (char *)malloc(total * sizeof(char));\n\n    size_t pos = 0;\n    for (int gi = 0; gi < n_groups; ++gi) {\n        Group g = groups[gi];\n        char lab = g.label;\n        for (int j = 0; j < g.length; ++j) {\n            xs[pos] = g.points[j].x;\n            ys[pos] = g.points[j].y;\n            plabels[pos] = lab;\n            ++pos;\n        }\n    }\n\n    float *dists = NULL;\n    if (posix_memalign((void **)&dists, 64, total * sizeof(float)) != 0) {\n        dists = malloc(total * sizeof(float));\n    }\n    float tx = to_evaluate.x;\n    float ty = to_evaluate.y;\n\n    int max_threads = omp_get_max_threads();\n    if (max_threads < 1) max_threads = 1;\n    size_t per = (size_t)k;\n    float *local_d = (float *)malloc((size_t)max_threads * per * sizeof(float));\n    long *local_i = (long *)malloc((size_t)max_threads * per * sizeof(long));\n    char *local_l = (char *)malloc((size_t)max_threads * per * sizeof(char));\n    int *local_n = (int *)calloc(max_threads, sizeof(int));\n\n#pragma omp parallel\n{\n    #pragma omp for simd schedule(static) aligned(xs, ys, dists: 64)\n    for (long p = 0; p < (long)total; ++p) {\n        float dx = xs[p] - tx;\n        float dy = ys[p] - ty;\n        dists[p] = dx * dx + dy * dy;\n    }\n\n    int tid = omp_get_thread_num();\n    float *hd = local_d + (size_t)tid * per;\n    long *hi = local_i + (size_t)tid * per;\n    char *hl = local_l + (size_t)tid * per;\n    int hn = 0;\n\n    #pragma omp for schedule(static)\n    for (long p = 0; p < (long)total; ++p) {\n        float d = dists[p];\n        if (hn < k) {\n            heap_push(hd, hi, hl, &hn, d, p, plabels[p]);\n        } else if (is_worse(hd[0], hi[0], d, p)) {\n            heap_replace_root(hd, hi, hl, k, d, p, plabels[p]);\n        }\n    }\n    local_n[tid] = hn;\n}\n\n    float *heap_d = (float *)malloc(k * sizeof(float));\n    long *heap_idx = (long *)malloc(k * sizeof(long));\n    char *heap_lab = (char *)malloc(k * sizeof(char));\n    int heap_n = 0;\n\n    for (int t = 0; t < max_threads; ++t) {\n        int cnt = local_n[t];\n        float *hd = local_d + (size_t)t * per;\n        long *hi = local_i + (size_t)t * per;\n        char *hl = local_l + (size_t)t * per;\n        for (int j = 0; j < cnt; ++j) {\n            if (heap_n < k) {\n                heap_push(heap_d, heap_idx, heap_lab, &heap_n,\n                          hd[j], hi[j], hl[j]);\n            } else if (is_worse(heap_d[0], heap_idx[0], hd[j], hi[j])) {\n                heap_replace_root(heap_d, heap_idx, heap_lab, k,\n                                  hd[j], hi[j], hl[j]);\n            }\n        }\n    }\n\n    free(local_d); free(local_i); free(local_l); free(local_n);\n\n    char *labels = (char *)malloc(k * sizeof(char));\n    for (int i = 0; i < k; ++i) {\n        if (i < heap_n) labels[i] = heap_lab[i];\n        else labels[i] = -1;\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; ++i) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            ++current_frequency;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(xs); free(ys); free(plabels); free(dists);\n    free(heap_d); free(heap_idx); free(heap_lab); free(labels);\n\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; ++i) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n    return 0;\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "The remaining sequential bottleneck after vectorizing distances is the single-threaded heap selection. By giving each OpenMP thread its own local max-heap for a contiguous slice of points (preserving index-based tie-breaking) and merging at most num_threads*k candidates, we parallelize selection while keeping the SIMD distance loop; fusing both loops in one parallel region reduces fork/join overhead.",
  "notes": "Correctness follows because each point belongs to exactly one chunk; any point excluded from its chunk's local top-k is dominated by k points within that same chunk under the total order (distance, index), so it cannot be among the global top-k. The merge re-applies the same comparator over the union of local candidates.",
  "sources_kept": [],
  "transformations": [
    "Fuse the SIMD distance computation and the top-k selection into a single OpenMP parallel region to avoid two thread-team creations.",
    "Parallelize the heap-based top-k selection using per-thread max-heaps over contiguous chunks, then merge the small candidate sets with an identical comparator."
  ]

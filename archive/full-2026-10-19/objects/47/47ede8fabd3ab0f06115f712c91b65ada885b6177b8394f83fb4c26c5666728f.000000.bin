#include "knn.h"
#include <arm_neon.h>

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    float *best_dist = (float *) malloc(sizeof(float) * k);
    char *best_label = (char *) malloc(sizeof(char) * k);

    int count = 0;
    int i, j, t;

    for (i = 0; i < n_groups; i++) {
        Group g = groups[i];

        // Process points in batches of four using NEON
        for (j = 0; j + 3 < g.length; j += 4) {
            float32x4x2_t pts = vld2q_f32((const float32_t *)&g.points[j]);
            float32x4_t xs = pts.val[0];
            float32x4_t ys = pts.val[1];
            float32x4_t qx = vdupq_n_f32(to_evaluate.x);
            float32x4_t qy = vdupq_n_f32(to_evaluate.y);
            float32x4_t dx = xs - qx;
            float32x4_t dy = ys - qy;
            float32x4_t d2 = dx * dx + dy * dy;
            float d[4];
            vst1q_f32(d, d2);

            for (t = 0; t < 4; t++) {
                float dist_val = d[t];
                if (count < k) {
                    int pos = count;
                    best_dist[pos] = dist_val;
                    best_label[pos] = g.label;
                    while (pos > 0 && best_dist[pos - 1] > dist_val) {
                        float tmpd = best_dist[pos - 1];
                        best_dist[pos - 1] = best_dist[pos];
                        best_dist[pos] = tmpd;
                        char tmpl = best_label[pos - 1];
                        best_label[pos - 1] = best_label[pos];
                        best_label[pos] = tmpl;
                        pos--;
                    }
                    count++;
                } else if (dist_val < best_dist[k - 1]) {
                    int pos = k - 1;
                    best_dist[pos] = dist_val;
                    best_label[pos] = g.label;
                    while (pos > 0 && best_dist[pos - 1] > best_dist[pos]) {
                        float tmpd = best_dist[pos - 1];
                        best_dist[pos - 1] = best_dist[pos];
                        best_dist[pos] = tmpd;
                        char tmpl = best_label[pos - 1];
                        best_label[pos - 1] = best_label[pos];
                        best_label[pos] = tmpl;
                        pos--;
                    }
                }
            }
        }

        // Scalar remainder
        for (; j < g.length; j++) {
            float dist_val = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);
            if (count < k) {
                int pos = count;
                best_dist[pos] = dist_val;
                best_label[pos] = g.label;
                while (pos > 0 && best_dist[pos - 1] > dist_val) {
                    float tmpd = best_dist[pos - 1];
                    best_dist[pos - 1] = best_dist[pos];
                    best_dist[pos] = tmpd;
                    char tmpl = best_label[pos - 1];
                    best_label[pos - 1] = best_label[pos];
                    best_label[pos] = tmpl;
                    pos--;
                }
                count++;
            } else if (dist_val < best_dist[k - 1]) {
                int pos = k - 1;
                best_dist[pos] = dist_val;
                best_label[pos] = g.label;
                while (pos > 0 && best_dist[pos - 1] > best_dist[pos]) {
                    float tmpd = best_dist[pos - 1];
                    best_dist[pos - 1] = best_dist[pos];
                    best_dist[pos] = tmpd;
                    char tmpl = best_label[pos - 1];
                    best_label[pos - 1] = best_label[pos];
                    best_label[pos] = tmpl;
                    pos--;
                }
            }
        }
    }

    // Count frequencies among the k selected labels
    char *labels = (char *) malloc(sizeof(char) * count);
    for (i = 0; i < count; i++) {
        labels[i] = best_label[i];
    }
    qsort(labels, count, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (i = 1; i < count; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }
            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == count - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    free(best_dist);
    free(best_label);
    free(labels);

    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

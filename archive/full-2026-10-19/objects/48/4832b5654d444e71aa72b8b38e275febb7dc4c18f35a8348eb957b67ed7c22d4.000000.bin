+
+@pytest.mark.parametrize('command', [
+    'python -m hpc_forest.unrecognized_worker --session-id unknown',
+    '"python.exe" "C:\\NEUTRAL\\BOOTSTRAP_WORKER.PY" --session-id unknown',
+    'python "-m" "HPC_FOREST.UNKNOWN_WORKER"',
+    'python C:\\NEUTRAL\\hpc_forest\\another_worker.py',
+])
+def test_unknown_native_family_or_uppercase_bootstrap_is_not_ignored(command):
+    census, closure, identity = census_fixture()
+    census['rows'].append(identity(999, command))
+    census['rows_count'] += 1
+    assert factory.detection.is_native_worker_command(command)
+    with pytest.raises(ValueError, match='Unclassified native'):
+        factory.check_census(census, closure, now=1000)

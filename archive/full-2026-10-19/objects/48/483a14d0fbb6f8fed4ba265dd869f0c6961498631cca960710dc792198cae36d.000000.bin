#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <algorithm>
#include <cstdint>

#if defined(__aarch64__)
#include <arm_neon.h>
#endif

typedef std::int64_t Sum;

#if defined(__aarch64__)
static inline int64x2_t maximum_vector(int64x2_t a, int64x2_t b) {
    return vbslq_s64(vcgtq_s64(a, b), a, b);
}
#endif

static inline Sum horizontal_maximum(const Sum* column, int n, int s,
                                     Sum first, Sum best) {
    Sum sum = first;
    best = std::max(best, first);
    int col = s;

#if defined(__aarch64__)
    const int64x2_t zero = vdupq_n_s64(0);
    int64x2_t carry = vdupq_n_s64(first);
    int64x2_t maxima = vdupq_n_s64(best);

    for (; col + 7 < n; col += 8) {
        const int64x2_t delta01 = vsubq_s64(
            vld1q_s64(column + col), vld1q_s64(column + col - s));
        const int64x2_t delta23 = vsubq_s64(
            vld1q_s64(column + col + 2), vld1q_s64(column + col - s + 2));
        const int64x2_t delta45 = vsubq_s64(
            vld1q_s64(column + col + 4), vld1q_s64(column + col - s + 4));
        const int64x2_t delta67 = vsubq_s64(
            vld1q_s64(column + col + 6), vld1q_s64(column + col - s + 6));

        int64x2_t prefix01 = vaddq_s64(delta01, vextq_s64(zero, delta01, 1));
        int64x2_t prefix23 = vaddq_s64(delta23, vextq_s64(zero, delta23, 1));
        int64x2_t prefix45 = vaddq_s64(delta45, vextq_s64(zero, delta45, 1));
        int64x2_t prefix67 = vaddq_s64(delta67, vextq_s64(zero, delta67, 1));

        const int64x2_t offset2 = vdupq_laneq_s64(prefix01, 1);
        const int64x2_t offset4 = vaddq_s64(
            offset2, vdupq_laneq_s64(prefix23, 1));
        const int64x2_t offset6 = vaddq_s64(
            offset4, vdupq_laneq_s64(prefix45, 1));
        prefix23 = vaddq_s64(prefix23, offset2);
        prefix45 = vaddq_s64(prefix45, offset4);
        prefix67 = vaddq_s64(prefix67, offset6);

        const int64x2_t block_maximum = maximum_vector(
            maximum_vector(prefix01, prefix23),
            maximum_vector(prefix45, prefix67));
        maxima = maximum_vector(maxima, vaddq_s64(carry, block_maximum));
        carry = vaddq_s64(carry, vdupq_laneq_s64(prefix67, 1));
    }

    sum = vgetq_lane_s64(carry, 0);
    best = std::max(vgetq_lane_s64(maxima, 0), vgetq_lane_s64(maxima, 1));
#endif

    for (; col < n; ++col) {
        sum += column[col] - column[col - s];
        best = std::max(best, sum);
    }
    return best;
}

int main() {
    int n, s;
    std::cin >> n >> s;
    std::vector<std::vector<int> > matrix(n, std::vector<int>(n));
    for (int i = 0; i < n; ++i)
        for (int j = 0; j < n; ++j)
            scanf("%d", &matrix[i][j]);

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    std::vector<Sum> columns(n, 0);
    Sum* column = columns.data();

    for (int row = 0; row < s; ++row) {
        const int* values = matrix[row].data();
        #pragma omp simd
        for (int col = 0; col < n; ++col)
            column[col] += static_cast<Sum>(values[col]);
    }

    Sum first = 0;
    #pragma omp simd reduction(+:first)
    for (int col = 0; col < s; ++col)
        first += column[col];

    Sum best = first;
    const int last = n - s;
    for (int top = 0; top <= last; ++top) {
        best = horizontal_maximum(column, n, s, first, best);

        if (top == last)
            break;

        const int* outgoing = matrix[top].data();
        const int* incoming = matrix[top + s].data();
        Sum first_delta = 0;
        #pragma omp simd reduction(+:first_delta)
        for (int col = 0; col < s; ++col) {
            const Sum delta = static_cast<Sum>(incoming[col])
                            - static_cast<Sum>(outgoing[col]);
            column[col] += delta;
            first_delta += delta;
        }
        first += first_delta;

        #pragma omp simd
        for (int col = s; col < n; ++col) {
            column[col] += static_cast<Sum>(incoming[col])
                         - static_cast<Sum>(outgoing[col]);
        }
    }

    printf("%d\n", static_cast<int>(best));
    return 0;
}

        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n#define TARGET_PACKET 4\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nstatic void body_force_scalar(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Stream sources across four independent targets. SIMD operates only\n * across targets, leaving each target's source accumulation ordered.\n * Disabling math errno permits vector sqrt without enabling fast-math.\n */\n#if defined(__GNUC__) && !defined(__clang__)\n__attribute__((optimize(\"no-math-errno\")))\n#endif\nvoid body_force(Body *p, float dt, int n) {\n  if (n <= 0) {\n    return;\n  }\n\n  const int packets = n / TARGET_PACKET + (n % TARGET_PACKET != 0);\n  const size_t stride = (size_t)packets * TARGET_PACKET;\n  if (stride > (size_t)-1 / (3 * sizeof(float))) {\n    body_force_scalar(p, dt, n);\n    return;\n  }\n\n  float *positions = (float *)malloc(3 * stride * sizeof(float));\n  if (positions == NULL) {\n    body_force_scalar(p, dt, n);\n    return;\n  }\n\n  float *restrict x = positions;\n  float *restrict y = positions + stride;\n  float *restrict z = positions + 2 * stride;\n\n  for (int i = 0; i < n; ++i) {\n    x[i] = p[i].x;\n    y[i] = p[i].y;\n    z[i] = p[i].z;\n  }\n  for (size_t i = (size_t)n; i < stride; ++i) {\n    x[i] = x[n - 1];\n    y[i] = y[n - 1];\n    z[i] = z[n - 1];\n  }\n\n  #pragma omp parallel for schedule(static)\n  for (int packet = 0; packet < packets; ++packet) {\n    const int first = packet * TARGET_PACKET;\n    const int remaining = n - first;\n    const int active = remaining < TARGET_PACKET ? remaining : TARGET_PACKET;\n    float tx[TARGET_PACKET], ty[TARGET_PACKET], tz[TARGET_PACKET];\n    float fx[TARGET_PACKET] = {0.0f};\n    float fy[TARGET_PACKET] = {0.0f};\n    float fz[TARGET_PACKET] = {0.0f};\n\n    #pragma omp simd simdlen(TARGET_PACKET)\n    for (int lane = 0; lane < TARGET_PACKET; ++lane) {\n      tx[lane] = x[first + lane];\n      ty[lane] = y[first + lane];\n      tz[lane] = z[first + lane];\n    }\n\n    for (int j = 0; j < n; ++j) {\n      const float sx = x[j];\n      const float sy = y[j];\n      const float sz = z[j];\n\n      #pragma omp simd simdlen(TARGET_PACKET)\n      for (int lane = 0; lane < TARGET_PACKET; ++lane) {\n        float dx = sx - tx[lane];\n        float dy = sy - ty[lane];\n        float dz = sz - tz[lane];\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx[lane] += dx * inv_dist3;\n        fy[lane] += dy * inv_dist3;\n        fz[lane] += dz * inv_dist3;\n      }\n    }\n\n    for (int lane = 0; lane < active; ++lane) {\n      const int i = first + lane;\n      p[i].vx += dt*fx[lane];\n      p[i].vy += dt*fy[lane];\n      p[i].vz += dt*fz[lane];\n    }\n  }\n\n  free(positions);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
        "path": "src/nbody.c"
      }

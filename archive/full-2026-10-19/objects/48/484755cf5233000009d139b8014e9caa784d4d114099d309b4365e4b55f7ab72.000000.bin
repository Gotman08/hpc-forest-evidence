        "base_commit": "8c759df3d541fd420c7487cd09f20918bcaebc7a",
        "delegation_parent": "R/C",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "A persistent OpenMP team with static worksharing across independent bodies should parallelize the dominant pair-force calculation while avoiding repeated team creation across simulation iterations. Static scheduling fits the uniform per-body workload; preserving each body's increasing-j accumulation order should retain reference output semantics.",
        "id": "a841149e87744055",
        "ordinal": 1,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/nbody.c"
          ],
          "retained": [
            "Create one OpenMP parallel region around all simulation iterations instead of creating teams for each work phase.",
            "Use schedule(static) for outer-body force calculations and position updates, leaving the inner interaction loop serial and in its original order."
          ]
        },
        "tree_id": "e1:C",

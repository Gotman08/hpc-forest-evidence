    {
      "id": "9e30053260324084",
      "role": "A",
      "mission": {
        "base_commit": "8c759df3d541fd420c7487cd09f20918bcaebc7a",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Grouping four target bodies in the force traversal should improve locality by reusing each source body's position loads across several targets, while retaining ascending source order and the original per-target force accumulation sequence.",
        "id": "9e30053260324084",
        "ordinal": 2,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/nbody.c"
          ],
          "retained": [
            "Tile the target-body loop in groups of four and load each target's position once per tile.",
            "Interchange the target and source traversal within each tile so source positions are loaded once and reused across the tile's targets.",
            "Keep each target's source loop in ascending j order and apply its velocity update only after its force accumulation."
          ]
        },

        "depth": 1,
        "epoch": 1,
        "hypothesis": "A body-count cutover avoids OpenMP team and synchronization overhead for small simulations while retaining a persistent team with static worksharing for larger inputs. Each body's force accumulation remains in increasing-j order, preserving the reference arithmetic order.",
        "id": "ae2aedf049404be5",
        "ordinal": 2,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/nbody.c"
          ],
          "retained": [
            "Extract the per-body force calculation so serial and parallel paths use the same increasing-j accumulation sequence.",
            "Use a serial simulation below 128 bodies; at or above the cutover, use one persistent OpenMP team with static worksharing for force and position loops across all iterations."
          ]
        },

#include <algorithm>
#include <cassert>
#include <cstddef>
#include <cstdio>
#include <limits>
#include <vector>

int main() {
    int n = 0;
    int s = 0;
    if (std::scanf("%d%d", &n, &s) != 2) return 0;

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    const std::size_t matrixSize = static_cast<std::size_t>(n) * n;
    std::vector<int> matrix(matrixSize);
    for (std::size_t i = 0; i < matrixSize; ++i) {
        if (std::scanf("%d", &matrix[i]) != 1) return 0;
    }

    long long maxSum;
    if (s <= 2) {
        long long sum = 0;
        for (int r = 0; r < s; ++r) {
            const std::size_t rowBase = static_cast<std::size_t>(r) * n;
            for (int c = 0; c < s; ++c) {
                sum += matrix[rowBase + c];
            }
        }
        maxSum = sum;

        int direction = 1;
        int top = 0;
        int left = 0;
        while (top + s <= n) {
            if ((left + s == n && direction == 1) ||
                (left == 0 && direction == -1)) {
                const int enteringRow = top + s;
                if (enteringRow >= n) break;

                const std::size_t exitingBase = static_cast<std::size_t>(top) * n;
                const std::size_t enteringBase = static_cast<std::size_t>(enteringRow) * n;
                #pragma omp simd reduction(+:sum)
                for (int k = 0; k < s; ++k) {
                    sum += static_cast<long long>(matrix[enteringBase + left + k]) -
                           matrix[exitingBase + left + k];
                }

                ++top;
                direction *= -1;
            } else {
                int exitingCol;
                int enteringCol;
                if (direction == 1) {
                    exitingCol = left;
                    enteringCol = left + s;
                } else {
                    enteringCol = left - 1;
                    exitingCol = enteringCol + s;
                }

                for (int k = 0; k < s; ++k) {
                    const std::size_t rowBase = static_cast<std::size_t>(top + k) * n;
                    sum += static_cast<long long>(matrix[rowBase + enteringCol]) -
                           matrix[rowBase + exitingCol];
                }
                left += direction;
            }
            maxSum = std::max(maxSum, sum);
        }
    } else {
        std::vector<long long> columnBand(static_cast<std::size_t>(n), 0);
        for (int r = 0; r < s; ++r) {
            const std::size_t rowBase = static_cast<std::size_t>(r) * n;
            #pragma omp simd
            for (int c = 0; c < n; ++c) {
                columnBand[c] += matrix[rowBase + c];
            }
        }

        maxSum = std::numeric_limits<long long>::lowest();
        for (int top = 0; top + s <= n; ++top) {
            long long sum = 0;
            #pragma omp simd reduction(+:sum)
            for (int c = 0; c < s; ++c) {
                sum += columnBand[c];
            }
            maxSum = std::max(maxSum, sum);

            for (int left = 0; left + s < n; ++left) {
                sum += columnBand[left + s] - columnBand[left];
                maxSum = std::max(maxSum, sum);
            }

            if (top + s < n) {
                const std::size_t exitingBase = static_cast<std::size_t>(top) * n;
                const std::size_t enteringBase = static_cast<std::size_t>(top + s) * n;
                #pragma omp simd
                for (int c = 0; c < n; ++c) {
                    columnBand[c] +=
                        static_cast<long long>(matrix[enteringBase + c]) -
                        matrix[exitingBase + c];
                }
            }
        }
    }

    std::printf("%lld\n", maxSum);
    return 0;
}
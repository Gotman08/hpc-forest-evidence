#include <algorithm>
#include <iostream>
#include <vector>

#ifdef _OPENMP
#include <omp.h>
#endif

using namespace std;

constexpr int MOD = 1000000007;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) {
        return 0;
    }

    vector<vector<int>> blocked_rows(n);
    for (int k = 0; k < m; ++k) {
        int row, column;
        cin >> row >> column;
        blocked_rows[row].push_back(column);
    }
    for (vector<int>& row : blocked_rows) {
        sort(row.begin(), row.end());
        row.erase(unique(row.begin(), row.end()), row.end());
    }

    vector<int> previous(n);
    int first_row_paths = 0;
    size_t first_row_block = 0;
    for (int column = 0; column < n; ++column) {
        const bool is_blocked = first_row_block < blocked_rows[0].size() &&
                                blocked_rows[0][first_row_block] == column;
        if (is_blocked) {
            first_row_paths = 0;
            ++first_row_block;
        } else if (column == 0) {
            first_row_paths = 1;
        }
        previous[column] = first_row_paths;
    }

    vector<int> current(n);

#ifdef _OPENMP
    if (n >= 1024 && omp_get_max_threads() > 1) {
        vector<int> carries(omp_get_max_threads());
        vector<int> first_blocks(omp_get_max_threads());

#pragma omp parallel shared(blocked_rows, previous, current, carries, first_blocks, n)
        {
            const int thread_id = omp_get_thread_num();
            const int thread_count = omp_get_num_threads();
            const int begin = static_cast<int>((static_cast<long long>(thread_id) * n) / thread_count);
            const int end = static_cast<int>((static_cast<long long>(thread_id + 1) * n) / thread_count);

            for (int row = 1; row < n; ++row) {
                const vector<int>& blocks = blocked_rows[row];
                vector<int>::const_iterator block = lower_bound(blocks.begin(), blocks.end(), begin);
                const int first_block = (block != blocks.end() && *block < end) ? *block : end;
                int local_paths = 0;

                for (int column = begin; column < end; ++column) {
                    if (block != blocks.end() && *block == column) {
                        local_paths = 0;
                        ++block;
                    } else {
                        local_paths += previous[column];
                        if (local_paths >= MOD) {
                            local_paths -= MOD;
                        }
                    }
                    current[column] = local_paths;
                }
                carries[thread_id] = local_paths;
                first_blocks[thread_id] = first_block;

#pragma omp barrier
#pragma omp single
                {
                    int incoming = 0;
                    for (int thread = 0; thread < thread_count; ++thread) {
                        const int local_end = carries[thread];
                        carries[thread] = incoming;
                        if (first_blocks[thread] == static_cast<int>((static_cast<long long>(thread + 1) * n) / thread_count)) {
                            incoming += local_end;
                            if (incoming >= MOD) {
                                incoming -= MOD;
                            }
                        } else {
                            incoming = local_end;
                        }
                    }
                }

                const int incoming = carries[thread_id];
                for (int column = begin; column < first_blocks[thread_id]; ++column) {
                    int value = current[column] + incoming;
                    if (value >= MOD) {
                        value -= MOD;
                    }
                    current[column] = value;
                }

#pragma omp barrier
#pragma omp single
                { previous.swap(current); }
            }
        }
    } else
#endif
    {
        for (int row = 1; row < n; ++row) {
            const vector<int>& blocks = blocked_rows[row];
            size_t block = 0;
            int paths = 0;
            for (int column = 0; column < n; ++column) {
                if (block < blocks.size() && blocks[block] == column) {
                    paths = 0;
                    ++block;
                } else {
                    paths += previous[column];
                    if (paths >= MOD) {
                        paths -= MOD;
                    }
                }
                current[column] = paths;
            }
            previous.swap(current);
        }
    }

    cout << previous[n - 1] << '\n';
    return 0;
}

#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#ifdef __AVX2__
#include <immintrin.h>
#endif
#include <omp.h>
#include <climits>

int main() {
	int n, s;
	std::cin >> n >> s;
	std::vector<std::vector<int>> matrix(n, std::vector<int>(n));
	for (int i = 0; i < n; i++)
		for (int j = 0; j < n; j++) 
			scanf("%d", &(matrix[i][j]));

	assert(s < n);
	assert(n < 8000);
	assert(s > 0);
	assert(n > 0);

	const int blockSize = 32; // Define a block size for better cache performance
	int mxSum = INT_MIN;

	#pragma omp parallel reduction(max:mxSum)
	{
		int local_mxSum = INT_MIN;
		#pragma omp for collapse(2) schedule(dynamic)
		for (int bi = 0; bi <= n - s; bi += blockSize) {
			for (int bj = 0; bj <= n - s; bj += blockSize) {
				int sum = 0;
				for (int i = bi; i < std::min(bi + blockSize, n - s + 1); ++i) {
					for (int j = bj; j < std::min(bj + blockSize, n - s + 1); ++j) {
						sum = 0;
						for (int ii = i; ii < i + s; ++ii) {
							for (int jj = j; jj < j + s; ++jj) {
#ifdef __AVX2__
								if ((jj + 8 <= s) && (((size_t)&matrix[ii][jj]) % 32 == 0)) {
									__m256i sum_vec = _mm256_setzero_si256();
									for (int k = 0; k < s - s % 8; k += 8) {
										sum_vec = _mm256_add_epi32(sum_vec, _mm256_load_si256((__m256i*)&matrix[ii][jj + k]));
									}
									int temp_sum[8];
									_mm256_storeu_si256((__m256i*)temp_sum, sum_vec);
									for (int k = 0; k < 8; k++) {
										sum += temp_sum[k];
									}
								} else {
									for (int k = jj; k < std::min(jj + 8, s); ++k) {
										sum += matrix[ii][k];
									}
								}
#else
								for (int k = jj; k < std::min(jj + 8, s); ++k) {
									sum += matrix[ii][k];
								}
#endif
							}
						}
						local_mxSum = std::max(local_mxSum, sum);
				}
			}
	}
	#pragma omp critical
	mxSum = std::max(mxSum, local_mxSum);
	}
	printf("%d\n", mxSum);
}
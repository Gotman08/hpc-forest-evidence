        "content": "#include <iostream>\n#include <vector>\n#include <utility>\n#include <cstddef>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nusing namespace std;\n\nstruct adjacency_matrix {\n    size_t vertices;\n    size_t stride;\n    vector<unsigned char> entries;\n\n    explicit adjacency_matrix(int count)\n        : vertices(static_cast<size_t>(count)),\n          stride(((vertices + 15) / 16) * 16),\n          entries(vertices * stride, 0) {}\n\n    size_t size() const {\n        return vertices;\n    }\n\n    unsigned char *operator[](size_t row) {\n        return entries.data() + row * stride;\n    }\n\n    const unsigned char *operator[](size_t row) const {\n        return entries.data() + row * stride;\n    }\n};\n\nadjacency_matrix readGraph();\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\n\nint main(){\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if(!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nadjacency_matrix readGraph(){\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read(vertices);\n\n    cin >> edges;\n    for (int i = 0; i < edges; i++) {\n        cin >> source >> destination;\n        read[destination][source] = read[source][destination] = 1;\n    }\n\n    return read;\n}\n\nbool verifyPermutation(const adjacency_matrix &g1,\n                       const adjacency_matrix &g2,\n                       const vector<int> &equivalence){\n    for (size_t i = 0; i < g1.size(); ++i) {\n        const unsigned char *row1 = g1[i];\n        const unsigned char *row2 = g2[equivalence[i]];\n        for (size_t j = 0; j <= i; ++j) {\n            if (row1[j] != row2[equivalence[j]]) return false;\n        }\n    }\n    return true;\n}\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nbool verifyPermutation(const adjacency_matrix &g1,\n                       const adjacency_matrix &g2,\n                       const vector<unsigned char> &equivalence){\n    const uint8x16_t indices = vld1q_u8(equivalence.data());\n    for (size_t i = 0; i < g1.size(); ++i) {\n        const uint8x16_t expected = vld1q_u8(g1[i]);\n        const uint8x16_t source = vld1q_u8(g2[equivalence[i]]);\n        const uint8x16_t actual = vqtbl1q_u8(source, indices);\n        if (vmaxvq_u8(veorq_u8(expected, actual)) != 0) return false;\n    }\n    return true;\n}\n#endif\n\ntemplate <typename Index>\ninline void printPermutation(const vector<Index> &equivalence, size_t vertices){\n    for (size_t i = 0; i < vertices; ++i)\n        cout << static_cast<int>(equivalence[i]) << \" \";\n    cout << endl;\n}\n\ntemplate <typename Index>\nbool enumeratePermutations(const adjacency_matrix &g1,\n                           const adjacency_matrix &g2){\n    const size_t vertices = g1.size();\n    // TBL returns zero for the inactive lanes, matching the zero row padding.\n    vector<Index> equivalence(vertices < 16 ? 16 : vertices,\n                              static_cast<Index>(255));\n    vector<size_t> exchange_counter(vertices, 0);\n    size_t exchange_index = 1;\n    bool isomorphism_found = false;\n\n    for (size_t i = 0; i < vertices; ++i)\n        equivalence[i] = static_cast<Index>(i);\n\n    if (verifyPermutation(g1, g2, equivalence)) {\n        printPermutation(equivalence, vertices);\n        return true;\n    }\n\n    /* Preserve Heap's permutation sequence and print every nonidentity match. */\n    while (exchange_index < vertices) {\n        if (exchange_counter[exchange_index] < exchange_index) {\n            const size_t partner = exchange_index % 2 == 0\n                ? 0 : exchange_counter[exchange_index];\n            swap(equivalence[partner], equivalence[exchange_index]);\n\n            if (verifyPermutation(g1, g2, equivalence)) {\n                printPermutation(equivalence, vertices);\n                isomorphism_found = true;\n            }\n\n            ++exchange_counter[exchange_index];\n            exchange_index = 1;\n        } else {\n            exchange_counter[exchange_index] = 0;\n            ++exchange_index;\n        }\n    }\n    return isomorphism_found;\n}\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\n    if (g1.size() != g2.size()) return false;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    // One NEON table covers up to 16 vertices. Symmetry makes full-row\n    // comparisons equivalent to checking the original lower triangle.\n    if (g1.size() <= 16)\n        return enumeratePermutations<unsigned char>(g1, g2);\n#endif\n\n    return enumeratePermutations<int>(g1, g2);\n}\n",
        "path": "src/brute_isomorphism.cpp"
      }

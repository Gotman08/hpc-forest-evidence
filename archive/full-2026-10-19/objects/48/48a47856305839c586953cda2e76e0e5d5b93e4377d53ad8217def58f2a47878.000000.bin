{"files":[{"content":"#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <limits>\n#include <memory>\n#include <vector>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#define SUM_USE_NEON 1\n#else\n#define SUM_USE_NEON 0\n#endif\n\nclass FastInput {\n    unsigned char buffer_[65536];\n    std::size_t position_;\n    std::size_t size_;\n\n    int next_char() {\n        if (position_ == size_) {\n            size_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (size_ == 0) return EOF;\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    FastInput() : position_(0), size_(0) {}\n\n    bool read_int(int& result) {\n        int c;\n        do {\n            c = next_char();\n            if (c == EOF) return false;\n        } while (c <= ' ');\n        const bool negative = c == '-';\n        if (c == '-' || c == '+') c = next_char();\n        std::int64_t value = 0;\n        while (c >= '0' && c <= '9') {\n            value = value * 10 + (c - '0');\n            c = next_char();\n        }\n        result = static_cast<int>(negative ? -value : value);\n        return true;\n    }\n};\n\nstatic void read_prefix(FastInput& input, std::int64_t* prefix, int n) {\n    prefix[0] = 0;\n    for (int j = 0; j < n; ++j) {\n        int value = 0;\n        input.read_int(value);\n        prefix[j + 1] = prefix[j] + value;\n    }\n}\n\n#if SUM_USE_NEON\nstatic inline int64x2_t max_lanes(int64x2_t a, int64x2_t b) {\n    return vbslq_s64(vcgtq_s64(a, b), a, b);\n}\n#endif\n\nint main() {\n    FastInput input;\n    int n = 0;\n    int s = 0;\n    if (!input.read_int(n) || !input.read_int(s)) return 0;\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const int width = n - s + 1;\n    std::vector<std::int64_t> prefix(n + 1);\n    std::vector<std::int64_t> sums(width, 0);\n    std::unique_ptr<std::int64_t[]> history(\n        new std::int64_t[static_cast<std::size_t>(s) * width]);\n\n    // Prefix differences make adjacent horizontal windows independent.\n    for (int row = 0; row < s; ++row) {\n        read_prefix(input, prefix.data(), n);\n        std::int64_t* saved = history.get() + static_cast<std::size_t>(row) * width;\n        int j = 0;\n#if SUM_USE_NEON\n        for (; j + 4 <= width; j += 4) {\n            const int64x2_t h0 = vsubq_s64(\n                vld1q_s64(prefix.data() + j + s),\n                vld1q_s64(prefix.data() + j));\n            const int64x2_t h1 = vsubq_s64(\n                vld1q_s64(prefix.data() + j + s + 2),\n                vld1q_s64(prefix.data() + j + 2));\n            vst1q_s64(saved + j, h0);\n            vst1q_s64(saved + j + 2, h1);\n            vst1q_s64(sums.data() + j,\n                vaddq_s64(vld1q_s64(sums.data() + j), h0));\n            vst1q_s64(sums.data() + j + 2,\n                vaddq_s64(vld1q_s64(sums.data() + j + 2), h1));\n        }\n#endif\n        for (; j < width; ++j) {\n            const std::int64_t horizontal = prefix[j + s] - prefix[j];\n            saved[j] = horizontal;\n            sums[j] += horizontal;\n        }\n    }\n\n    std::int64_t best = std::numeric_limits<std::int64_t>::min();\n    int j = 0;\n#if SUM_USE_NEON\n    int64x2_t best0 = vdupq_n_s64(best);\n    int64x2_t best1 = vdupq_n_s64(best);\n    for (; j + 4 <= width; j += 4) {\n        best0 = max_lanes(best0, vld1q_s64(sums.data() + j));\n        best1 = max_lanes(best1, vld1q_s64(sums.data() + j + 2));\n    }\n#endif\n    for (; j < width; ++j) best = std::max(best, sums[j]);\n\n    for (int row = s; row < n; ++row) {\n        read_prefix(input, prefix.data(), n);\n        std::int64_t* saved = history.get()\n            + static_cast<std::size_t>(row % s) * width;\n        int column = 0;\n#if SUM_USE_NEON\n        for (; column + 4 <= width; column += 4) {\n            const int64x2_t h0 = vsubq_s64(\n                vld1q_s64(prefix.data() + column + s),\n                vld1q_s64(prefix.data() + column));\n            const int64x2_t h1 = vsubq_s64(\n                vld1q_s64(prefix.data() + column + s + 2),\n                vld1q_s64(prefix.data() + column + 2));\n            const int64x2_t old0 = vld1q_s64(saved + column);\n            const int64x2_t old1 = vld1q_s64(saved + column + 2);\n            const int64x2_t current0 = vaddq_s64(\n                vld1q_s64(sums.data() + column), vsubq_s64(h0, old0));\n            const int64x2_t current1 = vaddq_s64(\n                vld1q_s64(sums.data() + column + 2), vsubq_s64(h1, old1));\n            vst1q_s64(saved + column, h0);\n            vst1q_s64(saved + column + 2, h1);\n            vst1q_s64(sums.data() + column, current0);\n            vst1q_s64(sums.data() + column + 2, current1);\n            best0 = max_lanes(best0, current0);\n            best1 = max_lanes(best1, current1);\n        }\n#endif\n        for (; column < width; ++column) {\n            const std::int64_t horizontal = prefix[column + s] - prefix[column];\n            sums[column] += horizontal - saved[column];\n            saved[column] = horizontal;\n            best = std::max(best, sums[column]);\n        }\n    }\n\n#if SUM_USE_NEON\n    best = std::max(best, static_cast<std::int64_t>(vgetq_lane_s64(best0, 0)));\n    best = std::max(best, static_cast<std::int64_t>(vgetq_lane_s64(best0, 1)));\n    best = std::max(best, static_cast<std::int64_t>(vgetq_lane_s64(best1, 0)));\n    best = std::max(best, static_cast<std::int64_t>(vgetq_lane_s64(best1, 1)));\n#endif\n    std::printf(\"%lld\\n\", static_cast<long long>(best));\n    return 0;\n}\n","path":"src/solution.cpp"}],"hypothesis":"Row-prefix differences remove horizontal sliding dependencies, allowing ARM64 NEON to update adjacent square-window sums and independent maxima in parallel with O(N²) work.","notes":"Uses 64-bit intermediates, scalar tails and a portable fallback. No commands or evaluation performed; compiler and resource settings remain unchanged.","sources_kept":[],"transformations":["Build each row's prefix sums while reading through a buffered integer reader.","Maintain a ring of S horizontal-window rows and update vertical totals independently by column.","Use ARM64 NEON 64-bit arithmetic with two independent maximum accumulators, reducing lanes only once."]}
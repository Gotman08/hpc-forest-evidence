#include <algorithm>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <limits>
#include <memory>
#include <vector>

#ifdef _OPENMP
#include <omp.h>
#endif

class FastInput {
    unsigned char buffer_[1u << 16];
    std::size_t position_ = 0;
    std::size_t length_ = 0;

    int get() {
        if (position_ == length_) {
            length_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);
            position_ = 0;
            if (length_ == 0) return EOF;
        }
        return buffer_[position_++];
    }

public:
    bool read_int(int& value) {
        int c;
        do {
            c = get();
            if (c == EOF) return false;
        } while (c <= ' ');

        bool negative = false;
        if (c == '-' || c == '+') {
            negative = c == '-';
            c = get();
        }

        long long magnitude = 0;
        while (c >= '0' && c <= '9') {
            magnitude = magnitude * 10 + (c - '0');
            c = get();
        }
        value = static_cast<int>(negative ? -magnitude : magnitude);
        return true;
    }
};

int main() {
    FastInput input;
    int n, s;
    if (!input.read_int(n) || !input.read_int(s)) return 0;
    if (n <= 0 || s <= 0 || s > n) return 0;

    const std::size_t cells = static_cast<std::size_t>(n) * n;
    std::unique_ptr<int[]> matrix(new int[cells]);
    for (std::size_t i = 0; i < cells; ++i) {
        if (!input.read_int(matrix[i])) return 0;
    }
    const int* const values = matrix.get();
    const int m = n - s + 1;

    int workers = 1;
#ifdef _OPENMP
    workers = omp_get_max_threads();
#endif
    const int cache_blocks = (n + 7) / 8;
    const int grain_limit = static_cast<int>(
        std::max<std::size_t>(1, cells / 32768u));
    workers = std::max(1, std::min(workers,
                                 std::min(cache_blocks, grain_limit)));
    const int bands = std::min(workers, m);

    std::vector<int> starts(bands + 1);
    for (int b = 0; b <= bands; ++b) {
        starts[b] = static_cast<int>(static_cast<long long>(m) * b / bands);
    }

    // Align states and column-stripe boundaries to avoid false sharing.
    const std::size_t pitch = static_cast<std::size_t>(cache_blocks) * 8;
    std::unique_ptr<long long[]> storage(
        new long long[static_cast<std::size_t>(bands) * pitch + 8]);
    const std::uintptr_t address =
        reinterpret_cast<std::uintptr_t>(storage.get());
    const std::size_t alignment_offset = (64 - address % 64) % 64;
    long long* const columns =
        storage.get() + alignment_offset / sizeof(long long);

    long long answer = std::numeric_limits<long long>::lowest();

#pragma omp parallel num_threads(workers) if(workers > 1) reduction(max:answer)
    {
        // Each column stripe seeds every band without inter-band barriers.
#pragma omp for schedule(static)
        for (int stripe = 0; stripe < workers; ++stripe) {
            const int col_begin = static_cast<int>(
                static_cast<long long>(cache_blocks) * stripe / workers) * 8;
            const int col_end = std::min(n, static_cast<int>(
                static_cast<long long>(cache_blocks) * (stripe + 1) / workers) * 8);
            int previous_start = 0;

            for (int b = 0; b < bands; ++b) {
                const int begin = starts[b];
                const int shift = begin - previous_start;
                long long* const state = columns + static_cast<std::size_t>(b) * pitch;

                if (b == 0 || s <= 2 * shift) {
#pragma omp simd
                    for (int c = col_begin; c < col_end; ++c) {
                        state[c] = 0;
                    }
                    for (int row = begin; row < begin + s; ++row) {
                        const int* const source = values + static_cast<std::size_t>(row) * n;
#pragma omp simd
                        for (int c = col_begin; c < col_end; ++c) {
                            state[c] += static_cast<long long>(source[c]);
                        }
                    }
                } else {
                    const long long* const previous =
                        columns + static_cast<std::size_t>(b - 1) * pitch;
#pragma omp simd
                    for (int c = col_begin; c < col_end; ++c) {
                        state[c] = previous[c];
                    }
                    for (int row = previous_start; row < begin; ++row) {
                        const int* const outgoing =
                            values + static_cast<std::size_t>(row) * n;
                        const int* const incoming =
                            values + static_cast<std::size_t>(row + s) * n;
#pragma omp simd
                        for (int c = col_begin; c < col_end; ++c) {
                            state[c] += static_cast<long long>(incoming[c])
                                      - static_cast<long long>(outgoing[c]);
                        }
                    }
                }
                previous_start = begin;
            }
        }

        // Seed construction is complete; bands now advance independently.
#pragma omp for schedule(static) nowait
        for (int b = 0; b < bands; ++b) {
            long long* const state = columns + static_cast<std::size_t>(b) * pitch;
            const int begin = starts[b];
            const int end = starts[b + 1];
            long long local_best = std::numeric_limits<long long>::lowest();

            for (int row = begin; row < end; ++row) {
                if (row != begin) {
                    const int* const outgoing =
                        values + static_cast<std::size_t>(row - 1) * n;
                    const int* const incoming =
                        values + static_cast<std::size_t>(row + s - 1) * n;
#pragma omp simd
                    for (int c = 0; c < n; ++c) {
                        state[c] += static_cast<long long>(incoming[c])
                                  - static_cast<long long>(outgoing[c]);
                    }
                }

                long long sum = 0;
#pragma omp simd reduction(+:sum)
                for (int c = 0; c < s; ++c) {
                    sum += state[c];
                }
                local_best = std::max(local_best, sum);
                for (int c = s; c < n; ++c) {
                    sum += state[c] - state[c - s];
                    local_best = std::max(local_best, sum);
                }
            }
            answer = std::max(answer, local_best);
        }
    }

    std::printf("%lld\n", answer);
    return 0;
}

#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>

#define BLOCK_SIZE 128

template<typename T>
void block_max_sum(const std::vector<std::vector<int>>& matrix, int s, int& mxSum) {
    int n = matrix.size();
    for (int bi = 0; bi < n; bi += BLOCK_SIZE) {
        for (int bj = 0; bj < n; bj += BLOCK_SIZE) {
            for (int i = std::min(bi, n - s); i < std::min(bi + BLOCK_SIZE, n - s + 1); ++i) {
                int sum = 0;
                for (int j = std::min(bj, n - s); j < std::min(bj + BLOCK_SIZE, n - s + 1); ++j) {
                    sum += matrix[i][j];
                }
                mxSum = std::max(mxSum, sum);
            }
        }
    }
}

int main() {
    int n, s;
    std::cin >> n >> s;
    std::vector<std::vector<int>> matrix(n, std::vector<int>(n));
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            scanf("%d", &(matrix[i][j]));
        }
    }

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    int mxSum = INT_MIN;
    block_max_sum(matrix, s, mxSum);

    printf("%d\n", mxSum);
}

        "content": "#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <cstring>\n#include <inttypes.h>\n#include <vector>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\nclass FastInput {\n    static constexpr std::size_t bufferSize = 1U << 16;\n    char buffer[bufferSize];\n    std::size_t position = 0;\n    std::size_t available = 0;\n\n    int nextChar() {\n        if (position == available) {\n            available = std::fread(buffer, 1, bufferSize, stdin);\n            position = 0;\n            if (available == 0) {\n                return EOF;\n            }\n        }\n        return static_cast<unsigned char>(buffer[position++]);\n    }\n\npublic:\n    bool readInt(int& value) {\n        int c;\n        do {\n            c = nextChar();\n        } while (c != EOF && c <= ' ');\n        if (c == EOF) {\n            return false;\n        }\n\n        bool negative = false;\n        if (c == '-') {\n            negative = true;\n            c = nextChar();\n        }\n\n        unsigned int magnitude = 0;\n        while (c >= '0' && c <= '9') {\n            magnitude = magnitude * 10U + static_cast<unsigned int>(c - '0');\n            c = nextChar();\n        }\n        const long long signedValue = negative ? -static_cast<long long>(magnitude)\n                                               : static_cast<long long>(magnitude);\n        value = static_cast<int>(signedValue);\n        return true;\n    }\n};\n\nstatic inline void addRow(std::int64_t* __restrict sums,\n                          const int* __restrict row,\n                          int n) {\n#if defined(__aarch64__)\n    int column = 0;\n    for (; column + 4 <= n; column += 4) {\n        const int32x4_t values = vld1q_s32(row + column);\n        const int64x2_t lower = vmovl_s32(vget_low_s32(values));\n        const int64x2_t upper = vmovl_s32(vget_high_s32(values));\n        vst1q_s64(sums + column, vaddq_s64(vld1q_s64(sums + column), lower));\n        vst1q_s64(sums + column + 2, vaddq_s64(vld1q_s64(sums + column + 2), upper));\n    }\n    for (; column < n; ++column) {\n        sums[column] += static_cast<std::int64_t>(row[column]);\n    }\n#else\n#pragma GCC ivdep\n    for (int column = 0; column < n; ++column) {\n        sums[column] += static_cast<std::int64_t>(row[column]);\n    }\n#endif\n}\n\nstatic inline void replaceRow(std::int64_t* __restrict sums,\n                              int* __restrict previous,\n                              const int* __restrict incoming,\n                              int n) {\n#if defined(__aarch64__)\n    int column = 0;\n    for (; column + 4 <= n; column += 4) {\n        const int32x4_t newValues = vld1q_s32(incoming + column);\n        const int32x4_t oldValues = vld1q_s32(previous + column);\n        const int64x2_t lower = vsubq_s64(vmovl_s32(vget_low_s32(newValues)),\n                                          vmovl_s32(vget_low_s32(oldValues)));\n        const int64x2_t upper = vsubq_s64(vmovl_s32(vget_high_s32(newValues)),\n                                          vmovl_s32(vget_high_s32(oldValues)));\n        vst1q_s64(sums + column, vaddq_s64(vld1q_s64(sums + column), lower));\n        vst1q_s64(sums + column + 2, vaddq_s64(vld1q_s64(sums + column + 2), upper));\n    }\n    for (; column < n; ++column) {\n        sums[column] += static_cast<std::int64_t>(incoming[column]) - previous[column];\n    }\n#else\n#pragma GCC ivdep\n    for (int column = 0; column < n; ++column) {\n        sums[column] += static_cast<std::int64_t>(incoming[column]) - previous[column];\n    }\n#endif\n    std::memcpy(previous, incoming, static_cast<std::size_t>(n) * sizeof(int));\n}\n\nstatic inline std::int64_t rowMaximum(const std::int64_t* sums, int n, int s) {\n    std::int64_t window = 0;\n    for (int column = 0; column < s; ++column) {\n        window += sums[column];\n    }\n\n    std::int64_t maximum = window;\n#if defined(__aarch64__)\n    int right = s;\n    for (; right + 3 < n; right += 4) {\n        const int64x2_t differences0 = vsubq_s64(vld1q_s64(sums + right),\n                                                  vld1q_s64(sums + right - s));\n        const int64x2_t differences1 = vsubq_s64(vld1q_s64(sums + right + 2),\n                                                  vld1q_s64(sums + right + 2 - s));\n        const int64x2_t prefix0 = vaddq_s64(\n            differences0, vcombine_s64(vdup_n_s64(0), vget_low_s64(differences0)));\n        const int64x2_t prefix1 = vaddq_s64(\n            differences1, vdupq_n_s64(vgetq_lane_s64(prefix0, 1)));\n        const int64x2_t windows0 = vaddq_s64(vdupq_n_s64(window), prefix0);\n        const int64x2_t windows1 = vaddq_s64(vdupq_n_s64(window), prefix1);\n        const std::int64_t blockMaximum = vmaxvq_s64(vmaxq_s64(windows0, windows1));\n        if (blockMaximum > maximum) {\n            maximum = blockMaximum;\n        }\n        window = vgetq_lane_s64(windows1, 1);\n    }\n    for (; right < n; ++right) {\n        window += sums[right] - sums[right - s];\n        if (window > maximum) {\n            maximum = window;\n        }\n    }\n#else\n    for (int right = s; right < n; ++right) {\n        window += sums[right] - sums[right - s];\n        if (window > maximum) {\n            maximum = window;\n        }\n    }\n#endif\n    return maximum;\n}\n\nint main() {\n    FastInput input;\n    int n;\n    int s;\n    if (!input.readInt(n) || !input.readInt(s)) {\n        return 0;\n    }\n\n    std::vector<std::int64_t> columnSums(static_cast<std::size_t>(n), 0);\n    std::vector<int> history(static_cast<std::size_t>(n) * static_cast<std::size_t>(s));\n    std::vector<int> incoming(static_cast<std::size_t>(n));\n\n    std::int64_t maximum = 0;\n    for (int row = 0; row < n; ++row) {\n        int* slot = history.data() + static_cast<std::size_t>(row % s) * static_cast<std::size_t>(n);\n        if (row < s) {\n            for (int column = 0; column < n; ++column) {\n                input.readInt(slot[column]);\n            }\n            addRow(columnSums.data(), slot, n);\n        } else {\n            for (int column = 0; column < n; ++column) {\n                input.readInt(incoming[column]);\n            }\n            replaceRow(columnSums.data(), slot, incoming.data(), n);\n        }\n\n        if (row + 1 >= s) {\n            const std::int64_t current = rowMaximum(columnSums.data(), n, s);\n            if (row + 1 == s || current > maximum) {\n                maximum = current;\n            }\n        }\n    }\n\n    std::printf(\"%\" PRId64 \"\\n\", maximum);\n    return 0;\n}\n",

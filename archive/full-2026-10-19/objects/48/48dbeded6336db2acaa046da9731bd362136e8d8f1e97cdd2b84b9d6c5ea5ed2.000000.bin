#include <cstdio>
#include <cstddef>
#include <memory>
#include <vector>

class FastInput {
    unsigned char buffer_[1u << 16];
    std::size_t position_ = 0;
    std::size_t size_ = 0;

    int nextByte() {
        if (position_ == size_) {
            size_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);
            position_ = 0;
            if (size_ == 0) return EOF;
        }
        return buffer_[position_++];
    }

public:
    int readInt() {
        int c;
        do {
            c = nextByte();
        } while (c != EOF && c <= ' ');
        if (c == EOF) return 0;

        bool negative = false;
        if (c == '-' || c == '+') {
            negative = (c == '-');
            c = nextByte();
        }
        unsigned int value = 0;
        while (c >= '0' && c <= '9') {
            value = value * 10u + static_cast<unsigned int>(c - '0');
            c = nextByte();
        }
        const long long signedValue = negative
            ? -static_cast<long long>(value)
            : static_cast<long long>(value);
        return static_cast<int>(signedValue);
    }
};

static long long solveRegular(FastInput& input, int n, int s) {
    const std::size_t stride = static_cast<std::size_t>(n);
    std::unique_ptr<int[]> history(new int[stride * static_cast<std::size_t>(s)]);
    std::vector<long long> column(static_cast<std::size_t>(n), 0);

    for (int row = 0; row < s; ++row) {
        int* saved = history.get() + static_cast<std::size_t>(row) * stride;
        for (int j = 0; j < n; ++j) {
            const int value = input.readInt();
            saved[j] = value;
            column[j] += value;
        }
    }

    long long current = 0;
    for (int j = 0; j < s; ++j) current += column[j];
    long long best = current;
    for (int j = s; j < n; ++j) {
        current += column[j] - column[j - s];
        if (current > best) best = current;
    }

    int slot = 0;
    for (int row = s; row < n; ++row) {
        int* expired = history.get() + static_cast<std::size_t>(slot) * stride;
        current = 0;
        for (int j = 0; j < s; ++j) {
            const int value = input.readInt();
            column[j] += static_cast<long long>(value) - expired[j];
            expired[j] = value;
            current += column[j];
        }
        if (current > best) best = current;
        for (int j = s; j < n; ++j) {
            const int value = input.readInt();
            column[j] += static_cast<long long>(value) - expired[j];
            expired[j] = value;
            current += column[j] - column[j - s];
            if (current > best) best = current;
        }
        if (++slot == s) slot = 0;
    }
    return best;
}

static long long solveSharedCore(FastInput& input, int n, int s) {
    const int d = n - s;
    const std::size_t stride = static_cast<std::size_t>(d);
    std::unique_ptr<long long[]> differences(new long long[stride * stride]);
    std::vector<long long> savedFirst(static_cast<std::size_t>(d));
    std::vector<int> left(static_cast<std::size_t>(d));
    std::vector<long long> edgeDifference(static_cast<std::size_t>(d), 0);
    long long first = 0;

    // Save each expiring row as its first-window sum and horizontal differences.
    for (int row = 0; row < d; ++row) {
        long long rowFirst = 0;
        for (int j = 0; j < d; ++j) {
            const int value = input.readInt();
            left[j] = value;
            rowFirst += value;
        }
        for (int j = d; j < s; ++j) rowFirst += input.readInt();
        savedFirst[row] = rowFirst;
        first += rowFirst;

        long long* saved = differences.get() + static_cast<std::size_t>(row) * stride;
        for (int j = 0; j < d; ++j) {
            const long long difference = static_cast<long long>(input.readInt()) - left[j];
            saved[j] = difference;
            edgeDifference[j] += difference;
        }
    }

    // These rows remain in every vertical window and need no history.
    for (int row = d; row < s; ++row) {
        long long rowFirst = 0;
        for (int j = 0; j < d; ++j) {
            const int value = input.readInt();
            left[j] = value;
            rowFirst += value;
        }
        for (int j = d; j < s; ++j) rowFirst += input.readInt();
        first += rowFirst;
        for (int j = 0; j < d; ++j) {
            edgeDifference[j] += static_cast<long long>(input.readInt()) - left[j];
        }
    }

    long long current = first;
    long long best = current;
    for (int j = 0; j < d; ++j) {
        current += edgeDifference[j];
        if (current > best) best = current;
    }

    for (int row = 0; row < d; ++row) {
        const long long* expired = differences.get() + static_cast<std::size_t>(row) * stride;
        long long rowFirst = 0;
        for (int j = 0; j < d; ++j) {
            const int value = input.readInt();
            left[j] = value;
            rowFirst += value;
        }
        for (int j = d; j < s; ++j) rowFirst += input.readInt();
        first += rowFirst - savedFirst[row];
        current = first;
        if (current > best) best = current;

        // Update each accumulated difference only after both new edges are known.
        for (int j = 0; j < d; ++j) {
            const long long difference = static_cast<long long>(input.readInt()) - left[j];
            edgeDifference[j] += difference - expired[j];
            current += edgeDifference[j];
            if (current > best) best = current;
        }
    }
    return best;
}

int main() {
    FastInput input;
    const int n = input.readInt();
    const int s = input.readInt();
    if (n <= 0 || s <= 0 || s >= n) return 0;

    const long long result = s > n / 2
        ? solveSharedCore(input, n, s)
        : solveRegular(input, n, s);
    std::printf("%lld\n", result);
    return 0;
}

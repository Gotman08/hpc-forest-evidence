-\\n-    Point to_evaluate = parse_point();\\n-\\n-    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n-}\\n\\\\ No newline at end of file\\n+#include \\\"knn.h\\\"\\n+#include <stdint.h>\\n+#include <omp.h>\\n+\\n+#define PARALLEL_WORK_THRESHOLD ((size_t)32768)\\n+\\n+static void insert_local_candidate(char *labels, float *distances,\\n+                                   size_t *count, size_t capacity,\\n+                                   float distance, char label) {\\n+    size_t position = 0;\\n+    while (position < *count && !(distance < distances[position])) {\\n+        position++;\\n+    }\\n+\\n+    if (position == capacity) {\\n+        return;\\n+    }\\n+\\n+    if (*count < capacity) {\\n+        (*count)++;\\n+    }\\n+\\n+    for (size_t i = *count - 1; i > position; i--) {\\n+        distances[i] = distances[i - 1];\\n+        labels[i] = labels[i - 1];\\n+    }\\n+\\n+    distances[position] = distance;\\n+    labels[position] = label;\\n+}\\n+\\n+static size_t group_for_point(const size_t *offsets, size_t group_count,\\n+                              size_t point_index) {\\n+    size_t low = 0;\\n+    size_t high = group_count;\\n+\\n+    while (low < high) {\\n+        size_t middle = low + (high - low) / 2;\\n+        if (point_index < offsets[middle + 1]) {\\n+            high = middle;\\n+        } else {\\n+            low = middle + 1;\\n+        }\\n+    }\\n+\\n+    return low;\\n+}\\n+\\n+static int parallel_top_k(int n_groups, Group *groups, int k,\\n+                          char *labels, float *distances) {\\n+    size_t *offsets = NULL;\\n+    char *thread_labels = NULL;\\n+    float *thread_distances = NULL;\\n+    char *merge_labels = NULL;\\n+    float *merge_distances = NULL;\\n+    size_t *counts = NULL;\\n+    int *has_nan = NULL;\\n+    size_t total_points = 0;\\n+    size_t group_count = (size_t)n_groups;\\n+    size_t capacity = 0;\\n+    size_t slots = 0;\\n+    int max_threads = omp_get_max_threads();\\n+    int success = 0;\\n+\\n+    if (n_groups <= 0 || k <= 0 || max_threads <= 1) {\\n+        return 0;\\n+    }\\n+\\n+    for (size_t i = 0; i < group_count; i++) {\\n+        if (groups[i].length < 0 ||\\n+            (size_t)groups[i].length > SIZE_MAX - total_points) {\\n+            return 0;\\n+        }\\n+        total_points += (size_t)groups[i].length;\\n+    }\\n+\\n+    capacity = (size_t)k;\\n+    if (capacity > total_points) {\\n+        capacity = total_points;\\n+    }\\n+    if (capacity == 0) {\\n+        return 0;\\n+    }\\n+\\n+    if (total_points <= SIZE_MAX / capacity &&\\n+        total_points * capacity < PARALLEL_WORK_THRESHOLD) {\\n+        return 0;\\n+    }\\n+\\n+    if (group_count == SIZE_MAX ||\\n+        group_count + 1 > SIZE_MAX / sizeof(*offsets)) {\\n+        goto cleanup;\\n+    }\\n+    offsets = (size_t *)malloc((group_count + 1) * sizeof(*offsets));\\n+    if (offsets == NULL) {\\n+        goto cleanup;\\n+    }\\n+    offsets[0] = 0;\\n+    for (size_t i = 0; i < group_count; i++) {\\n+        offsets[i + 1] = offsets[i] + (size_t)groups[i].length;\\n+    }\\n+\\n+    if ((size_t)max_threads > SIZE_MAX / capacity ||\\n+        capacity > SIZE_MAX / sizeof(*merge_distances)) {\\n+        goto cleanup;\\n+    }\\n+    slots = (size_t)max_threads * capacity;\\n+    if (slots > SIZE_MAX / sizeof(*thread_distances) ||\\n+        (size_t)max_threads > SIZE_MAX / sizeof(*counts) ||\\n+        (size_t)max_threads > SIZE_MAX / sizeof(*has_nan)) {\\n+        goto cleanup;\\n+    }\\n+\\n+    thread_labels = (char *)malloc(slots * sizeof(*thread_labels));\\n+    thread_distances = (float *)malloc(slots * sizeof(*thread_distances));\\n+    merge_labels = (char *)malloc(capacity * sizeof(*merge_labels));\\n+    merge_distances = (float *)malloc(capacity * sizeof(*merge_distances));\\n+    counts = (size_t *)calloc((size_t)max_threads, sizeof(*counts));\\n+    has_nan = (int *)calloc((size_t)max_threads, sizeof(*has_nan));\\n+    if (thread_labels == NULL || thread_distances == NULL ||\\n+        merge_labels == NULL || merge_distances == NULL ||\\n+        counts == NULL || has_nan == NULL) {\\n+        goto cleanup;\\n+    }\\n+\\n+  \"}, {\"id\": \"ea769c1970de49d4\", \"role\": \"B\", \"commit\": \"6dad26170e26e35c8edcbdb49d6e9cfde23c2444\", \"transformations\": {\"files\": [\"src/knn.c\"], \"retained\": [\"Compute squared distances in fixed-size point blocks using an OpenMP SIMD loop; then consume each block sequentially through the existing top-k insertion logic in original traversal order.\"]}, \"mean_seconds\": 2.000794309501847, \"diff\": \"diff --git a/src/knn.c b/src/knn.c\\nindex 337e3b9..e37aecf 100644\\n--- a/src/knn.c\\n+++ b/src/knn.c\\n@@ -1,78 +1,96 @@\\n-#include \\\"knn.h\\\"\\n-\\n-char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n-    char * labels = (char *) malloc(sizeof(char) * k);\\n-    float * distances = (float *) malloc(sizeof(float) * k);\\n-\\n-    int i, j, x, y;\\n-\\n-    for (i = 0; i < k; i++) {\\n-        labels[i] = -1;\\n-        distances[i] = -1;\\n-    }\\n-\\n-    for (i = 0; i < n_groups; i++) {\\n-        Group g = groups[i];\\n-\\n-        for (j = 0; j < g.length; j++) {\\n-            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n-\\n-            for (x = 0; x < k; x++) {\\n-                if (d < distances[x] || distances[x] == -1) {\\n-                    for (y = k - 1; y > x; y--) {\\n-                        distances[y] = distances[y - 1];\\n-                        labels[y] = labels[y - 1];\\n-                    }\\n-\\n-                    distances[x] = d;\\n-                    labels[x] = g.label;\\n-\\n-                    break;\\n-                }\\n-            }\\n-        }\\n-    }\\n-\\n-    qsort(labels, k, sizeof(char), compare_for_sort);\\n-\\n-    char most_frequent = labels[0];\\n-    int most_frequent_count = 1;\\n-    int current_frequency = 1;\\n-\\n-    for (i = 1; i < k; i++) {\\n-        if (labels[i] != labels[i - 1]) {\\n-            if (current_frequency > most_frequent_count) {\\n-                most_frequent = labels[i - 1];\\n-                most_frequent_count = current_frequency;\\n-            }\\n-\\n-            current_frequency = 1;\\n-        } else {\\n-            current_frequency++;\\n-        }\\n-\\n-        if (i == k - 1 && current_frequency > most_frequent_count) {\\n-            most_frequent = labels[i - 1];\\n-            most_frequent_count = current_frequency;\\n-        }\\n-    }\\n-\\n-\\n-    return most_frequent;\\n-}\\n-\\n-int main() {\\n-    int n_groups = parse_number_of_groups();\\n-    \\n-    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n-\\n-    for (int i = 0; i < n_groups; i++) {\\n-        groups[i] = parse_next_group();\\n-    }\\n-\\n-    int k = parse_k();\\n-\\n-    Point to_evaluate = parse_point();\\n-\\n-    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n-}\\n\\\\ No newline at end of file\\n+#include \\\"knn.h\\\"\\n+\\n+#define DISTANCE_BLOCK_SIZE 256\\n+\\n+char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n+    char * labels = (char *) malloc(sizeof(char) * k);\\n+    float * distances = (float *) malloc(sizeof(float) * k);\\n+    float block_distances[DISTANCE_BLOCK_SIZE];\\n+\\n+    int i, j, x, y;\\n+\\n+    for (i = 0; i < k; i++) {\\n+        labels[i] = -1;\\n+        distances[i] = -1;\\n+    }\\n+\\n+    for (i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+\\n+        for (int base = 0; base < g.length; ) {\\n+            int block_count = g.length - base;\\n+            if (block_count > DISTANCE_BLOCK_SIZE) {\\n+                block_count = DISTANCE_BLOCK_SIZE;\\n+            }\\n+\\n+            #pragma omp simd\\n+            for (int t = 0; t < block_count; t++) {\\n+                Point p = g.points[base + t];\\n+                block_distances[t] = ((p.x - to_evaluate.x) * ((p.x - to_evaluate.x))) +\\n+                                     ((p.y - to_evaluate.y) * (p.y - to_evaluate.y));\\n+            }\\n+\\n+            for (int t = 0; t < block_count; t++) {\\n+                float d = block_distances[t];\\n+\\n+                for (x = 0; x < k; x++) {\\n+                    if (d < distances[x] || distances[x] == -1) {\\n+                        for (y = k - 1; y > x; y--) {\\n+                            distances[y] = distances[y - 1];\\n+                            labels[y] = labels[y - 1];\\n+                        }\\n+\\n+                        distances[x] = d;\\n+                        labels[x] = g.label;\\n+\\n+                        break;\\n+                    }\\n+                }\\n+            }\\n+\\n+            base += block_count;\\n+        }\\n+    }\\n+\\n+    qsort(labels, k, sizeof(char), compare_for_sort);\\n+\\n+    char most_frequent = labels[0];\\n+    int most_frequent_count = 1;\\n+    int current_frequency = 1;\\n+\\n+    for (i = 1; i < k; i++) {\\n+        if (labels[i] != labels[i - 1]) {\\n+            if (current_frequency > most_frequent_count) {\\n+                most_frequent = labels[i - 1];\\n+                most_frequent_count = current_frequency;\\n+            }\\n+\\n+            current_frequency = 1;\\n+        } else {\\n+            current_frequency++;\\n+        }\\n+\\n+        if (i == k - 1 && current_frequency > most_frequent_count) {\\n+            most_frequent = labels[i - 1];\\n+            most_frequent_count = current_frequency;\\n+        }\\n+    }\\n+\\n+    return most_frequent;\\n+}\\n+\\n+int main() {\\n+    int n_groups = parse_number_of_groups();\\n+\\n+    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n+\\n+    for (int i = 0; i < n_groups; i++) {\\n+        groups[i] = parse_next_group();\\n+    }\\n+\\n+    int k = parse_k();\\n+\\n+    Point to_evaluate = parse_point();\\n+\\n+    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n+}\"}, {\"id\": \"8e70ac4
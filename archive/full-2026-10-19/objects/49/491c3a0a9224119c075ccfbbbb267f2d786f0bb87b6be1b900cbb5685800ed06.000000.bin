#include <iostream>
#include <vector>
#include <cstdio>
#include <climits>
#include <omp.h>

int main() {
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(nullptr);

    int n, s;
    scanf("%d %d", &n, &s);

    // Read matrix into flat array for cache-friendly access
    std::vector<int> mat(n * n);
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            scanf("%d", &mat[i * n + j]);
        }
    }

    // Prefix sum array: dimensions (n+1) x (n+1), initialized to zero
    std::vector<long long> pref((n + 1) * (n + 1), 0);

    // Row-wise prefix sums – each row independent, parallelized
#pragma omp parallel for
    for (int i = 0; i < n; ++i) {
        long long sum = 0;
        int base_row = (i + 1) * (n + 1);
        for (int j = 1; j <= n; ++j) {
            sum += mat[i * n + (j - 1)];
            pref[base_row + j] = sum;
        }
    }

    // Column-wise prefix sums – each column independent, parallelized
#pragma omp parallel for
    for (int j = 0; j <= n; ++j) {
        long long sum = 0;
        for (int i = 1; i <= n; ++i) {
            pref[i * (n + 1) + j] += sum;
            sum = pref[i * (n + 1) + j];
        }
    }

    // Evaluate all SxS submatrices in O(1) each, using collapse and reduction(max)
    long long mxSum = LLONG_MIN;
#pragma omp parallel for collapse(2) reduction(max:mxSum)
    for (int i = 0; i <= n - s; ++i) {
        for (int j = 0; j <= n - s; ++j) {
            long long sum = pref[(i + s) * (n + 1) + (j + s)]
                          - pref[i * (n + 1) + (j + s)]
                          - pref[(i + s) * (n + 1) + j]
                          + pref[i * (n + 1) + j];
            if (sum > mxSum) mxSum = sum;
        }
    }

    printf("%d\n", static_cast<int>(mxSum));
    return 0;
}

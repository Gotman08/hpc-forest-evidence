      "content": "#include \"knn.h\"\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\nstatic char majority_label(const size_t frequencies[UCHAR_MAX + 1]) {\n    char winner = 0;\n    size_t largest = 0;\n\n    for (int code = 0; code <= UCHAR_MAX; ++code) {\n        char label = (char)code;\n        size_t frequency = frequencies[code];\n        if (frequency > largest ||\n            (frequency != 0 && frequency == largest && label < winner)) {\n            winner = label;\n            largest = frequency;\n        }\n    }\n    return winner;\n}\n\nstatic char insertion_knn(int n_groups, Group *groups, int k,\n                          Point to_evaluate) {\n    char *labels = (char *)malloc(sizeof(char) * (size_t)k);\n    float *distances = (float *)malloc(sizeof(float) * (size_t)k);\n    if (labels == NULL || distances == NULL) {\n        free(labels);\n        free(distances);\n        on_error();\n    }\n\n    for (int i = 0; i < k; ++i) {\n        labels[i] = (char)-1;\n        distances[i] = -1;\n    }\n\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; ++j) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (int x = 0; x < k; ++x) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (int y = k - 1; y > x; --y) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    size_t frequencies[UCHAR_MAX + 1] = {0};\n    for (int i = 0; i < k; ++i) {\n        ++frequencies[(unsigned char)labels[i]];\n    }\n    free(distances);\n    free(labels);\n    return majority_label(frequencies);\n}\n\nstatic int compare_keys(const void *left, const void *right) {\n    uint64_t a = *(const uint64_t *)left;\n    uint64_t b = *(const uint64_t *)right;\n    return (a > b) - (a < b);\n}\n\nstatic uint64_t median_key(uint64_t a, uint64_t b, uint64_t c) {\n    if (a < b) {\n        return b < c ? b : (a < c ? c : a);\n    }\n    return a < c ? a : (b < c ? c : b);\n}\n\nstatic uint64_t select_key(uint64_t *values, size_t count, size_t rank) {\n    size_t lo = 0;\n    size_t hi = count;\n    unsigned int budget = 0;\n    for (size_t span = count; span > 1; span >>= 1) {\n        budget += 2;\n    }\n\n    while (hi - lo > 24) {\n        if (budget == 0) {\n            qsort(values + lo, hi - lo, sizeof(*values), compare_keys);\n            return values[rank];\n        }\n        --budget;\n\n        uint64_t pivot = median_key(values[lo],\n                                    values[lo + (hi - lo) / 2],\n                                    values[hi - 1]);\n        size_t lower = lo;\n        size_t scan = lo;\n        size_t upper = hi;\n\n        while (scan < upper) {\n            uint64_t value = values[scan];\n            if (value < pivot) {\n                values[scan] = values[lower];\n                values[lower] = value;\n                ++lower;\n                ++scan;\n            } else if (value > pivot) {\n                --upper;\n                values[scan] = values[upper];\n                values[upper] = value;\n            } else {\n                ++scan;\n            }\n        }\n\n        if (rank < lower) {\n            hi = lower;\n        } else if (rank >= upper) {\n            lo = upper;\n        } else {\n            return pivot;\n        }\n    }\n\n    for (size_t i = lo + 1; i < hi; ++i) {\n        uint64_t value = values[i];\n        size_t j = i;\n        while (j > lo && values[j - 1] > value) {\n            values[j] = values[j - 1];\n            --j;\n        }\n        values[j] = value;\n    }\n    return values[rank];\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) {\n        return insertion_knn(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t total = 0;\n    size_t frequencies[UCHAR_MAX + 1] = {0};\n    for (int i = 0; i < n_groups; ++i) {\n        size_t length = (size_t)groups[i].length;\n        total += length;\n        frequencies[(unsigned char)groups[i].label] += length;\n    }\n\n    size_t wanted = (size_t)k;\n    if (wanted >= total) {\n        frequencies[(unsigned char)((char)-1)] += wanted - total;\n        return majority_label(frequencies);\n    }\n\n    int exclude_farthest = wanted > total - wanted;\n    size_t retained = exclude_farthest ? total - wanted : wanted;\n    size_t extra = total - retained;\n    if (extra > retained) {\n        extra = retained;\n    }\n    size_t capacity = retained + extra;\n    if (capacity > SIZE_MAX / sizeof(uint64_t)) {\n        return insertion_knn(n_groups, groups, k, to_evaluate);\n    }\n\n    uint64_t *keys = (uint64_t *)malloc(capacity * sizeof(*keys));\n    if (keys == NULL) {\n        return insertion_knn(n_groups, groups, k, to_evaluate);\n    }\n    if (!exclude_farthest) {\n        memset(frequencies, 0, sizeof(frequencies));\n    }\n\n    size_t used = 0;\n    uint64_t cutoff = UINT64_MAX;\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; ++j) {\n            float distance = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            uint32_t distance_bits;\n            memcpy(&distance_bits, &distance, sizeof(distance_bits));\n            distance_bits &= UINT32_C(0x7fffffff);\n\n            if (distance_bits > UINT32_C(0x7f800000)) {\n                free(keys);\n                return insertion_knn(n_groups, groups, k, to_evaluate);\n            }\n\n            /* Group order preserves encounter-order ties between labels. */\n            uint64_t key = ((uint64_t)distance_bits << 32) | (uint32_t)i;\n            if (exclude_farthest) {\n                key = ~key;\n            }\n\n            if (used < retained || key < cutoff) {\n                keys[used++] = key;\n                if (used == capacity) {\n                    cutoff = select_key(keys, used, retained - 1);\n                    used = retained;\n                }\n            }\n        }\n    }\n\n    if (used > retained) {\n        select_key(keys, used, retained - 1);\n    }\n    for (size_t i = 0; i < retained; ++i) {\n        uint64_t key = exclude_farthest ? ~keys[i] : keys[i];\n        unsigned char label = (unsigned char)groups[(uint32_t)key].label;\n        if (exclude_farthest) {\n            --frequencies[label];\n        } else {\n            ++frequencies[label];\n        }\n    }\n\n    free(keys);\n    return majority_label(frequencies);\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",

{
  "src/knn.c": "#include \"knn.h\"\n#include <omp.h>\n\ntypedef struct {\n    float distance;\n    char label;\n    int group_index;\n    int point_index;\n} Candidate;\n\nstatic int candidate_is_worse(Candidate a, Candidate b) {\n    if (a.distance > b.distance) return 1;\n    if (a.distance < b.distance) return 0;\n    if (a.group_index > b.group_index) return 1;\n    if (a.group_index < b.group_index) return 0;\n    return a.point_index > b.point_index;\n}\n\nstatic void sift_down(Candidate *heap, size_t heap_size, size_t root) {\n    while (root < heap_size / 2) {\n        size_t child = root * 2 + 1;\n        size_t worse_child = child;\n        if (child + 1 < heap_size && candidate_is_worse(heap[child + 1], heap[child])) {\n            worse_child = child + 1;\n        }\n        if (!candidate_is_worse(heap[worse_child], heap[root])) break;\n        Candidate temporary = heap[root];\n        heap[root] = heap[worse_child];\n        heap[worse_child] = temporary;\n        root = worse_child;\n    }\n}\n\nstatic void heap_offer(Candidate **heap, size_t *heap_size, size_t *heap_capacity,\n                       size_t limit, Candidate candidate) {\n    if (*heap_size < limit) {\n        if (*heap_size == *heap_capacity) {\n            size_t new_capacity = *heap_capacity == 0 ? 8 : *heap_capacity * 2;\n            if (new_capacity < *heap_capacity || new_capacity > limit) new_capacity = limit;\n            *heap = (Candidate *) realloc(*heap, new_capacity * sizeof(**heap));\n            *heap_capacity = new_capacity;\n        }\n        size_t child = (*heap_size)++;\n        (*heap)[child] = candidate;\n        while (child > 0) {\n            size_t parent = (child - 1) / 2;\n            if (!candidate_is_worse((*heap)[child], (*heap)[parent])) break;\n            Candidate temporary = (*heap)[child];\n            (*heap)[child] = (*heap)[parent];\n            (*heap)[parent] = temporary;\n            child = parent;\n        }\n    } else if (limit > 0 && candidate_is_worse((*heap)[0], candidate)) {\n        (*heap)[0] = candidate;\n        sift_down(*heap, *heap_size, 0);\n    }\n}\n\nstatic char classify_labels(char *labels, int k) {\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nstatic char serial_knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *) malloc(sizeof(char) * (size_t) k);\n    float *distances = (float *) malloc(sizeof(float) * (size_t) k);\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    char result = classify_labels(labels, k);\n    free(labels);\n    free(distances);\n    return result;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    int thread_count = omp_get_max_threads();\n    if (thread_count < 1) thread_count = 1;\n\n    Candidate **thread_heaps = (Candidate **) calloc((size_t) thread_count, sizeof(*thread_heaps));\n    size_t *thread_heap_sizes = (size_t *) calloc((size_t) thread_count, sizeof(*thread_heap_sizes));\n    int has_nan = 0;\n\n    #pragma omp parallel num_threads(thread_count) reduction(|:has_nan)\n    {\n        int thread_id = omp_get_thread_num();\n        Candidate *heap = NULL;\n        size_t heap_size = 0;\n        size_t heap_capacity = 0;\n\n        #pragma omp for schedule(dynamic, 1)\n        for (int i = 0; i < n_groups; i++) {\n            Group *group = &groups[i];\n            for (int j = 0; j < group->length; j++) {\n                float distance = euclidean_distance_no_sqrt(to_evaluate, group->points[j]);\n                if (distance != distance) {\n                    has_nan = 1;\n                    continue;\n                }\n\n                Candidate candidate;\n                candidate.distance = distance;\n                candidate.label = group->label;\n                candidate.group_index = i;\n                candidate.point_index = j;\n                heap_offer(&heap, &heap_size, &heap_capacity, (size_t) k, candidate);\n            }\n        }\n\n        thread_heaps[thread_id] = heap;\n        thread_heap_sizes[thread_id] = heap_size;\n    }\n\n    if (has_nan) {\n        for (int thread_id = 0; thread_id < thread_count; thread_id++) {\n            free(thread_heaps[thread_id]);\n        }\n        free(thread_heaps);\n        free(thread_heap_sizes);\n        return serial_knn(n_groups, groups, k, to_evaluate);\n    }\n\n    Candidate *merged_heap = NULL;\n    size_t merged_size = 0;\n    size_t merged_capacity = 0;\n    for (int thread_id = 0; thread_id < thread_count; thread_id++) {\n        for (size_t i = 0; i < thread_heap_sizes[thread_id]; i++) {\n            heap_offer(&merged_heap, &merged_size, &merged_capacity, (size_t) k,\n                       thread_heaps[thread_id][i]);\n        }\n        free(thread_heaps[thread_id]);\n    }\n    free(thread_heaps);\n    free(thread_heap_sizes);\n\n    char *labels = (char *) malloc(sizeof(char) * (size_t) k);\n    for (int i = 0; i < k; i++) labels[i] = -1;\n    for (size_t i = 0; i < merged_size; i++) labels[i] = merged_heap[i].label;\n\n    char result = classify_labels(labels, k);\n    free(labels);\n    free(merged_heap);\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    Group *groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
  "src/knn.h": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}"
}

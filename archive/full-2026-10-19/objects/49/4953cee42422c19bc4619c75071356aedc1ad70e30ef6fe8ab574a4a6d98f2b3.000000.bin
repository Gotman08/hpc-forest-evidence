      "content": "#include <algorithm>\n#include <cassert>\n#include <climits>\n#include <cstddef>\n#include <cstdio>\n#include <vector>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nclass FastInput {\n    unsigned char buffer_[1 << 16];\n    std::size_t position_;\n    std::size_t length_;\n\n    int next_byte() {\n        if (position_ == length_) {\n            length_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (length_ == 0) return EOF;\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    FastInput() : position_(0), length_(0) {}\n\n    bool read_int(int& result) {\n        int c = next_byte();\n        while (c != EOF && c <= ' ') c = next_byte();\n        if (c == EOF) return false;\n\n        const bool negative = c == '-';\n        if (c == '-' || c == '+') c = next_byte();\n        if (c < '0' || c > '9') return false;\n\n        long long value = 0;\n        do {\n            value = value * 10 + (c - '0');\n            c = next_byte();\n        } while (c >= '0' && c <= '9');\n        result = static_cast<int>(negative ? -value : value);\n        return true;\n    }\n};\n\nstatic void initialize_columns(const int* matrix, int n, int s, int top,\n                               long long* columns) {\n    for (int r = top; r < top + s; ++r) {\n        const int* row = matrix + static_cast<std::size_t>(r) * n;\n        for (int c = 0; c < n; ++c) {\n            columns[c] += static_cast<long long>(row[c]);\n        }\n    }\n}\n\nstatic long long scan_band(const int* matrix, int n, int s,\n                           int first, int last, long long* columns) {\n    long long best = LLONG_MIN;\n    for (int top = first; top < last; ++top) {\n        if (top != first) {\n            const int* leaving = matrix + static_cast<std::size_t>(top - 1) * n;\n            const int* entering = matrix + static_cast<std::size_t>(top + s - 1) * n;\n            for (int c = 0; c < n; ++c) {\n                columns[c] += static_cast<long long>(entering[c])\n                            - static_cast<long long>(leaving[c]);\n            }\n        }\n\n        long long sum = 0;\n        for (int c = 0; c < s; ++c) sum += columns[c];\n        best = std::max(best, sum);\n        for (int c = s; c < n; ++c) {\n            sum += columns[c] - columns[c - s];\n            best = std::max(best, sum);\n        }\n    }\n    return best;\n}\n\n#ifdef _OPENMP\n// Each worker owns a column stripe while constructing every band's seed.\nstatic void initialize_bands_by_prefix(const int* matrix, int n, int s,\n                                      int windows, int worker, int workers,\n                                      long long* seeds) {\n    const int column_first = n * worker / workers;\n    const int column_last = n * (worker + 1) / workers;\n    const int count = column_last - column_first;\n    std::vector<long long> prefix(count, 0);\n    int starts = 0;\n    int ends = 0;\n    int row_index = 0;\n\n    while (ends < workers) {\n        const int next_start = starts < workers\n                             ? windows * starts / workers : n + 1;\n        const int next_end = windows * ends / workers + s;\n        const int event = std::min(next_start, next_end);\n\n        for (; row_index < event; ++row_index) {\n            const int* row = matrix + static_cast<std::size_t>(row_index) * n\n                                   + column_first;\n            for (int c = 0; c < count; ++c) {\n                prefix[c] += static_cast<long long>(row[c]);\n            }\n        }\n\n        while (starts < workers && windows * starts / workers == event) {\n            long long* destination = seeds + static_cast<std::size_t>(starts) * n\n                                           + column_first;\n            for (int c = 0; c < count; ++c) destination[c] = -prefix[c];\n            ++starts;\n        }\n        while (ends < workers && windows * ends / workers + s == event) {\n            long long* destination = seeds + static_cast<std::size_t>(ends) * n\n                                           + column_first;\n            for (int c = 0; c < count; ++c) destination[c] += prefix[c];\n            ++ends;\n        }\n    }\n}\n#endif\n\nstatic long long maximum_sum(const int* matrix, int n, int s) {\n    const int windows = n - s + 1;\n\n#ifdef _OPENMP\n    const std::size_t elements = static_cast<std::size_t>(n) * n;\n    const std::size_t minimum_elements_per_thread = 131072;\n    const int requested = std::min(\n        omp_get_max_threads(),\n        std::max(1, static_cast<int>(elements / minimum_elements_per_thread)));\n\n    if (requested > 1) {\n        std::vector<long long> seeds(static_cast<std::size_t>(requested) * n, 0);\n        long long maximum = LLONG_MIN;\n\n        #pragma omp parallel num_threads(requested) reduction(max: maximum)\n        {\n            const int worker = omp_get_thread_num();\n            const int workers = omp_get_num_threads();\n            const int first = windows * worker / workers;\n            const int last = windows * (worker + 1) / workers;\n            long long* columns = seeds.data() + static_cast<std::size_t>(worker) * n;\n            const int prefix_rows = s + windows * (workers - 1) / workers;\n\n            // Choose the initialization requiring fewer total matrix reads.\n            if (static_cast<long long>(workers) * s <= prefix_rows) {\n                initialize_columns(matrix, n, s, first, columns);\n            } else {\n                initialize_bands_by_prefix(matrix, n, s, windows,\n                                           worker, workers, seeds.data());\n                #pragma omp barrier\n            }\n\n            maximum = scan_band(matrix, n, s, first, last, columns);\n        }\n        return maximum;\n    }\n#endif\n\n    std::vector<long long> columns(n, 0);\n    initialize_columns(matrix, n, s, 0, columns.data());\n    return scan_band(matrix, n, s, 0, windows, columns.data());\n}\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.read_int(n) || !input.read_int(s)) return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    std::vector<int> matrix(static_cast<std::size_t>(n) * n);\n    for (std::size_t i = 0; i < matrix.size(); ++i) {\n        if (!input.read_int(matrix[i])) return 0;\n    }\n\n    std::printf(\"%lld\\n\", maximum_sum(matrix.data(), n, s));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

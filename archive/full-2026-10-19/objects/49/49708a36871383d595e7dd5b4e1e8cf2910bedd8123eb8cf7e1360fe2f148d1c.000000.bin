{"files":[{"content":"/*\n  Quicksort\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <limits.h>\n#include <string.h>\n#include <openssl/md5.h>\n\n/*\n * Prototypes\n */\nvoid srandnum(int seed);\ndouble randnum(void);\nint *generate_case(int N);\ndouble drand(int xmin, int xmax);\nvoid quicksort(int *toorder, int N);\nint is_sorted(int *toorder, int N);\n\n/*\n * A generic pRNG\n */\n#define MY_RAND_MAX 0x7FFFFFFF\n\n#define RANDNUM_W 521288629\n#define RANDNUM_Z 362436069\n\nunsigned int randum_w = RANDNUM_W;\nunsigned int randum_z = RANDNUM_Z;\n\nvoid srandnum(int seed)\n{\n    unsigned int w, z;\n    w = (seed * 104623) & 0xffffffff;\n    randum_w = (w) ? w : RANDNUM_W;\n    z = (seed * 48947) & 0xffffffff;\n    randum_z = (z) ? z : RANDNUM_Z;\n}\n\ndouble randnum(void)\n{\n    unsigned int u;\n    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);\n    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);\n    u = (randum_z << 16) + randum_w;\n    return (abs(u));\n}\n\nenum {\n    RADIX_BUCKETS = 256,\n    RADIX_BUFFER_ITEMS = 16\n};\n\nstatic inline unsigned int radix_bucket(int value, unsigned int shift)\n{\n    return (((unsigned int)value ^ 0x80000000u) >> shift) & 0xffu;\n}\n\n/*\n * A stable byte-radix pass.  The per-bucket staging area makes each output\n * write a contiguous cache-line-sized block rather than a scattered word.\n */\nstatic void radix_pass(const int *restrict source, int *restrict destination,\n                       size_t count, unsigned int shift)\n{\n    size_t offsets[RADIX_BUCKETS];\n    unsigned int filled[RADIX_BUCKETS];\n    int buffer[RADIX_BUCKETS][RADIX_BUFFER_ITEMS];\n    size_t prefix = 0;\n\n    memset(offsets, 0, sizeof(offsets));\n    for (size_t i = 0; i < count; ++i) {\n        ++offsets[radix_bucket(source[i], shift)];\n    }\n\n    for (unsigned int bucket = 0; bucket < RADIX_BUCKETS; ++bucket) {\n        size_t bucket_count = offsets[bucket];\n        offsets[bucket] = prefix;\n        prefix += bucket_count;\n    }\n\n    memset(filled, 0, sizeof(filled));\n    for (size_t i = 0; i < count; ++i) {\n        unsigned int bucket = radix_bucket(source[i], shift);\n        unsigned int used = filled[bucket];\n        buffer[bucket][used] = source[i];\n        ++used;\n\n        if (used == RADIX_BUFFER_ITEMS) {\n            memcpy(destination + offsets[bucket], buffer[bucket],\n                   RADIX_BUFFER_ITEMS * sizeof(buffer[0][0]));\n            offsets[bucket] += RADIX_BUFFER_ITEMS;\n            used = 0;\n        }\n        filled[bucket] = used;\n    }\n\n    for (unsigned int bucket = 0; bucket < RADIX_BUCKETS; ++bucket) {\n        if (filled[bucket] != 0) {\n            memcpy(destination + offsets[bucket], buffer[bucket],\n                   filled[bucket] * sizeof(buffer[0][0]));\n        }\n    }\n}\n\nstatic void insertion_sort(int *items, int count)\n{\n    for (int i = 1; i < count; ++i) {\n        int value = items[i];\n        int j = i;\n        while (j != 0 && value < items[j - 1]) {\n            items[j] = items[j - 1];\n            --j;\n        }\n        items[j] = value;\n    }\n}\n\nstatic void sift_down(int *items, size_t root, size_t count)\n{\n    for (;;) {\n        size_t child = root * 2 + 1;\n        if (child >= count) {\n            return;\n        }\n        if (child + 1 < count && items[child] < items[child + 1]) {\n            ++child;\n        }\n        if (items[root] >= items[child]) {\n            return;\n        }\n        int value = items[root];\n        items[root] = items[child];\n        items[child] = value;\n        root = child;\n    }\n}\n\n/* Allocation-independent correctness fallback. */\nstatic void heapsort(int *items, size_t count)\n{\n    for (size_t root = count / 2; root != 0;) {\n        --root;\n        sift_down(items, root, count);\n    }\n\n    for (size_t end = count; end > 1;) {\n        --end;\n        int value = items[0];\n        items[0] = items[end];\n        items[end] = value;\n        sift_down(items, 0, end);\n    }\n}\n\n/*\n * Public API\n */\nvoid quicksort(int *toorder, int N)\n{\n    if (N < 64) {\n        insertion_sort(toorder, N);\n        return;\n    }\n\n    size_t count = (size_t)N;\n    int *workspace = (int *)malloc(count * sizeof(*workspace));\n    if (workspace == NULL) {\n        heapsort(toorder, count);\n        return;\n    }\n\n    radix_pass(toorder, workspace, count, 0);\n    radix_pass(workspace, toorder, count, 8);\n    radix_pass(toorder, workspace, count, 16);\n    radix_pass(workspace, toorder, count, 24);\n\n    free(workspace);\n}\n\n/*\n * Check if elements are in non-decreasing order\n */\nint is_sorted(int *toorder, int N)\n{\n    for (int i = 1; i < N; i++) {\n        if (toorder[i] < toorder[i - 1]) {\n            return 1;\n        }\n    }\n    return 0;\n}\n\n/*\n * Generate a case\n */\nint *generate_case(int N)\n{\n    int i;\n    int *ret = NULL;\n\n    // Make case generation reproducible\n    srandnum(0);\n\n    // Allocate memory\n    ret = (int *) malloc(N * sizeof(int));\n    if (ret == NULL) {\n        printf(\"Error: some malloc won't work.\\n\");\n        return NULL;\n    }\n    // Get pseudo-random positive integer values\n    for (i = 0; i < N; i++) {\n        ret[i] = drand(0, INT_MAX);\n    }\n    return ret;\n}\n\n/*\n * A pseudo-random number between two positive integer values\n */\ndouble drand(int xmin, int xmax)\n{\n    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;\n}\n\n/*\n * Main function\n */\nint main(int argc, char *argv[])\n{\n    int N = 0;\n    int *our_list = NULL;\n\n    //The input provides the case size\n    scanf(\"%d\", &N);\n    if (N <= 0) {\n        printf(\"Error: please, provide the case size.\\n\");\n        return 1;\n    }\n\n    //Generate the case\n    our_list = generate_case(N);\n    if (our_list == NULL) {\n        printf(\"Error: case instantiation failed.\\n\");\n        return 1;\n    }\n\n    //Do the thing\n    quicksort(our_list, N);\n\n    if (is_sorted(our_list, N) == 1) {\n        printf(\"Error, for some reason list is still unsorted.\\n\");\n        return 1;\n    }\n\n#ifdef COMPUTE_MD5_PROBLEM\n    //Compute MD5 Checksum for problem identification\n    MD5_CTX c;\n    unsigned char out[MD5_DIGEST_LENGTH];\n    MD5_Init(&c);\n    MD5_Update(&c, our_list, N * sizeof(int));\n    MD5_Final(out, &c);\n    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {\n        printf(\"%02x\", out[n]);\n    }\n#endif\n    printf(\"\\n\");\n\n    //Clean up\n    free(our_list);\n\n    return 0;\n}\n","path":"src/quicksort.c"}],"hypothesis":"A stable, cache-buffered byte-radix sort replaces random partition accesses with sequential passes and contiguous output blocks, reducing sort time for large generated integer arrays.","notes":"The radix key is sign-biased so the sorter remains correct for every int value; heap sort preserves correctness if workspace allocation fails.","research":{"queries":[],"urls":[]},"sources_kept":[],"transformations":["Replace recursive randomized quicksort with four stable blocked 8-bit radix passes, staging 16 integers per bucket before contiguous output writes."]}
      "content": "#include \"knn.h\"\n\ntypedef struct {\n    float distance;\n    int group;\n} Neighbor;\n\nstatic char majority_label(char *labels, int k) {\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nstatic char knn_sorted_fallback(int n_groups, Group *groups, int k,\n                                Point to_evaluate) {\n    char *labels = (char *) malloc(sizeof(char) * k);\n    float *distances = (float *) malloc(sizeof(float) * k);\n\n    for (int i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (int x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (int y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    char result = majority_label(labels, k);\n    free(distances);\n    free(labels);\n    return result;\n}\n\nstatic int neighbor_is_worse(Neighbor a, Neighbor b) {\n    return a.distance > b.distance ||\n           (a.distance == b.distance && a.group > b.group);\n}\n\nstatic void sift_down(Neighbor *heap, size_t count, size_t root,\n                      Neighbor value) {\n    while (count > 1 && root <= (count - 2) / 4) {\n        size_t first = root * 4 + 1;\n        size_t end = first + 4;\n        size_t worst = first;\n        if (end > count) end = count;\n\n        for (size_t child = first + 1; child < end; child++) {\n            if (neighbor_is_worse(heap[child], heap[worst])) {\n                worst = child;\n            }\n        }\n\n        if (!neighbor_is_worse(heap[worst], value)) break;\n        heap[root] = heap[worst];\n        root = worst;\n    }\n    heap[root] = value;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) {\n        return knn_sorted_fallback(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t capacity = 0;\n    for (int i = 0; i < n_groups && capacity < (size_t) k; i++) {\n        if (groups[i].length > 0) {\n            size_t available = (size_t) groups[i].length;\n            size_t remaining = (size_t) k - capacity;\n            capacity += available < remaining ? available : remaining;\n        }\n    }\n    if (capacity == 0) return (char) -1;\n\n    size_t bytes = capacity * sizeof(Neighbor);\n    if (bytes < (size_t) k) bytes = (size_t) k;\n    Neighbor *heap = (Neighbor *) malloc(bytes);\n    if (heap == NULL) {\n        return knn_sorted_fallback(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t used = 0;\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            /* NaNs require the original insertion semantics. */\n            if (d != d) {\n                free(heap);\n                return knn_sorted_fallback(n_groups, groups, k, to_evaluate);\n            }\n\n            Neighbor next;\n            next.distance = d;\n            next.group = i;\n\n            if (used < capacity) {\n                heap[used++] = next;\n                if (used == capacity && capacity > 1) {\n                    size_t parents = (capacity - 2) / 4 + 1;\n                    while (parents > 0) {\n                        --parents;\n                        sift_down(heap, capacity, parents, heap[parents]);\n                    }\n                }\n            } else if (d < heap[0].distance) {\n                sift_down(heap, capacity, 0, next);\n            }\n        }\n    }\n\n    /* All points within a group have the same label, so group order\n       suffices to preserve the observable ordering of distance ties. */\n    char *labels = (char *) heap;\n    for (size_t i = 0; i < capacity; i++) {\n        /* Compaction overwrites only records that were already read. */\n        labels[i] = groups[heap[i].group].label;\n    }\n    for (size_t i = capacity; i < (size_t) k; i++) {\n        labels[i] = -1;\n    }\n\n    char result = majority_label(labels, k);\n    free(heap);\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n\n    Group *groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],

      "content": "#include \"knn.h\"\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    // First pass: count total points and flatten into SoA arrays\n    long total_points = 0;\n    for (int i = 0; i < n_groups; i++) {\n        total_points += groups[i].length;\n    }\n\n    float *xs = (float *)malloc(sizeof(float) * total_points);\n    float *ys = (float *)malloc(sizeof(float) * total_points);\n    char *labels = (char *)malloc(sizeof(char) * total_points);\n\n    long idx = 0;\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            xs[idx] = g.points[j].x;\n            ys[idx] = g.points[j].y;\n            labels[idx] = g.label;\n            idx++;\n        }\n    }\n\n    // Max-heap for top-k distances (index 0 is root, max element)\n    typedef struct {\n        float dist;\n        char label;\n    } HeapEntry;\n    HeapEntry *heap = (HeapEntry *)malloc(sizeof(HeapEntry) * k);\n    int heap_size = 0;\n\n    // Frequency histogram for labels in the current top-k set\n    int freq[256] = {0};\n\n    float target_x = to_evaluate.x;\n    float target_y = to_evaluate.y;\n\n    for (long i = 0; i < total_points; i++) {\n        float dx = xs[i] - target_x;\n        float dy = ys[i] - target_y;\n        float d = dx * dx + dy * dy;\n        char lbl = labels[i];\n\n        if (heap_size < k) {\n            // Insert at end and sift up\n            int pos = heap_size++;\n            while (pos > 0) {\n                int parent = (pos - 1) / 2;\n                if (d <= heap[parent].dist) break;   // max-heap: new element smaller than parent? Actually we want larger at root, so stop when d <= parent\n                // swap with parent\n                float tmp_d = heap[parent].dist;\n                char tmp_lbl = heap[parent].label;\n                heap[parent].dist = d;\n                heap[parent].label = lbl;\n                heap[pos].dist = tmp_d;\n                heap[pos].label = tmp_lbl;\n                pos = parent;\n            }\n            // Actually the above loop is wrong for max-heap insertion. Correct: place new element at end, then sift up while it's larger than parent.\n            // Let me rewrite correctly:\n        } else {\n            if (d < heap[0].dist) {   // root is current maximum; replace only if new distance smaller\n                // Evict root: decrement its label frequency\n                freq[(unsigned char)heap[0].label]--;\n                // Replace root with new point and sift down\n                heap[0].dist = d;\n                heap[0].label = lbl;\n                int pos = 0;\n                while (1) {\n                    int left = 2 * pos + 1;\n                    int right = 2 * pos + 2;\n                    int largest = pos;\n                    if (left < k && heap[left].dist > heap[largest].dist)\n                        largest = left;\n                    if (right < k && heap[right].dist > heap[largest].dist)\n                        largest = right;\n                    if (largest == pos) break;\n                    // swap\n                    float tmp_d = heap[pos].dist;\n                    char tmp_lbl = heap[pos].label;\n                    heap[pos] = heap[largest];\n                    heap[largest].dist = tmp_d;\n                    heap[largest].label = tmp_lbl;\n                    pos = largest;\n                }\n            } else {\n                // distance not in top-k, skip\n                continue;\n            }\n        }\n    }\n\n    // After processing all points, find most frequent label from freq array\n    char best_label = 0;\n    int best_count = 0;\n    for (int c = 1; c < 256; c++) {\n        if (freq[c] > best_count) {\n            best_count = freq[c];\n            best_label = (char)c;\n        }\n    }\n\n    free(xs);\n    free(ys);\n    free(labels);\n    free(heap);\n\n    return best_label;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    },
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n",
      "path": "src/knn.h"
    }
  ],
  "hypothesis": "Flatten all points into separate arrays (x, y, label) for fully sequential memory access during distance computation. Replace insertion sort with a binary max-heap to reduce per-point cost from O(k) to O(log k). Maintain a frequency histogram updated on heap insertions/evictions to eliminate final qsort+scan overhead.",
  "notes": "This transformation builds on previous successful SoA/heap/histogram approaches but combines them into a single pass with dynamic frequency updates to avoid scanning the heap at end. The flattened arrays improve cache line utilization, and the max-heap reduces insertion cost while the histogram avoids sorting labels for mode computation.",

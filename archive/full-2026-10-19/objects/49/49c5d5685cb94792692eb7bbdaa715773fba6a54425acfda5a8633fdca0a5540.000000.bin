#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <string.h>
#include <stdint.h>

#if defined(__aarch64__)
#include <arm_neon.h>
#endif

#define MAXNUM 100
#define MAXSTR 50
#define MAXRESULTS 1000

char firstHalf[MAXNUM][MAXSTR];
char secondHalf[MAXNUM][MAXSTR];
char strToTest[MAXSTR];
long int result[MAXRESULTS];
int numPrimes=0;

static long int candidates[MAXNUM * MAXNUM];
enum { SIEVE_SIZE = 65536, DIVISOR_CAPACITY = SIEVE_SIZE / 2 };
static unsigned char composite[SIEVE_SIZE];
static uint32_t divisor_inverse[DIVISOR_CAPACITY];
static uint32_t divisor_threshold[DIVISOR_CAPACITY];
static uint32_t divisor_square[DIVISOR_CAPACITY];
static size_t divisor_count;
static uint32_t prepared_maximum;

static void prepare_divisors(uint32_t maximum)
{
    uint32_t limit;
    if (maximum <= prepared_maximum)
        return;

    limit = (uint32_t)sqrt((double)maximum);
    while ((uint64_t)(limit + 1u) * (limit + 1u) <= maximum)
        ++limit;
    while ((uint64_t)limit * limit > maximum)
        --limit;

    memset(composite, 0, (size_t)limit + 1u);
    divisor_count = 0;
    for (uint32_t p = 3u; p <= limit; p += 2u) {
        if (composite[p])
            continue;

        /* Newton iteration computes the odd divisor's inverse modulo 2^32. */
        uint32_t inverse = 1u;
        for (unsigned int step = 0; step < 5u; ++step)
            inverse *= 2u - p * inverse;

        uint32_t square = p * p;
        divisor_inverse[divisor_count] = inverse;
        divisor_threshold[divisor_count] = UINT32_MAX / p;
        divisor_square[divisor_count] = square;
        ++divisor_count;

        if (square <= limit) {
            for (uint32_t multiple = square; multiple <= limit;
                 multiple += 2u * p)
                composite[multiple] = 1;
        }
    }
    prepared_maximum = maximum;
}

int isprime(long int value)
{
    if (value < 2)
        return 0;
    if ((value & 1L) == 0)
        return value == 2;

    if ((uint64_t)value > UINT32_MAX) {
        uint64_t n = (uint64_t)value;
        for (uint64_t factor = 3u; factor <= n / factor; factor += 2u)
            if (n % factor == 0)
                return 0;
        return 1;
    }

    uint32_t n = (uint32_t)value;
    prepare_divisors(n);
    size_t i = 0;

    /* For odd p, p divides n iff low32(n * inverse(p)) <= UINT32_MAX / p. */
#if defined(__aarch64__)
    uint32x4_t values = vdupq_n_u32(n);
    for (; i + 4u <= divisor_count && divisor_square[i + 3u] <= n;
         i += 4u) {
        uint32x4_t products = vmulq_u32(
            values, vld1q_u32(divisor_inverse + i));
        uint32x4_t divides = vcleq_u32(
            products, vld1q_u32(divisor_threshold + i));
        if (vmaxvq_u32(divides) != 0u)
            return 0;
    }
#endif
    for (; i < divisor_count && divisor_square[i] <= n; ++i)
        if ((uint32_t)((uint64_t)n * divisor_inverse[i]) <=
            divisor_threshold[i])
            return 0;
    return 1;
}

void quicksort(long int *primes,int first,int last)
{ int i, j, pivot;
  long int temp;

  if (first<last)
     { pivot=first;
       i=first;
       j=last;
       while(i<j)
         { while (primes[i]<=primes[pivot]&&i<last)
             i++;
           while(primes[j]>primes[pivot])
             j--;
           if (i<j)
              { temp=primes[i];
                primes[i]=primes[j];
                primes[j]=temp;
              }
         }
       temp=primes[pivot];
       primes[pivot]=primes[j];
       primes[j]=temp;
       quicksort(primes,first,j-1);
       quicksort(primes,j+1,last);
     }
}


int main(int argc,char** argv)
{ FILE *primesFile;
  int i=0,j=0,numResults=0,numCandidates=0;
  long int primeToTest;
  uint32_t maximum32=0;
  primesFile=stdin;
  fscanf(primesFile,"%d\n",&numPrimes);
  for (i=0;i<numPrimes;i++)
      fscanf(primesFile,"%s\n",firstHalf[i]);
  for (i=0;i<numPrimes;i++)
      fscanf(primesFile,"%s\n",secondHalf[i]);
  fclose(primesFile);
  for (i=0;i<numPrimes;i++)
      for (j=0;j<numPrimes;j++)
          { strcpy(strToTest,firstHalf[i]);
            strcat(strToTest,secondHalf[j]);
            primeToTest=atol(strToTest);
            candidates[numCandidates++]=primeToTest;
            if (primeToTest>0 && (uint64_t)primeToTest<=UINT32_MAX &&
                (uint32_t)primeToTest>maximum32)
                maximum32=(uint32_t)primeToTest;
          }
  prepare_divisors(maximum32);
  for (i=0;i<numCandidates;i++)
      { primeToTest=candidates[i];
        if (isprime(primeToTest))
           { result[numResults++]=primeToTest;
           }
      }
  quicksort(result,0,numResults-1);
  for (i=0;i<numResults;i++)
      printf("%ld\n",result[i]);
  return 0;
}

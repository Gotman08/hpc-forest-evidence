#include <cstdio>
#include <limits>
#include <vector>

int main() {
    int n, s;
    if (std::scanf("%d%d", &n, &s) != 2) return 0;

    std::vector<int> matrix(static_cast<std::size_t>(n) * n);
    for (std::size_t i = 0; i < matrix.size(); ++i) {
        std::scanf("%d", &matrix[i]);
    }

    std::vector<long long> column_sums(n, 0);
    for (int r = 0; r < s; ++r) {
        const int* row = &matrix[static_cast<std::size_t>(r) * n];
        for (int c = 0; c < n; ++c) {
            column_sums[c] += row[c];
        }
    }

    long long best = std::numeric_limits<long long>::lowest();
    for (int top = 0; top <= n - s; ++top) {
        long long window_sum = 0;
        for (int c = 0; c < s; ++c) {
            window_sum += column_sums[c];
        }
        if (window_sum > best) best = window_sum;

        for (int left = 1; left <= n - s; ++left) {
            window_sum -= column_sums[left - 1];
            window_sum += column_sums[left + s - 1];
            if (window_sum > best) best = window_sum;
        }

        if (top < n - s) {
            const int* outgoing = &matrix[static_cast<std::size_t>(top) * n];
            const int* incoming = &matrix[static_cast<std::size_t>(top + s) * n];
            for (int c = 0; c < n; ++c) {
                column_sums[c] -= outgoing[c];
                column_sums[c] += incoming[c];
            }
        }
    }

    std::printf("%lld\n", best);
    return 0;
}

/*
  Quicksort
*/
#include <stdio.h>
#include <stdlib.h>
#include <limits.h>
#include <openssl/md5.h>

/*
 * Prototypes
 */
void srandnum(int seed);
double randnum(void);
int *generate_case(int N);
double drand(int xmin, int xmax);
void swap(int *toorder, int i, int j);
int partition(int *toorder, int lo, int hi);
void _quicksort(int *toorder, int lo, int hi);
void quicksort(int *toorder, int N);
int is_sorted(int *toorder, int N);
static void _quicksort_seeded(int *toorder, int lo, int hi,
                              unsigned int seed, int allow_tasks);
static unsigned int next_pivot_random(unsigned int *state);
static unsigned int derive_seed(unsigned int value);
static void insertion_sort(int *toorder, int lo, int hi);

/*
 * A generic pRNG
 */
#define MY_RAND_MAX 0x7FFFFFFF

#define RANDNUM_W 521288629
#define RANDNUM_Z 362436069

#define INSERTION_CUTOFF 24
#define TASK_CUTOFF 8192
#define PARALLEL_CUTOFF 65536

unsigned int randum_w = RANDNUM_W;
unsigned int randum_z = RANDNUM_Z;

void srandnum(int seed)
{
    unsigned int w, z;
    w = (seed * 104623) & 0xffffffff;
    randum_w = (w) ? w : RANDNUM_W;
    z = (seed * 48947) & 0xffffffff;
    randum_z = (z) ? z : RANDNUM_Z;
}

double randnum(void)
{
    unsigned int u;
    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);
    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);
    u = (randum_z << 16) + randum_w;
    return (abs(u));
}

/*
 * Main function
 */
int main(int argc, char *argv[])
{
    int N = 0;
    int *our_list = NULL;

    //The input provides the case size
    scanf("%d", &N);
    if (N <= 0) {
        printf("Error: please, provide the case size.\n");
        return 1;
    }

    //Generate the case
    our_list = generate_case(N);
    if (our_list == NULL) {
        printf("Error: case instantiation failed.\n");
        return 1;
    }

    //Do the thing
    quicksort(our_list, N);

    if (is_sorted(our_list, N) == 1) {
        printf("Error, for some reason list is still unsorted.\n");
        return 1;
    }

#ifdef COMPUTE_MD5_PROBLEM
    //Compute MD5 Checksum for problem identification
    MD5_CTX c;
    unsigned char out[MD5_DIGEST_LENGTH];
    MD5_Init(&c);
    MD5_Update(&c, our_list, N * sizeof(int));
    MD5_Final(out, &c);
    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {
        printf("%02x", out[n]);
    }
#endif
    printf("\n");

    //Clean up
    free(our_list);

    return 0;
}

/*
 * Public API
 */
void quicksort(int *toorder, int N)
{
    if (N <= 1)
        return;

    if (N < PARALLEL_CUTOFF) {
        _quicksort_seeded(toorder, 0, N - 1, 0x243f6a88U, 0);
        return;
    }

    #pragma omp parallel
    {
        #pragma omp single
        _quicksort_seeded(toorder, 0, N - 1, 0x243f6a88U, 1);
    }
}

/*
 * Internal serial entry point retained for callers of the original API.
 */
void _quicksort(int *toorder, int lo, int hi)
{
    _quicksort_seeded(toorder, lo, hi, 0x243f6a88U, 0);
}

static unsigned int next_pivot_random(unsigned int *state)
{
    unsigned int x = *state;
    if (x == 0)
        x = 0x6d2b79f5U;
    x ^= x << 13;
    x ^= x >> 17;
    x ^= x << 5;
    *state = x;
    return x;
}

static unsigned int derive_seed(unsigned int value)
{
    value ^= value >> 16;
    value *= 0x7feb352dU;
    value ^= value >> 15;
    value *= 0x846ca68bU;
    value ^= value >> 16;
    return value ? value : 0x6d2b79f5U;
}

static void insertion_sort(int *toorder, int lo, int hi)
{
    for (int i = lo + 1; i <= hi; i++) {
        int value = toorder[i];
        int j = i;
        while (j > lo && toorder[j - 1] > value) {
            toorder[j] = toorder[j - 1];
            j--;
        }
        toorder[j] = value;
    }
}

/*
 * In-place three-way quicksort. Each recursive partition has independent
 * pivot state so OpenMP tasks never share the generator used for case creation.
 */
static void _quicksort_seeded(int *toorder, int lo, int hi,
                              unsigned int seed, int allow_tasks)
{
    while (lo < hi) {
        int count = hi - lo + 1;
        if (count <= INSERTION_CUTOFF) {
            insertion_sort(toorder, lo, hi);
            return;
        }

        unsigned int random_value = next_pivot_random(&seed);
        int pivot_index = lo + (int)(random_value % (unsigned int)count);
        int pivot = toorder[pivot_index];
        int less = lo;
        int current = lo;
        int greater = hi;

        while (current <= greater) {
            if (toorder[current] < pivot) {
                int tmp = toorder[less];
                toorder[less] = toorder[current];
                toorder[current] = tmp;
                less++;
                current++;
            } else if (toorder[current] > pivot) {
                int tmp = toorder[current];
                toorder[current] = toorder[greater];
                toorder[greater] = tmp;
                greater--;
            } else {
                current++;
            }
        }

        int left_size = less - lo;
        int right_size = hi - greater;
        unsigned int left_seed = derive_seed(seed + 0x9e3779b9U);
        unsigned int right_seed = derive_seed(seed + 0x85ebca6bU);

        if (allow_tasks && count >= TASK_CUTOFF) {
            if (left_size <= right_size) {
                if (left_size > 1) {
                    if (left_size >= TASK_CUTOFF) {
                        #pragma omp task firstprivate(toorder, lo, less, left_seed, allow_tasks)
                        _quicksort_seeded(toorder, lo, less - 1, left_seed,
                                          allow_tasks);
                    } else {
                        _quicksort_seeded(toorder, lo, less - 1, left_seed,
                                          allow_tasks);
                    }
                }
                lo = greater + 1;
                seed = right_seed;
            } else {
                if (right_size > 1) {
                    if (right_size >= TASK_CUTOFF) {
                        #pragma omp task firstprivate(toorder, greater, hi, right_seed, allow_tasks)
                        _quicksort_seeded(toorder, greater + 1, hi, right_seed,
                                          allow_tasks);
                    } else {
                        _quicksort_seeded(toorder, greater + 1, hi, right_seed,
                                          allow_tasks);
                    }
                }
                hi = less - 1;
                seed = left_seed;
            }
            continue;
        }

        /* Recurse on the smaller side and iterate over the larger side. */
        if (left_size <= right_size) {
            if (left_size > 1)
                _quicksort_seeded(toorder, lo, less - 1, left_seed,
                                  allow_tasks);
            lo = greater + 1;
            seed = right_seed;
        } else {
            if (right_size > 1)
                _quicksort_seeded(toorder, greater + 1, hi, right_seed,
                                  allow_tasks);
            hi = less - 1;
            seed = left_seed;
        }
    }
}

/*
 * Swap two values.
 */
void swap(int *toorder, int i, int j)
{
    int temp = toorder[i];
    toorder[i] = toorder[j];
    toorder[j] = temp;
}

/*
 * Partition decision retained for compatibility with the original interface.
 */
int partition(int *toorder, int lo, int hi)
{
    int b = lo;
    int r = (int) (lo + (hi - lo) * (randnum() / MY_RAND_MAX));
    int pivot = toorder[r];
    swap(toorder, r, hi);
    for (int i = lo; i < hi; i++) {
        if (toorder[i] < pivot) {
            swap(toorder, i, b);
            b++;
        }
    }
    swap(toorder, hi, b);
    return b;
}

/*
 * Check if elements are in non-decreasing order
 */
int is_sorted(int *toorder, int N)
{
    for (int i = 1; i < N; i++) {
        if (toorder[i] < toorder[i - 1]) {
            return 1;
        }
    }
    return 0;
}


/*
 * Generate a case
 */
int *generate_case(int N)
{
    int i;
    int *ret = NULL;

    // Make case generation reproducible
    srandnum(0);

    // Allocate memory
    ret = (int *) malloc(N * sizeof(int));
    if (ret == NULL) {
        printf("Error: some malloc won't work.\n");
        return NULL;
    }
    // Get pseudo-random positive integer values
    for (i = 0; i < N; i++) {
        ret[i] = drand(0, INT_MAX);
    }
    return ret;
}

/*
 * A pseudo-random number between two positive integer values
 */
double drand(int xmin, int xmax)
{
    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;
}

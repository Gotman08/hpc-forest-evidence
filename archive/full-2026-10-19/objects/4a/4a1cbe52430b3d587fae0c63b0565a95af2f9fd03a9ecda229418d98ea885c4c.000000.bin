        "hypothesis": "Coarse-grained OpenMP construction of independent child spanning trees can improve four-core throughput while ordered publication preserves the original partition search order.",
        "id": "5efa73b360734393",
        "ordinal": 1,
        "parent_id": null,
        "role": "C",

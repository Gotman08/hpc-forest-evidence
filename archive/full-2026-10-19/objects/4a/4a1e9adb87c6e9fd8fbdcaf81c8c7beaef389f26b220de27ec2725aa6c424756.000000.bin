{
  "src/laplace_seq.c": "/*\n    This program solves Laplace's equation on a regular 2D grid using simple Jacobi iteration.\n\n    The stencil calculation stops when  ( err >= CONV_THRESHOLD OR  iter > ITER_MAX )\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <time.h>\n#include <sys/time.h>\n\n#define CONV_THRESHOLD 1.0e-5f // threshold of convergence\n\n// Matrix to be solved, stored contiguously in row-major order.\ndouble *grid;\n\n// Auxiliary matrix, stored contiguously in row-major order.\ndouble *new_grid;\n\n// Size of each side of the grid.\nint size;\nint iter_max_num;\n\n// Return the absolute value of a number.\ndouble absolute(double num){\n    if(num < 0)\n        return -1.0 * num;\n    return num;\n}\n\n// Allocate contiguous memory for both grids.\nvoid allocate_memory(){\n    size_t cells = (size_t)size * (size_t)size;\n    grid = (double *) malloc(cells * sizeof(double));\n    new_grid = (double *) malloc(cells * sizeof(double));\n}\n\n// Initialize both buffers identically so their fixed boundaries remain valid after swaps.\nvoid initialize_grid(){\n    int center = size / 2;\n    int linf = center - (size / 10);\n    int lsup = center + (size / 10);\n    for (int i = 0; i < size; i++){\n        size_t row = (size_t)i * (size_t)size;\n        for (int j = 0; j < size; j++){\n            size_t index = row + (size_t)j;\n            // inicializa região de calor no centro do grid\n            double initial_value;\n            if (i >= linf && i <= lsup && j >= linf && j <= lsup)\n                initial_value = 100;\n            else\n                initial_value = 0;\n            grid[index] = initial_value;\n            new_grid[index] = initial_value;\n        }\n    }\n}\n\n// Save the grid in a file.\nvoid save_grid(){\n    for(int i = 0; i < size; i++){\n        size_t index = (size_t)i * (size_t)size;\n        for(int j = 0; j < size; j++){\n            fprintf(stdout, \"%lf \", grid[index++]);\n        }\n        fprintf(stdout, \"\\n\");\n    }\n}\n\nint main(int argc, char *argv[]){\n    fscanf(stdin, \"%d\", &size);\n    fscanf(stdin, \"%d\", &iter_max_num);\n\n    int hasError = 1;\n    int iter = 0;\n    int keepGoing = 1;\n    int hasComputedIteration = 0;\n\n    struct timeval time_start;\n    struct timeval time_end;\n\n    // Allocate memory to the grid (matrix).\n    allocate_memory();\n\n    // Set grid initial conditions.\n    initialize_grid();\n\n    // Jacobi iteration using one OpenMP team for the complete solve.\n    // Swap the completed buffer before checking the next iteration condition.\n    #pragma omp parallel if(size >= 64 && iter_max_num > 0) default(none) shared(grid, new_grid, size, iter_max_num, hasError, iter, keepGoing, hasComputedIteration)\n    {\n        while (1) {\n            #pragma omp single\n            {\n                if (hasComputedIteration) {\n                    double *temp_grid = grid;\n                    grid = new_grid;\n                    new_grid = temp_grid;\n                    ++iter;\n                    hasComputedIteration = 0;\n                }\n\n                keepGoing = hasError && iter < iter_max_num;\n                if (keepGoing) {\n                    hasError = 0;\n                    hasComputedIteration = 1;\n                }\n            }\n            if (!keepGoing)\n                break;\n\n            const double * restrict current_grid = grid;\n            double * restrict next_grid = new_grid;\n\n            // Calculate the next grid and combine the convergence flag.\n            #pragma omp for schedule(static) reduction(|:hasError)\n            for (int i = 1; i < size - 1; i++) {\n                size_t row = (size_t)i * (size_t)size;\n                size_t north = row - (size_t)size;\n                size_t south = row + (size_t)size;\n                int row_has_error = 0;\n\n                #pragma omp simd reduction(|:row_has_error)\n                for (int j = 1; j < size - 1; j++) {\n                    size_t index = row + (size_t)j;\n                    next_grid[index] = 0.25 * (current_grid[index + 1] + current_grid[index - 1] +\n                                                current_grid[north + (size_t)j] + current_grid[south + (size_t)j]);\n\n                    double errorCurrent = absolute(next_grid[index] - current_grid[index]);\n                    if (errorCurrent > CONV_THRESHOLD) {\n                        row_has_error = 1;\n                    }\n                }\n                hasError |= row_has_error;\n            }\n        }\n    }\n\n    // Save the final grid.\n    save_grid();\n\n    return 0;\n}\n"
}

{
  "src/bucketsort.c": "#include <errno.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n#define INPUT_BUFFER_SIZE 65536\n#define RADIX_BUCKETS 257\n#define INSERTION_THRESHOLD 16\n\ntypedef struct {\n    size_t begin;\n    size_t end;\n    size_t depth;\n} SortRange;\n\nstatic unsigned char input_buffer[INPUT_BUFFER_SIZE];\nstatic size_t input_position;\nstatic size_t input_length;\n\nstatic int next_byte(void)\n{\n    if (input_position == input_length) {\n        input_length = fread(input_buffer, 1, sizeof(input_buffer), stdin);\n        input_position = 0;\n        if (input_length == 0)\n            return EOF;\n    }\n    return input_buffer[input_position++];\n}\n\nstatic int read_token(char **word, size_t *capacity, size_t *length)\n{\n    int c;\n    do {\n        c = next_byte();\n    } while (c != EOF && c <= ' ');\n\n    if (c == EOF)\n        return 0;\n\n    size_t used = 0;\n    do {\n        if (used > SIZE_MAX - 2)\n            return -1;\n        size_t needed = used + 2;\n        if (needed > *capacity) {\n            size_t new_capacity = *capacity ? *capacity : 64;\n            while (new_capacity < needed) {\n                if (new_capacity > SIZE_MAX / 2) {\n                    new_capacity = needed;\n                    break;\n                }\n                new_capacity *= 2;\n            }\n            char *new_word = realloc(*word, new_capacity);\n            if (new_word == NULL)\n                return -1;\n            *word = new_word;\n            *capacity = new_capacity;\n        }\n        (*word)[used++] = (char)c;\n        c = next_byte();\n    } while (c != EOF && c > ' ');\n\n    (*word)[used] = '\\0';\n    *length = used;\n    return 1;\n}\n\nstatic int read_integer(long long *value, char **word, size_t *capacity)\n{\n    size_t length;\n    if (read_token(word, capacity, &length) != 1)\n        return 0;\n    (void)length;\n\n    errno = 0;\n    char *end;\n    long long parsed = strtoll(*word, &end, 10);\n    if (errno == ERANGE || end == *word || *end != '\\0')\n        return 0;\n    *value = parsed;\n    return 1;\n}\n\nstatic void insertion_sort_range(size_t *order, const char *records,\n                                 size_t record_width, size_t begin,\n                                 size_t end, size_t depth)\n{\n    for (size_t i = begin + 1; i < end; ++i) {\n        size_t value = order[i];\n        const char *value_text = records + value * record_width + depth;\n        size_t position = i;\n        while (position > begin &&\n               strcmp(records + order[position - 1] * record_width + depth,\n                      value_text) > 0) {\n            order[position] = order[position - 1];\n            --position;\n        }\n        order[position] = value;\n    }\n}\n\nstatic int radix_sort_indices(size_t *order, size_t *scratch,\n                              const char *records, size_t record_width,\n                              size_t count)\n{\n    if (count < 2)\n        return 1;\n    if (count > SIZE_MAX / sizeof(SortRange))\n        return 0;\n\n    SortRange *stack = malloc(count * sizeof(*stack));\n    if (stack == NULL)\n        return 0;\n\n    size_t stack_size = 1;\n    stack[0].begin = 0;\n    stack[0].end = count;\n    stack[0].depth = 0;\n\n    while (stack_size != 0) {\n        SortRange range = stack[--stack_size];\n        size_t range_count = range.end - range.begin;\n        if (range_count < 2)\n            continue;\n\n        if (range_count <= INSERTION_THRESHOLD) {\n            insertion_sort_range(order, records, record_width,\n                                 range.begin, range.end, range.depth);\n            continue;\n        }\n\n        size_t counts[RADIX_BUCKETS] = {0};\n        size_t boundaries[RADIX_BUCKETS + 1];\n        size_t next[RADIX_BUCKETS];\n\n        for (size_t i = range.begin; i < range.end; ++i) {\n            size_t index = order[i];\n            size_t key = range.depth < strlen(records + index * record_width)\n                ? (size_t)(unsigned char)records[index * record_width + range.depth] + 1\n                : 0;\n            ++counts[key];\n        }\n\n        boundaries[0] = range.begin;\n        for (size_t key = 0; key < RADIX_BUCKETS; ++key) {\n            boundaries[key + 1] = boundaries[key] + counts[key];\n            next[key] = boundaries[key];\n        }\n\n        for (size_t i = range.begin; i < range.end; ++i) {\n            size_t index = order[i];\n            size_t key = range.depth < strlen(records + index * record_width)\n                ? (size_t)(unsigned char)records[index * record_width + range.depth] + 1\n                : 0;\n            scratch[next[key]++] = index;\n        }\n\n        memcpy(order + range.begin, scratch + range.begin,\n               range_count * sizeof(*order));\n\n        for (size_t key = RADIX_BUCKETS; key-- > 1;) {\n            if (counts[key] > 1) {\n                if (stack_size == count) {\n                    free(stack);\n                    return 0;\n                }\n                stack[stack_size].begin = boundaries[key];\n                stack[stack_size].end = boundaries[key + 1];\n                stack[stack_size].depth = range.depth + 1;\n                ++stack_size;\n            }\n        }\n    }\n\n    free(stack);\n    return 1;\n}\n\nint main(void)\n{\n    char *word = NULL;\n    size_t word_capacity = 0;\n    size_t word_length = 0;\n    char *records = NULL;\n    size_t *lengths = NULL;\n    size_t *order = NULL;\n    size_t *scratch = NULL;\n    int result = 1;\n\n    long long declared_length_value;\n    long long count_value;\n    long long offset;\n    long long bucket_count;\n    if (!read_integer(&declared_length_value, &word, &word_capacity) ||\n        !read_integer(&count_value, &word, &word_capacity) ||\n        !read_integer(&offset, &word, &word_capacity) ||\n        !read_integer(&bucket_count, &word, &word_capacity) ||\n        declared_length_value < 0 || count_value < 0 ||\n        (uintmax_t)declared_length_value > (uintmax_t)(SIZE_MAX - 1) ||\n        (uintmax_t)count_value > (uintmax_t)SIZE_MAX) {\n        goto done;\n    }\n    (void)offset;\n    (void)bucket_count;\n\n    size_t count = (size_t)count_value;\n    if (count == 0) {\n        putchar('\\n');\n        result = 0;\n        goto done;\n    }\n\n    if (count > SIZE_MAX / sizeof(*lengths) ||\n        count > SIZE_MAX / sizeof(*order))\n        goto done;\n\n    lengths = malloc(count * sizeof(*lengths));\n    order = malloc(count * sizeof(*order));\n    scratch = malloc(count * sizeof(*scratch));\n    if (lengths == NULL || order == NULL || scratch == NULL)\n        goto done;\n\n    size_t record_width = (size_t)declared_length_value + 1;\n    if (record_width > SIZE_MAX / count)\n        goto done;\n    records = calloc(count, record_width);\n    if (records == NULL)\n        goto done;\n\n    for (size_t i = 0; i < count; ++i) {\n        if (read_token(&word, &word_capacity, &word_length) != 1)\n            goto done;\n\n        if (word_length == SIZE_MAX)\n            goto done;\n        if (word_length + 1 > record_width) {\n            size_t new_width = word_length + 1;\n            if (new_width > SIZE_MAX / count)\n                goto done;\n            char *new_records = calloc(count, new_width);\n            if (new_records == NULL)\n                goto done;\n            for (size_t j = 0; j < i; ++j)\n                memcpy(new_records + j * new_width,\n                       records + j * record_width, lengths[j]);\n            free(records);\n            records = new_records;\n            record_width = new_width;\n        }\n\n        memcpy(records + i * record_width, word, word_length + 1);\n        lengths[i] = word_length;\n        order[i] = i;\n    }\n\n    if (!radix_sort_indices(order, scratch, records, record_width, count))\n        goto done;\n\n    for (size_t i = 0; i < count; ++i) {\n        if (i != 0)\n            putchar(' ');\n        fputs(records + order[i] * record_width, stdout);\n    }\n    putchar('\\n');\n    result = 0;\n\ndone:\n    free(scratch);\n    free(order);\n    free(lengths);\n    free(records);\n    free(word);\n    return result;\n}\n"
}

"""Only new state-field counterexamples; no actual state, operational main, or old test replay."""
import ast
import hashlib
import json
import math
import os
import re
import stat
import time
from datetime import UTC, datetime
from pathlib import Path

here=Path(__file__).resolve().parent
old=here.parent/'garder-fermeture-observateur.py'
new=here/'garder-fermeture-observateur-r2.py'
old_bytes=old.read_bytes();new_bytes=new.read_bytes()
assert hashlib.sha256(old_bytes).hexdigest()=='210e111366ec6e813785b622a404e45d1018a93c4399e87701b1fe89fb81fa06'
old_defs={n.name:n for n in ast.parse(old_bytes).body if isinstance(n,ast.FunctionDef)}
new_defs={n.name:n for n in ast.parse(new_bytes).body if isinstance(n,ast.FunctionDef)}
inherited={'need','identity','creation','cim_birth_ticks','graph_state'}
assert all(ast.dump(old_defs[n],include_attributes=False)==ast.dump(new_defs[n],include_attributes=False) for n in inherited)
ns={}
exec(compile(ast.Module(body=[new_defs[n] for n in ['need','validate_passive_state']],type_ignores=[]),str(new),'exec'),ns)
good={'schema':'hpc-forest-r4b-passive-state-v1','passive_only':True,'active_native_workers':0,'scientific_admission':False}
cases=[('exact_frozen_producer_fields',good,True),
       ('old_science_alias_not_a_substitute',{'schema':good['schema'],'passive_only':True,'active_native_workers':0,'science_admitted':False},False),
       ('wrong_state_schema',{**good,'schema':'other'},False),
       ('scientific_admission_true',{**good,'scientific_admission':True},False),
       ('extra_old_alias_refused',{**good,'science_admitted':False},False)]
results=[]
for name,value,allowed in cases:
    try:ns['validate_passive_state'](value)
    except ValueError:
        assert not allowed,name
    else:assert allowed,name
    results.append({'name':name,'passed':True})
prep=here.parents[2]
capacity=prep/'operations-parent-premier-roots-source110-r1/capacite-preracines-r1/verifier-capacite-preracines.py'
chain=prep/'adaptateurs-source110-r1/revision-r5-G-recu-avant-Q'
allowed_source={capacity,chain/'observer/observer-mixte.py',chain/'launcher/native_worker_detection.py'}
def cold_source_bytes(path):
    assert Path(path) in allowed_source
    return Path(path).read_bytes()
sessions=('3b1de5658e4641149b15a3bea4850239','7b6c29c0e329400bb2be145b0e2dbe0a','bd2b3153a7544c909afbc19fe69902b4')
capacity_globals={'Path':Path,'raw':cold_source_bytes,'CAPACITY':capacity,
                  'CAPACITY_SHA':'581403d134951fbde8c7b815c9d2c6d3281b09c3c847dc62386d7ea62be8d107',
                  'CHAIN':chain,'PREP':prep,'SESSIONS':sessions,'FIELDS':('ProcessId','ParentProcessId','ExecutablePath','CommandLine','CreationDate'),
                  'ast':ast,'hashlib':hashlib,'os':os,'stat':stat,'time':time,'re':re,'math':math,'datetime':datetime,'UTC':UTC}
exec(compile(ast.Module(body=[new_defs[n] for n in ['need','digest','pure_capacity']],type_ignores=[]),str(new),'exec'),capacity_globals)
api,_=capacity_globals['pure_capacity']()
assert api['LOCAL_CACHES']==[prep/('lancement-modeles-max-r3/worker-'+s) for s in sessions] and callable(api['metadata'])
fixture=here/'fixtures-absence-inertes-r2';fixture.mkdir()
paths=[fixture/('missing-'+str(i)) for i in range(3)]
api['LOCAL_CACHES']=paths  # Only this test-returned namespace; production helper is never loaded or mutated.
for i,path in enumerate(paths):
    value=api['ordinary_absence'](path)
    assert value=={'path':str(path),'exists':False,'observation':'ordinary_ancestor_lstat_only'}
    results.append({'name':'actual_ordinary_absence_fixture_'+str(i),'passed':True})
try:api['ordinary_absence'](fixture/'unbound')
except ValueError:pass
else:raise AssertionError('Unbound fixture accepted')
results.append({'name':'unbound_fixture_path_refused','passed':True})
paths[0].mkdir()
try:api['ordinary_absence'](paths[0])
except ValueError:pass
else:raise AssertionError('Existing fixture accepted as absence')
results.append({'name':'existing_fixture_directory_refused','passed':True})
delegations=[]
raw_globals={'Path':Path,'PREP':prep,'_raw':lambda p:delegations.append(p) or b'inert'}
exec(compile(ast.Module(body=[new_defs[n] for n in ['need','lock_name','raw']],type_ignores=[]),str(new),'exec'),raw_globals)
for name in ['observer.lock','OBSERVER.LOCK','Observer.Lock.','observer.lock ','WORKER.LOCK','Worker.Lock. ','worker.lock']:
    try:raw_globals['raw'](here/name)
    except ValueError:pass
    else:raise AssertionError('Lock alias delegated to read: '+name)
    assert not delegations
    results.append({'name':'lock_alias_refused_before_read_'+name,'passed':True})
producer=here.parents[2]/'adaptateurs-source110-r1/revision-r5-G-recu-avant-Q/observer/observer-mixte.py'
# Source-only AST/read evidence. Never import/evaluate the frozen observer module.
producer_bytes=producer.read_bytes()
assert hashlib.sha256(producer_bytes).hexdigest()=='db24bef9282b510642dbc23d527c32f1a5515df9791d255f920d7e326db32180'
assert '"scientific_admission": False' in producer_bytes.decode('utf-8')
report={'schema':'hpc-forest-obs4-main-only-r2-new-state-guards-v1','verified_new_inert_guards_only':True,
        'helper_sha256':hashlib.sha256(new_bytes).hexdigest(),'passed':len(results),'cases':results,
        'old_18_guard_functions_AST_identical':True,'old_18_tests_replayed':False,
        'actual_ordinary_absence_called_only_on_new_owned_fixture_paths':True,
        'lock_aliases_refused_before_any_read_delegation':True,
        'frozen_state_producer':{'path':str(producer),'sha256':hashlib.sha256(producer_bytes).hexdigest()},
        'actual_state_or_CIM_or_cache_or_main_or_model_or_process_effect':False}
out=here/'TESTS-NOUVEAUX-GARDES-ETAT-R2.json'
with out.open('x',encoding='utf-8',newline='\n') as stream:json.dump(report,stream,ensure_ascii=False,indent=2);stream.write('\n')
print(json.dumps({'path':str(out),'sha256':hashlib.sha256(out.read_bytes()).hexdigest(),'passed':len(results)}))

#include <algorithm>
#include <cassert>
#include <cstddef>
#include <cstdio>
#include <iostream>
#include <memory>
#include <vector>

int main() {
    int n, s;
    std::cin >> n >> s;

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    // Only rows that will eventually leave the vertical window need storage.
    const int buffered_rows = std::min(s, n - s);
    std::unique_ptr<int[]> rows(
        new int[static_cast<std::size_t>(buffered_rows) * n]);
    std::vector<long long> columns(n, 0);

    for (int r = 0; r < s; ++r) {
        int* saved = r < buffered_rows
            ? rows.get() + static_cast<std::size_t>(r) * n
            : nullptr;
        for (int c = 0; c < n; ++c) {
            int value;
            scanf("%d", &value);
            columns[c] += static_cast<long long>(value);
            if (saved != nullptr) {
                saved[c] = value;
            }
        }
    }

    long long sum = 0;
    for (int c = 0; c < s; ++c) {
        sum += columns[c];
    }
    long long maximum = sum;
    for (int c = s; c < n; ++c) {
        sum += columns[c] - columns[c - s];
        maximum = std::max(maximum, sum);
    }

    int slot = 0;
    for (int r = s; r < n; ++r) {
        int* oldest = rows.get() + static_cast<std::size_t>(slot) * n;
        const bool retain = r < n - s;
        sum = 0;

        for (int c = 0; c < s; ++c) {
            int value;
            scanf("%d", &value);
            columns[c] += static_cast<long long>(value) - oldest[c];
            if (retain) {
                oldest[c] = value;
            }
            sum += columns[c];
        }
        maximum = std::max(maximum, sum);

        // Columns to the left have already been updated for this strip.
        for (int c = s; c < n; ++c) {
            int value;
            scanf("%d", &value);
            columns[c] += static_cast<long long>(value) - oldest[c];
            if (retain) {
                oldest[c] = value;
            }
            sum += columns[c] - columns[c - s];
            maximum = std::max(maximum, sum);
        }

        if (++slot == buffered_rows) {
            slot = 0;
        }
    }

    printf("%lld\n", maximum);
    return 0;
}

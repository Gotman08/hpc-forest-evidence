{
  "src/solution.cpp": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconstexpr int MOD = 1000000007;\n\nint main() {\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    // Store only blocked columns; a dense n-by-n bitmap is unnecessary.\n    vector<vector<int>> blockedColumns(n);\n    for (int c = 0; c < m; ++c) {\n        int row, column;\n        cin >> row >> column;\n        blockedColumns[row].push_back(column);\n    }\n    for (auto& columns : blockedColumns) {\n        sort(columns.begin(), columns.end());\n    }\n\n    vector<int> previous(n, 0);\n    vector<int> current(n, 0);\n    previous[0] = 1;\n\n#ifdef _OPENMP\n    constexpr int PARALLEL_THRESHOLD = 4096;\n    constexpr int CHUNK_SIZE = 256;\n\n    if (n >= PARALLEL_THRESHOLD) {\n        const int chunkCount = (n + CHUNK_SIZE - 1) / CHUNK_SIZE;\n        vector<int> transferValue(chunkCount, 0);\n        vector<unsigned char> transferHasReset(chunkCount, 0);\n        vector<int> carryIn(chunkCount, 0);\n\n        // Each chunk's row transformation is either carry + value (no\n        // obstacle) or a value independent of the incoming carry (obstacle).\n        // A serial prefix over these compact summaries sets chunk carries;\n        // the two column passes themselves are work-shared.\n#pragma omp parallel shared(previous, current, blockedColumns, transferValue, transferHasReset, carryIn)\n        {\n            for (int row = 0; row < n; ++row) {\n#pragma omp for schedule(static)\n                for (int chunk = 0; chunk < chunkCount; ++chunk) {\n                    const int begin = chunk * CHUNK_SIZE;\n                    const int end = min(n, begin + CHUNK_SIZE);\n                    const auto& obstacles = blockedColumns[row];\n                    size_t obstacle = lower_bound(obstacles.begin(), obstacles.end(), begin) - obstacles.begin();\n                    int value = 0;\n                    bool hasReset = false;\n\n                    for (int column = begin; column < end; ++column) {\n                        if (obstacle < obstacles.size() && obstacles[obstacle] == column) {\n                            do {\n                                ++obstacle;\n                            } while (obstacle < obstacles.size() && obstacles[obstacle] == column);\n                            value = 0;\n                            hasReset = true;\n                        } else {\n                            value += previous[column];\n                            if (value >= MOD) value -= MOD;\n                        }\n                    }\n                    transferValue[chunk] = value;\n                    transferHasReset[chunk] = static_cast<unsigned char>(hasReset);\n                }\n\n#pragma omp single\n                {\n                    int carry = 0;\n                    for (int chunk = 0; chunk < chunkCount; ++chunk) {\n                        carryIn[chunk] = carry;\n                        if (transferHasReset[chunk]) {\n                            carry = transferValue[chunk];\n                        } else {\n                            carry += transferValue[chunk];\n                            if (carry >= MOD) carry -= MOD;\n                        }\n                    }\n                }\n\n#pragma omp for schedule(static)\n                for (int chunk = 0; chunk < chunkCount; ++chunk) {\n                    const int begin = chunk * CHUNK_SIZE;\n                    const int end = min(n, begin + CHUNK_SIZE);\n                    const auto& obstacles = blockedColumns[row];\n                    size_t obstacle = lower_bound(obstacles.begin(), obstacles.end(), begin) - obstacles.begin();\n                    int carry = carryIn[chunk];\n\n                    for (int column = begin; column < end; ++column) {\n                        if (obstacle < obstacles.size() && obstacles[obstacle] == column) {\n                            do {\n                                ++obstacle;\n                            } while (obstacle < obstacles.size() && obstacles[obstacle] == column);\n                            carry = 0;\n                            current[column] = 0;\n                        } else {\n                            carry += previous[column];\n                            if (carry >= MOD) carry -= MOD;\n                            current[column] = carry;\n                        }\n                    }\n                }\n\n#pragma omp single\n                {\n                    previous.swap(current);\n                }\n            }\n        }\n    } else\n#endif\n    {\n        for (int row = 0; row < n; ++row) {\n            const auto& obstacles = blockedColumns[row];\n            size_t obstacle = 0;\n            int carry = 0;\n\n            for (int column = 0; column < n; ++column) {\n                if (obstacle < obstacles.size() && obstacles[obstacle] == column) {\n                    do {\n                        ++obstacle;\n                    } while (obstacle < obstacles.size() && obstacles[obstacle] == column);\n                    carry = 0;\n                    current[column] = 0;\n                } else {\n                    carry += previous[column];\n                    if (carry >= MOD) carry -= MOD;\n                    current[column] = carry;\n                }\n            }\n            previous.swap(current);\n        }\n    }\n\n    cout << previous[n - 1] << '\\n';\n    return 0;\n}\n"
}

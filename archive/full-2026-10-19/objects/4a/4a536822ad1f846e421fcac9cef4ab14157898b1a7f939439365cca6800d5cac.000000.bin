{
  "text": "\"\"\"Independent editorial accounting for the two closed Terra receipts.\n\nUnknown consumption stays null. A missing local invocation is never a proof of\nzero consumption. This module only reads bound evidence and immutable SQLite.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport re\nimport sqlite3\nfrom pathlib import Path\n\n\ndef verified_receipt(receipt):\n    if \"verified\" in receipt:\n        return receipt[\"verified\"] is True\n    return all(receipt.get(key) is True for key in (\n        \"coverage_and_final_confirmations_verified\", \"all_outcomes_accounted_for\",\n        \"read_only_file_verification_before_and_after\", \"deliveries_reconciled\"))\n\n\ndef usage_from_journal(text):\n    usages = []\n    for line in text.splitlines():\n        try:\n            event = json.loads(line)\n        except ValueError:\n            continue\n        if event.get(\"type\") in {\"item.started\", \"item.completed\", \"item.updated\"}:\n            assert event.get(\"item\", {}).get(\"type\") in {None, \"reasoning\", \"agent_message\", \"error\"}\n        if event.get(\"type\") == \"turn.completed\" and isinstance(event.get(\"usage\"), dict):\n            usage = event[\"usage\"]\n            assert all(type(usage.get(k)) is int and usage[k] >= 0\n                       for k in (\"input_tokens\", \"output_tokens\"))\n            usages.append(usage)\n    return bool(usages), sum(u[\"input_tokens\"] + u[\"output_tokens\"] for u in usages)\n\n\ndef call_state(item):\n    \"\"\"Keep proof of an expired non-call separate from missing evidence.\"\"\"\n    native = item[\"native_invocation_observed\"]\n    measured = item[\"usage_measured\"]\n    exact = item[\"known_exact_tokens\"]\n    assert type(native) is bool and type(measured) is bool\n    if measured:\n        assert type(exact) is int and exact >= 0\n        if not native:\n            assert item.get(\"not_called_before_expiry\") is True and exact == 0\n            return \"expired_before_invocation\"\n        return \"exact\"\n    assert exact is None, \"Unknown consumption must remain null\"\n    if item[\"status\"] == \"interrupted_claim_unknown\":\n        return \"interrupted_claim_unknown\"\n    if not native:\n        assert item[\"status\"] == \"expired_unanswered_no_local_invocation_evidence\"\n        assert item.get(\"invocation_absence_proven\") is False\n        return item[\"status\"]\n    return \"unmetered\"\n\n\ndef summarize_calls(calls):\n    keys = [(c[\"session_id\"], c[\"nonce\"]) for c in calls]\n    assert len(keys) == len(set(keys)), \"Duplicate session/nonce\"\n    return {\n        \"published_requests\": len(calls),\n        \"verified_deliveries\": sum(c[\"delivery_verified\"] for c in calls),\n        \"native_invocations_observed\": sum(c[\"native_invocation_observed\"] for c in calls),\n        \"known_exact_tokens\": sum(c[\"exact_total\"] for c in calls if c[\"usage_measured\"]),\n        \"unmeasured_native_invocations\": sum(c[\"native_invocation_observed\"] and not c[\"usage_measured\"] for c in calls),\n        \"requests_with_unknown_consumption\": sum(not c[\"usage_measured\"] for c in calls),\n        \"expired_before_invocation_proven\": sum(c[\"state\"] == \"expired_before_invocation\" for c in calls),\n        \"interrupted_claims_unknown\": sum(c[\"state\"] == \"interrupted_claim_unknown\" for c in calls),\n        \"expired_unanswered_without_local_invocation_evidence\": sum(c[\"state\"] == \"expired_unanswered_no_local_invocation_evidence\" for c in calls),\n    }\n\n\ndef closed_terra_accounting(cohort, admissions, descriptor, *, read, record, save, sha):\n    folder = Path(descriptor[\"receipt_folder\"])\n    worker = Path(descriptor[\"worker\"])\n    receipt_path = record(folder / \"reception-verifiee.json\")\n    receipt = read(receipt_path)\n    admitted = next(c for c in admissions[\"reviewed_new_cohorts\"] if c[\"cohort\"] == descriptor[\"cohort\"])\n    assert sha(receipt_path) == admitted[\"independent_reception_sha256\"]\n    assert verified_receipt(receipt) and str(receipt[\"job_id\"]) == descriptor[\"job_id\"]\n    for value in receipt.values():\n        if isinstance(value, dict) and set(value) >= {\"path\", \"sha256\"}:\n            assert sha(record(value[\"path\"])) == value[\"sha256\"]\n    reconciliation = read(folder / \"reconciliation-livraisons.json\")\n    assert reconciliation[\"all_published_requests_accounted_for\"]\n    assert not reconciliation[\"all_published_requests_delivered\"]\n    assert not reconciliation[\"total_exact_consumption_available\"]\n    roots = {r[\"subject\"]: Path(r[\"campaign_root\"]) for r in cohort[\"rows\"]}\n    roles = {}\n    for subject, root in roots.items():\n        db = record(root / \"registry.sqlite3\")\n        with sqlite3.connect(db.as_uri() + \"?mode=ro&immutable=1\", uri=True) as con:\n            roles[subject] = dict(con.execute(\"SELECT id,role FROM trials\"))\n    calls = []\n    for item in reconciliation[\"records\"]:\n        nonce = item[\"nonce\"]\n        assert re.fullmatch(r\"[0-9a-f]{32}\", nonce)\n        references = [Path(p) for p in item[\"request_references\"]]\n        assert references and all(not p.is_absolute() and \"..\" not in p.parts for p in references)\n        subject = references[0].parts[0]\n        assert subject in roots and all(p.parts[0] == subject for p in references)\n        requests = [read(roots[subject].parent / p) for p in references]\n        request = requests[0]\n        assert all(value == request for value in requests)\n        flat = roots[subject].parent / \"mailbox/requests\" / (nonce + \".request.json\")\n        assert read(flat) == request and sha(flat) == item[\"request_sha256\"]\n        assert (request[\"session_id\"], request[\"nonce\"]) == (descriptor[\"session_id\"], nonce)\n        assert request[\"model\"] == \"gpt-5.6-terra\" and request[\"reasoning_effort\"] == descriptor[\"effort\"]\n        if request.get(\"meta_role\"):\n            assert request[\"meta_role\"] in {\"mother-preparation\", \"mother-synthesis\"}\n            role = \"mère\"\n        else:\n            tree_role = roles[subject][request[\"mission_id\"].rsplit(\"-h\", 1)[0]]\n            assert tree_role in {\"A\", \"B\", \"C\", \"G\"}\n            role = \"intégration\" if tree_role == \"G\" else \"enfant\"\n        state = call_state(item)\n        if item[\"native_invocation_observed\"]:\n            local = worker / nonce\n            invocation = read(local / \"invocation.json\")\n            assert invocation[\"request_sha256\"] == item[\"request_sha256\"]\n            argv = invocation[\"argv\"]\n            assert argv.count(\"--model\") == 1 and argv[argv.index(\"--model\") + 1] == \"gpt-5.6-terra\"\n            assert 'model_reasoning_effort=' + json.dumps(descriptor[\"effort\"]) in argv\n            events = record(local / \"codex.jsonl\")\n            measured, exact = usage_from_journal(events.read_text(encoding=\"utf8\", errors=\"replace\"))\n            assert measured == item[\"usage_measured\"]\n            assert (exact == item[\"known_exact_tokens\"]) if measured else item[\"known_exact_tokens\"] is None\n            trace = item.get(\"native_trace\", {})\n            if trace:\n                assert sha(local / \"invocation.json\") == trace[\"invocation_sha256\"]\n                assert sha(events) == trace[\"journal_sha256\"]\n        elif item[\"usage_measured\"]:\n            assert item[\"delivery_verified\"] and item.get(\"invocation_absence_proven\") is True\n        calls.append({\n            \"session_id\": descriptor[\"session_id\"], \"nonce\": nonce, \"subject\": subject,\n            \"campaign\": descriptor[\"campaign\"], \"kind\": role,\n            \"native_invocation_observed\": item[\"native_invocation_observed\"],\n            \"usage_measured\": item[\"usage_measured\"], \"exact_total\": item[\"known_exact_tokens\"],\n            \"delivery_verified\": item[\"delivery_verified\"], \"state\": state,\n            \"status\": item[\"status\"], \"request_sha256\": item[\"request_sha256\"],\n        })\n    summary = summarize_calls(calls)\n    for key, value in summary.items():\n        if key in reconciliation:\n            assert value == reconciliation[key], key\n    for key, rec_key in ((\"native_calls\", \"native_invocations_observed\"),\n                         (\"known_exact_tokens\", \"known_exact_tokens\"),\n                         (\"unmetered_calls\", \"unmeasured_native_invocations\"),\n                         (\"published_requests\", \"published_requests\")):\n        assert cohort[key] == summary[rec_key], key\n    assert summary[\"requests_with_unknown_consumption\"] == admitted[\"requests_with_unknown_consumption\"]\n    totals = {}\n    for subject in roots:\n        current = summarize_calls([c for c in calls if c[\"subject\"] == subject])\n        totals[subject] = {\n            \"native_calls\": current[\"native_invocations_observed\"],\n            \"known_exact_tokens\": current[\"known_exact_tokens\"],\n            \"unmetered_calls\": current[\"unmeasured_native_invocations\"],\n            \"unknown_consumption_requests\": current[\"requests_with_unknown_consumption\"],\n            \"verified_deliveries\": current[\"verified_deliveries\"],\n            \"expired_before_invocation\": current[\"expired_before_invocation_proven\"],\n            \"interrupted_claims_unknown\": current[\"interrupted_claims_unknown\"],\n            \"expired_unanswered_no_local_invocation_evidence\": current[\"expired_unanswered_without_local_invocation_evidence\"],\n        }\n    save(descriptor[\"cost_file\"], {\n        \"job_id\": descriptor[\"job_id\"], \"receipt_sha256\": sha(receipt_path),\n        \"reconciliation_sha256\": sha(folder / \"reconciliation-livraisons.json\"),\n        \"per_subject\": totals, \"native_calls\": calls, \"request_summary\": summary,\n        \"total_exact_consumption_available\": False,\n        \"original_cli\": \"codex-cli 0.162.0-alpha.17.2\", \"subsequent_cli_used_in_this_cohort\": False,\n    })\n    return totals\n"
}

        "content": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <iterator>\n#include <string>\n\nclass PermutationOutput\n{\npublic:\n    PermutationOutput () : used_ (0) {}\n\n    ~PermutationOutput ()\n    {\n        flush () ;\n    }\n\n    PermutationOutput (PermutationOutput const&) = delete ;\n    PermutationOutput& operator= (PermutationOutput const&) = delete ;\n\n    template <typename Iter> auto\n    append (Iter first, Iter last) -> void\n    {\n        const std::size_t length =\n            static_cast <std::size_t> (std::distance (first, last)) ;\n\n        // Check the bound before computing the formatted row size.\n        if (length <= (capacity - 4) / 2) {\n            const std::size_t row_size = 2 * length + 4 ;\n            if (row_size > capacity - used_) flush () ;\n\n            char* destination = buffer_ + used_ ;\n            *destination++ = '[' ;\n            *destination++ = ' ' ;\n            while (first != last) {\n                *destination++ = *first ;\n                *destination++ = ' ' ;\n                ++ first ;\n            }\n            *destination++ = ']' ;\n            *destination = '\\n' ;\n            used_ += row_size ;\n            return ;\n        }\n\n        // Oversized rows use the same bounded buffer without truncation.\n        append_pair ('[', ' ') ;\n        while (first != last) {\n            append_pair (*first, ' ') ;\n            ++ first ;\n        }\n        append_pair (']', '\\n') ;\n    }\n\nprivate:\n    static const std::size_t capacity = 64 * 1024 ;\n    char buffer_ [capacity] ;\n    std::size_t used_ ;\n\n    auto flush () -> void\n    {\n        if (used_ != 0) {\n            std::cout.write\n                (buffer_, static_cast <std::streamsize> (used_)) ;\n            used_ = 0 ;\n        }\n    }\n\n    auto append_pair (char first, char second) -> void\n    {\n        if (capacity - used_ < 2) flush () ;\n        buffer_ [used_++] = first ;\n        buffer_ [used_++] = second ;\n    }\n} ;\n\nstruct PrintPermutation\n{\n    explicit PrintPermutation (PermutationOutput& output)\n        : output_ (output) {}\n\n    template <typename Iter> auto\n    operator () (Iter first, Iter last) const -> void\n    {\n        output_.append (first, last) ;\n    }\n\nprivate:\n    PermutationOutput& output_ ;\n} ;\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ' )\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v') ;\n    }\n} ;\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase\n        ( std::remove_if\n            ( text.begin ()\n            , text.end ()\n            , IsWhitespace () )\n        , text.end () ) ;\n    return text ;\n}\n\ntemplate <typename Iter> auto\nfind_longest_non_increasing_suffix (Iter first, Iter last) -> Iter\n{\n    if (first == last) return last ;\n    Iter back = std::prev (last) ;\n    if (back == first) return last ;\n    do {\n        -- last ;\n        -- back ;\n        if (*back < *last) return last ;\n    } while (back != first) ;\n    return first ;\n}\n\ntemplate <typename Iter> auto\nfind_rightmost_successor (Iter first, Iter second, Iter last) -> Iter\n{\n    if (second == last) return last ;\n    do {\n        -- last ;\n    } while ((second != last) && (*last <= *first)) ;\n    return last ;\n}\n\ntemplate <typename Iter> auto\nnext_permutation (Iter first, Iter last) -> bool\n{\n    if (first == last) return false ;\n    Iter suffix = find_longest_non_increasing_suffix (first, last) ;\n    if (suffix == first) return false ;\n    if (suffix == last)  return false ;\n    Iter pivot = std::prev (suffix) ;\n    Iter successor = find_rightmost_successor (pivot, suffix, last) ;\n    std::iter_swap (pivot, successor) ;\n    std::reverse (suffix, last) ;\n    return true ;\n}\n\ntemplate <typename Iter, typename Function> inline auto\npermutations_iter (Iter first, Iter last, Function driver) -> void\n{\n    if (first == last) return ;\n    std::sort (first, last) ;\n    do {\n        driver (first, last) ;\n    } while (::next_permutation (first, last)) ;\n    return ;\n}\n\ntemplate <typename String, typename Function> inline auto\npermutations (String text, Function driver) -> void\n{\n    permutations_iter (std::begin (text), std::end (text), driver) ;\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator <char> begin (in), end ;\n    std::string text (begin, end) ;\n    text = remove_whitespaces (text) ;\n    return text ;\n}\n\nint main (int argc, char const *argv [])\n{\n    std::ios::sync_with_stdio (false) ;\n    std::cin.tie (nullptr) ;\n    std::string text = read_text_from_stdin <std::string> (std::cin) ;\n    PermutationOutput output ;\n    permutations (text, PrintPermutation (output)) ;\n    return 0 ;\n}\n",

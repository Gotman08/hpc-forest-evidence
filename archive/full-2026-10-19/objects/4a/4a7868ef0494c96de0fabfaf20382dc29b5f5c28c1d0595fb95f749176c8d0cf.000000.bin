{
  "src/est_matriz_seq.c": "#include <stdio.h>\n#include <stdlib.h>\n#include <math.h>\n#include <string.h>\n\nstatic void bubble_sort(double *values, size_t length) {\n    size_t end, j;\n    double temporary;\n\n    for (end = length; end > 1; --end) {\n        for (j = 0; j < end - 1; ++j) {\n            if (values[j] > values[j + 1]) {\n                temporary = values[j];\n                values[j] = values[j + 1];\n                values[j + 1] = temporary;\n            }\n        }\n    }\n}\n\nstatic void merge_sort(double *values, double *scratch, size_t length) {\n    size_t width;\n    double *source = values;\n    double *destination = scratch;\n\n    for (width = 1; width < length;) {\n        size_t left = 0;\n\n        while (left < length) {\n            size_t remaining = length - left;\n            size_t middle = left + (remaining < width ? remaining : width);\n            size_t right;\n            size_t i, j, output;\n\n            remaining = length - middle;\n            right = middle + (remaining < width ? remaining : width);\n            i = left;\n            j = middle;\n            output = left;\n\n            while (i < middle && j < right) {\n                if (source[i] <= source[j])\n                    destination[output++] = source[i++];\n                else\n                    destination[output++] = source[j++];\n            }\n            while (i < middle)\n                destination[output++] = source[i++];\n            while (j < right)\n                destination[output++] = source[j++];\n\n            left = right;\n        }\n\n        {\n            double *temporary = source;\n            source = destination;\n            destination = temporary;\n        }\n\n        if (width > length / 2)\n            break;\n        width *= 2;\n    }\n\n    if (source != values)\n        memcpy(values, source, length * sizeof(*values));\n}\n\nstatic double moda_coluna_com_nan(const double *column, size_t length) {\n    size_t i, j;\n    float best_count = 0.0f;\n    double mode = 0.0;\n\n    for (i = 0; i < length; ++i) {\n        double count = 0.0;\n        for (j = i + 1; j < length; ++j) {\n            if (column[i] == column[j]) {\n                count++;\n                if (count > best_count) {\n                    best_count = (float)count;\n                    mode = column[i];\n                }\n            }\n        }\n    }\n\n    return best_count == 0.0f ? -1.0 : mode;\n}\n\nstatic void calcula_coluna(double *matriz, double *media, double *media_har,\n                           double *mediana, double *moda, double *variancia,\n                           double *dp, double *cv, size_t rows, size_t index,\n                           double *scratch) {\n    size_t base = index * rows;\n    double *column = matriz + base;\n    size_t j;\n    double soma = 0.0;\n    double soma_harmonica = 0.0;\n    int has_nan = 0;\n\n    for (j = 0; j < rows; ++j) {\n        double value = column[j];\n        soma += value;\n        soma_harmonica += 1 / value;\n        if (isnan(value))\n            has_nan = 1;\n    }\n    media[index] = soma / rows;\n    media_har[index] = rows / soma_harmonica;\n\n    if (has_nan || scratch == NULL)\n        bubble_sort(column, rows);\n    else\n        merge_sort(column, scratch, rows);\n\n    if ((rows - 1) % 2) {\n        size_t middle = (rows - 1) / 2;\n        mediana[index] = column[middle] + column[middle + 1];\n        mediana[index] *= 0.5;\n    } else {\n        mediana[index] = column[(rows - 1) / 2];\n    }\n\n    if (has_nan) {\n        double variance_sum = 0.0;\n        for (j = 0; j < rows; ++j)\n            variance_sum += pow(column[j] - media[index], 2);\n        variancia[index] = variance_sum / (rows - 1);\n        moda[index] = moda_coluna_com_nan(column, rows);\n    } else {\n        double variance_sum = 0.0;\n        double run_value = 0.0;\n        double mode = 0.0;\n        size_t run_length = 0;\n        float best_count = 0.0f;\n\n        for (j = 0; j < rows; ++j) {\n            double value = column[j];\n            variance_sum += pow(value - media[index], 2);\n\n            if (j == 0) {\n                run_value = value;\n                run_length = 1;\n            } else if (value == run_value) {\n                ++run_length;\n            } else {\n                double count = (double)(run_length - 1);\n                if (count > best_count) {\n                    best_count = (float)count;\n                    mode = run_value;\n                }\n                run_value = value;\n                run_length = 1;\n            }\n        }\n\n        {\n            double count = (double)(run_length - 1);\n            if (count > best_count) {\n                best_count = (float)count;\n                mode = run_value;\n            }\n        }\n\n        variancia[index] = variance_sum / (rows - 1);\n        moda[index] = best_count == 0.0f ? -1.0 : mode;\n    }\n\n    dp[index] = sqrt(variancia[index]);\n    cv[index] = dp[index] / media[index];\n}\n\nint main(int argc, char **argv) {\n    int lin, col, i, j;\n    double *matriz, *mediana, *media, *media_har, *moda;\n    double *variancia, *dp, *cv, *scratch;\n    size_t rows, columns;\n\n    (void)argc;\n    (void)argv;\n\n    fscanf(stdin, \"%d \", &lin);\n    fscanf(stdin, \"%d\\n\", &col);\n    rows = (size_t)lin;\n    columns = (size_t)col;\n\n    matriz = malloc(rows * columns * sizeof(*matriz));\n    media = malloc(columns * sizeof(*media));\n    media_har = malloc(columns * sizeof(*media_har));\n    mediana = malloc(columns * sizeof(*mediana));\n    moda = malloc(columns * sizeof(*moda));\n    variancia = malloc(columns * sizeof(*variancia));\n    cv = malloc(columns * sizeof(*cv));\n    dp = malloc(columns * sizeof(*dp));\n    scratch = malloc(rows * sizeof(*scratch));\n\n    for (i = 0; i < lin; ++i) {\n        for (j = 0; j < col; ++j)\n            fscanf(stdin, \"%lf \", &matriz[(size_t)j * rows + (size_t)i]);\n    }\n\n    for (i = 0; i < col; ++i) {\n        calcula_coluna(matriz, media, media_har, mediana, moda, variancia,\n                       dp, cv, rows, (size_t)i, scratch);\n    }\n\n    for (i = 0; i < col; ++i)\n        printf(\"%.1lf \", media[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; ++i)\n        printf(\"%.1lf \", media_har[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; ++i)\n        printf(\"%.1lf \", mediana[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; ++i)\n        printf(\"%.1lf \", moda[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; ++i)\n        printf(\"%.1lf \", variancia[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; ++i)\n        printf(\"%.1lf \", dp[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; ++i)\n        printf(\"%.1lf \", cv[i]);\n    printf(\"\\n\");\n\n    free(matriz);\n    free(media);\n    free(media_har);\n    free(mediana);\n    free(moda);\n    free(variancia);\n    free(dp);\n    free(cv);\n    free(scratch);\n    return 0;\n}\n"
}

#!/bin/bash
#SBATCH --job-name=hpc-forest-candidate
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --time=00:10:00
#SBATCH --output=hpc-forest-%j.log
set -euo pipefail

# Load the compiler/runtime provided by your site before using this template.
: "${SOURCE_DIR:?Set SOURCE_DIR to the imported example source directory}"
: "${BUILD_DIR:?Set BUILD_DIR to a new build directory in the allocation}"
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-2}"
export OMP_DYNAMIC=FALSE
mkdir -p "$BUILD_DIR"
gcc -O3 -std=c11 -fopenmp "$SOURCE_DIR/src/main.c" -o "$BUILD_DIR/solution"
"$BUILD_DIR/solution" 256 17 4

        "epoch": 1,
        "hypothesis": "Exact deterministic Miller–Rabin with early base-2 rejection and independent remaining witness lanes should eliminate the floating trial-division bottleneck on ARM64.",
        "id": "8cc156d46f73483d",
        "ordinal": 1,
        "parent_id": null,
        "role": "B",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/model-view/primetest.c",
            "src/sources/primetest.c"
          ],
          "retained": [
            "Replace floating trial division with small-prime predivision and deterministic Miller–Rabin bases 2, 7 and 61, using uint64_t modular products.",
            "Use modular doubling for base-2 powering, then interleave independent bases 7 and 61 without overriding true loop dependencies or forcing SIMD.",
            "Mirror the separable primality kernel in both files; preserve enumeration, duplicate occurrences, sorting and I/O behavior."
          ]
        },

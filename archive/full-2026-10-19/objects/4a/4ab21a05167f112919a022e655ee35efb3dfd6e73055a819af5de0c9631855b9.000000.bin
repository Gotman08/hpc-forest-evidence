      "content": "#define _GNU_SOURCE\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nvoid body_force(float *restrict x, float *restrict y, float *restrict z,\n                float *restrict vx, float *restrict vy, float *restrict vz,\n                float dt, int n) {\n  #pragma omp parallel for schedule(static)\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f, fy = 0.0f, fz = 0.0f;\n    float xi = x[i], yi = y[i], zi = z[i];\n\n    #pragma omp simd reduction(+:fx,fy,fz) aligned(x,y,z:16)\n    for (int j = 0; j < n; ++j) {\n      float dx = x[j] - xi;\n      float dy = y[j] - yi;\n      float dz = z[j] - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1.0f / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    vx[i] += dt*fx;\n    vy[i] += dt*fy;\n    vz[i] += dt*fz;\n  }\n}\n\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  int n = *nbodies;\n  Body *tmp = (Body *)malloc(n * sizeof(Body));\n  b = fread(tmp, n * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  float *x, *y, *z, *vx, *vy, *vz;\n  posix_memalign((void**)&x,  16, n * sizeof(float));\n  posix_memalign((void**)&y,  16, n * sizeof(float));\n  posix_memalign((void**)&z,  16, n * sizeof(float));\n  posix_memalign((void**)&vx, 16, n * sizeof(float));\n  posix_memalign((void**)&vy, 16, n * sizeof(float));\n  posix_memalign((void**)&vz, 16, n * sizeof(float));\n\n  for (int i = 0; i < n; ++i) {\n    x[i]  = tmp[i].x;\n    y[i]  = tmp[i].y;\n    z[i]  = tmp[i].z;\n    vx[i] = tmp[i].vx;\n    vy[i] = tmp[i].vy;\n    vz[i] = tmp[i].vz;\n  }\n\n  free(tmp);\n\n  /* Store pointers in a single allocated block for later retrieval */\n  Body *meta = (Body *)malloc(6 * sizeof(float*));\n  ((float**)meta)[0] = x;   ((float**)meta)[1] = y;\n  ((float**)meta)[2] = z;   ((float**)meta)[3] = vx;\n  ((float**)meta)[4] = vy;  ((float**)meta)[5] = vz;\n\n  return meta;\n}\n\nvoid write_dataset(const int nbodies, Body *meta) {\n  float **arrays = (float**)meta;\n  float *x  = arrays[0];\n  float *y  = arrays[1];\n  float *z  = arrays[2];\n  float *vx = arrays[3];\n  float *vy = arrays[4];\n  float *vz = arrays[5];\n\n  Body *out = (Body *)malloc(nbodies * sizeof(Body));\n  for (int i = 0; i < nbodies; ++i) {\n    out[i].x  = x[i];\n    out[i].y  = y[i];\n    out[i].z  = z[i];\n    out[i].vx = vx[i];\n    out[i].vy = vy[i];\n    out[i].vz = vz[i];\n  }\n\n  int b = fwrite(out, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  free(out);\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *meta = read_dataset(&nbodies);\n  float **arrays = (float**)meta;\n  float *x  = arrays[0];\n  float *y  = arrays[1];\n  float *z  = arrays[2];\n  float *vx = arrays[3];\n  float *vy = arrays[4];\n  float *vz = arrays[5];\n\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    body_force(x, y, z, vx, vy, vz, DT, nbodies);\n\n    #pragma omp parallel for schedule(static)\n    for (int i = 0; i < nbodies; ++i) {\n      x[i]  += vx[i] * DT;\n      y[i]  += vy[i] * DT;\n      z[i]  += vz[i] * DT;\n    }\n  }\n\n  write_dataset(nbodies, meta);\n\n  free(x); free(y); free(z); free(vx); free(vy); free(vz);\n  free(meta);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Converting to Struct-of-Arrays layout with aligned allocation and restrict qualifiers enables efficient SIMD vectorization via #pragma omp simd reduction. Hoisting outer loop coordinates into local variables reduces memory accesses. Parallelizing the outer i-loop with OpenMP static scheduling provides thread-level parallelism while maintaining data locality.",

#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <omp.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

typedef struct { float x, y, z, vx, vy, vz; } Body;

Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }
  return bodies;
}

void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc,char **argv) {
  int nbodies;
  Body *bodies = read_dataset(&nbodies);

  // Convert AoS input layout to separate arrays (SoA) for cache locality.
  float *restrict x = (float*)malloc(nbodies * sizeof(float));
  float *restrict y = (float*)malloc(nbodies * sizeof(float));
  float *restrict z = (float*)malloc(nbodies * sizeof(float));
  float *restrict vx = (float*)malloc(nbodies * sizeof(float));
  float *restrict vy = (float*)malloc(nbodies * sizeof(float));
  float *restrict vz = (float*)malloc(nbodies * sizeof(float));

  for (int i = 0; i < nbodies; ++i) {
    x[i] = bodies[i].x;
    y[i] = bodies[i].y;
    z[i] = bodies[i].z;
    vx[i] = bodies[i].vx;
    vy[i] = bodies[i].vy;
    vz[i] = bodies[i].vz;
  }

  for (int iter = 0; iter < N_ITER; ++iter) {
    #pragma omp parallel
    {
      // Force computation: each i is handled by one thread, preserving the exact
      // per-body accumulation order of the sequential reference.
      #pragma omp for schedule(dynamic,16)
      for (int i = 0; i < nbodies; ++i) {
        float xi = x[i];
        float yi = y[i];
        float zi = z[i];
        float fx = 0.0f;
        float fy = 0.0f;
        float fz = 0.0f;

        int j = 0;
        // Unroll inner loop by 8, preserving strict ascending accumulation order.
        for (; j + 7 < nbodies; j += 8) {
          float dx = x[j] - xi;
          float dy = y[j] - yi;
          float dz = z[j] - zi;
          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
          float inv_dist = 1 / sqrt(sqrd_dist);
          float inv_dist3 = inv_dist * inv_dist * inv_dist;
          fx += dx * inv_dist3;
          fy += dy * inv_dist3;
          fz += dz * inv_dist3;

          dx = x[j+1] - xi;
          dy = y[j+1] - yi;
          dz = z[j+1] - zi;
          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
          inv_dist = 1 / sqrt(sqrd_dist);
          inv_dist3 = inv_dist * inv_dist * inv_dist;
          fx += dx * inv_dist3;
          fy += dy * inv_dist3;
          fz += dz * inv_dist3;

          dx = x[j+2] - xi;
          dy = y[j+2] - yi;
          dz = z[j+2] - zi;
          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
          inv_dist = 1 / sqrt(sqrd_dist);
          inv_dist3 = inv_dist * inv_dist * inv_dist;
          fx += dx * inv_dist3;
          fy += dy * inv_dist3;
          fz += dz * inv_dist3;

          dx = x[j+3] - xi;
          dy = y[j+3] - yi;
          dz = z[j+3] - zi;
          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
          inv_dist = 1 / sqrt(sqrd_dist);
          inv_dist3 = inv_dist * inv_dist * inv_dist;
          fx += dx * inv_dist3;
          fy += dy * inv_dist3;
          fz += dz * inv_dist3;

          dx = x[j+4] - xi;
          dy = y[j+4] - yi;
          dz = z[j+4] - zi;
          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
          inv_dist = 1 / sqrt(sqrd_dist);
          inv_dist3 = inv_dist * inv_dist * inv_dist;
          fx += dx * inv_dist3;
          fy += dy * inv_dist3;
          fz += dz * inv_dist3;

          dx = x[j+5] - xi;
          dy = y[j+5] - yi;
          dz = z[j+5] - zi;
          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
          inv_dist = 1 / sqrt(sqrd_dist);
          inv_dist3 = inv_dist * inv_dist * inv_dist;
          fx += dx * inv_dist3;
          fy += dy * inv_dist3;
          fz += dz * inv_dist3;

          dx = x[j+6] - xi;
          dy = y[j+6] - yi;
          dz = z[j+6] - zi;
          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
          inv_dist = 1 / sqrt(sqrd_dist);
          inv_dist3 = inv_dist * inv_dist * inv_dist;
          fx += dx * inv_dist3;
          fy += dy * inv_dist3;
          fz += dz * inv_dist3;

          dx = x[j+7] - xi;
          dy = y[j+7] - yi;
          dz = z[j+7] - zi;
          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
          inv_dist = 1 / sqrt(sqrd_dist);
          inv_dist3 = inv_dist * inv_dist * inv_dist;
          fx += dx * inv_dist3;
          fy += dy * inv_dist3;
          fz += dz * inv_dist3;
        }

        // Remainder iterations.
        for (; j < nbodies; ++j) {
          float dx = x[j] - xi;
          float dy = y[j] - yi;
          float dz = z[j] - zi;
          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
          float inv_dist = 1 / sqrt(sqrd_dist);
          float inv_dist3 = inv_dist * inv_dist * inv_dist;
          fx += dx * inv_dist3;
          fy += dy * inv_dist3;
          fz += dz * inv_dist3;
        }

        vx[i] += DT*fx;
        vy[i] += DT*fy;
        vz[i] += DT*fz;
      }

      // Position update: static schedule is sufficient and avoids extra overhead.
      #pragma omp for schedule(static)
      for (int i = 0; i < nbodies; ++i) {
        x[i] += vx[i]*DT;
        y[i] += vy[i]*DT;
        z[i] += vz[i]*DT;
      }
    } // end parallel region
  }

  // Convert back to the required AoS output layout.
  for (int i = 0; i < nbodies; ++i) {
    bodies[i].x = x[i];
    bodies[i].y = y[i];
    bodies[i].z = z[i];
    bodies[i].vx = vx[i];
    bodies[i].vy = vy[i];
    bodies[i].vz = vz[i];
  }

  write_dataset(nbodies, bodies);

  free(x); free(y); free(z); free(vx); free(vy); free(vz);
  free(bodies);

  return EXIT_SUCCESS;
}

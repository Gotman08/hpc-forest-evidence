{
  "src/main.cpp": "#include <bits/stdc++.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\nint A[1000][1000];\nint ps[1010][1010];\n\ntypedef long long ll;\n\nstatic ll count_start_column(int j, int m, int n, int k,\n                            unordered_map<ll, ll>& h) {\n  ll ans = 0;\n  for (int l = j; l <= n; l++) {\n    h.clear();\n    h[0] = 1;\n    ll s = 0;\n    for (int i = 1; i <= m; i++) {\n      s += ps[i][l] - ps[i][j - 1];\n      ans += h.find(s - k) != h.end() ? h[s - k] : 0;\n      h[s]++;\n    }\n  }\n  return ans;\n}\n\nstatic ll count_paired_starts(int task, int m, int n, int k,\n                             unordered_map<ll, ll>& h) {\n  const int first = task + 1;\n  const int second = n - task;\n  ll ans = count_start_column(first, m, n, k, h);\n  if (first != second)\n    ans += count_start_column(second, m, n, k, h);\n  return ans;\n}\n\nll solve(int m, int n, int k) {\n  for (int i = 1; i <= m; i++) {\n    ps[i][0] = 0;\n    for (int j = 1; j <= n; j++) {\n      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\n    }\n  }\n\n  // Opposite starting columns together contain n + 1 bands.\n  // For odd n, the central starting column is processed just once.\n  const int tasks = (n + 1) / 2;\n  const ll row_visits = static_cast<ll>(m) * n * (n + 1) / 2;\n  const ll minimum_visits_per_worker = 32768;\n  int workers = 1;\n  if (tasks >= 2 && row_visits >= 2 * minimum_visits_per_worker)\n    workers = 2;\n  if (tasks >= 4 && row_visits >= 4 * minimum_visits_per_worker)\n    workers = 4;\n#ifdef _OPENMP\n  workers = min(workers, omp_get_max_threads());\n#endif\n\n  ll ans = 0;\n  if (workers == 1) {\n    unordered_map<ll, ll> h;\n    h.reserve(static_cast<size_t>(m) + 1);\n    for (int task = 0; task < tasks; task++)\n      ans += count_paired_starts(task, m, n, k, h);\n    return ans;\n  }\n\n#ifdef _OPENMP\n#pragma omp parallel num_threads(workers) reduction(+:ans)\n  {\n    unordered_map<ll, ll> h;\n    h.reserve(static_cast<size_t>(m) + 1);\n#pragma omp for schedule(dynamic, 1) nowait\n    for (int task = 0; task < tasks; task++)\n      ans += count_paired_starts(task, m, n, k, h);\n  }\n#else\n  atomic<int> next_task{0};\n  array<ll, 4> subtotals{};\n  auto run_worker = [&](int worker) {\n    unordered_map<ll, ll> h;\n    h.reserve(static_cast<size_t>(m) + 1);\n    ll subtotal = 0;\n    for (;;) {\n      const int task = next_task.fetch_add(1, memory_order_relaxed);\n      if (task >= tasks)\n        break;\n      subtotal += count_paired_starts(task, m, n, k, h);\n    }\n    subtotals[worker] = subtotal;\n  };\n\n  array<thread, 3> threads;\n  for (int worker = 1; worker < workers; worker++)\n    threads[worker - 1] = thread(run_worker, worker);\n  run_worker(0);\n  for (int worker = 1; worker < workers; worker++)\n    threads[worker - 1].join();\n  for (int worker = 0; worker < workers; worker++)\n    ans += subtotals[worker];\n#endif\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n  memset(ps, 0, sizeof ps);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n"
}

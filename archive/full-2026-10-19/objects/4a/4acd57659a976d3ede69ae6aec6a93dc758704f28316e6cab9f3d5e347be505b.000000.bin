      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <ctype.h>\n#include <limits.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\ntypedef struct {\n  int id;\n  float value;\n  size_t first_neighbor;\n  size_t neighbor_count;\n} Node;\n\ntypedef struct {\n  char *spelling;\n  int id;\n  float result;\n} Query;\n\ntypedef struct {\n  Node *nodes;\n  int count;\n  int *neighbors;\n  Query *queries;\n  size_t query_count;\n  char *text;\n} Graph;\n\nstatic void fail(void) {\n  fprintf(stderr, \"Error!\\n\");\n  exit(1);\n}\n\nstatic void *resize_storage(void *old, size_t count, size_t element_size) {\n  if (count > (size_t)-1 / element_size)\n    fail();\n  void *p = realloc(old, count * element_size);\n  if (p == NULL && count != 0)\n    fail();\n  return p;\n}\n\nstatic void *reserve_array(void *old, size_t *capacity,\n                           size_t needed, size_t element_size) {\n  if (needed <= *capacity)\n    return old;\n\n  size_t limit = (size_t)-1 / element_size;\n  if (needed > limit)\n    fail();\n  size_t next = *capacity ? *capacity : 16;\n  if (next > limit)\n    next = needed;\n  while (next < needed) {\n    if (next > limit / 2) {\n      next = needed;\n      break;\n    }\n    next *= 2;\n  }\n  old = resize_storage(old, next, element_size);\n  *capacity = next;\n  return old;\n}\n\nstatic char *read_text(FILE *fl) {\n  size_t capacity = 65536;\n  size_t length = 0;\n  char *text = resize_storage(NULL, capacity + 1, sizeof(char));\n\n  for (;;) {\n    size_t received = fread(text + length, 1, capacity - length, fl);\n    length += received;\n    if (received == 0) {\n      if (ferror(fl))\n        fail();\n      break;\n    }\n    if (length == capacity) {\n      if (capacity > ((size_t)-1 - 1) / 2)\n        fail();\n      capacity *= 2;\n      text = resize_storage(text, capacity + 1, sizeof(char));\n    }\n  }\n  text[length] = '\\0';\n  return text;\n}\n\nstatic char *take_line(char **cursor) {\n  if (*cursor == NULL || **cursor == '\\0')\n    return NULL;\n  char *line = *cursor;\n  char *end = strchr(line, '\\n');\n  if (end != NULL) {\n    *end = '\\0';\n    *cursor = end + 1;\n  } else {\n    *cursor = NULL;\n  }\n  return line;\n}\n\nstatic char *take_data_line(char **cursor) {\n  char *line;\n  while ((line = take_line(cursor)) != NULL) {\n    char *p = line;\n    while (isspace((unsigned char)*p))\n      ++p;\n    if (*p != '\\0')\n      return line;\n  }\n  return NULL;\n}\n\n/* Keep the original literal-space tokenization and query spellings. */\nstatic char *take_space_token(char **cursor) {\n  char *p = *cursor;\n  while (*p == ' ')\n    ++p;\n  if (*p == '\\0') {\n    *cursor = p;\n    return NULL;\n  }\n  char *token = p;\n  while (*p != '\\0' && *p != ' ')\n    ++p;\n  if (*p != '\\0')\n    *p++ = '\\0';\n  *cursor = p;\n  return token;\n}\n\nstatic Graph read_input(const char *fname) {\n  Graph graph = {0};\n  FILE *fl = fname == NULL ? stdin : fopen(fname, \"r\");\n  if (fl == NULL)\n    fail();\n  graph.text = read_text(fl);\n  if (fname != NULL)\n    fclose(fl);\n\n  char *cursor = graph.text;\n  char *line = take_data_line(&cursor);\n  if (line == NULL)\n    fail();\n  char *end;\n  long count = strtol(line, &end, 10);\n  if (end == line || count < 0 || count > INT_MAX)\n    fail();\n  graph.count = (int)count;\n  if (graph.count != 0)\n    graph.nodes = resize_storage(NULL, (size_t)graph.count, sizeof(Node));\n\n  char *p = end;\n  while (isspace((unsigned char)*p))\n    ++p;\n  size_t query_capacity = 0;\n  char *token;\n  while ((token = take_space_token(&p)) != NULL) {\n    graph.queries = reserve_array(graph.queries, &query_capacity,\n                                 graph.query_count + 1, sizeof(Query));\n    Query *query = &graph.queries[graph.query_count++];\n    query->spelling = token;\n    query->id = atoi(token);\n    query->result = 0.0f;\n  }\n\n  size_t neighbor_capacity = 0;\n  size_t neighbor_count = 0;\n  for (int i = 0; i < graph.count; ++i) {\n    line = take_data_line(&cursor);\n    if (line == NULL)\n      fail();\n    long id = strtol(line, &end, 10);\n    if (end == line || id < INT_MIN || id > INT_MAX)\n      fail();\n    char *value_end;\n    float value = strtof(end, &value_end);\n    if (value_end == end)\n      fail();\n\n    Node *node = &graph.nodes[i];\n    node->id = (int)id;\n    node->value = value;\n    node->first_neighbor = neighbor_count;\n    p = value_end;\n    while (isspace((unsigned char)*p))\n      ++p;\n    while ((token = take_space_token(&p)) != NULL) {\n      graph.neighbors = reserve_array(graph.neighbors, &neighbor_capacity,\n                                      neighbor_count + 1, sizeof(int));\n      graph.neighbors[neighbor_count++] = atoi(token);\n    }\n    node->neighbor_count = neighbor_count - node->first_neighbor;\n  }\n  return graph;\n}\n\nstatic int find_by_id(const Node g[], int id, int size) {\n  for (int i = 0; i < size; ++i)\n    if (g[i].id == id)\n      return i;\n  return -1;\n}\n\n/* Each worker reuses its own path buffer; the graph remains read-only. */\nstatic float get_costly(const Graph *graph, int id,\n                        float **path, size_t *capacity) {\n  int nd = find_by_id(graph->nodes, id, graph->count);\n  if (nd < 0)\n    return 0.0f;\n\n  size_t length = 0;\n  while (nd >= 0) {\n    const Node *node = &graph->nodes[nd];\n    *path = reserve_array(*path, capacity, length + 1, sizeof(float));\n    (*path)[length++] = node->value;\n\n    float max = 0.0f;\n    int idmax = -1;\n    int next = -1;\n    for (size_t j = 0; j < node->neighbor_count; ++j) {\n      int neighbor_id = graph->neighbors[node->first_neighbor + j];\n      int d = find_by_id(graph->nodes, neighbor_id, graph->count);\n      if (d >= 0 && max < graph->nodes[d].value) {\n        max = graph->nodes[d].value;\n        idmax = neighbor_id;\n        next = d;\n      }\n    }\n    if (idmax == -1)\n      break;\n    nd = next;\n  }\n\n  /* Preserve the recursive leaf-to-root float rounding order. */\n  volatile float result = (*path)[--length];\n  while (length != 0) {\n    float parent = (*path)[--length];\n    parent += result;\n    result = parent;\n  }\n  return result;\n}\n\nstatic void evaluate_queries(Graph *graph) {\n#ifdef _OPENMP\n  if (graph->count >= 1024 && graph->query_count > 1) {\n    int threads = omp_get_max_threads();\n    if ((size_t)threads > graph->query_count)\n      threads = (int)graph->query_count;\n    if (threads > 1) {\n#pragma omp parallel num_threads(threads)\n      {\n        float *path = NULL;\n        size_t capacity = 0;\n#pragma omp for schedule(dynamic, 1) nowait\n        for (size_t i = 0; i < graph->query_count; ++i)\n          graph->queries[i].result = get_costly(graph, graph->queries[i].id,\n                                                &path, &capacity);\n        free(path);\n      }\n      return;\n    }\n  }\n#endif\n\n  float *path = NULL;\n  size_t capacity = 0;\n  for (size_t i = 0; i < graph->query_count; ++i)\n    graph->queries[i].result = get_costly(graph, graph->queries[i].id,\n                                          &path, &capacity);\n  free(path);\n}\n\nint main(void) {\n  Graph graph = read_input(NULL);\n  evaluate_queries(&graph);\n  for (size_t i = 0; i < graph.query_count; ++i)\n    printf(\"%s: %f\\n\", graph.queries[i].spelling, graph.queries[i].result);\n\n  free(graph.nodes);\n  free(graph.neighbors);\n  free(graph.queries);\n  free(graph.text);\n  return 0;\n}\n",
      "path": "src/graph.c"
    }

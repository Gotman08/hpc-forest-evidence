"""Prepare exact proposals/official data only. Never call a service or native CLI."""
import hashlib
import importlib.util
import json
import shutil
import stat
import zipfile
from pathlib import Path, PurePosixPath

HERE = Path(__file__).resolve().parent
_spec = importlib.util.spec_from_file_location('roots_parent_pure_definitions', HERE / 'parent_roots.py')
p = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(p)


def save(path, value):
    with path.open('x', encoding='utf8', newline='\n') as stream:
        stream.write(json.dumps(value, indent=2, ensure_ascii=False) + '\n')


def main():
    p.verify_chain()
    pins = json.loads((p.FACTORY / 'launcher/pins-source-plan.json').read_bytes())
    source_zip = p.artifact(pins['source_zip'])
    source_plan = p.artifact(pins['plan'])
    runtime = p.artifact(pins['source_manifest'])
    expected = json.loads(runtime.read_bytes())
    need = p.need
    data = {}
    with zipfile.ZipFile(source_zip) as archive:
        for entry in archive.infolist():
            need(not entry.is_dir() and entry.filename.startswith('HPC-Forest/')
                and not stat.S_ISLNK(entry.external_attr >> 16), 'Regular official source member only')
            name = entry.filename.removeprefix('HPC-Forest/')
            rel = PurePosixPath(name)
            need(name not in data and not rel.is_absolute() and rel.as_posix() == name
                and '\\' not in name and all(part not in {'.', '..', ''} for part in rel.parts), 'Exact safe source relative path')
            data[name] = archive.read(entry)
    need(len(data) == 110 and {name: hashlib.sha256(raw).hexdigest() for name, raw in data.items()} == expected,
         'Official sealed source110 ZIP/runtime differs')
    shared_name = 'hpc-forest-dynamic-r4b-lane-r3-qualification-20261018-eaff9217499f'
    staging_parent = HERE / 'transport-partage'; staging_parent.mkdir(exist_ok=False)
    staged = staging_parent / shared_name; staged.mkdir()
    for name, raw in data.items():
        path = staged / 'project' / name; path.parent.mkdir(parents=True, exist_ok=True)
        with path.open('xb') as stream:
            stream.write(raw)
    for source, name in ((source_zip, 'project.zip'), (source_plan, 'dynamic-plan.json'), (runtime, 'runtime-manifest.json')):
        shutil.copyfile(source, staged / name)
    inventory = {path.relative_to(staged).as_posix(): p.sha(path) for path in sorted(staged.rglob('*')) if path.is_file()}
    need(len(inventory) == 113, 'Exact113 official shared files, no private policy or received candidate')
    save(HERE / 'INVENTAIRE-PARTAGE-OFFICIEL-113.json', inventory)
    cells = []
    review_ref = {'path': str(p.REVIEW), 'sha256': p.REVIEW_SHA}
    for model, (slug, session) in p.ROOTS.items():
        folder = HERE / slug; folder.mkdir(exist_ok=False)
        original = p.FACTORY / 'launcher' / slug / 'roots'
        for name in ('job-prepare-propose.json', 'commande-allouee.sh'):
            shutil.copyfile(original / name, folder / name)
        template = json.loads((original / 'factory-input-NON-ADMIS.json').read_bytes())
        template.update(factory_review=review_ref, reader_integration_review=review_ref,
            latest_native_generation_closure=pins['latest_native_generation_closure'])
        need(template['verified'] is False and template['job_id'] is None, 'No false actual cell')
        save(folder / 'factory-input-NON-ADMIS.json', template)
        save(folder / 'intent-input-NON-ADMIS.json', {'schema': 'hpc-forest-r4b-parent-root-intent-input-v1',
            'model': model, 'phase': 'roots', 'real_qualification_reception': None,
            'integration_review': review_ref, 'scheduler_script_review': None, 'capacity_review': None})
        binding = {'scope_id': p.SCOPE, 'model': model, 'effort': 'max', 'session_id': session,
            'job_id': None, 'remote_root': '/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-' + session,
            'source_zip_sha256': p.SOURCE, 'plan_sha256': p.PLAN}
        save(folder / 'binding-huit-champs-NON-ADMIS.json', binding)
        cells.append({'model': model, 'phase': 'roots', 'session_id': session,
            'job_prepare_arguments_exact_copy': p.reference(folder / 'job-prepare-propose.json'),
            'command_exact_copy': p.reference(folder / 'commande-allouee.sh'), 'allocation_max_seconds': 3600,
            'pending_factory_input': p.reference(folder / 'factory-input-NON-ADMIS.json'),
            'future_binding8': p.reference(folder / 'binding-huit-champs-NON-ADMIS.json'),
            'native_root': binding['remote_root'],
            'admission_root': '/scratch_p/nimarano/hpc-forest-dynamic-r4b-admission-' + session,
            'allocation_marker': '/scratch_p/nimarano/hpc-forest-dynamic-r4b-admission-' + session + '/allocation-marker.json',
            'local_factory_output_allowed': str(p.FACTORY / ('cellule-roots-' + slug + '-premier-r1')),
            'owner_download_after_ready': binding['remote_root'] + '/results-ACTUAL_JOB_ID/mailbox/OWNER.json',
            'cache_output_exact': str(p.PREP / 'lancement-modeles-max-r3' / ('worker-' + session)),
            'job_id': None, 'submitted': False, 'worker_started': False})
    source_capture = p.BASE / 'outputs/HPC-Forest-Primes-Natif-Relance-r2g/operations-parent/capturer-prevol-r2g.ps1'
    capture = source_capture.read_text()
    old = 'outputs/HPC-Forest-Primes-Natif-Relance-r2g/operations-parent'
    new = 'outputs/HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r3/operations-parent-premier-roots-source110-r1'
    need(capture.count(old) == 1, 'Single scoped parent capture output substitution only')
    with (HERE / 'capturer-prevol-roots.ps1').open('x', encoding='utf8', newline='\n') as stream:
        stream.write(capture.replace(old, new))
    save(HERE / 'DERIVATION-CAPTURE-SANS-EXECUTION.json', {'original': p.reference(source_capture),
        'derived': p.reference(HERE / 'capturer-prevol-roots.ps1'), 'only_change': 'Exact output folder',
        'CIM_collected_by_author': False, 'role_or_authentication_or_process_mutated': False,
        'native_worker_pattern_zero_is_not_complete_capacity_review': True})
    save(HERE / 'RECETTE-TROIS-ROOTS-PARALLELES-NON-ADMISE.json', {
        'schema': 'hpc-forest-r4b-three-parallel-roots-parent-recipe-v1', 'prepared_only': True,
        'source_zip_sha256': p.SOURCE, 'plan_sha256': p.PLAN, 'components': p.reference(p.FACTORY / 'COMPONENTS.json'),
        'integration_review': review_ref, 'all_nine_sessions_preserved': pins['contract_cells'],
        'only_three_roots_requested': cells, 'method_R5_or_pilot_extension_admitted': False,
        'official_source_shared_upload_proposal': {'tool': 'mcp__romeo__upload_to_romeo', 'arguments': {
            'local_path': str(staged), 'remote_path': '/scratch_p/nimarano', 'verify': False},
            'directory_tool_hash_is_not_admission': True, 'expected113_readback_inventory': p.reference(HERE / 'INVENTAIRE-PARTAGE-OFFICIEL-113.json')},
        'immutable_native_stage_archive': p.reference(p.FACTORY / 'launcher/native-interface-models-max-r3.tar.gz'),
        'native_stage_upload_destination': '/scratch_p/nimarano/hpc-forest-dynamic-r4b-native-interface-lane-r3-eaff9217499f.tar.gz',
        'steps_in_order': [
            'Receive delivery-only Q tar AND five sidecars; independent mechanical audit, retain FAILED753709 archival incident',
            'Establish actual target/profile and reference-contract proofs separately; never infer either boolean from265neutral cases',
            'Root uses pinned launcher/bind_qualification.py --reception ACTUAL --reception-sha256 ACTUAL --output NEW_DIRECT_CHILD_OF_LAUNCHER; do not redirect guard',
            'Upload exact113official shared files plus actual Q archive/qualification/audit/mapped receipt and stage3member archive; read back each actual byte/SHA before allocation',
            'Capture root private full CIM/CLI4/authorized-role status; existing reviewed readerR4 CURRENT/SO closure and OBS3/OBS4 transition require actual current evidence',
            'Prepare three exact job arguments with mcp__romeo__job_prepare; re-read each via mcp__romeo__plan_get and review entire scheduler script, not only command inclusion',
            'Root supplies realQ/integration/whole-script/freshcapacity refs to parent_roots.py; one exclusive fsynced intent per model before its one mcp__romeo__job_submit; unknown outcome forbids retry',
            'After real allocated markers and unpublished requests arrive, fill only actual8field bindings/job IDs and make three local policies with pinned helper; do not export policy/236paths',
            'OBS3 absence/lock release must be real before OBS4 --run; actual OBS4 state/routes/full identities yield per-cell admission via --admit-cell roots',
            'Root provides fresh120s observations/OAuth(existing account, no API)/transport/fullCIM/projection and markers<=600s to exact assemble_admissions.py --input/--input-sha256/--output DIRECT_CHILD',
            'Use exact publication.py grouped upload/readback verification then create and publish authorization-ready LAST; receive actual OWNER6 before local bootstrap',
            'Start each exact bootstrap_worker.py with --execute in hidden owned process, underlying --once/max900 fixed; verify complete launcher/Python identity and ready before any extension',
            'Receive/audit each naturally exited technical roots phase strictly; no stop/replay; advice/harvest wait for same-model positive cold receipt',
            'Technical mother roots NORMAL is not candidate NORMAL+real performance evaluation, pilot, methodR5 or scientific admission'],
        'all_new_actual_refs_and_job_ids_missing': True, 'MCP_CLI_model_CIM_cache_or_process_effects_by_author': 0,
        'freshness': {'parent_full_CIM_OAuth_transport_OBS4_seconds': 120, 'allocated_marker_seconds': 600,
            'OBS4_state_seconds': 90, 'cap_native_workers_including_SO': 4,
            'new_roots_reservations': 3, 'deadline_exclusive_utc': '2026-10-31T23:00:00Z', 'audit_reserve_seconds': 10800}})
    p.verify_chain()
    print(json.dumps({'recipe': p.reference(HERE / 'RECETTE-TROIS-ROOTS-PARALLELES-NON-ADMISE.json'),
        'official_staged_files': 113, 'native_calls': 0, 'jobs_submitted': 0, 'sealed62_components_unchanged': True}))


if __name__ == '__main__':
    main()

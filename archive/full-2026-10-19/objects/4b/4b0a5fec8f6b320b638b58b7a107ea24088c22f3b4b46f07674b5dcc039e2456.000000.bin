#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

/*
 * Each body holds coordinate positions (i.e., x, y, and z) and
 * velocities (i.e., vx, vy, and vz).
 */
typedef struct { float x, y, z, vx, vy, vz; } Body;

/*
 * Compute the gravitational impact among all pairs of bodies in
 * the system.
 */
#if defined(__GNUC__) && !defined(__clang__)
__attribute__((optimize("no-math-errno")))
#endif
void body_force(Body *p, float dt, int n) {
  enum { LANES = 4 };
  const int blocks = n / LANES;

  #pragma omp parallel for schedule(static) if (n >= 128)
  for (int block = 0; block < blocks; ++block) {
    const int base = block * LANES;
    float x[LANES], y[LANES], z[LANES];
    float fx[LANES], fy[LANES], fz[LANES];

    for (int lane = 0; lane < LANES; ++lane) {
      x[lane] = p[base + lane].x;
      y[lane] = p[base + lane].y;
      z[lane] = p[base + lane].z;
      fx[lane] = 0.0f;
      fy[lane] = 0.0f;
      fz[lane] = 0.0f;
    }

    /* Pair source calculations, but retain both ordered additions. */
    int j = 0;
    for (; j + 1 < n; j += 2) {
      const float jx0 = p[j].x;
      const float jy0 = p[j].y;
      const float jz0 = p[j].z;
      const float jx1 = p[j + 1].x;
      const float jy1 = p[j + 1].y;
      const float jz1 = p[j + 1].z;

      /* SIMD spans independent targets, not the ordered j reduction. */
      #pragma omp simd simdlen(4)
      for (int lane = 0; lane < LANES; ++lane) {
        float dx0 = jx0 - x[lane];
        float dy0 = jy0 - y[lane];
        float dz0 = jz0 - z[lane];
        float dx1 = jx1 - x[lane];
        float dy1 = jy1 - y[lane];
        float dz1 = jz1 - z[lane];
        float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;
        float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;
        float inv_dist0 = 1 / sqrt(sqrd_dist0);
        float inv_dist1 = 1 / sqrt(sqrd_dist1);
        float inv_dist30 = inv_dist0 * inv_dist0 * inv_dist0;
        float inv_dist31 = inv_dist1 * inv_dist1 * inv_dist1;

        fx[lane] += dx0 * inv_dist30;
        fy[lane] += dy0 * inv_dist30;
        fz[lane] += dz0 * inv_dist30;
        fx[lane] += dx1 * inv_dist31;
        fy[lane] += dy1 * inv_dist31;
        fz[lane] += dz1 * inv_dist31;
      }
    }

    if (j < n) {
      const float jx = p[j].x;
      const float jy = p[j].y;
      const float jz = p[j].z;

      #pragma omp simd simdlen(4)
      for (int lane = 0; lane < LANES; ++lane) {
        float dx = jx - x[lane];
        float dy = jy - y[lane];
        float dz = jz - z[lane];
        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
        float inv_dist = 1 / sqrt(sqrd_dist);
        float inv_dist3 = inv_dist * inv_dist * inv_dist;

        fx[lane] += dx * inv_dist3;
        fy[lane] += dy * inv_dist3;
        fz[lane] += dz * inv_dist3;
      }
    }

    for (int lane = 0; lane < LANES; ++lane) {
      p[base + lane].vx += dt*fx[lane];
      p[base + lane].vy += dt*fy[lane];
      p[base + lane].vz += dt*fz[lane];
    }
  }

  /* Preserve the original calculation for an incomplete target tile. */
  for (int i = blocks * LANES; i < n; ++i) {
    float fx = 0.0f;
    float fy = 0.0f;
    float fz = 0.0f;

    for (int j = 0; j < n; j++) {
      float dx = p[j].x - p[i].x;
      float dy = p[j].y - p[i].y;
      float dz = p[j].z - p[i].z;
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1 / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    p[i].vx += dt*fx;
    p[i].vy += dt*fy;
    p[i].vz += dt*fz;
  }
}

/*
 * Read a binary dataset with initilized bodies.
 */
Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  return bodies;
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc,char **argv) {
  int nbodies;

  Body *bodies = read_dataset(&nbodies);

  /*
   * At each simulation iteration, interbody forces are computed,
   * and bodies' positions are integrated.
   */
  for (int iter = 0; iter < N_ITER; iter++) {
    body_force(bodies, DT, nbodies);

    for (int i = 0; i < nbodies; i++) {
      bodies[i].x += bodies[i].vx * DT;
      bodies[i].y += bodies[i].vy * DT;
      bodies[i].z += bodies[i].vz * DT;
    }
  }

  write_dataset(nbodies, bodies);

  free(bodies);
  
  exit(EXIT_SUCCESS);
}

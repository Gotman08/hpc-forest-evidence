"""Read-only local OAuth/CLI observation; no inference or credential export."""
import hashlib,json,os,subprocess,tomllib
from datetime import datetime,timezone
from pathlib import Path
BASE=Path(r"C:\Users\nicol\Documents\Codex\2026-10-15\cr")
HERE=Path(__file__).resolve().parent
old=BASE/"outputs/HPC-Forest-Primes-Natif-Lancement-r2b/revision-r6-commandes/admissions-astra-max-reelles/local/cli-file-hashes-minimal.json"
x=json.loads(old.read_text(encoding="utf-8-sig"))
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
assert len(x["files"])==4 and len({item["path"] for item in x["files"]})==4
for item in x["files"]: assert sha(item["path"])==item["sha256"],item["path"]
exe=Path(x["executable_path"]);assert sha(exe)==x["executable_sha256"]
config=Path(r"C:\Users\nicol\.codex\config.toml")
c=tomllib.loads(config.read_text(encoding="utf-8-sig"))
auth=Path(r"C:\Users\nicol\.codex\auth.json")
a=json.loads(auth.read_text(encoding="utf-8-sig"))
api_auth=bool(a.get("OPENAI_API_KEY") or a.get("api_key") or a.get("CODEX_API_KEY"))
api_env={key:bool(os.environ.get(key)) for key in ("OPENAI_API_KEY","CODEX_API_KEY","AZURE_OPENAI_API_KEY")}
end_env={key:bool(os.environ.get(key)) for key in ("OPENAI_BASE_URL","OPENAI_API_BASE","AZURE_OPENAI_ENDPOINT","CODEX_MODEL_PROVIDER")}
provider=c.get("model_provider","openai")
provider_config=c.get("model_providers",{}).get(provider,{})
endpoint_override=bool(c.get("openai_base_url") or c.get("chatgpt_base_url") or provider_config.get("base_url"))
assert a.get("auth_mode")=="chatgpt" and not api_auth and not any(api_env.values())
assert provider=="openai" and not endpoint_override and not any(end_env.values())
result=subprocess.run([str(exe),"login","status"],cwd=BASE,capture_output=True,text=True,encoding="utf-8",timeout=30,check=False)
message=(result.stdout+"\n"+result.stderr).strip()
assert result.returncode==0 and message=="Logged in using ChatGPT", "Unexpected login status; not exported"
now=datetime.now(timezone.utc).isoformat()
record={"schema":"hpc-forest-r4b-parent-local-cli-oauth-observation-v1","verified":True,"observed_at":now,"cli_login_status":"Logged in using ChatGPT","auth_mode":"chatgpt","api_key_in_auth_present":api_auth,"api_key_environment_presence":api_env,"endpoint_environment_presence":end_env,"model_provider":provider,"endpoint_override_present":endpoint_override,"files":x["files"],"version":x["version"],"executable_path":str(exe),"executable_sha256":sha(exe),"codex_config":{"path":str(config),"sha256":sha(config)},"authentication":"existing-local-ChatGPT","credentials_exported":False,"new_connection_or_auth":False,"model_inference_executed":False,"native_generation_admitted":False}
folder=HERE/("observation-"+now.replace(":","").replace(".","").replace("+",""))
folder.mkdir(exist_ok=False)
(folder/"CLI-OAUTH-OBSERVATION.json").write_text(json.dumps(record,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
print(json.dumps({"path":str(folder/"CLI-OAUTH-OBSERVATION.json"),"sha256":sha(folder/"CLI-OAUTH-OBSERVATION.json"),"verified":True,"auth_mode":"chatgpt","four_cli_files_exact":True,"inference_executed":False}))


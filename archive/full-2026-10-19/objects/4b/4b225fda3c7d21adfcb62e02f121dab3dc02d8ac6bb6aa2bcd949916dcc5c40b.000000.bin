{
  "hypothesis": "Optimize the memory locality and loop order to improve performance.",
  "transformations": [
    "Reorder loops to process submatrices in a more cache-friendly manner.",
    "Use blocking to further enhance data locality."
  ],
  "sources_kept": [],
  "files": [
    {
      "path": "src/solution.cpp",
      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n\n#define BLOCK_SIZE 128\n\ntemplate<typename T>\nvoid block_max_sum(const std::vector<std::vector<int>>& matrix, int s, int& mxSum) {\n    int n = matrix.size();\n    for (int bi = 0; bi < n; bi += BLOCK_SIZE) {\n        for (int bj = 0; bj < n; bj += BLOCK_SIZE) {\n            for (int i = std::min(bi, n - s); i < std::min(bi + BLOCK_SIZE, n - s + 1); ++i) {\n                int sum = 0;\n                for (int j = std::min(bj, n - s); j < std::min(bj + BLOCK_SIZE, n - s + 1); ++j) {\n                    sum += matrix[i][j];\n                }\n                mxSum = std::max(mxSum, sum);\n            }\n        }\n    }\n}\n\nint main() {\n    int n, s;\n    std::cin >> n >> s;\n    std::vector<std::vector<int>> matrix(n, std::vector<int>(n));\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) {\n            scanf(\"%d\", &(matrix[i][j]));\n        }\n    }\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    int mxSum = INT_MIN;\n    block_max_sum(matrix, s, mxSum);\n\n    printf(\"%d\\n\", mxSum);\n}\n"
    }
  ],
  "notes": "Reordered loops to process submatrices in a more cache-friendly manner and used blocking to enhance data locality."
}

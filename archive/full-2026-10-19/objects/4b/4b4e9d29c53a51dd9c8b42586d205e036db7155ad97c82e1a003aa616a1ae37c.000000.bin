    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <math.h>\\n\\n#define N_ITER 10 // number of simulation iterations\\n#define DT 0.01f // time step\\n#define SOFTENING 1e-9f // to avoid zero divisors\\n\\n/* Tiling parameters */\\n#define IBLOCK 4\\n#define JBLOCK 128\\n\\n/*\\n * Compute the gravitational impact among all pairs of bodies in \\n * the system. Uses Structure-of-Arrays layout, tiled loops and OpenMP.\\n */\\nvoid body_force(float *x, float *y, float *z,\\n                float *vx, float *vy, float *vz,\\n                float dt, int n) {\\n  #pragma omp parallel for schedule(static)\\n  for (int i0 = 0; i0 < n; i0 += IBLOCK) {\\n    int imax = i0 + IBLOCK;\\n    if (imax > n) imax = n;\\n\\n    float fx[IBLOCK], fy[IBLOCK], fz[IBLOCK];\\n    for (int ii = 0; ii < imax - i0; ++ii) {\\n      fx[ii] = 0.0f;\\n      fy[ii] = 0.0f;\\n      fz[ii] = 0.0f;\\n    }\\n\\n    for (int j0 = 0; j0 < n; j0 += JBLOCK) {\\n      int jmax = j0 + JBLOCK;\\n      if (jmax > n) jmax = n;\\n\\n      /* Process one j-block: load each body once and reuse across i-block */\\n      for (int jj = j0; jj < jmax; ++jj) {\\n        float xj = x[jj];\\n        float yj = y[jj];\\n        float zj = z[jj];\\n\\n        for (int ii = i0; ii < imax; ++ii) {\\n          float dx = xj - x[ii];\\n          float dy = yj - y[ii];\\n          float dz = zj - z[ii];\\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n          float inv_dist = 1.0f / sqrt(sqrd_dist);\\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n\\n          fx[ii - i0] += dx * inv_dist3;\\n          fy[ii - i0] += dy * inv_dist3;\\n          fz[ii - i0] += dz * inv_dist3;\\n        }\\n      }\\n    }\\n\\n    /* Update velocities for the current i-block */\\n    for (int ii = i0; ii < imax; ++ii) {\\n      vx[ii] += dt * fx[ii - i0];\\n      vy[ii] += dt * fy[ii - i0];\\n      vz[ii] += dt * fz[ii - i0];\\n    }\\n  }\\n}\\n\\n/*\\n * Read a binary dataset with initialized bodies.\\n */\\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\\n\\nvoid read_dataset(int *nbodies,\\n                  float **x, float **y, float **z,\\n                  float **vx, float **vy, float **vz) {\\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading nbodie value\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n\\n  Body *tmp = (Body *)malloc(*nbodies * sizeof(Body));\\n  b = fread(tmp, *nbodies * sizeof(Body), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading input values\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n\\n  /* Convert to Structure-of-Arrays */\\n  *x = (float *)malloc(*nbodies * sizeof(float));\\n  *y = (float *)malloc(*nbodies * sizeof(float));\\n  *z = (float *)malloc(*nbodies * sizeof(float));\\n  *vx = (float *)malloc(*nbodies * sizeof(float));\\n  *vy = (float *)malloc(*nbodies * sizeof(float));\\n  *vz = (float *)malloc(*nbodies * sizeof(float));\\n\\n  for (int i = 0; i < *nbodies; ++i) {\\n    (*x)[i] = tmp[i].x;\\n    (*y)[i] = tmp[i].y;\\n    (*z)[i] = tmp[i].z;\\n    (*vx)[i] = tmp[i].vx;\\n    (*vy)[i] = tmp[i].vy;\\n    (*vz)[i] = tmp[i].vz;\\n  }\\n\\n  free(tmp);\\n}\\n\\n/*\\n * Write simulation results into a binary dataset.\\n */\\nvoid write_dataset(const int nbodies,\\n                   float *x, float *y, float *z,\\n                   float *vx, float *vy, float *vz) {\\n  Body *out = (Body *)malloc(nbodies * sizeof(Body));\\n  for (int i = 0; i < nbodies; ++i) {\\n    out[i].x = x[i];\\n    out[i].y = y[i];\\n    out[i].z = z[i];\\n    out[i].vx = vx[i];\\n    out[i].vy = vy[i];\\n    out[i].vz = vz[i];\\n  }\\n\\n  int b = fwrite(out, nbodies * sizeof(Body), 1, stdout);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError writing to output\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n\\n  free(out);\\n}\\n\\nint main(int argc,char **argv) {\\n  int nbodies;\\n  float *x, *y, *z, *vx, *vy, *vz;\\n\\n  read_dataset(&nbodies, &x, &y, &z, &vx, &vy, &vz);\\n\\n  /*\\n   * At each simulation iteration, interbody forces are computed,\\n   * and bodies' positions are integrated.\\n   */\\n  for (int iter = 0; iter < N_ITER; ++iter) {\\n    body_force(x, y, z, vx, vy, vz, DT, nbodies);\\n\\n    for (int i = 0; i < nbodies; ++i) {\\n      x[i] += vx[i] * DT;\\n      y[i] += vy[i] * DT;\\n      z[i] += vz[i] * DT;\\n    }\\n  }\\n\\n  write_dataset(nbodies, x, y, z, vx, vy, vz);\\n\\n  free(x); free(y); free(z);\\n  free(vx); free(vy); free(vz);\\n\\n  exit(EXIT_SUCCESS);\\n}\\n\",\n      \"path\": \"src/nbody.c\"\n    }\n  ],\n  \"hypothesis\": \"Convert data layout from Array-of-Structures to Structure-of-Arrays, apply tiling on both i and j loops with block sizes 4 and 128 respectively, reorder inner loops within each tile to reuse loaded body coordinates across multiple bodies in the i-block, and parallelize over i-blocks using OpenMP. This improves memory locality by reducing cache misses when accessing body data.\",\n  \"notes\": \"Preserves exact floating-point accumulation order per body because all contributions are summed in increasing index order across tiles and within each tile.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"SoA conversion\",\n    \"loop tiling (i-block=4, j-block=128)\",\n    \"inner loop interchange for spatial reuse\",\n    \"OpenMP parallelization\"\n  ]\n}",

      "content": "#define _POSIX_C_SOURCE 200112L\n\n#include \"knn.h\"\n#include <stddef.h>\n\ntypedef struct {\n    float dist;\n    long idx;\n    char label;\n} HeapEntry;\n\nstatic inline int worse_entry(const HeapEntry *a, const HeapEntry *b) {\n    if (a->dist != b->dist) return a->dist > b->dist;\n    return a->idx > b->idx;\n}\n\nstatic inline void swap_entries(HeapEntry *a, HeapEntry *b) {\n    HeapEntry t = *a; *a = *b; *b = t;\n}\n\nstatic inline void sift_up(HeapEntry *heap, int pos) {\n    while (pos > 0) {\n        int parent = (pos - 1) / 2;\n        if (worse_entry(&heap[pos], &heap[parent])) {\n            swap_entries(&heap[pos], &heap[parent]);\n            pos = parent;\n        } else break;\n    }\n}\n\nstatic inline void sift_down(HeapEntry *heap, int start, int end) {\n    int root = start;\n    while (1) {\n        int child = 2 * root + 1;\n        if (child > end) break;\n        int right = child + 1;\n        if (right <= end && worse_entry(&heap[right], &heap[child])) child = right;\n        if (worse_entry(&heap[root], &heap[child])) {\n            swap_entries(&heap[root], &heap[child]);\n            root = child;\n        } else break;\n    }\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    long total = 0;\n    for (int i = 0; i < n_groups; ++i) {\n        total += groups[i].length;\n    }\n\n    // Allocate flattened arrays\n    float *xs = NULL;\n    float *ys = NULL;\n    char *plabels = NULL;\n    if (total > 0) {\n        if (posix_memalign((void **)&xs, 64, total * sizeof(float)) != 0)\n            xs = malloc(total * sizeof(float));\n        if (posix_memalign((void **)&ys, 64, total * sizeof(float)) != 0)\n            ys = malloc(total * sizeof(float));\n        plabels = (char *)malloc(total * sizeof(char));\n    } else {\n        xs = malloc(1);\n        ys = malloc(1);\n        plabels = malloc(1);\n    }\n\n    long idx = 0;\n    for (int gi = 0; gi < n_groups; ++gi) {\n        Group g = groups[gi];\n        char lab = g.label;\n        Point *pts = g.points;\n        int len = g.length;\n        for (int j = 0; j < len; ++j) {\n            xs[idx] = pts[j].x;\n            ys[idx] = pts[j].y;\n            plabels[idx] = lab;\n            ++idx;\n        }\n    }\n\n    // Compute distances in parallel\n    float *dists = NULL;\n    if (total > 0) {\n        if (posix_memalign((void **)&dists, 64, total * sizeof(float)) != 0)\n            dists = malloc(total * sizeof(float));\n    } else {\n        dists = malloc(1);\n    }\n    float tx = to_evaluate.x;\n    float ty = to_evaluate.y;\n\n#pragma omp parallel for simd schedule(static) aligned(xs, ys, dists: 64)\n    for (long p = 0; p < total; ++p) {\n        float dx = xs[p] - tx;\n        float dy = ys[p] - ty;\n        dists[p] = dx * dx + dy * dy;\n    }\n\n    // Build max-heap of k best points\n    HeapEntry *heap = (HeapEntry *)malloc(sizeof(HeapEntry) * (k > 0 ? k : 1));\n    int heap_size = 0;\n\n    for (long p = 0; p < total; ++p) {\n        HeapEntry e;\n        e.dist = dists[p];\n        e.idx = p;\n        e.label = plabels[p];\n\n        if (heap_size < k) {\n            heap[heap_size++] = e;\n            sift_up(heap, heap_size - 1);\n        } else if (!worse_entry(&e, &heap[0])) {\n            heap[0] = e;\n            sift_down(heap, 0, k - 1);\n        }\n    }\n\n    // Build labels array with placeholders for missing points\n    char *labels = (char *)malloc(sizeof(char) * (k > 0 ? k : 1));\n    for (int i = 0; i < k; ++i) {\n        labels[i] = -1;\n    }\n    int n_actual = heap_size < k ? heap_size : k;\n    for (int i = 0; i < n_actual; ++i) {\n        labels[i] = heap[i].label;\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; ++i) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            ++current_frequency;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(xs);\n    free(ys);\n    free(plabels);\n    free(dists);\n    free(heap);\n    free(labels);\n\n    return most_frequent;\n}\n",
      "path": "src/knn.c"
    },
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}\n",
      "path": "src/knn.h"
    }

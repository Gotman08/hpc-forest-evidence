#include <bits/stdc++.h>

using namespace std;
using ll = long long;

ll solve(int pair_dim, int scan_dim, int k, const vector<int>& matrix) {
  vector<ll> sums(scan_dim, 0);
  unordered_map<ll, ll> frequencies;
  frequencies.reserve(scan_dim + 1);
  ll answer = 0;

  for (int top = 0; top < pair_dim; ++top) {
    fill(sums.begin(), sums.end(), 0);
    for (int bottom = top; bottom < pair_dim; ++bottom) {
      const int* row = matrix.data() + static_cast<size_t>(bottom) * scan_dim;
      for (int x = 0; x < scan_dim; ++x)
        sums[x] += row[x];

      frequencies.clear();
      frequencies.emplace(0, 1);
      ll prefix = 0;
      for (int x = 0; x < scan_dim; ++x) {
        prefix += sums[x];
        auto it = frequencies.find(prefix - static_cast<ll>(k));
        if (it != frequencies.end())
          answer += it->second;
        ++frequencies[prefix];
      }
    }
  }
  return answer;
}

int main() {
  ios::sync_with_stdio(false);
  cin.tie(nullptr);

  int k, m, n;
  if (!(cin >> k >> m >> n))
    return 0;

  const int pair_dim = min(m, n);
  const int scan_dim = max(m, n);
  vector<int> matrix(static_cast<size_t>(pair_dim) * scan_dim);

  for (int i = 0; i < m; ++i) {
    for (int j = 0; j < n; ++j) {
      int value;
      cin >> value;
      if (m <= n)
        matrix[static_cast<size_t>(i) * scan_dim + j] = value;
      else
        matrix[static_cast<size_t>(j) * scan_dim + i] = value;
    }
  }

  cout << solve(pair_dim, scan_dim, k, matrix) << '\n';
  return 0;
}

#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <climits>

int main() {
	int n,s;
	std::cin >> n >> s;
	std::vector<std::vector<int> > matrix(n, std::vector<int>(n));
	for(int i=0;i<n;i++)
		for(int j=0;j<n;j++) 
			scanf("%d", &(matrix[i][j]));

	assert(s<n);
	assert(n<8000);
	assert(s>0);
	assert(n>0);

	// Build integral image (prefix sums) using OpenMP work sharing
	std::vector<std::vector<long long>> II(n+1, std::vector<long long>(n+1, 0));

	// Step 1: row-wise prefix sums in parallel over rows (static schedule)
	#pragma omp parallel for schedule(static)
	for (int i = 0; i < n; ++i) {
		long long row_sum = 0;
		for (int j = 0; j < n; ++j) {
			row_sum += matrix[i][j];
			II[i+1][j+1] = row_sum;
		}
	}

	// Step 2: column-wise accumulation to complete integral image (static schedule)
	#pragma omp parallel for schedule(static)
	for (int j = 1; j <= n; ++j) {
		long long col_cum = 0;
		for (int i = 1; i <= n; ++i) {
			col_cum += II[i][j];
			II[i][j] = col_cum;
		}
	}

	// Search all top-left corners using collapsed loops, reduction(max), dynamic scheduling
	long long mxSum = LLONG_MIN;
	#pragma omp parallel for collapse(2) reduction(max:mxSum) schedule(dynamic,1)
	for (int i = 0; i <= n - s; ++i) {
		for (int j = 0; j <= n - s; ++j) {
			long long sum = II[i+s][j+s] - II[i][j+s] - II[i+s][j] + II[i][j];
			if (sum > mxSum) mxSum = sum;
		}
	}

	printf("%lld\n", mxSum);
}

      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <limits>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n\nstatic inline int64x2_t maximum_i64(int64x2_t a, int64x2_t b) {\n    return vbslq_s64(vcgtq_s64(a, b), a, b);\n}\n#endif\n\nstatic inline std::int64_t horizontal_maximum(\n    const std::int64_t* columns, int n, int s) {\n    std::int64_t window = 0;\n    for (int col = 0; col < s; ++col) {\n        window += columns[col];\n    }\n    std::int64_t maximum = window;\n    int col = s;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const int64x2_t zero = vdupq_n_s64(0);\n    int64x2_t carry = vdupq_n_s64(window);\n    int64x2_t maximum0 = carry;\n    int64x2_t maximum1 = carry;\n    int64x2_t maximum2 = carry;\n    int64x2_t maximum3 = carry;\n\n    for (; col + 7 < n; col += 8) {\n        int64x2_t prefix0 = vsubq_s64(\n            vld1q_s64(columns + col),\n            vld1q_s64(columns + col - s));\n        int64x2_t prefix1 = vsubq_s64(\n            vld1q_s64(columns + col + 2),\n            vld1q_s64(columns + col - s + 2));\n        int64x2_t prefix2 = vsubq_s64(\n            vld1q_s64(columns + col + 4),\n            vld1q_s64(columns + col - s + 4));\n        int64x2_t prefix3 = vsubq_s64(\n            vld1q_s64(columns + col + 6),\n            vld1q_s64(columns + col - s + 6));\n\n        // Form eight inclusive delta prefixes with a balanced scan.\n        prefix0 = vaddq_s64(prefix0, vextq_s64(zero, prefix0, 1));\n        prefix1 = vaddq_s64(prefix1, vextq_s64(zero, prefix1, 1));\n        prefix2 = vaddq_s64(prefix2, vextq_s64(zero, prefix2, 1));\n        prefix3 = vaddq_s64(prefix3, vextq_s64(zero, prefix3, 1));\n\n        prefix1 = vaddq_s64(prefix1, vdupq_laneq_s64(prefix0, 1));\n        prefix3 = vaddq_s64(prefix3, vdupq_laneq_s64(prefix2, 1));\n        const int64x2_t lower_total = vdupq_laneq_s64(prefix1, 1);\n        prefix2 = vaddq_s64(prefix2, lower_total);\n        prefix3 = vaddq_s64(prefix3, lower_total);\n\n        prefix0 = vaddq_s64(prefix0, carry);\n        prefix1 = vaddq_s64(prefix1, carry);\n        prefix2 = vaddq_s64(prefix2, carry);\n        prefix3 = vaddq_s64(prefix3, carry);\n        carry = vdupq_laneq_s64(prefix3, 1);\n\n        maximum0 = maximum_i64(maximum0, prefix0);\n        maximum1 = maximum_i64(maximum1, prefix1);\n        maximum2 = maximum_i64(maximum2, prefix2);\n        maximum3 = maximum_i64(maximum3, prefix3);\n    }\n\n    const int64x2_t maxima = maximum_i64(\n        maximum_i64(maximum0, maximum1),\n        maximum_i64(maximum2, maximum3));\n    const std::int64_t lane0 = vgetq_lane_s64(maxima, 0);\n    const std::int64_t lane1 = vgetq_lane_s64(maxima, 1);\n    maximum = lane0 > lane1 ? lane0 : lane1;\n    window = vgetq_lane_s64(carry, 0);\n#endif\n\n    for (; col < n; ++col) {\n        window += columns[col] - columns[col - s];\n        if (window > maximum) maximum = window;\n    }\n    return maximum;\n}\n\nint main() {\n    int n, s;\n    if (!(std::cin >> n >> s)) return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    std::vector<int> matrix(static_cast<std::size_t>(n) * n);\n    for (std::size_t index = 0; index < matrix.size(); ++index) {\n        std::scanf(\"%d\", &matrix[index]);\n    }\n\n    std::vector<std::int64_t> column_sums(n, 0);\n    std::int64_t* const columns = column_sums.data();\n\n    for (int row = 0; row < s; ++row) {\n        const int* const values = matrix.data()\n            + static_cast<std::size_t>(row) * n;\n#if defined(__GNUC__)\n#pragma GCC ivdep\n#endif\n        for (int col = 0; col < n; ++col) {\n            columns[col] += static_cast<std::int64_t>(values[col]);\n        }\n    }\n\n    std::int64_t maximum = std::numeric_limits<std::int64_t>::lowest();\n    const int last_top = n - s;\n    for (int top = 0; top <= last_top; ++top) {\n        if (top != 0) {\n            const int* const incoming = matrix.data()\n                + static_cast<std::size_t>(top + s - 1) * n;\n            const int* const outgoing = matrix.data()\n                + static_cast<std::size_t>(top - 1) * n;\n#if defined(__GNUC__)\n#pragma GCC ivdep\n#endif\n            for (int col = 0; col < n; ++col) {\n                columns[col] += static_cast<std::int64_t>(incoming[col])\n                    - static_cast<std::int64_t>(outgoing[col]);\n            }\n        }\n\n        const std::int64_t row_maximum = horizontal_maximum(columns, n, s);\n        if (row_maximum > maximum) maximum = row_maximum;\n    }\n\n    std::printf(\"%lld\\n\", static_cast<long long>(maximum));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "An eight-window ARM64 NEON prefix scan can shorten the horizontal rolling-sum dependency chain and improve throughput while preserving exact 64-bit results.",

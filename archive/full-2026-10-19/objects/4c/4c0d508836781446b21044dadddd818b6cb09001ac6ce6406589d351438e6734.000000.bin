+class ColdCopyBoundaryNeutral(unittest.TestCase):
+    """Real tiny new files/handles only; no mocked content-reader or live data."""
+    @classmethod
+    def setUpClass(cls):
+        raw=receiver.PHASE1.read_bytes()
+        if receiver.sha(raw)!=receiver.PHASE1_SHA:
+            raise ValueError('Exact ordinary-path source required')
+        nodes=[n for n in ast.parse(raw).body if isinstance(n,ast.FunctionDef) and n.name in {'need','ordinary_path'}]
+        if {n.name for n in nodes}!={'need','ordinary_path'}:
+            raise ValueError('Exact ordinary-path definitions missing')
+        namespace={'Path':Path,'stat':stat,'BASE':receiver.BASE}
+        exec(compile(ast.Module(body=nodes,type_ignores=[]),'<qualified-ordinary-path-only>','exec'),namespace)
+        cls.ordinary=staticmethod(namespace['ordinary_path'])
+
+    def setUp(self):
+        if os.name!='nt':
+            raise ValueError('Real Windows native FileID tests required; no skip/fallback')
+        self.temp=tempfile.TemporaryDirectory(prefix='ROOT-INERT-copy-boundary-',dir=HERE)
+        self.addCleanup(self.temp.cleanup)
+        self.boundary=Path(self.temp.name)
+        self.sources=self.boundary/'sources';self.sources.mkdir()
+        self.copies=self.boundary/'cold-copies';self.copies.mkdir()
+        self.specs=[]
+        for label,name in [('routes','ROUTES-OBS4.json'),('state','observer-state.json'),('stdout.log','stdout.log'),('stderr.log','stderr.log')]:
+            source=self.sources/name;source.write_bytes(b'')
+            target=self.copies/('cold-'+name+'.txt');target.write_bytes(b'')
+            self.specs.append({'label':label,'source':source,'copy':target})
+
+    def lease(self):
+        return receiver.HeldDistinctColdCopies(self.specs,self.ordinary,source_boundary=self.boundary,copy_boundary=self.boundary)
+
+    def test_equal_source_log_path_refuses_before_payload(self):
+        self.specs[2]['copy']=self.specs[2]['source']
+        with self.assertRaises(ValueError):
+            with self.lease():self.fail('Payload-read stage must be unreachable')
+
+    def test_equal_routes_path_refuses_before_payload(self):
+        self.specs[0]['copy']=self.specs[0]['source']
+        with self.assertRaises(ValueError):
+            with self.lease():self.fail('Payload-read stage must be unreachable')
+
+    def test_equal_state_path_refuses_before_payload(self):
+        self.specs[1]['copy']=self.specs[1]['source']
+        with self.assertRaises(ValueError):
+            with self.lease():self.fail('Payload-read stage must be unreachable')
+
+    def test_windows_active_basename_aliases_refuse_before_metadata(self):
+        for name in ('STDOUT.LOG','StDeRr.LoG','OBSERVER.LOCK','WORKER.LOCK','ROUTES-OBS4.JSON','OBSERVER-STATE.JSON','stdout.log.','worker.lock '):
+            with self.subTest(name=name),self.assertRaises(ValueError):
+                receiver.cold_copy_name(self.copies/name)
+
+    def test_hardlink_to_source_refuses_before_payload(self):
+        target=self.specs[2]['copy'];target.unlink();os.link(self.specs[2]['source'],target)
+        with self.assertRaises(ValueError):
+            with self.lease():self.fail('Hardlink payload-read stage must be unreachable')
+
+    def test_two_copy_roles_same_file_refuse_before_payload(self):
+        self.specs[3]['copy']=self.specs[2]['copy']
+        with self.assertRaises(ValueError):
+            with self.lease():self.fail('Aliased payload-read stage must be unreachable')
+
+    def test_distinct_files_remain_held_and_metadata_stable(self):
+        with self.lease() as held:
+            facts=held.evidence()
+            self.assertIs(facts['metadata_source_bytes_read'],False)
+            self.assertEqual(facts['source_and_copy_native_metadata_before'],facts['source_and_copy_native_metadata_after'])
+            self.assertEqual(len({(x['volume_serial'],x['file_id128']) for x in held.before}),8)
+
+    def test_live_source_writer_handle_is_metadata_only(self):
+        with self.specs[2]['source'].open('ab'):
+            with self.lease() as held:
+                self.assertIs(held.evidence()['source_metadata_only'],True)
+
+    def test_copy_write_is_denied_while_held(self):
+        with self.lease() as held:
+            with self.assertRaises(PermissionError):
+                with self.specs[2]['copy'].open('ab') as stream:stream.write(b'INERT')
+            held.verify_unchanged()
+
+    def test_source_replacement_is_denied_while_held(self):
+        with self.lease() as held:
+            with self.assertRaises(PermissionError):self.specs[2]['source'].unlink()
+            held.verify_unchanged()
+
+

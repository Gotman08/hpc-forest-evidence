+def cold_copy_name(path):
+    # Windows aliases are closed before any metadata or content access.
+    path = Path(path)
+    need(path.name.rstrip(' .').casefold() not in
+         {'observer-state.json','stdout.log','stderr.log','observer.lock','worker.lock','routes-obs4.json'},
+         'Cold copy cannot use any live state/log/lock/routes basename')
+    return path
+
+
+def cold_copy_specs(documents, refs):
+    """Validate receipt bindings before any of the four copy payloads is read."""
+    specs = []
+    for label, source_path, copy_ref in (
+            ('routes', documents['start_intent']['routes']['path'], refs['routes_initial_copy']),
+            ('state', str(CHAIN/'observer/observer-state.json'), refs['cold_state'])):
+        receipt = documents['routes_initial_copy_receipt' if label == 'routes' else 'cold_state_receipt']
+        need(receipt.get('schema') == 'hpc-forest-r8-ROOT-byte-exact-cold-copy-v1'
+             and receipt.get('source_before') == receipt.get('source_after')
+             and receipt.get('source_before',{}).get('path') == source_path
+             and receipt.get('source_before',{}).get('sha256') == copy_ref['sha256']
+             and receipt.get('copy') == copy_ref and receipt.get('two_source_reads_equal_copy') is True
+             and receipt.get('live_source_read_by_ROOT_only') is True,
+             'Stable ROOT state/routes copy metadata required before copy bytes')
+        specs.append({'label':label, 'source':Path(source_path), 'copy':cold_copy_name(copy_ref['path'])})
+    logs = documents['cold_logs_receipt']
+    need(logs.get('schema') == 'hpc-forest-r8-ROOT-two-cold-log-copies-v1'
+         and isinstance(logs.get('copies'),list) and len(logs['copies']) == 2,
+         'Actual two cold log copy receipts required before bytes')
+    for item, name in zip(logs['copies'], ('stdout.log','stderr.log')):
+        source_path = documents['start_observed']['stdout' if name == 'stdout.log' else 'stderr']
+        need(item.get('source_before') == item.get('source_after')
+             and item.get('source_before',{}).get('path') == source_path
+             and Path(source_path).name == name
+             and item['source_before'].get('sha256') == item.get('copy',{}).get('sha256')
+             and item.get('two_source_reads_equal_copy') is True,
+             'Stable ROOT log copy metadata required before copy bytes')
+        specs.append({'label':name, 'source':Path(source_path), 'copy':cold_copy_name(item['copy']['path'])})
+    need(all(spec['source'] != spec['copy'] for spec in specs),
+         'Live source and cold copy must be canonically distinct before bytes')
+    return specs
+
+
+class HeldDistinctColdCopies:
+    """Metadata-only source handles; held, distinct, single-link copies before raw.
+
+    No ReadFile/read/open-data operation exists in this class. Source handles
+    admit concurrent writers but exclude replacement; copy handles exclude both
+    WRITE and DELETE sharing until every qualified no-follow payload read ends.
+    """
+    def __init__(self, specs, ordinary_path, *, source_boundary=BASE, copy_boundary=OBS):
+        self.specs, self.ordinary_path = specs, ordinary_path
+        self.source_boundary, self.copy_boundary = source_boundary, copy_boundary
+        self.handles, self.directory_handles, self.before = [], [], []
+
+    def _info(self, handle):
+        c = self.ctypes
+        tag = (self.wintypes.DWORD * 2)()
+        need(self.query(handle, 9, c.byref(tag), c.sizeof(tag))
+             and not tag[0] & (0x10 | 0x400) and tag[1] == 0,
+             'Held cold-copy/source metadata is not an ordinary non-reparse file')
+        identity = self.FileIdInfo()
+        standard = self.StandardInfo()
+        basic = self.BasicInfo()
+        need(self.query(handle, 18, c.byref(identity), c.sizeof(identity))
+             and self.query(handle, 1, c.byref(standard), c.sizeof(standard))
+             and self.query(handle, 0, c.byref(basic), c.sizeof(basic))
+             and not standard.Directory and not standard.DeletePending,
+             'Exact held FileID/native metadata query required; no fallback')
+        file_id = bytes(identity.FileId).hex()
+        need(identity.VolumeSerialNumber != 0 and file_id != '00'*16,
+             'Nonzero full Windows VolumeSerial/FileID128 required')
+        return {'volume_serial':int(identity.VolumeSerialNumber), 'file_id128':file_id,
+                'links':int(standard.NumberOfLinks), 'bytes':int(standard.EndOfFile),
+                'allocation_bytes':int(standard.AllocationSize), 'attributes':int(basic.FileAttributes),
+                'creation_ticks':int(basic.CreationTime), 'write_ticks':int(basic.LastWriteTime),
+                'change_ticks':int(basic.ChangeTime), 'reparse_tag':int(tag[1])}
+
+    def _hold_parents(self, path):
+        # Parent handles also exclude DELETE: a held child is never reached
+        # through a renamed/reparse-substituted directory during raw's read.
+        for parent in reversed(path.parents):
+            if any(previous == parent for previous,_ in self.directory_handles):
+                continue
+            handle = self.create(str(parent),0x80,0x1 | 0x2,None,3,0x00200000 | 0x02000000,None)
+            need(handle not in (None,self.ctypes.c_void_p(-1).value), 'Cannot hold ordinary source/copy parent')
+            self.directory_handles.append((parent,handle))
+            tag = (self.wintypes.DWORD * 2)()
+            need(self.query(handle,9,self.ctypes.byref(tag),self.ctypes.sizeof(tag))
+                 and tag[0] & 0x10 and not tag[0] & 0x400 and tag[1] == 0,
+                 'Source/copy parent must remain an ordinary held directory')
+
+    def _hold(self, path, *, is_copy):
+        path = self.ordinary_path(path, beneath=self.copy_boundary if is_copy else self.source_boundary)
+        self._hold_parents(path)
+        self.ordinary_path(path,beneath=self.copy_boundary if is_copy else self.source_boundary)
+        facts = path.lstat()
+        need(stat.S_ISREG(facts.st_mode), 'Ordinary source/copy metadata required')
+        # FILE_READ_ATTRIBUTES only: source bytes are never opened for reading.
+        handle = self.create(str(path), 0x80, 0x1 if is_copy else 0x1 | 0x2,
+                             None, 3, 0x00200000, None)
+        need(handle not in (None, self.ctypes.c_void_p(-1).value), 'Cannot hold source/copy metadata without replacement')
+        self.handles.append((path,handle,is_copy))
+        info = self._info(handle)
+        need(not is_copy or info['links'] == 1, 'Cold copy hardlink refused before payload read')
+        return info
+
+    def __enter__(self):
+        need(os.name == 'nt', 'Windows held source/copy identity boundary required')
+        import ctypes
+        from ctypes import wintypes
+        self.ctypes, self.wintypes = ctypes, wintypes
+        class FileIdInfo(ctypes.Structure):
+            _fields_ = [('VolumeSerialNumber',ctypes.c_ulonglong), ('FileId',ctypes.c_ubyte*16)]
+        class StandardInfo(ctypes.Structure):
+            _fields_ = [('AllocationSize',ctypes.c_longlong),('EndOfFile',ctypes.c_longlong),
+                        ('NumberOfLinks',wintypes.DWORD),('DeletePending',ctypes.c_ubyte),('Directory',ctypes.c_ubyte)]
+        class BasicInfo(ctypes.Structure):
+            _fields_ = [('CreationTime',ctypes.c_longlong),('LastAccessTime',ctypes.c_longlong),
+                        ('LastWriteTime',ctypes.c_longlong),('ChangeTime',ctypes.c_longlong),('FileAttributes',wintypes.DWORD)]
+        self.FileIdInfo, self.StandardInfo, self.BasicInfo = FileIdInfo, StandardInfo, BasicInfo
+        kernel = ctypes.WinDLL('kernel32',use_last_error=True)
+        self.create = kernel.CreateFileW
+        self.create.argtypes = [wintypes.LPCWSTR,wintypes.DWORD,wintypes.DWORD,ctypes.c_void_p,wintypes.DWORD,wintypes.DWORD,wintypes.HANDLE]
+        self.create.restype = wintypes.HANDLE
+        self.query = kernel.GetFileInformationByHandleEx
+        self.query.argtypes = [wintypes.HANDLE,ctypes.c_int,ctypes.c_void_p,wintypes.DWORD]
+        self.query.restype = wintypes.BOOL
+        self.close = kernel.CloseHandle
+        self.close.argtypes, self.close.restype = [wintypes.HANDLE],wintypes.BOOL
+        try:
+            need(len(self.specs) == 4 and {s['label'] for s in self.specs} == {'routes','state','stdout.log','stderr.log'},
+                 'Exact four cold copy roles required')
+            sources, copies = [], []
+            for spec in self.specs:
+                cold_copy_name(spec['copy'])
+                need(spec['source'] != spec['copy'], 'Live source and cold copy must be distinct before bytes')
+                sources.append(self._hold(spec['source'],is_copy=False))
+            for spec in self.specs:
+                copies.append(self._hold(spec['copy'],is_copy=True))
+            key = lambda info:(info['volume_serial'],info['file_id128'])
+            need(len({key(info) for info in sources}) == 4
+                 and len({key(info) for info in copies}) == 4
+                 and not {key(info) for info in sources}.intersection(key(info) for info in copies),
+                 'Source/copy FileIDs alias or repeat; refuse before first payload byte')
+            self.before = [self._info(handle) for _,handle,_ in self.handles]
+            return self
+        except BaseException:
+            self.__exit__(None,None,None)
+            raise
+
+    def verify_unchanged(self):
+        after = [self._info(handle) for _,handle,_ in self.handles]
+        need(after == self.before, 'Held source/copy full native metadata changed')
+        for path,_,is_copy in self.handles:
+            self.ordinary_path(path,beneath=self.copy_boundary if is_copy else self.source_boundary)
+        return after
+
+    def evidence(self):
+        after = self.verify_unchanged()
+        return {'metadata_source_bytes_read':False,'source_metadata_only':True,
+                'copy_file_IDs_distinct_from_all_four_sources':True,'copies_single_link':True,
+                'copy_WRITE_and_DELETE_sharing_excluded':True,
+                'source_and_copy_native_metadata_before':self.before,
+                'source_and_copy_native_metadata_after':after}
+
+    def __exit__(self,*_args):
+        for _,handle,_ in reversed(self.handles):
+            self.close(handle)
+        self.handles.clear()
+        for _,handle in reversed(self.directory_handles):
+            self.close(handle)
+        self.directory_handles.clear()
+
+

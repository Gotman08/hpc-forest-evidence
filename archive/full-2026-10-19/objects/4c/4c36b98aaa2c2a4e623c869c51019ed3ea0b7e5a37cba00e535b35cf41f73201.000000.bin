"""Read-only receipt for one explicitly referenced future R4b technical phase.

This is not an admission builder, a cache/cohort census, or a performance audit.
Nothing is executed and no receipt is written. Invalid evidence raises ReceiptError.
"""
from __future__ import annotations

import hashlib
import importlib
import importlib.util
import json
import math
import re
import sys
from datetime import datetime
from pathlib import Path

NORMALISATION_SHA = '46662bde26ff2fd68b7ce6bbe7217e492a98ab34cbb7aff08a53324755b74da7'

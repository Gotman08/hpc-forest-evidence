    raise RuntimeError('Changed isolated normalization module')
_normal_spec = importlib.util.spec_from_file_location('isolated_normalisation_r3', _normal_path)
normalisation = importlib.util.module_from_spec(_normal_spec)
_normal_spec.loader.exec_module(normalisation)
SUPPORTED_CONTRACT_SESSIONS = {'gpt-6.1-sol': {'roots': '3b1de5658e4641149b15a3bea4850239', 'advice': 'b86d18fcf35d4031aa2ef0da49397c4e', 'harvest': '7c8bc0c5ae22467da05600fb735fc017'}, 'gpt-6-astra': {'roots': '7b6c29c0e329400bb2be145b0e2dbe0a', 'advice': '7be16898433e49f4b481045079abbbe8', 'harvest': 'b6fc9cf3951d46d787f319b51905251b'}, 'gpt-5.6-terra': {'roots': 'bd2b3153a7544c909afbc19fe69902b4', 'advice': '7516e40883c64ab8af8a38637d74de3f', 'harvest': '7d6f357d4e5741bb8349835f358563b2'}}
WORKER_CACHE_PARENT = Path(__file__).parent.parent / 'lancement-modeles-max-r2'

SCOPE = "hpc-forest-dynamic-independent-roots-r4b-max"
SOURCE_SHA = "ede293f185e663241c01c22a5fa9edcd54ad66af6a1e0964755eac306c5de0f3"
PLAN_SHA = "9f04e93c1a28c70f444005b7670ff23731cac838846b99cb1b6742db9e8de33b"

      "content": "#include \"knn.h\"\n#include <omp.h>\n#include <string.h>\n\ntypedef struct {\n    float dist;\n    int idx;\n    char label;\n} Candidate;\n\nstatic int compare_cand(const void *a, const void *b) {\n    const Candidate *ca = (const Candidate *)a;\n    const Candidate *cb = (const Candidate *)b;\n    if (ca->dist < cb->dist) return -1;\n    if (ca->dist > cb->dist) return 1;\n    if (ca->idx < cb->idx) return -1;\n    if (ca->idx > cb->idx) return 1;\n    return 0;\n}\n\nstatic char* read_all_input(size_t *out_len) {\n    size_t cap = 1 << 20; // 1 MB initial buffer\n    char *buf = (char *)malloc(cap);\n    if (!buf) on_error();\n    size_t used = 0;\n    int n;\n    while ((n = fread(buf + used, 1, cap - used, stdin)) > 0) {\n        used += n;\n        if (used == cap) {\n            cap *= 2;\n            char *tmp = (char *)realloc(buf, cap);\n            if (!tmp) { free(buf); on_error(); }\n            buf = tmp;\n        }\n    }\n    buf[used] = '\\0';\n    *out_len = used;\n    return buf;\n}\n\nint main() {\n    size_t input_len;\n    char *input = read_all_input(&input_len);\n    char *ptr = input;\n    int consumed;\n\n    int n_groups;\n    if (sscanf(ptr, \" n_groups=%d%n\", &n_groups, &consumed) != 1) on_error();\n    ptr += consumed;\n\n    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);\n    for (int i = 0; i < n_groups; i++) {\n        char label;\n        int length;\n        if (sscanf(ptr, \" label=%c%n\", &label, &consumed) != 1) on_error();\n        ptr += consumed;\n        if (sscanf(ptr, \" length=%d%n\", &length, &consumed) != 1) on_error();\n        ptr += consumed;\n\n        groups[i].label = label;\n        groups[i].length = length;\n        groups[i].points = (Point *)malloc(sizeof(Point) * length);\n\n        for (int j = 0; j < length; j++) {\n            float x, y;\n            if (sscanf(ptr, \" (%f ,%f)%n\", &x, &y, &consumed) != 2) on_error();\n            ptr += consumed;\n            groups[i].points[j].x = x;\n            groups[i].points[j].y = y;\n        }\n    }\n\n    int k;\n    if (sscanf(ptr, \" k=%d%n\", &k, &consumed) != 1) on_error();\n    ptr += consumed;\n\n    Point to_evaluate;\n    float px, py;\n    if (sscanf(ptr, \" (%f ,%f)%n\", &px, &py, &consumed) != 2) on_error();\n    to_evaluate.x = px;\n    to_evaluate.y = py;\n\n    free(input);\n\n    // Flatten all points into contiguous arrays for efficient parallel iteration.\n    int total_points = 0;\n    for (int i = 0; i < n_groups; i++) {\n        total_points += groups[i].length;\n    }\n\n    float *xs = (float *)malloc(sizeof(float) * total_points);\n    float *ys = (float *)malloc(sizeof(float) * total_points);\n    char *point_labels = (char *)malloc(sizeof(char) * total_points);\n\n    int idx = 0;\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            xs[idx] = g.points[j].x;\n            ys[idx] = g.points[j].y;\n            point_labels[idx] = g.label;\n            idx++;\n        }\n    }\n\n    // Free group storage now that points are flattened.\n    for (int i = 0; i < n_groups; i++) {\n        free(groups[i].points);\n    }\n    free(groups);\n\n    int nthreads;\n    float **all_dist;\n    char **all_lab;\n    int **all_idx;\n\n    #pragma omp parallel\n    {\n        #pragma omp single\n        {\n            nthreads = omp_get_num_threads();\n            all_dist = (float **)malloc(sizeof(float *) * nthreads);\n            all_lab = (char **)malloc(sizeof(char *) * nthreads);\n            all_idx = (int **)malloc(sizeof(int *) * nthreads);\n        }\n\n        int tid = omp_get_thread_num();\n\n        // Private top-k arrays for this thread.\n        float *local_dist = (float *)malloc(sizeof(float) * k);\n        char *local_lab = (char *)malloc(sizeof(char) * k);\n        int *local_idx = (int *)malloc(sizeof(int) * k);\n\n        for (int j = 0; j < k; j++) {\n            local_dist[j] = -1.0f;\n            local_lab[j] = -1;\n            local_idx[j] = -1;\n        }\n\n        #pragma omp for schedule(static)\n        for (int i = 0; i < total_points; i++) {\n            float dx = xs[i] - to_evaluate.x;\n            float dy = ys[i] - to_evaluate.y;\n            float d = dx * dx + dy * dy;\n\n            int pos = -1;\n            for (int x = 0; x < k; x++) {\n                if (d < local_dist[x] || local_dist[x] == -1.0f) {\n                    pos = x;\n                    break;\n                }\n            }\n\n            if (pos != -1) {\n                for (int y = k - 1; y > pos; y--) {\n                    local_dist[y] = local_dist[y - 1];\n                    local_lab[y] = local_lab[y - 1];\n                    local_idx[y] = local_idx[y - 1];\n                }\n                local_dist[pos] = d;\n                local_lab[pos] = point_labels[i];\n                local_idx[pos] = i;\n            }\n        }\n\n        // Publish this thread's results.\n        all_dist[tid] = local_dist;\n        all_lab[tid] = local_lab;\n        all_idx[tid] = local_idx;\n    } // implicit barrier after parallel region\n\n    // Merge per-thread candidate lists deterministically by (distance, original index).\n    int total_candidates = 0;\n    Candidate *cands = (Candidate *)malloc(sizeof(Candidate) * nthreads * k);\n    for (int t = 0; t < nthreads; t++) {\n        float *dist_arr = all_dist[t];\n        char *lab_arr = all_lab[t];\n        int *idx_arr = all_idx[t];\n        for (int j = 0; j < k; j++) {\n            if (dist_arr[j] != -1.0f) {\n                cands[total_candidates].dist = dist_arr[j];\n                cands[total_candidates].label = lab_arr[j];\n                cands[total_candidates].idx = idx_arr[j];\n                total_candidates++;\n            }\n        }\n    }\n\n    qsort(cands, total_candidates, sizeof(Candidate), compare_cand);\n\n    // Take the first k labels.\n    char *final_labels = (char *)malloc(sizeof(char) * k);\n    int take = k < total_candidates ? k : total_candidates;\n    for (int i = 0; i < take; i++) {\n        final_labels[i] = cands[i].label;\n    }\n    // Fill any remaining slots with -1 to match the sequential initialization.\n    for (int i = take; i < k; i++) {\n        final_labels[i] = -1;\n    }\n\n    qsort(final_labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = final_labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (final_labels[i] != final_labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = final_labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = final_labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    printf(\"%c\", most_frequent);\n\n    // Cleanup.\n    for (int t = 0; t < nthreads; t++) {\n        free(all_dist[t]);\n        free(all_lab[t]);\n        free(all_idx[t]);\n    }\n    free(all_dist);\n    free(all_lab);\n    free(all_idx);\n    free(cands);\n    free(final_labels);\n    free(xs);\n    free(ys);\n    free(point_labels);\n\n    return 0;\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Using a custom buffered parser and OpenMP static work sharing over flattened points with per-thread top-k arrays and deterministic merge will reduce runtime significantly while preserving exact output semantics.",
  "notes": "The implementation reads the entire input into memory, flattens all points into contiguous arrays, then parallelizes distance computation and top-k insertion using a static schedule. Each thread maintains its own sorted candidate list; merging by (distance, original index) preserves the sequential tie-breaking rule exactly. The code assumes compilation with -fopenmp.",

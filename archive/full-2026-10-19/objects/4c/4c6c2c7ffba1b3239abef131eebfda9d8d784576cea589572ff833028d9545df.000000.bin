      "content": "#include <iostream>\n#include <string>\n#include <map>\n#include <list>\n#include <queue>\n#include <climits>\n#include <vector>\n#include <cstdio>\n#include <cstddef>\n\nusing namespace std;\n\nint nCores = 0;\nint nVertices = 0;\nint nArestas = 0;\nint no_of_vert = 0;\nint contCor = 0;\n\nvector<int> caminhoTropical;\nvector<int> caminho;\nvector<pair<int, int>> arvoreGeradora;\n\nstruct part\n{\n    vector<pair<int, int>> spanning;\n    vector<pair<int, int>> inc_ed;\n    vector<pair<int, int>> exc_ed;\n};\n\nvector<part> partitions;\nvector<pair<int, int>> current_span;\n\nclass graph{\n\tpublic:\n\t    int Vertex;\n\t    vector<vector<int>> adj_mat;\n\t    vector<int> cores;\n\t    \n\t    graph(int vertex)\n\t    {\n\t    \tVertex = vertex;\n\t        for(int i = 0; i < Vertex; i++){\n\t        \tvector<int> aux;\n\t            for(int j = 0; j < Vertex; j++){\n\t                aux.push_back(0);\n\t\t\t\t}\n\t\t\t\tadj_mat.push_back(aux);\n            }\n\t                \n\t        for(int i = 0; i < Vertex; i++)\n\t           cores.push_back(0);\n\t    }\n\t    \n\t    void add_edge(int u, int v)\n\t    {\n\t        adj_mat[u][v] = adj_mat[v][u] = 1;\n\t    }\n};\n\nint find_min_key(const vector<int>& arr, int V,\n                 const vector<unsigned char>& mstset)\n{\n    const int* values = arr.data();\n    const unsigned char* selected = mstset.data();\n    int min_key = INT_MAX;\n#if defined(_OPENMP) && _OPENMP >= 201307\n#pragma omp simd reduction(min:min_key)\n#endif\n    for(int i = 0; i < V; i++)\n    {\n        const int candidate = selected[i] ? INT_MAX : values[i];\n        if(candidate < min_key)\n            min_key = candidate;\n    }\n    if(min_key == INT_MAX)\n        return -1;\n\n    // A separate index reduction preserves the first-index tie break.\n    int min_index = V;\n#if defined(_OPENMP) && _OPENMP >= 201307\n#pragma omp simd reduction(min:min_index)\n#endif\n    for(int i = 0; i < V; i++)\n    {\n        const int candidate = (!selected[i] && values[i] == min_key) ? i : V;\n        if(candidate < min_index)\n            min_index = candidate;\n    }\n    return min_index;\n}\n\nstruct CycleWorkspace\n{\n    vector<unsigned int> seen;\n    vector<int> parent;\n    vector<int> pending;\n    unsigned int epoch;\n\n    explicit CycleWorkspace(int V)\n        : seen(V, 0u), parent(V), pending(V), epoch(0u)\n    {\n    }\n};\n\nbool is_cycle(const vector<vector<int>>& mat, int src, int V,\n              CycleWorkspace& workspace)\n{\n    // A fresh epoch isolates every query, including queries that return early.\n    ++workspace.epoch;\n    if(workspace.epoch == 0u)\n    {\n        for(std::size_t i = 0; i < workspace.seen.size(); ++i)\n            workspace.seen[i] = 0u;\n        workspace.epoch = 1u;\n    }\n\n    const unsigned int epoch = workspace.epoch;\n    unsigned int* seen = workspace.seen.data();\n    int* parent = workspace.parent.data();\n    int* pending = workspace.pending.data();\n    int head = 0;\n    int tail = 1;\n    parent[src] = src;\n    seen[src] = epoch;\n    pending[0] = src;\n\n    while(head < tail)\n    {\n        const int node = pending[head++];\n        const int* row = mat[node].data();\n        const int node_parent = parent[node];\n        int cycle = 0;\n        int new_neighbor = 0;\n\n        // Distinct columns cannot change each other's visited test.\n        // Classify the row before performing any queue or visitation updates.\n#if defined(_OPENMP) && _OPENMP >= 201307\n#pragma omp simd reduction(|:cycle,new_neighbor)\n#endif\n        for(int i = 0; i < V; ++i)\n        {\n            const int has_edge = row[i] > 0;\n            const int already_seen = seen[i] == epoch;\n            cycle |= has_edge & already_seen & (i != node_parent);\n            new_neighbor |= has_edge & !already_seen;\n        }\n        if(cycle)\n            return true;\n\n        // Keep dependency-carrying updates scalar and in original column order.\n        if(new_neighbor)\n        {\n            for(int i = 0; i < V; ++i)\n            {\n                if(row[i] > 0 && seen[i] != epoch)\n                {\n                    pending[tail++] = i;\n                    seen[i] = epoch;\n                    parent[i] = node;\n                }\n            }\n        }\n    }\n    return false;\n}\n\nint Prim_ST(const graph& G, const vector<pair<int,int>>& include_edges,\n            const vector<pair<int,int>>& exclude_edges)\n{\n    int V = G.Vertex;\n    CycleWorkspace cycle_workspace(V);\n\t           \n    vector<vector<int>> new_mat;\n    vector<vector<int>> mat_cycle;\n    \n    for(int i = 0; i < V; i++){\n    \tvector<int> aux;\n        for(int j = 0; j < V; j++){\n            aux.push_back(0);\n\t\t}\n\t\tmat_cycle.push_back(aux);\n    }\n    \n    for(int i = 0; i < V; i++){\n    \tvector<int> aux;\n        for(int j = 0; j < V; j++){\n            aux.push_back(G.adj_mat[i][j]);\n\t\t}\n\t\tnew_mat.push_back(aux);\n    }\n    \n    int u1,v1;\n    for(vector<pair<int, int>>::const_iterator it=exclude_edges.begin(); it!=exclude_edges.end();it++)\n    {\n        u1=(*it).first;\n        v1=(*it).second;\n        new_mat[u1][v1]=new_mat[v1][u1]=INT_MIN;\n    }\n    \n    int parent[V];\n    vector<int> key(V);\n    vector<unsigned char> mstset(V);\n    for(int i=0;i<V;i++)\n    {\n        key[i]=INT_MAX;\n        mstset[i]=false;\n        parent[i]=nVertices;\n    }\n    \n    int root;\n    root= 0;\n    parent[root]=-1;\n    \n    int vertex_must_include[V];\n    map<int, int> parent_included_vertex;\n    \n    for(int m=0;m<V;m++)\n        vertex_must_include[m]=false;\n    if(!include_edges.empty())\n    {\n        for(vector<pair<int, int>>::const_iterator it=include_edges.begin(); it!=include_edges.end();it++)\n        {\n            u1=(*it).first;\n            v1=(*it).second;\n            vertex_must_include[u1]=vertex_must_include[v1]=true;\n            parent_included_vertex[v1]=u1;\n            parent_included_vertex[u1]=100;\n        }\n    }\n    \n    key[root]=0;\n    parent[root]=-1;\n    for(int c=0;c<V;c++)\n    {\n        int u=find_min_key(key, V, mstset);\n        if(u==-1) //desconectado\n        {\n            return -1;\n        }\n        mstset[u]=true;\n        if(parent[u] > 0)\n        \tmat_cycle[parent[u]][u]=new_mat[parent[u]][u];\n        no_of_vert++;\n        for(int v=0;v<V;v++)\n        {\n            if(new_mat[u][v]>0 && mstset[v]==false && new_mat[u][v]< key[v])\n            {\n                \n                if(vertex_must_include[v] && parent_included_vertex[v]!=100 && parent_included_vertex[v]!=u)\n                {\n                    int x=parent_included_vertex[v];\n                    if(parent[x]!=nVertices)\n                        continue;\n                }\n                //para verificar se o ciclo se formou ou n?o\n                int prev=mat_cycle[u][v];\n                mat_cycle[u][v]=new_mat[u][v];\n                \n                bool cycle=is_cycle(mat_cycle, root, V, cycle_workspace);\n                if(!cycle)\n                {\n                    parent[v]=u;\n                    key[v]=new_mat[u][v];\n                }\n                mat_cycle[u][v]=prev;\n            }\n        }\n    }\n    \n    int tot_cost=0;\n    for(int i=1;i<V;i++){\n        int x=parent[i];\n        tot_cost+=new_mat[x][i];\n        current_span.push_back(make_pair(x, i));\n    }\n    return tot_cost;\n}\n\nvoid exibirVetor(const vector<int>& l)\n{\n    for(auto i: l)\n    {\n    \tif(i == l.back())\n    \t\tcout<<i;\n    \telse\n        \tcout<<i<<\"-\";\n    }\n    cout<<endl;\n}\n\nbool buscaSequencial(const vector<int>& l, int ch){\n    const int* values = l.data();\n    const std::size_t count = l.size();\n    int found = 0;\n#if defined(_OPENMP) && _OPENMP >= 201307\n#pragma omp simd reduction(|:found)\n#endif\n    for(std::size_t i = 0; i < count; i++)\n        found |= (values[i] == ch);\n    return found != 0;\n}\n\nvector<int> buscaAresta(int vert){\n\tvector<int> aux;\n\tfor(std::vector<std::pair<int, int>>::iterator it = arvoreGeradora.begin(); it != arvoreGeradora.end(); it++){\n\t\tpair<int, int> par = *it;\n\t\tif(vert == par.first) aux.push_back(par.second);\n\t\tif(vert == par.second) aux.push_back(par.first);\n\t}\n\treturn aux;\n}\n\nint coresConjunto(const vector<int>& l, const graph& G){\n\tvector<int> cor;\n\t\n\tfor(std::vector<int>::const_iterator it = l.begin(); it != l.end(); it++){\n\t\tif(!buscaSequencial(cor, G.cores[*it])){\n\t\t\tcor.push_back(G.cores[*it]);\n\t\t}\n\t}\n\treturn cor.size();\n}\n\nbool deep(int vertice, vector<int> hist, const graph& G)\n{\n\tbool fim = true;\n\thist.push_back(vertice);\n\tvector<int> aux = buscaAresta(vertice);\n\t\n    for(std::vector<int>::iterator it = aux.begin(); it != aux.end(); it++){\n    \tif(!buscaSequencial(hist, *it)){\n    \t\tfim = false;\n\t\t\tif(deep(*it, hist, G)){\n\t\t\t\treturn true;\n\t\t\t}\n\t\t}\n\t}\n\t\n\tif(fim){\n\t\tint nCor = coresConjunto(hist, G);\n\t\tif(nCor == nCores){\n\t\t\texibirVetor(hist);\n\t\t\tcout<<nCor;\n\t\t\treturn true;\n\t\t}\n\t\telse if(nCor > contCor){\n\t\t\tcontCor = nCor;\n\t\t\tcaminho = hist;\n\t\t}\n\t\treturn false;\n\t}\n\t\n    hist.pop_back();\n    \n    return false;\n}\n\nbool caminhoTropi(const graph& G){\n\tfor (int i = 0; i < nVertices; i++)\n    {\n\t\tvector<int> historico;\n\t\thistorico.push_back(i);\n\t    vector<int> vertices = buscaAresta(i);\n\t    \n\t\tfor(std::vector<int>::iterator it = vertices.begin(); it != vertices.end(); it++){\n\t\t\tif(deep(*it, historico, G)){\n\t\t\t\treturn true;\n\t\t\t}\n\t\t}\n\t\t\n\t\thistorico.pop_back();\n\t}\n\treturn false;\n}\n\nbool create_partitions(const graph& G)\n{\n    while(true)\n    {\n    \tpart P;\n        vector<part>::iterator iter;\n        for(vector<part>::iterator it=partitions.begin();it!=partitions.end();it++)\n        {\n            iter=it;\n        }\n        P.spanning=(*iter).spanning;\n        P.exc_ed=(*iter).exc_ed;\n        P.inc_ed=(*iter).inc_ed;\n        partitions.erase(iter);\n        \n        vector<pair<int, int>> stree = P.spanning;\n        vector<pair<int, int>>::iterator it1;\n        vector<pair<int, int>>::iterator it2;\n        \n        arvoreGeradora = stree;\n        \n        if(caminhoTropi(G)){\n\t\t\treturn true;\n\t\t}\n        \n        vector<pair<int, int>> included_edges;\n        vector<pair<int, int>> excluded_edges;\n        included_edges=P.inc_ed;\n        pair<int, int> ex_edge;\n        \n        int j;\n        for(j = 0; j < stree.size(); j++)\n        {\n            if(included_edges.empty())\n                break;\n            if(stree[j].first!=included_edges[j].first && stree[j].second!=included_edges[j].second)\n            {\n                break;\n            }\n        }\n        int cost;\n        it2= stree.begin()+ j;\n        int u1,v1;\n        for(it1=it2; it1!=stree.end(); it1++)\n        {\n            part new_p;\n            u1=(*it1).first;\n            v1=(*it1).second;\n            ex_edge.first=u1;\n            ex_edge.second=v1;\n            excluded_edges=P.exc_ed;\n            excluded_edges.push_back(ex_edge);\n            current_span.clear();\n            cost = Prim_ST(G, included_edges, excluded_edges);\n            if(cost > 0)\n            {\n                new_p.spanning=current_span;\n                new_p.inc_ed=included_edges;\n                new_p.exc_ed=excluded_edges;\n                partitions.push_back(new_p);\n            }\n            included_edges.push_back(ex_edge);\n        }\n        \n        if(partitions.empty()){\n            return false;\n        }\n    }\n}\n\nint main() {\n    scanf(\"%i %i\", &nVertices, &nCores);\n    \n    graph G {nVertices};\n    \n    for\t(int i = 0; i < nVertices; i++){\n\t\tint cor;\n\t\tscanf(\"%i\", &cor);\n\t\tG.cores[i] = cor;\n\t}\n    \n    scanf(\"%i\", &nArestas);\n    \n    for\t(int i = 0; i < nArestas; i++){\n    \tint u1, v1;\n\t\tscanf(\"%i %i\", &u1, &v1);\n        G.add_edge(u1, v1);\n\t}\n\t\n\tvector<pair<int, int>> incl;\n    vector<pair<int, int>> excl;\n    incl.clear();\n    excl.clear();\n    Prim_ST(G, incl, excl);\n    part p;\n    incl.clear();\n    excl.clear();\n    p.exc_ed=excl;\n    p.inc_ed=incl;\n    p.spanning=current_span;\n    partitions.push_back(p);\n    \n\tif(!create_partitions(G)){\n\t\texibirVetor(caminho);\n\t\tcout<<contCor<<endl;\n\t}\n\t\n    return 0;\n}\n",
      "path": "src/tropical.cpp"
    }
  ],
  "hypothesis": "Separating cycle-query row classification from dependency-carrying BFS updates should enable ARM64 SIMD, while reusable dense workspace removes per-query map and queue allocations without changing traversal decisions.",
  "notes": "Changes are confined to cycle queries and their workspace. No commands executed; correctness and speed require controller evaluation.",

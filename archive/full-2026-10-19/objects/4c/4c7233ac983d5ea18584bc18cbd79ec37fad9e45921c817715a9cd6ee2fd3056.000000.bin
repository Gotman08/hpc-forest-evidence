    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <iostream>\\n#include <vector>\\n#include <cstdio>\\n#include <cassert>\\n\\nint main() {\\n\\tint n, s;\\n\\tstd::cin >> n >> s;\\n\\t// Flatten matrix to contiguous row-major storage for better cache locality\\n\\tstd::vector<int> mat(n * n);\\n\\tfor (int i = 0; i < n; ++i) {\\n\\t\\tint* row_start = &mat[i * n];\\n\\t\\tfor (int j = 0; j < n; ++j) {\\n\\t\\t\\tscanf(\\\"%d\\\", &row_start[j]);\\n\\t\\t}\\n\\t}\\n\\n\\tassert(s < n);\\n\\tassert(n < 8000);\\n\\tassert(s > 0);\\n\\tassert(n > 0);\\n\\n\\t// Initial sum of top-left SxS submatrix\\n\\tint sum = 0;\\n\\tfor (int i = 0; i < s; ++i) {\\n\\t\\tconst int* row = &mat[i * n];\\n\\t\\tfor (int j = 0; j < s; ++j) {\\n\\t\\t\\tsum += row[j];\\n\\t\\t}\\n\\t}\\n\\n\\tint mxSum = sum;\\n\\n\\t// Snake traversal using flattened indices and pointer arithmetic\\n\\tint dir = 1;\\n\\tint i = 0;\\n\\tint j = 0;\\n\\twhile (i + s <= n) {\\n\\t\\tif ((j + s == n && dir == 1) || (j == 0 && dir == -1)) {\\n\\t\\t\\t// Move down one row\\n\\t\\t\\tconst int exitingRowStart = i * n;\\n\\t\\t\\tconst int enteringRowStart = (i + s) * n;\\n\\t\\t\\tfor (int k = 0; k < s; ++k) {\\n\\t\\t\\t\\tsum -= mat[exitingRowStart + j + k];\\n\\t\\t\\t}\\n\\t\\t\\tfor (int k = 0; k < s; ++k) {\\n\\t\\t\\t\\tsum += mat[enteringRowStart + j + k];\\n\\t\\t\\t}\\n\\t\\t\\t++i;\\n\\t\\t\\tdir *= -1;\\n\\t\\t} else {\\n\\t\\t\\t// Move horizontally\\n\\t\\t\\tint exitingCol, enteringCol;\\n\\t\\t\\tif (dir == 1) {\\n\\t\\t\\t\\texitingCol = j;\\n\\t\\t\\t\\tenteringCol = j + s;\\n\\t\\t\\t} else {\\n\\t\\t\\t\\tenteringCol = j - 1;\\n\\t\\t\\t\\texitingCol = enteringCol + s;\\n\\t\\t\\t}\\n\\t\\t\\t// Subtract exiting column (strided access, but contiguous in row-major)\\n\\t\\t\\tfor (int k = 0; k < s; ++k) {\\n\\t\\t\\t\\tsum -= mat[(i + k) * n + exitingCol];\\n\\t\\t\\t}\\n\\t\\t\\t// Add entering column\\n\\t\\t\\tfor (int k = 0; k < s; ++k) {\\n\\t\\t\\t\\tsum += mat[
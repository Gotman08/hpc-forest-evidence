{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include \\\"knn.h\\\"\\n#include <stdint.h>\\n#include <omp.h>\\n\\n#define PARALLEL_WORK_THRESHOLD ((size_t)32768)\\n\\nstatic void insert_local_candidate(char *labels, float *distances,\\n                                   size_t *count, size_t capacity,\\n                                   float distance, char label) {\\n    size_t position = 0;\\n    while (position < *count && !(distance < distances[position])) {\\n        position++;\\n    }\\n\\n    if (position == capacity) {\\n        return;\\n    }\\n\\n    if (*count < capacity) {\\n        (*count)++;\\n    }\\n\\n    for (size_t i = *count - 1; i > position; i--) {\\n        distances[i] = distances[i - 1];\\n        labels[i] = labels[i - 1];\\n    }\\n\\n    distances[position] = distance;\\n    labels[position] = label;\\n}\\n\\nstatic size_t group_for_point(const size_t *offsets, size_t group_count,\\n                              size_t point_index) {\\n    size_t low = 0;\\n    size_t high = group_count;\\n\\n    while (low < high) {\\n        size_t middle = low + (high - low) / 2;\\n        if (point_index < offsets[middle + 1]) {\\n            high = middle;\\n        } else {\\n            low = middle + 1;\\n        }\\n    }\\n\\n    return low;\\n}\\n\\nstatic int parallel_top_k(int n_groups, Group *groups, int k,\\n                          char *labels, float *distances) {\\n    size_t *offsets = NULL;\\n    char *thread_labels = NULL;\\n    float *thread_distances = NULL;\\n    char *merge_labels = NULL;\\n    float *merge_distances = NULL;\\n    size_t *counts = NULL;\\n    int *has_nan = NULL;\\n    size_t total_points = 0;\\n    size_t group_count = (size_t)n_groups;\\n    size_t capacity = 0;\\n    size_t slots = 0;\\n    int max_threads = omp_get_max_threads();\\n    int success = 0;\\n\\n    if (n_groups <= 0 || k <= 0 || max_threads <= 1) {\\n        return 0;\\n    }\\n\\n    for (size_t i = 0; i < group_count; i++) {\\n        if (groups[i].length < 0 ||\\n            (size_t)groups[i].length > SIZE_MAX - total_points) {\\n            return 0;\\n        }\\n        total_points += (size_t)groups[i].length;\\n    }\\n\\n    capacity = (size_t)k;\\n    if (capacity > total_points) {\\n        capacity = total_points;\\n    }\\n    if (capacity == 0) {\\n        return 0;\\n    }\\n\\n    if (total_points <= SIZE_MAX / capacity &&\\n        total_points * capacity < PARALLEL_WORK_THRESHOLD) {\\n        return 0;\\n    }\\n\\n    if (group_count == SIZE_MAX ||\\n        group_count + 1 > SIZE_MAX / sizeof(*offsets)) {\\n        goto cleanup;\\n    }\\n    offsets = (size_t *)malloc((group_count + 1) * sizeof(*offsets));\\n    if (offsets == NULL) {\\n        goto cleanup;\\n    }\\n    offsets[0] = 0;\\n    for (size_t i = 0; i < group_count; i++) {\\n        offsets[i + 1] = offsets[i] + (size_t)groups[i].length;\\n    }\\n\\n    if ((size_t)max_threads > SIZE_MAX / capacity ||\\n        capacity > SIZE_MAX / sizeof(*merge_distances)) {\\n        goto cleanup;\\n    }\\n    slots = (size_t)max_threads * capacity;\\n    if (slots > SIZE_MAX / sizeof(*thread_distances) ||\\n        (size_t)max_threads > SIZE_MAX / sizeof(*counts) ||\\n        (size_t)max_threads > SIZE_MAX / sizeof(*has_nan)) {\\n        goto cleanup;\\n    }\\n\\n    thread_labels = (char *)malloc(slots * sizeof(*thread_labels));\\n    thread_distances = (float *)malloc(slots * sizeof(*thread_distances));\\n    merge_labels = (char *)malloc(capacity * sizeof(*merge_labels));\\n    merge_distances = (float *)malloc(capacity * sizeof(*merge_distances));\\n    counts = (size_t *)calloc((size_t)max_threads, sizeof(*counts));\\n    has_nan = (int *)calloc((size_t)max_threads, sizeof(*has_nan));\\n    if (thread_labels == NULL || thread_distances == NULL ||\\n        merge_labels == NULL || merge_distances == NULL ||\\n        counts == NULL || has_nan == NULL) {\\n        goto cleanup;\\n    }\\n\\n    /* Static chunks preserve point order within each thread and across threads. */\\n    #pragma omp parallel\\n    {\\n        size_t thread_id = (size_t)omp_get_thread_num();\\n        char *local_labels = thread_labels + thread_id * capacity;\\n        float *local_distances = thread_distances + thread_id * capacity;\\n\\n        #pragma omp for schedule(static)\\n        for (size_t point_index = 0; point_index < total_points; point_index++) {\\n            size_t group_index = group_for_point(offsets, group_count, point_index);\\n            Point point = groups[group_index].points[point_index - offsets[group_index]];\\n            float distance = euclidean_distance_no_sqrt(\\n                groups[group_index].points[point_index - offsets[group_index]],\\n                point);\\n\\n            /* Recompute using the same argument order as the serial algorithm. */\\n            distance = euclidean_distance_no_sqrt(\\n                (Point){0.0f, 0.0f}, (Point){0.0f, 0.0f});\\n            distance = euclidean_distance_no_sqrt(\\n                point, (Point){0.0f, 0.0f});\\n\\n            if (distance != distance) {\\n                has_nan[thread_id] = 1;\\n            }\\n            insert_local_candidate(local_labels, local_distances,\\n                                   &counts[thread_id], capacity,\\n                                   distance, groups[group_index].label);\\n        }\\n    }\\n\\n    for (size_t thread_id = 0; thread_id < (size_t)max_threads; thread_id++) {\\n        if (has_nan[thread_id]) {\\n            goto cleanup;\\n        }\\n    }\\n\\n    /* Merge sorted thread-local lists in thread order to retain stable ties. */\\n    size_t global_count = 0;\\n    for (size_t thread_id = 0; thread_id < (size_t)max_threads; thread_id++) {\\n        size_t local_count = counts[thread_id];\\n        size_t local_index = 0;\\n        size_t global_index = 0;\\n        size_t output_count = 0;\\n        size_t local_offset = thread_id * capacity;\\n\\n        while (output_count < capacity &&\\n               (global_index < global_count || local_index < local_count)) {\\n            int take_global =\\n                local_index >= local_count ||\\n                (global_index < global_count &&\\n                 !(thread_distances[local_offset + local_index] <\\n                   distances[global_index]));\\n\\n            if (take_global) {\\n                merge_labels[output_count] = labels[global_index];\\n                merge_distances[output_count] = distances[global_index];\\n                global_index++;\\n            } else {\\n                merge_labels[output_count] = thread_labels[local_offset + local_index];\\n                merge_distances[output_count] = thread_distances[local_offset + local_index];\\n                local_index++;\\n            }\\n            output_count++;\\n        }\\n\\n        for (size_t i = 0; i < output_count; i++) {\\n            labels[i] = merge_labels[i];\\n            distances[i] = merge_distances[i];\\n        }\\n        global_count = output_count;\\n    }\\n\\n    success = 1;\\n\\ncleanup:\\n    free(offsets);\\n    free(thread_labels);\\n    free(thread_distances);\\n    free(merge_labels);\\n    free(merge_distances);\\n    free(counts);\\n    free(has_nan);\\n    return success;\\n}\\n\\nstatic void sequential_top_k(int n_groups, Group *groups, int k,\\n                             Point to_evaluate, char *labels, float *distances) {\\n    int i, j, x, y;\\n\\n    for (i = 0; i < k; i++) {\\n        labels[i] = -1;\\n        distances[i] = -1;\\n    }\\n\\n    for (i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n\\n        for (j = 0; j < g.length; j++) {\\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n\\n            for (x = 0; x < k; x++) {\\n                if (d < distances[x] || distances[x] == -1) {\\n                    for (y = k - 1; y > x; y--) {\\n                        distances[y] = distances[y - 1];\\n                        labels[y] = labels[y - 1];\\n                    }\\n\\n                    distances[x] = d;\\n                    labels[x] = g.label;\\n                    break;\\n                }\\n            }\\n        }\\n    }\\n}\\n\\nstatic char select_label(char *labels, int k) {\\n    int i;\\n\\n    qsort(labels, k, sizeof(char), compare_for_sort);\\n\\n    char most_frequent = labels[0];\\n    int most_frequent_count = 1;\\n    int current_frequency = 1;\\n\\n    for (i = 1; i < k; i++) {\\n        if (labels[i] != labels[i - 1]) {\\n            if (current_frequency > most_frequent_count) {\\n                most_frequent = labels[i - 1];\\n                most_frequent_count = current_frequency;\\n            }\\n            current_frequency = 1;\\n        } else {\\n            current_frequency++;\\n        }\\n\\n        if (i == k - 1 && current_frequency > most_frequent_count) {\\n            most_frequent = labels[i - 1];\\n            most_frequent_count = current_frequency;\\n        }\\n    }\\n\\n    return most_frequent;\\n}\\n\\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n    char *labels = (char *)malloc(sizeof(char) * k);\\n    float *distances = (float *)malloc(sizeof(float) * k);\\n\\n    for (int i = 0; i < k; i++) {\\n        labels[i] = -1;\\n        distances[i] = -1;\\n    }\\n\\n    if (!parallel_top_k(n_groups, groups, k, labels, distances)) {\\n        sequential_top_k(n_groups, groups, k, to_evaluate, labels, distances);\\n    }\\n\\n    char result = select_label(labels, k);\\n    free(labels);\\n    free(distances);\\n    return result;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\"path\":\"src/knn.c\"}],\"hypothesis\":\"For sufficiently large point-count × top-k work, an OpenMP static partition lets threads maintain independent stable top-k lists and reduces serial insertion work; merging those lists in thread order should preserve equal-distance selection and improve runtime on the four-core target.\",\"notes\":\"One bounded top-k selection experiment. The serial path is retained for small workloads, allocation failure, and NaN distances; this proposal has not been compiled or measured, so controller validation is required.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Use an OpenMP parallel-for with static scheduling over flattened point ordinals and thread-local sorted top-k lists; merge lists stably in thread order before retaining the existing label sort and plurality rule.\"]}"}}

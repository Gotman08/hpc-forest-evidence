      "kind": "generation_usage",
      "payload": "{\"attempt_usage\":[{\"backend\":\"codex-mailbox\",\"cached_tokens_included_in_input\":true,\"codex_jsonl_sha256\":\"23582161ea19f3e94f630e40f312c88a8d3caaf8dd954b56dfbc2db55a296fce\",\"events\":[{\"cache_write_input_tokens\":0,\"cached_input_tokens\":0,\"input_tokens\":11973,\"output_tokens\":9812,\"reasoning_output_tokens\":8163}],\"llm_calls\":1,\"model\":\"gpt-6-astra\",\"model_requested\":\"gpt-6-astra\",\"reasoning_effort\":\"xhigh\",\"reasoning_effort_requested\":\"xhigh\",\"request_sha256\":\"86e4f35201a9ff2fd1741e844e6d0ac3d35bc1b11cd399b05d9edfed499606de\",\"token_accounting\":\"exact\",\"tokens\":21785,\"tool_events\":[]}],\"automatic_measured_feedback_only\":false,\"backend\":\"node-harness\",\"contract_rejected\":false,\"development_evaluations\":1,\"experiment_id\":\"69e8a257994d4eba\",\"harness_attempts\":1,\"journal\":\"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-astra-xhigh/results-750205/2022-sum/logs/69e8a257994d4eba/node-harness.json\",\"llm_calls\":1,\"research_actions\":0,\"research_enabled\":true}",

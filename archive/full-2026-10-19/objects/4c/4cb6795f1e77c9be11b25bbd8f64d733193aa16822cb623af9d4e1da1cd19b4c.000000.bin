      "content": "#include \"knn.h\"\n#include <float.h>\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\nstatic char winning_label(const size_t * votes) {\n    char best = (char)-1;\n    size_t best_count = 0;\n\n    for (unsigned int value = 0; value <= UCHAR_MAX; value++) {\n        char label = (char)(unsigned char)value;\n        if (votes[value] > best_count ||\n            (best_count != 0 && votes[value] == best_count && label < best)) {\n            best = label;\n            best_count = votes[value];\n        }\n    }\n\n    return best;\n}\n\nstatic char insertion_knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *)malloc((size_t)k * sizeof(*labels));\n    float * distances = (float *)malloc((size_t)k * sizeof(*distances));\n\n    if (labels == NULL || distances == NULL) {\n        free(labels);\n        free(distances);\n        on_error();\n        return (char)-1;\n    }\n\n    for (int i = 0; i < k; i++) {\n        labels[i] = (char)-1;\n        distances[i] = -1.0f;\n    }\n\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (int x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1.0f) {\n                    for (int y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    size_t votes[UCHAR_MAX + 1] = {0};\n    for (int i = 0; i < k; i++) {\n        votes[(unsigned char)labels[i]]++;\n    }\n\n    char result = winning_label(votes);\n    free(distances);\n    free(labels);\n    return result;\n}\n\nstatic uint32_t select_distance_key(const uint32_t * keys, size_t count,\n                                    size_t rank, size_t * lower_count) {\n    uint32_t prefix = 0;\n    uint32_t mask = 0;\n    size_t skipped = 0;\n\n    for (int shift = 24; shift >= 0; shift -= 8) {\n        size_t buckets[256] = {0};\n        for (size_t i = 0; i < count; i++) {\n            uint32_t key = keys[i];\n            if ((key & mask) == prefix) {\n                buckets[(key >> shift) & UINT32_C(255)]++;\n            }\n        }\n\n        unsigned int bucket = 0;\n        while (bucket < 255 && rank >= buckets[bucket]) {\n            rank -= buckets[bucket];\n            skipped += buckets[bucket];\n            bucket++;\n        }\n\n        prefix |= (uint32_t)bucket << shift;\n        mask |= UINT32_C(255) << shift;\n    }\n\n    *lower_count = skipped;\n    return prefix;\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    if (k <= 0) {\n        return (char)-1;\n    }\n\n    size_t total = 0;\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length > 0) {\n            size_t length = (size_t)groups[i].length;\n            if (length > SIZE_MAX - total) {\n                return insertion_knn(n_groups, groups, k, to_evaluate);\n            }\n            total += length;\n        }\n    }\n\n    size_t votes[UCHAR_MAX + 1] = {0};\n    if (total <= (size_t)k) {\n        for (int i = 0; i < n_groups; i++) {\n            if (groups[i].length > 0) {\n                votes[(unsigned char)groups[i].label] += (size_t)groups[i].length;\n            }\n        }\n        votes[(unsigned char)(char)-1] += (size_t)k - total;\n        return winning_label(votes);\n    }\n\n    if (sizeof(float) != sizeof(uint32_t) || FLT_RADIX != 2 ||\n        FLT_MANT_DIG != 24 || FLT_MAX_EXP != 128 ||\n        total > SIZE_MAX / sizeof(uint32_t)) {\n        return insertion_knn(n_groups, groups, k, to_evaluate);\n    }\n\n    uint32_t * keys = (uint32_t *)malloc(total * sizeof(*keys));\n    if (keys == NULL) {\n        return insertion_knn(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t index = 0;\n    unsigned int has_nan = 0;\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            uint32_t key;\n            memcpy(&key, &d, sizeof(key));\n            key &= UINT32_C(0x7fffffff);\n            keys[index++] = key;\n            has_nan |= key > UINT32_C(0x7f800000);\n        }\n    }\n\n    if (has_nan) {\n        free(keys);\n        return insertion_knn(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t lower_count;\n    uint32_t threshold = select_distance_key(keys, total, (size_t)k - 1,\n                                             &lower_count);\n    size_t equal_remaining = (size_t)k - lower_count;\n\n    /* Retain traversal order so equal-distance boundary ties match insertion. */\n    index = 0;\n    for (int i = 0; i < n_groups; i++) {\n        size_t chosen = 0;\n        for (int j = 0; j < groups[i].length; j++) {\n            uint32_t key = keys[index++];\n            if (key < threshold) {\n                chosen++;\n            } else if (key == threshold && equal_remaining != 0) {\n                chosen++;\n                equal_remaining--;\n            }\n        }\n        votes[(unsigned char)groups[i].label] += chosen;\n    }\n\n    free(keys);\n    return winning_label(votes);\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",

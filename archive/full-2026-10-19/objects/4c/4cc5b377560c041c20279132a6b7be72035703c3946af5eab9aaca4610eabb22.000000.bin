#include <algorithm>
#include <iostream>
#include <vector>

using namespace std;

const int MOD = 1000000007;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    cin >> n >> m;

    vector<int> blocked;
    blocked.reserve(m);
    for (int i = 0; i < m; ++i) {
        int y, x;
        cin >> y >> x;
        if (y >= 0 && y < n && x >= 0 && x < n)
            blocked.push_back(y * n + x);
    }

    sort(blocked.begin(), blocked.end());
    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());

    if (binary_search(blocked.begin(), blocked.end(), 0) ||
        binary_search(blocked.begin(), blocked.end(), n * n - 1)) {
        cout << 0 << '\n';
        return 0;
    }

    const int maxFactorial = 2 * n - 2;
    vector<long long> factorial(maxFactorial + 1), invFactorial(maxFactorial + 1);
    factorial[0] = 1;
    for (int i = 1; i <= maxFactorial; ++i)
        factorial[i] = factorial[i - 1] * i % MOD;

    auto modPow = [](long long base, int exp) {
        long long result = 1;
        while (exp > 0) {
            if (exp & 1) result = result * base % MOD;
            base = base * base % MOD;
            exp >>= 1;
        }
        return result;
    };

    invFactorial[maxFactorial] = modPow(factorial[maxFactorial], MOD - 2);
    for (int i = maxFactorial; i > 0; --i)
        invFactorial[i - 1] = invFactorial[i] * i % MOD;

    auto paths = [&](int dy, int dx) -> long long {
        int total = dy + dx;
        return factorial[total] * invFactorial[dy] % MOD * invFactorial[dx] % MOD;
    };

    vector<int> points = blocked;
    points.push_back(n * n - 1);
    sort(points.begin(), points.end());

    vector<long long> ways(points.size());
    for (size_t i = 0; i < points.size(); ++i) {
        int y = points[i] / n;
        int x = points[i] % n;
        long long count = paths(y, x);
        for (size_t j = 0; j < i; ++j) {
            int py = points[j] / n;
            int px = points[j] % n;
            if (py <= y && px <= x) {
                count -= ways[j] * paths(y - py, x - px) % MOD;
                if (count < 0) count += MOD;
            }
        }
        ways[i] = count;
    }

    cout << ways.back() << '\n';
    return 0;
}

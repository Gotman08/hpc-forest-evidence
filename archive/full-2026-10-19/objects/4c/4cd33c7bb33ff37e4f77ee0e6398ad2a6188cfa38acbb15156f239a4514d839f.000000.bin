    {
      "content": "{\"role\": \"G\", \"goal\": \"integration of diverse archived transformations; evaluate the full program\", \"experiment\": \"5ffac8acdd0a4297-h01\", \"ordinal\": 4, \"integration_source_ids\": [\"bbb7280a6f194ab0\", \"74e1b1e39e0b4b76\", \"7f445631cd5546d9\"], \"current_source_paths\": [\"src/nbody.c\"], \"context_as_data\": {\"sources\": [{\"id\": \"bbb7280a6f194ab0\", \"role\": \"A\", \"commit\": \"327972c4fc1455fc5dee65683e6d7d8eb3a88742\", \"transformations\": {\"files\": [\"src/nbody.c\"], \"retained\": [\"Replace eight-target full scans with 32-body pair tiles over compact SoA position and force storage.\", \"Parallelize disjoint tile pairs within barrier-separated anti-diagonal waves, preserving source-block order for every body.\", \"Share inverse distances across opposite interactions, explicitly recompute reverse displacements, and retain directed diagonal-tile calculations.\"]}, \"mean_seconds\": 0.15275783091783524, \"diff\": \"diff --git a/src/nbody.c b/src/nbody.c\\nindex 765bd6a..61f203d 100644\\n--- a/src/nbody.c\\n+++ b/src/nbody.c\\n@@ -6,6 +6,7 @@\\n #define N_ITER 10 // number of simulation iterations\\n #define DT 0.01f // time step\\n #define SOFTENING 1e-9f // to avoid zero divisors\\n+#define PAIR_TILE 32\\n \\n /*\\n  * Each body holds coordinate positions (i.e., x, y, and z) and\\n@@ -13,14 +14,11 @@\\n  */\\n typedef struct { float x, y, z, vx, vy, vz; } Body;\\n \\n-/*\\n- * Compute the gravitational impact among all pairs of bodies in \\n- * the system.\\n- */\\n-void body_force(Body *p, float dt, int n) {\\n+/* Allocation-free fallback with the original accumulation order. */\\n+static void body_force_direct(Body *p, float dt, int n) {\\n   for (int i = 0; i < n; ++i) {\\n-    float fx = 0.0f; \\n-    float fy = 0.0f; \\n+    float fx = 0.0f;\\n+    float fy = 0.0f;\\n     float fz = 0.0f;\\n \\n     for (int j = 0; j < n; j++) {\\n@@ -31,17 +29,195 @@ void body_force(Body *p, float dt, int n) {\\n       float inv_dist = 1 / sqrt(sqrd_dist);\\n       float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n \\n-      fx += dx * inv_dist3; \\n-      fy += dy * inv_dist3; \\n+      fx += dx * inv_dist3;\\n+      fy += dy * inv_dist3;\\n       fz += dz * inv_dist3;\\n     }\\n \\n-    p[i].vx += dt*fx; \\n-    p[i].vy += dt*fy; \\n+    p[i].vx += dt*fx;\\n+    p[i].vy += dt*fy;\\n     p[i].vz += dt*fz;\\n   }\\n }\\n \\n+/* Diagonal tiles retain the complete directed source loop, including self. */\\n+static inline void accumulate_diagonal_tile(\\n+    const float * restrict x,\\n+    const float * restrict y,\\n+    const float * restrict z,\\n+    float * restrict fx,\\n+    float * restrict fy,\\n+    float * restrict fz,\\n+    int first, int end) {\\n+  for (int i = first; i < end; ++i) {\\n+    const float tx = x[i];\\n+    const float ty = y[i];\\n+    const float tz = z[i];\\n+    float ax = fx[i];\\n+    float ay = fy[i];\\n+    float az = fz[i];\\n+\\n+    for (int j = first; j < end; ++j) {\\n+      float dx = x[j] - tx;\\n+      float dy = y[j] - ty;\\n+      float dz = z[j] - tz;\\n+      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n+      float inv_dist = 1 / sqrt(sqrd_dist);\\n+      float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n+\\n+      ax += dx * inv_dist3;\\n+      ay += dy * inv_dist3;\\n+      az += dz * inv_dist3;\\n+    }\\n+\\n+    fx[i] = ax;\\n+    fy[i] = ay;\\n+    fz[i] = az;\\n+  }\\n+}\\n+\\n+/*\\n+ * Both tiles stay cache-resident. Rows accumulate ascending j values,\\n+ * while columns receive ascending i values. Reverse displacements are\\n+ * evaluated explicitly to preserve their signed-zero behavior.\\n+ */\\n+static inline void accumulate_pair_tile(\\n+    const float * restrict x,\\n+    const float * restrict y,\\n+    const float * restrict z,\\n+    float * restrict fx,\\n+    float * restrict fy,\\n+    float * restrict fz,\\n+    int first_i, int end_i, int first_j, int end_j) {\\n+  for (int i = first_i; i < end_i; ++i) {\\n+    const float tx = x[i];\\n+    const float ty = y[i];\\n+    const float tz = z[i];\\n+    float ax = fx[i];\\n+    float ay = fy[i];\\n+    float az = fz[i];\\n+\\n+    for (int j = first_j; j < end_j; ++j) {\\n+      const float sx = x[j];\\n+      const float sy = y[j];\\n+      const float sz = z[j];\\n+      float dx = sx - tx;\\n+      float dy = sy - ty;\\n+      float dz = sz - tz;\\n+      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n+      float inv_dist = 1 / sqrt(sqrd_dist);\\n+      float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n+\\n+      ax += dx * inv_dist3;\\n+      ay += dy * inv_dist3;\\n+      az += dz * inv_dist3;\\n+\\n+      float reverse_dx = tx - sx;\\n+      float reverse_dy = ty - sy;\\n+      float reverse_dz = tz - sz;\\n+      fx[j] += reverse_dx * inv_dist3;\\n+      fy[j] += reverse_dy * inv_dist3;\\n+      fz[j] += reverse_dz * inv_dist3;\\n+    }\\n+\\n+    fx[i] = ax;\\n+    fy[i] = ay;\\n+    fz[i] = az;\\n+  }\\n+}\\n+\\n+void body_force(Body *p, float dt, int n) {\\n+  if (n <= 0) {\\n+    return;\\n+  }\\n+\\n+  if ((size_t)n > (size_t)-1 / (6 * sizeof(float))) {\\n+    body_force_direct(p, dt, n);\\n+    return;\\n+  }\\n+\\n+  float *workspace = (float *)malloc((size_t)n * 6 * sizeof(float));\\n+  if (workspace == NULL) {\\n+    body_force_direct(p, dt, n);\\n+    return;\\n+  }\\n+\\n+  float * restrict x = workspace;\\n+  float * restrict y = workspace + (size_t)n;\\n+  float * restrict z = workspace + 2 * (size_t)n;\\n+  float * restrict fx = workspace + 3 * (size_t)n;\\n+  float * restrict fy = workspace + 4 * (size_t)n;\\n+  float * restrict fz = workspace + 5 * (size_t)n;\\n+\\n+  for (int i = 0; i < n; ++i) {\\n+    x[i] = p[i].x;\\n+    y[i] = p[i].y;\\n+    z[i] = p[i].z;\\n+    if (!isfinite(x[i]) || !isfinite(y[i]) || !isfinite(z[i])) {\\n+      free(workspace);\\n+      body_force_direct(p, dt, n);\\n+      return;\\n+    }\\n+    fx[i] = 0.0f;\\n+    fy[i] = 0.0f;\\n+    fz[i] = 0.0f;\\n+  }\\n+\\n+  const int blocks = n / PAIR_TILE + (n % PAIR_TILE != 0);\\n+\\n+#ifdef _OPENMP\\n+#pragma omp parallel if (blocks > 2)\\n+#endif\\n+  {\\n+    /*\\n+     * Pairs with the same block-index sum have disjoint bodies.\\n+     * Increasing that sum visits every body's source blocks in order.\\n+     * The implicit worksharing barrier separates successive waves.\\n+     */\\n+    for (int wave = 0; wave < 2 * blocks - 1; ++wave) {\\n+      const int first_block = wave < blocks ? 0 : wave - blocks + 1;\\n+      const int last_block = wave / 2;\\n+\\n+#ifdef _OPENMP\\n+#pragma omp for schedule(static)\\n+#endif\\n+      for (int block = first_block; block <= last_block; ++block) {\\n+        const int other = wave - block;\\n+        const int first_i = block * PAIR_TILE;\\n+        const int first_j = other * PAIR_TILE;\\n+        int count_i = n - first_i;\\n+        int count_j = n - first_j;\\n+        if (count_i > PAIR_TILE) {\\n+          count_i = PAIR_TILE;\\n+        }\\n+        if (count_j > PAIR_TILE) {\\n+          count_j = PAIR_TILE;\\n+        }\\n+        const int end_i = first_i + count_i;\\n+        const int end_j = first_j + count_j;\\n+\\n+        if (block == other) {\\n+          accumulate_diagonal_tile(x, y, z, fx, fy, fz, first_i, end_i);\\n+        } else {\\n+          accumulate_pair_tile(x, y, z, fx, fy, fz,\\n+                             \"}, {\"id\": \"74e1b1e39e0b4b76\", \"role\": \"B\", \"commit\": \"f9360227e4432e64a2825796f3d9f9ac67e83fb7\", \"transformations\": {\"files\": [\"src/nbody.c\"], \"retained\": [\"Vectorize across four independent targets without reducing or reordering source interactions.\", \"Use reciprocal-square-root refinement guarded by a double residual certificate and float-midpoint exclusion window.\", \"Parallelize independent target tiles with OpenMP, retaining scalar tails and unchanged I/O.\"]}, \"mean_seconds\": 0.13452752958983183, \"diff\": \"diff --git a/src/nbody.c b/src/nbody.c\\nindex 765bd6a..ce27ef5 100644\\n--- a/src/nbody.c\\n+++ b/src/nbody.c\\n@@ -2,6 +2,11 @@\\n #include <stdlib.h>\\n #include <string.h>\\n #include <math.h>\\n+#include <stdint.h>\\n+\\n+#if defined(__aarch64__)\\n+#include <arm_neon.h>\\n+#endif\\n \\n #define N_ITER 10 // number of simulation iterations\\n #define DT 0.01f // time step\\n@@ -13,33 +18,151 @@\\n  */\\n typedef struct { float x, y, z, vx, vy, vz; } Body;\\n \\n+static inline void body_force_one(Body *p, float dt, int n, int i) {\\n+  float fx = 0.0f;\\n+  float fy = 0.0f;\\n+  float fz = 0.0f;\\n+\\n+  for (int j = 0; j < n; j++) {\\n+    float dx = p[j].x - p[i].x;\\n+    float dy = p[j].y - p[i].y;\\n+    float dz = p[j].z - p[i].z;\\n+    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n+    float inv_dist = 1 / sqrt(sqrd_dist);\\n+    float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n+\\n+    fx += dx * inv_dist3;\\n+    fy += dy * inv_dist3;\\n+    fz += dz * inv_dist3;\\n+  }\\n+\\n+  p[i].vx += dt*fx;\\n+  p[i].vy += dt*fy;\\n+  p[i].vz += dt*fz;\\n+}\\n+\\n+#if defined(__aarch64__)\\n+static inline __attribute__((always_inline))\\n+float32x4_t reference_inverse_distance(float32x4_t d) {\\n+  float64x2_t lo = vcvt_f64_f32(vget_low_f32(d));\\n+  float64x2_t hi = vcvt_f64_f32(vget_high_f32(d));\\n+  const float64x2_t one = vdupq_n_f64(1.0);\\n+  lo = vdivq_f64(one, vsqrtq_f64(lo));\\n+  hi = vdivq_f64(one, vsqrtq_f64(hi));\\n+  return vcombine_f32(vcvt_f32_f64(lo), vcvt_f32_f64(hi));\\n+}\\n+\\n+static inline __attribute__((always_inline))\\n+float32x4_t certified_inverse_distance(float32x4_t d) {\\n+  float32x4_t estimate = vrsqrteq_f32(d);\\n+  estimate = vmulq_f32(estimate,\\n+      vrsqrtsq_f32(vmulq_f32(d, estimate), estimate));\\n+  estimate = vmulq_f32(estimate,\\n+      vrsqrtsq_f32(vmulq_f32(d, estimate), estimate));\\n+\\n+  const float64x2_t xlo = vcvt_f64_f32(vget_low_f32(d));\\n+  const float64x2_t xhi = vcvt_f64_f32(vget_high_f32(d));\\n+  float64x2_t ylo = vcvt_f64_f32(vget_low_f32(estimate));\\n+  float64x2_t yhi = vcvt_f64_f32(vget_high_f32(estimate));\\n+  ylo = vmulq_f64(ylo,\\n+      vrsqrtsq_f64(vmulq_f64(xlo, ylo), ylo));\\n+  yhi = vmulq_f64(yhi,\\n+      vrsqrtsq_f64(vmulq_f64(xhi, yhi), yhi));\\n+\\n+  /*\\n+   * Certify the approximation rather than relying on estimate accuracy.\\n+   * A small residual bounds its relative error well below 2^-39.\\n+   * Finite distances are at least SOFTENING, so their inverse distances\\n+   * and all products used by this certificate are normal doubles.\\n+   */\\n+  const float64x2_t one = vdupq_n_f64(1.0);\\n+  const float64x2_t zero = vdupq_n_f64(0.0);\\n+  const float64x2_t bound = vdupq_n_f64(0x1p-40);\\n+  float64x2_t rlo = vfmsq_f64(one, vmulq_f64(xlo, ylo), ylo);\\n+  float64x2_t rhi = vfmsq_f64(one, vmulq_f64(xhi, yhi), yhi);\\n+  uint64x2_t safe_lo = vandq_u64(\\n+      vcltq_f64(vabsq_f64(rlo), bound), vcgtq_f64(ylo, zero));\\n+  uint64x2_t safe_hi = vandq_u64(\\n+      vcltq_f64(vabsq_f64(rhi), bound), vcgtq_f64(yhi, zero));\\n+\\n+  /*\\n+   * Normal float rounding discards 29 double significand bits. Reject\\n+   * candidates within 2^16 double ULPs of a float rounding midpoint.\\n+   * This guard exceeds both the certified error and the double sqrt/div\\n+   * rounding error of the reference. Unsigned subtraction wraps below\\n+   * the guarded interval, making those values safely outside it.\\n+   */\\n+  const uint64x2_t tail_mask = vdupq_n_u64(UINT64_C(0x1fffffff));\\n+  const uint64x2_t lower = vdupq_n_u64(UINT64_C(0x0fff0000));\\n+  const uint64x2_t width = vdupq_n_u64(UINT64_C(0x00020000));\\n+  uint64x2_t offset_lo = vsubq_u64(\\n+      vandq_u64(vreinterpretq_u64_f64(ylo), tail_mask), lower);\\n+  uint64x2_t offset_hi = vsubq_u64(\\n+      vandq_u64(vreinterpretq_u64_f64(yhi), tail_mask), lower);\\n+  safe_lo = vandq_u64(safe_lo, vcgtq_u64(offset_lo, width));\\n+  safe_hi = vandq_u64(safe_hi, vcgtq_u64(offset_hi, width));\\n+\\n+  uint32x4_t safe = vreinterpretq_u32_u64(vandq_u64(safe_lo, safe_hi));\\n+  if (__builtin_expect(vminvq_u32(safe) != UINT32_MAX, 0)) {\\n+    return reference_inverse_distance(d);\\n+  }\\n+  return vcombine_f32(vcvt_f32_f64(ylo), vcvt_f32_f64(yhi));\\n+}\\n+#endif\\n+\\n /*\\n- * Compute the gravitational impact among all pairs of bodies in \\n- * the system.\\n+ * Vector lanes represent independent targets. Every lane retains the\\n+ * original ascending source order; positions remain read-only here.\\n  */\\n void body_force(Body *p, float dt, int n) {\\n-  for (int i = 0; i < n; ++i) {\\n-    float fx = 0.0f; \\n-    float fy = 0.0f; \\n-    float fz = 0.0f;\\n-\\n-    for (int j = 0; j < n; j++) {\\n-      float dx = p[j].x - p[i].x;\\n-      float dy = p[j].y - p[i].y;\\n-      float dz = p[j].z - p[i].z;\\n-      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n-      float inv_dist = 1 / sqrt(sqrd_dist);\\n-      float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n-\\n-      fx += dx * inv_dist3; \\n-      fy += dy * inv_dist3; \\n+  if (n <= 0) return;\\n+\\n+#if defined(__aarch64__)\\n+  const int blocks = n / 4;\\n+  #pragma omp parallel for schedule(static) if(n >= 64)\\n+  for (int block = 0; block < blocks; ++block) {\\n+    const int i = 4 * block;\\n+    const float32x4_t px = {p[i].x, p[i+1].x, p[i+2].x, p[i+3].x};\\n+    const float32x4_t py = {p[i].y, p[i+1].y, p[i+2].y, p[i+3].y};\\n+    const float32x4_t pz = {p[i].z, p[i+1].z, p[i+2].z, p[i+3].z};\\n+    const float32x4_t softening = vdupq_n_f32(SOFTENING);\\n+    float32x4_t fx = vdupq_n_f32(0.0f);\\n+    float32x4_t fy = vdupq_n_f32(0.0f);\\n+    float32x4_t fz = vdupq_n_f32(0.0f);\\n+\\n+    for (int j = 0; j < n; ++j) {\\n+      float32x4_t dx = vdupq_n_f32(p[j].x) - px;\\n+      float32x4_t dy = vdupq_n_f32(p[j].y) - py;\\n+      float32x4_t dz = vdupq_n_f32(p[j].z) - pz;\\n+      float32x4_t sqrd_dist = dx*dx + dy*dy + dz*dz + softening;\\n+      float32x4_t inv_dist = certified_inverse_distance(sqrd_dist);\\n+      float32x4_t inv_dist3 = inv_dist * inv_dist * inv_dist;\\n+\\n+      fx += dx * inv_dist3;\\n+      fy += dy * inv_dist3;\\n       fz += dz * inv_dist3;\\n     }\\n \\n-    p[i].vx += dt*fx; \\n-    p[i].vy += dt*fy; \\n-    p[i].vz += dt*fz;\\n+    float fxs[4], fys[4], fzs[4];\\n+    vst\"}, {\"id\": \"7f445631cd5546d9\", \"role\": \"C\", \"commit\": \"5aabd5e9bbf0d05f083210a7c16fef93e94d68ab\", \"transformations\": {\"files\": [\"src/nbody.c\"], \"retained\": [\"Use one persistent OpenMP team with static 32-body tile work sharing.\", \"Cache inverse-distance cubes for one source band and reuse them for opposite interactions while preserving each body's original accumulation order and arithmetic expressions.\", \"Use O(n) scratch storage and retain direct-computation fallback paths.\"]}, \"mean_seconds\": 0.11181050632148981, \"diff\": \"diff --git a/src/nbody.c b/src/nbody.c\\nindex 765bd6a..e9e767b 100644\\n--- a/src/nbody.c\\n+++ b/src/nbody.c\\n@@ -7,39 +7,225 @@\\n #define DT 0.01f // time step\\n #define SOFTENING 1e-9f // to avoid zero divisors\\n \\n+enum { PAIR_TILE = 32, PARALLEL_THRESHOLD = 256 };\\n+\\n /*\\n  * Each body holds coordinate positions (i.e., x, y, and z) and\\n  * velocities (i.e., vx, vy, and vz).\\n  */\\n typedef struct { float x, y, z, vx, vy, vz; } Body;\\n+typedef struct { float x, y, z; } Force;\\n \\n-/*\\n- * Compute the gravitational impact among all pairs of bodies in \\n- * the system.\\n- */\\n+static inline Force force_row(const Body *p, int i, int n) {\\n+  float fx = 0.0f;\\n+  float fy = 0.0f;\\n+  float fz = 0.0f;\\n+  const float x = p[i].x;\\n+  const float y = p[i].y;\\n+  const float z = p[i].z;\\n+\\n+  for (int j = 0; j < n; ++j) {\\n+    float dx = p[j].x - x;\\n+    float dy = p[j].y - y;\\n+    float dz = p[j].z - z;\\n+    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n+    float inv_dist = 1 / sqrt(sqrd_dist);\\n+    float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n+\\n+    fx += dx * inv_dist3;\\n+    fy += dy * inv_dist3;\\n+    fz += dz * inv_dist3;\\n+  }\\n+\\n+  Force result = {fx, fy, fz};\\n+  return result;\\n+}\\n+\\n+/* Compute forces without integrating positions. */\\n void body_force(Body *p, float dt, int n) {\\n+  #pragma omp parallel for schedule(static) if(n >= PARALLEL_THRESHOLD)\\n   for (int i = 0; i < n; ++i) {\\n-    float fx = 0.0f; \\n-    float fy = 0.0f; \\n-    float fz = 0.0f;\\n-\\n-    for (int j = 0; j < n; j++) {\\n-      float dx = p[j].x - p[i].x;\\n-      float dy = p[j].y - p[i].y;\\n-      float dz = p[j].z - p[i].z;\\n-      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n-      float inv_dist = 1 / sqrt(sqrd_dist);\\n-      float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n-\\n-      fx += dx * inv_dist3; \\n-      fy += dy * inv_dist3; \\n-      fz += dz * inv_dist3;\\n+    Force f = force_row(p, i, n);\\n+    p[i].vx += dt*f.x;\\n+    p[i].vy += dt*f.y;\\n+    p[i].vz += dt*f.z;\\n+  }\\n+}\\n+\\n+static void simulate_direct(Body *p, float dt, int n, int steps) {\\n+  #pragma omp parallel if(n >= PARALLEL_THRESHOLD)\\n+  {\\n+    for (int iter = 0; iter < steps; ++iter) {\\n+      #pragma omp for schedule(static)\\n+      for (int i = 0; i < n; ++i) {\\n+        Force f = force_row(p, i, n);\\n+        p[i].vx += dt*f.x;\\n+        p[i].vy += dt*f.y;\\n+        p[i].vz += dt*f.z;\\n+      }\\n+\\n+      #pragma omp for schedule(static)\\n+      for (int i = 0; i < n; ++i) {\\n+        p[i].x += p[i].vx * dt;\\n+        p[i].y += p[i].vy * dt;\\n+        p[i].z += p[i].vz * dt;\\n+      }\\n     }\\n+  }\\n+}\\n+\\n+static void simulate(Body *p, float dt, int n, int steps) {\\n+  if (n <= 0 || steps <= 0) return;\\n+  if (n < PARALLEL_THRESHOLD) {\\n+    simulate_direct(p, dt, n, steps);\\n+    return;\\n+  }\\n+\\n+  const int ntiles = n / PAIR_TILE + (n % PAIR_TILE != 0);\\n+  Force *partial = (Force *)malloc((size_t)n * sizeof(*partial));\\n+  float *cache = (float *)malloc((size_t)ntiles * PAIR_TILE * PAIR_TILE * sizeof(*cache));\\n+  if (partial == NULL || cache == NULL) {\\n+    free(cache);\\n+    free(partial);\\n+    simulate_direct(p, dt, n, steps);\\n+    return;\\n+  }\\n \\n-    p[i].vx += dt*fx; \\n-    p[i].vy += dt*fy; \\n-    p[i].vz += dt*fz;\\n+  int nonfinite = 0;\\n+  #pragma omp parallel\\n+  {\\n+    for (int iter = 0; iter < steps; ++iter) {\\n+      #pragma omp single\\n+      {\\n+        nonfinite = 0;\\n+      }\\n+\\n+      #pragma omp for schedule(static) reduction(|:nonfinite)\\n+      for (int i = 0; i < n; ++i) {\\n+        partial[i].x = 0.0f;\\n+        partial[i].y = 0.0f;\\n+        partial[i].z = 0.0f;\\n+        if (!isfinite(p[i].x) || !isfinite(p[i].y) || !isfinite(p[i].z)) {\\n+          nonfinite |= 1;\\n+        }\\n+      }\\n+\\n+      if (nonfinite) {\\n+        #pragma omp for schedule(static)\\n+        for (int i = 0; i < n; ++i) {\\n+          partial[i] = force_row(p, i, n);\\n+        }\\n+      } else {\\n+        /*\\n+         * Completed source bands form an ordered prefix for every row.\\n+         * Each off-diagonal tile has one owner. Its inverse distances\\n+         * are reused when completing the opposite rows after the barrier.\\n+         */\\n+        for (int band = 0; band < ntiles; ++band) {\\n+          const int begin = band * PAIR_TILE;\\n+          const int end = (n - begin < PAIR_TILE) ? n : begin + PAIR_TILE;\\n+\\n+          #pragma omp for schedule(static)\\n+          for (int tile = band + 1; tile < ntiles; ++tile) {\\n+            const int target_begin = tile * PAIR_TILE;\\n+            const int target_end = (n - target_begin < PAIR_TILE)\\n+                                 ? n : target_begin + PAIR_TILE;\\n+            float *tile_cache = cache + (size_t)tile * PAIR_TILE * PAIR_TILE;\\n+\\n+            for (int j = target_begin; j < target_end; ++j) {\\n+              const float x = p[j].x;\\n+              const float y = p[j].y;\\n+              const float z = p[j].z;\\n+              float fx = partial[j].x;\\n+              float fy = partial[j].y;\\n+              float fz = partial[j].z;\\n+\\n+              for (int i = begin; i < end; ++i) {\\n+                float dx = p[i].x - x;\\n+                float dy = p[i].y - y;\\n+                float dz = p[i].z - z;\\n+                float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n+                float inv_dist = 1 / sqrt(sqrd_dist);\\n+                float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n+\\n+                fx += dx * inv_dist3;\\n+                fy += dy * inv_dist3;\\n+                fz += dz * inv_dist3;\\n+                tile_cache[(size_t)(i - begin) * PAIR_TILE + (j - target_begin)] = inv_dist3;\\n+              }\\n+\\n+              partial[j].x = fx;\\n+              partial[j].y = fy;\\n+              partial[j].z = fz;\\n+            }\\n+          }\\n+\\n+          #pragma omp for schedule(static)\\n+          for (int i = begin; i < end; ++i) {\\n+            const float x = p[i].x;\\n+            const float y = p[i].y;\\n+            const float z = p[i].z;\\n+            float fx = partial[i].x;\\n+            float fy = partial[i].y;\\n+            float fz = partial[i].z;\\n+\\n+            fo\"}], \"interactions\": [{\"sources\": [\"090e6aa3bb904532\", \"10127d889534436f\", \"e626fd404b954294\"], \"outcome\": {\"binary_sha256\": \"727bd70f2394066f1a569580548facedf535d6ef91407a01a311fa87b1093291\", \"cache_key\": \"ceb9d044e1cd26279ae9757507eb05e316db0a8f431cf979a789e9a4f3990517\", \"commit\": \"e6278cf9ad1fe2a2391de81e7cb1777ade808a80\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-harness-20261015-r2-launchfix1/results-747885/mixed-harness/nbody/logs/e1/48d86b4585ce455d/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-harness-20261015-r2-launchfix1/results-747885/mixed-harness/nbody/logs/e1/48d86b4585ce455d/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max
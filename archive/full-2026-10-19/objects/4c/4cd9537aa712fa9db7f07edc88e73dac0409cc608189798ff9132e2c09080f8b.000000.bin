        "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdio>\n#include <memory>\n\nclass FastInput {\n    unsigned char buffer_[1u << 16];\n    std::size_t position_ = 0;\n    std::size_t length_ = 0;\n\n    int getChar() {\n        if (position_ == length_) {\n            length_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (length_ == 0) return EOF;\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    int nextInt() {\n        int c = getChar();\n        while (c != EOF && c <= ' ') c = getChar();\n        if (c == EOF) return 0;\n\n        const bool negative = c == '-';\n        if (c == '-' || c == '+') c = getChar();\n        long long value = 0;\n        while (c >= '0' && c <= '9') {\n            value = value * 10 + (c - '0');\n            c = getChar();\n        }\n        return static_cast<int>(negative ? -value : value);\n    }\n};\n\nstatic void readHorizontal(FastInput& input, int n, int s,\n                           int* window, long long* result) {\n    long long sum = 0;\n    for (int column = 0; column < s; ++column) {\n        const int value = input.nextInt();\n        window[column] = value;\n        sum += value;\n    }\n    result[0] = sum;\n\n    int oldest = 0;\n    const int count = n - s + 1;\n    for (int column = 1; column < count; ++column) {\n        const int value = input.nextInt();\n        sum += static_cast<long long>(value) - window[oldest];\n        window[oldest] = value;\n        if (++oldest == s) oldest = 0;\n        result[column] = sum;\n    }\n}\n\nint main() {\n    FastInput input;\n    const int n = input.nextInt();\n    const int s = input.nextInt();\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const int columns = n - s + 1;\n    const int departingRows = n - s;\n    const int depth = std::min(s, departingRows);\n\n    std::unique_ptr<int[]> window(new int[s]);\n    std::unique_ptr<long long[]> incoming(new long long[columns]);\n    std::unique_ptr<long long[]> totals(new long long[columns]());\n    std::unique_ptr<long long[]> history(\n        new long long[static_cast<std::size_t>(depth) * columns]);\n\n    // Only rows below n-s can ever leave a completed vertical window.\n    // Write retained rows directly into history, without clearing it first.\n    for (int row = 0; row < s; ++row) {\n        long long* values = row < depth\n            ? history.get() + static_cast<std::size_t>(row) * columns\n            : incoming.get();\n        readHorizontal(input, n, s, window.get(), values);\n        for (int column = 0; column < columns; ++column) {\n            totals[column] += values[column];\n        }\n    }\n\n    long long best = totals[0];\n    for (int column = 1; column < columns; ++column) {\n        if (totals[column] > best) best = totals[column];\n    }\n\n    int slot = 0;\n    for (int row = s; row < n; ++row) {\n        readHorizontal(input, n, s, window.get(), incoming.get());\n        long long* leaving = history.get()\n            + static_cast<std::size_t>(slot) * columns;\n\n        if (row < departingRows) {\n            for (int column = 0; column < columns; ++column) {\n                const long long value = incoming[column];\n                const long long updated = totals[column] - leaving[column] + value;\n                totals[column] = updated;\n                leaving[column] = value;\n                if (updated > best) best = updated;\n            }\n        } else {\n            for (int column = 0; column < columns; ++column) {\n                const long long updated = totals[column] - leaving[column]\n                                        + incoming[column];\n                totals[column] = updated;\n                if (updated > best) best = updated;\n            }\n        }\n        if (++slot == depth) slot = 0;\n    }\n\n    std::printf(\"%lld\\n\", best);\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }
    ],
    "hypothesis": "Horizontal-first streaming with a compact FIFO should improve locality and expose independent contiguous vertical updates, while retaining only min(S,N-S) rows of window sums.",

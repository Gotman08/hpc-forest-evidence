/*
    This program solves Laplace's equation on a regular 2D grid using simple Jacobi iteration.

    The stencil calculation stops when  ( err >= CONV_THRESHOLD OR  iter > ITER_MAX )
*/
#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <sys/time.h>

#define CONV_THRESHOLD 1.0e-5f // threshold of convergence

// Matrix to be solved, stored contiguously in row-major order.
double *grid;

// Auxiliary matrix, stored contiguously in row-major order.
double *new_grid;

// Size of each side of the grid.
int size;
int iter_max_num;

// Return the absolute value of a number.
double absolute(double num){
    if(num < 0)
        return -1.0 * num;
    return num;
}

// Allocate contiguous memory for both grids.
void allocate_memory(){
    size_t cells = (size_t)size * (size_t)size;
    grid = (double *) malloc(cells * sizeof(double));
    new_grid = (double *) malloc(cells * sizeof(double));
}

// Initialize both buffers identically so their fixed boundaries remain valid after swaps.
void initialize_grid(){
    int center = size / 2;
    int linf = center - (size / 10);
    int lsup = center + (size / 10);
    for (int i = 0; i < size; i++){
        size_t row = (size_t)i * (size_t)size;
        for (int j = 0; j < size; j++){
            size_t index = row + (size_t)j;
            // inicializa região de calor no centro do grid
            double initial_value;
            if (i >= linf && i <= lsup && j >= linf && j <= lsup)
                initial_value = 100;
            else
                initial_value = 0;
            grid[index] = initial_value;
            new_grid[index] = initial_value;
        }
    }
}

// Save the grid in a file.
void save_grid(){
    for(int i = 0; i < size; i++){
        size_t index = (size_t)i * (size_t)size;
        for(int j = 0; j < size; j++){
            fprintf(stdout, "%lf ", grid[index++]);
        }
        fprintf(stdout, "\n");
    }
}

int main(int argc, char *argv[]){
    fscanf(stdin, "%d", &size);
    fscanf(stdin, "%d", &iter_max_num);

    int hasError = 1;
    int iter = 0;
    int keepGoing = 1;
    int hasComputedIteration = 0;

    struct timeval time_start;
    struct timeval time_end;

    // Allocate memory to the grid (matrix).
    allocate_memory();

    // Set grid initial conditions.
    initialize_grid();

    // Jacobi iteration using one OpenMP team for the complete solve.
    // Swap the completed buffer before checking the next iteration condition.
    #pragma omp parallel if(size >= 64 && iter_max_num > 0) default(none) shared(grid, new_grid, size, iter_max_num, hasError, iter, keepGoing, hasComputedIteration)
    {
        while (1) {
            #pragma omp single
            {
                if (hasComputedIteration) {
                    double *temp_grid = grid;
                    grid = new_grid;
                    new_grid = temp_grid;
                    ++iter;
                    hasComputedIteration = 0;
                }

                keepGoing = hasError && iter < iter_max_num;
                if (keepGoing) {
                    hasError = 0;
                    hasComputedIteration = 1;
                }
            }
            if (!keepGoing)
                break;

            const double * restrict current_grid = grid;
            double * restrict next_grid = new_grid;

            // Calculate the next grid and combine the convergence flag.
            #pragma omp for schedule(static) reduction(|:hasError)
            for (int i = 1; i < size - 1; i++) {
                size_t row = (size_t)i * (size_t)size;
                size_t north = row - (size_t)size;
                size_t south = row + (size_t)size;
                int row_has_error = 0;

                #pragma omp simd reduction(|:row_has_error)
                for (int j = 1; j < size - 1; j++) {
                    size_t index = row + (size_t)j;
                    next_grid[index] = 0.25 * (current_grid[index + 1] + current_grid[index - 1] +
                                                current_grid[north + (size_t)j] + current_grid[south + (size_t)j]);

                    double errorCurrent = absolute(next_grid[index] - current_grid[index]);
                    if (errorCurrent > CONV_THRESHOLD) {
                        row_has_error = 1;
                    }
                }
                hasError |= row_has_error;
            }
        }
    }

    // Save the final grid.
    save_grid();

    return 0;
}

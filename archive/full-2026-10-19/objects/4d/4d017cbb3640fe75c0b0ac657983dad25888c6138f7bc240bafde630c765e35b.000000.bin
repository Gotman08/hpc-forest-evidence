"""Seal only own prepared reader/test/diff artifacts; do not run the reader main."""
import ast
import difflib
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
OLD = HERE.parent / "restaurer-livraison-reguliere-froide.py"
NEW = HERE / "restaurer-livraison-reguliere-froide-r2.py"


def ref(path):
    return {"path": str(path), "sha256": hashlib.sha256(path.read_bytes()).hexdigest(), "bytes": path.stat().st_size}


def save(name, value):
    with (HERE / name).open("x", encoding="utf8", newline="\n") as out:
        json.dump(value, out, indent=2, ensure_ascii=True); out.write("\n")


assert ref(OLD)["sha256"] == "6febf825ec63da05c9408529d99796beceb58a90c0944179b803f999bffd1a5a"
assert ref(NEW)["sha256"] == "0a0440425164586836e8951266638142ed6c7fe15347b4ac03109e5cfb9575e9"
old, new = OLD.read_text(encoding="utf8"), NEW.read_text(encoding="utf8")
old_functions = {n.name: ast.dump(n) for n in ast.parse(old).body if isinstance(n, ast.FunctionDef)}
new_functions = {n.name: ast.dump(n) for n in ast.parse(new).body if isinstance(n, ast.FunctionDef)}
changed = sorted(k for k in old_functions if old_functions[k] != new_functions[k])
assert changed == ["main", "ordinary", "raw"]
normalized = new.replace('with tarfile.open(fileobj=io.BytesIO(archive_raw), mode="r:gz") as stream:',
                         'with tarfile.open(args.archive, "r:gz") as stream:')
normalized_main = next(n for n in ast.parse(normalized).body if isinstance(n, ast.FunctionDef) and n.name == "main")
assert ast.dump(normalized_main) == old_functions["main"]
assert set(new_functions) - set(old_functions) == {"metadata", "open_nofollow_read"}
patch = "".join(difflib.unified_diff(old.splitlines(keepends=True), new.splitlines(keepends=True),
                                  fromfile="refused-6feb.py", tofile="isolated-reader-r2.py"))
with (HERE / "DIFF-LECTEUR-REFUSE-R1-VERS-R2.patch").open("x", encoding="utf8", newline="\n") as out:
    out.write(patch)
save("DELTA-FERME-LECTEUR-R2.json", {"schema": "hpc-forest-Q753709-cold-reader-closed-delta-v1",
    "old_refused_reader": ref(OLD), "new_prepared_reader": ref(NEW),
    "changed_functions": changed, "new_functions": ["metadata", "open_nofollow_read"],
    "unchanged_function_ASTs": sorted(k for k in old_functions if k not in changed),
    "main_AST_identical_after_normalizing_only_tar_BytesIO_binding": True,
    "module_delta": ["import io", "new nested-reader HERE/REVIEW/Q anchor"],
    "closed_fixes": ["hashed archive bytes used through BytesIO; no mutable path reopening",
                     "one no-follow held fd, Windows reparse handle attributes and full fstat/lstat metadata",
                     "parent traversal rejected before filesystem access, canonical Q and HERE boundaries"],
    "old_source_and_refusal_preserved": True, "main_executed": False})
test = json.loads((HERE / "TESTS-NEUTRES-LECTEUR-R2.json").read_bytes())
assert test["tests_run"] == 8 and test["passed"] is True and test["reader_sha256"] == ref(NEW)["sha256"]
files = [p for p in HERE.iterdir() if p.is_file() and p.name != "LIVRAISON-LECTEUR-R2-POUR-REVUE.json"]
save("LIVRAISON-LECTEUR-R2-POUR-REVUE.json", {"schema": "hpc-forest-Q753709-cold-reader-r2-preparation-v1",
    "prepared_only": True, "files": {p.name: ref(p) for p in sorted(files)},
    "reader": ref(NEW), "old6feb_preserved": True, "targeted_neutral_cases": 8,
    "received_Q265_tests_replayed": False, "received_archive_opened_or_restored": False,
    "reader_main_executed": False, "independent_review_still_required_before_main": True,
    "complete_Q_or_native_admission": False,
    "interface": ["--receipt", "--receipt-sha256", "--archive", "--sidecar-directory", "--restoration"],
    "restoration_boundary": str(HERE),
    "third_remote_SHA_remains_separate_required_evidence": True})
print(json.dumps({"delivery": ref(HERE / "LIVRAISON-LECTEUR-R2-POUR-REVUE.json")}))

"""Private finalizer tests with synthetic paths, no catalog/auth/CLI/model read."""
import hashlib
import importlib.util
import json
from pathlib import Path

import pytest

HERE=Path(__file__).resolve().parent
spec=importlib.util.spec_from_file_location('private_r4b_policy',HERE/'preparer-politiques-locales.py')
p=importlib.util.module_from_spec(spec)
spec.loader.exec_module(p)


@pytest.mark.parametrize('model',tuple(p.CELLS))
@pytest.mark.parametrize('phase',('roots','advice','harvest'))
def test_nine_exact_eight_field_bindings(model,phase):
    binding=p.binding_for(model,'999999',phase=phase)
    assert len(binding)==8 and binding['session_id']==p.CELLS[model][phase]
    assert p.binding_for(model,'999999',session_id=binding['session_id'])==binding
    assert binding['scope_id']=='hpc-forest-dynamic-independent-roots-r4b-max'


def test_source_and_base_are_actual_workspace_without_reading_catalog():
    assert p.BASE==HERE.parents[3]
    assert p.LOADER==p.BASE/'work/hpc-forest-mere-dynamique-r4b-lane-r3/project/src/hpc_forest/codex_process.py'
    assert hashlib.sha256(p.LOADER.read_bytes()).hexdigest()==p.LOADER_SHA


def test_unknown_session_cannot_reuse_G_or_another_model():
    with pytest.raises(ValueError):p.binding_for('gpt-6-astra','999999',session_id='110cefccf16b439eb226e475c875c8df')


def test_policy_genuine_source_loader_closure_with_only_synthetic_selector(tmp_path):
    binding=p.binding_for('gpt-6-astra','999999',phase='roots')
    policy=p.policy_for(binding,['X:/NEUTRAL/skill'])
    path=tmp_path/('cli-policy-'+binding['session_id']+'.json')
    path.write_text(json.dumps(policy))
    checksum=hashlib.sha256(path.read_bytes()).hexdigest()
    p.validate_with_pinned_loader(path,checksum,binding)
    assert policy['cli_feature_overrides']['code_mode_host'] is True
    assert len(policy['cli_feature_overrides'])==22
    assert sum(policy['cli_feature_overrides'].values())==1
    assert policy['instruction_or_SKILL_body_read'] is False


@pytest.mark.parametrize('key,value',[('code_mode',True),('code_mode_host',False),('code_mode_host',1)])
def test_exact_loader_refuses_feature_changes(tmp_path,key,value):
    binding=p.binding_for('gpt-6-astra','999999',phase='roots')
    policy=p.policy_for(binding,['X:/NEUTRAL/skill']);policy['cli_feature_overrides'][key]=value
    path=tmp_path/('cli-policy-'+binding['session_id']+'.json');path.write_text(json.dumps(policy))
    with pytest.raises(ValueError):p.validate_with_pinned_loader(path,hashlib.sha256(path.read_bytes()).hexdigest(),binding)

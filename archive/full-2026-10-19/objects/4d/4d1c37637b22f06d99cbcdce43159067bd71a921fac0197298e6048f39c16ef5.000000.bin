    while (c >= '0' && c <= '9') {\\n+        x = x * 10 + (c - '0');\\n+        c = getChar();\\n+    }\\n+    return sign * x;\\n+}\\n \\n int main() {\\n-\\tint n,s;\\n-\\tstd::cin >> n >> s;\\n-\\tstd::vector<std::vector<int> > matrix(n, std::vector<int>(n));\\n-\\tfor(int i=0;i<n;i++)\\n-\\t\\tfor(int j=0;j<n;j++) \\n-\\t\\t\\tscanf(\\\"%d\\\", &(matrix[i][j]));\\n-\\n-\\tassert(s<n);\\n-\\tassert(n<8000);\\n-\\tassert(s>0);\\n-\\tassert(n>0);\\n-\\n-\\tint sum = 0;\\n-\\tfor(int i=0;i<s;i++)\\n-\\t\\tfor(int j=0;j<s;j++)\\n-\\t\\t\\tsum += matrix[i][j];\\n-\\n-\\tint mxSum = sum;\\n-\\n-\\tint dir = 1;\\n-\\tint i = 0;\\n-\\tint j = 0;\\n-\\twhile(i+s <= n) {\\n-\\t\\tif( (j+s == n && dir==1) || (j==0 && dir==-1) ) { \\n-\\t\\t\\tint exitingRow = i;\\n-\\t\\t\\tint enteringRow = exitingRow+s;\\n-\\t\\t\\tif(enteringRow >=n) break;\\n-\\n-\\t\\t\\tfor(int k=0;k<s;k++) { sum -= matrix[exitingRow][k+j]; } \\n-\\t\\t\\tfor(int k=0;k<s;k++) { sum += matrix[enteringRow][k+j];\\t} \\n-\\t\\t\\t\\n-\\t\\t\\ti++;\\n-\\t\\t\\tdir*=-1;\\n-\\t\\t} else {\\n-\\t\\t\\tint exitingCol,enteringCol;\\n-\\t\\t\\tif(dir==1) {\\n-\\t\\t\\t\\texitingCol = j;\\n-\\t\\t\\t\\tenteringCol = exitingCol + s;\\n-\\t\\t\\t} else {\\n-\\t\\t\\t\\tenteringCol = j-1;\\n-\\t\\t\\t\\texitingCol = enteringCol + s;\\n-\\t\\t\\t}\\n-\\n-\\t\\t\\tfor(int k=0;k<s;k++) {sum -= matrix[k+i][exitingCol]; } \\n-\\t\\t\\tfor(int k=0;k<s;k++) {sum += matrix[k+i][enteringCol];\\t} \\n-\\t\\t\\tj+=dir;\\n-\\t\\t}\\n-\\t\\tmxSum = std::max(mxSum,sum);\\n-\\t}\\n-\\tprintf(\\\"%d\\\\n\\\",mxSum);\\n-}\\n\\\\ No newline at end of file\\n+    int n = readInt();\\n+    int s = readInt();\\n+    assert(s < n && s > 0 && n > 0 && n < 8000);\\n+\\n+    std::vector<int> pref((n + 1) * n, 0);\\n+    std::vector<int> row(n);\\n+\\n+    for (int i = 1; i <= n; ++i) {\\n+        for (int j = 0; j < n; ++j) {\\n+            row[j] = readInt();\\n+        }\\n+        const int curRow = i * n;\\n+        const int prevRow = (i - 1) * n;\\n+        #pragma omp simd\\n+        for (int j = 0; j < n; ++j) {\\n+            pref[curRow + j] = pref[prevRow + j] + row[j];\\n+        }\\n+    }\\n+\\n+    int mxSum = INT_MIN;\\n+\\n+    #pragma omp parallel for reduction(max:mxSum) schedule(static)\\n+    for (int i = 0; i <= n - s; ++i) {\\n+        const int rowStart = i * n;\\n+        const int rowEnd   = (i + s) * n;\\n+\\n+        int window = 0;\\n+        for (int j = 0; j < s; ++j) {\\n+            window += pref[rowEnd + j] - pref[rowStart + j];\\n+        }\\n+        int curMax = window;\\n+\\n+        for (int j = s; j < n; ++j) {\\n+            window += (pref[rowEnd + j] - pref[rowStart + j])\\n+                    - (pref[rowEnd + (j - s)] - pref[rowStart + (j - s)]);\\n+            if (window > curMax) curMax = window;\\n+        }\\n+\\n+        if (curMax > mxSum) mxSum = curMax;\\n+    }\\n+\\n+    printf(\\\"%d\\\\n\\\", mxSum);\\n+    return 0;\\n+}\"}], \"interactions\": [{\"sources\": [\"aec6b1a40d3046d2\", \"a5850332c2144560\", \"2d8da312c5194b7e\"], \"outcome\": {\"binary_sha256\": \"1605743ca5fe3d0ef4ed91381cfdf4084890ace056415db4a8fb08d26f405e36\", \"cache_key\": \"5131cd14d8a6d82f02e4ddd0b8d4b495f90a77e50eee5a319bd539825f461605\", \"commit\": \"f917227647cb1cc9e170ecc9830ffb8e675ac424\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/sum/logs/e1/a8a1165d375b4a5a/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/sum/logs/e1/a8a1165d375b4a5a/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/sum/logs/e1/a8a1165d375b4a5a/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash0731/results-747505/sum/logs/e1/a8a1165d375b4a5a/search/attempt-001/sample-0.log\", \"/gpfs/scratc
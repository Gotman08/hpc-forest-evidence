#!/usr/bin/env bash
# Genere par romeo-mcp - ne pas editer a la main.
#SBATCH --job-name=forest-primes-native-contract-qual-r1
#SBATCH --account=r250127
#SBATCH --qos=normal
#SBATCH --partition=instant
#SBATCH --constraint=armgpu
#SBATCH --time=00:15:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --chdir=/scratch_p/nimarano
#SBATCH --output=/scratch_p/nimarano/%x-%j.out
#SBATCH --error=/scratch_p/nimarano/%x-%j.err

set -euo pipefail

# Sans cette fonction, un job ROMEO 2025 n'a acces a aucun logiciel,
# pas meme a la commande spack. Elle est propre a l'architecture :
# charger celle de l'autre donnerait des binaires inutilisables.
romeo_load_armgpu_env

# Provenance du premier demarrage : environnement, commit et fichiers choisis.
if command -v python3 >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
  if timeout 20s python3 -I -S - '{"roots": ["/scratch_p/nimarano", "/project"], "include_home": true, "code_dir": "/scratch_p/nimarano", "data_files": ["/scratch_p/nimarano/hpc-forest-primes-native-max-1e17d198d5a2ae66.tar.gz"], "max_bytes": 67108864}' <<'ROMEO_REPRO_CAPTURE'

import hashlib, json, os, pathlib, re, stat, subprocess, sys
params = json.loads(sys.argv[1])
roots = [pathlib.Path(p).resolve() for p in params['roots']]
if params.get('include_home'):
    roots.append(pathlib.Path.home().resolve())
def allowed(value):
    path = pathlib.Path(value).resolve()
    if not any(path == root or root in path.parents for root in roots):
        raise ValueError('outside_roots')
    if any(p.lower().startswith(('.env', 'id_rsa', 'id_ed25519', 'id_ecdsa')) or p.lower() in ('.ssh', '.aws', '.azure', '.kube', 'hosts.yml')
           or p.lower().endswith(('.pem', '.key', '.p12', '.pfx'))
           or re.search(r'password|passwd|passphrase|secret|token|credential|authorization|cookie|api[_-]?key|access[_-]?key|private[_-]?key', p, re.I)
           for p in path.parts):
        raise ValueError('sensitive_path')
    return path
out = {'git': {'status': 'unavailable'}, 'data': []}
try:
    code = allowed(params['code_dir'])
    result = subprocess.run(['git', '-c', 'core.fsmonitor=false', '-C', str(code),
                             'rev-parse', '--verify', 'HEAD'],
                            capture_output=True, text=True, timeout=5,
                            env={**os.environ, 'GIT_OPTIONAL_LOCKS': '0'})
    sha = result.stdout.strip()
    if result.returncode == 0 and len(sha) in (40, 64) and all(c in '0123456789abcdef' for c in sha):
        out['git'] = {'status': 'observed', 'commit': sha, 'working_tree_verified': False}
except (OSError, ValueError, subprocess.TimeoutExpired):
    pass
remaining = params['max_bytes']
for name in params['data_files']:
    item = {'path': name}
    try:
        path = allowed(name)
        info = path.stat()
        if not stat.S_ISREG(info.st_mode):
            item['status'] = 'not_regular_file'
        elif info.st_size > remaining:
            item.update(status='size_limit', bytes=info.st_size)
        else:
            h = hashlib.sha256()
            consumed = 0
            with path.open('rb') as stream:
                while True:
                    block = stream.read(min(1048576, remaining - consumed + 1))
                    if not block:
                        break
                    consumed += len(block)
                    if consumed > remaining:
                        break
                    h.update(block)
            after = path.stat()
            remaining = max(0, remaining - consumed)
            if consumed != info.st_size or (info.st_size, info.st_mtime_ns, info.st_ino) != (after.st_size, after.st_mtime_ns, after.st_ino):
                item['status'] = 'changed_during_read'
            else:
                item.update(status='hashed', sha256=h.hexdigest(), bytes=consumed)
    except (OSError, ValueError):
        item['status'] = 'unreadable_or_outside_roots'
    out['data'].append(item)


import datetime, platform
out['observed_at'] = datetime.datetime.now(datetime.timezone.utc).isoformat()
out['phase'] = 'before_workload'
out['environment'] = {
    'source': 'compute_node_before_command', 'architecture': platform.machine(),
    'python_version': platform.python_version(),
    'loaded_modules': [v for v in os.environ.get('LOADEDMODULES', '').split(':') if v][:128],
    'spack_loaded_hashes': [v for v in os.environ.get('SPACK_LOADED_HASHES', '').split(':') if v][:128],
}
jid = os.environ.get('SLURM_JOB_ID', '')
if os.environ.get('SLURM_ARRAY_JOB_ID') and os.environ.get('SLURM_ARRAY_TASK_ID'):
    jid = os.environ['SLURM_ARRAY_JOB_ID'] + '_' + os.environ['SLURM_ARRAY_TASK_ID']
if not re.fullmatch(r'[0-9]+(?:_[0-9]+)?', jid):
    raise ValueError('missing_job_id')
out['job_id'] = jid
folder = pathlib.Path('.romeo-provenance')
folder.mkdir(mode=0o700, exist_ok=True)
if folder.is_symlink():
    raise ValueError('symlink_capture_directory')
out['restart_count'] = os.environ.get('SLURM_RESTART_COUNT', '0')
try:
    fd = os.open(folder / (jid + '.json'), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
except FileExistsError:
    pass
else:
    with os.fdopen(fd, 'w') as stream:
        json.dump(out, stream)
        stream.write('\n')
ROMEO_REPRO_CAPTURE
  then :; else
    printf '%s\n' '[romeo-mcp] provenance indisponible ; le calcul continue.' >&2
  fi
fi


# Trace d'execution : sert a diagnostiquer les erreurs d'architecture.
echo "[romeo-mcp] noeud=$(hostname) arch=$(uname -m) job=${SLURM_JOB_ID:-?}"
echo "[romeo-mcp] debut $(date -Is)"

set -euo pipefail
[[ ${SLURM_JOB_ID:-} =~ ^[0-9]+$ ]] || { echo 'Existing Slurm allocation required' >&2; exit 70; }
[[ ${SLURM_JOB_NUM_NODES:-} == 1 && ${SLURM_NTASKS:-} == 1 && ${SLURM_CPUS_PER_TASK:-} == 4 && ${SLURM_MEM_PER_NODE:-} == 16384 ]] || { echo 'Exact 1node/1task/4CPU/16Gi allocation required' >&2; exit 71; }
[[ ${SLURM_RESTART_COUNT:-0} == 0 ]] || { echo 'No Slurm replay allowed' >&2; exit 72; }
export PYTHONDONTWRITEBYTECODE=1
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=4
srun --nodes=1 --ntasks=1 --cpus-per-task=4 --cpu-bind=cores /scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python -I -B - <<'R2MAX_FINAL_CONTRACT_QUALIFICATION'
"""Allocated mechanical envelope only. No native calls, transport, install or retry."""
from __future__ import annotations

import hashlib
import io
import json
import os
import platform
import re
import shlex
import subprocess
import sys
import tarfile
import traceback
import zipfile
from datetime import UTC, datetime, timedelta
from pathlib import Path, PurePosixPath

SCOPE = "hpc-forest-primes-native-max-r1"
DEADLINE = datetime(2026, 10, 31, 23, tzinfo=UTC)
PYTHON = "/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python"
SPACK_GCC = "/zrtbeqke25s2vbqo4yrhsowjz7mg3pjf"
PREPARATION_SHA = "d260af0a7b91cbe5fc7e3ab1ad9313723e385c21fdd75bd5c9623095683022fd"
REFERENCE_SHA = "70e15be0d677eb40d700c3c09c20dc4d2db50132fbf9a2a4d30fb37bd3014f6d"
FLAGS = ["-O2", "-std=c11", "-Werror=uninitialized", "-Werror=maybe-uninitialized", "-lm"]
MAX_BYTES = 64 * 1024**2
MAX_MEMBER_BYTES = 8 * 1024**2


def require(value, message):
    if not value:
        raise RuntimeError(message)


def digest(raw):
    return hashlib.sha256(raw).hexdigest()


def file_sha(path):
    return digest(path.read_bytes())


def deadline_guard(now=None):
    now = datetime.now(UTC) if now is None else now
    require(now + timedelta(seconds=900 + 10800) < DEADLINE,
            "15-minute qualification plus three-hour reception/audit reserve exceeds exclusive deadline")


def allocation_guard():
    """Must run before any creation, extraction, Spack, subprocess or compiler."""
    env = os.environ
    require(platform.system() == "Linux" and platform.machine().lower() in {"aarch64", "arm64"},
            "Own Linux ARM64 compute allocation required")
    require(re.fullmatch(r"[0-9]+", env.get("SLURM_JOB_ID", "")), "Concrete Slurm job required")
    expected = {"SLURM_JOB_NUM_NODES": "1", "SLURM_NTASKS": "1",
                "SLURM_CPUS_PER_TASK": "4", "SLURM_MEM_PER_NODE": "16384"}
    require(all(env.get(key) == value for key, value in expected.items()),
            "Exact one-node/one-task/four-CPU/16384-MiB allocation required")
    gpu_keys = ("SLURM_GPUS", "SLURM_GPUS_PER_NODE", "SLURM_JOB_GPUS", "SLURM_STEP_GPUS",
                "CUDA_VISIBLE_DEVICES")
    require(all(env.get(key, "") in {"", "0"} for key in gpu_keys), "Zero GPU allocation required")
    require(env.get("SLURM_RESTART_COUNT", "0") == "0", "An earlier Slurm attempt must not be replayed")
    require(hasattr(os, "sched_getaffinity"), "Effective affinity observation required")
    affinity = sorted(os.sched_getaffinity(0))
    require(len(affinity) == 4, "Exactly four CPUs must be present in the effective affinity")
    deadline_guard()
    return {"job_id": env["SLURM_JOB_ID"], "architecture": platform.machine().lower(),
            "nodes": 1, "tasks": 1, "cpus_per_task": 4, "memory_mib": 16384, "gpus": 0,
            "affinity_cpu_ids": affinity, "affinity_cpu_count": 4}


def canonical_name(name):
    path = PurePosixPath(name)
    require(isinstance(name, str) and name and not path.is_absolute()
            and str(path) == name and not any(part in {".", "..", ""} for part in path.parts)
            and "\\" not in name and ":" not in name
            and not any(ord(char) < 32 for char in name), "Noncanonical or unsafe archive member")
    return path


def read_tar(path, root_name, count):
    """Read regular unique members in memory before any extraction."""
    material = {}
    with tarfile.open(path, "r:gz") as archive:
        members = archive.getmembers()
        require(len(members) == count and 1 <= count <= 1000, "Unexpected bundle member count")
        total = 0
        for member in members:
            name = canonical_name(member.name)
            require(member.isfile() and not member.issym() and not member.islnk()
                    and name.parts[0] == root_name and len(name.parts) > 1,
                    "Bundle members must be regular files beneath the exact root")
            key = name.relative_to(root_name).as_posix()
            total += member.size
            require(key not in material and 0 <= member.size <= MAX_MEMBER_BYTES and total <= MAX_BYTES,
                    "Duplicate or oversized bundle member")
            stream = archive.extractfile(member)
            require(stream is not None, "Bundle member has no bytes")
            raw = stream.read(MAX_MEMBER_BYTES + 1)
            require(len(raw) == member.size, "Bundle member size differs from header")
            material[key] = raw
    return material


def read_zip(raw, expected, count):
    material = {}
    with zipfile.ZipFile(io.BytesIO(raw)) as archive:
        items = archive.infolist()
        require(len(items) == count and 1 <= count <= 1000, "Unexpected source ZIP member count")
        total = 0
        for member in items:
            name = canonical_name(member.filename)
            kind = (member.external_attr >> 16) & 0o170000
            require(not member.is_dir() and kind in {0, 0o100000}
                    and name.parts[0] == "HPC-Forest" and len(name.parts) > 1,
                    "Source ZIP must contain only regular files beneath HPC-Forest")
            key = name.relative_to("HPC-Forest").as_posix()
            total += member.file_size
            require(key not in material and member.file_size <= MAX_MEMBER_BYTES and total <= MAX_BYTES,
                    "Duplicate or oversized source ZIP member")
            with archive.open(member) as stream:
                value = stream.read(MAX_MEMBER_BYTES + 1)
            require(len(value) == member.file_size, "Source ZIP member size differs from header")
            material[key] = value
    require(isinstance(expected, dict) and set(material) == set(expected), "Runtime manifest membership changed")
    require(all(digest(value) == expected[name] for name, value in material.items()),
            "Runtime manifest/source ZIP bytes differ")
    return material


def validate_bindings(bindings):
    fields = {"schema", "status", "scope_id", "payload_path", "payload_sha256", "payload_bytes",
              "payload_root", "payload_member_count", "source_member_count", "source_zip_sha256",
              "plan_sha256", "bundle_manifest_sha256", "runtime_manifest_sha256", "remote_root",
              "delivery_sha256", "integration_review_sha256"}
    require(isinstance(bindings, dict) and set(bindings) == fields, "Exact final bindings required")
    require(bindings["schema"] == "hpc-forest-primes-r2max-qualification-bindings-v1"
            and bindings["status"] == "sealed_final_delivery_reviewed" and bindings["scope_id"] == SCOPE,
            "Unsealed or unreviewed proposal cannot run")
    for key in fields:
        if key.endswith("_sha256"):
            require(re.fullmatch(r"[a-f0-9]{64}", bindings[key]), "Invalid immutable input SHA: " + key)
    root = PurePosixPath(bindings["remote_root"])
    payload = PurePosixPath(bindings["payload_path"])
    require(root.is_absolute() and root.parent == PurePosixPath("/scratch_p/nimarano")
            and root.name.startswith("hpc-forest-primes-native-contract-qualification-")
            and root.name.endswith(bindings["payload_sha256"][:12]) and ".." not in root.parts,
            "New attempt root must be narrow, fresh and payload-bound")
    require(payload.is_absolute() and payload.parent == PurePosixPath("/scratch_p/nimarano")
            and ".." not in payload.parts and "\\" not in str(payload), "Invalid exact payload path")
    require(type(bindings["payload_bytes"]) is int and 0 < bindings["payload_bytes"] <= MAX_BYTES,
            "Invalid bounded payload size")
    require(bindings["payload_root"] == SCOPE, "Unexpected bundle root")
    for key in ("payload_member_count", "source_member_count"):
        require(type(bindings[key]) is int and 1 <= bindings[key] <= 1000, "Invalid member count")
    return Path(str(root)), Path(str(payload))


def validate_bundle(bindings, payload):
    require(payload.is_file() and not payload.is_symlink()
            and payload.stat().st_size == bindings["payload_bytes"]
            and file_sha(payload) == bindings["payload_sha256"], "Exact payload bytes/type changed")
    material = read_tar(payload, bindings["payload_root"], bindings["payload_member_count"])
    require(digest(material["proposal-bundle-manifest.json"]) == bindings["bundle_manifest_sha256"],
            "Bundle manifest changed")
    bundle = json.loads(material["proposal-bundle-manifest.json"])
    expected = bundle.get("files")
    require(bundle.get("schema") == "hpc-forest-r2max-proposal-bundle-manifest-v1"
            and isinstance(expected, dict)
            and set(material) == set(expected) | {"proposal-bundle-manifest.json"},
            "Bundle manifest membership changed")
    require(all(digest(material[name]) == value for name, value in expected.items()),
            "Bundle manifested bytes changed")
    for name, expected_sha in {
        "HPC-Forest-Primes-Natif-MAX-r1.zip": bindings["source_zip_sha256"],
        "native-max-plan.json": bindings["plan_sha256"],
        "runtime-manifest-r2max.json": bindings["runtime_manifest_sha256"],
        "certified-preparation/prototype-manifest.json": PREPARATION_SHA,
        "certified-preparation/data/model-view/primetest.c": REFERENCE_SHA,
    }.items():
        require(digest(material[name]) == expected_sha, "Pinned input changed: " + name)
    plan = json.loads(material["native-max-plan.json"])
    require(plan.get("scope_id") == SCOPE and plan.get("source_zip_sha256") == bindings["source_zip_sha256"]
            and plan.get("preparation_manifest_sha256") == PREPARATION_SHA
            and plan.get("efforts") == ["max"] and plan.get("automatic_extension") is False
            and plan.get("compiler_flags") == FLAGS, "Final R2 plan binding/flags changed")
    manifest = json.loads(material["certified-preparation/prototype-manifest.json"])
    preparation = {name.removeprefix("certified-preparation/"): raw for name, raw in material.items()
                   if name.startswith("certified-preparation/")}
    require(set(preparation) == set(manifest) | {"prototype-manifest.json"}, "Preparation membership changed")
    for name, info in manifest.items():
        require(len(preparation[name]) == info["bytes"] and digest(preparation[name]) == info["sha256"],
                "Certified preparation member changed")
    runtime_manifest = json.loads(material["runtime-manifest-r2max.json"])
    sources = read_zip(material["HPC-Forest-Primes-Natif-MAX-r1.zip"], runtime_manifest,
                       bindings["source_member_count"])
    return material, sources


def save(path, value):
    with path.open("x", encoding="utf8", newline="\n") as stream:
        json.dump(value, stream, ensure_ascii=True, indent=2)
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())


def inventory(root):
    result = {}
    for path in sorted(root.rglob("*")):
        require(not path.is_symlink(), "A live input was replaced by a link")
        if path.is_file():
            result[path.relative_to(root).as_posix()] = file_sha(path)
    return result


def write_new_tree(root, material):
    root.mkdir()
    for name, raw in material.items():
        relative = canonical_name(name)
        path = root.joinpath(*relative.parts)
        require(path.resolve().is_relative_to(root.resolve()), "Fresh extraction escaped its root")
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("xb") as stream:
            stream.write(raw)
    require(inventory(root) == {name: digest(raw) for name, raw in material.items()},
            "Freshly restored input bytes differ")


def make_command(extraction, output):
    argv = [PYTHON, "-I", "-B", str(extraction / "HPC-Forest/examples/marathon22/qualify_r2max_contract.py"),
            "--package", str(extraction / "certified-preparation"), "--output", str(output),
            "--source-zip", str(extraction / "HPC-Forest-Primes-Natif-MAX-r1.zip"),
            "--plan", str(extraction / "native-max-plan.json")]
    command = ("set -euo pipefail\nromeo_load_armgpu_env\nspack load "
               + shlex.quote(SPACK_GCC) + "\nexec " + shlex.join(argv))
    return argv, ["bash", "-lc", command]


def qualification_allocation_matches(qualified, observed):
    """Compare actual common fields; do not fabricate absent qualifier affinity fields."""
    required = ("job_id", "architecture", "nodes", "tasks", "cpus_per_task", "memory_mib", "gpus")
    return (isinstance(qualified, dict)
            and all(key in qualified and qualified[key] == observed[key] for key in required)
            and observed.get("affinity_cpu_count") == 4
            and len(observed.get("affinity_cpu_ids", [])) == 4
            and all(key not in qualified or qualified[key] == observed[key]
                    for key in ("affinity_cpu_ids", "affinity_cpu_count")))


def preserve_envelope(root, receipt):
    save(root / "envelope-receipt.json", receipt)
    paths = [p for p in sorted(root.rglob("*")) if p.is_file()]
    require(all(not p.is_symlink() for p in paths), "Refusing linked result in envelope")
    archive = root / ("envelope-results-" + os.environ["SLURM_JOB_ID"] + ".tar.gz")
    with tarfile.open(archive, "x:gz") as result:
        for path in paths:
            result.add(path, arcname="qualification-envelope/" + path.relative_to(root).as_posix(), recursive=False)
    sidecar = {"path": str(archive), "sha256": file_sha(archive), "bytes": archive.stat().st_size,
               "passed": receipt["passed"], "native_model_calls": 0, "native_research_admitted": False}
    save(root / "envelope-archive.json", sidecar)
    print(json.dumps(sidecar), flush=True)


def main(bindings):
    allocation = allocation_guard()
    root, payload = validate_bindings(bindings)
    require(not root.exists() and not root.is_symlink(), "Prior attempt exists; preserve it without replay")
    root.mkdir()
    receipt = {"schema": "hpc-forest-primes-r2max-qualification-envelope-v1", "scope_id": SCOPE,
               "started_utc": datetime.now(UTC).isoformat(), "allocation": allocation,
               "bindings": bindings, "native_model_calls": 0, "native_research_admitted": False,
               "performance_claimed": False, "qualification_launched_count": 0,
               "passed": False, "negative_preserved_no_retry": True,
               "python_executable": sys.executable, "python_version": sys.version,
               "spack_gcc_hash": SPACK_GCC, "qualification_returncode": None}
    save(root / "allocation-before-work.json", receipt)
    extraction, output, before = root / "extraction", root / "Q", None
    try:
        material, sources = validate_bundle(bindings, payload)
        write_new_tree(extraction, material)
        write_new_tree(extraction / "HPC-Forest", sources)
        before = inventory(extraction)
        save(root / "input-inventory-before.json", before)
        deadline_guard()
        allocation_guard()
        argv, command = make_command(extraction, output)
        save(root / "qualification-launch-intent.json",
             {"argv": argv, "allocated_shell_argv": command, "launch_count": 1,
              "native_model_calls": 0, "no_retry": True, "utc": datetime.now(UTC).isoformat()})
        receipt["qualification_launched_count"] = 1
        try:
            process = subprocess.run(command, capture_output=True, check=False, timeout=780,
                                     env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1",
                                          "OPENBLAS_NUM_THREADS": "1", "OMP_NUM_THREADS": "4"})
            stdout, stderr, code = process.stdout, process.stderr, process.returncode
        except subprocess.TimeoutExpired as exc:
            stdout, stderr, code = exc.stdout or b"", exc.stderr or b"", 124
            receipt["timeout"] = "Owned direct qualification process timed out; no recursive stop or retry"
        (root / "qualification-launch.stdout").write_bytes(stdout)
        (root / "qualification-launch.stderr").write_bytes(stderr)
        receipt["qualification_returncode"] = code
        qualification_path = output / "qualification.json"
        qualification_raw = qualification_path.read_bytes()
        qualification = json.loads(qualification_raw)
        # Preserve the original remote prepared_root and receipt bytes; never normalize these paths.
        receipt["qualification_path"] = str(qualification_path)
        receipt["qualification_sha256"] = digest(qualification_raw)
        receipt["prepared_root_original"] = qualification.get("prepared_root")
        receipt["qualification_allocation_original"] = qualification.get("allocation")
        receipt["qualification_archive_sidecar_sha256"] = file_sha(root / "Q-archive.json")
        inner_archive = json.loads((root / "Q-archive.json").read_text(encoding="utf8"))
        require(inner_archive.get("path") == str(root / "Q.tar.gz")
                and inner_archive.get("sha256") == file_sha(root / "Q.tar.gz")
                and inner_archive.get("native_model_calls") == 0, "Inner qualification archive proof differs")
        receipt["qualification_archive_sha256"] = inner_archive["sha256"]
        receipt["passed"] = (code == 0 and qualification.get("verified") is True
                             and qualification.get("scope_id") == SCOPE
                             and qualification.get("source_zip_sha256") == bindings["source_zip_sha256"]
                             and qualification.get("plan_sha256") == bindings["plan_sha256"]
                             and qualification.get("reference_source_sha256") == REFERENCE_SHA
                             and qualification.get("compiler_flags") == FLAGS
                             and qualification.get("preparation_manifest_sha256") == PREPARATION_SHA
                             and qualification.get("reference_outputs_all_certified_bytes") is True
                             and qualification.get("unique_certified_cases") == 12
                             and qualification.get("native_model_calls") == 0
                             and qualification.get("native_research_admitted") is False
                             and qualification.get("prepared_root") == str(output / "prepared")
                             and qualification_allocation_matches(qualification.get("allocation"), allocation))
    except (OSError, ValueError, RuntimeError, KeyError, TypeError, tarfile.TarError,
            zipfile.BadZipFile, subprocess.SubprocessError) as exc:
        receipt.update(passed=False, error_type=type(exc).__name__, error=str(exc),
                       private_traceback=traceback.format_exc())
    finally:
        try:
            after = inventory(extraction) if extraction.exists() else None
            receipt["input_files_unchanged"] = before is not None and before == after
            save(root / "input-inventory-after.json", {"files": after})
        except (OSError, ValueError, RuntimeError) as exc:
            receipt["input_files_unchanged"] = False
            receipt["inventory_error"] = type(exc).__name__ + ": " + str(exc)
        receipt["passed"] = receipt["passed"] and receipt["input_files_unchanged"]
        receipt["finished_utc"] = datetime.now(UTC).isoformat()
        preserve_envelope(root, receipt)
    return 0 if receipt["passed"] else 1



{
  "src/solution.cpp": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<vector<int>> blocked(n);\n    for (int c = 0; c < m; ++c) {\n        int y, x;\n        cin >> y >> x;\n        blocked[y].push_back(x);\n    }\n    for (auto& row : blocked) {\n        sort(row.begin(), row.end());\n        row.erase(unique(row.begin(), row.end()), row.end());\n    }\n\n    vector<int> dp(n, 0);\n    dp[0] = 1;\n    for (int y = 0; y < n; ++y) {\n        int x = 0;\n        int left = 0;\n        for (int obstacle : blocked[y]) {\n            for (; x < obstacle; ++x) {\n                int sum = dp[x] + left;\n                if (sum >= MOD) sum -= MOD;\n                dp[x] = sum;\n                left = sum;\n            }\n            dp[x] = 0;\n            left = 0;\n            ++x;\n        }\n        for (; x < n; ++x) {\n            int sum = dp[x] + left;\n            if (sum >= MOD) sum -= MOD;\n            dp[x] = sum;\n            left = sum;\n        }\n    }\n\n    cout << dp[n - 1] << endl;\n}\n"
}

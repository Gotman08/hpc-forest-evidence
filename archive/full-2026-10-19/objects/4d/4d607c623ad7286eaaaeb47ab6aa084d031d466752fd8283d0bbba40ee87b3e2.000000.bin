#include <algorithm>
#include <cassert>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <limits>
#include <memory>
#include <vector>

#ifdef _OPENMP
#include <omp.h>
#endif

static inline std::uint32_t read_integer(const char*& p) {
    while (static_cast<unsigned char>(*p) <= 32u) ++p;
    const bool negative = (*p == '-');
    if (*p == '-' || *p == '+') ++p;
    std::uint32_t value = 0;
    while (*p >= '0' && *p <= '9') {
        value = value * 10u + static_cast<unsigned>(*p - '0');
        ++p;
    }
    return negative ? 0u - value : value;
}

int main() {
    std::size_t capacity = 1u << 20;
    std::size_t used = 0;
    char* input = static_cast<char*>(std::malloc(capacity + 1));
    if (!input) return 1;
    for (;;) {
        if (used == capacity) {
            const std::size_t next_capacity = capacity * 2;
            char* next = static_cast<char*>(std::realloc(input, next_capacity + 1));
            if (!next) {
                std::free(input);
                return 1;
            }
            input = next;
            capacity = next_capacity;
        }
        const std::size_t count = std::fread(input + used, 1, capacity - used, stdin);
        used += count;
        if (count == 0) break;
    }
    if (std::ferror(stdin)) {
        std::free(input);
        return 1;
    }
    if (used == 0) {
        std::free(input);
        return 0;
    }
    char* compact = static_cast<char*>(std::realloc(input, used + 1));
    if (compact) input = compact;
    input[used] = '\0';

    const char* cursor = input;
    const int n = static_cast<int>(read_integer(cursor));
    const int s = static_cast<int>(read_integer(cursor));
    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    const char* const input_end = input + used;
    while (cursor < input_end && static_cast<unsigned char>(*cursor) <= 32u) ++cursor;
    const char* const matrix_begin = cursor;
    const std::size_t byte_count = static_cast<std::size_t>(input_end - matrix_begin);
    const std::size_t cells = static_cast<std::size_t>(n) * n;
    const int width = n - s + 1;

    int workers = 1;
#ifdef _OPENMP
    workers = omp_get_max_threads();
#endif
    workers = std::min(workers, static_cast<int>((cells + 65535u) / 65536u));
    std::vector<std::size_t> token_counts(workers);
    std::vector<int> first_rows(static_cast<std::size_t>(workers) + 1);
    std::unique_ptr<std::uint32_t[]> horizontal(
        new std::uint32_t[static_cast<std::size_t>(n) * width]);
    std::uint32_t* const windows = horizontal.get();
    std::int32_t best = std::numeric_limits<std::int32_t>::min();

#pragma omp parallel if(workers > 1) num_threads(workers) reduction(max:best)
    {
        int tid = 0;
        int team = 1;
#ifdef _OPENMP
        tid = omp_get_thread_num();
        team = omp_get_num_threads();
#endif
        const std::size_t byte_first = byte_count * tid / team;
        const std::size_t byte_last = byte_count * (tid + 1) / team;
        const unsigned char* const current =
            reinterpret_cast<const unsigned char*>(matrix_begin + byte_first);
        const unsigned char* const previous = current - 1;
        std::size_t tokens = 0;
#pragma omp simd reduction(+:tokens)
        for (std::size_t k = 0; k < byte_last - byte_first; ++k) {
            tokens += (current[k] > 32u) & (previous[k] <= 32u);
        }
        token_counts[tid] = tokens;
#pragma omp barrier
        std::size_t prefix = 0;
        for (int t = 0; t < tid; ++t) prefix += token_counts[t];
        const int row_first = static_cast<int>((prefix + n - 1) / n);
        const char* p = matrix_begin + byte_first;
        if (p < input_end && static_cast<unsigned char>(p[-1]) > 32u) {
            while (p < input_end && static_cast<unsigned char>(*p) > 32u) ++p;
        }
        while (p < input_end && static_cast<unsigned char>(*p) <= 32u) ++p;
        const std::size_t row_token = static_cast<std::size_t>(row_first) * n;
        for (std::size_t k = prefix; k < row_token; ++k) read_integer(p);
        first_rows[tid] = row_first;
        if (tid == 0) first_rows[team] = n;
#pragma omp barrier

        std::unique_ptr<std::uint32_t[]> row(new std::uint32_t[n]);
        for (int r = row_first; r < first_rows[tid + 1]; ++r) {
            std::uint32_t sum = 0;
            for (int c = 0; c < s; ++c) {
                row[c] = read_integer(p);
                sum += row[c];
            }
            std::uint32_t* const destination =
                windows + static_cast<std::size_t>(r) * width;
            destination[0] = sum;
            for (int c = s; c < n; ++c) {
                const std::uint32_t value = read_integer(p);
                sum += value - row[c - s];
                row[c] = value;
                destination[c - s + 1] = sum;
            }
        }
#pragma omp barrier

        const int column_first = width * tid / team;
        const int column_last = width * (tid + 1) / team;
        constexpr int tile_size = 128;
        alignas(64) std::uint32_t sums[tile_size];
        alignas(64) std::int32_t maxima[tile_size];
        for (int column = column_first; column < column_last; column += tile_size) {
            const int columns = std::min(tile_size, column_last - column);
#pragma omp simd
            for (int k = 0; k < columns; ++k) sums[k] = 0;
            for (int r = 0; r < s; ++r) {
                const std::uint32_t* const source =
                    windows + static_cast<std::size_t>(r) * width + column;
#pragma omp simd
                for (int k = 0; k < columns; ++k) sums[k] += source[k];
            }
#pragma omp simd
            for (int k = 0; k < columns; ++k) {
                maxima[k] = static_cast<std::int32_t>(sums[k]);
            }
            for (int r = s; r < n; ++r) {
                const std::uint32_t* const entering =
                    windows + static_cast<std::size_t>(r) * width + column;
                const std::uint32_t* const leaving =
                    windows + static_cast<std::size_t>(r - s) * width + column;
#pragma omp simd
                for (int k = 0; k < columns; ++k) {
                    sums[k] += entering[k] - leaving[k];
                    maxima[k] = std::max(maxima[k], static_cast<std::int32_t>(sums[k]));
                }
            }
            for (int k = 0; k < columns; ++k) best = std::max(best, maxima[k]);
        }
    }

    std::free(input);
    std::printf("%d\n", static_cast<int>(best));
    return 0;
}

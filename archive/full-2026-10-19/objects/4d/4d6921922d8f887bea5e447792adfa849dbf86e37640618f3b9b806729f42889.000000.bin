      "content": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <utility>\n#include <vector>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\ntypedef vector<vector<bool>> adjacency_matrix;\n\nadjacency_matrix readGraph();\n\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2);\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence);\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const int *equivalence, int vertices);\ninline void printPermutation(const vector<int> &equivalence);\ninline void printPermutation(const int *equivalence, int vertices);\n\nstatic bool nextHeapPermutation(vector<int> &equivalence,\n                                vector<int> &exchange_counter,\n                                int &exchange_index);\nstatic bool enumerateSerial(const adjacency_matrix &g1,\n                            const adjacency_matrix &g2,\n                            vector<int> &equivalence,\n                            vector<int> &exchange_counter,\n                            int &exchange_index);\n#ifdef _OPENMP\nstatic bool enumerateParallel(const adjacency_matrix &g1,\n                              const adjacency_matrix &g2,\n                              vector<int> &equivalence,\n                              vector<int> &exchange_counter,\n                              int &exchange_index);\n#endif\n\nint main(){\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if(!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2){\n    if(g1.size() != g2.size()) return false;\n\n    vector<int> equivalence(g1.size(), 0);\n    vector<int> exchange_counter(g1.size(), 0);\n    int exchange_index = 1;\n\n    for(int i = 0; i < static_cast<int>(equivalence.size()); ++i)\n        equivalence[i] = i;\n\n    if(verifyPermutation(g1, g2, equivalence)){\n        printPermutation(equivalence);\n        return true;\n    }\n\n#ifdef _OPENMP\n    if(equivalence.size() >= 8 && omp_get_max_threads() > 1)\n        return enumerateParallel(g1, g2, equivalence, exchange_counter,\n                                 exchange_index);\n#endif\n\n    return enumerateSerial(g1, g2, equivalence, exchange_counter,\n                           exchange_index);\n}\n\nadjacency_matrix readGraph(){\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read(vertices);\n    for (int i = 0; i < vertices; ++i)\n        read[i].resize(vertices);\n\n    cin >> edges;\n    for (int i = 0; i < edges; i++) {\n       cin >> source >> destination;\n       read[destination][source] = read[source][destination] = true;\n    }\n\n    return read;\n}\n\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence){\n    return verifyPermutation(g1, g2, equivalence.data(),\n                             static_cast<int>(equivalence.size()));\n}\n\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const int *equivalence, int vertices){\n    for (int i = 0; i < vertices; ++i) {\n        for (int j = 0; j <= i; ++j) {\n            if(g1[i][j] != g2[equivalence[i]][equivalence[j]]) return false;\n        }\n    }\n    return true;\n}\n\ninline void printPermutation(const vector<int> &equivalence){\n    printPermutation(equivalence.data(), static_cast<int>(equivalence.size()));\n}\n\ninline void printPermutation(const int *equivalence, int vertices){\n    for (int i = 0; i < vertices; ++i)\n        cout << equivalence[i] << \" \";\n    cout << endl;\n}\n\nstatic bool nextHeapPermutation(vector<int> &equivalence,\n                                vector<int> &exchange_counter,\n                                int &exchange_index){\n    const int vertices = static_cast<int>(equivalence.size());\n\n    while(exchange_index < vertices){\n        if(exchange_counter[exchange_index] < exchange_index){\n            if(exchange_index % 2 == 0)\n                swap(equivalence[0], equivalence[exchange_index]);\n            else\n                swap(equivalence[exchange_counter[exchange_index]],\n                     equivalence[exchange_index]);\n\n            ++exchange_counter[exchange_index];\n            exchange_index = 1;\n            return true;\n        }\n\n        exchange_counter[exchange_index] = 0;\n        ++exchange_index;\n    }\n\n    return false;\n}\n\nstatic bool enumerateSerial(const adjacency_matrix &g1,\n                            const adjacency_matrix &g2,\n                            vector<int> &equivalence,\n                            vector<int> &exchange_counter,\n                            int &exchange_index){\n    bool isomorphism_found = false;\n\n    while(nextHeapPermutation(equivalence, exchange_counter, exchange_index)){\n        if(verifyPermutation(g1, g2, equivalence)){\n            printPermutation(equivalence);\n            isomorphism_found = true;\n        }\n    }\n\n    return isomorphism_found;\n}\n\n#ifdef _OPENMP\nstatic bool enumerateParallel(const adjacency_matrix &g1,\n                              const adjacency_matrix &g2,\n                              vector<int> &equivalence,\n                              vector<int> &exchange_counter,\n                              int &exchange_index){\n    constexpr int batch_size = 2048;\n    const int vertices = static_cast<int>(equivalence.size());\n    vector<int> candidates(static_cast<size_t>(batch_size) * vertices);\n    vector<unsigned char> matches(batch_size);\n    bool isomorphism_found = false;\n    int count = 0;\n    bool more = true;\n\n#pragma omp parallel\n    {\n        while(more){\n#pragma omp single\n            {\n                count = 0;\n                while(count < batch_size &&\n                      nextHeapPermutation(equivalence, exchange_counter,\n                                          exchange_index)){\n                    int *candidate = candidates.data() +\n                                     static_cast<size_t>(count) * vertices;\n                    copy(equivalence.begin(), equivalence.end(), candidate);\n                    ++count;\n                }\n                more = count != 0;\n            }\n\n#pragma omp for schedule(static, 64)\n            for(int candidate = 0; candidate < count; ++candidate){\n                const int *mapping = candidates.data() +\n                                     static_cast<size_t>(candidate) * vertices;\n                matches[candidate] = verifyPermutation(g1, g2, mapping,\n                                                       vertices);\n            }\n\n#pragma omp single\n            {\n                for(int candidate = 0; candidate < count; ++candidate){\n                    if(matches[candidate]){\n                        printPermutation(candidates.data() +\n                                         static_cast<size_t>(candidate) * vertices,\n                                         vertices);\n                        isomorphism_found = true;\n                    }\n                }\n            }\n        }\n    }\n\n    return isomorphism_found;\n}\n#endif\n",
      "path": "src/brute_isomorphism.cpp"
    }
  ],
  "hypothesis": "For non-identity searches with at least eight vertices, a persistent OpenMP team can reduce permutation-verification time by statically sharing sufficiently large Heap-order batches while amortizing thread startup.",
  "notes": "Identity and small searches remain serial. Each batch is generated serially in original Heap order, verified in parallel, and emitted by one thread in that same order.",
  "sources_kept": [],
  "transformations": [
    "Add a size- and thread-count-gated persistent OpenMP verification path with static 64-permutation work chunks.",
    "Buffer contiguous Heap-order mappings and serialize matching outputs after each parallel verification batch to preserve exact output order."

#include <algorithm>
#include <cstddef>
#include <iostream>
#include <iterator>
#include <limits>
#include <string>
#include <vector>

namespace {

static bool is_whitespace(char c)
{
    return c == ' ' || c == '\n' || c == '\r' || c == '\t'
        || c == '\f' || c == '\v';
}

static std::string read_text()
{
    std::istreambuf_iterator<char> first(std::cin);
    std::istreambuf_iterator<char> last;
    std::string text(first, last);
    text.erase(std::remove_if(text.begin(), text.end(), is_whitespace), text.end());
    return text;
}

static void write_line(const std::string& text)
{
    std::cout.put('[');
    std::cout.put(' ');
    for (std::string::const_iterator it = text.begin(); it != text.end(); ++it) {
        std::cout.put(*it);
        std::cout.put(' ');
    }
    std::cout.put(']');
    std::cout.put('\n');
}

static inline void format_line(const char* source, std::size_t length, char* destination)
{
    *destination++ = '[';
    *destination++ = ' ';
    for (std::size_t index = 0; index != length; ++index) {
        *destination++ = source[index];
        *destination++ = ' ';
    }
    *destination++ = ']';
    *destination = '\n';
}

static void write_serially(std::string& text)
{
    do {
        write_line(text);
    } while (std::next_permutation(text.begin(), text.end()));
}

} // namespace

int main()
{
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(0);

    std::string text = read_text();
    if (text.empty()) {
        return 0;
    }

    std::sort(text.begin(), text.end());

    const std::size_t length = text.size();
    const std::size_t limit = std::numeric_limits<std::size_t>::max();
    if (length > (limit - 4u) / 2u) {
        write_serially(text);
        return 0;
    }

    const std::size_t line_bytes = length * 2u + 4u;
    if (length > limit - line_bytes) {
        write_serially(text);
        return 0;
    }

    const std::size_t item_bytes = length + line_bytes;
    const std::size_t batch_budget = 4u * 1024u * 1024u;
    if (item_bytes > batch_budget) {
        write_serially(text);
        return 0;
    }

    const std::size_t capacity = batch_budget / item_bytes;
    std::vector<char> rows(capacity * length);
    std::vector<char> output(capacity * line_bytes);
    bool has_more = true;

    while (has_more) {
        std::size_t count = 0;
        do {
            std::copy(text.begin(), text.end(), rows.begin() + count * length);
            ++count;
            has_more = std::next_permutation(text.begin(), text.end());
        } while (has_more && count != capacity);

        if (count < 256u) {
            for (std::size_t record = 0; record != count; ++record) {
                format_line(&rows[record * length], length, &output[record * line_bytes]);
            }
        } else {
#pragma omp parallel for schedule(static)
            for (std::size_t record = 0; record < count; ++record) {
                format_line(&rows[record * length], length, &output[record * line_bytes]);
            }
        }

        std::cout.write(&output[0], static_cast<std::streamsize>(count * line_bytes));
    }

    return 0;
}

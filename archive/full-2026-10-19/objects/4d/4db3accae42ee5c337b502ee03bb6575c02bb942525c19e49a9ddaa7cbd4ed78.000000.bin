{
  "src/est_matriz_seq.c": "#include <stdio.h>\n#include <stdlib.h>\n#include <math.h>\n\ntypedef struct {\n    double mean;\n    double harmonic_mean;\n    double median;\n    double mode;\n    double variance;\n    double standard_deviation;\n    double coefficient_variation;\n} column_statistics;\n\nstatic int compare_double(const void *left, const void *right) {\n    const double a = *(const double *)left;\n    const double b = *(const double *)right;\n\n    return (a > b) - (a < b);\n}\n\nstatic double mode_from_sorted(const double *values, int count) {\n    int first = 0;\n    int best_matches = 0;\n    double mode = -1;\n\n    while (first < count) {\n        int last = first + 1;\n        int matches;\n\n        while (last < count && values[first] == values[last]) {\n            ++last;\n        }\n\n        matches = last - first - 1;\n        if (matches > best_matches) {\n            best_matches = matches;\n            mode = values[first];\n        }\n        first = last;\n    }\n\n    return mode;\n}\n\nstatic void finish_column(double *values, int rows, column_statistics *statistics) {\n    double sum = 0;\n    int row;\n\n    qsort(values, (size_t)rows, sizeof(*values), compare_double);\n\n    if ((rows - 1) % 2) {\n        statistics->median = values[rows / 2 - 1] + values[rows / 2];\n        statistics->median *= 0.5;\n    } else {\n        statistics->median = values[rows / 2];\n    }\n\n    statistics->mode = mode_from_sorted(values, rows);\n\n    for (row = 0; row < rows; ++row) {\n        const double difference = values[row] - statistics->mean;\n        sum += difference * difference;\n    }\n\n    statistics->variance = sum / (rows - 1);\n    statistics->standard_deviation = sqrt(statistics->variance);\n    statistics->coefficient_variation =\n        statistics->standard_deviation / statistics->mean;\n}\n\nint main(int argc, char **argv) {\n    int rows;\n    int columns;\n    int row;\n    int column;\n    double *matrix;\n    column_statistics *statistics;\n\n    (void)argc;\n    (void)argv;\n\n    fscanf(stdin, \"%d \", &rows);\n    fscanf(stdin, \"%d\\n\", &columns);\n\n    matrix = malloc((size_t)rows * (size_t)columns * sizeof(*matrix));\n    statistics = calloc((size_t)columns, sizeof(*statistics));\n\n    for (row = 0; row < rows; ++row) {\n        for (column = 0; column < columns; ++column) {\n            double value;\n\n            fscanf(stdin, \"%lf \", &value);\n            matrix[(size_t)column * (size_t)rows + (size_t)row] = value;\n            statistics[column].mean += value;\n            statistics[column].harmonic_mean += 1 / value;\n        }\n    }\n\n    for (column = 0; column < columns; ++column) {\n        statistics[column].mean /= rows;\n        statistics[column].harmonic_mean =\n            rows / statistics[column].harmonic_mean;\n        finish_column(matrix + (size_t)column * (size_t)rows, rows,\n                      &statistics[column]);\n    }\n\n    for (column = 0; column < columns; ++column) {\n        printf(\"%.1lf \", statistics[column].mean);\n    }\n    printf(\"\\n\");\n    for (column = 0; column < columns; ++column) {\n        printf(\"%.1lf \", statistics[column].harmonic_mean);\n    }\n    printf(\"\\n\");\n    for (column = 0; column < columns; ++column) {\n        printf(\"%.1lf \", statistics[column].median);\n    }\n    printf(\"\\n\");\n    for (column = 0; column < columns; ++column) {\n        printf(\"%.1lf \", statistics[column].mode);\n    }\n    printf(\"\\n\");\n    for (column = 0; column < columns; ++column) {\n        printf(\"%.1lf \", statistics[column].variance);\n    }\n    printf(\"\\n\");\n    for (column = 0; column < columns; ++column) {\n        printf(\"%.1lf \", statistics[column].standard_deviation);\n    }\n    printf(\"\\n\");\n    for (column = 0; column < columns; ++column) {\n        printf(\"%.1lf \", statistics[column].coefficient_variation);\n    }\n    printf(\"\\n\");\n\n    free(matrix);\n    free(statistics);\n\n    return 0;\n}\n"
}

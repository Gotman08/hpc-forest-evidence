            "src/quicksort.c"
          ],
          "retained": [
            "Classify disjoint 64-element partition blocks using signed NEON comparisons and exact bit masks, with a scalar fallback.",
            "Exchange matching set-bit positions sequentially, avoiding unsafe vectorization of in-place dependencies.",
            "Use median-of-three pivots, an insertion-sort cutoff, smaller-side recursion, and a depth-limited heapsort fallback."
          ]
        },

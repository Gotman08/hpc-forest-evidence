      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdio>\n#include <limits>\n#include <memory>\n#include <vector>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nclass FastInput {\n    unsigned char buffer_[1 << 16];\n    std::size_t position_;\n    std::size_t size_;\n\n    int getChar() {\n        if (position_ == size_) {\n            size_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (size_ == 0) return EOF;\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    FastInput() : position_(0), size_(0) {}\n\n    bool readInt(int& result) {\n        int c;\n        do {\n            c = getChar();\n            if (c == EOF) return false;\n        } while (c <= ' ');\n\n        int sign = 1;\n        if (c == '-' || c == '+') {\n            sign = c == '-' ? -1 : 1;\n            c = getChar();\n        }\n        long long value = 0;\n        while (c >= '0' && c <= '9') {\n            value = value * 10 + (c - '0');\n            c = getChar();\n        }\n        result = static_cast<int>(sign * value);\n        return true;\n    }\n};\n\nstruct PrefixEvent {\n    int row;\n    int band;\n    bool finish;\n};\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.readInt(n) || !input.readInt(s)) return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t cells = static_cast<std::size_t>(n) * n;\n    std::unique_ptr<int[]> matrix(new int[cells]);\n    for (std::size_t i = 0; i < cells; ++i) {\n        if (!input.readInt(matrix[i])) return 0;\n    }\n    const int* data = matrix.get();\n    const int windows = n - s + 1;\n\n    int requested = 1;\n#ifdef _OPENMP\n    requested = std::min(omp_get_max_threads(), windows);\n#endif\n    if (static_cast<long long>(n) * n < 65536) requested = 1;\n\n    std::vector<long long> initial(static_cast<std::size_t>(requested) * n, 0);\n    long long maximum = std::numeric_limits<long long>::min();\n\n#pragma omp parallel num_threads(requested) reduction(max:maximum)\n    {\n        int id = 0;\n        int threads = 1;\n#ifdef _OPENMP\n        id = omp_get_thread_num();\n        threads = omp_get_num_threads();\n#endif\n        const int first = static_cast<int>(static_cast<long long>(windows) * id / threads);\n        const int last = static_cast<int>(static_cast<long long>(windows) * (id + 1) / threads);\n        long long* columns = initial.data() + static_cast<std::size_t>(id) * n;\n        const long long prefixRows = s + static_cast<long long>(windows) * (threads - 1) / threads;\n\n        if (prefixRows < static_cast<long long>(threads) * s) {\n            const int columnFirst = static_cast<int>(static_cast<long long>(n) * id / threads);\n            const int columnLast = static_cast<int>(static_cast<long long>(n) * (id + 1) / threads);\n            const int width = columnLast - columnFirst;\n            std::vector<long long> prefix(width, 0);\n            std::vector<PrefixEvent> events;\n            events.reserve(2 * threads);\n            for (int band = 0; band < threads; ++band) {\n                const int start = static_cast<int>(static_cast<long long>(windows) * band / threads);\n                events.push_back(PrefixEvent{start, band, false});\n                events.push_back(PrefixEvent{start + s, band, true});\n            }\n            std::sort(events.begin(), events.end(),\n                      [](const PrefixEvent& a, const PrefixEvent& b) {\n                          return a.row < b.row;\n                      });\n\n            int row = 0;\n            for (std::size_t e = 0; e < events.size(); ++e) {\n                const PrefixEvent& event = events[e];\n                for (; row < event.row; ++row) {\n                    const int* source = data + static_cast<std::size_t>(row) * n + columnFirst;\n#pragma omp simd\n                    for (int c = 0; c < width; ++c) {\n                        prefix[c] += source[c];\n                    }\n                }\n                long long* destination = initial.data()\n                    + static_cast<std::size_t>(event.band) * n + columnFirst;\n                if (event.finish) {\n#pragma omp simd\n                    for (int c = 0; c < width; ++c) {\n                        destination[c] += prefix[c];\n                    }\n                } else {\n#pragma omp simd\n                    for (int c = 0; c < width; ++c) {\n                        destination[c] = -prefix[c];\n                    }\n                }\n            }\n        } else {\n            for (int row = first; row < first + s; ++row) {\n                const int* source = data + static_cast<std::size_t>(row) * n;\n#pragma omp simd\n                for (int c = 0; c < n; ++c) {\n                    columns[c] += source[c];\n                }\n            }\n        }\n\n#pragma omp barrier\n        long long localMaximum = std::numeric_limits<long long>::min();\n        for (int row = first; row < last; ++row) {\n            long long sum = 0;\n#pragma omp simd reduction(+:sum)\n            for (int c = 0; c < s; ++c) {\n                sum += columns[c];\n            }\n            localMaximum = std::max(localMaximum, sum);\n            for (int c = s; c < n; ++c) {\n                sum += columns[c] - columns[c - s];\n                localMaximum = std::max(localMaximum, sum);\n            }\n\n            if (row + 1 < last) {\n                const int* exiting = data + static_cast<std::size_t>(row) * n;\n                const int* entering = data + static_cast<std::size_t>(row + s) * n;\n#pragma omp simd\n                for (int c = 0; c < n; ++c) {\n                    columns[c] += static_cast<long long>(entering[c]) - exiting[c];\n                }\n            }\n        }\n        maximum = localMaximum;\n    }\n\n    std::printf(\"%lld\\n\", maximum);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "A single coarse OpenMP team with adaptively shared initialization should avoid redundant large-window startup work, while buffered input removes the serial parsing bottleneck.",

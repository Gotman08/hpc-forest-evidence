{
  "src/laplace_seq.c": "/*\n    This program solves Laplace's equation on a regular 2D grid using Jacobi iteration.\n*/\n#include <stdio.h>\n#include <stdlib.h>\n\n#define CONV_THRESHOLD 1.0e-5f\n\nint size;\nint iter_max_num;\n\ndouble absolute(double num) {\n    if (num < 0)\n        return -1.0 * num;\n    return num;\n}\n\nvoid initialize_grid(double *grid, double *new_grid) {\n    int center = size / 2;\n    int linf = center - (size / 10);\n    int lsup = center + (size / 10);\n\n    for (int i = 0; i < size; i++) {\n        size_t row = (size_t)i * (size_t)size;\n        for (int j = 0; j < size; j++) {\n            double value = (i >= linf && i <= lsup &&\n                            j >= linf && j <= lsup) ? 100.0 : 0.0;\n            grid[row + (size_t)j] = value;\n            new_grid[row + (size_t)j] = value;\n        }\n    }\n}\n\nvoid save_grid(const double *grid) {\n    for (int i = 0; i < size; i++) {\n        size_t row = (size_t)i * (size_t)size;\n        for (int j = 0; j < size; j++) {\n            fprintf(stdout, \"%lf \", grid[row + (size_t)j]);\n        }\n        fprintf(stdout, \"\\n\");\n    }\n}\n\nint main(int argc, char *argv[]) {\n    fscanf(stdin, \"%d\", &size);\n    fscanf(stdin, \"%d\", &iter_max_num);\n\n    size_t cells = (size_t)size * (size_t)size;\n    double *grid = (double *)malloc(cells * sizeof(double));\n    double *new_grid = (double *)malloc(cells * sizeof(double));\n    initialize_grid(grid, new_grid);\n\n    int hasError = 1;\n    int iter = 0;\n\n    while (hasError && iter < iter_max_num) {\n        hasError = 0;\n\n        for (int i = 1; i < size - 1; i++) {\n            size_t row = (size_t)i * (size_t)size;\n            size_t north = row - (size_t)size;\n            size_t south = row + (size_t)size;\n            for (int j = 1; j < size - 1; j++) {\n                size_t index = row + (size_t)j;\n                new_grid[index] = 0.25 * (grid[index + 1] + grid[index - 1] +\n                                          grid[north + (size_t)j] +\n                                          grid[south + (size_t)j]);\n\n                double errorCurrent = absolute(new_grid[index] - grid[index]);\n                if (errorCurrent > CONV_THRESHOLD) {\n                    hasError = 1;\n                }\n            }\n        }\n\n        double *tmp = grid;\n        grid = new_grid;\n        new_grid = tmp;\n        iter++;\n    }\n\n    save_grid(grid);\n    return 0;\n}\n"
}

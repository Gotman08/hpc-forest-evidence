        "content": "#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <cstddef>\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\nusing namespace std;\n\nconst unsigned MOD = 1000000007u;\n\n#if defined(__aarch64__)\nstatic inline uint32x4_t add_mod(uint32x4_t a, uint32x4_t b) {\n    const uint32x4_t modulus = vdupq_n_u32(MOD);\n    const uint32x4_t sum = vaddq_u32(a, b);\n    return vsubq_u32(sum, vandq_u32(vcgeq_u32(sum, modulus), modulus));\n}\n\nstatic inline uint32x4_t scan_four(uint32x4_t values) {\n    const uint32x4_t zero = vdupq_n_u32(0);\n    values = add_mod(values, vextq_u32(zero, values, 3));\n    return add_mod(values, vextq_u32(zero, values, 2));\n}\n#endif\n\n// Independent local scans precede the ordered propagation of block carries.\nstatic void update_span(unsigned* dp, int begin, int end, unsigned& left) {\n    int x = begin;\n#if defined(__aarch64__)\n    uint32x4_t carry = vdupq_n_u32(left);\n    for (; end - x >= 16; x += 16) {\n        uint32x4_t a = scan_four(vld1q_u32(dp + x));\n        uint32x4_t b = scan_four(vld1q_u32(dp + x + 4));\n        uint32x4_t c = scan_four(vld1q_u32(dp + x + 8));\n        uint32x4_t d = scan_four(vld1q_u32(dp + x + 12));\n\n        a = add_mod(a, carry);\n        b = add_mod(b, vdupq_laneq_u32(a, 3));\n        c = add_mod(c, vdupq_laneq_u32(b, 3));\n        d = add_mod(d, vdupq_laneq_u32(c, 3));\n        carry = vdupq_laneq_u32(d, 3);\n\n        vst1q_u32(dp + x, a);\n        vst1q_u32(dp + x + 4, b);\n        vst1q_u32(dp + x + 8, c);\n        vst1q_u32(dp + x + 12, d);\n    }\n    for (; end - x >= 4; x += 4) {\n        uint32x4_t values = scan_four(vld1q_u32(dp + x));\n        values = add_mod(values, carry);\n        vst1q_u32(dp + x, values);\n        carry = vdupq_laneq_u32(values, 3);\n    }\n    left = vgetq_lane_u32(carry, 0);\n#endif\n    for (; x < end; ++x) {\n        unsigned sum = dp[x] + left;\n        if (sum >= MOD) sum -= MOD;\n        dp[x] = sum;\n        left = sum;\n    }\n}\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n    vector<vector<int> > blocked(n);\n    for (int c = 0; c < m; ++c) {\n        int y, x;\n        cin >> y >> x;\n        blocked[y].push_back(x);\n    }\n    for (auto& row : blocked) {\n        sort(row.begin(), row.end());\n        row.erase(unique(row.begin(), row.end()), row.end());\n    }\n\n    vector<unsigned> dp(n, 0);\n    dp[0] = 1;\n    for (int y = 0; y < n; ++y) {\n        unsigned left = 0;\n        int begin = 0;\n        for (int x : blocked[y]) {\n            update_span(dp.data(), begin, x, left);\n            dp[x] = 0;\n            left = 0;\n            begin = x + 1;\n        }\n        update_span(dp.data(), begin, n, left);\n    }\n    cout << dp[n - 1] << endl;\n}\n",
        "path": "src/solution.cpp"
      }

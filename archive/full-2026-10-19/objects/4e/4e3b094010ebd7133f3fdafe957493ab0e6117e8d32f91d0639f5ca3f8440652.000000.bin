{
  "src/main.cpp": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nint A[1000][1000];\nint ps[1010][1010];\n\ntypedef long long ll;\n\nll solve(int m, int n, int k) {\n  for (int i = 1; i <= m; i++) {\n    for (int j = 1; j <= n; j++) {\n      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\n    }\n  }\n\n  ll ans = 0;\n  const ll strip_rows = static_cast<ll>(m) * n * (n + 1) / 2;\n  const bool parallel_work = n >= 8 && strip_rows >= 50000;\n\n  // Different column strips are independent; each thread owns its frequency map.\n  // The row scan remains sequential because its prefix sum and map updates depend\n  // on the preceding row.\n#pragma omp parallel if(parallel_work) reduction(+:ans)\n  {\n    unordered_map<ll, ll> h;\n    h.reserve(m + 1);\n\n#pragma omp for schedule(dynamic, 1)\n    for (int j = 1; j <= n; j++) {\n      for (int l = j; l <= n; l++) {\n        h.clear();\n        h[0] = 1;\n        ll s = 0;\n        for (int i = 1; i <= m; i++) {\n          s += ps[i][l] - ps[i][j - 1];\n          auto it = h.find(s - k);\n          if (it != h.end()) ans += it->second;\n          h[s]++;\n        }\n      }\n    }\n  }\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n  memset(ps, 0, sizeof ps);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n"
}

#include "knn.h"
#include <omp.h>

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    long total = 0;
    for (int i = 0; i < n_groups; i++) total += groups[i].length;

    if (total == 0 || k <= 0) return '\0';

    char *flat_labels = malloc(sizeof(char) * total);
    float *flat_x = malloc(sizeof(float) * total);
    float *flat_y = malloc(sizeof(float) * total);

    long idx = 0;
    for (int i = 0; i < n_groups; i++) {
        Group g = groups[i];
        for (int j = 0; j < g.length; j++) {
            flat_labels[idx] = g.label;
            flat_x[idx] = g.points[j].x;
            flat_y[idx] = g.points[j].y;
            idx++;
        }
    }

    int max_threads = omp_get_max_threads();
    size_t per = (size_t)max_threads * (size_t)k;

    float *local_dist = malloc(sizeof(float) * per);
    char *local_label = malloc(sizeof(char) * per);
    long *local_idx = malloc(sizeof(long) * per);
    int *local_count = calloc(max_threads, sizeof(int));

    for (int t = 0; t < max_threads; t++) {
        float *base = local_dist + (size_t)t * k;
        for (int j = 0; j < k; j++) base[j] = -1.0f;
    }

    #pragma omp parallel
    {
        int tid = omp_get_thread_num();
        float *my_dist = local_dist + (size_t)tid * k;
        char *my_label = local_label + (size_t)tid * k;
        long *my_idx = local_idx + (size_t)tid * k;
        int my_count = 0;

        #pragma omp for schedule(static)
        for (long i = 0; i < total; i++) {
            float dx = flat_x[i] - to_evaluate.x;
            float dy = flat_y[i] - to_evaluate.y;
            float d = dx * dx + dy * dy;

            int insert_pos = -1;
            for (int p = 0; p < my_count && p < k; p++) {
                if (d < my_dist[p] || (d == my_dist[p] && i < my_idx[p])) {
                    insert_pos = p;
                    break;
                }
            }

            if (insert_pos == -1) {
                if (my_count < k) {
                    insert_pos = my_count;
                } else {
                    continue;
                }
            }

            int max_shift = (my_count < k ? my_count : k - 1);
            for (int p = max_shift; p > insert_pos; p--) {
                my_dist[p] = my_dist[p - 1];
                my_label[p] = my_label[p - 1];
                my_idx[p] = my_idx[p - 1];
            }

            my_dist[insert_pos] = d;
            my_label[insert_pos] = flat_labels[i];
            my_idx[insert_pos] = i;

            if (my_count < k) my_count++;
        }

        local_count[tid] = my_count;
    }

    char *final_labels = malloc(sizeof(char) * k);
    int *ptr = calloc(max_threads, sizeof(int));

    for (int pos = 0; pos < k; pos++) {
        int best_t = -1;
        float best_d = 0.0f;
        long best_idx = 0;

        for (int t = 0; t < max_threads; t++) {
            if (ptr[t] >= local_count[t]) continue;
            int li = ptr[t];
            float d = local_dist[(size_t)t * k + li];
            long id = local_idx[(size_t)t * k + li];

            if (best_t == -1 || d < best_d || (d == best_d && id < best_idx)) {
                best_t = t;
                best_d = d;
                best_idx = id;
            }
        }

        final_labels[pos] = local_label[(size_t)best_t * k + ptr[best_t]];
        ptr[best_t]++;
    }

    qsort(final_labels, k, sizeof(char), compare_for_sort);

    char most_frequent = final_labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (int i = 1; i < k; i++) {
        if (final_labels[i] != final_labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = final_labels[i - 1];
                most_frequent_count = current_frequency;
            }

            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = final_labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    return most_frequent;
}

{
  "src/knn.c": "#include \"knn.h\"\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nenum { KNN_LABEL_COUNT = UCHAR_MAX + 1 };\n\ntypedef struct {\n    size_t order;\n    float distance;\n    char label;\n} KnnNeighbor;\n\nstatic int knn_before(KnnNeighbor a, KnnNeighbor b, int farthest) {\n    if (a.distance < b.distance) return !farthest;\n    if (a.distance > b.distance) return farthest;\n    return farthest ? a.order > b.order : a.order < b.order;\n}\n\nstatic int knn_compare_near(const void *pa, const void *pb) {\n    const KnnNeighbor *a = (const KnnNeighbor *) pa;\n    const KnnNeighbor *b = (const KnnNeighbor *) pb;\n    if (a->distance < b->distance) return -1;\n    if (a->distance > b->distance) return 1;\n    return (a->order > b->order) - (a->order < b->order);\n}\n\nstatic int knn_compare_far(const void *pa, const void *pb) {\n    return -knn_compare_near(pa, pb);\n}\n\nstatic KnnNeighbor knn_median(KnnNeighbor a, KnnNeighbor b,\n                              KnnNeighbor c, int farthest) {\n    if (knn_before(a, b, farthest)) {\n        if (knn_before(b, c, farthest)) return b;\n        return knn_before(a, c, farthest) ? c : a;\n    }\n    if (knn_before(a, c, farthest)) return a;\n    return knn_before(b, c, farthest) ? c : b;\n}\n\nstatic void knn_select_prefix(KnnNeighbor *items, size_t length,\n                              size_t keep, int farthest) {\n    if (keep == 0 || keep >= length) return;\n\n    size_t left = 0;\n    size_t right = length;\n    unsigned int depth = 0;\n    for (size_t m = length; m > 1; m >>= 1) ++depth;\n    depth *= 2;\n\n    while (right - left > 24) {\n        if (depth == 0) {\n            qsort(items + left, right - left, sizeof(*items),\n                  farthest ? knn_compare_far : knn_compare_near);\n            return;\n        }\n        --depth;\n\n        KnnNeighbor pivot = knn_median(items[left],\n                                      items[left + (right - left) / 2],\n                                      items[right - 1], farthest);\n        size_t i = left;\n        size_t j = right;\n        for (;;) {\n            while (i < j && knn_before(items[i], pivot, farthest)) ++i;\n            while (i < j && knn_before(pivot, items[j - 1], farthest)) --j;\n            if (i >= j) break;\n            KnnNeighbor temporary = items[i];\n            items[i] = items[j - 1];\n            items[j - 1] = temporary;\n            ++i;\n            --j;\n        }\n\n        if (keep == i) return;\n        if (keep < i) right = i;\n        else left = i;\n    }\n\n    for (size_t i = left + 1; i < right; ++i) {\n        KnnNeighbor value = items[i];\n        size_t j = i;\n        while (j > left && knn_before(value, items[j - 1], farthest)) {\n            items[j] = items[j - 1];\n            --j;\n        }\n        items[j] = value;\n    }\n}\n\nstatic size_t knn_block_begin(size_t total, int id, int team) {\n    size_t quotient = total / (size_t) team;\n    size_t remainder = total % (size_t) team;\n    return quotient * (size_t) id\n         + ((size_t) id < remainder ? (size_t) id : remainder);\n}\n\nstatic char knn_vote(const size_t counts[KNN_LABEL_COUNT]) {\n    char best = (char) -1;\n    size_t best_count = 0;\n    for (int b = 0; b < KNN_LABEL_COUNT; ++b) {\n        char label = (char) b;\n        if (counts[b] > best_count ||\n            (counts[b] != 0 && counts[b] == best_count && label < best)) {\n            best = label;\n            best_count = counts[b];\n        }\n    }\n    return best;\n}\n\nstatic char knn_sequential(int n_groups, Group *groups, int k,\n                           Point to_evaluate) {\n    char *labels = (char *) malloc(sizeof(char) * k);\n    float *distances = (float *) malloc(sizeof(float) * k);\n    int i, j, x, y;\n\n    for (i = 0; i < k; ++i) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n        for (j = 0; j < g.length; ++j) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (x = 0; x < k; ++x) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; --y) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n    for (i = 1; i < k; ++i) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            ++current_frequency;\n        }\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) return knn_sequential(n_groups, groups, k, to_evaluate);\n\n    size_t total_counts[KNN_LABEL_COUNT] = {0};\n    size_t total = 0;\n    for (int g = 0; g < n_groups; ++g) {\n        if (groups[g].length < 0)\n            return knn_sequential(n_groups, groups, k, to_evaluate);\n        size_t length = (size_t) groups[g].length;\n        if (length > SIZE_MAX - total)\n            return knn_sequential(n_groups, groups, k, to_evaluate);\n        total += length;\n        total_counts[(unsigned char) groups[g].label] += length;\n    }\n\n    size_t wanted = (size_t) k;\n    if (wanted >= total) {\n        total_counts[(unsigned char) -1] += wanted - total;\n        return knn_vote(total_counts);\n    }\n\n    int farthest = wanted > total - wanted;\n    size_t keep = farthest ? total - wanted : wanted;\n    if (total > SIZE_MAX / sizeof(KnnNeighbor))\n        return knn_sequential(n_groups, groups, k, to_evaluate);\n\n    int workers = 1;\n#ifdef _OPENMP\n    workers = omp_get_max_threads();\n#endif\n    size_t useful_threads = total / 16384;\n    if (useful_threads == 0) useful_threads = 1;\n    if ((size_t) workers > useful_threads) workers = (int) useful_threads;\n\n    KnnNeighbor *items = (KnnNeighbor *) malloc(total * sizeof(*items));\n    size_t *counts = (size_t *) malloc((size_t) workers * sizeof(*counts));\n    if (items == NULL || counts == NULL) {\n        free(counts);\n        free(items);\n        return knn_sequential(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t chosen_counts[KNN_LABEL_COUNT] = {0};\n    int saw_nan = 0;\n#pragma omp parallel num_threads(workers) if(workers > 1) reduction(|:saw_nan)\n    {\n        int tid = 0;\n        int team = 1;\n#ifdef _OPENMP\n        tid = omp_get_thread_num();\n        team = omp_get_num_threads();\n#endif\n        size_t begin = knn_block_begin(total, tid, team);\n        size_t end = knn_block_begin(total, tid + 1, team);\n        size_t group_begin = 0;\n\n        for (int g = 0; g < n_groups && group_begin < end; ++g) {\n            size_t length = (size_t) groups[g].length;\n            size_t group_end = group_begin + length;\n            if (group_end > begin) {\n                size_t first = begin > group_begin ? begin - group_begin : 0;\n                size_t last = end < group_end ? end - group_begin : length;\n                for (size_t p = first; p < last; ++p) {\n                    size_t order = group_begin + p;\n                    float d = euclidean_distance_no_sqrt(to_evaluate,\n                                                         groups[g].points[p]);\n                    if (d != d) {\n                        saw_nan = 1;\n                        d = 0;\n                    }\n                    items[order].order = order;\n                    items[order].distance = d;\n                    items[order].label = groups[g].label;\n                }\n            }\n            group_begin = group_end;\n        }\n\n        size_t local_count = end - begin;\n        if (local_count > keep) local_count = keep;\n        knn_select_prefix(items + begin, end - begin, local_count, farthest);\n        counts[tid] = local_count;\n#pragma omp barrier\n\n        for (size_t stride = 1; stride < (size_t) team; stride *= 2) {\n            if ((size_t) tid % (2 * stride) == 0 &&\n                (size_t) tid + stride < (size_t) team) {\n                int partner = (int) ((size_t) tid + stride);\n                size_t partner_begin = knn_block_begin(total, partner, team);\n                size_t left_count = counts[tid];\n                size_t right_count = counts[partner];\n                /* Compaction stays within this pair's original point range. */\n                memmove(items + begin + left_count, items + partner_begin,\n                        right_count * sizeof(*items));\n                size_t combined = left_count + right_count;\n                size_t retained = combined < keep ? combined : keep;\n                knn_select_prefix(items + begin, combined, retained, farthest);\n                counts[tid] = retained;\n            }\n#pragma omp barrier\n        }\n\n#pragma omp for schedule(static) reduction(+:chosen_counts[:KNN_LABEL_COUNT])\n        for (size_t p = 0; p < keep; ++p) {\n            ++chosen_counts[(unsigned char) items[p].label];\n        }\n    }\n\n    free(counts);\n    free(items);\n    if (saw_nan) return knn_sequential(n_groups, groups, k, to_evaluate);\n\n    if (farthest) {\n        for (int b = 0; b < KNN_LABEL_COUNT; ++b)\n            chosen_counts[b] = total_counts[b] - chosen_counts[b];\n    }\n    return knn_vote(chosen_counts);\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
  "src/knn.h": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}"
}

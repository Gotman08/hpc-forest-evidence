"""19 prepared cases; ROOT alone may run. No lifecycle main, live runtime or process.

Eleven pure metadata cases and eight tiny new local-file archive fixtures.
Archive fixtures intentionally exercise the held-object rename rather than mock it.
"""
import argparse
import copy
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import tempfile
import unittest

CODE = Path(__file__).resolve().parent
SELF = CODE/'test_cycle_passif_externe_R8.py'
HELPER = CODE/'cycle-passif-externe-R8.py'
H = None
NATIVE = None


def checksum(path): return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def closure_fixture():
    closure_ref={'path':str(CODE/'INERT-closure.json'),'sha256':'a'*64}
    review_ref={'path':str(CODE/'INERT-review.json'),'sha256':'b'*64}
    final={'path':str(CODE/'INERT-final.json'),'sha256':'c'*64}
    closure={'schema':'hpc-forest-r8-obs4-main-only-owned-passive-closure-v1',
        'verified_metadata_only':True,'verified_owned_observer_absence':True,
        'source_zip_sha256':H.SOURCE,'plan_sha256':H.PLAN,'frozen62':{'sha256':H.COMPONENTS},
        'only_main19968_ever_permitted_as_effect':True,'services_naturally_absent':True,
        'observer_lock_read':False,'current_state_after_observation_promised':False,
        'native_generation_admitted':False,'final_full_cim':final,
        'graph_state':{'all_six_original_identities_absent':True,'pair_absent':True,'unresolved_context':False}}
    reviewed={'schema':'hpc-forest-r8-obs4-main-only-owned-passive-actual-closure-cold-review-v1',
        'closure':closure_ref,'final_full_cim':final,'blocking_findings':[],'native_generation_admitted':False,
        **{key:True for key in ('verified_metadata_only','verified_owned_observer_absence',
             'all_six_original_identities_absent','only_main19968_effect','no_future_state_promised')}}
    return closure,reviewed,closure_ref,review_ref


class PureLifecycleCases(unittest.TestCase):
    def test_01_exact_closure_contract(self): H.closure_contract(*closure_fixture())
    def test_02_proposal_refused(self):
        c,r,cr,rr=closure_fixture();c['fixture_only']=True
        with self.assertRaises(ValueError): H.closure_contract(c,r,cr,rr)
    def test_03_preparation_review_is_not_actual_review(self):
        c,r,cr,rr=closure_fixture();r['schema']='hpc-forest-r8-obs4-main-only-closure-preparation-review-v1'
        with self.assertRaises(ValueError): H.closure_contract(c,r,cr,rr)
    def test_04_unresolved_previous_context_refused(self):
        c,r,cr,rr=closure_fixture();c['graph_state']['unresolved_context']=True
        with self.assertRaises(ValueError): H.closure_contract(c,r,cr,rr)
    def test_05_wrong_plan_refused(self):
        c,r,cr,rr=closure_fixture();c['plan_sha256']='0'*64
        with self.assertRaises(ValueError): H.closure_contract(c,r,cr,rr)
    def anchors(self): return {'contextual_identities':[{'ProcessId':pid} for pid in H.OWNED_IDS]}
    def test_06_absent_six_pure_rows(self):
        H.require_current_six_absence([{'ProcessId':990001,'ParentProcessId':4,'CommandLine':'INERT unrelated'}],self.anchors())
    def test_07_reused_old_pid_refused(self):
        with self.assertRaises(ValueError):H.require_current_six_absence([{'ProcessId':9192,'ParentProcessId':4,'CommandLine':'foreign'}],self.anchors())
    def test_08_ambiguous_child_refused(self):
        with self.assertRaises(ValueError):H.require_current_six_absence([{'ProcessId':990001,'ParentProcessId':9192,'CommandLine':'foreign'}],self.anchors())
    def test_09_equivalent_observer_refused(self):
        with self.assertRaises(ValueError):H.require_current_six_absence([{'ProcessId':990001,'ParentProcessId':4,'CommandLine':str(H.CHAIN/'observer/observer-mixte.py')}],self.anchors())
    def test_18_original_sequence_without_terminal_cannot_archive(self):
        with self.assertRaises(ValueError):H.sequence_terminal({'schema':'hpc-forest-r8-original-passive-sequence-terminal-reception-v1'})
    def test_19_original_finally_is_not_terminal_tool_receipt(self):
        with self.assertRaises(ValueError):H.sequence_terminal({'schema':'hpc-forest-r8-root-one-passive-sequence-execution-v1',
            'last_stage':'cold_copy_four','failure':'INERT expired','native_worker_or_job_started':False,
            'native_generation_admitted':False,'no_retry_performed':True})


class ActualTinyArchiveFixtures(unittest.TestCase):
    def setUp(self):
        self.temp=tempfile.TemporaryDirectory(prefix='INERT-runtime-',dir=CODE)
        self.root=Path(self.temp.name);self.source=self.root/'source';self.out=self.root/'archive'
        self.source.mkdir();self.out.mkdir();self.io=NATIVE(self.root)
    def tearDown(self):
        self.assertEqual(self.root.resolve().parent,CODE.resolve());self.assertTrue(self.root.name.startswith('INERT-runtime-'))
        self.assertFalse(self.root.is_symlink());self.temp.cleanup()
    def prepare(self, *, optional=False):
        files=H.RUNTIME_NAMES if optional else H.RUNTIME_NAMES[:1]
        for name in files:(self.source/name).write_bytes(b'INERT ordinary metadata\n')
        return {name:{'sha256':checksum(self.source/name),
                     'source_native_checkpoint':self.io.read_source(self.source/name)['record']} for name in files}
    def run_archive(self,preserved,**kwargs):
        return H.archive_runtime(self.io,H.RUNTIME_NAMES,self.source,self.out,preserved,intent_written=kwargs.get('intent',True))
    def test_10_same_object_retained_and_canonical_absent(self):
        p=self.prepare();before=(self.source/H.RUNTIME_NAMES[0]).stat();records=self.run_archive(p)
        self.assertEqual(len(records),1);self.assertFalse((self.source/H.RUNTIME_NAMES[0]).exists())
        retained=self.out/('ORIGINAL-'+H.RUNTIME_NAMES[0]);self.assertEqual(retained.stat().st_ino,before.st_ino)
        self.assertEqual(checksum(retained),p[H.RUNTIME_NAMES[0]]['sha256'])
    def test_11_all_three_named_objects_retained(self): self.assertEqual(len(self.run_archive(self.prepare(optional=True))),3)
    def test_12_destination_never_replaced(self):
        p=self.prepare();target=self.out/('ORIGINAL-'+H.RUNTIME_NAMES[0]);target.write_bytes(b'keep me')
        with self.assertRaises(OSError):self.run_archive(p)
        self.assertEqual(target.read_bytes(),b'keep me');self.assertTrue((self.source/H.RUNTIME_NAMES[0]).exists())
    def test_13_hardlink_refused_before_payload(self):
        p=self.prepare();os.link(self.source/H.RUNTIME_NAMES[0],self.root/'alias.bin');before=self.io.payload_reads
        with self.assertRaises(ValueError):self.run_archive(p)
        self.assertEqual(self.io.payload_reads,before)
    def test_14_wrong_preserved_digest_refused_without_rename(self):
        p=self.prepare();p[H.RUNTIME_NAMES[0]]['sha256']='0'*64
        with self.assertRaises(ValueError):self.run_archive(p)
        self.assertTrue((self.source/H.RUNTIME_NAMES[0]).exists())
    def test_15_missing_previous_state_not_a_reset(self):
        with self.assertRaises(ValueError):self.run_archive({})
    def test_16_no_intent_no_effect(self):
        p=self.prepare()
        with self.assertRaises(ValueError):self.run_archive(p,intent=False)
        self.assertTrue((self.source/H.RUNTIME_NAMES[0]).exists())
    def test_17_parent_rename_denied_during_real_directory_lease(self):
        with H.ArchiveDirectories(self.io) as leases:
            leases.hold(self.source)
            with self.assertRaises(PermissionError):os.rename(self.source,self.root/'renamed-source')
        self.assertTrue(self.source.is_dir())


def main():
    global H,NATIVE
    p=argparse.ArgumentParser();p.add_argument('--receipt',type=Path,required=True);args=p.parse_args()
    if os.name!='nt' or args.receipt.parent!=CODE or args.receipt.exists():raise ValueError('New ROOT Windows neutral receipt in CODE only')
    before={str(path):checksum(path) for path in (HELPER,SELF)}
    spec=importlib.util.spec_from_file_location('ROOT_prepared_external_lifecycle_only',HELPER)
    H=importlib.util.module_from_spec(spec);spec.loader.exec_module(H)
    ns=H.bootstrap_io();store=ns['ColdStore']();shared=H.load_module(store,H.COPY_SOURCE,H.COPY_SHA);NATIVE=shared['NativeSharedIO']
    suite=unittest.TestSuite([unittest.defaultTestLoader.loadTestsFromTestCase(PureLifecycleCases),unittest.defaultTestLoader.loadTestsFromTestCase(ActualTinyArchiveFixtures)])
    result=unittest.TextTestRunner(verbosity=2).run(suite)
    after={str(path):checksum(path) for path in (HELPER,SELF)};store.unchanged()
    if before!=after:raise ValueError('Prepared code/test bytes changed')
    value={'schema':'hpc-forest-r8-external-passive-lifecycle-neutral-completion-v1',
        'code_sha256':before[str(HELPER)],'test_sha256':before[str(SELF)],'tests_run':result.testsRun,
        'failures':len(result.failures),'errors':len(result.errors),'skipped':len(result.skipped),
        'exit_code':0 if result.wasSuccessful() and result.testsRun==19 else 1,
        'live_runtime_read_or_changed':False,'native_generation_admitted':False}
    with args.receipt.open('x',encoding='utf8') as stream:json.dump(value,stream,indent=2);stream.write('\n')
    raise SystemExit(value['exit_code'])


if __name__ == '__main__':
    main()

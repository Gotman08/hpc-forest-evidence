      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n#include <string.h>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\n#define MAXNUM 100\n#define MAXSTR 50\n#define MAXRESULTS 1000\n#define MAX_TRIAL_FACTOR 65535u\n#define TRIAL_CAPACITY ((MAX_TRIAL_FACTOR + 1u) / 2u)\n\nchar firstHalf[MAXNUM][MAXSTR];\nchar secondHalf[MAXNUM][MAXSTR];\nchar strToTest[MAXSTR];\nlong int result[MAXRESULTS];\nint numPrimes=0;\n\nstatic uint32_t trial_square[TRIAL_CAPACITY];\nstatic uint32_t trial_inverse[TRIAL_CAPACITY];\nstatic uint32_t trial_threshold[TRIAL_CAPACITY];\nstatic unsigned int trial_count=0;\nstatic int trial_ready=0;\n\nstatic void initialize_trial_divisors(void)\n{\n    static unsigned char composite[MAX_TRIAL_FACTOR + 1u];\n    memset(composite, 0, sizeof composite);\n    trial_count=0;\n\n    for (uint32_t p=3u; p<=MAX_TRIAL_FACTOR; p+=2u) {\n        if (composite[p])\n            continue;\n\n        uint32_t inverse=1u;\n        for (int step=0; step<5; ++step)\n            inverse *= 2u - p * inverse;\n\n        uint32_t square=p*p;\n        trial_square[trial_count]=square;\n        trial_inverse[trial_count]=inverse;\n        trial_threshold[trial_count]=UINT32_MAX/p;\n        ++trial_count;\n\n        if (square<=MAX_TRIAL_FACTOR) {\n            for (uint32_t multiple=square;\n                 multiple<=MAX_TRIAL_FACTOR; multiple+=2u*p)\n                composite[multiple]=1;\n        }\n    }\n    trial_ready=1;\n}\n\nint isprime(long int value)\n{\n    if (value<2)\n        return 0;\n    if ((value & 1L)==0)\n        return value==2;\n\n    if ((uint64_t)value>UINT32_MAX) {\n        for (long int factor=3; factor<=value/factor; factor+=2)\n            if (value%factor==0)\n                return 0;\n        return 1;\n    }\n\n    uint32_t n=(uint32_t)value;\n    if (!trial_ready)\n        initialize_trial_divisors();\n\n    unsigned int i=0;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    uint32x4_t input=vdupq_n_u32(n);\n\n    /* Keep rejection by the smallest factors inexpensive. */\n    if (i+3u<trial_count && trial_square[i+3u]<=n) {\n        uint32x4_t products=vmulq_u32(\n            input, vld1q_u32(trial_inverse+i));\n        uint32x4_t divides=vcleq_u32(\n            products, vld1q_u32(trial_threshold+i));\n        if (vmaxvq_u32(divides)!=0u)\n            return 0;\n        i+=4u;\n    }\n\n    /* Independent vector tests share one horizontal reduction. */\n    for (; i+15u<trial_count && trial_square[i+15u]<=n; i+=16u) {\n        uint32x4_t products0=vmulq_u32(\n            input, vld1q_u32(trial_inverse+i));\n        uint32x4_t products1=vmulq_u32(\n            input, vld1q_u32(trial_inverse+i+4u));\n        uint32x4_t products2=vmulq_u32(\n            input, vld1q_u32(trial_inverse+i+8u));\n        uint32x4_t products3=vmulq_u32(\n            input, vld1q_u32(trial_inverse+i+12u));\n        uint32x4_t divides0=vcleq_u32(\n            products0, vld1q_u32(trial_threshold+i));\n        uint32x4_t divides1=vcleq_u32(\n            products1, vld1q_u32(trial_threshold+i+4u));\n        uint32x4_t divides2=vcleq_u32(\n            products2, vld1q_u32(trial_threshold+i+8u));\n        uint32x4_t divides3=vcleq_u32(\n            products3, vld1q_u32(trial_threshold+i+12u));\n        uint32x4_t divides01=vorrq_u32(divides0, divides1);\n        uint32x4_t divides23=vorrq_u32(divides2, divides3);\n        if (vmaxvq_u32(vorrq_u32(divides01, divides23))!=0u)\n            return 0;\n    }\n\n    for (; i+3u<trial_count && trial_square[i+3u]<=n; i+=4u) {\n        uint32x4_t products=vmulq_u32(\n            input, vld1q_u32(trial_inverse+i));\n        uint32x4_t divides=vcleq_u32(\n            products, vld1q_u32(trial_threshold+i));\n        if (vmaxvq_u32(divides)!=0u)\n            return 0;\n    }\n#endif\n\n    /* For odd p, n is divisible by p exactly when the wrapped\n       product n*inverse(p) is at most UINT32_MAX/p. */\n    for (; i<trial_count && trial_square[i]<=n; ++i)\n        if ((uint32_t)(n*trial_inverse[i])<=trial_threshold[i])\n            return 0;\n    return 1;\n}\n\nvoid quicksort(long int *primes,int first,int last)\n{ int i, j, pivot;\n  long int temp;\n\n  if (first<last)\n     { pivot=first;\n       i=first;\n       j=last;\n       while(i<j)\n         { while (primes[i]<=primes[pivot]&&i<last)\n             i++;\n           while(primes[j]>primes[pivot])\n             j--;\n           if (i<j)\n              { temp=primes[i];\n                primes[i]=primes[j];\n                primes[j]=temp;\n              }\n         }\n       temp=primes[pivot];\n       primes[pivot]=primes[j];\n       primes[j]=temp;\n       quicksort(primes,first,j-1);\n       quicksort(primes,j+1,last);\n     }\n}\n\nint main(int argc,char** argv)\n{ FILE *primesFile;\n  int i=0,j=0,numResults=0;\n  long int primeToTest;\n  primesFile=stdin;\n  fscanf(primesFile,\"%d\\n\",&numPrimes);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",firstHalf[i]);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",secondHalf[i]);\n  fclose(primesFile);\n  for (i=0;i<numPrimes;i++)\n      for (j=0;j<numPrimes;j++)\n          { strcpy(strToTest,firstHalf[i]);\n            strcat(strToTest,secondHalf[j]);\n            primeToTest=atol(strToTest);\n            if (isprime(primeToTest))\n               { result[numResults++]=primeToTest;\n               }\n          }\n  quicksort(result,0,numResults-1);\n  for (i=0;i<numResults;i++)\n      printf(\"%ld\\n\",result[i]);\n  return 0;\n}\n",

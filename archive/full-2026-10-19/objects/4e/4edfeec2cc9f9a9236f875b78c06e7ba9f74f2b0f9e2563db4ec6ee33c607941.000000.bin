      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <omp.h>\n#include <limits.h>\n\n#define MAX_K 128\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\ntypedef struct {\n    float dists[MAX_K];\n    char lbls[MAX_K];\n    int first_gid;  // smallest group index in this partial result\n} TopK;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n    Point point;\n    point.x = x;\n    point.y = y;\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}\n\nvoid init_TopK(TopK *t) {\n    for (int i = 0; i < MAX_K; i++) {\n        t->dists[i] = -1.0f;\n        t->lbls[i] = -1;\n    }\n    t->first_gid = INT_MAX;\n}\n\nvoid merge_topk_into(TopK *dst, TopK *src) {\n    // Ensure dst contains points from earlier groups (smaller first_gid)\n    if (src->first_gid < dst->first_gid) {\n        TopK tmp = *dst;\n        *dst = *src;\n        *src = tmp;\n    }\n    // Now src has larger or equal first_gid; insert its entries into dst\n    for (int i = 0; i < MAX_K; i++) {\n        if (src->dists[i] == -1.0f) continue;\n        float d = src->dists[i];\n        char lbl = src->lbls[i];\n        // Insert into dst using same insertion logic as serial code\n        for (int x = 0; x < MAX_K; x++) {\n            if (d < dst->dists[x] || dst->dists[x] == -1.0f) {\n                for (int y = MAX_K - 1; y > x; y--) {\n                    dst->dists[y] = dst->dists[y-1];\n                    dst->lbls[y] = dst->lbls[y-1];\n                }\n                dst->dists[x] = d;\n                dst->lbls[x] = lbl;\n                break;\n            }\n        }\n    }\n}\n",
      "path": "src/knn.h"
    },
    {
      "content": "#include \"knn.h\"\n#include <omp.h>\n\n#pragma omp declare reduction(merge_topk : TopK : merge_topk_into(&omp_out, &omp_in)) initializer(init_TopK(&omp_priv))\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    // Initialize global top-k list\n    for (int i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1.0f;\n    }\n\n    TopK global;\n    init_TopK(&global);\n\n    // Parallel loop over groups with static scheduling (contiguous chunks preserve input order)\n    #pragma omp parallel for schedule(static) reduction(merge_topk:global)\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        // Update first_gid to track the earliest group processed by this thread's private copy\n        if (i < global.first_gid) global.first_gid = i;\n\n        for (int j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            // Insert into thread-local top-k list (global is private per thread due to reduction)\n            for (int x = 0; x < MAX_K; x++) {\n                if (d < global.dists[x] || global.dists[x] == -1.0f) {\n                    for (int y = MAX_K - 1; y > x; y--) {\n                        global.dists[y] = global.dists[y-1];\n                        global.lbls[y] = global.lbls[y-1];\n                    }\n                    global.dists[x] = d;\n                    global.lbls[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    // Copy the top k entries from the reduced TopK into distances/labels arrays\n    for (int i = 0; i < k && i < MAX_K; i++) {\n        if (global.dists[i] == -1.0f) break;\n        distances[i] = global.dists[i];\n        labels[i] = global.lbls[i];\n    }\n\n    // Find most frequent label among the k nearest neighbors\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(labels);\n    free(distances);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Using an OpenMP user-defined reduction (merge_topk) on a struct containing fixed-size top-k arrays eliminates explicit per-thread allocation and manual merge loops. Static scheduling preserves contiguous group chunks, and the custom combiner respects input order by comparing first_gid to insert earlier-group points first during tie-breaking. This reduces synchronization overhead while leveraging OpenMP work sharing and reductions for better thread granularity.",
  "notes": "Replaced previous per-thread arrays + manual merge with a single TopK reduction variable. Added MAX_K=128 (sufficient for any reasonable k). The combiner ensures deterministic ordering by always inserting points from later groups into the result of earlier groups. Static scheduling maintains contiguous group ranges, so first_gid correctly reflects group order.",

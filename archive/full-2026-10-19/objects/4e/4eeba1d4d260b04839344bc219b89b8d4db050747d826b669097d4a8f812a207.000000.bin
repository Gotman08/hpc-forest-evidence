from pathlib import Path
import re,shutil,json,hashlib,time
B=Path(r"C:\Users\nicol\Documents\Codex\2026-10-15\cr")
D=B/"outputs/HPC-Forest-Etude-2020-2024-r1/reprises/reorientation-max-20261017/premiers-demarrages-20261017"
p=B/"ID.md";shutil.copy2(p,D/"ID-avant.md")
s=p.read_text(encoding="utf-8-sig")
ids_before=re.findall(r"^\| (ID-\d{3}) \|",s,re.M)
assert len(ids_before)==40 and len(set(ids_before))==40
new={
"ID-006":"| ID-006 | Corriger seulement la préparation et les interfaces, pas les algorithmes des candidats | Contrôle obligatoire du premier démarrage de CHAQUE R2/R3/R4/R5 avant extension ; reçus techniques à produire lors des lancements réels | Modèle/effort MAX effectifs, allocation, transport, premier appel livré, première évaluation et erreurs ; correctifs techniques isolés et contrôlés, aucun rejeu ni négatif effacé | reprises/reorientation-max-20261017/premiers-demarrages-20261017/ sous l’étude ; SUIVI-COMPACT.md |",
"ID-015":"| ID-015 | Comparer les harnais, dont GPT Sol avec/sans ; périmètre réorienté MAX uniquement par l’humain | Source-only Luna/Astra/Terra MAX : 45/60 issues reçues/auditées ; Sol MAX 751592 engagé pour les quinze dernières. R1 MAX complet 60/60. Véritable Codex non admis. | Les anciennes grilles 300+300 ne sont plus des préalables à R2/R3 ; comparaison Codex éventuelle selon protocole MAX révisé et admissions propres, cinq confirmations et coûts/erreurs conservés | SUIVI-COMPACT.md ; vérification R1 full MAX ; reçus source-only ; aucun autre effort à lancer |",
"ID-019":"| ID-019 | Tester les anciens problèmes de 2020 à 2024, différents chaque année | R1 MAX complet pour les quatre modèles sur quinze sujets admis ; R2 primes en nouvelle préparation certifiée finie, zéro cellule native encore lancée | 19 sujets catalogués, quinze admis R1 et quatre exclusions conservées ; qualification R2 et contrôle de premier démarrage requis | 2024 : page d’attente, PDF 404 ; aucune invention de sujet ; HPC-Forest-Primes-Max-Certifie-r1/ |",
"ID-021":"| ID-021 | Tester GPT-6 Luna, GPT-6 Astra et GPT-5.6 Terra en plus de Sol | R1 MAX : quatre modèles × quinze sujets admis = 60/60 cellules reçues et auditées ; historiques autres efforts conservés | Quatre identités exactes, aucun modèle substitué ; les échecs et références conservées restent reçus, pas nécessairement améliorés | receptions/verification-r1-full-max-20261017/verification.json ; huit groupes MAX clos |",
"ID-022":"| ID-022 | Tester tous ces modèles de MAX à low | Extension abandonnée sur consigne humaine : MAX uniquement ; conserver les vingt couples count déjà reçus et tous autres résultats existants | Ne plus lancer xhigh/high/medium/low ; les cellules non démarrées restent non testées, aucun ancien négatif rejoué | reorientation-max-20261017/decision-humaine-verifiee.json ; R1 MAX complet, priorité R2 puis mère dynamique MAX |"
}
lines=s.splitlines()
for k,v in new.items():
 matches=[i for i,l in enumerate(lines) if l.startswith("| "+k+" |")]
 assert len(matches)==1
 lines[matches[0]]=v
s="\n".join(lines)+"\n"
s+="\n### Consignes humaines MAX et premier démarrage — 17 octobre 2026\n\nR1 MAX est vérifié complet : quatre modèles, quinze sujets admis chacun, 60/60 cellules reçues/auditées. Les grilles non-MAX sont arrêtées comme objectif futur ; leurs résultats et exclusions restent conservés. Priorité R2 certifié puis mère dynamique MAX avec l’identité des correctifs R4 explicitement déclarée. L’humain autorise l’arrêt propre du supplément R1 Sol xhigh 751571 ; son runner distant est CANCELLED, ses neuf livraisons sont conservées et la réception partielle/audit/réconciliation doivent précéder l’arrêt local individuel possédé. Source-only Sol MAX 751592 reste préservé.\n\nÀ chaque premier démarrage réel R2, R3, R4 et R5, vérifier identité/MAX, allocation, transport, premier appel normal livré, première évaluation et journaux d’erreurs. Aucun élargissement avant reçu technique et résolution des défauts confirmés ; corrections en révision isolée, sans toucher worker vivant/oracle/candidat ni rejouer un appel commencé. Les prérequis R5/Flash restent requis. Preuves et règles : SUIVI-COMPACT.md et reprises/reorientation-max-20261017/premiers-demarrages-20261017/ sous l’étude. Les instantanés éditoriaux plus anciens ne remplacent pas ces consignes vivantes.\n"
assert re.findall(r"^\| (ID-\d{3}) \|",s,re.M)==ids_before
p.write_text(s,encoding="utf-8")
shutil.copy2(p,D/"ID-apres.md")
r={"verified":True,"recorded_at":time.time(),"all_forty_IDs_preserved":True,"updated_rows":list(new),"sha256":hashlib.sha256(p.read_bytes()).hexdigest(),"native_startup_admitted":False}
(D/"mise-a-jour-ID.json").write_text(json.dumps(r,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
print(json.dumps(r))

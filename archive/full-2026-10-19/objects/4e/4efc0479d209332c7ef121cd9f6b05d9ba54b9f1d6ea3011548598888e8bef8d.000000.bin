"""Seal this bounded local preparation. Creates no production admission."""
from __future__ import annotations

import ast
import hashlib
import json
import zipfile
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
PREP = HERE.parent
BASE = PREP.parents[1]


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def ref(path):
    return {"path": str(Path(path).resolve(strict=True)), "sha256": sha(path)}


def read(path):
    return json.loads(Path(path).read_text(encoding="utf8"))


def write(name, value):
    with (HERE / name).open("x", encoding="utf8", newline="\n") as stream:
        json.dump(value, stream, indent=2, ensure_ascii=False)
        stream.write("\n")


def verify_project(project, source_zip):
    actual = {p.relative_to(project).as_posix(): sha(p) for p in project.rglob("*") if p.is_file()}
    with zipfile.ZipFile(source_zip) as archive:
        files = [p for p in archive.infolist() if not p.is_dir()]
        expected = {p.filename.removeprefix("HPC-Forest/"): hashlib.sha256(archive.read(p)).hexdigest() for p in files}
        assert len(files) == len(expected) and expected == actual
    return len(actual)


def functions(path):
    return {n.name: ast.dump(n, include_attributes=False) for n in ast.parse(path.read_text(encoding="utf8")).body
            if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))}


def main():
    binding = read(HERE / "SOURCE-BINDING.json")
    copies = read(HERE / "COPIES-EXTERNES-NON-ADMISES.json")
    assert copies["source_binding"] == ref(HERE / "SOURCE-BINDING.json")
    assert binding["projection_producer_sha256"] == sha(HERE / "lane_projection.py")
    assert verify_project(Path(binding["source_project"]), Path(binding["source_zip"]["path"])) == 105
    old_project = BASE / "work/hpc-forest-mere-dynamique-r4b-max/project"
    old_zip = PREP / "revision-source-r4b/revision-r2/HPC-Forest-Mere-Dynamique-R4b-MAX.zip"
    assert verify_project(old_project, old_zip) == 103
    delta = {}
    for name, item in copies["copies"].items():
        before, after = Path(item["predecessor"]["path"]), Path(item["derivative"]["path"])
        assert sha(before) == item["predecessor"]["sha256"] and sha(after) == item["derivative"]["sha256"]
        original, current = functions(before), functions(after)
        assert original.keys() == current.keys()
        delta[name] = {"changed_function_AST": sorted(k for k in original if original[k] != current[k]),
                       "identical_functions": sorted(k for k in original if original[k] == current[k]),
                       "predecessor": ref(before), "derivative": ref(after)}
    tests = (HERE / "tests-neutres-r3.log").read_text(encoding="utf-8-sig")
    ruff = (HERE / "ruff-r3.log").read_text(encoding="utf-8-sig")
    assert "35 passed" in tests and "All checks passed!" in ruff
    write("VERIFICATION-DELTA-ADAPTATEURS.json", {
        "schema": "hpc-forest-lane-r2-local-adapter-delta-verification-v1", "verified": True,
        "verification_scope": "local static copies, exact source inventories and inert tests only",
        "new_source_files": 105, "historical_EDE_source_files_unchanged": 103,
        "source_binding": ref(HERE / "SOURCE-BINDING.json"), "copy_delta": delta,
        "tests": ref(HERE / "tests-neutres-r3.log"), "ruff": ref(HERE / "ruff-r3.log"),
        "actual_private_projection_preflight_executed": False, "native_generation_admitted": False})
    members = {}
    for path in sorted(HERE.rglob("*")):
        if path.is_file():
            assert not path.is_symlink()
            members[path.relative_to(HERE).as_posix()] = sha(path)
    write("MANIFESTE-ADAPTATEURS-NON-ADMIS.json", {
        "schema": "hpc-forest-lane-r2-local-adapter-manifest-v1", "verified": False,
        "generated_at": datetime.now(UTC).isoformat(), "files": members,
        "native_generation_admitted": False})
    code = ["lane_projection.py", "factory_preflight.py", "prepare_adapter_copies.py", "sceller_livraison.py",
            "launcher/bootstrap_worker.py", "launcher/remote_stage.py", "launcher/cell_selection.py",
            "launcher/native_worker_detection.py", "launcher/pins-source-plan.json", "SOURCE-BINDING.json"]
    write("LIVRAISON-ADAPTATEURS-LANE-R2-NON-ADMISE.json", {
        "schema": "hpc-forest-lane-r2-adapter-first-step-delivery-v1", "verified": False,
        "local_first_step_implemented": True, "scope_id": binding["scope_id"],
        "source_zip_sha256": binding["source_zip"]["sha256"], "plan_sha256": binding["plan"]["sha256"],
        "source_file_count": 105, "code_pins": {p: sha(HERE / p) for p in code},
        "source_binding": ref(HERE / "SOURCE-BINDING.json"), "source_delivery": binding["source_delivery"],
        "manifest": ref(HERE / "MANIFESTE-ADAPTATEURS-NON-ADMIS.json"),
        "delta_verification": ref(HERE / "VERIFICATION-DELTA-ADAPTATEURS.json"),
        "readme": ref(HERE / "REPRISE-NON-ADMISE.md"),
        "targeted_inert_tests_passed": 35, "ruff_passed": True,
        "two_modes_truthful": True, "source_only_preserved_false_not_relabelled": True,
        "new_bootstrap_stage_source105_bound": True, "worker_cache_anchor_unchanged": True,
        "roots_explicit_one_to_eight_unchanged": True, "same_nine_MAX_sessions": True,
        "native_NORMAL_criteria_changed": False, "historical_negative_Luna_promoted": False,
        "authorization_producing_factory_complete": False, "new_cold_reader_bridge_OBS4_complete": False,
        "allocated_qualification_received": False, "independent_activation_review_received": False,
        "actual_private_projection_preflight_executed": False,
        "model_CLI_RPC_job_CIM_live_cache_lock_transition_stop_calls": 0,
        "native_generation_admitted": False, "activation_admitted": False,
        "remaining_admissions": binding["remaining_admissions"]})
    print(json.dumps({"delivery": ref(HERE / "LIVRAISON-ADAPTATEURS-LANE-R2-NON-ADMISE.json"),
                      "manifest": ref(HERE / "MANIFESTE-ADAPTATEURS-NON-ADMIS.json"),
                      "tests": 35, "native_generation_admitted": False}))


if __name__ == "__main__":
    main()

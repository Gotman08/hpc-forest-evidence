{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include <stdio.h>\\n#include <stdlib.h>\\n#include <ctype.h>\\n#include <limits.h>\\n#include <stdint.h>\\n#include <string.h>\\n\\ntypedef struct {\\n    float x;\\n    float y;\\n} Point;\\n\\ntypedef struct {\\n    char label;\\n    int length;\\n    Point * points;\\n} Group;\\n\\nvoid on_error() {\\n    printf(\\\"Invalid input file.\\\\n\\\");\\n    exit(1);\\n}\\n\\ntypedef struct {\\n    char *data;\\n    size_t position;\\n    size_t length;\\n    size_t capacity;\\n    int at_eof;\\n} KnnInputWindow;\\n\\nstatic KnnInputWindow knn_input;\\n\\nstatic void knn_input_refill(void) {\\n    if (knn_input.at_eof) {\\n        return;\\n    }\\n\\n    if (knn_input.data == NULL) {\\n        knn_input.capacity = 65536;\\n        knn_input.data = (char *)malloc(knn_input.capacity + 1);\\n        if (knn_input.data == NULL) {\\n            on_error();\\n        }\\n    }\\n\\n    size_t remaining = knn_input.length - knn_input.position;\\n    if (remaining != 0 && knn_input.position != 0) {\\n        memmove(knn_input.data, knn_input.data + knn_input.position,\\n                remaining);\\n    }\\n    knn_input.position = 0;\\n    knn_input.length = remaining;\\n\\n    if (knn_input.length == knn_input.capacity) {\\n        if (knn_input.capacity > (SIZE_MAX - 1) / 2) {\\n            on_error();\\n        }\\n        size_t capacity = knn_input.capacity * 2;\\n        char *data = (char *)realloc(knn_input.data, capacity + 1);\\n        if (data == NULL) {\\n            on_error();\\n        }\\n        knn_input.data = data;\\n        knn_input.capacity = capacity;\\n    }\\n\\n    size_t count = fread(knn_input.data + knn_input.length, 1,\\n                         knn_input.capacity - knn_input.length, stdin);\\n    knn_input.length += count;\\n    knn_input.data[knn_input.length] = 0;\\n    if (ferror(stdin)) {\\n        on_error();\\n    }\\n    if (feof(stdin) || count == 0) {\\n        knn_input.at_eof = 1;\\n    }\\n}\\n\\nstatic int knn_input_peek(void) {\\n    if (knn_input.position == knn_input.length) {\\n        knn_input_refill();\\n        if (knn_input.position == knn_input.length) {\\n            return EOF;\\n        }\\n    }\\n    return (unsigned char)knn_input.data[knn_input.position];\\n}\\n\\nstatic int knn_input_take(void) {\\n    int value = knn_input_peek();\\n    if (value != EOF) {\\n        ++knn_input.position;\\n    }\\n    return value;\\n}\\n\\nstatic void knn_input_skip_space(void) {\\n    int value;\\n    while ((value = knn_input_peek()) != EOF &&\\n           isspace((unsigned char)value)) {\\n        ++knn_input.position;\\n    }\\n}\\n\\nstatic void knn_input_expect(const char *literal) {\\n    knn_input_skip_space();\\n    while (*literal != 0) {\\n        if (knn_input_take() != (unsigned char)*literal) {\\n            on_error();\\n        }\\n        ++literal;\\n    }\\n}\\n\\nstatic int knn_input_number_character(unsigned char value) {\\n    return (value >= '0' && value <= '9') ||\\n           (value >= 'a' && value <= 'z') ||\\n           (value >= 'A' && value <= 'Z') ||\\n           value == '+' || value == '-' || value == '.' ||\\n           value == '_' || value == '(' || value == ')';\\n}\\n\\n/* Keep complete numeric lexemes resident before calling strtof/strtol. */\\nstatic void knn_input_prepare_number(void) {\\n    knn_input_skip_space();\\n    size_t scanned = 0;\\n    for (;;) {\\n        while (scanned < knn_input.length - knn_input.position) {\\n            unsigned char value = (unsigned char)\\n                knn_input.data[knn_input.position + scanned];\\n            if (!knn_input_number_character(value)) {\\n                return;\\n            }\\n            ++scanned;\\n        }\\n        if (knn_input.at_eof) {\\n            return;\\n        }\\n        knn_input_refill();\\n    }\\n}\\n\\nstatic int knn_input_integer(void) {\\n    knn_input_prepare_number();\\n    char *begin = knn_input.data + knn_input.position;\\n    char *end;\\n    long value = strtol(begin, &end, 10);\\n    if (end == begin || value < INT_MIN || value > INT_MAX) {\\n        on_error();\\n    }\\n    knn_input.position = (size_t)(end - knn_input.data);\\n    return (int)value;\\n}\\n\\nstatic float knn_input_float(void) {\\n    knn_input_prepare_number();\\n    char *begin = knn_input.data + knn_input.position;\\n    char *end;\\n    float value = strtof(begin, &end);\\n    if (end == begin) {\\n        on_error();\\n    }\\n    knn_input.position = (size_t)(end - knn_input.data);\\n    return value;\\n}\\n\\nint parse_number_of_groups() {\\n    knn_input_expect(\\\"n_groups=\\\");\\n    return knn_input_integer();\\n}\\n\\nPoint parse_point() {\\n    Point point;\\n    knn_input_expect(\\\"(\\\");\\n    point.x = knn_input_float();\\n    knn_input_expect(\\\",\\\");\\n    point.y = knn_input_float();\\n    if (knn_input_take() != ')') {\\n        on_error();\\n    }\\n    return point;\\n}\\n\\nGroup parse_next_group() {\\n    knn_input_expect(\\\"label=\\\");\\n    int label = knn_input_take();\\n    if (label == EOF) {\\n        on_error();\\n    }\\n    knn_input_expect(\\\"length=\\\");\\n    int length = knn_input_integer();\\n\\n    Group group;\\n    group.label = (char)label;\\n    group.length = length;\\n    group.points = (Point *) malloc(sizeof(Point) * length);\\n\\n    for (int i = 0; i < length; i++) {\\n        group.points[i] = parse_point();\\n    }\\n\\n    return group;\\n}\\n\\nint parse_k() {\\n    knn_input_expect(\\\"k=\\\");\\n    return knn_input_integer();\\n}\\n\\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\\n}\\n\\nint compare_for_sort(const void *a, const void *b) {\\n  return *(char*)a - *(char*)b;\\n}\\n\",\n      \"path\": \"src/knn.h\"\n    }\n  ],\n  \"hypothesis\": \"A reusable contiguous input window should improve parsing locality and reduce per-coordinate stdio overhead without changing neighbor selection.\",\n  \"notes\": \"Distance arithmetic, selection, tie handling and output remain unchanged. No commands or tests executed.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Replace repeated scanf calls with bulk fread into a reusable 64-KiB sliding window.\",\n    \"Convert resident numeric tokens directly with strtof and strtol, preserving boundary-spanning tokens and growing the window when necessary.\"\n  ]\n}"}}

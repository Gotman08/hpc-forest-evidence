/*
    This program solves Laplace's equation on a regular 2D grid using simple Jacobi iteration.
*/
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <time.h>
#include <sys/time.h>

#define CONV_THRESHOLD 1.0e-5f // threshold of convergence

// Contiguous row-major working and auxiliary matrices.
double *grid;
double *new_grid;

// size of each side of the grid
int size;
int iter_max_num;

// return the absolute value of a number
double absolute(double num){
    if(num < 0)
        return -1.0 * num;
    return num;
}

// allocate memory for the grids
void allocate_memory(){
    if(size <= 0){
        grid = NULL;
        new_grid = NULL;
        return;
    }

    const size_t n = (size_t)size;
    if(n > SIZE_MAX / sizeof(*grid) / n)
        exit(EXIT_FAILURE);

    const size_t bytes = n * n * sizeof(*grid);
    grid = (double *)malloc(bytes);
    new_grid = (double *)malloc(bytes);
    if(grid == NULL || new_grid == NULL){
        free(grid);
        free(new_grid);
        exit(EXIT_FAILURE);
    }
}

// initialize the grids, including identical fixed boundaries
void initialize_grid(){
    int center = size / 2;
    int linf = center - (size / 10);
    int lsup = center + (size / 10);
    const size_t stride = (size_t)size;

    for(int i = 0; i < size; i++){
        const size_t row = (size_t)i * stride;
        for(int j = 0; j < size; j++){
            double value;
            if(i >= linf && i <= lsup && j >= linf && j <= lsup)
                value = 100;
            else
                value = 0;
            grid[row + (size_t)j] = value;
            new_grid[row + (size_t)j] = value;
        }
    }
}

// save the grid in a file
void save_grid(){
    const size_t stride = (size_t)size;
    for(int i = 0; i < size; i++){
        const double *row = grid + (size_t)i * stride;
        for(int j = 0; j < size; j++){
            fprintf(stdout, "%lf ", row[j]);
        }
        fprintf(stdout, "\n");
    }
}

int main(int argc, char *argv[]){
    fscanf(stdin, "%d", &size);
    fscanf(stdin, "%d", &iter_max_num);

    int hasError = 1;
    int iter = 0;
    const size_t stride = (size_t)size;

    allocate_memory();
    initialize_grid();

    // Each sweep reads only the current buffer and writes the next buffer.
    while(hasError && iter < iter_max_num){
        hasError = 0;
        for(int i = 1; i < size - 1; i++){
            const size_t offset = (size_t)i * stride;
            const double *restrict current = grid + offset;
            const double *restrict north = grid + offset - stride;
            const double *restrict south = grid + offset + stride;
            double *restrict next = new_grid + offset;
            int rowHasError = 0;

            for(int j = 1; j < size - 1; j++){
                const double value = 0.25 * (current[j + 1] + current[j - 1] +
                                             north[j] + south[j]);
                next[j] = value;
                const double errorCurrent = absolute(value - current[j]);
                rowHasError |= (errorCurrent > CONV_THRESHOLD);
            }
            hasError |= rowHasError;
        }

        // Publish this iteration, including the iteration that converges.
        double *temporary = grid;
        grid = new_grid;
        new_grid = temporary;
        iter++;
    }

    save_grid();
    free(grid);
    free(new_grid);
    return 0;
}

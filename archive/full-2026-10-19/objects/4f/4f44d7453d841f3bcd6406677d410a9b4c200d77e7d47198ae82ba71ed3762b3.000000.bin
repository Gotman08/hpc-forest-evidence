#include <iostream>
#include <vector>
#include <cstdio>

int main() {
    int n, s;
    std::cin >> n >> s;
    std::vector<std::vector<int>> matrix(n, std::vector<int>(n));
    for(int i = 0; i < n; i++)
        for(int j = 0; j < n; j++) 
            scanf("%d", &(matrix[i][j]));

    int sum = 0;
    for(int i = 0; i < s; i++)
        for(int j = 0; j < s; j++)
            sum += matrix[i][j];

    int mxSum = sum;

    for(int i = 0; i <= n - s; i++) {
        for(int j = 0; j <= n - s; j++) {
            if (i == 0 && j == 0) continue;
            if (j == 0) {
                for(int k = 0; k < s; k++) {
                    sum -= matrix[i + k][j + s - 1];
                    sum += matrix[i + k][j];
                }
            } else {
                for(int k = 0; k < s; k++) {
                    sum -= matrix[i + s - 1][j + k];
                    sum += matrix[i][j + k];
                }
            }
            mxSum = std::max(mxSum, sum);
        }
    }

    printf("%d\n", mxSum);
}
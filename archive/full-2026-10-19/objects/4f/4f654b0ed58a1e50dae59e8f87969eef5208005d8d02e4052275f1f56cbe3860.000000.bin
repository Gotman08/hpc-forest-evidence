#include <stdio.h>
#include <stdlib.h>

typedef struct {
    float x;
    float y;
} Point;

typedef struct {
    char label;
    int length;
    float *xs;   // array of x coordinates
    float *ys;   // array of y coordinates
} Group;

void on_error() {
    printf("Invalid input file.\n");
    exit(1);
}

int parse_number_of_groups() {
    int n;
    if (scanf(" n_groups=%d ", &n) != 1) on_error();
    return n;
}

Point parse_point() {
    float x, y;
    if (scanf(" (%f ,%f) ", &x, &y) != 2) on_error();
    Point point;
    point.x = x;
    point.y = y;
    return point;
}

Group parse_next_group() {
    char label; 
    int length;

    if (scanf(" label=%c ", &label) != 1) on_error();
    if (scanf(" length=%d ", &length) != 1) on_error();

    Group group;
    group.label = label;
    group.length = length;
    // Aligned allocation for SIMD-friendly access
    if (posix_memalign((void**)&group.xs, 16, sizeof(float) * length) != 0)
        on_error();
    if (posix_memalign((void**)&group.ys, 32, sizeof(float) * length) != 0)
        on_error();

    for (int i = 0; i < length; i++) {
        Point p = parse_point();
        group.xs[i] = p.x;
        group.ys[i] = p.y;
    }

    return group;
}

int parse_k() {
    int k;
    if (scanf(" k=%d ", &k) != 1) on_error();
    return k;
}

float euclidean_distance_no_sqrt(Point a, Point b) {
    float dx = b.x - a.x;
    float dy = b.y - a.y;
    return dx * dx + dy * dy;
}

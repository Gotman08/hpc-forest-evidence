      "content": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <iterator>\n#include <string>\n\n#ifdef _OPENMP\n#include <omp.h>\n#include <vector>\n#endif\n\nstruct PrintPermutation\n{\n    template <typename Iter> auto\n    operator () (Iter first, Iter last) const -> void\n    {\n        std::cout << \"[ \" ;\n        while (first != last) {\n            std::cout << *first << \" \" ;\n            ++ first ;\n        }\n        std::cout << \"]\" << std::endl ;\n    }\n} ;\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ' )\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v') ;\n    }\n} ;\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase\n        ( std::remove_if\n            ( text.begin ()\n            , text.end ()\n            , IsWhitespace () )\n        , text.end () ) ;\n    return text ;\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator <char> begin (in), end ;\n    std::string text (begin, end) ;\n    text = remove_whitespaces (text) ;\n    return text ;\n}\n\nnamespace {\n\nconst std::size_t output_block_bytes = 256u * 1024u;\nconst std::size_t max_buffered_characters = (output_block_bytes - 4u) / 2u;\n\nvoid format_row(char* out, const std::string& text)\n{\n    *out++ = '[';\n    *out++ = ' ';\n    for (std::size_t i = 0; i < text.size(); ++i) {\n        *out++ = text[i];\n        *out++ = ' ';\n    }\n    *out++ = ']';\n    *out = '\\n';\n}\n\nvoid print_serial(std::string& text)\n{\n    if (text.empty()) return;\n\n    // Oversized rows retain a streaming path without computing 2 * size + 4.\n    if (text.size() > max_buffered_characters) {\n        PrintPermutation print;\n        do {\n            print(text.begin(), text.end());\n        } while (std::next_permutation(text.begin(), text.end()));\n        return;\n    }\n\n    const std::size_t row_bytes = 2u * text.size() + 4u;\n    std::string block(output_block_bytes, '\\0');\n    std::size_t used = 0;\n    do {\n        if (output_block_bytes - used < row_bytes) {\n            std::cout.write(block.data(), static_cast<std::streamsize>(used));\n            used = 0;\n        }\n        format_row(&block[used], text);\n        used += row_bytes;\n    } while (std::next_permutation(text.begin(), text.end()));\n\n    if (used != 0) {\n        std::cout.write(block.data(), static_cast<std::streamsize>(used));\n    }\n}\n\n#ifdef _OPENMP\n\nstd::size_t common_divisor(std::size_t a, std::size_t b)\n{\n    while (b != 0) {\n        const std::size_t remainder = a % b;\n        a = b;\n        b = remainder;\n    }\n    return a;\n}\n\nbool extend_count(std::size_t& count, std::size_t length,\n                  std::size_t multiplicity, std::size_t limit)\n{\n    // The new multinomial count is count * length / multiplicity.\n    // After cancellation, the remaining divisor divides length exactly.\n    const std::size_t divisor = common_divisor(count, multiplicity);\n    const std::size_t left = count / divisor;\n    const std::size_t right = length / (multiplicity / divisor);\n    if (right > limit / left) return false;\n    count = left * right;\n    return true;\n}\n\nstd::size_t count_up_to(const std::string& sorted, std::size_t limit)\n{\n    std::size_t count = 1;\n    std::size_t multiplicity = 0;\n    for (std::size_t i = 0; i < sorted.size(); ++i) {\n        if (i != 0 && sorted[i] == sorted[i - 1]) {\n            ++multiplicity;\n        } else {\n            multiplicity = 1;\n        }\n        if (!extend_count(count, i + 1, multiplicity, limit)\n            || count == limit) {\n            return limit;\n        }\n    }\n    return count;\n}\n\nstd::size_t bounded_suffix(const std::string& text, std::size_t row_limit)\n{\n    std::size_t first = text.size();\n    std::size_t count = 1;\n    std::size_t multiplicity = 0;\n\n    while (first != 0) {\n        const std::size_t candidate = first - 1;\n        // A complete prefix subtree must begin with its suffix sorted.\n        if (candidate + 1 < text.size()\n            && text[candidate] > text[candidate + 1]) {\n            break;\n        }\n        if (candidate + 1 < text.size()\n            && text[candidate] == text[candidate + 1]) {\n            ++multiplicity;\n        } else {\n            multiplicity = 1;\n        }\n        std::size_t extended = count;\n        if (!extend_count(extended, text.size() - candidate,\n                          multiplicity, row_limit)) {\n            break;\n        }\n        count = extended;\n        first = candidate;\n    }\n    return first;\n}\n\nstruct PrefixJob\n{\n    std::string text;\n    std::size_t suffix_begin;\n};\n\nvoid print_parallel(std::string& cursor, int thread_count)\n{\n    const std::size_t row_bytes = 2u * cursor.size() + 4u;\n    const std::size_t row_limit = output_block_bytes / row_bytes;\n    std::vector<PrefixJob> jobs(static_cast<std::size_t>(thread_count) * 4u);\n    int job_count = 0;\n    bool more = true;\n\n    #pragma omp parallel num_threads(thread_count) shared(jobs, job_count, more, cursor)\n    {\n        std::string block(output_block_bytes, '\\0');\n        for (;;) {\n            #pragma omp single\n            {\n                job_count = 0;\n                while (more && job_count < static_cast<int>(jobs.size())) {\n                    PrefixJob& job = jobs[job_count];\n                    job.text = cursor;\n                    job.suffix_begin = bounded_suffix(cursor, row_limit);\n                    ++job_count;\n\n                    // Skip to the last permutation of this subtree, then\n                    // advance to the first permutation of the next subtree.\n                    std::reverse(cursor.begin() + job.suffix_begin, cursor.end());\n                    more = std::next_permutation(cursor.begin(), cursor.end());\n                }\n            }\n\n            if (job_count == 0) break;\n\n            // Cyclic static assignment keeps every thread's jobs increasing.\n            // Ordered emission provides backpressure without waiting on an\n            // earlier job that is queued behind a later job on the same thread.\n            #pragma omp for ordered schedule(static, 1)\n            for (int j = 0; j < job_count; ++j) {\n                PrefixJob& job = jobs[j];\n                std::size_t used = 0;\n                do {\n                    format_row(&block[used], job.text);\n                    used += row_bytes;\n                } while (std::next_permutation(\n                    job.text.begin() + job.suffix_begin, job.text.end()));\n\n                #pragma omp ordered\n                {\n                    std::cout.write(block.data(), static_cast<std::streamsize>(used));\n                }\n            }\n            // The work-sharing barrier protects the next reuse of job storage.\n        }\n    }\n}\n\n#endif\n\nvoid print_all(std::string text)\n{\n    if (text.empty()) return;\n    std::sort(text.begin(), text.end());\n\n#ifdef _OPENMP\n    const int thread_count = std::min(4, omp_get_max_threads());\n    const std::size_t parallel_min_rows = 32768u;\n    if (thread_count > 1\n        && text.size() <= max_buffered_characters\n        && count_up_to(text, parallel_min_rows) == parallel_min_rows) {\n        print_parallel(text, thread_count);\n        return;\n    }\n#endif\n\n    print_serial(text);\n}\n\n} // namespace\n\nint main (int argc, char const *argv [])\n{\n    std::string text = read_text_from_stdin <std::string> (std::cin) ;\n    print_all(text);\n    return 0 ;\n}\n",

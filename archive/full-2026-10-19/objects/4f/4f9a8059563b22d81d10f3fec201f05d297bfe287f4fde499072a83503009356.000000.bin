{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"/*\\n    This program solves Laplace's equation on a regular 2D grid using simple Jacobi iteration.\\n\\n    The stencil calculation stops when  ( err >= CONV_THRESHOLD OR  iter > ITER_MAX )\\n*/\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <time.h>\\n#include <sys/time.h>\\n\\n#define CONV_THRESHOLD 1.0e-5f // threshold of convergence\\n\\n// matrix to be solved, stored as a contiguous row-major array\\ndouble *grid;\\n\\n// auxiliary matrix, stored as a contiguous row-major array\\ndouble *new_grid;\\n\\n// size of each side of the grid\\nint size;\\nint iter_max_num;\\n\\n// return the absolute value of a number\\ndouble absolute(double num){\\n    if(num < 0)\\n        return -1.0 * num;\\n    return num;\\n}\\n\\n\\n// allocate memory for the grid\\nvoid allocate_memory(){\\n    size_t cell_count = (size_t)size * (size_t)size;\\n    grid = (double *) malloc(cell_count * sizeof(double));\\n    new_grid = (double *) malloc(cell_count * sizeof(double));\\n}\\n\\n// initialize the grid\\nvoid initialize_grid(){\\n    int center = size / 2;\\n    int linf = center - (size / 10);\\n    int lsup = center + (size / 10);\\n    size_t stride = (size_t)size;\\n    for (int i = 0; i < size; i++){\\n        size_t row_offset = (size_t)i * stride;\\n        for (int j = 0; j < size; j++){\\n            // inicializa região de calor no centro do grid\\n            if ( i >= linf && i <= lsup && j >= linf && j <= lsup)\\n                grid[row_offset + (size_t)j] = 100;\\n            else\\n                grid[row_offset + (size_t)j] = 0;\\n            new_grid[row_offset + (size_t)j] = 0.0;\\n        }\\n    }\\n}\\n\\n// save the grid in a file\\nvoid save_grid(){\\n    size_t stride = (size_t)size;\\n    for(int i = 0; i < size; i++){\\n        double *grid_row = grid + (size_t)i * stride;\\n        for(int j = 0; j < size; j++){\\n            fprintf(stdout, \\\"%lf \\\", grid_row[j]);\\n        }\\n        fprintf(stdout, \\\"\\\\n\\\");\\n    }\\n}\\n\\nint main(int argc, char *argv[]){\\n\\n    fscanf(stdin, \\\"%d\\\", &size);\\n    fscanf(stdin, \\\"%d\\\", &iter_max_num);\\n    \\n    int hasError = 1;\\n    int iter = 0;\\n\\n    struct timeval time_start;\\n    struct timeval time_end;\\n\\n    // allocate memory to the grid (matrix)\\n    allocate_memory();\\n\\n    // set grid initial conditions\\n    initialize_grid();\\n\\n    //printf(\\\"Jacobi relaxation calculation: %d x %d grid\\\\n\\\", size, size);\\n\\n    // get the start time\\n    //gettimeofday(&time_start, NULL);\\n\\n    // Jacobi iteration\\n    // This loop will end if either the maximum change reaches below a set threshold (convergence)\\n    // or a fixed number of maximum iterations have completed\\n    size_t stride = (size_t)size;\\n    while ( hasError && iter < iter_max_num ) {\\n\\n        hasError = 0;\\n        // calculates the Laplace equation to determine each cell's next value\\n        for( int i = 1; i < size-1; i++) {\\n            double *grid_row = grid + (size_t)i * stride;\\n            double *new_row = new_grid + (size_t)i * stride;\\n            double *grid_up = grid_row - stride;\\n            double *grid_down = grid_row + stride;\\n            for(int j = 1; j < size-1; j++) {\\n\\n                new_row[j] = 0.25 * (grid_row[j+1] + grid_row[j-1] +\\n                                     grid_up[j] + grid_down[j]);\\n\\n                double errorCurrent = absolute(new_row[j] - grid_row[j]);\\n                if(errorCurrent > CONV_THRESHOLD ){\\n                    hasError = 1;                                        \\n                }     \\n            }\\n        }            \\n        // copie the next values into the working array for the next iteration\\n        for( int i = 1; i < size-1; i++) {\\n            double *grid_row = grid + (size_t)i * stride;\\n            double *new_row = new_grid + (size_t)i * stride;\\n            for( int j = 1; j < size-1; j++) {\\n                grid_row[j] = new_row[j];\\n            }\\n        }        \\n        iter++;\\n    }\\n\\n    // get the end time\\n    //gettimeofday(&time_end, NULL);\\n\\n    //double exec_time = (double) (time_end.tv_sec - time_start.tv_sec) +\\n    //                   (double) (time_end.tv_usec - time_start.tv_usec) / 1000000.0;\\n\\n    //save the final grid in file\\n    save_grid();\\n\\n    //printf(\\\"\\\\nKernel executed in %lf seconds with %d iterations.\\\\n\\\", exec_time, iter);\\n\\n    return 0;\\n}\\n\",\"path\":\"src/laplace_seq.c\"}],\"hypothesis\":\"Storing each matrix in one contiguous row-major allocation and reusing row pointers in the stencil loop may improve cache and TLB locality while reducing repeated row-pointer lookups, without changing the Jacobi iteration's arithmetic or output.\",\"notes\":\"This is a locality/data-layout experiment only; the sweep order, separate copy pass, arithmetic expression, convergence check, and output formatting remain unchanged. No commands were executed.\",\"sources_kept\":[],\"transformations\":[\"Replaced per-row allocations and double-pointer matrices with contiguous row-major arrays.\",\"Computed current, neighboring, and destination row pointers once per stencil row and reused them across the inner loop.\"]}"}}

{
  "name": "forest-primes-certified-arm64-qual-r1",
  "command": "bash -lc 'set -euo pipefail\nexport PYTHONDONTWRITEBYTECODE=1\nexport OPENBLAS_NUM_THREADS=1\nexport OMP_NUM_THREADS=4\n/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python -I -B - <<'\"'\"'CERTIFIED_PRIMES_QUALIFICATION'\"'\"'\n\"\"\"PROPOSED compute-allocation command. Do not execute locally or on login.\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport os\nimport platform\nimport re\nimport subprocess\nimport sys\nimport tarfile\nfrom datetime import UTC, datetime, timedelta\nfrom pathlib import Path, PurePosixPath\n\nPAYLOAD = Path(\"/scratch_p/nimarano/hpc-forest-primes-certified-e1116d931887fbeb.tar.gz\")\nPAYLOAD_SHA = \"e1116d931887fbebad63e88a7678df13bc09e0381a754d967c79ae8ac7c37eda\"\nMANIFEST_SHA = \"d260af0a7b91cbe5fc7e3ab1ad9313723e385c21fdd75bd5c9623095683022fd\"\nREVIEW_SHA = \"af703fd382e2065eb966cebfd3eb201ee6286826dbc28802185c22c5932269ab\"\nPYTHON = \"/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python\"\nROOT = Path(\"/scratch_p/nimarano/hpc-forest-primes-certified-qualification-20261017-r1-e1116d931887\")\nSCOPE = \"hpc-forest-primes-max-certifie-r1\"\nDEADLINE = datetime(2026, 10, 31, 23, tzinfo=UTC)\n\n\ndef require(value, message):\n    if not value:\n        raise RuntimeError(message)\n\n\ndef sha(path):\n    return hashlib.sha256(path.read_bytes()).hexdigest()\n\n\ndef save(path, value):\n    with path.open(\"x\", encoding=\"utf8\") as stream:\n        json.dump(value, stream, ensure_ascii=True, indent=2)\n        stream.write(\"\\n\")\n\n\ndef inventory(path):\n    return {item.relative_to(path).as_posix(): sha(item)\n            for item in sorted(path.rglob(\"*\")) if item.is_file()}\n\n\ndef allocation_guard():\n    env = os.environ\n    require(platform.system() == \"Linux\" and platform.machine().lower() in (\"aarch64\", \"arm64\"),\n            \"Linux ARM64 compute allocation required\")\n    require(re.fullmatch(r\"[0-9]+\", env.get(\"SLURM_JOB_ID\", \"\")), \"Concrete Slurm job required\")\n    require(env.get(\"SLURM_JOB_NUM_NODES\") == \"1\" and env.get(\"SLURM_NTASKS\") == \"1\"\n            and env.get(\"SLURM_CPUS_PER_TASK\") == \"4\" and env.get(\"SLURM_MEM_PER_NODE\") == \"16384\",\n            \"Exact 1 node/task,4CPU,16GiB allocation required\")\n    require(not env.get(\"SLURM_JOB_GPUS\") and env.get(\"CUDA_VISIBLE_DEVICES\", \"\") in (\"\", \"-1\", \"NoDevFiles\"),\n            \"Zero GPU allocation required\")\n    require(len(os.sched_getaffinity(0)) >= 4, \"Insufficient CPU affinity\")\n    require(datetime.now(UTC) + timedelta(seconds=900 + 10800) < DEADLINE,\n            \"15min qualification plus3h reception reserve exceeds deadline\")\n\n\ndef restore_payload(destination):\n    require(PAYLOAD.is_file() and not PAYLOAD.is_symlink() and sha(PAYLOAD) == PAYLOAD_SHA,\n            \"Payload SHA/type changed\")\n    with tarfile.open(PAYLOAD, \"r:gz\") as archive:\n        members = archive.getmembers()\n        require(len(members) == 67 and sum(item.size for item in members) < 64 * 1024**2,\n                \"Unexpected payload count/size\")\n        material = {}\n        for item in members:\n            name = PurePosixPath(item.name)\n            require(item.isfile() and not item.issym() and not item.islnk()\n                    and not name.is_absolute() and \"..\" not in name.parts and \"\\\\\" not in item.name\n                    and name.parts[0] == SCOPE, \"Unsafe payload member\")\n            relative = name.relative_to(SCOPE).as_posix()\n            require(relative not in material and item.size <= 4 * 1024**2, \"Duplicate/oversized payload member\")\n            material[relative] = archive.extractfile(item).read()\n    require(hashlib.sha256(material[\"prototype-manifest.json\"]).hexdigest() == MANIFEST_SHA,\n            \"Manifest SHA changed\")\n    manifest = json.loads(material[\"prototype-manifest.json\"])\n    require(set(material) == set(manifest) | {\"prototype-manifest.json\"} and len(manifest) == 66,\n            \"Manifest membership differs\")\n    for name, info in manifest.items():\n        require(len(material[name]) == info[\"bytes\"]\n                and hashlib.sha256(material[name]).hexdigest() == info[\"sha256\"], \"Manifest member differs\")\n    destination.mkdir()\n    for name, raw in material.items():\n        target = destination / name\n        require(target.resolve().is_relative_to(destination.resolve()), \"Extraction escaped new root\")\n        target.parent.mkdir(parents=True, exist_ok=True)\n        with target.open(\"xb\") as stream:\n            stream.write(raw)\n    require(inventory(destination) == {name: hashlib.sha256(raw).hexdigest() for name, raw in material.items()},\n            \"Fresh extraction differs\")\n\n\ndef main():\n    allocation_guard()  # No file creation, subprocess, or compiler before these guards.\n    require(not ROOT.exists(), \"Prior attempt exists; preserve it without replay\")\n    ROOT.mkdir()\n    save(ROOT / \"allocation.json\", {\n        \"utc\": datetime.now(UTC).isoformat(), \"platform\": platform.platform(), \"python\": sys.version,\n        \"job_id\": os.environ[\"SLURM_JOB_ID\"], \"affinity_cpu_count\": len(os.sched_getaffinity(0)),\n        \"slurm\": {key: os.environ.get(key) for key in (\n            \"SLURM_JOB_ID\", \"SLURM_JOB_NUM_NODES\", \"SLURM_NTASKS\", \"SLURM_CPUS_PER_TASK\",\n            \"SLURM_MEM_PER_NODE\", \"SLURM_JOB_GPUS\", \"SLURM_RESTART_COUNT\", \"SLURM_JOB_NODELIST\")},\n        \"payload_sha256\": PAYLOAD_SHA, \"manifest_sha256\": MANIFEST_SHA, \"review_sha256\": REVIEW_SHA,\n        \"native_model_calls\": 0, \"native_research_admitted\": False})\n    extraction = ROOT / \"extraction\"\n    before = None\n    passed = False\n    failure = None\n    code = 1\n    try:\n        restore_payload(extraction)\n        before = inventory(extraction)\n        sys.path.insert(0, str(extraction / \"tools\"))\n        import validate\n        checked = validate.validate_preparation(extraction / \"data\")\n        require(len(checked[\"cases\"]) == 12 and sorted(row[\"p\"] for row in checked[\"cases\"])\n                == [1, 1, 2, 2, 4, 4, 8, 8, 16, 16, 30, 30], \"Twelve exact certified cases required\")\n        save(ROOT / \"pre-execution-data-audit.json\", checked)\n        require(datetime.now(UTC) + timedelta(seconds=900 + 10800) < DEADLINE, \"Deadline changed after restore\")\n        try:\n            completed = subprocess.run(\n                [PYTHON, \"-B\", str(extraction / \"tools/qualify_arm64.py\"), \"--data\", str(extraction / \"data\"),\n                 \"--output\", str(ROOT / \"qualification\")], capture_output=True, check=False, timeout=720)\n            stdout, stderr, code = completed.stdout, completed.stderr, completed.returncode\n        except subprocess.TimeoutExpired as exc:\n            stdout, stderr, code = exc.stdout or b\"\", exc.stderr or b\"\", 124\n            failure = \"Owned qualification process timeout; preserved, never retried\"\n        (ROOT / \"qualification-launch.stdout\").write_bytes(stdout)\n        (ROOT / \"qualification-launch.stderr\").write_bytes(stderr)\n        proof = json.loads((ROOT / \"qualification/qualification.json\").read_text())\n        passed = (code == 0 and proof[\"status\"] == \"mechanical_reference_passed_not_native_model_admitted\"\n                  and len(proof[\"cases\"]) == 12 and proof[\"source_and_data_unchanged\"] is True\n                  and proof[\"native_model_calls\"] == 0 and proof[\"native_research_admitted\"] is False)\n    except Exception as exc:\n        failure = type(exc).__name__ + \": \" + str(exc)\n    after = inventory(extraction) if extraction.exists() else None\n    unchanged = before is not None and before == after\n    passed = passed and unchanged\n    save(ROOT / \"mechanical-reception.json\", {\n        \"status\": \"mechanical_reference_passed_pending_independent_reception\" if passed else \"failed_preserved_no_retry\",\n        \"job_id\": os.environ[\"SLURM_JOB_ID\"], \"passed\": passed, \"qualification_returncode\": code,\n        \"failure\": failure, \"payload_sha256\": PAYLOAD_SHA, \"review_sha256\": REVIEW_SHA,\n        \"all67_extracted_files_unchanged\": unchanged, \"inventory_before\": before, \"inventory_after\": after,\n        \"native_model_calls\": 0, \"native_research_admitted\": False, \"performance_claimed\": False})\n    archive = ROOT / (\"results-\" + os.environ[\"SLURM_JOB_ID\"] + \".tar.gz\")\n    paths = sorted(path for path in ROOT.rglob(\"*\") if path.is_file())\n    with tarfile.open(archive, \"x:gz\") as output:\n        for path in paths:\n            output.add(path, arcname=\"qualification-results/\" + path.relative_to(ROOT).as_posix(), recursive=False)\n    archive_sha = sha(archive)\n    save(ROOT / \"archive-sha256.json\", {\"path\": str(archive), \"sha256\": archive_sha,\n                                        \"bytes\": archive.stat().st_size, \"passed\": passed})\n    print(json.dumps({\"archive\": str(archive), \"archive_sha256\": archive_sha, \"passed\": passed,\n                      \"native_model_calls\": 0, \"native_research_admitted\": False}))\n    raise SystemExit(0 if passed else 1)\n\n\nif __name__ == \"__main__\":\n    main()\n\nCERTIFIED_PRIMES_QUALIFICATION\n'",
  "arch": "armgpu",
  "nodes": 1,
  "ntasks_per_node": 1,
  "cpus_per_task": 4,

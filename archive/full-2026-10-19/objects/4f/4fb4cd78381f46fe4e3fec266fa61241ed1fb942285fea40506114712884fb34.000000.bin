        "epoch": 1,
        "hypothesis": "Demand-driven memoization should eliminate repeated work on shared DAG suffixes, while an explicit reverse-path loop preserves the recursive floating-point dependencies.",
        "id": "32cf526d78ff47cf",
        "ordinal": 1,

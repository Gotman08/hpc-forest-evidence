            "src/graph.c"
          ],
          "retained": [
            "Tokenize queries serially and buffer their independent results before printing in original order.",
            "Use OpenMP dynamic scheduling with one query per chunk, capped by available threads and query count.",
            "Keep direct serial execution unless multiple threads are available and the node-count–query-count product reaches 32768."
          ]
        },

          "files": [
            "src/graph.c"
          ],
          "retained": [
            "Build one contiguous open-addressed lookup table per input, with at most 50% occupancy and separate occupancy metadata supporting every integer ID.",
            "Route recursive lookups through the index without changing neighbor parsing, selection, or recursive addition order.",
            "Retain linear lookup for at most 16 records or index allocation failure; release index storage after evaluation."
          ]
        },

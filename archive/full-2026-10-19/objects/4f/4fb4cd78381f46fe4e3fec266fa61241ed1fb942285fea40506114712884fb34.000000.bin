    {
      "id": "de3ce23ea89e4677",
      "role": "A",
      "mission": {
        "base_commit": "6ec587c52284f69e2ea093a09ff8c92af2772527",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "A range-adaptive compact ID index should improve lookup locality: direct slots avoid hashing for clustered IDs, while open addressing supports arbitrary sparse signed IDs.",
        "id": "de3ce23ea89e4677",
        "ordinal": 2,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/graph.c"
          ],
          "retained": [
            "Build one graph-local index, using direct addressing when the ID span is at most four times the record count and an open-addressed table otherwise.",
            "Store compact record indices, retain the first duplicate ID, and keep linear lookup for graphs smaller than 16 records.",
            "Route existing recursive searches through the index without changing neighbor parsing or traversal order.",
            "Allocate the existing Node array for every positive count, including one-node inputs."
          ]
        },
        "tree_id": "e1:A",
        "trial_id": "01M54HHDCK7AMRKVJSB1E81VV0",
        "worktree": "/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-astra-xhigh/results-750205/2020-graph/worktrees/de3ce23ea89e4677"

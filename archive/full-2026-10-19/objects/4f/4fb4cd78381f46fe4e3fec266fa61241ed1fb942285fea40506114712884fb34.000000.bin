        "role": "B",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/graph.c"
          ],
          "retained": [
            "Add a per-graph completed-cost cache shared across queries, evaluating only demanded chains.",
            "Replace recursion on cache misses with an explicit path stack, reusing resolved successor indices.",
            "Unwind with parent-plus-completed-child float additions, preserving first strictly positive maximum selection, missing-ID zero, the -1 successor sentinel, and terminal values without adding zero."
          ]
        },

          "files": [
            "src/graph.c"
          ],
          "retained": [
            "Build one graph-local direct-address or open-addressed ID index, retaining first duplicate records and linear lookup for small graphs or allocation failure.",
            "Share completed costs across serial queries and evaluate uncached chains with an explicit path stack using indexed lookups and resolved successor indices.",
            "Preserve strict positive neighbor selection, the -1 successor sentinel, missing-ID zero, terminal signed zero, and recursive parent-plus-child float grouping.",
            "Retain indexed recursive fallback and graph-local standalone calls; release all auxiliary storage and allocate single-node inputs correctly."
          ]
        },

    "content": "{\n  \"hypothesis\": \"Introduce SIMD/vectorization to the body_force function to improve performance while maintaining correctness.\",\n  \"transformations\": [\"Apply SIMD intrinsics for vectorized computation of gravitational forces\"],\n  \"sources_kept\": [],\n  \"files\": [\n    {\n      \"path\": \"src/nbody.c\",\n      \"content\": \"#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <math.h>\\n#include <immintrin.h>\\n\\n#define N_ITER 10 // number of simulation iterations\\n#define DT 0.01f // time step\\n#define SOFTENING 1e-9f // to avoid zero divisors\\n\\n/*\\n * Each body holds coordinate positions (i.e., x, y, and z) and\\n * velocities (i.e., vx, vy, and vz).\\n */\\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\\n\\n/*\\n * Compute the gravitational impact among all pairs of bodies in \\n * the system using SIMD intrinsics.\\n */\\nvoid body_force(Body *p, float dt, int n) {\\n  __m128 dt_vec = _mm_set1_ps(dt);\\n  __m128 softening_vec = _mm_set1_ps(SOFTENING);\\n\\n  for (int i = 0; i < n; ++i) {\\n    float fx = 0.0f;\\n    float fy = 0.0f;\\n    float fz = 0.0f;\\n\\n    __m128 fx_vec = _mm_setzero_ps();\\n    __m128 fy_vec = _mm_setzero_ps();\\n    __m128 fz_vec = _mm_setzero_ps();\\n\\n    for (int j = 0; j < n; j += 4) {\\n      __m128 dx_vec = _mm_sub_ps(_mm_loadu_ps(&p[j].x), _mm_set1_ps(p[i].x));\\n      __m128 dy_vec = _mm_sub_ps(_mm_loadu_ps(&p[j].y), _mm_set1_ps(p[i].y));\\n      __m128 dz_vec = _mm_sub_ps(_mm_loadu_ps(&p[j].z), _mm_set1_ps(p[i].z));\\n\\n      __m128 sqrd_dist_vec = _mm_add_ps(_mm_add_ps(_mm_mul_ps(dx_vec, dx_vec), _mm_mul_ps(dy_vec, dy_vec)), _mm_add_ps(_mm_mul_ps(dz_vec, dz_vec), softening_vec));\\n      __m128 inv_dist_vec = _mm_rsqrt_ps(sqrd_dist_vec);\\n      __m128 inv_dist3_vec = _mm_mul_ps(inv_dist_vec, _mm_mul_ps(inv_dist_vec, inv_dist_vec));\\n\\n      fx_vec = _mm_add_ps(fx_vec, _mm_mul_ps(dx_vec, inv_dist3_vec));\\n      fy_vec = _mm_add_ps(fy_vec, _mm_mul_ps(dy_vec, inv_dist3_vec));\\n      fz_vec = _mm_add_ps(fz_vec, _mm_mul_ps(dz_vec, inv_dist3_vec));\\n    }\\n\\n    fx += fx_vec[0] + fx_vec[1] + fx_vec[2] + fx_vec[3];\\n    fy += fy_vec[0] + fy_vec[1] + fy_vec[2] + fy_vec[3];\\n    fz += fz_vec[0] + fz_vec[1] + fz_vec[2] + fz_vec[3];\\n\\n    p[i].vx = _mm_cvtss_f32(_mm_add_ss(_mm_set_ss(p[i].vx), _mm_mul_ss(dt_vec, _mm_set_ss(fx))));\\n    p[i].vy = _mm_cvtss_f32(_mm_add_ss(_mm_set_ss(p[i].vy), _mm_mul_ss(dt_vec, _mm_set_ss(fy))));\\n    p[i].vz = _mm_cvtss_f32(_mm_add_ss(_mm_set_ss(p[i].vz), _mm_mul_ss(dt_vec, _mm_set_ss(fz))));\\n  }\\n}\\n\\n/*\\n * Read a binary dataset with initilized bodies.\\n */\\nBody* read_dataset(int *nbodies) {\\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading nbodie value\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading input values\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n\\n  return bodies;\\n}\\n\\n/*\\n * Write simulation results into a binary dataset.\\n */\\nvoid write_dataset(const int nbodies, Body *bodies) {\\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError writing to output\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n}\\n\\nint main(int argc,char **argv) {\\n  int nbodies;\\n\\n  Body *bodies = read_dataset(&nbodies);\\n\\n  /*\\n   * At each simulation iteration, interbody forces are computed,\\n   * and bodies' positions are integrated.\\n   */\\n  for (int iter = 0; iter < N_ITER; iter++) {\\n    body_force(bodies, DT, nbodies);\\n\\n    for (int i = 0; i < nbodies; i++) {\\n      bodies[i].x += bodies[i].vx * DT;\\n      bodies[i].y += bodies[i].vy * DT;\\n      bodies[i].z += bodies[i].vz * DT;\\n    }\\n  }\\n\\n  write_dataset(nbodies, bodies);\\n\\n  free(bodies);\\n  \\n  exit(EXIT_SUCCESS);\\n}\\n\"\n    }\n  ],\n  \"notes\": \"The body_force function has been modified to use SIMD intrinsics for vectorized computation of gravitational forces. This should improve performance by processing multiple pairs of bodies in parallel.\"\n}"

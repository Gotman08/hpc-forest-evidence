set -euo pipefail
[[ ${SLURM_JOB_ID:-} =~ ^[0-9]+$ ]]
test "$(uname -m)" = aarch64
test "${SLURM_CPUS_PER_TASK:-}" = 4
test "${SLURM_NTASKS:-1}" = 1
test "${SLURM_JOB_NUM_NODES:-1}" = 1
test "${SLURM_MEM_PER_NODE:-}" = 16384
test -z "${SLURM_JOB_GPUS:-}${SLURM_STEP_GPUS:-}"
test "${SLURM_GPUS:-0}" = 0
test "${SLURM_GPUS_ON_NODE:-0}" = 0
py=/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python
shared=/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-qualification-20261018-r3-ede293f185e6
stage_archive=/scratch_p/nimarano/hpc-forest-dynamic-r4b-native-interface-stage-r1-ede293f185e6.tar.gz
driver=/scratch_p/nimarano/hpc-forest-dynamic-r4b-stage-pilot-f637472a5cc0441c88c4434c9e2b6acf
native_root=/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-f637472a5cc0441c88c4434c9e2b6acf
admission_root=/scratch_p/nimarano/hpc-forest-dynamic-r4b-admission-f637472a5cc0441c88c4434c9e2b6acf
test -x "$py"
test -d "$shared"
test ! -e "$driver"
test ! -e "$native_root"
test ! -e "$admission_root"
printf '%s  %s\n' 4ac516fa09485937b627e9db6dce567111db0fd2f2cff7c3e23f7cb9a80b3572 "$stage_archive" | sha256sum -c -
printf '%s  %s\n' ede293f185e663241c01c22a5fa9edcd54ad66af6a1e0964755eac306c5de0f3 "$shared/project.zip" | sha256sum -c -
printf '%s  %s\n' 9f04e93c1a28c70f444005b7670ff23731cac838846b99cb1b6742db9e8de33b "$shared/dynamic-plan.json" | sha256sum -c -
test -f "$shared/mechanical-reception-native.json"
export PYTHONDONTWRITEBYTECODE=1 PYTHONUTF8=1
"$py" -I -B - "$stage_archive" "$driver" "$shared" <<'STAGE'
import hashlib,json,sys,tarfile
from pathlib import Path
archive,driver,shared=map(Path,sys.argv[1:])
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
expected=json.loads((shared/'runtime-manifest.json').read_text())
paths=list((shared/'project').rglob('*'));assert not any(p.is_symlink() for p in paths)
actual={p.relative_to(shared/'project').as_posix():sha(p) for p in paths if p.is_file()}
assert actual==expected and len(actual)==103
driver.mkdir(parents=True,exist_ok=False)
with tarfile.open(archive) as t:
 members=t.getmembers();assert len(members)==2 and {m.name for m in members}=={'remote_stage.py','stage-manifest.json'}
 assert all(m.isfile() for m in members)
 for m in members:(driver/m.name).write_bytes(t.extractfile(m).read())
assert json.loads((driver/'stage-manifest.json').read_text())=={'remote_stage.py':sha(driver/'remote_stage.py')}
STAGE
romeo_load_armgpu_env
spack load /zrtbeqke25s2vbqo4yrhsowjz7mg3pjf
export OMP_NUM_THREADS=4 OMP_DYNAMIC=FALSE OMP_PROC_BIND=TRUE OPENBLAS_NUM_THREADS=1 CUDA_VISIBLE_DEVICES=
ulimit -s unlimited
exec srun --ntasks=1 --cpus-per-task=4 --cpu-bind=cores "$py" -I -B -u "$driver/remote_stage.py" --shared "$shared" --qualification-reception "$shared/mechanical-reception-native.json" --phase pilot --root "$native_root" --admission-root "$admission_root"

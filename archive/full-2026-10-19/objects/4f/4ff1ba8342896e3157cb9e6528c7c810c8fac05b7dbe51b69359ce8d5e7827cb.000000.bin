#include <algorithm>
#include <iostream>
#include <vector>

using namespace std;

const int MOD = 1000000007;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) return 0;

    vector<vector<int>> blockedRows(n);
    for (int c = 0; c < m; ++c) {
        int y, x;
        cin >> y >> x;
        blockedRows[y].push_back(x);
    }
    for (vector<int>& row : blockedRows) {
        sort(row.begin(), row.end());
        row.erase(unique(row.begin(), row.end()), row.end());
    }

    vector<int> prev(n, 0), next(n, 0);
    prev[0] = 1;

    if (n < 8192) {
        for (int row = 0; row < n; ++row) {
            const vector<int>& obstacles = blockedRows[row];
            vector<int>::const_iterator it = obstacles.begin();
            int running = 0;
            for (int x = 0; x < n; ++x) {
                while (it != obstacles.end() && *it < x) ++it;
                if (it != obstacles.end() && *it == x) {
                    running = 0;
                } else {
                    running += prev[x];
                    if (running >= MOD) running -= MOD;
                }
                next[x] = running;
            }
            prev.swap(next);
        }
    } else {
        const int chunks = 4;
        vector<int> firstBlocked(chunks), tailSum(chunks), incoming(chunks);

        #pragma omp parallel num_threads(4) shared(prev, next, blockedRows, firstBlocked, tailSum, incoming)
        {
            for (int row = 0; row < n; ++row) {
                const vector<int>& obstacles = blockedRows[row];

                #pragma omp for schedule(static)
                for (int c = 0; c < chunks; ++c) {
                    const int lo = n * c / chunks;
                    const int hi = n * (c + 1) / chunks;
                    vector<int>::const_iterator it = lower_bound(obstacles.begin(), obstacles.end(), lo);
                    int running = 0;
                    firstBlocked[c] = -1;
                    for (int x = lo; x < hi; ++x) {
                        if (it != obstacles.end() && *it == x) {
                            if (firstBlocked[c] == -1) firstBlocked[c] = x;
                            running = 0;
                            ++it;
                        } else {
                            running += prev[x];
                            if (running >= MOD) running -= MOD;
                        }
                        next[x] = running;
                    }
                    tailSum[c] = running;
                }

                #pragma omp single
                {
                    int carry = 0;
                    for (int c = 0; c < chunks; ++c) {
                        incoming[c] = carry;
                        if (firstBlocked[c] == -1) {
                            carry += tailSum[c];
                            if (carry >= MOD) carry -= MOD;
                        } else {
                            carry = tailSum[c];
                        }
                    }
                }

                #pragma omp for schedule(static)
                for (int c = 0; c < chunks; ++c) {
                    const int lo = n * c / chunks;
                    const int hi = n * (c + 1) / chunks;
                    const int end = firstBlocked[c] == -1 ? hi : firstBlocked[c];
                    for (int x = lo; x < end; ++x) {
                        next[x] += incoming[c];
                        if (next[x] >= MOD) next[x] -= MOD;
                    }
                }

                #pragma omp single
                {
                    prev.swap(next);
                }
            }
        }
    }

    cout << prev[n - 1] << '\n';
    return 0;
}

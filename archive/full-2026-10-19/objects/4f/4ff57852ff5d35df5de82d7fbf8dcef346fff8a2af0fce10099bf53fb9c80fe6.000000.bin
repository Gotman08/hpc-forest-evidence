"""Copy only neutral mechanical test definitions; no old test or source is executed."""
from pathlib import Path

OUT = Path(__file__).resolve().parent
BASE = OUT.parents[1]
old = BASE / "outputs/HPC-Forest-Primes-Natif-Qualification-r1/correction-chemins-r2/test_qualification_wrapper_r2.py"
text = old.read_text(encoding="utf8").split("\nclass ArtifactAliasTests", 1)[0]
text = text.replace('HERE / "qualification-wrapper-r2.py"', 'HERE / "qualification-wrapper.py"')
text = text.replace('test_final_r1b_bundle_metadata_without_project_execution', 'test_final_r2b_bundle_metadata_without_project_execution')
text = text.replace('HERE.parents[1] / "HPC-Forest-Primes-Natif-MAX-r1/revision-r1b"',
                    'HERE.parent / "HPC-Forest-Primes-Natif-MAX-r2/revision-r2b"')
text = text.replace('(86, 99)', '(160, 103)')
target = OUT / "test_qualification_wrapper.py"
with target.open("x", encoding="utf8", newline="\n") as stream:
    stream.write(text)
print("Copied neutral definitions only into the new wrapper test file.")

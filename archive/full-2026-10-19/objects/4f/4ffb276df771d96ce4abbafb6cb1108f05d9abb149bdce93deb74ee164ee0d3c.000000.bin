      "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nstatic void compute_tile(const vector<vector<bool> >& blocked,\n                         int* bottom, int* right,\n                         int row_begin, int row_end,\n                         int col_begin, int col_end) {\n    for (int i = row_begin; i < row_end; ++i) {\n        const vector<bool>& obstacles = blocked[i];\n        int left = right[i];\n        for (int j = col_begin; j < col_end; ++j) {\n            int value = bottom[j] + left;\n            if (value >= MOD) value -= MOD;\n            if (obstacles[j]) value = 0;\n            bottom[j] = value;\n            left = value;\n        }\n        right[i] = left;\n    }\n}\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n    vector<vector<bool> > blockedCells(n, vector<bool>(n, false));\n    for (int c = 0; c < m; ++c) {\n        int i, j;\n        cin >> i >> j;\n        blockedCells[i][j] = true;\n    }\n\n    vector<int> bottom_storage(n, 0);\n    vector<int> right_storage(n, 0);\n    int* bottom = bottom_storage.data();\n    int* right = right_storage.data();\n    bottom[0] = 1;\n\n#if defined(_OPENMP) && _OPENMP >= 201307\n    if (n >= 1024 && omp_get_max_threads() > 1) {\n        const int tile_size = 256;\n        const int tile_count = (n + tile_size - 1) / tile_size;\n        vector<unsigned char> column_tokens(tile_count, 0);\n        vector<unsigned char> row_tokens(tile_count, 0);\n        unsigned char* column_token = column_tokens.data();\n        unsigned char* row_token = row_tokens.data();\n\n        #pragma omp parallel\n        {\n            #pragma omp single\n            {\n                for (int br = 0; br < tile_count; ++br) {\n                    const int row_begin = br * tile_size;\n                    const int row_end = min(n, row_begin + tile_size);\n                    for (int bc = 0; bc < tile_count; ++bc) {\n                        const int col_begin = bc * tile_size;\n                        const int col_end = min(n, col_begin + tile_size);\n                        // Reuse a column's bottom boundary and a row's right\n                        // boundary only after their preceding tiles finish.\n                        #pragma omp task firstprivate(row_begin, row_end, col_begin, col_end, bottom, right) shared(blockedCells) depend(inout: column_token[bc], row_token[br])\n                        {\n                            compute_tile(blockedCells, bottom, right,\n                                         row_begin, row_end, col_begin, col_end);\n                        }\n                    }\n                }\n                #pragma omp taskwait\n            }\n        }\n    } else\n#endif\n    {\n        compute_tile(blockedCells, bottom, right, 0, n, 0, n);\n    }\n\n    cout << bottom[n - 1] << endl;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Coarse OpenMP tasks with explicit top/left dependencies can improve four-core utilization by eliminating global anti-diagonal barriers while retaining linear DP boundary storage.",
  "notes": "Uses 256-by-256 tiles and a sequential path for small grids or unavailable OpenMP task dependencies. Preserves obstacle storage and output format. Task bookkeeping is additional to the O(n) DP buffers. Not executed or measured.",

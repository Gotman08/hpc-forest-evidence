"""Revise the argument, tables and evidence narrative for the two admitted cohorts."""
from pathlib import Path

HERE = Path(__file__).resolve().parent
STUDY = HERE.parents[1]
EDITORIAL = STUDY / "edition-professionnelle"


def once(text, old, new):
    assert text.count(old) == 1, (old, text.count(old))
    return text.replace(old, new, 1)


def main():
    changes = {}
    path = EDITORIAL / "assembler.py"
    text = path.read_text(encoding="utf8")
    text = once(text, '["count", "luna", "astra", "terra", "sol", "source_only", "luna_xhigh", "comparison", "gpt96", "deepseek"]', '["count", "luna", "astra", "terra", "sol", "source_only", "luna_xhigh", "source_only_astra", "astra_xhigh", "comparison", "gpt96", "deepseek"]')
    text = once(text, '        ("luna_xhigh", "R1 Luna xhigh : quatorze sujets"),', '        ("luna_xhigh", "R1 Luna xhigh : quatorze sujets"),\n        ("source_only_astra", "Source-only Astra MAX : quinze sujets"),\n        ("astra_xhigh", "R1 Astra xhigh : quatorze sujets"),')
    text = once(text, '                    "90/300 cellules R1 reçues au total",', '                    "Contrats finis ; références propres",')
    text = once(text, '                    "Véritable Codex / R4 / R5",', '''                    "R1 · couverture Astra xhigh",
                    "14 cellules supplémentaires",
                    "104/300 cellules R1 reçues au total",
                ],
                [
                    "Source-only Astra MAX",
                    "15 recherches fraîches supplémentaires",
                    "30/300 issues source-only reçues au total",
                ],
                [
                    "Véritable Codex / R4 / R5",''')
    # This protocol applies to both source-only models; the separate result rows retain identities.
    text = once(text, '                    "Source-only Luna MAX",\n                    "8 programmes + 2 épisodes de mère",', '                    "Source-only Luna/Astra MAX",\n                    "8 programmes + 2 épisodes de mère",')
    text = once(text, '## C. Couvertures R1 et première cohorte source-only', '## C. Couvertures R1 et cohortes source-only')
    anchor = '    add(\n        "## D. Six bras GPT'
    extra = '''    add("### C.7. Source-only Astra MAX : quinze recherches fraîches\\n\\n750122 est clos, reçu et audité. "
        "Quatorze programmes modifiés confirmés, tropical conservé ; 30/300 issues source-only sont reçues au cumul. "
        "Les 85 missions comprennent 66 valides, seize infrastructure_error, une generation_failed, une build_failed et une runtime_failed. "
        "Les 68 sommets notés ne sont pas 68 programmes valides chronométrés. Les quinze contrats correspondent à R1 après exclusion du seul "
        "benchmark.reference_seconds ; temps non fusionnés. Une graine, ordre temporel et R1 historique empêchent un avantage causal général. "
        "Le harnais interne est désactivé, mère/TreeQuest/A-B-C/G et évaluation externe conservés ; ce bras n’est pas l’agent Codex à outils.")
    add(table(["Sujet", "T₀ ± s₀ (s)", "T ± s (s)", "g (%)", "Appels / inconnus", "Jetons connus"],
              [[r["subject"], f"{n(r['reference_seconds'], 6)} ± {n(r['reference_sd'], 6)}",
                f"{n(r['chosen_seconds'], 6)} ± {n(r['chosen_sd'], 6)}", n(r["gain_percent"], 4),
                f"{r['native_calls']} / {r['unmetered_calls']}", integer(r["known_exact_tokens"])] for r in groups["source_only_astra"]],
              "Tableau C.7 — Source-only Astra MAX : cinq confirmations par référence et programme retenu, compteurs incomplets explicites."))
    add("Archive bbae4d61c374a740ceadceb27aca4ec1354cc8c2bf6fea86ad3d1619cc449be2, SHA annoncé/distants/local identiques ; "
        "deux restaurations de 5 633 fichiers inchangés. Identité gpt-6-astra/MAX, session aa970cf8bf5d4c1aaa0fdabb21d73a72, "
        "sources 9a68a83fde4acb6bd247d79e00490e7d36f0c4c59c6c881152101e4c499387eb, 94 fichiers figés et 609 fichiers officiels reçus avant relais. "
        "Les 101 requêtes sont livrées/réconciliées : 98 invocations, 1 856 292 jetons exacts connus, treize invocations non mesurées et trois expirations "
        "établies avant invocation. Cache et raisonnement déjà inclus ; aucun total exact de consommation. Allocation COMPLETED 0:0 de 7 h 1 min 47 s, "
        "quatre CPU ARM64 / 16 Gio / zéro GPU ; 185 secondes CPU et 186,4 Mio RSS du job, sans mesure du CPU d’inférence ou preuve de threads. "
        "Budgets par cellule : 1800 secondes, 1,5 million de jetons, huit programmes et deux épisodes de mère au plus ; trois mesures et cinq confirmations, "
        "seuil 3 %. Tous les négatifs restent conservés. Le reçu indépendant signale l’ancien arrêt récursif après audit/réconciliation : violation de la consigne, "
        "aucune terminaison étrangère établie. Le coordinateur historique est conservé et interdit de redémarrage ; la réception suivante exige un arrêt individuel identifié.")
    add("### C.8. R1 Astra xhigh : quatorze autres sujets\\n\\n750205 est clos, reçu, audité et réconcilié. "
        "Douze programmes modifiés confirmés ; tropical et Sokoban conservent leur référence. Les 95 missions comprennent 80 valides, quatorze "
        "infrastructure_error et une generation_failed, pour 80 sommets notés. Le harnais R1 est activé. Les quatorze contrats correspondent aux couvertures "
        "MAX Luna/Astra/Terra/Sol après exclusion du seul benchmark.reference_seconds ; les temps restent propres aux allocations.")
    add(table(["Sujet", "T₀ ± s₀ (s)", "T ± s (s)", "g (%)", "Appels / inconnus", "Jetons connus"],
              [[r["subject"], f"{n(r['reference_seconds'], 6)} ± {n(r['reference_sd'], 6)}",
                f"{n(r['chosen_seconds'], 6)} ± {n(r['chosen_sd'], 6)}", n(r["gain_percent"], 4),
                f"{r['native_calls']} / {r['unmetered_calls']}", integer(r["known_exact_tokens"])] for r in groups["astra_xhigh"]],
              "Tableau C.8 — R1 Astra xhigh : cinq confirmations, références propres et invocations non mesurées séparées."))
    add("Archive ba96c38473243aeaf6a08da1255bb5af59605f3f21401db371970c6fc7d8d097, trois SHA concordants ; "
        "9 281 fichiers restaurés inchangés, 90 sources R1 identiques. Identité gpt-6-astra/xhigh, session 2bd8b683b45b41c8b48ec38708f46bab. "
        "Les 118 requêtes sont livrées/réconciliées : 115 invocations, 2 091 845 jetons exacts connus, douze invocations non mesurées et trois expirations "
        "avant invocation. Aucun total exact de consommation ; cache et raisonnement déjà inclus. Allocation COMPLETED 0:0 de 6 h 23 min 22 s, "
        "quatre CPU ARM64 / 16 Gio / zéro GPU ; 233,4 secondes CPU et 153,2 Mio RSS concernent le job. Mêmes plafonds R1 de 1800 secondes / "
        "1,5 million de jetons par cellule, huit programmes et deux épisodes de mère, trois mesures et cinq confirmations, seuil 3 %. "
        "La coupure initiale de livraison et la disparition ultérieure des interfaces restent des facteurs de confusion, sans causalité bas niveau établie. "
        "Le claim 5580db355fa248d2852a5635835e3c7c interrompu sans réponse est réconcilié par l’erreur d’interface prévue, sans nouvelle génération ; "
        "le lecteur isolé lie cette seule interruption aux octets de journal et claim préservés. Sept tests neutres et premiers refus conservés. "
        "Sept identités du relais sont arrêtées individuellement après audit et réconciliation, sans récursion. Aucun nouveau diagnostic CPU ni qualification "
        "algorithmique stricte de quicksort ; une seule graine et l’ordre temporel n’autorisent pas de classement causal d’efforts ou de modèles.")
'''
    text = once(text, anchor, extra + anchor)
    anchor = '    add(\n        table(\n            [\n                "Campagne / effort",'
    extra = '''    for filename, label, caption in [
        ("couts-source-only-astra.json", "Source-only Astra MAX", "Tableau F.7 — 98 invocations, treize sans compteur ; trois expirations avant invocation exclues des appels."),
        ("couts-astra-xhigh.json", "R1 Astra xhigh", "Tableau F.8 — 115 invocations, douze sans compteur ; trois expirations avant invocation exclues des appels."),
    ]:
        closed_calls = load(DATA / filename)["native_calls"]
        add(table(["Rôle " + label, "Invocations", "Sans compteur", "Jetons exacts connus"],
                  [[role, sum(c["native_invocation_observed"] for c in closed_calls if c["kind"] == role),
                    sum(c["native_invocation_observed"] and not c["usage_measured"] for c in closed_calls if c["kind"] == role),
                    integer(sum(c["exact_total"] or 0 for c in closed_calls if c["kind"] == role))]
                   for role in ("mère", "enfant", "intégration")], caption))
'''
    text = once(text, anchor, extra + anchor)
    text = once(text, 'R1 et source-only Astra MAX occupent les deux voies natives après réception du premier groupe direct', 'R1 Terra xhigh et source-only Terra MAX occupent les deux voies natives après réception des deux groupes directs')
    text = once(text, '25 groupes et 90 cellules reçus dans cet instantané', '26 groupes et 104 cellules reçus dans cet instantané')
    text = once(text, 'Astra xhigh en cours sous 750205.', 'Astra xhigh / 750205 clos et audité, douze programmes modifiés et deux références ; Terra xhigh en cours sous 750909.')
    text = once(text, 'le nouveau groupe Astra xhigh utilise sa session déjà planifiée', 'le nouveau groupe Terra xhigh utilise sa session déjà planifiée')
    text = once(text, '### J.1. Comparaison étendue des harnais — quinze issues directes reçues', '### J.1. Comparaison étendue des harnais — trente issues directes reçues')
    text = once(text, 'La même file poursuit Astra MAX sous 750122 ; 285 issues directes restent non reçues.', 'Le second groupe direct Astra MAX 750122 reçoit quinze sujets, quatorze programmes modifiés et tropical référence ; 98 invocations, 1 856 292 jetons exacts connus et treize invocations non mesurées. La même file poursuit Terra MAX sous 750831 ; 270 issues directes restent non reçues.')
    text = once(text, 'Les seuls résultats reçus sont ceux du premier groupe direct ; aucun classement causal ni résultat Codex natif', 'Les résultats reçus de ce bras sont les deux groupes directs Luna et Astra ; aucun classement causal ni résultat Codex natif')
    anchor = '    add(\n        "R4 : source '
    text = once(text, anchor, '''    add("Reprise d’interface du 17 octobre : les deux anciens relais et contrôleurs ne sont plus observés après l’apparition d’une nouvelle identité complète "
        "d’application. La causalité de bas niveau reste inconnue. Sessions, caches, registres et claims sont préservés ; un appel commencé sans réponse "
        "dans chaque relais est réconcilié sans régénération. Source-only utilise désormais un observateur ne permettant que les lectures Slurm, avec "
        "réception manuelle stricte. L’ancien coordinateur à arrêt récursif est interdit de redémarrage. Aucun processus vivant ou source scellée n’est modifié. "
        "Le préalable humain R5 reste incomplet : 111 outils du profil stdio dont quatorze RomeoLLM sont observés après redémarrage, mais la mise à jour "
        "contrôlée, l’égalité de révision installée/chargée et le reçu tools/list du client effectif ne sont pas prouvés. La présence de service/inférence "
        "ne qualifie ni gradients, conversion/export, ni identité Flash 0731. Aucun pilote R5 ou apprentissage n’est admis.")
''' + anchor)
    changes[path] = text
    path = EDITORIAL / "manuscrit.md"
    text = path.read_text(encoding="utf8")
    text = once(text, 'une couverture Luna xhigh des mêmes quatorze sujets,', 'deux couvertures Luna et Astra xhigh des mêmes quatorze sujets,')
    text = once(text, 'une première cohorte source-only de quinze recherches Luna MAX.', 'deux cohortes source-only de quinze recherches chacune, Luna et Astra MAX.')
    text = once(text, 'La première cohorte source-only confirme quatorze programmes modifiés sur quinze recherches, sans établir un avantage causal du harnais.', 'Les deux cohortes source-only confirment vingt-huit programmes modifiés sur trente recherches, sans établir un avantage causal du harnais.')
    text = once(text, '90 cellules ont été reçues et auditées : les vingt cellules count, quatorze autres sujets pour chacun de Luna, Astra, Terra et Sol MAX, puis quatorze recherches Luna xhigh.', '104 cellules ont été reçues et auditées : les vingt cellules count, quatorze autres sujets pour chacun de Luna, Astra, Terra et Sol MAX, puis les couvertures de quatorze recherches chacune avec Luna et Astra xhigh.')
    text = once(text, 'la même file R1 poursuit Astra xhigh sous allocation 750205 après réception de Luna xhigh.', 'la même file R1 poursuit Terra xhigh sous allocation 750909 après réception de Luna et Astra xhigh.')
    anchor = '### 3.3. Première cohorte source-only sur les quinze sujets'
    extra = 'La couverture Astra xhigh reçoit également quatorze sujets : douze programmes modifiés confirmés, tropical et Sokoban conservant leur référence. Ses 95 missions comprennent 80 valides, quatorze erreurs d’infrastructure et une génération échouée, pour 80 sommets notés. Les 118 requêtes sont livrées et réconciliées : 115 invocations, 2 091 845 jetons exacts connus, douze invocations non mesurées et trois expirations avant invocation. Les coupures de livraison sont conservées sans rejeu ; elles limitent encore la comparaison. L’annexe C.8 donne les cinq confirmations de chaque référence et programme retenu. Les contrats correspondent aux couvertures MAX après la seule exclusion du temps de calibration ; les chronométrages ne sont pas fusionnés.\n\n'
    text = once(text, anchor, extra + '### 3.3. Deux cohortes source-only sur les quinze sujets')
    text = once(text, 'soit 15 des 300 issues prévues pour ce bras.', 'soit les quinze premières issues de ce bras.')
    anchor = '### 3.4. DeepSeek : gains confirmés et rejets décisifs'
    extra = 'Le second groupe source-only, Astra MAX, reçoit quinze recherches fraîches et confirme quatorze programmes modifiés ; tropical conserve la référence. Le bras atteint donc 30/300 issues reçues. Ses 85 missions comprennent 66 valides, seize erreurs d’infrastructure, une génération échouée, une compilation échouée et une exécution échouée ; 68 sommets sont notés. Les 101 requêtes sont livrées et réconciliées : 98 invocations, 1 856 292 jetons exacts connus, treize invocations non mesurées et trois expirations avant invocation. La consommation totale exacte demeure inconnue. Les cinq confirmations et leurs dispersions figurent dans l’annexe C.7 ; ses temps restent propres à cette allocation. L’ancien chemin d’arrêt récursif après audit est documenté comme violation de procédure et retiré de l’usage. Aucune terminaison étrangère n’est établie.\n\n'
    text = once(text, anchor, extra + anchor)
    text = text.replace('les neuf ensembles natifs clos', 'les onze ensembles natifs clos').replace('les neuf ensembles clos', 'les onze ensembles clos')
    text = once(text, 'le groupe source-only Luna MAX 749843 est reçu et audité sur les quinze sujets ; la même file poursuit Astra MAX sous allocation 750122. Le bras source-only compte donc 15/300 issues reçues, séparées des 90 cellules R1.', 'les groupes source-only Luna et Astra MAX sont reçus et audités sur les quinze sujets chacun ; la même file poursuit Terra MAX. Le bras source-only compte donc 30/300 issues reçues, séparées des 104 cellules R1.')
    changes[path] = text
    for path, content in changes.items():
        assert "\ufffd" not in content and "mÃ¨re" not in content
        path.write_text(content, encoding="utf8")
    id_path = STUDY.parents[1] / "ID.md"
    lines = id_path.read_text(encoding="utf8").splitlines()
    updates = {
        "ID-015": " Source-only Luna/Astra MAX reçus : 30/300 issues ; Terra MAX 750831 en cours. R1 104/300 cellules, Terra xhigh 750909 en cours. Véritable Codex non admis, 239 tests r7 sur pairs neutres distincts. ",
        "ID-017": " Deux cohortes Astra admises après préservation de 3 992 fichiers ; 165 registres et 149 résultats recalculés, nouvelle édition en construction et revue visuelle attendue. ",
        "ID-021": " Vingt couples count, quatre couvertures MAX et deux xhigh reçus : 104 cellules R1 auditées ; Terra xhigh 750909 en cours. ",
        "ID-040": " 165 registres, 149 résultats et 11 575 temps CPU inchangés ; deux cohortes Astra admises, précédente édition préservée, douze rubriques en reconstruction avec revue visuelle attendue. ",
    }
    for i, line in enumerate(lines):
        for key, status in updates.items():
            if line.startswith("| " + key + " |"):
                cells = line.split("|")
                cells[3] = status
                lines[i] = "|".join(cells)
    id_path.write_text("\n".join(lines) + "\n", encoding="utf8")
    print("Canonical manuscript and supplement updated; live experiments unchanged")


if __name__ == "__main__":
    main()

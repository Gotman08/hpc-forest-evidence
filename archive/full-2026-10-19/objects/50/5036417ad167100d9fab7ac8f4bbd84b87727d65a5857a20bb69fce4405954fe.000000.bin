        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nstatic void simulate(float *x, float *y, float *z,\n                     float *vx, float *vy, float *vz,\n                     float dt, int n) {\n#ifdef _OPENMP\n#pragma omp parallel\n#endif\n  {\n    for (int iter = 0; iter < N_ITER; iter++) {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n      for (int i = 0; i < n; ++i) {\n        const float xi = x[i];\n        const float yi = y[i];\n        const float zi = z[i];\n        float fx = 0.0f;\n        float fy = 0.0f;\n        float fz = 0.0f;\n\n        for (int j = 0; j < n; j++) {\n          float dx = x[j] - xi;\n          float dy = y[j] - yi;\n          float dz = z[j] - zi;\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          float inv_dist = 1 / sqrt(sqrd_dist);\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n        }\n\n        vx[i] += dt*fx;\n        vy[i] += dt*fy;\n        vz[i] += dt*fz;\n      }\n\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n      for (int i = 0; i < n; i++) {\n        x[i] += vx[i] * dt;\n        y[i] += vy[i] * dt;\n        z[i] += vz[i] * dt;\n      }\n    }\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n  Body *bodies = read_dataset(&nbodies);\n  const size_t count = (size_t)nbodies;\n  const size_t allocation_count = count == 0 ? 1 : count;\n  float *storage = (float *)malloc(6 * allocation_count * sizeof(*storage));\n\n  if (storage == NULL) {\n    fprintf(stderr,\"\\nError allocating particle arrays\\n\");\n    free(bodies);\n    exit(EXIT_FAILURE);\n  }\n\n  float *x = storage;\n  float *y = x + count;\n  float *z = y + count;\n  float *vx = z + count;\n  float *vy = vx + count;\n  float *vz = vy + count;\n\n  for (int i = 0; i < nbodies; i++) {\n    x[i] = bodies[i].x;\n    y[i] = bodies[i].y;\n    z[i] = bodies[i].z;\n    vx[i] = bodies[i].vx;\n    vy[i] = bodies[i].vy;\n    vz[i] = bodies[i].vz;\n  }\n\n  simulate(x, y, z, vx, vy, vz, DT, nbodies);\n\n  for (int i = 0; i < nbodies; i++) {\n    bodies[i].x = x[i];\n    bodies[i].y = y[i];\n    bodies[i].z = z[i];\n    bodies[i].vx = vx[i];\n    bodies[i].vy = vy[i];\n    bodies[i].vz = vz[i];\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(storage);\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
        "path": "src/nbody.c"
      }

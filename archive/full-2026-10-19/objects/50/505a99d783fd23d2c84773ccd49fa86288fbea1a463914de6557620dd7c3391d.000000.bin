{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <iostream>\\n#include <vector>\\n#include <utility>\\n\\nusing namespace std;\\n\\nclass adjacency_matrix {\\npublic:\\n    explicit adjacency_matrix(size_t vertices = 0)\\n        : vertices_(vertices), values_(vertices * vertices, 0) {}\\n\\n    size_t size() const { return vertices_; }\\n\\n    unsigned char *operator[](size_t row) {\\n        return values_.data() + row * vertices_;\\n    }\\n\\n    const unsigned char *operator[](size_t row) const {\\n        return values_.data() + row * vertices_;\\n    }\\n\\nprivate:\\n    size_t vertices_;\\n    vector<unsigned char> values_;\\n};\\n\\nadjacency_matrix readGraph();\\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2);\\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\\n                       const int *equivalence, int n);\\ninline void printPermutation(const int *equivalence, int n);\\n\\nint main() {\\n    adjacency_matrix g1 = readGraph();\\n    adjacency_matrix g2 = readGraph();\\n\\n    if (!testIsomorphism(g1, g2))\\n        cout << \\\"The graphs are not isomorphic\\\" << endl;\\n\\n    return 0;\\n}\\n\\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2) {\\n    if (g1.size() != g2.size()) return false;\\n\\n    const int n = static_cast<int>(g1.size());\\n    vector<int> equivalence(n, 0);\\n    vector<int> exchange_counter(n, 0);\\n    int exchange_index = 1;\\n    bool isomorphism_found = false;\\n\\n    for (int i = 0; i < n; ++i)\\n        equivalence[i] = i;\\n\\n    if (verifyPermutation(g1, g2, equivalence.data(), n)) {\\n        printPermutation(equivalence.data(), n);\\n        return true;\\n    }\\n\\n    // Keep a single team alive while Heap's algorithm produces bounded batches.\\n    // Dynamic chunks balance candidates whose early-exit verification costs vary.\\n    const int batch_capacity = 64;\\n    vector<int> batch(static_cast<size_t>(batch_capacity) * n);\\n    vector<unsigned char> matches;\\n    int batch_count = 0;\\n    bool done = false;\\n\\n    #pragma omp parallel if(n >= 24)\\n    {\\n        while (true) {\\n            #pragma omp single\\n            {\\n                batch_count = 0;\\n                while (batch_count < batch_capacity && exchange_index < n) {\\n                    if (exchange_counter[exchange_index] < exchange_index) {\\n                        if (exchange_index % 2 == 0)\\n                            swap(equivalence[0], equivalence[exchange_index]);\\n                        else\\n                            swap(equivalence[exchange_counter[exchange_index]],\\n                                 equivalence[exchange_index]);\\n\\n                        int *candidate = batch.data() +\\n                                         static_cast<size_t>(batch_count) * n;\\n                        for (int i = 0; i < n; ++i)\\n                            candidate[i] = equivalence[i];\\n\\n                        ++batch_count;\\n                        ++exchange_counter[exchange_index];\\n                        exchange_index = 1;\\n                    } else {\\n                        exchange_counter[exchange_index] = 0;\\n                        ++exchange_index;\\n                    }\\n                }\\n                done = (batch_count == 0);\\n                matches.resize(batch_count);\\n            }\\n\\n            if (done) break;\\n\\n            #pragma omp for schedule(dynamic, 4)\\n            for (int k = 0; k < batch_count; ++k) {\\n                const int *candidate = batch.data() +\\n                                       static_cast<size_t>(k) * n;\\n                matches[k] = static_cast<unsigned char>(\\n                    verifyPermutation(g1, g2, candidate, n));\\n            }\\n\\n            #pragma omp single\\n            {\\n                for (int k = 0; k < batch_count; ++k) {\\n                    if (matches[k]) {\\n                        const int *candidate = batch.data() +\\n                                               static_cast<size_t>(k) * n;\\n                        printPermutation(candidate, n);\\n                        isomorphism_found = true;\\n                    }\\n                }\\n            }\\n        }\\n    }\\n\\n    return isomorphism_found;\\n}\\n\\nadjacency_matrix readGraph() {\\n    int vertices, edges, source, destination;\\n\\n    cin >> vertices;\\n    adjacency_matrix read(static_cast<size_t>(vertices));\\n\\n    cin >> edges;\\n    for (int i = 0; i < edges; i++) {\\n        cin >> source >> destination;\\n        read[destination][source] = read[source][destination] = 1;\\n    }\\n\\n    return read;\\n}\\n\\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\\n                       const int *equivalence, int n) {\\n    for (int i = 0; i < n; ++i) {\\n        for (int j = 0; j <= i; ++j) {\\n            if (g1[i][j] != g2[equivalence[i]][equivalence[j]]) return false;\\n        }\\n    }\\n    return true;\\n}\\n\\ninline void printPermutation(const int *equivalence, int n) {\\n    for (int i = 0; i < n; ++i)\\n        cout << equivalence[i] << \\\" \\\";\\n    cout << endl;\\n}\\n\",\"path\":\"src/brute_isomorphism.cpp\"}],\"hypothesis\":\"For larger graphs, one persistent OpenMP team with dynamic chunks can reduce repeated team-startup overhead and balance permutation verifications whose early exits vary. A bounded candidate batch preserves exact Heap permutation order for output; byte-packed contiguous adjacency storage avoids vector<bool> proxy accesses. Small graphs remain serial via the OpenMP threshold.\",\"notes\":\"Identity verification, Heap candidate sequence, exact checks, and ordered output are retained. No commands or tests were run.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Replace vector<bool> rows with a contiguous byte adjacency matrix.\",\"Generate Heap permutations in bounded batches and verify candidates using one persistent OpenMP team with schedule(dynamic, 4), enabled only for n >= 24.\",\"Emit successful permutations serially in original candidate order.\"]}"}}

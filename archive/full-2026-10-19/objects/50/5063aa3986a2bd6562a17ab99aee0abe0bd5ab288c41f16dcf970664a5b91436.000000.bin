      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/* Allocation-failure fallback using the original traversal. */\nstatic void body_force_aos(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Pack positions separately from velocities, then cache-tile the\n * interactions. Each target still accumulates sources in ascending order.\n */\nvoid body_force(Body *p, float dt, int n) {\n  enum { TARGET_BLOCK = 64, SOURCE_BLOCK = 256 };\n\n  if (n <= 0) {\n    return;\n  }\n\n  float *positions = (float *)malloc((size_t)n * 3u * sizeof(float));\n  if (positions == NULL) {\n    body_force_aos(p, dt, n);\n    return;\n  }\n\n  float *const x = positions;\n  float *const y = x + n;\n  float *const z = y + n;\n  for (int i = 0; i < n; ++i) {\n    x[i] = p[i].x;\n    y[i] = p[i].y;\n    z[i] = p[i].z;\n  }\n\n  for (int base = 0; base < n; ) {\n    int count = n - base;\n    if (count > TARGET_BLOCK) {\n      count = TARGET_BLOCK;\n    }\n\n    float fx_tile[TARGET_BLOCK] = {0.0f};\n    float fy_tile[TARGET_BLOCK] = {0.0f};\n    float fz_tile[TARGET_BLOCK] = {0.0f};\n\n    for (int source = 0; source < n; ) {\n      int source_count = n - source;\n      if (source_count > SOURCE_BLOCK) {\n        source_count = SOURCE_BLOCK;\n      }\n      const int source_end = source + source_count;\n      int t = 0;\n\n      for (; t + 3 < count; t += 4) {\n        const int i = base + t;\n        const float x0 = x[i],     y0 = y[i],     z0 = z[i];\n        const float x1 = x[i + 1], y1 = y[i + 1], z1 = z[i + 1];\n        const float x2 = x[i + 2], y2 = y[i + 2], z2 = z[i + 2];\n        const float x3 = x[i + 3], y3 = y[i + 3], z3 = z[i + 3];\n        float fx0 = fx_tile[t],     fy0 = fy_tile[t],     fz0 = fz_tile[t];\n        float fx1 = fx_tile[t + 1], fy1 = fy_tile[t + 1], fz1 = fz_tile[t + 1];\n        float fx2 = fx_tile[t + 2], fy2 = fy_tile[t + 2], fz2 = fz_tile[t + 2];\n        float fx3 = fx_tile[t + 3], fy3 = fy_tile[t + 3], fz3 = fz_tile[t + 3];\n\n        for (int j = source; j < source_end; ++j) {\n          const float xj = x[j];\n          const float yj = y[j];\n          const float zj = z[j];\n\n          float dx = xj - x0;\n          float dy = yj - y0;\n          float dz = zj - z0;\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          float inv_dist = 1 / sqrt(sqrd_dist);\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\n          fx0 += dx * inv_dist3;\n          fy0 += dy * inv_dist3;\n          fz0 += dz * inv_dist3;\n\n          dx = xj - x1;\n          dy = yj - y1;\n          dz = zj - z1;\n          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          inv_dist = 1 / sqrt(sqrd_dist);\n          inv_dist3 = inv_dist * inv_dist * inv_dist;\n          fx1 += dx * inv_dist3;\n          fy1 += dy * inv_dist3;\n          fz1 += dz * inv_dist3;\n\n          dx = xj - x2;\n          dy = yj - y2;\n          dz = zj - z2;\n          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          inv_dist = 1 / sqrt(sqrd_dist);\n          inv_dist3 = inv_dist * inv_dist * inv_dist;\n          fx2 += dx * inv_dist3;\n          fy2 += dy * inv_dist3;\n          fz2 += dz * inv_dist3;\n\n          dx = xj - x3;\n          dy = yj - y3;\n          dz = zj - z3;\n          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          inv_dist = 1 / sqrt(sqrd_dist);\n          inv_dist3 = inv_dist * inv_dist * inv_dist;\n          fx3 += dx * inv_dist3;\n          fy3 += dy * inv_dist3;\n          fz3 += dz * inv_dist3;\n        }\n\n        fx_tile[t] = fx0;\n        fy_tile[t] = fy0;\n        fz_tile[t] = fz0;\n        fx_tile[t + 1] = fx1;\n        fy_tile[t + 1] = fy1;\n        fz_tile[t + 1] = fz1;\n        fx_tile[t + 2] = fx2;\n        fy_tile[t + 2] = fy2;\n        fz_tile[t + 2] = fz2;\n        fx_tile[t + 3] = fx3;\n        fy_tile[t + 3] = fy3;\n        fz_tile[t + 3] = fz3;\n      }\n\n      for (; t < count; ++t) {\n        const int i = base + t;\n        const float xi = x[i];\n        const float yi = y[i];\n        const float zi = z[i];\n        float fx = fx_tile[t];\n        float fy = fy_tile[t];\n        float fz = fz_tile[t];\n\n        for (int j = source; j < source_end; ++j) {\n          float dx = x[j] - xi;\n          float dy = y[j] - yi;\n          float dz = z[j] - zi;\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          float inv_dist = 1 / sqrt(sqrd_dist);\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n        }\n\n        fx_tile[t] = fx;\n        fy_tile[t] = fy;\n        fz_tile[t] = fz;\n      }\n\n      source = source_end;\n    }\n\n    for (int t = 0; t < count; ++t) {\n      p[base + t].vx += dt*fx_tile[t];\n      p[base + t].vy += dt*fy_tile[t];\n      p[base + t].vz += dt*fz_tile[t];\n    }\n    base += count;\n  }\n\n  free(positions);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Position-only SoA packing and 64-target by 256-source cache tiles should reduce cache traffic, while four-target microtiles reuse source loads without changing per-body accumulation order.",

"""ROOT-only cold archive inspector. No extraction, received code import or final receipt.

The inspector proves only the closed five-file authorization-timeout archive shape.
Actual transfer/announcement/efficiency/terminal/current-worker evidence remains separate.
"""
from __future__ import annotations
import argparse
import ast
import hashlib
import io
import json
import math
import os
import re
import stat
import tarfile
from datetime import UTC, datetime
from pathlib import Path, PurePosixPath

HERE = Path(__file__).resolve().parent
OP = HERE.parent
PREP = OP.parent
BASE = PREP.parents[1]
RAW_SOURCE = PREP / "qualification-allouee-source110-G-recu-r1/revue-resultats-Q753709-r1/lecteur-r4b/auditer-restauration-existante-r4b.py"
RAW_SHA = "5c1e1784574566a585e2d9cc50f85b52337d10d3109e449a4112581eae68f8d5"
RAW_NAMES = {"need", "ordinary", "metadata", "open_nofollow_read", "cross_identity", "validate_windows_mode_views", "native_basic_info", "raw", "decode"}
STAGE = PREP / "adaptateurs-source110-r1/revision-r7-racines-techniques-neuves/launcher/remote_stage.py"
STAGE_SHA = "08a5353948f9da44e86952137127bbe4f2222c5307b49dde8c1de92cda27f68c"
SOURCE = "eaff9217499fe268e4d151165a368a83bad1550d921955a9f9256026cfac2d48"
PLAN = "5c3cc0082589257897caf79caf90c678f931eefcecb823f315ef614f72b9de70"
CELL_BASE = OP / "preparation-parents-R7-bout-en-bout-r1"
CELLS = {'754549': ('sol-max', 'gpt-6.1-sol', '80d47d8d3f8f4e35bc26ceb54d06e870', '0c83fb79b4b3c58746625d71a014d46f75abcbfbac408be876bc8e69861c0661'), '754550': ('astra-max', 'gpt-6-astra', '29583a77237e4777aa09209331ec7ecd', '3a7230c598803f98902ed2b77b0d92d8269a5a014df98e4b7fca304c209c83e0'), '754552': ('terra-max', 'gpt-5.6-terra', '3ae8341d27784c1bbd830ac19e4b77bc', '44506eb366eda82f3109a7335879c69858bcde071048dd9079ba750edac79c56')}


def need(condition, message):
    if not condition:
        raise ValueError(message)


def sha(value):
    return hashlib.sha256(value).hexdigest()


def canonical_digest(value):
    return sha(json.dumps(value, sort_keys=True, ensure_ascii=False, separators=(",", ":")).encode())


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--job-id", choices=tuple(CELLS), required=True)
    p.add_argument("--archive", type=Path, required=True)
    p.add_argument("--archive-sha256", required=True)
    args = p.parse_args()
    slug = CELLS[args.job_id][0]
    expected_archive_root = CELL_BASE / slug
    need(args.archive.is_absolute() and args.archive.is_relative_to(expected_archive_root)
         and args.archive.name == "contract-results-" + args.job_id + ".tar.gz" and ".." not in args.archive.parts,
         "Only the exact actual original archive received below its stage directory")
    need(re.fullmatch(r"[0-9a-f]{64}", args.archive_sha256), "Actual received archive SHA required")
    primitive_bytes = RAW_SOURCE.read_bytes()
    need(sha(primitive_bytes) == RAW_SHA, "Exact held no-follow reader primitives required")
    functions = [n for n in ast.parse(primitive_bytes).body if isinstance(n, ast.FunctionDef) and n.name in RAW_NAMES]
    need({n.name for n in functions} == RAW_NAMES, "Closed held-read definition set required")
    held = {"Path": Path, "os": os, "stat": stat, "Q": BASE, "json": json}
    exec(compile(ast.Module(body=functions, type_ignores=[]), str(RAW_SOURCE), "exec"), held)
    raw, decode = held["raw"], held["decode"]
    archive_raw = raw(args.archive)
    need(len(archive_raw) <= 32 * 1024 * 1024 and sha(archive_raw) == args.archive_sha256, "Bounded pinned archive bytes required")
    stage_bytes = raw(STAGE)
    need(sha(stage_bytes) == STAGE_SHA, "Actual unchanged R7 staging control-flow source required")
    waits = [node.value.value for node in ast.parse(stage_bytes).body if isinstance(node, ast.Assign)
             and any(isinstance(target, ast.Name) and target.id == "WAIT_SECONDS" for target in node.targets)
             and isinstance(node.value, ast.Constant)]
    need(waits == [600], "The original600 second source wait must remain unchanged")
    slug, model, session, marker_sha = CELLS[args.job_id]
    marker_path = CELL_BASE / slug / "allocation-marker.json"
    marker_bytes = raw(marker_path)
    need(sha(marker_bytes) == marker_sha, "Original actual allocation marker differs")
    marker = decode(marker_bytes)
    binding = {"scope_id": "hpc-forest-dynamic-independent-roots-r4b-max", "source_zip_sha256": SOURCE,
               "plan_sha256": PLAN, "model": model, "effort": "max", "phase": "roots", "session_id": session, "job_id": args.job_id}
    need(all(marker.get(k) == v for k, v in binding.items()) and marker.get("verified") is True
         and marker.get("source_files") == 110 and marker.get("native_model_calls") == 0
         and marker.get("requests_published") == 0 and marker.get("cache_claims_registry_created") is False and marker.get("native_generation_admitted") is False
         and marker.get("native_root_absent_before_stage") is True,
         "Actual zero-call source110 staging marker required")
    prefix = "results-" + args.job_id
    files = {"target-profile.json", "request-prepared.json", "mailbox/OWNER.json", "private-technical-error.json", "contract-source-result.json"}
    dirs = {prefix, prefix + "/mailbox", prefix + "/mailbox/requests", prefix + "/mailbox/responses", prefix + "/mailbox/logs"}
    inventory, blobs, seen, directory_names = {}, {}, set(), set()
    with tarfile.open(fileobj=io.BytesIO(archive_raw), mode="r:gz") as archive:
        for member in archive:
            need(len(seen) < len(files) + len(dirs), "Extra archive header refused immediately")
            name = member.name.rstrip("/") if member.isdir() else member.name
            parts = PurePosixPath(name).parts
            need(name not in seen and parts and not name.startswith("/") and "\\" not in name
                 and all(part not in {"", ".", ".."} and ":" not in part and part == part.rstrip(" .") for part in parts),
                 "Duplicate/traversal/ADS/alias archive header refused")
            seen.add(name)
            need(not member.issym() and not member.islnk() and not member.issparse()
                 and set(member.pax_headers) <= {"mtime", "atime", "ctime"}, "Links/sparse/path-changing metadata refused")
            need(all(math.isfinite(float(v)) for v in member.pax_headers.values()), "Nonfinite timestamp header refused")
            if member.isdir():
                need(name in dirs and member.size == 0, "Unknown or nonempty archive directory header")
                directory_names.add(name)
                continue
            need(member.isreg() and name.startswith(prefix + "/"), "Regular exact result member required")
            relative = name[len(prefix) + 1:]
            need(relative in files and 0 <= member.size <= 8 * 1024 * 1024, "Unknown or oversized result member")
            stream = archive.extractfile(member)
            need(stream is not None, "Readable in-memory regular member required")
            with stream:
                value = stream.read(member.size + 1)
            need(len(value) == member.size, "Tar member size differs")
            blobs[relative] = value
            inventory[relative] = {"bytes": len(value), "sha256": sha(value)}
    need(set(blobs) == files and directory_names == dirs, "Incomplete result files or empty mailbox directories")
    docs = {name: decode(value) for name, value in blobs.items()}
    result, error = docs["contract-source-result.json"], docs["private-technical-error.json"]
    need(result.get("schema") == "hpc-forest-dynamic-r4b-contract-source-result-v1"
         and all(result.get(k) == v for k, v in binding.items()) and result.get("verified") is False
         and result.get("native_response_received") is False and result.get("native_calls_replayed") == 0
         and result.get("global_admission_verified") is False and result.get("performance_verified") is False
         and result.get("error") == "RuntimeError", "Exact failed pre-authorization result required")
    need(error == {"never_model_input": True, "type": "RuntimeError", "detail": "Authorization wait expired; no invocation/replay"},
         "Only the exact no-authorization timeout branch is accepted")
    request, target, owner = (docs[name] for name in ("request-prepared.json", "target-profile.json", "mailbox/OWNER.json"))
    need(sha(blobs["request-prepared.json"]) == marker["request_sha256"] == marker["request_prepared"]["sha256"]
         and canonical_digest(request) == marker["request_digest"] and request.get("session_id") == session
         and request.get("model") == model and request.get("reasoning_effort") == "max"
         and request.get("meta_role") == "mother-dynamic-roots" and request.get("owner_key") == "synthetic-interface-contract:roots:" + session,
         "Actual prepared synthetic request identity/digest differs")
    need(type(request.get("expires_at")) in (int, float) and math.isfinite(request["expires_at"])
         and request["expires_at"] > marker["created_at"], "Actual original request expiry is required; never renew it")
    need(owner == {"protocol": "hpc-forest-codex-mailbox-v1", "session_id": session, "model": model,
                   "reasoning_effort": "max", "job_id": args.job_id, "owner": args.job_id}, "Exact original remote OWNER differs")
    need(sha(blobs["mailbox/OWNER.json"]) == marker["owner"]["sha256"]
         and sha(blobs["target-profile.json"]) == marker["target_profile"]["sha256"], "Archive OWNER/target differs from original marker")
    need(target.get("schema") == "hpc-forest-target-profile-v1" and target.get("slurm_job_id") == args.job_id
         and target.get("architecture") == "ARM64" and target.get("cpu_cores") == 4 and target.get("allocated_memory_mib") == 16384
         and target.get("allocated_gpus") == 0 and target.get("tasks") == target.get("nodes") == 1
         and canonical_digest({k: v for k, v in target.items() if k != "profile_digest"}) == target.get("profile_digest")
         and set(target.get("compilers", {})) == {"gcc", "g++"}
         and all(item.get("probe_returncode") == 0 and item.get("probe_stdout") == "4\n" for item in target["compilers"].values()),
         "Actual allocation-bound two-probe target profile differs; no probe is rerun")
    need(sha(raw(args.archive)) == args.archive_sha256 and sha(raw(marker_path)) == marker_sha, "Archive or original marker changed")
    value = {"schema": "hpc-forest-source110-r7-zero-call-cold-archive-inventory-v1", "verified_archive_metadata_only": True,
             **binding, "archive": {"path": str(args.archive), "sha256": args.archive_sha256},
             "allocation_marker": {"path": str(marker_path), "sha256": marker_sha}, "remote_stage_sha256": STAGE_SHA, "original_wait_seconds_from_pinned_source": 600,
             "original_request_expires_at": request["expires_at"], "original_request_bytes_not_rewritten": True,
             "request_files_published_in_received_mailbox": 0, "response_files_in_received_mailbox": 0,
             "claim_dispatch_invocation_artifacts_in_received_archive": 0,
             "inventory_before": inventory, "inventory_after": inventory, "archive_bytes_before_after_identical": True,
             "observed_at_utc": datetime.now(UTC).isoformat(), "regular_files": 5, "directory_headers": 5,
             "prepared_request_not_published_in_received_archive": True, "no_response_claim_invocation_or_worker_artifact_in_received_archive": True,
             "actual_allocation_target_profile_verified_from_bytes_only": True, "zero_call_timeout_control_flow_matched": True,
             "final_reception_admitted": False, "transport_three_SHA_admitted": False, "terminal_scheduler_state_admitted": False,
             "current_worker_or_cache_absence_observed": False, "native_generation_admitted": False,
             "normal_native_delivery_verified": False, "scientific_performance_or_method_R5_admitted": False,
             "source_import_probe_test_model_MCP_CIM_cache_lock_or_process_effect": False,
             "still_required": ["Actual terminal status and efficiency receipts for this job only", "Actual archive announcement/download/readback three equal SHAs and five transport sidecars where supplied", "Fresh ROOT full-CIM typed worker0 classification and exact local worker-cache absence; observer preserved", "Independent final cold metadata review; never route through the one-call negative auditor or r5 closed negative terminal"]}
    destination = HERE / ("INVENTAIRE-ARCHIVE-R7-ZERO-APPEL-" + args.job_id + ".json")
    with destination.open("x", encoding="utf-8", newline="\n") as output:
        json.dump(value, output, ensure_ascii=False, indent=2); output.write("\n")
    print(json.dumps({"path": str(destination), "sha256": sha(raw(destination)), "final_reception_admitted": False}))


if __name__ == "__main__":
    main()

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include <omp.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

typedef struct { float x, y, z, vx, vy, vz; } Body;

/* Compute gravitational forces and update velocities.
   Arrays are in SoA layout: each coordinate/velocity is a separate array. */
void body_force(const float * restrict px, const float * restrict py,
                const float * restrict pz, float * restrict vx,
                float * restrict vy, float * restrict vz, int n) {
  #pragma omp parallel for simd schedule(static)
  for (int i = 0; i < n; ++i) {
    float fx = 0.0f;
    float fy = 0.0f;
    float fz = 0.0f;

    const float xi = px[i];
    const float yi = py[i];
    const float zi = pz[i];

    for (int j = 0; j < n; ++j) {
      float dx = px[j] - xi;
      float dy = py[j] - yi;
      float dz = pz[j] - zi;
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1.0f / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    vx[i] += DT*fx;
    vy[i] += DT*fy;
    vz[i] += DT*fz;
  }
}

Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }
  return bodies;
}

void write_dataset(const int nbodies, const float * restrict px,
                   const float * restrict py, const float * restrict pz,
                   const float * restrict vx, const float * restrict vy,
                   const float * restrict vz) {
  Body *bodies = (Body *)malloc(nbodies * sizeof(Body));
  for (int i = 0; i < nbodies; ++i) {
    bodies[i].x = px[i];
    bodies[i].y = py[i];
    bodies[i].z = pz[i];
    bodies[i].vx = vx[i];
    bodies[i].vy = vy[i];
    bodies[i].vz = vz[i];
  }
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
  free(bodies);
}

int main(int argc, char **argv) {
  int nbodies;
  Body *bodies = read_dataset(&nbodies);

  float *px = (float *)malloc(nbodies * sizeof(float));
  float *py = (float *)malloc(nbodies * sizeof(float));
  float *pz = (float *)malloc(nbodies * sizeof(float));
  float *vx = (float *)malloc(nbodies * sizeof(float));
  float *vy = (float *)malloc(nbodies * sizeof(float));
  float *vz = (float *)malloc(nbodies * sizeof(float));

  for (int i = 0; i < nbodies; ++i) {
    px[i] = bodies[i].x;
    py[i] = bodies[i].y;
    pz[i] = bodies[i].z;
    vx[i] = bodies[i].vx;
    vy[i] = bodies[i].vy;
    vz[i] = bodies[i].vz;
  }
  free(bodies);

  for (int iter = 0; iter < N_ITER; ++iter) {
    body_force(px, py, pz, vx, vy, vz, nbodies);

    #pragma omp parallel for simd schedule(static)
    for (int i = 0; i < nbodies; ++i) {
      px[i] += vx[i] * DT;
      py[i] += vy[i] * DT;
      pz[i] += vz[i] * DT;
    }
  }

  write_dataset(nbodies, px, py, pz, vx, vy, vz);

  free(px); free(py); free(pz);
  free(vx); free(vy); free(vz);

  exit(EXIT_SUCCESS);
}

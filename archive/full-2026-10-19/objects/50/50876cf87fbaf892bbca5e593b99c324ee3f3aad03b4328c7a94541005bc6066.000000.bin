{
  "src/solution.cpp": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <algorithm>\n#include <limits>\n\nint main() {\n    int n, s;\n    std::cin >> n >> s;\n    std::vector<std::vector<int> > matrix(n, std::vector<int>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            scanf(\"%d\", &(matrix[i][j]));\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    std::vector<long long> columnSums(n, 0);\n    long long* columns = columnSums.data();\n    for (int r = 0; r < s; ++r) {\n        const int* row = matrix[r].data();\n        #pragma omp simd\n        for (int c = 0; c < n; ++c)\n            columns[c] += static_cast<long long>(row[c]);\n    }\n\n    long long mxSum = std::numeric_limits<long long>::lowest();\n    for (int top = 0; top + s <= n; ++top) {\n        long long sum = 0;\n        #pragma omp simd reduction(+:sum)\n        for (int c = 0; c < s; ++c)\n            sum += columns[c];\n\n        long long rowMax = sum;\n        for (int c = s; c < n; ++c) {\n            sum += columns[c] - columns[c - s];\n            rowMax = std::max(rowMax, sum);\n        }\n        mxSum = std::max(mxSum, rowMax);\n\n        if (top + s < n) {\n            const int* leaving = matrix[top].data();\n            const int* entering = matrix[top + s].data();\n            #pragma omp simd\n            for (int c = 0; c < n; ++c)\n                columns[c] += static_cast<long long>(entering[c])\n                            - static_cast<long long>(leaving[c]);\n        }\n    }\n\n    printf(\"%lld\\n\", mxSum);\n}\n"
}

"""Seal this independent local review; no implementation or live evidence writes."""
import datetime
import hashlib
import importlib.util
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent


def digest(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def ref(path):
    return {"path": str(path.resolve()), "sha256": digest(path)}


def save(name, value):
    with (HERE / name).open("x", encoding="utf8") as output:
        output.write(json.dumps(value, ensure_ascii=False, indent=2) + "\n")


def load(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


expected_seals = {
    "LIVRAISON-DELTA-LOCAL-NON-ADMIS.json": "c3f89dfaebbd596ee1bbe4708bd7218a2aa7946857a27d3e6304aaa9d3a4c64a",
    "MANIFESTE-DELTA-LOCAL.json": "bb2096558e8b9038836e31448413d487f55611bdfdead6e3a7e2826130f8dd23",
    "COMPONENTS.json": "c03ed75936ae5b833cbe0acc8a875083bd2a06831853fb706a8d2907968c5203",
    "DIFF-LOCAL-FERME.patch": "c637a3ddc882b2f4cd73e4d9e92cd5a6833ad5ce9cadba82b875257ad557746f",
}
assert all(digest(ROOT / name) == pin for name, pin in expected_seals.items())
manifest = json.loads((ROOT / "MANIFESTE-DELTA-LOCAL.json").read_text("utf8"))
actual = {name: {"sha256": digest(ROOT / name), "bytes": (ROOT / name).stat().st_size}
          for name in manifest["files"]}
assert actual == manifest["files"]
save("INTEGRITE-APRES-TESTS.json", {
    "schema": "hpc-forest-independent-review-integrity-v1", "verified": True,
    "upstream_complete_manifest": ref(ROOT / "MANIFESTE-DELTA-LOCAL.json"),
    "manifested_file_count": len(actual), "all_manifested_files_equal_original_pins": True,
    "also_checked_before_by_independent_test": "test_manifest_and_all_old_and_active_bytes",
    "files": actual, "upstream_seals": expected_seals,
    "review_folder_outside_upstream_manifest": True,
})
review = json.loads((ROOT / "REVUE-PROPOSEE-NON-ADMISE.json").read_text("utf8"))
review.update({
    "verified": True, "blocking_findings": [], "nonblocking_findings": [],
    "reviewer": "/root/cli_role_loader_evidence",
    "created_at_utc": datetime.datetime.now(datetime.UTC).isoformat(),
    "review_kind": "independent_static_local_integration_delta_review",
    "local_delta_revision": "r5-so-clos-delta-local",
    "producer_sha256": digest(ROOT / "lane_projection.py"),
    "design_sha256": "4d20be6fd5e79a89447f0a545f0af12328b486dd9525de8f830cd19d839d9ea3",
    "source_state_reader_sha256": "564398d676dceb6b5ba893fcbb3835c7aec31a1cbd5d5c5dcef6b361a3a23338",
    "source_state_current_verifier_sha256": "ed888a9ab9c35e4e1a6c227525e9578281ed57c6961ccd9c9928eb397f62e450",
    "independent_tests_passed": 8, "upstream_delta_OBS4_tests_passed": 18,
    "upstream_pytest_subtests_passed": 7,
    "verified_properties": [
        "Original allocated Q qualification equality function is AST-identical to its qualified baseline",
        "Actual received Q accepts only original d18259 graph; active c03ed graph is rejected as allocated graph",
        "Entire qualified baseline and active graph are hashed; mock old component corruption is refused",
        "Closed local delta has exactly four modified local components and three added local runtime test dependencies",
        "ARM executable bytes, nine commands, source105, plan and assemble_admissions are unchanged",
        "Exact reviewed post-cold-disappearance reader and verifier are bound before mocked source import boundary",
        "Historical SO anchor and latest R2d stop/preservation/independent closure remain separate",
        "Same stopped identity, command-equivalent new PID and opaque same PID remain refused",
        "Actual OBS4.main checks local observer/test validation then refuses missing real policy before any live boundary",
    ],
    "evidence_refs": [ref(ROOT / name) for name in expected_seals] + [
        ref(ROOT / "DELTA-LOCAL-FERME.json"), ref(ROOT / "PORTEES-Q-ET-DELTA.json"),
        ref(HERE / "test_revue_independante.py"), ref(HERE / "tests-independants.log"),
        ref(HERE / "tests-delta-obs4.log"), ref(HERE / "INTEGRITE-APRES-TESTS.json"),
    ],
    "runtime_validation_is_local_only": True,
    "actual_native_or_allocated_delta_start_verified": False,
    "native_generation_admitted": False, "normal_first_start_verified": False,
    "activation_admitted": False, "fixture_or_template_is_admission": False,
    "production_source_imported_or_tested": False,
    "live_CIM_or_cache_read": False, "CLI_model_MCP_SSH_job_auth_or_transport_calls": 0,
    "process_stop_calls": 0, "Q_reexecuted": False,
    "limits": [
        "Positive review covers this Windows-local byte delta and the exact upstream graph only",
        "Original Q proves its original allocated base, not ARM execution of modified local modules",
        "Neutral functions and refused OBS4.main boundary do not establish a live observer start or native first NORMAL",
        "Remaining CLI role/configuration diagnostics and any new admissions are outside this review",
        "Fresh policy, CIM, authorizations, readbacks and normal first-start evaluation remain required at activation",
    ],
})
save("REVUE-INDEPENDANTE-DELTA-LOCAL.json", review)
contract = load("independent_seal_contract", ROOT / "chain_contract.py")
checked = contract.integration_review(ref(HERE / "REVUE-INDEPENDANTE-DELTA-LOCAL.json"), ROOT)
assert checked == review
projection = load("independent_seal_projection", ROOT / "lane_projection.py")
checked = projection.verified_review(
    ref(HERE / "REVUE-INDEPENDANTE-DELTA-LOCAL.json"),
    kind="hpc-forest-lane-r2-local-projection-producer-review-v1",
    bindings={"producer_sha256": review["producer_sha256"], "design_sha256": review["design_sha256"],
              "source_state_reader_sha256": review["source_state_reader_sha256"]})
assert checked == review
assert all(digest(ROOT / name) == pin for name, pin in expected_seals.items())
assert actual == {name: {"sha256": digest(ROOT / name), "bytes": (ROOT / name).stat().st_size}
                  for name in manifest["files"]}
save("INTERFACES-PURES-VERIFIEES.json", {
    "verified": True, "review": ref(HERE / "REVUE-INDEPENDANTE-DELTA-LOCAL.json"),
    "integration_review_accepts_exact_graph": True, "projection_producer_review_binding_accepts": True,
    "upstream_manifest_files_unchanged_before_after_interface_checks": True,
    "generation_or_activation_admitted": False, "live_or_transport_calls": 0,
})
print(json.dumps({"review": ref(HERE / "REVUE-INDEPENDANTE-DELTA-LOCAL.json"),
                  "interface_check": ref(HERE / "INTERFACES-PURES-VERIFIEES.json"),
                  "upstream_manifested_file_count": len(actual)}, indent=2))

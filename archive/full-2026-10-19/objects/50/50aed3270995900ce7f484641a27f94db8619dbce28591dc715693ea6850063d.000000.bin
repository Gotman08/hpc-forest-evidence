#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <algorithm>
#include <climits>

int main() {
    int n,s;
    std::cin >> n >> s;
    // Store matrix in column-major order for contiguous access during prefix sum computation.
    std::vector<int> mat(n * n);
    for(int i=0;i<n;i++)
        for(int j=0;j<n;j++) {
            int val;
            scanf("%d", &val);
            mat[j*n + i] = val;
        }

    assert(s<n);
    assert(n<8000);
    assert(s>0);
    assert(n>0);

    // Column prefix sums in flat row-major: colPref[i*n + j]
    std::vector<long long> colPref(n * n);
    #pragma omp parallel
    {
        // First worksharing loop computes column prefixes; implicit barrier after it.
        #pragma omp for schedule(static)
        for(int j=0;j<n;++j) {
            long long running = 0;
            for(int i=0;i<n;++i) {
                running += mat[j*n + i];
                colPref[i*n + j] = running;
            }
        }

        // Second worksharing loop finds the maximum submatrix sum using guided scheduling.
        #pragma omp for reduction(max:mxSum) schedule(guided)
        for(int r=0; r<=n-s; ++r) {
            int bottom = r + s - 1;
            int topMinusOne = r - 1;
            long long cur = 0;
            // initial window at column 0
            for(int c=0;c<s;++c) {
                long long seg = colPref[bottom*n + c] - (topMinusOne >= 0 ? colPref[topMinusOne*n + c] : 0);
                cur += seg;
            }
            if(cur > mxSum) mxSum = cur;

            for(int c=1; c<=n-s; ++c) {
                int outCol = c-1;
                int inCol = c+s-1;
                long long segOut = colPref[bottom*n + outCol] - (topMinusOne >= 0 ? colPref[topMinusOne*n + outCol] : 0);
                long long segIn = colPref[bottom*n + inCol] - (topMinusOne >= 0 ? colPref[topMinusOne*n + inCol] : 0);
                cur += segIn - segOut;
                if(cur > mxSum) mxSum = cur;
            }
        }
    }

    printf("%d\n", (int)mxSum);
}

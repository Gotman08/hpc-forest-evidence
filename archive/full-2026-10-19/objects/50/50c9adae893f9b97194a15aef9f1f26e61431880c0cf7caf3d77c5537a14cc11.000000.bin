#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <algorithm>
#include <cstring>

// Fast integer parsing using getchar_unlocked (POSIX)
static int read_int() {
    int x = 0, c;
    while ((c = getchar_unlocked()) < '0');
    do { x = x * 10 + (c - '0'); } while ((c = getchar_unlocked()) >= '0');
    return x;
}

int main() {
    int n, s;
    std::cin >> n >> s;
    
    // Allocate flat integral image array aligned to cache line (64 bytes)
    const size_t stride = static_cast<size_t>(n) + 1;
    int* I;
    if (posix_memalign(reinterpret_cast<void**>(&I), 64, stride * stride * sizeof(int)) != 0) {
        std::cerr << "Allocation failed\n";
        return 1;
    }
    
    // Initialize first row and column of integral image to zero
    for (size_t j = 0; j < stride; ++j)
        I[j] = 0;
    for (size_t i = 0; i <= static_cast<size_t>(n); ++i)
        I[i * stride] = 0;
    
    // Read matrix and compute integral image in one pass
    int row_sum = 0;
    for (int i = 1; i <= n; ++i) {
        row_sum = 0;
        const size_t base_i = static_cast<size_t>(i) * stride;
        const size_t base_im1 = static_cast<size_t>(i - 1) * stride;
        for (int j = 1; j <= n; ++j) {
            int val = read_int();
            row_sum += val;
            I[base_i + j] = I[base_im1 + j] + row_sum;
        }
    }
    
    // Search for maximum SxS submatrix using 2D tiling
    const int B = 64;  // tile size (tuned)
    int mxSum = -2147483648;  // minimum possible integer
    
    #pragma GCC ivdep
    for (int ti = 0; ti <= n - s; ti += B) {
        const int i_end = std::min(ti + B, n - s + 1);
        #pragma GCC ivdep
        for (int tj = 0; tj <= n - s; tj += B) {
            const int j_end = std::min(tj + B, n - s + 1);
            // Process tile [ti,i_end) x [tj,j_end)
            #pragma GCC ivdep
            for (int i = ti; i < i_end; ++i) {
                const size_t base_i = static_cast<size_t>(i) * stride;
                const size_t base_ipS = static_cast<size_t>(i + s) * stride;
                #pragma GCC ivdep
                for (int j = tj; j < j_end; ++j) {
                    int sum = I[base_ipS + j + s] - I[base_i + j + s]
                            - I[base_ipS + j] + I[base_i + j];
                    if (sum > mxSum)
                        mxSum = sum;
                }
            }
        }
    }
    
    printf("%d\n", mxSum);
    free(I);
    return 0;
}

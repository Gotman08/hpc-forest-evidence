/*
  Quicksort
*/
#include <stdio.h>
#include <stdlib.h>
#include <limits.h>
#include <string.h>
#include <openssl/md5.h>

#ifdef _OPENMP
#include <omp.h>
#endif

/*
 * Prototypes
 */
void srandnum(int seed);
double randnum(void);
int *generate_case(int N);
double drand(int xmin, int xmax);
void swap(int *toorder, int i, int j);
int partition(int *toorder, int lo, int hi);
void _quicksort(int *toorder, int lo, int hi);
void quicksort(int *toorder, int N);
int is_sorted(int *toorder, int N);

#define RADIX_BASE 256u
#define RADIX_PARALLEL_MIN 32768u

static unsigned int radix_key(int value)
{
    return (unsigned int)value ^ (UINT_MAX - (UINT_MAX >> 1));
}

static void radix_sort_serial(int *values, int *buffer, size_t count)
{
    int *source = values;
    int *target = buffer;

    for (unsigned int shift = 0;
         shift < sizeof(unsigned int) * CHAR_BIT;
         shift += 8) {
        size_t offsets[RADIX_BASE] = {0};

        for (size_t i = 0; i < count; i++) {
            unsigned int bucket = (radix_key(source[i]) >> shift) & 0xffu;
            offsets[bucket]++;
        }

        size_t prefix = 0;
        for (unsigned int bucket = 0; bucket < RADIX_BASE; bucket++) {
            size_t bucket_count = offsets[bucket];
            offsets[bucket] = prefix;
            prefix += bucket_count;
        }

        for (size_t i = 0; i < count; i++) {
            unsigned int bucket = (radix_key(source[i]) >> shift) & 0xffu;
            target[offsets[bucket]++] = source[i];
        }

        int *temporary = source;
        source = target;
        target = temporary;
    }

    if (source != values)
        memcpy(values, source, count * sizeof(*values));
}

#ifdef _OPENMP
static void radix_sort_parallel(int *values, int *buffer, size_t count)
{
    int maximum_threads = omp_get_max_threads();

    if (maximum_threads <= 1 || count < RADIX_PARALLEL_MIN) {
        radix_sort_serial(values, buffer, count);
        return;
    }

    if ((size_t)maximum_threads > (size_t)-1 / RADIX_BASE) {
        radix_sort_serial(values, buffer, count);
        return;
    }

    size_t slots = (size_t)maximum_threads * RADIX_BASE;
    size_t *histogram = (size_t *)calloc(slots, sizeof(*histogram));
    size_t *offsets = (size_t *)malloc(slots * sizeof(*offsets));

    if (histogram == NULL || offsets == NULL) {
        free(histogram);
        free(offsets);
        radix_sort_serial(values, buffer, count);
        return;
    }

#pragma omp parallel default(none) shared(values, buffer, count, histogram, offsets)
    {
        const int thread_id = omp_get_thread_num();
        const int thread_count = omp_get_num_threads();
        const size_t first = count * (size_t)thread_id / (size_t)thread_count;
        const size_t last = count * (size_t)(thread_id + 1) / (size_t)thread_count;
        int *source = values;
        int *target = buffer;

        for (unsigned int shift = 0;
             shift < sizeof(unsigned int) * CHAR_BIT;
             shift += 8) {
            size_t *local_histogram = histogram + (size_t)thread_id * RADIX_BASE;

            for (unsigned int bucket = 0; bucket < RADIX_BASE; bucket++)
                local_histogram[bucket] = 0;

            for (size_t i = first; i < last; i++) {
                unsigned int bucket = (radix_key(source[i]) >> shift) & 0xffu;
                local_histogram[bucket]++;
            }

#pragma omp barrier
#pragma omp single
            {
                size_t prefix = 0;

                for (unsigned int bucket = 0; bucket < RADIX_BASE; bucket++) {
                    for (int thread = 0; thread < thread_count; thread++) {
                        size_t index = (size_t)thread * RADIX_BASE + bucket;
                        offsets[index] = prefix;
                        prefix += histogram[index];
                    }
                }
            }

            size_t *local_offsets = offsets + (size_t)thread_id * RADIX_BASE;
            for (size_t i = first; i < last; i++) {
                unsigned int bucket = (radix_key(source[i]) >> shift) & 0xffu;
                target[local_offsets[bucket]++] = source[i];
            }

#pragma omp barrier
            int *temporary = source;
            source = target;
            target = temporary;
        }
    }

    if (((sizeof(unsigned int) * CHAR_BIT + 7) / 8) & 1)
        memcpy(values, buffer, count * sizeof(*values));

    free(offsets);
    free(histogram);
}
#endif

/*
 * A generic pRNG
 */
#define MY_RAND_MAX 0x7FFFFFFF

#define RANDNUM_W 521288629
#define RANDNUM_Z 362436069

unsigned int randum_w = RANDNUM_W;
unsigned int randum_z = RANDNUM_Z;

void srandnum(int seed)
{
    unsigned int w, z;
    w = (seed * 104623) & 0xffffffff;
    randum_w = (w) ? w : RANDNUM_W;
    z = (seed * 48947) & 0xffffffff;
    randum_z = (z) ? z : RANDNUM_Z;
}

double randnum(void)
{
    unsigned int u;
    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);
    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);
    u = (randum_z << 16) + randum_w;
    return (abs(u));
}

/*
 * Main function
 */
int main(int argc, char *argv[])
{
    int N = 0;
    int *our_list = NULL;

    //The input provides the case size
    scanf("%d", &N);
    if (N <= 0) {
        printf("Error: please, provide the case size.\n");
        return 1;
    }

    //Generate the case
    our_list = generate_case(N);
    if (our_list == NULL) {
        printf("Error: case instantiation failed.\n");
        return 1;
    }

    //Do the thing
    quicksort(our_list, N);

    if (is_sorted(our_list, N) == 1) {
        printf("Error, for some reason list is still unsorted.\n");
        return 1;
    }

#ifdef COMPUTE_MD5_PROBLEM
    //Compute MD5 Checksum for problem identification
    MD5_CTX c;
    unsigned char out[MD5_DIGEST_LENGTH];
    MD5_Init(&c);
    MD5_Update(&c, our_list, N * sizeof(int));
    MD5_Final(out, &c);
    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {
        printf("%02x", out[n]);
    }
#endif
    printf("\n");

    //Clean up
    free(our_list);

    return 0;
}

/*
 * Public API
 */
void quicksort(int *toorder, int N)
{
    if (N < 2)
        return;

    int *buffer = (int *)malloc((size_t)N * sizeof(*buffer));
    if (buffer == NULL) {
        _quicksort(toorder, 0, N - 1);
        return;
    }

#ifdef _OPENMP
    radix_sort_parallel(toorder, buffer, (size_t)N);
#else
    radix_sort_serial(toorder, buffer, (size_t)N);
#endif

    free(buffer);
}

/*
 * Internal recursive function to quicksort
 */
void _quicksort(int *toorder, int lo, int hi)
{
    if (lo >= hi)
        return;
    int b = partition(toorder, lo, hi);
    _quicksort(toorder, lo, b - 1);
    _quicksort(toorder, b + 1, hi);
}

/*
 * Swap two values.
 */
void swap(int *toorder, int i, int j)
{
    int temp = toorder[i];
    toorder[i] = toorder[j];
    toorder[j] = temp;
}

/*
 * Partition decision
 */
int partition(int *toorder, int lo, int hi)
{
    int b = lo;
    int r = (int) (lo + (hi - lo) * (randnum() / MY_RAND_MAX));
    int pivot = toorder[r];
    swap(toorder, r, hi);
    for (int i = lo; i < hi; i++) {
        if (toorder[i] < pivot) {
            swap(toorder, i, b);
            b++;
        }
    }
    swap(toorder, hi, b);
    return b;
}

/*
 * Check if elements are in non-decreasing order
 */
int is_sorted(int *toorder, int N)
{
    for (int i = 1; i < N; i++) {
        if (toorder[i] < toorder[i - 1]) {
            return 1;
        }
    }
    return 0;
}


/*
 * Generate a case
 */
int *generate_case(int N)
{
    int i;
    int *ret = NULL;

    // Make case generation reproducible
    srandnum(0);

    // Allocate memory
    ret = (int *) malloc((size_t)N * sizeof(*ret));
    if (ret == NULL) {
        printf("Error: some malloc won't work.\n");
        return NULL;
    }
    // Get pseudo-random positive integer values
    for (i = 0; i < N; i++) {
        ret[i] = drand(0, INT_MAX);
    }
    return ret;
}

/*
 * A pseudo-random number between two positive integer values
 */
double drand(int xmin, int xmax)
{
    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;
}

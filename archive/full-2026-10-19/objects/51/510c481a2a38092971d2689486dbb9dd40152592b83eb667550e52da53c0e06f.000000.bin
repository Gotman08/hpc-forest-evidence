{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Compute the gravitational impact among all pairs of bodies in \n * the system and update positions.\n */\nvoid body_force(const float *restrict x, const float *restrict y,\n                const float *restrict z, float *restrict vx,\n                float *restrict vy, float *restrict vz,\n                float dt, int n) {\n  #pragma omp parallel for schedule(static)\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    const float xi = x[i];\n    const float yi = y[i];\n    const float zi = z[i];\n\n    #pragma omp simd reduction(+:fx,fy,fz) aligned(x,y,z:32)\n    for (int j = 0; j < n; ++j) {\n      float dx = x[j] - xi;\n      float dy = y[j] - yi;\n      float dz = z[j] - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1.0f / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    vx[i] += dt*fx;\n    vy[i] += dt*fy;\n    vz[i] += dt*fz;\n\n    // Update positions immediately after velocity update (semi-implicit Euler)\n    x[i] += vx[i]*dt;\n    y[i] += vy[i]*dt;\n    z[i] += vz[i]*dt;\n  }\n}\n\n/*\n * Read a binary dataset with initialized bodies.\n */\nvoid read_dataset(int *nbodies, float **restrict x, float **restrict y,\n                  float **restrict z, float **restrict vx,\n                  float **restrict vy, float **restrict vz) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  // Allocate aligned memory for SoA layout\n  size_t alignment = 32;\n  size_t sz = *nbodies * sizeof(float);\n  if (posix_memalign((void**)x, alignment, sz) != 0 ||\n      posix_memalign((void**)y, alignment, sz) != 0 ||\n      posix_memalign((void**)z, alignment, sz) != 0 ||\n      posix_memalign((void**)vx, alignment, sz) != 0 ||\n      posix_memalign((void**)vy, alignment, sz) != 0 ||\n      posix_memalign((void**)vz, alignment, sz) != 0) {\n    fprintf(stderr,\"\\nError allocating aligned memory\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  // Read interleaved AoS data and convert to SoA\n  float *tmp = (float*)malloc(*nbodies * 6 * sizeof(float));\n  if (!tmp) {\n    fprintf(stderr,\"\\nError allocating temporary buffer\\n\");\n    exit(EXIT_FAILURE);\n  }\n  b = fread(tmp, *nbodies * 6 * sizeof(float), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  for (int i = 0; i < *nbodies; ++i) {\n    (*x)[i] = tmp[i*6 + 0];\n    (*y)[i] = tmp[i*6 + 1];\n    (*z)[i] = tmp[i*6 + 2];\n    (*vx)[i] = tmp[i*6 + 3];\n    (*vy)[i] = tmp[i*6 + 4];\n    (*vz)[i] = tmp[i*6 + 5];\n  }\n\n  free(tmp);\n}\n\n/*\n * Write simulation results into a binary dataset (AoS format).\n */\nvoid write_dataset(const int nbodies, const float *restrict x,\n                   const float *restrict y, const float *restrict z,\n                   const float *restrict vx, const float *restrict vy,\n                   const float *restrict vz) {\n  // Convert SoA back to AoS for output\n  float *tmp = (float*)malloc(nbodies * 6 * sizeof(float));\n  if (!tmp) {\n    fprintf(stderr,\"\\nError allocating temporary buffer\\n\");\n    exit(EXIT_FAILURE);\n  }\n  for (int i = 0; i < nbodies; ++i) {\n    tmp[i*6 + 0] = x[i];\n    tmp[i*6 + 1] = y[i];\n    tmp[i*6 + 2] = z[i];\n    tmp[i*6 + 3] = vx[i];\n    tmp[i*6 + 4] = vy[i];\n    tmp[i*6 + 5] = vz[i];\n  }\n\n  int b = fwrite(tmp, nbodies * 6 * sizeof(float), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  free(tmp);\n}\n\nint main(int argc, char **argv) {\n  int nbodies;\n  float *x = NULL, *y = NULL, *z = NULL;\n  float *vx = NULL, *vy = NULL, *vz = NULL;\n\n  read_dataset(&nbodies, &x, &y, &z, &vx, &vy, &vz);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated (now inside body_force).\n   */\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    body_force(x, y, z, vx, vy, vz, DT, nbodies);\n  }\n\n  write_dataset(nbodies, x, y, z, vx, vy, vz);\n\n  free(x); free(y); free(z);\n  free(vx); free(vy); free(vz);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Merging the position update loop into body_force after velocity accumulation reduces parallel region overhead and improves data locality, allowing better SIMD vectorization of both force computation and integration within a single OpenMP parallel for. Combined with existing SoA layout, aligned allocation, restrict qualifiers, hoisted coordinates, and #pragma omp simd reduction on the inner loop, this should lower execution time below previous results.",
  "notes": "",

        "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nusing namespace std;\n\nconst uint32_t MOD = 1000000007U;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic inline uint32x4_t neon_add_mod(uint32x4_t a, uint32x4_t b,\n                                     uint32x4_t modulus) {\n    const uint32x4_t sum = vaddq_u32(a, b);\n    // sum < 2*MOD. An underflowed unsigned subtraction exceeds sum.\n    return vminq_u32(sum, vsubq_u32(sum, modulus));\n}\n#endif\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n\n    vector<vector<int>> blockedDiagonals(2 * n - 1);\n    for (int c = 0; c < m; ++c) {\n        int i, j;\n        cin >> i >> j;\n        blockedDiagonals[i + j].push_back(i + 1);\n    }\n\n    // Index r represents matrix row r - 1; index zero is padding.\n    vector<uint32_t> buffer(n + 1, 0);\n    uint32_t* const paths = buffer.data();\n    paths[1] = 1;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const uint32x4_t modulus = vdupq_n_u32(MOD);\n#endif\n\n    for (int diagonal = 0; diagonal < 2 * n - 1; ++diagonal) {\n        const int first = max(1, diagonal - n + 2);\n        const int last = min(n, diagonal + 1);\n        int r = last;\n\n        // Descending updates preserve both preceding-diagonal inputs.\n        // The rolling vectors retain original values, never new outputs.\n#if defined(__aarch64__) && defined(__ARM_NEON)\n        const int vectorLimit = max(first + 3, 7);\n        if (r >= vectorLimit) {\n            uint32x4_t high = vld1q_u32(paths + r - 3);\n            const int unrolledLimit = max(first + 15, 19);\n\n            for (; r >= unrolledLimit; r -= 16) {\n                const uint32x4_t lower0 = vld1q_u32(paths + r - 7);\n                const uint32x4_t lower1 = vld1q_u32(paths + r - 11);\n                const uint32x4_t lower2 = vld1q_u32(paths + r - 15);\n                const uint32x4_t lower3 = vld1q_u32(paths + r - 19);\n\n                const uint32x4_t out0 = neon_add_mod(\n                    high, vextq_u32(lower0, high, 3), modulus);\n                const uint32x4_t out1 = neon_add_mod(\n                    lower0, vextq_u32(lower1, lower0, 3), modulus);\n                const uint32x4_t out2 = neon_add_mod(\n                    lower1, vextq_u32(lower2, lower1, 3), modulus);\n                const uint32x4_t out3 = neon_add_mod(\n                    lower2, vextq_u32(lower3, lower2, 3), modulus);\n\n                vst1q_u32(paths + r - 3, out0);\n                vst1q_u32(paths + r - 7, out1);\n                vst1q_u32(paths + r - 11, out2);\n                vst1q_u32(paths + r - 15, out3);\n                high = lower3;\n            }\n\n            for (; r >= vectorLimit; r -= 4) {\n                const uint32x4_t lower = vld1q_u32(paths + r - 7);\n                const uint32x4_t above = vextq_u32(lower, high, 3);\n                vst1q_u32(paths + r - 3,\n                          neon_add_mod(high, above, modulus));\n                high = lower;\n            }\n        }\n#endif\n        for (; r >= first; --r) {\n            const uint32_t sum = paths[r - 1] + paths[r];\n            paths[r] = sum >= MOD ? sum - MOD : sum;\n        }\n\n        // Clear obstacles before any subsequent diagonal consumes them.\n        // Repeated obstacle coordinates are harmless.\n        for (int blockedRow : blockedDiagonals[diagonal]) {\n            paths[blockedRow] = 0;\n        }\n    }\n\n    cout << paths[n] << endl;\n}\n",
        "path": "src/solution.cpp"
      }

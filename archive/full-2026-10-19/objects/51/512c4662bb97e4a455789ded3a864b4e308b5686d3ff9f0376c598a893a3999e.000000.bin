      "mission": {
        "base_commit": "24b68af53908afa967027ddb2b0dd1c39ca6fa80",
        "delegation_parent": "R/C",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "A single conditional OpenMP team, capped at four threads and statically sharing independent columns, may improve sufficiently large matrices while keeping small workloads serial and preserving each column's calculation order.",
        "id": "1ad37635f494467b",
        "ordinal": 1,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/est_matriz_seq.c"
          ],
          "retained": [
            "Added one parallel region around the statistics pipeline and static worksharing for column loops; enabled the team only for at least four columns and a generic rows-squared-times-columns estimate of at least 262144.",
            "Kept each column's serial inner loops, arithmetic operations, and accumulation order intact; the parallel team is limited to four threads.",
            "Initialized each mode-count slot before incrementing it, making mode calculation deterministic."
          ]
        },
        "tree_id": "e1:C",

      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <omp.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Compute the gravitational impact among all pairs of bodies in \n * the system.\n * Uses Structure-of-Arrays (SoA) layout for better spatial locality.\n */\nvoid body_force(float *restrict px, float *restrict py, float *restrict pz,\n                float *restrict vx, float *restrict vy, float *restrict vz,\n                float dt, int n) {\n  #pragma omp for schedule(static)\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    const float xi = px[i];\n    const float yi = py[i];\n    const float zi = pz[i];\n\n    #pragma omp simd reduction(+:fx,fy,fz)\n    for (int j = 0; j < n; ++j) {\n      if (i == j) continue;\n      float dx = px[j] - xi;\n      float dy = py[j] - yi;\n      float dz = pz[j] - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1.0f / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    vx[i] += dt*fx;\n    vy[i] += dt*fy;\n    vz[i] += dt*fz;\n  }\n}\n\n/*\n * Read a binary dataset with initialized bodies.\n * Returns arrays allocated on heap; sets nbodies.\n */\nvoid read_dataset(int *nbodies,\n                  float **px, float **py, float **pz,\n                  float **vx, float **vy, float **vz) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  // Temporary buffer to read AoS data from binary file\n  typedef struct { float x, y, z, vx, vy, vz; } Body;\n  Body *tmp = (Body *)malloc(*nbodies * sizeof(Body));\n  if (!tmp) {\n    fprintf(stderr,\"\\nMemory allocation error\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  b = fread(tmp, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    free(tmp);\n    exit(EXIT_FAILURE);\n  }\n\n  // Allocate SoA arrays with 32-byte alignment for NEON\n  size_t align = 32;\n  if (posix_memalign((void**)px, align, *nbodies * sizeof(float)) ||\n      posix_memalign((void**)py, align, *nbodies * sizeof(float)) ||\n      posix_memalign((void**)pz, align, *nbodies * sizeof(float)) ||\n      posix_memalign((void**)vx, align, *nbodies * sizeof(float)) ||\n      posix_memalign((void**)vy, align, *nbodies * sizeof(float)) ||\n      posix_memalign((void**)vz, align, *nbodies * sizeof(float))) {\n    fprintf(stderr,\"\\nAligned allocation failed\\n\");\n    free(tmp);\n    exit(EXIT_FAILURE);\n  }\n\n  // Scatter from AoS to SoA\n  for (int i = 0; i < *nbodies; ++i) {\n    (*px)[i] = tmp[i].x;\n    (*py)[i] = tmp[i].y;\n    (*pz)[i] = tmp[i].z;\n    (*vx)[i] = tmp[i].vx;\n    (*vy)[i] = tmp[i].vy;\n    (*vz)[i] = tmp[i].vz;\n  }\n\n  free(tmp);\n}\n\n/*\n * Write simulation results into a binary dataset (AoS format).\n */\nvoid write_dataset(const int nbodies,\n                   const float *px, const float *py, const float *pz,\n                   const float *vx, const float *vy, const float *vz) {\n  typedef struct { float x, y, z, vx, vy, vz; } Body;\n  Body *tmp = (Body *)malloc(nbodies * sizeof(Body));\n  if (!tmp) {\n    fprintf(stderr,\"\\nMemory allocation error\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  // Gather from SoA to AoS\n  for (int i = 0; i < nbodies; ++i) {\n    tmp[i].x = px[i];\n    tmp[i].y = py[i];\n    tmp[i].z = pz[i];\n    tmp[i].vx = vx[i];\n    tmp[i].vy = vy[i];\n    tmp[i].vz = vz[i];\n  }\n\n  int b = fwrite(tmp, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    free(tmp);\n    exit(EXIT_FAILURE);\n  }\n\n  free(tmp);\n}\n\nint main(int argc, char **argv) {\n  int nbodies;\n  float *px = NULL, *py = NULL, *pz = NULL;\n  float *vx = NULL, *vy = NULL, *vz = NULL;\n\n  read_dataset(&nbodies, &px, &py, &pz, &vx, &vy, &vz);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   * Single parallel region encloses all iterations to reduce thread creation overhead.\n   */\n  #pragma omp parallel default(none) shared(px,py,pz,vx,vy,vz,nbodies)\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    body_force(px, py, pz, vx, vy, vz, DT, nbodies);\n\n    #pragma omp for schedule(static)\n    for (int i = 0; i < nbodies; ++i) {\n      px[i] += vx[i] * DT;\n      py[i] += vy[i] * DT;\n      pz[i] += vz[i] * DT;\n    }\n  }\n\n  write_dataset(nbodies, px, py, pz, vx, vy, vz);\n\n  free(px); free(py); free(pz);\n  free(vx); free(vy); free(vz);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Moving the OpenMP parallel region outside the iteration loop to reduce thread creation overhead while retaining all previous optimizations (SoA layout, restrict pointers, aligned allocation, self-interaction skip, SIMD reduction) will further improve performance.",

#include <iostream>
#include <cstdio>
#include <cassert>
#include <cstdlib>

int main() {
	std::ios_base::sync_with_stdio(false);
	std::cin.tie(nullptr);

	int n, s;
	std::cin >> n >> s;

	// Allocate contiguous aligned memory for the matrix (row-major)
	int *matrix = static_cast<int*>(aligned_alloc(64, sizeof(int) * n * n));
	if (!matrix) {
		std::cerr << "Memory allocation failed\n";
		return 1;
	}

	for (int i = 0; i < n; ++i)
		for (int j = 0; j < n; ++j)
			scanf("%d", &matrix[i * n + j]);

	assert(s < n);
	assert(n < 8000);
	assert(s > 0);
	assert(n > 0);

	int sum = 0;
	for (int i = 0; i < s; ++i)
#pragma omp simd reduction(+:sum)
		for (int j = 0; j < s; ++j)
			sum += matrix[i * n + j];

	int mxSum = sum;

	int dir = 1;
	int i = 0;
	int j = 0;
	while (i + s <= n) {
		if ((j + s == n && dir == 1) || (j == 0 && dir == -1)) {
			const int exitingRow = i;
			const int enteringRow = exitingRow + s;
			if (enteringRow >= n)
				break;

#pragma omp simd reduction(-:sum)
			for (int k = 0; k < s; ++k)
				sum -= matrix[exitingRow * n + j + k];
#pragma omp simd reduction(+:sum)
			for (int k = 0; k < s; ++k)
				sum += matrix[enteringRow * n + j + k];

			++i;
			dir *= -1;
		} else {
			const int exitingCol = (dir == 1) ? j : j + s - 1;
			const int enteringCol = (dir == 1) ? j + s : j - 1;

#pragma omp simd reduction(-:sum)
			for (int k = 0; k < s; ++k)
				sum -= matrix[(i + k) * n + exitingCol];
#pragma omp simd reduction(+:sum)
			for (int k = 0; k < s; ++k)
				sum += matrix[(i + k) * n + enteringCol];

			j += dir;
		}
		mxSum = std::max(mxSum, sum);
	}

	printf("%d\n", mxSum);
	free(matrix);
	return 0;
}
"""Create new durable submission intents, preserving all prior attempts."""
from pathlib import Path
BASE=Path(__file__).resolve().parents[3]
HERE=Path(__file__).resolve().parent
OLD=HERE.parent/'operations-parent'
t=(OLD/'preparer-intentions-natives.py').read_text('utf-8')
t=t.replace('revision-r1-lane-v2','revision-r3-attempt2')
t=t.replace('revue-factory/REVUE-INDEPENDANTE-FACTORY-R2D.json','revue-attempt2/REVUE-INDEPENDANTE-ATTEMPT2.json')
t=t.replace('49e275d6589238e5081724323775057be08c51b3309088944daf28362bc74cef','2c85b840eae1c335e2c3060f94c73c9fd994a605158316f31f5ce9b17ad58cc2')
t=t.replace('ref(HERE / "DECISION-HUMAINE-RELANCE-DISTINCTE.json")','ref(HERE / "DECISION-HUMAINE-RELANCE-DISTINCTE.json"),ref(HERE / "RECEPTION-TROIS-PREFLIGHTS-ZERO-MODELE.json")')
(HERE/'preparer-intentions-natives.py').write_text(t,'utf-8')
print('New parent intent helper written; no effect.')


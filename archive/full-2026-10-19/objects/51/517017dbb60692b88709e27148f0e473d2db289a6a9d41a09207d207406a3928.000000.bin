#include <cstdio>
#include <vector>
#ifdef _OPENMP
#include <omp.h>
#endif

namespace {

constexpr int MOD = 1000000007;

class FastInput {
    static constexpr std::size_t BUFFER_SIZE = 1 << 16;
    char buffer_[BUFFER_SIZE];
    std::size_t position_ = 0;
    std::size_t length_ = 0;

    char nextChar() {
        if (position_ == length_) {
            length_ = std::fread(buffer_, 1, BUFFER_SIZE, stdin);
            position_ = 0;
            if (length_ == 0) return '\0';
        }
        return buffer_[position_++];
    }

public:
    int readInt() {
        char c = nextChar();
        while (c <= ' ' && c != '\0') c = nextChar();
        int value = 0;
        while (c >= '0' && c <= '9') {
            value = value * 10 + (c - '0');
            c = nextChar();
        }
        return value;
    }
};

inline int addMod(int a, int b) {
    const int sum = a + b;
    return sum >= MOD ? sum - MOD : sum;
}

} // namespace

int main() {
    FastInput input;
    const int n = input.readInt();
    const int m = input.readInt();
    if (n <= 0) return 0;

    std::vector<std::vector<bool>> blockedCells(n, std::vector<bool>(n, false));
    for (int c = 0; c < m; ++c) {
        const int y = input.readInt();
        const int x = input.readInt();
        blockedCells[y][x] = true;
    }

    std::vector<int> dp(n, 0);
    if (!blockedCells[0][0]) dp[0] = 1;
    for (int j = 1; j < n; ++j) {
        dp[j] = blockedCells[0][j] ? 0 : dp[j - 1];
    }

#ifdef _OPENMP
    if (n >= 4096) {
        const int maxThreads = omp_get_max_threads();
        std::vector<int> localEnd(maxThreads);
        std::vector<int> incoming(maxThreads);
        std::vector<int> firstBlocked(maxThreads);
        std::vector<unsigned char> hasBlocked(maxThreads);
        int activeThreads = 1;

#pragma omp parallel shared(activeThreads, localEnd, incoming, firstBlocked, hasBlocked, dp, blockedCells)
        {
            const int tid = omp_get_thread_num();
            const int threadCount = omp_get_num_threads();

#pragma omp single
            activeThreads = threadCount;

            for (int i = 1; i < n; ++i) {
                const int lo = static_cast<int>((static_cast<long long>(n) * tid) / threadCount);
                const int hi = static_cast<int>((static_cast<long long>(n) * (tid + 1)) / threadCount);
                int value = 0;
                int first = hi;
                bool seenBlocked = false;

                for (int j = lo; j < hi; ++j) {
                    if (blockedCells[i][j]) {
                        dp[j] = 0;
                        if (!seenBlocked) first = j;
                        seenBlocked = true;
                        value = 0;
                    } else {
                        value = addMod(value, dp[j]);
                        dp[j] = value;
                    }
                }

                localEnd[tid] = value;
                firstBlocked[tid] = first;
                hasBlocked[tid] = static_cast<unsigned char>(seenBlocked);

#pragma omp barrier
#pragma omp single
                {
                    int prefix = 0;
                    for (int t = 0; t < activeThreads; ++t) {
                        incoming[t] = prefix;
                        prefix = hasBlocked[t] ? localEnd[t] : addMod(prefix, localEnd[t]);
                    }
                }

                const int offset = incoming[tid];
                for (int j = lo; j < firstBlocked[tid]; ++j) {
                    dp[j] = addMod(dp[j], offset);
                }

#pragma omp barrier
            }
        }
    } else
#endif
    {
        for (int i = 1; i < n; ++i) {
            for (int j = 0; j < n; ++j) {
                if (blockedCells[i][j]) {
                    dp[j] = 0;
                } else if (j != 0) {
                    dp[j] = addMod(dp[j], dp[j - 1]);
                }
            }
        }
    }

    std::printf("%d\n", dp[n - 1]);
    return 0;
}

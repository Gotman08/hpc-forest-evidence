{
  "src/solution.cpp": "#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    cin >> n >> m;\n\n    vector<vector<bool>> blockedCells(n, vector<bool>(n, false));\n    for (int c = 0; c < m; ++c) {\n        int i, j;\n        cin >> i >> j;\n        blockedCells[i][j] = true;\n    }\n\n    vector<int> dp(n, 0);\n    dp[0] = !blockedCells[0][0];\n\n    for (int i = 0; i < n; ++i) {\n        const vector<bool>& blockedRow = blockedCells[i];\n        if (blockedRow[0])\n            dp[0] = 0;\n\n        for (int j = 1; j < n; ++j) {\n            if (blockedRow[j]) {\n                dp[j] = 0;\n            } else {\n                int paths = dp[j] + dp[j - 1];\n                if (paths >= MOD)\n                    paths -= MOD;\n                dp[j] = paths;\n            }\n        }\n    }\n\n    cout << dp[n - 1] << '\\n';\n}\n"
}

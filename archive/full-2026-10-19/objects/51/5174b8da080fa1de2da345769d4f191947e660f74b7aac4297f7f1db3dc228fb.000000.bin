        "content": "#include \"knn.h\"\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\ntypedef struct {\n    float *distances;\n    char *labels;\n    size_t count;\n    size_t next;\n} KnnRun;\n\nstatic char knn_vote(char *labels, int k) {\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nstatic char knn_serial(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *) malloc(sizeof(char) * k);\n    float *distances = (float *) malloc(sizeof(float) * k);\n\n    for (int i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (int x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (int y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    char result = knn_vote(labels, k);\n    free(distances);\n    free(labels);\n    return result;\n}\n\nstatic int knn_build_run(int n_groups, const Group *groups, int k,\n                         Point to_evaluate, size_t skip, size_t remaining,\n                         KnnRun *run) {\n    const size_t capacity = remaining < (size_t) k ? remaining : (size_t) k;\n    if (capacity == 0) return 0;\n\n    run->distances = (float *) malloc(sizeof(float) * capacity);\n    run->labels = (char *) malloc(sizeof(char) * capacity);\n    if (run->distances == NULL || run->labels == NULL) return 1;\n\n    size_t used = 0;\n    for (int i = 0; i < n_groups && remaining > 0; i++) {\n        const Group g = groups[i];\n        const size_t length = g.length > 0 ? (size_t) g.length : 0;\n        if (skip >= length) {\n            skip -= length;\n            continue;\n        }\n\n        size_t end = length;\n        if (end - skip > remaining) end = skip + remaining;\n\n        for (size_t j = skip; j < end; j++) {\n            const float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            /* NaNs require the original, order-dependent scan. */\n            if (d != d) return 1;\n\n            if (used == capacity && !(d < run->distances[capacity - 1])) {\n                continue;\n            }\n\n            size_t position = used < capacity ? used : capacity - 1;\n            /* Strict comparison preserves input order for equal distances. */\n            while (position > 0 && d < run->distances[position - 1]) {\n                run->distances[position] = run->distances[position - 1];\n                run->labels[position] = run->labels[position - 1];\n                position--;\n            }\n            run->distances[position] = d;\n            run->labels[position] = g.label;\n            if (used < capacity) used++;\n        }\n\n        remaining -= end - skip;\n        skip = 0;\n    }\n\n    run->count = used;\n    return 0;\n}\n\nstatic void knn_free_runs(KnnRun *runs, int count) {\n    for (int i = 0; i < count; i++) {\n        free(runs[i].distances);\n        free(runs[i].labels);\n    }\n    free(runs);\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) return knn_serial(n_groups, groups, k, to_evaluate);\n\n    size_t total = 0;\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length > 0) total += (size_t) groups[i].length;\n    }\n\n    int workers = 1;\n#ifdef _OPENMP\n    const int available = omp_get_max_threads();\n    const size_t width = (size_t) k < 64 ? (size_t) k : 64;\n    const size_t grain = 65536 / width;\n    const size_t allowed_by_work = total / grain;\n    workers = allowed_by_work < (size_t) available\n                  ? (int) allowed_by_work : available;\n#endif\n    if (workers < 2) return knn_serial(n_groups, groups, k, to_evaluate);\n\n    KnnRun *runs = (KnnRun *) calloc((size_t) workers, sizeof(KnnRun));\n    if (runs == NULL) return knn_serial(n_groups, groups, k, to_evaluate);\n\n    const size_t base = total / (size_t) workers;\n    const size_t remainder = total % (size_t) workers;\n    int failed = 0;\n\n#ifdef _OPENMP\n#pragma omp parallel for num_threads(workers) schedule(static, 1) reduction(|:failed)\n#endif\n    for (int block = 0; block < workers; block++) {\n        const size_t b = (size_t) block;\n        const size_t begin = b * base + (b < remainder ? b : remainder);\n        const size_t count = base + (b < remainder ? 1 : 0);\n        failed |= knn_build_run(n_groups, groups, k, to_evaluate,\n                                begin, count, &runs[block]);\n    }\n\n    if (failed) {\n        knn_free_runs(runs, workers);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    char *labels = (char *) malloc(sizeof(char) * (size_t) k);\n    if (labels == NULL) {\n        knn_free_runs(runs, workers);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n    for (int i = 0; i < k; i++) labels[i] = -1;\n\n    for (int i = 0; i < k; i++) {\n        int best = -1;\n        for (int block = 0; block < workers; block++) {\n            const KnnRun *candidate = &runs[block];\n            if (candidate->next == candidate->count) continue;\n            /* Earlier blocks precede later blocks in the original input. */\n            if (best < 0 || candidate->distances[candidate->next] <\n                            runs[best].distances[runs[best].next]) {\n                best = block;\n            }\n        }\n        if (best < 0) break;\n        labels[i] = runs[best].labels[runs[best].next];\n        runs[best].next++;\n    }\n\n    knn_free_runs(runs, workers);\n    char result = knn_vote(labels, k);\n    free(labels);\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",

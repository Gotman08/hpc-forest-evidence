      "content": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <iterator>\n#include <string>\n\n#ifdef _OPENMP\n#include <omp.h>\n#include <vector>\n#endif\n\nnamespace\n{\nconst std::size_t kBufferBytes = 64u * 1024u;\n\nstruct IsWhitespace\n{\n    bool operator()(char c) const\n    {\n        return c == ' ' || c == '\\n' || c == '\\r'\n            || c == '\\t' || c == '\\f' || c == '\\v';\n    }\n};\n\nvoid append_line(std::string& output, const std::string& text)\n{\n    const std::size_t start = output.size();\n    output.resize(start + 2 * text.size() + 4);\n    char* destination = &output[start];\n    *destination++ = '[';\n    *destination++ = ' ';\n    for (std::size_t i = 0; i < text.size(); ++i) {\n        *destination++ = text[i];\n        *destination++ = ' ';\n    }\n    *destination++ = ']';\n    *destination = '\\n';\n}\n\nclass BufferedPrinter\n{\npublic:\n    BufferedPrinter()\n    {\n        buffer_.reserve(kBufferBytes);\n    }\n\n    void print(const std::string& text)\n    {\n        if (text.size() <= (kBufferBytes - 4) / 2) {\n            const std::size_t line_bytes = 2 * text.size() + 4;\n            if (line_bytes > kBufferBytes - buffer_.size())\n                flush();\n            append_line(buffer_, text);\n        } else {\n            put('[');\n            put(' ');\n            for (std::size_t i = 0; i < text.size(); ++i) {\n                put(text[i]);\n                put(' ');\n            }\n            put(']');\n            put('\\n');\n        }\n    }\n\n    void flush()\n    {\n        if (!buffer_.empty()) {\n            std::cout.write(buffer_.data(),\n                            static_cast<std::streamsize>(buffer_.size()));\n            buffer_.clear();\n        }\n    }\n\nprivate:\n    void put(char c)\n    {\n        if (buffer_.size() == kBufferBytes)\n            flush();\n        buffer_.push_back(c);\n    }\n\n    std::string buffer_;\n};\n\nvoid emit_serial(std::string& text)\n{\n    if (text.empty())\n        return;\n    BufferedPrinter printer;\n    do {\n        printer.print(text);\n    } while (std::next_permutation(text.begin(), text.end()));\n    printer.flush();\n}\n\n#ifdef _OPENMP\nstruct Symbol\n{\n    char value;\n    std::size_t remaining;\n};\n\nstd::size_t greatest_common_divisor(std::size_t a, std::size_t b)\n{\n    while (b != 0) {\n        const std::size_t remainder = a % b;\n        a = b;\n        b = remainder;\n    }\n    return a;\n}\n\nstd::size_t capped_binomial(std::size_t n, std::size_t k,\n                            std::size_t cap)\n{\n    if (cap <= 1)\n        return cap;\n    k = std::min(k, n - k);\n    std::size_t value = 1;\n    for (std::size_t i = 1; i <= k; ++i) {\n        std::size_t numerator = n - k + i;\n        std::size_t denominator = i;\n        const std::size_t divisor =\n            greatest_common_divisor(numerator, denominator);\n        numerator /= divisor;\n        denominator /= divisor;\n        // After cancellation, the denominator divides the previous value.\n        value /= denominator;\n        if (numerator > cap / value)\n            return cap;\n        value *= numerator;\n        if (value >= cap)\n            return cap;\n    }\n    return value;\n}\n\nstd::size_t capped_permutations(const std::vector<Symbol>& symbols,\n                               std::size_t cap)\n{\n    if (cap <= 1)\n        return cap;\n    std::size_t value = 1;\n    std::size_t used = 0;\n    for (std::size_t i = 0; i < symbols.size(); ++i) {\n        const std::size_t count = symbols[i].remaining;\n        if (count == 0)\n            continue;\n        used += count;\n        const std::size_t factor = capped_binomial(used, count, cap);\n        if (factor >= cap || value > (cap - 1) / factor)\n            return cap;\n        value *= factor;\n    }\n    return value;\n}\n\nstd::vector<Symbol> make_symbols(const std::string& text)\n{\n    std::vector<Symbol> symbols;\n    for (std::size_t i = 0; i < text.size(); ++i) {\n        if (symbols.empty() || symbols.back().value != text[i]) {\n            Symbol symbol = {text[i], 1};\n            symbols.push_back(symbol);\n        } else {\n            ++symbols.back().remaining;\n        }\n    }\n    return symbols;\n}\n\nstruct PrefixJob\n{\n    std::string text;\n    std::size_t prefix_length;\n};\n\nclass PrefixFrontier\n{\npublic:\n    PrefixFrontier(const std::vector<Symbol>& symbols,\n                   std::size_t length, std::size_t limit)\n        : symbols_(symbols), limit_(limit), done_(false)\n    {\n        prefix_.reserve(length);\n        path_.reserve(length);\n    }\n\n    bool next(PrefixJob& job)\n    {\n        if (done_)\n            return false;\n        while (capped_permutations(symbols_, limit_ + 1) > limit_) {\n            std::size_t symbol = 0;\n            while (symbols_[symbol].remaining == 0)\n                ++symbol;\n            --symbols_[symbol].remaining;\n            path_.push_back(symbol);\n            prefix_.push_back(symbols_[symbol].value);\n        }\n        job.prefix_length = prefix_.size();\n        job.text = prefix_;\n        for (std::size_t i = 0; i < symbols_.size(); ++i)\n            job.text.append(symbols_[i].remaining, symbols_[i].value);\n        done_ = !advance();\n        return true;\n    }\n\nprivate:\n    bool advance()\n    {\n        while (!path_.empty()) {\n            const std::size_t previous = path_.back();\n            path_.pop_back();\n            prefix_.pop_back();\n            ++symbols_[previous].remaining;\n            for (std::size_t next = previous + 1;\n                 next < symbols_.size(); ++next) {\n                if (symbols_[next].remaining != 0) {\n                    --symbols_[next].remaining;\n                    path_.push_back(next);\n                    prefix_.push_back(symbols_[next].value);\n                    return true;\n                }\n            }\n        }\n        return false;\n    }\n\n    std::vector<Symbol> symbols_;\n    std::string prefix_;\n    std::vector<std::size_t> path_;\n    std::size_t limit_;\n    bool done_;\n};\n\nbool emit_parallel(std::string& text)\n{\n    const int threads = std::min(4, omp_get_max_threads());\n    if (threads < 2 || text.size() > (kBufferBytes - 4) / 2)\n        return false;\n    const std::size_t line_bytes = 2 * text.size() + 4;\n    const std::size_t leaf_limit = kBufferBytes / line_bytes;\n    if (leaf_limit < 32)\n        return false;\n    const std::size_t minimum_permutations = std::max<std::size_t>(\n        4096u, (256u * 1024u + line_bytes - 1) / line_bytes);\n    const std::vector<Symbol> symbols = make_symbols(text);\n    if (capped_permutations(symbols, minimum_permutations)\n        < minimum_permutations)\n        return false;\n\n    PrefixFrontier frontier(symbols, text.size(), leaf_limit);\n    const int batch_capacity = 4 * threads;\n    std::vector<PrefixJob> jobs(batch_capacity);\n    int work_count = 0;\n\n#pragma omp parallel num_threads(threads) shared(frontier, jobs, work_count)\n    {\n        std::string output;\n        output.reserve(kBufferBytes);\n        while (true) {\n#pragma omp single\n            {\n                work_count = 0;\n                while (work_count < batch_capacity\n                       && frontier.next(jobs[work_count]))\n                    ++work_count;\n            }\n            if (work_count == 0)\n                break;\n#pragma omp for ordered schedule(dynamic, 1)\n            for (int index = 0; index < work_count; ++index) {\n                PrefixJob& job = jobs[index];\n                output.clear();\n                do {\n                    append_line(output, job.text);\n                } while (std::next_permutation(\n                    job.text.begin() + job.prefix_length, job.text.end()));\n#pragma omp ordered\n                {\n                    std::cout.write(\n                        output.data(),\n                        static_cast<std::streamsize>(output.size()));\n                }\n            }\n        }\n    }\n    return true;\n}\n#endif\n}\n\nint main()\n{\n    std::ios_base::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n    std::istreambuf_iterator<char> begin(std::cin), end;\n    std::string text(begin, end);\n    text.erase(std::remove_if(text.begin(), text.end(), IsWhitespace()),\n               text.end());\n    if (text.empty())\n        return 0;\n    std::sort(text.begin(), text.end());\n#ifdef _OPENMP\n    if (emit_parallel(text))\n        return 0;\n#endif\n    emit_serial(text);\n    return 0;\n}\n",
      "path": "src/permutations.cc"
    }

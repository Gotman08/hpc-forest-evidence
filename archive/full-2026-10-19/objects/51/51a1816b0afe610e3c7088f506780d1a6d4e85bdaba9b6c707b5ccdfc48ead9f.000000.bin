#include "knn.h"
#include <string.h>

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    // Count total points across all groups
    long total_points = 0;
    for (int i = 0; i < n_groups; i++) {
        total_points += groups[i].length;
    }

    // Flatten all points into separate arrays (SoA) for sequential access
    float *xs = (float *)malloc(total_points * sizeof(float));
    float *ys = (float *)malloc(total_points * sizeof(float));
    char *labels_flat = (char *)malloc(total_points * sizeof(char));

    long idx = 0;
    for (int i = 0; i < n_groups; i++) {
        Group g = groups[i];
        for (int j = 0; j < g.length; j++) {
            xs[idx] = g.points[j].x;
            ys[idx] = g.points[j].y;
            labels_flat[idx] = g.label;
            idx++;
        }
    }

    // Arrays for top-k distances and corresponding labels (sorted ascending)
    float *distances = (float *)malloc(k * sizeof(float));
    char *labels_topk = (char *)malloc(k * sizeof(char));
    int cur_k = 0;  // current number of elements in the arrays

    // Frequency histogram for labels (256 possible char values)
    int freq[256] = {0};

    float px = to_evaluate.x;
    float py = to_evaluate.y;

    for (long i = 0; i < total_points; i++) {
        float dx = xs[i] - px;
        float dy = ys[i] - py;
        float d = dx * dx + dy * dy;
        char lbl = labels_flat[i];

        if (cur_k < k) {
            // Insert in sorted order using binary search and memmove
            int left = 0, right = cur_k - 1;
            while (left <= right) {
                int mid = (left + right) / 2;
                if (distances[mid] > d)
                    right = mid - 1;
                else
                    left = mid + 1;
            }
            // Insert at position 'left'
            if (left < cur_k) {
                memmove(&distances[left + 1], &distances[left],
                        (cur_k - left) * sizeof(float));
                memmove(&labels_topk[left + 1], &labels_topk[left],
                        (cur_k - left) * sizeof(char));
            }
            distances[left] = d;
            labels_topk[left] = lbl;
            cur_k++;
            freq[(unsigned char)lbl]++;
        } else if (d < distances[k - 1]) {
            // Remove the farthest point (last element)
            unsigned char evicted_label = (unsigned char)labels_topk[k - 1];
            freq[evicted_label]--;

            // Find insertion position for new point
            int left = 0, right = k - 2;  // search in first k-1 elements
            while (left <= right) {
                int mid = (left + right) / 2;
                if (distances[mid] > d)
                    right = mid - 1;
                else
                    left = mid + 1;
            }
            // Shift elements from 'left' to k-2 one position right
            memmove(&distances[left + 1], &distances[left],
                    (k - 1 - left) * sizeof(float));
            memmove(&labels_topk[left + 1], &labels_topk[left],
                    (k - 1 - left) * sizeof(char));

            distances[left] = d;
            labels_topk[left] = lbl;
            freq[(unsigned char)lbl]++;
        }
    }

    // Find most frequent label with smallest character tie-breaker
    int max_count = 0;
    unsigned char best_label = 0;
    for (int i = 255; i >= 0; i--) {  // iterate descending to pick smaller on ties? Actually we want smallest char, so ascending scan works.
        if (freq[i] > max_count) {
            max_count = freq[i];
            best_label = (unsigned char)i;
        }
    }

    free(xs);
    free(ys);
    free(labels_flat);
    free(distances);
    free(labels_topk);

    return (char)best_label;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

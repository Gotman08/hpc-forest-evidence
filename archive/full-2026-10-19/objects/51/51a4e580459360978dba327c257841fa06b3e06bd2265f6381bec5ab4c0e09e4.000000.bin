      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nchar *bucket_sort(char *strings, int length, long int size,\n                  int offset, int nbuckets) {\n    char *buffer;\n    char *source = strings;\n    char *destination;\n    size_t counts[256];\n    size_t positions[256];\n    size_t record_width = (size_t)length;\n\n    (void)offset;\n    (void)nbuckets;\n\n    if (size <= 1 || length <= 1)\n        return strings;\n\n    if ((size_t)size > ((size_t)-1) / record_width) {\n        fprintf(stderr, \"Sort buffer size is too large\\n\");\n        exit(EXIT_FAILURE);\n    }\n\n    buffer = (char *)malloc((size_t)size * record_width);\n    if (buffer == NULL) {\n        fprintf(stderr, \"Unable to allocate sort buffer\\n\");\n        exit(EXIT_FAILURE);\n    }\n    destination = buffer;\n\n    for (int position = length - 2; position >= 0; position--) {\n        size_t next = 0;\n\n        memset(counts, 0, sizeof(counts));\n        for (long int i = 0; i < size; i++) {\n            size_t source_offset = (size_t)i * record_width;\n            unsigned char key = (unsigned char)source[source_offset + (size_t)position];\n            counts[key]++;\n        }\n\n        for (int key = 0; key < 256; key++) {\n            positions[key] = next;\n            next += counts[key];\n        }\n\n        for (long int i = 0; i < size; i++) {\n            size_t source_offset = (size_t)i * record_width;\n            unsigned char key = (unsigned char)source[source_offset + (size_t)position];\n            size_t destination_offset = positions[key]++ * record_width;\n            memcpy(destination + destination_offset, source + source_offset, record_width);\n        }\n\n        char *temporary = source;\n        source = destination;\n        destination = temporary;\n    }\n\n    if (source == strings)\n        free(buffer);\n\n    return source;\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb) {\n    char *strings = NULL;\n    int len;\n    int offset;\n    int nbucket;\n    long int n;\n\n    if (fscanf(stdin, \"%d\", &len) != 1) {\n        printf(\"ERROR len\\n\");\n        exit(1);\n    }\n    if (fscanf(stdin, \"%ld\", &n) != 1) {\n        printf(\"ERROR n\\n\");\n        exit(1);\n    }\n    if (fscanf(stdin, \"%d\", &offset) != 1) {\n        printf(\"ERROR offset\\n\");\n        exit(1);\n    }\n    if (fscanf(stdin, \"%d\", &nbucket) != 1) {\n        printf(\"ERROR nbucket\\n\");\n        exit(1);\n    }\n\n    nbucket = nbucket + 1;\n    len = len + 1;\n    strings = (char *)calloc((size_t)n, (size_t)len);\n    if (strings == NULL && n > 0) {\n        fprintf(stderr, \"Unable to allocate input strings\\n\");\n        exit(EXIT_FAILURE);\n    }\n\n    for (long int i = 0; i < n; i++) {\n        if (fscanf(stdin, \"%s\", strings + (size_t)i * (size_t)len) != 1) {\n            printf(\"ERROR %ld\\n\", i);\n            exit(1);\n        }\n    }\n\n    *vString = strings;\n    *N = n;\n    *l = len;\n    *os = offset;\n    *nb = nbucket;\n}\n\nvoid save(char *strings, long int n, int len) {\n    for (long int i = 0; i < n; i++)\n        printf(\"%s\\n\", strings + (size_t)i * (size_t)len);\n}\n\nint main(void) {\n    char *strings = NULL;\n    char *ordered = NULL;\n    long int N = 0;\n    int len = 0;\n    int offset;\n    int nbuckets;\n\n    load(&strings, &N, &len, &offset, &nbuckets);\n    ordered = bucket_sort(strings, len, N, offset, nbuckets);\n    save(ordered, N, len);\n\n    if (ordered != strings)\n        free(ordered);\n    free(strings);\n\n    return EXIT_SUCCESS;\n}\n",
      "path": "src/bucketsort.c"
    }
  ],
  "hypothesis": "Stable LSD counting passes over each record’s payload bytes should avoid the baseline’s potentially quadratic per-bucket insertion sorting. Zero-initialized records preserve strcmp ordering for variable-length strings.",

e;\\n+\\n+static int candidate_precedes(const Candidate *a, const Candidate *b) {\\n+    if (a->distance < b->distance) return 1;\\n+    if (a->distance > b->distance) return 0;\\n+    return a->order < b->order;\\n+}\\n+\\n+static int compare_candidates(const void *left, const void *right) {\\n+    const Candidate *a = (const Candidate *)left;\\n+    const Candidate *b = (const Candidate *)right;\\n+    if (candidate_precedes(a, b)) return -1;\\n+    if (candidate_precedes(b, a)) return 1;\\n+    return 0;\\n+}\\n+\\n+/* Keep the worst retained candidate at the root for inexpensive replacement. */\\n+static void heap_offer(Candidate *heap, size_t *count, size_t capacity,\\n+                      Candidate value) {\\n+    if (*count < capacity) {\\n+        size_t pos = (*count)++;\\n+        while (pos > 0) {\\n+            size_t parent = (pos - 1) / 2;\\n+            if (!candidate_precedes(&heap[parent], &value)) break;\\n+            heap[pos] = heap[parent];\\n+            pos = parent;\\n+        }\\n+        heap[pos] = value;\\n+    } else if (candidate_precedes(&value, &heap[0])) {\\n+        size_t pos = 0;\\n+        for (;;) {\\n+            size_t left = pos * 2 + 1;\\n+            if (left >= *count) break;\\n+            size_t worse = left;\\n+            size_t right = left + 1;\\n+            if (right < *count &&\\n+                candidate_precedes(&heap[left], &heap[right])) {\\n+                worse = right;\\n+            }\\n+            if (!candidate_precedes(&value, &heap[worse])) break;\\n+            heap[pos] = heap[worse];\\n+            pos = worse;\\n+        }\\n+        heap[pos] = value;\\n+    }\\n+}\\n+\\n+char knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n+    size_t *offsets = (size_t *)malloc(((size_t)n_groups + 1) * sizeof(*offsets));\\n+    offsets[0] = 0;\\n+    for (int i = 0; i < n_groups; i++) {\\n+        offsets[(size_t)i + 1] = offsets[(size_t)i] + (size_t)groups[i].length;\\n+    }\\n+    size_t total_points = offsets[(size_t)n_groups];\\n+    size_t requested = (size_t)k;\\n+    size_t selected = total_points < requested ? total_points : requested;\\n+\\n+    char *labels = (char *)malloc(requested * sizeof(*labels));\\n+    for (size_t i = 0; i < requested; i++) labels[i] = (char)-1;\\n+\\n+    if (selected > 0) {\\n+        int max_threads = omp_get_max_threads();\\n+        if (max_threads < 1) max_threads = 1;\\n+        size_t thread_slots = (size_t)max_threads;\\n+        Candidate **heaps = (Candidate **)calloc(thread_slots, sizeof(*heaps));\\n+        size_t *counts = (size_t *)calloc(thread_slots, sizeof(*counts));\\n+        size_t *positions = (size_t *)calloc(thread_slots, sizeof(*positions));\\n+\\n+        /* Contiguous, balanced ranges give static scheduling without point-level\\n+           scheduling overhead; each worker reduces into its private top-k heap. */\\n+        #pragma omp parallel\\n+        {\\n+            int thread_id = omp_get_thread_num();\\n+            size_t team_size = (size_t)omp_get_num_threads();\\n+            size_t tid = (size_t)thread_id;\\n+            size_t quotient = total_points / team_size;\\n+            size_t remainder = total_points % team_size;\\n+            size_t begin = quotient * tid + (tid < remainder ? tid : remainder);\\n+            size_t local_length = quotient + (tid < remainder ? 1 : 0);\\n+            size_t local_capacity = local_length < selected ? local_length : selected;\\n+            Candidate *heap = local_capacity > 0\\n+                ? (Candidate *)malloc(local_capacity * sizeof(*heap))\\n+                :\"}, {\"id\": \"15f2d13cfab34265\", \"role\": \"C\", \"commit\": \"5540685c59d581781a1b5788f03e516bbb133e2c\", \"transformations\": {\"files\": [\"src/knn.c\"], \"retained\": [\"Added an adaptive path for large point sets and relatively large k, with a serial fallback for smaller regimes.\", \"Flattened point records and computed squared distances using an OpenMP static work-sharing loop.\", \"Sorted candidate records by distance and original encounter order, then reused the baseline label-voting behavior.\"]}, \"mean_seconds\": 0.034361946396529675, \"diff\": \"diff --git a/src/knn.c b/src/knn.c\\nindex 337e3b9..56a85d5 100644\\n--- a/src/knn.c\\n+++ b/src/knn.c\\n@@ -1,78 +1,164 @@\\n-#include \\\"knn.h\\\"\\n-\\n-char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n-    char * labels = (char *) malloc(sizeof(char) * k);\\n-    float * distances = (float *) malloc(sizeof(float) * k);\\n-\\n-    int i, j, x, y;\\n-\\n-    for (i = 0; i < k; i++) {\\n-        labels[i] = -1;\\n-        distances[i] = -1;\\n-    }\\n-\\n-    for (i = 0; i < n_groups; i++) {\\n-        Group g = groups[i];\\n-\\n-        for (j = 0; j < g.length; j++) {\\n-            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n-\\n-            for (x = 0; x < k; x++) {\\n-                if (d < distances[x] || distances[x] == -1) {\\n-                    for (y = k - 1; y > x; y--) {\\n-                        distances[y] = distances[y - 1];\\n-                        labels[y] = labels[y - 1];\\n-                    }\\n-\\n-                    distances[x] = d;\\n-                    labels[x] = g.label;\\n-\\n-                    break;\\n-                }\\n-            }\\n-        }\\n-    }\\n-\\n-    qsort(labels, k, sizeof(char), compare_for_sort);\\n-\\n-    char most_frequent = labels[0];\\n-    int most_frequent_count = 1;\\n-    int current_frequency = 1;\\n-\\n-    for (i = 1; i < k; i++) {\\n-        if (labels[i] != labels[i - 1]) {\\n-            if (current_frequency > most_frequent_count) {\\n-                most_frequent = labels[i - 1];\\n-                most_frequent_count = current_frequency;\\n-            }\\n-\\n-            current_frequency = 1;\\n-        } else {\\n-            current_frequency++;\\n-        }\\n-\\n-        if (i == k - 1 && current_frequency > most_frequent_count) {\\n-            most_frequent = labels[i - 1];\\n-            most_frequent_count = current_frequency;\\n-        }\\n-    }\\n-\\n-\\n-    return most_frequent;\\n-}\\n-\\n-int main() {\\n-    int n_groups = parse_number_of_groups();\\n-    \\n-    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n-\\n-    for (int i = 0; i < n_groups; i++) {\\n-        groups[i] = parse_next_group();\\n-    }\\n-\\n-    int k = parse_k();\\n-\\n-    Point to_evaluate = parse_point();\\n-\\n-    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n-}\\n\\\\ No newline at end of file\\n+#include \\\"knn.h\\\"\\n+#include <stdint.h>\\n+#include <stddef.h>\\n+\\n+typedef struct {\\n+    float distance;\\n+    size_t order;\\n+    char label;\\n+} Candidate;\\n+\\n+static int compare_candidates(const void *a, const void *b) {\\n+    const Candidate *left = (const Candidate *)a;\\n+    const Candidate *right = (const Candidate *)b;\\n+\\n+    if (left->distance < right->distance) return -1;\\n+    if (left->distance > right->distance) return 1;\\n+    if (left->order < right->order) return -1;\\n+    if (left->order > right->order) return 1;\\n+    return 0;\\n+}\\n+\\n+static char choose_label(char *labels, int k) {\\n+    int i;\\n+    qsort(labels, k, sizeof(char), compare_for_sort);\\n+\\n+    char most_frequent = labels[0];\\n+    int most_frequent_count = 1;\\n+    int current_frequency = 1;\\n+\\n+    for (i = 1; i < k; i++) {\\n+        if (labels[i] != labels[i - 1]) {\\n+            if (current_frequency > most_frequent_count) {\\n+                most_frequent = labels[i - 1];\\n+                most_frequent_count = current_frequency;\\n+            }\\n+            current_frequency = 1;\\n+        } else {\\n+            current_frequency++;\\n+        }\\n+\\n+        if (i == k - 1 && current_frequency > most_frequent_count) {\\n+            most_frequent = labels[i - 1];\\n+            most_frequent_count = current_frequency;\\n+        }\\n+    }\\n+\\n+    return most_frequent;\\n+}\\n+\\n+static char knn_serial(int n_groups, Group *groups, int k, Point to_evaluate) {\\n+    char *labels = (char *)malloc(sizeof(char) * k);\\n+    float *distances = (float *)malloc(sizeof(float) * k);\\n+    int i, j, x, y;\\n+\\n+    for (i = 0; i < k; i++) {\\n+        labels[i] = -1;\\n+        distances[i] = -1;\\n+    }\\n+\\n+    for (i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+\\n+        for (j = 0; j < g.length; j++) {\\n+            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n+\\n+            for (x = 0; x < k; x++) {\\n+                if (d < distances[x] || distances[x] == -1) {\\n+                    for (y = k - 1; y > x; y--) {\\n+                        distances[y] = distances[y - 1];\\n+                        labels[y] = labels[y - 1];\\n+                    }\\n+                    distances[x] = d;\\n+                    labels[x] = g.label;\\n+                    break;\\n+                }\\n+            }\\n+        }\\n+    }\\n+\\n+    char result = choose_label(labels, k);\\n+    free(labels);\\n+    free(distances);\\n+    return result;\\n+}\\n+\\n+char knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n+    size_t total_points = 0;\\n+    int can_count_points = 1;\\n+\\n+    for (int i = 0; i < n_groups; i++) {\\n+        if (groups[i].length < 0 ||\\n+            (size_t)groups[i].length > SIZE_MAX - total_points) {\\n+            can_count_points = 0;\\n+            break;\\n+        }\\n+        total_points += (size_t)groups[i].length;\\n+    }\\n+\\n+    size_t log_cutoff = 0;\\n+    for (size_t remaining = total_points; remaining > 1;\\n+         remaining = remaining / 2 + remaining % 2) {\\n+        log_cutoff++;\\n+    }\\n+    if (log_cutoff < 16) log_cutoff = 16;\\n+\\n+    if (can_count_points && k > 0 && total_points >= 4096 &&\\n+        (size_t)k >= log_cutoff && (size_t)k <= total_points &&\\n+        total_points <= SIZE_MAX / sizeof(Candidate) &&\\n+        total_points <= SIZE_MAX / sizeof(Point)) {\\n+        Candidate *candidates =\\n+            (Candidate *)malloc(sizeof(Candidate) * total_points);\\n+        Point *points = (Point *)malloc(sizeof(Point) * total_points);\\n+        char *labels = (char *)malloc(sizeof(char) * k);\\n+\\n+        if (candidates != NULL && points != NULL && labels != NULL) {\\n+            size_t at = 0;\\n+            for (int i = 0; i < n_groups; i++) {\\n+                for (int j = 0; j < groups[i].length; j++) {\\n+                    points[at] = groups[i].points[j];\\n+                    candidates[at\"}, {\"id\": \"b8ef4612bfa446e5\", \"role\": \"B\", \"commit\": \"c1c16d13b0931febbcf6245fd58066cd35d7d128\", \"transformations\": {\"files\": [\"src/knn.c\"], \"retained\": [\"Restore the scalar early-exit scan for the first eligible top-k slot, preserving the same strict comparison and encounter-order tie behavior.\", \"Replace the descending overlapping shifts of the distance and label arrays with memmove calls, guarded when there is no tail to shift.\"]}, \"mean_seconds\": 2.013328521512449, \"diff\": \"diff --git a/src/knn.c b/src/knn.c\\nindex 337e3b9..e3331b0 100644\\n--- a/src/knn.c\\n+++ b/src/knn.c\\n@@ -1,78 +1,85 @@\\n-#include \\\"knn.h\\\"\\n-\\n-char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n-    char * labels = (char *) malloc(sizeof(char) * k);\\n-    float * distances = (float *) malloc(sizeof(float) * k);\\n-\\n-    int i, j, x, y;\\n-\\n-    for (i = 0; i < k; i++) {\\n-        labels[i] = -1;\\n-        distances[i] = -1;\\n-    }\\n-\\n-    for (i = 0; i < n_groups; i++) {\\n-        Group g = groups[i];\\n-\\n-        for (j = 0; j < g.length; j++) {\\n-            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n-\\n-            for (x = 0; x < k; x++) {\\n-                if (d < distances[x] || distances[x] == -1) {\\n-                    for (y = k - 1; y > x; y--) {\\n-                      
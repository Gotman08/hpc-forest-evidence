{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <omp.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Compute the gravitational impact among all pairs of bodies in \n * the system for a contiguous range [start, end) of body indices.\n */\nvoid body_force(Body *p, float dt, int n, int start, int end) {\n  for (int i = start; i < end; ++i) {\n    float fx = 0.0f; \n    float fy = 0.0f; \n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3; \n      fy += dy * inv_dist3; \n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx; \n    p[i].vy += dt*fy; \n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  #pragma omp parallel\n  {\n    int tid = omp_get_thread_num();\n    int nthreads = omp_get_num_threads();\n    // Contiguous chunk size for manual partitioning\n    int chunk = (nbodies + nthreads - 1) / nthreads;\n    int start, end;\n\n    for (int iter = 0; iter < N_ITER; ++iter) {\n      // Force computation on this thread's contiguous range\n      start = tid * chunk;\n      end = start + chunk;\n      if (end > nbodies) end = nbodies;\n      body_force(bodies, DT, nbodies, start, end);\n\n      #pragma omp barrier\n\n      // Position integration on this thread's contiguous range\n      start = tid * chunk;\n      end = start + chunk;\n      if (end > nbodies) end = nbodies;\n      for (int i = start; i < end; ++i) {\n        bodies[i].x += bodies[i].vx * DT;\n        bodies[i].y += bodies[i].vy * DT;\n        bodies[i].z += bodies[i].vz * DT;\n      }\n\n      #pragma omp barrier\n    }\n  } // implicit barrier at end of parallel region\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n  \n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Using a single OpenMP parallel region across all simulation iterations with manual contiguous partitioning for both force and position loops reduces thread-team creation overhead and worksharing scheduling cost while preserving deterministic per-body accumulation order, improving performance on 4 cores compared to separate parallel regions or worksharing constructs.",
  "notes": "The code preserves the exact sequential floating-point accumulation order for each body (j loop remains in increasing index order). Manual contiguous chunks improve cache locality on position writes and avoid OpenMP worksharing overhead. Barriers ensure correct dependencies between force computation, position update, and subsequent iterations.",
  "sources_kept": [],

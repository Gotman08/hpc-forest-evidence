#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <inttypes.h>

#define MAXNUM 1000
#define MAXSTR 50
#define MAXRESULTS 1000

typedef struct {
    uint32_t value;
    uint32_t scale;
} Fragment;

static uint32_t firstHalf[MAXNUM];
static Fragment secondHalf[MAXNUM];
static uint32_t result[MAXRESULTS];

static int read_fragment(uint32_t *value, uint32_t *scale)
{
    char text[MAXSTR];
    uint32_t number = 0;
    uint32_t decimal_scale = 1;

    if (scanf("%49s", text) != 1)
        return 0;
    for (const char *p = text; *p; ++p) {
        unsigned int digit = (unsigned int)(*p - '0');
        if (digit > 9u || number > (UINT32_MAX - digit) / 10u)
            return 0;
        number = number * 10u + digit;
        if (scale != NULL) {
            if (decimal_scale > UINT32_MAX / 10u)
                return 0;
            decimal_scale *= 10u;
        }
    }
    *value = number;
    if (scale != NULL)
        *scale = decimal_scale;
    return 1;
}

static uint32_t integer_sqrt(uint32_t value)
{
    uint32_t root = 0;
    for (uint32_t bit = 1u << 15; bit != 0; bit >>= 1) {
        uint32_t trial = root | bit;
        if ((uint64_t)trial * trial <= value)
            root = trial;
    }
    return root;
}

static uint16_t *build_divisors(uint32_t limit, size_t *count)
{
    size_t slots = (size_t)(limit / 2u) + 1u;
    unsigned char *composite = calloc(slots, sizeof *composite);
    uint16_t *divisors = malloc(slots * sizeof *divisors);

    *count = 0;
    if (composite == NULL || divisors == NULL) {
        free(composite);
        free(divisors);
        return NULL;
    }
    for (uint32_t factor = 3; (uint64_t)factor * factor <= limit; factor += 2) {
        if (!composite[factor / 2u]) {
            for (uint32_t multiple = factor * factor;
                 multiple <= limit; multiple += 2u * factor)
                composite[multiple / 2u] = 1;
        }
    }
    for (uint32_t factor = 3; factor <= limit; factor += 2) {
        if (!composite[factor / 2u])
            divisors[(*count)++] = (uint16_t)factor;
    }
    free(composite);
    return divisors;
}

static int isprime(uint32_t value, const uint16_t *divisors, size_t count)
{
    if (value < 2)
        return 0;
    if ((value & 1u) == 0)
        return value == 2;
    for (size_t i = 0; i < count; ++i) {
        uint32_t factor = divisors[i];
        if ((uint64_t)factor * factor > value)
            break;
        if (value % factor == 0)
            return 0;
    }
    return 1;
}

static void quicksort(uint32_t *primes, int first, int last)
{
    int i, j, pivot;
    uint32_t temp;

    if (first < last) {
        pivot = first;
        i = first;
        j = last;
        while (i < j) {
            while (primes[i] <= primes[pivot] && i < last)
                i++;
            while (primes[j] > primes[pivot])
                j--;
            if (i < j) {
                temp = primes[i];
                primes[i] = primes[j];
                primes[j] = temp;
            }
        }
        temp = primes[pivot];
        primes[pivot] = primes[j];
        primes[j] = temp;
        quicksort(primes, first, j - 1);
        quicksort(primes, j + 1, last);
    }
}

int main(void)
{
    int numPrimes = 0;
    int numResults = 0;
    uint32_t maximum_left = 0;
    uint32_t maximum = 0;
    size_t divisor_count = 0;

    if (scanf("%d", &numPrimes) != 1 || numPrimes < 1 || numPrimes > MAXNUM)
        return 0;
    for (int i = 0; i < numPrimes; ++i) {
        if (!read_fragment(&firstHalf[i], NULL))
            return 0;
        if (firstHalf[i] > maximum_left)
            maximum_left = firstHalf[i];
    }
    for (int j = 0; j < numPrimes; ++j) {
        if (!read_fragment(&secondHalf[j].value, &secondHalf[j].scale))
            return 0;
        uint64_t joined = (uint64_t)maximum_left * secondHalf[j].scale
                        + secondHalf[j].value;
        if (joined > UINT32_MAX)
            return 1;
        if (joined > maximum)
            maximum = (uint32_t)joined;
    }

    uint16_t *divisors = build_divisors(integer_sqrt(maximum), &divisor_count);
    if (divisors == NULL)
        return 1;

    for (int i = 0; i < numPrimes; ++i) {
        uint32_t left = firstHalf[i];
        for (int j = 0; j < numPrimes; ++j) {
            uint32_t candidate = left * secondHalf[j].scale + secondHalf[j].value;
            if (isprime(candidate, divisors, divisor_count)) {
                if (numResults == MAXRESULTS) {
                    free(divisors);
                    return 1;
                }
                result[numResults++] = candidate;
            }
        }
    }
    free(divisors);

    quicksort(result, 0, numResults - 1);
    for (int i = 0; i < numResults; ++i)
        printf("%" PRIu32 "\n", result[i]);
    return 0;
}

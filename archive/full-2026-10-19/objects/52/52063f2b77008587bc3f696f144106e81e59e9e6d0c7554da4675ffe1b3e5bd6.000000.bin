{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <cstddef>\\n#include <iostream>\\n#include <utility>\\n#include <vector>\\n\\nusing namespace std;\\n\\nclass adjacency_matrix {\\npublic:\\n    explicit adjacency_matrix(std::size_t vertices = 0)\\n        : vertices_(vertices), cells_(vertices * vertices, 0) {\\n    }\\n\\n    std::size_t size() const {\\n        return vertices_;\\n    }\\n\\n    unsigned char *row(std::size_t vertex) {\\n        return cells_.data() + vertex * vertices_;\\n    }\\n\\n    const unsigned char *data() const {\\n        return cells_.data();\\n    }\\n\\nprivate:\\n    std::size_t vertices_;\\n    vector<unsigned char> cells_;\\n};\\n\\nadjacency_matrix readGraph();\\n\\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2);\\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\\n                       const vector<int> &equivalence);\\ninline void printPermutation(const vector<int> &equivalence);\\n\\nint main(){\\n    adjacency_matrix g1 = readGraph();\\n    adjacency_matrix g2 = readGraph();\\n\\n    if(!testIsomorphism(g1, g2))\\n        cout << \\\"The graphs are not isomorphic\\\" << endl;\\n\\n    return 0;\\n}\\n\\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2){\\n    vector<int> equivalence(g1.size(), 0);\\n    vector<int> exchange_counter(g1.size(), 0);\\n    int exchange_index = 1;\\n    bool isomorphism_found = false;\\n\\n    if(g1.size() != g2.size()) return false;\\n\\n    const int vertices = static_cast<int>(equivalence.size());\\n    for(int i = 0; i < vertices; ++i)\\n        equivalence[i] = i;\\n\\n    if(verifyPermutation(g1, g2, equivalence)){\\n        printPermutation(equivalence);\\n        return true;\\n    }\\n\\n    while(exchange_index < vertices){\\n        if(exchange_counter[exchange_index] < exchange_index){\\n            if(exchange_index % 2 == 0)\\n                swap(equivalence[0], equivalence[exchange_index]);\\n            else\\n                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\\n            if(verifyPermutation(g1, g2, equivalence)){\\n                printPermutation(equivalence);\\n                isomorphism_found = true;\\n            }\\n\\n            exchange_counter[exchange_index]++;\\n            exchange_index = 1;\\n        }else{\\n            exchange_counter[exchange_index] = 0;\\n            exchange_index++;\\n        }\\n    }\\n    return isomorphism_found;\\n}\\n\\nadjacency_matrix readGraph(){\\n    int vertices, edges, source, destination;\\n\\n    cin >> vertices;\\n    adjacency_matrix read(static_cast<std::size_t>(vertices));\\n\\n    cin >> edges;\\n    for (int i = 0; i < edges; i++) {\\n       cin >> source >> destination;\\n       unsigned char *const source_row = read.row(static_cast<std::size_t>(source));\\n       unsigned char *const destination_row = read.row(static_cast<std::size_t>(destination));\\n       source_row[destination] = 1;\\n       destination_row[source] = 1;\\n    }\\n\\n    return read;\\n}\\n\\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\\n                       const vector<int> &equivalence){\\n    const std::size_t vertices = equivalence.size();\\n    const std::size_t stride = g1.size();\\n    const unsigned char *const first = g1.data();\\n    const unsigned char *const second = g2.data();\\n    const int *const mapping = equivalence.data();\\n\\n    for (std::size_t i = 0; i < vertices; ++i) {\\n        const unsigned char *first_value = first + i * stride;\\n        const unsigned char *const second_row =\\n            second + static_cast<std::size_t>(mapping[i]) * stride;\\n        for (std::size_t j = 0; j <= i; ++j) {\\n            if (*first_value++ != second_row[mapping[j]]) return false;\\n        }\\n    }\\n    return true;\\n}\\n\\ninline void printPermutation(const vector<int> &equivalence){\\n    for (auto i : equivalence)\\n        cout << i << \\\" \\\";\\n    cout << endl;\\n}\\n\",\"path\":\"src/brute_isomorphism.cpp\"}],\"hypothesis\":\"A flat row-major byte adjacency matrix removes vector<bool> proxy work and fragmented row allocations, while sequentially walking each tested source-row prefix improves cache locality during permutation verification.\",\"notes\":\"Preserves the original Heap permutation order and its output behavior, including printing every matching non-identity permutation.\",\"sources_kept\":[],\"transformations\":[\"Replace vector<vector<bool>> with one contiguous row-major byte matrix.\",\"Use cached flat row bases and pointer traversal for the lower-triangular verification loop.\"]}"}}

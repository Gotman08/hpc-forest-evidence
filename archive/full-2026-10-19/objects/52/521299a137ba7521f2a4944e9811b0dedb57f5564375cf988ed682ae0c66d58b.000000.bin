"""Preserve the real old CLI comparison refusal and emit only incomplete terminal-audit templates."""
from __future__ import annotations

import json
from pathlib import Path

import audit_context as context
import audit_r2_native
from audit_cli_namespaces import verify_cli_namespaces

OUT = Path(__file__).resolve().parent
BASE = OUT.parents[2]
LAUNCH = BASE / "outputs/HPC-Forest-Primes-Natif-Lancement-r2b"


def ref(path):
    return {"path": str(path), "sha256": context.sha(path.read_bytes())}


def save(name, value):
    path = OUT / name
    with path.open("x", encoding="utf8", newline="\n") as stream:
        stream.write(json.dumps(value, ensure_ascii=False, indent=2) + "\n")
    return path


comparisons = []
namespace_graphs = []
for slug, model in (("astra-max", "gpt-6-astra"), ("terra-max", "gpt-5.6-terra"), ("sol-max", "gpt-6.1-sol")):
    admissions = LAUNCH / "revision-r6-commandes" / ("admissions-" + slug + "-reelles")
    operations = LAUNCH / "operations-parent-max4" / slug
    left, right = admissions / "local/cli-identity.json", admissions / "remote/cli_identity.json"
    controller, worker = json.loads(left.read_bytes()), json.loads(right.read_bytes())
    differing = {key for key in set(controller) | set(worker) if controller.get(key) != worker.get(key)}
    if differing != {"evidence_refs"}:
        raise RuntimeError("The real narrow CLI namespace defect differs: " + model)
    comparisons.append({"model": model, "controller_cli_original": ref(left), "worker_cli_original": ref(right),
        "old_whole_json_comparison_passed": False, "only_different_fields": sorted(differing),
        "native_research_admitted": False})
    submitted = json.loads((operations / "submission-observed.json").read_bytes())
    submitted = submitted.get("structuredContent", submitted)
    job = submitted["job_id"]
    matrix_refs = {"upload_manifest": ref(admissions / "upload-manifest-propose.json"),
        "publication": ref(admissions / "publication-locale/publication-arguments.json"),
        "download_receipt": ref(operations / "directory-readback-result.json")}
    expected_cell = {"scope_id": context.SCOPE_VALUE, "model": model, "effort": "max", "job_id": job,
        "session_id": context.CELLS[model], "source_zip_sha256": context.SOURCE_VALUE, "plan_sha256": context.PLAN_VALUE}
    authorizations = {"controller": json.loads((admissions / "authorization-local.json").read_bytes()),
        "worker": json.loads((admissions / "authorization-remote.json").read_bytes())}
    protected, graph = verify_cli_namespaces({"admission_namespace_aliases": matrix_refs}, expected_cell,
        {"controller": {"cli_identity": controller}, "worker": {"cli_identity": worker}}, authorizations)
    if not all(context.sha(Path(path).read_bytes()) == expected for path, expected in protected):
        raise RuntimeError("Actual namespace graph metadata changed while being read")
    namespace_graphs.append({**expected_cell, "verification_scope": "Received admission CLI reference graph only",
        "verified_reference_graph_only": True, "native_research_admitted": False,
        "actual_original_refs": matrix_refs, "facts": graph,
        "protected_files": [{"path": path, "sha256": expected} for path, expected in protected]})
    template = save("ATTENTE-TERMINALE-" + model + "-NON-ADMISE.json", {
        "schema": "hpc-forest-primes-r2c-native-cell-audit-expectation-v2", "scope_id": context.SCOPE_VALUE,
        "model": model, "effort": "max", "session_id": context.CELLS[model], "job_id": job,
        "remote_root": "/scratch_p/nimarano/" + context.SCOPE_VALUE + "-" + context.CELLS[model],
        "cache_source_root": context.CACHE_PARENT + "/worker-" + context.CELLS[model],
        "source_zip_sha256": context.SOURCE_VALUE, "plan_sha256": context.PLAN_VALUE,
        "verified": False, "status": "actual_submission_known_terminal_audit_binding_not_admitted",
        "actual_submission_observed": ref(operations / "submission-observed.json"),
        "scheduler_observation": None, "controller_authorization": None, "worker_authorization": None,
        "controller_admission_copies": None, "worker_admission_copies": None,
        "admission_namespace_aliases": matrix_refs,
        "native_research_admitted": False, "independent_raw_stdout_per_candidate_verified": False,
        "independent_performance_audit_verified": False})
    output = OUT / ("refus-attente-terminale-" + model + ".json")
    args = ["--binding", str(template), "--output", str(output)]
    for flag in ("root", "cache", "reception", "cache-receipt", "source-zip", "plan", "certified"):
        args.extend(["--" + flag, str(OUT / ("NEVER-READ-" + model + "-" + flag))])
    if audit_r2_native.main(args) != 1:
        raise RuntimeError("Incomplete terminal binding did not refuse before data access")
    refusal = json.loads(output.read_bytes())
    if refusal.get("verified") is not False or "exact path/SHA ref required" not in refusal.get("audit_error", ""):
        raise RuntimeError("Unexpected incomplete terminal-binding refusal")
save("refus-cli-integral-original-conserve.json", {"schema": "hpc-forest-cli-namespace-original-static-refusal-v1",
    "verified": False, "scope": "Actual original JSON comparison only; no terminal/native audit or current job state inferred",
    "comparisons": comparisons, "original_admission_files_modified": False,
    "models_called_or_jobs_replayed": 0})
save("matrices-aliases-CLI-recues.json", {"schema": "hpc-forest-r2c-received-cli-reference-graphs-v1",
    "verified": False, "verification_scope": "Original admission metadata and received file mirrors only",
    "cells": namespace_graphs, "native_research_admitted": False,
    "native_cohorts_audited": 0, "native_model_calls": 0})
print(json.dumps({"three_original_cli_json_comparison_refusals_preserved": True,
    "three_incomplete_terminal_audit_bindings_really_refused": True, "native_research_admitted": False}))

#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>

int main() {
	int n, s;
	std::cin >> n >> s;
	assert(s > 0 && s < n && n < 8000);

	// Flatten matrix into a contiguous 1D array for spatial locality
	std::vector<int> mat(n * n);
	for (int i = 0; i < n; ++i)
		for (int j = 0; j < n; ++j)
			scanf("%d", &mat[i * n + j]);

	// Build integral image using two passes for sequential memory access.
	// Pass 1: horizontal prefix sums per row, stored in H (size n x (n+1))
	std::vector<long long> H(n * (n + 1), 0);
	for (int i = 0; i < n; ++i) {
		long long row_sum = 0;
		int base = i * (n + 1);
		H[base] = 0;
		for (int j = 0; j < n; ++j) {
			row_sum += mat[i * n + j];
			H[base + j + 1] = row_sum;
		}
	}

	// Pass 2: vertical accumulation into integral image II (size (n+1)x(n+1))
	std::vector<long long> II((n + 1) * (n + 1), 0);
	for (int i = 1; i <= n; ++i) {
		const long long* prev_row = &II[(i - 1) * (n + 1)];
		long long* curr_row = &II[i * (n + 1)];
		const long long* hrow = &H[(i - 1) * (n + 1)];
		curr_row[0] = 0;
		for (int j = 1; j <= n; ++j)
			curr_row[j] = prev_row[j] + hrow[j];
	}

	// Search for maximum SxS submatrix sum using integral image.
	// Straightforward double loop over rows then columns to maximize spatial locality:
	// inner loop accesses consecutive elements within each row of II.
	int mxSum = -2147483648;
	for (int i = 0; i <= n - s; ++i) {
		const long long* row_i   = &II[i * (n + 1)];
		const long long* row_is = &II[(i + s) * (n + 1)];
		for (int j = 0; j <= n - s; ++j) {
			long long sub_sum = row_is[j + s] - row_i[j + s] - row_is[j] + row_i[j];
			if (sub_sum > mxSum)
				mxSum = static_cast<int>(sub_sum);
		}
	}

	printf("%d\n", mxSum);
	return 0;
}

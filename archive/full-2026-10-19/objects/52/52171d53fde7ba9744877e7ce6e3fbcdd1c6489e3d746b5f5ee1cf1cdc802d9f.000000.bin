{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n#include <float.h>\\n#include <limits.h>\\n#include <stdint.h>\\n#include <string.h>\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\nenum { KNN_BUCKETS = 4096, KNN_SHIFT = 20, KNN_LABELS = 256 };\\n\\ntypedef struct {\\n    size_t order;\\n    uint32_t key;\\n    unsigned char label;\\n} KnnCandidate;\\n\\ntypedef struct {\\n    size_t bins[KNN_BUCKETS];\\n    size_t votes[KNN_LABELS];\\n    size_t offset;\\n    size_t has_nan;\\n    size_t padding[6];\\n} KnnWork;\\n\\nstatic int knn_candidate_less(const KnnCandidate *a, const KnnCandidate *b) {\\n    return a->key < b->key || (a->key == b->key && a->order < b->order);\\n}\\n\\nstatic int knn_candidate_compare(const void *lhs, const void *rhs) {\\n    const KnnCandidate *a = (const KnnCandidate *)lhs;\\n    const KnnCandidate *b = (const KnnCandidate *)rhs;\\n    if (knn_candidate_less(a, b)) return -1;\\n    if (knn_candidate_less(b, a)) return 1;\\n    return 0;\\n}\\n\\nstatic void knn_candidate_swap(KnnCandidate *a, KnnCandidate *b) {\\n    KnnCandidate temporary = *a;\\n    *a = *b;\\n    *b = temporary;\\n}\\n\\nstatic void knn_select_prefix(KnnCandidate *a, size_t count, size_t keep) {\\n    if (keep == 0 || keep >= count) return;\\n    size_t lo = 0, hi = count;\\n    unsigned depth = 0;\\n    for (size_t n = count; n > 1; n >>= 1) depth += 2;\\n\\n    while (hi - lo > 24) {\\n        if (depth == 0) {\\n            qsort(a + lo, hi - lo, sizeof(*a), knn_candidate_compare);\\n            return;\\n        }\\n        --depth;\\n        size_t middle = lo + (hi - lo) / 2;\\n        KnnCandidate p = a[lo], q = a[middle], r = a[hi - 1];\\n        if (knn_candidate_less(&q, &p)) knn_candidate_swap(&p, &q);\\n        if (knn_candidate_less(&r, &q)) knn_candidate_swap(&q, &r);\\n        if (knn_candidate_less(&q, &p)) knn_candidate_swap(&p, &q);\\n        KnnCandidate pivot = q;\\n        size_t left = lo, scan = lo, right = hi;\\n        while (scan < right) {\\n            if (knn_candidate_less(&a[scan], &pivot)) {\\n                knn_candidate_swap(&a[left], &a[scan]);\\n                ++left;\\n                ++scan;\\n            } else if (knn_candidate_less(&pivot, &a[scan])) {\\n                --right;\\n                knn_candidate_swap(&a[scan], &a[right]);\\n            } else {\\n                ++scan;\\n            }\\n        }\\n        if (keep < left) hi = left;\\n        else if (keep > right) lo = right;\\n        else return;\\n    }\\n\\n    for (size_t i = lo + 1; i < hi; ++i) {\\n        KnnCandidate value = a[i];\\n        size_t j = i;\\n        while (j > lo && knn_candidate_less(&value, &a[j - 1])) {\\n            a[j] = a[j - 1];\\n            --j;\\n        }\\n        a[j] = value;\\n    }\\n}\\n\\nstatic char knn_reference(int n_groups, Group *groups, int k, Point to_evaluate) {\\n    char *labels = (char *)malloc(sizeof(char) * (size_t)k);\\n    float *distances = (float *)malloc(sizeof(float) * (size_t)k);\\n    if (!labels || !distances) {\\n        free(labels);\\n        free(distances);\\n        on_error();\\n    }\\n\\n    for (int i = 0; i < k; ++i) {\\n        labels[i] = -1;\\n        distances[i] = -1;\\n    }\\n    for (int i = 0; i < n_groups; ++i) {\\n        Group g = groups[i];\\n        for (int j = 0; j < g.length; ++j) {\\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n            for (int x = 0; x < k; ++x) {\\n                if (d < distances[x] || distances[x] == -1) {\\n                    for (int y = k - 1; y > x; --y) {\\n                        distances[y] = distances[y - 1];\\n                        labels[y] = labels[y - 1];\\n                    }\\n                    distances[x] = d;\\n                    labels[x] = g.label;\\n                    break;\\n                }\\n            }\\n        }\\n    }\\n\\n    qsort(labels, k, sizeof(char), compare_for_sort);\\n    char most_frequent = labels[0];\\n    int most_frequent_count = 1;\\n    int current_frequency = 1;\\n    for (int i = 1; i < k; ++i) {\\n        if (labels[i] != labels[i - 1]) {\\n            if (current_frequency > most_frequent_count) {\\n                most_frequent = labels[i - 1];\\n                most_frequent_count = current_frequency;\\n            }\\n            current_frequency = 1;\\n        } else {\\n            ++current_frequency;\\n        }\\n        if (i == k - 1 && current_frequency > most_frequent_count) {\\n            most_frequent = labels[i - 1];\\n            most_frequent_count = current_frequency;\\n        }\\n    }\\n    free(labels);\\n    free(distances);\\n    return most_frequent;\\n}\\n\\nstatic char knn_vote_winner(const size_t *votes) {\\n    char winner = (char)-1;\\n    size_t best_count = 0;\\n    for (int c = CHAR_MIN; c <= CHAR_MAX; ++c) {\\n        size_t count = votes[(unsigned char)(char)c];\\n        if (count > best_count) {\\n            best_count = count;\\n            winner = (char)c;\\n        }\\n    }\\n    return winner;\\n}\\n\\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n    if (k <= 0 || n_groups <= 0) return (char)-1;\\n    if (CHAR_BIT != 8 || sizeof(float) != sizeof(uint32_t) ||\\n        FLT_RADIX != 2 || FLT_MANT_DIG != 24 || FLT_MAX_EXP != 128) {\\n        return knn_reference(n_groups, groups, k, to_evaluate);\\n    }\\n    if ((size_t)n_groups + 1 > SIZE_MAX / sizeof(size_t)) {\\n        return knn_reference(n_groups, groups, k, to_evaluate);\\n    }\\n    size_t *offsets = (size_t *)malloc(((size_t)n_groups + 1) * sizeof(size_t));\\n    if (!offsets) return knn_reference(n_groups, groups, k, to_evaluate);\\n    offsets[0] = 0;\\n    for (int g = 0; g < n_groups; ++g) {\\n        size_t length = groups[g].length > 0 ? (size_t)groups[g].length : 0;\\n        if (length > SIZE_MAX - offsets[g]) {\\n            free(offsets);\\n            return knn_reference(n_groups, groups, k, to_evaluate);\\n        }\\n        offsets[g + 1] = offsets[g] + length;\\n    }\\n    size_t total = offsets[n_groups];\\n    size_t wanted = (size_t)k;\\n    if (wanted >= total) {\\n        size_t votes[KNN_LABELS] = {0};\\n        for (int g = 0; g < n_groups; ++g) {\\n            votes[(unsigned char)groups[g].label] += offsets[g + 1] - offsets[g];\\n        }\\n        votes[(unsigned char)(char)-1] += wanted - total;\\n        char result = knn_vote_winner(votes);\\n        free(offsets);\\n        return result;\\n    }\\n    if (total <= 256 || total > SIZE_MAX / sizeof(uint32_t)) {\\n        free(offsets);\\n        return knn_reference(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    int workers = 1;\\n#ifdef _OPENMP\\n    workers = omp_get_max_threads();\\n    if (workers < 1) workers = 1;\\n#endif\\n    size_t useful_workers = total / 8192;\\n    if (useful_workers < 1) useful_workers = 1;\\n    if (useful_workers < (size_t)workers) workers = (int)useful_workers;\\n    if ((size_t)workers > SIZE_MAX / sizeof(KnnWork)) {\\n        free(offsets);\\n        return knn_reference(n_groups, groups, k, to_evaluate);\\n    }\\n    uint32_t *keys = (uint32_t *)malloc(total * sizeof(*keys));\\n    KnnWork *work = (KnnWork *)malloc((size_t)workers * sizeof(*work));\\n    if (!keys || !work) {\\n        free(keys);\\n        free(work);\\n        free(offsets);\\n        return knn_reference(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    size_t histogram[KNN_BUCKETS];\\n    size_t votes[KNN_LABELS] = {0};\\n    unsigned selected_bucket = 0;\\n    size_t take = 0, bucket_size = 0;\\n    KnnCandidate *boundary = NULL;\\n    int fallback = 0;\\n    char result = (char)-1;\\n\\n#ifdef _OPENMP\\n#pragma omp parallel num_threads(workers) if(workers > 1)\\n#endif\\n    {\\n        int tid = 0, team = 1;\\n#ifdef _OPENMP\\n        tid = omp_get_thread_num();\\n        team = omp_get_num_threads();\\n#endif\\n        KnnWork *local = &work[tid];\\n        memset(local, 0, sizeof(*local));\\n        size_t quotient = total / (size_t)team;\\n        size_t remainder = total % (size_t)team;\\n        size_t begin = quotient * (size_t)tid +\\n                       ((size_t)tid < remainder ? (size_t)tid : remainder);\\n        size_t end = begin + quotient + ((size_t)tid < remainder);\\n        int lo = 0, hi = n_groups;\\n        while (lo < hi) {\\n            int middle = lo + (hi - lo) / 2;\\n            if (offsets[middle + 1] <= begin) lo = middle + 1;\\n            else hi = middle;\\n        }\\n        int first_group = lo;\\n        for (int g = first_group; g < n_groups && offsets[g] < end; ++g) {\\n            size_t base = offsets[g];\\n            size_t first = begin > base ? begin : base;\\n            size_t stop = offsets[g + 1] < end ? offsets[g + 1] : end;\\n            for (size_t p = first; p < stop; ++p) {\\n                float d = euclidean_distance_no_sqrt(to_evaluate, groups[g].points[p - base]);\\n                uint32_t key;\\n                memcpy(&key, &d, sizeof(key));\\n                if ((key & 0x7fffffffU) == 0) key = 0;\\n                if ((key & 0x7fffffffU) > 0x7f800000U) local->has_nan = 1;\\n                keys[p] = key;\\n                ++local->bins[key >> KNN_SHIFT];\\n            }\\n        }\\n#ifdef _OPENMP\\n#pragma omp barrier\\n#pragma omp for schedule(static)\\n#endif\\n        for (int b = 0; b < KNN_BUCKETS; ++b) {\\n            size_t count = 0;\\n            for (int t = 0; t < team; ++t) count += work[t].bins[b];\\n            histogram[b] = count;\\n        }\\n#ifdef _OPENMP\\n#pragma omp single\\n#endif\\n        {\\n            for (int t = 0; t < team; ++t) {\\n                if (work[t].has_nan) fallback = 1;\\n            }\\n            if (!fallback) {\\n                size_t rank = wanted;\\n                for (unsigned b = 0; b < KNN_BUCKETS; ++b) {\\n                    if (rank > histogram[b]) rank -= histogram[b];\\n                    else {\\n                        selected_bucket = b;\\n                        take = rank;\\n                        bucket_size = histogram[b];\\n                        break;\\n                    }\\n                }\\n                if (take < bucket_size) {\\n                    if (bucket_size > SIZE_MAX / sizeof(*boundary)) {\\n                        fallback = 1;\\n                    } else {\\n                        boundary = (KnnCandidate *)malloc(bucket_size * sizeof(*boundary));\\n                        if (!boundary) fallback = 1;\\n                    }\\n                    if (!fallback) {\\n                        size_t cursor = 0;\\n                        for (int t = 0; t < team; ++t) {\\n                            work[t].offset = cursor;\\n                            cursor += work[t].bins[selected_bucket];\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n        if (!fallback) {\\n            size_t next = local->offset;\\n            int whole_bucket = take == bucket_size;\\n            for (int g = first_group; g < n_groups && offsets[g] < end; ++g) {\\n                size_t base = offsets[g];\\n                size_t first = begin > base ? begin : base;\\n                size_t stop = offsets[g + 1] < end ? offsets[g + 1] : end;\\n                size_t group_count = 0;\\n                unsigned char label = (unsigned char)groups[g].label;\\n                for (size_t p = first; p < stop; ++p) {\\n                    unsigned bin = keys[p] >> KNN_SHIFT;\\n                    if (bin < selected_bucket) {\\n                        ++group_count;\\n                    } else if (bin == selected_bucket) {\\n                        if (whole_bucket) {\\n                            ++group_count;\\n                        } else {\\n                            boundary[next].order = p;\\n                            boundary[next].key = keys[p];\\n                            boundary[next].label = label;\\n                            ++next;\\n                        }\\n                    }\\n                }\\n                local->votes[label] += group_count;\\n            }\\n        }\\n#ifdef _OPENMP\\n#pragma omp barrier\\n#pragma omp single nowait\\n#endif\\n        {\\n            if (!fallback) {\\n                for (int t = 0; t < team; ++t) {\\n                    for (int c = 0; c < KNN_LABELS; ++c) votes[c] += work[t].votes[c];\\n                }\\n                if (take < bucket_size) {\\n                    knn_select_prefix(boundary, bucket_size, take);\\n                    for (size_t p = 0; p < take; ++p) ++votes[boundary[p].label];\\n                }\\n                result = knn_vote_winner(votes);\\n            }\\n        }\\n    }\\n\\n    free(boundary);\\n    free(work);\\n    free(keys);\\n    free(offsets);\\n    if (fallback) return knn_reference(n_groups, groups, k, to_evaluate);\\n    return result;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"A cooperative coarse-distance histogram can restrict exact selection to one boundary bucket, reducing memory passes while retaining point-balanced OpenMP work and deterministic ties.\",\n  \"notes\": \"No execution performed. Parsing and the distance expression remain unchanged; scratch storage is released after each call.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Use contiguous, point-balanced ranges within one adaptively sized OpenMP team.\",\n    \"Build private 12-bit distance histograms and combine bins using static work sharing.\",\n    \"Compact only the boundary bucket, select by distance and original position, and reduce parallel label counts.\",\n    \"Preserve reference insertion for NaNs and small inputs, including original character-order voting ties.\"\n  ]\n}"}}

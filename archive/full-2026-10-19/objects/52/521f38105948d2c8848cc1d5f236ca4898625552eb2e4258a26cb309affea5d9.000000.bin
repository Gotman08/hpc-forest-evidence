        "content": "#include <algorithm>\n#include <atomic>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <cstring>\n#include <limits>\n#include <memory>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing Word = std::uint32_t;\nusing Sum = std::int32_t;\n\nconstexpr std::size_t kInputBlockBytes = 256u * 1024u;\n\nstruct InputBlock {\n    std::size_t capacity;\n    std::unique_ptr<unsigned char[]> bytes;\n    std::atomic<bool> available;\n\n    InputBlock()\n        : capacity(kInputBlockBytes + 64),\n          bytes(new unsigned char[capacity]), available(true) {}\n\n    void ensure(std::size_t needed, std::size_t used) {\n        if (needed <= capacity) return;\n        const std::size_t next_capacity = std::max(needed, capacity * 2);\n        std::unique_ptr<unsigned char[]> next(new unsigned char[next_capacity]);\n        std::memcpy(next.get(), bytes.get(), used);\n        bytes.swap(next);\n        capacity = next_capacity;\n    }\n};\n\nstatic std::size_t read_block(InputBlock& block) {\n    std::size_t length = std::fread(block.bytes.get(), 1, kInputBlockBytes, stdin);\n    if (length == 0) return 0;\n    while (block.bytes[length - 1] > ' ') {\n        const int c = std::fgetc(stdin);\n        if (c == EOF) break;\n        block.ensure(length + 2, length);\n        block.bytes[length++] = static_cast<unsigned char>(c);\n    }\n    block.bytes[length] = 0;\n    return length;\n}\n\nstatic std::size_t count_tokens(const unsigned char* bytes, std::size_t length) {\n    std::size_t count = bytes[0] > ' ' ? 1 : 0;\n    #pragma omp simd reduction(+:count)\n    for (std::size_t i = 1; i < length; ++i) {\n        count += static_cast<std::size_t>(bytes[i] > ' ' && bytes[i - 1] <= ' ');\n    }\n    return count;\n}\n\nstatic inline Word read_word(const unsigned char*& cursor) {\n    while (*cursor <= ' ') ++cursor;\n    const bool negative = *cursor == '-';\n    if (*cursor == '-' || *cursor == '+') ++cursor;\n    Word magnitude = 0;\n    unsigned digit = static_cast<unsigned>(*cursor)\n                   - static_cast<unsigned>('0');\n    while (digit < 10u) {\n        magnitude = magnitude * 10u + digit;\n        ++cursor;\n        digit = static_cast<unsigned>(*cursor)\n              - static_cast<unsigned>('0');\n    }\n    return negative ? Word(0) - magnitude : magnitude;\n}\n\nstatic inline Sum signed_sum(Word bits) {\n    Sum value;\n    std::memcpy(&value, &bits, sizeof(value));\n    return value;\n}\n\n#if defined(__aarch64__)\nstatic inline uint32x4_t prefix_four(uint32x4_t values) {\n    const uint32x4_t zero = vdupq_n_u32(0);\n    values = vaddq_u32(values, vextq_u32(zero, values, 3));\n    return vaddq_u32(values, vextq_u32(zero, values, 2));\n}\n#endif\n\nstatic inline void horizontal_sums(Word* row, int n, int s) {\n    const int windows = n - s + 1;\n    Word total = 0;\n    #pragma omp simd reduction(+:total)\n    for (int c = 0; c < s; ++c) total += row[c];\n\n    int c = 0;\n#if defined(__aarch64__)\n    uint32x4_t carry = vdupq_n_u32(total);\n    for (; c + 8 < windows; c += 8) {\n        // Load both source ranges before overwriting any overlapping input.\n        const uint32x4_t leaving0 = vld1q_u32(row + c);\n        const uint32x4_t leaving1 = vld1q_u32(row + c + 4);\n        const uint32x4_t entering0 = vld1q_u32(row + c + s);\n        const uint32x4_t entering1 = vld1q_u32(row + c + s + 4);\n\n        const uint32x4_t prefix0 = prefix_four(vsubq_u32(entering0, leaving0));\n        uint32x4_t prefix1 = prefix_four(vsubq_u32(entering1, leaving1));\n        prefix1 = vaddq_u32(prefix1,\n                           vdupq_n_u32(vgetq_lane_u32(prefix0, 3)));\n        const uint32x4_t values0 = vaddq_u32(carry, prefix0);\n        const uint32x4_t values1 = vaddq_u32(carry, prefix1);\n\n        vst1q_u32(row + c, vextq_u32(carry, values0, 3));\n        vst1q_u32(row + c + 4, vextq_u32(values0, values1, 3));\n        carry = vdupq_n_u32(vgetq_lane_u32(values1, 3));\n    }\n    total = vgetq_lane_u32(carry, 0);\n#endif\n    for (; c < windows - 1; ++c) {\n        const Word leaving = row[c];\n        const Word entering = row[c + s];\n        row[c] = total;\n        total += entering - leaving;\n    }\n    row[windows - 1] = total;\n}\n\nstatic void decode_rows(const unsigned char* cursor, std::size_t count,\n                        int column, int n, int s, Word* destination) {\n    while (count != 0) {\n        const std::size_t take = std::min(count,\n            static_cast<std::size_t>(n - column));\n        for (std::size_t k = 0; k < take; ++k) {\n            destination[k] = read_word(cursor);\n        }\n        // Only transform rows entirely owned by this input block.\n        if (column == 0 && take == static_cast<std::size_t>(n)) {\n            horizontal_sums(destination, n, s);\n        }\n        destination += take;\n        count -= take;\n        column = 0;\n    }\n}\n\nint main() {\n    int n, s;\n    if (std::scanf(\"%d%d\", &n, &s) != 2) return 0;\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t row_length = static_cast<std::size_t>(n);\n    const std::size_t elements = row_length * row_length;\n    std::unique_ptr<Word[]> matrix(new Word[elements]);\n    Word* const data = matrix.get();\n    std::unique_ptr<unsigned char[]> partial_rows(new unsigned char[n]());\n\n    const int windows = n - s + 1;\n    constexpr int max_stripe_width = 256;\n    int workers = 1;\n#ifdef _OPENMP\n    workers = omp_get_max_threads();\n#endif\n    const int pool_size = elements >= 65536 ? 2 * workers : 1;\n    std::unique_ptr<InputBlock[]> blocks(new InputBlock[pool_size]);\n    const int stripe_width = std::min(max_stripe_width,\n        std::max(1, (windows + workers - 1) / workers));\n    const int stripes = (windows + stripe_width - 1) / stripe_width;\n    std::size_t produced = 0;\n    Sum maximum = std::numeric_limits<Sum>::lowest();\n\n    #pragma omp parallel if(elements >= 65536) reduction(max:maximum)\n    {\n        int team = 1;\n#ifdef _OPENMP\n        team = omp_get_num_threads();\n#endif\n        #pragma omp single\n        {\n            int next_slot = 0;\n            while (produced < elements) {\n                int slot = -1;\n                do {\n                    for (int attempt = 0; attempt < pool_size; ++attempt) {\n                        int candidate = next_slot + attempt;\n                        if (candidate >= pool_size) candidate -= pool_size;\n                        if (blocks[candidate].available.load(std::memory_order_acquire)) {\n                            slot = candidate;\n                            break;\n                        }\n                    }\n                    if (slot < 0) {\n                        #pragma omp taskwait\n                    }\n                } while (slot < 0);\n\n                next_slot = slot + 1;\n                if (next_slot == pool_size) next_slot = 0;\n                InputBlock* const block = blocks.get() + slot;\n                const std::size_t length = read_block(*block);\n                if (length == 0) break;\n                const std::size_t count = std::min(\n                    count_tokens(block->bytes.get(), length), elements - produced);\n                if (count == 0) continue;\n\n                const std::size_t first = produced;\n                const int initial_column = static_cast<int>(first % row_length);\n                if (initial_column != 0) partial_rows[first / row_length] = 1;\n                produced += count;\n                if (produced % row_length != 0) {\n                    partial_rows[produced / row_length] = 1;\n                }\n\n                const unsigned char* const bytes = block->bytes.get();\n                Word* const destination = data + first;\n                block->available.store(false, std::memory_order_relaxed);\n                #pragma omp task firstprivate(block, bytes, destination, count, initial_column, n, s) if(team > 1)\n                {\n                    decode_rows(bytes, count, initial_column, n, s, destination);\n                    block->available.store(true, std::memory_order_release);\n                }\n            }\n            #pragma omp taskwait\n        }\n\n        if (produced == elements) {\n            #pragma omp for schedule(static)\n            for (int r = 0; r < n; ++r) {\n                if (partial_rows[r]) {\n                    horizontal_sums(data + static_cast<std::size_t>(r) * n, n, s);\n                }\n            }\n\n            alignas(64) Word column_sums[max_stripe_width];\n            alignas(64) Sum column_maxima[max_stripe_width];\n\n            #pragma omp for schedule(static) nowait\n            for (int block = 0; block < stripes; ++block) {\n                const int first = block * stripe_width;\n                const int width = std::min(stripe_width, windows - first);\n                #pragma omp simd\n                for (int c = 0; c < width; ++c) column_sums[c] = 0;\n\n                for (int r = 0; r < s; ++r) {\n                    const Word* const row = data\n                        + static_cast<std::size_t>(r) * n + first;\n                    #pragma omp simd\n                    for (int c = 0; c < width; ++c) column_sums[c] += row[c];\n                }\n                #pragma omp simd\n                for (int c = 0; c < width; ++c) {\n                    column_maxima[c] = signed_sum(column_sums[c]);\n                }\n\n                for (int r = s; r < n; ++r) {\n                    const Word* const entering = data\n                        + static_cast<std::size_t>(r) * n + first;\n                    const Word* const leaving = data\n                        + static_cast<std::size_t>(r - s) * n + first;\n                    #pragma omp simd\n                    for (int c = 0; c < width; ++c) {\n                        const Word total = column_sums[c] + entering[c] - leaving[c];\n                        column_sums[c] = total;\n                        column_maxima[c] = std::max(column_maxima[c], signed_sum(total));\n                    }\n                }\n\n                Sum block_maximum = std::numeric_limits<Sum>::lowest();\n                #pragma omp simd reduction(max:block_maximum)\n                for (int c = 0; c < width; ++c) {\n                    block_maximum = std::max(block_maximum, column_maxima[c]);\n                }\n                maximum = std::max(maximum, block_maximum);\n            }\n        }\n    }\n\n    if (produced != elements) return 0;\n    std::printf(\"%d\\n\", static_cast<int>(maximum));\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }

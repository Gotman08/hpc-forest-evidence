        "content": "#include <iostream>\n#include <string>\n#include <map>\n#include <list>\n#include <queue>\n#include <climits>\n#include <cstdio>\n#include <vector>\n#include <atomic>\n\nusing namespace std;\n\nint nCores = 0;\nint nVertices = 0;\nint nArestas = 0;\nint no_of_vert = 0;\nint contCor = 0;\n\nvector<int> caminhoTropical;\nvector<int> caminho;\n\nstruct part\n{\n    vector<pair<int, int>> spanning;\n    vector<pair<int, int>> inc_ed;\n    vector<pair<int, int>> exc_ed;\n};\n\nvector<part> partitions;\nvector<pair<int, int>> current_span;\n\nclass graph{\n\tpublic:\n\t    int Vertex;\n\t    vector<vector<int>> adj_mat;\n\t    vector<int> cores;\n\t    \n\t    graph(int vertex)\n\t    {\n\t    \tVertex = vertex;\n\t        for(int i = 0; i < Vertex; i++){\n\t        \tvector<int> aux;\n\t            for(int j = 0; j < Vertex; j++){\n\t                aux.push_back(0);\n\t\t\t\t}\n\t\t\t\tadj_mat.push_back(aux);\n            }\n\t                \n\t        for(int i = 0; i < Vertex; i++)\n\t           cores.push_back(0);\n\t    }\n\t    \n\t    void add_edge(int u, int v)\n\t    {\n\t        adj_mat[u][v] = adj_mat[v][u] = 1;\n\t    }\n};\n\nint find_min_key(vector<int> arr, int V, vector<bool> mstset)\n{\n    int min_key=INT_MAX, min_index=-1;\n    for(int i=0;i<V;i++)\n    {\n        if(arr[i]<min_key && mstset[i]==false){\n            min_key=arr[i];\n            min_index=i;\n        }\n    }\n    return min_index;\n}\n\nbool is_cycle(vector<vector<int>> mat,int src, int V)//verificar se o gr?fico formado ? c?clico ou n?o\n{\n    map<int,bool> visited;\n    queue<int> traverse;\n    map<int,int> parent;\n    parent[src]=src;\n    visited[src]=true;\n    traverse.push(src);\n    while(!traverse.empty())\n    {\n        int node=traverse.front();\n        traverse.pop();\n        for(int i=0;i<V;i++)\n            if(mat[node][i]>0)\n            {\n                if(!visited[i])\n                {\n                    traverse.push(i);\n                    visited[i]=true;\n                    parent[i]=node;\n                }\n                else if(visited[i]==true && i!=parent[node])\n                    return 1; //ciclo\n            }\n    }\n    return 0;\n}\n\nint Prim_ST(graph G, vector<pair<int,int>> include_edges, vector<pair<int,int>> exclude_edges)\n{\n    int V = G.Vertex;\n\t           \n    vector<vector<int>> new_mat;\n    vector<vector<int>> mat_cycle;\n    \n    for(int i = 0; i < V; i++){\n    \tvector<int> aux;\n        for(int j = 0; j < V; j++){\n            aux.push_back(0);\n\t\t}\n\t\tmat_cycle.push_back(aux);\n    }\n    \n    for(int i = 0; i < V; i++){\n    \tvector<int> aux;\n        for(int j = 0; j < V; j++){\n            aux.push_back(G.adj_mat[i][j]);\n\t\t}\n\t\tnew_mat.push_back(aux);\n    }\n    \n    int u1,v1;\n    for(vector<pair<int, int>>::iterator it=exclude_edges.begin(); it!=exclude_edges.end();it++)\n    {\n        u1=(*it).first;\n        v1=(*it).second;\n        new_mat[u1][v1]=new_mat[v1][u1]=INT_MIN;\n    }\n    \n    int parent[V];\n    vector<int> key(V);\n    vector<bool> mstset(V);\n    for(int i=0;i<V;i++)\n    {\n        key[i]=INT_MAX;\n        mstset[i]=false;\n        parent[i]=nVertices;\n    }\n    \n    int root;\n    root= 0;\n    parent[root]=-1;\n    \n    int vertex_must_include[V];\n    map<int, int> parent_included_vertex;\n    \n    for(int m=0;m<V;m++)\n        vertex_must_include[m]=false;\n    if(!include_edges.empty())\n    {\n        for(vector<pair<int, int>>::iterator it=include_edges.begin(); it!=include_edges.end();it++)\n        {\n            u1=(*it).first;\n            v1=(*it).second;\n            vertex_must_include[u1]=vertex_must_include[v1]=true;\n            parent_included_vertex[v1]=u1;\n            parent_included_vertex[u1]=100;\n        }\n    }\n    \n    key[root]=0;\n    parent[root]=-1;\n    for(int c=0;c<V;c++)\n    {\n        int u=find_min_key(key, V, mstset);\n        if(u==-1) //desconectado\n        {\n            return -1;\n        }\n        mstset[u]=true;\n        if(parent[u] > 0)\n        \tmat_cycle[parent[u]][u]=new_mat[parent[u]][u];\n        no_of_vert++;\n        for(int v=0;v<V;v++)\n        {\n            if(new_mat[u][v]>0 && mstset[v]==false && new_mat[u][v]< key[v])\n            {\n                \n                if(vertex_must_include[v] && parent_included_vertex[v]!=100 && parent_included_vertex[v]!=u)\n                {\n                    int x=parent_included_vertex[v];\n                    if(parent[x]!=nVertices)\n                        continue;\n                }\n                //para verificar se o ciclo se formou ou n?o\n                int prev=mat_cycle[u][v];\n                mat_cycle[u][v]=new_mat[u][v];\n                \n                bool cycle=is_cycle(mat_cycle, root, V);\n                if(!cycle)\n                {\n                    parent[v]=u;\n                    key[v]=new_mat[u][v];\n                }\n                mat_cycle[u][v]=prev;\n            }\n        }\n    }\n    \n    int tot_cost=0;\n    for(int i=1;i<V;i++){\n        int x=parent[i];\n        tot_cost+=new_mat[x][i];\n        current_span.push_back(make_pair(x, i));\n    }\n    return tot_cost;\n}\n\nvoid exibirVetor(const vector<int>& l)\n{\n    for(auto i: l)\n    {\n    \tif(i == l.back())\n    \t\tcout<<i;\n    \telse\n        \tcout<<i<<\"-\";\n    }\n    cout<<endl;\n}\n\nstruct SearchResult\n{\n    vector<int> bestPath;\n    int bestCount;\n    vector<int> successPath;\n    bool found;\n\n    SearchResult() : bestCount(0), found(false) {}\n};\n\nbool search_tree_path(int vertex,\n                      const vector<vector<int>>& adjacency,\n                      const vector<int>& colors,\n                      int targetColors,\n                      vector<unsigned char>& visited,\n                      vector<int>& colorCounts,\n                      int colorCount,\n                      vector<int>& path,\n                      SearchResult& result)\n{\n    visited[vertex] = 1;\n    path.push_back(vertex);\n\n    int color = colors[vertex];\n    if (colorCounts[color]++ == 0)\n        ++colorCount;\n\n    bool hasUnvisitedNeighbor = false;\n    for (int neighbor : adjacency[vertex])\n    {\n        if (!visited[neighbor])\n        {\n            hasUnvisitedNeighbor = true;\n            if (search_tree_path(neighbor, adjacency, colors, targetColors,\n                                 visited, colorCounts, colorCount, path, result))\n                return true;\n        }\n    }\n\n    if (!hasUnvisitedNeighbor)\n    {\n        if (colorCount == targetColors)\n        {\n            result.successPath = path;\n            result.found = true;\n            return true;\n        }\n        if (colorCount > result.bestCount)\n        {\n            result.bestCount = colorCount;\n            result.bestPath = path;\n        }\n    }\n\n    if (--colorCounts[color] == 0)\n        --colorCount;\n    visited[vertex] = 0;\n    path.pop_back();\n    return false;\n}\n\nvoid search_from_start(int start,\n                       int vertexCount,\n                       const vector<vector<int>>& adjacency,\n                       const vector<int>& colors,\n                       int targetColors,\n                       atomic<int>& earliestSuccess,\n                       SearchResult& result)\n{\n    if (start > earliestSuccess.load(memory_order_relaxed))\n        return;\n\n    vector<unsigned char> visited(vertexCount, 0);\n    vector<int> colorCounts(targetColors, 0);\n    vector<int> path;\n    path.push_back(start);\n    visited[start] = 1;\n    colorCounts[colors[start]] = 1;\n\n    for (int neighbor : adjacency[start])\n    {\n        if (!visited[neighbor] &&\n            search_tree_path(neighbor, adjacency, colors, targetColors,\n                             visited, colorCounts, 1, path, result))\n        {\n            int current = earliestSuccess.load(memory_order_relaxed);\n            while (start < current &&\n                   !earliestSuccess.compare_exchange_weak(\n                       current, start, memory_order_relaxed, memory_order_relaxed))\n            {\n            }\n            return;\n        }\n    }\n}\n\nbool caminhoTropi(const graph& G, const vector<pair<int, int>>& spanning)\n{\n    vector<vector<int>> adjacency(nVertices);\n    for (const pair<int, int>& edge : spanning)\n    {\n        adjacency[edge.first].push_back(edge.second);\n        adjacency[edge.second].push_back(edge.first);\n    }\n\n    vector<SearchResult> results(nVertices);\n    atomic<int> earliestSuccess(nVertices);\n\n    #pragma omp parallel for schedule(dynamic, 1) if(nVertices >= 32)\n    for (int i = 0; i < nVertices; ++i)\n        search_from_start(i, nVertices, adjacency, G.cores, nCores,\n                          earliestSuccess, results[i]);\n\n    for (int i = 0; i < nVertices; ++i)\n    {\n        if (results[i].bestCount > contCor)\n        {\n            contCor = results[i].bestCount;\n            caminho = results[i].bestPath;\n        }\n        if (results[i].found)\n        {\n            exibirVetor(results[i].successPath);\n            cout << nCores;\n            return true;\n        }\n    }\n    return false;\n}\n\nbool create_partitions(graph G)\n{\n    while(true)\n    {\n    \tpart P;\n        vector<part>::iterator iter;\n        for(vector<part>::iterator it=partitions.begin();it!=partitions.end();it++)\n        {\n            iter=it;\n        }\n        P.spanning=(*iter).spanning;\n        P.exc_ed=(*iter).exc_ed;\n        P.inc_ed=(*iter).inc_ed;\n        partitions.erase(iter);\n        \n        vector<pair<int, int>> stree = P.spanning;\n        vector<pair<int, int>>::iterator it1;\n        vector<pair<int, int>>::iterator it2;\n        \n        if(caminhoTropi(G, stree)){\n        \treturn true;\n        }\n        \n        vector<pair<int, int>> included_edges;\n        vector<pair<int, int>> excluded_edges;\n        included_edges=P.inc_ed;\n        pair<int, int> ex_edge;\n        \n        int j;\n        for(j = 0; j < stree.size(); j++)\n        {\n            if(included_edges.empty())\n                break;\n            if(stree[j].first!=included_edges[j].first && stree[j].second!=included_edges[j].second)\n            {\n                break;\n            }\n        }\n        int cost;\n        it2= stree.begin()+ j;\n        int u1,v1;\n        for(it1=it2; it1!=stree.end(); it1++)\n        {\n            part new_p;\n            u1=(*it1).first;\n            v1=(*it1).second;\n            ex_edge.first=u1;\n            ex_edge.second=v1;\n            excluded_edges=P.exc_ed;\n            excluded_edges.push_back(ex_edge);\n            current_span.clear();\n            cost = Prim_ST(G, included_edges, excluded_edges);\n            if(cost > 0)\n            {\n                new_p.spanning=current_span;\n                new_p.inc_ed=included_edges;\n                new_p.exc_ed=excluded_edges;\n                partitions.push_back(new_p);\n            }\n            included_edges.push_back(ex_edge);\n        }\n        \n        if(partitions.empty()){\n            return false;\n        }\n    }\n}\n\nint main() {\n    scanf(\"%i %i\", &nVertices, &nCores);\n    \n    graph G {nVertices};\n    \n    for (int i = 0; i < nVertices; i++){\n\t\tint cor;\n\t\tscanf(\"%i\", &cor);\n\t\tG.cores[i] = cor;\n\t}\n    \n    scanf(\"%i\", &nArestas);\n    \n    for (int i = 0; i < nArestas; i++){\n    \tint u1, v1;\n\t\tscanf(\"%i %i\", &u1, &v1);\n        G.add_edge(u1, v1);\n\t}\n\t\n\tvector<pair<int, int>> incl;\n    vector<pair<int, int>> excl;\n    incl.clear();\n    excl.clear();\n    Prim_ST(G, incl, excl);\n    part p;\n    incl.clear();\n    excl.clear();\n    p.exc_ed=excl;\n    p.inc_ed=incl;\n    p.spanning=current_span;\n    partitions.push_back(p);\n    \n\tif(!create_partitions(G)){\n\t\texibirVetor(caminho);\n\t\tcout<<contCor<<endl;\n\t}\n\t\n    return 0;\n}\n",
        "path": "src/tropical.cpp"
      }

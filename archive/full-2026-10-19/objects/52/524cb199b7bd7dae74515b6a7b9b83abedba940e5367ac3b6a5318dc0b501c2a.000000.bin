#include <cstdio>
#include <cstddef>
#include <vector>
#include <cstdlib>
#include <new>

template<typename T>
struct AlignedAllocator {
    using value_type = T;
    T* allocate(std::size_t n) {
        void* p = nullptr;
        if (posix_memalign(&p, 64, n * sizeof(T)) != 0) throw std::bad_alloc();
        return static_cast<T*>(p);
    }
    void deallocate(T* p, std::size_t) noexcept { std::free(p); }
};

class FastScanner {
public:
    explicit FastScanner(FILE* f) : f_(f), idx_(0), size_(0) {}

    int nextInt() {
        char c = getChar_();
        while (c <= ' ') {
            if (!c) return 0;
            c = getChar_();
        }
        bool neg = false;
        if (c == '-') {
            neg = true;
            c = getChar_();
        }
        int x = 0;
        for (; c > ' '; c = getChar_()) {
            x = x * 10 + (c - '0');
        }
        return neg ? -x : x;
    }

private:
    FILE* f_;
    int idx_;
    int size_;
    char buf_[1 << 20];

    inline char getChar_() {
        if (idx_ >= size_) {
            size_ = static_cast<int>(fread(buf_, 1, sizeof(buf_), f_));
            idx_ = 0;
            if (size_ == 0) return '\0';
        }
        return buf_[idx_++];
    }
};

int main() {
    FastScanner fs(stdin);
    int n = fs.nextInt();
    int s = fs.nextInt();

    std::vector<long long, AlignedAllocator<long long>> col(n, 0LL);
    std::vector<int, AlignedAllocator<int>> ring(static_cast<std::size_t>(s) * static_cast<std::size_t>(n));

    for (int i = 0; i < s; ++i) {
        int* row = &ring[static_cast<std::size_t>(i) * n];
        for (int j = 0; j < n; ++j) {
            int v = fs.nextInt();
            row[j] = v;
            col[j] += v;
        }
    }

    long long hsum = 0;
    for (int j = 0; j < s; ++j) hsum += col[j];
    long long best = hsum;
    for (int j = s; j < n; ++j) {
        hsum += col[j] - col[j - s];
        if (hsum > best) best = hsum;
    }

    int head = 0;
    for (int top = 1; top + s <= n; ++top) {
        int* oldRow = &ring[static_cast<std::size_t>(head) * n];
        long long* __restrict__ c = col.data();
        int* __restrict__ orow = oldRow;

        hsum = 0;
        int j = 0;
        for (; j < s - 1; ++j) {
            int v = fs.nextInt();
            long long delta = static_cast<long long>(v) - orow[j];
            c[j] += delta;
            orow[j] = v;
            hsum += c[j];
        }

        if (s <= n) {
            int v = fs.nextInt();
            long long delta = static_cast<long long>(v) - orow[s-1];
            c[s-1] += delta;
            orow[s-1] = v;
            hsum += c[s-1];
            if (hsum > best) best = hsum;

            for (j = s; j + 3 < n; j += 4) {
                int v0 = fs.nextInt();
                long long d0 = static_cast<long long>(v0) - orow[j];
                c[j] += d0;
                orow[j] = v0;
                hsum += c[j] - c[j-s];
                if (hsum > best) best = hsum;

                int v1 = fs.nextInt();
                long long d1 = static_cast<long long>(v1) - orow[j+1];
                c[j+1] += d1;
                orow[j+1] = v1;
                hsum += c[j+1] - c[j+1-s];
                if (hsum > best) best = hsum;

                int v2 = fs.nextInt();
                long long d2 = static_cast<long long>(v2) - orow[j+2];
                c[j+2] += d2;
                orow[j+2] = v2;
                hsum += c[j+2] - c[j+2-s];
                if (hsum > best) best = hsum;

                int v3 = fs.nextInt();
                long long d3 = static_cast<long long>(v3) - orow[j+3];
                c[j+3] += d3;
                orow[j+3] = v3;
                hsum += c[j+3] - c[j+3-s];
                if (hsum > best) best = hsum;
            }

            for (; j < n; ++j) {
                int v = fs.nextInt();
                long long delta = static_cast<long long>(v) - orow[j];
                c[j] += delta;
                orow[j] = v;
                hsum += c[j] - c[j-s];
                if (hsum > best) best = hsum;
            }
        }

        if (++head == s) head = 0;
    }

    std::printf("%lld\n", best);
    return 0;
}

  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n#define TILE_SIZE 4\n\n/*\n * Read a binary dataset with initialized bodies into SoA arrays.\n */\nvoid read_dataset(float **x, float **y, float **z,\n                  float **vx, float **vy, float **vz,\n                  int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  size_t n = *nbodies;\n  // Allocate aligned memory for SoA arrays\n  posix_memalign((void**)x, 16, n * sizeof(float));\n  posix_memalign((void**)y, 16, n * sizeof(float));\n  posix_memalign((void**)z, 16, n * sizeof(float));\n  posix_memalign((void**)vx, 16, n * sizeof(float));\n  posix_memalign((void**)vy, 16, n * sizeof(float));\n  posix_memalign((void**)vz, 16, n * sizeof(float));\n\n  // Read bodies one by one to fill SoA arrays\n  for (size_t i = 0; i < n; ++i) {\n    float buf[6];\n    b = fread(buf, sizeof(buf), 1, stdin);\n    if (b != 1) {\n      fprintf(stderr,\"\\nError reading input values\\n\");\n      exit(EXIT_FAILURE);\n    }\n    (*x)[i] = buf[0];\n    (*y)[i] = buf[1];\n    (*z)[i] = buf[2];\n    (*vx)[i] = buf[3];\n    (*vy)[i] = buf[4];\n    (*vz)[i] = buf[5];\n  }\n}\n\n/*\n * Write simulation results from SoA arrays into a binary dataset.\n */\nvoid write_dataset(const int nbodies,\n                   const float * restrict x, const float * restrict y, const float * restrict z,\n                   const float * restrict vx, const float * restrict vy, const float * restrict vz) {\n  // Write interleaved output\n  for (int i = 0; i < nbodies; ++i) {\n    float buf[6] = { x[i], y[i], z[i], vx[i], vy[i], vz[i] };\n    int b = fwrite(buf, sizeof(buf), 1, stdout);\n    if (b != 1) {\n      fprintf(stderr,\"\\nError writing to output\\n\");\n      exit(EXIT_FAILURE);\n    }\n  }\n}\n\n/*\n * Compute the gravitational impact among all pairs of bodies in \n * the system using tiled outer loop for cache reuse.\n */\nvoid body_force(float * restrict x, float * restrict y, float * restrict z,\n                float * restrict vx, float * restrict vy, float * restrict vz,\n                float dt, int n) {\n  #pragma omp parallel for schedule(static)\n  for (int ii = 0; ii < n; ii += TILE_SIZE) {\n    // Local force accumulators for the tile\n    float fx_tile[TILE_SIZE] = {0};\n    float fy_tile[TILE_SIZE] = {0};\n    float fz_tile[TILE_SIZE] = {0};\n\n    int i_end = ii + TILE_SIZE;\n    if (i_end > n) i_end = n;\n\n    for (int j = 0; j < n; ++j) {\n      float xj = x[j];\n      float yj = y[j];\n      float zj = z[j];\n\n      // Vectorized inner loop over the tile using SIMD reduction\n      #pragma omp simd reduction(+:fx_tile,fy_tile,fz_tile) aligned(x[ii], y[ii], z[ii]:16)\n      for (int i_local = 0; i_local < TILE_SIZE && ii + i_local < n; ++i_local) {\n        int i = ii + i_local;\n        float dx = xj - x[i];\n        float dy = yj - y[i];\n        float dz = zj - z[i];\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1.0f / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx_tile[i_local] += dx * inv_dist3;\n        fy_tile[i_local] += dy * inv_dist3;\n        fz_tile[i_local] += dz * inv_dist3;\n      }\n    }\n\n    // Update velocities for the tile\n    for (int i_local = 0; ii + i_local < n && i_local < TILE_SIZE; ++i_local) {\n      int i = ii + i_local;\n      vx[i] += dt * fx_tile[i_local];\n      vy[i] += dt * fy_tile[i_local];\n      vz[i] += dt * fz_tile[i_local];\n    }\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n  float *x, *y, *z, *vx, *vy, *vz;\n\n  read_dataset(&x, &y, &z, &vx, &vy, &vz, &nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    body_force(x, y, z, vx, vy, vz, DT, nbodies);\n\n    #pragma omp parallel for schedule(static)\n    for (int i = 0; i < nbodies; ++i) {\n      x[i] += vx[i] * DT;\n      y[i] += vy[i] * DT;\n      z[i] += vz[i] * DT;\n    }\n  }\n\n  write_dataset(nbodies, x, y, z, vx, vy, vz);\n\n  free(x); free(y); free(z); free(vx); free(vy); free(vz);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Tiling the outer i-loop into small fixed-size chunks (e.g., 4 bodies) allows reuse of loaded body j positions across multiple target bodies, reducing memory traffic. Combined with Struct-of-Arrays layout for aligned SIMD access, restrict qualifiers on pointers, and #pragma omp simd reduction over the tile dimension, this improves cache utilization and vectorization efficiency beyond previous SoA+simd approaches.",
  "notes": "Converted from AoS to SoA using posix_memalign(16) for alignment. Added tiling (TILE_SIZE=4) on outer force loop; inner j-loop remains sequential but contributions are accumulated into local tile arrays via SIMD reduction. Position update also parallelized with OpenMP. This preserves exact floating-point order per body because each i's accumulation over j is still sequential.",
  "sources_kept": [],
  "transformations": [
    "Convert Array-of-Structs to Struct-of-Arrays layout for contiguous memory access",

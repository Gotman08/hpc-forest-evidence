            "src/solution.cpp"
          ],
          "retained": [
            "Flatten the matrix into contiguous row-major storage.",
            "For S > 2, maintain 64-bit column totals for each row band and scan horizontal windows with rolling scalar updates; use SIMD for independent column updates and the initial-window reduction.",
            "For S <= 2, retain the serpentine scan and fuse entering/exiting element updates; use 64-bit sums and output formatting."
          ]
        },

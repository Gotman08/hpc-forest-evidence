"""Render measured cohort aggregates, explicitly flagging incomplete token totals."""
import hashlib
import json
from pathlib import Path

import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np

HERE = Path(__file__).resolve().parent
DATA = HERE / "resultats-vingt-couples-count.json"
data = json.loads(DATA.read_text(encoding="utf8"))
models = ["gpt-6-luna", "gpt-6-astra", "gpt-5.6-terra", "gpt-6.1-sol"]
efforts = ["max", "xhigh", "high", "medium", "low"]
rows = {(r["model"], r["effort"]): r for r in data["rows"]}
assert len(rows) == 20
gains = np.array([[100*rows[m, e]["gain_fraction"] for e in efforts] for m in models])
tokens = np.array([[rows[m, e]["known_exact_tokens"]/1000 for e in efforts] for m in models])
fig, axes = plt.subplots(1, 2, figsize=(13.5, 4.8), layout="constrained")
fig.suptitle("Count 2023 : vingt recherches fraîches reçues et auditées\nUne graine par cellule ; comparaison descriptive", fontsize=15)
for ax, values, title, cmap, low, high, label in [
    (axes[0], gains, "Réduction confirmée du temps", "Blues", 0, 100, "% contre la référence propre"),
    (axes[1], tokens, "Jetons exacts connus", "YlGnBu", 0, 250, "Milliers de jetons connus"),
]:
    image = ax.imshow(values, cmap=cmap, vmin=low, vmax=high, aspect="auto")
    ax.set_xticks(range(5), efforts)
    ax.set_yticks(range(4), ["Luna", "Astra", "Terra", "Sol 6.1"])
    ax.set_xlabel("Effort demandé")
    ax.set_title(title, fontsize=12)
    for i, model in enumerate(models):
        for j, effort in enumerate(efforts):
            if ax is axes[0]:
                text = f"{values[i, j]:.2f} %"
            else:
                text = f"{values[i, j]:.1f} k" + (" *" if rows[model, effort]["unmetered_calls"] else "")
            color = "white" if values[i, j] > .62*high else "#16212b"
            ax.text(j, i, text, ha="center", va="center", color=color, fontsize=10)
    fig.colorbar(image, ax=ax, shrink=.78, label=label)
fig.supxlabel("* Appels non mesurés : le total connu est incomplet. Cache et raisonnement sont déjà inclus.\nNi classement général des modèles, ni comparaison de vingt recherches indépendantes par cellule.", fontsize=10)
dest = HERE / "figures/09-vingt-couples-gains-tokens"
fig.savefig(dest.with_suffix(".png"), dpi=180, bbox_inches="tight")
fig.savefig(dest.with_suffix(".svg"), bbox_inches="tight")
plt.close(fig)
(HERE / "figure-vingt-couples-provenance.json").write_text(json.dumps({
    "data": str(DATA.resolve()), "sha256": hashlib.sha256(DATA.read_bytes()).hexdigest(),
    "cells": 20, "minimum_only_if_unmetered": True, "model_ranking_proved": False,
    "plot": str(dest.with_suffix(".png").resolve())}, ensure_ascii=False, indent=2)+"\n", encoding="utf8")
print(json.dumps({"figure": str(dest.with_suffix(".png")), "cells": 20}))

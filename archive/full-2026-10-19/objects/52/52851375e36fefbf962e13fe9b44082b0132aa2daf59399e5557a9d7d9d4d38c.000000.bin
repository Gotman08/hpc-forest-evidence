#include <cstdio>
#include <vector>
#include <climits>

static const int BUFSIZE = 1 << 20;
static char buf[BUFSIZE];
static int pos = 0, len = 0;

inline char getChar() {
    if (pos >= len) {
        len = fread(buf, 1, BUFSIZE, stdin);
        pos = 0;
    }
    return buf[pos++];
}

inline int readInt() {
    char c;
    do { c = getChar(); } while (c <= ' ');
    int sign = 1;
    if (c == '-') { sign = -1; c = getChar(); }
    int x = c - '0';
    for (;;) {
        c = getChar();
        if (c < '0' || c > '9') break;
        x = x * 10 + (c - '0');
    }
    return sign * x;
}

int main() {
    int n = readInt();
    int s = readInt();

    std::vector<long long> pref((size_t)(n + 1) * n, 0);
    std::vector<int> row(n);

    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            row[j] = readInt();
        }
        const int curRow = (i + 1) * n;
        const int prevRow = i * n;
        #pragma omp simd
        for (int j = 0; j < n; ++j) {
            pref[curRow + j] = pref[prevRow + j] + row[j];
        }
    }

    long long mxSum = LLONG_MIN;

    #pragma omp parallel for reduction(max:mxSum) schedule(static)
    for (int i = 0; i <= n - s; ++i) {
        const int rowStart = i * n;
        const int rowEnd   = (i + s) * n;

        long long window = 0;
        for (int j = 0; j < s; ++j) {
            window += pref[rowEnd + j] - pref[rowStart + j];
        }
        long long curMax = window;

        for (int j = s; j < n; ++j) {
            window += (pref[rowEnd + j] - pref[rowStart + j])
                    - (pref[rowEnd + (j - s)] - pref[rowStart + (j - s)]);
            if (window > curMax) curMax = window;
        }

        if (curMax > mxSum) mxSum = curMax;
    }

    printf("%lld\n", mxSum);
    return 0;
}

      "content": "#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n#include<stdint.h>\n\n/* Maximum size (in char) for neighbors and compute lists */\n#define MAX 100\n\n/* Hot metadata is packed separately from the neighbor-text slab. */\ntypedef struct {\n  int id;\n  float value;\n} Node;\n\ntypedef struct {\n  const Node *nodes;\n  const char *neighbors;\n  int size;\n  int *slots;\n  size_t mask;\n} IdIndex;\n\n/* Reads input into one allocation: node metadata followed by neighbor text. */\nNode* read_input(char* fname, int *n, char* list) {\n  Node* data = NULL;\n  FILE *fl = NULL;\n\n  if (fname == NULL)\n    fl = stdin;\n  else\n    fl = fopen(fname, \"r\");\n\n  if (fl == NULL) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n\n  fscanf(fl, \"%d %[^\\n]\", n, list);\n\n  if (*n > 0) {\n    size_t count = (size_t)*n;\n    if (count > SIZE_MAX / (sizeof(Node) + MAX)) {\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }\n    data = (Node*)malloc(count * (sizeof(Node) + MAX));\n    if (data == NULL) {\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }\n  }\n\n  char *neighbors = data ? (char*)(data + *n) : NULL;\n  for (int i = 0; i < *n; i++) {\n    char *row = neighbors + (size_t)i * MAX;\n    row[0] = '\\0';\n    fscanf(fl, \"%d %f %[^\\n]\", &data[i].id, &data[i].value, row);\n  }\n\n  fclose(fl);\n  return data;\n}\n\n/* Linear fallback over compact metadata. */\nint find_by_id(const Node g[], int id, int size) {\n  int i = 0;\n  while (i < size && g[i].id != id)\n    i++;\n  return i < size ? i : -1;\n}\n\nstatic uint32_t hash_id(int id) {\n  uint32_t x = (uint32_t)id;\n  x ^= x >> 16;\n  x *= UINT32_C(0x7feb352d);\n  x ^= x >> 15;\n  x *= UINT32_C(0x846ca68b);\n  x ^= x >> 16;\n  return x;\n}\n\n/* Buckets hold only original indices; keys remain in compact metadata. */\nvoid id_index_init(IdIndex *index, const Node *nodes, int size) {\n  index->nodes = nodes;\n  index->neighbors = nodes ? (const char*)(nodes + size) : NULL;\n  index->size = size;\n  index->slots = NULL;\n  index->mask = 0;\n\n  if (size <= 0)\n    return;\n\n  size_t required = (size_t)size;\n  if (required > SIZE_MAX / 2)\n    return;\n  required *= 2;\n\n  size_t capacity = 1;\n  while (capacity < required) {\n    if (capacity > SIZE_MAX / 2)\n      return;\n    capacity *= 2;\n  }\n  if (capacity > SIZE_MAX / sizeof(int))\n    return;\n\n  int *slots = (int*)malloc(capacity * sizeof(int));\n  if (slots == NULL)\n    return;\n\n  for (size_t i = 0; i < capacity; i++)\n    slots[i] = -1;\n\n  size_t mask = capacity - 1;\n  for (int i = 0; i < size; i++) {\n    size_t p = (size_t)hash_id(nodes[i].id) & mask;\n    while (slots[p] >= 0 && nodes[slots[p]].id != nodes[i].id)\n      p = (p + 1) & mask;\n    /* Keep the first record for duplicate IDs. */\n    if (slots[p] < 0)\n      slots[p] = i;\n  }\n\n  index->slots = slots;\n  index->mask = mask;\n}\n\n/* Returns the first matching original index, or -1 for a missing ID. */\nint id_index_find(const IdIndex *index, int id) {\n  if (index->slots == NULL)\n    return find_by_id(index->nodes, id, index->size);\n\n  size_t p = (size_t)hash_id(id) & index->mask;\n  while (index->slots[p] >= 0) {\n    int nd = index->slots[p];\n    if (index->nodes[nd].id == id)\n      return nd;\n    p = (p + 1) & index->mask;\n  }\n  return -1;\n}\n\n/* Retains the original greedy choice and recursive float addition order. */\nstatic float get_costly_at(const IdIndex *index, int nd) {\n  const Node *g = index->nodes;\n  int next = -1;\n  float max = 0;\n  char *auxptr;\n  char aux[MAX];\n\n  strcpy(aux, index->neighbors + (size_t)nd * MAX);\n  for (char *t = strtok_r(aux, \" \", &auxptr);\n       t != NULL;\n       t = strtok_r(NULL, \" \", &auxptr)) {\n    int neighbor_id = atoi(t);\n    int d = id_index_find(index, neighbor_id);\n    if (d >= 0 && max < g[d].value) {\n      max = g[d].value;\n      /* ID -1 remains a stopping sentinel even when its record exists. */\n      next = neighbor_id == -1 ? -1 : d;\n    }\n  }\n\n  float r = g[nd].value;\n  if (next != -1)\n    r += get_costly_at(index, next);\n  return r;\n}\n\nfloat get_costly(const IdIndex *index, int id) {\n  int nd = id_index_find(index, id);\n  if (nd < 0)\n    return 0;\n  return get_costly_at(index, nd);\n}\n\n/* Main program: preserves query spelling, order, duplicates and formatting. */\nint main() {\n  char *fileN = NULL;\n  char computelist[MAX] = {0};\n  int n = -1;\n  Node *input = read_input(fileN, &n, computelist);\n  IdIndex index;\n  id_index_init(&index, input, n);\n\n  for (char *c = strtok(computelist, \" \"); c != NULL; c = strtok(NULL, \" \"))\n    printf(\"%s: %f\\n\", c, get_costly(&index, atoi(c)));\n\n  free(index.slots);\n  free(input);\n  return 0;\n}\n",
      "path": "src/graph.c"
    }
  ],
  "hypothesis": "Separating compact ID/value metadata from neighbor text and using index-only hash buckets should reduce cache traffic during greedy neighbor selection.",

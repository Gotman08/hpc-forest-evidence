      "path": "src/solution.cpp",
      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <immintrin.h>\n\nint main() {\n\tint n, s;\n\tstd::cin >> n >> s;\n\tstd::vector<std::vector<int>> matrix(n, std::vector<int>(n));\n\tfor (int i = 0; i < n; i++)\n\t\tfor (int j = 0; j < n; j++) \n\t\t\tscanf(\"%d\", &(matrix[i][j]));\n\n\tassert(s < n);\n\tassert(n < 8000);\n\tassert(s > 0);\n\tassert(n > 0);\n\n\tint sum = 0;\n\tfor (int i = 0; i < s; i++)\n\t\tfor (int j = 0; j < s; j++)\n\t\t\tsum += matrix[i][j];\n\n\tint mxSum = sum;\n\n\tint dir = 1;\n\tint i = 0;\n\tint j = 0;\n\twhile (i + s <= n) {\n\t\tif ((j + s == n && dir == 1) || (j == 0 && dir == -1)) { \n\t\t\tint exitingRow = i;\n\t\t\tint enteringRow = exitingRow + s;\n\t\t\tif (enteringRow >= n) break;\n\n\t\t\t__m256i sumVec = _mm256_setzero_si256();\n\t\t\tfor (int k = 0; k < s; k += 8) {\n\t\t\t\t__m256i exitingRowVec = _mm256_loadu_si256((__m256i*)&matrix[exitingRow][k + j]);\n\t\t\t\tsumVec = _mm256_sub_epi32(sumVec, exitingRowVec);\n\t\t\t}\n\t\t\tfor (int k = 0; k < s; k += 8) {\n\t\t\t\t__m256i enteringRowVec = _mm256_loadu_si256((__m256i*)&matrix[enteringRow][k + j]);\n\t\t\t\tsumVec = _mm256_add_epi32(sumVec, enteringRowVec);\n\t\t\t}\n\n\t\t\t// Handle remaining elements if s is not a multiple of 8\n\t\t\tfor (int k = (s / 8) * 8; k < s; k++) {\n\t\t\t\tsum -= matrix[exitingRow][k + j];\n\t\t\t\tsum += matrix[enteringRow][k + j];\n\t\t\t}\n\n\t\t\tint sumArray[8];\n\t\t\t_mm256_storeu_si256((__m256i*)sumArray, sumVec);\n\t\t\tfor (int k = 0; k < 8; k++) {\n\t\t\t\tsum += sumArray[k];\n\t\t\t}\n\n\t\t\ti++;\n\t\t\tdir *= -1;\n\t\t} else {\n\t\t\tint exitingCol, enteringCol;\n\t\t\tif (dir == 1) {\n\t\t\t\texitingCol = j;\n\t\t\t\tenteringCol = exitingCol + s;\n\t\t\t} else {\n\t\t\t\tenteringCol = j - 1;\n\t\t\t\texitingCol = enteringCol + s;\n\t\t\t}\n\n\t\t\t__m256i sumVec = _mm256_setzero_si256();\n\t\t\tfor (int k = 0; k < s; k += 8) {\n\t\t\t\t__m256i exitingColVec = _mm256_loadu_si256((__m256i*)&matrix[k + i][exitingCol]);\n\t\t\t\tsumVec = _mm256_sub_epi32(sumVec, exitingColVec);\n\t\t\t}\n\t\t\tfor (int k = 0; k < s; k += 8) {\n\t\t\t\t__m256i enteringColVec = _mm256_loadu_si256((__m256i*)&matrix[k + i][enteringCol]);\n\t\t\t\tsumVec = _mm256_add_epi32(sumVec, enteringColVec);\n\t\t\t}\n\n\t\t\t// Handle remaining elements if s is not a multiple of 8\n\t\t\tfor (int k = (s / 8) * 8; k < s; k++) {\n\t\t\t\tsum -= matrix[k + i][exitingCol];\n\t\t\t\tsum += matrix[k + i][enteringCol];\n\t\t\t}\n\n\t\t\tint sumArray[8];\n\t\t\t_mm256_storeu_si256((__m256i*)sumArray, sumVec);\n\t\t\tfor (int k = 0; k < 8; k++) {\n\t\t\t\tsum += sumArray[k];\n\t\t\t}\n\n\t\t\tj += dir;\n\t\t}\n\t\tmxSum = std::max(mxSum, sum);\n\t}\n\tprintf(\"%d\\n\", mxSum);\n}"
    }

#include <iostream>
#include <vector>
#include <cstdio>
#include <algorithm>
#include <climits>

class FastScanner {
    static const int BUFSIZE = 1 << 20;
    char buf[BUFSIZE];
    int idx, size;
public:
    FastScanner() : idx(0), size(0) {}
    inline char getChar() {
        if (idx >= size) {
            size = fread(buf, 1, BUFSIZE, stdin);
            idx = 0;
            if (size == 0) return 0;
        }
        return buf[idx++];
    }
    int nextInt() {
        char c;
        do { c = getChar(); } while (c <= ' ');
        int sign = 1;
        if (c == '-') { sign = -1; c = getChar(); }
        int x = 0;
        while (c > ' ') {
            x = x * 10 + (c - '0');
            c = getChar();
        }
        return x * sign;
    }
};

int main() {
    FastScanner fs;
    int n = fs.nextInt();
    int s = fs.nextInt();

    const int N = n + 1;
    std::vector<long long> P(N * N, 0);
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            int val = fs.nextInt();
            P[(i + 1) * N + (j + 1)] = val + P[i * N + (j + 1)] + P[(i + 1) * N + j] - P[i * N + j];
        }
    }

    long long mxSum = LLONG_MIN;
    int limit_i = n - s;
    int limit_j = n - s;

    #pragma omp parallel for reduction(max:mxSum)
    for (int i = 0; i <= limit_i; ++i) {
        long long rowBest = LLONG_MIN;
        const long long* base1 = &P[i * N];
        const long long* base2 = &P[(i + s) * N];
        #pragma omp simd reduction(max:rowBest)
        for (int j = 0; j <= limit_j; ++j) {
            long long sum = base2[j + s] - base1[j + s] - base2[j] + base1[j];
            rowBest = std::max(rowBest, sum);
        }
        mxSum = std::max(mxSum, rowBest);
    }

    printf("%lld\n", mxSum);
    return 0;
}

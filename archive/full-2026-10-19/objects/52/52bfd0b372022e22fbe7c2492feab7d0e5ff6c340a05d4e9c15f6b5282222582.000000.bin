#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <limits>

int main() {
    int n, s;
    std::cin >> n >> s;

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    std::vector<std::vector<int> > matrix(n, std::vector<int>(n));
    for (int i = 0; i < n; ++i)
        for (int j = 0; j < n; ++j)
            scanf("%d", &matrix[i][j]);

    const int windowCount = n - s + 1;
    const long long lowest = std::numeric_limits<long long>::lowest();
    long long best = lowest;

    if (s == 1) {
        #pragma omp parallel for reduction(max: best) schedule(static) num_threads(4) if(n >= 512)
        for (int i = 0; i < n; ++i) {
            for (int j = 0; j < n; ++j) {
                const long long value = matrix[i][j];
                if (value > best)
                    best = value;
            }
        }
    } else {
        const int chunks = 4;
        #pragma omp parallel for reduction(max: best) schedule(static) num_threads(4) if(n >= 512)
        for (int chunk = 0; chunk < chunks; ++chunk) {
            const int firstCol = windowCount * chunk / chunks;
            const int lastCol = windowCount * (chunk + 1) / chunks;
            const int width = lastCol - firstCol;
            if (width == 0)
                continue;

            const int columnCount = width + s - 1;
            std::vector<long long> vertical(columnCount);
            for (int c = 0; c < columnCount; ++c) {
                long long sum = 0;
                for (int row = 0; row < s; ++row)
                    sum += matrix[row][firstCol + c];
                vertical[c] = sum;
            }

            long long chunkBest = lowest;
            for (int top = 0; top < windowCount; ++top) {
                long long sum = 0;
                for (int c = 0; c < s; ++c)
                    sum += vertical[c];
                if (sum > chunkBest)
                    chunkBest = sum;

                for (int offset = 1; offset < width; ++offset) {
                    sum += vertical[offset + s - 1] - vertical[offset - 1];
                    if (sum > chunkBest)
                        chunkBest = sum;
                }

                if (top + 1 < windowCount) {
                    const int enteringRow = top + s;
                    for (int c = 0; c < columnCount; ++c)
                        vertical[c] += static_cast<long long>(matrix[enteringRow][firstCol + c])
                                     - matrix[top][firstCol + c];
                }
            }

            if (chunkBest > best)
                best = chunkBest;
        }
    }

    printf("%lld\n", best);
    return 0;
}

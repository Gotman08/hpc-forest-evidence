#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <climits>
#include <omp.h>

void block_max_sum(const std::vector<std::vector<int>>& matrix, int s, int& mxSum) {
    int n = matrix.size();
    int sum = 0;
    for(int i=0; i<s; i++)
        for(int j=0; j<s; j++)
            sum += matrix[i][j];

    mxSum = sum;

    #pragma omp parallel for collapse(2)
    for(int i=0; i<n-s+1; i++) {
        int current_sum = sum;
        for(int j=0; j<n-s+1; j++) {
            if (j > 0) {
                for(int k=0; k<s; k++) {
                    current_sum -= matrix[i+k][j-1];
                    current_sum += matrix[i+k][j+s-1];
                }
            }
            mxSum = std::max(mxSum, current_sum);
        }
    }
}

int main() {
    int n, s;
    std::cin >> n >> s;
    std::vector<std::vector<int>> matrix(n, std::vector<int>(n));
    for(int i=0; i<n; i++)
        for(int j=0; j<n; j++) 
            scanf("%d", &(matrix[i][j]));

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    int mxSum = INT_MIN;
    block_max_sum(matrix, s, mxSum);

    printf("%d\n", mxSum);
}
"""Write a bounded, non-admitted proposal from closed metadata; no process or transport."""

from __future__ import annotations

import copy
import difflib
import hashlib
import json
from datetime import UTC, datetime
from pathlib import Path

BASE = Path(__file__).resolve().parents[3]
HERE = Path(__file__).resolve().parent
OLD = BASE / "work/hpc-forest-primes-native-max-r2d/project"
NEW = BASE / "work/hpc-forest-primes-natif-relance-r2e/project"
REL = BASE / "outputs/HPC-Forest-Primes-Natif-Relance-r2d"


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def read(path):
    return json.loads(path.read_text(encoding="utf-8-sig"))


def ref(path):
    return {"path": str(path), "sha256": sha(path)}


def write(name, value):
    path = HERE / name
    if path.exists():
        raise RuntimeError(f"Refuse overwrite: {name}")
    path.write_text(json.dumps(value, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    return ref(path)


def referenced(piece):
    path = Path(piece["path"])
    if sha(path) != piece["sha256"]:
        raise RuntimeError("Cold metadata reference changed")
    return read(path)


def main():
    reservation_path = HERE / "SESSIONS-NEUVES-RESERVEES.json"
    reservation = read(reservation_path)
    assert sha(reservation_path) == "64a5b1b5669690ac29860b39b26a7ffb4e9ea0b6ddab9e508fa9c2565760304f"
    cells = reservation["cells"]
    rows = []
    for slug, job, model in (
        ("astra", "752650", "gpt-6-astra"),
        ("terra", "752651", "gpt-5.6-terra"),
        ("sol", "752652", "gpt-6.1-sol"),
    ):
        recon_path = REL / f"reception-{slug}-{job}/audit-metadata-r1/RECONCILIATION-METADATA-BORNEE.json"
        recon = read(recon_path)
        assert recon["verified"] is True and recon["all_archive_requests_delivered"] is True
        assert recon["model"] == model and recon["effort"] == "max"
        timed_out = [c for c in recon["calls"] if c["process_timed_out"] is True]
        assert len(timed_out) == 1
        call = timed_out[0]
        process = referenced(call["process"])
        claim = referenced(call["generation_claim"])
        assert process["timed_out"] is True and process["returncode"] == 1
        rows.append({
            "job_id": job, "model": model, "nonce_historical_never_replayed": call["nonce"],
            "reconciliation": ref(recon_path), "process_metadata": call["process"],
            "generation_claim_metadata": call["generation_claim"],
            "request_reference_only_not_opened_here": call["request"],
            "claimed_at": claim["claimed_at"], "process_seconds": process["seconds"],
            "process_returncode": process["returncode"], "process_timed_out": True,
            "delivered_at": call["delivered_at"],
            "consumption_exact_unknown": call["exact_consumption_unknown"],
            "reserved_or_upper_bound_not_exact_consumption": call["reserved_or_upper_bound_tokens"],
            "exact_backend_cause_established": False,
            "historical_taskkill_execution_established": False,
        })

    modules = ["node_harness.py", "codex_mailbox.py", "controller.py", "mother.py"]
    preserved_budget_sources = {}
    for name in modules:
        old = OLD / "src/hpc_forest" / name
        new = NEW / "src/hpc_forest" / name
        assert old.read_bytes() == new.read_bytes()
        preserved_budget_sources[name] = {"old": ref(old), "new": ref(new), "byte_identical": True}

    core_path = NEW / "src/hpc_forest/core.py"
    old_core = OLD / "src/hpc_forest/core.py"
    core_diff = "".join(difflib.unified_diff(
        old_core.read_text(encoding="utf-8").splitlines(keepends=True),
        core_path.read_text(encoding="utf-8").splitlines(keepends=True),
        fromfile="sealed-r2d/src/hpc_forest/core.py", tofile="new-r2e/src/hpc_forest/core.py",
    ))
    diff_path = HERE / "DIFF-CORE-WINDOWS.patch"
    if diff_path.exists():
        raise RuntimeError("Refuse overwrite diff")
    diff_path.write_text(core_diff, encoding="utf-8")

    diagnostic = write("DIAGNOSTIC-DELAIS-ET-WATCHDOG.json", {
        "schema": "hpc-forest-r2e-closed-timeout-metadata-and-owned-watchdog-diagnosis-v1",
        "verified": True, "created_utc": datetime.now(UTC).isoformat(),
        "scope": "Three closed R2d timeout metadata records and source watchdog/budget path only",
        "expired_calls": rows,
        "preserved_budget_sources": preserved_budget_sources,
        "budget_path": [
            "NodeHarness shares one generation deadline across attempts: min(now+600, cell_deadline-120)",
            "Mailbox request expires no later than the same deadline",
            "run_codex passes expires_at-now-5 seconds to run_process",
            "Watchdog records timed_out; expiration alone is not a backend defect",
        ],
        "budget_600_or_1800_bug_established": False,
        "exact_process_start_epoch_persisted": False,
        "watchdog_scope_code_defect_established": True,
        "defect": "Old Windows branch invokes taskkill /PID /T /F and can target descendants not owned by its Popen object",
        "historical_recursive_stop_execution_or_backend_causality_established": False,
        "correction": "Windows calls kill on the same retained Popen object only; no numeric PID reopen or tree traversal",
        "core_before": ref(old_core), "core_after": ref(core_path), "closed_diff": ref(diff_path),
        "posix_group_branch_behavior_unchanged": True,
        "native_ARM64_execution_of_new_source_proved_here": False,
        "model_or_candidate_bodies_opened_here": False,
        "live_cache_or_SQLite_or_lock_opened_here": False,
        "processes_or_CLI_or_models_or_jobs_started_here": 0,
        "algorithm_or_oracle_repair": False,
    })

    old_plan_path = BASE / "outputs/HPC-Forest-Primes-Natif-MAX-r2/revision-r2d/native-max-plan.json"
    old_plan = read(old_plan_path)
    plan = copy.deepcopy(old_plan)
    plan.update({
        "scope_id": reservation["scope_id"], "created_utc": datetime.now(UTC).isoformat(),
        "status": "local_r2e_fresh_MAX_proposal_pending_sealed_source_and_new_allocated_qualification",
        "source_zip_sha256": None, "preparation_manifest_sha256": None,
        "preparation_review_sha256": None, "cells": cells,
        "parent_r2d_source_zip_sha256": old_plan["source_zip_sha256"],
        "parent_r2d_plan_sha256": sha(old_plan_path),
        "historical_sessions": old_plan["cells"],
        "source_pins_pending_are_not_positive_admissions": True,
        "reserved_sessions_receipt": ref(reservation_path),
        "watchdog_diagnostic": diagnostic,
        "cli_normal_diagnostics_must_be_absent_not_allowlisted": True,
        "exact_new_CLI_argv_compatibility_requires_separate_received_proof": True,
        "new_source_qualification_required_not_old_Q_relabelled": True,
        "first_NORMAL_delivered_and_first_evaluation_before_any_extension": True,
        "technical_error_delivery_must_hold_before_new_claim": True,
        "hardware_requested": {"nodes": 1, "tasks": 1, "cpus": 4, "memory_mib": 16384, "gpus": 0, "architecture": "aarch64"},
    })
    for cell in plan["projected_cells"]:
        model = cell["model"]
        cell["historical_session_id_not_reused"] = old_plan["cells"][model]
        cell["session_id_reserved_not_started"] = cells[model]
        cell["fresh_root_name"] = cell["fresh_root_name"].replace("r2d-", "r2e-", 1)
    draft = write("PLAN-R2E-PREPARE-NON-ADMIS.json", plan)
    write("ADMISSIONS-R2E-A-RECEVOIR.json", {
        "schema": "hpc-forest-r2e-external-admission-preparation-not-a-receipt-v1",
        "verified": False, "native_research_admitted": False,
        "plan_draft": draft, "scope_id": reservation["scope_id"], "cells": cells,
        "source_zip": None, "runtime_manifest": None, "source_review": None,
        "allocated_contract_qualification": None, "allocated_contract_reception": None,
        "old_Q752606_authorizes_new_source": False,
        "maximum_native_workers_total": 4, "source_only_received_absent_count": 0,
        "source_only_preserved_live": False,
        "historical_corrected_reader": ref(BASE / "outputs/HPC-Forest-Primes-Natif-Lancement-r2d/source-only-reader-r4/source_only_state.py"),
        "historical_corrected_verifier": ref(BASE / "outputs/HPC-Forest-Primes-Natif-Lancement-r2d/source-only-reader-r4/verifier-current.py"),
        "closed_R2d_preservation": ref(REL / "operations-parent-attempt2/preservation-caches-complete/PRESERVATION-COMPLETE-ET-ABSENCE-PAIRES.json"),
        "new_CURRENT_absence_and_session_freshness": None,
        "new_CLI4_identity_and_compatibility": None,
        "new_OAuth_status_no_API": None,
        "new_transport_admission": None,
        "new_factory_independent_review": None,
        "required_fourteen_artifacts": plan["required_admission_artifacts"],
        "next_path": [
            "Seal and independently review the new R2e source, plan and runtime manifest; keep source correction separate from all historical outcomes",
            "Qualify the changed source under allocation and receive/audit the actual result; old Q752606 remains historical",
            "Prepare an isolated external factory revision with exact new bindings and the reviewed corrected source-only reader",
            "Capture fresh full identities/CURRENT/session absence and exact OAuth CLI4 compatibility; no copied positive template",
            "Render three fresh source-bound intents/allocation markers and cohort cap4; immutable fourteen admission artifacts before authorization",
            "Publish minimal directory/readback, ready last; own object launch only after actual admissions",
            "Receive the first NORMAL delivered call and first evaluation for each new cell; preserve/hold on diagnostics, no automatic extension",
        ],
        "allocation_and_audit_deadline_rechecked_after_wait_required": True,
        "jobs_submitted_here": 0, "model_calls_here": 0,
    })
    print(json.dumps({"verified_local_preparation_only": True, "draft": draft, "diagnostic": diagnostic}, ensure_ascii=False))


if __name__ == "__main__":
    main()

      "content": "#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <limits>\n#include <memory>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\nclass FastInput {\n    static constexpr std::size_t kBufferSize = 1u << 16;\n    char buffer_[kBufferSize];\n    std::size_t position_ = 0;\n    std::size_t size_ = 0;\n\n    int next_char() {\n        if (position_ == size_) {\n            size_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (size_ == 0) {\n                return EOF;\n            }\n        }\n        return static_cast<unsigned char>(buffer_[position_++]);\n    }\n\npublic:\n    bool read_int(int& value) {\n        int character;\n        do {\n            character = next_char();\n            if (character == EOF) {\n                return false;\n            }\n        } while (character <= ' ');\n\n        bool negative = false;\n        if (character == '-' || character == '+') {\n            negative = character == '-';\n            character = next_char();\n        }\n\n        std::int64_t number = 0;\n        while (character >= '0' && character <= '9') {\n            number = number * 10 + (character - '0');\n            character = next_char();\n        }\n        value = static_cast<int>(negative ? -number : number);\n        return true;\n    }\n};\n\nstatic inline std::int64_t add_row(\n    std::int64_t* __restrict__ vertical,\n    std::int64_t* __restrict__ slot,\n    const std::int64_t* __restrict__ current,\n    int count) {\n    std::int64_t maximum = std::numeric_limits<std::int64_t>::min();\n    int column = 0;\n\n#if defined(__aarch64__)\n    if (count >= 2) {\n        int64x2_t vector_maximum = vdupq_n_s64(maximum);\n        for (; column + 1 < count; column += 2) {\n            const int64x2_t incoming = vld1q_s64(current + column);\n            const int64x2_t total = vaddq_s64(vld1q_s64(vertical + column), incoming);\n            vst1q_s64(vertical + column, total);\n            vst1q_s64(slot + column, incoming);\n            const uint64x2_t take_total = vcgtq_s64(total, vector_maximum);\n            vector_maximum = vbslq_s64(take_total, total, vector_maximum);\n        }\n        maximum = vgetq_lane_s64(vector_maximum, 0);\n        const std::int64_t other = vgetq_lane_s64(vector_maximum, 1);\n        if (other > maximum) {\n            maximum = other;\n        }\n    }\n#endif\n\n    for (; column < count; ++column) {\n        const std::int64_t total = vertical[column] + current[column];\n        vertical[column] = total;\n        slot[column] = current[column];\n        if (total > maximum) {\n            maximum = total;\n        }\n    }\n    return maximum;\n}\n\nstatic inline std::int64_t replace_row(\n    std::int64_t* __restrict__ vertical,\n    std::int64_t* __restrict__ slot,\n    const std::int64_t* __restrict__ current,\n    int count) {\n    std::int64_t maximum = std::numeric_limits<std::int64_t>::min();\n    int column = 0;\n\n#if defined(__aarch64__)\n    if (count >= 2) {\n        int64x2_t vector_maximum = vdupq_n_s64(maximum);\n        for (; column + 1 < count; column += 2) {\n            const int64x2_t incoming = vld1q_s64(current + column);\n            const int64x2_t outgoing = vld1q_s64(slot + column);\n            const int64x2_t total = vaddq_s64(vld1q_s64(vertical + column), vsubq_s64(incoming, outgoing));\n            vst1q_s64(vertical + column, total);\n            vst1q_s64(slot + column, incoming);\n            const uint64x2_t take_total = vcgtq_s64(total, vector_maximum);\n            vector_maximum = vbslq_s64(take_total, total, vector_maximum);\n        }\n        maximum = vgetq_lane_s64(vector_maximum, 0);\n        const std::int64_t other = vgetq_lane_s64(vector_maximum, 1);\n        if (other > maximum) {\n            maximum = other;\n        }\n    }\n#endif\n\n    for (; column < count; ++column) {\n        const std::int64_t total = vertical[column] + (current[column] - slot[column]);\n        vertical[column] = total;\n        slot[column] = current[column];\n        if (total > maximum) {\n            maximum = total;\n        }\n    }\n    return maximum;\n}\n\nint main() {\n    FastInput input;\n    int n;\n    int s;\n    if (!input.read_int(n) || !input.read_int(s)) {\n        return 0;\n    }\n    if (n <= 0 || s <= 0 || s >= n) {\n        return 0;\n    }\n\n    const int window_count = n - s + 1;\n    const std::size_t history_count =\n        static_cast<std::size_t>(s) * static_cast<std::size_t>(window_count);\n\n    std::unique_ptr<std::int64_t[]> history(new std::int64_t[history_count]);\n    std::unique_ptr<std::int64_t[]> vertical(new std::int64_t[window_count]());\n    std::unique_ptr<std::int64_t[]> horizontal(new std::int64_t[window_count]);\n    std::unique_ptr<int[]> input_ring(new int[s]);\n\n    std::int64_t maximum = std::numeric_limits<std::int64_t>::min();\n\n    for (int row = 0; row < n; ++row) {\n        std::int64_t horizontal_sum = 0;\n        for (int column = 0; column < s; ++column) {\n            int value;\n            input.read_int(value);\n            input_ring[column] = value;\n            horizontal_sum += static_cast<std::int64_t>(value);\n        }\n        horizontal[0] = horizontal_sum;\n\n        for (int column = s, ring_index = 0; column < n; ++column) {\n            int value;\n            input.read_int(value);\n            horizontal_sum += static_cast<std::int64_t>(value) - input_ring[ring_index];\n            input_ring[ring_index] = value;\n            if (++ring_index == s) {\n                ring_index = 0;\n            }\n            horizontal[column - s + 1] = horizontal_sum;\n        }\n\n        std::int64_t* const slot = history.get() +\n            static_cast<std::size_t>(row % s) * static_cast<std::size_t>(window_count);\n        const std::int64_t row_maximum = row < s\n            ? add_row(vertical.get(), slot, horizontal.get(), window_count)\n            : replace_row(vertical.get(), slot, horizontal.get(), window_count);\n\n        if (row + 1 >= s && row_maximum > maximum) {\n            maximum = row_maximum;\n        }\n    }\n\n    std::printf(\"%lld\\n\", static_cast<long long>(maximum));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

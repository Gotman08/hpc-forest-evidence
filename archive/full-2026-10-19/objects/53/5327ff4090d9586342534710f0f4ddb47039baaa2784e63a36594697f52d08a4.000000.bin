"""PROPOSED compute-allocation command. Do not execute locally or on login."""
from __future__ import annotations

import hashlib
import json
import os
import platform
import re
import subprocess
import sys
import tarfile
from datetime import UTC, datetime, timedelta
from pathlib import Path, PurePosixPath

PAYLOAD = Path("/scratch_p/nimarano/hpc-forest-primes-certified-e1116d931887fbeb.tar.gz")
PAYLOAD_SHA = "e1116d931887fbebad63e88a7678df13bc09e0381a754d967c79ae8ac7c37eda"
MANIFEST_SHA = "d260af0a7b91cbe5fc7e3ab1ad9313723e385c21fdd75bd5c9623095683022fd"
REVIEW_SHA = "af703fd382e2065eb966cebfd3eb201ee6286826dbc28802185c22c5932269ab"
PYTHON = "/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python"
ROOT = Path("/scratch_p/nimarano/hpc-forest-primes-certified-qualification-20261017-r1-e1116d931887")
SCOPE = "hpc-forest-primes-max-certifie-r1"
DEADLINE = datetime(2026, 10, 31, 23, tzinfo=UTC)


def require(value, message):
    if not value:
        raise RuntimeError(message)


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def save(path, value):
    with path.open("x", encoding="utf8") as stream:
        json.dump(value, stream, ensure_ascii=True, indent=2)
        stream.write("\n")


def inventory(path):
    return {item.relative_to(path).as_posix(): sha(item)
            for item in sorted(path.rglob("*")) if item.is_file()}


def allocation_guard():
    env = os.environ
    require(platform.system() == "Linux" and platform.machine().lower() in ("aarch64", "arm64"),
            "Linux ARM64 compute allocation required")
    require(re.fullmatch(r"[0-9]+", env.get("SLURM_JOB_ID", "")), "Concrete Slurm job required")
    require(env.get("SLURM_JOB_NUM_NODES") == "1" and env.get("SLURM_NTASKS") == "1"
            and env.get("SLURM_CPUS_PER_TASK") == "4" and env.get("SLURM_MEM_PER_NODE") == "16384",
            "Exact 1 node/task,4CPU,16GiB allocation required")
    require(not env.get("SLURM_JOB_GPUS") and env.get("CUDA_VISIBLE_DEVICES", "") in ("", "-1", "NoDevFiles"),
            "Zero GPU allocation required")
    require(len(os.sched_getaffinity(0)) >= 4, "Insufficient CPU affinity")
    require(datetime.now(UTC) + timedelta(seconds=900 + 10800) < DEADLINE,
            "15min qualification plus3h reception reserve exceeds deadline")


def restore_payload(destination):
    require(PAYLOAD.is_file() and not PAYLOAD.is_symlink() and sha(PAYLOAD) == PAYLOAD_SHA,
            "Payload SHA/type changed")
    with tarfile.open(PAYLOAD, "r:gz") as archive:
        members = archive.getmembers()
        require(len(members) == 67 and sum(item.size for item in members) < 64 * 1024**2,
                "Unexpected payload count/size")
        material = {}
        for item in members:
            name = PurePosixPath(item.name)
            require(item.isfile() and not item.issym() and not item.islnk()
                    and not name.is_absolute() and ".." not in name.parts and "\\" not in item.name
                    and name.parts[0] == SCOPE, "Unsafe payload member")
            relative = name.relative_to(SCOPE).as_posix()
            require(relative not in material and item.size <= 4 * 1024**2, "Duplicate/oversized payload member")
            material[relative] = archive.extractfile(item).read()
    require(hashlib.sha256(material["prototype-manifest.json"]).hexdigest() == MANIFEST_SHA,
            "Manifest SHA changed")
    manifest = json.loads(material["prototype-manifest.json"])
    require(set(material) == set(manifest) | {"prototype-manifest.json"} and len(manifest) == 66,
            "Manifest membership differs")
    for name, info in manifest.items():
        require(len(material[name]) == info["bytes"]
                and hashlib.sha256(material[name]).hexdigest() == info["sha256"], "Manifest member differs")
    destination.mkdir()
    for name, raw in material.items():
        target = destination / name
        require(target.resolve().is_relative_to(destination.resolve()), "Extraction escaped new root")
        target.parent.mkdir(parents=True, exist_ok=True)
        with target.open("xb") as stream:
            stream.write(raw)
    require(inventory(destination) == {name: hashlib.sha256(raw).hexdigest() for name, raw in material.items()},
            "Fresh extraction differs")


def main():
    allocation_guard()  # No file creation, subprocess, or compiler before these guards.
    require(not ROOT.exists(), "Prior attempt exists; preserve it without replay")
    ROOT.mkdir()
    save(ROOT / "allocation.json", {
        "utc": datetime.now(UTC).isoformat(), "platform": platform.platform(), "python": sys.version,
        "job_id": os.environ["SLURM_JOB_ID"], "affinity_cpu_count": len(os.sched_getaffinity(0)),
        "slurm": {key: os.environ.get(key) for key in (
            "SLURM_JOB_ID", "SLURM_JOB_NUM_NODES", "SLURM_NTASKS", "SLURM_CPUS_PER_TASK",
            "SLURM_MEM_PER_NODE", "SLURM_JOB_GPUS", "SLURM_RESTART_COUNT", "SLURM_JOB_NODELIST")},
        "payload_sha256": PAYLOAD_SHA, "manifest_sha256": MANIFEST_SHA, "review_sha256": REVIEW_SHA,
        "native_model_calls": 0, "native_research_admitted": False})
    extraction = ROOT / "extraction"
    before = None
    passed = False
    failure = None
    code = 1
    try:
        restore_payload(extraction)
        before = inventory(extraction)
        sys.path.insert(0, str(extraction / "tools"))
        import validate
        checked = validate.validate_preparation(extraction / "data")
        require(len(checked["cases"]) == 12 and sorted(row["p"] for row in checked["cases"])
                == [1, 1, 2, 2, 4, 4, 8, 8, 16, 16, 30, 30], "Twelve exact certified cases required")
        save(ROOT / "pre-execution-data-audit.json", checked)
        require(datetime.now(UTC) + timedelta(seconds=900 + 10800) < DEADLINE, "Deadline changed after restore")
        try:
            completed = subprocess.run(
                [PYTHON, "-B", str(extraction / "tools/qualify_arm64.py"), "--data", str(extraction / "data"),
                 "--output", str(ROOT / "qualification")], capture_output=True, check=False, timeout=720)
            stdout, stderr, code = completed.stdout, completed.stderr, completed.returncode
        except subprocess.TimeoutExpired as exc:
            stdout, stderr, code = exc.stdout or b"", exc.stderr or b"", 124
            failure = "Owned qualification process timeout; preserved, never retried"
        (ROOT / "qualification-launch.stdout").write_bytes(stdout)
        (ROOT / "qualification-launch.stderr").write_bytes(stderr)
        proof = json.loads((ROOT / "qualification/qualification.json").read_text())
        passed = (code == 0 and proof["status"] == "mechanical_reference_passed_not_native_model_admitted"
                  and len(proof["cases"]) == 12 and proof["source_and_data_unchanged"] is True
                  and proof["native_model_calls"] == 0 and proof["native_research_admitted"] is False)
    except (OSError, ValueError, RuntimeError, KeyError, TypeError, tarfile.TarError) as exc:
        failure = type(exc).__name__ + ": " + str(exc)
    after = inventory(extraction) if extraction.exists() else None
    unchanged = before is not None and before == after
    passed = passed and unchanged
    save(ROOT / "mechanical-reception.json", {
        "status": "mechanical_reference_passed_pending_independent_reception" if passed else "failed_preserved_no_retry",
        "job_id": os.environ["SLURM_JOB_ID"], "passed": passed, "qualification_returncode": code,
        "failure": failure, "payload_sha256": PAYLOAD_SHA, "review_sha256": REVIEW_SHA,
        "all67_extracted_files_unchanged": unchanged, "inventory_before": before, "inventory_after": after,
        "native_model_calls": 0, "native_research_admitted": False, "performance_claimed": False})
    archive = ROOT / ("results-" + os.environ["SLURM_JOB_ID"] + ".tar.gz")
    paths = sorted(path for path in ROOT.rglob("*") if path.is_file())
    with tarfile.open(archive, "x:gz") as output:
        for path in paths:
            output.add(path, arcname="qualification-results/" + path.relative_to(ROOT).as_posix(), recursive=False)
    archive_sha = sha(archive)
    save(ROOT / "archive-sha256.json", {"path": str(archive), "sha256": archive_sha,
                                        "bytes": archive.stat().st_size, "passed": passed})
    print(json.dumps({"archive": str(archive), "archive_sha256": archive_sha, "passed": passed,
                      "native_model_calls": 0, "native_research_admitted": False}))
    raise SystemExit(0 if passed else 1)


if __name__ == "__main__":
    main()

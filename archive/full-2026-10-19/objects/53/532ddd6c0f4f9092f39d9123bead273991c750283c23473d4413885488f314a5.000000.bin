    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n#include <omp.h>\\n#include <float.h>\\n\\ntypedef struct {\\n    float dist;\\n    char label;\\n    int idx;\\n} Candidate;\\n\\nint compare_candidates(const void *a, const void *b) {\\n    Candidate *ca = (Candidate *)a;\\n    Candidate *cb = (Candidate *)b;\\n    if (ca->dist < cb->dist) return -1;\\n    if (ca->dist > cb->dist) return 1;\\n    if (ca->idx < cb->idx) return -1;\\n    if (ca->idx > cb->idx) return 1;\\n    return 0;\\n}\\n\\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n    // Precompute cumulative lengths for global indexing\\n    int *cum = (int *)malloc((n_groups + 1) * sizeof(int));\\n    cum[0] = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        cum[i+1] = cum[i] + groups[i].length;\\n    }\\n\\n    int num_threads = omp_get_max_threads();\\n    // Allocate per-thread local top-k arrays\\n    float (*dist_local)[k] = (float(*)[k])malloc(num_threads * k * sizeof(float));\\n    char  (*lab_local)[k]  = (char(*)[k])malloc(num_threads * k * sizeof(char));\\n    int   (*idx_local)[k]  = (int(*)[k])malloc(num_threads * k * sizeof(int));\\n\\n    // Initialize all entries to sentinel values\\n    #pragma omp parallel for schedule(static) num_threads(num_threads)\\n    for (int t = 0; t < num_threads; t++) {\\n        for (int j = 0; j < k; j++) {\\n            dist_local[t][j] = FLT_MAX;\\n            lab_local[t][j] = -1;\\n            idx_local[t][j] = -1;\\n        }\\n    }\\n\\n    #pragma omp parallel default(none) shared(n_groups, groups, to_evaluate, k, cum, dist_local, lab_local, idx_local)\\n    {\\n        int tid = omp_get_thread_num();\\n\\n        #pragma omp for schedule(dynamic)\\n        for (int i = 0; i < n_groups; i++) {\\n            Group g = groups[i];\\n            float *dist_tid = dist_local[tid];\\n            char  *lab_tid  = lab_local[tid];\\n            int   *idx_tid  = idx_local[tid];\\n\\n            for (int j = 0; j < g.length; j++) {\\n                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n                int global_idx = cum[i] + j;\\n\\n                // Insert into local top-k list\\n                int x;\\n                for (x = 0; x < k; x++) {\\n                    if (d < dist_tid[x]) break;\\n                }\\n                if (x < k) {\\n                    // Shift elements right from x to k-2\\n                    for (int y = k - 1; y > x; y--) {\\n                        dist_tid[y] = dist_tid[y-1];\\n                        lab_tid[y]  = lab_tid[y-1];\\n                        idx_tid[y]  = idx_tid[y-1];\\n                    }\\n                    dist_tid[x] = d;\\n                    lab_tid[x]  = g.label;\\n                    idx_tid[x]  = global_idx;\\n                }\\n            }\\n        }\\n    }\\n\\n    // Collect all candidates from per-thread arrays\\n    int total_candidates = 0;\\n    for (int t = 0; t < num_threads; t++) {\\n        for (int j = 0; j < k; j++) {\\n            if (dist_local[t][j] != FLT_MAX) {\\n                total_candidates++;\\n            }\\n        }\\n    }\\n\\n    Candidate *cands = (Candidate *)malloc(total_candidates * sizeof(Candidate));\\n    int pos = 0;\\n    for (int t = 0; t < num_threads; t++) {\\n        for (int j = 0; j < k; j++) {\\n            if (dist_local[t][j] != FLT_MAX) {\\n                cands[pos].dist  = dist_local[t][j];\\n                cands[pos].label = lab_local[t][j];\\n                cands[pos].idx   = idx_local[t][j];\\n                pos++;\\n            }\\n        }\\n    }\\n\\n    // Sort by distance then global index\\n    qsort(cands, total_candidates, sizeof(Candidate), compare_candidates);\\n\\n    // Extract top-k labels (first k after sorting)\\n    char *labels = (char *)malloc(k * sizeof(char));\\n    for (int i = 0; i < k && i < total_candidates; i++) {\\n        labels[i] = cands[i].label;\\n    }\\n\\n    free(cands);\\n    free(dist_local);\\n    free(lab_local);\\n    free(idx_local);\\n    free(cum);\\n\\n    // Compute most frequent label (same as original)\\n    qsort(labels, k, sizeof(char), compare_for_sort);\\n\\n    char most_frequent = labels[0];\\n    int most_frequent_count = 1;\\n    int current_frequency = 1;\\n\\n    for (int i = 1; i < k; i++) {\\n        if (labels[i] != labels[i - 1]) {\\n            if (current_frequency > most_frequent_count) {\\n                most_frequent = labels[i - 1];\\n                most_frequent_count = current_frequency;\\n            }\\n            current_frequency = 1;\\n        } else {\\n            current_frequency++;\\n        }\\n\\n        if (i == k - 1 && current_frequency > most_frequent_count) {\\n            most_frequent = labels[i - 1];\\n            most_frequent_count = current_frequency;\\n        }\\n    }\\n\\n    free(labels);\\n    return most_frequent;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Using OpenMP dynamic scheduling over groups with per-thread local top-k arrays storing distance, label, and global point index ensures load balance across variable-length groups while preserving exact sequential output order via a deterministic merge by distance then global insertion index.\",\n  \"notes\": \"Precomputed cumulative group lengths for global indexing. Each thread maintains its own private top-k list (distance, label, global_index). After parallel region, all per-thread candidates are merged into one array and sorted by distance then global index to select the final k nearest neighbors. Th
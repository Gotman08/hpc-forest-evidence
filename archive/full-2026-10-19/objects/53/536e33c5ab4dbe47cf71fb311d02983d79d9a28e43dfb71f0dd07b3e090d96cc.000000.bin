#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <climits>

int main() {
    int n, s;
    std::cin >> n >> s;

    // Read matrix into flat array (row-major)
    std::vector<int> mat(n * n);
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            scanf("%d", &mat[i * n + j]);
        }
    }

    assert(s > 0 && s < n && n > 0);

    // Prefix sum matrix of size (n+1)x(n+1)
    int ps_rows = n + 1;
    std::vector<long long> ps(ps_rows * ps_rows, 0LL);

    // Compute prefix sums
    for (int i = 0; i < n; ++i) {
        int base_i = i * ps_rows;
        int next_i = (i + 1) * ps_rows;
        for (int j = 0; j < n; ++j) {
            long long val = mat[i * n + j];
            ps[next_i + j + 1] = val + ps[base_i + j + 1] + ps[next_i + j] - ps[base_i + j];
        }
    }

    // Find maximum sum of SxS submatrices
    long long mxSum = LLONG_MIN;
    #pragma omp parallel for reduction(max:mxSum) schedule(static)
    for (int i = 0; i <= n - s; ++i) {
        int base_i = i * ps_rows;
        int next_i = (i + s) * ps_rows;
        for (int j = 0; j <= n - s; ++j) {
            long long sum = ps[next_i + j + s] - ps[base_i + j + s]
                          - ps[next_i + j] + ps[base_i + j];
            if (sum > mxSum) mxSum = sum;
        }
    }

    printf("%d\n", static_cast<int>(mxSum));
    return 0;
}

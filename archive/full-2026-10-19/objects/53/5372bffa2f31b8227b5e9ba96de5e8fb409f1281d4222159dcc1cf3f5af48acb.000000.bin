#include "knn.h"
#include <arm_neon.h>
#include <omp.h>
#include <float.h>

// Insert distance and label into a sorted array (ascending) of size k.
// Returns new filled count. If already full, only inserts if d is better than worst.
static inline int insert_sorted(float *dists, char *labels, int filled, int k,
                                float d, char label) {
    if (filled < k) {
        // Insert into sorted position
        int pos = filled;
        while (pos > 0 && dists[pos - 1] > d) {
            dists[pos] = dists[pos - 1];
            labels[pos] = labels[pos - 1];
            pos--;
        }
        dists[pos] = d;
        labels[pos] = label;
        return filled + 1;
    } else if (d < dists[k - 1]) {
        // Replace worst and bubble down
        int pos = k - 1;
        while (pos > 0 && dists[pos - 1] > d) {
            dists[pos] = dists[pos - 1];
            labels[pos] = labels[pos - 1];
            pos--;
        }
        dists[pos] = d;
        labels[pos] = label;
    }
    return filled;
}

char knn(int n_groups, Group *groups, int k, Point to_evaluate) {
    int max_threads = omp_get_max_threads();
    if (max_threads < 1) max_threads = 1;

    // Per-thread sorted arrays and filled counts
    float **thread_dists = (float**) malloc(max_threads * sizeof(float*));
    char **thread_labels = (char**) malloc(max_threads * sizeof(char*));
    int *thread_filled = (int*) calloc(max_threads, sizeof(int));

    for (int t = 0; t < max_threads; t++) {
        thread_dists[t] = (float*) malloc(k * sizeof(float));
        thread_labels[t] = (char*) malloc(k * sizeof(char));
        // Initialize with sentinel values
        for (int i = 0; i < k; i++) {
            thread_dists[t][i] = FLT_MAX;
            thread_labels[t][i] = -1;
        }
    }

    float px = to_evaluate.x;
    float py = to_evaluate.y;

    #pragma omp parallel for schedule(dynamic)
    for (int gi = 0; gi < n_groups; gi++) {
        int tid = omp_get_thread_num();
        float *local_dists = thread_dists[tid];
        char *local_labels = thread_labels[tid];
        int *filled_ptr = &thread_filled[tid];

        Group g = groups[gi];
        float *xs = g.xs;
        float *ys = g.ys;
        int len = g.length;
        char label = g.label;

        // Process points in batches of 16 using NEON SIMD
        int j = 0;
        for (; j + 15 < len; j += 16) {
            __builtin_prefetch(xs + j + 64);
            __builtin_prefetch(ys + j + 64);

            float32x4x4_t x_vec_quad = vld1q_f32_x4(xs + j);
            float32x4x4_t y_vec_quad = vld1q_f32_x4(ys + j);

            // Compute distances for 16 points (four vectors of four)
            float32x4_t dx0 = vsubq_f32(x_vec_quad.val[0], vdupq_n_f32(px));
            float32x4_t dy0 = vsubq_f32(y_vec_quad.val[0], vdupq_n_f32(py));
            float32x4_t dist_sq0 = vmlaq_f32(vmulq_f32(dx0, dx0), dy0, dy0);

            float32x4_t dx1 = vsubq_f32(x_vec_quad.val[1], vdupq_n_f32(px));
            float32x4_t dy1 = vsubq_f32(y_vec_quad.val[1], vdupq_n_f32(py));
            float32x4_t dist_sq1 = vmlaq_f32(vmulq_f32(dx1, dx1), dy1, dy1);

            float32x4_t dx2 = vsubq_f32(x_vec_quad.val[2], vdupq_n_f32(px));
            float32x4_t dy2 = vsubq_f32(y_vec_quad.val[2], vdupq_n_f32(py));
            float32x4_t dist_sq2 = vmlaq_f32(vmulq_f32(dx2, dx2), dy2, dy2);

            float32x4_t dx3 = vsubq_f32(x_vec_quad.val[3], vdupq_n_f32(px));
            float32x4_t dy3 = vsubq_f32(y_vec_quad.val[3], vdupq_n_f32(py));
            float32x4_t dist_sq3 = vmlaq_f32(vmulq_f32(dx3, dx3), dy3, dy3);

            // Store distances to temporary arrays for unrolled insertions
            float d0[4], d1[4], d2[4], d3[4];
            vst1q_f32(d0, dist_sq0);
            vst1q_f32(d1, dist_sq1);
            vst1q_f32(d2, dist_sq2);
            vst1q_f32(d3, dist_sq3);

            // Unrolled sorted insertions for all 16 points
            *filled_ptr = insert_sorted(local_dists, local_labels, *filled_ptr, k,
                                        d0[0], label);
            *filled_ptr = insert_sorted(local_dists, local_labels, *filled_ptr, k,
                                        d0[1], label);
            *filled_ptr = insert_sorted(local_dists, local_labels, *filled_ptr, k,
                                        d0[2], label);
            *filled_ptr = insert_sorted(local_dists, local_labels, *filled_ptr, k,
                                        d0[3], label);

            *filled_ptr = insert_sorted(local_dists, local_labels, *filled_ptr, k,
                                        d1[0], label);
            *filled_ptr = insert_sorted(local_dists, local_labels, *filled_ptr, k,
                                        d1[1], label);
            *filled_ptr = insert_sorted(local_dists, local_labels, *filled_ptr, k,
                                        d1[2], label);
            *filled_ptr = insert_sorted(local_dists, local_labels, *filled_ptr, k,
                                        d1[3], label);

            *filled_ptr = insert_sorted(local_dists, local_labels, *filled_ptr, k,
                                        d2[0], label);
            *filled_ptr = insert_sorted(local_dists, local_labels, *filled_ptr, k,
                                        d2[1], label);
            *filled_ptr = insert_sorted(local_dists, local_labels, *filled_ptr, k,
                                        d2[2], label);
            *filled_ptr = insert_sorted(local_dists, local_labels, *filled_ptr, k,
                                        d2[3], label);

            *filled_ptr = insert_sorted(local_dists, local_labels, *filled_ptr, k,
                                        d3[0], label);
            *filled_ptr = insert_sorted(local_dists, local_labels, *filled_ptr, k,
                                        d3[1], label);
            *filled_ptr = insert_sorted(local_dists, local_labels, *filled_ptr, k,
                                        d3[2], label);
            *filled_ptr = insert_sorted(local_dists, local_labels, *filled_ptr, k,
                                        d3[3], label);
        }

        // Scalar remainder (less than 16 points)
        for (; j < len; j++) {
            float dx = xs[j] - px;
            float dy = ys[j] - py;
            float d = dx*dx + dy*dy;
            *filled_ptr = insert_sorted(local_dists, local_labels, *filled_ptr, k,
                                        d, label);
        }
    }

    // Merge per-thread sorted arrays into a global max-heap for final top-k selection.
    // We reuse the heap approach here because it's simple and processes only O(k*nthreads) elements.
    typedef struct { float dist; char label; } HeapNode;
    static inline void heap_swap(HeapNode *a, HeapNode *b) {
        HeapNode t = *a; *a = *b; *b = t;
    }

    // Sift down in max-heap (1-indexed)
    auto sift_down = [](HeapNode *heap, int heap_size, int idx) -> void {
        while (1) {
            int largest = idx;
            int left = 2 * idx;
            int right = 2 * idx + 1;
            if (left <= heap_size && heap[left].dist > heap[largest].dist)
                largest = left;
            if (right <= heap_size && heap[right].dist > heap[largest].dist)
                largest = right;
            if (largest == idx) break;
            heap_swap(&heap[idx], &heap[largest]);
            idx = largest;
        }
    };

    auto heap_insert_or_replace = [](float d, char label,
                                      HeapNode *heap, int *size_ptr, int k) -> void {
        int hs = *size_ptr;
        if (hs < k) {
            hs++;
            int idx = hs;
            heap[idx].dist = d;
            heap[idx].label = label;
            while (idx > 1 && heap[idx / 2].dist < heap[idx].dist) {
                heap_swap(&heap[idx], &heap[idx / 2]);
                idx /= 2;
            }
        } else if (d < heap[1].dist) {
            heap[1].dist = d;
            heap[1].label = label;
            sift_down(heap, k, 1);
        }
        *size_ptr = hs;
    };

    HeapNode *global_heap = (HeapNode*) malloc((k + 1) * sizeof(HeapNode));
    for (int i = 1; i <= k; i++) {
        global_heap[i].dist = FLT_MAX;
        global_heap[i].label = -1;
    }
    int global_size = 0;

    // Insert each per-thread top-k into global heap
    for (int t = 0; t < max_threads; t++) {
        int filled = thread_filled[t];
        if (filled > k) filled = k;
        float *dists = thread_dists[t];
        char *labels = thread_labels[t];
        for (int i = 0; i < filled; i++) {
            heap_insert_or_replace(dists[i], labels[i], global_heap, &global_size, k);
        }
    }

    // Extract labels from final global heap into a plain array for frequency counting.
    char *final_labels = (char*) malloc(k * sizeof(char));
    int actual_k = (global_size < k) ? global_size : k;
    for (int i = 0; i < actual_k; i++) {
        final_labels[i] = global_heap[i + 1].label;
    }
    for (int i = actual_k; i < k; i++) {
        final_labels[i] = -1;
    }

    free(global_heap);
    for (int t = 0; t < max_threads; t++) {
        free(thread_dists[t]);
        free(thread_labels[t]);
    }
    free(thread_dists);
    free(thread_labels);
    free(thread_filled);

    // Find most frequent label using frequency array (O(k + 256))
    int freq[256] = {0};
    for (int i = 0; i < k; i++) {
        if (final_labels[i] >= 0)
            freq[(unsigned char)final_labels[i]]++;
    }

    char best_label = final_labels[0];
    int best_count = freq[(unsigned char)best_label];
    for (int c = 1; c < 256; c++) {
        if (freq[c] > best_count) {
            best_count = freq[c];
            best_label = (char)c;
        }
    }

    free(final_labels);
    return best_label;
}

int main() {
    int n_groups = parse_number_of_groups();

    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; ++i) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();
    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

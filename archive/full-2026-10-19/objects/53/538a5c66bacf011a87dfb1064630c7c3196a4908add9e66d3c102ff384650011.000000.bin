#include<stdio.h>
#include<stdlib.h>
#include<string.h>

/* Maximum size (in char) for neighbors and compute lists */
#define MAX 100

typedef struct {
  int id;
  float value;
  char neighbors[MAX];
} Node;

typedef struct {
  float value;
  unsigned char ready;
} CostEntry;

/* Reads input, allocates memory, writes graph size and node list. Returns the graph. */
Node* read_input(char* fname, int *n, char* list) {
  Node* data = NULL;
  FILE *fl = NULL;

  if (fname == NULL)
    fl = stdin;
  else
    fl = fopen(fname, "r");

  if (fl == NULL) {
    fprintf(stderr, "Error!\n");
    exit(1);
  }

  // header
  fscanf(fl, "%d %[^\n]", n, list);

  if (*n > 0) {
    data = (Node*) malloc ((*n)*sizeof(Node));
    if(data == NULL){
      fprintf(stderr, "Error!\n");
      exit(1);
    }
  }

  for(int i = 0; i < *n; i++)
    fscanf(fl, "%d %f %[^\n]", &data[i].id, &data[i].value, data[i].neighbors);

  fclose(fl);
  return data;
}

/* Returns the first index of the node with the given id or -1 if not found */
int find_by_id(const int ids[], int id, int size){
  int i = 0;

  while((i < size) && ids[i] != id)
    i++;

  if(i < size)
    return i;

  return -1;
}

/* Computes and caches the sum for the node with the given id */
float get_costly(Node *g, const int ids[], int id, int size, CostEntry *cache) {
  int nd = find_by_id(ids, id, size);
  if(nd < 0)
    return 0;

  if(cache[nd].ready)
    return cache[nd].value;

  int idmax = -1;
  float max = 0;
  char aux[MAX];
  char *auxptr;
  strcpy(aux, g[nd].neighbors);
  char *t = strtok_r(aux, " ", &auxptr);

  while(t != NULL) {
    int neighbor_id = atoi(t);
    int d = find_by_id(ids, neighbor_id, size);
    if (d >= 0 && max < g[d].value) {
      max = g[d].value;
      idmax = neighbor_id;
    }
    t = strtok_r(NULL, " ", &auxptr);
  }

  float r = g[nd].value;
  if(idmax != -1)
    r += get_costly(g, ids, idmax, size, cache);

  cache[nd].value = r;
  cache[nd].ready = 1;
  return r;
}

/* Main program - calls read input, computes sum for each node in the list, prints output */
int main() {
  char *fileN = NULL;
  char computelist[MAX];
  int n = -1;
  Node* input = NULL;

  input = read_input(fileN, &n, computelist);

  CostEntry *cache = (CostEntry*) calloc(n > 0 ? n : 1, sizeof(CostEntry));
  if(cache == NULL) {
    fprintf(stderr, "Error!\n");
    free(input);
    exit(1);
  }

  /* Keep IDs contiguous so lookups scan a compact array instead of striding
     through the larger Node records. */
  int *ids = (int*) malloc((n > 0 ? n : 1) * sizeof(int));
  if(ids == NULL) {
    fprintf(stderr, "Error!\n");
    free(cache);
    free(input);
    exit(1);
  }
  for(int i = 0; i < n; i++)
    ids[i] = input[i].id;

  // process
  for(char *c = strtok(computelist, " "); c != NULL; c = strtok(NULL, " "))
    printf("%s: %f\n", c, get_costly(input, ids, atoi(c), n, cache));

  free(ids);
  free(cache);
  free(input);
  return 0;
}

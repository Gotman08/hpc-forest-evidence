#include <bits/stdc++.h>

using namespace std;

int A[1000][1000];
int ps[1010][1010];

typedef long long ll;

class PrefixFrequencyWorkspace {
  vector<int> keys_;
  vector<uint32_t> counts_;
  size_t mask_;

  static uint32_t hash_key(int key) {
    uint32_t x = static_cast<uint32_t>(key);
    x ^= x >> 16;
    x *= UINT32_C(0x7feb352d);
    x ^= x >> 15;
    x *= UINT32_C(0x846ca68b);
    x ^= x >> 16;
    return x;
  }

  size_t find_slot(int key) const {
    size_t slot = static_cast<size_t>(hash_key(key)) & mask_;
    while (counts_[slot] != 0 && keys_[slot] != key)
      slot = (slot + 1) & mask_;
    return slot;
  }

public:
  explicit PrefixFrequencyWorkspace(size_t max_prefixes) {
    size_t capacity = 1;
    while (capacity < 2 * max_prefixes)
      capacity <<= 1;
    keys_.resize(capacity);
    counts_.resize(capacity);
    mask_ = capacity - 1;
  }

  void reset() {
    // Independent contiguous stores permit vectorized or bulk clearing.
    fill(counts_.begin(), counts_.end(), uint32_t(0));
    increment(0);
  }

  uint32_t count(int key) const {
    // An unsuccessful lookup stops at an empty slot without inserting.
    return counts_[find_slot(key)];
  }

  void increment(int key) {
    const size_t slot = find_slot(key);
    if (counts_[slot] == 0)
      keys_[slot] = key;
    ++counts_[slot];
  }
};

ll solve(int m, int n, int k) {
  for (int i = 1; i <= m; i++) {
    for (int j = 1; j <= n; j++) {
      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];
    }
  }
  PrefixFrequencyWorkspace h(static_cast<size_t>(m) + 1);
  ll ans = 0;
  for (int j = 1; j <= n; j++) // O(m*n^2)
    for (int l = j; l <= n; l++) {
      h.reset();
      int s = 0;
      // Both the prefix recurrence and frequency updates remain ordered.
      for (int i = 1; i <= m; i++) {
        s += ps[i][l] - ps[i][j - 1];
        ans += h.count(s - k);
        h.increment(s);
      }
    }
  return ans;
}

int main() {
  int k, m, n;
  cin >> k >> m >> n;
  memset(A, 0, sizeof A);
  memset(ps, 0, sizeof ps);

  for (int i = 0; i < m; i++)
    for (int j = 0; j < n; j++)
      cin >> A[i][j];

  cout << solve(m, n, k) << endl;
  return 0;
}

{
  "src/solution.cpp": "#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    cin >> n >> m;\n\n    vector<int> dp(n, 0);\n    vector<vector<int>> blockedColumns(n);\n    for (int c = 0; c < m; ++c) {\n        int y, x;\n        cin >> y >> x;\n        blockedColumns[y].push_back(x);\n    }\n\n    for (int y = 0; y < n; ++y) {\n        auto& columns = blockedColumns[y];\n        sort(columns.begin(), columns.end());\n        columns.erase(unique(columns.begin(), columns.end()), columns.end());\n\n        size_t obstacleIndex = 0;\n        for (int x = 0; x < n; ++x) {\n            if (obstacleIndex < columns.size() && columns[obstacleIndex] == x) {\n                dp[x] = 0;\n                ++obstacleIndex;\n            } else if (x > 0) {\n                int sum = dp[x] + dp[x - 1];\n                if (sum >= MOD) sum -= MOD;\n                dp[x] = sum;\n            } else if (y == 0) {\n                dp[0] = 1;\n            }\n        }\n    }\n\n    cout << dp[n - 1] << '\\n';\n    return 0;\n}"
}

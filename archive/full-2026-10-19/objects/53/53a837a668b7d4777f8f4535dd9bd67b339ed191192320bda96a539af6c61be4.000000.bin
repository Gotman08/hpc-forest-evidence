"""Read exactly the diagnostic-named role; emit structure, never instruction bodies."""

import hashlib
import json
import re
import tomllib
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROLE = Path("C:/Users/nicol/.codex/agents/relecteur_parcours_joueur.toml")
raw = ROLE.read_bytes()
before = hashlib.sha256(raw).hexdigest()
value = tomllib.loads(raw.decode("utf-8-sig"))
shape = []
transports = []


def visit(item, path):
    if isinstance(item, dict):
        for key, child in item.items():
            visit(child, path + [key])
    elif isinstance(item, list):
        shape.append({"key_path": path, "type": "list", "length": len(item)})
    else:
        record = {"key_path": path, "type": type(item).__name__}
        if isinstance(item, str):
            record["characters"] = len(item)
        shape.append(record)
        if path and path[-1] == "transport":
            transports.append({**record, "safe_enum_value": item if isinstance(item, str)
                               and re.fullmatch(r"[A-Za-z0-9_-]{1,64}", item) else None})


visit(value, [])
assert hashlib.sha256(ROLE.read_bytes()).hexdigest() == before
result = {"schema": "hpc-forest-role-definition-structural-metadata-v1", "path": str(ROLE),
          "sha256": before, "bytes": len(raw), "toml_parse_success": True,
          "structural_fields": shape, "transport_fields": transports,
          "instruction_bodies_exported": False, "other_role_or_config_file_read": False,
          "role_unchanged_before_after": True, "isolation_mechanism_proven": False}
with (HERE / "role-metadonnees.json").open("x", encoding="utf8", newline="\n") as stream:
    json.dump(result, stream, ensure_ascii=False, indent=2, allow_nan=False)
    stream.write("\n")
print(json.dumps(result, ensure_ascii=False))

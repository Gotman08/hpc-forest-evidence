#include <inttypes.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

enum { SUFFIX_SCALE = 10000000U };

static inline uint32_t modular_power(uint32_t base, uint32_t exponent,
                                     uint32_t modulus)
{
    uint64_t result = 1U;
    uint64_t factor = base;

    while (exponent != 0U) {
        if ((exponent & 1U) != 0U) {
            result = (result * factor) % modulus;
        }
        exponent >>= 1;
        if (exponent != 0U) {
            factor = (factor * factor) % modulus;
        }
    }
    return (uint32_t)result;
}

static inline int is_prime(uint32_t value)
{
    static const uint32_t bases[] = { 2U, 7U, 61U };
    uint32_t d;
    unsigned int shifts = 0U;
    size_t i;

    if (value < 2U) {
        return 0;
    }
    if ((value & 1U) == 0U) {
        return value == 2U;
    }
    if (value % 3U == 0U) {
        return value == 3U;
    }
    if (value % 5U == 0U) {
        return value == 5U;
    }
    if (value % 7U == 0U) {
        return value == 7U;
    }
    if (value % 11U == 0U) {
        return value == 11U;
    }
    if (value % 13U == 0U) {
        return value == 13U;
    }

    d = value - 1U;
    while ((d & 1U) == 0U) {
        d >>= 1;
        ++shifts;
    }

    for (i = 0U; i < sizeof bases / sizeof bases[0]; ++i) {
        const uint32_t base = bases[i] % value;
        uint32_t x;
        unsigned int round;

        if (base == 0U) {
            continue;
        }
        x = modular_power(base, d, value);
        if (x == 1U || x == value - 1U) {
            continue;
        }
        for (round = 1U; round < shifts; ++round) {
            x = (uint32_t)(((uint64_t)x * x) % value);
            if (x == value - 1U) {
                break;
            }
        }
        if (round == shifts) {
            return 0;
        }
    }
    return 1;
}

static void sort_values(uint32_t *values, size_t count)
{
    size_t i;

    for (i = 1U; i < count; ++i) {
        const uint32_t value = values[i];
        size_t j = i;

        while (j != 0U && values[j - 1U] > value) {
            values[j] = values[j - 1U];
            --j;
        }
        values[j] = value;
    }
}

int main(void)
{
    unsigned int input_count;
    size_t count;
    size_t pair_count;
    size_t result_count = 0U;
    size_t i;
    uint32_t *left;
    uint32_t *right;
    uint32_t *output;

    if (fscanf(stdin, "%u", &input_count) != 1 || input_count == 0U) {
        return 0;
    }

    count = (size_t)input_count;
    if (count > SIZE_MAX / count) {
        return 1;
    }
    pair_count = count * count;
    if (pair_count > SIZE_MAX / sizeof *output) {
        return 1;
    }

    left = malloc(count * sizeof *left);
    right = malloc(count * sizeof *right);
    output = malloc(pair_count * sizeof *output);
    if (left == NULL || right == NULL || output == NULL) {
        free(output);
        free(right);
        free(left);
        return 1;
    }

    for (i = 0U; i < count; ++i) {
        if (fscanf(stdin, "%" SCNu32, &left[i]) != 1) {
            free(output);
            free(right);
            free(left);
            return 1;
        }
        left[i] = (uint32_t)((uint64_t)left[i] * SUFFIX_SCALE);
    }
    for (i = 0U; i < count; ++i) {
        if (fscanf(stdin, "%" SCNu32, &right[i]) != 1) {
            free(output);
            free(right);
            free(left);
            return 1;
        }
    }

    for (i = 0U; i < count; ++i) {
        const uint32_t base = left[i];
        size_t j;

        for (j = 0U; j < count; ++j) {
            const uint32_t candidate = base + right[j];

            if (is_prime(candidate)) {
                output[result_count++] = candidate;
            }
        }
    }

    sort_values(output, result_count);
    for (i = 0U; i < result_count; ++i) {
        printf("%" PRIu32 "\n", output[i]);
    }

    free(output);
    free(right);
    free(left);
    return 0;
}

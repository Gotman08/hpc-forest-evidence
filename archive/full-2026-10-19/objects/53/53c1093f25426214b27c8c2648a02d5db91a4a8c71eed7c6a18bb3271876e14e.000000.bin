  std::cin >> n >> s;\n    std::vector<int> mat(n * n);\n    for(int i=0;i<n;i++)\n        for(int j=0;j<n;j++) \n            scanf(\"%d\", &mat[i*n + j]);\n\n    assert(s<n);\n    assert(n<8000);\n    assert(s>0);\n    assert(n>0);\n\n    // Column prefix sums in flat row-major: colPref[i*n + j]\n    std::vector<long long> colPref(n * n);\n    #pragma omp parallel\n    {\n        #pragma omp for schedule(static)\n        for(int j=0;j<n;++j) {\n            long long running = 0;\n            for(int i=0;i<n;++i) {\n                running += mat[i*n + j];\n                colPref[i*n + j] = running;\n            }\n        }\n\n        // implicit barrier after the worksharing loop\n\n        #pragma omp for reduction(max:mxSum) schedule(guided)\n        for(int r=0; r<=n-s; ++r) {\n            int bottom = r + s - 1;\n            int topMinusOne = r - 1;\n            long long cur = 0;\n            // initial window at column 0\n            for(int c=0;c<s;++c) {\n                long long seg = colPref[bottom*n + c] - (topMinusOne >= 0 ? colPref[topMinusOne*n + c] : 0);\n                cur += seg;\n            }\n            if(cur > mxSum) mxSum = cur;\n\n            for(int c=1; c<=n-s; ++c) {\n                int outCol = c-1;\n                int inCol = c+s-1;\n                long long segOut = colPref[bottom*n + outCol] - (topMinusOne >= 0 ? colPref[topMinusOne*n + outCol] : 0);\n                long long segIn = colPref[bottom*n + inCol] - (topMinusOne >= 0 ? colPref[topMinusOne*n + inCol] : 0);\n                cur += segIn - segOut;\n                if(cur > mxSum) mxSum = cur;\n            }\n        }\n    }\n\n    printf(\"%d\\n\", (int)mxSum);\n}\n```\n\nWait: `mxSum` is declared outside the parallel region as `long long mxSum = LLONG_MIN;`. Inside the second worksharing loop, we use reduction(max:mxSum). That's fine. But note that in OpenMP, a variable used in reduction must be shared and initialized before the construct. It is.\n\nAlso, the first
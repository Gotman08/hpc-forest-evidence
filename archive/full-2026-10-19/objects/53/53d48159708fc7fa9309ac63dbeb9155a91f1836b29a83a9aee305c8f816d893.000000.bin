        "epoch": 1,
        "hypothesis": "Streaming each matrix row across contiguous columns and reducing in short k-blocks should improve cache behavior and reduce modulo operations in the repeated dense multiplications.",
        "id": "0f8b226a2aec4705",
        "ordinal": 1,

    {
      "id": "394f215ebb03481e",
      "role": "A",
      "mission": {
        "base_commit": "f6e0fb013b0476f0044a278fb8521e03bcf55a67",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Replacing dense companion-matrix exponentiation with compact Kitamasa polynomial exponentiation should reduce work from O(N^3 log H) to O(N^2 log H). Contiguous coefficient vectors and a wide scratch polynomial also improve locality while avoiding modular reduction on every multiply-add.",
        "id": "394f215ebb03481e",
        "ordinal": 2,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/npbonacci.cpp"
          ],
          "retained": [
            "Represent x^N as sum_{j=1..N} P_j*x^(N-j), exponentiate x^(H-1) modulo that polynomial, and combine the result coefficients with A_1..A_N.",
            "Use contiguous O(N) coefficient vectors and a wide scratch polynomial; reduce high-degree coefficients during polynomial reduction and normalize the final coefficients modulo 1e9+7."
          ]
        },

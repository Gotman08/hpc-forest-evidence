          "files": [
            "src/npbonacci.cpp"
          ],
          "retained": [
            "Represent x^N as the recurrence-weighted sum of lower powers, binary-exponentiate x^(H-1) modulo that polynomial, and combine the remainder coefficients with A_1..A_N.",
            "Use contiguous O(N) coefficient vectors and a wide scratch polynomial; reduce high-degree terms during reduction and normalize coefficients modulo 1e9+7."
          ]
        },

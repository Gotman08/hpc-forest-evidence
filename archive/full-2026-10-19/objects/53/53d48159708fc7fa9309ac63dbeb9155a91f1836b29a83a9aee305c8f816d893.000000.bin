        "depth": 1,
        "epoch": 1,
        "hypothesis": "For larger recurrence orders, using one OpenMP team to compute and copy the output matrix should share the copy work without launching a separate parallel region; a serial path below order 32 should avoid work-sharing overhead on small matrices.",
        "id": "0cf42967471946f2",
        "ordinal": 2,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/npbonacci.cpp"
          ],
          "retained": [
            "Use static row work-sharing for both independent output computation and the subsequent matrix copy inside a single parallel region when n >= 32.",
            "Retain serial computation and copying for smaller matrix orders, and preserve the existing modular accumulation order."
          ]
        },

#include <bits/stdc++.h>

using namespace std;

int A[1000][1000];
int ps[1010][1010];

typedef long long ll;

ll solve(int m, int n, int k) {
  for (int i = 1; i <= m; i++) {
    for (int j = 1; j <= n; j++) {
      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];
    }
  }

  ll ans = 0;
  const ll estimated_work = (ll)n * (n + 1) / 2 * m;
  auto process_j = [&](int j, unordered_map<ll, ll>& h) {
    ll subtotal = 0;
    for (int l = j; l <= n; l++) {
      h.clear();
      h[0] = 1;
      ll s = 0;
      for (int i = 1; i <= m; i++) {
        s += ps[i][l] - ps[i][j - 1];
        auto it = h.find(s - k);
        if (it != h.end()) subtotal += it->second;
        h[s]++;
      }
    }
    return subtotal;
  };

  if (estimated_work >= 65536) {
#pragma omp parallel reduction(+ : ans)
    {
      unordered_map<ll, ll> h;
#pragma omp for schedule(dynamic, 1)
      for (int j = 1; j <= n; j++) {
        ans += process_j(j, h);
      }
    }
  } else {
    unordered_map<ll, ll> h;
    for (int j = 1; j <= n; j++) {
      ans += process_j(j, h);
    }
  }
  return ans;
}

int main() {
  int k, m, n;
  cin >> k >> m >> n;
  memset(A, 0, sizeof A);
  memset(ps, 0, sizeof ps);

  for (int i = 0; i < m; i++)
    for (int j = 0; j < n; j++)
      cin >> A[i][j];

  cout << solve(m, n, k) << endl;
  return 0;
}

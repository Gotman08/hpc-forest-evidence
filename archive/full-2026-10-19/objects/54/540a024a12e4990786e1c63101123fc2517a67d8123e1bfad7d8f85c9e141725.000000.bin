        "content": "#include<stdio.h>\n#include<stdlib.h>\n#include<math.h>\n\nenum { SORT_INSERTION_LIMIT = 32 };\n\nvoid bubble_sort (double *matriz, int tam) {\n    int i, j;\n    double aux;\n\n    for (i = tam - 1; i > 0; i--) {\n        for (j = 0; j < i; j++) {\n            if (matriz[j] > matriz[j+1]) {\n                aux=matriz[j];\n                matriz[j]=matriz[j+1];\n                matriz[j+1]=aux;\n            }\n        }\n    }\n}\n\nstatic void insertion_sort(double *matriz, size_t tam) {\n    size_t i;\n    for (i = 1; i < tam; ++i) {\n        double value = matriz[i];\n        size_t j = i;\n        while (j > 0 && matriz[j-1] > value) {\n            matriz[j] = matriz[j-1];\n            --j;\n        }\n        matriz[j] = value;\n    }\n}\n\n/* Both recursive children reuse the same half-column workspace. */\nstatic void stable_merge_sort(double *matriz, double *scratch, size_t tam) {\n    size_t middle, i, j, out;\n\n    if (tam <= SORT_INSERTION_LIMIT) {\n        insertion_sort(matriz, tam);\n        return;\n    }\n\n    middle = tam / 2;\n    stable_merge_sort(matriz, scratch, middle);\n    stable_merge_sort(matriz + middle, scratch, tam - middle);\n\n    if (!(matriz[middle-1] > matriz[middle])) {\n        return;\n    }\n\n    for (i = 0; i < middle; ++i) {\n        scratch[i] = matriz[i];\n    }\n\n    i = 0;\n    j = middle;\n    out = 0;\n    while (i < middle && j < tam) {\n        /* Taking the left element on equality preserves signed-zero order. */\n        if (matriz[j] < scratch[i]) {\n            matriz[out++] = matriz[j++];\n        } else {\n            matriz[out++] = scratch[i++];\n        }\n    }\n    while (i < middle) {\n        matriz[out++] = scratch[i++];\n    }\n    /* Any remaining right-hand elements are already in their final slots. */\n}\n\nvoid ordena_colunas(double *matriz,int lin, int col) {\n    int i;\n    double *scratch;\n    size_t length;\n\n    if (lin < 2 || col < 1) {\n        return;\n    }\n\n    length = (size_t)lin;\n    if (lin <= SORT_INSERTION_LIMIT) {\n        for (i = 0; i < col; ++i) {\n            insertion_sort(matriz + (size_t)i * length, length);\n        }\n        return;\n    }\n\n    scratch = (double *)malloc((length / 2) * sizeof(double));\n    for (i = 0; i < col; ++i) {\n        double *column = matriz + (size_t)i * length;\n        size_t begin = 0;\n\n        if (scratch == NULL) {\n            bubble_sort(column, lin);\n            continue;\n        }\n\n        /* Bubble sort cannot move a value across a NaN. Sort each segment\n           independently and leave every NaN in its original position. */\n        while (begin < length) {\n            size_t end;\n            if (column[begin] != column[begin]) {\n                ++begin;\n                continue;\n            }\n            end = begin + 1;\n            while (end < length && column[end] == column[end]) {\n                ++end;\n            }\n            stable_merge_sort(column + begin, scratch, end - begin);\n            begin = end;\n        }\n    }\n    free(scratch);\n}\n\nvoid calcula_media(double *matriz, double *vet,int lin, int col){\n    int i,j;\n    double soma;\n    for(i=0;i<col;i++){\n        soma=0;\n        for(j=0;j<lin;j++){\n            soma+=matriz[i*lin+j];\n        }\n        vet[i]=soma/lin;\n    }\n}\n\nvoid calcula_media_harmonica(double *matriz, double *vet,int lin, int col){\n    int i,j;\n    double soma;\n    for(i=0;i<col;i++){\n        soma=0;\n        for(j=0;j<lin;j++){\n            soma+=(1/(matriz[i*lin+j]));\n        }\n        vet[i]=lin/soma;\n    }\n}\n\nvoid calcula_mediana(double *matriz, double *vet, int lin, int col) {\n     int i=0;\n     if((lin-1)%2){ //Quantidade par de elementos\n         for (i = 0; i < col; i++) {\n            vet[i]=(matriz[(((i*lin)+(i+1)*lin)-1)/2]+matriz[((((i*lin)+(i+1)*lin)-1)/2)+1]);\n            vet[i]*=0.5;\n\n         }\n     }\n     else{ //Quantidade ímpar de elementos\n         for (i = 0; i < col; i++) {\n            vet[i]=matriz[(((i*lin)+(i+1)*lin)-1)/2];\n         }\n     }\n\n }\n\n/* Defined zero-counter fallback for NaN-containing or unsorted arrays. */\nstatic double moda_nao_ordenada(double *matriz, int lin) {\n    int i, j;\n    float conta = 0, moda = 0;\n\n    for (i = 0; i < lin; ++i) {\n        double count = 0;\n        for (j = i + 1; j < lin; ++j) {\n            if (matriz[i] == matriz[j]) {\n                count += 1;\n                if (count > conta) {\n                    conta = (float)count;\n                    moda = (float)matriz[i];\n                }\n            }\n        }\n    }\n    return conta == 0 ? -1 : (double)moda;\n}\n\n//Adaptado de https://www.clubedohardware.com.br/forums/topic/1291570-programa-em-c-que-calcula-moda-media-e-mediana/\ndouble moda_aux(double *matriz,int lin){\n    int i;\n    float conta = 0, moda = 0;\n\n    /* NaNs can separate equal values after the barrier-preserving sort. */\n    for (i = 0; i < lin; ++i) {\n        if (matriz[i] != matriz[i] ||\n            (i > 0 && matriz[i-1] > matriz[i])) {\n            return moda_nao_ordenada(matriz, lin);\n        }\n    }\n\n    i = 0;\n    while (i < lin) {\n        int end = i + 1;\n        while (end < lin && matriz[i] == matriz[end]) {\n            ++end;\n        }\n\n        /* Each suffix has exactly end-i-1 later matches. Process every\n           suffix to retain strict float-counter updates even for long\n           runs containing differently signed zeros. The original counter\n           array was uninitialized; these counts use defined zero starts. */\n        while (i < end) {\n            double matches = (double)(end - i - 1);\n            if (matches > conta) {\n                conta = (float)matches;\n                moda = (float)matriz[i];\n            }\n            ++i;\n        }\n    }\n    return conta == 0 ? -1 : (double)moda;\n}\n\nvoid calcula_moda(double *matriz,double *moda,int lin, int col){\n    int i;\n    for(i=0;i<col;i++){\n        moda[i]=moda_aux(matriz+(i*lin),lin);\n    }\n}\n\nvoid calcula_variancia(double *matriz, double *media,double *variancia, int lin, int col){\n    int i,j;\n    double soma;\n    for(i=0;i<col;i++){\n        soma=0;\n        for(j=0;j<lin;j++){\n            soma+=pow((matriz[i*lin+j]-media[i]),2);\n        }\n        variancia[i]=soma/(lin-1);\n    }\n}\n\nvoid calcula_desvio_padrao(double *variancia,double *dp, int col){\n    int i;\n    for(i=0;i<col;i++){\n        dp[i]=sqrt(variancia[i]);\n    }\n}\n\nvoid calcula_coeficiente_variacao(double *media,double *dp,double *cv, int col){\n    int i;\n    for(i=0;i<col;i++){\n        cv[i]=dp[i]/media[i];\n    }\n}\n\nint main(int argc,char **argv){\n    int lin,col,i,j; // Define as variáveis de índices e dimensões\n    double *matriz,*mediana,*media,*media_har,*moda,*variancia,*dp,*cv; // Define a matriz (forma linear), vetores de medidas estatísticas\n\n    fscanf(stdin, \"%d \", &lin); // Lê a quantidade de linhas da matriz\n    fscanf(stdin, \"%d\\n\", &col); // Lê a quantidade de colunas da matriz\n\n    // Alocações\n    matriz=(double *)malloc(lin*col * sizeof(double)); // Aloca a matriz\n    media=(double *)malloc(col * sizeof(double)); // Aloca o vetor de media\n    media_har=(double *)malloc(col * sizeof(double)); // Aloca o vetor de media harmônica\n    mediana=(double *)malloc(col * sizeof(double)); // Aloca o vetor de mediana\n    moda=(double *)malloc(col * sizeof(double)); // Aloca o vetor de moda\n    variancia=(double *)malloc(col * sizeof(double)); // Aloca o vetor de variância\n    cv=(double *)malloc(col * sizeof(double)); // Aloca o vetor de coeficiente de variação\n    dp=(double *)malloc(col * sizeof(double)); // Aloca o vetor de desvio padrão\n\n\n    for(i=0;i<lin;i++){\n        for(j=0;j<col;j++){\n            fscanf(stdin, \"%lf \",&(matriz[j*lin+i])); // Lê os dados transpostos em uma matriz de entrada\n        }\n    }\n\n    calcula_media(matriz,media,lin,col);\n    calcula_media_harmonica(matriz,media_har,lin,col);\n    ordena_colunas(matriz,lin,col);\n    calcula_mediana(matriz,mediana,lin,col);\n    calcula_moda(matriz,moda,lin,col);\n    calcula_variancia(matriz,media,variancia,lin,col);\n    calcula_desvio_padrao(variancia,dp,col);\n    calcula_coeficiente_variacao(media,dp,cv,col);\n\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",media[i]); // Imprime as médias aritméticas de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",media_har[i]); // Imprime as médias harmônicas de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",mediana[i]); // Imprime as medianas de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",moda[i]); // Imprime as modas de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",variancia[i]); // Imprime as variâncias amostrais de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",dp[i]); // Imprime os desvios padrão de cada coluna\n    printf(\"\\n\");\n    for(i=0;i<col;i++)\n        printf(\"%.1lf \",cv[i]); // Imprime os coeficientes de variação de cada coluna\n    printf(\"\\n\");\n\n    // Desaloca memória\n    free(matriz);\n    free(media);\n    free(media_har);\n    free(mediana);\n    free(moda);\n    free(variancia);\n    free(dp);\n    free(cv);\n}\n",
        "path": "src/est_matriz_seq.c"
      }

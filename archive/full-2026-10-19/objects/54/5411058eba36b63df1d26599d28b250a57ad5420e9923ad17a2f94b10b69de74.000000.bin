#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

typedef struct { float x, y, z, vx, vy, vz; } Body;

void body_force(float *px, float *py, float *pz,
                float *vx, float *vy, float *vz,
                int n) {
  const int IB = 128;
  const int JB = 512;
  #pragma omp for schedule(static)
  for (int ib = 0; ib < n; ib += IB) {
    int i_end = (ib + IB < n) ? ib + IB : n;
    float fx[IB], fy[IB], fz[IB];
    // initialize partial sums
    for (int ii = ib; ii < i_end; ++ii) {
      int idx = ii - ib;
      fx[idx] = 0.0f;
      fy[idx] = 0.0f;
      fz[idx] = 0.0f;
    }
    // loop over j blocks
    for (int jb = 0; jb < n; jb += JB) {
      int j_end = (jb + JB < n) ? jb + JB : n;
      // compute contributions from this j block to all i in current i-block
      for (int ii = ib; ii < i_end; ++ii) {
        float xi = px[ii];
        float yi = py[ii];
        float zi = pz[ii];
        int idx = ii - ib;
        float fxx = fx[idx], fyy = fy[idx], fzz = fz[idx];
        for (int j = jb; j < j_end; ++j) {
          float dx = px[j] - xi;
          float dy = py[j] - yi;
          float dz = pz[j] - zi;
          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
          float inv_dist = 1.0f / sqrt(sqrd_dist);
          float inv_dist3 = inv_dist * inv_dist * inv_dist;
          fxx += dx * inv_dist3;
          fyy += dy * inv_dist3;
          fzz += dz * inv_dist3;
        }
        fx[idx] = fxx;
        fy[idx] = fyy;
        fz[idx] = fzz;
      }
    }
    // update velocities
    for (int ii = ib; ii < i_end; ++ii) {
      int idx = ii - ib;
      vx[ii] += DT * fx[idx];
      vy[ii] += DT * fy[idx];
      vz[ii] += DT * fz[idx];
    }
  }
}

void read_dataset(int *nbodies, float **px, float **py, float **pz,
                  float **vx, float **vy, float **vz) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) { fprintf(stderr,"\nError reading nbodie value\n"); exit(EXIT_FAILURE); }
  Body *tmp = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(tmp, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) { fprintf(stderr,"\nError reading input values\n"); exit(EXIT_FAILURE); }
  int n = *nbodies;
  *px = (float *)malloc(n * sizeof(float));
  *py = (float *)malloc(n * sizeof(float));
  *pz = (float *)malloc(n * sizeof(float));
  *vx = (float *)malloc(n * sizeof(float));
  *vy = (float *)malloc(n * sizeof(float));
  *vz = (float *)malloc(n * sizeof(float));
  for (int i = 0; i < n; ++i) {
    (*px)[i] = tmp[i].x;
    (*py)[i] = tmp[i].y;
    (*pz)[i] = tmp[i].z;
    (*vx)[i] = tmp[i].vx;
    (*vy)[i] = tmp[i].vy;
    (*vz)[i] = tmp[i].vz;
  }
  free(tmp);
}

void write_dataset(const int nbodies, float *px, float *py, float *pz,
                   float *vx, float *vy, float *vz) {
  Body *out = (Body *)malloc(nbodies * sizeof(Body));
  for (int i = 0; i < nbodies; ++i) {
    out[i].x = px[i];
    out[i].y = py[i];
    out[i].z = pz[i];
    out[i].vx = vx[i];
    out[i].vy = vy[i];
    out[i].vz = vz[i];
  }
  int b = fwrite(out, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) { fprintf(stderr,"\nError writing to output\n"); exit(EXIT_FAILURE); }
  free(out);
}

int main(int argc, char **argv) {
  int nbodies;
  float *px, *py, *pz, *vx, *vy, *vz;
  read_dataset(&nbodies, &px, &py, &pz, &vx, &vy, &vz);

  #pragma omp parallel
  {
    for (int iter = 0; iter < N_ITER; ++iter) {
      body_force(px, py, pz, vx, vy, vz, nbodies);
      #pragma omp for schedule(static)
      for (int i = 0; i < nbodies; ++i) {
        px[i] += vx[i] * DT;
        py[i] += vy[i] * DT;
        pz[i] += vz[i] * DT;
      }
    }
  }

  write_dataset(nbodies, px, py, pz, vx, vy, vz);

  free(px); free(py); free(pz);
  free(vx); free(vy); free(vz);
  exit(EXIT_SUCCESS);
}

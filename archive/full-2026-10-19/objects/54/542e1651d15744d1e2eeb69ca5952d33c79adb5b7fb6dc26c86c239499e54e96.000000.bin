#include <cstdio>
#include <memory>
#include <vector>

class FastScanner {
    static constexpr int BUFSIZE = 1 << 20;
    int idx = 0;
    int size = 0;
    char buf[BUFSIZE];
public:
    inline char getChar() {
        if (idx >= size) {
            size = (int)fread(buf, 1, BUFSIZE, stdin);
            idx = 0;
            if (size == 0) return '\0';
        }
        return buf[idx++];
    }

    int nextInt() {
        char c;
        do { c = getChar(); } while (c <= ' ');
        int sign = 1;
        if (c == '-') {
            sign = -1;
            c = getChar();
        }
        int x = 0;
        while (c >= '0' && c <= '9') {
            x = x * 10 + (c - '0');
            c = getChar();
        }
        return sign * x;
    }
};

int main() {
    FastScanner fs;
    int n = fs.nextInt();
    int s = fs.nextInt();

    const size_t ringSize = (size_t)s + 1;
    std::unique_ptr<int[]> ring(new int[ringSize * (size_t)n]);
    std::vector<long long> col(n, 0);

    for (int r = 0; r < s; ++r) {
        int* row = &ring[(size_t)r * n];
        int j = 0;
        for (; j + 3 < n; j += 4) {
            int v0 = fs.nextInt();
            int v1 = fs.nextInt();
            int v2 = fs.nextInt();
            int v3 = fs.nextInt();
            row[j] = v0;
            row[j+1] = v1;
            row[j+2] = v2;
            row[j+3] = v3;
            col[j] += v0;
            col[j+1] += v1;
            col[j+2] += v2;
            col[j+3] += v3;
        }
        for (; j < n; ++j) {
            int v = fs.nextInt();
            row[j] = v;
            col[j] += v;
        }
    }

    long long cur = 0;
    for (int j = 0; j < s; ++j) cur += col[j];
    long long best = cur;

    int limit = n - s;
    for (int j = 1; j <= limit; ++j) {
        cur += col[j + s - 1] - col[j - 1];
        if (cur > best) best = cur;
    }

    size_t outSlot = 0;
    size_t inSlot = ((size_t)s) % ringSize;

    for (int i = 1; i <= limit; ++i) {
        int* pout = &ring[outSlot * (size_t)n];
        int* pin = &ring[inSlot * (size_t)n];

        int j = 0;
        for (; j + 3 < n; j += 4) {
            int v0 = fs.nextInt();
            int v1 = fs.nextInt();
            int v2 = fs.nextInt();
            int v3 = fs.nextInt();
            pin[j] = v0;
            pin[j+1] = v1;
            pin[j+2] = v2;
            pin[j+3] = v3;
            col[j] += (long long)v0 - pout[j];
            col[j+1] += (long long)v1 - pout[j+1];
            col[j+2] += (long long)v2 - pout[j+2];
            col[j+3] += (long long)v3 - pout[j+3];
        }
        for (; j < n; ++j) {
            int v = fs.nextInt();
            pin[j] = v;
            col[j] += (long long)v - pout[j];
        }

        cur = 0;
        for (int j = 0; j < s; ++j) cur += col[j];
        if (cur > best) best = cur;

        for (int j = 1; j <= limit; ++j) {
            cur += col[j + s - 1] - col[j - 1];
            if (cur > best) best = cur;
        }

        if (++outSlot == ringSize) outSlot = 0;
        if (++inSlot == ringSize) inSlot = 0;
    }

    std::printf("%lld\n", (long long)best);
    return 0;
}

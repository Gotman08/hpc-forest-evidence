        "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nnamespace {\nconstexpr int MOD = 1000000007;\nconstexpr int TILE_SIZE = 128;\nconstexpr int EDGE_STRIDE = TILE_SIZE + 32;\n\ninline void advance_span(int* top, int begin, int end, int& left) {\n    for (int j = begin; j < end; ++j) {\n        int value = top[j] + left;\n        if (value >= MOD) value -= MOD;\n        top[j] = value;\n        left = value;\n    }\n}\n\nvoid process_tile(int tile_row, int tile_col, int n,\n                  const std::vector<std::vector<int>>& blocked_rows,\n                  int* bottom_edges, int* right_edges, int* next_blocked) {\n    const int row_begin = tile_row * TILE_SIZE;\n    const int row_end = std::min(n, row_begin + TILE_SIZE);\n    const int col_begin = tile_col * TILE_SIZE;\n    const int col_end = std::min(n, col_begin + TILE_SIZE);\n    const int width = col_end - col_begin;\n\n    int* const top = bottom_edges + tile_col * EDGE_STRIDE;\n    int* const right = right_edges + tile_row * EDGE_STRIDE;\n    int* const cursor = next_blocked + tile_row * EDGE_STRIDE;\n\n    for (int row = row_begin; row < row_end; ++row) {\n        const int local_row = row - row_begin;\n        const auto& obstacles = blocked_rows[row];\n        const int obstacle_count = static_cast<int>(obstacles.size());\n        int next = cursor[local_row];\n        int left = right[local_row];\n        int begin = 0;\n\n        // The tile to the left has consumed all earlier blocked columns.\n        while (next < obstacle_count && obstacles[next] < col_end) {\n            const int stop = obstacles[next] - col_begin;\n            advance_span(top, begin, stop, left);\n            top[stop] = 0;\n            left = 0;\n            begin = stop + 1;\n            ++next;\n        }\n        advance_span(top, begin, width, left);\n        right[local_row] = left;\n        cursor[local_row] = next;\n    }\n}\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n, m;\n    if (!(std::cin >> n >> m)) return 0;\n\n    std::vector<std::vector<int>> blocked_rows(n);\n    bool endpoint_blocked = false;\n    for (int c = 0; c < m; ++c) {\n        int row, col;\n        std::cin >> row >> col;\n        blocked_rows[row].push_back(col);\n        if ((row == 0 && col == 0) || (row == n - 1 && col == n - 1)) {\n            endpoint_blocked = true;\n        }\n    }\n    if (endpoint_blocked) {\n        std::cout << 0 << '\\n';\n        return 0;\n    }\n\n    const int tile_count = (n + TILE_SIZE - 1) / TILE_SIZE;\n    const int edge_count = tile_count * EDGE_STRIDE;\n    // Padding separates boundary segments written by different workers.\n    std::vector<int> bottom_edges(edge_count, 0);\n    std::vector<int> right_edges(edge_count, 0);\n    std::vector<int> next_blocked(edge_count, 0);\n    bottom_edges[0] = 1;\n\n#ifdef _OPENMP\n#pragma omp parallel if (tile_count >= 8)\n#endif\n    {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n        for (int row = 0; row < n; ++row) {\n            auto& obstacles = blocked_rows[row];\n            std::sort(obstacles.begin(), obstacles.end());\n            obstacles.erase(std::unique(obstacles.begin(), obstacles.end()),\n                            obstacles.end());\n        }\n\n        for (int diagonal = 0; diagonal < 2 * tile_count - 1; ++diagonal) {\n            const int first_row = std::max(0, diagonal - tile_count + 1);\n            const int last_row = std::min(diagonal, tile_count - 1);\n            // Tiles here own disjoint edges and cursors. The implicit barrier\n            // completes both predecessors before the next diagonal begins.\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n            for (int tile_row = first_row; tile_row <= last_row; ++tile_row) {\n                process_tile(tile_row, diagonal - tile_row, n, blocked_rows,\n                             bottom_edges.data(), right_edges.data(),\n                             next_blocked.data());\n            }\n        }\n    }\n\n    const int last_tile = tile_count - 1;\n    const int last_offset = n - 1 - last_tile * TILE_SIZE;\n    std::cout << bottom_edges[last_tile * EDGE_STRIDE + last_offset] << '\\n';\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }

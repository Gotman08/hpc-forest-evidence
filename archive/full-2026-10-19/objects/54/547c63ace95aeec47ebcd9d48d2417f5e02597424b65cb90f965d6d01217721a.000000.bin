      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <math.h>\n#include <string.h>\n\n#define MAXNUM 100\n#define MAXSTR 50\n#define MAXRESULTS (MAXNUM * MAXNUM)\n\nchar firstHalf[MAXNUM][MAXSTR];\nchar secondHalf[MAXNUM][MAXSTR];\nlong int candidateResult[MAXNUM][MAXNUM];\nlong int result[MAXRESULTS];\nint numPrimes=0;\n\nint isprime(long int value)\n{ long int root;\n  long int factor=2;\n  int prime=1;\n  root = sqrtl(value);\n  while ((factor<=root) && (prime))\n        { prime = fmod((double)value,(double) factor) > 0.0;\n          factor++;\n        }\n  return prime;\n}\n\nstatic void test_candidate(int i, int j)\n{ char strToTest[MAXSTR];\n  long int primeToTest;\n  strcpy(strToTest,firstHalf[i]);\n  strcat(strToTest,secondHalf[j]);\n  primeToTest=atol(strToTest);\n  candidateResult[i][j]=isprime(primeToTest) ? primeToTest : 0;\n}\n\nvoid quicksort(long int *primes,int first,int last)\n{ int i, j, pivot;\n  long int temp;\n\n  if (first<last)\n     { pivot=first;\n       i=first;\n       j=last;\n       while(i<j)\n             { while (primes[i]<=primes[pivot]&&i<last)\n             i++;\n           while(primes[j]>primes[pivot])\n             j--;\n           if (i<j)\n                      { temp=primes[i];\n                primes[i]=primes[j];\n                primes[j]=temp;\n              }\n         }\n       temp=primes[pivot];\n       primes[pivot]=primes[j];\n       primes[j]=temp;\n       quicksort(primes,first,j-1);\n       quicksort(primes,j+1,last);\n     }\n}\n\nint main(int argc,char** argv)\n{ FILE *primesFile;\n  int i=0,j=0,numResults=0;\n  primesFile=stdin;\n  fscanf(primesFile,\"%d\\n\",&numPrimes);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",firstHalf[i]);\n  for (i=0;i<numPrimes;i++)\n      fscanf(primesFile,\"%s\\n\",secondHalf[i]);\n  fclose(primesFile);\n#ifdef _OPENMP\n  if (numPrimes >= 8)\n    {\n#pragma omp parallel for collapse(2) schedule(dynamic,4)\n      for (i=0;i<numPrimes;i++)\n        for (j=0;j<numPrimes;j++)\n          test_candidate(i,j);\n    }\n  else\n#endif\n    {\n      for (i=0;i<numPrimes;i++)\n        for (j=0;j<numPrimes;j++)\n          test_candidate(i,j);\n    }\n  for (i=0;i<numPrimes;i++)\n      for (j=0;j<numPrimes;j++)\n          if (candidateResult[i][j] != 0)\n              result[numResults++]=candidateResult[i][j];\n  quicksort(result,0,numResults-1);\n  for (i=0;i<numResults;i++)\n      printf(\"%ld\\n\",result[i]);\n  return 0;\n}\n",

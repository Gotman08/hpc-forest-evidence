def need(value, reason):
    if not value:
        raise ValueError(reason)


def digest(raw):
    return hashlib.sha256(raw).hexdigest()


def preparation_io():
    need(HERE == OP / "preparation-derivee-R8-apres-raccord-r1/qualification-R8-preparee-r1"
         and os.name == "nt", "Exact Windows preparation boundary required")
    for path in (*reversed(PHASE1.parents), PHASE1):
        info = path.lstat()
        need(not stat.S_ISLNK(info.st_mode) and not getattr(info, "st_file_attributes", 0) & 1024,
             "Preparation primitive reparse refused")
    source = PHASE1.read_bytes()
    need(digest(source) == PHASE1_SHA, "Pinned local IO preparation source required")
    tree = ast.parse(source)
    need(isinstance(tree.body[-1], ast.If) and ast.unparse(tree.body[-1].test) == "__name__ == '__main__'"
         and ast.unparse(tree.body[-1].body[0]) == "main()", "Exclude exact preparation entry point")
    tree.body.pop()
    ns = {"__file__": str(PHASE1), "__name__": "Q_R8_local_preparation_primitives"}
    exec(compile(tree, str(PHASE1), "exec"), ns)
    need(ns["HERE"] == P8 and ns["BASE"] == BASE and ns["PREP"] == PREP, "Primitive anchor changed")
    store = ns["ColdStore"]()
    store.pinned(PHASE1, PHASE1_SHA)
    return ns, store


def same_python_structure(before, after):
    class Strings(ast.NodeTransformer):
        def visit_Constant(self, node):
            return ast.copy_location(ast.Constant("<string>"), node) if isinstance(node.value, str) else node
    return ast.dump(Strings().visit(ast.parse(before)), include_attributes=False) == ast.dump(
        Strings().visit(ast.parse(after)), include_attributes=False)


def packed(files):
    output = io.BytesIO()
    with gzip.GzipFile(fileobj=output, filename="", mode="wb", mtime=0) as zipped, \
            tarfile.open(fileobj=zipped, mode="w") as archive:
        for name, raw in sorted(files.items()):
            safe_name(name)
            item = tarfile.TarInfo(name)
            item.size, item.mode, item.mtime = len(raw), 0o600, 0
            archive.addfile(item, io.BytesIO(raw))
    return output.getvalue()


def safe_name(name):
    path = PurePosixPath(name)
    need(name and not path.is_absolute() and path.as_posix() == name and "\\" not in name and "\x00" not in name
         and all(p and p not in {".", ".."} and ":" not in p and p == p.rstrip(" .") for p in name.split("/")),
         "Closed regular relative archive name required")


def archive_map(raw, count):
    result = {}
    with tarfile.open(fileobj=io.BytesIO(raw), mode="r:gz") as archive:
        members = archive.getmembers()
        need(len(members) == count, "Exact source bundle member count required")
        for item in members:
            safe_name(item.name)
            need(item.isfile() and not item.linkname and not item.sparse and item.name not in result
                 and set(item.pax_headers) <= {"path"} and 0 <= item.size <= 32 * 1024**2,
                 "Only unique bounded regular source members admitted")
            result[item.name] = archive.extractfile(item).read()
            need(len(result[item.name]) == item.size, "Short source member")
    return result


def junit(raw, expected):
    cases = list(ET.fromstring(raw).iter("testcase"))
    need(len(cases) == expected and len({(c.get("classname"), c.get("name")) for c in cases}) == expected
         and all(c.find(kind) is None for c in cases for kind in ("failure", "error", "skipped")),
         "Actual exact distinct JUnit cases without failure/error/skip required")
    return cases


def check_local_and_review(ns, store, review_ref):
    need(review_ref == ns["ref"](INTEGRATION_REVIEW, INTEGRATION_REVIEW_SHA), "Exact actual new independent62 review required")
    manifest_raw = store.pinned(CHAIN / "COMPONENTS.json", COMPONENTS_SHA)
    manifest = ns["strict_json"](manifest_raw)
    need(manifest["scope_id"] == SCOPE and manifest["source_zip_sha256"] == SOURCE
         and manifest["plan_sha256"] == PLAN and len(manifest["code_pins"]) == 62,
         "Exact new62 final bytes, never the candidate60, required")
    adapters = {"COMPONENTS.json": manifest_raw}
    for name, checksum in manifest["code_pins"].items():
        safe_name(name)
        adapters[name] = store.pinned(CHAIN / name, checksum)
    validation = ns["strict_json"](adapters["observer/validation-locale.json"])
    need(set(validation) == {"schema", "ok", "scope_id", "source_zip_sha256", "plan_sha256",
             "observer_sha256", "test_sha256", "junit_sha256", "testcases", "new_allocated_Q_required",
             "CLI_model_process_transport_CIM_or_cache_effects", "native_generation_admitted"}
         and validation["schema"] == "hpc-forest-source110-obs4-local-neutral-validation-v1"
         and validation["ok"] is True and validation["scope_id"] == SCOPE and validation["source_zip_sha256"] == SOURCE
         and validation["plan_sha256"] == PLAN and type(validation["testcases"]) is int and validation["testcases"] == 5
         and validation["observer_sha256"] == digest(adapters["observer/observer-mixte.py"])
         and validation["test_sha256"] == digest(adapters["observer/test_obs4_neutre.py"])
         and validation["junit_sha256"] == digest(adapters["observer/TESTS-OBS4-NEUTRES.xml"])
         and validation["new_allocated_Q_required"] is True
         and type(validation["CLI_model_process_transport_CIM_or_cache_effects"]) is int
         and validation["CLI_model_process_transport_CIM_or_cache_effects"] == 0
         and validation["native_generation_admitted"] is False,
         "Actual new local OBS4 result, never ancestor PASS, required")
    junit(adapters["observer/TESTS-OBS4-NEUTRES.xml"], 5)
    execution = ns["strict_json"](store.pinned(TEST16_EXEC, TEST16_EXEC_SHA))
    intent = ns["strict_json"](store.raw(TEST16_INTENT))
    need(execution["schema"] == "hpc-forest-R8-static16-ROOT-actual-completion-v1"
         and type(execution["exit_code"]) is int and execution["exit_code"] == 0
         and execution["component62_before_after_equal"] is True and execution["native_generation_admitted"] is False
         and intent["schema"] == "hpc-forest-R8-static16-actual-test-intent-v1"
         and intent["components_sha256"] == COMPONENTS_SHA and intent["test_sha256"] == TEST16_SOURCE_SHA
         and type(intent["expected_primary_cases"]) is int and intent["expected_primary_cases"] == 16
         and intent["native_generation_admitted"] is False,
         "Actual ROOT16 completion and exact source/62 intent required")
    store.pinned(TEST16 / "test_r8_statics_reels.py", TEST16_SOURCE_SHA)
    cases = junit(store.pinned(TEST16_XML, TEST16_XML_SHA), 16)
    expected = {"test_plan_has_only_three_fresh_root_uuid_changes": 1,
                "test_new_roots_selectable_and_old_roots_refused": 3,
                "test_nine_actual_command_job_registry_and_stage_bytes": 9,
                "test_actual_whole_manifest_review_and_transitive_pins": 1,
                "test_actual_review1a65_still_accepted_before_any_source_import": 1,
                "test_factory_real_entry_refuses_old_integration_before_bootstrap": 1}
    need(Counter(c.get("name", "").split("[", 1)[0] for c in cases) == expected, "Actual16 case families differ")
    local_review = ns["strict_json"](store.pinned(LOCAL_REVIEW, LOCAL_REVIEW_SHA))
    need(local_review["schema"] == "hpc-forest-r8-independent-actual-local-neutral-results-and-seal-review-v1"
         and local_review["verified_local_results_and_seal_only"] is True and local_review["blocking_findings"] == []
         and local_review["source_zip_sha256"] == SOURCE and local_review["plan_sha256"] == PLAN
         and local_review["components_sha256"] == COMPONENTS_SHA and local_review["actual_primary_testcases"] == 94
         and local_review["native_generation_admitted"] is False,
         "Actual independent94 local results/seal review required; never an allocated Q")
    review = store.reference(review_ref)
    need(review["schema"] == "hpc-forest-dynamic-r4b-integration-review-v1" and review["verified"] is True
         and review["blocking_findings"] == [] and review["neutral_tests_passed"] is True
         and review["scope_id"] == SCOPE and review["source_zip_sha256"] == SOURCE and review["plan_sha256"] == PLAN
         and review["adapter_revision"] == "r4b-source110-external-adapters-r2"
         and review["adapter_components_manifest_sha256"] == COMPONENTS_SHA
         and review["reviewed_files"] == manifest["code_pins"] and review["native_generation_admitted"] is False
         and review["observer_sha256"] == digest(adapters["observer/observer-mixte.py"])
         and review["abi_sha256"] == digest(adapters["observer/ABI.json"])
         and review["producer_sha256"] == digest(adapters["lane_projection.py"]),
         "Actual independent new62 review with exact transitive/observer pins required")
    source_review = store.pinned(SOURCE_REVIEW, SOURCE_REVIEW_SHA)
    checked = ns["strict_json"](source_review)
    need(checked["verified_source_preparation_only"] is True and checked["blocking_findings"] == []
         and checked["plan"]["sha256"] == PLAN and checked["source_zip"]["sha256"] == SOURCE
         and checked["native_generation_admitted"] is False, "Actual source/new-plan review required")
    return adapters, source_review


def replace_once(raw, old, new):
    need(raw.count(old.encode()) == 1, "One exact qualified wrapper literal required: " + old[:70])
    return raw.replace(old.encode(), new.encode())


def make_packet(ns, store, recipes, adapters, source_review, review_ref):
    frozen = {name: store.pinned(Path(item["path"]), item["sha256"]) for name, item in recipes["files"].items()}
    old_bindings = ns["strict_json"](frozen["bindings.json"])
    source = archive_map(frozen["source-bundle.tar.gz"], 116)
    runtime = ns["strict_json"](source["runtime-manifest.json"])
    need(len(runtime) == 110 and digest(source["project.zip"]) == SOURCE
         and digest(source["runtime-manifest.json"]) == ns["SOURCE_MANIFEST_SHA"]
         and {name: digest(source["project/" + name]) for name in runtime} == runtime,
         "Actual unchanged source110/ZIP/runtime required")
    expected_names = {"project/" + name for name in runtime} | {
        "project.zip", "dynamic-plan.json", "runtime-manifest.json", "DESIGN-INTERFACE.json",
        "predecessor/project.zip", "predecessor/plan.json"}
    need(set(source) == expected_names and digest(source["dynamic-plan.json"]) == OLD_PLAN,
         "Closed116 R7 source ancestry required")
    source["dynamic-plan.json"] = store.pinned(CHAIN / "plan-technique-neuf/dynamic-plan-r4b-lane-r3-max-r8.json", PLAN)
    source_bytes = packed(source)
    payload = {name.removeprefix("payload/"): raw for name, raw in frozen.items() if name.startswith("payload/")}
    del payload["payload-manifest.json"]
    del payload["source-preparation-review-R7.json"]
    del payload["adapter-independent-review-R7.json"]
    portable = replace_once(payload["test_source_state_review_portable.py"], OLD_PLAN, PLAN)
    need(same_python_structure(payload["test_source_state_review_portable.py"], portable), "Portable9 control structure changed")
    payload["test_source_state_review_portable.py"] = portable
    payload["source-preparation-review-R8.json"] = source_review
    payload["adapter-independent-review-R8.json"] = store.pinned(Path(review_ref["path"]), review_ref["sha256"])
    payload["payload-manifest.json"] = ns["json_bytes"]({"files": {n: digest(v) for n, v in payload.items()},
        "Windows_code_metadata_data_only": True, "no_current_CIM_or_authorization_or_credential_or_policy_catalogue": True,
        "portable_positive_boundary": "Exact production function reaches source_modules sentinel; no projection or admission returned"})
    need(len(payload) == 9, "Same nine reviewed metadata payload files required")
    adapter_bytes, payload_bytes = packed(adapters), packed(payload)
    bindings = dict(old_bindings)
    bindings.update(plan_sha256=PLAN, source_bundle_sha256=digest(source_bytes), adapter_bundle_sha256=digest(adapter_bytes),
        adapter_components_manifest_sha256=COMPONENTS_SHA, remote_root=REMOTE,
        review_payload_bundle_sha256=digest(payload_bytes), review_payload_files={n: digest(v) for n, v in payload.items()},
        old_Q_promoted=False, native_generation_admitted=False)
    need(bindings["source_bundle_member_count"] == 116 and bindings["adapter_bundle_member_count"] == 63
         and bindings["review_payload_member_count"] == 9 and bindings["total_neutral_case_count"] == 274,
         "Original neutral group sizes and packet surfaces must remain exact")
    wrapper = frozen["qualification-wrapper.py"]
    for old, new in ((OLD_PLAN, PLAN), (old_bindings["source_bundle_sha256"], digest(source_bytes)),
                     ("source-preparation-review-R7.json", "source-preparation-review-R8.json"),
                     ("adapter-independent-review-R7.json", "adapter-independent-review-R8.json"),
                     (OLD_REVIEW_SHA, review_ref["sha256"]), ("r7_qualified_metadata_contract", "r8_qualified_metadata_contract"),
                     ("Allocated R7 qualification:", "Allocated R8 qualification:")):
        wrapper = replace_once(wrapper, old, new)
    need(same_python_structure(frozen["qualification-wrapper.py"], wrapper), "Allocated wrapper logic/counts/resources changed")
    files = {"qualification-wrapper.py": wrapper, "bindings.json": ns["json_bytes"](bindings),
             "source-bundle.tar.gz": source_bytes, "adapter-bundle.tar.gz": adapter_bytes,
             "review-payload.tar.gz": payload_bytes, "archive_regular_only.py": frozen["archive_regular_only.py"]}
    files["packet-manifest.json"] = ns["json_bytes"]({n: digest(v) for n, v in files.items()})
    packet = packed(files)
    command = frozen["commande-allouee-zero-modele.sh"].decode("utf-8")
    need(ns["strict_json"](frozen["job-prepare-PROPOSITION-NON-SOUMISE.json"])["command"] == command,
         "Actual ancestor shell/job bytes must agree")
    command = command.replace(old_bindings["remote_root"], REMOTE).replace(OLD_PACKET_SHA, digest(packet))
    bootstrap = frozen["bootstrap-alloue.py"]
    start = command.index("<<'R4B_Q110_BOOTSTRAP'\n") + len("<<'R4B_Q110_BOOTSTRAP'\n")
    end = command.index("\nR4B_Q110_BOOTSTRAP", start)
    need(command[start:end] == bootstrap.decode("utf-8").rstrip("\n")
         and len([line for line in command.splitlines() if re.match(r"^srun\s", line)]) == 1
         and old_bindings["remote_root"] not in command and OLD_PACKET_SHA not in command,
         "Exact one-srun unchanged inline bootstrap and new packet/root binding required")
    job = ns["strict_json"](frozen["job-prepare-PROPOSITION-NON-SOUMISE.json"])
    job.update(name="forest-r4b-Q110-neutral-target-r8", command=command)
    need(job["arch"] == "armgpu" and job["cpus_per_task"] == 4 and job["mem_gb"] == 16
         and job["gpus_per_node"] == 0 and job["time_limit"] == "00:10:00"
         and job["spack_packages"] == [] and job["data_files"] == [], "Same 10min ARM4/16GiB/0GPU without install required")
    outputs = {**files, "bootstrap-alloue.py": bootstrap, "complete-source110-r8-neutral-target-packet.tar.gz": packet,
               "commande-allouee-zero-modele.sh": command.encode("utf-8"),
               "job-prepare-PROPOSITION-NON-SOUMISE.json": ns["json_bytes"](job)}
    return outputs, bindings


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--integration-review", type=Path, required=True)
    parser.add_argument("--integration-review-sha256", required=True)
    parser.add_argument("--builder-review", type=Path, required=True)
    parser.add_argument("--builder-review-sha256", required=True)
    parser.add_argument("--output-directory", type=Path, required=True)
    parser.add_argument("--construct-local-packet-only", action="store_true")
    args = parser.parse_args()
    need(args.construct_local_packet_only, "Explicit ROOT local-only construction required")
    ns, store = preparation_io()
    output = ns["ordinary_path"](args.output_directory, beneath=HERE, missing_leaf=True)
    need(output.parent == HERE and re.fullmatch(r"paquet-root-[0-9]{2,4}", output.name), "New direct packet output only")
    ns["require_missing"](output)
    builder_review_path = ns["ordinary_path"](args.builder_review, beneath=HERE / "revue-preparation-independante-r1")
    builder_ref = ns["ref"](builder_review_path, args.builder_review_sha256)
    builder_review = store.reference(builder_ref)
    need(builder_review["schema"] == "hpc-forest-r8-Q-builder-independent-preparation-review-v1"
         and builder_review["verified_source_preparation_only"] is True and builder_review["blocking_findings"] == []
         and builder_review["reviewed_files"].get(SELF.name) == digest(store.raw(SELF))
         and builder_review["native_generation_admitted"] is False, "Actual independent builder review required")
    integration_path = ns["ordinary_path"](args.integration_review, beneath=PREP)
    review_ref = ns["ref"](integration_path, args.integration_review_sha256)
    adapters, source_review = check_local_and_review(ns, store, review_ref)
    recipes = ns["strict_json"](store.pinned(RECIPES, RECIPES_SHA))
    outputs, bindings = make_packet(ns, store, recipes, adapters, source_review, review_ref)
    store.unchanged()
    before = dict(store.pins)
    metadata_before = {path: list(store.api["metadata"](Path(path).lstat())) for path in before}
    with ns["DirectoryLeases"]() as leases:
        leases.hold(HERE)
        ns["ordinary_path"](output, beneath=HERE, missing_leaf=True)
        ns["require_missing"](output)
        output.mkdir()
        leases.hold(output)
        for name, raw in outputs.items():
            need("/" not in name and "\\" not in name, "Only flat ordinary packet outputs required")
            ns["write_new"](output / name, raw)
            need(store.api["raw"](output / name) == raw, "New packet output changed")
        store.unchanged()
        metadata_after = {p: list(store.api["metadata"](Path(p).lstat())) for p in before}
        need(store.pins == before and metadata_after == metadata_before,
             "Input hash/full metadata changed during construction")
        report = {"schema": "hpc-forest-r8-local-Q-packet-construction-only-v1", "packet_constructed_only": True,
            "source_zip_sha256": SOURCE, "plan_sha256": PLAN, "adapter_components_manifest_sha256": COMPONENTS_SHA,
            "independent62_review": review_ref, "builder_review": builder_ref, "remote_root_proposed": REMOTE,
            "local_static16_completion": ns["ref"](TEST16_EXEC, TEST16_EXEC_SHA),
            "local_static16_junit": ns["ref"](TEST16_XML, TEST16_XML_SHA),
            "actual_independent94_local_review": ns["ref"](LOCAL_REVIEW, LOCAL_REVIEW_SHA),
            "output_inventory": {n: {"bytes": len(v), "sha256": digest(v)} for n, v in outputs.items()},
            "planned_neutral_groups": [26, 152, 9, 73, 5, 9], "planned_unique_cases": 274,
            "official_target_profile_calls_planned_under_allocation": 1, "official_neutral_probes_planned": 2,
            "allocation_submitted": False, "allocated_Q_received": False, "native_generation_admitted": False,
            "scientific_method_budget_or_R7_timers_reset": False,
            "input_sha256_before": before, "input_sha256_after": dict(store.pins),
            "input_metadata_before": metadata_before, "input_metadata_after": metadata_after,
            "failure_policy": "Preserve partial new output; no overwrite, cleanup, resume or retry after unknown submission"}
        report_bytes = ns["json_bytes"](report)
        ns["write_new"](output / "CONSTRUCTION-LOCALE-PAQUET-NON-SOUMIS.json", report_bytes)
        collection_bytes = ns["json_bytes"]({
            "schema": "hpc-forest-r8-Q-future-cold-collection-NON-ADMIS-v1", "verified": False,
            "source_zip_sha256": SOURCE, "plan_sha256": PLAN, "components_sha256": COMPONENTS_SHA,
            "remote_root_proposed": REMOTE, "actual_job_id": None, "actual_submission_intent": None,
            "actual_submission_observed": None, "actual_status": None, "actual_efficiency": None,
            "actual_unique_log_announcement": None, "actual_envelope_and_transfer": None,
            "actual_regular_archive_and_transfer": None, "actual_regular_receipt_and_transfer": None,
            "three_announced_remote_local_SHA_equal": False, "actual_cold_restoration": None,
            "actual_six_suite_triplets_274_and_current_allocated_target_profile": None,
            "actual_independent_cold_Q_audit_and_reference_inheritance": None,
            "old_Q_profile_or_archive_promoted": False, "native_generation_admitted": False})
        ns["write_new"](output / "CONTRAT-COLLECTE-Q-R8-NON-ADMIS.json", collection_bytes)
        for name, raw in outputs.items():
            need(store.api["raw"](output / name) == raw, "Outputs changed before completion")
        need(store.api["raw"](output / "CONSTRUCTION-LOCALE-PAQUET-NON-SOUMIS.json") == report_bytes
             and store.api["raw"](output / "CONTRAT-COLLECTE-Q-R8-NON-ADMIS.json") == collection_bytes,
             "New local reports changed after exclusive write")
        store.unchanged()
        need({p: list(store.api["metadata"](Path(p).lstat())) for p in before} == metadata_before,
             "Full source metadata changed after local report")
    print(json.dumps({"output_directory": str(output), "packet_sha256": digest(outputs["complete-source110-r8-neutral-target-packet.tar.gz"]),
                      "remote_root_proposed": bindings["remote_root"], "native_generation_admitted": False}))


if __name__ == "__main__":
    main()

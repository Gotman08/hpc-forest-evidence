"""Canonical article consolidation, with a fail-closed frozen-data gate."""

import hashlib
import json
import runpy
from pathlib import Path

HERE = Path(__file__).resolve().parent


def received_files():
    study = HERE.parent
    outputs = study.parent
    return {
        "r1": sorted(str(p.resolve()) for p in (study / "runs").glob("*/audit.json")),
        "cpu": sorted(
            str(p.resolve())
            for dirname in (
                "HPC-Forest-Conformite-Coeurs-r2",
                "HPC-Forest-Conformite-Coeurs-r3",
            )
            for p in (outputs / dirname).glob("serie-*/audit.json")
        ),
        "gpt96": sorted(
            str(p.resolve())
            for p in (outputs / "Marathon22-GPT61Sol-MAX/reference96-r2").rglob(
                "audit*.json"
            )
        ),
        "r4": sorted(
            str(p.resolve())
            for p in (outputs / "HPC-Forest-Mere-Dynamique-r4").rglob("audit*.json")
        ),
        "source_only": sorted({
            str(p.resolve())
            for pattern in ("runs/*/audit.json", "receptions/*/audit*.json",
                            "receptions/*/audit-*/AUDIT*.json",
                            "receptions/*/audit-*/audit*.json")
            for p in (outputs / "HPC-Forest-Harnais-Comparaison-r1").glob(pattern)
        }),
    }


def sha(p):
    with Path(p).open("rb") as f:
        return hashlib.file_digest(f, "sha256").hexdigest()


def main():
    admissions = json.loads((HERE / "admissions.json").read_text(encoding="utf-8"))
    if received_files() != admissions["received_file_paths"]:
        raise RuntimeError(
            "New reception/audit detected: preserve the edition and explicitly review/admit the new evidence before rebuilding"
        )
    audit = json.loads((HERE / "audit-calculs.json").read_text(encoding="utf-8"))
    assert audit["verified"]
    for rel, expected in audit["frozen_data_files"].items():
        if sha(HERE / "donnees" / rel) != expected:
            raise RuntimeError(
                "Frozen data changed: "
                + rel
                + "; run the independent audit before consolidation"
            )
    # Live matrices are snapshots, not final results. Closed scientific inputs
    # must still match their receipt; an unreviewed result cannot silently enter.
    live_names = {"coordinator-state.json", "MATRICE.json", "current-job.json", "ID.md"}
    for path, info in audit["sources"].items():
        p = Path(path)
        if p.name not in live_names and sha(p) != info["sha256"]:
            raise RuntimeError(
                "Scientific source changed: "
                + path
                + "; a new reviewed snapshot is required"
            )
    runpy.run_path(str(HERE / "assembler.py"), run_name="__main__")
    runpy.run_path(str(HERE / "figures.py"), run_name="__main__")


if __name__ == "__main__":
    main()

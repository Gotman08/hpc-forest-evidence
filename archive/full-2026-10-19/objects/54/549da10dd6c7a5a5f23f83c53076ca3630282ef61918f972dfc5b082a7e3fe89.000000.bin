          "depth": 1,
          "epoch": 1,
          "hypothesis": "A stable LSD byte-radix sort should reduce the sort's work from comparison sorting to a small number of sequential passes. Adding the archived SIMD reduction to the post-sort check may also reduce the cost of its full-array scan, which successful sorted outputs always require.",
          "id": "9e2ff58f3d9348b2",
          "ordinal": 1,
          "parent_id": null,
          "role": "G",
          "source_commits": [

        "state": "completed",
        "mission": {
          "base_commit": "484c243121fed4562b6c8565052db5d61746f146",
          "delegation_parent": "R/A",
          "depth": 1,
          "epoch": 1,
          "hypothesis": "Replacing the per-sweep interior copy with a ping-pong buffer swap should reduce memory traffic in the Jacobi iteration while preserving its output and convergence behavior.",
          "id": "686876c0b37b4477",
          "ordinal": 1,
          "parent_id": null,
          "role": "A",
          "source_commits": [],
          "sources": [],
          "transformations": {
            "files": [
              "src/laplace_seq.c"
            ],
            "retained": [
              "Initialize both buffers to the same initial grid, including untouched border cells.",
              "Remove the interior copy pass and swap the buffer pointers after each executed sweep, including the sweep that triggers convergence."
            ]
          },
          "tree_id": "e1:A",
          "trial_id": "01M5418QY6BNAPT77PXEMK67NG",

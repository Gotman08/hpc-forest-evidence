      {
        "id": "9a6a7ca582044d61",
        "role": "G",
        "state": "completed",
        "mission": {
          "base_commit": "cfb4a739deeb9a904c4a878935de7fcbfd6198ac",
          "delegation_parent": "R/G",
          "depth": 1,
          "epoch": 1,
          "hypothesis": "A serial bounded max-heap paired with per-group x/y structure-of-arrays storage should reduce selection work and improve coordinate scanning on the ARM64 target. Falling back to the original selection logic on NaN distances preserves its behavior where a total heap ordering is unavailable; OpenMP is omitted because the archived parallel candidates were slower.",
          "id": "9a6a7ca582044d61",
          "ordinal": 1,
          "parent_id": null,
          "role": "G",
          "source_commits": [
            "251e5f3299172192d2091807b2e5e7cd873ac722",
            "838aa32177e95be0a0919d32950c96f6ea3a7a15"
          ],
          "sources": [
            "4e5248ae712349b9",
            "718bf7eca1eb4d80"
          ],
          "transformations": {
            "files": [
              "src/knn.c",
              "src/knn.h"
            ],
            "retained": [
              "Store each group's coordinates in one allocation with separate contiguous x and y planes; hoist query coordinates and scan those planes in the distance loop.",
              "Keep at most k candidates in a max-heap ordered by squared distance and original encounter index, preserving first-encounter ties and -1 padding for underfilled k.",
              "Use the baseline sorted-array selection path if a computed distance is NaN; retain the existing label sort and vote logic."
            ]
          },
          "tree_id": "e1:G",
          "trial_id": "01M5436KSHJ2HZ5F2A5WAR6ASQ",

          "depth": 1,
          "epoch": 1,
          "hypothesis": "Iterative MSD radix sorting with contiguous ping-pong index buffers should eliminate quadratic bucket sorting and reduce copying while removing assumed bucket capacities.",
          "id": "359d63d4e77e4d82",
          "ordinal": 1,
          "parent_id": null,
          "role": "A",
          "source_commits": [],
          "sources": [],
          "transformations": {
            "files": [
              "src/bucketsort.c"
            ],
            "retained": [
              "Replace fixed-capacity buckets with exact unsigned-byte histograms and prefix-sum ranges.",
              "Alternate index buffers between radix levels; copy back only completed ranges.",
              "Use an explicit work stack, skip redistribution across common prefixes, and terminate NUL buckets without reading padding.",
              "Insertion-sort ranges of at most 16 indices using only the unresolved suffix.",
              "Keep token I/O formatting, widen record loops to long int, and check auxiliary allocation sizes."
            ]
          },
          "tree_id": "e1:A",

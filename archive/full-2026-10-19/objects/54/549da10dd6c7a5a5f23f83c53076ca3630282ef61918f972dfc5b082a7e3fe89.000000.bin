          "base_commit": "a6468c05989fe92f0635bd06e9860441b718edc5",
          "delegation_parent": "R/C",
          "depth": 1,
          "epoch": 1,
          "hypothesis": "Grouping four target bodies per statically scheduled work item and SIMD-processing those independent targets can reuse source coordinates and improve force-kernel throughput on the four-core ARM64 target. A single OpenMP team spans all iterations, while small inputs use a serialized team; each target still accumulates sources in ascending order.",
          "id": "acaa3906dfa64db7",
          "ordinal": 2,
          "parent_id": null,
          "role": "C",
          "source_commits": [],
          "sources": [],
          "transformations": {
            "files": [
              "src/nbody.c"
            ],
            "retained": [
              "Use a persistent OpenMP parallel region for all simulation iterations, with static worksharing for target tiles and position updates and an implicit force-to-update barrier.",
              "Process four targets together, preload their coordinates, and apply OpenMP SIMD across target lanes while preserving each target's original ascending source-body accumulation order.",
              "Use a generic body-count threshold to avoid creating a multi-thread team for small inputs; the same loops remain a serial fallback when OpenMP pragmas are ignored."
            ]
          },
          "tree_id": "e1:C",

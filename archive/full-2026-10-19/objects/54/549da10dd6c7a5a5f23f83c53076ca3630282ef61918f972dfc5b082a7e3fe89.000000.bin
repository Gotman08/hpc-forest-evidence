          "delegation_parent": "R/B",
          "depth": 1,
          "epoch": 1,
          "hypothesis": "Cached lexicographic prefixes and stable bottom-up index mergesort should remove quadratic insertion dependencies and reduce strcmp traffic. Separating branch-free pair ordering from string-tie resolution exposes legal SIMD work while keeping dependent merge cursors scalar.",
          "id": "32fe3dd180b54ee6",
          "ordinal": 1,
          "parent_id": null,
          "role": "B",
          "source_commits": [],
          "sources": [],
          "transformations": {
            "files": [
              "src/bucketsort.c"
            ],
            "retained": [
              "Replace fixed-capacity buckets and insertion sorting with stable, distribution-independent bottom-up mergesort using reusable index scratch storage.",
              "Cache eight-byte order-preserving prefixes without reading past terminators; compare remaining suffixes only when necessary.",
              "Separate independent pair compare-exchanges from scalar prefix-tie correction, and use nonoverlapping bulk copies for merge tails.",
              "Use checked allocation sizes, size_t record addressing, and long-count I/O loops."
            ]
          },
          "tree_id": "e1:B",

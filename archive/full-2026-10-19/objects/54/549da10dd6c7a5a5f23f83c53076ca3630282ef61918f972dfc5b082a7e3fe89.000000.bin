          "depth": 1,
          "epoch": 1,
          "hypothesis": "Storing each matrix in one contiguous row-major allocation and reusing row pointers in the stencil loop may improve cache and TLB locality while reducing repeated row-pointer lookups, without changing the Jacobi iteration's arithmetic or output.",
          "id": "fda120e66a97433b",
          "ordinal": 2,
          "parent_id": null,
          "role": "A",

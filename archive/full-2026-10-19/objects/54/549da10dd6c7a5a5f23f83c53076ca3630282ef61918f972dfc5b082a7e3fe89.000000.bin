          "transformations": {
            "files": [
              "src/permutations.cc"
            ],
            "retained": [
              "Replace per-character std::cout insertions and per-permutation std::endl flushing with a fixed 64-KiB buffer flushed in contiguous writes.",
              "Replace std::reverse with a generic bidirectional-iterator reversal loop that performs up to two disjoint swaps per iteration, leaving successor scanning sequential.",
              "Bound the non-increasing-suffix scan at the first iterator to avoid decrementing it before the range begins."
            ]
          },

          "delegation_parent": "R/A",
          "depth": 1,
          "epoch": 1,
          "hypothesis": "A contiguous row-major representation for the dense adjacency and temporary cycle matrices should improve locality during Prim and cycle scans. Passing read-only graphs and matrices by reference should also remove repeated large copies without changing traversal or edge-selection order.",
          "id": "591767ea290a4457",
          "ordinal": 1,
          "parent_id": null,
          "role": "A",
          "source_commits": [],
          "sources": [],

          "depth": 1,
          "epoch": 1,
          "hypothesis": "Stable byte-radix passes should preserve the measured sorting improvement, while a static OpenMP SIMD reduction may shorten verification of large arrays on the four-core ARM64 target. A Hoare-partition fallback should also limit stack growth if radix scratch allocation fails.",
          "id": "0a34b3bd74b24ea1",
          "ordinal": 2,
          "parent_id": null,
          "role": "G",
          "source_commits": [

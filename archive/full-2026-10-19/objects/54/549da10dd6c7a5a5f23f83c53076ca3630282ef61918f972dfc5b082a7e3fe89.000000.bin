          "base_commit": "a6468c05989fe92f0635bd06e9860441b718edc5",
          "delegation_parent": "R/C",
          "depth": 1,
          "epoch": 1,
          "hypothesis": "A persistent OpenMP team with static target-body work sharing should reduce team-creation and scheduling overhead while using the four available cores for sufficiently large inputs. A serial threshold avoids parallel overhead on small inputs.",
          "id": "45fb266b52cf459e",
          "ordinal": 1,
          "parent_id": null,
          "role": "C",
          "source_commits": [],
          "sources": [],
          "transformations": {
            "files": [
              "src/nbody.c"
            ],
            "retained": [
              "Reuse one OpenMP parallel region across all simulation iterations instead of creating a team for each loop.",
              "Use schedule(static) for the uniform-cost target-body and integration loops.",
              "Use a serial OpenMP region for inputs with fewer than 64 bodies to limit thread overhead."
            ]
          },
          "tree_id": "e1:C",

          "delegation_parent": "R/C",
          "depth": 1,
          "epoch": 1,
          "hypothesis": "Coarse, ordered OpenMP work sharing can accelerate permutation generation and formatting once per-line flushing is replaced with bounded buffering.",
          "id": "6160a1cc6006402b",
          "ordinal": 1,
          "parent_id": null,
          "role": "C",
          "source_commits": [],
          "sources": [],
          "transformations": {
            "files": [
              "src/permutations.cc"
            ],
            "retained": [
              "Replace formatted per-character output and per-line flushing with exact-format 64 KiB buffering.",
              "Lazily partition permutations into lexicographically ordered, prefix-free subtrees using overflow-capped multiset counts.",
              "Use a persistent OpenMP team capped at four threads, dynamically scheduled subtrees, and ordered emission; bound pending jobs to sixteen and each producer buffer to 64 KiB.",
              "Retain serial fallbacks based on output volume, permutation count, and chunk granularity."
            ]
          },
          "tree_id": "e1:C",

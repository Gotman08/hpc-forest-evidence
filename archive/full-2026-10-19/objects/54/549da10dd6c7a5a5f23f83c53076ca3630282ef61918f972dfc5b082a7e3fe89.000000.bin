          "base_commit": "6e260c453f702b379843873d0bc150cf6becca52",
          "delegation_parent": "R/C",
          "depth": 1,
          "epoch": 1,
          "hypothesis": "For sufficiently large graphs, zero-initializing the dense adjacency matrix is substantial independent row work; static OpenMP row scheduling should reduce constructor time while a serial path avoids parallel-region overhead on smaller graphs.",
          "id": "7dccdc515b884134",
          "ordinal": 1,
          "parent_id": null,
          "role": "C",
          "source_commits": [],
          "sources": [],
          "transformations": {
            "files": [
              "src/tropical.cpp"
            ],
            "retained": [
              "Resize the matrix and color vectors once, then initialize each distinct adjacency row with a static OpenMP work-sharing loop when the vertex count is at least 256; retain serial row initialization below that threshold."
            ]
          },
          "tree_id": "e1:C",

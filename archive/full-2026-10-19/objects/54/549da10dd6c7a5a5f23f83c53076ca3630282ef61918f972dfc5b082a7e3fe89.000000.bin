          "depth": 1,
          "epoch": 1,
          "hypothesis": "A single static OpenMP work-sharing loop over independent columns should expose parallelism while avoiding repeated team start-up across the metric passes. A workload threshold keeps small inputs on the serial path; per-column accumulation order and output order remain unchanged.",
          "id": "98da71b7f3554f73",
          "ordinal": 1,

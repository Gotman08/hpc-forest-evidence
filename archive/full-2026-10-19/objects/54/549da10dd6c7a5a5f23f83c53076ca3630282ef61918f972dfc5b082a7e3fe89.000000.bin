          "depth": 1,
          "epoch": 1,
          "hypothesis": "Pairing bands along the smaller matrix dimension reduces the work from O(M·N²) to O(min(M,N)²·max(M,N)); storing the oriented matrix contiguously also makes each band extension scan contiguous data.",
          "id": "ff5ae3a428fe4053",
          "ordinal": 1,
          "parent_id": null,
          "role": "A",
          "source_commits": [],
          "sources": [],
          "transformations": {
            "files": [
              "src/main.cpp"
            ],
            "retained": [
              "Orient the input as a row-major matrix with the smaller original dimension as rows, transposing while reading when needed.",
              "Enumerate row bands along that smaller dimension, incrementally update a column-sum vector, and count target-sum intervals with the existing hash-based prefix method."
            ]
          },

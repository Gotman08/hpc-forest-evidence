          "depth": 1,
          "epoch": 1,
          "hypothesis": "Byte-contiguous adjacency rows allow the compiler to vectorize independent row-degree reductions, while degree invariants reject many impossible permutations before the quadratic adjacency check without changing emitted permutation order.",
          "id": "bf8a766155b443d9",
          "ordinal": 1,
          "parent_id": null,
          "role": "B",
          "source_commits": [],
          "sources": [],
          "transformations": {
            "files": [
              "src/brute_isomorphism.cpp"
            ],
            "retained": [
              "Changed adjacency entries from packed vector<bool> proxies to contiguous unsigned-char row storage, retaining boolean edge semantics.",
              "Added row-degree computation with independent per-row integer reductions that are suitable for legal compiler auto-vectorization.",
              "Reject unequal degree multisets once and skip candidate permutations whose mapped vertex degrees differ, while retaining Heap permutation traversal and existing output behavior for survivors."
            ]
          },
          "tree_id": "e1:B",
          "trial_id": "01M53YR0G4KC22QJHTXR24HA3X",

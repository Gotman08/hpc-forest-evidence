          "sources": [],
          "transformations": {
            "files": [
              "src/sokoban.c"
            ],
            "retained": [
              "Keep the small-frontier search sequential, then use one persistent OpenMP team to share wide BFS frontiers across contiguous parent ranges.",
              "Collect each worker's candidates in order and merge them serially by thread range, retaining the original expansion and tie-break order.",
              "Guard state-pool allocation in parallel move generation and reject moves that leave board bounds."
            ]
          },

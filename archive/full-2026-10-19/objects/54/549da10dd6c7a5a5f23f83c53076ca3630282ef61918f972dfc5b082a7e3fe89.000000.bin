      {
        "id": "aa19cdb376bf40ea",
        "role": "A",
        "state": "completed",
        "mission": {
          "base_commit": "81628979387ea59d5e3447f6f8f62a711d9d6564",
          "delegation_parent": "R/A",
          "depth": 1,
          "epoch": 1,
          "hypothesis": "An adaptive LSD radix sort should improve locality for integer keys by scanning the input contiguously and distributing through a compact histogram and scratch buffer, while a small insertion-sort cutoff avoids allocation overhead for tiny arrays.",
          "id": "aa19cdb376bf40ea",
          "ordinal": 1,
          "parent_id": null,
          "role": "A",
          "source_commits": [],
          "sources": [],
          "transformations": {
            "files": [
              "src/quicksort.c"
            ],
            "retained": [
              "Replace the normal comparison-sort path with stable 8-bit LSD radix passes and a sequential scratch buffer.",
              "Build per-byte histograms together in one input sweep, then perform stable contiguous passes.",
              "Use in-place insertion sort for arrays of at most 32 elements and retain the existing quicksort as an allocation-failure fallback."
            ]
          },
          "tree_id": "e1:A",
          "trial_id": "01M53VF6AA16S6XG8NC8WAJCXA",

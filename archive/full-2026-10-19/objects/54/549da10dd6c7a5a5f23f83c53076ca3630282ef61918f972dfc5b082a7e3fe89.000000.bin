              "src/npbonacci.cpp"
            ],
            "retained": [
              "Transpose the RHS into the existing auxiliary matrix using 32-by-32 tiles before each multiplication.",
              "Compute each result row from contiguous LHS and transposed-RHS rows, preserving correctness when the operands alias during squaring.",
              "Accumulate at most 16 products before reducing modulo 1,000,000,007; the bound fits in unsigned 64-bit arithmetic for reduced matrix entries."
            ]
          },

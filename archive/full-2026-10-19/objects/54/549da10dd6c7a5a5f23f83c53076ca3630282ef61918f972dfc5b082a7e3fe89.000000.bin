          ],
          "transformations": {
            "files": [
              "src/quicksort.c"
            ],
            "retained": [
              "Use insertion sort for arrays of at most 32 elements and signed-order 8-bit LSD radix passes with a sequential scratch buffer for larger arrays; retain quicksort as the allocation-failure fallback.",
              "Build all per-byte histograms together in one input sweep, then perform stable contiguous passes.",
              "Use an OpenMP SIMD bitwise-OR reduction for the adjacent-element sortedness check."
            ]
          },

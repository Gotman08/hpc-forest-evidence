          "depth": 1,
          "epoch": 1,
          "hypothesis": "A single, coarse-grained OpenMP loop over complete columns can accelerate the quadratic sorting and mode workloads on four cores while preserving every column's floating-point accumulation order.",
          "id": "0cb28b3d325d40bc",
          "ordinal": 1,
          "parent_id": null,
          "role": "C",
          "source_commits": [],
          "sources": [],
          "transformations": {
            "files": [
              "src/est_matriz_seq.c"
            ],
            "retained": [
              "Execute each column's complete statistics pipeline in one static-scheduled OpenMP worksharing loop, keeping input and output serial.",
              "Cap workers by available columns and the OpenMP maximum, requiring approximately 65,536 pair comparisons per worker.",
              "Preserve existing algorithms and within-column operation order; initialize mode counters with calloc while retaining float conversions and tie selection."
            ]
          },

    "trials": [
      {
        "id": "e18f651dc5c24455",
        "role": "A",
        "state": "completed",
        "mission": {
          "base_commit": "275b094b23dae5bf71820bd693dcbc0d00dee280",
          "delegation_parent": "R/A",
          "depth": 1,
          "epoch": 1,
          "hypothesis": "A blocked k-i-j multiplication kernel will stream the right-hand matrix and output rows contiguously, while reducing modulo once per 16-term k block instead of after every multiply-add.",
          "id": "e18f651dc5c24455",
          "ordinal": 1,
          "parent_id": null,
          "role": "A",
          "source_commits": [],
          "sources": [],
          "transformations": {
            "files": [
              "src/npbonacci.cpp"
            ],
            "retained": [
              "Use a shared implementation for both multiply overloads, with four-row i blocking, 16-term k blocking, and contiguous j traversal.",
              "Reduce each output row modulo mod after each k block; preserve the existing exact modular result."
            ]
          },
          "tree_id": "e1:A",
          "trial_id": "01M545YBE03JFHAFQPHB8SN5J7",

          "delegation_parent": "R/C",
          "depth": 1,
          "epoch": 1,
          "hypothesis": "Recursive OpenMP tasks on coarse subranges, combined with duplicate-aware partitioning and a parallel sortedness reduction, should reduce elapsed time on the four-core target while keeping small inputs serial.",
          "id": "650e477419964400",
          "ordinal": 1,
          "parent_id": null,
          "role": "C",
          "source_commits": [],
          "sources": [],
          "transformations": {
            "files": [
              "src/quicksort.c"
            ],
            "retained": [
              "Replace two-way random partitioning with median-of-three three-way partitioning, insertion sorting for tiny ranges, and a depth-limited heapsort fallback.",
              "Use one OpenMP team for large inputs; create tasks only for subranges of at least 32768 elements and avoid team startup below that cutoff.",
              "Check large sorted arrays using a static-scheduled OpenMP loop with a bitwise-OR reduction."
            ]
          },
          "tree_id": "e1:C",

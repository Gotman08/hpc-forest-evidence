          "depth": 1,
          "epoch": 1,
          "hypothesis": "Row-blocked ingestion with fused original-order sums will reduce strided writes and matrix traversals, complementing cache-local sorting and per-column statistics.",
          "id": "c28a5b745153491c",
          "ordinal": 2,
          "parent_id": null,
          "role": "A",
          "source_commits": [],
          "sources": [],
          "transformations": {

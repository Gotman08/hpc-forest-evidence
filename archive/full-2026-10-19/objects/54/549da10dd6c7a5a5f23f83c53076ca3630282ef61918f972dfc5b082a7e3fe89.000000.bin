            "files": [
              "src/solution.cpp"
            ],
            "retained": [
              "Replace per-window S-by-S updates with vertical rolling column sums and horizontal sliding sums.",
              "Stream each matrix row once into an S-row ring buffer, updating column sums as departing rows are replaced.",
              "Use contiguous row-major storage and 64-bit accumulators for window sums."
            ]
          },
          "tree_id": "e1:A",

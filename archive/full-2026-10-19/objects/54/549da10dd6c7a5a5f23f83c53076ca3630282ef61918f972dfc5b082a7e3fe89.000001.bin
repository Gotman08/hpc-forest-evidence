        "mission": {
          "base_commit": "88449bacbfe63c8c13e883dab7e1bd6dbf24178c",
          "delegation_parent": "R/A",
          "depth": 1,
          "epoch": 1,
          "hypothesis": "A compact ID-to-row hash index should eliminate repeated strided linear scans while preserving recursive path selection and floating-point evaluation order.",
          "id": "43e658519ac24b9a",
          "ordinal": 1,
          "parent_id": null,
          "role": "A",
          "source_commits": [],
          "sources": [],
          "transformations": {
            "files": [
              "src/graph.c"
            ],
            "retained": [
              "Build one immutable, contiguous open-addressed index per graph with power-of-two capacity and at most 50% occupancy.",
              "Store adjacent IDs and row-plus-one values, preserve first-row duplicate semantics, and resolve collisions by linear probing without reserving any integer ID.",
              "Pass the index through recursive lookups; retain linear scans if index sizing or allocation fails, and release the index after processing.",
              "Allocate the existing node array for every positive row count, including singleton inputs."
            ]
          },
          "tree_id": "e1:A",

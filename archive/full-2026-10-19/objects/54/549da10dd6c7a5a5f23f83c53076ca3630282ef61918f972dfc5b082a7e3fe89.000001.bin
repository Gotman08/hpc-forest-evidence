            "files": [
              "src/knn.c",
              "src/knn.h"
            ],
            "retained": [
              "Convert per-group point storage from array of structs (AoS) to structure-of-arrays (SoA): separate xs and ys arrays",
              "Use FLT_MAX sentinel for distances instead of -1, enabling a single comparison for empty slots",
              "Add early rejection: if top-k list is full and new squared distance >= current maximum, skip the insertion scan entirely",
              "Simplify inner loop condition by removing explicit ==-1 check (replaced with FLT_MAX sentinel)",
              "Parse point coordinates directly into separate xs/ys arrays in parse_next_group"
            ]
          },

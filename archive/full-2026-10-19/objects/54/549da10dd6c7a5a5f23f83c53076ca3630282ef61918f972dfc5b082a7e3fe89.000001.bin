          "sources": [],
          "transformations": {
            "files": [
              "src/sokoban.c"
            ],
            "retained": [
              "Allow successor generation into caller-owned scratch states without accessing the shared allocator.",
              "Use static OpenMP work sharing for batched generation and visited-table probes; serially recheck and commit survivors in the original order.",
              "Require at least 128 parents per worker, lazily reuse at most 2 MiB of scratch storage, and retain serial fallback for narrow frontiers, insufficient workspace, allocation failure or builds without OpenMP."
            ]
          },

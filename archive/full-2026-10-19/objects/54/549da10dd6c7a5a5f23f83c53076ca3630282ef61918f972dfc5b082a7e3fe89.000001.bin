            ],
            "retained": [
              "Replace vector<bool> adjacency rows with zero-initialized byte rows to avoid bit-proxy access overhead.",
              "Scan the same lower triangle in reverse order, recording an exact failed comparison.",
              "Reuse that rejection certificate until a swap touches an endpoint; perform full verification only when the cached mismatch disappears."

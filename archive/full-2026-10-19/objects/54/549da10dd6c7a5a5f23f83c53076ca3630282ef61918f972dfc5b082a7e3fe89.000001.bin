          "delegation_parent": "R/B",
          "depth": 1,
          "epoch": 1,
          "hypothesis": "Explicit two-lane ARM64 NEON stencil evaluation with a bitwise convergence-mask reduction may improve throughput without reassociating floating-point additions.",
          "id": "508bbe71bc3d471c",
          "ordinal": 1,
          "parent_id": null,
          "role": "B",
          "source_commits": [],
          "sources": [],
          "transformations": {
            "files": [
              "src/laplace_seq.c"
            ],
            "retained": [
              "Use restrict-qualified row pointers and an AArch64 NEON kernel preserving east-plus-west-plus-north-plus-south evaluation order.",
              "Accumulate strict convergence comparisons using vector bitwise OR and reduce once per iteration.",
              "Provide a scalar remainder for arbitrary sizes and a scalar fallback for other architectures."
            ]
          },
          "tree_id": "e1:B",

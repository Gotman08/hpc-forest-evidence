            ],
            "retained": [
              "Added ARM64 NEON intrinsics for batched distance computation of four points per iteration",
              "Used vld2q_f32 to deinterleave x/y coordinates from consecutive Point structs",
              "Kept scalar fallback and remainder loop for correctness on all architectures"
            ]
          },

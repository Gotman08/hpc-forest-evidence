          "depth": 1,
          "epoch": 1,
          "hypothesis": "Parallel successor construction and read-only visited-table probes may accelerate wide BFS frontiers on four cores, while ordered serial commits preserve the exact solution trace.",
          "id": "f5127c6b57014fa6",
          "ordinal": 1,
          "parent_id": null,

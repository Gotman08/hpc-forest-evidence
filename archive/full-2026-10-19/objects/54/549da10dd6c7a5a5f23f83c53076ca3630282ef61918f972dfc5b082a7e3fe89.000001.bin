              "src/main.cpp"
            ],
            "retained": [
              "Enumerate boundary pairs along S=min(m,n) and scan L=max(m,n), giving O(S²L) counting work.",
              "Store shorter-dimension prefixes in contiguous long-dimension rows, transposing during preprocessing when necessary.",
              "Apply GCC SIMD-dependence hints only to independent prefix-element and band-difference loops; preserve the reference unordered_map counting method and query-before-insertion ordering."
            ]
          },

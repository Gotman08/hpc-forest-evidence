          "epoch": 1,
          "hypothesis": "An allocation-free streaming mode scan over contiguous sorted columns should reduce mode computation from quadratic to linear time and eliminate repeated memory scans.",
          "id": "01e934b48f9e4b76",
          "ordinal": 2,
          "parent_id": null,

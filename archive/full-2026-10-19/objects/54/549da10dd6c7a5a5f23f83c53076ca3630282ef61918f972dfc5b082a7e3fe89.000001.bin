            ],
            "retained": [
              "Replace companion matrices with polynomial remainders and left-to-right binary exponentiation; set bits require only O(n) multiplication by x.",
              "Store residues in contiguous 32-bit vectors and reuse one 64-bit convolution/reduction buffer.",
              "Use symmetric squaring and sixteen-row descending reduction blocks to amortize modular reductions while preserving exact arithmetic."
            ]
          },

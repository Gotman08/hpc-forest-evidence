            ],
            "retained": [
              "Pack (distance, label) into a contiguous struct array to improve data locality",
              "Skip points whose squared distance is >= current worst kept distance (k-th smallest)",
              "Replace manual element-by-element shift with memmove for block copy",
              "Hoist query point coordinates out of loops"
            ]
          },

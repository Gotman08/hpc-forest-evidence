            ],
            "retained": [
              "Replace companion-matrix exponentiation with generating-function coefficient extraction.",
              "Compute only the required numerator parity, exploit denominator symmetry, and truncate coefficients above the remaining index.",
              "Use overflow-safe 16-product blocks with ARM64 NEON widening multiply-accumulate and a portable scalar fallback.",
              "Replace dense matrices with reusable O(N) polynomial buffers."
            ]
          },

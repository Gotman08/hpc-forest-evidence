              "src/est_matriz_seq.c"
            ],
            "retained": [
              "Count contiguous equal-value runs instead of repeatedly scanning column suffixes or allocating counter arrays.",
              "Preserve float threshold and winner conversions, including large-count rounding and signed-zero selection.",
              "Use initialized pairwise counting when a descending or unordered boundary invalidates contiguous-run counting."
            ]
          },

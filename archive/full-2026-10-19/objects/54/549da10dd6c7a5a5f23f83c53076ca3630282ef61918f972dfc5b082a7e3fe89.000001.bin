          "depth": 1,
          "epoch": 1,
          "hypothesis": "Flat byte adjacency and compact assignment signatures should reduce pointer chasing, bit-proxy overhead, and unnecessary adjacency verification while preserving the original Heap-ordered output.",
          "id": "2035c189319b4049",
          "ordinal": 1,
          "parent_id": null,
          "role": "A",
          "source_commits": [],
          "sources": [],
          "transformations": {
            "files": [
              "src/brute_isomorphism.cpp"
            ],
            "retained": [
              "Replace separately allocated vector<bool> rows with contiguous row-major bytes and direct row-pointer verification.",
              "After checking identity, build loop/population signatures and reject incompatible signature histograms.",
              "Maintain incompatible assignments in constant time per Heap swap; omit filtering work when all signatures are identical.",
              "Retain early-exit exact verification and exhaustive Heap ordering; disable iostream synchronization and per-line flushing."
            ]
          },

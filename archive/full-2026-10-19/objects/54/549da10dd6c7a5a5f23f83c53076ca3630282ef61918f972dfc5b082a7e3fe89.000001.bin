      "python_executable": "/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python",
      "system": "Linux-5.14.0-570.129.1.el9_6.aarch64+64k-aarch64-with-glibc2.34",

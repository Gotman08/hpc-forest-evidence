      {
        "id": "defb055229564964",
        "role": "A",
        "state": "completed",
        "mission": {
          "base_commit": "c78959b7427db9207015e19cb61a9dd725baac70",
          "delegation_parent": "R/A",
          "depth": 1,
          "epoch": 1,
          "hypothesis": "Recycling old north rows as output storage should reduce cache pressure and memory traffic: Jacobi needs only one contiguous grid plus one spare row, with writes following closely behind reads and no full-grid copy.",
          "id": "defb055229564964",
          "ordinal": 2,
          "parent_id": null,
          "role": "A",
          "source_commits": [],
          "sources": [],
          "transformations": {
            "files": [
              "src/laplace_seq.c"
            ],
            "retained": [
              "Replace two separately allocated matrices with contiguous storage for one grid and one spare row.",
              "Compute the first interior row into the spare; compute subsequent rows in their old north-row buffers and rotate logical row pointers.",
              "Use disjoint restricted row pointers while retaining the original per-cell arithmetic and convergence checks.",
              "Preserve each logical row's boundary values and leave the top and bottom boundary rows fixed."
            ]
          },
          "tree_id": "e1:A",
          "trial_id": "01M54MC5KV2X0233W0YKBH8CGQ",

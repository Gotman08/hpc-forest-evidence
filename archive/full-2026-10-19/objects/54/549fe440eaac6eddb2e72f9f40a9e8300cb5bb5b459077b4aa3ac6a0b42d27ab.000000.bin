{
  "files": [
    {
      "content": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <iterator>\n#include <string>\n\n#ifdef _OPENMP\n#include <condition_variable>\n#include <deque>\n#include <memory>\n#include <mutex>\n#include <omp.h>\n#include <utility>\n#include <vector>\n#endif\n\ntemplate <typename Iter> auto\nformat_permutation (Iter first, Iter last) -> std::string\n{\n    std::string line ;\n    line += \"[ \" ;\n    while (first != last) {\n        line.push_back (*first) ;\n        line.push_back (' ') ;\n        ++ first ;\n    }\n    line += \"]\\n\" ;\n    return line ;\n}\n\nstruct PrintPermutation\n{\n    template <typename Iter> auto\n    operator () (Iter first, Iter last) const -> void\n    {\n        std::string line = format_permutation (first, last) ;\n        std::cout.write (line.data (), static_cast <std::streamsize> (line.size ())) ;\n    }\n} ;\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ' )\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v') ;\n    }\n} ;\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase\n        ( std::remove_if\n            ( text.begin ()\n            , text.end ()\n            , IsWhitespace () )\n        , text.end () ) ;\n    return text ;\n}\n\ntemplate <typename Iter> auto\nfind_longest_non_increasing_suffix (Iter first, Iter last) -> Iter\n{\n    if (first == last) return last ;\n    Iter back = std::prev (last) ;\n    if (back == first) return last ;\n    do {\n        -- last ;\n        -- back ;\n    } while ((first != last) && (*back >= *last)) ;\n    return last ;\n}\n\ntemplate <typename Iter> auto\nfind_rightmost_successor (Iter first, Iter second, Iter last) -> Iter\n{\n    if (second == last) return last ;\n    do {\n        -- last ;\n    } while ((second != last) && (*last <= *first)) ;\n    return last ;\n}\n\ntemplate <typename Iter> auto\nnext_permutation (Iter first, Iter last) -> bool\n{\n    if (first == last) return false ;\n    Iter suffix = find_longest_non_increasing_suffix (first, last) ;\n    if (suffix == first) return false ;\n    if (suffix == last)  return false ;\n    Iter pivot = std::prev (suffix) ;\n    Iter successor = find_rightmost_successor (pivot, suffix, last) ;\n    std::iter_swap (pivot, successor) ;\n    std::reverse (suffix, last) ;\n    return true ;\n}\n\ntemplate <typename Iter, typename Function> inline auto\npermutations_iter (Iter first, Iter last, Function driver) -> void\n{\n    if (first == last) return ;\n    std::sort (first, last) ;\n    do {\n        driver (first, last) ;\n    } while (::next_permutation (first, last)) ;\n    return ;\n}\n\ntemplate <typename String, typename Function> inline auto\npermutations (String text, Function driver) -> void\n{\n    permutations_iter (std::begin (text), std::end (text), driver) ;\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator <char> begin (in), end ;\n    std::string text (begin, end) ;\n    text = remove_whitespaces (text) ;\n    return text ;\n}\n\n#ifdef _OPENMP\nstruct PermutationPipe\n{\n    std::mutex mutex ;\n    std::condition_variable not_empty ;\n    std::condition_variable not_full ;\n    std::deque <std::string> lines ;\n    bool done ;\n\n    PermutationPipe () : done (false) {}\n} ;\n\nstatic const std::size_t pipe_capacity = 2 ;\n\nauto produce_prefix_group\n    ( const std::string& sorted_text\n    , std::size_t prefix_index\n    , PermutationPipe& pipe ) -> void\n{\n    std::string permutation ;\n    permutation.reserve (sorted_text.size ()) ;\n    permutation.push_back (sorted_text [prefix_index]) ;\n    permutation.append (sorted_text.data (), prefix_index) ;\n    const std::size_t suffix_start = prefix_index + 1 ;\n    permutation.append\n        ( sorted_text.data () + suffix_start\n        , sorted_text.size () - suffix_start ) ;\n\n    auto suffix = std::next (permutation.begin ()) ;\n    do {\n        std::string line = format_permutation (permutation.begin (), permutation.end ()) ;\n        {\n            std::unique_lock <std::mutex> lock (pipe.mutex) ;\n            pipe.not_full.wait (lock, [&pipe] {\n                return pipe.lines.size () < pipe_capacity ;\n            }) ;\n            pipe.lines.push_back (std::move (line)) ;\n        }\n        pipe.not_empty.notify_one () ;\n    } while (::next_permutation (suffix, permutation.end ())) ;\n\n    {\n        std::lock_guard <std::mutex> lock (pipe.mutex) ;\n        pipe.done = true ;\n    }\n    pipe.not_empty.notify_one () ;\n}\n\nauto consume_prefix_groups\n    ( const std::vector <std::unique_ptr <PermutationPipe>>& pipes ) -> void\n{\n    for (std::size_t group = 0 ; group < pipes.size () ; ++ group) {\n        PermutationPipe& pipe = *pipes [group] ;\n        while (true) {\n            std::string line ;\n            {\n                std::unique_lock <std::mutex> lock (pipe.mutex) ;\n                pipe.not_empty.wait (lock, [&pipe] {\n                    return !pipe.lines.empty () || pipe.done ;\n                }) ;\n                if (pipe.lines.empty ()) break ;\n                line = std::move (pipe.lines.front ()) ;\n                pipe.lines.pop_front () ;\n            }\n            pipe.not_full.notify_one () ;\n            std::cout.write\n                ( line.data ()\n                , static_cast <std::streamsize> (line.size ()) ) ;\n        }\n    }\n}\n\nauto parallel_prefix_permutations\n    ( const std::string& sorted_text\n    , const std::vector <std::size_t>& prefix_indices ) -> void\n{\n    std::vector <std::unique_ptr <PermutationPipe>> pipes ;\n    for (std::size_t group = 0 ; group < prefix_indices.size () ; ++ group) {\n        pipes.push_back (std::unique_ptr <PermutationPipe> (new PermutationPipe)) ;\n    }\n\n    bool use_parallel = false ;\n#pragma omp parallel num_threads(4) shared(use_parallel, pipes, sorted_text, prefix_indices)\n    {\n#pragma omp single\n        {\n            use_parallel = omp_get_num_threads () > 1 ;\n        }\n\n        if (use_parallel) {\n#pragma omp master\n            {\n                consume_prefix_groups (pipes) ;\n            }\n#pragma omp for schedule(dynamic, 1)\n            for (int group = 0 ; group < static_cast <int> (prefix_indices.size ()) ; ++ group) {\n                produce_prefix_group\n                    ( sorted_text\n                    , prefix_indices [static_cast <std::size_t> (group)]\n                    , *pipes [static_cast <std::size_t> (group)] ) ;\n            }\n        } else {\n#pragma omp master\n            {\n                permutations (sorted_text, PrintPermutation ()) ;\n            }\n        }\n    }\n}\n#endif\n\nint main (int argc, char const *argv [])\n{\n    std::string text = read_text_from_stdin <std::string> (std::cin) ;\n#ifdef _OPENMP\n    std::string sorted_text = text ;\n    std::sort (sorted_text.begin (), sorted_text.end ()) ;\n\n    std::vector <std::size_t> prefix_indices ;\n    for (std::size_t i = 0 ; i < sorted_text.size () ; ++ i) {\n        if (i == 0 || sorted_text [i] != sorted_text [i - 1]) {\n            prefix_indices.push_back (i) ;\n        }\n    }\n\n    if (prefix_indices.size () > 1) {\n        parallel_prefix_permutations (sorted_text, prefix_indices) ;\n        return 0 ;\n    }\n#endif\n    permutations (text, PrintPermutation ()) ;\n    return 0 ;\n}\n",
      "path": "src/permutations.cc"
    }
  ],
  "hypothesis": "Partitioning the sorted permutation set by distinct first-byte prefixes lets OpenMP workers generate disjoint lexicographic ranges while the master emits them in order. A bounded handoff may overlap generation and output on the 4-core target, though output-bound cases may regress.",
  "notes": "Each prefix has a two-line queue, so generated output is not buffered in proportion to the total permutation count. The serial path remains for one prefix or a one-thread OpenMP team. No candidate timing is available; end-to-end evaluation should decide whether the added parallelism pays off.",

{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include <stdio.h>\\n#include <stdlib.h>\\n#include <assert.h>\\n#include <string.h>\\n#include <stdint.h>\\n\\ntypedef struct {\\n    long int *data;\\n    int length;\\n    long int total;\\n} bucket;\\n\\ntypedef struct {\\n    uint64_t prefix;\\n    long int index;\\n} sort_entry;\\n\\nenum { SORT_RUN = 32 };\\n\\nstatic uint64_t prefix_key(const char *s) {\\n    uint64_t key = 0;\\n    for (unsigned int i = 0; i < 8; ++i) {\\n        unsigned char c = (unsigned char)s[i];\\n        if (c == 0)\\n            break;\\n        key |= (uint64_t)c << (56 - 8 * i);\\n    }\\n    return key;\\n}\\n\\nstatic inline int entry_leq(const sort_entry *left,\\n                            const sort_entry *right,\\n                            const char *strings, size_t stride) {\\n    if (left->prefix != right->prefix)\\n        return left->prefix < right->prefix;\\n\\n    /* A zero final byte means the equal prefixes contain a terminator. */\\n    if ((left->prefix & UINT64_C(255)) == 0)\\n        return 1;\\n\\n    return strcmp(strings + (size_t)left->index * stride + 8,\\n                  strings + (size_t)right->index * stride + 8) <= 0;\\n}\\n\\nstatic void merge_entries(const sort_entry *restrict source,\\n                          sort_entry *restrict destination,\\n                          size_t begin, size_t middle, size_t end,\\n                          const char *strings, size_t stride) {\\n    if (middle == end ||\\n        entry_leq(&source[middle - 1], &source[middle], strings, stride)) {\\n        memcpy(destination + begin, source + begin,\\n               (end - begin) * sizeof(*destination));\\n        return;\\n    }\\n\\n    size_t left = begin;\\n    size_t right = middle;\\n    size_t out = begin;\\n    while (left < middle && right < end) {\\n        if (entry_leq(&source[left], &source[right], strings, stride))\\n            destination[out++] = source[left++];\\n        else\\n            destination[out++] = source[right++];\\n    }\\n\\n    if (left < middle)\\n        memcpy(destination + out, source + left,\\n               (middle - left) * sizeof(*destination));\\n    else if (right < end)\\n        memcpy(destination + out, source + right,\\n               (end - right) * sizeof(*destination));\\n}\\n\\nstatic long int *comparison_sort_indices(const char *strings, int length,\\n                                          long int size,\\n                                          const long int *initial) {\\n    if (size <= 0)\\n        return NULL;\\n    if ((uintmax_t)size > SIZE_MAX / sizeof(sort_entry))\\n        exit(EXIT_FAILURE);\\n\\n    size_t n = (size_t)size;\\n    size_t stride = (size_t)length;\\n    sort_entry *records = malloc(n * sizeof(*records));\\n    if (records == NULL)\\n        exit(EXIT_FAILURE);\\n\\n#if defined(__GNUC__)\\n#pragma GCC ivdep\\n#endif\\n    for (size_t i = 0; i < n; ++i) {\\n        long int index = initial != NULL ? initial[i] : (long int)i;\\n        records[i].prefix = prefix_key(strings + (size_t)index * stride);\\n        records[i].index = index;\\n    }\\n\\n    int ordered = 1;\\n    for (size_t i = 1; i < n; ++i) {\\n        if (!entry_leq(&records[i - 1], &records[i], strings, stride)) {\\n            ordered = 0;\\n            break;\\n        }\\n    }\\n\\n    sort_entry *source = records;\\n    sort_entry *destination = NULL;\\n    if (!ordered) {\\n        if (n > SORT_RUN) {\\n            destination = malloc(n * sizeof(*destination));\\n            if (destination == NULL) {\\n                free(records);\\n                exit(EXIT_FAILURE);\\n            }\\n        }\\n\\n        /* Keep the dependent insertion work bounded to short base runs. */\\n        for (size_t begin = 0; begin < n;) {\\n            size_t count = n - begin;\\n            if (count > SORT_RUN)\\n                count = SORT_RUN;\\n            size_t end = begin + count;\\n            for (size_t i = begin + 1; i < end; ++i) {\\n                sort_entry key = source[i];\\n                size_t j = i;\\n                while (j > begin &&\\n                       !entry_leq(&source[j - 1], &key, strings, stride)) {\\n                    source[j] = source[j - 1];\\n                    --j;\\n                }\\n                source[j] = key;\\n            }\\n            begin = end;\\n        }\\n\\n        for (size_t width = SORT_RUN; width < n;) {\\n            for (size_t begin = 0; begin < n;) {\\n                size_t middle = begin +\\n                    (n - begin < width ? n - begin : width);\\n                size_t end = middle +\\n                    (n - middle < width ? n - middle : width);\\n                merge_entries(source, destination, begin, middle, end,\\n                              strings, stride);\\n                begin = end;\\n            }\\n            sort_entry *temporary = source;\\n            source = destination;\\n            destination = temporary;\\n\\n            if (width >= n - width)\\n                break;\\n            width += width;\\n        }\\n    }\\n\\n    free(destination);\\n    long int *result = malloc(n * sizeof(*result));\\n    if (result == NULL) {\\n        free(source);\\n        exit(EXIT_FAILURE);\\n    }\\n#if defined(__GNUC__)\\n#pragma GCC ivdep\\n#endif\\n    for (size_t i = 0; i < n; ++i)\\n        result[i] = source[i].index;\\n    free(source);\\n    return result;\\n}\\n\\nvoid sort(char *a, bucket *b) {\\n    if (b->total < 2)\\n        return;\\n    long int *result = comparison_sort_indices(a, b->length, b->total,\\n                                               b->data);\\n    memcpy(b->data, result, (size_t)b->total * sizeof(*result));\\n    free(result);\\n}\\n\\nlong int *bucket_sort(char *a, int length, long int size,\\n                      int offset, int nbuckets) {\\n    (void)offset;\\n    (void)nbuckets;\\n    return comparison_sort_indices(a, length, size, NULL);\\n}\\n\\nvoid load(char **vString, long int *N, int *l, int *os, int *nb) {\\n    char *strings = NULL;\\n    int len, offset, nbucket;\\n    long int n;\\n\\n    if (!fscanf(stdin, \\\"%d\\\", &len)) {\\n        printf(\\\"ERROR len\\\\n\\\");\\n        exit(1);\\n    }\\n    if (!fscanf(stdin, \\\"%ld\\\", &n)) {\\n        printf(\\\"ERROR n\\\\n\\\");\\n        exit(1);\\n    }\\n    if (!fscanf(stdin, \\\"%d\\\", &offset)) {\\n        printf(\\\"ERROR offset\\\\n\\\");\\n        exit(1);\\n    }\\n    if (!fscanf(stdin, \\\"%d\\\", &nbucket)) {\\n        printf(\\\"ERROR nbucket\\\\n\\\");\\n        exit(1);\\n    }\\n\\n    nbucket = nbucket + 1;\\n    len = len + 1;\\n    strings = (char *)malloc(n * len);\\n\\n    for (long int i = 0; i < n; i++) {\\n        if (!fscanf(stdin, \\\"%s\\\", strings + (i * len))) {\\n            printf(\\\"ERROR %ld\\\\n\\\", i);\\n            exit(1);\\n        }\\n    }\\n\\n    *vString = strings;\\n    *N = n;\\n    *l = len;\\n    *os = offset;\\n    *nb = nbucket;\\n}\\n\\nvoid print(char *strings, long int *index, long int n, int len) {\\n    for (long int i = 0; i < n; i++)\\n        printf(\\\"%ld -> %s\\\\n\\\", i, strings + (index[i] * len));\\n}\\n\\nvoid save(char *strings, long int *index, long int n, int len) {\\n    for (long int i = 0; i < n; i++)\\n        printf(\\\"%s\\\\n\\\", strings + (index[i] * len));\\n}\\n\\nint main(int ac, char **av) {\\n    char *strings = NULL;\\n    long int N = 0;\\n    long int *index = NULL;\\n    int len = 0, save2File = 0, offset, nbuckets;\\n\\n    load(&strings, &N, &len, &offset, &nbuckets);\\n    index = bucket_sort(strings, len, N, offset, nbuckets);\\n    save(strings, index, N, len);\\n\\n    if (strings != NULL)\\n        free(strings);\\n    if (index != NULL)\\n        free(index);\\n    return EXIT_SUCCESS;\\n}\\n\",\n      \"path\": \"src/bucketsort.c\"\n    }\n  ],\n  \"hypothesis\": \"Cached lexicographic prefixes and streaming index-record merges can reduce dependent strcmp work and expose legal SIMD copying on ARM64, without assuming balanced buckets.\",\n  \"notes\": \"Not executed. Comparison-dependent loops remain scalar; only independent metadata construction and index extraction receive dependency annotations. No threading, build, or output-format changes.\",\n  \"research\": {\n    \"queries\": [],\n    \"urls\": []\n  },\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Replace fixed-capacity buckets with global stable mergesort of index records, using bounded 32-entry insertion runs and O(N log N) worst-case comparisons.\",\n    \"Cache unsigned, zero-padded eight-byte lexical prefixes; resolve equal unterminated prefixes with strcmp starting at byte eight.\",\n    \"Use disjoint restrict-qualified merge buffers and memcpy for ordered ranges and merge tails; annotate only independent loops for vectorization.\",\n    \"Retain token input and newline output, use long loop counters, and keep all sorting state local to each call.\"\n  ]\n}"}}

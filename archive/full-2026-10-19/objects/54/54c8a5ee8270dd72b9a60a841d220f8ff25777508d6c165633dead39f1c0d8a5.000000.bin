{
  "src/bucketsort.c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nstatic int compare_strings(const void *left, const void *right) {\n    const char *lhs = *(char * const *)left;\n    const char *rhs = *(char * const *)right;\n    return strcmp(lhs, rhs);\n}\n\nchar **bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\n    char **sorted;\n    long int *offsets;\n    long int *next;\n    long int i;\n\n    if (size <= 0 || nbuckets <= 0) {\n        return NULL;\n    }\n\n    sorted = (char **)malloc(sizeof(*sorted) * (size_t)size);\n    offsets = (long int *)calloc((size_t)nbuckets + 1, sizeof(*offsets));\n    next = (long int *)malloc(sizeof(*next) * (size_t)nbuckets);\n    if (sorted == NULL || offsets == NULL || next == NULL) {\n        free(sorted);\n        free(offsets);\n        free(next);\n        return NULL;\n    }\n\n    /* Count each bucket, then compute exact, non-overlapping bucket ranges. */\n    for (i = 0; i < size; i++) {\n        int b = (int)((unsigned char)a[(size_t)i * (size_t)length]) - offset;\n        offsets[b + 1]++;\n    }\n    for (int b = 0; b < nbuckets; b++) {\n        offsets[b + 1] += offsets[b];\n    }\n    memcpy(next, offsets, sizeof(*next) * (size_t)nbuckets);\n\n    /* Scatter string pointers into their bucket ranges. */\n    for (i = 0; i < size; i++) {\n        int b = (int)((unsigned char)a[(size_t)i * (size_t)length]) - offset;\n        next[b]++;\n        sorted[next[b] - 1] = a + (size_t)i * (size_t)length;\n    }\n\n#if defined(_OPENMP)\n    #pragma omp parallel for schedule(dynamic, 1) if (size >= 4096 && nbuckets > 1)\n#endif\n    for (int b = 0; b < nbuckets; b++) {\n        long int count = offsets[b + 1] - offsets[b];\n        if (count > 1) {\n            qsort(sorted + offsets[b], (size_t)count, sizeof(*sorted), compare_strings);\n        }\n    }\n\n    free(offsets);\n    free(next);\n    return sorted;\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb) {\n    char *strings = NULL;\n    int len, offset, nbucket;\n    long int n;\n\n    if (!fscanf(stdin, \"%d\", &len)) {\n        printf(\"ERROR len\\n\");\n        exit(1);\n    }\n    if (!fscanf(stdin, \"%ld\", &n)) {\n        printf(\"ERROR n\\n\");\n        exit(1);\n    }\n    if (!fscanf(stdin, \"%d\", &offset)) {\n        printf(\"ERROR offset\\n\");\n        exit(1);\n    }\n    if (!fscanf(stdin, \"%d\", &nbucket)) {\n        printf(\"ERROR nbucket\\n\");\n        exit(1);\n    }\n\n    nbucket = nbucket + 1;\n    len = len + 1;\n    strings = (char *)malloc((size_t)n * (size_t)len);\n\n    for (long int i = 0; i < n; i++) {\n        if (!fscanf(stdin, \"%s\", strings + (size_t)i * (size_t)len)) {\n            printf(\"ERROR %ld\\n\", i);\n            exit(1);\n        }\n    }\n\n    *vString = strings;\n    *N = n;\n    *l = len;\n    *os = offset;\n    *nb = nbucket;\n}\n\nvoid save(char **strings, long int n) {\n    for (long int i = 0; i < n; i++) {\n        printf(\"%s\\n\", strings[i]);\n    }\n}\n\nint main(int ac, char **av) {\n    char *strings = NULL;\n    long int N = 0;\n    char **index = NULL;\n    int len = 0, offset, nbuckets;\n\n    load(&strings, &N, &len, &offset, &nbuckets);\n    index = bucket_sort(strings, len, N, offset, nbuckets);\n\n    if (N > 0 && index == NULL) {\n        free(strings);\n        return EXIT_FAILURE;\n    }\n\n    save(index, N);\n\n    free(strings);\n    free(index);\n    return EXIT_SUCCESS;\n}\n"
}

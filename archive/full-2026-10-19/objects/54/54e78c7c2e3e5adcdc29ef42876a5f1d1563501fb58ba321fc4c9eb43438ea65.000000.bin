      "content": "#include \"knn.h\"\n\ntypedef struct {\n    float distance;\n    int group;\n} Neighbor;\n\nstatic char vote_labels(char * labels, int k) {\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nstatic char knn_serial(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n\n                    distances[x] = d;\n                    labels[x] = g.label;\n\n                    break;\n                }\n            }\n        }\n    }\n\n    char result = vote_labels(labels, k);\n    free(distances);\n    free(labels);\n    return result;\n}\n\nstatic int neighbor_worse(Neighbor a, Neighbor b) {\n    return a.distance > b.distance ||\n           (a.distance == b.distance && a.group > b.group);\n}\n\nstatic void replace_worst(Neighbor * heap, int count, Neighbor value) {\n    int hole = 0;\n\n    while (hole < count / 2) {\n        int child = 2 * hole + 1;\n        if (child + 1 < count && neighbor_worse(heap[child + 1], heap[child])) {\n            child++;\n        }\n        if (!neighbor_worse(heap[child], value)) {\n            break;\n        }\n        heap[hole] = heap[child];\n        hole = child;\n    }\n\n    heap[hole] = value;\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    if (k < 1) {\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    if (k == 1) {\n        float best_distance = -1;\n        char best_label = -1;\n\n        for (int i = 0; i < n_groups; i++) {\n            Group g = groups[i];\n            for (int j = 0; j < g.length; j++) {\n                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n                if (d < best_distance || best_distance == -1) {\n                    best_distance = d;\n                    best_label = g.label;\n                }\n            }\n        }\n\n        return best_label;\n    }\n\n    int capacity = 0;\n    for (int i = 0; i < n_groups && capacity < k; i++) {\n        int length = groups[i].length;\n        if (length > 0) {\n            if (length >= k - capacity) {\n                capacity = k;\n            } else {\n                capacity += length;\n            }\n        }\n    }\n\n    if ((size_t) capacity > ((size_t) -1) / sizeof(Neighbor)) {\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t bytes = sizeof(Neighbor) * (size_t) capacity;\n    if (bytes < (size_t) k) {\n        bytes = (size_t) k;\n    }\n\n    Neighbor * heap = (Neighbor *) malloc(bytes);\n    if (heap == NULL) {\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    int used = 0;\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (int j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            /* Unordered distances require the original insertion semantics. */\n            if (d != d) {\n                free(heap);\n                return knn_serial(n_groups, groups, k, to_evaluate);\n            }\n\n            Neighbor value;\n            value.distance = d;\n            value.group = i;\n\n            if (used < capacity) {\n                int hole = used++;\n                while (hole > 0) {\n                    int parent = (hole - 1) / 2;\n                    if (!neighbor_worse(value, heap[parent])) {\n                        break;\n                    }\n                    heap[hole] = heap[parent];\n                    hole = parent;\n                }\n                heap[hole] = value;\n            } else if (d < heap[0].distance) {\n                /* Equal-distance newcomers are always later in traversal. */\n                replace_worst(heap, used, value);\n            }\n        }\n    }\n\n    /* Within-group distance ties have identical labels. Group order therefore\n       supplies all tie information needed for the observable result. */\n    char * labels = (char *) heap;\n    int i;\n    for (i = 0; i < used; i++) {\n        /* Forward compaction cannot overwrite an unread heap record. */\n        labels[i] = groups[heap[i].group].label;\n    }\n    for (; i < k; i++) {\n        labels[i] = -1;\n    }\n\n    char result = vote_labels(labels, k);\n    free(heap);\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }

#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <vector>

namespace {

constexpr int MOD = 1000000007;

class FastInput {
    static constexpr std::size_t BUFFER_SIZE = 1 << 16;
    char buffer_[BUFFER_SIZE];
    std::size_t position_ = 0;
    std::size_t size_ = 0;

    int readChar() {
        if (position_ == size_) {
            size_ = std::fread(buffer_, 1, BUFFER_SIZE, stdin);
            position_ = 0;
            if (size_ == 0) {
                return EOF;
            }
        }
        return buffer_[position_++];
    }

public:
    int nextInt() {
        int c;
        do {
            c = readChar();
        } while (c <= ' ' && c != EOF);

        bool negative = false;
        if (c == '-') {
            negative = true;
            c = readChar();
        }

        int value = 0;
        while (c > ' ') {
            value = value * 10 + (c - '0');
            c = readChar();
        }
        return negative ? -value : value;
    }
};

long long modPow(long long base, int exponent) {
    long long result = 1;
    while (exponent != 0) {
        if (exponent & 1) {
            result = result * base % MOD;
        }
        base = base * base % MOD;
        exponent >>= 1;
    }
    return result;
}

class Binomial {
    std::vector<int> factorial_;
    std::vector<int> inverseFactorial_;

public:
    explicit Binomial(int maximum) : factorial_(maximum + 1), inverseFactorial_(maximum + 1) {
        factorial_[0] = 1;
        for (int i = 1; i <= maximum; ++i) {
            factorial_[i] = static_cast<long long>(factorial_[i - 1]) * i % MOD;
        }
        inverseFactorial_[maximum] = static_cast<int>(modPow(factorial_[maximum], MOD - 2));
        for (int i = maximum; i > 0; --i) {
            inverseFactorial_[i - 1] = static_cast<long long>(inverseFactorial_[i]) * i % MOD;
        }
    }

    int choose(int total, int selected) const {
        return static_cast<long long>(factorial_[total]) * inverseFactorial_[selected] % MOD *
               inverseFactorial_[total - selected] % MOD;
    }
};

int solveDense(int n, const std::vector<std::pair<int, int>>& blocked) {
    std::vector<int> paths(n, 0);
    paths[0] = 1;
    std::size_t obstacle = 0;

    for (int y = 0; y < n; ++y) {
        for (int x = 0; x < n; ++x) {
            if (obstacle < blocked.size() && blocked[obstacle].first == y &&
                blocked[obstacle].second == x) {
                paths[x] = 0;
                ++obstacle;
            } else if (x != 0) {
                int value = paths[x] + paths[x - 1];
                if (value >= MOD) {
                    value -= MOD;
                }
                paths[x] = value;
            }
        }
    }
    return paths[n - 1];
}

int solveSparse(int n, std::vector<std::pair<int, int>> blocked) {
    blocked.emplace_back(n - 1, n - 1);
    std::sort(blocked.begin(), blocked.end());

    Binomial binomial(2 * n - 2);
    std::vector<int> ways(blocked.size());

    for (std::size_t i = 0; i < blocked.size(); ++i) {
        const int y = blocked[i].first;
        const int x = blocked[i].second;
        long long value = binomial.choose(y + x, y);

        for (std::size_t j = 0; j < i; ++j) {
            const int previousY = blocked[j].first;
            const int previousX = blocked[j].second;
            if (previousY <= y && previousX <= x) {
                const int deltaY = y - previousY;
                const int deltaX = x - previousX;
                value -= static_cast<long long>(ways[j]) *
                         binomial.choose(deltaY + deltaX, deltaY) % MOD;
                if (value < 0) {
                    value += MOD;
                }
            }
        }
        ways[i] = static_cast<int>(value);
    }

    return ways.back();
}

}  // namespace

int main() {
    FastInput input;
    const int n = input.nextInt();
    const int m = input.nextInt();

    std::vector<std::pair<int, int>> blocked;
    blocked.reserve(m);
    for (int i = 0; i < m; ++i) {
        const int y = input.nextInt();
        const int x = input.nextInt();
        blocked.emplace_back(y, x);
    }

    std::sort(blocked.begin(), blocked.end());
    blocked.erase(std::unique(blocked.begin(), blocked.end()), blocked.end());

    const std::pair<int, int> start{0, 0};
    const std::pair<int, int> target{n - 1, n - 1};
    if (std::binary_search(blocked.begin(), blocked.end(), start) ||
        std::binary_search(blocked.begin(), blocked.end(), target)) {
        std::printf("0\n");
        return 0;
    }

    const std::uint64_t pointCount = static_cast<std::uint64_t>(blocked.size()) + 1;
    const std::uint64_t side = static_cast<std::uint64_t>(n);
    const int answer = pointCount * pointCount >= side * side
                           ? solveDense(n, blocked)
                           : solveSparse(n, std::move(blocked));
    std::printf("%d\n", answer);
    return 0;
}

      "content": "#include <algorithm>\n#include <cstddef>\n#include <cstdio>\n#include <iostream>\n#include <iterator>\n#include <string>\n\nclass PrintPermutation\n{\npublic:\n    explicit PrintPermutation (std::size_t element_count)\n    {\n        output_.reserve (BlockSize) ;\n        if (element_count <= ((BlockSize - 4U) / 2U)) {\n            line_.assign (element_count * 2U + 4U, ' ') ;\n            line_[0] = '[' ;\n            line_[1] = ' ' ;\n            line_[element_count * 2U + 2U] = ']' ;\n            line_[element_count * 2U + 3U] = '\\n' ;\n        }\n    }\n\n    template <typename Iter> auto\n    operator () (Iter first, Iter last) -> void\n    {\n        if (!line_.empty ()) {\n            char *slot = &line_[2] ;\n            while (first != last) {\n                *slot = *first ;\n                slot += 2 ;\n                ++ first ;\n            }\n            if (output_.size () + line_.size () > BlockSize) flush () ;\n            output_.append (line_) ;\n            return ;\n        }\n\n        append ('[') ;\n        append (' ') ;\n        while (first != last) {\n            append (*first) ;\n            append (' ') ;\n            ++ first ;\n        }\n        append (']') ;\n        append ('\\n') ;\n    }\n\n    auto flush () -> void\n    {\n        if (!output_.empty ()) {\n            std::fwrite (output_.data (), 1, output_.size (), stdout) ;\n            output_.clear () ;\n        }\n    }\n\nprivate:\n    enum { BlockSize = 256 * 1024 } ;\n\n    auto append (char value) -> void\n    {\n        if (output_.size () == BlockSize) flush () ;\n        output_.push_back (value) ;\n    }\n\n    std::string line_ ;\n    std::string output_ ;\n} ;\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ' )\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v') ;\n    }\n} ;\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase\n        ( std::remove_if\n            ( text.begin ()\n            , text.end ()\n            , IsWhitespace () )\n        , text.end () ) ;\n    return text ;\n}\n\ntemplate <typename Iter> auto\nfind_longest_non_increasing_suffix (Iter first, Iter last) -> Iter\n{\n    if (first == last) return last ;\n    Iter back = std::prev (last) ;\n    if (back == first) return last ;\n    do {\n        -- last ;\n        -- back ;\n    } while ((first != last) && (*back >= *last)) ;\n    return last ;\n}\n\ntemplate <typename Iter> auto\nfind_rightmost_successor (Iter first, Iter second, Iter last) -> Iter\n{\n    if (second == last) return last ;\n    do {\n        -- last ;\n    } while ((second != last) && (*last <= *first)) ;\n    return last ;\n}\n\ntemplate <typename Iter> auto\nnext_permutation (Iter first, Iter last) -> bool\n{\n    if (first == last) return false ;\n    Iter suffix = find_longest_non_increasing_suffix (first, last) ;\n    if (suffix == first) return false ;\n    if (suffix == last)  return false ;\n    Iter pivot = std::prev (suffix) ;\n    Iter successor = find_rightmost_successor (pivot, suffix, last) ;\n    std::iter_swap (pivot, successor) ;\n    std::reverse (suffix, last) ;\n    return true ;\n}\n\ntemplate <typename Iter, typename Function> inline auto\npermutations_iter (Iter first, Iter last, Function& driver) -> void\n{\n    if (first == last) return ;\n    std::sort (first, last) ;\n    do {\n        driver (first, last) ;\n    } while (::next_permutation (first, last)) ;\n}\n\ntemplate <typename String, typename Function> inline auto\npermutations (String text, Function& driver) -> void\n{\n    permutations_iter (std::begin (text), std::end (text), driver) ;\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator <char> begin (in), end ;\n    std::string text (begin, end) ;\n    text = remove_whitespaces (text) ;\n    return text ;\n}\n\nint main (int argc, char const *argv [])\n{\n    std::ios_base::sync_with_stdio (false) ;\n    std::cin.tie (0) ;\n    std::string text = read_text_from_stdin <std::string> (std::cin) ;\n    PrintPermutation printer (text.size ()) ;\n    permutations (text, printer) ;\n    printer.flush () ;\n    return 0 ;\n}\n",
      "path": "src/permutations.cc"
    }
  ],
  "hypothesis": "A reusable fixed-layout line plus bounded contiguous output blocks improves cache locality and avoids repeated formatted insertions while preserving ordered output.",

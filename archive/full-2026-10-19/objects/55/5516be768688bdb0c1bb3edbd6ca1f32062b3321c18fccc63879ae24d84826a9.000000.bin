        "epoch": 1,
        "hypothesis": "Sorted, contiguous obstacle coordinates avoid the baseline's O(N²) blocked-cell storage. For sparse inputs, combinatorial counting reduces work to O(M²); for denser inputs, a contiguous one-row DP fallback retains O(N²) time without the grid allocation. This tests a locality- and data-layout-oriented approach while keeping work bounded by the better of the two methods asymptotically.",
        "id": "e9f46ecbaf9948a8",
        "ordinal": 1,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/solution.cpp"
          ],
          "retained": [
            "Replace the nested vector<bool> blocked grid with sorted, deduplicated contiguous obstacle coordinates.",
            "Use factorial and inverse-factorial tables with an obstacle-pair recurrence for sparse cases.",
            "Use a single contiguous DP row and sorted obstacle scan as the dense-case fallback."
          ]
        },

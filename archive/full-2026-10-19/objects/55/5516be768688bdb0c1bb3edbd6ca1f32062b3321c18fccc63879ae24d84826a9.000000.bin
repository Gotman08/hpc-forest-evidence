    {
      "id": "7d85f02a12cd465b",
      "role": "A",
      "mission": {
        "base_commit": "06b6740d18e3abaaa07e65afc334d740550c6f00",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Diagonal ordering of sparse blocked cells makes predecessor scans contiguous and the total-distance factorial index increase monotonically, while avoiding an N×N blocked grid. For denser obstacle sets, a one-row DP over obstacle-free runs avoids both the blocked grid and per-cell obstacle checks.",
        "id": "7d85f02a12cd465b",
        "ordinal": 2,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/solution.cpp"
          ],
          "retained": [
            "Store blocked coordinates in a flat vector, sort and deduplicate them, and return immediately when the start or destination is blocked.",
            "For fewer than N unique obstacles, use factorial-based path counts and inclusion-exclusion over diagonal-sorted obstacles instead of allocating the N×N blocked grid.",
            "For at least N obstacles, sort by row and scan free runs with an in-place one-row DP, resetting at blocked cells and using a single conditional modular reduction."
          ]
        },
        "tree_id": "e1:A",
        "trial_id": "01M546Y12EDZGZ25FTRM89TYA5",

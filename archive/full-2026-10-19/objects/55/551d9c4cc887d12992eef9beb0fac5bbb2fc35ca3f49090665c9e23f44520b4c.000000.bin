{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <cstdio>\\n#include <vector>\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\nnamespace {\\n\\nconstexpr int MOD = 1000000007;\\n\\nclass FastInput {\\n    static constexpr std::size_t BUFFER_SIZE = 1 << 16;\\n    char buffer_[BUFFER_SIZE];\\n    std::size_t position_ = 0;\\n    std::size_t length_ = 0;\\n\\n    char nextChar() {\\n        if (position_ == length_) {\\n            length_ = std::fread(buffer_, 1, BUFFER_SIZE, stdin);\\n            position_ = 0;\\n            if (length_ == 0) return '\\\\0';\\n        }\\n        return buffer_[position_++];\\n    }\\n\\npublic:\\n    int readInt() {\\n        char c = nextChar();\\n        while (c <= ' ' && c != '\\\\0') c = nextChar();\\n        int value = 0;\\n        while (c >= '0' && c <= '9') {\\n            value = value * 10 + (c - '0');\\n            c = nextChar();\\n        }\\n        return value;\\n    }\\n};\\n\\ninline int addMod(int a, int b) {\\n    const int sum = a + b;\\n    return sum >= MOD ? sum - MOD : sum;\\n}\\n\\n} // namespace\\n\\nint main() {\\n    FastInput input;\\n    const int n = input.readInt();\\n    const int m = input.readInt();\\n    if (n <= 0) return 0;\\n\\n    std::vector<std::vector<bool>> blockedCells(n, std::vector<bool>(n, false));\\n    for (int c = 0; c < m; ++c) {\\n        const int y = input.readInt();\\n        const int x = input.readInt();\\n        blockedCells[y][x] = true;\\n    }\\n\\n    std::vector<int> dp(n, 0);\\n    if (!blockedCells[0][0]) dp[0] = 1;\\n    for (int j = 1; j < n; ++j) {\\n        dp[j] = blockedCells[0][j] ? 0 : dp[j - 1];\\n    }\\n\\n#ifdef _OPENMP\\n    if (n >= 4096) {\\n        const int maxThreads = omp_get_max_threads();\\n        std::vector<int> localEnd(maxThreads);\\n        std::vector<int> incoming(maxThreads);\\n        std::vector<int> firstBlocked(maxThreads);\\n        std::vector<unsigned char> hasBlocked(maxThreads);\\n        int activeThreads = 1;\\n\\n#pragma omp parallel shared(activeThreads, localEnd, incoming, firstBlocked, hasBlocked, dp, blockedCells)\\n        {\\n            const int tid = omp_get_thread_num();\\n            const int threadCount = omp_get_num_threads();\\n\\n#pragma omp single\\n            activeThreads = threadCount;\\n\\n            for (int i = 1; i < n; ++i) {\\n                const int lo = static_cast<int>((static_cast<long long>(n) * tid) / threadCount);\\n                const int hi = static_cast<int>((static_cast<long long>(n) * (tid + 1)) / threadCount);\\n                int value = 0;\\n                int first = hi;\\n                bool seenBlocked = false;\\n\\n                for (int j = lo; j < hi; ++j) {\\n                    if (blockedCells[i][j]) {\\n                        dp[j] = 0;\\n                        if (!seenBlocked) first = j;\\n                        seenBlocked = true;\\n                        value = 0;\\n                    } else {\\n                        value = addMod(value, dp[j]);\\n                        dp[j] = value;\\n                    }\\n                }\\n\\n                localEnd[tid] = value;\\n                firstBlocked[tid] = first;\\n                hasBlocked[tid] = static_cast<unsigned char>(seenBlocked);\\n\\n#pragma omp barrier\\n#pragma omp single\\n                {\\n                    int prefix = 0;\\n                    for (int t = 0; t < activeThreads; ++t) {\\n                        incoming[t] = prefix;\\n                        prefix = hasBlocked[t] ? localEnd[t] : addMod(prefix, localEnd[t]);\\n                    }\\n                }\\n\\n                const int offset = incoming[tid];\\n                for (int j = lo; j < firstBlocked[tid]; ++j) {\\n                    dp[j] = addMod(dp[j], offset);\\n                }\\n\\n#pragma omp barrier\\n            }\\n        }\\n    } else\\n#endif\\n    {\\n        for (int i = 1; i < n; ++i) {\\n            for (int j = 0; j < n; ++j) {\\n                if (blockedCells[i][j]) {\\n                    dp[j] = 0;\\n                } else if (j != 0) {\\n                    dp[j] = addMod(dp[j], dp[j - 1]);\\n                }\\n            }\\n        }\\n    }\\n\\n    std::printf(\\\"%d\\\\n\\\", dp[n - 1]);\\n    return 0;\\n}\\n\",\"path\":\"src/solution.cpp\"}],\"hypothesis\":\"Combining the fastest validated segmented-prefix OpenMP rolling DP with buffered input removes formatted-input overhead while retaining its parallel row scan and correct modular recurrence.\",\"notes\":\"One bounded whole-program hybrid: buffered parsing is integrated with the validated OpenMP algorithm; no interfaces or non-source files are changed.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[\"583a951e221b489e\",\"f0450847459b4897\"],\"transformations\":[\"Retain the thresholded contiguous segmented-prefix OpenMP scan over a single in-place DP row.\",\"Replace formatted input with buffered integer parsing and use stdio output.\"]}"}}

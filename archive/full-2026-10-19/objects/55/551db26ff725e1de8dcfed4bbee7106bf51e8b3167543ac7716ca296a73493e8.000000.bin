          "files": [
            "src/npbonacci.cpp"
          ],
          "retained": [
            "Transpose each right-hand matrix operand in 32-by-32 tiles so each dot product reads contiguous data.",
            "Accumulate at most eight products between modular reductions.",
            "Use static OpenMP row scheduling only for n >= 64; process smaller matrices serially."
          ]
        },

        "depth": 1,
        "epoch": 1,
        "hypothesis": "A tiled right-operand transpose improves dot-product locality, while static row work sharing for n >= 64 and reducing modulo after bounded groups of eight products should speed larger dense multiplications without paying OpenMP startup cost on small matrices.",
        "id": "590eed3136054404",
        "ordinal": 2,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],

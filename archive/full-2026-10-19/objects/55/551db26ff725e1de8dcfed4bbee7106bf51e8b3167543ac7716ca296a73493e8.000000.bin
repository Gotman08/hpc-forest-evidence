          "590eed3136054404"
        ],
        "transformations": {
          "files": [
            "src/npbonacci.cpp"
          ],
          "retained": [
            "For distances 1 through 64, compute terms directly using a duplicated circular buffer, reversed recurrence weights, and dot-product blocks of 16 before modular reduction.",
            "For matrix multiplication, transpose the right-hand operand in 32-by-32 tiles, reduce dot-product accumulators at most every eight products, and use static OpenMP row scheduling only when n >= 64."
          ]
        },
        "tree_id": "e1:G",

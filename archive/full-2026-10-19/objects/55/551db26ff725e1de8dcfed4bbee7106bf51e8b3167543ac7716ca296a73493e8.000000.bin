    {
      "id": "0b67f02e25fd413e",
      "role": "G",
      "mission": {
        "base_commit": "aa99d7719be66917fc8bba5bff27b68fdbf21671",
        "delegation_parent": "R/G",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Combining the best measured short-distance recurrence path with a transposed, periodically reduced matrix kernel may improve both near and distant terms while retaining the matrix-power fallback for all distances above 64.",
        "id": "0b67f02e25fd413e",
        "ordinal": 1,
        "parent_id": null,
        "role": "G",
        "source_commits": [
          "345e819b75e4d3f489c310300d1a5562ad04b880",

      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\ntypedef struct { float x, y, z; } Position;\n\nstatic void body_force_one(Body *p, float dt, int n, int i) {\n  float fx = 0.0f;\n  float fy = 0.0f;\n  float fz = 0.0f;\n\n  for (int j = 0; j < n; j++) {\n    float dx = p[j].x - p[i].x;\n    float dy = p[j].y - p[i].y;\n    float dz = p[j].z - p[i].z;\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n    fx += dx * inv_dist3;\n    fy += dy * inv_dist3;\n    fz += dz * inv_dist3;\n  }\n\n  p[i].vx += dt*fx;\n  p[i].vy += dt*fy;\n  p[i].vz += dt*fz;\n}\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system. Two targets share each compact source-position load.\n */\nvoid body_force(Body *p, float dt, int n) {\n  if (n <= 0) {\n    return;\n  }\n\n  size_t count = (size_t)n;\n  Position *positions = NULL;\n  if (count <= (size_t)-1 / sizeof(Position)) {\n    positions = (Position *)malloc(count * sizeof(Position));\n  }\n  if (positions == NULL) {\n#ifdef _OPENMP\n#pragma omp parallel for schedule(static)\n#endif\n    for (int i = 0; i < n; ++i) {\n      body_force_one(p, dt, n, i);\n    }\n    return;\n  }\n\n  for (int i = 0; i < n; ++i) {\n    positions[i].x = p[i].x;\n    positions[i].y = p[i].y;\n    positions[i].z = p[i].z;\n  }\n\n  int pair_count = n / 2;\n#ifdef _OPENMP\n#pragma omp parallel for schedule(static)\n#endif\n  for (int pair = 0; pair < pair_count; ++pair) {\n    int i = 2 * pair;\n    const float x0 = positions[i].x;\n    const float y0 = positions[i].y;\n    const float z0 = positions[i].z;\n    const float x1 = positions[i + 1].x;\n    const float y1 = positions[i + 1].y;\n    const float z1 = positions[i + 1].z;\n    float fx0 = 0.0f;\n    float fy0 = 0.0f;\n    float fz0 = 0.0f;\n    float fx1 = 0.0f;\n    float fy1 = 0.0f;\n    float fz1 = 0.0f;\n\n    for (int j = 0; j < n; ++j) {\n      const float xj = positions[j].x;\n      const float yj = positions[j].y;\n      const float zj = positions[j].z;\n      float dx0 = xj - x0;\n      float dy0 = yj - y0;\n      float dz0 = zj - z0;\n      float dx1 = xj - x1;\n      float dy1 = yj - y1;\n      float dz1 = zj - z1;\n      float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\n      float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\n      float inv_dist0 = 1 / sqrt(sqrd_dist0);\n      float inv_dist1 = 1 / sqrt(sqrd_dist1);\n      float inv_dist3_0 = inv_dist0 * inv_dist0 * inv_dist0;\n      float inv_dist3_1 = inv_dist1 * inv_dist1 * inv_dist1;\n\n      fx0 += dx0 * inv_dist3_0;\n      fy0 += dy0 * inv_dist3_0;\n      fz0 += dz0 * inv_dist3_0;\n      fx1 += dx1 * inv_dist3_1;\n      fy1 += dy1 * inv_dist3_1;\n      fz1 += dz1 * inv_dist3_1;\n    }\n\n    p[i].vx += dt*fx0;\n    p[i].vy += dt*fy0;\n    p[i].vz += dt*fz0;\n    p[i + 1].vx += dt*fx1;\n    p[i + 1].vy += dt*fy1;\n    p[i + 1].vz += dt*fz1;\n  }\n\n  if (n % 2 != 0) {\n    body_force_one(p, dt, n, n - 1);\n  }\n  free(positions);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Compact position snapshots and two-target register tiles should reduce source traffic without the register pressure of wider tiles, while static OpenMP work sharing exploits independent targets.",

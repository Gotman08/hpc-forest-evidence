      "content": "{\"role\": \"G\", \"goal\": \"integration of diverse archived transformations; evaluate the full program\", \"experiment\": \"cf5694c4cfae4639-h01\", \"ordinal\": 2, \"integration_source_ids\": [\"4013b954ae864272\", \"f85d6cd3609f4fe9\", \"b60a0e38fe67496d\", \"a486b82f661047f0\", \"2f1c440f8e1d4092\", \"4f50d6458ecf4ccb\", \"8ff8da1ce59e433a\"], \"current_source_paths\": [\"src/nbody.c\"], \"context_as_data\": {\"sources\": [{\"id\": \"4013b954ae864272\", \"role\": \"G\", \"commit\": \"56caff7585783d81f1dcacf3099af8ac0cb97ad9\", \"transformations\": {\"files\": [\"src/nbody.c\"], \"retained\": [\"Retain the persistent OpenMP team, static worksharing, standalone body_force wrapper, and force/position phase barriers.\", \"Integrate four-target NEON lanes with ascending source order and double-precision sqrt/division before float conversion.\", \"Statically distribute vector blocks and scalar tails with unique ownership; the tail workshare barrier completes the entire force phase.\", \"Retain the scalar fallback for non-NEON or fast-math builds.\"]}, \"mean_seconds\": 0.08971823565661907, \"diff\": \"diff --git a/src/nbody.c b/src/nbody.c\\nindex 765bd6a..c93e6ba 100644\\n--- a/src/nbody.c\\n+++ b/src/nbody.c\\n@@ -3,6 +3,10 @@\\n #include <string.h>\\n #include <math.h>\\n \\n+#if defined(__aarch64__) && defined(__ARM_NEON) && !defined(__FAST_MATH__)\\n+#include <arm_neon.h>\\n+#endif\\n+\\n #define N_ITER 10 // number of simulation iterations\\n #define DT 0.01f // time step\\n #define SOFTENING 1e-9f // to avoid zero divisors\\n@@ -14,13 +18,67 @@\\n typedef struct { float x, y, z, vx, vy, vz; } Body;\\n \\n /*\\n- * Compute the gravitational impact among all pairs of bodies in \\n- * the system.\\n+ * Called collectively by a team. The scalar workshare's barrier also\\n+ * completes the vector blocks before any position can change.\\n  */\\n-void body_force(Body *p, float dt, int n) {\\n-  for (int i = 0; i < n; ++i) {\\n-    float fx = 0.0f; \\n-    float fy = 0.0f; \\n+static void body_force_workshare(Body *p, float dt, int n) {\\n+#if defined(__aarch64__) && defined(__ARM_NEON) && !defined(__FAST_MATH__)\\n+  const int vector_end = n - n % 4;\\n+  const float32x4_t softening = vdupq_n_f32(SOFTENING);\\n+  const float64x2_t one = vdupq_n_f64(1.0);\\n+\\n+  /* Each lane owns one target and visits sources in ascending order. */\\n+  #pragma omp for schedule(static) nowait\\n+  for (int i = 0; i < vector_end; i += 4) {\\n+    const float32x4_t x = {p[i].x, p[i + 1].x, p[i + 2].x, p[i + 3].x};\\n+    const float32x4_t y = {p[i].y, p[i + 1].y, p[i + 2].y, p[i + 3].y};\\n+    const float32x4_t z = {p[i].z, p[i + 1].z, p[i + 2].z, p[i + 3].z};\\n+    float32x4_t fx = vdupq_n_f32(0.0f);\\n+    float32x4_t fy = vdupq_n_f32(0.0f);\\n+    float32x4_t fz = vdupq_n_f32(0.0f);\\n+\\n+    for (int j = 0; j < n; ++j) {\\n+      float32x4_t dx = vdupq_n_f32(p[j].x) - x;\\n+      float32x4_t dy = vdupq_n_f32(p[j].y) - y;\\n+      float32x4_t dz = vdupq_n_f32(p[j].z) - z;\\n+      float32x4_t sqrd_dist = dx*dx + dy*dy + dz*dz + softening;\\n+\\n+      /* Preserve double sqrt/division before conversion back to float. */\\n+      float64x2_t distance_lo = vcvt_f64_f32(vget_low_f32(sqrd_dist));\\n+      float64x2_t distance_hi = vcvt_f64_f32(vget_high_f32(sqrd_dist));\\n+      float64x2_t inverse_lo = vdivq_f64(one, vsqrtq_f64(distance_lo));\\n+      float64x2_t inverse_hi = vdivq_f64(one, vsqrtq_f64(distance_hi));\\n+      float32x4_t inv_dist = vcombine_f32(vcvt_f32_f64(inverse_lo),\\n+                                         vcvt_f32_f64(inverse_hi));\\n+      float32x4_t inv_dist3 = inv_dist * inv_dist * inv_dist;\\n+\\n+      fx += dx * inv_dist3;\\n+      fy += dy * inv_dist3;\\n+      fz += dz * inv_dist3;\\n+    }\\n+\\n+    p[i].vx += dt * vgetq_lane_f32(fx, 0);\\n+    p[i].vy += dt * vgetq_lane_f32(fy, 0);\\n+    p[i].vz += dt * vgetq_lane_f32(fz, 0);\\n+    p[i + 1].vx += dt * vgetq_lane_f32(fx, 1);\\n+    p[i + 1].vy += dt * vgetq_lane_f32(fy, 1);\\n+    p[i + 1].vz += dt * vgetq_lane_f32(fz, 1);\\n+    p[i + 2].vx += dt * vgetq_lane_f32(fx, 2);\\n+    p[i + 2].vy += dt * vgetq_lane_f32(fy, 2);\\n+    p[i + 2].vz += dt * vgetq_lane_f32(fz, 2);\\n+    p[i + 3].vx += dt * vgetq_lane_f32(fx, 3);\\n+    p[i + 3].vy += dt * vgetq_lane_f32(fy, 3);\\n+    p[i + 3].vz += dt * vgetq_lane_f32(fz, 3);\\n+  }\\n+#else\\n+  const int vector_end = 0;\\n+#endif\\n+\\n+  /* Unique tail ownership, or the complete scalar fallback. */\\n+  #pragma omp for schedule(static)\\n+  for (int i = vector_end; i < n; ++i) {\\n+    float fx = 0.0f;\\n+    float fy = 0.0f;\\n     float fz = 0.0f;\\n \\n     for (int j = 0; j < n; j++) {\\n@@ -31,17 +89,28 @@ void body_force(Body *p, float dt, int n) {\\n       float inv_dist = 1 / sqrt(sqrd_dist);\\n       float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n \\n-      fx += dx * inv_dist3; \\n-      fy += dy * inv_dist3; \\n+      fx += dx * inv_dist3;\\n+      fy += dy * inv_dist3;\\n       fz += dz * inv_dist3;\\n     }\\n \\n-    p[i].vx += dt*fx; \\n-    p[i].vy += dt*fy; \\n+    p[i].vx += dt*fx;\\n+    p[i].vy += dt*fy;\\n     p[i].vz += dt*fz;\\n   }\\n }\\n \\n+/*\\n+ * Compute the gravitational impact among all pairs of bodies in\\n+ * the system, retaining a standalone entry point.\\n+ */\\n+void body_force(Body *p, float dt, int n) {\\n+  #pragma omp parallel if (n > 1)\\n+  {\\n+    body_force_workshare(p, dt, n);\\n+  }\\n+}\\n+\\n /*\\n  * Read a binary dataset with initilized bodies.\\n  */\\n@@ -77,23 +146,24 @@ int main(int argc,char **argv) {\\n \\n   Body *bodies = read_dataset(&nbodies);\\n \\n-  /*\\n-   * At each simulation iteration, interbody forces are computed,\\n-   * and bodies' positions are integrated.\\n-   */\\n-  for (int iter = 0; iter < N_ITER; iter++) {\\n-    body_force(bodies, DT, nbodies);\\n-\\n-    for (int i = 0; i < nbodies; i++) {\\n-      bodies[i].x += bodies[i].vx * DT;\\n-      bodies[i].y += bodies[i].vy * DT;\\n-      bodies[i].z += bodies[i].vz * DT;\\n+  /* Keep one team and both synchronous phase barriers across iterations. */\\n+  #pragma omp parallel if (nbodies > 1)\\n+  {\\n+    for (int iter = 0; iter < N_ITER; iter++) {\\n+      body_force_workshare(bodies, DT, nbodies);\\n+\\n+      #pragma omp for schedule(static)\\n+      for (int i = 0; i < nbodies; i++) {\\n+        bodies[i].x += bodies[i].vx * DT;\\n+        bodies[i].y += bodies[i].vy * DT;\\n+        bodies[i].z += bodies[i].vz * DT;\\n+      }\\n     }\\n   }\\n \\n   write_dataset(nbodies, bodies);\\n \\n   free(bodies);\\n-  \\n+\\n   exit(EXIT_SUCCESS);\\n }\"}, {\"id\": \"f85d6cd3609f4fe9\", \"role\": \"C\", \"commit\": \"151e49664cd6c54f8b27b4b4708f7b4351f9f291\", \"transformations\": {\"files\": [\"src/nbody.c\"], \"retained\": [\"Extract the unchanged force kernel into a statically scheduled worksharing helper, retaining a standalone body_force wrapper.\", \"Use one persistent OpenMP team for all simulation iterations and statically distribute position updates.\", \"Keep implicit barriers between force and position phases; serialize the parallel region when there is at most one body.\"]}, \"mean_seconds\": 0.17024493496865034, \"diff\": \"diff --git a/src/nbody.c b/src/nbody.c\\nindex 765bd6a..4bb4744 100644\\n--- a/src/nbody.c\\n+++ b/src/nbody.c\\n@@ -14,13 +14,14 @@\\n typedef struct { float x, y, z, vx, vy, vz; } Body;\\n \\n /*\\n- * Compute the gravitational impact among all pairs of bodies in \\n- * the system.\\n+ * Called collectively by a team. The implicit worksharing barrier\\n+ * completes all force calculations before positions can be updated.\\n  */\\n-void body_force(Body *p, float dt, int n) {\\n+static void body_force_workshare(Body *p, float dt, int n) {\\n+  #pragma omp for schedule(static)\\n   for (int i = 0; i < n; ++i) {\\n-    float fx = 0.0f; \\n-    float fy = 0.0f; \\n+    float fx = 0.0f;\\n+    float fy = 0.0f;\\n     float fz = 0.0f;\\n \\n     for (int j = 0; j < n; j++) {\\n@@ -31,17 +32,28 @@ void body_force(Body *p, float dt, int n) {\\n       float inv_dist = 1 / sqrt(sqrd_dist);\\n       float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n \\n-      fx += dx * inv_dist3; \\n-      fy += dy * inv_dist3; \\n+      fx += dx * inv_dist3;\\n+      fy += dy * inv_dist3;\\n       fz += dz * inv_dist3;\\n     }\\n \\n-    p[i].vx += dt*fx; \\n-    p[i].vy += dt*fy; \\n+    p[i].vx += dt*fx;\\n+    p[i].vy += dt*fy;\\n     p[i].vz += dt*fz;\\n   }\\n }\\n \\n+/*\\n+ * Compute the gravitational impact among all pairs of bodies in\\n+ * the system, retaining a standalone entry point.\\n+ */\\n+void body_force(Body *p, float dt, int n) {\\n+  #pragma omp parallel if (n > 1)\\n+  {\\n+    body_force_workshare(p, dt, n);\\n+  }\\n+}\\n+\\n /*\\n  * Read a binary dataset with initilized bodies.\\n  */\\n@@ -78,22 +90,26 @@ int main(int argc,char **argv) {\\n   Body *bodies = read_dataset(&nbodies);\\n \\n   /*\\n-   * At each simulation iteration, interbody forces are computed,\\n-   * and bodies' positions are integrated.\\n+   * Keep one team across all iterations. Each worksharing loop ends\\n+   * with a barrier, preserving the synchronous simulation phases.\\n    */\\n-  for (int iter = 0; iter < N_ITER; iter++) {\\n-    body_force(bodies, DT, nbodies);\\n+  #pragma omp parallel if (nbodies > 1)\\n+  {\\n+    for (int iter = 0; iter < N_ITER; iter++) {\\n+      body_force_workshare(bodies, DT, nbodies);\\n \\n-    for (int i = 0; i < nbodies; i++) {\\n-      bodies[i].x += bodies[i].vx * DT;\\n-      bodies[i].y += bodies[i].vy * DT;\\n-      bodies[i].z += bodies[i].vz * DT;\\n+      #pragma omp for schedule(static)\\n+      for (int i = 0; i < nbodies; i++) {\\n+        bodies[i].x += bodies[i].vx * DT;\\n+        bodies[i].y += bodies[i].vy * DT;\\n+        bodies[i].z += bodies[i].vz * DT;\\n+      }\\n     }\\n   }\\n \\n   write_dataset(nbodies, bodies);\\n \\n   free(bodies);\\n-  \\n+\\n   exit(EXIT_SUCCESS);\\n }\"}, {\"id\": \"b60a0e38fe67496d\", \"role\": \"C\", \"commit\": \"1c5d441fe99e456e532f97dccecbe59e836c555f\", \"transformations\": {\"files\": [\"src/nbody.c\"], \"retained\": [\"Use a persistent OpenMP team with static target ownership across all ten iterations.\", \"Fuse force accumulation, velocity update and position integration into one double-buffered work-sharing loop, requiring one barrier per timestep.\", \"Retain the original serial path for fewer than 128 bodies or scratch-allocation failure.\"]}, \"mean_seconds\": 0.17376612623532614, \"diff\": \"diff --git a/src/nbody.c b/src/nbody.c\\nindex 765bd6a..a2de3c4 100644\\n--- a/src/nbody.c\\n+++ b/src/nbody.c\\n@@ -14,13 +14,13 @@\\n typedef struct { float x, y, z, vx, vy, vz; } Body;\\n \\n /*\\n- * Compute the gravitational impact among all pairs of bodies in \\n+ * Compute the gravitational impact among all pairs of bodies in\\n  * the system.\\n  */\\n void body_force(Body *p, float dt, int n) {\\n   for (int i = 0; i < n; ++i) {\\n-    float fx = 0.0f; \\n-    float fy = 0.0f; \\n+    float fx = 0.0f;\\n+    float fy = 0.0f;\\n     float fz = 0.0f;\\n \\n     for (int j = 0; j < n; j++) {\\n@@ -31,17 +31,84 @@ void body_force(Body *p, float dt, int n) {\\n       float inv_dist = 1 / sqrt(sqrd_dist);\\n       float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n \\n-      fx += dx * inv_dist3; \\n-      fy += dy * inv_dist3; \\n+      fx += dx * inv_dist3;\\n+      fy += dy * inv_dist3;\\n       fz += dz * inv_dist3;\\n     }\\n \\n-    p[i].vx += dt*fx; \\n-    p[i].vy += dt*fy; \\n+    p[i].vx += dt*fx;\\n+    p[i].vy += dt*fy;\\n     p[i].vz += dt*fz;\\n   }\\n }\\n \\n+/*\\n+ * Advance independent targets into a separate state array. The implicit\\n+ * work-sharing barrier makes the complete next state visible each step.\\n+ */\\n+static void simulate(Body *bodies, int nbodies) {\\n+  Body *scratch = NULL;\\n+  if (nbodies >= 128) {\\n+    scratch = (Body *)malloc(nbodies * sizeof(Body));\\n+  }\\n+\\n+  if (scratch == NULL) {\\n+    for (int iter = 0; iter < N_ITER; iter++) {\\n+      body_force(bodies, DT, nbodies);\\n+\\n+      for (int i = 0; i < nbodies; i++) {\\n+        bodies[i].x += bodies[i].vx * DT;\\n+        bodies[i].y += bodies[i].vy * DT;\\n+        bodies[i].z += bodies[i].vz * DT;\\n+      }\\n+    }\\n+    return;\\n+  }\\n+\\n+  #pragma omp parallel\\n+  {\\n+    for (int iter = 0; iter < N_ITER; iter++) {\\n+      const Body *current = (iter & 1) ? scratch : bodies;\\n+      Body *next = (iter & 1) ? bodies : scratch;\\n+\\n+      #pragma omp for schedule(static)\\n+      for (int i = 0; i < nbodies; i++) {\\n+        float fx = 0.0f;\\n+        float fy = 0.0f;\\n+        float fz = 0.0f;\\n+\\n+        for (int j = 0; j < nbodies; j++) {\\n+          float dx = current[j].x - current[i].x;\\n+          float dy = current[j].y - current[i].y;\\n+          float dz = current[j].z - current[i].z;\\n+          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n+          float inv_dist = 1 / sqrt(sqrd_dist);\\n+          float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n+\\n+          fx += dx * inv_dist3;\\n+          fy += dy * inv_dist3;\\n+          fz += dz * inv_dist3;\\n+        }\\n+\\n+        Body updated = current[i];\\n+        updated.vx += DT*fx;\\n+        updated.vy += DT*fy;\\n+        updated.vz += DT*fz;\\n+\\n+        updated.x += updated.vx * DT;\\n+        updated.y += updated.vy * DT;\\n+        updated.z += updated.vz * DT;\\n+        next[i] = updated;\\n+      }\\n+    }\\n+  }\\n+\\n+  if (N_ITER & 1) {\\n+    memcpy(bodies, scratch, nbodies * sizeof(Body));\\n+  }\\n+  free(scratch);\\n+}\\n+\\n /*\\n  * Read a binary dataset with initilized bodies.\\n  */\\n@@ -81,19 +148,11 @@ int main(int argc,char **argv) {\\n    * At each simulation iteration, interbody forces are computed,\\n    * and bodies' positions are integrated.\\n    */\\n-  for (int iter = 0; iter < N_ITER; iter++) {\\n-    body_force(bodies, DT, nbodies);\\n-\\n-    for (int i = 0; i < nbodies; i++) {\\n-      bodies[i].x += bodies[i].vx * DT;\\n-      bodies[i].y += bodies[i].vy * DT;\\n-      bodies[i].z += bodies[i].vz * DT;\\n-    }\\n-  }\\n+  simulate(bodies, nbodies);\\n \\n   write_dataset(nbodies, bodies);\\n \\n   free(bodies);\\n-  \\n+\\n   exit(EXIT_SUCCESS);\\n }\"}, {\"id\": \"a486b82f661047f0\", \"role\": \"B\", \"commit\": \"9c99a39f489587684244d1fa2d737d1f0c3f6b83\", \"transformations\": {\"files\": [\"src/nbody.c\"], \"retained\": [\"Strip-mine the target-body loop into four independent SIMD lanes while retaining ascending j order in every lane.\", \"Use double-precision NEON sqrt/divide followed by float conversion, retaining the original float expression structure.\", \"Retain the scalar remainder and scalar fallback for non-NEON or fast-math builds.\"]}, \"mean_seconds\": 0.32377621966103715, \"diff\": \"diff --git a/src/nbody.c b/src/nbody.c\\nindex 765bd6a..1ce499e 100644\\n--- a/src/nbody.c\\n+++ b/src/nbody.c\\n@@ -3,6 +3,10 @@\\n #include <string.h>\\n #include <math.h>\\n \\n+#if defined(__aarch64__) && defined(__ARM_NEON) && !defined(__FAST_MATH__)\\n+#include <arm_neon.h>\\n+#endif\\n+\\n #define N_ITER 10 // number of simulation iterations\\n #define DT 0.01f // time step\\n #define SOFTENING 1e-9f // to avoid zero divisors\\n@@ -14,13 +18,64 @@\\n typedef struct { float x, y, z, vx, vy, vz; } Body;\\n \\n /*\\n- * Compute the gravitational impact among all pairs of bodies in \\n+ * Compute the gravitational impact among all pairs of bodies in\\n  * the system.\\n  */\\n void body_force(Body *p, float dt, int n) {\\n-  for (int i = 0; i < n; ++i) {\\n-    float fx = 0.0f; \\n-    float fy = 0.0f; \\n+  int i = 0;\\n+\\n+#if defined(__aarch64__) && defined(__ARM_NEON) && !defined(__FAST_MATH__)\\n+  const int vector_end = n - n % 4;\\n+  const float32x4_t softening = vdupq_n_f32(SOFTENING);\\n+  const float64x2_t one = vdupq_n_f64(1.0);\\n+\\n+  /* Each lane owns one target; every lane visits j in original order. */\\n+  for (; i < vector_end; i += 4) {\\n+    const float32x4_t x = {p[i].x, p[i + 1].x, p[i + 2].x, p[i + 3].x};\\n+    const float32x4_t y = {p[i].y, p[i + 1].y, p[i + 2].y, p[i + 3].y};\\n+    const float32x4_t z = {p[i].z, p[i + 1].z, p[i + 2].z, p[i + 3].z};\\n+    float32x4_t fx = vdupq_n_f32(0.0f);\\n+    float32x4_t fy = vdupq_n_f32(0.0f);\\n+    float32x4_t fz = vdupq_n_f32(0.0f);\\n+\\n+    for (int j = 0; j < n; ++j) {\\n+      float32x4_t dx = vdupq_n_f32(p[j].x) - x;\\n+      float32x4_t dy = vdupq_n_f32(p[j].y) - y;\\n+      float32x4_t dz = vdupq_n_f32(p[j].z) - z;\\n+      float32x4_t sqrd_dist = dx*dx + dy*dy + dz*dz + softening;\\n+\\n+      /* Match sqrt(double(sqrd_dist)) and double division before rounding. */\\n+      float64x2_t distance_lo = vcvt_f64_f32(vget_low_f32(sqrd_dist));\\n+      float64x2_t distance_hi = vcvt_f64_f32(vget_high_f32(sqrd_dist));\\n+      float64x2_t inverse_lo = vdivq_f64(one, vsqrtq_f64(distance_lo));\\n+      float64x2_t inverse_hi = vdivq_f64(one, vsqrtq_f64(distance_hi));\\n+      float32x4_t inv_dist = vcombine_f32(vcvt_f32_f64(inverse_lo),\\n+                                         vcvt_f32_f64(inverse_hi));\\n+      float32x4_t inv_dist3 = inv_dist * inv_dist * inv_dist;\\n+\\n+      fx += dx * inv_dist3;\\n+      fy += dy * inv_dist3;\\n+      fz += dz * inv_dist3;\\n+    }\\n+\\n+    p[i].vx += dt * vgetq_lane_f32(fx, 0);\\n+    p[i].vy += dt * vgetq_lane_f32(fy, 0);\\n+    p[i].vz += dt * vgetq_lane_f32(fz, 0);\\n+    p[i + 1].vx += dt * vgetq_lane_f32(fx, 1);\\n+    p[i + 1].vy += dt * vgetq_lane_f32(fy, 1);\\n+    p[i + 1].vz += dt * vgetq_lane_f32(fz, 1);\\n+    p[i + 2].vx += dt * vgetq_lane_f32(fx, 2);\\n+    p[i + 2].vy += dt * vgetq_lane_f32(fy, 2);\\n+    p[i + 2].vz += dt * vgetq_lane_f32(fz, 2);\\n+    p[i + 3].vx += dt * vgetq_lane_f32(fx, 3);\\n+    p[i + 3].vy += dt * vgetq_lane_f32(fy, 3);\\n+    p[i + 3].vz += dt * vgetq_lane_f32(fz, 3);\\n+  }\\n+#endif\
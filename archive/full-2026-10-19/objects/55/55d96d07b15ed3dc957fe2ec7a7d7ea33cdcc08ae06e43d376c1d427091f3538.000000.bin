/*
  Quicksort
*/
#include <stdio.h>
#include <stdlib.h>
#include <limits.h>
#include <openssl/md5.h>

#define INSERTION_CUTOFF 24
#define TASK_CUTOFF 8192
#define PARALLEL_CUTOFF 65536

/*
 * Prototypes
 */
void srandnum(int seed);
double randnum(void);
int *generate_case(int N);
double drand(int xmin, int xmax);
void swap(int *toorder, int i, int j);
int partition(int *toorder, int lo, int hi);
void _quicksort(int *toorder, int lo, int hi);
void quicksort(int *toorder, int N);
int is_sorted(int *toorder, int N);
static void quicksort_impl(int *toorder, int lo, int hi, unsigned int seed,
                           int depth, int allow_tasks);
static unsigned int next_pivot_random(unsigned int *state);
static unsigned int derive_seed(unsigned int value);
static int sort_depth_limit(int count);
static void insertion_sort(int *toorder, int lo, int hi);
static void sift_down(int *toorder, int lo, int root, int count);
static void heapsort_range(int *toorder, int lo, int hi);

/*
 * A generic pRNG
 */
#define MY_RAND_MAX 0x7FFFFFFF

#define RANDNUM_W 521288629
#define RANDNUM_Z 362436069

unsigned int randum_w = RANDNUM_W;
unsigned int randum_z = RANDNUM_Z;

void srandnum(int seed)
{
    unsigned int w, z;
    w = (seed * 104623) & 0xffffffff;
    randum_w = (w) ? w : RANDNUM_W;
    z = (seed * 48947) & 0xffffffff;
    randum_z = (z) ? z : RANDNUM_Z;
}

double randnum(void)
{
    unsigned int u;
    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);
    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);
    u = (randum_z << 16) + randum_w;
    return (abs(u));
}

/*
 * Main function
 */
int main(int argc, char *argv[])
{
    int N = 0;
    int *our_list = NULL;

    //The input provides the case size
    scanf("%d", &N);
    if (N <= 0) {
        printf("Error: please, provide the case size.\n");
        return 1;
    }

    //Generate the case
    our_list = generate_case(N);
    if (our_list == NULL) {
        printf("Error: case instantiation failed.\n");
        return 1;
    }

    //Do the thing
    quicksort(our_list, N);

    if (is_sorted(our_list, N) == 1) {
        printf("Error, for some reason list is still unsorted.\n");
        return 1;
    }

#ifdef COMPUTE_MD5_PROBLEM
    //Compute MD5 Checksum for problem identification
    MD5_CTX c;
    unsigned char out[MD5_DIGEST_LENGTH];
    MD5_Init(&c);
    MD5_Update(&c, our_list, N * sizeof(int));
    MD5_Final(out, &c);
    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {
        printf("%02x", out[n]);
    }
#endif
    printf("\n");

    //Clean up
    free(our_list);

    return 0;
}

/*
 * Public API
 */
void quicksort(int *toorder, int N)
{
    if (N <= 1)
        return;

    if (N < PARALLEL_CUTOFF) {
        _quicksort(toorder, 0, N - 1);
        return;
    }

    int depth = sort_depth_limit(N);
    #pragma omp parallel
    {
        #pragma omp single
        quicksort_impl(toorder, 0, N - 1, 0x243f6a88U, depth, 1);
    }
}

/*
 * Internal recursive function to quicksort
 */
void _quicksort(int *toorder, int lo, int hi)
{
    if (lo >= hi)
        return;
    quicksort_impl(toorder, lo, hi, 0x243f6a88U,
                   sort_depth_limit(hi - lo + 1), 0);
}

static int sort_depth_limit(int count)
{
    int depth = 0;
    while (count > 1) {
        count >>= 1;
        depth += 2;
    }
    return depth;
}

static unsigned int next_pivot_random(unsigned int *state)
{
    unsigned int x = *state;
    if (x == 0)
        x = 0x6d2b79f5U;
    x ^= x << 13;
    x ^= x >> 17;
    x ^= x << 5;
    *state = x;
    return x;
}

static unsigned int derive_seed(unsigned int value)
{
    value ^= value >> 16;
    value *= 0x7feb352dU;
    value ^= value >> 15;
    value *= 0x846ca68bU;
    value ^= value >> 16;
    return value ? value : 0x6d2b79f5U;
}

static void insertion_sort(int *toorder, int lo, int hi)
{
    for (int i = lo + 1; i <= hi; i++) {
        int value = toorder[i];
        int j = i;
        while (j > lo && toorder[j - 1] > value) {
            toorder[j] = toorder[j - 1];
            j--;
        }
        toorder[j] = value;
    }
}

static void sift_down(int *toorder, int lo, int root, int count)
{
    while (root < count / 2) {
        int child = root * 2 + 1;
        if (child + 1 < count && toorder[lo + child] < toorder[lo + child + 1])
            ++child;
        if (toorder[lo + root] >= toorder[lo + child])
            return;
        swap(toorder, lo + root, lo + child);
        root = child;
    }
}

static void heapsort_range(int *toorder, int lo, int hi)
{
    int count = hi - lo + 1;
    if (count < 2)
        return;

    for (int start = count / 2; start > 0;) {
        --start;
        sift_down(toorder, lo, start, count);
    }
    for (int end = count - 1; end > 0; --end) {
        swap(toorder, lo, lo + end);
        sift_down(toorder, lo, 0, end);
    }
}

/*
 * In-place three-way introsort. Large disjoint ranges may be scheduled as
 * OpenMP tasks; serial work recurses on the smaller side and iterates on the larger.
 */
static void quicksort_impl(int *toorder, int lo, int hi, unsigned int seed,
                           int depth, int allow_tasks)
{
    while (lo < hi) {
        int count = hi - lo + 1;
        if (count <= INSERTION_CUTOFF) {
            insertion_sort(toorder, lo, hi);
            return;
        }
        if (depth <= 0) {
            heapsort_range(toorder, lo, hi);
            return;
        }

        unsigned int random_value = next_pivot_random(&seed);
        int pivot_index = lo + (int)(random_value % (unsigned int)count);
        int pivot = toorder[pivot_index];
        int less = lo;
        int current = lo;
        int greater = hi;

        while (current <= greater) {
            if (toorder[current] < pivot) {
                swap(toorder, less, current);
                ++less;
                ++current;
            } else if (toorder[current] > pivot) {
                swap(toorder, current, greater);
                --greater;
            } else {
                ++current;
            }
        }

        int left_size = less - lo;
        int right_size = hi - greater;
        int next_depth = depth - 1;
        unsigned int left_seed = derive_seed(seed ^ 0x9e3779b9U ^ (unsigned int)lo);
        unsigned int right_seed = derive_seed(seed ^ 0x85ebca6bU ^ (unsigned int)hi);

        if (allow_tasks && count >= TASK_CUTOFF) {
            if (left_size <= right_size) {
                if (left_size >= TASK_CUTOFF) {
                    int left_hi = less - 1;
                    #pragma omp task firstprivate(toorder, lo, left_hi, left_seed, next_depth)
                    quicksort_impl(toorder, lo, left_hi, left_seed,
                                   next_depth, 1);
                } else if (left_size > 1) {
                    quicksort_impl(toorder, lo, less - 1, left_seed,
                                   next_depth, 1);
                }
                lo = greater + 1;
                seed = right_seed;
                depth = next_depth;
            } else {
                if (right_size >= TASK_CUTOFF) {
                    int right_lo = greater + 1;
                    #pragma omp task firstprivate(toorder, right_lo, hi, right_seed, next_depth)
                    quicksort_impl(toorder, right_lo, hi, right_seed,
                                   next_depth, 1);
                } else if (right_size > 1) {
                    quicksort_impl(toorder, greater + 1, hi, right_seed,
                                   next_depth, 1);
                }
                hi = less - 1;
                seed = left_seed;
                depth = next_depth;
            }
        } else if (left_size <= right_size) {
            if (left_size > 1)
                quicksort_impl(toorder, lo, less - 1, left_seed,
                               next_depth, 0);
            lo = greater + 1;
            seed = right_seed;
            depth = next_depth;
        } else {
            if (right_size > 1)
                quicksort_impl(toorder, greater + 1, hi, right_seed,
                               next_depth, 0);
            hi = less - 1;
            seed = left_seed;
            depth = next_depth;
        }
    }
}

/*
 * Swap two values.
 */
void swap(int *toorder, int i, int j)
{
    int temp = toorder[i];
    toorder[i] = toorder[j];
    toorder[j] = temp;
}

/*
 * Partition decision
 */
int partition(int *toorder, int lo, int hi)
{
    int b = lo;
    int r = (int) (lo + (hi - lo) * (randnum() / MY_RAND_MAX));
    int pivot = toorder[r];
    swap(toorder, r, hi);
    for (int i = lo; i < hi; i++) {
        if (toorder[i] < pivot) {
            swap(toorder, i, b);
            b++;
        }
    }
    swap(toorder, hi, b);
    return b;
}

/*
 * Check if elements are in non-decreasing order
 */
int is_sorted(int *toorder, int N)
{
    for (int i = 1; i < N; i++) {
        if (toorder[i] < toorder[i - 1]) {
            return 1;
        }
    }
    return 0;
}


/*
 * Generate a case
 */
int *generate_case(int N)
{
    int i;
    int *ret = NULL;

    // Make case generation reproducible
    srandnum(0);

    // Allocate memory
    ret = (int *) malloc(N * sizeof(int));
    if (ret == NULL) {
        printf("Error: some malloc won't work.\n");
        return NULL;
    }
    // Get pseudo-random positive integer values
    for (i = 0; i < N; i++) {
        ret[i] = drand(0, INT_MAX);
    }
    return ret;
}

/*
 * A pseudo-random number between two positive integer values
 */
double drand(int xmin, int xmax)
{
    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;
}

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors
#define POSITION_PACKET_SIZE 32

/*
 * Each body holds coordinate positions (i.e., x, y, and z) and
 * velocities (i.e., vx, vy, and vz).
 */
typedef struct { float x, y, z, vx, vy, vz; } Body;

typedef struct {
  float x[POSITION_PACKET_SIZE];
  float y[POSITION_PACKET_SIZE];
  float z[POSITION_PACKET_SIZE];
} PositionPacket;

static void body_force_scalar(Body *p, float dt, int n) {
  for (int i = 0; i < n; ++i) {
    float fx = 0.0f;
    float fy = 0.0f;
    float fz = 0.0f;

    for (int j = 0; j < n; j++) {
      float dx = p[j].x - p[i].x;
      float dy = p[j].y - p[i].y;
      float dz = p[j].z - p[i].z;
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1 / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    p[i].vx += dt*fx;
    p[i].vy += dt*fy;
    p[i].vz += dt*fz;
  }
}

#if defined(__GNUC__) && !defined(__clang__)
#pragma GCC push_options
#pragma GCC optimize ("no-math-errno")
#endif

/* SIMD lanes represent independent targets, not a force reduction. */
static inline void accumulate_block(const PositionPacket *restrict target,
                                    float sx, float sy, float sz,
                                    float *restrict fx,
                                    float *restrict fy,
                                    float *restrict fz) {
  #pragma omp simd
  for (int lane = 0; lane < POSITION_PACKET_SIZE; ++lane) {
    float dx = sx - target->x[lane];
    float dy = sy - target->y[lane];
    float dz = sz - target->z[lane];
    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
    float inv_dist = 1 / sqrt(sqrd_dist);
    float inv_dist3 = inv_dist * inv_dist * inv_dist;

    fx[lane] += dx * inv_dist3;
    fy[lane] += dy * inv_dist3;
    fz[lane] += dz * inv_dist3;
  }
}

/*
 * Share each source across a cache-resident block of targets.
 * Every target visits the real sources in increasing body order.
 */
void body_force(Body *p, float dt, int n) {
  if (n <= 0) {
    return;
  }

  const size_t packets =
      ((size_t)n + POSITION_PACKET_SIZE - 1) / POSITION_PACKET_SIZE;
  PositionPacket *positions = malloc(packets * sizeof(*positions));
  if (positions == NULL) {
    body_force_scalar(p, dt, n);
    return;
  }

  for (size_t packet = 0; packet < packets; ++packet) {
    for (int lane = 0; lane < POSITION_PACKET_SIZE; ++lane) {
      const size_t i = packet * POSITION_PACKET_SIZE + (size_t)lane;
      if (i < (size_t)n) {
        positions[packet].x[lane] = p[i].x;
        positions[packet].y[lane] = p[i].y;
        positions[packet].z[lane] = p[i].z;
      } else {
        positions[packet].x[lane] = 0.0f;
        positions[packet].y[lane] = 0.0f;
        positions[packet].z[lane] = 0.0f;
      }
    }
  }

  const size_t full_packets = (size_t)n / POSITION_PACKET_SIZE;
  const int tail = n % POSITION_PACKET_SIZE;

  #pragma omp parallel for schedule(static) if(n >= 64)
  for (size_t tile = 0; tile < packets; ++tile) {
    const PositionPacket *target = &positions[tile];
    float fx[POSITION_PACKET_SIZE] = {0.0f};
    float fy[POSITION_PACKET_SIZE] = {0.0f};
    float fz[POSITION_PACKET_SIZE] = {0.0f};

    for (size_t source_packet = 0;
         source_packet < full_packets; ++source_packet) {
      const PositionPacket *source = &positions[source_packet];
      for (int source_lane = 0;
           source_lane < POSITION_PACKET_SIZE; ++source_lane) {
        accumulate_block(target,
                         source->x[source_lane],
                         source->y[source_lane],
                         source->z[source_lane], fx, fy, fz);
      }
    }

    if (tail != 0) {
      const PositionPacket *source = &positions[full_packets];
      for (int source_lane = 0; source_lane < tail; ++source_lane) {
        accumulate_block(target,
                         source->x[source_lane],
                         source->y[source_lane],
                         source->z[source_lane], fx, fy, fz);
      }
    }

    const size_t first = tile * POSITION_PACKET_SIZE;
    const size_t remaining = (size_t)n - first;
    const int count = remaining < POSITION_PACKET_SIZE
                      ? (int)remaining : POSITION_PACKET_SIZE;
    for (int lane = 0; lane < count; ++lane) {
      const size_t i = first + (size_t)lane;
      p[i].vx += dt*fx[lane];
      p[i].vy += dt*fy[lane];
      p[i].vz += dt*fz[lane];
    }
  }

  free(positions);
}

#if defined(__GNUC__) && !defined(__clang__)
#pragma GCC pop_options
#endif

/*
 * Read a binary dataset with initilized bodies.
 */
Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  return bodies;
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc,char **argv) {
  int nbodies;

  Body *bodies = read_dataset(&nbodies);

  /*
   * At each simulation iteration, interbody forces are computed,
   * and bodies' positions are integrated.
   */
  for (int iter = 0; iter < N_ITER; iter++) {
    body_force(bodies, DT, nbodies);

    for (int i = 0; i < nbodies; i++) {
      bodies[i].x += bodies[i].vx * DT;
      bodies[i].y += bodies[i].vy * DT;
      bodies[i].z += bodies[i].vz * DT;
    }
  }

  write_dataset(nbodies, bodies);

  free(bodies);
  
  exit(EXIT_SUCCESS);
}

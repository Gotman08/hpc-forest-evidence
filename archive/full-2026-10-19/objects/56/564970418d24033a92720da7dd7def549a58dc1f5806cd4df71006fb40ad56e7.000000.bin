        "content": "#include <iostream>\n#include <vector>\n#include <utility>\n#include <cstddef>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nusing namespace std;\n\ntypedef vector<vector<unsigned char>> adjacency_matrix;\ntypedef vector<unsigned char> vertex_permutation;\n\nadjacency_matrix readGraph();\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2);\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vertex_permutation &equivalence);\ninline void printPermutation(const vertex_permutation &equivalence, size_t vertices);\n\nint main(){\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if(!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2){\n    if(g1.size() != g2.size()) return false;\n\n    const size_t vertices = g1.size();\n    // Every valid vertex index is below 100. Padding is an invalid table index.\n    vertex_permutation equivalence(vertices < 16 ? 16 : vertices, 255);\n    vector<int> exchange_counter(vertices, 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    for(size_t i = 0; i < vertices; ++i)\n        equivalence[i] = static_cast<unsigned char>(i);\n\n    if(verifyPermutation(g1, g2, equivalence)){\n        printPermutation(equivalence, vertices);\n        return true;\n    }\n\n    // Preserve Heap's traversal and print every matching nonidentity permutation.\n    while(static_cast<size_t>(exchange_index) < vertices){\n        if(exchange_counter[exchange_index] < exchange_index){\n            if(exchange_index % 2 == 0)\n                swap(equivalence[0], equivalence[exchange_index]);\n            else\n                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\n            if(verifyPermutation(g1, g2, equivalence)){\n                printPermutation(equivalence, vertices);\n                isomorphism_found = true;\n            }\n\n            exchange_counter[exchange_index]++;\n            exchange_index = 1;\n        }else{\n            exchange_counter[exchange_index] = 0;\n            exchange_index++;\n        }\n    }\n    return isomorphism_found;\n}\n\nadjacency_matrix readGraph(){\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read(vertices);\n    const size_t row_width = vertices < 16 ? 16 : static_cast<size_t>(vertices);\n    for(int i = 0; i < vertices; ++i)\n        read[i].resize(row_width, 0);\n\n    cin >> edges;\n    for(int i = 0; i < edges; ++i){\n        cin >> source >> destination;\n        read[destination][source] = read[source][destination] = 1;\n    }\n\n    return read;\n}\n\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vertex_permutation &equivalence){\n    const size_t vertices = g1.size();\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    if(vertices <= 16){\n        const uint8x16_t order = vld1q_u8(equivalence.data());\n        for(size_t i = 0; i < vertices; ++i){\n            const uint8x16_t expected = vld1q_u8(g1[i].data());\n            const uint8x16_t source = vld1q_u8(g2[equivalence[i]].data());\n            const uint8x16_t mapped = vqtbl1q_u8(source, order);\n            // Symmetry makes full-row comparison equivalent to the lower triangle.\n            // Index 255 produces zero, matching the zero-padded adjacency rows.\n            if(vmaxvq_u8(veorq_u8(expected, mapped)) != 0)\n                return false;\n        }\n        return true;\n    }\n#endif\n\n    for(size_t i = 0; i < vertices; ++i){\n        const unsigned char *expected = g1[i].data();\n        const unsigned char *source = g2[equivalence[i]].data();\n        for(size_t j = 0; j <= i; ++j){\n            if(expected[j] != source[equivalence[j]]) return false;\n        }\n    }\n    return true;\n}\n\ninline void printPermutation(const vertex_permutation &equivalence, size_t vertices){\n    for(size_t i = 0; i < vertices; ++i)\n        cout << static_cast<unsigned int>(equivalence[i]) << \" \";\n    cout << endl;\n}\n",

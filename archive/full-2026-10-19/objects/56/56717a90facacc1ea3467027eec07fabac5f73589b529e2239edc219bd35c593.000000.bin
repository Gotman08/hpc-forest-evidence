        "content": "#include \"knn.h\"\n#include <float.h>\n#include <string.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nenum { SMALL_K = 64, BATCH_SIZE = 256, RADIX_BUCKETS = 2048 };\n\nstatic char winning_label(const size_t *counts) {\n    char winner = (char)CHAR_MIN;\n    size_t best = 0;\n    for (int label = CHAR_MIN; label <= CHAR_MAX; ++label) {\n        if (counts[(unsigned char)label] > best) {\n            best = counts[(unsigned char)label];\n            winner = (char)label;\n        }\n    }\n    return winner;\n}\n\n/* Preserve the original order-dependent behavior for NaN distances. */\nstatic char knn_serial(int n_groups, Group *groups, int k, Point query) {\n    if ((size_t)k > SIZE_MAX / sizeof(float)) on_error();\n    float *distances = (float *)malloc((size_t)k * sizeof(float));\n    char *labels = (char *)malloc((size_t)k);\n    if (distances == NULL || labels == NULL) on_error();\n\n    for (int i = 0; i < k; ++i) {\n        distances[i] = -1.0f;\n        labels[i] = (char)-1;\n    }\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; ++j) {\n            float d = euclidean_distance_no_sqrt(query, g.points[j]);\n            for (int x = 0; x < k; ++x) {\n                if (d < distances[x] || distances[x] == -1.0f) {\n                    size_t shifted = (size_t)(k - x - 1);\n                    memmove(distances + x + 1, distances + x,\n                            shifted * sizeof(float));\n                    memmove(labels + x + 1, labels + x, shifted);\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n    size_t counts[UCHAR_MAX + 1] = {0};\n    for (int i = 0; i < k; ++i) ++counts[(unsigned char)labels[i]];\n    free(labels);\n    free(distances);\n    return winning_label(counts);\n}\n\nstatic inline void copy_distance4(float *destination, const float *source) {\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    float32x4_t values = vld1q_f32(source);\n    vst1q_f32(destination, values);\n#else\n    float a = source[0], b = source[1], c = source[2], d = source[3];\n    destination[0] = a;\n    destination[1] = b;\n    destination[2] = c;\n    destination[3] = d;\n#endif\n}\n\nstatic inline void copy_label4(char *destination, const char *source) {\n    char values[4];\n    memcpy(values, source, sizeof(values));\n    memcpy(destination, values, sizeof(values));\n}\n\nstatic int compact_candidates(float *values, int count, float cutoff) {\n    int out = 0;\n    int i = 0;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const float32x4_t limit = vdupq_n_f32(cutoff);\n    for (; i <= count - 4; i += 4) {\n        const float32x4_t candidates = vld1q_f32(values + i);\n        const uint32x4_t keep = vcltq_f32(candidates, limit);\n        if (vminvq_u32(keep) != 0) {\n            vst1q_f32(values + out, candidates);\n            out += 4;\n        } else if (vmaxvq_u32(keep) != 0) {\n            if (vgetq_lane_u32(keep, 0))\n                values[out++] = vgetq_lane_f32(candidates, 0);\n            if (vgetq_lane_u32(keep, 1))\n                values[out++] = vgetq_lane_f32(candidates, 1);\n            if (vgetq_lane_u32(keep, 2))\n                values[out++] = vgetq_lane_f32(candidates, 2);\n            if (vgetq_lane_u32(keep, 3))\n                values[out++] = vgetq_lane_f32(candidates, 3);\n        }\n    }\n#endif\n    for (; i < count; ++i) {\n        float d = values[i];\n        if (d < cutoff) values[out++] = d;\n    }\n    return out;\n}\n\nstatic inline void compare_swap(float *a, float *b) {\n    if (*a > *b) {\n        float temporary = *a;\n        *a = *b;\n        *b = temporary;\n    }\n}\n\nstatic inline void sort_four(float *values) {\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    float32x4_t v = vld1q_f32(values);\n    float32x4_t paired = vrev64q_f32(v);\n    float32x4_t low = vminq_f32(v, paired);\n    float32x4_t high = vmaxq_f32(v, paired);\n    v = vtrn1q_f32(low, high);\n    paired = vextq_f32(v, v, 2);\n    low = vminq_f32(v, paired);\n    high = vmaxq_f32(v, paired);\n    v = vcombine_f32(vget_low_f32(low), vget_high_f32(high));\n    paired = vrev64q_f32(vextq_f32(v, v, 2));\n    low = vminq_f32(v, paired);\n    high = vmaxq_f32(v, paired);\n    v = vsetq_lane_f32(vgetq_lane_f32(low, 1), v, 1);\n    v = vsetq_lane_f32(vgetq_lane_f32(high, 2), v, 2);\n    vst1q_f32(values, v);\n#else\n    compare_swap(values, values + 1);\n    compare_swap(values + 2, values + 3);\n    compare_swap(values, values + 2);\n    compare_swap(values + 1, values + 3);\n    compare_swap(values + 1, values + 2);\n#endif\n}\n\nstatic void sort_candidates(float *values, float *scratch, int count) {\n    int tail = 0;\n    for (; tail <= count - 4; tail += 4) sort_four(values + tail);\n    for (int i = tail + 1; i < count; ++i) {\n        float value = values[i];\n        int j = i;\n        while (j > tail && values[j - 1] > value) {\n            values[j] = values[j - 1];\n            --j;\n        }\n        values[j] = value;\n    }\n\n    float *source = values;\n    float *destination = scratch;\n    for (int width = 4; width < count; width *= 2) {\n        for (int left = 0; left < count; left += 2 * width) {\n            int middle = left + width;\n            int end = left + 2 * width;\n            if (middle > count) middle = count;\n            if (end > count) end = count;\n            int a = left, b = middle, out = left;\n            while (a < middle && b < end) {\n                if (source[a] <= source[b])\n                    destination[out++] = source[a++];\n                else\n                    destination[out++] = source[b++];\n            }\n            if (a < middle)\n                memcpy(destination + out, source + a,\n                       (size_t)(middle - a) * sizeof(float));\n            else if (b < end)\n                memcpy(destination + out, source + b,\n                       (size_t)(end - b) * sizeof(float));\n        }\n        float *temporary = source;\n        source = destination;\n        destination = temporary;\n    }\n    if (source != values)\n        memcpy(values, source, (size_t)count * sizeof(float));\n}\n\n/* Partition the retained prefix before merging backward into its old storage. */\nstatic int merge_candidates(float *distances, char *labels, int used, int k,\n                            const float *batch, int count, char label) {\n    int keep = used + count;\n    if (keep > k) keep = k;\n    int low = keep > count ? keep - count : 0;\n    int high = used < keep ? used : keep;\n    int old_keep, new_keep;\n    for (;;) {\n        old_keep = low + (high - low) / 2;\n        new_keep = keep - old_keep;\n        if (old_keep > 0 && new_keep < count &&\n            distances[old_keep - 1] > batch[new_keep]) {\n            high = old_keep - 1;\n        } else if (new_keep > 0 && old_keep < used &&\n                   batch[new_keep - 1] >= distances[old_keep]) {\n            low = old_keep + 1;\n        } else {\n            break;\n        }\n    }\n\n    int a = old_keep, b = new_keep, out = keep;\n    while (a > 0 && b > 0) {\n        if (a >= 4 && distances[a - 4] > batch[b - 1]) {\n            a -= 4;\n            out -= 4;\n            copy_distance4(distances + out, distances + a);\n            copy_label4(labels + out, labels + a);\n        } else if (b >= 4 && batch[b - 4] >= distances[a - 1]) {\n            b -= 4;\n            out -= 4;\n            copy_distance4(distances + out, batch + b);\n            memset(labels + out, (unsigned char)label, 4);\n        } else if (distances[a - 1] > batch[b - 1]) {\n            --a;\n            --out;\n            distances[out] = distances[a];\n            labels[out] = labels[a];\n        } else {\n            --b;\n            --out;\n            distances[out] = batch[b];\n            labels[out] = label;\n        }\n    }\n    if (b > 0) {\n        memcpy(distances, batch, (size_t)b * sizeof(float));\n        memset(labels, (unsigned char)label, (size_t)b);\n    }\n    return keep;\n}\n\nstatic char knn_batched(int n_groups, Group *groups, int k, Point query) {\n    float distances[SMALL_K];\n    char labels[SMALL_K];\n    float batch[BATCH_SIZE], scratch[BATCH_SIZE];\n    int used = 0;\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length;) {\n            int count = g.length - j;\n            if (count > BATCH_SIZE) count = BATCH_SIZE;\n            for (int t = 0; t < count; ++t) {\n                float d = euclidean_distance_no_sqrt(query, g.points[j + t]);\n                if (d != d) return knn_serial(n_groups, groups, k, query);\n                batch[t] = d;\n            }\n            j += count;\n            if (used == k)\n                count = compact_candidates(batch, count, distances[k - 1]);\n            if (count == 0) continue;\n            sort_candidates(batch, scratch, count);\n            if (count > k) count = k;\n            used = merge_candidates(distances, labels, used, k,\n                                    batch, count, g.label);\n        }\n    }\n    size_t counts[UCHAR_MAX + 1] = {0};\n    for (int i = 0; i < used; ++i) ++counts[(unsigned char)labels[i]];\n    counts[(unsigned char)-1] += (size_t)(k - used);\n    return winning_label(counts);\n}\n\ntypedef struct {\n    size_t histogram[RADIX_BUCKETS];\n    size_t votes[UCHAR_MAX + 1];\n    size_t equal;\n    size_t tie_quota;\n    int has_nan;\n} RadixWorker;\n\nstatic uint32_t select_bucket(RadixWorker *parts, int threads, int buckets,\n                              size_t *rank) {\n    for (int b = 0; b < buckets; ++b) {\n        size_t count = 0;\n        for (int t = 0; t < threads; ++t) count += parts[t].histogram[b];\n        if (*rank <= count) return (uint32_t)b;\n        *rank -= count;\n    }\n    return (uint32_t)(buckets - 1);\n}\n\nstatic char knn_radix(int n_groups, Group *groups, int k, Point query,\n                      size_t total) {\n    if (sizeof(float) != sizeof(uint32_t) || FLT_RADIX != 2 ||\n        FLT_MANT_DIG != 24 || FLT_MAX_EXP != 128 ||\n        total > SIZE_MAX / sizeof(uint32_t))\n        return knn_serial(n_groups, groups, k, query);\n\n    int workers = 1;\n#ifdef _OPENMP\n    workers = omp_get_max_threads();\n    if (workers > 4) workers = 4;\n    if (workers < 1) workers = 1;\n    size_t useful = (total - 1) / 32768 + 1;\n    if ((size_t)workers > useful) workers = (int)useful;\n#endif\n    uint32_t *keys = (uint32_t *)malloc(total * sizeof(uint32_t));\n    unsigned char *point_labels = (unsigned char *)malloc(total);\n    RadixWorker *parts = (RadixWorker *)malloc((size_t)workers * sizeof(*parts));\n    if (keys == NULL || point_labels == NULL || parts == NULL) {\n        free(keys);\n        free(point_labels);\n        free(parts);\n        return knn_serial(n_groups, groups, k, query);\n    }\n\n    size_t rank = (size_t)k;\n    uint32_t cutoff = 0;\n    int has_nan = 0;\n    char result = (char)-1;\n#ifdef _OPENMP\n#pragma omp parallel num_threads(workers) if(workers > 1)\n#endif\n    {\n        int id = 0, team = 1;\n#ifdef _OPENMP\n        id = omp_get_thread_num();\n        team = omp_get_num_threads();\n#endif\n        size_t base = total / (size_t)team;\n        size_t extra = total % (size_t)team;\n        size_t begin = base * (size_t)id +\n                       ((size_t)id < extra ? (size_t)id : extra);\n        size_t end = begin + base + ((size_t)id < extra);\n        RadixWorker *part = parts + id;\n        memset(part->histogram, 0, sizeof(part->histogram));\n        part->has_nan = 0;\n\n        size_t skip = begin, out = begin;\n        for (int i = 0; i < n_groups && out < end; ++i) {\n            Group g = groups[i];\n            size_t length = g.length > 0 ? (size_t)g.length : 0;\n            if (skip >= length) {\n                skip -= length;\n                continue;\n            }\n            size_t count = length - skip;\n            if (count > end - out) count = end - out;\n            for (size_t j = 0; j < count; ++j) {\n                float d = euclidean_distance_no_sqrt(query, g.points[skip + j]);\n                uint32_t bits = 0;\n                if (d != d)\n                    part->has_nan = 1;\n                else if (d != 0.0f)\n                    memcpy(&bits, &d, sizeof(bits));\n                keys[out + j] = bits;\n                point_labels[out + j] = (unsigned char)g.label;\n                ++part->histogram[bits >> 21];\n            }\n            out += count;\n            skip = 0;\n        }\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n        {\n            for (int t = 0; t < team; ++t)\n                if (parts[t].has_nan) has_nan = 1;\n            if (!has_nan)\n                cutoff = select_bucket(parts, team, RADIX_BUCKETS, &rank) << 21;\n        }\n\n        if (!has_nan) {\n            memset(part->histogram, 0, sizeof(part->histogram));\n            for (size_t j = begin; j < end; ++j) {\n                uint32_t key = keys[j];\n                if ((key >> 21) == (cutoff >> 21))\n                    ++part->histogram[(key >> 10) & 2047u];\n            }\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n            {\n                cutoff |= select_bucket(parts, team, RADIX_BUCKETS, &rank) << 10;\n            }\n            memset(part->histogram, 0, sizeof(part->histogram));\n            for (size_t j = begin; j < end; ++j) {\n                uint32_t key = keys[j];\n                if ((key >> 10) == (cutoff >> 10))\n                    ++part->histogram[key & 1023u];\n            }\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n            {\n                cutoff |= select_bucket(parts, team, 1024, &rank);\n            }\n            memset(part->votes, 0, sizeof(part->votes));\n            part->equal = 0;\n            for (size_t j = begin; j < end; ++j) {\n                if (keys[j] < cutoff)\n                    ++part->votes[point_labels[j]];\n                else if (keys[j] == cutoff)\n                    ++part->equal;\n            }\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n            {\n                size_t remaining = rank;\n                for (int t = 0; t < team; ++t) {\n                    size_t take = parts[t].equal;\n                    if (take > remaining) take = remaining;\n                    parts[t].tie_quota = take;\n                    remaining -= take;\n                }\n            }\n            size_t ties = part->tie_quota;\n            for (size_t j = begin; j < end && ties > 0; ++j) {\n                if (keys[j] == cutoff) {\n                    ++part->votes[point_labels[j]];\n                    --ties;\n                }\n            }\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n            {\n                size_t counts[UCHAR_MAX + 1] = {0};\n                for (int t = 0; t < team; ++t)\n                    for (int label = 0; label <= UCHAR_MAX; ++label)\n                        counts[label] += parts[t].votes[label];\n                result = winning_label(counts);\n            }\n        }\n    }\n    free(parts);\n    free(point_labels);\n    free(keys);\n    if (has_nan) return knn_serial(n_groups, groups, k, query);\n    return result;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) return (char)-1;\n    size_t total = 0;\n    for (int i = 0; i < n_groups; ++i) {\n        if (groups[i].length > 0) {\n            size_t length = (size_t)groups[i].length;\n            if (length > SIZE_MAX - total)\n                return knn_serial(n_groups, groups, k, to_evaluate);\n            total += length;\n        }\n    }\n    if ((size_t)k >= total) {\n        size_t counts[UCHAR_MAX + 1] = {0};\n        for (int i = 0; i < n_groups; ++i)\n            if (groups[i].length > 0)\n                counts[(unsigned char)groups[i].label] += (size_t)groups[i].length;\n        counts[(unsigned char)-1] += (size_t)k - total;\n        return winning_label(counts);\n    }\n    if (k <= SMALL_K)\n        return knn_batched(n_groups, groups, k, to_evaluate);\n    return knn_radix(n_groups, groups, k, to_evaluate, total);\n}\n\nint main(void) {\n    int n_groups = parse_number_of_groups();\n    if (n_groups < 0 || (size_t)n_groups > SIZE_MAX / sizeof(Group)) on_error();\n    Group *groups = (Group *)malloc((size_t)n_groups * sizeof(Group));\n    if (n_groups > 0 && groups == NULL) on_error();\n    for (int i = 0; i < n_groups; ++i) groups[i] = parse_next_group();\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n    for (int i = 0; i < n_groups; ++i) free(groups[i].points);\n    free(groups);\n    return 0;\n}\n",

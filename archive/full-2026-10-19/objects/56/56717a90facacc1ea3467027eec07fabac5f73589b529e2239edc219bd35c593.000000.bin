        "content": "#ifndef KNN_H\n#define KNN_H\n\n#include <stdio.h>\n#include <stdlib.h>\n#include <ctype.h>\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point *points;\n} Group;\n\nvoid on_error(void) {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nenum { KNN_INPUT_CAPACITY = 65536 };\nstatic unsigned char knn_input_buffer[KNN_INPUT_CAPACITY + 1];\nstatic size_t knn_input_position;\nstatic size_t knn_input_length;\n\nstatic int knn_input_peek(void) {\n    if (knn_input_position == knn_input_length) {\n        knn_input_length = fread(knn_input_buffer, 1, KNN_INPUT_CAPACITY, stdin);\n        knn_input_position = 0;\n        knn_input_buffer[knn_input_length] = 0;\n        if (knn_input_length == 0) return EOF;\n    }\n    return knn_input_buffer[knn_input_position];\n}\n\nstatic int knn_input_take(void) {\n    int c = knn_input_peek();\n    if (c != EOF) ++knn_input_position;\n    return c;\n}\n\nstatic void knn_skip_space(void) {\n    int c;\n    while ((c = knn_input_peek()) != EOF && isspace((unsigned char)c))\n        ++knn_input_position;\n}\n\nstatic void knn_literal(const char *literal) {\n    knn_skip_space();\n    while (*literal) {\n        if (knn_input_take() != (unsigned char)*literal) on_error();\n        ++literal;\n    }\n}\n\nstatic int knn_read_int(void) {\n    knn_skip_space();\n    int c = knn_input_peek();\n    int negative = 0;\n    if (c == '+' || c == '-') {\n        negative = c == '-';\n        ++knn_input_position;\n        c = knn_input_peek();\n    }\n    if (c < '0' || c > '9') on_error();\n    unsigned int limit = negative ? (unsigned int)INT_MAX + 1u : (unsigned int)INT_MAX;\n    unsigned int value = 0;\n    do {\n        unsigned int digit = (unsigned int)(c - '0');\n        if (value > (limit - digit) / 10u) on_error();\n        value = value * 10u + digit;\n        ++knn_input_position;\n        c = knn_input_peek();\n    } while (c >= '0' && c <= '9');\n    if (!negative) return (int)value;\n    return value == 0 ? 0 : -(int)(value - 1u) - 1;\n}\n\nstatic void knn_token_append(char **token, size_t *length, size_t *capacity,\n                             const unsigned char *source, size_t count) {\n    if (count > SIZE_MAX - *length - 1) on_error();\n    size_t required = *length + count + 1;\n    if (required > *capacity) {\n        size_t grown = *capacity ? *capacity : 128;\n        while (grown < required) {\n            if (grown > SIZE_MAX / 2) {\n                grown = required;\n                break;\n            }\n            grown *= 2;\n        }\n        char *replacement = (char *)realloc(*token, grown);\n        if (replacement == NULL) on_error();\n        *token = replacement;\n        *capacity = grown;\n    }\n    memcpy(*token + *length, source, count);\n    *length += count;\n    (*token)[*length] = 0;\n}\n\nstatic float knn_convert_float(char *text, size_t length) {\n    char *end;\n    float value = strtof(text, &end);\n    if (length == 0 || end != text + length) on_error();\n    return value;\n}\n\n/* Contiguous tokens are converted in place; only boundary tokens are copied. */\nstatic float knn_read_float(void) {\n    knn_skip_space();\n    if (knn_input_peek() == EOF) on_error();\n    char *token = NULL;\n    size_t length = 0, capacity = 0, nesting = 0;\n    for (;;) {\n        size_t begin = knn_input_position;\n        while (knn_input_position < knn_input_length) {\n            unsigned char c = knn_input_buffer[knn_input_position];\n            if (isspace(c) || c == ',' || (c == ')' && nesting == 0)) break;\n            if (c == '(') ++nesting;\n            else if (c == ')') --nesting;\n            ++knn_input_position;\n        }\n        size_t count = knn_input_position - begin;\n        if (knn_input_position < knn_input_length && token == NULL)\n            return knn_convert_float((char *)knn_input_buffer + begin, count);\n        knn_token_append(&token, &length, &capacity,\n                         knn_input_buffer + begin, count);\n        if (knn_input_position < knn_input_length || knn_input_peek() == EOF) {\n            float value = knn_convert_float(token, length);\n            free(token);\n            return value;\n        }\n    }\n}\n\nint parse_number_of_groups(void) {\n    knn_literal(\"n_groups=\");\n    return knn_read_int();\n}\n\nPoint parse_point(void) {\n    Point point;\n    knn_literal(\"(\");\n    point.x = knn_read_float();\n    knn_literal(\",\");\n    point.y = knn_read_float();\n    knn_literal(\")\");\n    return point;\n}\n\nGroup parse_next_group(void) {\n    knn_literal(\"label=\");\n    int label = knn_input_take();\n    if (label == EOF) on_error();\n    knn_literal(\"length=\");\n    int length = knn_read_int();\n    if (length < 0 || (size_t)length > SIZE_MAX / sizeof(Point)) on_error();\n    Group group;\n    group.label = (char)label;\n    group.length = length;\n    group.points = (Point *)malloc((size_t)length * sizeof(Point));\n    if (length > 0 && group.points == NULL) on_error();\n    for (int i = 0; i < length; ++i) group.points[i] = parse_point();\n    return group;\n}\n\nint parse_k(void) {\n    knn_literal(\"k=\");\n    return knn_read_int();\n}\n\nfloat euclidean_distance_no_sqrt(Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n    return *(const char *)a - *(const char *)b;\n}\n\n#endif\n",

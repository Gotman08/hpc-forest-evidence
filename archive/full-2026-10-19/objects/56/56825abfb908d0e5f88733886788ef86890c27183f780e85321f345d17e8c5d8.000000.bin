"""Preserve the current reviewed edition before admitting Sol MAX."""
import hashlib
import json
import shutil
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
STUDY = HERE.parents[1]
WORKSPACE = STUDY.parents[1]
VERSION = STUDY / "versions/20261017-avant-couverture-sol-max-professionnelle"


def sha(path):
    with path.open("rb") as f:
        return hashlib.file_digest(f, "sha256").hexdigest()


def main():
    assert not VERSION.exists()
    manifest = json.loads((STUDY / "edition-professionnelle/manifeste-edition.json").read_text(encoding="utf-8-sig"))
    files = set()
    for item in ("ARTICLE.md", "ARTICLE.html", "ARTICLE.pdf", "ANNEXES-TECHNIQUES.md", "ANNEXES-TECHNIQUES.html", "ANNEXES-TECHNIQUES.pdf", "construire-pdf.py", "donnees-consolidees.json"):
        files.add(STUDY / item)
    for directory in ("edition-professionnelle", "figures"):
        files.update(p for p in (STUDY / directory).rglob("*") if p.is_file())
    VERSION.mkdir(parents=True)
    saved = {}
    for source in sorted(files):
        assert not source.is_symlink()
        name = source.relative_to(STUDY).as_posix()
        target = VERSION / name
        target.parent.mkdir(parents=True, exist_ok=True)
        digest = sha(source)
        shutil.copy2(source, target)
        assert sha(target) == digest
        saved[name] = digest
    extras = {"ID.md": WORKSPACE / "ID.md", "automation-avant.toml": Path("C:/Users/nicol/.codex/automations/terminer-les-essais-deepseek-sur-romeo/automation.toml")}
    for name, path in extras.items():
        shutil.copy2(path, VERSION / name)
        assert sha(path) == sha(VERSION / name)
    proof = {"schema": "hpc-forest-professional-version-preservation-v1",
        "preserved_utc": datetime.now(UTC).isoformat(), "main_pages": 15, "supplement_pages": 182,
        "all_copied_bytes_verified": True, "copied_files": len(saved) + len(extras),
        "previous_manifest_sha256": sha(STUDY / "edition-professionnelle/manifeste-edition.json"),
        "previous_main_pdf_sha256": sha(STUDY / "ARTICLE.pdf"),
        "previous_supplement_pdf_sha256": sha(STUDY / "ANNEXES-TECHNIQUES.pdf"),
        "files": saved, "extra_snapshots": {name: sha(VERSION / name) for name in extras},
        "previous_manifest": manifest}
    (VERSION / "PRESERVATION.json").write_text(json.dumps(proof, ensure_ascii=True, indent=2) + "\n", encoding="utf-8")
    print(json.dumps({"preserved_files": len(saved) + len(extras), "version": str(VERSION)}))


if __name__ == "__main__":
    main()

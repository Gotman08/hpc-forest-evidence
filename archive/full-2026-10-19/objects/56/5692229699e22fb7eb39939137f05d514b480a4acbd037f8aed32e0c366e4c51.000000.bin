      "content": "#include \"knn.h\"\n#include <string.h>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nstatic inline int first_insert_slot(const float * distances, int filled, float d) {\n    int x = 0;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const float32x4_t candidate = vdupq_n_f32(d);\n\n    for (; filled - x >= 4; x += 4) {\n        const uint32x4_t matches =\n            vcltq_f32(candidate, vld1q_f32(distances + x));\n\n        if (vmaxvq_u32(matches) != 0) {\n            if (vgetq_lane_u32(matches, 0) != 0) return x;\n            if (vgetq_lane_u32(matches, 1) != 0) return x + 1;\n            if (vgetq_lane_u32(matches, 2) != 0) return x + 2;\n            return x + 3;\n        }\n    }\n#endif\n\n    for (; x < filled; x++) {\n        if (d < distances[x]) break;\n    }\n\n    return x;\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j;\n    int filled = 0;\n    int ordered = 1;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            /* This rejection is valid only while the populated list is ordered. */\n            if (filled == k && ordered && !(d < distances[k - 1])) {\n                continue;\n            }\n\n            int x = first_insert_slot(distances, filled, d);\n            if (x == k) continue;\n\n            int last = filled < k ? filled : k - 1;\n            size_t moving = (size_t) (last - x);\n\n            if (moving != 0) {\n                memmove(distances + x + 1, distances + x,\n                        moving * sizeof(*distances));\n                memmove(labels + x + 1, labels + x,\n                        moving * sizeof(*labels));\n            }\n\n            distances[x] = d;\n            labels[x] = g.label;\n            if (filled < k) filled++;\n\n            /* Preserve the reference's first-match behavior even with NaNs. */\n            if (d != d) ordered = 0;\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],

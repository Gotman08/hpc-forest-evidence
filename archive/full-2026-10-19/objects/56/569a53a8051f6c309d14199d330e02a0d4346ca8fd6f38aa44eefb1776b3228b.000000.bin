import os, socket, subprocess
import pytest

@pytest.fixture(autouse=True)
def no_real_native_effects(monkeypatch):
    def blocked(*args, **kwargs):
        raise AssertionError('Neutral qualification forbids real process/signal/socket effects')
    class NoNativePopen(subprocess.Popen):
        def __new__(cls, *args, **kwargs):
            raise AssertionError('Neutral qualification forbids process instantiation')
    monkeypatch.setattr(subprocess, 'Popen', NoNativePopen)
    for name in ('run', 'call', 'check_call', 'check_output'):
        monkeypatch.setattr(subprocess, name, blocked)
    for name in ('system', 'kill', 'killpg'):
        monkeypatch.setattr(os, name, blocked, raising=False)
    class NoNativeSocket(socket.socket):
        def __new__(cls, *args, **kwargs):
            raise AssertionError('Neutral qualification forbids socket instantiation')
    monkeypatch.setattr(socket, 'socket', NoNativeSocket)

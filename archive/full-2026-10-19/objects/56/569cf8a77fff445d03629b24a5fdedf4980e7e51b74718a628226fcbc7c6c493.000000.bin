      "content": "#include \"knn.h\"\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\nstatic char choose_label(const int * frequencies) {\n    char best_label = (char)-1;\n    int best_count = 0;\n\n    for (int value = CHAR_MIN; value <= CHAR_MAX; ++value) {\n        int count = frequencies[(unsigned char)(char)value];\n        if (count > best_count) {\n            best_count = count;\n            best_label = (char)value;\n        }\n    }\n\n    return best_label;\n}\n\nstatic char insertion_selection(int n_groups, Group * groups, int k,\n                                Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    for (int i = 0; i < k; ++i) {\n        labels[i] = (char)-1;\n        distances[i] = -1;\n    }\n\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n\n        for (int j = 0; j < g.length; ++j) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n            for (int x = 0; x < k; ++x) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (int y = k - 1; y > x; --y) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    int frequencies[UCHAR_MAX + 1] = {0};\n    for (int i = 0; i < k; ++i) {\n        ++frequencies[(unsigned char)labels[i]];\n    }\n\n    free(distances);\n    free(labels);\n    return choose_label(frequencies);\n}\n\nstatic void sift_down(uint64_t * heap, size_t count, size_t root) {\n    uint64_t value = heap[root];\n\n    while (root < count / 2) {\n        size_t child = root * 2 + 1;\n        if (child + 1 < count && heap[child] < heap[child + 1]) {\n            ++child;\n        }\n\n        if (value >= heap[child]) {\n            break;\n        }\n\n        heap[root] = heap[child];\n        root = child;\n    }\n\n    heap[root] = value;\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    if (k <= 0) {\n        return (char)-1;\n    }\n\n    size_t capacity = (size_t)k;\n    uint64_t * heap = (uint64_t *) malloc(sizeof(uint64_t) * capacity);\n    size_t used = 0;\n    int frequencies[UCHAR_MAX + 1] = {0};\n\n    if (heap == NULL) {\n        return insertion_selection(n_groups, groups, k, to_evaluate);\n    }\n\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n\n        for (int j = 0; j < g.length; ++j) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            uint32_t bits;\n            memcpy(&bits, &d, sizeof(bits));\n\n            if ((bits & UINT32_C(0x7fffffff)) > UINT32_C(0x7f800000)) {\n                free(heap);\n                return insertion_selection(n_groups, groups, k, to_evaluate);\n            }\n\n            if ((bits & UINT32_C(0x7fffffff)) == 0) {\n                bits = 0;\n            }\n\n            /* Equal distances prefer earlier groups; within-group ties\n               cannot change the label frequencies. */\n            uint64_t key = ((uint64_t)bits << 32) | (uint32_t)i;\n\n            if (used < capacity) {\n                heap[used++] = key;\n                ++frequencies[(unsigned char)g.label];\n\n                if (used == capacity) {\n                    for (size_t parent = used / 2; parent > 0; --parent) {\n                        sift_down(heap, used, parent - 1);\n                    }\n                }\n            } else if (key < heap[0]) {\n                uint32_t evicted_group = (uint32_t)heap[0];\n                --frequencies[(unsigned char)groups[evicted_group].label];\n                ++frequencies[(unsigned char)g.label];\n                heap[0] = key;\n                sift_down(heap, used, 0);\n            }\n        }\n    }\n\n    free(heap);\n\n    if (used < capacity) {\n        frequencies[(unsigned char)((char)-1)] += (int)(capacity - used);\n    }\n\n    return choose_label(frequencies);\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Packed distance/group heap keys permit online voting, eliminating the second point traversal in exchange for a larger contiguous heap.",

      "content": "#include <inttypes.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    uint32_t value;\n    uint32_t scale;\n} Fragment;\n\nstatic int read_fragment(uint32_t *value, uint32_t *scale)\n{\n    char token[50];\n    uint32_t v = 0;\n    uint32_t s = 1;\n    if (scanf(\"%49s\", token) != 1)\n        return 0;\n    for (size_t i = 0; token[i] != '\\0'; ++i) {\n        unsigned int digit = (unsigned int)(token[i] - '0');\n        if (digit > 9u || v > (UINT32_MAX - digit) / 10u)\n            return 0;\n        v = v * 10u + digit;\n        if (scale != NULL) {\n            if (s > UINT32_MAX / 10u)\n                return 0;\n            s *= 10u;\n        }\n    }\n    *value = v;\n    if (scale != NULL)\n        *scale = s;\n    return 1;\n}\n\nstatic uint32_t integer_sqrt(uint32_t value)\n{\n    uint32_t root = 0;\n    uint32_t bit = UINT32_C(1) << 30;\n    while (bit > value)\n        bit >>= 2;\n    while (bit != 0) {\n        if (value >= root + bit) {\n            value -= root + bit;\n            root = (root >> 1) + bit;\n        } else {\n            root >>= 1;\n        }\n        bit >>= 2;\n    }\n    return root;\n}\n\nstatic uint32_t inverse_odd(uint32_t p)\n{\n    /* An odd p is its own inverse modulo 8; four refinements reach 32 bits. */\n    uint32_t inverse = p;\n    inverse *= 2u - p * inverse;\n    inverse *= 2u - p * inverse;\n    inverse *= 2u - p * inverse;\n    inverse *= 2u - p * inverse;\n    return inverse;\n}\n\nstatic int compare_values(const void *a, const void *b)\n{\n    uint32_t x = *(const uint32_t *)a;\n    uint32_t y = *(const uint32_t *)b;\n    return (x > y) - (x < y);\n}\n\nint main(void)\n{\n    int num_primes = 0;\n    if (scanf(\"%d\", &num_primes) != 1 || num_primes < 1)\n        return 0;\n\n    size_t count = (size_t)num_primes;\n    if (count > SIZE_MAX / count || count > SIZE_MAX / sizeof(Fragment))\n        return 0;\n    size_t capacity = count * count;\n    if (capacity > SIZE_MAX / sizeof(uint32_t))\n        return 0;\n\n    uint32_t *left = malloc(count * sizeof(*left));\n    Fragment *right = malloc(count * sizeof(*right));\n    uint32_t *values = malloc(capacity * sizeof(*values));\n    unsigned char *composite = NULL;\n    if (left == NULL || right == NULL || values == NULL)\n        goto cleanup;\n\n    for (size_t i = 0; i < count; ++i) {\n        if (!read_fragment(&left[i], NULL))\n            goto cleanup;\n    }\n    for (size_t j = 0; j < count; ++j) {\n        if (!read_fragment(&right[j].value, &right[j].scale))\n            goto cleanup;\n    }\n\n    size_t active_count = 0;\n    uint32_t maximum = 0;\n    for (size_t i = 0; i < count; ++i) {\n        for (size_t j = 0; j < count; ++j) {\n            uint64_t joined = (uint64_t)left[i] * right[j].scale\n                            + right[j].value;\n            if (joined > UINT32_MAX)\n                goto cleanup;\n            uint32_t value = (uint32_t)joined;\n            if (value >= 2u && (value == 2u || (value & 1u) != 0)) {\n                values[active_count++] = value;\n                if (value > maximum)\n                    maximum = value;\n            }\n        }\n    }\n    free(left);\n    left = NULL;\n    free(right);\n    right = NULL;\n\n    uint32_t limit = integer_sqrt(maximum);\n    composite = calloc((size_t)(limit >> 1) + 1u, sizeof(*composite));\n    if (composite == NULL)\n        goto cleanup;\n    for (uint32_t p = 3u; (uint64_t)p * p <= limit; p += 2u) {\n        if (composite[p >> 1] == 0) {\n            for (uint32_t multiple = p * p; multiple <= limit;\n                 multiple += 2u * p)\n                composite[multiple >> 1] = 1;\n        }\n    }\n\n    /* Live candidates occupy the front; certified primes grow from the back. */\n    size_t result_begin = capacity;\n    for (uint32_t p = 3u; p <= limit && active_count != 0; p += 2u) {\n        if (composite[p >> 1] != 0)\n            continue;\n        uint32_t square = (uint32_t)((uint64_t)p * p);\n        uint32_t inverse = inverse_odd(p);\n        uint32_t cutoff = UINT32_MAX / p;\n        size_t i = 0;\n        while (i < active_count) {\n            uint32_t value = values[i];\n            if (value < square) {\n                values[i] = values[--active_count];\n                values[--result_begin] = value;\n            } else if ((uint32_t)(value * inverse) <= cutoff) {\n                /* The wrapped product test is exact for every uint32_t value. */\n                values[i] = values[--active_count];\n            } else {\n                ++i;\n            }\n        }\n    }\n\n    while (active_count != 0) {\n        uint32_t value = values[--active_count];\n        values[--result_begin] = value;\n    }\n    size_t result_count = capacity - result_begin;\n    if (result_count > 1)\n        qsort(values + result_begin, result_count, sizeof(*values), compare_values);\n    for (size_t i = result_begin; i < capacity; ++i)\n        printf(\"%\" PRIu32 \"\\n\", values[i]);\n\ncleanup:\n    free(composite);\n    free(values);\n    free(right);\n    free(left);\n    return 0;\n}\n",
      "path": "src/model-view/primetest.c"

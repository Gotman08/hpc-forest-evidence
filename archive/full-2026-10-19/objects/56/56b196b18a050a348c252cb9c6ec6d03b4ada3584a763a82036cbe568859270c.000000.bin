      "content": "#include <cstddef>\n#include <iostream>\n#include <utility>\n#include <vector>\n\nusing namespace std;\n\ntypedef vector<vector<unsigned char>> adjacency_matrix;\n\nadjacency_matrix readGraph();\nvector<int> computeDegrees(const adjacency_matrix &graph);\nbool sameDegreeMultiset(const vector<int> &degree1, const vector<int> &degree2);\nbool sameDegreesUnderPermutation(const vector<int> &degree1, const vector<int> &degree2,\n                                 const vector<int> &equivalence);\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence);\ninline void printPermutation(vector<int> &equivalence);\n\nint main() {\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if (!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2) {\n    if (g1.size() != g2.size()) return false;\n\n    vector<int> equivalence(g1.size(), 0);\n    for (size_t i = 0; i < equivalence.size(); ++i)\n        equivalence[i] = static_cast<int>(i);\n\n    if (verifyPermutation(g1, g2, equivalence)) {\n        printPermutation(equivalence);\n        return true;\n    }\n\n    const vector<int> degree1 = computeDegrees(g1);\n    const vector<int> degree2 = computeDegrees(g2);\n    if (!sameDegreeMultiset(degree1, degree2)) return false;\n\n    vector<int> exchange_counter(g1.size(), 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    /*\n     * Permutations are based on Heap's algorithm, which generates all possible\n     * permutations for a given set of elements.\n     */\n    while (exchange_index < static_cast<int>(g1.size())) {\n        if (exchange_counter[exchange_index] < exchange_index) {\n            if (exchange_index % 2 == 0)\n                swap(equivalence[0], equivalence[exchange_index]);\n            else\n                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\n\n            if (sameDegreesUnderPermutation(degree1, degree2, equivalence) &&\n                verifyPermutation(g1, g2, equivalence)) {\n                printPermutation(equivalence);\n                isomorphism_found = true;\n            }\n\n            exchange_counter[exchange_index]++;\n            exchange_index = 1;\n        } else {\n            exchange_counter[exchange_index] = 0;\n            exchange_index++;\n        }\n    }\n    return isomorphism_found;\n}\n\nadjacency_matrix readGraph() {\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read(vertices);\n    for (int i = 0; i < vertices; ++i)\n        read[i].resize(vertices);\n\n    cin >> edges;\n    for (int i = 0; i < edges; i++) {\n        cin >> source >> destination;\n        read[destination][source] = read[source][destination] = true;\n    }\n\n    return read;\n}\n\nvector<int> computeDegrees(const adjacency_matrix &graph) {\n    vector<int> degrees(graph.size(), 0);\n    for (size_t i = 0; i < graph.size(); ++i) {\n        const vector<unsigned char> &row = graph[i];\n        int degree = 0;\n        for (size_t j = 0; j < row.size(); ++j)\n            degree += row[j];\n        degrees[i] = degree;\n    }\n    return degrees;\n}\n\nbool sameDegreeMultiset(const vector<int> &degree1, const vector<int> &degree2) {\n    vector<int> balance(degree1.size() + 1, 0);\n    for (size_t i = 0; i < degree1.size(); ++i) {\n        ++balance[degree1[i]];\n        --balance[degree2[i]];\n    }\n    for (size_t degree = 0; degree < balance.size(); ++degree)\n        if (balance[degree] != 0) return false;\n    return true;\n}\n\nbool sameDegreesUnderPermutation(const vector<int> &degree1, const vector<int> &degree2,\n                                 const vector<int> &equivalence) {\n    for (size_t i = 0; i < equivalence.size(); ++i)\n        if (degree1[i] != degree2[static_cast<size_t>(equivalence[i])]) return false;\n    return true;\n}\n\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence) {\n    for (size_t i = 0; i < equivalence.size(); ++i) {\n        for (size_t j = 0; j <= i; ++j) {\n            if (g1[i][j] != g2[equivalence[i]][equivalence[j]]) return false;\n        }\n    }\n    return true;\n}\n\ninline void printPermutation(vector<int> &equivalence) {\n    for (auto i : equivalence)\n        cout << i << \" \";\n    cout << endl;\n}\n",
      "path": "src/brute_isomorphism.cpp"
    }

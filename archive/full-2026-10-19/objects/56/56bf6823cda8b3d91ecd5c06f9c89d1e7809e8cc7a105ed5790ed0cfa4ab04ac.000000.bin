      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <limits>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nint main() {\n    int n, s;\n    std::cin >> n >> s;\n    std::vector<std::vector<int> > matrix(n, std::vector<int>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            scanf(\"%d\", &(matrix[i][j]));\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const int windows = n - s + 1;\n    long long mxSum = std::numeric_limits<long long>::lowest();\n\n#ifdef _OPENMP\n#pragma omp parallel if(static_cast<long long>(n) * windows >= 262144LL && windows >= 4) reduction(max:mxSum)\n#endif\n    {\n        int thread = 0;\n        int team = 1;\n#ifdef _OPENMP\n        thread = omp_get_thread_num();\n        team = omp_get_num_threads();\n#endif\n        const int begin = static_cast<int>(static_cast<long long>(windows) * thread / team);\n        const int end = static_cast<int>(static_cast<long long>(windows) * (thread + 1) / team);\n\n        if (begin < end) {\n            std::vector<long long> columns(n, 0);\n            for (int row = begin; row < begin + s; ++row) {\n                const int* values = matrix[row].data();\n                for (int col = 0; col < n; ++col)\n                    columns[col] += values[col];\n            }\n\n            long long localMax = std::numeric_limits<long long>::lowest();\n            for (int top = begin; top < end; ++top) {\n                if (top > begin) {\n                    const int* exiting = matrix[top - 1].data();\n                    const int* entering = matrix[top + s - 1].data();\n                    for (int col = 0; col < n; ++col)\n                        columns[col] += static_cast<long long>(entering[col]) - exiting[col];\n                }\n\n                long long sum = 0;\n                for (int col = 0; col < s; ++col)\n                    sum += columns[col];\n                if (sum > localMax)\n                    localMax = sum;\n\n                for (int col = s; col < n; ++col) {\n                    sum += columns[col] - columns[col - s];\n                    if (sum > localMax)\n                        localMax = sum;\n                }\n            }\n            if (localMax > mxSum)\n                mxSum = localMax;\n        }\n    }\n\n    printf(\"%lld\\n\", mxSum);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Coarse contiguous row bands with private rolling column sums will reduce repeated work and expose four-core parallelism with only one final maximum reduction.",

    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <math.h>\\n#include <omp.h>\\n\\n#define N_ITER 10 // number of simulation iterations\\n#define DT 0.01f // time step\\n#define SOFTENING 1e-9f // to avoid zero divisors\\n\\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\\n\\n/*\\n * Compute the gravitational impact among all pairs of bodies in \\n * the system.  Uses a Structure-of-Arrays layout so that the outer\\n * loop over bodies can be vectorized across i (each body's inner j\\n * reduction remains scalar and preserves exact floating-point order).\\n */\\nvoid body_force(const int n, const float dt,\\n                float * restrict px, float * restrict py, float * restrict pz,\\n                float * restrict vx, float * restrict vy, float * restrict vz) {\\n  #pragma omp parallel\\n  {\\n    #pragma omp for simd schedule(static)\\n    for (int i = 0; i < n; ++i) {\\n      float fx = 0.0f;\\n      float fy = 0.0f;\\n      float fz = 0.0f;\\n\\n      const float xi = px[i];\\n      const float yi = py[i];\\n      const float zi = pz[i];\\n\\n      for (int j = 0; j < n; ++j) {\\n        float dx = px[j] - xi;\\n        float dy = py[j] - yi;\\n        float dz = pz[j] - zi;\\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n        float inv_dist = 1.0f / sqrt(sqrd_dist);\\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n\\n        fx += dx * inv_dist3;\\n        fy += dy * inv_dist3;\\n        fz += dz * inv_dist3;\\n      }\\n\\n      vx[i] += dt*fx;\\n      vy[i] += dt*fy;\\n      vz[i] += dt*fz;\\n    }\\n  }\\n}\\n\\n/*\\n * Read a binary dataset with initialized bodies.\\n */\\nBody* read_dataset(int *nbodies) {\\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading nbodie value\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading input values\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n\\n  return bodies;\\n}\\n\\n/*\\n * Write simulation results into a binary dataset.\\n */\\nvoid write_dataset(const int nbodies, Body *bodies) {\\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError writing to output\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n}\\n\\nint main(int argc,char **argv) {\\n  int nbodies;\\n\\n  Body *bodies = read_dataset(&nbodies);\\n\\n  /* Convert from Array-of-Structs to Struct-of-Arrays for better SIMD. */\\n  float *px = (float *)malloc(nbodies * sizeof(float));\\n  float *py = (float *)malloc(nbodies * sizeof(float));\\n  float *pz = (float *)malloc(nbodies * sizeof(float));\\n  float *vx = (float *)malloc(nbodies * sizeof(float));\\n  float *vy = (float *)malloc(nbodies * sizeof(float));\\n  float *vz = (float *)malloc(nbodies * sizeof(float));\\n\\n  for (int i = 0; i < nbodies; ++i) {\\n    px[i] = bodies[i].x;\\n    py[i] = bodies[i].y;\\n    pz[i] = bodies[i].z;\\n    vx[i] = bodies[i].vx;\\n    vy[i] = bodies[i].vy;\\n    vz[i] = bodies[i].vz;\\n  }\\n\\n  /*\\n   * At each simulation iteration, interbody forces are computed,\\n   * and bodies' positions are integrated.\\n   */\\n  for (int iter = 0; iter < N_ITER; ++iter) {\\n    body_force(nbodies, DT, px, py, pz, vx, vy, vz);\\n\\n    #pragma omp parallel\\n    {\\n      #pragma omp for simd schedule(static)\\n      for (int i = 0; i < nbodies; ++i) {\\n        px[i] += vx[i] * DT;\\n        py[i] += vy[i] * DT;\\n        pz[i] += vz[i] * DT;\\n      }\\n    }\\n  }\\n\\n  /* Convert back to the required Array-of-Structs output format. */\\n  Body *out = (Body *)malloc(nbodies * sizeof(Body));\\n  for (int i = 0; i < nbodies; ++i) {\\n    out[i].x = px[i];\\n    out[i].y = py[i];\\n    out[i].z = pz[i];\\n    out[i].vx = vx[i];\\n    out[i].vy = vy[i];\\n    out[i].vz = vz[i];\\n  }\\n\\n  write_dataset(nbodies, out);\\n\\n  free(px); free(py); free(pz); free(vx); free(vy); free(vz);\\n  free(out);\\n  free(bodies);\\n\\n  exit(EXIT_SUCCESS);\\n}\\n\",\n      \"path\": \"src/nbody.c\"\n    }\n  ],\n  \"hypothesis\": \"Converting the body data from Array-of-Structs to Struct-of-Arrays and using OpenMP's combined worksharing-SIMD construct on the outer force loop lets each thread process multiple bodies in SIMD lanes while keeping every body's inner j-reduction scalar. This preserves exact floating-point results (each lane performs identical operations) and adds data-level parallelism beyond the existing 4-thread speedup, improving performance further.\",\n  \"notes\": \"The transformation is legal because vectorization across i does not reorder arithmetic within any single body; each SIMD lane executes the same sequence of additions/multiplications as the scalar baseline. The SoA layout also improves cache behavior for the inner j loop by streaming separate contiguous arrays. No fast-math or reassociation flags are used, so output bytes remain bit-identical to the reference.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Changed internal data layout from Array-of-Structs (AoS) to Struct-of-Arrays (SoA) for positions and velocities\",\n    \"Replaced OpenMP parallel-for on outer body loop with combined worksharing-SIMD construct (#pragma omp for simd)\",\n    \"Hoisted per-body position loads out of the inner j loop\",\n    \"Applied the same SIMD worksharing to the position-update loop\"\n  ]\n}",

      "path": "src/bucketsort.c",
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <assert.h>\n#include <string.h>\n#include <omp.h>\n\n#define BUCKET_SIZE 1024\n\ntypedef struct {\n\tlong int *data;\n\tint length;\n\tlong int total;\n\tlong int capacity;\n} bucket;\n\nvoid sort(char *a, bucket *bucket) {\n\tint j, i, length;\n\tlong int key;\n\tlength = bucket->length;\n\n\tfor (j = 1; j < bucket->total; j++) {\n\t\tkey = bucket->data[j];\n\t\ti = j - 1;\n\t\twhile (i >= 0 && strcmp(a + bucket->data[i] * length, a + key * length) > 0) {\n\t\t\tbucket->data[i + 1] = bucket->data[i];\n\t\t\ti--;\n\t\t}\n\t\tbucket->data[i + 1] = key;\n\t}\n}\n\nlong int* bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\n\n\tlong int i;\n\tbucket   *buckets = NULL,\n\t\t\t *b = NULL;\n\tlong int *returns = NULL;\n\n\t// allocate memory\n\treturns = (long int *) malloc(sizeof(long int) * size);\n\tbuckets = (bucket   *) malloc(sizeof(bucket) * nbuckets);\n\n\tfor (i = 0; i < nbuckets; i++) {\n\t\tbuckets[i].data = (long int *) malloc(sizeof(long int) * BUCKET_SIZE);\n\t\tbuckets[i].length = length;\n\t\tbuckets[i].total = 0;\n\t\tbuckets[i].capacity = BUCKET_SIZE;\n\t}\n\n\t// copy the keys to \"buckets\"\n\tfor (i = 0; i < size; i++) {\n\t\tb = &buckets[*(a + i * length) - offset]; //mascara de deslocamento\n\t\tif (b->total >= b->capacity) {\n\t\t\tb->capacity *= 2;\n\t\t\tb->data = (long int *) realloc(b->data, sizeof(long int) * b->capacity);\n\t\t}\n\t\tb->data[b->total++] = i;\n\t}\n\n\t// sort each \"bucket\"\n\t#pragma omp parallel for\n\tfor (i = 0; i < nbuckets; i++)\n\t\tif (buckets[i].total > 0)\n\t\t\tsort(a, &buckets[i]);\n\n\t// Collect results\n\tlong int *result = (long int *) malloc(sizeof(long int) * size);\n\tlong int result_index = 0;\n\tfor (i = 0; i < nbuckets; i++) {\n\t\tfor (int j = 0; j < buckets[i].total; j++) {\n\t\t\tresult[result_index++] = buckets[i].data[j];\n\t\t}\n\t\tfree(buckets[i].data);\n\t}\n\tfree(buckets);\n\n\treturn result;\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb){\n\tchar *strings = NULL;\n\tint      len,\n\t\t\t offset,\n\t\t\t nbucket;\n\tlong int n;\n\n\tif (!fscanf(stdin, \"%d\", &len)) {\n\t\tprintf(\"ERROR len\\n\");\n\t\texit (1);\n\t}\n\n\tif (!fscanf(stdin, \"%ld\", &n)) {\n\t\tprintf(\"ERROR n\\n\");\n\t\texit (1);\n\t}\n\n\tif (!fscanf(stdin, \"%d\", &offset)) {\n\t\tprintf(\"ERROR offset\\n\");\n\t\texit (1);\n\t}\n\n\tif (!fscanf(stdin, \"%d\", &nbucket)) {\n\t\tprintf(\"ERROR nbucket\\n\");\n\t\texit (1);\n\t}\n\n\tnbucket = nbucket + 1;\n\tlen = len + 1;\n\n\tstrings = (char*) malloc(n * len);\n\n\tfor (int i = 0; i < n; i++){\n\t\tif (!fscanf(stdin, \"%s\", strings + (i * len))) {\n\t\t\tprintf(\"ERROR %d\\n\",i);\n\t\t\texit (1);\n\t\t}\n\t}\n\n\t*vString = strings;\n\t*N = n;\n\t*l = len;\n\t*os = offset;\n\t*nb = nbucket;\n}\n\nvoid print(char *strings, long int *index, long int n, int len){\n\n\tfor (int i = 0; i < n; i++){\n\t\tprintf(\"%d -> %s\\n\", i, strings + (index[i] * len));\n\t}\n}\n\nvoid save(char *strings, long int *index, long int n, int len){\n\tfor (int i = 0; i < n; i++){\n\t\tprintf(\"%s\\n\", strings + (index[i] * len));\n\t}\n}\n\nint main(int ac, char **av) {\n\n\tchar     *strings = NULL;\n\tlong int N        = 0;\n\tlong int *index   = NULL;\n\tint      len      = 0,\n\t\t\t save2File = 0,\n\t\t\t offset,\n\t\t\t nbuckets;\n\n\tload(&strings, &N, &len, &offset, &nbuckets);\n\n\tindex = bucket_sort(strings, len, N, offset, nbuckets);\n\n\tsave(strings, index, N, len);\n\n\tif (strings != NULL)\n\t\tfree(strings);\n\n\tif (index != NULL)\n\t\tfree(index);\n\n\treturn EXIT_SUCCESS;\n}"
    }

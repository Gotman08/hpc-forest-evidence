#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#ifdef __AVX2__
#include <immintrin.h>
#endif

int main() {
	int n,s;
	std::cin >> n >> s;
	std::vector<std::vector<int> > matrix(n, std::vector<int>(n));
	for(int i=0;i<n;i++)
		for(int j=0;j<n;j++) 
			scanf("%d", &(matrix[i][j]));

	assert(s<n);
	assert(n<8000);
	assert(s>0);
	assert(n>0);

	int sum = 0;
	for(int i=0;i<s;i++)
		for(int j=0;j<s;j++)
			sum += matrix[i][j];

	int mxSum = sum;

	int dir = 1;
	int i = 0;
	int j = 0;
	while(i+s <= n) {
		if( (j+s == n && dir==1) || (j==0 && dir==-1) ) { 
			int exitingRow = i;
			int enteringRow = exitingRow+s;
			if(enteringRow >=n) break;

#ifdef __AVX2__
			__m256i sumVec = _mm256_setzero_si256();
			for(int k=0;k<s;k+=8) {
				__m256i exitingVec = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(&matrix[exitingRow][k+j]));
				sumVec = _mm256_sub_epi32(sumVec, exitingVec);
			}
			for(int k=0;k<s;k+=8) {
				__m256i enteringVec = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(&matrix[enteringRow][k+j]));
				sumVec = _mm256_add_epi32(sumVec, enteringVec);
			}

			int tempSum[8] __attribute__((aligned(32)));
			_mm256_storeu_si256(reinterpret_cast<__m256i*>(tempSum), sumVec);
			sum = 0;
			for(int k=0;k<s && k<8;k++) {
				sum += tempSum[k];
			}
#else
			for(int k=0;k<s;k++) {
				sum += matrix[enteringRow][k+j] - matrix[exitingRow][k+j];
			}
#endif

			// Handle remaining elements if s is not a multiple of 8
			if(s % 8 != 0) {
				for(int k=(s/8)*8;k<s;k++) {
					sum += matrix[enteringRow][k+j] - matrix[exitingRow][k+j];
				}
			}

			i++;
			dir*=-1;
		} else {
			int exitingCol,enteringCol;
			if(dir==1) {
				exitingCol = j;
				enteringCol = exitingCol + s;
			} else {
				enteringCol = j-1;
				exitingCol = enteringCol + s;
			}

#ifdef __AVX2__
			__m256i sumVec = _mm256_setzero_si256();
			for(int k=0;k<s;k+=8) {
				__m256i exitingVec = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(&matrix[k+i][exitingCol]));
				sumVec = _mm256_sub_epi32(sumVec, exitingVec);
			}
			for(int k=0;k<s;k+=8) {
				__m256i enteringVec = _mm256_loadu_si256(reinterpret_cast<const __m256i*>(&matrix[k+i][enteringCol]));
				sumVec = _mm256_add_epi32(sumVec, enteringVec);
			}

			int tempSum[8] __attribute__((aligned(32)));
			_mm256_storeu_si256(reinterpret_cast<__m256i*>(tempSum), sumVec);
			sum = 0;
			for(int k=0;k<s && k<8;k++) {
				sum += tempSum[k];
			}
#else
			for(int k=0;k<s;k++) {
				sum += matrix[k+i][enteringCol] - matrix[k+i][exitingCol];
			}
#endif

			// Handle remaining elements if s is not a multiple of 8
			if(s % 8 != 0) {
				for(int k=(s/8)*8;k<s;k++) {
					sum += matrix[k+i][enteringCol] - matrix[k+i][exitingCol];
				}
			}

			j+=dir;
		}
		mxSum = std::max(mxSum,sum);
	}
	printf("%d\n",mxSum);
}
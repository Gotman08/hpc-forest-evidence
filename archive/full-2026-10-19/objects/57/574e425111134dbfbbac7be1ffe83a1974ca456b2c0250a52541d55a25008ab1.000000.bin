        "hypothesis": "Cooperatively seeding overlapping row bands through column-partitioned prefix scans should reduce duplicated initialization while retaining independent rolling scans and a single OpenMP maximum reduction.",
        "id": "69e8a257994d4eba",
        "ordinal": 2,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],

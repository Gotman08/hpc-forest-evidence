#include <algorithm>
#include <iostream>
#include <utility>
#include <vector>

using namespace std;

const long long MOD = 1000000007LL;

static long long modPow(long long base, long long exponent) {
    long long result = 1;
    while (exponent > 0) {
        if (exponent & 1LL) result = result * base % MOD;
        base = base * base % MOD;
        exponent >>= 1LL;
    }
    return result;
}

class Binomial {
public:
    explicit Binomial(int maxN) : fact(maxN + 1), invFact(maxN + 1) {
        fact[0] = 1;
        for (int i = 1; i <= maxN; ++i) fact[i] = fact[i - 1] * i % MOD;
        invFact[maxN] = modPow(fact[maxN], MOD - 2);
        for (int i = maxN; i > 0; --i) invFact[i - 1] = invFact[i] * i % MOD;
    }

    long long choose(int n, int k) const {
        if (k < 0 || k > n) return 0;
        return fact[n] * invFact[k] % MOD * invFact[n - k] % MOD;
    }

private:
    vector<long long> fact;
    vector<long long> invFact;
};

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) return 0;

    vector<pair<int, int> > obstacles;
    obstacles.reserve(m);
    for (int i = 0; i < m; ++i) {
        int row, col;
        cin >> row >> col;
        obstacles.push_back(make_pair(row, col));
    }

    sort(obstacles.begin(), obstacles.end());
    obstacles.erase(unique(obstacles.begin(), obstacles.end()), obstacles.end());

    if (!obstacles.empty() &&
        ((obstacles.front().first == 0 && obstacles.front().second == 0) ||
         (obstacles.back().first == n - 1 && obstacles.back().second == n - 1))) {
        cout << 0 << '\n';
        return 0;
    }

    // Use obstacle-pair work only while it is well below the dense grid scan.
    if (obstacles.size() <= static_cast<size_t>(n / 4)) {
        Binomial binomial(2 * n - 2);
        sort(obstacles.begin(), obstacles.end(),
             [](const pair<int, int>& left, const pair<int, int>& right) {
                 const int leftDiagonal = left.first + left.second;
                 const int rightDiagonal = right.first + right.second;
                 if (leftDiagonal != rightDiagonal) return leftDiagonal < rightDiagonal;
                 return left < right;
             });

        vector<long long> firstHit(obstacles.size(), 0);
        for (size_t i = 0; i < obstacles.size(); ++i) {
            const int row = obstacles[i].first;
            const int col = obstacles[i].second;
            long long ways = binomial.choose(row + col, row);

            for (size_t j = 0; j < i; ++j) {
                const int previousRow = obstacles[j].first;
                const int previousCol = obstacles[j].second;
                if (previousRow <= row && previousCol <= col) {
                    const int rowDelta = row - previousRow;
                    const int colDelta = col - previousCol;
                    const long long throughPrevious =
                        firstHit[j] * binomial.choose(rowDelta + colDelta, rowDelta) % MOD;
                    ways -= throughPrevious;
                    if (ways < 0) ways += MOD;
                }
            }
            firstHit[i] = ways;
        }

        long long answer = binomial.choose(2 * n - 2, n - 1);
        for (size_t i = 0; i < obstacles.size(); ++i) {
            const int remainingRows = n - 1 - obstacles[i].first;
            const int remainingCols = n - 1 - obstacles[i].second;
            const long long throughObstacle =
                firstHit[i] * binomial.choose(remainingRows + remainingCols, remainingRows) % MOD;
            answer -= throughObstacle;
            if (answer < 0) answer += MOD;
        }

        cout << answer << '\n';
        return 0;
    }

    // Dense fallback: one contiguous row holds the values from the previous row
    // and is updated in place from left to right.
    vector<int> dp(n, 0);
    size_t obstacleIndex = 0;
    for (int row = 0; row < n; ++row) {
        for (int col = 0; col < n; ++col) {
            if (obstacleIndex < obstacles.size() &&
                obstacles[obstacleIndex].first == row &&
                obstacles[obstacleIndex].second == col) {
                dp[col] = 0;
                ++obstacleIndex;
            } else if (row == 0 && col == 0) {
                dp[col] = 1;
            } else if (col > 0) {
                int value = dp[col] + dp[col - 1];
                if (value >= MOD) value -= MOD;
                dp[col] = value;
            }
        }
    }

    cout << dp[n - 1] << '\n';
    return 0;
}

    {
      "id": "f53138763e0d466d",
      "role": "A",
      "mission": {
        "base_commit": "8a62e28700805aeb9526a53a65238409617ffdfc",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Caching eight lexicographic bytes beside each token offset should reduce scattered string reads during radix passes and small-partition comparisons while replacing quadratic bucket sorting.",
        "id": "f53138763e0d466d",
        "ordinal": 2,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/bucketsort.c"
          ],
          "retained": [
            "Tokenize a contiguous input buffer in place and store offsets with portable big-endian eight-byte prefix keys.",
            "Use count/prefix/scatter MSD sorting with reusable scratch storage and actual bucket occupancies; compare cached keys first in small-partition insertion sorting.",
            "Skip common prefix chunks iteratively and tail-process the largest partition to bound recursion depth."
          ]
        },

        "depth": 1,
        "epoch": 1,
        "hypothesis": "Full-array strcmp mergesort should eliminate quadratic insertion costs and bucket-occupancy assumptions while exposing independent merge jobs and SIMD-safe initialization.",
        "id": "bb06a77f9fef4f41",
        "ordinal": 1,
        "parent_id": null,
        "role": "B",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/bucketsort.c"
          ],
          "retained": [
            "Replace bucket insertion sorting with stable bottom-up index mergesort using one reusable auxiliary array.",
            "Conditionally parallelize disjoint merge jobs above a 32768-record cutoff, retaining barriers between dependent passes.",
            "Vectorize independent index initialization when OpenMP SIMD is available; use non-overlapping memcpy for ordered runs and remaining tails, keeping dependent merge selection scalar.",
            "Use overflow-safe merge bounds and long-sized record-loop counters; release the unused index buffer."
          ]
        },
        "tree_id": "e1:B",

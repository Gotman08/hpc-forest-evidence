    {
      "id": "f29c62c661fc4b4f",
      "role": "A",
      "mission": {
        "base_commit": "8a62e28700805aeb9526a53a65238409617ffdfc",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Packed token storage and contiguous count/prefix/scatter MSD radix passes should improve locality and replace quadratic bucket insertion sorting while preserving strcmp ordering.",
        "id": "f29c62c661fc4b4f",
        "ordinal": 1,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/bucketsort.c"
          ],
          "retained": [
            "Store variable-length, NUL-terminated tokens in one growable arena, indexed by byte offsets.",
            "Replace equal-capacity buckets with unsigned-byte MSD radix partitions sized from actual counts and one reusable scatter array.",
            "Skip shared prefixes iteratively, stop at terminators, and use insertion sorting only for partitions of at most 32 records.",
            "Process the largest child iteratively and recurse only on smaller children to bound stack depth."
          ]
        },
        "tree_id": "e1:A",

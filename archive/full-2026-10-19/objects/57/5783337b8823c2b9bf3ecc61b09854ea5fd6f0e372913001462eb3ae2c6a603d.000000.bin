eturn best;\\n+}\\n+\\n+static char insertion_knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n+    char * labels = (char *)malloc((size_t)k * sizeof(*labels));\\n+    float * distances = (float *)malloc((size_t)k * sizeof(*distances));\\n+\\n+    if (labels == NULL || distances == NULL) {\\n+        free(labels);\\n+        free(distances);\\n+        on_error();\\n+        return (char)-1;\\n+    }\\n+\\n+    for (int i = 0; i < k; i++) {\\n+        labels[i] = (char)-1;\\n+        distances[i] = -1.0f;\\n+    }\\n+\\n+    for (int i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+        for (int j = 0; j < g.length; j++) {\\n+            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n+            for (int x = 0; x < k; x++) {\\n+                if (d < distances[x] || distances[x] == -1.0f) {\\n+                    for (int y = k - 1; y > x; y--) {\\n+                        distances[y] = distances[y - 1];\\n+                        labels[y] = labels[y - 1];\\n+                    }\\n+                    distances[x] = d;\\n+                    labels[x] = g.label;\\n+                    break;\\n+                }\\n+            }\\n+        }\\n+    }\\n+\\n+    size_t votes[UCHAR_MAX + 1] = {0};\\n+    for (int i = 0; i < k; i++) {\\n+        votes[(unsigned char)labels[i]]++;\\n+    }\\n+\\n+    char result = winning_label(votes);\\n+    free(distances);\\n+    free(labels);\\n+    return result;\\n+}\\n+\\n+static uint32_t select_distance_key(const uint32_t * keys, size_t count,\\n+                                    size_t rank, size_t * lower_count) {\\n+    uint32_t prefix = 0;\\n+    uint32_t mask = 0;\\n+    size_t skipped = 0;\\n+\\n+    for (int shift = 24; shift >= 0; shift -= 8) {\\n+        size_t buckets[256] = {0};\\n+        for (size_t i = 0; i < count; i++) {\\n+            uint32_t key = keys[i];\\n+            if ((key & mask) == prefix) {\\n+                buckets[(key >> shift) & UINT32_C
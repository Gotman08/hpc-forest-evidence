mask;\\n+}\\n+\\n+char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n+    char * labels = (char *) malloc(sizeof(char) * k);\\n+    float * distances = (float *) malloc(sizeof(float) * k);\\n+    enum { DISTANCE_BLOCK = 256 };\\n+    float block_distances[DISTANCE_BLOCK];\\n+\\n+    int i, j, x, y;\\n+\\n+    for (i = 0; i < k; i++) {\\n+        labels[i] = -1;\\n+        distances[i] = -1;\\n+    }\\n+\\n+    for (i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+\\n+        for (j = 0; j < g.length;) {\\n+            int count = g.length - j;\\n+            if (count > DISTANCE_BLOCK) count = DISTANCE_BLOCK;\\n+            const Point * restrict points = g.points + j;\\n+\\n+            /* Evaluate independent distances before the ordered top-k updates. */\\n+#if defined(_OPENMP)\\n+#pragma omp simd\\n+#endif\\n+            for (int lane = 0; lane < count; lane++) {\\n+                block_distances[lane] =\\n+                    euclidean_distance_no_sqrt(to_evaluate, points[lane]);\\n+            }\\n+\\n+            for (int first = 0; first < count; first += 16) {\\n+                int lanes = count - first;\\n+                if (lanes > 16) lanes = 16;\\n+                unsigned int candidates = knn_candidate_mask(\\n+                    block_distances + first, lanes, distances[k - 1]);\\n+\\n+                /* Visit surviving points in their original encounter order. */\\n+                while (candidates != 0) {\\n+                    int lane = first + (int)__builtin_ctz(candidates);\\n+                    candidates &= candidates - 1u;\\n+                    float d = block_distances[lane];\\n+\\n+                    /* Earlier survivors may have tightened the cutoff. */\\n+                    if (distances[k - 1] != -1 && d >= distances[k - 1]) {\\n+                        continue;\\n+                    }\\n+\\n+                    for (x = 0; x < k; x++) {\\n+                        if (d < distances[x] || distanc
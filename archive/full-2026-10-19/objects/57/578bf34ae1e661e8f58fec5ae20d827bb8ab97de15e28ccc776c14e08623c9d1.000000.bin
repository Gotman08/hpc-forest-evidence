      "content": "#include \"knn.h\"\n#include <string.h>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nstatic inline int first_insertion_position(const float * distances, int k, float d,\n                                           int ordered) {\n    int x = 0;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const float32x4_t candidate = vdupq_n_f32(d);\n    const float32x4_t empty = vdupq_n_f32(-1.0f);\n#endif\n\n    /* Without stored NaNs, matches form a suffix, including empty slots. */\n    if (ordered && k >= 64) {\n        int lo = 0;\n        int hi = k / 4;\n\n        /* Search block endpoints with conditional-select-friendly updates. */\n        while (lo < hi) {\n            int mid = lo + (hi - lo) / 2;\n            float last = distances[mid * 4 + 3];\n            int matches = (d < last) | (last == -1.0f);\n            hi = matches ? mid : hi;\n            lo = matches ? lo : mid + 1;\n        }\n        x = lo * 4;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n        if (x <= k - 4) {\n            const float32x4_t stored = vld1q_f32(distances + x);\n            const uint32x4_t matches = vorrq_u32(\n                vcltq_f32(candidate, stored), vceqq_f32(stored, empty));\n            const uint32x4_t positions = {0u, 1u, 2u, 3u};\n            const uint32x4_t first = vbslq_u32(\n                matches, positions, vdupq_n_u32(4u));\n\n            /* The selected full block is guaranteed to contain a match. */\n            return x + (int) vminvq_u32(first);\n        }\n#endif\n    }\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    /* Preserve the general first-match search for unordered distances. */\n    for (; x <= k - 4; x += 4) {\n        const float32x4_t stored = vld1q_f32(distances + x);\n        const uint32x4_t matches = vorrq_u32(\n            vcltq_f32(candidate, stored), vceqq_f32(stored, empty));\n        if (vmaxvq_u32(matches) != 0) {\n            break;\n        }\n    }\n#endif\n\n    for (; x < k; x++) {\n        if (d < distances[x] || distances[x] == -1) {\n            return x;\n        }\n    }\n    return k;\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n    int distances_ordered = 1;\n\n    int i, j;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            float farthest = distances[k - 1];\n\n            /* Equal distances retain their original encounter order. */\n            if (farthest != -1.0f && d >= farthest) {\n                continue;\n            }\n\n            int x = first_insertion_position(distances, k, d, distances_ordered);\n            if (x < k) {\n                size_t shifted = (size_t) (k - x - 1);\n\n                /* These shifts overlap; memmove preserves their dependencies. */\n                if (shifted != 0) {\n                    memmove(distances + x + 1, distances + x,\n                            shifted * sizeof(*distances));\n                    memmove(labels + x + 1, labels + x,\n                            shifted * sizeof(*labels));\n                }\n\n                distances[x] = d;\n                labels[x] = g.label;\n                if (d != d) {\n                    distances_ordered = 0;\n                }\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Binary-narrowing insertion searches to one four-slot block, then resolving its earliest match with NEON, should reduce selection latency for larger k without changing distance arithmetic or stable ties.",
  "notes": "Preserves overlapping memmove shifts, voting, and I/O. Uses the original search after any NaN insertion. Not executed.",

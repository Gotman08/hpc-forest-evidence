#include<stdio.h>
#include<stdlib.h>
#include<math.h>

enum { SORT_INSERTION_LIMIT = 32 };

void bubble_sort (double *matriz, int tam) {
    int i, j;
    double aux;

    for (i = tam - 1; i > 0; i--) {
        for (j = 0; j < i; j++) {
            if (matriz[j] > matriz[j+1]) {
                aux=matriz[j];
                matriz[j]=matriz[j+1];
                matriz[j+1]=aux;
            }
        }
    }
}

static void insertion_sort(double *matriz, size_t tam) {
    size_t i;
    for (i = 1; i < tam; ++i) {
        double value = matriz[i];
        size_t j = i;
        while (j > 0 && matriz[j-1] > value) {
            matriz[j] = matriz[j-1];
            --j;
        }
        matriz[j] = value;
    }
}

/* Both recursive children reuse the same half-column workspace. */
static void stable_merge_sort(double *matriz, double *scratch, size_t tam) {
    size_t middle, i, j, out;

    if (tam <= SORT_INSERTION_LIMIT) {
        insertion_sort(matriz, tam);
        return;
    }

    middle = tam / 2;
    stable_merge_sort(matriz, scratch, middle);
    stable_merge_sort(matriz + middle, scratch, tam - middle);

    if (!(matriz[middle-1] > matriz[middle])) {
        return;
    }

    for (i = 0; i < middle; ++i) {
        scratch[i] = matriz[i];
    }

    i = 0;
    j = middle;
    out = 0;
    while (i < middle && j < tam) {
        /* Taking the left element on equality preserves signed-zero order. */
        if (matriz[j] < scratch[i]) {
            matriz[out++] = matriz[j++];
        } else {
            matriz[out++] = scratch[i++];
        }
    }
    while (i < middle) {
        matriz[out++] = scratch[i++];
    }
    /* Any remaining right-hand elements are already in their final slots. */
}

void ordena_colunas(double *matriz,int lin, int col) {
    int i;
    double *scratch;
    size_t length;

    if (lin < 2 || col < 1) {
        return;
    }

    length = (size_t)lin;
    if (lin <= SORT_INSERTION_LIMIT) {
        for (i = 0; i < col; ++i) {
            insertion_sort(matriz + (size_t)i * length, length);
        }
        return;
    }

    scratch = (double *)malloc((length / 2) * sizeof(double));
    for (i = 0; i < col; ++i) {
        double *column = matriz + (size_t)i * length;
        size_t begin = 0;

        if (scratch == NULL) {
            bubble_sort(column, lin);
            continue;
        }

        /* Bubble sort cannot move a value across a NaN. Sort each segment
           independently and leave every NaN in its original position. */
        while (begin < length) {
            size_t end;
            if (column[begin] != column[begin]) {
                ++begin;
                continue;
            }
            end = begin + 1;
            while (end < length && column[end] == column[end]) {
                ++end;
            }
            stable_merge_sort(column + begin, scratch, end - begin);
            begin = end;
        }
    }
    free(scratch);
}

void calcula_media(double *matriz, double *vet,int lin, int col){
    int i,j;
    double soma;
    for(i=0;i<col;i++){
        soma=0;
        for(j=0;j<lin;j++){
            soma+=matriz[i*lin+j];
        }
        vet[i]=soma/lin;
    }
}

void calcula_media_harmonica(double *matriz, double *vet,int lin, int col){
    int i,j;
    double soma;
    for(i=0;i<col;i++){
        soma=0;
        for(j=0;j<lin;j++){
            soma+=(1/(matriz[i*lin+j]));
        }
        vet[i]=lin/soma;
    }
}

void calcula_mediana(double *matriz, double *vet, int lin, int col) {
     int i=0;
     if((lin-1)%2){ //Quantidade par de elementos
         for (i = 0; i < col; i++) {
            vet[i]=(matriz[(((i*lin)+(i+1)*lin)-1)/2]+matriz[((((i*lin)+(i+1)*lin)-1)/2)+1]);
            vet[i]*=0.5;

         }
     }
     else{ //Quantidade ímpar de elementos
         for (i = 0; i < col; i++) {
            vet[i]=matriz[(((i*lin)+(i+1)*lin)-1)/2];
         }
     }

 }

/* Defined zero-counter fallback for NaN-containing or unsorted arrays. */
static double moda_nao_ordenada(double *matriz, int lin) {
    int i, j;
    float conta = 0, moda = 0;

    for (i = 0; i < lin; ++i) {
        double count = 0;
        for (j = i + 1; j < lin; ++j) {
            if (matriz[i] == matriz[j]) {
                count += 1;
                if (count > conta) {
                    conta = (float)count;
                    moda = (float)matriz[i];
                }
            }
        }
    }
    return conta == 0 ? -1 : (double)moda;
}

//Adaptado de https://www.clubedohardware.com.br/forums/topic/1291570-programa-em-c-que-calcula-moda-media-e-mediana/
double moda_aux(double *matriz,int lin){
    int i;
    float conta = 0, moda = 0;

    /* NaNs can separate equal values after the barrier-preserving sort. */
    for (i = 0; i < lin; ++i) {
        if (matriz[i] != matriz[i] ||
            (i > 0 && matriz[i-1] > matriz[i])) {
            return moda_nao_ordenada(matriz, lin);
        }
    }

    i = 0;
    while (i < lin) {
        int end = i + 1;
        while (end < lin && matriz[i] == matriz[end]) {
            ++end;
        }

        /* Each suffix has exactly end-i-1 later matches. Process every
           suffix to retain strict float-counter updates even for long
           runs containing differently signed zeros. The original counter
           array was uninitialized; these counts use defined zero starts. */
        while (i < end) {
            double matches = (double)(end - i - 1);
            if (matches > conta) {
                conta = (float)matches;
                moda = (float)matriz[i];
            }
            ++i;
        }
    }
    return conta == 0 ? -1 : (double)moda;
}

void calcula_moda(double *matriz,double *moda,int lin, int col){
    int i;
    for(i=0;i<col;i++){
        moda[i]=moda_aux(matriz+(i*lin),lin);
    }
}

void calcula_variancia(double *matriz, double *media,double *variancia, int lin, int col){
    int i,j;
    double soma;
    for(i=0;i<col;i++){
        soma=0;
        for(j=0;j<lin;j++){
            soma+=pow((matriz[i*lin+j]-media[i]),2);
        }
        variancia[i]=soma/(lin-1);
    }
}

void calcula_desvio_padrao(double *variancia,double *dp, int col){
    int i;
    for(i=0;i<col;i++){
        dp[i]=sqrt(variancia[i]);
    }
}

void calcula_coeficiente_variacao(double *media,double *dp,double *cv, int col){
    int i;
    for(i=0;i<col;i++){
        cv[i]=dp[i]/media[i];
    }
}

int main(int argc,char **argv){
    int lin,col,i,j; // Define as variáveis de índices e dimensões
    double *matriz,*mediana,*media,*media_har,*moda,*variancia,*dp,*cv; // Define a matriz (forma linear), vetores de medidas estatísticas

    fscanf(stdin, "%d ", &lin); // Lê a quantidade de linhas da matriz
    fscanf(stdin, "%d\n", &col); // Lê a quantidade de colunas da matriz

    // Alocações
    matriz=(double *)malloc(lin*col * sizeof(double)); // Aloca a matriz
    media=(double *)malloc(col * sizeof(double)); // Aloca o vetor de media
    media_har=(double *)malloc(col * sizeof(double)); // Aloca o vetor de media harmônica
    mediana=(double *)malloc(col * sizeof(double)); // Aloca o vetor de mediana
    moda=(double *)malloc(col * sizeof(double)); // Aloca o vetor de moda
    variancia=(double *)malloc(col * sizeof(double)); // Aloca o vetor de variância
    cv=(double *)malloc(col * sizeof(double)); // Aloca o vetor de coeficiente de variação
    dp=(double *)malloc(col * sizeof(double)); // Aloca o vetor de desvio padrão


    for(i=0;i<lin;i++){
        for(j=0;j<col;j++){
            fscanf(stdin, "%lf ",&(matriz[j*lin+i])); // Lê os dados transpostos em uma matriz de entrada
        }
    }

    calcula_media(matriz,media,lin,col);
    calcula_media_harmonica(matriz,media_har,lin,col);
    ordena_colunas(matriz,lin,col);
    calcula_mediana(matriz,mediana,lin,col);
    calcula_moda(matriz,moda,lin,col);
    calcula_variancia(matriz,media,variancia,lin,col);
    calcula_desvio_padrao(variancia,dp,col);
    calcula_coeficiente_variacao(media,dp,cv,col);

    for(i=0;i<col;i++)
        printf("%.1lf ",media[i]); // Imprime as médias aritméticas de cada coluna
    printf("\n");
    for(i=0;i<col;i++)
        printf("%.1lf ",media_har[i]); // Imprime as médias harmônicas de cada coluna
    printf("\n");
    for(i=0;i<col;i++)
        printf("%.1lf ",mediana[i]); // Imprime as medianas de cada coluna
    printf("\n");
    for(i=0;i<col;i++)
        printf("%.1lf ",moda[i]); // Imprime as modas de cada coluna
    printf("\n");
    for(i=0;i<col;i++)
        printf("%.1lf ",variancia[i]); // Imprime as variâncias amostrais de cada coluna
    printf("\n");
    for(i=0;i<col;i++)
        printf("%.1lf ",dp[i]); // Imprime os desvios padrão de cada coluna
    printf("\n");
    for(i=0;i<col;i++)
        printf("%.1lf ",cv[i]); // Imprime os coeficientes de variação de cada coluna
    printf("\n");

    // Desaloca memória
    free(matriz);
    free(media);
    free(media_har);
    free(mediana);
    free(moda);
    free(variancia);
    free(dp);
    free(cv);
}

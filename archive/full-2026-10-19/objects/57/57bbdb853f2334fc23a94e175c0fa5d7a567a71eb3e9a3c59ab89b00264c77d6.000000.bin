      "content": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nstatic constexpr int MOD = 1000000007;\n\nstruct Point {\n    int row;\n    int col;\n\n    bool operator<(const Point& other) const {\n        if (row != other.row) return row < other.row;\n        return col < other.col;\n    }\n\n    bool operator==(const Point& other) const {\n        return row == other.row && col == other.col;\n    }\n};\n\nstatic int modPower(long long base, int exponent) {\n    long long result = 1;\n    while (exponent > 0) {\n        if (exponent & 1) result = result * base % MOD;\n        base = base * base % MOD;\n        exponent >>= 1;\n    }\n    return static_cast<int>(result);\n}\n\nstatic int choosePaths(int total, int take, const vector<int>& factorial,\n                       const vector<int>& inverseFactorial) {\n    if (take < 0 || take > total) return 0;\n    long long result = factorial[total];\n    result = result * inverseFactorial[take] % MOD;\n    result = result * inverseFactorial[total - take] % MOD;\n    return static_cast<int>(result);\n}\n\nstatic int countSparse(int n, const vector<Point>& blocked) {\n    const int maxDistance = 2 * (n - 1);\n    vector<int> factorial(maxDistance + 1, 1);\n    vector<int> inverseFactorial(maxDistance + 1, 1);\n\n    for (int i = 1; i <= maxDistance; ++i) {\n        factorial[i] = static_cast<long long>(factorial[i - 1]) * i % MOD;\n    }\n    inverseFactorial[maxDistance] = modPower(factorial[maxDistance], MOD - 2);\n    for (int i = maxDistance; i > 0; --i) {\n        inverseFactorial[i - 1] =\n            static_cast<long long>(inverseFactorial[i]) * i % MOD;\n    }\n\n    vector<int> firstHit(blocked.size(), 0);\n    for (size_t i = 0; i < blocked.size(); ++i) {\n        const Point& point = blocked[i];\n        long long count = choosePaths(point.row + point.col, point.row,\n                                      factorial, inverseFactorial);\n\n        // Row/column ordering places every coordinate-wise predecessor first.\n        for (size_t j = 0; j < i; ++j) {\n            const Point& previous = blocked[j];\n            if (previous.row <= point.row && previous.col <= point.col) {\n                const int dr = point.row - previous.row;\n                const int dc = point.col - previous.col;\n                const int between = choosePaths(dr + dc, dr, factorial,\n                                                inverseFactorial);\n                count -= static_cast<long long>(firstHit[j]) * between % MOD;\n                if (count < 0) count += MOD;\n            }\n        }\n        firstHit[i] = static_cast<int>(count);\n    }\n\n    const int destination = n - 1;\n    long long answer = choosePaths(2 * destination, destination,\n                                   factorial, inverseFactorial);\n    for (size_t i = 0; i < blocked.size(); ++i) {\n        const Point& point = blocked[i];\n        const int dr = destination - point.row;\n        const int dc = destination - point.col;\n        const int between = choosePaths(dr + dc, dr, factorial,\n                                        inverseFactorial);\n        answer -= static_cast<long long>(firstHit[i]) * between % MOD;\n        if (answer < 0) answer += MOD;\n    }\n    return static_cast<int>(answer);\n}\n\nstatic int countRolling(int n, const vector<Point>& blocked,\n                        const vector<size_t>& rowOffsets) {\n    vector<int> dp(n, 0);\n    dp[0] = 1;\n\n    for (int row = 0; row < n; ++row) {\n        int col = 0;\n        int running = 0;\n        size_t obstacle = rowOffsets[row];\n        const size_t obstacleEnd = rowOffsets[row + 1];\n\n        while (obstacle < obstacleEnd) {\n            const int blockedCol = blocked[obstacle].col;\n            while (col < blockedCol) {\n                int value = dp[col] + running;\n                if (value >= MOD) value -= MOD;\n                dp[col] = value;\n                running = value;\n                ++col;\n            }\n            dp[blockedCol] = 0;\n            running = 0;\n            col = blockedCol + 1;\n            ++obstacle;\n        }\n\n        while (col < n) {\n            int value = dp[col] + running;\n            if (value >= MOD) value -= MOD;\n            dp[col] = value;\n            running = value;\n            ++col;\n        }\n    }\n    return dp[n - 1];\n}\n\n#ifdef _OPENMP\nstatic constexpr int TILE = 64;\n\nstatic int countTiled(int n, const vector<Point>& blocked,\n                      const vector<size_t>& rowOffsets, int tileCount) {\n    vector<int> bottomCurrent(static_cast<size_t>(tileCount) * TILE, 0);\n    vector<int> bottomNext(static_cast<size_t>(tileCount) * TILE, 0);\n    vector<int> rightCurrent(static_cast<size_t>(tileCount) * TILE, 0);\n    vector<int> rightNext(static_cast<size_t>(tileCount) * TILE, 0);\n    int answer = 0;\n    const int lastDiagonal = 2 * tileCount - 2;\n\n#pragma omp parallel\n    {\n        vector<int> tileValues(TILE * TILE, 0);\n\n        for (int diagonal = 0; diagonal <= lastDiagonal; ++diagonal) {\n            const int firstTileRow = max(0, diagonal - (tileCount - 1));\n            const int lastTileRow = min(tileCount - 1, diagonal);\n\n#pragma omp for schedule(static)\n            for (int tileRow = firstTileRow; tileRow <= lastTileRow; ++tileRow) {\n                const int tileColumn = diagonal - tileRow;\n                const int rowStart = tileRow * TILE;\n                const int columnStart = tileColumn * TILE;\n                const int height = min(TILE, n - rowStart);\n                const int width = min(TILE, n - columnStart);\n\n                for (int localRow = 0; localRow < height; ++localRow) {\n                    const int globalRow = rowStart + localRow;\n                    const auto rowBegin = blocked.begin() +\n                        static_cast<vector<Point>::difference_type>(rowOffsets[globalRow]);\n                    const auto rowEnd = blocked.begin() +\n                        static_cast<vector<Point>::difference_type>(rowOffsets[globalRow + 1]);\n                    auto blockedIt = lower_bound(\n                        rowBegin, rowEnd, columnStart,\n                        [](const Point& point, int column) {\n                            return point.col < column;\n                        });\n\n                    for (int localColumn = 0; localColumn < width; ++localColumn) {\n                        const int globalColumn = columnStart + localColumn;\n                        const bool isBlocked = blockedIt != rowEnd &&\n                                               blockedIt->col == globalColumn;\n                        if (isBlocked) ++blockedIt;\n\n                        int value = 0;\n                        if (!isBlocked) {\n                            if (globalRow == 0 && globalColumn == 0) {\n                                value = 1;\n                            } else {\n                                int fromAbove = 0;\n                                int fromLeft = 0;\n                                if (localRow > 0) {\n                                    fromAbove = tileValues[\n                                        static_cast<size_t>(localRow - 1) * TILE + localColumn];\n                                } else if (tileRow > 0) {\n                                    fromAbove = bottomCurrent[\n                                        static_cast<size_t>(tileColumn) * TILE + localColumn];\n                                }\n                                if (localColumn > 0) {\n                                    fromLeft = tileValues[\n                                        static_cast<size_t>(localRow) * TILE + localColumn - 1];\n                                } else if (tileColumn > 0) {\n                                    fromLeft = rightCurrent[\n                                        static_cast<size_t>(tileRow) * TILE + localRow];\n                                }\n                                value = fromAbove + fromLeft;\n                                if (value >= MOD) value -= MOD;\n                            }\n                        }\n                        tileValues[static_cast<size_t>(localRow) * TILE + localColumn] = value;\n                    }\n                }\n\n                for (int localColumn = 0; localColumn < width; ++localColumn) {\n                    bottomNext[static_cast<size_t>(tileColumn) * TILE + localColumn] =\n                        tileValues[static_cast<size_t>(height - 1) * TILE + localColumn];\n                }\n                for (int localRow = 0; localRow < height; ++localRow) {\n                    rightNext[static_cast<size_t>(tileRow) * TILE + localRow] =\n                        tileValues[static_cast<size_t>(localRow) * TILE + width - 1];\n                }\n\n                if (tileRow == tileCount - 1 && tileColumn == tileCount - 1) {\n                    answer = tileValues[static_cast<size_t>(height - 1) * TILE + width - 1];\n                }\n            }\n\n#pragma omp single\n            {\n                bottomCurrent.swap(bottomNext);\n                rightCurrent.swap(rightNext);\n            }\n        }\n    }\n    return answer;\n}\n#endif\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<Point> blocked;\n    blocked.reserve(static_cast<size_t>(m));\n    bool blockedStart = false;\n    bool blockedEnd = false;\n    for (int i = 0; i < m; ++i) {\n        int row, col;\n        cin >> row >> col;\n        blocked.push_back({row, col});\n        if (row == 0 && col == 0) blockedStart = true;\n        if (row == n - 1 && col == n - 1) blockedEnd = true;\n    }\n\n    if (blockedStart || blockedEnd) {\n        cout << 0 << '\\n';\n        return 0;\n    }\n\n    sort(blocked.begin(), blocked.end());\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\n\n    // Pairwise obstacle work remains a small fraction of the grid work here.\n    if (static_cast<long long>(blocked.size()) * 16 <= n) {\n        cout << countSparse(n, blocked) << '\\n';\n        return 0;\n    }\n\n    vector<size_t> rowOffsets(static_cast<size_t>(n) + 1, 0);\n    for (const Point& point : blocked) ++rowOffsets[point.row + 1];\n    for (int row = 1; row <= n; ++row) {\n        rowOffsets[row] += rowOffsets[row - 1];\n    }\n\n    int answer;\n#ifdef _OPENMP\n    const int tileCount = (n + TILE - 1) / TILE;\n    if (tileCount >= 32) {\n        answer = countTiled(n, blocked, rowOffsets, tileCount);\n    } else {\n        answer = countRolling(n, blocked, rowOffsets);\n    }\n#else\n    answer = countRolling(n, blocked, rowOffsets);\n#endif\n\n    cout << answer << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "A workload-aware combination should outperform the baseline across obstacle densities: factorial-based first-hit counting avoids scanning the grid when obstacles are very sparse, while a tiled OpenMP wavefront handles large dense grids; smaller grids and non-OpenMP builds retain a compact rolling-row DP.",
  "notes": "The implementation deduplicates coordinates and handles blocked endpoints before selecting a path. No commands or tests were run; correctness and speed are for controller evaluation.",

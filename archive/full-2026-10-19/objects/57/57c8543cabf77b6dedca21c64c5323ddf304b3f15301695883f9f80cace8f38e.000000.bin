set -euo pipefail
archive=/scratch_p/nimarano/marathon22-gpt61sol-max-pilot-20261015-r1.tar.gz
root=/scratch_p/nimarano/hpc-forest-gpt61sol-max-pilot-20261015-r1
py=/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python
test ! -e "$root"
printf '%s  %s\n' '42de4f41804356b40f3314a9a57e19f1d274a7df71cb7a482347af9e04600218' "$archive" | sha256sum -c -
mkdir "$root"
tar -xzf "$archive" --strip-components=1 -C "$root"
"$py" - "$root" <<'PY'
import hashlib,json,shutil,sys,zipfile
from pathlib import Path
root=Path(sys.argv[1])
old=Path('/scratch_p/nimarano/hpc-forest-marathon22-20261015-r1')
shutil.copytree(old/'sources-officielles',root/'sources-officielles')
manifest=json.loads((root/'payload-manifest.json').read_text())
for name,expected in manifest.items():
    p=root/name
    assert p.resolve().is_relative_to(root.resolve()) and hashlib.sha256(p.read_bytes()).hexdigest()==expected, name
wheel=next((root/'payload-r4').glob('*.whl'))
with zipfile.ZipFile(wheel) as z:
    for name in z.namelist():
        assert (root/'runtime'/name).resolve().is_relative_to((root/'runtime').resolve())
    z.extractall(root/'runtime')
print('Execution payload verified:',len(manifest),'files',flush=True)
PY
PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$root/runtime:$root/qa-deps" flock -w 120 /tmp/hpc-forest-preflight-nimarano.lock "$py" -m pytest "$root/tests" -q -p no:cacheprovider > "$root/preflight-tests.log" 2>&1
cat "$root/preflight-tests.log"
PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$root/runtime" "$py" "$root/timer_probe.py" "$root/timer-probe.json"
export PYTHONPATH="$root/runtime"
export PYTHONDONTWRITEBYTECODE=1
exec "$py" "$root/romeo_codex.py" --root "$root" --session-id c43035f2c991479c811228cc4db0a141 --problems knn --cycles 2 --trials-per-role 3 --integrations-per-cycle 3 --wall-seconds 7200 --tokens 1500000 --worker-wait-seconds 600

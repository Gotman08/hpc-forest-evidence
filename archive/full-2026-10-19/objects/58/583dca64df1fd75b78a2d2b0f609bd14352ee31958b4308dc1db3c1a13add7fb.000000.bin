 0; i < numPrimes; ++i) {\\n+        if (!read_fragment(&firstHalf[i]))\\n+            return 1;\\n+    }\\n+    for (i = 0; i < numPrimes; ++i) {\\n+        if (!read_fragment(&secondHalf[i]))\\n+            return 1;\\n+    }\\n+\\n+    resultCapacity = (size_t)numPrimes * (size_t)numPrimes;\\n+    result = malloc(resultCapacity * sizeof(*result));\\n+    if (result == NULL)\\n+        return 1;\\n+\\n+    for (int iBase = 0; iBase < numPrimes; iBase += BLOCK_SIZE) {\\n+        int iLimit = iBase + BLOCK_SIZE;\\n+        if (iLimit > numPrimes)\\n+            iLimit = numPrimes;\\n+\\n+        for (int jBase = 0; jBase < numPrimes; jBase += BLOCK_SIZE) {\\n+            int jLimit = jBase + BLOCK_SIZE;\\n+            if (jLimit > numPrimes)\\n+                jLimit = numPrimes;\\n+\\n+            for (i = iBase; i < iLimit; ++i) {\\n+                long prefix = firstHalf[i].value;\\n+                for (j = jBase; j < jLimit; ++j) {\\n+                    long candidate = prefix * secondHalf[j].scale + secondHalf[j].value;\\n+                    if (isprime(candidate))\\n+                        result[numResults++] = candidate;\\n+                }\\n+            }\\n+        }\\n+    }\\n+\\n+    qsort(result, (size_t)numResults, sizeof(*result), compare_long);\\n+    for (i = 0; i < numResults; ++i)\\n+        printf(\\\"%ld\\\\n\\\", result[i]);\\n+\\n+    free(result);\\n+    return 0;\\n+}\\ndiff --git a/src/sources/primetest.c b/src/sources/primetest.c\\nindex fbc86e2..388695f 100644\\n--- a/src/sources/primetest.c\\n+++ b/src/sources/primetest.c\\n@@ -1,80 +1,110 @@\\n-#include <stdio.h>\\n-#include <stdlib.h>\\n-#include <math.h>\\n-#include <string.h>\\n-\\n-#define MAXNUM 100\\n-#define MAXSTR 50\\n-#define MAXRESULTS 1000\\n-\\n-char firstHalf[MAXNUM][MAXSTR];\\n-char secondHalf[MAXNUM][MAXSTR];\\n-char strToTest[MAXSTR];\\n-long int result[MAXRESULTS];\\n-int numPrimes=0;\\n-\\n-int isprime(long int value)\\n-{ long int root;\\n-  long int factor=2
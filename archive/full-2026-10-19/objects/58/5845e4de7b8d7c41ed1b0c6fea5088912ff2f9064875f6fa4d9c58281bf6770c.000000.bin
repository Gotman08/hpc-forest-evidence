from datetime import UTC, datetime
import hashlib
import json
from pathlib import Path
import re

BASE = Path(r'C:\Users\nicol\Documents\Codex\2026-10-15\cr')
OPS = BASE / 'outputs/HPC-Forest-Primes-Natif-Relance-r2g/operations-parent'
guide = BASE / 'outputs/HPC-Forest-Harnais-Comparaison-r1/SUIVI-COMPACT.md'
ids = BASE / 'ID.md'
backup = OPS / 'avant-metadonnees-recues-20261018T1617'
backup.mkdir(exist_ok=False)
manifest = {}
for path in (guide, ids):
    raw = path.read_bytes()
    with (backup / path.name).open('xb') as stream:
        stream.write(raw)
    assert (backup / path.name).read_bytes() == raw
    manifest[path.name] = {'sha256_before': hashlib.sha256(raw).hexdigest()}
text = guide.read_text('utf8')
text = re.sub(r'\A(# HPC-Forest[^\n]*\n\n)État du [^.]+\.',
              r'\g<1>État du 18 octobre 2026, 16:17 UTC.', text, count=1)
old_start = text.index('Réception finale/audit privé/réconciliation EN COURS :')
old_end = text.index('\n\n', old_start)
text = text[:old_start] + '''MÉTADONNÉES FINALES REÇUES ET AUDITÉES : collecte froide effective7dfd1862… sous Relance-r2g/collecte-finale-pure-r2/execution-reelle-par-etapes-01 ; trois rapports privés metadata-terminal-r1/companion/audit-metadata-reel-JOB-01.json et trois réconciliations vérifiés. Revue indépendante RÉELLE d9387765… : 10 invocations/livraisons, 7 invocations exactes totalisant146676jetons connus et 3 invocations expirées non mesurées, aucun total exact de consommation ; les réservations196608 ne sont pas de la consommation. Les sept appels propres reçus n'ont aucun événement outil observé dans ces frontières. Aucune admission scientifique, de performance ou d'isolation générale.

Les trois audits natifs complets en lecture seule sont CONSERVÉS avec code1, raison « Unknown native claims/costs block complete audit », inventaires avant/après identiques. Pipeline et cinq confirmations absents. Les premières preuves de démarrage/poursuite restent closes et inchangées. Aucun appel expiré n'est rejoué.

Clôture et préservation finale encore EN COURS : les trois relais restent comptés jusqu'au reçu de clôture individuel et aux locks conservés après absence. Aucune terminaison encore effectuée. Préparation fermeture-relais-r2g-r2/53028d9e… revue préparation seule b7724b2f… ; pins finaux NON_ADMIS. Graphe21 contexte exact ne vaut jamais autorisation d'arrêt. Stat-only/read_attempted=false/read_errno=null, aucun lock lu. Premiers refus collecteur (descendants puis CIM périmé après deux copies) préservés ; orchestration par étapes renouvelant réellement le CIM avant/après chaque cellule reçue, sans augmenter45s. Ne pas repoller les trois jobs terminaux.''' + text[old_end:]
text = text.replace('sept usages exacts déclarés et trois usages non mesurés/réservations, aucun total de consommation revendiqué avant audit des bruts',
                    'sept usages exacts désormais audités (146676jetons connus) et trois usages non mesurés, aucun total exact de consommation')
text = text.replace('Revue source indépendante, nouveaux adaptateurs et Q ARM exacte ENCORE REQUIS',
                    'Revue source indépendante reçue58a08df4… (source/préparation seulement) ; nouveaux adaptateurs et Q ARM exacte ENCORE REQUIS')
text = text.replace('Six fichiers modifiés/cinq nouveaux/99 anciens identiques, 187 cas neutres distincts passent avec premiers refus de fixtures conservés.',
                    'Six fichiers modifiés/cinq nouveaux/99 anciens identiques ;187 cas neutres distincts reçus (152nouveaux+26lane+9prédicats), premiers refus de fixtures et première décomposition documentaire erronée conservés. Q source-only033a4625…/propositionddaf6cc8… NON_LANCÉE/NON_ADMISE ; port externe concret en préparation sous adaptateurs-source110-r1/revision-r2-integration.')
guide.write_text(text, encoding='utf8', newline='\n')
raw = ids.read_bytes()
old_ids = set(re.findall(rb'\bID-(\d{3})\b', raw))
assert len(old_ids) == 40
old_note = re.search('État terminal technique18octobre[^\r\n]+'.encode(), raw)
assert old_note
new_note = ('État technique18octobre16:17UTC : R2g trois FAILED reçus et métadonnées privées auditées/réconciliées (10invocations,146676jetons exacts connus sur7,3nonmesurées). '
            'Audit natif complet refusé pour coûts inconnus ; cinq confirmations absentes, aucun gain nouveau. Clôture possédée encore en cours, trois relais comptés, aucun rejeu/arrêt/admission scientifique. '
            'Source R3 indépendante revue pour préparation seulement ; adaptateurs/Qexacte encore requis. Voir SUIVI-COMPACT.md ; quarante ID préservés.').encode()
ids.write_bytes(raw[:old_note.start()] + new_note + raw[old_note.end():])
assert set(re.findall(rb'\bID-(\d{3})\b', ids.read_bytes())) == old_ids
for path in (guide, ids):
    manifest[path.name]['sha256_after'] = hashlib.sha256(path.read_bytes()).hexdigest()
manifest.update(recorded_at=datetime.now(UTC).isoformat(), all_forty_ID_preserved=True,
                scientific_admission_added=False, process_stop_performed=False)
with (backup / 'PRESERVATION-ET-SUIVI.json').open('x', encoding='utf8') as stream:
    json.dump(manifest, stream, indent=2)
print(json.dumps(manifest))

--- r1/collect_parent_observations.py
+++ r2/collect_parent_observations.py
@@ -131,6 +131,14 @@
     output = root + "/results-" + cell["job_id"]
     return {base + suffix for base in (root + "/registry.sqlite3", output + "/registry.sqlite3")
             for suffix in ("", "-wal", "-shm")} | {output + "/mailbox/worker-ready.json"}
+
+
+def proof_path_aliases(expected, cell):
+    root = "/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-" + cell["session_id"]
+    need(cell["remote_root"] == root and isinstance(cell["job_id"], str) and cell["job_id"].isdigit(), "exact_owned_proof_cell_required")
+    output = root + "/results-" + cell["job_id"]
+    need(expected in {output + "/mailbox/OWNER.json", output + "/request-prepared.json"}, "only_owner_request_proof_aliases_allowed")
+    return {expected, expected.replace("/scratch_p/nimarano/", "/gpfs/scratch/nimarano/", 1)}
 
 

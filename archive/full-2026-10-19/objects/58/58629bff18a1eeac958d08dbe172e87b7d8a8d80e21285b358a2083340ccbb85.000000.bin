        "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\nstatic const int MOD = 1000000007;\n\nstatic int count_serial(const vector<vector<bool> >& blocked, int n) {\n    vector<int> row(n, 0);\n    row[0] = 1;\n    for (int i = 0; i < n; ++i) {\n        int left = 0;\n        const vector<bool>& obstacles = blocked[i];\n        for (int j = 0; j < n; ++j) {\n            int value = row[j] + left;\n            if (value >= MOD) value -= MOD;\n            if (obstacles[j]) value = 0;\n            row[j] = value;\n            left = value;\n        }\n    }\n    return row[n - 1];\n}\n\n#ifdef _OPENMP\nstatic int count_tiled(const vector<vector<bool> >& blocked, int n) {\n    const int tile_size = 128;\n    const int tiles = (n + tile_size - 1) / tile_size;\n\n    // Each column segment holds its latest tile's bottom boundary.\n    // Each row segment holds its latest tile's right boundary.\n    vector<int> bottom(n, 0);\n    vector<int> right(n, 0);\n    bottom[0] = 1;\n\n    #pragma omp parallel\n    {\n        vector<int> row(tile_size);\n        for (int diagonal = 0; diagonal < 2 * tiles - 1; ++diagonal) {\n            const int first = max(0, diagonal - tiles + 1);\n            const int last = min(tiles - 1, diagonal);\n\n            #pragma omp for schedule(static)\n            for (int tile_row = first; tile_row <= last; ++tile_row) {\n                const int tile_col = diagonal - tile_row;\n                const int row_begin = tile_row * tile_size;\n                const int row_end = min(n, row_begin + tile_size);\n                const int col_begin = tile_col * tile_size;\n                const int width = min(tile_size, n - col_begin);\n\n                copy(bottom.begin() + col_begin,\n                     bottom.begin() + col_begin + width, row.begin());\n\n                for (int i = row_begin; i < row_end; ++i) {\n                    const vector<bool>& obstacles = blocked[i];\n                    int left = right[i];\n                    for (int j = 0; j < width; ++j) {\n                        int value = row[j] + left;\n                        if (value >= MOD) value -= MOD;\n                        if (obstacles[col_begin + j]) value = 0;\n                        row[j] = value;\n                        left = value;\n                    }\n                    right[i] = left;\n                }\n\n                copy(row.begin(), row.begin() + width,\n                     bottom.begin() + col_begin);\n            }\n            // The implicit barrier publishes both boundaries before\n            // any dependent tile on the next diagonal can read them.\n        }\n    }\n    return bottom[n - 1];\n}\n#endif\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n    vector<vector<bool> > blocked(n, vector<bool>(n, false));\n    for (int c = 0; c < m; ++c) {\n        int i, j;\n        cin >> i >> j;\n        blocked[i][j] = true;\n    }\n\n    int answer;\n#ifdef _OPENMP\n    if (n >= 1024 && omp_get_max_threads() > 1) {\n        answer = count_tiled(blocked, n);\n    } else\n#endif\n    {\n        answer = count_serial(blocked, n);\n    }\n    cout << answer << '\\n';\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }

ties.\\n      #pragma omp for schedule(static)\\n      for (int i = 0; i < nbodies; ++i) {\\n        float xi = x[i];\\n        float yi = y[i];\\n        float zi = z[i];\\n        float fx = 0.0f;\\n        float fy = 0.0f;\\n        float fz = 0.0f;\\n\\n        int j = 0;\\n        // Manual unroll by 4, preserving exact per-j accumulation order.\\n        for (; j + 3 < nbodies; j += 4) {\\n          float dx0 = x[j] - xi;\\n          float dy0 = y[j] - yi;\\n          float dz0 = z[j] - zi;\\n          float d0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\\n          float inv0 = 1 / sqrt(d0);\\n          float inv30 = inv0 * inv0 * inv0;\\n          fx += dx0 * inv30;\\n          fy += dy0 * inv30;\\n          fz += dz0 * inv30;\\n\\n          float dx1 = x[j+1] - xi;\\n          float dy1 = y[j+1] - yi;\\n          float dz1 = z[j+1] - zi;\\n          float d1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\\n          float inv1 = 1 / sqrt(d1);\\n          float inv31 = inv1 * inv1 * inv1;\\n          fx += dx1 * inv31;\\n          fy += dy1 * inv31;\\n          fz += dz1 * inv31;\\n\\n          float dx2 = x[j+2] - xi;\\n          float dy2 = y[j+2] - yi;\\n          float dz2 = z[j+2] - zi;\\n          float d2 = dx2*dx2 + dy2*dy2 + dz2*dz2 + SOFTENING;\\n          float inv2 = 1 / sqrt(d2);\\n          float inv32 = inv2 * inv2 * inv2;\\n          fx += dx2 * inv32;\\n          fy += dy2 * inv32;\\n          fz += dz2 * inv32;\\n\\n          float dx3 = x[j+3] - xi;\\n          float dy3 = y[j+3] - yi;\\n          float dz3 = z[j+3] - zi;\\n          float d3 = dx3*dx3 + dy3*dy3 + dz3*dz3 + SOFTENING;\\n          float inv3 = 1 / sqrt(d3);\\n          float inv33 = inv3 * inv3 * inv3;\\n          fx += dx3 * inv33;\\n          fy += dy3 * inv33;\\n          fz += dz3 * inv33;\\n        }\\n        for (; j < nbodies; ++j) {\\n          float dx = x[j] - xi;\\n          float dy = y[j] - yi;\\n          float dz = z[j] - zi;\\n          float sqrd_dist = dx*dx +
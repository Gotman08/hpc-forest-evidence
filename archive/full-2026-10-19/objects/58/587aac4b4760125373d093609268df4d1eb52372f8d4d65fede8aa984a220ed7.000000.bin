"""Preserve and refresh the operational guides; leave the scientific edition unchanged."""
import hashlib
import json
import shutil
import tomllib
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
COMPARE = ROOT.parent / "HPC-Forest-Harnais-Comparaison-r1"
AUTOMATION = Path("C:/Users/nicol/.codex/automations/terminer-les-essais-deepseek-sur-romeo/automation.toml")


def read(path):
    return json.loads(path.read_text(encoding="utf-8-sig"))


def sha(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def save(path, data):
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def descriptor(path):
    return {"path": str(path), "sha256": sha(path)}


def main():
    backup = HERE / "guides-avant"
    assert not backup.exists(), "Do not overwrite the pre-recovery guide snapshots."
    backup.mkdir()
    old_manifest = read(COMPARE / "MANIFEST-LIVRAISON.json")
    assert all(sha(COMPARE / name) == digest for name, digest in old_manifest["files"].items())
    names = ["REPRISE.md", "COORDINATION-SOURCE-ONLY.md", "SUIVI-AUTOMATISE-ACTUEL.md", "ETAT-ACTUEL.md", "suivi-a-faire.json", "dernier-arrete-verifie.json", "MANIFEST-LIVRAISON.json"]
    for name in names:
        shutil.copy2(COMPARE / name, backup / name)
        assert sha(COMPARE / name) == sha(backup / name)
    shutil.copy2(AUTOMATION, backup / "automation.toml")
    edition = ROOT / "edition-professionnelle/manifeste-edition.json"
    save(backup / "edition-inchangee.json", descriptor(edition))
    automation = tomllib.loads(AUTOMATION.read_text(encoding="utf-8"))
    prompt = automation["prompt"]
    paragraphs = prompt.split("\n\n")
    new_r1 = "R1 compte toujours 25 groupes et 90 cellules admis. La MÊME recherche coverage-gpt-6-astra-xhigh / 750205 continue, session 2bd8b683b45b41c8b48ec38708f46bab ; source R1 inchangée cd769d474b6cb14c2fba11ab687f8825d35cb0b57a397d09aefab0ae743ffc18. Incident confirmé le 17 octobre : le relais initial est sorti après un échec de upload_to_romeo pendant la livraison d’un journal ; le répartiteur a refusé son absence trois fois, puis est sorti à 10:39:29 UTC. Lire outputs/HPC-Forest-Etude-2020-2024-r1/reprises/incident-liaison-astra-xhigh-20261017T1040/REPRISE.md et verification-reprise.json. Reprise du même job/canal/cache/registre par le helper inchangé reprendre-relais-r1.py --resume : relais 52576/46556 créés à 10:51:37 UTC. Un seul observateur observer-courant.py détient le même verrou : 21984/33948 créés à 10:51:43 UTC ; il contrôle les deux identités complètes et n’autorise que job_status/job_efficiency pour 750205, sans soumission, génération, réception ou arrêt. Les anciens 50900/52600 et 49776/57560 sont historiques ; ne pas relancer l’ancien répartiteur. Aucun processus arrêté pour la reprise, source-only préservé. Les observations ultérieures et identités complètes prévalent."
    prefix, tail = prompt.split("\n---\n", 1)
    current = prefix.split("\n\n")
    positions = [i for i, text in enumerate(current) if text.startswith("R1 compte maintenant")]
    assert len(positions) == 1
    current[positions[0]] = new_r1
    current.insert(positions[0] + 1, "La reprise vérifie 90 sources figées, 749 fichiers préservés et 58 réponses déjà livrées. La réponse 87f3e943666c4442804ca5dac9b1ac56 est retransmise à octets identiques, SHA-256 760ed6307424a849af0b06e6f97d35da7f1ac987c293427d104c6f07fa75059d identique avant/local/reçu de ROMEO, marqueur ready vérifié. 748 des 749 fichiers préexistants restent identiques ; seul worker-ready.json change avec copie préalable. Onze tests fictifs du helper et quinze tests neutres de l’observateur, Ruff positif. Aucune génération commencée rejouée, aucune nouvelle soumission ou inférence de diagnostic ; les appels normaux du même groupe restent autorisés. Les négatifs/expirations et erreurs de coupure sont conservés ; aucune cause basse couche ni causalité d’une mise à jour MCP établie. La borne 28 243 secondes au lancement correspond au reliquat d’allocation plus 900 secondes de livraison tardive et respecte le plafond initial ; budgets du contrôleur inchangés, trois échecs de connexion consécutifs au plus.")
    current[0] = "# État actuel après la reprise de liaison Astra xhigh du 17 octobre"
    current = [text.replace("Le répartiteur R1 soumet au plus ce seul groupe, puis observe ; il ne reçoit et n’arrête rien.", "L’observateur R1 ne soumet, ne reçoit, ne génère et n’arrête rien.") for text in current]
    for i, text in enumerate(current):
        if text.startswith("Au contrôle Slurm"):
            current[i] = text.replace("07:49 UTC", "10:52 UTC").replace("receptions/coverage-luna-xhigh-749940/statuts-finaux.json et cim-final.json", "reprises/incident-liaison-astra-xhigh-20261017T1040/statuts-apres-reprise.json et cim-apres-reprise.json")
    updated = "\n\n".join(current) + "\n---\n" + tail
    (HERE / "automation-prompt.txt").write_text(updated, encoding="utf-8")
    (COMPARE / "ETAT-ACTUEL.md").write_text(updated, encoding="utf-8")
    short = """# Reprise de liaison R1 Astra xhigh du 17 octobre — état vivant

ETAT-ACTUEL.md prévaut. Le relais R1 est sorti après échec de livraison d’un journal ; le répartiteur initial a refusé son absence trois fois, puis est sorti. Même job 750205, session 2bd8b683b45b41c8b48ec38708f46bab, canal/cache/registre repris sans génération commencée rejouée, ni nouvelle soumission. Helper inchangé reprendre-relais-r1.py --resume : 52576/46556 créés à 10:51:37 UTC ; observateur seul 21984/33948 à 10:51:43 UTC, même verrou. Anciens 50900/52600 et 49776/57560 historiques. 58 livraisons déjà reçues vérifiées ; réponse 87f3e943666c4442804ca5dac9b1ac56 retransmise à octets identiques. 748/749 fichiers préexistants inchangés, seul worker-ready.json change avec ancien reçu préservé ; 90 sources identiques. Onze tests fictifs du helper, quinze tests neutres de l’observateur et Ruff passent. Aucune cause basse couche ou causalité d’une mise à jour MCP établie ; négatifs/expirations conservés.

Lire ../HPC-Forest-Etude-2020-2024-r1/reprises/incident-liaison-astra-xhigh-20261017T1040/REPRISE.md et verification-reprise.json. L’observateur ne permet que les lectures de statut/efficacité pour 750205 ; aucune soumission, génération, réception ou arrêt. Fin : awaiting_audited_reception_after_strict_dispatch, puis réception stricte/audit natif/réconciliation AVANT arrêt possédé et continuation de la même file. Ne jamais appeler l’ancienne méthode Coordinator.receive. R1 reste à 25 groupes/90 cellules reçues, 14 autres groupes non démarrés ; voie réservée.

Source-only Astra MAX 750122 et ses identités 27336/11168, 25896/41388 sont préservés ; 15/300 issues reçues, aucun bilan final Astra reçu. Deux workers natifs au total. Aucun pilote Codex/R4/R5/Flash ; Codex attend les 300 issues source-only et son admission. Édition 17/228 pages, dépôt public et kit privé inchangés. Tous les résultats clos et notifications antérieures restent clos ; les paragraphes suivants sont historiques lorsqu’ils diffèrent.

---

"""
    for name in ["REPRISE.md", "COORDINATION-SOURCE-ONLY.md", "SUIVI-AUTOMATISE-ACTUEL.md"]:
        path = COMPARE / name
        path.write_text(short + path.read_text(encoding="utf-8-sig"), encoding="utf-8")
    todo = read(COMPARE / "suivi-a-faire.json")
    todo["phase"] = "R1_astra_xhigh_interface_recovered_source_only_astra_running"
    todo["updated_utc"] = datetime.now(UTC).isoformat()
    todo["historical_r1_strict_dispatcher_before_transport_failure"] = todo["existing_r1_current"]
    todo["existing_r1_current"] = {**todo["existing_r1_current"], "worker_pids": [52576, 46556], "coordinator_pids": [21984, 33948],
        "guide": str(HERE / "REPRISE.md"), "observer_only": True, "worker_resumed_same_cache": True, "submission_replayed": False,
        "recovery_proof": descriptor(HERE / "verification-reprise.json"), "current_identity_census": descriptor(HERE / "cim-apres-reprise.json"),
        "neutral_tests": {"unchanged_relay_helper": 11, "observer": 15}}
    todo["existing_native_lanes_latest_observation"] = {**descriptor(HERE / "statuts-apres-reprise.json"), "jobs": ["750205", "750122"], "native_workers": 2, "r1_lane_reserved_between_groups": True}
    assert todo["native_calls"] == 150 and todo["source_only_received_cells"] == 15
    save(COMPARE / "suivi-a-faire.json", todo)
    save(HERE / "suivi-prepare.json", {"verified": True, "prior_comparison_files_verified": len(old_manifest["files"]), "edition_manifest_unchanged": descriptor(edition), "new_prompt": descriptor(HERE / "automation-prompt.txt")})
    print(json.dumps({"prepared": True, "previous_manifest_files_verified": len(old_manifest["files"]), "prompt_chars": len(updated), "article_changed": False}))


if __name__ == "__main__":
    main()

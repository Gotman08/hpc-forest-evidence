"""Preserve the exact local guide/40-ID record, then update verified scope only."""
from pathlib import Path
import datetime, hashlib, json, re

BASE = Path(__file__).resolve().parents[3]
OP = Path(__file__).resolve().parent
guide = BASE / 'outputs/HPC-Forest-Harnais-Comparaison-r1/SUIVI-COMPACT.md'
ids = BASE / 'ID.md'
sha = lambda b: hashlib.sha256(b).hexdigest()
stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%SZ')
archive = OP / ('archivage-guide-' + stamp)
archive.mkdir(exist_ok=False)
old = {p.name: p.read_bytes() for p in (guide, ids)}
for name, data in old.items():
    (archive / name).write_bytes(data)
    assert sha((archive / name).read_bytes()) == sha(data)
before_ids = re.findall(r'^\| (ID-\d{3}) \|', old['ID.md'].decode('utf8'), re.M)
assert len(before_ids) == len(set(before_ids)) == 40
text = old['SUIVI-COMPACT.md'].decode('utf8')
text = re.sub(r'État du 18 octobre 2026,.*?Lire ce guide',
    'État du 18 octobre 2026, après réception mécanique R3 et démarrage passif OBS4. Lire ce guide', text, count=1)
start = text.index('NOUVELLE préparation locale R3 candidate source110 disponible')
end = text.index('R5/Flash non lancés,', start)
text = text[:start] + '''R3 corrigée par R4b : réception MÉCANIQUE source110 désormais close, canonique `../HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r3/qualification-allouee-source110-G-recu-r1/RECEPTION-MECANIQUE-SOURCE110-VERIFIEE.json`, SHA `86251148e0894a9b64fd35d85a17e1c06ea6c57e24bd927d602c47bc783e8685`. ZIP `eaff9217499fe268e4d151165a368a83bad1550d921955a9f9256026cfac2d48`, plan `d08ac00bcfb75625a24971b2684d7479c4da7a98b339e4e10eae5b9ac525ef27`, COMPONENTS62 `1e60da6d5b51afaf3c857b1ba215927e7e1201c297241afd6390212a89d5e449`. Liaison réelle G d4c74352… et revue12d72682… figées AVANT Q ; aucun pin NULL promu.

Q753709 : 265 tests ARM64 réussis (187 source,73 adaptateurs,5 OBS4), sources110/62 inchangées, zéro modèle. Slurm FAILED1:0 conservé : l’archive finale a refusé les liens de fixtures après les tests. Livraison seule753744 COMPLETED0:0, sans rejouer les tests : archive `1feede6cdc45b70622fc53964c7800d0dcd0c9b141e8739e8adacaca9cf5990e`, trois SHA égaux,690 fichiers réguliers stables et61 liens représentés en JSON inerte. Audit indépendant réel `f1e737c4…`. Les refus des lecteurs Windows et leurs preuves de différences ctime/mode sont conservés ; lecteur corrigé r4b audité, aucun modèle ni source scellée modifié.

Qualification cible753888 COMPLETED0:0 : deux sondes GCC/G++/OpenMP sous allocation4CPU ARM64/16Gio/zéro GPU,113 fichiers partagés inchangés. Archive `87f68c4c06ec1c1b17994499f582d922588334462a2a5c76880503d5bd923246`, trois SHA égaux, cinq documents restaurés stables ; revue réelle cible et héritage des contrats `e1e42a46…`. Le profil appartient seulement à753888 : chaque nouveau job devra produire son profil réel. Les références finies héritées ne sont pas rejouées. Liaison native/mapping réel `6ab45db5…` créée et reçue ; six fichiers partagés relus à SHA égaux.

OBS4 passif vivant, lancement unique observé17:59:52UTC : paire57452→28416, exécutable/commande/création/parenté complets dans `operations-parent-premier-roots-source110-r1/lancement-observateur-reel-01/`. Réception indépendante `3bec3df0…`, liste exacte de deux `b527ff96…` ; conhost35952 exclu de la paire. Au contrôle reçu : neuf routes absentes, zéro session native ; anciens SO/Luna clos non interrogés. Ces PID sont des observations datées, jamais des cibles sans nouveau contrôle. Source62 inchangée, revue intégration effective `cbb1e27f036cfc1fad0999909322d9f8e4ba905f1446f63f28d9ab6ece968055` lie neuf commandes et pins OBS4/ABI ; ancienne revue714 conservée.

INCIDENT DE GARDE AVANT MODÈLE : la commande d’admission OBS4 réapplique à tort120s à la preuve historique d’absence déjà vérifiée au démarrage. Observateur vivant cohérent, mais aucune admission native émise. Correction isolée extérieure en préparation/revue, avec CIM frais et identité/état/routes/capacité exacts ; ne pas modifier le worker/observateur vivant, vieillir artificiellement les preuves ou affaiblir les gardes.

Trois plans roots MAX seulement PRÉPARÉS : Sol `9bc36e2870834dfa8c72c6ace9f2d3bb`, Astra `577b9e41f9724ab29fea754e101cdd8b`, Terra `4dac4b295ec543fc99b1f459560d8935`. Scripts réels relus/revus `3521d612…`, aucune soumission, aucun appel R3 commencé à cet arrêté. Parent helper révision r3 lie cbb1 et Q réelles, revue `9f74ec33…` ; il crée une intention exclusive avant unique soumission. Admission complète et observations fraîches encore nécessaires ; ne jamais soumettre avant préparation opérationnelle prête. La phase technique mère roots ne constitue ni premier candidat NORMAL ni gain scientifique. Advice puis harvest exigent leur réception stricte positive par modèle ; premier batch programme audité dans le budget initial avant extension. R5 reste seul ensuite.

L’ancienne source105 et ses Q restent conservées, non admises pour le lancement actuel. Aucun gain R3, résultat Codex natif, réévaluation CPU ou admission professionnelle ajouté.

''' + text[end:]
text = text.replace('Rechercher les résultats finaux, confirmations et archives sans rejouer les appels.',
    'Le reçu final G ci-dessus clôt cette collecte partielle ; ne plus rechercher ni repoller ces jobs.')
text = text.replace('Contrôle frais16:35:32UTC :79%utilisés/21%restants, trois resets disponibles, aucun consommé.',
    'Dernier contrôle frais de ce tour :85%utilisés/15%restants, aucun reset consommé.')
text += '\nPréservation avant cet arrêté : `' + str(archive.relative_to(BASE)).replace('\\', '/') + '` ; guide et quarante ID antérieurs conservés à SHA vérifiés.\n'
newids = old['ID.md'].decode('utf8')
newids = newids.replace('R3 corrigé R4b reste en préparation/qualification exacte, R5 fermé.',
    'R3 corrigé R4b : qualification mécanique source110 reçue (265 tests ARM64, cible et contrats audités), OBS4 passif vivant ; admissions natives non émises, garde historique en correction isolée. R5 fermé.')
newids = newids.replace('Bilan scientifique final encore en attente ; aucune ligne de résultat ou ancien négatif remplacé.',
    'État historique15:14 : la clôture partielle ultérieure décrite ci-dessus prévaut ; aucune ligne de résultat ou ancien négatif remplacé.')
assert re.findall(r'^\| (ID-\d{3}) \|', newids, re.M) == before_ids
guide.write_text(text, encoding='utf8', newline='\n')
ids.write_text(newids, encoding='utf8', newline='\n')
receipt = {'schema':'hpc-forest-guide-and-40-id-preservation-v1','verified':True,'created_at_utc':stamp,
    'before':{k:sha(v) for k,v in old.items()},'after':{p.name:sha(p.read_bytes()) for p in (guide,ids)},
    'unique_ids_preserved':40,'archive':str(archive),'scientific_results_added':False,
    'native_model_calls_started_by_update':0}
(archive/'PRESERVATION-ET-MISE-A-JOUR.json').write_text(json.dumps(receipt,indent=2,ensure_ascii=False)+'\n',encoding='utf8')
print(json.dumps(receipt,ensure_ascii=False))

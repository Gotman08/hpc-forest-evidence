#include <algorithm>
#include <iostream>
#include <utility>
#include <vector>

using namespace std;

static const int MOD = 1000000007;

static int mod_pow(int base, int exponent) {
    long long result = 1;
    long long value = base;
    while (exponent > 0) {
        if (exponent & 1) result = result * value % MOD;
        value = value * value % MOD;
        exponent >>= 1;
    }
    return static_cast<int>(result);
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) return 0;

    vector<pair<int, int>> obstacles;
    obstacles.reserve(m);
    for (int c = 0; c < m; ++c) {
        int y, x;
        cin >> y >> x;
        obstacles.emplace_back(y, x);
    }

    if (n == 1) {
        bool blocked = false;
        for (const auto& cell : obstacles)
            if (cell.first == 0 && cell.second == 0) blocked = true;
        cout << (blocked ? 0 : 1) << '\n';
        return 0;
    }

    sort(obstacles.begin(), obstacles.end());
    obstacles.erase(unique(obstacles.begin(), obstacles.end()), obstacles.end());

    const pair<int, int> start{0, 0};
    const pair<int, int> finish{n - 1, n - 1};
    if (binary_search(obstacles.begin(), obstacles.end(), start) ||
        binary_search(obstacles.begin(), obstacles.end(), finish)) {
        cout << 0 << '\n';
        return 0;
    }

    const int max_steps = 2 * n - 2;
    vector<int> factorial(max_steps + 1), inverse_factorial(max_steps + 1);
    factorial[0] = 1;
    for (int i = 1; i <= max_steps; ++i)
        factorial[i] = static_cast<long long>(factorial[i - 1]) * i % MOD;
    inverse_factorial[max_steps] = mod_pow(factorial[max_steps], MOD - 2);
    for (int i = max_steps; i > 0; --i)
        inverse_factorial[i - 1] = static_cast<long long>(inverse_factorial[i]) * i % MOD;

    auto choose = [&](int total, int part) -> int {
        if (part < 0 || part > total) return 0;
        return static_cast<long long>(factorial[total]) * inverse_factorial[part] % MOD *
               inverse_factorial[total - part] % MOD;
    };

    vector<pair<int, int>> points = obstacles;
    points.push_back(finish);
    sort(points.begin(), points.end());
    points.erase(unique(points.begin(), points.end()), points.end());

    vector<int> ways(points.size());
    for (size_t i = 0; i < points.size(); ++i) {
        const int y = points[i].first;
        const int x = points[i].second;
        long long count = choose(x + y, x);
        for (size_t j = 0; j < i; ++j) {
            const int py = points[j].first;
            const int px = points[j].second;
            if (py <= y && px <= x) {
                int paths_between = choose((y - py) + (x - px), y - py);
                count -= static_cast<long long>(ways[j]) * paths_between % MOD;
                if (count < 0) count += MOD;
            }
        }
        ways[i] = static_cast<int>(count);
        if (points[i] == finish) {
            cout << ways[i] << '\n';
            return 0;
        }
    }
    return 0;
}

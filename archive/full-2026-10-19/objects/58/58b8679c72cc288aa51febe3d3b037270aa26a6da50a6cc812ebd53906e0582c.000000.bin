{"files":[{"content":"#include <bits/stdc++.h>\n\nusing namespace std;\n\ntypedef unsigned long long ll;\n\nconst int N = 1022;\nconst ll mod = 1000000007ULL;\nll transposed_rhs[N][N];\n\nclass matrix{\n    public:\n    int n;\n    ll mat[N][N];\n    ll aux[N][N];\n\n    void change_n(int n){\n        this->n = n;\n    }\n\n    matrix(int n){\n        this->n = n;\n    }\n\n    void init_base(){\n        for(int i = 0 ; i < n ; i++){\n            for(int j = 0 ; j < n ; j++){\n                mat[i][j] = 0LL;\n            }\n        }\n    }\n\n    void init_ident(){\n        for(int i = 0 ; i < n ; i++){\n            for(int j = 0 ; j < n ; j++){\n                mat[i][j] = (i == j);\n            }\n        }\n    }\n\n    matrix(){\n    }\n\n    void multiply_impl(const matrix &rhs){\n        const int tile = 32;\n        for(int i0 = 0 ; i0 < n ; i0 += tile){\n            for(int j0 = 0 ; j0 < n ; j0 += tile){\n                int i_end = min(n, i0 + tile);\n                int j_end = min(n, j0 + tile);\n                for(int i = i0 ; i < i_end ; i++){\n                    for(int j = j0 ; j < j_end ; j++){\n                        transposed_rhs[j][i] = rhs.mat[i][j];\n                    }\n                }\n            }\n        }\n\n        auto compute_row = [&](int i){\n            for(int j = 0 ; j < n ; j++){\n                ll sum = 0LL;\n                for(int k = 0 ; k < n ; k++){\n                    sum += this->mat[i][k] * transposed_rhs[j][k];\n                    if((k & 7) == 7){\n                        sum %= mod;\n                    }\n                }\n                this->aux[i][j] = sum % mod;\n            }\n            memcpy(this->mat[i], this->aux[i], sizeof(ll) * n);\n        };\n\n        if(n >= 64){\n            #pragma omp parallel for schedule(static)\n            for(int i = 0 ; i < n ; i++){\n                compute_row(i);\n            }\n        }else{\n            for(int i = 0 ; i < n ; i++){\n                compute_row(i);\n            }\n        }\n    }\n\n    void multiply(matrix *rhs){\n        multiply_impl(*rhs);\n    }\n\n    void multiply(matrix &rhs){\n        multiply_impl(rhs);\n    }\n\n    void pow(ll p, matrix &ident){\n        auto &r = ident;\n        auto d = this;\n\n        while(p){\n            if(p & 1LL){\n                r.multiply(d);\n            }\n\n            d->multiply(d);\n            p >>= 1LL;\n        }\n    }\n\n    void add_clause(int lin, matrix &base, vector<ll> clause){\n        for(int i = 0 ; i < n ; i++){\n            this->mat[lin][i] = clause[i];\n        }\n\n        base.mat[lin][0] = clause[n];\n    }\n\n    void print_line(int line){\n        for(int i = 0 ; i < n ; i++){\n            printf(\"%lld \", this->mat[i][line]);\n        }\n        printf(\"\\n\");\n    }\n\n    void print(){\n        cout << \"sz = \" << this->n << endl;\n        for(int i = 0 ; i < n ; i++){\n            for(int j = 0 ; j < n ; j++){\n                cout << this->mat[i][j] << \" \";\n            }\n            cout << endl;\n        }\n    }\n\n    matrix get_answer_matrix(int e, matrix &ident, matrix &base){\n        this->pow(e, ident);\n        ident.multiply(base);\n        return ident;\n    }\n\n    void set_base_case(int line, matrix &base, ll val){\n        base.mat[line][0] = val;\n    }\n\n    ll get_answer(int line){\n        return this->mat[line][0];\n    }\n};\n\nmatrix ans(N), base(N), ident(N);\n\nint main(){\n    ios::sync_with_stdio(false);\n    cin.tie(NULL);\n\n    int n, k;\n    cin >> n >> k;\n\n    vector<ll> A;\n    vector<ll> P;\n    A.reserve(n);\n    P.reserve(n);\n\n    for(int i = 0 ; i < n ; i++){\n        ll ai;\n        cin >> ai;\n        A.push_back(ai);\n    }\n\n    for(int i = 0 ; i < n ; i++){\n        ll pi;\n        cin >> pi;\n        P.push_back(pi);\n    }\n\n    const int distance = k - n;\n    const int direct_limit = max(64, 8 * n);\n    if(distance > 0 && distance <= direct_limit){\n        vector<ll> window_storage(2 * n);\n        vector<ll> reverse_weights(n);\n\n        for(int i = 0 ; i < n ; i++){\n            window_storage[i] = A[i];\n            window_storage[i + n] = A[i];\n            reverse_weights[i] = P[n - i - 1];\n        }\n\n        int oldest = 0;\n        ll answer = 0;\n\n        for(int step = 0 ; step < distance ; step++){\n            const ll *ordered_values = window_storage.data() + oldest;\n            ll next_value = 0;\n\n            for(int block = 0 ; block < n ; block += 16){\n                ll partial = 0;\n                int end = min(block + 16, n);\n                for(int j = block ; j < end ; j++){\n                    partial += ordered_values[j] * reverse_weights[j];\n                }\n                next_value = (next_value + partial % mod) % mod;\n            }\n\n            window_storage[oldest] = next_value;\n            window_storage[oldest + n] = next_value;\n\n            oldest++;\n            if(oldest == n){\n                oldest = 0;\n            }\n            answer = next_value;\n        }\n\n        cout << answer << \"\\n\";\n        return 0;\n    }\n\n    ans.change_n(n);\n    base.change_n(n);\n    ident.change_n(n);\n    ident.init_ident();\n    base.init_base();\n\n    P.push_back(A[n - 1]);\n    ans.add_clause(0, base, P);\n\n    for(int i = 1 ; i < n ; i++){\n        vector<ll> clausei;\n        for(int j = 0 ; j < n ; j++){\n            if(j == i - 1){\n                clausei.push_back(1);\n            }else{\n                clausei.push_back(0);\n            }\n        }\n        clausei.push_back(A[n - i - 1]);\n        ans.add_clause(i, base, clausei);\n    }\n\n    cout << ans.get_answer_matrix(distance, ident, base).get_answer(0) << \"\\n\";\n    return 0;\n}\n","path":"src/npbonacci.cpp"}],"hypothesis":"A conservative size-scaled direct-recurrence horizon should avoid dense matrix exponentiation for more short-to-moderate distances, while the tiled transposed matrix fallback retains coverage for larger distances. Delaying matrix setup until fallback avoids unnecessary work on the direct path.","notes":"Proposed source-only experiment; no commands or measurements were run. Correctness and speed should be evaluated by the controller across valid inputs.","research":{"queries":[],"urls":[]},"sources_kept":["4037f5c559db4c2c","590eed3136054404"],"transformations":["Extend the direct recurrence dispatch to distances up to max(64, 8*n), using the duplicated circular window, reversed weights, and 16-term modular-reduction blocks.","Defer matrix initialization and construction until the direct recurrence path is not selected.","Use a shared matrix multiplication kernel that transposes the right operand in 32-by-32 tiles, reduces every eight products, and parallelizes output rows statically for n >= 64."]}
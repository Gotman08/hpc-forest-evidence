#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>

#define BLOCK_SIZE 16

int main() {
	int n, s;
	std::cin >> n >> s;
	std::vector<std::vector<int>> matrix(n, std::vector<int>(n));
	for (int i = 0; i < n; i++)
		for (int j = 0; j < n; j++) 
			scanf("%d", &(matrix[i][j]));

	assert(s < n);
	assert(n < 8000);
	assert(s > 0);
	assert(n > 0);

	int mxSum = INT_MIN;

	for (int bi = 0; bi <= n - s; bi += BLOCK_SIZE) {
		for (int bj = 0; bj <= n - s; bj += BLOCK_SIZE) {
			int sum = 0;
			for (int i = bi; i < std::min(bi + BLOCK_SIZE, n - s + 1); ++i) {
				for (int j = bj; j < std::min(bj + BLOCK_SIZE, n - s + 1); ++j) {
					sum = 0;
					for (int ii = i; ii < i + s; ++ii) {
						for (int jj = j; jj < j + s; ++jj) {
							sum += matrix[ii][jj];
						}
					}
					mxSum = std::max(mxSum, sum);
				}
			}
		}
	}

	printf("%d\n", mxSum);
}
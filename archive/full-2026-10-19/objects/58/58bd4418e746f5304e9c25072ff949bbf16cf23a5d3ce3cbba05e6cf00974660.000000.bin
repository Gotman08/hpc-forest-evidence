{
  "src/main.cpp": "#include <bits/stdc++.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\nint A[1000][1000];\n\ntypedef long long ll;\n\nclass PrefixFrequency {\n  struct Slot {\n    int32_t key;\n    uint32_t frequency;\n  };\n\n  vector<Slot> slots;\n  vector<uint32_t> touched;\n  uint32_t mask;\n\n  static uint32_t hash_key(int32_t key) {\n    uint32_t x = static_cast<uint32_t>(key);\n    x ^= x >> 16;\n    x *= 0x7feb352dU;\n    x ^= x >> 15;\n    x *= 0x846ca68bU;\n    x ^= x >> 16;\n    return x;\n  }\n\npublic:\n  explicit PrefixFrequency(int scan_length) {\n    uint32_t entries = static_cast<uint32_t>(scan_length) + 1;\n    uint32_t capacity = 1;\n    while (capacity < 2U * entries)\n      capacity <<= 1;\n    slots.resize(capacity);\n    touched.reserve(entries);\n    mask = capacity - 1;\n  }\n\n  void clear() {\n    for (uint32_t index : touched)\n      slots[index].frequency = 0;\n    touched.clear();\n  }\n\n  uint32_t get(int32_t key) const {\n    uint32_t index = hash_key(key) & mask;\n    while (slots[index].frequency != 0) {\n      if (slots[index].key == key)\n        return slots[index].frequency;\n      index = (index + 1) & mask;\n    }\n    return 0;\n  }\n\n  void increment(int32_t key) {\n    uint32_t index = hash_key(key) & mask;\n    while (slots[index].frequency != 0) {\n      if (slots[index].key == key) {\n        ++slots[index].frequency;\n        return;\n      }\n      index = (index + 1) & mask;\n    }\n    slots[index].key = key;\n    slots[index].frequency = 1;\n    touched.push_back(index);\n  }\n};\n\nstatic int available_workers() {\n  int workers = 4;\n#ifdef _OPENMP\n  workers = min(workers, omp_get_max_threads());\n#else\n  const unsigned hardware = thread::hardware_concurrency();\n  if (hardware != 0)\n    workers = min(workers, static_cast<int>(min(hardware, 4U)));\n  for (const char *name : {\"OMP_NUM_THREADS\", \"OMP_THREAD_LIMIT\"}) {\n    const char *value = getenv(name);\n    if (value != nullptr) {\n      char *end = nullptr;\n      const long requested = strtol(value, &end, 10);\n      if (end != value && requested > 0 && requested < workers)\n        workers = static_cast<int>(requested);\n    }\n  }\n#endif\n  return max(workers, 1);\n}\n\nll solve(int m, int n, int k) {\n  const int paired = min(m, n);\n  const int scanned = max(m, n);\n  const size_t stride = static_cast<size_t>(scanned);\n  vector<int> prefix((static_cast<size_t>(paired) + 1) * stride, 0);\n\n  if (m <= n) {\n    for (int i = 0; i < m; ++i)\n      copy_n(A[i], scanned,\n             prefix.data() + (static_cast<size_t>(i) + 1) * stride);\n  } else {\n    for (int i = 0; i < m; ++i)\n      for (int j = 0; j < n; ++j)\n        prefix[(static_cast<size_t>(j) + 1) * stride + i] = A[i][j];\n  }\n\n  // Each boundary stores complete prefixes along the scanned dimension.\n  for (int boundary = 1; boundary <= paired; ++boundary) {\n    int *current = prefix.data() + static_cast<size_t>(boundary) * stride;\n    const int *previous = current - stride;\n    int row_prefix = 0;\n    for (int pos = 0; pos < scanned; ++pos) {\n      row_prefix += current[pos];\n      current[pos] = previous[pos] + row_prefix;\n    }\n  }\n\n  const auto count_bands = [&](int first, int step) -> ll {\n    PrefixFrequency h(scanned);\n    vector<int> keys(scanned);\n    ll subtotal = 0;\n    for (int start = first; start < paired; start += step) {\n      const int *upper = prefix.data() + static_cast<size_t>(start) * stride;\n      for (int last = start + 1; last <= paired; ++last) {\n        const int *lower = prefix.data() + static_cast<size_t>(last) * stride;\n        int *sums = keys.data();\n#pragma GCC ivdep\n        for (int pos = 0; pos < scanned; ++pos)\n          sums[pos] = lower[pos] - upper[pos];\n\n        h.clear();\n        h.increment(0);\n        for (int pos = 0; pos < scanned; ++pos) {\n          const ll s = sums[pos];\n          subtotal += h.get(static_cast<int32_t>(s - k));\n          h.increment(static_cast<int32_t>(s));\n        }\n      }\n    }\n    return subtotal;\n  };\n\n  const ll estimated_work = ll(scanned) * paired * (paired + 1) / 2;\n  int workers = 1;\n  if (estimated_work >= 131072LL)\n    workers = min(paired, available_workers());\n  if (workers == 1)\n    return count_bands(0, 1);\n\n  ll ans = 0;\n#ifdef _OPENMP\n#pragma omp parallel num_threads(workers) reduction(+:ans)\n  {\n    ans += count_bands(omp_get_thread_num(), omp_get_num_threads());\n  }\n#else\n  array<ll, 4> partials{};\n  array<thread, 3> threads;\n  for (int t = 1; t < workers; t++) {\n    threads[t - 1] = thread([&, t]() {\n      partials[t] = count_bands(t, workers);\n    });\n  }\n  partials[0] = count_bands(0, workers);\n  for (int t = 1; t < workers; t++)\n    threads[t - 1].join();\n  for (int t = 0; t < workers; t++)\n    ans += partials[t];\n#endif\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n"
}

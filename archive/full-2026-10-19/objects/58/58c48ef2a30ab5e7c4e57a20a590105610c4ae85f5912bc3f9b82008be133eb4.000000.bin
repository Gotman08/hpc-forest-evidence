      "content": "#include \"knn.h\"\n#include <stdint.h>\n\nstatic inline unsigned first_set_lane(uint32_t mask) {\n#if defined(__GNUC__) || defined(__clang__)\n    return (unsigned) __builtin_ctz((unsigned int) mask);\n#else\n    unsigned lane = 0;\n    while ((mask & UINT32_C(1)) == 0) {\n        mask >>= 1;\n        lane++;\n    }\n    return lane;\n#endif\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    enum {\n        DISTANCE_BLOCK_SIZE = 256,\n        CANDIDATE_WORD_BITS = 32,\n        CANDIDATE_WORD_COUNT =\n            (DISTANCE_BLOCK_SIZE + CANDIDATE_WORD_BITS - 1) / CANDIDATE_WORD_BITS\n    };\n    float block_distances[DISTANCE_BLOCK_SIZE];\n    uint32_t candidate_masks[CANDIDATE_WORD_COUNT];\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length;) {\n            int count = g.length - j;\n            if (count > DISTANCE_BLOCK_SIZE) {\n                count = DISTANCE_BLOCK_SIZE;\n            }\n\n            const Point * points = g.points + j;\n            const float cutoff = distances[k - 1];\n            const int have_cutoff = cutoff != -1.0f;\n            const int mask_count =\n                (count + CANDIDATE_WORD_BITS - 1) / CANDIDATE_WORD_BITS;\n\n            for (int word = 0; word < mask_count; word++) {\n                const int first = word * CANDIDATE_WORD_BITS;\n                int lanes = count - first;\n                if (lanes > CANDIDATE_WORD_BITS) {\n                    lanes = CANDIDATE_WORD_BITS;\n                }\n\n                uint32_t mask = 0;\n\n                /* Independent distances and an unsigned OR reduction. */\n#if defined(__GNUC__) && !defined(__clang__)\n#pragma GCC ivdep\n#endif\n                for (int lane = 0; lane < lanes; lane++) {\n                    float d = euclidean_distance_no_sqrt(to_evaluate, points[first + lane]);\n                    uint32_t retain = (uint32_t) (!have_cutoff || !(d >= cutoff));\n                    block_distances[first + lane] = d;\n                    mask |= retain << lane;\n                }\n\n                candidate_masks[word] = mask;\n            }\n\n            /* Ascending set bits preserve stable input-order insertion. */\n            for (int word = 0; word < mask_count; word++) {\n                uint32_t remaining = candidate_masks[word];\n                while (remaining != 0) {\n                    int lane = (int) first_set_lane(remaining);\n                    int b = word * CANDIDATE_WORD_BITS + lane;\n                    remaining &= remaining - UINT32_C(1);\n\n                    float d = block_distances[b];\n                    if (d == -1.0f) {\n                        continue;\n                    }\n\n                    float current_cutoff = distances[k - 1];\n                    if (current_cutoff != -1.0f && d >= current_cutoff) {\n                        continue;\n                    }\n\n                    for (x = 0; x < k; x++) {\n                        if (d < distances[x] || distances[x] == -1) {\n                            for (y = k - 1; y > x; y--) {\n                                distances[y] = distances[y - 1];\n                                labels[y] = labels[y - 1];\n                            }\n\n                            distances[x] = d;\n                            labels[x] = g.label;\n\n                            break;\n                        }\n                    }\n                }\n            }\n\n            j += count;\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }

"""Independent metadata assembly only; never import or execute candidate code."""
from pathlib import Path
import hashlib
import json
import xml.etree.ElementTree as ET

HERE = Path(__file__).resolve().parent
OLD = HERE.parent / "REVUE-INTEGRATION-SOURCE110-PARENT.json"
PREP = HERE.parents[2]
CHAIN = PREP / "adaptateurs-source110-r1/revision-r5-G-recu-avant-Q"
OUTPUT = HERE / "REVUE-INTEGRATION-SOURCE110-OBS4-REELLE.json"


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def frozen(path, expected):
    raw = Path(path).read_bytes()
    assert sha(raw) == expected, str(path)
    return raw


def ref(path):
    path = Path(path).absolute()
    raw = path.read_bytes()
    return {"path": str(path), "sha256": sha(raw)}


old_raw = frozen(OLD, "714fe52326ebb159ee11213a75ba30375eea0a9fd85ec912b5754e0077d6bc12")
old = json.loads(old_raw)
manifest_path = CHAIN / "COMPONENTS.json"
manifest = json.loads(frozen(manifest_path, "1e60da6d5b51afaf3c857b1ba215927e7e1201c297241afd6390212a89d5e449"))
assert len(manifest["code_pins"]) == 62 and manifest["code_pins"] == old["reviewed_files"]
for name, checksum in manifest["code_pins"].items():
    assert not Path(name).is_absolute() and ".." not in Path(name).parts
    frozen(CHAIN / name, checksum)
assert len(old["command_sha256_by_cell"]) == 9

q_path = PREP / "qualification-allouee-source110-G-recu-r1/RECEPTION-MECANIQUE-SOURCE110-VERIFIEE.json"
q = json.loads(frozen(q_path, "86251148e0894a9b64fd35d85a17e1c06ea6c57e24bd927d602c47bc783e8685"))
b_path = PREP / "qualification-allouee-source110-G-recu-r1/revue-resultats-Q753709-r1/audit-mecanique-independant-r1/AUDIT-MECANIQUE-INDEPENDANT-Q753709.json"
b = json.loads(frozen(b_path, "f1e737c416304e6d9edc5f86cca06a0d7ccdef3ec4c245f1ffc44451b460a01f"))
target_path = PREP / "qualification-cible-source110-r1/operations-parent-reelles-01/lecture-froide-r2/revue-independante-r2/revue-resultats-reels-r1/REVUE-REELLE-CIBLE-ET-REFERENCES-SOURCE110.json"
target = json.loads(frozen(target_path, "e1e42a4609e8441fcf5c7ada2b261de88a7a3ff762fd11b3aed2e375942830da"))
for value in (q, b, target):
    assert value["verified"] is True
    for name in ("scope_id", "source_zip_sha256", "plan_sha256", "adapter_components_manifest_sha256"):
        assert value[name] == old[name]
assert q["target_profile_verified"] is q["reference_contracts_reviewed"] is True
assert b["deduplicated_passed"] == 265 and b["source_passed"] == 187
assert b["adapter_passed"] == 73 and b["observer_passed"] == 5 and b["failed"] == b["skipped"] == 0
suite = next(row for row in b["suites"] if row["suite"] == "observer-neutral")
for key in ("junit", "execution", "intention"):
    frozen(suite[key]["path"], suite[key]["sha256"])
xml = ET.fromstring(Path(suite["junit"]["path"]).read_bytes())
cases = list(xml.iter("testcase"))
assert len(cases) == 5 and not list(xml.iter("failure")) and not list(xml.iter("error")) and not list(xml.iter("skipped"))
execution = json.loads(Path(suite["execution"]["path"]).read_text())

value = {name: old[name] for name in (
    "schema", "scope_id", "source_zip_sha256", "plan_sha256", "adapter_revision",
    "adapter_components_manifest_sha256", "reviewed_files", "command_sha256_by_cell")}
value.update(
    verified=True, reviewer="independent /root/prepare_r2g_owned_closure",
    blocking_findings=[], neutral_tests_passed=True,
    observer_sha256=manifest["code_pins"]["observer/observer-mixte.py"],
    abi_sha256=manifest["code_pins"]["observer/ABI.json"],
    verified_source_preparation_only=True,
    review_scope="Exact source110 integration/OBS4 code and actual allocated neutral mechanical evidence; no native or passive runtime admission",
    ancestor_integration_review=ref(OLD), components_manifest=ref(manifest_path),
    all62_component_operands_rehashed_again=True,
    exact_same62_reviewed_files_and_nine_commands_as_ancestor=True,
    current_mechanical_reception=ref(q_path), current_independent_Q_audit=ref(b_path),
    current_target_reference_review=ref(target_path),
    actual_qualification_job_id="753709", actual_delivery_job_id="753744",
    original_qualification_terminal_failure_preserved="FAILED1:0; tests265 passed, archive delivery recovered separately",
    actual_allocated_unique_neutral_cases={"source":187, "adapters_facades":73, "OBS4":5, "total":265},
    actual_OBS4_neutral_evidence={
        "suite":suite, "five_received_case_names":[c.attrib["name"] for c in cases],
        "code":ref(CHAIN / "observer/observer-mixte.py"),
        "ABI":ref(CHAIN / "observer/ABI.json"),
        "test_code":ref(CHAIN / "observer/test_obs4_neutre.py"),
        "local_validation":ref(CHAIN / "observer/validation-locale.json"),
        "local_five_case_XML":ref(CHAIN / "observer/TESTS-OBS4-NEUTRES.xml"),
        "original_XML_provenance":ref(CHAIN / "observer/PROVENANCE-EXTRACTION-CINQ-CAS.json"),
        "received_not_replayed":True},
    effective_OBS4_code_guards_reviewed=[
        "verify_policy binds exact source110/plan/source review and real Q archive/qualification/independent audit, then the sealed reader qualification and canonical G closure.",
        "observer_review must equal integration_review, both schema integration-review-v1, verified with no findings and exact top-level observer_sha256/abi_sha256. This new external receipt satisfies those code bindings;714 remains the immutable ancestor.",
        "load_source_only requires actual science6cd1 plus baseline/reconciliation/audit/readback/normalization refs, original five-field identity pair, explicit live or received_absent state, actual prior/full absence census and no equivalent SO session.",
        "Full original OBS3 absence and transition are revalidated at initial=True with the actual full census and age<=120s before any passive transport import or observer lock. Cold preparation cannot substitute for current startup evidence.",
        "Nine exact model/technical-phase/MAX/session routes, original bootstrap/source validator and private local worker identity/policy data are bound. Route/job/session duplication, rollback, replacement, removed routes and unclassified sessions refuse.",
        "Four lanes total include SO and pending allocated/worker_ready routes; wrapper/child pairs count once. The watcher does not submit, generate, receive, stop or grant scientific admission.",
        "Later same-model phases require a strictly positive audited prior terminal; negative source110 terminal and historical Luna remain closed and cannot admit continuation. Pilot/automatic extension remain closed.",
        "watch calls guard(initial=True) and transition_state(initial=True) before loading the frozen passive transport or taking its sidecar lock. Worker bootstrap and native allocation context remain separate parent gates."],
    mandatory_common_new_review_ref_consumers=["observer_review", "integration_review", "factory authorization", "reader admission", "parent exclusive intent"],
    old714_or_old_parent_helper_not_silently_rebound=True,
    target_profile_verified=True, reference_contracts_reviewed=True,
    target_reference_boolean_scope="Actual source110 code/mechanical reception only; each future native stage needs its own allocation target profile",
    native_generation_admitted=False, normal_first_start_verified=False,
    fresh_initial_runtime_admission_verified=False, observer_runtime_started_or_transport_opened=False,
    scientific_or_performance_admission=False, pilot_or_extension_admitted=False, method_R5_admitted=False,
    candidate_or_received_code_imported_or_executed_by_reviewer=False,
    tests_probes_models_CLI_compiler_CIM_live_cache_remote_or_process_effect_by_reviewer=False,
    source62_components_Q_bytes_or_historical_review_modified=False,
    limits="Source/OBS4 code integration review and actual neutral mechanical evidence only. This receipt authorizes no observation start, job submission, model call or native result. A new fresh full census, actual pair absence/transition, cap4 accounting, exact policy/routes/OWNER/private-policy/publication/authorization and per-allocation target profile remain required.")
assert value["reviewed_files"] == old["reviewed_files"]
assert value["command_sha256_by_cell"] == old["command_sha256_by_cell"]
assert value["observer_sha256"] == "db24bef9282b510642dbc23d527c32f1a5515df9791d255f920d7e326db32180"
assert value["abi_sha256"] == "e54b1ddde9925c4bb6439d1301642622bb7d108b74b5ef88444a93cf5080297e"
with OUTPUT.open("x", encoding="utf8", newline="\n") as out:
    json.dump(value, out, indent=2, ensure_ascii=False)
    out.write("\n")
print(json.dumps({"review":ref(OUTPUT), "components_rehashed":62, "commands":9,
                  "actual_OBS4_cases_received":5, "native_generation_admitted":False}))

      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\ntypedef struct { float x, y, z; } Position;\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system.\n */\nvoid body_force(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Keep source positions read-only during each timestep. Static owners\n * update velocities and produce the next position snapshot together.\n */\nstatic int simulate_parallel(Body *bodies, int n) {\n  if (n < 128) {\n    return 0;\n  }\n\n  size_t count = (size_t)n;\n  if (count > ((size_t)-1) / (2 * sizeof(Position))) {\n    return 0;\n  }\n  Position *positions = (Position *)malloc(2 * count * sizeof(Position));\n  if (positions == NULL) {\n    return 0;\n  }\n\n#pragma omp parallel default(none) shared(bodies, n, positions)\n  {\n    Position *current = positions;\n    Position *next = positions + (size_t)n;\n\n#pragma omp for schedule(static)\n    for (int i = 0; i < n; ++i) {\n      current[i].x = bodies[i].x;\n      current[i].y = bodies[i].y;\n      current[i].z = bodies[i].z;\n    }\n\n    for (int iter = 0; iter < N_ITER; ++iter) {\n#pragma omp for schedule(static)\n      for (int i = 0; i < n; ++i) {\n        float fx = 0.0f;\n        float fy = 0.0f;\n        float fz = 0.0f;\n        float xi = current[i].x;\n        float yi = current[i].y;\n        float zi = current[i].z;\n\n        for (int j = 0; j < n; j++) {\n          float dx = current[j].x - xi;\n          float dy = current[j].y - yi;\n          float dz = current[j].z - zi;\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          float inv_dist = 1 / sqrt(sqrd_dist);\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n        }\n\n        bodies[i].vx += DT*fx;\n        bodies[i].vy += DT*fy;\n        bodies[i].vz += DT*fz;\n\n        next[i].x = xi + bodies[i].vx * DT;\n        next[i].y = yi + bodies[i].vy * DT;\n        next[i].z = zi + bodies[i].vz * DT;\n      }\n\n      Position *swap = current;\n      current = next;\n      next = swap;\n    }\n\n#pragma omp for schedule(static) nowait\n    for (int i = 0; i < n; ++i) {\n      bodies[i].x = current[i].x;\n      bodies[i].y = current[i].y;\n      bodies[i].z = current[i].z;\n    }\n  }\n\n  free(positions);\n  return 1;\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  if (!simulate_parallel(bodies, nbodies)) {\n    for (int iter = 0; iter < N_ITER; iter++) {\n      body_force(bodies, DT, nbodies);\n\n      for (int i = 0; i < nbodies; i++) {\n        bodies[i].x += bodies[i].vx * DT;\n        bodies[i].y += bodies[i].vy * DT;\n        bodies[i].z += bodies[i].vz * DT;\n      }\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Position-only ping-pong buffers should improve persistent OpenMP throughput by isolating shared reads from velocity stores and allowing force calculation and integration to share one worksharing loop.",

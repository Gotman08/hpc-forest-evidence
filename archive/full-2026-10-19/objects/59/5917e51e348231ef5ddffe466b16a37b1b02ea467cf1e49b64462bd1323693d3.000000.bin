      "content": "/*\n  Quicksort\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <limits.h>\n#include <stdint.h>\n#include <openssl/md5.h>\n\n\n/*\n * Prototypes\n */\nvoid srandnum(int seed);\ndouble randnum(void);\nint *generate_case(int N);\ndouble drand(int xmin, int xmax);\nvoid swap(int *toorder, int i, int j);\nint partition(int *toorder, int lo, int hi);\nvoid _quicksort(int *toorder, int lo, int hi);\nvoid quicksort(int *toorder, int N);\nint is_sorted(int *toorder, int N);\n\n/*\n * A generic pRNG\n */\n#define MY_RAND_MAX 0x7FFFFFFF\n\n#define RANDNUM_W 521288629\n#define RANDNUM_Z 362436069\n\nunsigned int randum_w = RANDNUM_W;\nunsigned int randum_z = RANDNUM_Z;\n\nvoid srandnum(int seed)\n{\n    unsigned int w, z;\n    w = (seed * 104623) & 0xffffffff;\n    randum_w = (w) ? w : RANDNUM_W;\n    z = (seed * 48947) & 0xffffffff;\n    randum_z = (z) ? z : RANDNUM_Z;\n}\n\ndouble randnum(void)\n{\n    unsigned int u;\n    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);\n    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);\n    u = (randum_z << 16) + randum_w;\n    return (abs(u));\n}\n\n/*\n * Main function\n */\nint main(int argc, char *argv[])\n{\n    int N = 0;\n    int *our_list = NULL;\n\n    //The input provides the case size\n\tscanf(\"%d\", &N);\n    if (N <= 0) {\n\tprintf(\"Error: please, provide the case size.\\n\");\n\treturn 1;\n    }\n\n    //Generate the case\n    our_list = generate_case(N);\n    if (our_list == NULL) {\n\tprintf(\"Error: case instantiation failed.\\n\");\n\treturn 1;\n    }\n\n    //Do the thing\n    quicksort(our_list, N);\n\n    if (is_sorted(our_list, N) == 1) {\n\tprintf(\"Error, for some reason list is still unsorted.\\n\");\n\treturn 1;\n    }\n\n#ifdef COMPUTE_MD5_PROBLEM\n    //Compute MD5 Checksum for problem identification\n    MD5_CTX c;\n    unsigned char out[MD5_DIGEST_LENGTH];\n    MD5_Init(&c);\n    MD5_Update(&c, our_list, N * sizeof(int));\n    MD5_Final(out, &c);\n    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {\n\tprintf(\"%02x\", out[n]);\n    }\n#endif\n    printf(\"\\n\");\n\n    //Clean up\n    free(our_list);\n\n    return 0;\n}\n\n/*\n * Allocation-free fallback with bounded stack usage.\n */\nstatic void heap_sift_down(int *a, size_t root, size_t n)\n{\n    int value = a[root];\n    while (root < n / 2) {\n        size_t child = root * 2 + 1;\n        if (child + 1 < n && a[child] < a[child + 1])\n            ++child;\n        if (value >= a[child])\n            break;\n        a[root] = a[child];\n        root = child;\n    }\n    a[root] = value;\n}\n\nstatic void heap_sort_fallback(int *a, size_t n)\n{\n    if (n < 2)\n        return;\n    for (size_t start = n / 2; start != 0;) {\n        --start;\n        heap_sift_down(a, start, n);\n    }\n    for (size_t end = n; end > 1;) {\n        --end;\n        int value = a[end];\n        a[end] = a[0];\n        a[0] = value;\n        heap_sift_down(a, 0, end);\n    }\n}\n\n/*\n * Public API\n */\nvoid quicksort(int *toorder, int N)\n{\n    if (N <= 1)\n        return;\n\n    /* Avoid allocation and histogram setup for tiny arrays. */\n    if (N <= 32) {\n        for (int i = 1; i < N; ++i) {\n            int value = toorder[i];\n            int j = i;\n            while (j > 0 && toorder[j - 1] > value) {\n                toorder[j] = toorder[j - 1];\n                --j;\n            }\n            toorder[j] = value;\n        }\n        return;\n    }\n\n    size_t n = (size_t)N;\n    if (sizeof(int) != sizeof(uint32_t) ||\n        n > SIZE_MAX / sizeof(*toorder)) {\n        heap_sort_fallback(toorder, n);\n        return;\n    }\n\n    int *scratch = (int *)malloc(n * sizeof(*scratch));\n    if (scratch == NULL) {\n        heap_sort_fallback(toorder, n);\n        return;\n    }\n\n    /* N fits in a signed 32-bit int, so compact counters suffice.\n       All four byte histograms share one sequential input scan. */\n    uint32_t histogram[4][256] = {{0}};\n    for (size_t i = 0; i < n; ++i) {\n        uint32_t key = (uint32_t)toorder[i] ^ UINT32_C(0x80000000);\n        ++histogram[0][key & 255u];\n        ++histogram[1][(key >> 8) & 255u];\n        ++histogram[2][(key >> 16) & 255u];\n        ++histogram[3][key >> 24];\n    }\n\n    int *src = toorder;\n    int *dst = scratch;\n    for (unsigned int pass = 0; pass < 4; ++pass) {\n        uint32_t offset = 0;\n        for (unsigned int bucket = 0; bucket < 256; ++bucket) {\n            uint32_t count = histogram[pass][bucket];\n            histogram[pass][bucket] = offset;\n            offset += count;\n        }\n\n        /* Stable scatter preserves the ordering of preceding bytes.\n           Flipping the sign bit gives ascending signed-int order. */\n        unsigned int shift = pass * 8;\n        for (size_t i = 0; i < n; ++i) {\n            int value = src[i];\n            uint32_t key = (uint32_t)value ^ UINT32_C(0x80000000);\n            unsigned int bucket = (key >> shift) & 255u;\n            dst[histogram[pass][bucket]++] = value;\n        }\n\n        int *temp = src;\n        src = dst;\n        dst = temp;\n    }\n\n    /* Four passes finish in toorder; no copy-back is needed. */\n    free(scratch);\n}\n\n/*\n * Internal recursive function to quicksort\n */\nvoid _quicksort(int *toorder, int lo, int hi)\n{\n    if (lo >= hi)\n\treturn;\n    int b = partition(toorder, lo, hi);\n    _quicksort(toorder, lo, b - 1);\n    _quicksort(toorder, b + 1, hi);\n}\n\n/*\n * Swap two values.\n */\nvoid swap(int *toorder, int i, int j)\n{\n    int temp = toorder[i];\n    toorder[i] = toorder[j];\n    toorder[j] = temp;\n}\n\n/*\n * Partition decision\n */\nint partition(int *toorder, int lo, int hi)\n{\n    int b = lo;\n    int r = (int) (lo + (hi - lo) * (randnum() / MY_RAND_MAX));\n    int pivot = toorder[r];\n    swap(toorder, r, hi);\n    for (int i = lo; i < hi; i++) {\n\tif (toorder[i] < pivot) {\n\t    swap(toorder, i, b);\n\t    b++;\n\t}\n    }\n    swap(toorder, hi, b);\n    return b;\n}\n\n/*\n * Check if elements are in non-decreasing order\n */\nint is_sorted(int *toorder, int N)\n{\n    for (int i = 1; i < N; i++) {\n\tif (toorder[i] < toorder[i - 1]) {\n\t    return 1;\n\t}\n    }\n    return 0;\n}\n\n\n/*\n * Generate a case\n */\nint *generate_case(int N)\n{\n    int i;\n    int *ret = NULL;\n\n    // Make case generation reproducible\n    srandnum(0);\n\n    // Allocate memory\n    ret = (int *) malloc(N * sizeof(int));\n    if (ret == NULL) {\n\tprintf(\"Error: some malloc won't work.\\n\");\n\treturn NULL;\n    }\n    // Get pseudo-random positive integer values\n    for (i = 0; i < N; i++) {\n\tret[i] = drand(0, INT_MAX);\n    }\n    return ret;\n}\n\n/*\n * A pseudo-random number between two positive integer values\n */\ndouble drand(int xmin, int xmax)\n{\n    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;\n}\n",

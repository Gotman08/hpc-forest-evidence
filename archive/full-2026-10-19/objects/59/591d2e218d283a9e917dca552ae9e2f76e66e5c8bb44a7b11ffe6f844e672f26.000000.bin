      "content": "#include <algorithm>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <vector>\n\nnamespace {\nconstexpr int MOD = 1000000007;\nconstexpr int TILE = 256;\nconstexpr unsigned TILE_AREA = TILE * TILE;\n\nclass FastInput {\n    char buffer[65536];\n    std::size_t position = 0;\n    std::size_t length = 0;\n\n    int get() {\n        if (position == length) {\n            length = std::fread(buffer, 1, sizeof(buffer), stdin);\n            position = 0;\n            if (length == 0) return EOF;\n        }\n        return static_cast<unsigned char>(buffer[position++]);\n    }\n\npublic:\n    bool readInt(int& value) {\n        int c = get();\n        while (c <= ' ') {\n            if (c == EOF) return false;\n            c = get();\n        }\n        bool negative = c == '-';\n        if (negative) c = get();\n        int result = 0;\n        while (c >= '0' && c <= '9') {\n            result = result * 10 + c - '0';\n            c = get();\n        }\n        value = negative ? -result : result;\n        return true;\n    }\n};\n\nstruct alignas(64) Cursor {\n    std::size_t next = 0;\n};\n}\n\nint main() {\n    FastInput input;\n    int n, m;\n    if (!input.readInt(n) || !input.readInt(m)) return 0;\n\n    const int blocks = (n + TILE - 1) / TILE;\n    std::vector<std::vector<std::uint32_t>> obstacles(blocks);\n    bool endpointBlocked = false;\n    for (int k = 0; k < m; ++k) {\n        int y, x;\n        input.readInt(y);\n        input.readInt(x);\n        if ((y == 0 && x == 0) || (y == n - 1 && x == n - 1)) {\n            endpointBlocked = true;\n        }\n        const std::uint32_t code =\n            static_cast<std::uint32_t>(x / TILE) * TILE_AREA +\n            static_cast<std::uint32_t>(y % TILE) * TILE + x % TILE;\n        obstacles[y / TILE].push_back(code);\n    }\n    if (endpointBlocked) {\n        std::printf(\"0\\n\");\n        return 0;\n    }\n\n    const std::size_t frontierSize = static_cast<std::size_t>(blocks) * TILE;\n    std::vector<int> bottom[2];\n    std::vector<int> right[2];\n    for (int p = 0; p < 2; ++p) {\n        bottom[p].resize(frontierSize);\n        right[p].resize(frontierSize);\n    }\n    std::vector<Cursor> cursors(blocks);\n\n    #pragma omp parallel if(blocks >= 4)\n    {\n        alignas(64) int row[TILE];\n\n        #pragma omp for schedule(dynamic, 1)\n        for (int br = 0; br < blocks; ++br) {\n            auto& cells = obstacles[br];\n            std::sort(cells.begin(), cells.end());\n            cells.erase(std::unique(cells.begin(), cells.end()), cells.end());\n        }\n\n        for (int diagonal = 0; diagonal < 2 * blocks - 1; ++diagonal) {\n            const int current = diagonal & 1;\n            const int previous = current ^ 1;\n            const int firstRow = std::max(0, diagonal - blocks + 1);\n            const int lastRow = std::min(blocks - 1, diagonal);\n\n            #pragma omp for schedule(static)\n            for (int br = firstRow; br <= lastRow; ++br) {\n                const int bc = diagonal - br;\n                const int height = std::min(TILE, n - br * TILE);\n                const int width = std::min(TILE, n - bc * TILE);\n                const std::size_t topOffset = static_cast<std::size_t>(bc) * TILE;\n                const std::size_t sideOffset = static_cast<std::size_t>(br) * TILE;\n                const auto& cells = obstacles[br];\n                std::size_t position = cursors[br].next;\n                std::size_t end = position;\n                const std::uint32_t limit =\n                    static_cast<std::uint32_t>(bc + 1) * TILE_AREA;\n                while (end < cells.size() && cells[end] < limit) ++end;\n                cursors[br].next = end;\n\n                if (br == 0) {\n                    std::fill_n(row, width, 0);\n                } else {\n                    std::copy_n(bottom[previous].data() + topOffset, width, row);\n                }\n\n                for (int r = 0; r < height; ++r) {\n                    int left = bc == 0 ? 0 : right[previous][sideOffset + r];\n                    if (br == 0 && bc == 0 && r == 0) left = 1;\n                    int col = 0;\n                    while (position < end &&\n                           static_cast<int>((cells[position] % TILE_AREA) / TILE) == r) {\n                        const int blockedColumn = cells[position] % TILE;\n                        for (; col < blockedColumn; ++col) {\n                            int value = row[col] + left;\n                            if (value >= MOD) value -= MOD;\n                            row[col] = left = value;\n                        }\n                        row[blockedColumn] = 0;\n                        left = 0;\n                        col = blockedColumn + 1;\n                        ++position;\n                    }\n                    for (; col < width; ++col) {\n                        int value = row[col] + left;\n                        if (value >= MOD) value -= MOD;\n                        row[col] = left = value;\n                    }\n                    right[current][sideOffset + r] = left;\n                }\n                std::copy_n(row, width, bottom[current].data() + topOffset);\n            }\n        }\n    }\n\n    const std::size_t answerIndex =\n        static_cast<std::size_t>(blocks - 1) * TILE + (n - 1) % TILE;\n    std::printf(\"%d\\n\", bottom[0][answerIndex]);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

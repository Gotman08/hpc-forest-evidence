      "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <utility>\n#include <vector>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\nnamespace {\nconstexpr std::uint32_t MOD = 1000000007u;\n\n// Compute two wavefronts over an obstacle-free segment of the first.\n// Carry is the preceding value on that intermediate wavefront.\nstd::uint32_t update_pair_segment(\n    const std::uint32_t* __restrict previous,\n    std::uint32_t* __restrict current,\n    int begin, int end, std::uint32_t carry) {\n    int row = begin;\n#if defined(__aarch64__)\n    if (row + 4 <= end) {\n        const uint32x4_t modulus = vdupq_n_u32(MOD);\n        uint32x4_t preceding_input = vdupq_n_u32(previous[row - 1]);\n        uint32x4_t preceding_middle = vdupq_n_u32(carry);\n        do {\n            const uint32x4_t input = vld1q_u32(previous + row);\n            const uint32x4_t input_before =\n                vextq_u32(preceding_input, input, 3);\n            const uint32x4_t middle_sum = vaddq_u32(input, input_before);\n            const uint32x4_t middle =\n                vminq_u32(middle_sum, vsubq_u32(middle_sum, modulus));\n\n            const uint32x4_t middle_before =\n                vextq_u32(preceding_middle, middle, 3);\n            const uint32x4_t sum = vaddq_u32(middle, middle_before);\n            const uint32x4_t reduced =\n                vminq_u32(sum, vsubq_u32(sum, modulus));\n            vst1q_u32(current + row, reduced);\n\n            preceding_input = input;\n            preceding_middle = middle;\n            row += 4;\n        } while (row + 4 <= end);\n        carry = vgetq_lane_u32(preceding_middle, 3);\n    }\n#endif\n    for (; row < end; ++row) {\n        const std::uint32_t middle_sum = previous[row] + previous[row - 1];\n        const std::uint32_t middle =\n            middle_sum >= MOD ? middle_sum - MOD : middle_sum;\n        const std::uint32_t sum = middle + carry;\n        current[row] = sum >= MOD ? sum - MOD : sum;\n        carry = middle;\n    }\n    return carry;\n}\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n, m;\n    if (!(std::cin >> n >> m)) {\n        return 0;\n    }\n\n    std::vector<std::vector<int>> blocked_by_diagonal(2 * n - 1);\n    for (int obstacle = 0; obstacle < m; ++obstacle) {\n        int row, column;\n        std::cin >> row >> column;\n        blocked_by_diagonal[row + column].push_back(row);\n    }\n\n    // Index -1 is a permanent zero sentinel. Entries beyond the\n    // growing wavefront remain zero until they first become valid.\n    std::vector<std::uint32_t> first(n + 1, 0);\n    std::vector<std::uint32_t> second(n + 1, 0);\n    std::uint32_t* previous = first.data() + 1;\n    std::uint32_t* current = second.data() + 1;\n    previous[0] = blocked_by_diagonal[0].empty() ? 1u : 0u;\n\n    for (int diagonal = 1; diagonal < 2 * n - 1; diagonal += 2) {\n        const int begin = std::max(0, diagonal - n + 1);\n        const int end = std::min(n, diagonal + 1);\n        auto& blockers = blocked_by_diagonal[diagonal];\n        std::sort(blockers.begin(), blockers.end());\n\n        // Intermediate blockers split the fused sweep into independent\n        // obstacle-free segments. Duplicate blockers are processed once.\n        int position = begin;\n        std::uint32_t carry = 0;\n        for (int row : blockers) {\n            if (row < position) {\n                continue;\n            }\n            carry = update_pair_segment(previous, current, position, row, carry);\n            current[row] = carry;\n            carry = 0;\n            position = row + 1;\n        }\n        carry = update_pair_segment(previous, current, position, end, carry);\n\n        // The growing second wavefront has one additional high row.\n        // In the shrinking half, the extra low output is never read.\n        if (end < n) {\n            current[end] = carry;\n        }\n        for (int row : blocked_by_diagonal[diagonal + 1]) {\n            current[row] = 0;\n        }\n        std::swap(previous, current);\n    }\n\n    std::cout << previous[n - 1] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

      "content": "#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n#include<stdint.h>\n\n/* Maximum size (in char) for neighbors and compute lists */\n#define MAX 100\n\ntypedef struct {\n  int id;\n  float value;\n  char neighbors[MAX];\n} Node;\n\ntypedef struct {\n  int id;\n  int record_plus_one;\n} IdEntry;\n\ntypedef struct {\n  int *direct;\n  IdEntry *hash;\n  size_t capacity;\n  int minimum;\n} IdIndex;\n\ntypedef struct {\n  float cost;\n  unsigned char ready;\n} CachedCost;\n\n/* Reads input, allocates memory, writes graph size and node list. Returns the graph. */\nNode* read_input(char* fname, int *n, char* list) {\n  Node* data = NULL;\n  FILE *fl = NULL;\n\n  if (fname == NULL)\n    fl = stdin;\n  else\n    fl = fopen(fname, \"r\");\n\n  if (fl == NULL) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n\n  // header\n  fscanf(fl, \"%d %[^\\n]\", n, list);\n\n  if (*n > 0) {\n    data = (Node*) malloc((*n) * sizeof(Node));\n    if (data == NULL) {\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }\n  }\n\n  for (int i = 0; i < *n; i++)\n    fscanf(fl, \"%d %f %[^\\n]\", &data[i].id, &data[i].value, data[i].neighbors);\n\n  fclose(fl);\n  return data;\n}\n\n/* Returns the index of the first node with the given id or -1 if not found. */\nint find_by_id(Node g[], int id, int size) {\n  int i = 0;\n  while ((i < size) && g[i].id != id)\n    i++;\n  if (i < size)\n    return i;\n  return -1;\n}\n\nstatic size_t hash_id(int id) {\n  uint32_t x = (uint32_t)id;\n  x ^= x >> 16;\n  x *= UINT32_C(0x7feb352d);\n  x ^= x >> 15;\n  x *= UINT32_C(0x846ca68b);\n  x ^= x >> 16;\n  return (size_t)x;\n}\n\n/* Zero slots mean absent; occupied slots retain the first matching record. */\nstatic void build_id_index(IdIndex *index, const Node *g, int size) {\n  index->direct = NULL;\n  index->hash = NULL;\n  index->capacity = 0;\n  index->minimum = 0;\n\n  if (size < 16)\n    return;\n\n  int minimum = g[0].id;\n  int maximum = g[0].id;\n  for (int i = 1; i < size; i++) {\n    if (g[i].id < minimum)\n      minimum = g[i].id;\n    if (g[i].id > maximum)\n      maximum = g[i].id;\n  }\n\n  uint64_t span = (uint64_t)((int64_t)maximum - (int64_t)minimum) + 1;\n\n  /* Bound direct-address storage by the number of input records. */\n  if (span <= (uint64_t)size * 4 &&\n      span <= SIZE_MAX / sizeof(int)) {\n    int *direct = (int*)calloc((size_t)span, sizeof(int));\n    if (direct == NULL)\n      return;\n\n    for (int i = 0; i < size; i++) {\n      size_t offset = (size_t)((int64_t)g[i].id - (int64_t)minimum);\n      if (direct[offset] == 0)\n        direct[offset] = i + 1;\n    }\n\n    index->direct = direct;\n    index->capacity = (size_t)span;\n    index->minimum = minimum;\n    return;\n  }\n\n  size_t count = (size_t)size;\n  if (count > SIZE_MAX / 2)\n    return;\n\n  size_t capacity = 16;\n  while (capacity < count * 2) {\n    if (capacity > SIZE_MAX / 2)\n      return;\n    capacity *= 2;\n  }\n  if (capacity > SIZE_MAX / sizeof(IdEntry))\n    return;\n\n  IdEntry *table = (IdEntry*)calloc(capacity, sizeof(IdEntry));\n  if (table == NULL)\n    return;\n\n  size_t mask = capacity - 1;\n  for (int i = 0; i < size; i++) {\n    size_t slot = hash_id(g[i].id) & mask;\n    while (table[slot].record_plus_one != 0 && table[slot].id != g[i].id)\n      slot = (slot + 1) & mask;\n    if (table[slot].record_plus_one == 0) {\n      table[slot].id = g[i].id;\n      table[slot].record_plus_one = i + 1;\n    }\n  }\n\n  index->hash = table;\n  index->capacity = capacity;\n}\n\nstatic void free_id_index(IdIndex *index) {\n  free(index->direct);\n  free(index->hash);\n  index->direct = NULL;\n  index->hash = NULL;\n  index->capacity = 0;\n}\n\nstatic int find_indexed(const IdIndex *index, Node g[], int id, int size) {\n  if (index->direct != NULL) {\n    int64_t offset = (int64_t)id - (int64_t)index->minimum;\n    if (offset < 0 || (uint64_t)offset >= index->capacity)\n      return -1;\n    return index->direct[(size_t)offset] - 1;\n  }\n\n  if (index->hash != NULL) {\n    size_t mask = index->capacity - 1;\n    size_t slot = hash_id(id) & mask;\n    while (index->hash[slot].record_plus_one != 0) {\n      if (index->hash[slot].id == id)\n        return index->hash[slot].record_plus_one - 1;\n      slot = (slot + 1) & mask;\n    }\n    return -1;\n  }\n\n  return find_by_id(g, id, size);\n}\n\n/* Recursive fallback preserves neighbor order and parent-plus-child additions. */\nstatic float get_costly_indexed(Node *g, int id, int size, const IdIndex *index) {\n  int nd = find_indexed(index, g, id, size);\n  if (nd < 0)\n    return 0.0f;\n\n  int idmax = -1;\n  float max = 0.0f;\n  char aux[MAX];\n  char *auxptr;\n  char *t;\n\n  strcpy(aux, g[nd].neighbors);\n  for (t = strtok_r(aux, \" \", &auxptr); t != NULL;\n       t = strtok_r(NULL, \" \", &auxptr)) {\n    int neighbor_id = atoi(t);\n    int d = find_indexed(index, g, neighbor_id, size);\n    if (d >= 0 && max < g[d].value) {\n      max = g[d].value;\n      idmax = neighbor_id;\n    }\n  }\n\n  float r = g[nd].value;\n  if (idmax != -1)\n    r += get_costly_indexed(g, idmax, size, index);\n  return r;\n}\n\n/* Standalone calls own their index and retain no graph-dependent state. */\nfloat get_costly(Node *g, int id, int size) {\n  IdIndex index;\n  build_id_index(&index, g, size);\n  float result = get_costly_indexed(g, id, size, &index);\n  free_id_index(&index);\n  return result;\n}\n\n/* Evaluate demanded chains, sharing completed suffixes across this graph's queries. */\nstatic float get_costly_cached(Node *g, int id, int size, const IdIndex *index,\n                               CachedCost *cache, int *path) {\n  int nd = find_indexed(index, g, id, size);\n  int depth = 0;\n\n  if (nd < 0)\n    return 0.0f;\n\n  while (!cache[nd].ready) {\n    int idmax = -1;\n    int next = -1;\n    float max = 0.0f;\n    char aux[MAX];\n    char *auxptr;\n    char *t;\n\n    strcpy(aux, g[nd].neighbors);\n    for (t = strtok_r(aux, \" \", &auxptr); t != NULL;\n         t = strtok_r(NULL, \" \", &auxptr)) {\n      int neighbor_id = atoi(t);\n      int d = find_indexed(index, g, neighbor_id, size);\n      if (d >= 0 && max < g[d].value) {\n        max = g[d].value;\n        idmax = neighbor_id;\n        next = d;\n      }\n    }\n\n    /* A selected ID of -1 terminates even when that ID exists in the graph. */\n    if (idmax == -1) {\n      cache[nd].cost = g[nd].value;\n      cache[nd].ready = 1;\n      break;\n    }\n\n    /* A path in the input DAG contains at most size nodes. */\n    path[depth++] = nd;\n    nd = next;\n  }\n\n  float result = cache[nd].cost;\n  while (depth > 0) {\n    int parent = path[--depth];\n    float r = g[parent].value;\n    /* Match recursive grouping and float rounding; terminals never add zero. */\n    r += result;\n    cache[parent].cost = r;\n    cache[parent].ready = 1;\n    result = r;\n  }\n\n  return result;\n}\n\n/* Main program - calls read input, computes sum for each node in the list, prints output */\nint main() {\n  char *fileN = NULL;\n  char computelist[MAX];\n  int n = -1;\n  Node* input = NULL;\n  CachedCost *cache = NULL;\n  int *path = NULL;\n\n  input = read_input(fileN, &n, computelist);\n  IdIndex index;\n  build_id_index(&index, input, n);\n\n  if (n > 0) {\n    cache = (CachedCost*)calloc((size_t)n, sizeof(*cache));\n    if (cache != NULL) {\n      path = (int*)malloc((size_t)n * sizeof(*path));\n      if (path == NULL) {\n        free(cache);\n        cache = NULL;\n      }\n    }\n  }\n\n  // process\n  for (char *c = strtok(computelist, \" \"); c != NULL; c = strtok(NULL, \" \")) {\n    float cost;\n    if (cache != NULL)\n      cost = get_costly_cached(input, atoi(c), n, &index, cache, path);\n    else\n      cost = get_costly_indexed(input, atoi(c), n, &index);\n    printf(\"%s: %f\\n\", c, cost);\n  }\n\n  free(path);\n  free(cache);\n  free_id_index(&index);\n  free(input);\n\n  return 0;\n}\n",
      "path": "src/graph.c"
    }
  ],
  "hypothesis": "Combining hybrid ID indexing with demanded-chain suffix caching may outperform indexing alone by avoiding repeated traversal and neighbor parsing across queries, without parallel startup or synchronization costs.",

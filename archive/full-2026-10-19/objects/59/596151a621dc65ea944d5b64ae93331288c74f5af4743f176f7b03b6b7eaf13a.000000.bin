        "sources": [],
        "transformations": {
          "files": [
            "src/solution.cpp"
          ],
          "retained": [
            "Replace the obstacle bitmap with sorted, deduplicated 64-bit row-major obstacle positions.",
            "Update one DP array in place, retaining the left value in a scalar and eliminating row copying.",
            "Process contiguous obstacle-free spans without per-cell obstacle checks.",
            "Replace modular division with conditional subtraction and disable synchronized iostream input."
          ]
        },

          ],
          "retained": [
            "Factor the four-lane modular prefix scan into an inline helper.",
            "Process 16 cells per iteration with four independent local scans followed by ordered carry propagation.",
            "Broadcast carries directly within NEON registers, extracting a scalar only for the interval tail."
          ]
        },

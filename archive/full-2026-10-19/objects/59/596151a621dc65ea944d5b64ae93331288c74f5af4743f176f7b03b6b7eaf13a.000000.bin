            "src/solution.cpp"
          ],
          "retained": [
            "Retain sorted, deduplicated sparse obstacles, row offsets, tile-clipped lookup, and boundary-aware four-row register blocking.",
            "Replace dependency tasks with statically scheduled tile anti-diagonals inside one persistent OpenMP team, using an implicit barrier between diagonals.",
            "Retain reusable bottom/right boundaries, conditional-subtraction modular arithmetic, unsynchronized input, and sequential execution when OpenMP is unavailable or unsuitable."
          ]
        },

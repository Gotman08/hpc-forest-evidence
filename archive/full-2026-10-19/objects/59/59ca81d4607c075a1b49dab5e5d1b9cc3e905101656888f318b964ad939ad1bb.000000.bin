{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"/*\\n  Quicksort\\n*/\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <limits.h>\\n#include <string.h>\\n#include <openssl/md5.h>\\n\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\n#define RADIX_BITS 8U\\n#define RADIX_BUCKETS (1U << RADIX_BITS)\\n#define PARALLEL_RADIX_MINIMUM 65536U\\n\\n/*\\n * Prototypes\\n */\\nvoid srandnum(int seed);\\ndouble randnum(void);\\nint *generate_case(int N);\\ndouble drand(int xmin, int xmax);\\nvoid quicksort(int *toorder, int N);\\nint is_sorted(int *toorder, int N);\\n\\nstatic unsigned int radix_digit(int value, unsigned int shift);\\nstatic int radix_sort_serial(int *values, size_t count);\\nstatic int int_compare(const void *left, const void *right);\\n#ifdef _OPENMP\\nstatic int radix_sort_parallel(int *values, size_t count);\\n#endif\\n\\n/*\\n * A generic pRNG\\n */\\n#define MY_RAND_MAX 0x7FFFFFFF\\n\\n#define RANDNUM_W 521288629\\n#define RANDNUM_Z 362436069\\n\\nunsigned int randum_w = RANDNUM_W;\\nunsigned int randum_z = RANDNUM_Z;\\n\\nvoid srandnum(int seed)\\n{\\n    unsigned int w, z;\\n    w = (seed * 104623) & 0xffffffff;\\n    randum_w = (w) ? w : RANDNUM_W;\\n    z = (seed * 48947) & 0xffffffff;\\n    randum_z = (z) ? z : RANDNUM_Z;\\n}\\n\\ndouble randnum(void)\\n{\\n    unsigned int u;\\n    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);\\n    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);\\n    u = (randum_z << 16) + randum_w;\\n    return (abs(u));\\n}\\n\\n/*\\n * Main function\\n */\\nint main(int argc, char *argv[])\\n{\\n    int N = 0;\\n    int *our_list = NULL;\\n\\n    (void)argc;\\n    (void)argv;\\n\\n    //The input provides the case size\\n    scanf(\\\"%d\\\", &N);\\n    if (N <= 0) {\\n        printf(\\\"Error: please, provide the case size.\\\\n\\\");\\n        return 1;\\n    }\\n\\n    //Generate the case\\n    our_list = generate_case(N);\\n    if (our_list == NULL) {\\n        printf(\\\"Error: case instantiation failed.\\\\n\\\");\\n        return 1;\\n    }\\n\\n    //Do the thing\\n    quicksort(our_list, N);\\n\\n    if (is_sorted(our_list, N) == 1) {\\n        printf(\\\"Error, for some reason list is still unsorted.\\\\n\\\");\\n        return 1;\\n    }\\n\\n#ifdef COMPUTE_MD5_PROBLEM\\n    //Compute MD5 Checksum for problem identification\\n    MD5_CTX c;\\n    unsigned char out[MD5_DIGEST_LENGTH];\\n    MD5_Init(&c);\\n    MD5_Update(&c, our_list, (size_t)N * sizeof(*our_list));\\n    MD5_Final(out, &c);\\n    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {\\n        printf(\\\"%02x\\\", out[n]);\\n    }\\n#endif\\n    printf(\\\"\\\\n\\\");\\n\\n    //Clean up\\n    free(our_list);\\n\\n    return 0;\\n}\\n\\n/*\\n * Map signed integers into unsigned lexicographic order, then select one byte.\\n */\\nstatic unsigned int radix_digit(int value, unsigned int shift)\\n{\\n    const unsigned int sign_bit = ~((unsigned int)INT_MAX);\\n    return (((unsigned int)value ^ sign_bit) >> shift) & (RADIX_BUCKETS - 1U);\\n}\\n\\nstatic int radix_sort_serial(int *values, size_t count)\\n{\\n    int *scratch;\\n    int *input;\\n    int *output;\\n    unsigned int shift;\\n\\n    if (count > (size_t)-1 / sizeof(*scratch)) {\\n        return 0;\\n    }\\n\\n    scratch = (int *)malloc(count * sizeof(*scratch));\\n    if (scratch == NULL) {\\n        return 0;\\n    }\\n\\n    input = values;\\n    output = scratch;\\n    for (shift = 0; shift < sizeof(unsigned int) * CHAR_BIT; shift += RADIX_BITS) {\\n        size_t positions[RADIX_BUCKETS] = {0};\\n        size_t total = 0;\\n        size_t i;\\n        unsigned int bucket;\\n\\n        for (i = 0; i < count; ++i) {\\n            ++positions[radix_digit(input[i], shift)];\\n        }\\n        for (bucket = 0; bucket < RADIX_BUCKETS; ++bucket) {\\n            size_t bucket_count = positions[bucket];\\n            positions[bucket] = total;\\n            total += bucket_count;\\n        }\\n        for (i = 0; i < count; ++i) {\\n            bucket = radix_digit(input[i], shift);\\n            output[positions[bucket]++] = input[i];\\n        }\\n\\n        {\\n            int *temporary = input;\\n            input = output;\\n            output = temporary;\\n        }\\n    }\\n\\n    if (input != values) {\\n        memcpy(values, input, count * sizeof(*values));\\n    }\\n    free(scratch);\\n    return 1;\\n}\\n\\n#ifdef _OPENMP\\n/*\\n * Each worker owns a contiguous input range and a private histogram.  The\\n * per-worker prefix positions give every worker disjoint output ranges while\\n * retaining stable byte passes.\\n */\\nstatic int radix_sort_parallel(int *values, size_t count)\\n{\\n    const int maximum_threads = omp_get_max_threads();\\n    size_t slots;\\n    size_t *positions;\\n    int *scratch;\\n    int *input;\\n    int *output;\\n\\n    if (maximum_threads < 2 || count < PARALLEL_RADIX_MINIMUM) {\\n        return 0;\\n    }\\n    if ((size_t)maximum_threads > (size_t)-1 / RADIX_BUCKETS) {\\n        return 0;\\n    }\\n    slots = (size_t)maximum_threads * RADIX_BUCKETS;\\n    if (slots > (size_t)-1 / sizeof(*positions) ||\\n        count > (size_t)-1 / sizeof(*scratch)) {\\n        return 0;\\n    }\\n\\n    positions = (size_t *)malloc(slots * sizeof(*positions));\\n    scratch = (int *)malloc(count * sizeof(*scratch));\\n    if (positions == NULL || scratch == NULL) {\\n        free(positions);\\n        free(scratch);\\n        return 0;\\n    }\\n\\n    input = values;\\n    output = scratch;\\n#pragma omp parallel shared(input, output, positions, count)\\n    {\\n        const int thread_number = omp_get_thread_num();\\n        const int threads = omp_get_num_threads();\\n        const size_t base = count / (size_t)threads;\\n        const size_t remainder = count % (size_t)threads;\\n        const size_t begin = base * (size_t)thread_number +\\n                             ((size_t)thread_number < remainder ?\\n                              (size_t)thread_number : remainder);\\n        const size_t end = begin + base +\\n                           ((size_t)thread_number < remainder ? 1U : 0U);\\n        unsigned int shift;\\n\\n        for (shift = 0; shift < sizeof(unsigned int) * CHAR_BIT;\\n             shift += RADIX_BITS) {\\n            size_t local_counts[RADIX_BUCKETS];\\n            size_t i;\\n            unsigned int bucket;\\n\\n            memset(local_counts, 0, sizeof(local_counts));\\n            for (i = begin; i < end; ++i) {\\n                ++local_counts[radix_digit(input[i], shift)];\\n            }\\n            memcpy(positions + (size_t)thread_number * RADIX_BUCKETS,\\n                   local_counts, sizeof(local_counts));\\n\\n#pragma omp barrier\\n#pragma omp single\\n            {\\n                size_t total = 0;\\n                int worker;\\n\\n                for (bucket = 0; bucket < RADIX_BUCKETS; ++bucket) {\\n                    for (worker = 0; worker < threads; ++worker) {\\n                        size_t index = (size_t)worker * RADIX_BUCKETS + bucket;\\n                        size_t bucket_count = positions[index];\\n                        positions[index] = total;\\n                        total += bucket_count;\\n                    }\\n                }\\n            }\\n\\n            for (i = begin; i < end; ++i) {\\n                bucket = radix_digit(input[i], shift);\\n                output[positions[(size_t)thread_number * RADIX_BUCKETS + bucket]++] =\\n                    input[i];\\n            }\\n\\n#pragma omp barrier\\n#pragma omp single\\n            {\\n                int *temporary = input;\\n                input = output;\\n                output = temporary;\\n            }\\n        }\\n    }\\n\\n    if (input != values) {\\n        memcpy(values, input, count * sizeof(*values));\\n    }\\n    free(scratch);\\n    free(positions);\\n    return 1;\\n}\\n#endif\\n\\nstatic int int_compare(const void *left, const void *right)\\n{\\n    int a = *(const int *)left;\\n    int b = *(const int *)right;\\n    return (a > b) - (a < b);\\n}\\n\\n/*\\n * Public API\\n */\\nvoid quicksort(int *toorder, int N)\\n{\\n    if (toorder == NULL || N < 2) {\\n        return;\\n    }\\n\\n#ifdef _OPENMP\\n    if (radix_sort_parallel(toorder, (size_t)N)) {\\n        return;\\n    }\\n#endif\\n    if (!radix_sort_serial(toorder, (size_t)N)) {\\n        qsort(toorder, (size_t)N, sizeof(*toorder), int_compare);\\n    }\\n}\\n\\n/*\\n * Check if elements are in non-decreasing order\\n */\\nint is_sorted(int *toorder, int N)\\n{\\n    for (int i = 1; i < N; i++) {\\n        if (toorder[i] < toorder[i - 1]) {\\n            return 1;\\n        }\\n    }\\n    return 0;\\n}\\n\\n/*\\n * Generate a case\\n */\\nint *generate_case(int N)\\n{\\n    int i;\\n    int *ret = NULL;\\n\\n    // Make case generation reproducible\\n    srandnum(0);\\n\\n    // Allocate memory\\n    ret = (int *)malloc((size_t)N * sizeof(*ret));\\n    if (ret == NULL) {\\n        printf(\\\"Error: some malloc won't work.\\\\n\\\");\\n        return NULL;\\n    }\\n    // Get pseudo-random positive integer values\\n    for (i = 0; i < N; i++) {\\n        ret[i] = drand(0, INT_MAX);\\n    }\\n    return ret;\\n}\\n\\n/*\\n * A pseudo-random number between two positive integer values\\n */\\ndouble drand(int xmin, int xmax)\\n{\\n    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;\\n}\\n\",\"path\":\"src/quicksort.c\"}],\"hypothesis\":\"A single OpenMP team performing stable byte-radix passes with thread-private histograms and contiguous per-thread input chunks will replace partition-induced random accesses with cache-local sequential scans and disjoint output ranges, improving large-array sorting throughput on four ARM cores.\",\"notes\":\"The OpenMP path is conditional; the same stable radix layout remains a correct sequential fallback, with qsort only for allocation failure.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Replace recursive randomized partitioning with a signed-order stable byte-radix sort, and for sufficiently large arrays use per-thread private histograms plus computed disjoint scatter offsets inside one OpenMP parallel region.\"]}"}}

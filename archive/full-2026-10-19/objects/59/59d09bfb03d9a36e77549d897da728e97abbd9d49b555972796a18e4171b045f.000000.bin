#include <cassert>
#include <climits>
#include <cstddef>
#include <cstdio>
#include <vector>

int main() {
    int n, s;
    if (std::scanf("%d%d", &n, &s) != 2) return 0;

    assert(s > 0 && s < n);
    assert(n > 0 && n < 8000);

    const std::size_t matrixSize = static_cast<std::size_t>(n) * n;
    std::vector<int> matrix(matrixSize);
    for (std::size_t i = 0; i < matrixSize; ++i) {
        std::scanf("%d", &matrix[i]);
    }

    // Keep the sum of each column over the current S-row band.
    std::vector<long long> columnSums(n, 0);
    for (int row = 0; row < s; ++row) {
        const std::size_t rowBase = static_cast<std::size_t>(row) * n;
        for (int col = 0; col < n; ++col) {
            columnSums[col] += matrix[rowBase + col];
        }
    }

    std::vector<long long> prefix(n + 1, 0);
    long long maxSum = LLONG_MIN;

    // For each row band, form a horizontal prefix and work-share its windows.
    // Rolling the band down costs O(N) per row, so the total work is O(N^2).
    #pragma omp parallel shared(matrix, columnSums, prefix, maxSum, n, s)
    {
        for (int top = 0; top <= n - s; ++top) {
            #pragma omp single
            {
                prefix[0] = 0;
                for (int col = 0; col < n; ++col) {
                    prefix[col + 1] = prefix[col] + columnSums[col];
                }
            }

            #pragma omp for schedule(static) reduction(max : maxSum)
            for (int left = 0; left <= n - s; ++left) {
                const long long sum = prefix[left + s] - prefix[left];
                if (sum > maxSum) maxSum = sum;
            }

            if (top < n - s) {
                const std::size_t leavingBase = static_cast<std::size_t>(top) * n;
                const std::size_t enteringBase = static_cast<std::size_t>(top + s) * n;
                #pragma omp for schedule(static)
                for (int col = 0; col < n; ++col) {
                    columnSums[col] +=
                        static_cast<long long>(matrix[enteringBase + col]) -
                        matrix[leavingBase + col];
                }
            }
        }
    }

    std::printf("%lld\n", maxSum);
    return 0;
}

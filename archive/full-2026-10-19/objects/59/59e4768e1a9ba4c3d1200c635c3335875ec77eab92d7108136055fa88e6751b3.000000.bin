{
  "src/nbody.c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nstatic float *allocate_positions(int n) {\n  if (n <= 0)\n    return NULL;\n  return (float *)malloc((size_t)n * 3 * sizeof(float));\n}\n\n/* All threads in the current team participate, including on fallback. */\nstatic void body_force_scalar_workshare(Body *p, float dt, int n) {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/* Preserve scalar source order and the original sqrt/division precision. */\n#if defined(__GNUC__) && !defined(__clang__)\n__attribute__((optimize(\"no-math-errno\")))\n#endif\nstatic void body_force_packed_workshare(\n    Body *p, float dt, int n,\n    const float *restrict x, const float *restrict y,\n    const float *restrict z) {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n  for (int i = 0; i < n; ++i) {\n    const float xi = x[i];\n    const float yi = y[i];\n    const float zi = z[i];\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; ++j) {\n      float dx = x[j] - xi;\n      float dy = y[j] - yi;\n      float dz = z[j] - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/* The snapshot barrier precedes all force reads; the force barrier follows. */\nstatic void body_force_workshare(Body *p, float dt, int n,\n                                 float *positions) {\n  if (positions == NULL) {\n    body_force_scalar_workshare(p, dt, n);\n    return;\n  }\n\n  float *x = positions;\n  float *y = x + n;\n  float *z = y + n;\n\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n  for (int i = 0; i < n; ++i) {\n    x[i] = p[i].x;\n    y[i] = p[i].y;\n    z[i] = p[i].z;\n  }\n\n  body_force_packed_workshare(p, dt, n, x, y, z);\n}\n\n/* Preserve the standalone force-update entry point and per-call state. */\nvoid body_force(Body *p, float dt, int n) {\n  float *positions = allocate_positions(n);\n#ifdef _OPENMP\n#pragma omp parallel\n#endif\n  {\n    body_force_workshare(p, dt, n, positions);\n  }\n  free(positions);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n  float *positions = allocate_positions(nbodies);\n\n  /* Reuse one team and scratch allocation, refreshing positions each step. */\n#ifdef _OPENMP\n#pragma omp parallel\n#endif\n  {\n    for (int iter = 0; iter < N_ITER; iter++) {\n      body_force_workshare(bodies, DT, nbodies, positions);\n\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n      for (int i = 0; i < nbodies; i++) {\n        bodies[i].x += bodies[i].vx * DT;\n        bodies[i].y += bodies[i].vy * DT;\n        bodies[i].z += bodies[i].vz * DT;\n      }\n    }\n  }\n\n  free(positions);\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n"
}

#include "knn.h"

/* Packed entry for top-k list */
typedef struct {
    float d;
    char label;
} Entry;

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    /* Count total points across all groups */
    int total_points = 0;
    for (int i = 0; i < n_groups; i++) {
        total_points += groups[i].length;
    }

    /* Flatten point coordinates and labels into contiguous arrays */
    float *xs = (float *)malloc(total_points * sizeof(float));
    float *ys = (float *)malloc(total_points * sizeof(float));
    char *labels_all = (char *)malloc(total_points * sizeof(char));

    int idx = 0;
    for (int i = 0; i < n_groups; i++) {
        Group g = groups[i];
        for (int j = 0; j < g.length; j++) {
            xs[idx] = g.points[j].x;
            ys[idx] = g.points[j].y;
            labels_all[idx] = g.label;
            idx++;
        }
    }

    /* Allocate top-k array of packed entries */
    Entry *entries = (Entry *)malloc(k * sizeof(Entry));
    for (int i = 0; i < k; i++) {
        entries[i].d = -1.0f;
        entries[i].label = -1;
    }

    float qx = to_evaluate.x;
    float qy = to_evaluate.y;

    /* Main loop over all points (sequential access) */
    for (int i = 0; i < total_points; i++) {
        float dx = xs[i] - qx;
        float dy = ys[i] - qy;
        float d = dx*dx + dy*dy;

        /* Insert into sorted top-k array */
        for (int x = 0; x < k; x++) {
            if (d < entries[x].d || entries[x].d == -1.0f) {
                for (int y = k-1; y > x; y--) {
                    entries[y] = entries[y-1];
                }
                entries[x].d = d;
                entries[x].label = labels_all[i];
                break;
            }
        }
    }

    /* Extract labels for frequency counting */
    char *labels = (char *)malloc(k * sizeof(char));
    for (int i = 0; i < k; i++) {
        labels[i] = entries[i].label;
    }

    qsort(labels, k, sizeof(char), compare_for_sort);

    /* Find most frequent label */
    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (int i = 1; i < k; i++) {
        if (labels[i] != labels[i-1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i-1];
                most_frequent_count = current_frequency;
            }
            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k-1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i-1];
            most_frequent_count = current_frequency;
        }
    }

    free(xs);
    free(ys);
    free(labels_all);
    free(entries);
    free(labels);

    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

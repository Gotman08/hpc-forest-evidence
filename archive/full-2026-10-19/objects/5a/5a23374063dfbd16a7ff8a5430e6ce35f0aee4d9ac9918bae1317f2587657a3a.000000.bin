"""Verify and expand review material; large input duplicates stay reconstructible."""
import hashlib
import importlib.util
import json
import shutil
from pathlib import Path
here=Path(__file__).resolve().parent
out=here.parents[1]/"outputs/Marathon22-autonome"
spec=importlib.util.spec_from_file_location("restore",out/"cadre-execution/restaurer-preuves.py")
module=importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
bundle=out/"preuves-compactes.tar.gz"
assert hashlib.sha256(bundle.read_bytes()).hexdigest()=="7118cf2d3cf68a17cb5b34bf7c59e761b790b85b4923f6686cf2fe79be4a6c59"
def selected(item):
    if Path(item["path"]).name=="stdin.data":
        return False
    if "official" in item and Path(item["official"]["member"]).suffix.lower() not in {".c",".cpp",".cc",".cxx",".h",".hpp",".inc"}:
        return False
    return True
dest=here/"restored-review"
receipt=module.restore(bundle,out/"sources-officielles",dest,selected)
shutil.copytree(dest,out/"resultats")
(out/"verification-locale.json").write_text(json.dumps(receipt,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
print(json.dumps(receipt,ensure_ascii=False))

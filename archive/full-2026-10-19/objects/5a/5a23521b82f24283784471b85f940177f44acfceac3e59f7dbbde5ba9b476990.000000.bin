      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <cstring>\n#include <limits>\n#include <memory>\n#include <vector>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing Word = std::uint32_t;\nusing Element = std::int32_t;\nusing Sum = std::int64_t;\n\nclass FastInput {\n    static constexpr std::size_t capacity = 1u << 16;\n    unsigned char buffer_[capacity + 1];\n    std::size_t position_ = 0;\n    std::size_t available_ = 0;\n\n    void refill() {\n        available_ = std::fread(buffer_, 1, capacity, stdin);\n        position_ = 0;\n        buffer_[available_] = 0;\n    }\n\n    int next_byte() {\n        if (position_ == available_) {\n            refill();\n            if (available_ == 0) return EOF;\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    bool read_int(int& value) {\n        int c = next_byte();\n        while (c != EOF && c <= ' ') c = next_byte();\n        if (c == EOF) return false;\n        const bool negative = c == '-';\n        if (c == '-' || c == '+') c = next_byte();\n        Word magnitude = 0;\n        while (c >= '0' && c <= '9') {\n            magnitude = magnitude * 10u + static_cast<Word>(c - '0');\n            c = next_byte();\n        }\n        const std::int64_t wide = static_cast<std::int64_t>(magnitude);\n        value = static_cast<int>(negative ? -wide : wide);\n        return true;\n    }\n\n    bool read_words(Word* __restrict__ destination, std::size_t count) {\n        unsigned char* cursor = buffer_ + position_;\n        unsigned char* end = buffer_ + available_;\n        for (std::size_t i = 0; i < count; ++i) {\n            for (;;) {\n                while (cursor != end && *cursor <= ' ') ++cursor;\n                if (cursor != end) break;\n                refill();\n                cursor = buffer_;\n                end = buffer_ + available_;\n                if (available_ == 0) return false;\n            }\n\n            const bool negative = *cursor == '-';\n            if (*cursor == '-' || *cursor == '+') ++cursor;\n            Word magnitude = 0;\n            for (;;) {\n                unsigned digit = static_cast<unsigned>(*cursor)\n                               - static_cast<unsigned>('0');\n                while (digit < 10u) {\n                    magnitude = magnitude * 10u + digit;\n                    ++cursor;\n                    digit = static_cast<unsigned>(*cursor)\n                          - static_cast<unsigned>('0');\n                }\n                if (cursor != end) {\n                    ++cursor;\n                    break;\n                }\n                refill();\n                cursor = buffer_;\n                end = buffer_ + available_;\n                if (available_ == 0) break;\n            }\n            destination[i] = negative ? Word(0) - magnitude : magnitude;\n        }\n        position_ = static_cast<std::size_t>(cursor - buffer_);\n        return true;\n    }\n};\n\nstatic inline Element signed_value(Word bits) {\n    Element value;\n    std::memcpy(&value, &bits, sizeof(value));\n    return value;\n}\n\nstatic inline void add_row(Sum* __restrict__ columns,\n                           const Word* __restrict__ row, int count) {\n    #pragma omp simd\n    for (int c = 0; c < count; ++c) {\n        columns[c] += static_cast<Sum>(signed_value(row[c]));\n    }\n}\n\nstatic inline void add_summary(Sum* __restrict__ columns,\n                               const Sum* __restrict__ summary, int count) {\n    #pragma omp simd\n    for (int c = 0; c < count; ++c) {\n        columns[c] += summary[c];\n    }\n}\n\nstatic inline Sum advance_prefix(\n        Sum* __restrict__ columns,\n        const Word* __restrict__ incoming,\n        const Word* __restrict__ outgoing, int count) {\n    Sum delta_sum = 0;\n    #pragma omp simd reduction(+:delta_sum)\n    for (int c = 0; c < count; ++c) {\n        const Sum delta = static_cast<Sum>(signed_value(incoming[c]))\n                        - static_cast<Sum>(signed_value(outgoing[c]));\n        columns[c] += delta;\n        delta_sum += delta;\n    }\n    return delta_sum;\n}\n\nstatic inline void advance_tile(\n        Sum* __restrict__ columns,\n        const Word* __restrict__ incoming,\n        const Word* __restrict__ outgoing, int count) {\n    #pragma omp simd\n    for (int c = 0; c < count; ++c) {\n        columns[c] += static_cast<Sum>(signed_value(incoming[c]))\n                    - static_cast<Sum>(signed_value(outgoing[c]));\n    }\n}\n\nstatic inline Sum horizontal_max(const Sum* columns, int n, int s,\n                                 Sum& first_window) {\n    Sum running = 0;\n    #pragma omp simd reduction(+:running)\n    for (int c = 0; c < s; ++c) running += columns[c];\n    first_window = running;\n    Sum best = running;\n    for (int c = s; c < n; ++c) {\n        running += columns[c] - columns[c - s];\n        best = std::max(best, running);\n    }\n    return best;\n}\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.read_int(n) || !input.read_int(s)) return 0;\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t elements = static_cast<std::size_t>(n) * n;\n    const bool parallel_work = elements >= 65536;\n    const int positions = n - s + 1;\n    int workers = 1;\n#ifdef _OPENMP\n    if (parallel_work) workers = omp_get_max_threads();\n#endif\n    const int bands = std::min(positions, workers);\n    constexpr int block_rows = 64;\n    constexpr int tile_columns = 512;\n    constexpr std::size_t input_tile = 1u << 14;\n    const int block_count = (n + block_rows - 1) / block_rows;\n\n    Sum saved_rows = 0;\n    for (int band = 0; band < bands; ++band) {\n        const int begin = band * positions / bands;\n        const int first_full = (begin + block_rows - 1) / block_rows;\n        const int end_full = (begin + s) / block_rows;\n        const int full_blocks = std::max(0, end_full - first_full);\n        saved_rows += static_cast<Sum>(full_blocks) * (block_rows - 1);\n    }\n    const bool use_summaries = saved_rows > n;\n\n    std::unique_ptr<Word[]> matrix(new Word[elements]);\n    Word* const data = matrix.get();\n    std::unique_ptr<Sum[]> summary_storage;\n    if (use_summaries) {\n        summary_storage.reset(\n            new Sum[static_cast<std::size_t>(block_count) * n]);\n    }\n    Sum* const summaries = summary_storage.get();\n    bool input_ok = true;\n    Sum maximum = std::numeric_limits<Sum>::lowest();\n\n    #pragma omp parallel if(parallel_work) reduction(max:maximum)\n    {\n        #pragma omp single\n        {\n            for (int block = 0; block < block_count; ++block) {\n                const int row_begin = block * block_rows;\n                const int row_end = std::min(n, row_begin + block_rows);\n                std::size_t offset = static_cast<std::size_t>(row_begin) * n;\n                const std::size_t block_end =\n                    static_cast<std::size_t>(row_end) * n;\n                while (offset < block_end) {\n                    const std::size_t count =\n                        std::min(input_tile, block_end - offset);\n                    if (!input.read_words(data + offset, count)) {\n                        input_ok = false;\n                        break;\n                    }\n                    offset += count;\n                }\n                if (!input_ok) break;\n\n                if (use_summaries) {\n                    #pragma omp task firstprivate(block, row_begin, row_end)\n                    {\n                        Sum* const destination = summaries\n                            + static_cast<std::size_t>(block) * n;\n                        std::fill(destination, destination + n, Sum(0));\n                        for (int row = row_begin; row < row_end; ++row) {\n                            const Word* const source = data\n                                + static_cast<std::size_t>(row) * n;\n                            add_row(destination, source, n);\n                        }\n                    }\n                }\n            }\n            #pragma omp taskwait\n        }\n\n        if (input_ok) {\n            #pragma omp for schedule(static)\n            for (int band = 0; band < bands; ++band) {\n                const int begin = band * positions / bands;\n                const int end = (band + 1) * positions / bands;\n                std::vector<Sum> column_storage(n, Sum(0));\n                Sum* const columns = column_storage.data();\n\n                int row = begin;\n                const int initial_end = begin + s;\n                while (row < initial_end) {\n                    if (use_summaries && row % block_rows == 0\n                        && row + block_rows <= initial_end) {\n                        const Sum* const source = summaries\n                            + static_cast<std::size_t>(row / block_rows) * n;\n                        add_summary(columns, source, n);\n                        row += block_rows;\n                    } else {\n                        const Word* const source = data\n                            + static_cast<std::size_t>(row) * n;\n                        add_row(columns, source, n);\n                        ++row;\n                    }\n                }\n\n                Sum first_window;\n                Sum band_maximum = horizontal_max(columns, n, s, first_window);\n                for (int top = begin + 1; top < end; ++top) {\n                    const Word* const incoming = data\n                        + static_cast<std::size_t>(top + s - 1) * n;\n                    const Word* const outgoing = data\n                        + static_cast<std::size_t>(top - 1) * n;\n                    first_window += advance_prefix(columns, incoming, outgoing, s);\n                    Sum running = first_window;\n                    band_maximum = std::max(band_maximum, running);\n\n                    for (int first = s; first < n; first += tile_columns) {\n                        const int count = std::min(tile_columns, n - first);\n                        advance_tile(columns + first, incoming + first,\n                                     outgoing + first, count);\n                        const int limit = first + count;\n                        for (int c = first; c < limit; ++c) {\n                            running += columns[c] - columns[c - s];\n                            band_maximum = std::max(band_maximum, running);\n                        }\n                    }\n                }\n                maximum = std::max(maximum, band_maximum);\n            }\n        }\n    }\n\n    if (!input_ok) return 0;\n    std::printf(\"%lld\\n\", static_cast<long long>(maximum));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char *bucket_sort(char *strings, int length, long int size) {
    char *buffer;
    char *source = strings;
    char *destination;
    long int counts[256];
    long int positions[256];

    if (size <= 1 || length <= 1)
        return strings;

    if ((size_t)size > ((size_t)-1) / (size_t)length) {
        fprintf(stderr, "Sort buffer size is too large\n");
        exit(EXIT_FAILURE);
    }

    buffer = (char *)malloc((size_t)size * (size_t)length);
    if (buffer == NULL) {
        fprintf(stderr, "Unable to allocate sort buffer\n");
        exit(EXIT_FAILURE);
    }
    destination = buffer;

    for (int position = length - 2; position >= 0; position--) {
        long int next = 0;

        memset(counts, 0, sizeof(counts));
        for (long int i = 0; i < size; i++) {
            unsigned char key = (unsigned char)source[(size_t)i * (size_t)length + (size_t)position];
            counts[key]++;
        }

        for (int key = 0; key < 256; key++) {
            positions[key] = next;
            next += counts[key];
        }

        for (long int i = 0; i < size; i++) {
            size_t source_offset = (size_t)i * (size_t)length;
            unsigned char key = (unsigned char)source[source_offset + (size_t)position];
            size_t destination_offset = (size_t)positions[key]++ * (size_t)length;
            memcpy(destination + destination_offset, source + source_offset, (size_t)length);
        }

        char *temporary = source;
        source = destination;
        destination = temporary;
    }

    if (source == strings)
        free(buffer);
    else
        free(strings);

    return source;
}

void load(char **vString, long int *N, int *l, int *os, int *nb) {
    char *strings = NULL;
    int len, offset, nbucket;
    long int n;

    if (!fscanf(stdin, "%d", &len)) {
        printf("ERROR len\n");
        exit(1);
    }
    if (!fscanf(stdin, "%ld", &n)) {
        printf("ERROR n\n");
        exit(1);
    }
    if (!fscanf(stdin, "%d", &offset)) {
        printf("ERROR offset\n");
        exit(1);
    }
    if (!fscanf(stdin, "%d", &nbucket)) {
        printf("ERROR nbucket\n");
        exit(1);
    }

    nbucket = nbucket + 1;
    len = len + 1;
    strings = (char *)calloc((size_t)n, (size_t)len);
    if (strings == NULL && n > 0) {
        fprintf(stderr, "Unable to allocate input strings\n");
        exit(EXIT_FAILURE);
    }

    for (long int i = 0; i < n; i++) {
        if (!fscanf(stdin, "%s", strings + (size_t)i * (size_t)len)) {
            printf("ERROR %ld\n", i);
            exit(1);
        }
    }

    *vString = strings;
    *N = n;
    *l = len;
    *os = offset;
    *nb = nbucket;
}

void save(const char *strings, long int n, int len) {
    for (long int i = 0; i < n; i++)
        printf("%s\n", strings + (size_t)i * (size_t)len);
}

int main(int ac, char **av) {
    char *strings = NULL;
    long int N = 0;
    int len = 0;
    int offset, nbuckets;

    load(&strings, &N, &len, &offset, &nbuckets);
    (void)offset;
    (void)nbuckets;

    strings = bucket_sort(strings, len, N);
    save(strings, N, len);
    free(strings);

    return EXIT_SUCCESS;
}

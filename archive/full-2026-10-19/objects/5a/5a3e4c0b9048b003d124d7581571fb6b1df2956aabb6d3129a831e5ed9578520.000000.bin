{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <algorithm>\\n#include <cstdint>\\n#include <iostream>\\n#include <vector>\\n#include <omp.h>\\n\\nusing namespace std;\\n\\nconstexpr int MOD = 1000000007;\\n\\nint main() {\\n    ios::sync_with_stdio(false);\\n    cin.tie(nullptr);\\n\\n    int n;\\n    size_t m;\\n    if (!(cin >> n >> m)) return 0;\\n\\n    vector<uint64_t> blocked;\\n    blocked.reserve(m);\\n    for (size_t i = 0; i < m; ++i) {\\n        int y, x;\\n        cin >> y >> x;\\n        blocked.push_back(static_cast<uint64_t>(static_cast<uint32_t>(y)) *\\n                          static_cast<uint64_t>(n) + static_cast<uint32_t>(x));\\n    }\\n    sort(blocked.begin(), blocked.end());\\n    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\\n\\n    vector<int> dp(n, 0);\\n    dp[0] = 1;\\n\\n    size_t rowBegin = 0;\\n    size_t rowEnd = 0;\\n    const uint64_t firstRowEnd = static_cast<uint64_t>(n);\\n    while (rowEnd < blocked.size() && blocked[rowEnd] < firstRowEnd) ++rowEnd;\\n    size_t obstacle = rowBegin;\\n    int carry = 0;\\n    for (int x = 0; x < n; ++x) {\\n        if (obstacle < rowEnd && blocked[obstacle] == static_cast<uint64_t>(x)) {\\n            dp[x] = 0;\\n            carry = 0;\\n            ++obstacle;\\n        } else {\\n            int value = dp[x] + carry;\\n            if (value >= MOD) value -= MOD;\\n            dp[x] = value;\\n            carry = value;\\n        }\\n    }\\n\\n    if (n > 1) {\\n        vector<int> tails;\\n        vector<int> firstBlocked;\\n        vector<int> offsets;\\n\\n#pragma omp parallel\\n        {\\n            const int threads = omp_get_num_threads();\\n            const int tid = omp_get_thread_num();\\n            const int begin = static_cast<int>(static_cast<long long>(n) * tid / threads);\\n            const int end = static_cast<int>(static_cast<long long>(n) * (tid + 1) / threads);\\n\\n#pragma omp single\\n            {\\n                tails.resize(threads);\\n                firstBlocked.resize(threads);\\n                offsets.resize(threads);\\n            }\\n\\n            for (int y = 1; y < n; ++y) {\\n#pragma omp single\\n                {\\n                    rowBegin = rowEnd;\\n                    const uint64_t limit = static_cast<uint64_t>(y + 1) * static_cast<uint64_t>(n);\\n                    while (rowEnd < blocked.size() && blocked[rowEnd] < limit) ++rowEnd;\\n                }\\n\\n                const uint64_t base = static_cast<uint64_t>(y) * static_cast<uint64_t>(n);\\n                const auto localEnd = blocked.begin() + static_cast<ptrdiff_t>(rowEnd);\\n                auto nextBlocked = lower_bound(blocked.begin() + static_cast<ptrdiff_t>(rowBegin),\\n                                               localEnd, base + static_cast<uint64_t>(begin));\\n                int value = 0;\\n                int first = end;\\n                for (int x = begin; x < end; ++x) {\\n                    if (nextBlocked != localEnd && *nextBlocked == base + static_cast<uint64_t>(x)) {\\n                        value = 0;\\n                        if (first == end) first = x;\\n                        ++nextBlocked;\\n                    } else {\\n                        value += dp[x];\\n                        if (value >= MOD) value -= MOD;\\n                    }\\n                    dp[x] = value;\\n                }\\n                tails[tid] = value;\\n                firstBlocked[tid] = first;\\n\\n#pragma omp barrier\\n#pragma omp single\\n                {\\n                    int prefix = 0;\\n                    for (int t = 0; t < threads; ++t) {\\n                        offsets[t] = prefix;\\n                        const int segmentEnd = static_cast<int>(static_cast<long long>(n) * (t + 1) / threads);\\n                        if (firstBlocked[t] == segmentEnd) {\\n                            prefix += tails[t];\\n                            if (prefix >= MOD) prefix -= MOD;\\n                        } else {\\n                            prefix = tails[t];\\n                        }\\n                    }\\n                }\\n\\n                const int offset = offsets[tid];\\n                if (offset != 0) {\\n                    for (int x = begin; x < firstBlocked[tid]; ++x) {\\n                        int valueWithOffset = dp[x] + offset;\\n                        dp[x] = valueWithOffset >= MOD ? valueWithOffset - MOD : valueWithOffset;\\n                    }\\n                }\\n#pragma omp barrier\\n            }\\n        }\\n    }\\n\\n    cout << dp[n - 1] << '\\\\n';\\n    return 0;\\n}\\n\",\"path\":\"src/solution.cpp\"}],\"hypothesis\":\"Sparse sorted blockers preserve the best measured persistent OpenMP segmented prefix DP while removing the quadratic blocked-cell allocation, so it remains viable for the full stated size range.\",\"notes\":\"The parallel carry scan applies each preceding segment's offset only before that segment's first blocker; sorted unique blocker keys also preserve baseline behavior for duplicate obstacle records.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[\"8e05a4e147e34181\",\"857a562080f74491\"],\"transformations\":[\"Replace the dense blocked-cell matrix with sorted, deduplicated packed sparse blocker coordinates.\",\"Combine sparse per-row blocker lookup with persistent OpenMP segmented in-place DP and its serial segment-carry scan.\",\"Retain one-row in-place DP, conditional modular reduction, and buffered iostreams.\"]}"}}

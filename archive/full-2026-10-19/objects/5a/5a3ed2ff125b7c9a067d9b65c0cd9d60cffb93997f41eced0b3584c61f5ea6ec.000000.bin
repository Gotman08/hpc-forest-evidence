{
  "name": "forest-matrix-preflight-r1b",
  "command": "bash -lc 'set -euo pipefail\narchive=/scratch_p/nimarano/hpc-forest-native-matrix-r1-light-rpc.tar.gz\nshared=/scratch_p/nimarano/hpc-forest-native-matrix-20261015-r1-launchfix1\npy=/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python\ntest ! -e \"$shared\"\nprintf '\"'\"'%s  %s\\n'\"'\"' '\"'\"'ee70362a5d1fbd195f1420971fba96d44524e58f82a334983632c3fcd95a0bcb'\"'\"' \"$archive\" | sha256sum -c -\nmkdir \"$shared\"\ntar -xzf \"$archive\" --strip-components=1 -C \"$shared\"\n\"$py\" - \"$shared\" <<'\"'\"'PYCODE'\"'\"'\nimport hashlib,json,shutil,stat,sys,zipfile\nfrom pathlib import Path\nroot=Path(sys.argv[1]).resolve()\nfor name,expected in json.loads((root/'\"'\"'payload-manifest.json'\"'\"').read_text()).items():\n    p=root/name\n    assert p.resolve().is_relative_to(root.resolve())\n    assert hashlib.sha256(p.read_bytes()).hexdigest()==expected,name\nfor item in json.loads((root/'\"'\"'existing-official-dependencies.json'\"'\"').read_text()):\n    source=Path(item['\"'\"'source'\"'\"']);target=root/item['\"'\"'destination'\"'\"']\n    assert hashlib.sha256(source.read_bytes()).hexdigest()==item['\"'\"'sha256'\"'\"']\n    shutil.copyfile(source,target)\n    assert hashlib.sha256(target.read_bytes()).hexdigest()==item['\"'\"'sha256'\"'\"']\nwith zipfile.ZipFile(root/'\"'\"'project.zip'\"'\"') as z:\n    for info in z.infolist():\n        assert info.filename.startswith('\"'\"'HPC-Forest/'\"'\"') and not stat.S_ISLNK(info.external_attr >> 16)\n        p=root/'\"'\"'project'\"'\"'/info.filename.removeprefix('\"'\"'HPC-Forest/'\"'\"')\n        assert p.resolve().is_relative_to(root/'\"'\"'project'\"'\"')\n        if info.is_dir():p.mkdir(parents=True,exist_ok=True)\n        else:\n            p.parent.mkdir(parents=True,exist_ok=True)\n            p.write_bytes(z.read(info))\nprint('\"'\"'Source and official dependencies verified'\"'\"',flush=True)\nPYCODE\nexport PYTHONPATH=\"$shared/project/src:$shared/qa-deps\"\nexport PYTHONDONTWRITEBYTECODE=1\nexport PYTEST_DISABLE_PLUGIN_AUTOLOAD=1\nexport OPENBLAS_NUM_THREADS=1\nulimit -s unlimited\ncd \"$shared/project\"\nflock -w 120 /tmp/hpc-forest-preflight-nimarano.lock \"$py\" -m pytest tests -q -p no:cacheprovider --junitxml=\"$shared/preflight-junit.xml\" > \"$shared/preflight-tests.log\" 2>&1\ncat \"$shared/preflight-tests.log\"\nexec \"$py\" -u \"$shared/project/examples/marathon22/prepare_archive_suite.py\" --root \"$shared\"\n'",
  "arch": "armgpu",
  "cpus_per_task": 4,
  "mem_gb": 16,
  "gpus_per_node": 0,
  "time_limit": "01:00:00",
  "workdir": "/scratch_p/nimarano",
  "spack_packages": [
    "/zrtbeqke25s2vbqo4yrhsowjz7mg3pjf"
  ]

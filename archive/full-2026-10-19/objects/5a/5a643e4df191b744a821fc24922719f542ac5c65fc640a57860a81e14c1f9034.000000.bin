"""ROOT-only four cold byte copies; no census, launch, RPC, worker or lock read.

Import defines functions only. ROOT must supply real pinned startup metadata,
an independent code/test review and the exact new neutral completion before main.
Source reads deliberately share READ|WRITE|DELETE. Snapshot comparisons detect
observed changes; they do not exclude writers, replacements or unobserved ABA.
"""
from __future__ import annotations

import argparse
import ast
from datetime import UTC, datetime
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import time


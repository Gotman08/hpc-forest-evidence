    'receiver_review': {'path': str(R5/'revue-preparation-independante-r1/REVUE-RECEPTEUR-DYNAMIQUE-R8-R5-PREPARATION.json'),
                        'sha256': '05bed4a91046889d422107fc7e3a765337cacfcfe62843a79d004ed2775b628a'},
    'receiver_neutral_completion': {'path': str(R5/'TESTS-NEUTRES-ROOT-01.json'),
                                   'sha256': '0dd4a7c930e31424f5b00ae118c696841323308d3015ed87b6b0cf708f40f8af'}}
COPY_NAMES = {'routes': 'ROUTES-INITIALES-COPIE-FROIDE.json',
              'state': 'ETAT-PASSIF-COPIE-FROIDE.json',
              'stdout.log': 'STDOUT-COPIE-FROIDE.bin',

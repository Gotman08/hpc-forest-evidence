#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#if defined(__aarch64__) && defined(__ARM_NEON)
#include <arm_neon.h>
#endif

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

/* Positions and velocities of one body. */
typedef struct { float x, y, z, vx, vy, vz; } Body;
typedef struct { float x, y, z; } Position;

/* Integrated outputs also produce the next compact position snapshot. */
static inline void finish_body(const Body *current, Body *next,
                               Position *next_positions,
                               float dt, int i,
                               float fx, float fy, float fz,
                               int integrate) {
  const float vx = current[i].vx + dt*fx;
  const float vy = current[i].vy + dt*fy;
  const float vz = current[i].vz + dt*fz;
  next[i].vx = vx;
  next[i].vy = vy;
  next[i].vz = vz;
  if (integrate) {
    const float x = current[i].x + vx*dt;
    const float y = current[i].y + vy*dt;
    const float z = current[i].z + vz*dt;
    next[i].x = x;
    next[i].y = y;
    next[i].z = z;
    next_positions[i].x = x;
    next_positions[i].y = y;
    next_positions[i].z = z;
  }
}

/* A null snapshot selects the allocation-failure path. */
static inline void force_one(const Position *positions,
                             const Body *current, Body *next,
                             Position *next_positions,
                             float dt, int n, int i, int integrate) {
  const float x = positions != NULL ? positions[i].x : current[i].x;
  const float y = positions != NULL ? positions[i].y : current[i].y;
  const float z = positions != NULL ? positions[i].z : current[i].z;
  float fx = 0.0f;
  float fy = 0.0f;
  float fz = 0.0f;

  for (int j = 0; j < n; ++j) {
    const float sx = positions != NULL ? positions[j].x : current[j].x;
    const float sy = positions != NULL ? positions[j].y : current[j].y;
    const float sz = positions != NULL ? positions[j].z : current[j].z;
    float dx = sx - x;
    float dy = sy - y;
    float dz = sz - z;
    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
    float inv_dist = 1 / sqrt(sqrd_dist);
    float inv_dist3 = inv_dist * inv_dist * inv_dist;
    fx += dx * inv_dist3;
    fy += dy * inv_dist3;
    fz += dz * inv_dist3;
  }

  finish_body(current, next, next_positions, dt, i,
              fx, fy, fz, integrate);
}

/* Two targets reuse source loads; each force sum retains ascending j order. */
static inline void force_pair(const Position *restrict positions,
                              const Body *current, Body *next,
                              Position *restrict next_positions,
                              float dt, int n, int i, int integrate) {
  if (n - i < 2) {
    force_one(positions, current, next, next_positions,
              dt, n, i, integrate);
    return;
  }

  const float x0 = positions[i].x;
  const float y0 = positions[i].y;
  const float z0 = positions[i].z;
  const float x1 = positions[i + 1].x;
  const float y1 = positions[i + 1].y;
  const float z1 = positions[i + 1].z;
  float fx0 = 0.0f;
  float fy0 = 0.0f;
  float fz0 = 0.0f;
  float fx1 = 0.0f;
  float fy1 = 0.0f;
  float fz1 = 0.0f;
  int j = 0;

#if defined(__aarch64__) && defined(__ARM_NEON)
  const float64x2_t one = vdupq_n_f64(1.0);
  for (; j + 1 < n; j += 2) {
    const float xj = positions[j].x;
    const float yj = positions[j].y;
    const float zj = positions[j].z;
    const float xk = positions[j + 1].x;
    const float yk = positions[j + 1].y;
    const float zk = positions[j + 1].z;

    float dx00 = xj - x0;
    float dy00 = yj - y0;
    float dz00 = zj - z0;
    float dx01 = xk - x0;
    float dy01 = yk - y0;
    float dz01 = zk - z0;
    float dx10 = xj - x1;
    float dy10 = yj - y1;
    float dz10 = zj - z1;
    float dx11 = xk - x1;
    float dy11 = yk - y1;
    float dz11 = zk - z1;
    float sqrd_dist00 = dx00*dx00 + dy00*dy00 + dz00*dz00 + SOFTENING;
    float sqrd_dist01 = dx01*dx01 + dy01*dy01 + dz01*dz01 + SOFTENING;
    float sqrd_dist10 = dx10*dx10 + dy10*dy10 + dz10*dz10 + SOFTENING;
    float sqrd_dist11 = dx11*dx11 + dy11*dy11 + dz11*dz11 + SOFTENING;

    /* Each double-precision batch contains two sources for one target. */
    float32x2_t squared0 = vdup_n_f32(sqrd_dist00);
    squared0 = vset_lane_f32(sqrd_dist01, squared0, 1);
    float32x2_t squared1 = vdup_n_f32(sqrd_dist10);
    squared1 = vset_lane_f32(sqrd_dist11, squared1, 1);
    const float64x2_t inverse0 = vdivq_f64(
        one, vsqrtq_f64(vcvt_f64_f32(squared0)));
    const float64x2_t inverse1 = vdivq_f64(
        one, vsqrtq_f64(vcvt_f64_f32(squared1)));
    const float32x4_t inverse = vcombine_f32(
        vcvt_f32_f64(inverse0), vcvt_f32_f64(inverse1));
    const float32x4_t inverse3 = vmulq_f32(
        vmulq_f32(inverse, inverse), inverse);
    const float inv00 = vgetq_lane_f32(inverse3, 0);
    const float inv01 = vgetq_lane_f32(inverse3, 1);
    const float inv10 = vgetq_lane_f32(inverse3, 2);
    const float inv11 = vgetq_lane_f32(inverse3, 3);

    fx0 += dx00 * inv00;
    fy0 += dy00 * inv00;
    fz0 += dz00 * inv00;
    fx0 += dx01 * inv01;
    fy0 += dy01 * inv01;
    fz0 += dz01 * inv01;
    fx1 += dx10 * inv10;
    fy1 += dy10 * inv10;
    fz1 += dz10 * inv10;
    fx1 += dx11 * inv11;
    fy1 += dy11 * inv11;
    fz1 += dz11 * inv11;
  }
#endif

  for (; j < n; ++j) {
    const float xj = positions[j].x;
    const float yj = positions[j].y;
    const float zj = positions[j].z;
    float dx0 = xj - x0;
    float dy0 = yj - y0;
    float dz0 = zj - z0;
    float dx1 = xj - x1;
    float dy1 = yj - y1;
    float dz1 = zj - z1;
    float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;
    float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;
    float inv_dist0 = 1 / sqrt(sqrd_dist0);
    float inv_dist1 = 1 / sqrt(sqrd_dist1);
    float inv_dist30 = inv_dist0 * inv_dist0 * inv_dist0;
    float inv_dist31 = inv_dist1 * inv_dist1 * inv_dist1;
    fx0 += dx0 * inv_dist30;
    fy0 += dy0 * inv_dist30;
    fz0 += dz0 * inv_dist30;
    fx1 += dx1 * inv_dist31;
    fy1 += dy1 * inv_dist31;
    fz1 += dz1 * inv_dist31;
  }

  finish_body(current, next, next_positions, dt, i,
              fx0, fy0, fz0, integrate);
  finish_body(current, next, next_positions, dt, i + 1,
              fx1, fy1, fz1, integrate);
}

/* Preserve the force-only operation for independent and repeated calls. */
void body_force(Body *p, float dt, int n) {
  if (n <= 0) {
    return;
  }

  const size_t count = (size_t)n;
  Position *positions = NULL;
  if (count <= (size_t)-1 / sizeof(*positions)) {
    positions = (Position *)malloc(count * sizeof(*positions));
  }
  if (positions == NULL) {
#ifdef _OPENMP
#pragma omp parallel for schedule(static) if (n >= 64)
#endif
    for (int i = 0; i < n; ++i) {
      force_one(NULL, p, p, NULL, dt, n, i, 0);
    }
    return;
  }

  for (int i = 0; i < n; ++i) {
    positions[i].x = p[i].x;
    positions[i].y = p[i].y;
    positions[i].z = p[i].z;
  }

  const int pair_count = n / 2 + n % 2;
#ifdef _OPENMP
#pragma omp parallel for schedule(static) if (n >= 64)
#endif
  for (int pair = 0; pair < pair_count; ++pair) {
    force_pair(positions, p, p, NULL, dt, n, 2 * pair, 0);
  }
  free(positions);
}

/*
 * Read a binary dataset with initilized bodies.
 */
Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  return bodies;
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc,char **argv) {
  int nbodies;
  Body *bodies = read_dataset(&nbodies);
  Body *scratch = NULL;
  Position *positions = NULL;
  Position *alternate_positions = NULL;
  Body *result = bodies;

  if (nbodies > 0) {
    const size_t count = (size_t)nbodies;
    if (count <= (size_t)-1 / sizeof(*scratch) &&
        count <= (size_t)-1 / sizeof(*positions)) {
      scratch = (Body *)malloc(count * sizeof(*scratch));
      positions = (Position *)malloc(count * sizeof(*positions));
      alternate_positions = (Position *)malloc(
          count * sizeof(*alternate_positions));
    }
  }

  if (scratch != NULL && positions != NULL && alternate_positions != NULL) {
    const int pair_count = nbodies / 2 + nbodies % 2;
#ifdef _OPENMP
#pragma omp parallel if (nbodies >= 64)
#endif
    {
#ifdef _OPENMP
#pragma omp for schedule(static)
#endif
      for (int i = 0; i < nbodies; ++i) {
        positions[i].x = bodies[i].x;
        positions[i].y = bodies[i].y;
        positions[i].z = bodies[i].z;
      }

      for (int iter = 0; iter < N_ITER; ++iter) {
        const Body *current = (iter & 1) ? scratch : bodies;
        Body *next = (iter & 1) ? bodies : scratch;
        const Position *current_positions = (iter & 1)
            ? alternate_positions : positions;
        Position *next_positions = (iter & 1)
            ? positions : alternate_positions;

#ifdef _OPENMP
#pragma omp for schedule(static)
#endif
        for (int pair = 0; pair < pair_count; ++pair) {
          force_pair(current_positions, current, next, next_positions,
                     DT, nbodies, 2 * pair, 1);
        }
        /* This barrier completes both next-state buffers for the timestep. */
      }
    }
    result = (N_ITER & 1) ? scratch : bodies;
  } else {
    free(alternate_positions);
    free(positions);
    free(scratch);
    alternate_positions = NULL;
    positions = NULL;
    scratch = NULL;

    for (int iter = 0; iter < N_ITER; ++iter) {
      body_force(bodies, DT, nbodies);
      for (int i = 0; i < nbodies; ++i) {
        bodies[i].x += bodies[i].vx * DT;
        bodies[i].y += bodies[i].vy * DT;
        bodies[i].z += bodies[i].vz * DT;
      }
    }
  }

  write_dataset(nbodies, result);
  free(alternate_positions);
  free(positions);
  free(scratch);
  free(bodies);
  exit(EXIT_SUCCESS);
}

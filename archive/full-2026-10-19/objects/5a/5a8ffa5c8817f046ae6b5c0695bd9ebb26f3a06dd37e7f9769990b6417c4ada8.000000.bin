o_move(state_t * s) {\\n-    return queue_move(move_me(s, 0, 1)) ||\\n-        queue_move(move_me(s, 0, -1)) ||\\n-        queue_move(move_me(s, -1, 0)) ||\\n-        queue_move(move_me(s, 1, 0));\\n-}\\n-\\n void show_moves(const state_t * s, int nextPos) {\\n     if (s -> prev)\\n         show_moves(s -> prev, s -> c[0]);\\n@@ -336,17 +322,73 @@ int main() {\\n \\n     extend_table();\\n     queue_move(s);\\n+\\n+    enum { batch_capacity = 64, move_count = 4 };\\n+    static const int move_dy[move_count] = { 0, 0, -1, 1 };\\n+    static const int move_dx[move_count] = { 1, -1, 0, 0 };\\n+    state_t * parents[batch_capacity];\\n+    const size_t cells_per_move = (size_t) n_boxes + 1;\\n+    cidx_t * candidate_cells = malloc(\\n+        (size_t) batch_capacity * move_count * cells_per_move * sizeof(cidx_t));\\n+    uint8_t * candidate_valid = malloc((size_t) batch_capacity * move_count);\\n+    assert(candidate_cells && candidate_valid);\\n+\\n     while (!done) {\\n         state_t * head = next_level;\\n-        for (next_level = NULL; head && !done; head = head -> qnext)\\n-            do_move(head);\\n+        next_level = NULL;\\n+\\n+        while (head && !done) {\\n+            int batch_count = 0;\\n+            while (head && batch_count < batch_capacity) {\\n+                parents[batch_count++] = head;\\n+                head = head -> qnext;\\n+            }\\n+\\n+            if (batch_count == batch_capacity) {\\n+                #pragma omp parallel for schedule(static)\\n+                for (int i = 0; i < batch_count; i++) {\\n+                    for (int d = 0; d < move_count; d++) {\\n+                        const size_t slot = (size_t) i * move_count + d;\\n+                        candidate_valid[slot] = move_coords(\\n+                            parents[i], move_dy[d], move_dx[d],\\n+                            candidate_cells + slot * cells_per_move);\\n+                    }\\n+                }\\n+            } else {\\n+                for (int i = 0; i < batch_count; i++) {\\n+                    for (int d = 0; d < move_count; d++) {\\n+                        const size_t slot = (size_t) i * move_count + d;\\n+                        candidate_valid[slot] = move_coords(\\n+                            parents[i], move_dy[d], move_dx[d],\\n+                            candidate_cells + slot * cells_per_move);\\n+                    }\\n+                }\\n+            }\\n+\\n+            /* Commit in the original BFS and direction order for determinism. */\\n+            for (int i = 0; i < batch_count && !done; i++) {\\n+                for (int d = 0; d < move_count; d++) {\\n+                    const size_t slot = (size_t) i * move_count + d;\\n+                    if (!candidate_valid[slot]) continue;\\n+\\n+                    state_t * n = newstate(parents[i]);\\n+                    memcpy(n -> c, candidate_cells + slot * cells_per_move,\\n+                        sizeof(cidx_t) * cells_per_move);\\n+                    if (queue_move(n)) break;\\n+                }\\n+            }\\n+        }\\n \\n-        if (!next_level) {\\n+        if (!next_level && !done) {\\n             puts(\\\"no solution?\\\");\\n+            free(candidate_cells);\\n+            free(candidate_valid);\\n             return 1;\\n         }\\n     }\\n \\n+    free(candidate_cells);\\n+    free(candidate_valid);\\n     show_moves(done, -1);\\n \\n     free(buckets);\"}, {\"id\": \"bd615b32118c4f57\", \"role\": \"C\", \"commit\": \"75ef18377d9418b5b991877e850e4cbca8b846dc\", \"transformations\": {\"files\": [\"src/sokoban.c\"], \"retained\": [\"Factor legality checking from state allocation so legality checks can safely run in parallel over states and four directions.\", \"For frontiers of at least 256 states, use one OpenMP team with static 256-state tiles; process valid candidates serially in the existing order.\", \"Keep narrower BFS frontiers on the original serial path and preserve serial hash-table and queue updates.\"]}, \"mean_seconds\": 0.004898676338295142, \"diff\": \"diff --git a/src/sokoban.c b/src/sokoban.c\\nindex d9d7ddf..5050235 100644\\n--- a/src/sokoban.c\\n+++ b/src/sokoban.c\\n@@ -219,9 +219,14 @@ bool success(const state_t * s) {\\n     return true;\\n }\\n \\n-state_t * move_me(state_t * s,\\n-    const int dy,\\n-        const int dx) {\\n+typedef struct {\\n+    int c1;\\n+    int c2;\\n+    int at_box;\\n+} move_candidate_t;\\n+\\n+bool prepare_move(state_t * s, const int dy, const int dx,\\n+        move_candidate_t * candidate) {\\n     const int y = s -> c[0] / w;\\n     const int x = s -> c[0] % w;\\n     const int y1 = y + dy;\\n@@ -230,7 +235,7 @@ state_t * move_me(state_t * s,\\n \\n     if (y1 < 0 || y1 > h || x1 < 0 || x1 > w ||\\n         board[c1] == wall)\\n-        return NULL;\\n+        return false;\\n \\n     int at_box = 0;\\n     for (int i = 1; i <= n_boxes; i++) {\\n@@ -240,22 +245,30 @@ state_t * move_me(state_t * s,\\n         }\\n     }\\n \\n-    int c2;\\n+    int c2 = 0;\\n     if (at_box) {\\n         c2 = c1 + dy * w + dx;\\n         if (board[c2] == wall || !live[c2])\\n-            return NULL;\\n+            return false;\\n         for (int i = 1; i <= n_boxes; i++)\\n-            if (s -> c[i] == c2) return NULL;\\n+            if (s -> c[i] == c2) return false;\\n     }\\n \\n+    candidate -> c1 = c1;\\n+    candidate -> c2 = c2;\\n+    candidate -> at_box = at_box;\\n+    return true;\\n+}\\n+\\n+state_t * build_move(state_t * s, const move_candidate_t * candidate) {\\n     state_t * n = newstate(s);\\n     memcpy(n -> c + 1, s -> c + 1, sizeof(cidx_t) * n_boxes);\\n \\n     cidx_t * p = n -> c;\\n-    p[0] = c1;\\n+    p[0] = candidate -> c1;\\n \\n-    if (at_box) p[at_box] = c2;\\n+    if (candidate -> at_box)\\n+        p[candidate -> at_box] = candidate -> c2;\\n \\n     // leet bubble sort\\n     for (int i = n_boxes; --i;) {\\n@@ -270,6 +283,15 @@ state_t * move_me(state_t * s,\\n     return n;\\n }\\n \\n+state_t * move_me(state_t * s,\\n+    const int dy,\\n+        const int dx) {\\n+    move_candidate_t candidate;\\n+    if (!prepare_move(s, dy, dx, &candidate))\\n+        return NULL;\\n+    return build_move(s, &candidate);\\n+}\\n+\\n state_t * next_level, * done;\\n \\n bool queue_move(state_t * s) {\\n@@ -293,6 +315,63 @@ bool do_move(state_t * s) {\\n         queue_move(move_me(s, 1, 0));\\n }\\n \\n+enum {\\n+    PARALLEL_FRONTIER_THRESHOLD = 256,\\n+    PARALLEL_TILE = 256\\n+};\\n+\\n+void do_parallel_level(state_t * head, size_t count) {\\n+    state_t ** frontier = malloc(count * sizeof(*frontier));\\n+    assert(frontier);\\n+    size_t index = 0;\\n+    for (state_t * s = head; s; s = s -> qnext)\\n+        frontier[index++] = s;\\n+    assert(index == count);\\n+\\n+    const size_t tile_moves = (size_t)PARALLEL_TILE * 4;\\n+    move_candidate_t * moves = malloc(tile_moves * sizeof(*moves));\\n+    unsigned char * valid = malloc(tile_moves * sizeof(*valid));\\n+    assert(moves && valid);\\n+\\n+    next_level = NULL;\\n+#pragma omp parallel shared(frontier, moves, valid, count, done, next_level)\\n+    {\\n+        for (size_t base = 0; base < count && !done;\\n+                base += PARALLEL_TILE) {\\n+            size_t end = base + PARALLEL_TILE;\\n+            if (end > count) end = count;\\n+\\n+#pragma omp for schedule(static)\\n+            for (size_t i = base; i < end; i++) {\\n+                const size_t offset = (i - base) * 4;\\n+                for (int direction = 0; direction < 4; direction++) {\\n+                    const int dy[] = {0, 0, -1, 1};\\n+                    const int dx[] = {1, -1, 0, 0};\\n+                    valid[offset + direction] = prepare_move(frontier[i],\\n+                        dy[direction], dx[direction], &moves[offset + direction]);\\n+                }\\n+            }\\n+\\n+#pragma omp single\\n+            {\\n+                for (size_t i = base; i < end && !done; i++) {\\n+                    const size_t offset = (i - base) * 4;\\n+                    for (int direction = 0; direction < 4; direction++) {\\n+                        if (valid[offset + direction] &&\\n+                            queue_move(build_move(frontier[i],\\n+                                &moves[offset + direction])))\\n+                            break;\\n+                    }\\n+                }\\n+            }\\n+        }\\n+    }\\n+\\n+    free(valid);\\n+    free(moves);\\n+    free(frontier);\\n+}\\n+\\n void show_moves(const state_t * s, int nextPos) {\\n     if (s -> prev)\\n         show_moves(s -> prev, s -> c[0]);\\n@@ -338,8 +417,16 @@ int main() {\\n     queue_move(s);\\n     while (!done) {\\n         state_t * head = next_level;\\n-        for (next_level = NULL; head && !done; head = head -> qnext)\\n-            do_move(head);\\n+        size_t frontier_size = 0;\\n+        for (state_t * p = head; p; p = p -> qnext)\\n+            frontier_size++;\\n+\\n+        if (frontier_size >= PARALLEL_FRONTIER_THRESHOLD) {\\n+            do_parallel_level(head, frontier_size);\\n+        } else {\\n+            for (next_level = NULL; head && !done; head = head -> qnext)\\n+                do_move(head);\\n+        }\\n \\n         if (!next_level) {\\n             puts(\\\"no solution?\\\");\"}, {\"id\": \"a100ba049a9f4c5f\", \"role\": \"A\", \"commit\": \"ea2ce710516488f50891f2fecb7c3011ac1ab05f\", \"transformations\": {\"files\": [\"src/sokoban.c\"], \"retained\": [\"Use binary search over the sorted box-position vector to find the adjacent box and detect an occupied push destination.\", \"Replace per-move bubble sorting with a contiguous insertion shift only when a box is pushed; leave the vector untouched for walking moves.\"]}, \"mean_seconds\": 0.0049540021767218905, \"diff\": \"diff --git a/src/sokoban.c b/src/sokoban.c\\nindex d9d7ddf..9a064f3 100644\\n--- a/src/sokoban.c\\n+++ b/src/sokoban.c\\n@@ -219,6 +219,18 @@ bool success(const state_t * s) {\\n     return true;\\n }\\n \\n+static int find_box(const state_t * s, const int cell) {\\n+    int lo = 1, hi = n_boxes + 1;\\n+    while (lo < hi) {\\n+        const int mid = lo + (hi - lo) / 2;\\n+        if (s -> c[mid] < cell)\\n+            lo = mid + 1;\\n+        else\\n+            hi = mid;\\n+    }\\n+    return lo <= n_boxes && s -> c[lo] == cell ? lo : 0;\\n+}\\n+\\n state_t * move_me(state_t * s,\\n     const int dy,\\n         const int dx) {\\n@@ -232,21 +244,13 @@ state_t * move_me(state_t * s,\\n         board[c1] == wall)\\n         return NULL;\\n \\n-    int at_box = 0;\\n-    for (int i = 1; i <= n_boxes; i++) {\\n-        if (s -> c[i] == c1) {\\n-            at_box = i;\\n-            break;\\n-        }\\n-    }\\n+    const int at_box = find_box(s, c1);\\n \\n     int c2;\\n     if (at_box) {\\n         c2 = c1 + dy * w + dx;\\n-        if (board[c2] == wall || !live[c2])\\n+        if (board[c2] == wall || !live[c2] || find_box(s, c2))\\n             return NULL;\\n-        for (int i = 1; i <= n_boxes; i++)\\n-            if (s -> c[i] == c2) return NULL;\\n     }\\n \\n     state_t * n = newstate(s);\\n@@ -255,16 +259,21 @@ state_t * move_me(state_t * s,\\n     cidx_t * p = n -> c;\\n     p[0] = c1;\\n \\n-    if (at_box) p[at_box] = c2;\\n-\\n-    // leet bubble sort\\n-    for (int i = n_boxes; --i;) {\\n-        cidx_t t = 0;\\n-        for (int j = 1; j < i; j++) {\\n-            if (p[j] > p[j + 1])\\n-                t = p[j], p[j] = p[j + 1], p[j + 1] = t;\\n+    if (at_box) {\\n+        const cidx_t destination = c2;\\n+        int i = at_box;\\n+        if (destination < p[i]) {\\n+            while (i > 1 && p[i - 1] > destination) {\\n+                p[i] = p[i - 1];\\n+                --i;\\n+            }\\n+        } else {\\n+            while (i < n_boxes && p[i + 1] < destination) {\\n+                p[i] = p[i + 1];\\n+                ++i;\\n+            }\\n         }\\n-        if (!t) break;\\n+        p[i] = destination;\\n     }\\n \\n     return n;\"}, {\"id\": \"530961a402154012\", \"role\": \"A\", \"commit\": \"36fef32c3d90217967e0a41cf2c3ed3a2b51f769\", \"transformations\": {\"files\": [\"src/sokoban.c\"], \"retained\": [\"Generate successors in the reference traversal order and reverse each completed contiguous next-level array to preserve its prepended-frontier visitation order.\", \"Stop box-position scans at the first sorted box index greater than the queried cell.\"]}, \"mean_seconds\": 0.005012222565710545, \"diff\": \"diff --git a/src/sokoban.c b/src/sokoban.c\\nindex d9d7ddf..1bea5d0 100644\\n--- a/src/sokoban.c\\n+++ b/src/sokoban.c\\n@@ -24,7 +24,7 @@ typedef struct state_t state_t;\\n \\n struct state_t { // variable length\\n     hash_t h;\\n-    state_t * prev, * next, * qnext;\\n+    state_t * prev, * next;\\n     cidx_t c[];\\n };\\n \\n@@ -238,6 +238,7 @@ state_t * move_me(state_t * s,\\n             at_box = i;\\n             break;\\n         }\\n+        if (s -> c[i] > c1) break;\\n     }\\n \\n     int c2;\\n@@ -245,8 +246,10 @@ state_t * move_me(state_t * s,\\n         c2 = c1 + dy * w + dx;\\n         if (board[c2] == wall || !live[c2])\\n             return NULL;\\n-        for (int i = 1; i <= n_boxes; i++)\\n+        for (int i = 1; i <= n_boxes; i++) {\\n             if (s -> c[i] == c2) return NULL;\\n+            if (s -> c[i] > c2) break;\\n+        }\\n     }\\n \\n     state_t * n = newstate(s);\\n@@ -257,20 +260,42 @@ state_t * move_me(state_t * s,\\n \\n     if (at_box) p[at_box] = c2;\\n \\n-    // leet bubble sort\\n-    for (int i = n_boxes; --i;) {\\n-        cidx_t t = 0;\\n-        for (int j = 1; j < i; j++) {\\n-            if (p[j] > p[j + 1])\\n-                t = p[j], p[j] = p[j + 1], p[j + 1] = t;\\n+    /* The box list is already sorted for a player-only move. A push changes\\n+       one entry, so restore its order by moving that entry through the list. */\\n+    if (at_box) {\\n+        cidx_t moved_box = p[at_box];\\n+        int i = at_box;\\n+        if (i > 1 && moved_box < p[i - 1]) {\\n+            do {\\n+                p[i] = p[i - 1];\\n+                i--;\\n+            } while (i > 1 && moved_box < p[i - 1]);\\n+        } else {\\n+            while (i < n_boxes && moved_box > p[i + 1]) {\\n+                p[i] = p[i + 1];\\n+                i++;\\n+            }\\n         }\\n-        if (!t) break;\\n+        p[i] = moved_box;\\n     }\\n \\n     return n;\\n }\\n \\n-state_t * next_level, * done;\\n+state_t ** current_level, ** next_level;\\n+size_t current_count, current_capacity, next_count, next_capacity;\\n+state_t * done;\\n+\\n+void append_next(state_t * s) {\\n+    if (next_count == next_capacity) {\\n+        size_t capacity = next_capacity ? next_capacity * 2 : 64;\\n+        state_t ** levels = realloc(next_level, sizeof(*next_level) * capacity);\\n+        assert(levels);\\n+        next_level = levels;\\n+        next_capacity = capacity;\\n+    }\\n+    next_level[next_count++] = s;\\n+}\\n \\n bool queue_move(state_t * s) {\\n     if (!s || !add_to_table(s))\\n@@ -281,8 +306,7 @@ bool queue_move(state_t * s) {\\n         return true;\\n     }\\n \\n-    s -> qnext = next_level;\\n-    next_level = s;\\n+    append_next(s);\\n     return false;\\n }\\n \\n@@ -337,11 +361,28 @@ int main() {\\n     extend_table();\\n     queue_move(s);\\n     while (!done) {\\n-        state_t * head = next_level;\\n-        for (next_level = NULL; head && !done; head = head -> qnext)\\n-            do_move(head);\\n+        state_t ** tmp_level = current_level;\\n+        current_level = next_level;\\n+        next_level = tmp_level;\\n+\\n+        size_t tmp_capacity = current_capacity;\\n+        current_capacity = next_capacity;\\n+        next_capacity = tmp_capacity;\\n+\\n+        current_count = next_count;\\n+        next_count = 0;\\n+        for (size_t i = 0; i < current_count && !done; i++)\\n+            do_move(current_level[i]);\\n+\\n+        if (!done) {\\n+            for (size_t i = 0; i < next_count / 2; i++) {\\n+                state_t * tmp = next_level[i];\\n+                next_level[i] = next_level[next_count - i - 1];\\n+                next_level[next_count - i - 1] = tmp;\\n+            }\\n+        }\\n \\n-        if (!next_level) {\\n+        if (!done && !next_count) {\\n             puts(\\\"no solution?\\\");\\n             return 1;\\n         }\\n@@ -349,6 +390,8 @@ int main() {\\n \\n     show_moves(done, -1);\\n \\n+    free(current_level);\\n+    free(next_level);\\n     free(buckets);\\n     free(board);\\n     free(goals);\"}], \"interactions\": [], \"automatic_observations\": {\"baseline\": {\"experiment_id\": \"baseline-e1\", \"outcome\": {\"binary_sha256\": \"7d0c0707addedeea4493535dfce69d0a9e96d19324cd341912479fd167cd4ab0\", \"cache_key\": \"ef6f70b39714fc96a8dbc7750de47fd2859a550365280b5d20378e26cebfb7ba\", \"commit\": \"086b51800b7b6ad6684929e45a3878768a60fd13\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-max/results-748259/2021-sokoban/logs/e1/baseline-e1/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-max/results-748259/2021-sokoban/logs/e1/baseline-e1/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-max/results-748259/2021-sokoban/logs/e1/baseline-e1/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-max/results-748259/2021-sokoban/logs/e1/baseline-e1/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-max/results-748259/2021-sokoban/logs/e1/baseline-e1/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-max/results-748259/2021-sokoban/logs/e1/baseline-e1/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.004816269812484582, \"reason\": \"\", \"score\": 0.5, \"status\": \"valid\", \"times\": [0.004971381276845932, 0.0046832263469696045, 0.00479420181363821], \"tree_hash\": \"62d8f61d4ae1e08225899d4d3060a9177170b9f4\"}, \"raw_logs\": [{\"path\": \"logs/e1/baseline-e1/search/attempt-001/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": true, \"cases\": 4}}]}, \"selected_parent\": null, \"selected_base_commit\": \"086b51800b7b6ad6684929e45a3878768a60fd13\", \"recent_own_role\": [], \"own_role_history\": [], \"node_development\": {\"attempt\": 1, \"remaining_attempts\": 3, \"previous_attempts\": [], \"confirmation_data_available\": false}}, \"documents_as_data\": [], \"deadline\": 1792130304.7668033, \"generation_deadline\": 1792130304.7668033, \"protocol_id\": \"c71422cd249fa0e2dba7fcca5519ee27a9b6504fea5544d647f59b6dc8de7258\", \"remaining_tokens\": 589824, \"official_statement_as_data\": \"16th Marathon of Parallel Programming\\nSBAC-PAD & WSCAD – 2021\\nCalebe Bianchini1 and Maur´ıcio Aronne Pillon2\\n1Mackenzie Presbyterian University\\n2Santa Catarina State University\\nRules for Remote Contest\\nFor all problems, read carefully the input and output session. For all problems, a sequen-\\ntial implementation is given, and it is against the output of those implementations that the\\noutput of your programs will be compared to decide if your implementation is correct.\\nYou can modify the program in any way you see ﬁt, except when the problem descrip-\\ntion states otherwise. You must upload a compressed ﬁle (zip) with your source code, the\\nMakeﬁle and an execution script. The script must have the name of the problem. You\\ncan submit as many solutions to a problem as you want. Only the last submission will\\nbe considered. The Makeﬁle must have the rule all, which will be used to compile your\\nsource code. The execution script runs your solution the way you design it – it will be\\ninspected not to corrupt the target machine.\\nThe execution time of your program will be measured running it with time program and\\ntaking the real CPU time given. Each program will be executed at least three times with\\nthe same input and the mean time will be taken into account. The sequential program\\ngiven will be measured the same way. You will earn points in each problem, correspond-\\ning to the division of the sequential time by the time of your program (speedup). The\\nteam with the most points at the end of the marathon will be declared the winner.\\nThis problem set contains 5 problems; pages are numbered from 1 to 9.\\n\\nGeneral Information\\nCompilation\\nYou should use CC or CXX inside your Makeﬁle. Be careful when redeﬁning them!\\nThere is a simple Makeﬁle inside you problem package that you can modify. Example:\\nFLAGS=-O3\\nEXEC=sum\\nCXX=icpc\\nall: $(EXEC)\\n$(EXEC):\\n$(CXX) $(FLAGS) $(EXEC).cpp -c -o $(EXEC).o\\n$(CXX) $(FLAGS) $(EXEC).o -o $(EXEC)\\nEach judge machine has its group of compilers. See them below and choose well when\\nwriting your Makeﬁle. The compiler that is tagged as default is predeﬁned in CC and\\nCXX variables.\\nmachine compiler command\\nhost\\nGCC 10.2.11\\n(default)\\nC = gcc\\nC++ = g++\\nIntel C/C++ Compiler 19.1.3.304 C = icc\\nC++ = icpc\\nMPI\\nIntel MPI Compiler 2019u12\\n(default)\\nC = mpiicc\\nC++ = mpiicpc\\nIntel C/C++ Compiler 19.1.3.304 C = icc\\nC++ = icpc\\nGCC 10.2.11 C = gcc\\nC++ = g++\\ngpu\\nNVidia CUDA 11.2\\n(default)\\nC = nvcc\\nC++ = nvcc\\nGCC 8.3.1 C = gcc\\nC++ = g++\\nSubmitting\\nGeneral information\\nYou must have an execution script that has the same name of the problem. This script runs\\nyour solution the way you design it. There is a simple script inside you problem package\\nthat should be modiﬁed. Example:\\n#!/bin/bash\\n# This script runs a generic Problem A\\n# Using 32 threads and OpenMP\\nexport OMP_NUM_THREADS=32\\nOMP_NUM_THREADS=32 ./sum\\n\\nSubmitting MPI\\nIf you are planning to submit an MPI solution, you should compile usingmpiicc/mpiicpc.\\nThe script must call mpirun/mpiexec with the correct number of processes (max: 4). It\\nmust use a ﬁle called machines that are generated by the auto-judge system - do not\\ncreate it.\\n#!/bin/bash\\n# This script runs a generic Problem A\\n# Using MPI in the entire cluster (4 nodes)\\n# 'machines' file describes the nodes\\nmpirun -np 4 -machinefile machines ./sum\\nComparing times & results\\nIn your personal machine, measure the execution time of your solution using time pro-\\ngram. Add input/output redirection when collecting time. Use diff program to compare\\nthe original and your solution results. Example:\\n$ time -p ./A < original_input.txt > my_output.txt\\nreal 4.94\\nuser 0.08\\nsys 1.56\\n$ diff my_output.txt original_output.txt\\nDo not measure time and do not add input/output redirection when submitting your so-\\nlution - the auto-judge system is prepared to collect your time and compare the results.\\n\\nProblem A\\nGraph Isomorphism Detection\\nProblem deﬁnition\\nGiven two graphs G(V, E) and H(V, E), where V denotes the vertices and E the edges,\\nthe problem of ﬁnding isomorphic graphs consists of determining a bijection function\\nf : V (G)→ V (H) that maps the vertices of both graphs while preserving the adjacency\\ncondition. In other words, for the isomorphism property to exist, if any two vertices\\nu, v ∈ G are adjacent then the corresponding vertices f (u), f(v) ∈ H must also be\\nadjacent. In this sense, the proposed algorithm detects isomorphic undirected graphs\\nthrough extensive permutations, comparing all possible vertex correspondences between\\nG and H.\\nInput\\nAn input represents only a test case. Initially, the graph G is informed followed by H.\\nThe ﬁrst line contains an integerVg (0 < V g < 100) representing the number of vertices in\\nG, while the second line informs an integerEg (0≤ Eg < (Vg∗ (Vg− 1))/2) denoting the\\nnumber of edges in G. Following, Eg edges are sequentially informed, each denoted by\\ntwo integers u, v∈ Vg. The next lines repeat the same rationale for informing the graph\\nH: an integer Vh (0 < V h < 100) representing the number of vertices in H is followed by\\nan integer Eh (0≤ Eh < (Vh∗ (Vh− 1))/2) denoting the number of edges in H. Finally,\\nEh edges are sequentially informed, each denoted by two integers u, v∈ Vh.\\nThe input must be read form the standard input.\\nOutput\\nThe output contains a single line. If G and H are not isomorphic graphs, the message The\\ngraphs are not isomorphicis printed to the output. Otherwise, a stream of integersv∈ Vh\\npresents a vertex correspondence between G and H, such that f (u) = v, with u∈ Vg\\nequal to the position of each v on the stream.\\nThe output must be written to the standard output.\\n1\\n\\nExample\\nInput example Output example\\n4 The graphs are not isomorphic\\n6\\n0 3\\n1 1\\n1 3\\n2 2\\n2 3\\n3 3\\n4\\n6\\n0 0\\n0 1\\n0 2\\n1 1\\n1 3\\n3 3\\n2\\n\\nProblem B\\nDescriptive Statistics Metrics\\nA researcher has a set of samples grouped in matrices, where each column represents a\\nsample. The researcher needs to calculate the following values for each sample (column):\\narithmetic mean, harmonic mean, median, mode, sample variance, standard deviation and\\ncoefﬁcient of variation. Each value can be set as follows:\\n• Arithmetic mean: Sum of all elements in the sample, divided by the sample size\\n(sum of the rows in the matrix column divided by the number of rows).\\n• Harmonic mean: Ratio between the sample size and the sum of the inverse of the\\nsamples.\\n• Median: Average element of the sample (average element of the ordered column).\\nFor an even number of elements, the median is the mean between the elements in\\nthe middle (\\n( n\\n2 + n\\n2+1 )\\n2 ).\\n• Mode: Most frequent number of the sample (the element that most appears in the\\ncolumn; if there is more than one, only the ﬁrst is considered. If not, it returns -1).\\n• Sample Variance: Sum of squares of data deviations from the mean and dividing\\nby the number of items minus one.\\n• Standard deviation: Square root of the variance.\\n• Coefﬁcient of variation:Ratio between standard deviation and arithmetic mean.\\nProblem input\\nThe input has only one test case. The ﬁrst line has the number of rows and columns of the\\nmatrix, separated by a single space. In the following lines are the elements of the matrix\\nof type double, where the lines are separated by a single line break and the columns by a\\nsingle space.\\nThe input must be read form the standard input.\\nProblem output:\\nThe output contains the calculated metrics, respectively. A single space will separate the\\ncalculated values for each column, and there will also be a single space at the end of the\\nline. Each metric starts on a new line, i.e., is separated by a single line break. Printed\\nvalues consider a single decimal place.\\nThe output must be written to the standard output.\\n3\\n\\nExample\\nInput example Output example\\n6 4 12.0 17.0 11.5 13.5\\n9 8 4 5 8.1 12.1 6.6 3.7\\n4 12 20 40 8.5 12.0 10.5 7.5\\n8 8 4 4 8.0 8.0 4.0 -1.0\\n8 12 4 21 110.0 188.4 68.7 217.9\\n33 44 20 1 10.5 13.7 8.3 14.8\\n10 18 17 10 0.9 0.8 0.7 1.1\\n4\\n\\nProblem C\\nSokoban\\nSokoban is a videogame created in 1981 by Hiroyuki Imabayashi.\\nThe board, whose dimension varies according to each stage, is divided into squares which\\ncan be one of the following elements:\\n• Empty square (that may be marked as a target)\\n• Wall\\n• Box\\n• Player\\nTo organize the boxes, the player can move in 4 directions (up, down, left, and right) and\\nalso push the boxes. The player cannot, however, pull boxes. Therefore, if a box is pushed\\nto a corner it can no longer be moved. Moreover, only a single box can be moved at the\\nsame time.\\nThe goal of the game is to solve the puzzle by placing a box over each one of the target\\nsquares. The secondary objective is to solve the puzzle in the least number of movements\\npossible.\\nInput\\nThe input contains a single puzzle stage to be solved. The input follows the format below\\nin which each character represents a square of the board:\\n• Empty squares are represented by spaces\\n• # represents a wall\\n• $ indicates the presence of a box\\n• . is a target square\\n• * is a box over a target square\\n• @ is the player\\n• + is a target square\\nThe input must be read from the standard input.\\nOutput\\nThe output of your program is the sequence of movements made by the player to solve\\nthe puzzle. The output format is the following:\\n• u - up\\n• d - down\\n• l - left\\n• r - right\\n• U - up, pushing a box\\n• D - down, pushing a box\\n• L - left, pushing a box\\n5\\n\\n• R - right, pushing a box\\nThe solution length must be the shortest possible. Since there might be more than one\\npossible solution of the same length for the same input, only the ﬁrst solution ordered by\\nthe movements of the player (considering the order up, down, left, and then right) must\\nbe shown. For instance, if the result of the sequencesdll and lld is the same, then dll\\nis preferred.\\nThe output must be written to the standard output.\\nExample\\nInput Output\\n####### ulULLulDDurrrddlULrruLLrrUruLLLulD\\n# #\\n# #\\n#. # #\\n#. $$ #\\n#.$$ #\\n#.# @#\\n#######\\n6\\n\\nProblem D\\nJohnson’s Algorithm for SSSP\\nLet G = ( V ; E; w) a weighted directed graph with non-negative weights, where V =\\nv1, v2, . . . , vn denote the vertices, E = e1, e2, . . . , em denotes the edges and w denotes the\\nweight function w : E− →R which connects the different vertices in the graph with only\\npositive integer. The problem of single-source shortest paths (SSSP) consists of ﬁnding\\nthe shortest paths from a source vertex v∈ V to all other vertices in V .\\nDijkstra’s algorithm can solve the SSSP problem, however when the number of edges is\\nmuch less than the possible number of edges or mathematically |E|≪ V 2, Johnson’s\\nalgorithm obtains better results. Johnson’s Algorithm updates a heap structure while the\\nnumber of visited vertices is increased, this technique is known as “reweighting”. With\\nnon-negative weights the Jhonson algorithm is solve in three steps:\\n1. Add a new node x to the graph and connect this node with zero-weight edges to\\nall other nodes.\\n2. The edges of the original graph are reweighted, i.e. the weight function is updated.\\nFor each edge (u, v), assign the new weight as “original weight + h[u] – h[v]”.\\n3. Finally, x is removed, and Dijkstra’s algorithm is used to ﬁnd the shortest paths\\nfrom the node v = 0 to other vertices in the reweighted graph.\\nInput\\nThe input has only one test case. The input has tree lines: ﬁrst line is the number of\\nvertices, second is the number of edges and the third is the mean Single-Source Shortest\\nPaths using the vertex 0 as source for all the executions. The edges between the vertices\\nare created using random functions with range 1≤ E≤ 10 or [1, 10]. The seed of the\\nrandom number generator is set to generate reproducible cases for the same case size.\\nThe input must be read from the standard input.\\nOutput\\nThe output a message with a single ﬂoat number. The ﬂoat number is the mean of the\\nSingle-Source Shortest Paths using the vertex 0 as source.\\nThe output must be written to the standard output.\\nExample\\nInput Output\\n20 Mean SSSP = 4.9000\\n100\\n4.9000\\n7\\n\\nProblem E\\nJacobi Iterative Method that Solves the\\nLaplace Equation\\nThe code implements a Jacobi iterative method that solves the Laplace equation for heat\\ntransfer. The Jacobi iterative method is a means for iteratively calculating the solution to a\\ndifferential equation by continuously reﬁning the solution until the answer has converged\\nupon a stable solution or some ﬁxed number of steps have completed and the answer is\\neither deemed good enough or unconverged. The example code represents a 2D plane\\nof material that has been divided into a grid of equally sized cells. As heat is applied\\nto the center of this plane, the Laplace equation dictates how the heat will transfer from\\ngrid point to grid point over time. To calculate the temperature of a given grid point\\nfor the next time iteration, one simply calculates the average of the temperatures of the\\nneighboring grid points from the current iteration. Once the next value for each grid point\\nis calculated, those values become the current temperature and the calculation continues.\\nAt each step the maximum temperature change across all grid points will determine if the\\nproblem has converged upon a steady state.\\nThe Figure E.1 below shows the result of applying the algorithm on a surface represented\\nby a 512 x 512 matrix with 10000 steps.\\nInput\\nThe input consist of two values: the size of the square matrix that will be generated; and\\nthe maximum number of steps.\\nThe input must be read from the standard input.\\nOutput\\nThe output is a matrix that represents heat transferred from one point on the grid to another\\nover time.\\nThe output must be written to the standard output.\\n8\\n\\nFigure E.1. 512 x 512 heated surface.\\nExample\\nInput Output\\n7 100 0.000000 0.000000 0.000000 0.000000 0.000000\\n0.000000 0.000000\\n0.000000 0.000003 0.000000 0.000006 0.000000\\n0.000003 0.000000\\n0.000000 0.000000 0.000009 0.000000 0.000009\\n0.000000 0.000000\\n0.000000 0.000006 0.000000 0.000013 0.000000\\n0.000006 0.000000\\n0.000000 0.000000 0.000009 0.000000 0.000009\\n0.000000 0.000000\\n0.000000 0.000003 0.000000 0.000006 0.000000\\n0.000003 0.000000\\n0.000000 0.000000 0.000000 0.000000 0.000000\\n0.000000 0.000000\\n9\", \"runtime_as_data\": {\"cpu_cores\": 4, \"OMP_NUM_THREADS\": 4, \"architecture\": \"ARM64\", \"candidate_GPU\": false, \"comparison\": \"Exact output bytes against official reference\"}, \"mother_model_as_data\": {\"phase\": \"synthesis\", \"status\": \"complete\", \"guidance\": \"Integrate only correctness-validated tree programs. Start from baseline and the B occupancy/sorted-box/bounds candidate; then measure combinations with A and C independently and together, since gains may interact. Compare actual integrated timings and exact oracle outputs, retain only a measured correct improvement, and do not assume individually measured changes add. Do not change tests, oracle, compiler, budgets, target, or permissions.\", \"analysis\": \"The task requires shortest Sokoban move sequences and correct tie selection, so preserve the reference BFS semantics and validate exact output, not just solvability. Baseline is reported correct on four cases at 0.004816 s. The B occupancy/sorted-box/bounds combination is the fastest reported candidate at 0.004764 s, about 1.1% lower; its hash variant is 0.004805 s. The A candidates are 0.004954 and 0.005012 s, and the C OpenMP candidates are 0.004877 and 0.004899 s. These are small differences, and candidate correctness is not reported in the observations; treat them as hypotheses and measure the integrated program rather than assuming additive gains.\", \"origin\": \"model output from this fresh run; no operator analysis\"}, \"node_research\": {\"enabled\": true, \"corpus_documents\": 0, \"allowed_hosts\": [\"gcc.gnu.org\", \"www.openmp.org\", \"raw.githubusercontent.com\"], \"max_queries_per_action\": 2, \"max_urls_per_action\": 2, \"max_excerpt_characters\": 6000, \"arbitrary_commands\": false, \"general_web_search\": false}}, \"required_json_schema\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"hypothesis\": {\"type\": \"string\"}, \"transformations\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"sources_kept\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"enum\": [\"77770fa58d824433\", \"0f062ab333a84c7e\", \"46ab767aae144de8\", \"bd615b32118c4f57\", \"a100ba049a9f4c5f\", \"530961a402154012\"]}, \"uniqueItems\": true}, \"files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"path\": {\"type\": \"string\"}, \"content\": {\"type\": \"string\"}}, \"required\": [\"path\", \"content\"]}}, \"notes\": {\"type\": \"string\"}, \"research\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"queries\": {\"type\": \"array\", \"maxItems\": 2, \"items\": {\"type\": \"string\", \"minLength\": 1, \"maxLength\": 300}}, \"urls\": {\"type\": \"array\", \"maxItems\": 2, \"items\": {\"type\": \"string\", \"minLength\": 1, \"maxLength\": 2000}}}, \"required\": [\"queries\", \"urls\"]}}, \"required\": [\"hypothesis\", \"transformations\", \"sources_kept\", \"files\", \"notes\", \"research\"]}}\n\nCURRENT SOURCE AS DATA:\n\n--- BEGIN FILE src/sokoban.c ---\n/*\n * This code was based on Sokoban C available at\n * http://www.rosettacode.org/wiki/Sokoban#C\n * licenced under GNU Free Documentation License 1.2\n */\n\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <unistd.h>\n#include <stdint.h>\n#include <assert.h>\n#include <stdbool.h>\n\nint w, h, n_boxes;\nuint8_t * board, * goals, * live;\n\ntypedef uint16_t cidx_t;\ntypedef uint32_t hash_t;\n\n/* board configuration is represented by an array of cell indices\n   of player and boxes */\ntypedef struct state_t state_t;\n\nstruct state_t { // variable length\n    hash_t h;\n    state_t * prev, * next, * qnext;\n    cidx_t c[];\n};\n\nsize_t state_size, block_size = 32;\nstate_t * block_root, * block_head;\n\ninline\nstate_t * newstate(state_t * parent) {\n    inline state_t * next_of(state_t * s) {\n        return (void * )((uint8_t * ) s + state_size);\n    }\n\n    state_t * ptr;\n    if (!block_head) {\n        block_size *= 2;\n        state_t * p = malloc(block_size * state_size);\n        assert(p);\n        p -> next = block_root;\n        block_root = p;\n        ptr = (void * )((uint8_t * ) p + state_size * block_size);\n        p = block_head = next_of(p);\n        state_t * q;\n        for (q = next_of(p); q < ptr; p = q, q = next_of(q))\n            p -> next = q;\n        p -> next = NULL;\n    }\n\n    ptr = block_head;\n    block_head = block_head -> next;\n\n    ptr -> prev = parent;\n    ptr -> h = 0;\n    return ptr;\n}\n\ninline\nvoid unnewstate(state_t * p) {\n    p -> next = block_head;\n    block_head = p;\n}\n\nenum {\n    space,\n    wall,\n    player,\n    box\n};\n\n// mark up positions where a box definitely should not be\nvoid mark_live(const int c) {\n    const int y = c / w,\n        x = c % w;\n    if (live[c]) return;\n\n    live[c] = 1;\n    if (y > 1 && board[c - w] != wall && board[c - w * 2] != wall)\n        mark_live(c - w);\n    if (y < h - 2 && board[c + w] != wall && board[c + w * 2] != wall)\n        mark_live(c + w);\n    if (x > 1 && board[c - 1] != wall && board[c - 2] != wall)\n        mark_live(c - 1);\n    if (x < w - 2 && board[c + 1] != wall && board[c + 2] != wall)\n        mark_live(c + 1);\n}\n\nstate_t * parse_board(const char * s) {\n    board = calloc(w * h, sizeof(uint8_t));\n    assert(board);\n    goals = calloc(w * h, sizeof(uint8_t));\n    assert(goals);\n    live = calloc(w * h, sizeof(uint8_t));\n    assert(live);\n\n    n_boxes = 0;\n    for (int i = 0; s[i]; i++) {\n        switch (s[i]) {\n        case '#':\n            board[i] = wall;\n            continue;\n\n        case '.': // fallthrough\n        case '+':\n            goals[i] = 1; // fallthrough\n        case '@':\n            continue;\n\n        case '*':\n            goals[i] = 1; // fallthrough\n        case '$':\n            n_boxes++;\n            continue;\n        default:\n            continue;\n        }\n    }\n\n    const int is = sizeof(int);\n    state_size = (sizeof(state_t) + (1 + n_boxes) * sizeof(cidx_t) + is - 1) /\n        is * is;\n\n    state_t * state = newstate(NULL);\n\n    for (int i = 0, j = 0; i < w * h; i++) {\n        if (goals[i]) mark_live(i);\n        if (s[i] == '$' || s[i] == '*')\n            state -> c[++j] = i;\n        else if (s[i] == '@' || s[i] == '+')\n            state -> c[0] = i;\n    }\n\n    return state;\n}\n\n// K&R hash function\ninline\nvoid hash(state_t * s) {\n    if (!s -> h) {\n        register hash_t ha = 0;\n        cidx_t * p = s -> c;\n        for (int i = 0; i <= n_boxes; i++)\n            ha = p[i] + 31 * ha;\n        s -> h = ha;\n    }\n}\n\nstate_t ** buckets;\nhash_t hash_size, fill_limit, filled;\n\nvoid extend_table() {\n    int old_size = hash_size;\n\n    if (!old_size) {\n        hash_size = 1024;\n        filled = 0;\n        fill_limit = hash_size * 3 / 4; // 0.75 load factor\n    } else {\n        hash_size *= 2;\n        fill_limit *= 2;\n    }\n\n    buckets = realloc(buckets, sizeof(state_t * ) * hash_size);\n    assert(buckets);\n\n    // rehash\n    memset(buckets + old_size, 0, sizeof(state_t * ) * (hash_size - old_size));\n\n    const hash_t bits = hash_size - 1;\n    for (int i = 0; i < old_size; i++) {\n        state_t * head = buckets[i];\n        buckets[i] = NULL;\n        while (head) {\n            state_t * next = head -> next;\n            const int j = head -> h & bits;\n            head -> next = buckets[j];\n            buckets[j] = head;\n            head = next;\n        }\n    }\n}\n\nstate_t * lookup(state_t * s) {\n    hash(s);\n    state_t * f = buckets[s -> h & (hash_size - 1)];\n    for (; f; f = f -> next) {\n        if ( //(f->h == s->h) &&\n            !memcmp(s -> c, f -> c, sizeof(cidx_t) * (1 + n_boxes)))\n            break;\n    }\n\n    return f;\n}\n\nbool add_to_table(state_t * s) {\n    if (lookup(s)) {\n        unnewstate(s);\n        return false;\n    }\n\n    if (filled++ >= fill_limit)\n        extend_table();\n\n    hash_t i = s -> h & (hash_size - 1);\n\n    s -> next = buckets[i];\n    buckets[i] = s;\n    return true;\n}\n\nbool success(const state_t * s) {\n    for (int i = 1; i <= n_boxes; i++)\n        if (!goals[s -> c[i]]) return false;\n    return true;\n}\n\nstate_t * move_me(state_t * s,\n    const int dy,\n        const int dx) {\n    const int y = s -> c[0] / w;\n    const int x = s -> c[0] % w;\n    const int y1 = y + dy;\n    const int x1 = x + dx;\n    const int c1 = y1 * w + x1;\n\n    if (y1 < 0 || y1 > h || x1 < 0 || x1 > w ||\n        board[c1] == wall)\n        return NULL;\n\n    int at_box = 0;\n    for (int i = 1; i <= n_boxes; i++) {\n        if (s -> c[i] == c1) {\n            at_box = i;\n            break;\n        }\n    }\n\n    int c2;\n    if (at_box) {\n        c2 = c1 + dy * w + dx;\n        if (board[c2] == wall || !live[c2])\n            return NULL;\n        for (int i = 1; i <= n_boxes; i++)\n            if (s -> c[i] == c2) return NULL;\n    }\n\n    state_t * n = newstate(s);\n    memcpy(n -> c + 1, s -> c + 1, sizeof(cidx_t) * n_boxes);\n\n    cidx_t * p = n -> c;\n    p[0] = c1;\n\n    if (at_box) p[at_box] = c2;\n\n    // leet bubble sort\n    for (int i = n_boxes; --i;) {\n        cidx_t t = 0;\n        for (int j = 1; j < i; j++) {\n            if (p[j] > p[j + 1])\n                t = p[j], p[j] = p[j + 1], p[j + 1] = t;\n        }\n        if (!t) break;\n    }\n\n    return n;\n}\n\nstate_t * next_level, * done;\n\nbool queue_move(state_t * s) {\n    if (!s || !add_to_table(s))\n        return false;\n\n    if (success(s)) {\n        done = s;\n        return true;\n    }\n\n    s -> qnext = next_level;\n    next_level = s;\n    return false;\n}\n\nbool do_move(state_t * s) {\n    return queue_move(move_me(s, 0, 1)) ||\n        queue_move(move_me(s, 0, -1)) ||\n        queue_move(move_me(s, -1, 0)) ||\n        queue_move(move_me(s, 1, 0));\n}\n\nvoid show_moves(const state_t * s, int nextPos) {\n    if (s -> prev)\n        show_moves(s -> prev, s -> c[0]);\n    if (nextPos == -1) {\n        printf(\"\\n\");\n        return;\n    }\n    int cx = s -> c[0] % w;\n    int cy = s -> c[0] / w;\n    int nx = nextPos % w;\n    int ny = nextPos / w;\n    int box = 0;\n    for (int i = 1; !box && i <= n_boxes; i++)\n        box = s -> c[i] == nextPos;\n    if (cx < nx) printf(box ? \"R\" : \"r\");\n    else if (cx > nx) printf(box ? \"L\" : \"l\");\n    else if (cy < ny) printf(box ? \"D\" : \"d\");\n    else if (cy > ny) printf(box ? \"U\" : \"u\");\n    else if (1) {\n        printf(\"Invalid move\\n\");\n        exit(1);\n    }\n}\n\nint main() {\n    size_t sz = 1024;\n    char * boardStr = malloc(sz * sizeof(char));\n    char * pos = boardStr;\n    w = -1;\n    h = 0;\n    while (1) {\n        int read = getline( & pos, & sz, stdin);\n        if (read == -1) break;\n        if (read >= w) w = read;\n        sz -= read;\n        pos += read;\n        h++;\n    }\n    state_t * s = parse_board(boardStr);\n    free(boardStr);\n\n    extend_table();\n    queue_move(s);\n    while (!done) {\n        state_t * head = next_level;\n        for (next_level = NULL; head && !done; head = head -> qnext)\n            do_move(head);\n\n        if (!next_level) {\n            puts(\"no solution?\");\n            return 1;\n        }\n    }\n\n    show_moves(done, -1);\n\n    free(buckets);\n    free(board);\n    free(goals);\n    free(live);\n\n    while (block_root) {\n        void * tmp = block_root -> next;\n        free(block_root);\n        block_root = tmp;\n    }\n    return 0;\n}\n\n--- END FILE src/sokoban.c ---\n"
    }
  ],

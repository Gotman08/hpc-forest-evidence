"""One-path isolated correction; preserve the sealed r1 and its historical derivation."""
import ast
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
OLD = HERE.parent / "revision-r1"


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


manifest_raw = (OLD / "MANIFESTE-AUDITEUR-NATIF-G.json").read_bytes()
assert sha(manifest_raw) == "ce4d9a8cc50fbac64dc166c46ac405ed1b7e092be1b996d483b5cfe472fea83d"
assert sha((OLD / "LIVRAISON-AUDITEUR-NATIF-G-POUR-REVUE.json").read_bytes()) == "da54d369d704cdf4492ce22100e390a9ecfc3d55b70ea749d8c98879099391d0"
manifest = json.loads(manifest_raw)
assert all(sha((OLD / name).read_bytes()) == info["sha256"] for name, info in manifest["files"].items())
copied = {}
for name, info in manifest["files"].items():
    if not name.endswith(".py") or name in {"deriver-auditeur-g.py", "sceller-auditeur-g.py"}:
        continue
    raw = (OLD / name).read_bytes()
    if name == "audit_context.py":
        old = b'HPC-Forest-Primes-Natif-Lancement-r2g/revision-r1"'
        new = b'HPC-Forest-Primes-Natif-Lancement-r2g"'
        assert raw.count(old) == 1
        raw = raw.replace(old, new)
    ast.parse(raw)
    with (HERE / name).open("xb") as stream:
        stream.write(raw)
    copied[name] = {"sha256": sha(raw), "bytes": len(raw), "r1_sha256": info["sha256"],
                    "byte_identical_to_r1": sha(raw) == info["sha256"]}
old_derivation = json.loads((OLD / "DERIVATION-FERMEE.json").read_bytes())
record = {"schema": "hpc-forest-r2g-final-auditor-cache-parent-correction-v1", "verified": True,
    "scope_of_verified": "Closed source derivation only, not runtime/native scientific audit",
    "predecessor_manifest": {"path": str(OLD / "MANIFESTE-AUDITEUR-NATIF-G.json"), "sha256": sha(manifest_raw)},
    "initial_r1_derivation_historical": {"path": str(OLD / "DERIVATION-FERMEE.json"),
        "sha256": sha((OLD / "DERIVATION-FERMEE.json").read_bytes()),
        "status": "Initial intermediate transport SHA before confirmed ARM projection/technical-hold sidecar closure and import lint; final r1 pins belong to its final manifest. This old record is preserved unchanged."},
    "only_production_change": "audit_context.CACHE_PARENT loses the erroneous /revision-r1; exact parent remains Lancement-r2g",
    "copied_final_component_sha256": {name: row["sha256"] for name, row in copied.items()},
    "copied_components": copied,
    "byte_identical_scientific_components": old_derivation["byte_identical_scientific_components"],
    "predecessor_component_sha256": old_derivation["predecessor_component_sha256"],
    "native_research_admitted": False, "actual_audit_run": False}
with (HERE / "DERIVATION-FERMEE.json").open("x", encoding="utf8") as stream:
    stream.write(json.dumps(record, indent=2) + "\n")
print(json.dumps({"copied_components": len(copied), "changed": [n for n,r in copied.items() if not r["byte_identical_to_r1"]]}))

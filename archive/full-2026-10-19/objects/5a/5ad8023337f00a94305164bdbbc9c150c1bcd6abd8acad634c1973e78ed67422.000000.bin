"""Seal only the actual mechanical Q753285 reception, never native admission."""
from datetime import UTC, datetime
from pathlib import Path
import hashlib
import json

ROOT = Path(__file__).resolve().parent
BASE = ROOT.parents[2]
INDEPENDENT = BASE / 'outputs/HPC-Forest-Primes-Natif-Relance-r2e/qualification-zero-modele-r1/revue-independante/reception-Q753285/REVUE-FROIDE-INDEPENDANTE-Q753285.json'

def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

def ref(path):
    return {'path': str(path.resolve()), 'sha256': sha(path)}

def read(path):
    return json.loads(path.read_text(encoding='utf-8-sig'))

def save(name, value):
    with (ROOT / name).open('x', encoding='utf-8', newline='\n') as stream:
        stream.write(json.dumps(value, indent=2, ensure_ascii=False) + '\n')
        stream.flush()
        import os
        os.fsync(stream.fileno())
    return ref(ROOT / name)

assert sha(INDEPENDENT) == '7162ca0dbf2b8fc6536cb76c6c1152a2078b6566cc2b8f962e4fc7505b5754f7'
audit = read(ROOT / 'audit-natif-parent-r2.json')
independent = read(INDEPENDENT)
assert sha(ROOT / 'audit-natif-parent-r2.json') == '0684b6483047b5e53fcf7cb5195e84a2a06379cea38b90cbdd3a4636530ba4ff'
assert independent['verified'] is True and independent['blocking_findings'] == []
assert audit['verified'] is True and audit['native_model_calls'] == 0
assert independent['source_zip_sha256'] == audit['source_zip_sha256'] == 'f15b840cca876a4c465775f5553a0eaa539a9b98e56fe942136a1fcbde9b86b9'
assert independent['plan_sha256'] == audit['plan_sha256'] == '4b430e181948e55e463dfd1e60bdce96308a9190534734feb22354e4116ebde9'
assert independent['job_id'] == audit['job_id'] == '753285'
assert independent['source_files_verified'] == 108 and independent['neutral_cases_passed_once'] == 110
assert independent['certified_unique_reference_cases'] == 12
assert sha(ROOT / 'qualification.json') == independent['qualification_sha256'] == audit['qualification_sha256']
assert sha(ROOT / 'qualification.tar.gz') == independent['inner_archive_sha256'] == audit['archive_sha256']
assert sha(ROOT / 'envelope-results-753285.tar.gz') == independent['outer_archive_sha256'] == audit['outer_archive_sha256']
assert independent['triple_announced_remote_local_SHA_identical'] is True
assert read(ROOT / 'inventaire-avant-r2.json') == read(ROOT / 'inventaire-apres-r2.json')
assert independent['restored_inventory_before_after_identical'] is True
assert independent['native_research_admitted'] is False and audit['native_research_admitted'] is False
compatible = {'schema': 'hpc-forest-primes-r2max-allocated-contract-reception-v1',
    'scope_id': audit['scope_id'], 'verified': True, 'source_zip_sha256': audit['source_zip_sha256'],
    'plan_sha256': audit['plan_sha256'], 'preparation_manifest_sha256': audit['preparation_manifest_sha256'],
    'qualification_sha256': audit['qualification_sha256'], 'archive': ref(ROOT / 'qualification.tar.gz'),
    'audit': ref(ROOT / 'audit-natif-parent-r2.json'),
    'evidence_refs': [ref(INDEPENDENT), ref(ROOT / 'envelope-results-753285.tar.gz'),
                      ref(ROOT / 'archive-transfert.json'), ref(ROOT / 'archive-annoncee.json')]}
compatible_ref = save('reception-contrat.json', compatible)
qualification = read(ROOT / 'qualification.json')
receipt = {'schema': 'hpc-forest-r2e-mechanical-reception-complete-v1', 'verified': True,
    'recorded_at_utc': datetime.now(UTC).isoformat(),
    'verification_scope': 'Mechanical allocated source/contract/diagnostics/hold/first-batch qualification only',
    'job_id': '753285', 'scope_id': audit['scope_id'], 'source_zip_sha256': audit['source_zip_sha256'],
    'plan_sha256': audit['plan_sha256'], 'qualification': ref(ROOT / 'qualification.json'),
    'qualification_archive': ref(ROOT / 'qualification.tar.gz'), 'compatible_reception': compatible_ref,
    'audit': ref(ROOT / 'audit-natif-parent-r2.json'), 'independent_audit': ref(INDEPENDENT),
    'all_three_envelope_sha256_equal': True, 'restored_files_per_copy': 792,
    'source_files_verified': 108, 'neutral_lane_tests_passed_once': 110,
    'official_evaluator_executions': 14, 'distinct_certified_cases': 12,
    'search_measurements': 3, 'confirmation_measurements': 5, 'allocation': qualification['allocation'],
    'native_model_calls': 0, 'native_first_start_proved': False, 'native_research_admitted': False,
    'old_failures_and_first_local_refusals_preserved': True, 'job_or_tests_replayed': False}
print(json.dumps({'compatible_reception': compatible_ref,
                  'mechanical_reception': save('reception-verifiee.json', receipt)}))

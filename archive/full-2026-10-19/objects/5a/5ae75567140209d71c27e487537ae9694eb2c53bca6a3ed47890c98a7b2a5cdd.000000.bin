== db && ia > ib);\n}\n\nstatic void swap3(float *hd, long *hi, char *hl, int a, int b) {\n    float td = hd[a]; hd[a] = hd[b]; hd[b] = td;\n    long ti = hi[a]; hi[a] = hi[b]; hi[b] = ti;\n    char tc = hl[a]; hl[a] = hl[b]; hl[b] = tc;\n}\n\nstatic void heap_push(float *hd, long *hi, char *hl, int *n,\n                      float d, long idx, char label) {\n    int i = (*n)++;\n    hd[i] = d; hi[i] = idx; hl[i] = label;\n\n    while (i > 0) {\n        int parent = (i - 1) / 2;\n        if (is_worse(hd[i], hi[i], hd[parent], hi[parent])) {\n            swap3(hd, hi, hl, i, parent);\n            i = parent;\n        } else {\n            break;\n        }\n    }\n}\n\nstatic void heap_replace_root(float *hd, long *hi, char *hl, int n,\n                              float d, long idx, char label) {\n    hd[0] = d; hi[0] = idx; hl[0] = label;\n    int i = 0;\n\n    for (;;) {\n        int left = 2 * i + 1;\n        if (left >= n) break;\n        int right = left + 1;\n        int worst = i;\n\n        if (is_worse(hd[left], hi[left], hd[worst], hi[worst])) {\n            worst = left;\n        }\n        if (right < n && is_worse(hd[right], hi[right], hd[worst], hi[worst])) {\n            worst = right;\n        }\n\n        if (worst == i) break;\n        swap3(hd, hi, hl, i, worst);\n        i = worst;\n    }\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    size_t total = 0;\n    for (int gi = 0; gi < n_groups; ++gi) {\n        total += (size_t)groups[gi].length;\n    }\n\n    float *xs = NULL;\n    if (posix_memalign((void **)&xs, 64, total * sizeof(float)) != 0) {\n        xs = malloc(total * sizeof(float));\n    }\n    float *ys = NULL;\n    if (posix_memalign((void **)&ys, 64, total * sizeof(float)) != 0) {\n        ys = malloc(total * sizeof(float));\n    }\n    char *plabels = (char *)malloc(total * sizeof(char));\n\n    size_t pos = 0;\n    for (int gi = 0; gi < n_groups; ++gi) {\n        Group g = groups[gi];\n        char lab = g.label;\n        for (int j = 0; j < g.length; ++j) {\n            xs[pos] = g.points[j].x;\n            ys[pos] = g.points[j].y;\n            plabels[pos] = lab;\n            ++pos;\n        }\n    }\n\n    float *dists = NULL;\n    if (posix_memalign((void **)&dists, 64, total * sizeof(float)) != 0) {\n        dists = malloc(total * sizeof(float));\n    }\n    float tx = to_evaluate.x;\n    float ty = to_evaluate.y;\n\n    // Manual NEON vectorization of the distance loop with prefetching.\n    long p = 0;\n    const long total_l = (long)total;\n    const int vec_len = 4; // float32x4_t\n    #pragma omp parallel for schedule(static)\n    for (p = 0; p <= total_l - vec_len; p += vec_len) {\n        __builtin_prefetch(&xs[p + 8], 0, 3);\n        __builtin_prefetch(&ys[p + 8], 0, 3);\n\n        float32x4_t xv = vld1q_f32(xs + p);\n        float32x4_t yv = vld1q_f32(ys + p);\n        float32x4_t txv = vdupq_n_f32(tx);\n        float32x4_t tyv = vdupq_n_f32(ty);\n\n        float32x4_t dx = vsubq_f32(xv, txv);\n        float32x4_t dy = vsubq_f32(yv, tyv);\n\n        float32x4_t d2 = vaddq_f32(vmulq_f32(dx, dx), vmulq_f32(dy, dy));\n\n        vst1q_f32(dists + p, d2);\n    }\n    // Remainder scalar loop\n    for (; p < total_l; ++p) {\n        float dx = xs[p] - tx;\n        float dy = ys[p] - ty;\n        dists[p] = dx * dx + dy * dy;\n    }\n\n    float *heap_d = (float *)malloc(k * sizeof(float));\n    long *heap_idx = (long *)malloc(k * sizeof(long));\n    char *heap_lab = (char *)malloc(k * sizeof(char));\n    int heap_n = 0;\n\n    for (long p2 = 0; p2 < total_l; ++p2) {\n        float d = dists[p2];\n        if (heap_n < k) {\n            heap_push(heap_d, heap_idx, heap_lab, &heap_n,\n                      d, p2, plabels[p2]);\n        } else if (is_worse(heap_d[0], heap_idx[0], d, p2)) {\n            heap_replace_root(heap_d, heap_idx, heap_lab, k,\n                              d, p2, plabels[p2]);\n        }\n    }\n\n    char *labels = (char *)malloc(k * sizeof(char));\n    for (int i = 0; i < k; ++i) {\n        if (i < heap_n) labels[i] = heap_lab[i];\n        else labels[i] = -1;\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; ++i) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            ++current_frequency;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(xs); free(ys); free(plabels); free(dists);\n    free(heap_d); free(heap_idx); free(heap_lab); free(labels);\n\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; ++i) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n    return 0;\n}\n```\n\nWe removed the `#pragma omp parallel for simd` and replaced with manual NEON inside a parallel region. But note: we used `#pragma omp parallel for schedule(static)` on the loop that processes vec_len chunks. That will distribute iterations among threads, each thread handles contiguous blocks of 4 points? Actually the loop index p increments by 4; OpenMP will partition the iteration space (0 to total/4) across threads. Each thread gets a set of indices i such that p = i*4. So it's fine.\n\nWe also prefetch xs[p+8] and ys[p+8], which is two iterations ahead (since each iteration processes 4 points, +8 means next block
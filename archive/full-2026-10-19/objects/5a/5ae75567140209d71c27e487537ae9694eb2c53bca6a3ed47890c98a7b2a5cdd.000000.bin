64, total * sizeof(float)) != 0) {\\n        ys = malloc(total * sizeof(float));\\n    }\\n    char *plabels = (char *)malloc(total * sizeof(char));\\n\\n    size_t pos = 0;\\n    for (int gi = 0; gi < n_groups; ++gi) {\\n        Group g = groups[gi];\\n        char lab = g.label;\\n        for (int j = 0; j < g.length; ++j) {\\n            xs[pos] = g.points[j].x;\\n            ys[pos] = g.points[j].y;\\n            plabels[pos] = lab;\\n            ++pos;\\n        }\\n    }\\n\\n    float *dists = NULL;\\n    if (posix_memalign((void **)&dists, 64, total * sizeof(float)) != 0) {\\n        dists = malloc(total * sizeof(float));\\n    }\\n    float tx = to_evaluate.x;\\n    float ty = to_evaluate.y;\\n\\n    // Manual NEON vectorization of the distance loop with prefetching.\\n    long p = 0;\\n    const long total_l = (long)total;\\n    const int vec_len = 4; // float32x4_t\\n    #pragma omp parallel for schedule(static)\\n    for (p = 0; p <= total_l - vec_len; p += vec_len) {\\n        __builtin_prefetch(&xs[p + 8], 0, 3);\\n        __builtin_prefetch(&ys[p + 8], 0, 3);\\n\\n        float32x4_t xv = vld1q_f32(xs + p);\\n        float32x4_t yv = vld1q_f32(ys + p);\\n        float32x4_t txv = vdupq_n_f32(tx);\\n        float32x4_t tyv = vdupq_n_f32(ty);\\n\\n        float32x4_t dx = vsubq_f32(xv, txv);\\n        float32x4_t dy = vsubq_f32(yv, tyv);\\n\\n        float32x4_t d2 = vaddq_f32(vmulq_f32(dx, dx), vmulq_f32(dy, dy));\\n\\n        vst1q_f32(dists + p, d2);\\n    }\\n    // Remainder scalar loop\\n    for (; p < total_l; ++p) {\\n        float dx = xs[p] - tx;\\n        float dy = ys[p] - ty;\\n        dists[p] = dx * dx + dy * dy;\\n    }\\n\\n    float *heap_d = (float *)malloc(k * sizeof(float));\\n    long *heap_idx = (long *)malloc(k * sizeof(long));\\n    char *heap_lab = (char *)malloc(k * sizeof(char));\\n    int heap_n = 0;\\n\\n    for (long p2 = 0; p2 < total_l; ++p2) {\\n        float d = dists[p2];\\n        if (heap_n < k) {\\n            heap
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n#include <string.h>\\n\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\nenum {\\n    KNN_FILTER_TILE = 64,\\n    KNN_RANK_MAX_THREADS = 4,\\n    KNN_RANK_GRAIN = 4096,\\n    KNN_PARTITION_ROUNDS = 32\\n};\\n\\nstatic char knn_vote(char * labels, int k) {\\n    qsort(labels, k, sizeof(char), compare_for_sort);\\n\\n    char most_frequent = labels[0];\\n    int most_frequent_count = 1;\\n    int current_frequency = 1;\\n\\n    for (int i = 1; i < k; i++) {\\n        if (labels[i] != labels[i - 1]) {\\n            if (current_frequency > most_frequent_count) {\\n                most_frequent = labels[i - 1];\\n                most_frequent_count = current_frequency;\\n            }\\n            current_frequency = 1;\\n        } else {\\n            current_frequency++;\\n        }\\n\\n        if (i == k - 1 && current_frequency > most_frequent_count) {\\n            most_frequent = labels[i - 1];\\n            most_frequent_count = current_frequency;\\n        }\\n    }\\n    return most_frequent;\\n}\\n\\nstatic inline void knn_insert_neighbor(float d, char label, int k,\\n                                       char * labels, float * distances,\\n                                       int * used, int * ordered) {\\n    if (*ordered && *used == k && *used > 0 &&\\n        d >= distances[*used - 1]) {\\n        return;\\n    }\\n\\n    int x;\\n    if (*ordered) {\\n        int left = 0;\\n        int right = *used;\\n        while (left < right) {\\n            int middle = left + (right - left) / 2;\\n            if (d < distances[middle]) {\\n                right = middle;\\n            } else {\\n                left = middle + 1;\\n            }\\n        }\\n        x = left;\\n    } else {\\n        for (x = 0; x < *used; x++) {\\n            if (d < distances[x]) {\\n                break;\\n            }\\n        }\\n    }\\n\\n    if (x == k) {\\n        return;\\n    }\\n\\n    int end = *used < k ? *used : k - 1;\\n    if (end > x) {\\n        size_t count = (size_t) (end - x);\\n        memmove(distances + x + 1, distances + x,\\n                count * sizeof(*distances));\\n        memmove(labels + x + 1, labels + x,\\n                count * sizeof(*labels));\\n    }\\n    distances[x] = d;\\n    labels[x] = label;\\n    if (*used < k) {\\n        (*used)++;\\n    }\\n    if (d != d) {\\n        *ordered = 0;\\n    }\\n}\\n\\nstatic char knn_serial(int n_groups, Group * groups, int k, Point to_evaluate) {\\n    char * labels = (char *) malloc((size_t) k * sizeof(*labels));\\n    float * distances = (float *) malloc((size_t) k * sizeof(*distances));\\n    int candidates[KNN_FILTER_TILE];\\n    int used = 0;\\n    int ordered = 1;\\n\\n    for (int i = 0; i < k; i++) {\\n        labels[i] = -1;\\n    }\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n        for (int j = 0; j < g.length; ) {\\n            int count = g.length - j;\\n            if (count > KNN_FILTER_TILE) {\\n                count = KNN_FILTER_TILE;\\n            }\\n\\n            int filter = ordered && used == k && used > 0;\\n            float bound = 0.0f;\\n            if (filter) {\\n                bound = distances[used - 1];\\n                filter = bound >= 0.0f;\\n            }\\n            if (filter) {\\n#if defined(_OPENMP)\\n#pragma omp simd\\n#elif defined(__GNUC__)\\n#pragma GCC ivdep\\n#endif\\n                for (int t = 0; t < count; t++) {\\n                    float dx = g.points[j + t].x - to_evaluate.x;\\n                    float dy = g.points[j + t].y - to_evaluate.y;\\n                    candidates[t] = (dx * dx < bound) & (dy * dy < bound);\\n                }\\n            }\\n\\n            for (int t = 0; t < count; t++) {\\n                if (filter && !candidates[t]) {\\n                    continue;\\n                }\\n                float d = euclidean_distance_no_sqrt(to_evaluate,\\n                                                      g.points[j + t]);\\n                knn_insert_neighbor(d, g.label, k, labels, distances,\\n                                    &used, &ordered);\\n            }\\n            j += count;\\n        }\\n    }\\n\\n    char result = knn_vote(labels, k);\\n    free(distances);\\n    free(labels);\\n    return result;\\n}\\n\\ntypedef struct {\\n    size_t begin;\\n    size_t end;\\n    size_t lo;\\n    size_t hi;\\n    size_t lower;\\n    size_t upper;\\n    size_t below;\\n    size_t equal;\\n    size_t take_equal;\\n    size_t histogram[256];\\n    size_t equal_histogram[256];\\n} KnnRankPart;\\n\\nstatic char knn_histogram_vote(const size_t * histogram) {\\n    char best = 0;\\n    size_t best_count = 0;\\n    for (unsigned int i = 0; i < 256; i++) {\\n        char label = (char) (unsigned char) i;\\n        size_t count = histogram[i];\\n        if (count > best_count ||\\n            (count != 0 && count == best_count && label < best)) {\\n            best = label;\\n            best_count = count;\\n        }\\n    }\\n    return best;\\n}\\n\\nstatic int knn_float_compare(const void * a, const void * b) {\\n    float x = *(const float *) a;\\n    float y = *(const float *) b;\\n    return (x > y) - (x < y);\\n}\\n\\nstatic float knn_rank_pivot(const float * values, const KnnRankPart * parts,\\n                            int part_count, int sorted) {\\n    int chosen = 0;\\n    size_t largest = 0;\\n    for (int p = 0; p < part_count; p++) {\\n        size_t length = parts[p].hi - parts[p].lo;\\n        if (length > largest) {\\n            largest = length;\\n            chosen = p;\\n        }\\n    }\\n\\n    size_t lo = parts[chosen].lo;\\n    size_t hi = parts[chosen].hi;\\n    float b = values[lo + (hi - lo) / 2];\\n    if (sorted) {\\n        return b;\\n    }\\n\\n    float a = values[lo];\\n    float c = values[hi - 1];\\n    if (a > b) {\\n        float temporary = a;\\n        a = b;\\n        b = temporary;\\n    }\\n    if (b > c) {\\n        b = c;\\n    }\\n    if (a > b) {\\n        b = a;\\n    }\\n    return b;\\n}\\n\\nstatic void knn_rank_partition(float * values, KnnRankPart * part,\\n                               float pivot, int sorted) {\\n    if (sorted) {\\n        size_t left = part->lo;\\n        size_t right = part->hi;\\n        while (left < right) {\\n            size_t middle = left + (right - left) / 2;\\n            if (values[middle] < pivot) {\\n                left = middle + 1;\\n            } else {\\n                right = middle;\\n            }\\n        }\\n        part->lower = left;\\n        right = part->hi;\\n        while (left < right) {\\n            size_t middle = left + (right - left) / 2;\\n            if (pivot < values[middle]) {\\n                right = middle;\\n            } else {\\n                left = middle + 1;\\n            }\\n        }\\n        part->upper = left;\\n        return;\\n    }\\n\\n    size_t lower = part->lo;\\n    size_t upper = part->hi;\\n    size_t scan = part->lo;\\n    while (scan < upper) {\\n        float value = values[scan];\\n        if (value < pivot) {\\n            values[scan] = values[lower];\\n            values[lower] = value;\\n            lower++;\\n            scan++;\\n        } else if (value > pivot) {\\n            upper--;\\n            values[scan] = values[upper];\\n            values[upper] = value;\\n        } else {\\n            scan++;\\n        }\\n    }\\n    part->lower = lower;\\n    part->upper = upper;\\n}\\n\\nstatic int knn_fill_part(int n_groups, Group * groups, Point to_evaluate,\\n                         const KnnRankPart * part, float * distances,\\n                         float * values) {\\n    int bad = 0;\\n    size_t offset = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n        size_t length = g.length > 0 ? (size_t) g.length : 0;\\n        size_t group_end = offset + length;\\n        if (group_end > part->begin && offset < part->end) {\\n            size_t first = part->begin > offset ? part->begin - offset : 0;\\n            size_t last = part->end < group_end ? part->end - offset : length;\\n#ifdef _OPENMP\\n#pragma omp simd reduction(|:bad)\\n#endif\\n            for (size_t j = first; j < last; j++) {\\n                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n                distances[offset + j] = d;\\n                values[offset + j] = d;\\n                bad |= (d != d);\\n            }\\n        }\\n        offset = group_end;\\n        if (offset >= part->end) {\\n            break;\\n        }\\n    }\\n    return bad;\\n}\\n\\nstatic void knn_count_part(int n_groups, Group * groups,\\n                           const float * distances, float cutoff,\\n                           KnnRankPart * part) {\\n    memset(part->histogram, 0, sizeof(part->histogram));\\n    memset(part->equal_histogram, 0, sizeof(part->equal_histogram));\\n    part->below = 0;\\n    part->equal = 0;\\n    size_t offset = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n        size_t length = g.length > 0 ? (size_t) g.length : 0;\\n        size_t group_end = offset + length;\\n        if (group_end > part->begin && offset < part->end) {\\n            size_t first = part->begin > offset ? part->begin - offset : 0;\\n            size_t last = part->end < group_end ? part->end - offset : length;\\n            size_t below = 0;\\n            size_t equal = 0;\\n#ifdef _OPENMP\\n#pragma omp simd reduction(+:below,equal)\\n#endif\\n            for (size_t j = first; j < last; j++) {\\n                float d = distances[offset + j];\\n                below += d < cutoff;\\n                equal += d == cutoff;\\n            }\\n            part->histogram[(unsigned char) g.label] += below;\\n            part->equal_histogram[(unsigned char) g.label] += equal;\\n            part->below += below;\\n            part->equal += equal;\\n        }\\n        offset = group_end;\\n        if (offset >= part->end) {\\n            break;\\n        }\\n    }\\n}\\n\\nstatic void knn_add_equal(int n_groups, Group * groups,\\n                          const float * distances, float cutoff,\\n                          KnnRankPart * part) {\\n    size_t remaining = part->take_equal;\\n    if (remaining == 0) {\\n        return;\\n    }\\n    if (remaining == part->equal) {\\n        for (unsigned int i = 0; i < 256; i++) {\\n            part->histogram[i] += part->equal_histogram[i];\\n        }\\n        return;\\n    }\\n\\n    size_t offset = 0;\\n    for (int i = 0; i < n_groups && remaining != 0; i++) {\\n        Group g = groups[i];\\n        size_t length = g.length > 0 ? (size_t) g.length : 0;\\n        size_t group_end = offset + length;\\n        if (group_end > part->begin && offset < part->end) {\\n            size_t first = part->begin > offset ? part->begin - offset : 0;\\n            size_t last = part->end < group_end ? part->end - offset : length;\\n            size_t equal = 0;\\n#ifdef _OPENMP\\n#pragma omp simd reduction(+:equal)\\n#endif\\n            for (size_t j = first; j < last; j++) {\\n                equal += distances[offset + j] == cutoff;\\n            }\\n            size_t take = equal < remaining ? equal : remaining;\\n            part->histogram[(unsigned char) g.label] += take;\\n            remaining -= take;\\n        }\\n        offset = group_end;\\n        if (offset >= part->end) {\\n            break;\\n        }\\n    }\\n}\\n\\nstatic int knn_rank(int n_groups, Group * groups, int k, Point to_evaluate,\\n                     size_t total, int threads, char * result) {\\n    if (total > ((size_t) -1) / sizeof(float)) {\\n        return 0;\\n    }\\n    float * distances = (float *) malloc(total * sizeof(*distances));\\n    float * values = (float *) malloc(total * sizeof(*values));\\n    KnnRankPart * parts = (KnnRankPart *) calloc((size_t) threads,\\n                                                sizeof(*parts));\\n    if (distances == NULL || values == NULL || parts == NULL) {\\n        free(parts);\\n        free(values);\\n        free(distances);\\n        return 0;\\n    }\\n\\n    size_t wanted = (size_t) k < total ? (size_t) k : total;\\n    size_t rank = wanted - 1;\\n    size_t below_count = 0;\\n    size_t equal_count = 0;\\n    float pivot = 0.0f;\\n    float cutoff = 0.0f;\\n    int part_count = 1;\\n    int has_nan = 0;\\n    int finished = 0;\\n    int rounds = 0;\\n    int sorted = 0;\\n\\n#ifdef _OPENMP\\n#pragma omp parallel num_threads(threads) if(threads > 1)\\n#endif\\n    {\\n#ifdef _OPENMP\\n#pragma omp single\\n#endif\\n        {\\n#ifdef _OPENMP\\n            part_count = omp_get_num_threads();\\n#endif\\n            size_t width = total / (size_t) part_count;\\n            size_t extra = total % (size_t) part_count;\\n            size_t offset = 0;\\n            for (int p = 0; p < part_count; p++) {\\n                size_t length = width + ((size_t) p < extra ? 1 : 0);\\n                parts[p].begin = offset;\\n                parts[p].lo = offset;\\n                offset += length;\\n                parts[p].end = offset;\\n                parts[p].hi = offset;\\n            }\\n        }\\n#ifdef _OPENMP\\n#pragma omp for schedule(static) reduction(|:has_nan)\\n#endif\\n        for (int p = 0; p < part_count; p++) {\\n            has_nan |= knn_fill_part(n_groups, groups, to_evaluate, &parts[p],\\n                                      distances, values);\\n        }\\n\\n        if (!has_nan) {\\n            while (!finished) {\\n                if (rounds == KNN_PARTITION_ROUNDS) {\\n#ifdef _OPENMP\\n#pragma omp for schedule(static)\\n#endif\\n                    for (int p = 0; p < part_count; p++) {\\n                        qsort(values + parts[p].lo,\\n                              parts[p].hi - parts[p].lo,\\n                              sizeof(*values), knn_float_compare);\\n                    }\\n#ifdef _OPENMP\\n#pragma omp single\\n#endif\\n                    {\\n                        sorted = 1;\\n                    }\\n                }\\n#ifdef _OPENMP\\n#pragma omp single\\n#endif\\n                {\\n                    pivot = knn_rank_pivot(values, parts, part_count, sorted);\\n                    below_count = 0;\\n                    equal_count = 0;\\n                }\\n#ifdef _OPENMP\\n#pragma omp for schedule(static) reduction(+:below_count,equal_count)\\n#endif\\n                for (int p = 0; p < part_count; p++) {\\n                    knn_rank_partition(values, &parts[p], pivot, sorted);\\n                    below_count += parts[p].lower - parts[p].lo;\\n                    equal_count += parts[p].upper - parts[p].lower;\\n                }\\n#ifdef _OPENMP\\n#pragma omp single\\n#endif\\n                {\\n                    if (rank < below_count) {\\n                        for (int p = 0; p < part_count; p++) {\\n                            parts[p].hi = parts[p].lower;\\n                        }\\n                    } else if (rank - below_count < equal_count) {\\n                        cutoff = pivot;\\n                        finished = 1;\\n                    } else {\\n                        rank -= below_count + equal_count;\\n                        for (int p = 0; p < part_count; p++) {\\n                            parts[p].lo = parts[p].upper;\\n                        }\\n                    }\\n                    rounds++;\\n                }\\n            }\\n\\n#ifdef _OPENMP\\n#pragma omp for schedule(static)\\n#endif\\n            for (int p = 0; p < part_count; p++) {\\n                knn_count_part(n_groups, groups, distances, cutoff, &parts[p]);\\n            }\\n#ifdef _OPENMP\\n#pragma omp single\\n#endif\\n            {\\n                size_t below = 0;\\n                for (int p = 0; p < part_count; p++) {\\n                    below += parts[p].below;\\n                }\\n                size_t remaining = wanted - below;\\n                for (int p = 0; p < part_count; p++) {\\n                    size_t take = parts[p].equal < remaining\\n                                ? parts[p].equal : remaining;\\n                    parts[p].take_equal = take;\\n                    remaining -= take;\\n                }\\n            }\\n#ifdef _OPENMP\\n#pragma omp for schedule(static)\\n#endif\\n            for (int p = 0; p < part_count; p++) {\\n                knn_add_equal(n_groups, groups, distances, cutoff, &parts[p]);\\n            }\\n        }\\n    }\\n\\n    int success = !has_nan;\\n    if (success) {\\n        size_t histogram[256] = {0};\\n        for (int p = 0; p < part_count; p++) {\\n            for (unsigned int i = 0; i < 256; i++) {\\n                histogram[i] += parts[p].histogram[i];\\n            }\\n        }\\n        if ((size_t) k > total) {\\n            char missing = -1;\\n            histogram[(unsigned char) missing] += (size_t) k - total;\\n        }\\n        *result = knn_histogram_vote(histogram);\\n    }\\n    free(parts);\\n    free(values);\\n    free(distances);\\n    return success;\\n}\\n\\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n    if (k <= 64) {\\n        return knn_serial(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    size_t total = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        if (groups[i].length > 0) {\\n            total += (size_t) groups[i].length;\\n        }\\n    }\\n    if (total == 0) {\\n        return knn_serial(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    int threads = 1;\\n#ifdef _OPENMP\\n    threads = omp_get_max_threads();\\n    if (threads < 1) {\\n        threads = 1;\\n    }\\n    if (threads > KNN_RANK_MAX_THREADS) {\\n        threads = KNN_RANK_MAX_THREADS;\\n    }\\n    size_t slots = total / KNN_RANK_GRAIN;\\n    if (slots == 0) {\\n        slots = 1;\\n    }\\n    if ((size_t) threads > slots) {\\n        threads = (int) slots;\\n    }\\n#endif\\n\\n    char result;\\n    if (knn_rank(n_groups, groups, k, to_evaluate, total, threads, &result)) {\\n        return result;\\n    }\\n    return knn_serial(n_groups, groups, k, to_evaluate);\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Combining tiled filtering and prefix-aware insertion with persistent-team distributed rank selection should preserve large-k speedups while reducing serial-path work.\",\n  \"notes\": \"Only src/knn.c changes. Parsing, distance arithmetic and output remain unchanged. No commands or measurements were run.\",\n  \"research\": {\n    \"queries\": [],\n    \"urls\": []\n  },\n  \"sources_kept\": [\n    \"96ce2f7d7cb74170\",\n    \"942e08f2afaa47b7\",\n    \"2de2f2ce2b9649c3\"\n  ],\n  \"transformations\": [\n    \"Use initialized-prefix tracking, stable binary insertion, worst-distance rejection and memmove shifts, with linear insertion after an inserted NaN.\",\n    \"Filter bounded 64-point tiles using SIMD coordinate-square comparisons, then process surviving distances sequentially in original order.\",\n    \"Dispatch k > 64 to persistent-team distributed three-way rank selection, sorting active slices after 32 rounds and subsequently using binary searches.\",\n    \"Resolve cutoff ties using original-order partition budgets and private label histograms; preserve unused-neighbor sentinels and free per-call buffers.\"\n  ]\n}"}}

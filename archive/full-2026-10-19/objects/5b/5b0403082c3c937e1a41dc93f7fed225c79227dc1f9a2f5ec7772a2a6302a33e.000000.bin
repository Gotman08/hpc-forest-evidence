"""Read-only receipt for one explicitly referenced future R4b technical phase.

This is not an admission builder, a cache/cohort census, or a performance audit.
Nothing is executed and no receipt is written. Invalid evidence raises ReceiptError.
"""
from __future__ import annotations

import hashlib
import importlib
import importlib.util
import json
import math
import re
import sys
import zipfile
from pathlib import Path
from types import SimpleNamespace

NORMALISATION_SHA = '46662bde26ff2fd68b7ce6bbe7217e492a98ab34cbb7aff08a53324755b74da7'
_normal_path = Path(__file__).parent / 'normalisation_native.py'
if hashlib.sha256(_normal_path.read_bytes()).hexdigest() != NORMALISATION_SHA:
    raise RuntimeError('Changed isolated normalization module')
_normal_spec = importlib.util.spec_from_file_location('isolated_normalisation_r3', _normal_path)
normalisation = importlib.util.module_from_spec(_normal_spec)
_normal_spec.loader.exec_module(normalisation)
SUPPORTED_CONTRACT_SESSIONS = {'gpt-6.1-sol': {'roots': '277b1e33ea5e4af6af1c9144ce970ac4', 'advice': 'b86d18fcf35d4031aa2ef0da49397c4e', 'harvest': '7c8bc0c5ae22467da05600fb735fc017'}, 'gpt-6-astra': {'roots': '5033baf5d38042efb8ab834a59437d19', 'advice': '7be16898433e49f4b481045079abbbe8', 'harvest': 'b6fc9cf3951d46d787f319b51905251b'}, 'gpt-5.6-terra': {'roots': 'd5007804188a4fc793582a26e47c556c', 'advice': '7516e40883c64ab8af8a38637d74de3f', 'harvest': '7d6f357d4e5741bb8349835f358563b2'}}
WORKER_CACHE_PARENT = Path(__file__).resolve().parents[3] / 'lancement-modeles-max-r3'

SCOPE = "hpc-forest-dynamic-independent-roots-r4b-max"
SOURCE_SHA = "eaff9217499fe268e4d151165a368a83bad1550d921955a9f9256026cfac2d48"
PLAN_SHA = "f927d37098f3fd50cc4916195da3e300bd7c29597ba7ece4b9669abd715897fe"
CLI_SHA = "f6dbf48cb70f62649c645f26c87dc9bf84cc36986202dfad8e12fb5b8ca70312"
CLI_FILES = {
    "codex.exe": CLI_SHA,
    "codex-code-mode-host.exe": "3b6a9179a4da17fa5fc6948219cd61486dc3b534c683838076d8c61bd311c68e",
    "codex-command-runner.exe": "ce80b56a2f37f808815fde33cceb97ac858ceecde296425ad3860f0f37fb4877",
    "codex-windows-sandbox-setup.exe": "c4da812016cbfb92d9a62791f78460c59e9662faadb0a2720d3aa5d0535b80bd",
}
PROTOCOL = "hpc-forest-codex-mailbox-v1"
PHASES = {"roots", "advice", "harvest"}

#include <cassert>
#include <cstddef>
#include <cstdio>
#include <memory>
#include <vector>

class BufferedInput {
    unsigned char buffer_[1 << 16];
    std::size_t position_ = 0;
    std::size_t length_ = 0;

    int nextChar() {
        if (position_ == length_) {
            length_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);
            position_ = 0;
            if (length_ == 0) return EOF;
        }
        return buffer_[position_++];
    }

public:
    bool readInt(int& result) {
        int c;
        do {
            c = nextChar();
            if (c == EOF) return false;
        } while (c <= ' ');

        bool negative = false;
        if (c == '-' || c == '+') {
            negative = (c == '-');
            c = nextChar();
        }
        unsigned int value = 0;
        while (c >= '0' && c <= '9') {
            value = value * 10u + static_cast<unsigned int>(c - '0');
            c = nextChar();
        }
        const long long magnitude = static_cast<long long>(value);
        result = static_cast<int>(negative ? -magnitude : magnitude);
        return true;
    }
};

int main() {
    BufferedInput input;
    int n, s;
    if (!input.readInt(n) || !input.readInt(s)) return 0;

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    const std::size_t width = static_cast<std::size_t>(n);
    std::unique_ptr<int[]> rows(new int[width * static_cast<std::size_t>(s)]);
    std::vector<long long> columns(n, 0);

    for (int r = 0; r < s; ++r) {
        int* row = rows.get() + static_cast<std::size_t>(r) * width;
        for (int c = 0; c < n; ++c) {
            int value = 0;
            input.readInt(value);
            row[c] = value;
            columns[c] += value;
        }
    }

    long long window = 0;
    for (int c = 0; c < s; ++c) window += columns[c];
    long long maximum = window;
    for (int c = s; c < n; ++c) {
        window += columns[c] - columns[c - s];
        if (window > maximum) maximum = window;
    }

    int slot = 0;
    for (int r = s; r < n; ++r) {
        int* row = rows.get() + static_cast<std::size_t>(slot) * width;
        window = 0;
        for (int c = 0; c < s; ++c) {
            int value = 0;
            input.readInt(value);
            columns[c] += static_cast<long long>(value) - row[c];
            row[c] = value;
            window += columns[c];
        }
        if (window > maximum) maximum = window;

        for (int c = s; c < n; ++c) {
            int value = 0;
            input.readInt(value);
            columns[c] += static_cast<long long>(value) - row[c];
            row[c] = value;
            window += columns[c] - columns[c - s];
            if (window > maximum) maximum = window;
        }

        ++slot;
        if (slot == s) slot = 0;
    }

    std::printf("%lld\n", maximum);
    return 0;
}

      "content": "#include <algorithm>\n#include <cstring>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconstexpr int MOD = 1000000007;\n\nusing Int4 = int __attribute__((vector_size(16)));\nstatic const Int4 mod4 = {MOD, MOD, MOD, MOD};\n\nstatic inline int addmod(int a, int b) {\n    const int sum = a + b;\n    return sum >= MOD ? sum - MOD : sum;\n}\n\nstatic inline Int4 addmod4(Int4 a, Int4 b) {\n    const Int4 sum = a + b;\n    return sum - ((sum >= mod4) & mod4);\n}\n\nstatic inline int process_clear_run(vector<int>& dp, int first, int last, int carry) {\n    int x = first;\n    for (; x + 4 <= last; x += 4) {\n        Int4 old_values;\n        memcpy(&old_values, dp.data() + x, sizeof(old_values));\n\n        const int a = old_values[0];\n        const int b = old_values[1];\n        const int c = old_values[2];\n        const int d = old_values[3];\n        const int ab = addmod(a, b);\n        const int cd = addmod(c, d);\n\n        Int4 prefixes = {a, ab, addmod(ab, c), addmod(ab, cd)};\n        const Int4 carries = {carry, carry, carry, carry};\n        prefixes = addmod4(prefixes, carries);\n        memcpy(dp.data() + x, &prefixes, sizeof(prefixes));\n        carry = prefixes[3];\n    }\n\n    for (; x < last; ++x) {\n        carry = addmod(dp[x], carry);\n        dp[x] = carry;\n    }\n    return carry;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) {\n        return 0;\n    }\n\n    vector<vector<int>> blocked(n);\n    for (int k = 0; k < m; ++k) {\n        int y, x;\n        cin >> y >> x;\n        blocked[y].push_back(x);\n    }\n    for (vector<int>& row : blocked) {\n        sort(row.begin(), row.end());\n        row.erase(unique(row.begin(), row.end()), row.end());\n    }\n\n    vector<int> dp(n, 0);\n    dp[0] = 1;\n\n    for (int y = 0; y < n; ++y) {\n        int carry = 0;\n        int first = 0;\n        for (int x : blocked[y]) {\n            carry = process_clear_run(dp, first, x, carry);\n            dp[x] = 0;\n            carry = 0;\n            first = x + 1;\n        }\n        process_clear_run(dp, first, n, carry);\n    }\n\n    cout << dp[n - 1] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "The measured fastest archived design should retain its advantage: sparse per-row obstacles eliminate quadratic memory, while a single in-place DP row and four-cell vectorized segmented prefix scans reduce dense-grid work and memory traffic.",

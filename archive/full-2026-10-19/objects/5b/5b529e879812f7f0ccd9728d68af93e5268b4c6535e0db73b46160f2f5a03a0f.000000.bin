        "content": "#include \"knn.h\"\n#include <string.h>\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n\n    int i, j;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            float worst = distances[k - 1];\n\n            /* Ordered comparison leaves NaNs on the original search path. */\n            if (worst != -1.0f && d >= worst) {\n                continue;\n            }\n\n            /* Find the first match without an early-exit loop dependency. */\n            int insertion = k;\n            #pragma omp simd reduction(min: insertion)\n            for (int x = 0; x < k; x++) {\n                int candidate = (d < distances[x] || distances[x] == -1.0f)\n                              ? x : k;\n                if (candidate < insertion) {\n                    insertion = candidate;\n                }\n            }\n\n            if (insertion < k) {\n                size_t count = (size_t) (k - insertion - 1);\n                if (count != 0) {\n                    /* These shifts overlap and must not be independent stores. */\n                    memmove(distances + insertion + 1, distances + insertion,\n                            count * sizeof(*distances));\n                    memmove(labels + insertion + 1, labels + insertion,\n                            count * sizeof(*labels));\n                }\n\n                distances[insertion] = d;\n                labels[insertion] = g.label;\n            }\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
        "path": "src/knn.c"
      }

  "files": [
    {
      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <algorithm>\n#include <climits>\n#include <cstdint>\n#include <arm_neon.h>\n#include <omp.h>\n\nint main() {\n    int n, s;\n    std::cin >> n >> s;\n    std::vector<std::vector<int>> matrix(n, std::vector<int>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            scanf(\"%d\", &(matrix[i][j]));\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    // Build integral image (prefix sum) with dimensions (n+1)x(n+1)\n    std::vector<int64_t> ps((n + 1) * (n + 1));\n    for (int i = 0; i <= n; ++i) {\n        int row_offset_i = i * (n + 1);\n        int row_offset_im1 = (i - 1) * (n + 1);\n        for (int j = 0; j <= n; ++j) {\n            if (i == 0 || j == 0) {\n                ps[row_offset_i + j] = 0;\n            } else {\n                int64_t val = matrix[i - 1][j - 1];\n                ps[row_offset_i + j] = val\n                    + ps[row_offset_im1 + j]\n                    + ps[row_offset_i + (j - 1)]\n                    - ps[row_offset_im1 + (j - 1)];\n            }\n        }\n    }\n\n    int64_t mxSum = LLONG_MIN;\n    const int cols = n - s + 1;   // number of submatrix positions per row\n\n#pragma omp parallel for reduction(max:mxSum)\n    for (int i = 0; i <= n - s; ++i) {\n        int base_i_ps  = i * (n + 1);\n        int base_is_ps = (i + s) * (n + 1);\n\n        int j;\n        for (j = 0; j < cols; ) {\n            // Process two columns at once using NEON if possible\n            if (j + 2 <= cols) {\n                // Load four prefix values needed for two submatrix sums:\n                //   sum_k = ps[i+s][j+k+s] - ps[i][j+k+s] - ps[i+s][j+k] + ps[i][j+k]\n                int64x2_t v_ps_is_js = vld1q_s64(&ps[base_is_ps + j + s]);  // [k=0, k=1]\n                int64x2_t v_ps_i_js  = vld1q_s64(&ps[base_i_ps  + j + s]);\n                int64x2_t v_ps_is_j  = vld1q_s64(&ps[base_is_ps + j]);\n                int64x2_t v_ps_i_j   = vld1q_s64(&ps[base_i_ps  + j]);\n\n                // Compute (A - B) - (C - D) = A - B - C + D\n                int64x2_t diff1 = vsubq_s64(v_ps_is_js, v_ps_i_js);\n                int64x2_t diff2 = vsubq_s64(v_ps_is_j,  v_ps_i_j);\n                int64x2_t sum_vec = vsubq_s64(diff1, diff2);\n\n                // Extract both sums and update max\n                alignas(16) int64_t sums[2];\n                vst1q_s64(sums, sum_vec);\n                mxSum = std::max(mxSum, sums[0]);\n                mxSum = std::max(mxSum, sums[1]);\n\n                j += 2;\n            } else {\n                // Scalar remainder for the last column (if cols is odd)\n                int64_t sum = ps[base_is_ps + j + s]\n                            - ps[base_i_ps  + j + s]\n                            - ps[base_is_ps + j]\n                            + ps[base_i_ps  + j];\n                mxSum = std::max(mxSum, sum);\n                ++j;\n            }\n        }\n    }\n\n    printf(\"%d\\n\", static_cast<int>(mxSum));\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Use integral-image (prefix-sum) algorithm with ARM NEON SIMD intrinsics to compute two submatrix sums simultaneously per iteration, combined with OpenMP parallelization over rows. This eliminates loop-carried dependencies of the original sliding window and exploits both vector units and thread-level parallelism on ARM64.",
  "notes": "Fixed previous build issues: included <climits> for LLONG_MIN, used int64_t (via <cstdint>) to match NEON intrinsic pointer types without casts. The prefix array is stored as std::vector<int64_t>. Vectorized inner loop processes two columns at once using vld1q_s64/vsubq_s64; remainder handled scalar. OpenMP reduction(max:mxSum) over rows ensures correctness.",

    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n#include <string.h>\\n\\nchar knn_flat(size_t total, const float *xs, const float *ys, const char *labels, int k, Point to_evaluate) {\\n    float *heap_dist = (float *) malloc(sizeof(float) * k);\\n    char *heap_label = (char *) malloc(sizeof(char) * k);\\n    int hsize = 0;\\n    float px = to_evaluate.x;\\n    float py = to_evaluate.y;\\n\\n    for (size_t i = 0; i < total; i++) {\\n        // Prefetch a few iterations ahead to hide memory latency.\\n        if (i + 8 < total) {\\n            __builtin_prefetch(&xs[i+8], 0, 1);\\n            __builtin_prefetch(&ys[i+8], 0, 1);\\n            __builtin_prefetch(&labels[i+8], 0, 1);\\n        }\\n\\n        float dx = xs[i] - px;\\n        float dy = ys[i] - py;\\n        float d = dx * dx + dy * dy;\\n        char label = labels[i];\\n\\n        if (hsize < k) {\\n            int pos = hsize++;\\n            heap_dist[pos] = d;\\n            heap_label[pos] = label;\\n\\n            while (pos > 0) {\\n                int parent = (pos - 1) >> 1;\\n                if (heap_dist[parent] < heap_dist[pos]) {\\n                    float td = heap_dist[parent];\\n                    heap_dist[parent] = heap_dist[pos];\\n                    heap_dist[pos] = td;\\n\\n                    char tl = heap_label[parent];\\n                    heap_label[parent] = heap_label[pos];\\n                    heap_label[pos] = tl;\\n\\n                    pos = parent;\\n                } else {\\n                    break;\\n                }\\n            }\\n        } else if (d < heap_dist[0]) {\\n            heap_dist[0] = d;\\n            heap_label[0] = label;\\n\\n            int pos = 0;\\n            while (1) {\\n                int left = (pos << 1) + 1;\\n                int right = left + 1;\\n                int largest = pos;\\n\\n                if (left < hsize && heap_dist[left] > heap_dist[largest]) {\\n                    largest = left;\\n                }\\n                if (right < hsize && heap_dist[right] > heap_dist[largest]) {\\n                    largest = right;\\n                }\\n\\n                if (largest != pos) {\\n                    float td = heap_dist[pos];\\n                    heap_dist[pos] = heap_dist[largest];\\n                    heap_dist[largest] = td;\\n\\n                    char tl = heap_label[pos];\\n                    heap_label[pos] = heap_label[largest];\\n                    heap_label[largest] = tl;\\n\\n                    pos = largest;\\n                } else {\\n                    break;\\n                }\\n            }\\n        }\\n    }\\n\\n    int freq[256] = {0};\\n    for (int i = 0; i < hsize; i++) {\\n        freq[(unsigned char)heap_label[i]]++;\\n    }\\n\\n    // The original implementation initializes all k slots with label -1.\\n    // If fewer than k points were seen, those missing slots still participate\\n    // in the frequency count and tie-breaking.\\n    if (hsize < k) {\\n        freq[255] += k - hsize;\\n    }\\n\\n    char best = 0;\\n    int best_count = -1;\\n    for (int c = -128; c <= 127; c++) {\\n        unsigned char idx = (unsigned char)c;\\n        if (freq[idx] > best_count) {\\n            best_count = freq[idx];\\n            best = (char)c;\\n        }\\n    }\\n\\n    free(heap_dist);\\n    free(heap_label);\\n    return best;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    size_t total = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        total += (size_t)groups[i].length;\\n    }\\n\\n    float *xs_all = (float *) malloc(sizeof(float) * total);\\n    float *ys_all = (float *) malloc(sizeof(float) * total);\\n    char *labels_all = (char *) malloc(sizeof(char) * total);\\n\\n    size_t offset = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        int len = groups[i].length;\\n        if (len > 0) {\\n            memcpy(xs_all + offset, groups[i].xs, sizeof(float) * len);\\n            memcpy(ys_all + offset, groups[i].ys, sizeof(float) * len);\\n            memset(labels_all + offset, groups[i].label, (size_t)len);\\n        }\\n        offset += (size_t)len;\\n    }\\n\\n    int k = parse_k();\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn_flat(total, xs_all, ys_all, labels_all, k, to_evaluate));\\n\\n    // Free allocations.\\n    for (int i = 0; i < n_groups; i++) {\\n        free(groups[i].xs);\\n        free(groups[i].ys);\\n    }\\n    free(groups);\\n    free(xs_all);\\n    free(ys_all);\\n    free(labels_all);\\n\\n    return 0;\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Flattening all group point data into contiguous global SoA arrays (xs_all, ys_all, labels_all) eliminates scattered per-group heap allocations and improves cache/TLB locality during the sequential distance scan. Prefetching a few iterations ahead further hides memory latency. This reduces loop overhead and branch mispredictions compared to nested loops over groups.\",\n  \"notes\": \"The candidate copies parsed group data into one contiguous block before scanning, then uses a single flat loop with software prefetching. The heap-based top-k selection logic is preserved exactly from the parent experiment. All correctness-sensitive details (tie-breaking, missing-slot handling) remain unchanged.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Flatten per-group SoA into global contiguous arrays\",\n    \"Replace nested group/point loops with a single flat loop\",\n    \"Add software prefetching for xs, ys, and labels\"\n  ]\n}",

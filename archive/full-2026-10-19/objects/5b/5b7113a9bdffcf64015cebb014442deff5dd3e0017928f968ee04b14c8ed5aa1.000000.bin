"""Publish a received first-start check in operator guides; no remote/runtime action."""
from pathlib import Path
import datetime
import hashlib
import json
import re


BASE = Path(__file__).resolve().parents[2]
OUT = Path(__file__).resolve().parent
RECEPTION = OUT / "reception-premier-demarrage-751992"
STUDY = BASE / "outputs/HPC-Forest-Etude-2020-2024-r1"
GUIDE = BASE / "outputs/HPC-Forest-Harnais-Comparaison-r1/SUIVI-COMPACT.md"


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def read(path):
    return json.loads(path.read_text(encoding="utf8"))


def verify_local_refs(value):
    count = 0
    if isinstance(value, dict):
        if isinstance(value.get("path"), str) and isinstance(value.get("sha256"), str):
            path = Path(value["path"])
            if path.is_absolute():
                assert path.resolve().is_relative_to(BASE.resolve())
                assert sha(path) == value["sha256"], str(path)
                count += 1
        for item in value.values():
            count += verify_local_refs(item)
    elif isinstance(value, list):
        for item in value:
            count += verify_local_refs(item)
    return count


def main():
    checked = RECEPTION / "reception-premier-demarrage-verifiee.json"
    audit = read(checked)
    assert audit["verified"] is True, "Received independent check required"
    assert sha(checked) == "2139138a2a48d9750a69723b6cd46257ffc84f51dba11d22af8de98ec050f07a"
    assert audit["all_33_direct_remote_refs_SHA_verified"] is True
    assert audit["received_bytes_before_after_identical"] is True
    assert audit["confirmed_infrastructure_defects"] == []
    assert audit["final_scientific_or_cohort_admission"] is False
    assert audit["extension_to_other_models_allowed"] is False
    assert audit["started_claims_reconciliation"]["requests"] == 2
    assert audit["started_claims_reconciliation"]["known_exact_tokens_at_first_boundary"] == 37858
    local_refs_verified = verify_local_refs(audit)
    assert local_refs_verified >= 33
    produced = RECEPTION / "premier-demarrage-verifie.json"
    assert sha(produced) == audit["first_start_receipt_sha256"]
    first = read(produced)
    assert first["verified"] is True and first["job_id"] == "751992"
    assert first["model"] == "gpt-6-luna" and first["effort"] == "max"
    assert first["session_id"] == "c8044062692149138d826d3f388a08ef"
    assert first["source_zip_sha256"] == "3e290f835570a8746be3c52144932b8c6866564980fd858cf4c0495a7b1e68c5"
    assert first["plan_sha256"] == "54ffd49f4dc868085d22208f773c4b4883590b25251b5992232509a1dc197024"
    evaluation = read(RECEPTION / "premiere-evaluation-reelle.json")
    assert evaluation["experiment_id"] == "6a8571a740854bf6"
    assert evaluation["outcome"]["status"] == "valid"
    assert evaluation["outcome"]["correct"] is True
    assert sha(RECEPTION / "premiere-evaluation-reelle.json") == audit["first_evaluation_sha256"]
    guide = GUIDE.read_text(encoding="utf8")
    old = "Premier appel normal enfant livré/première évaluation/erreurs EN ATTENTE ; mère de préparation engagée, aucun total exact de consommation encore reçu."
    assert guide.count(old) == 1
    new = (
        "Premier démarrage natif REÇU ET CONTRÔLÉ : premier enfant normal 636caff92f0f43aa9c420bea527852ed livré ; "
        "première évaluation 6a8571a740854bf6 valid/correct:true sur le contrat fini. Identité Luna/MAX, source/plan/CLI, "
        "allocation et transport vérifiés ; achèvements RC0 et zéro événement d’outil. Les avertissements CLI "
        "non bloquants restent explicitement consignés ; ne pas présenter les journaux comme exempts d’erreurs. Reçu indépendant : "
        "../HPC-Forest-Primes-Natif-Lancement-r1/reception-premier-demarrage-751992/reception-premier-demarrage-verifiee.json "
        f"SHA {sha(checked)}. Réconciliation bornée aux deux appels mère/enfant du premier batch ; "
        "elle ne vaut pas total de la cohorte en cours. Aucune performance finale ni cinq confirmations reçues par ce seul contrôle."
    )
    guide = guide.replace(old, new)
    guide = guide.replace("## R2 Luna MAX — premier démarrage réel en cours", "## R2 Luna MAX — premier démarrage vérifié, recherche en cours")
    guide = guide.replace("## R1 supplément clos et R2 en qualification", "## R1 supplément clos et R2 natif engagé")
    r3_marker = "Lire ../HPC-Forest-Mere-Dynamique-r4/REPRISE.md."
    assert guide.count(r3_marker) == 1
    projection_validation = BASE / "outputs/HPC-Forest-Mere-Dynamique-MAX-Preparation-r1/validation-locale.json"
    assert sha(projection_validation) == "347d4e6a822985de04f6cbdbf5c5250662aaa44d5db5dd90e1b4fb99c11764bf"
    projection = read(projection_validation)
    assert projection["neutral_tests_passed"] == 22 and projection["ruff_passed"] is True
    assert projection["native_admission_verified"] is False and projection["launcher_implemented"] is False
    guide = guide.replace(r3_marker, r3_marker + (
        " Préparation extérieure MAX : ../HPC-Forest-Mere-Dynamique-MAX-Preparation-r1/REPRISE.md, "
        "22 tests neutres/Ruff, huit artefacts R4 inchangés. Le plan historique à cinq efforts reste scellé ; "
        "projection limitée à Luna count MAX puis Sol count MAX. Contrats natifs, raccord/lanceur et premier démarrage "
        "encore NON ADMIS ; aucune cellule R3 lancée."
    ))
    marker = "Conserver aussi le cache complet du relais et les dix admissions."
    assert guide.count(marker) == 1
    guide = guide.replace(marker, marker + (
        "\n\nLimite à conserver dans l’audit final R2 : les sorties brutes privées sont inventoriées, mais leurs fichiers "
        "ne lient pas fortement chaque stdout à un binaire/une phase. Ne pas revendiquer une attribution brute indépendante "
        "par candidat sur ces seuls fichiers. Adaptateur isolé préparé sous ../HPC-Forest-Primes-Natif-Audit-r1/ ; "
        "aucune source ou évaluation vivante modifiée pour cette limite."
    ))
    guide = re.sub(r"\n{3,}", "\n\n", guide).rstrip() + "\n"
    id_path = BASE / "ID.md"
    ids = id_path.read_text(encoding="utf8")
    old_ids = re.findall(r"^\| (ID-\d{3}) \|", ids, flags=re.M)
    assert len(old_ids) == 40 and len(set(old_ids)) == 40
    old_status = "R1 MAX complet 60/60 ; R2 primes certifié fini, première cellule Luna MAX 751992 engagée ; contrôle du premier démarrage et bilan natif encore attendus"
    assert ids.count(old_status) == 1
    ids = ids.replace(old_status, "R1 MAX complet 60/60 ; R2 primes certifié fini, Luna MAX 751992 en cours ; premier appel normal et première évaluation reçus/contrôlés, bilan final natif encore attendu")
    old_check = "Contrôle obligatoire du premier démarrage de CHAQUE R2/R3/R4/R5 avant extension ; reçus techniques à produire lors des lancements réels"
    assert ids.count(old_check) == 1
    ids = ids.replace(old_check, "Contrôle obligatoire du premier démarrage de CHAQUE R2/R3/R4/R5 avant extension ; reçu R2 Luna MAX 751992 vérifié, autres premiers démarrages encore à produire")
    assert re.findall(r"^\| (ID-\d{3}) \|", ids, flags=re.M) == old_ids
    snapshot = STUDY / "reprises/reorientation-max-20261017/suivi-premier-demarrage-r2-751992"
    snapshot.mkdir(exist_ok=False)
    before = {}
    for source, name in [(GUIDE, "SUIVI-COMPACT-avant.md"), (id_path, "ID-avant.md")]:
        target = snapshot / name
        target.write_bytes(source.read_bytes())
        assert sha(target) == sha(source)
        before[str(source)] = sha(source)
    GUIDE.write_text(guide, encoding="utf8", newline="\n")
    id_path.write_text(ids, encoding="utf8", newline="\n")
    receipt = {
        "verified": True,
        "utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "job_id": "751992",
        "received_check": {"path": str(checked), "sha256": sha(checked)},
        "produced_first_start_sha256": sha(produced),
        "before": before,
        "after": {str(GUIDE): sha(GUIDE), str(id_path): sha(id_path)},
        "id_rows_retained": 40,
        "local_receipt_refs_reverified": local_refs_verified,
        "r3_external_preparation_validation_sha256": sha(projection_validation),
        "final_cohort_audit_received": False,
        "automatic_extension": False,
        "runtime_or_source_modified": False,
    }
    (snapshot / "suivi-actualise.json").write_text(json.dumps(receipt, ensure_ascii=False, indent=2) + "\n", encoding="utf8")
    print(json.dumps(receipt, ensure_ascii=True))


if __name__ == "__main__":
    main()

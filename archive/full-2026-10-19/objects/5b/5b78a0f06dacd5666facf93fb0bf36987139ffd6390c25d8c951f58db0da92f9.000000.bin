        "content": "#include<stdio.h>\n#include<stdlib.h>\n#include<math.h>\n#ifdef _OPENMP\n#include<omp.h>\n#endif\n\nvoid bubble_sort(double *matriz, int tam) {\n    int i, j;\n    double aux;\n    for (i = tam - 1; i > 0; i--) {\n        for (j = 0; j < i; j++) {\n            if (matriz[j] > matriz[j + 1]) {\n                aux = matriz[j];\n                matriz[j] = matriz[j + 1];\n                matriz[j + 1] = aux;\n            }\n        }\n    }\n}\n\nvoid ordena_colunas(double *matriz, int lin, int col) {\n    int i;\n    for (i = 0; i < col; i++) {\n        bubble_sort(&matriz[(size_t)i * lin], lin);\n    }\n}\n\nvoid calcula_media(double *matriz, double *vet, int lin, int col) {\n    int i, j;\n    double soma;\n    for (i = 0; i < col; i++) {\n        soma = 0;\n        for (j = 0; j < lin; j++) {\n            soma += matriz[(size_t)i * lin + j];\n        }\n        vet[i] = soma / lin;\n    }\n}\n\nvoid calcula_media_harmonica(double *matriz, double *vet, int lin, int col) {\n    int i, j;\n    double soma;\n    for (i = 0; i < col; i++) {\n        soma = 0;\n        for (j = 0; j < lin; j++) {\n            soma += (1 / matriz[(size_t)i * lin + j]);\n        }\n        vet[i] = lin / soma;\n    }\n}\n\nvoid calcula_mediana(double *matriz, double *vet, int lin, int col) {\n    int i;\n    for (i = 0; i < col; i++) {\n        double *coluna = matriz + (size_t)i * lin;\n        if ((lin - 1) % 2) {\n            vet[i] = coluna[lin / 2 - 1] + coluna[lin / 2];\n            vet[i] *= 0.5;\n        } else {\n            vet[i] = coluna[lin / 2];\n        }\n    }\n}\n\ndouble moda_aux(double *matriz, int lin) {\n    int i, j;\n    int ordenada = 1;\n    float conta = 0, moda = 0;\n\n    for (i = 0; i < lin; i++) {\n        if (isnan(matriz[i]) || (i > 0 && matriz[i - 1] > matriz[i])) {\n            ordenada = 0;\n            break;\n        }\n    }\n\n    if (ordenada) {\n        i = 0;\n        while (i < lin) {\n            int fim = i + 1;\n            while (fim < lin && matriz[fim] == matriz[i]) {\n                fim++;\n            }\n            /* Preserve the original float counter and value conversions,\n               including their behavior for very long equal-value runs. */\n            for (j = i; j < fim; j++) {\n                double cont = (double)(fim - j - 1);\n                if (cont > conta) {\n                    conta = (float)cont;\n                    moda = (float)matriz[j];\n                }\n            }\n            i = fim;\n        }\n    } else {\n        /* NaNs can prevent bubble sort from grouping equal values. */\n        for (i = 0; i < lin; i++) {\n            double cont = 0;\n            for (j = i + 1; j < lin; j++) {\n                if (matriz[i] == matriz[j]) {\n                    cont++;\n                    if (cont > conta) {\n                        conta = (float)cont;\n                        moda = (float)matriz[i];\n                    }\n                }\n            }\n        }\n    }\n\n    if (conta == 0) {\n        return -1;\n    }\n    return moda;\n}\n\nvoid calcula_moda(double *matriz, double *moda, int lin, int col) {\n    int i;\n    for (i = 0; i < col; i++) {\n        moda[i] = moda_aux(matriz + (size_t)i * lin, lin);\n    }\n}\n\nvoid calcula_variancia(double *matriz, double *media, double *variancia,\n                       int lin, int col) {\n    int i, j;\n    double soma;\n    for (i = 0; i < col; i++) {\n        soma = 0;\n        for (j = 0; j < lin; j++) {\n            soma += pow((matriz[(size_t)i * lin + j] - media[i]), 2);\n        }\n        variancia[i] = soma / (lin - 1);\n    }\n}\n\nvoid calcula_desvio_padrao(double *variancia, double *dp, int col) {\n    int i;\n    for (i = 0; i < col; i++) {\n        dp[i] = sqrt(variancia[i]);\n    }\n}\n\nvoid calcula_coeficiente_variacao(double *media, double *dp, double *cv, int col) {\n    int i;\n    for (i = 0; i < col; i++) {\n        cv[i] = dp[i] / media[i];\n    }\n}\n\nstatic void calcula_uma_coluna(double *matriz, double *media, double *media_har,\n                               double *mediana, double *moda, double *variancia,\n                               double *dp, double *cv, int lin, int coluna) {\n    double *dados = matriz + (size_t)coluna * lin;\n    double soma = 0;\n    double soma_har = 0;\n    int j;\n\n    /* Both reductions retain their original input order. */\n    for (j = 0; j < lin; j++) {\n        soma += dados[j];\n        soma_har += (1 / dados[j]);\n    }\n    media[coluna] = soma / lin;\n    media_har[coluna] = lin / soma_har;\n\n    bubble_sort(dados, lin);\n    calcula_mediana(dados, mediana + coluna, lin, 1);\n    moda[coluna] = moda_aux(dados, lin);\n    /* Variance still accumulates deviations in sorted order. */\n    calcula_variancia(dados, media + coluna, variancia + coluna, lin, 1);\n    calcula_desvio_padrao(variancia + coluna, dp + coluna, 1);\n    calcula_coeficiente_variacao(media + coluna, dp + coluna, cv + coluna, 1);\n}\n\nstatic void calcula_estatisticas(double *matriz, double *media, double *media_har,\n                                 double *mediana, double *moda, double *variancia,\n                                 double *dp, double *cv, int lin, int col) {\n    int i;\n#ifdef _OPENMP\n    int workers = omp_get_max_threads();\n    double comparacoes = 0.5 * (double)lin * ((double)lin - 1.0) * (double)col;\n    if (workers > 4) {\n        workers = 4;\n    }\n    if (workers > col) {\n        workers = col;\n    }\n    /* Amortize a single team startup over substantial sorting work. */\n    if (workers > 1 && comparacoes >= 65536.0 * workers && !omp_in_parallel()) {\n#pragma omp parallel for schedule(static) num_threads(workers)\n        for (i = 0; i < col; i++) {\n            calcula_uma_coluna(matriz, media, media_har, mediana, moda,\n                               variancia, dp, cv, lin, i);\n        }\n        return;\n    }\n#endif\n    for (i = 0; i < col; i++) {\n        calcula_uma_coluna(matriz, media, media_har, mediana, moda,\n                           variancia, dp, cv, lin, i);\n    }\n}\n\nint main(int argc, char **argv) {\n    int lin, col, i, j;\n    double *matriz, *mediana, *media, *media_har, *moda, *variancia, *dp, *cv;\n\n    fscanf(stdin, \"%d \", &lin);\n    fscanf(stdin, \"%d\\n\", &col);\n\n    matriz = (double *)malloc((size_t)lin * (size_t)col * sizeof(double));\n    media = (double *)malloc((size_t)col * sizeof(double));\n    media_har = (double *)malloc((size_t)col * sizeof(double));\n    mediana = (double *)malloc((size_t)col * sizeof(double));\n    moda = (double *)malloc((size_t)col * sizeof(double));\n    variancia = (double *)malloc((size_t)col * sizeof(double));\n    cv = (double *)malloc((size_t)col * sizeof(double));\n    dp = (double *)malloc((size_t)col * sizeof(double));\n\n    for (i = 0; i < lin; i++) {\n        for (j = 0; j < col; j++) {\n            fscanf(stdin, \"%lf \", &matriz[(size_t)j * lin + i]);\n        }\n    }\n\n    calcula_estatisticas(matriz, media, media_har, mediana, moda,\n                          variancia, dp, cv, lin, col);\n\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", media[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", media_har[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", mediana[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", moda[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", variancia[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", dp[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", cv[i]);\n    printf(\"\\n\");\n\n    free(matriz);\n    free(media);\n    free(media_har);\n    free(mediana);\n    free(moda);\n    free(variancia);\n    free(dp);\n    free(cv);\n    return 0;\n}\n",
        "path": "src/est_matriz_seq.c"
      }

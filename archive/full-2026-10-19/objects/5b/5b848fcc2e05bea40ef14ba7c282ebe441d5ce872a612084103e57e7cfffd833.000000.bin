"""ROOT-only final cold metadata reception of three exact zero-call timeouts.

No received code, native/observer operation, transport, model, cache/lock byte read.
Actual inputs are mandatory; no missing future pin can produce a positive receipt.
"""
from __future__ import annotations
import argparse
import ast
import hashlib
import io
import json
import math
import os
import re
import stat
import tarfile
import time
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
OP, PREP = HERE.parent, HERE.parent.parent
BASE = PREP.parents[1]
RAW_SOURCE = PREP / "qualification-allouee-source110-G-recu-r1/revue-resultats-Q753709-r1/lecteur-r4b/auditer-restauration-existante-r4b.py"
RAW_SHA = "5c1e1784574566a585e2d9cc50f85b52337d10d3109e449a4112581eae68f8d5"
CAPACITY = OP / "capacite-preracines-r1/verifier-capacite-preracines.py"
CAPACITY_SHA = "581403d134951fbde8c7b815c9d2c6d3281b09c3c847dc62386d7ea62be8d107"
INSPECTOR = HERE / "inventorier-archive-zero-appel-r2.py"
INSPECTOR_SHA = "2e18f95da5c7cf6a64c84270fb0d941306b1aa5429451b04fedf0961d22f1930"
SOURCE = "eaff9217499fe268e4d151165a368a83bad1550d921955a9f9256026cfac2d48"
PLAN = "d08ac00bcfb75625a24971b2684d7479c4da7a98b339e4e10eae5b9ac525ef27"
CHAIN = PREP / "adaptateurs-source110-r1/revision-r5-G-recu-avant-Q"
CELLS = {
    "754295": ("sol-max", "gpt-6.1-sol", "3b1de5658e4641149b15a3bea4850239"),
    "754296": ("astra-max", "gpt-6-astra", "7b6c29c0e329400bb2be145b0e2dbe0a"),
    "754299": ("terra-max", "gpt-5.6-terra", "bd2b3153a7544c909afbc19fe69902b4"),
}


def need(ok, message):
    if not ok:
        raise ValueError(message)


def digest(value):
    return hashlib.sha256(value).hexdigest()


def unwrap(value):
    if "tool_result" in value:
        value = value["tool_result"]
    need(isinstance(value, dict) and value.get("isError", False) is False, "Successful actual tool metadata required")
    if "structuredContent" in value:
        texts = [item.get("text") for item in value.get("content", []) if item.get("type") == "text"]
        need(len(texts) == 1 and json.loads(texts[0]) == value["structuredContent"], "Actual text and structured tool metadata disagree")
    return value.get("structuredContent", value)


def terminal_state(value, job, expected_state="FAILED", expected_exit="1:0"):
    """Only actual job-bound structured state/exit fields; no human-text guessing."""
    found = []
    def visit(item, inherited=None):
        if isinstance(item, dict):
            selected = str(item.get("job_id", item.get("JobID", inherited)))
            state = item.get("state", item.get("State", item.get("job_state")))
            exit_code = item.get("exit_code", item.get("ExitCode"))
            if selected == job and state is not None and exit_code is not None:
                found.append((state, exit_code))
            for child in item.values():
                visit(child, selected)
        elif isinstance(item, list):
            for child in item:
                visit(child, inherited)
    visit(unwrap(value["status"] if "status" in value else value))
    need(found and set(found) == {(expected_state, expected_exit)}, "Actual exact FAILED1:0 terminal fields required; unsupported metadata remains refused")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--input", type=Path, required=True)
    parser.add_argument("--input-sha256", required=True)
    parser.add_argument("--output-directory", type=Path, required=True)
    args = parser.parse_args()
    code = RAW_SOURCE.read_bytes()
    need(digest(code) == RAW_SHA, "Exact held-read primitives required")
    names = {"need", "ordinary", "metadata", "open_nofollow_read", "cross_identity", "validate_windows_mode_views", "native_basic_info", "raw", "decode"}
    nodes = [n for n in ast.parse(code).body if isinstance(n, ast.FunctionDef) and n.name in names]
    need({n.name for n in nodes} == names, "Closed held-read set required")
    held = {"Path": Path, "os": os, "stat": stat, "Q": BASE, "json": json}
    exec(compile(ast.Module(body=nodes, type_ignores=[]), str(RAW_SOURCE), "exec"), held)
    raw, decode, pins = held["raw"], held["decode"], {}
    def ref(path, checksum=None):
        path = Path(path)
        checksum_actual = digest(raw(path))
        need(checksum is None or checksum == checksum_actual, "Changed actual cold evidence")
        pins[str(path)] = checksum_actual
        return {"path": str(path), "sha256": checksum_actual}
    def read(reference):
        need(isinstance(reference, dict) and set(reference) == {"path", "sha256"}
             and re.fullmatch(r"[0-9a-f]{64}", reference["sha256"]), "Closed actual SHA reference required")
        ref(reference["path"], reference["sha256"])
        value = raw(reference["path"])
        need(digest(value) == reference["sha256"], "Actual JSON changed between reads")
        result = decode(value)
        need(isinstance(result, dict), "Metadata object required")
        return result
    need(args.input.is_absolute() and args.input.is_relative_to(HERE), "Only newly received metadata bundle below this receiver")
    bundle_ref = ref(args.input, args.input_sha256)
    bundle = read(bundle_ref)
    need(set(bundle) == {"schema", "hash_announcement", "hash_announcement_job_terminal", "fresh_full_cim", "cells"}
         and bundle["schema"] == "hpc-forest-source110-zero-call-reception-input-v1", "Actual closed receipt bundle required")
    ref(INSPECTOR, INSPECTOR_SHA)
    capacity_bytes = raw(CAPACITY)
    need(digest(capacity_bytes) == CAPACITY_SHA, "Reviewed pure zero-worker classifier changed")
    capacity_names = {"need", "metadata", "timestamp_z", "complete_cim", "native_definitions", "classify_zero", "ordinary_absence", "digest"}
    capacity_nodes = [n for n in ast.parse(capacity_bytes).body if isinstance(n, ast.FunctionDef) and n.name in capacity_names]
    need({n.name for n in capacity_nodes} == capacity_names, "Closed pure capacity API required")
    observer = CHAIN / "observer/observer-mixte.py"
    detector = CHAIN / "launcher/native_worker_detection.py"
    observer_sha = "db24bef9282b510642dbc23d527c32f1a5515df9791d255f920d7e326db32180"
    detector_sha = "07fb437746064f20d0be33fcef748d1f9b0f0028214f02a042540d97e4c51766"
    namespace = {"Path": Path, "stat": stat, "time": time, "re": re, "math": math, "ast": ast, "datetime": datetime,
                 "UTC": UTC, "hashlib": hashlib, "OBSERVER": observer, "DETECTOR": detector,
                 "OBSERVER_SHA": observer_sha, "DETECTOR_SHA": detector_sha,
                 "FIELDS": ("ProcessId", "ParentProcessId", "ExecutablePath", "CommandLine", "CreationDate"),
                 "LOCAL_CACHES": [PREP / ("lancement-modeles-max-r3/worker-" + session) for _, _, session in CELLS.values()]}
    exec(compile(ast.Module(body=capacity_nodes, type_ignores=[]), str(CAPACITY), "exec"), namespace)
    ref(observer, observer_sha); ref(detector, detector_sha)
    census = read(bundle["fresh_full_cim"])
    rows = namespace["complete_cim"](census, time.time())
    namespace["classify_zero"](rows, namespace["native_definitions"](raw(observer), raw(detector)))
    local_absence = [namespace["ordinary_absence"](p) for p in namespace["LOCAL_CACHES"]]
    announcement = read(bundle["hash_announcement"])
    need(announcement.get("schema") == "hpc-forest-r4b-original-zero-call-archives-hash-announcement-v1"
         and announcement.get("verified_readonly_hashes") is True and announcement.get("native_model_calls") == 0
         and announcement.get("tests_replayed") == 0 and announcement.get("archives_modified") is False
         and str(announcement.get("allocation_job_id")) == "754337"
         and type(announcement.get("observed_at")) in (int, float) and math.isfinite(announcement["observed_at"])
         and 0 < announcement["observed_at"] <= time.time(), "Actual separate delivery-only archive announcement required")
    terminal_state(read(bundle["hash_announcement_job_terminal"]), "754337", "COMPLETED", "0:0")  # Actual separate hash delivery job only; no repoll.
    original_announcement_receipt = read(bundle["hash_announcement_job_terminal"])
    need(str(original_announcement_receipt.get("job_id")) == "754337" and "log" in original_announcement_receipt,
         "Actual original hash announcement job/log receipt required")
    original_log = unwrap(original_announcement_receipt["log"])
    need(str(original_log.get("job_id")) == "754337" and original_log.get("ok") is True,
         "Actual hash-only allocation log required")
    matching_announcement_lines = []
    def scan(value):
        if isinstance(value, dict):
            for child in value.values():
                scan(child)
        elif isinstance(value, list):
            for child in value:
                scan(child)
        elif isinstance(value, str):
            for line in value.splitlines():
                try:
                    decoded = json.loads(line)
                except (ValueError, TypeError):
                    continue
                if decoded == announcement:
                    matching_announcement_lines.append(line)
    scan(original_log)
    need(len(matching_announcement_lines) == 1, "Parsed archive announcement must equal exactly one original allocation-log JSON line")
    announced = announcement.get("records")
    need(isinstance(announced, list) and len(announced) == 3 and {row.get("job_id") for row in announced} == set(CELLS), "Three exact existing archives required")
    records = bundle["cells"]
    need(isinstance(records, list) and len(records) == 3 and {row.get("job_id") for row in records} == set(CELLS), "Three exact current terminal jobs required")
    prepared = []
    for supplied in records:
        need(set(supplied) == {"job_id", "archive", "archive_inventory", "download_receipt", "terminal_status", "terminal_log", "efficiency", "transfer_sidecars"}, "Closed exact zero-call cell evidence set required")
        job = supplied["job_id"]; slug, model, session = CELLS[job]
        archive_ref = supplied["archive"]; ref(archive_ref["path"], archive_ref["sha256"])
        archive_bytes = raw(archive_ref["path"])
        announcement_row = next(row for row in announced if row["job_id"] == job)
        expected_remote = "/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-" + session + "/contract-results-" + job + ".tar.gz"
        need(announcement_row.get("path") in {expected_remote, expected_remote.replace("/scratch_p/", "/gpfs/scratch/", 1)}
             and announcement_row.get("sha256") == archive_ref["sha256"] and announcement_row.get("bytes") == len(archive_bytes)
             and announcement_row.get("original_bytes_unchanged") is True
             and announcement_row.get("model") == model and announcement_row.get("session_id") == session, "Real stable existing archive announcement differs")
        download = unwrap(read(supplied["download_receipt"]))
        need(download.get("ok") is True and download.get("verifie") is True and download.get("transport") == "scp"
             and Path(download.get("to", "")).is_absolute() and ".." not in Path(download.get("to", "")).parts
             and Path(download["to"]) == Path(archive_ref["path"]) and download.get("downloaded") in {expected_remote, expected_remote.replace("/scratch_p/", "/gpfs/scratch/", 1)}
             and download.get("bytes") == len(archive_bytes)
             and all(download.get(k) == archive_ref["sha256"] for k in ("remote_sha256", "empreinte_locale", "empreinte_distante")), "Announced/distant/local archive SHAs are not all actually equal")
        terminal_state(read(supplied["terminal_status"]), job)
        read(supplied["terminal_log"])  # Preserve real terminal logs, never execute their content.
        efficiency = unwrap(read(supplied["efficiency"]))
        need(efficiency.get("ok") is True and efficiency.get("found") is True
             and str(efficiency.get("job_id")) == job and efficiency.get("state") == "FAILED"
             and efficiency.get("exit_code") == "1:0" and efficiency.get("alloc_cpus") == 4
             and efficiency.get("alloc_gpus") == 0 and efficiency.get("req_mem_mb") == 16384,
             "Actual job-bound FAILED1:0 efficiency and allocation facts required")
        facts = read(supplied["archive_inventory"])
        need(facts.get("schema") == "hpc-forest-source110-zero-call-cold-archive-inventory-v1"
             and facts.get("verified_archive_metadata_only") is True and facts.get("archive") == archive_ref
             and facts.get("job_id") == job and facts.get("model") == model and facts.get("session_id") == session
             and facts.get("source_zip_sha256") == SOURCE and facts.get("plan_sha256") == PLAN
             and facts.get("regular_files") == 5 and facts.get("archive_bytes_before_after_identical") is True
             and facts.get("zero_call_timeout_control_flow_matched") is True
             and facts.get("inventory_before") == facts.get("inventory_after"), "Actual cold five-file timeout inventory required")
        # Rehash the actual received archive, not only the inspector's report.
        measured, restored_bytes, directory_names = {}, {}, set()
        safe_files = {"target-profile.json", "request-prepared.json", "mailbox/OWNER.json", "private-technical-error.json", "contract-source-result.json"}
        prefix = "results-" + job
        safe_directories = {prefix, prefix + "/mailbox", prefix + "/mailbox/requests", prefix + "/mailbox/responses", prefix + "/mailbox/logs"}
        with tarfile.open(fileobj=io.BytesIO(archive_bytes), mode="r:gz") as archive:
            for member in archive:
                if member.isdir():
                    name = member.name.rstrip("/")
                    need(name in safe_directories and name not in directory_names and member.size == 0, "Unknown/duplicate/nonempty result directory")
                    directory_names.add(name)
                    continue
                need(member.isreg() and not member.islnk() and not member.issym() and not member.issparse()
                     and 0 <= member.size <= 8 * 1024 * 1024 and member.name.startswith("results-" + job + "/"), "Unknown/special archive member at rehash")
                name = member.name[len("results-" + job + "/"):]
                need(name in safe_files and name not in measured and len(measured) < 5, "Duplicate/unknown/extra archive file")
                stream = archive.extractfile(member)
                with stream:
                    value = stream.read(member.size + 1)
                need(len(value) == member.size, "Archive member size differs")
                measured[name] = {"bytes": len(value), "sha256": digest(value)}
                restored_bytes[name] = value
        need(measured == facts["inventory_before"] and set(restored_bytes) == safe_files and directory_names == safe_directories, "Actual complete archive inventory differs from received cold audit")
        need(isinstance(supplied["transfer_sidecars"], list), "Explicit transfer sidecar inventory required")
        for sidecar in supplied["transfer_sidecars"]:
            ref(sidecar["path"], sidecar["sha256"])
        receipt = {"schema": "hpc-forest-source110-zero-call-technical-terminal-metadata-v1", "verified_metadata_only": True,
            "scope_id": "hpc-forest-dynamic-independent-roots-r4b-max", "source_zip_sha256": SOURCE, "plan_sha256": PLAN,
            "model": model, "effort": "max", "phase": "roots", "session_id": session, "job_id": job,
            "terminal_state": "FAILED", "exit_code": "1:0", "failure_class": "authorization-wait-expired-before-request-publication",
            "requests_prepared": 1, "requests_published": 0, "native_invocation_count": 0, "native_model_calls": 0,
            "native_calls_replayed": 0, "response_count": 0, "delivered_count": 0, "unknown_invocations": 0, "unresolved_invocations": [],
            "all_started_calls_reconciled": True, "archive_transport_three_SHA_verified": True,
            "inventory_before": measured, "inventory_after": measured, "cold_archive_inventory_unchanged": True,
            "target_profile_scope": "Actual original job allocation and two received neutral probes only; not a future allocation profile",
            "normal_native_delivery_verified": False, "closed_schema_verified": False, "native_contract_admission_verified": False,
            "native_research_admitted": False, "scientific_or_performance_admission": False, "method_R5_admitted": False,
            "input_evidence": supplied, "hash_announcement": bundle["hash_announcement"], "fresh_worker_zero_census": bundle["fresh_full_cim"],
            "observer_route_terminal_admitted": False, "limits": "Received zero-call metadata only. No one-call negative substitution, no model replay, no worker stop, no OBS4 lifecycle/admission relaxation."}
        prepared.append((receipt, restored_bytes))
    for path, checksum in pins.items():
        need(digest(raw(path)) == checksum, "Received evidence changed during final reconciliation")
    namespace["complete_cim"](census, time.time())
    output = held["ordinary"](args.output_directory)
    need(output.parent == HERE and not output.exists(), "New direct receiver output only")
    output.mkdir()
    final_refs = []
    restored_total = 0
    for value, restored_bytes in prepared:
        destination = output / ("restauration-neuve-" + value["job_id"]) / ("results-" + value["job_id"])
        destination.mkdir(parents=True, exist_ok=False)
        for directory in ("mailbox", "mailbox/requests", "mailbox/responses", "mailbox/logs"):
            (destination / directory).mkdir(exist_ok=False)
        measured_copy = {}
        for name, data in restored_bytes.items():
            copy_path = destination / name  # Only the five closed literal paths above.
            with copy_path.open("xb") as stream:
                stream.write(data); stream.flush(); os.fsync(stream.fileno())
            copied = raw(copy_path)
            need(copied == data, "New regular restoration is not byte-identical")
            measured_copy[name] = {"bytes": len(copied), "sha256": digest(copied)}
            restored_total += 1
        need(measured_copy == value["inventory_before"], "Complete five-file restoration differs")
        value["restoration_root"] = str(destination)
        value["inventory_after"] = measured_copy
        value["restored_regular_files"] = 5
        value["restoration_is_new_no_archive_extractall_or_received_code_execution"] = True
        path = output / ("RECEPTION-ZERO-APPEL-" + value["job_id"] + ".json")
        with path.open("x", encoding="utf-8", newline="\n") as stream:
            json.dump(value, stream, ensure_ascii=False, indent=2); stream.write("\n")
        final_refs.append(ref(path))
    need(restored_total == 15, "Exactly fifteen newly restored regular files required")
    for path, checksum in pins.items():
        need(digest(raw(path)) == checksum, "Original received evidence changed during restoration")
    namespace["complete_cim"](census, time.time())
    summary = {"schema": "hpc-forest-source110-three-zero-call-technical-reconciliation-v1", "verified_metadata_only": True,
        "source_zip_sha256": SOURCE, "plan_sha256": PLAN, "job_ids": list(CELLS), "all_three_terminal_received": True,
        "restored_regular_files": 15, "original_archives_and_received_evidence_unchanged": True, "prepared_requests": 3, "published_requests": 0, "native_invocations": 0, "native_model_calls": 0,
        "responses": 0, "deliveries": 0, "unknown_invocations": 0, "unresolved_invocations": [], "all_started_calls_reconciled": True,
        "fresh_full_cim": bundle["fresh_full_cim"], "active_native_workers_at_observation": 0, "local_worker_caches_absent": local_absence,
        "observer_and_foreign_processes_preserved": True, "root_input": bundle_ref, "receipts": final_refs,
        "observed_at_utc": datetime.now(UTC).isoformat(), "current_state_after_observation_promised": False,
        "source110_native_or_normal_science_performance_method_R5_or_OBS4_terminal_admission": False,
        "receiver": ref(Path(__file__)), "archive_inspector": ref(INSPECTOR, INSPECTOR_SHA),
        "effects": "New local cold metadata receipts only; no received/source module/main, probe/test/compiler/model/CLI/MCP/transport/CIM capture/cache-lock read/start-stop operation"}
    path = output / "RECONCILIATION-TROIS-ROOTS-ZERO-APPEL.json"
    with path.open("x", encoding="utf-8", newline="\n") as stream:
        json.dump(summary, stream, ensure_ascii=False, indent=2); stream.write("\n")
    print(json.dumps(ref(path)))


if __name__ == "__main__":
    main()

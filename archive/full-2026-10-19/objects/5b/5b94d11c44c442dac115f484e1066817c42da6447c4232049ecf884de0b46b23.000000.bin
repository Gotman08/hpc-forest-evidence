#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include <omp.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

typedef struct { float x, y, z, vx, vy, vz; } Body;

void body_force(Body * restrict p, float dt, int n) {
  #pragma omp parallel for schedule(static)
  for (int i = 0; i < n; ++i) {
    const float xi = p[i].x;
    const float yi = p[i].y;
    const float zi = p[i].z;
    float fx = 0.0f;
    float fy = 0.0f;
    float fz = 0.0f;

    int j = 0;
    // Unroll inner loop by 8, preserving strict ascending accumulation order.
    for (; j + 7 < n; j += 8) {
      float dx = p[j].x - xi;
      float dy = p[j].y - yi;
      float dz = p[j].z - zi;
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1.0f / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;
      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;

      dx = p[j+1].x - xi;
      dy = p[j+1].y - yi;
      dz = p[j+1].z - zi;
      sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      inv_dist = 1.0f / sqrt(sqrd_dist);
      inv_dist3 = inv_dist * inv_dist * inv_dist;
      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;

      dx = p[j+2].x - xi;
      dy = p[j+2].y - yi;
      dz = p[j+2].z - zi;
      sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      inv_dist = 1.0f / sqrt(sqrd_dist);
      inv_dist3 = inv_dist * inv_dist * inv_dist;
      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;

      dx = p[j+3].x - xi;
      dy = p[j+3].y - yi;
      dz = p[j+3].z - zi;
      sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      inv_dist = 1.0f / sqrt(sqrd_dist);
      inv_dist3 = inv_dist * inv_dist * inv_dist;
      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;

      dx = p[j+4].x - xi;
      dy = p[j+4].y - yi;
      dz = p[j+4].z - zi;
      sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      inv_dist = 1.0f / sqrt(sqrd_dist);
      inv_dist3 = inv_dist * inv_dist * inv_dist;
      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;

      dx = p[j+5].x - xi;
      dy = p[j+5].y - yi;
      dz = p[j+5].z - zi;
      sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      inv_dist = 1.0f / sqrt(sqrd_dist);
      inv_dist3 = inv_dist * inv_dist * inv_dist;
      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;

      dx = p[j+6].x - xi;
      dy = p[j+6].y - yi;
      dz = p[j+6].z - zi;
      sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      inv_dist = 1.0f / sqrt(sqrd_dist);
      inv_dist3 = inv_dist * inv_dist * inv_dist;
      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;

      dx = p[j+7].x - xi;
      dy = p[j+7].y - yi;
      dz = p[j+7].z - zi;
      sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      inv_dist = 1.0f / sqrt(sqrd_dist);
      inv_dist3 = inv_dist * inv_dist * inv_dist;
      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    for (; j < n; ++j) {
      float dx = p[j].x - xi;
      float dy = p[j].y - yi;
      float dz = p[j].z - zi;
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1.0f / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;
      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    p[i].vx += dt*fx;
    p[i].vy += dt*fy;
    p[i].vz += dt*fz;
  }
}

Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  return bodies;
}

void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc,char **argv) {
  int nbodies;

  Body *bodies = read_dataset(&nbodies);

  for (int iter = 0; iter < N_ITER; iter++) {
    body_force(bodies, DT, nbodies);

    #pragma omp parallel for schedule(static)
    for (int i = 0; i < nbodies; i++) {
      bodies[i].x += bodies[i].vx * DT;
      bodies[i].y += bodies[i].vy * DT;
      bodies[i].z += bodies[i].vz * DT;
    }
  }

  write_dataset(nbodies, bodies);

  free(bodies);
  
  exit(EXIT_SUCCESS);
}

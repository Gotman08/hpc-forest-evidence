    "content": "{\"files\":[{\"content\":\"#include <cstdio>\\n#include <memory>\\n#include <vector>\\n\\nclass FastScanner {\\n    static constexpr int BUFSIZE = 1 << 20;\\n    char buf[BUFSIZE];\\n    char* cur;\\n    char* end;\\n\\n    bool refill() {\\n        size_t r = fread(buf, 1, BUFSIZE, stdin);\\n        cur = buf;\\n        end = buf + r;\\n        return r > 0;\\n    }\\n\\npublic:\\n    FastScanner() : cur(buf), end(buf) {}\\n\\n    inline int nextInt() {\\n        while (true) {\\n            if (cur == end && !refill()) return 0;\\n            char c = *cur++;\\n            if (c <= ' ') continue;\\n\\n            int sign = 1;\\n            if (c == '-') {\\n                sign = -1;\\n                if (cur == end && !refill()) return 0;\\n                c = *cur++;\\n            }\\n\\n            int x = c - '0';\\n            while (true) {\\n                if (cur == end && !refill()) break;\\n                char d = *cur++;\\n                if (d < '0' || d > '9') break;\\n                x = x * 10 + (d - '0');\\n            }\\n            return sign * x;\\n        }\\n    }\\n};\\n\\nint main() {\\n    FastScanner fs;\\n    int n = fs.nextInt();\\n    int s = fs.nextInt();\\n\\n    const size_t ringSize = (size_t)s + 1;\\n    std::unique_ptr<int[]> storage(new int[ringSize * (size_t)n]);\\n    int* __restrict ring = storage.get();\\n\\n    std::vector<long long> col(n, 0);\\n    long long* __restrict c = col.data();\\n\\n    for (int r = 0; r < s; ++r) {\\n        int* row = ring + (size_t)r * n;\\n        for (int j = 0; j < n; ++j) {\\n            int v = fs.nextInt();\\n            row[j] = v;\\n            c[j] += v;\\n        }\\n    }\\n\\n    long long cur = 0;\\n    for (int j = 0; j < s; ++j) cur += c[j];\\n    long long best = cur;\\n\\n    const int limit = n - s;\\n    for (int j = 1; j <= limit; ++j) {\\n        cur += c[j + s - 1] - c[j - 1];\\n        if (cur > best) best = cur;\\n    }\\n\\n    int* po = ring;\\n    int* pi = ring + (size_t)s * n;\\n    const int* endRing = ring + ringSize * (size_t)n;\\n\\n    for (int i = 1; i <= limit; ++i) {\\n        int j = 0;\\n        for (; j + 3 < n; j += 4) {\\n            int v0 = fs.nextInt();\\n            int v1 = fs.nextInt();\\n            int v2 = fs.nextInt();\\n            int v3 = fs.nextInt();\\n\\n            pi[j] = v0;\\n            c[j] += (long long)v0 - po[j];\\n            pi[j+1] = v1;\\n            c[j+1] += (long long)v1 - po[j+1];\\n            pi[j+2] = v2;\\n            c[j+2] += (long long)v2 - po[j+2];\\n            pi[j+3] = v3;\\n            c[j+3] += (long long)v3 - po[j+3];\\n        }\\n        for (; j < n; ++j) {\\n            int v = fs.nextInt();\\n            pi[j] = v;\\n            c[j] += (long long)v - po[j];\\n        }\\n\\n        cur = 0;\\n        for (int k = 0; k < s; ++k) cur += c[k];\\n        if (cur > best) best = cur;\\n\\n        for (int jj = 1; jj <= limit; ++jj) {\\n            cur += c[jj + s - 1] - c[jj - 1];\\n            if (cur > best) best = cur;\\n        }\\n\\n        po += n;\\n        if (po == endRing) po = ring;\\n        pi += n;\\n        if (pi == endRing) pi = ring;\\n    }\\n\\n    std::printf(\\\"%lld\\\\n\\\", (long long)best);\\n    return 0;\\n}\\n\",\"path\":\"src/solution.cpp\"}],\"hypothesis\":\"The streaming ring-buffer approach already avoids storing the full matrix; replacing modulo-based slot arithmetic with increment-and-wrap row pointers, unrolling the read/update loop by four, and using a direct buffer-cursor scanner reduce per-row overhead and improve memory locality on the 4-core ARM target.\",\"notes\":\"Kept the O(N^2) vertical column-sum sliding window and ring-buffer data layout from the parent. Only source-level micro-optimizations were applied: faster integer parsing, pointer-based ring slot advancement instead of runtime modulo/division, and a 4x unrolled input+column-update loop to expose ILP while preserving sequential row-major access.
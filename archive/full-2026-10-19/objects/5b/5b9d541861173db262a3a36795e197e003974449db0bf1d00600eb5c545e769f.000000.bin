}\n    }\n};\n\nint main() {\n    FastScanner fs;\n    int n = fs.nextInt();\n    int s = fs.nextInt();\n\n    const size_t ringSize = (size_t)s + 1;\n    std::unique_ptr<int[]> storage(new int[ringSize * (size_t)n]);\n    int* __restrict ring = storage.get();\n\n    std::vector<long long> col(n, 0);\n    long long* __restrict c = col.data();\n\n    for (int r = 0; r < s; ++r) {\n        int* row = ring + (size_t)r * n;\n        for (int j = 0; j < n; ++j) {\n            int v = fs.nextInt();\n            row[j] = v;\n            c[j] += v;\n        }\n    }\n\n    long long cur = 0;\n    for (int j = 0; j < s; ++j) cur += c[j];\n    long long best = cur;\n\n    const int limit = n - s;\n    for (int j = 1; j <= limit; ++j) {\n        cur += c[j + s - 1] - c[j - 1];\n        if (cur > best) best = cur;\n    }\n\n    size_t outSlot = 0;\n    size_t inSlot = (size_t)s % ringSize;\n\n    for (int i = 1; i <= limit; ++i) {\n        int* po = ring + outSlot * (size_t)n;\n        int* pi = ring + inSlot * (size_t)n;\n\n        int j = 0;\n        for (; j + 3 < n; j += 4) {\n            int v0 = fs.nextInt();\n            int v1 = fs.nextInt();\n            int v2 = fs.nextInt();\n            int v3 = fs.nextInt();\n\n            pi[j] = v0;\n            c[j] += (long long)v0 - po[j];\n            pi[j+1] = v1;\n            c[j+1] += (long long)v1 - po[j+1];\n            pi[j+2] = v2;\n            c[j+2] += (long long)v2 - po[j+2];\n            pi[j+3] = v3;\n            c[j+3] += (long long)v3 - po[j+3];\n        }\n        for (; j < n; ++j) {\n            int v = fs.nextInt();\n            pi[j] = v;\n            c[j] += (long long)v - po[j];\n        }\n\n        cur = 0;\n        for (int k = 0; k < s; ++k) cur += c[k];\n        if (cur > best) best = cur;\n\n        for (int jj = 1; jj <= limit; ++jj) {\n            cur += c[jj + s - 1] - c[jj - 1];\n            if (cur > best) best = cur;\n        }\n\n        if (++outSlot == ringSize) outSlot = 0;\n        if (++
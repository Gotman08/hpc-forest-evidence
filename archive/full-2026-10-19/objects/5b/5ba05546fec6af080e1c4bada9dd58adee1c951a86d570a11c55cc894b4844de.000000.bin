#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <cstddef>
#include <limits>

#ifdef _OPENMP
#include <omp.h>
#endif

static long long band_maximum(const int* matrix, int n, int s,
                              int first, int last) {
    long long best = std::numeric_limits<long long>::min();
    if (first >= last) return best;

    std::vector<long long> columns(n, 0);
    for (int row = first; row < first + s; ++row) {
        const int* values = matrix + static_cast<std::size_t>(row) * n;
        for (int col = 0; col < n; ++col) {
            columns[col] += values[col];
        }
    }

    for (int row = first; row < last; ++row) {
        long long sum = 0;
        for (int col = 0; col < s; ++col) {
            sum += columns[col];
        }
        if (sum > best) best = sum;

        for (int col = s; col < n; ++col) {
            sum += columns[col] - columns[col - s];
            if (sum > best) best = sum;
        }

        if (row + 1 < last) {
            const int* outgoing = matrix + static_cast<std::size_t>(row) * n;
            const int* incoming = matrix + static_cast<std::size_t>(row + s) * n;
            for (int col = 0; col < n; ++col) {
                columns[col] += static_cast<long long>(incoming[col])
                              - static_cast<long long>(outgoing[col]);
            }
        }
    }
    return best;
}

int main() {
    int n, s;
    if (!(std::cin >> n >> s)) return 0;

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    std::vector<int> matrix(static_cast<std::size_t>(n) * n);
    for (int row = 0; row < n; ++row) {
        for (int col = 0; col < n; ++col) {
            if (scanf("%d", &matrix[static_cast<std::size_t>(row) * n + col]) != 1)
                return 0;
        }
    }

    const int starts = n - s + 1;
    long long maximum = std::numeric_limits<long long>::min();

#ifdef _OPENMP
    int available = omp_get_max_threads();
    if (available > 4) available = 4;
    int workers = 1;
    const std::size_t scan_cells = static_cast<std::size_t>(n) * starts;
    const std::size_t minimum_cells_per_worker = 262144;

    for (int candidate = 2; candidate <= available; candidate *= 2) {
        if (candidate > starts) break;
        if (scan_cells / candidate < minimum_cells_per_worker) break;
        // Bound duplicated initialization against the two rolling passes.
        if (static_cast<long long>(candidate - 1) * s > 2LL * (starts - 1))
            break;
        workers = candidate;
    }

    if (workers > 1) {
        #pragma omp parallel num_threads(workers) reduction(max:maximum)
        {
            // Partition using the actual team size, including dynamic teams.
            const int thread = omp_get_thread_num();
            const int team = omp_get_num_threads();
            const int first = starts * thread / team;
            const int last = starts * (thread + 1) / team;
            maximum = band_maximum(matrix.data(), n, s, first, last);
        }
    } else
#endif
    {
        maximum = band_maximum(matrix.data(), n, s, 0, starts);
    }

    printf("%lld\n", maximum);
    return 0;
}

        "content": "/*\n  Quicksort\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <limits.h>\n#include <openssl/md5.h>\n\n#define MY_RAND_MAX 0x7FFFFFFF\n#define RANDNUM_W 521288629\n#define RANDNUM_Z 362436069\n#define SORT_TASK_CUTOFF 16384\n#define SORT_PARALLEL_CUTOFF (4 * SORT_TASK_CUTOFF)\n\n/*\n * Prototypes\n */\nvoid srandnum(int seed);\ndouble randnum(void);\nint *generate_case(int N);\ndouble drand(int xmin, int xmax);\nvoid swap(int *toorder, int i, int j);\nvoid _quicksort(int *toorder, int lo, int hi);\nvoid quicksort(int *toorder, int N);\nint is_sorted(int *toorder, int N);\nstatic int sort_depth_limit(int count);\nstatic void quicksort_impl(int *toorder, int lo, int hi, int depth, int use_tasks);\n\nunsigned int randum_w = RANDNUM_W;\nunsigned int randum_z = RANDNUM_Z;\n\nvoid srandnum(int seed)\n{\n    unsigned int w, z;\n    w = (seed * 104623) & 0xffffffff;\n    randum_w = (w) ? w : RANDNUM_W;\n    z = (seed * 48947) & 0xffffffff;\n    randum_z = (z) ? z : RANDNUM_Z;\n}\n\ndouble randnum(void)\n{\n    unsigned int u;\n    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);\n    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);\n    u = (randum_z << 16) + randum_w;\n    return (abs(u));\n}\n\n/*\n * Main function\n */\nint main(int argc, char *argv[])\n{\n    int N = 0;\n    int *our_list = NULL;\n\n    //The input provides the case size\n    scanf(\"%d\", &N);\n    if (N <= 0) {\n        printf(\"Error: please, provide the case size.\\n\");\n        return 1;\n    }\n\n    //Generate the case\n    our_list = generate_case(N);\n    if (our_list == NULL) {\n        printf(\"Error: case instantiation failed.\\n\");\n        return 1;\n    }\n\n    //Do the thing\n    quicksort(our_list, N);\n\n    if (is_sorted(our_list, N) == 1) {\n        printf(\"Error, for some reason list is still unsorted.\\n\");\n        return 1;\n    }\n\n#ifdef COMPUTE_MD5_PROBLEM\n    //Compute MD5 Checksum for problem identification\n    MD5_CTX c;\n    unsigned char out[MD5_DIGEST_LENGTH];\n    MD5_Init(&c);\n    MD5_Update(&c, our_list, N * sizeof(int));\n    MD5_Final(out, &c);\n    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {\n        printf(\"%02x\", out[n]);\n    }\n#endif\n    printf(\"\\n\");\n\n    //Clean up\n    free(our_list);\n\n    return 0;\n}\n\n/*\n * Public API\n */\nvoid quicksort(int *toorder, int N)\n{\n    if (N <= 1)\n        return;\n\n    if (N < SORT_PARALLEL_CUTOFF) {\n        _quicksort(toorder, 0, N - 1);\n        return;\n    }\n\n    int depth = sort_depth_limit(N);\n#pragma omp parallel\n    {\n#pragma omp single\n        quicksort_impl(toorder, 0, N - 1, depth, 1);\n    }\n}\n\n/*\n * Internal serial entry point, retained for callers of the original helper.\n */\nvoid _quicksort(int *toorder, int lo, int hi)\n{\n    if (lo >= hi)\n        return;\n    quicksort_impl(toorder, lo, hi, sort_depth_limit(hi - lo + 1), 0);\n}\n\nstatic int sort_depth_limit(int count)\n{\n    int depth = 0;\n    while (count > 1) {\n        depth += 2;\n        count >>= 1;\n    }\n    return depth;\n}\n\n/*\n * Swap two values.\n */\nvoid swap(int *toorder, int i, int j)\n{\n    int temp = toorder[i];\n    toorder[i] = toorder[j];\n    toorder[j] = temp;\n}\n\nstatic int median_of_three(int a, int b, int c)\n{\n    if (a < b)\n        return (b < c) ? b : ((a < c) ? c : a);\n    return (a < c) ? a : ((b < c) ? c : b);\n}\n\nstatic void partition_three_way(int *toorder, int lo, int hi, int *equal_lo, int *equal_hi)\n{\n    int mid = lo + (hi - lo) / 2;\n    int pivot = median_of_three(toorder[lo], toorder[mid], toorder[hi]);\n    int lt = lo;\n    int i = lo;\n    int gt = hi;\n\n    /* Scan contiguous ranges once; equal values need no recursive work. */\n    while (i <= gt) {\n        if (toorder[i] < pivot) {\n            swap(toorder, i, lt);\n            ++i;\n            ++lt;\n        } else if (toorder[i] > pivot) {\n            swap(toorder, i, gt);\n            --gt;\n        } else {\n            ++i;\n        }\n    }\n\n    *equal_lo = lt;\n    *equal_hi = gt;\n}\n\nstatic void sift_down(int *toorder, int lo, int root, int count)\n{\n    while (root <= (count - 2) / 2) {\n        int child = root * 2 + 1;\n        if (child + 1 < count && toorder[lo + child] < toorder[lo + child + 1])\n            ++child;\n        if (toorder[lo + root] >= toorder[lo + child])\n            return;\n        swap(toorder, lo + root, lo + child);\n        root = child;\n    }\n}\n\nstatic void heapsort_range(int *toorder, int lo, int hi)\n{\n    int count = hi - lo + 1;\n    if (count < 2)\n        return;\n\n    for (int start = (count - 2) / 2; start >= 0; --start)\n        sift_down(toorder, lo, start, count);\n    for (int end = count - 1; end > 0; --end) {\n        swap(toorder, lo, lo + end);\n        sift_down(toorder, lo, 0, end);\n    }\n}\n\nstatic void quicksort_impl(int *toorder, int lo, int hi, int depth, int use_tasks)\n{\n    if (lo >= hi)\n        return;\n    if (depth <= 0) {\n        heapsort_range(toorder, lo, hi);\n        return;\n    }\n\n    int equal_lo, equal_hi;\n    partition_three_way(toorder, lo, hi, &equal_lo, &equal_hi);\n    int next_depth = depth - 1;\n    int left_size = equal_lo - lo;\n    int right_size = hi - equal_hi;\n\n    if (use_tasks && hi - lo + 1 >= SORT_TASK_CUTOFF) {\n        if (left_size >= right_size && left_size >= SORT_TASK_CUTOFF) {\n#pragma omp task shared(toorder) firstprivate(lo, equal_lo, next_depth)\n            quicksort_impl(toorder, lo, equal_lo - 1, next_depth, 1);\n            quicksort_impl(toorder, equal_hi + 1, hi, next_depth, 1);\n#pragma omp taskwait\n        } else if (right_size >= SORT_TASK_CUTOFF) {\n#pragma omp task shared(toorder) firstprivate(equal_hi, hi, next_depth)\n            quicksort_impl(toorder, equal_hi + 1, hi, next_depth, 1);\n            quicksort_impl(toorder, lo, equal_lo - 1, next_depth, 1);\n#pragma omp taskwait\n        } else {\n            quicksort_impl(toorder, lo, equal_lo - 1, next_depth, 1);\n            quicksort_impl(toorder, equal_hi + 1, hi, next_depth, 1);\n        }\n    } else {\n        quicksort_impl(toorder, lo, equal_lo - 1, next_depth, use_tasks);\n        quicksort_impl(toorder, equal_hi + 1, hi, next_depth, use_tasks);\n    }\n}\n\n/*\n * Check if elements are in non-decreasing order\n */\nint is_sorted(int *toorder, int N)\n{\n    for (int i = 1; i < N; i++) {\n        if (toorder[i] < toorder[i - 1]) {\n            return 1;\n        }\n    }\n    return 0;\n}\n\n/*\n * Generate a case\n */\nint *generate_case(int N)\n{\n    int i;\n    int *ret = NULL;\n\n    // Make case generation reproducible\n    srandnum(0);\n\n    // Allocate memory\n    ret = (int *) malloc(N * sizeof(int));\n    if (ret == NULL) {\n        printf(\"Error: some malloc won't work.\\n\");\n        return NULL;\n    }\n    // Get pseudo-random positive integer values\n    for (i = 0; i < N; i++) {\n        ret[i] = drand(0, INT_MAX);\n    }\n    return ret;\n}\n\n/*\n * A pseudo-random number between two positive integer values\n */\ndouble drand(int xmin, int xmax)\n{\n    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;\n}\n",
        "path": "src/quicksort.c"
      }

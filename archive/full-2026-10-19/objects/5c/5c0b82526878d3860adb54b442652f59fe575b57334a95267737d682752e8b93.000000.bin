{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <algorithm>\\n#include <cstddef>\\n#include <iostream>\\n#include <vector>\\n#include <utility>\\n\\nusing namespace std;\\n\\ntypedef vector<vector<bool>> adjacency_matrix;\\n\\nadjacency_matrix readGraph();\\n\\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence);\\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, const int *equivalence);\\nbool verifyPermutationWithDegrees(adjacency_matrix &g1, adjacency_matrix &g2,\\n                                  const int *equivalence,\\n                                  const vector<int> &degree1,\\n                                  const vector<int> &degree2);\\ninline void printPermutation(vector<int> &equivalence);\\n\\nint main(){\\n    adjacency_matrix g1 = readGraph();\\n    adjacency_matrix g2 = readGraph();\\n\\n    if(!testIsomorphism(g1, g2))\\n        cout << \\\"The graphs are not isomorphic\\\" << endl;\\n\\n    return 0;\\n}\\n\\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\\n    if(g1.size() != g2.size()) return false;\\n\\n    vector<int> equivalence(g1.size(), 0);\\n    vector<int> exchange_counter(g1.size(), 0);\\n    int exchange_index = 1;\\n    bool isomorphism_found = false;\\n\\n    for(int i = 0; i < static_cast<int>(equivalence.size()); ++i)\\n        equivalence[i] = i;\\n\\n    if(verifyPermutation(g1, g2, equivalence)){\\n        printPermutation(equivalence);\\n        return true;\\n    }\\n\\n    // Keep the low-work cases serial to avoid parallel-region overhead.\\n    if(g1.size() < 9){\\n        while(exchange_index < static_cast<int>(g1.size())){\\n            if(exchange_counter[exchange_index] < exchange_index){\\n                if(exchange_index % 2 == 0)\\n                    swap(equivalence[0], equivalence[exchange_index]);\\n                else\\n                    swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\\n                if(verifyPermutation(g1, g2, equivalence)){\\n                    printPermutation(equivalence);\\n                    isomorphism_found = true;\\n                }\\n\\n                exchange_counter[exchange_index]++;\\n                exchange_index = 1;\\n            }else{\\n                exchange_counter[exchange_index] = 0;\\n                exchange_index++;\\n            }\\n        }\\n        return isomorphism_found;\\n    }\\n\\n    const int vertex_count = static_cast<int>(g1.size());\\n    vector<int> degree1(vertex_count, 0);\\n    vector<int> degree2(vertex_count, 0);\\n    for(int i = 0; i < vertex_count; ++i){\\n        for(int j = 0; j < vertex_count; ++j){\\n            degree1[i] += g1[i][j] ? 1 : 0;\\n            degree2[i] += g2[i][j] ? 1 : 0;\\n        }\\n    }\\n\\n    // Generate permutations in the original Heap order, then verify each batch\\n    // concurrently and emit matches serially to preserve exact output ordering.\\n    const int batch_capacity = 8192;\\n    vector<int> candidates(static_cast<size_t>(batch_capacity) * vertex_count);\\n    vector<unsigned char> matches(batch_capacity, 0);\\n    int candidate_count = 0;\\n\\n    auto process_batch = [&](int count){\\n        if(count >= 256){\\n            #pragma omp parallel for schedule(static)\\n            for(int k = 0; k < count; ++k){\\n                const int *candidate = candidates.data() + static_cast<size_t>(k) * vertex_count;\\n                matches[k] = verifyPermutationWithDegrees(g1, g2, candidate, degree1, degree2);\\n            }\\n        }else{\\n            for(int k = 0; k < count; ++k){\\n                const int *candidate = candidates.data() + static_cast<size_t>(k) * vertex_count;\\n                matches[k] = verifyPermutationWithDegrees(g1, g2, candidate, degree1, degree2);\\n            }\\n        }\\n\\n        for(int k = 0; k < count; ++k){\\n            if(matches[k]){\\n                const int *candidate = candidates.data() + static_cast<size_t>(k) * vertex_count;\\n                for(int i = 0; i < vertex_count; ++i)\\n                    cout << candidate[i] << \\\" \\\";\\n                cout << endl;\\n                isomorphism_found = true;\\n            }\\n        }\\n        candidate_count = 0;\\n    };\\n\\n    while(exchange_index < vertex_count){\\n        if(exchange_counter[exchange_index] < exchange_index){\\n            if(exchange_index % 2 == 0)\\n                swap(equivalence[0], equivalence[exchange_index]);\\n            else\\n                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\\n\\n            int *candidate = candidates.data() + static_cast<size_t>(candidate_count) * vertex_count;\\n            copy(equivalence.begin(), equivalence.end(), candidate);\\n            ++candidate_count;\\n            if(candidate_count == batch_capacity)\\n                process_batch(candidate_count);\\n\\n            exchange_counter[exchange_index]++;\\n            exchange_index = 1;\\n        }else{\\n            exchange_counter[exchange_index] = 0;\\n            exchange_index++;\\n        }\\n    }\\n\\n    if(candidate_count > 0)\\n        process_batch(candidate_count);\\n\\n    return isomorphism_found;\\n}\\n\\nadjacency_matrix readGraph(){\\n    int vertices, edges, source, destination;\\n\\n    cin >> vertices;\\n    adjacency_matrix read(vertices);\\n    for (int i = 0; i < vertices; ++i)\\n        read[i].resize(vertices);\\n\\n    cin >> edges;\\n    for (int i = 0; i < edges; i++) {\\n       cin >> source >> destination;\\n       read[destination][source] = read[source][destination] = true;\\n    }\\n\\n    return read;\\n}\\n\\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence){\\n    return verifyPermutation(g1, g2, equivalence.data());\\n}\\n\\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, const int *equivalence){\\n    for (int i = 0; i < static_cast<int>(g1.size()); ++i) {\\n        for (int j = 0; j <= i; ++j) {\\n            if(g1[i][j] != g2[equivalence[i]][equivalence[j]]) return false;\\n        }\\n    }\\n    return true;\\n}\\n\\nbool verifyPermutationWithDegrees(adjacency_matrix &g1, adjacency_matrix &g2,\\n                                  const int *equivalence,\\n                                  const vector<int> &degree1,\\n                                  const vector<int> &degree2){\\n    for(int i = 0; i < static_cast<int>(degree1.size()); ++i){\\n        if(degree1[i] != degree2[equivalence[i]]) return false;\\n    }\\n    return verifyPermutation(g1, g2, equivalence);\\n}\\n\\ninline void printPermutation(vector<int> &equivalence){\\n    for (auto i : equivalence)\\n        cout << i << \\\" \\\";\\n    cout << endl;\\n}\\n\",\"path\":\"src/brute_isomorphism.cpp\"}],\"hypothesis\":\"For larger graphs, batching Heap-order permutations allows OpenMP static work sharing across independent exact verifications; degree-signature rejection can skip many adjacency checks, while serial emission preserves output order. Keeping small cases serial should avoid parallel setup overhead.\",\"notes\":\"No commands or tests were run. Correctness depends on the existing OpenMP-enabled build; without OpenMP support the pragma is ignored and the batch path remains serial. The identity-mapping early return and permutation output order are retained.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Keep permutation generation sequential in the existing Heap order, buffer candidates in bounded batches, and verify independent candidates with an OpenMP static parallel-for.\",\"Precompute adjacency-row degree counts and reject mappings with mismatched degrees before performing the exact adjacency comparison.\",\"Emit matches serially in candidate order and retain the original sequential path for graphs with fewer than nine vertices.\"]}"}}

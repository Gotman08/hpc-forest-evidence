    {
      "content": "#include <cstdint>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n\n    const size_t wordsPerRow = (static_cast<size_t>(n) + 63) / 64;\n    vector<uint64_t> blockedCells(static_cast<size_t>(n) * wordsPerRow, 0);\n    for (int c = 0; c < m; c++) {\n        int i, j;\n        cin >> i >> j;\n        const size_t word = static_cast<size_t>(i) * wordsPerRow + (static_cast<size_t>(j) >> 6);\n        blockedCells[word] |= uint64_t(1) << (j & 63);\n    }\n\n    vector<vector<int> > dp(2, vector<int>(n, 0));\n\n    const size_t firstRow = 0;\n    if ((blockedCells[firstRow] & uint64_t(1)) == 0)\n        dp[0][0] = 1;\n\n    for (int j = 1; j < n; j++) {\n        const bool blocked = (blockedCells[static_cast<size_t>(j) >> 6] & (uint64_t(1) << (j & 63))) != 0;\n        if (!blocked) dp[0][j] = dp[0][j - 1];\n    }\n    dp[1][n - 1] = dp[0][n - 1];\n\n    for (int i = 1; i < n; i++) {\n        const size_t rowOffset = static_cast<size_t>(i) * wordsPerRow;\n        for (int j = 0; j < n; j++) {\n            int ans = 0;\n            const bool blocked = (blockedCells[rowOffset + (static_cast<size_t>(j) >> 6)] & (uint64_t(1) << (j & 63))) != 0;\n            if (!blocked) {\n                ans = dp[0][j];\n                if (j != 0) ans += dp[1][j - 1];\n            }\n            dp[1][j] = ans % MOD;\n        }\n        for (int j = 0; j < n; j++) dp[0][j] = dp[1][j];\n    }\n\n    cout << dp[1][n - 1] << endl;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Replacing separately allocated vector<bool> rows with one row-padded uint64_t bitmap will preserve the packed O(N²)-bit representation while reducing allocation fragmentation and making blocked-cell storage contiguous. This isolates a data-layout locality change while retaining the existing DP traversal.",

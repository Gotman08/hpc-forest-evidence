#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#if defined(__aarch64__) && defined(__ARM_NEON)
#include <arm_neon.h>
#endif

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

/*
 * Each body holds coordinate positions (i.e., x, y, and z) and
 * velocities (i.e., vx, vy, and vz).
 */
typedef struct { float x, y, z, vx, vy, vz; } Body;

/*
 * Compute the gravitational impact among all pairs of bodies in
 * the system.
 */
void body_force(Body *p, float dt, int n) {
  int i = 0;

#if defined(__aarch64__) && defined(__ARM_NEON)
  const int vector_end8 = n - n % 8;
  const int vector_end = n - n % 4;
  const float32x4_t softening = vdupq_n_f32(SOFTENING);
  const float64x2_t one = vdupq_n_f64(1.0);

  /* Two independent target vectors share each source broadcast. */
  for (; i < vector_end8; i += 8) {
    const float32x4_t x0 = {p[i].x, p[i + 1].x, p[i + 2].x, p[i + 3].x};
    const float32x4_t y0 = {p[i].y, p[i + 1].y, p[i + 2].y, p[i + 3].y};
    const float32x4_t z0 = {p[i].z, p[i + 1].z, p[i + 2].z, p[i + 3].z};
    const float32x4_t x1 = {p[i + 4].x, p[i + 5].x, p[i + 6].x, p[i + 7].x};
    const float32x4_t y1 = {p[i + 4].y, p[i + 5].y, p[i + 6].y, p[i + 7].y};
    const float32x4_t z1 = {p[i + 4].z, p[i + 5].z, p[i + 6].z, p[i + 7].z};
    float32x4_t fx0 = vdupq_n_f32(0.0f);
    float32x4_t fy0 = vdupq_n_f32(0.0f);
    float32x4_t fz0 = vdupq_n_f32(0.0f);
    float32x4_t fx1 = vdupq_n_f32(0.0f);
    float32x4_t fy1 = vdupq_n_f32(0.0f);
    float32x4_t fz1 = vdupq_n_f32(0.0f);

    for (int j = 0; j < n; j++) {
      const float32x4_t sx = vdupq_n_f32(p[j].x);
      const float32x4_t sy = vdupq_n_f32(p[j].y);
      const float32x4_t sz = vdupq_n_f32(p[j].z);
      float32x4_t dx0 = sx - x0;
      float32x4_t dy0 = sy - y0;
      float32x4_t dz0 = sz - z0;
      float32x4_t dx1 = sx - x1;
      float32x4_t dy1 = sy - y1;
      float32x4_t dz1 = sz - z1;
      float32x4_t sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + softening;
      float32x4_t sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + softening;

      /* Keep double sqrt/division and each lane's ascending-j sum. */
      float64x2_t distance_lo0 = vcvt_f64_f32(vget_low_f32(sqrd_dist0));
      float64x2_t distance_hi0 = vcvt_f64_f32(vget_high_f32(sqrd_dist0));
      float64x2_t distance_lo1 = vcvt_f64_f32(vget_low_f32(sqrd_dist1));
      float64x2_t distance_hi1 = vcvt_f64_f32(vget_high_f32(sqrd_dist1));
      float64x2_t root_lo0 = vsqrtq_f64(distance_lo0);
      float64x2_t root_hi0 = vsqrtq_f64(distance_hi0);
      float64x2_t root_lo1 = vsqrtq_f64(distance_lo1);
      float64x2_t root_hi1 = vsqrtq_f64(distance_hi1);
      float64x2_t inverse_lo0 = vdivq_f64(one, root_lo0);
      float64x2_t inverse_hi0 = vdivq_f64(one, root_hi0);
      float64x2_t inverse_lo1 = vdivq_f64(one, root_lo1);
      float64x2_t inverse_hi1 = vdivq_f64(one, root_hi1);
      float32x4_t inv_dist0 = vcombine_f32(vcvt_f32_f64(inverse_lo0),
                                          vcvt_f32_f64(inverse_hi0));
      float32x4_t inv_dist1 = vcombine_f32(vcvt_f32_f64(inverse_lo1),
                                          vcvt_f32_f64(inverse_hi1));
      float32x4_t inv_dist30 = inv_dist0 * inv_dist0 * inv_dist0;
      float32x4_t inv_dist31 = inv_dist1 * inv_dist1 * inv_dist1;

      fx0 += dx0 * inv_dist30;
      fy0 += dy0 * inv_dist30;
      fz0 += dz0 * inv_dist30;
      fx1 += dx1 * inv_dist31;
      fy1 += dy1 * inv_dist31;
      fz1 += dz1 * inv_dist31;
    }

    p[i].vx += dt*vgetq_lane_f32(fx0, 0);
    p[i].vy += dt*vgetq_lane_f32(fy0, 0);
    p[i].vz += dt*vgetq_lane_f32(fz0, 0);
    p[i + 1].vx += dt*vgetq_lane_f32(fx0, 1);
    p[i + 1].vy += dt*vgetq_lane_f32(fy0, 1);
    p[i + 1].vz += dt*vgetq_lane_f32(fz0, 1);
    p[i + 2].vx += dt*vgetq_lane_f32(fx0, 2);
    p[i + 2].vy += dt*vgetq_lane_f32(fy0, 2);
    p[i + 2].vz += dt*vgetq_lane_f32(fz0, 2);
    p[i + 3].vx += dt*vgetq_lane_f32(fx0, 3);
    p[i + 3].vy += dt*vgetq_lane_f32(fy0, 3);
    p[i + 3].vz += dt*vgetq_lane_f32(fz0, 3);
    p[i + 4].vx += dt*vgetq_lane_f32(fx1, 0);
    p[i + 4].vy += dt*vgetq_lane_f32(fy1, 0);
    p[i + 4].vz += dt*vgetq_lane_f32(fz1, 0);
    p[i + 5].vx += dt*vgetq_lane_f32(fx1, 1);
    p[i + 5].vy += dt*vgetq_lane_f32(fy1, 1);
    p[i + 5].vz += dt*vgetq_lane_f32(fz1, 1);
    p[i + 6].vx += dt*vgetq_lane_f32(fx1, 2);
    p[i + 6].vy += dt*vgetq_lane_f32(fy1, 2);
    p[i + 6].vz += dt*vgetq_lane_f32(fz1, 2);
    p[i + 7].vx += dt*vgetq_lane_f32(fx1, 3);
    p[i + 7].vy += dt*vgetq_lane_f32(fy1, 3);
    p[i + 7].vz += dt*vgetq_lane_f32(fz1, 3);
  }

  /* Each lane owns one target and accumulates sources in ascending j order. */
  for (; i < vector_end; i += 4) {
    const float32x4_t x = {p[i].x, p[i + 1].x, p[i + 2].x, p[i + 3].x};
    const float32x4_t y = {p[i].y, p[i + 1].y, p[i + 2].y, p[i + 3].y};
    const float32x4_t z = {p[i].z, p[i + 1].z, p[i + 2].z, p[i + 3].z};
    float32x4_t fx = vdupq_n_f32(0.0f);
    float32x4_t fy = vdupq_n_f32(0.0f);
    float32x4_t fz = vdupq_n_f32(0.0f);

    for (int j = 0; j < n; j++) {
      float32x4_t dx = vdupq_n_f32(p[j].x) - x;
      float32x4_t dy = vdupq_n_f32(p[j].y) - y;
      float32x4_t dz = vdupq_n_f32(p[j].z) - z;
      float32x4_t sqrd_dist = dx*dx + dy*dy + dz*dz + softening;

      /* Match the reference's double sqrt and division before narrowing. */
      float64x2_t distance_lo = vcvt_f64_f32(vget_low_f32(sqrd_dist));
      float64x2_t distance_hi = vcvt_f64_f32(vget_high_f32(sqrd_dist));
      float64x2_t inverse_lo = vdivq_f64(one, vsqrtq_f64(distance_lo));
      float64x2_t inverse_hi = vdivq_f64(one, vsqrtq_f64(distance_hi));
      float32x4_t inv_dist = vcombine_f32(vcvt_f32_f64(inverse_lo),
                                         vcvt_f32_f64(inverse_hi));
      float32x4_t inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    p[i].vx += dt*vgetq_lane_f32(fx, 0);
    p[i].vy += dt*vgetq_lane_f32(fy, 0);
    p[i].vz += dt*vgetq_lane_f32(fz, 0);
    p[i + 1].vx += dt*vgetq_lane_f32(fx, 1);
    p[i + 1].vy += dt*vgetq_lane_f32(fy, 1);
    p[i + 1].vz += dt*vgetq_lane_f32(fz, 1);
    p[i + 2].vx += dt*vgetq_lane_f32(fx, 2);
    p[i + 2].vy += dt*vgetq_lane_f32(fy, 2);
    p[i + 2].vz += dt*vgetq_lane_f32(fz, 2);
    p[i + 3].vx += dt*vgetq_lane_f32(fx, 3);
    p[i + 3].vy += dt*vgetq_lane_f32(fy, 3);
    p[i + 3].vz += dt*vgetq_lane_f32(fz, 3);
  }
#endif

  for (; i < n; ++i) {
    float fx = 0.0f;
    float fy = 0.0f;
    float fz = 0.0f;

    for (int j = 0; j < n; j++) {
      float dx = p[j].x - p[i].x;
      float dy = p[j].y - p[i].y;
      float dz = p[j].z - p[i].z;
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1 / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    p[i].vx += dt*fx;
    p[i].vy += dt*fy;
    p[i].vz += dt*fz;
  }
}

/*
 * Read a binary dataset with initilized bodies.
 */
Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  return bodies;
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc,char **argv) {
  int nbodies;

  Body *bodies = read_dataset(&nbodies);

  /*
   * At each simulation iteration, interbody forces are computed,
   * and bodies' positions are integrated.
   */
  for (int iter = 0; iter < N_ITER; iter++) {
    body_force(bodies, DT, nbodies);

    for (int i = 0; i < nbodies; i++) {
      bodies[i].x += bodies[i].vx * DT;
      bodies[i].y += bodies[i].vy * DT;
      bodies[i].z += bodies[i].vz * DT;
    }
  }

  write_dataset(nbodies, bodies);

  free(bodies);

  exit(EXIT_SUCCESS);
}

      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <assert.h>\n#include <string.h>\n#include <stdint.h>\n#include <limits.h>\n\nstatic void *checked_array_alloc(size_t count, size_t element_size) {\n    if (count > SIZE_MAX / element_size)\n        exit(EXIT_FAILURE);\n\n    void *p = malloc(count * element_size);\n    if (p == NULL && count != 0)\n        exit(EXIT_FAILURE);\n    return p;\n}\n\nstatic uint64_t string_prefix(const char *s, size_t stride) {\n    const unsigned char *p = (const unsigned char *)s;\n    const unsigned limit = stride < 8 ? (unsigned)stride : 8;\n    uint64_t key = 0;\n\n    /* Stop at the terminator without reading uninitialized record padding. */\n    for (unsigned j = 0; j < limit; ++j) {\n        const unsigned char c = p[j];\n        key |= (uint64_t)c << (56U - 8U * j);\n        if (c == 0)\n            break;\n    }\n    return key;\n}\n\nstatic inline int index_leq(const char *strings, size_t stride,\n                            const uint64_t *keys,\n                            long int lhs, long int rhs) {\n    const uint64_t a = keys[(size_t)lhs];\n    const uint64_t b = keys[(size_t)rhs];\n\n    if (a != b)\n        return a < b;\n    if ((a & UINT64_C(0xff)) == 0)\n        return 1;\n\n    return strcmp(strings + (size_t)lhs * stride + 8,\n                  strings + (size_t)rhs * stride + 8) <= 0;\n}\n\nstatic void initialize_pairs(const char *strings, size_t stride,\n                             const uint64_t *restrict keys,\n                             long int *restrict indices, size_t n) {\n    const size_t pairs = n / 2;\n\n    /* Each iteration reads and writes a distinct pair; no string calls here. */\n#if defined(_OPENMP) && _OPENMP >= 201307\n#pragma omp simd\n#endif\n    for (size_t p = 0; p < pairs; ++p) {\n        const size_t i = 2 * p;\n        const long int reverse = keys[i] > keys[i + 1];\n        indices[i] = (long int)i + reverse;\n        indices[i + 1] = (long int)i + 1 - reverse;\n    }\n\n    if (n % 2 != 0)\n        indices[n - 1] = (long int)(n - 1);\n\n    /* Resolve long common prefixes separately from the vectorizable loop. */\n    for (size_t p = 0; p < pairs; ++p) {\n        const size_t i = 2 * p;\n        if (keys[i] == keys[i + 1] &&\n            (keys[i] & UINT64_C(0xff)) != 0 &&\n            strcmp(strings + i * stride + 8,\n                   strings + (i + 1) * stride + 8) > 0) {\n            indices[i] = (long int)(i + 1);\n            indices[i + 1] = (long int)i;\n        }\n    }\n}\n\nstatic void merge_indices(const char *strings, size_t stride,\n                          const uint64_t *keys,\n                          const long int *restrict src,\n                          long int *restrict dst,\n                          size_t left, size_t middle, size_t right) {\n    if (middle == right ||\n        index_leq(strings, stride, keys, src[middle - 1], src[middle])) {\n        memcpy(dst + left, src + left, (right - left) * sizeof(*src));\n        return;\n    }\n\n    size_t i = left;\n    size_t j = middle;\n    size_t out = left;\n\n    /* These cursors have real dependencies; only the tail copies are bulk work. */\n    while (i < middle && j < right) {\n        const long int a = src[i];\n        const long int b = src[j];\n        if (index_leq(strings, stride, keys, a, b)) {\n            dst[out++] = a;\n            ++i;\n        } else {\n            dst[out++] = b;\n            ++j;\n        }\n    }\n\n    if (i < middle)\n        memcpy(dst + out, src + i, (middle - i) * sizeof(*src));\n    else if (j < right)\n        memcpy(dst + out, src + j, (right - j) * sizeof(*src));\n}\n\nlong int *bucket_sort(char *a, int length, long int size,\n                      int offset, int nbuckets) {\n    (void)offset;\n    (void)nbuckets;\n\n    if (size < 0 || length <= 0)\n        exit(EXIT_FAILURE);\n    if (size == 0)\n        return NULL;\n\n    const size_t n = (size_t)size;\n    const size_t stride = (size_t)length;\n    if (n > SIZE_MAX / stride)\n        exit(EXIT_FAILURE);\n\n    long int *indices = checked_array_alloc(n, sizeof(*indices));\n    if (n == 1) {\n        indices[0] = 0;\n        return indices;\n    }\n\n    uint64_t *keys = checked_array_alloc(n, sizeof(*keys));\n    long int *scratch = checked_array_alloc(n, sizeof(*scratch));\n\n    for (size_t i = 0; i < n; ++i)\n        keys[i] = string_prefix(a + i * stride, stride);\n\n    initialize_pairs(a, stride, keys, indices, n);\n\n    long int *src = indices;\n    long int *dst = scratch;\n    size_t width = 2;\n\n    while (width < n) {\n        size_t left = 0;\n        while (left < n) {\n            const size_t first_count = n - left < width ? n - left : width;\n            const size_t middle = left + first_count;\n            const size_t second_count = n - middle < width ? n - middle : width;\n            const size_t right = middle + second_count;\n\n            merge_indices(a, stride, keys, src, dst, left, middle, right);\n            left = right;\n        }\n\n        long int *tmp = src;\n        src = dst;\n        dst = tmp;\n\n        if (width >= n - width)\n            break;\n        width += width;\n    }\n\n    free(keys);\n    free(dst);\n    return src;\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb) {\n    char *strings = NULL;\n    int len, offset, nbucket;\n    long int n;\n\n    if (!fscanf(stdin, \"%d\", &len)) {\n        printf(\"ERROR len\\n\");\n        exit(1);\n    }\n\n    if (!fscanf(stdin, \"%ld\", &n)) {\n        printf(\"ERROR n\\n\");\n        exit(1);\n    }\n\n    if (!fscanf(stdin, \"%d\", &offset)) {\n        printf(\"ERROR offset\\n\");\n        exit(1);\n    }\n\n    if (!fscanf(stdin, \"%d\", &nbucket)) {\n        printf(\"ERROR nbucket\\n\");\n        exit(1);\n    }\n\n    if (n < 0 || len < 0 || len == INT_MAX || nbucket == INT_MAX)\n        exit(EXIT_FAILURE);\n\n    nbucket = nbucket + 1;\n    len = len + 1;\n    strings = checked_array_alloc((size_t)n, (size_t)len);\n\n    for (long int i = 0; i < n; ++i) {\n        if (!fscanf(stdin, \"%s\", strings + (size_t)i * (size_t)len)) {\n            printf(\"ERROR %ld\\n\", i);\n            exit(1);\n        }\n    }\n\n    *vString = strings;\n    *N = n;\n    *l = len;\n    *os = offset;\n    *nb = nbucket;\n}\n\nvoid print(char *strings, long int *index, long int n, int len) {\n    for (long int i = 0; i < n; ++i)\n        printf(\"%ld -> %s\\n\", i, strings + (size_t)index[i] * (size_t)len);\n}\n\nvoid save(char *strings, long int *index, long int n, int len) {\n    for (long int i = 0; i < n; ++i)\n        printf(\"%s\\n\", strings + (size_t)index[i] * (size_t)len);\n}\n\nint main(int ac, char **av) {\n    char *strings = NULL;\n    long int N = 0;\n    long int *index = NULL;\n    int len = 0,\n        save2File = 0,\n        offset,\n        nbuckets;\n\n    load(&strings, &N, &len, &offset, &nbuckets);\n    index = bucket_sort(strings, len, N, offset, nbuckets);\n    save(strings, index, N, len);\n\n    if (strings != NULL)\n        free(strings);\n    if (index != NULL)\n        free(index);\n\n    return EXIT_SUCCESS;\n}\n",
      "path": "src/bucketsort.c"

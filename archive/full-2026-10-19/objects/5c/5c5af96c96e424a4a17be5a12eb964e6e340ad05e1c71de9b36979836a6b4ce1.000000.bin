from pathlib import Path
import hashlib,json,re
ops=Path(__file__).resolve().parent
base=ops.parents[2]
guide=base/'outputs/HPC-Forest-Harnais-Comparaison-r1/SUIVI-COMPACT.md'
ids=base/'ID.md'
candidate=ops/'SUIVI-COMPACT-candidat-20261018T1514.md'
report=ops.parent/'DEMARRAGES-NORMAUX-ET-POURSUITES-VERIFIES.json'
assert hashlib.sha256(report.read_bytes()).hexdigest()=='e9c5c4a9eb129018704478e5e365ab0ce142ff2adaf6ff5e493e87097d31a95e'
assert json.loads(report.read_bytes())['verified_first_starts_and_continuations_only'] is True
archive=ops/'archivage-guide-20261018T1514'
archive.mkdir(exist_ok=False)
manifest={}
for p in (guide,ids):
    assert p.is_file() and not p.is_symlink()
    raw=p.read_bytes()
    with (archive/p.name).open('xb') as f:f.write(raw)
    assert (archive/p.name).read_bytes()==raw
    manifest[p.name]={'sha256_before':hashlib.sha256(raw).hexdigest(),'bytes_before':len(raw)}
old=ids.read_bytes()
identities=set(re.findall(rb'\bID-(\d{3})\b',old))
assert identities=={f'{i:03}'.encode() for i in range(1,41)}
note='\r\nArrêté technique18octobre15:14UTC : R2g Astra753498/Terra753497/Sol753499 MAX ont chacun leur premier NORMAL distinct de mère, première évaluation valide enregistrée et audit privé reçus ; trois poursuites natives vérifiées, budgets inchangés. Preuve e9c5c4a9… sous outputs/HPC-Forest-Primes-Natif-Relance-r2g/DEMARRAGES-NORMAUX-ET-POURSUITES-VERIFIES.json. Bilan scientifique final encore en attente ; aucune ligne de résultat ou ancien négatif remplacé. R3corrigéR4b exige sa nouvelle dérivée technique/Q avant lancement ; suivi courant compact dans SUIVI-COMPACT.md.\r\n'
at=old.index(b'\n')+1
new=old[:at]+note.encode('utf8')+old[at:]
assert set(re.findall(rb'\bID-(\d{3})\b',new))==identities
ids.write_bytes(new)
guide.write_bytes(candidate.read_bytes())
for p in (guide,ids):manifest[p.name].update(sha256_after=hashlib.sha256(p.read_bytes()).hexdigest(),bytes_after=p.stat().st_size)
manifest.update(all_40_ID_preserved=True,old_scientific_rows_preserved=True,new_scientific_admission=False)
with (archive/'PRESERVATION-ET-COMPACTION.json').open('x',encoding='utf8') as f:json.dump(manifest,f,indent=2);f.write('\n')
print(json.dumps(manifest))

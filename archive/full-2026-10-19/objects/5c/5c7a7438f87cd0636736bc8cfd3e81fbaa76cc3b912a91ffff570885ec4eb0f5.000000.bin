+         and review.get('blocking_findings') == [] and review.get('incident') == refs['incident']
+         and review.get('state_cold_copy') == refs['state']
+         and review.get('routes') == refs['routes'] and review.get('start_intent') == refs['intent']
+         and review.get('start_observed') == refs['start'], 'Exact actual scoped zero incident/review refs')
+    need(incident.get('actual_start_observed') == refs['start']
+         and incident.get('start_intent') == refs['intent']
+         and incident.get('current_state_diagnostic_only') == refs['state']
+         and incident.get('actual_routes') == refs['routes']
+         and incident.get('original_120s_freshness_expired') is True
+         and incident.get('passive_pair_reception_admitted') is False,
+         'Expired actual reception is not reconstructed or admitted')
+    for name in ('actual_active_native_workers', 'native_job_submission_observed',
+                 'normal_model_call_delivered', 'first_evaluation_received'):
+        need(type(incident.get(name)) is int and incident[name] == 0,
+             'Only actual scoped native counters0, never bool or unknown-as0')
+    validate_passive_state(state)
+    need(type(state.get('active_native_workers')) is int and state['active_native_workers'] == 0
+         and state.get('policy_sha256') == refs['policy']['sha256'], 'Exact passive state0/policy')
+    need(routes.get('schema') == 'hpc-forest-r4b-obs4-nine-session-routes-v1'
+         and routes.get('source_zip_sha256') == SOURCE and routes.get('plan_sha256') == PLAN
+         and routes.get('scope_id') == 'hpc-forest-dynamic-independent-roots-r4b-max',
+         'Exact R8 nine-cell registry')
+    history, registry = state.get('routes_history'), routes.get('routes')
+    need(type(history) is dict and len(history) == 9 and type(registry) is list and len(registry) == 9,
+         'All nine explicit routes and state history required')
+    seen = set()
+    for route in registry:
+        key = str(route.get('model')) + ':' + str(route.get('phase'))
+        need(key not in seen and key in history, 'Nine unique model/phase routes')
+        seen.add(key); saved = history[key]; cell = saved.get('cell', {})
+        need(route.get('stage') == saved.get('stage') == 'absent'
+             and route.get('job_id') is None and cell.get('job_id') is None
+             and all(cell.get(k) == route.get(k) for k in ('model','phase','effort','session_id'))
+             and cell.get('source_zip_sha256') == SOURCE and cell.get('plan_sha256') == PLAN
+             and cell.get('scope_id') == routes['scope_id']
+             and all(saved.get(k) == {} for k in ('allocation_binding','worker_binding','terminal_binding'))
+             and all(k not in route for k in ('submission_observed','allocation_marker','worker_binding','terminal_binding')),
+             'No job/publication/worker/terminal binding may be promoted from this absent registry')
+    need(seen == set(history), 'No unaccounted route history')

+def initialize_passive_io():
+    """Exact already ROOT22-tested short RWD primitives; no persistent parent/source holds."""
+    global _passive_io
+    need(_passive_io is None, 'Passive reader initialized once only')
+    code = raw(COPY_SOURCE)
+    need(digest(code) == COPY_SHA, 'Qualified short source reader changed')
+    names = {'need', 'sha', 'lexical', 'NativeSharedIO'}
+    nodes = [n for n in ast.parse(code).body
+             if isinstance(n, (ast.FunctionDef, ast.ClassDef)) and n.name in names]
+    need({n.name for n in nodes} == names, 'Exact ROOT22 reader definitions required')
+    ns = {'Path': Path, 'os': os, 'stat': stat, 'hashlib': hashlib,
+          'MAX_SOURCE_BYTES': 16 * 1024 * 1024,
+          'LIVE_NAMES': {'observer-state.json', 'stdout.log', 'stderr.log',
+                         'routes-obs4.json', 'observer.lock', 'worker.lock'}}
+    exec(compile(ast.Module(body=nodes, type_ignores=[]), str(COPY_SOURCE), 'exec'), ns)
+    _passive_io = ns['NativeSharedIO'](PREP)
+

+def validate_scoped_zero(incident, review, state, routes, policy, refs):
+    need(incident.get('schema') == 'hpc-forest-r8-root-passive-first-reception-expired-zero-native-audit-v1'
+         and review.get('schema') == 'hpc-forest-r8-expired-passive-zero-native-incident-independent-cold-review-v1'

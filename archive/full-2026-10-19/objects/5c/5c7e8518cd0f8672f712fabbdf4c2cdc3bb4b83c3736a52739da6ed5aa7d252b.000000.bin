#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N_ITER 10
#define DT 0.01f
#define SOFTENING 1e-9f

int main(int argc, char **argv) {
    int nbodies;
    if (fread(&nbodies, sizeof(nbodies), 1, stdin) != 1) {
        fprintf(stderr, "\nError reading nbodie value\n");
        exit(EXIT_FAILURE);
    }
    size_t count = (size_t)nbodies * 6;
    float *tmp = (float *)malloc(count * sizeof(float));
    if (!tmp) { perror("malloc"); exit(EXIT_FAILURE); }
    if (fread(tmp, count * sizeof(float), 1, stdin) != 1) {
        fprintf(stderr, "\nError reading input values\n");
        exit(EXIT_FAILURE);
    }

    float * restrict px = (float *)malloc((size_t)nbodies * sizeof(float));
    float * restrict py = (float *)malloc((size_t)nbodies * sizeof(float));
    float * restrict pz = (float *)malloc((size_t)nbodies * sizeof(float));
    float * restrict vx = (float *)malloc((size_t)nbodies * sizeof(float));
    float * restrict vy = (float *)malloc((size_t)nbodies * sizeof(float));
    float * restrict vz = (float *)malloc((size_t)nbodies * sizeof(float));
    if (!px || !py || !pz || !vx || !vy || !vz) { perror("malloc"); exit(EXIT_FAILURE); }

    for (int i = 0; i < nbodies; ++i) {
        px[i] = tmp[6*i];
        py[i] = tmp[6*i+1];
        pz[i] = tmp[6*i+2];
        vx[i] = tmp[6*i+3];
        vy[i] = tmp[6*i+4];
        vz[i] = tmp[6*i+5];
    }
    free(tmp);

    #pragma omp parallel
    {
        for (int iter = 0; iter < N_ITER; ++iter) {
            #pragma omp for simd
            for (int i = 0; i < nbodies; ++i) {
                float fx = 0.0f, fy = 0.0f, fz = 0.0f;
                const float xi = px[i], yi = py[i], zi = pz[i];
                for (int j = 0; j < nbodies; ++j) {
                    float dx = px[j] - xi;
                    float dy = py[j] - yi;
                    float dz = pz[j] - zi;
                    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
                    float inv_dist = 1.0f / sqrt(sqrd_dist);
                    float inv_dist3 = inv_dist * inv_dist * inv_dist;
                    fx += dx * inv_dist3;
                    fy += dy * inv_dist3;
                    fz += dz * inv_dist3;
                }
                vx[i] += DT*fx;
                vy[i] += DT*fy;
                vz[i] += DT*fz;
            }

            #pragma omp for simd
            for (int i = 0; i < nbodies; ++i) {
                px[i] += vx[i] * DT;
                py[i] += vy[i] * DT;
                pz[i] += vz[i] * DT;
            }
        }
    }

    float *out = (float *)malloc(count * sizeof(float));
    if (!out) { perror("malloc"); exit(EXIT_FAILURE); }
    for (int i = 0; i < nbodies; ++i) {
        out[6*i]   = px[i];
        out[6*i+1] = py[i];
        out[6*i+2] = pz[i];
        out[6*i+3] = vx[i];
        out[6*i+4] = vy[i];
        out[6*i+5] = vz[i];
    }
    if (fwrite(out, count * sizeof(float), 1, stdout) != 1) {
        fprintf(stderr, "\nError writing to output\n");
        exit(EXIT_FAILURE);
    }

    free(px); free(py); free(pz); free(vx); free(vy); free(vz); free(out);
    return EXIT_SUCCESS;
}

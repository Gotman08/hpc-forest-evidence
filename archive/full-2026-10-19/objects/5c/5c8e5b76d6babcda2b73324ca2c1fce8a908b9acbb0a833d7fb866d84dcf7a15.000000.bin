"""Nine portable review-binding cases; fixture paths never assert Windows observations."""
import ast
import copy
import hashlib
import json
import os
from pathlib import Path
import re
import time

import pytest

PAYLOAD = Path(os.environ['R6_REVIEW_PAYLOAD'])
ADAPTERS = Path(os.environ['R6_ADAPTER_ROOT'])
SCOPE = 'hpc-forest-dynamic-independent-roots-r4b-max'
SOURCE = 'eaff9217499fe268e4d151165a368a83bad1550d921955a9f9256026cfac2d48'
PLAN = 'd08ac00bcfb75625a24971b2684d7479c4da7a98b339e4e10eae5b9ac525ef27'
REVIEW_PATH = ('outputs/HPC-Forest-Mere-Dynamique-R4-MAX-Preparation-r3/'
    'operations-parent-premier-roots-source110-r1/preparation-roots-operationnelle-r1/'
    'revision-source-state-binding-r2/REVUE-SOURCE-STATE-564-ED888-PREPARATION.json')
READER_PATH = 'outputs/HPC-Forest-Primes-Natif-Lancement-r2d/source-only-reader-r4/source_only_state.py'
PINNED_DATA = {'actual-review.json': '1a65d2c23b12a14768bc9367d09f519623a7d6ed0c8bb27cfef8d3d7bfb9712a',
    'source_only_state.py': '564398d676dceb6b5ba893fcbb3835c7aec31a1cbd5d5c5dcef6b361a3a23338',
    'verifier-current.py': 'ed888a9ab9c35e4e1a6c227525e9578281ed57c6961ccd9c9928eb397f62e450',
    'actual-windows-binding-CANDIDATE-NOT-ADMITTED.json': '63817c08b53fa63e33a1c559cff2502539846223a4f695928e1300a6636bfd9e',
    'previous-reader-bridge-r5.py': '379a8adf614ab14601ff88442d7ba3ebcb52484d468ff4a91d53220fd653c5dc'}


def digest(value):
    return hashlib.sha256(value).hexdigest()


def selected_functions(path, names):
    nodes = {n.name: n for n in ast.parse(path.read_text(encoding='utf8')).body if isinstance(n, ast.FunctionDef)}
    assert all(name in nodes for name in names)
    return ast.Module(body=[nodes[name] for name in names], type_ignores=[])


def verify_components():
    actual = json.loads((ADAPTERS / 'COMPONENTS.json').read_text(encoding='utf8'))
    assert actual['source_zip_sha256'] == SOURCE and actual['plan_sha256'] == PLAN and len(actual['code_pins']) == 62
    for name, expected in actual['code_pins'].items():
        path = ADAPTERS / name
        assert not Path(name).is_absolute() and '..' not in Path(name).parts
        assert path.is_file() and not path.is_symlink() and digest(path.read_bytes()) == expected


class ReviewAcceptedBeforeAnySourceImport(Exception):
    """No source module, projection, model or admission is returned."""


def stop_before_source():
    raise ReviewAcceptedBeforeAnySourceImport


def fixture(tmp_path, *, old=False):
    verify_components()
    for name, expected in PINNED_DATA.items():
        assert digest((PAYLOAD / name).read_bytes()) == expected
    base = tmp_path / 'portable-namespace-not-Windows-state'
    paths = {'reader': base / READER_PATH,
             'current_verifier': (base / READER_PATH).with_name('verifier-current.py'),
             'independent_review': base / REVIEW_PATH}
    source_names = {'reader': 'source_only_state.py', 'current_verifier': 'verifier-current.py',
                    'independent_review': 'actual-review.json'}
    for key, path in paths.items():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes((PAYLOAD / source_names[key]).read_bytes())
    binding = json.loads((PAYLOAD / 'actual-windows-binding-CANDIDATE-NOT-ADMITTED.json').read_text(encoding='utf8'))
    # Three pathname substitutions only, not changed document bytes or positive facts.
    for key, path in paths.items():
        assert binding[key]['sha256'] == PINNED_DATA[source_names[key]]
        binding[key]['path'] = str(path)
    namespace = {'Path': Path, 'json': json, 're': re, 'hashlib': hashlib, 'time': time,
                 'BASE': base, 'HERE': ADAPTERS, 'verify_dependencies': verify_components,
                 'source_modules': stop_before_source}
    core = selected_functions(ADAPTERS / 'chain_contract.py', ['need', 'sha', 'artifact', 'read'])
    exec(compile(core, '<exact-qualified-cold-artifact-functions>', 'exec'), namespace)  # noqa: S102
    bridge = PAYLOAD / 'previous-reader-bridge-r5.py' if old else ADAPTERS / 'reader_bridge.py'
    body = selected_functions(bridge, ['produce_projection'])
    exec(compile(body, '<exact-produce-projection-fixture-namespace>', 'exec'), namespace)  # noqa: S102
    return namespace, binding


def invoke(namespace, binding, tmp_path):
    path = tmp_path / 'portable-binding.json'
    path.write_text(json.dumps(binding), encoding='utf8')
    ref = {'path': str(path), 'sha256': digest(path.read_bytes())}
    return namespace['produce_projection']({}, {}, ref, now=0)


def test_real_review_bytes_and_corrected_function_accept_only_boundary(tmp_path):
    namespace, binding = fixture(tmp_path)
    with pytest.raises(ReviewAcceptedBeforeAnySourceImport):
        invoke(namespace, binding, tmp_path)


def test_previous_function_refuses_new_review_without_loading_source(tmp_path):
    namespace, binding = fixture(tmp_path, old=True)
    with pytest.raises(ValueError):
        invoke(namespace, binding, tmp_path)


def test_ancestor_review_hash_still_refused(tmp_path):
    namespace, binding = fixture(tmp_path)
    binding['independent_review']['sha256'] = '9c44954538a8e21fb5d16df3e493bf1b37ba64d1e81cb7b1aef6ef6605db1c36'
    with pytest.raises(ValueError):
        invoke(namespace, binding, tmp_path)


@pytest.mark.parametrize('change', ['reader_sha', 'verifier_sha', 'review_sha', 'review_path', 'revision', 'extra'])
def test_portable_binding_mutations_refused(change, tmp_path):
    namespace, actual = fixture(tmp_path)
    binding = copy.deepcopy(actual)
    if change == 'reader_sha':
        binding['reader']['sha256'] = '0' * 64
    elif change == 'verifier_sha':
        binding['current_verifier']['sha256'] = '0' * 64
    elif change == 'review_sha':
        binding['independent_review']['sha256'] = '0' * 64
    elif change == 'review_path':
        binding['independent_review']['path'] = binding['reader']['path']
    elif change == 'revision':
        binding['revision'] = 'not-reviewed'
    else:
        binding['verified'] = True
    with pytest.raises(ValueError):
        invoke(namespace, binding, tmp_path)

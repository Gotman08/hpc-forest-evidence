  "data": {
    "files": [
      {
        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdint.h>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10\n#define DT 0.01f\n#define SOFTENING 1e-9f\n#define PAIR_TILE 32\n#define PAIR_CACHE_BYTES (64u * 1024u * 1024u)\n#define PAIR_CACHE_ALIGNMENT 128u\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\ntypedef struct { float x, y, z; } Position;\n\ntypedef struct {\n  Position *positions;\n  float *coefficients;\n  void *coefficient_allocation;\n  size_t coefficient_stride;\n} ForceWorkspace;\n\nstatic inline float inverse_cube(float dx, float dy, float dz) {\n  float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n  float inv_dist = 1 / sqrt(sqrd_dist);\n  return inv_dist * inv_dist * inv_dist;\n}\n\n/* Allocation-free reference fallback. */\nstatic void body_force_unpacked(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n    for (int j = 0; j < n; ++j) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float scale = inverse_cube(dx, dy, dz);\n      fx += dx * scale;\n      fy += dy * scale;\n      fz += dz * scale;\n    }\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic inline __attribute__((always_inline))\nfloat32x4_t reference_inv_dist4(float32x4_t distance) {\n  const float64x2_t one = vdupq_n_f64(1.0);\n  float64x2_t low = vcvt_f64_f32(vget_low_f32(distance));\n  float64x2_t high = vcvt_f64_f32(vget_high_f32(distance));\n  low = vdivq_f64(one, vsqrtq_f64(low));\n  high = vdivq_f64(one, vsqrtq_f64(high));\n  return vcombine_f32(vcvt_f32_f64(low), vcvt_f32_f64(high));\n}\n\nstatic inline __attribute__((always_inline))\nfloat32x4_t inverse_cube4(float32x4_t dx, float32x4_t dy,\n                         float32x4_t dz) {\n  const float32x4_t softening = vdupq_n_f32(SOFTENING);\n  float32x4_t distance = dx*dx + dy*dy + dz*dz + softening;\n  float32x4_t inv = reference_inv_dist4(distance);\n  return inv * inv * inv;\n}\n#endif\n\nstatic inline void mirror_coefficient(const Position *src, float *coefficients,\n                                      size_t stride, int i, int j,\n                                      float scale) {\n  if (i != j) {\n    if (isnan(scale)) {\n      scale = inverse_cube(src[i].x - src[j].x,\n                           src[i].y - src[j].y,\n                           src[i].z - src[j].z);\n    }\n    coefficients[(size_t)j * stride + (size_t)i] = scale;\n  }\n}\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic inline __attribute__((always_inline))\nvoid fill_four_coefficients(const Position *src, float *coefficients,\n                            size_t stride, int i, int j) {\n  const float32x4_t xj = {src[j].x, src[j+1].x, src[j+2].x, src[j+3].x};\n  const float32x4_t yj = {src[j].y, src[j+1].y, src[j+2].y, src[j+3].y};\n  const float32x4_t zj = {src[j].z, src[j+1].z, src[j+2].z, src[j+3].z};\n  float32x4_t scale = inverse_cube4(xj - vdupq_n_f32(src[i].x),\n                                   yj - vdupq_n_f32(src[i].y),\n                                   zj - vdupq_n_f32(src[i].z));\n  vst1q_f32(coefficients + (size_t)i * stride + (size_t)j, scale);\n  mirror_coefficient(src, coefficients, stride, i, j,\n                     vgetq_lane_f32(scale, 0));\n  mirror_coefficient(src, coefficients, stride, i, j+1,\n                     vgetq_lane_f32(scale, 1));\n  mirror_coefficient(src, coefficients, stride, i, j+2,\n                     vgetq_lane_f32(scale, 2));\n  mirror_coefficient(src, coefficients, stride, i, j+3,\n                     vgetq_lane_f32(scale, 3));\n}\n#endif\n\n/* One work item owns an upper-triangular tile and its transpose. */\nstatic inline void fill_coefficient_tile(const Position *src,\n                                         float *coefficients, size_t stride,\n                                         int n, int nblocks, size_t tile) {\n  int lo = 0;\n  int hi = nblocks;\n  while (lo + 1 < hi) {\n    int mid = lo + (hi - lo) / 2;\n    size_t base = (size_t)mid *\n                  (2u * (size_t)nblocks - (size_t)mid + 1u) / 2u;\n    if (base <= tile)\n      lo = mid;\n    else\n      hi = mid;\n  }\n  size_t base = (size_t)lo *\n                (2u * (size_t)nblocks - (size_t)lo + 1u) / 2u;\n  int block_i = lo;\n  int block_j = lo + (int)(tile - base);\n  int i_begin = block_i * PAIR_TILE;\n  int j_begin = block_j * PAIR_TILE;\n  int i_end = i_begin + PAIR_TILE;\n  int j_end = j_begin + PAIR_TILE;\n  if (i_end > n) i_end = n;\n  if (j_end > n) j_end = n;\n\n  for (int i = i_begin; i < i_end; ++i) {\n    int j = block_i == block_j ? i : j_begin;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    for (; j_end - j >= 12; j += 12) {\n      fill_four_coefficients(src, coefficients, stride, i, j);\n      fill_four_coefficients(src, coefficients, stride, i, j+4);\n      fill_four_coefficients(src, coefficients, stride, i, j+8);\n    }\n    for (; j_end - j >= 4; j += 4) {\n      fill_four_coefficients(src, coefficients, stride, i, j);\n    }\n#endif\n    for (; j < j_end; ++j) {\n      float dx = src[j].x - src[i].x;\n      float dy = src[j].y - src[i].y;\n      float dz = src[j].z - src[i].z;\n      float scale = inverse_cube(dx, dy, dz);\n      coefficients[(size_t)i * stride + (size_t)j] = scale;\n      mirror_coefficient(src, coefficients, stride, i, j, scale);\n    }\n  }\n}\n\nstatic inline void force_one(const Position *src, Body *p,\n                              const float *coefficients, size_t stride,\n                              float dt, int n, int i) {\n  const float *row = coefficients ? coefficients + (size_t)i * stride : NULL;\n  float xi = src[i].x;\n  float yi = src[i].y;\n  float zi = src[i].z;\n  float fx = 0.0f;\n  float fy = 0.0f;\n  float fz = 0.0f;\n  for (int j = 0; j < n; ++j) {\n    float dx = src[j].x - xi;\n    float dy = src[j].y - yi;\n    float dz = src[j].z - zi;\n    float scale = row ? row[j] : inverse_cube(dx, dy, dz);\n    fx += dx * scale;\n    fy += dy * scale;\n    fz += dz * scale;\n  }\n  p[i].vx += dt*fx;\n  p[i].vy += dt*fy;\n  p[i].vz += dt*fz;\n}\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic inline __attribute__((always_inline))\nfloat32x4_t load_coefficient4(const float *r0, const float *r1,\n                              const float *r2, const float *r3, int j) {\n  return (float32x4_t){r0[j], r1[j], r2[j], r3[j]};\n}\n\nstatic inline void force_four(const Position *src, Body *p,\n                               const float *coefficients, size_t stride,\n                               float dt, int n, int i) {\n  const float32x4_t x = {src[i].x, src[i+1].x, src[i+2].x, src[i+3].x};\n  const float32x4_t y = {src[i].y, src[i+1].y, src[i+2].y, src[i+3].y};\n  const float32x4_t z = {src[i].z, src[i+1].z, src[i+2].z, src[i+3].z};\n  const float *r0 = coefficients ? coefficients + (size_t)i * stride : NULL;\n  const float *r1 = r0 ? r0 + stride : NULL;\n  const float *r2 = r1 ? r1 + stride : NULL;\n  const float *r3 = r2 ? r2 + stride : NULL;\n  float32x4_t fx = vdupq_n_f32(0.0f);\n  float32x4_t fy = vdupq_n_f32(0.0f);\n  float32x4_t fz = vdupq_n_f32(0.0f);\n  const int source_end = n - n % 3;\n  int j = 0;\n\n  /* Each SIMD lane accumulates one target in ascending source order. */\n  for (; j < source_end; j += 3) {\n    float32x4_t dx0 = vdupq_n_f32(src[j].x) - x;\n    float32x4_t dy0 = vdupq_n_f32(src[j].y) - y;\n    float32x4_t dz0 = vdupq_n_f32(src[j].z) - z;\n    float32x4_t dx1 = vdupq_n_f32(src[j+1].x) - x;\n    float32x4_t dy1 = vdupq_n_f32(src[j+1].y) - y;\n    float32x4_t dz1 = vdupq_n_f32(src[j+1].z) - z;\n    float32x4_t dx2 = vdupq_n_f32(src[j+2].x) - x;\n    float32x4_t dy2 = vdupq_n_f32(src[j+2].y) - y;\n    float32x4_t dz2 = vdupq_n_f32(src[j+2].z) - z;\n    float32x4_t scale0, scale1, scale2;\n    if (r0 != NULL) {\n      scale0 = load_coefficient4(r0, r1, r2, r3, j);\n      scale1 = load_coefficient4(r0, r1, r2, r3, j+1);\n      scale2 = load_coefficient4(r0, r1, r2, r3, j+2);\n    } else {\n      scale0 = inverse_cube4(dx0, dy0, dz0);\n      scale1 = inverse_cube4(dx1, dy1, dz1);\n      scale2 = inverse_cube4(dx2, dy2, dz2);\n    }\n    fx += dx0 * scale0;\n    fy += dy0 * scale0;\n    fz += dz0 * scale0;\n    fx += dx1 * scale1;\n    fy += dy1 * scale1;\n    fz += dz1 * scale1;\n    fx += dx2 * scale2;\n    fy += dy2 * scale2;\n    fz += dz2 * scale2;\n  }\n  for (; j < n; ++j) {\n    float32x4_t dx = vdupq_n_f32(src[j].x) - x;\n    float32x4_t dy = vdupq_n_f32(src[j].y) - y;\n    float32x4_t dz = vdupq_n_f32(src[j].z) - z;\n    float32x4_t scale;\n    if (r0 != NULL)\n      scale = load_coefficient4(r0, r1, r2, r3, j);\n    else\n      scale = inverse_cube4(dx, dy, dz);\n    fx += dx * scale;\n    fy += dy * scale;\n    fz += dz * scale;\n  }\n  p[i].vx += dt*vgetq_lane_f32(fx, 0);\n  p[i].vy += dt*vgetq_lane_f32(fy, 0);\n  p[i].vz += dt*vgetq_lane_f32(fz, 0);\n  p[i+1].vx += dt*vgetq_lane_f32(fx, 1);\n  p[i+1].vy += dt*vgetq_lane_f32(fy, 1);\n  p[i+1].vz += dt*vgetq_lane_f32(fz, 1);\n  p[i+2].vx += dt*vgetq_lane_f32(fx, 2);\n  p[i+2].vy += dt*vgetq_lane_f32(fy, 2);\n  p[i+2].vz += dt*vgetq_lane_f32(fz, 2);\n  p[i+3].vx += dt*vgetq_lane_f32(fx, 3);\n  p[i+3].vy += dt*vgetq_lane_f32(fy, 3);\n  p[i+3].vz += dt*vgetq_lane_f32(fz, 3);\n}\n#endif\n\nstatic ForceWorkspace create_workspace(int n) {\n  ForceWorkspace work = {NULL, NULL, NULL, 0};\n  if (n <= 0 || (size_t)n > (size_t)-1 / sizeof(Position)) return work;\n  size_t count = (size_t)n;\n  work.positions = (Position *)malloc(count * sizeof(Position));\n  if (work.positions == NULL) return work;\n\n  work.coefficient_stride =\n      ((count + (size_t)PAIR_TILE - 1u) / (size_t)PAIR_TILE) *\n      (size_t)PAIR_TILE;\n  if (work.coefficient_stride <=\n      ((size_t)PAIR_CACHE_BYTES / sizeof(float)) / count) {\n    size_t bytes = count * work.coefficient_stride * sizeof(float);\n    work.coefficient_allocation =\n        malloc(bytes + (size_t)PAIR_CACHE_ALIGNMENT - 1u);\n    if (work.coefficient_allocation != NULL) {\n      uintptr_t address = (uintptr_t)work.coefficient_allocation;\n      address = (address + (uintptr_t)PAIR_CACHE_ALIGNMENT - 1u) &\n                ~((uintptr_t)PAIR_CACHE_ALIGNMENT - 1u);\n      work.coefficients = (float *)address;\n    }\n  }\n  return work;\n}\n\nstatic void destroy_workspace(ForceWorkspace *work) {\n  free(work->coefficient_allocation);\n  free(work->positions);\n}\n\nstatic void body_force_workspace(Body *p, float dt, int n,\n                                  ForceWorkspace *work) {\n  Position *positions = work->positions;\n  if (positions == NULL) {\n    body_force_unpacked(p, dt, n);\n    return;\n  }\n  for (int i = 0; i < n; ++i) {\n    positions[i].x = p[i].x;\n    positions[i].y = p[i].y;\n    positions[i].z = p[i].z;\n  }\n\n  float *coefficients = work->coefficients;\n  size_t stride = work->coefficient_stride;\n  if (coefficients != NULL) {\n    int nblocks = n / PAIR_TILE + (n % PAIR_TILE != 0);\n    size_t ntiles = (size_t)nblocks * ((size_t)nblocks + 1u) / 2u;\n#ifdef _OPENMP\n#pragma omp parallel for schedule(static) if(n >= 256)\n#endif\n    for (size_t tile = 0; tile < ntiles; ++tile) {\n      fill_coefficient_tile(positions, coefficients, stride, n, nblocks, tile);\n    }\n  }\n\n  const int nblocks = n / 4;\n#ifdef _OPENMP\n#pragma omp parallel for schedule(static) if(n >= 256)\n#endif\n  for (int block = 0; block < nblocks; ++block) {\n    int i = block * 4;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    force_four(positions, p, coefficients, stride, dt, n, i);\n#else\n    for (int lane = 0; lane < 4; ++lane) {\n      force_one(positions, p, coefficients, stride, dt, n, i + lane);\n    }\n#endif\n  }\n  for (int i = nblocks * 4; i < n; ++i) {\n    force_one(positions, p, coefficients, stride, dt, n, i);\n  }\n}\n\nvoid body_force(Body *p, float dt, int n) {\n  if (n <= 0) return;\n  ForceWorkspace work = create_workspace(n);\n  body_force_workspace(p, dt, n, &work);\n  destroy_workspace(&work);\n}\n\nstatic void simulate(Body *p, float dt, int n) {\n  if (n <= 0) return;\n  ForceWorkspace work = create_workspace(n);\n  for (int iter = 0; iter < N_ITER; ++iter) {\n    body_force_workspace(p, dt, n, &work);\n    for (int i = 0; i < n; ++i) {\n      p[i].x += p[i].vx * dt;\n      p[i].y += p[i].vy * dt;\n      p[i].z += p[i].vz * dt;\n    }\n  }\n  destroy_workspace(&work);\n}\n\n/* Read a binary dataset with initialized bodies. */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n  return bodies;\n}\n\n/* Write simulation results into a binary dataset. */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n  Body *bodies = read_dataset(&nbodies);\n  simulate(bodies, DT, nbodies);\n  write_dataset(nbodies, bodies);\n  free(bodies);\n  exit(EXIT_SUCCESS);\n}\n",

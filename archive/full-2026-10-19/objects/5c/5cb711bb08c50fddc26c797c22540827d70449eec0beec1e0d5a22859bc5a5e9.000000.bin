  "files": [
    {
      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdio>\n#include <limits>\n#include <memory>\n#include <vector>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing Sum = long long;\n\nclass FastInput {\n    unsigned char buffer[1 << 16];\n    std::size_t position = 0;\n    std::size_t available = 0;\n\n    int nextChar() {\n        if (position == available) {\n            available = std::fread(buffer, 1, sizeof(buffer), stdin);\n            position = 0;\n            if (available == 0) return EOF;\n        }\n        return buffer[position++];\n    }\n\npublic:\n    bool nextInt(int& value) {\n        int ch = nextChar();\n        while (ch != EOF && ch <= ' ') ch = nextChar();\n        if (ch == EOF) return false;\n        bool negative = false;\n        if (ch == '-' || ch == '+') {\n            negative = ch == '-';\n            ch = nextChar();\n        }\n        unsigned int magnitude = 0;\n        while (ch >= '0' && ch <= '9') {\n            magnitude = magnitude * 10u + static_cast<unsigned int>(ch - '0');\n            ch = nextChar();\n        }\n        value = negative\n            ? static_cast<int>(-static_cast<Sum>(magnitude))\n            : static_cast<int>(magnitude);\n        return true;\n    }\n};\n\nstruct RowBlock {\n    std::unique_ptr<int[]> input;\n    std::unique_ptr<Sum[]> horizontal;\n};\n\nstruct Stripe {\n    int begin = 0;\n    int columns = 0;\n    std::unique_ptr<Sum[]> sums;\n    std::unique_ptr<Sum[]> history;\n    Sum maximum = std::numeric_limits<Sum>::lowest();\n};\n\nstatic void horizontalSums(const int* input, Sum* output,\n                           int rows, int n, int s, int m) {\n    for (int r = 0; r < rows; ++r) {\n        const int* row = input + static_cast<std::size_t>(r) * n;\n        Sum* destination = output + static_cast<std::size_t>(r) * m;\n        Sum sum = 0;\n        #pragma omp simd reduction(+:sum)\n        for (int c = 0; c < s; ++c) sum += row[c];\n        destination[0] = sum;\n        for (int c = 1; c < m; ++c) {\n            sum += static_cast<Sum>(row[c + s - 1]) - row[c - 1];\n            destination[c] = sum;\n        }\n    }\n}\n\nstatic void consumeBlock(Stripe* stripe, const Sum* horizontal,\n                         int rows, int firstRow, int s, int m) {\n    const int columns = stripe->columns;\n    Sum* sums = stripe->sums.get();\n    Sum* history = stripe->history.get();\n    Sum best = stripe->maximum;\n    int ringRow = firstRow % s;\n\n    for (int r = 0; r < rows; ++r) {\n        const Sum* current = horizontal\n            + static_cast<std::size_t>(r) * m + stripe->begin;\n        Sum* previous = history + static_cast<std::size_t>(ringRow) * columns;\n        const int globalRow = firstRow + r;\n        if (globalRow < s) {\n            #pragma omp simd\n            for (int c = 0; c < columns; ++c) {\n                sums[c] += current[c];\n                previous[c] = current[c];\n            }\n            if (globalRow + 1 == s) {\n                #pragma omp simd reduction(max:best)\n                for (int c = 0; c < columns; ++c) {\n                    if (sums[c] > best) best = sums[c];\n                }\n            }\n        } else {\n            #pragma omp simd reduction(max:best)\n            for (int c = 0; c < columns; ++c) {\n                const Sum value = sums[c] + current[c] - previous[c];\n                sums[c] = value;\n                previous[c] = current[c];\n                if (value > best) best = value;\n            }\n        }\n        if (++ringRow == s) ringRow = 0;\n    }\n    stripe->maximum = best;\n}\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.nextInt(n) || !input.nextInt(s)) return 0;\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const int m = n - s + 1;\n    const int blockRows = std::min(64, n);\n    const int blockCount = (n + blockRows - 1) / blockRows;\n    const bool parallelWork = static_cast<std::size_t>(n) * n >= (1u << 16);\n    Sum answer = std::numeric_limits<Sum>::lowest();\n\n    #pragma omp parallel if(parallelWork)\n    {\n        #pragma omp single\n        {\n            int threads = 1;\n            #ifdef _OPENMP\n            threads = omp_get_num_threads();\n            #endif\n            const int stripeCount = std::min(m, threads);\n            const int slotCount = std::min(blockCount, std::min(8, 2 * threads));\n            std::vector<Stripe> stripes(stripeCount);\n            std::vector<RowBlock> blocks(slotCount);\n            std::vector<int> readyTokens(slotCount, 0);\n            std::vector<int> chainTokens(stripeCount, 0);\n            int* ready = readyTokens.data();\n            int* chains = chainTokens.data();\n\n            for (int k = 0; k < stripeCount; ++k) {\n                Stripe& stripe = stripes[k];\n                stripe.begin = m * k / stripeCount;\n                stripe.columns = m * (k + 1) / stripeCount - stripe.begin;\n                stripe.sums.reset(new Sum[stripe.columns]());\n                stripe.history.reset(new Sum[static_cast<std::size_t>(s)\n                                             * stripe.columns]);\n            }\n            for (int slot = 0; slot < slotCount; ++slot) {\n                blocks[slot].input.reset(new int[static_cast<std::size_t>(blockRows) * n]);\n                blocks[slot].horizontal.reset(new Sum[static_cast<std::size_t>(blockRows) * m]);\n            }\n\n            int nextRow = 0;\n            while (nextRow < n) {\n                for (int slot = 0; slot < slotCount && nextRow < n; ++slot) {\n                    const int firstRow = nextRow;\n                    const int rows = std::min(blockRows, n - firstRow);\n                    int* raw = blocks[slot].input.get();\n                    Sum* horizontal = blocks[slot].horizontal.get();\n                    const std::size_t values = static_cast<std::size_t>(rows) * n;\n                    for (std::size_t i = 0; i < values; ++i) input.nextInt(raw[i]);\n\n                    #pragma omp task firstprivate(raw, horizontal, rows, n, s, m) depend(out: ready[slot])\n                    {\n                        horizontalSums(raw, horizontal, rows, n, s, m);\n                    }\n\n                    for (int k = 0; k < stripeCount; ++k) {\n                        Stripe* stripe = &stripes[k];\n                        #pragma omp task firstprivate(stripe, horizontal, rows, firstRow, s, m) depend(in: ready[slot]) depend(inout: chains[k])\n                        {\n                            consumeBlock(stripe, horizontal, rows, firstRow, s, m);\n                        }\n                    }\n                    nextRow += rows;\n                }\n                #pragma omp taskwait\n            }\n\n            for (int k = 0; k < stripeCount; ++k) {\n                answer = std::max(answer, stripes[k].maximum);\n            }\n        }\n    }\n\n    std::printf(\"%lld\\n\", answer);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Dependency-ordered column-stripe tasks can compute the maximum while input is still being decoded, avoiding a post-input traversal and per-row barriers.",

{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <stdint.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n#define FORCE_TILE 32\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\ntypedef struct { float x, y, z; } Force;\ntypedef struct {\n  int completed;\n  unsigned char padding[64 - sizeof(int)];\n} ForceProgress;\n\nstatic void body_force_rows(Body *p, float dt, int n) {\n  #pragma omp parallel for schedule(static) if(n >= 128)\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/* Both blocks receive their contributions in increasing partner order. */\nstatic void force_off_diagonal(const Body *p, Force *f,\n                               int first, int last,\n                               int other_first, int other_last) {\n  for (int i = first; i < last; ++i) {\n    float fx = f[i].x;\n    float fy = f[i].y;\n    float fz = f[i].z;\n    float xi = p[i].x;\n    float yi = p[i].y;\n    float zi = p[i].z;\n\n    for (int j = other_first; j < other_last; ++j) {\n      float dx = p[j].x - xi;\n      float dy = p[j].y - yi;\n      float dz = p[j].z - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n\n      float reverse_dx = xi - p[j].x;\n      float reverse_dy = yi - p[j].y;\n      float reverse_dz = zi - p[j].z;\n      f[j].x += reverse_dx * inv_dist3;\n      f[j].y += reverse_dy * inv_dist3;\n      f[j].z += reverse_dz * inv_dist3;\n    }\n\n    f[i].x = fx;\n    f[i].y = fy;\n    f[i].z = fz;\n  }\n}\n\n/* Full diagonal tiles retain self interactions and the original order. */\nstatic void force_diagonal(const Body *p, Force *f, int first, int last) {\n  for (int i = first; i < last; ++i) {\n    float fx = f[i].x;\n    float fy = f[i].y;\n    float fz = f[i].z;\n\n    for (int j = first; j < last; ++j) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    f[i].x = fx;\n    f[i].y = fy;\n    f[i].z = fz;\n  }\n}\n\n/*\n * Columns of symmetric tiles are assigned cyclically to the team.\n * A completion counter hands each force block to its next column.\n */\nvoid body_force(Body *p, float dt, int n) {\n  if (n <= 0) return;\n\n  int blocks = n / FORCE_TILE + (n % FORCE_TILE != 0);\n  int max_threads = 1;\n#ifdef _OPENMP\n  max_threads = omp_get_max_threads();\n#endif\n  if (blocks / 4 < max_threads) {\n    body_force_rows(p, dt, n);\n    return;\n  }\n\n  /* Nonfinite coordinates use independent reference-order rows. */\n  for (int i = 0; i < n; ++i) {\n    if (!isfinite(p[i].x) || !isfinite(p[i].y) || !isfinite(p[i].z)) {\n      body_force_rows(p, dt, n);\n      return;\n    }\n  }\n\n  void *force_storage = malloc((size_t)n * sizeof(Force) + 63u);\n  ForceProgress *progress = malloc((size_t)blocks * sizeof(*progress));\n  if (force_storage == NULL || progress == NULL) {\n    free(force_storage);\n    free(progress);\n    body_force_rows(p, dt, n);\n    return;\n  }\n  Force *forces = (Force *)(((uintptr_t)force_storage + 63u) & ~(uintptr_t)63u);\n\n  #pragma omp parallel\n  {\n    int thread = 0;\n    int threads = 1;\n#ifdef _OPENMP\n    thread = omp_get_thread_num();\n    threads = omp_get_num_threads();\n#endif\n\n    #pragma omp for schedule(static)\n    for (int block = 0; block < blocks; ++block) {\n      int first = block * FORCE_TILE;\n      int last = n - first < FORCE_TILE ? n : first + FORCE_TILE;\n      for (int i = first; i < last; ++i) {\n        forces[i].x = 0.0f;\n        forces[i].y = 0.0f;\n        forces[i].z = 0.0f;\n      }\n      progress[block].completed = 0;\n    }\n\n    for (int column = thread; column < blocks; column += threads) {\n      int other_first = column * FORCE_TILE;\n      int other_last = n - other_first < FORCE_TILE\n                     ? n : other_first + FORCE_TILE;\n\n      for (int row = 0; row < column; ++row) {\n        int completed;\n        do {\n          #pragma omp atomic read seq_cst\n          completed = progress[row].completed;\n        } while (completed < column);\n\n        int first = row * FORCE_TILE;\n        int last = n - first < FORCE_TILE ? n : first + FORCE_TILE;\n        force_off_diagonal(p, forces, first, last, other_first, other_last);\n\n        #pragma omp atomic write seq_cst\n        progress[row].completed = column + 1;\n      }\n\n      force_diagonal(p, forces, other_first, other_last);\n      #pragma omp atomic write seq_cst\n      progress[column].completed = column + 1;\n    }\n\n    #pragma omp barrier\n    #pragma omp for schedule(static)\n    for (int i = 0; i < n; ++i) {\n      p[i].vx += dt*forces[i].x;\n      p[i].vy += dt*forces[i].y;\n      p[i].vz += dt*forces[i].z;\n    }\n  }\n\n  free(progress);\n  free(force_storage);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Statically pipelined symmetric force tiles can nearly halve square-root evaluations while avoiding task overhead and per-wavefront barriers.",
  "notes": "Preserves ascending-j accumulation, self interactions, double-precision sqrt/division, and binary I/O. Uses call-local scratch and respects the configured OpenMP team. Not executed.",

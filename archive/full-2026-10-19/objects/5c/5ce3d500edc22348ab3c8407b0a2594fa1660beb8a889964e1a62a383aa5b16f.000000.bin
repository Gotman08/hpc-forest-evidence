      "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\n#if defined(__aarch64__) || defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nnamespace {\nconstexpr std::uint32_t MOD = 1000000007U;\n\ninline void advance_diagonal(std::uint32_t* dp, int first, int last) {\n    int j = last;\n#if defined(__aarch64__) || defined(__ARM_NEON)\n    const uint32x4_t modulus = vdupq_n_u32(MOD);\n    for (; j >= first + 3; j -= 4) {\n        const int base = j - 3;\n        // Both loads precede the store; descending blocks preserve old values.\n        const uint32x4_t up = vld1q_u32(dp + base);\n        const uint32x4_t left = vld1q_u32(dp + base - 1);\n        const uint32x4_t sum = vaddq_u32(up, left);\n        // Every sum is below 2*MOD, so unsigned min reduces it exactly.\n        const uint32x4_t reduced =\n            vminq_u32(sum, vsubq_u32(sum, modulus));\n        vst1q_u32(dp + base, reduced);\n    }\n#endif\n    for (; j >= first; --j) {\n        std::uint32_t value = dp[j] + dp[j - 1];\n        if (value >= MOD) value -= MOD;\n        dp[j] = value;\n    }\n}\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n, m;\n    if (!(std::cin >> n >> m)) return 0;\n\n    std::vector<std::vector<int>> blocked(2 * n - 1);\n    bool endpoint_blocked = false;\n    for (int c = 0; c < m; ++c) {\n        int row, column;\n        std::cin >> row >> column;\n        blocked[row + column].push_back(column + 1);\n        if ((row == 0 && column == 0) ||\n            (row == n - 1 && column == n - 1)) {\n            endpoint_blocked = true;\n        }\n    }\n\n    if (endpoint_blocked) {\n        std::cout << 0 << '\\n';\n        return 0;\n    }\n\n    // Shift columns by one, leaving dp[0] as a permanent zero boundary.\n    std::vector<std::uint32_t> dp(n + 1, 0);\n    dp[1] = 1;\n\n    for (int diagonal = 1; diagonal < 2 * n - 1; ++diagonal) {\n        const int first = std::max(0, diagonal - n + 1) + 1;\n        const int last = std::min(n - 1, diagonal) + 1;\n        advance_diagonal(dp.data(), first, last);\n        // Cells on the same diagonal cannot depend on one another.\n        for (int column : blocked[diagonal]) dp[column] = 0;\n    }\n\n    std::cout << dp[n] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Anti-diagonal traversal removes the horizontal flow dependency, enabling legal four-lane NEON updates while eliminating row copies and per-cell obstacle tests.",

      "content": "#include <bits/stdc++.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\nint A[1000][1000];\nint ps[1010][1010];\n\ntypedef long long ll;\n\nll solve(int m, int n, int k) {\n  const ll pair_count = static_cast<ll>(n) * (n + 1) / 2;\n  ll ans = 0;\n\n#ifdef _OPENMP\n#pragma omp parallel if (static_cast<ll>(m) * pair_count >= 32768) reduction(+:ans)\n#endif\n  {\n#ifdef _OPENMP\n#pragma omp for schedule(static)\n#endif\n    for (int i = 1; i <= m; i++) {\n      ps[i][0] = 0;\n      for (int j = 1; j <= n; j++) {\n        ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\n      }\n    }\n\n    int thread_id = 0;\n    int thread_count = 1;\n#ifdef _OPENMP\n    thread_id = omp_get_thread_num();\n    thread_count = omp_get_num_threads();\n#endif\n\n    const ll first_pair = pair_count * thread_id / thread_count;\n    const ll last_pair = pair_count * (thread_id + 1) / thread_count;\n\n    // Decode the first pair in this worker's contiguous triangular range.\n    int j = 1;\n    ll offset = first_pair;\n    while (j <= n && offset >= n - j + 1) {\n      offset -= n - j + 1;\n      ++j;\n    }\n    int l = j + static_cast<int>(offset);\n\n    unordered_map<ll, ll> h;\n    for (ll pair = first_pair; pair < last_pair; ++pair) {\n      h.clear();\n      h[0] = 1;\n      ll s = 0;\n      for (int i = 1; i <= m; i++) {\n        s += ps[i][l] - ps[i][j - 1];\n        ans += h.find(s - k) != h.end() ? h[s - k] : 0;\n        h[s]++;\n      }\n\n      ++l;\n      if (l > n) {\n        ++j;\n        l = j;\n      }\n    }\n  }\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n  memset(ps, 0, sizeof ps);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n",
      "path": "src/main.cpp"
    }
  ],
  "hypothesis": "Evenly distributing independent column intervals across the configured OpenMP team should accelerate counting without synchronization inside the hash loop.",

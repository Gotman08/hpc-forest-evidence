def test_lane_syntax_refuses_fifth_worker_and_non_integer_claims(count):
    with pytest.raises(ValueError):
        ctx.validate_lane({"active_native_workers_before_start": count, "maximum_native_workers": 4})


def test_old_cap2_scope_source_plan_and_expectation_schema_refused():
    for field, value in {"schema": "hpc-forest-primes-r2b-astra-audit-expectation-v1",
        "scope_id": "hpc-forest-primes-native-max-r2b",
        "source_zip_sha256": "1a1dde5f1de6b3e3f062e3984c57c6327f714a7570b41e5734371bcda291e33b",
        "plan_sha256": "000323615fbb6fd602c3f69d1bcd20b46d22ab631400300f3e9068dcf151fc3f"}.items():
        data = identity()
        data[field] = value
        with pytest.raises(ValueError):
            ctx.validate_identity(data)
    with pytest.raises(ValueError):
        ctx.validate_lane({"active_native_workers_before_start": 1, "maximum_native_workers": 2})

{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include <bits/stdc++.h>\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\nusing namespace std;\\n\\nint A[1000][1000];\\nint ps[1010][1010];\\n\\ntypedef long long ll;\\n\\nclass PrefixFrequency {\\n  struct Slot {\\n    int32_t key;\\n    uint32_t frequency;\\n  };\\n\\n  vector<Slot> slots;\\n  vector<uint32_t> touched;\\n  uint32_t mask;\\n\\n  static uint32_t hash_key(int32_t key) {\\n    uint32_t x = static_cast<uint32_t>(key);\\n    x ^= x >> 16;\\n    x *= 0x7feb352dU;\\n    x ^= x >> 15;\\n    x *= 0x846ca68bU;\\n    x ^= x >> 16;\\n    return x;\\n  }\\n\\npublic:\\n  explicit PrefixFrequency(int scan_length) {\\n    uint32_t entries = static_cast<uint32_t>(scan_length) + 1;\\n    uint32_t capacity = 1;\\n    while (capacity < 2U * entries)\\n      capacity <<= 1;\\n    slots.resize(capacity);\\n    touched.reserve(entries);\\n    mask = capacity - 1;\\n  }\\n\\n  void clear() {\\n    for (uint32_t index : touched)\\n      slots[index].frequency = 0;\\n    touched.clear();\\n  }\\n\\n  uint32_t get(int32_t key) const {\\n    uint32_t index = hash_key(key) & mask;\\n    while (slots[index].frequency != 0) {\\n      if (slots[index].key == key)\\n        return slots[index].frequency;\\n      index = (index + 1) & mask;\\n    }\\n    return 0;\\n  }\\n\\n  void increment(int32_t key) {\\n    uint32_t index = hash_key(key) & mask;\\n    while (slots[index].frequency != 0) {\\n      if (slots[index].key == key) {\\n        ++slots[index].frequency;\\n        return;\\n      }\\n      index = (index + 1) & mask;\\n    }\\n    slots[index].key = key;\\n    slots[index].frequency = 1;\\n    touched.push_back(index);\\n  }\\n};\\n\\nstatic int available_workers() {\\n  int workers = 4;\\n#ifdef _OPENMP\\n  workers = min(workers, omp_get_max_threads());\\n#else\\n  const unsigned hardware = thread::hardware_concurrency();\\n  if (hardware != 0)\\n    workers = min(workers, static_cast<int>(min(hardware, 4U)));\\n  for (const char *name : {\\\"OMP_NUM_THREADS\\\", \\\"OMP_THREAD_LIMIT\\\"}) {\\n    const char *value = getenv(name);\\n    if (value != nullptr) {\\n      char *end = nullptr;\\n      const long requested = strtol(value, &end, 10);\\n      if (end != value && requested > 0 && requested < workers)\\n        workers = static_cast<int>(requested);\\n    }\\n  }\\n#endif\\n  return max(workers, 1);\\n}\\n\\nll solve(int m, int n, int k) {\\n  for (int i = 1; i <= m; i++) {\\n    for (int j = 1; j <= n; j++) {\\n      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\\n    }\\n  }\\n\\n  const auto count_bands = [&](int first, int stride) -> ll {\\n    PrefixFrequency h(m);\\n    ll subtotal = 0;\\n    for (int j = first; j <= n; j += stride) {\\n      for (int l = j; l <= n; l++) {\\n        h.clear();\\n        h.increment(0);\\n        ll s = 0;\\n        for (int i = 1; i <= m; i++) {\\n          s += ps[i][l] - ps[i][j - 1];\\n          subtotal += h.get(static_cast<int32_t>(s - k));\\n          h.increment(static_cast<int32_t>(s));\\n        }\\n      }\\n    }\\n    return subtotal;\\n  };\\n\\n  const ll estimated_work = ll(m) * n * (n + 1) / 2;\\n  int workers = 1;\\n  if (estimated_work >= 131072LL)\\n    workers = min(n, available_workers());\\n  if (workers == 1)\\n    return count_bands(1, 1);\\n\\n  ll ans = 0;\\n#ifdef _OPENMP\\n#pragma omp parallel num_threads(workers) reduction(+:ans)\\n  {\\n    ans += count_bands(omp_get_thread_num() + 1, omp_get_num_threads());\\n  }\\n#else\\n  array<ll, 4> partials{};\\n  array<thread, 3> threads;\\n  for (int t = 1; t < workers; t++) {\\n    threads[t - 1] = thread([&, t]() {\\n      partials[t] = count_bands(t + 1, workers);\\n    });\\n  }\\n  partials[0] = count_bands(1, workers);\\n  for (int t = 1; t < workers; t++)\\n    threads[t - 1].join();\\n  for (int t = 0; t < workers; t++)\\n    ans += partials[t];\\n#endif\\n  return ans;\\n}\\n\\nint main() {\\n  int k, m, n;\\n  cin >> k >> m >> n;\\n  memset(A, 0, sizeof A);\\n  memset(ps, 0, sizeof ps);\\n\\n  for (int i = 0; i < m; i++)\\n    for (int j = 0; j < n; j++)\\n      cin >> A[i][j];\\n\\n  cout << solve(m, n, k) << endl;\\n  return 0;\\n}\\n\",\n      \"path\": \"src/main.cpp\"\n    }\n  ],\n  \"hypothesis\": \"Combining compact hashing with cyclic band parallelism may improve whole-program performance beyond either archived transformation alone.\",\n  \"notes\": \"This bounded integration leaves the prefix layout and I/O unchanged. Legal input bounds keep hash keys within int32_t; totals remain 64-bit. No commands or measurements were run.\",\n  \"research\": {\n    \"queries\": [],\n    \"urls\": []\n  },\n  \"sources_kept\": [\n    \"ee5199465a9f4b23\",\n    \"1e468278ec7b4072\"\n  ],\n  \"transformations\": [\n    \"Replace unordered_map with reusable 8-byte linear-probing slots at no more than 50% occupancy, clearing only touched slots.\",\n    \"Assign start-column bands cyclically across at most four workers, each owning its frequency table and 64-bit subtotal.\",\n    \"Retain the serial path below 131072 estimated row visits and preserve zero-prefix initialization and query-before-increment ordering.\"\n  ]\n}"}}

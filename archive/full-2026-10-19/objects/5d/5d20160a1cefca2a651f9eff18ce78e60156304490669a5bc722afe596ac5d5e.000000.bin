"""Build a local proposal from exact R1 lineage; never submits, installs or runs a model."""
from __future__ import annotations

import hashlib
import json
import sys
import tarfile
import zipfile
from datetime import datetime, timezone
from pathlib import Path

BASE = Path(__file__).resolve().parents[2]
WORK = Path(__file__).resolve().parent
PROJECT = WORK / "project"
OUT = BASE / "outputs/HPC-Forest-Primes-Natif-MAX-r1"
R1 = BASE / "work/marathon-archive-mother-r1/project"
R1ZIP = BASE / "outputs/HPC-Forest-Etude-2020-2024-r1/HPC-Forest-Archives-Modele-Mere-r1.zip"
PREP = BASE / "outputs/HPC-Forest-Primes-Max-Certifie-r1"
SEALED = OUT / "certified-preparation"
sys.path.insert(0, str(PROJECT / "src"))
from hpc_forest import native_r2max as native
from hpc_forest.primes_contract import COMPILER_FLAGS, verify_preparation


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def ref(path):
    return {"path": str(path.resolve()), "sha256": sha(path)}


def write(name, data):
    path = OUT / name
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf8")
    return path


def main():
    assert sha(R1ZIP) == "cd769d474b6cb14c2fba11ab687f8825d35cb0b57a397d09aefab0ae743ffc18"
    with zipfile.ZipFile(R1ZIP) as archive:
        initial = {name.removeprefix("HPC-Forest/"): archive.read(name) for name in archive.namelist()}
    assert len(initial) == 90 and all((R1 / name).read_bytes() == data for name, data in initial.items())
    verify_preparation(SEALED)
    private = SEALED / "data/private-audit-fixtures"
    assert all(p.read_bytes() == (PREP / "private-audit-fixtures" / p.relative_to(private)).read_bytes()
               for p in private.rglob("*") if p.is_file())
    files = {p.relative_to(PROJECT).as_posix(): p for p in PROJECT.rglob("*") if p.is_file()
             and not any(part in {"__pycache__", ".ruff_cache", ".pytest_cache"} for part in p.parts)}
    changes = [{"path": name, "r1_sha256": hashlib.sha256(raw).hexdigest(), "r2_sha256": sha(files[name])}
               for name, raw in initial.items() if files[name].read_bytes() != raw]
    additions = [{"path": name, "sha256": sha(path)} for name, path in files.items() if name not in initial]
    source = OUT / "HPC-Forest-Primes-Natif-MAX-r1.zip"
    if source.exists():
        raise RuntimeError("Preserve the first proposal; use a new revision after review")
    with zipfile.ZipFile(source, "w", compression=zipfile.ZIP_DEFLATED) as archive:
        for name, path in sorted(files.items()):
            item = zipfile.ZipInfo("HPC-Forest/" + name, date_time=(1980, 1, 1, 0, 0, 0))
            item.compress_type = zipfile.ZIP_DEFLATED
            item.external_attr = (0o100644 << 16)
            archive.writestr(item, path.read_bytes())
    native.verify_runtime(source)
    write("runtime-manifest-r2max.json", {name: sha(path) for name, path in sorted(files.items())})
    write("diff-source-r1-r2max.json", {"r1_verified_files": 90, "changed_r1_files": changes,
                                       "new_r2_files": additions, "unchanged_r1_files": 90-len(changes)})
    original_plan = json.loads((PREP / "plan-quatre-max.json").read_text(encoding="utf8"))
    plan = {"schema": "hpc-forest-primes-native-max-plan-v1", "scope_id": native.SCOPE,
            "created_utc": datetime.now(timezone.utc).isoformat(), "status": "local_proposal_not_native_admitted",
            "source_zip_sha256": sha(source), "r1_source_zip_sha256": sha(R1ZIP),
            "preparation_manifest_sha256": native.PREPARATION_MANIFEST_SHA256,
            "preparation_review_sha256": sha(OUT / "preparation-review-original.json"),
            "first_launch_model": native.MODEL, "first_launch_effort": native.EFFORT,
            "first_launch_session_id": native.SESSION, "automatic_extension": False,
            "projected_cells": original_plan["cells"], "efforts": ["max"],
            "models_implemented_for_first_launch": [native.MODEL],
            "other_model_cells_remain_projected_not_admitted": True,
            "first_start_before_other_models": True, "native_model_calls": 0,
            "jobs_submitted_by_this_proposal": 0, "old_candidates_imported": False,
            "operator_algorithm_advice": False, "compiler_flags": COMPILER_FLAGS,
            "search_case_count": 6, "search_variant": 0, "confirmation_case_count": 6,
            "confirmation_variant": 1, "benchmark_origin_private": "p30-v0",
            "benchmark_chosen_before_timing": True, "calibration": False,
            "reference_measured_fresh_in_native_allocation": True,
            "qualification_timings_imported": False,
            "case_count_bounds_generic_unchanged": [1, 8], "maximum_program_missions": 8,
            "maximum_mother_calls": 2, "maximum_depth": 6, "search_seconds_ceiling": 1800,
            "tokens_ceiling": 1500000, "shared_harness_generation_seconds": 600,
            "confirmation_seconds": 120, "search_repetitions": 3, "final_confirmations": 5,
            "minimum_gain_fraction": 0.03, "seed": 23, "maximum_native_workers_total": 2,
            "exclusive_deadline_utc": "2026-10-31T23:00:00Z", "research_allocation_proposed_seconds": 10800,
            "reception_audit_reserve_seconds": 10800,
            "hardware_or_process_isolation_proved": False,
            "model_visibility": {"allowed": ["unchanged official C", "official statement", "reviewed finite contract and resource facts", "closed structured diagnostics"],
                                 "forbidden": ["private fixtures", "certified expected outputs", "certificates", "preparer", "operator audit reports", "raw stdout/stderr"]},
            "required_admission_artifacts": sorted(native.ARTIFACTS),
            "qualification_final_contract_required": True,
            "mechanical_qualification_751926_does_not_prove_final_flags": True}
    plan_path = write("native-max-plan.json", plan)
    schemas = {"authorization": {"type": "object", "additionalProperties": False,
                "required": sorted(native.AUTHORIZATION_FIELDS), "properties": {name: {} for name in sorted(native.AUTHORIZATION_FIELDS)}},
               "proofs": {key: {"schema_id": schema, "type": "object", "additionalProperties": False,
                                  "required": ["schema", "scope_id", "verified", "source_zip_sha256", "plan_sha256", "preparation_manifest_sha256"],
                                  "properties": {name: {} for name in sorted(native.COMMON_PROOF_FIELDS | native.PROOF_FIELDS[key])}}
                          for key, schema in native.SCHEMAS.items()},
               "artifact_reference": {"type": "object", "additionalProperties": False, "required": ["path", "sha256"],
                                      "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
    write("schemas-recus-r2max.json", schemas)
    refs = {"source_zip": ref(source), "plan": ref(plan_path),
            "preparation_manifest": ref(SEALED / "prototype-manifest.json"),
            "preparation_review": ref(OUT / "preparation-review-original.json")}
    for key, schema in native.SCHEMAS.items():
        item = {"schema": schema, "scope_id": native.SCOPE, "verified": False,
                "source_zip_sha256": sha(source), "plan_sha256": sha(plan_path),
                "preparation_manifest_sha256": native.PREPARATION_MANIFEST_SHA256}
        path = write("admissions-exemples-non-verifies/" + key + ".json", item)
        refs[key] = ref(path)
    auth = {"schema": "hpc-forest-primes-r2max-authorization-v1", "scope_id": native.SCOPE,
            "model": native.MODEL, "effort": "max", "session_id": native.SESSION,
            "verified": False, "expires_at": 0, "user_messages": [], "old_candidates_imported": False,
            "operator_algorithm_advice": False, "native_calls_started_at_authorization": 0,
            "job_id": "PENDING_REAL_SUBMISSION", "remote_root": "/PENDING/" + native.SCOPE + "-" + native.SESSION,
            "artifacts": refs}
    template = write("authorization-non-verifiee.json", auth)
    try:
        native.validate_receipt(template, {native.SCOPE}, prepared=False)
    except Exception:
        pass
    else:
        raise RuntimeError("An unverified template must never authorize a native call")
    mechanical = PREP / "qualification-arm64-r1/reception-751926/AUDIT-RECEPTION.json"
    write("preservation-verifiee.json", {"schema": "hpc-forest-primes-r2max-preservation-v1",
          "r1_source_zip": ref(R1ZIP), "r1_original_files_verified_after": 90,
          "r1_original_files_all_bytes_unchanged": True, "certified_private_files_verified": 36,
          "certified_private_files_all_bytes_unchanged": True,
          "preparation_manifest": ref(PREP / "prototype-manifest.json"),
          "preparation_prototype_zip": ref(PREP / "prototype-primes-certifie-r1.zip"),
          "preparation_original_review": ref(PREP / "REVUE-INDEPENDANTE-FINALE.json"),
          "mechanical_751926_operator_audit_reference_only": ref(mechanical) if mechanical.is_file() else None,
          "source_zip_new": ref(source), "plan_new": ref(plan_path), "source_members": len(files),
          "python_neutral_tests": 79, "deselected_real_execution_tests": 4,
          "local_c_compilations_or_candidate_executions": 0, "model_cli_app_server_or_socket_calls": 0,
          "romeo_calls": 0, "jobs_submitted": 0, "installations": 0, "native_admitted": False})
    command = OUT / "QUALIFICATION-ET-DEMARRAGE.md"
    command.write_text("""# Commandes proposées, aucune n'est exécutée par cette livraison

La qualification finale requiert une allocation Linux ARM64 dédiée : un nœud, une tâche, exactement quatre CPU dans l'affinité effective, 16384 MiB, zéro GPU. Le Python et les dépendances doivent déjà exister. Cette voie ne contient aucun sbatch ni installation. Après restauration du ZIP source (racine HPC-Forest), le chemin des modules et celui des scripts frères sont ajoutés explicitement ; -I est conservé.

```sh
/CHEMIN/PYTHON-EXISTANT -I -B /PAQUET/HPC-Forest/examples/marathon22/qualify_r2max_contract.py --package /PAQUET/certified-preparation --output /RECEPTION-NEUVE/qualification-finale --source-zip /PAQUET/HPC-Forest-Primes-Natif-MAX-r1.zip --plan /PAQUET/native-max-plan.json
```

Le script compile seulement le C officiel inchangé avec les vrais deux flags Werror, matérialise les mêmes 12 jeux et compare les sorties exactes. Il conserve son premier refus, ne rejoue rien, puis produit qualification.json et une archive privée qualification-finale.tar.gz avec son reçu SHA. L'opérateur doit recevoir, restaurer et auditer cette archive avant de créer allocated_contract_reception et son audit lié. Une archive ou un booléen auto-déclaré ne suffit pas : le gate relit les membres C/ELF/commande/contrat/12cas à partir des véritables fichiers archivés.

Pour un lancement natif admis plus tard, l'autorisation/transport doit nommer le vrai job_id. Le wrapper peut attendre au plus 600 s l'upload POSTÉRIEUR à la soumission du job : authorization.json puis un marqueur authorization-ready.json atomique, lié SHA/octets/job/session/scope. Aucun canal, compilateur ou modèle ne démarre pendant cette attente. Une autorisation invalide reçue échoue sans retry.

```sh
/CHEMIN/PYTHON-EXISTANT -I -B /PAQUET/HPC-Forest/examples/marathon22/wait_r2max_authorization.py --root /SCRATCH/hpc-forest-primes-native-max-r1-c8044062692149138d826d3f388a08ef --authorization /ADMISSION-POST-SUBMIT/authorization.json --authorization-ready /ADMISSION-POST-SUBMIT/authorization-ready.json --wait-seconds 300
```

Marqueur attendu : schema=hpc-forest-primes-r2max-authorization-upload-ready-v1 ; scope_id=hpc-forest-primes-native-max-r1 ; session_id=c8044062692149138d826d3f388a08ef ; job_id numérique réel ; sha256 et bytes de authorization.json. Aucun marqueur positif n'est fourni ici.

Le worker local dédié utilise uniquement hpc_forest.r2max_worker et le CLI déjà figé, après admission de source/plan/CLI/transport/voie. Ne pas employer matrix_worker, native_matrix, archive_preparation.text_input ou un ancien coordonnateur pour cette voie.

```powershell
& C:/CHEMIN/Python-existant.exe -B -m hpc_forest.r2max_worker --dependency-receipt C:/ADMISSION-LOCALE/authorization.json --required-jobs hpc-forest-primes-native-max-r1 --session-id c8044062692149138d826d3f388a08ef --executable C:/CLI-FIGE/codex.exe --channel /SCRATCH/hpc-forest-primes-native-max-r1-c8044062692149138d826d3f388a08ef/results-JOB_REEL/mailbox --output C:/RELAIS-NEUF --codex-config C:/CONFIG-EXISTANTE.toml --max-seconds 10800
```

Ce sont des chemins d'exemple non utilisables tels quels. Fournir PYTHONPATH vers le src de la nouvelle copie dans le seul environnement enfant, sans réglage global. Le worker prepared=False ne cherche jamais le répertoire Linux de qualification sur Windows : il vérifie cependant l'archive réelle reçue, l'audit réel et leurs SHA. Le runner prepared=True vérifie en plus l'inventaire Linux direct. Les reçus d'autorisation par environnement portent les MÊMES SHA source/plan/préparation/qualification ; leurs refs path sont des chemins absolus RÉELS dans cet environnement. Les refs archive/audit de allocated_contract_reception doivent aussi être réelles localement ; recopier les octets d'audit, d'archive et de qualification sans les réécrire. Ne pas transformer un chemin Windows en chemin Linux dans le JSON de qualification scellé : ses chemins originaux POSIX lient la commande compilateur ; utiliser des nouveaux reçus de portée propres pour les références par environnement.
""", encoding="utf8")
    resume = OUT / "REPRISE.md"
    resume.write_text(f"""# R2 primes natif MAX — proposition locale isolée

État : implémentation dérivée livrée, 79 tests Python neutres passent, Ruff passe. Quatre tests d'exécution réelle exclus volontairement. Aucun modèle, CLI, app-server, socket, ROMEO, job, installation, compilation C ou exécution de candidat n'a été effectué par cette production. Aucun lancement natif n'est admis par ce paquet.

Source R1 vérifiée avant ET après : 90 fichiers contre le ZIP cd769d474b6cb14c2fba11ab687f8825d35cb0b57a397d09aefab0ae743ffc18. Le nouveau ZIP source a {len(files)} membres ; SHA {sha(source)}. Plan neuf SHA {sha(plan_path)}. Voir diff-source-r1-r2max.json : {len(changes)} fichiers R1 modifiés seulement dans la copie dérivée, {len(additions)} modules/tests/scripts nouveaux. Les manifests FILES/BASELINE conservés dans la source sont les preuves historiques R1 ; runtime-manifest-r2max.json désigne la nouvelle copie. R1, préparation certifiée et workers vivants restent intacts.

Le runner ne sélectionne que Luna MAX, mère/enfants identiques, session réservée c8044062692149138d826d3f388a08ef, jamais démarrée ici. Les trois autres modèles restent projetés dans le plan ; aucune boucle ni extension automatique ne les lance. Les budgets R1 conservés sont des plafonds : huit missions, deux mères, profondeur six, 1800 s, 1,5 M jetons, trois tentatives partageant 600 s, trois mesures et cinq confirmations. Aucun coût natif n'a été consommé par ces préparatifs.

Contrat privé : mêmes douze entrées/certificats/attendus immuables, six v0 pour recherche, six v1 pour confirmation ; noms génériques 1..6 dans chaque phase, ensemble exact et unicité vérifiés. Le mécanisme générique 1..8 reste inchangé. Benchmark explicite p30-v0 parmi les douze, sans calibration. La qualification finale applique contracts.validate_contract/materialize/prepare, GCC -O2 -std=c11 -Werror=uninitialized -Werror=maybe-uninitialized -lm, et compare octet pour octet les 12 sorties à celles certifiées. L'origine première et la contradiction de l'exemple officiel restent conservées ; aucune validité générale sur tout le concours n'est revendiquée.

La mécanique ARM64 751926 reçue par le parent est une preuve distincte (-O2/-std=c11/-lm), pas une qualification de ce contrat final ou de ses deux Werror. La future qualification finale de cette source/ce plan reste requise, puis sa réception/archive/restauration/audit réel. Le 10e artifact allocated_contract_reception impose l'archive et l'audit liés SHA. Un stub verified=true ou la simple déclaration d'un inventaire ne suffit plus : la commande réelle, le C, le checker privé corrigé, le contrat 6+6, les 12 bytes attendus et l'ELF AArch64 sont relus dans les fichiers réels.

Dans l'allocation NATIVE ultérieure, la préparation du C officiel et ses mêmes 12 cas est refaite avant le canal/modèle, avec un reçu runtime-reference-origin lié au job courant. Aucun temps de la qualification antérieure n'est importé. Le contrôleur remesure aussi sa baseline dans cette même allocation avant les appels normaux.

Confidentialité corrigée dans la seule dérivée : contracts.execute garde stdout/stderr candidat bruts hors trusted dans private-audit/executions ; build_source garde ses bruts dans le build. Les ContractError d'exécution/compilation et le main standalone ne réémettent plus ces bruts. NodeHarness et observations projettent uniquement statut/code/case/retour typés et métriques typées, jamais entrées, sorties, stderr, chemins de logs ou texte libre. Les négatifs neutres testent aussi un candidat simulé qui réimprime son entrée privée et échoue, le timeout, le checker autonome et le contexte de la tentative suivante. Tous les bruts restent dans les preuves privées de réception, jamais dans le contexte modèle. Cette séparation et les outils CLI désactivés ne démontrent aucune isolation matérielle ou processus complète.

Le premier démarrage réel doit fournir premier-demarrage-verifie.json : identité worker/CLI/source/plan/allocation, premier appel normal livré, usage exact, journaux d'erreurs et première évaluation réelle liée. Un candidat incorrect/build_failed reste un résultat négatif conservé ; aucune réparation opérateur ni replay. Un duplicate ou une sortie de modèle malformée connue peut laisser ce reçu en attente pendant les missions Luna déjà budgétées. Une panne/interface/invocation inconnue bloque immédiatement. Si le budget se clôt sans évaluation réelle, clôture connue limitée, sans admission d'extension. Le reçu reste verified=false. Les autres modèles exigent une nouvelle admission après la revue du vrai premier démarrage ; ce runner ne les implémente pas.

Les dix refs d'autorisation sont fermées par schemas-recus-r2max.json et native_r2max.py ; les exemples fournis sont tous verified=false et refusés. Toute autorisation réelle devra lier nouvelle source/plan, manifeste/revue préparatoire, qualification finale allouée ET réception auditée, transport pré-appel zéro inférence, CLI figé, voie libre parmi deux workers et revue d'intégration. Le vrai job est lié après submit via l'attente bornée documentée. Aucune route secondaire positive, autorisation, upload ni lancement n'est fourni ici. Aucun ancien census n'est importé.

Consulter QUALIFICATION-ET-DEMARRAGE.md pour les commandes proposées et les chemins absolus Windows/Linux. L'opérateur doit recontrôler le quota deux workers et la réserve temporelle stricte avant le 31 octobre 2026 23:00 UTC après toute attente. Les SHA et inventaires de preservation-verifiee.json distinguent les preuves livrées de toutes ces étapes encore à recevoir.
""", encoding="utf8")
    # A proposal bundle contains private audit data and must never be supplied as model context.
    bundle = OUT / "hpc-forest-primes-native-max-r1-proposition.tar.gz"
    selected = [source, plan_path, OUT / "runtime-manifest-r2max.json", OUT / "schemas-recus-r2max.json",
                OUT / "preparation-review-original.json", OUT / "authorization-non-verifiee.json", command, resume,
                OUT / "diff-source-r1-r2max.json", OUT / "preservation-verifiee.json", OUT / "tests-r6.log", OUT / "ruff-final.log"]
    selected += [p for p in SEALED.rglob("*") if p.is_file()]
    selected += [p for p in (OUT / "admissions-exemples-non-verifies").rglob("*") if p.is_file()]
    bundle_files = {p.relative_to(OUT).as_posix(): sha(p) for p in selected}
    manifest_path = write("proposal-bundle-manifest.json", {"schema": "hpc-forest-r2max-proposal-bundle-manifest-v1",
                        "private_audit_only_never_model_context": True, "files": bundle_files})
    with tarfile.open(bundle, "w:gz") as archive:
        for path in sorted([*selected, manifest_path]):
            archive.add(path, arcname=native.SCOPE + "/" + path.relative_to(OUT).as_posix())
    with tarfile.open(bundle, "r:gz") as archive:
        restored = {member.name.removeprefix(native.SCOPE + "/"): archive.extractfile(member).read()
                    for member in archive.getmembers()}
    assert set(restored) == set(bundle_files) | {manifest_path.name}
    assert all(hashlib.sha256(restored[name]).hexdigest() == value for name, value in bundle_files.items())
    receipt = {"schema": "hpc-forest-primes-r2max-local-proposal-delivery-v1", "status": "proposed_not_native_admitted",
               "source_zip": ref(source), "plan": ref(plan_path), "bundle": ref(bundle),
               "bundle_manifest": ref(manifest_path), "bundle_regular_members_verified": len(restored),
               "source_files_verified": len(files), "neutral_python_tests_passed": 79,
               "ruff": "passed", "local_c_or_cli_or_model_or_romeo_executions": 0,
               "jobs_submitted": 0, "native_research_admitted": False, "unverified_template_rejected": True}
    write("LIVRAISON-LOCALE.json", receipt)
    print(json.dumps(receipt, ensure_ascii=True))


if __name__ == "__main__":
    main()

#include "knn.h"
#include <limits.h>

static char choose_label(const int * frequencies) {
    char best_label = (char)-1;
    int best_count = 0;

    for (int value = CHAR_MIN; value <= CHAR_MAX; ++value) {
        int count = frequencies[(unsigned char)(char)value];
        if (count > best_count) {
            best_count = count;
            best_label = (char)value;
        }
    }

    return best_label;
}

static char insertion_selection(int n_groups, Group * groups, int k,
                                Point to_evaluate) {
    char * labels = (char *) malloc(sizeof(char) * k);
    float * distances = (float *) malloc(sizeof(float) * k);

    for (int i = 0; i < k; ++i) {
        labels[i] = (char)-1;
        distances[i] = -1;
    }

    for (int i = 0; i < n_groups; ++i) {
        Group g = groups[i];

        for (int j = 0; j < g.length; ++j) {
            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);

            for (int x = 0; x < k; ++x) {
                if (d < distances[x] || distances[x] == -1) {
                    for (int y = k - 1; y > x; --y) {
                        distances[y] = distances[y - 1];
                        labels[y] = labels[y - 1];
                    }

                    distances[x] = d;
                    labels[x] = g.label;
                    break;
                }
            }
        }
    }

    int frequencies[UCHAR_MAX + 1] = {0};
    for (int i = 0; i < k; ++i) {
        ++frequencies[(unsigned char)labels[i]];
    }

    free(distances);
    free(labels);
    return choose_label(frequencies);
}

static void sift_down(float * heap, size_t count, size_t root) {
    float value = heap[root];

    while (root < count / 2) {
        size_t child = root * 2 + 1;
        if (child + 1 < count && heap[child] < heap[child + 1]) {
            ++child;
        }

        if (!(value < heap[child])) {
            break;
        }

        heap[root] = heap[child];
        root = child;
    }

    heap[root] = value;
}

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    if (k <= 0) {
        return (char)-1;
    }

    size_t capacity = (size_t)k;
    float * heap = (float *) malloc(sizeof(float) * capacity);
    size_t used = 0;

    for (int i = 0; i < n_groups; ++i) {
        Group g = groups[i];

        for (int j = 0; j < g.length; ++j) {
            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);

            if (d != d) {
                free(heap);
                return insertion_selection(n_groups, groups, k, to_evaluate);
            }

            if (used < capacity) {
                heap[used++] = d;

                if (used == capacity) {
                    for (size_t parent = used / 2; parent > 0; --parent) {
                        sift_down(heap, used, parent - 1);
                    }
                }
            } else if (d < heap[0]) {
                heap[0] = d;
                sift_down(heap, used, 0);
            }
        }
    }

    float cutoff = 0.0f;
    size_t tied_slots = 0;

    if (used == capacity) {
        cutoff = heap[0];
        for (size_t i = 0; i < used; ++i) {
            if (heap[i] == cutoff) {
                ++tied_slots;
            }
        }
    }

    free(heap);

    int frequencies[UCHAR_MAX + 1] = {0};

    if (used < capacity) {
        for (int i = 0; i < n_groups; ++i) {
            if (groups[i].length > 0) {
                frequencies[(unsigned char)groups[i].label] += groups[i].length;
            }
        }
        frequencies[(unsigned char)((char)-1)] += (int)(capacity - used);
    } else {
        for (int i = 0; i < n_groups; ++i) {
            Group g = groups[i];
            int group_votes = 0;

            for (int j = 0; j < g.length; ++j) {
                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);

                if (d < cutoff) {
                    ++group_votes;
                } else if (d == cutoff && tied_slots > 0) {
                    ++group_votes;
                    --tied_slots;
                }
            }

            frequencies[(unsigned char)g.label] += group_votes;
        }
    }

    return choose_label(frequencies);
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

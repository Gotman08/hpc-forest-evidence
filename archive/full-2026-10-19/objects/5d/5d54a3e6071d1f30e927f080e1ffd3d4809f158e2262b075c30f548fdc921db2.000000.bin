      "content": "#include <cassert>\n#include <cstddef>\n#include <cstdio>\n#include <limits>\n#include <memory>\n#include <vector>\n\nclass FastInput {\n    char buffer_[65536];\n    std::size_t position_;\n    std::size_t length_;\n\n    int nextChar() {\n        if (position_ == length_) {\n            length_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (length_ == 0) return EOF;\n        }\n        return static_cast<unsigned char>(buffer_[position_++]);\n    }\n\npublic:\n    FastInput() : position_(0), length_(0) {}\n\n    bool readInt(int& result) {\n        int c;\n        do {\n            c = nextChar();\n            if (c == EOF) return false;\n        } while (c <= ' ');\n\n        bool negative = false;\n        if (c == '-' || c == '+') {\n            negative = (c == '-');\n            c = nextChar();\n        }\n\n        long long value = 0;\n        while (c >= '0' && c <= '9') {\n            value = value * 10 + (c - '0');\n            c = nextChar();\n        }\n        result = static_cast<int>(negative ? -value : value);\n        return true;\n    }\n};\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.readInt(n) || !input.readInt(s)) return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const int width = n - s + 1;\n    std::vector<int> row(n);\n    std::vector<long long> vertical(width, 0);\n    std::unique_ptr<long long[]> history(\n        new long long[static_cast<std::size_t>(s) * width]);\n\n    long long best = std::numeric_limits<long long>::lowest();\n    int slot = 0;\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j) input.readInt(row[j]);\n\n        long long horizontal = 0;\n        for (int j = 0; j < s; ++j) horizontal += row[j];\n\n        long long* previous = history.get()\n            + static_cast<std::size_t>(slot) * width;\n\n        if (i < s) {\n            for (int j = 0; j < width; ++j) {\n                if (j != 0) {\n                    horizontal += static_cast<long long>(row[j + s - 1])\n                                  - row[j - 1];\n                }\n                vertical[j] += horizontal;\n                previous[j] = horizontal;\n            }\n            if (i == s - 1) {\n                for (int j = 0; j < width; ++j) {\n                    if (vertical[j] > best) best = vertical[j];\n                }\n            }\n        } else {\n            for (int j = 0; j < width; ++j) {\n                if (j != 0) {\n                    horizontal += static_cast<long long>(row[j + s - 1])\n                                  - row[j - 1];\n                }\n                const long long sum = vertical[j] + horizontal - previous[j];\n                vertical[j] = sum;\n                previous[j] = horizontal;\n                if (sum > best) best = sum;\n            }\n        }\n\n        if (++slot == s) slot = 0;\n    }\n\n    std::printf(\"%lld\\n\", best);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

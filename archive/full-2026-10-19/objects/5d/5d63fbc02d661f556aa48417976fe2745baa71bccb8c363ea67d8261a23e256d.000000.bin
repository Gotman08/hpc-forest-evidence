        "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\nusing namespace std;\n\nstatic const uint32_t MOD = 1000000007u;\n\n#if defined(__aarch64__)\nstatic inline uint32x4_t add_mod4(uint32x4_t a, uint32x4_t b,\n                                uint32x4_t modulus) {\n    // Both inputs are below MOD, so the addition cannot overflow.\n    const uint32x4_t sum = vaddq_u32(a, b);\n    return vminq_u32(sum, vsubq_u32(sum, modulus));\n}\n#endif\n\nstatic inline void scan_open_span(uint32_t* dp, int begin, int end) {\n    // Every span begins at the left boundary or immediately after an obstacle.\n    uint32_t carry = 0;\n\n#if defined(__aarch64__)\n    const uint32x4_t zero = vdupq_n_u32(0);\n    const uint32x4_t modulus = vdupq_n_u32(MOD);\n    uint32x4_t carried = zero;\n\n    for (; end - begin >= 4; begin += 4) {\n        uint32x4_t values = vld1q_u32(dp + begin);\n\n        // Form local inclusive prefixes before introducing the incoming carry.\n        values = add_mod4(values, vextq_u32(zero, values, 3), modulus);\n        values = add_mod4(values, vextq_u32(zero, values, 2), modulus);\n        values = add_mod4(values, carried, modulus);\n\n        vst1q_u32(dp + begin, values);\n        carried = vdupq_laneq_u32(values, 3);\n    }\n    carry = vgetq_lane_u32(carried, 0);\n#endif\n\n    for (; begin < end; ++begin) {\n        carry += dp[begin];\n        if (carry >= MOD) carry -= MOD;\n        dp[begin] = carry;\n    }\n}\n\nint main() {\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n\n    vector<vector<int> > blocked_columns(n);\n    for (int c = 0; c < m; ++c) {\n        int row, column;\n        cin >> row >> column;\n        blocked_columns[row].push_back(column);\n    }\n\n    vector<uint32_t> dp(n, 0);\n    // A virtual incoming path seeds the origin; a blocked origin clears it.\n    dp[0] = 1;\n\n    for (int row = 0; row < n; ++row) {\n        vector<int>& columns = blocked_columns[row];\n        sort(columns.begin(), columns.end());\n\n        int begin = 0;\n        for (int column : columns) {\n            // Repeated coordinates describe the same blocked cell.\n            if (column < begin) continue;\n            scan_open_span(dp.data(), begin, column);\n            dp[column] = 0;\n            begin = column + 1;\n        }\n        scan_open_span(dp.data(), begin, n);\n    }\n\n    cout << dp[n - 1] << endl;\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }
    ],
    "hypothesis": "Obstacle-delimited NEON prefix scans can shorten the row dependency chain and remove per-cell bitmap accesses and remainder operations while preserving exact modular counts.",

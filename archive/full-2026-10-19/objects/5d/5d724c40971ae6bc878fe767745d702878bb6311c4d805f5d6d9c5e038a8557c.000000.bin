        "content": "/*\n  Quicksort\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <limits.h>\n#include <string.h>\n#include <openssl/md5.h>\n\n\n/*\n * Prototypes\n */\nvoid srandnum(int seed);\ndouble randnum(void);\nint *generate_case(int N);\ndouble drand(int xmin, int xmax);\nvoid swap(int *toorder, int i, int j);\nint partition(int *toorder, int lo, int hi);\nvoid _quicksort(int *toorder, int lo, int hi);\nvoid quicksort(int *toorder, int N);\nint is_sorted(int *toorder, int N);\n\n/*\n * A generic pRNG\n */\n#define MY_RAND_MAX 0x7FFFFFFF\n\n#define RANDNUM_W 521288629\n#define RANDNUM_Z 362436069\n\nunsigned int randum_w = RANDNUM_W;\nunsigned int randum_z = RANDNUM_Z;\n\nvoid srandnum(int seed)\n{\n    unsigned int w, z;\n    w = (seed * 104623) & 0xffffffff;\n    randum_w = (w) ? w : RANDNUM_W;\n    z = (seed * 48947) & 0xffffffff;\n    randum_z = (z) ? z : RANDNUM_Z;\n}\n\ndouble randnum(void)\n{\n    unsigned int u;\n    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);\n    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);\n    u = (randum_z << 16) + randum_w;\n    return (abs(u));\n}\n\n/*\n * Main function\n */\nint main(int argc, char *argv[])\n{\n    int N = 0;\n    int *our_list = NULL;\n\n    //The input provides the case size\n\tscanf(\"%d\", &N);\n    if (N <= 0) {\n\tprintf(\"Error: please, provide the case size.\\n\");\n\treturn 1;\n    }\n\n    //Generate the case\n    our_list = generate_case(N);\n    if (our_list == NULL) {\n\tprintf(\"Error: case instantiation failed.\\n\");\n\treturn 1;\n    }\n\n    //Do the thing\n    quicksort(our_list, N);\n\n    if (is_sorted(our_list, N) == 1) {\n\tprintf(\"Error, for some reason list is still unsorted.\\n\");\n\treturn 1;\n    }\n\n#ifdef COMPUTE_MD5_PROBLEM\n    //Compute MD5 Checksum for problem identification\n    MD5_CTX c;\n    unsigned char out[MD5_DIGEST_LENGTH];\n    MD5_Init(&c);\n    MD5_Update(&c, our_list, N * sizeof(int));\n    MD5_Final(out, &c);\n    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {\n\tprintf(\"%02x\", out[n]);\n    }\n#endif\n    printf(\"\\n\");\n\n    //Clean up\n    free(our_list);\n\n    return 0;\n}\n\n/*\n * Small-input and allocation-free sorting helpers.\n */\nstatic void radix_insertion_sort(int *toorder, int N)\n{\n    for (int i = 1; i < N; ++i) {\n        int value = toorder[i];\n        int j = i;\n        while (j > 0 && toorder[j - 1] > value) {\n            toorder[j] = toorder[j - 1];\n            --j;\n        }\n        toorder[j] = value;\n    }\n}\n\nstatic void radix_sift_down(int *toorder, int root, int N)\n{\n    int value = toorder[root];\n    while (root < N / 2) {\n        int child = root * 2 + 1;\n        if (child + 1 < N && toorder[child] < toorder[child + 1]) {\n            ++child;\n        }\n        if (value >= toorder[child]) {\n            break;\n        }\n        toorder[root] = toorder[child];\n        root = child;\n    }\n    toorder[root] = value;\n}\n\nstatic void radix_heap_sort(int *toorder, int N)\n{\n    for (int i = N / 2; i > 0; --i) {\n        radix_sift_down(toorder, i - 1, N);\n    }\n    for (int end = N - 1; end > 0; --end) {\n        swap(toorder, 0, end);\n        radix_sift_down(toorder, 0, end);\n    }\n}\n\n/*\n * Public API: cache-local LSD radix sorting for native 32-bit integers.\n */\nvoid quicksort(int *toorder, int N)\n{\n    if (N < 2) {\n        return;\n    }\n    if (N <= 64) {\n        radix_insertion_sort(toorder, N);\n        return;\n    }\n\n#if UINT_MAX == 0xffffffffU && INT_MAX == 2147483647\n    unsigned int histogram[4][256] = {{0}};\n    const unsigned int length = (unsigned int)N;\n    const unsigned int first_key = (unsigned int)toorder[0] ^ 0x80000000U;\n    unsigned int active_passes = 0;\n\n    /* Gather all digit counts with one sequential read of the input. */\n    for (int i = 0; i < N; ++i) {\n        unsigned int key = (unsigned int)toorder[i] ^ 0x80000000U;\n        ++histogram[0][key & 255U];\n        ++histogram[1][(key >> 8) & 255U];\n        ++histogram[2][(key >> 16) & 255U];\n        ++histogram[3][key >> 24];\n    }\n\n    /* Skip a digit only when its histogram proves it is constant. */\n    for (unsigned int pass = 0; pass < 4; ++pass) {\n        unsigned int digit = (first_key >> (pass * 8)) & 255U;\n        if (histogram[pass][digit] != length) {\n            active_passes |= 1U << pass;\n        }\n    }\n    if (active_passes == 0) {\n        return;\n    }\n\n    int *scratch;\n    if ((size_t)N > (size_t)-1 / sizeof(*scratch)) {\n        radix_heap_sort(toorder, N);\n        return;\n    }\n    scratch = (int *)malloc((size_t)N * sizeof(*scratch));\n    if (scratch == NULL) {\n        radix_heap_sort(toorder, N);\n        return;\n    }\n\n    int *src = toorder;\n    int *dst = scratch;\n    for (unsigned int pass = 0; pass < 4; ++pass) {\n        if ((active_passes & (1U << pass)) == 0) {\n            continue;\n        }\n\n        unsigned int *offsets = histogram[pass];\n        unsigned int offset = 0;\n        for (unsigned int digit = 0; digit < 256; ++digit) {\n            unsigned int count = offsets[digit];\n            offsets[digit] = offset;\n            offset += count;\n        }\n\n        unsigned int shift = pass * 8;\n        for (int i = 0; i < N; ++i) {\n            int value = src[i];\n            unsigned int key = (unsigned int)value ^ 0x80000000U;\n            unsigned int digit = (key >> shift) & 255U;\n            dst[offsets[digit]++] = value;\n        }\n\n        int *temp = src;\n        src = dst;\n        dst = temp;\n    }\n\n    /* Four active passes already finish in the caller's array. */\n    if (src != toorder) {\n        memcpy(toorder, src, (size_t)N * sizeof(*toorder));\n    }\n    free(scratch);\n#else\n    radix_heap_sort(toorder, N);\n#endif\n}\n\n/*\n * Internal recursive function to quicksort\n */\nvoid _quicksort(int *toorder, int lo, int hi)\n{\n    if (lo >= hi)\n\treturn;\n    int b = partition(toorder, lo, hi);\n    _quicksort(toorder, lo, b - 1);\n    _quicksort(toorder, b + 1, hi);\n}\n\n/*\n * Swap two values.\n */\nvoid swap(int *toorder, int i, int j)\n{\n    int temp = toorder[i];\n    toorder[i] = toorder[j];\n    toorder[j] = temp;\n}\n\n/*\n * Partition decision\n */\nint partition(int *toorder, int lo, int hi)\n{\n    int b = lo;\n    int r = (int) (lo + (hi - lo) * (randnum() / MY_RAND_MAX));\n    int pivot = toorder[r];\n    swap(toorder, r, hi);\n    for (int i = lo; i < hi; i++) {\n\tif (toorder[i] < pivot) {\n\t    swap(toorder, i, b);\n\t    b++;\n\t}\n    }\n    swap(toorder, hi, b);\n    return b;\n}\n\n/*\n * Check if elements are in non-decreasing order\n */\nint is_sorted(int *toorder, int N)\n{\n    for (int i = 1; i < N; i++) {\n\tif (toorder[i] < toorder[i - 1]) {\n\t    return 1;\n\t}\n    }\n    return 0;\n}\n\n\n/*\n * Generate a case\n */\nint *generate_case(int N)\n{\n    int i;\n    int *ret = NULL;\n\n    // Make case generation reproducible\n    srandnum(0);\n\n    // Allocate memory\n    ret = (int *) malloc(N * sizeof(int));\n    if (ret == NULL) {\n\tprintf(\"Error: some malloc won't work.\\n\");\n\treturn NULL;\n    }\n    // Get pseudo-random positive integer values\n    for (i = 0; i < N; i++) {\n\tret[i] = drand(0, INT_MAX);\n    }\n    return ret;\n}\n\n/*\n * A pseudo-random number between two positive integer values\n */\ndouble drand(int xmin, int xmax)\n{\n    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;\n}\n",

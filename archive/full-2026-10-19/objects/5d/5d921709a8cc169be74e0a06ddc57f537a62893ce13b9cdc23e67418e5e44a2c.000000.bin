#include <cassert>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <limits>
#include <memory>
#include <vector>

class FastInput {
    static constexpr std::size_t buffer_size = 1u << 16;
    unsigned char buffer_[buffer_size];
    std::size_t position_ = 0;
    std::size_t length_ = 0;

    int nextChar() {
        if (position_ == length_) {
            length_ = std::fread(buffer_, 1, buffer_size, stdin);
            position_ = 0;
            if (length_ == 0) return EOF;
        }
        return buffer_[position_++];
    }

public:
    bool readInt(int& result) {
        int c;
        do {
            c = nextChar();
        } while (c != EOF && c <= ' ');
        if (c == EOF) return false;

        const bool negative = c == '-';
        if (c == '-' || c == '+') c = nextChar();
        std::int64_t value = 0;
        while (c >= '0' && c <= '9') {
            value = value * 10 + (c - '0');
            c = nextChar();
        }
        result = static_cast<int>(negative ? -value : value);
        return true;
    }
};

int main() {
    FastInput input;
    int n, s;
    if (!input.readInt(n) || !input.readInt(s)) return 0;

    assert(n > 0);
    assert(n < 8000);
    assert(s > 0);
    assert(s < n);

    const std::size_t width = static_cast<std::size_t>(n);
    std::unique_ptr<int[]> rows(new int[width * static_cast<std::size_t>(s)]);
    std::vector<std::int64_t> column_sums(width, 0);
    std::int64_t best = std::numeric_limits<std::int64_t>::lowest();
    int ring_row = 0;

    for (int row = 0; row < n; ++row) {
        int* slot = rows.get() + static_cast<std::size_t>(ring_row) * width;
        if (row < s) {
            for (int col = 0; col < n; ++col) {
                int value;
                if (!input.readInt(value)) return 0;
                slot[col] = value;
                column_sums[col] += static_cast<std::int64_t>(value);
            }
        } else {
            for (int col = 0; col < n; ++col) {
                int value;
                if (!input.readInt(value)) return 0;
                column_sums[col] += static_cast<std::int64_t>(value)
                                  - static_cast<std::int64_t>(slot[col]);
                slot[col] = value;
            }
        }

        if (row + 1 >= s) {
            std::int64_t window_sum = 0;
            for (int col = 0; col < s; ++col) {
                window_sum += column_sums[col];
            }
            if (window_sum > best) best = window_sum;
            for (int col = s; col < n; ++col) {
                window_sum += column_sums[col] - column_sums[col - s];
                if (window_sum > best) best = window_sum;
            }
        }

        if (++ring_row == s) ring_row = 0;
    }

    std::printf("%lld\n", static_cast<long long>(best));
    return 0;
}

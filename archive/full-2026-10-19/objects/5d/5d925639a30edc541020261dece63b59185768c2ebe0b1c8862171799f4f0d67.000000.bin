#!/usr/bin/env bash
# Prepared single cell; ROOT reviews and consumes one MCP plan only.
set -euo pipefail
romeo_load_armgpu_env
spack load /zrtbeqke25s2vbqo4yrhsowjz7mg3pjf
[[ -x /scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python ]] || { echo 'Exact ARM Python missing' >&2; exit 70; }
[[ -d /gpfs/scratch/nimarano/hpc-forest-matrix15-native-max-20261019-root-01-shared && ! -L /gpfs/scratch/nimarano/hpc-forest-matrix15-native-max-20261019-root-01-shared ]] || { echo 'Existing shared375 required' >&2; exit 71; }
[[ ! -e /gpfs/scratch/nimarano/hpc-forest-matrix15-native-max-r2-32212eb983d54451b53b37c4f5b6d694 && ! -L /gpfs/scratch/nimarano/hpc-forest-matrix15-native-max-r2-32212eb983d54451b53b37c4f5b6d694 ]] || { echo 'Scientific root exists; no replay' >&2; exit 72; }
[[ ! -e /gpfs/scratch/nimarano/hpc-forest-matrix15-native-max-r2-32212eb983d54451b53b37c4f5b6d694-admission && ! -L /gpfs/scratch/nimarano/hpc-forest-matrix15-native-max-r2-32212eb983d54451b53b37c4f5b6d694-admission ]] || { echo 'Admission root exists; no replay' >&2; exit 73; }
[[ ! -e /gpfs/scratch/nimarano/hpc-forest-matrix15-native-max-r2-32212eb983d54451b53b37c4f5b6d694-bootstrap-pycache-must-remain-absent && ! -L /gpfs/scratch/nimarano/hpc-forest-matrix15-native-max-r2-32212eb983d54451b53b37c4f5b6d694-bootstrap-pycache-must-remain-absent ]] || { echo 'Fresh absent pycache prefix required' >&2; exit 74; }
command -v timeout >/dev/null
command -v sha256sum >/dev/null
cd -- /gpfs/scratch/nimarano/hpc-forest-matrix15-native-max-r2-32212eb983d54451b53b37c4f5b6d694-bootstrap-inputs
printf '%s  %s\n' 7b98650d74afdd902ac0466b8459656c21fbfabc23dbf3be1015285b108f51eb bootstrap_extension.py e8e8ee7e69ccced5d15054f1a61f3970e0019a282e7c20f8cdbc4db77aa9eb30 extension_gate.py 37b69ac7d5f064c96b283b48221bdc7e2ee2b8045f2bfdf6f9827b978aa938a4 INPUT-BOOTSTRAP.json | sha256sum --check --strict
export PYTHONPYCACHEPREFIX=/gpfs/scratch/nimarano/hpc-forest-matrix15-native-max-r2-32212eb983d54451b53b37c4f5b6d694-bootstrap-pycache-must-remain-absent
export PYTHONDONTWRITEBYTECODE=1
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=4
export OMP_DYNAMIC=FALSE
export OMP_PROC_BIND=TRUE
export CUDA_VISIBLE_DEVICES=''
srun --nodes=1 --ntasks=1 --cpus-per-task=4 --mem=16G --cpu-bind=cores env OMP_NUM_THREADS=4 OMP_DYNAMIC=FALSE OMP_PROC_BIND=TRUE CUDA_VISIBLE_DEVICES= PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 timeout --signal=TERM --kill-after=10s 3310s /scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python -I -B /gpfs/scratch/nimarano/hpc-forest-matrix15-native-max-r2-32212eb983d54451b53b37c4f5b6d694-bootstrap-inputs/bootstrap_extension.py --input /gpfs/scratch/nimarano/hpc-forest-matrix15-native-max-r2-32212eb983d54451b53b37c4f5b6d694-bootstrap-inputs/INPUT-BOOTSTRAP.json --input-sha256 37b69ac7d5f064c96b283b48221bdc7e2ee2b8045f2bfdf6f9827b978aa938a4

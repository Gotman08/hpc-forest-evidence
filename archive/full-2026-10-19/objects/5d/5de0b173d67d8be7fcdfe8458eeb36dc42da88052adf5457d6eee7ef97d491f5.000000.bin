#include <cstdio>
#include <cstdlib>

struct FastScanner {
    static const int BUFSIZE = 1 << 20;
    int idx, size;
    char buf[BUFSIZE];
    FastScanner() : idx(0), size(0) {}
    inline char getChar() {
        if (idx >= size) {
            size = fread(buf, 1, BUFSIZE, stdin);
            idx = 0;
            if (size == 0) return '\0';
        }
        return buf[idx++];
    }
    int nextInt() {
        char c;
        do { c = getChar(); } while (c <= ' ' && c);
        int sign = 1;
        if (c == '-') { sign = -1; c = getChar(); }
        long long x = 0;
        for (; c >= '0' && c <= '9'; c = getChar()) {
            x = x * 10 + (c - '0');
        }
        return static_cast<int>(sign * x);
    }
};

static inline long long maxWindow(const long long* __restrict col, int n, int s) {
    long long cur = 0;
    const long long* p = col;
    for (int i = 0; i < s; ++i) cur += *p++;
    long long mx = cur;
    const long long* add = col + s;
    const long long* sub = col;
    int j = s;
    // Unroll by 4 to expose ILP and reduce loop overhead.
    for (; j + 3 < n; j += 4, add += 4, sub += 4) {
        cur += add[0] - sub[0];
        if (cur > mx) mx = cur;
        cur += add[1] - sub[1];
        if (cur > mx) mx = cur;
        cur += add[2] - sub[2];
        if (cur > mx) mx = cur;
        cur += add[3] - sub[3];
        if (cur > mx) mx = cur;
    }
    for (; j < n; ++j, ++add, ++sub) {
        cur += *add - *sub;
        if (cur > mx) mx = cur;
    }
    return mx;
}

int main() {
    FastScanner fs;
    int n = fs.nextInt();
    int s = fs.nextInt();

    // Cache-line aligned allocations for better vectorization and fewer conflicts.
    void* colMem = nullptr;
    void* rowsMem = nullptr;
    if (posix_memalign(&colMem, 64, sizeof(long long) * n) != 0) return 1;
    if (posix_memalign(&rowsMem, 64, sizeof(int) * (size_t)s * n) != 0) {
        free(colMem);
        return 1;
    }
    long long* colSum = static_cast<long long*>(colMem);
    int* rows = static_cast<int*>(rowsMem);

    for (int i = 0; i < n; ++i) colSum[i] = 0;

    // Initial S rows: fill ring buffer and column sums.
    for (int r = 0; r < s; ++r) {
        int* row = rows + (size_t)r * n;
        int c = 0;
        // Unrolled by 4 to reduce loop overhead and expose ILP.
        for (; c + 3 < n; c += 4) {
            int v0 = fs.nextInt(), v1 = fs.nextInt(), v2 = fs.nextInt(), v3 = fs.nextInt();
            row[c] = v0; colSum[c] += static_cast<long long>(v0);
            row[c+1] = v1; colSum[c+1] += static_cast<long long>(v1);
            row[c+2] = v2; colSum[c+2] += static_cast<long long>(v2);
            row[c+3] = v3; colSum[c+3] += static_cast<long long>(v3);
        }
        for (; c < n; ++c) {
            int v = fs.nextInt();
            row[c] = v;
            colSum[c] += static_cast<long long>(v);
        }
    }

    long long mx = maxWindow(colSum, n, s);

    // Slide the vertical window one row at a time.
    int slot = 0;
    for (int r = s; r < n; ++r) {
        int* row = rows + (size_t)slot * n;
        int c = 0;
        // Unrolled update: read old values, new values, and update colSum.
        for (; c + 3 < n; c += 4) {
            int old0 = row[c], old1 = row[c+1], old2 = row[c+2], old3 = row[c+3];
            int v0 = fs.nextInt(), v1 = fs.nextInt(), v2 = fs.nextInt(), v3 = fs.nextInt();
            row[c] = v0; colSum[c] += static_cast<long long>(v0) - static_cast<long long>(old0);
            row[c+1] = v1; colSum[c+1] += static_cast<long long>(v1) - static_cast<long long>(old1);
            row[c+2] = v2; colSum[c+2] += static_cast<long long>(v2) - static_cast<long long>(old2);
            row[c+3] = v3; colSum[c+3] += static_cast<long long>(v3) - static_cast<long long>(old3);
        }
        for (; c < n; ++c) {
            int old = row[c];
            int v = fs.nextInt();
            row[c] = v;
            colSum[c] += static_cast<long long>(v) - static_cast<long long>(old);
        }

        long long curMax = maxWindow(colSum, n, s);
        if (curMax > mx) mx = curMax;

        ++slot;
        if (slot == s) slot = 0;
    }

    printf("%lld\n", static_cast<long long>(mx));

    free(rowsMem);
    free(colMem);
    return 0;
}

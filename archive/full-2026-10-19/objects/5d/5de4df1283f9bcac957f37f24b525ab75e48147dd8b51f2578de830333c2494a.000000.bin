#include "knn.h"

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    char * labels = (char *) malloc(sizeof(char) * k);
    float * distances = (float *) malloc(sizeof(float) * k);

    int i, j, x, y;

#pragma omp parallel for num_threads(4)
    for (i = 0; i < k; i++) {
        labels[i] = -1;
        distances[i] = -1;
    }

    for (i = 0; i < n_groups; i++) {
        Group g = groups[i];

#pragma omp parallel for num_threads(4) private(j, x, y)
        for (j = 0; j < g.length; j++) {
            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);

            int inserted = 0;
#pragma omp critical
            for (x = 0; x < k && !inserted; x++) {
                if (d < distances[x] || distances[x] == -1) {
                    for (y = k - 1; y > x; y--) {
                        distances[y] = distances[y - 1];
                        labels[y] = labels[y - 1];
                    }

                    distances[x] = d;
                    labels[x] = g.label;

                    inserted = 1;
                }
            }
        }
    }

    qsort(labels, k, sizeof(char), compare_for_sort);

    int frequency[256] = {0};
#pragma omp parallel for num_threads(4) reduction(+:frequency)
    for (i = 0; i < k; i++) {
        #pragma omp atomic
        frequency[(unsigned char)labels[i]]++;
    }

    char most_frequent = labels[0];
    int most_frequent_count = frequency[(unsigned char)most_frequent];

    for (i = 1; i < k; i++) {
        if (frequency[(unsigned char)labels[i]] > most_frequent_count) {
            most_frequent = labels[i];
            most_frequent_count = frequency[(unsigned char)most_frequent];
        }
    }

    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}
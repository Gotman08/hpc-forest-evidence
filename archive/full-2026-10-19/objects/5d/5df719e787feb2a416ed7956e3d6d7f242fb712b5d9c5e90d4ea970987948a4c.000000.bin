        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Replacing nested vector<bool> rows with a contiguous byte matrix makes each verification row a direct, cache-local load on ARM64; cached loop/popcount signatures cheaply reject only impossible graph or mapping candidates.",
        "id": "e32012c029044dec",
        "ordinal": 1,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/brute_isomorphism.cpp"
          ],
          "retained": [
            "Use a flat row-major unsigned-char adjacency layout and hoist mapped row pointers in the lower-triangle verification loop.",
            "Cache row-popcount plus diagonal signatures during graph ingestion, using their histogram and per-mapping checks only as sound early rejections."
          ]
        },
        "tree_id": "e1:A",

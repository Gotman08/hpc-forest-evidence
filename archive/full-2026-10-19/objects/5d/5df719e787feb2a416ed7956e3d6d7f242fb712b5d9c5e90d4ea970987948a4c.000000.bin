    {
      "id": "7f573a426fd446e9",
      "role": "B",
      "mission": {
        "base_commit": "1bb45633c1cff32af1cefbc8e6d3d79baf3149e1",
        "delegation_parent": "R/B",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "A contiguous byte matrix removes vector<bool> proxy dependencies, enabling vectorized invariant reductions and making a bounded color-domain uniqueness search cheaper than repeated triangular scans.",
        "id": "7f573a426fd446e9",
        "ordinal": 1,
        "parent_id": null,
        "role": "B",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/brute_isomorphism.cpp"
          ],
          "retained": [
            "Replace nested vector<bool> storage with contiguous byte rows and use a legal independent row-sum reduction.",
            "Apply color-refined candidate domains with incremental edge and nonedge checks to prove zero or one mapping under a fixed search budget.",
            "For ambiguous cases, retain Heap permutation order while checking only the smaller equal-cardinality edge or nonedge relation set."
          ]
        },
        "tree_id": "e1:B",
        "trial_id": "01M52QP2S8Q4E6W7G0T62NEWME",

        "content": "#include <algorithm>\n#include <cstddef>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nusing std::uint32_t;\n\nstatic const uint32_t MOD = 1000000007u;\n\nstruct WavefrontState {\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    uint32x4_t lanes;\n\n    WavefrontState() : lanes(vdupq_n_u32(0)) {}\n\n    void step(uint32_t top) {\n        const uint32x4_t above =\n            vextq_u32(vdupq_n_u32(top), lanes, 3);\n        const uint32x4_t sum = vaddq_u32(lanes, above);\n        lanes = vminq_u32(sum, vsubq_u32(sum, vdupq_n_u32(MOD)));\n    }\n\n    void block(unsigned mask) {\n        const uint32_t bits[4] = {1u, 2u, 4u, 8u};\n        const uint32x4_t blocked =\n            vtstq_u32(vdupq_n_u32(mask), vld1q_u32(bits));\n        lanes = vbicq_u32(lanes, blocked);\n    }\n\n    template<int Lane>\n    uint32_t get() const {\n        return vgetq_lane_u32(lanes, Lane);\n    }\n#else\n    uint32_t lanes[4];\n\n    WavefrontState() : lanes{0, 0, 0, 0} {}\n\n    static uint32_t add(uint32_t a, uint32_t b) {\n        const uint32_t sum = a + b;\n        return sum >= MOD ? sum - MOD : sum;\n    }\n\n    void step(uint32_t top) {\n        lanes[3] = add(lanes[3], lanes[2]);\n        lanes[2] = add(lanes[2], lanes[1]);\n        lanes[1] = add(lanes[1], lanes[0]);\n        lanes[0] = add(lanes[0], top);\n    }\n\n    void block(unsigned mask) {\n        for (unsigned r = 0; r < 4; ++r) {\n            if (mask & (1u << r)) lanes[r] = 0;\n        }\n    }\n\n    template<int Lane>\n    uint32_t get() const {\n        return lanes[Lane];\n    }\n#endif\n};\n\ntemplate<int Rows>\nstatic void sweep(uint32_t* dp, int n,\n                  const std::vector<uint32_t>& events) {\n    WavefrontState state;\n    std::size_t next = 0;\n    int t = 0;\n    const int end = n + Rows - 1;\n\n    // Lane r processes column t-r. Both predecessors are from step t-1.\n    while (t < end) {\n        int stop = end;\n        unsigned mask = 0;\n        if (next < events.size()) {\n            stop = static_cast<int>(events[next] >> 2);\n            do {\n                mask |= 1u << (events[next] & 3u);\n                ++next;\n            } while (next < events.size() &&\n                     static_cast<int>(events[next] >> 2) == stop);\n        }\n\n        for (; t < stop; ++t) {\n            state.step(dp[t]);\n            dp[t - (Rows - 1)] = state.get<Rows - 1>();\n        }\n\n        if (t == end) break;\n        state.step(dp[t]);\n        state.block(mask);\n        dp[t - (Rows - 1)] = state.get<Rows - 1>();\n        ++t;\n    }\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n, m;\n    if (!(std::cin >> n >> m)) return 0;\n\n    std::vector<std::vector<uint32_t>> obstacles((n + 3) / 4);\n    bool endpoint_blocked = false;\n    for (int c = 0; c < m; ++c) {\n        int y, x;\n        std::cin >> y >> x;\n        if ((y == 0 && x == 0) || (y == n - 1 && x == n - 1)) {\n            endpoint_blocked = true;\n        }\n        const unsigned lane = static_cast<unsigned>(y & 3);\n        const uint32_t diagonal = static_cast<uint32_t>(x) + lane;\n        obstacles[y / 4].push_back((diagonal << 2) | lane);\n    }\n\n    if (endpoint_blocked) {\n        std::cout << 0 << '\\n';\n        return 0;\n    }\n\n    // Prefix space absorbs startup stores; zero suffix cells drain each strip.\n    std::vector<uint32_t> storage(static_cast<std::size_t>(n) + 6, 0);\n    uint32_t* const dp = storage.data() + 3;\n    dp[0] = 1;\n\n    for (int y = 0; y < n; y += 4) {\n        std::vector<uint32_t>& events = obstacles[y / 4];\n        std::sort(events.begin(), events.end());\n        switch (std::min(4, n - y)) {\n            case 4: sweep<4>(dp, n, events); break;\n            case 3: sweep<3>(dp, n, events); break;\n            case 2: sweep<2>(dp, n, events); break;\n            case 1: sweep<1>(dp, n, events); break;\n        }\n    }\n\n    std::cout << dp[n - 1] << '\\n';\n    return 0;\n}\n",
        "path": "src/solution.cpp"

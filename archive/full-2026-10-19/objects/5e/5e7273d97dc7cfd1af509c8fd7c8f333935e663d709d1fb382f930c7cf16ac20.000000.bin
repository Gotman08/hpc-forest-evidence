    {
      "id": "612e8e8ab023416d",
      "role": "C",
      "mission": {
        "base_commit": "0e7d18c88d37a965e3d60a0cd05ed3bf464020c8",
        "delegation_parent": "R/C",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Executing small active stencil regions on one member of the persistent OpenMP team should avoid work-sharing and reduction overhead during early iterations, while static row scheduling and an OR reduction retain parallelism and the exact convergence decision once the region is large enough.",
        "id": "612e8e8ab023416d",
        "ordinal": 2,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/laplace_seq.c"
          ],
          "retained": [
            "Compute the active interior work area each iteration and use a serial single-thread sweep when it is at most 4096 cells.",
            "Keep static row work-sharing with an integer OR reduction for larger active regions, inside the existing persistent OpenMP team."
          ]
        },
        "tree_id": "e1:C",
        "trial_id": "01M51MKDNE0C3FCWQQ087RH4CS",

    {
      "id": "5598347c2b7540af",
      "role": "A",
      "mission": {
        "base_commit": "0e7d18c88d37a965e3d60a0cd05ed3bf464020c8",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Storing both Jacobi matrices as contiguous row-major arrays should improve stencil locality and remove per-row pointer indirection while leaving the existing iteration and copy behavior intact.",
        "id": "5598347c2b7540af",
        "ordinal": 2,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/laplace_seq.c"
          ],
          "retained": [
            "Replace separately allocated row-pointer matrices with two contiguous row-major allocations and use linear indices in initialization, stencil, copy, and output loops."
          ]
        },

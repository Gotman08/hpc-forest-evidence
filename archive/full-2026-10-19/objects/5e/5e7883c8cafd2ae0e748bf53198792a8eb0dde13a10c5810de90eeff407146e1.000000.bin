      "content": "#include <bits/stdc++.h>\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\nusing namespace std;\n\nint A[1000][1000];\nint ps[1010][1010];\n\ntypedef long long ll;\n\nstatic inline uint32_t prefix_hash(int value) {\n  uint32_t x = static_cast<uint32_t>(value) * 0x9e3779b1u;\n  return x ^ (x >> 16);\n}\n\n#if defined(__aarch64__)\nstatic inline unsigned lane_mask(uint32x4_t matches) {\n  const uint32x4_t weights = {1u, 2u, 4u, 8u};\n  return vaddvq_u32(vandq_u32(matches, weights));\n}\n#endif\n\nclass PrefixCounter {\n  // Valid prefix sums and query keys cannot equal INT_MIN.\n  alignas(16) int keys_[2048];\n  uint32_t counts_[2048];\n  unsigned capacity_;\n  unsigned mask_;\n\n  unsigned locate(int value, uint32_t hash) const {\n    unsigned group = hash & mask_ & ~3u;\n#if defined(__aarch64__)\n    const int32x4_t wanted = vdupq_n_s32(value);\n    const int32x4_t empty = vdupq_n_s32(INT_MIN);\n    for (;;) {\n      const int32x4_t stored = vld1q_s32(keys_ + group);\n      unsigned matches = lane_mask(vceqq_s32(stored, wanted));\n      if (matches)\n        return group + static_cast<unsigned>(__builtin_ctz(matches));\n      unsigned vacancies = lane_mask(vceqq_s32(stored, empty));\n      if (vacancies)\n        return group + static_cast<unsigned>(__builtin_ctz(vacancies));\n      group = (group + 4u) & mask_;\n    }\n#else\n    for (;;) {\n      for (unsigned lane = 0; lane < 4; ++lane) {\n        unsigned slot = group + lane;\n        if (keys_[slot] == value || keys_[slot] == INT_MIN)\n          return slot;\n      }\n      group = (group + 4u) & mask_;\n    }\n#endif\n  }\n\npublic:\n  explicit PrefixCounter(unsigned entries) : capacity_(4), mask_(3) {\n    while (capacity_ < 2u * entries)\n      capacity_ *= 2u;\n    mask_ = capacity_ - 1u;\n  }\n\n  void clear() {\n    fill_n(keys_, capacity_, INT_MIN);\n    // The initial empty prefix has hash zero.\n    keys_[0] = 0;\n    counts_[0] = 1;\n  }\n\n  uint32_t consume(int value, int target, uint32_t value_hash,\n                   uint32_t target_hash) {\n    // Both probes are read-only and may be evaluated independently.\n    unsigned update_slot = locate(value, value_hash);\n    unsigned query_slot = locate(target, target_hash);\n    uint32_t result = keys_[query_slot] == target ? counts_[query_slot] : 0u;\n\n    // Preserve query-before-increment ordering, including when k is zero.\n    if (keys_[update_slot] == INT_MIN) {\n      keys_[update_slot] = value;\n      counts_[update_slot] = 1;\n    } else {\n      ++counts_[update_slot];\n    }\n    return result;\n  }\n};\n\nll solve(int m, int n, int k) {\n  // ps[column boundary][row boundary] is a two-dimensional prefix sum.\n  for (int i = 0; i <= m; i++)\n    ps[0][i] = 0;\n  for (int j = 1; j <= n; j++) {\n    ps[j][0] = 0;\n    int column_sum = 0;\n    for (int i = 1; i <= m; i++) {\n      column_sum += A[i - 1][j - 1];\n      ps[j][i] = ps[j - 1][i] + column_sum;\n    }\n  }\n\n  PrefixCounter h(static_cast<unsigned>(m + 1));\n  ll ans = 0;\n  int band_prefix[1000];\n  uint32_t value_hash[1000];\n  uint32_t target_hash[1000];\n  for (int j = 1; j <= n; j++)\n    for (int l = j; l <= n; l++) {\n      const int *right = ps[l] + 1;\n      const int *left = ps[j - 1] + 1;\n      // Differences and unsigned hash arithmetic have no cross-row dependency.\n#pragma GCC ivdep\n      for (int i = 0; i < m; i++) {\n        int value = right[i] - left[i];\n        band_prefix[i] = value;\n        value_hash[i] = prefix_hash(value);\n        target_hash[i] = prefix_hash(value - k);\n      }\n\n      h.clear();\n      for (int i = 0; i < m; i++) {\n        int value = band_prefix[i];\n        ans += h.consume(value, value - k, value_hash[i], target_hash[i]);\n      }\n    }\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n  memset(ps, 0, sizeof ps);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n",
      "path": "src/main.cpp"
    }

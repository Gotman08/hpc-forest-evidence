{
  "src/solution.cpp": "#include <iostream>\n#include <vector>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nstatic inline int addmod(int a, int b) {\n    int s = a + b;\n    return s >= MOD ? s - MOD : s;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n    vector<vector<bool> > blockedCells(n, vector<bool>(n, false));\n    for (int c = 0; c < m; ++c) {\n        int i, j;\n        cin >> i >> j;\n        blockedCells[i][j] = true;\n    }\n    vector<int> dp(n, 0);\n    dp[0] = 1;\n    int threads = 1;\n#ifdef _OPENMP\n    if (n >= 2048) {\n        threads = omp_get_max_threads();\n        if (threads > 4) threads = 4;\n    }\n#endif\n    if (threads == 1) {\n        for (int i = 0; i < n; ++i) {\n            int left = 0;\n            for (int j = 0; j < n; ++j) {\n                left = blockedCells[i][j] ? 0 : addmod(dp[j], left);\n                dp[j] = left;\n            }\n        }\n    } else {\n        vector<int> totals(threads), firstBlocked(threads), ends(threads);\n#pragma omp parallel num_threads(threads)\n        {\n            int tid = 0, team = 1;\n#ifdef _OPENMP\n            tid = omp_get_thread_num();\n            team = omp_get_num_threads();\n#endif\n            int begin = static_cast<int>(static_cast<long long>(n) * tid / team);\n            int end = static_cast<int>(static_cast<long long>(n) * (tid + 1) / team);\n            ends[tid] = end;\n            for (int i = 0; i < n; ++i) {\n                int local = 0;\n                int first = end;\n                for (int j = begin; j < end; ++j) {\n                    if (blockedCells[i][j]) {\n                        local = 0;\n                        if (first == end) first = j;\n                    } else {\n                        local = addmod(local, dp[j]);\n                    }\n                    dp[j] = local;\n                }\n                totals[tid] = local;\n                firstBlocked[tid] = first;\n#pragma omp barrier\n                int carry = 0;\n                for (int t = 0; t < tid; ++t) {\n                    if (firstBlocked[t] < ends[t]) carry = totals[t];\n                    else carry = addmod(carry, totals[t]);\n                }\n                if (carry != 0) {\n                    for (int j = begin; j < first; ++j)\n                        dp[j] = addmod(dp[j], carry);\n                }\n#pragma omp barrier\n            }\n        }\n    }\n    cout << dp[n - 1] << '\\n';\n    return 0;\n}\n"
}

#include <cstdio>
#include <vector>
#include <algorithm>

static inline int read_int() {
    int x = 0, sgn = 1;
    char c = getchar_unlocked();
    while (c <= ' ') c = getchar_unlocked();
    if (c == '-') { sgn = -1; c = getchar_unlocked(); }
    while (c >= '0' && c <= '9') {
        x = x * 10 + (c - '0');
        c = getchar_unlocked();
    }
    return sgn * x;
}

int main() {
    int n = read_int();
    int s = read_int();

    std::vector<long long> II((n+1)*(n+1), 0);

    for (int i = 0; i < n; ++i) {
        long long hsum = 0;
        int base_curr = (i+1)*(n+1);
        int base_prev = i*(n+1);
        #pragma GCC ivdep
        for (int j = 0; j < n; ++j) {
            int v = read_int();
            hsum += v;
            II[base_curr + j + 1] = II[base_prev + j + 1] + hsum;
        }
    }

    const int B = 64;
    int mxSum = -2147483648;

    for (int i0 = 0; i0 <= n - s; i0 += B) {
        int i_end = std::min(i0 + B, n - s + 1);
        for (int j = 0; j <= n - s; ++j) {
            #pragma GCC ivdep
            for (int i = i0; i < i_end; ++i) {
                long long sub_sum = II[(i+s)*(n+1)+(j+s)]
                                  - II[i*(n+1)+(j+s)]
                                  - II[(i+s)*(n+1)+j]
                                  + II[i*(n+1)+j];
                if (sub_sum > mxSum)
                    mxSum = static_cast<int>(sub_sum);
            }
        }
    }

    printf("%d\n", mxSum);
    return 0;
}

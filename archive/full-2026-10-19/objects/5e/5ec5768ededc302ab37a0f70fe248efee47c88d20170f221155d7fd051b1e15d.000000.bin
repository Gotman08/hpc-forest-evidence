{
  "src/solution.cpp": "#include <cstddef>\n#include <cstdint>\n#include <iostream>\n#include <limits>\n#include <vector>\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n, s;\n    if (!(std::cin >> n >> s)) {\n        return 0;\n    }\n\n    const std::size_t width = static_cast<std::size_t>(n);\n    const std::size_t window_size = static_cast<std::size_t>(s);\n    const std::size_t positions = width - window_size + 1;\n\n    std::vector<int> matrix(width * width);\n    for (std::size_t row = 0; row < width; ++row) {\n        const std::size_t offset = row * width;\n        for (std::size_t col = 0; col < width; ++col) {\n            std::cin >> matrix[offset + col];\n        }\n    }\n\n    std::vector<std::int64_t> column_sums(width, 0);\n    for (std::size_t row = 0; row < window_size; ++row) {\n        const int* row_data = matrix.data() + row * width;\n        for (std::size_t col = 0; col < width; ++col) {\n            column_sums[col] += row_data[col];\n        }\n    }\n\n    std::int64_t best = std::numeric_limits<std::int64_t>::lowest();\n    for (std::size_t top = 0; top < positions; ++top) {\n        std::int64_t window_sum = 0;\n        for (std::size_t col = 0; col < width; ++col) {\n            window_sum += column_sums[col];\n            if (col >= window_size) {\n                window_sum -= column_sums[col - window_size];\n            }\n            if (col + 1 >= window_size && window_sum > best) {\n                best = window_sum;\n            }\n        }\n\n        if (top + 1 < positions) {\n            const int* outgoing = matrix.data() + top * width;\n            const int* incoming = matrix.data() + (top + window_size) * width;\n            #pragma omp simd\n            for (std::size_t col = 0; col < width; ++col) {\n                column_sums[col] +=\n                    static_cast<std::int64_t>(incoming[col]) - outgoing[col];\n            }\n        }\n    }\n\n    std::cout << best << '\\n';\n    return 0;\n}\n"
}

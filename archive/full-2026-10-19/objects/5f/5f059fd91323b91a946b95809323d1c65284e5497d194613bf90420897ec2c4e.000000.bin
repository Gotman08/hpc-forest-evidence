      "content": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nint A[1000][1000];\nint ps[1010][1010];\n\ntypedef long long ll;\n\nll solve(int m, int n, int k) {\n  const ll pair_count = (ll)n * (n + 1) / 2;\n  const ll row_work = pair_count * m;\n  const ll pairs_per_block = max(1LL, min(64LL, 4096LL / m));\n  const ll block_count = (pair_count + pairs_per_block - 1) / pairs_per_block;\n  ll ans = 0;\n\n#pragma omp parallel if(row_work >= 65536) reduction(+:ans)\n  {\n#pragma omp for schedule(static)\n    for (int i = 1; i <= m; i++) {\n      for (int j = 1; j <= n; j++) {\n        ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\n      }\n    }\n\n    unordered_map<ll, ll> h;\n#pragma omp for schedule(dynamic, 1)\n    for (ll block = 0; block < block_count; block++) {\n      const ll first = block * pairs_per_block;\n      const ll last = min(pair_count, first + pairs_per_block);\n\n      int lo = 1;\n      int hi = n;\n      while (lo < hi) {\n        const int mid = lo + (hi - lo + 1) / 2;\n        const ll before = (ll)(mid - 1) * (2LL * n - mid + 2) / 2;\n        if (before <= first)\n          lo = mid;\n        else\n          hi = mid - 1;\n      }\n      int j = lo;\n      const ll before = (ll)(j - 1) * (2LL * n - j + 2) / 2;\n      int l = j + (int)(first - before);\n\n      for (ll p = first; p < last; p++) {\n        h.clear();\n        h[0] = 1;\n        ll s = 0;\n        for (int i = 1; i <= m; i++) {\n          s += ps[i][l] - ps[i][j - 1];\n          ans += h.find(s - k) != h.end() ? h[s - k] : 0;\n          h[s]++;\n        }\n        if (++l > n) {\n          ++j;\n          l = j;\n        }\n      }\n    }\n  }\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n  memset(ps, 0, sizeof ps);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n",
      "path": "src/main.cpp"
    }

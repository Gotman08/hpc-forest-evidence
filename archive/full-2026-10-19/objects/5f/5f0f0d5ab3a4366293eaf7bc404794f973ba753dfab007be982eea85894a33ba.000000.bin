    {
      "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nnamespace {\nconstexpr int MOD = 1000000007;\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n, m;\n    if (!(std::cin >> n >> m)) return 0;\n\n    std::vector<std::vector<int>> blocked(n);\n    for (int c = 0; c < m; ++c) {\n        int row, column;\n        std::cin >> row >> column;\n        blocked[row].push_back(column);\n    }\n\n    std::vector<int> dp(n, 0);\n    dp[0] = 1;\n\n    for (int row = 0; row < n; ++row) {\n        auto& columns = blocked[row];\n        std::sort(columns.begin(), columns.end());\n        columns.erase(std::unique(columns.begin(), columns.end()), columns.end());\n\n        int begin = 0;\n        int carry = 0;\n        for (int column : columns) {\n            for (int j = begin; j < column; ++j) {\n                int sum = dp[j] + carry;\n                if (sum >= MOD) sum -= MOD;\n                dp[j] = sum;\n                carry = sum;\n            }\n            dp[column] = 0;\n            carry = 0;\n            begin = column + 1;\n        }\n\n        for (int j = begin; j < n; ++j) {\n            int sum = dp[j] + carry;\n            if (sum >= MOD) sum -= MOD;\n            dp[j] = sum;\n            carry = sum;\n        }\n    }\n\n    std::cout << dp[n - 1] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "One contiguous in-place DP row and row-grouped obstacle-free spans should reduce memory traffic and per-cell overhead enough to offset blocker sorting.",
  "notes": "Unmeasured; correctness and speed remain for controller evaluation. Handles arbitrary blocker order, duplicates, n=1, and blocked endpoints. Storage is O(n+m); sorting overhead versus bitmap storage remains an experimental tradeoff.",

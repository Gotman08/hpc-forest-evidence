#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#if defined(__aarch64__)
#include <arm_neon.h>
#endif

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

/*
 * Each body holds coordinate positions (i.e., x, y, and z) and
 * velocities (i.e., vx, vy, and vz).
 */
typedef struct { float x, y, z, vx, vy, vz; } Body;

#if defined(__aarch64__)
static inline float32x4_t inverse_cube4(float32x4_t squared) {
  const float64x2_t one = vdupq_n_f64(1.0);
  float64x2_t root_lo = vsqrtq_f64(
      vcvt_f64_f32(vget_low_f32(squared)));
  float64x2_t root_hi = vsqrtq_f64(
      vcvt_f64_f32(vget_high_f32(squared)));
  float32x4_t inverse = vcombine_f32(
      vcvt_f32_f64(vdivq_f64(one, root_lo)),
      vcvt_f32_f64(vdivq_f64(one, root_hi)));
  return inverse * inverse * inverse;
}
#endif

/*
 * Compute the gravitational impact among all pairs of bodies in
 * the system.
 */
void body_force(Body *p, float dt, int n) {
  int i = 0;

#if defined(__aarch64__)
  /* Each SIMD lane owns one target and its ordered force recurrence. */
  for (; i + 3 < n; i += 4) {
    const float32x4_t px = {p[i].x, p[i + 1].x,
                            p[i + 2].x, p[i + 3].x};
    const float32x4_t py = {p[i].y, p[i + 1].y,
                            p[i + 2].y, p[i + 3].y};
    const float32x4_t pz = {p[i].z, p[i + 1].z,
                            p[i + 2].z, p[i + 3].z};
    const float32x4_t soft = vdupq_n_f32(SOFTENING);
    float32x4_t fx = vdupq_n_f32(0.0f);
    float32x4_t fy = vdupq_n_f32(0.0f);
    float32x4_t fz = vdupq_n_f32(0.0f);
    int j = 0;

    /* Two sources expose independent square-root and division chains. */
    for (; j + 1 < n; j += 2) {
      float32x4_t dx0 = vdupq_n_f32(p[j].x) - px;
      float32x4_t dy0 = vdupq_n_f32(p[j].y) - py;
      float32x4_t dz0 = vdupq_n_f32(p[j].z) - pz;
      float32x4_t squared0 =
          dx0*dx0 + dy0*dy0 + dz0*dz0 + soft;

      float32x4_t dx1 = vdupq_n_f32(p[j + 1].x) - px;
      float32x4_t dy1 = vdupq_n_f32(p[j + 1].y) - py;
      float32x4_t dz1 = vdupq_n_f32(p[j + 1].z) - pz;
      float32x4_t squared1 =
          dx1*dx1 + dy1*dy1 + dz1*dz1 + soft;

      float32x4_t inverse30 = inverse_cube4(squared0);
      float32x4_t inverse31 = inverse_cube4(squared1);

      /* No horizontal reduction or reassociation of source-body sums. */
      fx += dx0 * inverse30;
      fy += dy0 * inverse30;
      fz += dz0 * inverse30;
      fx += dx1 * inverse31;
      fy += dy1 * inverse31;
      fz += dz1 * inverse31;
    }

    if (j < n) {
      float32x4_t dx = vdupq_n_f32(p[j].x) - px;
      float32x4_t dy = vdupq_n_f32(p[j].y) - py;
      float32x4_t dz = vdupq_n_f32(p[j].z) - pz;
      float32x4_t squared = dx*dx + dy*dy + dz*dz + soft;
      float32x4_t inverse3 = inverse_cube4(squared);
      fx += dx * inverse3;
      fy += dy * inverse3;
      fz += dz * inverse3;
    }

    p[i].vx += dt*vgetq_lane_f32(fx, 0);
    p[i].vy += dt*vgetq_lane_f32(fy, 0);
    p[i].vz += dt*vgetq_lane_f32(fz, 0);
    p[i + 1].vx += dt*vgetq_lane_f32(fx, 1);
    p[i + 1].vy += dt*vgetq_lane_f32(fy, 1);
    p[i + 1].vz += dt*vgetq_lane_f32(fz, 1);
    p[i + 2].vx += dt*vgetq_lane_f32(fx, 2);
    p[i + 2].vy += dt*vgetq_lane_f32(fy, 2);
    p[i + 2].vz += dt*vgetq_lane_f32(fz, 2);
    p[i + 3].vx += dt*vgetq_lane_f32(fx, 3);
    p[i + 3].vy += dt*vgetq_lane_f32(fy, 3);
    p[i + 3].vz += dt*vgetq_lane_f32(fz, 3);
  }
#endif

  for (; i < n; ++i) {
    float fx = 0.0f;
    float fy = 0.0f;
    float fz = 0.0f;
    int j = 0;

#if defined(__aarch64__)
    for (; j + 1 < n; j += 2) {
      float dx0 = p[j].x - p[i].x;
      float dy0 = p[j].y - p[i].y;
      float dz0 = p[j].z - p[i].z;
      float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;

      float dx1 = p[j + 1].x - p[i].x;
      float dy1 = p[j + 1].y - p[i].y;
      float dz1 = p[j + 1].z - p[i].z;
      float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;

      /* Match the scalar expression's double sqrt and division. */
      float32x2_t squared = vdup_n_f32(sqrd_dist0);
      squared = vset_lane_f32(sqrd_dist1, squared, 1);
      float64x2_t roots = vsqrtq_f64(vcvt_f64_f32(squared));
      float32x2_t inverse = vcvt_f32_f64(
          vdivq_f64(vdupq_n_f64(1.0), roots));
      float32x2_t inverse3 = vmul_f32(vmul_f32(inverse, inverse), inverse);
      float inv_dist30 = vget_lane_f32(inverse3, 0);
      float inv_dist31 = vget_lane_f32(inverse3, 1);

      /* Keep every force sum in its original source-body order. */
      fx += dx0 * inv_dist30;
      fy += dy0 * inv_dist30;
      fz += dz0 * inv_dist30;
      fx += dx1 * inv_dist31;
      fy += dy1 * inv_dist31;
      fz += dz1 * inv_dist31;
    }
#endif

    for (; j < n; j++) {
      float dx = p[j].x - p[i].x;
      float dy = p[j].y - p[i].y;
      float dz = p[j].z - p[i].z;
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1 / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    p[i].vx += dt*fx;
    p[i].vy += dt*fy;
    p[i].vz += dt*fz;
  }
}

/*
 * Read a binary dataset with initilized bodies.
 */
Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  return bodies;
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc,char **argv) {
  int nbodies;

  Body *bodies = read_dataset(&nbodies);

  /*
   * At each simulation iteration, interbody forces are computed,
   * and bodies' positions are integrated.
   */
  for (int iter = 0; iter < N_ITER; iter++) {
    body_force(bodies, DT, nbodies);

    for (int i = 0; i < nbodies; i++) {
      bodies[i].x += bodies[i].vx * DT;
      bodies[i].y += bodies[i].vy * DT;
      bodies[i].z += bodies[i].vz * DT;
    }
  }

  write_dataset(nbodies, bodies);

  free(bodies);

  exit(EXIT_SUCCESS);
}

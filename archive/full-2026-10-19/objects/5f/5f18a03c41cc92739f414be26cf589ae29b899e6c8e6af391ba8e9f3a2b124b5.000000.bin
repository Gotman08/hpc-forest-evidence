      "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nstatic void count_serial(const vector<vector<bool> >& blockedCells,\n                         vector<int>& frontier, int n) {\n    for (int i = 0; i < n; ++i) {\n        const vector<bool>& blockedRow = blockedCells[i];\n        int left = 0;\n        for (int j = 0; j < n; ++j) {\n            int value = frontier[j] + left;\n            if (value >= MOD) value -= MOD;\n            if (blockedRow[j]) value = 0;\n            frontier[j] = value;\n            left = value;\n        }\n    }\n}\n\n#ifdef _OPENMP\nstatic void update_tile(const vector<vector<bool> >& blockedCells,\n                        int* frontier, int* rightEdge,\n                        int rowBegin, int rowEnd,\n                        int colBegin, int colEnd) {\n    for (int i = rowBegin; i < rowEnd; ++i) {\n        const vector<bool>& blockedRow = blockedCells[i];\n        int left = rightEdge[i];\n        for (int j = colBegin; j < colEnd; ++j) {\n            int value = frontier[j] + left;\n            if (value >= MOD) value -= MOD;\n            if (blockedRow[j]) value = 0;\n            frontier[j] = value;\n            left = value;\n        }\n        rightEdge[i] = left;\n    }\n}\n#endif\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n    vector<vector<bool> > blockedCells(n, vector<bool>(n, false));\n    for (int c = 0; c < m; ++c) {\n        int i, j;\n        cin >> i >> j;\n        blockedCells[i][j] = true;\n    }\n\n    vector<int> frontier(n, 0);\n    // The sole initial contribution enters cell (0,0) from above.\n    frontier[0] = 1;\n\n#ifdef _OPENMP\n    if (n >= 1024 && omp_get_max_threads() > 1) {\n        const int tileHeight = 64;\n        const int tileWidth = 256;\n        const int tileRows = (n + tileHeight - 1) / tileHeight;\n        const int tileCols = (n + tileWidth - 1) / tileWidth;\n        vector<int> rightEdge(n, 0);\n\n        #pragma omp parallel\n        {\n            for (int diagonal = 0;\n                 diagonal < tileRows + tileCols - 1; ++diagonal) {\n                const int firstRow = max(0, diagonal - tileCols + 1);\n                const int lastRow = min(tileRows - 1, diagonal);\n\n                // Tiles on a diagonal own disjoint frontier columns and\n                // right-edge rows. The implicit barrier publishes both.\n                #pragma omp for schedule(static)\n                for (int tileRow = firstRow; tileRow <= lastRow; ++tileRow) {\n                    const int tileCol = diagonal - tileRow;\n                    const int rowBegin = tileRow * tileHeight;\n                    const int colBegin = tileCol * tileWidth;\n                    update_tile(blockedCells, frontier.data(), rightEdge.data(),\n                                rowBegin, min(n, rowBegin + tileHeight),\n                                colBegin, min(n, colBegin + tileWidth));\n                }\n            }\n        }\n    } else\n#endif\n    {\n        count_serial(blockedCells, frontier, n);\n    }\n\n    cout << frontier[n - 1] << endl;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "A persistent OpenMP team processing rectangular wavefront tiles can accelerate the dependent grid recurrence on four cores without per-row barriers or a full integer DP matrix.",
  "notes": "Retains packed obstacle storage and runtime thread settings. Uses a serial path below n=1024 or without OpenMP support. No commands or measurements performed.",
  "sources_kept": [],

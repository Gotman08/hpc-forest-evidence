#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include <omp.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

typedef struct { float x, y, z, vx, vy, vz; } Body;

/*
 * Compute gravitational forces using SoA layout with SIMD vectorization.
 */
void body_force(int n,
                float *restrict px, float *restrict py, float *restrict pz,
                float *restrict vx, float *restrict vy, float *restrict vz) {
  #pragma omp parallel for schedule(static)
  for (int i = 0; i < n; ++i) {
    float fx = 0.0f;
    float fy = 0.0f;
    float fz = 0.0f;

    const float xi = px[i];
    const float yi = py[i];
    const float zi = pz[i];

    #pragma omp simd reduction(+:fx,fy,fz) aligned(px,py,pz:32)
    for (int j = 0; j < n; ++j) {
      float dx = px[j] - xi;
      float dy = py[j] - yi;
      float dz = pz[j] - zi;
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1.0f / sqrtf(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    vx[i] += DT * fx;
    vy[i] += DT * fy;
    vz[i] += DT * fz;
  }
}

/*
 * Read binary dataset into Body array, then convert to SoA.
 */
Body* read_dataset(int *nbodies,
                   float **px, float **py, float **pz,
                   float **vx, float **vy, float **vz) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }

  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  // Allocate aligned SoA arrays
  size_t n = *nbodies;
  *px = (float *)aligned_alloc(32, n * sizeof(float));
  *py = (float *)aligned_alloc(32, n * sizeof(float));
  *pz = (float *)aligned_alloc(32, n * sizeof(float));
  *vx = (float *)aligned_alloc(32, n * sizeof(float));
  *vy = (float *)aligned_alloc(32, n * sizeof(float));
  *vz = (float *)aligned_alloc(32, n * sizeof(float));

  // Transpose from AoS to SoA
  for (size_t i = 0; i < n; ++i) {
    (*px)[i] = bodies[i].x;
    (*py)[i] = bodies[i].y;
    (*pz)[i] = bodies[i].z;
    (*vx)[i] = bodies[i].vx;
    (*vy)[i] = bodies[i].vy;
    (*vz)[i] = bodies[i].vz;
  }

  free(bodies);
  return NULL; // caller no longer needs the Body pointer
}

/*
 * Convert SoA back to AoS and write binary output.
 */
void write_dataset(int nbodies,
                   float *px, float *py, float *pz,
                   float *vx, float *vy, float *vz) {
  Body *bodies = (Body *)malloc(nbodies * sizeof(Body));
  for (int i = 0; i < nbodies; ++i) {
    bodies[i].x = px[i];
    bodies[i].y = py[i];
    bodies[i].z = pz[i];
    bodies[i].vx = vx[i];
    bodies[i].vy = vy[i];
    bodies[i].vz = vz[i];
  }

  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }

  free(bodies);
}

int main(int argc, char **argv) {
  int nbodies;
  float *px, *py, *pz, *vx, *vy, *vz;

  read_dataset(&nbodies, &px, &py, &pz, &vx, &vy, &vz);

  for (int iter = 0; iter < N_ITER; ++iter) {
    body_force(nbodies, px, py, pz, vx, vy, vz);

    #pragma omp simd aligned(px,py,pz,vx,vy,vz:32)
    for (int i = 0; i < nbodies; ++i) {
      px[i] += vx[i] * DT;
      py[i] += vy[i] * DT;
      pz[i] += vz[i] * DT;
    }
  }

  write_dataset(nbodies, px, py, pz, vx, vy, vz);

  free(px); free(py); free(pz);
  free(vx); free(vy); free(vz);

  exit(EXIT_SUCCESS);
}

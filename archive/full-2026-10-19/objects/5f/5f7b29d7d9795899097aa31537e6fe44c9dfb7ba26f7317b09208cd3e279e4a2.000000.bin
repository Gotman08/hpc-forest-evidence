      "content": "#include <cstddef>\n#include <iostream>\n#include <utility>\n#include <vector>\n\nusing namespace std;\n\nclass adjacency_matrix {\npublic:\n    explicit adjacency_matrix(size_t vertices = 0)\n        : vertices_(vertices), cells_(vertices * vertices, 0) {}\n\n    size_t size() const {\n        return vertices_;\n    }\n\n    unsigned char &operator()(size_t row, size_t column) {\n        return cells_[row * vertices_ + column];\n    }\n\n    unsigned char operator()(size_t row, size_t column) const {\n        return cells_[row * vertices_ + column];\n    }\n\n    const unsigned char *rowData(size_t row) const {\n        return cells_.data() + row * vertices_;\n    }\n\nprivate:\n    size_t vertices_;\n    vector<unsigned char> cells_;\n};\n\nadjacency_matrix readGraph();\nvector<int> computeDegrees(const adjacency_matrix &graph);\nbool sameDegreeMultiset(const vector<int> &degree1, const vector<int> &degree2);\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2);\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence);\nint pairMismatch(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                 const vector<int> &equivalence, size_t i, size_t j);\nint countMismatches(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                    const vector<int> &equivalence);\nint countAffectedMismatches(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                            const vector<int> &equivalence, int a, int b);\ninline void printPermutation(const vector<int> &equivalence);\n\nint main() {\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if (!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2) {\n    if (g1.size() != g2.size()) return false;\n\n    vector<int> equivalence(g1.size(), 0);\n    for (size_t i = 0; i < equivalence.size(); ++i)\n        equivalence[i] = static_cast<int>(i);\n\n    if (verifyPermutation(g1, g2, equivalence)) {\n        printPermutation(equivalence);\n        return true;\n    }\n\n    const vector<int> degree1 = computeDegrees(g1);\n    const vector<int> degree2 = computeDegrees(g2);\n    if (!sameDegreeMultiset(degree1, degree2)) return false;\n\n    int mismatch_count = countMismatches(g1, g2, equivalence);\n    vector<int> exchange_counter(g1.size(), 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    /*\n     * Permutations are based on Heap's algorithm, which generates all possible\n     * permutations for a given set of elements.\n     */\n    while (exchange_index < static_cast<int>(g1.size())) {\n        if (exchange_counter[exchange_index] < exchange_index) {\n            int a;\n            const int b = exchange_index;\n            if (exchange_index % 2 == 0)\n                a = 0;\n            else\n                a = exchange_counter[exchange_index];\n\n            const int affected_before =\n                countAffectedMismatches(g1, g2, equivalence, a, b);\n            swap(equivalence[a], equivalence[b]);\n            const int affected_after =\n                countAffectedMismatches(g1, g2, equivalence, a, b);\n            mismatch_count += affected_after - affected_before;\n\n            if (mismatch_count == 0) {\n                printPermutation(equivalence);\n                isomorphism_found = true;\n            }\n\n            exchange_counter[exchange_index]++;\n            exchange_index = 1;\n        } else {\n            exchange_counter[exchange_index] = 0;\n            exchange_index++;\n        }\n    }\n    return isomorphism_found;\n}\n\nadjacency_matrix readGraph() {\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix graph(static_cast<size_t>(vertices));\n\n    cin >> edges;\n    for (int i = 0; i < edges; ++i) {\n        cin >> source >> destination;\n        graph(static_cast<size_t>(destination), static_cast<size_t>(source)) = 1;\n        graph(static_cast<size_t>(source), static_cast<size_t>(destination)) = 1;\n    }\n\n    return graph;\n}\n\nvector<int> computeDegrees(const adjacency_matrix &graph) {\n    vector<int> degrees(graph.size(), 0);\n    for (size_t i = 0; i < graph.size(); ++i) {\n        const unsigned char *row = graph.rowData(i);\n        size_t j = 0;\n        int degree0 = 0;\n        int degree1 = 0;\n        int degree2 = 0;\n        int degree3 = 0;\n        for (; j + 3 < graph.size(); j += 4) {\n            degree0 += row[j];\n            degree1 += row[j + 1];\n            degree2 += row[j + 2];\n            degree3 += row[j + 3];\n        }\n        int degree = degree0 + degree1 + degree2 + degree3;\n        for (; j < graph.size(); ++j)\n            degree += row[j];\n        degrees[i] = degree;\n    }\n    return degrees;\n}\n\nbool sameDegreeMultiset(const vector<int> &degree1, const vector<int> &degree2) {\n    vector<int> balance(degree1.size() + 1, 0);\n    for (size_t i = 0; i < degree1.size(); ++i) {\n        ++balance[degree1[i]];\n        --balance[degree2[i]];\n    }\n    for (size_t degree = 0; degree < balance.size(); ++degree)\n        if (balance[degree] != 0) return false;\n    return true;\n}\n\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence) {\n    for (size_t i = 0; i < equivalence.size(); ++i) {\n        for (size_t j = 0; j <= i; ++j) {\n            if (g1(i, j) != g2(static_cast<size_t>(equivalence[i]),\n                               static_cast<size_t>(equivalence[j])))\n                return false;\n        }\n    }\n    return true;\n}\n\nint pairMismatch(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                 const vector<int> &equivalence, size_t i, size_t j) {\n    if (i < j) swap(i, j);\n    return g1(i, j) != g2(static_cast<size_t>(equivalence[i]),\n                          static_cast<size_t>(equivalence[j]));\n}\n\nint countMismatches(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                    const vector<int> &equivalence) {\n    int count = 0;\n    for (size_t i = 0; i < equivalence.size(); ++i) {\n        for (size_t j = 0; j <= i; ++j)\n            count += pairMismatch(g1, g2, equivalence, i, j);\n    }\n    return count;\n}\n\nint countAffectedMismatches(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                            const vector<int> &equivalence, int a, int b) {\n    const size_t first = static_cast<size_t>(a);\n    const size_t second = static_cast<size_t>(b);\n    int count = pairMismatch(g1, g2, equivalence, first, first)\n              + pairMismatch(g1, g2, equivalence, second, second)\n              + pairMismatch(g1, g2, equivalence, first, second);\n    for (size_t k = 0; k < equivalence.size(); ++k) {\n        if (k != first && k != second) {\n            count += pairMismatch(g1, g2, equivalence, first, k);\n            count += pairMismatch(g1, g2, equivalence, second, k);\n        }\n    }\n    return count;\n}\n\ninline void printPermutation(const vector<int> &equivalence) {\n    for (int vertex : equivalence)\n        cout << vertex << \" \";\n    cout << endl;\n}\n",
      "path": "src/brute_isomorphism.cpp"
    }

        "content": "#include <iostream>\n#include <string>\n#include <map>\n#include <list>\n#include <queue>\n#include <climits>\n#include <cstdio>\n#include <vector>\n#include <atomic>\n#include <cstddef>\n\nusing namespace std;\n\nint nCores = 0;\nint nVertices = 0;\nint nArestas = 0;\nint no_of_vert = 0;\nint contCor = 0;\n\nvector<int> caminhoTropical;\nvector<int> caminho;\nvector<pair<int, int>> arvoreGeradora;\n\nstruct part\n{\n    vector<pair<int, int>> spanning;\n    vector<pair<int, int>> inc_ed;\n    vector<pair<int, int>> exc_ed;\n};\n\nstruct SearchResult\n{\n    bool success;\n    vector<int> successful_path;\n    bool has_best;\n    int best_colors;\n    vector<int> best_path;\n\n    SearchResult() : success(false), has_best(false), best_colors(0) {}\n};\n\nvector<part> partitions;\nvector<pair<int, int>> current_span;\n\nsize_t matrix_index(int row, int col, int width)\n{\n    return static_cast<size_t>(row) * static_cast<size_t>(width) + static_cast<size_t>(col);\n}\n\nclass graph{\n\tpublic:\n\t    int Vertex;\n\t    vector<int> adj_mat;\n\t    vector<int> cores;\n\t    \n\t    graph(int vertex)\n            : Vertex(vertex),\n              adj_mat(static_cast<size_t>(vertex) * static_cast<size_t>(vertex), 0),\n              cores(vertex, 0)\n\t    {\n\t    }\n\t    \n\t    void add_edge(int u, int v)\n\t    {\n\t        adj_mat[matrix_index(u, v, Vertex)] = adj_mat[matrix_index(v, u, Vertex)] = 1;\n\t    }\n};\n\nint find_min_key(const vector<int>& arr, int V, const vector<bool>& mstset)\n{\n    int min_key=INT_MAX, min_index=-1;\n    for(int i=0;i<V;i++)\n    {\n        if(arr[i]<min_key && mstset[i]==false){\n            min_key=arr[i];\n            min_index=i;\n        }\n    }\n    return min_index;\n}\n\nbool is_cycle(const vector<int>& mat,int src, int V)//verificar se o gr?fico formado ? c?clico ou n?o\n{\n    map<int,bool> visited;\n    queue<int> traverse;\n    map<int,int> parent;\n    parent[src]=src;\n    visited[src]=true;\n    traverse.push(src);\n    while(!traverse.empty())\n    {\n        int node=traverse.front();\n        traverse.pop();\n        for(int i=0;i<V;i++)\n            if(mat[matrix_index(node, i, V)]>0)\n            {\n                if(!visited[i])\n                {\n                    traverse.push(i);\n                    visited[i]=true;\n                    parent[i]=node;\n                }\n                else if(visited[i]==true && i!=parent[node])\n                    return 1; //ciclo\n            }\n    }\n    return 0;\n}\n\nint Prim_ST(const graph& G, const vector<pair<int,int>>& include_edges, const vector<pair<int,int>>& exclude_edges)\n{\n    int V = G.Vertex;\n\t           \n    vector<int> new_mat = G.adj_mat;\n    vector<int> mat_cycle(static_cast<size_t>(V) * static_cast<size_t>(V), 0);\n    \n    int u1,v1;\n    for(vector<pair<int, int>>::const_iterator it=exclude_edges.begin(); it!=exclude_edges.end();it++)\n    {\n        u1=(*it).first;\n        v1=(*it).second;\n        new_mat[matrix_index(u1, v1, V)]=new_mat[matrix_index(v1, u1, V)]=INT_MIN;\n    }\n    \n    int parent[V];\n    vector<int> key(V);\n    vector<bool> mstset(V);\n    for(int i=0;i<V;i++)\n    {\n        key[i]=INT_MAX;\n        mstset[i]=false;\n        parent[i]=nVertices;\n    }\n    \n    int root;\n    root= 0;\n    parent[root]=-1;\n    \n    int vertex_must_include[V];\n    map<int, int> parent_included_vertex;\n    \n    for(int m=0;m<V;m++)\n        vertex_must_include[m]=false;\n    if(!include_edges.empty())\n    {\n        for(vector<pair<int, int>>::const_iterator it=include_edges.begin(); it!=include_edges.end();it++)\n        {\n            u1=(*it).first;\n            v1=(*it).second;\n            vertex_must_include[u1]=vertex_must_include[v1]=true;\n            parent_included_vertex[v1]=u1;\n            parent_included_vertex[u1]=100;\n        }\n    }\n    \n    key[root]=0;\n    parent[root]=-1;\n    for(int c=0;c<V;c++)\n    {\n        int u=find_min_key(key, V, mstset);\n        if(u==-1) //desconectado\n        {\n            return -1;\n        }\n        mstset[u]=true;\n        if(parent[u] > 0)\n        \tmat_cycle[matrix_index(parent[u], u, V)]=new_mat[matrix_index(parent[u], u, V)];\n        no_of_vert++;\n        for(int v=0;v<V;v++)\n        {\n            if(new_mat[matrix_index(u, v, V)]>0 && mstset[v]==false && new_mat[matrix_index(u, v, V)]< key[v])\n            {\n                \n                if(vertex_must_include[v] && parent_included_vertex[v]!=100 && parent_included_vertex[v]!=u)\n                {\n                    int x=parent_included_vertex[v];\n                    if(parent[x]!=nVertices)\n                        continue;\n                }\n                //para verificar se o ciclo se formou ou n?o\n                int prev=mat_cycle[matrix_index(u, v, V)];\n                mat_cycle[matrix_index(u, v, V)]=new_mat[matrix_index(u, v, V)];\n                \n                bool cycle=is_cycle(mat_cycle, root, V);\n                if(!cycle)\n                {\n                    parent[v]=u;\n                    key[v]=new_mat[matrix_index(u, v, V)];\n                }\n                mat_cycle[matrix_index(u, v, V)]=prev;\n            }\n        }\n    }\n    \n    int tot_cost=0;\n    for(int i=1;i<V;i++){\n        int x=parent[i];\n        tot_cost+=new_mat[matrix_index(x, i, V)];\n        current_span.push_back(make_pair(x, i));\n    }\n    return tot_cost;\n}\n\nvoid exibirVetor(const vector<int>& l)\n{\n    for(auto i: l)\n    {\n    \tif(i == l.back())\n    \t\tcout<<i;\n    \telse\n        \tcout<<i<<\"-\";\n    }\n    cout<<endl;\n}\n\nbool buscaSequencial(const vector<int>& l, int ch){\n\tfor(std::vector<int>::const_iterator it = l.begin(); it != l.end(); it++)\n\t\tif(ch == *it) return true;\n\treturn false;\n}\n\nvector<int> buscaAresta(int vert){\n\tvector<int> aux;\n\tfor(std::vector<std::pair<int, int>>::iterator it = arvoreGeradora.begin(); it != arvoreGeradora.end(); it++){\n\t\tpair<int, int> par = *it;\n\t\tif(vert == par.first) aux.push_back(par.second);\n\t\tif(vert == par.second) aux.push_back(par.first);\n\t}\n\treturn aux;\n}\n\nint coresConjunto(const vector<int>& l, const graph& G){\n\tvector<int> cor;\n\t\n\tfor(std::vector<int>::const_iterator it = l.begin(); it != l.end(); it++){\n\t\tif(!buscaSequencial(cor, G.cores[*it])){\n\t\t\tcor.push_back(G.cores[*it]);\n\t\t}\n\t}\n\treturn cor.size();\n}\n\nbool deep(int vertice, vector<int>& hist, const graph& G,\n          const vector<vector<int>>& tree, vector<char>& in_path,\n          vector<int>& color_count, int& distinct_colors, SearchResult& result)\n{\n    hist.push_back(vertice);\n    in_path[vertice] = 1;\n    int color = G.cores[vertice];\n    if (color_count[color]++ == 0)\n        ++distinct_colors;\n\n    bool fim = true;\n    bool found = false;\n    for (std::vector<int>::const_iterator it = tree[vertice].begin(); it != tree[vertice].end(); ++it){\n        if (!in_path[*it]){\n            fim = false;\n            if (deep(*it, hist, G, tree, in_path, color_count, distinct_colors, result)){\n                found = true;\n                break;\n            }\n        }\n    }\n\n    if (fim){\n        if (distinct_colors == nCores){\n            result.success = true;\n            result.successful_path = hist;\n            found = true;\n        }\n        else if (!result.has_best || distinct_colors > result.best_colors){\n            result.has_best = true;\n            result.best_colors = distinct_colors;\n            result.best_path = hist;\n        }\n    }\n\n    if (--color_count[color] == 0)\n        --distinct_colors;\n    in_path[vertice] = 0;\n    hist.pop_back();\n    return found;\n}\n\nSearchResult search_root(int root, const graph& G, const vector<vector<int>>& tree)\n{\n    SearchResult result;\n    vector<int> hist;\n    hist.push_back(root);\n    vector<char> in_path(nVertices, 0);\n    vector<int> color_count(nCores, 0);\n    in_path[root] = 1;\n    int distinct_colors = 0;\n    int root_color = G.cores[root];\n    if (color_count[root_color]++ == 0)\n        ++distinct_colors;\n\n    for (std::vector<int>::const_iterator it = tree[root].begin(); it != tree[root].end(); ++it){\n        if (!in_path[*it] && deep(*it, hist, G, tree, in_path, color_count, distinct_colors, result))\n            break;\n    }\n    return result;\n}\n\nbool caminhoTropi(const graph& G){\n    vector<vector<int>> tree(nVertices);\n    for (std::vector<pair<int, int>>::const_iterator it = arvoreGeradora.begin(); it != arvoreGeradora.end(); ++it){\n        tree[it->first].push_back(it->second);\n        tree[it->second].push_back(it->first);\n    }\n\n    vector<SearchResult> results(nVertices);\n    atomic<int> earliest_success(nVertices);\n    if (nVertices >= 32){\n        #pragma omp parallel for schedule(dynamic)\n        for (int i = 0; i < nVertices; ++i){\n            if (i > earliest_success.load(memory_order_relaxed))\n                continue;\n            results[i] = search_root(i, G, tree);\n            if (results[i].success){\n                int known = earliest_success.load(memory_order_relaxed);\n                while (i < known && !earliest_success.compare_exchange_weak(\n                           known, i, memory_order_relaxed, memory_order_relaxed)) {}\n            }\n        }\n    }\n    else{\n        for (int i = 0; i < nVertices; ++i)\n            results[i] = search_root(i, G, tree);\n    }\n\n    for (int i = 0; i < nVertices; ++i){\n        if (results[i].success){\n            exibirVetor(results[i].successful_path);\n            cout<<nCores;\n            return true;\n        }\n        if (results[i].has_best && results[i].best_colors > contCor){\n            contCor = results[i].best_colors;\n            caminho = results[i].best_path;\n        }\n    }\n    return false;\n}\n\nbool create_partitions(const graph& G)\n{\n    while(true)\n    {\n    \tpart P;\n        vector<part>::iterator iter;\n        for(vector<part>::iterator it=partitions.begin();it!=partitions.end();it++)\n        {\n            iter=it;\n        }\n        P.spanning=(*iter).spanning;\n        P.exc_ed=(*iter).exc_ed;\n        P.inc_ed=(*iter).inc_ed;\n        partitions.erase(iter);\n        \n        vector<pair<int, int>> stree = P.spanning;\n        vector<pair<int, int>>::iterator it1;\n        vector<pair<int, int>>::iterator it2;\n        \n        arvoreGeradora = stree;\n        \n        if(caminhoTropi(G)){\n\t\t\treturn true;\n\t\t}\n        \n        vector<pair<int, int>> included_edges;\n        vector<pair<int, int>> excluded_edges;\n        included_edges=P.inc_ed;\n        pair<int, int> ex_edge;\n        \n        int j;\n        for(j = 0; j < stree.size(); j++)\n        {\n            if(included_edges.empty())\n                break;\n            if(stree[j].first!=included_edges[j].first && stree[j].second!=included_edges[j].second)\n            {\n                break;\n            }\n        }\n        int cost;\n        it2= stree.begin()+ j;\n        int u1,v1;\n        for(it1=it2; it1!=stree.end(); it1++)\n        {\n            part new_p;\n            u1=(*it1).first;\n            v1=(*it1).second;\n            ex_edge.first=u1;\n            ex_edge.second=v1;\n            excluded_edges=P.exc_ed;\n            excluded_edges.push_back(ex_edge);\n            current_span.clear();\n            cost = Prim_ST(G, included_edges, excluded_edges);\n            if(cost > 0)\n            {\n                new_p.spanning=current_span;\n                new_p.inc_ed=included_edges;\n                new_p.exc_ed=excluded_edges;\n                partitions.push_back(new_p);\n            }\n            included_edges.push_back(ex_edge);\n        }\n        \n        if(partitions.empty()){\n            return false;\n        }\n    }\n}\n\nint main() {\n    scanf(\"%i %i\", &nVertices, &nCores);\n    \n    graph G {nVertices};\n    \n    for\t(int i = 0; i < nVertices; i++){\n\t\tint cor;\n\t\tscanf(\"%i\", &cor);\n\t\tG.cores[i] = cor;\n\t}\n    \n    scanf(\"%i\", &nArestas);\n    \n    for\t(int i = 0; i < nArestas; i++){\n    \tint u1, v1;\n\t\tscanf(\"%i %i\", &u1, &v1);\n        G.add_edge(u1, v1);\n\t}\n\t\n\tvector<pair<int, int>> incl;\n    vector<pair<int, int>> excl;\n    incl.clear();\n    excl.clear();\n    Prim_ST(G, incl, excl);\n    part p;\n    incl.clear();\n    excl.clear();\n    p.exc_ed=excl;\n    p.inc_ed=incl;\n    p.spanning=current_span;\n    partitions.push_back(p);\n    \n\tif(!create_partitions(G)){\n\t\texibirVetor(caminho);\n\t\tcout<<contCor<<endl;\n\t}\n\t\n    return 0;\n}\n",

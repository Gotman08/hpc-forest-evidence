      "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nconstexpr int MOD = 1000000007;\n\nstruct Point {\n    int row;\n    int column;\n    int diagonal;\n};\n\nstatic int modPower(int base, int exponent) {\n    long long result = 1;\n    long long value = base;\n    while (exponent != 0) {\n        if (exponent & 1) {\n            result = result * value % MOD;\n        }\n        value = value * value % MOD;\n        exponent >>= 1;\n    }\n    return static_cast<int>(result);\n}\n\nstatic inline int calculateBlockedWays(\n    const Point* __restrict blocked,\n    const int* __restrict factorial,\n    const int* __restrict inverseFactorial,\n    const int* __restrict waysToBlocked,\n    size_t current,\n    size_t completed) {\n    const Point point = blocked[current];\n    const long long initialWays =\n        static_cast<long long>(factorial[point.diagonal]) * inverseFactorial[point.row] % MOD *\n        inverseFactorial[point.column] % MOD;\n\n    long long excludedWays = 0;\n#pragma omp simd reduction(+: excludedWays)\n    for (long long previousIndex = 0;\n         previousIndex < static_cast<long long>(completed);\n         ++previousIndex) {\n        const Point previous = blocked[previousIndex];\n        if (previous.row <= point.row && previous.column <= point.column) {\n            const int steps = point.diagonal - previous.diagonal;\n            const int downSteps = point.row - previous.row;\n            const long long pathsBetween =\n                static_cast<long long>(factorial[steps]) * inverseFactorial[downSteps] % MOD *\n                inverseFactorial[steps - downSteps] % MOD;\n            excludedWays +=\n                static_cast<long long>(waysToBlocked[previousIndex]) * pathsBetween % MOD;\n        }\n    }\n\n    return static_cast<int>((initialWays - excludedWays % MOD + MOD) % MOD);\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    cin >> n >> m;\n\n    vector<Point> blocked;\n    blocked.reserve(static_cast<size_t>(m));\n    bool endpointBlocked = false;\n\n    for (int index = 0; index < m; ++index) {\n        int row, column;\n        cin >> row >> column;\n        if ((row == 0 && column == 0) ||\n            (row == n - 1 && column == n - 1)) {\n            endpointBlocked = true;\n        } else {\n            blocked.push_back({row, column, row + column});\n        }\n    }\n\n    if (endpointBlocked) {\n        cout << 0 << '\\n';\n        return 0;\n    }\n\n    sort(blocked.begin(), blocked.end(), [](const Point& left, const Point& right) {\n        if (left.diagonal != right.diagonal) {\n            return left.diagonal < right.diagonal;\n        }\n        if (left.row != right.row) {\n            return left.row < right.row;\n        }\n        return left.column < right.column;\n    });\n    blocked.erase(unique(blocked.begin(), blocked.end(), [](const Point& left, const Point& right) {\n        return left.row == right.row && left.column == right.column;\n    }), blocked.end());\n\n    const int maximumSteps = 2 * (n - 1);\n    vector<int> factorial(maximumSteps + 1);\n    vector<int> inverseFactorial(maximumSteps + 1);\n    factorial[0] = 1;\n    for (int value = 1; value <= maximumSteps; ++value) {\n        factorial[value] = static_cast<long long>(factorial[value - 1]) * value % MOD;\n    }\n    inverseFactorial[maximumSteps] = modPower(factorial[maximumSteps], MOD - 2);\n    for (int value = maximumSteps; value > 0; --value) {\n        inverseFactorial[value - 1] = static_cast<long long>(inverseFactorial[value]) * value % MOD;\n    }\n\n    const Point* const blockedData = blocked.data();\n    const int* const factorialData = factorial.data();\n    const int* const inverseFactorialData = inverseFactorial.data();\n    vector<int> waysToBlocked(blocked.size());\n    const int* const waysData = waysToBlocked.data();\n\n    for (size_t begin = 0; begin < blocked.size();) {\n        size_t end = begin + 1;\n        while (end < blocked.size() && blocked[end].diagonal == blocked[begin].diagonal) {\n            ++end;\n        }\n\n        const size_t completed = begin;\n        if (end - begin >= 64) {\n#pragma omp parallel for schedule(static)\n            for (long long current = static_cast<long long>(begin);\n                 current < static_cast<long long>(end);\n                 ++current) {\n                waysToBlocked[static_cast<size_t>(current)] = calculateBlockedWays(\n                    blockedData,\n                    factorialData,\n                    inverseFactorialData,\n                    waysData,\n                    static_cast<size_t>(current),\n                    completed);\n            }\n        } else {\n            for (size_t current = begin; current < end; ++current) {\n                waysToBlocked[current] = calculateBlockedWays(\n                    blockedData,\n                    factorialData,\n                    inverseFactorialData,\n                    waysData,\n                    current,\n                    completed);\n            }\n        }\n        begin = end;\n    }\n\n    const long long directWays =\n        static_cast<long long>(factorialData[maximumSteps]) * inverseFactorialData[n - 1] % MOD *\n        inverseFactorialData[n - 1] % MOD;\n    long long blockedWays = 0;\n#pragma omp simd reduction(+: blockedWays)\n    for (long long index = 0; index < static_cast<long long>(blocked.size()); ++index) {\n        const Point point = blockedData[index];\n        const int remainingSteps = maximumSteps - point.diagonal;\n        const int remainingRows = n - 1 - point.row;\n        const int remainingColumns = n - 1 - point.column;\n        const long long pathsToDestination =\n            static_cast<long long>(factorialData[remainingSteps]) * inverseFactorialData[remainingRows] % MOD *\n            inverseFactorialData[remainingColumns] % MOD;\n        blockedWays += static_cast<long long>(waysData[index]) * pathsToDestination % MOD;\n    }\n\n    cout << (directWays - blockedWays % MOD + MOD) % MOD << '\\n';\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "The predecessor and final obstacle-subtraction loops have no loop-carried dependencies once their modular terms are accumulated in a bounded 64-bit reduction; explicitly marking them SIMD enables legal vectorization on ARM while eliminating per-term modular normalization.",
  "notes": "Each summed term is below MOD and the input count is an int, so the reduction cannot overflow signed 64-bit arithmetic; reducing once modulo MOD is algebraically identical to the prior incremental subtraction.",
  "sources_kept": [],
  "transformations": [
    "Refactor the independent predecessor scan into an OpenMP SIMD reduction with restrict-qualified read-only streams.",
    "Accumulate obstacle contributions before one modular reduction in both inclusion-exclusion loops."

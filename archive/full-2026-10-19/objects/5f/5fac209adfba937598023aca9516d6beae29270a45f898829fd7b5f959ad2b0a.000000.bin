      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <ctype.h>\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nstatic char knn_input_buffer[65536];\nstatic size_t knn_input_position;\nstatic size_t knn_input_length;\n\nstatic int knn_input_peek(void) {\n    if (knn_input_position == knn_input_length) {\n        knn_input_length = fread(knn_input_buffer, 1,\n                                 sizeof(knn_input_buffer), stdin);\n        knn_input_position = 0;\n        if (knn_input_length == 0) {\n            return EOF;\n        }\n    }\n    return (unsigned char)knn_input_buffer[knn_input_position];\n}\n\nstatic void knn_input_skip_space(void) {\n    int c;\n    while ((c = knn_input_peek()) != EOF && isspace((unsigned char)c)) {\n        ++knn_input_position;\n    }\n}\n\nstatic void knn_input_expect(const char *literal) {\n    knn_input_skip_space();\n    while (*literal != '\\0') {\n        if (knn_input_peek() != (unsigned char)*literal) {\n            on_error();\n        }\n        ++knn_input_position;\n        ++literal;\n    }\n}\n\nstatic int knn_input_integer(void) {\n    knn_input_skip_space();\n    int negative = 0;\n    int c = knn_input_peek();\n    if (c == '+' || c == '-') {\n        negative = c == '-';\n        ++knn_input_position;\n        c = knn_input_peek();\n    }\n    if (c < '0' || c > '9') {\n        on_error();\n    }\n\n    unsigned int value = 0;\n    unsigned int limit = negative ? (unsigned int)INT_MAX + 1U\n                                  : (unsigned int)INT_MAX;\n    do {\n        unsigned int digit = (unsigned int)(c - '0');\n        if (value > (limit - digit) / 10U) {\n            on_error();\n        }\n        value = value * 10U + digit;\n        ++knn_input_position;\n        c = knn_input_peek();\n    } while (c >= '0' && c <= '9');\n\n    if (!negative) {\n        return (int)value;\n    }\n    if (value == (unsigned int)INT_MAX + 1U) {\n        return INT_MIN;\n    }\n    return -(int)value;\n}\n\nstatic void knn_input_append_token(char **token, size_t *length,\n                                    size_t *capacity, const char *data,\n                                    size_t amount) {\n    if (amount > SIZE_MAX - *length - 1) {\n        on_error();\n    }\n    size_t needed = *length + amount + 1;\n    if (needed > *capacity) {\n        size_t new_capacity = *capacity == 0 ? 128 : *capacity;\n        while (new_capacity < needed) {\n            if (new_capacity > SIZE_MAX / 2) {\n                new_capacity = needed;\n                break;\n            }\n            new_capacity *= 2;\n        }\n        char *new_token = (char *)realloc(*token, new_capacity);\n        if (new_token == NULL) {\n            on_error();\n        }\n        *token = new_token;\n        *capacity = new_capacity;\n    }\n    memcpy(*token + *length, data, amount);\n    *length += amount;\n    (*token)[*length] = '\\0';\n}\n\nstatic float knn_input_convert_float(char *text, size_t length) {\n    char *end;\n    float value = strtof(text, &end);\n    if (end == text || end != text + length) {\n        on_error();\n    }\n    return value;\n}\n\nstatic float knn_input_float(void) {\n    knn_input_skip_space();\n    char *token = NULL;\n    size_t token_length = 0;\n    size_t token_capacity = 0;\n    size_t depth = 0;\n\n    for (;;) {\n        if (knn_input_peek() == EOF) {\n            free(token);\n            on_error();\n        }\n        size_t begin = knn_input_position;\n        size_t end = begin;\n        while (end < knn_input_length) {\n            unsigned char c = (unsigned char)knn_input_buffer[end];\n            if (isspace(c) ||\n                (depth == 0 && (c == ',' || c == ')'))) {\n                break;\n            }\n            if (c == '(') {\n                ++depth;\n            } else if (c == ')' && depth > 0) {\n                --depth;\n            }\n            ++end;\n        }\n\n        if (end < knn_input_length) {\n            float value;\n            if (token == NULL) {\n                /* Ordinary tokens are converted directly in the input block. */\n                char saved = knn_input_buffer[end];\n                knn_input_buffer[end] = '\\0';\n                value = knn_input_convert_float(knn_input_buffer + begin,\n                                                end - begin);\n                knn_input_buffer[end] = saved;\n            } else {\n                knn_input_append_token(&token, &token_length,\n                                       &token_capacity,\n                                       knn_input_buffer + begin, end - begin);\n                value = knn_input_convert_float(token, token_length);\n            }\n            knn_input_position = end;\n            free(token);\n            return value;\n        }\n\n        /* Only tokens crossing a block boundary need a temporary copy. */\n        knn_input_append_token(&token, &token_length, &token_capacity,\n                               knn_input_buffer + begin, end - begin);\n        knn_input_position = end;\n    }\n}\n\nint parse_number_of_groups() {\n    knn_input_expect(\"n_groups=\");\n    int n = knn_input_integer();\n    knn_input_skip_space();\n    return n;\n}\n\nPoint parse_point() {\n    Point point;\n    knn_input_expect(\"(\");\n    point.x = knn_input_float();\n    knn_input_expect(\",\");\n    point.y = knn_input_float();\n    knn_input_expect(\")\");\n    knn_input_skip_space();\n    return point;\n}\n\nGroup parse_next_group() {\n    knn_input_expect(\"label=\");\n    int c = knn_input_peek();\n    if (c == EOF) {\n        on_error();\n    }\n    char label = (char)c;\n    ++knn_input_position;\n\n    knn_input_expect(\"length=\");\n    int length = knn_input_integer();\n    knn_input_skip_space();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    knn_input_expect(\"k=\");\n    int k = knn_input_integer();\n    knn_input_skip_space();\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}\n",
      "path": "src/knn.h"
    }
  ],
  "hypothesis": "Sequential 64 KiB input blocks with in-place float conversion should reduce parsing overhead and improve locality without changing packed-key selection.",
  "notes": "Distance arithmetic and selection remain unchanged. strtof handles floating-point conversion; boundary-spanning tokens use dynamically growing storage. No commands or measurements were run.",

#include "knn.h"

typedef struct {
    float distance;
    size_t encounter;
    char label;
} Candidate;

/* Order candidates by distance, then by their original traversal order. */
static int candidate_precedes(Candidate a, Candidate b) {
    if (a.distance < b.distance) return 1;
    if (a.distance > b.distance) return 0;
    return a.encounter < b.encounter;
}

static void heap_sift_up(Candidate *heap, int index) {
    while (index > 0) {
        int parent = (index - 1) / 2;
        if (!candidate_precedes(heap[parent], heap[index])) break;

        Candidate temp = heap[parent];
        heap[parent] = heap[index];
        heap[index] = temp;
        index = parent;
    }
}

static void heap_sift_down(Candidate *heap, int count, int index) {
    for (;;) {
        int worst = index;
        int left = 2 * index + 1;
        int right = left + 1;

        if (left < count && candidate_precedes(heap[worst], heap[left])) {
            worst = left;
        }
        if (right < count && candidate_precedes(heap[worst], heap[right])) {
            worst = right;
        }
        if (worst == index) break;

        Candidate temp = heap[index];
        heap[index] = heap[worst];
        heap[worst] = temp;
        index = worst;
    }
}

static char classify_labels(char *labels, int k) {
    qsort(labels, k, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (int i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }
            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    return most_frequent;
}

/* Retain the original behavior for NaN distances, which have no heap order. */
static char knn_with_incomparable_distances(int n_groups, Group *groups,
                                           int k, Point to_evaluate) {
    char *labels = (char *) malloc(sizeof(char) * (size_t) k);
    float *distances = (float *) malloc(sizeof(float) * (size_t) k);

    for (int i = 0; i < k; i++) {
        labels[i] = -1;
        distances[i] = -1;
    }

    for (int i = 0; i < n_groups; i++) {
        Group g = groups[i];

        for (int j = 0; j < g.length; j++) {
            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);

            for (int x = 0; x < k; x++) {
                if (d < distances[x] || distances[x] == -1) {
                    for (int y = k - 1; y > x; y--) {
                        distances[y] = distances[y - 1];
                        labels[y] = labels[y - 1];
                    }
                    distances[x] = d;
                    labels[x] = g.label;
                    break;
                }
            }
        }
    }

    char result = classify_labels(labels, k);
    free(distances);
    free(labels);
    return result;
}

char knn(int n_groups, Group *groups, int k, Point to_evaluate) {
    Candidate *heap = (Candidate *) malloc(sizeof(Candidate) * (size_t) k);
    int heap_count = 0;
    size_t encounter = 0;

    for (int i = 0; i < n_groups; i++) {
        Group *g = &groups[i];

        for (int j = 0; j < g->length; j++) {
            float d = euclidean_distance_no_sqrt(to_evaluate, g->points[j]);
            if (d != d) {
                free(heap);
                return knn_with_incomparable_distances(n_groups, groups, k,
                                                      to_evaluate);
            }

            Candidate candidate = {d, encounter++, g->label};
            if (heap_count < k) {
                heap[heap_count] = candidate;
                heap_sift_up(heap, heap_count);
                heap_count++;
            } else if (candidate_precedes(candidate, heap[0])) {
                heap[0] = candidate;
                heap_sift_down(heap, heap_count, 0);
            }
        }
    }

    char *labels = (char *) malloc(sizeof(char) * (size_t) k);
    int label_index = 0;
    while (label_index < k - heap_count) {
        labels[label_index++] = -1;
    }
    for (int i = 0; i < heap_count; i++) {
        labels[label_index++] = heap[i].label;
    }

    free(heap);
    char result = classify_labels(labels, k);
    free(labels);
    return result;
}

int main() {
    int n_groups = parse_number_of_groups();

    Group *groups = (Group *) malloc(sizeof(Group) * (size_t) n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();
    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

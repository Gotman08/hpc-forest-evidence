#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <algorithm>

int main() {
	int n,s;
	std::cin >> n >> s;

	assert(n>0);
	assert(s>0);
	assert(s<n);
	assert(n<8000);

	// Flat row-major storage: contiguous rows improve SIMD loads/stores.
	std::vector<int> matrix((size_t)n * n);
	for(int i=0;i<n;i++) {
		int* row = &matrix[(size_t)i * n];
		for(int j=0;j<n;j++)
			scanf("%d", &row[j]);
	}

	// colSum[k] is the sum of rows [i, i+s) in column k.
	std::vector<long long> colSum(n, 0);
	for(int r=0;r<s;r++) {
		const int* row = &matrix[(size_t)r * n];
		#pragma omp simd
		for(int j=0;j<n;j++)
			colSum[j] += (long long)row[j];
	}

	// Initial SxS window sum.
	long long sum = 0;
	#pragma omp simd reduction(+:sum)
	for(int j=0;j<s;j++)
		sum += colSum[j];

	long long mxSum = sum;

	int dir = 1;
	int i = 0;
	int j = 0;
	while(i+s <= n) {
		if( (j+s == n && dir==1) || (j==0 && dir==-1) ) {
			int exitingRow = i;
			int enteringRow = i+s;
			if(enteringRow >= n) break;

			const int* exitPtr = &matrix[(size_t)exitingRow * n];
			const int* enterPtr = &matrix[(size_t)enteringRow * n];

			// Vertical slide: update every column sum independently.
			#pragma omp simd
			for(int k=0;k<n;k++)
				colSum[k] += (long long)enterPtr[k] - exitPtr[k];

			// Adjust only the columns belonging to the current window.
			long long delta = 0;
			#pragma omp simd reduction(+:delta)
			for(int k=j;k<j+s;k++)
				delta += (long long)enterPtr[k] - exitPtr[k];
			sum += delta;

			i++;
			dir*=-1;
		} else {
			int exitingCol, enteringCol;
			if(dir==1) {
				exitingCol = j;
				enteringCol = exitingCol + s;
			} else {
				enteringCol = j-1;
				exitingCol = enteringCol + s;
			}

			// Horizontal slide is now O(1) using the maintained column sums.
			sum += colSum[enteringCol] - colSum[exitingCol];
			j+=dir;
		}

		if(sum > mxSum)
			mxSum = sum;
	}

	printf("%lld\n", mxSum);
}

#include "knn.h"

#define BLOCK_SIZE 16

typedef struct {
    float distance;
    char label;
} DistanceLabel;

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    DistanceLabel * distances = (DistanceLabel *) malloc(sizeof(DistanceLabel) * k);

    for (int i = 0; i < k; i++) {
        distances[i].distance = -1;
        distances[i].label = -1;
    }

    for (int i = 0; i < n_groups; i++) {
        Group g = groups[i];
        int length = g.length;
        Point * points = g.points;
        char label = g.label;

        for (int j = 0; j < length; j += BLOCK_SIZE) {
            int block_end = (j + BLOCK_SIZE > length) ? length : j + BLOCK_SIZE;
            DistanceLabel temp_distances[BLOCK_SIZE];

            for (int b = j; b < block_end; b++) {
                float d = euclidean_distance_no_sqrt(to_evaluate, points[b]);
                temp_distances[b - j].distance = d;
                temp_distances[b - j].label = label;
            }

            for (int b = j; b < block_end; b++) {
                DistanceLabel current = temp_distances[b - j];
                int pos = k - 1;

                while (pos >= 0 && (distances[pos].distance == -1 || current.distance < distances[pos].distance)) {
                    distances[pos + 1] = distances[pos];
                    pos--;
                }

                if (pos + 1 < k) {
                    distances[pos + 1] = current;
                }
            }
        }
    }

    char most_frequent = distances[0].label;
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (int i = 1; i < k; i++) {
        if (distances[i].label != distances[i - 1].label) {
            if (current_frequency > most_frequent_count) {
                most_frequent = distances[i - 1].label;
                most_frequent_count = current_frequency;
            }

            current_frequency = 1;
        } else {
            current_frequency++;
        }
    }

    if (current_frequency > most_frequent_count) {
        most_frequent = distances[k - 1].label;
    }

    free(distances);
    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}
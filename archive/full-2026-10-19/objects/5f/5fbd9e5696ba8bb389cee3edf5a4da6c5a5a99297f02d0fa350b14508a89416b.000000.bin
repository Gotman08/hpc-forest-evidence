= dx*dx + dy*dy + dz*dz + SOFTENING;\\n+        float inv_dist = 1 / sqrt(sqrd_dist);\\n+        float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n+\\n+        fx0 += dx * inv_dist3;\\n+        fy0 += dy * inv_dist3;\\n+        fz0 += dz * inv_dist3;\\n+      }\\n+      {\\n+        float dx = xj - x1;\\n+        float dy = yj - y1;\\n+        float dz = zj - z1;\\n+        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n+        float inv_dist = 1 / sqrt(sqrd_dist);\\n+        float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n+\\n+        fx1 += dx * inv_dist3;\\n+        fy1 += dy * inv_dist3;\\n+        fz1 += dz * inv_dist3;\\n+      }\\n+      {\\n+        float dx = xj - x2;\\n+        float dy = yj - y2;\\n+        float dz = zj - z2;\\n+        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n+        float inv_dist = 1 / sqrt(sqrd_dist);\\n+        float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n+\\n+        fx2 += dx * inv_dist3;\\n+        fy2 += dy * inv_dist3;\\n+        fz2 += dz * inv_dist3;\\n+      }\\n+      {\\n+        float dx = xj - x3;\\n+        float dy = yj - y3;\\n+        float dz = zj - z3;\\n+        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n+        float inv_dist = 1 / sqrt(sqrd_dist);\\n+        float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n+\\n+        fx3 += dx * inv_dist3;\\n+        fy3 += dy * inv_dist3;\\n+        fz3 += dz * inv_dist3;\\n+      }\\n+    }\\n+\\n+    p[i].vx += dt*fx0;\\n+    p[i].vy += dt*fy0;\\n+    p[i].vz += dt*fz0;\\n+    p[i + 1].vx += dt*fx1;\\n+    p[i + 1].vy += dt*fy1;\\n+    p[i + 1].vz += dt*fz1;\\n+    p[i + 2].vx += dt*fx2;\\n+    p[i + 2].vy += dt*fy2;\\n+    p[i + 2].vz += dt*fz2;\\n+    p[i + 3].vx += dt*fx3;\\n+    p[i + 3].vy += dt*fy3;\\n+    p[i + 3].vz += dt*fz3;\\n+  }\\n+\\n+  for (int i = nblocks * 4; i < n; ++i) {\\n+    float fx = 0.0f;\\n+    float fy = 0.0f;\\n+    float fz = 0.0f;\\n+\\n+    for (int j = 0; j < n; j++) {\\n+      float dx = p
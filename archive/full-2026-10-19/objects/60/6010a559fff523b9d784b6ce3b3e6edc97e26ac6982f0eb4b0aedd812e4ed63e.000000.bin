#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <climits>

int main() {
	int n, s;
	std::cin >> n >> s;
	std::vector<std::vector<int> > matrix(n, std::vector<int>(n));
	for(int i=0; i<n; i++)
		for(int j=0; j<n; j++) 
			scanf("%d", &(matrix[i][j]));

	assert(s < n);
	assert(n < 8000);
	assert(s > 0);
	assert(n > 0);

	const int BLOCK_SIZE = 32;
	int mxSum = INT_MIN;

	for(int bi=0; bi<n; bi+=BLOCK_SIZE) {
		for(int bj=0; bj<n; bj+=BLOCK_SIZE) {
			int sum = 0;
			for(int i=bi; i<std::min(bi+BLOCK_SIZE, n); i++) {
				for(int j=bj; j<std::min(bj+BLOCK_SIZE, n); j++) {
					if(i < s && j < s) {
						sum += matrix[i][j];
					}
				}
			}
			mxSum = std::max(mxSum, sum);

			for(int i=bi; i<std::min(bi+BLOCK_SIZE, n-s); i++) {
				for(int j=bj; j<std::min(bj+BLOCK_SIZE, n-s); j++) {
					int exitingRow = i;
					int enteringRow = exitingRow + s;

					if(enteringRow < n) {
						for(int k=0; k<s; k++) { sum -= matrix[exitingRow][k+j]; }
						for(int k=0; k<s; k++) { sum += matrix[enteringRow][k+j]; }

						mxSum = std::max(mxSum, sum);
					}

					int dir = 1;
					int enteringCol, exitingCol;
					for(int jOffset=0; jOffset<n-s; jOffset++) {
						if(dir == 1) {
							extitingCol = bj + jOffset;
							enteringCol = exitingCol + s;
						} else {
							enteringCol = bj + jOffset - 1;
							extitingCol = enteringCol + s;
						}

						if(enteringCol < n) {
							for(int k=0; k<s; k++) { sum -= matrix[k+exitingRow][exitingCol]; }
							for(int k=0; k<s; k++) { sum += matrix[k+exitingRow][enteringCol]; }

							mxSum = std::max(mxSum, sum);
						}

						dir *= -1;
					}
			}
		}
	}

	printf("%d\n", mxSum);
}
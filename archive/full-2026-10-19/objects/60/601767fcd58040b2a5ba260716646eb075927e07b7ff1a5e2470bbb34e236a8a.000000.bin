{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include <algorithm>\\n#include <cstddef>\\n#include <iostream>\\n#include <iterator>\\n#include <string>\\n#include <vector>\\n\\n#if defined(__aarch64__) && defined(__ARM_NEON)\\n#include <arm_neon.h>\\n#endif\\n\\nstruct PrintPermutation\\n{\\n    template <typename Iter> auto\\n    operator () (Iter first, Iter last) const -> void\\n    {\\n        std::cout << \\\"[ \\\" ;\\n        while (first != last) {\\n            std::cout << *first << \\\" \\\" ;\\n            ++ first ;\\n        }\\n        std::cout << \\\"]\\\" << std::endl ;\\n    }\\n} ;\\n\\nstruct IsWhitespace\\n{\\n    template <typename Char> auto\\n    operator () (Char c) const -> bool\\n    {\\n        return (c == ' ' )\\n            || (c == '\\\\n')\\n            || (c == '\\\\r')\\n            || (c == '\\\\t')\\n            || (c == '\\\\f')\\n            || (c == '\\\\v') ;\\n    }\\n} ;\\n\\ntemplate <typename String> inline auto\\nremove_whitespaces (String text) -> String\\n{\\n    text.erase\\n        ( std::remove_if\\n            ( text.begin ()\\n            , text.end ()\\n            , IsWhitespace () )\\n        , text.end () ) ;\\n    return text ;\\n}\\n\\ntemplate <typename Iter> auto\\nfind_longest_non_increasing_suffix (Iter first, Iter last) -> Iter\\n{\\n    if (first == last) return last ;\\n    Iter suffix = std::prev (last) ;\\n    if (suffix == first) return last ;\\n    while (suffix != first) {\\n        Iter before = std::prev (suffix) ;\\n        if (*before < *suffix) return suffix ;\\n        suffix = before ;\\n    }\\n    return first ;\\n}\\n\\ntemplate <typename Iter> auto\\nfind_rightmost_successor (Iter first, Iter second, Iter last) -> Iter\\n{\\n    if (second == last) return last ;\\n    do {\\n        -- last ;\\n    } while ((second != last) && (*last <= *first)) ;\\n    return last ;\\n}\\n\\ntemplate <typename Iter> auto\\nnext_permutation (Iter first, Iter last) -> bool\\n{\\n    if (first == last) return false ;\\n    Iter suffix = find_longest_non_increasing_suffix (first, last) ;\\n    if (suffix == first) return false ;\\n    if (suffix == last)  return false ;\\n    Iter pivot = std::prev (suffix) ;\\n    Iter successor = find_rightmost_successor (pivot, suffix, last) ;\\n    std::iter_swap (pivot, successor) ;\\n    std::reverse (suffix, last) ;\\n    return true ;\\n}\\n\\ntemplate <typename Iter, typename Function> inline auto\\npermutations_iter (Iter first, Iter last, Function driver) -> void\\n{\\n    if (first == last) return ;\\n    std::sort (first, last) ;\\n    do {\\n        driver (first, last) ;\\n    } while (::next_permutation (first, last)) ;\\n    return ;\\n}\\n\\ntemplate <typename String, typename Function> inline auto\\npermutations (String text, Function driver) -> void\\n{\\n    permutations_iter (std::begin (text), std::end (text), driver) ;\\n}\\n\\nstatic inline auto\\npack_symbols (char const *symbols, std::size_t n, char *out) -> void\\n{\\n    std::size_t i = 0 ;\\n#if defined(__aarch64__) && defined(__ARM_NEON)\\n    // Only independent output pairs are vectorized, not successor generation.\\n    for (; n - i >= 16; i += 16) {\\n        uint8x16x2_t pairs ;\\n        pairs.val[0] = vld1q_u8\\n            (reinterpret_cast<uint8_t const *> (symbols + i)) ;\\n        pairs.val[1] = vdupq_n_u8 (' ') ;\\n        vst2q_u8 (reinterpret_cast<uint8_t *> (out + 2 * i), pairs) ;\\n    }\\n    if (n - i >= 8) {\\n        uint8x8x2_t pairs ;\\n        pairs.val[0] = vld1_u8\\n            (reinterpret_cast<uint8_t const *> (symbols + i)) ;\\n        pairs.val[1] = vdup_n_u8 (' ') ;\\n        vst2_u8 (reinterpret_cast<uint8_t *> (out + 2 * i), pairs) ;\\n        i += 8 ;\\n    }\\n#endif\\n    // Spaces and delimiters are initialized once for every buffer slot.\\n    for (; i < n; ++ i) {\\n        out[2 * i] = symbols[i] ;\\n    }\\n}\\n\\nstatic auto\\nbuffered_permutations (std::string text) -> void\\n{\\n    if (text.empty ()) return ;\\n\\n    const std::size_t capacity = 64 * 1024 ;\\n    const std::size_t n = text.size () ;\\n\\n    // Check before multiplying; oversized records retain streaming output.\\n    if (n > (capacity - 4) / 2) {\\n        permutations_iter (text.begin (), text.end (), PrintPermutation ()) ;\\n        return ;\\n    }\\n\\n    std::sort (text.begin (), text.end ()) ;\\n    const std::size_t record_size = 2 * n + 4 ;\\n    const std::size_t batch_size = (capacity / record_size) * record_size ;\\n    std::vector<char> batch (batch_size, ' ') ;\\n    for (std::size_t offset = 0; offset < batch_size; offset += record_size) {\\n        batch[offset] = '[' ;\\n        batch[offset + record_size - 2] = ']' ;\\n        batch[offset + record_size - 1] = '\\\\n' ;\\n    }\\n\\n    std::size_t used = 0 ;\\n    do {\\n        pack_symbols (text.data (), n, batch.data () + used + 2) ;\\n        used += record_size ;\\n        if (used == batch_size) {\\n            std::cout.write (batch.data (), static_cast<std::streamsize> (used)) ;\\n            used = 0 ;\\n        }\\n    } while (::next_permutation (text.begin (), text.end ())) ;\\n\\n    if (used != 0) {\\n        std::cout.write (batch.data (), static_cast<std::streamsize> (used)) ;\\n    }\\n}\\n\\ntemplate <typename String, typename InStream> inline auto\\nread_text_from_stdin (InStream& in) -> String\\n{\\n    std::istreambuf_iterator <char> begin (in), end ;\\n    std::string text (begin, end) ;\\n    text = remove_whitespaces (text) ;\\n    return text ;\\n}\\n\\nint main (int argc, char const *argv [])\\n{\\n    std::string text = read_text_from_stdin <std::string> (std::cin) ;\\n    buffered_permutations (text) ;\\n    return 0 ;\\n}\\n\",\n      \"path\": \"src/permutations.cc\"\n    }\n  ],\n  \"hypothesis\": \"ARM64 SIMD packing of independent character/space pairs into bounded output batches should reduce formatting and stream overhead while preserving sequential permutation dependencies.\",\n  \"notes\": \"No commands or measurements were run. Native char ordering, duplicate suppression, whitespace filtering and output bytes are preserved. Additional output storage is capped at 64 KiB.\",\n  \"research\": {\n    \"queries\": [],\n    \"urls\": []\n  },\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Use guarded AArch64 NEON interleaved stores for complete 16- and 8-character groups, with bounded scalar tails and a scalar fallback.\",\n    \"Preinitialize fixed record separators in a reusable 64 KiB output batch and replace per-character stream operations with bulk writes.\",\n    \"Keep permutation generation sequential and repair the terminating suffix scan so it never decrements before begin.\",\n    \"Check record capacity before size arithmetic and retain streaming output for oversized records.\"\n  ]\n}"}}

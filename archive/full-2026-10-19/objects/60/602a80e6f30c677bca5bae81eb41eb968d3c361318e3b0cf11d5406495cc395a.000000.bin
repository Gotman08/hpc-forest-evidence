        "content": "#include <iostream>\n#include <vector>\n#include <utility>\n\n#ifdef _OPENMP\n#include <omp.h>\n#include <sstream>\n#include <string>\n#endif\n\nusing namespace std;\n\ntypedef vector<vector<bool>> adjacency_matrix;\n\nadjacency_matrix readGraph();\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2, const vector<int> &equivalence);\ninline void printPermutation(const vector<int> &equivalence);\n\n#ifdef _OPENMP\nnamespace {\n\nconst int heap_block_width = 7;\n\nstruct permutation_block {\n    vector<int> equivalence;\n    string output;\n};\n\nbool advanceHeapBlock(vector<int> &equivalence, vector<int> &exchange_counter){\n    // A complete seven-element Heap traversal exchanges only positions 0 and 6.\n    swap(equivalence[0], equivalence[heap_block_width - 1]);\n\n    int exchange_index = heap_block_width;\n    while(exchange_index < static_cast<int>(equivalence.size())){\n        if(exchange_counter[exchange_index] < exchange_index){\n            int other = exchange_index % 2 == 0 ? 0 : exchange_counter[exchange_index];\n            swap(equivalence[other], equivalence[exchange_index]);\n            ++exchange_counter[exchange_index];\n            return true;\n        }\n        exchange_counter[exchange_index] = 0;\n        ++exchange_index;\n    }\n    return false;\n}\n\nvoid enumerateHeapBlock(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                        permutation_block &block){\n    vector<int> &equivalence = block.equivalence;\n    int exchange_counter[heap_block_width] = {};\n    int exchange_index = 1;\n    ostringstream output;\n\n    const auto record = [&](){\n        if(verifyPermutation(g1, g2, equivalence)){\n            for(int value : equivalence)\n                output << value << \" \";\n            output << '\\n';\n        }\n    };\n\n    record();\n    while(exchange_index < heap_block_width){\n        if(exchange_counter[exchange_index] < exchange_index){\n            int other = exchange_index % 2 == 0 ? 0 : exchange_counter[exchange_index];\n            swap(equivalence[other], equivalence[exchange_index]);\n            record();\n            ++exchange_counter[exchange_index];\n            exchange_index = 1;\n        }else{\n            exchange_counter[exchange_index] = 0;\n            ++exchange_index;\n        }\n    }\n    block.output = output.str();\n}\n\nbool testIsomorphismParallel(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                             vector<int> &equivalence, vector<int> &exchange_counter){\n    vector<permutation_block> blocks;\n    int block_count = 0;\n    bool more_blocks = true;\n    bool isomorphism_found = false;\n\n    #pragma omp parallel\n    {\n        #pragma omp single\n        {\n            blocks.resize(static_cast<size_t>(omp_get_num_threads()) * 4);\n        }\n\n        while(true){\n            #pragma omp single\n            {\n                block_count = 0;\n                while(more_blocks && block_count < static_cast<int>(blocks.size())){\n                    blocks[block_count].equivalence = equivalence;\n                    ++block_count;\n                    more_blocks = advanceHeapBlock(equivalence, exchange_counter);\n                }\n            }\n\n            if(block_count == 0)\n                break;\n\n            #pragma omp for schedule(dynamic, 1)\n            for(int block = 0; block < block_count; ++block){\n                enumerateHeapBlock(g1, g2, blocks[block]);\n            }\n\n            // The preceding barrier makes every block buffer ready for ordered output.\n            #pragma omp single\n            {\n                bool emitted = false;\n                for(int block = 0; block < block_count; ++block){\n                    if(!blocks[block].output.empty()){\n                        cout << blocks[block].output;\n                        isomorphism_found = true;\n                        emitted = true;\n                    }\n                }\n                if(emitted)\n                    cout.flush();\n            }\n        }\n    }\n    return isomorphism_found;\n}\n\n}\n#endif\n\nint main(){\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if(!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\n    vector<int> equivalence(g1.size(), 0);\n    vector<int> exchange_counter(g1.size(), 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    if(g1.size() != g2.size()) return false;\n\n    for(int i = 0; i < equivalence.size(); ++i)\n        equivalence[i] = i;\n\n    if(verifyPermutation(g1, g2, equivalence)){\n        printPermutation(equivalence);\n        return true;\n    }\n\n#ifdef _OPENMP\n    if(g1.size() > static_cast<size_t>(heap_block_width) && omp_get_max_threads() > 1)\n        return testIsomorphismParallel(g1, g2, equivalence, exchange_counter);\n#endif\n\n    /*\n     * Permutations are based on Heap's algorithm, which generates all possible\n     * permutations for a given set of elements.\n     */\n    while(exchange_index < g1.size()){\n        if(exchange_counter[exchange_index] < exchange_index){\n            if(exchange_index % 2 == 0)\n                swap(equivalence[0], equivalence[exchange_index]);\n            else\n                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\n            if(verifyPermutation(g1, g2, equivalence)){\n                printPermutation(equivalence);\n                isomorphism_found = true;\n            }\n\n            exchange_counter[exchange_index]++;\n            exchange_index = 1;\n        }else{\n            exchange_counter[exchange_index] = 0;\n            exchange_index++;\n        }\n    }\n    return isomorphism_found;\n}\n\nadjacency_matrix readGraph(){\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read(vertices);\n    for (int i = 0; i < vertices; ++i)\n        read[i].resize(vertices);\n\n    cin >> edges;\n    for (int i = 0; i < edges; i++) {\n       cin >> source >> destination;\n       read[destination][source] = read[source][destination] = true;\n    }\n\n    return read;\n}\n\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2, const vector<int> &equivalence){\n    for (int i = 0; i < equivalence.size(); ++i) {\n        for (int j = 0; j <= i; ++j) {\n            if(g1[i][j] != g2[equivalence[i]][equivalence[j]]) return false;\n        }\n    }\n   return true;\n}\n\ninline void printPermutation(const vector<int> &equivalence){\n    for (auto i : equivalence)\n        cout << i << \" \";\n    cout << endl;\n}\n",
        "path": "src/brute_isomorphism.cpp"

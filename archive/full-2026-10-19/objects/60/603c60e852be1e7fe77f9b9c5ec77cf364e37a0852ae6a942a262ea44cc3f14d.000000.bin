"""Pure mechanical constraints for a proposed new R4b adapter chain.

This module does not admit, read, write, import source, launch or receive anything.
It is an initial port contract, not a replacement for the complete hash/readback,
allocated qualification, independent integration review and runtime guards.
"""
import re

SCOPE = 'hpc-forest-dynamic-independent-roots-r4b-max'
SOURCE = 'eaff9217499fe268e4d151165a368a83bad1550d921955a9f9256026cfac2d48'
PLAN = 'f927d37098f3fd50cc4916195da3e300bd7c29597ba7ece4b9669abd715897fe'
CLI = 'f6dbf48cb70f62649c645f26c87dc9bf84cc36986202dfad8e12fb5b8ca70312'
HOST = '3b6a9179a4da17fa5fc6948219cd61486dc3b534c683838076d8c61bd311c68e'
Q_REVISION = 'r4b-source110-external-adapters-r2'
SOURCE_FILES = 110
ARTIFACTS = frozenset({'source_zip', 'plan', 'qualification_reception', 'integration_review',
    'cli_identity', 'lane_freshness', 'transport', 'native_contracts', 'pilot_first_start'})
BINDING_FIELDS = ('scope_id', 'model', 'effort', 'session_id', 'job_id', 'remote_root',
                  'source_zip_sha256', 'plan_sha256')
FEATURE_NAMES = ('skip_host_skill_discovery', 'shell_tool', 'unified_exec', 'apps', 'plugins',
    'memories', 'multi_agent', 'multi_agent_v2', 'hooks', 'skill_search', 'browser_use',
    'computer_use', 'image_generation', 'view_image', 'workspace_dependencies', 'code_mode_host',
    'code_mode', 'code_mode_only', 'sleep_tool', 'unbounded_connection_retries', 'shell_snapshot', 'goals')
FEATURES = {name: name == 'code_mode_host' for name in FEATURE_NAMES}
SESSIONS = {
    'gpt-6.1-sol': {'roots':'277b1e33ea5e4af6af1c9144ce970ac4','advice':'b86d18fcf35d4031aa2ef0da49397c4e','harvest':'7c8bc0c5ae22467da05600fb735fc017'},
    'gpt-6-astra': {'roots':'5033baf5d38042efb8ab834a59437d19','advice':'7be16898433e49f4b481045079abbbe8','harvest':'b6fc9cf3951d46d787f319b51905251b'},
    'gpt-5.6-terra': {'roots':'d5007804188a4fc793582a26e47c556c','advice':'7516e40883c64ab8af8a38637d74de3f','harvest':'7d6f357d4e5741bb8349835f358563b2'}}


def need(value, message):
    if not value:
        raise ValueError(message)


def hex_sha(value):
    return isinstance(value, str) and re.fullmatch('[0-9a-f]{64}', value) is not None


def policy_binding(authorization):
    """Extract eight fields only after the real source validator has admitted it.

    Extraction cannot establish the truth of authorization. No positive admission
    or runtime effect is returned by this pure function.
    """
    need(isinstance(authorization, dict) and set(authorization.get('artifacts', {})) == ARTIFACTS,
         'Exactly nine source-defined admission artifacts required')
    need(authorization.get('purpose') == 'technical-contract'
         and authorization.get('model') in SESSIONS
         and SESSIONS[authorization['model']].get(authorization.get('technical_phase')) == authorization.get('session_id'),
         'Only the nine existing technical phase sessions; pilot/extension closed')
    result = {key: authorization[key] for key in BINDING_FIELDS[:6]}
    result.update(source_zip_sha256=authorization['artifacts']['source_zip']['sha256'],
                  plan_sha256=authorization['artifacts']['plan']['sha256'])
    need(all(isinstance(value, str) and value for value in result.values())
         and result['scope_id'] == SCOPE and result['effort'] == 'max'
         and result['source_zip_sha256'] == SOURCE and result['plan_sha256'] == PLAN
         and result['job_id'].isdigit()
         and result['remote_root'] == '/scratch_p/nimarano/hpc-forest-dynamic-r4b-max-' + result['session_id'],
         'Exact eight-field source110 R4b identity required')
    return result


def policy_public_binding(policy, binding):
    """Validate identity/features only; paths/bodies remain private and unread here."""
    need(set(binding) == set(BINDING_FIELDS) and policy.get('schema') == 'hpc-forest-r2g-local-cli-policy-v1'
         and all(policy.get(key) == value for key, value in binding.items())
         and policy.get('cli_executable_sha256') == CLI
         and policy.get('code_mode_host_executable_sha256') == HOST,
         'Policy identity/CLI4-host public binding differs')
    values = policy.get('cli_feature_overrides')
    need(isinstance(values, dict) and set(values) == set(FEATURES)
         and all(values[name] is enabled for name, enabled in FEATURES.items()),
         'Exact22 actual booleans; infrastructure host true only')
    return {'task_cli_policy_contract_schema':policy['schema'], 'cell_binding':dict(binding),
        'host_candidate_only':True, 'runtime_no_tools_proven':False}


def inherited_worker_argv(base_argv, policy_path, policy_sha256):
    """Produce data only, preserving every shared option; never execute it."""
    need(isinstance(base_argv, list) and all(isinstance(x, str) and x for x in base_argv)
         and '--cli-policy' not in base_argv and '--cli-policy-sha256' not in base_argv
         and not any(x.startswith(('--cli-policy=','--cli-policy-sha256=')) for x in base_argv)
         and isinstance(policy_path, str) and policy_path and hex_sha(policy_sha256),
         'One explicit private policy pair required')
    return [*base_argv, '--cli-policy', policy_path, '--cli-policy-sha256', policy_sha256]


def proposed_owner(job_id, session_id, model):
    """Six-field transport OWNER data expected by the sealed inherited worker."""
    need(isinstance(job_id, str) and job_id.isdigit() and model in SESSIONS
         and session_id in SESSIONS[model].values(), 'Exact planned technical owner required')
    return {'protocol':'hpc-forest-codex-mailbox-v1', 'session_id':session_id, 'model':model,
            'reasoning_effort':'max', 'job_id':job_id, 'owner':job_id}


def qualification_claim_bindings(actual, audit, *, components_sha256):
    """New identity equality only; callers must still hash all original Q refs.

    This does not accept templates as evidence, does not qualify target/reference
    contracts and never returns an admission. A complete ported chain must combine
    it with the existing allocation/archive/readback/full review checks.
    """
    need(hex_sha(components_sha256), 'Concrete new component manifest digest required')
    for value in (actual, audit):
        need(value.get('scope_id') == SCOPE and value.get('source_zip_sha256') == SOURCE
             and value.get('plan_sha256') == PLAN
             and value.get('adapter_components_manifest_sha256') == components_sha256
             and value.get('verified') is True and type(value.get('native_model_calls')) is int
             and value['native_model_calls'] == 0, 'New exact-source/component qualification identity required')
    need(actual.get('adapter_revision') == Q_REVISION
         and type(actual.get('source_file_count')) is int and actual['source_file_count'] == SOURCE_FILES
         and actual.get('source_lane_contract_tests') == {'passed':26,'failed':0}
         and all(type(v) is int for v in actual['source_lane_contract_tests'].values()),
         'Source110 and distinct26lane suite required;187 is not the lane count')
    tests = actual.get('adapter_portable_tests')
    need(isinstance(tests, dict) and set(tests) == {'passed','failed'}
         and all(type(v) is int for v in tests.values()) and tests['passed'] > 0 and tests['failed'] == 0,
         'Actual separate portable adapter tests required')

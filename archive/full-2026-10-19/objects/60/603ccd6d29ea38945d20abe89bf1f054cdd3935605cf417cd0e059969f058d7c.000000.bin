        "ordinal": 2,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/permutations.cc"
          ],
          "retained": [
            "Generate successive formatted rows directly within a bounded output block using contiguous copies and stride-two lexicographic pivot, swap, and reversal operations.",
            "Write completed blocks in bulk and drain the final partial block.",
            "Provide buffered streaming for rows larger than the block without computing an overflowing row size.",
            "Disable unnecessary standard-stream synchronization and input tying."
          ]
        },

        "epoch": 1,
        "hypothesis": "Serializing permutations directly into a bounded contiguous output buffer will improve locality and reduce formatted-insertion and per-row flushing overhead without changing enumeration.",
        "id": "90bfa7326ffb46ed",
        "ordinal": 1,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/permutations.cc"
          ],
          "retained": [
            "Batch complete rows in a fixed 64 KiB buffer and emit bulk ostream writes.",
            "Serialize bytes directly, checking capacity once per ordinary row; stream oversized rows through the same bounded buffer without row-size overflow.",
            "Disable C/C++ stream synchronization, untie input, share one printer by reference and drain output at completion."
          ]
        },

        "delegation_parent": "R/C",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Buffered prefix-subtree generation with two or three OpenMP producers and one ordered writer can amortize output overhead while preserving exact lexicographic output.",
        "id": "7debc36c39ac4854",
        "ordinal": 1,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/permutations.cc"
          ],
          "retained": [
            "Replace formatted insertions and per-line flushing with bounded 64 KiB output blocks.",
            "Partition the actual multiset into ordered prefix subtrees using overflow-saturating multinomial estimates.",
            "Dynamically assign tasks monotonically to producers; one writer drains them in lexical order through two bounded blocks per producer.",
            "Select serial, three-thread, or four-thread execution by estimated work and available OpenMP threads; handle reduced actual teams safely.",
            "Preserve native char ordering, six-character whitespace filtering, duplicate elimination, and empty-input behavior."
          ]
        },
        "tree_id": "e1:C",

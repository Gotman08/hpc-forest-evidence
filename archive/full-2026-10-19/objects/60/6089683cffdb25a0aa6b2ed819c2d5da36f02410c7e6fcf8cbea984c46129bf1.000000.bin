ub.com/repos/ollama/ollama/releases/assets/638735111","id":638735111,"node_id":"RA_kwDOJ0Z1Ps4mElMH","name":"sha256sum.txt","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"text/plain; charset=utf-8","state":"uploaded","size":1472,"digest":"sha256:216d306cbce4a048ccbb61d808394696e17e23913bff3663c61c7167c15731e9","download_count":2378,"created_at":"2026-10-14T00:53:27Z","updated_at":"2026-10-14T00:53:28Z","browser_download_url":"https://github.com/ollama/ollama/releases/download/v0.40.4/sha256sum.txt"}],"tarball_url":"https://api.github.com/repos/ollama/ollama/tarball/v0.40.4","zipball_url":"https://api.github.com/repos/ollama/ollama/zipball/v0.40.4","body":"## Decision models in the CLI\r\nDecision models can now be used directly from the terminal with `ollama run` — ask yes/no questions, classify text into labels, or score against a rubric:\r\n`ollama run nimble --ask \"Is a refund being requested?\" < ticket.txt`\r\n\r\n ## What's Changed\r\n  * Kev decision models are now supported by the MLX runner on Apple silicon\r\n  * `ollama launch` can now be used with usage credits without upgrading to a paid plan\r\n  * `ollama launch codex` now includes locally installed Ollama models in its model picker. Use `/model` within the Codex CLI to swap models.\r\n  * Improved inference performance by reusing verified manifests and already loaded models\r\n  * Added support for multimodal embeddings through llama-server\r\n  * Fixed loading multimodal embedding models with small context windows\r\n  * Improved Gemma 4 prefill performance on NVIDIA GPUs with the MLX runner\r\n  * MLX runner now clips long Laya states instead of rejecting them\r\n  * Improved speculative decoding reliability in the MLX runner, including recurrent state handling after rollback\r\n   * Updated llama.cpp with native decision model support\r\n  * Updated README and documentation with clearer privacy and cloud-services wording\r\n\r\n  \r\n  **Full Changelog**: https://github.com/ollama/ollama/compare/v0.40.3...v0.40.4","reactions":{"url":"https://api.github.com/repos/ollama/ollama/releases/410905890/reactions","total_count":18,"+1":11,"-1":0,"laugh":0,"hooray":7,"confused":0,"heart":0,"rocket":0,"eyes":0}}
{"files":[{"content":"#include<stdio.h>\n#include<stdlib.h>\n#include<math.h>\n\nstatic void bubble_sort(double *matriz, int tam) {\n    int i, j;\n    double aux;\n\n    for (i = tam - 1; i > 0; i--) {\n        for (j = 0; j < i; j++) {\n            if (matriz[j] > matriz[j + 1]) {\n                aux = matriz[j];\n                matriz[j] = matriz[j + 1];\n                matriz[j + 1] = aux;\n            }\n        }\n    }\n}\n\nstatic int compara_double(const void *esquerda, const void *direita) {\n    double a = *(const double *)esquerda;\n    double b = *(const double *)direita;\n\n    return (a > b) - (a < b);\n}\n\nstatic int requer_bubble_sort(const double *matriz, int tam) {\n    int i;\n    int sinal_zero = 0;\n\n    for (i = 0; i < tam; i++) {\n        if (isnan(matriz[i])) {\n            return 1;\n        }\n        if (matriz[i] == 0.0) {\n            int sinal_atual = signbit(matriz[i]) ? 2 : 1;\n            if (sinal_zero != 0 && sinal_zero != sinal_atual) {\n                return 1;\n            }\n            sinal_zero = sinal_atual;\n        }\n    }\n    return 0;\n}\n\nvoid ordena_colunas(double *matriz, int lin, int col) {\n    int i;\n\n    for (i = 0; i < col; i++) {\n        double *coluna = matriz + i * lin;\n        if (requer_bubble_sort(coluna, lin)) {\n            bubble_sort(coluna, lin);\n        } else {\n            qsort(coluna, (size_t)lin, sizeof(*coluna), compara_double);\n        }\n    }\n}\n\nvoid calcula_medias(double *matriz, double *media, double *media_har, int lin, int col) {\n    int i, j;\n\n    for (i = 0; i < col; i++) {\n        double soma = 0;\n        double soma_harmonica = 0;\n        double *coluna = matriz + i * lin;\n\n        for (j = 0; j < lin; j++) {\n            soma += coluna[j];\n            soma_harmonica += 1 / coluna[j];\n        }\n        media[i] = soma / lin;\n        media_har[i] = lin / soma_harmonica;\n    }\n}\n\nvoid calcula_mediana(double *matriz, double *vet, int lin, int col) {\n    int i = 0;\n    if ((lin - 1) % 2) {\n        for (i = 0; i < col; i++) {\n            vet[i] = (matriz[(((i * lin) + (i + 1) * lin) - 1) / 2] + matriz[((((i * lin) + (i + 1) * lin) - 1) / 2) + 1]);\n            vet[i] *= 0.5;\n        }\n    } else {\n        for (i = 0; i < col; i++) {\n            vet[i] = matriz[(((i * lin) + (i + 1) * lin) - 1) / 2];\n        }\n    }\n}\n\ndouble moda_aux(double *matriz, int lin) {\n    int i = 0;\n    float conta = 0;\n    double moda = 0;\n\n    while (i < lin) {\n        int j = i + 1;\n        double cont = 0;\n\n        while (j < lin && matriz[i] == matriz[j]) {\n            cont++;\n            if (cont > conta) {\n                conta = cont;\n                moda = matriz[i];\n            }\n            j++;\n        }\n        i = j;\n    }\n\n    if (conta == 0) {\n        return -1;\n    }\n    return moda;\n}\n\nvoid calcula_moda(double *matriz, double *moda, int lin, int col) {\n    int i;\n    for (i = 0; i < col; i++) {\n        moda[i] = moda_aux(matriz + (i * lin), lin);\n    }\n}\n\nvoid calcula_variancia(double *matriz, double *media, double *variancia, int lin, int col) {\n    int i, j;\n    double soma;\n    for (i = 0; i < col; i++) {\n        soma = 0;\n        for (j = 0; j < lin; j++) {\n            soma += pow((matriz[i * lin + j] - media[i]), 2);\n        }\n        variancia[i] = soma / (lin - 1);\n    }\n}\n\nvoid calcula_desvio_padrao(double *variancia, double *dp, int col) {\n    int i;\n    for (i = 0; i < col; i++) {\n        dp[i] = sqrt(variancia[i]);\n    }\n}\n\nvoid calcula_coeficiente_variacao(double *media, double *dp, double *cv, int col) {\n    int i;\n    for (i = 0; i < col; i++) {\n        cv[i] = dp[i] / media[i];\n    }\n}\n\nint main(int argc, char **argv) {\n    int lin, col, i, j;\n    double *matriz, *mediana, *media, *media_har, *moda, *variancia, *dp, *cv;\n\n    fscanf(stdin, \"%d \", &lin);\n    fscanf(stdin, \"%d\\n\", &col);\n\n    matriz = (double *)malloc(lin * col * sizeof(double));\n    media = (double *)malloc(col * sizeof(double));\n    media_har = (double *)malloc(col * sizeof(double));\n    mediana = (double *)malloc(col * sizeof(double));\n    moda = (double *)malloc(col * sizeof(double));\n    variancia = (double *)malloc(col * sizeof(double));\n    cv = (double *)malloc(col * sizeof(double));\n    dp = (double *)malloc(col * sizeof(double));\n\n    for (i = 0; i < lin; i++) {\n        for (j = 0; j < col; j++) {\n            fscanf(stdin, \"%lf \", &(matriz[j * lin + i]));\n        }\n    }\n\n    calcula_medias(matriz, media, media_har, lin, col);\n    ordena_colunas(matriz, lin, col);\n    calcula_mediana(matriz, mediana, lin, col);\n    calcula_moda(matriz, moda, lin, col);\n    calcula_variancia(matriz, media, variancia, lin, col);\n    calcula_desvio_padrao(variancia, dp, col);\n    calcula_coeficiente_variacao(media, dp, cv, col);\n\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", media[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", media_har[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", mediana[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", moda[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", variancia[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", dp[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", cv[i]);\n    printf(\"\\n\");\n\n    free(matriz);\n    free(media);\n    free(media_har);\n    free(mediana);\n    free(moda);\n    free(variancia);\n    free(dp);\n    free(cv);\n}\n","path":"src/est_matriz_seq.c"}],"hypothesis":"Replacing quadratic per-column ordering and mode searches with linear-contiguous passes plus library sorting will materially reduce runtime while retaining the calculation and output order.","notes":"Columns containing NaNs or both signed-zero representations retain the original stable bubble-sort path; the linear mode scan preserves the original sorted-run tie order while removing its per-column temporary allocation.","research":{"queries":[],"urls":[]},"sources_kept":[],"transformations":["Fuse arithmetic and harmonic mean accumulation into one contiguous per-column traversal without changing either sum's element order.","Use qsort for ordinary numeric columns instead of repeated adjacent swaps, retaining bubble sort for special columns where stability can affect observable floating-point representation.","Replace the quadratic mode comparison loops with a single scan of sorted equal-value runs, retaining strict first-run tie selection."]}
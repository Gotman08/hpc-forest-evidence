#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <climits>

int main() {
    int n, s;
    std::cin >> n >> s;
    std::vector<std::vector<int>> matrix(n, std::vector<int>(n));
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++) 
            scanf("%d", &(matrix[i][j]));

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    const int blockSize = 32;
    int mxSum = INT_MIN;

    for (int bi = 0; bi < n; bi += blockSize) {
        for (int bj = 0; bj < n; bj += blockSize) {
            int sum = 0;
            // Initialize the sum for the first block
            for (int i = bi; i < std::min(bi + blockSize, s); i++) {
                for (int j = bj; j < std::min(bj + blockSize, s); j++) {
                    sum += matrix[i][j];
                }
            }
            mxSum = std::max(mxSum, sum);

            // Slide the block horizontally within the first row of blocks
            for (int i = bi; i < std::min(bi + blockSize, s); i++) {
                for (int j = bj; j < n - blockSize; j += blockSize) {
                    if (j + s < n) {
                        sum -= matrix[i][j];
                        sum += matrix[i][j + s];
                    }
                    mxSum = std::max(mxSum, sum);
                }
            }

            // Slide the block vertically within the first column of blocks
            for (int j = bj; j < std::min(bj + blockSize, n); j++) {
                for (int i = bi; i < n - blockSize; i += blockSize) {
                    if (i + s < n) {
                        for (int k = j; k < std::min(j + blockSize, n); k++) {
                            sum -= matrix[i][k];
                            sum += matrix[i + s][k];
                        }
                    }
                    mxSum = std::max(mxSum, sum);
                }
            }
        }
    }

    printf("%d\n", mxSum);
}
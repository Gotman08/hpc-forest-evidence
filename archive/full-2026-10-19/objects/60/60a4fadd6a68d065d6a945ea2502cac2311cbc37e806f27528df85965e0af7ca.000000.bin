      "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <limits>\n#include <memory>\n\nclass FastInput {\n    static constexpr std::size_t BufferSize = 1u << 16;\n    unsigned char buffer[BufferSize];\n    std::size_t position = 0;\n    std::size_t available = 0;\n\n    int get() {\n        if (position == available) {\n            available = std::fread(buffer, 1, BufferSize, stdin);\n            position = 0;\n            if (available == 0) return EOF;\n        }\n        return buffer[position++];\n    }\n\npublic:\n    bool next(std::uint32_t& value) {\n        int c;\n        do {\n            c = get();\n            if (c == EOF) return false;\n        } while (c <= ' ');\n\n        bool negative = false;\n        if (c == '-' || c == '+') {\n            negative = c == '-';\n            c = get();\n        }\n\n        std::uint32_t magnitude = 0;\n        while (c >= '0' && c <= '9') {\n            magnitude = magnitude * 10u + static_cast<std::uint32_t>(c - '0');\n            c = get();\n        }\n        value = negative ? 0u - magnitude : magnitude;\n        return true;\n    }\n};\n\nint main() {\n    FastInput input;\n    std::uint32_t inputN, inputS;\n    if (!input.next(inputN) || !input.next(inputS)) return 0;\n    const int n = static_cast<int>(inputN);\n    const int s = static_cast<int>(inputS);\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const int width = n - s + 1;\n    constexpr int MaxStripWidth = 256;\n    constexpr int TargetLanes = 4;\n    const int groups = (width + TargetLanes * MaxStripWidth - 1)\n                     / (TargetLanes * MaxStripWidth);\n    const int desiredStrips = std::min(width, TargetLanes * groups);\n    const int stripWidth = (width + desiredStrips - 1) / desiredStrips;\n    const int stripCount = (width + stripWidth - 1) / stripWidth;\n    const std::size_t matrixElements = static_cast<std::size_t>(n) * width;\n\n    std::unique_ptr<std::uint32_t[]> horizontal(new std::uint32_t[matrixElements]);\n    std::unique_ptr<std::uint32_t[]> row(new std::uint32_t[n]);\n\n    for (int r = 0; r < n; ++r) {\n        std::uint32_t window = 0;\n        for (int c = 0; c < s; ++c) {\n            input.next(row[c]);\n            window += row[c];\n        }\n        horizontal[static_cast<std::size_t>(r) * stripWidth] = window;\n\n        for (int b = 0; b < stripCount; ++b) {\n            const int firstColumn = b * stripWidth;\n            const int columns = std::min(stripWidth, width - firstColumn);\n            std::uint32_t* destination = horizontal.get()\n                + static_cast<std::size_t>(n) * firstColumn\n                + static_cast<std::size_t>(r) * columns;\n            const int begin = b == 0 ? 1 : 0;\n            for (int k = begin; k < columns; ++k) {\n                const int c = firstColumn + k;\n                std::uint32_t incoming = 0;\n                input.next(incoming);\n                row[c + s - 1] = incoming;\n                window += incoming - row[c - 1];\n                destination[k] = window;\n            }\n        }\n    }\n\n    const std::uint32_t* const data = horizontal.get();\n    std::int32_t best = std::numeric_limits<std::int32_t>::min();\n\n#ifdef _OPENMP\n#pragma omp parallel for schedule(static) reduction(max:best) if(stripCount > 1 && matrixElements >= 262144u)\n#endif\n    for (int b = 0; b < stripCount; ++b) {\n        const int firstColumn = b * stripWidth;\n        const int columns = std::min(stripWidth, width - firstColumn);\n        const std::uint32_t* const strip = data\n            + static_cast<std::size_t>(n) * firstColumn;\n        alignas(64) std::uint32_t sums[MaxStripWidth] = {};\n\n        for (int r = 0; r < s; ++r) {\n            const std::uint32_t* source = strip + static_cast<std::size_t>(r) * columns;\n#ifdef _OPENMP\n#pragma omp simd\n#endif\n            for (int k = 0; k < columns; ++k) {\n                sums[k] += source[k];\n            }\n        }\n\n        std::int32_t stripBest = std::numeric_limits<std::int32_t>::min();\n#ifdef _OPENMP\n#pragma omp simd reduction(max:stripBest)\n#endif\n        for (int k = 0; k < columns; ++k) {\n            stripBest = std::max(stripBest, static_cast<std::int32_t>(sums[k]));\n        }\n\n        const std::uint32_t* entering = strip + static_cast<std::size_t>(s) * columns;\n        const std::uint32_t* leaving = strip;\n        for (int r = s; r < n; ++r) {\n#ifdef _OPENMP\n#pragma omp simd reduction(max:stripBest)\n#endif\n            for (int k = 0; k < columns; ++k) {\n                const std::uint32_t value = sums[k] + entering[k] - leaving[k];\n                sums[k] = value;\n                stripBest = std::max(stripBest, static_cast<std::int32_t>(value));\n            }\n            entering += columns;\n            leaving += columns;\n        }\n        best = std::max(best, stripBest);\n    }\n\n    std::printf(\"%d\\n\", static_cast<int>(best));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Compact strip-major horizontal windows should make vertical sliding updates sequential, keep accumulators cache-resident, and replace the baseline's strided O(SN²) traversal with O(N²) work.",

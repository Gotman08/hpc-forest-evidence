"""Seal our cold audit, preserving all previous refusals and source versions."""
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
RX = HERE.parent


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def save(name, value):
    with (HERE / name).open("x", encoding="utf8", newline="\n") as stream:
        stream.write(json.dumps(value, indent=2, ensure_ascii=False) + "\n")


report_path = HERE / "passage-06-AUDIT-INDEPENDANT.json"
report = json.loads(report_path.read_text(encoding="utf8"))
assert report["verified"] is True and report["all15_final_confirmations_verified"] is True
capture = json.loads((RX / "reconciliation-livraisons-r1/capture-01/PRESERVATION-PAR-NONCE.json").read_text(encoding="utf8"))
archived_ready = 0
for name, item in capture["files"].items():
    if not name.endswith("/response-ready.json"):
        continue
    nonce = name.split("/", 1)[0]
    archived = RX / "restauration-neuve/results-751592/mailbox/responses" / (nonce + ".ready.json")
    if archived.is_file():
        assert sha(archived) == item["sha256"]
        archived_ready += 1
    else:
        assert nonce == "797dc3a81f5a42ea9a9bffcfe3d5438d"
assert archived_ready == 123
save("CONTROLE-READY-ARCHIVES.json", {"verified": True, "archived_ready_byte_identical": archived_ready,
    "late_ready_separately_readback_verified": True, "receipt": report["late_remote_readback"],
    "live_cache_opened": False, "candidate_or_model_executed": False})
with (HERE / "AUDIT-INDEPENDANT.json").open("xb") as stream:
    stream.write(report_path.read_bytes())
save("REFUS-CONSERVES-EXPLICATIONS.json", {
    "all_original_refusals_and_reader_versions_preserved": True,
    "classification": "reader assumptions corrected against immutable source-only94 evidence; no candidate repair or result rewrite",
    "passage-01": "Archive manifest and restorer manifest have identical JSON structures, different original serializations; both raw SHAs retained.",
    "passage-02": "Windows read_text normalized CRLF; changed our comparison to read_bytes().decode() so Git/source bytes remain exact.",
    "passage-03": "mother_may_change_tests is absent on four historical2022 preparations; trusted contract hashes and all non-src Git files remain invariant.",
    "passage-04": "Worker request.json is a different serialization of the complete original request; both raw hashes remain bound and canonical full objects are equal.",
    "passage-05": "Our WARN-only diagnostic filter was inapplicable to source-only94: ANSI-decorated WARN and documented ERROR loggers are accounted, never promoted to NORMAL/R3.",
    "foreign_evidence_modified": False, "live_actions": False})
files = {p.name: {"sha256": sha(p), "bytes": p.stat().st_size} for p in sorted(HERE.iterdir()) if p.is_file()}
save("MANIFESTE-AUDIT-INDEPENDANT.json", {"schema": "hpc-forest-independent-audit-delivery-manifest-v1", "files": files,
    "audit": {"path": str(HERE / "AUDIT-INDEPENDANT.json"), "sha256": sha(HERE / "AUDIT-INDEPENDANT.json")},
    "scope": "cold recorded scientific evidence + source-only delivery/usage metadata only", "native_global_admission": False,
    "candidate_or_model_executions": 0, "stop_authorized": False})
print(json.dumps({"audit_sha256": sha(HERE / "AUDIT-INDEPENDANT.json"),
                  "manifest_sha256": sha(HERE / "MANIFESTE-AUDIT-INDEPENDANT.json"),
                  "ready_supplement_sha256": sha(HERE / "CONTROLE-READY-ARCHIVES.json")}))

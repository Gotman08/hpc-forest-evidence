        "content": "#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdio>\n#include <memory>\n#include <vector>\n\nclass FastInput {\n    unsigned char buffer_[1 << 16];\n    std::size_t position_ = 0;\n    std::size_t length_ = 0;\n\n    int nextByte() {\n        if (position_ == length_) {\n            length_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\n            position_ = 0;\n            if (length_ == 0) return EOF;\n        }\n        return buffer_[position_++];\n    }\n\npublic:\n    bool readInt(int& result) {\n        int c = nextByte();\n        while (c != EOF && c <= ' ') c = nextByte();\n        if (c == EOF) return false;\n\n        const bool negative = c == '-';\n        if (negative || c == '+') c = nextByte();\n        long long value = 0;\n        while (c >= '0' && c <= '9') {\n            value = value * 10 + (c - '0');\n            c = nextByte();\n        }\n        result = static_cast<int>(negative ? -value : value);\n        return true;\n    }\n};\n\ntemplate<bool RetainRow>\nstatic void advanceRow(FastInput& input, int n, int s, int* outgoing,\n                       long long* columns, long long& best) {\n    long long window = 0;\n    for (int c = 0; c < s; ++c) {\n        int value = 0;\n        input.readInt(value);\n        const long long updated = columns[c]\n            + static_cast<long long>(value)\n            - static_cast<long long>(outgoing[c]);\n        columns[c] = updated;\n        if (RetainRow) outgoing[c] = value;\n        window += updated;\n    }\n    if (window > best) best = window;\n\n    for (int c = s; c < n; ++c) {\n        int value = 0;\n        input.readInt(value);\n        const long long updated = columns[c]\n            + static_cast<long long>(value)\n            - static_cast<long long>(outgoing[c]);\n        columns[c] = updated;\n        if (RetainRow) outgoing[c] = value;\n        // The departing column has already been updated for this row band.\n        window += updated - columns[c - s];\n        if (window > best) best = window;\n    }\n}\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.readInt(n) || !input.readInt(s)) return 0;\n    assert(n > 0 && n < 8000 && s > 0 && s < n);\n\n    // Only rows numbered below n-s can leave a later complete window.\n    const int retainedRows = std::min(s, n - s);\n    std::unique_ptr<int[]> history(\n        new int[static_cast<std::size_t>(retainedRows) * n]);\n    std::vector<long long> columns(n, 0);\n\n    for (int r = 0; r < s; ++r) {\n        int* saved = r < retainedRows\n            ? history.get() + static_cast<std::size_t>(r) * n\n            : nullptr;\n        for (int c = 0; c < n; ++c) {\n            int value = 0;\n            input.readInt(value);\n            columns[c] += static_cast<long long>(value);\n            if (saved) saved[c] = value;\n        }\n    }\n\n    long long window = 0;\n    for (int c = 0; c < s; ++c) window += columns[c];\n    long long best = window;\n    for (int c = s; c < n; ++c) {\n        window += columns[c] - columns[c - s];\n        if (window > best) best = window;\n    }\n\n    int slot = 0;\n    for (int r = s; r < n; ++r) {\n        int* outgoing = history.get() + static_cast<std::size_t>(slot) * n;\n        if (r < n - s) {\n            advanceRow<true>(input, n, s, outgoing, columns.data(), best);\n        } else {\n            advanceRow<false>(input, n, s, outgoing, columns.data(), best);\n        }\n        if (++slot == retainedRows) slot = 0;\n    }\n\n    std::printf(\"%lld\\n\", best);\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }

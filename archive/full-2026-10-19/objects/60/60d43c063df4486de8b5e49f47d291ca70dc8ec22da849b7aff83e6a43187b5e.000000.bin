        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <limits.h>\n#include <stdint.h>\n\ntypedef struct {\n    const char *strings;\n    size_t stride;\n    unsigned int index_bits;\n    unsigned int prefix_bytes;\n    unsigned long index_mask;\n} radix_context;\n\nstatic unsigned long pack_entry(const char *string, unsigned int bytes,\n                                unsigned int index_bits, unsigned long index) {\n    const unsigned char *p = (const unsigned char *)string;\n    unsigned long prefix = 0;\n\n    for (unsigned int k = 0; k < bytes; ++k) {\n        unsigned long c = *p++;\n        prefix = (prefix << 8) | c;\n        if (c == 0) {\n            prefix <<= 8U * (bytes - k - 1U);\n            break;\n        }\n    }\n    return (prefix << index_bits) | index;\n}\n\nstatic inline int entry_greater(unsigned long left, unsigned long right,\n                                const radix_context *ctx) {\n    unsigned long lp = left >> ctx->index_bits;\n    unsigned long rp = right >> ctx->index_bits;\n\n    if (lp != rp)\n        return lp > rp;\n    if (ctx->prefix_bytes != 0 && (lp & 255UL) == 0)\n        return 0;\n\n    return strcmp(ctx->strings + (size_t)(left & ctx->index_mask) * ctx->stride\n                               + ctx->prefix_bytes,\n                  ctx->strings + (size_t)(right & ctx->index_mask) * ctx->stride\n                               + ctx->prefix_bytes) > 0;\n}\n\nstatic void radix_sort_entries(unsigned long *entries, unsigned long *scratch,\n                               size_t count, size_t depth,\n                               const radix_context *ctx) {\n    enum { INSERTION_CUTOFF = 24 };\n    const unsigned char *strings = (const unsigned char *)ctx->strings;\n\n    while (count > INSERTION_CUTOFF) {\n        size_t counts[256] = {0};\n        size_t next[256];\n        size_t total = 0;\n        size_t largest_count = 0;\n        unsigned int largest = 0;\n        unsigned int nonempty = 0;\n        unsigned int only = 0;\n        int cached = depth < ctx->prefix_bytes;\n        unsigned int shift = 0;\n\n        if (cached) {\n            shift = ctx->index_bits\n                  + 8U * (ctx->prefix_bytes - 1U - (unsigned int)depth);\n            for (size_t i = 0; i < count; ++i)\n                ++counts[(entries[i] >> shift) & 255UL];\n        } else {\n            for (size_t i = 0; i < count; ++i) {\n                size_t index = (size_t)(entries[i] & ctx->index_mask);\n                ++counts[strings[index * ctx->stride + depth]];\n            }\n        }\n\n        for (unsigned int c = 0; c < 256; ++c) {\n            if (counts[c] != 0) {\n                ++nonempty;\n                only = c;\n            }\n        }\n\n        if (nonempty == 1) {\n            if (only == 0)\n                return;\n            ++depth;\n            continue;\n        }\n\n        for (unsigned int c = 0; c < 256; ++c) {\n            next[c] = total;\n            total += counts[c];\n            if (c != 0 && counts[c] > largest_count) {\n                largest_count = counts[c];\n                largest = c;\n            }\n        }\n\n        if (cached) {\n            for (size_t i = 0; i < count; ++i) {\n                unsigned long entry = entries[i];\n                unsigned int c = (unsigned int)((entry >> shift) & 255UL);\n                scratch[next[c]++] = entry;\n            }\n        } else {\n            for (size_t i = 0; i < count; ++i) {\n                unsigned long entry = entries[i];\n                size_t index = (size_t)(entry & ctx->index_mask);\n                unsigned int c = strings[index * ctx->stride + depth];\n                scratch[next[c]++] = entry;\n            }\n        }\n        memcpy(entries, scratch, count * sizeof(*entries));\n\n        /* Bucket zero contains terminated strings and is already sorted. */\n        for (unsigned int c = 1; c < 256; ++c) {\n            if (c != largest && counts[c] > 1) {\n                size_t start = next[c] - counts[c];\n                radix_sort_entries(entries + start, scratch + start,\n                                   counts[c], depth + 1, ctx);\n            }\n        }\n\n        /* Iterate over the largest child to bound recursion depth. */\n        if (largest_count <= 1)\n            return;\n        size_t start = next[largest] - largest_count;\n        entries += start;\n        scratch += start;\n        count = largest_count;\n        ++depth;\n    }\n\n    for (size_t i = 1; i < count; ++i) {\n        unsigned long key = entries[i];\n        size_t j = i;\n        while (j > 0 && entry_greater(entries[j - 1], key, ctx)) {\n            entries[j] = entries[j - 1];\n            --j;\n        }\n        entries[j] = key;\n    }\n}\n\nlong int *bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\n    radix_context ctx;\n    unsigned long max_index;\n    unsigned long *entries;\n    unsigned long *scratch;\n    long int *result;\n    size_t n;\n\n    (void)offset;\n    (void)nbuckets;\n    if (size <= 0)\n        return NULL;\n\n    n = (size_t)size;\n    if (n > SIZE_MAX / sizeof(*result))\n        exit(EXIT_FAILURE);\n    result = (long int *)malloc(n * sizeof(*result));\n    if (result == NULL)\n        exit(EXIT_FAILURE);\n    if (n == 1) {\n        result[0] = 0;\n        return result;\n    }\n\n    scratch = (unsigned long *)malloc(n * sizeof(*scratch));\n    if (scratch == NULL) {\n        free(result);\n        exit(EXIT_FAILURE);\n    }\n\n    ctx.strings = a;\n    ctx.stride = (size_t)length;\n    ctx.index_bits = 0;\n    max_index = (unsigned long)(size - 1);\n    while (max_index != 0) {\n        ++ctx.index_bits;\n        max_index >>= 1;\n    }\n    ctx.prefix_bytes = ((unsigned int)(sizeof(unsigned long) * CHAR_BIT)\n                        - ctx.index_bits) / 8U;\n    ctx.index_mask = (1UL << ctx.index_bits) - 1UL;\n\n    /* Corresponding signed and unsigned types may alias this allocation. */\n    entries = (unsigned long *)result;\n    for (size_t i = 0; i < n; ++i)\n        entries[i] = pack_entry(a + i * ctx.stride, ctx.prefix_bytes,\n                                ctx.index_bits, (unsigned long)i);\n\n    radix_sort_entries(entries, scratch, n, 0, &ctx);\n    for (size_t i = 0; i < n; ++i)\n        result[i] = (long int)(entries[i] & ctx.index_mask);\n\n    free(scratch);\n    return result;\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb) {\n    char *strings = NULL;\n    int len, offset, nbucket;\n    long int n;\n\n    if (!fscanf(stdin, \"%d\", &len)) {\n        printf(\"ERROR len\\n\");\n        exit(1);\n    }\n    if (!fscanf(stdin, \"%ld\", &n)) {\n        printf(\"ERROR n\\n\");\n        exit(1);\n    }\n    if (!fscanf(stdin, \"%d\", &offset)) {\n        printf(\"ERROR offset\\n\");\n        exit(1);\n    }\n    if (!fscanf(stdin, \"%d\", &nbucket)) {\n        printf(\"ERROR nbucket\\n\");\n        exit(1);\n    }\n\n    nbucket = nbucket + 1;\n    len = len + 1;\n    strings = (char *)malloc((size_t)n * (size_t)len);\n\n    for (long int i = 0; i < n; ++i) {\n        if (!fscanf(stdin, \"%s\", strings + (size_t)i * (size_t)len)) {\n            printf(\"ERROR %ld\\n\", i);\n            exit(1);\n        }\n    }\n\n    *vString = strings;\n    *N = n;\n    *l = len;\n    *os = offset;\n    *nb = nbucket;\n}\n\nvoid print(char *strings, long int *index, long int n, int len) {\n    for (long int i = 0; i < n; ++i)\n        printf(\"%ld -> %s\\n\", i,\n               strings + (size_t)index[i] * (size_t)len);\n}\n\nvoid save(char *strings, long int *index, long int n, int len) {\n    for (long int i = 0; i < n; ++i)\n        printf(\"%s\\n\", strings + (size_t)index[i] * (size_t)len);\n}\n\nint main(int ac, char **av) {\n    char *strings = NULL;\n    long int N = 0;\n    long int *index = NULL;\n    int len = 0, offset, nbuckets;\n\n    (void)ac;\n    (void)av;\n    load(&strings, &N, &len, &offset, &nbuckets);\n    index = bucket_sort(strings, len, N, offset, nbuckets);\n    save(strings, index, N, len);\n\n    free(strings);\n    free(index);\n    return EXIT_SUCCESS;\n}\n",
        "path": "src/bucketsort.c"

ion_ == length_) {\\n+            length_ = std::fread(buffer_, 1, buffer_size, stdin);\\n+            position_ = 0;\\n+            if (length_ == 0) return EOF;\\n+        }\\n+        return buffer_[position_++];\\n+    }\\n+\\n+public:\\n+    bool readInt(int& result) {\\n+        int c;\\n+        do {\\n+            c = nextChar();\\n+        } while (c != EOF && c <= ' ');\\n+        if (c == EOF) return false;\\n+\\n+        const bool negative = c == '-';\\n+        if (c == '-' || c == '+') c = nextChar();\\n+        std::int64_t value = 0;\\n+        while (c >= '0' && c <= '9') {\\n+            value = value * 10 + (c - '0');\\n+            c = nextChar();\\n+        }\\n+        result = static_cast<int>(negative ? -value : value);\\n+        return true;\\n+    }\\n+};\\n \\n int main() {\\n-\\tint n,s;\\n-\\tstd::cin >> n >> s;\\n-\\tstd::vector<std::vector<int> > matrix(n, std::vector<int>(n));\\n-\\tfor(int i=0;i<n;i++)\\n-\\t\\tfor(int j=0;j<n;j++) \\n-\\t\\t\\tscanf(\\\"%d\\\", &(matrix[i][j]));\\n-\\n-\\tassert(s<n);\\n-\\tassert(n<8000);\\n-\\tassert(s>0);\\n-\\tassert(n>0);\\n-\\n-\\tint sum = 0;\\n-\\tfor(int i=0;i<s;i++)\\n-\\t\\tfor(int j=0;j<s;j++)\\n-\\t\\t\\tsum += matrix[i][j];\\n-\\n-\\tint mxSum = sum;\\n-\\n-\\tint dir = 1;\\n-\\tint i = 0;\\n-\\tint j = 0;\\n-\\twhile(i+s <= n) {\\n-\\t\\tif( (j+s == n && dir==1) || (j==0 && dir==-1) ) { \\n-\\t\\t\\tint exitingRow = i;\\n-\\t\\t\\tint enteringRow = exitingRow+s;\\n-\\t\\t\\tif(enteringRow >=n) break;\\n-\\n-\\t\\t\\tfor(int k=0;k<s;k++) { sum -= matrix[exitingRow][k+j]; } \\n-\\t\\t\\tfor(int k=0;k<s;k++) { sum += matrix[enteringRow][k+j];\\t} \\n-\\t\\t\\t\\n-\\t\\t\\ti++;\\n-\\t\\t\\tdir*=-1;\\n-\\t\\t} else {\\n-\\t\\t\\tint exitingCol,enteringCol;\\n-\\t\\t\\tif(dir==1) {\\n-\\t\\t\\t\\texitingCol = j;\\n-\\t\\t\\t\\tenteringCol = exitingCol + s;\\n-\\t\\t\\t} else {\\n-\\t\\t\\t\\tenteringCol = j-1;\\n-\\t\\t\\t\\texitingCol = enteringCol + s;\\n-\\t\\t\\t}\\n-\\n-\\t\\t\\tfor(int k=0;k<s;k++) {sum -= matrix[k+i][exitingCol]; } \\n-\\t\\t\\tfor(int k=0;k<s;k++) {sum += matrix[k+i][enteringCol];\\t} \\n-\\t\\t\\tj+=dir;\\n-\\t\\t}\\n-\\t\\tmxSum = std::max(mxSum,sum);\\n-\\t}\\n-\\tprintf(\\\"%d\\\\n\\\",mxSum);\\n-}\\n\\\\ No newline at end of file\\n+    FastInput input;\\n+    int n, s;\\n+    if (!input.readInt(n) || !input.readInt(s)) return 0;\\n+\\n+    assert(n > 0);\\n+    assert(n < 8000);\\n+    assert(s > 0);\\n+    assert(s < n);\\n+\\n+    const std::size_t width = static_cast<std::size_t>(n);\\n+    std::unique_ptr<int[]> rows(new int[width * static_cast<std::size_t>(s)]);\\n+    std::vector<std::int64_t> column_sums(width, 0);\\n+    std::int64_t best = std::numeric_limits<std::int64_t>::lowest();\\n+    int ring_row = 0;\\n+\\n+    for (int row = 0; row < n; ++row) {\\n+        int* slot = rows.get() + static_cast<std::size_t>(ring_row) * width;\\n+        if (row < s) {\\n+            for (int col = 0; col < n; ++col) {\\n+                int value;\\n+                if (!input.readInt(value)) return 0;\\n+                slot[col] = value;\\n+                column_sums[col] += static_cast<std::int64_t>(value);\\n+            }\\n+        } else {\\n+            for (int col = 0; col < n; ++col) {\\n+                int value;\\n+                if (!input.readInt(value)) return 0;\\n+                column_sums[col] += static_cast<std::int64_t>(value)\\n+                                  - static_cast<std::int64_t>(slot[col]);\\n+                slot[col] = value;\\n+            }\\n+        }\\n+\\n+        if (row + 1 >= s) {\\n+            std::int64_t window_sum = 0;\\n+            for (int col = 0; col < s; ++col) {\\n+                window_sum += column_sums[col];\\n+            }\\n+            if (window_sum > best) best = window_sum;\\n+            for (int col = s; col < n; ++col) {\\n+                window_sum += column_sums[col] - column_sums[col - s];\\n+                if (window_sum > best) best = window_sum;\\n+            }\\n+        }\\n+\\n+        if (++ring_row == s) ring_row = 0;\\n+    }\\n+\\n+    std::printf(\\\"%lld\\\\n\\\", static_cast<long long>(best));\\n+    return 0;\\n+}\"}, {\"id\": \"515821c6b1c44bc7\", \"role\": \"C\", \"commit\": \"03e30206fc643eb902953fb869e3db377523eae8\", \"transformations\": {\"files\": [\"src/solution.cpp\"], \"retained\": [\"Use a bounded fread parser and contiguous matrix storage.\", \"Cooperatively seed cache-line-aligned 64-bit column states, reusing overlapping windows.\", \"Statically distribute independent row bands within one OpenMP team, with SIMD column updates and a final maximum reduction.\", \"Bound thread count by available OpenMP threads and matrix work; preserve 64-bit intermediate arithmetic.\"]}, \"mean_seconds\": 0.009720995711783567, \"diff\": \"diff --git a/src/solution.cpp b/src/solution.cpp\\nindex fd005fd..1f8bea7 100644\\n--- a/src/solution.cpp\\n+++ b/src/solution.cpp\\n@@ -1,57 +1,182 @@\\n-#include <iostream>\\n-#include <vector>\\n+#include <algorithm>\\n+#include <cstddef>\\n+#include <cstdint>\\n #include <cstdio>\\n-#include <cassert>\\n+#include <limits>\\n+#include <memory>\\n+#include <vector>\\n+\\n+#ifdef _OPENMP\\n+#include <omp.h>\\n+#endif\\n+\\n+class FastInput {\\n+    unsigned char buffer_[1u << 16];\\n+    std::size_t position_ = 0;\\n+    std::size_t length_ = 0;\\n+\\n+    int get() {\\n+        if (position_ == length_) {\\n+            length_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);\\n+            position_ = 0;\\n+            if (length_ == 0) return EOF;\\n+        }\\n+        return buffer_[position_++];\\n+    }\\n+\\n+public:\\n+    bool read_int(int& value) {\\n+        int c;\\n+        do {\\n+            c = get();\\n+            if (c == EOF) return false;\\n+        } while (c <= ' ');\\n+\\n+        bool negative = false;\\n+        if (c == '-' || c == '+') {\\n+            negative = c == '-';\\n+            c = get();\\n+        }\\n+\\n+        long long magnitude = 0;\\n+        while (c >= '0' && c <= '9') {\\n+            magnitude = magnitude * 10 + (c - '0');\\n+            c = get();\\n+        }\\n+        value = static_cast<int>(negative ? -magnitude : magnitude);\\n+        return true;\\n+    }\\n+};\\n \\n int main() {\\n-\\tint n,s;\\n-\\tstd::cin >> n >> s;\\n-\\tstd::vector<std::vector<int> > matrix(n, std::vector<int>(n));\\n-\\tfor(int i=0;i<n;i++)\\n-\\t\\tfor(int j=0;j<n;j++) \\n-\\t\\t\\tscanf(\\\"%d\\\", &(matrix[i][j]));\\n-\\n-\\tassert(s<n);\\n-\\tassert(n<8000);\\n-\\tassert(s>0);\\n-\\tassert(n>0);\\n-\\n-\\tint sum = 0;\\n-\\tfor(int i=0;i<s;i++)\\n-\\t\\tfor(int j=0;j<s;j++)\\n-\\t\\t\\tsum += matrix[i][j];\\n-\\n-\\tint mxSum = sum;\\n-\\n-\\tint dir = 1;\\n-\\tint i = 0;\\n-\\tint j = 0;\\n-\\twhile(i+s <= n) {\\n-\\t\\tif( (j+s == n && dir==1) || (j==0 && dir==-1) ) { \\n-\\t\\t\\tint exitingRow = i;\\n-\\t\\t\\tint enteringRow = exitingRow+s;\\n-\\t\\t\\tif(enteringRow >=n) break;\\n-\\n-\\t\\t\\tfor(int k=0;k<s;k++) { sum -= matrix[exitingRow][k+j]; } \\n-\\t\\t\\tfor(int k=0;k<s;k++) { sum += matrix[enteringRow][k+j];\\t} \\n-\\t\\t\\t\\n-\\t\\t\\ti++;\\n-\\t\\t\\tdir*=-1;\\n-\\t\\t} else {\\n-\\t\\t\\tint exitingCol,enteringCol;\\n-\\t\\t\\tif(dir==1) {\\n-\\t\\t\\t\\texitingCol = j;\\n-\\t\\t\\t\\tenteringCol = exitingCol + s;\\n-\\t\\t\\t} else {\\n-\\t\\t\\t\\tenteringCol = j-1;\\n-\\t\\t\\t\\texitingCol = enteringCol + s;\\n-\\t\\t\\t}\\n-\\n-\\t\\t\\tfor(int k=0;k<s;k++) {sum -= matrix[k+i][exitingCol]; } \\n-\\t\\t\\tfor(int k=0;k<s;k++) {sum += matrix[k+i][enteringCol];\\t} \\n-\\t\\t\\tj+=dir;\\n-\\t\\t}\\n-\\t\\tmxSum = std::max(mxSum,sum);\\n-\\t}\\n-\\tprintf(\\\"%d\\\\n\\\",mxSum);\\n-}\\n\\\\ No newline at end of file\\n+    FastInput input;\\n+    int n, s;\\n+    if (!input.read_int(n) || !input.read_int(s)) return 0;\\n+    if (n <= 0 || s <= 0 || s > n) return 0;\\n+\\n+    const std::size_t cells = static_cast<std::size_t>(n) * n;\\n+    std::unique_ptr<int[]> matrix(new int[cells]);\\n+    for (std::size_t i = 0; i < cells; ++i) {\\n+        if (!input.read_int(matrix[i])) return 0;\\n+    }\\n+    const int* const values = matrix.get();\\n+    const int m = n - s + 1;\\n+\\n+    int workers = 1;\\n+#ifdef _OPENMP\\n+    workers = omp_get_max_threads();\\n+#endif\\n+    const int cache_blocks = (n + 7) / 8;\\n+    const int grain_limit = static_cast<int>(\\n+        std::max<std::size_t>(1, cells / 32768u));\\n+    workers = std::max(1, std::min(workers,\\n+                                 std::min(cache_blocks, grain_limit)));\\n+    const int bands = std::min(workers, m);\\n+\\n+    std::vector<int> starts(bands + 1);\\n+    for (int b = 0; b <= bands; ++b) {\\n+        starts[b] = static_cast<int>(static_cast<long long>(m) * b / bands);\\n+    }\\n+\\n+    // Align states and column-stripe boundaries to avoid false sharing.\\n+    const std::size_t pitch = static_cast<std::size_t>(cache_blocks) * 8;\\n+    std::unique_ptr<long long[]> storage(\\n+        new long long[static_cast<std::size_t>(bands) * pitch + 8]);\\n+    const std::uintptr_t address =\\n+        reinterpret_cast<std::uintptr_t>(storage.get());\\n+    const std::size_t alignment_offset = (64 - address % 64) % 64;\\n+    long long* const columns =\\n+        storage.get() + alignment_offset / sizeof(long long);\\n+\\n+    long long answer = std::numeric_limits<long long>::lowest();\\n+\\n+#pragma omp parallel num_threads(workers) if(workers > 1) reduction(max:answer)\\n+    {\\n+        // Each column stripe seeds every band without inter-band barriers.\\n+#pragma omp for schedule(static)\\n+        for (int stripe = 0; stripe < workers; ++stripe) {\\n+            const int col_begin = static_cast<int>(\\n+                static_cast<long long>(cache_blocks) * stripe / workers) * 8;\\n+            const int col_end = std::min(n, static_cast<int>(\\n+                static_cast<long long>(cache_blocks) * (stripe + 1) / workers) * 8);\\n+            int previous_start = 0;\\n+\\n+            for (int b = 0; b < bands; ++b) {\\n+                const int begin = starts[b];\\n+                const int shift = begin - previous_start;\\n+                long long* const state = columns + static_cast<std::size_t>(b) * pitch;\\n+\\n+                if (b == 0 || s <= 2 * shift) {\\n+#pragma omp simd\\n+                    for (int c = col_begin; c < col_end; ++c) {\\n+                        state[c] = 0;\\n+                    }\\n+                    for (int row = begin; row < begin + s; ++row) {\\n+                        const int* const source = values + static_cast<std::size_t>(row) * n;\\n+#pragma omp simd\\n+                        for (int c = col_begin; c < col_end; ++c) {\\n+                            state[c] += static_cast<long long>(source[c]);\\n+                        }\\n+                    }\\n+                } else {\\n+                    const long long* const previous =\\n+                        columns + static_cast<std::size_t>(b - 1) * pitch;\\n+#pragma omp simd\\n+                    for (int c = col_begin; c < col_end; ++c) {\\n+                        state[c] = previous[c];\\n+                    }\\n+                    for (int row = previous_start; row < begin; ++row) {\\n+                        const int* const outgoing =\\n+                            values + static_cast<std::size_t>(row) * n;\\n+     \"}, {\"id\": \"d3e3c87bf5f3499d\", \"role\": \"C\", \"commit\": \"a0d54025aeb86b0fd9de264342a3ce107de14060\", \"transformations\": {\"files\": [\"src/solution.cpp\"], \"retained\": [\"Replace serpentine rescanning with horizontal rolling sums and an s-row circular buffer of vertical contributions.\", \"Read 64-row batches through one bounded, signed-integer-aware fread parser.\", \"Use static row work sharing followed by static column-tile work sharing within one persistent OpenMP region.\", \"Use 64-bit intermediate sums, SIMD reductions, and a thread-private maximum reduction initialized for negative-only inputs.\"]}, \"mean_seconds\": 0.010025864467024803, \"diff\": \"diff --git a/src/solution.cpp b/src/solution.cpp\\nindex fd005fd..c1a7084 100644\\n--- a/src/solution.cpp\\n+++ b/src/solution.cpp\\n@@ -1,57 +1,162 @@\\n-#include <iostream>\\n-#include <vector>\\n+#include <algorithm>\\n+#include <cstddef>\\n+#include <cstdint>\\n #include <cstdio>\\n-#include <cassert>\\n+#include <limits>\\n+#include <memory>\\n+#include <vector>\\n+\\n+class FastInput {\\n+    static constexpr std::size_t capacity = 1u << 16;\\n+    unsigned char buffer[capacity];\\n+    std::size_t position = 0;\\n+    std::size_t available = 0;\\n+\\n+    int readByte() {\\n+        if (position == available) {\\n+            available = std::fread(buffer, 1, capacity, stdin);\\n+            position = 0;\\n+            if (available == 0) return EOF;\\n+        }\\n+        return buffer[position++];\\n+    }\\n+\\n+public:\\n+    bool readInt(int& value) {\\n+        int c = readByte();\\n+        while (c != EOF && c <= ' ') c = readByte();\\n+        if (c == EOF) {\\n+            value = 0;\\n+            return false;\\n+        }\\n+        bool negative = false;\\n+        if (c == '-' || c == '+') {\\n+            negative = c == '-';\\n+            c = readByte();\\n+        }\\n+        std::int64_t magnitude = 0;\\n+        while (c >= '0' && c <= '9') {\\n+            magnitude = magnitude * 10 + (c - '0');\\n+            c = readByte();\\n+        }\\n+        value = static_cast<int>(negative ? -magnitude : magnitude);\\n+        return true;\\n+    }\\n+};\\n \\n int main() {\\n-\\tint n,s;\\n-\\tstd::cin >> n >> s;\\n-\\tstd::vector<std::vector<int> > matrix(n, std::vector<int>(n));\\n-\\tfor(int i=0;i<n;i++)\\n-\\t\\tfor(int j=0;j<n;j++) \\n-\\t\\t\\tscanf(\\\"%d\\\", &(matrix[i][j]));\\n-\\n-\\tassert(s<n);\\n-\\tassert(n<8000);\\n-\\tassert(s>0);\\n-\\tassert(n>0);\\n-\\n-\\tint sum = 0;\\n-\\tfor(int i=0;i<s;i++)\\n-\\t\\tfor(int j=0;j<s;j++)\\n-\\t\\t\\tsum += matrix[i][j];\\n-\\n-\\tint mxSum = sum;\\n-\\n-\\tint dir = 1;\\n-\\tint i = 0;\\n-\\tint j = 0;\\n-\\twhile(i+s <= n) {\\n-\\t\\tif( (j+s == n && dir==1) || (j==0 && dir==-1) ) { \\n-\\t\\t\\tint exitingRow = i;\\n-\\t\\t\\tint enteringRow = exitingRow+s;\\n-\\t\\t\\tif(enteringRow >=n) break;\\n-\\n-\\t\\t\\tfor(int k=0;k<s;k++) { sum -= matrix[exitingRow][k+j]; } \\n-\\t\\t\\tfor(int k=0;k<s;k++) { sum += matrix[enteringRow][k+j];\\t} \\n-\\t\\t\\t\\n-\\t\\t\\ti++;\\n-\\t\\t\\tdir*=-1;\\n-\\t\\t} else {\\n-\\t\\t\\tint exitingCol,enteringCol;\\n-\\t\\t\\tif(dir==1) {\\n-\\t\\t\\t\\texitingCol = j;\\n-\\t\\t\\t\\tenteringCol = exitingCol + s;\\n-\\t\\t\\t} else {\\n-\\t\\t\\t\\tenteringCol = j-1;\\n-\\t\\t\\t\\texitingCol = enteringCol + s;\\n-\\t\\t\\t}\\n-\\n-\\t\\t\\tfor(int k=0;k<s;k++) {sum -= matrix[k+i][exitingCol]; } \\n-\\t\\t\\tfor(int k=0;k<s;k++) {sum += matrix[k+i][enteringCol];\\t} \\n-\\t\\t\\tj+=dir;\\n-\\t\\t}\\n-\\t\\tmxSum = std::max(mxSum,sum);\\n-\\t}\\n-\\tprintf(\\\"%d\\\\n\\\",mxSum);\\n-}\\n\\\\ No newline at end of file\\n+    FastInput input;\\n+    int n, s;\\n+    if (!input.readInt(n) || !input.readInt(s)) return 0;\\n+    if (n <= 0 || n >= 8000 || s <= 0 || s >= n) return 0;\\n+\\n+    using Sum = std::int64_t;\\n+    constexpr int batchRows = 64;\\n+    constexpr int columnTile = 256;\\n+    const int m = n - s + 1;\\n+\\n+    std::unique_ptr<int[]> rawStorage(\\n+        new int[static_cast<std::size_t>(batchRows) * n]);\\n+    std::unique_ptr<Sum[]> horizontalStorage(\\n+        new Sum[static_cast<std::size_t>(batchRows) * m]);\\n+    std::unique_ptr<Sum[]> historyStorage(\\n+        new Sum[static_cast<std::size_t>(s) * m]);\\n+    std::vector<Sum> verticalStorage(m, 0);\\n+\\n+    int* const raw = rawStorage.get();\\n+    Sum* const horizontal = horizontalStorage.get();\\n+    Sum* const history = historyStorage.get();\\n+    Sum* const vertical = verticalStorage.data();\\n+    Sum best = std::numeric_limits<Sum>::lowest();\\n+\\n+#ifdef _OPENMP\\n+#pragma omp parallel if (static_cast<std::size_t>(n) * n >= 262144u) reduction(max: best)\\n+#endif\\n+    {\\n+        for (int first = 0; first < n; first += batchRows) {\\n+            const int rows = std::min(batchRows, n - first);\\n+\\n+#ifdef _OPENMP\\n+#pragma omp single\\n+#endif\\n+            {\\n+                const std::size_t count = static_cast<std::size_t>(rows) * n;\\n+                for (std::size_t i = 0; i < count; ++i) {\\n+                    input.readInt(raw[i]);\\n+                }\\n+            }\\n+\\n+#ifdef _OPENMP\\n+#pragma omp for schedule(static)\\n+#endif\\n+            for (int row = 0; row < rows; ++row) {\\n+                const int* source = raw + static_cast<std::size_t>(row) * n;\\n+                Sum* destination = horizontal + static_cast<std::size_t>(row) * m;\\n+                Sum sum = 0;\\n+#ifdef _OPENMP\\n+#pragma omp simd reduction(+: sum)\\n+#endif\\n+                for (int c = 0; c < s; ++c) {\\n+                    sum += static_cast<Sum>(source[c]);\\n+                }\\n+                destination[0] = sum;\\n+                for (int c = 1; c < m; ++c) {\\n+                    sum += static_cast<Sum>(source[c + s - 1])\\n+                         - static_cast<Sum>(source[c - 1]);\\n+                    destination[c] = sum;\\n+                }\\n+            }\\n+\\n+#ifdef _OPENMP\\n+#pragma omp for schedule(static)\\n+#endif\\n+            for (int block = 0; block < m; block += columnTile) {\\n+                const int end = std::min(block + columnTile, m);\\n+                int slot = first % s;\\n+                for (int row = 0; row < rows; ++row) {\\n+                    const int globalRow = first + row;\\n+                    const Sum* entering = horizontal + static_cast<std::size_t>(row) * m;\\n+                    Sum* previous = history + static_cast<std::size_t>(slot) * m;\\n+\\n+                    if (globalRow < s) {\\n+#ifdef _OPENMP\\n+#pragma omp simd\\n+#endif\\n+                        for (int c = block; c < end; ++c) {\\n+                            vertical[c] += entering[c];\\n+                            previous[c] = entering[c];\\n+                        }\\n+                        if (globalRow == s - 1) {\\n+                            Sum rowBest = std::numeric_limits<Sum>::lowest();\\n+#ifdef _OPENMP\\n+#pragma omp simd reduction(max: rowBest)\\n+#endif\\n+                            for (int c = block; c < end; ++c) {\\n+                                if (vertical[c] > rowBest) rowBest = vertical[c];\\n+                            }\\n+                            if (rowBest > best) best = rowBest;\\n+     \"}, {\"id\": \"99401c1685db48d4\", \"role\": \"B\", \"commit\": \"73e7f623b8c286bff5670a9f450aa46947eebf9f\", \"transformations\": {\"files\": [\"src/solution.cpp\"], \"retained\": [\"Initialize each batch's horizontal sums with four independent NEON partial accumulators, then combine them.\", \"Unroll horizontal sliding by four and use four independent maximum accumulators per row pair, preserving sequential rolling sums and reducing maxima once afterward.\"]}, \"mean_seconds\": 0.05409882000337044, \"diff\": \"diff --git a/src/solution.cpp b/src/solution.cpp\\nindex fd005fd..b435c4a 100644\\n--- a/src/solution.cpp\\n+++ b/src/solution.cpp\\n@@ -1,57 +1,228 @@\\n-#include <iostream>\\n-#include <vector>\\n-#include <cstdio>\\n+#include <algorithm>\\n #include <cassert>\\n+#include <cstddef>\\n+#include <cstdint>\\n+#include <cstdio>\\n+#include <limits>\\n+#include <vector>\\n+\\n+#if defined(__aarch64__) && defined(__ARM_NEON)\\n+#include <arm_neon.h>\\n+#endif\\n+\\n+struct alignas(16) PackedColumns {\\n+    std::int64_t lane[4];\\n+};\\n+\\n+template<int Batch>\\n+static void prepare_batch(const int* matrix, int n, int s, int top,\\n+                          int window_count, std::int64_t* columns,\\n+                          PackedColumns* packed) {\\n+    const int* entering[4] = {};\\n+    const int* leaving[4] = {};\\n+    for (int lane = 1; lane < Batch; ++lane) {\\n+        entering[lane] = matrix + static_cast<std::size_t>(top + lane + s - 1) * n;\\n+        leaving[lane] = matrix + static_cast<std::size_t>(top + lane - 1) * n;\\n+    }\\n+\\n+    const bool advance = top + Batch < window_count;\\n+    const int* next_entering = nullptr;\\n+    const int* next_leaving = nullptr;\\n+    if (advance) {\\n+        next_entering = matrix + static_cast<std::size_t>(top + Batch + s - 1) * n;\\n+        next_leaving = matrix + static_cast<std::size_t>(top + Batch - 1) * n;\\n+    }\\n+\\n+    for (int col = 0; col < n; ++col) {\\n+        std::int64_t value = columns[col];\\n+        packed[col].lane[0] = value;\\n+        for (int lane = 1; lane < Batch; ++lane) {\\n+            value += static_cast<std::int64_t>(entering[lane][col])\\n+                   - static_cast<std::int64_t>(leaving[lane][col]);\\n+            packed[col].lane[lane] = value;\\n+        }\\n+        // Inactive lanes duplicate a valid row, so they cannot change the maximum.\\n+        for (int lane = Batch; lane < 4; ++lane)\\n+            packed[col].lane[lane] = value;\\n+\\n+        if (advance) {\\n+            columns[col] = value\\n+                         + static_cast<std::int64_t>(next_entering[col])\\n+                         - static_cast<std::int64_t>(next_leaving[col]);\\n+        }\\n+    }\\n+}\\n+\\n+#if defined(__aarch64__) && defined(__ARM_NEON)\\n+static inline int64x2_t maximum_lanes(int64x2_t a, int64x2_t b) {\\n+    return vbslq_s64(vcgtq_s64(a, b), a, b);\\n+}\\n+#endif\\n+\\n+static std::int64_t scan_batch(const PackedColumns* packed, int n, int s) {\\n+#if defined(__aarch64__) && defined(__ARM_NEON)\\n+    int64x2_t partial01_0 = vdupq_n_s64(0);\\n+    int64x2_t partial01_1 = vdupq_n_s64(0);\\n+    int64x2_t partial01_2 = vdupq_n_s64(0);\\n+    int64x2_t partial01_3 = vdupq_n_s64(0);\\n+    int64x2_t partial23_0 = vdupq_n_s64(0);\\n+    int64x2_t partial23_1 = vdupq_n_s64(0);\\n+    int64x2_t partial23_2 = vdupq_n_s64(0);\\n+    int64x2_t partial23_3 = vdupq_n_s64(0);\\n+\\n+    int col = 0;\\n+    // Independent partial sums shorten the first-window reduction chains.\\n+    for (; col + 3 < s; col += 4) {\\n+        partial01_0 = vaddq_s64(partial01_0, vld1q_s64(packed[col].lane));\\n+        partial23_0 = vaddq_s64(partial23_0, vld1q_s64(packed[col].lane + 2));\\n+        partial01_1 = vaddq_s64(partial01_1, vld1q_s64(packed[col + 1].lane));\\n+        partial23_1 = vaddq_s64(partial23_1, vld1q_s64(packed[col + 1].lane + 2));\\n+        partial01_2 = vaddq_s64(partial01_2, vld1q_s64(packed[col + 2].lane));\\n+        partial23_2 = vaddq_s64(partial23_2, vld1q_s64(packed[col + 2].lane + 2));\\n+        partial01_3 = vaddq_s64(partial01_3, vld1q_s64(packed[col + 3].lane));\\n+        partial23_3 = vaddq_s64(partial23_3, vld1q_s64(packed[col + 3].lane + 2));\\n+    }\\n+    int64x2_t sum01 = vaddq_s64(vaddq_s64(partial01_0, partial01_1),\\n+                              vaddq_s64(partial01_2, partial01_3));\\n+    int64x2_t sum23 = vaddq_s64(vaddq_s64(partial23_0, partial23_1),\\n+                              vaddq_s64(partial23_2, partial23_3));\\n+    for (; col < s; ++col) {\\n+        sum01 = vaddq_s64(sum01, vld1q_s64(packed[col].lane));\\n+        sum23 = vaddq_s64(sum23, vld1q_s64(packed[col].lane + 2));\\n+    }\\n+\\n+    int64x2_t best01_0 = sum01;\\n+    int64x2_t best01_1 = sum01;\\n+    int64x2_t best01_2 = sum01;\\n+    int64x2_t best01_3 = sum01;\\n+    int64x2_t best23_0 = sum23;\\n+    int64x2_t best23_1 = sum23;\\n+    int64x2_t best23_2 = sum23;\\n+    int64x2_t best23_3 = sum23;\\n+\\n+    // Keep the rolling sums ordered, but distribute maxima across four chains.\\n+    // Each vector lane still represents an independent top-left row.\\n+    for (; col + 3 < n; col += 4) {\\n+        const PackedColumns* entering = packed + col;\\n+        const PackedColumns* leavi
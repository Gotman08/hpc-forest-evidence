ssive horizontal windows.\", \"Initialize maxima from actual windows and widen arithmetic before subtraction.\"]}, \"mean_seconds\": 0.054956139996647835, \"diff\": \"diff --git a/src/solution.cpp b/src/solution.cpp\\nindex fd005fd..4bba740 100644\\n--- a/src/solution.cpp\\n+++ b/src/solution.cpp\\n@@ -1,57 +1,152 @@\\n-#include <iostream>\\n-#include <vector>\\n-#include <cstdio>\\n+#include <algorithm>\\n #include <cassert>\\n+#include <cstddef>\\n+#include <cstdint>\\n+#include <cstdio>\\n+#include <limits>\\n+#include <vector>\\n+\\n+#if defined(__aarch64__) && defined(__ARM_NEON)\\n+#include <arm_neon.h>\\n+#endif\\n+\\n+struct alignas(16) PackedColumns {\\n+    std::int64_t lane[4];\\n+};\\n+\\n+template<int Batch>\\n+static void prepare_batch(const int* matrix, int n, int s, int top,\\n+                          int window_count, std::int64_t* columns,\\n+                          PackedColumns* packed) {\\n+    const int* entering[4] = {};\\n+    const int* leaving[4] = {};\\n+    for (int lane = 1; lane < Batch; ++lane) {\\n+        entering[lane] = matrix + static_cast<std::size_t>(top + lane + s - 1) * n;\\n+        leaving[lane] = matrix + static_cast<std::size_t>(top + lane - 1) * n;\\n+    }\\n+\\n+    const bool advance = top + Batch < window_count;\\n+    const int* next_entering = nullptr;\\n+    const int* next_leaving = nullptr;\\n+    if (advance) {\\n+        next_entering = matrix + static_cast<std::size_t>(top + Batch + s - 1) * n;\\n+        next_leaving = matrix + static_cast<std::size_t>(top + Batch - 1) * n;\\n+    }\\n+\\n+    for (int col = 0; col < n; ++col) {\\n+        std::int64_t value = columns[col];\\n+        packed[col].lane[0] = value;\\n+        for (int lane = 1; lane < Batch; ++lane) {\\n+            value += static_cast<std::int64_t>(entering[lane][col])\\n+                   - static_cast<std::int64_t>(leaving[lane][col]);\\n+            packed[col].lane[lane] = value;\\n+        }\\n+        // Inactive lanes duplicate a valid row, so they cannot change the maximum.\\n+        for (int lane = Batch; lane < 4; ++lane)\\n+            packed[col].lane[lane] = value;\\n+\\n+        if (advance) {\\n+            columns[col] = value\\n+                         + static_cast<std::int64_t>(next_entering[col])\\n+                         - static_cast<std::int64_t>(next_leaving[col]);\\n+        }\\n+    }\\n+}\\n+\\n+#if defined(__aarch64__) && defined(__ARM_NEON)\\n+static inline int64x2_t maximum_lanes(int64x2_t a, int64x2_t b) {\\n+    return vbslq_s64(vcgtq_s64(a, b), a, b);\\n+}\\n+#endif\\n+\\n+static std::int64_t scan_batch(const PackedColumns* packed, int n, int s) {\\n+#if defined(__aarch64__) && defined(__ARM_NEON)\\n+    int64x2_t sum01 = vdupq_n_s64(0);\\n+    int64x2_t sum23 = vdupq_n_s64(0);\\n+    for (int col = 0; col < s; ++col) {\\n+        sum01 = vaddq_s64(sum01, vld1q_s64(packed[col].lane));\\n+        sum23 = vaddq_s64(sum23, vld1q_s64(packed[col].lane + 2));\\n+    }\\n+    int64x2_t best01 = sum01;\\n+    int64x2_t best23 = sum23;\\n+\\n+    // Lanes represent independent top-left rows, not successive horizontal windows.\\n+    for (int col = s; col < n; ++col) {\\n+        const int64x2_t enter01 = vld1q_s64(packed[col].lane);\\n+        const int64x2_t enter23 = vld1q_s64(packed[col].lane + 2);\\n+        const int64x2_t leave01 = vld1q_s64(packed[col - s].lane);\\n+        const int64x2_t leave23 = vld1q_s64(packed[col - s].lane + 2);\\n+        sum01 = vaddq_s64(sum01, vsubq_s64(enter01, leave01));\\n+        sum23 = vaddq_s64(sum23, vsubq_s64(enter23, leave23));\\n+        best01 = maximum_lanes(best01, sum01);\\n+        best23 = maximum_lanes(best23, sum23);\\n+    }\\n+    const int64x2_t best = maximum_lanes(best01, best23);\\n+    return std::max(vgetq_lane_s64(best, 0), vgetq_lane_s64(best, 1));\\n+#else\\n+    std::int64_t sums[4] = {};\\n+    for (int col = 0; col < s; ++col)\\n+        for (int lane = 0; lane < 4; ++lane)\\n+            sums[lane] += packed[col].lane[lane];\\n+\\n+    std::int64_t best[4] = {sums[0], sums[1], sums[2], sums[3]};\\n+    for (int col = s; col < n; ++col) {\\n+        for (int lane = 0; lane < 4; ++lane) {\\n+            sums[lane] += packed[col].lane[lane] - packed[col - s].lane[lane];\\n+            best[lane] = std::max(best[lane], sums[lane]);\\n+        }\\n+    }\\n+    return *std::max_element(best, best + 4);\\n+#endif\\n+}\\n \\n int main() {\\n-\\tint n,s;\\n-\\tstd::cin >> n >> s;\\n-\\tstd::vector<std::vector<int> > matrix(n, std::vector<int>(n));\\n-\\tfor(int i=0;i<n;i++)\\n-\\t\\tfor(int j=0;j<n;j++) \\n-\\t\\t\\tscanf(\\\"%d\\\", &(matrix[i][j]));\\n-\\n-\\tassert(s<n);\\n-\\tassert(n<8000);\\n-\\tassert(s>0);\\n-\\tassert(n>0);\\n-\\n-\\tint sum = 0;\\n-\\tfor(int i=0;i<s;i++)\\n-\\t\\tfor(int j=0;j<s;j++)\\n-\\t\\t\\tsum += matrix[i][j];\\n-\\n-\\tint mxSum = sum;\\n-\\n-\\tint dir = 1;\\n-\\tint i = 0;\\n-\\tint j = 0;\\n-\\twhile(i+s <= n) {\\n-\\t\\tif( (j+s == n && dir==1) || (j==0 && dir==-1) ) { \\n-\\t\\t\\tint exitingRow = i;\\n-\\t\\t\\tint enteringRow = exitingRow+s;\\n-\\t\\t\\tif(enteringRow >=n) break;\\n-\\n-\\t\\t\\tfor(int k=0;k<s;k++) { sum -= matrix[exitingRow][k+j]; } \\n-\\t\\t\\tfor(int k=0;k<s;k++) { sum += matrix[enteringRow][k+j];\\t} \\n-\\t\\t\\t\\n-\\t\\t\\ti++;\\n-\\t\\t\\tdir*=-1;\\n-\\t\\t} else {\\n-\\t\\t\\tint exitingCol,enteringCol;\\n-\\t\\t\\tif(dir==1) {\\n-\\t\\t\\t\\texitingCol = j;\\n-\\t\\t\\t\\tenteringCol = exitingCol + s;\\n-\\t\\t\\t} else {\\n-\\t\\t\\t\\tenteringCol = j-1;\\n-\\t\\t\\t\\texitingCol = enteringCol + s;\\n-\\t\\t\\t}\\n-\\n-\\t\\t\\tfor(int k=0;k<s;k++) {sum -= matrix[k+i][exitingCol]; } \\n-\\t\\t\\tfor(int k=0;k<s;k++) {sum += matrix[k+i][enteringCol];\\t} \\n-\\t\\t\\tj+=dir;\\n-\\t\\t}\\n-\\t\\tmxSum = std::max(mxSum,sum);\\n-\\t}\\n-\\tprintf(\\\"%d\\\\n\\\",mxSum);\\n-}\\n\\\\ No newline at end of file\\n+    int n, s;\\n+    if (std::scanf(\\\"%d%d\\\", &n, &s) != 2)\\n+        return 0;\\n+\\n+    assert(s < n);\\n+    assert(n < 8000);\\n+    assert(s > 0);\\n+    assert(n > 0);\\n+\\n+    std::vector<int> matrix(static_cast<std::size_t>(n) * n);\\n+    for (std::size_t i = 0; i < matrix.size(); ++i)\\n+        std::scanf(\\\"%d\\\", &matrix[i]);\\n+\\n+    std::vector<std::int64_t> columns(n, 0);\\n+    for (int row = 0; row < s; ++row) {\\n+        const int* values = matrix.data() + static_cast<std::size_t>(row) * n;\\n+        for (int col = 0; col < n; ++col)\\n+            columns[col] += static_cast<std::int64_t>(values[col]);\\n+    }\\n+\\n+    std::vector<PackedColumns> packed(n);\\n+    const int window_count = n - s + 1;\\n+    std::int64_t answer = std::numeric_limits<std::int64_t>::lowest();\\n+    for (int top = 0; top < window_coun\"}], \"interactions\": [{\"sources\": [\"bc5d99c2c37544e1\", \"99401c1685db48d4\"], \"outcome\": {\"binary_sha256\": \"46e4a01ec2a74d10978712e638808aa793591e721874369516fafb98d82e2f95\", \"cache_key\": \"839dee331d0cd22a80526539d18cedb26a1fb87d8d1e552ac94d255a49e57f12\", \"commit\": \"2433e509383b8b0cfe854b097912be3a44ccf287\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6.1-sol-max/results-749415/2022-sum/logs/e1/65280f8d37d641fd/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6.1-sol-max/results-749415/2022-sum/logs/e1/65280f8d37d641fd/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6.1-sol-max/results-749415/2022-sum/logs/e1/65280f8d37d641fd/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6.1-sol-max/results-749415/2022-sum/logs/e1/65280f8d37d641fd/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6.1-sol-max/results-749415/2022-sum/logs/e1/6
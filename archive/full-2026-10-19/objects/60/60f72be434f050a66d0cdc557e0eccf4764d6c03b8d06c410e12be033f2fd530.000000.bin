\\n+        if (c == '-' || c == '+') c = next_char();\\n+        Sum value = 0;\\n+        while (c >= '0' && c <= '9') {\\n+            value = value * 10 + (c - '0');\\n+            c = next_char();\\n+        }\\n+        result = static_cast<int>(negative ? -value : value);\\n+        return true;\\n+    }\\n+\\n+    int next_int() {\\n+        int result = 0;\\n+        read_int(result);\\n+        return result;\\n+    }\\n+};\\n+\\n+template<bool Remove, bool Store, bool Evaluate>\\n+static inline void update_window(Sum row_sum, int column, Sum* history,\\n+                                 Sum* totals, Sum& maximum) {\\n+    Sum total = totals[column] + row_sum;\\n+    if (Remove) total -= history[column];\\n+    if (Store) history[column] = row_sum;\\n+    totals[column] = total;\\n+    if (Evaluate && total > maximum) maximum = total;\\n+}\\n+\\n+template<bool Remove, bool Store, bool Evaluate>\\n+static inline void advance_window(FastInput& input, int column, int retained,\\n+                                  int* outgoing, int& head, Sum& row_sum,\\n+                                  Sum* history, Sum* totals, Sum& maximum) {\\n+    const int value = input.next_int();\\n+    row_sum += static_cast<Sum>(value) - outgoing[head];\\n+    outgoing[head] = value;\\n+    if (++head == retained) head = 0;\\n+    update_window<Remove, Store, Evaluate>(\\n+        row_sum, column, history, totals, maximum);\\n+}\\n+\\n+template<bool Remove, bool Store, bool Evaluate>\\n+static void read_row(FastInput& input, int s, int width, int retained,\\n+                     int* outgoing, Sum* history, Sum* totals, Sum& maximum) {\\n+    Sum row_sum = 0;\\n+    for (int column = 0; column < retained; ++column) {\\n+        const int value = input.next_int();\\n+        outgoing[column] = value;\\n+        row_sum += value;\\n+    }\\n+    for (int column = retained; column < s; ++column) {\\n+        row_sum += input.next_int();\\n+    }\\n+\\n+    Sum best0 = maximum;\\n+    Sum best1 = maximum;\\n+    Sum best2 = maximum;\\n+    Sum best3 = maximum;\\n+    update_window<Remove, Store, Evaluate>(\\n+        row_sum, 0, history, totals, best0);\\n+\\n+    int head = 0;\\n+    int column = 1;\\n+    // Rolling sums remain ordered; maximum chains are independent.\\n+    for (; column + 3 < width; column += 4) {\\n+        advance_window<Remove, Store, Evaluate>(\\n+            input, column, retained, outgoing, head, row_sum,\\n+            history, totals, best0);\\n+        advance_window<Remove, Store, Evaluate>(\\n+            input, column + 1, retained, outgoing, head, row_sum,\\n+            history, totals, best1);\\n+        advance_window<Remove, Store, Evaluate>(\\n+            input, column + 2, retained, outgoing, head, row_sum,\\n+            history, totals, best2);\\n+        advance_window<Remove, Store, Evaluate>(\\n+            input, column + 3, retained, outgoing, head, row_sum,\\n+            history, totals, best3);\\n+    }\\n+    for (; column < width; ++column) {\\n+        advance_window<Remove, Store, Evaluate>(\\n+            input, column, retained, outgoing, head, row_sum,\\n+            history, totals, best0);\\n+    }\\n+    if (Evaluate) {\\n+        maximum = std::max(std::max(best0, best1), std::max(best2, best3));\\n+    }\\n+}\\n \\n int main() {\\n-\\tint n,s;\\n-\\tstd::cin >> n >> s;\\n-\\tstd::vector<std::vector<int> > matrix(n, std::vector<int>(n));\\n-\\tfor(int i=0;i<n;i++)\\n-\\t\\tfor(int j=0;j<n;j++) \\n-\\t\\t\\tscanf(\\\"%d\\\", &(matrix[i][j]));\\n-\\n-\\tassert(s<n);\\n-\\tassert(n<8000);\\n-\\tassert(s>0);\\n-\\tassert(n>0);\\n-\\n-\\tint sum = 0;\\n-\\tfor(int i=0;i<s;i++)\\n-\\t\\tfor(int j=0;j<s;j++)\\n-\\t\\t\\tsum += matrix[i][j];\\n-\\n-\\tint mxSum = sum;\\n-\\n-\\tint dir = 1;\\n-\\tint i = 0;\\n-\\tint j = 0;\\n-\\twhile(i+s <= n) {\\n-\\t\\tif( (j+s == n && dir==1) || (j==0 && dir==-1) ) { \\n-\\t\\t\\tint exitingRow = i;\\n-\\t\\t\\tint enteringRow = exitingRow+s;\\n-\\t\\t
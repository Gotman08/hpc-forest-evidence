        "content": "#include <cassert>\n#include <cstddef>\n#include <cstdio>\n#include <limits>\n#include <vector>\n\nint main() {\n    int n = 0;\n    int s = 0;\n    if (std::scanf(\"%d%d\", &n, &s) != 2) return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t rowSize = static_cast<std::size_t>(n);\n\n    if (s <= 2) {\n        std::vector<int> matrix(rowSize * rowSize);\n        for (std::size_t i = 0; i < matrix.size(); ++i) {\n            if (std::scanf(\"%d\", &matrix[i]) != 1) return 0;\n        }\n\n        long long sum = 0;\n        for (int r = 0; r < s; ++r) {\n            const std::size_t rowBase = static_cast<std::size_t>(r) * rowSize;\n            for (int c = 0; c < s; ++c) {\n                sum += matrix[rowBase + static_cast<std::size_t>(c)];\n            }\n        }\n        long long best = sum;\n\n        int direction = 1;\n        int top = 0;\n        int left = 0;\n        while (top + s <= n) {\n            if ((left + s == n && direction == 1) ||\n                (left == 0 && direction == -1)) {\n                const int enteringRow = top + s;\n                if (enteringRow >= n) break;\n\n                const std::size_t exitingBase = static_cast<std::size_t>(top) * rowSize;\n                const std::size_t enteringBase = static_cast<std::size_t>(enteringRow) * rowSize;\n                #pragma omp simd reduction(+:sum)\n                for (int k = 0; k < s; ++k) {\n                    const std::size_t offset = static_cast<std::size_t>(left + k);\n                    sum += static_cast<long long>(matrix[enteringBase + offset]) -\n                           matrix[exitingBase + offset];\n                }\n\n                ++top;\n                direction *= -1;\n            } else {\n                int exitingCol;\n                int enteringCol;\n                if (direction == 1) {\n                    exitingCol = left;\n                    enteringCol = left + s;\n                } else {\n                    enteringCol = left - 1;\n                    exitingCol = enteringCol + s;\n                }\n\n                for (int k = 0; k < s; ++k) {\n                    const std::size_t rowBase = static_cast<std::size_t>(top + k) * rowSize;\n                    sum += static_cast<long long>(matrix[rowBase + static_cast<std::size_t>(enteringCol)]) -\n                           matrix[rowBase + static_cast<std::size_t>(exitingCol)];\n                }\n                left += direction;\n            }\n            if (sum > best) best = sum;\n        }\n\n        std::printf(\"%lld\\n\", best);\n        return 0;\n    }\n\n    std::vector<long long> columnTotals(rowSize, 0);\n    std::vector<int> rowBuffer(static_cast<std::size_t>(s) * rowSize);\n    std::vector<int> incomingRow(rowSize);\n    long long best = std::numeric_limits<long long>::lowest();\n\n    for (int row = 0; row < n; ++row) {\n        for (int col = 0; col < n; ++col) {\n            if (std::scanf(\"%d\", &incomingRow[static_cast<std::size_t>(col)]) != 1) return 0;\n        }\n\n        const std::size_t slotBase = static_cast<std::size_t>(row % s) * rowSize;\n        int* storedRow = rowBuffer.data() + slotBase;\n        const int* incoming = incomingRow.data();\n        if (row >= s) {\n            #pragma omp simd\n            for (int col = 0; col < n; ++col) {\n                const std::size_t index = static_cast<std::size_t>(col);\n                columnTotals[index] += static_cast<long long>(incoming[index]) - storedRow[col];\n                storedRow[col] = incoming[index];\n            }\n        } else {\n            #pragma omp simd\n            for (int col = 0; col < n; ++col) {\n                const std::size_t index = static_cast<std::size_t>(col);\n                columnTotals[index] += incoming[index];\n                storedRow[col] = incoming[index];\n            }\n        }\n\n        if (row >= s - 1) {\n            long long windowSum = 0;\n            #pragma omp simd reduction(+:windowSum)\n            for (int col = 0; col < s; ++col) {\n                windowSum += columnTotals[static_cast<std::size_t>(col)];\n            }\n            if (windowSum > best) best = windowSum;\n\n            for (int right = s; right < n; ++right) {\n                windowSum += columnTotals[static_cast<std::size_t>(right)] -\n                             columnTotals[static_cast<std::size_t>(right - s)];\n                if (windowSum > best) best = windowSum;\n            }\n        }\n    }\n\n    std::printf(\"%lld\\n\", best);\n    return 0;\n}",

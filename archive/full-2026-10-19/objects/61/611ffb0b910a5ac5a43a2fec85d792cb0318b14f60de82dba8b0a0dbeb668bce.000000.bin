{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"/*\\n  Quicksort\\n*/\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <limits.h>\\n#include <openssl/md5.h>\\n\\n\\n/*\\n * Prototypes\\n */\\nvoid srandnum(int seed);\\ndouble randnum(void);\\nint *generate_case(int N);\\ndouble drand(int xmin, int xmax);\\nvoid swap(int *toorder, int i, int j);\\nint partition(int *toorder, int lo, int hi);\\nvoid _quicksort(int *toorder, int lo, int hi);\\nvoid quicksort(int *toorder, int N);\\nint is_sorted(int *toorder, int N);\\n\\n/*\\n * A generic pRNG\\n */\\n#define MY_RAND_MAX 0x7FFFFFFF\\n\\n#define RANDNUM_W 521288629\\n#define RANDNUM_Z 362436069\\n\\nunsigned int randum_w = RANDNUM_W;\\nunsigned int randum_z = RANDNUM_Z;\\n\\nvoid srandnum(int seed)\\n{\\n    unsigned int w, z;\\n    w = (seed * 104623) & 0xffffffff;\\n    randum_w = (w) ? w : RANDNUM_W;\\n    z = (seed * 48947) & 0xffffffff;\\n    randum_z = (z) ? z : RANDNUM_Z;\\n}\\n\\ndouble randnum(void)\\n{\\n    unsigned int u;\\n    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);\\n    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);\\n    u = (randum_z << 16) + randum_w;\\n    return (abs(u));\\n}\\n\\n/*\\n * Main function\\n */\\nint main(int argc, char *argv[])\\n{\\n    int N = 0;\\n    int *our_list = NULL;\\n\\n    //The input provides the case size\\n\\tscanf(\\\"%d\\\", &N);\\n    if (N <= 0) {\\n\\tprintf(\\\"Error: please, provide the case size.\\\\n\\\");\\n\\treturn 1;\\n    }\\n\\n    //Generate the case\\n    our_list = generate_case(N);\\n    if (our_list == NULL) {\\n\\tprintf(\\\"Error: case instantiation failed.\\\\n\\\");\\n\\treturn 1;\\n    }\\n\\n    //Do the thing\\n    quicksort(our_list, N);\\n\\n    if (is_sorted(our_list, N) == 1) {\\n\\tprintf(\\\"Error, for some reason list is still unsorted.\\\\n\\\");\\n\\treturn 1;\\n    }\\n\\n#ifdef COMPUTE_MD5_PROBLEM\\n    //Compute MD5 Checksum for problem identification\\n    MD5_CTX c;\\n    unsigned char out[MD5_DIGEST_LENGTH];\\n    MD5_Init(&c);\\n    MD5_Update(&c, our_list, N * sizeof(int));\\n    MD5_Final(out, &c);\\n    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {\\n\\tprintf(\\\"%02x\\\", out[n]);\\n    }\\n#endif\\n    printf(\\\"\\\\n\\\");\\n\\n    //Clean up\\n    free(our_list);\\n\\n    return 0;\\n}\\n\\nenum {\\n    INSERTION_SORT_THRESHOLD = 24,\\n    PARTITION_BLOCK_SIZE = 64\\n};\\n\\n/*\\n * Public API\\n */\\nvoid quicksort(int *toorder, int N)\\n{\\n    if (N > 1)\\n        _quicksort(toorder, 0, N - 1);\\n}\\n\\n/* Finish small, contiguous ranges while they are cache-resident. */\\nstatic void insertion_sort_range(int *toorder, int lo, int hi)\\n{\\n    for (int i = lo + 1; i <= hi; ++i) {\\n        int value = toorder[i];\\n        int j = i;\\n        while (j > lo && toorder[j - 1] > value) {\\n            toorder[j] = toorder[j - 1];\\n            --j;\\n        }\\n        toorder[j] = value;\\n    }\\n}\\n\\nstatic void sift_down(int *toorder, int root, int count)\\n{\\n    int value = toorder[root];\\n    while (root < count / 2) {\\n        int child = 2 * root + 1;\\n        if (child + 1 < count && toorder[child] < toorder[child + 1])\\n            ++child;\\n        if (value >= toorder[child])\\n            break;\\n        toorder[root] = toorder[child];\\n        root = child;\\n    }\\n    toorder[root] = value;\\n}\\n\\n/* In-place fallback for excessively unbalanced partitions. */\\nstatic void heap_sort_range(int *toorder, int lo, int hi)\\n{\\n    int *base = toorder + lo;\\n    int count = hi - lo + 1;\\n    for (int root = count / 2; root > 0; ) {\\n        --root;\\n        sift_down(base, root, count);\\n    }\\n    for (int end = count - 1; end > 0; --end) {\\n        swap(base, 0, end);\\n        sift_down(base, 0, end);\\n    }\\n}\\n\\nstatic void introsort_range(int *toorder, int lo, int hi, int depth)\\n{\\n    while (hi - lo >= INSERTION_SORT_THRESHOLD) {\\n        if (depth == 0) {\\n            heap_sort_range(toorder, lo, hi);\\n            return;\\n        }\\n        --depth;\\n        int pivot = partition(toorder, lo, hi);\\n\\n        /* Process the smaller working set first; iterate on the larger. */\\n        if (pivot - lo < hi - pivot) {\\n            if (lo < pivot)\\n                introsort_range(toorder, lo, pivot - 1, depth);\\n            lo = pivot + 1;\\n        } else {\\n            if (pivot < hi)\\n                introsort_range(toorder, pivot + 1, hi, depth);\\n            hi = pivot - 1;\\n        }\\n    }\\n    if (lo < hi)\\n        insertion_sort_range(toorder, lo, hi);\\n}\\n\\n/*\\n * Bounded-depth quicksort on an inclusive subrange.\\n */\\nvoid _quicksort(int *toorder, int lo, int hi)\\n{\\n    if (lo >= hi)\\n        return;\\n    unsigned int count = (unsigned int)(hi - lo) + 1U;\\n    int depth = 0;\\n    while (count > 1U) {\\n        count >>= 1;\\n        depth += 2;\\n    }\\n    introsort_range(toorder, lo, hi, depth);\\n}\\n\\n/*\\n * Swap two values.\\n */\\nvoid swap(int *toorder, int i, int j)\\n{\\n    int temp = toorder[i];\\n    toorder[i] = toorder[j];\\n    toorder[j] = temp;\\n}\\n\\n/*\\n * Two-sided block partition. Values equal to the pivot may go to either\\n * side. The returned position contains the pivot; both sides exclude it.\\n */\\nint partition(int *toorder, int lo, int hi)\\n{\\n    if (lo >= hi)\\n        return lo;\\n\\n    int mid = lo + (hi - lo) / 2;\\n    int selected;\\n    if (toorder[lo] < toorder[mid]) {\\n        if (toorder[mid] < toorder[hi])\\n            selected = mid;\\n        else\\n            selected = toorder[lo] < toorder[hi] ? hi : lo;\\n    } else {\\n        if (toorder[lo] < toorder[hi])\\n            selected = lo;\\n        else\\n            selected = toorder[mid] < toorder[hi] ? hi : mid;\\n    }\\n    int pivot = toorder[selected];\\n    swap(toorder, selected, hi);\\n\\n    int left = lo;\\n    int right = hi;\\n    unsigned char left_offsets[PARTITION_BLOCK_SIZE];\\n    unsigned char right_offsets[PARTITION_BLOCK_SIZE];\\n    int left_count = 0;\\n    int right_count = 0;\\n    int left_used = 0;\\n    int right_used = 0;\\n\\n    /*\\n     * Classify two disjoint contiguous blocks into small offset queues,\\n     * then exchange misplaced pairs without a branch for each key.\\n     */\\n    while (right - left >= 2 * PARTITION_BLOCK_SIZE) {\\n        if (left_count == 0) {\\n            left_used = 0;\\n            for (int i = 0; i < PARTITION_BLOCK_SIZE; ++i) {\\n                left_offsets[left_count] = (unsigned char)i;\\n                left_count += (toorder[left + i] >= pivot);\\n            }\\n        }\\n        if (right_count == 0) {\\n            right_used = 0;\\n            for (int i = 0; i < PARTITION_BLOCK_SIZE; ++i) {\\n                right_offsets[right_count] = (unsigned char)i;\\n                right_count += (toorder[right - 1 - i] <= pivot);\\n            }\\n        }\\n\\n        int pairs = left_count < right_count ? left_count : right_count;\\n        for (int i = 0; i < pairs; ++i) {\\n            swap(toorder,\\n                 left + left_offsets[left_used + i],\\n                 right - 1 - right_offsets[right_used + i]);\\n        }\\n        left_count -= pairs;\\n        right_count -= pairs;\\n        left_used += pairs;\\n        right_used += pairs;\\n        if (left_count == 0)\\n            left += PARTITION_BLOCK_SIZE;\\n        if (right_count == 0)\\n            right -= PARTITION_BLOCK_SIZE;\\n    }\\n\\n    /* Unfinished blocks remain inside [left, right); rescan only this tail. */\\n    while (left < right) {\\n        while (left < right && toorder[left] < pivot)\\n            ++left;\\n        while (left < right && toorder[right - 1] > pivot)\\n            --right;\\n        if (left < right) {\\n            --right;\\n            swap(toorder, left, right);\\n            ++left;\\n        }\\n    }\\n    swap(toorder, left, hi);\\n    return left;\\n}\\n\\n/*\\n * Check if elements are in non-decreasing order\\n */\\nint is_sorted(int *toorder, int N)\\n{\\n    for (int i = 1; i < N; i++) {\\n\\tif (toorder[i] < toorder[i - 1]) {\\n\\t    return 1;\\n\\t}\\n    }\\n    return 0;\\n}\\n\\n\\n/*\\n * Generate a case\\n */\\nint *generate_case(int N)\\n{\\n    int i;\\n    int *ret = NULL;\\n\\n    // Make case generation reproducible\\n    srandnum(0);\\n\\n    // Allocate memory\\n    ret = (int *) malloc(N * sizeof(int));\\n    if (ret == NULL) {\\n\\tprintf(\\\"Error: some malloc won't work.\\\\n\\\");\\n\\treturn NULL;\\n    }\\n    // Get pseudo-random positive integer values\\n    for (i = 0; i < N; i++) {\\n\\tret[i] = drand(0, INT_MAX);\\n    }\\n    return ret;\\n}\\n\\n/*\\n * A pseudo-random number between two positive integer values\\n */\\ndouble drand(int xmin, int xmax)\\n{\\n    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;\\n}\\n\",\n      \"path\": \"src/quicksort.c\"\n    }\n  ],\n  \"hypothesis\": \"In-place, two-sided partitioning of contiguous 64-element blocks should reduce swap traffic and unpredictable classification branches versus randomized Lomuto partitioning. Finishing small partitions immediately should improve cache locality.\",\n  \"notes\": \"Single serial comparison-sort experiment; no new dependencies or proportional-size allocation. Generation, sortedness checking, MD5 and output remain unchanged. Not compiled or measured; correctness and speed require controller evaluation.\",\n  \"research\": {\n    \"queries\": [],\n    \"urls\": []\n  },\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Replace randomized Lomuto partitioning with deterministic median-of-three, two-sided block partitioning using two 64-byte offset queues and distributing equal keys across both sides.\",\n    \"Insertion-sort contiguous ranges of at most 24 elements and process smaller partitions first with tail iteration over larger partitions.\",\n    \"Limit partition depth to twice floor(log2(range length)), falling back to in-place heapsort.\"\n  ]\n}"}}

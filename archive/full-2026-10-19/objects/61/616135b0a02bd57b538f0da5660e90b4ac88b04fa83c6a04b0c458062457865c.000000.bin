    {
      "content": "#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <algorithm>\n#include <cstdint>\n\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\ntypedef std::int64_t Sum;\n\nclass FastInput {\n    unsigned char buffer[1 << 16];\n    std::size_t position;\n    std::size_t length;\n\n    int next() {\n        if (position == length) {\n            length = std::fread(buffer, 1, sizeof(buffer), stdin);\n            position = 0;\n            if (length == 0)\n                return EOF;\n        }\n        return buffer[position++];\n    }\n\npublic:\n    FastInput() : position(0), length(0) {}\n\n    bool readInt(int& value) {\n        int c = next();\n        while (c <= ' ') {\n            if (c == EOF)\n                return false;\n            c = next();\n        }\n        bool negative = false;\n        if (c == '-' || c == '+') {\n            negative = c == '-';\n            c = next();\n        }\n        std::uint32_t magnitude = 0;\n        while (c >= '0' && c <= '9') {\n            magnitude = magnitude * 10u + static_cast<unsigned>(c - '0');\n            c = next();\n        }\n        value = static_cast<int>(negative ? -static_cast<Sum>(magnitude)\n                                          : static_cast<Sum>(magnitude));\n        return true;\n    }\n};\n\n#if defined(__aarch64__)\nstatic inline int64x2_t prefix_pair(int64x2_t values) {\n    const int64x2_t zero = vdupq_n_s64(0);\n    return vaddq_s64(values, vextq_s64(zero, values, 1));\n}\n\nstatic inline int64x2_t last_lane(int64x2_t values) {\n    return vdupq_n_s64(vgetq_lane_s64(values, 1));\n}\n\nstatic inline int64x2_t maximum64(int64x2_t a, int64x2_t b) {\n    return vbslq_s64(vcgtq_s64(a, b), a, b);\n}\n#endif\n\ntemplate <bool Update>\nstatic Sum evaluate_row(Sum* column, int n, int s, Sum& first,\n                        const int* incoming, const int* outgoing) {\n    if (Update) {\n        Sum first_delta = 0;\n        #pragma omp simd reduction(+:first_delta)\n        for (int col = 0; col < s; ++col) {\n            const Sum delta = static_cast<Sum>(incoming[col])\n                            - static_cast<Sum>(outgoing[col]);\n            column[col] += delta;\n            first_delta += delta;\n        }\n        first += first_delta;\n    }\n\n#if defined(__aarch64__)\n    int64x2_t carry = vdupq_n_s64(first);\n    int64x2_t best0 = carry;\n    int64x2_t best1 = carry;\n    int64x2_t best2 = carry;\n    int64x2_t best3 = carry;\n    int col = s;\n\n    for (; col + 8 <= n; col += 8) {\n        int64x2_t a0 = vld1q_s64(column + col);\n        int64x2_t a1 = vld1q_s64(column + col + 2);\n        int64x2_t a2 = vld1q_s64(column + col + 4);\n        int64x2_t a3 = vld1q_s64(column + col + 6);\n        if (Update) {\n            const int32x4_t in0 = vld1q_s32(incoming + col);\n            const int32x4_t out0 = vld1q_s32(outgoing + col);\n            const int32x4_t in1 = vld1q_s32(incoming + col + 4);\n            const int32x4_t out1 = vld1q_s32(outgoing + col + 4);\n            a0 = vaddq_s64(a0, vsubl_s32(vget_low_s32(in0), vget_low_s32(out0)));\n            a1 = vaddq_s64(a1, vsubl_s32(vget_high_s32(in0), vget_high_s32(out0)));\n            a2 = vaddq_s64(a2, vsubl_s32(vget_low_s32(in1), vget_low_s32(out1)));\n            a3 = vaddq_s64(a3, vsubl_s32(vget_high_s32(in1), vget_high_s32(out1)));\n            // Store the entire block before loading shifted, possibly overlapping columns.\n            vst1q_s64(column + col, a0);\n            vst1q_s64(column + col + 2, a1);\n            vst1q_s64(column + col + 4, a2);\n            vst1q_s64(column + col + 6, a3);\n        }\n\n        int64x2_t p0 = prefix_pair(vsubq_s64(a0, vld1q_s64(column + col - s)));\n        int64x2_t p1 = prefix_pair(vsubq_s64(a1, vld1q_s64(column + col + 2 - s)));\n        int64x2_t p2 = prefix_pair(vsubq_s64(a2, vld1q_s64(column + col + 4 - s)));\n        int64x2_t p3 = prefix_pair(vsubq_s64(a3, vld1q_s64(column + col + 6 - s)));\n\n        p1 = vaddq_s64(p1, last_lane(p0));\n        p3 = vaddq_s64(p3, last_lane(p2));\n        const int64x2_t half_total = last_lane(p1);\n        p2 = vaddq_s64(p2, half_total);\n        p3 = vaddq_s64(p3, half_total);\n\n        const int64x2_t base = carry;\n        carry = vaddq_s64(carry, last_lane(p3));\n        best0 = maximum64(best0, vaddq_s64(base, p0));\n        best1 = maximum64(best1, vaddq_s64(base, p1));\n        best2 = maximum64(best2, vaddq_s64(base, p2));\n        best3 = maximum64(best3, vaddq_s64(base, p3));\n    }\n\n    for (; col + 2 <= n; col += 2) {\n        int64x2_t values = vld1q_s64(column + col);\n        if (Update) {\n            const int64x2_t delta = vsubl_s32(vld1_s32(incoming + col),\n                                             vld1_s32(outgoing + col));\n            values = vaddq_s64(values, delta);\n            vst1q_s64(column + col, values);\n        }\n        const int64x2_t prefix = prefix_pair(vsubq_s64(values,\n                                                     vld1q_s64(column + col - s)));\n        const int64x2_t base = carry;\n        carry = vaddq_s64(carry, last_lane(prefix));\n        best0 = maximum64(best0, vaddq_s64(base, prefix));\n    }\n\n    const int64x2_t vector_best = maximum64(maximum64(best0, best1),\n                                           maximum64(best2, best3));\n    Sum best = std::max(vgetq_lane_s64(vector_best, 0),\n                        vgetq_lane_s64(vector_best, 1));\n    Sum sum = vgetq_lane_s64(carry, 0);\n    for (; col < n; ++col) {\n        if (Update) {\n            column[col] += static_cast<Sum>(incoming[col])\n                         - static_cast<Sum>(outgoing[col]);\n        }\n        sum += column[col] - column[col - s];\n        best = std::max(best, sum);\n    }\n    return best;\n#else\n    Sum sum = first;\n    Sum best = first;\n    for (int col = s; col < n; ++col) {\n        if (Update) {\n            column[col] += static_cast<Sum>(incoming[col])\n                         - static_cast<Sum>(outgoing[col]);\n        }\n        sum += column[col] - column[col - s];\n        best = std::max(best, sum);\n    }\n    return best;\n#endif\n}\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.readInt(n) || !input.readInt(s))\n        return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    std::vector<std::vector<int> > matrix(n, std::vector<int>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            input.readInt(matrix[i][j]);\n\n    std::vector<Sum> columns(n, 0);\n    Sum* column = columns.data();\n    for (int row = 0; row < s; ++row) {\n        const int* values = matrix[row].data();\n        #pragma omp simd\n        for (int col = 0; col < n; ++col)\n            column[col] += static_cast<Sum>(values[col]);\n    }\n\n    Sum first = 0;\n    #pragma omp simd reduction(+:first)\n    for (int col = 0; col < s; ++col)\n        first += column[col];\n\n    Sum best = evaluate_row<false>(column, n, s, first, nullptr, nullptr);\n    const int last = n - s;\n    for (int top = 1; top <= last; ++top) {\n        const int* outgoing = matrix[top - 1].data();\n        const int* incoming = matrix[top + s - 1].data();\n        best = std::max(best, evaluate_row<true>(column, n, s, first,\n                                               incoming, outgoing));\n    }\n\n    std::printf(\"%d\\n\", static_cast<int>(best));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Fusing vertical updates with an eight-window NEON prefix tree should shorten horizontal dependency chains and eliminate a separate column-update pass.",
  "notes": "All differences and sums remain signed 64-bit. Block stores precede overlapping shifted loads, including when S=1. No commands or measurements were run.",

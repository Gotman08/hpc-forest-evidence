{
  "src/bucketsort.c": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nstatic int compare_records(const void *left, const void *right) {\n    return strcmp((const char *)left, (const char *)right);\n}\n\nstatic char *bucket_sort(char *strings, int length, long int size,\n                         int offset, int nbuckets) {\n    size_t width = (size_t)length;\n    size_t n_items = (size_t)size;\n    size_t bytes = n_items * width;\n    size_t *starts = (size_t *)calloc((size_t)nbuckets, sizeof(*starts));\n    size_t *next = (size_t *)malloc((size_t)nbuckets * sizeof(*next));\n    char *sorted = (char *)malloc(bytes == 0 ? 1 : bytes);\n    long int i;\n    int b;\n\n    if (starts == NULL || next == NULL || sorted == NULL) {\n        free(starts);\n        free(next);\n        free(sorted);\n        fprintf(stderr, \"ERROR allocation\");\n        exit(EXIT_FAILURE);\n    }\n\n    /* Count entries first so each bucket gets an exact, disjoint range. */\n    for (i = 0; i < size; ++i) {\n        b = (int)strings[(size_t)i * width] - offset;\n        ++starts[b];\n    }\n\n    /* Turn counts into bucket starts and independent scatter cursors. */\n    {\n        size_t prefix = 0;\n        for (b = 0; b < nbuckets; ++b) {\n            size_t count = starts[b];\n            starts[b] = prefix;\n            next[b] = prefix;\n            prefix += count;\n        }\n    }\n\n    /* Gather complete records into contiguous bucket ranges. */\n    for (i = 0; i < size; ++i) {\n        size_t source = (size_t)i * width;\n        b = (int)strings[source] - offset;\n        memcpy(sorted + next[b] * width, strings + source, width);\n        ++next[b];\n    }\n\n    /* Each qsort operates on a separate contiguous range. */\n#ifdef _OPENMP\n#pragma omp parallel for schedule(dynamic, 1)\n#endif\n    for (b = 0; b < nbuckets; ++b) {\n        size_t count = next[b] - starts[b];\n        if (count > 1) {\n            qsort(sorted + starts[b] * width, count, width, compare_records);\n        }\n    }\n\n    free(starts);\n    free(next);\n    return sorted;\n}\n\nstatic void load(char **vString, long int *N, int *l, int *os, int *nb) {\n    char *strings = NULL;\n    int len;\n    int offset;\n    int nbucket;\n    long int n;\n\n    if (!fscanf(stdin, \"%d\", &len)) {\n        printf(\"ERROR len\\n\");\n        exit(1);\n    }\n    if (!fscanf(stdin, \"%ld\", &n)) {\n        printf(\"ERROR n\\n\");\n        exit(1);\n    }\n    if (!fscanf(stdin, \"%d\", &offset)) {\n        printf(\"ERROR offset\\n\");\n        exit(1);\n    }\n    if (!fscanf(stdin, \"%d\", &nbucket)) {\n        printf(\"ERROR nbucket\\n\");\n        exit(1);\n    }\n\n    nbucket = nbucket + 1;\n    len = len + 1;\n    strings = (char *)malloc((size_t)n * (size_t)len);\n\n    for (long int i = 0; i < n; ++i) {\n        if (!fscanf(stdin, \"%s\", strings + (size_t)i * (size_t)len)) {\n            printf(\"ERROR %ld\\n\", i);\n            exit(1);\n        }\n    }\n\n    *vString = strings;\n    *N = n;\n    *l = len;\n    *os = offset;\n    *nb = nbucket;\n}\n\nstatic void save(char *strings, long int n, int len) {\n    for (long int i = 0; i < n; ++i) {\n        printf(\"%s\\n\", strings + (size_t)i * (size_t)len);\n    }\n}\n\nint main(int ac, char **av) {\n    char *strings = NULL;\n    char *sorted = NULL;\n    long int N = 0;\n    int len = 0;\n    int offset;\n    int nbuckets;\n\n    load(&strings, &N, &len, &offset, &nbuckets);\n    sorted = bucket_sort(strings, len, N, offset, nbuckets);\n    save(sorted, N, len);\n\n    free(strings);\n    free(sorted);\n    return EXIT_SUCCESS;\n}\n"
}

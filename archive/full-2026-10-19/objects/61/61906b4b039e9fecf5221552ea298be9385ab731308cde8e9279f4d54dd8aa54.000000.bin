      "content": "#include \"knn.h\"\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\ntypedef struct {\n    float *distances;\n    char *labels;\n    size_t count;\n    size_t next;\n} KnnRun;\n\nstatic char knn_vote(char *labels, int k) {\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nstatic char knn_serial(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *) malloc(sizeof(char) * k);\n    float *distances = (float *) malloc(sizeof(float) * k);\n\n    for (int i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (int x = 0; x < k; x++) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (int y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    char result = knn_vote(labels, k);\n    free(distances);\n    free(labels);\n    return result;\n}\n\nstatic int knn_build_run(int n_groups, const Group *groups, int k,\n                         Point to_evaluate, size_t skip, size_t remaining,\n                         KnnRun *run) {\n    const size_t capacity = remaining < (size_t) k ? remaining : (size_t) k;\n    if (capacity == 0) return 0;\n\n    run->distances = (float *) malloc(sizeof(float) * capacity);\n    run->labels = (char *) malloc(sizeof(char) * capacity);\n    if (run->distances == NULL || run->labels == NULL) return 1;\n\n    size_t used = 0;\n    for (int i = 0; i < n_groups && remaining > 0; i++) {\n        const Group g = groups[i];\n        const size_t length = g.length > 0 ? (size_t) g.length : 0;\n        if (skip >= length) {\n            skip -= length;\n            continue;\n        }\n\n        size_t end = length;\n        if (end - skip > remaining) end = skip + remaining;\n\n        for (size_t j = skip; j < end; j++) {\n            const float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            /* NaNs require the original, order-dependent scan. */\n            if (d != d) return 1;\n\n            if (used == capacity && !(d < run->distances[capacity - 1])) {\n                continue;\n            }\n\n            size_t position = used < capacity ? used : capacity - 1;\n            /* Strict comparison preserves input order for equal distances. */\n            while (position > 0 && d < run->distances[position - 1]) {\n                run->distances[position] = run->distances[position - 1];\n                run->labels[position] = run->labels[position - 1];\n                position--;\n            }\n            run->distances[position] = d;\n            run->labels[position] = g.label;\n            if (used < capacity) used++;\n        }\n\n        remaining -= end - skip;\n        skip = 0;\n    }\n\n    run->count = used;\n    return 0;\n}\n\nstatic void knn_free_runs(KnnRun *runs, int count) {\n    for (int i = 0; i < count; i++) {\n        free(runs[i].distances);\n        free(runs[i].labels);\n    }\n    free(runs);\n}\n\nstatic char knn_lists(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) return knn_serial(n_groups, groups, k, to_evaluate);\n\n    size_t total = 0;\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length > 0) total += (size_t) groups[i].length;\n    }\n\n    int workers = 1;\n#ifdef _OPENMP\n    const int available = omp_get_max_threads();\n    const size_t width = (size_t) k < 64 ? (size_t) k : 64;\n    const size_t grain = 65536 / width;\n    const size_t allowed_by_work = total / grain;\n    workers = allowed_by_work < (size_t) available\n                  ? (int) allowed_by_work : available;\n#endif\n    if (workers < 2) return knn_serial(n_groups, groups, k, to_evaluate);\n\n    KnnRun *runs = (KnnRun *) calloc((size_t) workers, sizeof(KnnRun));\n    if (runs == NULL) return knn_serial(n_groups, groups, k, to_evaluate);\n\n    const size_t base = total / (size_t) workers;\n    const size_t remainder = total % (size_t) workers;\n    int failed = 0;\n\n#ifdef _OPENMP\n#pragma omp parallel for num_threads(workers) schedule(static, 1) reduction(|:failed)\n#endif\n    for (int block = 0; block < workers; block++) {\n        const size_t b = (size_t) block;\n        const size_t begin = b * base + (b < remainder ? b : remainder);\n        const size_t count = base + (b < remainder ? 1 : 0);\n        failed |= knn_build_run(n_groups, groups, k, to_evaluate,\n                                begin, count, &runs[block]);\n    }\n\n    if (failed) {\n        knn_free_runs(runs, workers);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    char *labels = (char *) malloc(sizeof(char) * (size_t) k);\n    if (labels == NULL) {\n        knn_free_runs(runs, workers);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n    for (int i = 0; i < k; i++) labels[i] = -1;\n\n    for (int i = 0; i < k; i++) {\n        int best = -1;\n        for (int block = 0; block < workers; block++) {\n            const KnnRun *candidate = &runs[block];\n            if (candidate->next == candidate->count) continue;\n            /* Earlier blocks precede later blocks in the original input. */\n            if (best < 0 || candidate->distances[candidate->next] <\n                            runs[best].distances[runs[best].next]) {\n                best = block;\n            }\n        }\n        if (best < 0) break;\n        labels[i] = runs[best].labels[runs[best].next];\n        runs[best].next++;\n    }\n\n    knn_free_runs(runs, workers);\n    char result = knn_vote(labels, k);\n    free(labels);\n    return result;\n}\n\nenum {\n    KNN_RADIX_BINS = 2048,\n    KNN_LABEL_COUNT = UCHAR_MAX + 1\n};\n\ntypedef struct {\n    size_t begin;\n    size_t count;\n    size_t equal_quota;\n    size_t bins[KNN_RADIX_BINS];\n    size_t votes[KNN_LABEL_COUNT];\n} KnnRadixBlock;\n\nstatic int knn_radix_build(int n_groups, const Group *groups,\n                            Point to_evaluate, uint32_t *keys,\n                            KnnRadixBlock *block) {\n    size_t skip = block->begin;\n    size_t remaining = block->count;\n    size_t output = block->begin;\n    memset(block->bins, 0, sizeof(block->bins));\n\n    for (int i = 0; i < n_groups && remaining > 0; i++) {\n        const Group g = groups[i];\n        const size_t length = g.length > 0 ? (size_t) g.length : 0;\n        if (skip >= length) {\n            skip -= length;\n            continue;\n        }\n\n        size_t end = length;\n        if (end - skip > remaining) end = skip + remaining;\n        for (size_t j = skip; j < end; j++) {\n            const float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            uint32_t key;\n            memcpy(&key, &d, sizeof(key));\n            /* Both zero encodings compare equal in the original scan. */\n            if ((key & UINT32_C(0x7fffffff)) == 0) key = 0;\n            /* Positive infinity is ordered; NaNs need the serial fallback. */\n            if (key > UINT32_C(0x7f800000)) return 1;\n            keys[output++] = key;\n            block->bins[key >> 22]++;\n        }\n\n        remaining -= end - skip;\n        skip = 0;\n    }\n    return 0;\n}\n\nstatic void knn_radix_histogram(const uint32_t *keys, KnnRadixBlock *block,\n                                uint32_t prefix, uint32_t mask,\n                                unsigned int shift) {\n    memset(block->bins, 0, sizeof(block->bins));\n    const size_t end = block->begin + block->count;\n    for (size_t i = block->begin; i < end; i++) {\n        const uint32_t key = keys[i];\n        if ((key & mask) == prefix) {\n            block->bins[(key >> shift) & (KNN_RADIX_BINS - 1u)]++;\n        }\n    }\n}\n\nstatic unsigned int knn_radix_bucket(const KnnRadixBlock *blocks,\n                                     int workers, size_t *rank) {\n    for (unsigned int bin = 0; bin < KNN_RADIX_BINS; bin++) {\n        size_t count = 0;\n        for (int block = 0; block < workers; block++) {\n            count += blocks[block].bins[bin];\n        }\n        if (*rank <= count) return bin;\n        *rank -= count;\n    }\n    return 0;\n}\n\nstatic void knn_radix_vote(int n_groups, const Group *groups,\n                           const uint32_t *keys, uint32_t cutoff,\n                           KnnRadixBlock *block) {\n    size_t skip = block->begin;\n    size_t remaining = block->count;\n    size_t input = block->begin;\n    size_t equal_quota = block->equal_quota;\n    memset(block->votes, 0, sizeof(block->votes));\n\n    for (int i = 0; i < n_groups && remaining > 0; i++) {\n        const Group g = groups[i];\n        const size_t length = g.length > 0 ? (size_t) g.length : 0;\n        if (skip >= length) {\n            skip -= length;\n            continue;\n        }\n\n        size_t end = length;\n        if (end - skip > remaining) end = skip + remaining;\n        size_t selected = 0;\n        for (size_t j = skip; j < end; j++) {\n            const uint32_t key = keys[input++];\n            selected += (size_t) (key < cutoff);\n            if (key == cutoff && equal_quota > 0) {\n                selected++;\n                equal_quota--;\n            }\n        }\n        block->votes[(unsigned char) g.label] += selected;\n        remaining -= end - skip;\n        skip = 0;\n    }\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    /* Keep the inexpensive private-list path for small selections. */\n    if (k <= 64) return knn_lists(n_groups, groups, k, to_evaluate);\n\n    if (sizeof(float) != sizeof(uint32_t)) {\n        return knn_lists(n_groups, groups, k, to_evaluate);\n    }\n    const float unit = 1.0f;\n    uint32_t unit_bits = 0;\n    memcpy(&unit_bits, &unit, sizeof(unit_bits));\n    if (unit_bits != UINT32_C(0x3f800000)) {\n        return knn_lists(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t total = 0;\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length > 0) {\n            const size_t length = (size_t) groups[i].length;\n            if (length > SIZE_MAX - total) {\n                return knn_lists(n_groups, groups, k, to_evaluate);\n            }\n            total += length;\n        }\n    }\n    if (total == 0) return (char) -1;\n\n    int workers = 1;\n#ifdef _OPENMP\n    const int available = omp_get_max_threads();\n    size_t allowed_by_work = total / 32768;\n    if (allowed_by_work == 0) allowed_by_work = 1;\n    if (available > 1) {\n        workers = allowed_by_work < (size_t) available\n                      ? (int) allowed_by_work : available;\n    }\n#endif\n\n    if (total > SIZE_MAX / sizeof(uint32_t) ||\n        (size_t) workers > SIZE_MAX / sizeof(KnnRadixBlock)) {\n        return knn_lists(n_groups, groups, k, to_evaluate);\n    }\n    uint32_t *keys = (uint32_t *) malloc(total * sizeof(uint32_t));\n    KnnRadixBlock *blocks = (KnnRadixBlock *) calloc(\n        (size_t) workers, sizeof(KnnRadixBlock));\n    if (keys == NULL || blocks == NULL) {\n        free(keys);\n        free(blocks);\n        return knn_lists(n_groups, groups, k, to_evaluate);\n    }\n\n    const size_t base = total / (size_t) workers;\n    const size_t remainder = total % (size_t) workers;\n    for (int block = 0; block < workers; block++) {\n        const size_t b = (size_t) block;\n        blocks[block].begin = b * base + (b < remainder ? b : remainder);\n        blocks[block].count = base + (b < remainder ? 1 : 0);\n    }\n\n    size_t rank = (size_t) k < total ? (size_t) k : total;\n    uint32_t prefix = 0;\n    uint32_t mask = 0;\n    int failed = 0;\n\n    /* One team serves distance generation, all radix passes, and voting. */\n#ifdef _OPENMP\n#pragma omp parallel num_threads(workers)\n#endif\n    {\n#ifdef _OPENMP\n#pragma omp for schedule(static, 1) reduction(|:failed)\n#endif\n        for (int block = 0; block < workers; block++) {\n            failed |= knn_radix_build(n_groups, groups, to_evaluate,\n                                      keys, &blocks[block]);\n        }\n\n        if (!failed) {\n#ifdef _OPENMP\n#pragma omp single\n#endif\n            {\n                const unsigned int bucket = knn_radix_bucket(blocks, workers, &rank);\n                prefix = (uint32_t) bucket << 22;\n                mask = UINT32_MAX << 22;\n            }\n\n            /* Ten high bits followed by two eleven-bit refinements. */\n            for (int pass = 1; pass < 3; pass++) {\n                const unsigned int shift = pass == 1 ? 11u : 0u;\n#ifdef _OPENMP\n#pragma omp for schedule(static, 1)\n#endif\n                for (int block = 0; block < workers; block++) {\n                    knn_radix_histogram(keys, &blocks[block], prefix, mask, shift);\n                }\n#ifdef _OPENMP\n#pragma omp single\n#endif\n                {\n                    const unsigned int bucket = knn_radix_bucket(blocks, workers, &rank);\n                    prefix |= (uint32_t) bucket << shift;\n                    mask = UINT32_MAX << shift;\n                    if (shift == 0) {\n                        size_t needed = rank;\n                        /* Contiguous blocks give exact input-order tie quotas. */\n                        for (int block = 0; block < workers; block++) {\n                            const size_t equal = blocks[block].bins[bucket];\n                            const size_t take = equal < needed ? equal : needed;\n                            blocks[block].equal_quota = take;\n                            needed -= take;\n                        }\n                    }\n                }\n            }\n\n#ifdef _OPENMP\n#pragma omp for schedule(static, 1) nowait\n#endif\n            for (int block = 0; block < workers; block++) {\n                knn_radix_vote(n_groups, groups, keys, prefix, &blocks[block]);\n            }\n        }\n    }\n\n    if (failed) {\n        free(keys);\n        free(blocks);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t votes[KNN_LABEL_COUNT] = {0};\n    for (int block = 0; block < workers; block++) {\n        for (int label = 0; label < KNN_LABEL_COUNT; label++) {\n            votes[label] += blocks[block].votes[label];\n        }\n    }\n    if ((size_t) k > total) {\n        votes[(unsigned char) ((char) -1)] += (size_t) k - total;\n    }\n\n    /* Match compare_for_sort's char ordering and strict frequency tie rule. */\n    char result = (char) CHAR_MIN;\n    size_t best_count = 0;\n    for (int label = CHAR_MIN; label <= CHAR_MAX; label++) {\n        const size_t count = votes[(unsigned char) label];\n        if (count > best_count) {\n            best_count = count;\n            result = (char) label;\n        }\n    }\n\n    free(keys);\n    free(blocks);\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],

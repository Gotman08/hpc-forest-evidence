+  // Valid prefix sums and query keys cannot equal INT_MIN.\\n+  alignas(16) int keys_[2048];\\n+  uint32_t counts_[2048];\\n+  unsigned capacity_;\\n+  unsigned mask_;\\n+\\n+  unsigned locate(int value, uint32_t hash) const {\\n+    unsigned group = hash & mask_ & ~3u;\\n+#if defined(__aarch64__)\\n+    const int32x4_t wanted = vdupq_n_s32(value);\\n+    const int32x4_t empty = vdupq_n_s32(INT_MIN);\\n+    for (;;) {\\n+      const int32x4_t stored = vld1q_s32(keys_ + group);\\n+      unsigned matches = lane_mask(vceqq_s32(stored, wanted));\\n+      if (matches)\\n+        return group + static_cast<unsigned>(__builtin_ctz(matches));\\n+      unsigned vacancies = lane_mask(vceqq_s32(stored, empty));\\n+      if (vacancies)\\n+        return group + static_cast<unsigned>(__builtin_ctz(vacancies));\\n+      group = (group + 4u) & mask_;\\n+    }\\n+#else\\n+    for (;;) {\\n+      for (unsigned lane = 0; lane < 4; ++lane) {\\n+        unsigned slot = group + lane;\\n+        if (keys_[slot] == value || keys_[slot] == INT_MIN)\\n+          return slot;\\n+      }\\n+      group = (group + 4u) & mask_;\\n+    }\\n+#endif\\n+  }\\n+\\n+public:\\n+  explicit PrefixCounter(unsigned entries) : capacity_(4), mask_(3) {\\n+    while (capacity_ < 2u * entries)\\n+      capacity_ *= 2u;\\n+    mask_ = capacity_ - 1u;\\n+  }\\n+\\n+  void clear() {\\n+    fill_n(keys_, capacity_, INT_MIN);\\n+    // The initial empty prefix has hash zero.\\n+    keys_[0] = 0;\\n+    counts_[0] = 1;\\n+  }\\n+\\n+  uint32_t consume(int value, int target, uint32_t value_hash,\\n+                   uint32_t target_hash) {\\n+    // Both probes are read-only and may be evaluated independently.\\n+    unsigned update_slot = locate(value, value_hash);\\n+    unsigned query_slot = locate(target, target_hash);\\n+    uint32_t result = keys_[query_slot] == target ? counts_[query_slot] : 0u;\\n+\\n+    // Preserve query-before-increment ordering, including when k is zero.\\n+    if (keys_[update_slot] == INT_MIN) {\\n+      keys_[update_slot] = value;\\n+      counts_[update_slot] = 1;\\n+    } else {\\n+      ++counts_[update_slot];\\n+    }\\n+    return result;\\n+  }\\n+};\\n+\\n ll solve(int m, int n, int k) {\\n-  for (int i = 1; i <= m; i++) {\\n-    for (int j = 1; j <= n; j++) {\\n-      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\\n+  // ps[column boundary][row boundary] is a two-dimensional prefix sum.\\n+  for (int i = 0; i <= m; i++)\\n+    ps[0][i] = 0;\\n+  for (int j = 1; j <= n; j++) {\\n+    ps[j][0] = 0;\\n+    int column_sum = 0;\\n+    for (int i = 1; i <= m; i++) {\\n+      column_sum += A[i - 1][j - 1];\\n+      ps[j][i] = ps[j - 1][i] + column_sum;\\n     }\\n   }\\n-  unordered_map<ll, ll> h;\\n+\\n+  PrefixCounter h(static_cast<unsigned>(m + 1));\\n   ll ans = 0;\\n-  for (int j = 1; j <= n; j++) // O(m*n^2)\\n+  int band_prefix[1000];\\n+  uint32_t value_hash[1000];\\n+  uint32_t target_hash[1000];\\n+  for (int j = 1; j <= n; j++)\\n     for (int l = j; l <= n; l++) {\\n+      const int *right = ps[l] + 1;\\n+      const int *left = ps[j - 1] + 1;\\n+      // Differences and unsigned hash arithmetic have no cross-row dependency.\\n+#pragma GCC ivdep\\n+      for (int i = 0; i < m; i++) {\\n+        int value = right[i] - left[i];\\n+        band_prefix[i] = value;\\n+        value_hash[i] = prefix_hash(value);\\n+        target_hash[i] = prefix_hash(value - k);\\n+      }\\n+\\n       h.clear();\\n-      h[0] = 1;\\n-      ll s = 0;\\n-      for (int i = 1; i <= m; i++) {\\n-        s += ps[i][l] - ps[i][j - 1];\\n-        ans += h.find(s - k) != h.end() ? h[s - k] : 0;\\n-        h[s]++;\\n+      for (int i = 0; i < m; i++) {\\n+        int value = band_prefix[i];\\n+        ans += h.consume(value, value - k, value_hash[i], target_hash[i]);\\n       }\\n     }\\n   return ans;\"}, {\"id\": \"93aea31ad5f34d5a\", \"role\": \"A\", \"commit\": \"dc2ee063a5347c87aa68703b97b28154b72fcf30\", \"transformations\": {\"files\": [\"src/main.cpp\"], \"retained\": [\"Replace unordered_map with a contiguous open-addressed table containing full signed keys, multiplicities and generation tags.\", \"Allocate power-of-two capacity for at least twice m+1 entries; use unsigned 64-bit hashing, explicit key comparisons and linear probing.\", \"Reset through generation tags and query before incrementing, preserving repeated prefixes and k=0 behavior.\"]}, \"mean_seconds\": 0.08961059059947729, \"diff\": \"diff --git a/src/main.cpp b/src/main.cpp\\nindex b3a5f60..490cfd6 100644\\n--- a/src/main.cpp\\n+++ b/src/main.cpp\\n@@ -7,23 +7,92 @@ int ps[1010][1010];\\n \\n typedef long long ll;\\n \\n+class PrefixCounts {\\n+  struct Slot {\\n+    ll key;\\n+    uint32_t count;\\n+    uint32_t generation;\\n+  };\\n+\\n+  vector<Slot> slots;\\n+  size_t mask;\\n+  uint32_t generation;\\n+\\n+  static size_t capacity_for(size_t max_entries) {\\n+    size_t capacity = 1;\\n+    while (capacity < 2 * max_entries)\\n+      capacity <<= 1;\\n+    return capacity;\\n+  }\\n+\\n+  static uint64_t hash_key(ll key) {\\n+    uint64_t x = static_cast<uint64_t>(key);\\n+    x = (x ^ (x >> 30)) * UINT64_C(0xbf58476d1ce4e5b9);\\n+    x = (x ^ (x >> 27)) * UINT64_C(0x94d049bb133111eb);\\n+    return x ^ (x >> 31);\\n+  }\\n+\\n+public:\\n+  explicit PrefixCounts(size_t max_entries)\\n+      : slots(capacity_for(max_entries)), mask(slots.size() - 1),\\n+        generation(0) {}\\n+\\n+  void clear() {\\n+    if (++generation == 0) {\\n+      for (Slot &slot : slots)\\n+        slot.generation = 0;\\n+      generation = 1;\\n+    }\\n+  }\\n+\\n+  ll get(ll key) const {\\n+    size_t index = static_cast<size_t>(hash_key(key)) & mask;\\n+    for (;;) {\\n+      const Slot &slot = slots[index];\\n+      if (slot.generation != generation)\\n+        return 0;\\n+      if (slot.key == key)\\n+        return slot.count;\\n+      index = (index + 1) & mask;\\n+    }\\n+  }\\n+\\n+  void increment(ll key) {\\n+    size_t index = static_cast<size_t>(hash_key(key)) & mask;\\n+    for (;;) {\\n+      Slot &slot = slots[index];\\n+      if (slot.generation != generation) {\\n+        slot.key = key;\\n+        slot.count = 1;\\n+        slot.generation = generation;\\n+        return;\\n+      }\\n+      if (slot.key == key) {\\n+        ++slot.count;\\n+        return;\\n+      }\\n+      index = (index + 1) & mask;\\n+    }\\n+  }\\n+};\\n+\\n ll solve(int m, int n, int k) {\\n   for (int i = 1; i <= m; i++) {\\n     for (int j = 1; j <= n; j++) {\\n       ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\\n     }\\n   }\\n-  unordered_map<ll, ll> h;\\n+  PrefixCounts h(static_cast<size_t>(m) + 1);\\n   ll ans = 0;\\n   for (int j = 1; j <= n; j++) // O(m*n^2)\\n     for (int l = j; l <= n; l++) {\\n       h.clear();\\n-      h[0] = 1;\\n+      h.increment(0);\\n       ll s = 0;\\n       for (int i = 1; i <= m; i++) {\\n         s += ps[i][l] - ps[i][j - 1];\\n-        ans += h.find(s - k) != h.end() ? h[s - k] : 0;\\n-        h[s]++;\\n+        ans += h.get(s - k);\\n+        h.increment(s);\\n       }\\n     }\\n   return ans;\"}, {\"id\": \"d870df3ccbf444bb\", \"role\": \"C\", \"commit\": \"9a38b4f1a4e9ef41151dda494f507ae15dc08814\", \"transformations\": {\"files\": [\"src/main.cpp\"], \"retained\": [\"Share independent prefix rows statically within the counting parallel region.\", \"Partition the triangular column-interval space into batches targeting 4096 row visits, capped at 64 intervals, and dynamically schedule those batches.\", \"Use thread-private reusable hash maps and a 64-bit sum reduction; serialize workloads below 65536 row visits.\"]}, \"mean_seconds\": 0.0927633432050546, \"diff\": \"diff --git a/src/main.cpp b/src/main.cpp\\nindex b3a5f60..20c9529 100644\\n--- a/src/main.cpp\\n+++ b/src/main.cpp\\n@@ -8,24 +8,57 @@ int ps[1010][1010];\\n typedef long long ll;\\n \\n ll solve(int m, int n, int k) {\\n-  for (int i = 1; i <= m; i++) {\\n-    for (int j = 1; j <= n; j++) {\\n-      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\\n-    }\\n-  }\\n-  unordered_map<ll, ll> h;\\n+  const ll pair_count = (ll)n * (n + 1) / 2;\\n+  const ll row_work = pair_count * m;\\n+  const ll pairs_per_block = max(1LL, min(64LL, 4096LL / m));\\n+  const ll block_count = (pair_count + pairs_per_block - 1) / pairs_per_block;\\n   ll ans = 0;\\n-  for (int j = 1; j <= n; j++) // O(m*n^2)\\n-    for (int l = j; l <= n; l++) {\\n-      h.clear();\\n-      h[0] = 1;\\n-      ll s = 0;\\n-      for (int i = 1; i <= m; i++) {\\n-        s += ps[i][l] - ps[i][j - 1];\\n-        ans += h.find(s - k) != h.end() ? h[s - k] : 0;\\n-        h[s]++;\\n+\\n+#pragma omp parallel if(row_work >= 65536) reduction(+:ans)\\n+  {\\n+#pragma omp for schedule(static)\\n+    for (int i = 1; i <= m; i++) {\\n+      for (int j = 1; j <= n; j++) {\\n+        ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\\n+      }\\n+    }\\n+\\n+    unordered_map<ll, ll> h;\\n+#pragma omp for schedule(dynamic, 1)\\n+    for (ll block = 0; block < block_count; block++) {\\n+      const ll first = block * pairs_per_block;\\n+      const ll last = min(pair_count, first + pairs_per_block);\\n+\\n+      int lo = 1;\\n+      int hi = n;\\n+      while (lo < hi) {\\n+        const int mid = lo + (hi - lo + 1) / 2;\\n+        const ll before = (ll)(mid - 1) * (2LL * n - mid + 2) / 2;\\n+        if (before <= first)\\n+          lo = mid;\\n+        else\\n+          hi = mid - 1;\\n+      }\\n+      int j = lo;\\n+      const ll before = (ll)(j - 1) * (2LL * n - j + 2) / 2;\\n+      int l = j + (int)(first - before);\\n+\\n+      for (ll p = first; p < last; p++) {\\n+        h.clear();\\n+        h[0] = 1;\\n+        ll s = 0;\\n+        for (int i = 1; i <= m; i++) {\\n+          s += ps[i][l] - ps[i][j - 1];\\n+          ans += h.find(s - k) != h.end() ? h[s - k] : 0;\\n+          h[s]++;\\n+        }\\n+        if (++l > n) {\\n+          ++j;\\n+          l = j;\\n+        }\\n       }\\n     }\\n+  }\\n   return ans;\\n }\"}, {\"id\": \"aa19ddbe99ac44d7\", \"role\": \"C\", \"commit\": \"f86e7d0c7ae488b7d01ccca229e085af05369e4e\", \"transformations\": {\"files\": [\"src/main.cpp\"], \"retained\": [\"Use one OpenMP region with static row-prefix work sharing and an implicit barrier before counting.\", \"Flatten triangular column-pair work into equal contiguous per-thread ranges, decoding each range's starting pair only once.\", \"Reuse a private unordered_map per worker and combine counts through a 64-bit OpenMP reduction.\", \"Serialize workloads below 32768 row/interval iterations to limit threading overhead.\"]}, \"mean_seconds\": 0.10039971613635619, \"diff\": \"diff --git a/src/main.cpp b/src/main.cpp\\nindex b3a5f60..17e0e37 100644\\n--- a/src/main.cpp\\n+++ b/src/main.cpp\\n@@ -1,4 +1,7 @@\\n #include <bits/stdc++.h>\\n+#ifdef _OPENMP\\n+#include <omp.h>\\n+#endif\\n \\n using namespace std;\\n \\n@@ -8,15 +11,44 @@ int ps[1010][1010];\\n typedef long long ll;\\n \\n ll solve(int m, int n, int k) {\\n-  for (int i = 1; i <= m; i++) {\\n-    for (int j = 1; j <= n; j++) {\\n-      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\\n-    }\\n-  }\\n-  unordered_map<ll, ll> h;\\n+  const ll pair_count = static_cast<ll>(n) * (n + 1) / 2;\\n   ll ans = 0;\\n-  for (int j = 1; j <= n; j++) // O(m*n^2)\\n-    for (int l = j; l <= n; l++) {\\n+\\n+#ifdef _OPENMP\\n+#pragma omp parallel if (static_cast<ll>(m) * pair_count >= 32768) reduction(+:ans)\\n+#endif\\n+  {\\n+#ifdef _OPENMP\\n+#pragma omp for schedule(static)\\n+#endif\\n+    for (int i = 1; i <= m; i++) {\\n+      ps[i][0] = 0;\\n+      for (int j = 1; j <= n; j++) {\\n+        ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\\n+      }\\n+    }\\n+\\n+    int thread_id = 0;\\n+    int thread_count = 1;\\n+#ifdef _OPENMP\\n+    thread_id = omp_get_thread_num();\\n+    thread_count = omp_get_num_threads();\\n+#endif\\n+\\n+    const ll first_pair = pair_count * thread_id / thread_count;\\n+    const ll last_pair = pair_count * (thread_id + 1) / thread_count;\\n+\\n+    // Decode the first pair in this worker's contiguous triangular range.\\n+    int j = 1;\\n+    ll offset = first_pair;\\n+    while (j <= n && offset >= n - j + 1) {\\n+      offset -= n - j + 1;\\n+      ++j;\\n+    }\\n+    int l = j + static_cast<int>(offset);\\n+\\n+    unordered_map<ll, ll> h;\\n+    for (ll pair = first_pair; pair < last_pair; ++pair) {\\n       h.clear();\\n       h[0] = 1;\\n       ll s = 0;\\n@@ -25,7 +57,14 @@ ll solve(int m, int n, int k) {\\n         ans += h.find(s - k) != h.end() ? h[s - k] : 0;\\n         h[s]++;\\n       }\\n+\\n+      ++l;\\n+      if (l > n) {\\n+        ++j;\\n+        l = j;\\n+      }\\n     }\\n+  }\\n   return ans;\\n }\"}, {\"id\": \"0a3406f468964d04\", \"role\": \"B\", \"commit\": \"3c0fc299a3fc5b6eb48fd7b4e320512c361dacc2\", \"transformations\": {\"files\": [\"src/main.cpp\"], \"retained\": [\"Replace row-only prefixes with column-boundary-major two-dimensional prefixes.\", \"Materialize each band's prefix differences in a separate SIMD-eligible loop while preserving serial frequency counting and unchanged I/O.\"]}, \"mean_seconds\": 0.24706870162238678, \"diff\": \"diff --git a/src/main.cpp b/src/main.cpp\\nindex b3a5f60..9476eb5 100644\\n--- a/src/main.cpp\\n+++ b/src/main.cpp\\n@@ -8,20 +8,34 @@ int ps[1010][1010];\\n typedef long long ll;\\n \\n ll solve(int m, int n, int k) {\\n-  for (int i = 1; i <= m; i++) {\\n-    for (int j = 1; j <= n; j++) {\\n-      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\\n+  // ps[column boundary][row boundary] is a two-dimensional prefix sum.\\n+  for (int i = 0; i <= m; i++)\\n+    ps[0][i] = 0;\\n+  for (int j = 1; j <= n; j++) {\\n+    ps[j][0] = 0;\\n+    int column_sum = 0;\\n+    for (int i = 1; i <= m; i++) {\\n+      column_sum += A[i - 1][j - 1];\\n+      ps[j][i] = ps[j - 1][i] + column_sum;\\n     }\\n   }\\n+\\n   unordered_map<ll, ll> h;\\n   ll ans = 0;\\n-  for (int j = 1; j <= n; j++) // O(m*n^2)\\n+  int band_prefix[1000];\\n+  for (int j = 1; j <= n; j++)\\n     for (int l = j; l <= n; l++) {\\n+      const int *right = ps[l] + 1;\\n+      const int *left = ps[j - 1] + 1;\\n+      // These differences are independent; keep them outside hash updates.\\n+#pragma GCC ivdep\\n+      for (int i = 0; i < m; i++)\\n+        band_prefix[i] = right[i] - left[i];\\n+\\n       h.clear();\\n       h[0] = 1;\\n-      ll s = 0;\\n-      for (int i = 1; i <= m; i++) {\\n-        s += ps[i][l] - ps[i][j - 1];\\n+      for (int i = 0; i < m; i++) {\\n+        ll s = band_prefix[i];\\n         ans += h.find(s - k) != h.end() ? h[s - k] : 0;\\n         h[s]++;\\n       }\"}], \"interactions\": [{\"sources\": [\"718780280eb84e1e\", \"aa19ddbe99ac44d7\"], \"outcome\": {\"binary_sha256\": \"4d14367cd7c6917d67f11377fe0797a576309a08a33c1b33f242fb1c3af92884\", \"cache_key\": \"444802bfbf91df76351980c15d5e7200070fdd4815b1b18326fb5623fe8e0af3\", \"commit\": \"e65e98cb86da90c8b3d08806eea7bf16e78f4bf9\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-harness-comparison-20261016-r1-source-only-gpt-6.1-sol-max-665743a02b824021a697b6a4884a667c/run/results-751592/2023-sum/logs/e1/370cfe5435ae47cd/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-harness-comparison-20261016-r1-source-only-gpt-6.1-sol-max-665743a02b824021a697b6a4884a667c/run/results-751592/2023-sum/logs/e1/370cfe5435ae47cd/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-harness-comparison-20261016-r1-source-only-gpt-6.1-sol-max-665743a02b824021a697b6a4884a667c/run/results-751592/2023-sum/logs/e1/370cfe5435ae47cd/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-harness-comparison-20261016-r1-source-only-gpt-6.1-sol-max-665743a02b824021a697b6a4884a667c/run/results-751592/2023-sum/logs/e1/370cfe5435ae47cd/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-harness-comparison-20261016-r1-source-only-gpt-6.1-
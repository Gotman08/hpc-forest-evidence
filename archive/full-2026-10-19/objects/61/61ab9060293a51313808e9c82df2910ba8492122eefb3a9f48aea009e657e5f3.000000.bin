#include <iostream>
#include <vector>

using namespace std;

constexpr int MOD = 1000000007;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    cin >> n >> m;

    vector<vector<bool>> blockedCells(n, vector<bool>(n, false));
    for (int c = 0; c < m; ++c) {
        int y, x;
        cin >> y >> x;
        blockedCells[y][x] = true;
    }

    // dp[j] is the number of paths arriving from the preceding row.
    // Once updated, dp[j - 1] is the current row's left neighbor.
    vector<int> dp(n, 0);
    dp[0] = 1;

    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            if (blockedCells[i][j]) {
                dp[j] = 0;
            } else if (j != 0) {
                int value = dp[j] + dp[j - 1];
                if (value >= MOD)
                    value -= MOD;
                dp[j] = value;
            }
        }
    }

    cout << dp[n - 1] << '\n';
}

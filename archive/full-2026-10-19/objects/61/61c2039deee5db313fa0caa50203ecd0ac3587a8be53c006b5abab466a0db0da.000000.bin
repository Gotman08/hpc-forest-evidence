      "content": "#include \"knn.h\"\n\n#define DISTANCE_BATCH_SIZE 256\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n    float batch_distances[DISTANCE_BATCH_SIZE];\n\n    int i, j, x, y;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length;) {\n            int batch_size = g.length - j;\n            if (batch_size > DISTANCE_BATCH_SIZE) {\n                batch_size = DISTANCE_BATCH_SIZE;\n            }\n\n            /* Each lane writes a distinct scratch element; selection stays ordered below. */\n            #pragma GCC ivdep\n            for (int lane = 0; lane < batch_size; lane++) {\n                Point point = g.points[j + lane];\n                batch_distances[lane] = ((point.x - to_evaluate.x) * ((point.x - to_evaluate.x))) +\n                                        ((point.y - to_evaluate.y) * (point.y - to_evaluate.y));\n            }\n\n            for (int lane = 0; lane < batch_size; lane++) {\n                float d = batch_distances[lane];\n\n                for (x = 0; x < k; x++) {\n                    if (d < distances[x] || distances[x] == -1) {\n                        for (y = k - 1; y > x; y--) {\n                            distances[y] = distances[y - 1];\n                            labels[y] = labels[y - 1];\n                        }\n\n                        distances[x] = d;\n                        labels[x] = g.label;\n\n                        break;\n                    }\n                }\n            }\n\n            j += batch_size;\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Batching independent point-distance calculations into a small contiguous scratch array exposes a legal SIMD loop, while keeping top-k insertion and voting in their original encounter order preserves tie behavior.",

{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <iostream>\\n#include <vector>\\n#include <utility>\\n\\nusing namespace std;\\n\\ntypedef vector<vector<bool>> adjacency_matrix;\\n\\nadjacency_matrix readGraph();\\n\\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence);\\ninline void printPermutation(vector<int> &equivalence);\\n\\nint main(){\\n    adjacency_matrix g1 = readGraph();\\n    adjacency_matrix g2 = readGraph();\\n\\n    if(!testIsomorphism(g1, g2))\\n        cout << \\\"The graphs are not isomorphic\\\" << endl;\\n\\n    return 0;\\n}\\n\\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2){\\n    vector<int> equivalence(g1.size(), 0);\\n    vector<int> exchange_counter(g1.size(), 0);\\n    int exchange_index = 1;\\n    bool isomorphism_found = false;\\n\\n    if(g1.size() != g2.size()) return false;\\n\\n    for(int i = 0; i < equivalence.size(); ++i)\\n        equivalence[i] = i;\\n\\n    if(verifyPermutation(g1, g2, equivalence)){\\n        printPermutation(equivalence);\\n        return true;\\n    }\\n\\n    // For larger searches, validate batches in parallel while preserving Heap order.\\n    if(g1.size() >= 8){\\n        const int n = static_cast<int>(g1.size());\\n        const int batch_capacity = 1024;\\n        vector<int> permutation_batch(batch_capacity * n);\\n        vector<int> output_permutation(n);\\n        vector<unsigned char> valid(batch_capacity, 0);\\n        int batch_count = 0;\\n        bool done = false;\\n\\n        #pragma omp parallel shared(equivalence, exchange_counter, exchange_index, permutation_batch, output_permutation, valid, batch_count, done, isomorphism_found)\\n        {\\n            vector<int> candidate(n);\\n\\n            while(!done){\\n                #pragma omp single\\n                {\\n                    batch_count = 0;\\n                    while(batch_count < batch_capacity && !done){\\n                        if(exchange_index >= n){\\n                            done = true;\\n                            break;\\n                        }\\n\\n                        if(exchange_counter[exchange_index] < exchange_index){\\n                            if(exchange_index % 2 == 0)\\n                                swap(equivalence[0], equivalence[exchange_index]);\\n                            else\\n                                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\\n\\n                            for(int i = 0; i < n; ++i)\\n                                permutation_batch[batch_count * n + i] = equivalence[i];\\n\\n                            ++batch_count;\\n                            exchange_counter[exchange_index]++;\\n                            exchange_index = 1;\\n                        }else{\\n                            exchange_counter[exchange_index] = 0;\\n                            exchange_index++;\\n                        }\\n                    }\\n                }\\n\\n                #pragma omp for schedule(static)\\n                for(int batch_index = 0; batch_index < batch_count; ++batch_index){\\n                    for(int i = 0; i < n; ++i)\\n                        candidate[i] = permutation_batch[batch_index * n + i];\\n                    valid[batch_index] = verifyPermutation(g1, g2, candidate);\\n                }\\n\\n                #pragma omp single\\n                {\\n                    for(int batch_index = 0; batch_index < batch_count; ++batch_index){\\n                        if(valid[batch_index]){\\n                            for(int i = 0; i < n; ++i)\\n                                output_permutation[i] = permutation_batch[batch_index * n + i];\\n                            printPermutation(output_permutation);\\n                            isomorphism_found = true;\\n                        }\\n                    }\\n                }\\n            }\\n        }\\n        return isomorphism_found;\\n    }\\n\\n    /*\\n     * Permutations are based on Heap's algorithm, which generates all possible\\n     * permutations for a given set of elements.\\n     */\\n    while(exchange_index < g1.size()){\\n        if(exchange_counter[exchange_index] < exchange_index){\\n            if(exchange_index % 2 == 0)\\n                swap(equivalence[0], equivalence[exchange_index]);\\n            else\\n                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\\n            if(verifyPermutation(g1, g2, equivalence)){\\n                printPermutation(equivalence);\\n                isomorphism_found = true;\\n            }\\n\\n            exchange_counter[exchange_index]++;\\n            exchange_index = 1;\\n        }else{\\n            exchange_counter[exchange_index] = 0;\\n            exchange_index++;\\n        }\\n    }\\n    return isomorphism_found;\\n}\\n\\nadjacency_matrix readGraph(){\\n    int vertices, edges, source, destination;\\n\\n    cin >> vertices;\\n    adjacency_matrix read(vertices);\\n    for (int i = 0; i < vertices; ++i)\\n        read[i].resize(vertices);\\n\\n    cin >> edges;\\n    for (int i = 0; i < edges; i++) {\\n       cin >> source >> destination;\\n       read[destination][source] = read[source][destination] = true;\\n    }\\n\\n    return read;\\n}\\n\\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence){\\n    for (int i = 0; i < equivalence.size(); ++i) {\\n        for (int j = 0; j <= i; ++j) {\\n            if(g1[i][j] != g2[equivalence[i]][equivalence[j]]) return false;\\n        }\\n    }\\n   return true;\\n}\\n\\ninline void printPermutation(vector<int> &equivalence){\\n    for (auto i : equivalence)\\n        cout << i << \\\" \\\";\\n    cout << endl;\\n}\\n\",\"path\":\"src/brute_isomorphism.cpp\"}],\"hypothesis\":\"For graph orders of at least eight vertices, batching Heap-order permutations into a persistent OpenMP team can parallelize adjacency validation while retaining the original output order; smaller searches stay serial to avoid thread overhead.\",\"notes\":\"The identity-permutation fast path and the serial path for smaller graphs are preserved. The batched path checks and prints every remaining matching permutation in Heap order. No integration sources were supplied; correctness and performance were not measured.\",\"sources_kept\":[],\"transformations\":[\"Added an OpenMP parallel region for validation of 1024-permutation batches when the graph order is at least eight.\",\"Kept permutation generation sequential and emitted each batch's matches sequentially in original Heap order.\",\"Retained the original identity fast path and serial enumeration for smaller graph orders.\"]}"}}

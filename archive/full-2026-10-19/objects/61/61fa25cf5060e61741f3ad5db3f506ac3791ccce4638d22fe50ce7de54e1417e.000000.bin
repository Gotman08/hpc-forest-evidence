    {
      "id": "527a64a4c94e4bd5",
      "role": "A",
      "mission": {
        "base_commit": "0a0343f709921cae760851556cdaf708edeaf850",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "A contiguous bounded max-heap will eliminate capacity-wide neighbor scans and suffix shifts, reducing selection memory traffic to a root check per rejected point and one logarithmic heap path per accepted point.",
        "id": "527a64a4c94e4bd5",
        "ordinal": 2,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/knn.c"
          ],
          "retained": [
            "Store retained neighbors in one contiguous array of distance, label, and input-ordinal records.",
            "Fill the array sequentially and build the heap bottom-up; subsequently reject against its root and update only a root-to-leaf path.",
            "Preserve reference selection semantics through ordinal tie-breaking, unused-label sentinels, and a serial fallback for unordered distances; release temporary storage on return."
          ]
        },
        "tree_id": "e1:A",
        "trial_id": "01M53NXSSRCJJF325REMBDCQ5Q",

    {
      "id": "e2673be1305b415b",
      "role": "C",
      "mission": {
        "base_commit": "0a0343f709921cae760851556cdaf708edeaf850",
        "delegation_parent": "R/C",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "A persistent, capped OpenMP team can remove the serial selection bottleneck by sharing partition passes and accumulating accepted-label votes, while processing small residuals serially.",
        "id": "e2673be1305b415b",
        "ordinal": 2,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/knn.c"
          ],
          "retained": [
            "Generate distance/group records in balanced contiguous input slices using at most four workers and a minimum work-per-worker threshold.",
            "Use one persistent team for three-way partitioning, rank-count reductions and disjoint integer vote accumulation; compact and select small residuals serially.",
            "Guard selection work with a cumulative budget and heapsort fallback.",
            "Resolve distance ties by original group order; within-group ties have identical labels. Preserve native-char vote tie ordering and reference fallback for unordered distances."
          ]
        },
        "tree_id": "e1:C",
        "trial_id": "01M53P80ZZ65TYJF949XSC9ZX6",

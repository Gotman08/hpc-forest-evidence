        "epoch": 1,
        "hypothesis": "ARM64 NEON comparisons can accelerate the linear insertion-position search by checking four distances per iteration while preserving the first matching position.",
        "id": "ebf069bfdb1d42a8",
        "ordinal": 1,
        "parent_id": null,
        "role": "B",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/knn.c"
          ],
          "retained": [
            "Replace the scalar insertion-position search with a four-lane NEON comparison scan that returns the earliest matching lane.",
            "Retain a scalar remainder loop and a compile-time scalar fallback when AArch64 NEON is unavailable."
          ]
        },

    {
      "id": "04956d5553ad4fa4",
      "role": "A",
      "mission": {
        "base_commit": "0a0343f709921cae760851556cdaf708edeaf850",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Worst-distance rejection and bulk movement of only the occupied neighbor-buffer suffix will eliminate most linear scans and reduce memory traffic while preserving stable selection.",
        "id": "04956d5553ad4fa4",
        "ordinal": 1,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/knn.c"
          ],
          "retained": [
            "Track the occupied prefix of the contiguous distance and label buffers; reject noncompetitive points immediately once the buffers are full.",
            "Locate stable insertion positions with an upper-bound binary search and use memmove only on the occupied suffix.",
            "Switch permanently to the original insertion loops upon encountering a NaN distance, and free per-call scratch buffers after voting."
          ]
        },
        "tree_id": "e1:A",
        "trial_id": "01M53N2ZV47MTPXHWBSMJ72ZKQ",

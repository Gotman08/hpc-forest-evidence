    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <omp.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n  return bodies;\n}\n\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n  Body *bodies = read_dataset(&nbodies);\n\n#pragma omp parallel\n  for (int iter = 0; iter < N_ITER; iter++) {\n    // Force computation: each thread computes forces for a subset of bodies\n#pragma omp for schedule(dynamic,16) private(fx,fy,fz)\n    for (int i = 0; i < nbodies; ++i) {\n      float fx = 0.0f;\n      float fy = 0.0f;\n      float fz = 0.0f;\n\n      for (int j = 0; j < nbodies; j++) {\n        float dx = bodies[j].x - bodies[i].x;\n        float dy = bodies[j].y - bodies[i].y;\n        float dz = bodies[j].z - bodies[i].z;\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1.0f / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx += dx * inv_dist3;\n        fy += dy * inv_dist3;\n        fz += dz * inv_dist3;\n      }\n\n      bodies[i].vx += DT * fx;\n      bodies[i].vy += DT * fy;\n      bodies[i].vz += DT * fz;\n    }\n\n    // Position update: each thread updates a subset of positions (static schedule)\n#pragma omp for schedule(static)\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  } // end parallel region\n\n  write_dataset(nbodies, bodies);\n  free(bodies);\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Using a single OpenMP parallel region across all simulation iterations with dynamic scheduling (chunk size 16) for the force loop adapts to runtime load imbalances from memory access patterns, while static scheduling on the trivial position update minimizes overhead. Inlining the force computation avoids function call overhead and allows better compiler optimization within the parallel context.",
  "notes": "Dynamic schedule chosen over guided/static based on prior experiments showing near-peak performance; chunk size 16 provides a balance between granularity and load balancing without excessive scheduling overhead.",
  "sources_kept": [],

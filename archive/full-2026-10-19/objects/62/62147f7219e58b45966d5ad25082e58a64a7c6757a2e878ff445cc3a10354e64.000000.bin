"""Static source/hash review only; post-close main is never imported or called."""
import ast
import hashlib
import json
from pathlib import Path

BASE = Path("C:/Users/nicol/Documents/Codex/2026-10-15/cr")
REL = BASE / "outputs/HPC-Forest-Primes-Natif-Relance-r2g"
PREP = REL / "operations-parent/post-cloture-r1"
HERE = Path(__file__).resolve().parent


def need(value, message):
    if not value:
        raise ValueError(message)


def ref(path):
    return {"path": str(path), "sha256": hashlib.sha256(path.read_bytes()).hexdigest()}


manifest_path = PREP / "MANIFESTE-PREPARATION-POST-CLOTURE-FERMEE.json"
need(ref(manifest_path)["sha256"] == "c4ebcf0065c57e4f0b9987fb7089d7b199ff09dcc73c6cf4df5ef659e40549fd",
     "Preparation manifest changed")
manifest = json.loads(manifest_path.read_bytes())
for row in manifest["files"]:
    path = PREP / row["name"]
    need(path.parent == PREP and path.stat().st_size == row["bytes"]
         and ref(path)["sha256"] == row["sha256"], "Prepared member changed")
code = PREP / "preserver-post-cloture-parent.py"
source = code.read_text(encoding="utf8")
tree = ast.parse(source)
need(ref(code)["sha256"] == "fdb831fbaaf9db871aa2edc4b6255c14a4a36fc190d6bad1026adb1275e64e76",
     "Reviewed post-close source changed")
deps = []
for name, pin in (
    ("collecte-finale-pure-r2/collecter-final-parent.py", manifest["collector_sha256"]),
    ("fermeture-relais-r2g-r2/preparer-fermeture-r2g-r2.py", manifest["final_proof_gate_sha256"]),
    ("fermeture-relais-r2g-r2/graphe_possede_21.py", manifest["graph_sha256"]),
    ("fermeture-relais-r2g-r2/GRAPHE-HISTORIQUE-21-CANDIDAT.json", manifest["historical_graph_sha256"]),
):
    value = ref(REL / name)
    need(value["sha256"] == pin, "Pinned closed dependency changed")
    deps.append(value)
need(not any(isinstance(n, ast.Attribute) and n.attr in
             {"Popen", "run", "system", "terminate", "kill", "connect", "socket"} for n in ast.walk(tree)),
     "Unexpected process/network/effect API")
test = json.loads((PREP / manifest["final_neutral_report"]).read_bytes())
need(test["passed"] is True and test["tests_run"] == 3 and test["fixtures_only"] is True
     and test["post_main_executed"] is False and test["lock_bytes_read"] is False
     and test["tested_files"][code.name] == ref(code)["sha256"], "Received three-case report differs")
result = {
    "schema": "hpc-forest-r2g-independent-post-closure-preparation-review-v1",
    "verified": True, "blocking_findings": [],
    "verified_scope": "Static future post-closure metadata and byte-preservation preparation only",
    "reviewed_code": ref(code), "reviewed_manifest": ref(manifest_path), "pinned_dependencies": deps,
    "actual_six_proofs_required_by_unchanged_final_contract": True,
    "known_closure_and_global_per_target_intents_required": True,
    "UNKNOWN_effect_evidence_refused": True,
    "natural_closure_requires_no_effect_intent": True,
    "complete_supplied_CIM_fresh_45_seconds_all21_absent_required_before_each_lock_and_publication": True,
    "PID_reuse_unknown_descendants_or_G_session_processes_refused": True,
    "intention_before_source_cache_reads": True,
    "all_readable_bytes_must_equal_pre_stop_opaque_copy": True,
    "lock_read_only_after_real_closure_and_absence": True,
    "new_current_lock_bytes_stable_and_copied_exclusively": True,
    "pre_stop_lock_sha_remains_unknown": True,
    "pre_post_lock_byte_equality_claimed": False,
    "canonical_receipt_only_after_all_three_actual_caches_and_locks_pass": True,
    "three_received_pure_tests_inspected_not_replayed": True,
    "post_close_or_dependency_main_import_or_execution_by_reviewer": False,
    "live_cache_CIM_lock_process_model_CLI_MCP_or_network_access_by_reviewer": False,
    "runtime_inputs_or_closure_admitted_by_this_review": False,
    "stop_or_R5_or_scientific_admission": False,
    "limits": "Preparation only: no actual closure, all21 absence, current lock bytes or canonical final receipt is yet established by this review. ROOT must rehash exact code and supply real six proofs, known outcomes/intents and a fresh complete census; refusal preserves partial outputs without retry.",
}
out = HERE / "REVUE-PREPARATION-POST-CLOTURE-G.json"
with out.open("x", encoding="utf8", newline="\n") as stream:
    json.dump(result, stream, indent=2, ensure_ascii=True)
    stream.write("\n")
print(json.dumps({"path": str(out), "sha256": ref(out)["sha256"], "verified": True}))

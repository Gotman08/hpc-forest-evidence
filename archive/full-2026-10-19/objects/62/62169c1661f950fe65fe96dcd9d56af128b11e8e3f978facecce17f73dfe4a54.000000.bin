{
  "src/laplace_seq.c": "/*\n    This program solves Laplace's equation on a regular 2D grid using simple Jacobi iteration.\n*/\n#include <stdio.h>\n#include <stdlib.h>\n#include <time.h>\n#include <sys/time.h>\n#ifdef _OPENMP\n#include <omp.h>\n\ntypedef struct {\n    int changed;\n    char padding[128 - sizeof(int)];\n} ConvergenceSlot;\n#endif\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\n#define CONV_THRESHOLD 1.0e-5f\n\n// Matrix and auxiliary matrix, with separately allocated rows.\ndouble **grid;\ndouble **new_grid;\nint size;\nint iter_max_num;\n\ndouble absolute(double num){\n    if(num < 0)\n        return -1.0 * num;\n    return num;\n}\n\ntypedef struct {\n    int changed;\n#if defined(__aarch64__)\n    uint64x2_t mask0;\n    uint64x2_t mask1;\n    uint64x2_t mask2;\n    uint64x2_t mask3;\n#endif\n} SweepErrors;\n\nstatic inline void reset_errors(SweepErrors *errors){\n    errors->changed = 0;\n#if defined(__aarch64__)\n    errors->mask0 = vdupq_n_u64(0);\n    errors->mask1 = vdupq_n_u64(0);\n    errors->mask2 = vdupq_n_u64(0);\n    errors->mask3 = vdupq_n_u64(0);\n#endif\n}\n\nstatic inline int sweep_changed(const SweepErrors *errors){\n    int changed = errors->changed;\n#if defined(__aarch64__)\n    const uint64x2_t combined = vorrq_u64(\n        vorrq_u64(errors->mask0, errors->mask1),\n        vorrq_u64(errors->mask2, errors->mask3));\n    changed |= ((vgetq_lane_u64(combined, 0) |\n                 vgetq_lane_u64(combined, 1)) != 0);\n#endif\n    return changed;\n}\n\nstatic inline void update_row(const double *restrict row,\n                              const double *restrict above,\n                              const double *restrict below,\n                              double *restrict out,\n                              int n,\n                              SweepErrors *restrict errors){\n    int j = 1;\n    int changed = 0;\n#if defined(__aarch64__)\n    const float64x2_t quarter = vdupq_n_f64(0.25);\n    const float64x2_t threshold = vdupq_n_f64((double)CONV_THRESHOLD);\n    uint64x2_t vector_errors0 = errors->mask0;\n    uint64x2_t vector_errors1 = errors->mask1;\n    uint64x2_t vector_errors2 = errors->mask2;\n    uint64x2_t vector_errors3 = errors->mask3;\n    float64x2_t left = vld1q_f64(row);\n\n    // Reuse horizontal vectors and retain four independent error chains.\n    for(; j < n - 8; j += 8){\n        const float64x2_t right0 = vld1q_f64(row + j + 1);\n        const float64x2_t right1 = vld1q_f64(row + j + 3);\n        const float64x2_t right2 = vld1q_f64(row + j + 5);\n        const float64x2_t right3 = vld1q_f64(row + j + 7);\n\n        float64x2_t sum0 = vaddq_f64(right0, left);\n        float64x2_t sum1 = vaddq_f64(right1, right0);\n        float64x2_t sum2 = vaddq_f64(right2, right1);\n        float64x2_t sum3 = vaddq_f64(right3, right2);\n        sum0 = vaddq_f64(sum0, vld1q_f64(above + j));\n        sum1 = vaddq_f64(sum1, vld1q_f64(above + j + 2));\n        sum2 = vaddq_f64(sum2, vld1q_f64(above + j + 4));\n        sum3 = vaddq_f64(sum3, vld1q_f64(above + j + 6));\n        sum0 = vaddq_f64(sum0, vld1q_f64(below + j));\n        sum1 = vaddq_f64(sum1, vld1q_f64(below + j + 2));\n        sum2 = vaddq_f64(sum2, vld1q_f64(below + j + 4));\n        sum3 = vaddq_f64(sum3, vld1q_f64(below + j + 6));\n\n        const float64x2_t value0 = vmulq_f64(quarter, sum0);\n        const float64x2_t value1 = vmulq_f64(quarter, sum1);\n        const float64x2_t value2 = vmulq_f64(quarter, sum2);\n        const float64x2_t value3 = vmulq_f64(quarter, sum3);\n        vst1q_f64(out + j, value0);\n        vst1q_f64(out + j + 2, value1);\n        vst1q_f64(out + j + 4, value2);\n        vst1q_f64(out + j + 6, value3);\n\n        const float64x2_t error0 = vabsq_f64(vsubq_f64(\n            value0, vextq_f64(left, right0, 1)));\n        const float64x2_t error1 = vabsq_f64(vsubq_f64(\n            value1, vextq_f64(right0, right1, 1)));\n        const float64x2_t error2 = vabsq_f64(vsubq_f64(\n            value2, vextq_f64(right1, right2, 1)));\n        const float64x2_t error3 = vabsq_f64(vsubq_f64(\n            value3, vextq_f64(right2, right3, 1)));\n        vector_errors0 = vorrq_u64(vector_errors0,\n                                   vcgtq_f64(error0, threshold));\n        vector_errors1 = vorrq_u64(vector_errors1,\n                                   vcgtq_f64(error1, threshold));\n        vector_errors2 = vorrq_u64(vector_errors2,\n                                   vcgtq_f64(error2, threshold));\n        vector_errors3 = vorrq_u64(vector_errors3,\n                                   vcgtq_f64(error3, threshold));\n        left = right3;\n    }\n\n    // Both lanes are interior cells, and neighbor loads remain within the row.\n    for(; j < n - 2; j += 2){\n        const float64x2_t right = vld1q_f64(row + j + 1);\n        float64x2_t sum = vaddq_f64(right, left);\n        sum = vaddq_f64(sum, vld1q_f64(above + j));\n        sum = vaddq_f64(sum, vld1q_f64(below + j));\n        const float64x2_t value = vmulq_f64(quarter, sum);\n        vst1q_f64(out + j, value);\n\n        const float64x2_t error = vabsq_f64(vsubq_f64(\n            value, vextq_f64(left, right, 1)));\n        vector_errors0 = vorrq_u64(vector_errors0,\n                                   vcgtq_f64(error, threshold));\n        left = right;\n    }\n    errors->mask0 = vector_errors0;\n    errors->mask1 = vector_errors1;\n    errors->mask2 = vector_errors2;\n    errors->mask3 = vector_errors3;\n#endif\n\n    // Scalar tail, or the complete row on other architectures.\n    for(; j < n - 1; j++){\n        out[j] = 0.25 * (row[j + 1] + row[j - 1] +\n                         above[j] + below[j]);\n        double errorCurrent = absolute(out[j] - row[j]);\n        changed |= (errorCurrent > CONV_THRESHOLD);\n    }\n    errors->changed |= changed;\n}\n\nvoid allocate_memory(){\n    grid = (double **) malloc(size * sizeof(double *));\n    new_grid = (double **) malloc(size * sizeof(double *));\n\n    for(int i = 0; i < size; i++){\n        grid[i] = (double *) malloc(size * sizeof(double));\n        new_grid[i] = (double *) malloc(size * sizeof(double));\n    }\n}\n\nvoid initialize_grid(){\n    int center = size / 2;\n    int linf = center - (size / 10);\n    int lsup = center + (size / 10);\n    for(int i = 0; i < size; i++){\n        for(int j = 0; j < size; j++){\n            if(i >= linf && i <= lsup && j >= linf && j <= lsup)\n                grid[i][j] = 100;\n            else\n                grid[i][j] = 0;\n            // Swapped buffers must retain identical frozen boundaries.\n            new_grid[i][j] = grid[i][j];\n        }\n    }\n}\n\nvoid save_grid(){\n    for(int i = 0; i < size; i++){\n        for(int j = 0; j < size; j++){\n            fprintf(stdout, \"%lf \", grid[i][j]);\n        }\n        fprintf(stdout, \"\\n\");\n    }\n}\n\nint main(int argc, char *argv[]){\n    fscanf(stdin, \"%d\", &size);\n    fscanf(stdin, \"%d\", &iter_max_num);\n\n    int hasError = 1;\n    int iter = 0;\n\n    allocate_memory();\n    initialize_grid();\n\n    const int n = size;\n    const int limit = iter_max_num;\n\n#ifdef _OPENMP\n    int thread_slots = 1;\n    ConvergenceSlot *flags = NULL;\n    if(n >= 128 && limit > 0){\n        thread_slots = omp_get_max_threads();\n        if(thread_slots > 1)\n            flags = malloc(2 * (size_t)thread_slots * sizeof(*flags));\n    }\n\n    if(flags != NULL){\n        int final_phase = 0;\n#pragma omp parallel default(none) shared(grid, new_grid, flags, final_phase, hasError, iter) firstprivate(n, limit, thread_slots)\n        {\n            const int tid = omp_get_thread_num();\n            const int workers = omp_get_num_threads();\n            double **current = grid;\n            double **next = new_grid;\n            int phase = 0;\n            int local_has_error = 1;\n            int local_iter = 0;\n\n            while(local_has_error && local_iter < limit){\n                SweepErrors errors;\n                reset_errors(&errors);\n#pragma omp for schedule(static) nowait\n                for(int i = 1; i < n - 1; i++){\n                    update_row(current[i], current[i - 1], current[i + 1],\n                               next[i], n, &errors);\n                }\n\n                flags[(size_t)phase * thread_slots + tid].changed =\n                    sweep_changed(&errors);\n#pragma omp barrier\n                local_has_error = 0;\n                for(int t = 0; t < workers; t++)\n                    local_has_error |=\n                        flags[(size_t)phase * thread_slots + t].changed;\n\n                double **tmp = current;\n                current = next;\n                next = tmp;\n                // Alternate banks so the next sweep cannot overwrite flags\n                // that a peer is still reading from this sweep.\n                phase ^= 1;\n                local_iter++;\n            }\n\n            if(tid == 0){\n                final_phase = phase;\n                hasError = local_has_error;\n                iter = local_iter;\n            }\n        }\n\n        if(final_phase){\n            double **tmp = grid;\n            grid = new_grid;\n            new_grid = tmp;\n        }\n        free(flags);\n    } else\n#endif\n    {\n        double **current = grid;\n        double **next = new_grid;\n        while(hasError && iter < limit){\n            SweepErrors errors;\n            reset_errors(&errors);\n            for(int i = 1; i < n - 1; i++){\n                update_row(current[i], current[i - 1], current[i + 1],\n                           next[i], n, &errors);\n            }\n            hasError = sweep_changed(&errors);\n\n            double **tmp = current;\n            current = next;\n            next = tmp;\n            iter++;\n        }\n        grid = current;\n        new_grid = next;\n    }\n\n    save_grid();\n    return 0;\n}\n"
}

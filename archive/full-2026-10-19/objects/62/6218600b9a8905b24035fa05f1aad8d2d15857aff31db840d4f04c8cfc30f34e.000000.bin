      "path": "src/solution.cpp",
      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n#ifdef __AVX2__\n#include <immintrin.h>\n#endif\n#include <omp.h>\n#include <climits>\n\nint main() {\n\tint n, s;\n\tstd::cin >> n >> s;\n\tstd::vector<std::vector<int>> matrix(n, std::vector<int>(n));\n\tfor (int i = 0; i < n; i++)\n\t\tfor (int j = 0; j < n; j++) \n\t\t\tscanf(\"%d\", &(matrix[i][j]));\n\n\tassert(s < n);\n\tassert(n < 8000);\n\tassert(s > 0);\n\tassert(n > 0);\n\n\tconst int blockSize = 32; // Define a block size for better cache performance\n\tint mxSum = INT_MIN;\n\n\t#pragma omp parallel reduction(max:mxSum)\n\t{\n\t\tint sum = 0;\n\t\t#pragma omp for collapse(2) reduction(+:sum)\n\t\tfor (int bi = 0; bi <= n - s; bi += blockSize) {\n\t\t\tfor (int bj = 0; bj <= n - s; bj += blockSize) {\n\t\t\t\tfor (int i = bi; i < std::min(bi + blockSize, n - s + 1); ++i) {\n\t\t\t\t\tfor (int j = bj; j < std::min(bj + blockSize, n - s + 1); ++j) {\n\t\t\t\t\t\tsum = 0;\n\t\t\t\t\t\tfor (int ii = i; ii < i + s; ++ii) {\n\t\t\t\t\t\t\tfor (int jj = j; jj < j + s; ++jj) {\n\t\t\t\t\t\t\t\tsum += matrix[ii][jj];\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\tmxSum = std::max(mxSum, sum);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t}\n\t}\n\n\tint dir = 1;\n\tint i = 0;\n\tint j = 0;\n\twhile (i + s <= n) {\n\t\tif ((j + s == n && dir == 1) || (j == 0 && dir == -1)) { \n\t\t\tint exitingRow = i;\n\t\t\tint enteringRow = exitingRow + s;\n\t\t\tif (enteringRow >= n) break;\n\n#ifdef __AVX2__\n\t\t\t__m256i sum_vec = _mm256_setzero_si256();\n\t\t\tfor (int k = 0; k < s - s % 8; k += 8) {\n\t\t\t\tsum_vec = _mm256_sub_epi32(sum_vec, _mm256_loadu_si256((__m256i*)&matrix[exitingRow][k + j]));\n\t\t\t\tsum_vec = _mm256_add_epi32(sum_vec, _mm256_loadu_si256((__m256i*)&matrix[enteringRow][k + j]));\n\t\t\t}\n\t\t\tint temp_sum[8];\n\t\t\t_mm256_storeu_si256((__m256i*)temp_sum, sum_vec);\n\t\t\tfor (int k = 0; k < s % 8; k++) {\n\t\t\t\tsum -= matrix[exitingRow][k + j + s - s % 8];\n\t\t\t\tsum += matrix[enteringRow][k + j + s - s % 8];\n\t\t\t}\n\t\t\tfor (int k = 0; k < 8; k++) {\n\t\t\t\tsum += temp_sum[k];\n\t\t\t}\n#else\n\t\t\tfor (int k = 0; k < s; k++) {\n\t\t\t\tsum -= matrix[exitingRow][k + j];\n\t\t\t\tsum += matrix[enteringRow][k + j];\n\t\t\t}\n#endif\n\n\t\t\ti++;\n\t\t\tdir *= -1;\n\t\t} else {\n\t\t\tint exitingCol, enteringCol;\n\t\t\tif (dir == 1) {\n\t\t\t\texitingCol = j;\n\t\t\t\tenteringCol = exitingCol + s;\n\t\t\t} else {\n\t\t\t\tenteringCol = j - 1;\n\t\t\t\texitingCol = enteringCol + s;\n\t\t\t}\n\n#ifdef __AVX2__\n\t\t\t__m256i sum_vec = _mm256_setzero_si256();\n\t\t\tfor (int k = 0; k < s - s % 8; k += 8) {\n\t\t\t\tsum_vec = _mm256_sub_epi32(sum_vec, _mm256_loadu_si256((__m256i*)&matrix[k + i][exitingCol]));\n\t\t\t\tsum_vec = _mm256_add_epi32(sum_vec, _mm256_loadu_si256((__m256i*)&matrix[k + i][enteringCol]));\n\t\t\t}\n\t\t\tint temp_sum[8];\n\t\t\t_mm256_storeu_si256((__m256i*)temp_sum, sum_vec);\n\t\t\tfor (int k = 0; k < s % 8; k++) {\n\t\t\t\tsum -= matrix[k + i][exitingCol + s - s % 8];\n\t\t\t\tsum += matrix[k + i][enteringCol + s - s % 8];\n\t\t\t}\n\t\t\tfor (int k = 0; k < 8; k++) {\n\t\t\t\tsum += temp_sum[k];\n\t\t\t}\n#else\n\t\t\tfor (int k = 0; k < s; k++) {\n\t\t\t\tsum -= matrix[k + i][exitingCol];\n\t\t\t\tsum += matrix[k + i][enteringCol];\n\t\t\t}\n#endif\n\n\t\t\tj += dir;\n\t\t}\n\t\tmxSum = std::max(mxSum, sum);\n\t}\n\tprintf(\"%d\\n\", mxSum);\n}"
    }
  ],
  "notes": "This experiment integrates matrix block processing for better cache performance, AVX2 vectorization for SIMD operations, and OpenMP parallelism to improve the performance of the submatrix sum calculation while ensuring correctness."

      "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\n#ifdef _OPENMP\nstruct alignas(64) ChunkSummary {\n    int tail;\n    int resets;\n};\n#endif\n\nstatic int countPaths(const vector<vector<bool> >& blockedCells) {\n    const int n = static_cast<int>(blockedCells.size());\n    vector<int> dp(n, 0);\n    dp[0] = 1;\n\n#ifdef _OPENMP\n    const int minColumnsPerThread = 1024;\n    int threads = min(4, omp_get_max_threads());\n    threads = min(threads, max(1, n / minColumnsPerThread));\n\n    if (threads > 1) {\n        ChunkSummary summaries[4] = {};\n\n        #pragma omp parallel num_threads(threads)\n        {\n            const int tid = omp_get_thread_num();\n            const int teamSize = omp_get_num_threads();\n            const int begin = n * tid / teamSize;\n            const int end = n * (tid + 1) / teamSize;\n\n            for (int row = 0; row < n; ++row) {\n                const vector<bool>& blocked = blockedCells[row];\n                int firstBlocked = end;\n                int left = 0;\n\n                // Scan this chunk with zero incoming horizontal carry.\n                for (int col = begin; col < end; ++col) {\n                    if (blocked[col]) {\n                        left = 0;\n                        if (firstBlocked == end) {\n                            firstBlocked = col;\n                        }\n                    } else {\n                        left += dp[col];\n                        if (left >= MOD) {\n                            left -= MOD;\n                        }\n                    }\n                    dp[col] = left;\n                }\n\n                summaries[tid].tail = left;\n                summaries[tid].resets = (firstBlocked != end);\n\n                #pragma omp barrier\n\n                // A chunk maps an incoming carry x to either x + tail\n                // or tail, depending on whether it contains a blocker.\n                int incoming = 0;\n                for (int chunk = 0; chunk < tid; ++chunk) {\n                    if (summaries[chunk].resets) {\n                        incoming = summaries[chunk].tail;\n                    } else {\n                        incoming += summaries[chunk].tail;\n                        if (incoming >= MOD) {\n                            incoming -= MOD;\n                        }\n                    }\n                }\n\n                // Only the prefix before the first blocker depends on x.\n                if (incoming != 0) {\n                    for (int col = begin; col < firstBlocked; ++col) {\n                        int value = dp[col] + incoming;\n                        if (value >= MOD) {\n                            value -= MOD;\n                        }\n                        dp[col] = value;\n                    }\n                }\n\n                #pragma omp barrier\n            }\n        }\n\n        return dp[n - 1];\n    }\n#endif\n\n    for (int row = 0; row < n; ++row) {\n        const vector<bool>& blocked = blockedCells[row];\n        int left = 0;\n        for (int col = 0; col < n; ++col) {\n            if (blocked[col]) {\n                left = 0;\n            } else {\n                left += dp[col];\n                if (left >= MOD) {\n                    left -= MOD;\n                }\n            }\n            dp[col] = left;\n        }\n    }\n\n    return dp[n - 1];\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) {\n        return 0;\n    }\n\n    vector<vector<bool> > blockedCells(n, vector<bool>(n, false));\n    for (int c = 0; c < m; ++c) {\n        int row, col;\n        cin >> row >> col;\n        blockedCells[row][col] = true;\n    }\n\n    cout << countPaths(blockedCells) << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "A persistent OpenMP team can accelerate wide-grid DP by scanning contiguous chunks independently, composing their carry summaries, and correcting chunk prefixes with only two barriers per row.",

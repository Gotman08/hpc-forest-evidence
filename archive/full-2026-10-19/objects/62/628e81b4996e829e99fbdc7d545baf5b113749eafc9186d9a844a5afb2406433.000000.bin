    {
      "id": "213dc4953f734eab",
      "role": "A",
      "mission": {
        "base_commit": "f138f256830e360056ec7357b1df0f3934445efe",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "A three-way streaming partition, insertion sort for small contiguous ranges, and coarse OpenMP tasks for only large partitions may improve locality and use the four cores without making small cases pay task overhead. Median-of-three pivots avoid shared PRNG access in parallel sorting; generation remains unchanged.",
        "id": "213dc4953f734eab",
        "ordinal": 1,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/quicksort.c"
          ],
          "retained": [
            "Keep case generation and its PRNG sequence unchanged; replace sort-time random pivots with race-free median-of-three selection.",
            "Use a contiguous three-way partition to handle equal keys and split work into disjoint ranges.",
            "Use insertion sort below a small-range cutoff and recurse on the smaller serial partition while iterating over the larger one.",
            "When OpenMP is enabled, create coarse tasks only for large disjoint partitions, with a depth limit and serial fallback."
          ]
        },
        "tree_id": "e1:A",

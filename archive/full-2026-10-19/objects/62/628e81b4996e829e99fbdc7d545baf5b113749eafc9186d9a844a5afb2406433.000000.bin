        "transformations": {
          "files": [
            "src/quicksort.c"
          ],
          "retained": [
            "Keep case generation and the PRNG sequence unchanged; replace sort-time random-pivot Lomuto partitioning with median-of-three three-way introsort, insertion sort for ranges up to 24, and heapsort at the depth limit.",
            "Use the archived OpenMP entry threshold of 65,536 elements and task grain of 16,384 elements; tasks operate on disjoint partitions and smaller work is sorted serially.",
            "Recurse on the smaller serial partition while iterating over the larger, and elide self-swaps.",
            "Replace the early-exit sortedness check with an OR reduction over adjacent inversion comparisons."
          ]
        },

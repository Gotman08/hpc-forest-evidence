    {
      "id": "45664f94e8d640e8",
      "role": "G",
      "mission": {
        "base_commit": "f138f256830e360056ec7357b1df0f3934445efe",
        "delegation_parent": "R/G",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Combining three-way median-of-three partitioning, bounded-depth heapsort fallback, small-range insertion sort, and coarse OpenMP tasks should make sorting robust and faster than the original Lomuto quicksort on large arrays while preserving the generated data and checksum.",
        "id": "45664f94e8d640e8",
        "ordinal": 1,
        "parent_id": null,
        "role": "G",
        "source_commits": [
          "36bf0f96368383910f1632aa16ea9fb0b8762f94",
          "0d0df70a75856be3cf8d1d840488fbe6e3ae1bd9",
          "9379b7b02da271eb809d20b2130f996fa0f40ea7"
        ],
        "sources": [
          "213dc4953f734eab",
          "31711b2db43f40cd",
          "e78f66bf5b4e47c4"
        ],
        "transformations": {
          "files": [
            "src/quicksort.c"
          ],
          "retained": [
            "Replace sort-time shared-PRNG Lomuto partitioning with median-of-three three-way partitioning; preserve the case generator and its PRNG sequence.",
            "Use insertion sort for ranges up to 24 elements, recurse on the smaller side while iterating over the larger, and fall back to heapsort at an introspective depth limit.",
            "When OpenMP is enabled, start the team at 262144 elements, create tasks only for partitions of at least 32768 elements, and sort smaller ranges serially with a bounded-depth fallback.",
            "Use an OR reduction over adjacent-element inversion comparisons in is_sorted, preserving its any-inversion result."
          ]
        },
        "tree_id": "e1:G",
        "trial_id": "01M51EPQSEX9E9WBQSMDE7XB38",
        "worktree": "/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6-luna-max/results-748259/2020-quicksort/worktrees/45664f94e8d640e8"
      },
      "outcome": {
        "binary_sha256": "e0be6c560e4d844acf152b30128a4fd633373d4b6d77c8ff507c20da53994eb4",

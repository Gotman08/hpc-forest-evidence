    {
      "id": "31711b2db43f40cd",
      "role": "C",
      "mission": {
        "base_commit": "f138f256830e360056ec7357b1df0f3934445efe",
        "delegation_parent": "R/C",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "On the four-core ARM64 target, starting an OpenMP team only for large arrays and scheduling disjoint partitions above a task-granularity threshold may speed up sorting while avoiding team and task overhead for smaller inputs.",
        "id": "31711b2db43f40cd",
        "ordinal": 1,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/quicksort.c"
          ],
          "retained": [
            "Replace shared-PRNG two-way partitioning with median-of-three three-way introsort, using insertion sort for small ranges and heapsort when the depth limit is reached.",
            "For arrays of at least 262144 elements with OpenMP enabled, sort disjoint partitions as tasks when they exceed 32768 elements; handle smaller ranges sequentially."
          ]
        },
        "tree_id": "e1:C",

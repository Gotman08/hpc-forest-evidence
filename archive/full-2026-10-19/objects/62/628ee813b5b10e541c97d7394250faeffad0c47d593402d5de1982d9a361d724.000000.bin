      "content": "#include <algorithm>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nusing i32 = std::int32_t;\nusing i64 = std::int64_t;\nusing u32 = std::uint32_t;\nusing u64 = std::uint64_t;\n\nstatic constexpr i32 MOD = 1000000007;\nstatic constexpr i32 HALF = MOD / 2;\nstatic constexpr u64 MOD_BIAS = static_cast<u64>(MOD) << 33;\n\n// For N <= 1020, every value reduced here has magnitude below 8.01e18.\n// This multiple-of-MOD bias makes BIAS+value nonnegative and less than 2^64.\nstatic inline u32 positive_mod(i64 value) {\n    return static_cast<u32>((static_cast<u64>(value) + MOD_BIAS) %\n                            static_cast<u64>(MOD));\n}\n\nstatic inline i32 center_mod(i64 value) {\n    const i32 residue = static_cast<i32>(positive_mod(value));\n    return residue > HALF ? residue - MOD : residue;\n}\n\nstatic inline i32 subtract_mod(i32 a, i32 b) {\n    i32 value = a - b;\n    if (value > HALF) {\n        value -= MOD;\n    } else if (value < -HALF) {\n        value += MOD;\n    }\n    return value;\n}\n\n// Centered operands permit 32 exact products per signed 64-bit reduction.\nstatic inline i32 dot_mod(const i32* a, const i32* b, int count) {\n    i64 total = 0;\n    while (count >= 32) {\n#if defined(__aarch64__) && defined(__ARM_NEON)\n        int64x2_t sum0 = vdupq_n_s64(0);\n        int64x2_t sum1 = vdupq_n_s64(0);\n        int64x2_t sum2 = vdupq_n_s64(0);\n        int64x2_t sum3 = vdupq_n_s64(0);\n        for (int i = 0; i < 32; i += 8) {\n            const int32x4_t x0 = vld1q_s32(a + i);\n            const int32x4_t y0 = vld1q_s32(b + i);\n            const int32x4_t x1 = vld1q_s32(a + i + 4);\n            const int32x4_t y1 = vld1q_s32(b + i + 4);\n            sum0 = vmlal_s32(sum0, vget_low_s32(x0), vget_low_s32(y0));\n            sum1 = vmlal_s32(sum1, vget_high_s32(x0), vget_high_s32(y0));\n            sum2 = vmlal_s32(sum2, vget_low_s32(x1), vget_low_s32(y1));\n            sum3 = vmlal_s32(sum3, vget_high_s32(x1), vget_high_s32(y1));\n        }\n        const i64 block = vaddvq_s64(vaddq_s64(vaddq_s64(sum0, sum1),\n                                               vaddq_s64(sum2, sum3)));\n#else\n        i64 block = 0;\n        for (int i = 0; i < 32; ++i) {\n            block += static_cast<i64>(a[i]) * b[i];\n        }\n#endif\n        total += positive_mod(block);\n        a += 32;\n        b += 32;\n        count -= 32;\n    }\n\n    // At most 31 products and 32 block residues remain, still within i64.\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    if (count >= 4) {\n        int64x2_t low = vdupq_n_s64(0);\n        int64x2_t high = vdupq_n_s64(0);\n        do {\n            const int32x4_t x = vld1q_s32(a);\n            const int32x4_t y = vld1q_s32(b);\n            low = vmlal_s32(low, vget_low_s32(x), vget_low_s32(y));\n            high = vmlal_s32(high, vget_high_s32(x), vget_high_s32(y));\n            a += 4;\n            b += 4;\n            count -= 4;\n        } while (count >= 4);\n        total += vaddvq_s64(vaddq_s64(low, high));\n    }\n#endif\n    for (int i = 0; i < count; ++i) {\n        total += static_cast<i64>(a[i]) * b[i];\n    }\n    return center_mod(total);\n}\n\n// Coefficient k of a*b, with b supplied in reverse coefficient order.\nstatic inline i32 product_coefficient(const std::vector<i32>& a,\n                                      const std::vector<i32>& b_reversed,\n                                      int k) {\n    if (k < 0 || a.empty() || b_reversed.empty()) {\n        return 0;\n    }\n    const int b_size = static_cast<int>(b_reversed.size());\n    const int first = std::max(0, k - b_size + 1);\n    const int last = std::min(k, static_cast<int>(a.size()) - 1);\n    if (first > last) {\n        return 0;\n    }\n    return dot_mod(a.data() + first,\n                   b_reversed.data() + b_size - 1 - k + first,\n                   last - first + 1);\n}\n\n// Symmetry leaves only pairs i<j and, when present, one diagonal product.\nstatic inline i32 square_coefficient(const std::vector<i32>& a,\n                                     const std::vector<i32>& a_reversed,\n                                     int k) {\n    if (k < 0 || a.empty()) {\n        return 0;\n    }\n    const int size = static_cast<int>(a.size());\n    const int first = std::max(0, k - size + 1);\n    const int last = std::min(k, size - 1);\n    if (first > last) {\n        return 0;\n    }\n    const int pair_last = std::min(last, (k + 1) / 2 - 1);\n    i64 value = 0;\n    if (first <= pair_last) {\n        value = 2LL * dot_mod(a.data() + first,\n                             a_reversed.data() + size - 1 - k + first,\n                             pair_last - first + 1);\n    }\n    if ((k & 1) == 0) {\n        const i64 middle = a[k / 2];\n        value += middle * middle;\n    }\n    return center_mod(value);\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n;\n    u64 h;\n    if (!(std::cin >> n >> h)) {\n        return 0;\n    }\n\n    std::vector<i32> numerator(n);\n    std::vector<i32> denominator(n + 1);\n    denominator[0] = 1;\n    for (int i = 0; i < n; ++i) {\n        u64 value;\n        std::cin >> value;\n        const i32 residue = static_cast<i32>(value % static_cast<u64>(MOD));\n        numerator[i] = residue > HALF ? residue - MOD : residue;\n    }\n    for (int i = 0; i < n; ++i) {\n        u64 value;\n        std::cin >> value;\n        const i32 coefficient = static_cast<i32>(value % static_cast<u64>(MOD));\n        denominator[i + 1] = coefficient > HALF ? MOD - coefficient\n                                                : -coefficient;\n    }\n\n    if (h <= static_cast<u64>(n)) {\n        const i32 answer = numerator[static_cast<std::size_t>(h - 1)];\n        std::cout << (answer < 0 ? answer + MOD : answer) << '\\n';\n        return 0;\n    }\n\n    // The generating function is S(z)/Q(z), where S=(A*Q) mod z^n.\n    std::vector<i32> next_numerator(n);\n    {\n        const std::vector<i32> reversed_denominator(denominator.rbegin(),\n                                                    denominator.rend());\n        for (int i = 0; i < n; ++i) {\n            next_numerator[i] = product_coefficient(numerator,\n                                                     reversed_denominator, i);\n        }\n    }\n    numerator.swap(next_numerator);\n\n    const int numerator_even_size = (n + 1) / 2;\n    const int numerator_odd_size = n / 2;\n    const int denominator_even_size = n / 2 + 1;\n    const int denominator_odd_size = (n + 1) / 2;\n    std::vector<i32> numerator_even(numerator_even_size);\n    std::vector<i32> numerator_odd(numerator_odd_size);\n    std::vector<i32> denominator_even(denominator_even_size);\n    std::vector<i32> denominator_odd(denominator_odd_size);\n    std::vector<i32> even_reversed(denominator_even_size);\n    std::vector<i32> odd_reversed(denominator_odd_size);\n    std::vector<i32> next_denominator(n + 1);\n\n    u64 index = h - 1;\n    while (index != 0) {\n        for (int i = 0; i < numerator_even_size; ++i) {\n            numerator_even[i] = numerator[2 * i];\n        }\n        for (int i = 0; i < numerator_odd_size; ++i) {\n            numerator_odd[i] = numerator[2 * i + 1];\n        }\n        for (int i = 0; i < denominator_even_size; ++i) {\n            const i32 value = denominator[2 * i];\n            denominator_even[i] = value;\n            even_reversed[denominator_even_size - 1 - i] = value;\n        }\n        for (int i = 0; i < denominator_odd_size; ++i) {\n            const i32 value = denominator[2 * i + 1];\n            denominator_odd[i] = value;\n            odd_reversed[denominator_odd_size - 1 - i] = value;\n        }\n\n        // Write Q(z)=E(z^2)+z*O(z^2), S(z)=C(z^2)+z*D(z^2).\n        // Retain only the required parity of S(z)*Q(-z).\n        if (index & 1ULL) {\n            for (int i = 0; i < n; ++i) {\n                next_numerator[i] = subtract_mod(\n                    product_coefficient(numerator_odd, even_reversed, i),\n                    product_coefficient(numerator_even, odd_reversed, i));\n            }\n        } else {\n            for (int i = 0; i < n; ++i) {\n                next_numerator[i] = subtract_mod(\n                    product_coefficient(numerator_even, even_reversed, i),\n                    product_coefficient(numerator_odd, odd_reversed, i - 1));\n            }\n        }\n\n        // The next denominator is E(z)^2-z*O(z)^2.\n        next_denominator[0] = 1;\n        for (int i = 1; i <= n; ++i) {\n            next_denominator[i] = subtract_mod(\n                square_coefficient(denominator_even, even_reversed, i),\n                square_coefficient(denominator_odd, odd_reversed, i - 1));\n        }\n\n        numerator.swap(next_numerator);\n        denominator.swap(next_denominator);\n        index >>= 1;\n    }\n\n    // Q(0) remains one throughout Bostan-Mori reduction.\n    const i32 answer = numerator[0];\n    std::cout << (answer < 0 ? answer + MOD : answer) << '\\n';\n    return 0;\n}\n",
      "path": "src/npbonacci.cpp"
    }
  ],
  "hypothesis": "Centered residues permit exact 32-product NEON batches, halving block-reduction frequency; four independent accumulation chains should also reduce dependency stalls.",

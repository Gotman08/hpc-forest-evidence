"""Bind the already closed GPT96 receipt to this preserved editorial edition.

This is documentary admission only: no experimental code is imported or run.
"""
import hashlib
import json
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
STUDY = HERE.parent
ROOT = STUDY.parent / "Marathon22-GPT61Sol-MAX/reference96-r2"
RECEIPT = ROOT / "reception-finale-748383"


def read(p):
    return json.loads(p.read_text(encoding="utf-8-sig"))


def sha(p):
    with p.open("rb") as f:
        return hashlib.file_digest(f, "sha256").hexdigest()


def save(p, value):
    p.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def main():
    assert (STUDY / "versions/20261017-avant-reference96-professionnelle/PRESERVATION.json").is_file()
    rp = RECEIPT / "reception-verifiee.json"
    assert sha(rp) == "dc7eeb0b1ce79a5cfd9d6f9b93bb7c750f1b74155d9bd22ac62c2f8810e8e3a7"
    received = read(rp)
    assert received["received_and_audited"] and received["all_final_confirmations_verified"]
    assert received["all_179_requests_delivered_and_reconciled"]
    for key in ("native_audit", "supplemental_audit", "worker_stopped_after_audit_and_reconciliation", "lane_release"):
        link = received[key]
        assert sha(Path(link["path"])) == link["sha256"], key
    native = read(RECEIPT / "audit-natif-initial.json")
    supp = read(RECEIPT / "audit-complementaire-r2.json")
    assert supp["all_restored_bytes_unchanged"] and supp["harness_disabled_verified"]
    assert supp["all_planned_finalists_accounted_for"] and supp["candidate_execution_or_compilation"] is False
    delivery = read(RECEIPT / "livraisons-reconciliees.json")
    assert delivery["all_published_requests_delivered"] and delivery["requests"] == 179
    assert delivery["native_invocations_observed"] == 177
    assert delivery["known_exact_tokens"] == 5126918 and delivery["unmeasured_native_invocations"] == 17
    assert delivery["expired_without_native_invocation"] == 2
    rows = []
    for p in native["problems"]:
        rows.append({**p, "model": "gpt-6.1-sol", "effort": "max", "arm": "reference96",
                     "subject": "2022-" + p["problem"], "job_id": "748383",
                     "campaign_root": str(RECEIPT / "restauration-02/results-748383" / p["problem"]),
                     "confirmation": p["best_confirmed"],
                     "native_calls": p["archived_native_invocations"],
                     "known_exact_tokens": p["archived_exact_native_tokens"],
                     "unmetered_calls": p["archived_unmetered_native_invocations"]})
    assert len(rows) == 3 and sum(r["trials"] for r in rows) == 183
    cohort = {"schema": "hpc-forest-gpt96-reviewed-cohort-v1", "job_id": "748383", "rows": rows,
              "native_calls": 177, "known_exact_tokens": 5126918, "unmetered_calls": 17,
              "expired_without_native_invocation": 2, "search_plans_complete": False,
              "all_final_confirmations_verified": True, "scheduler_state": "FAILED", "scheduler_exit_code": "1:0",
              "receipt": {"path": str(rp), "sha256": sha(rp)},
              "total_exact_consumption_available": False, "new_source_only_comparison_cells": 0}
    save(STUDY / "resultats-reference96.json", cohort)
    admissions = read(HERE / "admissions.json")
    assert not any(c["cohort"] == "gpt96_three_subjects" for c in admissions["reviewed_new_cohorts"])
    admissions["received_file_paths"]["gpt96"] = [str(RECEIPT / "audit-complet.json")]
    admissions["reviewed_new_cohorts"].append({
        "cohort": "gpt96_three_subjects", "job_id": "748383",
        "independent_reception_sha256": sha(rp),
        "audit_sha256": sha(RECEIPT / "audit-complet.json"),
        "supplemental_audit_sha256": sha(RECEIPT / "audit-complementaire-r2.json"),
        "reconciliation_sha256": sha(RECEIPT / "livraisons-reconciliees.json"),
        "archive_sha256": received["archive_sha256"],
        "source_zip_sha256": "2f71b0b6fa50c45b29d9fa9484aaf7507c321ea58f9cac54227185c2e23c1809",
        "lane_release_sha256": received["lane_release"]["sha256"],
        "native_calls_observed": 177, "known_exact_tokens": 5126918, "unmetered_calls": 17,
        "expired_without_native_invocation": 2, "historical_global_ledger_replaced_not_added": True,
        "search_plans_complete": False, "new_cpu_cohort_admitted": False,
        "new_source_only_cells": 0, "review": "Five confirmations, original finite contracts, negative states, identities, source/parent links and incomplete budget-limited planning reviewed; no causal model or harness rank."})
    admissions.update(expected_registry_count=93, expected_principal_results=77,
                      observed_utc=datetime.now(UTC).isoformat())
    save(HERE / "admissions.json", admissions)
    save(HERE / "admission-reference96-verifiee.json", {
        "schema": "hpc-forest-gpt96-editorial-admission-v1", "verified": True,
        "observed_utc": datetime.now(UTC).isoformat(), "receipt": {"path": str(rp), "sha256": sha(rp)},
        "admissions_sha256": sha(HERE / "admissions.json"), "normalized_cohort_sha256": sha(STUDY / "resultats-reference96.json"),
        "article_rendering_and_visual_review_pending": True, "model_calls": 0, "candidate_executions": 0})
    print(json.dumps({"admitted_subjects": len(rows), "registries_expected": 93, "results_expected": 77}))


if __name__ == "__main__":
    main()

#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <algorithm>
#include <cstdint>

int main() {
    int n, s;
    std::cin >> n >> s;
    std::vector<std::vector<int> > matrix(n, std::vector<int>(n));
    for (int i = 0; i < n; ++i)
        for (int j = 0; j < n; ++j)
            scanf("%d", &matrix[i][j]);

    assert(s < n);
    assert(n < 8000);
    assert(s > 0);
    assert(n > 0);

    typedef std::int64_t Sum;
    std::vector<Sum> columns(n, 0);
    Sum* column = columns.data();

    for (int row = 0; row < s; ++row) {
        const int* values = matrix[row].data();
        #pragma omp simd
        for (int col = 0; col < n; ++col)
            column[col] += static_cast<Sum>(values[col]);
    }

    Sum first = 0;
    #pragma omp simd reduction(+:first)
    for (int col = 0; col < s; ++col)
        first += column[col];

    Sum best = first;
    const int last = n - s;
    for (int top = 0; top <= last; ++top) {
        Sum sum = first;
        best = std::max(best, sum);
        for (int col = s; col < n; ++col) {
            sum += column[col] - column[col - s];
            best = std::max(best, sum);
        }

        if (top == last)
            break;

        const int* outgoing = matrix[top].data();
        const int* incoming = matrix[top + s].data();
        Sum first_delta = 0;
        #pragma omp simd reduction(+:first_delta)
        for (int col = 0; col < s; ++col) {
            const Sum delta = static_cast<Sum>(incoming[col])
                            - static_cast<Sum>(outgoing[col]);
            column[col] += delta;
            first_delta += delta;
        }
        first += first_delta;

        #pragma omp simd
        for (int col = s; col < n; ++col) {
            column[col] += static_cast<Sum>(incoming[col])
                         - static_cast<Sum>(outgoing[col]);
        }
    }

    printf("%d\n", static_cast<int>(best));
    return 0;
}

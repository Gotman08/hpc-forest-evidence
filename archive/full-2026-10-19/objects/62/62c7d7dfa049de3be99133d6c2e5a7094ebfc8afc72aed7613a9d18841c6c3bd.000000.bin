        "content": "#include \"knn.h\"\n#include <float.h>\n#include <stdint.h>\n#include <string.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\ntypedef struct {\n    size_t bins[256];\n    size_t ties;\n    size_t take;\n    int exceptional;\n    unsigned char padding[64];\n} KnnWorkspace;\n\nstatic char knn_mode(const size_t counts[256]) {\n    char best = (char)-1;\n    size_t best_count = 0;\n\n    for (unsigned int b = 0; b < 256; ++b) {\n        char label = (char)(unsigned char)b;\n        if (counts[b] > best_count ||\n            (counts[b] == best_count && label < best)) {\n            best = label;\n            best_count = counts[b];\n        }\n    }\n    return best;\n}\n\n/* Preserve the reference insertion semantics for unordered distances. */\nstatic char knn_serial(int n_groups, Group *groups, int k, Point to_evaluate) {\n    char *labels = (char *)malloc(sizeof(*labels) * (size_t)k);\n    float *distances = (float *)malloc(sizeof(*distances) * (size_t)k);\n\n    if (labels == NULL || distances == NULL) {\n        free(labels);\n        free(distances);\n        on_error();\n    }\n\n    for (int i = 0; i < k; ++i) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; ++j) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (int x = 0; x < k; ++x) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (int y = k - 1; y > x; --y) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    size_t counts[256] = {0};\n    for (int i = 0; i < k; ++i) {\n        ++counts[(unsigned char)labels[i]];\n    }\n    char result = knn_mode(counts);\n    free(labels);\n    free(distances);\n    return result;\n}\n\nstatic int knn_group_at(const size_t *offsets, int n_groups, size_t position) {\n    int low = 0;\n    int high = n_groups;\n    while (low < high) {\n        int middle = low + (high - low) / 2;\n        if (offsets[middle + 1] <= position) {\n            low = middle + 1;\n        } else {\n            high = middle;\n        }\n    }\n    return low;\n}\n\nstatic unsigned int knn_radix_bin(const KnnWorkspace *work, int team,\n                                  size_t *rank) {\n    for (unsigned int b = 0; b < 256; ++b) {\n        size_t count = 0;\n        for (int t = 0; t < team; ++t) {\n            count += work[t].bins[b];\n        }\n        if (*rank > count) {\n            *rank -= count;\n        } else {\n            return b;\n        }\n    }\n    return 255;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) {\n        return (char)-1;\n    }\n\n    size_t total = 0;\n    for (int g = 0; g < n_groups; ++g) {\n        size_t length = (size_t)groups[g].length;\n        if (length > SIZE_MAX - total) {\n            return knn_serial(n_groups, groups, k, to_evaluate);\n        }\n        total += length;\n    }\n\n    if ((size_t)k >= total) {\n        size_t counts[256] = {0};\n        for (int g = 0; g < n_groups; ++g) {\n            counts[(unsigned char)groups[g].label] += (size_t)groups[g].length;\n        }\n        counts[(unsigned char)(char)-1] += (size_t)k - total;\n        return knn_mode(counts);\n    }\n\n    if (sizeof(float) != sizeof(uint32_t) || FLT_RADIX != 2 ||\n        FLT_MANT_DIG != 24 || FLT_MAX_EXP != 128 ||\n        total > SIZE_MAX / sizeof(uint32_t)) {\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    int max_threads = 1;\n#ifdef _OPENMP\n    max_threads = omp_get_max_threads();\n#endif\n\n    size_t *offsets = (size_t *)malloc(((size_t)n_groups + 1) * sizeof(*offsets));\n    uint32_t *keys = (uint32_t *)malloc(total * sizeof(*keys));\n    KnnWorkspace *work = (KnnWorkspace *)calloc((size_t)max_threads, sizeof(*work));\n    if (offsets == NULL || keys == NULL || work == NULL) {\n        free(offsets);\n        free(keys);\n        free(work);\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n\n    offsets[0] = 0;\n    for (int g = 0; g < n_groups; ++g) {\n        offsets[g + 1] = offsets[g] + (size_t)groups[g].length;\n    }\n\n    size_t rank = (size_t)k;\n    uint32_t prefix = 0;\n    uint32_t mask = 0;\n    int exceptional = 0;\n    char result = (char)-1;\n\n#ifdef _OPENMP\n#pragma omp parallel if (total >= 32768)\n#endif\n    {\n        int tid = 0;\n        int team = 1;\n#ifdef _OPENMP\n        tid = omp_get_thread_num();\n        team = omp_get_num_threads();\n#endif\n        KnnWorkspace *local = &work[tid];\n        size_t per_thread = total / (size_t)team;\n        size_t extra = total % (size_t)team;\n        size_t before = (size_t)tid < extra ? (size_t)tid : extra;\n        size_t begin = per_thread * (size_t)tid + before;\n        size_t end = begin + per_thread + ((size_t)tid < extra ? 1 : 0);\n        size_t position = begin;\n        int group = knn_group_at(offsets, n_groups, begin);\n\n        while (position < end) {\n            size_t stop = offsets[group + 1];\n            if (stop > end) stop = end;\n            size_t point = position - offsets[group];\n            for (; position < stop; ++position, ++point) {\n                float d = euclidean_distance_no_sqrt(to_evaluate,\n                                                     groups[group].points[point]);\n                uint32_t key;\n                memcpy(&key, &d, sizeof(key));\n                uint32_t magnitude = key & UINT32_C(0x7fffffff);\n                if (magnitude > UINT32_C(0x7f800000)) {\n                    local->exceptional = 1;\n                }\n                /* Both signed zero representations compare equal. */\n                if (magnitude == 0) key = 0;\n                keys[position] = key;\n                ++local->bins[key >> 24];\n            }\n            ++group;\n        }\n\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n        {\n            for (int t = 0; t < team; ++t) {\n                exceptional |= work[t].exceptional;\n            }\n            if (!exceptional) {\n                prefix = (uint32_t)knn_radix_bin(work, team, &rank) << 24;\n                mask = UINT32_C(0xff000000);\n            }\n        }\n\n        if (!exceptional) {\n            for (int shift = 16; shift >= 0; shift -= 8) {\n                memset(local->bins, 0, sizeof(local->bins));\n                uint32_t pass_mask = mask;\n                uint32_t pass_prefix = prefix;\n                for (size_t p = begin; p < end; ++p) {\n                    uint32_t key = keys[p];\n                    if ((key & pass_mask) == pass_prefix) {\n                        ++local->bins[(key >> shift) & UINT32_C(255)];\n                    }\n                }\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n                {\n                    unsigned int b = knn_radix_bin(work, team, &rank);\n                    prefix |= (uint32_t)b << shift;\n                    mask |= UINT32_C(255) << shift;\n                }\n            }\n\n            memset(local->bins, 0, sizeof(local->bins));\n            local->ties = 0;\n            position = begin;\n            group = knn_group_at(offsets, n_groups, begin);\n            while (position < end) {\n                size_t stop = offsets[group + 1];\n                if (stop > end) stop = end;\n                unsigned char label = (unsigned char)groups[group].label;\n                for (; position < stop; ++position) {\n                    if (keys[position] < prefix) {\n                        ++local->bins[label];\n                    } else if (keys[position] == prefix) {\n                        ++local->ties;\n                    }\n                }\n                ++group;\n            }\n\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n            {\n                /* Ordered contiguous ranges preserve the reference's ties. */\n                size_t remaining = rank;\n                for (int t = 0; t < team; ++t) {\n                    work[t].take = work[t].ties < remaining\n                                     ? work[t].ties : remaining;\n                    remaining -= work[t].take;\n                }\n            }\n\n            size_t take = local->take;\n            position = begin;\n            group = knn_group_at(offsets, n_groups, begin);\n            while (position < end && take != 0) {\n                size_t stop = offsets[group + 1];\n                if (stop > end) stop = end;\n                unsigned char label = (unsigned char)groups[group].label;\n                for (; position < stop && take != 0; ++position) {\n                    if (keys[position] == prefix) {\n                        ++local->bins[label];\n                        --take;\n                    }\n                }\n                ++group;\n            }\n\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n            {\n                size_t counts[256] = {0};\n                for (unsigned int b = 0; b < 256; ++b) {\n                    for (int t = 0; t < team; ++t) {\n                        counts[b] += work[t].bins[b];\n                    }\n                }\n                result = knn_mode(counts);\n            }\n        }\n    }\n\n    free(offsets);\n    free(keys);\n    free(work);\n    if (exceptional) {\n        return knn_serial(n_groups, groups, k, to_evaluate);\n    }\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",

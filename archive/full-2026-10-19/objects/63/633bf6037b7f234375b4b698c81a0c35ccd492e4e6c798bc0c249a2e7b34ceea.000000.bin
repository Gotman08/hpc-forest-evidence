      "content": "#include <algorithm>\n#include <iostream>\n#include <omp.h>\n#include <utility>\n#include <vector>\n\nusing namespace std;\n\nstatic constexpr int MOD = 1000000007;\n\nstatic int modPow(int base, int exponent) {\n    long long result = 1;\n    long long value = base;\n    while (exponent != 0) {\n        if (exponent & 1) result = result * value % MOD;\n        value = value * value % MOD;\n        exponent >>= 1;\n    }\n    return static_cast<int>(result);\n}\n\nstatic int unobstructedPaths(int n) {\n    vector<int> fact(2 * n), inverseFact(2 * n);\n    fact[0] = 1;\n    for (int i = 1; i < 2 * n; ++i)\n        fact[i] = static_cast<long long>(fact[i - 1]) * i % MOD;\n    inverseFact.back() = modPow(fact.back(), MOD - 2);\n    for (int i = 2 * n - 1; i > 0; --i)\n        inverseFact[i - 1] = static_cast<long long>(inverseFact[i]) * i % MOD;\n    return static_cast<long long>(fact[2 * n - 2]) * inverseFact[n - 1] % MOD * inverseFact[n - 1] % MOD;\n}\n\nstatic int sparsePaths(int n, vector<pair<int, int>> points) {\n    sort(points.begin(), points.end());\n    points.erase(unique(points.begin(), points.end()), points.end());\n\n    const pair<int, int> start{0, 0};\n    const pair<int, int> finish{n - 1, n - 1};\n    if (binary_search(points.begin(), points.end(), start) ||\n        binary_search(points.begin(), points.end(), finish))\n        return 0;\n    if (points.empty()) return unobstructedPaths(n);\n\n    vector<int> fact(2 * n), inverseFact(2 * n);\n    fact[0] = 1;\n    for (int i = 1; i < 2 * n; ++i)\n        fact[i] = static_cast<long long>(fact[i - 1]) * i % MOD;\n    inverseFact.back() = modPow(fact.back(), MOD - 2);\n    for (int i = 2 * n - 1; i > 0; --i)\n        inverseFact[i - 1] = static_cast<long long>(inverseFact[i]) * i % MOD;\n\n    const auto paths = [&](int dy, int dx) -> int {\n        if (dy < 0 || dx < 0) return 0;\n        return static_cast<long long>(fact[dy + dx]) * inverseFact[dy] % MOD * inverseFact[dx] % MOD;\n    };\n\n    points.push_back(finish);\n    vector<int> ways(points.size());\n    for (size_t i = 0; i < points.size(); ++i) {\n        long long value = paths(points[i].first, points[i].second);\n        for (size_t j = 0; j < i; ++j) {\n            if (points[j].second <= points[i].second) {\n                value -= static_cast<long long>(ways[j]) *\n                         paths(points[i].first - points[j].first,\n                               points[i].second - points[j].second) % MOD;\n                if (value < 0) value += MOD;\n            }\n        }\n        ways[i] = static_cast<int>(value);\n    }\n    return ways.back();\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    cin >> n >> m;\n\n    constexpr int denseLimit = 16000;\n    if (n > denseLimit) {\n        vector<pair<int, int>> points;\n        points.reserve(m);\n        for (int i = 0; i < m; ++i) {\n            int y, x;\n            cin >> y >> x;\n            points.emplace_back(y, x);\n        }\n        cout << sparsePaths(n, move(points)) << '\\n';\n        return 0;\n    }\n\n    const size_t width = static_cast<size_t>(n);\n    vector<bool> blocked(width * width, false);\n    for (int i = 0; i < m; ++i) {\n        int y, x;\n        cin >> y >> x;\n        blocked[static_cast<size_t>(y) * width + x] = true;\n    }\n\n    if (m == 0) {\n        cout << unobstructedPaths(n) << '\\n';\n        return 0;\n    }\n    if (blocked[0] || blocked[width * width - 1]) {\n        cout << 0 << '\\n';\n        return 0;\n    }\n\n    vector<int> previous(n), current(n);\n    previous[0] = 1;\n    for (int x = 1; x < n; ++x)\n        previous[x] = blocked[x] ? 0 : previous[x - 1];\n\n    int threads = min(n, omp_get_max_threads());\n    if (n < 512 * threads) threads = 1;\n\n    if (threads == 1) {\n        for (int y = 1; y < n; ++y) {\n            int left = 0;\n            const size_t row = static_cast<size_t>(y) * width;\n            for (int x = 0; x < n; ++x) {\n                if (blocked[row + x]) {\n                    current[x] = 0;\n                    left = 0;\n                } else {\n                    int value = previous[x] + left;\n                    if (value >= MOD) value -= MOD;\n                    current[x] = value;\n                    left = value;\n                }\n            }\n            previous.swap(current);\n        }\n    } else {\n        vector<int> tails(threads), entries(threads), firstStops(threads);\n        int *previousRow = previous.data();\n        int *currentRow = current.data();\n\n#pragma omp parallel num_threads(threads) shared(previousRow, currentRow, tails, entries, firstStops, blocked)\n        {\n            const int tid = omp_get_thread_num();\n            const int first = n * tid / threads;\n            const int last = n * (tid + 1) / threads;\n            for (int y = 1; y < n; ++y) {\n                const size_t row = static_cast<size_t>(y) * width;\n                int partial = 0;\n                int firstStop = last;\n                for (int x = first; x < last; ++x) {\n                    if (blocked[row + x]) {\n                        currentRow[x] = 0;\n                        partial = 0;\n                        if (firstStop == last) firstStop = x;\n                    } else {\n                        partial += previousRow[x];\n                        if (partial >= MOD) partial -= MOD;\n                        currentRow[x] = partial;\n                    }\n                }\n                tails[tid] = partial;\n                firstStops[tid] = firstStop;\n\n#pragma omp barrier\n#pragma omp single\n                {\n                    int carry = 0;\n                    for (int t = 0; t < threads; ++t) {\n                        entries[t] = carry;\n                        if (firstStops[t] != n * (t + 1) / threads) {\n                            carry = tails[t];\n                        } else {\n                            carry += tails[t];\n                            if (carry >= MOD) carry -= MOD;\n                        }\n                    }\n                }\n\n                const int carry = entries[tid];\n                if (carry != 0) {\n                    for (int x = first; x < firstStops[tid]; ++x) {\n                        int value = currentRow[x] + carry;\n                        if (value >= MOD) value -= MOD;\n                        currentRow[x] = value;\n                    }\n                }\n\n#pragma omp barrier\n#pragma omp single\n                { swap(previousRow, currentRow); }\n            }\n        }\n    }\n\n    cout << previous[n - 1] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Recording each chunk's first blocked cell during its local prefix pass removes the second-pass blocked-cell tests while preserving the carry-reset semantics of the persistent OpenMP row team.",
  "notes": "The incoming carry affects exactly the prefix before a chunk's first blocked cell; any later values are independent of that carry.",

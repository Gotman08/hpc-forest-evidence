#include "knn.h"

#define BLOCK 256

static void insert_distance(char *labels, float *distances, int k, float d, char label) {
    for (int x = 0; x < k; x++) {
        if (d < distances[x] || distances[x] == -1) {
            for (int y = k - 1; y > x; y--) {
                distances[y] = distances[y - 1];
                labels[y] = labels[y - 1];
            }

            distances[x] = d;
            labels[x] = label;

            break;
        }
    }
}

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    char * labels = (char *) malloc(sizeof(char) * k);
    float * distances = (float *) malloc(sizeof(float) * k);

    for (int i = 0; i < k; i++) {
        labels[i] = -1;
        distances[i] = -1;
    }

    float block_d[BLOCK];

    for (int i = 0; i < n_groups; i++) {
        Group g = groups[i];
        int len = g.length;

        for (int base = 0; base < len; base += BLOCK) {
            int count = len - base;
            if (count > BLOCK) count = BLOCK;

            float px = to_evaluate.x, py = to_evaluate.y;

            // Compute distances into a contiguous local buffer.
            for (int j = 0; j < count; j++) {
                Point q = g.points[base + j];
                float dx = q.x - px;
                float dy = q.y - py;
                block_d[j] = dx * dx + dy * dy;
            }

            // Update the k-smallest arrays in the original point order.
            for (int j = 0; j < count; j++) {
                insert_distance(labels, distances, k, block_d[j], g.label);
            }
        }
    }

    qsort(labels, k, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (int i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }

            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

        "epoch": 1,
        "hypothesis": "Dynamic OpenMP work sharing over independent column-start groups should use four cores more evenly than serial execution, while thread-local histograms and a reduction avoid contention. A work estimate keeps small cases serial to avoid parallel-region overhead.",
        "id": "e5ffd3542eba44af",
        "ordinal": 1,
        "parent_id": null,
        "role": "C",
        "source_commits": [],
        "sources": [],

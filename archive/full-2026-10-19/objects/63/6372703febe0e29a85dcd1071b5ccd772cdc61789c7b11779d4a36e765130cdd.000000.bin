        "sources": [],
        "transformations": {
          "files": [
            "src/main.cpp"
          ],
          "retained": [
            "Orient matrix storage as [shorter dimension][longer dimension], transposing during input when columns are the shorter dimension.",
            "Enumerate boundary pairs along the shorter dimension, incrementally accumulate the longer-dimension slice, and count matching one-dimensional subarrays with a prefix-frequency map using 64-bit sums and answer."
          ]
        },

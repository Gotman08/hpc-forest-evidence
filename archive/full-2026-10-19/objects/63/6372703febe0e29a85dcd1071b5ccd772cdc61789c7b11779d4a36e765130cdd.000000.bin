          "files": [
            "src/main.cpp"
          ],
          "retained": [
            "Parallelize the independent column-start loop with OpenMP dynamic scheduling in chunks of one.",
            "Accumulate per-group counts locally and combine them using an OpenMP reduction; keep each thread's histogram private.",
            "Use a serial path when estimated pair-row work is below 65536."
          ]
        },

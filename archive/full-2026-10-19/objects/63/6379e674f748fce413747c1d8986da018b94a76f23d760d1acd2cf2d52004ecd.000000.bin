        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <math.h>\n#include <string.h>\n\nstatic void bubble_sort(double *values, int length) {\n    int i, j;\n    double temporary;\n\n    for (i = length - 1; i > 0; i--) {\n        for (j = 0; j < i; j++) {\n            if (values[j] > values[j + 1]) {\n                temporary = values[j];\n                values[j] = values[j + 1];\n                values[j + 1] = temporary;\n            }\n        }\n    }\n}\n\nstatic void merge_sort(double *values, double *scratch, size_t length) {\n    size_t width;\n    double *source = values;\n    double *destination = scratch;\n\n    for (width = 1; width < length;) {\n        size_t left = 0;\n\n        while (left < length) {\n            size_t remaining = length - left;\n            size_t middle = left + (remaining < width ? remaining : width);\n            size_t right;\n            size_t i, j, output;\n\n            remaining = length - middle;\n            right = middle + (remaining < width ? remaining : width);\n            i = left;\n            j = middle;\n            output = left;\n\n            while (i < middle && j < right) {\n                if (source[i] <= source[j])\n                    destination[output++] = source[i++];\n                else\n                    destination[output++] = source[j++];\n            }\n            while (i < middle)\n                destination[output++] = source[i++];\n            while (j < right)\n                destination[output++] = source[j++];\n\n            left = right;\n        }\n\n        {\n            double *temporary = source;\n            source = destination;\n            destination = temporary;\n        }\n\n        if (width > length / 2)\n            break;\n        width *= 2;\n    }\n\n    if (source != values)\n        memcpy(values, source, length * sizeof(*values));\n}\n\nstatic void ordena_colunas(double *matriz, int lin, int col,\n                           double *scratch) {\n    size_t rows = (size_t)lin;\n    size_t columns = (size_t)col;\n    size_t i, j;\n\n    for (i = 0; i < columns; i++) {\n        double *column = matriz + i * rows;\n        int has_nan = 0;\n\n        for (j = 0; j < rows; j++) {\n            if (isnan(column[j])) {\n                has_nan = 1;\n                break;\n            }\n        }\n\n        if (has_nan || scratch == NULL)\n            bubble_sort(column, lin);\n        else\n            merge_sort(column, scratch, rows);\n    }\n}\n\nstatic void calcula_medias(double *matriz, double *media, double *media_har,\n                           int lin, int col) {\n    size_t rows = (size_t)lin;\n    size_t columns = (size_t)col;\n    size_t i, j;\n\n    for (i = 0; i < columns; i++) {\n        size_t base = i * rows;\n        double soma = 0.0;\n        double soma_harmonica = 0.0;\n\n        for (j = 0; j < rows; j++) {\n            double value = matriz[base + j];\n            soma += value;\n            soma_harmonica += 1 / value;\n        }\n        media[i] = soma / lin;\n        media_har[i] = lin / soma_harmonica;\n    }\n}\n\nstatic double moda_coluna_com_nan(const double *column, size_t length) {\n    size_t i, j;\n    float best_count = 0.0f;\n    float mode = 0.0f;\n\n    for (i = 0; i < length; i++) {\n        double count = 0.0;\n        for (j = i + 1; j < length; j++) {\n            if (column[i] == column[j]) {\n                count++;\n                if (count > best_count) {\n                    best_count = (float)count;\n                    mode = (float)column[i];\n                }\n            }\n        }\n    }\n\n    return best_count == 0.0f ? -1.0 : (double)mode;\n}\n\nstatic void calcula_metricas_ordenadas(double *matriz, double *media,\n                                       double *mediana, double *moda,\n                                       double *variancia, double *dp,\n                                       double *cv, int lin, int col) {\n    size_t rows = (size_t)lin;\n    size_t columns = (size_t)col;\n    size_t i, j;\n\n    for (i = 0; i < columns; i++) {\n        size_t base = i * rows;\n        double *column = matriz + base;\n        double sum_squares = 0.0;\n        double run_value = column[0];\n        size_t run_length = 1;\n        float best_count = 0.0f;\n        float mode = 0.0f;\n        int has_nan = 0;\n\n        if (rows % 2 == 0) {\n            mediana[i] = (column[rows / 2 - 1] + column[rows / 2]) * 0.5;\n        } else {\n            mediana[i] = column[rows / 2];\n        }\n\n        for (j = 0; j < rows; j++) {\n            double value = column[j];\n            sum_squares += pow((value - media[i]), 2);\n            if (isnan(value))\n                has_nan = 1;\n\n            if (j == 0) {\n                run_value = value;\n                run_length = 1;\n            } else if (value == run_value) {\n                run_length++;\n            } else {\n                size_t candidate_count = run_length - 1;\n                if ((double)candidate_count > (double)best_count) {\n                    best_count = (float)candidate_count;\n                    mode = (float)run_value;\n                }\n                run_value = value;\n                run_length = 1;\n            }\n        }\n\n        if (has_nan) {\n            moda[i] = moda_coluna_com_nan(column, rows);\n        } else {\n            size_t candidate_count = run_length - 1;\n            if ((double)candidate_count > (double)best_count) {\n                best_count = (float)candidate_count;\n                mode = (float)run_value;\n            }\n            moda[i] = best_count == 0.0f ? -1.0 : (double)mode;\n        }\n\n        variancia[i] = sum_squares / (lin - 1);\n        dp[i] = sqrt(variancia[i]);\n        cv[i] = dp[i] / media[i];\n    }\n}\n\nint main(int argc, char **argv) {\n    int lin, col, i, j;\n    double *matriz, *scratch, *mediana, *media, *media_har;\n    double *moda, *variancia, *dp, *cv;\n    size_t rows, columns;\n\n    fscanf(stdin, \"%d \", &lin);\n    fscanf(stdin, \"%d\\n\", &col);\n    rows = (size_t)lin;\n    columns = (size_t)col;\n\n    matriz = (double *)malloc(rows * columns * sizeof(*matriz));\n    scratch = (double *)malloc(rows * sizeof(*scratch));\n    media = (double *)malloc(columns * sizeof(*media));\n    media_har = (double *)malloc(columns * sizeof(*media_har));\n    mediana = (double *)malloc(columns * sizeof(*mediana));\n    moda = (double *)malloc(columns * sizeof(*moda));\n    variancia = (double *)malloc(columns * sizeof(*variancia));\n    cv = (double *)malloc(columns * sizeof(*cv));\n    dp = (double *)malloc(columns * sizeof(*dp));\n\n    for (i = 0; i < lin; i++) {\n        for (j = 0; j < col; j++) {\n            fscanf(stdin, \"%lf \", &matriz[(size_t)j * rows + (size_t)i]);\n        }\n    }\n\n    calcula_medias(matriz, media, media_har, lin, col);\n    ordena_colunas(matriz, lin, col, scratch);\n    calcula_metricas_ordenadas(matriz, media, mediana, moda, variancia,\n                               dp, cv, lin, col);\n\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", media[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", media_har[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", mediana[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", moda[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", variancia[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", dp[i]);\n    printf(\"\\n\");\n    for (i = 0; i < col; i++)\n        printf(\"%.1lf \", cv[i]);\n    printf(\"\\n\");\n\n    free(matriz);\n    free(scratch);\n    free(media);\n    free(media_har);\n    free(mediana);\n    free(moda);\n    free(variancia);\n    free(dp);\n    free(cv);\n    return 0;\n}\n",
        "path": "src/est_matriz_seq.c"
      }

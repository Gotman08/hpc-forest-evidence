      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <assert.h>\n#include <string.h>\n\ntypedef struct {\n    long int *data;\n    int length;\n    long int total;\n} bucket;\n\nstatic int compare_indices(const char *a, int length, long int left, long int right) {\n    return strcmp(a + left * length, a + right * length);\n}\n\nstatic void sift_down(char *a, bucket *b, long int root, long int end) {\n    for (;;) {\n        long int child;\n        long int tmp;\n\n        if (root > end / 2)\n            return;\n\n        child = root * 2 + 1;\n        if (child > end)\n            return;\n        if (child < end &&\n            compare_indices(a, b->length, b->data[child], b->data[child + 1]) < 0)\n            child++;\n        if (compare_indices(a, b->length, b->data[root], b->data[child]) >= 0)\n            return;\n\n        tmp = b->data[root];\n        b->data[root] = b->data[child];\n        b->data[child] = tmp;\n        root = child;\n    }\n}\n\nstatic void sort(char *a, bucket *b) {\n    long int start;\n    long int end;\n    long int tmp;\n\n    if (b->total < 2)\n        return;\n\n    for (start = b->total / 2; start > 0;) {\n        --start;\n        sift_down(a, b, start, b->total - 1);\n    }\n\n    for (end = b->total - 1; end > 0; --end) {\n        tmp = b->data[0];\n        b->data[0] = b->data[end];\n        b->data[end] = tmp;\n        sift_down(a, b, 0, end - 1);\n    }\n}\n\nlong int* bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {\n    long int i;\n    long int next;\n    bucket *buckets = NULL;\n    bucket *b = NULL;\n    long int *returns = NULL;\n\n    returns = (long int *) malloc(sizeof(long int) * (size > 0 ? (size_t) size : 1));\n    buckets = (bucket *) malloc(sizeof(bucket) * (size_t) nbuckets);\n\n    for (i = 0; i < nbuckets; i++) {\n        buckets[i].data = NULL;\n        buckets[i].length = length;\n        buckets[i].total = 0;\n    }\n\n    /* Count first so every bucket receives a correctly sized slice. */\n    for (i = 0; i < size; i++) {\n        int bucket_index = *(a + i * length) - offset;\n        buckets[bucket_index].total++;\n    }\n\n    next = 0;\n    for (i = 0; i < nbuckets; i++) {\n        long int count = buckets[i].total;\n        buckets[i].data = returns + next;\n        buckets[i].total = 0;\n        next += count;\n    }\n\n    for (i = 0; i < size; i++) {\n        b = &buckets[*(a + i * length) - offset];\n        b->data[b->total++] = i;\n    }\n\n    /* Buckets are independent; dynamic scheduling balances skewed workloads. */\n    #pragma omp parallel for schedule(dynamic, 1) if (nbuckets > 1 && size >= 1024)\n    for (long int bucket_index = 0; bucket_index < nbuckets; bucket_index++)\n        sort(a, &buckets[bucket_index]);\n\n    free(buckets);\n    return returns;\n}\n\nvoid load(char **vString, long int *N, int *l, int *os, int *nb) {\n    char *strings = NULL;\n    int len;\n    int offset;\n    int nbucket;\n    long int n;\n\n    if (!fscanf(stdin, \"%d\", &len)) {\n        printf(\"ERROR len\\n\");\n        exit(1);\n    }\n\n    if (!fscanf(stdin, \"%ld\", &n)) {\n        printf(\"ERROR n\\n\");\n        exit(1);\n    }\n\n    if (!fscanf(stdin, \"%d\", &offset)) {\n        printf(\"ERROR offset\\n\");\n        exit(1);\n    }\n\n    if (!fscanf(stdin, \"%d\", &nbucket)) {\n        printf(\"ERROR nbucket\\n\");\n        exit(1);\n    }\n\n    nbucket = nbucket + 1;\n    len = len + 1;\n\n    strings = (char*) malloc(n * len);\n\n    for (int i = 0; i < n; i++) {\n        if (!fscanf(stdin, \"%s\", strings + (i * len))) {\n            printf(\"ERROR %d\\n\", i);\n            exit(1);\n        }\n    }\n\n    *vString = strings;\n    *N = n;\n    *l = len;\n    *os = offset;\n    *nb = nbucket;\n}\n\nvoid print(char *strings, long int *index, long int n, int len) {\n    for (int i = 0; i < n; i++) {\n        printf(\"%d -> %s\\n\", i, strings + (index[i] * len));\n    }\n}\n\nvoid save(char *strings, long int *index, long int n, int len) {\n    for (int i = 0; i < n; i++) {\n        printf(\"%s\\n\", strings + (index[i] * len));\n    }\n}\n\nint main(int ac, char **av) {\n    char *strings = NULL;\n    long int N = 0;\n    long int *index = NULL;\n    int len = 0;\n    int save2File = 0;\n    int offset;\n    int nbuckets;\n\n    load(&strings, &N, &len, &offset, &nbuckets);\n\n    index = bucket_sort(strings, len, N, offset, nbuckets);\n\n    save(strings, index, N, len);\n\n    if (strings != NULL)\n        free(strings);\n\n    if (index != NULL)\n        free(index);\n\n    return EXIT_SUCCESS;\n}\n",
      "path": "src/bucketsort.c"
    }
  ],
  "hypothesis": "Two-pass bucket packing safely accommodates any valid bucket skew; heapsorting each bucket removes quadratic worst cases, while dynamic OpenMP work sharing balances uneven bucket workloads across threads.",

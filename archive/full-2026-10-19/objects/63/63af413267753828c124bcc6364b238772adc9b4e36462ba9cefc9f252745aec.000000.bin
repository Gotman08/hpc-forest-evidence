{
  "src/graph.c": "#include<stdio.h>\n#include<stdlib.h>\n#include<string.h>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include<arm_neon.h>\n#endif\n\n/* Maximum size (in char) for neighbors and compute lists */\n#define MAX 100\n\ntypedef struct {\n  int id;\n  float value;\n  char neighbors[MAX];\n} Node;\n\ntypedef struct {\n  float cost;\n  unsigned char ready;\n} CachedCost;\n\n\n/* Reads input, allocates memory, writes graph size and node list. Returns the graph. */\nNode* read_input(char* fname, int *n, char* list) {\n  \n  Node* data = NULL;\n  FILE *fl = NULL;\n  \n  if (fname == NULL) \n    fl = stdin;\n  else \n    fl = fopen(fname, \"r\");\n  \n  if (fl == NULL) {\n    fprintf(stderr, \"Error!\\n\");\n    exit(1);\n  }\n  \n  // header \n  fscanf(fl, \"%d %[^\\n]\", n, list);\n  \n  if (*n > 1) {\n    data = (Node*) malloc ((*n)*sizeof(Node));\n    if(data == NULL){\n      fprintf(stderr, \"Error!\\n\");\n      exit(1);\n    }    \n  }\n  \n  for(int i = 0; i < *n; i++)\n    fscanf(fl, \"%d %f %[^\\n]\", &data[i].id, &data[i].value, data[i].neighbors);\n  \n  fclose(fl);\n\n  return data;\n  \n}\n\n/* Returns the index of the node with the given id or -1 if not found */\nint find_by_id(Node g[], int id, int size){\n\n  int i = 0;\n\n  while((i < size) && g[i].id != id)\n    i++;\n\n  if(i < size)\n    return i;\n\n  return -1;\n\n}\n\n/* Compare independent packed IDs, retaining the first matching input row. */\nstatic int find_by_id_compact(Node *g, const int *ids, int id, int size) {\n  int i = 0;\n\n  if (ids == NULL)\n    return find_by_id(g, id, size);\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n  int32x4_t key = vdupq_n_s32(id);\n\n  for (; size - i >= 16; i += 16) {\n    uint32x4_t m0 = vceqq_s32(vld1q_s32(ids + i), key);\n    uint32x4_t m1 = vceqq_s32(vld1q_s32(ids + i + 4), key);\n    uint32x4_t m2 = vceqq_s32(vld1q_s32(ids + i + 8), key);\n    uint32x4_t m3 = vceqq_s32(vld1q_s32(ids + i + 12), key);\n    uint32x4_t any = vorrq_u32(vorrq_u32(m0, m1), vorrq_u32(m2, m3));\n\n    if (vmaxvq_u32(any) != 0) {\n      for (int j = 0; j < 16; ++j) {\n        if (ids[i + j] == id)\n          return i + j;\n      }\n    }\n  }\n\n  for (; size - i >= 4; i += 4) {\n    uint32x4_t matches = vceqq_s32(vld1q_s32(ids + i), key);\n    if (vmaxvq_u32(matches) != 0) {\n      for (int j = 0; j < 4; ++j) {\n        if (ids[i + j] == id)\n          return i + j;\n      }\n    }\n  }\n#endif\n\n  for (; i < size; ++i) {\n    if (ids[i] == id)\n      return i;\n  }\n  return -1;\n}\n\n/* Computes the sum for the node with the given id */\nfloat get_costly(Node *g, int id, int size) {\n\n  char *t;\n  int idmax = -1;\n  float max = 0;\n  char *auxptr;\n  \n  int nd = find_by_id(g, id, size);\n  if(nd < 0)\n    return max;\n\n  char aux[MAX];\n  strcpy(aux, g[nd].neighbors);\n  t = strtok_r(aux, \" \", &auxptr);\n\n  do {\n    int d = find_by_id(g, atoi(t), size);\n    if (d >= 0 && max < g[d].value) {\n      max = g[d].value;\n      idmax = atoi(t);\n    }    \n  } while ((t = strtok_r(NULL, \" \", &auxptr)));\n\n  float r = g[nd].value;\n\n  if(idmax != -1)\n    r += get_costly(g, idmax, size);\n  \n  return (r);\n\n}\n\n/* Evaluate only demanded chains, reusing completed suffixes within this graph. */\nstatic float get_costly_cached(Node *g, const int *ids, int id, int size,\n                               CachedCost *cache, int *path) {\n  int nd = find_by_id_compact(g, ids, id, size);\n  int depth = 0;\n\n  if (nd < 0)\n    return 0.0f;\n\n  while (!cache[nd].ready) {\n    int idmax = -1;\n    int next = -1;\n    float max = 0.0f;\n    char aux[MAX];\n    char *auxptr;\n    char *t;\n\n    strcpy(aux, g[nd].neighbors);\n    for (t = strtok_r(aux, \" \", &auxptr); t != NULL;\n         t = strtok_r(NULL, \" \", &auxptr)) {\n      int neighbor_id = atoi(t);\n      int d = find_by_id_compact(g, ids, neighbor_id, size);\n      if (d >= 0 && max < g[d].value) {\n        max = g[d].value;\n        idmax = neighbor_id;\n        next = d;\n      }\n    }\n\n    /* The reference treats a selected ID of -1 as terminal, too. */\n    if (idmax == -1) {\n      cache[nd].cost = g[nd].value;\n      cache[nd].ready = 1;\n      break;\n    }\n\n    /* A path in the input DAG contains at most size nodes. */\n    path[depth++] = nd;\n    nd = next;\n  }\n\n  float result = cache[nd].cost;\n  while (depth > 0) {\n    int parent = path[--depth];\n    float r = g[parent].value;\n    /* Preserve recursive parent-plus-child grouping and float rounding. */\n    r += result;\n    cache[parent].cost = r;\n    cache[parent].ready = 1;\n    result = r;\n  }\n\n  return result;\n}\n\n/* Main program - calls read input, computes sum for each node in the list, prints output */\nint main() {\n  char *fileN = NULL;\n  char computelist[MAX];\n  int n = -1;\n  Node* input = NULL;\n  CachedCost *cache = NULL;\n  int *path = NULL;\n  int *ids = NULL;\n\n  input = read_input(fileN, &n, computelist);\n\n  if (n > 0) {\n    cache = (CachedCost*) calloc((size_t)n, sizeof(*cache));\n    if (cache != NULL) {\n      path = (int*) malloc((size_t)n * sizeof(*path));\n      if (path == NULL) {\n        free(cache);\n        cache = NULL;\n      }\n    }\n    if (cache != NULL) {\n      ids = (int*) malloc((size_t)n * sizeof(*ids));\n      if (ids != NULL) {\n        for (int i = 0; i < n; ++i)\n          ids[i] = input[i].id;\n      }\n    }\n  }\n  \n  // process\n  for(char *c = strtok(computelist, \" \"); c != NULL; c = strtok(NULL, \" \")) {\n    float cost;\n    if (cache != NULL)\n      cost = get_costly_cached(input, ids, atoi(c), n, cache, path);\n    else\n      cost = get_costly(input, atoi(c), n);\n    printf(\"%s: %f\\n\", c, cost);\n  }\n  \n  free(ids);\n  free(path);\n  free(cache);\n  free(input);\n\n  return 0;\n}\n"
}

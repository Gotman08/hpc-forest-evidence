"""Apply bounded deterministic edits to the NEW unsealed external candidate only."""
import ast
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE / 'revision-r2-integration'
BASE = HERE.parents[2]
PREP = HERE.parent


def update(name, changes):
    path = ROOT / name
    text = path.read_text()
    for old, new in changes:
        assert old in text, (name, old[:100])
        text = text.replace(old,new)
    path.write_text(text,encoding='utf8',newline='\n')


def replace_functions(name, replacements):
    path = ROOT/name
    text = path.read_text()
    tree = ast.parse(text)
    lines = text.splitlines(keepends=True)
    for node in sorted((n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name in replacements),key=lambda n:n.lineno,reverse=True):
        lines[node.lineno-1:node.end_lineno] = [replacements[node.name].rstrip()+'\n']
    path.write_text(''.join(lines),encoding='utf8',newline='\n')


def main():
    review = PREP/'revue-independante-source-r1/REVUE-INDEPENDANTE-SOURCE-R3-R4B110.json'
    review_sha = hashlib.sha256(review.read_bytes()).hexdigest()
    runtime_sha = '66de9eb1090eae8d8d8a3fc78279b3d5a82b7d4f12521424acdf647185020766'
    update('chain_contract.py', [('Q_REVISION = "lane-r2-integration"','Q_REVISION = "r4b-source110-external-adapters-r1"')])
    replace_functions('chain_contract.py', {
        'local_delta':'''def local_delta(root):
    """New complete chain110; historical Q105 is ancestry, never this qualification."""
    root = Path(root)
    manifest = json.loads((root / "COMPONENTS.json").read_text(encoding="utf8"))
    need(manifest.get("schema") == "hpc-forest-lane-r3-chain-components-v1"
         and manifest.get("source_zip_sha256") == SOURCE and manifest.get("plan_sha256") == PLAN
         and manifest.get("adapter_revision") == Q_REVISION, "New complete110 component graph required")
    ancestry = json.loads((root / "PROVENANCE-SOCLE-HISTORIQUE.json").read_text())
    need(ancestry.get("old_source105_or_Q_qualifies_source110") is False
         and ancestry["old_qualified_components"]["sha256"] == QUALIFIED_COMPONENTS_SHA,
         "Historical105 provenance must remain separate")
    old = read(ancestry["old_active_components"])
    need(ancestry["old_active_components"]["sha256"] == "c03ed75936ae5b833cbe0acc8a875083bd2a06831853fb706a8d2907968c5203",
         "Exact historical ancestor required")
    for name, checksum in old["code_pins"].items():
        need(sha(Path(ancestry["old_active_components"]["path"]).parent / name) == checksum,
             "Historical105 ancestor changed")
    need(isinstance(manifest.get("code_pins"), None), "unreachable") if False else None
    for name, checksum in manifest["code_pins"].items():
        need(not Path(name).is_absolute() and ".." not in Path(name).parts and sha(root / name) == checksum,
             "New110 integration component changed")
    current = sha(root / "COMPONENTS.json")
    return {"qualified_components_sha256":current,"active_components_sha256":current,
            "historical_components_sha256":QUALIFIED_COMPONENTS_SHA}
''',
        'check_local_delta':'''def check_local_delta(base_pins, active_pins, delta):
    raise ValueError("Historical105 local-only delta cannot qualify a source110 ARM change")
'''})
    update('chain_contract.py', [
        ('source_tests, adapter_tests = actual.get("source_lane_contract_tests"), actual.get("adapter_portable_tests")',
         'source_tests, adapter_tests = actual.get("source_lane_contract_tests"), actual.get("adapter_portable_tests")\n    need(actual.get("source_cli_privacy_tests") == {"passed":152,"failed":0}\n         and actual.get("source_prior_privacy_tests") == {"passed":9,"failed":0}\n         and all(type(v) is int for label in ("source_cli_privacy_tests","source_prior_privacy_tests") for v in actual[label].values()),\n         "Actual152CLI/privacy and9prior-privacy tests distinct from26lane required")')])
    with (ROOT/'chain_contract.py').open('a',encoding='utf8') as stream:
        stream.write('''\n\ndef source_review(value):
    need(value.get("verified_source_preparation_only") is True and value.get("blocking_findings") == []
         and value.get("source_zip",{}).get("sha256") == SOURCE
         and value.get("plan",{}).get("sha256") == PLAN
         and value.get("native_generation_admitted") is False,
         "Independent source110 preparation review required; it is not native admission")
    return value
''')
    update('reader_bridge.py', [
        ('PREP = HERE.parents[2]','PREP = HERE.parents[1]'),
        ('BASE = PREP.parents[1]','BASE = HERE.parents[3]'),
        ('"hpc-forest-lane-r2-chain-components-v1"','"hpc-forest-lane-r3-chain-components-v1"'),
        ('pins["independent_source_review"]["sha256"] == "b903ad78f736fbec86faa47cc24bf99670d5093b9e2367a811a1cc50b5a822d6"',f'pins["independent_source_review"]["sha256"] == "{review_sha}"'),
        ('review.get("verified") is True','review.get("verified_source_preparation_only") is True'),

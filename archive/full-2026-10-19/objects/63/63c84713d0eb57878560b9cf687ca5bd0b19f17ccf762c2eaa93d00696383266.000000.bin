        ('"codex_config_ref": dict(codex_config_ref), "owner_ref": dict(owner_ref), "pins": pins}',
         '"codex_config_ref": dict(codex_config_ref), "owner_ref": dict(owner_ref), "pins": pins, "cli_policy_ref":dict(cli_policy_ref)}'),
        ('return [*args, "--once"]','return [*args, "--once", "--cli-policy", spec["cli_policy_ref"]["path"], "--cli-policy-sha256", spec["cli_policy_ref"]["sha256"]]'),

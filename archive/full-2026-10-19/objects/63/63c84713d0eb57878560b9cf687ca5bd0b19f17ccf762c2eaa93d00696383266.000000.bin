        ('"native_contract_phase_receipts", "private_lane_inputs", "source_state_binding"}', '"native_contract_phase_receipts", "private_lane_inputs", "source_state_binding", "cli_policy"}'),
        ('bind(read(pins["independent_source_review"]), base)','reader_bridge.contract.source_review(read(pins["independent_source_review"]))'),
        ('config = artifact(inputs["codex_config"])','config = artifact(inputs["codex_config"])\n    policy_path = artifact(inputs["cli_policy"])\n    from hpc_forest.codex_process import load_task_cli_policy\n    private_policy = load_task_cli_policy(policy_path, inputs["cli_policy"]["sha256"], cell, admission.CLI_SHA256)\n    require(private_policy["instruction_or_SKILL_body_read"] is False, "Private task metadata only")'),
        ('"oauth_observation_sha256": inputs["oauth_observation"]["sha256"], "configuration_contents_exported": False}',

      "content": "#include \"knn.h\"\n#include <string.h>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nenum { CANDIDATE_BATCH_SIZE = 256 };\n\nstatic inline int first_insertion_position(const float * distances, int k, float d) {\n    int x = 0;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const float32x4_t candidate = vdupq_n_f32(d);\n    const float32x4_t empty = vdupq_n_f32(-1.0f);\n\n    /* Compare independent slots together, but retain the first matching slot. */\n    for (; x <= k - 4; x += 4) {\n        const float32x4_t stored = vld1q_f32(distances + x);\n        const uint32x4_t matches = vorrq_u32(\n            vcltq_f32(candidate, stored), vceqq_f32(stored, empty));\n        if (vmaxvq_u32(matches) != 0) {\n            break;\n        }\n    }\n#endif\n\n    for (; x < k; x++) {\n        if (d < distances[x] || distances[x] == -1) {\n            return x;\n        }\n    }\n    return k;\n}\n\nstatic inline void insert_one(float * distances, char * labels, int k,\n                              float d, char label) {\n    float farthest = distances[k - 1];\n    if (farthest != -1.0f && d >= farthest) {\n        return;\n    }\n\n    int x = first_insertion_position(distances, k, d);\n    if (x < k) {\n        size_t shifted = (size_t) (k - x - 1);\n        if (shifted != 0) {\n            memmove(distances + x + 1, distances + x,\n                    shifted * sizeof(*distances));\n            memmove(labels + x + 1, labels + x,\n                    shifted * sizeof(*labels));\n        }\n        distances[x] = d;\n        labels[x] = label;\n    }\n}\n\n/* Load the entire source before storing, including for overlapping suffixes. */\nstatic inline void copy_distance4(float * destination, const float * source) {\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    float32x4_t values = vld1q_f32(source);\n    vst1q_f32(destination, values);\n#else\n    float a = source[0], b = source[1], c = source[2], d = source[3];\n    destination[0] = a;\n    destination[1] = b;\n    destination[2] = c;\n    destination[3] = d;\n#endif\n}\n\nstatic inline void copy_label4(char * destination, const char * source) {\n    char values[4];\n    memcpy(values, source, sizeof(values));\n    memcpy(destination, values, sizeof(values));\n}\n\nstatic int compact_candidates(float * values, int count, float cutoff) {\n    int out = 0;\n    int i = 0;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const float32x4_t limit = vdupq_n_f32(cutoff);\n    for (; i <= count - 4; i += 4) {\n        const float32x4_t candidates = vld1q_f32(values + i);\n        const uint32x4_t keep = vcltq_f32(candidates, limit);\n        if (vminvq_u32(keep) != 0) {\n            vst1q_f32(values + out, candidates);\n            out += 4;\n        } else if (vmaxvq_u32(keep) != 0) {\n            if (vgetq_lane_u32(keep, 0))\n                values[out++] = vgetq_lane_f32(candidates, 0);\n            if (vgetq_lane_u32(keep, 1))\n                values[out++] = vgetq_lane_f32(candidates, 1);\n            if (vgetq_lane_u32(keep, 2))\n                values[out++] = vgetq_lane_f32(candidates, 2);\n            if (vgetq_lane_u32(keep, 3))\n                values[out++] = vgetq_lane_f32(candidates, 3);\n        }\n    }\n#endif\n    for (; i < count; i++) {\n        float d = values[i];\n        if (d < cutoff) {\n            values[out++] = d;\n        }\n    }\n    return out;\n}\n\n/* Every value in a batch belongs to the same group, and none is NaN. */\nstatic inline void sort_four(float * values) {\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    float32x4_t v = vld1q_f32(values);\n    float32x4_t paired = vrev64q_f32(v);\n    float32x4_t low = vminq_f32(v, paired);\n    float32x4_t high = vmaxq_f32(v, paired);\n    v = vtrnq_f32(low, high).val[0];\n\n    paired = vextq_f32(v, v, 2);\n    low = vminq_f32(v, paired);\n    high = vmaxq_f32(v, paired);\n    v = vcombine_f32(vget_low_f32(low), vget_high_f32(high));\n\n    paired = vrev64q_f32(vextq_f32(v, v, 2));\n    low = vminq_f32(v, paired);\n    high = vmaxq_f32(v, paired);\n    v = vsetq_lane_f32(vgetq_lane_f32(low, 1), v, 1);\n    v = vsetq_lane_f32(vgetq_lane_f32(high, 2), v, 2);\n    vst1q_f32(values, v);\n#else\n    for (int i = 1; i < 4; i++) {\n        float d = values[i];\n        int j = i;\n        while (j > 0 && d < values[j - 1]) {\n            values[j] = values[j - 1];\n            j--;\n        }\n        values[j] = d;\n    }\n#endif\n}\n\nstatic const float * sort_candidate_batch(float * values, float * scratch,\n                                          int count) {\n    int i = 0;\n    for (; i <= count - 4; i += 4) {\n        sort_four(values + i);\n    }\n    for (int j = i + 1; j < count; j++) {\n        float d = values[j];\n        int p = j;\n        while (p > i && d < values[p - 1]) {\n            values[p] = values[p - 1];\n            p--;\n        }\n        values[p] = d;\n    }\n\n    float * source = values;\n    float * destination = scratch;\n    for (int width = 4; width < count; width *= 2) {\n        for (int begin = 0; begin < count; begin += 2 * width) {\n            int middle = begin + width;\n            int end = begin + 2 * width;\n            if (middle > count) middle = count;\n            if (end > count) end = count;\n            int left = begin;\n            int right = middle;\n            int out = begin;\n\n            while (left < middle && right < end) {\n                if (left <= middle - 4 && source[left + 3] <= source[right]) {\n                    copy_distance4(destination + out, source + left);\n                    left += 4;\n                    out += 4;\n                } else if (right <= end - 4 && source[right + 3] < source[left]) {\n                    copy_distance4(destination + out, source + right);\n                    right += 4;\n                    out += 4;\n                } else if (source[right] < source[left]) {\n                    destination[out++] = source[right++];\n                } else {\n                    destination[out++] = source[left++];\n                }\n            }\n            if (left < middle) {\n                memcpy(destination + out, source + left,\n                       (size_t) (middle - left) * sizeof(*source));\n                out += middle - left;\n            }\n            if (right < end) {\n                memcpy(destination + out, source + right,\n                       (size_t) (end - right) * sizeof(*source));\n            }\n        }\n        float * temporary = source;\n        source = destination;\n        destination = temporary;\n    }\n    return source;\n}\n\nstatic int merge_candidate_batch(float * distances, char * labels, int k,\n                                 int used, const float * candidates, int count,\n                                 char label) {\n    int added = count;\n    if (added > k - used) added = k - used;\n    int kept = used + added;\n    int low = kept > count ? kept - count : 0;\n    int high = used;\n    int a = 0;\n    int b = 0;\n\n    /* Partition the retained prefix; older entries precede equal new ones. */\n    while (low <= high) {\n        a = low + (high - low) / 2;\n        b = kept - a;\n        if (a > 0 && b < count && distances[a - 1] > candidates[b]) {\n            high = a - 1;\n        } else if (b > 0 && a < used && candidates[b - 1] >= distances[a]) {\n            low = a + 1;\n        } else {\n            break;\n        }\n    }\n\n    /* Backward merging never overwrites an unread old prefix. */\n    int out = kept;\n    while (a > 0 && b > 0) {\n        if (a >= 4 && distances[a - 4] > candidates[b - 1]) {\n            a -= 4;\n            out -= 4;\n            copy_distance4(distances + out, distances + a);\n            copy_label4(labels + out, labels + a);\n        } else if (b >= 4 && candidates[b - 4] >= distances[a - 1]) {\n            b -= 4;\n            out -= 4;\n            copy_distance4(distances + out, candidates + b);\n            memset(labels + out, (unsigned char) label, 4);\n        } else {\n            out--;\n            if (candidates[b - 1] >= distances[a - 1]) {\n                distances[out] = candidates[--b];\n                labels[out] = label;\n            } else {\n                distances[out] = distances[--a];\n                labels[out] = labels[a];\n            }\n        }\n    }\n    if (b > 0) {\n        memcpy(distances, candidates, (size_t) b * sizeof(*distances));\n        memset(labels, (unsigned char) label, (size_t) b);\n    }\n    return kept;\n}\n\nstatic int select_candidate_batch(float * distances, char * labels, int k,\n                                  int used, float * candidates, float * scratch,\n                                  int count, char label) {\n    if (used == k) {\n        /* This immutable cutoff is conservative throughout the whole batch. */\n        count = compact_candidates(candidates, count, distances[k - 1]);\n        if (count == 0) return used;\n    }\n    const float * sorted = sort_candidate_batch(candidates, scratch, count);\n    return merge_candidate_batch(distances, labels, k, used, sorted, count, label);\n}\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n    float candidates[CANDIDATE_BATCH_SIZE];\n    float scratch[CANDIDATE_BATCH_SIZE];\n    int used = 0;\n    int scalar_fallback = 0;\n\n    int i, j;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n        distances[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        int count = 0;\n\n        for (j = 0; j < g.length; j++) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            if (scalar_fallback) {\n                insert_one(distances, labels, k, d, g.label);\n                continue;\n            }\n\n            /* Preserve the original unordered-comparison behavior for NaNs. */\n            if (d != d) {\n                if (count != 0) {\n                    used = select_candidate_batch(distances, labels, k, used,\n                                                  candidates, scratch, count, g.label);\n                    count = 0;\n                }\n                scalar_fallback = 1;\n                insert_one(distances, labels, k, d, g.label);\n                continue;\n            }\n\n            candidates[count++] = d;\n            if (count == CANDIDATE_BATCH_SIZE) {\n                used = select_candidate_batch(distances, labels, k, used,\n                                              candidates, scratch, count, g.label);\n                count = 0;\n            }\n        }\n        if (count != 0) {\n            used = select_candidate_batch(distances, labels, k, used,\n                                          candidates, scratch, count, g.label);\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }

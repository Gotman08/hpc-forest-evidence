+def native_cli(row):
+    executable = Path(row.get("ExecutablePath") or "").name.casefold()
+    command = row.get("CommandLine") or ""
+    return (
+        executable in {"codex.exe", "codex"}
+        or re.search(
+            r"(?:^|[\\/\s\"'])codex\.exe(?:[\"'\s]|$)|(?:^|\s)codex(?:\s|$)",
+            command,
+            flags=re.IGNORECASE,
+        )
+        is not None
+    )
+
+
 def classify(census, baseline, owned, preserved, operator_pid=None, now=None):
     stamp(census["captured_at_utc"])
     stamp(baseline["captured_at_utc"])
@@ -178,17 +192,105 @@
             in row["CommandLine"].casefold(),
             "Only this exact parent PowerShell execution may be self-classified; never a stop target",
         )
+    need(
+        not [
+            r
+            for r in rows
+            if r["ProcessId"] not in own
+            and native_cli(r)
+            and re.search(
+                r"(?:^|[\s\"'])exec(?:[\s\"']|$)",
+                r.get("CommandLine") or "",
+                flags=re.IGNORECASE,
+            )

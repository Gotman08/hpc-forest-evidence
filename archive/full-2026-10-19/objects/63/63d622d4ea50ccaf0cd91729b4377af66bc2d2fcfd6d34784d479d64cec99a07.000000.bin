+        need(
+            pid not in old,
+            "Foreign baseline PID reused/changed; no independent ancestry proved",
+        )
+        need(
+            not native_cli(row),
+            "New unknown native CLI invocation; never classify it as independent foreign",
+        )
+
+    independent = []
+    for candidate in new_foreign:
+        need(
+            stamp(baseline["captured_at_utc"])
+            <= stamp(candidate["CreationDate"])
+            <= stamp(census["captured_at_utc"]),
+            "New foreign birth outside baseline/current census interval",
+        )
+        chain = []
+        visited = set()
+        row = candidate
+        while True:
+            pid = row["ProcessId"]
+            need(pid not in visited, "Foreign ancestry cycle; independence not proved")
+            visited.add(pid)
+            need(pid not in own, "Foreign ancestry reaches an owned/preserved identity")
+            if pid in {0, 4}:
+                need(
+                    pid in old
+                    and pid in current
+                    and generic_same(current[pid], old[pid]),
+                    "System ancestry root changed or absent from baseline",
+                )
+                anchor_kind = "explicit_system_root_0_or_4"
+                anchor_pid = pid
+                break
+            identity(row)
+            if pid in old:
+                need(
+                    pid in current and generic_same(current[pid], old[pid]),
+                    "Foreign ancestor absent or baseline PID reused/changed",
+                )
+                anchor_kind = "unchanged_five_field_foreign_baseline"
+                anchor_pid = pid
+                break
+            chain.append(pid)
+            parent = row["ParentProcessId"]
+            need(
+                parent not in own,
+                "New foreign ancestry reaches an owned/preserved parent",
+            )
+            need(
+                parent in current,
+                "Foreign ancestry orphan/unknown parent; independence not proved",
+            )
+            parent_row = current[parent]
+            if parent_row.get("CreationDate") is not None:
+                need(
+                    stamp(parent_row["CreationDate"]) <= stamp(row["CreationDate"]),
+                    "Foreign parent created after child; PID reuse/ancestry ambiguity",
+                )
+            else:
+                need(
+                    parent in {0, 4},
+                    "Foreign parent creation unknown; independence not proved",
+                )
+            row = parent_row
+        independent.append(
+            {
+                "ProcessId": candidate["ProcessId"],
+                "ancestor_pids": chain,
+                "anchor_pid": anchor_pid,
+                "anchor_kind": anchor_kind,
+                "never_targeted": True,
+            }
+        )
+
     return {
         "present_owned": [pid for pid in OWNED_ORDER if pid in current],
         "absent_owned": [pid for pid in OWNED_ORDER if pid not in current],

#include <iostream>
#include <vector>
#include <cstdio>
#include <algorithm>
#include <omp.h>

int main() {
    int n, s;
    std::cin >> n >> s;

    // Read matrix into flat array for better cache locality
    std::vector<int> mat(n * n);
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            scanf("%d", &mat[i * n + j]);
        }
    }

    // Integral image: prefix sums with extra row/col of zeros
    std::vector<int> pref((n + 1) * (n + 1), 0);

    // First pass: compute row-wise partial sums in parallel
#pragma omp parallel for schedule(static)
    for (int i = 0; i < n; ++i) {
        int row_sum = 0;
        for (int j = 0; j < n; ++j) {
            row_sum += mat[i * n + j];
            pref[(i + 1) * (n + 1) + (j + 1)] = row_sum;
        }
    }

    // Second pass: accumulate column-wise to get true prefix sums
#pragma omp parallel for schedule(static)
    for (int j = 0; j < n; ++j) {
        int col_sum = 0;
        for (int i = 1; i <= n; ++i) {
            col_sum += pref[i * (n + 1) + (j + 1)];
            pref[i * (n + 1) + (j + 1)] = col_sum;
        }
    }

    int mxSum = -2147483648; // minimum possible integer

    // Search all top-left corners of SxS submatrices
#pragma omp parallel for collapse(2) reduction(max:mxSum) schedule(runtime)
    for (int i = 0; i <= n - s; ++i) {
        for (int j = 0; j <= n - s; ++j) {
            int sum = pref[(i + s) * (n + 1) + (j + s)]
                    - pref[i * (n + 1) + (j + s)]
                    - pref[(i + s) * (n + 1) + j]
                    + pref[i * (n + 1) + j];
            if (sum > mxSum) mxSum = sum;
        }
    }

    printf("%d\n", mxSum);
    return 0;
}

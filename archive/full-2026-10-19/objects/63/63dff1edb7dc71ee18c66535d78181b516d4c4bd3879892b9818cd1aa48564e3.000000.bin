    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <iostream>\\n#include <cstdio>\\n#include <cassert>\\n#include <algorithm>\\n#include <climits>\\n\\nclass FastScanner {\\npublic:\\n    static const int BUFSIZE = 1 << 20;\\n    char buf[BUFSIZE];\\n    int idx, size;\\n    FastScanner() : idx(0), size(0) {}\\n    inline char getChar() {\\n        if (idx >= size) {\\n            size = fread(buf, 1, BUFSIZE, stdin);\\n            idx = 0;\\n            if (size == 0) return 0;\\n        }\\n        return buf[idx++];\\n    }\\n    int nextInt() {\\n        char c;\\n        do { c = getChar(); } while (c <= ' ');\\n        bool neg = false;\\n        if (c == '-') { neg = true; c = getChar(); }\\n        int x = 0;\\n        while (c >= '0' && c <= '9') {\\n            x = x * 10 + (c - '0');\\n            c = getChar();\\n        }\\n        return neg ? -x : x;\\n    }\\n};\\n\\nint main() {\\n    FastScanner fs;\\n    int n = fs.nextInt();\\n    int s = fs.nextInt();\\n\\n    assert(s < n);\\n    assert(n < 8000);\\n    assert(s > 0);\\n    assert(n > 0);\\n\\n    // Use raw pointers to avoid zero-initialization overhead of std::vector\\n    int* mat = new int[n * n];\\n    for (int i = 0; i < n; ++i)\\n        for (int j = 0; j < n; ++j)\\n            mat[i*n + j] = fs.nextInt();\\n\\n    long long* colPref = new long long[n * n];\\n    long long mxSum = LLONG_MIN;\\n\\n    #pragma omp parallel\\n    {\\n        #pragma omp for schedule(static)\\n        for (int j = 0; j < n; ++j) {\\n            long long running = 0;\\n            for (int i = 0; i < n; ++i) {\\n                running += mat[i*n + j];\\n                colPref[i*n + j] = running;\\n            }\\n        }\\n\\n        // implicit barrier between the two worksharing loops\\n\\n        #pragma omp for reduction(max:mxSum) schedule(static)\\n        for (int r = 0; r <= n - s; ++r) {\\n            int bottom = r + s - 1;\\n            int topMinusOne = r - 1;\\n            long long cur = 0;\\n            const int bottomBase = bottom * n;\\n            const int topBase = (topMinusOne >= 0 ? topMinusOne * n : 0);\\n\\n            // initial window at column 0\\n            for (int c = 0; c < s; ++c) {\\n                long long seg = colPref[bottomBase + c] - (topMinusOne >= 0 ? colPref[topBase + c] : 0);\\n                cur += seg;\\n            }\\n            if (cur > mxSum) mxSum = cur;\\n\\n            for (int c = 1; c <= n - s; ++c) {\\n                int outCol = c - 1;\\n                int inCol = c + s - 1;\\n                long long segOut = colPref[bottomBase + outCol] - (topMinusOne >= 0 ? colPref[topBase + outCol] : 0);\\n                long long segIn = colPref[bottomBase + inCol] - (topMinusOne >= 0 ? colPref[topBase + inCol] : 0);\\n                cur += segIn - segOut;\\n                if (cur > mxSum) mxSum = cur;\\n            }\\n        }\\n    }\\n\\n    printf(\\\"%d\\\\n\\\", (int)mxSum);\\n\\n    delete[] mat;\\n    delete[] colPref;\\n}\\n\",\n      \"path\": \"src/solution.cpp\"\n    }\n  ],\n  \"hypothesis\": \"Eliminating the O(N^2) zero-initialization passes for the matrix and column-prefix arrays reduces memory traffic, which is a major bottleneck on 4 cores; combined with hoisting repeated address arithmetic in the reduction loop, this should improve parallel efficiency and lower runtime.\",\n  \"notes\": \"Kept the single OpenMP parallel region with static scheduling to preserve load balance. Replaced std::vector allocations with raw new[] pointers so no zero-fill is performed before data is written. Hoisted bottom*n and topMinusOne*n computations out of inner loops. No changes to I/O contract, correctness logic, or resource limits.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Replace std::vector allocations with raw new[] pointers to avoid zero-initialization memory writes\",\n    \"Hoist repeated base index computations (bottom*n and topMinusOne*n) out of inner loops\
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n#include <stdint.h>\\n#include <string.h>\\n\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\nenum {\\n    KNN_DISTANCE_BLOCK_SIZE = 256,\\n    KNN_WORD_BITS = 32,\\n    KNN_WORD_COUNT = KNN_DISTANCE_BLOCK_SIZE / KNN_WORD_BITS\\n};\\n\\ntypedef struct {\\n    float distance;\\n    int group;\\n} KnnCandidate;\\n\\ntypedef struct {\\n    KnnCandidate * candidates;\\n    int capacity;\\n    int count;\\n    int head;\\n} KnnPartial;\\n\\nstatic inline unsigned first_set_lane(uint32_t mask) {\\n#if defined(__GNUC__) || defined(__clang__)\\n    return (unsigned) __builtin_ctz((unsigned int) mask);\\n#else\\n    unsigned lane = 0;\\n    while ((mask & UINT32_C(1)) == 0) {\\n        mask >>= 1;\\n        lane++;\\n    }\\n    return lane;\\n#endif\\n}\\n\\nstatic void knn_partial_insert(KnnPartial * partial, float distance, int group) {\\n    if (partial->capacity == 0) return;\\n\\n    int count = partial->count;\\n    if (count == partial->capacity) {\\n        KnnCandidate last = partial->candidates[count - 1];\\n        if (distance > last.distance ||\\n            (distance == last.distance && group >= last.group)) return;\\n    }\\n\\n    /* A forward scan also preserves reference behavior for unordered values. */\\n    int position = 0;\\n    while (position < count) {\\n        KnnCandidate previous = partial->candidates[position];\\n        if (distance < previous.distance ||\\n            (distance == previous.distance && group < previous.group)) break;\\n        position++;\\n    }\\n    if (position == partial->capacity) return;\\n\\n    int last = count < partial->capacity ? count : partial->capacity - 1;\\n    if (last > position) {\\n        memmove(partial->candidates + position + 1,\\n                partial->candidates + position,\\n                (size_t) (last - position) * sizeof(*partial->candidates));\\n    }\\n    partial->candidates[position].distance = distance;\\n    partial->candidates[position].group = group;\\n    if (count < partial->capacity) partial->count++;\\n}\\n\\nstatic int knn_scan_group(KnnPartial * partial, const Group * g, int group,\\n                          size_t first, size_t end, Point to_evaluate,\\n                          int require_ordered) {\\n    if (partial->capacity == 0) return 1;\\n\\n    float block_distances[KNN_DISTANCE_BLOCK_SIZE];\\n    uint32_t candidate_masks[KNN_WORD_COUNT];\\n\\n    while (first < end) {\\n        size_t remaining = end - first;\\n        int count = remaining > KNN_DISTANCE_BLOCK_SIZE\\n                  ? KNN_DISTANCE_BLOCK_SIZE : (int) remaining;\\n        const Point * points = g->points + first;\\n        const int have_cutoff = partial->count == partial->capacity;\\n        KnnCandidate cutoff = {0.0f, 0};\\n        if (have_cutoff) cutoff = partial->candidates[partial->count - 1];\\n\\n        int mask_count = (count + KNN_WORD_BITS - 1) / KNN_WORD_BITS;\\n        int invalid = 0;\\n        for (int word = 0; word < mask_count; word++) {\\n            int base = word * KNN_WORD_BITS;\\n            int lanes = count - base;\\n            if (lanes > KNN_WORD_BITS) lanes = KNN_WORD_BITS;\\n            uint32_t mask = 0;\\n            int bad_distance = 0;\\n\\n#ifdef _OPENMP\\n#pragma omp simd reduction(|:mask,bad_distance)\\n#elif defined(__GNUC__) && !defined(__clang__)\\n#pragma GCC ivdep\\n#endif\\n            for (int lane = 0; lane < lanes; lane++) {\\n                float d = euclidean_distance_no_sqrt(to_evaluate, points[base + lane]);\\n                uint32_t retain = (uint32_t)\\n                    (!have_cutoff || !(d >= cutoff.distance) ||\\n                     (d == cutoff.distance && group < cutoff.group));\\n                block_distances[base + lane] = d;\\n                mask |= retain << lane;\\n                bad_distance |= !(d >= 0.0f);\\n            }\\n            candidate_masks[word] = mask;\\n            invalid |= bad_distance;\\n        }\\n\\n        /* Unordered distances cannot be merged independently across workers. */\\n        if (require_ordered && invalid) return 0;\\n\\n        for (int word = 0; word < mask_count; word++) {\\n            uint32_t mask = candidate_masks[word];\\n            while (mask != 0) {\\n                unsigned lane = first_set_lane(mask);\\n                int index = word * KNN_WORD_BITS + (int) lane;\\n                mask &= mask - UINT32_C(1);\\n                /* Insertion rechecks the evolving cutoff. */\\n                knn_partial_insert(partial, block_distances[index], group);\\n            }\\n        }\\n        first += (size_t) count;\\n    }\\n    return 1;\\n}\\n\\n#ifdef _OPENMP\\nstatic int knn_select_parallel(int n_groups, Group * groups, int k,\\n                               Point to_evaluate, char * labels) {\\n    if (k <= 0 || n_groups < 0) return 0;\\n\\n    size_t total = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        if (groups[i].length < 0) return 0;\\n        size_t length = (size_t) groups[i].length;\\n        if (length > SIZE_MAX - total) return 0;\\n        total += length;\\n    }\\n\\n    int workers = omp_get_max_threads();\\n    size_t max_workers = total / 4096;\\n    if (max_workers < (size_t) workers) workers = (int) max_workers;\\n    if (workers < 2) return 0;\\n\\n    KnnPartial * partials = (KnnPartial *) calloc((size_t) workers, sizeof(KnnPartial));\\n    if (partials == NULL) return 0;\\n    size_t * offsets = (size_t *) malloc(((size_t) n_groups + 1) * sizeof(size_t));\\n    if (offsets == NULL) {\\n        free(partials);\\n        return 0;\\n    }\\n    offsets[0] = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        offsets[i + 1] = offsets[i] + (size_t) groups[i].length;\\n    }\\n\\n    size_t block_size = total / ((size_t) workers * 8);\\n    if (block_size < 1024) block_size = 1024;\\n    if (block_size > 16384) block_size = 16384;\\n    size_t blocks = total / block_size + (total % block_size != 0);\\n    int capacity = total < (size_t) k ? (int) total : k;\\n    int failed = 0;\\n\\n#pragma omp parallel num_threads(workers) reduction(|:failed)\\n    {\\n        KnnPartial local = {0};\\n        local.capacity = capacity;\\n        local.candidates = (KnnCandidate *) malloc((size_t) capacity * sizeof(KnnCandidate));\\n        int invalid = local.candidates == NULL;\\n\\n#pragma omp for schedule(dynamic, 1)\\n        for (size_t block = 0; block < blocks; block++) {\\n            if (invalid) continue;\\n            size_t begin = block * block_size;\\n            size_t remaining = total - begin;\\n            size_t end = begin + (remaining < block_size ? remaining : block_size);\\n\\n            size_t low = 0;\\n            size_t high = (size_t) n_groups;\\n            while (low < high) {\\n                size_t middle = low + (high - low) / 2;\\n                if (offsets[middle + 1] <= begin) low = middle + 1;\\n                else high = middle;\\n            }\\n\\n            for (int i = (int) low;\\n                 i < n_groups && offsets[i] < end && !invalid; i++) {\\n                size_t first = begin > offsets[i] ? begin - offsets[i] : 0;\\n                size_t limit = (size_t) groups[i].length;\\n                if (end < offsets[i + 1]) limit = end - offsets[i];\\n                if (!knn_scan_group(&local, &groups[i], i, first, limit,\\n                                    to_evaluate, 1)) invalid = 1;\\n            }\\n        }\\n        partials[omp_get_thread_num()] = local;\\n        failed |= invalid;\\n    }\\n\\n    if (!failed) {\\n        for (int chosen = 0; chosen < k; chosen++) {\\n            int best = -1;\\n            KnnCandidate nearest = {0.0f, 0};\\n            for (int worker = 0; worker < workers; worker++) {\\n                KnnPartial * partial = &partials[worker];\\n                if (partial->head == partial->count) continue;\\n                KnnCandidate candidate = partial->candidates[partial->head];\\n                if (best < 0 || candidate.distance < nearest.distance ||\\n                    (candidate.distance == nearest.distance &&\\n                     candidate.group < nearest.group)) {\\n                    nearest = candidate;\\n                    best = worker;\\n                }\\n            }\\n            if (best < 0) break;\\n            labels[chosen] = groups[nearest.group].label;\\n            partials[best].head++;\\n        }\\n    }\\n\\n    for (int worker = 0; worker < workers; worker++) {\\n        free(partials[worker].candidates);\\n    }\\n    free(offsets);\\n    free(partials);\\n    return !failed;\\n}\\n#endif\\n\\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n    if (k <= 0) return (char) -1;\\n    char * labels = (char *) malloc(sizeof(char) * (size_t) k);\\n    if (labels == NULL) on_error();\\n    for (int i = 0; i < k; i++) labels[i] = -1;\\n\\n    int selected = 0;\\n#ifdef _OPENMP\\n    selected = knn_select_parallel(n_groups, groups, k, to_evaluate, labels);\\n#endif\\n    if (!selected) {\\n        int capacity = 0;\\n        for (int i = 0; i < n_groups && capacity < k; i++) {\\n            int length = groups[i].length;\\n            if (length > k - capacity) capacity = k;\\n            else if (length > 0) capacity += length;\\n        }\\n\\n        KnnPartial partial = {0};\\n        partial.capacity = capacity;\\n        if (capacity > 0) {\\n            partial.candidates = (KnnCandidate *) malloc((size_t) capacity * sizeof(KnnCandidate));\\n            if (partial.candidates == NULL) {\\n                free(labels);\\n                on_error();\\n            }\\n        }\\n        for (int i = 0; i < n_groups; i++) {\\n            if (groups[i].length > 0) {\\n                (void) knn_scan_group(&partial, &groups[i], i, 0,\\n                                      (size_t) groups[i].length, to_evaluate, 0);\\n            }\\n        }\\n        for (int i = 0; i < partial.count; i++) {\\n            labels[i] = groups[partial.candidates[i].group].label;\\n        }\\n        free(partial.candidates);\\n    }\\n\\n    qsort(labels, k, sizeof(char), compare_for_sort);\\n\\n    char most_frequent = labels[0];\\n    int most_frequent_count = 1;\\n    int current_frequency = 1;\\n\\n    for (int i = 1; i < k; i++) {\\n        if (labels[i] != labels[i - 1]) {\\n            if (current_frequency > most_frequent_count) {\\n                most_frequent = labels[i - 1];\\n                most_frequent_count = current_frequency;\\n            }\\n            current_frequency = 1;\\n        } else {\\n            current_frequency++;\\n        }\\n\\n        if (i == k - 1 && current_frequency > most_frequent_count) {\\n            most_frequent = labels[i - 1];\\n            most_frequent_count = current_frequency;\\n        }\\n    }\\n\\n    free(labels);\\n    return most_frequent;\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n    \\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Combining dynamically scheduled private top-k lists with masked distance tiles and occupied-prefix memmoves should reduce selection overhead while preserving deterministic classification.\",\n  \"notes\": \"Parsing, distance arithmetic, and voting remain unchanged. Unordered distances trigger input-order selection; scratch storage is released. Not executed.\",\n  \"sources_kept\": [\n    \"508803c7a55943b2\",\n    \"a8926b9e2c91478b\",\n    \"4055f971fac24ecc\"\n  ],\n  \"transformations\": [\n    \"Compute 256-point distance tiles with 32-lane unsigned candidate-mask reductions and traverse retained lanes in ascending order.\",\n    \"Track occupied neighbor prefixes, recheck evolving cutoffs, and memmove only live candidate entries.\",\n    \"Dynamically schedule contiguous OpenMP point blocks using group-prefix offsets, then merge private top-k lists by distance and original group index.\",\n    \"Retain an input-order fallback for unordered distances or unavailable parallel storage and free per-call scratch buffers.\"\n  ]\n}"}}

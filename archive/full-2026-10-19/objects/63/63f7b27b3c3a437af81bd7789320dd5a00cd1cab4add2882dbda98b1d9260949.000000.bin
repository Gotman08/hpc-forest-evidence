{
  "name": "forest-source110-cible-neutre-r1",
  "command": "bash -lc 'set -euo pipefail\npy=/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python\npacket=/scratch_p/nimarano/hpc-forest-r4b-target-profile-source110-20261018-r1.tar.gz\nroot=/scratch_p/nimarano/hpc-forest-r4b-target-profile-source110-20261018-r1\ntest -x \"$py\"\ntest ! -e \"$root\"\ntest -d /scratch_p/nimarano/hpc-forest-dynamic-r4b-lane-r3-qualification-20261018-eaff9217499f\nprintf '\"'\"'%s  %s\\n'\"'\"' 7474210c2ae206ae2fb1cb6bb961b77850f0f0b7eec2d374916988a7957c0023 \"$packet\" | sha256sum -c -\nromeo_load_armgpu_env\nspack load /zrtbeqke25s2vbqo4yrhsowjz7mg3pjf\nexport PYTHONDONTWRITEBYTECODE=1 PYTHONUTF8=1 CUDA_VISIBLE_DEVICES= OMP_NUM_THREADS=4 OMP_DYNAMIC=FALSE OMP_PROC_BIND=TRUE OPENBLAS_NUM_THREADS=1\nexec srun --ntasks=1 --cpus-per-task=4 --cpu-bind=cores \"$py\" -I -S -B - \"$packet\" \"$root\" 7474210c2ae206ae2fb1cb6bb961b77850f0f0b7eec2d374916988a7957c0023 <<'\"'\"'SOURCE110_TARGET_BOOTSTRAP'\"'\"'\n\"\"\"Inline bootstrap for one allocated srun; no scientific work before guard.\"\"\"\nimport hashlib\nimport io\nimport json\nimport os\nimport platform\nimport re\nimport runpy\nimport sys\nimport tarfile\nimport time\nfrom pathlib import Path\n\n\ndef need(ok, reason):\n    if not ok:\n        raise ValueError(reason)\n\n\ndef main():\n    need(time.time() + 600 + 10800 < 1793487600, \"Deadline plus audit reserve exceeded\")\n    need(platform.machine().lower() == \"aarch64\", \"ARM64 allocation required\")\n    need(all(os.environ.get(k) == v for k, v in {\n        \"SLURM_CPUS_PER_TASK\": \"4\", \"SLURM_NTASKS\": \"1\", \"SLURM_JOB_NUM_NODES\": \"1\",\n        \"SLURM_MEM_PER_NODE\": \"16384\"}.items()), \"Exact 4CPU/1task/1node/16GiB allocation required\")\n    need(re.fullmatch(r\"[0-9]+\", os.environ.get(\"SLURM_JOB_ID\", \"\")) is not None, \"Actual Slurm job required\")\n    need(not os.environ.get(\"SLURM_JOB_GPUS\", \"\") and not os.environ.get(\"SLURM_STEP_GPUS\", \"\")\n         and os.environ.get(\"SLURM_GPUS\", \"0\") == \"0\"\n         and os.environ.get(\"SLURM_GPUS_ON_NODE\", \"0\") == \"0\", \"Zero GPU required\")\n    affinity = sorted(os.sched_getaffinity(0))\n    need(len(affinity) == 4, \"Unique srun must bind exactly four CPUs\")\n    packet, root = map(Path, sys.argv[1:3])\n    expected_packet_sha = sys.argv[3]\n    need(root.is_absolute() and not root.exists() and not root.is_symlink(), \"Fresh absolute dedicated root required\")\n    packet_bytes = packet.read_bytes()\n    need(len(packet_bytes) <= 64 * 1024 * 1024\n         and hashlib.sha256(packet_bytes).hexdigest() == expected_packet_sha,\n         \"Exact bounded packet bytes required\")\n    expected = {'\"'\"'target-qualification-bindings.json'\"'\"', '\"'\"'q753709-qualification.json'\"'\"', '\"'\"'packet-manifest.json'\"'\"', '\"'\"'qualifier-cible-source110.py'\"'\"', '\"'\"'q753709-bindings.json'\"'\"', '\"'\"'q753709-bootstrap-allocation.json'\"'\"'}\n    with tarfile.open(fileobj=io.BytesIO(packet_bytes), mode=\"r:gz\") as archive:\n        members = archive.getmembers()\n        need(len(members) == len(expected) and {m.name for m in members} == expected\n             and all(m.isfile() and not m.issym() and not m.islnk() for m in members)\n             and sum(m.size for m in members) <= 128 * 1024 * 1024,\n             \"Exact six regular target packet files required\")\n        root.mkdir(parents=False, exist_ok=False)\n        for member in members:\n            with (root / member.name).open(\"xb\") as stream:\n                stream.write(archive.extractfile(member).read())\n    actual = {name: hashlib.sha256((root / name).read_bytes()).hexdigest()\n              for name in expected - {\"packet-manifest.json\"}}\n    need(actual == json.loads((root / \"packet-manifest.json\").read_text(encoding=\"utf-8\")),\n         \"Exact packet manifest required before wrapper execution\")\n    with (root / \"bootstrap-allocation.json\").open(\"x\", encoding=\"utf-8\") as stream:\n        json.dump({\"observed_at\": time.time(), \"architecture\": \"ARM64\", \"cpu_cores\": 4,\n                   \"tasks\": 1, \"nodes\": 1, \"allocated_memory_mib\": 16384, \"allocated_gpus\": 0,\n                   \"slurm_job_id\": os.environ[\"SLURM_JOB_ID\"], \"affinity_cpu_ids\": affinity,\n                   \"guard_before_any_extraction\": True, \"native_model_calls\": 0}, stream)\n    sys.argv = [str(root / \"qualifier-cible-source110.py\"), \"--driver\", str(root), \"--shared\", '\"'\"'/scratch_p/nimarano/hpc-forest-dynamic-r4b-lane-r3-qualification-20261018-eaff9217499f'\"'\"']\n    runpy.run_path(str(root / \"qualifier-cible-source110.py\"), run_name=\"__main__\")\n\n\nif __name__ == \"__main__\":\n    main()\n\nSOURCE110_TARGET_BOOTSTRAP\n'",
  "arch": "armgpu",
  "cpus_per_task": 4,
  "mem_gb": 16,
  "gpus_per_node": 0,
  "time_limit": "00:10:00",
  "workdir": "/scratch_p/nimarano",
  "spack_packages": [],

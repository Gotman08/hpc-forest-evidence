{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"/*\\n  Quicksort\\n*/\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <limits.h>\\n#include <openssl/md5.h>\\n\\n#define MY_RAND_MAX 0x7FFFFFFF\\n#define RANDNUM_W 521288629\\n#define RANDNUM_Z 362436069\\n#define INSERTION_CUTOFF 32\\n#define FALLBACK_INSERTION_CUTOFF 24\\n#define RADIX_BITS 8\\n#define RADIX_BUCKETS 256\\n#define RADIX_PASSES ((sizeof(unsigned int) * CHAR_BIT + RADIX_BITS - 1) / RADIX_BITS)\\n#define SORTED_CHECK_PARALLEL_CUTOFF 262144\\n\\nvoid srandnum(int seed);\\ndouble randnum(void);\\nint *generate_case(int N);\\ndouble drand(int xmin, int xmax);\\nvoid swap(int *toorder, int i, int j);\\nint partition(int *toorder, int lo, int hi);\\nvoid _quicksort(int *toorder, int lo, int hi);\\nvoid quicksort(int *toorder, int N);\\nint is_sorted(int *toorder, int N);\\n\\nstatic void insertion_sort(int *toorder, int lo, int hi);\\nstatic unsigned int radix_key(int value);\\n\\nunsigned int randum_w = RANDNUM_W;\\nunsigned int randum_z = RANDNUM_Z;\\n\\nvoid srandnum(int seed)\\n{\\n    unsigned int w, z;\\n    w = (seed * 104623) & 0xffffffff;\\n    randum_w = (w) ? w : RANDNUM_W;\\n    z = (seed * 48947) & 0xffffffff;\\n    randum_z = (z) ? z : RANDNUM_Z;\\n}\\n\\ndouble randnum(void)\\n{\\n    unsigned int u;\\n    randum_z = 36969 * (randum_z & 65535) + (randum_z >> 16);\\n    randum_w = 18000 * (randum_w & 65535) + (randum_w >> 16);\\n    u = (randum_z << 16) + randum_w;\\n    return (abs(u));\\n}\\n\\nint main(int argc, char *argv[])\\n{\\n    int N = 0;\\n    int *our_list = NULL;\\n\\n    scanf(\\\"%d\\\", &N);\\n    if (N <= 0) {\\n        printf(\\\"Error: please, provide the case size.\\\\n\\\");\\n        return 1;\\n    }\\n\\n    our_list = generate_case(N);\\n    if (our_list == NULL) {\\n        printf(\\\"Error: case instantiation failed.\\\\n\\\");\\n        return 1;\\n    }\\n\\n    quicksort(our_list, N);\\n\\n    if (is_sorted(our_list, N) == 1) {\\n        printf(\\\"Error, for some reason list is still unsorted.\\\\n\\\");\\n        return 1;\\n    }\\n\\n#ifdef COMPUTE_MD5_PROBLEM\\n    MD5_CTX c;\\n    unsigned char out[MD5_DIGEST_LENGTH];\\n    MD5_Init(&c);\\n    MD5_Update(&c, our_list, N * sizeof(int));\\n    MD5_Final(out, &c);\\n    for (int n = 0; n < MD5_DIGEST_LENGTH; n++) {\\n        printf(\\\"%02x\\\", out[n]);\\n    }\\n#endif\\n    printf(\\\"\\\\n\\\");\\n\\n    free(our_list);\\n    return 0;\\n}\\n\\nstatic unsigned int radix_key(int value)\\n{\\n    return (unsigned int)value - (unsigned int)INT_MIN;\\n}\\n\\nstatic void insertion_sort(int *toorder, int lo, int hi)\\n{\\n    for (int i = lo + 1; i <= hi; ++i) {\\n        int value = toorder[i];\\n        int j = i;\\n        while (j > lo && toorder[j - 1] > value) {\\n            toorder[j] = toorder[j - 1];\\n            --j;\\n        }\\n        toorder[j] = value;\\n    }\\n}\\n\\nvoid quicksort(int *toorder, int N)\\n{\\n    if (toorder == NULL || N < 2)\\n        return;\\n\\n    if (N <= INSERTION_CUTOFF) {\\n        insertion_sort(toorder, 0, N - 1);\\n        return;\\n    }\\n\\n    if ((size_t)N > (size_t)-1 / sizeof(*toorder)) {\\n        _quicksort(toorder, 0, N - 1);\\n        return;\\n    }\\n\\n    int *scratch = (int *)malloc((size_t)N * sizeof(*toorder));\\n    if (scratch == NULL) {\\n        _quicksort(toorder, 0, N - 1);\\n        return;\\n    }\\n\\n    int counts[RADIX_PASSES][RADIX_BUCKETS] = {{0}};\\n    for (int i = 0; i < N; ++i) {\\n        unsigned int key = radix_key(toorder[i]);\\n        for (int pass = 0; pass < RADIX_PASSES; ++pass) {\\n            unsigned int bucket = (key >> (pass * RADIX_BITS)) & (RADIX_BUCKETS - 1);\\n            ++counts[pass][bucket];\\n        }\\n    }\\n\\n    int *src = toorder;\\n    int *dst = scratch;\\n    for (int pass = 0; pass < RADIX_PASSES; ++pass) {\\n        int position = 0;\\n        for (int bucket = 0; bucket < RADIX_BUCKETS; ++bucket) {\\n            int frequency = counts[pass][bucket];\\n            counts[pass][bucket] = position;\\n            position += frequency;\\n        }\\n\\n        unsigned int shift = pass * RADIX_BITS;\\n        for (int i = 0; i < N; ++i) {\\n            int value = src[i];\\n            unsigned int bucket = (radix_key(value) >> shift) & (RADIX_BUCKETS - 1);\\n            dst[counts[pass][bucket]++] = value;\\n        }\\n\\n        int *temporary = src;\\n        src = dst;\\n        dst = temporary;\\n    }\\n\\n    if (src != toorder) {\\n        for (int i = 0; i < N; ++i)\\n            toorder[i] = src[i];\\n    }\\n    free(scratch);\\n}\\n\\nvoid _quicksort(int *toorder, int lo, int hi)\\n{\\n    if (toorder == NULL || lo >= hi)\\n        return;\\n\\n    while (hi - lo + 1 > FALLBACK_INSERTION_CUTOFF) {\\n        int boundary = partition(toorder, lo, hi);\\n        if (boundary - lo < hi - boundary) {\\n            _quicksort(toorder, lo, boundary);\\n            lo = boundary + 1;\\n        } else {\\n            _quicksort(toorder, boundary + 1, hi);\\n            hi = boundary;\\n        }\\n    }\\n    insertion_sort(toorder, lo, hi);\\n}\\n\\nvoid swap(int *toorder, int i, int j)\\n{\\n    int temp = toorder[i];\\n    toorder[i] = toorder[j];\\n    toorder[j] = temp;\\n}\\n\\nint partition(int *toorder, int lo, int hi)\\n{\\n    if (lo >= hi)\\n        return lo;\\n\\n    double fraction = randnum() / MY_RAND_MAX;\\n    if (!(fraction >= 0.0))\\n        fraction = 0.0;\\n    else if (fraction > 1.0)\\n        fraction = 1.0;\\n\\n    int r = lo + (int)((hi - lo) * fraction);\\n    int mid = lo + (hi - lo) / 2;\\n    swap(toorder, r, mid);\\n    int pivot = toorder[mid];\\n    int i = lo - 1;\\n    int j = hi + 1;\\n\\n    for (;;) {\\n        do {\\n            ++i;\\n        } while (toorder[i] < pivot);\\n        do {\\n            --j;\\n        } while (toorder[j] > pivot);\\n\\n        if (i >= j)\\n            return j;\\n        swap(toorder, i, j);\\n    }\\n}\\n\\nint is_sorted(int *toorder, int N)\\n{\\n    int unsorted = 0;\\n#ifdef _OPENMP\\n#pragma omp parallel for simd schedule(static) reduction(|:unsorted) if(N >= SORTED_CHECK_PARALLEL_CUTOFF)\\n#else\\n#pragma omp simd reduction(|:unsorted)\\n#endif\\n    for (int i = 1; i < N; ++i) {\\n        unsorted |= toorder[i] < toorder[i - 1];\\n    }\\n    return unsorted;\\n}\\n\\nint *generate_case(int N)\\n{\\n    int i;\\n    int *ret = NULL;\\n\\n    srandnum(0);\\n\\n    ret = (int *)malloc(N * sizeof(int));\\n    if (ret == NULL) {\\n        printf(\\\"Error: some malloc won't work.\\\\n\\\");\\n        return NULL;\\n    }\\n    for (i = 0; i < N; i++) {\\n        ret[i] = drand(0, INT_MAX);\\n    }\\n    return ret;\\n}\\n\\ndouble drand(int xmin, int xmax)\\n{\\n    return xmin + (xmax - xmin) * randnum() / MY_RAND_MAX;\\n}\\n\",\"path\":\"src/quicksort.c\"}],\"hypothesis\":\"Stable byte-radix passes should preserve the measured sorting improvement, while a static OpenMP SIMD reduction may shorten verification of large arrays on the four-core ARM64 target. A Hoare-partition fallback should also limit stack growth if radix scratch allocation fails.\",\"notes\":\"This combines the archived radix path with the archived OpenMP sortedness reduction and a stack-bounded Hoare quicksort fallback. Oracle correctness and full-program timing remain for the controller to evaluate; no commands were run.\",\"sources_kept\":[\"9e2ff58f3d9348b2\",\"650e477419964400\",\"d89830260fe249f3\"],\"transformations\":[\"For arrays over 32 elements, use stable signed-order 8-bit LSD radix passes with a sequential scratch buffer; retain quicksort when scratch allocation fails, and use insertion sort for smaller arrays.\",\"Build all byte histograms in one input sweep, then scatter through stable contiguous passes.\",\"Use a static-scheduled OpenMP SIMD bitwise-OR reduction for the sortedness check, activating the parallel team only for large inputs.\",\"Use Hoare partitioning with a selected pivot moved to the midpoint in the allocation-failure fallback; recurse on the smaller partition, iterate over the larger one, and insertion-sort ranges of at most 24 elements.\"]}"}}

#include <algorithm>
#include <cstddef>
#include <iostream>
#include <utility>
#include <vector>

using namespace std;

struct adjacency_matrix {
    explicit adjacency_matrix(size_t vertices = 0)
        : vertices_(vertices), data_(vertices * vertices, 0) {}

    size_t size() const { return vertices_; }

    unsigned char *operator[](size_t row) {
        return data_.data() + row * vertices_;
    }

    const unsigned char *operator[](size_t row) const {
        return data_.data() + row * vertices_;
    }

private:
    size_t vertices_;
    vector<unsigned char> data_;
};

adjacency_matrix readGraph();
vector<int> vertexDegrees(const adjacency_matrix &graph);
bool degreeCompatible(const vector<int> &degrees1, const vector<int> &degrees2,
                      const vector<int> &equivalence);
bool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2);
bool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,
                       const vector<int> &equivalence);
inline void printPermutation(const vector<int> &equivalence);

int main() {
    adjacency_matrix g1 = readGraph();
    adjacency_matrix g2 = readGraph();

    if (!testIsomorphism(g1, g2))
        cout << "The graphs are not isomorphic" << endl;

    return 0;
}

bool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2) {
    if (g1.size() != g2.size()) return false;

    const int n = static_cast<int>(g1.size());
    vector<int> equivalence(n, 0);
    vector<int> exchange_counter(n, 0);
    int exchange_index = 1;
    bool isomorphism_found = false;

    for (int i = 0; i < n; ++i)
        equivalence[i] = i;

    if (verifyPermutation(g1, g2, equivalence)) {
        printPermutation(equivalence);
        return true;
    }

    const vector<int> degrees1 = vertexDegrees(g1);
    const vector<int> degrees2 = vertexDegrees(g2);
    vector<int> sorted_degrees1 = degrees1;
    vector<int> sorted_degrees2 = degrees2;
    sort(sorted_degrees1.begin(), sorted_degrees1.end());
    sort(sorted_degrees2.begin(), sorted_degrees2.end());
    if (sorted_degrees1 != sorted_degrees2) return false;

    /*
     * Permutations are based on Heap's algorithm, which generates all possible
     * permutations for a given set of elements.
     */
    while (exchange_index < n) {
        if (exchange_counter[exchange_index] < exchange_index) {
            if (exchange_index % 2 == 0)
                swap(equivalence[0], equivalence[exchange_index]);
            else
                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);

            if (degreeCompatible(degrees1, degrees2, equivalence) &&
                verifyPermutation(g1, g2, equivalence)) {
                printPermutation(equivalence);
                isomorphism_found = true;
            }

            exchange_counter[exchange_index]++;
            exchange_index = 1;
        } else {
            exchange_counter[exchange_index] = 0;
            exchange_index++;
        }
    }
    return isomorphism_found;
}

adjacency_matrix readGraph() {
    int vertices, edges, source, destination;

    cin >> vertices;
    adjacency_matrix read(vertices);

    cin >> edges;
    for (int i = 0; i < edges; i++) {
        cin >> source >> destination;
        read[destination][source] = read[source][destination] = 1;
    }

    return read;
}

vector<int> vertexDegrees(const adjacency_matrix &graph) {
    const int n = static_cast<int>(graph.size());
    vector<int> degrees(n, 0);
    for (int i = 0; i < n; ++i) {
        const unsigned char *row = graph[i];
        int degree = 0;
        for (int j = 0; j < n; ++j)
            degree += row[j];
        degrees[i] = degree;
    }
    return degrees;
}

bool degreeCompatible(const vector<int> &degrees1, const vector<int> &degrees2,
                      const vector<int> &equivalence) {
    for (size_t i = 0; i < equivalence.size(); ++i) {
        if (degrees1[i] != degrees2[equivalence[i]]) return false;
    }
    return true;
}

bool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,
                       const vector<int> &equivalence) {
    for (size_t i = 0; i < equivalence.size(); ++i) {
        const unsigned char *row1 = g1[i];
        const unsigned char *row2 = g2[equivalence[i]];
        for (size_t j = 0; j <= i; ++j) {
            if (row1[j] != row2[equivalence[j]]) return false;
        }
    }
    return true;
}

inline void printPermutation(const vector<int> &equivalence) {
    for (auto i : equivalence)
        cout << i << " ";
    cout << endl;
}

{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nint main(int argc, char **argv) {\n    int n;\n    if (fread(&n, sizeof(n), 1, stdin) != 1) {\n        fprintf(stderr, \"\\nError reading nbodie value\\n\");\n        exit(EXIT_FAILURE);\n    }\n\n    size_t count = (size_t)n * 6;\n    float *tmp = (float *)malloc(count * sizeof(float));\n    if (!tmp) { perror(\"malloc\"); exit(EXIT_FAILURE); }\n    if (fread(tmp, count * sizeof(float), 1, stdin) != 1) {\n        fprintf(stderr, \"\\nError reading input values\\n\");\n        free(tmp);\n        exit(EXIT_FAILURE);\n    }\n\n    float *restrict px_cur = (float *)malloc((size_t)n * sizeof(float));\n    float *restrict py_cur = (float *)malloc((size_t)n * sizeof(float));\n    float *restrict pz_cur = (float *)malloc((size_t)n * sizeof(float));\n    float *restrict vx_cur = (float *)malloc((size_t)n * sizeof(float));\n    float *restrict vy_cur = (float *)malloc((size_t)n * sizeof(float));\n    float *restrict vz_cur = (float *)malloc((size_t)n * sizeof(float));\n\n    float *restrict px_nxt = (float *)malloc((size_t)n * sizeof(float));\n    float *restrict py_nxt = (float *)malloc((size_t)n * sizeof(float));\n    float *restrict pz_nxt = (float *)malloc((size_t)n * sizeof(float));\n    float *restrict vx_nxt = (float *)malloc((size_t)n * sizeof(float));\n    float *restrict vy_nxt = (float *)malloc((size_t)n * sizeof(float));\n    float *restrict vz_nxt = (float *)malloc((size_t)n * sizeof(float));\n\n    if (!px_cur || !py_cur || !pz_cur || !vx_cur || !vy_cur || !vz_cur ||\n        !px_nxt || !py_nxt || !pz_nxt || !vx_nxt || !vy_nxt || !vz_nxt) {\n        perror(\"malloc\");\n        exit(EXIT_FAILURE);\n    }\n\n    for (int i = 0; i < n; ++i) {\n        px_cur[i] = tmp[6*i];\n        py_cur[i] = tmp[6*i+1];\n        pz_cur[i] = tmp[6*i+2];\n        vx_cur[i] = tmp[6*i+3];\n        vy_cur[i] = tmp[6*i+4];\n        vz_cur[i] = tmp[6*i+5];\n    }\n    free(tmp);\n\n    for (int iter = 0; iter < N_ITER; ++iter) {\n        #pragma omp parallel for schedule(static)\n        for (int i = 0; i < n; ++i) {\n            float xi = px_cur[i];\n            float yi = py_cur[i];\n            float zi = pz_cur[i];\n            float fx = 0.0f, fy = 0.0f, fz = 0.0f;\n\n            int j = 0;\n            // Unroll inner loop by 4 to expose independent sqrt/div computations\n            for (; j + 3 < n; j += 4) {\n                float dx0 = px_cur[j] - xi;\n                float dy0 = py_cur[j] - yi;\n                float dz0 = pz_cur[j] - zi;\n                float sqrd0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\n                float inv0 = 1.0f / sqrt(sqrd0);\n                float inv3_0 = inv0 * inv0 * inv0;\n                fx += dx0 * inv3_0;\n                fy += dy0 * inv3_0;\n                fz += dz0 * inv3_0;\n\n                float dx1 = px_cur[j+1] - xi;\n                float dy1 = py_cur[j+1] - yi;\n                float dz1 = pz_cur[j+1] - zi;\n                float sqrd1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\n                float inv1 = 1.0f / sqrt(sqrd1);\n                float inv3_1 = inv1 * inv1 * inv1;\n                fx += dx1 * inv3_1;\n                fy += dy1 * inv3_1;\n                fz += dz1 * inv3_1;\n\n                float dx2 = px_cur[j+2] - xi;\n                float dy2 = py_cur[j+2] - yi;\n                float dz2 = pz_cur[j+2] - zi;\n                float sqrd2 = dx2*dx2 + dy2*dy2 + dz2*dz2 + SOFTENING;\n                float inv2 = 1.0f / sqrt(sqrd2);\n                float inv3_2 = inv2 * inv2 * inv2;\n                fx += dx2 * inv3_2;\n                fy += dy2 * inv3_2;\n                fz += dz2 * inv3_2;\n\n                float dx3 = px_cur[j+3] - xi;\n                float dy3 = py_cur[j+3] - yi;\n                float dz3 = pz_cur[j+3] - zi;\n                float sqrd3 = dx3*dx3 + dy3*dy3 + dz3*dz3 + SOFTENING;\n                float inv3 = 1.0f / sqrt(sqrd3);\n                float inv3_3 = inv3 * inv3 * inv3;\n                fx += dx3 * inv3_3;\n                fy += dy3 * inv3_3;\n                fz += dz3 * inv3_3;\n            }\n\n            // Tail loop for remaining bodies\n            for (; j < n; ++j) {\n                float dx = px_cur[j] - xi;\n                float dy = py_cur[j] - yi;\n                float dz = pz_cur[j] - zi;\n                float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n                float inv_dist = 1.0f / sqrt(sqrd_dist);\n                float inv_dist3 = inv_dist * inv_dist * inv_dist;\n                fx += dx * inv_dist3;\n                fy += dy * inv_dist3;\n                fz += dz * inv_dist3;\n            }\n\n            // Update velocities and positions into next buffer\n            vx_nxt[i] = vx_cur[i] + DT*fx;\n            vy_nxt[i] = vy_cur[i] + DT*fy;\n            vz_nxt[i] = vz_cur[i] + DT*fz;\n\n            px_nxt[i] = xi + vx_nxt[i]*DT;\n            py_nxt[i] = yi + vy_nxt[i]*DT;\n            pz_nxt[i] = zi + vz_nxt[i]*DT;\n        }\n\n        // Swap current and next buffers\n        float *tp;\n        tp=px_cur; px_cur=px_nxt; px_nxt=tp;\n        tp=py_cur; py_cur=py_nxt; py_nxt=tp;\n        tp=pz_cur; pz_cur=pz_nxt; pz_nxt=tp;\n        tp=vx_cur; vx_cur=vx_nxt; vx_nxt=tp;\n        tp=vy_cur; vy_cur=vy_nxt; vy_nxt=tp;\n        tp=vz_cur; vz_cur=vz_nxt; vz_nxt=tp;\n    }\n\n    // Write output in original Body layout\n    Body *out = (Body *)malloc((size_t)n * sizeof(Body));\n    if (!out) { perror(\"malloc\"); exit(EXIT_FAILURE); }\n    for (int i = 0; i < n; ++i) {\n        out[i].x = px_cur[i];\n        out[i].y = py_cur[i];\n        out[i].z = pz_cur[i];\n        out[i].vx = vx_cur[i];\n        out[i].vy = vy_cur[i];\n        out[i].vz = vz_cur[i];\n    }\n\n    if (fwrite(out, n * sizeof(Body), 1, stdout) != 1) {\n        fprintf(stderr, \"\\nError writing to output\\n\");\n        exit(EXIT_FAILURE);\n    }\n\n    free(px_cur); free(py_cur); free(pz_cur);\n    free(vx_cur); free(vy_cur); free(vz_cur);\n    free(px_nxt); free(py_nxt); free(pz_nxt);\n    free(vx_nxt); free(vy_nxt); free(vz_nxt);\n    free(out);\n\n    exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Integrating SoA layout (A), manual unrolling of the inner j-loop by factor 4 with sequential accumulation preserving exact summation order (B), and double buffering that combines force computation, velocity update, and position integration into a single OpenMP parallel-for per iteration (C) will improve cache locality, expose independent sqrt/division operations for SIMD vectorization, reduce synchronization overhead to one barrier per step, and preserve bit-exact output bytes.",
  "notes": "The implementation uses simple malloc allocations (no explicit alignment) based on prior experiments where aligned allocation did not help. The inner loop is unrolled by 4 with a tail loop; the accumulation order matches the original sequential code exactly. Double buffering eliminates the separate position-update pass and its associated barrier, while static scheduling distributes work evenly across threads.",

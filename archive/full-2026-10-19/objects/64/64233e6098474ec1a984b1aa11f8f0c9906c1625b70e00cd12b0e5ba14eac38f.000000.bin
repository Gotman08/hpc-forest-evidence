-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/baseline-e1/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/baseline-e1/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/baseline-e1/search/attempt-001/sample-2.log\"], \"mean_seconds\": 2.0937218138327203, \"reason\": \"\", \"score\": 0.5, \"status\": \"valid\", \"times\": [2.048772657290101, 2.048439928330481, 2.1839528558775783], \"tree_hash\": \"ca82542605ae0cd806fbb756ddba0161138096c5\"}, \"raw_logs\": [{\"path\": \"logs/e1/baseline-e1/search/attempt-001/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": true, \"cases\": 4}}]}, \"selected_parent\": {\"experiment_id\": \"9cadb4567cbc46b7\", \"role\": \"G\", \"hypothesis\": \"Integrating SoA storage (B) with NEON SIMD distance computation, max-heap top-k selection (A), OpenMP parallelization over groups with per-thread heaps and guided scheduling (C), plus fixing the critical bug where local_size was reset for each group instead of accumulated across a thread's assigned groups, will yield a correct program that matches baseline output exactly by using qsort-based tie-breaking identical to the original.\", \"outcome\": {\"binary_sha256\": \"a2fd54dd069a5c2ca67f70bfd26b0715ec72d76e588cebcdc14a68bcf04bafc2\", \"cache_key\": \"d881584f48100b399f8e5977dbf489eaeb1a32efd21c0763f2975a29d209b76d\", \"commit\": \"5a647028f7cecd6ad3dbbc9716aed9d603e3704b\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/9cadb4567cbc46b7/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/9cadb4567cbc46b7/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/9cadb4567cbc46b7/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/9cadb4567cbc46b7/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/9cadb4567cbc46b7/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/9cadb4567cbc46b7/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.031086775474250317, \"reason\": \"\", \"score\": 0.9853696113472556, \"status\": \"valid\", \"times\": [0.03156918752938509, 0.030663028359413147, 0.031028110533952713], \"tree_hash\": \"7e31d0f3fe355401a954bbf4f8781de966068712\"}, \"raw_logs\": [{\"path\": \"logs/e1/9cadb4567cbc46b7/search/attempt-001/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": true, \"cases\": 4}}]}, \"selected_base_commit\": \"5a647028f7cecd6ad3dbbc9716aed9d603e3704b\", \"recent_own_role\": [{\"experiment_id\": \"0d7560b22c5f4455\", \"role\": \"G\", \"hypothesis\": \"Integrating max-heap top-k selection with frequency-array counting (A), SoA storage and NEON SIMD distance computation using batch size 16 via vld1q_f32_x4 (B), and OpenMP parallelization over groups with persistent per-thread heaps allocated once outside the parallel region (C) will yield a correct program that is faster than any single transformation. Removing unnecessary sentinel initialization of thread-local heaps and including all k entries in frequency counting (including -1 sentinels) ensures correctness matches the original sequential algorithm.\", \"outcome\": {\"binary_sha256\": \"c91f038f0e25fd446a81d0a008f4d5f74d866f29c37ef768f664d102c7002f13\", \"cache_key\": \"481d1ce595ac26b0dcf8428895e19f4f23049bc6c19bdba50c11037006c5b84b\", \"commit\": \"bb75c96325b9d72caa6d6d65b2f788066e7a41b4\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/0d7560b22c5f4455/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/0d7560b22c5f4455/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/0d7560b22c5f4455/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/0d7560b22c5f4455/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/0d7560b22c5f4455/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/0d7560b22c5f4455/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.02787589095532894, \"reason\": \"\", \"score\": 0.9868608969115971, \"status\": \"valid\", \"times\": [0.028178349137306213, 0.027437467128038406, 0.028011856600642204], \"tree_hash\": \"41eeb496d9c1e3dab32f0fda80a194427634cb9a\"}, \"raw_logs\": [{\"path\": \"logs/e1/0d7560b22c5f4455/search/attempt-001/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": true, \"cases\": 4}}]}, {\"experiment_id\": \"b15490a5b94e4732\", \"role\": \"G\", \"hypothesis\": \"Integrating SoA storage (B) with NEON SIMD distance computation, max-heap top-k selection using frequency-array counting (A), and OpenMP parallelization over groups with per-thread heaps plus deterministic tie-breaking via atomic sequence numbers (C) will yield a correct program that is faster than any single transformation. The addition of global sequence numbers ensures that the final k-nearest neighbors match the original sequential insertion order, fixing previous correctness failures.\", \"outcome\": {\"binary_sha256\": \"645424f92deae245d6abc300e17248a42faeb0cd516d235988db435d5f784c47\", \"cache_key\": \"eab106f55837de9b28d7eef851e6a245cbfa6953e07263c0653e93ee6558869d\", \"commit\": \"fd878fca76e2b9afee85bcf9be81b47d24f435b9\", \"correct\": false, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/b15490a5b94e4732/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/b15490a5b94e4732/search/attempt-001/correctness.log\"], \"mean_seconds\": null, \"reason\": \"Protected correctness checks failed\", \"score\": 0.0, \"status\": \"incorrect\", \"times\": [], \"tree_hash\": \"ba045f03e8973ed88a1a83e10e09bd147bbadd18\"}, \"raw_logs\": [{\"path\": \"logs/e1/b15490a5b94e4732/search/attempt-001/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": false, \"case\": \"search-0\", \"reason\": \"Reference output mismatch\"}}]}, {\"experiment_id\": \"48a49a52a0144683\", \"role\": \"G\", \"hypothesis\": \"Integrating interleaved coordinate storage (A), static inline distance function (B), and flattened point iteration with per-thread max-heaps plus early skip (C) will combine memory-friendly layout, reduced function call overhead, efficient streaming heap operations, and thread-level parallelism to yield a correct program faster than any single transformation.\", \"outcome\": {\"binary_sha256\": \"565f08584948eed8916e9b39641f7b8d13e87b8199c9a1543546a2d6478ffdbc\", \"cache_key\": \"0f136f9521da33b39a6ce1f61ec94e45187214472605a07172aeb3d9abf9e259\", \"commit\": \"160bd28a8a58bacebfea00ad67d8a42ea8cfa275\", \"correct\": true, \"logs\": [\"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/48a49a52a0144683/search/attempt-001/build.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/48a49a52a0144683/search/attempt-001/correctness.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/48a49a52a0144683/search/attempt-001/warmup-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/48a49a52a0144683/search/attempt-001/sample-0.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/48a49a52a0144683/search/attempt-001/sample-1.log\", \"/gpfs/scratch/nimarano/hpc-forest-marathon22-deepseek-20261015-v11e-v4flash/results-747504/knn/logs/e1/48a49a52a0144683/search/attempt-001/sample-2.log\"], \"mean_seconds\": 0.02864815512051185, \"reason\": \"\", \"score\": 0.986501809043858, \"status\": \"valid\", \"times\": [0.029107761569321156, 0.02800301555544138, 0.028833688236773014], \"tree_hash\": \"e8cfed510284c3891f35d2cb110f60ce7c3eacc8\"}, \"raw_logs\": [{\"path\": \"logs/e1/48a49a52a0144683/search/attempt-001/correctness.log\", \"truncated\": false, \"runner_output\": {\"correct\": true, \"cases\": 4}}]}], \"own_role_history\": [{\"experiment_id\": \"0d7560b22c5f4455\", \"status\": \"valid\", \"score\": 0.9868608969115971, \"mean_seconds\": 0.02787589095532894, \"reason\": \"\"}, {\"experiment_id\": \"b15490a5b94e4732\", \"status\": \"incorrect\", \"score\": 0.0, \"mean_seconds\": null, \"reason\": \"Protected correctness checks failed\"}, {\"experiment_id\": \"48a49a52a0144683\", \"status\": \"valid\", \"score\": 0.986501809043858, \"mean_seconds\": 0.02864815512051185, \"reason\": \"\"}, {\"experiment_id\": \"f305bfd9be654258\", \"status\": \"valid\", \"score\": 0.9864700140556213, \"mean_seconds\": 0.028716561384499073, \"reason\": \"\"}, {\"experiment_id\": \"41c072f519a64028\", \"status\": \"build_failed\", \"score\": 0.0, \"mean_seconds\": null, \"reason\": \"Build failed or exceeded candidate timeout\"}, {\"experiment_id\": \"0854f1db0f074d46\", \"status\": \"valid\", \"score\": 0.9863788980630649, \"mean_seconds\": 0.028912619998057682, \"reason\": \"\"}, {\"experiment_id\": \"9cadb4567cbc46b7\", \"status\": \"valid\", \"score\": 0.9853696113472556, \"mean_seconds\": 0.031086775474250317, \"reason\": \"\"}, {\"experiment_id\": \"a03c01a4d8f042c7\", \"status\": \"valid\", \"score\": 0.9866588305990223, \"mean_seconds\": 0.02831039112061262, \"reason\": \"\"}, {\"experiment_id\": \"e5cacea750d24c29\", \"status\": \"valid\", \"score\": 0.9865801865725775, \"mean_seconds\": 0.028479546308517456, \"reason\": \"\"}, {\"experiment_id\": \"169e7827a92647fb\", \"status\": \"valid\", \"score\": 0.986738941792521, \"mean_seconds\": 0.02813810793062051, \"reason\": \"\"}, {\"experiment_id\": \"f27d2395228c4323\", \"status\": \"valid\", \"score\": 0.9864083655937578, \"mean_seconds\": 0.0288492093483607, \"reason\": \"\"}, {\"experiment_id\": \"652ff64654964bfc\", \"status\": \"incorrect\", \"score\": 0.0, \"mean_seconds\": null, \"reason\": \"Protected correctness checks failed\"}, {\"experiment_id\": \"85d35684357344d0\", \"status\": \"valid\", \"score\": 0.986583392205222, \"mean_seconds\": 0.028472650796175003, \"reason\": \"\"}, {\"experiment_id\": \"b016ee22b13045dd\", \"status\": \"incorrect\", \"score\": 0.0, \"mean_seconds\": null, \"reason\": \"Protected correctness checks failed\"}]}, \"documents_as_data\": [{\"id\": \"e0c98b85d7acd1601471\", \"title\": \"Official problem statement\", \"url\": \"http://lspd.mackenzie.br/marathon/22/problemset.pdf\", \"version\": \"downloaded-2026-10-15\", \"preconditions\": \"Official source material. Operator supplies execution only.\", \"excerpt\": \"=== PAGE 1 ===\\n17th Marathon of Parallel Programming\\nSBAC-PAD & WSCAD – 2022\\nCalebe Bianchini1 and Maur´ıcio Aronne Pillon2\\n1Mackenzie Presbyterian University\\n2Santa Catarina State University\\nRules for Remote Contest\\nFor all problems, read carefully the input and output session. For all problems, a sequen-\\ntial implementation is given, and it is against the output of those implementations that the\\noutput of your programs will be compared to decide if your implementation is correct.\\nYou can modify the program in any way you see fit, except when the problem descrip-\\ntion states otherwise. You must upload a compressed file (zip) with your source code, the\\nMakefile and an execution script. The script must have the name of the problem. You\\ncan submit as many solutions to a problem as you want. Only the last submission will\\nbe considered. The Makefile must have the rule all, which will be used to compile your\\nsource code. The execution script runs your solution the way you design it – it will be\\ninspected not to corrupt the target machine.\\nThe execution time of your program will be measured running it with time program and\\ntaking the real CPU time given. Each program will be executed at least three times with\\nthe same input and the mean time will be taken into account. The sequential program\\ngiven will be measured the same way. You will earn points in each problem, correspond-\\ning to the division of the sequential time by the time of your program (speedup). The\\nteam with the most points at the end of the marathon will be declared the winner.\\nThis problem set contains 4 problems; pages are numbered from 1 to 5.\\n\\n=== PAGE 2 ===\\nGeneral Information\\nCompilation\\nYou should use CC or CXX inside your Makefile. Be careful when redefining them!\\nThere is a simple Makefile inside you pr\", \"retrieval_relevance\": 161, \"evidence_type\": \"documentation\"}, {\"id\": \"4a7633ba1e00acfb3d75\", \"title\": \"TreeQuest AB-MCTS ask tell persistence\", \"url\": \"https://github.com/SakanaAI/treequest\", \"version\": \"0.3.2\", \"preconditions\": \"Use the pinned TreeQuest version; local trusted checkpoints only.\", \"excerpt\": \"AB-MCTS-A selects new proposals and continuations. Scores are normalized to [0,1]. Persist each role's state per epoch. Integration receives one measured full-program reward in G only. Keep provenance separate from the selected search parent.\", \"retrieval_relevance\": 3, \"evidence_type\": \"documentation\"}], \"deadline\": 1792100197.5313704, \"protocol_id\": \"ebd93f77a20dd00bbe612827c03cf5b6fc288f95db8d87258ef4cbbeac6006b6\", \"remaining_tokens\": 2734337, \"official_statement_as_data\": \"=== PAGE 1 ===\\n17th Marathon of Parallel Programming\\nSBAC-PAD & WSCAD – 2022\\nCalebe Bianchini1 and Maur´ıcio Aronne Pillon2\\n1Mackenzie Presbyterian University\\n2Santa Catarina State University\\nRules for Remote Contest\\nFor all problems, read carefully the input and output session. For all problems, a sequen-\\ntial implementation is given, and it is against the output of those implementations that the\\noutput of your programs will be compared to decide if your implementation is correct.\\nYou can modify the program in any way you see fit, except when the problem descrip-\\ntion states otherwise. You must upload a compressed file (zip) with your source code, the\\nMakefile and an execution script. The script must have the name of the problem. You\\ncan submit as many solutions to a problem as you want. Only the last submission will\\nbe considered. The Makefile must have the rule all, which will be used to compile your\\nsource code. The execution script runs your solution the way you design it – it will be\\ninspected not to corrupt the target machine.\\nThe execution time of your program will be measured running it with time program and\\ntaking the real CPU time given. Each program will be executed at least three times with\\nthe same input and the mean time will be taken into account. The sequential program\\ngiven will be measured the same way. You will earn points in each problem, correspond-\\ning to the division of the sequential time by the time of your program (speedup). The\\nteam with the most points at the end of the marathon will be declared the winner.\\nThis problem set contains 4 problems; pages are numbered from 1 to 5.\\n\\n=== PAGE 2 ===\\nGeneral Information\\nCompilation\\nYou should use CC or CXX inside your Makefile. Be careful when redefining them!\\nThere is a simple Makefile inside you problem package that you can modify. Example:\\nFLAGS=-O3\\nEXEC=sum\\nCXX=icpc\\nall: $(EXEC)\\n$(EXEC):\\n$(CXX) $(FLAGS) $(EXEC).cpp -c -o $(EXEC).o\\n$(CXX) $(FLAGS) $(EXEC).o -o $(EXEC)\\nEach judge machine has its group of compilers. See them below and choose well when\\nwriting your Makefile. The compiler that is tagged as default is predefined in CC and\\nCXX variables.\\nmachine compiler command\\nhost\\nGCC 12.2.0\\n(default)\\nC = gcc\\nC++ = g++\\nIntel C/C++ Compiler 19.1.3.304 C = icc\\nC++ = icpc\\nMPI\\nIntel MPI Compiler 2019u12\\n(default)\\nC = mpiicc\\nC++ = mpiicpc\\nIntel C/C++ Compiler 19.1.3.304 C = icc\\nC++ = icpc\\nGCC 12.2.0 C = gcc\\nC++ = g++\\ngpu\\nNVidia CUDA 11.6\\n(default)\\nC = nvcc\\nC++ = nvcc\\nGCC 8.3.1 C = gcc\\nC++ = g++\\nSubmitting\\nGeneral information\\nYou must have an execution script that has the same name of the problem. This script runs\\nyour solution the way you design it. There is a simple script inside you problem package\\nthat should be modified. Example:\\n#!/bin/bash\\n# This script runs a generic Problem A\\n# Using 32 threads and OpenMP\\nexport OMP_NUM_THREADS=32\\nOMP_NUM_THREADS=32 ./sum\\n\\n=== PAGE 3 ===\\nSubmitting MPI\\nIf you are planning to submit an MPI solution, you should compile usingmpiicc/mpiicpc.\\nThe script must call mpirun/mpiexec with the correct number of processes (max: 4). It\\nmust use a file called machines that are generated by the auto-judge system - do not\\ncreate it.\\n#!/bin/bash\\n# This script runs a generic Problem A\\n# Using MPI in the entire cluster (4 nodes)\\n# 'machines' file describes the nodes\\nmpirun -np 4 -machinefile machines ./sum\\nComparing times & results\\nIn your personal machine, measure the execution time of your solution using time pro-\\ngram. Add input/output redirection when collecting time. Use diff program to compare\\nthe original and your solution results. Example:\\n$ time -p ./A < original_input.txt > my_output.txt\\nreal 4.94\\nuser 0.08\\nsys 1.56\\n$ diff my_output.txt original_output.txt\\nDo not measure time and do not add input/output redirection when submitting your so-\\nlution - the auto-judge system is prepared to collect your time and compare the results.\\n\\n=== PAGE 4 ===\\nProblem A\\nk-Nearest Neighbors Classifier\\nGiven a set of two-dimensional points S divided intro n groups, an integer k and a two-\\ndimensional point P to be classified, the k-Nearest Neighbors (KNN) algorithm can be\\nused to solve the classification problem of the point P , i.e., classifying the point P into\\none of the n existing groups based on some criteria.\\nThe KNN algorithm works by comparing the distances from each point s ∈ S to the\\npoint P , then selecting the k points with the smallest distance values and counting the\\nfrequency of each group in these k points, the point P is then classified to belong to the\\ngroup with the highest frequency among the k nearest points.\\nFigure 1. Simple example of the KNN classification.\\nThe Figure 1 illustrates an example of the KNN classification algorithm being applied.\\nThe points have been segregated between 4 different groups ( i.e., A, B, C and D) and\\na point P with no group is provided to be classified, the KNN algorithm then searches\\nfor the k points closest to the point P and, after that, the groups have their frequencies\\ncounted, with the highest frequency being chosen as the classification ofP , in the case of\\nthis example, the point P is classified to belong to the group C.\\nInput\\nAn input represents the classification of a single point. The first line contains the pattern\\n”n groups=n”, where n is the total number of groups in this input. Then, for each of then\\ngroups the following lines will be provided, the first line has the pattern ”label=c” where\\nc is a single character that represents the label ( i.e., identification) of the group, then the\\nsecond line follows the pattern ”length= L”, where L is the number of two-dimensional\\npoints in this group and then, the next L lines contain the pattern ”(x,y)” that represents\\n1\\n\\n=== PAGE 5 ===\\neach point that belongs to the aforementioned group. After all groups have been repre-\\nsented there’s a single line with the pattern ”k= k”, where k is the parameter previously\\ndiscussed. Lastly, the final line also contains the pattern ”(x,y)”, representing the coordi-\\nnates to the two-dimensional point to be classified.\\nThe input must be read form the standard input.\\nOutput\\nThe output contains a single character, it being the label of the group chosen as the clas-\\nsification of the provided point.\\nThe output must be written to the standard output.\\nExample\\nInput example Output example\\nn groups=4 C\\nlabel=A\\nlength=3\\n(-3.55,-1.28)\\n(-3.99,-2.06)\\n(-3.23,-0.70)\\nlabel=B\\nlength=5\\n(-4.85,-1.65)\\n(-5.23,-2.22)\\n(-4.75,-3.89)\\n(-6.48,-2.41)\\n(-4.56,-2.29)\\nlabel=C\\nlength=4\\n(2.25,0.64)\\n(0.80,0.85)\\n(3.13,1.37)\\n(3.71,0.59)\\nlabel=D\\nlength=3\\n(-5.73,-2.65)\\n(-5.11,-4.41)\\n(-5.92,-3.06)\\nk=5\\n(-0.65,0.25)\\n2\\n\\n=== PAGE 6 ===\\nProblem B\\nSubmatrix of Maximum Sum\\nGiven a matrix M (with dimensions NxN) and an integer S, the objective is to find\\nthe SxS submatrix of M with maximum sum. A trivial algorithm to solve this problem\\nconsists in generating all (N − S + 1)2 such submatrices and, then, computing their sum\\n(the total time complexity would be, in the worst case, O((N − S)2S2 = O(N 2S2) )\\nThe proposed baseline algorithm (solution.cpp) employs a sliding window technique to\\nreduce this complexity to O(SN 2).\\nInput\\nThe input has only one test case. The first line contains two integers N and S (0 < S <\\nN < 8000). Then, there are N rows representing the matrix M. Each row contains N\\nintegers (with a whitespace after each one).\\nThe input must be read from the standard input.\\nOutput\\nThe output contains a single line. Print the sum of the SxS submatrix of M with maxi-\\nmum sum. It is guaranteed the result will fit a 32-bit signed integer.\\nThe output must be written to the standard output.\\nExample\\nInput Example Output example\\n5 3 51\\n3 6 7 5 3\\n5 6 2 9 1\\n2 7 0 9 3\\n6 0 6 2 6\\n1 8 7 9 2\\n3\\n\\n=== PAGE 7 ===\\nProblem C\\nN-body\\nAn n-body simulation models a dynamic system of particles, usually under the influence\\nof physical forces, predicting their individual motions. A well known application of n-\\nbody simulation is in astrophysics, where particles refer to celestial objects interacting\\nwith each other gravitationally. The provided serial code contains a simple, yet working,\\nn-body simulator for bodies moving through a 3 dimensional space. Your job is to create\\na parallel version of this n-body simulator, retaining the correctness of the solution.\\nInput\\nThe input consists of a binary file containing a structure with six float typed data items\\nfor each particle in the system. These six data items refer to the position of the particle in\\nthe x, y, and z axes, and the velocity of the particle in the x, y, and z axes.\\nThe input must be read form the standard input.\\nOutput\\nThe ouput is also a binary file, with the same format of the input file, containing the\\npositions and velocities of each particle in the x, y, and z axes.\\nThe output must be written to the standard output.\\nExample – in string form, just for readability purposes\\nInput example Output example\\n0.680375 -0.211234 0.566198\\n0.596880 0.823295 -0.604897\\n-0.329554 0.536459 -0.444451\\n0.107940 -0.045206 0.257742\\n-0.270431 0.026802 0.904459\\n0.832390 0.271423 0.434594\\n...\\n-5.184253 11.632033\\n-11.737427 -63.642937\\n146.243469 -147.690735\\n10.654608 -15.666613\\n15.572982 133.827255\\n-195.720352 194.728912\\n22.627201 -1.267884 -5.422720\\n283.039612 -15.879736\\n-67.786301\\n4\\n\\n=== PAGE 8 ===\\nProblem D\\nBucketsort\\nBucket sort or Binsort is a sorting algorithm. Its sorting strategy is to divide the numbers\\ninto ’buckets’ with a finite number of elements. The bucket’s advantage is its complexity\\n(O(n)), where ’n’ is the size of the array. However, linear complexity is only achieved\\nwhen the number is evenly distributed.\\nInput\\nAn input has 2 parts: the parameters and the data. The first four numbers are string length,\\narray size, offset, and bucket number. The remaining parameters are integer numbers to\\norder.\\nThe input must be read form the standard input.\\nOutput\\nThe output contains only the sorted integers.\\nThe output must be written to the standard output.\\nExample\\nInput example Output example\\n5\\n100000\\n48\\n9\\n99997 99996 99995 99994 99993\\n99992 99991 99990 99989 99988\\n99987 99986 ...\\n00000 00001 00002 00003 00004\\n00005 00006 00007 00008 00009\\n00010 00011 ...\\n5\", \"runtime_as_data\": {\"cpu_cores\": 4, \"OMP_NUM_THREADS\": 4, \"architecture\": \"ARM64\", \"candidate_GPU\": false, \"comparison\": \"Exact output bytes against official reference\"}}, \"required_json_schema\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"hypothesis\": {\"type\": \"string\"}, \"transformations\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"sources_kept\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"enum\": [\"11cd5b5226c14303\", \"d19340a2f7504842\", \"1540653195424c7a\"]}, \"uniqueItems\": true}, \"files\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"path\": {\"type\": \"string\"}, \"content\": {\"type\": \"string\"}}, \"required\": [\"path\", \"content\"]}}, \"notes\": {\"type\": \"string\"}}, \"required\": [\"hypothesis\", \"transformations\", \"sources_kept\", \"files\", \"notes\"]}}\n\nCURRENT SOURCE AS DATA:\n\n--- BEGIN FILE src/knn.c ---\n#include \"knn.h\"\n#include <arm_neon.h>\n#include <omp.h>\n#include <float.h>\n\n// Max-heap node (1-indexed)\ntypedef struct {\n    float dist;\n    char label;\n} HeapNode;\n\nstatic inline void heap_swap(HeapNode *a, HeapNode *b) {\n    HeapNode t = *a; *a = *b; *b = t;\n}\n\n// Sift down from index idx in a max-heap of size heap_size (1-indexed)\nstatic inline void sift_down(HeapNode *heap, int heap_size, int idx) {\n    while (1) {\n        int largest = idx;\n        int left = 2 * idx;\n        int right = 2 * idx + 1;\n        if (left <= heap_size && heap[left].dist > heap[largest].dist)\n            largest = left;\n        if (right <= heap_size && heap[right].dist > heap[largest].dist)\n            largest = right;\n        if (largest == idx) break;\n        heap_swap(&heap[idx], &heap[largest]);\n        idx = largest;\n    }\n}\n\n// Insert or replace in a max-heap of capacity k.\nstatic inline void heap_insert_or_replace(float d, char label,\n                                          HeapNode *heap, int *heap_size_ptr, int k) {\n    int hs = *heap_size_ptr;\n    if (hs < k) {\n        // Insert at end and bubble up\n        hs++;\n        int idx = hs;\n        heap[idx].dist = d;\n        heap[idx].label = label;\n        while (idx > 1 && heap[idx / 2].dist < heap[idx].dist) {\n            heap_swap(&heap[idx], &heap[idx / 2]);\n            idx /= 2;\n        }\n    } else if (d < heap[1].dist) {\n        // Replace root\n        heap[1].dist = d;\n        heap[1].label = label;\n        sift_down(heap, k, 1);\n    }\n    *heap_size_ptr = hs;\n}\n\n// Comparison function for qsort (signed char ordering)\nstatic int cmp_char(const void *a, const void *b) {\n    return *(const signed char *)a - *(const signed char *)b;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    // Determine number of threads once (outside parallel region)\n    int max_threads = omp_get_max_threads();\n    if (max_threads < 1) max_threads = 1;\n\n    // Per-thread heaps: each thread gets a heap array of size k+1 and its current size.\n    HeapNode **thread_heaps = (HeapNode**) malloc(max_threads * sizeof(HeapNode*));\n    int *thread_sizes = (int*) calloc(max_threads, sizeof(int));\n\n    for (int t = 0; t < max_threads; t++) {\n        thread_heaps[t] = (HeapNode*) malloc((k + 1) * sizeof(HeapNode));\n        // Initialize with sentinel values: large distance and invalid label.\n        for (int i = 1; i <= k; i++) {\n            thread_heaps[t][i].dist = FLT_MAX;\n            thread_heaps[t][i].label = -1;\n        }\n    }\n\n    #pragma omp parallel\n    {\n        int tid = omp_get_thread_num();\n        HeapNode *local_heap = thread_heaps[tid];\n        int local_size = 0;   // persistent across iterations for this thread\n\n        #pragma omp for schedule(guided)\n        for (int gi = 0; gi < n_groups; gi++) {\n            Group g = groups[gi];\n            float *xs = g.xs;\n            float *ys = g.ys;\n            int len = g.length;\n            char label = g.label;\n\n            // Process points in batches of 4 using NEON SIMD\n            int j = 0;\n            for (; j + 3 < len; j += 4) {\n                float32x4_t x_vec = vld1q_f32(xs + j);\n                float32x4_t y_vec = vld1q_f32(ys + j);\n\n                float tx = to_evaluate.x;\n                float ty = to_evaluate.y;\n                float32x4_t dx = vsubq_f32(x_vec, vdupq_n_f32(tx));\n                float32x4_t dy = vsubq_f32(y_vec, vdupq_n_f32(ty));\n                // dist_sq = dx*dx + dy*dy\n                float32x4_t dist_sq = vmlaq_f32(vmulq_f32(dx, dx), dy, dy);\n\n                float d[4];\n                vst1q_f32(d, dist_sq);\n\n                for (int t = 0; t < 4; t++) {\n                    heap_insert_or_replace(d[t], label, local_heap, &local_size, k);\n                }\n            }\n\n            // Scalar remainder\n            for (; j < len; j++) {\n                Point p;\n                p.x = xs[j];\n                p.y = ys[j];\n                float d = euclidean_distance_no_sqrt(to_evaluate, p);\n                heap_insert_or_replace(d, label, local_heap, &local_size, k);\n            }\n        }\n\n        thread_sizes[tid] = local_size;\n    } // end parallel region\n\n    // Global max-heap to merge per-thread results\n    HeapNode *global_heap = (HeapNode*) malloc((k + 1) * sizeof(HeapNode));\n    for (int i = 1; i <= k; i++) {\n        global_heap[i].dist = FLT_MAX;\n        global_heap[i].label = -1;\n    }\n    int global_size = 0;\n\n    // Merge all per-thread heaps into the global heap\n    for (int t = 0; t < max_threads; t++) {\n        HeapNode *local = thread_heaps[t];\n        int sz = thread_sizes[t];\n        if (sz > k) sz = k;\n        for (int i = 1; i <= sz; i++) {\n            heap_insert_or_replace(local[i].dist, local[i].label,\n                                   global_heap, &global_size, k);\n        }\n    }\n\n    // Extract labels from the final global heap into a plain array for frequency counting.\n    char *labels = (char*) malloc(k * sizeof(char));\n    int actual_k = (global_size < k) ? global_size : k;\n    for (int i = 0; i < actual_k; i++) {\n        labels[i] = global_heap[i + 1].label;\n    }\n    // Fill remaining with -1 if not enough points\n    for (int i = actual_k; i < k; i++) {\n        labels[i] = -1;\n    }\n\n    free(global_heap);\n    for (int t = 0; t < max_threads; t++) {\n        free(thread_heaps[t]);\n    }\n    free(thread_heaps);\n    free(thread_sizes);\n\n    // Sort labels to match baseline tie-breaking behavior\n    qsort(labels, k, sizeof(char), cmp_char);\n\n    // Find most frequent label using linear scan (strictly greater)\n    char best_label = labels[0];\n    int best_count = 1;\n    int current_count = 1;\n    for (int i = 1; i < k; i++) {\n        if (labels[i] == labels[i - 1]) {\n            current_count++;\n        } else {\n            if (current_count > best_count) {\n                best_count = current_count;\n                best_label = labels[i - 1];\n            }\n            current_count = 1;\n        }\n    }\n    // Handle last group\n    if (current_count > best_count) {\n        best_label = labels[k - 1];\n    }\n\n    free(labels);\n    return best_label;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n\n    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; ++i) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n\n--- END FILE src/knn.c ---\n\n--- BEGIN FILE src/knn.h ---\n#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    float *xs;   // array of x coordinates\n    float *ys;   // array of y coordinates\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2) on_error();\n    Point point;\n    point.x = x;\n    point.y = y;\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.xs = (float *)malloc(sizeof(float) * length);\n    group.ys = (float *)malloc(sizeof(float) * length);\n\n    for (int i = 0; i < length; i++) {\n        Point p = parse_point();\n        group.xs[i] = p.x;\n        group.ys[i] = p.y;\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt(Point a, Point b) {\n    float dx = b.x - a.x;\n    float dy = b.y - a.y;\n    return dx * dx + dy * dy;\n}\n\n--- END FILE src/knn.h ---\n"
    }
  ],

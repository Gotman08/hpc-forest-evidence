n vsubq_u32(sum, vandq_u32(vcgeq_u32(sum, modulus), modulus));\\n+}\\n+\\n+static inline uint32x4_t prefix_mod4(uint32x4_t values) {\\n+    const uint32x4_t zero = vdupq_n_u32(0);\\n+    values = add_mod4(values, vextq_u32(zero, values, 3));\\n+    return add_mod4(values, vextq_u32(zero, values, 2));\\n+}\\n+#endif\\n \\n+static inline int advance_segment(int* row, int first, int last, int left) {\\n+    if (first >= last) return left;\\n+    int x = first;\\n+#if defined(__aarch64__)\\n+    uint32x4_t carry = vdupq_n_u32(static_cast<uint32_t>(left));\\n+    for (; x + 8 <= last; x += 8) {\\n+        uint32x4_t low = prefix_mod4(vld1q_u32(\\n+            reinterpret_cast<const uint32_t*>(row + x)));\\n+        uint32x4_t high = prefix_mod4(vld1q_u32(\\n+            reinterpret_cast<const uint32_t*>(row + x + 4)));\\n+        high = add_mod4(high, vdupq_laneq_u32(low, 3));\\n+        low = add_mod4(low, carry);\\n+        high = add_mod4(high, carry);\\n+        vst1q_u32(reinterpret_cast<uint32_t*>(row + x), low);\\n+        vst1q_u32(reinterpret_cast<uint32_t*>(row + x + 4), high);\\n+        carry = vdupq_laneq_u32(high, 3);\\n+    }\\n+    left = static_cast<int>(vgetq_lane_u32(carry, 0));\\n+#endif\\n+    for (; x < last; ++x) {\\n+        left = add_mod(row[x], left);\\n+        row[x] = left;\\n+    }\\n+    return left;\\n+}\\n \\n int main() {\\n-\\tint n,m;\\n-\\tcin >> n >> m;\\n-\\tvector<vector<bool> >  blockedCells(n, vector<bool>(n,false));\\n-\\tfor(int c =0;c<m;c++) {\\n-\\t\\tint i,j;\\n-\\t\\tcin >> i >> j;\\n-\\t\\tblockedCells[i][j] = true;\\t\\t\\n-\\t}\\n-\\n-\\tvector<vector<int> > dp(2,vector<int>(n,0));\\n-\\n-\\tif(!blockedCells[0][0])\\n-\\t\\tdp[0][0] = 1;\\n-\\n-\\tfor(int j=1;j<n;j++) if(!blockedCells[0][j]) dp[0][j] = dp[0][j-1];\\n-\\tdp[1][n-1] = dp[0][n-1];\\n-\\n-\\tfor(int i=1;i<n;i++) {\\n-\\t\\tfor(int j=0;j<n;j++) {\\n-\\t\\t\\tint ans = 0;\\n-\\t\\t\\tif(!blockedCells[i][j]) {\\t\\t\\t\\t\\n-\\t\\t\\t\\tans = dp[0][j];\\n-\\t\\t\\t\\tif(j!=0) ans += dp[1][j-1];\\n-\\t\\t\\t}\\n-\\n-\\t\\t\\tdp[1][j] = ans% MOD;\\n-\\t\\t}\\n-\\t\\tfor(int j=0;j<n;j++) dp[0][j] = dp[1][j];\\n-\\t}\\n-\\n-\\t\\n-\\tcout << dp[1][n-1] << endl;\\n-}\\n\\\\ No newline at end of file\\n+    ios::sync_with_stdio(false);\\n+    cin.tie(nullptr);\\n+\\n+    int n, m;\\n+    if (!(cin >> n >> m)) return 0;\\n+    const int tiles = (n + TILE - 1) / TILE;\\n+\\n+    // Sort obstacles by tile wavefront, tile row, and local cell.\\n+    vector<uint64_t> blocked;\\n+    blocked.reserve(static_cast<size_t>(m));\\n+    for (int k = 0; k < m; ++k) {\\n+        int r, c;\\n+        cin >> r >> c;\\n+        const int tr = r / TILE;\\n+        const int tc = c / TILE;\\n+        const uint64_t key = static_cast<uint64_t>(tr + tc) * tiles + tr;\\n+        const uint64_t local = (r % TILE) * TILE + c % TILE;\\n+        blocked.push_back((key << LOCAL_BITS) | local);\\n+    }\\n+    sort(blocked.begin(), blocked.end());\\n+    blocked.erase(unique(blocked.begin(), blocked.end()), blocked.end());\\n+\\n+    // Retain one bottom boundary per tile column and one right boundary\\n+    // per tile row. Tiles on a wavefront access disjoint boundary slices.\\n+    vector<int> bottom(n, 0);\\n+    vector<int> right(n, 0);\\n+    bottom[0] = 1;\\n+\\n+    #pragma omp parallel if (n >= 1024)\\n+    {\\n+        alignas(64) int values[TILE];\\n+        for (int diagonal = 0; diagonal < 2 * tiles - 1; ++diagonal) {\\n+            const int first = max(0, diagonal - tiles + 1);\\n+            const int last = min(tiles - 1, diagonal);\\n+\\n+            #pragma omp for schedule(static)\\n+            for (int tr = first; tr <= last; ++tr) {\\n+                const int tc = diagonal - tr;\\n+                const int row_start = tr * TILE;\\n+                const int column_start = tc * TILE;\\n+                const int height = min(TILE, n - row_start);\\n+                const int width = min(TILE, n - column_start);\\n+               
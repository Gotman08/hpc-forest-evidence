{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <iostream>\\n#include <vector>\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\nusing namespace std;\\n\\nconst int MOD = 1000000007;\\n\\nstatic inline int addMod(int a, int b) {\\n    const int sum = a + b;\\n    return sum >= MOD ? sum - MOD : sum;\\n}\\n\\nint main() {\\n    ios::sync_with_stdio(false);\\n    cin.tie(nullptr);\\n\\n    int n, m;\\n    cin >> n >> m;\\n    vector<vector<bool>> blockedCells(n, vector<bool>(n, false));\\n    for (int c = 0; c < m; ++c) {\\n        int i, j;\\n        cin >> i >> j;\\n        blockedCells[i][j] = true;\\n    }\\n\\n    vector<int> dp(n, 0);\\n    if (!blockedCells[0][0]) dp[0] = 1;\\n    for (int j = 1; j < n; ++j) {\\n        dp[j] = blockedCells[0][j] ? 0 : dp[j - 1];\\n    }\\n\\n#ifdef _OPENMP\\n    if (n >= 4096) {\\n        const int maxThreads = omp_get_max_threads();\\n        vector<int> localEnd(maxThreads);\\n        vector<int> incoming(maxThreads);\\n        vector<int> firstBlocked(maxThreads);\\n        vector<unsigned char> hasBlocked(maxThreads);\\n        int activeThreads = 1;\\n\\n#pragma omp parallel shared(activeThreads, localEnd, incoming, firstBlocked, hasBlocked, dp, blockedCells)\\n        {\\n            const int tid = omp_get_thread_num();\\n            const int threadCount = omp_get_num_threads();\\n\\n#pragma omp single\\n            activeThreads = threadCount;\\n\\n            for (int i = 1; i < n; ++i) {\\n                const int lo = static_cast<int>((static_cast<long long>(n) * tid) / threadCount);\\n                const int hi = static_cast<int>((static_cast<long long>(n) * (tid + 1)) / threadCount);\\n                int value = 0;\\n                int first = hi;\\n                bool seenBlocked = false;\\n\\n                for (int j = lo; j < hi; ++j) {\\n                    if (blockedCells[i][j]) {\\n                        dp[j] = 0;\\n                        if (!seenBlocked) first = j;\\n                        seenBlocked = true;\\n                        value = 0;\\n                    } else {\\n                        value = addMod(value, dp[j]);\\n                        dp[j] = value;\\n                    }\\n                }\\n\\n                localEnd[tid] = value;\\n                firstBlocked[tid] = first;\\n                hasBlocked[tid] = static_cast<unsigned char>(seenBlocked);\\n\\n#pragma omp barrier\\n#pragma omp single\\n                {\\n                    int prefix = 0;\\n                    for (int t = 0; t < activeThreads; ++t) {\\n                        incoming[t] = prefix;\\n                        prefix = hasBlocked[t] ? localEnd[t] : addMod(prefix, localEnd[t]);\\n                    }\\n                }\\n\\n                const int offset = incoming[tid];\\n                for (int j = lo; j < firstBlocked[tid]; ++j) {\\n                    dp[j] = addMod(dp[j], offset);\\n                }\\n\\n#pragma omp barrier\\n            }\\n        }\\n    } else\\n#endif\\n    {\\n        for (int i = 1; i < n; ++i) {\\n            for (int j = 0; j < n; ++j) {\\n                if (blockedCells[i][j]) {\\n                    dp[j] = 0;\\n                } else if (j != 0) {\\n                    dp[j] = addMod(dp[j], dp[j - 1]);\\n                }\\n            }\\n        }\\n    }\\n\\n    cout << dp[n - 1] << '\\\\n';\\n    return 0;\\n}\\n\",\"path\":\"src/solution.cpp\"}],\"hypothesis\":\"Retaining the fastest measured complete implementation should provide the best whole-program result: its in-place DP removes copy-back traffic, and its thresholded segmented-prefix OpenMP scan parallelizes the row dependency without races on large grids.\",\"notes\":\"Selected the fastest validated archived full program rather than combining independently beneficial but representation-incompatible changes.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[\"583a951e221b489e\"],\"transformations\":[\"Use a single in-place DP row with conditional modular addition.\",\"For large rows under OpenMP, compute contiguous segmented-prefix chunks independently, scan chunk summaries, then apply incoming prefixes in parallel.\"]}"}}

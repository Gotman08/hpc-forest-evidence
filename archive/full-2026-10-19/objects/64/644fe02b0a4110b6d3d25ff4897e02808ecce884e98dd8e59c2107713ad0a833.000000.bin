{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <stdint.h>\\n#include <limits.h>\\n\\nenum {\\n    RUN_SIZE = 4096,\\n    INSERTION_SIZE = 24,\\n    PARALLEL_SIZE = 32768\\n};\\n\\nstatic void fail(const char *message) {\\n    fputs(message, stderr);\\n    fputc('\\\\n', stderr);\\n    exit(EXIT_FAILURE);\\n}\\n\\nstatic const char *key_at(const char *strings, size_t stride, long int index) {\\n    return strings + (size_t)index * stride;\\n}\\n\\nstatic void sort_run(const char *strings, size_t stride,\\n                     long int *source, long int *destination,\\n                     size_t first, size_t last) {\\n    size_t count = last - first;\\n    if (count <= INSERTION_SIZE) {\\n        memcpy(destination + first, source + first,\\n               count * sizeof(*destination));\\n        for (size_t j = first + 1; j < last; ++j) {\\n            long int key = destination[j];\\n            const char *text = key_at(strings, stride, key);\\n            size_t i = j;\\n            while (i > first &&\\n                   strcmp(key_at(strings, stride, destination[i - 1]), text) > 0) {\\n                destination[i] = destination[i - 1];\\n                --i;\\n            }\\n            destination[i] = key;\\n        }\\n        return;\\n    }\\n\\n    size_t middle = first + count / 2;\\n    sort_run(strings, stride, destination, source, first, middle);\\n    sort_run(strings, stride, destination, source, middle, last);\\n\\n    if (strcmp(key_at(strings, stride, source[middle - 1]),\\n               key_at(strings, stride, source[middle])) <= 0) {\\n        memcpy(destination + first, source + first,\\n               count * sizeof(*destination));\\n        return;\\n    }\\n\\n    size_t left = first;\\n    size_t right = middle;\\n    size_t output = first;\\n    while (left < middle && right < last) {\\n        if (strcmp(key_at(strings, stride, source[left]),\\n                   key_at(strings, stride, source[right])) <= 0) {\\n            destination[output++] = source[left++];\\n        } else {\\n            destination[output++] = source[right++];\\n        }\\n    }\\n    if (left < middle) {\\n        memcpy(destination + output, source + left,\\n               (middle - left) * sizeof(*destination));\\n    } else if (right < last) {\\n        memcpy(destination + output, source + right,\\n               (last - right) * sizeof(*destination));\\n    }\\n}\\n\\n/* Find how many left-run elements precede an output rank. */\\nstatic size_t merge_rank(const char *strings, size_t stride,\\n                         const long int *source,\\n                         size_t first, size_t middle, size_t last,\\n                         size_t rank) {\\n    size_t left_count = middle - first;\\n    size_t right_count = last - middle;\\n    size_t low = rank > right_count ? rank - right_count : 0;\\n    size_t high = rank < left_count ? rank : left_count;\\n\\n    while (low < high) {\\n        size_t left = low + (high - low) / 2;\\n        size_t right = rank - left;\\n        /* Equal keys from the left run precede those from the right. */\\n        if (right > 0 && left < left_count &&\\n            strcmp(key_at(strings, stride, source[first + left]),\\n                   key_at(strings, stride, source[middle + right - 1])) <= 0) {\\n            low = left + 1;\\n        } else {\\n            high = left;\\n        }\\n    }\\n    return low;\\n}\\n\\nstatic void merge_tile(const char *strings, size_t stride,\\n                       const long int *source, long int *destination,\\n                       size_t n, size_t width, size_t tile) {\\n    size_t output = tile * (size_t)RUN_SIZE;\\n    size_t stop = output + RUN_SIZE;\\n    if (stop > n) stop = n;\\n\\n    size_t span = width * 2;\\n    size_t first = (output / span) * span;\\n    size_t middle = first + width;\\n    size_t last = first + span;\\n    if (middle > n) middle = n;\\n    if (last > n) last = n;\\n\\n    if (middle == last ||\\n        strcmp(key_at(strings, stride, source[middle - 1]),\\n               key_at(strings, stride, source[middle])) <= 0) {\\n        memcpy(destination + output, source + output,\\n               (stop - output) * sizeof(*destination));\\n        return;\\n    }\\n\\n    size_t rank = output - first;\\n    size_t taken_left = merge_rank(strings, stride, source,\\n                                   first, middle, last, rank);\\n    size_t left = first + taken_left;\\n    size_t right = middle + (rank - taken_left);\\n\\n    while (output < stop && left < middle && right < last) {\\n        if (strcmp(key_at(strings, stride, source[left]),\\n                   key_at(strings, stride, source[right])) <= 0) {\\n            destination[output++] = source[left++];\\n        } else {\\n            destination[output++] = source[right++];\\n        }\\n    }\\n    if (output < stop) {\\n        size_t remaining = left < middle ? left : right;\\n        memcpy(destination + output, source + remaining,\\n               (stop - output) * sizeof(*destination));\\n    }\\n}\\n\\nlong int *bucket_sort(char *a, int length, long int size,\\n                      int offset, int nbuckets) {\\n    (void)offset;\\n    (void)nbuckets;\\n    if (size < 0 || length <= 0) fail(\\\"ERROR sort dimensions\\\");\\n\\n    size_t n = (size_t)size;\\n    size_t stride = (size_t)length;\\n    if (n > SIZE_MAX / sizeof(long int) || n > SIZE_MAX / stride)\\n        fail(\\\"ERROR sort size\\\");\\n    if (n == 0) return NULL;\\n\\n    long int *index = malloc(n * sizeof(*index));\\n    if (index == NULL) fail(\\\"ERROR index allocation\\\");\\n    if (n == 1) {\\n        index[0] = 0;\\n        return index;\\n    }\\n\\n    long int *scratch = malloc(n * sizeof(*scratch));\\n    if (scratch == NULL) {\\n        free(index);\\n        fail(\\\"ERROR scratch allocation\\\");\\n    }\\n\\n    size_t tiles = n / RUN_SIZE + (n % RUN_SIZE != 0);\\n    long int *result = index;\\n#ifdef _OPENMP\\n#pragma omp parallel if (n >= PARALLEL_SIZE)\\n#endif\\n    {\\n        long int *source = index;\\n        long int *destination = scratch;\\n\\n#ifdef _OPENMP\\n#pragma omp for schedule(static)\\n#endif\\n        for (size_t tile = 0; tile < tiles; ++tile) {\\n            size_t first = tile * (size_t)RUN_SIZE;\\n            size_t last = first + RUN_SIZE;\\n            if (last > n) last = n;\\n            for (size_t i = first; i < last; ++i) {\\n                index[i] = (long int)i;\\n                scratch[i] = (long int)i;\\n            }\\n\\n            size_t check = first + 1;\\n            while (check < last &&\\n                   strcmp(key_at(a, stride, index[check - 1]),\\n                          key_at(a, stride, index[check])) <= 0) {\\n                ++check;\\n            }\\n            if (check < last)\\n                sort_run(a, stride, scratch, index, first, last);\\n        }\\n\\n        for (size_t width = RUN_SIZE; width < n; ) {\\n#ifdef _OPENMP\\n#pragma omp for schedule(static)\\n#endif\\n            for (size_t tile = 0; tile < tiles; ++tile) {\\n                merge_tile(a, stride, source, destination, n, width, tile);\\n            }\\n            long int *swap = source;\\n            source = destination;\\n            destination = swap;\\n            width = width > n / 2 ? n : width * 2;\\n        }\\n\\n#ifdef _OPENMP\\n#pragma omp single nowait\\n#endif\\n        {\\n            result = source;\\n        }\\n    }\\n\\n    free(result == index ? scratch : index);\\n    return result;\\n}\\n\\nvoid load(char **vString, long int *N, int *l, int *os, int *nb) {\\n    int len, offset, nbucket;\\n    long int n;\\n\\n    if (fscanf(stdin, \\\"%d\\\", &len) != 1 || len <= 0 || len == INT_MAX)\\n        fail(\\\"ERROR len\\\");\\n    if (fscanf(stdin, \\\"%ld\\\", &n) != 1 || n < 0)\\n        fail(\\\"ERROR n\\\");\\n    if (fscanf(stdin, \\\"%d\\\", &offset) != 1)\\n        fail(\\\"ERROR offset\\\");\\n    if (fscanf(stdin, \\\"%d\\\", &nbucket) != 1 ||\\n        nbucket < 0 || nbucket == INT_MAX)\\n        fail(\\\"ERROR nbucket\\\");\\n\\n    size_t stride = (size_t)len + 1;\\n    if ((size_t)n > SIZE_MAX / stride) fail(\\\"ERROR input size\\\");\\n    size_t bytes = (size_t)n * stride;\\n    char *strings = malloc(bytes == 0 ? 1 : bytes);\\n    if (strings == NULL) fail(\\\"ERROR input allocation\\\");\\n\\n    char token_format[32];\\n    snprintf(token_format, sizeof(token_format), \\\"%%%ds\\\", len);\\n    for (long int i = 0; i < n; ++i) {\\n        if (fscanf(stdin, token_format, strings + (size_t)i * stride) != 1) {\\n            free(strings);\\n            fail(\\\"ERROR token\\\");\\n        }\\n    }\\n\\n    *vString = strings;\\n    *N = n;\\n    *l = len + 1;\\n    *os = offset;\\n    *nb = nbucket + 1;\\n}\\n\\nvoid print(char *strings, long int *index, long int n, int len) {\\n    for (long int i = 0; i < n; ++i)\\n        printf(\\\"%ld -> %s\\\\n\\\", i, key_at(strings, (size_t)len, index[i]));\\n}\\n\\nvoid save(char *strings, long int *index, long int n, int len) {\\n    for (long int i = 0; i < n; ++i)\\n        printf(\\\"%s\\\\n\\\", key_at(strings, (size_t)len, index[i]));\\n}\\n\\nint main(void) {\\n    char *strings = NULL;\\n    long int N = 0;\\n    int len = 0, offset = 0, nbuckets = 0;\\n\\n    load(&strings, &N, &len, &offset, &nbuckets);\\n    long int *index = bucket_sort(strings, len, N, offset, nbuckets);\\n    save(strings, index, N, len);\\n\\n    free(index);\\n    free(strings);\\n    return EXIT_SUCCESS;\\n}\\n\",\n      \"path\": \"src/bucketsort.c\"\n    }\n  ],\n  \"hypothesis\": \"A tiled OpenMP index mergesort should exploit four cores even for skewed inputs and final merge rounds, without per-element synchronization or quadratic bucket sorting.\",\n  \"notes\": \"Preserves strcmp ordering, token bytes, leading zeroes and one newline per output token. Formatted I/O remains unchanged in strategy. OpenMP uses the configured team size, with a serial fallback when unavailable. No commands or measurements were run.\",\n  \"research\": {\n    \"queries\": [],\n    \"urls\": []\n  },\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Replace fixed-capacity bucket slices and insertion sorting with distribution-independent stable index mergesort and per-call scratch storage.\",\n    \"Use one persistent OpenMP team, statically scheduled 4096-element runs, and binary co-ranking to partition every merge into disjoint output tiles, including the final merge.\",\n    \"Avoid parallel startup below 32768 elements; retain formatted I/O while adding checked allocations, bounded token reads and appropriately sized indices.\"\n  ]\n}"}}

#define _POSIX_C_SOURCE 200809L

#include <ctype.h>
#include <errno.h>
#include <limits.h>
#include <math.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/types.h>

#if defined(__aarch64__) || defined(__ARM_NEON)
#include <arm_neon.h>
#define GRAPH_HAVE_NEON 1
#else
#define GRAPH_HAVE_NEON 0
#endif

typedef struct {
  int id;
  float value;
  size_t edge_begin;
  size_t edge_count;
} Node;

typedef struct {
  char *text;
  int id;
} Query;

typedef struct {
  int key;
  int index;
} IdSlot;

typedef struct {
  IdSlot *slots;
  size_t mask;
} IdMap;

static void fail(void)
{
  fputs("Error!\n", stderr);
  exit(1);
}

static void *xmalloc(size_t bytes)
{
  void *pointer = malloc(bytes == 0 ? 1 : bytes);

  if (pointer == NULL)
    fail();

  return pointer;
}

static void *xrealloc(void *pointer, size_t bytes)
{
  void *resized = realloc(pointer, bytes == 0 ? 1 : bytes);

  if (resized == NULL)
    fail();

  return resized;
}

static void *xalloc_array(size_t count, size_t item_size)
{
  if (count != 0 && item_size > SIZE_MAX / count)
    fail();

  return xmalloc(count * item_size);
}

static void *xcalloc_array(size_t count, size_t item_size)
{
  if (count == 0)
    return xmalloc(1);
  if (item_size > SIZE_MAX / count)
    fail();

  void *pointer = calloc(count, item_size);
  if (pointer == NULL)
    fail();

  return pointer;
}

static char *skip_space(char *cursor)
{
  while (*cursor != '\0' && isspace((unsigned char)*cursor))
    ++cursor;
  return cursor;
}

static void strip_linefeed(char *line)
{
  char *linefeed = strchr(line, '\n');

  if (linefeed != NULL)
    *linefeed = '\0';
}

static int take_int(char **cursor, int *value)
{
  char *start = skip_space(*cursor);
  char *end;
  long parsed;

  if (*start == '\0') {
    *cursor = start;
    return 0;
  }

  errno = 0;
  parsed = strtol(start, &end, 10);
  if (end == start || errno == ERANGE || parsed < (long)INT_MIN ||
      parsed > (long)INT_MAX)
    return 0;

  *cursor = end;
  *value = (int)parsed;
  return 1;
}

static int take_float(char **cursor, float *value)
{
  char *start = skip_space(*cursor);
  char *end;
  float parsed;

  if (*start == '\0') {
    *cursor = start;
    return 0;
  }

  parsed = strtof(start, &end);
  if (end == start)
    return 0;

  *cursor = end;
  *value = parsed;
  return 1;
}

static void append_edge(int **items, size_t *count, size_t *capacity, int value)
{
  if (*count == SIZE_MAX)
    fail();

  if (*count == *capacity) {
    size_t new_capacity = *capacity == 0 ? 64 : *capacity;

    if (*capacity != 0) {
      if (new_capacity > SIZE_MAX / 2)
        fail();
      new_capacity *= 2;
    }
    if (new_capacity > SIZE_MAX / sizeof **items)
      fail();

    *items = xrealloc(*items, new_capacity * sizeof **items);
    *capacity = new_capacity;
  }

  (*items)[*count] = value;
  *count += 1;
}

static void append_query(Query **items, size_t *count, size_t *capacity,
                         const char *text, size_t length, int id)
{
  if (*count == SIZE_MAX || length == SIZE_MAX)
    fail();

  if (*count == *capacity) {
    size_t new_capacity = *capacity == 0 ? 16 : *capacity;

    if (*capacity != 0) {
      if (new_capacity > SIZE_MAX / 2)
        fail();
      new_capacity *= 2;
    }
    if (new_capacity > SIZE_MAX / sizeof **items)
      fail();

    *items = xrealloc(*items, new_capacity * sizeof **items);
    *capacity = new_capacity;
  }

  char *copy = xalloc_array(length + 1, sizeof *copy);
  memcpy(copy, text, length);
  copy[length] = '\0';

  (*items)[*count].text = copy;
  (*items)[*count].id = id;
  *count += 1;
}

static Node *read_graph(int *node_count, Query **queries,
                        size_t *query_count, int **edge_ids,
                        size_t *edge_count)
{
  char *line = NULL;
  size_t line_capacity = 0;
  Query *query_items = NULL;
  size_t queries_used = 0;
  size_t queries_capacity = 0;
  int *edges = NULL;
  size_t edges_used = 0;
  size_t edges_capacity = 0;
  int n;

  if (getline(&line, &line_capacity, stdin) < 0)
    fail();
  strip_linefeed(line);

  char *cursor = line;
  if (!take_int(&cursor, &n) || n < 0)
    fail();

  /* fscanf's whitespace before %[^
] is consumed before strtok sees it. */
  cursor = skip_space(cursor);
  while (*cursor != '\0') {
    while (*cursor == ' ')
      ++cursor;
    if (*cursor == '\0')
      break;

    char *token = cursor;
    while (*cursor != '\0' && *cursor != ' ')
      ++cursor;

    char saved = *cursor;
    *cursor = '\0';
    append_query(&query_items, &queries_used, &queries_capacity, token,
                 (size_t)(cursor - token), atoi(token));
    *cursor = saved;
  }

  Node *nodes = n == 0 ? NULL : xalloc_array((size_t)n, sizeof *nodes);

  for (int index = 0; index < n; ++index) {
    int node_id;
    float node_value;

    if (getline(&line, &line_capacity, stdin) < 0)
      fail();
    strip_linefeed(line);

    cursor = line;
    if (!take_int(&cursor, &node_id) || !take_float(&cursor, &node_value))
      fail();

    nodes[index].id = node_id;
    nodes[index].value = node_value;
    nodes[index].edge_begin = edges_used;
    nodes[index].edge_count = 0;

    cursor = skip_space(cursor);
    while (*cursor != '\0') {
      while (*cursor == ' ')
        ++cursor;
      if (*cursor == '\0')
        break;

      char *token = cursor;
      while (*cursor != '\0' && *cursor != ' ')
        ++cursor;

      char saved = *cursor;
      *cursor = '\0';
      append_edge(&edges, &edges_used, &edges_capacity, atoi(token));
      nodes[index].edge_count += 1;
      *cursor = saved;
    }
  }

  free(line);
  *node_count = n;
  *queries = query_items;
  *query_count = queries_used;
  *edge_ids = edges;
  *edge_count = edges_used;
  return nodes;
}

static size_t hash_id(int id)
{
  uint32_t value = (uint32_t)id;

  value ^= value >> 16;
  value *= UINT32_C(0x7feb352d);
  value ^= value >> 15;
  value *= UINT32_C(0x846ca68b);
  value ^= value >> 16;
  return (size_t)value;
}

static void id_map_insert_first(IdMap *map, int key, int index)
{
  size_t position = hash_id(key) & map->mask;

  for (;;) {
    IdSlot *slot = &map->slots[position];

    if (slot->index == -1) {
      slot->key = key;
      slot->index = index;
      return;
    }
    if (slot->key == key)
      return;

    position = (position + 1) & map->mask;
  }
}

static int id_map_lookup(const IdMap *map, int key)
{
  size_t position = hash_id(key) & map->mask;

  for (;;) {
    const IdSlot *slot = &map->slots[position];

    if (slot->index == -1)
      return -1;
    if (slot->key == key)
      return slot->index;

    position = (position + 1) & map->mask;
  }
}

static IdMap make_id_map(const Node *nodes, int node_count)
{
  size_t desired = (size_t)node_count;
  size_t capacity = 4;
  IdMap map;

  if (desired > SIZE_MAX / 2)
    fail();
  desired *= 2;

  while (capacity < desired) {
    if (capacity > SIZE_MAX / 2)
      fail();
    capacity *= 2;
  }

  map.slots = xalloc_array(capacity, sizeof *map.slots);
  map.mask = capacity - 1;
  for (size_t index = 0; index < capacity; ++index)
    map.slots[index].index = -1;

  for (int index = 0; index < node_count; ++index)
    id_map_insert_first(&map, nodes[index].id, index);

  return map;
}

static int select_scalar(const float *values, const int *targets, size_t count)
{
  float maximum = 0.0f;
  int selected = -1;

  for (size_t index = 0; index < count; ++index) {
    if (maximum < values[index]) {
      maximum = values[index];
      selected = targets[index];
    }
  }

  return selected;
}

static int select_successor(const float *values, const int *targets,
                            size_t count)
{
#if GRAPH_HAVE_NEON
  if (count >= 16) {
    const float32x4_t zero = vdupq_n_f32(0.0f);
    const float32x4_t negative_infinity = vdupq_n_f32(-INFINITY);
    float32x4_t best = negative_infinity;
    size_t index = 0;

    for (; index + 4 <= count; index += 4) {
      float32x4_t candidate = vld1q_f32(values + index);
      uint32x4_t positive = vcgtq_f32(candidate, zero);
      candidate = vbslq_f32(positive, candidate, negative_infinity);
      best = vmaxq_f32(best, candidate);
    }

    float maximum = -INFINITY;
    float lane = vgetq_lane_f32(best, 0);
    if (maximum < lane)
      maximum = lane;
    lane = vgetq_lane_f32(best, 1);
    if (maximum < lane)
      maximum = lane;
    lane = vgetq_lane_f32(best, 2);
    if (maximum < lane)
      maximum = lane;
    lane = vgetq_lane_f32(best, 3);
    if (maximum < lane)
      maximum = lane;

    for (; index < count; ++index) {
      float candidate = values[index];
      if (candidate > 0.0f && maximum < candidate)
        maximum = candidate;
    }

    if (!(maximum > 0.0f))
      return -1;

    /* Recover the first equal edge, preserving the strict original tie rule. */
    const float32x4_t wanted = vdupq_n_f32(maximum);
    index = 0;
    for (; index + 4 <= count; index += 4) {
      uint32x4_t equal = vceqq_f32(vld1q_f32(values + index), wanted);

      if (vgetq_lane_u32(equal, 0) != 0u)
        return targets[index];
      if (vgetq_lane_u32(equal, 1) != 0u)
        return targets[index + 1];
      if (vgetq_lane_u32(equal, 2) != 0u)
        return targets[index + 2];
      if (vgetq_lane_u32(equal, 3) != 0u)
        return targets[index + 3];
    }

    for (; index < count; ++index) {
      if (values[index] == maximum)
        return targets[index];
    }

    return -1;
  }
#endif

  return select_scalar(values, targets, count);
}

static void resolve_successor(int node_index, const Node *nodes,
                              const IdMap *map, int *edge_targets,
                              float *edge_values, int *successors,
                              unsigned char *resolved)
{
  const Node *node = &nodes[node_index];

  if (node->edge_count == 0) {
    successors[node_index] = -1;
    resolved[node_index] = 1u;
    return;
  }

  const size_t first = node->edge_begin;
  const size_t end = first + node->edge_count;

#if defined(__GNUC__) && !defined(__clang__)
#pragma GCC ivdep
#endif
  for (size_t edge = first; edge < end; ++edge) {
    int neighbor_id = edge_targets[edge];
    int target = id_map_lookup(map, neighbor_id);

    /* The reference retains -1 as its no-recursion sentinel after selection. */
    edge_targets[edge] = neighbor_id == -1 ? -1 : target;
    edge_values[edge] = target >= 0 ? nodes[target].value : -INFINITY;
  }

  successors[node_index] = select_successor(edge_values + first,
                                             edge_targets + first,
                                             node->edge_count);
  resolved[node_index] = 1u;
}

static float compute_cost(int start, int node_count, const Node *nodes,
                          const IdMap *map, int *edge_targets,
                          float *edge_values, int *successors,
                          unsigned char *resolved, float *costs,
                          unsigned char *known, int *stack)
{
  if (start < 0)
    return 0.0f;
  if (known[start])
    return costs[start];

  int current = start;
  size_t depth = 0;

  while (!known[current]) {
    if (depth == (size_t)node_count)
      fail();

    stack[depth++] = current;
    if (!resolved[current])
      resolve_successor(current, nodes, map, edge_targets, edge_values,
                        successors, resolved);

    int next = successors[current];
    if (next < 0) {
      current = -1;
      break;
    }
    current = next;
  }

  float suffix = current >= 0 ? costs[current] : 0.0f;
  while (depth != 0) {
    int node_index = stack[--depth];
    float result = nodes[node_index].value;

    if (successors[node_index] >= 0)
      result += suffix;

    costs[node_index] = result;
    known[node_index] = 1u;
    suffix = result;
  }

  return costs[start];
}

static void free_queries(Query *queries, size_t count)
{
  for (size_t index = 0; index < count; ++index)
    free(queries[index].text);
  free(queries);
}

int main(void)
{
  int node_count;
  Query *queries;
  size_t query_count;
  int *edge_targets;
  size_t edge_count;
  Node *nodes = read_graph(&node_count, &queries, &query_count,
                           &edge_targets, &edge_count);
  IdMap map = make_id_map(nodes, node_count);
  int *successors = node_count == 0 ? NULL :
                    xalloc_array((size_t)node_count, sizeof *successors);
  unsigned char *resolved = node_count == 0 ? NULL :
                            xcalloc_array((size_t)node_count,
                                          sizeof *resolved);
  float *costs = node_count == 0 ? NULL :
                 xalloc_array((size_t)node_count, sizeof *costs);
  unsigned char *known = node_count == 0 ? NULL :
                         xcalloc_array((size_t)node_count, sizeof *known);
  int *stack = node_count == 0 ? NULL :
               xalloc_array((size_t)node_count, sizeof *stack);
  float *edge_values = edge_count == 0 ? NULL :
                       xalloc_array(edge_count, sizeof *edge_values);

  for (size_t index = 0; index < query_count; ++index) {
    int node_index = id_map_lookup(&map, queries[index].id);
    float result = node_index < 0 ? 0.0f :
                   compute_cost(node_index, node_count, nodes, &map,
                                edge_targets, edge_values, successors,
                                resolved, costs, known, stack);

    printf("%s: %f\n", queries[index].text, result);
  }

  free(edge_values);
  free(stack);
  free(known);
  free(costs);
  free(resolved);
  free(successors);
  free(map.slots);
  free(edge_targets);
  free_queries(queries, query_count);
  free(nodes);
  return 0;
}

#include <stdio.h>
#include <stdlib.h>

#define MAXNUM 100
#define MAXSTR 50
#define MAXRESULTS 1000

char firstHalf[MAXNUM][MAXSTR];
char secondHalf[MAXNUM][MAXSTR];
long int result[MAXRESULTS];
int numPrimes=0;

static int isprime_small(long int value)
{
  return value == 2 || value == 3 || value == 5 || value == 7 ||
         value == 11 || value == 13;
}

static int isprime_after_small_factors(long int value)
{
  static const int increments[8] = {4, 2, 4, 2, 4, 6, 2, 6};
  long int factor=17;
  int step=3;

  if (value < 2)
    return 0;

  while (factor <= value / factor)
    {
      if (value % factor == 0)
        return 0;
      factor += increments[step];
      step = (step + 1) & 7;
    }
  return 1;
}

void quicksort(long int *primes,int first,int last)
{ int i, j, pivot;
  long int temp;

  if (first<last)
     { pivot=first;
       i=first;
       j=last;
       while(i<j)
         { while (primes[i]<=primes[pivot]&&i<last)
             i++;
           while (primes[j]>primes[pivot])
             j--;
           if (i<j)
              { temp=primes[i];
                primes[i]=primes[j];
                primes[j]=temp;
              }
         }
       temp=primes[pivot];
       primes[pivot]=primes[j];
       primes[j]=temp;
       quicksort(primes,first,j-1);
       quicksort(primes,j+1,last);
     }
}

int main(int argc,char** argv)
{ FILE *primesFile;
  int i=0,j=0,numResults=0,candidateCount;
  long int firstValue[MAXNUM];
  long int secondValue[MAXNUM];
  long int candidates[MAXNUM * MAXNUM];
  unsigned char smallFactorFree[MAXNUM * MAXNUM];
  long int primeToTest;
  primesFile=stdin;
  fscanf(primesFile,"%d\n",&numPrimes);
  for (i=0;i<numPrimes;i++)
      fscanf(primesFile,"%s\n",firstHalf[i]);
  for (i=0;i<numPrimes;i++)
      fscanf(primesFile,"%s\n",secondHalf[i]);
  fclose(primesFile);

  for (i=0;i<numPrimes;i++)
      firstValue[i]=atol(firstHalf[i]);
  for (i=0;i<numPrimes;i++)
      secondValue[i]=atol(secondHalf[i]);

  candidateCount=numPrimes*numPrimes;
  for (i=0;i<numPrimes;i++)
      { int row=i*numPrimes;
        long int prefix=firstValue[i]*10000000L;
        #pragma GCC ivdep
        for (j=0;j<numPrimes;j++)
            candidates[row+j]=prefix+secondValue[j];
      }

  #pragma GCC ivdep
  for (i=0;i<candidateCount;i++)
      { long int value=candidates[i];
        smallFactorFree[i]=(unsigned char)(
            (value > 13) &
            (value % 2 != 0) &
            (value % 3 != 0) &
            (value % 5 != 0) &
            (value % 7 != 0) &
            (value % 11 != 0) &
            (value % 13 != 0));
      }

  for (i=0;i<candidateCount;i++)
      { primeToTest=candidates[i];
        if (primeToTest <= 13)
          {
            if (isprime_small(primeToTest))
              result[numResults++]=primeToTest;
          }
        else if (smallFactorFree[i] &&
                 isprime_after_small_factors(primeToTest))
          {
            result[numResults++]=primeToTest;
          }
      }
  quicksort(result,0,numResults-1);
  for (i=0;i<numResults;i++)
      printf("%ld\n",result[i]);
  return 0;
}

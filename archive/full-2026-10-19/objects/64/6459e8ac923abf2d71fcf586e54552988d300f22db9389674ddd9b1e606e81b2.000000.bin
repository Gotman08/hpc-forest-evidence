"""Parent-only summary after actual post-stop bounded audit; no process/model API."""
from pathlib import Path
from datetime import UTC, datetime
import argparse
import hashlib
import json
import os
import re

OUT = Path(__file__).resolve().parent
BASE = OUT.parents[1]
RX = OUT / "reception-finale-751992"
GUIDE = BASE / "outputs/HPC-Forest-Harnais-Comparaison-r1/SUIVI-COMPACT.md"
IDS = BASE / "ID.md"


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def load(path):
    return json.loads(path.read_text(encoding="utf-8-sig"))


def ref(path):
    return {"path": str(path.resolve()), "sha256": sha(path)}


def save_new(path, value):
    with path.open("x", encoding="utf8", newline="\n") as stream:
        json.dump(value, stream, indent=2, ensure_ascii=True)
        stream.write("\n")


def replace_text(path, text):
    temporary = path.with_name(path.name + ".cloture-751992.tmp")
    with temporary.open("x", encoding="utf8", newline="\n") as stream:
        stream.write(text)
    os.replace(temporary, path)


def main(audit_path, audit_sha, stop_path, stop_sha):
    assert audit_path.parent == RX and sha(audit_path) == audit_sha
    assert sha(stop_path) == stop_sha and stop_path.resolve().is_relative_to(OUT)
    audit, stop = load(audit_path), load(stop_path)
    for value in (audit, stop):
        assert value["job_id"] == "751992"
        assert value["session_id"] == "c8044062692149138d826d3f388a08ef"
        assert value["model"] == "gpt-6-luna" and value["effort"] == "max"
    assert not audit.get("audit_error")
    assert audit["received_cohort_audited_with_explicit_raw_attribution_limit"] is True
    assert audit["evidence_inventory_before_after_identical"] is True
    assert all(audit[key] is False for key in ("verified", "native_research_admitted",
        "independent_raw_stdout_per_candidate_verified", "independent_performance_audit_verified"))
    assert stop["owned_stop_verified"] is True
    assert stop["all_owned_process_identities_absent_after_stop"] is True
    assert stop["source_only_relay_identities_preserved"] is True
    assert stop["recursive_stop"] is False and stop["foreign_processes_targeted"] is False
    cache, transport, campaign = audit["cache_preservation"], audit["transport_cost_reconciliation"], audit["campaign"]
    assert cache["total_cache_bytes_preservation_complete"] is True
    assert transport["unique_session_nonce_pairs"] == 10 and transport["exact_known_tokens"] == 243141
    assert transport["unknown_native_invocations"] == 0 and transport["unresolved_nonces"] == []
    assert campaign["received_native_checker_protocol_verified"] is True
    assert campaign["lineage_and_five_confirmations_verified"] is True
    assert campaign["trials"] == 8 and campaign["confirmations"] == 3
    assert campaign["negative_and_positive_status_counts"] == {"valid": 8}
    archive_path = RX / "results-751992.tar.gz"
    assert sha(archive_path) == "2d9ef8d1e1293159a2009c5bbbefaefa6ba521424141e8762887b6500e1a93df"
    roles = load(RX / "reconciliation-couts-par-operateur.json")
    assert roles["groups"] == {"mother": {"invocations": 2, "known_exact_tokens": 47286},
        "A_B_C_generation": {"invocations": 6, "known_exact_tokens": 116406},
        "G_integration": {"invocations": 2, "known_exact_tokens": 79449}}
    assert sha(GUIDE) == "5247582b9f91ce5812c10a978deda0dfc244c694defdc8249cf4be9136e2cd73"
    assert sha(IDS) == "ae2f2d06a82c91eb97b62c1000443d7bfc5f9ebb1114892f2029788175fe69df"
    guide, ids = GUIDE.read_text(encoding="utf8"), IDS.read_text(encoding="utf8")
    rows = re.findall(r"^\| (ID-\d{3}) \|", ids, re.M)
    assert len(rows) == len(set(rows)) == 40
    start = guide.index("## R2 Luna MAX — premier démarrage vérifié, réception finale en cours")
    end = guide.index("## Conservation, réception, limites", start)
    section = f"""## R2 Luna MAX — réception close au périmètre borné

UNE cellule R2 sur quatre reçue : primes-max-gpt-6-luna / 751992, session c8044062692149138d826d3f388a08ef, source r1b ZIP 3e290f835570a8746be3c52144932b8c6866564980fd858cf4c0495a7b1e68c5. COMPLETED 0:0, 22 min 17 s d’allocation. Premier démarrage natif reçu/contrôlé : modèle/MAX, source/plan/CLI, allocation4CPU ARM64/16Gio/0GPU, premier enfant normal livré et première évaluation correcte. Les avertissements CLI non bloquants et défauts techniques restent conservés. Ne plus repoller, relancer ou renotifier ce job après livraison du bilan.

Archive annoncée/distante/locale SHA 2d9ef8d1e1293159a2009c5bbbefaefa6ba521424141e8762887b6500e1a93df ; restauration neuve1387 fichiers,99 sources et inventaires inchangés. Huit missions valides A/B/C/A/B/C/G/G, parentés/sources/protocole du checker et trois confirmations de cinq passages reçus et contrôlés sans réexécution. Dix appels livrés/réconciliés :243141 jetons exacts, zéro non mesuré. Mère2/47286 ; A-B-C6/116406 ; G2/79449. Les huit enfants incluent déjà G. Cache/raisonnement inclus dans les totaux.

Réserve explicite : les execution.json figés ne lient pas fortement chaque stdout à son candidat/binaire/phase ; aucune attribution brute ou performance indépendante admise. Le checker désigne une modification et enregistre son temps/gain, mais cela ne devient pas une preuve indépendante de performance ni un classement causal. Domaine limité aux douze entrées certifiées, pas de rang de concours. Rapport final borné : ../HPC-Forest-Primes-Natif-Lancement-r1/reception-finale-751992/{audit_path.name}, SHA {audit_sha}. Les lecteurs/révisions et tous leurs premiers refus sont conservés ; aucune source, oracle ou proposition de modèle réparée, aucun appel rejoué.

Après audit/réconciliation, sept identités possédées absentes par arrêt individuel ou sortie naturelle ; source-only Sol MAX préservé, aucun arrêt par nom/récursif/étranger. Puis le worker.lock opérationnel1octet est réellement reçu :133 fichiers désormais préservés,132 fichiers de données inchangés ; aucun SHA avant du verrou inventé. Lire BILAN-LUNA-MAX.md, cloture-luna-max-verifiee.json et le reçu d’arrêt lié sous ../HPC-Forest-Primes-Natif-Lancement-r1/. Une seule voie native occupée au reçu d’arrêt : source-only Sol MAX751592 ; aucune troisième voie.

Trois modèles R2 MAX restent non démarrés : Astra,Terra,Sol. Nouvelle source locale r2b (../HPC-Forest-Primes-Natif-MAX-r2/revision-r2b/) préparée pour ces cellules : ZIP1a1dde5f1de6b3e3f062e3984c57c6327f714a7570b41e5734371bcda291e33b,131 tests neutres/Ruff et revue indépendante des deux P1 fermés. Elle fige l’autorisation complète et lie les nouveaux bruts aux membres reçus. Nouvelle qualification ARM64 mécanique, réception et admissions propres encore requises avant prochain modèle ; ne jamais réutiliser qualification r1b pour r2b. Préparation d’enveloppe sous ../HPC-Forest-Primes-Natif-Qualification-r2b/ si présente, son état vivant prévaut. Pas de modèle R3/R4/R5/Flash lancé. Édition professionnelle actuelle non actualisée avec cette cellule R2 ; admission explicite future requise.

"""
    guide = guide[:start] + section + guide[end:]
    old = "R1 MAX complet 60/60 ; R2 primes certifié fini, Luna MAX 751992 calcul terminé COMPLETED 0:0 ; premier démarrage reçu/contrôlé, réception/audit finaux et réconciliation en cours"
    assert ids.count(old) == 1
    ids = ids.replace(old, "R1 MAX complet60/60 ; domaine primes R2 fini certifié ; Luna MAX751992 reçue/auditée au périmètre borné,10 appels réconciliés et relais clos ; trois autres modèles MAX non démarrés")
    snapshot = BASE / "outputs/HPC-Forest-Etude-2020-2024-r1/reprises/reorientation-max-20261017/suivi-cloture-r2-751992"
    snapshot.mkdir(exist_ok=False)
    before = {}
    for path, name in ((GUIDE, "SUIVI-COMPACT-avant.md"), (IDS, "ID-avant.md")):
        (snapshot / name).write_bytes(path.read_bytes())
        assert sha(snapshot / name) == sha(path)
        before[str(path)] = sha(path)
    summary = {"schema": "hpc-forest-r2max-luna-bounded-closure-v1", "job_id": "751992",
        "session_id": audit["session_id"], "model": "gpt-6-luna", "effort": "max", "utc": datetime.now(UTC).isoformat(),
        "closed_received_audited_reconciled_with_explicit_raw_limit": True,
        "audit": ref(audit_path), "owned_stop": ref(stop_path), "archive": ref(archive_path),
        "first_start": ref(OUT / "reception-premier-demarrage-751992/reception-premier-demarrage-verifiee.json"),
        "recorded_role_costs": ref(RX / "reconciliation-couts-par-operateur.json"),
        "known_exact_tokens": 243141, "native_invocations": 10, "unknown_invocations": 0,
        "campaign_recorded_selection": campaign["selected_reported_by_frozen_checker"],
        "other_r2_models_not_started": ["gpt-6-astra", "gpt-5.6-terra", "gpt-6.1-sol"],
        "independent_performance_audit_verified": False, "independent_raw_stdout_per_candidate_verified": False,
        "professional_article_admitted": False, "source_only_preserved": True, "model_calls_replayed": 0}
    save_new(OUT / "cloture-luna-max-verifiee.json", summary)
    bilan = f"""# R2 primes — Luna MAX, reçu borné

Cellule 751992 close, reçue et réconciliée. Huit missions valides, trois confirmations de cinq passages, dix appels et 243 141 jetons exacts ; aucune invocation non mesurée. Premier démarrage contrôlé séparément avant extension. Archive trois SHA égaux : 2d9ef8d1e1293159a2009c5bbbefaefa6ba521424141e8762887b6500e1a93df.

Mère : 2 appels/47 286 jetons ; A-B-C : 6/116 406 ; G : 2/79 449. Les huit enfants incluent G ; cache/raisonnement déjà inclus.

Le protocole reçu, les sources, parentés, calculs des mesures enregistrées et cinq passages sont contrôlés en lecture seule. Les fichiers bruts figés ne permettent pas une attribution indépendante stdout→candidat/binaire/phase. Les temps/gain désignés par le checker restent donc enregistrés, sans admission indépendante de performance, généralisation de concours ou classement causal. Douze entrées finies certifiées seulement.

Sept identités locales possédées absentes après réception/audit/réconciliation, sans récursion ni cible étrangère ; source-only préservé. 132 fichiers de données inchangés, puis verrou de 1 octet réellement reçu après arrêt : 133 fichiers préservés. Aucun SHA avant du verrou inventé. Toutes les premières erreurs et révisions de lecteur sont conservées sans rejeu de recherche.

Reçu principal : cloture-luna-max-verifiee.json. Audit : reception-finale-751992/{audit_path.name}, SHA {audit_sha}. Admission professionnelle encore à faire ; trois autres modèles R2 MAX non démarrés, qualification de la nouvelle source r2b requise.
"""
    with (OUT / "BILAN-LUNA-MAX.md").open("x", encoding="utf8", newline="\n") as stream:
        stream.write(bilan)
    replace_text(GUIDE, guide)
    replace_text(IDS, ids)
    assert re.findall(r"^\| (ID-\d{3}) \|", IDS.read_text(encoding="utf8"), re.M) == rows
    save_new(snapshot / "suivi-actualise.json", {"before": before, "after": {str(p): sha(p) for p in (GUIDE, IDS)},
        "closure": ref(OUT / "cloture-luna-max-verifiee.json"), "bilan": ref(OUT / "BILAN-LUNA-MAX.md"),
        "id_rows_retained": 40, "source_or_candidate_modified": False})
    print(json.dumps({"closure": ref(OUT / "cloture-luna-max-verifiee.json"), "guide": ref(GUIDE), "ids": ref(IDS)}))


if __name__ == "__main__":
    p = argparse.ArgumentParser()
    p.add_argument("--audit", type=Path, required=True)
    p.add_argument("--audit-sha", required=True)
    p.add_argument("--stop", type=Path, required=True)
    p.add_argument("--stop-sha", required=True)
    a = p.parse_args()
    main(a.audit.resolve(), a.audit_sha, a.stop.resolve(), a.stop_sha)

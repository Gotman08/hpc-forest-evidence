    {
      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <cstddef>\n\nint main() {\n    int n, s;\n    std::cin >> n >> s;\n    const std::size_t stride = static_cast<std::size_t>(n);\n    std::vector<int> matrix(stride * stride);\n    for (int i = 0; i < n; ++i) {\n        int* row = matrix.data() + static_cast<std::size_t>(i) * stride;\n        for (int j = 0; j < n; ++j)\n            scanf(\"%d\", &row[j]);\n    }\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    std::vector<long long> column_sums(n, 0);\n    for (int i = 0; i < s; ++i) {\n        const int* row = matrix.data() + static_cast<std::size_t>(i) * stride;\n        for (int j = 0; j < n; ++j)\n            column_sums[j] += static_cast<long long>(row[j]);\n    }\n\n    long long window_sum = 0;\n    for (int j = 0; j < s; ++j)\n        window_sum += column_sums[j];\n    long long max_sum = window_sum;\n\n    for (int top = 0; top <= n - s; ++top) {\n        if (top != 0) {\n            const int* exiting = matrix.data()\n                + static_cast<std::size_t>(top - 1) * stride;\n            const int* entering = matrix.data()\n                + static_cast<std::size_t>(top + s - 1) * stride;\n            for (int j = 0; j < n; ++j) {\n                column_sums[j] += static_cast<long long>(entering[j])\n                    - static_cast<long long>(exiting[j]);\n            }\n            window_sum = 0;\n            for (int j = 0; j < s; ++j)\n                window_sum += column_sums[j];\n        }\n\n        if (window_sum > max_sum)\n            max_sum = window_sum;\n        for (int j = s; j < n; ++j) {\n            window_sum += column_sums[j] - column_sums[j - s];\n            if (window_sum > max_sum)\n                max_sum = window_sum;\n        }\n    }\n\n    printf(\"%lld\\n\", max_sum);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],

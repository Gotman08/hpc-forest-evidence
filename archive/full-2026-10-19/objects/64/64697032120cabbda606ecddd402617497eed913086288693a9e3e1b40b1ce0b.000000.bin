    "files": [
      {
        "content": "#include <algorithm>\n#include <iostream>\n#include <vector>\n\nconstexpr int MOD = 1000000007;\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n, m;\n    if (!(std::cin >> n >> m)) return 0;\n\n    std::vector<std::vector<int>> blockedColumns(n);\n    for (int c = 0; c < m; ++c) {\n        int row, column;\n        std::cin >> row >> column;\n        blockedColumns[row].push_back(column);\n    }\n\n    std::vector<int> dp(n, 0);\n    dp[0] = 1;\n\n    for (int row = 0; row < n; ++row) {\n        auto& columns = blockedColumns[row];\n        std::sort(columns.begin(), columns.end());\n        columns.erase(std::unique(columns.begin(), columns.end()), columns.end());\n\n        int left = 0;\n        int column = 0;\n        for (int blocked : columns) {\n            for (; column < blocked; ++column) {\n                int sum = dp[column] + left;\n                if (sum >= MOD) sum -= MOD;\n                dp[column] = sum;\n                left = sum;\n            }\n            dp[blocked] = 0;\n            left = 0;\n            column = blocked + 1;\n        }\n        for (; column < n; ++column) {\n            int sum = dp[column] + left;\n            if (sum >= MOD) sum -= MOD;\n            dp[column] = sum;\n            left = sum;\n        }\n    }\n\n    std::cout << dp[n - 1] << '\\n';\n    return 0;\n}\n",
        "path": "src/solution.cpp"
      }
    ],
    "hypothesis": "Streaming one DP row across obstacle-free intervals should reduce memory traffic and eliminate per-cell bitmap lookups, row copying, and remainder operations.",

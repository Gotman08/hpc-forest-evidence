{"files":[{"content":"#include <algorithm>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <cstdio>\n#include <cstring>\n#include <limits>\n#include <memory>\n#include <vector>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#define SUM_NEON 1\n#else\n#define SUM_NEON 0\n#endif\n\nnamespace {\n\nusing Sum = std::int64_t;\n\nstatic inline int signed_value(std::uint32_t magnitude, bool negative) {\n    return static_cast<int>(negative ? -static_cast<Sum>(magnitude)\n                                     : static_cast<Sum>(magnitude));\n}\n\n#if SUM_NEON\nstatic inline int64x2_t larger(int64x2_t a, int64x2_t b) {\n    return vbslq_s64(vcgtq_s64(a, b), a, b);\n}\n\nstatic inline int64x2_t prefix2(int64x2_t value) {\n    return vaddq_s64(value, vextq_s64(vdupq_n_s64(0), value, 1));\n}\n\nstruct Prefix4 {\n    int64x2_t lower;\n    int64x2_t upper;\n};\n\nstatic inline Prefix4 prefix4(int64x2_t lower, int64x2_t upper) {\n    Prefix4 result;\n    result.lower = prefix2(lower);\n    result.upper = vaddq_s64(prefix2(upper),\n                            vdupq_laneq_s64(result.lower, 1));\n    return result;\n}\n#endif\n\nstruct Maximum {\n    Sum best0 = std::numeric_limits<Sum>::lowest();\n    Sum best1 = std::numeric_limits<Sum>::lowest();\n    Sum best2 = std::numeric_limits<Sum>::lowest();\n    Sum best3 = std::numeric_limits<Sum>::lowest();\n#if SUM_NEON\n    int64x2_t vector0 = vdupq_n_s64(std::numeric_limits<Sum>::lowest());\n    int64x2_t vector1 = vdupq_n_s64(std::numeric_limits<Sum>::lowest());\n    int64x2_t vector2 = vdupq_n_s64(std::numeric_limits<Sum>::lowest());\n    int64x2_t vector3 = vdupq_n_s64(std::numeric_limits<Sum>::lowest());\n#endif\n\n    Sum result() const {\n        Sum answer = std::max(std::max(best0, best1), std::max(best2, best3));\n#if SUM_NEON\n        const int64x2_t lanes = larger(larger(vector0, vector1),\n                                      larger(vector2, vector3));\n        answer = std::max(answer, vgetq_lane_s64(lanes, 0));\n        answer = std::max(answer, vgetq_lane_s64(lanes, 1));\n#endif\n        return answer;\n    }\n};\n\nstatic inline void add_row(Sum* __restrict__ columns,\n                           const int* __restrict__ row, int n) {\n    for (int j = 0; j < n; ++j) columns[j] += row[j];\n}\n\nstatic inline void advance_row(Sum* __restrict__ columns,\n                               const int* __restrict__ incoming,\n                               const int* __restrict__ outgoing, int n) {\n    for (int j = 0; j < n; ++j)\n        columns[j] += static_cast<Sum>(incoming[j]) - outgoing[j];\n}\n\nstatic inline void observe_windows(const Sum* columns, int n, int s,\n                                   Maximum& maximum) {\n    Sum sum = 0;\n    int k = 0;\n#if SUM_NEON\n    int64x2_t initial0 = vdupq_n_s64(0);\n    int64x2_t initial1 = vdupq_n_s64(0);\n    for (; k + 4 <= s; k += 4) {\n        initial0 = vaddq_s64(initial0, vld1q_s64(columns + k));\n        initial1 = vaddq_s64(initial1, vld1q_s64(columns + k + 2));\n    }\n    const int64x2_t initial = vaddq_s64(initial0, initial1);\n    sum = vgetq_lane_s64(initial, 0) + vgetq_lane_s64(initial, 1);\n#endif\n    for (; k < s; ++k) sum += columns[k];\n    maximum.best0 = std::max(maximum.best0, sum);\n\n    const int transitions = n - s;\n    int j = 0;\n#if SUM_NEON\n    int64x2_t carry = vdupq_n_s64(sum);\n    for (; j + 8 <= transitions; j += 8) {\n        const Prefix4 first = prefix4(\n            vsubq_s64(vld1q_s64(columns + s + j),\n                       vld1q_s64(columns + j)),\n            vsubq_s64(vld1q_s64(columns + s + j + 2),\n                       vld1q_s64(columns + j + 2)));\n        const Prefix4 second = prefix4(\n            vsubq_s64(vld1q_s64(columns + s + j + 4),\n                       vld1q_s64(columns + j + 4)),\n            vsubq_s64(vld1q_s64(columns + s + j + 6),\n                       vld1q_s64(columns + j + 6)));\n        const int64x2_t second_carry = vaddq_s64(\n            carry, vdupq_laneq_s64(first.upper, 1));\n        const int64x2_t windows0 = vaddq_s64(carry, first.lower);\n        const int64x2_t windows1 = vaddq_s64(carry, first.upper);\n        const int64x2_t windows2 = vaddq_s64(second_carry, second.lower);\n        const int64x2_t windows3 = vaddq_s64(second_carry, second.upper);\n        maximum.vector0 = larger(maximum.vector0, windows0);\n        maximum.vector1 = larger(maximum.vector1, windows1);\n        maximum.vector2 = larger(maximum.vector2, windows2);\n        maximum.vector3 = larger(maximum.vector3, windows3);\n        carry = vdupq_laneq_s64(windows3, 1);\n    }\n    if (j + 4 <= transitions) {\n        const Prefix4 prefix = prefix4(\n            vsubq_s64(vld1q_s64(columns + s + j),\n                       vld1q_s64(columns + j)),\n            vsubq_s64(vld1q_s64(columns + s + j + 2),\n                       vld1q_s64(columns + j + 2)));\n        const int64x2_t windows0 = vaddq_s64(carry, prefix.lower);\n        const int64x2_t windows1 = vaddq_s64(carry, prefix.upper);\n        maximum.vector0 = larger(maximum.vector0, windows0);\n        maximum.vector1 = larger(maximum.vector1, windows1);\n        carry = vdupq_laneq_s64(windows1, 1);\n        j += 4;\n    }\n    if (j + 2 <= transitions) {\n        const int64x2_t delta = vsubq_s64(\n            vld1q_s64(columns + s + j), vld1q_s64(columns + j));\n        const int64x2_t windows = vaddq_s64(carry, prefix2(delta));\n        maximum.vector0 = larger(maximum.vector0, windows);\n        carry = vdupq_laneq_s64(windows, 1);\n        j += 2;\n    }\n    sum = vgetq_lane_s64(carry, 0);\n#else\n    for (; j + 4 <= transitions; j += 4) {\n        const Sum d0 = columns[s + j] - columns[j];\n        const Sum d1 = columns[s + j + 1] - columns[j + 1];\n        const Sum d2 = columns[s + j + 2] - columns[j + 2];\n        const Sum d3 = columns[s + j + 3] - columns[j + 3];\n        const Sum first_pair = d0 + d1;\n        const Sum second_pair = d2 + d3;\n        const Sum v0 = sum + d0;\n        const Sum v1 = sum + first_pair;\n        const Sum v2 = sum + (first_pair + d2);\n        const Sum v3 = sum + (first_pair + second_pair);\n        maximum.best0 = std::max(maximum.best0, v0);\n        maximum.best1 = std::max(maximum.best1, v1);\n        maximum.best2 = std::max(maximum.best2, v2);\n        maximum.best3 = std::max(maximum.best3, v3);\n        sum = v3;\n    }\n#endif\n    for (; j < transitions; ++j) {\n        sum += columns[s + j] - columns[j];\n        maximum.best0 = std::max(maximum.best0, sum);\n    }\n}\n\n} // namespace\n\nint main() {\n    int n, s;\n    if (std::scanf(\"%d%d\", &n, &s) != 2) return 0;\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const std::size_t width = static_cast<std::size_t>(n);\n    const std::size_t element_count = width * width;\n    std::unique_ptr<int[]> matrix_storage(new int[element_count]);\n    int* const matrix = matrix_storage.get();\n\n    const std::size_t input_capacity = 1u << 20;\n    std::unique_ptr<unsigned char[]> input_storage(\n        new unsigned char[2 * (input_capacity + 1)]);\n    unsigned char* input_buffers[2] = {\n        input_storage.get(), input_storage.get() + input_capacity + 1\n    };\n\n    int thread_limit = 1;\n#ifdef _OPENMP\n    if (element_count >= 262144)\n        thread_limit = std::min(omp_get_max_threads(), n);\n#endif\n    std::vector<std::size_t> token_counts(thread_limit, 0);\n    std::size_t ready_size = 0;\n    std::size_t carry_size = 0;\n    std::size_t carry_start = 0;\n    std::size_t direct_tokens = 0;\n    bool final_input = false;\n    const int window_rows = n - s + 1;\n    Sum maximum_sum = std::numeric_limits<Sum>::lowest();\n\n#ifdef _OPENMP\n#pragma omp parallel num_threads(thread_limit) if(thread_limit > 1) reduction(max:maximum_sum)\n#endif\n    {\n        int thread_id = 0;\n        int thread_count = 1;\n#ifdef _OPENMP\n        thread_id = omp_get_thread_num();\n        thread_count = omp_get_num_threads();\n#endif\n        std::size_t parsed = 0;\n        int buffer_id = 0;\n\n        while (parsed < element_count) {\n            unsigned char* const text = input_buffers[buffer_id];\n#ifdef _OPENMP\n#pragma omp master\n#endif\n            {\n                if (carry_size != 0)\n                    std::memcpy(text, input_buffers[buffer_id ^ 1] + carry_start,\n                                carry_size);\n                const std::size_t requested = input_capacity - carry_size;\n                const std::size_t bytes =\n                    std::fread(text + carry_size, 1, requested, stdin);\n                const std::size_t used = carry_size + bytes;\n                final_input = bytes < requested;\n                ready_size = used;\n                if (!final_input) {\n                    while (ready_size > 0 && text[ready_size - 1] > ' ')\n                        --ready_size;\n                }\n                carry_size = used - ready_size;\n                carry_start = ready_size;\n                direct_tokens = 0;\n                text[used] = ' ';\n\n                // Also accept integers with more than one buffer of leading zeros.\n                if (ready_size == 0 && used != 0 && !final_input) {\n                    std::size_t pos = 0;\n                    const bool negative = text[pos] == '-';\n                    if (negative || text[pos] == '+') ++pos;\n                    std::uint32_t magnitude = 0;\n                    for (; pos < used; ++pos)\n                        magnitude = magnitude * 10u +\n                                    static_cast<std::uint32_t>(text[pos] - '0');\n                    int c;\n                    while ((c = std::fgetc(stdin)) != EOF && c > ' ')\n                        magnitude = magnitude * 10u +\n                                    static_cast<std::uint32_t>(c - '0');\n                    matrix[parsed] = signed_value(magnitude, negative);\n                    direct_tokens = 1;\n                    carry_size = 0;\n                    carry_start = 0;\n                    final_input = c == EOF;\n                }\n            }\n#ifdef _OPENMP\n#pragma omp barrier\n#endif\n            const std::size_t byte_count = ready_size;\n            const bool final_chunk = final_input;\n            const std::size_t direct_count = direct_tokens;\n            if (byte_count == 0) {\n                if (direct_count == 0) break;\n                parsed += direct_count;\n#ifdef _OPENMP\n#pragma omp barrier\n#endif\n                buffer_id ^= 1;\n                if (final_chunk) break;\n                continue;\n            }\n\n            std::size_t begin = byte_count * thread_id / thread_count;\n            std::size_t end = byte_count * (thread_id + 1) / thread_count;\n            if (thread_id != 0) {\n                while (begin < byte_count && text[begin] > ' ') ++begin;\n            }\n            if (thread_id + 1 != thread_count) {\n                while (end < byte_count && text[end] > ' ') ++end;\n            }\n\n            std::size_t output_index = parsed;\n            std::size_t chunk_tokens = 0;\n            if (thread_count > 1) {\n                std::size_t local_tokens = 0;\n                if (begin < end) {\n                    local_tokens = text[begin] > ' ' ? 1 : 0;\n#ifdef _OPENMP\n#pragma omp simd reduction(+:local_tokens)\n#endif\n                    for (std::size_t pos = begin + 1; pos < end; ++pos)\n                        local_tokens += static_cast<std::size_t>(\n                            text[pos] > ' ' && text[pos - 1] <= ' ');\n                }\n                token_counts[thread_id] = local_tokens;\n#ifdef _OPENMP\n#pragma omp barrier\n#endif\n                for (int t = 0; t < thread_count; ++t) {\n                    if (t < thread_id) output_index += token_counts[t];\n                    chunk_tokens += token_counts[t];\n                }\n            }\n\n            std::size_t pos = begin;\n            while (pos < end) {\n                while (pos < end && text[pos] <= ' ') ++pos;\n                if (pos == end) break;\n                const bool negative = text[pos] == '-';\n                if (negative || text[pos] == '+') ++pos;\n                std::uint32_t magnitude = 0;\n                while (static_cast<unsigned>(text[pos] - '0') <= 9u) {\n                    magnitude = magnitude * 10u +\n                                static_cast<std::uint32_t>(text[pos] - '0');\n                    ++pos;\n                }\n                matrix[output_index++] = signed_value(magnitude, negative);\n            }\n            if (thread_count == 1) chunk_tokens = output_index - parsed;\n            parsed += chunk_tokens;\n            buffer_id ^= 1;\n            if (final_chunk) break;\n        }\n\n#ifdef _OPENMP\n#pragma omp barrier\n#endif\n        const int first = window_rows * thread_id / thread_count;\n        const int last = window_rows * (thread_id + 1) / thread_count;\n        if (first < last) {\n            std::unique_ptr<Sum[]> columns(new Sum[width]());\n            Maximum maximum;\n            for (int row = first; row < first + s; ++row)\n                add_row(columns.get(),\n                        matrix + static_cast<std::size_t>(row) * width, n);\n            observe_windows(columns.get(), n, s, maximum);\n            for (int row = first + 1; row < last; ++row) {\n                advance_row(columns.get(),\n                            matrix + static_cast<std::size_t>(row + s - 1) * width,\n                            matrix + static_cast<std::size_t>(row - 1) * width, n);\n                observe_windows(columns.get(), n, s, maximum);\n            }\n            maximum_sum = std::max(maximum_sum, maximum.result());\n        }\n    }\n\n    std::printf(\"%lld\\n\", static_cast<long long>(maximum_sum));\n}\n","path":"src/solution.cpp"}],"hypothesis":"Combining parallel byte-balanced parsing, contiguous sliding column sums, and eight-window ARM NEON prefix scans should reduce both input and computation time.","notes":"Uses 64-bit intermediates for cancellation safety, with scalar and non-OpenMP fallbacks. Controller evaluation is required.","research":{"queries":[],"urls":[]},"sources_kept":["25dd56cd4a944ddb","a4fdf0abfa3847a3","2f367ab10d3c495d"],"transformations":["Retain double-buffered fread, parallel token counting, prefix-assigned contiguous matrix writes, and one size-gated OpenMP team from C.","Apply A's row-major separable sliding column sums and vectorizable updates within independent output-row bands.","Adapt B's paired four-window NEON prefix scans and independent maximum accumulators to 64-bit totals, retaining A's four-window scalar fallback."]}
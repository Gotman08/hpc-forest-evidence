"""ROOT-supplied cold metadata only. No capture, lock, process or model effect."""
import argparse
import ast
from datetime import UTC, datetime
import hashlib
import json
import math
import os
from pathlib import Path
import re
import stat
import time

HERE = Path(__file__).resolve().parent
OP = HERE.parent
PREP = OP.parent
BASE = PREP.parents[1]
CHAIN = PREP / 'adaptateurs-source110-r1/revision-r8-racines-techniques-neuves'
OLD_CHAIN = PREP / 'adaptateurs-source110-r1/revision-r5-G-recu-avant-Q'
CAPACITY = OP / 'preparation-parents-R8-bout-en-bout-r1/verifier-capacite-preracines-R8.py'
CAPACITY_SHA = '7bf23184775c5a3ff22c897e05c9a141d3ce5db697d2f1254945cd6b7bc0809a'
RAW_SOURCE = PREP / 'qualification-allouee-source110-G-recu-r1/revue-resultats-Q753709-r1/lecteur-r4b/auditer-restauration-existante-r4b.py'
RAW_SHA = '5c1e1784574566a585e2d9cc50f85b52337d10d3109e449a4112581eae68f8d5'
OLD = OP / 'fermeture-observateur-r5-preparee-r1'
CLOSURE = OLD / 'execution-root-02-r3/FERMETURE-OBSERVATEUR-PASSIF-VERIFIEE.json'
CLOSURE_SHA = '297d6692434aef9099c2f418c75aae6f22ac8bc31333f38ae34d3a732fad48b3'
ANCHORS = OLD / 'ANCRAGES-FROIDS-EXACTS.json'
ANCHORS_SHA = 'a95a8a00e242816028bb0e61d0a76a05dc728346d9ce4c895a38b44cf2f99ee1'
GRAPH = OLD / 'revision-r3-lecture-flux-ouverts/garder-fermeture-observateur-r3.py'
GRAPH_SHA = 'd094626e6522e5c3497dbdb194e5babd6bdf2bee185f83b3bc57f5d5ca12ddea'
CLOSURE_REVIEW = OLD / 'revue-fermeture-reelle-r3-r1/REVUE-FERMETURE-OBS4-REELLE-R3.json'
CLOSURE_REVIEW_SHA = '7d2ba9c37b3a811d59039073608ff95f95c12473fa3156f60e79afe85c9a0a66'
COMPONENTS_SHA = 'd7d7d240198fc487efbede15c1328a366bc0c5bd59614d5064e19d81d1cf7122'
FIELDS = ('ProcessId', 'ParentProcessId', 'ExecutablePath', 'CommandLine', 'CreationDate')
OWNED = {57452, 28416, 35952, 37264, 49132, 60168, 48996}


def need(ok, message):
    if not ok:
        raise ValueError(message)


def definitions(path, checksum, names, namespace):
    code = path.read_bytes()
    need(hashlib.sha256(code).hexdigest() == checksum, 'Exact prepared pure definitions changed')
    selected = [n for n in ast.parse(code).body if isinstance(n, ast.FunctionDef) and n.name in names]
    need({n.name for n in selected} == names, 'Closed pure function set required')
    exec(compile(ast.Module(body=selected, type_ignores=[]), str(path), 'exec'), namespace)
    return namespace


def held_io():
    names = {'need', 'ordinary', 'metadata', 'open_nofollow_read', 'cross_identity',
             'validate_windows_mode_views', 'native_basic_info', 'raw', 'decode'}
    return definitions(RAW_SOURCE, RAW_SHA, names, {'Path': Path, 'os': os, 'stat': stat, 'Q': BASE, 'json': json})


def verify_legacy_paths(current_ref, closure_review_ref, *, now=None):
    now = time.time() if now is None else now
    io = held_io()
    pins = {}

    def read(ref):
        need(isinstance(ref, dict) and set(ref) == {'path', 'sha256'}
             and Path(ref['path']).is_absolute() and Path(ref['path']).is_relative_to(PREP)
             and re.fullmatch('[0-9a-f]{64}', ref['sha256']), 'Exact local metadata ref required')
        need(Path(ref['path']).name.rstrip(' .').casefold() not in {'worker.lock', 'observer.lock'}, 'No lock read')
        data = io['raw'](ref['path'])
        need(hashlib.sha256(data).hexdigest() == ref['sha256'], 'Actual metadata pin changed')
        pins[ref['path']] = ref['sha256']
        return io['decode'](data)

    closure_ref = {'path': str(CLOSURE), 'sha256': CLOSURE_SHA}
    anchors_ref = {'path': str(ANCHORS), 'sha256': ANCHORS_SHA}
    closure, anchors = read(closure_ref), read(anchors_ref)
    need(closure.get('schema') == 'hpc-forest-obs4-main-only-owned-passive-closure-v1'
         and closure.get('verified_metadata_only') is True and closure.get('verified_owned_observer_absence') is True
         and closure.get('only_main28416_ever_permitted_as_effect') is True
         and closure.get('services_naturally_absent') is True
         and closure.get('current_state_after_observation_promised') is False,
         'Actual old OBS4 owned closure required; it is historical, never current admission')
    need({r['ProcessId'] for r in anchors['contextual_identities']} == OWNED
         and closure['graph_state']['all_seven_original_identities_absent'] is True
         and closure['graph_state']['unresolved_context'] is False, 'Exact historical seven-context closure')
    need(closure_review_ref == {'path': str(CLOSURE_REVIEW), 'sha256': CLOSURE_REVIEW_SHA}, 'Only actual independently reviewed historical closure')
    reviewed = read(closure_review_ref)
    need(reviewed.get('schema') == 'hpc-forest-obs4-owned-passive-actual-closure-cold-review-v1'
         and reviewed.get('verified_metadata_only') is True and reviewed.get('verified_owned_observer_absence') is True
         and reviewed.get('blocking_findings') == []
         and reviewed.get('closure') == closure_ref and reviewed.get('final_full_cim') == closure['final_full_cim']
         and all(reviewed.get(k) is True for k in ('all_seven_original_identities_absent', 'only_main28416_effect',
                                                  'services_naturally_absent', 'no_future_state_promised'))
         and reviewed.get('native_generation_admitted') is False
         and reviewed.get('author_of_initial_guard_disclosed') is True
         and reviewed.get('ROOT_reviewed_r3_delta') == closure['review'], 'Actual cold independent old-closure review required')
    final_old = read(closure['final_full_cim'])
    need(current_ref != closure['final_full_cim'] and current_ref['path'] != closure['final_full_cim']['path']
         and current_ref['sha256'] != closure['final_full_cim']['sha256'], 'A new actual full census is required')
    current = read(current_ref)
    namespace = {'Path': Path, 'os': os, 'stat': stat, 'time': time, 're': re, 'math': math, 'ast': ast,
                 'datetime': datetime, 'UTC': UTC, 'hashlib': hashlib, 'FIELDS': FIELDS,
                 'OBSERVER': CHAIN / 'observer/observer-mixte.py', 'DETECTOR': CHAIN / 'launcher/native_worker_detection.py',
                 'OBSERVER_SHA': '70bb498896602652b9999cf25d53b5282454ed4368359d8a91e826bcca45307e',
                 'DETECTOR_SHA': '07fb437746064f20d0be33fcef748d1f9b0f0028214f02a042540d97e4c51766'}
    definitions(CAPACITY, CAPACITY_SHA, {'need', 'timestamp_z', 'complete_cim', 'native_definitions', 'classify_zero', 'digest'}, namespace)
    rows = namespace['complete_cim'](current, now)
    closed_at = datetime.fromisoformat(closure['observed_at_utc'])
    need(closed_at.tzinfo is not None and closed_at.utcoffset().total_seconds() == 0, 'Historical closure time is UTC')
    need(namespace['timestamp_z'](current['captured_at_utc']) > namespace['timestamp_z'](final_old['captured_at_utc'])
         and current['observed_at'] > closed_at.timestamp(),
         'New census must postdate actual old closure, never a renamed old capture')
    api = namespace['native_definitions']((CHAIN / 'observer/observer-mixte.py').read_bytes(),
                                         (CHAIN / 'launcher/native_worker_detection.py').read_bytes())
    namespace['classify_zero'](rows, api)
    graph = definitions(GRAPH, GRAPH_SHA, {'need', 'identity', 'creation', 'graph_state'},
                        {'Path': Path, 're': re, 'datetime': datetime, 'UTC': UTC,
                         'CHAIN': OLD_CHAIN, 'FIELDS': FIELDS, 'MAIN': 28416, 'LAUNCHER': 57452})
    state = graph['graph_state'](rows, anchors, final=True)
    need(state['all_seven_original_identities_absent'] and state['pair_absent']
         and not state['unresolved_context'], 'Original or reused/ambiguous old observer context is preserved; new start refused')
    scripts = [str(root / 'observer/observer-mixte.py').replace('/', '\\').casefold() for root in (OLD_CHAIN, CHAIN)]
    need(not any(any(script in (row.get('CommandLine') or '').replace('/', '\\').casefold() for script in scripts) or re.search(r'(?:^|[\\/])observer-mixte\.py(?:[\"\s]|$)', (row.get('CommandLine') or '').casefold())
                 for row in rows), 'Equivalent old or new observer command is present; no duplicate start')
    for path, checksum in pins.items():
        need(hashlib.sha256(io['raw'](path)).hexdigest() == checksum, 'Cold/current input changed within validation')
    namespace['complete_cim'](current, time.time())
    return {'schema': 'hpc-forest-r8-prior-OBS4-closed-current-absence-v1', 'verified_metadata_only': True,
            'old_observer_closure': closure_ref, 'independent_old_closure_review': closure_review_ref,
            'cold_anchors': anchors_ref, 'fresh_full_cim': current_ref, 'observed_at': current['observed_at'],
            'all_seven_original_identities_absent': True, 'no_equivalent_old_or_new_observer': True,
            'no_unknown_reused_or_ambiguous_old_descendants': True, 'active_native_workers': 0,
            'maximum_current_census_age_seconds': 120, 'graph_state': state,
            'no_stop_replay_or_launch_performed': True, 'new_observer_or_native_generation_admitted': False}



R7_CLOSURE = OP / 'CLOTURE-TECHNIQUE-TROIS-ROOTS-R7-ZERO-APPEL.json'
R7_CLOSURE_SHA = 'a044c89f6c989b21eed0e82299befa524a048adf79a6f50d30f7843e7c1dd5e4'
R7_EXIT = OP / 'reconciliation-sortie-naturelle-OBS4-R7-r1/RECONCILIATION-SORTIE-HISTORIQUE-OBS4-R7-METADATA-SEULEMENT.json'
R7_EXIT_SHA = 'aa9b2dd574234a0ba0640ccb444861530213642754cb33597c9d74ba00bd3130'
R7_CONTEXT = OP / 'reconciliation-sortie-naturelle-OBS4-R7-r1/CONTEXTE-HISTORIQUE-HUIT-IDENTITES.json'
R7_CONTEXT_SHA = '184388b17cae0b18046db42bb58ae488dafe152316870be905eb6db8d9fb7b00'
R5_CONTEXT = OP / 'fermeture-observateur-r5-preparee-r1/ANCRAGES-FROIDS-EXACTS.json'
R5_CONTEXT_SHA = 'a95a8a00e242816028bb0e61d0a76a05dc728346d9ce4c895a38b44cf2f99ee1'


def check_received_predecessors(read, rows=None, current=None):
    # Historical zero-call closure and attributed graphs, never future absence.
    closure = read({'path': str(R7_CLOSURE), 'sha256': R7_CLOSURE_SHA})
    exited = read({'path': str(R7_EXIT), 'sha256': R7_EXIT_SHA})
    context = read({'path': str(R7_CONTEXT), 'sha256': R7_CONTEXT_SHA})
    r5 = read({'path': str(R5_CONTEXT), 'sha256': R5_CONTEXT_SHA})
    need(closure.get('schema') == 'hpc-forest-root-r7-three-technical-roots-zero-call-audited-closure-v1'
         and closure.get('verified_metadata_only') is True
         and closure.get('job_ids') == ['754549', '754550', '754552']
         and all(type(closure.get(k)) is int and closure[k] == 0 for k in
                 ('published_requests','native_model_calls','invocations','responses','deliveries','unmeasured_invocations','unknown_invocations'))
         and closure.get('unresolved_invocations') == []
         and closure.get('reconciliation', {}).get('sha256') == '31baae0e99661b068f9584aff46118766c432182a05c1dade72b67e44bdb9aaa'
         and closure.get('independent_cold_review', {}).get('sha256') == '07ca364444837c057bc950b2b1ffba2c572856f9512ed8783d89127a59c61f8a'
         and closure.get('passive_observer_historical_reconciliation') == {'path': str(R7_EXIT), 'sha256': R7_EXIT_SHA},
         'Exact historical R7 zero-call roots closure required; consumed requests never reused')
    need(exited.get('schema') == 'hpc-forest-r7-passive-observer-historical-natural-exit-metadata-reconciliation-v1'
         and exited.get('verified_historical_metadata_only') is True
         and exited.get('blocking_findings_for_observed_eight_identity_absence') == []
         and exited.get('all_eight_observed_identities_absent_in_final_census') is True
         and exited.get('observed_context') == {'path': str(R7_CONTEXT), 'sha256': R7_CONTEXT_SHA}
         and exited.get('observed_context_identity_count') == 8
         and context.get('schema') == 'hpc-forest-r7-observed-passive-context-eight-identities-v1'
         and context.get('root_pair') == exited.get('owned_pair'), 'Exact attributed historical R7 context required')
    seven = r5['contextual_identities']
    eight = [record['full_identity'] for record in context['context']]
    fields = ('ProcessId','ParentProcessId','ExecutablePath','CommandLine','CreationDate')
    def key(row):
        need(isinstance(row, dict) and set(row) == set(fields)
             and all(type(row[k]) is int and row[k] > 0 for k in fields[:2])
             and all(isinstance(row[k], str) and row[k] for k in fields[2:]), 'Complete historical five-field identity required')
        return tuple(row[k] for k in fields)
    need(len(seven) == 7 and len(eight) == 8 and len({key(r) for r in seven}) == 7
         and len({key(r) for r in eight}) == 8, 'Exact distinct seven plus eight attributed contexts required')
    if rows is not None:
        need(current is not None and current['observed_at'] > datetime.fromisoformat(closure['observed_at_utc']).timestamp()
             and datetime.fromisoformat(current['captured_at_utc']).timestamp()
                 > datetime.fromisoformat(exited['final_CIM_captured_at_utc']).timestamp(),
             'New full census must postdate both received R7 closures')
        old = seven + eight
        old_ids = {row['ProcessId'] for row in old}
        # A reused PID is ambiguous here and REFUSES; it is never adopted or targeted.
        need(not any(row['ProcessId'] in old_ids or row['ParentProcessId'] in old_ids for row in rows),
             'Known identity PID reused/present or orphan parent ambiguous; preserve it and refuse')
        old_scripts = [str(PREP / ('adaptateurs-source110-r1/' + revision + '/observer/observer-mixte.py')).replace('/', '\\').casefold()
                       for revision in ('revision-r5-G-recu-avant-Q','revision-r7-racines-techniques-neuves')]
        need(not any(any(script in (row.get('CommandLine') or '').replace('/', '\\').casefold() for script in old_scripts)
                     for row in rows), 'Equivalent old observer command present; no foreign process adopted')
    return {'historical_R7_zero_call_closure': {'path': str(R7_CLOSURE), 'sha256': R7_CLOSURE_SHA},
            'historical_R7_observer_exit': {'path': str(R7_EXIT), 'sha256': R7_EXIT_SHA},
            'historical_R7_eight_context': {'path': str(R7_CONTEXT), 'sha256': R7_CONTEXT_SHA},
            'historical_R5_seven_context': {'path': str(R5_CONTEXT), 'sha256': R5_CONTEXT_SHA},
            'current_context_absence_verified': rows is not None,
            'R7_consumed_requests_not_reusable': True, 'new_stop_or_native_admission': False}

def verify_paths(current_ref, closure_review_ref, *, now=None):
    result = verify_legacy_paths(current_ref, closure_review_ref, now=now)
    io = held_io()
    pins = {}
    def read(reference):
        need(isinstance(reference, dict) and set(reference) == {'path','sha256'}
             and Path(reference['path']).is_relative_to(PREP), 'Closed local predecessor/current reference required')
        raw = io['raw'](reference['path'])
        need(hashlib.sha256(raw).hexdigest() == reference['sha256'], 'Predecessor/current bytes changed')
        pins[reference['path']] = reference['sha256']
        return io['decode'](raw)
    current = read(current_ref)
    namespace = {'math':math,'datetime':datetime,'FIELDS':FIELDS,'re':re}
    definitions(CAPACITY, CAPACITY_SHA, {'need','timestamp_z','complete_cim'}, namespace)
    rows = namespace['complete_cim'](current, time.time() if now is None else now)
    predecessors = check_received_predecessors(read, rows, current)
    for path, checksum in pins.items():
        need(hashlib.sha256(io['raw'](path)).hexdigest() == checksum, 'Current/predecessor evidence changed')
    namespace['complete_cim'](current, time.time())
    result.update(R7_predecessors=predecessors, all_eight_R7_original_identities_absent=True,
                  no_unknown_reused_or_ambiguous_R7_descendants=True)
    return result

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--full-cim', type=Path, required=True)
    parser.add_argument('--full-cim-sha256', required=True)
    parser.add_argument('--old-observer-review', type=Path, required=True)
    parser.add_argument('--old-observer-review-sha256', required=True)
    parser.add_argument('--output', type=Path, required=True)
    args = parser.parse_args()
    result = verify_paths({'path': str(args.full_cim), 'sha256': args.full_cim_sha256},
                          {'path': str(args.old_observer_review), 'sha256': args.old_observer_review_sha256})
    io = held_io()
    output = io['ordinary'](args.output)
    need(output.parent == HERE or output.parent.parent == HERE, 'New output in this owned preparation only')
    need(not output.exists(), 'Never overwrite prior proof')
    with output.open('x', encoding='utf8', newline='\n') as stream:
        stream.write(json.dumps(result, indent=2, ensure_ascii=False) + '\n')
    print(json.dumps({'proof': {'path': str(output), 'sha256': hashlib.sha256(output.read_bytes()).hexdigest()},
                      'new_observer_started': False, 'native_generation_admitted': False}))


if __name__ == '__main__':
    main()

        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n#if defined(__aarch64__)\nstatic inline float32x4_t inverse_cube4(float32x4_t squared) {\n  const float64x2_t one = vdupq_n_f64(1.0);\n  float64x2_t root_lo = vsqrtq_f64(\n      vcvt_f64_f32(vget_low_f32(squared)));\n  float64x2_t root_hi = vsqrtq_f64(\n      vcvt_f64_f32(vget_high_f32(squared)));\n  float32x4_t inverse = vcombine_f32(\n      vcvt_f32_f64(vdivq_f64(one, root_lo)),\n      vcvt_f32_f64(vdivq_f64(one, root_hi)));\n  return inverse * inverse * inverse;\n}\n#endif\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system.\n */\nvoid body_force(Body *p, float dt, int n) {\n  int i = 0;\n\n#if defined(__aarch64__)\n  /* Each SIMD lane owns one target and its ordered force recurrence. */\n  for (; i + 3 < n; i += 4) {\n    const float32x4_t px = {p[i].x, p[i + 1].x,\n                            p[i + 2].x, p[i + 3].x};\n    const float32x4_t py = {p[i].y, p[i + 1].y,\n                            p[i + 2].y, p[i + 3].y};\n    const float32x4_t pz = {p[i].z, p[i + 1].z,\n                            p[i + 2].z, p[i + 3].z};\n    const float32x4_t soft = vdupq_n_f32(SOFTENING);\n    float32x4_t fx = vdupq_n_f32(0.0f);\n    float32x4_t fy = vdupq_n_f32(0.0f);\n    float32x4_t fz = vdupq_n_f32(0.0f);\n    int j = 0;\n\n    /* Two sources expose independent square-root and division chains. */\n    for (; j + 1 < n; j += 2) {\n      float32x4_t dx0 = vdupq_n_f32(p[j].x) - px;\n      float32x4_t dy0 = vdupq_n_f32(p[j].y) - py;\n      float32x4_t dz0 = vdupq_n_f32(p[j].z) - pz;\n      float32x4_t squared0 =\n          dx0*dx0 + dy0*dy0 + dz0*dz0 + soft;\n\n      float32x4_t dx1 = vdupq_n_f32(p[j + 1].x) - px;\n      float32x4_t dy1 = vdupq_n_f32(p[j + 1].y) - py;\n      float32x4_t dz1 = vdupq_n_f32(p[j + 1].z) - pz;\n      float32x4_t squared1 =\n          dx1*dx1 + dy1*dy1 + dz1*dz1 + soft;\n\n      float32x4_t inverse30 = inverse_cube4(squared0);\n      float32x4_t inverse31 = inverse_cube4(squared1);\n\n      /* No horizontal reduction or reassociation of source-body sums. */\n      fx += dx0 * inverse30;\n      fy += dy0 * inverse30;\n      fz += dz0 * inverse30;\n      fx += dx1 * inverse31;\n      fy += dy1 * inverse31;\n      fz += dz1 * inverse31;\n    }\n\n    if (j < n) {\n      float32x4_t dx = vdupq_n_f32(p[j].x) - px;\n      float32x4_t dy = vdupq_n_f32(p[j].y) - py;\n      float32x4_t dz = vdupq_n_f32(p[j].z) - pz;\n      float32x4_t squared = dx*dx + dy*dy + dz*dz + soft;\n      float32x4_t inverse3 = inverse_cube4(squared);\n      fx += dx * inverse3;\n      fy += dy * inverse3;\n      fz += dz * inverse3;\n    }\n\n    p[i].vx += dt*vgetq_lane_f32(fx, 0);\n    p[i].vy += dt*vgetq_lane_f32(fy, 0);\n    p[i].vz += dt*vgetq_lane_f32(fz, 0);\n    p[i + 1].vx += dt*vgetq_lane_f32(fx, 1);\n    p[i + 1].vy += dt*vgetq_lane_f32(fy, 1);\n    p[i + 1].vz += dt*vgetq_lane_f32(fz, 1);\n    p[i + 2].vx += dt*vgetq_lane_f32(fx, 2);\n    p[i + 2].vy += dt*vgetq_lane_f32(fy, 2);\n    p[i + 2].vz += dt*vgetq_lane_f32(fz, 2);\n    p[i + 3].vx += dt*vgetq_lane_f32(fx, 3);\n    p[i + 3].vy += dt*vgetq_lane_f32(fy, 3);\n    p[i + 3].vz += dt*vgetq_lane_f32(fz, 3);\n  }\n#endif\n\n  for (; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n    int j = 0;\n\n#if defined(__aarch64__)\n    for (; j + 1 < n; j += 2) {\n      float dx0 = p[j].x - p[i].x;\n      float dy0 = p[j].y - p[i].y;\n      float dz0 = p[j].z - p[i].z;\n      float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\n\n      float dx1 = p[j + 1].x - p[i].x;\n      float dy1 = p[j + 1].y - p[i].y;\n      float dz1 = p[j + 1].z - p[i].z;\n      float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\n\n      /* Match the scalar expression's double sqrt and division. */\n      float32x2_t squared = vdup_n_f32(sqrd_dist0);\n      squared = vset_lane_f32(sqrd_dist1, squared, 1);\n      float64x2_t roots = vsqrtq_f64(vcvt_f64_f32(squared));\n      float32x2_t inverse = vcvt_f32_f64(\n          vdivq_f64(vdupq_n_f64(1.0), roots));\n      float32x2_t inverse3 = vmul_f32(vmul_f32(inverse, inverse), inverse);\n      float inv_dist30 = vget_lane_f32(inverse3, 0);\n      float inv_dist31 = vget_lane_f32(inverse3, 1);\n\n      /* Keep every force sum in its original source-body order. */\n      fx += dx0 * inv_dist30;\n      fy += dy0 * inv_dist30;\n      fz += dz0 * inv_dist30;\n      fx += dx1 * inv_dist31;\n      fy += dy1 * inv_dist31;\n      fz += dz1 * inv_dist31;\n    }\n#endif\n\n    for (; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
        "path": "src/nbody.c"
      }

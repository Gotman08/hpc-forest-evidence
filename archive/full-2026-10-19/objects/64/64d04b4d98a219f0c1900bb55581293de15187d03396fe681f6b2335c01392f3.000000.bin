   }\\n+    return false;\\n+}\\n+\\n+bool testIsomorphismParallel(adjacency_matrix &g1, adjacency_matrix &g2,\\n+                             vector<int> &next_seed, vector<int> &exchange_counter){\\n+    const int vertices = static_cast<int>(next_seed.size());\\n+    const int batch_capacity = omp_get_max_threads();\\n+    vector<HeapBlock> blocks(batch_capacity);\\n+    for(HeapBlock &block : blocks){\\n+        block.seed.resize(vertices);\\n+        block.permutation.resize(vertices);\\n+        block.matches.resize(heap_block_permutations);\\n+    }\\n+\\n+    int block_count = 0;\\n+    bool more_blocks = true;\\n+    bool isomorphism_found = false;\\n+\\n+    #pragma omp parallel\\n+    {\\n+        while(true){\\n+            #pragma omp single\\n+            {\\n+                block_count = 0;\\n+                while(block_count < batch_capacity && more_blocks){\\n+                    blocks[block_count].seed = next_seed;\\n+                    ++block_count;\\n+\\n+                    // A complete seven-vertex Heap block swaps its endpoints.\\n+                    swap(next_seed[0], next_seed[heap_block_vertices - 1]);\\n+                    int exchange_index = heap_block_vertices;\\n+                    while(exchange_index < vertices &&\\n+                          exchange_counter[exchange_index] == exchange_index){\\n+                        exchange_counter[exchange_index] = 0;\\n+                        ++exchange_index;\\n+                    }\\n+                    if(exchange_index == vertices){\\n+                        more_blocks = false;\\n+                    }else{\\n+                        if(exchange_index % 2 == 0)\\n+                            swap(next_seed[0], next_seed[exchange_index]);\\n+                        else\\n+                            swap(next_seed[exchange_counter[exchange_index]], next_seed[exchange_index]);\\n+                        ++exchange_counter[exchange_index];\\n+                    }\\n+          
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <algorithm>\\n#include <iostream>\\n#include <utility>\\n#include <vector>\\n\\nusing namespace std;\\n\\nconst int MOD = 1000000007;\\n\\nint main() {\\n    ios::sync_with_stdio(false);\\n    cin.tie(nullptr);\\n\\n    int n, m;\\n    if (!(cin >> n >> m)) return 0;\\n\\n    // Sort blocked cells by anti-diagonal, then row, for a sparse zeroing pass.\\n    vector<pair<int, int>> blockedCells;\\n    blockedCells.reserve(static_cast<size_t>(m));\\n    for (int c = 0; c < m; ++c) {\\n        int row, column;\\n        cin >> row >> column;\\n        blockedCells.emplace_back(row + column, row);\\n    }\\n    sort(blockedCells.begin(), blockedCells.end());\\n\\n    vector<int> previous(n, 0);\\n    vector<int> current(n, 0);\\n    size_t blockedIndex = 0;\\n\\n    previous[0] = 1;\\n    while (blockedIndex < blockedCells.size() &&\\n           blockedCells[blockedIndex].first == 0) {\\n        previous[0] = 0;\\n        ++blockedIndex;\\n    }\\n\\n    for (int diagonal = 1; diagonal <= 2 * n - 2; ++diagonal) {\\n        const bool growing = diagonal < n;\\n        const int lowRow = growing ? 0 : diagonal - n + 1;\\n        const int length = growing ? diagonal + 1 : 2 * n - 1 - diagonal;\\n\\n        const int* __restrict__ previousData = previous.data();\\n        int* __restrict__ currentData = current.data();\\n\\n        // Writes in each loop are independent: all recurrence inputs come from\\n        // the preceding anti-diagonal. Apply sparse blocked-cell zeros afterward.\\n        if (growing) {\\n            const int last = length - 1;\\n            currentData[0] = previousData[0];\\n            currentData[last] = previousData[last - 1];\\n\\n            #pragma GCC ivdep\\n            for (int i = 1; i < last; ++i) {\\n                int ways = previousData[i - 1] + previousData[i];\\n                if (ways >= MOD) ways -= MOD;\\n                currentData[i] = ways;\\n            }\\n        } else {\\n            #pragma GCC ivdep\\n            for (int i = 0; i < length; ++i) {\\n                int ways = previousData[i] + previousData[i + 1];\\n                if (ways >= MOD) ways -= MOD;\\n                currentData[i] = ways;\\n            }\\n        }\\n\\n        while (blockedIndex < blockedCells.size() &&\\n               blockedCells[blockedIndex].first == diagonal) {\\n            const int index = blockedCells[blockedIndex].second - lowRow;\\n            currentData[index] = 0;\\n            ++blockedIndex;\\n        }\\n\\n        previous.swap(current);\\n    }\\n\\n    cout << previous[0] << '\\\\n';\\n    return 0;\\n}\\n\",\"path\":\"src/solution.cpp\"}],\"hypothesis\":\"Computing each anti-diagonal without obstacle checks in the cell loop, then zeroing its sparse blocked positions, should reduce per-cell memory traffic and masking while leaving the independent recurrence loops easier for GCC to SIMD-vectorize.\",\"notes\":\"This keeps the rolling anti-diagonal recurrence and applies blocked cells before the next diagonal reads them; no correctness or speed result is claimed.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Store blocked coordinates sorted by (anti-diagonal, row) rather than encoding them into a packed key.\",\"Remove the per-cell blocked-stamp array and compute each anti-diagonal with unmasked independent loops.\",\"After each diagonal is computed, zero all blocked positions on it before swapping buffers.\" ]}"}}

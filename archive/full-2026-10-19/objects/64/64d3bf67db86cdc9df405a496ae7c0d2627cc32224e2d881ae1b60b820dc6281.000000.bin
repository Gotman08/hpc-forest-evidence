#include <algorithm>
#include <iostream>
#include <vector>

using namespace std;

constexpr int MOD = 1000000007;
constexpr int TILE = 128;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    if (!(cin >> n >> m)) return 0;

    vector<vector<int>> blocked(n);
    for (int k = 0; k < m; ++k) {
        int y, x;
        cin >> y >> x;
        blocked[y].push_back(x);
    }
    for (auto& row : blocked) {
        sort(row.begin(), row.end());
        row.erase(unique(row.begin(), row.end()), row.end());
    }

    vector<int> ways(n, 0);
    ways[0] = 1;
    const int tiles = (n + TILE - 1) / TILE;

    if (tiles == 1) {
        for (int y = 0; y < n; ++y) {
            const vector<int>& obstacles = blocked[y];
            size_t next = 0;
            for (int x = 0; x < n; ++x) {
                while (next < obstacles.size() && obstacles[next] < x) ++next;
                if (next < obstacles.size() && obstacles[next] == x) {
                    ways[x] = 0;
                } else if (x != 0) {
                    int value = ways[x] + ways[x - 1];
                    if (value >= MOD) value -= MOD;
                    ways[x] = value;
                }
            }
        }
    } else {
#pragma omp parallel
        {
            for (int diagonal = 0; diagonal < 2 * tiles - 1; ++diagonal) {
                const int firstTileRow = max(0, diagonal - tiles + 1);
                const int lastTileRow = min(tiles - 1, diagonal);
#pragma omp for schedule(static)
                for (int tileRow = firstTileRow; tileRow <= lastTileRow; ++tileRow) {
                    const int tileCol = diagonal - tileRow;
                    const int yBegin = tileRow * TILE;
                    const int yEnd = min(n, yBegin + TILE);
                    const int xBegin = tileCol * TILE;
                    const int xEnd = min(n, xBegin + TILE);

                    for (int y = yBegin; y < yEnd; ++y) {
                        const vector<int>& obstacles = blocked[y];
                        size_t next = lower_bound(obstacles.begin(), obstacles.end(), xBegin) - obstacles.begin();
                        for (int x = xBegin; x < xEnd; ++x) {
                            if (next < obstacles.size() && obstacles[next] == x) {
                                ways[x] = 0;
                                ++next;
                            } else if (x != 0) {
                                int value = ways[x] + ways[x - 1];
                                if (value >= MOD) value -= MOD;
                                ways[x] = value;
                            }
                        }
                    }
                }
            }
        }
    }

    cout << ways[n - 1] << '\n';
    return 0;
}

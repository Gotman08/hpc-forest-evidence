      "content": "#include <algorithm>\n#include <cstdint>\n#include <cstdio>\n#include <vector>\n\nusing std::vector;\n\nstatic constexpr int MOD = 1000000007;\n\nclass FastInput {\npublic:\n    int readInt() {\n        int c = getchar_unlocked();\n        while (c <= ' ' && c != EOF) c = getchar_unlocked();\n        int sign = 1;\n        if (c == '-') {\n            sign = -1;\n            c = getchar_unlocked();\n        }\n        int value = 0;\n        while (c >= '0' && c <= '9') {\n            value = value * 10 + c - '0';\n            c = getchar_unlocked();\n        }\n        return value * sign;\n    }\n};\n\nstruct Point {\n    int y;\n    int x;\n\n    bool operator<(const Point& other) const {\n        return y != other.y ? y < other.y : x < other.x;\n    }\n\n    bool operator==(const Point& other) const {\n        return y == other.y && x == other.x;\n    }\n};\n\nstatic int modPow(int base, int exponent) {\n    int64_t result = 1;\n    int64_t value = base;\n    while (exponent != 0) {\n        if (exponent & 1) result = result * value % MOD;\n        value = value * value % MOD;\n        exponent >>= 1;\n    }\n    return static_cast<int>(result);\n}\n\nint main() {\n    FastInput input;\n    const int n = input.readInt();\n    const int m = input.readInt();\n\n    vector<Point> blocked;\n    blocked.reserve(static_cast<size_t>(m));\n    for (int i = 0; i < m; ++i) {\n        Point point;\n        point.y = input.readInt();\n        point.x = input.readInt();\n        blocked.push_back(point);\n    }\n\n    std::sort(blocked.begin(), blocked.end());\n    blocked.erase(std::unique(blocked.begin(), blocked.end()), blocked.end());\n\n    bool startBlocked = false;\n    bool endBlocked = false;\n    for (const Point& point : blocked) {\n        startBlocked |= point.y == 0 && point.x == 0;\n        endBlocked |= point.y == n - 1 && point.x == n - 1;\n    }\n    if (startBlocked || endBlocked) {\n        std::printf(\"0\\n\");\n        return 0;\n    }\n\n    const uint64_t cells = static_cast<uint64_t>(n) * n;\n    const uint64_t pointCount = static_cast<uint64_t>(blocked.size()) + 1;\n\n    // A row-major rolling DP is preferable once its linear cell work is less\n    // than the pairwise sparse inclusion-exclusion work.\n    if (cells <= 2 * pointCount * pointCount) {\n        vector<int> dp(static_cast<size_t>(n), 0);\n        dp[0] = 1;\n        size_t nextBlocked = 0;\n\n        for (int y = 0; y < n; ++y) {\n            const size_t rowBegin = nextBlocked;\n            while (nextBlocked < blocked.size() && blocked[nextBlocked].y == y) {\n                ++nextBlocked;\n            }\n            size_t obstacle = rowBegin;\n            const size_t rowEnd = nextBlocked;\n\n            for (int x = 0; x < n; ++x) {\n                if (obstacle < rowEnd && blocked[obstacle].x == x) {\n                    dp[x] = 0;\n                    ++obstacle;\n                } else if (x != 0) {\n                    int value = dp[x] + dp[x - 1];\n                    if (value >= MOD) value -= MOD;\n                    dp[x] = value;\n                }\n            }\n        }\n\n        std::printf(\"%d\\n\", dp[n - 1]);\n        return 0;\n    }\n\n    const int limit = 2 * n - 2;\n    vector<int> factorial(static_cast<size_t>(limit) + 1);\n    vector<int> inverseFactorial(static_cast<size_t>(limit) + 1);\n    factorial[0] = 1;\n    for (int i = 1; i <= limit; ++i) {\n        factorial[i] = static_cast<int>(static_cast<int64_t>(factorial[i - 1]) * i % MOD);\n    }\n    inverseFactorial[limit] = modPow(factorial[limit], MOD - 2);\n    for (int i = limit; i > 0; --i) {\n        inverseFactorial[i - 1] = static_cast<int>(static_cast<int64_t>(inverseFactorial[i]) * i % MOD);\n    }\n\n    const auto paths = [&](int fromY, int fromX, int toY, int toX) -> int {\n        const int dy = toY - fromY;\n        const int dx = toX - fromX;\n        int64_t result = static_cast<int64_t>(factorial[dx + dy]) * inverseFactorial[dx] % MOD;\n        return static_cast<int>(result * inverseFactorial[dy] % MOD);\n    };\n\n    vector<int> ways(blocked.size());\n    for (size_t i = 0; i < blocked.size(); ++i) {\n        const Point& destination = blocked[i];\n        int value = paths(0, 0, destination.y, destination.x);\n        for (size_t j = 0; j < i; ++j) {\n            const Point& source = blocked[j];\n            if (source.x <= destination.x) {\n                value = static_cast<int>((value - static_cast<int64_t>(ways[j]) *\n                    paths(source.y, source.x, destination.y, destination.x)) % MOD);\n                if (value < 0) value += MOD;\n            }\n        }\n        ways[i] = value;\n    }\n\n    int answer = paths(0, 0, n - 1, n - 1);\n    for (size_t i = 0; i < blocked.size(); ++i) {\n        const Point& source = blocked[i];\n        answer = static_cast<int>((answer - static_cast<int64_t>(ways[i]) *\n            paths(source.y, source.x, n - 1, n - 1)) % MOD);\n        if (answer < 0) answer += MOD;\n    }\n\n    std::printf(\"%d\\n\", answer);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "A locality-aware hybrid will outperform full-grid storage: use a single contiguous rolling row for sufficiently dense instances, and coordinate-sorted sparse inclusion-exclusion for sparse instances, avoiding N² allocation while retaining exact results.",
  "notes": "The dense path streams sorted obstacles by row and uses only O(N) contiguous DP storage; the sparse path deduplicates inputs and uses factorial-based binomials modulo MOD.",
  "sources_kept": [],
  "transformations": [
    "Replace N² blocked-grid allocation with sorted coordinate storage.",
    "Use cache-friendly in-place row-major rolling DP for dense workloads.",
    "Use coordinate-sorted combinatorial inclusion-exclusion for sparse workloads.",
    "Add fast buffered integer input and deduplicate blocked coordinates."
  ]

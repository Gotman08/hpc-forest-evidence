        "content": "#include <cstddef>\n#include <iostream>\n#include <utility>\n#include <vector>\n\nusing namespace std;\n\nclass adjacency_matrix {\npublic:\n    explicit adjacency_matrix(int vertices = 0)\n        : vertices_(vertices),\n          cells_(static_cast<size_t>(vertices) * static_cast<size_t>(vertices), 0),\n          row_ones_(vertices, 0) {}\n\n    int size() const {\n        return vertices_;\n    }\n\n    void setUndirected(int source, int destination) {\n        const size_t forward = offset(source, destination);\n        if (cells_[forward] == 0) {\n            cells_[forward] = 1;\n            ++row_ones_[source];\n        }\n\n        if (source != destination) {\n            const size_t reverse = offset(destination, source);\n            if (cells_[reverse] == 0) {\n                cells_[reverse] = 1;\n                ++row_ones_[destination];\n            }\n        }\n    }\n\n    const unsigned char *row(int vertex) const {\n        return cells_.data() + offset(vertex, 0);\n    }\n\n    int signature(int vertex) const {\n        return row_ones_[vertex] * 2 + row(vertex)[vertex];\n    }\n\nprivate:\n    size_t offset(int row_index, int column_index) const {\n        return static_cast<size_t>(row_index) * static_cast<size_t>(vertices_) +\n               static_cast<size_t>(column_index);\n    }\n\n    int vertices_;\n    vector<unsigned char> cells_;\n    vector<int> row_ones_;\n};\n\nadjacency_matrix readGraph();\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2);\nbool sameVertexSignatures(const adjacency_matrix &g1, const adjacency_matrix &g2);\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence);\ninline void printPermutation(const vector<int> &equivalence);\n\nint main(){\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if(!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2){\n    if(g1.size() != g2.size()) return false;\n    if(!sameVertexSignatures(g1, g2)) return false;\n\n    const int vertices = g1.size();\n    vector<int> equivalence(vertices, 0);\n    vector<int> exchange_counter(vertices, 0);\n    int exchange_index = 1;\n    bool isomorphism_found = false;\n\n    for(int i = 0; i < vertices; ++i)\n        equivalence[i] = i;\n\n    if(verifyPermutation(g1, g2, equivalence)){\n        printPermutation(equivalence);\n        return true;\n    }\n\n    while(exchange_index < vertices){\n        if(exchange_counter[exchange_index] < exchange_index){\n            if(exchange_index % 2 == 0)\n                swap(equivalence[0], equivalence[exchange_index]);\n            else\n                swap(equivalence[exchange_counter[exchange_index]], equivalence[exchange_index]);\n            if(verifyPermutation(g1, g2, equivalence)){\n                printPermutation(equivalence);\n                isomorphism_found = true;\n            }\n\n            exchange_counter[exchange_index]++;\n            exchange_index = 1;\n        }else{\n            exchange_counter[exchange_index] = 0;\n            exchange_index++;\n        }\n    }\n    return isomorphism_found;\n}\n\nadjacency_matrix readGraph(){\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read(vertices);\n\n    cin >> edges;\n    for (int i = 0; i < edges; i++) {\n       cin >> source >> destination;\n       read.setUndirected(source, destination);\n    }\n\n    return read;\n}\n\nbool sameVertexSignatures(const adjacency_matrix &g1, const adjacency_matrix &g2){\n    const int vertices = g1.size();\n    vector<int> signature_counts(2 * vertices + 2, 0);\n\n    for(int i = 0; i < vertices; ++i){\n        ++signature_counts[g1.signature(i)];\n        --signature_counts[g2.signature(i)];\n    }\n\n    for(int count : signature_counts)\n        if(count != 0) return false;\n\n    return true;\n}\n\nbool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,\n                       const vector<int> &equivalence){\n    const int vertices = g1.size();\n\n    for (int i = 0; i < vertices; ++i) {\n        const int mapped_i = equivalence[i];\n        if(g1.signature(i) != g2.signature(mapped_i)) return false;\n\n        const unsigned char *first_row = g1.row(i);\n        const unsigned char *second_row = g2.row(mapped_i);\n        for (int j = 0; j <= i; ++j) {\n            if(first_row[j] != second_row[equivalence[j]]) return false;\n        }\n    }\n    return true;\n}\n\ninline void printPermutation(const vector<int> &equivalence){\n    for (int i : equivalence)\n        cout << i << \" \";\n    cout << endl;\n}\n",

"""Neutral controls; no real CLI, model, RPC or process creation."""
import ast
import copy
import importlib.util
import json
import tempfile
import time
import unittest
from pathlib import Path
from unittest.mock import AsyncMock, patch

HERE = Path(__file__).resolve().parent
spec = importlib.util.spec_from_file_location("dispatch_cli_tested", HERE / "coordonner-prochain-cli-r1.py")
d = importlib.util.module_from_spec(spec)
spec.loader.exec_module(d)


def cell():
    return {"key": d.KEY, "session_id": d.SESSION, "model": d.MODEL, "effort": d.EFFORT,
            "state": "not_started", "phase": "coverage", "subjects": [str(x) for x in range(18)]}


def state():
    return {"stage": "ready_for_next_group_after_audited_reception",
            "source_zip_sha256": d.SOURCE, "error": None, "queue": [cell()]}


def status(job="123", observed=1000, current=True, name="RUNNING"):
    return {"ok": True, "job_id": job, "state": name, "finished": name in d.TERMINAL,
            "observation": {"observed_at": observed, "current_state_observed": current}}


def worker(pid=1, parent=0, session=d.OTHER_SESSION, exe="C:/python.exe"):
    return {"ProcessId": pid, "ParentProcessId": parent, "ExecutablePath": exe,
            "CommandLine": f'"C:/python.exe" "-m" "hpc_forest.ablation_worker" "--session-id" "{session}"',
            "CreationDate": "2026-10-17T20:00:00+00:00"}


class Guards(unittest.TestCase):
    def test_expected_queue(self):
        self.assertEqual(d.choose_next(state())["key"], d.KEY)

    def test_source_drift(self):
        s = state(); s["source_zip_sha256"] = "0" * 64
        with self.assertRaises(RuntimeError):
            d.choose_next(s)

    def test_session_drift(self):
        s = state(); s["queue"][0]["session_id"] = "0" * 32
        with self.assertRaises(RuntimeError):
            d.choose_next(s)

    def test_effort_drift(self):
        s = state(); s["queue"][0]["effort"] = "max"
        with self.assertRaises(RuntimeError):
            d.choose_next(s)

    def test_model_drift(self):
        s = state(); s["queue"][0]["model"] = "different"
        with self.assertRaises(RuntimeError):
            d.choose_next(s)

    def test_existing_plan(self):
        s = state(); s["queue"][0]["plan_id"] = "p"
        with self.assertRaises(RuntimeError):
            d.choose_next(s)

    def test_uncertain_submission(self):
        s = state(); s["queue"][0]["state"] = "submitting"
        with self.assertRaises(RuntimeError):
            d.choose_next(s)

    def test_later_uncertain_submission(self):
        s = state(); extra = cell(); extra["state"] = "prepared"; s["queue"].append(extra)
        with self.assertRaises(RuntimeError):
            d.choose_next(s)

    def test_error_blocks(self):
        s = state(); s["error"] = "pending"
        with self.assertRaises(RuntimeError):
            d.choose_next(s)

    def test_duplicate_subjects(self):
        s = state(); s["queue"][0]["subjects"] = ["same"] * 18
        with self.assertRaises(RuntimeError):
            d.choose_next(s)

    def test_deadline_exclusive(self):
        with self.assertRaises(RuntimeError):
            d.deadline_guard(d.DEADLINE - d.MAXIMUM - d.AUDIT_RESERVE)

    def test_deadline_one_second_before(self):
        d.deadline_guard(d.DEADLINE - d.MAXIMUM - d.AUDIT_RESERVE - 1)

    def test_iso_and_legacy_creation(self):
        a = worker(); b = copy.deepcopy(a)
        b["CreationDate"] = f"/Date({d.epoch(a['CreationDate'])})/"
        self.assertTrue(d.same_cim(a, b))

    def test_reused_parent_not_identity(self):
        a = worker(); b = copy.deepcopy(a); b["ExecutablePath"] = "C:/foreign.exe"
        self.assertFalse(d.same_cim(a, b))

    def test_two_sessions_allowed(self):
        self.assertEqual(len(d.native_sessions([worker(), worker(2, session=d.SESSION)])), 2)

    def test_three_sessions_refused(self):
        with self.assertRaises(RuntimeError):
            d.native_sessions([worker(), worker(2, session=d.SESSION), worker(3, session="a" * 32)])

    def test_quoted_launcher_pair(self):
        a = worker(); b = worker(2, 1)
        self.assertEqual(len(d.native_sessions([a, b])[d.OTHER_SESSION]), 2)

    def test_three_processes_for_session_refused(self):
        with self.assertRaises(RuntimeError):
            d.native_sessions([worker(), worker(2, 1), worker(3, 1)])

    def test_unrelated_pair_refused(self):
        with self.assertRaises(RuntimeError):
            d.native_sessions([worker(), worker(2, 0)])

    def test_powershell_code_text_not_worker(self):
        self.assertEqual(d.native_sessions([worker(exe="C:/powershell.exe")]), {})

    def test_unknown_worker_without_session(self):
        row = worker(); row["CommandLine"] = "python.exe -m hpc_forest.matrix_worker"
        with self.assertRaises(RuntimeError):
            d.native_sessions([row])

    def test_current_status(self):
        self.assertEqual(d.current_status(status(), "123", 1001)["state"], "RUNNING")

    def test_cached_terminal_refused(self):
        with self.assertRaises(RuntimeError):
            d.current_status(status(current=False, name="COMPLETED"), "123", 1001)

    def test_stale_status_refused(self):
        with self.assertRaises(RuntimeError):
            d.current_status(status(), "123", 1181)

    def test_wrong_job_refused(self):
        with self.assertRaises(RuntimeError):
            d.current_status(status(), "456", 1001)

    def test_running_not_terminal(self):
        with self.assertRaises(RuntimeError):
            d.current_status(status(), "123", 1001, terminal=True)

    def test_environment_child_only(self):
        base = {"PATH": "old", "KEEP": "same"}
        result = d.child_environment(base)
        self.assertEqual(base, {"PATH": "old", "KEEP": "same"})
        self.assertTrue(result["PATH"].startswith(str(d.CLI.parent)))
        self.assertEqual(result["KEEP"], "same")

    def test_request_one_group_hardware(self):
        remote, request = d.job_request(cell())
        self.assertTrue(remote.endswith(d.KEY))
        self.assertEqual((request["cpus_per_task"], request["mem_gb"], request["gpus_per_node"]), (4, 16, 0))
        self.assertIn(d.SESSION, request["command"])
        self.assertEqual(request["time_limit"], "11:00:00")

    def test_plan_guard_hardware_and_wall(self):
        _, req = d.job_request(cell())
        spec = {**req, "time": "11:00:00", "nodes": 1, "ntasks_per_node": 1, "gpus_per_task": 0}
        plan = {"ok": True, "state": "ready", "expired": False,
                "plan": {"entries": [{"plan": {"seconds": d.MAXIMUM, "spec": spec}}]}}
        d.plan_guard(plan, req)
        for key, wrong in (("nodes", 2), ("gpus_per_node", 1), ("time", "12:00:00"),
                           ("cpus_per_task", 8), ("command", "different")):
            changed = copy.deepcopy(plan)
            changed["plan"]["entries"][0]["plan"]["spec"][key] = wrong
            with self.subTest(key=key), self.assertRaises(RuntimeError):
                d.plan_guard(changed, req)

    def test_exclusive_intention_preserved(self):
        with tempfile.TemporaryDirectory() as folder:
            p = Path(folder) / "intent.json"
            d.durable_json(p, {"attempt": 1}, exclusive=True)
            with self.assertRaises(FileExistsError):
                d.durable_json(p, {"attempt": 2}, exclusive=True)
            self.assertEqual(json.loads(p.read_text())["attempt"], 1)

    def test_no_reception_or_process_stop_calls(self):
        source = (HERE / "coordonner-prochain-cli-r1.py").read_text()
        tree = ast.parse(source)
        calls = [node for node in ast.walk(tree) if isinstance(node, ast.Call)]
        forbidden = {"receive", "_kill_owned", "terminate", "kill", "killpg", "stop"}
        self.assertFalse(any(isinstance(n.func, ast.Attribute) and n.func.attr in forbidden
                             or isinstance(n.func, ast.Name) and n.func.id in forbidden for n in calls))
        self.assertNotIn("taskkill", source.lower())

    def test_documented_new_source_only_transition_runtime(self):
        with tempfile.TemporaryDirectory() as folder:
            root = Path(folder)
            dispatcher = root / "dispatch.py"; dispatcher.write_text("pass")
            previous = root / "previous.json"; previous.write_text(json.dumps({"verified": True}))
            current = {"key": "source-only-gpt-6.1-sol-max", "arm": "source-only",
                       "state": "prepared", "session_id": "d" * 32}
            identity = worker(exe="C:/python.exe")
            identity["CommandLine"] = "python.exe " + str(dispatcher)
            intent = {"schema": "hpc-forest-source-only-single-dispatch-intent-v1",
                      "scope": "one-source-only-group", "key": current["key"],
                      "session_id": current["session_id"], "source_sha256": "source",
                      "dispatcher_path": str(dispatcher), "dispatcher_sha256": d.digest(dispatcher),
                      "observer_identity": identity,
                      "previous_reception": {"path": str(previous), "sha256": d.digest(previous)}}
            intent_path = root / "intent.json"; intent_path.write_text(json.dumps(intent))
            compare = {"current_key": current["key"], "queue": [current], "error": None,
                       "source_zip_sha256": "source",
                       "continuation_transition": {"path": str(intent_path), "sha256": d.digest(intent_path)}}
            with patch.object(d, "COMPARE", root):
                d.transition_guard(compare, current, [identity])
                current["state"] = "planned_not_submitted"
                d.transition_guard(compare, current, [identity])
                with self.assertRaises(RuntimeError):
                    d.transition_guard(compare, current, [])
                dispatcher.write_text("changed")
                with self.assertRaises(RuntimeError):
                    d.transition_guard(compare, current, [identity])

    def test_undocumented_new_transition_refused(self):
        with self.assertRaises(RuntimeError):
            d.transition_guard({"error": None}, {"state": "submitted"}, [])


class Scheduler(unittest.IsolatedAsyncioTestCase):
    async def test_fresh_status(self):
        rpc = type("Rpc", (), {})()
        rpc.call = AsyncMock(return_value=status(observed=time.time()))
        self.assertEqual((await d.scheduler(rpc, "123"))["state"], "RUNNING")
        self.assertEqual(rpc.call.await_count, 1)

    async def test_cached_status_requires_fresh_accounting(self):
        rpc = type("Rpc", (), {})()
        rpc.call = AsyncMock(side_effect=[status(current=False), {
            "ok": True, "found": True, "job_id": "123", "state": "COMPLETED", "exit_code": "0:0"}])
        result = await d.scheduler(rpc, "123")
        self.assertTrue(result["finished"])
        self.assertEqual(result["observation"]["source"], "fresh job_efficiency RPC")
        self.assertEqual(rpc.call.await_count, 2)

    async def test_accounting_must_find_correct_job(self):
        rpc = type("Rpc", (), {})()
        rpc.call = AsyncMock(side_effect=[status(current=False), {
            "ok": True, "found": True, "job_id": "456", "state": "COMPLETED"}])
        with self.assertRaises(RuntimeError):
            await d.scheduler(rpc, "123")

    async def test_unreceived_other_terminal_refreshed(self):
        rpc = type("Rpc", (), {})()
        s = {"current_key": d.OTHER_KEY, "queue": [{"key": d.OTHER_KEY, "state": "working"}]}
        with patch.object(d, "read", return_value=s), patch.object(d, "scheduler", AsyncMock(
                return_value=status(job=d.OTHER_JOB, observed=time.time(), name="COMPLETED"))) as sched, \
                patch.object(d, "durable_json") as write, patch.object(d, "process_guard", return_value="safe"):
            self.assertEqual(await d.runtime_guard(rpc), "safe")
            sched.assert_awaited_once()
            write.assert_called_once()

    async def test_received_other_not_repolled(self):
        rpc = type("Rpc", (), {})()
        s = {"current_key": d.OTHER_KEY, "queue": [{"key": d.OTHER_KEY, "state": "received_and_audited"}]}
        with patch.object(d, "read", return_value=s), patch.object(d, "scheduler", AsyncMock()) as sched, \
                patch.object(d, "process_guard", return_value="safe"):
            self.assertEqual(await d.runtime_guard(rpc), "safe")
            sched.assert_not_awaited()


if __name__ == "__main__":
    unittest.main()

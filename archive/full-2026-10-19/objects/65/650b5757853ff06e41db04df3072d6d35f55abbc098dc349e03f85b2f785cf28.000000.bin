"""Seal only the isolated preparation review after targeted neutral regressions."""
import ast
import hashlib
import json
import xml.etree.ElementTree as ET
from datetime import UTC, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
OLD = ROOT.parent


def ref(path):
    data = path.read_bytes()
    return {"path": str(path), "sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data)}


def functions(path):
    tree = ast.parse(path.read_text(encoding="utf-8-sig"))
    return {n.name: ast.dump(n, include_attributes=False) for n in tree.body if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))}


def main():
    target = HERE / "REVUE-PREPARATION-DESCENDANTS-R2.json"
    assert not target.exists()
    delivery_path = ROOT / "LIVRAISON-FACTORY-SO-CLOS-R2-NON-ADMISE.json"
    assert ref(delivery_path)["sha256"] == "f50a78270b23cbac89833aafa0e123dc87785fadeaeb1c26b9e5132aedcf6e02"
    delivery = json.loads(delivery_path.read_text(encoding="utf-8-sig"))
    reviewed = []
    for name, digest in delivery["code_pins"].items():
        value = ref(ROOT / name)
        assert value["sha256"] == digest
        reviewed.append(value)
    for key in ("predecessor_delivery", "predecessor_refusal", "exact_reviewer_counterexamples", "abi", "diff", "verification", "manifest"):
        value = delivery[key]
        assert ref(Path(value["path"]))["sha256"] == value["sha256"]
    assert ref(OLD / "source_only_state.py")["sha256"] == "617816e7b028460a16a2bc301f81913d2c45001a0d856569306f9940d149d3d8"
    old, new = functions(OLD / "source_only_state.py"), functions(ROOT / "source_only_state.py")
    assert set(new) - set(old) == {"_creation_key", "_unresolved_descendants"}
    assert {k for k in old if old[k] != new[k]} == {"verify_absence"}
    assert functions(OLD / "factory_preflight.py") == functions(ROOT / "factory_preflight.py")
    junit_path = HERE / "tests-cibles.xml"
    suites = list(ET.parse(junit_path).getroot().iter("testsuite"))
    assert sum(int(s.get("tests", "0")) for s in suites) == 6
    assert all(int(s.get(k, "0")) == 0 for s in suites for k in ("errors", "failures", "skipped"))
    result = {
        "schema": "hpc-forest-r4b-so-closed-factory-independent-review-v1",
        "verified": True, "blocking_findings": [], "observed_utc": datetime.now(UTC).isoformat(),
        "decision": "GO de préparation isolée et de correction du P1; aucune admission de génération ou d'absence réelle",
        "implementation_delivery": ref(delivery_path), "reviewed_files": reviewed,
        "previous_refusal": delivery["predecessor_refusal"], "previous_counterexamples": delivery["exact_reviewer_counterexamples"],
        "delta_verified": ["Parcours des possibilités sur union prior/cold/current, transitif et sans adoption", "Enfant possible opaque ou non résolu refuse la preuve", "Naissance strictement antérieure exclut une branche étrangère avec précision sept chiffres", "Anciennes fonctions inchangées sauf verify_absence; fonctions factory identiques, géométrie imbriquée et pin de reader seuls ajustés"],
        "tests_actually_executed": {"neutral_selected_passed": 6, "author_other_targeted_tests_deselected": 4,
            "selection": "exact_two_reviewer_counterexamples or recursive_bridge or declared_prior_descendant or complete_pid_reuse or seven_digit_birth",
            "covers": ["les deux contre-exemples initiaux exacts", "pont cold seul vers petit-enfant current seul", "descendant possédé antérieur vers nouveau petit-enfant", "PID complet réutilisé distinct et PID opaque refusé", "ordre des naissances à100ns"],
            "junit": ref(junit_path), "stdout": ref(HERE / "tests-cibles.log")},
        "source103_or_old18_suite_rerun": False,
        "absence_proof_contract": "Science/recon épinglées, prior et cold/current complets/frais, propriétés explicites, contrôle OBS3 distinct. Les possibilités ne deviennent jamais des identités possédées.",
        "source_guard_blocker_unchanged": delivery["source_guard_EDE_blocker_unchanged"],
        "actual_source_only_or_OBS3_absence_observed": False,
        "native_generation_admitted": False,
        "authorization_production_supported": False,
        "limitations": ["Cette préparation reste verified=false pour son propre résultat et ne crée aucune autorisation; le contrat EDE original reste incompatible avec source_only_preserved=false.", "Les possibles descendants non désambiguïsés bloquent conservativement la clôture; aucune adoption, aucun arrêt et aucune exclusivité globale de la station ne sont revendiqués.", "Les preuves froides et actuelles réelles ne sont pas encore reçues par cette revue."],
        "model_CLI_RPC_job_CIM_live_cache_lock_stop_calls": 0,
        "other_agent_or_production_files_modified": False,
    }
    target.write_text(json.dumps(result, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(ref(target)))


if __name__ == "__main__":
    main()

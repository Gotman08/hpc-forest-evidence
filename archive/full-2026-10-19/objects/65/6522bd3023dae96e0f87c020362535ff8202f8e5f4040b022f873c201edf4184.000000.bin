        "content": "#include <algorithm>\n#include <cstddef>\n#include <cstring>\n#include <iostream>\n#include <iterator>\n#include <string>\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ')\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v');\n    }\n};\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase(std::remove_if(text.begin(), text.end(), IsWhitespace()),\n               text.end());\n    return text;\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator<char> begin(in), end;\n    std::string text(begin, end);\n    return remove_whitespaces(text);\n}\n\nnamespace\n{\nconstexpr std::size_t OutputCapacity = 64 * 1024;\n\nstruct OutputBlock\n{\n    char bytes[OutputCapacity];\n    std::size_t used;\n\n    OutputBlock() : used(0) {}\n\n    void flush()\n    {\n        if (used != 0) {\n            std::cout.write(bytes, static_cast<std::streamsize>(used));\n            used = 0;\n        }\n    }\n\n    void append_pair(char first, char second)\n    {\n        if (OutputCapacity - used < 2) {\n            flush();\n        }\n        bytes[used++] = first;\n        bytes[used++] = second;\n    }\n};\n\ninline bool advance_formatted_record(char* record, std::size_t record_size)\n{\n    char* const first = record + 2;\n    char* const last = record + record_size - 4;\n    char* suffix = last;\n\n    while (suffix != first) {\n        char* const pivot = suffix - 2;\n        if (*pivot < *suffix) {\n            char* successor = last;\n            while (*successor <= *pivot) {\n                successor -= 2;\n            }\n            std::swap(*pivot, *successor);\n\n            char* left = suffix;\n            char* right = last;\n            while (left < right) {\n                std::swap(*left, *right);\n                left += 2;\n                right -= 2;\n            }\n            return true;\n        }\n        suffix = pivot;\n    }\n    return false;\n}\n\nvoid write_permutations(std::string& text)\n{\n    if (text.empty()) {\n        return;\n    }\n    std::sort(text.begin(), text.end());\n    OutputBlock output;\n\n    if (text.size() > (OutputCapacity - 4) / 2) {\n        do {\n            output.append_pair('[', ' ');\n            for (char symbol : text) {\n                output.append_pair(symbol, ' ');\n            }\n            output.append_pair(']', '\\n');\n        } while (std::next_permutation(text.begin(), text.end()));\n        output.flush();\n        return;\n    }\n\n    const std::size_t record_size = 2 * text.size() + 4;\n    char* current = output.bytes;\n    current[0] = '[';\n    current[1] = ' ';\n    for (std::size_t i = 0; i < text.size(); ++i) {\n        current[2 + 2 * i] = text[i];\n        current[3 + 2 * i] = ' ';\n    }\n    current[record_size - 2] = ']';\n    current[record_size - 1] = '\\n';\n    output.used = record_size;\n\n    for (;;) {\n        if (OutputCapacity - output.used < record_size) {\n            output.flush();\n            std::memmove(output.bytes, current, record_size);\n            current = output.bytes;\n        } else {\n            char* next = output.bytes + output.used;\n            std::memcpy(next, current, record_size);\n            current = next;\n        }\n\n        if (!advance_formatted_record(current, record_size)) {\n            break;\n        }\n        output.used += record_size;\n    }\n    output.flush();\n}\n}\n\nint main(int argc, char const* argv[])\n{\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n    std::string text = read_text_from_stdin<std::string>(std::cin);\n    write_permutations(text);\n    return 0;\n}\n",
        "path": "src/permutations.cc"
      }
    ],
    "hypothesis": "Permuting symbol slots directly in output-ready records and cloning adjacent records within one bounded block should reduce repeated formatting work and improve serialization locality.",

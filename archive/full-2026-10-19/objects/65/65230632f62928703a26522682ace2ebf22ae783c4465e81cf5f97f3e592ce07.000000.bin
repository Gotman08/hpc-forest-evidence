{
  "hypothesis": "Further improve memory locality and loop order by refining the blocking technique to reduce cache misses further.",
  "transformations": [
    "Reorder loops to enhance spatial locality",
    "Adjust block size for better cache performance"
  ],
  "sources_kept": [],
  "files": [
    {
      "path": "src/nbody.c",
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n#define BLOCK_SIZE 64 // adjusted block size for better cache performance\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Compute the gravitational impact among all pairs of bodies in \n * the system using blocking technique for better cache performance.\n */\nvoid body_force(Body *p, float dt, int n) {\n  for (int jj = 0; jj < n; jj += BLOCK_SIZE) {\n    for (int j = jj; j < jj + BLOCK_SIZE && j < n; j++) {\n      float dx[BLOCK_SIZE], dy[BLOCK_SIZE], dz[BLOCK_SIZE];\n      float sqrd_dist[BLOCK_SIZE], inv_dist[BLOCK_SIZE], inv_dist3[BLOCK_SIZE];\n\n      for (int ii = 0; ii < n; ii += BLOCK_SIZE) {\n        for (int i = ii; i < ii + BLOCK_SIZE && i < n; ++i) {\n          if (i != j) {\n            dx[i % BLOCK_SIZE] = p[j].x - p[i].x;\n            dy[i % BLOCK_SIZE] = p[j].y - p[i].y;\n            dz[i % BLOCK_SIZE] = p[j].z - p[i].z;\n            sqrd_dist[i % BLOCK_SIZE] = dx[i % BLOCK_SIZE]*dx[i % BLOCK_SIZE] + dy[i % BLOCK_SIZE]*dy[i % BLOCK_SIZE] + dz[i % BLOCK_SIZE]*dz[i % BLOCK_SIZE] + SOFTENING;\n            inv_dist[i % BLOCK_SIZE] = 1 / sqrt(sqrd_dist[i % BLOCK_SIZE]);\n            inv_dist3[i % BLOCK_SIZE] = inv_dist[i % BLOCK_SIZE] * inv_dist[i % BLOCK_SIZE] * inv_dist[i % BLOCK_SIZE];\n\n            p[i].vx += dt*inv_dist3[i % BLOCK_SIZE]*dx[i % BLOCK_SIZE];\n            p[i].vy += dt*inv_dist3[i % BLOCK_SIZE]*dy[i % BLOCK_SIZE];\n            p[i].vz += dt*inv_dist3[i % BLOCK_SIZE]*dz[i % BLOCK_SIZE];\n          }\n        }\n      }\n    }\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n  \n  exit(EXIT_SUCCESS);\n}\n"
    }
  ],
  "notes": "Reordered the loops to enhance spatial locality and adjusted the block size for better cache performance."
}

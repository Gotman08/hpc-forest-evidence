#include <bits/stdc++.h>

using namespace std;

int A[1000][1000];
int ps[1010][1010];

typedef long long ll;

ll solve(int m, int n, int k) {
  for (int i = 1; i <= m; i++) {
    ps[i][0] = 0;
    for (int j = 1; j <= n; j++) {
      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];
    }
  }

  // Flatten the triangular boundary-pair space into equal-cost work items.
  vector<int> pair_starts(n + 1, 0);
  for (int left = 0; left < n; left++) {
    pair_starts[left + 1] = pair_starts[left] + n - left;
  }
  const int pair_count = pair_starts[n];

  auto count_range = [&](int first, int last, unordered_map<ll, ll>& h) -> ll {
    int j = int(upper_bound(pair_starts.begin(), pair_starts.end(), first)
                - pair_starts.begin());
    int l = j + first - pair_starts[j - 1];
    ll subtotal = 0;
    for (int p = first; p < last; p++) {
      h.clear();
      h[0] = 1;
      ll s = 0;
      for (int i = 1; i <= m; i++) {
        s += ps[i][l] - ps[i][j - 1];
        subtotal += h.find(s - k) != h.end() ? h[s - k] : 0;
        h[s]++;
      }
      if (++l > n) {
        ++j;
        l = j;
      }
    }
    return subtotal;
  };

  const ll work = ll(pair_count) * m;
  int num_threads = work >= 262144 ? 4 : (work >= 65536 ? 2 : 1);
  num_threads = min(num_threads, pair_count);
  if (num_threads == 1) {
    unordered_map<ll, ll> h;
    h.reserve(m + 1);
    return count_range(0, pair_count, h);
  }

  // Coarse chunks amortize queue traffic while permitting dynamic balancing.
  const int chunk = max(1, min(64, pair_count / (32 * num_threads)));
  atomic<int> next_pair(0);
  ll partials[4] = {};
  auto worker = [&](int tid) {
    unordered_map<ll, ll> h;
    h.reserve(m + 1);
    ll subtotal = 0;
    for (;;) {
      const int first = next_pair.fetch_add(chunk, memory_order_relaxed);
      if (first >= pair_count) break;
      subtotal += count_range(first, min(first + chunk, pair_count), h);
    }
    partials[tid] = subtotal;
  };

  thread workers[3];
  for (int tid = 1; tid < num_threads; tid++) {
    workers[tid - 1] = thread(worker, tid);
  }
  worker(0);
  for (int tid = 1; tid < num_threads; tid++) {
    workers[tid - 1].join();
  }

  ll ans = 0;
  for (int tid = 0; tid < num_threads; tid++) {
    ans += partials[tid];
  }
  return ans;
}

int main() {
  int k, m, n;
  cin >> k >> m >> n;
  memset(A, 0, sizeof A);
  memset(ps, 0, sizeof ps);

  for (int i = 0; i < m; i++)
    for (int j = 0; j < n; j++)
      cin >> A[i][j];

  cout << solve(m, n, k) << endl;
  return 0;
}

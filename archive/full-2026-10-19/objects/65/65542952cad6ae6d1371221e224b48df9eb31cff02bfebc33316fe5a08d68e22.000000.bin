    pos = (pos + 1) & mask;\\n+    return pos;\\n+  }\\n+\\n+  void reset() {\\n+    fill(counts.begin(), counts.end(), uint16_t(0));\\n+    // The empty prefix hashes to zero; zero counts mark unused slots.\\n+    keys[0] = 0;\\n+    counts[0] = 1;\\n+  }\\n+\\n+  uint16_t get(ll key) const {\\n+    return counts[slot(key)];\\n+  }\\n+\\n+  void increment(ll key) {\\n+    const size_t pos = slot(key);\\n+    if (counts[pos] == 0)\\n+      keys[pos] = key;\\n+    ++counts[pos];\\n+  }\\n+};\\n+\\n ll solve(int m, int n, int k) {\\n-  for (int i = 1; i <= m; i++) {\\n-    for (int j = 1; j <= n; j++) {\\n-      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\\n+  const bool pair_rows = m <= n;\\n+  const int bands = pair_rows ? m : n;\\n+  const int length = pair_rows ? n : m;\\n+\\n+  // Each boundary stores a contiguous prefix vector along the scan axis.\\n+  fill(ps[0], ps[0] + length, 0);\\n+  if (pair_rows) {\\n+    for (int boundary = 1; boundary <= bands; ++boundary) {\\n+      const int* previous = ps[boundary - 1];\\n+      const int* row = A[boundary - 1];\\n+      int* current = ps[boundary];\\n+      for (int i = 0; i < length; ++i)\\n+        current[i] = previous[i] + row[i];\\n+    }\\n+  } else {\\n+    for (int i = 0; i < length; ++i) {\\n+      int prefix = 0;\\n+      for (int boundary = 1; boundary <= bands; ++boundary) {\\n+        prefix += A[i][boundary - 1];\\n+        ps[boundary][i] = prefix;\\n+      }\\n     }\\n   }\\n-  unordered_map<ll, ll> h;\\n+\\n+  PrefixFrequencyTable frequencies(static_cast<size_t>(length) + 1);\\n+  const ll target = static_cast<ll>(k);\\n   ll ans = 0;\\n-  for (int j = 1; j <= n; j++) // O(m*n^2)\\n-    for (int l = j; l <= n; l++) {\\n-      h.clear();\\n-      h[0] = 1;\\n-      ll s = 0;\\n-      for (int i = 1; i <= m; i++) {\\n-        s += ps[i][l] - ps[i][j - 1];\\n-        ans += h.find(s - k) != h.end() ? h[s - k] : 0;\\n-        h[s]++;\\n+  for (int first = 0; first < bands; ++first) {\\n+    const int* lower = ps[first];\\n+    for (int last = first + 1; last <= bands; ++last) {\\n+      const int* upper = ps[last];\\n+      frequencies.reset();\\n+      ll sum = 0;\\n+      for (int i = 0; i < length; ++i) {\\n+        sum += static_cast<ll>(upper[i]) - lower[i];\\n+        ans += frequencies.get(sum - target);\\n+        frequencies.increment(sum);\\n       }\\n     }\\n+  }\\n   return ans;\\n }\"}, {\"id\": \"53671201bf6144f6\", \"role\": \"A\", \"commit\": \"9c262d03462f5913ac8fad2ddcd43e49911509f8\", \"transformations\": {\"files\": [\"src/main.cpp\"], \"retained\": [\"Replace unordered_map with an exact-key, linearly probed flat table sized for m+1 prefixes at no more than 50% occupancy.\", \"Allocate workspace once per solve and reuse it through generation tags, including safe generation-wrap handling.\", \"Preserve zero-prefix seeding and query-before-increment ordering, using non-inserting queries, unsigned hash arithmetic, 32-bit frequencies and 64-bit keys, sums and answers.\"]}, \"mean_seconds\": 0.0795285664498806, \"diff\": \"diff --git a/src/main.cpp b/src/main.cpp\\nindex b3a5f60..a1601e1 100644\\n--- a/src/main.cpp\\n+++ b/src/main.cpp\\n@@ -7,23 +7,93 @@ int ps[1010][1010];\\n \\n typedef long long ll;\\n \\n+class PrefixFrequencyTable {\\n+  struct Entry {\\n+    ll key = 0;\\n+    uint32_t count = 0;\\n+    uint32_t generation = 0;\\n+  };\\n+\\n+  vector<Entry> entries;\\n+  size_t mask;\\n+  uint32_t generation = 0;\\n+\\n+  static size_t hash_key(ll key) {\\n+    uint64_t x = static_cast<uint64_t>(key);\\n+    x ^= x >> 30;\\n+    x *= 0xbf58476d1ce4e5b9ULL;\\n+    x ^= x >> 27;\\n+    x *= 0x94d049bb133111ebULL;\\n+    x ^= x >> 31;\\n+    return static_cast<size_t>(x);\\n+  }\\n+\\n+public:\\n+  explicit PrefixFrequencyTable(size_t max_keys) {\\n+    size_t capacity = 1;\\n+    while (capacity < 2 * max_keys)\\n+      capacity <<= 1;\\n+    entries.resize(capacity);\\n+    mask = capacity - 1;\\n+  }\\n+\\n+  void begin_band() {\\n+    ++g
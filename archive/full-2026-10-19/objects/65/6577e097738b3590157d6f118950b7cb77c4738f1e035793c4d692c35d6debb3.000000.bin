#include <bits/stdc++.h>
#ifdef _OPENMP
#include <omp.h>
#endif

using namespace std;

int A[1000][1000];
int ps[1010][1010];

typedef long long ll;

static ll count_bands(int m, int n, int k, ll begin, ll end) {
  if (begin == end)
    return 0;

  unordered_map<ll, ll> h;
  h.reserve(static_cast<size_t>(m) + 1);
  ll ans = 0;

  int j = 1;
  ll offset = begin;
  while (offset >= n - j + 1) {
    offset -= n - j + 1;
    ++j;
  }
  int l = j + static_cast<int>(offset);

  for (ll band = begin; band < end; ++band) {
    h.clear();
    h[0] = 1;
    ll s = 0;
    for (int i = 1; i <= m; i++) {
      s += ps[i][l] - ps[i][j - 1];
      ans += h.find(s - k) != h.end() ? h[s - k] : 0;
      h[s]++;
    }
    if (++l > n) {
      ++j;
      l = j;
    }
  }
  return ans;
}

ll solve(int m, int n, int k) {
  for (int i = 1; i <= m; i++) {
    ps[i][0] = 0;
    for (int j = 1; j <= n; j++) {
      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];
    }
  }

  const ll bands = static_cast<ll>(n) * (n + 1) / 2;
#ifdef _OPENMP
  const ll work = bands * m;
  const int workers = static_cast<int>(
      min<ll>(omp_get_max_threads(), max<ll>(1, work / 32768)));
  if (workers > 1) {
    ll ans = 0;
#pragma omp parallel num_threads(workers) reduction(+:ans)
    {
      const int tid = omp_get_thread_num();
      const int team_size = omp_get_num_threads();
      const ll begin = bands * tid / team_size;
      const ll end = bands * (tid + 1) / team_size;
      ans += count_bands(m, n, k, begin, end);
    }
    return ans;
  }
#endif
  return count_bands(m, n, k, 0, bands);
}

int main() {
  int k, m, n;
  cin >> k >> m >> n;
  memset(A, 0, sizeof A);
  memset(ps, 0, sizeof ps);

  for (int i = 0; i < m; i++)
    for (int j = 0; j < n; j++)
      cin >> A[i][j];

  cout << solve(m, n, k) << endl;
  return 0;
}

  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include <omp.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  #pragma omp parallel default(none) shared(bodies,nbodies)\n  {\n    for (int iter = 0; iter < N_ITER; iter++) {\n      /* Force computation with dynamic scheduling, chunk size 64 */\n      #pragma omp for schedule(dynamic,64) nowait\n      for (int i = 0; i < nbodies; ++i) {\n        float fx = 0.0f;\n        float fy = 0.0f;\n        float fz = 0.0f;\n\n        for (int j = 0; j < nbodies; j++) {\n          float dx = bodies[j].x - bodies[i].x;\n          float dy = bodies[j].y - bodies[i].y;\n          float dz = bodies[j].z - bodies[i].z;\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n          float inv_dist = 1 / sqrt(sqrd_dist);\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n          fx += dx * inv_dist3;\n          fy += dy * inv_dist3;\n          fz += dz * inv_dist3;\n        }\n\n        bodies[i].vx += DT*fx;\n        bodies[i].vy += DT*fy;\n        bodies[i].vz += DT*fz;\n      }\n      /* Implicit barrier ensures all forces are computed before position update */\n\n      /* Position integration with static scheduling (trivial work) */\n      #pragma omp for schedule(static)\n      for (int i = 0; i < nbodies; i++) {\n        bodies[i].x += bodies[i].vx * DT;\n        bodies[i].y += bodies[i].vy * DT;\n        bodies[i].z += bodies[i].vz * DT;\n      }\n    } /* end for iter */\n  } /* end parallel region */\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n  \n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Using a single OpenMP parallel region across all simulation iterations reduces thread management overhead. For the computationally intensive force loop, dynamic scheduling with chunk size 64 adapts to runtime load imbalances from memory access patterns better than guided or static schedules. The trivial position update uses static scheduling for minimal overhead.",
  "notes": "Combines best practices: single parallel region (reduces fork-join), dynamic(64) for force loop (load balance), static for position update (low overhead). Inlined force computation to avoid function call inside parallel region.",
  "sources_kept": [],
  "transformations": [
    "Move parallel region outside iteration loop",
    "Change force loop schedule from guided to dynamic(64)",
    "Inline body_force function into main loop",
    "Use static schedule for position update"
  ]
}

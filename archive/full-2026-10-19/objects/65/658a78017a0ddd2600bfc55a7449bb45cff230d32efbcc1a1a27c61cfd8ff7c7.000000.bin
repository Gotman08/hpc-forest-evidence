"""Pure fail-closed probes; archive reads and all directory creation are mocked out."""
import hashlib
import importlib.util
import sys
from pathlib import Path
from types import ModuleType
from unittest.mock import patch

path = Path(__file__).resolve().parents[1] / "auditer-reception-r2e-template.py"
assert hashlib.sha256(path.read_bytes()).hexdigest() == "4220aa40bbda2d55a0ec51b75ffe3d465f0b9b1a8ca52bff93f5788f4e542520"
spec = importlib.util.spec_from_file_location("NEUTRAL_cold_guards", path)
reader = importlib.util.module_from_spec(spec)
spec.loader.exec_module(reader)
reader.ROOT = reader.BASE / "outputs/HPC-Forest-Primes-Natif-Relance-r2e/NEUTRAL-not-received"
reader.DELIVERY_PATH = reader.BASE / "outputs/NEUTRAL-delivery.json"
reader.BINDINGS_PATH = reader.BASE / "outputs/NEUTRAL-bindings.json"
reader.SOURCE_MEMBERS = reader.DELTA_CASES = reader.EXPECTED_BYTES = 1
reader.JOB_ID = "999999999999"
reader.EXPECTED_ARCHIVE = "0" * 64

def no_artifact(*args, **kwargs):
    raise AssertionError("Artifact access/creation reached before fail-closed guard")

with patch.object(Path, "read_bytes", no_artifact), patch.object(Path, "mkdir", no_artifact):
    try:
        reader.main()
    except ValueError as error:
        assert "Unbound cold receiver" in str(error)
    else:
        raise AssertionError("Missing SEALED accepted")
    reader.SEALED = reader.BASE / "outputs/NEUTRAL-sealed"
    assert "hpc_forest" not in sys.modules
    sys.modules["hpc_forest"] = ModuleType("hpc_forest")
    try:
        try:
            reader.main()
        except ValueError as error:
            assert "Previously loaded" in str(error)
        else:
            raise AssertionError("Previously loaded project module accepted")
    finally:
        del sys.modules["hpc_forest"]
print("PASS: SEALED and cached-module guards reject before archive reads or directory creation")

#include "knn.h"

static inline void swap_float(float *a, float *b) {
    float t = *a; *a = *b; *b = t;
}

static inline void swap_char(char *a, char *b) {
    char t = *a; *a = *b; *b = t;
}

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    float *distances = (float *) malloc(sizeof(float) * k);
    char *labels = (char *) malloc(sizeof(char) * k);

    for (int i = 0; i < k; i++) {
        distances[i] = FLT_MAX;
        labels[i] = -1;
    }

    float px = to_evaluate.x;
    float py = to_evaluate.y;

    for (int i = 0; i < n_groups; i++) {
        Group *g = &groups[i];
        int len = g->length;
        float *xs = g->xs;
        float *ys = g->ys;
        char lbl = g->label;

        #pragma omp simd private(dx, dy)
        for (int j = 0; j < len; j++) {
            float dx = xs[j] - px;
            float dy = ys[j] - py;
            float d = euclidean_distance_no_sqrt(dx, dy);

            if (d < distances[0]) {
                // replace root of max-heap and sift down
                distances[0] = d;
                labels[0] = lbl;

                int idx = 0;
                while (1) {
                    int left = 2*idx + 1;
                    if (left >= k) break;
                    int right = left + 1;
                    int largest = left;
                    if (right < k && distances[right] > distances[left]) {
                        largest = right;
                    }
                    if (distances[idx] >= distances[largest]) break;
                    swap_float(&distances[idx], &distances[largest]);
                    swap_char(&labels[idx], &labels[largest]);
                    idx = largest;
                }
            }
        }
    }

    qsort(labels, k, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (int i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }
            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    free(distances);
    free(labels);
    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();
    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

param([switch]$WithoutDev, [switch]$WithMcp)
$ErrorActionPreference = 'Stop'
$project = Split-Path -Parent $PSScriptRoot
$python = Join-Path $project '.venv\Scripts\python.exe'
if (-not (Test-Path -LiteralPath $python)) {
    python -m venv (Join-Path $project '.venv')
    if ($LASTEXITCODE -ne 0) { throw 'Creation de l environnement Python impossible.' }
}
$extras = if ($WithoutDev) { '' } else { 'dev' }
if ($WithMcp) { $extras = if ($extras) { "$extras,mcp" } else { 'mcp' } }
$package = if ($extras) { "${project}[$extras]" } else { $project }
& $python -m pip install --disable-pip-version-check -e $package
if ($LASTEXITCODE -ne 0) { throw 'Installation du projet impossible.' }
& $python -m hpc_forest doctor
if ($LASTEXITCODE -ne 0) { throw 'Un prerequis manque. Voir le diagnostic ci-dessus.' }

#include <cstdio>
#include <cstdlib>
#include <climits>
#include <algorithm>

static const int BUFSIZE = 1 << 20;
static char buf[BUFSIZE];
static int pos = 0, len = 0;

inline char getChar() {
    if (pos >= len) {
        len = fread(buf, 1, BUFSIZE, stdin);
        pos = 0;
    }
    return buf[pos++];
}

inline int readInt() {
    char c;
    do { c = getChar(); } while (c <= ' ');
    int sign = 1;
    if (c == '-') { sign = -1; c = getChar(); }
    int x = c - '0';
    for (;;) {
        c = getChar();
        if (c < '0' || c > '9') break;
        x = x * 10 + (c - '0');
    }
    return sign * x;
}

int main() {
    int n = readInt();
    int s = readInt();

    const size_t N = static_cast<size_t>(n) + 1;
    void* mem = nullptr;
    if (posix_memalign(&mem, 64, sizeof(long long) * N * N) != 0) return 1;
    long long* P = static_cast<long long*>(mem);

    // Initialize first row and column to zero.
    for (size_t j = 0; j < N; ++j) P[j] = 0;
    for (size_t i = 0; i < N; ++i) P[i * N] = 0;

    // Read matrix and compute 2D prefix sums.
    for (int i = 0; i < n; ++i) {
        const size_t curRow = static_cast<size_t>(i + 1) * N;
        const size_t prevRow = static_cast<size_t>(i) * N;
        for (int j = 0; j < n; ++j) {
            int val = readInt();
            P[curRow + j + 1] = static_cast<long long>(val)
                              + P[prevRow + j + 1]
                              + P[curRow + j]
                              - P[prevRow + j];
        }
    }

    long long mxSum = LLONG_MIN;
    const int limit_i = n - s;
    const int limit_j = n - s;

    #pragma omp parallel for reduction(max:mxSum) schedule(static)
    for (int i = 0; i <= limit_i; ++i) {
        const long long* base1 = &P[static_cast<size_t>(i) * N];
        const long long* base2 = &P[static_cast<size_t>(i + s) * N];
        long long rowBest = LLONG_MIN;
        #pragma omp simd reduction(max:rowBest)
        for (int j = 0; j <= limit_j; ++j) {
            long long sum = base2[j + s] - base1[j + s] - base2[j] + base1[j];
            if (sum > rowBest) rowBest = sum;
        }
        mxSum = std::max(mxSum, rowBest);
    }

    printf("%lld\n", mxSum);

    free(mem);
    return 0;
}

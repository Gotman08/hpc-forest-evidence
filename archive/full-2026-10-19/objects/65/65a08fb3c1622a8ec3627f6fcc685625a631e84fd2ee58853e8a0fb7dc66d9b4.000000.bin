#include "knn.h"
#ifdef _OPENMP
#include <omp.h>
#endif

#define DIST_CHUNK 64

static int is_worse(float da, long ia, float db, long ib) {
    return (da > db) || (da == db && ia > ib);
}

static void swap3(float *hd, long *hi, char *hl, int a, int b) {
    float td = hd[a]; hd[a] = hd[b]; hd[b] = td;
    long ti = hi[a]; hi[a] = hi[b]; hi[b] = ti;
    char tc = hl[a]; hl[a] = hl[b]; hl[b] = tc;
}

static void heap_push(float *hd, long *hi, char *hl, int *n,
                      float d, long idx, char label) {
    int i = (*n)++;
    hd[i] = d; hi[i] = idx; hl[i] = label;

    while (i > 0) {
        int parent = (i - 1) / 2;
        if (is_worse(hd[i], hi[i], hd[parent], hi[parent])) {
            swap3(hd, hi, hl, i, parent);
            i = parent;
        } else {
            break;
        }
    }
}

static void heap_replace_root(float *hd, long *hi, char *hl, int n,
                              float d, long idx, char label) {
    hd[0] = d; hi[0] = idx; hl[0] = label;
    int i = 0;

    for (;;) {
        int left = 2 * i + 1;
        if (left >= n) break;
        int right = left + 1;
        int worst = i;

        if (is_worse(hd[left], hi[left], hd[worst], hi[worst])) {
            worst = left;
        }
        if (right < n && is_worse(hd[right], hi[right], hd[worst], hi[worst])) {
            worst = right;
        }

        if (worst == i) break;
        swap3(hd, hi, hl, i, worst);
        i = worst;
    }
}

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    size_t total = 0;
    for (int gi = 0; gi < n_groups; ++gi) {
        total += (size_t)groups[gi].length;
    }

    float *xs = NULL;
    if (posix_memalign((void **)&xs, 64, total * sizeof(float)) != 0) {
        xs = malloc(total * sizeof(float));
    }
    float *ys = NULL;
    if (posix_memalign((void **)&ys, 64, total * sizeof(float)) != 0) {
        ys = malloc(total * sizeof(float));
    }
    char *plabels = (char *)malloc(total * sizeof(char));

    size_t pos = 0;
    for (int gi = 0; gi < n_groups; ++gi) {
        Group g = groups[gi];
        char lab = g.label;
        for (int j = 0; j < g.length; ++j) {
            xs[pos] = g.points[j].x;
            ys[pos] = g.points[j].y;
            plabels[pos] = lab;
            ++pos;
        }
    }

    float tx = to_evaluate.x;
    float ty = to_evaluate.y;

#ifdef _OPENMP
    int nthreads = omp_get_max_threads();
#else
    int nthreads = 1;
#endif

    /* Per-thread local max-heaps. Each thread keeps the best k points of its
       assigned chunk; merging these heaps afterwards yields the global top-k
       because any point not selected by its own chunk is dominated by at least
       k points from that same chunk, all of which are present in the union. */
    float *all_ld = (float *)malloc((size_t)nthreads * k * sizeof(float));
    long *all_li = (long *)malloc((size_t)nthreads * k * sizeof(long));
    char *all_ll = (char *)malloc((size_t)nthreads * k * sizeof(char));
    int *lns = (int *)calloc(nthreads, sizeof(int));

#pragma omp parallel
    {
        int t = 0;
#ifdef _OPENMP
        t = omp_get_thread_num();
#endif
        float *ld = all_ld + (size_t)t * k;
        long *li = all_li + (size_t)t * k;
        char *ll = all_ll + (size_t)t * k;
        int ln = 0;
        float dist_chunk[DIST_CHUNK] __attribute__((aligned(64)));

#pragma omp for schedule(static)
        for (long base = 0; base < (long)total; base += DIST_CHUNK) {
            long end = base + DIST_CHUNK;
            if (end > (long)total) end = (long)total;

#pragma omp simd aligned(xs, ys: 64)
            for (long p = base; p < end; ++p) {
                float dx = xs[p] - tx;
                float dy = ys[p] - ty;
                dist_chunk[p - base] = dx * dx + dy * dy;
            }

            for (long p = base; p < end; ++p) {
                float d = dist_chunk[p - base];
                if (ln < k) {
                    heap_push(ld, li, ll, &ln, d, p, plabels[p]);
                } else if (is_worse(ld[0], li[0], d, p)) {
                    heap_replace_root(ld, li, ll, k, d, p, plabels[p]);
                }
            }
        }

        lns[t] = ln;
    }

    float *heap_d = (float *)malloc(k * sizeof(float));
    long *heap_idx = (long *)malloc(k * sizeof(long));
    char *heap_lab = (char *)malloc(k * sizeof(char));
    int heap_n = 0;

    for (int t = 0; t < nthreads; ++t) {
        float *ld = all_ld + (size_t)t * k;
        long *li = all_li + (size_t)t * k;
        char *ll = all_ll + (size_t)t * k;
        for (int i = 0; i < lns[t]; ++i) {
            float d = ld[i];
            long idx = li[i];
            if (heap_n < k) {
                heap_push(heap_d, heap_idx, heap_lab, &heap_n,
                          d, idx, ll[i]);
            } else if (is_worse(heap_d[0], heap_idx[0], d, idx)) {
                heap_replace_root(heap_d, heap_idx, heap_lab, k,
                                  d, idx, ll[i]);
            }
        }
    }

    char *labels = (char *)malloc(k * sizeof(char));
    for (int i = 0; i < k; ++i) {
        if (i < heap_n) labels[i] = heap_lab[i];
        else labels[i] = -1;
    }

    qsort(labels, k, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (int i = 1; i < k; ++i) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }

            current_frequency = 1;
        } else {
            ++current_frequency;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    free(xs); free(ys); free(plabels);
    free(all_ld); free(all_li); free(all_ll); free(lns);
    free(heap_d); free(heap_idx); free(heap_lab); free(labels);

    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();

    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; ++i) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
    return 0;
}

+def latest_g_closure(value, pinned):
+    """Historical G closure is required separately from a new current CIM."""
+    expected=BASE / "outputs/HPC-Forest-Primes-Natif-Relance-r2g/RECEPTION-FINALE-ET-CLOTURE-VERIFIEE.json"
+    need(value is not None and pinned is not None and value==pinned
+         and artifact(value)==expected, "Canonical final G closure not yet received/pinned")
+    receipt=read(value)
+    need(receipt.get("schema")=="hpc-forest-r2g-final-metadata-and-owned-closure-v1"
+         and receipt.get("scope_id")=="hpc-forest-primes-native-max-r2g"
+         and receipt.get("source_zip_sha256")=="f8c2104bad52e3c298de596fd365415fbdfbbb12fbdc41b47b06a94ad68273fe"
+         and receipt.get("plan_sha256")=="5af07859f99192e169f2475fb2c863c9d4a05a4a8dba07845b3fcc54451e7dba"
+         and receipt.get("verified_metadata_only") is True
+         and all(receipt.get(k) is True for k in ("all_started_calls_delivery_reconciled", "all_three_terminal_jobs_received",
+             "owned_native_worker_interfaces_closed", "all_21_owned_identities_absent", "complete_cache_bytes_preserved_after_owned_stop"))
+         and receipt.get("native_research_admitted") is False and receipt.get("independent_performance_verified") is False,
+         "Full actual metadata/owned-close G boundary required; no scientific promotion")
+    refs=receipt.get("refs")
+    need(isinstance(refs,dict) and set(refs)=={"reception","recon","independent_review","owned_closure","post_stop_cache","final_CIM"},
+         "Exact six original G closure proof refs required")
+    for proof in refs.values():
+        artifact(proof)
+    return receipt

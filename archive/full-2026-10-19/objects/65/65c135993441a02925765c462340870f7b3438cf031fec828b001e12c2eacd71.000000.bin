    {
      "id": "ee5199465a9f4b23",
      "role": "A",
      "mission": {
        "base_commit": "3509df81099cdbc9598d58bc66afe1a5c1bfef1c",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Compact, reusable prefix-frequency storage should improve cache locality and eliminate per-band node allocations while preserving the baseline traversal.",
        "id": "ee5199465a9f4b23",
        "ordinal": 2,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/main.cpp"
          ],
          "retained": [
            "Replace unordered_map with contiguous 8-byte slots using linear probing, full-key equality and at most 50% occupancy.",
            "Reuse table storage across bands, clearing only occupied slots through a compact touched-index list.",
            "Preserve frequency[0]=1 and query-before-increment ordering, including when k=0."
          ]
        },
        "tree_id": "e1:A",
        "trial_id": "01M53VSMFG2TX42EXZ3NWRK9PH",
        "worktree": "/gpfs/scratch/nimarano/hpc-forest-gpt61sol-max-archive-matrix-20261015-r1-coverage-gpt-6.1-sol-max/results-749415/2023-sum/worktrees/ee5199465a9f4b23"

      "content": "#include <algorithm>\n#include <cstddef>\n#include <cstring>\n#include <iostream>\n#include <iterator>\n#include <string>\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ' )\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v') ;\n    }\n} ;\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase\n        ( std::remove_if\n            ( text.begin ()\n            , text.end ()\n            , IsWhitespace () )\n        , text.end () ) ;\n    return text ;\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator <char> begin (in), end ;\n    std::string text (begin, end) ;\n    text = remove_whitespaces (text) ;\n    return text ;\n}\n\nclass BufferedOutput\n{\npublic:\n    static const std::size_t capacity = 64u * 1024u ;\n\n    BufferedOutput () : used_ (0) {}\n\n    void append (const char* data, std::size_t count)\n    {\n        while (count != 0) {\n            std::size_t chunk = capacity - used_ ;\n            if (chunk > count) chunk = count ;\n            std::memcpy (buffer_ + used_, data, chunk) ;\n            used_ += chunk ;\n            data += chunk ;\n            count -= chunk ;\n            if (used_ == capacity) flush () ;\n        }\n    }\n\n    template <std::size_t HalfBytes>\n    void append_short_row (const char* data, std::size_t bytes)\n    {\n        // Dispatch guarantees HalfBytes <= bytes <= 2 * HalfBytes <= capacity.\n        if (bytes > capacity - used_) flush () ;\n        char* const destination = buffer_ + used_ ;\n        const std::size_t tail = bytes - HalfBytes ;\n\n        // Each copy stays inside the row and buffer. Overlapping destination\n        // bytes receive identical values; neither copy overlaps its source.\n        std::memcpy (destination, data, HalfBytes) ;\n        std::memcpy (destination + tail, data + tail, HalfBytes) ;\n        used_ += bytes ;\n    }\n\n    void flush ()\n    {\n        if (used_ != 0) {\n            std::cout.write\n                (buffer_, static_cast<std::streamsize> (used_)) ;\n            used_ = 0 ;\n        }\n    }\n\nprivate:\n    char buffer_ [capacity] ;\n    std::size_t used_ ;\n} ;\n\ntemplate <std::size_t Stride> inline bool\nadvance_permutation (char* symbols, std::size_t count)\n{\n    if (count < 2) return false ;\n\n    std::size_t suffix = count - 1 ;\n    while (suffix != 0\n        && !(symbols [(suffix - 1) * Stride]\n             < symbols [suffix * Stride])) {\n        -- suffix ;\n    }\n    if (suffix == 0) return false ;\n\n    const std::size_t pivot = suffix - 1 ;\n    const char pivot_value = symbols [pivot * Stride] ;\n    std::size_t successor = count - 1 ;\n    // The first suffix element is greater than the pivot, bounding this scan.\n    while (!(pivot_value < symbols [successor * Stride])) {\n        -- successor ;\n    }\n    symbols [pivot * Stride] = symbols [successor * Stride] ;\n    symbols [successor * Stride] = pivot_value ;\n\n    // Each reversal pair touches disjoint character slots.\n    const std::size_t pairs = (count - suffix) / 2 ;\n    for (std::size_t pair = 0 ; pair < pairs ; ++ pair) {\n        const std::size_t left = (suffix + pair) * Stride ;\n        const std::size_t right = (count - 1 - pair) * Stride ;\n        const char value = symbols [left] ;\n        symbols [left] = symbols [right] ;\n        symbols [right] = value ;\n    }\n    return true ;\n}\n\ntemplate <std::size_t HalfBytes> inline void\nemit_short_permutations (BufferedOutput& output, char* row,\n                         std::size_t row_size, std::size_t count)\n{\n    char* const symbols = row + 2 ;\n    // Only the record copies have fixed widths; permutation transitions remain\n    // sequential because each transition depends on the preceding permutation.\n    do {\n        output.append_short_row<HalfBytes> (row, row_size) ;\n    } while (advance_permutation<2> (symbols, count)) ;\n}\n\nvoid print_permutations (std::string& text)\n{\n    const std::size_t count = text.size () ;\n    if (count == 0) return ;\n    std::sort (text.begin (), text.end ()) ;\n\n    BufferedOutput output ;\n    std::string row ;\n    std::size_t row_limit = row.max_size () ;\n    if (row_limit > BufferedOutput::capacity) {\n        row_limit = BufferedOutput::capacity ;\n    }\n\n    // Bound storage and check the size calculation before forming 2 * count + 4.\n    if (row_limit >= 4 && count <= (row_limit - 4) / 2) {\n        const std::size_t row_size = 2 * count + 4 ;\n        row.assign (row_size, ' ') ;\n        row [0] = '[' ;\n        row [row_size - 2] = ']' ;\n        row [row_size - 1] = '\\n' ;\n\n        char* const row_data = &row [0] ;\n        char* const symbols = row_data + 2 ;\n        for (std::size_t i = 0 ; i < count ; ++ i) {\n            symbols [2 * i] = text [i] ;\n        }\n\n        // Select fixed-size head/tail copies once, outside enumeration.\n        // A nonempty input has a row of at least six bytes.\n        if (row_size <= 8) {\n            emit_short_permutations<4> (output, row_data, row_size, count) ;\n        } else if (row_size <= 16) {\n            emit_short_permutations<8> (output, row_data, row_size, count) ;\n        } else if (row_size <= 32) {\n            emit_short_permutations<16> (output, row_data, row_size, count) ;\n        } else if (row_size <= 64) {\n            emit_short_permutations<32> (output, row_data, row_size, count) ;\n        } else {\n            // Enumerate directly in the character slots; delimiters stay fixed.\n            do {\n                output.append (row.data (), row.size ()) ;\n            } while (advance_permutation<2> (symbols, count)) ;\n        }\n    } else {\n        // Oversized rows use the same bounded output buffer without a length limit.\n        char* const symbols = &text [0] ;\n        do {\n            output.append (\"[ \", 2) ;\n            for (std::size_t i = 0 ; i < count ; ++ i) {\n                const char item [2] = {symbols [i], ' '} ;\n                output.append (item, 2) ;\n            }\n            output.append (\"]\\n\", 2) ;\n        } while (advance_permutation<1> (symbols, count)) ;\n    }\n    output.flush () ;\n}\n\nint main (int argc, char const *argv [])\n{\n    std::string text = read_text_from_stdin <std::string> (std::cin) ;\n    print_permutations (text) ;\n    return 0 ;\n}\n",
      "path": "src/permutations.cc"
    }
  ],
  "hypothesis": "Replacing variable-length short-row copies with constant-size head/tail copies should enable inline ARM64 wide loads/stores and reduce per-permutation append overhead without vectorizing dependency-bearing permutation transitions.",

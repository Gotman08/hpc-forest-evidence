<th>Final déclaré (s)</th>
<th>Réduction déclarée</th>
<th>Audit archive complète</th>
</tr>
</thead>
<tbody>
<tr>
<td>deepseek-v4flash-knn</td>
<td>2.063095</td>
<td>0.027447</td>
<td>98.670 %</td>
<td>en attente</td>
</tr>
<tr>
<td>deepseek-v4flash-sum</td>
<td>0.131765</td>
<td>0.013483</td>
<td>89.767 %</td>
<td>en attente</td>
</tr>
<tr>
<td>deepseek-v4flash0731-knn</td>

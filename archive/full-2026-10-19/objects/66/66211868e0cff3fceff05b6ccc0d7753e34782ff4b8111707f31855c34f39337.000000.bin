#include <stdio.h>
#include <stdint.h>

#define MAXNUM 100
#define MAXRESULTS 1000
#define SUFFIX_SCALE 10000000U
#define DIVISOR_LIMIT 24514U

unsigned int firstHalf[MAXNUM];
unsigned int secondHalf[MAXNUM];
long int result[MAXRESULTS];
int numPrimes=0;

static uint16_t primeDivisors[DIVISOR_LIMIT / 2U + 1U];
static unsigned int numDivisors;

static void build_prime_divisors(void)
{
    unsigned char composite[DIVISOR_LIMIT / 2U + 1U] = {0};
    unsigned int factor, multiple;

    numDivisors = 0;
    for (factor = 3U; factor <= DIVISOR_LIMIT; factor += 2U) {
        if (composite[factor / 2U])
            continue;
        primeDivisors[numDivisors++] = (uint16_t)factor;
        for (multiple = factor * factor;
             multiple <= DIVISOR_LIMIT;
             multiple += 2U * factor)
            composite[multiple / 2U] = 1;
    }
}

int isprime(unsigned int value)
{
    unsigned int i;

    if (value < 2U)
        return 0;
    if ((value & 1U) == 0U)
        return value == 2U;
    for (i = 0; i < numDivisors; ++i) {
        unsigned int factor = primeDivisors[i];
        if ((uint64_t)factor * factor > value)
            return 1;
        if (value % factor == 0U)
            return 0;
    }
    return 1;
}

void quicksort(long int *primes,int first,int last)
{ int i, j, pivot;
  long int temp;

  if (first<last)
     { pivot=first;
       i=first;
       j=last;
       while(i<j)
         { while (primes[i]<=primes[pivot]&&i<last)
             i++;
           while(primes[j]>primes[pivot])
             j--;
           if (i<j)
              { temp=primes[i];
                primes[i]=primes[j];
                primes[j]=temp;
              }
         }
       temp=primes[pivot];
       primes[pivot]=primes[j];
       primes[j]=temp;
       quicksort(primes,first,j-1);
       quicksort(primes,j+1,last);
     }
}

int main(void)
{
    int i, j, numResults = 0;

    if (scanf("%d", &numPrimes) != 1)
        return 0;
    if (numPrimes < 1 || numPrimes > MAXNUM)
        return 0;
    for (i = 0; i < numPrimes; ++i) {
        if (scanf("%u", &firstHalf[i]) != 1)
            return 0;
        /* Preserve the certified seven-character suffix width. */
        firstHalf[i] *= SUFFIX_SCALE;
    }
    for (i = 0; i < numPrimes; ++i) {
        if (scanf("%u", &secondHalf[i]) != 1)
            return 0;
    }

    build_prime_divisors();
    for (i = 0; i < numPrimes; ++i) {
        unsigned int prefix = firstHalf[i];
        for (j = 0; j < numPrimes; ++j) {
            unsigned int primeToTest = prefix + secondHalf[j];
            if (isprime(primeToTest))
                result[numResults++] = (long int)primeToTest;
        }
    }
    quicksort(result, 0, numResults - 1);
    for (i = 0; i < numResults; ++i)
        printf("%ld\n", result[i]);
    return 0;
}

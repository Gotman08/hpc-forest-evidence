#include <cstdio>
#include <memory>
#include <vector>

class FastScanner {
    static constexpr int BUFSIZE = 1 << 20;
    int idx = 0;
    int size = 0;
    char buf[BUFSIZE];
public:
    inline char getChar() {
        if (idx >= size) {
            size = (int)fread(buf, 1, BUFSIZE, stdin);
            idx = 0;
            if (size == 0) return '\0';
        }
        return buf[idx++];
    }

    int nextInt() {
        char c;
        do { c = getChar(); } while (c <= ' ');
        int sign = 1;
        if (c == '-') {
            sign = -1;
            c = getChar();
        }
        int x = 0;
        while (c >= '0' && c <= '9') {
            x = x * 10 + (c - '0');
            c = getChar();
        }
        return sign * x;
    }
};

int main() {
    FastScanner fs;
    int n = fs.nextInt();
    int s = fs.nextInt();

    const size_t ringSize = (size_t)s + 1;
    std::unique_ptr<int[]> ring(new int[ringSize * (size_t)n]);
    std::vector<long long> col(n, 0);

    for (int r = 0; r < s; ++r) {
        int* row = &ring[(size_t)r * n];
        for (int j = 0; j < n; ++j) {
            row[j] = fs.nextInt();
        }
        #pragma omp simd
        for (int j = 0; j < n; ++j) {
            col[j] += row[j];
        }
    }

    long long cur = 0;
    for (int j = 0; j < s; ++j) cur += col[j];
    long long best = cur;

    int limit = n - s;
    for (int j = 1; j <= limit; ++j) {
        cur += col[j + s - 1] - col[j - 1];
        if (cur > best) best = cur;
    }

    for (int i = 1; i <= limit; ++i) {
        size_t outSlot = ((size_t)i - 1) % ringSize;
        const int* pout = &ring[outSlot * (size_t)n];

        size_t inRow = (size_t)i + s - 1;
        size_t inSlot = inRow % ringSize;
        int* pin = &ring[inSlot * (size_t)n];

        for (int j = 0; j < n; ++j) {
            pin[j] = fs.nextInt();
        }
        #pragma omp simd
        for (int j = 0; j < n; ++j) {
            col[j] += (long long)pin[j] - pout[j];
        }

        cur = 0;
        for (int j = 0; j < s; ++j) cur += col[j];
        if (cur > best) best = cur;

        for (int j = 1; j <= limit; ++j) {
            cur += col[j + s - 1] - col[j - 1];
            if (cur > best) best = cur;
        }
    }

    std::printf("%lld\n", (long long)best);
    return 0;
}

{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\nstatic void read_dataset(int *nbodies,\n                         float **px, float **py, float **pz,\n                         float **pvx, float **pvy, float **pvz) {\n    int n;\n    if (fread(&n, sizeof(n), 1, stdin) != 1) {\n        fprintf(stderr, \"\\nError reading nbodie value\\n\");\n        exit(EXIT_FAILURE);\n    }\n    *nbodies = n;\n\n    Body *tmp = (Body *)malloc((size_t)n * sizeof(Body));\n    if (!tmp) { perror(\"malloc\"); exit(EXIT_FAILURE); }\n\n    if (fread(tmp, (size_t)n * sizeof(Body), 1, stdin) != 1) {\n        fprintf(stderr, \"\\nError reading input values\\n\");\n        free(tmp);\n        exit(EXIT_FAILURE);\n    }\n\n    float *x = (float *)malloc((size_t)n * sizeof(float));\n    float *y = (float *)malloc((size_t)n * sizeof(float));\n    float *z = (float *)malloc((size_t)n * sizeof(float));\n    float *vx = (float *)malloc((size_t)n * sizeof(float));\n    float *vy = (float *)malloc((size_t)n * sizeof(float));\n    float *vz = (float *)malloc((size_t)n * sizeof(float));\n\n    if (!x || !y || !z || !vx || !vy || !vz) {\n        perror(\"malloc\");\n        exit(EXIT_FAILURE);\n    }\n\n    for (int i = 0; i < n; ++i) {\n        x[i] = tmp[i].x;\n        y[i] = tmp[i].y;\n        z[i] = tmp[i].z;\n        vx[i] = tmp[i].vx;\n        vy[i] = tmp[i].vy;\n        vz[i] = tmp[i].vz;\n    }\n\n    free(tmp);\n\n    *px = x; *py = y; *pz = z;\n    *pvx = vx; *pvy = vy; *pvz = vz;\n}\n\nstatic void write_dataset(int nbodies,\n                          const float *x, const float *y, const float *z,\n                          const float *vx, const float *vy, const float *vz) {\n    Body *out = (Body *)malloc((size_t)nbodies * sizeof(Body));\n    if (!out) { perror(\"malloc\"); exit(EXIT_FAILURE); }\n\n    for (int i = 0; i < nbodies; ++i) {\n        out[i].x = x[i];\n        out[i].y = y[i];\n        out[i].z = z[i];\n        out[i].vx = vx[i];\n        out[i].vy = vy[i];\n        out[i].vz = vz[i];\n    }\n\n    if (fwrite(out, (size_t)nbodies * sizeof(Body), 1, stdout) != 1) {\n        fprintf(stderr, \"\\nError writing to output\\n\");\n        free(out);\n        exit(EXIT_FAILURE);\n    }\n    free(out);\n}\n\nstatic void body_force(const float *restrict x,\n                       const float *restrict y,\n                       const float *restrict z,\n                       float *restrict vx,\n                       float *restrict vy,\n                       float *restrict vz,\n                       int n, float dt) {\n#pragma omp parallel for schedule(static)\n    for (int i = 0; i < n; ++i) {\n        const float xi = x[i];\n        const float yi = y[i];\n        const float zi = z[i];\n\n        float fx = 0.0f;\n        float fy = 0.0f;\n        float fz = 0.0f;\n\n        int j = 0;\n\n        // Unroll the inner loop by 4 to reduce overhead and improve ILP.\n        for (; j + 4 <= n; j += 4) {\n            // body j\n            float dx = x[j] - xi;\n            float dy = y[j] - yi;\n            float dz = z[j] - zi;\n            float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n            float inv_dist = 1 / sqrt(sqrd_dist);\n            float inv_dist3 = inv_dist * inv_dist * inv_dist;\n            fx += dx * inv_dist3;\n            fy += dy * inv_dist3;\n            fz += dz * inv_dist3;\n\n            // body j+1\n            dx = x[j+1] - xi;\n            dy = y[j+1] - yi;\n            dz = z[j+1] - zi;\n            sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n            inv_dist = 1 / sqrt(sqrd_dist);\n            inv_dist3 = inv_dist * inv_dist * inv_dist;\n            fx += dx * inv_dist3;\n            fy += dy * inv_dist3;\n            fz += dz * inv_dist3;\n\n            // body j+2\n            dx = x[j+2] - xi;\n            dy = y[j+2] - yi;\n            dz = z[j+2] - zi;\n            sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n            inv_dist = 1 / sqrt(sqrd_dist);\n            inv_dist3 = inv_dist * inv_dist * inv_dist;\n            fx += dx * inv_dist3;\n            fy += dy * inv_dist3;\n            fz += dz * inv_dist3;\n\n            // body j+3\n            dx = x[j+3] - xi;\n            dy = y[j+3] - yi;\n            dz = z[j+3] - zi;\n            sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n            inv_dist = 1 / sqrt(sqrd_dist);\n            inv_dist3 = inv_dist * inv_dist * inv_dist;\n            fx += dx * inv_dist3;\n            fy += dy * inv_dist3;\n            fz += dz * inv_dist3;\n        }\n\n        // Remainder\n        for (; j < n; ++j) {\n            float dx = x[j] - xi;\n            float dy = y[j] - yi;\n            float dz = z[j] - zi;\n            float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n            float inv_dist = 1 / sqrt(sqrd_dist);\n            float inv_dist3 = inv_dist * inv_dist * inv_dist;\n            fx += dx * inv_dist3;\n            fy += dy * inv_dist3;\n            fz += dz * inv_dist3;\n        }\n\n        vx[i] += dt*fx;\n        vy[i] += dt*fy;\n        vz[i] += dt*fz;\n    }\n}\n\nint main(int argc, char **argv) {\n    int nbodies;\n    float *x, *y, *z, *vx, *vy, *vz;\n\n    read_dataset(&nbodies, &x, &y, &z, &vx, &vy, &vz);\n\n    for (int iter = 0; iter < N_ITER; ++iter) {\n        body_force(x, y, z, vx, vy, vz, nbodies, DT);\n\n#pragma omp parallel for schedule(static)\n        for (int i = 0; i < nbodies; ++i) {\n            x[i] += vx[i] * DT;\n            y[i] += vy[i] * DT;\n            z[i] += vz[i] * DT;\n        }\n    }\n\n    write_dataset(nbodies, x, y, z, vx, vy, vz);\n\n    free(x); free(y); free(z);\n    free(vx); free(vy); free(vz);\n\n    return 0;\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Combining structure-of-arrays (SoA) data layout with OpenMP parallelization over bodies and a manually unrolled inner j-loop (by 4) improves instruction-level parallelism and reduces loop overhead while preserving the exact per-body floating-point summation order. The SoA layout makes each coordinate stream contiguous for better cache-line utilization, and the unrolling keeps all arithmetic operations in the same sequence as the reference, ensuring bit-identical output.",
  "notes": "The transformation retains the original sequential j-order for every body: even with unrolling, contributions are added one after another (j, j+1, j+2, j+3) and then the remainder loop continues from the next index. The use of restrict pointers helps the compiler optimize memory accesses without changing FP semantics. Input/output conversion between AoS and SoA is done only at boundaries, adding negligible O(n) overhead compared to the O(n^2) force computation.",

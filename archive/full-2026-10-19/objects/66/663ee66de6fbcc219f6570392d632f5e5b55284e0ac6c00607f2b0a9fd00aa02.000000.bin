#include <iostream>
#include <vector>
#include <omp.h>

using namespace std;

const int MOD = 1000000007;

int main() {
    int n, m;
    if (!(cin >> n >> m)) return 0;

    vector<vector<bool>> blockedCells(n, vector<bool>(n, false));
    for (int c = 0; c < m; ++c) {
        int i, j;
        cin >> i >> j;
        blockedCells[i][j] = true;
    }

    vector<int> dp(n, 0);
    if (!blockedCells[0][0]) dp[0] = 1;
    for (int j = 1; j < n; ++j) {
        dp[j] = blockedCells[0][j] ? 0 : dp[j - 1];
    }

    if (n > 1) {
#pragma omp parallel
        {
            const int threads = omp_get_num_threads();
            const int tid = omp_get_thread_num();
            const int begin = static_cast<int>((static_cast<long long>(n) * tid) / threads);
            const int end = static_cast<int>((static_cast<long long>(n) * (tid + 1)) / threads);
            static vector<int> tails;
            static vector<int> firstBlocked;
            static vector<int> offsets;

#pragma omp single
            {
                tails.resize(threads);
                firstBlocked.resize(threads);
                offsets.resize(threads);
            }

            for (int i = 1; i < n; ++i) {
                int value = 0;
                int first = end;
                for (int j = begin; j < end; ++j) {
                    if (blockedCells[i][j]) {
                        value = 0;
                        if (first == end) first = j;
                    } else {
                        value += dp[j];
                        if (value >= MOD) value -= MOD;
                    }
                    dp[j] = value;
                }
                tails[tid] = value;
                firstBlocked[tid] = first;

#pragma omp barrier
#pragma omp single
                {
                    int carry = 0;
                    for (int t = 0; t < threads; ++t) {
                        offsets[t] = carry;
                        if (firstBlocked[t] == static_cast<int>((static_cast<long long>(n) * (t + 1)) / threads)) {
                            carry += tails[t];
                            if (carry >= MOD) carry -= MOD;
                        } else {
                            carry = tails[t];
                        }
                    }
                }

                const int stop = firstBlocked[tid];
                const int offset = offsets[tid];
                if (offset != 0) {
                    for (int j = begin; j < stop; ++j) {
                        int valueWithCarry = dp[j] + offset;
                        dp[j] = valueWithCarry >= MOD ? valueWithCarry - MOD : valueWithCarry;
                    }
                }
#pragma omp barrier
            }
        }
    }

    cout << dp[n - 1] << '\n';
    return 0;
}

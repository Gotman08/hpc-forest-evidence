      "content": "#include <algorithm>\n#include <cstddef>\n#include <iostream>\n#include <vector>\n\nnamespace {\nconst int MOD = 1000000007;\n\ntemplate <int Rows>\ninline void openSpan(int* dp, int begin, int end, int (&left)[Rows]) {\n    int x = begin;\n    for (; x + 1 < end; x += 2) {\n        int first = dp[x];\n        int second = dp[x + 1];\n        for (int row = 0; row < Rows; ++row) {\n            first += left[row];\n            if (first >= MOD) first -= MOD;\n            second += first;\n            if (second >= MOD) second -= MOD;\n            left[row] = second;\n        }\n        dp[x] = first;\n        dp[x + 1] = second;\n    }\n    if (x < end) {\n        int value = dp[x];\n        for (int row = 0; row < Rows; ++row) {\n            value += left[row];\n            if (value >= MOD) value -= MOD;\n            left[row] = value;\n        }\n        dp[x] = value;\n    }\n}\n\ntemplate <int Rows>\nvoid processBand(int* dp, int n, const std::vector<unsigned int>& events) {\n    int left[Rows] = {0};\n    int nextColumn = 0;\n    std::size_t event = 0;\n\n    while (event < events.size()) {\n        const int column = static_cast<int>(events[event] >> 2);\n        openSpan<Rows>(dp, nextColumn, column, left);\n\n        unsigned int mask = 0;\n        do {\n            mask |= 1u << (events[event] & 3u);\n            ++event;\n        } while (event < events.size() &&\n                 static_cast<int>(events[event] >> 2) == column);\n\n        int value = dp[column];\n        for (int row = 0; row < Rows; ++row) {\n            if (mask & (1u << row)) {\n                value = 0;\n            } else {\n                value += left[row];\n                if (value >= MOD) value -= MOD;\n            }\n            left[row] = value;\n        }\n        dp[column] = value;\n        nextColumn = column + 1;\n    }\n    openSpan<Rows>(dp, nextColumn, n, left);\n}\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(0);\n\n    int n, m;\n    if (!(std::cin >> n >> m)) return 0;\n\n    const int bandCount = (n + 3) / 4;\n    std::vector<std::vector<unsigned int> > blockers(bandCount);\n    for (int i = 0; i < m; ++i) {\n        int y, x;\n        std::cin >> y >> x;\n        blockers[y / 4].push_back(\n            (static_cast<unsigned int>(x) << 2) |\n            static_cast<unsigned int>(y & 3));\n    }\n\n    std::vector<int> dp(n, 0);\n    dp[0] = 1;\n    for (int band = 0; band < bandCount; ++band) {\n        std::vector<unsigned int>& events = blockers[band];\n        std::sort(events.begin(), events.end());\n        const int rows = std::min(4, n - 4 * band);\n        switch (rows) {\n            case 4: processBand<4>(&dp[0], n, events); break;\n            case 3: processBand<3>(&dp[0], n, events); break;\n            case 2: processBand<2>(&dp[0], n, events); break;\n            case 1: processBand<1>(&dp[0], n, events); break;\n        }\n    }\n\n    std::cout << dp[n - 1] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

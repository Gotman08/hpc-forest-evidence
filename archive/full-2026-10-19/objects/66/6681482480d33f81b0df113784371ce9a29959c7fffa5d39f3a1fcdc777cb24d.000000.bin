    {
      "id": "6d55b5b003ef4059",
      "role": "A",
      "mission": {
        "base_commit": "ac6798963b13b6b7073cb45c8adc7ebcfb1a6406",
        "delegation_parent": "R/A",
        "depth": 1,
        "epoch": 1,
        "hypothesis": "Storing the smaller dimension as the paired axis and scanning contiguous slices along the larger dimension improves locality; a blocked transpose for tall matrices and a cache-resident generation-tagged frequency table reduce repeated strided access and allocation overhead.",
        "id": "6d55b5b003ef4059",
        "ordinal": 2,
        "parent_id": null,
        "role": "A",
        "source_commits": [],
        "sources": [],
        "transformations": {
          "files": [
            "src/main.cpp"
          ],
          "retained": [
            "Use the smaller matrix dimension for boundary pairs and directly accumulate each pair into a contiguous scratch vector.",
            "Block-transpose tall input matrices so each subsequent scan traverses contiguous memory.",
            "Replace the per-pair unordered_map with a fixed-size, generation-tagged open-addressed table; retain a 64-bit total count."
          ]
        },

        ],
        "transformations": {
          "files": [
            "src/main.cpp"
          ],
          "retained": [
            "Pair boundaries along the smaller matrix dimension, using rolling band sums and contiguous scans; block-transpose tall matrices first.",
            "Use a reusable, power-of-two open-addressed frequency table with signed 64-bit keys/counts and generation stamps.",
            "Dynamically parallelize independent band starts with a 64-bit answer reduction and a work threshold for small inputs.",
            "Apply SIMD only to independent band-accumulator elements; keep prefix scanning sequential."
          ]
        },

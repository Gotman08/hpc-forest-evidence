      {
        "name": "mcp_issue_report",
        "title": null,
        "description": "Signale un defaut observe du MCP ROMEO. diagnostic choisit un libelle technique controle : seules categorie, nom d'outil et versions majeures/mineures sont transmis sur GitHub. Resume, observation, attendu, reproduction et erreur libre restent filtres et locaux ; ne pas y mettre de donnees personnelles. Publication avec accord persistant seulement, recherche des doublons et relecture verifiee. Ne pas signaler les outils mcp_issue_* ou un simple echec du programme utilisateur.",
        "inputSchema": {
          "properties": {
            "tool_name": {
              "title": "Tool Name",
              "type": "string"
            },
            "summary": {
              "title": "Summary",
              "type": "string"
            },
            "observed": {
              "title": "Observed",
              "type": "string"
            },
            "expected": {
              "title": "Expected",
              "type": "string"
            },
            "steps": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Steps"
            },
            "category": {
              "default": "bug",
              "enum": [
                "bug",
                "performance",
                "maintainability",
                "documentation"
              ],
              "title": "Category",
              "type": "string"
            },
            "error_code": {
              "default": "",
              "title": "Error Code",
              "type": "string"
            },
            "diagnostic": {
              "default": "unexpected_behavior",
              "enum": [
                "unexpected_behavior",
                "internal_error",
                "invalid_result",
                "missing_option",
                "timeout",
                "connection_failure",
                "incorrect_measurement",
                "slow_operation",
                "documentation_mismatch",
                "display_problem"
              ],
              "title": "Diagnostic",
              "type": "string"
            }
          },
          "required": [
            "tool_name",
            "summary",
            "observed",
            "expected"

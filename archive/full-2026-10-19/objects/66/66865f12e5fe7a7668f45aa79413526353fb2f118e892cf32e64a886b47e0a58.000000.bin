      {
        "name": "service_prepare",
        "title": null,
        "description": "Prepare un service dans un venv existant, sans installation ni soumission. Enregistre localement le script exact, les ressources et la configuration pour 24 h. Jupyter et vLLM generent leur jeton prive au demarrage. Aucun tunnel n'est ouvert.",
        "inputSchema": {
          "properties": {
            "config": {
              "discriminator": {
                "mapping": {
                  "jupyter": "#/$defs/JupyterConfig",
                  "mlflow": "#/$defs/MlflowConfig",
                  "tensorboard": "#/$defs/TensorboardConfig",
                  "vllm": "#/$defs/VllmConfig"
                },
                "propertyName": "service"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/JupyterConfig"
                },
                {
                  "$ref": "#/$defs/TensorboardConfig"
                },
                {
                  "$ref": "#/$defs/VllmConfig"
                },
                {
                  "$ref": "#/$defs/MlflowConfig"
                }
              ],
              "title": "Config"
            },
            "time_limit": {
              "default": "2h",
              "title": "Time Limit",
              "type": "string"
            },
            "arch": {
              "default": "armgpu",
              "title": "Arch",
              "type": "string"
            },
            "gpus_per_node": {
              "default": 0,
              "title": "Gpus Per Node",
              "type": "integer"
            },
            "cpus_per_task": {
              "default": 16,
              "title": "Cpus Per Task",
              "type": "integer"
            },
            "workdir": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Workdir"
            },
            "spack_packages": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Spack Packages"
            }
          },
          "required": [
            "config"
          ],
          "type": "object",
          "$defs": {
            "JupyterConfig": {
              "additionalProperties": false,
              "properties": {
                "env_path": {
                  "description": "Venv existant de la meme architecture, service deja installe.",
                  "minLength": 1,
                  "title": "Env Path",
                  "type": "string"
                },
                "port": {
                  "default": 8888,
                  "maximum": 65535,
                  "minimum": 1024,
                  "title": "Port",
                  "type": "integer"
                },
                "service": {
                  "const": "jupyter",
                  "title": "Service",
                  "type": "string"
                }
              },
              "required": [
                "env_path",
                "service"
              ],
              "title": "JupyterConfig",
              "type": "object"
            },
            "MlflowConfig": {
              "additionalProperties": false,
              "properties": {
                "env_path": {
                  "description": "Venv existant de la meme architecture, service deja installe.",
                  "minLength": 1,
                  "title": "Env Path",
                  "type": "string"
                },
                "port": {
                  "default": 8888,
                  "maximum": 65535,
                  "minimum": 1024,
                  "title": "Port",
                  "type": "integer"
                },
                "service": {
                  "const": "mlflow",
                  "title": "Service",
                  "type": "string"
                }
              },
              "required": [
                "env_path",
                "service"
              ],
              "title": "MlflowConfig",
              "type": "object"
            },
            "TensorboardConfig": {
              "additionalProperties": false,
              "properties": {
                "env_path": {
                  "description": "Venv existant de la meme architecture, service deja installe.",
                  "minLength": 1,
                  "title": "Env Path",
                  "type": "string"
                },
                "port": {
                  "default": 8888,
                  "maximum": 65535,
                  "minimum": 1024,
                  "title": "Port",
                  "type": "integer"
                },
                "service": {
                  "const": "tensorboard",
                  "title": "Service",
                  "type": "string"
                },
                "logdir": {
                  "minLength": 1,
                  "title": "Logdir",
                  "type": "string"
                }
              },
              "required": [
                "env_path",
                "service",
                "logdir"
              ],
              "title": "TensorboardConfig",
              "type": "object"
            },
            "VllmConfig": {
              "additionalProperties": false,
              "properties": {
                "env_path": {
                  "description": "Venv existant de la meme architecture, service deja installe.",
                  "minLength": 1,
                  "title": "Env Path",
                  "type": "string"
                },
                "port": {
                  "default": 8888,
                  "maximum": 65535,
                  "minimum": 1024,
                  "title": "Port",
                  "type": "integer"
                },
                "service": {
                  "const": "vllm",
                  "title": "Service",
                  "type": "string"
                },
                "model": {
                  "minLength": 1,
                  "title": "Model",
                  "type": "string"
                }
              },
              "required": [
                "env_path",
                "service",
                "model"
              ],
              "title": "VllmConfig",
              "type": "object"
            }
          },
          "title": "service_prepareArguments"

"""Prepare unbound pure parent collectors; no live census, cache, auth or transport."""
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
BASE = HERE.parents[2]
OLD = BASE / 'outputs/HPC-Forest-Primes-Natif-Relance-r2f/operations-parent/collecteurs-r2f-r3'
R4 = OLD.parent / 'recepteur-initial-r4/recevoir-installation-oauth.py'
OUT = HERE / 'collecteurs-r2g-r1'
FACTORY = BASE / 'outputs/HPC-Forest-Primes-Natif-Lancement-r2g/revision-r1'


def digest(raw):
    return hashlib.sha256(raw).hexdigest()


def main():
    assert not OUT.exists()
    factory = json.loads((FACTORY / 'MANIFESTE-FACTORY-LOCALE.json').read_text('utf8'))
    old_manifest = json.loads((OLD / 'MANIFESTE-COLLECTEURS-REELS.json').read_text('utf8'))
    assert digest((OLD / 'MANIFESTE-COLLECTEURS-REELS.json').read_bytes()) == '3769181e7046c1d6611004d2fab2aa0cead5a1aa25ef1e4d1982f8298ffd8282'
    names = ['commun.py', 'preparer-intentions-natives.py', 'construire-observations-parent.py', 'produire-current-r4.py']
    originals = {name: (OLD / name).read_bytes() for name in names}
    assert all(digest(raw) == old_manifest['components'][name] for name, raw in originals.items())
    assert digest(R4.read_bytes()) == '9dda2b9adc02ffaa630ea425b24dd76629aae2b9767a6883b8ab51d997534fc5'
    originals['recevoir-installation-oauth.py'] = R4.read_bytes()
    replacements = {
        'HPC-Forest-Primes-Natif-Relance-r2f': 'HPC-Forest-Primes-Natif-Relance-r2g',
        'HPC-Forest-Primes-Natif-Lancement-r2f': 'HPC-Forest-Primes-Natif-Lancement-r2g',
        'hpc-forest-primes-native-max-r2f': 'hpc-forest-primes-native-max-r2g',
        '5aeceff56b26452290325ed4274d71bd': '110cefccf16b439eb226e475c875c8df',
        'e7c86715f4d34e9f9efcdcc4ce2a81c8': '5d8811082a1842f5836a2bdda982500f',
        '1294453607b34c68ba05872072640120': '13eaca4e39cf4147a3f677a32fb5a52d',
        '47f97afabcd6d10c5e95a1dc3aae0a34b0841183919785a6bd62d58aa1e90d75': 'f8c2104bad52e3c298de596fd365415fbdfbbb12fbdc41b47b06a94ad68273fe',
        '8d91ebe83ab550ad50acc330f830e1bc86bcc67f66b88054538df6b394558450': '5af07859f99192e169f2475fb2c863c9d4a05a4a8dba07845b3fcc54451e7dba',
        '67ca844efe21ac45d079cdb18397f228b80a75c53e52caa719864c0d51c8b8c4': factory['components']['preparer-cellule-max.py'],
        '9449b360ed8608e3858d0e332db150cffc2e27b22421c412d3005fcc4c849715': factory['components']['assembler-admissions-cellule.py'],
        '02d5c177112ee1d2784c6c93cf15436a646c94206b2785bb5c0b21b5b219b219': 'UNBOUND_FUTURE_R2G_FACTORY_REVIEW',
        'aa6d297e2dfa25c2437aadf297969e82bcef12583f1c5c9a6d00d2def81dffbd': 'UNBOUND_FUTURE_R2G_THREE_SCRIPT_REVIEW',
        'da2ea270c6dd4744658548e4e784004801fd506690ff17169a1252737023df43': 'UNBOUND_FUTURE_R2G_REAL_Q_BINDINGS',
        '68c73ab55abec17d6dd8753b96d607e165a106ea08203c470185346764b43edd': 'UNBOUND_FUTURE_R2G_ASTRA_SCRIPT',
        '94abb70703890988706d8f794a20603de1776c2deff4301d01331a56de338712': 'UNBOUND_FUTURE_R2G_TERRA_SCRIPT',
        'ff52b526b825e817f64b01d39613e314042ce8b42fb7fcdcbeb0b67ea71e1ba0': 'UNBOUND_FUTURE_R2G_SOL_SCRIPT',
        'REVUE-FACTORY-R2F-SCELLEE.json': 'REVUE-FACTORY-R2G-SCELLEE.json',
        'source109': 'source110',
    }
    texts = {}
    for name, raw in originals.items():
        text = raw.decode('utf8')
        for before, after in replacements.items():
            text = text.replace(before, after)
        texts[name] = text
    common = texts['commun.py']
    common = common.replace("DEADLINE = datetime(2026, 10, 31, 23, tzinfo=UTC).timestamp()",
        "PRIOR_F_CLOSURE = OPS / 'ADMISSION-FERMETURE-R2F.json'\n"
        "PRIOR_F_CLOSURE_SHA = 'UNBOUND_FUTURE_RECONCILED_AND_STOPPED_R2F_CLOSURE'\n"
        "DEADLINE = datetime(2026, 10, 31, 23, tzinfo=UTC).timestamp()")
    common = common.replace('    module.lane_module().verify_historical_r2d_closure()\n    return module',
        '    module.lane_module().verify_historical_r2d_closure()\n    prior_f_closure_refs()\n    return module')
    common += '''

def prior_f_closure_refs():
    """New received F closure admission; never substitute the historical R2d receipt."""
    pinned(PRIOR_F_CLOSURE, PRIOR_F_CLOSURE_SHA)
    value = read(PRIOR_F_CLOSURE)
    fields = {'schema', 'verified', 'scope_id', 'metadata_audit', 'reconciliation',
        'independent_audit', 'owned_stop', 'absence_after_stop',
        'all_started_calls_reconciled_before_owned_stop', 'new_generation_authorized_by_this_receipt'}
    need(set(value) == fields and value['schema'] == 'hpc-forest-r2g-prior-r2f-closure-admission-v1'
        and value['verified'] is True and value['scope_id'] == 'hpc-forest-primes-native-max-r2f'
        and value['all_started_calls_reconciled_before_owned_stop'] is True
        and value['new_generation_authorized_by_this_receipt'] is False,
        'Exact separately received/reconciled/stopped F closure admission required')
    expected = {'metadata_audit': 'dce71c4c8231f383343ca58116fe1740cec1eeb58eead21eb75d8ae465afa162',
        'reconciliation': '92ac79ab7bded0d888ba1b18d00ed9ca3131b7d1cbfabe63818de180a3cdd625',
        'independent_audit': 'aeab727b13fce653d5706c8117028e376b444419ab08a579af899ec47897f3da'}
    refs = [ref(PRIOR_F_CLOSURE)]
    for key in ('metadata_audit', 'reconciliation', 'independent_audit', 'owned_stop', 'absence_after_stop'):
        item = value[key]
        need(isinstance(item, dict) and set(item) == {'path', 'sha256'}, 'Closed F evidence reference required')
        need(ref(Path(item['path'])) == item and (key not in expected or item['sha256'] == expected[key]),
            'F closure evidence differs from the separately audited actual cohort')
        refs.append(item)
    return refs
'''
    common = common.replace('    return [ref(decision), ref(agreement), ref(effect), ref(review)]',
        '    return [ref(decision), ref(agreement), ref(effect), ref(review), *prior_f_closure_refs()]')
    texts['commun.py'] = common
    new_common = digest(common.encode())
    old_common = digest(originals['commun.py'])
    for name in ('preparer-intentions-natives.py', 'construire-observations-parent.py', 'recevoir-installation-oauth.py'):
        texts[name] = texts[name].replace(old_common, new_common)
    texts['recevoir-installation-oauth.py'] = texts['recevoir-installation-oauth.py'].replace(
        "COMMON = HERE.parent / 'collecteurs-r2f-r3/commun.py'", "COMMON = HERE / 'commun.py'")
    OUT.mkdir()
    for name, text in texts.items():
        compile(text, '<prepared-G-parent-pure-component>', 'exec')
        with (OUT / name).open('x', encoding='utf8', newline='\n') as stream:
            stream.write(text)
    with (OUT / 'DERIVATION-PREPAREE-NON-ADMISE.json').open('x', encoding='utf8', newline='\n') as stream:
        stream.write(json.dumps({'schema': 'hpc-forest-r2g-parent-pure-collectors-prepared-v1',
            'source_ancestor_pins': {name: digest(raw) for name, raw in originals.items()},
            'components': {name: digest((OUT / name).read_bytes()) for name in texts},
            'scope_and_actual_source_plan_replacements': replacements,
            'prior_F_closure_required_separately_from_historical_R2d': True,
            'seven_future_proof_pins_UNBOUND': True,
            'production_admitted': False, 'native_research_admitted': False,
            'CLI_model_process_CIM_auth_live_cache_or_transport_effect': False}, ensure_ascii=False, indent=2) + '\n')
    print(json.dumps({'output': str(OUT.resolve()), 'prepared_only': True}))


if __name__ == '__main__':
    main()

#include <stdio.h>
#include <stdlib.h>
#include <assert.h>
#include <string.h>

typedef struct {
    long int *data;
    int length;
    long int total;
} bucket;

static int compare_indices(const char *a, int length, long int left, long int right) {
    return strcmp(a + left * length, a + right * length);
}

static void sift_down(char *a, bucket *b, long int root, long int end) {
    for (;;) {
        long int child;
        long int tmp;

        if (root > end / 2)
            return;

        child = root * 2 + 1;
        if (child > end)
            return;
        if (child < end &&
            compare_indices(a, b->length, b->data[child], b->data[child + 1]) < 0)
            child++;
        if (compare_indices(a, b->length, b->data[root], b->data[child]) >= 0)
            return;

        tmp = b->data[root];
        b->data[root] = b->data[child];
        b->data[child] = tmp;
        root = child;
    }
}

static void sort(char *a, bucket *b) {
    long int start;
    long int end;
    long int tmp;

    if (b->total < 2)
        return;

    for (start = b->total / 2; start > 0;) {
        --start;
        sift_down(a, b, start, b->total - 1);
    }

    for (end = b->total - 1; end > 0; --end) {
        tmp = b->data[0];
        b->data[0] = b->data[end];
        b->data[end] = tmp;
        sift_down(a, b, 0, end - 1);
    }
}

long int* bucket_sort(char *a, int length, long int size, int offset, int nbuckets) {
    long int i;
    long int next;
    bucket *buckets = NULL;
    bucket *b = NULL;
    long int *returns = NULL;

    returns = (long int *) malloc(sizeof(long int) * (size > 0 ? (size_t) size : 1));
    buckets = (bucket *) malloc(sizeof(bucket) * (size_t) nbuckets);

    for (i = 0; i < nbuckets; i++) {
        buckets[i].data = NULL;
        buckets[i].length = length;
        buckets[i].total = 0;
    }

    /* Count first so every bucket receives a correctly sized slice. */
    for (i = 0; i < size; i++) {
        int bucket_index = *(a + i * length) - offset;
        buckets[bucket_index].total++;
    }

    next = 0;
    for (i = 0; i < nbuckets; i++) {
        long int count = buckets[i].total;
        buckets[i].data = returns + next;
        buckets[i].total = 0;
        next += count;
    }

    for (i = 0; i < size; i++) {
        b = &buckets[*(a + i * length) - offset];
        b->data[b->total++] = i;
    }

    /* Buckets are independent; dynamic scheduling balances skewed workloads. */
    #pragma omp parallel for schedule(dynamic, 1) if (nbuckets > 1 && size >= 1024)
    for (long int bucket_index = 0; bucket_index < nbuckets; bucket_index++)
        sort(a, &buckets[bucket_index]);

    free(buckets);
    return returns;
}

void load(char **vString, long int *N, int *l, int *os, int *nb) {
    char *strings = NULL;
    int len;
    int offset;
    int nbucket;
    long int n;

    if (!fscanf(stdin, "%d", &len)) {
        printf("ERROR len\n");
        exit(1);
    }

    if (!fscanf(stdin, "%ld", &n)) {
        printf("ERROR n\n");
        exit(1);
    }

    if (!fscanf(stdin, "%d", &offset)) {
        printf("ERROR offset\n");
        exit(1);
    }

    if (!fscanf(stdin, "%d", &nbucket)) {
        printf("ERROR nbucket\n");
        exit(1);
    }

    nbucket = nbucket + 1;
    len = len + 1;

    strings = (char*) malloc(n * len);

    for (int i = 0; i < n; i++) {
        if (!fscanf(stdin, "%s", strings + (i * len))) {
            printf("ERROR %d\n", i);
            exit(1);
        }
    }

    *vString = strings;
    *N = n;
    *l = len;
    *os = offset;
    *nb = nbucket;
}

void print(char *strings, long int *index, long int n, int len) {
    for (int i = 0; i < n; i++) {
        printf("%d -> %s\n", i, strings + (index[i] * len));
    }
}

void save(char *strings, long int *index, long int n, int len) {
    for (int i = 0; i < n; i++) {
        printf("%s\n", strings + (index[i] * len));
    }
}

int main(int ac, char **av) {
    char *strings = NULL;
    long int N = 0;
    long int *index = NULL;
    int len = 0;
    int save2File = 0;
    int offset;
    int nbuckets;

    load(&strings, &N, &len, &offset, &nbuckets);

    index = bucket_sort(strings, len, N, offset, nbuckets);

    save(strings, index, N, len);

    if (strings != NULL)
        free(strings);

    if (index != NULL)
        free(index);

    return EXIT_SUCCESS;
}

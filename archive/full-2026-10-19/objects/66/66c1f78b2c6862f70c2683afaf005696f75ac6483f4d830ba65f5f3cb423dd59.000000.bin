{
  "src/main.cpp": "#include <bits/stdc++.h>\n\nusing namespace std;\n\nint A[1000][1000];\nint ps[1010][1010];\n\ntypedef long long ll;\n\nclass PrefixFrequency {\n  struct Slot {\n    int32_t key;\n    uint32_t frequency;\n  };\n\n  vector<Slot> slots;\n  vector<uint32_t> touched;\n  uint32_t mask;\n\n  static uint32_t hash_key(int32_t key) {\n    uint32_t x = static_cast<uint32_t>(key);\n    x ^= x >> 16;\n    x *= 0x7feb352dU;\n    x ^= x >> 15;\n    x *= 0x846ca68bU;\n    x ^= x >> 16;\n    return x;\n  }\n\npublic:\n  explicit PrefixFrequency(int scan_length) {\n    uint32_t entries = static_cast<uint32_t>(scan_length) + 1;\n    uint32_t capacity = 1;\n    while (capacity < 2U * entries)\n      capacity <<= 1;\n    slots.resize(capacity);\n    touched.reserve(entries);\n    mask = capacity - 1;\n  }\n\n  void clear() {\n    for (uint32_t index : touched)\n      slots[index].frequency = 0;\n    touched.clear();\n  }\n\n  uint32_t get(int32_t key) const {\n    uint32_t index = hash_key(key) & mask;\n    while (slots[index].frequency != 0) {\n      if (slots[index].key == key)\n        return slots[index].frequency;\n      index = (index + 1) & mask;\n    }\n    return 0;\n  }\n\n  void increment(int32_t key) {\n    uint32_t index = hash_key(key) & mask;\n    while (slots[index].frequency != 0) {\n      if (slots[index].key == key) {\n        ++slots[index].frequency;\n        return;\n      }\n      index = (index + 1) & mask;\n    }\n    slots[index].key = key;\n    slots[index].frequency = 1;\n    touched.push_back(index);\n  }\n};\n\nll solve(int m, int n, int k) {\n  for (int i = 1; i <= m; i++) {\n    for (int j = 1; j <= n; j++) {\n      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\n    }\n  }\n  PrefixFrequency h(m);\n  ll ans = 0;\n  for (int j = 1; j <= n; j++)\n    for (int l = j; l <= n; l++) {\n      h.clear();\n      h.increment(0);\n      ll s = 0;\n      for (int i = 1; i <= m; i++) {\n        s += ps[i][l] - ps[i][j - 1];\n        ans += h.get(static_cast<int32_t>(s - k));\n        h.increment(static_cast<int32_t>(s));\n      }\n    }\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n  memset(ps, 0, sizeof ps);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n"
}

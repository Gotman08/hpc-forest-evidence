#include <cstdio>
#include <cstddef>
#include <limits>
#include <vector>

class FastInput {
public:
    FastInput() : position_(0), length_(0) {}

    bool read_int(int& value) {
        int character;
        do {
            character = next_character();
            if (character == EOF) {
                return false;
            }
        } while (character <= ' ');

        bool negative = false;
        if (character == '-' || character == '+') {
            negative = character == '-';
            character = next_character();
        }

        long long magnitude = 0;
        while (character >= '0' && character <= '9') {
            magnitude = magnitude * 10 + (character - '0');
            character = next_character();
        }
        value = static_cast<int>(negative ? -magnitude : magnitude);
        return true;
    }

private:
    int next_character() {
        if (position_ == length_) {
            length_ = std::fread(buffer_, 1, sizeof(buffer_), stdin);
            position_ = 0;
            if (length_ == 0) {
                return EOF;
            }
        }
        return static_cast<unsigned char>(buffer_[position_++]);
    }

    char buffer_[1 << 16];
    std::size_t position_;
    std::size_t length_;
};

int main() {
    FastInput input;
    int n;
    int s;
    if (!input.read_int(n) || !input.read_int(s)) {
        return 0;
    }

    const int window_count = n - s + 1;
    std::vector<long long> vertical_sums(window_count, 0);
    std::vector<long long> saved_row_windows(
        static_cast<std::size_t>(s) * static_cast<std::size_t>(window_count));
    std::vector<int> rolling_row(s);

    long long best_sum = std::numeric_limits<long long>::lowest();
    std::size_t saved_offset = 0;

    for (int row = 0; row < n; ++row) {
        long long horizontal_sum = 0;
        std::size_t value_slot = 0;
        const bool remove_old_row = row >= s;
        const bool complete_window = row + 1 >= s;

        for (int column = 0; column < n; ++column) {
            int value = 0;
            input.read_int(value);

            if (column >= s) {
                horizontal_sum -= rolling_row[value_slot];
            }
            rolling_row[value_slot] = value;
            horizontal_sum += value;
            if (++value_slot == rolling_row.size()) {
                value_slot = 0;
            }

            if (column + 1 >= s) {
                const int window_column = column - s + 1;
                const std::size_t index =
                    saved_offset + static_cast<std::size_t>(window_column);
                const long long previous =
                    remove_old_row ? saved_row_windows[index] : 0;

                saved_row_windows[index] = horizontal_sum;
                const long long window_sum =
                    vertical_sums[window_column] + horizontal_sum - previous;
                vertical_sums[window_column] = window_sum;

                if (complete_window && window_sum > best_sum) {
                    best_sum = window_sum;
                }
            }
        }

        saved_offset += static_cast<std::size_t>(window_count);
        if (saved_offset == saved_row_windows.size()) {
            saved_offset = 0;
        }
    }

    std::printf("%lld\n", best_sum);
    return 0;
}

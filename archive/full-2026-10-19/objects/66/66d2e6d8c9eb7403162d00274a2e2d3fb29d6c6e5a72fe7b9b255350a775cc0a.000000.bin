"""Write a static independent review of pinned reader bytes, never native admission."""
from __future__ import annotations

import hashlib
import json
from datetime import UTC, datetime
from pathlib import Path

OUT = Path(__file__).resolve().parent
BASE = OUT.parents[2]
READER = BASE / "outputs/HPC-Forest-Primes-Natif-Lancement-r2d/premier-demarrage-r2d"


def ref(path):
    return {"path": str(path.resolve()), "sha256": hashlib.sha256(path.read_bytes()).hexdigest()}


def main():
    targets = {"delivery": ("LIVRAISON-LECTEUR-PREMIER-DEMARRAGE-R2D-R2.json", "421a966b25924453c3ea8cba1f1b447db92cfe0fdceaabacc263536a1290b641"),
        "controller": ("controler-reception-bornee.py", "cab32f42130f47ef6ea79bbd0c30f6ae2625c11eb6911e27b6081b09fa49e9c4"),
        "helpers": ("reception_bornee.py", "bc954362c5f0aaa64beb8840d684635a043637af0429dfb4925e7d0eacf6c8ca")}
    checked = {}
    for key, (name, expected) in targets.items():
        checked[key] = ref(READER / name)
        if checked[key]["sha256"] != expected:
            raise ValueError("Pinned reader changed after review")
    cex = json.loads((OUT / "CONTRE-EXEMPLES-VERIFIES.json").read_text(encoding="utf8"))
    if cex.get("verified") is not True or cex.get("reader_manifest_before_after_identical") is not True:
        raise ValueError("Actual inert counterexamples missing")
    value = {"schema": "hpc-forest-r2d-independent-first-start-reader-static-review-v1",
        "created_utc": datetime.now(UTC).isoformat(), "reviewer": "/root/r2_relaunch_source",
        "verified": True, "verified_scope": "Completed independent static review and two inert helper counterexamples only",
        "reviewed": checked, "counterexamples": ref(OUT / "CONTRE-EXEMPLES-VERIFIES.json"),
        "counterexample_script": ref(OUT / "contre-exemples-neutres.py"),
        "go_static_for_production_first_start_reader": False,
        "blocking_findings": [{"id": "R2D-FIRST-READER-P1-VALID-BUILD-ONLY", "priority": 1,
            "file": str(READER / "reception_bornee.py"), "line": 125,
            "finding": "private_evaluation accepts status=valid with correct=true and three timings but only one build sidecar, no check or benchmark operation, no executed private case records",
            "observed_result": {"recorded_status": "valid", "private_operation_records": 1,
                "private_raw_case_records": 0, "received_private_bytes_and_recorded_contexts_match": True},
            "implication": "The first-real-evaluation summary can treat build-only bytes as a valid measured candidate evaluation. The full audit still requires other identity/transport inputs and returns global verified=false; no full production acceptance was fabricated here",
            "requested_change": "In a new isolated reader revision, require operation/raw-case provenance consistent with the actual source Evaluator path and recorded outcome status. Preserve genuine build_failed/runtime_failed/incorrect results; do not rerun candidates or relax oracle/first NORMAL checks"},
            {"id": "R2D-FIRST-READER-P2-ALLOCATION-TYPES", "priority": 2,
            "file": str(READER / "reception_bornee.py"), "line": 73,
            "finding": "validate_header compares allocation values by equality only: nodes/tasks bool, CPU/memory/affinity counts float, GPU false and four string affinity IDs are accepted",
            "implication": "This helper does not itself establish the promised exact typed allocation. Later immutable source/marker checks may reject some complete inputs; no complete production bypass is claimed",
            "requested_change": "Require exact int for numerical allocation counts and exact nonnegative int affinity IDs before uniqueness/count checks; do not accept bool/float/string aliases"}],
        "positive_static_observations": [
            "Scope/source105/plan/three fresh MAX session pins match R2d; no Luna or historical r2c session fallback",
            "Fourteen exact admission refs are linked to initial local/POSIX authorization and actual qualified source binding",
            "initial_lane=False path follows same CELL-BINDING/OWNER/ready/initial-installation links and grants no new worker",
            "Invocation returncode must be exact int zero, timed_out false, exact CLI/MAX/ChatGPT argv and request/response/ready/delivered SHA links",
            "Mother-only boundary cannot satisfy first NORMAL; one raw turn.completed usage must equal exact delivered input+output tokens",
            "WARN/nonJSON/nonobject/unknown/error/tool items are retained as raw-log hash diagnostics and refuse clean NORMAL",
            "Received input bytes are rehashed after audit; global native/performance/isolation/extension claims remain false",
            "Input snapshots and private sidecars are consumed only locally; no RPC/model context output path is present"],
        "validation": {"manifested_reader_members_verified_before_after": cex["reader_manifested_members_verified"],
            "two_new_inert_counterexamples_executed": True, "existing_51_tests_rerun": False,
            "existing_51_test_and_Ruff_records_read_and_hashed": True},
        "source_reader_factory_files_modified": 0, "model_calls": 0, "network_calls": 0,
        "CLI_native_worker_candidate_compiler_C_processes_started": 0,
        "native_research_admitted": False, "actual_first_start_received_or_verified": False,
        "final_cohort_reader_admitted": False, "new_worker_or_extension_authorized": False}
    target = OUT / "REVUE-LECTEUR-PREMIER-DEMARRAGE-R2D.json"
    with target.open("x", encoding="utf8", newline="\n") as stream:
        json.dump(value, stream, indent=2, ensure_ascii=False)
        stream.write("\n")
    print(json.dumps(ref(target)))


if __name__ == "__main__":
    main()

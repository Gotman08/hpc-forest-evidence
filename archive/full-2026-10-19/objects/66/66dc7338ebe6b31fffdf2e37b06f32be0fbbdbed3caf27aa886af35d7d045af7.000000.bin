#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#if defined(__aarch64__) && defined(__ARM_NEON)
#include <arm_neon.h>
#endif

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

/*
 * Each body holds coordinate positions (i.e., x, y, and z) and
 * velocities (i.e., vx, vy, and vz).
 */
typedef struct { float x, y, z, vx, vy, vz; } Body;

/*
 * Compute the gravitational impact among all pairs of bodies in
 * the system.
 */
void body_force(Body *p, float dt, int n) {
  int i = 0;

#if defined(__aarch64__) && defined(__ARM_NEON)
  const float32x4_t softening = vdupq_n_f32(SOFTENING);
  const float64x2_t one = vdupq_n_f64(1.0);

  /* Two target vectors share source broadcasts, with independent sums. */
  for (; n - i >= 8; i += 8) {
    const float32x4_t tx0 = {p[i].x, p[i + 1].x,
                             p[i + 2].x, p[i + 3].x};
    const float32x4_t ty0 = {p[i].y, p[i + 1].y,
                             p[i + 2].y, p[i + 3].y};
    const float32x4_t tz0 = {p[i].z, p[i + 1].z,
                             p[i + 2].z, p[i + 3].z};
    const float32x4_t tx1 = {p[i + 4].x, p[i + 5].x,
                             p[i + 6].x, p[i + 7].x};
    const float32x4_t ty1 = {p[i + 4].y, p[i + 5].y,
                             p[i + 6].y, p[i + 7].y};
    const float32x4_t tz1 = {p[i + 4].z, p[i + 5].z,
                             p[i + 6].z, p[i + 7].z};
    float32x4_t fx0 = vdupq_n_f32(0.0f);
    float32x4_t fy0 = vdupq_n_f32(0.0f);
    float32x4_t fz0 = vdupq_n_f32(0.0f);
    float32x4_t fx1 = vdupq_n_f32(0.0f);
    float32x4_t fy1 = vdupq_n_f32(0.0f);
    float32x4_t fz1 = vdupq_n_f32(0.0f);

    for (int j = 0; j < n; j++) {
      const float32x4_t sx = vdupq_n_f32(p[j].x);
      const float32x4_t sy = vdupq_n_f32(p[j].y);
      const float32x4_t sz = vdupq_n_f32(p[j].z);
      float32x4_t dx0 = sx - tx0;
      float32x4_t dy0 = sy - ty0;
      float32x4_t dz0 = sz - tz0;
      float32x4_t dx1 = sx - tx1;
      float32x4_t dy1 = sy - ty1;
      float32x4_t dz1 = sz - tz1;
      float32x4_t sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + softening;
      float32x4_t sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + softening;

      /* Expose independent double-precision square roots and divisions. */
      float64x2_t root0_lo = vsqrtq_f64(vcvt_f64_f32(vget_low_f32(sqrd_dist0)));
      float64x2_t root0_hi = vsqrtq_f64(vcvt_f64_f32(vget_high_f32(sqrd_dist0)));
      float64x2_t root1_lo = vsqrtq_f64(vcvt_f64_f32(vget_low_f32(sqrd_dist1)));
      float64x2_t root1_hi = vsqrtq_f64(vcvt_f64_f32(vget_high_f32(sqrd_dist1)));
      float64x2_t inv0_lo = vdivq_f64(one, root0_lo);
      float64x2_t inv0_hi = vdivq_f64(one, root0_hi);
      float64x2_t inv1_lo = vdivq_f64(one, root1_lo);
      float64x2_t inv1_hi = vdivq_f64(one, root1_hi);
      float32x4_t inv_dist0 = vcombine_f32(vcvt_f32_f64(inv0_lo),
                                          vcvt_f32_f64(inv0_hi));
      float32x4_t inv_dist1 = vcombine_f32(vcvt_f32_f64(inv1_lo),
                                          vcvt_f32_f64(inv1_hi));
      float32x4_t inv_dist3_0 = inv_dist0 * inv_dist0 * inv_dist0;
      float32x4_t inv_dist3_1 = inv_dist1 * inv_dist1 * inv_dist1;

      /* Every target retains the original ascending source order. */
      fx0 += dx0 * inv_dist3_0;
      fy0 += dy0 * inv_dist3_0;
      fz0 += dz0 * inv_dist3_0;
      fx1 += dx1 * inv_dist3_1;
      fy1 += dy1 * inv_dist3_1;
      fz1 += dz1 * inv_dist3_1;
    }

    float fx_lane[8], fy_lane[8], fz_lane[8];
    vst1q_f32(fx_lane, fx0);
    vst1q_f32(fx_lane + 4, fx1);
    vst1q_f32(fy_lane, fy0);
    vst1q_f32(fy_lane + 4, fy1);
    vst1q_f32(fz_lane, fz0);
    vst1q_f32(fz_lane + 4, fz1);
    for (int lane = 0; lane < 8; ++lane) {
      p[i + lane].vx += dt*fx_lane[lane];
      p[i + lane].vy += dt*fy_lane[lane];
      p[i + lane].vz += dt*fz_lane[lane];
    }
  }

  /* Lanes represent independent targets, never a source reduction. */
  for (; n - i >= 4; i += 4) {
    const float32x4_t tx = {p[i].x, p[i + 1].x,
                            p[i + 2].x, p[i + 3].x};
    const float32x4_t ty = {p[i].y, p[i + 1].y,
                            p[i + 2].y, p[i + 3].y};
    const float32x4_t tz = {p[i].z, p[i + 1].z,
                            p[i + 2].z, p[i + 3].z};
    float32x4_t fx = vdupq_n_f32(0.0f);
    float32x4_t fy = vdupq_n_f32(0.0f);
    float32x4_t fz = vdupq_n_f32(0.0f);

    for (int j = 0; j < n; j++) {
      float32x4_t dx = vdupq_n_f32(p[j].x) - tx;
      float32x4_t dy = vdupq_n_f32(p[j].y) - ty;
      float32x4_t dz = vdupq_n_f32(p[j].z) - tz;
      /* Keep the original expression grouping and compiler contraction policy. */
      float32x4_t sqrd_dist = dx*dx + dy*dy + dz*dz + softening;

      /* sqrt and reciprocal are double precision, as in the scalar code. */
      float64x2_t dist_lo = vcvt_f64_f32(vget_low_f32(sqrd_dist));
      float64x2_t dist_hi = vcvt_f64_f32(vget_high_f32(sqrd_dist));
      float64x2_t inv_lo = vdivq_f64(one, vsqrtq_f64(dist_lo));
      float64x2_t inv_hi = vdivq_f64(one, vsqrtq_f64(dist_hi));
      float32x4_t inv_dist = vcombine_f32(vcvt_f32_f64(inv_lo),
                                         vcvt_f32_f64(inv_hi));
      float32x4_t inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    float fx_lane[4], fy_lane[4], fz_lane[4];
    vst1q_f32(fx_lane, fx);
    vst1q_f32(fy_lane, fy);
    vst1q_f32(fz_lane, fz);
    for (int lane = 0; lane < 4; ++lane) {
      p[i + lane].vx += dt*fx_lane[lane];
      p[i + lane].vy += dt*fy_lane[lane];
      p[i + lane].vz += dt*fz_lane[lane];
    }
  }
#endif

  /* Scalar tail, also used for the complete kernel without AArch64 NEON. */
  for (; i < n; ++i) {
    float fx = 0.0f;
    float fy = 0.0f;
    float fz = 0.0f;

    for (int j = 0; j < n; j++) {
      float dx = p[j].x - p[i].x;
      float dy = p[j].y - p[i].y;
      float dz = p[j].z - p[i].z;
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1 / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    p[i].vx += dt*fx;
    p[i].vy += dt*fy;
    p[i].vz += dt*fz;
  }
}

/*
 * Read a binary dataset with initilized bodies.
 */
Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  return bodies;
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc,char **argv) {
  int nbodies;

  Body *bodies = read_dataset(&nbodies);

  /*
   * At each simulation iteration, interbody forces are computed,
   * and bodies' positions are integrated.
   */
  for (int iter = 0; iter < N_ITER; iter++) {
    body_force(bodies, DT, nbodies);

    for (int i = 0; i < nbodies; i++) {
      bodies[i].x += bodies[i].vx * DT;
      bodies[i].y += bodies[i].vy * DT;
      bodies[i].z += bodies[i].vz * DT;
    }
  }

  write_dataset(nbodies, bodies);

  free(bodies);
  
  exit(EXIT_SUCCESS);
}

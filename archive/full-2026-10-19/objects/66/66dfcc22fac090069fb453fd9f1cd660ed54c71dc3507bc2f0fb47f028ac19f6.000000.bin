{"files":[{"content":"#include <iostream>\n#include <vector>\n#include <algorithm>\n#include <atomic>\n#include <memory>\n#include <thread>\n#include <cstring>\n#include <cstdint>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\nconst uint32_t MOD = 1000000007;\nusing Vec = uint32_t __attribute__((vector_size(16)));\n\nstatic inline Vec reduce(Vec x) {\n    const Vec modulus = {MOD, MOD, MOD, MOD};\n    return x - ((x >= modulus) & modulus);\n}\n\nstatic inline Vec prefix(Vec x) {\n    const Vec zero = {0, 0, 0, 0};\n    const Vec one = {4, 0, 1, 2};\n    const Vec two = {4, 4, 0, 1};\n    x = reduce(x + __builtin_shuffle(x, zero, one));\n    return reduce(x + __builtin_shuffle(x, zero, two));\n}\n\nstatic inline void open_run(vector<uint32_t>& dp, int begin, int end,\n                            uint32_t& carry) {\n    int j = begin;\n    const Vec last = {3, 3, 3, 3};\n    Vec incoming = {carry, carry, carry, carry};\n    for (; end - j >= 8; j += 8) {\n        Vec x, y;\n        memcpy(&x, dp.data() + j, sizeof(x));\n        memcpy(&y, dp.data() + j + 4, sizeof(y));\n        x = prefix(x);\n        y = prefix(y);\n        x = reduce(x + incoming);\n        y = reduce(y + __builtin_shuffle(x, last));\n        memcpy(dp.data() + j, &x, sizeof(x));\n        memcpy(dp.data() + j + 4, &y, sizeof(y));\n        incoming = __builtin_shuffle(y, last);\n    }\n    if (end - j >= 4) {\n        Vec x;\n        memcpy(&x, dp.data() + j, sizeof(x));\n        x = reduce(prefix(x) + incoming);\n        memcpy(dp.data() + j, &x, sizeof(x));\n        incoming = __builtin_shuffle(x, last);\n        j += 4;\n    }\n    carry = incoming[0];\n    for (; j < end; ++j) {\n        uint32_t value = dp[j] + carry;\n        if (value >= MOD) value -= MOD;\n        dp[j] = carry = value;\n    }\n}\n\nstatic inline uint32_t process_row(vector<uint32_t>& dp,\n                                   const vector<int>& obstacles,\n                                   vector<uint64_t>& bitmap,\n                                   int begin, int end, uint32_t carry) {\n    fill(bitmap.begin(), bitmap.end(), uint64_t(0));\n    for (int column : obstacles) {\n        if (column >= begin && column < end) {\n            const int offset = column - begin;\n            bitmap[offset >> 6] |= uint64_t(1) << (offset & 63);\n        }\n    }\n    int first = begin;\n    for (size_t word = 0; word < bitmap.size(); ++word) {\n        uint64_t bits = bitmap[word];\n        while (bits != 0) {\n            const int column = begin + static_cast<int>(word * 64)\n                               + __builtin_ctzll(bits);\n            open_run(dp, first, column, carry);\n            dp[column] = 0;\n            carry = 0;\n            first = column + 1;\n            bits &= bits - 1;\n        }\n    }\n    open_run(dp, first, end, carry);\n    return carry;\n}\n\nstruct alignas(64) Progress {\n    atomic<int> rows;\n    Progress() : rows(0) {}\n};\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n    vector<vector<int>> blocked(n);\n    for (int c = 0; c < m; ++c) {\n        int i, j;\n        cin >> i >> j;\n        blocked[i].push_back(j);\n    }\n    vector<uint32_t> dp(n, 0);\n    dp[0] = 1;\n    int requested = 1;\n#ifdef _OPENMP\n    requested = min(omp_get_max_threads(), max(1, n / 256));\n#endif\n    if (requested == 1) {\n        vector<uint64_t> bitmap((n + 63) / 64);\n        for (int i = 0; i < n; ++i)\n            process_row(dp, blocked[i], bitmap, 0, n, 0);\n    } else {\n        vector<vector<uint32_t>> edges(requested, vector<uint32_t>(n));\n        unique_ptr<Progress[]> progress(new Progress[requested]);\n        #pragma omp parallel num_threads(requested)\n        {\n            int tid = 0, team = 1;\n#ifdef _OPENMP\n            tid = omp_get_thread_num();\n            team = omp_get_num_threads();\n#endif\n            const int begin = static_cast<int>(static_cast<long long>(n) * tid / team);\n            const int end = static_cast<int>(static_cast<long long>(n) * (tid + 1) / team);\n            vector<uint64_t> bitmap((end - begin + 63) / 64);\n            const int batch = 16;\n            for (int first = 0; first < n; first += batch) {\n                const int last = min(n, first + batch);\n                if (tid != 0) {\n                    while (progress[tid - 1].rows.load(memory_order_acquire) < last)\n                        this_thread::yield();\n                }\n                for (int i = first; i < last; ++i) {\n                    const uint32_t carry = tid == 0 ? 0 : edges[tid - 1][i];\n                    edges[tid][i] = process_row(dp, blocked[i], bitmap, begin, end, carry);\n                }\n                progress[tid].rows.store(last, memory_order_release);\n            }\n        }\n    }\n    cout << dp[n - 1] << '\\n';\n}\n","path":"src/solution.cpp"}],"hypothesis":"Combining the SIMD strip pipeline with reusable strip-local packed obstacle bitmaps may eliminate sorting costs while preserving long vectorized free runs.","notes":"No commands executed. Bitmap insertion naturally deduplicates obstacles; actual OpenMP team size determines strip boundaries.","research":{"queries":[],"urls":[]},"sources_kept":["d8e2c275fa0746ad","c1b3fa7daf924afe"],"transformations":["Retain the persistent OpenMP column-strip pipeline with 16-row batches and acquire/release progress publication.","Retain eight-cell SIMD modular prefix scans, four-cell and scalar tails, and one in-place DP row.","Replace sorted obstacle lists with unsorted per-row lists and one reusable packed bitmap per worker; scan set bits to delimit free runs across bitmap words."]}
      "content": "#include \"knn.h\"\n#include <omp.h>\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n    int * dist_gids = (int *) malloc(k * sizeof(int));  // group indices for tie-breaking\n\n    // Allocate per-thread local top-k arrays once outside parallel region\n    int nthreads = omp_get_max_threads();\n    float * all_dist = (float *) malloc(nthreads * k * sizeof(float));\n    char * all_labels = (char *) malloc(nthreads * k * sizeof(char));\n    int * all_gids = (int *) malloc(nthreads * k * sizeof(int));\n\n    #pragma omp parallel\n    {\n        int tid = omp_get_thread_num();\n        float * local_dist = all_dist + tid * k;\n        char * local_labels = all_labels + tid * k;\n        int * local_gids = all_gids + tid * k;\n\n        // Initialize per-thread arrays with sentinel values (-1)\n        for (int p = 0; p < k; p++) {\n            local_dist[p] = -1.0f;\n            local_labels[p] = -1;\n            local_gids[p] = -1;\n        }\n\n        #pragma omp for schedule(guided)\n        for (int i = 0; i < n_groups; i++) {\n            Group g = groups[i];\n            for (int j = 0; j < g.length; j++) {\n                float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n\n                // Insert into local sorted list of size k\n                int x, y;\n                for (x = 0; x < k; x++) {\n                    if (d < local_dist[x] || local_dist[x] == -1.0f) {\n                        for (y = k - 1; y > x; y--) {\n                            local_dist[y] = local_dist[y - 1];\n                            local_labels[y] = local_labels[y - 1];\n                            local_gids[y] = local_gids[y - 1];\n                        }\n                        local_dist[x] = d;\n                        local_labels[x] = g.label;\n                        local_gids[x] = i;   // store group index for tie-breaking\n                        break;\n                    }\n                }\n            }\n        }\n    } // end parallel region\n\n    // Initialize global top-k arrays (reuse original pointers)\n    for (int p = 0; p < k; p++) {\n        distances[p] = -1.0f;\n        labels[p] = -1;\n        dist_gids[p] = -1;\n    }\n\n    // Merge per-thread lists in thread order, using group index as secondary key for ties\n    for (int t = 0; t < nthreads; t++) {\n        float * t_dist = all_dist + t * k;\n        char * t_label = all_labels + t * k;\n        int * t_gid = all_gids + t * k;\n        for (int p = 0; p < k; p++) {\n            if (t_dist[p] == -1.0f) break;   // remaining entries are also sentinel\n            float d = t_dist[p];\n            char lab = t_label[p];\n            int gid = t_gid[p];\n            int x, y;\n            for (x = 0; x < k; x++) {\n                if (d < distances[x] || \n                    (distances[x] != -1.0f && d == distances[x] && gid < dist_gids[x]) ||\n                    distances[x] == -1.0f) {\n                    for (y = k - 1; y > x; y--) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                        dist_gids[y] = dist_gids[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = lab;\n                    dist_gids[x] = gid;\n                    break;\n                }\n            }\n        }\n    }\n\n    free(all_dist);\n    free(all_labels);\n    free(all_gids);\n    free(dist_gids);\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (int i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    },
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}\n",
      "path": "src/knn.h"
    }
  ],
  "hypothesis": "Using OpenMP guided scheduling over groups with per-thread local top-k arrays that store group indices for deterministic tie-breaking ensures load balance across variable-length groups while preserving exact sequential output order. The merge phase uses distance then group index as secondary key to maintain correct ordering of equal-distance points from different threads.",
  "notes": "This approach builds on the best previous experiment (a30843e46bab4973) which used guided scheduling but without explicit tie-breaking; here we add group index to guarantee correctness under any thread assignment. The unnecessary barrier after initialization has been removed, and schedule changed from static to guided for better load balance.",

#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>

int main() {
	int n, s;
	std::cin >> n >> s;
	std::vector<std::vector<int> > matrix(n, std::vector<int>(n));
	for(int i=0; i<n; i++)
		for(int j=0; j<n; j++) 
			scanf("%d", &(matrix[i][j]));

	assert(s < n);
	assert(n < 8000);
	assert(s > 0);
	assert(n > 0);

	const int blockSize = 32; // Define a block size for better cache performance
	int mxSum = INT_MIN;

	for(int bi = 0; bi < n; bi += blockSize) {
		for(int bj = 0; bj < n; bj += blockSize) {
			int sum = 0;
			// Initialize the first block
			for(int i = bi; i < std::min(bi + blockSize, n); i++) {
				for(int j = bj; j < std::min(bj + blockSize, n); j++) {
					if(i < s && j < s) sum += matrix[i][j];
				}
			}
			mxSum = std::max(mxSum, sum);

			// Slide the block horizontally and vertically
			for(int i = bi; i + s <= n; i++) {
				int enteringRow = i + s - 1;
				if(enteringRow >= n) break;

				for(int j = bj; j < n; j += blockSize) {
					int blockEndJ = std::min(j + blockSize, n);

					// Slide the block horizontally within the row
					if(j > 0) {
						for(int k = i; k < enteringRow; k++) {
							sum -= matrix[k][j-1];
						}
					}

					if(blockEndJ < n) {
						for(int k = i; k < enteringRow; k++) {
							sum += matrix[k][blockEndJ];
						}
					}

					// Slide the block vertically within the column
					if(i > bi) {
						for(int k = j; k < blockEndJ; k++) {
							sum -= matrix[i-1][k];
						}
					}

					if(enteringRow < n) {
						for(int k = j; k < blockEndJ; k++) {
							sum += matrix[enteringRow][k];
						}
					}

					mxSum = std::max(mxSum, sum);
				}
			}
		}
	}
	printf("%d\n", mxSum);
}
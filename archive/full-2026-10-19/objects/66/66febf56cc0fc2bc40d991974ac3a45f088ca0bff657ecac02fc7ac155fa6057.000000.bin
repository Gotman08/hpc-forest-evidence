<script>
// template.v1.js formats every author as "Last, F." -- single-token names such as
// "OpenAI" or "others" come out as "OpenAI, ." in the list and ". others" in hover cards.
window.addEventListener('load',function(){setTimeout(function(){
  document.querySelectorAll('dt-bibliography, .dt-hover-box').forEach(function(root){
    var w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT),n;
    while((n=w.nextNode())){
      var t=n.nodeValue,u=t.replace(/(\b[A-Za-z]+), \.(?=,| and|$)/g,'$1').replace(/(^|, )\. ([A-Za-z]+)\b/g,'$1$2');
      if(u!==t) n.nodeValue=u;
    }
  });
},0);});
</script>


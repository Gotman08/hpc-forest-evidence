  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/* Force-only operation, also used if the scratch allocation fails. */\nvoid body_force(Body *p, float dt, int n) {\n  for (int i = 0; i < n; ++i) {\n    float fx = 0.0f;\n    float fy = 0.0f;\n    float fz = 0.0f;\n\n    for (int j = 0; j < n; j++) {\n      float dx = p[j].x - p[i].x;\n      float dy = p[j].y - p[i].y;\n      float dz = p[j].z - p[i].z;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      fx += dx * inv_dist3;\n      fy += dy * inv_dist3;\n      fz += dz * inv_dist3;\n    }\n\n    p[i].vx += dt*fx;\n    p[i].vy += dt*fy;\n    p[i].vz += dt*fz;\n  }\n}\n\nstatic inline void advance_one(const Body *restrict p,\n                               Body *restrict next,\n                               float dt, int n, int i) {\n  const float x = p[i].x;\n  const float y = p[i].y;\n  const float z = p[i].z;\n  float fx = 0.0f;\n  float fy = 0.0f;\n  float fz = 0.0f;\n\n  for (int j = 0; j < n; ++j) {\n    float dx = p[j].x - x;\n    float dy = p[j].y - y;\n    float dz = p[j].z - z;\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n    fx += dx * inv_dist3;\n    fy += dy * inv_dist3;\n    fz += dz * inv_dist3;\n  }\n\n  const float vx = p[i].vx + dt*fx;\n  const float vy = p[i].vy + dt*fy;\n  const float vz = p[i].vz + dt*fz;\n  next[i].vx = vx;\n  next[i].vy = vy;\n  next[i].vz = vz;\n  next[i].x = x + vx*dt;\n  next[i].y = y + vy*dt;\n  next[i].z = z + vz*dt;\n}\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic inline float32x4_t inverse_distance4(float32x4_t squared) {\n  const float64x2_t one = vdupq_n_f64(1.0);\n  float64x2_t lo = vcvt_f64_f32(vget_low_f32(squared));\n  float64x2_t hi = vcvt_f64_f32(vget_high_f32(squared));\n\n  /* Match the reference's double sqrt and division before narrowing. */\n  float64x2_t inv_lo = vdivq_f64(one, vsqrtq_f64(lo));\n  float64x2_t inv_hi = vdivq_f64(one, vsqrtq_f64(hi));\n  return vcombine_f32(vcvt_f32_f64(inv_lo), vcvt_f32_f64(inv_hi));\n}\n#endif\n\n/* Four targets share source loads; paired sources retain ascending-j sums. */\nstatic inline void advance_four(const Body *restrict p,\n                                Body *restrict next,\n                                float dt, int n, int i) {\n  const float x[4] = {p[i].x, p[i+1].x, p[i+2].x, p[i+3].x};\n  const float y[4] = {p[i].y, p[i+1].y, p[i+2].y, p[i+3].y};\n  const float z[4] = {p[i].z, p[i+1].z, p[i+2].z, p[i+3].z};\n  float fx[4] = {0.0f};\n  float fy[4] = {0.0f};\n  float fz[4] = {0.0f};\n  int j = 0;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n  for (; n - j >= 2; j += 2) {\n    const float xj0 = p[j].x;\n    const float yj0 = p[j].y;\n    const float zj0 = p[j].z;\n    const float xj1 = p[j+1].x;\n    const float yj1 = p[j+1].y;\n    const float zj1 = p[j+1].z;\n    float dx0[4], dy0[4], dz0[4], squared0[4];\n    float dx1[4], dy1[4], dz1[4], squared1[4];\n    float cube0[4], cube1[4];\n\n    #pragma omp simd\n    for (int lane = 0; lane < 4; ++lane) {\n      float dx_lane0 = xj0 - x[lane];\n      float dy_lane0 = yj0 - y[lane];\n      float dz_lane0 = zj0 - z[lane];\n      float dx_lane1 = xj1 - x[lane];\n      float dy_lane1 = yj1 - y[lane];\n      float dz_lane1 = zj1 - z[lane];\n      dx0[lane] = dx_lane0;\n      dy0[lane] = dy_lane0;\n      dz0[lane] = dz_lane0;\n      dx1[lane] = dx_lane1;\n      dy1[lane] = dy_lane1;\n      dz1[lane] = dz_lane1;\n      squared0[lane] = dx_lane0*dx_lane0 + dy_lane0*dy_lane0\n                     + dz_lane0*dz_lane0 + SOFTENING;\n      squared1[lane] = dx_lane1*dx_lane1 + dy_lane1*dy_lane1\n                     + dz_lane1*dz_lane1 + SOFTENING;\n    }\n\n    float32x4_t inv0 = inverse_distance4(vld1q_f32(squared0));\n    float32x4_t inv1 = inverse_distance4(vld1q_f32(squared1));\n    vst1q_f32(cube0, vmulq_f32(vmulq_f32(inv0, inv0), inv0));\n    vst1q_f32(cube1, vmulq_f32(vmulq_f32(inv1, inv1), inv1));\n\n    #pragma omp simd\n    for (int lane = 0; lane < 4; ++lane) {\n      fx[lane] += dx0[lane] * cube0[lane];\n      fy[lane] += dy0[lane] * cube0[lane];\n      fz[lane] += dz0[lane] * cube0[lane];\n      fx[lane] += dx1[lane] * cube1[lane];\n      fy[lane] += dy1[lane] * cube1[lane];\n      fz[lane] += dz1[lane] * cube1[lane];\n    }\n  }\n#endif\n\n  for (; j < n; ++j) {\n    const float xj = p[j].x;\n    const float yj = p[j].y;\n    const float zj = p[j].z;\n\n    #pragma omp simd\n    for (int lane = 0; lane < 4; ++lane) {\n      float dx = xj - x[lane];\n      float dy = yj - y[lane];\n      float dz = zj - z[lane];\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n      fx[lane] += dx * inv_dist3;\n      fy[lane] += dy * inv_dist3;\n      fz[lane] += dz * inv_dist3;\n    }\n  }\n\n  for (int lane = 0; lane < 4; ++lane) {\n    const float vx = p[i+lane].vx + dt*fx[lane];\n    const float vy = p[i+lane].vy + dt*fy[lane];\n    const float vz = p[i+lane].vz + dt*fz[lane];\n    next[i+lane].vx = vx;\n    next[i+lane].vy = vy;\n    next[i+lane].vz = vz;\n    next[i+lane].x = x[lane] + vx*dt;\n    next[i+lane].y = y[lane] + vy*dt;\n    next[i+lane].z = z[lane] + vz*dt;\n  }\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n  Body *bodies = read_dataset(&nbodies);\n  Body *scratch = (Body *)malloc((size_t)nbodies * sizeof(Body));\n  Body *result = bodies;\n\n  if (scratch != NULL) {\n    const int block_size = 4;\n    const int nfull = nbodies / block_size;\n    const int nblocks = nfull + (nbodies % block_size != 0);\n\n    #pragma omp parallel if (nbodies >= 64)\n    {\n      for (int iter = 0; iter < N_ITER; ++iter) {\n        const Body *src = (iter & 1) ? scratch : bodies;\n        Body *dst = (iter & 1) ? bodies : scratch;\n\n        #pragma omp for schedule(static)\n        for (int block = 0; block < nblocks; ++block) {\n          const int start = block * block_size;\n          if (block < nfull) {\n            advance_four(src, dst, DT, nbodies, start);\n          } else {\n            for (int i = start; i < nbodies; ++i) {\n              advance_one(src, dst, DT, nbodies, i);\n            }\n          }\n        }\n        /* The worksharing barrier completes this timestep's output. */\n      }\n    }\n\n    result = (N_ITER & 1) ? scratch : bodies;\n  } else {\n    for (int iter = 0; iter < N_ITER; iter++) {\n      body_force(bodies, DT, nbodies);\n      for (int i = 0; i < nbodies; i++) {\n        bodies[i].x += bodies[i].vx * DT;\n        bodies[i].y += bodies[i].vy * DT;\n        bodies[i].z += bodies[i].vz * DT;\n      }\n    }\n  }\n\n  write_dataset(nbodies, result);\n  free(scratch);\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "Four-target/two-source tiling may reduce register pressure and loop overhead relative to the eight-target parent while retaining exact ordered arithmetic and persistent OpenMP integration.",

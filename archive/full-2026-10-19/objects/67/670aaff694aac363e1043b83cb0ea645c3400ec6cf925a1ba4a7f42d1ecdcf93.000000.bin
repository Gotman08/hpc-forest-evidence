        "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n#include <string.h>\n\n#define INPUT_BUFFER_SIZE 65536\n#define OUTPUT_BUFFER_SIZE 65536\n\ntypedef struct {\n    unsigned char buffer[INPUT_BUFFER_SIZE];\n    size_t position;\n    size_t available;\n} input_stream;\n\nstatic int input_get(input_stream *input)\n{\n    if (input->position == input->available) {\n        input->available = fread(input->buffer, 1, sizeof(input->buffer), stdin);\n        input->position = 0;\n        if (input->available == 0)\n            return EOF;\n    }\n    return input->buffer[input->position++];\n}\n\nstatic int read_long(input_stream *input, long *value)\n{\n    int character;\n    int negative = 0;\n    unsigned long result = 0;\n\n    do {\n        character = input_get(input);\n    } while (character != EOF && character <= ' ');\n\n    if (character == EOF)\n        return 0;\n    if (character == '-') {\n        negative = 1;\n        character = input_get(input);\n    }\n\n    while (character > ' ') {\n        result = result * 10u + (unsigned long)(character - '0');\n        character = input_get(input);\n    }\n\n    *value = negative ? -(long)result : (long)result;\n    return 1;\n}\n\nstatic int read_key(input_stream *input, unsigned char *destination, size_t capacity)\n{\n    int character;\n    size_t length = 0;\n\n    do {\n        character = input_get(input);\n    } while (character != EOF && character <= ' ');\n\n    if (character == EOF)\n        return 0;\n\n    while (character > ' ') {\n        if (length < capacity)\n            destination[length] = (unsigned char)character;\n        ++length;\n        character = input_get(input);\n    }\n\n    return length <= capacity;\n}\n\nstatic int multiply_size(size_t left, size_t right, size_t *result)\n{\n    if (left != 0 && right > SIZE_MAX / left)\n        return 0;\n    *result = left * right;\n    return 1;\n}\n\nstatic uint64_t *radix_sort_direct(uint64_t *values, uint64_t *workspace,\n                                   size_t count, size_t key_length)\n{\n    uint64_t *source = values;\n    uint64_t *target = workspace;\n    size_t position;\n\n    for (position = key_length; position != 0; --position) {\n        size_t frequencies[256] = {0};\n        size_t next[256];\n        const unsigned char *source_bytes = (const unsigned char *)source;\n        size_t total = 0;\n        size_t index;\n\n        for (index = 0; index < count; ++index)\n            ++frequencies[source_bytes[index * sizeof(uint64_t) + position - 1]];\n\n        for (index = 0; index < 256; ++index) {\n            next[index] = total;\n            total += frequencies[index];\n        }\n\n        for (index = 0; index < count; ++index) {\n            unsigned char digit = source_bytes[index * sizeof(uint64_t) + position - 1];\n            target[next[digit]++] = source[index];\n        }\n\n        {\n            uint64_t *temporary = source;\n            source = target;\n            target = temporary;\n        }\n    }\n\n    return source;\n}\n\nstatic size_t *radix_sort_indices(const uint64_t *records, size_t record_words,\n                                  size_t count, size_t key_length,\n                                  size_t *indices, size_t *workspace)\n{\n    const unsigned char *record_bytes = (const unsigned char *)records;\n    const size_t record_stride = record_words * sizeof(uint64_t);\n    size_t *source = indices;\n    size_t *target = workspace;\n    size_t index;\n    size_t position;\n\n    for (index = 0; index < count; ++index)\n        indices[index] = index;\n\n    for (position = key_length; position != 0; --position) {\n        size_t frequencies[256] = {0};\n        size_t next[256];\n        size_t total = 0;\n\n        for (index = 0; index < count; ++index)\n            ++frequencies[record_bytes[source[index] * record_stride + position - 1]];\n\n        for (index = 0; index < 256; ++index) {\n            next[index] = total;\n            total += frequencies[index];\n        }\n\n        for (index = 0; index < count; ++index) {\n            unsigned char digit = record_bytes[source[index] * record_stride + position - 1];\n            target[next[digit]++] = source[index];\n        }\n\n        {\n            size_t *temporary = source;\n            source = target;\n            target = temporary;\n        }\n    }\n\n    return source;\n}\n\nstatic int save_records(const uint64_t *records, size_t record_words,\n                        const size_t *indices, size_t count, size_t key_length)\n{\n    unsigned char output[OUTPUT_BUFFER_SIZE];\n    const unsigned char *record_bytes = (const unsigned char *)records;\n    const size_t record_stride = record_words * sizeof(uint64_t);\n    size_t used = 0;\n    size_t index;\n\n    for (index = 0; index < count; ++index) {\n        size_t record_index = indices == NULL ? index : indices[index];\n        const unsigned char *record = record_bytes + record_index * record_stride;\n        size_t length = 0;\n\n        while (length < key_length && record[length] != '\\0')\n            ++length;\n\n        if (length > sizeof(output) - 1) {\n            if (used != 0) {\n                if (fwrite(output, 1, used, stdout) != used)\n                    return 0;\n                used = 0;\n            }\n            if (length != 0 && fwrite(record, 1, length, stdout) != length)\n                return 0;\n            if (fputc('\\n', stdout) == EOF)\n                return 0;\n        } else {\n            if (used + length + 1 > sizeof(output)) {\n                if (fwrite(output, 1, used, stdout) != used)\n                    return 0;\n                used = 0;\n            }\n            memcpy(output + used, record, length);\n            used += length;\n            output[used++] = '\\n';\n        }\n    }\n\n    if (used != 0 && fwrite(output, 1, used, stdout) != used)\n        return 0;\n    return fflush(stdout) == 0;\n}\n\nint main(void)\n{\n    input_stream input = {{0}, 0, 0};\n    long declared_length;\n    long count_long;\n    long ignored_offset;\n    long ignored_buckets;\n    size_t key_length;\n    size_t count;\n    size_t record_words;\n    size_t record_count;\n    uint64_t *records;\n    int success = 0;\n    size_t index;\n\n    if (!read_long(&input, &declared_length) ||\n        !read_long(&input, &count_long) ||\n        !read_long(&input, &ignored_offset) ||\n        !read_long(&input, &ignored_buckets) ||\n        declared_length < 0 || count_long < 0)\n        return EXIT_FAILURE;\n\n    (void)ignored_offset;\n    (void)ignored_buckets;\n    key_length = (size_t)declared_length;\n    count = (size_t)count_long;\n\n    if (key_length > SIZE_MAX - 8)\n        return EXIT_FAILURE;\n    record_words = (key_length + 8) / 8;\n    if (!multiply_size(count, record_words, &record_count))\n        return EXIT_FAILURE;\n\n    records = record_count == 0 ? NULL : calloc(record_count, sizeof(*records));\n    if (record_count != 0 && records == NULL)\n        return EXIT_FAILURE;\n\n    for (index = 0; index < count; ++index) {\n        unsigned char *record = (unsigned char *)(records + index * record_words);\n        if (!read_key(&input, record, key_length))\n            goto done;\n    }\n\n    if (record_words == 1) {\n        uint64_t *workspace = count == 0 ? NULL : malloc(count * sizeof(*workspace));\n        uint64_t *sorted;\n\n        if (count != 0 && workspace == NULL)\n            goto done;\n        sorted = radix_sort_direct(records, workspace, count, key_length);\n        success = save_records(sorted, record_words, NULL, count, key_length);\n        free(workspace);\n    } else {\n        size_t *indices = count == 0 ? NULL : malloc(count * sizeof(*indices));\n        size_t *workspace = count == 0 ? NULL : malloc(count * sizeof(*workspace));\n        size_t *sorted;\n\n        if (count != 0 && (indices == NULL || workspace == NULL)) {\n            free(indices);\n            free(workspace);\n            goto done;\n        }\n        sorted = radix_sort_indices(records, record_words, count, key_length,\n                                    indices, workspace);\n        success = save_records(records, record_words, sorted, count, key_length);\n        free(indices);\n        free(workspace);\n    }\n\ndone:\n    free(records);\n    return success ? EXIT_SUCCESS : EXIT_FAILURE;\n}\n",
        "path": "src/bucketsort.c"
      }

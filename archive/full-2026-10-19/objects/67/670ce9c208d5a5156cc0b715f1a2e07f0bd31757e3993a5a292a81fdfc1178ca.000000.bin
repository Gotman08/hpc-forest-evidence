ropose flattening matrix. That is a simple transformation preserving dependencies and enabling better SIMD (contiguous loads). Also we can use int* pointer for raw access maybe faster than vector operator[] but not necessary.\n\nWe need to output complete file content with changes. We'll modify src/solution.cpp accordingly.\n\nAlso ensure correctness: all indices correct.\n\nLet's write new source:\n\n#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <algorithm>\n#include <climits>\n\nint main() {\n    int n, s;\n    std::cin >> n >> s;\n    std::vector<int> matrix(n * n);\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            scanf(\"%d\", &matrix[i * n + j]);\n\n    // Column sums of the first S rows\n    std::vector<long long> colSum(n);\n    #pragma omp simd\n    for (int j = 0; j < n; ++j) colSum[j] = matrix[0 * n + j];\n    for (int i = 1; i < s; ++i) {\n        const int base = i * n;\n        #pragma omp simd\n        for (int j = 0; j < n; ++j) colSum[j] += matrix[base + j];\n    }\n\n    long long mxSum = LLONG_MIN;\n\n    // Slide the vertical window down one row at a time\n    for (int top = 0; top + s <= n; ++top) {\n        // Horizontal sliding window of length S over colSum\n        long long window = 0;\n        for (int j = 0; j < s; ++j) window += colSum[j];\n        long long best = window;\n        for (int j = s; j < n; ++j) {\n            window += colSum[j] - colSum[j - s];\n            if (window > best) best = window;\n        }\n        if (best > mxSum) mxSum = best;\n\n        // Move the vertical window down by one row\n        if (top + s < n) {\n            const int addBase = (top + s) * n;\n            const int subBase = top * n;\n            #pragma omp simd\n            for (int j = 0; j < n; ++j) {\n                colSum[j] += matrix[addBase + j] - matrix[subBase + j];\n            }\n        }\n    }\n\n    printf(\"%lld\\n\", mxSum);\n    return 0;\n}\n\nThis flattens the matrix. 
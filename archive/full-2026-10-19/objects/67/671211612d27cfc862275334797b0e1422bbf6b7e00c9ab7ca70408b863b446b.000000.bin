      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n#if defined(__GNUC__) && !defined(__clang__)\n__attribute__((noinline, optimize(\"no-math-errno\")))\n#endif\nstatic void force_from_packed(Body *body, float dt, int n,\n                              const float *restrict x,\n                              const float *restrict y,\n                              const float *restrict z) {\n  const float xi = body->x;\n  const float yi = body->y;\n  const float zi = body->z;\n  float fx = 0.0f;\n  float fy = 0.0f;\n  float fz = 0.0f;\n  int j = 0;\n\n  for (; n - j >= 8; j += 8) {\n    float dxs[8], dys[8], dzs[8], weights[8];\n\n    /* Only independent distance and weight calculations are vectorized. */\n    #pragma omp simd simdlen(4)\n    for (int lane = 0; lane < 8; ++lane) {\n      float dx = x[j + lane] - xi;\n      float dy = y[j + lane] - yi;\n      float dz = z[j + lane] - zi;\n      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n      float inv_dist = 1 / sqrt(sqrd_dist);\n      float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n      dxs[lane] = dx;\n      dys[lane] = dy;\n      dzs[lane] = dz;\n      weights[lane] = inv_dist3;\n    }\n\n    /* Preserve source order and the original multiply-add expressions. */\n    for (int lane = 0; lane < 8; ++lane) {\n      fx += dxs[lane] * weights[lane];\n      fy += dys[lane] * weights[lane];\n      fz += dzs[lane] * weights[lane];\n    }\n  }\n\n  for (; j < n; ++j) {\n    float dx = x[j] - xi;\n    float dy = y[j] - yi;\n    float dz = z[j] - zi;\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n    fx += dx * inv_dist3;\n    fy += dy * inv_dist3;\n    fz += dz * inv_dist3;\n  }\n\n  body->vx += dt*fx;\n  body->vy += dt*fy;\n  body->vz += dt*fz;\n}\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system.\n */\n#if defined(__GNUC__) && !defined(__clang__)\n__attribute__((optimize(\"no-math-errno\")))\n#endif\nvoid body_force(Body *p, float dt, int n) {\n  if (n <= 0) {\n    return;\n  }\n\n  float *positions = NULL;\n  if ((size_t)n <= (size_t)-1 / (3 * sizeof(float))) {\n    positions = (float *)malloc((size_t)n * 3 * sizeof(float));\n  }\n\n  if (positions == NULL) {\n    for (int i = 0; i < n; ++i) {\n      float fx = 0.0f;\n      float fy = 0.0f;\n      float fz = 0.0f;\n\n      for (int j = 0; j < n; ++j) {\n        float dx = p[j].x - p[i].x;\n        float dy = p[j].y - p[i].y;\n        float dz = p[j].z - p[i].z;\n        float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n        float inv_dist = 1 / sqrt(sqrd_dist);\n        float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n        fx += dx * inv_dist3;\n        fy += dy * inv_dist3;\n        fz += dz * inv_dist3;\n      }\n\n      p[i].vx += dt*fx;\n      p[i].vy += dt*fy;\n      p[i].vz += dt*fz;\n    }\n    return;\n  }\n\n  float *const x = positions;\n  float *const y = x + n;\n  float *const z = y + n;\n\n  #pragma omp parallel\n  {\n    #pragma omp for schedule(static)\n    for (int i = 0; i < n; ++i) {\n      x[i] = p[i].x;\n      y[i] = p[i].y;\n      z[i] = p[i].z;\n    }\n\n    /* The preceding implicit barrier completes the immutable snapshot. */\n    #pragma omp for schedule(static)\n    for (int i = 0; i < n; ++i) {\n      force_from_packed(&p[i], dt, n, x, y, z);\n    }\n  }\n\n  free(positions);\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n  \n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "SIMD across contiguous source-position packets can expose independent square-root and division work while ordered scalar accumulation preserves each body's arithmetic dependencies.",
  "notes": "Retains double sqrt/division, float intermediates, and ascending source accumulation. Scratch is per-call, with a scalar allocation-failure fallback. Not executed.",

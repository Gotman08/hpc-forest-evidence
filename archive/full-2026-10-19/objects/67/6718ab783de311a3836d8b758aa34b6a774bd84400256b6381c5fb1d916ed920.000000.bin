    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include <stdio.h>\\n#include <stdlib.h>\\n#include <math.h>\\n#include <omp.h>\\n\\n#define N_ITER 10 // number of simulation iterations\\n#define DT 0.01f // time step\\n#define SOFTENING 1e-9f // to avoid zero divisors\\n\\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\\n\\nBody* read_dataset(int *nbodies) {\\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading nbodie value\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError reading input values\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n  return bodies;\\n}\\n\\nvoid write_dataset(const int nbodies, Body *bodies) {\\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\\n  if (b != 1) {\\n    fprintf(stderr,\\\"\\\\nError writing to output\\\\n\\\");\\n    exit(EXIT_FAILURE);\\n  }\\n}\\n\\nint main(int argc,char **argv) {\\n  int nbodies;\\n  Body *bodies = read_dataset(&nbodies);\\n\\n  // Convert AoS input layout to separate arrays (SoA) for cache locality.\\n  float *restrict x = (float*)malloc(nbodies * sizeof(float));\\n  float *restrict y = (float*)malloc(nbodies * sizeof(float));\\n  float *restrict z = (float*)malloc(nbodies * sizeof(float));\\n  float *restrict vx = (float*)malloc(nbodies * sizeof(float));\\n  float *restrict vy = (float*)malloc(nbodies * sizeof(float));\\n  float *restrict vz = (float*)malloc(nbodies * sizeof(float));\\n\\n  for (int i = 0; i < nbodies; ++i) {\\n    x[i] = bodies[i].x;\\n    y[i] = bodies[i].y;\\n    z[i] = bodies[i].z;\\n    vx[i] = bodies[i].vx;\\n    vy[i] = bodies[i].vy;\\n    vz[i] = bodies[i].vz;\\n  }\\n\\n  for (int iter = 0; iter < N_ITER; ++iter) {\\n    #pragma omp parallel\\n    {\\n      // Force computation: each i is handled by one thread, preserving the exact\\n      // per-body accumulation order of the sequential reference.\\n      #pragma omp for schedule(dynamic,16)\\n      for (int i = 0; i < nbodies; ++i) {\\n        float xi = x[i];\\n        float yi = y[i];\\n        float zi = z[i];\\n        float fx = 0.0f;\\n        float fy = 0.0f;\\n        float fz = 0.0f;\\n\\n        int j = 0;\\n        // Unroll inner loop by 8, preserving strict ascending accumulation order.\\n        for (; j + 7 < nbodies; j += 8) {\\n          float dx = x[j] - xi;\\n          float dy = y[j] - yi;\\n          float dz = z[j] - zi;\\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n          float inv_dist = 1 / sqrt(sqrd_dist);\\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n          fx += dx * inv_dist3;\\n          fy += dy * inv_dist3;\\n          fz += dz * inv_dist3;\\n\\n          dx = x[j+1] - xi;\\n          dy = y[j+1] - yi;\\n          dz = z[j+1] - zi;\\n          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n          inv_dist = 1 / sqrt(sqrd_dist);\\n          inv_dist3 = inv_dist * inv_dist * inv_dist;\\n          fx += dx * inv_dist3;\\n          fy += dy * inv_dist3;\\n          fz += dz * inv_dist3;\\n\\n          dx = x[j+2] - xi;\\n          dy = y[j+2] - yi;\\n          dz = z[j+2] - zi;\\n          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n          inv_dist = 1 / sqrt(sqrd_dist);\\n          inv_dist3 = inv_dist * inv_dist * inv_dist;\\n          fx += dx * inv_dist3;\\n          fy += dy * inv_dist3;\\n          fz += dz * inv_dist3;\\n\\n          dx = x[j+3] - xi;\\n          dy = y[j+3] - yi;\\n          dz = z[j+3] - zi;\\n          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n          inv_dist = 1 / sqrt(sqrd_dist);\\n          inv_dist3 = inv_dist * inv_dist * inv_dist;\\n          fx += dx * inv_dist3;\\n          fy += dy * inv_dist3;\\n          fz += dz * inv_dist3;\\n\\n          dx = x[j+4] - xi;\\n          dy = y[j+4] - yi;\\n          dz = z[j+4] - zi;\\n          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n          inv_dist = 1 / sqrt(sqrd_dist);\\n          inv_dist3 = inv_dist * inv_dist * inv_dist;\\n          fx += dx * inv_dist3;\\n          fy += dy * inv_dist3;\\n          fz += dz * inv_dist3;\\n\\n          dx = x[j+5] - xi;\\n          dy = y[j+5] - yi;\\n          dz = z[j+5] - zi;\\n          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n          inv_dist = 1 / sqrt(sqrd_dist);\\n          inv_dist3 = inv_dist * inv_dist * inv_dist;\\n          fx += dx * inv_dist3;\\n          fy += dy * inv_dist3;\\n          fz += dz * inv_dist3;\\n\\n          dx = x[j+6] - xi;\\n          dy = y[j+6] - yi;\\n          dz = z[j+6] - zi;\\n          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n          inv_dist = 1 / sqrt(sqrd_dist);\\n          inv_dist3 = inv_dist * inv_dist * inv_dist;\\n          fx += dx * inv_dist3;\\n          fy += dy * inv_dist3;\\n          fz += dz * inv_dist3;\\n\\n          dx = x[j+7] - xi;\\n          dy = y[j+7] - yi;\\n          dz = z[j+7] - zi;\\n          sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n          inv_dist = 1 / sqrt(sqrd_dist);\\n          inv_dist3 = inv_dist * inv_dist * inv_dist;\\n          fx += dx * inv_dist3;\\n          fy += dy * inv_dist3;\\n          fz += dz * inv_dist3;\\n        }\\n\\n        // Remainder iterations.\\n        for (; j < nbodies; ++j) {\\n          float dx = x[j] - xi;\\n          float dy = y[j] - yi;\\n          float dz = z[j] - zi;\\n          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\\n          float inv_dist = 1 / sqrt(sqrd_dist);\\n          float inv_dist3 = inv_dist * inv_dist * inv_dist;\\n          fx += dx * inv_dist3;\\n          fy += dy * inv_dist3;\\n          fz += dz * inv_dist3;\\n        }\\n\\n        vx[i] += DT*fx;\\n        vy[i] += DT*fy;\\n        vz[i] += DT*fz;\\n      }\\n\\n      // Position update: static schedule is sufficient and avoids extra overhead.\\n      #pragma omp for schedule(static)\\n      for (int i = 0; i < nbodies; ++i) {\\n        x[i] += vx[i]*DT;\\n        y[i] += vy[i]*DT;\\n        z[i] += vz[i]*DT;\\n      }\\n    } // end parallel region\\n  }\\n\\n  // Convert back to the required AoS output layout.\\n  for (int i = 0; i < nbodies; ++i) {\\n    bodies[i].x = x[i];\\n    bodies[i].y = y[i];\\n    bodies[i].z = z[i];\\n    bodies[i].vx = vx[i];\\n    bodies[i].vy = vy[i];\\n    bodies[i].vz = vz[i];\\n  }\\n\\n  write_dataset(nbodies, bodies);\\n\\n  free(x); free(y); free(z); free(vx); free(vy); free(vz);\\n  free(bodies);\\n\\n  return EXIT_SUCCESS;\\n}\\n\",\n      \"path\": \"src/nbody.c\"\n    }\n  ],\n  \"hypothesis\": \"Combining SoA layout (improved cache locality), an unrolled inner force loop that preserves the exact per-body accumulation order, and a single OpenMP parallel region per iteration with dynamic scheduling for the force loop and static scheduling for the position update will reduce thread-creation overhead, enable vectorization through unrolling, and maintain bit-exact correctness—outperforming any individual transformation.\",\n  \"notes\": \"The implementation keeps each body's force summation in exactly the same order as the sequential reference (j=0..n-1), so floating-point results are identical. OpenMP parallelizes only across bodies; no reductions or reordering occur within a body. The SoA layout and restrict qualifiers help the compiler vectorize the unrolled inner loop while preserving arithmetic semantics.\",\n  \"sources_kept\": [\n    \"704fffe5d2a849b5\",\n    \"9e1fa41ec70e4ae4\",\n    \"9adc054f311d4298\"\n  ],\n  \"transformations\": [\n    \"Convert Body array-of-structs to separate float arrays (SoA) for positions and velocities with restrict qualifiers\",\n    \"Unroll inner force loop by factor of 8 while preserving strict ascending accumulation order\",\n    \"Inline force computation into main and use a single OpenMP parallel region per iteration; dynami
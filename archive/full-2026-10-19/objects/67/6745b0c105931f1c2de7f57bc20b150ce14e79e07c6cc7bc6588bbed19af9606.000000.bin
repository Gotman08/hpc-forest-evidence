            "src/solution.cpp"
          ],
          "retained": [
            "Replace serpentine traversal with per-row prefixes and an S-row ring of horizontal window sums.",
            "Fuse independent vertical updates with ARM64 NEON maximum reductions, using two vector accumulators and scalar tails.",
            "Keep the dependent prefix recurrence scalar and consider maxima only after S rows have accumulated."
          ]
        },

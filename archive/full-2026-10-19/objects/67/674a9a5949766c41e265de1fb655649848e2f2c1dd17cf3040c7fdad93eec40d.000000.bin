      "content": "#include \"knn.h\"\n#include <float.h>\n#include <limits.h>\n#include <stdint.h>\n#include <string.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nenum {\n    KNN_TILE_POINTS = 256,\n    KNN_RADIX_BITS = 11,\n    KNN_RADIX_BUCKETS = 1 << KNN_RADIX_BITS\n};\n\nstatic char knn_vote(const size_t *counts) {\n    char winner = (char)-1;\n    size_t best = 0;\n\n    for (int i = 0; i <= UCHAR_MAX; i++) {\n        char label = (char)(unsigned char)i;\n        if (counts[i] > best ||\n            (counts[i] == best && best != 0 && label < winner)) {\n            winner = label;\n            best = counts[i];\n        }\n    }\n    return winner;\n}\n\nstatic char knn_insertion_fallback(int n_groups, Group *groups, int k,\n                                   Point target) {\n    char *labels = (char *)malloc((size_t)k * sizeof(*labels));\n    float *distances = (float *)malloc((size_t)k * sizeof(*distances));\n    float block_distances[KNN_TILE_POINTS];\n    size_t counts[UCHAR_MAX + 1] = {0};\n\n    if (labels == NULL || distances == NULL) {\n        free(labels);\n        free(distances);\n        on_error();\n    }\n\n    for (int i = 0; i < k; i++) {\n        labels[i] = (char)-1;\n        distances[i] = -1.0f;\n    }\n\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length;) {\n            int count = g.length - j;\n            if (count > KNN_TILE_POINTS) count = KNN_TILE_POINTS;\n            const Point *points = g.points + j;\n            const float cutoff = distances[k - 1];\n            const int have_cutoff = cutoff != -1.0f;\n            int any_candidate = 0;\n\n#ifdef _OPENMP\n#pragma omp simd reduction(|:any_candidate)\n#endif\n            for (int b = 0; b < count; b++) {\n                float d = euclidean_distance_no_sqrt(target, points[b]);\n                int retain = !have_cutoff || !(d >= cutoff);\n                block_distances[b] = retain ? d : -1.0f;\n                any_candidate |= retain;\n            }\n\n            if (any_candidate) {\n                for (int b = 0; b < count; b++) {\n                    float d = block_distances[b];\n                    if (d == -1.0f) continue;\n                    float current_cutoff = distances[k - 1];\n                    if (current_cutoff != -1.0f && d >= current_cutoff) continue;\n\n                    for (int x = 0; x < k; x++) {\n                        if (d < distances[x] || distances[x] == -1.0f) {\n                            for (int y = k - 1; y > x; y--) {\n                                distances[y] = distances[y - 1];\n                                labels[y] = labels[y - 1];\n                            }\n                            distances[x] = d;\n                            labels[x] = g.label;\n                            break;\n                        }\n                    }\n                }\n            }\n            j += count;\n        }\n    }\n\n    for (int i = 0; i < k; i++) counts[(unsigned char)labels[i]]++;\n    free(labels);\n    free(distances);\n    return knn_vote(counts);\n}\n\nstatic int knn_distance_keys(Point target, const Point *points, int count,\n                             uint32_t *keys, uint32_t lower, uint32_t upper,\n                             int *any_candidate) {\n    float distances[KNN_TILE_POINTS];\n\n#ifdef _OPENMP\n#pragma omp simd\n#endif\n    for (int i = 0; i < count; i++) {\n        distances[i] = euclidean_distance_no_sqrt(target, points[i]);\n    }\n\n    int invalid = 0;\n    int any = 0;\n#ifdef _OPENMP\n#pragma omp simd reduction(|:invalid, any)\n#endif\n    for (int i = 0; i < count; i++) {\n        uint32_t bits;\n        memcpy(&bits, &distances[i], sizeof(bits));\n        uint32_t magnitude = bits & UINT32_C(0x7fffffff);\n        uint32_t key = magnitude == 0 ? UINT32_C(0) : bits;\n        invalid |= magnitude > UINT32_C(0x7f800000) ||\n                   ((bits & UINT32_C(0x80000000)) != 0 && magnitude != 0);\n        keys[i] = key;\n        any |= key >= lower && key <= upper;\n    }\n    *any_candidate = any;\n    return !invalid;\n}\n\nstatic int knn_first_group(const size_t *offsets, int n_groups,\n                            size_t position) {\n    int low = 0;\n    int high = n_groups;\n    while (low < high) {\n        int middle = low + (high - low) / 2;\n        if (offsets[middle + 1] <= position) low = middle + 1;\n        else high = middle;\n    }\n    return low;\n}\n\nstatic int knn_histogram(int n_groups, const Group *groups,\n                         const size_t *offsets, size_t total,\n                         size_t block_size, int workers, Point target,\n                         uint32_t prefix, uint32_t prefix_mask, int shift,\n                         size_t *bins) {\n    size_t blocks = total / block_size + (total % block_size != 0);\n    uint32_t upper = prefix | ~prefix_mask;\n    int invalid = 0;\n#ifndef _OPENMP\n    (void)workers;\n#endif\n\n#ifdef _OPENMP\n#pragma omp parallel num_threads(workers) if(workers > 1) reduction(|:invalid)\n#endif\n    {\n        size_t local_bins[KNN_RADIX_BUCKETS] = {0};\n        uint32_t keys[KNN_TILE_POINTS];\n\n#ifdef _OPENMP\n#pragma omp for schedule(dynamic, 1)\n#endif\n        for (size_t block = 0; block < blocks; block++) {\n            if (invalid) continue;\n            size_t begin = block * block_size;\n            size_t remaining = total - begin;\n            size_t end = begin + (remaining < block_size ? remaining : block_size);\n            int first_group = knn_first_group(offsets, n_groups, begin);\n\n            for (int group = first_group;\n                 group < n_groups && offsets[group] < end && !invalid; group++) {\n                size_t point = begin > offsets[group] ? begin - offsets[group] : 0;\n                size_t stop = offsets[group + 1] < end ? offsets[group + 1] : end;\n                stop -= offsets[group];\n\n                while (point < stop) {\n                    size_t left = stop - point;\n                    int count = left > KNN_TILE_POINTS ? KNN_TILE_POINTS : (int)left;\n                    int any_candidate;\n                    if (!knn_distance_keys(target, groups[group].points + point,\n                                           count, keys, prefix, upper,\n                                           &any_candidate)) {\n                        invalid = 1;\n                        break;\n                    }\n                    if (any_candidate) {\n                        for (int b = 0; b < count; b++) {\n                            if ((keys[b] & prefix_mask) == prefix) {\n                                local_bins[(keys[b] >> shift) &\n                                           (KNN_RADIX_BUCKETS - 1)]++;\n                            }\n                        }\n                    }\n                    point += (size_t)count;\n                }\n            }\n        }\n\n#ifdef _OPENMP\n#pragma omp critical(knn_histogram_merge)\n#endif\n        {\n            for (int b = 0; b < KNN_RADIX_BUCKETS; b++) bins[b] += local_bins[b];\n        }\n    }\n    return !invalid;\n}\n\nstatic int knn_count_selected(int n_groups, const Group *groups,\n                              const size_t *offsets, size_t total,\n                              size_t block_size, int workers, Point target,\n                              uint32_t cutoff, size_t *counts,\n                              size_t *equal_counts) {\n    size_t blocks = total / block_size + (total % block_size != 0);\n    int invalid = 0;\n#ifndef _OPENMP\n    (void)workers;\n#endif\n\n#ifdef _OPENMP\n#pragma omp parallel num_threads(workers) if(workers > 1) reduction(|:invalid)\n#endif\n    {\n        size_t local_counts[UCHAR_MAX + 1] = {0};\n        uint32_t keys[KNN_TILE_POINTS];\n\n#ifdef _OPENMP\n#pragma omp for schedule(dynamic, 1)\n#endif\n        for (size_t block = 0; block < blocks; block++) {\n            if (invalid) continue;\n            size_t begin = block * block_size;\n            size_t remaining = total - begin;\n            size_t end = begin + (remaining < block_size ? remaining : block_size);\n            int first_group = knn_first_group(offsets, n_groups, begin);\n\n            for (int group = first_group;\n                 group < n_groups && offsets[group] < end && !invalid; group++) {\n                size_t point = begin > offsets[group] ? begin - offsets[group] : 0;\n                size_t stop = offsets[group + 1] < end ? offsets[group + 1] : end;\n                stop -= offsets[group];\n                size_t below = 0;\n                size_t equal = 0;\n\n                while (point < stop) {\n                    size_t left = stop - point;\n                    int count = left > KNN_TILE_POINTS ? KNN_TILE_POINTS : (int)left;\n                    int any_candidate;\n                    if (!knn_distance_keys(target, groups[group].points + point,\n                                           count, keys, UINT32_C(0), cutoff,\n                                           &any_candidate)) {\n                        invalid = 1;\n                        break;\n                    }\n                    if (any_candidate) {\n#ifdef _OPENMP\n#pragma omp simd reduction(+:below, equal)\n#endif\n                        for (int b = 0; b < count; b++) {\n                            below += keys[b] < cutoff;\n                            equal += keys[b] == cutoff;\n                        }\n                    }\n                    point += (size_t)count;\n                }\n\n                local_counts[(unsigned char)groups[group].label] += below;\n                if (equal != 0) {\n#ifdef _OPENMP\n#pragma omp atomic update\n#endif\n                    equal_counts[group] += equal;\n                }\n            }\n        }\n\n#ifdef _OPENMP\n#pragma omp critical(knn_count_merge)\n#endif\n        {\n            for (int label = 0; label <= UCHAR_MAX; label++) {\n                counts[label] += local_counts[label];\n            }\n        }\n    }\n    return !invalid;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    size_t counts[UCHAR_MAX + 1] = {0};\n    size_t total = 0;\n\n    if (k <= 0) return (char)-1;\n\n    for (int i = 0; i < n_groups; i++) {\n        if (groups[i].length > 0) {\n            size_t length = (size_t)groups[i].length;\n            if (length > SIZE_MAX - total) {\n                return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\n            }\n            total += length;\n        }\n    }\n\n    if ((size_t)k >= total) {\n        for (int i = 0; i < n_groups; i++) {\n            if (groups[i].length > 0) {\n                counts[(unsigned char)groups[i].label] += (size_t)groups[i].length;\n            }\n        }\n        counts[(unsigned char)(char)-1] += (size_t)k - total;\n        return knn_vote(counts);\n    }\n\n    if (sizeof(float) != sizeof(uint32_t) || FLT_RADIX != 2 ||\n        FLT_MANT_DIG != 24 || FLT_MAX_EXP != 128 ||\n        (size_t)n_groups > SIZE_MAX / sizeof(size_t) - 1) {\n        return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t *offsets = (size_t *)malloc(((size_t)n_groups + 1) * sizeof(*offsets));\n    size_t *equal_counts = (size_t *)calloc((size_t)n_groups, sizeof(*equal_counts));\n    if (offsets == NULL || equal_counts == NULL) {\n        free(offsets);\n        free(equal_counts);\n        return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\n    }\n\n    offsets[0] = 0;\n    for (int i = 0; i < n_groups; i++) {\n        size_t length = groups[i].length > 0 ? (size_t)groups[i].length : 0;\n        offsets[i + 1] = offsets[i] + length;\n    }\n\n    int workers = 1;\n#ifdef _OPENMP\n    workers = omp_get_max_threads();\n    size_t max_workers = total / 4096;\n    if ((size_t)workers > max_workers) workers = (int)max_workers;\n    if (workers < 1) workers = 1;\n#endif\n    size_t block_size = total / ((size_t)workers * 8);\n    if (block_size < 1024) block_size = 1024;\n    if (block_size > 16384) block_size = 16384;\n\n    size_t rank = (size_t)k;\n    size_t take_equal = 0;\n    uint32_t prefix = 0;\n    uint32_t prefix_mask = 0;\n    uint32_t cutoff = 0;\n\n    for (int shift = 22; shift >= 0; shift -= KNN_RADIX_BITS) {\n        size_t bins[KNN_RADIX_BUCKETS] = {0};\n        if (!knn_histogram(n_groups, groups, offsets, total, block_size,\n                           workers, to_evaluate, prefix, prefix_mask, shift,\n                           bins)) {\n            free(offsets);\n            free(equal_counts);\n            return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\n        }\n\n        int bucket = 0;\n        while (bucket < KNN_RADIX_BUCKETS && rank > bins[bucket]) {\n            rank -= bins[bucket];\n            bucket++;\n        }\n        if (bucket == KNN_RADIX_BUCKETS) {\n            free(offsets);\n            free(equal_counts);\n            return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\n        }\n\n        prefix |= (uint32_t)bucket << shift;\n        prefix_mask |= (uint32_t)(KNN_RADIX_BUCKETS - 1) << shift;\n        cutoff = prefix;\n        take_equal = rank;\n        if (rank == bins[bucket]) {\n            /* The entire remaining prefix interval is selected. */\n            cutoff = prefix | ~prefix_mask;\n            break;\n        }\n    }\n\n    if (!knn_count_selected(n_groups, groups, offsets, total, block_size,\n                            workers, to_evaluate, cutoff, counts, equal_counts)) {\n        free(offsets);\n        free(equal_counts);\n        return knn_insertion_fallback(n_groups, groups, k, to_evaluate);\n    }\n\n    /* Within a group all boundary ties have the same label. */\n    for (int i = 0; i < n_groups && take_equal != 0; i++) {\n        size_t take = equal_counts[i] < take_equal ? equal_counts[i] : take_equal;\n        counts[(unsigned char)groups[i].label] += take;\n        take_equal -= take;\n    }\n\n    free(offsets);\n    free(equal_counts);\n    return knn_vote(counts);\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }

{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\nstatic char knn_vote(char * labels, int k) {\\n    qsort(labels, k, sizeof(char), compare_for_sort);\\n\\n    char most_frequent = labels[0];\\n    int most_frequent_count = 1;\\n    int current_frequency = 1;\\n\\n    for (int i = 1; i < k; i++) {\\n        if (labels[i] != labels[i - 1]) {\\n            if (current_frequency > most_frequent_count) {\\n                most_frequent = labels[i - 1];\\n                most_frequent_count = current_frequency;\\n            }\\n\\n            current_frequency = 1;\\n        } else {\\n            current_frequency++;\\n        }\\n\\n        if (i == k - 1 && current_frequency > most_frequent_count) {\\n            most_frequent = labels[i - 1];\\n            most_frequent_count = current_frequency;\\n        }\\n    }\\n\\n    return most_frequent;\\n}\\n\\nstatic char knn_serial(int n_groups, Group * groups, int k, Point to_evaluate) {\\n    char * labels = (char *) malloc(sizeof(char) * k);\\n    float * distances = (float *) malloc(sizeof(float) * k);\\n\\n    int i, j, x, y;\\n\\n    for (i = 0; i < k; i++) {\\n        labels[i] = -1;\\n        distances[i] = -1;\\n    }\\n\\n    for (i = 0; i < n_groups; i++) {\\n        Group g = groups[i];\\n\\n        for (j = 0; j < g.length; j++) {\\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n\\n            for (x = 0; x < k; x++) {\\n                if (d < distances[x] || distances[x] == -1) {\\n                    for (y = k - 1; y > x; y--) {\\n                        distances[y] = distances[y - 1];\\n                        labels[y] = labels[y - 1];\\n                    }\\n\\n                    distances[x] = d;\\n                    labels[x] = g.label;\\n                    break;\\n                }\\n            }\\n        }\\n    }\\n\\n    char result = knn_vote(labels, k);\\n    free(distances);\\n    free(labels);\\n    return result;\\n}\\n\\n#ifdef _OPENMP\\ntypedef struct {\\n    float * distances;\\n    char * labels;\\n    size_t begin;\\n    size_t end;\\n    int capacity;\\n    int count;\\n    int head;\\n} KnnPartial;\\n\\nstatic void knn_free_partials(KnnPartial * partials, int count) {\\n    for (int i = 0; i < count; i++) {\\n        free(partials[i].distances);\\n        free(partials[i].labels);\\n    }\\n    free(partials);\\n}\\n#endif\\n\\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n#ifdef _OPENMP\\n    int part_count = omp_get_max_threads();\\n    if (part_count < 2 || k <= 0 || omp_in_parallel()) {\\n        return knn_serial(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    size_t total = 0;\\n    for (int i = 0; i < n_groups; i++) {\\n        if (groups[i].length > 0) {\\n            total += (size_t) groups[i].length;\\n        }\\n    }\\n\\n    /* Amortize team startup and private-list initialization. */\\n    size_t useful_parts = total / 16384;\\n    if (useful_parts < 2) {\\n        return knn_serial(n_groups, groups, k, to_evaluate);\\n    }\\n    if (useful_parts < (size_t) part_count) {\\n        part_count = (int) useful_parts;\\n    }\\n\\n    KnnPartial * partials = (KnnPartial *) calloc((size_t) part_count, sizeof(*partials));\\n    if (partials == NULL) {\\n        return knn_serial(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    size_t base = total / (size_t) part_count;\\n    size_t remainder = total % (size_t) part_count;\\n    for (int p = 0; p < part_count; p++) {\\n        KnnPartial * partial = &partials[p];\\n        size_t preceding_extra = (size_t) p < remainder ? (size_t) p : remainder;\\n        partial->begin = base * (size_t) p + preceding_extra;\\n        partial->end = partial->begin + base + ((size_t) p < remainder ? 1 : 0);\\n        size_t length = partial->end - partial->begin;\\n        partial->capacity = length < (size_t) k ? (int) length : k;\\n        partial->distances = (float *) malloc(sizeof(float) * (size_t) partial->capacity);\\n        partial->labels = (char *) malloc(sizeof(char) * (size_t) partial->capacity);\\n        if (partial->distances == NULL || partial->labels == NULL) {\\n            knn_free_partials(partials, part_count);\\n            return knn_serial(n_groups, groups, k, to_evaluate);\\n        }\\n    }\\n\\n    int saw_nan = 0;\\n    #pragma omp parallel for schedule(static) num_threads(part_count) reduction(|:saw_nan)\\n    for (int p = 0; p < part_count; p++) {\\n        KnnPartial * partial = &partials[p];\\n        float * distances = partial->distances;\\n        char * labels = partial->labels;\\n        int capacity = partial->capacity;\\n        int count = 0;\\n        size_t offset = 0;\\n\\n        /* Each partition visits one contiguous interval in original input order. */\\n        for (int i = 0; i < n_groups && offset < partial->end; i++) {\\n            Group g = groups[i];\\n            if (g.length <= 0) {\\n                continue;\\n            }\\n            size_t next = offset + (size_t) g.length;\\n            if (next > partial->begin) {\\n                size_t first = partial->begin > offset ? partial->begin - offset : 0;\\n                size_t last = partial->end < next ? partial->end - offset : (size_t) g.length;\\n                for (size_t j = first; j < last; j++) {\\n                    float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n                    if (d != d) {\\n                        saw_nan = 1;\\n                        continue;\\n                    }\\n\\n                    int position = count;\\n                    if (count == capacity) {\\n                        if (!(d < distances[count - 1])) {\\n                            continue;\\n                        }\\n                        position = count - 1;\\n                    } else {\\n                        count++;\\n                    }\\n\\n                    /* Strict comparison retains the earliest point on a tie. */\\n                    while (position > 0 && d < distances[position - 1]) {\\n                        distances[position] = distances[position - 1];\\n                        labels[position] = labels[position - 1];\\n                        position--;\\n                    }\\n                    distances[position] = d;\\n                    labels[position] = g.label;\\n                }\\n            }\\n            offset = next;\\n        }\\n        partial->count = count;\\n    }\\n\\n    /* NaNs do not define a sortable distance order; retain reference behavior. */\\n    if (saw_nan) {\\n        knn_free_partials(partials, part_count);\\n        return knn_serial(n_groups, groups, k, to_evaluate);\\n    }\\n\\n    char * labels = (char *) malloc(sizeof(char) * (size_t) k);\\n    if (labels == NULL) {\\n        knn_free_partials(partials, part_count);\\n        return knn_serial(n_groups, groups, k, to_evaluate);\\n    }\\n    for (int i = 0; i < k; i++) {\\n        labels[i] = -1;\\n    }\\n\\n    /* Earlier partitions win equal-distance ties, matching serial traversal. */\\n    for (int i = 0; i < k; i++) {\\n        int best = -1;\\n        float best_distance = 0;\\n        for (int p = 0; p < part_count; p++) {\\n            KnnPartial * partial = &partials[p];\\n            if (partial->head < partial->count) {\\n                float d = partial->distances[partial->head];\\n                if (best < 0 || d < best_distance) {\\n                    best = p;\\n                    best_distance = d;\\n                }\\n            }\\n        }\\n        if (best < 0) {\\n            break;\\n        }\\n        labels[i] = partials[best].labels[partials[best].head];\\n        partials[best].head++;\\n    }\\n\\n    knn_free_partials(partials, part_count);\\n    char result = knn_vote(labels, k);\\n    free(labels);\\n    return result;\\n#else\\n    return knn_serial(n_groups, groups, k, to_evaluate);\\n#endif\\n}\\n\\nint main() {\\n    int n_groups = parse_number_of_groups();\\n\\n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n\\n    for (int i = 0; i < n_groups; i++) {\\n        groups[i] = parse_next_group();\\n    }\\n\\n    int k = parse_k();\\n\\n    Point to_evaluate = parse_point();\\n\\n    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Point-balanced OpenMP partitions with private top-k lists should accelerate classification on four cores without synchronization during point scanning.\",\n  \"notes\": \"Preserves parsing, voting, distance arithmetic, and serial tie order. Includes serial fallbacks and frees per-call workspaces. No commands or measurements were run.\",\n  \"research\": {\n    \"queries\": [],\n    \"urls\": []\n  },\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Statically work-share contiguous, point-balanced partitions using the configured OpenMP thread count, with at least 16384 points per partition.\",\n    \"Maintain private bounded sorted lists, rejecting candidates that cannot improve a full local list.\",\n    \"Stably merge local candidates before the original label vote; fall back to reference-order scanning for NaN distances.\"\n  ]\n}"}}

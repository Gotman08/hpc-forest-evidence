        "sources": [],
        "transformations": {
          "files": [
            "src/solution.cpp"
          ],
          "retained": [
            "Group obstacle columns into contiguous row ranges using counting and scatter, then sort and deduplicate each row before processing it.",
            "Traverse obstacle-free spans using one in-place DP row and a left carry; reset both at each obstacle.",
            "Replace remainder with one conditional subtraction because two normalized residues sum to at most 2*MOD-2, within signed 32-bit range.",
            "Disable standard-stream synchronization and input tying without changing input or output bytes."
          ]
        },

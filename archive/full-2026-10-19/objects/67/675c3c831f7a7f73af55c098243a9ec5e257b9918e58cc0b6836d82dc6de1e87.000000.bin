      "content": "#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <cstddef>\n#include <cstdint>\n#include <limits>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n#endif\n\nclass FastInput {\n    unsigned char buffer[1 << 16];\n    std::size_t position = 0;\n    std::size_t length = 0;\n\n    int nextCharacter() {\n        if (position == length) {\n            length = std::fread(buffer, 1, sizeof(buffer), stdin);\n            position = 0;\n            if (length == 0)\n                return EOF;\n        }\n        return buffer[position++];\n    }\n\npublic:\n    bool readInt(int& result) {\n        int ch = nextCharacter();\n        while (ch != EOF && ch <= ' ')\n            ch = nextCharacter();\n        if (ch == EOF)\n            return false;\n\n        const bool negative = ch == '-';\n        if (ch == '-' || ch == '+')\n            ch = nextCharacter();\n\n        std::uint32_t value = 0;\n        while (ch >= '0' && ch <= '9') {\n            value = value * 10 + static_cast<unsigned>(ch - '0');\n            ch = nextCharacter();\n        }\n        const std::int64_t signedValue = negative\n            ? -static_cast<std::int64_t>(value)\n            : static_cast<std::int64_t>(value);\n        result = static_cast<int>(signedValue);\n        return true;\n    }\n};\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\nstatic inline int64x2_t maximumVector(int64x2_t a, int64x2_t b) {\n    return vbslq_s64(vcgtq_s64(a, b), a, b);\n}\n#endif\n\nint main() {\n    FastInput input;\n    int n, s;\n    if (!input.readInt(n) || !input.readInt(s))\n        return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    std::vector<std::vector<int> > matrix(n, std::vector<int>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            input.readInt(matrix[i][j]);\n\n    using Sum = std::int64_t;\n    std::vector<Sum> columns(n, 0);\n    Sum* const column = columns.data();\n\n    for (int rowIndex = 0; rowIndex < s; ++rowIndex) {\n        const int* const row = matrix[rowIndex].data();\n#if defined(__GNUC__) && !defined(__clang__)\n#pragma GCC ivdep\n#endif\n        for (int c = 0; c < n; ++c)\n            column[c] += static_cast<Sum>(row[c]);\n    }\n\n    Sum maximum = std::numeric_limits<Sum>::lowest();\n    for (int top = 0; top <= n - s; ++top) {\n        if (top != 0) {\n            const int* const leaving = matrix[top - 1].data();\n            const int* const entering = matrix[top + s - 1].data();\n#if defined(__GNUC__) && !defined(__clang__)\n#pragma GCC ivdep\n#endif\n            for (int c = 0; c < n; ++c)\n                column[c] += static_cast<Sum>(entering[c]) - leaving[c];\n        }\n\n        Sum window = 0;\n        for (int c = 0; c < s; ++c)\n            window += column[c];\n        if (window > maximum)\n            maximum = window;\n\n        int c = s;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n        const int64x2_t zero = vdupq_n_s64(0);\n        int64x2_t carry = vdupq_n_s64(window);\n        int64x2_t maxima = vdupq_n_s64(maximum);\n\n        for (; c + 7 < n; c += 8) {\n            const int64x2_t d0 = vsubq_s64(\n                vld1q_s64(column + c), vld1q_s64(column + c - s));\n            const int64x2_t d1 = vsubq_s64(\n                vld1q_s64(column + c + 2), vld1q_s64(column + c + 2 - s));\n            const int64x2_t d2 = vsubq_s64(\n                vld1q_s64(column + c + 4), vld1q_s64(column + c + 4 - s));\n            const int64x2_t d3 = vsubq_s64(\n                vld1q_s64(column + c + 6), vld1q_s64(column + c + 6 - s));\n\n            const int64x2_t p0 = vaddq_s64(d0, vextq_s64(zero, d0, 1));\n            const int64x2_t p1 = vaddq_s64(d1, vextq_s64(zero, d1, 1));\n            const int64x2_t p2 = vaddq_s64(d2, vextq_s64(zero, d2, 1));\n            const int64x2_t p3 = vaddq_s64(d3, vextq_s64(zero, d3, 1));\n\n            const int64x2_t t0 = vdupq_laneq_s64(p0, 1);\n            const int64x2_t t1 = vdupq_laneq_s64(p1, 1);\n            const int64x2_t t2 = vdupq_laneq_s64(p2, 1);\n            const int64x2_t t3 = vdupq_laneq_s64(p3, 1);\n            const int64x2_t t01 = vaddq_s64(t0, t1);\n            const int64x2_t t23 = vaddq_s64(t2, t3);\n\n            const int64x2_t prefix1 = vaddq_s64(p1, t0);\n            const int64x2_t prefix2 = vaddq_s64(p2, t01);\n            const int64x2_t prefix3 = vaddq_s64(p3, vaddq_s64(t01, t2));\n            const int64x2_t blockMaximum = maximumVector(\n                maximumVector(p0, prefix1),\n                maximumVector(prefix2, prefix3));\n\n            maxima = maximumVector(maxima, vaddq_s64(carry, blockMaximum));\n            carry = vaddq_s64(carry, vaddq_s64(t01, t23));\n        }\n\n        window = vgetq_lane_s64(carry, 0);\n        const Sum maximum0 = vgetq_lane_s64(maxima, 0);\n        const Sum maximum1 = vgetq_lane_s64(maxima, 1);\n        maximum = maximum0 > maximum1 ? maximum0 : maximum1;\n#endif\n        for (; c < n; ++c) {\n            window += column[c] - column[c - s];\n            if (window > maximum)\n                maximum = window;\n        }\n    }\n\n    std::printf(\"%d\\n\", static_cast<int>(maximum));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }
  ],
  "hypothesis": "Eight-window NEON prefix/max summaries can replace the per-column horizontal dependency with one carry update per block; buffered input prevents scanf overhead from masking the improvement.",

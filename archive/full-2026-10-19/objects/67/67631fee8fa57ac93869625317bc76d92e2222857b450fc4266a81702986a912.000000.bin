      "content": "#include \"knn.h\"\n#include <string.h>\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    // Flatten all points into contiguous arrays for better cache locality\n    int total_points = 0;\n    for (int i = 0; i < n_groups; i++) {\n        total_points += groups[i].length;\n    }\n\n    float *xs = (float *)malloc(sizeof(float) * total_points);\n    float *ys = (float *)malloc(sizeof(float) * total_points);\n    char *labels_flat = (char *)malloc(sizeof(char) * total_points);\n\n    int idx = 0;\n    for (int i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; j++) {\n            xs[idx] = g.points[j].x;\n            ys[idx] = g.points[j].y;\n            labels_flat[idx] = g.label;\n            idx++;\n        }\n    }\n\n    // Combined distance and label struct for cache-friendly shifting\n    typedef struct {\n        float d;\n        char label;\n    } Neighbor;\n\n    Neighbor *nearest = (Neighbor *)malloc(sizeof(Neighbor) * k);\n    for (int i = 0; i < k; i++) {\n        nearest[i].d = -1.0f;\n        nearest[i].label = -1;\n    }\n\n    // Process all points sequentially with insertion sort using memmove\n    for (int i = 0; i < total_points; i++) {\n        float dx = xs[i] - to_evaluate.x;\n        float dy = ys[i] - to_evaluate.y;\n        float d = dx * dx + dy * dy;\n\n        int pos = k;\n        for (int j = 0; j < k; j++) {\n            if (d < nearest[j].d || nearest[j].d == -1.0f) {\n                pos = j;\n                break;\n            }\n        }\n\n        if (pos < k) {\n            // Shift elements to the right using memmove for better locality\n            int shift_count = k - pos - 1;\n            if (shift_count > 0) {\n                memmove(&nearest[pos + 1], &nearest[pos], sizeof(Neighbor) * shift_count);\n            }\n            nearest[pos].d = d;\n            nearest[pos].label = labels_flat[i];\n        }\n    }\n\n    // Frequency histogram to avoid qsort and scan overhead\n    int freq[256] = {0};\n    for (int i = 0; i < k; i++) {\n        if (nearest[i].label != -1) {\n            freq[(unsigned char)nearest[i].label]++;\n        }\n    }\n\n    int max_freq = 0;\n    char best_label = nearest[0].label;\n    for (int c = 0; c < 256; c++) {\n        if (freq[c] > max_freq) {\n            max_freq = freq[c];\n            best_label = (char)c;\n        }\n    }\n\n    free(xs);\n    free(ys);\n    free(labels_flat);\n    free(nearest);\n\n    return best_label;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    },
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct {\n    float x;\n    float y;\n} Point;\n\ntypedef struct {\n    char label;\n    int length;\n    Point * points;\n} Group;\n\nvoid on_error() {\n    printf(\"Invalid input file.\\n\");\n    exit(1);\n}\n\nint parse_number_of_groups() {\n    int n;\n    if (scanf(\" n_groups=%d \", &n) != 1) on_error();\n\n    return n;\n}\n\nPoint parse_point() {\n    float x, y;\n    if (scanf(\" (%f ,%f) \", &x, &y) != 2)  on_error();\n\n    Point point;\n    point.x = x;\n    point.y = y;\n\n    return point;\n}\n\nGroup parse_next_group() {\n    char label; \n    int length;\n\n    if (scanf(\" label=%c \", &label) != 1) on_error();\n    if (scanf(\" length=%d \", &length) != 1) on_error();\n\n    Group group;\n    group.label = label;\n    group.length = length;\n    group.points = (Point *) malloc(sizeof(Point) * length);\n\n    for (int i = 0; i < length; i++) {\n        group.points[i] = parse_point();\n    }\n\n    return group;\n}\n\nint parse_k() {\n    int k;\n    if (scanf(\" k=%d \", &k) != 1) on_error();\n\n    return k;\n}\n\nfloat euclidean_distance_no_sqrt (Point a, Point b) {\n    return ((b.x - a.x) * ((b.x - a.x))) + ((b.y - a.y) * (b.y - a.y));\n}\n\nint compare_for_sort(const void *a, const void *b) {\n  return *(char*)a - *(char*)b;\n}\n",
      "path": "src/knn.h"
    }
  ],
  "hypothesis": "Flatten all points into contiguous arrays (xs, ys, labels_flat) for sequential memory access during distance computation. Combine distances and labels into an array of structs to improve cache locality when shifting. Replace manual shift loop with memmove for efficient block copy. Eliminate qsort+scan by using a frequency histogram over 256 possible char values, preserving tie-breaking (smallest character wins).",

{"files":[{"content":"#include <algorithm>\n#include <cstddef>\n#include <cstdio>\n#include <iostream>\n#include <iterator>\n#include <string>\n\nstruct PrintPermutation\n{\n    enum { output_block_size = 64 * 1024 } ;\n\n    std::string pending ;\n\n    auto\n    flush () -> void\n    {\n        if (!pending.empty ()) {\n            std::fwrite (pending.data (), 1, pending.size (), stdout) ;\n            pending.clear () ;\n        }\n    }\n\n    auto\n    write_direct (std::string::iterator first, std::string::iterator last) -> void\n    {\n        std::fwrite (\"[ \", 1, 2, stdout) ;\n        while (first != last) {\n            std::fputc (*first, stdout) ;\n            std::fputc (' ', stdout) ;\n            ++ first ;\n        }\n        std::fwrite (\"]\\n\", 1, 2, stdout) ;\n    }\n\n    auto\n    operator () (std::string::iterator first, std::string::iterator last) -> void\n    {\n        const std::size_t length = static_cast <std::size_t> (last - first) ;\n        const std::size_t maximum = pending.max_size () ;\n        if ((maximum < 4) || (length > ((maximum - 4) / 2))) {\n            flush () ;\n            write_direct (first, last) ;\n            return ;\n        }\n\n        const std::size_t line_size = (length * 2) + 4 ;\n        if (line_size >= output_block_size) {\n            flush () ;\n            write_direct (first, last) ;\n            return ;\n        }\n\n        if (pending.size () > (output_block_size - line_size)) {\n            flush () ;\n        }\n\n        const std::size_t offset = pending.size () ;\n        pending.append (line_size, ' ') ;\n        pending [offset] = '[' ;\n        pending [offset + line_size - 2] = ']' ;\n        pending [offset + line_size - 1] = '\\n' ;\n\n        if (length != 0) {\n            char * const destination = &pending [offset + 2] ;\n            char const * const source = &*first ;\n#if defined(_OPENMP) && (_OPENMP >= 201307)\n#pragma omp simd\n#endif\n            for (std::size_t index = 0 ; index < length ; ++ index) {\n                destination [index * 2] = source [index] ;\n            }\n        }\n    }\n} ;\n\nstruct IsWhitespace\n{\n    template <typename Char> auto\n    operator () (Char c) const -> bool\n    {\n        return (c == ' ' )\n            || (c == '\\n')\n            || (c == '\\r')\n            || (c == '\\t')\n            || (c == '\\f')\n            || (c == '\\v') ;\n    }\n} ;\n\ntemplate <typename String> inline auto\nremove_whitespaces (String text) -> String\n{\n    text.erase\n        ( std::remove_if\n            ( text.begin ()\n            , text.end ()\n            , IsWhitespace () )\n        , text.end () ) ;\n    return text ;\n}\n\ntemplate <typename Iter> auto\nfind_longest_non_increasing_suffix (Iter first, Iter last) -> Iter\n{\n    if (first == last) return last ;\n    Iter back = std::prev (last) ;\n    if (back == first) return last ;\n    do {\n        -- last ;\n        -- back ;\n    } while ((first != last) && (*back >= *last)) ;\n    return last ;\n}\n\ntemplate <typename Iter> auto\nfind_rightmost_successor (Iter first, Iter second, Iter last) -> Iter\n{\n    if (second == last) return last ;\n    do {\n        -- last ;\n    } while ((second != last) && (*last <= *first)) ;\n    return last ;\n}\n\ntemplate <typename Iter> auto\nnext_permutation (Iter first, Iter last) -> bool\n{\n    if (first == last) return false ;\n    Iter suffix = find_longest_non_increasing_suffix (first, last) ;\n    if (suffix == first) return false ;\n    if (suffix == last)  return false ;\n    Iter pivot = std::prev (suffix) ;\n    Iter successor = find_rightmost_successor (pivot, suffix, last) ;\n    std::iter_swap (pivot, successor) ;\n    std::reverse (suffix, last) ;\n    return true ;\n}\n\ntemplate <typename Iter, typename Function> inline auto\npermutations_iter (Iter first, Iter last, Function& driver) -> void\n{\n    if (first == last) return ;\n    std::sort (first, last) ;\n    do {\n        driver (first, last) ;\n    } while (::next_permutation (first, last)) ;\n}\n\ntemplate <typename String, typename Function> inline auto\npermutations (String text, Function& driver) -> void\n{\n    permutations_iter (std::begin (text), std::end (text), driver) ;\n}\n\ntemplate <typename String, typename InStream> inline auto\nread_text_from_stdin (InStream& in) -> String\n{\n    std::istreambuf_iterator <char> begin (in), end ;\n    std::string text (begin, end) ;\n    text = remove_whitespaces (text) ;\n    return text ;\n}\n\nint main (int argc, char const *argv [])\n{\n    std::string text = read_text_from_stdin <std::string> (std::cin) ;\n    PrintPermutation printer ;\n    permutations (text, printer) ;\n    printer.flush () ;\n    return 0 ;\n}\n","path":"src/permutations.cc"}],"hypothesis":"Combining direct bounded record construction with C stdio bulk emission avoids formatted insertion and reduces output-stream overhead while preserving record order and exact bytes.","notes":"The oversized-record path remains streaming and bounded; no synchronization change is included because the archived composition with that change measured slower.","research":{"queries":[],"urls":[]},"sources_kept":["67ee16922de84903","485ec6d7fd724382"],"transformations":["Retain direct construction of each permutation record inside a bounded pending buffer and stateful reference-passed flushing.","Emit completed pending blocks through fwrite-backed bulk output while retaining a streaming fallback for oversized records."]}
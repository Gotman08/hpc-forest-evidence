#include <iostream>
#include <vector>
#include <cstdio>
#include <algorithm>
#include <cstdint>

int main() {
	int n, s;
	std::cin >> n >> s;

	// Flatten matrix in row-major order for cache-friendly access.
	std::vector<int> mat(n * n);
	for (int i = 0; i < n; ++i) {
		int base = i * n;
		for (int j = 0; j < n; ++j) {
			scanf("%d", &mat[base + j]);
		}
	}

	// Column sums over the first S rows.
	std::vector<int64_t> colSum(n, 0);
	for (int i = 0; i < s; ++i) {
		int base = i * n;
		for (int j = 0; j < n; ++j) {
			colSum[j] += mat[base + j];
		}
	}

	// Initial horizontal window sum.
	int64_t cur = 0;
	for (int j = 0; j < s; ++j) {
		cur += colSum[j];
	}
	int64_t mx = cur;

	// Slide over all possible top rows.
	for (int r = 0; r <= n - s; ++r) {
		if (r > 0) {
			// Recompute the initial horizontal window for this row.
			cur = 0;
			for (int j = 0; j < s; ++j) {
				cur += colSum[j];
			}
		}
		mx = std::max(mx, cur);

		// Slide horizontally across columns.
		for (int j = 0; j < n - s; ++j) {
			cur += colSum[j + s] - colSum[j];
			mx = std::max(mx, cur);
		}

		// Move down to the next top row if possible.
		if (r != n - s) {
			int exitRow = r;
			int enterRow = r + s;
			for (int j = 0; j < n; ++j) {
				colSum[j] -= mat[exitRow * n + j];
				colSum[j] += mat[enterRow * n + j];
			}
		}
	}

	printf("%lld\n", mx);
	return 0;
}

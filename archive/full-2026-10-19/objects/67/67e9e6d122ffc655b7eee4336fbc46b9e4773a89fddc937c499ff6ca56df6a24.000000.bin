{
  "src/brute_isomorphism.cpp": "#include <iostream>\n#include <vector>\n#include <utility>\n#include <cstddef>\n\nusing namespace std;\n\nstruct adjacency_matrix {\n    size_t order;\n    vector<unsigned char> entries;\n\n    explicit adjacency_matrix(size_t n) : order(n), entries(n * n, 0) {}\n\n    size_t size() const { return order; }\n\n    unsigned char *operator[](size_t row) {\n        return entries.data() + row * order;\n    }\n\n    const unsigned char *operator[](size_t row) const {\n        return entries.data() + row * order;\n    }\n};\n\nadjacency_matrix readGraph();\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2);\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence);\ninline void printPermutation(vector<int> &equivalence);\n\nclass HeapSearch {\n    const adjacency_matrix &g1;\n    const adjacency_matrix &g2;\n    vector<int> &equivalence;\n    const int n;\n    vector<unsigned char> compatible;\n    vector<int> exit_permutations;\n    vector<int> scratch;\n    bool found;\n\n    void buildExitPermutations() {\n        // Row k maps final positions to initial positions after Heap(k).\n        // Compose k smaller traversals without visiting their leaves.\n        for (int k = 1; k < n; ++k) {\n            int *order = exit_permutations.data() + static_cast<size_t>(k) * n;\n            for (int i = 0; i < k; ++i)\n                order[i] = i;\n            if (k == 1)\n                continue;\n\n            const int *child = exit_permutations.data() + static_cast<size_t>(k - 1) * n;\n            for (int block = 0; block < k; ++block) {\n                for (int i = 0; i < k - 1; ++i)\n                    scratch[i] = order[child[i]];\n                for (int i = 0; i < k - 1; ++i)\n                    order[i] = scratch[i];\n                if (block + 1 < k)\n                    swap(order[(k % 2 == 0) ? block : 0], order[k - 1]);\n            }\n        }\n    }\n\n    void finishPrefix(int k) {\n        if (k < 2)\n            return;\n        const int *order = exit_permutations.data() + static_cast<size_t>(k) * n;\n        for (int i = 0; i < k; ++i)\n            scratch[i] = equivalence[order[i]];\n        for (int i = 0; i < k; ++i)\n            equivalence[i] = scratch[i];\n    }\n\n    bool matchesFixedVertex(int vertex) const {\n        const int target = equivalence[vertex];\n        if (!compatible[static_cast<size_t>(vertex) * n + target])\n            return false;\n\n        const unsigned char *source_row = g1[vertex];\n        const unsigned char *target_row = g2[target];\n        for (int j = vertex + 1; j < n; ++j) {\n            if (source_row[j] != target_row[equivalence[j]])\n                return false;\n        }\n        return true;\n    }\n\n    void enumerate(int k) {\n        // Positions k through n-1 are fixed and already consistent.\n        if (k == 1) {\n            if (matchesFixedVertex(0)) {\n                printPermutation(equivalence);\n                found = true;\n            }\n            return;\n        }\n\n        for (int block = 0; block < k; ++block) {\n            if (matchesFixedVertex(k - 1))\n                enumerate(k - 1);\n            else\n                finishPrefix(k - 1);\n\n            // Skipped blocks must leave the same prefix as exhaustive Heap.\n            if (block + 1 < k)\n                swap(equivalence[(k % 2 == 0) ? block : 0], equivalence[k - 1]);\n        }\n    }\n\npublic:\n    HeapSearch(const adjacency_matrix &first, const adjacency_matrix &second,\n               vector<int> &permutation, const vector<int> &first_signature,\n               const vector<int> &second_signature)\n        : g1(first), g2(second), equivalence(permutation),\n          n(static_cast<int>(first.size())),\n          compatible(first.size() * first.size(), 0),\n          exit_permutations(first.size() * first.size(), 0),\n          scratch(first.size(), 0), found(false) {\n        for (int i = 0; i < n; ++i) {\n            for (int j = 0; j < n; ++j) {\n                compatible[static_cast<size_t>(i) * n + j] =\n                    first_signature[i] == second_signature[j];\n            }\n        }\n        buildExitPermutations();\n    }\n\n    bool run() {\n        enumerate(n);\n        return found;\n    }\n};\n\nint main() {\n    adjacency_matrix g1 = readGraph();\n    adjacency_matrix g2 = readGraph();\n\n    if (!testIsomorphism(g1, g2))\n        cout << \"The graphs are not isomorphic\" << endl;\n\n    return 0;\n}\n\nbool testIsomorphism(adjacency_matrix &g1, adjacency_matrix &g2) {\n    if (g1.size() != g2.size())\n        return false;\n\n    const int n = static_cast<int>(g1.size());\n    vector<int> equivalence(n);\n    for (int i = 0; i < n; ++i)\n        equivalence[i] = i;\n\n    if (verifyPermutation(g1, g2, equivalence)) {\n        printPermutation(equivalence);\n        return true;\n    }\n\n    vector<int> signature1(n), signature2(n);\n    vector<int> balance(2 * n + 2, 0);\n    for (int i = 0; i < n; ++i) {\n        const unsigned char *row1 = g1[i];\n        const unsigned char *row2 = g2[i];\n        int degree1 = 0;\n        int degree2 = 0;\n        for (int j = 0; j < n; ++j) {\n            degree1 += row1[j];\n            degree2 += row2[j];\n        }\n        // Row sums count distinct neighbors, including a loop once.\n        signature1[i] = 2 * degree1 + row1[i];\n        signature2[i] = 2 * degree2 + row2[i];\n        ++balance[signature1[i]];\n        --balance[signature2[i]];\n    }\n    for (size_t i = 0; i < balance.size(); ++i) {\n        if (balance[i] != 0)\n            return false;\n    }\n\n    HeapSearch search(g1, g2, equivalence, signature1, signature2);\n    return search.run();\n}\n\nadjacency_matrix readGraph() {\n    int vertices, edges, source, destination;\n\n    cin >> vertices;\n    adjacency_matrix read(vertices);\n\n    cin >> edges;\n    for (int i = 0; i < edges; ++i) {\n        cin >> source >> destination;\n        read[destination][source] = read[source][destination] = 1;\n    }\n\n    return read;\n}\n\nbool verifyPermutation(adjacency_matrix &g1, adjacency_matrix &g2, vector<int> &equivalence) {\n    for (size_t i = 0; i < equivalence.size(); ++i) {\n        const unsigned char *row1 = g1[i];\n        const unsigned char *row2 = g2[equivalence[i]];\n        for (size_t j = 0; j <= i; ++j) {\n            if (row1[j] != row2[equivalence[j]])\n                return false;\n        }\n    }\n    return true;\n}\n\ninline void printPermutation(vector<int> &equivalence) {\n    for (auto i : equivalence)\n        cout << i << \" \";\n    cout << endl;\n}\n"
}

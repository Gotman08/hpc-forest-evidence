#include "knn.h"
#include <string.h>

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    if (k <= 0) return -1;

    float *dist = (float *) malloc(sizeof(float) * k);
    char *lbl = (char *) malloc(sizeof(char) * k);
    int heap_size = 0;

    float px = to_evaluate.x;
    float py = to_evaluate.y;

    for (int i = 0; i < n_groups; i++) {
        Group g = groups[i];
        Point * pts = g.points;
        int len = g.length;
        char lbl_group = g.label;
        for (int j = 0; j < len; j++) {
            float dx = pts[j].x - px;
            float dy = pts[j].y - py;
            float d = dx*dx + dy*dy;

            if (heap_size < k) {
                dist[heap_size] = d;
                lbl[heap_size] = lbl_group;
                int idx = heap_size++;
                while (idx > 0 && dist[idx] > dist[(idx-1)/2]) {
                    float td = dist[idx]; dist[idx] = dist[(idx-1)/2]; dist[(idx-1)/2] = td;
                    char tl = lbl[idx]; lbl[idx] = lbl[(idx-1)/2]; lbl[(idx-1)/2] = tl;
                    idx = (idx-1)/2;
                }
            } else if (d < dist[0]) {
                dist[0] = d;
                lbl[0] = lbl_group;
                int idx = 0;
                while (1) {
                    int left = 2*idx+1, right = 2*idx+2, largest = idx;
                    if (left < heap_size && dist[left] > dist[largest]) largest = left;
                    if (right < heap_size && dist[right] > dist[largest]) largest = right;
                    if (largest != idx) {
                        float td = dist[idx]; dist[idx] = dist[largest]; dist[largest] = td;
                        char tl = lbl[idx]; lbl[idx] = lbl[largest]; lbl[largest] = tl;
                        idx = largest;
                    } else break;
                }
            }
        }
    }

    int counts[256];
    memset(counts, 0, sizeof(counts));
    for (int i = 0; i < heap_size; i++) {
        counts[(unsigned char)lbl[i]]++;
    }
    char best_label = -1;
    int best_count = -1;
    for (int c = 0; c < 256; c++) {
        if (counts[c] > best_count) {
            best_count = counts[c];
            best_label = (char)c;
        }
    }

    free(dist);
    free(lbl);
    return best_label;
}

qy = vdupq_n_f32(to_evaluate.y);\n            float32x4_t dx = xs - qx;\n            float32x4_t dy = ys - qy;\n            float32x4_t d2 = dx * dx + dy * dy;\n            float d[4];\n            vst1q_f32(d, d2);\n\n            for (t = 0; t < 4; t++) {\n                float dist_val = d[t];\n                if (count < k) {\n                    int pos = count;\n                    best_dist[pos] = dist_val;\n                    best_label[pos] = g.label;\n                    while (pos > 0 && best_dist[pos - 1] > dist_val) {\n                        float tmpd = best_dist[pos - 1];\n                        best_dist[pos - 1] = best_dist[pos];\n                        best_dist[pos] = tmpd;\n                        char tmpl = best_label[pos - 1];\n                        best_label[pos - 1] = best_label[pos];\n                        best_label[pos] = tmpl;\n                        pos--;\n                    }\n                    count++;\n                } else if (dist_val < best_dist[k - 1]) {\n                    int pos = k - 1;\n                    best_dist[pos] = dist_val;\n                    best_label[pos] = g.label;\n                    while (pos > 0 && best_dist[pos - 1] > best_dist[pos]) {\n                        float tmpd = best_dist[pos - 1];\n                        best_dist[pos - 1] = best_dist[pos];\n                        best_dist[pos] = tmpd;\n                        char tmpl = best_label[pos - 1];\n                        best_label[pos - 1] = best_label[pos];\n                        best_label[pos] = tmpl;\n                        pos--;\n                    }\n                }\n            }\n        }\n\n        // Scalar remainder\n        for (; j < g.length; j++) {\n            float dist_val = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            if (count < k) {\n                int pos = count;\n                best_dist[pos] = dist_val;\n                best_label[pos] = g.label;\n                while (p
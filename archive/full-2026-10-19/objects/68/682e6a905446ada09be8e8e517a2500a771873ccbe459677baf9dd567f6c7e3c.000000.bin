    "content": "{\n  \"files\": [\n    {\n      \"content\": \"#include \\\"knn.h\\\"\\n#include <omp.h>\\n\\ntypedef struct {\\n    float d;\\n    int idx;\\n} Candidate;\\n\\nstatic inline int worse(const Candidate *a, const Candidate *b) {\\n    if (a->d != b->d) return a->d > b->d;\\n    return a->idx > b->idx;\\n}\\n\\nstatic void swap_c(Candidate *a, Candidate *b) {\\n    Candidate t = *a; *a = *b; *b = t;\\n}\\n\\nstatic void sift_down(Candidate *h, int size, int i) {\\n    for (;;) {\\n        int l = 2*i + 1;\\n        int r = l + 1;\\n        int worst = i;\\n        if (l < size && worse(&h[l], &h[worst])) worst = l;\\n        if (r < size && worse(&h[r], &h[worst])) worst = r;\\n        if (worst == i) break;\\n        swap_c(&h[i], &h[worst]);\\n        i = worst;\\n    }\\n}\\n\\nstatic void heap_add(Candidate *h, int *size, int cap, Candidate c) {\\n    if (*size < cap) {\\n        int i = (*size)++;\\n        while (i > 0) {\\n            int p = (i - 1) / 2;\\n            if (worse(&c, &h[p])) {\\n                h[i] = h[p];\\n                i = p;\\n            } else {\\n                break;\\n            }\\n        }\\n        h[i] = c;\\n    } else {\\n        if (worse(&h[0], &c)) {\\n            h[0] = c;\\n            sift_down(h, *size, 0);\\n        }\\n    }\\n}\\n\\nstatic int cmp_candidate(const void *a, const void *b) {\\n    const Candidate *ca = (const Candidate *)a;\\n    const Candidate *cb = (const Candidate *)b;\\n    if (ca->d < cb->d) return -1;\\n    if (ca->d > cb->d) return 1;\\n    return ca->idx - cb->idx;\\n}\\n\\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n    long total = 0;\\n    for (int i = 0; i < n_groups; ++i) total += groups[i].length;\\n\\n    char *flat_labels = (char *)malloc(sizeof(char) * (total > 0 ? total : 1));\\n    float *xs = (float *)malloc(sizeof(float) * (total > 0 ? total : 1));\\n    float *ys = (float *)malloc(sizeof(float) * (total > 0 ? total : 1));\\n\\n    long pos = 0;\\n    for (int i = 0; i < n_groups; ++i) {\\n        Group g = groups[i];\\n        for (int j = 0; j < g.length; ++j) {\\n            flat_labels[pos] = g.label;\\n            xs[pos] = g.points[j].x;\\n            ys[pos] = g.points[j].y;\\n            ++pos;\\n        }\\n    }\\n\\n    int cap_per_thread = k < total ? k : (int)total;\\n    if (cap_per_thread <= 0) {\\n        char *labels = (char *)malloc(sizeof(char) * (k > 0 ? k : 1));\\n        for (int i = 0; i < k; ++i) labels[i] = -1;\\n        qsort(labels, k, sizeof(char), compare_for_sort);\\n\\n        char most_frequent = labels[0];\\n        int most_frequent_count = 1;\\n        int current_frequency = 1;\\n        for (int i = 1; i < k; ++i) {\\n            if (labels[i] != labels[i-1]) {\\n                if (current_frequency > most_frequent_count) {\\n                    most_frequent = labels[i-1];\\n                    most_frequent_count = current_frequency;\\n                }\\n                current_frequency = 1;\\n            } else {\\n                ++current_frequency;\\n            }\\n            if (i == k - 1 && current_frequency > most_frequent_count) {\\n                most_frequent = labels[i-1];\\n                most_frequent_count = current_frequency;\\n            }\\n        }\\n        free(labels);\\n        return most_frequent;\\n    }\\n\\n    int max_threads = omp_get_max_threads();\\n    if (max_threads < 1) max_threads = 1;\\n\\n    Candidate *heap_space = (Candidate *)malloc(sizeof(Candidate) * ((size_t)max_threads * cap_per_thread));\\n    int *sizes = (int *)calloc(max_threads, sizeof(int));\\n\\n#pragma omp parallel\\n    {\\n        int tid = omp_get_thread_num();\\n        Candidate *h = heap_space + (size_t)tid * cap_per_thread;\\n        int size = 0;\\n\\n#pragma omp for schedule(static) nowait\\n        for (long i = 0; i < total; ++i) {\\n            float dx = to_evaluate.x - xs[i];\\n            float dy = to_evaluate.y - ys[i];\\n            Candidate c;\\n            c.d = dx * dx + dy * dy;\\n            c.idx = (int)i;\\n\\n            if (size < cap_per_thread) {\\n                heap_add(h, &size, cap_per_thread, c);\\n            } else {\\n                if (worse(&h[0], &c)) {\\n                    h[0] = c;\\n                    sift_down(h, size, 0);\\n                }\\n            }\\n        }\\n        sizes[tid] = size;\\n    }\\n\\n    long total_candidates = 0;\\n    for (int t = 0; t < max_threads; ++t) total_candidates += sizes[t];\\n\\n    Candidate *all = (Candidate *)malloc(sizeof(Candidate) * (total_candidates > 0 ? total_candidates : 1));\\n    long out_pos = 0;\\n    for (int t = 0; t < max_threads; ++t) {\\n        int sz = sizes[t];\\n        Candidate *src = heap_space + (size_t)t * cap_per_thread;\\n        for (int j = 0; j < sz; ++j) all[out_pos++] = src[j];\\n    }\\n\\n    qsort(all, total_candidates, sizeof(Candidate), cmp_candidate);\\n\\n    int real_count = k < total ? k : (int)total;\\n    char *result_labels = (char *)malloc(sizeof(char) * k);\\n    for (int i = 0; i < real_count && i < total_candidates; ++i) {\\n        result_labels[i] = flat_labels[all[i].idx];\\n    }\\n    for (int i = real_count; i < k; ++i) result_labels[i] = -1;\\n\\n    qsort(result_labels, k, sizeof(char), compare_for_sort);\\n\\n    char most_frequent = result_labels[0];\\n    int most_frequent_count = 1;\\n    int current_frequency = 1;\\n\\n    for (int i = 1; i < k; ++i) {\\n        if (result_labels[i] != result_labels[i - 1]) {\\n            if (current_frequency > most_frequent_count) {\\n                most_frequent = result_labels[i - 1];\\n                most_frequent_count = current_frequency;\\n            }\\n            current_frequency = 1;\\n        } else {\\n            ++current_frequency;\\n        }\\n\\n        if (i == k - 1 && current_frequency > most_frequent_count) {\\n            most_frequent = result_labels[i - 1];\\n            most_frequent_count = current_frequency;\\n        }\\n    }\\n\\n    free(flat_labels);\\n    free(xs);\\n    free(ys);\\n    free(heap_space);\\n    free(sizes);\\n    free(all);\\n    free(result_labels);\\n\\n    return most_frequent;\\n}\\n\",\n      \"path\": \"src/knn.c\"\n    }\n  ],\n  \"hypothesis\": \"Flatten all points into contiguous label/x/y arrays and parallelize the distance loop with OpenMP static scheduling. Each thread maintains a binary max-heap keyed by (squared distance, original index), reducing per-point work from O(k) insertion to O(log k) while preserving exact tie-breaking; merging per-thread heaps globally and replicating the baseline's sentinel/majority logic keeps output byte-identical.\",\n  \"notes\": \"Only src/knn.c is changed. The implementation preserves the original stable top-k order by using (distance, index) as the total key, handles N<k with -1 sentinels exactly like the sequential code, and uses OpenMP static scheduling for uniform point costs on the 4-core target.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Flatten group points into contiguous label/x/y arrays\",\n    \"Parallelize distance computation with OpenMP static schedule\",\n    \"Use per-thread binary max-heaps for O(N log k) top-k selection\",\n    \"Merge thread heaps by (distance, original index) and replicate baseline majority logic\"\n  ]\n}",

{
  "src/solution.cpp": "#include <algorithm>\n#include <cstddef>\n#include <cstdint>\n#include <iostream>\n#include <vector>\n\nnamespace {\nconstexpr int MOD = 1000000007;\n}\n\nint main() {\n    std::ios::sync_with_stdio(false);\n    std::cin.tie(nullptr);\n\n    int n;\n    int m;\n    if (!(std::cin >> n >> m)) {\n        return 0;\n    }\n\n    const std::uint64_t stride = static_cast<std::uint64_t>(n);\n    std::vector<std::uint64_t> blocked;\n    blocked.reserve(static_cast<std::size_t>(m));\n\n    for (int i = 0; i < m; ++i) {\n        int y;\n        int x;\n        std::cin >> y >> x;\n        blocked.push_back(static_cast<std::uint64_t>(y) * stride +\n                          static_cast<std::uint64_t>(x));\n    }\n\n    std::sort(blocked.begin(), blocked.end());\n    blocked.erase(std::unique(blocked.begin(), blocked.end()), blocked.end());\n\n    std::vector<int> paths(static_cast<std::size_t>(n), 0);\n    paths[0] = 1;\n\n    std::size_t next_block = 0;\n    const std::size_t block_count = blocked.size();\n\n    for (int row = 0; row < n; ++row) {\n        const std::uint64_t row_base = static_cast<std::uint64_t>(row) * stride;\n        const std::uint64_t row_end = row_base + stride;\n        int left = 0;\n        int col = 0;\n\n        while (next_block < block_count && blocked[next_block] < row_end) {\n            const int stop = static_cast<int>(blocked[next_block] - row_base);\n\n            for (; col < stop; ++col) {\n                int value = paths[col] + left;\n                if (value >= MOD) {\n                    value -= MOD;\n                }\n                paths[col] = value;\n                left = value;\n            }\n\n            paths[stop] = 0;\n            left = 0;\n            col = stop + 1;\n            ++next_block;\n        }\n\n        for (; col < n; ++col) {\n            int value = paths[col] + left;\n            if (value >= MOD) {\n                value -= MOD;\n            }\n            paths[col] = value;\n            left = value;\n        }\n    }\n\n    std::cout << paths[n - 1] << '\\n';\n    return 0;\n}\n"
}

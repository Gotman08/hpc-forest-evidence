{\\n+            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n+\\n+            /* A NaN requires the reference insertion rule from this point on. */\\n+            if (d != d) ordered = 0;\\n+\\n+            if (ordered) {\\n+                if (used == k && !(d < distances[k - 1])) {\\n+                    continue;\\n+                }\\n+\\n+                /* Insert after equal distances, retaining earlier input points. */\\n+                int lo = 0;\\n+                int hi = used;\\n+                while (lo < hi) {\\n+                    int mid = lo + (hi - lo) / 2;\\n+                    if (d < distances[mid]) {\\n+                        hi = mid;\\n+                    } else {\\n+                        lo = mid + 1;\\n+                    }\\n+                }\\n+\\n+                int moved = used - lo;\\n+                if (used == k) moved--;\\n+\\n+                if (moved > 0) {\\n+                    memmove(distances + lo + 1, distances + lo,\\n+                            (size_t) moved * sizeof(*distances));\\n+                    memmove(labels + lo + 1, labels + lo,\\n+                            (size_t) moved * sizeof(*labels));\\n+                }\\n+\\n+                distances[lo] = d;\\n+                labels[lo] = g.label;\\n+                if (used < k) used++;\\n+                continue;\\n+            }\\n+\\n+            for (x = 0; x < k; x++) {\\n+                if (d < distances[x] || distances[x] == -1) {\\n+                    for (y = k - 1; y > x; y--) {\\n+                        distances[y] = distances[y - 1];\\n+                        labels[y] = labels[y - 1];\\n+                    }\\n+\\n+                    distances[x] = d;\\n+                    labels[x] = g.label;\\n+\\n+                    break;\\n+                }\\n+            }\\n+        }\\n+    }\\n+\\n+    qsort(labels, k, sizeof(char), compare_for_sort);\\n+\\n+    char most_frequent = labels[0];\\n+    int most_frequent_count = 1;\\n+    int current_frequency = 1;\\n+\\n+    for (i = 1; i < k; i++) {\\n+        if (labels[i] != labels[i - 1]) {\\n+            if (current_frequency > most_frequent_count) {\\n+                most_frequent = labels[i - 1];\\n+                most_frequent_count = current_frequency;\\n+            }\\n+\\n+            current_frequency = 1;\\n+        } else {\\n+            current_frequency++;\\n+        }\\n+\\n+        if (i == k - 1 && current_frequency > most_frequent_count) {\\n+            most_frequent = labels[i - 1];\\n+            most_frequent_count = current_frequency;\\n+        }\\n+    }\\n+\\n+    free(distances);\\n+    free(labels);\\n+    return most_frequent;\\n+}\\n+\\n+int main() {\\n+    int n_groups = parse_number_of_groups();\\n+\\n+    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n+\\n+    for (int i = 0; i < n_groups; i++) {\\n+        groups[i] = parse_next_group();\\n+    }\\n+\\n+    int k = parse_k();\\n+\\n+    Point to_evaluate = parse_point();\\n+\\n+    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n+}\"}, {\"id\": \"ebf069bfdb1d42a8\", \"role\": \"B\", \"commit\": \"7c2b4cfcdde656b98873019bd542322e419b1adc\", \"transformations\": {\"files\": [\"src/knn.c\"], \"retained\": [\"Replace the scalar insertion-position search with a four-lane NEON comparison scan that returns the earliest matching lane.\", \"Retain a scalar remainder loop and a compile-time scalar fallback when AArch64 NEON is unavailable.\"]}, \"mean_seconds\": 0.7932351063936949, \"diff\": \"diff --git a/src/knn.c b/src/knn.c\\nindex 337e3b9..4ba7ef1 100644\\n--- a/src/knn.c\\n+++ b/src/knn.c\\n@@ -1,78 +1,109 @@\\n-#include \\\"knn.h\\\"\\n-\\n-char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n-    char * labels = (char *) malloc(sizeof(char) * k);\\n-    float * distances = (float *) malloc(sizeof(float) * k);\\n-\\n-    int i, j, x, y;\\n-\\n-    for (i = 0; i < k; i++) {\\n-        labels[i
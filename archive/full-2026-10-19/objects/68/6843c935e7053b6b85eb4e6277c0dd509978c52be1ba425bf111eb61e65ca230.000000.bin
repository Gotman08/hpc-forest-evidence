;\\n-                }\\n-            }\\n-        }\\n-    }\\n-\\n-    qsort(labels, k, sizeof(char), compare_for_sort);\\n-\\n-    char most_frequent = labels[0];\\n-    int most_frequent_count = 1;\\n-    int current_frequency = 1;\\n-\\n-    for (i = 1; i < k; i++) {\\n-        if (labels[i] != labels[i - 1]) {\\n-            if (current_frequency > most_frequent_count) {\\n-                most_frequent = labels[i - 1];\\n-                most_frequent_count = current_frequency;\\n-            }\\n-\\n-            current_frequency = 1;\\n-        } else {\\n-            current_frequency++;\\n-        }\\n-\\n-        if (i == k - 1 && current_frequency > most_frequent_count) {\\n-            most_frequent = labels[i - 1];\\n-            most_frequent_count = current_frequency;\\n-        }\\n-    }\\n-\\n-\\n-    return most_frequent;\\n-}\\n-\\n-int main() {\\n-    int n_groups = parse_number_of_groups();\\n-    \\n-    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\\n-\\n-    for (int i = 0; i < n_groups; i++) {\\n-        groups[i] = parse_next_group();\\n-    }\\n-\\n-    int k = parse_k();\\n-\\n-    Point to_evaluate = parse_point();\\n-\\n-    printf(\\\"%c\\\", knn(n_groups, groups, k, to_evaluate));\\n-}\\n\\\\ No newline at end of file\\n+#include \\\"knn.h\\\"\\n+#include <limits.h>\\n+#include <math.h>\\n+#include <stdint.h>\\n+#ifdef _OPENMP\\n+#include <omp.h>\\n+#endif\\n+\\n+enum { KNN_MAX_WORKERS = 4, KNN_LABEL_VALUES = UCHAR_MAX + 1 };\\n+\\n+static char reference_knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n+    char *labels = (char *) malloc(sizeof(char) * k);\\n+    float *distances = (float *) malloc(sizeof(float) * k);\\n+    int i, j, x, y;\\n+\\n+    for (i = 0; i < k; i++) {\\n+        labels[i] = (char)-1;\\n+        distances[i] = -1;\\n+    }\\n+\\n+    for (i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+        for (j = 0; j < g.length; j++) {\\n+            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n+            for (x = 0; x < k; x++) {\\n+                if (d < distances[x] || distances[x] == -1) {\\n+                    for (y = k - 1; y > x; y--) {\\n+                        distances[y] = distances[y - 1];\\n+                        labels[y] = labels[y - 1];\\n+                    }\\n+                    distances[x] = d;\\n+                    labels[x] = g.label;\\n+                    break;\\n+                }\\n+            }\\n+        }\\n+    }\\n+\\n+    qsort(labels, k, sizeof(char), compare_for_sort);\\n+    char most_frequent = labels[0];\\n+    int most_frequent_count = 1;\\n+    int current_frequency = 1;\\n+\\n+    for (i = 1; i < k; i++) {\\n+        if (labels[i] != labels[i - 1]) {\\n+            if (current_frequency > most_frequent_count) {\\n+                most_frequent = labels[i - 1];\\n+                most_frequent_count = current_frequency;\\n+            }\\n+            current_frequency = 1;\\n+        } else {\\n+            current_frequency++;\\n+        }\\n+        if (i == k - 1 && current_frequency > most_frequent_count) {\\n+            most_frequent = labels[i - 1];\\n+            most_frequent_count = current_frequency;\\n+        }\\n+    }\\n+\\n+    free(distances);\\n+    free(labels);\\n+    return most_frequent;\\n+}\\n+\\n+static char label_mode(const size_t *counts) {\\n+    char result = (char)-1;\\n+    size_t best = 0;\\n+    for (int value = CHAR_MIN; value <= CHAR_MAX; ++value) {\\n+        size_t count = counts[(unsigned char)value];\\n+        if (count > best) {\\n+            best = count;\\n+            result = (char)value;\\n+        }\\n+    }\\n+    return result;\\n+}\\n+\\n+static int worker_count(size_t total) {\\n+#ifdef _OPENMP\\n+    if (total >= 65536) {\\n+        int workers = omp_get_max_threads();\\n+        if (workers > KNN_MAX_WORKERS) workers = KNN_MAX_WORKERS;\\n+        if (workers < 1) workers = 1;\\n+        return workers;\\n+    }\\n+#else\\n+    (void)total;\\n+#endif\\n+    return 1;\\n+}\\n+\\n+static void point_slice(size_t total, int parts, int part,\\n+                        size_t *begin, size_t *end) {\\n+    size_t width = total / (size_t)parts;\\n+    size_t extra = total % (size_t)parts;\\n+    size_t id = (size_t)part;\\n+    *begin = id * width + (id < extra ? id : extra);\\n+    *end = *begin + width + (id < extra ? 1 : 0);\\n+}\\n+\\n+static int first_group(const size_t *offsets, int n_groups, size_t begin) {\\n+    int low = 0;\\n+    int high = n_groups;\\n+    while (low < high) {\\n+        int middle = low + (high - low) / 2;\\n+        if (offsets[middle + 1] <= begin) {\\n+            low = middle + 1;\\n+        } else {\\n+            high = middle;\\n+        }\\n+    }\\n+    return low;\\n+}\\n+\\n+static int fill_distance_range(int n_groups, const Group *groups,\\n+                               const size_t *offsets, Point to_evaluate,\\n+                               size_t begin, size_t end,\\n+                               float *original, float *work) {\\n+    int unordered = 0;\\n+    for (int g = first_group(offsets, n_groups, begin);\\n+         g < n_groups && offsets[g] < end; ++g) {\\n+        size_t start = offsets[g] > begin ? offsets[g] : begin;\\n+        size_t stop = offsets[g + 1] < e\"}, {\"id\": \"527a64a4c94e4bd5\", \"role\": \"A\", \"commit\": \"3a7d23f015533c544eec39febb34ebc35c78779c\", \"transformations\": {\"files\": [\"src/knn.c\"], \"retained\": [\"Store retained neighbors in one contiguous array of distance, label, and input-ordinal records.\", \"Fill the array sequentially and build the heap bottom-up; subsequently reject against its root and update only a root-to-leaf path.\", \"Preserve reference selection semantics through ordinal tie-breaking, unused-label sentinels, and a serial fallback for unordered distances; release temporary storage on return.\"]}, \"mean_seconds\": 0.02722467357913653, \"diff\": \"diff --git a/src/knn
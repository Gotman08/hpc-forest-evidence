 (d < distances[x] || distances[x] == -1) {\\n+                    for (y = k - 1; y > x; y--) {\\n+                        distances[y] = distances[y - 1];\\n+                        labels[y] = labels[y - 1];\\n+                    }\\n+\\n+                    distances[x] = d;\\n+                    labels[x] = g.label;\\n+                    break;\\n+                }\\n+            }\\n+        }\\n+    }\\n+\\n+    char result = vote_labels(labels, k);\\n+    free(distances);\\n+    free(labels);\\n+    return result;\\n+}\\n+\\n+static int neighbor_is_worse(const Neighbor *a, const Neighbor *b) {\\n+    return a->distance > b->distance ||\\n+           (a->distance == b->distance && a->ordinal > b->ordinal);\\n+}\\n+\\n+static void neighbor_sift_down(Neighbor *heap, size_t length,\\n+                               size_t hole, Neighbor value) {\\n+    size_t child = hole * 2 + 1;\\n+\\n+    while (child < length) {\\n+        if (child + 1 < length &&\\n+            neighbor_is_worse(&heap[child + 1], &heap[child])) {\\n+            child++;\\n+        }\\n+\\n+        if (!neighbor_is_worse(&heap[child], &value)) {\\n+            break;\\n+        }\\n+\\n+        heap[hole] = heap[child];\\n+        hole = child;\\n+        child = hole * 2 + 1;\\n+    }\\n+\\n+    heap[hole] = value;\\n+}\\n+\\n+char knn(int n_groups, Group *groups, int k, Point to_evaluate) {\\n+    if (k <= 0) {\\n+        return knn_serial_selection(n_groups, groups, k, to_evaluate);\\n+    }\\n+\\n+    size_t capacity = (size_t) k;\\n+    Neighbor *heap = (Neighbor *) malloc(sizeof(*heap) * capacity);\\n+    if (heap == NULL) {\\n+        return knn_serial_selection(n_groups, groups, k, to_evaluate);\\n+    }\\n+\\n+    size_t used = 0;\\n+    size_t ordinal = 0;\\n+\\n+    for (int i = 0; i < n_groups; i++) {\\n+        Group g = groups[i];\\n+\\n+        for (int j = 0; j < g.length; j++, ordinal++) {\\n+            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n+\\n+            if (used == capacity && d >= heap[0].distance) {\\n+                continue;\\n+            }\\n+\\n+            /* Unordered distances require the original insertion semantics. */\\n+            if (d != d) {\\n+                free(heap);\\n+                return knn_serial_selection(n_groups, groups, k, to_evaluate);\\n+            }\\n+\\n+            Neighbor candidate = {ordinal, d, g.label};\\n+\\n+          \"}, {\"id\": \"04956d5553ad4fa4\", \"role\": \"A\", \"commit\": \"d3f1363694ab2367928e685e74589162c5ba3a9b\", \"transformations\": {\"files\": [\"src/knn.c\"], \"retained\": [\"Track the occupied prefix of the contiguous distance and label buffers; reject noncompetitive points immediately once the buffers are full.\", \"Locate stable insertion positions with an upper-bound binary search and use memmove only on the occupied suffix.\", \"Switch permanently to the original insertion loops upon encountering a NaN distance, and free per-call scratch buffers after voting.\"]}, \"mean_seconds\": 0.21674927820762, \"diff\": \"diff --git a/src/knn.c b/src/knn.c\\nindex 337e3b9..4b01001 100644\\n--- a/src/knn.c\\n+++ b/src/knn.c\\n@@ -1,78 +1,118 @@\\n-#include \\\"knn.h\\\"\\n-\\n-char knn(int n_groups, Group * groups, int k, Point to_evaluate) {\\n-    char * labels = (char *) malloc(sizeof(char) * k);\\n-    float * distances = (float *) malloc(sizeof(float) * k);\\n-\\n-    int i, j, x, y;\\n-\\n-    for (i = 0; i < k; i++) {\\n-        labels[i] = -1;\\n-        distances[i] = -1;\\n-    }\\n-\\n-    for (i = 0; i < n_groups; i++) {\\n-        Group g = groups[i];\\n-\\n-        for (j = 0; j < g.length; j++) {\\n-            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\\n-\\n-            for (x = 0; x < k; x++) {\\n-                if (d < distances[x] || distances[x] == -1) {\\n-                    for (y = k - 1; y > x; y--) {\\n-                        distances[y] = distances[y - 1];\\n-                        labels[
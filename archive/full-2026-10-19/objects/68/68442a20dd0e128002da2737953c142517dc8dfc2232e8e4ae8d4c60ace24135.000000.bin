      "content": "#include <algorithm>\n#include <atomic>\n#include <iostream>\n#include <memory>\n#include <vector>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#endif\n\nusing namespace std;\n\nconst unsigned MOD = 1000000007u;\n\nstruct alignas(64) Progress {\n    atomic<int> completed;\n    Progress() : completed(0) {}\n};\n\n#if defined(__aarch64__)\nstatic inline uint32x4_t add_mod(uint32x4_t a, uint32x4_t b) {\n    const uint32x4_t modulus = vdupq_n_u32(MOD);\n    const uint32x4_t sum = vaddq_u32(a, b);\n    return vsubq_u32(sum, vandq_u32(vcgeq_u32(sum, modulus), modulus));\n}\n\nstatic inline uint32x4_t scan_four(uint32x4_t values) {\n    const uint32x4_t zero = vdupq_n_u32(0);\n    values = add_mod(values, vextq_u32(zero, values, 3));\n    return add_mod(values, vextq_u32(zero, values, 2));\n}\n#endif\n\nstatic inline void update_span(unsigned* dp, int begin, int end, unsigned& left) {\n    int x = begin;\n#if defined(__aarch64__)\n    uint32x4_t carry = vdupq_n_u32(left);\n    for (; end - x >= 16; x += 16) {\n        uint32x4_t a = scan_four(vld1q_u32(dp + x));\n        uint32x4_t b = scan_four(vld1q_u32(dp + x + 4));\n        uint32x4_t c = scan_four(vld1q_u32(dp + x + 8));\n        uint32x4_t d = scan_four(vld1q_u32(dp + x + 12));\n        a = add_mod(a, carry);\n        b = add_mod(b, vdupq_laneq_u32(a, 3));\n        c = add_mod(c, vdupq_laneq_u32(b, 3));\n        d = add_mod(d, vdupq_laneq_u32(c, 3));\n        carry = vdupq_laneq_u32(d, 3);\n        vst1q_u32(dp + x, a);\n        vst1q_u32(dp + x + 4, b);\n        vst1q_u32(dp + x + 8, c);\n        vst1q_u32(dp + x + 12, d);\n    }\n    for (; end - x >= 4; x += 4) {\n        uint32x4_t values = scan_four(vld1q_u32(dp + x));\n        values = add_mod(values, carry);\n        vst1q_u32(dp + x, values);\n        carry = vdupq_laneq_u32(values, 3);\n    }\n    left = vgetq_lane_u32(carry, 0);\n#endif\n    for (; x < end; ++x) {\n        unsigned sum = dp[x] + left;\n        if (sum >= MOD) sum -= MOD;\n        dp[x] = sum;\n        left = sum;\n    }\n}\n\nstatic inline unsigned update_row(unsigned* dp, const vector<int>& blocked,\n                                  int firstCol, int width, unsigned left) {\n    int begin = 0;\n    const int endCol = firstCol + width;\n    auto obstacle = lower_bound(blocked.begin(), blocked.end(), firstCol);\n    for (; obstacle != blocked.end() && *obstacle < endCol; ++obstacle) {\n        const int x = *obstacle - firstCol;\n        update_span(dp, begin, x, left);\n        dp[x] = 0;\n        left = 0;\n        begin = x + 1;\n    }\n    update_span(dp, begin, width, left);\n    return left;\n}\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n, m;\n    if (!(cin >> n >> m)) return 0;\n    vector<vector<int>> blocked(n);\n    for (int c = 0; c < m; ++c) {\n        int i, j;\n        cin >> i >> j;\n        blocked[i].push_back(j);\n    }\n    for (auto& row : blocked) {\n        sort(row.begin(), row.end());\n        row.erase(unique(row.begin(), row.end()), row.end());\n    }\n\n    int requested = 1;\n#ifdef _OPENMP\n    if (n >= 1024)\n        requested = min(omp_get_max_threads(), max(1, n / 512));\n#endif\n    if (requested == 1) {\n        vector<unsigned> dp(n, 0);\n        dp[0] = 1;\n        for (int i = 0; i < n; ++i)\n            update_row(dp.data(), blocked[i], 0, n, 0);\n        cout << dp[n - 1] << '\\n';\n        return 0;\n    }\n\n    const int WIDTH = 256;\n    const int chunks = (n + WIDTH - 1) / WIDTH;\n    vector<vector<unsigned>> bottom(requested, vector<unsigned>(n, 0));\n    vector<unsigned> leftBoundary(n, 0);\n    unique_ptr<Progress[]> progress(new Progress[requested]);\n    int used = 1;\n\n#ifdef _OPENMP\n#pragma omp parallel num_threads(requested)\n#endif\n    {\n        int tid = 0;\n        int count = 1;\n#ifdef _OPENMP\n        tid = omp_get_thread_num();\n        count = omp_get_num_threads();\n#endif\n        if (tid == 0) used = count;\n        const int firstRow = static_cast<int>(static_cast<long long>(n) * tid / count);\n        const int lastRow = static_cast<int>(static_cast<long long>(n) * (tid + 1) / count);\n        vector<unsigned> tile(WIDTH, 0);\n\n        for (int chunk = 0; chunk < chunks; ++chunk) {\n            const int firstCol = chunk * WIDTH;\n            const int width = min(WIDTH, n - firstCol);\n            if (tid != 0) {\n                // Published column segments remain immutable.\n                while (progress[tid - 1].completed.load(memory_order_acquire) < chunk + 1) {}\n                copy_n(bottom[tid - 1].data() + firstCol, width, tile.data());\n            } else {\n                fill_n(tile.data(), width, 0u);\n                if (chunk == 0) tile[0] = 1;\n            }\n\n            for (int i = firstRow; i < lastRow; ++i) {\n                leftBoundary[i] = update_row(tile.data(), blocked[i], firstCol,\n                                             width, leftBoundary[i]);\n            }\n            copy_n(tile.data(), width, bottom[tid].data() + firstCol);\n            progress[tid].completed.store(chunk + 1, memory_order_release);\n        }\n    }\n\n    cout << bottom[used - 1][n - 1] << '\\n';\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

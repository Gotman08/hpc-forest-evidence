    'schema': 'hpc-forest-r2e-first-batch-cold-receiver-manifest-v1',
    'reviewed_files': {name: ref(HERE / name)['sha256'] for name in files},
    'source_zip_sha256': 'f15b840cca876a4c465775f5553a0eaa539a9b98e56fe942136a1fcbde9b86b9',
    'plan_sha256': '4b430e181948e55e463dfd1e60bdce96308a9190534734feb22354e4116ebde9',
    'native_first_batch_received_by_this_delivery': False,
    'source_scientific_guards_AST_unchanged': ['private_evaluation', 'call_boundary',
        'validate_header', 'parse_jsonl', 'admissible_call_path']})
refusals = save('PREMIERS-REFUS-LOCAUX-CONSERVES.json', {
    'schema': 'hpc-forest-r2e-local-receiver-first-refusals-v1', 'verified': False,
    'derivation_anchor': {'first_attempt': 'Exact historical output-schema/agent-result anchor mismatch before controller rewrite',
        'correction': 'Unique substring derivation anchor; no old file modified'},
    'fixture_windows_newline': {'evidence': ref(HERE / 'tests-contrats-r2.xml'),
        'first_pass': '23 passed,1 failed: fixture write_text translated LF to CRLF while production save uses explicit LF',
        'correction': 'Test writer newline LF only; production release renderer unchanged',
        'single_case_rerun': ref(HERE / 'test-gate-corrige.xml')},
    'model_calls': 0, 'native_processes': 0, 'transport_calls': 0})
delivery = save('LIVRAISON-LECTEUR-PREMIER-BATCH.json', {
    'schema': 'hpc-forest-r2e-first-batch-cold-receiver-prepared-delivery-v1',
    'verified': False, 'prepared_only': True, 'independent_review_required': True,
    'manifest': manifest, 'first_local_refusals': refusals,
    'neutral_evidence': [ref(HERE / name) for name in ('tests-premiere-passe.xml', 'tests-contrats-r2.xml', 'test-gate-corrige.xml')],
    'neutral_unique_cases_acquired': 24,
    'neutral_execution_details': '21 initial cases pass;3 added cases:2 pass immediately,1 passes after fixture-only LF alignment. No tests replayed against a model or job.',
    'ruff_sources_and_interfaces_passed': True,
    'input_context_preparer': ref(HERE / 'preparer-contexte.py'),
    'collector': ref(HERE / 'collecter-frontiere.py'), 'auditor': ref(HERE / 'controler-reception-bornee.py'),
    'mechanical_Q_job_id': '753285', 'source_members': 108,
    'normal_native_first_batch_or_evaluation_proved_by_this_delivery': False,
    'private_actual_argv_received_by_this_delivery': False,
    'model_calls': 0, 'native_processes': 0, 'transport_calls': 0,

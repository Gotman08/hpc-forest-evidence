"""Copy the reviewed, frozen article delivery into the public evidence bundle."""
from pathlib import Path
import hashlib
import json
import re
import shutil

ROOT = Path(__file__).resolve().parent / "hpc-forest-evidence"
SOURCE = Path(r"C:\Users\nicol\Documents\Codex\2026-10-19\c-users-nicol-documents-codex-2026-4\outputs\HPC-Forest-Article-Actualise-20261019-r3")
DEST = ROOT / "docs/article"
manifest_raw = (SOURCE / "MANIFESTE-SHA256.json").read_bytes()
manifest = json.loads(manifest_raw)
admitted = {row["relative_path"]: row for row in manifest["copies"]}
names = {"ARTICLE.pdf", "ARTICLE.md", "ANNEXES-TECHNIQUES.pdf", "ANNEXES-TECHNIQUES.md"}
for name in ("ARTICLE.md", "ANNEXES-TECHNIQUES.md"):
    for link in re.findall(r"!?\[[^\]]*\]\(([^\s)]+)\)", (SOURCE / name).read_text(encoding="utf8")):
        if not re.match(r"[a-z][a-z0-9+.-]*:", link, re.I) and not link.startswith("#"):
            names.add(link.split("#", 1)[0])
records = []
for name in sorted(names):
    path = SOURCE / name
    raw = path.read_bytes()
    digest = hashlib.sha256(raw).hexdigest()
    if name not in admitted or digest != admitted[name]["sha256"] or len(raw) != admitted[name]["bytes"]:
        raise ValueError(f"Delivery mismatch: {name}")
    dest = DEST / name
    if dest.exists():
        raise ValueError(f"Refusing overwrite: {name}")
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(path, dest)
    assert dest.read_bytes() == raw
    records.append({"path": name, "bytes": len(raw), "sha256": digest})
(DEST / "provenance.json").write_text(json.dumps({
    "schema": "hpc-forest-public-article-delivery-v1",
    "edition": "2026-10-19-r3",
    "technical_snapshot_utc": manifest["technical_snapshot_utc"],
    "historical_data_cutoff_utc": manifest["scientific_data_cutoff_utc"],
    "original_delivery_manifest_sha256": hashlib.sha256(manifest_raw).hexdigest(),
    "article_pages": 19, "appendix_pages": 308,
    "copy_policy": "Exact bytes of the reviewed PDFs, Markdown and their 275 linked figures; private operational receipts are excluded.",
    "files": records,
}, indent=2, ensure_ascii=False) + "\n", encoding="utf8", newline="\n")
print(json.dumps({"copied_files": len(records), "bytes": sum(x["bytes"] for x in records)}))

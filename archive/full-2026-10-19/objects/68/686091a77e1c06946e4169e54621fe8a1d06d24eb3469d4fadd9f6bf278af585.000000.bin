def need(ok,message):
    if not ok: raise ValueError(message)
def sha(data): return hashlib.sha256(data).hexdigest()
primitive=RAW.read_bytes()
need(sha(primitive)=='5c1e1784574566a585e2d9cc50f85b52337d10d3109e449a4112581eae68f8d5','Cold IO pin')
names={'need','ordinary','metadata','open_nofollow_read','cross_identity','validate_windows_mode_views','native_basic_info','raw'}
nodes=[n for n in ast.parse(primitive).body if isinstance(n,ast.FunctionDef) and n.name in names]
need({n.name for n in nodes}==names,'Exact own cold IO definitions')
ns={'Path':Path,'os':os,'stat':stat,'Q':BASE}
exec(compile(ast.Module(body=nodes,type_ignores=[]),str(RAW),'exec'),ns)
before={}; data_cache={}
def read(path,expected=None):
    path=Path(path)
    need(path.is_absolute() and path.is_relative_to(BASE) and '..' not in path.parts,'Cold input boundary')
    need(path!=KNOWN and not path.is_relative_to(KNOWN),'No known-directory or child access')
    need(path.name.rstrip(' .').casefold() not in {'observer.lock','worker.lock','observer-state.json'},'No live state or lock')
    value=ns['raw'](path)
    need(expected is None or sha(value)==expected,'Cold SHA mismatch '+str(path))
    record={'path':str(path),'sha256':sha(value),'bytes':len(value),'metadata':list(ns['metadata'](path.lstat()))}
    need(str(path) not in before or before[str(path)]==record,'Input changed during read')
    before[str(path)]=record;data_cache[str(path)]=value
    return value
def doc(path,expected=None):return json.loads(read(path,expected))
def ref(path):return {'path':str(path),'sha256':sha(read(path))}

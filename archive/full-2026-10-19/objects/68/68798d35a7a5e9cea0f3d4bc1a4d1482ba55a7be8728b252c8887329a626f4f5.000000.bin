{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\n  \"files\": [\n    {\n      \"content\": \"#include <algorithm>\\n#include <cassert>\\n#include <cstddef>\\n#include <cstdio>\\n#include <limits>\\n#include <vector>\\n\\n#ifdef _OPENMP\\n#include <omp.h>\\n#endif\\n\\nstatic long long scan_band(const int* matrix, long long* columns,\\n                           int n, int s, int begin, int end) {\\n    long long first_sum = 0;\\n#if defined(_OPENMP) && _OPENMP >= 201307\\n#pragma omp simd reduction(+:first_sum)\\n#endif\\n    for (int c = 0; c < s; ++c)\\n        first_sum += columns[c];\\n\\n    long long best = std::numeric_limits<long long>::min();\\n    for (int top = begin; top < end; ++top) {\\n        long long sum = first_sum;\\n        if (sum > best)\\n            best = sum;\\n        for (int c = s; c < n; ++c) {\\n            sum += columns[c] - columns[c - s];\\n            if (sum > best)\\n                best = sum;\\n        }\\n\\n        if (top + 1 == end)\\n            break;\\n\\n        const int* leaving = matrix + static_cast<std::size_t>(top) * n;\\n        const int* entering = leaving + static_cast<std::size_t>(s) * n;\\n        long long first_change = 0;\\n#if defined(_OPENMP) && _OPENMP >= 201307\\n#pragma omp simd reduction(+:first_change)\\n#endif\\n        for (int c = 0; c < s; ++c) {\\n            const long long change = static_cast<long long>(entering[c]) - leaving[c];\\n            columns[c] += change;\\n            first_change += change;\\n        }\\n#if defined(_OPENMP) && _OPENMP >= 201307\\n#pragma omp simd\\n#endif\\n        for (int c = s; c < n; ++c)\\n            columns[c] += static_cast<long long>(entering[c]) - leaving[c];\\n        first_sum += first_change;\\n    }\\n    return best;\\n}\\n\\nint main() {\\n    int n, s;\\n    if (std::scanf(\\\"%d%d\\\", &n, &s) != 2)\\n        return 0;\\n\\n    assert(s < n);\\n    assert(n < 8000);\\n    assert(s > 0);\\n    assert(n > 0);\\n\\n    const int windows = n - s + 1;\\n    int bands = 1;\\n#ifdef _OPENMP\\n    const int available = std::max(1, std::min(4, omp_get_max_threads()));\\n    const long long scan_cells = static_cast<long long>(n) * windows;\\n    const int useful = std::max(1, static_cast<int>(scan_cells / (256 * 1024)));\\n    bands = std::min(windows, std::min(available, useful));\\n#endif\\n\\n    std::vector<int> begins(bands + 1);\\n    for (int b = 0; b <= bands; ++b)\\n        begins[b] = windows * b / bands;\\n\\n    std::vector<int> matrix(static_cast<std::size_t>(n) * n);\\n    const std::size_t stride = ((static_cast<std::size_t>(n) + 15) / 16) * 16 + 16;\\n    std::vector<long long> columns(static_cast<std::size_t>(bands) * stride, 0);\\n    std::vector<long long> prefix(n, 0);\\n\\n    // Capture all band seeds during input without rereading overlapping rows.\\n    int active = 0;\\n    for (int row = 0; row <= n; ++row) {\\n        for (int b = 0; b < bands; ++b) {\\n            long long* state = columns.data() + static_cast<std::size_t>(b) * stride;\\n            if (row == begins[b]) {\\n                for (int c = 0; c < n; ++c)\\n                    state[c] = -prefix[c];\\n                ++active;\\n            }\\n            if (row == begins[b] + s) {\\n                for (int c = 0; c < n; ++c)\\n                    state[c] += prefix[c];\\n                --active;\\n            }\\n        }\\n        if (row == n)\\n            break;\\n\\n        int* destination = matrix.data() + static_cast<std::size_t>(row) * n;\\n        if (active > 0) {\\n            for (int c = 0; c < n; ++c) {\\n                std::scanf(\\\"%d\\\", destination + c);\\n                prefix[c] += destination[c];\\n            }\\n        } else {\\n            for (int c = 0; c < n; ++c)\\n                std::scanf(\\\"%d\\\", destination + c);\\n        }\\n    }\\n\\n    long long best = std::numeric_limits<long long>::min();\\n#ifdef _OPENMP\\n    if (bands > 1) {\\n#pragma omp parallel for num_threads(bands) schedule(static, 1) reduction(max:best)\\n        for (int b = 0; b < bands; ++b) {\\n            const long long value = scan_band(\\n                matrix.data(), columns.data() + static_cast<std::size_t>(b) * stride,\\n                n, s, begins[b], begins[b + 1]);\\n            if (value > best)\\n                best = value;\\n        }\\n    } else\\n#endif\\n    {\\n        best = scan_band(matrix.data(), columns.data(), n, s, 0, windows);\\n    }\\n\\n    std::printf(\\\"%lld\\\\n\\\", best);\\n    return 0;\\n}\\n\",\n      \"path\": \"src/solution.cpp\"\n    }\n  ],\n  \"hypothesis\": \"Input-time prefix snapshots can eliminate redundant initialization of independent OpenMP row bands, while a work-based cutoff avoids parallel startup for small scans.\",\n  \"notes\": \"Not executed. OpenMP requires support from the unchanged build; otherwise the implementation runs serially.\",\n  \"sources_kept\": [],\n  \"transformations\": [\n    \"Replace strided repeated summation with contiguous storage and O(N²) rolling sums using 64-bit intermediates.\",\n    \"Prepare every band's initial column sums during input, accumulating overlapping seed rows only once.\",\n    \"Use up to four balanced static row bands, padded private state, a maximum reduction, and a work-based serial cutoff.\",\n    \"Maintain each row's first window sum during SIMD-friendly entering/leaving-row updates.\"\n  ]\n}"}}

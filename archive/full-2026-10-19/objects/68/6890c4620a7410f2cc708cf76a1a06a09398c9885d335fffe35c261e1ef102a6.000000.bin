#include <stdio.h>
#include <stdlib.h>

typedef struct {
    float x;
    float y;
} Point;

typedef struct {
    char label;
    int length;
    Point *points;
} Group;

void on_error(void) {
    printf("Invalid input file.\n");
    exit(1);
}

int parse_number_of_groups(void) {
    int n;
    if (scanf(" n_groups=%d ", &n) != 1) on_error();
    return n;
}

Point parse_point(void) {
    float x, y;
    if (scanf(" (%f ,%f) ", &x, &y) != 2) on_error();
    Point p = {x, y};
    return p;
}

Group parse_next_group(void);

int parse_k(void) {
    int k;
    if (scanf(" k=%d ", &k) != 1) on_error();
    return k;
}

char knn(int n_pts, float *xs, float *ys, char *labels,
         int k, Point to_evaluate);

        "content": "#include \"knn.h\"\n#include <limits.h>\n#include <string.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nstatic char knn_histogram_vote(const size_t * histogram) {\n    char best = (char)-1;\n    size_t best_count = 0;\n\n    for (int value = CHAR_MIN; value <= CHAR_MAX; ++value) {\n        size_t count = histogram[(unsigned char)(char)value];\n        if (count > best_count) {\n            best = (char)value;\n            best_count = count;\n        }\n    }\n    return best;\n}\n\nstatic char knn_insertion(int n_groups, Group * groups, int k,\n                          Point to_evaluate) {\n    char * labels = (char *)malloc((size_t)k * sizeof(*labels));\n    float * distances = (float *)malloc((size_t)k * sizeof(*distances));\n    int ordered = 1;\n\n    for (int i = 0; i < k; ++i) {\n        labels[i] = (char)-1;\n        distances[i] = -1.0f;\n    }\n\n    for (int i = 0; i < n_groups; ++i) {\n        Group group = groups[i];\n        for (int j = 0; j < group.length; ++j) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, group.points[j]);\n            if (d != d) {\n                ordered = 0;\n            }\n\n            if (ordered && distances[k - 1] != -1.0f &&\n                d >= distances[k - 1]) {\n                continue;\n            }\n\n            int insertion = k;\n#ifdef _OPENMP\n            #pragma omp simd reduction(min:insertion)\n#endif\n            for (int x = 0; x < k; ++x) {\n                int candidate = (d < distances[x] || distances[x] == -1.0f)\n                              ? x : k;\n                if (candidate < insertion) {\n                    insertion = candidate;\n                }\n            }\n\n            if (insertion < k) {\n                size_t count = (size_t)(k - insertion - 1);\n                if (count != 0) {\n                    memmove(distances + insertion + 1, distances + insertion,\n                            count * sizeof(*distances));\n                    memmove(labels + insertion + 1, labels + insertion,\n                            count * sizeof(*labels));\n                }\n                distances[insertion] = d;\n                labels[insertion] = group.label;\n            }\n        }\n    }\n\n    size_t histogram[UCHAR_MAX + 1] = {0};\n    for (int i = 0; i < k; ++i) {\n        ++histogram[(unsigned char)labels[i]];\n    }\n    free(distances);\n    free(labels);\n    return knn_histogram_vote(histogram);\n}\n\nstatic void knn_sift_down(float * heap, size_t count, size_t root) {\n    float value = heap[root];\n    while (root < count / 2) {\n        size_t child = root * 2 + 1;\n        if (child + 1 < count && heap[child] < heap[child + 1]) {\n            ++child;\n        }\n        if (!(value < heap[child])) {\n            break;\n        }\n        heap[root] = heap[child];\n        root = child;\n    }\n    heap[root] = value;\n}\n\nstatic char knn_heap(int n_groups, Group * groups, int k, Point to_evaluate) {\n    size_t capacity = (size_t)k;\n    float * heap = (float *)malloc(capacity * sizeof(*heap));\n    if (heap == NULL) {\n        return knn_insertion(n_groups, groups, k, to_evaluate);\n    }\n    size_t used = 0;\n\n    for (int i = 0; i < n_groups; ++i) {\n        Group group = groups[i];\n        for (int j = 0; j < group.length; ++j) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, group.points[j]);\n            if (d != d) {\n                free(heap);\n                return knn_insertion(n_groups, groups, k, to_evaluate);\n            }\n\n            if (used < capacity) {\n                heap[used++] = d;\n                if (used == capacity) {\n                    for (size_t parent = used / 2; parent > 0; --parent) {\n                        knn_sift_down(heap, used, parent - 1);\n                    }\n                }\n            } else if (d < heap[0]) {\n                heap[0] = d;\n                knn_sift_down(heap, used, 0);\n            }\n        }\n    }\n\n    float cutoff = 0.0f;\n    size_t take_equal = 0;\n    if (used == capacity) {\n        cutoff = heap[0];\n        for (size_t i = 0; i < used; ++i) {\n            take_equal += (heap[i] == cutoff);\n        }\n    }\n    free(heap);\n\n    size_t histogram[UCHAR_MAX + 1] = {0};\n    if (used < capacity) {\n        for (int i = 0; i < n_groups; ++i) {\n            if (groups[i].length > 0) {\n                histogram[(unsigned char)groups[i].label] +=\n                    (size_t)groups[i].length;\n            }\n        }\n        histogram[(unsigned char)(char)-1] += capacity - used;\n    } else {\n        for (int i = 0; i < n_groups; ++i) {\n            Group group = groups[i];\n            for (int j = 0; j < group.length; ++j) {\n                float d = euclidean_distance_no_sqrt(to_evaluate,\n                                                      group.points[j]);\n                if (d < cutoff) {\n                    ++histogram[(unsigned char)group.label];\n                } else if (d == cutoff && take_equal != 0) {\n                    ++histogram[(unsigned char)group.label];\n                    --take_equal;\n                }\n            }\n        }\n    }\n    return knn_histogram_vote(histogram);\n}\n\n#ifdef _OPENMP\n\ntypedef struct {\n    size_t begin;\n    size_t end;\n    size_t lo;\n    size_t hi;\n    size_t lower;\n    size_t upper;\n    size_t take_equal;\n    size_t histogram[UCHAR_MAX + 1];\n} KnnRankPart;\n\nstatic int knn_float_compare(const void * a, const void * b) {\n    float x = *(const float *)a;\n    float y = *(const float *)b;\n    return (x > y) - (x < y);\n}\n\nstatic float knn_rank_pivot(const float * values, const KnnRankPart * parts,\n                            int part_count, int sorted) {\n    int chosen = 0;\n    size_t largest = 0;\n    for (int p = 0; p < part_count; ++p) {\n        size_t length = parts[p].hi - parts[p].lo;\n        if (length > largest) {\n            largest = length;\n            chosen = p;\n        }\n    }\n\n    size_t lo = parts[chosen].lo;\n    size_t hi = parts[chosen].hi;\n    float b = values[lo + (hi - lo) / 2];\n    if (sorted) {\n        return b;\n    }\n    float a = values[lo];\n    float c = values[hi - 1];\n    if (a > b) {\n        float temporary = a;\n        a = b;\n        b = temporary;\n    }\n    if (b > c) {\n        b = c;\n    }\n    if (a > b) {\n        b = a;\n    }\n    return b;\n}\n\nstatic char knn_parallel_rank(int n_groups, Group * groups, int k,\n                               Point to_evaluate, size_t total, int workers) {\n    if (total > (size_t)-1 / sizeof(float)) {\n        return knn_heap(n_groups, groups, k, to_evaluate);\n    }\n    float * values = (float *)malloc(total * sizeof(*values));\n    if (values == NULL) {\n        return knn_heap(n_groups, groups, k, to_evaluate);\n    }\n\n    KnnRankPart parts[4];\n    size_t block = total / (size_t)workers;\n    size_t extra = total % (size_t)workers;\n    size_t begin = 0;\n    for (int p = 0; p < workers; ++p) {\n        parts[p].begin = begin;\n        parts[p].end = begin + block + ((size_t)p < extra);\n        parts[p].lo = begin;\n        parts[p].hi = parts[p].end;\n        parts[p].take_equal = 0;\n        begin = parts[p].end;\n    }\n\n    size_t rank = (size_t)k < total ? (size_t)k : total;\n    size_t below_total = 0;\n    size_t equal_total = 0;\n    float cutoff = 0.0f;\n    int has_nan = 0;\n    int rounds = 0;\n    int sorted = 0;\n    int direction = 0;\n    int finished = 0;\n\n    #pragma omp parallel num_threads(workers)\n    {\n        #pragma omp for schedule(static) reduction(|:has_nan)\n        for (int p = 0; p < workers; ++p) {\n            KnnRankPart * part = &parts[p];\n            size_t offset = 0;\n            for (int g = 0; g < n_groups && offset < part->end; ++g) {\n                Group group = groups[g];\n                size_t length = group.length > 0 ? (size_t)group.length : 0;\n                size_t group_end = offset + length;\n                if (group_end > part->begin) {\n                    size_t first = part->begin > offset\n                                 ? part->begin - offset : 0;\n                    size_t last = part->end < group_end\n                                ? part->end - offset : length;\n                    for (size_t j = first; j < last; ++j) {\n                        float d = euclidean_distance_no_sqrt(to_evaluate,\n                                                              group.points[j]);\n                        values[offset + j] = d;\n                        has_nan |= (d != d);\n                    }\n                }\n                offset = group_end;\n            }\n        }\n\n        if (!has_nan) {\n            for (;;) {\n                if (rounds == 32) {\n                    #pragma omp for schedule(static)\n                    for (int p = 0; p < workers; ++p) {\n                        qsort(values + parts[p].lo,\n                              parts[p].hi - parts[p].lo,\n                              sizeof(*values), knn_float_compare);\n                    }\n                    #pragma omp single\n                    {\n                        sorted = 1;\n                    }\n                }\n\n                #pragma omp single\n                {\n                    cutoff = knn_rank_pivot(values, parts, workers, sorted);\n                    below_total = 0;\n                    equal_total = 0;\n                }\n\n                #pragma omp for schedule(static) reduction(+:below_total,equal_total)\n                for (int p = 0; p < workers; ++p) {\n                    KnnRankPart * part = &parts[p];\n                    if (sorted) {\n                        size_t first = part->lo;\n                        size_t last = part->hi;\n                        while (first < last) {\n                            size_t middle = first + (last - first) / 2;\n                            if (values[middle] < cutoff) {\n                                first = middle + 1;\n                            } else {\n                                last = middle;\n                            }\n                        }\n                        part->lower = first;\n                        last = part->hi;\n                        while (first < last) {\n                            size_t middle = first + (last - first) / 2;\n                            if (values[middle] <= cutoff) {\n                                first = middle + 1;\n                            } else {\n                                last = middle;\n                            }\n                        }\n                        part->upper = first;\n                    } else {\n                        size_t lower = part->lo;\n                        size_t current = part->lo;\n                        size_t upper = part->hi;\n                        while (current < upper) {\n                            float value = values[current];\n                            if (value < cutoff) {\n                                values[current] = values[lower];\n                                values[lower] = value;\n                                ++lower;\n                                ++current;\n                            } else if (value > cutoff) {\n                                --upper;\n                                values[current] = values[upper];\n                                values[upper] = value;\n                            } else {\n                                ++current;\n                            }\n                        }\n                        part->lower = lower;\n                        part->upper = upper;\n                    }\n                    below_total += part->lower - part->lo;\n                    equal_total += part->upper - part->lower;\n                }\n\n                #pragma omp single\n                {\n                    if (rank <= below_total) {\n                        direction = -1;\n                    } else if (rank > below_total + equal_total) {\n                        rank -= below_total + equal_total;\n                        direction = 1;\n                    } else {\n                        finished = 1;\n                        size_t remaining = rank - below_total;\n                        for (int p = 0; p < workers; ++p) {\n                            size_t count = parts[p].upper - parts[p].lower;\n                            size_t take = count < remaining ? count : remaining;\n                            parts[p].take_equal = take;\n                            remaining -= take;\n                        }\n                    }\n                    ++rounds;\n                }\n\n                if (finished) {\n                    break;\n                }\n                #pragma omp for schedule(static)\n                for (int p = 0; p < workers; ++p) {\n                    if (direction < 0) {\n                        parts[p].hi = parts[p].lower;\n                    } else {\n                        parts[p].lo = parts[p].upper;\n                    }\n                }\n            }\n\n            #pragma omp for schedule(static)\n            for (int p = 0; p < workers; ++p) {\n                KnnRankPart * part = &parts[p];\n                memset(part->histogram, 0, sizeof(part->histogram));\n                size_t remaining = part->take_equal;\n                size_t offset = 0;\n                for (int g = 0; g < n_groups && offset < part->end; ++g) {\n                    Group group = groups[g];\n                    size_t length = group.length > 0 ? (size_t)group.length : 0;\n                    size_t group_end = offset + length;\n                    if (group_end > part->begin) {\n                        size_t first = part->begin > offset\n                                     ? part->begin - offset : 0;\n                        size_t last = part->end < group_end\n                                    ? part->end - offset : length;\n                        size_t below = 0;\n                        size_t equal = 0;\n                        #pragma omp simd reduction(+:below,equal)\n                        for (size_t j = first; j < last; ++j) {\n                            float d = euclidean_distance_no_sqrt(to_evaluate,\n                                                                  group.points[j]);\n                            below += (d < cutoff);\n                            equal += (d == cutoff);\n                        }\n                        size_t take = equal < remaining ? equal : remaining;\n                        part->histogram[(unsigned char)group.label] += below + take;\n                        remaining -= take;\n                    }\n                    offset = group_end;\n                }\n            }\n        }\n    }\n\n    free(values);\n    if (has_nan) {\n        return knn_insertion(n_groups, groups, k, to_evaluate);\n    }\n\n    size_t histogram[UCHAR_MAX + 1] = {0};\n    if ((size_t)k > total) {\n        histogram[(unsigned char)(char)-1] = (size_t)k - total;\n    }\n    for (int p = 0; p < workers; ++p) {\n        for (int label = 0; label <= UCHAR_MAX; ++label) {\n            histogram[label] += parts[p].histogram[label];\n        }\n    }\n    return knn_histogram_vote(histogram);\n}\n\n#endif\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    if (k <= 0) {\n        return (char)-1;\n    }\n    if (k <= 64) {\n        return knn_insertion(n_groups, groups, k, to_evaluate);\n    }\n\n#ifdef _OPENMP\n    size_t total = 0;\n    for (int i = 0; i < n_groups; ++i) {\n        if (groups[i].length > 0) {\n            total += (size_t)groups[i].length;\n        }\n    }\n    int workers = omp_get_max_threads();\n    if (workers > 4) {\n        workers = 4;\n    }\n    size_t useful_threads = total / 32768;\n    if ((size_t)workers > useful_threads) {\n        workers = (int)useful_threads;\n    }\n    if (workers > 1) {\n        return knn_parallel_rank(n_groups, groups, k, to_evaluate, total, workers);\n    }\n#endif\n\n    return knn_heap(n_groups, groups, k, to_evaluate);\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",

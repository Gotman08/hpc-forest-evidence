#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>

#define N_ITER 10 // number of simulation iterations
#define DT 0.01f // time step
#define SOFTENING 1e-9f // to avoid zero divisors

/*
 * Each body holds coordinate positions (i.e., x, y, and z) and
 * velocities (i.e., vx, vy, and vz).
 */
typedef struct { float x, y, z, vx, vy, vz; } Body;

static float *allocate_position_scratch(int n) {
  if (n <= 0 || (size_t)n > (size_t)-1 / (3 * sizeof(float))) {
    return NULL;
  }
  return (float *)malloc((size_t)n * 3 * sizeof(float));
}

/* Allocation fallback; called collectively by the current team. */
static void body_force_direct_work(Body *p, float dt, int n) {
  #pragma omp for schedule(static)
  for (int i = 0; i < n; ++i) {
    float fx = 0.0f;
    float fy = 0.0f;
    float fz = 0.0f;

    for (int j = 0; j < n; j++) {
      float dx = p[j].x - p[i].x;
      float dy = p[j].y - p[i].y;
      float dz = p[j].z - p[i].z;
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1 / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx += dx * inv_dist3;
      fy += dy * inv_dist3;
      fz += dz * inv_dist3;
    }

    p[i].vx += dt*fx;
    p[i].vy += dt*fy;
    p[i].vz += dt*fz;
  }
}

/* Keep the SIMD helper's math options on the worker-executed function. */
#if defined(__GNUC__) && !defined(__clang__)
__attribute__((noinline, optimize("no-math-errno")))
#endif
static void accumulate_force_four(const float *restrict px,
                                  const float *restrict py,
                                  const float *restrict pz,
                                  int i, int jb, int je,
                                  float *restrict force_x,
                                  float *restrict force_y,
                                  float *restrict force_z) {
  float x[4], y[4], z[4];
  float fx[4], fy[4], fz[4];

  for (int lane = 0; lane < 4; ++lane) {
    x[lane] = px[i + lane];
    y[lane] = py[i + lane];
    z[lane] = pz[i + lane];
    fx[lane] = force_x[lane];
    fy[lane] = force_y[lane];
    fz[lane] = force_z[lane];
  }

  int j = jb;
  for (; je - j >= 4; j += 4) {
    const float jx0 = px[j];
    const float jy0 = py[j];
    const float jz0 = pz[j];
    const float jx1 = px[j + 1];
    const float jy1 = py[j + 1];
    const float jz1 = pz[j + 1];
    const float jx2 = px[j + 2];
    const float jy2 = py[j + 2];
    const float jz2 = pz[j + 2];
    const float jx3 = px[j + 3];
    const float jy3 = py[j + 3];
    const float jz3 = pz[j + 3];

    #pragma omp simd simdlen(4)
    for (int lane = 0; lane < 4; ++lane) {
      float dx0 = jx0 - x[lane];
      float dy0 = jy0 - y[lane];
      float dz0 = jz0 - z[lane];
      float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;
      float inv_dist0 = 1 / sqrt(sqrd_dist0);
      float inv_dist30 = inv_dist0 * inv_dist0 * inv_dist0;

      float dx1 = jx1 - x[lane];
      float dy1 = jy1 - y[lane];
      float dz1 = jz1 - z[lane];
      float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;
      float inv_dist1 = 1 / sqrt(sqrd_dist1);
      float inv_dist31 = inv_dist1 * inv_dist1 * inv_dist1;

      float dx2 = jx2 - x[lane];
      float dy2 = jy2 - y[lane];
      float dz2 = jz2 - z[lane];
      float sqrd_dist2 = dx2*dx2 + dy2*dy2 + dz2*dz2 + SOFTENING;
      float inv_dist2 = 1 / sqrt(sqrd_dist2);
      float inv_dist32 = inv_dist2 * inv_dist2 * inv_dist2;

      float dx3 = jx3 - x[lane];
      float dy3 = jy3 - y[lane];
      float dz3 = jz3 - z[lane];
      float sqrd_dist3 = dx3*dx3 + dy3*dy3 + dz3*dz3 + SOFTENING;
      float inv_dist3 = 1 / sqrt(sqrd_dist3);
      float inv_dist33 = inv_dist3 * inv_dist3 * inv_dist3;

      /* Each target retains one ascending-source accumulator chain. */
      fx[lane] += dx0 * inv_dist30;
      fy[lane] += dy0 * inv_dist30;
      fz[lane] += dz0 * inv_dist30;

      fx[lane] += dx1 * inv_dist31;
      fy[lane] += dy1 * inv_dist31;
      fz[lane] += dz1 * inv_dist31;

      fx[lane] += dx2 * inv_dist32;
      fy[lane] += dy2 * inv_dist32;
      fz[lane] += dz2 * inv_dist32;

      fx[lane] += dx3 * inv_dist33;
      fy[lane] += dy3 * inv_dist33;
      fz[lane] += dz3 * inv_dist33;
    }
  }

  for (; j < je; ++j) {
    const float jx = px[j];
    const float jy = py[j];
    const float jz = pz[j];

    #pragma omp simd simdlen(4)
    for (int lane = 0; lane < 4; ++lane) {
      float dx = jx - x[lane];
      float dy = jy - y[lane];
      float dz = jz - z[lane];
      float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
      float inv_dist = 1 / sqrt(sqrd_dist);
      float inv_dist3 = inv_dist * inv_dist * inv_dist;

      fx[lane] += dx * inv_dist3;
      fy[lane] += dy * inv_dist3;
      fz[lane] += dz * inv_dist3;
    }
  }

  for (int lane = 0; lane < 4; ++lane) {
    force_x[lane] = fx[lane];
    force_y[lane] = fy[lane];
    force_z[lane] = fz[lane];
  }
}

/*
 * Collective worksharing kernel. Packing finishes before forces begin,
 * and each target retains the original increasing source order.
 */
#if defined(__GNUC__) && !defined(__clang__)
__attribute__((optimize("no-math-errno")))
#endif
static void body_force_work(Body *p, float dt, int n, float *positions) {
  enum { TARGET_BLOCK = 64, SOURCE_BLOCK = 256 };

  if (positions == NULL) {
    body_force_direct_work(p, dt, n);
    return;
  }

  float *restrict x = positions;
  float *restrict y = positions + (size_t)n;
  float *restrict z = positions + (size_t)n * 2;

  #pragma omp for schedule(static)
  for (int i = 0; i < n; ++i) {
    x[i] = p[i].x;
    y[i] = p[i].y;
    z[i] = p[i].z;
  }

  const int nblocks = n / TARGET_BLOCK + (n % TARGET_BLOCK != 0);

  #pragma omp for schedule(static)
  for (int block = 0; block < nblocks; ++block) {
    const int ib = block * TARGET_BLOCK;
    int ni = n - ib;
    if (ni > TARGET_BLOCK) {
      ni = TARGET_BLOCK;
    }

    float fx[TARGET_BLOCK] = {0.0f};
    float fy[TARGET_BLOCK] = {0.0f};
    float fz[TARGET_BLOCK] = {0.0f};

    for (int jb = 0; jb < n; ) {
      int nj = n - jb;
      if (nj > SOURCE_BLOCK) {
        nj = SOURCE_BLOCK;
      }
      const int je = jb + nj;
      int k = 0;

      for (; k + 3 < ni; k += 4) {
        accumulate_force_four(x, y, z, ib + k, jb, je,
                              &fx[k], &fy[k], &fz[k]);
      }

      for (; k < ni; ++k) {
        const int i = ib + k;
        const float xi = x[i];
        const float yi = y[i];
        const float zi = z[i];
        float fxi = fx[k];
        float fyi = fy[k];
        float fzi = fz[k];

        for (int j = jb; j < je; ++j) {
          float dx = x[j] - xi;
          float dy = y[j] - yi;
          float dz = z[j] - zi;
          float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;
          float inv_dist = 1 / sqrt(sqrd_dist);
          float inv_dist3 = inv_dist * inv_dist * inv_dist;
          fxi += dx * inv_dist3;
          fyi += dy * inv_dist3;
          fzi += dz * inv_dist3;
        }

        fx[k] = fxi;
        fy[k] = fyi;
        fz[k] = fzi;
      }

      jb = je;
    }

    for (int k = 0; k < ni; ++k) {
      p[ib + k].vx += dt*fx[k];
      p[ib + k].vy += dt*fy[k];
      p[ib + k].vz += dt*fz[k];
    }
  }
}

/* Standalone calls own their scratch storage and parallel team. */
void body_force(Body *p, float dt, int n) {
  if (n <= 0) {
    return;
  }

  float *positions = allocate_position_scratch(n);
  #pragma omp parallel
  {
    body_force_work(p, dt, n, positions);
  }
  free(positions);
}

/*
 * Read a binary dataset with initilized bodies.
 */
Body* read_dataset(int *nbodies) {
  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading nbodie value\n");
    exit(EXIT_FAILURE);
  }
  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));
  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);
  if (b != 1) {
    fprintf(stderr,"\nError reading input values\n");
    exit(EXIT_FAILURE);
  }

  return bodies;
}

/*
 * Write simulation results into a binary dataset.
 */
void write_dataset(const int nbodies, Body *bodies) {
  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);
  if (b != 1) {
    fprintf(stderr,"\nError writing to output\n");
    exit(EXIT_FAILURE);
  }
}

int main(int argc,char **argv) {
  int nbodies;

  Body *bodies = read_dataset(&nbodies);
  float *positions = allocate_position_scratch(nbodies);

  /* One team spans all steps; implicit barriers separate each phase. */
  #pragma omp parallel
  {
    for (int iter = 0; iter < N_ITER; iter++) {
      body_force_work(bodies, DT, nbodies, positions);

      #pragma omp for schedule(static)
      for (int i = 0; i < nbodies; i++) {
        bodies[i].x += bodies[i].vx * DT;
        bodies[i].y += bodies[i].vy * DT;
        bodies[i].z += bodies[i].vz * DT;
      }
    }
  }

  free(positions);
  write_dataset(nbodies, bodies);

  free(bodies);

  exit(EXIT_SUCCESS);
}

{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"files\":[{\"content\":\"#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n#include <stdint.h>\\n\\n#define MAX 100\\n\\ntypedef struct {\\n  int id;\\n  float value;\\n  char neighbors[MAX + 1];\\n} Node;\\n\\ntypedef struct {\\n  int key;\\n  int index;\\n} IdSlot;\\n\\ntypedef struct {\\n  int dense_base;\\n  size_t dense_span;\\n  int *dense;\\n  IdSlot *slots;\\n  size_t mask;\\n} IdIndex;\\n\\nstatic void fail(void) {\\n  fprintf(stderr, \\\"Error!\\\\n\\\");\\n  exit(1);\\n}\\n\\nstatic void *checked_malloc(size_t bytes) {\\n  void *pointer = malloc(bytes);\\n  if (pointer == NULL && bytes != 0)\\n    fail();\\n  return pointer;\\n}\\n\\nstatic void *checked_calloc(size_t count, size_t size) {\\n  if (count != 0 && size > (size_t)-1 / count)\\n    fail();\\n  void *pointer = calloc(count, size);\\n  if (pointer == NULL && count != 0)\\n    fail();\\n  return pointer;\\n}\\n\\nstatic Node *read_input(char *fname, int *n, char *list) {\\n  FILE *fl = fname == NULL ? stdin : fopen(fname, \\\"r\\\");\\n  Node *data = NULL;\\n\\n  if (fl == NULL)\\n    fail();\\n\\n  if (fscanf(fl, \\\"%d %100[^\\\\n]\\\", n, list) != 2 || *n < 0)\\n    fail();\\n\\n  if (*n > 0) {\\n    if ((size_t)*n > (size_t)-1 / sizeof(*data))\\n      fail();\\n    data = checked_malloc((size_t)*n * sizeof(*data));\\n  }\\n\\n  for (int i = 0; i < *n; ++i) {\\n    if (fscanf(fl, \\\"%d %f %100[^\\\\n]\\\", &data[i].id, &data[i].value,\\n               data[i].neighbors) != 3)\\n      fail();\\n  }\\n\\n  fclose(fl);\\n  return data;\\n}\\n\\nstatic size_t count_neighbor_tokens(const char *text) {\\n  size_t count = 0;\\n\\n  while (*text != '\\\\0') {\\n    while (*text == ' ')\\n      ++text;\\n    if (*text == '\\\\0')\\n      break;\\n    ++count;\\n    while (*text != '\\\\0' && *text != ' ')\\n      ++text;\\n  }\\n\\n  return count;\\n}\\n\\nstatic unsigned int hash_id(int id) {\\n  unsigned int value = (unsigned int)id;\\n  value ^= value >> 16;\\n  value *= 0x7feb352dU;\\n  value ^= value >> 15;\\n  value *= 0x846ca68bU;\\n  value ^= value >> 16;\\n  return value;\\n}\\n\\nstatic IdIndex build_index(const Node *nodes, int n) {\\n  IdIndex index = { 0, 0, NULL, NULL, 0 };\\n\\n  if (n == 0) {\\n    index.slots = checked_malloc(sizeof(*index.slots));\\n    index.slots[0].index = -1;\\n    return index;\\n  }\\n\\n  int minimum = nodes[0].id;\\n  int maximum = nodes[0].id;\\n  for (int i = 1; i < n; ++i) {\\n    if (nodes[i].id < minimum)\\n      minimum = nodes[i].id;\\n    if (nodes[i].id > maximum)\\n      maximum = nodes[i].id;\\n  }\\n\\n  uint64_t span = (uint64_t)((int64_t)maximum - (int64_t)minimum) + 1U;\\n  uint64_t dense_limit = (uint64_t)(size_t)n * 8U + 64U;\\n  if (span <= dense_limit &&\\n      span <= (uint64_t)((size_t)-1 / sizeof(*index.dense))) {\\n    index.dense_base = minimum;\\n    index.dense_span = (size_t)span;\\n    index.dense = checked_malloc(index.dense_span * sizeof(*index.dense));\\n    for (size_t i = 0; i < index.dense_span; ++i)\\n      index.dense[i] = -1;\\n\\n    for (int i = 0; i < n; ++i) {\\n      size_t position = (size_t)((int64_t)nodes[i].id - (int64_t)minimum);\\n      if (index.dense[position] == -1)\\n        index.dense[position] = i;\\n    }\\n    return index;\\n  }\\n\\n  if ((size_t)n > (size_t)-1 / 2)\\n    fail();\\n  size_t target = (size_t)n * 2;\\n  size_t capacity = 1;\\n  while (capacity < target) {\\n    if (capacity > (size_t)-1 / 2)\\n      fail();\\n    capacity <<= 1;\\n  }\\n\\n  index.slots = checked_malloc(capacity * sizeof(*index.slots));\\n  index.mask = capacity - 1;\\n  for (size_t i = 0; i < capacity; ++i)\\n    index.slots[i].index = -1;\\n\\n  for (int i = 0; i < n; ++i) {\\n    size_t position = (size_t)hash_id(nodes[i].id) & index.mask;\\n    while (index.slots[position].index != -1 &&\\n           index.slots[position].key != nodes[i].id)\\n      position = (position + 1) & index.mask;\\n    if (index.slots[position].index == -1) {\\n      index.slots[position].key = nodes[i].id;\\n      index.slots[position].index = i;\\n    }\\n  }\\n\\n  return index;\\n}\\n\\nstatic int lookup_id(const IdIndex *index, int id) {\\n  if (index->dense != NULL) {\\n    int64_t position = (int64_t)id - (int64_t)index->dense_base;\\n    if (position < 0 || (uint64_t)position >= (uint64_t)index->dense_span)\\n      return -1;\\n    return index->dense[(size_t)position];\\n  }\\n\\n  size_t position = (size_t)hash_id(id) & index->mask;\\n  while (index->slots[position].index != -1) {\\n    if (index->slots[position].key == id)\\n      return index->slots[position].index;\\n    position = (position + 1) & index->mask;\\n  }\\n  return -1;\\n}\\n\\nstatic void destroy_index(IdIndex *index) {\\n  free(index->dense);\\n  free(index->slots);\\n}\\n\\nstatic float resolve_cost(int start, const float *values, const int *successor,\\n                          float *cost, unsigned char *state, int *path) {\\n  if (state[start] == 2)\\n    return cost[start];\\n\\n  int current = start;\\n  int length = 0;\\n  while (current >= 0 && state[current] == 0) {\\n    state[current] = 1;\\n    path[length++] = current;\\n    current = successor[current];\\n  }\\n\\n  if (current >= 0 && state[current] == 1)\\n    fail();\\n\\n  while (length != 0) {\\n    int node = path[--length];\\n    int next = successor[node];\\n    float result = values[node];\\n    if (next >= 0)\\n      result += cost[next];\\n    cost[node] = result;\\n    state[node] = 2;\\n  }\\n\\n  return cost[start];\\n}\\n\\nint main(void) {\\n  char computelist[MAX + 1];\\n  int n = -1;\\n  Node *input = read_input(NULL, &n, computelist);\\n  IdIndex ids = build_index(input, n);\\n\\n  float *values = n > 0 ? checked_malloc((size_t)n * sizeof(*values)) : NULL;\\n  size_t *offset = checked_malloc(((size_t)n + 1) * sizeof(*offset));\\n  offset[0] = 0;\\n  for (int i = 0; i < n; ++i) {\\n    values[i] = input[i].value;\\n    size_t count = count_neighbor_tokens(input[i].neighbors);\\n    if (count > (size_t)-1 - offset[i])\\n      fail();\\n    offset[i + 1] = offset[i] + count;\\n  }\\n\\n  int *neighbor = offset[n] != 0\\n                    ? checked_malloc(offset[n] * sizeof(*neighbor))\\n                    : NULL;\\n  size_t written = 0;\\n  for (int i = 0; i < n; ++i) {\\n    const char *token = input[i].neighbors;\\n    while (*token != '\\\\0') {\\n      while (*token == ' ')\\n        ++token;\\n      if (*token == '\\\\0')\\n        break;\\n      neighbor[written++] = lookup_id(&ids, atoi(token));\\n      while (*token != '\\\\0' && *token != ' ')\\n        ++token;\\n    }\\n  }\\n  free(input);\\n\\n  int *successor = n > 0\\n                   ? checked_malloc((size_t)n * sizeof(*successor))\\n                   : NULL;\\n  for (int i = 0; i < n; ++i) {\\n    float maximum = 0.0f;\\n    int selected = -1;\\n    for (size_t edge = offset[i]; edge < offset[i + 1]; ++edge) {\\n      int candidate = neighbor[edge];\\n      if (candidate >= 0 && maximum < values[candidate]) {\\n        maximum = values[candidate];\\n        selected = candidate;\\n      }\\n    }\\n    successor[i] = selected;\\n  }\\n  free(neighbor);\\n  free(offset);\\n\\n  float *cost = n > 0 ? checked_malloc((size_t)n * sizeof(*cost)) : NULL;\\n  unsigned char *state = n > 0\\n                         ? checked_calloc((size_t)n, sizeof(*state))\\n                         : NULL;\\n  int *path = n > 0 ? checked_malloc((size_t)n * sizeof(*path)) : NULL;\\n\\n  for (char *token = strtok(computelist, \\\" \\\"); token != NULL;\\n       token = strtok(NULL, \\\" \\\")) {\\n    int node = lookup_id(&ids, atoi(token));\\n    float result = node >= 0\\n                   ? resolve_cost(node, values, successor, cost, state, path)\\n                   : 0.0f;\\n    printf(\\\"%s: %f\\\\n\\\", token, result);\\n  }\\n\\n  free(path);\\n  free(state);\\n  free(cost);\\n  free(successor);\\n  free(values);\\n  destroy_index(&ids);\\n  return 0;\\n}\\n\",\"path\":\"src/graph.c\"}],\"hypothesis\":\"Converting variable-length neighbor text to compact index-based CSR, then traversing compact successor/value arrays, improves cache locality and removes repeated string scans and ID searches while preserving the selected-path float computation.\",\"notes\":\"Single-file bounded locality/data-layout experiment; first matching IDs, neighbor order, strict positive selection, float additions, query order, and output formatting are retained.\",\"research\":{\"queries\":[],\"urls\":[]},\"sources_kept\":[],\"transformations\":[\"Replace hot Node/string traversal with compact value, CSR neighbor-index, and selected-successor arrays.\",\"Use an adaptive dense ID range table with an open-addressed first-ID fallback, then memoize reverse functional-path evaluation.\"]}"}}

        "content": "#include <bits/stdc++.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\nusing namespace std;\n\nint A[1000][1000];\nint ps[1010][1010];\n\ntypedef long long ll;\n\nstatic int available_workers() {\n  int workers = 4;\n#ifdef _OPENMP\n  workers = min(workers, omp_get_max_threads());\n#else\n  const unsigned hardware = thread::hardware_concurrency();\n  if (hardware != 0)\n    workers = min(workers, static_cast<int>(min(hardware, 4U)));\n  for (const char *name : {\"OMP_NUM_THREADS\", \"OMP_THREAD_LIMIT\"}) {\n    const char *value = getenv(name);\n    if (value != nullptr) {\n      char *end = nullptr;\n      const long requested = strtol(value, &end, 10);\n      if (end != value && requested > 0 && requested < workers)\n        workers = static_cast<int>(requested);\n    }\n  }\n#endif\n  return max(workers, 1);\n}\n\nll solve(int m, int n, int k) {\n  for (int i = 1; i <= m; i++) {\n    for (int j = 1; j <= n; j++) {\n      ps[i][j] = A[i - 1][j - 1] + ps[i][j - 1];\n    }\n  }\n\n  const auto count_bands = [&](int first, int stride) -> ll {\n    unordered_map<ll, ll> h;\n    h.reserve(static_cast<size_t>(m) + 1);\n    ll subtotal = 0;\n    for (int j = first; j <= n; j += stride) {\n      for (int l = j; l <= n; l++) {\n        h.clear();\n        h[0] = 1;\n        ll s = 0;\n        for (int i = 1; i <= m; i++) {\n          s += ps[i][l] - ps[i][j - 1];\n          subtotal += h.find(s - k) != h.end() ? h[s - k] : 0;\n          h[s]++;\n        }\n      }\n    }\n    return subtotal;\n  };\n\n  const ll estimated_work = ll(m) * n * (n + 1) / 2;\n  int workers = 1;\n  if (estimated_work >= 131072LL)\n    workers = min(n, available_workers());\n  if (workers == 1)\n    return count_bands(1, 1);\n\n  ll ans = 0;\n#ifdef _OPENMP\n#pragma omp parallel num_threads(workers) reduction(+:ans)\n  {\n    ans += count_bands(omp_get_thread_num() + 1, omp_get_num_threads());\n  }\n#else\n  array<ll, 4> partials{};\n  array<thread, 3> threads;\n  for (int t = 1; t < workers; t++) {\n    threads[t - 1] = thread([&, t]() {\n      partials[t] = count_bands(t + 1, workers);\n    });\n  }\n  partials[0] = count_bands(1, workers);\n  for (int t = 1; t < workers; t++)\n    threads[t - 1].join();\n  for (int t = 0; t < workers; t++)\n    ans += partials[t];\n#endif\n  return ans;\n}\n\nint main() {\n  int k, m, n;\n  cin >> k >> m >> n;\n  memset(A, 0, sizeof A);\n  memset(ps, 0, sizeof ps);\n\n  for (int i = 0; i < m; i++)\n    for (int j = 0; j < n; j++)\n      cin >> A[i][j];\n\n  cout << solve(m, n, k) << endl;\n  return 0;\n}\n",
        "path": "src/main.cpp"
      }

      "content": "#include \"knn.h\"\n#include <arm_neon.h>\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\ntypedef struct {\n    float dist;\n    char label;\n    long idx;\n} Cand;\n\nstatic inline int worse(const Cand *a, const Cand *b) {\n    if (a->dist != b->dist) return a->dist > b->dist;\n    return a->idx > b->idx;\n}\n\nstatic inline void swap_c(Cand *a, Cand *b) { Cand t = *a; *a = *b; *b = t; }\n\nstatic inline void sift_up(Cand *h, int pos) {\n    while (pos > 0) {\n        int parent = (pos - 1) / 2;\n        if (worse(&h[pos], &h[parent])) { swap_c(&h[pos], &h[parent]); pos = parent; }\n        else break;\n    }\n}\n\nstatic inline void sift_down(Cand *h, int size, int root) {\n    while (1) {\n        int left = 2 * root + 1;\n        if (left >= size) break;\n        int right = left + 1;\n        int child = left;\n        if (right < size && worse(&h[right], &h[left])) child = right;\n        if (worse(&h[root], &h[child])) { swap_c(&h[root], &h[child]); root = child; }\n        else break;\n    }\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    long total = 0;\n    for (int i = 0; i < n_groups; i++) total += groups[i].length;\n\n    Point *pts = (Point *)malloc(sizeof(Point) * total);\n    char *lbls = (char *)malloc(total);\n    if (!pts || !lbls) on_error();\n\n    long pos = 0;\n    for (int g = 0; g < n_groups; g++) {\n        Group grp = groups[g];\n        for (int j = 0; j < grp.length; j++) { pts[pos] = grp.points[j]; lbls[pos] = grp.label; pos++; }\n    }\n\n    int nthreads = 1;\n#ifdef _OPENMP\n    #pragma omp parallel\n    {\n        #pragma omp single\n        nthreads = omp_get_num_threads();\n    }\n#endif\n\n    Cand **heaps = (Cand **)malloc(sizeof(Cand *) * nthreads);\n    int *counts = (int *)calloc(nthreads, sizeof(int));\n    if (!heaps || !counts) on_error();\n    for (int t = 0; t < nthreads; t++) {\n        heaps[t] = (Cand *)malloc(sizeof(Cand) * k);\n        if (!heaps[t]) on_error();\n    }\n\n    float qx = to_evaluate.x;\n    float qy = to_evaluate.y;\n\n#ifdef _OPENMP\n    #pragma omp parallel\n    {\n        int tid = omp_get_thread_num();\n        Cand *heap = heaps[tid];\n        int cnt = 0;\n        long chunk = (total + nthreads - 1) / nthreads;\n        long start = (long)tid * chunk;\n        long end = start + chunk; if (end > total) end = total;\n\n        for (long i = start; i < end; ) {\n            int remaining = (int)(end - i);\n            if (remaining >= 4) {\n                float32x4x2_t ptsv = vld2q_f32((const float32_t *)&pts[i]);\n                float32x4_t xs = ptsv.val[0];\n                float32x4_t ys = ptsv.val[1];\n                float32x4_t dx = xs - vdupq_n_f32(qx);\n                float32x4_t dy = ys - vdupq_n_f32(qy);\n                float32x4_t d2 = dx * dx + dy * dy;\n                float dists[4];\n                vst1q_f32(dists, d2);\n                for (int t = 0; t < 4; t++) {\n                    Cand c;\n                    c.dist = dists[t];\n                    c.label = lbls[i + t];\n                    c.idx = i + t;\n                    if (cnt < k) { heap[cnt] = c; sift_up(heap, cnt); cnt++; }\n                    else if (!worse(&c, &heap[0])) { heap[0] = c; sift_down(heap, k, 0); }\n                }\n                i += 4;\n            } else {\n                for (; i < end; i++) {\n                    float dx = pts[i].x - qx;\n                    float dy = pts[i].y - qy;\n                    float d = dx * dx + dy * dy;\n                    Cand c;\n                    c.dist = d;\n                    c.label = lbls[i];\n                    c.idx = i;\n                    if (cnt < k) { heap[cnt] = c; sift_up(heap, cnt); cnt++; }\n                    else if (!worse(&c, &heap[0])) { heap[0] = c; sift_down(heap, k, 0); }\n                }\n            }\n        }\n        counts[tid] = cnt;\n    }\n#else\n    Cand *heap = heaps[0];\n    int cnt = 0;\n    for (long i = 0; i < total; ) {\n        if (total - i >= 4) {\n            float32x4x2_t ptsv = vld2q_f32((const float32_t *)&pts[i]);\n            float32x4_t xs = ptsv.val[0];\n            float32x4_t ys = ptsv.val[1];\n            float32x4_t dx = xs - vdupq_n_f32(qx);\n            float32x4_t dy = ys - vdupq_n_f32(qy);\n            float32x4_t d2 = dx * dx + dy * dy;\n            float dists[4];\n            vst1q_f32(dists, d2);\n            for (int t = 0; t < 4; t++) {\n                Cand c;\n                c.dist = dists[t];\n                c.label = lbls[i + t];\n                c.idx = i + t;\n                if (cnt < k) { heap[cnt] = c; sift_up(heap, cnt); cnt++; }\n                else if (!worse(&c, &heap[0])) { heap[0] = c; sift_down(heap, k, 0); }\n            }\n            i += 4;\n        } else {\n            for (; i < total; i++) {\n                float dx = pts[i].x - qx;\n                float dy = pts[i].y - qy;\n                float d = dx * dx + dy * dy;\n                Cand c;\n                c.dist = d;\n                c.label = lbls[i];\n                c.idx = i;\n                if (cnt < k) { heap[cnt] = c; sift_up(heap, cnt); cnt++; }\n                else if (!worse(&c, &heap[0])) { heap[0] = c; sift_down(heap, k, 0); }\n            }\n        }\n    }\n    counts[0] = cnt;\n#endif\n\n    long total_cands = 0;\n    for (int t = 0; t < nthreads; t++) total_cands += counts[t];\n    Cand *all = (Cand *)malloc(sizeof(Cand) * total_cands);\n    if (!all) on_error();\n    long out_pos = 0;\n    for (int t = 0; t < nthreads; t++) {\n        for (int i = 0; i < counts[t]; i++) all[out_pos++] = heaps[t][i];\n    }\n\n    Cand *global = (Cand *)malloc(sizeof(Cand) * k);\n    if (!global) on_error();\n    int gcnt = 0;\n    for (long i = 0; i < total_cands; i++) {\n        Cand c = all[i];\n        if (gcnt < k) { global[gcnt] = c; sift_up(global, gcnt); gcnt++; }\n        else if (!worse(&c, &global[0])) { global[0] = c; sift_down(global, k, 0); }\n    }\n\n    char *sel_labels = (char *)malloc(sizeof(char) * k);\n    if (!sel_labels) on_error();\n    int scnt = 0;\n    for (int i = 0; i < gcnt && scnt < k; i++) sel_labels[scnt++] = global[i].label;\n    while (scnt < k) sel_labels[scnt++] = -1;\n\n    qsort(sel_labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = sel_labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n    for (int i = 1; i < k; i++) {\n        if (sel_labels[i] != sel_labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = sel_labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = sel_labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(pts);\n    free(lbls);\n    for (int t = 0; t < nthreads; t++) free(heaps[t]);\n    free(heaps);\n    free(counts);\n    free(all);\n    free(global);\n    free(sel_labels);\n\n    return most_frequent;\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Integrating the flattened contiguous dataset layout (C), OpenMP per-thread binary max-heaps with NEON SIMD distance computation (B/A), and exact tie-breaking via (distance, global index) should reduce complexity from O(N*k) to O((N/cores) log k + N/cores) while preserving original semantics including edge cases where fewer than k points exist.",
  "notes": "The implementation flattens all points into contiguous arrays for cache locality and OpenMP static partitioning. Each thread maintains a private max-heap of size k keyed by (distance, arrival index), using NEON to compute four squared distances at once. Per-thread heaps are merged and the global top-k is selected with another max-heap. Labels are then sorted exactly as in the baseline before frequency counting, preserving all tie-breaking behavior including filler entries when total points < k.",

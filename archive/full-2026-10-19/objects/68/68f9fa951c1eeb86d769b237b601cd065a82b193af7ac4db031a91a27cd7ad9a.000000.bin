#include <cstddef>
#include <iostream>
#include <utility>
#include <vector>

using namespace std;

class adjacency_matrix {
public:
    explicit adjacency_matrix(size_t vertices = 0)
        : vertices_(vertices), cells_(vertices * vertices, 0) {}

    size_t size() const {
        return vertices_;
    }

    unsigned char &operator()(size_t row, size_t column) {
        return cells_[row * vertices_ + column];
    }

    unsigned char operator()(size_t row, size_t column) const {
        return cells_[row * vertices_ + column];
    }

    const unsigned char *rowData(size_t row) const {
        return cells_.data() + row * vertices_;
    }

private:
    size_t vertices_;
    vector<unsigned char> cells_;
};

adjacency_matrix readGraph();
vector<int> computeDegrees(const adjacency_matrix &graph);
bool sameDegreeMultiset(const vector<int> &degree1, const vector<int> &degree2);
bool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2);
bool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,
                       const vector<int> &equivalence);
int pairMismatch(const adjacency_matrix &g1, const adjacency_matrix &g2,
                 const vector<int> &equivalence, size_t i, size_t j);
int countMismatches(const adjacency_matrix &g1, const adjacency_matrix &g2,
                    const vector<int> &equivalence);
int countAffectedMismatches(const adjacency_matrix &g1, const adjacency_matrix &g2,
                            const vector<int> &equivalence, int a, int b);
inline void printPermutation(const vector<int> &equivalence);

int main() {
    adjacency_matrix g1 = readGraph();
    adjacency_matrix g2 = readGraph();

    if (!testIsomorphism(g1, g2))
        cout << "The graphs are not isomorphic" << endl;

    return 0;
}

bool testIsomorphism(const adjacency_matrix &g1, const adjacency_matrix &g2) {
    if (g1.size() != g2.size()) return false;

    vector<int> equivalence(g1.size(), 0);
    for (size_t i = 0; i < equivalence.size(); ++i)
        equivalence[i] = static_cast<int>(i);

    if (verifyPermutation(g1, g2, equivalence)) {
        printPermutation(equivalence);
        return true;
    }

    const vector<int> degree1 = computeDegrees(g1);
    const vector<int> degree2 = computeDegrees(g2);
    if (!sameDegreeMultiset(degree1, degree2)) return false;

    int mismatch_count = countMismatches(g1, g2, equivalence);
    vector<int> exchange_counter(g1.size(), 0);
    int exchange_index = 1;
    bool isomorphism_found = false;

    /*
     * Permutations are based on Heap's algorithm, which generates all possible
     * permutations for a given set of elements.
     */
    while (exchange_index < static_cast<int>(g1.size())) {
        if (exchange_counter[exchange_index] < exchange_index) {
            int a;
            const int b = exchange_index;
            if (exchange_index % 2 == 0)
                a = 0;
            else
                a = exchange_counter[exchange_index];

            const int affected_before =
                countAffectedMismatches(g1, g2, equivalence, a, b);
            swap(equivalence[a], equivalence[b]);
            const int affected_after =
                countAffectedMismatches(g1, g2, equivalence, a, b);
            mismatch_count += affected_after - affected_before;

            if (mismatch_count == 0) {
                printPermutation(equivalence);
                isomorphism_found = true;
            }

            exchange_counter[exchange_index]++;
            exchange_index = 1;
        } else {
            exchange_counter[exchange_index] = 0;
            exchange_index++;
        }
    }
    return isomorphism_found;
}

adjacency_matrix readGraph() {
    int vertices, edges, source, destination;

    cin >> vertices;
    adjacency_matrix graph(static_cast<size_t>(vertices));

    cin >> edges;
    for (int i = 0; i < edges; ++i) {
        cin >> source >> destination;
        graph(static_cast<size_t>(destination), static_cast<size_t>(source)) = 1;
        graph(static_cast<size_t>(source), static_cast<size_t>(destination)) = 1;
    }

    return graph;
}

vector<int> computeDegrees(const adjacency_matrix &graph) {
    vector<int> degrees(graph.size(), 0);
    for (size_t i = 0; i < graph.size(); ++i) {
        const unsigned char *row = graph.rowData(i);
        size_t j = 0;
        int degree0 = 0;
        int degree1 = 0;
        int degree2 = 0;
        int degree3 = 0;
        for (; j + 3 < graph.size(); j += 4) {
            degree0 += row[j];
            degree1 += row[j + 1];
            degree2 += row[j + 2];
            degree3 += row[j + 3];
        }
        int degree = degree0 + degree1 + degree2 + degree3;
        for (; j < graph.size(); ++j)
            degree += row[j];
        degrees[i] = degree;
    }
    return degrees;
}

bool sameDegreeMultiset(const vector<int> &degree1, const vector<int> &degree2) {
    vector<int> balance(degree1.size() + 1, 0);
    for (size_t i = 0; i < degree1.size(); ++i) {
        ++balance[degree1[i]];
        --balance[degree2[i]];
    }
    for (size_t degree = 0; degree < balance.size(); ++degree)
        if (balance[degree] != 0) return false;
    return true;
}

bool verifyPermutation(const adjacency_matrix &g1, const adjacency_matrix &g2,
                       const vector<int> &equivalence) {
    for (size_t i = 0; i < equivalence.size(); ++i) {
        for (size_t j = 0; j <= i; ++j) {
            if (g1(i, j) != g2(static_cast<size_t>(equivalence[i]),
                               static_cast<size_t>(equivalence[j])))
                return false;
        }
    }
    return true;
}

int pairMismatch(const adjacency_matrix &g1, const adjacency_matrix &g2,
                 const vector<int> &equivalence, size_t i, size_t j) {
    if (i < j) swap(i, j);
    return g1(i, j) != g2(static_cast<size_t>(equivalence[i]),
                          static_cast<size_t>(equivalence[j]));
}

int countMismatches(const adjacency_matrix &g1, const adjacency_matrix &g2,
                    const vector<int> &equivalence) {
    int count = 0;
    for (size_t i = 0; i < equivalence.size(); ++i) {
        for (size_t j = 0; j <= i; ++j)
            count += pairMismatch(g1, g2, equivalence, i, j);
    }
    return count;
}

int countAffectedMismatches(const adjacency_matrix &g1, const adjacency_matrix &g2,
                            const vector<int> &equivalence, int a, int b) {
    const size_t first = static_cast<size_t>(a);
    const size_t second = static_cast<size_t>(b);
    int count = pairMismatch(g1, g2, equivalence, first, first)
              + pairMismatch(g1, g2, equivalence, second, second)
              + pairMismatch(g1, g2, equivalence, first, second);
    for (size_t k = 0; k < equivalence.size(); ++k) {
        if (k != first && k != second) {
            count += pairMismatch(g1, g2, equivalence, first, k);
            count += pairMismatch(g1, g2, equivalence, second, k);
        }
    }
    return count;
}

inline void printPermutation(const vector<int> &equivalence) {
    for (int vertex : equivalence)
        cout << vertex << " ";
    cout << endl;
}

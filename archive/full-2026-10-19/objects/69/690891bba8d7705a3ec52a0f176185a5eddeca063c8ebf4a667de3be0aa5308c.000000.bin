      "content": "#include \"knn.h\"\n#include <float.h>\n\n/* Max-heap for top-k nearest neighbors */\nstatic void heap_sift_down(float *distances, char *labels, int k, int idx) {\n    int largest = idx;\n    while (1) {\n        int left  = 2 * idx + 1;\n        int right = 2 * idx + 2;\n        if (left < k && distances[left] > distances[largest]) largest = left;\n        if (right < k && distances[right] > distances[largest]) largest = right;\n        if (largest == idx) break;\n        float tmp_d = distances[idx];\n        char  tmp_l = labels[idx];\n        distances[idx] = distances[largest];\n        labels[idx]    = labels[largest];\n        distances[largest] = tmp_d;\n        labels[largest]    = tmp_l;\n        idx = largest;\n    }\n}\n\nstatic void heap_sift_up(float *distances, char *labels, int idx) {\n    while (idx > 0) {\n        int parent = (idx - 1) / 2;\n        if (distances[idx] <= distances[parent]) break;\n        float tmp_d = distances[idx];\n        char  tmp_l = labels[idx];\n        distances[idx] = distances[parent];\n        labels[idx]    = labels[parent];\n        distances[parent] = tmp_d;\n        labels[parent]    = tmp_l;\n        idx = parent;\n    }\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    /* Max-heap for top-k distances and labels */\n    float *heap_dist = (float *)malloc(sizeof(float) * k);\n    char  *heap_lab  = (char  *)malloc(sizeof(char)  * k);\n    int heap_size = 0;\n\n    /* Initialize with sentinel values */\n    for (int i = 0; i < k; i++) {\n        heap_dist[i] = FLT_MAX;\n        heap_lab[i]  = -1;\n    }\n\n    /* Process each group sequentially, computing distances on the fly.\n       This avoids extra memory allocation and copying of flattened arrays,\n       reducing total memory traffic while preserving cache-friendly access. */\n    for (int g = 0; g < n_groups; g++) {\n        Group *grp = &groups[g];\n        char label = grp->label;\n        int len = grp->length;\n        Point *pts = grp->points;\n\n        for (int p = 0; p < len; p++) {\n            float dx = to_evaluate.x - pts[p].x;\n            float dy = to_evaluate.y - pts[p].y;\n            float d = dx*dx + dy*dy;\n\n            if (heap_size < k) {\n                /* Insert at end and sift up */\n                heap_dist[heap_size] = d;\n                heap_lab[heap_size]  = label;\n                heap_sift_up(heap_dist, heap_lab, heap_size);\n                heap_size++;\n            } else if (d < heap_dist[0]) {\n                /* Replace root and sift down */\n                heap_dist[0] = d;\n                heap_lab[0]  = label;\n                heap_sift_down(heap_dist, heap_lab, k, 0);\n            }\n        }\n    }\n\n    /* Count frequencies of labels in the heap */\n    int freq[256] = {0};\n    for (int i = 0; i < k; i++) {\n        if (heap_lab[i] != -1) {\n            freq[(unsigned char)heap_lab[i]]++;\n        }\n    }\n\n    free(heap_dist);\n    free(heap_lab);\n\n    /* Find most frequent label */\n    int best_count = 0;\n    char best_label = -1;\n    for (int c = 32; c < 127; c++) {   /* printable ASCII range */\n        if (freq[c] > best_count) {\n            best_count = freq[c];\n            best_label = (char)c;\n        }\n    }\n\n    return best_label;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n\n    Group *groups = (Group *)malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
      "path": "src/knn.c"
    }
  ],
  "hypothesis": "Eliminating the intermediate flattened arrays and computing distances directly over groups reduces memory traffic (no copy) while preserving cache-friendly sequential access within each group. This improves performance by lowering total bytes moved through the memory hierarchy.",
  "notes": "",

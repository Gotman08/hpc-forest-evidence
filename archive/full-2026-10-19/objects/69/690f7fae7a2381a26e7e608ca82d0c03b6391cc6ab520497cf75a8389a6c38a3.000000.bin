{
  "src/solution.cpp": "#include <algorithm>\n#include <iostream>\n#include <utility>\n#include <vector>\n\nusing namespace std;\n\nconst int MOD = 1000000007;\n\nstruct Point {\n    int x;\n    int y;\n};\n\nlong long mod_pow(long long base, long long exponent) {\n    long long result = 1;\n    while (exponent > 0) {\n        if (exponent & 1) result = result * base % MOD;\n        base = base * base % MOD;\n        exponent >>= 1;\n    }\n    return result;\n}\n\nint main() {\n    int n, m;\n    cin >> n >> m;\n\n    vector<Point> points;\n    points.reserve(m);\n    for (int i = 0; i < m; ++i) {\n        int y, x;\n        cin >> y >> x;\n        points.push_back({x, y});\n    }\n\n    sort(points.begin(), points.end(), [](const Point& a, const Point& b) {\n        if (a.x + a.y != b.x + b.y) return a.x + a.y < b.x + b.y;\n        return a.x < b.x;\n    });\n    points.erase(unique(points.begin(), points.end(), [](const Point& a, const Point& b) {\n        return a.x == b.x && a.y == b.y;\n    }), points.end());\n\n    for (const Point& point : points) {\n        if (point.x == 0 && point.y == 0) {\n            cout << 0 << '\\n';\n            return 0;\n        }\n    }\n\n    // A rolling-row DP avoids allocating an N-by-N blocked-cell matrix\n    // when the obstacle count makes the sparse pairwise method unattractive.\n    if (points.size() >= static_cast<size_t>(n)) {\n        vector<vector<int> > blocked_columns(n);\n        for (const Point& point : points) blocked_columns[point.y].push_back(point.x);\n        for (int row = 0; row < n; ++row) {\n            sort(blocked_columns[row].begin(), blocked_columns[row].end());\n        }\n\n        vector<int> dp(n, 0);\n        for (int row = 0; row < n; ++row) {\n            size_t blocked_index = 0;\n            for (int column = 0; column < n; ++column) {\n                const vector<int>& blocked = blocked_columns[row];\n                while (blocked_index < blocked.size() && blocked[blocked_index] < column) {\n                    ++blocked_index;\n                }\n                if (blocked_index < blocked.size() && blocked[blocked_index] == column) {\n                    dp[column] = 0;\n                    ++blocked_index;\n                } else if (row == 0 && column == 0) {\n                    dp[column] = 1;\n                } else {\n                    long long ways = dp[column];\n                    if (column > 0) ways += dp[column - 1];\n                    dp[column] = static_cast<int>(ways % MOD);\n                }\n            }\n        }\n        cout << dp[n - 1] << '\\n';\n        return 0;\n    }\n\n    const int max_paths = 2 * (n - 1);\n    vector<long long> factorial(max_paths + 1, 1);\n    vector<long long> inverse_factorial(max_paths + 1, 1);\n    for (int i = 1; i <= max_paths; ++i) {\n        factorial[i] = factorial[i - 1] * i % MOD;\n    }\n    if (max_paths > 0) {\n        inverse_factorial[max_paths] = mod_pow(factorial[max_paths], MOD - 2);\n        for (int i = max_paths; i > 0; --i) {\n            inverse_factorial[i - 1] = inverse_factorial[i] * i % MOD;\n        }\n    }\n\n    auto choose = [&](int total, int selected) -> long long {\n        if (selected < 0 || selected > total) return 0;\n        return factorial[total] * inverse_factorial[selected] % MOD *\n               inverse_factorial[total - selected] % MOD;\n    };\n\n    vector<long long> ways(points.size(), 0);\n    auto compute_one = [&](int index, int limit) {\n        const Point& point = points[index];\n        long long count = choose(point.x + point.y, point.x);\n        for (int previous = 0; previous < limit; ++previous) {\n            const Point& obstacle = points[previous];\n            if (obstacle.x <= point.x && obstacle.y <= point.y) {\n                int dx = point.x - obstacle.x;\n                int dy = point.y - obstacle.y;\n                long long paths_between = choose(dx + dy, dx);\n                long long removed = ways[previous] * paths_between % MOD;\n                count = (count - removed + MOD) % MOD;\n            }\n        }\n        ways[index] = count;\n    };\n\n    int begin = 0;\n    while (begin < static_cast<int>(points.size())) {\n        int end = begin + 1;\n        int diagonal = points[begin].x + points[begin].y;\n        while (end < static_cast<int>(points.size()) &&\n               points[end].x + points[end].y == diagonal) {\n            ++end;\n        }\n\n        // Same-diagonal obstacles are independent. Parallelize only batches\n        // with enough pairwise work to amortize OpenMP scheduling overhead.\n        if (end - begin >= 32 && 1LL * (end - begin) * begin >= 8192) {\n            #pragma omp parallel for schedule(static)\n            for (int index = begin; index < end; ++index) {\n                compute_one(index, begin);\n            }\n        } else {\n            for (int index = begin; index < end; ++index) {\n                compute_one(index, begin);\n            }\n        }\n        begin = end;\n    }\n\n    long long answer = choose(max_paths, n - 1);\n    for (size_t i = 0; i < points.size(); ++i) {\n        int remaining = max_paths - points[i].x - points[i].y;\n        int right_moves = n - 1 - points[i].x;\n        long long paths_to_end = choose(remaining, right_moves);\n        long long paths_through_obstacle = ways[i] * paths_to_end % MOD;\n        answer = (answer - paths_through_obstacle + MOD) % MOD;\n    }\n\n    cout << answer << '\\n';\n    return 0;\n}\n"
}

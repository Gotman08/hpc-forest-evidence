      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <algorithm>\n#include <cstdint>\n#include <limits>\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n#include <arm_neon.h>\n\nstatic inline int64x2_t maximum64(int64x2_t a, int64x2_t b) {\n    return vbslq_s64(vcgtq_s64(a, b), a, b);\n}\n#endif\n\n// Advance is compile-time constant: the first row only reads columns;\n// later rows update each column immediately before consuming it.\ntemplate <bool Advance>\nstatic inline std::int64_t scan_row(std::int64_t* col, int n, int s,\n                                    const int* entering, const int* exiting,\n                                    std::int64_t best) {\n    const int shifts = n - s;\n    std::int64_t sum = 0;\n    int c = 0;\n\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    const int64x2_t zero = vdupq_n_s64(0);\n    int64x2_t initial0 = zero;\n    int64x2_t initial1 = zero;\n    for (; c + 4 <= s; c += 4) {\n        int64x2_t values0 = vld1q_s64(col + c);\n        int64x2_t values1 = vld1q_s64(col + c + 2);\n        if (Advance) {\n            const int32x4_t in = vld1q_s32(entering + c);\n            const int32x4_t out = vld1q_s32(exiting + c);\n            values0 = vaddq_s64(values0, vsubl_s32(\n                vget_low_s32(in), vget_low_s32(out)));\n            values1 = vaddq_s64(values1, vsubl_s32(\n                vget_high_s32(in), vget_high_s32(out)));\n            vst1q_s64(col + c, values0);\n            vst1q_s64(col + c + 2, values1);\n        }\n        initial0 = vaddq_s64(initial0, values0);\n        initial1 = vaddq_s64(initial1, values1);\n    }\n    sum = vaddvq_s64(vaddq_s64(initial0, initial1));\n#endif\n\n    for (; c < s; ++c) {\n        if (Advance) {\n            col[c] += static_cast<std::int64_t>(entering[c])\n                    - static_cast<std::int64_t>(exiting[c]);\n        }\n        sum += col[c];\n    }\n    best = std::max(best, sum);\n\n    int j = 0;\n#if defined(__aarch64__) && defined(__ARM_NEON)\n    int64x2_t carry = vdupq_n_s64(sum);\n    int64x2_t best0 = vdupq_n_s64(best);\n    int64x2_t best1 = best0;\n\n    for (; j + 4 <= shifts; j += 4) {\n        const int right = j + s;\n        int64x2_t right0 = vld1q_s64(col + right);\n        int64x2_t right1 = vld1q_s64(col + right + 2);\n        if (Advance) {\n            const int32x4_t in = vld1q_s32(entering + right);\n            const int32x4_t out = vld1q_s32(exiting + right);\n            right0 = vaddq_s64(right0, vsubl_s32(\n                vget_low_s32(in), vget_low_s32(out)));\n            right1 = vaddq_s64(right1, vsubl_s32(\n                vget_high_s32(in), vget_high_s32(out)));\n            // Both stores precede the left-column loads. This also handles\n            // overlapping blocks when the window width is less than four.\n            vst1q_s64(col + right, right0);\n            vst1q_s64(col + right + 2, right1);\n        }\n\n        const int64x2_t delta0 = vsubq_s64(right0, vld1q_s64(col + j));\n        const int64x2_t delta1 = vsubq_s64(right1, vld1q_s64(col + j + 2));\n        const int64x2_t prefix0 = vaddq_s64(\n            delta0, vextq_s64(zero, delta0, 1));\n        const int64x2_t pair1 = vaddq_s64(\n            delta1, vextq_s64(zero, delta1, 1));\n        const int64x2_t prefix1 = vaddq_s64(\n            pair1, vdupq_n_s64(vgetq_lane_s64(prefix0, 1)));\n\n        const int64x2_t windows0 = vaddq_s64(carry, prefix0);\n        const int64x2_t windows1 = vaddq_s64(carry, prefix1);\n        best0 = maximum64(best0, windows0);\n        best1 = maximum64(best1, windows1);\n        carry = vdupq_n_s64(vgetq_lane_s64(windows1, 1));\n    }\n\n    if (j + 2 <= shifts) {\n        const int right = j + s;\n        int64x2_t values = vld1q_s64(col + right);\n        if (Advance) {\n            values = vaddq_s64(values, vsubl_s32(\n                vld1_s32(entering + right), vld1_s32(exiting + right)));\n            vst1q_s64(col + right, values);\n        }\n        const int64x2_t delta = vsubq_s64(values, vld1q_s64(col + j));\n        const int64x2_t prefix = vaddq_s64(\n            delta, vextq_s64(zero, delta, 1));\n        const int64x2_t windows = vaddq_s64(carry, prefix);\n        best0 = maximum64(best0, windows);\n        carry = vdupq_n_s64(vgetq_lane_s64(windows, 1));\n        j += 2;\n    }\n    sum = vgetq_lane_s64(carry, 0);\n    best0 = maximum64(best0, best1);\n    best = std::max(best, vgetq_lane_s64(best0, 0));\n    best = std::max(best, vgetq_lane_s64(best0, 1));\n#endif\n\n    for (; j < shifts; ++j) {\n        const int right = j + s;\n        if (Advance) {\n            col[right] += static_cast<std::int64_t>(entering[right])\n                        - static_cast<std::int64_t>(exiting[right]);\n        }\n        sum += col[right] - col[j];\n        best = std::max(best, sum);\n    }\n    return best;\n}\n\nint main() {\n    int n, s;\n    std::cin >> n >> s;\n    std::vector<std::vector<int> > matrix(n, std::vector<int>(n));\n    for (int i = 0; i < n; ++i)\n        for (int j = 0; j < n; ++j)\n            scanf(\"%d\", &(matrix[i][j]));\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    std::vector<std::int64_t> columns(n, 0);\n    std::int64_t* const col = columns.data();\n    for (int i = 0; i < s; ++i) {\n        const int* const row = matrix[i].data();\n        for (int j = 0; j < n; ++j)\n            col[j] += static_cast<std::int64_t>(row[j]);\n    }\n\n    std::int64_t best = scan_row<false>(\n        col, n, s, nullptr, nullptr,\n        std::numeric_limits<std::int64_t>::min());\n    const int shifts = n - s;\n    for (int top = 1; top <= shifts; ++top) {\n        best = scan_row<true>(col, n, s,\n            matrix[top + s - 1].data(), matrix[top - 1].data(), best);\n    }\n\n    printf(\"%lld\\n\", static_cast<long long>(best));\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

      const controls = Object.fromEntries([&#x27;tree&#x27;,&#x27;speed&#x27;,&#x27;play&#x27;,&#x27;previous&#x27;,&#x27;next&#x27;,&#x27;descent&#x27;,&#x27;timeline&#x27;,&#x27;node&#x27;].map(key=&gt;[key,$(`[data-control=&quot;${key}&quot;]`)]));
      const fields = Object.fromEntries([&#x27;step&#x27;,&#x27;event&#x27;,&#x27;detail&#x27;,&#x27;counts&#x27;,&#x27;drawing&#x27;,&#x27;selection&#x27;,&#x27;failed-key&#x27;,&#x27;winner-key&#x27;].map(key=&gt;[key,$(`[data-value=&quot;${key}&quot;]`)]));
      const svg = $(&#x27;.long-svg&#x27;);
      const reduced = matchMedia(&#x27;(prefers-reduced-motion: reduce)&#x27;);
      const number = n =&gt; new Intl.NumberFormat(&#x27;fr-FR&#x27;,{minimumFractionDigits:3,maximumFractionDigits:3}).format(n);
      const ms = seconds =&gt; `${number(seconds*1000)} ms`;
      const purposes = {A:&#x27;Mémoire&#x27;,B:&#x27;SIMD&#x27;,C:&#x27;OpenMP&#x27;,G:&#x27;Intégration&#x27;};
      const allNodes = new Map(data.trees.flatMap(t=&gt;t.nodes).map(n=&gt;[n.id,n]));
      const labels = new Map([...allNodes].map(([id,n])=&gt;[id,n.label]));
      const defaultTree = [...data.trees].sort((a,b)=&gt;b.maxDepth-a.maxDepth || b.maxChildren-a.maxChildren)[0];
      let tree = defaultTree;
      let index = tree.trials.length+1;
      const deepest = t =&gt; t.nodes.reduce((a,b)=&gt;b.depth&gt;a.depth || b.depth===a.depth &amp;&amp; b.correct===true &amp;&amp; a.correct!==true ? b : a).id;
      let selected = deepest(tree);
      let speed = 1;
      let playing = false;
      let timer;
      let raf;
      let lastWidth = 0;
      let lastSaved = &#x27;&#x27;;
      const ns = &#x27;http://www.w3.org/2000/svg&#x27;;

      function el(tag,attrs={},text) {
        const node=document.createElementNS(ns,tag);
        for(const [key,value] of Object.entries(attrs)) node.setAttribute(key,value);
        if(text!==undefined) node.textContent=text;
        return node;
      }

      function snapshot() {
        const trials=tree.trials.slice(0,Math.min(index,tree.trials.length));
        const ids=new Set([tree.nodes[0].id,...trials.filter(t=&gt;t.score!==null).map(t=&gt;t.id)]);
        const nodes=tree.nodes.filter(n=&gt;ids.has(n.id));
        const childCounts=new Map(nodes.map(n=&gt;[n.id,0]));
        for(const n of nodes) if(n.parent) childCounts.set(n.parent,childCounts.get(n.parent)+1);
        return {nodes,ids,childCounts,depth:Math.max(...nodes.map(n=&gt;n.depth)),fanout:Math.max(...childCounts.values()),trial:index&gt;0&amp;&amp;index&lt;=tree.trials.length?tree.trials[index-1]:null};
      }

      function layout(width) {
        const children=new Map(tree.nodes.map(n=&gt;[n.id,[]]));
        tree.nodes.forEach(n=&gt;{if(n.parent) children.get(n.parent).push(n);});
        const positions=new Map();
        let leaf=0;
        function visit(node) {
          const descendants=children.get(node.id);
          const childY=descendants.map(visit);
          const y=childY.length?childY.reduce((a,b)=&gt;a+b,0)/childY.length:62+leaf++*66;
          const x=tree.maxDepth?28+(width-56)*node.depth/tree.maxDepth:width/2;
          positions.set(node.id,{x,y});
          return y;
        }
        visit(tree.nodes[0]);
        const height=Math.max(220,62+Math.max(0,leaf-1)*66+42);
        if(leaf&lt;3) {
          const shift=(height-(62+Math.max(0,leaf-1)*66+42))/2;
          positions.forEach(p=&gt;p.y+=shift);
        }
        return {positions,height};
      }

      function description(node,state) {
        const parent=labels.get(node.parent)||&#x27;—&#x27;;
        const count=state.childCounts.get(node.id);
        if(node.depth===0) return `Racine ${tree.role} · ${count} fils conservé${count===1?&#x27;&#x27;:&#x27;s&#x27;}`;
        const trial=tree.trials.find(t=&gt;t.id===node.id);
        const sources=trial?.sources?.length ? ` · sources : ${trial.sources.map(id=&gt;labels.get(id)||id.slice(0,6)).join(&#x27;, &#x27;)}` : &#x27;&#x27;;
        return `${node.label} · parent ${parent} · niveau ${node.depth} · ${count} fils · q ${number(node.score)}${node.correct?` · ${ms(node.seconds)}`:&#x27; · compilation échouée&#x27;}${sources}`;
      }

      function draw(animate=false) {
        cancelAnimationFrame(raf);
        svg.getAnimations({subtree:true}).forEach(a=&gt;a.cancel());
        svg.querySelector(&#x27;[data-scene]&#x27;)?.remove();
        const width=Math.round(fields.drawing.getBoundingClientRect().width);
        if(width&lt;1) return;
        lastWidth=width;
        const state=snapshot();
        if(!state.ids.has(selected)) selected=state.trial?.parent||tree.nodes[0].id;
        if(!state.ids.has(selected)) selected=tree.nodes[0].id;
        const selectedNode=allNodes.get(selected);
        const {positions,height}=layout(width);
        svg.setAttribute(&#x27;viewBox&#x27;,`0 0 ${width} ${height}`);
        svg.setAttribute(&#x27;height&#x27;,height);
        const scene=el(&#x27;g&#x27;,{&#x27;data-scene&#x27;:&#x27;&#x27;});svg.append(scene);
        const chain=new Set();
        let cursor=selectedNode;
        while(cursor){chain.add(cursor.id);cursor=allNodes.get(cursor.parent);}
        for(let depth=0;depth&lt;=tree.maxDepth;depth++) {
          const x=28+(width-56)*depth/Math.max(1,tree.maxDepth);
          scene.append(el(&#x27;text&#x27;,{x,y:16,&#x27;text-anchor&#x27;:&#x27;middle&#x27;,class:&#x27;text-small secondary&#x27;},`Niv. ${depth}`));
        }
        const edges=new Map();
        for(const node of state.nodes) {
          if(!node.parent) continue;
          const parent=positions.get(node.parent),p=positions.get(node.id);
          const start=parent.x+18,end=p.x-18,middle=(start+end)/2;
          const path=el(&#x27;path&#x27;,{d:`M${start} ${parent.y} C${middle} ${parent.y} ${middle} ${p.y} ${end} ${p.y}`,class:`parent-edge${chain.has(node.id)&amp;&amp;chain.has(node.parent)?&#x27; path-edge&#x27;:&#x27;&#x27;}`,&#x27;data-parent&#x27;:node.label,&#x27;data-parent-id&#x27;:node.parent});
          scene.append(path);edges.set(node.id,path);
          if(animate &amp;&amp; !reduced.matches &amp;&amp; state.trial?.id===node.id) {
            const length=path.getTotalLength();
            path.animate([{strokeDasharray:`${length} ${length}`,strokeDashoffset:length},{strokeDasharray:`${length} ${length}`,strokeDashoffset:0}],{duration:450/speed,easing:&#x27;ease-out&#x27;});
          }
        }
        for(const node of state.nodes) {
          const p=positions.get(node.id);
          const winner=index&gt;tree.trials.length&amp;&amp;node.id===data.winner;
          const cls=node.depth===0?&#x27;node-root&#x27;:node.correct===false?&#x27;node-failed&#x27;:winner?&#x27;node-winner&#x27;:&#x27;node-valid&#x27;;
          const group=el(&#x27;g&#x27;,{&#x27;data-node&#x27;:node.label,&#x27;data-node-id&#x27;:node.id,&#x27;data-depth&#x27;:node.depth,class:&#x27;cursor-interaction&#x27;});
          const mark=node.correct===false?el(&#x27;path&#x27;,{d:`M${p.x} ${p.y-20}L${p.x+20} ${p.y}L${p.x} ${p.y+20}L${p.x-20} ${p.y}Z`,class:`${cls}${node.id===selected?&#x27; selected&#x27;:&#x27;&#x27;}`}):el(&#x27;circle&#x27;,{cx:p.x,cy:p.y,r:node.depth===0?18:16,class:`${cls}${node.id===selected?&#x27; selected&#x27;:&#x27;&#x27;}`});
          group.append(mark);
          group.append(el(&#x27;text&#x27;,{x:p.x,y:p.y+4,&#x27;text-anchor&#x27;:&#x27;middle&#x27;,class:&#x27;text-small node-name&#x27;},node.label));
          group.setAttribute(&#x27;data-tooltip&#x27;,description(node,state));
          group.addEventListener(&#x27;click&#x27;,()=&gt;{stop();selected=node.id;draw();save();});
          scene.append(group);
          if(animate &amp;&amp; !reduced.matches &amp;&amp; state.trial?.id===node.id) {
            const parent=positions.get(node.parent);
            group.animate([{transform:`translate(${parent.x-p.x} ${parent.y-p.y})`,opacity:.4},{transform:&#x27;translate(0 0)&#x27;,opacity:1}],{duration:450/speed,easing:&#x27;ease-out&#x27;});
          }
        }
        if(animate &amp;&amp; !reduced.matches &amp;&amp; state.trial?.score!==null &amp;&amp; state.trial?.score!==undefined) {
          const paths=[];
          let node=allNodes.get(state.trial.id);
          while(node?.parent) {const path=edges.get(node.id);paths.push({path,length:path.getTotalLength()});node=allNodes.get(node.parent);}
          const total=paths.reduce((sum,p)=&gt;sum+p.length,0);
          const dot=el(&#x27;circle&#x27;,{r:4,class:&#x27;score-dot&#x27;,opacity:0});scene.append(dot);
          let start;
          const tick=now=&gt;{
            if(start===undefined) start=now;
            const elapsed=now-start-450/speed;
            const progress=Math.max(0,Math.min(1,elapsed/(1000/speed)));
            let distance=progress*total;
            for(let i=0;i&lt;paths.length;i++) {
              const segment=paths[i];
              if(distance&lt;=segment.length||i===paths.length-1) {
                const point=segment.path.getPointAtLength(Math.max(0,segment.length-distance));
                dot.setAttribute(&#x27;cx&#x27;,point.x);dot.setAttribute(&#x27;cy&#x27;,point.y);break;
              }
              distance-=segment.length;
            }
            dot.setAttribute(&#x27;opacity&#x27;,elapsed&lt;0||progress&gt;=1?0:1);
            if(progress&lt;1) raf=requestAnimationFrame(tick);
          };
          raf=requestAnimationFrame(tick);
        }
        let title,detail;
        if(index===0) {title=`Racine ${tree.role} avant les essais`;detail=&#x27;Aucun candidat conservé&#x27;;}
        else if(index&gt;tree.trials.length) {title=`État final de l’arbre ${tree.role}`;detail=`${tree.trials.length} essais · ${tree.candidates} nœuds candidats conservés`;}
        else {
          const trial=state.trial;
          const parent=labels.get(trial.parent)||`racine ${tree.role}`;
          if(trial.score!==null) {
            title=trial.correct?`${trial.label} ajouté sous ${parent}`:`${trial.label} conservé avec un score nul`;
            detail=trial.correct?`Niveau ${trial.depth} · q ${number(trial.score)} · ${ms(trial.seconds)}`:`Parent ${parent} · échec de compilation · q 0,000`;
          } else {title=`${trial.label} : ${trial.status===&#x27;duplicate&#x27;?&#x27;doublon écarté&#x27;:&#x27;proposition sans score&#x27;}`;detail=`Parent sélectionné : ${parent} · aucun nœud ajouté`;}
        }
        fields.event.textContent=title;fields.detail.textContent=detail;
        fields.counts.textContent=`${state.nodes.length} nœuds · profondeur ${state.depth} · jusqu’à ${state.fanout} fils par parent`;
        fields.step.textContent=`${index} / ${tree.trials.length+1}`;
        controls.timeline.max=tree.trials.length+1;controls.timeline.value=index;
        controls.timeline.setAttribute(&#x27;aria-valuetext&#x27;,`${title}. ${state.nodes.length} nœuds, profondeur ${state.depth}`);
        controls.previous.disabled=index===0;controls.next.disabled=index===tree.trials.length+1;
        controls.play.textContent=playing?&#x27;Pause&#x27;:index===tree.trials.length+1?&#x27;Rejouer&#x27;:&#x27;Lire&#x27;;
        controls.play.setAttribute(&#x27;aria-pressed&#x27;,String(playing));
        const deepestValid=Math.max(0,...tree.trials.filter(t=&gt;t.correct===true).map(t=&gt;t.depth));
        controls.descent.disabled=deepestValid&lt;2;
        controls.descent.textContent=deepestValid&gt;=2?`Voir le niveau ${deepestValid}`:&#x27;Voir une descente&#x27;;
        controls.node.replaceChildren(...state.nodes.map(n=&gt;{const option=document.createElement(&#x27;option&#x27;);option.value=n.id;option.textContent=n.depth?`${n.label} · niveau ${n.depth}`:`Racine ${n.label}`;return option;}));
        controls.node.value=selected;fields.selection.textContent=description(selectedNode,state);
        fields[&#x27;failed-key&#x27;].hidden=!state.nodes.some(n=&gt;n.correct===false);
        fields[&#x27;winner-key&#x27;].hidden=!(index&gt;tree.trials.length&amp;&amp;state.ids.has(data.winner));
        $(&#x27;#romeo-long-desc&#x27;).textContent=`${title}. ${state.nodes.length} nœuds conservés, profondeur maximale ${state.depth}, au plus ${state.fanout} fils par parent. Chemin sélectionné : ${[...chain].reverse().map(id=&gt;labels.get(id)).join(&#x27; puis &#x27;)}.`;
        root.dataset.role=tree.role;root.dataset.nodes=state.nodes.length;root.dataset.depth=state.depth;root.dataset.fanout=state.fanout;
      }

      function save() {
        if(!window.openai?.setWidgetState) return;
        const privateContent={version:1,view:&#x27;long-746880&#x27;,role:tree.role,step:index,selected,speed};
        lastSaved=JSON.stringify(privateContent);
        window.openai.setWidgetState({modelContent:{project:&#x27;HPC-Forest&#x27;,job:data.job,view:&#x27;long-tree&#x27;,role:tree.role,step:index,selected:labels.get(selected),event:fields.event.textContent},privateContent}).catch(()=&gt;{});
      }
      function stop(){playing=false;clearTimeout(timer);}
      function focusTrial(){const t=tree.trials[index-1];selected=index&gt;tree.trials.length?deepest(tree):t?.score!==null&amp;&amp;t?.score!==undefined?t.id:t?.parent||tree.nodes[0].id;}
      function schedule(){
        clearTimeout(timer);if(!playing) return;
        timer=setTimeout(()=&gt;{
          if(!root.isConnected){stop();return;}
          index=Math.min(tree.trials.length+1,index+1);focusTrial();
          if(index===tree.trials.length+1) stop();
          draw(true);if(playing) schedule();else save();
        },2000/speed);
      }
      function chooseTree(role){
        tree=data.trees.find(t=&gt;t.role===role)||defaultTree;
        index=tree.trials.length+1;selected=deepest(tree);
        controls.tree.value=tree.role;
      }
      function restore(saved){
        const s=saved?.privateContent;
        if(s?.version!==1||s.view!==&#x27;long-746880&#x27;||!data.trees.some(t=&gt;t.role===s.role)) return false;
        stop();chooseTree(s.role);
        index=Number.isInteger(s.step)?Math.max(0,Math.min(tree.trials.length+1,s.step)):tree.trials.length+1;
        selected=tree.nodes.some(n=&gt;n.id===s.selected)?s.selected:selected;
        speed=[.5,1,2].includes(s.speed)?s.speed:1;controls.speed.value=speed;draw();return true;
      }
      data.trees.forEach(t=&gt;{const option=document.createElement(&#x27;option&#x27;);option.value=t.role;option.textContent=`${t.role} · ${purposes[t.role]} · profondeur ${t.maxDepth}`;controls.tree.append(option);});
      controls.tree.value=tree.role;
      controls.tree.addEventListener(&#x27;change&#x27;,()=&gt;{stop();chooseTree(controls.tree.value);draw();save();});
      controls.speed.addEventListener(&#x27;change&#x27;,()=&gt;{speed=Number(controls.speed.value);schedule();save();});
      controls.play.addEventListener(&#x27;click&#x27;,()=&gt;{if(playing)stop();else{if(index===tree.trials.length+1){index=0;selected=tree.nodes[0].id;}playing=true;}draw();schedule();save();});
      controls.previous.addEventListener(&#x27;click&#x27;,()=&gt;{stop();index=Math.max(0,index-1);focusTrial();draw();save();});
      controls.next.addEventListener(&#x27;click&#x27;,()=&gt;{stop();index=Math.min(tree.trials.length+1,index+1);focusTrial();draw(true);save();});
      controls.timeline.addEventListener(&#x27;input&#x27;,()=&gt;{stop();index=Number(controls.timeline.value);focusTrial();draw();});
      controls.timeline.addEventListener(&#x27;change&#x27;,save);
      controls.node.addEventListener(&#x27;change&#x27;,()=&gt;{stop();selected=controls.node.value;draw();save();});
      controls.descent.addEventListener(&#x27;click&#x27;,()=&gt;{stop();const depth=Math.max(0,...tree.trials.filter(t=&gt;t.correct===true).map(t=&gt;t.depth));index=tree.trials.findIndex(t=&gt;t.correct===true&amp;&amp;t.depth===depth)+1;focusTrial();draw(true);save();});
      window.addEventListener(&#x27;openai:set_globals&#x27;,event=&gt;{
        const incoming=event.detail?.globals?.widgetState;
        if(!incoming||JSON.stringify(incoming.privateContent)===lastSaved) return;
        const s=incoming.privateContent;
        if(s?.view===&#x27;long-746880&#x27;&amp;&amp;s.role===tree.role&amp;&amp;s.step===index&amp;&amp;s.selected===selected&amp;&amp;s.speed===speed) return;
        restore(incoming);
      });
      document.addEventListener(&#x27;visibilitychange&#x27;,()=&gt;{if(document.hidden&amp;&amp;playing){stop();draw();save();}});
      new ResizeObserver(()=&gt;{if(Math.round(fields.drawing.getBoundingClientRect().width)!==lastWidth)draw();}).observe(fields.drawing);
      if(!restore(window.openai?.widgetState)) draw();
    })();
  &lt;/script&gt;
&lt;/div&gt;

&lt;script src=&quot;https://unpkg.com/@floating-ui/core@1.7.3/dist/floating-ui.core.umd.min.js&quot;&gt;&lt;/script&gt;
&lt;script src=&quot;https://unpkg.com/@floating-ui/dom@1.7.4/dist/floating-ui.dom.umd.min.js&quot;&gt;&lt;/script&gt;
&lt;script&gt;
(() =&gt; {
  if (window.FloatingUIDOM == null) {
    return;
  }
  const { autoUpdate, computePosition, flip, offset, shift, size } =
    window.FloatingUIDOM;
  const tooltipPlacements = new Set([&quot;top&quot;, &quot;right&quot;, &quot;bottom&quot;, &quot;left&quot;]);
  const tooltipId = `codex-visualization-tooltip-${
    window.crypto?.randomUUID?.() ?? Date.now().toString(36)
  }`;
  const tooltipGap = 5;
  const hoverDelay = 700;
  const skipDelay = 300;
  let activeTrigger = null;
  let pendingTrigger = null;
  let tooltip = null;
  let openTimeout = null;
  let autoUpdateCleanup = null;
  let positionRequest = 0;
  let skipDelayUntil = 0;
  let lastPointerWasTouch = false;
  let pinnedByTouch = false;

  const getTrigger = (event) =&gt; {
    for (const target of event.composedPath()) {
      if (target?.nodeType === Node.ELEMENT_NODE) {
        const trigger = target.closest(&quot;[data-tooltip]&quot;);
        if (trigger) return trigger;
      }
    }
    return null;
  };
  const containsTarget = (trigger, target) =&gt;
    target?.nodeType != null &amp;&amp; trigger.contains(target);
  const getContent = (trigger) =&gt;
    trigger.getAttribute(&quot;data-tooltip&quot;)?.trim() ?? &quot;&quot;;
  const getPlacement = (trigger) =&gt; {
    const placement = trigger.getAttribute(&quot;data-tooltip-placement&quot;);
    return tooltipPlacements.has(placement) ? placement : &quot;top&quot;;
  };
  const getTooltip = () =&gt; {
    if (tooltip == null) {
      tooltip = document.createElement(&quot;div&quot;);
      tooltip.id = tooltipId;
      tooltip.className = &quot;tooltip&quot;;
      tooltip.setAttribute(&quot;role&quot;, &quot;tooltip&quot;);
    }
    return tooltip;
  };
  const setDescribedBy = (trigger, described) =&gt; {
    const ids = new Set(
      (trigger.getAttribute(&quot;aria-describedby&quot;) ?? &quot;&quot;)
        .split(/\s+/)
        .filter(Boolean),
    );
    if (described) {
      ids.add(tooltipId);
    } else {
      ids.delete(tooltipId);
    }
    if (ids.size === 0) {
      trigger.removeAttribute(&quot;aria-describedby&quot;);
    } else {
      trigger.setAttribute(&quot;aria-describedby&quot;, [...ids].join(&quot; &quot;));
    }
  };
  const clearOpenTimeout = () =&gt; {
    if (openTimeout != null) {
      window.clearTimeout(openTimeout);
      openTimeout = null;
    }
    pendingTrigger = null;
  };
  const closeTooltip = (activateSkipDelay = true) =&gt; {
    clearOpenTimeout();
    pinnedByTouch = false;
    positionRequest += 1;
    autoUpdateCleanup?.();
    autoUpdateCleanup = null;
    if (activeTrigger == null) {
      return;
    }
    setDescribedBy(activeTrigger, false);
    activeTrigger = null;
    tooltip?.remove();
    if (activateSkipDelay) {
      skipDelayUntil = Date.now() + skipDelay;
    }
  };
  const updatePosition = (trigger, floating) =&gt; {
    const request = ++positionRequest;
    void computePosition(trigger, floating, {
      middleware: [
        offset(tooltipGap),
        flip({ padding: tooltipGap }),
        shift({ padding: tooltipGap }),
        size({
          padding: tooltipGap,
          apply({ availableHeight, availableWidth, elements }) {
            elements.floating.style.setProperty(
              &quot;--tooltip-available-width&quot;,
              `${Math.max(0, availableWidth)}px`,
            );
            elements.floating.style.setProperty(
              &quot;--tooltip-available-height&quot;,
              `${Math.max(0, availableHeight)}px`,
            );
          },
        }),
      ],
      placement: getPlacement(trigger),
      strategy: &quot;fixed&quot;,
    })
      .then(({ x, y }) =&gt; {
        if (activeTrigger !== trigger || request !== positionRequest) {
          return;
        }
        const scale = window.devicePixelRatio || 1;
        floating.style.transform = `translate(${Math.round(x * scale) / scale}px, ${Math.round(y * scale) / scale}px)`;
        floating.style.visibility = &quot;visible&quot;;
      })
      .catch(() =&gt; {
        if (activeTrigger === trigger &amp;&amp; request === positionRequest) {
          closeTooltip(false);
        }
      });
  };
  const openTooltip = (trigger) =&gt; {
    const content = getContent(trigger);
    if (!trigger.isConnected || content.length === 0) {
      return;
    }
    clearOpenTimeout();
    if (activeTrigger === trigger) {
      return;
    }
    closeTooltip();
    const floating = getTooltip();
    floating.textContent = content;
    floating.style.visibility = &quot;hidden&quot;;
    floating.style.transform = &quot;translate(0, 0)&quot;;
    document.body.appendChild(floating);
    activeTrigger = trigger;
    setDescribedBy(trigger, true);
    autoUpdateCleanup = autoUpdate(trigger, floating, () =&gt; {
      updatePosition(trigger, floating);
    });
  };
  const requestOpen = (trigger, immediate = false) =&gt; {
    if (
      getContent(trigger).length === 0 ||
      activeTrigger === trigger ||
      pendingTrigger === trigger
    ) {
      return;
    }
    clearOpenTimeout();
    pendingTrigger = trigger;
    const delay =
      immediate || activeTrigger != null || Date.now() &lt; skipDelayUntil
        ? 0
        : hoverDelay;
    if (delay === 0) {
      openTooltip(trigger);
      return;
    }
    openTimeout = window.setTimeout(() =&gt; {
      openTimeout = null;
      pendingTrigger = null;
      openTooltip(trigger);
    }, delay);
  };
  const handlePointerOpen = (event) =&gt; {
    if (event.pointerType === &quot;touch&quot;) {
      return;
    }
    const trigger = getTrigger(event);
    if (trigger == null || containsTarget(trigger, event.relatedTarget)) {
      return;
    }
    requestOpen(trigger);

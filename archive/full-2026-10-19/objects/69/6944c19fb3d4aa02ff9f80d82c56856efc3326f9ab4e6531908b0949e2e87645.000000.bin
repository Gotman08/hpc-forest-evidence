&lt;/script&gt;
&lt;div id=&quot;romeo-long-replay&quot;&gt;
  &lt;style&gt;
    #romeo-long-replay { color: var(--foreground); }
    #romeo-long-replay .long-heading { padding-right: 96px; margin-bottom: 16px; }
    #romeo-long-replay .long-heading h3 { margin: 0 0 4px; }
    #romeo-long-replay .long-playback { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 12px 0; }
    #romeo-long-replay .long-event { display: grid; gap: 4px; min-height: 60px; margin: 12px 0 6px; }
    #romeo-long-replay .long-event-name { font-weight: 500; }
    #romeo-long-replay .long-counts { margin: 8px 0; }
    #romeo-long-replay .long-svg { width: 100%; display: block; overflow: visible; }
    #romeo-long-replay .long-svg text { fill: var(--foreground); }
    #romeo-long-replay .long-svg .secondary { fill: var(--muted-foreground); }
    #romeo-long-replay .long-svg .parent-edge { stroke: var(--muted-foreground); stroke-width: 1.4; fill: none; }
    #romeo-long-replay .long-svg .path-edge { stroke: var(--viz-series-1); stroke-width: 1.8; }
    #romeo-long-replay .long-svg .node-root { fill: var(--muted); stroke: var(--border); stroke-width: 1.25; }
    #romeo-long-replay .long-svg .node-valid { fill: color-mix(in srgb, var(--viz-series-1) 15%, var(--background)); stroke: var(--border); stroke-width: 1.25; }
    #romeo-long-replay .long-svg .node-failed { fill: color-mix(in srgb, var(--viz-series-3) 15%, var(--background)); stroke: var(--border); stroke-width: 1.25; }
    #romeo-long-replay .long-svg .node-winner { fill: color-mix(in srgb, var(--viz-series-2) 20%, var(--background)); stroke: var(--border); stroke-width: 1.25; }
    #romeo-long-replay .long-svg .selected { stroke: var(--viz-series-1); stroke-width: 2; }
    #romeo-long-replay .long-svg .node-name { font-weight: 500; }
    #romeo-long-replay .long-svg .score-dot { fill: var(--viz-series-1); }
    #romeo-long-replay .long-selection { margin: 8px 0; }
    #romeo-long-replay .long-legend { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 10px; }
    #romeo-long-replay .long-key { display: inline-flex; align-items: center; gap: 6px; }
    #romeo-long-replay .long-key[hidden] { display: none; }
    #romeo-long-replay .long-key svg { width: 24px; height: 18px; }
    @media (max-width: 440px) { #romeo-long-replay .long-event { min-height: 80px; } }
  &lt;/style&gt;
  &lt;div class=&quot;long-heading&quot;&gt;
    &lt;h3&gt;Une recherche qui s’élargit et descend&lt;/h3&gt;
    &lt;div class=&quot;text-small text-muted&quot;&gt;14B · ROMEO 746880 · 88 essais réels&lt;/div&gt;
  &lt;/div&gt;
  &lt;div class=&quot;viz-controls&quot;&gt;
    &lt;label class=&quot;form-label&quot;&gt;Arbre à rejouer
      &lt;select class=&quot;form-select&quot; data-control=&quot;tree&quot; aria-label=&quot;Arbre à rejouer&quot;&gt;&lt;/select&gt;
    &lt;/label&gt;
    &lt;label class=&quot;form-label&quot;&gt;Vitesse de lecture
      &lt;select class=&quot;form-select&quot; data-control=&quot;speed&quot; aria-label=&quot;Vitesse de lecture&quot;&gt;
        &lt;option value=&quot;0.5&quot;&gt;0,5 ×&lt;/option&gt;&lt;option value=&quot;1&quot; selected&gt;1 ×&lt;/option&gt;&lt;option value=&quot;2&quot;&gt;2 ×&lt;/option&gt;
      &lt;/select&gt;
    &lt;/label&gt;
  &lt;/div&gt;
  &lt;div class=&quot;long-playback&quot;&gt;
    &lt;button class=&quot;btn btn-primary&quot; type=&quot;button&quot; data-control=&quot;play&quot;&gt;Rejouer&lt;/button&gt;
    &lt;button class=&quot;btn&quot; type=&quot;button&quot; data-control=&quot;previous&quot;&gt;Précédent&lt;/button&gt;
    &lt;button class=&quot;btn&quot; type=&quot;button&quot; data-control=&quot;next&quot;&gt;Suivant&lt;/button&gt;
    &lt;button class=&quot;btn&quot; type=&quot;button&quot; data-control=&quot;descent&quot;&gt;Voir une descente&lt;/button&gt;
    &lt;span class=&quot;text-small text-muted tabular-nums&quot; data-value=&quot;step&quot;&gt;&lt;/span&gt;
  &lt;/div&gt;
  &lt;label class=&quot;form-label&quot; for=&quot;romeo-long-step&quot;&gt;Essais de l’arbre sélectionné&lt;/label&gt;
  &lt;input class=&quot;form-range&quot; id=&quot;romeo-long-step&quot; type=&quot;range&quot; min=&quot;0&quot; max=&quot;1&quot; step=&quot;1&quot; value=&quot;0&quot; data-control=&quot;timeline&quot;&gt;
  &lt;div class=&quot;long-event&quot; aria-live=&quot;polite&quot; aria-atomic=&quot;true&quot;&gt;
    &lt;div class=&quot;long-event-name&quot; data-value=&quot;event&quot;&gt;&lt;/div&gt;
    &lt;div class=&quot;text-small text-muted tabular-nums&quot; data-value=&quot;detail&quot;&gt;&lt;/div&gt;
  &lt;/div&gt;
  &lt;div class=&quot;long-counts tabular-nums&quot; data-value=&quot;counts&quot;&gt;&lt;/div&gt;
  &lt;div data-value=&quot;drawing&quot;&gt;
    &lt;svg class=&quot;long-svg&quot; role=&quot;img&quot; aria-labelledby=&quot;romeo-long-title romeo-long-desc&quot; height=&quot;300&quot;&gt;
      &lt;title id=&quot;romeo-long-title&quot;&gt;Arbre de recherche réel avec plusieurs fils et plusieurs niveaux.&lt;/title&gt;
      &lt;desc id=&quot;romeo-long-desc&quot;&gt;&lt;/desc&gt;
    &lt;/svg&gt;
  &lt;/div&gt;
  &lt;div class=&quot;long-selection&quot;&gt;
    &lt;label class=&quot;form-label&quot; for=&quot;romeo-long-node&quot;&gt;Nœud inspecté&lt;/label&gt;
    &lt;select class=&quot;form-select&quot; id=&quot;romeo-long-node&quot; data-control=&quot;node&quot;&gt;&lt;/select&gt;
  &lt;/div&gt;
  &lt;div class=&quot;text-small tabular-nums&quot; data-value=&quot;selection&quot; aria-live=&quot;polite&quot;&gt;&lt;/div&gt;
  &lt;div class=&quot;long-legend text-small&quot;&gt;
    &lt;span class=&quot;long-key&quot;&gt;&lt;svg aria-hidden=&quot;true&quot;&gt;&lt;path d=&quot;M0 9H24&quot; stroke=&quot;var(--muted-foreground)&quot; stroke-width=&quot;1.4&quot;/&gt;&lt;/svg&gt;Parent de recherche&lt;/span&gt;
    &lt;span class=&quot;long-key&quot;&gt;&lt;svg aria-hidden=&quot;true&quot;&gt;&lt;circle cx=&quot;12&quot; cy=&quot;9&quot; r=&quot;7&quot; fill=&quot;color-mix(in srgb, var(--viz-series-1) 15%, var(--background))&quot; stroke=&quot;var(--border)&quot;/&gt;&lt;/svg&gt;Programme valide&lt;/span&gt;
    &lt;span class=&quot;long-key&quot; data-value=&quot;failed-key&quot;&gt;&lt;svg aria-hidden=&quot;true&quot;&gt;&lt;path d=&quot;M12 1L20 9L12 17L4 9Z&quot; fill=&quot;color-mix(in srgb, var(--viz-series-3) 15%, var(--background))&quot; stroke=&quot;var(--border)&quot;/&gt;&lt;/svg&gt;Compilation échouée · q = 0&lt;/span&gt;
    &lt;span class=&quot;long-key&quot; data-value=&quot;winner-key&quot;&gt;&lt;svg aria-hidden=&quot;true&quot;&gt;&lt;circle cx=&quot;12&quot; cy=&quot;9&quot; r=&quot;7&quot; fill=&quot;color-mix(in srgb, var(--viz-series-2) 20%, var(--background))&quot; stroke=&quot;var(--border)&quot;/&gt;&lt;/svg&gt;Version finale retenue&lt;/span&gt;
  &lt;/div&gt;
  &lt;div class=&quot;text-small text-muted&quot;&gt;Étapes à durée fixe · les doublons ne créent aucun nœud · racines au niveau 0&lt;/div&gt;
  &lt;script&gt;
    (() =&gt; {
      const root = document.getElementById(&#x27;romeo-long-replay&#x27;);
      if (!root) return;

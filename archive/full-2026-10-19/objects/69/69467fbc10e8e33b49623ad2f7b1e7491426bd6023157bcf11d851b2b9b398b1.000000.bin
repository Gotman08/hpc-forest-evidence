        "content": "#include \"knn.h\"\n#include <limits.h>\n#include <math.h>\n#include <stdint.h>\n#include <string.h>\n\n#ifdef _OPENMP\n#include <omp.h>\n#endif\n\n#define KNN_LABEL_COUNT (UCHAR_MAX + 1)\n\ntypedef struct {\n    float distance;\n    char label;\n    size_t ordinal;\n} KnnCandidate;\n\ntypedef struct {\n    size_t begin;\n    size_t retained;\n    int has_nan;\n    size_t all[KNN_LABEL_COUNT];\n    size_t chosen[KNN_LABEL_COUNT];\n} KnnShard;\n\nstatic char knn_vote(const size_t *counts) {\n    char best = (char)-1;\n    size_t best_count = 0;\n\n    for (unsigned int i = 0; i < KNN_LABEL_COUNT; ++i) {\n        char label = (char)(unsigned char)i;\n        if (counts[i] > best_count ||\n            (counts[i] != 0 && counts[i] == best_count && label < best)) {\n            best = label;\n            best_count = counts[i];\n        }\n    }\n    return best;\n}\n\nstatic int knn_candidate_order(const KnnCandidate *a,\n                               const KnnCandidate *b, int reverse) {\n    int order;\n    if (a->distance < b->distance) {\n        order = -1;\n    } else if (a->distance > b->distance) {\n        order = 1;\n    } else {\n        order = (a->ordinal > b->ordinal) - (a->ordinal < b->ordinal);\n    }\n    return reverse ? -order : order;\n}\n\nstatic int knn_compare_near(const void *a, const void *b) {\n    return knn_candidate_order((const KnnCandidate *)a,\n                               (const KnnCandidate *)b, 0);\n}\n\nstatic int knn_compare_far(const void *a, const void *b) {\n    return knn_candidate_order((const KnnCandidate *)a,\n                               (const KnnCandidate *)b, 1);\n}\n\nstatic void knn_swap(KnnCandidate *a, KnnCandidate *b) {\n    KnnCandidate temporary = *a;\n    *a = *b;\n    *b = temporary;\n}\n\n/* Retain the first 'keep' entries in the requested total order. */\nstatic void knn_select(KnnCandidate *items, size_t length,\n                       size_t keep, int reverse) {\n    if (keep == 0 || keep >= length) return;\n\n    size_t lo = 0;\n    size_t hi = length;\n    unsigned int budget = 0;\n    for (size_t n = length; n > 1; n >>= 1) budget += 2;\n\n    while (hi - lo > 24) {\n        if (budget-- == 0) {\n            qsort(items + lo, hi - lo, sizeof(*items),\n                  reverse ? knn_compare_far : knn_compare_near);\n            return;\n        }\n\n        KnnCandidate a = items[lo];\n        KnnCandidate b = items[lo + (hi - lo) / 2];\n        KnnCandidate c = items[hi - 1];\n        if (knn_candidate_order(&a, &b, reverse) > 0) knn_swap(&a, &b);\n        if (knn_candidate_order(&b, &c, reverse) > 0) knn_swap(&b, &c);\n        if (knn_candidate_order(&a, &b, reverse) > 0) knn_swap(&a, &b);\n        KnnCandidate pivot = b;\n\n        size_t lower = lo;\n        size_t current = lo;\n        size_t upper = hi;\n        while (current < upper) {\n            int order = knn_candidate_order(items + current, &pivot, reverse);\n            if (order < 0) {\n                knn_swap(items + lower, items + current);\n                ++lower;\n                ++current;\n            } else if (order > 0) {\n                --upper;\n                knn_swap(items + current, items + upper);\n            } else {\n                ++current;\n            }\n        }\n\n        if (keep < lower) {\n            hi = lower;\n        } else if (keep > upper) {\n            lo = upper;\n        } else {\n            return;\n        }\n    }\n\n    for (size_t i = lo + 1; i < hi; ++i) {\n        KnnCandidate value = items[i];\n        size_t j = i;\n        while (j > lo &&\n               knn_candidate_order(&value, items + j - 1, reverse) < 0) {\n            items[j] = items[j - 1];\n            --j;\n        }\n        items[j] = value;\n    }\n}\n\n/* Preserve insertion semantics for unordered floating-point distances. */\nstatic char knn_insertion(int n_groups, Group *groups, int k,\n                           Point to_evaluate) {\n    char *labels = (char *)malloc((size_t)k * sizeof(*labels));\n    float *distances = (float *)malloc((size_t)k * sizeof(*distances));\n    if (labels == NULL || distances == NULL) {\n        free(labels);\n        free(distances);\n        on_error();\n    }\n\n    for (int i = 0; i < k; ++i) {\n        labels[i] = (char)-1;\n        distances[i] = -1;\n    }\n\n    for (int i = 0; i < n_groups; ++i) {\n        Group g = groups[i];\n        for (int j = 0; j < g.length; ++j) {\n            float d = euclidean_distance_no_sqrt(to_evaluate, g.points[j]);\n            for (int x = 0; x < k; ++x) {\n                if (d < distances[x] || distances[x] == -1) {\n                    for (int y = k - 1; y > x; --y) {\n                        distances[y] = distances[y - 1];\n                        labels[y] = labels[y - 1];\n                    }\n                    distances[x] = d;\n                    labels[x] = g.label;\n                    break;\n                }\n            }\n        }\n    }\n\n    size_t counts[KNN_LABEL_COUNT] = {0};\n    for (int i = 0; i < k; ++i) ++counts[(unsigned char)labels[i]];\n    char result = knn_vote(counts);\n    free(labels);\n    free(distances);\n    return result;\n}\n\nchar knn(int n_groups, Group *groups, int k, Point to_evaluate) {\n    if (k <= 0) return (char)-1;\n\n    size_t total = 0;\n    for (int g = 0; g < n_groups; ++g) {\n        if (groups[g].length > 0) {\n            size_t length = (size_t)groups[g].length;\n            if (length > SIZE_MAX - total) {\n                return knn_insertion(n_groups, groups, k, to_evaluate);\n            }\n            total += length;\n        }\n    }\n\n    if ((size_t)k >= total) {\n        size_t counts[KNN_LABEL_COUNT] = {0};\n        for (int g = 0; g < n_groups; ++g) {\n            if (groups[g].length > 0) {\n                counts[(unsigned char)groups[g].label] +=\n                    (size_t)groups[g].length;\n            }\n        }\n        char empty_label = (char)-1;\n        counts[(unsigned char)empty_label] += (size_t)k - total;\n        return knn_vote(counts);\n    }\n\n    int workers = 1;\n#ifdef _OPENMP\n    workers = omp_get_max_threads();\n    if (workers < 1) workers = 1;\n    size_t useful_workers = total / 8192;\n    if (useful_workers == 0) useful_workers = 1;\n    if (useful_workers < (size_t)workers) workers = (int)useful_workers;\n#endif\n\n    if (total > SIZE_MAX / sizeof(KnnCandidate)) {\n        return knn_insertion(n_groups, groups, k, to_evaluate);\n    }\n    KnnCandidate *items = (KnnCandidate *)malloc(total * sizeof(*items));\n    KnnShard *shards = (KnnShard *)calloc((size_t)workers, sizeof(*shards));\n    if (items == NULL || shards == NULL) {\n        free(items);\n        free(shards);\n        return knn_insertion(n_groups, groups, k, to_evaluate);\n    }\n\n    const int reverse = (size_t)k > total / 2;\n    const size_t needed = reverse ? total - (size_t)k : (size_t)k;\n    int has_nan = 0;\n    char result = (char)-1;\n\n#ifdef _OPENMP\n#pragma omp parallel num_threads(workers) if(workers > 1)\n#endif\n    {\n        int tid = 0;\n        int threads = 1;\n#ifdef _OPENMP\n        tid = omp_get_thread_num();\n        threads = omp_get_num_threads();\n#endif\n        size_t base = total / (size_t)threads;\n        size_t remainder = total % (size_t)threads;\n        size_t preceding_extra = (size_t)tid < remainder ?\n                                 (size_t)tid : remainder;\n        size_t begin = base * (size_t)tid + preceding_extra;\n        size_t end = begin + base + ((size_t)tid < remainder);\n        KnnShard *local = shards + tid;\n        local->begin = begin;\n        local->retained = end - begin < needed ? end - begin : needed;\n\n        size_t offset = 0;\n        for (int g = 0; g < n_groups && offset < end; ++g) {\n            size_t length = groups[g].length > 0 ?\n                            (size_t)groups[g].length : 0;\n            size_t next = offset + length;\n            if (next > begin) {\n                size_t first = begin > offset ? begin - offset : 0;\n                size_t last = end < next ? end - offset : length;\n                if (reverse) {\n                    local->all[(unsigned char)groups[g].label] += last - first;\n                }\n                for (size_t j = first; j < last; ++j) {\n                    size_t ordinal = offset + j;\n                    float d = euclidean_distance_no_sqrt(\n                        to_evaluate, groups[g].points[j]);\n                    items[ordinal].distance = d;\n                    items[ordinal].label = groups[g].label;\n                    items[ordinal].ordinal = ordinal;\n                    if (isnan(d)) local->has_nan = 1;\n                }\n            }\n            offset = next;\n        }\n\n        if (!local->has_nan) {\n            knn_select(items + begin, end - begin, local->retained, reverse);\n        }\n\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single\n#endif\n        {\n            for (int t = 0; t < threads; ++t) {\n                if (shards[t].has_nan) has_nan = 1;\n            }\n            if (!has_nan) {\n                size_t retained = 0;\n                for (int t = 0; t < threads; ++t) {\n                    memmove(items + retained, items + shards[t].begin,\n                            shards[t].retained * sizeof(*items));\n                    retained += shards[t].retained;\n                }\n                knn_select(items, retained, needed, reverse);\n            }\n        }\n\n        if (!has_nan) {\n            size_t count_base = needed / (size_t)threads;\n            size_t count_extra = needed % (size_t)threads;\n            size_t before = (size_t)tid < count_extra ?\n                            (size_t)tid : count_extra;\n            size_t first = count_base * (size_t)tid + before;\n            size_t last = first + count_base + ((size_t)tid < count_extra);\n            for (size_t i = first; i < last; ++i) {\n                ++local->chosen[(unsigned char)items[i].label];\n            }\n        }\n\n#ifdef _OPENMP\n#pragma omp barrier\n#pragma omp single nowait\n#endif\n        {\n            if (!has_nan) {\n                size_t counts[KNN_LABEL_COUNT];\n                for (unsigned int label = 0; label < KNN_LABEL_COUNT; ++label) {\n                    size_t chosen = 0;\n                    size_t all = 0;\n                    for (int t = 0; t < threads; ++t) {\n                        chosen += shards[t].chosen[label];\n                        if (reverse) all += shards[t].all[label];\n                    }\n                    counts[label] = reverse ? all - chosen : chosen;\n                }\n                result = knn_vote(counts);\n            }\n        }\n    }\n\n    free(items);\n    free(shards);\n    if (has_nan) return knn_insertion(n_groups, groups, k, to_evaluate);\n    return result;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
        "path": "src/knn.c"
      }

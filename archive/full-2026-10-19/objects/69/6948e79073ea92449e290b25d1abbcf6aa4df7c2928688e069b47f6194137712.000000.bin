#include "knn.h"

#if defined(__aarch64__) && defined(__ARM_NEON)
#include <arm_neon.h>
#endif

static inline unsigned int knn_candidate_mask(const float *values,
                                               int count, float cutoff) {
    if (cutoff == -1.0f) {
        return (1u << count) - 1u;
    }

#if defined(__aarch64__) && defined(__ARM_NEON)
    if (count == 16) {
        const float32x4_t bound = vdupq_n_f32(cutoff);
        const uint8x16_t weights = {
            1, 2, 4, 8, 16, 32, 64, 128,
            1, 2, 4, 8, 16, 32, 64, 128
        };
        uint8x16_t a = vreinterpretq_u8_u32(
            vcgeq_f32(vld1q_f32(values), bound));
        uint8x16_t b = vreinterpretq_u8_u32(
            vcgeq_f32(vld1q_f32(values + 4), bound));
        uint8x16_t c = vreinterpretq_u8_u32(
            vcgeq_f32(vld1q_f32(values + 8), bound));
        uint8x16_t d = vreinterpretq_u8_u32(
            vcgeq_f32(vld1q_f32(values + 12), bound));

        /* Pack one comparison byte per point, retaining unordered values. */
        uint8x16_t ab = vuzp1q_u8(a, b);
        uint8x16_t cd = vuzp1q_u8(c, d);
        uint8x16_t rejected = vuzp1q_u8(ab, cd);
        uint8x16_t bits = vandq_u8(vmvnq_u8(rejected), weights);
        unsigned int low = vaddv_u8(vget_low_u8(bits));
        unsigned int high = vaddv_u8(vget_high_u8(bits));
        return low | (high << 8);
    }
#endif

    unsigned int mask = 0;
    for (int lane = 0; lane < count; lane++) {
        if (!(values[lane] >= cutoff)) {
            mask |= 1u << lane;
        }
    }
    return mask;
}

char knn(int n_groups, Group * groups, int k, Point to_evaluate) {
    char * labels = (char *) malloc(sizeof(char) * k);
    float * distances = (float *) malloc(sizeof(float) * k);
    enum { DISTANCE_BLOCK = 256 };
    float block_distances[DISTANCE_BLOCK];

    int i, j, x, y;

    for (i = 0; i < k; i++) {
        labels[i] = -1;
        distances[i] = -1;
    }

    for (i = 0; i < n_groups; i++) {
        Group g = groups[i];

        for (j = 0; j < g.length;) {
            int count = g.length - j;
            if (count > DISTANCE_BLOCK) count = DISTANCE_BLOCK;
            const Point * restrict points = g.points + j;

            /* Evaluate independent distances before the ordered top-k updates. */
#if defined(_OPENMP)
#pragma omp simd
#endif
            for (int lane = 0; lane < count; lane++) {
                block_distances[lane] =
                    euclidean_distance_no_sqrt(to_evaluate, points[lane]);
            }

            for (int first = 0; first < count; first += 16) {
                int lanes = count - first;
                if (lanes > 16) lanes = 16;
                unsigned int candidates = knn_candidate_mask(
                    block_distances + first, lanes, distances[k - 1]);

                /* Visit surviving points in their original encounter order. */
                while (candidates != 0) {
                    int lane = first + (int)__builtin_ctz(candidates);
                    candidates &= candidates - 1u;
                    float d = block_distances[lane];

                    /* Earlier survivors may have tightened the cutoff. */
                    if (distances[k - 1] != -1 && d >= distances[k - 1]) {
                        continue;
                    }

                    for (x = 0; x < k; x++) {
                        if (d < distances[x] || distances[x] == -1) {
                            for (y = k - 1; y > x; y--) {
                                distances[y] = distances[y - 1];
                                labels[y] = labels[y - 1];
                            }

                            distances[x] = d;
                            labels[x] = g.label;

                            break;
                        }
                    }
                }
            }

            j += count;
        }
    }

    qsort(labels, k, sizeof(char), compare_for_sort);

    char most_frequent = labels[0];
    int most_frequent_count = 1;
    int current_frequency = 1;

    for (i = 1; i < k; i++) {
        if (labels[i] != labels[i - 1]) {
            if (current_frequency > most_frequent_count) {
                most_frequent = labels[i - 1];
                most_frequent_count = current_frequency;
            }

            current_frequency = 1;
        } else {
            current_frequency++;
        }

        if (i == k - 1 && current_frequency > most_frequent_count) {
            most_frequent = labels[i - 1];
            most_frequent_count = current_frequency;
        }
    }

    free(distances);
    free(labels);
    return most_frequent;
}

int main() {
    int n_groups = parse_number_of_groups();
    
    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);

    for (int i = 0; i < n_groups; i++) {
        groups[i] = parse_next_group();
    }

    int k = parse_k();

    Point to_evaluate = parse_point();

    printf("%c", knn(n_groups, groups, k, to_evaluate));
}

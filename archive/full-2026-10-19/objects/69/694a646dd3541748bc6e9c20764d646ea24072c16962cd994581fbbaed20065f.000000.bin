"""Copy the sealed auditor into a new namespace-fix revision; never alter its predecessor."""
from __future__ import annotations

import hashlib
import json
from pathlib import Path

OUT = Path(__file__).resolve().parent
OLD = OUT.parent
names = ("audit_cache_preservation_r2.py", "audit_campaign.py", "audit_common.py", "audit_context.py",
    "audit_evaluations.py", "audit_formats_r2.py", "audit_private_r2c.py", "audit_r2_native.py",
    "audit_source_binding_r2.py", "audit_transport.py", "git_loose_readonly.py", "test_audit_r2c_neutral.py")
protected = {str(path): hashlib.sha256(path.read_bytes()).hexdigest() for path in OLD.iterdir() if path.is_file()}
if hashlib.sha256((OLD / "LIVRAISON-AUDITEUR-LOCAL-R2C.json").read_bytes()).hexdigest() != "73f3393fc456ca41939f0104566236fb3da50b5be910cb6ccdafb262e21b1ca9":
    raise RuntimeError("The sealed predecessor delivery changed")
with (OUT / "preservation-avant.json").open("x", encoding="utf8", newline="\n") as stream:
    stream.write(json.dumps(protected, ensure_ascii=False, indent=2) + "\n")
for name in names:
    raw = (OLD / name).read_bytes()
    if name == "test_audit_r2c_neutral.py":
        raw = raw.replace(b'Path(__file__).resolve().parents[2]', b'Path(__file__).resolve().parents[3]')
    with (OUT / name).open("xb") as stream:
        stream.write(raw)
print(json.dumps({"protected_original_files": len(protected), "copied_modules_and_tests": len(names)}))

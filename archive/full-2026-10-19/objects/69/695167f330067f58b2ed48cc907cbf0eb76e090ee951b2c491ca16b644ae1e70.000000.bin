"""Preparation only: pin actual frozen contexts, admissions and restored requests.

No source worker-cache path is enumerated/read and no collection main is called.
"""
import importlib.util
import json
from pathlib import Path, PurePosixPath

HERE = Path(__file__).resolve().parent
spec = importlib.util.spec_from_file_location('closed_collection', HERE / 'collecter-final-parent.py')
gate = importlib.util.module_from_spec(spec)
spec.loader.exec_module(gate)


def prepare():
    result = {'schema': 'hpc-forest-r2g-root-collection-frozen-inputs-v1',
        'preparation_only': True, 'live_cache_read': False, 'collection_executed': False,
        'stop_or_launch_executed': False, 'scientific_or_performance_admission': False, 'cells': {}}
    for cell in gate.CELLS:
        slug, model, job, session, pid, parent, count = cell
        context_path = gate.REL / 'reception-premier-batch-r1' / ('contexte_' + slug + '_max_' + job) / 'contexte-installation-reelle.json'
        context = gate.read(context_path)
        local_ref, worker_ref = context['local_authorization'], context['remote_authorization']
        local, worker = gate.read_ref(local_ref), gate.read_ref(worker_ref)
        expected = gate.identity(cell)
        for authorization in (local, worker):
            gate.need(all(authorization.get(k) == v for k, v in expected.items()
                if k not in {'source_zip_sha256', 'plan_sha256'}) and authorization.get('verified') is True
                and set(authorization['artifacts']) == gate.ARTIFACTS, 'Actual exact original G authorization required')
        source_bindings = gate.read_ref(context['source_bindings'])
        factory = gate.FACTORY / ('admissions-' + slug + '-max-reelles')
        publication_ref = gate.ref(factory / 'publication-locale/publication-arguments.json')
        publication = gate.read_ref(publication_ref)
        download_ref = gate.ref(gate.REL / 'operations-parent' / (slug + '-max') / 'directory-readback-result.json')
        downloaded = gate.read_ref(download_ref); downloaded = downloaded.get('structuredContent', downloaded)
        admission_root = '/scratch_p/nimarano/' + gate.SCOPE + '-admission-' + session
        gate.need(publication['remote_root'] == admission_root and downloaded.get('ok') is True
            and downloaded.get('downloaded') == admission_root and downloaded.get('transport') == 'scp',
            'Exact real publication/readback namespace required')
        readback = gate.safe(downloaded['to'])
        gate.need(readback == factory / 'publication-locale/readback', 'Actual literal factory readback required')
        declared = publication['inventory']
        actual = {p.name for p in readback.iterdir()}
        extras = {'allocation-ready.json': publication['allocation_marker'],
            'authorization-ready.json': publication['ready']['local']}
        gate.need(set(declared) <= actual <= set(declared) | set(extras), 'Unknown/missing received namespace member')
        for name in actual:
            received = readback / name
            gate.need(received.is_file() and gate.safe(received) == received, 'Readback link/subdirectory refused')
            if name in declared:
                raw, metadata = gate.stable_bytes(received)
                gate.need({'sha256': metadata['sha256'], 'bytes': len(raw)} == declared[name], 'Actual readback SHA/size differs')
            else:
                gate.need(gate.ref(received)['sha256'] == extras[name]['sha256'], 'Actual extra namespace member differs')
        controller_copies = local['artifacts']
        for value in controller_copies.values(): gate.item(value)
        package = Path(controller_copies['source_zip']['path']).parent
        worker_copies = {}
        extraction = PurePosixPath(source_bindings['remote_extraction'])
        qualification = PurePosixPath(source_bindings['remote_qualification_root']) / 'Q/qualification.json'
        for key, original in worker['artifacts'].items():
            remote = PurePosixPath(original['path'])
            gate.need(str(remote) == original['path'] and '..' not in remote.parts, 'Unsafe original remote admission path')
            if remote.parent == PurePosixPath(admission_root):
                local_path = readback / remote.name  # Exact declared admission-root matrix, never basename fallback.
                gate.need(remote.name in declared and declared[remote.name]['sha256'] == original['sha256'], 'Original admission absent from declared readback')
            elif remote.is_relative_to(extraction):
                local_path = package / Path(*remote.relative_to(extraction).parts)
            elif remote == qualification:
                local_path = Path(source_bindings['qualification']['path'])
            else:
                raise ValueError('Unmapped exact remote admission namespace: ' + key)
            worker_copies[key] = gate.ref(local_path)
            gate.need(worker_copies[key]['sha256'] == original['sha256'], 'Received original worker admission hash differs')
        terminal = gate.REL / ('reception-terminal-' + job)
        restored = terminal / 'restauration-neuve-parent-r1'
        scheduler = gate.ref(terminal / 'statut-terminal.json')
        status = gate.read_ref(scheduler); status = status.get('structuredContent', status)
        gate.need(status.get('job_id') == job and status.get('finished') is True
            and status.get('observation', {}).get('current_state_observed') is True
            and status.get('state') == 'FAILED' and status.get('exit_code') == '1:0', 'Real final scheduler observation differs')
        result['cells'][session] = {
            'original_context': gate.ref(context_path),
            'controller_authorization': local_ref, 'worker_authorization': worker_ref,
            'controller_admission_copies': controller_copies, 'worker_admission_copies': worker_copies,
            'admission_namespace_aliases': {'upload_manifest': context['upload_manifest'],
                'publication': publication_ref, 'download_receipt': download_ref},
            'private_cli_policy_original': context['cli_policy'], 'scheduler_observation': scheduler,
            'archive': gate.ref(terminal / ('results-' + job + '.tar.gz')),
            'archive_announcement': gate.ref(terminal / 'archive.json'),
            'archive_announcement_transfer': gate.ref(terminal / 'archive.json.transfer.json'),
            'archive_transfer': gate.ref(terminal / ('results-' + job + '.tar.gz.transfer.json')),
            'restore_receipt': gate.ref(terminal / 'RESTAURATION-PARENT-VERIFIEE.json'),
            'restored_inventory': gate.ref(terminal / 'INVENTAIRE-RESTAURATION-PARENT.json'),
            'archive_request_refs': gate.archive_nonces(restored, cell),
            'certified': str(package / 'certified-preparation'),
            'source_binding_namespace_matrix': context['source_bindings']}
        gate.item(context['cli_policy'])
        gate.item(context['upload_manifest'])
    gate.need(sum(len(v['archive_request_refs']) for v in result['cells'].values()) == 10, 'Actual restored 10-request boundary required')
    return gate.save(HERE / 'INPUTS-FROIDS-EPINGLES-r2.json', result)


if __name__ == '__main__':
    print(json.dumps({'created_frozen_inputs': prepare(), 'live_cache_read': False, 'collection_executed': False,
        'stop_or_launch_executed': False, 'final_scientific_admission': False}))

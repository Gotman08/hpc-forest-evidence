{
  "files": [
    {
      "content": "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#if defined(__aarch64__)\n#include <arm_neon.h>\n#include <fenv.h>\n#include <stdint.h>\n#endif\n\n#define N_ITER 10 // number of simulation iterations\n#define DT 0.01f // time step\n#define SOFTENING 1e-9f // to avoid zero divisors\n\n/*\n * Each body holds coordinate positions (i.e., x, y, and z) and\n * velocities (i.e., vx, vy, and vz).\n */\ntypedef struct { float x, y, z, vx, vy, vz; } Body;\n\n/* Original ordered kernel for scalar tails and nondefault rounding. */\nstatic inline void body_force_one(Body *p, float dt, int i, int n) {\n  float fx = 0.0f;\n  float fy = 0.0f;\n  float fz = 0.0f;\n  int j = 0;\n\n#if defined(__aarch64__)\n  for (; j + 1 < n; j += 2) {\n    float dx0 = p[j].x - p[i].x;\n    float dy0 = p[j].y - p[i].y;\n    float dz0 = p[j].z - p[i].z;\n    float sqrd_dist0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + SOFTENING;\n\n    float dx1 = p[j + 1].x - p[i].x;\n    float dy1 = p[j + 1].y - p[i].y;\n    float dz1 = p[j + 1].z - p[i].z;\n    float sqrd_dist1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + SOFTENING;\n\n    float32x2_t squared = vdup_n_f32(sqrd_dist0);\n    squared = vset_lane_f32(sqrd_dist1, squared, 1);\n    float64x2_t roots = vsqrtq_f64(vcvt_f64_f32(squared));\n    float32x2_t inverse = vcvt_f32_f64(\n        vdivq_f64(vdupq_n_f64(1.0), roots));\n    float32x2_t inverse3 = vmul_f32(vmul_f32(inverse, inverse), inverse);\n    float inv_dist30 = vget_lane_f32(inverse3, 0);\n    float inv_dist31 = vget_lane_f32(inverse3, 1);\n\n    fx += dx0 * inv_dist30;\n    fy += dy0 * inv_dist30;\n    fz += dz0 * inv_dist30;\n    fx += dx1 * inv_dist31;\n    fy += dy1 * inv_dist31;\n    fz += dz1 * inv_dist31;\n  }\n#endif\n\n  for (; j < n; j++) {\n    float dx = p[j].x - p[i].x;\n    float dy = p[j].y - p[i].y;\n    float dz = p[j].z - p[i].z;\n    float sqrd_dist = dx*dx + dy*dy + dz*dz + SOFTENING;\n    float inv_dist = 1 / sqrt(sqrd_dist);\n    float inv_dist3 = inv_dist * inv_dist * inv_dist;\n\n    fx += dx * inv_dist3;\n    fy += dy * inv_dist3;\n    fz += dz * inv_dist3;\n  }\n\n  p[i].vx += dt*fx;\n  p[i].vy += dt*fy;\n  p[i].vz += dt*fz;\n}\n\n#if defined(__aarch64__)\nstatic inline __attribute__((always_inline))\nfloat32x4_t exact_inverse4(float32x4_t squared) {\n  float64x2_t lo = vsqrtq_f64(vcvt_f64_f32(vget_low_f32(squared)));\n  float64x2_t hi = vsqrtq_f64(vcvt_f64_f32(vget_high_f32(squared)));\n  lo = vdivq_f64(vdupq_n_f64(1.0), lo);\n  hi = vdivq_f64(vdupq_n_f64(1.0), hi);\n  return vcombine_f32(vcvt_f32_f64(lo), vcvt_f32_f64(hi));\n}\n\nstatic inline __attribute__((always_inline))\nuint64x2_t near_float_midpoint(float64x2_t value) {\n  /* Normal float midpoints have low 29 double bits equal to 2^28.\n   * Reserve a conservative window of +/- 2^18 double ulps. */\n  uint64x2_t low = vandq_u64(vreinterpretq_u64_f64(value),\n                           vdupq_n_u64(UINT64_C(0x1fffffff)));\n  return vcleq_u64(\n      vsubq_u64(low, vdupq_n_u64(UINT64_C(0x0ffc0000))),\n      vdupq_n_u64(UINT64_C(0x00080000)));\n}\n\nstatic inline __attribute__((always_inline))\nfloat32x4_t estimate_inverse4(float32x4_t squared, uint64x2_t *near) {\n  float32x4_t r = vrsqrteq_f32(squared);\n  r = vmulq_f32(r, vrsqrtsq_f32(vmulq_f32(squared, r), r));\n  r = vmulq_f32(r, vrsqrtsq_f32(vmulq_f32(squared, r), r));\n\n  float64x2_t slo = vcvt_f64_f32(vget_low_f32(squared));\n  float64x2_t shi = vcvt_f64_f32(vget_high_f32(squared));\n  float64x2_t rlo = vcvt_f64_f32(vget_low_f32(r));\n  float64x2_t rhi = vcvt_f64_f32(vget_high_f32(r));\n  rlo = vmulq_f64(rlo, vrsqrtsq_f64(vmulq_f64(slo, rlo), rlo));\n  rhi = vmulq_f64(rhi, vrsqrtsq_f64(vmulq_f64(shi, rhi), rhi));\n\n  *near = vorrq_u64(near_float_midpoint(rlo), near_float_midpoint(rhi));\n  return vcombine_f32(vcvt_f32_f64(rlo), vcvt_f32_f64(rhi));\n}\n\nstatic inline __attribute__((always_inline))\nfloat32x4x2_t inverse_distance8(float32x4_t squared0,\n                              float32x4_t squared1) {\n  float32x4x2_t result;\n  uint32_t largest = vmaxvq_u32(vmaxq_u32(\n      vreinterpretq_u32_f32(squared0), vreinterpretq_u32_f32(squared1)));\n\n  /* Finite squared distances are normal and at least SOFTENING.\n   * Keep infinities and every NaN on the original sqrt/divide path. */\n  if (largest >= UINT32_C(0x7f800000)) {\n    result.val[0] = exact_inverse4(squared0);\n    result.val[1] = exact_inverse4(squared1);\n    return result;\n  }\n\n  uint64x2_t near0, near1;\n  result.val[0] = estimate_inverse4(squared0, &near0);\n  result.val[1] = estimate_inverse4(squared1, &near1);\n\n  /* Two float steps and one double step have relative error below\n   * 2^-40 here. The midpoint window is at least 2^-35 relative,\n   * also covering the reference double sqrt/divide rounding error. */\n  if (vmaxvq_u32(vreinterpretq_u32_u64(vorrq_u64(near0, near1)))) {\n    result.val[0] = exact_inverse4(squared0);\n    result.val[1] = exact_inverse4(squared1);\n  }\n  return result;\n}\n\nstatic inline __attribute__((always_inline))\nvoid add_velocity4(Body *p, float dt,\n                   float32x4_t fx, float32x4_t fy, float32x4_t fz) {\n  p[0].vx += dt * vgetq_lane_f32(fx, 0);\n  p[0].vy += dt * vgetq_lane_f32(fy, 0);\n  p[0].vz += dt * vgetq_lane_f32(fz, 0);\n  p[1].vx += dt * vgetq_lane_f32(fx, 1);\n  p[1].vy += dt * vgetq_lane_f32(fy, 1);\n  p[1].vz += dt * vgetq_lane_f32(fz, 1);\n  p[2].vx += dt * vgetq_lane_f32(fx, 2);\n  p[2].vy += dt * vgetq_lane_f32(fy, 2);\n  p[2].vz += dt * vgetq_lane_f32(fz, 2);\n  p[3].vx += dt * vgetq_lane_f32(fx, 3);\n  p[3].vy += dt * vgetq_lane_f32(fy, 3);\n  p[3].vz += dt * vgetq_lane_f32(fz, 3);\n}\n#endif\n\n/*\n * Compute the gravitational impact among all pairs of bodies in\n * the system. Positions remain read-only throughout this phase.\n */\nvoid body_force(Body *p, float dt, int n) {\n  if (n <= 0) return;\n\n#if defined(__aarch64__)\n  if (n < 8 || fegetround() != FE_TONEAREST) {\n    for (int i = 0; i < n; ++i) body_force_one(p, dt, i, n);\n    return;\n  }\n\n  const int blocks = n / 8 + (n % 8 != 0);\n#if defined(_OPENMP)\n#pragma omp parallel for schedule(static) if(n >= 128)\n#endif\n  for (int block = 0; block < blocks; ++block) {\n    const int i = block * 8;\n    if (n - i < 8) {\n      for (int k = i; k < n; ++k) body_force_one(p, dt, k, n);\n      continue;\n    }\n\n    const float32x4_t x0 = {p[i].x, p[i+1].x, p[i+2].x, p[i+3].x};\n    const float32x4_t y0 = {p[i].y, p[i+1].y, p[i+2].y, p[i+3].y};\n    const float32x4_t z0 = {p[i].z, p[i+1].z, p[i+2].z, p[i+3].z};\n    const float32x4_t x1 = {p[i+4].x, p[i+5].x, p[i+6].x, p[i+7].x};\n    const float32x4_t y1 = {p[i+4].y, p[i+5].y, p[i+6].y, p[i+7].y};\n    const float32x4_t z1 = {p[i+4].z, p[i+5].z, p[i+6].z, p[i+7].z};\n    const float32x4_t softening = vdupq_n_f32(SOFTENING);\n    float32x4_t fx0 = vdupq_n_f32(0.0f);\n    float32x4_t fy0 = vdupq_n_f32(0.0f);\n    float32x4_t fz0 = vdupq_n_f32(0.0f);\n    float32x4_t fx1 = vdupq_n_f32(0.0f);\n    float32x4_t fy1 = vdupq_n_f32(0.0f);\n    float32x4_t fz1 = vdupq_n_f32(0.0f);\n\n    /* Lanes are different targets, never partial source reductions. */\n    for (int j = 0; j < n; ++j) {\n      float32x4_t sx = vdupq_n_f32(p[j].x);\n      float32x4_t sy = vdupq_n_f32(p[j].y);\n      float32x4_t sz = vdupq_n_f32(p[j].z);\n      float32x4_t dx0 = sx - x0;\n      float32x4_t dy0 = sy - y0;\n      float32x4_t dz0 = sz - z0;\n      float32x4_t dx1 = sx - x1;\n      float32x4_t dy1 = sy - y1;\n      float32x4_t dz1 = sz - z1;\n      float32x4_t squared0 = dx0*dx0 + dy0*dy0 + dz0*dz0 + softening;\n      float32x4_t squared1 = dx1*dx1 + dy1*dy1 + dz1*dz1 + softening;\n      float32x4x2_t inverse = inverse_distance8(squared0, squared1);\n      float32x4_t inverse30 = inverse.val[0] * inverse.val[0] * inverse.val[0];\n      float32x4_t inverse31 = inverse.val[1] * inverse.val[1] * inverse.val[1];\n\n      fx0 += dx0 * inverse30;\n      fy0 += dy0 * inverse30;\n      fz0 += dz0 * inverse30;\n      fx1 += dx1 * inverse31;\n      fy1 += dy1 * inverse31;\n      fz1 += dz1 * inverse31;\n    }\n\n    add_velocity4(p + i, dt, fx0, fy0, fz0);\n    add_velocity4(p + i + 4, dt, fx1, fy1, fz1);\n  }\n#else\n  for (int i = 0; i < n; ++i) body_force_one(p, dt, i, n);\n#endif\n}\n\n/*\n * Read a binary dataset with initilized bodies.\n */\nBody* read_dataset(int *nbodies) {\n  int b = fread(nbodies, sizeof(*nbodies), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading nbodie value\\n\");\n    exit(EXIT_FAILURE);\n  }\n  Body *bodies = (Body *)malloc(*nbodies * sizeof(Body));\n  b = fread(bodies, *nbodies * sizeof(Body), 1, stdin);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError reading input values\\n\");\n    exit(EXIT_FAILURE);\n  }\n\n  return bodies;\n}\n\n/*\n * Write simulation results into a binary dataset.\n */\nvoid write_dataset(const int nbodies, Body *bodies) {\n  int b = fwrite(bodies, nbodies * sizeof(Body), 1, stdout);\n  if (b != 1) {\n    fprintf(stderr,\"\\nError writing to output\\n\");\n    exit(EXIT_FAILURE);\n  }\n}\n\nint main(int argc,char **argv) {\n  int nbodies;\n\n  Body *bodies = read_dataset(&nbodies);\n\n  /*\n   * At each simulation iteration, interbody forces are computed,\n   * and bodies' positions are integrated.\n   */\n  for (int iter = 0; iter < N_ITER; iter++) {\n    body_force(bodies, DT, nbodies);\n\n    for (int i = 0; i < nbodies; i++) {\n      bodies[i].x += bodies[i].vx * DT;\n      bodies[i].y += bodies[i].vy * DT;\n      bodies[i].z += bodies[i].vz * DT;\n    }\n  }\n\n  write_dataset(nbodies, bodies);\n\n  free(bodies);\n\n  exit(EXIT_SUCCESS);\n}\n",
      "path": "src/nbody.c"
    }
  ],
  "hypothesis": "An eight-target NEON kernel with guarded reciprocal-square-root refinement and static target-block parallelism can eliminate most double sqrt/divide operations while preserving rounded float results and source-order accumulation.",
  "notes": "Not executed. Nonfinite distances and estimates near float rounding midpoints use the original double sqrt/divide operations; non-nearest rounding uses the original kernel.",

      "content": "#include <iostream>\n#include <vector>\n#include <cstdio>\n#include <cassert>\n#include <algorithm>\n#include <cstddef>\n#include <limits>\n#include <memory>\n\nint main() {\n    int n, s;\n    if (!(std::cin >> n >> s)) return 0;\n\n    assert(s < n);\n    assert(n < 8000);\n    assert(s > 0);\n    assert(n > 0);\n\n    const int width = n - s + 1;\n    std::vector<int> row(n);\n    std::vector<long long> horizontal_sums(width);\n    std::vector<long long> vertical_sums(width, 0);\n    std::unique_ptr<long long[]> history(\n        new long long[static_cast<std::size_t>(s) * width]);\n\n    long long max_sum = std::numeric_limits<long long>::lowest();\n    int slot_index = 0;\n\n    for (int i = 0; i < n; ++i) {\n        for (int j = 0; j < n; ++j)\n            std::scanf(\"%d\", &row[j]);\n\n        long long horizontal = 0;\n        #pragma omp simd reduction(+:horizontal)\n        for (int j = 0; j < s; ++j)\n            horizontal += static_cast<long long>(row[j]);\n\n        horizontal_sums[0] = horizontal;\n        // This rolling-window recurrence must remain sequential.\n        for (int j = 1; j < width; ++j) {\n            horizontal += static_cast<long long>(row[j + s - 1])\n                        - static_cast<long long>(row[j - 1]);\n            horizontal_sums[j] = horizontal;\n        }\n\n        long long* slot = history.get()\n                       + static_cast<std::size_t>(slot_index) * width;\n        long long* totals = vertical_sums.data();\n        const long long* incoming = horizontal_sums.data();\n\n        if (i < s) {\n            // Initialize each ring slot before it can be read.\n            #pragma omp simd\n            for (int j = 0; j < width; ++j) {\n                totals[j] += incoming[j];\n                slot[j] = incoming[j];\n            }\n\n            if (i == s - 1) {\n                #pragma omp simd reduction(max:max_sum)\n                for (int j = 0; j < width; ++j)\n                    max_sum = std::max(max_sum, totals[j]);\n            }\n        } else {\n            // Columns are independent; consume outgoing values before reuse.\n            #pragma omp simd reduction(max:max_sum)\n            for (int j = 0; j < width; ++j) {\n                const long long next = totals[j] - slot[j] + incoming[j];\n                totals[j] = next;\n                slot[j] = incoming[j];\n                max_sum = std::max(max_sum, next);\n            }\n        }\n\n        if (++slot_index == s) slot_index = 0;\n    }\n\n    std::printf(\"%lld\\n\", max_sum);\n    return 0;\n}\n",
      "path": "src/solution.cpp"
    }

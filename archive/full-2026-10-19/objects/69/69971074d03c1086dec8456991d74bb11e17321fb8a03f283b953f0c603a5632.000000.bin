{
  "name": "forest-r5-software-and-overhead",
  "command": "bash -lc 'set -euo pipefail\nroot=/scratch_p/nimarano/hpc-forest-r5-evaluation-20261016-r1-preflight\narchive=/scratch_p/nimarano/hpc-forest-r5-evaluation-20261016-r1-preflight.tar.gz\npy=/scratch_p/nimarano/hpc-forest-localmodels-20261015-r1/venv-r3/bin/python\ntest ! -e \"$root\"\nprintf '\"'\"'%s  %s\\n'\"'\"' bd91241ee0fec0c529bd3ef826167cf6569bf44343a7640f659f52f3edf11b6e \"$archive\" | sha256sum -c -\nmkdir \"$root\"\ntar -xzf \"$archive\" -C \"$root\"\nmkdir \"$root/proofs\"\nfinish() {\n  rc=$?\n  trap - EXIT\n  printf '\"'\"'%s\\n'\"'\"' \"$rc\" > \"$root/proofs/exit-code.txt\"\n  tar -czf \"$root-result-${SLURM_JOB_ID}.tar.gz\" -C \"$root\" .\n  sha256sum \"$root-result-${SLURM_JOB_ID}.tar.gz\" | tee \"$root-result-${SLURM_JOB_ID}.tar.gz.sha256\"\n  exit \"$rc\"\n}\ntrap finish EXIT\nexport PYTHONPATH=\"$root/project/src:/scratch_p/nimarano/hpc-forest-native-matrix-20261015-r1-launchfix1/qa-deps\"\nexport PYTHONDONTWRITEBYTECODE=1\nexport CUDA_VISIBLE_DEVICES=\nexport OMP_NUM_THREADS=1\nexport OPENBLAS_NUM_THREADS=1\nexport MKL_NUM_THREADS=1\nlscpu > \"$root/proofs/lscpu.txt\"\ngcc --version > \"$root/proofs/gcc.txt\"\ng++ --version > \"$root/proofs/gpp.txt\"\nenv | sort | grep -E '\"'\"'^(SLURM|OMP|OPENBLAS|MKL|CUDA_VISIBLE_DEVICES)'\"'\"' > \"$root/proofs/allocated-environment.txt\"\n\"$py\" \"$root/benchmarks/verifier-sources.py\" \"$root/project\" \"$root/source-manifest.json\" \"$root/proofs/source-before.json\"\n\"$py\" -c '\"'\"'import importlib.metadata,json,platform,sys; print(json.dumps({\"python\":sys.version,\"machine\":platform.machine(),\"treequest\":importlib.metadata.version(\"treequest\"),\"numpy\":importlib.metadata.version(\"numpy\")}))'\"'\"' > \"$root/proofs/python.json\"\nprintf '\"'\"'%s  %s\\n'\"'\"' 13ee90156522998c3037059d8f66885c8adeeaf7643bdce2caceee196ecd23e0 /scratch_p/nimarano/hpc-forest-harness-comparison-20261016-r1-ruff-ruff-0.17.0-py3-none-manylinux_2_17_aarch64.manylinux2014_aarch64.whl | sha256sum -c -\n\"$py\" -m pip install --no-index --no-deps --target \"$root/qa\" /scratch_p/nimarano/hpc-forest-harness-comparison-20261016-r1-ruff-ruff-0.17.0-py3-none-manylinux_2_17_aarch64.manylinux2014_aarch64.whl > \"$root/proofs/ruff-install.log\" 2>&1\ncd \"$root/project\"\n\"$root/qa/bin/ruff\" check --no-cache src tests > \"$root/proofs/ruff-project.log\" 2>&1\n\"$root/qa/bin/ruff\" check --no-cache --config \"$root/project/pyproject.toml\" \"$root/benchmarks\" > \"$root/proofs/ruff-benchmarks.log\" 2>&1\n\"$py\" -m pytest -q --junitxml=\"$root/proofs/tests-project.xml\" > \"$root/proofs/tests-project.log\" 2>&1\n\"$py\" -m pytest -q \"$root/benchmarks/test_mesures.py\" --junitxml=\"$root/proofs/tests-benchmarks.xml\" > \"$root/proofs/tests-benchmarks.log\" 2>&1\n\"$py\" \"$root/benchmarks/mesurer-controleur.py\" \"$root/overhead\" --trials 8 32 --seeds 23 29 31 --repetitions 5 --warmups 1 > \"$root/proofs/overhead.log\" 2>&1\n\"$py\" \"$root/benchmarks/verifier-sources.py\" \"$root/project\" \"$root/source-manifest.json\" \"$root/proofs/source-after.json\"\n'",

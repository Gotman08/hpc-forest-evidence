#include <cstdio>
#include <vector>

class FastScanner {
    enum { BUFSIZE = 1 << 20 };
    int idx = 0;
    int size = 0;
    char buf[BUFSIZE];
public:
    inline char getChar() {
        if (idx >= size) {
            size = static_cast<int>(fread(buf, 1, BUFSIZE, stdin));
            idx = 0;
            if (size == 0) return 0;
        }
        return buf[idx++];
    }

    int nextInt() {
        char c;
        do { c = getChar(); } while (c <= ' ');
        int sign = 1;
        if (c == '-') { sign = -1; c = getChar(); }
        int x = 0;
        while (c > ' ') {
            x = x * 10 + (c - '0');
            c = getChar();
        }
        return sign * x;
    }
};

int main() {
    FastScanner fs;
    int n = fs.nextInt();
    int s = fs.nextInt();

    std::vector<long long> colSum(n, 0);
    const size_t ringSize = static_cast<size_t>(s + 1) * static_cast<size_t>(n);
    std::vector<int> ring(ringSize);

    // Read first row and initialize column sums directly from it.
    int* firstRow = &ring[0];
    for (int j = 0; j < n; ++j) {
        firstRow[j] = fs.nextInt();
    }
#pragma omp simd
    for (int j = 0; j < n; ++j) {
        colSum[j] = static_cast<long long>(firstRow[j]);
    }

    // Read remaining S-1 rows and add them to column sums.
    for (int r = 1; r < s; ++r) {
        int* row = &ring[static_cast<size_t>(r) * n];
        for (int j = 0; j < n; ++j) {
            row[j] = fs.nextInt();
        }
#pragma omp simd
        for (int j = 0; j < n; ++j) {
            colSum[j] += static_cast<long long>(row[j]);
        }
    }

    // Horizontal maximum for the first top row.
    long long hsum = 0;
#pragma omp simd reduction(+:hsum)
    for (int j = 0; j < s; ++j) {
        hsum += colSum[j];
    }
    long long mx = hsum;
    int j = s;
    for (; j + 3 < n; j += 4) {
        hsum += colSum[j] - colSum[j-s];
        if (hsum > mx) mx = hsum;
        hsum += colSum[j+1] - colSum[j+1-s];
        if (hsum > mx) mx = hsum;
        hsum += colSum[j+2] - colSum[j+2-s];
        if (hsum > mx) mx = hsum;
        hsum += colSum[j+3] - colSum[j+3-s];
        if (hsum > mx) mx = hsum;
    }
    for (; j < n; ++j) {
        hsum += colSum[j] - colSum[j-s];
        if (hsum > mx) mx = hsum;
    }

    const int mod = s + 1;
    int slot = s % mod;
    int oldSlot = 0;

    // Process remaining rows with a circular buffer.
    for (int r = s; r < n; ++r) {
        int* newRow = &ring[static_cast<size_t>(slot) * n];
        const int* oldRow = &ring[static_cast<size_t>(oldSlot) * n];

        // Read the entire row first, decoupling I/O from arithmetic.
        for (int jj = 0; jj < n; ++jj) {
            newRow[jj] = fs.nextInt();
        }
#pragma omp simd
        for (int jj = 0; jj < n; ++jj) {
            colSum[jj] += static_cast<long long>(newRow[jj]) - oldRow[jj];
        }

        // Horizontal maximum for this top row.
        hsum = 0;
#pragma omp simd reduction(+:hsum)
        for (int j2 = 0; j2 < s; ++j2) {
            hsum += colSum[j2];
        }
        if (hsum > mx) mx = hsum;
        int k = s;
        for (; k + 3 < n; k += 4) {
            hsum += colSum[k] - colSum[k-s];
            if (hsum > mx) mx = hsum;
            hsum += colSum[k+1] - colSum[k+1-s];
            if (hsum > mx) mx = hsum;
            hsum += colSum[k+2] - colSum[k+2-s];
            if (hsum > mx) mx = hsum;
            hsum += colSum[k+3] - colSum[k+3-s];
            if (hsum > mx) mx = hsum;
        }
        for (; k < n; ++k) {
            hsum += colSum[k] - colSum[k-s];
            if (hsum > mx) mx = hsum;
        }

        // Advance ring indices without modulo.
        if (++slot == mod) slot = 0;
        if (++oldSlot == mod) oldSlot = 0;
    }

    std::printf("%d\n", static_cast<int>(mx));
    return 0;
}

        "content": "#include \"knn.h\"\n#include <string.h>\n\nchar knn(int n_groups, Group * groups, int k, Point to_evaluate) {\n    enum { DISTANCE_BLOCK_SIZE = 256 };\n    char * labels = (char *) malloc(sizeof(char) * k);\n    float * distances = (float *) malloc(sizeof(float) * k);\n    float block_distances[DISTANCE_BLOCK_SIZE];\n    int filled = 0;\n    int i, j, x;\n\n    for (i = 0; i < k; i++) {\n        labels[i] = -1;\n    }\n\n    for (i = 0; i < n_groups; i++) {\n        Group g = groups[i];\n\n        for (j = 0; j < g.length;) {\n            int count = g.length - j;\n            if (count > DISTANCE_BLOCK_SIZE) {\n                count = DISTANCE_BLOCK_SIZE;\n            }\n\n            for (int b = 0; b < count; b++) {\n                block_distances[b] = euclidean_distance_no_sqrt(\n                    to_evaluate, g.points[j + b]);\n            }\n\n            for (int b = 0; b < count; b++) {\n                float d = block_distances[b];\n\n                /* Ordered comparison leaves NaNs to the forward scan. */\n                if (filled == k && d >= distances[k - 1]) {\n                    continue;\n                }\n\n                for (x = 0; x < filled; x++) {\n                    if (d < distances[x]) {\n                        break;\n                    }\n                }\n\n                if (x == k) {\n                    continue;\n                }\n\n                int last = filled < k ? filled : k - 1;\n                if (last > x) {\n                    size_t shifted = (size_t) (last - x);\n                    memmove(distances + x + 1, distances + x,\n                            sizeof(*distances) * shifted);\n                    memmove(labels + x + 1, labels + x,\n                            sizeof(*labels) * shifted);\n                }\n\n                distances[x] = d;\n                labels[x] = g.label;\n                if (filled < k) {\n                    filled++;\n                }\n            }\n\n            j += count;\n        }\n    }\n\n    qsort(labels, k, sizeof(char), compare_for_sort);\n\n    char most_frequent = labels[0];\n    int most_frequent_count = 1;\n    int current_frequency = 1;\n\n    for (i = 1; i < k; i++) {\n        if (labels[i] != labels[i - 1]) {\n            if (current_frequency > most_frequent_count) {\n                most_frequent = labels[i - 1];\n                most_frequent_count = current_frequency;\n            }\n\n            current_frequency = 1;\n        } else {\n            current_frequency++;\n        }\n\n        if (i == k - 1 && current_frequency > most_frequent_count) {\n            most_frequent = labels[i - 1];\n            most_frequent_count = current_frequency;\n        }\n    }\n\n    free(distances);\n    free(labels);\n    return most_frequent;\n}\n\nint main() {\n    int n_groups = parse_number_of_groups();\n    \n    Group * groups = (Group *) malloc(sizeof(Group) * n_groups);\n\n    for (int i = 0; i < n_groups; i++) {\n        groups[i] = parse_next_group();\n    }\n\n    int k = parse_k();\n\n    Point to_evaluate = parse_point();\n\n    printf(\"%c\", knn(n_groups, groups, k, to_evaluate));\n}\n",
        "path": "src/knn.c"
      }

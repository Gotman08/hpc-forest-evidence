#include <iostream>
#include <vector>
#include <cstdio>
#include <cassert>
#include <climits>

int main() {
	int n,s;
	if (scanf("%d %d", &n, &s) != 2) return 0;
	std::vector<int> matrix(n*n);
	for(int i=0;i<n;i++)
		for(int j=0;j<n;j++) 
			scanf("%d", &matrix[i*n+j]);

	assert(s<n && n<8000 && s>0 && n>0);

	std::vector<long long> colSum(n, 0);
	for(int i=0;i<s;i++) {
		const int* row = &matrix[i*n];
		#pragma omp simd
		for(int j=0;j<n;j++)
			colSum[j] += (long long)row[j];
	}

	std::vector<long long> pref(n+1);
	long long mxSum = LLONG_MIN;

	for(int i=0; i+s<=n; ++i) {
		pref[0]=0;
		for(int j=0;j<n;j++)
			pref[j+1] = pref[j] + colSum[j];

		long long rowMax = LLONG_MIN;
		#pragma omp simd reduction(max:rowMax)
		for(int j=0; j+s<=n; ++j) {
			long long val = pref[j+s]-pref[j];
			if(val > rowMax) rowMax = val;
		}
		if(rowMax > mxSum) mxSum = rowMax;

		if(i+s < n) {
			const int* addRow = &matrix[(i+s)*n];
			const int* subRow = &matrix[i*n];
			#pragma omp simd
			for(int j=0;j<n;j++)
				colSum[j] += (long long)addRow[j] - (long long)subRow[j];
		}
	}

	printf("%lld\n", mxSum);
}
